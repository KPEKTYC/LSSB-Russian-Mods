translate russian aletta_warn_condom_587e5a95:

    aletta.say "Нам действительно стоит использовать презерватив."

translate russian aletta_warn_condom_6eadfda4:

    aletta.say "Погоди, [hero.name]."

translate russian aletta_warn_condom_ce92c66b:

    aletta.say "Подожди, [hero.name]."

translate russian aletta_warn_condom_e28d10ad:

    aletta.say "Вижу, ты увлёкся и забыл о предосторожности, [hero.name]."

translate russian aletta_warn_condom_fcfa5995:

