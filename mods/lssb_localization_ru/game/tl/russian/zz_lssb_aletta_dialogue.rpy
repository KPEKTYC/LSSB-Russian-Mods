# ch/aletta/gift.rpy:269
translate russian aletta_gift_collar_male_6fdd3dd7:
    aletta.say "О... ощущается... хорошо. Мне хорошо, [lssb_aletta.hero_name()]..."

# ch/aletta/gift.rpy:270
translate russian aletta_gift_collar_male_2b0742a4:
    "Я слегка хмурюсь и качаю головой."

# ch/aletta/gift.rpy:271
translate russian aletta_gift_collar_male_df3510e4:
    mike.say "Ну-ну, Алетта. Не помню, чтобы я разрешал тебе так меня называть!"

# ch/aletta/gift.rpy:272
translate russian aletta_gift_collar_male_1409c8ee:
    aletta.say "Простите... Г... Господин?"

# ch/aletta/gift.rpy:273
translate russian aletta_gift_collar_male_d4c854b5:
    "Я улыбаюсь, услышав правильное обращение, и одобрительно киваю."

# ch/aletta/gift.rpy:274
translate russian aletta_gift_collar_male_5d5e9471:
    "Сегодня между нами с Алеттой многое изменилось, и я уверен, что прежними наши отношения уже не станут."

# ch/aletta/gift.rpy:279
translate russian aletta_gift_butt_plug_male_a427f7f6:
    aletta.say "О, [lssb_aletta.hero_name()], это мне?"

# ch/aletta/gift.rpy:280
translate russian aletta_gift_butt_plug_male_1a19f559:
    "Она разворачивает анальную пробку."

# ch/aletta/gift.rpy:283
translate russian aletta_gift_butt_plug_male_30d236c7:
    aletta.say "..."

# ch/aletta/gift.rpy:284
translate russian aletta_gift_butt_plug_male_eab6628c:
    aletta.say "Оставь себе... Я её не хочу, так что забирай."

# ch/aletta/gift.rpy:285
translate russian aletta_gift_butt_plug_male_d4c721e0:
    aletta.say "Уверена, тебе она пригодится больше, чем мне."

# ch/aletta/gift.rpy:289
translate russian aletta_gift_butt_plug_male_7aa38448:
    aletta.say "Она идеальна!"

# ch/aletta/gift.rpy:291
translate russian aletta_gift_butt_plug_male_43122a90:
    aletta.say "Спасибо, [lssb_aletta.hero_name()], я найду ему применение."

# ch/aletta/reactions.rpy:2
translate russian aletta_ice_cream_reaction_male_b8f91c1a:
    mike.say "Эй, Алетта, давай купим мороженого!"

# ch/aletta/reactions.rpy:3
translate russian aletta_ice_cream_reaction_male_c0b191f3:
    aletta.say "Хм... звучит неплохо."

# ch/aletta/reactions.rpy:4
translate russian aletta_ice_cream_reaction_male_4e6dc62d:
    aletta.say "Мне как раз не помешало бы охладиться!"

# ch/aletta/reactions.rpy:5
translate russian aletta_ice_cream_reaction_male_73a4ddd7:
    "У киоска с мороженым я покупаю рожок с парой разных шариков."

# ch/aletta/reactions.rpy:6
translate russian aletta_ice_cream_reaction_male_823a8d8a:
    "А Алетта заказывает довольно изысканный десерт с длинной ложкой."

# ch/aletta/reactions.rpy:7
translate russian aletta_ice_cream_reaction_male_b9b49f3f:
    mike.say "Ого, Алетта, выглядит потрясающе!"

# ch/aletta/reactions.rpy:8
translate russian aletta_ice_cream_reaction_male_6ea7471e:
    aletta.say "М-м-м... и на вкус тоже потрясающе!"

# ch/aletta/reactions.rpy:9
translate russian aletta_ice_cream_reaction_male_e2e4034d:
    "Я смотрю с открытым ртом, как Алетта ложкой отправляет мороженое себе в рот."

# ch/aletta/reactions.rpy:10
translate russian aletta_ice_cream_reaction_male_ae748892:
    "И даже не понимаю, что сильнее разжигает мой аппетит."

# ch/aletta/reactions.rpy:11
translate russian aletta_ice_cream_reaction_male_5220b672:
    "Само мороженое или то, как Алетта его ест!"

# ch/aletta/reactions.rpy:15
translate russian aletta_ask_phone_male_60ab6910:
    mike.say "Я тут подумал, Алетта..."

# ch/aletta/reactions.rpy:16
translate russian aletta_ask_phone_male_da4b8608:
    mike.say "Можно мне твой номер?"

# ch/aletta/reactions.rpy:20
translate russian aletta_ask_phone_male_a34b5d12:
    aletta.say "Хм..."

# ch/aletta/reactions.rpy:21
translate russian aletta_ask_phone_male_7316f267:
    aletta.say "Думаю, да, [lssb_aletta.hero_name()]."

# ch/aletta/reactions.rpy:22
translate russian aletta_ask_phone_male_032b07e2:
    aletta.say "Нам действительно есть о чём поговорить..."

# ch/aletta/reactions.rpy:27
translate russian aletta_ask_phone_male_5042aa81:
    aletta.say "Тебе не нужно его спрашивать, [lssb_aletta.hero_name()]."

# ch/aletta/reactions.rpy:28
translate russian aletta_ask_phone_male_4a34c3b6:
    aletta.say "Номер моего кабинета есть в корпоративном справочнике."

# ch/aletta/reactions.rpy:32
translate russian aletta_ask_birthday_male_bcdcbc34:
    mike.say "Эй, Алетта..."

# ch/aletta/reactions.rpy:33
translate russian aletta_ask_birthday_male_7210b2b8:
    mike.say "Когда у тебя на самом деле день рождения?"

# ch/aletta/reactions.rpy:37
translate russian aletta_ask_birthday_male_a8b1590e:
    aletta.say "Серьёзно, [lssb_aletta.hero_name()]?"

# ch/aletta/reactions.rpy:38
translate russian aletta_ask_birthday_male_3b1bc9ba:
    aletta.say "Ты мог посмотреть в моём личном деле."

# ch/aletta/reactions.rpy:39
translate russian aletta_ask_birthday_male_ede78625:
    aletta.say "В общем, 14-го числа зимы."

# ch/aletta/reactions.rpy:44
translate russian aletta_ask_birthday_male_dc0be72b:
    aletta.say "Серьёзно, [lssb_aletta.hero_name()]!"

# ch/aletta/reactions.rpy:45
translate russian aletta_ask_birthday_male_72a9fc9d:
    aletta.say "Если бы я хотела, чтобы ты это знал, я бы сама сказала!"

# ch/aletta/reactions.rpy:46
translate russian aletta_ask_birthday_male_818b3225:
    aletta.say "И даже не думай лезть в моё личное дело!"

# ch/aletta/reactions.rpy:50
translate russian aletta_offer_a_drink_male_bcdcbc34:
    mike.say "Эй, Алетта..."

# ch/aletta/reactions.rpy:51
translate russian aletta_offer_a_drink_male_4c70feca:
    mike.say "Позволь угостить тебя выпивкой!"

# ch/aletta/reactions.rpy:52
translate russian aletta_offer_a_drink_male_90ac8425:
    "Едва слова слетают с моих губ, Алетта поворачивается ко мне."

# ch/aletta/reactions.rpy:56
translate russian aletta_offer_a_drink_male_0c495d02:
    aletta.say "Я сделаю вид, что ты этого не говорил, [lssb_aletta.hero_name()]."

# ch/aletta/reactions.rpy:57
translate russian aletta_offer_a_drink_male_966a6b83:
    aletta.say "Ради тебя и нашего нерождённого ребёнка."

# ch/aletta/reactions.rpy:58
translate russian aletta_offer_a_drink_male_eda64713:
    aletta.say "Но во второй раз я этого не забуду!"

# ch/aletta/reactions.rpy:63
translate russian aletta_offer_a_drink_male_c4faac32:
    aletta.say "Спасибо, [lssb_aletta.hero_name()]."

# ch/aletta/reactions.rpy:64
translate russian aletta_offer_a_drink_male_291654b4:
    aletta.say "Бокал красного вина, пожалуйста."

# ch/aletta/reactions.rpy:76
translate russian aletta_offer_a_drink_male_a34b5d12:
    aletta.say "Хм..."

# ch/aletta/reactions.rpy:77
translate russian aletta_offer_a_drink_male_93021e19:
    aletta.say "Меня не нужно водить за ручку."

# ch/aletta/reactions.rpy:78
translate russian aletta_offer_a_drink_male_e6d9e125:
    aletta.say "И за свои напитки я вполне могу платить сама!"

# ch/aletta/reactions.rpy:84
translate russian aletta_slap_ass_intro_male_ea6a2407:
    "Возможно, я играю с огнём."

# ch/aletta/reactions.rpy:85
translate russian aletta_slap_ass_intro_male_3b07629a:
    "Но задница Алетты сегодня просто гипнотизирует!"

# ch/aletta/reactions.rpy:86
translate russian aletta_slap_ass_intro_male_41cd2bbb:
    "И я не могу удержать руки при себе."

# ch/aletta/reactions.rpy:87
translate russian aletta_slap_ass_intro_male_ba22a4ce:
    "Не успеваю опомниться, как слышу звук шлепка."

# ch/aletta/reactions.rpy:88
translate russian aletta_slap_ass_intro_male_f0fd397b:
    "Но сразу за ним следует реакция Алетты..."

# ch/aletta/reactions.rpy:93
translate russian aletta_slap_ass_happy_male_726262ee:
    aletta.say "Ой..."

# ch/aletta/reactions.rpy:94
translate russian aletta_slap_ass_happy_male_1bf19991:
    "Алетта кладёт ладонь на поясницу и неторопливо поворачивается ко мне с предостерегающим взглядом."

# ch/aletta/reactions.rpy:95
translate russian aletta_slap_ass_happy_male_40cc4c6b:
    aletta.say "Полегче, [lssb_aletta.hero_name()]. Я ношу твоего ребёнка, а не напрашиваюсь на порку."

# ch/aletta/reactions.rpy:96
translate russian aletta_slap_ass_happy_male_40724394:
    aletta.say "Хотя признаю: наглости тебе не занимать. Это почти вызывает уважение."

# ch/aletta/reactions.rpy:99
translate russian aletta_slap_ass_happy_male_726262ee_1:
    aletta.say "Ох..."

# ch/aletta/reactions.rpy:100
translate russian aletta_slap_ass_happy_male_8fd2dca6:
    aletta.say "Ох, да..."

# ch/aletta/reactions.rpy:101
translate russian aletta_slap_ass_happy_male_021a7d69:
    "Алетта прикусывает губу и выгибается навстречу жалящей боли вместо того, чтобы отстраниться."

# ch/aletta/reactions.rpy:102
translate russian aletta_slap_ass_happy_male_2ce52a7a:
    aletta.say "Ещё раз, [lssb_aletta.hero_name()]. Пожалуйста. Я весь день мечтала, чтобы ты поставил меня на место."

# ch/aletta/reactions.rpy:104
translate russian aletta_slap_ass_happy_male_726262ee_2:
    aletta.say "Ох..."

# ch/aletta/reactions.rpy:105
translate russian aletta_slap_ass_happy_male_4ef8e5c1:
    aletta.say "О боже..."

# ch/aletta/reactions.rpy:106
translate russian aletta_slap_ass_happy_male_4df73bb9:
    "Алетта смотрит на меня в полном шоке."

# ch/aletta/reactions.rpy:107
translate russian aletta_slap_ass_happy_male_f6accbef:
    "И я ожидаю, что она вот-вот даст мне пощёчину."

# ch/aletta/reactions.rpy:108
translate russian aletta_slap_ass_happy_male_6b7cef1e:
    "Но вместо этого её щёки заливает румянец."

# ch/aletta/reactions.rpy:110
translate russian aletta_slap_ass_happy_male_262e13a6:
    "И пока она снова берёт себя в руки, в её взгляде читается не злость, а что-то почти нежное."

# ch/aletta/reactions.rpy:111
translate russian aletta_slap_ass_happy_male_e95b7bb3:
    aletta.say "Ах ты проказник, [lssb_aletta.hero_name()]."

# ch/aletta/reactions.rpy:112
translate russian aletta_slap_ass_happy_male_28ab7c95:
    aletta.say "Тебе повезло, что это ты. С кем-нибудь другим дело уже дошло бы до жалобы."

# ch/aletta/reactions.rpy:114
translate russian aletta_slap_ass_happy_male_ee4f0fb6:
    "И она смущённо смеётся."

# ch/aletta/reactions.rpy:115
translate russian aletta_slap_ass_happy_male_6e3d35df:
    aletta.say "О, [lssb_aletta.hero_name()]!"

# ch/aletta/reactions.rpy:116
translate russian aletta_slap_ass_happy_male_cf83983f:
    aletta.say "Ах ты шалун!"

# ch/aletta/reactions.rpy:120
translate russian aletta_slap_ass_angry_male_00e74618:
    aletta.say "О боже..."

# ch/aletta/reactions.rpy:121
translate russian aletta_slap_ass_angry_male_df864db2:
    aletta.say "Ты правда только что..."

# ch/aletta/reactions.rpy:122
translate russian aletta_slap_ass_angry_male_4df73bb9:
    "Алетта смотрит на меня в полном шоке."

# ch/aletta/reactions.rpy:125
translate russian aletta_slap_ass_angry_male_4197e471:
    aletta.say "Давай проясним одну вещь, [lssb_aletta.hero_name()]. Я решаю, когда ко мне можно прикасаться. Не ты."

# ch/aletta/reactions.rpy:126
translate russian aletta_slap_ass_angry_male_68313d2f:
    aletta.say "Ещё раз сделаешь это без моего разрешения — пожалеешь. Мы поняли друг друга?"

# ch/aletta/reactions.rpy:128
translate russian aletta_slap_ass_angry_male_f6accbef:
    "И я ожидаю, что она вот-вот даст мне пощёчину."

# ch/aletta/reactions.rpy:129
translate russian aletta_slap_ass_angry_male_6b7cef1e:
    "Но вместо этого её щёки заливает румянец."

# ch/aletta/reactions.rpy:130
translate russian aletta_slap_ass_angry_male_96cd4d62:
    "Но затем её глаза вспыхивают гневом."

# ch/aletta/reactions.rpy:131
translate russian aletta_slap_ass_angry_male_a54a2f4c:
    aletta.say "Не могу поверить, что ты действительно это сделал!"

# ch/aletta/reactions.rpy:132
translate russian aletta_slap_ass_angry_male_8fbf08c8:
    "Она качает головой и сердито уходит."

# ch/aletta/reactions.rpy:137
translate russian aletta_breakup_male_a92ce54d:
    "Сказать это мягко никак не получится."

# ch/aletta/reactions.rpy:138
translate russian aletta_breakup_male_b5e262d0:
    "Но Алетта не любит ходить вокруг да около."

# ch/aletta/reactions.rpy:139
translate russian aletta_breakup_male_e0f9ac30:
    "Поэтому решаю просто сказать всё прямо."

# ch/aletta/reactions.rpy:140
translate russian aletta_breakup_male_d10f32a3:
    mike.say "Алетта..."

# ch/aletta/reactions.rpy:141
translate russian aletta_breakup_male_07f0eb2c:
    mike.say "Я в последнее время много думал."

# ch/aletta/reactions.rpy:142
translate russian aletta_breakup_male_defdd587:
    "Алетта приподнимает бровь и заинтересованно смотрит на меня."

# ch/aletta/reactions.rpy:143
translate russian aletta_breakup_male_51097f40:
    aletta.say "Звучит зловеще!"

# ch/aletta/reactions.rpy:144
translate russian aletta_breakup_male_cef3e278:
    aletta.say "Так о чём ты думал, [lssb_aletta.hero_name()]?"

# ch/aletta/reactions.rpy:145
translate russian aletta_breakup_male_126bb45d:
    "Я глубоко вдыхаю, на мгновение задерживаю дыхание, а затем выдыхаю."

# ch/aletta/reactions.rpy:146
translate russian aletta_breakup_male_aadca25d:
    "Была не была..."

# ch/aletta/reactions.rpy:147
translate russian aletta_breakup_male_98bb1536:
    mike.say "О нас, Алетта."

# ch/aletta/reactions.rpy:148
translate russian aletta_breakup_male_8f93b6e8:
    mike.say "Мне кажется, у нас ничего не получается."

# ch/aletta/reactions.rpy:149
translate russian aletta_breakup_male_cdf60bfd:
    mike.say "В смысле, наши отношения не работают."

# ch/aletta/reactions.rpy:150
translate russian aletta_breakup_male_798c11e6:
    "Впервые на моей памяти Алетта не находит слов."

# ch/aletta/reactions.rpy:152
translate russian aletta_breakup_male_a0add78f:
    "Она просто смотрит на меня с выражением полного шока."

# ch/aletta/reactions.rpy:153
translate russian aletta_breakup_male_393377b7:
    "И от этой тишины я начинаю бессвязно говорить дальше."

# ch/aletta/reactions.rpy:154
translate russian aletta_breakup_male_c5474a95:
    mike.say "То есть... мы всё ещё можем остаться друзьями."

# ch/aletta/reactions.rpy:155
translate russian aletta_breakup_male_6327ae7b:
    mike.say "Если ты, конечно, захочешь..."

# ch/aletta/reactions.rpy:156
translate russian aletta_breakup_male_1a340431:
    mike.say "На работе будет неловко, но..."

# ch/aletta/reactions.rpy:157
translate russian aletta_breakup_male_0d3c5ce1:
    "Алетта поднимает руку, заставляя меня замолчать."

# ch/aletta/reactions.rpy:159
translate russian aletta_breakup_male_fd3b1edc:
    "Наконец снова заговорив, она качает головой."

# ch/aletta/reactions.rpy:160
translate russian aletta_breakup_male_b9b6d747:
    aletta.say "Дай уточню, [lssb_aletta.hero_name()]."

# ch/aletta/reactions.rpy:161
translate russian aletta_breakup_male_0d910675:
    aletta.say "Это ТЫ бросаешь МЕНЯ?"

# ch/aletta/reactions.rpy:162
translate russian aletta_breakup_male_30e74fc5:
    mike.say "Эм..."

# ch/aletta/reactions.rpy:163
translate russian aletta_breakup_male_7b650c3e:
    mike.say "Да, Алетта, пожалуй!"

# ch/aletta/reactions.rpy:165
translate russian aletta_breakup_male_17010c1b:
    aletta.say "Как ты мог так со мной поступить, [lssb_aletta.hero_name()]?"

# ch/aletta/reactions.rpy:166
translate russian aletta_breakup_male_9fcbc65c:
    aletta.say "Боже, как мне теперь пережить такой позор?!"

# ch/aletta/reactions.rpy:167
translate russian aletta_breakup_male_916e8bab:
    "Мне остаётся лишь пожать плечами и слабо улыбнуться."

# ch/aletta/reactions.rpy:168
translate russian aletta_breakup_male_9f782937:
    "Я думал, Алетта расстроится из-за потери наших отношений."

# ch/aletta/reactions.rpy:169
translate russian aletta_breakup_male_36fba7fc:
    "Но похоже, её больше волнует, как она теперь будет выглядеть на работе!"

# ch/aletta/reactions.rpy:170
translate russian aletta_breakup_male_7fe5ddef:
    mike.say "Как я уже сказал, Алетта..."

# ch/aletta/reactions.rpy:171
translate russian aletta_breakup_male_f5d56fa7:
    mike.say "Мы ведь можем остаться друзьями, да?"

# ch/aletta/reactions.rpy:172
translate russian aletta_breakup_male_9736c10b:
    "Алетта внезапно бросает на меня взгляд."

# ch/aletta/reactions.rpy:173
translate russian aletta_breakup_male_96038846:
    "Такой, что он ощущается как настоящая пощёчина."

# ch/aletta/reactions.rpy:174
translate russian aletta_breakup_male_b96f2101:
    aletta.say "Мне не нужны друзья, [lssb_aletta.hero_name()]."

# ch/aletta/reactions.rpy:175
translate russian aletta_breakup_male_68e48187:
    aletta.say "И если тебе не нужна я..."

# ch/aletta/reactions.rpy:176
translate russian aletta_breakup_male_5c37e976:
    aletta.say "То уж ты мне точно не нужен!"

# ch/aletta/reactions.rpy:177
translate russian aletta_breakup_male_dd7d4679:
