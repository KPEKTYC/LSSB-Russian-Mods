# ch/alexis/base.rpy:452
translate russian alexis_propose_male_7fb789bb:
    mike.say "Ладно, Алексис..."

# ch/alexis/base.rpy:453
translate russian alexis_propose_male_7e9bb082:
    mike.say "Довод принят."

# ch/alexis/base.rpy:454
translate russian alexis_propose_male_d4c565b5:
    mike.say "Жаль только, что я встал на колено до того, как ты всё это сказала!"

# ch/alexis/base.rpy:456
translate russian alexis_propose_male_e566bd25:
    "Алексис болезненно улыбается и целует меня в щёку."

# ch/alexis/base.rpy:457
translate russian alexis_propose_male_b9adf723:
    "Это не исправляет всё, но всё же даёт надежду."

# ch/alexis/base.rpy:458
translate russian alexis_propose_male_fd0e2b6b:
