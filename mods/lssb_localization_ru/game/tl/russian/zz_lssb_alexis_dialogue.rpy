# ch/alexis/base.rpy:449
translate russian alexis_propose_male_217a8df1:
    "И между нами больше нет всей той старой ерунды, которая когда-то нас разлучила."

# ch/alexis/base.rpy:450
translate russian alexis_propose_male_7b3fb9e6:
