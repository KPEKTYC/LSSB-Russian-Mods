# ch/alexis/base.rpy:334
translate russian alexis_propose_male_685b1a26:
    "Ну прекрасно! Она меня раскусила!"

# ch/alexis/base.rpy:335
translate russian alexis_propose_male_92646e19:
    "Я изо всех сил пытаюсь взять себя в руки и показать, что меня ничего не тревожит."

# ch/alexis/base.rpy:336
translate russian alexis_propose_male_da70acc2:
    "Но судя по лицу Алексис, выходит не очень."

# ch/alexis/base.rpy:337
translate russian alexis_propose_male_52c65242:
    mike.say "Что?!"

# ch/alexis/base.rpy:338
translate russian alexis_propose_male_a36c7966:
    mike.say "Не говори глупостей, Алексис!"

# ch/alexis/base.rpy:339
translate russian alexis_propose_male_cc398ed1:
    mike.say "Я в порядке, совершенно в порядке!"

# ch/alexis/base.rpy:341
translate russian alexis_propose_male_3db8faa6:
    "Ладно, пора. Сейчас или никогда."

# ch/alexis/base.rpy:342
translate russian alexis_propose_male_5c4070a6:
    "Пора использовать один из запасных планов, которые я придумал."

# ch/alexis/base.rpy:343
translate russian alexis_propose_male_86d07102:
    mike.say "А..."

# ch/alexis/base.rpy:344
translate russian alexis_propose_male_5c6cd907:
    mike.say "Вот же..."

# ch/alexis/base.rpy:345
translate russian alexis_propose_male_2aa6a88d:
    mike.say "Кажется, я что-то здесь уронил..."

# ch/alexis/base.rpy:346
translate russian alexis_propose_male_8bd6a179:
    "Я демонстративно приседаю и делаю вид, что ищу что-то на земле."

# ch/alexis/base.rpy:347
translate russian alexis_propose_male_b7ee26e7:
    "Алексис немного отступает, то ли давая мне место, то ли просто подыгрывая."

# ch/alexis/base.rpy:348
translate russian alexis_propose_male_67e565fb:
    "Я воспринимаю это как возможность перейти к следующей части плана."

# ch/alexis/base.rpy:349
translate russian alexis_propose_male_c36b8668:
    "Глубоко вдохнув, я достаю кольцо."

# ch/alexis/base.rpy:350
translate russian alexis_propose_male_e9fb74f5:
    "И поднимаю на неё взгляд, держа его в руке."

# ch/alexis/base.rpy:351
translate russian alexis_propose_male_a61ed12d:
    mike.say "Алексис..."

# ch/alexis/base.rpy:352
translate russian alexis_propose_male_2d2c8421:
    mike.say "Ты... ты выйдешь за меня?"

# ch/alexis/base.rpy:354
translate russian alexis_propose_male_8b04ac2e:
    "Реакция Алексис мгновенна и куда драматичнее, чем я ожидал."

# ch/alexis/base.rpy:355
translate russian alexis_propose_male_fb762ba3:
    "Я всегда думал, что, услышав предложение, она останется совершенно спокойной."

# ch/alexis/base.rpy:356
translate russian alexis_propose_male_beb924af:
    "Но она выглядит искренне потрясённой, словно меньше всего ожидала услышать именно это."

# ch/alexis/base.rpy:357
translate russian alexis_propose_male_41a74eb5:
    "Возможно, она действительно удивлена, а может, просто не может контролировать реакцию на настолько важный момент."

# ch/alexis/base.rpy:358
translate russian alexis_propose_male_2f0a491f:
    "Как бы то ни было, Алексис закрывает рот ладонями, а её глаза широко раскрываются."

# ch/alexis/base.rpy:360
translate russian alexis_propose_male_e37b3d46:
    "Без предупреждения Алексис хватает руку, в которой я держу кольцо."

# ch/alexis/base.rpy:361
translate russian alexis_propose_male_7b8ca3d4:
    "А затем с неожиданной силой тянет меня на ноги."

# ch/alexis/base.rpy:362
translate russian alexis_propose_male_a5e9976e:
    "Её глаза всё ещё широко раскрыты, но теперь я вижу, что они ещё и наполняются слезами!"

# ch/alexis/base.rpy:363
translate russian alexis_propose_male_f1d8a63c:
    mike.say "Эм..."

# ch/alexis/base.rpy:364
translate russian alexis_propose_male_a61ed12d_1:
    mike.say "Алексис..."

# ch/alexis/base.rpy:365
translate russian alexis_propose_male_c633af0c:
    mike.say "Ты в порядке?"

# ch/alexis/base.rpy:366
translate russian alexis_propose_male_d79ebe5a:
    "Алексис качает головой и машет руками перед лицом."

# ch/alexis/base.rpy:367
translate russian alexis_propose_male_196b2401:
    "Будто пытается справиться с нахлынувшими чувствами."

# ch/alexis/base.rpy:369
translate russian alexis_propose_male_d66ad9f2:
    alexis.say "Я... я в порядке..."

# ch/alexis/base.rpy:371
translate russian alexis_propose_male_8700c2c8:
    alexis.say "Это... это просто такой шок!"

# ch/alexis/base.rpy:372
translate russian alexis_propose_male_f3ac0351:
    alexis.say "Я... я никогда не думала, что... что ты захочешь..."

# ch/alexis/base.rpy:374
translate russian alexis_propose_male_be1e91b3:
    "Я продолжаю кивать, пытаясь поспевать за бессвязной речью Алексис."

# ch/alexis/base.rpy:376
translate russian alexis_propose_male_aabb2219:
    alexis.say "О... конечно, [lssb_alexis.hero_name()]!"

# ch/alexis/base.rpy:377
translate russian alexis_propose_male_2571bd87:
    alexis.say "Конечно, я выйду за тебя!"

# ch/alexis/base.rpy:379
translate russian alexis_propose_male_59014d7b:
    "Теперь уже моя очередь удивляться и терять дар речи."

# ch/alexis/base.rpy:380
translate russian alexis_propose_male_b95aa50b:
    "Да, именно этот ответ я и хотел услышать."

# ch/alexis/base.rpy:381
translate russian alexis_propose_male_6d786cd0:
    "Но внезапно я совершенно не понимаю, что делать дальше."

# ch/alexis/base.rpy:382
translate russian alexis_propose_male_fbafb6ac:
    "К счастью, через мгновение Алексис приходит мне на выручку."

# ch/alexis/base.rpy:383
translate russian alexis_propose_male_c9e0a088:
    "Она вытягивает одну руку, а другой вытирает глаза."

# ch/alexis/base.rpy:384
translate russian alexis_propose_male_bfe251de:
    "Я тут же прихожу в себя и надеваю кольцо ей на палец."

# ch/alexis/base.rpy:385
translate russian alexis_propose_male_e5669d4f:
    "Стоит мне это сделать, как с плеч словно падает тяжесть."

# ch/alexis/base.rpy:386
translate russian alexis_propose_male_09edb6b5:
    "Тяжесть, о существовании которой я даже не подозревал."

# ch/alexis/base.rpy:387
translate russian alexis_propose_male_a2705c81:
    "Это груз прошлого, всего того, что разлучило нас ещё в школе."

# ch/alexis/base.rpy:388
translate russian alexis_propose_male_27116e50:
    "Теперь ничто из этого уже не кажется важным. Более того, безумно, что когда-то оно вообще что-то значило."

# ch/alexis/base.rpy:389
translate russian alexis_propose_male_aefc70b3:
    "Нет, важно то, что происходит здесь и сейчас. И то, какое будущее нас ждёт."

# ch/alexis/base.rpy:390
translate russian alexis_propose_male_74768d8e:
    "Точнее, что туда мы отправимся вместе."

# ch/alexis/base.rpy:394
translate russian alexis_propose_male_b0b71edb:
    "Алексис продолжает держать меня за руку и крепко целует в губы."

# ch/alexis/base.rpy:395
translate russian alexis_propose_male_42b94e80:
    "И этот жест не меньше кольца на её пальце убеждает меня, что у нас всё получится."

# ch/alexis/base.rpy:396
translate russian alexis_propose_male_6778ce81:
    "Путь сюда был долгим, но все трудности того стоили."

# ch/alexis/base.rpy:400
translate russian alexis_propose_male_e89dc553:
    "Она прижимает мою ладонь к своему животу; между нашими пальцами холодит кольцо."

# ch/alexis/base.rpy:402
translate russian alexis_propose_male_0c496b16:
    alexis.say "Ты, я и этот малыш. Вот она, семья, [lssb_alexis.hero_name()]. То, чего я всегда хотела, но никогда не позволяла себе произнести вслух."

# ch/alexis/base.rpy:404
translate russian alexis_propose_male_eecaad3e:
    "Она прильнула ко мне, отбросив всю надменность, словно годами ждала, чтобы кто-нибудь наконец решил, что она принадлежит ему."

# ch/alexis/base.rpy:406
translate russian alexis_propose_male_5d60bc62:
    alexis.say "Я твоя, [lssb_alexis.hero_name()]. Кажется, всегда была твоей."

# ch/alexis/base.rpy:408
translate russian alexis_propose_male_8b000065:
    "Слёзы настоящие, но и следующая за ними улыбка тоже: острая, уверенная. Улыбка женщины, которая приобретает собственность, а не отдаёт себя."

# ch/alexis/base.rpy:410
translate russian alexis_propose_male_e158f03f:
    alexis.say "Да. Только давай проясним одну вещь, [lssb_alexis.hero_name()]. Не я становлюсь твоей. Ты становишься моим."

# ch/alexis/base.rpy:412
translate russian alexis_propose_male_739d27a4:
    alexis.say "Ты мой, [lssb_alexis.hero_name()]. На этот раз навсегда."

# ch/alexis/base.rpy:416
translate russian alexis_propose_male_88c41c71:
    "Но когда Алексис наконец подаёт какой-то знак, он оказывается совсем не тем, которого я ждал."

# ch/alexis/base.rpy:417
translate russian alexis_propose_male_79b6d86f:
    "Сначала она ничего не говорит, лишь медленно качает головой, а затем всё быстрее."

# ch/alexis/base.rpy:418
translate russian alexis_propose_male_8edec4c8:
    "И мне не нужно объяснять, что это значит."

# ch/alexis/base.rpy:419
translate russian alexis_propose_male_07fff7a1:
    "Я уже чувствую, как сердце ломается пополам."

# ch/alexis/base.rpy:420
translate russian alexis_propose_male_26f5c943:
    "Она опять это сделала. Второй раз разбила мне сердце!"

# ch/alexis/base.rpy:422
translate russian alexis_propose_male_cab4d54e:
    alexis.say "О боже..."

# ch/alexis/base.rpy:423
translate russian alexis_propose_male_f5efefbd:
    alexis.say "Мне так жаль, [lssb_alexis.hero_name()]!"

# ch/alexis/base.rpy:424
translate russian alexis_propose_male_91ad701a:
    alexis.say "Но я не могу выйти за тебя... просто не могу."

# ch/alexis/base.rpy:426
translate russian alexis_propose_male_b2477ef3:
    "Я всё ещё стою на коленях и понимаю, что должен подняться."

# ch/alexis/base.rpy:427
translate russian alexis_propose_male_e3f5c444:
    "Но не могу удержаться от ответа."

# ch/alexis/base.rpy:428
translate russian alexis_propose_male_e5029dd2:
    "Хотя знаю, что выгляжу жалко, словно умоляю Алексис."

# ch/alexis/base.rpy:429
translate russian alexis_propose_male_dd5c9dd1:
    "Впрочем... я и правда её умоляю!"

# ch/alexis/base.rpy:430
translate russian alexis_propose_male_230f746f:
    "Я просто не могу остановиться."

# ch/alexis/base.rpy:431
translate russian alexis_propose_male_c301fe55:
    mike.say "Но..."

# ch/alexis/base.rpy:432
translate russian alexis_propose_male_0ffd04d4:
    mike.say "Но почему, Алексис?"

# ch/alexis/base.rpy:433
translate russian alexis_propose_male_e03bfdb3:
    mike.say "Я думал, мы оба пошли дальше и оставили прошлое позади?"

# ch/alexis/base.rpy:434
translate russian alexis_propose_male_48d6b02c:
    mike.say "Разве сейчас мы не ладим лучше, чем когда-либо?"

# ch/alexis/base.rpy:435
translate russian alexis_propose_male_5512e40e:
    "Алексис качает головой, и я вижу, что мои слова причиняют ей боль."

# ch/alexis/base.rpy:436
translate russian alexis_propose_male_ef8ffefa:
    "Это дарит мне слабую надежду."

# ch/alexis/base.rpy:437
translate russian alexis_propose_male_42b57d79:
    "Потому что проблема, возможно, не в самих отношениях."

# ch/alexis/base.rpy:439
translate russian alexis_propose_male_6156f7d4:
    alexis.say "Именно поэтому сейчас у нас всё получается, [lssb_alexis.hero_name()]!"

# ch/alexis/base.rpy:440
translate russian alexis_propose_male_e409248d:
    alexis.say "Разве ты не понимаешь?"

# ch/alexis/base.rpy:441
translate russian alexis_propose_male_7f54ea4f:
    alexis.say "Ты больше не зацикливаешься на вещах, которые не имеют значения."

# ch/alexis/base.rpy:443
translate russian alexis_propose_male_283d6083:
    alexis.say "Мы сохранили лёгкость и непринуждённость, и это работает!"

# ch/alexis/base.rpy:444
translate russian alexis_propose_male_8ebc250a:
    alexis.say "Наша проблема всегда была в избытке обязательств, а не в их недостатке!"

# ch/alexis/base.rpy:446
translate russian alexis_propose_male_4ab6a234:
    "Это совсем не то, что я хотел услышать."

# ch/alexis/base.rpy:447
translate russian alexis_propose_male_6dfc6190:
    "Но слушая объяснения Алексис, я всё равно начинаю соглашаться."

# ch/alexis/base.rpy:448
translate russian alexis_propose_male_8e3a13e0:
