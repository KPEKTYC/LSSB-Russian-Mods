# ch/alexis/base.rpy:530
translate russian alexis_ask_date_audrey_reona_b1bf5684:
    alexis.say "С удовольствием."

# ch/alexis/chat.rpy:2
translate russian alexis_desire_0_male_dfb9b2c4:
    alexis.say "[lssb_alexis.hero_name()], тебе когда-нибудь хочется просто вернуться в то время, когда мы вместе учились в школе?"

# ch/alexis/chat.rpy:3
translate russian alexis_desire_0_male_f1df7586:
