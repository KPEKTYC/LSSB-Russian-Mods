# ch/alexis/chat.rpy:84
translate russian alexis_desire_4_male_ff6099ba:
    mike.say "Я очень рад, что ты не поддалась сомнениям, Алексис."

# ch/alexis/chat.rpy:85
translate russian alexis_desire_4_male_aaf357c2:
    mike.say "Мне кажется, нам всегда было суждено снова сойтись, даже спустя столько времени."

# ch/alexis/chat.rpy:88
translate russian alexis_desire_4_male_0ffa1a7f:
