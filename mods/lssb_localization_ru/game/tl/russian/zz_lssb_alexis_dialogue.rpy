# ch/alexis/chat.rpy:41
translate russian alexis_desire_2_male_ec30085d:
    alexis.say "Полегче, [lssb_alexis.hero_name()]. Комплименты приятны, но ничего тебе не дают. Прикасаться ко мне будешь, когда я решу, что ты заслужил."

# ch/alexis/chat.rpy:44
translate russian alexis_desire_2_male_d5a5b6e7:
    mike.say "Да ладно, Алексис, не такой уж я и красавчик, правда?"

# ch/alexis/chat.rpy:47
translate russian alexis_desire_2_male_64c3a271:
