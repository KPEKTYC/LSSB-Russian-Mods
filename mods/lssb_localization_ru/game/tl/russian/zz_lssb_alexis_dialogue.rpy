# ch/alexis/base.rpy:460
translate russian alexis_propose_male_9e309b2b:
    "Несмотря на всю нежность последних дней, есть черта, которую она пока не готова переступить. Связать себя навсегда — всё ещё по ту сторону."

# ch/alexis/base.rpy:462
translate russian alexis_propose_male_1d47d396:
