# ch/alexis/events.rpy:5551
translate russian alexis_restaurant_toilet_core_3f6278be_1:
    "Как и то, что Алексис сидит у него на коленях."

# ch/alexis/events.rpy:5552
translate russian alexis_restaurant_toilet_core_99a07d03:
    "А вот он моему появлению, похоже, очень удивлён!"

# ch/alexis/events.rpy:5554
translate russian alexis_restaurant_toilet_core_ea06287e:
