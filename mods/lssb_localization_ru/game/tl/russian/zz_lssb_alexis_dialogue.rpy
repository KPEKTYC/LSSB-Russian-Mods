# ch/alexis/chat.rpy:77
translate russian alexis_desire_4_male_c7e79d6c:
    alexis.say "Лучшим моим решением было понять, что ради меня ты пойдёшь на всё, [lssb_alexis.hero_name()]. Будь хорошим мальчиком и продолжай это доказывать."

# ch/alexis/chat.rpy:79
translate russian alexis_desire_4_male_7af87051:
