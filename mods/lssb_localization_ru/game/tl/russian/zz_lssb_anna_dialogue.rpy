# ch/anna/reactions.rpy:370
translate russian anna_belly_kiss_male_f8aee0b4:
    "Потому что это одна из тех вещей, которые невозможно предсказать у беременной женщины."

# ch/anna/reactions.rpy:371
translate russian anna_belly_kiss_male_aff28669:
    "Иногда они хотят получить все внимание и ласку мира для своего животика."

# ch/anna/reactions.rpy:372
translate russian anna_belly_kiss_male_9578d3ac:
    "А иногда они хотят, чтобы их не делали центром внимания."

# ch/anna/reactions.rpy:373
translate russian anna_belly_kiss_male_6ed5d90c:
    "Но я думаю, что знаю, какая Анна."

# ch/anna/reactions.rpy:374
translate russian anna_belly_kiss_male_e453e224:
    "И мое предположение подтверждается, когда она начинает смотреть на меня с восторгом."

# ch/anna/reactions.rpy:376
translate russian anna_belly_kiss_male_837b2506:
    anna.say "Правда?"

# ch/anna/reactions.rpy:378
translate russian anna_belly_kiss_male_fee8b2b9:
    anna.say "Тогда почему ты не целуешь это?"

# ch/anna/reactions.rpy:380
translate russian anna_belly_kiss_male_17f911b1:
    anna.say "Слушай, а почему ты сейчас же не целуешь это?!"

# ch/anna/reactions.rpy:382
translate russian anna_belly_kiss_male_d3bbab69:
    "Анна буквально впихивает свой живот мне, говоря все это."

# ch/anna/reactions.rpy:383
translate russian anna_belly_kiss_male_821f85fc:
    "Что оставляет мне только один выход – подтвердить свои слова делом."

# ch/anna/reactions.rpy:384
translate russian anna_belly_kiss_male_a19c2aaa:
    "Или, если быть точнее, прижать свои губы к ее животику."

# ch/anna/reactions.rpy:385
translate russian anna_belly_kiss_male_3be41747:
    "И как только я начинаю целовать, мне становится трудно остановиться!"

# ch/anna/reactions.rpy:386
translate russian anna_belly_kiss_male_39bf6dd7:
    "Все это время Анна смотрит на меня вниз, и по ее лицу видно, что она довольна."

# ch/anna/reactions.rpy:391
translate russian anna_belly_caress_male_e777cafe:
    "Я должен признать, что немного волновался, когда у Анны начались изменения, связанные с беременностью."

# ch/anna/reactions.rpy:392
translate russian anna_belly_caress_male_dd767215:
    "Меня беспокоило, что беременность радикально изменит ее тело."

# ch/anna/reactions.rpy:393
translate russian anna_belly_caress_male_a9532cf0:
    "Даже то, что это может сделать ее менее привлекательной для меня."

# ch/anna/reactions.rpy:394
translate russian anna_belly_caress_male_0ba32920:
    "Но, если честно, моя тяга к ней только усилилась в той же степени, что и вырос ее живот!"

# ch/anna/reactions.rpy:395
translate russian anna_belly_caress_male_a10b40ba:
    "Я не могу оторвать от нее глаз."

# ch/anna/reactions.rpy:396
translate russian anna_belly_caress_male_fc3cb48d:
    "И, вероятно, это потому, что я просто не могу удержаться от желания дотронуться до этого."

# ch/anna/reactions.rpy:397
translate russian anna_belly_caress_male_4a215f83:
    "Хотя я боюсь, что Анна может посчитать это странным, понимаешь?"

# ch/anna/reactions.rpy:398
translate russian anna_belly_caress_male_2dffc6cb:
    "Поэтому я просто пытаюсь украдкой поглядывать время от времени."

# ch/anna/reactions.rpy:399
translate russian anna_belly_caress_male_719abef2:
    "Надеясь на..."

# ch/anna/reactions.rpy:401
translate russian anna_belly_caress_male_f844adf4:
    anna.say "Эй..."

# ch/anna/reactions.rpy:402
translate russian anna_belly_caress_male_b93438e4:
    anna.say "Ты пялишься на мой живот?!"

# ch/anna/reactions.rpy:404
translate russian anna_belly_caress_male_2431c5e3:
    "Черт..."

# ch/anna/reactions.rpy:405
translate russian anna_belly_caress_male_f6b3092f:
    "Похоже, меня поймали с поличным."

# ch/anna/reactions.rpy:406
translate russian anna_belly_caress_male_e2e9ab0a:
    "Значит, мне лучше признаться и принять последствия."

# ch/anna/reactions.rpy:407
translate russian anna_belly_caress_male_f1d8a63c:
    mike.say "Эм..."

# ch/anna/reactions.rpy:408
translate russian anna_belly_caress_male_a10117d5:
    mike.say "Да, Анна..."

# ch/anna/reactions.rpy:409
translate russian anna_belly_caress_male_4e39a737:
    mike.say "Я просто не могу себя контролировать!"

# ch/anna/reactions.rpy:411
translate russian anna_belly_caress_male_7096e4e9:
    "К моему удивлению, Анна качает головой и улыбается мне."

# ch/anna/reactions.rpy:412
translate russian anna_belly_caress_male_060e5c87:
    "Затем она прижимает свой живот прямо к себе, весело смеясь."

# ch/anna/reactions.rpy:414
translate russian anna_belly_caress_male_24388207:
    anna.say "Ну вот..."

# ch/anna/reactions.rpy:415
translate russian anna_belly_caress_male_01b244d2:
    anna.say "Пожалуйста, прикасайся!"

# ch/anna/reactions.rpy:417
translate russian anna_belly_caress_male_5caeaaf4:
    "Уже протягивая руку, чтобы коснуться его, я все еще чувствую необходимость спросить."

# ch/anna/reactions.rpy:418
translate russian anna_belly_caress_male_032851d4:
    mike.say "Ты уверена?"

# ch/anna/reactions.rpy:419
translate russian anna_belly_caress_male_28708db3:
    anna.say "Конечно, [lssb_anna.hero_name()]."

# ch/anna/reactions.rpy:420
translate russian anna_belly_caress_male_69b6ef50:
    anna.say "Ты так же виновата в этом, как и я!"

# ch/anna/reactions.rpy:421
translate russian anna_belly_caress_male_c052f37c:
    "Я киваю и кладу руки на живот Анны."

# ch/anna/reactions.rpy:422
translate russian anna_belly_caress_male_9456bfde:
    "И когда я чувствую первое движение, я поднимаю голову."

# ch/anna/reactions.rpy:423
translate russian anna_belly_caress_male_04b768d6:
    "Это значит, что я смотрю ей прямо в глаза."

# ch/anna/reactions.rpy:424
translate russian anna_belly_caress_male_194aa33a:
    "Наш обмен происходит абсолютно без слов."

# ch/anna/reactions.rpy:425
translate russian anna_belly_caress_male_aaacb7b8:
    "Но это заставляет меня чувствовать к ней такую сильную любовь."

# ch/anna/reactions.rpy:426
translate russian anna_belly_caress_male_163f8bc7:
    "Любовь, которую я никогда раньше не испытывал."

# ch/anna/reactions.rpy:431
translate russian anna_belly_listen_male_590dae18:
    anna.say "[lssb_anna.hero_name()]..."

# ch/anna/reactions.rpy:432
translate russian anna_belly_listen_male_590dae18_1:
    anna.say "[lssb_anna.hero_name()]..."

# ch/anna/reactions.rpy:434
translate russian anna_belly_listen_male_399114dd:
    "В тот момент, когда я слышу, как Анна кричит мое имя, я оборачиваюсь."

# ch/anna/reactions.rpy:435
translate russian anna_belly_listen_male_a10117d5:
    mike.say "Да, Аня..."

# ch/anna/reactions.rpy:436
translate russian anna_belly_listen_male_d6ebbe2b:
    mike.say "Что случилось?"

# ch/anna/reactions.rpy:438
translate russian anna_belly_listen_male_7f6ceb4e:
    "Но прежде чем я успеваю сказать еще слово, она хватает меня."

# ch/anna/reactions.rpy:439
translate russian anna_belly_listen_male_b4c4767f:
    "И затем она тянет мою голову вниз."

# ch/anna/reactions.rpy:441
translate russian anna_belly_listen_male_5daa1e54:
    anna.say "Тебе это обязательно нужно посмотреть..."

# ch/anna/reactions.rpy:442
translate russian anna_belly_listen_male_893d5ccf:
    anna.say "Поверь мне, тебе это очень понравится!"

# ch/anna/reactions.rpy:444
translate russian anna_belly_listen_male_d719599e:
    "Сейчас Анна не причиняет мне боли."

# ch/anna/reactions.rpy:445
translate russian anna_belly_listen_male_5fa7b920:
    "И она сильнее, чем кажется."

# ch/anna/reactions.rpy:446
translate russian anna_belly_listen_male_aa575cec:
    "Поэтому я решаю пока что согласиться и играть по ее правилам."

# ch/anna/reactions.rpy:448
translate russian anna_belly_listen_male_71e7f1e2:
    "И вот я оказываюсь с ухом, прижатым к изгибу ее живота."

# ch/anna/reactions.rpy:449
translate russian anna_belly_listen_male_f6651de2:
    "Я собирался что-то сказать, когда почувствовал, как ребенок шевельнулся возле моей головы."

# ch/anna/reactions.rpy:450
translate russian anna_belly_listen_male_15cb483b:
    "Но одновременно я слышу еще кое-что, и это заставляет меня остановиться."

# ch/anna/reactions.rpy:451
translate russian anna_belly_listen_male_e7ba714d:
    "Это странный звук, похожий на слабое движение чего-то глубоко под водой."

# ch/anna/reactions.rpy:452
translate russian anna_belly_listen_male_820d9f57:
    "Но нет никаких сомнений: это шевелится малыш."

# ch/anna/reactions.rpy:453
translate russian anna_belly_listen_male_03dba935:
    "Поднимая глаза к Анне, я, должно быть, выгляжу так же удивленным и восторженным, как она."

# ch/anna/reactions.rpy:454
translate russian anna_belly_listen_male_190a070f:
    mike.say "Ты..."

# ch/anna/reactions.rpy:456
translate russian anna_belly_listen_male_001bf1b3:
    anna.say "Да!"

# ch/anna/reactions.rpy:457
translate russian anna_belly_listen_male_7ffcb4fe:
    mike.say "Ты имеешь в виду, что..."

# ch/anna/reactions.rpy:458
translate russian anna_belly_listen_male_001bf1b3_1:
    anna.say "Да!"

# ch/anna/reactions.rpy:459
translate russian anna_belly_listen_male_b4dc7126:
    mike.say "Я только что услышал, как двигался ребенок?!"

# ch/anna/reactions.rpy:460
translate russian anna_belly_listen_male_001bf1b3_2:
    anna.say "Да!"

# ch/anna/reactions.rpy:461
translate russian anna_belly_listen_male_33addd93:
    "В этот момент я не могу ничего другого сделать."

# ch/anna/reactions.rpy:462
translate russian anna_belly_listen_male_a87d912b:
    "Поэтому я вскакиваю и обнимаю Анну, прижимая ее к себе."

# ch/anna/reactions.rpy:463
translate russian anna_belly_listen_male_aeaa4b4c:
    "Она отвечает на объятия, учитывая положение своего живота."

# ch/anna/reactions.rpy:464
translate russian anna_belly_listen_male_633dc5f1:
    "И мы переживаем глубокий, значимый момент, который навсегда запомним."

# ch/anna/talk.rpy:2
translate russian anna_talk_love_male_2f8d2040:
    mike.say "Наверное, вопрос избитый, но что ты думаешь о любви, Анна?"

# ch/anna/talk.rpy:5
translate russian anna_talk_love_male_7252aa22:
    anna.say "Конечно, я верю в любовь. Как иначе, если внутри меня растёт наш малыш?"

# ch/anna/talk.rpy:7
translate russian anna_talk_love_male_39afc409:
    anna.say "Думаю, любовь повсюду... Ха, вот тебе ещё одна банальность!"

# ch/anna/talk.rpy:8
translate russian anna_talk_love_male_6651301e:
    anna.say "Серьезно, ты должен иметь возможность любить того, кого выберешь."

# ch/anna/talk.rpy:12
translate russian anna_talk_love_male_406f7bc9:
    anna.say "О, ещё бы! Моя бывшая девушка была чертовски горячей, [lssb_anna.hero_name()]."

# ch/anna/talk.rpy:13
translate russian anna_talk_love_male_4ab55210:
    anna.say "Девушки, парни — я люблю тех, кого люблю. Быть би — значит брать лучшее от обоих миров!"

# ch/anna/talk.rpy:17
translate russian anna_talk_love_male_88208f14:
    anna.say "О, да! Честно, [lssb_anna.hero_name()], сейчас я ни на кого, кроме тебя, не смотрю."

# ch/anna/talk.rpy:18
translate russian anna_talk_love_male_48e4a085:
    anna.say "Ни одна девушка, ни один парень — вообще никто с тобой не сравнится."

# ch/anna/talk.rpy:25
translate russian anna_talk_sex_male_6f962d19:
    mike.say "Ты современная девушка, Анна. В сексе ты ведь без предрассудков?"

# ch/anna/talk.rpy:28
translate russian anna_talk_sex_male_1824b09a:
    "На лице Анны появляется комично преувеличенное выражение беспокойства и серьезности."

# ch/anna/talk.rpy:29
translate russian anna_talk_sex_male_9fe8b32b:
    anna.say "Так жаль, что из-за малыша моя киска пока под запретом."

# ch/anna/talk.rpy:31
translate russian anna_talk_sex_male_21996077:
    anna.say "Ну что ж, придётся тебе найти другое место, куда меня трахать!"

# ch/anna/talk.rpy:34
translate russian anna_talk_sex_male_e66bee80:
    "Анна краснеет и отказывается смотреть мне в глаза."

# ch/anna/talk.rpy:35
translate russian anna_talk_sex_male_903ee529:
    anna.say "Я не думаю, что достаточно хорошо тебя знаю, чтобы чувствовать себя комфортно, говоря об этом."

# ch/anna/talk.rpy:39
translate russian anna_talk_sex_male_a4191761:
    "Анна улыбается и поднимает брови."

# ch/anna/talk.rpy:40
translate russian anna_talk_sex_male_9e0e0da2:
    anna.say "О да, мои последние серьёзные отношения были с девушкой... мне нравятся и парни, и девушки!"

# ch/anna/talk.rpy:43
translate russian anna_talk_sex_male_03bed757:
    "Анна улыбается, в ее глазах появляется легкий намек на озорство."

# ch/anna/talk.rpy:44
translate russian anna_talk_sex_male_38d54d14:
    anna.say "Ну, меня сложно назвать консервативной…"

# ch/anna/talk.rpy:46
translate russian anna_talk_sex_male_a2e1755b:
    "Она добавляет шепотом."

# ch/anna/talk.rpy:47
translate russian anna_talk_sex_male_cb066e69:
    anna.say "Мне вообще-то нравится в попку!"

# ch/anna/talk.rpy:50
translate russian anna_talk_sex_male_45f70281:
    "Анна оглядывается по сторонам, чтобы убедиться, что никто не подслушивает."

# ch/anna/talk.rpy:52
translate russian anna_talk_sex_male_7ca453f4:
    anna.say "Не рассказывай никому... но мне это как-то больше нравится в заднице."

# ch/anna/talk.rpy:58
translate russian anna_talk_politics_male_051872dc:
    mike.say "Кто получит твой голос на следующих выборах, Анна?"

# ch/anna/talk.rpy:61
translate russian anna_talk_politics_male_de5daf0a:
    anna.say "Раньше я просто думала, что все они – отбросы общества."

# ch/anna/talk.rpy:62
translate russian anna_talk_politics_male_0716bab7:
    anna.say "Но теперь, когда мы собираемся стать родителями, я боюсь за будущее нашего ребенка при такой власти."

# ch/anna/talk.rpy:64
translate russian anna_talk_politics_male_f11c56a1:
    "Анна скрещивает руки на своей достаточно внушительной груди и хмурится."

# ch/anna/talk.rpy:65
translate russian anna_talk_politics_male_bb15a4dc:
    anna.say "Все они одинаковые: только и хотят нас поиметь, причём вовсе не в хорошем смысле!"

# ch/anna/talk.rpy:70
translate russian anna_talk_food_male_38ac6db8:
    mike.say "Никак не придумаю, что хочу съесть вечером. А ты, Анна?"

# ch/anna/talk.rpy:73
translate russian anna_talk_food_male_e550a773:
    anna.say "Эм, кажется, у меня начались тяги."

# ch/anna/talk.rpy:75
translate russian anna_talk_food_male_20c254ad:
    anna.say "Мне все еще хочется суши, но теперь я не могу есть их без арахисовой пасты или мороженого!"

# ch/anna/talk.rpy:77
translate russian anna_talk_food_male_f790a5f3:
    anna.say "Обожаю японскую еду: суши, рамен, что угодно!"

# ch/anna/talk.rpy:78
translate russian anna_talk_food_male_62b8bc42:
    anna.say "Все это здорово!"

# ch/anna/talk.rpy:83
translate russian anna_talk_travels_male_f2a8ceb0:
    mike.say "Надоело смотреть на одни и те же четыре стены. Вот бы куда-нибудь уехать, правда, Анна?"

# ch/anna/talk.rpy:86
translate russian anna_talk_travels_male_91a618f2:
    anna.say "Я даже не могу пройти через улицу, мои ноги так сильно опухли!"

# ch/anna/talk.rpy:87
translate russian anna_talk_travels_male_23cfdc73:
    "Она кокетливо моргает мне, явно чего-то желая."

# ch/anna/talk.rpy:89
translate russian anna_talk_travels_male_e7e05dc1:
    anna.say "Ты сделаешь мне массаж ног, [lssb_anna.hero_name()]?"

# ch/anna/talk.rpy:92
translate russian anna_talk_travels_male_28f1113f:
    "Я вижу звезды в глазах Анны, когда она начинает мечтать."

# ch/anna/talk.rpy:93
translate russian anna_talk_travels_male_53da2046:
    anna.say "О, [lssb_anna.hero_name()], было бы здорово, если бы группа отправилась в турне!"

# ch/anna/talk.rpy:101
translate russian anna_talk_tv_male_09d7404c:
    mike.say "Аня..."

# ch/anna/talk.rpy:102
translate russian anna_talk_tv_male_90ebde24:
    anna.say "Хм... да, [lssb_anna.hero_name()]?"

# ch/anna/talk.rpy:103
translate russian anna_talk_tv_male_c389e815:
    mike.say "Как насчет того, чтобы ты зашла ко мне и посмотрела сегодня вечером несколько фильмов ужасов {b}?{/b}"

# ch/anna/talk.rpy:104
translate russian anna_talk_tv_male_030f8fab:
    anna.say "Конечно!"

# ch/anna/talk.rpy:105
translate russian anna_talk_tv_male_57c17e61:
    mike.say "У меня довольно хороший телевизор и всё такое..."

# ch/anna/talk.rpy:106
translate russian anna_talk_tv_male_953ea71f:
    anna.say "Хорошо, давай!"

# ch/anna/talk.rpy:107
translate russian anna_talk_tv_male_b15c4126:
    mike.say "То есть не обязательно соглашаться прямо сейчас. И вообще не обязательно, если не хочется!"

# ch/anna/talk.rpy:109
translate russian anna_talk_tv_male_82d2c205:
    anna.say "Ой, [lssb_anna.hero_name()], я уже дважды сказала \"да\"!"

# ch/anna/talk.rpy:110
translate russian anna_talk_tv_male_652afbed:
    mike.say "О... хорошо... значит, это свидание?"

# ch/anna/talk.rpy:114
translate russian anna_talk_tv_male_e639df0c:
    mike.say "Хочется расслабиться перед телевизором. Что посоветуешь, Анна?"

# ch/anna/talk.rpy:115
translate russian anna_talk_tv_male_854d47e9:
    anna.say "Раньше я была безумно увлечена фильмами ужасов."

# ch/anna/talk.rpy:117
translate russian anna_talk_tv_male_3d31df1b:
    anna.say "Но с тех пор, как мы забеременели, мне больше не хочется их смотреть."

# ch/anna/talk.rpy:119
translate russian anna_talk_tv_male_e639df0c_1:
    mike.say "Хочется расслабиться перед телевизором. Что посоветуешь, Анна?"

# ch/anna/talk.rpy:120
translate russian anna_talk_tv_male_e1fda8c5:
    anna.say "О, это обязательно должны быть фильмы ужасов!"

# ch/anna/talk.rpy:122
translate russian anna_talk_tv_male_69652360:
    anna.say "Чем больше вероятность, что я испугаюсь и закричу, тем лучше!"

# ch/anna/talk.rpy:128
translate russian anna_talk_sports_male_0e38509a:
    mike.say "Спорта сейчас столько, что всё как-то проходит мимо меня. А ты как, Анна?"

# ch/anna/talk.rpy:131
translate russian anna_talk_sports_male_b0bd30e4:
    anna.say "Я сейчас даже не могу увидеть свои пальцы ног, [lssb_anna.hero_name()], не говоря уже о том, чтобы до них дотронуться!"

# ch/anna/talk.rpy:134
translate russian anna_talk_sports_male_38daad2f:
    "Анна сморщила нос, выражая явное недовольство темой разговора."

# ch/anna/talk.rpy:135
translate russian anna_talk_sports_male_5191f264:
    anna.say "Фу, нет, терпеть не могу спорт, да и качки меня совсем не привлекают..."

# ch/anna/talk.rpy:141
translate russian anna_talk_fashion_male_b7adcc15:
    mike.say "Ты, кажется, никогда не интересуешься последними модными тенденциями, Анна."

# ch/anna/talk.rpy:144
translate russian anna_talk_fashion_male_bbd50ee8:
    anna.say "Я недавно видела очень классные топы для беременных с логотипами музыкальных групп!"

# ch/anna/talk.rpy:146
translate russian anna_talk_fashion_male_29fa9670:
    anna.say "Я считаю, что мода – это способ выразить себя и свои взгляды."

# ch/anna/talk.rpy:148
translate russian anna_talk_fashion_male_58deb5e4:
    anna.say "Если ты идешь на поводу у толпы, ты, по сути, говоришь, что ты овца."

# ch/anna/talk.rpy:154
translate russian anna_talk_books_male_7da2ed2d:
    mike.say "Ни разу не видел тебя с книгой, Анна. Ты много читаешь?"

# ch/anna/talk.rpy:157
translate russian anna_talk_books_male_97159186:
    anna.say "Я стараюсь читать перед сном."

# ch/anna/talk.rpy:158
translate russian anna_talk_books_male_363cae7c:
    anna.say "Но обычно я так вымотана, что сразу засыпаю."

# ch/anna/talk.rpy:161
translate russian anna_talk_books_male_715e5235:
    anna.say "Да, просто я не ношу книги с собой постоянно."

# ch/anna/talk.rpy:162
translate russian anna_talk_books_male_e8f80703:
    anna.say "Я люблю читать философию, сейчас мой любимый автор – Спиноза."

# ch/anna/talk.rpy:168
translate russian anna_talk_people_male_ec63cfc5:
    mike.say "Может быть, это только мне так кажется, Анна, или большинство людей в мире – придурки?"

# ch/anna/talk.rpy:170
translate russian anna_talk_people_male_4afbf007:
    "Анна немного нахмурилась из-за моего замечания."

# ch/anna/talk.rpy:172
translate russian anna_talk_people_male_41088b02:
    anna.say "Я раньше думала, что люди в основном хорошие."

# ch/anna/talk.rpy:173
translate russian anna_talk_people_male_16f4d871:
    anna.say "Но теперь у меня есть ребенок, о котором нужно заботиться, и я постоянно вижу только плохое во всех."

# ch/anna/talk.rpy:177
translate russian anna_talk_people_male_50fe8c27:
    anna.say "Эй, [lssb_anna.hero_name()], это довольно негативное мнение!"

# ch/anna/talk.rpy:178
translate russian anna_talk_people_male_b83bc44c:
    anna.say "Я думаю, что каждый человек в глубине души хороший, просто они хорошо это скрывают."

# ch/anna/talk.rpy:183
translate russian anna_talk_computers_male_1e430bdd:
    mike.say "Я недавно купил новый ноутбук. Ты увлекаешься компьютерами, Анна?"

# ch/anna/talk.rpy:185
translate russian anna_talk_computers_male_337f1b74:
    anna.say "О нет, с компьютерами я не дружу!"

# ch/anna/talk.rpy:187
translate russian anna_talk_computers_male_61b8be2e:
    anna.say "Кажется, они тоже об этом знают и испытывают ко мне какую-то обиду."

# ch/anna/talk.rpy:193
translate russian anna_talk_music_male_163648f1:
    anna.say "Я обожаю музыку, какая твоя любимая группа?"

# ch/anna/talk.rpy:196
translate russian anna_talk_music_male_44d54049:
    mike.say "Disrupted, наверное, одни из лучших, возможно, моя самая любимая."

# ch/anna/talk.rpy:198
translate russian anna_talk_music_male_9678b828:
    anna.say "О боже, Дэвид Дрэйман такой сексуальный!"

# ch/anna/talk.rpy:201
translate russian anna_talk_music_male_ed06a5da:
    mike.say "Конечно, One and a half direction, кто же ещё!"

# ch/anna/talk.rpy:203
translate russian anna_talk_music_male_65fad958:
    anna.say "Брр... извини, что спросила!"

# ch/anna/talk.rpy:206
translate russian anna_talk_music_male_bf6bff38:
    mike.say "И все это с трехголосным гармоничным звучанием!"

# ch/anna/talk.rpy:207
translate russian anna_talk_music_male_7215ad1f:
    mike.say "Конечно же, Tendancious B."

# ch/anna/talk.rpy:209
translate russian anna_talk_music_male_a0b41096:
    anna.say "Ох, они такие смешные! Когда я впервые услышала тот альбом, чуть не описалась, честное слово."

# ch/anna/talk.rpy:212
translate russian anna_talk_music_male_91b8ef55:
    mike.say "Честно, Анна? Что угодно, кроме того грохота, который вы с Harpies называете музыкой."

# ch/anna/talk.rpy:214
translate russian anna_talk_music_male_71289c08:
    anna.say "О нет, ты ведь НЕ сказал этого, [lssb_anna.hero_name()]!"

# ch/anna/talk.rpy:215
translate russian anna_talk_music_male_008463a1:
    anna.say "Продолжай в том же духе — и усилители на каждый концерт будешь таскать ТЫ!"

# ch/anna/talk.rpy:216
translate russian anna_talk_music_male_5eeedb3b:
    "В её глазах вспыхивает огонь, который я редко вижу. И мне это даже нравится."

# ch/anna/talk.rpy:220
translate russian anna_talk_music_male_a2c64836:
    mike.say "Metallikea, с ними никто и рядом не стоял."

# ch/anna/talk.rpy:222
translate russian anna_talk_music_male_0604f971:
    anna.say "Лучшая...метал-группа...всех времен!"

# ch/anna/talk.rpy:223
translate russian anna_talk_music_male_de1a58f1:
    anna.say "По крайней мере, до альбома \"Black\"."

# ch/anna/talk.rpy:224
translate russian anna_talk_music_male_bf1a32b8:
    mike.say "Не знаю, мне вот нравятся некоторые песни с Load и Re-Load..."

# ch/anna/talk.rpy:226
translate russian anna_talk_music_male_8e13b527:
    "Анна смотрит на меня с выражением показного возмущения, но при этом улыбается."

# ch/anna/talk.rpy:234
translate russian anna_talk_birthday_male_f42d8ea1:
    mike.say "Эй, с днём рождения, Анна!"

# ch/anna/talk.rpy:236
translate russian anna_talk_birthday_male_eef279e3:
    anna.say "Ой, спасибо, [lssb_anna.hero_name()], ты не забыл!"

# ch/anna/talk.rpy:261
translate russian anna_talk_kleio_66ff903a:
    "Как бы я ни пытался отогнать эти мысли, я все равно постоянно думаю о ссоре Анны и Клео."

# ch/anna/talk.rpy:262
translate russian anna_talk_kleio_c5e5a870:
    "Не судите меня слишком строго за это, но Клео на самом деле права в чем-то."

# ch/anna/talk.rpy:263
translate russian anna_talk_kleio_0236389d:
    "Конечно, она была такой же деликатной, как член осла, когда решила этим заняться."

# ch/anna/talk.rpy:264
translate russian anna_talk_kleio_58fe8386:
    "Но Анна довольно кроткая и не за себя постоит, когда дело доходит до конфликта."

# ch/anna/talk.rpy:265
translate russian anna_talk_kleio_4e26fc3f:
    "Ирония в том, что, скорее всего, эту проблему так и не решат именно по той причине, из-за которой Клео начала с ней спорить."

# ch/anna/talk.rpy:267
translate russian anna_talk_kleio_ab2c3843:
    anna.say "Эм... привет, [lssb_anna.hero_name()]."

# ch/anna/talk.rpy:268
translate russian anna_talk_kleio_7fad16ad:
    mike.say "Привет, Анна."

# ch/anna/talk.rpy:269
translate russian anna_talk_kleio_c38d8e27:
    mike.say "Ты уже поговорила с Клео?"

# ch/anna/talk.rpy:270
translate russian anna_talk_kleio_74b98e38:
    "На другом конце провода повисла неловкая пауза."

# ch/anna/talk.rpy:271
translate russian anna_talk_kleio_db92b357:
    "И тут Анна заговорила уставшим голосом."

# ch/anna/talk.rpy:273
translate russian anna_talk_kleio_b66251ad:
    anna.say "Нет..."

# ch/anna/talk.rpy:274
translate russian anna_talk_kleio_1c2db91e:
    anna.say "Нет, я этого не делала."

# ch/anna/talk.rpy:275
translate russian anna_talk_kleio_3967cb5e:
    mike.say "Хорошо, Анна, нам нужно поговорить об этом."

# ch/anna/talk.rpy:276
translate russian anna_talk_kleio_91e74364:
    anna.say "Ты имеешь в виду..."

# ch/anna/talk.rpy:277
translate russian anna_talk_kleio_7e2c5aa5:
    anna.say "Это что-то вроде \"вмешательства\"?"

# ch/anna/talk.rpy:278
translate russian anna_talk_kleio_acdf7648:
    mike.say "Не стоит так драматизировать, Анна."

# ch/anna/talk.rpy:279
translate russian anna_talk_kleio_450bb4bb:
    mike.say "Я просто думаю, нам нужно поговорить, это все."

# ch/anna/talk.rpy:280
translate russian anna_talk_kleio_d8524e02:
    "Я слышу, как Анна тяжело вздыхает."

# ch/anna/talk.rpy:284
translate russian anna_talk_kleio_4ac83ca2:
    anna.say "Хорошо..."

# ch/anna/talk.rpy:287
translate russian anna_talk_kleio_e2bb236a:
    anna.say "Давай покончим с этим..."

# ch/anna/talk.rpy:288
translate russian anna_talk_kleio_7a3b69c5:
    mike.say "Не будь такой, Анна."

# ch/anna/talk.rpy:289
translate russian anna_talk_kleio_f655c10b:
    mike.say "Я знаю, насколько важна для тебя твоя дружба с Клео."

# ch/anna/talk.rpy:291
translate russian anna_talk_kleio_c81913e4:
    mike.say "И вы бы не дружили столько лет, если бы в этой дружбе не было ничего хорошего."

# ch/anna/talk.rpy:292
translate russian anna_talk_kleio_f18b13a6:
    mike.say "Вы же, в конце концов, играете в одной группе."

# ch/anna/talk.rpy:293
translate russian anna_talk_kleio_2d5680cb:
    mike.say "Наверняка вы так ссоритесь не впервые, правда?"

# ch/anna/talk.rpy:294
translate russian anna_talk_kleio_63da4dcc:
    "Анна отводит взгляд, либо не желая, либо неспособная встретить мой взгляд."

# ch/anna/talk.rpy:295
translate russian anna_talk_kleio_53e3d1d5:
    mike.say "Давай же, Анна..."

# ch/anna/talk.rpy:297
translate russian anna_talk_kleio_4322da36:
    anna.say "Хорошо, я признаю это."

# ch/anna/talk.rpy:298
translate russian anna_talk_kleio_7465efab:
    anna.say "У нас уже были ссоры."

# ch/anna/talk.rpy:299
translate russian anna_talk_kleio_c0b4c3c1:
    anna.say "Но..."

# ch/anna/talk.rpy:300
translate russian anna_talk_kleio_530a9cce:
    mike.say "Но что, Анна?"

# ch/anna/talk.rpy:302
translate russian anna_talk_kleio_71b5d484:
    "Анна издает звук разочарования."

# ch/anna/talk.rpy:303
translate russian anna_talk_kleio_1001821e:
    "Она даже качает головой и топает ногами."

# ch/anna/talk.rpy:304
translate russian anna_talk_kleio_5d02bcb6:
    anna.say "Ладно, ладно..."

# ch/anna/talk.rpy:305
translate russian anna_talk_kleio_f3611728:
    anna.say "Просто раньше у меня не было с кем об этом поговорить, [lssb_anna.hero_name()]."

# ch/anna/talk.rpy:306
translate russian anna_talk_kleio_df166365:
    "Мне нужно несколько секунд, чтобы понять это признание."

# ch/anna/talk.rpy:307
translate russian anna_talk_kleio_8bee69c2:
    "Но потом я сам должен покачать головой, прежде чем ответить."

# ch/anna/talk.rpy:308
translate russian anna_talk_kleio_0da06953:
    mike.say "Анна, ты действительно говоришь то, что я думаю?"

# ch/anna/talk.rpy:309
translate russian anna_talk_kleio_f1e24e9b:
    mike.say "То, что ты не пыталась наладить отношения с Клео из-за меня?"

# ch/anna/talk.rpy:310
translate russian anna_talk_kleio_3598cd86:
    mike.say "Потому что тебе нравится это сочувствие?"

# ch/anna/talk.rpy:311
translate russian anna_talk_kleio_a5e334b8:
    anna.say "Мне так жаль, [lssb_anna.hero_name()]!"

# ch/anna/talk.rpy:313
translate russian anna_talk_kleio_83396593:
    anna.say "Пойми, больше меня никто не слушает!"

# ch/anna/talk.rpy:314
translate russian anna_talk_kleio_c9f9043d:
    anna.say "Всё, что Саша делает, это говорит мне, чтобы я стала более зрелой!"

# ch/anna/talk.rpy:315
translate russian anna_talk_kleio_6eea3936:
    "Я вздыхаю от бессилия, но потом не могу удержаться и начинаю смеяться."

# ch/anna/talk.rpy:316
translate russian anna_talk_kleio_bd1b03d6:
    "Вся эта ситуация кажется такой нелепой, теперь, когда я разобрался во всем до конца."

# ch/anna/talk.rpy:317
translate russian anna_talk_kleio_ce37787f:
    "Это просто буря в стакане воды, а Анна получает удовольствие от того, что я для нее как плечо, на которое можно опереться."

# ch/anna/talk.rpy:318
translate russian anna_talk_kleio_65f2c418:
    mike.say "Ладно, Анна, пора с этим заканчивать."

# ch/anna/talk.rpy:319
translate russian anna_talk_kleio_18cbd0d2:
    mike.say "Тебе и Клео нужно поговорить и разобраться."

# ch/anna/talk.rpy:320
translate russian anna_talk_kleio_7e9ce3f4:
    mike.say "И если ты этого не сделаешь, я действительно рассержусь на тебя."

# ch/anna/talk.rpy:322
translate russian anna_talk_kleio_28911a99:
    "Анна снова опускает взгляд на свои ноги, кивая, как послушный ребенок."

# ch/anna/talk.rpy:323
translate russian anna_talk_kleio_7485af25:
    anna.say "Хорошо, [lssb_anna.hero_name()]."

# ch/anna/talk.rpy:324
translate russian anna_talk_kleio_aed0f753:
    anna.say "Я сейчас же ей позвоню."

# ch/anna/talk.rpy:325
translate russian anna_talk_kleio_c56720eb:
    "Я киваю в знак согласия, надеясь, что заставил Анну сделать правильный выбор."

# ch/anna/talk.rpy:328
translate russian anna_talk_kleio_e2fcd185:
    mike.say "Это важно и для меня."

# ch/anna/talk.rpy:329
translate russian anna_talk_kleio_3bed62b7:
    mike.say "И важны наши отношения друг с другом."

# ch/anna/talk.rpy:330
translate russian anna_talk_kleio_0412392c:
    mike.say "Я не хочу, чтобы все это было разрушено из-за какой-то глупой ссоры."

# ch/anna/talk.rpy:332
translate russian anna_talk_kleio_2138266c:
    "Анна отводит взгляд, внезапно не желая смотреть мне в глаза."

# ch/anna/talk.rpy:333
translate russian anna_talk_kleio_3655f23b:
    "Но я вижу, как краснеют ее щеки, что говорит о том, что я задел ее чувства."

# ch/anna/talk.rpy:334
translate russian anna_talk_kleio_3d9101c9:
    mike.say "Давай же, Анна."

# ch/anna/talk.rpy:335
translate russian anna_talk_kleio_ffe3d040:
    mike.say "Я не хочу потерять вас обеих."

# ch/anna/talk.rpy:336
translate russian anna_talk_kleio_fb3e3412:
    "Вдруг Анна снова оборачивается."

# ch/anna/talk.rpy:338
translate russian anna_talk_kleio_66842ed2:
    "И я вижу, как в уголках ее глаз начинают появляться слезы."

# ch/anna/talk.rpy:339
translate russian anna_talk_kleio_5f199c14:
    anna.say "О, [lssb_anna.hero_name()]..."

# ch/anna/talk.rpy:340
translate russian anna_talk_kleio_581a4eae:
    anna.say "Мне так жаль!"

# ch/anna/talk.rpy:341
translate russian anna_talk_kleio_819619bd:
    "Ее извинения застают меня врасплох, потому что я этого не ожидал."

# ch/anna/talk.rpy:342
translate russian anna_talk_kleio_ada81ff9:
    mike.say "Все в порядке, Анна."

# ch/anna/talk.rpy:343
translate russian anna_talk_kleio_1bacec2e:
    mike.say "Но ты не думаешь, что Клео – это та, кому стоит извиниться?"

# ch/anna/talk.rpy:344
translate russian anna_talk_kleio_1c9f6a1b:
    "В ответ Анна качает головой и начинает издавать тихий стон."

# ch/anna/talk.rpy:345
translate russian anna_talk_kleio_d2903ced:
    anna.say "Нет, [lssb_anna.hero_name()], ты не понимаешь."

# ch/anna/talk.rpy:346
translate russian anna_talk_kleio_f0fec52a:
    anna.say "Я не злилась на Клео, я ревновала!"

# ch/anna/talk.rpy:347
translate russian anna_talk_kleio_3d77794f:
    mike.say "Что ты имеешь в виду, Анна?"

# ch/anna/talk.rpy:348
translate russian anna_talk_kleio_1afc4564:
    mike.say "Что заставило тебя испытывать ревность к ней?"

# ch/anna/talk.rpy:349
translate russian anna_talk_kleio_90e0e2a9:
    "Слезы текут по лицу Анны, пока она начинает изливать свои переживания."

# ch/anna/talk.rpy:350
translate russian anna_talk_kleio_80bcb040:
