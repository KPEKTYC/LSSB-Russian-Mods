# ch/anna/base.rpy:26
translate russian anna_bye_037ee845:
    anna.say "Наверное, мне стоит идти спать."

# ch/anna/base.rpy:28
translate russian anna_bye_f233be04:
    anna.say "Я пойду в ванную, только не заглядывай!"

# ch/anna/base.rpy:30
translate russian anna_bye_a73f5bb3:
    anna.say "У меня сейчас занятия, наверное, мне пора идти."

# ch/anna/base.rpy:32
translate russian anna_bye_f3751a52:
    anna.say "Я так голодна..."

# ch/anna/base.rpy:34
translate russian anna_bye_b9830f37:
    anna.say "Ты знаешь, что сейчас показывают по телевизору?"

# ch/anna/base.rpy:36
translate russian anna_bye_e278666a:
    anna.say "Я пойду в паб выпью чего-нибудь, до встречи."

# ch/anna/base.rpy:38
translate russian anna_bye_1aaaddb1:
    anna.say "Сегодня солнечно, думаю, я схожу позагорать."

# ch/anna/base.rpy:40
translate russian anna_bye_31acc046:
    anna.say "Мне хочется пойти по магазинам."

# ch/anna/base.rpy:42
translate russian anna_bye_67ef0f47:
    anna.say "Сейчас пойду почитаю книгу, начала одну очень интересную."

# ch/anna/base.rpy:44
translate russian anna_bye_43a43445:
    anna.say "Я иду в клуб, мне хочется повеселиться."

# ch/anna/base.rpy:46
translate russian anna_bye_cb8f3fcd:
    anna.say "Мне нужно немного поработать, пока."

# ch/anna/base.rpy:48
translate russian anna_bye_535000e0:
    anna.say "Я сейчас оденусь."

# ch/anna/base.rpy:59
translate russian anna_cheated_5caba36d:
    anna.say "Эй, это несправедливо!"

# ch/anna/base.rpy:60
translate russian anna_cheated_463faea7:
    anna.say "Я тоже хочу повеселиться!"

# ch/anna/base.rpy:62
translate russian anna_cheated_ef1099dd:
    "И внезапно Анна целует меня."

# ch/anna/base.rpy:73
translate russian anna_cheated_809d848c:
    "Я вижу, как Анна грустно смотрит на меня [lssb_anna.action_text(action)], слезы наворачиваются у нее на глаза..."

# ch/anna/base.rpy:84
translate russian anna_greet_cc82bf70:
    anna.say "Привет, [lssb_anna.hero_name()]."

# ch/anna/base.rpy:86
translate russian anna_greet_92207a24:
    anna.say "Здравствуй, [lssb_anna.hero_name()]."

# ch/anna/base.rpy:89
translate russian anna_greet_0750f91e:
    anna.say "Доброе утро, [lssb_anna.hero_name()]."

# ch/anna/base.rpy:91
translate russian anna_greet_58eaf744:
    anna.say "Добрый день, [lssb_anna.hero_name()]."

# ch/anna/base.rpy:93
translate russian anna_greet_55d9cb71:
    anna.say "Добрый вечер, [lssb_anna.hero_name()]."

# ch/anna/base.rpy:97
translate russian anna_greet_c5cd0370:
    anna.say "Можешь войти спереди или сзади, [lssb_anna.hero_name()], лишь бы кончил внутрь!"

# ch/anna/base.rpy:99
translate russian anna_greet_d7e6ba01:
    anna.say "Спереди или сзади, [lssb_anna.hero_name()], выбирай сам."

# ch/anna/base.rpy:100
translate russian anna_greet_4cf775c5:
    mike.say "Что?"

# ch/anna/base.rpy:101
translate russian anna_greet_a7c5642b:
    anna.say "Выбирай, [lssb_anna.hero_name()], трахни меня спереди или сзади!"

# ch/anna/base.rpy:108
translate russian anna_greet_dialogues_male_40fdd8d0:
    mike.say "Привет, Анна."

# ch/anna/base.rpy:110
translate russian anna_greet_dialogues_male_6810e1f5:
    mike.say "Привет."

# ch/anna/base.rpy:113
translate russian anna_greet_dialogues_male_40fdd8d0_1:
    mike.say "Привет, Анна."

# ch/anna/base.rpy:115
translate russian anna_greet_dialogues_male_998c684a:
    mike.say "Доброе утро, Анна."

# ch/anna/base.rpy:117
translate russian anna_greet_dialogues_male_a1e14986:
    mike.say "Добрый день, Анна."

# ch/anna/base.rpy:119
translate russian anna_greet_dialogues_male_66e11981:
    mike.say "Добрый вечер, Анна."

# ch/anna/base.rpy:126
translate russian anna_kiss_2094d022:
    "Когда Анна в настроении, она действительно полна энергии, и ей очень легко передать это настроение другим."

# ch/anna/base.rpy:127
translate russian anna_kiss_94145176:
    "Сейчас она просто излучает позитив и заражает меня тем же."

# ch/anna/base.rpy:128
translate russian anna_kiss_b0d7fae6:
    "Так что как я могу винить себя за то, что попытался поцеловать ее, когда она немного позже наклонилась ко мне?"

# ch/anna/base.rpy:129
translate russian anna_kiss_16b16259:
    "Как я мог знать, что ей просто нужно было что-то прошептать и убедиться, что я это услышал?"

# ch/anna/base.rpy:130
translate russian anna_kiss_03c096ec:
    "Но независимо от того, что она хотела мне сказать, это вскоре забывается из-за моей собственной ошибки."

# ch/anna/base.rpy:131
translate russian anna_kiss_62c2c820:
    "И если вы хотите узнать, что может испортить хорошее настроение у Анны, то просто посмотрите на то, что я только что сделал!"

# ch/anna/base.rpy:140
translate russian anna_kiss_59db6c96:
    "Мне стыдно признаваться, но я был настолько сосредоточен на том, чтобы впервые поцеловать Анну."

# ch/anna/base.rpy:141
translate russian anna_kiss_3897180d:
    "Не то чтобы сам акт меня беспокоил или пугал, а скорее механика того, как мне нужно наклониться и сделать это."

# ch/anna/base.rpy:142
translate russian anna_kiss_d58cd6da:
    "Она такая маленькая, что я просто не знаю, как все будет происходить, когда я решу это сделать!"

# ch/anna/base.rpy:143
translate russian anna_kiss_e794d96f:
    "Но в конечном итоге, это немного улучшает ситуацию."

# ch/anna/base.rpy:144
translate russian anna_kiss_341b1d30:
    "Видеть это милое личико, смотрящее на меня сверху, эти огромные глаза, полные предвкушения..."

# ch/anna/base.rpy:145
translate russian anna_kiss_18912721:
    "Анна встает на носочки, даже немного подпрыгивает, чтобы встретить меня наполовину."

# ch/anna/base.rpy:146
translate russian anna_kiss_8e1a8912:
    "И усилия, которые мы оба должны приложить, делают этот момент еще более особенным."

# ch/anna/base.rpy:155
translate russian anna_kiss_bd9974e9:
    "Конечно, я могу наклониться и поцеловать Анну или ответить на ее приглашение, когда она хочет меня поцеловать."

# ch/anna/base.rpy:156
translate russian anna_kiss_f96a5099:
    "Но мне больше всего нравятся моменты, когда мы можем позволить себе сделать что-то, что уравновешивает нас."

# ch/anna/base.rpy:157
translate russian anna_kiss_584c0af3:
    "Когда все спокойно, Анна прыгает ко мне на руки, почти прижимаясь ко мне."

# ch/anna/base.rpy:158
translate russian anna_kiss_fdd49a8f:
    "Или она садится у меня на колени и обнимает меня за шею."

# ch/anna/base.rpy:159
translate russian anna_kiss_a95a6a8d:
    "Что бы вы ни говорили о высоких, элегантных женщинах и о том, что они способны делать..."

# ch/anna/base.rpy:160
translate russian anna_kiss_a0cece58:
    "Ничто из этого не сравнится с очарованием ноутбука..."

# ch/anna/base.rpy:167
translate russian anna_propose_male_2818bd17:
    "Казалось бы, просто подойти к Анне и задать ей этот вопрос – самое простое дело в мире."

# ch/anna/base.rpy:168
translate russian anna_propose_male_a9f28b31:
    "Мы ведь проводим почти каждую свободную минуту вместе уже довольно долгое время."

# ch/anna/base.rpy:169
translate russian anna_propose_male_8c746956:
    "Даже когда мы не вместе, она постоянно у меня в голове, пока не наступит следующий раз, когда мы сможем встретиться."

# ch/anna/base.rpy:170
translate russian anna_propose_male_574d99c3:
    "И я прекрасно понимаю, что это не просто мимолетное увлечение и с моей стороны тоже."

# ch/anna/base.rpy:171
translate russian anna_propose_male_51bf1a0c:
    "Анна звонит мне всякий раз, как только есть возможность, а если нет, то постоянно пишет сообщения."

# ch/anna/base.rpy:172
translate russian anna_propose_male_ce2d06a5:
    "Обычно такая навязчивость, когда кто-то постоянно цепляется к тебе..."

# ch/anna/base.rpy:173
translate russian anna_propose_male_6de76750:
    "Ну, это было бы довольно раздражающе, возможно, даже жутко."

# ch/anna/base.rpy:174
translate russian anna_propose_male_258beac6:
    "Но с Анной, почему-то, этого никогда не происходит."

# ch/anna/base.rpy:175
translate russian anna_propose_male_1bd81a5a:
    "И я начинаю с нетерпением ждать каждого раза, когда она связывается со мной."

# ch/anna/base.rpy:176
translate russian anna_propose_male_d9e4294f:
    "Думаю, объяснение очень простое: я её люблю."

# ch/anna/base.rpy:177
translate russian anna_propose_male_d628f811:
    "Я не могу это отрицать, даже если бы хотел."

# ch/anna/base.rpy:178
translate russian anna_propose_male_e3e79aae:
    "Поэтому я чувствую, что делаю абсолютно правильную вещь, когда опускаюсь на одно колено перед Анной."

# ch/anna/base.rpy:179
translate russian anna_propose_male_9f2d69b9:
    "Эффект немного портится тем фактом, что она отворачивается, когда я это делаю."

# ch/anna/base.rpy:180
translate russian anna_propose_male_0ee5a126:
    "То есть, когда она поворачивает голову в мою сторону, возникает неловкий момент замешательства."

# ch/anna/base.rpy:183
translate russian anna_propose_male_75565785:
    anna.say "А... [lssb_anna.hero_name()]?"

# ch/anna/base.rpy:184
translate russian anna_propose_male_1ab91a12:
    anna.say "Ты куда пропал?"

# ch/anna/base.rpy:186
translate russian anna_propose_male_aad06dee:
    mike.say "Я здесь, Анна."

# ch/anna/base.rpy:187
translate russian anna_propose_male_048e0ae8:
    "Анна смотрит на меня."

# ch/anna/base.rpy:188
translate russian anna_propose_male_fd51d085:
    "И тут она слегка вздрагивает, обнаружив меня так близко, но вне ее поля зрения."

# ch/anna/base.rpy:190
translate russian anna_propose_male_4a35074b:
    anna.say "Ой, вот ты где!"

# ch/anna/base.rpy:191
translate russian anna_propose_male_5c33806e:
    anna.say "Что такое? Ты что-то уронил?"

# ch/anna/base.rpy:193
translate russian anna_propose_male_cb020b92:
    "У меня на лице появляется улыбка, я полон решимости, чтобы все прошло так, как я задумал."

# ch/anna/base.rpy:194
translate russian anna_propose_male_dcb28f46:
    mike.say "Эм, нет..."

# ch/anna/base.rpy:195
translate russian anna_propose_male_ff000fce:
    mike.say "Не совсем, Анна."

# ch/anna/base.rpy:196
translate russian anna_propose_male_0e210a73:
    mike.say "Я хотел спросить..."

# ch/anna/base.rpy:197
translate russian anna_propose_male_9dad1582:
    mike.say "То есть, я пытался набраться смелости..."

# ch/anna/base.rpy:198
translate russian anna_propose_male_144356df:
    "Я наблюдаю, как понимание словно озаряет Анну, ее глаза вспыхивают внезапным осознанием."

# ch/anna/base.rpy:199
translate russian anna_propose_male_31a5f2f4:
    "Это приносит некоторое облегчение."

# ch/anna/base.rpy:200
translate russian anna_propose_male_f809cffe:
    "Заставляя меня думать, что скоро я смогу встать с колена и надеть ей кольцо на палец."

# ch/anna/base.rpy:202
translate russian anna_propose_male_7cfd8fc7:
    anna.say "Ты глупишься, [lssb_anna.hero_name()]."

# ch/anna/base.rpy:204
translate russian anna_propose_male_daee87da:
    anna.say "Тебе не обязательно опускаться на колени, чтобы меня об этом попросить!"

# ch/anna/base.rpy:205
translate russian anna_propose_male_9dfe4eda:
    mike.say "Я...я не должен?"

# ch/anna/base.rpy:206
translate russian anna_propose_male_9ecda113:
    "В этот момент Анна наклоняется ближе и шепчет мне на ухо, как будто заговорщически."

# ch/anna/base.rpy:208
translate russian anna_propose_male_b708a129:
    anna.say "Нет, ты же знаешь, как я ОБОЖАЮ, когда ты берёшь меня в попку!"

# ch/anna/base.rpy:209
translate russian anna_propose_male_aa5de4d3:
    "А, теперь я понимаю, в чем проблема."

# ch/anna/base.rpy:210
translate russian anna_propose_male_19fe2aeb:
    "Похоже, что Анна совершенно неверно поняла ситуацию."

# ch/anna/base.rpy:211
translate russian anna_propose_male_b54becae:
    mike.say "Нет, Анна, нет!"

# ch/anna/base.rpy:212
translate russian anna_propose_male_dbfa8969:
    mike.say "Я хотел спросить, хочешь ли ты выйти за меня!"

# ch/anna/base.rpy:214
translate russian anna_propose_male_7cd60a4e:
    "Мгновенно на лице Анны появляется выражение абсолютного ужаса."

# ch/anna/base.rpy:215
translate russian anna_propose_male_aea2f0d0:
    anna.say "О нет...о нет!"

# ch/anna/base.rpy:216
translate russian anna_propose_male_981e596d:
    anna.say "Ты, наверное, думаешь, что я такая глупая дура!"

# ch/anna/base.rpy:218
translate russian anna_propose_male_7ced398f:
    anna.say "И что я еще и полная извращенка!"

# ch/anna/base.rpy:219
translate russian anna_propose_male_cb871a91:
    anna.say "Уф, Анна, ну как МОЖНО быть такой дурой?!"

# ch/anna/base.rpy:220
translate russian anna_propose_male_b54965ec:
    anna.say "Глупая, глупая, глупая!"

# ch/anna/base.rpy:222
translate russian anna_propose_male_ec25f64a:
    mike.say "Погоди, Анна, пожалуйста!"

# ch/anna/base.rpy:223
translate russian anna_propose_male_cecdbaf7:
    mike.say "Это просто небольшое недоразумение, вот и все."

# ch/anna/base.rpy:224
translate russian anna_propose_male_5e6f55e1:
    mike.say "Я не думаю, что ты глупая."

# ch/anna/base.rpy:226
translate russian anna_propose_male_f4d62108:
    mike.say "Я... я думаю, ты потрясающая, на самом деле."

# ch/anna/base.rpy:227
translate russian anna_propose_male_86f37dc7:
    mike.say "И поэтому я хочу жениться на тебе..."

# ch/anna/base.rpy:228
translate russian anna_propose_male_436c4438:
    "Именно в этот момент я достаю кольцо и предлагаю его ей."

# ch/anna/base.rpy:231
translate russian anna_propose_male_06e0d633:
    "Анна качает головой, уже отступая назад."

# ch/anna/base.rpy:232
translate russian anna_propose_male_e5df7133:
    "Я протягиваю руки, пытаясь убедить ее остаться."

# ch/anna/base.rpy:233
translate russian anna_propose_male_9bd8d2ad:
    "Но она выставляет свои руки перед собой, словно прогоняя меня."

# ch/anna/base.rpy:235
translate russian anna_propose_male_e2472ce6:
    anna.say "Нет, [lssb_anna.hero_name()]!"

# ch/anna/base.rpy:236
translate russian anna_propose_male_1970b7e3:
    anna.say "Я... я не могу выйти за тебя замуж."

# ch/anna/base.rpy:237
translate russian anna_propose_male_14f1ba00:
    anna.say "Я полная катастрофа."

# ch/anna/base.rpy:238
translate russian anna_propose_male_dc2c28f6:
    anna.say "Я... я просто опозорю тебя!"

# ch/anna/base.rpy:240
translate russian anna_propose_male_bfd9796f:
    "К этому моменту я тоже качаю головой."

# ch/anna/base.rpy:241
translate russian anna_propose_male_871927c1:
    "Я поднимаюсь с колен, все это время пытаясь уговорить Анну."

# ch/anna/base.rpy:242
translate russian anna_propose_male_b6c1fbf1:
    mike.say "Анна, я никогда не стыдился тебя."

# ch/anna/base.rpy:243
translate russian anna_propose_male_4b0f5e1a:
    mike.say "Как я мог?"

# ch/anna/base.rpy:245
translate russian anna_propose_male_dc9466f3:
    anna.say "Я знаю, что ты пытаешься сделать, [lssb_anna.hero_name()]."

# ch/anna/base.rpy:246
translate russian anna_propose_male_cb44aa5c:
    anna.say "Но это не сработает."

# ch/anna/base.rpy:247
translate russian anna_propose_male_c2ec333b:
    anna.say "Я не позволю тебе испортить свою жизнь!"

# ch/anna/base.rpy:249
translate russian anna_propose_male_7dd9dadf:
    "И тут же Анна разворачивается и убегает так быстро, как только может."

# ch/anna/base.rpy:250
translate russian anna_propose_male_734a41e6:
    "Моя первая реакция – броситься за ней, ведь поймать ее не составит особого труда."

# ch/anna/base.rpy:251
translate russian anna_propose_male_51313c5a:
    "Но я сдерживаю себя, вспоминая, насколько она была непреклонна только что."

# ch/anna/base.rpy:252
translate russian anna_propose_male_191d9dc0:
    "Может быть, лучше дать ей убежать, хотя бы ненадолго."

# ch/anna/base.rpy:253
translate russian anna_propose_male_b24332ce:
    "Возможность успокоиться и действительно подумать о моем предложении – это то, что ей сейчас нужно."

# ch/anna/base.rpy:254
translate russian anna_propose_male_3acd2e3c:
    "Я надеюсь только на то, что ее знаменитый \"рассеянный\" ум сможет немного прийти в себя."

# ch/anna/base.rpy:259
translate russian anna_propose_male_7477ddf6:
    anna.say "Ох..."

# ch/anna/base.rpy:260
translate russian anna_propose_male_bb6e1f8e:
    anna.say "Значит, ты это и имел в виду, глупышка."

# ch/anna/base.rpy:261
translate russian anna_propose_male_4608d21a:
    anna.say "Это гораздо лучше, чем анальный секс!"

# ch/anna/base.rpy:263
translate russian anna_propose_male_370f670d:
    "Анна на мгновение замирает, явно обдумывая то, что только что сказала."

# ch/anna/base.rpy:265
translate russian anna_propose_male_141536b3:
    anna.say "Ну, может быть, не лучше."

# ch/anna/base.rpy:266
translate russian anna_propose_male_014aaad7:
    anna.say "Но почти так же хорошо..."

# ch/anna/base.rpy:268
translate russian anna_propose_male_6757cf6b:
    mike.say "Ну..."

# ch/anna/base.rpy:269
translate russian anna_propose_male_c669df3b:
    mike.say "Это да?"

# ch/anna/base.rpy:271
translate russian anna_propose_male_55d2b6b5:
    "Анна смотрит на меня, словно ошеломленная."

# ch/anna/base.rpy:272
translate russian anna_propose_male_35c773c4:
    "Затем она качает головой, вспоминая, что на самом деле происходит прямо сейчас."

# ch/anna/base.rpy:274
translate russian anna_propose_male_f6644ede:
    anna.say "Ой, да, извини, [lssb_anna.hero_name()]!"

# ch/anna/base.rpy:275
translate russian anna_propose_male_4b676f81:
    anna.say "Да..."

# ch/anna/base.rpy:276
translate russian anna_propose_male_aec79ec7:
    anna.say "То есть, да, это \"да\"..."

# ch/anna/base.rpy:277
translate russian anna_propose_male_886c8305:
    anna.say "Ты понимаешь, что я имею в виду, верно?"

# ch/anna/base.rpy:279
translate russian anna_propose_male_39bbf48e:
    "Я не могу удержаться от легкой усмешки и покачивания головой."

# ch/anna/base.rpy:280
translate russian anna_propose_male_784110d1:
    "Вот моя девочка!"

# ch/anna/base.rpy:281
translate russian anna_propose_male_aa010d10:
    mike.say "Да, Анна, понимаю."

# ch/anna/base.rpy:282
translate russian anna_propose_male_e5e67b9c:
    "И вот я встаю и надеваю кольцо на палец Анны."

# ch/anna/base.rpy:283
translate russian anna_propose_male_3ebeb212:
    "У нее на лице сияющая улыбка, она просто прыгает от восторга."

# ch/anna/base.rpy:286
translate russian anna_propose_male_c7ced5de:
    anna.say "Ура... Я выхожу замуж!"

# ch/anna/base.rpy:287
translate russian anna_propose_male_b919888a:
    anna.say "За тебя!"

# ch/anna/base.rpy:289
translate russian anna_propose_male_dbca0283:
    mike.say "Ну да, Анна, в этом и был смысл!"

# ch/anna/base.rpy:290
translate russian anna_propose_male_701a57ce:
    "Анна обнимает меня за талию, крепко прижимаясь ко мне."

# ch/anna/base.rpy:291
translate russian anna_propose_male_febbb8a9:
    "И я отвечаю ей тем же, наслаждаясь ощущением ее близости."

# ch/anna/base.rpy:292
translate russian anna_propose_male_46487d4d:
    "Ощущение, которое становится еще более приятным благодаря тому, что она сказала \"да\"."

# ch/anna/base.rpy:293
translate russian anna_propose_male_8eac70b5:
    "Знание того, что мне предстоит переживать это с ней всю жизнь."

# ch/anna/base.rpy:320
translate russian anna_ask_date_anna_bree_c947e567:
    mike.say "Анна... может быть, соберемся вместе с [bree.name] для еще одного из твоих \"экспериментов\"?"

# ch/anna/base.rpy:321
translate russian anna_ask_date_anna_bree_2a45c5b2:
    anna.say "Ох, ради науки? Конечно!"

# ch/anna/base.rpy:338
translate russian anna_ask_date_amy_anna_d9fc5f1d:
    mike.say "Хочешь снова сходить в аквапарк с Эми?"

# ch/anna/base.rpy:339
translate russian anna_ask_date_amy_anna_c0777231:
    anna.say "С Эми? О да, пожалуйста! На этот раз я возьму крем от солнца."

# ch/anna/base.rpy:356
translate russian anna_ask_date_band_fivesome_686ee268:
    mike.say "Анна... как насчёт снова собрать всю группу в студии?"

# ch/anna/base.rpy:357
translate russian anna_ask_date_band_fivesome_4cf5938c:
    anna.say "О! То есть всех нас, как в прошлый раз? Я... я бы очень хотела."

# ch/anna/base.rpy:370
translate russian anna_ask_date_alone_male_b0d84c51:
    mike.say "Анна, ты не хочешь пойти со мной на свидание?"

# ch/anna/base.rpy:372
translate russian anna_ask_date_alone_male_ff5bd331:
    anna.say "Прости, [lssb_anna.hero_name()], я тебя так не воспринимаю."

# ch/anna/base.rpy:375
translate russian anna_ask_date_alone_male_99e6c218:
    anna.say "Конечно, это может быть весело. Когда ты хочешь, чтобы мы пошли?"

# ch/anna/base.rpy:380
translate russian anna_ask_date_kleio_ffcb558d:
    mike.say "Ты хочешь провести время с Клео и повеселиться?"

# ch/anna/base.rpy:381
translate russian anna_ask_date_kleio_8918e231:
    anna.say "Я бы с удовольствием."

# ch/anna/base.rpy:394
translate russian anna_ask_date_kleio_sasha_ffcb558d:
    mike.say "Ты хочешь провести время с Клео и повеселиться?"

# ch/anna/base.rpy:395
translate russian anna_ask_date_kleio_sasha_8918e231:
    anna.say "Я бы с удовольствием."

# ch/anna/base.rpy:415
translate russian anna_ask_date_emma_kat_b30f66b9:
    mike.say "Ты хочешь поразвлечься на пляже с Эммой и Кэт?"

# ch/anna/base.rpy:416
translate russian anna_ask_date_emma_kat_8918e231:
    anna.say "Я бы с удовольствием."

# ch/anna/chat.rpy:3
translate russian anna_desire_0_male_7446c6bb:
    anna.say "Ой, я так рада, что ты присоединился к группе."

# ch/anna/chat.rpy:6
translate russian anna_desire_0_male_d4e94a65:
    mike.say "Я тоже рад – надеюсь, я не все испорчу!"

# ch/anna/chat.rpy:7
translate russian anna_desire_0_male_ab607148:
    anna.say "Не волнуйся, я уверена, у тебя все получится."

# ch/anna/chat.rpy:9
translate russian anna_desire_0_male_d492eee9:
    mike.say "Я как бы поступил наобум."

# ch/anna/chat.rpy:10
translate russian anna_desire_0_male_b062b5a5:
    anna.say "Эм... хорошо."

# ch/anna/chat.rpy:13
translate russian anna_desire_0_male_542d91d7:
    mike.say "Думаю, мы будем создавать отличную музыку вместе, Анна."

# ch/anna/chat.rpy:14
translate russian anna_desire_0_male_88515598:
    anna.say "Ой, спасибо, [lssb_anna.hero_name()]!"

# ch/anna/chat.rpy:17
translate russian anna_desire_0_male_b580e0cb:
    mike.say "Мы станем настоящими рок-легендами!"

# ch/anna/chat.rpy:18
translate russian anna_desire_0_male_d4308b14:
    anna.say "Вау!"

# ch/anna/chat.rpy:21
translate russian anna_desire_0_male_7e244a03:
    anna.say "Ну что, тебе понравилась наша музыка?"

# ch/anna/chat.rpy:24
translate russian anna_desire_0_male_5b5697f8:
    mike.say "Да ну – она была довольно паршивой."

# ch/anna/chat.rpy:25
translate russian anna_desire_0_male_b062b5a5_1:
    anna.say "Эм... хорошо."

# ch/anna/chat.rpy:27
translate russian anna_desire_0_male_9147b21a:
    mike.say "Если честно, это было не совсем то, что я люблю слушать."

# ch/anna/chat.rpy:28
translate russian anna_desire_0_male_4f298ce9:
    mike.say "Обычно я слушаю поп-музыку."

# ch/anna/chat.rpy:29
translate russian anna_desire_0_male_f1d4f69e:
    anna.say "Господи помилуй..."

# ch/anna/chat.rpy:32
translate russian anna_desire_0_male_f2832f3a:
    mike.say "Конечно, мне понравилось – вы отличные ребята."

# ch/anna/chat.rpy:33
translate russian anna_desire_0_male_e4bd437b:
    anna.say "Ой, спасибо!"

# ch/anna/chat.rpy:36
translate russian anna_desire_0_male_6a796f5c:
    mike.say "Ты звучишь довольно грубо – потренируйся еще немного, и у тебя все получится."

# ch/anna/chat.rpy:42
translate russian anna_desire_1_male_0ee44d9e:
    anna.say "[lssb_anna.hero_name()]... что ты думаешь о Саше?"

# ch/anna/chat.rpy:45
translate russian anna_desire_1_male_29bd35f6:
    mike.say "Она довольно грубая – я не думаю, что ей стоит так с тобой разговаривать."

# ch/anna/chat.rpy:48
translate russian anna_desire_1_male_11fcb295:
    mike.say "Ух ты – она чертовски горячая!"

# ch/anna/chat.rpy:51
translate russian anna_desire_1_male_3c998a13:
    mike.say "С ней приятно проводить время – мне действительно нравятся дерзкие женщины."

# ch/anna/chat.rpy:54
translate russian anna_desire_1_male_fc86a7e7:
    mike.say "А... честно говоря, она мне не очень нравится."

# ch/anna/chat.rpy:55
translate russian anna_desire_1_male_a6f24acc:
    mike.say "Время для откровений – ты мне гораздо больше нравишься."

# ch/anna/chat.rpy:58
translate russian anna_desire_1_male_471fdd7d:
    anna.say "Ну что же, чем тебе нравится заниматься в свободное время?"

# ch/anna/chat.rpy:61
translate russian anna_desire_1_male_91a3e2ca:
    mike.say "Мне в основном нравится заниматься спортом – ну, знаешь, стараюсь поддерживать форму."

# ch/anna/chat.rpy:64
translate russian anna_desire_1_male_da832fdf:
    mike.say "Я люблю ходить по местным барам и знакомиться с девушками."

# ch/anna/chat.rpy:67
translate russian anna_desire_1_male_a18c88cb:
    mike.say "Обычно я много читаю, иногда часами подряд."

# ch/anna/chat.rpy:70
translate russian anna_desire_1_male_7c1fd236:
    mike.say "А чаще всего просто лежу перед телевизором."

# ch/anna/chat.rpy:75
translate russian anna_desire_2_male_ffa843b0:
    anna.say "[lssb_anna.hero_name()]... что ты думаешь о Клео?"

# ch/anna/chat.rpy:78
translate russian anna_desire_2_male_a309adf0:
    mike.say "Черт, эта девчонка ужасно раздражает!"

# ch/anna/chat.rpy:81
translate russian anna_desire_2_male_5f02d5f0:
    mike.say "Вау – она просто чертовски горячая!"

# ch/anna/chat.rpy:84
translate russian anna_desire_2_male_df09d3a3:
    mike.say "С ней очень весело проводить время."

# ch/anna/chat.rpy:87
translate russian anna_desire_2_male_b7ad51be:
    mike.say "Честно говоря, она мне не особо нравится."

# ch/anna/chat.rpy:88
translate russian anna_desire_2_male_d83c8b2f:
    mike.say "Мне гораздо больше нравится проводить время с тобой."

# ch/anna/chat.rpy:91
translate russian anna_desire_2_male_b3e9cb6c:
    anna.say "Хочешь послушать новый альбом, который я только что купила?"

# ch/anna/chat.rpy:94
translate russian anna_desire_2_male_f8516c0f:
    mike.say "Да, Анна, у тебя отличный вкус в музыке, так что это должно быть интересно."

# ch/anna/chat.rpy:97
translate russian anna_desire_2_male_e8b57277:
    mike.say "Нет... не заинтересован."

# ch/anna/chat.rpy:100
translate russian anna_desire_2_male_409a61dd:
    mike.say "Я сейчас занят, Анна, но я бы хотел, чтобы ты показала мне его позже."

# ch/anna/chat.rpy:106
translate russian anna_desire_3_male_b48b9339:
    anna.say "Я просто обожаю металл – ни одна другая музыка даже близко не передает это ощущение чистой, необузданной силы!"

# ch/anna/chat.rpy:109
translate russian anna_desire_3_male_3fa95883:
    mike.say "Это просто шум, а не музыка – у меня от этого кровь из ушей."

# ch/anna/chat.rpy:112
translate russian anna_desire_3_male_0c3feeff:
    mike.say "Что за чушь!"

# ch/anna/chat.rpy:115
translate russian anna_desire_3_male_2f757af5:
    mike.say "Я тоже – я полностью с тобой согласен."

# ch/anna/chat.rpy:118
translate russian anna_desire_3_male_1a825675:
    mike.say "Пауэр-метал – это круто, металл на полную мощность!"

# ch/anna/chat.rpy:121
translate russian anna_desire_3_male_b50d44b9:
    anna.say "Эм, [lssb_anna.hero_name()]… у тебя сейчас есть девушка?"

# ch/anna/chat.rpy:124
translate russian anna_desire_3_male_72578afe:
    mike.say "Нет, не совсем – у меня редко получаются свидания."

# ch/anna/chat.rpy:126
translate russian anna_desire_3_male_179debf0:
    mike.say "Конечно да – с кем хочу и когда хочу!"

# ch/anna/chat.rpy:129
translate russian anna_desire_3_male_ad32923f:
    mike.say "Это вообще какое-то дело твоё, Анна?"

# ch/anna/chat.rpy:132
translate russian anna_desire_3_male_7c96a22f:
    mike.say "Не волнуйся, Анна – я всегда найду для тебя время…"

# ch/anna/chat.rpy:137
translate russian anna_desire_4_male_49c67259:
    anna.say "Могу ли я спросить, с какими женщинами ты спал?"

# ch/anna/chat.rpy:140
translate russian anna_desire_4_male_289fa603:
    mike.say "Вау – это довольно личный вопрос, тебе не кажется?"

# ch/anna/chat.rpy:142
translate russian anna_desire_4_male_dd1759b5:
    mike.say "Было их десятки до того, как я встретил тебя, и будет еще десятки после тебя."

# ch/anna/chat.rpy:145
translate russian anna_desire_4_male_007cbc80:
    mike.say "Я покажу тебе свои, если ты покажешь мне свои – скажи, с какими мужчинами ты был, а я все расскажу."

# ch/anna/chat.rpy:148
translate russian anna_desire_4_male_be0953eb:
    mike.say "Не волнуйся, у меня было достаточно опыта, чтобы знать, что заставит тебя кричать…"

# ch/anna/chat.rpy:154
translate russian anna_desire_5_male_8b0f9ce3:
    anna.say "Эй, [lssb_anna.hero_name()] – какой твой любимый секс-игрушка?"

# ch/anna/chat.rpy:157
translate russian anna_desire_5_male_7608e3c2:
    mike.say "Мне все равно, чем ты хочешь меня использовать."

# ch/anna/chat.rpy:160
translate russian anna_desire_5_male_5ac49d9e:
    mike.say "У меня есть такая милая маленькая секс-кукла, которую я люблю называть \"Анна\"!"

# ch/anna/chat.rpy:168
translate russian anna_desire_5_male_c7f2cf85:
    mike.say "Позволь мне показать тебе практическую демонстрацию…"

# ch/anna/chat.rpy:171
translate russian anna_desire_5_male_ff00ab20:
    mike.say "Что угодно, что держит твою маленькую задницу в узде."

# ch/anna/chat.rpy:177
translate russian anna_love_0_male_f51dad0a:
    anna.say "Что ты думаешь о девушках, которые любят спать с... девушками?"

# ch/anna/chat.rpy:180
translate russian anna_love_0_male_07864f28:
    mike.say "Слушай, делай то, что тебе нравится – если это тебе доставляет удовольствие, значит, так и есть."

# ch/anna/chat.rpy:182
translate russian anna_love_0_male_9bc1ebec:
    mike.say "Да, я думаю, это чертовски сексуально!"

# ch/anna/chat.rpy:185
translate russian anna_love_0_male_23536cb8:
    mike.say "Любовь есть любовь, ты не можешь помешать ей принимать любую форму, необходимую для ее процветания."

# ch/anna/chat.rpy:188
translate russian anna_love_0_male_a7387e87:
    mike.say "А ты, Анна? Тебя саму когда-нибудь тянуло в эту сторону?"

# ch/anna/chat.rpy:189
translate russian anna_love_0_male_46b46a98:
    anna.say "О, ещё как! Мои последние серьёзные отношения были с девушкой, знаешь ли. Мне нравятся и те, и другие."

# ch/anna/chat.rpy:190
translate russian anna_love_0_male_fdca2af9:
    anna.say "А если честно... Есть одна басистка из другой группы, от которой у меня подкашиваются коленки..."

# ch/anna/chat.rpy:193
translate russian anna_love_0_male_49fc5d53:
    mike.say "Конечно, но сейчас ты думаешь только обо мне, правда, Анна?"

# ch/anna/chat.rpy:194
translate russian anna_love_0_male_734ea63f:
    anna.say "Ха! Попалась. Не, сейчас у меня только ты на уме, [lssb_anna.hero_name()]."

# ch/anna/chat.rpy:199
translate russian anna_love_1_male_c8de3477:
    anna.say "Эм... тебе нравятся пирсинг?"

# ch/anna/chat.rpy:202
translate russian anna_love_1_male_92d84953:
    mike.say "Ну... это не совсем то, что мне нравится."

# ch/anna/chat.rpy:204
translate russian anna_love_1_male_53541700:
    mike.say "Всемогущий сотворил тебя по своему образу и подобию, поэтому ты не должна осквернять его творение."

# ch/anna/chat.rpy:207
translate russian anna_love_1_male_e0f8cbd9:
    mike.say "Да, безусловно – пирсинг выглядит очень сексуально на девушке."

# ch/anna/chat.rpy:210
translate russian anna_love_1_male_6441d14f:
    mike.say "О да, конечно – чем больше, тем лучше!"

# ch/anna/chat.rpy:215
translate russian anna_love_2_male_7b6399d0:
    anna.say "[lssb_anna.hero_name()], что ты думаешь о девушках, которые встречаются со многими разными парнями?"

# ch/anna/chat.rpy:218
translate russian anna_love_2_male_8d9b0dc9:
    mike.say "Никто не осудит парня за то, что он встречается с множеством разных девушек – и мне, честно говоря, тоже не пристало судить."

# ch/anna/chat.rpy:221
translate russian anna_love_2_male_e1379ace:
    mike.say "Хм... кажется, ты говоришь о настоящей шлюхе!"

# ch/anna/chat.rpy:224
translate russian anna_love_2_male_e30bc2ad:
    mike.say "Поверь мне, если бы эта девушка, о которой ты говоришь, была со мной, ей бы не понадобился другой мужчина."

# ch/anna/chat.rpy:229
translate russian anna_love_3_male_40976963:
    anna.say "Ох... иногда я так хочу быть умнее..."

# ch/anna/chat.rpy:232
translate russian anna_love_3_male_7bbfc8a0:
    mike.say "Ты, возможно, не станешь членом организации MENSA в ближайшее время, Анна – но ты достаточно умна для меня."

# ch/anna/chat.rpy:235
translate russian anna_love_3_male_25bbba3c:
    mike.say "Да, я понимаю, что ты имеешь в виду – я тоже хотел бы, чтобы ты была умнее!"

# ch/anna/chat.rpy:240
translate russian anna_love_4_male_ccc1aa96:
    anna.say "Эй, [lssb_anna.hero_name()] – когда же ты уже соберешься с мыслями и пригласишь меня на свидание?"

# ch/anna/chat.rpy:243
translate russian anna_love_4_male_b076c81d:
    mike.say "Ну, я как-то ждал, что это сделаешь ты!"

# ch/anna/chat.rpy:245
translate russian anna_love_4_male_ee0aacc7:
    mike.say "Я приглашу тебя на свидание, когда захочу, а не раньше."

# ch/anna/chat.rpy:248
translate russian anna_love_4_male_e6beaabd:
    mike.say "Эй, Анна – просто будь терпеливой!"

# ch/anna/chat.rpy:251
translate russian anna_love_4_male_a9cc1781:
    mike.say "Я приглашу тебя на свидание как только подумаю, что ты к этому готова."

# ch/anna/chat.rpy:256
translate russian anna_love_5_male_5fb56b98:
    anna.say "[lssb_anna.hero_name()] - что бы ты ответил, если бы я… ну, может быть, предложила тебе выпить?"

# ch/anna/chat.rpy:259
translate russian anna_love_5_male_1a632ae5:
    mike.say "Я обязательно приду, Анна, – если это сделает тебя счастливой."

# ch/anna/chat.rpy:261
translate russian anna_love_5_male_1483ebe6:
    mike.say "А... мне нужно сначала посмотреть в свой ежедневник, убедиться, что у меня нет других планов."

# ch/anna/chat.rpy:264
translate russian anna_love_5_male_d78e8465:
    mike.say "Эй, ты называешь меня плохим другом?"

# ch/anna/chat.rpy:265
translate russian anna_love_5_male_cf9c693c:
    mike.say "Разве не я должен был тебя приглашать?"

# ch/anna/chat.rpy:268
translate russian anna_love_5_male_a0b7ce7b:
    mike.say "Конечно, я бы использовал предлог выпить, чтобы прийти к тебе."

# ch/anna/chat.rpy:269
translate russian anna_love_5_male_9e990990:
    mike.say "Но на самом деле я хочу показать тебе ночь твоей жизни!"

# ch/anna/chat.rpy:276
translate russian anna_good_sweet_talk_male_153938c5:
    mike.say "Ого... твоя задница, Анна!"

# ch/anna/chat.rpy:277
translate russian anna_good_sweet_talk_male_28223dd3:
    mike.say "Она просто завораживает меня – я не могу удержать от нее свои руки!"

# ch/anna/chat.rpy:279
translate russian anna_good_sweet_talk_male_a5802ccd:
    anna.say "Это не проблема – мне нравится, когда ты прикасаешься к ней!"

# ch/anna/chat.rpy:281
translate russian anna_good_sweet_talk_male_49d500dc:
    mike.say "Ты такая веселая, Анна!"

# ch/anna/chat.rpy:282
translate russian anna_good_sweet_talk_male_baa0fa4e:
    mike.say "И я люблю проводить с тобой время."

# ch/anna/chat.rpy:284
translate russian anna_good_sweet_talk_male_1db25870:
    anna.say "Ты тоже веселый – значит, мы отличная пара!"

# ch/anna/chat.rpy:286
translate russian anna_good_sweet_talk_male_933886b7:
    mike.say "Мне нравится твои волосы, Анна."

# ch/anna/chat.rpy:287
translate russian anna_good_sweet_talk_male_51541b9b:
    mike.say "Цвет такой яркий!"

# ch/anna/chat.rpy:289
translate russian anna_good_sweet_talk_male_29807a5d:
    anna.say "Ой... спасибо тебе!"

# ch/anna/chat.rpy:295
translate russian anna_bad_sweet_talk_male_1ccab2e1:
    mike.say "Хм..."

# ch/anna/chat.rpy:296
translate russian anna_bad_sweet_talk_male_19ae5272:
    mike.say "Анна, мне кажется, твоя грудь больше, чем твоя голова!"

# ch/anna/chat.rpy:298
translate russian anna_bad_sweet_talk_male_20021bb1:
    anna.say "Что это должно значить?!?"

# ch/anna/chat.rpy:299
translate russian anna_bad_sweet_talk_male_58e91903:
    anna.say "Ты хочешь сказать, что я глупая, но это нормально, потому что у меня большая грудь?!"

# ch/anna/chat.rpy:300
translate russian anna_bad_sweet_talk_male_943b7123:
    mike.say "Я не имел в виду этого!"

# ch/anna/condom.rpy:4
translate russian anna_use_condom_2c95946d:
    mike.say "Подожди минутку, пока я поставлю предохранитель!"

# ch/anna/condom.rpy:5
translate russian anna_use_condom_91b7196c:
    "Анна снова хихикает, а я неуклюже шарю в темноте на прикроватной тумбочке в поисках презервативов, не желая отводить от нее взгляд."

# ch/anna/condom.rpy:6
translate russian anna_use_condom_a8a87107:
    "Я быстро надеваю презерватив, не желая терять ни секунды."

# ch/anna/condom.rpy:8
translate russian anna_use_condom_565b2940:
    "Несмотря на то, что она так охотно идет навстречу и легко поддается, это не повод быть неосторожным, пока я получаю удовольствие от общения с Анной."

# ch/anna/condom.rpy:9
translate russian anna_use_condom_7ac01edd:
    "Поэтому я делаю паузу, чтобы взять презерватив с прикроватной тумбочки и надеть его, прежде чем двигаться дальше."

# ch/anna/condom.rpy:10
translate russian anna_use_condom_0651c0c8:
    "Анна оглядывается через плечо и видит, что меня задерживает, и даже не пытается возразить из-за этой задержки."

# ch/anna/condom.rpy:12
translate russian anna_use_condom_fa6f3b91:
    "Я вижу несколько презервативов на прикроватной тумбочке и хватаю один, когда оказываюсь достаточно близко."

# ch/anna/condom.rpy:13
translate russian anna_use_condom_20614e25:
    "Анна внимательно наблюдает за мной, пока я переворачиваюсь на спину и надеваю презерватив на свой теперь уже очень твердый член."

# ch/anna/condom.rpy:14
translate russian anna_use_condom_00d57f6d:
    "Мне трудно сосредоточиться, потому что она смотрит на меня как голодное животное, ожидая подходящего момента для нападения."

# ch/anna/condom.rpy:16
translate russian anna_use_condom_62a47b98:
    "Но нужно позаботиться о безопасности."

# ch/anna/condom.rpy:17
translate russian anna_use_condom_fb49e9f9:
    "Поэтому я поднимаю руку, чтобы остановить Анну."

# ch/anna/condom.rpy:18
translate russian anna_use_condom_af64f287:
    mike.say "Подожди минутку, Анна."

# ch/anna/condom.rpy:19
translate russian anna_use_condom_5932d637:
    mike.say "Нам следует воспользоваться защитой."

# ch/anna/condom.rpy:20
translate russian anna_use_condom_636417bd:
    "Анна смотрит на меня и моргает, словно она совсем забыла об этом."

# ch/anna/condom.rpy:21
translate russian anna_use_condom_6a350c34:
    "Затем кивает, призывая меня поскорее всё уладить."

# ch/anna/condom.rpy:22
translate russian anna_use_condom_5c938a8c:
    "Я понимаю намёк, хватаю презерватив и надеваю его с рекордной скоростью."

# ch/anna/condom.rpy:23
translate russian anna_use_condom_d0a062e8:
    "Теперь всё готово."

# ch/anna/condom.rpy:29
translate russian anna_intro_condom_f749ab29:
    mike.say "Он полностью заряжен и готов к использованию!"

# ch/anna/condom.rpy:31
translate russian anna_intro_condom_80210e50:
    "Уверен, менее внушаемая и податливая девушка без презерватива остановила бы меня сразу."

# ch/anna/condom.rpy:32
translate russian anna_intro_condom_63decc5b:
    "Но с Анной нет такой проблемы, потому что ей, похоже, нравится перекладывать всю ответственность на мои плечи."

# ch/anna/condom.rpy:33
translate russian anna_intro_condom_74dcafc0:
    "Стремясь воспользоваться тем, насколько она легка в общении, я не колеблюсь и сразу же прыгаю на нее."

# ch/anna/condom.rpy:35
translate russian anna_intro_condom_ca1bbb67:
    "Я слегка перевернулся на спину, и мой очень напряженный член потянул за собой простыни, как жердь палатки."

# ch/anna/condom.rpy:36
translate russian anna_intro_condom_598894f9:
    "Анна смотрит не на меня, а на мой член, оценивая его так, будто это единственное, что имеет значение для нее в данный момент."

# ch/anna/condom.rpy:37
translate russian anna_intro_condom_a9d68abc:
    "Я чувствую, что она уже представляет, какие ощущения у нее будут, когда он окажется внутри."

# ch/anna/condom.rpy:43
translate russian anna_warn_condom_4d3f44c9:
    "В тот момент, когда я собираюсь продолжить, Анна моргает на меня и хихикает."

# ch/anna/condom.rpy:44
translate russian anna_warn_condom_d9a36903:
    anna.say "Погоди, глупышка..."

# ch/anna/condom.rpy:45
translate russian anna_warn_condom_589e9ae9:
    anna.say "Ты же забыл про эту маленькую резиночку?"

# ch/anna/condom.rpy:47
translate russian anna_warn_condom_b37b23f1:
    "Но прежде чем я успеваю что-либо сделать, Анна отворачивается с мечтательной морщинкой на лбу."

# ch/anna/condom.rpy:48
translate russian anna_warn_condom_46501d37:
    anna.say "Стой, стой..."

# ch/anna/condom.rpy:49
translate russian anna_warn_condom_7e8398e3:
    anna.say "Мы должны использовать презерватив, верно?"

# ch/anna/condom.rpy:50
translate russian anna_warn_condom_c9f7b078:
    anna.say "Я почти уверена, что это правило!"

# ch/anna/condom.rpy:56
translate russian anna_force_condom_28b50edc:
    "Анна копается в простынях, ее язык высовывается от концентрации."

# ch/anna/condom.rpy:57
translate russian anna_force_condom_fca9e376:
    anna.say "У меня где-то есть один... ага!"

# ch/anna/condom.rpy:58
translate russian anna_force_condom_5b300d04:
    "Она поднимает маленький пакетик, как будто выиграла приз, и сияет на меня."

# ch/anna/condom.rpy:59
translate russian anna_force_condom_1c1fa18f:
    anna.say "Видишь? Я тоже могу быть ответственной!"

# ch/anna/condom.rpy:60
translate russian anna_force_condom_238dee13:
    "Я беру его у нее, разворачиваю, и она наблюдает за всем этим широко раскрытыми, заинтересованными глазами."

# ch/anna/condom.rpy:62
translate russian anna_force_condom_d34959d1:
    anna.say "Нет-нет, без этого никуда!"

# ch/anna/condom.rpy:63
translate russian anna_force_condom_5dd94d4f:
    "Анна хихикает и достает откуда-то презерватив, прижимая его к моей руке."

# ch/anna/condom.rpy:64
translate russian anna_force_condom_682ee4d7:
    "Она все еще улыбается мне, но ясно, что она не намерена уступать в этом вопросе."

# ch/anna/condom.rpy:65
translate russian anna_force_condom_51cb5f82:
    "Поэтому я разрываю упаковку и надеваю его, а она радостно хлопает в ладоши."

# ch/anna/condom.rpy:71
translate russian anna_mad_condom_f4279ab2:
    mike.say "Ну же, Анна, может, только разочек без него?"

# ch/anna/condom.rpy:72
translate russian anna_mad_condom_f28231e3:
    "Мечтательная улыбка на лице Анны исчезает, и ее нижняя губа вытягивается в дугу."

# ch/anna/condom.rpy:73
translate russian anna_mad_condom_05df0094:
    anna.say "Это несправедливо..."

# ch/anna/condom.rpy:74
translate russian anna_mad_condom_01c81419:
    anna.say "Я не хочу попасть в неприятности!"

# ch/anna/condom.rpy:75
translate russian anna_mad_condom_bde9502b:
    "Она выскальзывает из-под меня и начинает собирать свою одежду."

# ch/anna/condom.rpy:76
translate russian anna_mad_condom_4fd415e0:
    anna.say "Мы можем поиграть снова, когда ты будешь хорошо себя вести, ладно?"

# ch/anna/condom.rpy:78
translate russian anna_mad_condom_af161ab1:
    mike.say "Забудь о презервативе, Анна, так будет гораздо приятнее."

# ch/anna/condom.rpy:79
translate russian anna_mad_condom_4fb82ba9:
    "Впервые Анна совсем не выглядит соблазнительно."

# ch/anna/condom.rpy:80
translate russian anna_mad_condom_d00c42f5:
    anna.say "Ни за что!"

# ch/anna/condom.rpy:81
translate russian anna_mad_condom_4c5f9de9:
    anna.say "Моя подруга рассказала мне, что происходит, и я этого делать не буду!"

# ch/anna/condom.rpy:82
translate russian anna_mad_condom_1ab904f5:
    "Она спрыгивает с кровати, прижимая одежду к груди."

# ch/anna/condom.rpy:83
translate russian anna_mad_condom_1f46acd3:
    "И вот так, настроение окончательно испорчено."

# ch/anna/date.rpy:2
translate russian anna_date_intro_valentine_male_db28d45c:
    anna.say "Привет, любимый!"

# ch/anna/date.rpy:3
translate russian anna_date_intro_valentine_male_2ab55253:
    anna.say "Ты рад меня видеть?"

# ch/anna/date.rpy:4
translate russian anna_date_intro_valentine_male_d4d9ef53:
    "Я не могу сдержать улыбку, когда Анна подбегает ко мне."

# ch/anna/date.rpy:5
translate russian anna_date_intro_valentine_male_58f51ae5:
    "Она сегодня выглядит такой милой и полной энергии."

# ch/anna/date.rpy:6
translate russian anna_date_intro_valentine_male_1040df6f:
    mike.say "Конечно, я рад, Анна!"

# ch/anna/date.rpy:7
translate russian anna_date_intro_valentine_male_30b73ba2:
    mike.say "И я так рад, что ты моя Валентина!"

# ch/anna/date.rpy:8
translate russian anna_date_intro_valentine_male_a49b7a44:
    anna.say "Я тоже!"

# ch/anna/date.rpy:9
translate russian anna_date_intro_valentine_male_2518ed51:
    anna.say "Так чего же мы ждем?"

# ch/anna/date.rpy:10
translate russian anna_date_intro_valentine_male_ed64ec3d:
    anna.say "Пойдем, повеселимся!"

# ch/anna/date.rpy:14
translate russian anna_date_intro_halloween_male_99be930f:
    anna.say "Привет, [lssb_anna.hero_name()]! Сладость или гадость?"

# ch/anna/date.rpy:15
translate russian anna_date_intro_halloween_male_ebf1d4c8:
    "Я поворачиваюсь и вижу, что Анна стоит передо мной, улыбаясь и махая рукой."

# ch/anna/date.rpy:16
translate russian anna_date_intro_halloween_male_6b8c2f83:
    mike.say "Ух ты, Анна, по-моему, ты точно сладость!"

# ch/anna/date.rpy:17
translate russian anna_date_intro_halloween_male_4e68f1b1:
    "Улыбка Анны становится еще шире, когда я ее хвалю, и она немного краснеет."

# ch/anna/date.rpy:18
translate russian anna_date_intro_halloween_male_f909600b:
    anna.say "Ой, прекрати, [lssb_anna.hero_name()], ты мне неловко делаешь!"

# ch/anna/date.rpy:19
translate russian anna_date_intro_halloween_male_8eea169e:
    anna.say "Хотя... не останавливайся. Мне нравится, когда ты так говоришь!"

# ch/anna/date.rpy:20
translate russian anna_date_intro_halloween_male_00600291:
    "Анна подбегает туда, где я стою, и хватает меня за руку."

# ch/anna/date.rpy:21
translate russian anna_date_intro_halloween_male_d1207ce4:
    "Она крепко сжимает его и прислоняется ко мне, прижимаясь к моей стороне."

# ch/anna/date.rpy:22
translate russian anna_date_intro_halloween_male_c1a547c5:
    anna.say "Давай, мы же должны идти на свидание."

# ch/anna/date.rpy:23
translate russian anna_date_intro_halloween_male_3a623689:
    anna.say "И я позабочусь о том, чтобы тебе было очень хорошо!"

# ch/anna/date.rpy:27
translate russian anna_date_intro_christmas_male_0030d905:
    anna.say "Привет, [lssb_anna.hero_name()], с Рождеством!"

# ch/anna/date.rpy:28
translate russian anna_date_intro_christmas_male_375d86b7:
    anna.say "Какой подарок ты мне приготовил, а?"

# ch/anna/date.rpy:29
translate russian anna_date_intro_christmas_male_b313c96e:
    "Я улыбаюсь и качаю головой, не в силах сопротивляться позитиву Анны."

# ch/anna/date.rpy:30
translate russian anna_date_intro_christmas_male_51224fde:
    mike.say "Тебе просто нужно подождать и посмотреть, Аня."

# ch/anna/date.rpy:31
translate russian anna_date_intro_christmas_male_2a6e0ae3:
    mike.say "Может быть, это зависит от того, насколько хорошо ты себя ведешь на нашем свидании!"

# ch/anna/date.rpy:32
translate russian anna_date_intro_christmas_male_889908e5:
    "Анна хихикает и берет меня за руку."

# ch/anna/date.rpy:33
translate russian anna_date_intro_christmas_male_fb391acf:
    anna.say "Ой, не волнуйся, я буду такой хорошей, что ты дашь мне все, что захочу!"

# ch/anna/date.rpy:37
translate russian anna_date_intro_birthday_male_14bab637:
    mike.say "С днем рождения, Аня!"

# ch/anna/date.rpy:38
translate russian anna_date_intro_birthday_male_b8014ac5:
    mike.say "И должен сказать, сегодня вечером ты выглядишь особенно соблазнительно!"

# ch/anna/date.rpy:39
translate russian anna_date_intro_birthday_male_9710cb68:
    mike.say "Ты заставляешь меня чувствовать себя так, будто я получаю подарок на день рождения."

# ch/anna/date.rpy:40
translate russian anna_date_intro_birthday_male_ee6514de:
    anna.say "Ох, [lssb_anna.hero_name()]… прекрати!"

# ch/anna/date.rpy:41
translate russian anna_date_intro_birthday_male_3a17277e:
    anna.say "Хотя нет, не прекращай!"

# ch/anna/date.rpy:42
translate russian anna_date_intro_birthday_male_69a7edaa:
    anna.say "Ты уже заставляешь меня сильно волноваться..."

# ch/anna/date.rpy:46
translate russian anna_date_intro_mc_birthday_male_f87e0608:
    anna.say "Эй, [lssb_anna.hero_name()], я здесь!"

# ch/anna/date.rpy:47
translate russian anna_date_intro_mc_birthday_male_2d53e4d5:
    anna.say "С днем рождения, мой самый лучший парень в мире!"

# ch/anna/date.rpy:48
translate russian anna_date_intro_mc_birthday_male_110bf59c:
    mike.say "Привет, Аня..."

# ch/anna/date.rpy:49
translate russian anna_date_intro_mc_birthday_male_731119a3:
    mike.say "Ты помнила о моем дне рождения?"

# ch/anna/date.rpy:50
translate russian anna_date_intro_mc_birthday_male_762cb8ce:
    mike.say "Я впечатлен!"

# ch/anna/date.rpy:51
translate russian anna_date_intro_mc_birthday_male_ddc42112:
    anna.say "Я не такая уж и рассеянная, [lssb_anna.hero_name()]!"

# ch/anna/date.rpy:52
translate russian anna_date_intro_mc_birthday_male_4fef56e2:
    anna.say "И легко помнить вещи, когда все это касается тебя!"

# ch/anna/date.rpy:56
translate russian anna_date_eat_a_burger_e3249985:
    "Как только Анна взяла свой бургер в руки, она начала есть так, будто была голодна."

# ch/anna/date.rpy:57
translate russian anna_date_eat_a_burger_4f772d1c:
    "Удивительно видеть, как ей удается широко улыбаться, забивая рот едой."

# ch/anna/date.rpy:58
translate russian anna_date_eat_a_burger_b8a780f1:
    "На самом деле, наблюдая за ней, у меня тоже начинает открываться аппетит..."

# ch/anna/date.rpy:65
translate russian anna_date_buy_drink_ca729a3f:
    anna.say "Серьезно, [lssb_anna.hero_name()]?"

# ch/anna/date.rpy:66
translate russian anna_date_buy_drink_59026949:
    anna.say "Ты забыл, что ты сделал меня беременной?!"

# ch/anna/date.rpy:67
translate russian anna_date_buy_drink_13ab9bdf:
    anna.say "Я не могу пить в таком состоянии!"

# ch/anna/date.rpy:71
translate russian anna_date_buy_drink_a3dd2864:
    "Несмотря на свою миниатюрность, в том, как Анна выпивает свой напиток, нет ничего изящного."

# ch/anna/date.rpy:72
translate russian anna_date_buy_drink_c7092dd8:
    "Иногда мне даже трудно за ней угнаться."

# ch/anna/date.rpy:73
translate russian anna_date_buy_drink_c6e08742:
    "Кажется, что стакан в ее руке пустеет с ужасающей скоростью!"

# ch/anna/date.rpy:77
translate russian anna_date_play_darts_ae6730c8:
    "Анна с радостью соглашается поиграть и быстро подбегает к дартс-стенду, крепко держа в руках свои дротики."

# ch/anna/date.rpy:78
translate russian anna_date_play_darts_9e5dbc39:
    "Она меня удивляет тем, что оказывается довольно неплохим игроком."

# ch/anna/date.rpy:79
translate russian anna_date_play_darts_e1dd6e84:
    "Мне бы повезло, если бы я смог повторить хотя бы часть тех бросков, которые она делает."

# ch/anna/date.rpy:83
translate russian anna_date_pub_play_pool_58afb392:
    "Когда я предлагаю сыграть в бильярд, Анна не отказывается."

# ch/anna/date.rpy:84
translate russian anna_date_pub_play_pool_ed3bef2e:
    "Но я вижу, что она не слишком воодушевлена."

# ch/anna/date.rpy:85
translate russian anna_date_pub_play_pool_18ab41bb:
    "Это становится понятно, когда я вижу, как ей трудно сделать хороший удар."

# ch/anna/date.rpy:86
translate russian anna_date_pub_play_pool_0dfb22d7:
    "Похоже, бильярд – это не самый подходящий вид спорта для человека невысокого роста."

# ch/anna/date.rpy:93
translate russian anna_date_buy_a_round_ca729a3f:
    anna.say "Серьезно, [lssb_anna.hero_name()]?"

# ch/anna/date.rpy:94
translate russian anna_date_buy_a_round_59026949:
    anna.say "Ты забыл, что ты сделал меня беременной?!"

# ch/anna/date.rpy:95
translate russian anna_date_buy_a_round_13ab9bdf:
    anna.say "Я не могу пить в таком состоянии!"

# ch/anna/date.rpy:99
translate russian anna_date_buy_a_round_b5ad61d0:
    "Анна радостно кивает, когда я говорю, что следующий раунд оплачиваю я."

# ch/anna/date.rpy:100
translate russian anna_date_buy_a_round_1ce005cb:
    "Она благодарит меня и говорит, что следующий раунд оплатит она сама."

# ch/anna/date.rpy:101
translate russian anna_date_buy_a_round_4f9534ea:
    "Это значит, что я на свидании с современной девушкой."

# ch/anna/date.rpy:108
translate russian anna_date_buy_a_round_fb20fd2c:
    "Я хочу угостить пивом весь паб."

# ch/anna/date.rpy:109
translate russian anna_date_buy_a_round_f9b52240:
    "Но похоже, Анна не хочет пить, поэтому я тоже воздерживаюсь."

# ch/anna/date.rpy:114
translate russian anna_dance_with_188aa763:
    "Анна, словно взволнованный щенок, выбегает на танцпол и тянет меня за собой."

# ch/anna/date.rpy:115
translate russian anna_dance_with_3e8da7f4:
    "Там она с энтузиазмом подпрыгивает под каждую песню."

# ch/anna/date.rpy:116
translate russian anna_dance_with_3cc7bbfd:
    "Я скоро выдыхаюсь, но удовольствие, которое я получаю от того, что нахожусь рядом с ней, более чем достаточно, чтобы заставить меня продолжать."

# ch/anna/date.rpy:120
translate russian anna_date_play_arcade_intro_male_7477ddf6:
    anna.say "Ох..."

# ch/anna/date.rpy:121
translate russian anna_date_play_arcade_intro_male_32aa9fa6:
    anna.say "Посмотри, сколько всего блестящего!"

# ch/anna/date.rpy:122
translate russian anna_date_play_arcade_intro_male_20e8e896:
    anna.say "И послушай, какие классные звуки!"

# ch/anna/date.rpy:123
translate russian anna_date_play_arcade_intro_male_23328e2a:
    anna.say "Это будет здорово, [lssb_anna.hero_name()]!"

# ch/anna/date.rpy:124
translate russian anna_date_play_arcade_intro_male_1d3cb747:
    "Я не могу удержаться от улыбки, глядя на энтузиазм Анны по поводу того, что ее пригласили в игровой центр."

# ch/anna/date.rpy:125
translate russian anna_date_play_arcade_intro_male_c42cb7de:
    "Если вы не знаете наверняка, что девушка – заядлый геймер, то это всегда лотерея."

# ch/anna/date.rpy:126
translate russian anna_date_play_arcade_intro_male_6465c565:
    "Пока всё идёт даже лучше, чем я мог надеяться!"

# ch/anna/date.rpy:127
translate russian anna_date_play_arcade_intro_male_8f3069df:
    mike.say "Да, Анна."

# ch/anna/date.rpy:128
translate russian anna_date_play_arcade_intro_male_88020fd8:
    mike.say "Я здесь бываю постоянно."

# ch/anna/date.rpy:129
translate russian anna_date_play_arcade_intro_male_347dc087:
    mike.say "Это помогает мне расслабиться и отдохнуть."

# ch/anna/date.rpy:130
translate russian anna_date_play_arcade_intro_male_eaf66263:
    "Даже когда я это говорю, я вижу, что с Анной происходит не то же самое."

# ch/anna/date.rpy:131
translate russian anna_date_play_arcade_intro_male_fa34cde9:
    "Вместо этого кажется, что каждое новое зрелище и звук делают ее еще более взволнованной."

# ch/anna/date.rpy:132
translate russian anna_date_play_arcade_intro_male_565f0abd:
    anna.say "О, вот эта выглядит интересно!"

# ch/anna/date.rpy:133
translate russian anna_date_play_arcade_intro_male_5fe33d3f:
    anna.say "Нет, в этой графика круче!"

# ch/anna/date.rpy:134
translate russian anna_date_play_arcade_intro_male_6e046375:
    anna.say "Постой... что это там такое?!"

# ch/anna/date.rpy:135
translate russian anna_date_play_arcade_intro_male_09d7404c:
    mike.say "Аня..."

# ch/anna/date.rpy:136
translate russian anna_date_play_arcade_intro_male_c50781ef:
    mike.say "Может быть, стоит начать с классики?"

# ch/anna/date.rpy:137
translate russian anna_date_play_arcade_intro_male_e3e92525:
    mike.say "У них тут есть отличная копия \"Snackman\"..."

# ch/anna/date.rpy:138
translate russian anna_date_play_arcade_intro_male_5370ab82:
    "Глаза Ани загораются, и она хихикает, как ребенок, получивший слишком много сладостей."

# ch/anna/date.rpy:139
translate russian anna_date_play_arcade_intro_male_587fb558:
    anna.say "Хорошо, [lssb_anna.hero_name()], это звучит здорово!"

# ch/anna/date.rpy:140
translate russian anna_date_play_arcade_intro_male_0212734c:
    anna.say "Покажи, покажи!"

# ch/anna/date.rpy:141
translate russian anna_date_play_arcade_intro_male_71b4f75e:
    "Я тороплюсь к игровому автомату и начинаю вставлять монеты."

# ch/anna/date.rpy:142
translate russian anna_date_play_arcade_intro_male_b3abbd72:
    "И все это время Аня стоит рядом со мной, почти подпрыгивая на месте!"

# ch/anna/date.rpy:146
translate russian anna_date_play_arcade_win_male_b0d97b2f:
    "Надо признать, Аня неплохо играет."

# ch/anna/date.rpy:147
translate russian anna_date_play_arcade_win_male_122ee52f:
    "Но она так взволнована, что не очень-то сосредоточена."

# ch/anna/date.rpy:148
translate russian anna_date_play_arcade_win_male_54e67dc7:
    "Поэтому ей быстро приходится проигрывать все жизни."

# ch/anna/date.rpy:149
translate russian anna_date_play_arcade_win_male_bef29737:
    anna.say "Ох..."

# ch/anna/date.rpy:150
translate russian anna_date_play_arcade_win_male_9f5096cb:
    anna.say "Это ужасно, [lssb_anna.hero_name()]!"

# ch/anna/date.rpy:151
translate russian anna_date_play_arcade_win_male_5c76d645:
    anna.say "Монстры меня достали."

# ch/anna/date.rpy:152
translate russian anna_date_play_arcade_win_male_831b4345:
    anna.say "И я только собиралась взять таблетку силы!"

# ch/anna/date.rpy:153
translate russian anna_date_play_arcade_win_male_3a6b1750:
    mike.say "Это неприятно, Аня."

# ch/anna/date.rpy:154
translate russian anna_date_play_arcade_win_male_c3604f36:
    mike.say "Давай посмотрим, смогу ли я сделать лучше..."

# ch/anna/date.rpy:155
translate russian anna_date_play_arcade_win_male_67790c22:
    "Я не хочу казаться хвастливым."

# ch/anna/date.rpy:156
translate russian anna_date_play_arcade_win_male_b63fcc6f:
    "Но вскоре мне удается набрать более высокий результат, чем у Анны."

# ch/anna/date.rpy:157
translate russian anna_date_play_arcade_win_male_14617854:
    "И она с изумлением наблюдает, как я оставляю ее далеко позади."

# ch/anna/date.rpy:158
translate russian anna_date_play_arcade_win_male_d5c86816:
    anna.say "Эй!"

# ch/anna/date.rpy:159
translate russian anna_date_play_arcade_win_male_6d3d9e1d:
    anna.say "Что происходит, [lssb_anna.hero_name()]?"

# ch/anna/date.rpy:160
translate russian anna_date_play_arcade_win_male_7677a5e2:
    anna.say "Мне кажется, эта игра тебе нравится больше, чем мне!"

# ch/anna/date.rpy:161
translate russian anna_date_play_arcade_win_male_a3f488ac:
    "Вскоре все наши монеты были потрачены."

# ch/anna/date.rpy:162
translate russian anna_date_play_arcade_win_male_e902df82:
    "И похоже, что я явный победитель."

# ch/anna/date.rpy:163
translate russian anna_date_play_arcade_win_male_b0862cf3:
    mike.say "Ну, Анна..."

# ch/anna/date.rpy:164
translate russian anna_date_play_arcade_win_male_17bd98cd:
    mike.say "Тебе понравилось?"

# ch/anna/date.rpy:165
translate russian anna_date_play_arcade_win_male_bb437871:
    anna.say "Да, наверное, [lssb_anna.hero_name()]."

# ch/anna/date.rpy:166
translate russian anna_date_play_arcade_win_male_95832297:
    anna.say "Но было бы лучше, если бы победила я!"

# ch/anna/date.rpy:170
translate russian anna_date_play_arcade_lose_male_cd1c1d8a:
    "Я ожидал, что ее неуемная энергия помешает ей."

# ch/anna/date.rpy:171
translate russian anna_date_play_arcade_lose_male_c4dac75c:
    "Что она не сможет сосредоточиться на игре."

# ch/anna/date.rpy:172
translate russian anna_date_play_arcade_lose_male_c4743f18:
    "Но, похоже, все наоборот, ведь она играет как одержимая!"

# ch/anna/date.rpy:173
translate russian anna_date_play_arcade_lose_male_77c80adb:
    anna.say "ДА!"

# ch/anna/date.rpy:174
translate russian anna_date_play_arcade_lose_male_db6d8658:
    anna.say "Получайте, мерзкие упыри!"

# ch/anna/date.rpy:175
translate russian anna_date_play_arcade_lose_male_d45c3f6c:
    anna.say "Таблетка усиления моя! Сейчас вы за всё заплатите!"

# ch/anna/date.rpy:176
translate russian anna_date_play_arcade_lose_male_3f8382ca:
    mike.say "Ого..."

# ch/anna/date.rpy:177
translate russian anna_date_play_arcade_lose_male_b4ce54f2:
    mike.say "Что с тобой случилось, Анна?"

# ch/anna/date.rpy:178
translate russian anna_date_play_arcade_lose_male_89975c06:
    mike.say "Ты неудержима!"

# ch/anna/date.rpy:179
translate russian anna_date_play_arcade_lose_male_67fda611:
    "Всё, что я могу делать, – стоять и смотреть."

# ch/anna/date.rpy:180
translate russian anna_date_play_arcade_lose_male_6a586c99:
    "Смотреть, как Анна оставляет меня позади."

# ch/anna/date.rpy:181
translate russian anna_date_play_arcade_lose_male_1cc95edc:
    "И когда настанет моя очередь, я не смогу догнать её."

# ch/anna/date.rpy:182
translate russian anna_date_play_arcade_lose_male_7fd8e3c7:
    anna.say "Ох, дорогая, [lssb_anna.hero_name()]..."

# ch/anna/date.rpy:183
translate russian anna_date_play_arcade_lose_male_b3d4739d:
    anna.say "Мне кажется, эта игра больше нравится мне, чем тебе!"

# ch/anna/date.rpy:184
translate russian anna_date_play_arcade_lose_male_a3f488ac:
    "Вскоре все наши монеты были потрачены."

# ch/anna/date.rpy:185
translate russian anna_date_play_arcade_lose_male_ab23093a:
    "И Анна – явная победительница."

# ch/anna/date.rpy:186
translate russian anna_date_play_arcade_lose_male_b0862cf3:
    mike.say "Ну что ж, Анна..."

# ch/anna/date.rpy:187
translate russian anna_date_play_arcade_lose_male_17bd98cd:
    mike.say "Тебе понравилось?"

# ch/anna/date.rpy:188
translate russian anna_date_play_arcade_lose_male_40f68741:
    anna.say "Я отлично провела время, [lssb_anna.hero_name()]."

# ch/anna/date.rpy:189
translate russian anna_date_play_arcade_lose_male_1a6be2b0:
    anna.say "И не расстраивайся."

# ch/anna/date.rpy:190
translate russian anna_date_play_arcade_lose_male_ab35d109:
    anna.say "В следующий раз я, возможно, позволю тебе победить!"

# ch/anna/date.rpy:198
translate russian anna_dick_reactions_b61c15da:
    anna.say "Вау!"

# ch/anna/date.rpy:199
translate russian anna_dick_reactions_eb119f24:
    anna.say "Это... это ОЧЕНЬ большое!"

# ch/anna/date.rpy:200
translate russian anna_dick_reactions_efa607fa:
    mike.say "Это... это проблема?"

# ch/anna/date.rpy:202
translate russian anna_dick_reactions_4acf188d:
    anna.say "О нет, не переживай."

# ch/anna/date.rpy:204
translate russian anna_dick_reactions_1b1bffbe:
    anna.say "Я как-нибудь найду для этого место!"

# ch/anna/date.rpy:208
translate russian anna_dick_reactions_623345e1:
    anna.say "Ооох!"

# ch/anna/date.rpy:209
translate russian anna_dick_reactions_1b2702d1:
    mike.say "Это... у тебя что-то случилось, Анна?"

# ch/anna/date.rpy:211
translate russian anna_dick_reactions_6cba7e62:
    anna.say "Нет-нет, всё хорошо."

# ch/anna/date.rpy:212
translate russian anna_dick_reactions_05489df9:
    anna.say "Важно не то, что это такое, а как ты это используешь!"

# ch/anna/date.rpy:219
translate russian anna_halloween_invitation_71e4bdf6:
    "Конечно, я хочу пригласить Анну на хэллоуинскую вечеринку."

# ch/anna/date.rpy:220
translate russian anna_halloween_invitation_974ddfbc:
    "Кто еще мне нужен в качестве моей спутницы?"

# ch/anna/date.rpy:221
translate russian anna_halloween_invitation_c3d7e8bb:
    "И вот я решаю воспользоваться первой же возможностью, чтобы спросить."

# ch/anna/date.rpy:222
translate russian anna_halloween_invitation_476e22ff:
    "На самом деле, я так хочу спросить, что просто не могу молчать."

# ch/anna/date.rpy:223
translate russian anna_halloween_invitation_443eca5d:
    "Что, кажется, совершенно застало Анну врасплох."

# ch/anna/date.rpy:224
translate russian anna_halloween_invitation_110bf59c:
    mike.say "Эй, Анна..."

# ch/anna/date.rpy:225
translate russian anna_halloween_invitation_96ef464e:
    mike.say "В этом году у меня дома будет вечеринка на Хэллоуин."

# ch/anna/date.rpy:226
translate russian anna_halloween_invitation_1e3e77cf:
    mike.say "И тебе обязательно нужно прийти, хорошо?"

# ch/anna/date.rpy:228
translate russian anna_halloween_invitation_4f76d830:
    "Глаза Анны расширяются от упоминания о вечеринке."

# ch/anna/date.rpy:229
translate russian anna_halloween_invitation_0c1f153d:
    "И она выглядит совершенно не готовой к этому приглашению."

# ch/anna/date.rpy:230
translate russian anna_halloween_invitation_f63df1c8:
    anna.say "Э... вечеринка на Хэллоуин?"

# ch/anna/date.rpy:231
translate russian anna_halloween_invitation_a7625224:
    anna.say "У тебя дома?"

# ch/anna/date.rpy:232
translate russian anna_halloween_invitation_b9704545:
    mike.say "Да, Анна, я это и сказал!"

# ch/anna/date.rpy:233
translate russian anna_halloween_invitation_df1aabd0:
    mike.say "Ты придешь, верно?"

# ch/anna/date.rpy:234
translate russian anna_halloween_invitation_3e2bdcd8:
    "Анна моргает, вместо того чтобы дать мне ответ."

# ch/anna/date.rpy:235
translate russian anna_halloween_invitation_f545674d:
    "И я начинаю гадать, каким будет этот ответ."

# ch/anna/date.rpy:236
translate russian anna_halloween_invitation_36f8399e:
    "Неужели она действительно не хочет идти на вечеринку?"

# ch/anna/date.rpy:237
translate russian anna_halloween_invitation_d17ed7a7:
    "Я даже не думал о том, что буду делать, если она откажется."

# ch/anna/date.rpy:241
translate russian anna_halloween_invitation_7477ddf6:
    anna.say "Ох..."

# ch/anna/date.rpy:242
translate russian anna_halloween_invitation_20a94b3b:
    anna.say "Звучит здорово, [lssb_anna.hero_name()]."

# ch/anna/date.rpy:244
translate russian anna_halloween_invitation_ea444860:
    anna.say "И у меня уже есть идея для костюма!"

# ch/anna/date.rpy:245
translate russian anna_halloween_invitation_bfbb71ae:
    "Нужно некоторое время, чтобы осознать, что Аня действительно согласилась."

# ch/anna/date.rpy:246
translate russian anna_halloween_invitation_b5d95ecc:
    "Но потом я начинаю энергично кивать головой."

# ch/anna/date.rpy:247
translate russian anna_halloween_invitation_fe539097:
    mike.say "Это здорово, Анна!"

# ch/anna/date.rpy:248
translate russian anna_halloween_invitation_2b5e52a5:
    mike.say "Я сообщу тебе время, как только смогу."

# ch/anna/date.rpy:249
translate russian anna_halloween_invitation_7918f2f0:
    mike.say "И я очень хочу увидеть, какой костюм ты придумаешь!"

# ch/anna/date.rpy:251
translate russian anna_halloween_invitation_4eaad51b:
    "Анна поднимает руку, чтобы привлечь мое внимание."

# ch/anna/date.rpy:252
translate russian anna_halloween_invitation_fc730169:
    "И мне приходится заставлять себя перестать говорить."

# ch/anna/date.rpy:253
translate russian anna_halloween_invitation_94bc31a7:
    "Что требует немалых усилий."

# ch/anna/date.rpy:254
translate russian anna_halloween_invitation_f2cbaf14:
    "Потому что я тараторил от волнения."

# ch/anna/date.rpy:255
translate russian anna_halloween_invitation_32638104:
    anna.say "Но ты должна пообещать мне одну вещь, хорошо?"

# ch/anna/date.rpy:256
translate russian anna_halloween_invitation_018c0876:
    mike.say "Что угодно, Анна."

# ch/anna/date.rpy:257
translate russian anna_halloween_invitation_96449330:
    anna.say "Ты не можешь забыть обо мне на вечеринке."

# ch/anna/date.rpy:258
translate russian anna_halloween_invitation_746211b7:
    mike.say "Анна, я никогда бы..."

# ch/anna/date.rpy:260
translate russian anna_halloween_invitation_95a41f45:
    anna.say "О, ещё как смог бы, [lssb_anna.hero_name()]!"

# ch/anna/date.rpy:261
translate russian anna_halloween_invitation_3f3c6bce:
    anna.say "Ты не представляешь, что значит быть маленькой."

# ch/anna/date.rpy:262
translate russian anna_halloween_invitation_dbd706b1:
    anna.say "Люди просто забывают, что ты там есть!"

# ch/anna/date.rpy:264
translate russian anna_halloween_invitation_a5e4217f:
    anna.say "И ты с Сашей будете так заняты подготовкой к вечеринке!"

# ch/anna/date.rpy:265
translate russian anna_halloween_invitation_5e758585:
    "Теперь моя очередь поднять руку."

# ch/anna/date.rpy:267
translate russian anna_halloween_invitation_80fcc1ee:
    "И это заставляет Анну замолчать."

# ch/anna/date.rpy:268
translate russian anna_halloween_invitation_05d70887:
    mike.say "Я обещаю, этого не произойдет, Анна."

# ch/anna/date.rpy:269
translate russian anna_halloween_invitation_cccdf0b7:
    mike.say "Ты будешь в центре моего внимания всю ночь."

# ch/anna/date.rpy:271
translate russian anna_halloween_invitation_59d36457:
    "Анна улыбается."

# ch/anna/date.rpy:272
translate russian anna_halloween_invitation_662de2b1:
    anna.say "Я соглашусь, когда увидишь мой костюм!"

# ch/anna/date.rpy:276
translate russian anna_halloween_invitation_f90058d7:
    anna.say "Ммм..."

# ch/anna/date.rpy:277
translate russian anna_halloween_invitation_7ebd9f54:
    anna.say "Не знаю, хочу ли я этого, [lssb_anna.hero_name()]!"

# ch/anna/date.rpy:278
translate russian anna_halloween_invitation_eb053e59:
    "Мне требуется некоторое время, чтобы осознать, что Анна на самом деле сказала \"нет\"."

# ch/anna/date.rpy:279
translate russian anna_halloween_invitation_6695ba71:
    "Но потом я качаю головой в недоумении."

# ch/anna/date.rpy:280
translate russian anna_halloween_invitation_cbdf61ff:
    mike.say "Ты... ты не хочешь?"

# ch/anna/date.rpy:281
translate russian anna_halloween_invitation_e1d0dfaa:
    mike.say "Но почему, Анна?"

# ch/anna/date.rpy:282
translate russian anna_halloween_invitation_2dcc1d8e:
    mike.say "Это же тоже костюмированная вечеринка."

# ch/anna/date.rpy:283
translate russian anna_halloween_invitation_9b241e43:
    mike.say "Я думал, мы сможем хорошо повеселиться вместе!"

# ch/anna/date.rpy:284
translate russian anna_halloween_invitation_f375fe5e:
    "Анна выглядит неловко, пытаясь объяснить себя."

# ch/anna/date.rpy:285
translate russian anna_halloween_invitation_07de6613:
    "И она едва может смотреть мне в глаза больше секунды за раз."

# ch/anna/date.rpy:286
translate russian anna_halloween_invitation_27fd2609:
    anna.say "Это звучит весело, [lssb_anna.hero_name()]."

# ch/anna/date.rpy:287
translate russian anna_halloween_invitation_1e0107b0:
    anna.say "Но я там никого не знаю!"

# ch/anna/date.rpy:288
translate russian anna_halloween_invitation_940e9859:
    anna.say "Ты и Саша будете заняты всю ночь."

# ch/anna/date.rpy:289
translate russian anna_halloween_invitation_cd0f4417:
    anna.say "А я просто окажусь одна в углу!"

# ch/anna/date.rpy:290
translate russian anna_halloween_invitation_ab3b8734:
    "Я качаю головой, пытаясь переубедить Анну."

# ch/anna/date.rpy:291
translate russian anna_halloween_invitation_7dcbf754:
    mike.say "Не говори глупостей, Анна!"

# ch/anna/date.rpy:292
translate russian anna_halloween_invitation_53f9c7a3:
    mike.say "Так не случится."

# ch/anna/date.rpy:293
translate russian anna_halloween_invitation_eaa1abd4:
    anna.say "Все так говорят, [lssb_anna.hero_name()]."

# ch/anna/date.rpy:294
translate russian anna_halloween_invitation_8805f035:
    anna.say "Но это другое дело, когда ты маленького роста."

# ch/anna/date.rpy:295
translate russian anna_halloween_invitation_d185355c:
    anna.say "Ты теряешься в толпе."

# ch/anna/date.rpy:296
translate russian anna_halloween_invitation_dbd706b1_1:
    anna.say "Люди просто забывают, что ты там есть!"

# ch/anna/date.rpy:298
translate russian anna_halloween_invitation_9f91daa2:
    anna.say "Может, займёмся чем-нибудь другим, только ты и я?"

# ch/anna/date.rpy:299
translate russian anna_halloween_invitation_3784f795:
    mike.say "Пожалуй, Анна."

# ch/anna/date.rpy:300
translate russian anna_halloween_invitation_edb9dfc9:
    mike.say "Может быть, в следующую ночь после вечеринки..."

# ch/anna/date.rpy:301
translate russian anna_halloween_invitation_d938e9c2:
    "Я пытаюсь сменить тему, наконец смирившись с тем, что это невозможно."

# ch/anna/date.rpy:306
translate russian anna_halloween_arrival_92115052:
    "Я открываю дверь, все еще немного отвлеченный."

# ch/anna/date.rpy:307
translate russian anna_halloween_arrival_e177398d:
    "Что означает, что через секунду я чуть не получаю сапогом по лицу."

# ch/anna/date.rpy:308
translate russian anna_halloween_arrival_bae4503b:
    "Подпрыгнув назад, я едва избежал падения на ягодицы."

# ch/anna/date.rpy:309
translate russian anna_halloween_arrival_a7cefa8d:
    anna.say "Привет!"

# ch/anna/date.rpy:311
translate russian anna_halloween_arrival_27988aae:
    anna.say "Ого, какая реакция, [lssb_anna.hero_name()]!"

# ch/anna/date.rpy:312
translate russian anna_halloween_arrival_dea8dd33:
    "Приходя в себя, я вижу Анну, стоящую на пороге."

# ch/anna/date.rpy:313
translate russian anna_halloween_arrival_228ea5cd:
    "Она позирует так, словно это кадр из фильма о кунг-фу."

# ch/anna/date.rpy:314
translate russian anna_halloween_arrival_e8d1ad76:
    "На ней костюм, сделанный в основном из черного спандекса."

# ch/anna/date.rpy:315
translate russian anna_halloween_arrival_0da184b9:
    "Кроме рук, которые должны выглядеть как металл."

# ch/anna/date.rpy:316
translate russian anna_halloween_arrival_6ea3e2a0:
    "Она с нетерпением улыбается мне, пока я пытаюсь все понять."

# ch/anna/date.rpy:317
translate russian anna_halloween_arrival_c8adf19e:
    mike.say "И... И. И. Лита..."

# ch/anna/date.rpy:318
translate russian anna_halloween_arrival_bccc2aa3:
    mike.say "«Боевой ангел И. И. Лита»?"

# ch/anna/date.rpy:320
translate russian anna_halloween_arrival_e4e9c51f:
    "Улыбка Анны становится еще шире."

# ch/anna/date.rpy:321
translate russian anna_halloween_arrival_b21ca740:
    "Она хлопает в ладоши от явного восторга."

# ch/anna/date.rpy:322
translate russian anna_halloween_arrival_3a4f6c78:
    anna.say "Именно, [lssb_anna.hero_name()]!"

# ch/anna/date.rpy:323
translate russian anna_halloween_arrival_8fcab39d:
    anna.say "Это один из моих любимых аниме."

# ch/anna/date.rpy:325
translate russian anna_halloween_arrival_655e50b0:
    anna.say "Ты помнишь?"

# ch/anna/date.rpy:326
translate russian anna_halloween_arrival_756945c3:
    "Анна сияет, глядя на меня, ожидая ответа."

# ch/anna/date.rpy:327
translate russian anna_halloween_arrival_e66f9ee1:
    "Признаю, из неё получился очень горячий киборг!"

# ch/anna/date.rpy:330
translate russian anna_halloween_arrival_fd5a1b7c:
    "Любая мысль о том, что она чуть не ударила меня в лицо, мгновенно исчезает."

# ch/anna/date.rpy:331
translate russian anna_halloween_arrival_bd1200a6:
    "Вместо этого я могу только стоять и смотреть на Анну, которая стоит здесь в своем костюме."

# ch/anna/date.rpy:332
translate russian anna_halloween_arrival_a3cf3039:
    "Мой разум полон интригующих возможностей, поэтому я не могу думать ни о чем другом."

# ch/anna/date.rpy:333
translate russian anna_halloween_arrival_e1088e12:
    mike.say "Вау, Анна... просто вау!"

# ch/anna/date.rpy:334
translate russian anna_halloween_arrival_0ea08286:
    mike.say "С этой минуты это и моё любимое аниме!"

# ch/anna/date.rpy:337
translate russian anna_halloween_arrival_7074c4f0:
    "Анна краснеет и прикусывает губы от комплимента."

# ch/anna/date.rpy:338
translate russian anna_halloween_arrival_eab26450:
    "Она наклоняет голову набок, робко глядя на меня."

# ch/anna/date.rpy:339
translate russian anna_halloween_arrival_e2aca1e4:
    anna.say "Ты... ты действительно так думаешь?"

# ch/anna/date.rpy:340
translate russian anna_halloween_arrival_d182e438:
    anna.say "Я переживала, что моя грудь будет слишком большой!"

# ch/anna/date.rpy:341
translate russian anna_halloween_arrival_2773fac0:
    "Я качаю головой, отмахиваясь от ее беспокойств."

# ch/anna/date.rpy:342
translate russian anna_halloween_arrival_898a7b11:
    mike.say "Они идеальны, Анна."

# ch/anna/date.rpy:343
translate russian anna_halloween_arrival_631a6d75:
    mike.say "Я бы ни в чем не изменил."

# ch/anna/date.rpy:344
translate russian anna_halloween_arrival_c5beb209:
    mike.say "Ты... ты запрограммирована на...?"

# ch/anna/date.rpy:345
translate russian anna_halloween_arrival_b87c57ef:
    mike.say "Ну, ты понимаешь..."

# ch/anna/date.rpy:347
translate russian anna_halloween_arrival_ff682a4c:
    "Робкий вид Анны исчезает мгновенно."

# ch/anna/date.rpy:348
translate russian anna_halloween_arrival_98b99806:
    "Теперь она выглядит так, будто оценивает меня!"

# ch/anna/date.rpy:349
translate russian anna_halloween_arrival_434ab129:
    anna.say "Ой, не переживай из-за этого, [lssb_anna.hero_name()]."

# ch/anna/date.rpy:350
translate russian anna_halloween_arrival_aa3961b2:
    anna.say "Я запрограммирована на использование множества техник."

# ch/anna/date.rpy:352
translate russian anna_halloween_arrival_fc7f0d42:
    anna.say "И мои кибернетические имплантаты тоже самые современные!"

# ch/anna/date.rpy:354
translate russian anna_halloween_arrival_73d69005:
    "Но моя гордость сейчас сильно задета."

# ch/anna/date.rpy:355
translate russian anna_halloween_arrival_32f0d6c5:
    "Я имею в виду, она чуть не ударила меня ногой по лицу!"

# ch/anna/date.rpy:356
translate russian anna_halloween_arrival_31886028:
    mike.say "Костюм отличный, Анна."

# ch/anna/date.rpy:357
translate russian anna_halloween_arrival_81258eb0:
    mike.say "Но я не оценил этот высокий удар ногой."

# ch/anna/date.rpy:358
translate russian anna_halloween_arrival_039fa8c1:
    mike.say "Ты могла сломать мой чертов нос!"

# ch/anna/date.rpy:361
translate russian anna_halloween_arrival_b279b36a:
    "Анна мгновенно выглядит расстроенной из-за моих слов."

# ch/anna/date.rpy:362
translate russian anna_halloween_arrival_405ba4dd:
    "Она смотрит вниз на свои ноги, сжимая руки вместе."

# ch/anna/date.rpy:363
translate russian anna_halloween_arrival_a773c6e3:
    anna.say "Я... я сожалею, [lssb_anna.hero_name()]."

# ch/anna/date.rpy:364
translate russian anna_halloween_arrival_8f68577d:
    anna.say "Наверное, я не подумала."

# ch/anna/date.rpy:365
translate russian anna_halloween_arrival_427f111c:
    anna.say "Мне удивительно, что я смогла так высоко ударить!"

# ch/anna/date.rpy:366
translate russian anna_halloween_arrival_3caf362f:
    "Трудно оставаться злым на Анну."

# ch/anna/date.rpy:367
translate russian anna_halloween_arrival_5150a855:
    "Особенно когда она выглядит такой виноватой."

# ch/anna/date.rpy:368
translate russian anna_halloween_arrival_37ae546e:
    mike.say "Я принимаю твои извинения, Анна."

# ch/anna/date.rpy:369
translate russian anna_halloween_arrival_0ce162b9:
    mike.say "Что ты скажешь, если мы попробуем забыть об этом?"

# ch/anna/date.rpy:370
translate russian anna_halloween_arrival_d6af198f:
    mike.say "Заходи, и будем веселиться."

# ch/anna/date.rpy:372
translate russian anna_halloween_arrival_b7e5782e:
    "Настроение Анны мгновенно улучшается."

# ch/anna/date.rpy:373
translate russian anna_halloween_arrival_cef3ff90:
    "Она кивает и входит в дверь."

# ch/anna/date.rpy:374
translate russian anna_halloween_arrival_e8b3099f:
    anna.say "Конечно, [lssb_anna.hero_name()]."

# ch/anna/date.rpy:375
translate russian anna_halloween_arrival_59f246d7:
    anna.say "Потанцуем!"

# ch/anna/date.rpy:384
translate russian anna_halloween_party_b0978667:
    jack.say "Ох..."

# ch/anna/date.rpy:385
translate russian anna_halloween_party_419e4933:
    jack.say "Как серьезный отаку, мне это видеть больно!"

# ch/anna/date.rpy:386
translate russian anna_halloween_party_ee933dad:
    "Я слышу голос Джека и упоминание терминов из аниме."

# ch/anna/date.rpy:387
translate russian anna_halloween_party_2ec5c629:
    "И мне требуется всего секунда, чтобы понять, с кем он разговаривает."

# ch/anna/date.rpy:391
translate russian anna_halloween_party_3fce5a03:
    "Поэтому меня ничего не удивляет, когда я оборачиваюсь и вижу, как он нависает над Анной."

# ch/anna/date.rpy:392
translate russian anna_halloween_party_7afdc37a:
    anna.say "Эм..."

# ch/anna/date.rpy:393
translate russian anna_halloween_party_414006f7:
    anna.say "О чем ты говоришь?"

# ch/anna/date.rpy:394
translate russian anna_halloween_party_4ecc4132:
    anna.say "Тебе не нравится мой костюм?"

# ch/anna/date.rpy:395
translate russian anna_halloween_party_939ecb98:
    "Джек фыркает и качает головой."

# ch/anna/date.rpy:396
translate russian anna_halloween_party_3fa41ba6:
    "И я знаю, что у Анны запланирована лекция."

# ch/anna/date.rpy:397
translate russian anna_halloween_party_fb250a4d:
    jack.say "Не пойми меня неправильно."

# ch/anna/date.rpy:398
translate russian anna_halloween_party_801b9c78:
    jack.say "Мне нравится САМА идея этого."

# ch/anna/date.rpy:400
translate russian anna_halloween_party_31f5f875:
    jack.say "Но я вижу столько мест, где ты все испортила!"

# ch/anna/date.rpy:401
translate russian anna_halloween_party_4036c831:
    "Анна оглядывается по сторонам, пока Джек готовится к своей лекции."

# ch/anna/date.rpy:402
translate russian anna_halloween_party_012eba0e:
    "Кто-то должен вмешаться здесь."

# ch/anna/date.rpy:403
translate russian anna_halloween_party_e7027c84:
    "И этим \"кем-то\" должен быть я!"

# ch/anna/date.rpy:406
translate russian anna_halloween_party_2c42defe:
    mike.say "Что случилось, Джек?"

# ch/anna/date.rpy:407
translate russian anna_halloween_party_d9bf1344:
    mike.say "Я не вижу ничего плохого в костюме Анны."

# ch/anna/date.rpy:409
translate russian anna_halloween_party_623e6ede:
    "Джек отступает на шаг назад, и на его лице читается изумление."

# ch/anna/date.rpy:410
translate russian anna_halloween_party_6e8a8632:
    "Кажется, он просто не может понять слова, которые я говорю."

# ch/anna/date.rpy:411
translate russian anna_halloween_party_07711028:
    jack.say "Но... но... но..."

# ch/anna/date.rpy:412
translate russian anna_halloween_party_6b1a6cf1:
    jack.say "Это не соответствует оригиналу аниме!"

# ch/anna/date.rpy:413
translate russian anna_halloween_party_f58fe639:
    jack.say "Это больше похоже на..."

# ch/anna/date.rpy:414
translate russian anna_halloween_party_5b6520fa:
    mike.say "Как в фильме?"

# ch/anna/date.rpy:415
translate russian anna_halloween_party_627ce0a9:
    mike.say "Да, потому что именно так это и должно быть, балбес!"

# ch/anna/date.rpy:417
translate russian anna_halloween_party_856fba5c:
    "Рот Джека шевелится, но ни слова не вырывается."

# ch/anna/date.rpy:418
translate russian anna_halloween_party_0973ab55:
    mike.say "Анна и я смотрели этот фильм вместе."

# ch/anna/date.rpy:419
translate russian anna_halloween_party_bc3f3d4c:
    mike.say "Не так ли, Анна?"

# ch/anna/date.rpy:421
translate russian anna_halloween_party_67d2f6c0:
    anna.say "Да, это правда!"

# ch/anna/date.rpy:422
translate russian anna_halloween_party_236ffeae:
    mike.say "И я помню, как мне он понравился."

# ch/anna/date.rpy:424
translate russian anna_halloween_party_a688c002:
    mike.say "Так что я тоже люблю костюм Анны!"

# ch/anna/date.rpy:425
translate russian anna_halloween_party_c066def4:
    jack.say "Аррргх!"

# ch/anna/date.rpy:426
translate russian anna_halloween_party_9972a293:
    jack.say "Ты изменился, приятель!"

# ch/anna/date.rpy:427
translate russian anna_halloween_party_a56f893c:
    jack.say "Но ты не заразишь меня своей болезнью!"

# ch/anna/date.rpy:430
translate russian anna_halloween_party_989982f0:
    "С этими словами Джек торопливо уходит."

# ch/anna/date.rpy:431
translate russian anna_halloween_party_37c985e7:
    "И вот я остаюсь с Анной наедине."

# ch/anna/date.rpy:432
translate russian anna_halloween_party_e77edb1a:
    "Она крепко обнимает меня, показывая, что я поступил правильно."

# ch/anna/date.rpy:434
translate russian anna_halloween_party_5083e510:
    mike.say "Я не хотел этого говорить, Анна."

# ch/anna/date.rpy:435
translate russian anna_halloween_party_6e85bcf7:
    mike.say "Но я точно знаю, что Джек имеет в виду."

# ch/anna/date.rpy:437
translate russian anna_halloween_party_13acf5cd:
    "Выражение лица Анны меняется от надежды на замешательство."

# ch/anna/date.rpy:438
translate russian anna_halloween_party_bbce9d7e:
    "Очевидно, она думала, что я вмешаюсь, чтобы спасти ее."

# ch/anna/date.rpy:439
translate russian anna_halloween_party_7626bc6c:
    "Но когда дело касается аниме, самое главное – быть правым!"

# ch/anna/date.rpy:440
translate russian anna_halloween_party_ad4abb06:
    anna.say "Что ты имеешь в виду?"

# ch/anna/date.rpy:441
translate russian anna_halloween_party_dffbb519:
    mike.say "Твой костюм, Анна."

# ch/anna/date.rpy:442
translate russian anna_halloween_party_f4713a5e:
    mike.say "Он больше основан на фильме, чем на аниме."

# ch/anna/date.rpy:443
translate russian anna_halloween_party_fef4d140:
    anna.say "Это...?"

# ch/anna/date.rpy:444
translate russian anna_halloween_party_80bab5a3:
    anna.say "Это важно?"

# ch/anna/date.rpy:446
translate russian anna_halloween_party_180e237d:
    "Джек заливается смехом и качает головой."

# ch/anna/date.rpy:447
translate russian anna_halloween_party_1b4c3127:
    "Я могу только закатить глаза от удивления."

# ch/anna/date.rpy:448
translate russian anna_halloween_party_6cd80968:
    jack.say "Конечно, это важно!"

# ch/anna/date.rpy:449
translate russian anna_halloween_party_ae46aa68:
    jack.say "Все знают, что фильм – отстой!"

# ch/anna/date.rpy:452
translate russian anna_halloween_party_da6f44f5:
    anna.say "О... я понимаю..."

# ch/anna/date.rpy:453
translate russian anna_halloween_party_e7a3c42a:
    anna.say "Прости, [lssb_anna.hero_name()]."

# ch/anna/date.rpy:454
translate russian anna_halloween_party_e569f1c5:
    anna.say "Я не знала..."

# ch/anna/date.rpy:455
translate russian anna_halloween_party_49084b78:
    "Да, сейчас Анна выглядит немного расстроенной."

# ch/anna/date.rpy:456
translate russian anna_halloween_party_d28df25e:
    "Но она уже успокоилась."

# ch/anna/date.rpy:457
translate russian anna_halloween_party_4a1c4d53:
    "И это действительно важно."

# ch/anna/date.rpy:467
translate russian anna_halloween_dance_1915a66c:
    anna.say "Давай же, [lssb_anna.hero_name()]..."

# ch/anna/date.rpy:468
translate russian anna_halloween_dance_cb0689a7:
    anna.say "Потанцуем!"

# ch/anna/date.rpy:469
translate russian anna_halloween_dance_3f66b23b:
    "Ещё не успеваю понять, что происходит, как Анна хватает меня за руку."

# ch/anna/date.rpy:470
translate russian anna_halloween_dance_0f99fd7a:
    "И она тянет меня на импровизированную танцплощадку."

# ch/anna/date.rpy:471
translate russian anna_halloween_dance_599d2c4a:
    "Я сопротивляюсь, скорее от удивления, чем из-за нежелания."

# ch/anna/date.rpy:472
translate russian anna_halloween_dance_c63ad230:
    mike.say "Эй, Анна!"

# ch/anna/date.rpy:473
translate russian anna_halloween_dance_fa6f138d:
    mike.say "Что за спешка?"

# ch/anna/date.rpy:474
translate russian anna_halloween_dance_77908047:
    mike.say "Тебе же эта песня не нравится!"

# ch/anna/date.rpy:476
translate russian anna_halloween_dance_ef505a01:
    "Щёки Анны краснеют."

# ch/anna/date.rpy:477
translate russian anna_halloween_dance_593e15da:
    "И на мгновение она избегает моего взгляда."

# ch/anna/date.rpy:478
translate russian anna_halloween_dance_5d774c1c:
    anna.say "Хорошо, я сейчас тебе объясню."

# ch/anna/date.rpy:479
translate russian anna_halloween_dance_abbfbf3f:
    anna.say "Но ты не смейся надо мной, ладно?"

# ch/anna/date.rpy:480
translate russian anna_halloween_dance_de6fbec1:
    mike.say "Обещаю, что не буду смеяться, Анна."

# ch/anna/date.rpy:481
translate russian anna_halloween_dance_f7ad4817:
    "Анна вздыхает."

# ch/anna/date.rpy:482
translate russian anna_halloween_dance_068bd331:
    anna.say "Я... я хочу танцевать сейчас, чтобы Саша нас увидела."

# ch/anna/date.rpy:483
translate russian anna_halloween_dance_16943fe5:
    anna.say "Потому что я хочу, чтобы она видела, как я танцую с симпатичным парнем!"

# ch/anna/date.rpy:486
translate russian anna_halloween_dance_c73dbf30:
    mike.say "Хорошо, Анна."

# ch/anna/date.rpy:488
translate russian anna_halloween_dance_252732b8:
    mike.say "Но я делаю это только чтобы Саша увидела меня с привлекательной девушкой."

# ch/anna/date.rpy:489
translate russian anna_halloween_dance_fb7ab6e7:
    "Анна на мгновение выглядит растерянной."

# ch/anna/date.rpy:492
translate russian anna_halloween_dance_dfaf99d1:
    "Но затем ее озаряет осознание."

# ch/anna/date.rpy:493
translate russian anna_halloween_dance_3b86b192:
    "И она краснеет еще сильнее."

# ch/anna/date.rpy:494
translate russian anna_halloween_dance_bef29737:
    anna.say "Ой..."

# ch/anna/date.rpy:495
translate russian anna_halloween_dance_2c95546f:
    anna.say "Ты имеешь в виду меня!"

# ch/anna/date.rpy:497
translate russian anna_halloween_dance_a5f18642:
    anna.say "Постой... ты действительно имеешь в виду меня, да?!"

# ch/anna/date.rpy:498
translate russian anna_halloween_dance_ae809dc3:
    mike.say "Да, Анна, конечно, я про тебя!"

# ch/anna/date.rpy:500
translate russian anna_halloween_dance_e7098013:
    "Анна радостно хихикает и прижимается к моей руке."

# ch/anna/date.rpy:503
translate russian anna_halloween_dance_da754461:
    "И вот мы вместе оказываемся на танцполе."

# ch/anna/date.rpy:504
translate russian anna_halloween_dance_827ad678:
    "Но если Саша увидит хотя бы одну из нас, я не знаю, как это произойдет."

# ch/anna/date.rpy:505
translate russian anna_halloween_dance_9a263f7a:
    "Потому что все время, пока мы танцуем, я просто смотрю на Анну."

# ch/anna/date.rpy:507
translate russian anna_halloween_dance_919b3fb8:
    "Я понимаю, что только что дал обещание."

# ch/anna/date.rpy:508
translate russian anna_halloween_dance_560d3083:
    "Но я не могу удержаться от громкого смеха."

# ch/anna/date.rpy:509
translate russian anna_halloween_dance_10ef609f:
    mike.say "Ох, Анна..."

# ch/anna/date.rpy:510
translate russian anna_halloween_dance_cd930ef4:
    mike.say "Это так смешно!"

# ch/anna/date.rpy:512
translate russian anna_halloween_dance_d5c86816:
    anna.say "Эй!"

# ch/anna/date.rpy:513
translate russian anna_halloween_dance_b30cc121:
    anna.say "Нечестно, [lssb_anna.hero_name()]!"

# ch/anna/date.rpy:514
translate russian anna_halloween_dance_ea8798ee:
    anna.say "Ты же обещал, что не будешь надо мной смеяться!"

# ch/anna/date.rpy:515
translate russian anna_halloween_dance_86d5bbee:
    "Я качаю головой, пытаясь извиниться."

# ch/anna/date.rpy:516
translate russian anna_halloween_dance_4d164fdf:
    "Но я все равно не могу перестать смеяться."

# ch/anna/date.rpy:517
translate russian anna_halloween_dance_d3d73fd7:
    mike.say "Господи, Анна, тебе что, двенадцать лет?!"

# ch/anna/date.rpy:520
translate russian anna_halloween_dance_2970fc43:
    "Анна уходит, забыв обо всем, включая наши танцы."

# ch/anna/date.rpy:521
translate russian anna_halloween_dance_abcb1472:
    "И я иду за ней, пытаясь придумать, как исправить ситуацию."

# ch/anna/date.rpy:531
translate russian anna_halloween_sex_24c46e69:
    "Весь вечер не могу оторвать глаз от Анны. Мне всегда нравилась И. И. Лита в оригинальном аниме, а видеть Анну в её костюме — уже почти невыносимо."

# ch/anna/date.rpy:532
translate russian anna_halloween_sex_bbd9eeec:
    "Костюм облегает её тело, и она отлично знает, как на меня действует. Лукавые улыбки, воздушные поцелуи, оброненные вещи, за которыми можно нагнуться."

# ch/anna/date.rpy:534
translate russian anna_halloween_sex_5779ae7a:
    "Квартира украшена к Хэллоуину: паутина, миска очищенных виноградин-глаз и фильм ужасов по кругу, который смотрит только она."

# ch/anna/date.rpy:536
translate russian anna_halloween_sex_2ce5ae7b:
    anna.say "Боже, [lssb_anna.hero_name()], лучший вечер! Ужастики, конфеты, милый парень весь вечер пялится на мою попку... Можно умереть от счастья. В хорошем смысле, не чтобы стать привидением!"

# ch/anna/date.rpy:538
translate russian anna_halloween_sex_5d61bb72:
    anna.say "Продолжай подкрадываться и пугать меня, [lssb_anna.hero_name()], и я, клянусь, буду преследовать тебя вечно."

# ch/anna/date.rpy:542
translate russian anna_halloween_sex_5ebf4e78:
    "Когда мы наконец добираемся до спальни, я уже совсем не владею собой."

# ch/anna/date.rpy:544
translate russian anna_halloween_sex_d9546933:
    anna.say "О-о... Я весь вечер этого ждала."

# ch/anna/date.rpy:546
translate russian anna_halloween_sex_ac083c19:
    anna.say "Давай же, поймай меня, [lssb_anna.hero_name()]!"

# ch/anna/date.rpy:548
translate russian anna_halloween_sex_05fd4cbd:
    "Она вприпрыжку бежит к кровати, всё ещё хихикая, забирается на матрас и отползает на попе назад, пока не упирается спиной в стену."

# ch/anna/date.rpy:550
translate russian anna_halloween_sex_6ccef89a:
    anna.say "О нет! Кажется, мне не сбежать! Что же делать бедной беззащитной девочке-волшебнице?"

# ch/anna/date.rpy:552
translate russian anna_halloween_sex_dd9869fc:
    "По пути через комнату я успел раздеться и теперь лежу на кровати голый. Анна смотрит на мой член и взвизгивает."

# ch/anna/date.rpy:553
translate russian anna_halloween_sex_5bb1a10b:
    anna.say "Ох, [lssb_anna.hero_name()]! Даже И. И. Лита не справится с таким мощным оружием!"

# ch/anna/date.rpy:555
translate russian anna_halloween_sex_f624c60c:
    "Я набрасываюсь на неё, и она позволяет себя поймать, извиваясь и прижимаясь ко мне. Целую её шею — она тает, запрокидывая голову, чтобы мне было удобнее."

# ch/anna/date.rpy:557
translate russian anna_halloween_sex_96c0c6c6:
    "Мои руки понемногу стягивают костюм с её плеч."

# ch/anna/date.rpy:558
translate russian anna_halloween_sex_5af8f6ea:
    anna.say "Вот и она. Наконец на свободе. Боже, обожаю твой взгляд. Словно собираешься съесть меня живьём. Давай. Слабо?"

# ch/anna/date.rpy:559
translate russian anna_halloween_sex_26ee3a95:
    "Вместо этого я беру в рот сосок. Она выгибается над матрасом, а я скольжу губами ниже, по животу."

# ch/anna/date.rpy:561
translate russian anna_halloween_sex_ae1def8b:
    "Она вплетает пальцы мне в волосы и удерживает там, где хочет. Бёдра тянутся к моему рту, дыхание сбивается при каждом укусе."

# ch/anna/date.rpy:562
translate russian anna_halloween_sex_00e0c850:
    anna.say "Боже, да, вот там. От тебя меня уже трясёт, а мы едва начали, чудовище."

# ch/anna/date.rpy:563
translate russian anna_halloween_sex_7c54b968:
    "Поцелуями возвращаюсь вверх по её телу. Едва она успокаивается, я вонзаю зубы в нежную кожу под челюстью. Она взвизгивает и подскакивает с подушки."

# ch/anna/date.rpy:564
translate russian anna_halloween_sex_e769d4b4:
    anna.say "Ай! Ты нарочно! Ой, повтори, пожалуйста. Заставь меня визжать, [lssb_anna.hero_name()]. Ничто так не заводит, как хороший внезапный испуг."

# ch/anna/date.rpy:566
translate russian anna_halloween_sex_c54c9f26:
    "Я прижимаю её запястья над головой и медленно, намеренно трусь о неё через остатки костюма, пока она не начинает извиваться."

# ch/anna/date.rpy:567
translate russian anna_halloween_sex_09d721fb:
    anna.say "М-м-м, да, держи меня. Я твоя бедная беззащитная волшебница, а ты загнал меня в угол. Что же мне делать?"

# ch/anna/date.rpy:568
translate russian anna_halloween_sex_7d6dde7c:
    "Она подаётся бёдрами навстречу, добиваясь трения, и тут же жалобно стонет, когда я отстраняюсь за пределы досягаемости."

# ch/anna/date.rpy:569
translate russian anna_halloween_sex_9b96b66f:
    anna.say "Дразнишься. Мерзкий, прекрасный дразнила. Ну же, я весь вечер хорошо себя вела. Я заслужила."

# ch/anna/date.rpy:570
translate russian anna_halloween_sex_b1c9b061:
    "Я стягиваю остатки костюма с её ног и бросаю в сторону. Она с радостным смешком отпинывает его и раскрывается передо мной."

# ch/anna/date.rpy:571
translate russian anna_halloween_sex_9cd22dc5:
    anna.say "Вот. Осталась только твоя глупая счастливая хэллоуинская шлюшка. Разворачивай всё, [lssb_anna.hero_name()]. Я сплошная сладость."

# ch/anna/date.rpy:572
translate russian anna_halloween_sex_036f15cf:
    anna.say "Ладно-ладно, хватит разминки. Я такая мокрая, что оставлю пятно на твоих простынях, [lssb_anna.hero_name()]."

# ch/anna/date.rpy:574
translate russian anna_halloween_sex_066362f1:
    "Анна хватает мой член и прижимает между ног, потом направляет чуть ниже — туда, где теснее и привычнее для неё."

# ch/anna/date.rpy:575
translate russian anna_halloween_sex_c2a4607f:
    anna.say "М-м-м... Чувствуешь? Твоя глупенькая хэллоуинская шлюшка всегда сначала хочет в попку."

# ch/anna/date.rpy:576
translate russian anna_halloween_sex_75c0ec3e:
    "Она говорит это так мило, словно предлагает конфету. Вся Анна в этом: ни сдержанности, ни стыда, одно сплошное счастливое непотребство."

# ch/anna/date.rpy:577
translate russian anna_halloween_sex_60015b27:
    anna.say "Но сегодня я веду себя хорошо. Да, сэр. Обе дырочки твои. Только скажи, какую используешь."

# ch/anna/date.rpy:579
translate russian anna_halloween_sex_f1f4626f:
    "Я провожу головкой по её промежности, по очереди дразня обе дырочки. От каждого медленного движения она вздрагивает и ахает."

# ch/anna/date.rpy:580
translate russian anna_halloween_sex_5a2bf642:
    anna.say "М-мх, ты специально меня мучаешь, да? Спереди, сзади — мне уже всё равно. Просто выбери и уничтожь меня."

# ch/anna/date.rpy:581
translate russian anna_halloween_sex_8afd5e93:
    "Она тянется вниз и раскрывает себя для меня, предлагая всё сразу, бесстыдно улыбаясь в потолок."

# ch/anna/date.rpy:582
translate russian anna_halloween_sex_8a6848ed:
    anna.say "Видишь? Всё выложено для тебя, как хорошее угощение. Сегодня никаких гадостей. Ну... Может, одна, если хорошенько меня напугаешь."

# ch/anna/date.rpy:584
translate russian anna_halloween_sex_cab8108d:
    "Её дыхание становится рваным, бёдра расходятся шире. Она приподнимается над матрасом, прижимаясь ко мне."

# ch/anna/date.rpy:585
translate russian anna_halloween_sex_f7ff463e:
    anna.say "Пожалуйста, [lssb_anna.hero_name()]. Мне нужно. Я представляю это с тех пор, как надела дурацкий костюм."

# ch/anna/date.rpy:587
translate russian anna_halloween_sex_b0e1fb77:
    anna.say "Я серьёзно, [lssb_anna.hero_name()]. Вся я, на столько, на сколько захочешь. Всё представляю целую жизнь из таких ночей. Это безумие?"

# ch/anna/date.rpy:589
translate russian anna_halloween_sex_ce873fd5:
    anna.say "Ни обещаний, ни обязательств. Просто трахай меня, пока я не смогу ровно ходить. На такую сделку девушка согласится."

# ch/anna/date.rpy:591
translate russian anna_halloween_sex_1aff25e0:
    "Я осторожно устраиваюсь над ней, и Анна направляет мою руку к животику."

# ch/anna/date.rpy:592
translate russian anna_halloween_sex_42c1d4b0:
    anna.say "Бережнее со своим домиком с привидениями, ладно? Тут растёт чудовище. Твоё чудовище."

# ch/anna/date.rpy:594
translate russian anna_halloween_sex_45b70361:
    "Теперь она почти не двигается: лежит раскрытая и податливая подо мной, мягкая и безвольная, как кукла."

# ch/anna/date.rpy:595
translate russian anna_halloween_sex_64dfc867:
    anna.say "Со мной можно не осторожничать, сэр. Я просто вещь, которой ты можешь пользоваться."

# ch/anna/date.rpy:596
translate russian anna_halloween_sex_b7aec23b:
    anna.say "Оплодотвори свою глупенькую счастливую шлюшку. Потом я поблагодарю, обещаю."

# ch/anna/date.rpy:598
translate russian anna_halloween_sex_d1c6b748:
    "Она держит руки у головы, раскрыв ладони, и ждёт указаний, куда их деть."

# ch/anna/date.rpy:599
translate russian anna_halloween_sex_df1a8158:
    anna.say "Куда захочешь, [lssb_anna.hero_name()]. Я буду лежать смирно. Буду очень хорошей."

# ch/anna/date.rpy:601
translate russian anna_halloween_sex_4f617d88:
    anna.say "Ну же, [lssb_anna.hero_name()]. Подари своей главной фанатке всё выступление на бис."

# ch/anna/date.rpy:604
translate russian anna_halloween_sex_d3f988ae:
    "Большинство девушек пришлось бы уговаривать на такое, но Анне убеждения не нужны."

# ch/anna/date.rpy:606
translate russian anna_halloween_sex_435d6f93:
    "Головка моего члена проходит туда, куда она хотела, и движется дальше. Её лицо озаряется жадным восторгом."

# ch/anna/date.rpy:607
translate russian anna_halloween_sex_7d667985:
    anna.say "Ох, [lssb_anna.hero_name()], ты и правда это сделал. Прямо в любимую анальную шлюшку. Вот где моё место, детка."

# ch/anna/date.rpy:610
translate russian anna_halloween_sex_a4c88524:
    anna.say "Сильнее. Сильнее, сэр, я серьёзно. Разнеси меня..."

# ch/anna/date.rpy:611
translate russian anna_halloween_sex_9c2d12df:
    anna.say "Пусть у твоей шлюшки потом неделю всё болит. Хочу вспоминать о тебе каждый раз, когда сажусь."

# ch/anna/date.rpy:612
translate russian anna_halloween_sex_def2a2e7:
    "Она невероятно тесная, и я больше не могу сдерживать оргазм."

# ch/anna/date.rpy:616
translate russian anna_halloween_sex_7b711764:
    "Я продолжаю двигаться до самого мгновения, когда наконец кончаю."

# ch/anna/date.rpy:620
translate russian anna_halloween_sex_cb68e4ba:
    anna.say "Да-а-а... Всё до капли, оставь это во мне..."

# ch/anna/date.rpy:621
translate russian anna_halloween_sex_dd4232a9:
    "Мой член мягчеет внутри неё и выскальзывает. Ничто не заслоняет её лицо, расплывшееся от блаженства."

# ch/anna/date.rpy:625
translate russian anna_halloween_sex_36d3566c:
    "Выйдя из её попки, я замечаю мелькнувшее на лице разочарование."

# ch/anna/date.rpy:630
translate russian anna_halloween_sex_3ea51bd8:
    "Потом мой член дёргается и покрывает её грудь густыми полосами."

# ch/anna/date.rpy:636
translate russian anna_halloween_sex_3a600754:
    "Потом мой член дёргается и забрызгивает спермой её живот."

# ch/anna/date.rpy:641
translate russian anna_halloween_sex_afc46c93:
    anna.say "Фу! [lssb_anna.hero_name()]! Ах ты грязный, грязный мальчишка. Обожаю. Повтори в следующем году."

# ch/anna/date.rpy:649
translate russian anna_halloween_sex_20ed5f36:
    "На этот раз я игнорирую её подсказки и прижимаю головку к киске. От лёгкого толчка её тело раскрывается, принимая меня целиком."

# ch/anna/date.rpy:650
translate russian anna_halloween_sex_c8c51ecb:
    anna.say "Ой! Ах ты хитрец, пошёл обычным путём... Я не жалуюсь. Боже, я совсем не жалуюсь."

# ch/anna/date.rpy:652
translate russian anna_halloween_sex_4a842f00:
    "Её вздох превращается в долгий, беспомощный стон. Она отчаянно кивает, подгоняя меня."

# ch/anna/date.rpy:653
translate russian anna_halloween_sex_72060438:
    anna.say "Да, сэр, вот так. Пожалуйста, не останавливайся..."

# ch/anna/date.rpy:654
translate russian anna_halloween_sex_61a1ffe0:
    anna.say "Трахай своё развратное привидение, заставь забыть собственное имя..."

# ch/anna/date.rpy:656
translate russian anna_halloween_sex_08ac4902:
    "Она словно теряет все кости подо мной, настолько пассивная, будто отдалась мне без остатка."

# ch/anna/date.rpy:657
translate russian anna_halloween_sex_79d19604:
    anna.say "Я даже не шелохнусь. Всё остальное за тобой."

# ch/anna/date.rpy:660
translate russian anna_halloween_sex_a09fbb05:
    "Её взгляд мутнеет, глаза закатываются, но тело впитывает всё как губка. А я не могу продолжать вечно..."

# ch/anna/date.rpy:665
translate russian anna_halloween_sex_9a417a51:
    "В последнее возможное мгновение я выхожу из неё и обхватываю член рукой."

# ch/anna/date.rpy:670
translate russian anna_halloween_sex_cd0b0bb2:
    "Я кончаю ей на грудь, оставляя густые полосы спермы."

# ch/anna/date.rpy:676
translate russian anna_halloween_sex_469f153e:
    "Я кончаю ей на живот, где сперма собирается лужицей."

# ch/anna/date.rpy:680
translate russian anna_halloween_sex_86e62194:
    anna.say "Эх, струсил. Трусишка. В следующий раз оставишь всё во мне, договорились? Бу! В самом прямом смысле — бу!"

# ch/anna/date.rpy:686
translate russian anna_halloween_sex_19f1b742:
    "Хорошо, что я не забыл заранее надеть презерватив."

# ch/anna/date.rpy:688
translate russian anna_halloween_sex_98d67f4a:
    "Я продолжаю до последнего мгновения, на волне своего оргазма стремясь довести и её. Переступив грань, Анна издаёт протяжный, почти звериный звук."

# ch/anna/date.rpy:690
translate russian anna_halloween_sex_b20aa8e1:
    "Но она всё ещё не пытается двигаться, словно её кости превратились в желе."

# ch/anna/date.rpy:692
translate russian anna_halloween_sex_5606097a:
    anna.say "Всё нормально... Я пью таблетки... Просто сделай это, [lssb_anna.hero_name()]..."

# ch/anna/date.rpy:695
translate russian anna_halloween_sex_23b02324:
    "Я теряю контроль и наполняю её. После этого ей остаётся только стонать."

# ch/anna/date.rpy:696
translate russian anna_halloween_sex_dc3c2ae6:
    anna.say "Боже, как тепло... Лучшая сладость во всей миске..."

# ch/anna/date.rpy:698
translate russian anna_halloween_sex_cf0514ac:
    "Сейчас кончать в Анну не опасно. Я почти прижимаюсь к её уже весьма заметному беременному животу."

# ch/anna/date.rpy:701
translate russian anna_halloween_sex_9cdcb2b8:
    "Когда я кончаю в неё, Анна ничем не выражает недовольства. Только тяжело дышит и тихо стонет."

# ch/anna/date.rpy:703
translate russian anna_halloween_sex_6a78cf24:
    anna.say "М-м-м... Именно туда, куда нужно, [lssb_anna.hero_name()]."

# ch/anna/date.rpy:705
translate russian anna_halloween_sex_9bbc5225:
    anna.say "М-м-м... Хорошо и глубоко, именно там, где ты мне нравишься..."

# ch/anna/date.rpy:707
translate russian anna_halloween_sex_ac4a7c83:
    "Надо бы выйти, прежде чем кончу в неё. Но до сих пор она позволяла мне всё решать. Почему не позволить и это?"

# ch/anna/date.rpy:712
translate russian anna_halloween_sex_eddc7aa8:
    "Крепко удерживая её, я наполняю Анну последним глубоким толчком. Осознав случившееся, она утыкается лицом в подушку, всё ещё дрожа."

# ch/anna/date.rpy:714
translate russian anna_halloween_sex_e75b78fd:
    anna.say "Ты и правда это сделал, [lssb_anna.hero_name()]..."

# ch/anna/date.rpy:715
translate russian anna_halloween_sex_03af4a90:
    anna.say "...Наполнил свою шлюшку до краёв."

# ch/anna/date.rpy:717
translate russian anna_halloween_sex_90201a3c:
    anna.say "Ты и правда это сделал..."

# ch/anna/date.rpy:718
translate russian anna_halloween_sex_49c54c66:
    anna.say "...Наполнил свою глупенькую шлюшку до краёв."

# ch/anna/date.rpy:720
translate russian anna_halloween_sex_328e8fea:
    "Зная, как сильно Анна потеряла голову, я прохожу точку невозврата. Даже если бы захотел, вовремя выйти уже не смог бы."

# ch/anna/date.rpy:726
translate russian anna_halloween_sex_a02fc518:
    "Сначала она довольно вздыхает, но, когда я выхожу, звуки меняются. Теперь в них слышны слова."

# ch/anna/date.rpy:727
translate russian anna_halloween_sex_8d7a6df2:
    anna.say "Что... что ты только что сделал?.. Вот же ты козёл, [lssb_anna.hero_name()]..."

# ch/anna/date.rpy:729
translate russian anna_halloween_sex_ca988721:
    "Анна совсем потеряла голову, но я ненамного лучше. Не замечаю, насколько близок к концу, пока не становится поздно."

# ch/anna/date.rpy:734
translate russian anna_halloween_sex_7dbe87a2:
    "Лишь потом, когда я слезаю с неё, до меня доходит, что я натворил. Я жду, что она взбесится."

# ch/anna/date.rpy:736
translate russian anna_halloween_sex_ca622f14:
    "Но вместо этого она улыбается мне, сияя тем, что можно назвать только счастьем."

# ch/anna/date.rpy:738
translate russian anna_halloween_sex_c3204daf:
    anna.say "Сладость или гадость, [lssb_anna.hero_name()]. Лучший испуг за весь вечер, и мне нравится."

# ch/anna/date.rpy:740
translate russian anna_halloween_sex_a0035c7e:
    anna.say "Ну. Вот и способ закончить вечеринку. Не паникуй так, глупый. Иди сюда."

# ch/anna/date.rpy:743
translate russian anna_halloween_sex_274cb27c:
    "Она обмякает на подушках, тяжело дыша. На лицо снова наползает та дурашливая улыбка."

# ch/anna/date.rpy:745
translate russian anna_halloween_sex_80066405:
    anna.say "Ну что, в то же время на следующий Хэллоуин?"

# ch/anna/date.rpy:746
translate russian anna_halloween_sex_bc189ba8:
    "Я не могу удержаться от смеха. Она прижимается ко мне сбоку — тёплая, липкая и невероятно довольная собой."

# ch/anna/events.rpy:433
translate russian anna_event_01_7bc80586:
    mike.say "Алло?"

# ch/anna/events.rpy:434
translate russian anna_event_01_6cf52ce2:
    "Вокруг такой шум, что мне трудно что-либо расслышать. Когда я наконец различаю голос, я поражаюсь, узнав, что это Анна."

# ch/anna/events.rpy:435
translate russian anna_event_01_82032d48:
    "Она говорит невнятно, и кажется, что она очень пьяна."

# ch/anna/events.rpy:436
translate russian anna_event_01_b9f56df7:
    anna.say "\"Привет, [lssb_anna.hero_name()], как ты?\" - говорит Анна мужчине Майку."

# ch/anna/events.rpy:437
translate russian anna_event_01_c169d568:
    "Я с трудом сдерживаю смех, забавляясь тем, как ее тонкий голос бормочет бессвязные слова."

# ch/anna/events.rpy:438
translate russian anna_event_01_97d266fe:
    mike.say "\"У меня все хорошо, Анна, а у тебя?\" - спрашивает Майк женщину Анну."

# ch/anna/events.rpy:439
translate russian anna_event_01_1d0d5723:
    anna.say "\"О, у меня просто замечательно!\" - отвечает Анна Майку."

# ch/anna/events.rpy:440
translate russian anna_event_01_61ae108e:
    mike.say "\"Я рад это слышать, дорогая. Чем занимаешься?\" - спрашивает Майк Анну."

# ch/anna/events.rpy:441
translate russian anna_event_01_33b4adb3:
    anna.say "\"Да знаешь, обычные вещи. Пью, курю, гуляю по центру.\" - говорит Анна Майку."

# ch/anna/events.rpy:442
translate russian anna_event_01_9c24ee23:
    mike.say "\"Звучит как очень весело,\" - отвечает Майк Анне."

# ch/anna/events.rpy:443
translate russian anna_event_01_f201f0ba:
    anna.say "\"О, это действительно так. Центр – мое любимое место! Здесь все просто супер.\" - говорит Анна Майку."

# ch/anna/events.rpy:446
translate russian anna_event_01_ec1aeb4f:
    mike.say "\"Правда? Ну, ты не против, если я к тебе присоединюсь?\" - спрашивает Майк Анну."

# ch/anna/events.rpy:447
translate russian anna_event_01_f989758e:
    "Анна ахает."

# ch/anna/events.rpy:448
translate russian anna_event_01_e42cfb90:
    anna.say "\"О боже, это было бы потрясающе! Сейчас я тебе напишу адрес бара,\" - говорит Анна Майку."

# ch/anna/events.rpy:449
translate russian anna_event_01_26065de6:
    anna.say "\"Но лучше поторопись и приезжай скорее!\" - говорит Анна Майку."

# ch/anna/events.rpy:450
translate russian anna_event_01_87ab1e2c:
    "Она отправила мне сообщение с идеально написанным адресом, быстрее, чем я ожидал от пьяного человека."

# ch/anna/events.rpy:451
translate russian anna_event_01_ddeb6a0c:
    "Я внезапно понимаю, что этот бар находится всего в нескольких кварталах от моего дома."

# ch/anna/events.rpy:452
translate russian anna_event_01_0d323388:
    "Наверное, поэтому Анна мне и позвонила: даже в пьяном угаре сообразила, что я поблизости."

# ch/anna/events.rpy:453
translate russian anna_event_01_85ccea88:
    mike.say "Хорошо, Анна, я буду через несколько минут. Следи за мной!"

# ch/anna/events.rpy:454
translate russian anna_event_01_17fe940e:
    anna.say "Конечно, обязательно! Скоро увидимся!"

# ch/anna/events.rpy:455
translate russian anna_event_01_c248badf:
    "Прежде чем я успеваю попрощаться, она бросает трубку, и отголосок ее смеха все еще висит у меня на губах."

# ch/anna/events.rpy:459
translate russian anna_event_01_df4cea20:
    mike.say "Где ты, Анна?"

# ch/anna/events.rpy:460
translate russian anna_event_01_642d026a:
    "Шум снова усиливается, и я понимаю, что она, вероятно, спрашивает своих друзей, где она находится. Черт. Она, должно быть, пьяна сильнее, чем я думал."

# ch/anna/events.rpy:461
translate russian anna_event_01_94d72592:
    "Наконец она возвращается к телефону и кричит мне в ухо адрес. Я немного отодвигаю трубку: её дребезжащий голос действует на нервы."

# ch/anna/events.rpy:462
translate russian anna_event_01_4eba74ba:
    "Я понимаю, что бар, где она находится, всего в нескольких кварталах от меня."

# ch/anna/events.rpy:463
translate russian anna_event_01_71af3218:
    "Хочу я это признавать или нет, я беспокоюсь о ней, и я не хочу оставлять ее одну справляться с тем, кто еще с ней, особенно если они тоже пьяны."

# ch/anna/events.rpy:464
translate russian anna_event_01_9affe159:
    "Поэтому, вопреки здравому смыслу, я надеваю куртку."

# ch/anna/events.rpy:465
translate russian anna_event_01_3c55e82a:
    mike.say "Я рад, что ты весело проводишь время, Анна! Просто чтобы убедиться, что у тебя все в порядке, я собираюсь прийти и посмотреть на тебя, хорошо?"

# ch/anna/events.rpy:466
translate russian anna_event_01_eb9ec696:
    "Я слышу, как она сердито фыркает по телефону. Она начинает ныть, громко и раздраженно."

# ch/anna/events.rpy:467
translate russian anna_event_01_f348fa71:
    anna.say "Ты не мой папа, [lssb_anna.hero_name()], я могу сама о себе позаботиться."

# ch/anna/events.rpy:468
translate russian anna_event_01_6b5c776d:
    "Я закатываю глаза и все равно начинаю выходить из дома."

# ch/anna/events.rpy:469
translate russian anna_event_01_3c3e62a1:
    mike.say "Я знаю, я знаю, что ты можешь. Я просто хочу быть другом, хорошо? Если ничего больше, то теперь мы можем веселиться вместе, а не по отдельности, да?"

# ch/anna/events.rpy:470
translate russian anna_event_01_06398373:
    "Она вздыхает."

# ch/anna/events.rpy:471
translate russian anna_event_01_8bd14aa6:
    anna.say "Ну, наверное, так и есть."

# ch/anna/events.rpy:472
translate russian anna_event_01_78ef93e8:
    mike.say "Хорошо, тогда не уходи никуда. Я вернусь через минуту."

# ch/anna/events.rpy:473
translate russian anna_event_01_572911b8:
    "Прежде чем я успеваю попрощаться, связь обрывается. Сдерживая смех и легкую тревогу, я выхожу на прохладную ночную улицу."

# ch/anna/events.rpy:477
translate russian anna_event_01_55e8c1b1:
    "Я быстро иду по улице и понимаю, что мне не займет много времени найти бар, где была Анна."

# ch/anna/events.rpy:478
translate russian anna_event_01_eca222e3:
    "Басы бьют так громко, что я слышу их в конце своей улицы; пьяные крики и мигающие огни настолько заметны, что я удивляюсь, почему полиция еще не закрыла это место."

# ch/anna/events.rpy:479
translate russian anna_event_01_1b6e5918:
    "Подойдя ближе, я вижу группу людей, которые кажутся знакомыми, они веселятся на открытой террасе, выпивают текилу и смеются над шуткой, которую я слишком далеко, чтобы услышать."

# ch/anna/events.rpy:481
translate russian anna_event_01_3bee0aed:
    "Осмотрев толпу, я наконец-то вижу Анну, которая смеется вместе со всеми, и я выдыхаю, не осознавая, что задерживал дыхание."

# ch/anna/events.rpy:483
translate russian anna_event_01_8fb13572:
    "Перешагнув через небольшой забор террасы, я подхожу к ней и слегка касаюсь ее плеча."

# ch/anna/events.rpy:487
translate russian anna_event_01_9c55fb16:
    "Она шатко поворачивается, спотыкается о собственные ноги и падает прямо в мои объятия. Когда она приходит в себя, она смотрит на меня вверх, а затем на ее лице появляется самая широкая улыбка."

# ch/anna/events.rpy:489
translate russian anna_event_01_7f337f80:
    anna.say "[lssb_anna.hero_name()]! Ты здесь!"

# ch/anna/events.rpy:490
translate russian anna_event_01_0b5eeb50:
    "Я улыбаюсь ей и помогаю ей удержаться."

# ch/anna/events.rpy:492
translate russian anna_event_01_a794bda9:
    mike.say "Что я могу сказать, кто бы мог устоять перед вечером с тобой?"

# ch/anna/events.rpy:494
translate russian anna_event_01_13d209e2:
    "Анна начинает хихикать, на ее щеках появляется румянец, она пытается сдержаться."

# ch/anna/events.rpy:495
translate russian anna_event_01_02a5c703:
    anna.say "Ой, [lssb_anna.hero_name()], ты такой, блин, милый. Я рада, что ты здесь!"

# ch/anna/events.rpy:496
translate russian anna_event_01_f6629484:
    mike.say "Я тоже, Анна."

# ch/anna/events.rpy:497
translate russian anna_event_01_e50fcd9c:
    "Я заказываю пиво у бармена, надеясь немного расслабиться, но не остаюсь долго у бара, а сразу же возвращаюсь к Анне."

# ch/anna/events.rpy:500
translate russian anna_event_01_b1da4843:
    mike.say "Да, это я."

# ch/anna/events.rpy:502
translate russian anna_event_01_98dce6a3:
    "Анна закатила глаза и отвернулась от меня, пытаясь схватить свой стаканчик."

# ch/anna/events.rpy:503
translate russian anna_event_01_19124096:
    anna.say "Вау, ты сегодня прямо зануда. Выпей что-нибудь, это тебя расслабит."

# ch/anna/events.rpy:504
translate russian anna_event_01_c7be6166:
    "Несмотря на мои сомнения, я послушал ее и заказал пиво у бармена, а затем вернулся к ней."

# ch/anna/events.rpy:507
translate russian anna_event_01_a57e9d54:
    "Анна покачивается, ей трудно говорить, и ее слова становятся все более невнятными."

# ch/anna/events.rpy:508
translate russian anna_event_01_d5021555:
    "Хотя мне не могу удержаться от смеха, когда она пытается произнести \"Battle of the Bands\" уже в восьмой раз, моя тревога за ее самочувствие постоянно растет."

# ch/anna/events.rpy:509
translate russian anna_event_01_e3920090:
    "Она совершенно пьяна, и ее друзьям это, похоже, совсем неважно. Они тоже пьяны и вполне довольны тем, что просто оставят ее одну."

# ch/anna/events.rpy:510
translate russian anna_event_01_5130b720:
    "Я не могу сказать то же самое о себе."

# ch/anna/events.rpy:512
translate russian anna_event_01_661c0583:
    mike.say "Эй, Анна, ты себя хорошо чувствуешь?"

# ch/anna/events.rpy:516
translate russian anna_event_01_ae9a4b43:
    "Анна сморщила лицо и начала раскачиваться взад-вперед, пытаясь остаться в сознании."

# ch/anna/events.rpy:520
translate russian anna_event_01_3dc4ef2e:
    anna.say "Все нормально!"

# ch/anna/events.rpy:521
translate russian anna_event_01_e9b88b55:
    mike.say "Ты уверена, дорогая? Кажется, ты совсем не в себе. Дай я тебе принесу воды, хотя бы."

# ch/anna/events.rpy:522
translate russian anna_event_01_6f84970d:
    "На мгновение я боюсь, что она отвергнет мою заботу, ее глаза сужаются, когда она наконец-то выпрямляется."

# ch/anna/events.rpy:524
translate russian anna_event_01_6bc0d81f:
    "Затем она оседает на стул, который я освободил для нее, и машет рукой."

# ch/anna/events.rpy:525
translate russian anna_event_01_033d0aa3:
    anna.say "Знаешь, вода – это хорошая идея, спасибо, [lssb_anna.hero_name()]."

# ch/anna/events.rpy:526
translate russian anna_event_01_c68633d5:
    "С удовольствием, – быстро говорю я и ухожу за водой для Анны."

# ch/anna/events.rpy:529
translate russian anna_event_01_675380db:
    mike.say "Анна, я думаю, нам стоит уйти отсюда."

# ch/anna/events.rpy:531
translate russian anna_event_01_7ce556ed:
    "Анна прищурилась, сверкнула на меня глазами и впилась ногтями в стекло пивной бутылки."

# ch/anna/events.rpy:532
translate russian anna_event_01_820c6e1c:
    anna.say "Что ты пытаешься сделать, [lssb_anna.hero_name()]? Ты хочешь воспользоваться мной?"

# ch/anna/events.rpy:533
translate russian anna_event_01_a1817841:
    mike.say "Нет! Нет, черт возьми, Анна, я никогда бы не сделал ничего подобного. Я просто беспокоюсь о тебе. Кажется, ты сильно пьяна."

# ch/anna/events.rpy:534
translate russian anna_event_01_46bd453c:
    "Анна переступает с ноги на ногу, стоит, но все еще настороженно."

# ch/anna/events.rpy:535
translate russian anna_event_01_45983bcf:
    anna.say "Я совсем не так плоха, [lssb_anna.hero_name()], я не понимаю, что ты имеешь в виду."

# ch/anna/events.rpy:536
translate russian anna_event_01_2c87d908:
    mike.say "Я просто... Я всего лишь... Ай, ладно, Анна. Просто сядь и дай мне хотя бы принести тебе воды. Пожалуйста."

# ch/anna/events.rpy:538
translate russian anna_event_01_3a186875:
    "Анна фыркает, скрещивает ноги и занимает мое место."

# ch/anna/events.rpy:539
translate russian anna_event_01_76b7cebe:
    anna.say "Как знаешь."

# ch/anna/events.rpy:541
translate russian anna_event_01_f561ad45:
    "Бармен быстро выполняет мою просьбу и приносит мне большой стакан ледяной воды."

# ch/anna/events.rpy:545
translate russian anna_event_01_285b2fad:
    "Когда я поворачиваюсь, я вижу Анну, сидящую за столом, и разговаривающую с мужчиной, который наклонился над ней, слишком близко для моего комфорта."

# ch/anna/events.rpy:546
translate russian anna_event_01_94c24a63:
    "Несколько мгновений я просто стою и наблюдаю, настолько ошеломленный, что не могу найти в себе силы поднять ноги."

# ch/anna/events.rpy:547
translate russian anna_event_01_026aa34c:
    "Мужчина наклоняется еще ближе к ней, проводит рукой по ее линии челюсти, ухмыляется ей, выглядит как хищник, выслеживающий свою добычу."

# ch/anna/events.rpy:549
translate russian anna_event_01_959a37e5:
    "Анна напрягается, явно чувствуя дискомфорт от его настойчивости, но слишком пьяна, чтобы понять, что происходит на самом деле."

# ch/anna/events.rpy:552
translate russian anna_event_01_0f4a8b54:
    "Достаточно! Я подхожу к ней и встаю у нее на пути."

# ch/anna/events.rpy:553
translate russian anna_event_01_79347b8d:
    "Несмотря на гнев, который клокочет внутри меня, я стараюсь сохранять спокойствие в голосе. Я не хочу ее пугать, Анна."

# ch/anna/events.rpy:554
translate russian anna_event_01_c7b39ea5:
    mike.say "Привет, дорогая. Я принес тебе воды. Это кто?"

# ch/anna/events.rpy:555
translate russian anna_event_01_42fdaec2:
    "Анна крепко держит меня за руку, и я осторожно протягиваю ей воду. Ей трудно что-то сказать, слова у нее сливаются в бессвязную массу, и я даже не могу разобрать его имя."

# ch/anna/events.rpy:556
translate russian anna_event_01_96f1d650:
    "Подозрительный тип" "Я просто друг Анны."

# ch/anna/events.rpy:557
translate russian anna_event_01_b952522a:
    mike.say "Ну, может быть, я слишком много думаю, но она, кажется, не очень рада твоему возвращению."

# ch/anna/events.rpy:558
translate russian anna_event_01_b65fd10b:
    "Незнакомец выглядит неловко от этих слов и отворачивается от нас."

# ch/anna/events.rpy:559
translate russian anna_event_01_34060936:
    "Подозрительный тип" "Ну, может быть. Я просто подумал, что она тебе нравится. Извини, приятель."

# ch/anna/events.rpy:560
translate russian anna_event_01_4f6e7a4e:
    "Он бросил последний взгляд на Анну и заговорил через плечо, уходя."

# ch/anna/events.rpy:561
translate russian anna_event_01_a94d7027:
    "Подозрительный тип" "Пока, Анна. Еще раз извини."

# ch/anna/events.rpy:563
translate russian anna_event_01_50113f97:
    "Обернувшись к Анне, она не смогла сказать почти ничего, но просто посмотрела на меня и обняла, ее глаза выражали больше, чем любые слова."

# ch/anna/events.rpy:564
translate russian anna_event_01_5f245d09:
    "Я обнимаю ее в ответ, наслаждаясь моментом, а затем снова помогаю ей выпить воду."

# ch/anna/events.rpy:567
translate russian anna_event_01_04f325a0:
    "Я остаюсь рядом, просматривая все свои разговоры с Анной, чтобы узнать, есть ли у нее парень, о котором я не знаю."

# ch/anna/events.rpy:568
translate russian anna_event_01_7ecb7cef:
    "В конце концов, я не хочу быть тем парнем, особенно если у нее уже есть парень."

# ch/anna/events.rpy:569
translate russian anna_event_01_1871f445:
    "Мужчина приближается к Анне, проводя рукой по ее бедру, расставляя пальцы и касаясь каждой свободной части ее кожи."

# ch/anna/events.rpy:570
translate russian anna_event_01_2acaea16:
    "У него едва слюни не текут, голодный взгляд обшаривает её всю. Я отчасти понимаю: Анна невероятно горяча. Но что-то в этой ситуации не так."

# ch/anna/events.rpy:571
translate russian anna_event_01_9b6f3835:
    "Я не могу понять это чувство, но что-то внутри меня приковало меня к полу, я не могу отвести взгляд, но и не могу заставить себя двигаться вперед."

# ch/anna/events.rpy:572
translate russian anna_event_01_8badc560:
    "Мужчина становится все ближе к Анне, его губы почти касаются ее, а она изо всех сил пытается держать глаза открытыми."

# ch/anna/events.rpy:573
translate russian anna_event_01_38bdad54:
    "Наконец-то кто-то еще заметил Анну, одну из ее подруг, у которой на лице было то же выражение растерянности, что и у меня."

# ch/anna/events.rpy:574
translate russian anna_event_01_6405a703:
    "Однако, в этот раз она решила вмешаться."

# ch/anna/events.rpy:575
translate russian anna_event_01_7b9a5ecf:
    "Она подходит к этому мужчине с достаточной дозой пьяной бравады, чтобы отпугнуть его."

# ch/anna/events.rpy:576
translate russian anna_event_01_81165f0b:
    "Мужчина выглядит виноватым и смущенным, словно он понимал, что делает не то, и я внезапно осознал, что мог бы сделать больше."

# ch/anna/events.rpy:577
translate russian anna_event_01_0ad3933d:
    "Я мог бы ей помочь, но вместо этого все, что я мог делать, это смотреть и бояться."

# ch/anna/events.rpy:578
translate russian anna_event_01_30b98da4:
    "С чувством стыда я тихонько подхожу к Анне, стараясь крепко ее обнять, когда доберусь до нее."

# ch/anna/events.rpy:580
translate russian anna_event_01_ebb3da70:
    "Анна, казалось, успокоилась после воды и нежно прислонилась головой к моему плечу."

# ch/anna/events.rpy:582
translate russian anna_event_01_a107c321:
    anna.say "Я устала, [lssb_anna.hero_name()]."

# ch/anna/events.rpy:583
translate russian anna_event_01_7b9aea41:
    mike.say "Я знаю, Анна. Ты хочешь пойти домой?"

# ch/anna/events.rpy:584
translate russian anna_event_01_266431d7:
    "Анна вскрикивает от расстройства, ее голос звучит почти на грани слез."

# ch/anna/events.rpy:585
translate russian anna_event_01_712d6931:
    anna.say "Я живу через весь город, и мы сейчас не можем ехать. Я никогда не смогу добраться до дома."

# ch/anna/events.rpy:586
translate russian anna_event_01_5927bcb0:
    "Черт, она права. Мы не можем ехать, особенно она."

# ch/anna/events.rpy:587
translate russian anna_event_01_f0199c9d:
    "Я не хочу быть таким парнем, но я знаю, что могу отвести ее домой. Или хотя бы помочь ей безопасно добраться до дома."

# ch/anna/events.rpy:590
translate russian anna_event_01_392606af:
    mike.say "Анна, я обещаю, я не хочу, чтобы это казалось странным, но я живу совсем рядом, на той же улице."

# ch/anna/events.rpy:591
translate russian anna_event_01_a654f943:
    mike.say "Ты хочешь пойти ко мне домой?"

# ch/anna/events.rpy:592
translate russian anna_event_01_ae53ea9f:
    mike.say "Саша и [bree.name] должны быть дома, а у нас еще есть диван в гостиной."

# ch/anna/events.rpy:593
translate russian anna_event_01_1e880906:
    "Глаза Анны блестят, и она молча кивает, почти падая мне на руки."

# ch/anna/events.rpy:594
translate russian anna_event_01_485dd421:
    "Я бросил несколько долларов на стол, чтобы оплатить её счёт, попрощался с её друзьями и медленно начал помогать ей идти в мою сторону."

# ch/anna/events.rpy:598
translate russian anna_event_01_080a07ab:
    "Это был долгий, тихий путь домой, нарушаемый лишь краткими звуками оживлённой улицы."

# ch/anna/events.rpy:599
translate russian anna_event_01_300db383:
    "Анна молчит, спотыкается, едва связно говорит. Я изо всех сил старался помочь ей идти, молясь, чтобы дверь моего дома была совсем скоро."

# ch/anna/events.rpy:603
translate russian anna_event_01_28b79fbd:
    "Наконец, когда я уже думал, что Анна больше не сможет сделать ни шагу, мы добрались до моей двери. Стараясь ступать как можно тише, я впустил её в мой дом."

# ch/anna/events.rpy:610
translate russian anna_event_01_5e59f59d:
    "Почти сразу же она упала на мой диван и заснула быстрее, чем я мог себе представить."

# ch/anna/events.rpy:611
translate russian anna_event_01_454d5472:
    "С трудом сдерживая улыбку, я изо всех сил пытаюсь уложить её спать, накрываю одеялом и ставлю рядом ведро на всякий случай, если ей станет плохо."

# ch/anna/events.rpy:612
translate russian anna_event_01_dfd993d3:
    "Она выглядит такой спокойной, спящей на диване, что я на мгновение просто смотрю на неё, свернувшуюся в одеяло, с поднимающимся и опускающимся грудным отделом, что говорит о её глубоком сне."

# ch/anna/events.rpy:613
translate russian anna_event_01_26d55fc5:
    "Она была такой красивой, такой беззаботной, пока спала."

# ch/anna/events.rpy:615
translate russian anna_event_01_2ed27172:
    "Наконец, убедившись, что она в безопасности и ей комфортно, я собираюсь идти в свою комнату, внезапно ощущая глубокую усталость во всех костях."

# ch/anna/events.rpy:619
translate russian anna_event_01_85887e97:
    mike.say "Ты хочешь, чтобы я вызвал тебе такси? Я могу поехать с тобой, чтобы убедиться, что с тобой всё хорошо."

# ch/anna/events.rpy:620
translate russian anna_event_01_fcd82731:
    "Анна поднимает на меня глаза, в них читается усталость. Она молча кивает, прежде чем прижаться к моему телу."

# ch/anna/events.rpy:621
translate russian anna_event_01_64a20bb9:
    "Я изо всех сил пытаюсь вызвать такси, набирая все номера компаний такси, которые могу найти, пока не найду одну, которая согласится отвезти нас обоих туда, куда мне нужно."

# ch/anna/events.rpy:622
translate russian anna_event_01_925ce92a:
    "Я вздрагиваю от стоимости этой поездки, зная, что это серьёзно ударит по моему кошельку, но я знаю, что Анне это необходимо. По совести, я не могу её здесь оставить."

# ch/anna/events.rpy:624
translate russian anna_event_01_c82fe513:
    "Она засыпает, пока мы ждём такси, и кажется, что оно никак не может приехать быстрее."

# ch/anna/events.rpy:628
translate russian anna_event_01_06ce53d1:
    "Наконец, я увидел, как машина подъехала к повороту, и медленно помог Анне встать, направляя её на заднее сиденье."

# ch/anna/events.rpy:630
translate russian anna_event_01_4d6748f5:
    "Она молчала, пока ехали, и свет фар с улицы то появлялся в окнах, то исчезал."

# ch/anna/events.rpy:631
translate russian anna_event_01_940f8013:
    "Наконец, мы вернулись к ее квартире, и я, насколько это было возможно, помог ей выйти из машины возле двери."

# ch/anna/events.rpy:635
translate russian anna_event_01_8fe7b834:
    mike.say "Ты будешь в порядке, Анна?"

# ch/anna/events.rpy:636
translate russian anna_event_01_cc608dfa:
    "Анна кивнула, пытаясь сохранить равновесие. С легкой улыбкой она медленно направилась к своему дому, а я стоял и смотрел, как она спотыкается на пути домой, прикусив губу."

# ch/anna/events.rpy:638
translate russian anna_event_01_001c64b7:
    "Колеблясь, я возвращаюсь в такси. Тревожная пустота в животе растёт, пока водитель медленно увозит меня, опустошая кошелёк и оставляя моё сердце на обочине."

# ch/anna/events.rpy:646
translate russian anna_event_02_abce0935:
    "Одна вещь, о которой Анна постоянно мне рассказывала с тех пор, как мы начали проводить время вместе, это то, насколько она любит фильмы ужасов."

# ch/anna/events.rpy:647
translate russian anna_event_02_b9eef649:
    "Если бы в местном кинотеатре показывали что-то новое и особенно жуткое, я бы ни секунды не колебался, чтобы взять ее посмотреть."

# ch/anna/events.rpy:648
translate russian anna_event_02_fe75bda7:
    "Еще лучше был бы один из фестивалей фильмов ужасов, где независимый кинотеатр показывает малоизвестные, культовые фильмы этого жанра."

# ch/anna/events.rpy:649
translate russian anna_event_02_7944cb04:
    "Но поскольку ни одного из этих вариантов нет, мне приходится приглашать Анну к себе домой, чтобы вместе смотреть фильмы."

# ch/anna/events.rpy:650
translate russian anna_event_02_559514d9:
    "Перед назначенным временем я отправляю ей список названий из моей коллекции и прошу ее выбрать то, что ей интересно."

# ch/anna/events.rpy:651
translate russian anna_event_02_a13c04ca:
    "К сожалению для меня, она вскоре сообщает мне, что видела все эти фильмы, причем не один раз."

# ch/anna/events.rpy:652
translate russian anna_event_02_4d92e249:
    "В этот момент я вспоминаю, что у [bree.name], кажется, есть несколько фильмов ужасов в своей коллекции, о которых я даже никогда не слышал."

# ch/anna/events.rpy:654
translate russian anna_event_02_960d0096:
    "Поэтому я быстро отправляю Анне сообщение, успокаиваю ее и спрашиваю разрешение у [bree.name] покопаться в ее \"видео-извращениях\"."

# ch/anna/events.rpy:655
translate russian anna_event_02_8892f40f:
    "Вскоре я обнаруживаю, что единственная проблема заключается в том, что, хотя у [bree.name] действительно есть несколько фильмов ужасов на выбор, они, похоже, относятся к какому-то странному поджанру."

# ch/anna/events.rpy:656
translate russian anna_event_02_5d1b75d6:
    "Во всех них школьники превращаются в оборотней на баскетбольной площадке, а чирлидерши убивают вампиров."

# ch/anna/events.rpy:657
translate russian anna_event_02_2eff73a7:
    "Это как будто кто-то смешал тропы фильмов ужасов и подростковых фильмов восьмидесятых, создав странную смесь этих двух жанров."

# ch/anna/events.rpy:658
translate russian anna_event_02_3992e112:
    "Все эти вампиры – просто красивые парни, которым нужно, чтобы их поняли бунтарские девушки, в которых они неизбежно влюбляются."

# ch/anna/events.rpy:659
translate russian anna_event_02_49fdc215:
    "Ну, это те из них, которые не оказываются избранными, как раз в одну эпоху, и которым не протыкают сердце осиновым колом."

# ch/anna/events.rpy:660
translate russian anna_event_02_e984dfa7:
    "В конце концов, я просто беру один диск, на котором написано что-то о вампирах, и который выглядит более новым, чем остальные."

# ch/anna/events.rpy:661
translate russian anna_event_02_c5483f25:
    "Ну, насколько же плохо это может быть?"

# ch/anna/events.rpy:663
translate russian anna_event_02_af99c6fc:
    "Практически в тот же момент, когда я держу DVD в руках, я слышу стук в входную дверь."

# ch/anna/events.rpy:664
translate russian anna_event_02_a6905d86:
    "Я тороплюсь выйти из комнаты [bree.name] и спускаюсь по лестнице в коридор, очень желая впустить Анну и начать вечер."

# ch/anna/events.rpy:670
translate russian anna_event_02_57ab93e5:
    "Но когда я открываю дверь, она просто стоит там, не пытаясь войти."

# ch/anna/events.rpy:671
translate russian anna_event_02_6def9000:
    anna.say "Ну что же, ты меня не пригласишь?"

# ch/anna/events.rpy:672
translate russian anna_event_02_2c6c4cfb:
    mike.say "Эм, разве это не подразумевалось тем, что я открыл дверь с улыбкой на лице?"

# ch/anna/events.rpy:673
translate russian anna_event_02_07cc5766:
    "Анна закатывает глаза и смеется над этим."

# ch/anna/events.rpy:675
translate russian anna_event_02_de3d9a2e:
    anna.say "Ох, [lssb_anna.hero_name()], ты такой милый, когда ничего не понимаешь!"

# ch/anna/events.rpy:676
translate russian anna_event_02_231b1d5f:
    anna.say "Мы будем смотреть фильмы ужасов, верно?"

# ch/anna/events.rpy:678
translate russian anna_event_02_48aee7eb:
    mike.say "Да... по крайней мере, так был план."

# ch/anna/events.rpy:679
translate russian anna_event_02_ec9fe5b6:
    anna.say "Так что тебе стоит пригласить меня войти. Ну, как вампира, понимаешь?"

# ch/anna/events.rpy:680
translate russian anna_event_02_ebd830d1:
    mike.say "Что, чтобы ты укусила меня за шею и высосала мою кровь?"

# ch/anna/events.rpy:682
translate russian anna_event_02_e52bd107:
    "Анна злобно хихикает и подмигивает, при этом немного обнажая зубы."

# ch/anna/events.rpy:683
translate russian anna_event_02_a9b136bb:
    anna.say "Ну, возможно, это еще не все, что я умею..."

# ch/anna/events.rpy:684
translate russian anna_event_02_7258d5f8:
    mike.say "А… Похоже, тебе лучше войти!"

# ch/anna/events.rpy:688
translate russian anna_event_02_95731aa3:
    "Анна переступает порог и входит в дом, кокетливо подмигивая мне."

# ch/anna/events.rpy:689
translate russian anna_event_02_c0ddfbff:
    "Чувствуя себя немного смущенным, я быстро провожу ее в гостиную и жестом показываю на диван перед телевизором."

# ch/anna/events.rpy:690
translate russian anna_event_02_0762f449:
    mike.say "Я сейчас схожу на кухню, возьму закуски и напитки."

# ch/anna/events.rpy:691
translate russian anna_event_02_77d8a281:
    mike.say "Фильм, который я выбрал, в коробке на журнальном столике, посмотри."

# ch/anna/events.rpy:692
translate russian anna_event_02_2915c072:
    "Когда я возвращаюсь через несколько мгновений, нагруженный припасами для вечернего просмотра, я вижу, что Анна улыбается с иронией."

# ch/anna/events.rpy:693
translate russian anna_event_02_21721793:
    mike.say "Что случилось, Анна?"

# ch/anna/events.rpy:694
translate russian anna_event_02_a58b3907:
    mike.say "Ты выглядишь так, будто я только что вошел к тебе без застегнутых штанов..."

# ch/anna/events.rpy:695
translate russian anna_event_02_087502dd:
    "Анна отвечает на это, поднимая коробку с DVD, чтобы я мог увидеть обложку."

# ch/anna/events.rpy:696
translate russian anna_event_02_cb824a3d:
    anna.say "Ты действительно выбрал именно этот фильм?"

# ch/anna/events.rpy:697
translate russian anna_event_02_c4c6b86b:
    mike.say "Да, и что?"

# ch/anna/events.rpy:698
translate russian anna_event_02_67eb9a47:
    mike.say "Это про вампиров, да?"

# ch/anna/events.rpy:699
translate russian anna_event_02_750ce22c:
    anna.say "Конечно!"

# ch/anna/events.rpy:700
translate russian anna_event_02_4572ddef:
    "Анна явно не хочет продолжать. Мне остаётся сесть рядом и взять DVD так осторожно, словно он вот-вот взорвётся."

# ch/anna/events.rpy:701
translate russian anna_event_02_174f2f2f:
    "Я мог бы начать ворчать и потребовать, чтобы она объяснила мне, что не так с моим выбором фильма."

# ch/anna/events.rpy:702
translate russian anna_event_02_a3550b89:
    "Но я беспокоюсь, что это может испортить весь вечер, даже не успев начаться."

# ch/anna/events.rpy:703
translate russian anna_event_02_58fc69e7:
    "Поэтому я вставляю диск и приглушаю свет, стараясь игнорировать улыбку на лице Анны."

# ch/anna/events.rpy:704
translate russian anna_event_02_1d0cf2f9:
    "Скажу просто, что как только титры прокрутились, и мы переходим к основному сюжету, мне не приходится долго гадать, что происходит."

# ch/anna/events.rpy:705
translate russian anna_event_02_88f2a992:
    "Мне удается смотреть около двадцати минут, прежде чем я просто больше не могу это выдержать."

# ch/anna/events.rpy:707
translate russian anna_event_02_a777be76:
    "Не в силах сдерживаться ни секунды, я громко расхохотался, от чего Анна немного подпрыгнула."

# ch/anna/events.rpy:709
translate russian anna_event_02_9e122aab:
    "И тут же она присоединяется ко мне, уверенная, что я наконец-то понял, к чему она намекала."

# ch/anna/events.rpy:710
translate russian anna_event_02_b8afaa03:
    mike.say "Это... это самое ужасное, что я когда-либо видел!"

# ch/anna/events.rpy:711
translate russian anna_event_02_ac74a74f:
    anna.say "Я знаю, и ты мне об этом говори!"

# ch/anna/events.rpy:712
translate russian anna_event_02_5427982c:
    mike.say "Что с этой девчонкой, играющей главную героиню?"

# ch/anna/events.rpy:713
translate russian anna_event_02_e86b4839:
    mike.say "У нее на протяжении всего фильма лицо, как будто ей только что влетело!"

# ch/anna/events.rpy:715
translate russian anna_event_02_13a9ea99:
    anna.say "А что насчет вампира?"

# ch/anna/events.rpy:716
translate russian anna_event_02_8922b14e:
    anna.say "Ну что за воющая пизда, да?!"

# ch/anna/events.rpy:717
translate russian anna_event_02_f7a72e98:
    "Я качаю головой, наблюдая за тем, как на экране продолжают происходить все эти глупости."

# ch/anna/events.rpy:718
translate russian anna_event_02_297bb2c8:
    mike.say "Почему он гуляет днем?"

# ch/anna/events.rpy:719
translate russian anna_event_02_32a45fb9:
    mike.say "Разве вампиры не превращаются в пыль под прямыми солнечными лучами?"

# ch/anna/events.rpy:721
translate russian anna_event_02_5d39c4b8:
    anna.say "О нет, этот особенный экземпляр просто сверкает, будто весь в блёстках!"

# ch/anna/events.rpy:722
translate russian anna_event_02_1489a47f:
    "Это откровение снова заставило меня рассмеяться, я чуть не покатился со смеху, когда увидел, как это происходит на экране."

# ch/anna/events.rpy:723
translate russian anna_event_02_45a65948:
    mike.say "Я не думаю, что он настоящий вампир, Анна."

# ch/anna/events.rpy:725
translate russian anna_event_02_4e269f7c:
    anna.say "Хм... а почему ты так думаешь?"

# ch/anna/events.rpy:726
translate russian anna_event_02_ad69720a:
    mike.say "Ну да, он оставил вмятину на этой машине, но это мог сделать и кто-то под наркотиками!"

# ch/anna/events.rpy:727
translate russian anna_event_02_3f5542cf:
    mike.say "Он ходит днем, делает всякие вещи и при этом сверкает! Это же абсурд."

# ch/anna/events.rpy:728
translate russian anna_event_02_bd46fe48:
    mike.say "Я думаю, он просто подышал PCP в гей-клубе перед этим, вот и все!"

# ch/anna/events.rpy:730
translate russian anna_event_02_0116f082:
    "Анна буквально выплевывает из рта еду, которую она жевала."

# ch/anna/events.rpy:732
translate russian anna_event_02_30833c6c:
    "Она смеется так сильно, что мы уже не смотрим фильм ради самого фильма."

# ch/anna/events.rpy:733
translate russian anna_event_02_3171650d:
    "Раз уж мы испортили себе возможность досмотреть его с серьезным лицом, то просто тратим остаток времени на то, чтобы высмеивать его."

# ch/anna/events.rpy:734
translate russian anna_event_02_d26de2fc:
    "К концу вечера нам это понравилось больше, чем просмотр самого фильма."

# ch/anna/events.rpy:735
translate russian anna_event_02_1005d30d:
    mike.say "О боже... это было ужасно!"

# ch/anna/events.rpy:736
translate russian anna_event_02_05e46a06:
    mike.say "Наверное, они сняли только один фильм, и все?"

# ch/anna/events.rpy:738
translate russian anna_event_02_172f3e0e:
    anna.say "О нет, их сняли целую серию, и с каждым фильмом всё хуже!"

# ch/anna/events.rpy:739
translate russian anna_event_02_102c8dbb:
    mike.say "Ты шутишь!"

# ch/anna/events.rpy:740
translate russian anna_event_02_7f7e581b:
    "Анна качает головой, пытаясь сдержать смех."

# ch/anna/events.rpy:741
translate russian anna_event_02_cd75c634:
    anna.say "А я нет. Можно сделать это традицией: садиться и поливать их грязью!"

# ch/anna/events.rpy:742
translate russian anna_event_02_b289749c:
    "Теперь моя очередь качать головой в недоумении и ужасе."

# ch/anna/events.rpy:743
translate russian anna_event_02_fe2867c6:
    mike.say "Я не думаю, что смогу даже представить себе это, Анна!"

# ch/anna/events.rpy:744
translate russian anna_event_02_8064aafb:
    mike.say "В следующий раз, я думаю, тебе стоит выбирать фильм..."

# ch/anna/events.rpy:751
translate russian anna_event_03_57d20608:
    "Она замечает их раньше, чем я, и единственная причина, по которой я понимаю, что что-то происходит, заключается в том, что она кажется немного бледной, когда смотрит прямо на меня."

# ch/anna/events.rpy:752
translate russian anna_event_03_9c904efa:
    "Но когда я оглядываюсь, пытаясь понять, что могло вызвать ее беспокойство, я ничего не понимаю."

# ch/anna/events.rpy:753
translate russian anna_event_03_65cac2cc:
    mike.say "Анна, ты вся такая бледная!"

# ch/anna/events.rpy:754
translate russian anna_event_03_df886bc4:
    mike.say "Что случилось?"

# ch/anna/events.rpy:756
translate russian anna_event_03_4cf633b1:
    "Она уже отступает и пытается спрятаться за тем, что может служить укрытием, когда я задаю ей этот вопрос."

# ch/anna/events.rpy:757
translate russian anna_event_03_189a756d:
    "И она хватает меня за руку, тянет за собой, вместо того чтобы ответить на вопрос."

# ch/anna/events.rpy:758
translate russian anna_event_03_915fa6e3:
    anna.say "Ложись и следуй за мной, прямо сейчас!"

# ch/anna/events.rpy:759
translate russian anna_event_03_cac90dba:
    anna.say "И что бы ты ни делал, не оглядывайся..."

# ch/anna/events.rpy:760
translate russian anna_event_03_7dd2a7ce:
    "Но, конечно же, в тот самый момент, когда она это говорит, моя голова начинает поворачиваться в ту же сторону."

# ch/anna/events.rpy:761
translate russian anna_event_03_18d512cf:
    "Ничего не могу с собой поделать. Словно я не контролирую тело, которое делает прямо противоположное тому, что велела Анна."

# ch/anna/events.rpy:762
translate russian anna_event_03_44823df6:
    "Даже тогда я ничего не понимаю, потому что вижу только пару парней и девушку, которые, похоже, направляются к нам."

# ch/anna/events.rpy:763
translate russian anna_event_03_f4efcaa0:
    "Неужели они могут быть причиной того, что Анна так расстроена?"

# ch/anna/events.rpy:764
translate russian anna_event_03_8e260ece:
    "Они выглядят как обычные металлисты: длинные волосы, футболки с названиями групп, совершенно безобидные."

# ch/anna/events.rpy:765
translate russian anna_event_03_bfc87e1d:
    "Я не узнаю название, напечатанное на их футболках, и поэтому я стараюсь разглядеть, что это может быть."

# ch/anna/events.rpy:766
translate russian anna_event_03_cfff17a9:
    "Кто знает, может быть, у Анны просто патологическая неприязнь к этой группе, их музыке и даже к их фанатам."

# ch/anna/events.rpy:768
translate russian anna_event_03_fa942d46:
    "Но потом я наконец-то начинаю различать слова, и я тут же перестаю позволять Анне тянуть меня за собой."

# ch/anna/events.rpy:769
translate russian anna_event_03_bf1ef26a:
    mike.say "Эй, Анна, на них на всех футболки Deathless Harpies!"

# ch/anna/events.rpy:770
translate russian anna_event_03_1be4a1e2:
    mike.say "Так круто! Я даже не знал, что у нас есть футболки!"

# ch/anna/events.rpy:772
translate russian anna_event_03_946de6df:
    anna.say "Потому что их у нас нет!"

# ch/anna/events.rpy:774
translate russian anna_event_03_f1a7ee7b:
    "Мое лицо искажается от растерянности."

# ch/anna/events.rpy:775
translate russian anna_event_03_82ee7914:
    mike.say "А? Тогда откуда они у них?"

# ch/anna/events.rpy:776
translate russian anna_event_03_38a51f2c:
    mike.say "Может, кто-то еще украл название?"

# ch/anna/events.rpy:777
translate russian anna_event_03_683054f7:
    "Анна продолжает пытаться меня утащить, но безуспешно, благодаря моему весу. Она качает головой."

# ch/anna/events.rpy:778
translate russian anna_event_03_46eb2d03:
    anna.say "Нет, они сами их напечатали."

# ch/anna/events.rpy:779
translate russian anna_event_03_befec075:
    mike.say "Ого, должно быть, мы им ОЧЕНЬ нравимся!"

# ch/anna/events.rpy:780
translate russian anna_event_03_9c1da6ab:
    anna.say "Да, им мы очень нравимся."

# ch/anna/events.rpy:782
translate russian anna_event_03_944311f7:
    anna.say "В том-то и проблема: мы им нравимся СЛИШКОМ сильно!"

# ch/anna/events.rpy:784
translate russian anna_event_03_bb1869fc:
    mike.say "Что... я не понимаю!"

# ch/anna/events.rpy:785
translate russian anna_event_03_610bbcaf:
    mike.say "Как можно любить кого-то слишком сильно?"

# ch/anna/events.rpy:786
translate russian anna_event_03_ef70eb76:
    anna.say "Не волнуйся, [lssb_anna.hero_name()], сейчас сам всё узнаешь!"

# ch/anna/events.rpy:787
translate russian anna_event_03_6fc21726:
    "Я оглядываюсь вокруг, следуя за взглядом Анны, и почти сразу же понимаю, что, несмотря на все ее старания, нас заметили."

# ch/anna/events.rpy:788
translate russian anna_event_03_998d58aa:
    "Один из парней указывает на нас, хлопая своих товарищей по плечам и рукам."

# ch/anna/events.rpy:789
translate russian anna_event_03_8a062051:
    "И через мгновение они начинают сбиваться в толпу, направляясь к нам."

# ch/anna/events.rpy:790
translate russian anna_event_03_43ec06af:
    "Поклонник" "Эй-эй-эй, да тут половина Deathless Harpies!"

# ch/anna/events.rpy:791
translate russian anna_event_03_a801114b:
    "Поклонник" "Да еще и самая горячая барабанщица во всем мире металла!"

# ch/anna/events.rpy:792
translate russian anna_event_03_26a715c1:
    "Хотя издалека они казались безобидными, все они вторгаются в наше личное пространство, их лица находятся всего в нескольких сантиметрах от наших."

# ch/anna/events.rpy:794
translate russian anna_event_03_65345d73:
    "Я вижу и чувствую, как они начинают прикасаться ко мне, даже не подумав спросить, уместно ли это делать."

# ch/anna/events.rpy:795
translate russian anna_event_03_1f3fb224:
    "Это заставляет меня захотеть ударить одного из них по лицу или, по крайней мере, оттолкнуть его на несколько метров назад."

# ch/anna/events.rpy:796
translate russian anna_event_03_6b0f5af1:
    "И если это вызывает у меня такую реакцию, то для Анны, учитывая ее небольшой рост, должно быть еще хуже."

# ch/anna/events.rpy:798
translate russian anna_event_03_d774e9db:
    anna.say "Эм... привет... ребята..."

# ch/anna/events.rpy:799
translate russian anna_event_03_d462bdf5:
    "Поклонница" "Эй, кого ты называешь парнем?!"

# ch/anna/events.rpy:801
translate russian anna_event_03_805c1ef6:
    "Анна нервно улыбается в ответ на вызов девушки, явно чувствуя себя подавленной ее напористостью."

# ch/anna/events.rpy:802
translate russian anna_event_03_77b9f4d0:
    "Поклонница" "Не волнуйся, Анна. Я знаю, что многим из вас, девчонок на сцене, нравимся и мы, девчонки в зале!"

# ch/anna/events.rpy:806
translate russian anna_event_03_ec810cf1:
    "Когда девушка тянется, чтобы коснуться Анны, я не могу удержаться и инстинктивно встаю на ее пути."

# ch/anna/events.rpy:808
translate russian anna_event_03_3dfad59d:
    "И я без колебаний отбиваю руку, которую она протягивает к моей коллеге по группе."

# ch/anna/events.rpy:809
translate russian anna_event_03_6ff5e3ab:
    "Поклонница" "Ай! Эй, ты!"

# ch/anna/events.rpy:810
translate russian anna_event_03_4f23b469:
    "Поклонник" "Да, чувак, ты какого хрена творишь?!"

# ch/anna/events.rpy:811
translate russian anna_event_03_4ec9940f:
    "Поклонник" "Так нельзя! Deathless Harpies КАТЕГОРИЧЕСКИ против насилия над женщинами!"

# ch/anna/events.rpy:812
translate russian anna_event_03_1285595e:
    "Погодите, эти придурки сами к нам пристают и пытаются трогать Анну без её согласия."

# ch/anna/events.rpy:813
translate russian anna_event_03_726f518a:
    "И при этом они читают мне нотации о том, что я не понимаю моральную позицию группы, потому что остановил их от того, чтобы они, по сути, изнасиловали ее?"

# ch/anna/events.rpy:814
translate russian anna_event_03_53d09e4a:
    "Да пошли они все к черту!"

# ch/anna/events.rpy:816
translate russian anna_event_03_b018a26c:
    mike.say "Вы что, козлы, думаете: напечатали футболки — и теперь вам принадлежит часть нас?"

# ch/anna/events.rpy:817
translate russian anna_event_03_a5ebc189:
    "Я раньше этого не замечал, но я заметно выше большинства парней в группе."

# ch/anna/events.rpy:818
translate russian anna_event_03_24d14996:
    "Это значит, что они немного побаиваются меня, когда я стою над ними и делаю им замечания."

# ch/anna/events.rpy:819
translate russian anna_event_03_d75bbb09:
    "Надеюсь, они скоро не поймут, что я старше их и значительно превосхожу по численности!"

# ch/anna/events.rpy:820
translate russian anna_event_03_3f7555f5:
    "Поклонник" "Что... нет... мы бы никогда..."

# ch/anna/events.rpy:821
translate russian anna_event_03_5c8b81f6:
    "Поклонница" "Эй, прекрати пытаться переложить вину на нас, чувак!"

# ch/anna/events.rpy:822
translate russian anna_event_03_5da622bd:
    mike.say "И ещё один грёбаный вопрос: когда мы получили отчисления с этих футболок, а?"

# ch/anna/events.rpy:823
translate russian anna_event_03_bef68845:
    "Теперь они начинают немного отступать, смотря друг на друга в замешательстве."

# ch/anna/events.rpy:824
translate russian anna_event_03_7b107f46:
    "Поклонник" "О чем ты говоришь?"

# ch/anna/events.rpy:825
translate russian anna_event_03_3d832760:
    "Поклонница" "Мы ваши настоящие фанаты! Мы их заказали, чтобы это показать!"

# ch/anna/events.rpy:826
translate russian anna_event_03_d834cf48:
    mike.say "Какой же это фанат, который отбирает деньги у группы?"

# ch/anna/events.rpy:827
translate russian anna_event_03_0a25f223:
    mike.say "Эти футболки нарушают наши права на интеллектуальную собственность."

# ch/anna/events.rpy:828
translate russian anna_event_03_454980d2:
    mike.say "Вам повезло, что мы не подаем на вас в суд за кражу!"

# ch/anna/events.rpy:829
translate russian anna_event_03_d3ffd79c:
    "Поклонник" "Вы бы..."

# ch/anna/events.rpy:830
translate russian anna_event_03_d2661afc:
    mike.say "Попробуй, ублюдок!"

# ch/anna/events.rpy:831
translate russian anna_event_03_25702e58:
    "Честно говоря, я не знаю, действительно ли я их пугаю, или просто сбиваю с толку."

# ch/anna/events.rpy:832
translate russian anna_event_03_df8f28fc:
    "Но в любом случае, кажется, это оказывает желаемый эффект, потому что они начинают выглядеть обеспокоенными и отступают."

# ch/anna/events.rpy:833
translate russian anna_event_03_3d5995ea:
    "Поклонник" "Слушайте, мы не хотим никаких проблем!"

# ch/anna/events.rpy:834
translate russian anna_event_03_7853bb80:
    "Поклонница" "Да... мы просто фанаты, честно говоря!"

# ch/anna/events.rpy:835
translate russian anna_event_03_b984eab2:
    "Они поспешно и смущенно уходят, оставляя Анну и меня одних и снова невредимыми."

# ch/anna/events.rpy:837
translate russian anna_event_03_97e07d33:
    mike.say "Ты в порядке, Анна?"

# ch/anna/events.rpy:838
translate russian anna_event_03_4a2a2cd7:
    "Она кивает, смотрит на меня немного странно, и я начинаю беспокоиться, что она находится в состоянии шока."

# ch/anna/events.rpy:839
translate russian anna_event_03_835e6d84:
    mike.say "Я даже не представлял, что фанаты могут быть такими..."

# ch/anna/events.rpy:841
translate russian anna_event_03_8450fc39:
    "Анна качает головой, отвергая мою попытку извиниться."

# ch/anna/events.rpy:842
translate russian anna_event_03_356eee02:
    anna.say "Ты знаешь, как это бывает, когда у тебя есть небольшая, но преданная аудитория..."

# ch/anna/events.rpy:843
translate russian anna_event_03_bfc2d0f3:
    "Я киваю, не нуждаясь в дополнительных словах."

# ch/anna/events.rpy:844
translate russian anna_event_03_9dd59346:
    anna.say "Нет, что действительно застряло у меня в голове – это то, как ты говорил о подаче на них в суд."

# ch/anna/events.rpy:845
translate russian anna_event_03_f5d7e605:
    anna.say "Я никогда не видела, чтобы кто-то угрожал судебным иском, чтобы заставить целую группу парней отступить!"

# ch/anna/events.rpy:846
translate russian anna_event_03_11cbd795:
    "Я могу только нервно смеяться, радуясь, что все не пошло дальше."

# ch/anna/events.rpy:847
translate russian anna_event_03_82b89762:
    "В конце концов, у меня же нет команды высокооплачиваемых юристов под рукой!"

# ch/anna/events.rpy:849
translate russian anna_event_03_bb79c76c:
    "Я знаю, что должен вмешаться и заступиться за Анну."

# ch/anna/events.rpy:850
translate russian anna_event_03_859eb6e0:
    "Но во всей этой ситуации есть что-то настолько завораживающее."

# ch/anna/events.rpy:851
translate russian anna_event_03_8fe7bfa3:
    "Я не могу оторвать взгляд, наблюдая в тишине, как рука девушки тянется к Анне."

# ch/anna/events.rpy:853
translate russian anna_event_03_37a68111:
    "Точнее, протягивает руку и основательно хватает её за левую грудь!"

# ch/anna/events.rpy:856
translate russian anna_event_03_6d39ae15:
    anna.say "ЭЙ, ЭТО МОЯ ЧЕРТОВА ГРУДЬ!"

# ch/anna/events.rpy:857
translate russian anna_event_03_2f14a8b7:
    "Если быть честным со всеми участниками, поклонница мгновенно отскакивает, услышав внезапный крик Анны."

# ch/anna/events.rpy:858
translate russian anna_event_03_310d8818:
    "Её рука пробыла на груди Анны не больше пары секунд."

# ch/anna/events.rpy:859
translate russian anna_event_03_e8e71d10:
    "Но, похоже, этого было достаточно, чтобы нанести ущерб и придать смелости этим двум парням."

# ch/anna/events.rpy:860
translate russian anna_event_03_d1dfe9d6:
    "Поклонник" "Вау, ты получила щипок за грудь у барабанщицы!"

# ch/anna/events.rpy:861
translate russian anna_event_03_83d4b6b0:
    "Поклонник" "Нечестно! Deathless Harpies выступают за равенство полов!"

# ch/anna/events.rpy:863
translate russian anna_event_03_b589e673:
    "Прежде чем Анна успевает сказать хоть слово, еще две пары рук оказываются на ней."

# ch/anna/events.rpy:865
translate russian anna_event_03_eeb7ea1f:
    "Парни позволяют себе безжалостно давить грудь, и все это время они смеются от удовольствия."

# ch/anna/events.rpy:866
translate russian anna_event_03_f38b19a4:
    "Поклонница" "Эй, я потрогала их всего секунду!"

# ch/anna/events.rpy:867
translate russian anna_event_03_f38c1527:
    "И тут она присоединяется к действию, во второй раз за считанные секунды ощупывая грудь Анны."

# ch/anna/events.rpy:869
translate russian anna_event_03_117d1393:
    "Все это время они набрасываются на нее, Анна жалобно стонет и тщетно пытается отбиться."

# ch/anna/events.rpy:870
translate russian anna_event_03_424acbf7:
    "Она смотрит на меня в отчаянии, ее глаза умоляют меня спасти ее от их нежелательного внимания."

# ch/anna/events.rpy:871
translate russian anna_event_03_913b1cad:
    anna.say "Ах...больно!"

# ch/anna/events.rpy:872
translate russian anna_event_03_86fb6ccb:
    anna.say "[lssb_anna.hero_name()]...помоги мне...пожалуйста!"

# ch/anna/events.rpy:873
translate russian anna_event_03_5c73251d:
    "Я знаю, что не должен был позволить этому случиться, и я также понимаю, что пришло время вмешаться."

# ch/anna/events.rpy:874
translate russian anna_event_03_13a1f44b:
    "Но все равно я медлю, завороженный и немного возбужденный зрелищем того, как с Анной обращаются таким образом."

# ch/anna/events.rpy:875
translate russian anna_event_03_3c5e9a45:
    "Ее щеки ярко краснеют, и мне кажется, что я вижу, как в ее глазах начинают появляться слезы, пока она пытается защититься."

# ch/anna/events.rpy:876
translate russian anna_event_03_c313cd42:
    "Наконец, я больше не могу откладывать, и тянусь, чтобы схватить одну из рук Анны."

# ch/anna/events.rpy:877
translate russian anna_event_03_a22417b0:
    "Она кричит, когда я физически вытаскиваю ее оттуда, игнорируя протесты так называемых фанатов."

# ch/anna/events.rpy:878
translate russian anna_event_03_2fdc1c8d:
    "Как только мы оказываемся снаружи и я уверен, что они не следуют за нами, мы останавливаемся и оба делаем глубокий вдох, чтобы прийти в себя."

# ch/anna/events.rpy:880
translate russian anna_event_03_aac1f42a:
    anna.say "Спасибо, [lssb_anna.hero_name()]."

# ch/anna/events.rpy:881
translate russian anna_event_03_27c59b56:
    anna.say "Если бы ты не вытащила меня оттуда, когда ты это сделала, они могли бы раздеть меня там!"

# ch/anna/events.rpy:882
translate russian anna_event_03_d73d81f8:
    "Я киваю, пытаясь скрыть тот факт, что мысленное изображение, которое вызвала эта фраза, сейчас делает меня возбужденным."

# ch/anna/events.rpy:883
translate russian anna_event_03_ada81ff9:
    mike.say "Все в порядке, Анна."

# ch/anna/events.rpy:884
translate russian anna_event_03_45364383:
    mike.say "Я должен был остановить их раньше..."

# ch/anna/events.rpy:885
translate russian anna_event_03_0416a327:
    "Анна встретила это выражением сочувствия, что совсем не то, чего я ожидал от нее в ответ на мои действия."

# ch/anna/events.rpy:887
translate russian anna_event_03_92ae1d9c:
    anna.say "Не волнуйся, [lssb_anna.hero_name()], это вполне естественно."

# ch/anna/events.rpy:888
translate russian anna_event_03_cfeaed93:
    anna.say "Я тоже так замерла в первый раз, когда столкнулась с фанатами."

# ch/anna/events.rpy:890
translate russian anna_event_03_c9c2f72b:
    anna.say "Ты привыкнешь, поверь мне!"

# ch/anna/events.rpy:891
translate russian anna_event_03_84cc54dd:
    "Я слабо киваю головой, облегченно осознавая, что, кажется, избежал наказания за свою неудачу."

# ch/anna/events.rpy:892
translate russian anna_event_03_10bf4fe0:
    "Но тот факт, что Анна совершенно неправильно поняла мои действия, заставляет меня чувствовать себя немного виноватым..."

# ch/anna/events.rpy:893
translate russian anna_event_03_506dbccc:
    "Пытаясь подавить неприятные чувства, которые это у меня вызывает, я иду следом за Анной, которая начинает уходить от места происшествия."

# ch/anna/events.rpy:900
translate russian anna_event_04_21721793:
    mike.say "Что случилось, Анна?"

# ch/anna/events.rpy:902
translate russian anna_event_04_d9c6858c:
    "Я протягиваю ей напиток, удивляясь, увидев, как она сразу же выпивает больше половины его залпом."

# ch/anna/events.rpy:903
translate russian anna_event_04_ff4a9af1:
    anna.say "Эм, ничего... Просто я не осознавала, насколько сильно хочу пить!"

# ch/anna/events.rpy:904
translate russian anna_event_04_80746538:
    mike.say "Анна, ты ведь понимаешь, что врать у тебя ужасно получается?"

# ch/anna/events.rpy:905
translate russian anna_event_04_fffa08be:
    "Анна выглядит смущенной, и ей трудно скрыть ярко выраженный румянец, будучи пойманной с такой легкостью."

# ch/anna/events.rpy:906
translate russian anna_event_04_d43faa9e:
    anna.say "Ладно, ладно... Я просто увидела кого-то, с кем не хотела сталкиваться."

# ch/anna/events.rpy:908
translate russian anna_event_04_81448c60:
    mike.say "Судя по твоей реакции, это был либо один из твоих родителей, либо бывший!"

# ch/anna/events.rpy:909
translate russian anna_event_04_68133dc2:
    "Анна заметно вздрогнула от последнего варианта, снова выдавая себя."

# ch/anna/events.rpy:910
translate russian anna_event_04_9f8ce261:
    mike.say "Не переживай из-за того, что может появиться твой бывший."

# ch/anna/events.rpy:911
translate russian anna_event_04_93d47abf:
    mike.say "Я ему объясню, где раки зимуют, не беспокойся об этом."

# ch/anna/events.rpy:913
translate russian anna_event_04_3c314333:
    anna.say "А что насчет того, чтобы предложить ЕЙ уйти?"

# ch/anna/events.rpy:914
translate russian anna_event_04_a752d2d4:
    "Конечно, Анна уже говорила мне, что я был первым парнем, с которым она встречалась какое-то время."

# ch/anna/events.rpy:915
translate russian anna_event_04_f1998da5:
    "Я должен был догадаться, что вероятность встретить бывшую девушку ее бывшего партнера довольно высока."

# ch/anna/events.rpy:917
translate russian anna_event_04_7791c1c6:
    "Я пожимаю плечами, услышав новость о том, что я собираюсь познакомиться с предыдущей лесбийской партнершей Анны."

# ch/anna/events.rpy:918
translate russian anna_event_04_b983a760:
    mike.say "Без проблем, Анна. Ты никогда не скрывала, что тебе нравятся и парни, и девушки."

# ch/anna/events.rpy:919
translate russian anna_event_04_99d535be:
    mike.say "Это ничем не отличается от встречи с парнем, который когда-то встречался с тобой."

# ch/anna/events.rpy:921
translate russian anna_event_04_de7a6c4d:
    "Анна нервно смеется, но заметно облегчается."

# ch/anna/events.rpy:922
translate russian anna_event_04_97d9a67a:
    anna.say "Да, наверное, ты прав."

# ch/anna/events.rpy:923
translate russian anna_event_04_a4baef77:
    anna.say "Я просто хотела бы, чтобы Гвендолин была так же спокойна в таких вопросах, как ты!"

# ch/anna/events.rpy:926
translate russian anna_event_04_dfe9fd5c:
    "Мой стон настолько очевиден, что лицо Анны вытягивается от удивления."

# ch/anna/events.rpy:927
translate russian anna_event_04_f556daf3:
    anna.say "Что случилось, [lssb_anna.hero_name()]?"

# ch/anna/events.rpy:928
translate russian anna_event_04_28bcb3eb:
    anna.say "Я же тебе уже говорила, что мне нравятся и девушки, разве нет?"

# ch/anna/events.rpy:929
translate russian anna_event_04_bd2ec3cb:
    mike.say "Да-да, ладно. Но я не думал, что мне действительно придётся разгребать это дерьмо!"

# ch/anna/events.rpy:931
translate russian anna_event_04_591d0be0:
    "Анна выглядит расстроенной и смотрит вниз на свои ноги, избегая моего взгляда."

# ch/anna/events.rpy:932
translate russian anna_event_04_f447413c:
    anna.say "Ох, хорошо...прости...наверное."

# ch/anna/events.rpy:934
translate russian anna_event_04_ef123101:
    "Я собирался попросить Анну показать на эту женщину, когда увидел, как кто-то смотрит прямо на меня – это наверняка она."

# ch/anna/events.rpy:935
translate russian anna_event_04_7910719f:
    "Ее каштановые волосы обрамляют презрительное выражение лица, а в ее темных, сужающихся глазах – жесткий взгляд."

# ch/anna/events.rpy:938
translate russian anna_event_04_4bc9982b:
    anna.say "Эмм... привет, Гвендолин."

# ch/anna/events.rpy:940
translate russian anna_event_04_36fbbdfa:
    anna.say "Надо же, встретить тебя здесь! Каковы были шансы?"

# ch/anna/events.rpy:941
translate russian anna_event_04_4aa2ddf0:
    "Гвендолин почти не обращает внимания на Анну, пока та не заговорит."

# ch/anna/events.rpy:942
translate russian anna_event_04_c4095960:
    "Вместо этого она сверлит меня взглядом, как будто я что-то неприятное обнаружил на подошве своих двенадцатиразмерных ботинок."

# ch/anna/events.rpy:943
translate russian anna_event_04_5b63caf2:
    "Гвендолин" "Не гони, Анна. Это мой обычный бар. Мы раньше торчали тут каждый грёбаный вечер."

# ch/anna/events.rpy:945
translate russian anna_event_04_04d3f1e9:
    "Анна заметно вздрагивает от того, как грубо Гвендолин с ней разговаривает, словно это привычка."

# ch/anna/events.rpy:946
translate russian anna_event_04_331ab770:
    "Я сразу понимаю, почему она так расстроена из-за этой встречи."

# ch/anna/events.rpy:947
translate russian anna_event_04_78e714d9:
    "Гвендолин" "Значит, это тот ублюдок, которого ты теперь пускаешь к себе?"

# ch/anna/events.rpy:948
translate russian anna_event_04_2926161a:
    "Гвендолин" "Блин, Анна, по-моему, он даже хуже обмазанного дерьмом фаллоимитатора, найденного в унитазе."

# ch/anna/events.rpy:949
translate russian anna_event_04_53f0be0b:
    "Анна все еще не смотрит на Гвендолин, но бросает на меня отчаянный взгляд."

# ch/anna/events.rpy:950
translate russian anna_event_04_a46bb6ef:
    "Явно видно, что она ждет, пока я что-нибудь скажу в ответ."

# ch/anna/events.rpy:953
translate russian anna_event_04_8f4ece1c:
    "Не знаю, из-за ее размера или из-за оскорблений, которые она мне адресует, но я не могу сформулировать внятный ответ."

# ch/anna/events.rpy:954
translate russian anna_event_04_ba174a59:
    "Вместо этого я просто стою здесь, как рыба, выброшенная на берег."

# ch/anna/events.rpy:955
translate russian anna_event_04_ad72d210:
    "Гвендолин" "Что это за тип, какой-то чертов мутант или что?"

# ch/anna/events.rpy:957
translate russian anna_event_04_0993dde7:
    anna.say "[lssb_anna.hero_name()]... ты действительно позволишь ей так с тобой разговаривать?"

# ch/anna/events.rpy:958
translate russian anna_event_04_5a67bf2a:
    "Я молчу, чувствуя внезапное тепло, распространяющееся в области паха."

# ch/anna/events.rpy:959
translate russian anna_event_04_956c69ba:
    "Гвендолин" "Мне кажется, он собирается позволить мне так с ним разговаривать!"

# ch/anna/events.rpy:960
translate russian anna_event_04_24abf583:
    "Гвендолин" "Или, может быть, он ждет, пока он закончит мочиться себе на голову!"

# ch/anna/events.rpy:962
translate russian anna_event_04_35e4981a:
    "Я сталкивался с такими, как Гвендолин, раньше, и независимо от пола, они все одинаковы."

# ch/anna/events.rpy:963
translate russian anna_event_04_a3eb5dc1:
    "Они уважают только тех, кто готов отвечать тем же."

# ch/anna/events.rpy:964
translate russian anna_event_04_51cfe656:
    mike.say "Вау, я никогда не знал, что ты можешь так много дерьма наговорить!"

# ch/anna/events.rpy:967
translate russian anna_event_04_7f69cbf2:
    "Глаза Анны расширяются, а Гвендолин наклоняется вперед, чтобы злобно посмотреть на меня."

# ch/anna/events.rpy:968
translate russian anna_event_04_bde61da2:
    "Гвендолин" "Что ты сказал, одушевленный сперматозоид?"

# ch/anna/events.rpy:969
translate russian anna_event_04_5140e590:
    mike.say "Черт, что за хрень забралась к тебе в задницу и умерла, должно быть, ей понадобилось альпинистское снаряжение."

# ch/anna/events.rpy:971
translate russian anna_event_04_16fe4834:
    "Анна внезапно понимает, что я делаю, и начинает громко смеяться."

# ch/anna/events.rpy:972
translate russian anna_event_04_2540857b:
    "Гвендолин" "Эй, подожди!"

# ch/anna/events.rpy:973
translate russian anna_event_04_207ebae9:
    "Гвендолин заметно отступает, теперь она начинает сомневаться в себе."

# ch/anna/events.rpy:975
translate russian anna_event_04_52a0dc08:
    "Я встречал так много забияк, похожих на Гвендолин, что я совершенно не боюсь ее."

# ch/anna/events.rpy:978
translate russian anna_event_04_a04ce64d:
    mike.say "Почему ты рассталась с этой ходячей свиньей, Анна?"

# ch/anna/events.rpy:979
translate russian anna_event_04_40e63403:
    mike.say "Тебе просто недостаточно возбуждала перспектива трахать эту холодную суку в задницу?"

# ch/anna/events.rpy:982
translate russian anna_event_04_56b48f0b:
    "Анна ахает от искреннего удивления, а Гвендолин почти рычит от ярости из-за оскорбления."

# ch/anna/events.rpy:983
translate russian anna_event_04_0392363d:
    "Гвендолин" "Заткнись, придурок, а не то я..."

# ch/anna/events.rpy:984
translate russian anna_event_04_cea82741:
    mike.say "Или ты что?...Хм?...Растолчешь мне кости, чтобы сделать свой хлеб?"

# ch/anna/events.rpy:985
translate russian anna_event_04_75bd4777:
    mike.say "Прежде чем отвечать на это, позволь мне сказать тебе, что я очень, ОЧЕНЬ современный парень, сучка."

# ch/anna/events.rpy:986
translate russian anna_event_04_b052e3ae:
    mike.say "Не думай, что я сдерживаюсь, если ты начнешь на меня бросаться своими огромными обезьяньими руками!"

# ch/anna/events.rpy:987
translate russian anna_event_04_207ebae9_1:
    "Гвендолин заметно отступает, теперь она начинает сомневаться в себе."

# ch/anna/events.rpy:989
translate russian anna_event_04_a07b3037:
    "Как только Гвендолин уходит, и я снова остаюсь один с Анной, я понимаю, что мое сердце бешено колотится в груди."

# ch/anna/events.rpy:991
translate russian anna_event_04_4886ebb5:
    anna.say "[lssb_anna.hero_name()], ты будешь в порядке?"

# ch/anna/events.rpy:992
translate russian anna_event_04_a6ae26b9:
    mike.say "Да, не переживай за меня. Через минуту приду в себя."

# ch/anna/events.rpy:993
translate russian anna_event_04_739e0ef2:
    "Я не уверен, что Анна поверила моим успокоениям, но она больше ничего не говорит на эту тему."

# ch/anna/events.rpy:994
translate russian anna_event_04_9c6ad5f4:
    "Что бы она ни думала, когда мы снова устраиваемся, чтобы посмотреть выступление группы, я замечаю, что она смотрит на меня по-другому, чем обычно."

# ch/anna/events.rpy:995
translate russian anna_event_04_f10412c6:
    "Отведя взгляд, я случайно замечаю, как Гвендолин тоже смотрит на меня, с другой стороны комнаты."

# ch/anna/events.rpy:996
translate russian anna_event_04_b5f8fc8f:
    "Я не могу понять, о чем они на самом деле думают, но у них обоих взгляд направлен в мою сторону."

# ch/anna/events.rpy:997
translate russian anna_event_04_3928fc45:
    "Но у меня есть твердое ощущение, что это еще не конец недоделанным делам между ними."

# ch/anna/events.rpy:1005
translate russian anna_event_05_71105cbb:
    "Обычно я не тот, кто первым замечает потенциальные проблемы, но в этот раз я оказался проницательнее своей спутницы."

# ch/anna/events.rpy:1006
translate russian anna_event_05_77acbc36:
    "Анна – не самый высокий человек, поэтому ей мешают как предметы значительной высоты, так и толпы вокруг нас."

# ch/anna/events.rpy:1007
translate russian anna_event_05_ef44d914:
    "И, кроме того, проблема, которую мне удалось заметить, заключается практически в обратном – она возвышается над большинством людей."

# ch/anna/events.rpy:1008
translate russian anna_event_05_bc82243d:
    mike.say "Чёрт, вон там разве не Гвен, Анна?"

# ch/anna/events.rpy:1009
translate russian anna_event_05_1e28bba5:
    mike.say "Твоя противная бывшая девушка?"

# ch/anna/events.rpy:1011
translate russian anna_event_05_144ddd35:
    "Анна смотрит на меня с недоверием, а также с некоторым раздражением."

# ch/anna/events.rpy:1012
translate russian anna_event_05_7eeebaf6:
    "Как будто она разозлена и идеей о своей бывшей, и тем фактом, что я вижу то, чего не видит сейчас она."

# ch/anna/events.rpy:1014
translate russian anna_event_05_0d3e4f3f:
    anna.say "Ну как же я должна была знать, [lssb_anna.hero_name()]?"

# ch/anna/events.rpy:1015
translate russian anna_event_05_3d885ec2:
    anna.say "Залезть мне тебе на плечи, чтобы посмотреть?"

# ch/anna/events.rpy:1018
translate russian anna_event_05_7e917b1e:
    "Гвендолин" "Привет, Анна. Не заметила тебя там, внизу!"

# ch/anna/events.rpy:1020
translate russian anna_event_05_7303150d:
    "За то время, которое мы потратили на ссоры из-за нее, Гвен, должно быть, заметила меня и подошла."

# ch/anna/events.rpy:1021
translate russian anna_event_05_fb928fe2:
    "Теперь она стоит, скрестив руки, с таким видом, будто намерена вволю насладиться возможностью оскорбить нас обоих."

# ch/anna/events.rpy:1023
translate russian anna_event_05_3a35b21d:
    "Я сразу вижу, как Анна начинает съеживаться, как она всегда делает в присутствии Гвен."

# ch/anna/events.rpy:1024
translate russian anna_event_05_35cdf7e7:
    "У меня до сих пор нет ни малейшего представления о том, что эта женщина сделала с ней во время их отношений, потому что Анна не хочет мне говорить."

# ch/anna/events.rpy:1025
translate russian anna_event_05_20cf750e:
    "Но вид того, как она снова прячется от своей бывшей, только усиливает мое желание защитить ее."

# ch/anna/events.rpy:1026
translate russian anna_event_05_5bc1bd3f:
    mike.say "Это личный разговор, Гвен."

# ch/anna/events.rpy:1027
translate russian anna_event_05_34c0cb2d:
    mike.say "Здесь нет ничего, что было бы предназначено для твоих ушей."

# ch/anna/events.rpy:1028
translate russian anna_event_05_445d18c3:
    mike.say "И ни один из нас не хочет с тобой разговаривать."

# ch/anna/events.rpy:1030
translate russian anna_event_05_f63868ef:
    "Гвен поворачивается ко мне, пытаясь использовать тот факт, что она намного выше меня, чтобы получить преимущество."

# ch/anna/events.rpy:1031
translate russian anna_event_05_2e0f1c98:
    "Она улыбается снисходительно, делая вид, что не замечала меня до того, как я только что заговорил."

# ch/anna/events.rpy:1032
translate russian anna_event_05_dc4df597:
    "Гвендолин" "О, вот ты где!"

# ch/anna/events.rpy:1033
translate russian anna_event_05_e54b8e4b:
    "Гвендолин" "[lssb_anna.hero_name()], верно?"

# ch/anna/events.rpy:1034
translate russian anna_event_05_438e5add:
    "Гвендолин" "Извини, у меня нет привычки обращать внимание на крыс, которые приходят за моими объедками!"

# ch/anna/events.rpy:1035
translate russian anna_event_05_ae9b365e:
    mike.say "Забавно, ты так называешь Анну, да."

# ch/anna/events.rpy:1036
translate russian anna_event_05_7e08d578:
    mike.say "Но кажется, тебе самой трудно от нее оторваться, правда?"

# ch/anna/events.rpy:1037
translate russian anna_event_05_a04c6b48:
    "В ответ Гвен презрительно фыркает и кривит губы в мою сторону."

# ch/anna/events.rpy:1038
translate russian anna_event_05_60d733bb:
    "Она не собирается это признавать, но она знает, что я прав в этом вопросе."

# ch/anna/events.rpy:1039
translate russian anna_event_05_9ecff077:
    "Как бы она ни старалась, она не сможет продолжать притворяться, что забыла про Анну."

# ch/anna/events.rpy:1040
translate russian anna_event_05_84a03a79:
    "Если она сама не может удержаться от того, чтобы искать ее при любой возможности."

# ch/anna/events.rpy:1041
translate russian anna_event_05_bed931d9:
    "Гвендолин" "Ну... ладно, что угодно!"

# ch/anna/events.rpy:1042
translate russian anna_event_05_84bec2eb:
    "Гвендолин" "Так этот парень теперь говорит за тебя, Анна?"

# ch/anna/events.rpy:1043
translate russian anna_event_05_aa2f5567:
    "Гвендолин" "Когда ты потеряла дар речи?"

# ch/anna/events.rpy:1044
translate russian anna_event_05_684c57ac:
    "Хитрый ход: перегруппироваться и прицепиться к молчанию Анны, прикрыв этим собственный проигрыш в прошлом раунде."

# ch/anna/events.rpy:1045
translate russian anna_event_05_8f51c358:
    "Она также пытается посеять раздор между нами, намекая, что я не позволяю ей защищать себя."

# ch/anna/events.rpy:1046
translate russian anna_event_05_959811a1:
    "Эта девушка, должно быть, была настоящей головной болью, находиться рядом с ней постоянно!"

# ch/anna/events.rpy:1047
translate russian anna_event_05_94e56651:
    mike.say "Я не говорю от ее имени, Гвен."

# ch/anna/events.rpy:1048
translate russian anna_event_05_f46c0821:
    mike.say "Я говорю от своего имени."

# ch/anna/events.rpy:1049
translate russian anna_event_05_b5fdd6c5:
    mike.say "И сейчас я тоже говорю за себя: пошла нахер, а не то я тебя на задницу посажу!"

# ch/anna/events.rpy:1051
translate russian anna_event_05_8e91d8e8:
    "Впервые с тех пор, как она появилась, Гвен действительно выглядит обеспокоенной, делая шаг назад."

# ch/anna/events.rpy:1052
translate russian anna_event_05_72a07c19:
    "Я следую за ней, сокращая расстояние между нами, но стараясь не встать перед Анной, пока я это делаю."

# ch/anna/events.rpy:1053
translate russian anna_event_05_1ad57550:
    "Я хочу, чтобы Гвен поняла, что я веду себя так по своим собственным причинам, а не чтобы быть рыцарем в сияющих доспехах для Анны."

# ch/anna/events.rpy:1054
translate russian anna_event_05_7f138bae:
    "Гвендолин" "Ты...ты не можешь быть серьезным!"

# ch/anna/events.rpy:1055
translate russian anna_event_05_1c71d7bc:
    "Гвендолин" "Ты действительно...угрожаешь мне?!"

# ch/anna/events.rpy:1056
translate russian anna_event_05_19578f4b:
    "Я качаю головой, продолжая медленно приближаться к ней."

# ch/anna/events.rpy:1057
translate russian anna_event_05_6869c550:
    mike.say "Нет, Гвен."

# ch/anna/events.rpy:1058
translate russian anna_event_05_a3e391d5:
    mike.say "Угроза – это когда я говорю, что сделаю одно, если ты не сделаешь другое."

# ch/anna/events.rpy:1059
translate russian anna_event_05_638767c7:
    mike.say "Я же просто сделал констатацию факта."

# ch/anna/events.rpy:1060
translate russian anna_event_05_b28b4dee:
    mike.say "Я собираюсь пнуть тебя в задницу, и единственное, что ты можешь сделать с этим – это избежать этого, убежав."

# ch/anna/events.rpy:1062
translate russian anna_event_05_e3e83904:
    "Гвен выдает свое сомнение и страх, оглядываясь через плечо в поисках возможности сбежать, а затем быстро возвращается вперед."

# ch/anna/events.rpy:1063
translate russian anna_event_05_f3e35253:
    "Гвендолин" "Ты блефуешь...ты действительно не собираешься со мной драться!"

# ch/anna/events.rpy:1064
translate russian anna_event_05_a36ddbb2:
    mike.say "Потому что ты женщина?"

# ch/anna/events.rpy:1065
translate russian anna_event_05_2ca394f9:
    mike.say "Да брось, Гвен. На дворе двадцать первый век, а ты вполне здоровая, чтобы за себя постоять."

# ch/anna/events.rpy:1066
translate russian anna_event_05_adc660c1:
    mike.say "Если только тебе нравится обижать людей, которые меньше тебя, да?"

# ch/anna/events.rpy:1067
translate russian anna_event_05_0bee99c3:
    mike.say "В таком случае, ты хулиганка, и этого достаточно, чтобы преподать тебе урок..."

# ch/anna/events.rpy:1068
translate russian anna_event_05_677f0bae:
    "Несмотря на все мои слова, я чертовски боюсь того, что сейчас делаю."

# ch/anna/events.rpy:1069
translate russian anna_event_05_1870f9a3:
    "Я не хочу драться ни с кем, ни с мужчиной, ни с женщиной, тем более с такой крупной девушкой, как Гвен!"

# ch/anna/events.rpy:1070
translate russian anna_event_05_3b64baf7:
    "Она может быть мастером какого-нибудь боевого искусства или просто вырубить меня нахрен!"

# ch/anna/events.rpy:1071
translate russian anna_event_05_978716b8:
    "Моя единственная надежда – это заставить ее передумать."

# ch/anna/events.rpy:1072
translate russian anna_event_05_866f313d:
    "Гвендолин" "Серьёзно, чувак, у тебя какие-то больные заморочки!"

# ch/anna/events.rpy:1075
translate russian anna_event_05_091b1366:
    "И с этими словами она поворачивается ко мне спиной и исчезает в толпе."

# ch/anna/events.rpy:1076
translate russian anna_event_05_1a13b7a9:
    "Как только я убеждаюсь, что она достаточно далеко, я обмякаю, словно из моего тела выходит весь воздух."

# ch/anna/events.rpy:1077
translate russian anna_event_05_245e1b71:
    anna.say "Вау, [lssb_anna.hero_name()]!"

# ch/anna/events.rpy:1078
translate russian anna_event_05_fb2d4b42:
    anna.say "Ты действительно собиралась ее избить...ради меня?"

# ch/anna/events.rpy:1079
translate russian anna_event_05_45711d38:
    mike.say "Конечно, Анна. Для чего ещё нужны друзья?"

# ch/anna/events.rpy:1080
translate russian anna_event_05_239da37f:
    "Но даже когда я это говорю, взгляд благодарности в ее больших глазах заставляет меня хотеть большего."

# ch/anna/events.rpy:1086
translate russian anna_event_06_9f89cd74:
    "Я знаю, что Анна может быть рассеянной, иногда даже немного глуповатой, но мне это кажется милым и очаровательным в ней."

# ch/anna/events.rpy:1087
translate russian anna_event_06_2ba7cc21:
    "Но бывают моменты, когда она заходит слишком далеко, и тогда это начинает быстро раздражать."

# ch/anna/events.rpy:1088
translate russian anna_event_06_ad8554c6:
    "Сегодняшний вечер — отличный пример. Мы должны наслаждаться хорошим ужином в ещё более хорошем ресторане."

# ch/anna/events.rpy:1089
translate russian anna_event_06_64f73db8:
    "Я не устраиваю тут настоящий пир с шампанским и икрой, но я стараюсь сделать все, чтобы этот вечер был особенным."

# ch/anna/events.rpy:1090
translate russian anna_event_06_3e2a374c:
    "Анна же ведет себя так, будто присутствует здесь только физически, а ее мысли где-то далеко."

# ch/anna/events.rpy:1091
translate russian anna_event_06_bbbba64f:
    "Она почти ничего не съела, и из нее можно вытянуть только ответы \"да\" или \"нет\"."

# ch/anna/events.rpy:1092
translate russian anna_event_06_fd40de0e:
    "Я откашливаюсь, а потом начинаю издавать еще более явные звуки раздражения, но все бесполезно."

# ch/anna/events.rpy:1094
translate russian anna_event_06_86cb575f:
    mike.say "Как тебе еда, Анна?"

# ch/anna/events.rpy:1095
translate russian anna_event_06_8836db46:
    anna.say "Хм...А, да, точно."

# ch/anna/events.rpy:1096
translate russian anna_event_06_858acd01:
    mike.say "Моё на вкус как жжёная резина. А твоё?"

# ch/anna/events.rpy:1097
translate russian anna_event_06_93fc000b:
    anna.say "Ммм...Как романтично."

# ch/anna/events.rpy:1098
translate russian anna_event_06_8b74af3e:
    mike.say "Я попросил официанта принести тебе жареную собаку."

# ch/anna/events.rpy:1099
translate russian anna_event_06_8850d53c:
    mike.say "Я знаю, что ты очень любишь есть \"лучшего друга человека\"."

# ch/anna/events.rpy:1100
translate russian anna_event_06_6de21f6a:
    anna.say "Да..."

# ch/anna/events.rpy:1102
translate russian anna_event_06_9dbfe3e7:
    anna.say "Постой...что?!"

# ch/anna/events.rpy:1103
translate russian anna_event_06_4019a7fa:
    "Впервые с тех пор, как мы сели за стол, Анна выглядит так, будто она действительно вернулась в эту комнату со мной."

# ch/anna/events.rpy:1105
translate russian anna_event_06_c5cc7e8f:
    "Я качаю головой, хотя бы рад, что мне не пришлось вставать и танцевать, чтобы вернуть ее к реальности."

# ch/anna/events.rpy:1106
translate russian anna_event_06_c8fb51ef:
    mike.say "Мне кажется, я должен был задать этот вопрос, Анна."

# ch/anna/events.rpy:1107
translate russian anna_event_06_70c1792f:
    mike.say "Что с тобой сегодня вечером?"

# ch/anna/events.rpy:1108
translate russian anna_event_06_a19e446b:
    mike.say "Кажется, ты совсем не в себе."

# ch/anna/events.rpy:1110
translate russian anna_event_06_0f9df78b:
    "Щеки Анны слегка покраснели, когда она осознала, что наделала."

# ch/anna/events.rpy:1111
translate russian anna_event_06_af9571b9:
    "Это говорит мне о том, что она была еще более обеспокоена, чем я думал."

# ch/anna/events.rpy:1112
translate russian anna_event_06_29d67ea3:
    "И тот факт, что она понятия не имела, что делает, немного смягчает мое настроение."

# ch/anna/events.rpy:1113
translate russian anna_event_06_ba058b23:
    "В конце концов, если у нее на уме что-то настолько серьезное, то последнее, что ей нужно, это чтобы я все ухудшил."

# ch/anna/events.rpy:1114
translate russian anna_event_06_5f199c14:
    anna.say "О, [lssb_anna.hero_name()]..."

# ch/anna/events.rpy:1115
translate russian anna_event_06_be7fe246:
    anna.say "Прости, я испортила наше свидание!"

# ch/anna/events.rpy:1116
translate russian anna_event_06_e7381520:
    mike.say "Эй-эй, всё нормально, Анна."

# ch/anna/events.rpy:1117
translate russian anna_event_06_73970def:
    mike.say "Ты ничего не испортила."

# ch/anna/events.rpy:1118
translate russian anna_event_06_7ae43744:
    mike.say "Я просто беспокоюсь о тебе, вот и все."

# ch/anna/events.rpy:1120
translate russian anna_event_06_e3841b35:
    "Анна пытается улыбнуться, хотя ее улыбка получается слабой, и она начинает немного оттаивать."

# ch/anna/events.rpy:1122
translate russian anna_event_06_9098410f:
    mike.say "Ты можешь мне рассказать, что случилось, Анна."

# ch/anna/events.rpy:1123
translate russian anna_event_06_52fed45a:
    mike.say "Проблемы легче решать вместе, ты знаешь..."

# ch/anna/events.rpy:1124
translate russian anna_event_06_15aa0a18:
    anna.say "Хорошо, [lssb_anna.hero_name()], если ты так говоришь."

# ch/anna/events.rpy:1125
translate russian anna_event_06_293f92f2:
    anna.say "У меня, знаешь ли, произошел конфликт... с Клео."

# ch/anna/events.rpy:1127
translate russian anna_event_06_a71b6a6a:
    "Теперь понятно, почему Клео не захотела сегодня вечером идти с нами."

# ch/anna/events.rpy:1128
translate russian anna_event_06_c02959eb:
    "Если подумать, она даже не придумала правдоподобного оправдания."

# ch/anna/events.rpy:1129
translate russian anna_event_06_872fda07:
    "Значит, между ними был серьезный разлад!"

# ch/anna/events.rpy:1130
translate russian anna_event_06_63f29b75:
    "Тем более, мне нужно постараться быть миротворцем."

# ch/anna/events.rpy:1131
translate russian anna_event_06_f496f3b1:
    "Я совсем не хочу, чтобы у них возникли такие плохие отношения, что это разрушит нашу компанию из трех человек!"

# ch/anna/events.rpy:1133
translate russian anna_event_06_103a222c:
    "Понятно. Я уже видел и слышал, каково это — попасть под раздачу Клео!"

# ch/anna/events.rpy:1134
translate russian anna_event_06_cebbdfbf:
    "И Анна никогда не была самой напористой девушкой."

# ch/anna/events.rpy:1135
translate russian anna_event_06_06c434c1:
    "Трудно представить, чтобы она смогла отстоять свою точку зрения в споре между ними двумя."

# ch/anna/events.rpy:1136
translate russian anna_event_06_671a8c0a:
    "Думаю, я просто вижу последствия того, что ей пришлось выслушать."

# ch/anna/events.rpy:1137
translate russian anna_event_06_45bbe337:
    mike.say "Ну, с такой, как Клео, поссориться нетрудно, правда?"

# ch/anna/events.rpy:1138
translate russian anna_event_06_53e72c58:
    mike.say "Из-за чего вы поругались?"

# ch/anna/events.rpy:1140
translate russian anna_event_06_a78c8332:
    "Только сейчас я замечаю, как на лице Анны появляется оттенок гнева и раздражения."

# ch/anna/events.rpy:1141
translate russian anna_event_06_1094b7df:
    "Сначала я думаю, не сказал ли я что-то не то."

# ch/anna/events.rpy:1142
translate russian anna_event_06_398de324:
    "Но потом понимаю, что она, наверное, злится из-за воспоминаний об этом споре."

# ch/anna/events.rpy:1144
translate russian anna_event_06_c922532f:
    anna.say "Ты не поверишь, [lssb_anna.hero_name()]."

# ch/anna/events.rpy:1145
translate russian anna_event_06_90563b1d:
    anna.say "Но эта сука на самом деле сказала, что я слишком кроткая... слишком кроткая и застенчивая!"

# ch/anna/events.rpy:1146
translate russian anna_event_06_01b723d0:
    "Мне очень трудно сдержаться от того, чтобы не высказать очевидное и не согласиться с Клео."

# ch/anna/events.rpy:1147
translate russian anna_event_06_8bf7dc56:
    "Но вместо этого я закусываю губу, киваю головой в знак согласия и сочувствия."

# ch/anna/events.rpy:1148
translate russian anna_event_06_3d4bae70:
    anna.say "Я имею в виду... ты можешь поверить, что она вообще такое сказала?!"

# ch/anna/events.rpy:1153
translate russian anna_event_06_40d41900:
    "То, что я скажу дальше, может привести к тому, что мне отрубят важную часть моего тела."

# ch/anna/events.rpy:1154
translate russian anna_event_06_a57a8670:
    "Но есть большая часть меня, которая считает, что сейчас не время избегать болезненной правды."

# ch/anna/events.rpy:1155
translate russian anna_event_06_09d7404c:
    mike.say "Ах, Анна..."

# ch/anna/events.rpy:1156
translate russian anna_event_06_50e68e27:
    mike.say "Ты когда-нибудь думала, что Клео может быть права?"

# ch/anna/events.rpy:1157
translate russian anna_event_06_cf7cac5f:
    "Требуется несколько секунд, чтобы то, что я только что сказал, полностью осозналось."

# ch/anna/events.rpy:1158
translate russian anna_event_06_a516a663:
    "И когда это происходит, я вижу, как глаза Анны расширяются от удивления."

# ch/anna/events.rpy:1160
translate russian anna_event_06_f12c0719:
    anna.say "Что...что?"

# ch/anna/events.rpy:1161
translate russian anna_event_06_c1791ed3:
    anna.say "Ты...ты думаешь, что она права?"

# ch/anna/events.rpy:1162
translate russian anna_event_06_22cfeea3:
    "Я поднимаю руки, надеясь остановить Анну от того, чтобы она рухнула в пропасть отчаяния до того, как придет чек."

# ch/anna/events.rpy:1164
translate russian anna_event_06_53fca2b1:
    "Если я правильно сформулирую следующий момент, я уверен, что смогу спасти это дело от катастрофы."

# ch/anna/events.rpy:1165
translate russian anna_event_06_2024535d:
    mike.say "Нет, Анна, нет, я не это имею в виду."

# ch/anna/events.rpy:1166
translate russian anna_event_06_f6a9ca26:
    mike.say "Ты же знаешь, какая она, Клео, верно?"

# ch/anna/events.rpy:1167
translate russian anna_event_06_12a8e730:
    mike.say "Она должна делать все, что говорит, максимально драматично."

# ch/anna/events.rpy:1169
translate russian anna_event_06_7c45a96a:
    anna.say "Да, но ты же сказал, что она права!"

# ch/anna/events.rpy:1171
translate russian anna_event_06_29faacf5:
    mike.say "Нет, Анна. Я сказал, что в её словах может быть доля правды."

# ch/anna/events.rpy:1172
translate russian anna_event_06_58b13dc2:
    mike.say "Ты иногда можешь быть немного тихой, знаешь?"

# ch/anna/events.rpy:1173
translate russian anna_event_06_f2c8aca0:
    anna.say "Ты думаешь, я какая-то маленькая мышка или что-то в этом роде?"

# ch/anna/events.rpy:1174
translate russian anna_event_06_b604e0b3:
    mike.say "И опять нет. Просто ты немного застенчивая, вот и всё."

# ch/anna/events.rpy:1175
translate russian anna_event_06_d9ddc82f:
    "Я протягиваю руку через стол и беру ее руку в свою."

# ch/anna/events.rpy:1176
translate russian anna_event_06_0b983024:
    mike.say "Все, что я пытаюсь сказать, Анна, это то, что у тебя есть свой голос."

# ch/anna/events.rpy:1177
translate russian anna_event_06_40a99d18:
    mike.say "И я не думаю, что было бы плохо, если бы ты им пользовалась."

# ch/anna/events.rpy:1178
translate russian anna_event_06_48e700fd:
    "Хотя она, кажется, не совсем убеждена, Анна все равно кивает в ответ."

# ch/anna/events.rpy:1179
translate russian anna_event_06_3e162ca0:
    anna.say "Я...эм...я не знаю, [lssb_anna.hero_name()]."

# ch/anna/events.rpy:1183
translate russian anna_event_06_26feab61:
    "Я знаю, что у Клео есть свои основания, ведь Анна может быть такой застенчивой, как маленькая мышка, в худшем случае."

# ch/anna/events.rpy:1184
translate russian anna_event_06_767d0c4d:
    "Но это не дает ей права подавлять Анну своими мнениями."

# ch/anna/events.rpy:1185
translate russian anna_event_06_68c7bf21:
    mike.say "Боже мой, Анна..."

# ch/anna/events.rpy:1186
translate russian anna_event_06_e8d39ac9:
    mike.say "Эта ее рот однажды доставит Клео массу проблем."

# ch/anna/events.rpy:1188
translate russian anna_event_06_90ba42be:
    "Я вижу, как надежда вспыхивает в глазах Анны, и я не могу удержаться от того, чтобы покачать головой."

# ch/anna/events.rpy:1189
translate russian anna_event_06_ec704fda:
    "Довольно очевидно, что она искала союзника против Клео в этом вопросе."

# ch/anna/events.rpy:1190
translate russian anna_event_06_b50f149b:
    anna.say "Да, это точно!"

# ch/anna/events.rpy:1191
translate russian anna_event_06_97529d95:
    anna.say "Откуда у нее такая наглость разговаривать со мной так?"

# ch/anna/events.rpy:1192
translate russian anna_event_06_a6e1b691:
    "Я перестаю качать головой и начинаю кивать."

# ch/anna/events.rpy:1193
translate russian anna_event_06_7bcc8033:
    "Но часть меня не может не задаться вопросом, почему Анна не может быть такой раздраженной и по отношению к кому-то вроде Клео."

# ch/anna/events.rpy:1194
translate russian anna_event_06_8134c716:
    mike.say "Это же типичная Клео, Анна."

# ch/anna/events.rpy:1195
translate russian anna_event_06_13c34e55:
    mike.say "Она просто не понимает, что не все такие, как она."

# ch/anna/events.rpy:1196
translate russian anna_event_06_414be6dc:
    mike.say "Да, она уверенная в себе, прямолинейная и знает, чего хочет."

# ch/anna/events.rpy:1197
translate russian anna_event_06_30aa8009:
    mike.say "Но ты совсем другая, Анна."

# ch/anna/events.rpy:1198
translate russian anna_event_06_74fdc232:
    anna.say "Эм... да... наверное."

# ch/anna/events.rpy:1199
translate russian anna_event_06_41616660:
    mike.say "Некоторые люди просто не любят конфликты."

# ch/anna/events.rpy:1200
translate russian anna_event_06_d936c776:
    mike.say "Им и не обязательно быть в центре внимания, понимаешь?"

# ch/anna/events.rpy:1201
translate russian anna_event_06_e8ed5912:
    "Анна опускает взгляд на колени, и я понимаю, что, возможно, приуменьшил ее уникальные качества."

# ch/anna/events.rpy:1202
translate russian anna_event_06_a479d578:
    mike.say "Они гораздо глубже, чем кажется, ты понимаешь?"

# ch/anna/events.rpy:1203
translate russian anna_event_06_39922708:
    mike.say "Это не просто пустая оболочка, которая создает много шума."

# ch/anna/events.rpy:1205
translate russian anna_event_06_965027d8:
    anna.say "А... мои барабаны довольно громкие, знаешь ли..."

# ch/anna/events.rpy:1206
translate russian anna_event_06_88d12002:
    mike.say "Я не имею в виду это буквально, Анна!"

# ch/anna/events.rpy:1208
translate russian anna_event_06_eba811b7:
    anna.say "О...прости, [lssb_anna.hero_name()]!"

# ch/anna/events.rpy:1210
translate russian anna_event_06_8c5ffec6:
    "Мы оба пытаемся забыть об этом на остаток трапезы."

# ch/anna/events.rpy:1211
translate russian anna_event_06_7edcba13:
    "Но, несмотря на все наши усилия, эта тема по-прежнему висит в воздухе."

# ch/anna/events.rpy:1212
translate russian anna_event_06_98d5141b:
    "И часть меня думает, что никакие слова между нами не смогут разрешить этот вопрос."

# ch/anna/events.rpy:1218
translate russian anna_event_07_ef96c98c:
    "Признаюсь, я некоторое время ждал, когда Анна и Клео начнут говорить, и \"бомба\" взорвется."

# ch/anna/events.rpy:1219
translate russian anna_event_07_3595c62c:
    "Некоторое время я чувствовал себя человеком, заткнувшим уши, боясь неизбежного взрыва."

# ch/anna/events.rpy:1220
translate russian anna_event_07_eed127d8:
    "Поэтому, когда я наконец получаю звонок от Анны, я отвечаю на него с вполне понятными чувствами тревоги."

# ch/anna/events.rpy:1221
translate russian anna_event_07_dba73d0d:
    mike.say "Эм... привет, Анна."

# ch/anna/events.rpy:1222
translate russian anna_event_07_47366b2a:
    mike.say "Что случилось?"

# ch/anna/events.rpy:1223
translate russian anna_event_07_47388626:
    anna.say "Ой, [lssb_anna.hero_name()], по голосу ты совсем перепуган!"

# ch/anna/events.rpy:1224
translate russian anna_event_07_a475dc92:
    anna.say "Ты в порядке?"

# ch/anna/events.rpy:1225
translate russian anna_event_07_bba64a22:
    mike.say "Да, Анна, я в порядке."

# ch/anna/events.rpy:1226
translate russian anna_event_07_b996aca0:
    mike.say "Ну... как всё прошло с Клео?"

# ch/anna/events.rpy:1227
translate russian anna_event_07_fc094a06:
    "Я ожидал долгой тишины, а затем, возможно, еще одного раунда драмы."

# ch/anna/events.rpy:1228
translate russian anna_event_07_da1770a0:
    "Но потом Анна удивляет меня, начиная говорить восторженным тоном."

# ch/anna/events.rpy:1229
translate russian anna_event_07_db1a0b48:
    anna.say "Ой, это!"

# ch/anna/events.rpy:1230
translate russian anna_event_07_6f0c8e76:
    "Хм, она говорит так, будто в этом ничего особенного не было!"

# ch/anna/events.rpy:1231
translate russian anna_event_07_609af4cc:
    anna.say "Все уже позади."

# ch/anna/events.rpy:1232
translate russian anna_event_07_7f772739:
    anna.say "Клео сейчас здесь, со мной!"

# ch/anna/events.rpy:1233
translate russian anna_event_07_d49c216f:
    kleio.say "Привет, красавчик!"

# ch/anna/events.rpy:1234
translate russian anna_event_07_c3b54d75:
    "Я слышу голос Клео, когда она наклоняется ближе к Анне."

# ch/anna/events.rpy:1235
translate russian anna_event_07_755d44a4:
    anna.say "Мы хотим встретиться с тобой, [lssb_anna.hero_name()]."

# ch/anna/events.rpy:1236
translate russian anna_event_07_2a1b2d36:
    anna.say "Чтобы мы могли лично тебе поблагодарить!"

# ch/anna/events.rpy:1237
translate russian anna_event_07_09f6bc1b:
    mike.say "Ладно, Анна, думаю, это не проблема."

# ch/anna/events.rpy:1239
translate russian anna_event_07_4a50d672:
    "Вот так я оказываюсь в назначенном месте, ожидая появления Анны и Клео."

# ch/anna/events.rpy:1243
translate russian anna_event_07_9f115782:
    "И к моему большому облегчению, они появляются с опозданием, но идут рука об руку."

# ch/anna/events.rpy:1244
translate russian anna_event_07_32418493:
    "На самом деле, я давно не видел, чтобы они были такими расслабленными вместе."

# ch/anna/events.rpy:1245
translate russian anna_event_07_4cca835f:
    "Как только она меня видит, Анна радостно машет рукой."

# ch/anna/events.rpy:1247
translate russian anna_event_07_cca4323b:
    anna.say "Привет, [lssb_anna.hero_name()]!"

# ch/anna/events.rpy:1250
translate russian anna_event_07_ab4786ed:
    kleio.say "Что такое, член обмяк, пока ждал?"

# ch/anna/events.rpy:1252
translate russian anna_event_07_84288a52:
    mike.say "Ха-ха, Клео, очень смешно."

# ch/anna/events.rpy:1253
translate russian anna_event_07_aa324346:
    mike.say "Вообще-то я больше беспокоился о вас двоих."

# ch/anna/events.rpy:1255
translate russian anna_event_07_6a847e59:
    "Клео усмехается в ответ, отмахиваясь от моей заботы, как это ей свойственно."

# ch/anna/events.rpy:1256
translate russian anna_event_07_5a8a5d4d:
    "Но Анна быстро приходит мне на помощь и шлепает подругу по руке."

# ch/anna/events.rpy:1257
translate russian anna_event_07_20c32dd3:
    anna.say "Эй, Клео, не груби!"

# ch/anna/events.rpy:1258
translate russian anna_event_07_6fdfe6bc:
    anna.say "Если бы не [lssb_anna.hero_name()], мы бы до сих пор дрались!"

# ch/anna/events.rpy:1259
translate russian anna_event_07_e103faf2:
    "Клео отмахивается от ее слов."

# ch/anna/events.rpy:1260
translate russian anna_event_07_6ed1c5a7:
    "Но я достаточно хорошо знаю эту высокую девушку, чтобы почувствовать, что ее настроение смягчилось."

# ch/anna/events.rpy:1261
translate russian anna_event_07_b70f9ed9:
    kleio.say "Да ладно тебе, Анна, не паникуй!"

# ch/anna/events.rpy:1262
translate russian anna_event_07_a0119bbd:
    kleio.say "Я просто его подкалываю."

# ch/anna/events.rpy:1263
translate russian anna_event_07_1d02f5bc:
    anna.say "Ну, ты могла бы хотя бы сделать вид, что тебе жаль, Клео."

# ch/anna/events.rpy:1265
translate russian anna_event_07_ee15d048:
    "Клео смотрит на нее на мгновение, словно удивленная настойчивостью Анны."

# ch/anna/events.rpy:1267
translate russian anna_event_07_a4f683da:
    kleio.say "Спасибо, [lssb_anna.hero_name()]."

# ch/anna/events.rpy:1269
translate russian anna_event_07_e2cee674:
    kleio.say "Ну вот, Анна. Теперь довольна?"

# ch/anna/events.rpy:1270
translate russian anna_event_07_08ef07df:
    "Я сам очень удивлен."

# ch/anna/events.rpy:1273
translate russian anna_event_07_566aaf54:
    "Это ли мое первое знакомство с более напористой версией Анны?"

# ch/anna/events.rpy:1274
translate russian anna_event_07_8e02414e:
    anna.say "Это только начало, Клео."

# ch/anna/events.rpy:1276
translate russian anna_event_07_04bf9aac:
    mike.say "Всё нормально, девчонки, не нужно меня благодарить."

# ch/anna/events.rpy:1277
translate russian anna_event_07_d2bb77c0:
    mike.say "Всё, чего я когда-либо хотел – это чтобы ты забыла обиду."

# ch/anna/events.rpy:1278
translate russian anna_event_07_ea782e12:
    "Анна кивает, и даже Клео пожимает плечами в знак согласия."

# ch/anna/events.rpy:1279
translate russian anna_event_07_307c0a5e:
    anna.say "И самое замечательное: если мы снова поссоримся, можно просто позвонить тебе, [lssb_anna.hero_name()]!"

# ch/anna/events.rpy:1281
translate russian anna_event_07_d861d574:
    "Анна подчеркивает это, внезапно обнимая меня."

# ch/anna/events.rpy:1282
translate russian anna_event_07_3f0108a8:
    "Когда она крепко прижимает меня к себе, я поднимаю глаза на Клео в тихом отчаянии."

# ch/anna/events.rpy:1283
translate russian anna_event_07_754a1745:
    "Но в ответ я вижу только выражение лица, которое, кажется, говорит: \"Ты сломал – ты и плати\"."

# ch/anna/events.rpy:1285
translate russian anna_event_07_46a8b394:
    mike.say "Если бы это произошло, то, увидев вас двоих вместе, я сразу же почувствовал облегчение!"

# ch/anna/events.rpy:1288
translate russian anna_event_07_bf1f61bf:
    "Этот комментарий вызывает довольно грязный смешок у Клео, когда она подходит ближе."

# ch/anna/events.rpy:1289
translate russian anna_event_07_031cd910:
    "Анна ахает от удивления, но я вижу похожую реакцию в ее глазах."

# ch/anna/events.rpy:1291
translate russian anna_event_07_7c7ed71c:
    kleio.say "Ну да, ты не единственный, Любовник."

# ch/anna/events.rpy:1292
translate russian anna_event_07_f4a9546b:
    kleio.say "Я сейчас так мокрая, что чувствую, будто намочила трусы!"

# ch/anna/events.rpy:1295
translate russian anna_event_07_9cdb6003:
    "И тут же она обнимает меня за шею и целует в губы."

# ch/anna/events.rpy:1296
translate russian anna_event_07_07c693db:
    "Даже в этот момент я чувствую, как Анна тоже проникает в объятия."

# ch/anna/events.rpy:1298
translate russian anna_event_07_58070730:
    anna.say "Эй, вы двое, обо мне не забывайте!"

# ch/anna/events.rpy:1299
translate russian anna_event_07_5a7e8ddf:
    anna.say "Если тут предлагают секс в знак примирения, моя попка тоже хочет поучаствовать!"

# ch/anna/events.rpy:1301
translate russian anna_event_07_33247b47:
    kleio.say "Блядь, Анна, ах ты маленькая развратница!"

# ch/anna/events.rpy:1304
translate russian anna_event_07_74bb9507:
    "Как бы тяжело это ни было, я заставляю себя немного отстраниться."

# ch/anna/events.rpy:1305
translate russian anna_event_07_3e5dd078:
    mike.say "Эй, стоп, ребята."

# ch/anna/events.rpy:1306
translate russian anna_event_07_f72967d3:
    mike.say "Судя по всему этому сдерживаемому либидо, у вас теперь всё хорошо?"

# ch/anna/events.rpy:1309
translate russian anna_event_07_22390131:
    "Анна и Клейо на мгновение переглядываются, обе выглядят немного виноватыми."

# ch/anna/events.rpy:1310
translate russian anna_event_07_015fb7c9:
    anna.say "Да, [lssb_anna.hero_name()], мы все уладили."

# ch/anna/events.rpy:1311
translate russian anna_event_07_3f49bbef:
    kleio.say "Конечно, как только Анна признала, что во всём виновата она!"

# ch/anna/events.rpy:1313
translate russian anna_event_07_0ee90182:
    anna.say "КЛЕЙО!!!"

# ch/anna/events.rpy:1316
translate russian anna_event_07_befffba9:
    kleio.say "Ладно, ладно..."

# ch/anna/events.rpy:1317
translate russian anna_event_07_670afaf7:
    kleio.say "Не паникуй!"

# ch/anna/events.rpy:1319
translate russian anna_event_07_a66d07e9:
    kleio.say "Да, мы все решили, конечно."

# ch/anna/events.rpy:1320
translate russian anna_event_07_ae2d7640:
    "Я изо всех сил стараюсь не расслабиться и не выдохнуть с облегчением, услышав это."

# ch/anna/events.rpy:1321
translate russian anna_event_07_04076708:
    mike.say "Здорово, девчонки. Правда, здорово."

# ch/anna/events.rpy:1322
translate russian anna_event_07_ec19164d:
    mike.say "А что я слышал про секс для примирения?"

# ch/anna/events.rpy:1332
translate russian anna_event_08_71a1c348:
    "Странно, понимаете, как вы никогда не делаете шаг назад и не осознаете, что все идет хорошо."

# ch/anna/events.rpy:1333
translate russian anna_event_08_dd74907f:
    "Думаю, в тот момент, когда это происходит, вы настолько поглощены моментом, что не можете отстраниться."

# ch/anna/events.rpy:1334
translate russian anna_event_08_1a8dfb49:
    "Только позже у меня появляется возможность подумать о том, как мне было хорошо, сколько времени я провел, смеясь."

# ch/anna/events.rpy:1335
translate russian anna_event_08_602952a4:
    "Но есть и другая сторона: ты всегда замечаешь, когда что-то идет не так, даже если это кажется незначительным."

# ch/anna/events.rpy:1336
translate russian anna_event_08_9c849267:
    "И я чувствую это второе ощущение почти сразу, когда мы с Анной идем домой после свидания."

# ch/anna/events.rpy:1337
translate russian anna_event_08_d54423b5:
    "Это действительно странно, потому что все прошло хорошо сегодня вечером, и я помню только веселье и смех."

# ch/anna/events.rpy:1338
translate russian anna_event_08_8f9f2c21:
    "Только сейчас я замечаю, что Анна замолчала, позволяя мне говорить больше."

# ch/anna/events.rpy:1339
translate russian anna_event_08_13e41648:
    "Это необычно, ведь обычно она – неиссякаемый источник разговоров."

# ch/anna/events.rpy:1340
translate russian anna_event_08_0d090f49:
    "Вместо этого, кажется, ей достаточно просто держаться за мою руку, постоянно смотря на меня."

# ch/anna/events.rpy:1341
translate russian anna_event_08_4ebf24dd:
    "Если бы она была расстроена из-за того, что я сказал, я бы это почувствовал по ее настроению."

# ch/anna/events.rpy:1342
translate russian anna_event_08_a0214243:
    "Но это другое, скорее похоже на то, что ее отношение ко мне претерпело тонкие изменения."

# ch/anna/events.rpy:1343
translate russian anna_event_08_fbe27bc6:
    mike.say "Анна?"

# ch/anna/events.rpy:1344
translate russian anna_event_08_66a7f484:
    anna.say "Хм..."

# ch/anna/events.rpy:1345
translate russian anna_event_08_16193ae1:
    mike.say "Анна, ты в порядке?"

# ch/anna/events.rpy:1347
translate russian anna_event_08_58ae0efb:
    anna.say "Что...? Ой, извини, [lssb_anna.hero_name()]."

# ch/anna/events.rpy:1348
translate russian anna_event_08_991bd02b:
    anna.say "Я была где-то далеко!"

# ch/anna/events.rpy:1349
translate russian anna_event_08_14eb7de1:
    mike.say "Да, я это заметил."

# ch/anna/events.rpy:1351
translate russian anna_event_08_9b463dd6:
    "Анна слегка краснеет, ее щеки порозовели."

# ch/anna/events.rpy:1352
translate russian anna_event_08_cb6c9b30:
    "Она отводит взгляд, явно смущаясь из-за того, что её поведение было замечено."

# ch/anna/events.rpy:1353
translate russian anna_event_08_f6e5662b:
    "Но я не могу удержаться от улыбки, глядя на её реакцию, потому что её странности никогда меня не раздражали."

# ch/anna/events.rpy:1354
translate russian anna_event_08_e5076797:
    "На самом деле, это одна из тех вещей в ней, которые мне просто очень нравятся."

# ch/anna/events.rpy:1355
translate russian anna_event_08_5479c14a:
    mike.say "Ты хочешь рассказать мне, о чем ты думаешь, Анна?"

# ch/anna/events.rpy:1356
translate russian anna_event_08_7ffd1476:
    mike.say "Может быть, так мы сможем лучше понять друг друга!"

# ch/anna/events.rpy:1357
translate russian anna_event_08_adc6aac5:
    anna.say "Я... ну..."

# ch/anna/events.rpy:1358
translate russian anna_event_08_ada81ff9:
    mike.say "Все в порядке, Анна."

# ch/anna/events.rpy:1359
translate russian anna_event_08_bf462e9c:
    mike.say "Я не злюсь, просто любопытно, вот и всё."

# ch/anna/events.rpy:1361
translate russian anna_event_08_f028860b:
    "Она кивает, словно черпая силы из моих слов."

# ch/anna/events.rpy:1362
translate russian anna_event_08_cc59b35d:
    anna.say "Ну, [lssb_anna.hero_name()]..."

# ch/anna/events.rpy:1363
translate russian anna_event_08_3d39fc0b:
    anna.say "То, о чем я думаю... это ты!"

# ch/anna/events.rpy:1364
translate russian anna_event_08_773af4a5:
    mike.say "Я?!?"

# ch/anna/events.rpy:1365
translate russian anna_event_08_de86aa06:
    anna.say "Да, [lssb_anna.hero_name()]."

# ch/anna/events.rpy:1366
translate russian anna_event_08_19c21cfb:
    anna.say "Я думала о том, как мне нравится проводить с тобой время."

# ch/anna/events.rpy:1367
translate russian anna_event_08_c8069364:
    anna.say "Как мне нравится, когда мы вместе."

# ch/anna/events.rpy:1368
translate russian anna_event_08_bc0d6215:
    anna.say "Как мне нравится, когда это только ты и я!"

# ch/anna/events.rpy:1369
translate russian anna_event_08_ba86883e:
    "На мгновение её слова заставляют меня молча смотреть на неё."

# ch/anna/events.rpy:1370
translate russian anna_event_08_54d261a6:
    "Потому что именно в этот момент мой мозг наконец-то осознает, что здесь происходит."

# ch/anna/events.rpy:1371
translate russian anna_event_08_320ec94a:
    "Что-то изменилось между Анной и мной."

# ch/anna/events.rpy:1372
translate russian anna_event_08_66e54a64:
    "Что-то слишком тонкое, чтобы мой бедный мозг мог заметить это самостоятельно."

# ch/anna/events.rpy:1373
translate russian anna_event_08_e9439aca:
    "Мы больше не просто пара друзей, которые проводят время вместе."

# ch/anna/events.rpy:1374
translate russian anna_event_08_c4eb15b8:
    "Мы даже не пара друзей, которые \"просто\" проводят время вместе, чтобы скрыть то, что нам друг друг очень нравятся."

# ch/anna/events.rpy:1375
translate russian anna_event_08_7dad0ed9:
    "Мы только что перешли на уровень пары, которая действительно встречается!"

# ch/anna/events.rpy:1376
translate russian anna_event_08_f487f69b:
    "Я ожидаю почувствовать волну паники, этот типичный страх перед обязательствами."

# ch/anna/events.rpy:1377
translate russian anna_event_08_7e85704b:
    "Но этого не происходит, и вместо этого я чувствую теплое ощущение, поднимающееся в моей груди."

# ch/anna/events.rpy:1378
translate russian anna_event_08_a2951f31:
    "Это странно, но это заставляет меня хотеть смотреть на Анну точно так же, как она смотрит на меня..."

# ch/anna/events.rpy:1379
translate russian anna_event_08_f6629484:
    mike.say "Я тоже, Анна."

# ch/anna/events.rpy:1380
translate russian anna_event_08_df248e2b:
    mike.say "Мне очень нравится проводить с тобой время и делать что-нибудь веселое."

# ch/anna/events.rpy:1381
translate russian anna_event_08_bdbdf27e:
    mike.say "Но самое лучшее – это просто быть рядом с тобой."

# ch/anna/events.rpy:1383
translate russian anna_event_08_834b4abf:
    "На лице Анны появляется счастливая улыбка, и она крепко обнимает меня."

# ch/anna/events.rpy:1384
translate russian anna_event_08_58a79498:
    "Я чувствую каждый сантиметр её маленького тела, когда она прижимается ко мне."

# ch/anna/events.rpy:1386
translate russian anna_event_08_848bcfa6:
    anna.say "Тогда давай проводить вместе гораздо больше времени, [lssb_anna.hero_name()]!"

# ch/anna/events.rpy:1387
translate russian anna_event_08_acd2496f:
    anna.say "У нас столько времени, сколько мы только можем найти!"

# ch/anna/events.rpy:1388
translate russian anna_event_08_e06f496b:
    "Я радостно киваю, уже предвкушая возможность воспользоваться предложением Анны."

# ch/anna/events.rpy:1395
translate russian anna_event_09_02e024f3:
    "Обычно я бы и не заметил, что Анна немного рассеянная и легкомысленная в целом."

# ch/anna/events.rpy:1396
translate russian anna_event_09_1240c172:
    "Ведь она обычно такая, хотя иногда у нее бывают моменты ясности."

# ch/anna/events.rpy:1397
translate russian anna_event_09_3055b2ed:
    "Но совсем недавно она стала еще более растерянной и нерешительной, чем обычно."

# ch/anna/events.rpy:1398
translate russian anna_event_09_9f17b58a:
    "Кажется, будто что-то произошло, из-за чего ее мозг \"сбоит\"."

# ch/anna/events.rpy:1399
translate russian anna_event_09_82b2930c:
    "Что еще больше странно, никто другой, кажется, этого не замечает."

# ch/anna/events.rpy:1400
translate russian anna_event_09_85407dda:
    "Саша никогда даже не делает никаких комментариев об этом, когда дома речь заходит об Анне."

# ch/anna/events.rpy:1401
translate russian anna_event_09_f72ea980:
    "И, кроме обычных словесных перепалок между ними, Клео ведет себя точно так же."

# ch/anna/events.rpy:1402
translate russian anna_event_09_c79f1da8:
    "Можете называть меня тупым, если хотите, но мне нужно время, чтобы понять, что общего во всем этом."

# ch/anna/events.rpy:1403
translate russian anna_event_09_4052e4f2:
    "Дело во мне: со всеми остальными Анна ведёт себя нормально, а рядом со мной вся словно завязывается узлом."

# ch/anna/events.rpy:1404
translate russian anna_event_09_a9f9fadd:
    "Конечно, я реагирую на это совершенно спокойно и рационально."

# ch/anna/events.rpy:1405
translate russian anna_event_09_fe86b967:
    "Взвесив все возможные варианты, я рассматриваю каждый из них с точки зрения его целесообразности и практичности."

# ch/anna/events.rpy:1406
translate russian anna_event_09_4cb2d289:
    "И только потом я начинаю паниковать и прихожу к выводу, что Анна обдумывает, как меня бросить."

# ch/anna/events.rpy:1407
translate russian anna_event_09_d47bdc46:
    "Как бы я ни старался, я просто не могу избавиться от этого убеждения."

# ch/anna/events.rpy:1409
translate russian anna_event_09_aed00b17:
    "Что означает, что в следующий раз, когда мы встретимся, я буду трястись от нервов."

# ch/anna/events.rpy:1410
translate russian anna_event_09_22735dee:
    "Я не могу смотреть Анне в глаза, боясь, что она использует это как шанс, которого ждет."

# ch/anna/events.rpy:1411
translate russian anna_event_09_2bd49977:
    "В любой момент я ожидаю, что из ее уст слетят слова, которые положат конец всему между нами."

# ch/anna/events.rpy:1412
translate russian anna_event_09_9522d13c:
    "И поэтому, в конце концов, единственное, что я могу сделать – это встретить это лицом к лицу..."

# ch/anna/events.rpy:1413
translate russian anna_event_09_621132fd:
    mike.say "Анна..."

# ch/anna/events.rpy:1414
translate russian anna_event_09_365733dd:
    anna.say "Что?"

# ch/anna/events.rpy:1415
translate russian anna_event_09_fa394830:
    mike.say "Все в порядке?"

# ch/anna/events.rpy:1416
translate russian anna_event_09_36a7ae42:
    mike.say "Может быть, есть что-то, о чем ты хотела бы поговорить?"

# ch/anna/events.rpy:1417
translate russian anna_event_09_9e8744de:
    anna.say "Эм... о чем же, [lssb_anna.hero_name()]?"

# ch/anna/events.rpy:1418
translate russian anna_event_09_f7d22a38:
    mike.say "О... нас?"

# ch/anna/events.rpy:1419
translate russian anna_event_09_e8cb6e74:
    "Этот вопрос, кажется, выводит Анну из ее обычного состояния легкой рассеянности."

# ch/anna/events.rpy:1421
translate russian anna_event_09_75fd72a4:
    "Я вижу, как расширяются ее глаза и краснеют щеки, что заставляет меня опасаться самого худшего."

# ch/anna/events.rpy:1422
translate russian anna_event_09_2b6cdcdd:
    mike.say "Пожалуйста, Анна, скажи, что происходит."

# ch/anna/events.rpy:1423
translate russian anna_event_09_9db601d7:
    mike.say "Ты словно на другой планете уже несколько дней."

# ch/anna/events.rpy:1424
translate russian anna_event_09_77699500:
    mike.say "И я должен знать, что тебя беспокоит."

# ch/anna/events.rpy:1426
translate russian anna_event_09_1f9eb916:
    "Анна отводит взгляд на мгновение, а затем снова смотрит."

# ch/anna/events.rpy:1427
translate russian anna_event_09_0db65215:
    "Сейчас она напоминает мне оленя, застигнутого фарами."

# ch/anna/events.rpy:1428
translate russian anna_event_09_baaac64f:
    "Как будто она хочет убежать, но боится последствий."

# ch/anna/events.rpy:1429
translate russian anna_event_09_5bbd0ef6:
    anna.say "Я… я хочу, [lssb_anna.hero_name()]."

# ch/anna/events.rpy:1430
translate russian anna_event_09_232b3bfb:
    anna.say "Но я не знаю, стоит ли это делать!"

# ch/anna/events.rpy:1431
translate russian anna_event_09_62c4d8e0:
    "Я делаю глубокий вдох, готовясь к тому, что ждет меня впереди."

# ch/anna/events.rpy:1432
translate russian anna_event_09_b7f82d3f:
    "Что бы ни скрывала Анна, мне действительно нужно это узнать."

# ch/anna/events.rpy:1433
translate russian anna_event_09_23096f61:
    "Мы просто не можем продолжать так больше."

# ch/anna/events.rpy:1434
translate russian anna_event_09_9a3a1d7c:
    "Если мы продолжим, это наверняка разрушит то, что у нас есть, просто из-за того, что это будет постоянно висеть над нами."

# ch/anna/events.rpy:1435
translate russian anna_event_09_931bd79b:
    mike.say "Анна, все в порядке."

# ch/anna/events.rpy:1436
translate russian anna_event_09_05c9c756:
    mike.say "Обещаю, я не буду злиться."

# ch/anna/events.rpy:1438
translate russian anna_event_09_8ef5ae91:
    "Я беру руки Анны и обхватываю их своими."

# ch/anna/events.rpy:1439
translate russian anna_event_09_e9a9b301:
    "Она смотрит вниз, когда я это делаю, ее глаза по-прежнему полны страха."

# ch/anna/events.rpy:1440
translate russian anna_event_09_d3d12ed1:
    "И только сейчас я замечаю, что она дрожит."

# ch/anna/events.rpy:1441
translate russian anna_event_09_c6eedbc8:
    anna.say "Хорошо, если ты обещаешь, что не рассердишься…"

# ch/anna/events.rpy:1442
translate russian anna_event_09_f5f42c57:
    anna.say "Я думаю…"

# ch/anna/events.rpy:1444
translate russian anna_event_09_ec95a780:
    anna.say "Я думаю, я влюбилась в тебя…"

# ch/anna/events.rpy:1445
translate russian anna_event_09_2b6a2a5e:
    "Мне нужно несколько секунд, чтобы осознать то, что только что сказала Анна."

# ch/anna/events.rpy:1446
translate russian anna_event_09_668771c4:
    "Я был готов к тому, что она обрушит на меня словесные и эмоциональные удары."

# ch/anna/events.rpy:1447
translate russian anna_event_09_2023c6d9:
    "Но она поразила меня совершенно другим."

# ch/anna/events.rpy:1448
translate russian anna_event_09_621132fd_1:
    mike.say "Анна..."

# ch/anna/events.rpy:1449
translate russian anna_event_09_882b74ea:
    mike.say "Ты серьезно?!"

# ch/anna/events.rpy:1450
translate russian anna_event_09_7cadbb8c:
    anna.say "Да, я... действительно."

# ch/anna/events.rpy:1451
translate russian anna_event_09_e6822a91:
    anna.say "Чёрт, я знала, что ты разозлишься!"

# ch/anna/events.rpy:1452
translate russian anna_event_09_b54becae:
    mike.say "Нет, Анна, нет!"

# ch/anna/events.rpy:1453
translate russian anna_event_09_d62f3274:
    mike.say "Я думал, ты бросишь меня!"

# ch/anna/events.rpy:1456
translate russian anna_event_09_63e7dc6e:
    "В этот момент Анна буквально бросается ко мне."

# ch/anna/events.rpy:1457
translate russian anna_event_09_930744fa:
    "Она обнимает меня за талию и притягивает к себе в неожиданно крепких объятиях."

# ch/anna/events.rpy:1458
translate russian anna_event_09_489bc5af:
    anna.say "Нет, нет, нет!"

# ch/anna/events.rpy:1459
translate russian anna_event_09_f2d340c9:
    anna.say "[lssb_anna.hero_name()], как ты мог вообще так думать?!"

# ch/anna/events.rpy:1460
translate russian anna_event_09_dd7c58f5:
    anna.say "Я ЛЮБЛЮ ТЕБЯ!"

# ch/anna/events.rpy:1461
translate russian anna_event_09_188091e3:
    "Во второй раз за несколько минут Анна ошеломляет меня."

# ch/anna/events.rpy:1462
translate russian anna_event_09_6a932762:
    "Все, что я могу сделать, это ответить ей взаимностью, пытаясь понять ее признание."

# ch/anna/events.rpy:1463
translate russian anna_event_09_8fb73da4:
    mike.say "Я..."

# ch/anna/events.rpy:1464
translate russian anna_event_09_b5dc5aeb:
    mike.say "Я тоже люблю тебя, Анна."

# ch/anna/events.rpy:1465
translate russian anna_event_09_456821af:
    "На этот раз настала очередь Анны молчать, она просто крепко обнимает меня изо всех сил."

# ch/anna/events.rpy:1466
translate russian anna_event_09_369d339c:
    "Я чувствую, как мое сердце бешено колотится в груди, словно сейчас вот-вот разорвется."

# ch/anna/events.rpy:1467
translate russian anna_event_09_6c79f9de:
    "Но я не знаю, связано ли это с тем, что адреналин все еще циркулирует по моему телу."

# ch/anna/events.rpy:1468
translate russian anna_event_09_0826b77d:
    "Или же дело в том, что я только что осознал, что Анна и я действительно любим друг друга..."

# ch/anna/events.rpy:1477
translate russian anna_event_10_e100f223:
    "Вот опять наступает этот момент, когда ночь заканчивается, и мне нужно попрощаться с Анной до нашей следующей встречи."

# ch/anna/events.rpy:1478
translate russian anna_event_10_ffeee59d:
    "До сих пор наше свидание было просто замечательным, одним из лучших."

# ch/anna/events.rpy:1479
translate russian anna_event_10_40aaea2a:
    "Но вдруг я чувствую, как мое настроение меняется при мысли о долгой дороге домой и пустой кровати, которая ждет меня там."

# ch/anna/events.rpy:1480
translate russian anna_event_10_bebbaa33:
    "Я уже не один раз прощался с Анной таким образом, наверное, больше дюжины раз."

# ch/anna/events.rpy:1481
translate russian anna_event_10_070ad271:
    "И все же сейчас я понимаю, что хочу сделать все возможное, чтобы оттянуть тот момент, когда мне придется это делать."

# ch/anna/events.rpy:1482
translate russian anna_event_10_6f76deba:
    "Анна, кажется, не заметила моей внезапной перемены настроения и продолжает говорить, несмотря ни на что."

# ch/anna/events.rpy:1484
translate russian anna_event_10_b6175962:
    anna.say "...и тогда я сказала Клео, что она абсолютно права."

# ch/anna/events.rpy:1485
translate russian anna_event_10_994e690b:
    anna.say "Но потом вмешалась Саша, совершенно не спросив, можно ли ей это делать, стоит об этом упомянуть."

# ch/anna/events.rpy:1486
translate russian anna_event_10_16c2bad4:
    anna.say "И она встала на сторону Клео против меня! Ты можешь в это поверить?!"

# ch/anna/events.rpy:1487
translate russian anna_event_10_ca1dce66:
    "Анна вскидывает руки, чтобы подчеркнуть свое возмущение, явно ожидая, что я разделю ее мнение."

# ch/anna/events.rpy:1488
translate russian anna_event_10_bb03b401:
    "Но мои мысли все еще зациклились на странном чувстве тревоги из-за того, что ночь заканчивается."

# ch/anna/events.rpy:1490
translate russian anna_event_10_7891753e:
    anna.say "[lssb_anna.hero_name()]!"

# ch/anna/events.rpy:1491
translate russian anna_event_10_954ece9a:
    anna.say "Ты вообще меня слушаешь?"

# ch/anna/events.rpy:1492
translate russian anna_event_10_b3654f27:
    "Я качаю головой, пытаясь как можно сильнее вырваться из этого подавленного состояния."

# ch/anna/events.rpy:1493
translate russian anna_event_10_c3ccd113:
    mike.say "Прости, Анна..."

# ch/anna/events.rpy:1494
translate russian anna_event_10_e4d76515:
    mike.say "Просто я отвлекся, понимаешь?"

# ch/anna/events.rpy:1495
translate russian anna_event_10_a96ff2ff:
    mike.say "Наверное, у меня что-то на уме."

# ch/anna/events.rpy:1497
translate russian anna_event_10_3a3167ac:
    "Едва она почувствовала искреннюю тоску в моем голосе, настроение Анны смягчилось."

# ch/anna/events.rpy:1498
translate russian anna_event_10_88902d39:
    anna.say "Эй, [lssb_anna.hero_name()], не грусти, пожалуйста!"

# ch/anna/events.rpy:1499
translate russian anna_event_10_1d9bf0c1:
    anna.say "Мне казалось, что нам сегодня было очень хорошо?"

# ch/anna/events.rpy:1500
translate russian anna_event_10_cdc7561e:
    anna.say "Не люблю, когда ты расстроен. Мне страшно, что я тебе надоедаю!"

# ch/anna/events.rpy:1501
translate russian anna_event_10_cc50b5cc:
    "Я почти перестал качать головой, как только Анна вырвалось с этой фразой."

# ch/anna/events.rpy:1502
translate russian anna_event_10_58372182:
    "Но ее слова снова вызвали у меня реакцию, и теперь я качал головой гораздо быстрее и эмоциональнее."

# ch/anna/events.rpy:1503
translate russian anna_event_10_437a01ea:
    mike.say "Ох, чёрт..."

# ch/anna/events.rpy:1504
translate russian anna_event_10_09c94e55:
    mike.say "Нет, Анна... ни в коем случае!"

# ch/anna/events.rpy:1505
translate russian anna_event_10_b18c7dcc:
    mike.say "Это совсем не так."

# ch/anna/events.rpy:1506
translate russian anna_event_10_cbb4794e:
    "Анна смотрит на меня, начиная немного обижаться, пытаясь найти ответ."

# ch/anna/events.rpy:1507
translate russian anna_event_10_117a5734:
    "Я хорошо знаю этот взгляд – он означает, что она ждет от меня утешения и успокоения."

# ch/anna/events.rpy:1508
translate russian anna_event_10_17749b29:
    "И именно этого я сейчас хочу добиться."

# ch/anna/events.rpy:1509
translate russian anna_event_10_f7d0d20c:
    anna.say "Тогда что это, [lssb_anna.hero_name()]?"

# ch/anna/events.rpy:1510
translate russian anna_event_10_365733dd:
    anna.say "Что?"

# ch/anna/events.rpy:1511
translate russian anna_event_10_f25bdfdc:
    mike.say "Да... это странно, Анна."

# ch/anna/events.rpy:1512
translate russian anna_event_10_a410b959:
    mike.say "Я просто... не хочу оставаться одному дома."

# ch/anna/events.rpy:1513
translate russian anna_event_10_727efbd8:
    mike.say "Думаю, я немного боюсь одиночества, вот и все."

# ch/anna/events.rpy:1515
translate russian anna_event_10_12255a9c:
    "Вдруг я вижу, как загораются глаза у Анны."

# ch/anna/events.rpy:1516
translate russian anna_event_10_36cb0c12:
    "Она улыбается, как чеширский кот, буквально сияя на меня."

# ch/anna/events.rpy:1517
translate russian anna_event_10_ceb76f63:
    anna.say "Ты действительно это имеешь в виду, [lssb_anna.hero_name()]?"

# ch/anna/events.rpy:1518
translate russian anna_event_10_65f02610:
    anna.say "Тебе так сильно меня не хватает, когда мы расстаемся?"

# ch/anna/events.rpy:1519
translate russian anna_event_10_96449b43:
    "Я могу только медленно кивнуть, боясь быть подавленным энтузиазмом Анны."

# ch/anna/events.rpy:1520
translate russian anna_event_10_391998d5:
    "Ну, и еще то, что я чувствую, будто не смог бы солгать об этом, даже если бы попытался."

# ch/anna/events.rpy:1521
translate russian anna_event_10_ee935c8e:
    "Она выразила то, для чего я сам не находил слов: я боюсь остаться без неё."

# ch/anna/events.rpy:1522
translate russian anna_event_10_8d2a6c9d:
    mike.say "Да, Анна, это так."

# ch/anna/events.rpy:1523
translate russian anna_event_10_be1dd0d6:
    mike.say "Я не хочу, чтобы наше время вместе заканчивалось."

# ch/anna/events.rpy:1525
translate russian anna_event_10_d84c25d0:
    "Анна обнимает меня за талию, осторожно притягивая к себе."

# ch/anna/events.rpy:1526
translate russian anna_event_10_a0f3bb4b:
    "Я отвечаю тем же, обнимая ее в ответ."

# ch/anna/events.rpy:1527
translate russian anna_event_10_9b70604b:
    "В этот раз она ни слова не говорит."

# ch/anna/events.rpy:1528
translate russian anna_event_10_bf687cf5:
    "Но, наверное, ей и правда это не нужно."

# ch/anna/events.rpy:1529
translate russian anna_event_10_7d1a775d:
    "Пока я держу Анну близко к себе, я начинаю анализировать все факты."

# ch/anna/events.rpy:1530
translate russian anna_event_10_a180d1a7:
    "У меня возникает странное чувство в животе, когда она рядом."

# ch/anna/events.rpy:1531
translate russian anna_event_10_e8498aae:
    "Я почти боюсь представить, что ее может не быть рядом."

# ch/anna/events.rpy:1532
translate russian anna_event_10_7a974f4c:
    "И мы начинаем общаться без слов."

# ch/anna/events.rpy:1533
translate russian anna_event_10_c15aef86:
    "Думаю, я больше не могу это отрицать."

# ch/anna/events.rpy:1534
translate russian anna_event_10_6948dfbe:
    "Я влюбляюсь в Анну."

# ch/anna/events.rpy:1535
translate russian anna_event_10_dae02b56:
    "И очень быстро!"

# ch/anna/events.rpy:1545
translate russian anna_event_11_368344b5:
    "Наверное, мне действительно повезло найти девушку, как Анна, и я должен быть благодарен за это."

# ch/anna/events.rpy:1547
translate russian anna_event_11_fbee4111:
    "И я имею в виду не только то, что у нее самая потрясающая грудь, какую только можно представить."

# ch/anna/events.rpy:1548
translate russian anna_event_11_b6f38237:
    "Но еще и потому, что она знает об этом и довольно гордится тем эффектом, который это оказывает на меня!"

# ch/anna/events.rpy:1549
translate russian anna_event_11_a348c6ef:
    "Вот и сейчас, например, я просто не могу отвести от них взгляд."

# ch/anna/events.rpy:1550
translate russian anna_event_11_becd389b:
    "Может быть, Анна закатывает глаза, ругаясь на меня за то, что я типичный парень с узким кругозором?"

# ch/anna/events.rpy:1552
translate russian anna_event_11_beb6ed92:
    "Да ничуть: она улыбается этому вниманию и рада, что так меня привлекает!"

# ch/anna/events.rpy:1554
translate russian anna_event_11_77c80037:
    anna.say "Эй, [lssb_anna.hero_name()], ты уже целую вечность на них смотришь."

# ch/anna/events.rpy:1555
translate russian anna_event_11_237f4f40:
    anna.say "Ты собираешься предложить им поиграть, или что?"

# ch/anna/events.rpy:1556
translate russian anna_event_11_ab090186:
    mike.say "Что... ты серьезно?"

# ch/anna/events.rpy:1558
translate russian anna_event_11_313ddd48:
    "(От первого лица, откровенное описание) Анна хихикает и подмигивает мне, прижимая грудь между руками."

# ch/anna/events.rpy:1560
translate russian anna_event_11_fd006380:
    anna.say "Конечно, я!"

# ch/anna/events.rpy:1561
translate russian anna_event_11_10739d1a:
    anna.say "Я вижу, как ты на меня смотришь."

# ch/anna/events.rpy:1562
translate russian anna_event_11_a70b4a20:
    anna.say "И было бы жаль, если бы вся эта похоть просто пропала даром!"

# ch/anna/events.rpy:1563
translate russian anna_event_11_80998c2a:
    anna.say "Ну что, ты говоришь?"

# ch/anna/events.rpy:1564
translate russian anna_event_11_4e175039:
    "Прежде чем я успеваю дать самый очевидный ответ, я вдруг вспоминаю кое-что."

# ch/anna/events.rpy:1565
translate russian anna_event_11_e40da251:
    "Чувствуя себя полным неудачником, я бросаю взгляд на часы и потом бью себя в лоб."

# ch/anna/events.rpy:1566
translate russian anna_event_11_188a5800:
    mike.say "Черт!"

# ch/anna/events.rpy:1567
translate russian anna_event_11_5fb3adcb:
    mike.say "Мне нужно быть где-то через полчаса!"

# ch/anna/events.rpy:1568
translate russian anna_event_11_caf75a15:
    mike.say "Прости, Анна, можем сделать это в другой раз?"

# ch/anna/events.rpy:1569
translate russian anna_event_11_751d75d5:
    "Анна качает головой и отмахивается от моих опасений, как будто они ничего не значат."

# ch/anna/events.rpy:1570
translate russian anna_event_11_c49186ee:
    anna.say "Не беспокойся об этом, [lssb_anna.hero_name()]."

# ch/anna/events.rpy:1571
translate russian anna_event_11_5fa8cc47:
    anna.say "Я могу доставить тебе удовольствие меньше чем за это время!"

# ch/anna/events.rpy:1573
translate russian anna_event_11_e89bcb2c:
    anna.say "Просто вставь свой член туда."

# ch/anna/events.rpy:1574
translate russian anna_event_11_75106c88:
    "Она смотрит вниз на пространство между своими грудями самым вызывающим образом."

# ch/anna/events.rpy:1575
translate russian anna_event_11_e26655ef:
    anna.say "А остальное оставь мне!"

# ch/anna/events.rpy:1579
translate russian anna_event_11_4d188876:
    "Что, ты думаешь, что у меня был хоть малейший шанс отказать в таком предложении?!?"

# ch/anna/events.rpy:1580
translate russian anna_event_11_d2101359:
    mike.say "Д...да, Анна!"

# ch/anna/events.rpy:1581
translate russian anna_event_11_afb4c386:
    mike.say "Конечно!"

# ch/anna/events.rpy:1583
translate russian anna_event_11_7d32cbd9:
    "Улыбка Анны становится еще шире, когда она берет мою руку."

# ch/anna/events.rpy:1584
translate russian anna_event_11_dfab1eb9:
    anna.say "У меня было предчувствие, что ты не сможешь отказать!"

# ch/anna/events.rpy:1585
translate russian anna_event_11_09f7cb6f:
    anna.say "Пойдем, давай пойдем куда-нибудь потише!"

# ch/anna/events.rpy:1590
translate russian anna_event_11_4d188876_1:
    "Что, ты думаешь, что у меня был хоть малейший шанс отказать в таком предложении?!?"

# ch/anna/events.rpy:1591
translate russian anna_event_11_d2101359_1:
    mike.say "Д...да, Анна!"

# ch/anna/events.rpy:1592
translate russian anna_event_11_afb4c386_1:
    mike.say "Конечно!"

# ch/anna/events.rpy:1594
translate russian anna_event_11_7d32cbd9_1:
    "Улыбка Анны становится еще шире, когда она берет мою руку."

# ch/anna/events.rpy:1595
translate russian anna_event_11_dfab1eb9_1:
    anna.say "У меня было предчувствие, что ты не сможешь отказать!"

# ch/anna/events.rpy:1596
translate russian anna_event_11_09f7cb6f_1:
    anna.say "Пойдем, давай пойдем куда-нибудь потише!"

# ch/anna/events.rpy:1597
translate russian anna_event_11_ce6af1fc:
    "Но тут мне приходит в голову мысль, и я жестом прошу Анну остановиться."

# ch/anna/events.rpy:1600
translate russian anna_event_11_099bf3f8:
    anna.say "Что...что случилось?"

# ch/anna/events.rpy:1601
translate russian anna_event_11_8d16609c:
    mike.say "Я вот подумал... может быть, мы могли бы это заснять?"

# ch/anna/events.rpy:1602
translate russian anna_event_11_35cefdee:
    "Анна сначала немного удивлена, но потом я вижу, как эта идея начинает ей нравиться."

# ch/anna/events.rpy:1604
translate russian anna_event_11_b0d46f4c:
    "Ее улыбка возвращается, и она смотрит на меня боком, явно заинтересованная возможностями."

# ch/anna/events.rpy:1605
translate russian anna_event_11_fbb99a2f:
    anna.say "Конечно, мы можем это сделать."

# ch/anna/events.rpy:1606
translate russian anna_event_11_004e0a2c:
    anna.say "Но откуда у тебя такая идея?"

# ch/anna/events.rpy:1610
translate russian anna_event_11_9a99b476:
    mike.say "Ну, ты же собираешься уехать из города через неделю, верно?"

# ch/anna/events.rpy:1611
translate russian anna_event_11_1defb657:
    "Анна кивает."

# ch/anna/events.rpy:1612
translate russian anna_event_11_d55db377:
    anna.say "Да, всего на пару дней."

# ch/anna/events.rpy:1613
translate russian anna_event_11_be7a75a8:
    anna.say "Но я уже рассказывала тебе об этом."

# ch/anna/events.rpy:1614
translate russian anna_event_11_d53110ca:
    anna.say "И ты был не против."

# ch/anna/events.rpy:1615
translate russian anna_event_11_9244958b:
    mike.say "Да, я не против."

# ch/anna/events.rpy:1616
translate russian anna_event_11_596cc25d:
    mike.say "Просто... мне хотелось бы что-то... чтобы напоминало о тебе."

# ch/anna/events.rpy:1617
translate russian anna_event_11_797eaddf:
    mike.say "Ты же знаешь... пока ты не вернешься."

# ch/anna/events.rpy:1618
translate russian anna_event_11_f5ab575a:
    "Я машинально пожимаю плечами и даже немного краснею от этого признания."

# ch/anna/events.rpy:1620
translate russian anna_event_11_d3c806e3:
    "Анна улыбается мне, сжимая руки вместе, словно очарованная этой мыслью."

# ch/anna/events.rpy:1621
translate russian anna_event_11_91299f62:
    anna.say "Ой, [lssb_anna.hero_name()], это так мило!"

# ch/anna/events.rpy:1622
translate russian anna_event_11_eb863c50:
    anna.say "Конечно, ты можешь это снять."

# ch/anna/events.rpy:1623
translate russian anna_event_11_98d3a537:
    anna.say "Но сначала ты должен пообещать мне кое-что."

# ch/anna/events.rpy:1624
translate russian anna_event_11_be0754f6:
    mike.say "Эм, ладно, Анна. И что это?"

# ch/anna/events.rpy:1625
translate russian anna_event_11_7e1585a0:
    anna.say "Ты должен пообещать мне, что будешь мастурбировать под это видео."

# ch/anna/events.rpy:1626
translate russian anna_event_11_5ff7d21d:
    anna.say "Каждую ночь, пока я не вернусь, и тогда ты сможешь получить настоящее удовольствие, хорошо?"

# ch/anna/events.rpy:1627
translate russian anna_event_11_a723d5cc:
    "Я смеюсь и с энтузиазмом киваю головой, что заставляет Анну сделать то же самое."

# ch/anna/events.rpy:1629
translate russian anna_event_11_bdf84854:
    mike.say "Думаю, можно использовать это для мести."

# ch/anna/events.rpy:1631
translate russian anna_event_11_f34b2624:
    "Анна удивленно смотрит на него, наклонив голову в сторону."

# ch/anna/events.rpy:1632
translate russian anna_event_11_bd7a907b:
    anna.say "Месть?"

# ch/anna/events.rpy:1633
translate russian anna_event_11_002d4f29:
    anna.say "Кому?"

# ch/anna/events.rpy:1634
translate russian anna_event_11_72b21f92:
    anna.say "За что?"

# ch/anna/events.rpy:1635
translate russian anna_event_11_b7d57cfb:
    mike.say "Хорошо, Анна, послушай меня."

# ch/anna/events.rpy:1636
translate russian anna_event_11_f0c11e53:
    mike.say "Твоя бывшая, Гвен, ведь обращалась с тобой по-свински?"

# ch/anna/events.rpy:1638
translate russian anna_event_11_2c474b03:
    "Губы Анны скривлены от отвращения при одном упоминании ее высокой бывшей девушки."

# ch/anna/events.rpy:1639
translate russian anna_event_11_fa07e8d3:
    anna.say "Да, я просто ненавижу эту длинную сучку!"

# ch/anna/events.rpy:1640
translate russian anna_event_11_83728079:
    mike.say "Я точно знаю, что ты чувствуешь."

# ch/anna/events.rpy:1641
translate russian anna_event_11_837b2506:
    anna.say "Ты?"

# ch/anna/events.rpy:1642
translate russian anna_event_11_30a9945d:
    mike.say "Конечно, я."

# ch/anna/events.rpy:1643
translate russian anna_event_11_32896918:
    mike.say "А одна из моих бывших, Алексис, изменяла мне и разбила сердце."

# ch/anna/events.rpy:1644
translate russian anna_event_11_a722d40c:
    anna.say "То есть, мы снимаем себя на видео, как весело проводим время, а потом отправляем это им?"

# ch/anna/events.rpy:1645
translate russian anna_event_11_635ca70d:
    mike.say "Именно! Что-то вроде большого «да пошли вы» для них обеих!"

# ch/anna/events.rpy:1646
translate russian anna_event_11_05c341f7:
    "Анна злобно хихикает, качая головой в недоверии к тому, что я предлагаю."

# ch/anna/events.rpy:1647
translate russian anna_event_11_c4493b8b:
    anna.say "[lssb_anna.hero_name()], это звучит потрясающе!"

# ch/anna/events.rpy:1648
translate russian anna_event_11_b0f40f6d:
    anna.say "Мы должны это сделать!"

# ch/anna/events.rpy:1651
translate russian anna_event_11_46bfd7ea:
    "Анна снимает с себя последнюю одежду и торопится к кровати, жестом приглашая меня последовать за ней."

# ch/anna/events.rpy:1653
translate russian anna_event_11_28ef0c30:
    "Я пытаюсь снять с себя последнее, одновременно, чуть не споткнувшись при этом."

# ch/anna/events.rpy:1654
translate russian anna_event_11_072866a2:
    "Она смеется, когда перекатывается на спину на матрас, не останавливаясь, пока ее голова не коснется подушек."

# ch/anna/events.rpy:1655
translate russian anna_event_11_c16b6164:
    anna.say "Не бей головой, [lssb_anna.hero_name()]."

# ch/anna/events.rpy:1657
translate russian anna_event_11_cd443aaf:
    anna.say "Ты же парень, тебе полагается отключаться только ПОСЛЕ того, как кончишь!"

# ch/anna/events.rpy:1659
translate russian anna_event_11_62d15a75:
    "Как будто зрелище ее обнаженного тела передо мной было недостаточно, смех Анны тоже сводит меня с ума."

# ch/anna/events.rpy:1660
translate russian anna_event_11_7773e241:
    "На мгновение я даже боюсь, что из-за своего отчаяния добраться до нее, я потеряю сознание."

# ch/anna/events.rpy:1662
translate russian anna_event_11_9c150518:
    "Она манит меня ближе, когда я залезаю на кровать и подползаю к ней, улыбаясь над ее грудью в знак одобрения."

# ch/anna/events.rpy:1663
translate russian anna_event_11_ee302188:
    "Я уже успел все сделать и сижу верхом на животе Анны, и мой член уже болезненно напряжен."

# ch/anna/events.rpy:1664
translate russian anna_event_11_889f69d1:
    "Он покачивается над ее грудью, и она смотрит на него с таким голодом, что я чувствую себя еще более возбужденным, чем раньше."

# ch/anna/events.rpy:1666
translate russian anna_event_11_b4d7c9c1:
    anna.say "Привет, большой мальчик!"

# ch/anna/events.rpy:1667
translate russian anna_event_11_63a288ab:
    anna.say "У меня есть несколько подруг, которые просто умирают от желания познакомиться с тобой..."

# ch/anna/events.rpy:1668
translate russian anna_event_11_7942e6aa:
    "И тут же Анна перестает намекать и переходит к делу."

# ch/anna/events.rpy:1669
translate russian anna_event_11_0067db65:
    "Вместо этого она прижимает свои груди друг к другу, сначала слегка."

# ch/anna/events.rpy:1670
translate russian anna_event_11_a1b3a455:
    "Их тяжелые, округлые формы полностью закрывают головку, а может быть, и половину ствола."

# ch/anna/events.rpy:1671
translate russian anna_event_11_60516116:
    "Ощущение мгновенно невероятное, как будто мой член обернут в теплое тесто."

# ch/anna/events.rpy:1674
translate russian anna_event_11_3321734a:
    "В спешке, чтобы догнать Анну, я чуть не забыл, что мы договорились снять это на видео."

# ch/anna/events.rpy:1675
translate russian anna_event_11_a34ae256:
    "К счастью, я вижу свой телефон на полу, куда он, должно быть, выпал из моего кармана, когда я раздевался."

# ch/anna/events.rpy:1676
translate russian anna_event_11_31c8c80c:
    "Я тянусь и едва успеваю до него, быстро включаю запись и показываю Анну в кадре."

# ch/anna/events.rpy:1677
translate russian anna_event_11_bb9abda7:
    "Она злобно улыбается, явно помня, для чего мы собираемся использовать это видео."

# ch/anna/events.rpy:1679
translate russian anna_event_11_415c7320:
    "Анна злобно улыбается, явно готовая к действиям и предвкушая то, что нам предстоит сделать."

# ch/anna/events.rpy:1681
translate russian anna_event_11_573021b3:
    "Медленно она начинает массировать мой член своими грудью, разминая их так, будто они действительно были тестом."

# ch/anna/events.rpy:1683
translate russian anna_event_11_a36f88e7:
    "Не проходит много времени, как головка вылезает из-под них, опухшая и покрасневшая от давления."

# ch/anna/events.rpy:1685
translate russian anna_event_11_9dfe73bd:
    "Что, в свою очередь, означает, что все ощущения теперь сконцентрированы в стволе."

# ch/anna/events.rpy:1687
translate russian anna_event_11_6e1807ca:
    "Я не могу полностью описать, какие ощущения я испытываю прямо сейчас, когда Анна делает это со мной."

# ch/anna/events.rpy:1689
translate russian anna_event_11_492cb00a:
    "Единственное, с чем я могу это сравнить, – это обычная оральная стимуляция."

# ch/anna/events.rpy:1691
translate russian anna_event_11_01f1d24c:
    "Но где же можно найти такую большую и мягкую руку?"

# ch/anna/events.rpy:1693
translate russian anna_event_11_22a6e577:
    "Возможно, точка давления постоянно перемещается вверх и вниз."

# ch/anna/events.rpy:1695
translate russian anna_event_11_32e9183b:
    "При этом грудь у Анны настолько большая, что почти весь мой член оказывается между ними."

# ch/anna/events.rpy:1697
translate russian anna_event_11_b3d85d1b:
    "И хотя ощущения от того, что она со мной делает, просто потрясающие, есть еще и выражение ее лица."

# ch/anna/events.rpy:1699
translate russian anna_event_11_5d4d9344:
    "Анна разделяет свое внимание между тем, что она делает, и смотрит то вниз, то на меня."

# ch/anna/events.rpy:1701
translate russian anna_event_11_1b3bc8a9:
    "В один момент она смотрит на мой член, который выпирает из ее груди."

# ch/anna/events.rpy:1703
translate russian anna_event_11_f17d29f7:
    "А в следующий момент она поднимает глаза и ловит мой взгляд, улыбаясь, видя мои реакции на ее лице."

# ch/anna/events.rpy:1705
translate russian anna_event_11_338b7c88:
    "Внезапно я чувствую спазм, проходящий по всему моему телу."

# ch/anna/events.rpy:1707
translate russian anna_event_11_de8d60b3:
    "Я был настолько увлечен наблюдением за лицом Анны, что совершенно не заметил, насколько она ускорила темп."

# ch/anna/events.rpy:1709
translate russian anna_event_11_0f792e53:
    "Сейчас она практически \"работает\" своими грудями вокруг моего члена."

# ch/anna/events.rpy:1711
translate russian anna_event_11_6d187782:
    "И этот спазм, который я только что почувствовал, – первый признак того, что я сейчас буду извергаться спермой."

# ch/anna/events.rpy:1713
translate russian anna_event_11_fb0a1041:
    "Прежде чем я успеваю произнести хоть слово, чтобы предупредить Анну, я понимаю, что уже слишком поздно."

# ch/anna/events.rpy:1715
translate russian anna_event_11_59ed702f:
    "Я резко двигаю своим членом вперед, посылая струю спермы прямо ей в лицо."

# ch/anna/events.rpy:1717
translate russian anna_event_11_5fbf3d7b:
    "Выражение лица Анны мгновенно меняется от напряженного на шокированное."

# ch/anna/events.rpy:1719
translate russian anna_event_11_5ee750d1:
    "И, возможно, моргание было бы хорошей идеей для нее в тот же момент."

# ch/anna/events.rpy:1720
translate russian anna_event_11_6ee05916:
    "Не говоря уже о том, чтобы держать рот на замке."

# ch/anna/events.rpy:1722
translate russian anna_event_11_f3aa62f5:
    "Вместо этого она лежит там, широко раскрыв глаза и с открытым ртом, пока на нее попадают брызги."

# ch/anna/events.rpy:1723
translate russian anna_event_11_394a7dbd:
    "Но затем ее удивление, кажется, проходит, и она широко улыбается, прежде чем разразиться приступом смеха."

# ch/anna/events.rpy:1724
translate russian anna_event_11_f1d8a63c:
    mike.say "Эм..."

# ch/anna/events.rpy:1725
translate russian anna_event_11_3fe05594:
    mike.say "Прости, Анна!"

# ch/anna/events.rpy:1727
translate russian anna_event_11_a6353da5:
    "Анна наклоняет голову набок, все еще ухмыляясь мне сквозь маску спермы."

# ch/anna/events.rpy:1728
translate russian anna_event_11_ca8d90e7:
    "Она все еще активно работает своим языком над моим членом, словно решив выжать из него все соки."

# ch/anna/events.rpy:1729
translate russian anna_event_11_f9f367d4:
    anna.say "Ты когда-нибудь видел такие сценки, где кто-то смотрит вниз в шланг для воды?"

# ch/anna/events.rpy:1730
translate russian anna_event_11_6b46915d:
    anna.say "Я думаю, я знала, чего мне ожидать, когда согласилась на это!"

# ch/anna/events.rpy:1738
translate russian anna_event_12_98253636:
    "Кажется, прошла целая вечность с тех пор, как я был среди зрителей на действительно хорошем концерте."

# ch/anna/events.rpy:1740
translate russian anna_event_12_b2f0ed06:
    "Конечно, я недавно много раз был на сцене вместе с Анной и остальными участницами группы Deathless Harpies."

# ch/anna/events.rpy:1741
translate russian anna_event_12_fcfa2392:
    "Но это не то же самое, что быть одним из фанатов в толпе."

# ch/anna/events.rpy:1742
translate russian anna_event_12_e826e4b7:
    "И нет ничего лучше, чем быть там, наслаждаясь атмосферой!"

# ch/anna/events.rpy:1743
translate russian anna_event_12_64e541c3:
    "Разве что делать все это с Анной рядом со мной."

# ch/anna/events.rpy:1744
translate russian anna_event_12_b55586c0:
    "Она сжимает мою руку и улыбается мне с тех пор, как мы вошли через двери!"

# ch/anna/events.rpy:1746
translate russian anna_event_12_c060cf66:
    anna.say "О...мой...чертов...Бог, [lssb_anna.hero_name()]."

# ch/anna/events.rpy:1747
translate russian anna_event_12_b159ec57:
    anna.say "Я до сих пор не могу поверить, что тебе удалось достать билеты на концерт Metallikea!"

# ch/anna/events.rpy:1748
translate russian anna_event_12_207ce991:
    anna.say "Они всегда раскупаются моментально."

# ch/anna/events.rpy:1749
translate russian anna_event_12_c6ad378d:
    "Я стараюсь крепко держать Анну, когда мы начинаем пробираться сквозь толпу."

# ch/anna/events.rpy:1750
translate russian anna_event_12_b46ce0e7:
    "Мы уже находимся внутри зала, кажется, меньше десяти минут."

# ch/anna/events.rpy:1751
translate russian anna_event_12_29ddfc20:
    "Но здесь становится настолько многолюдно, что нам приходится проталкиваться между людьми, толкаясь локтями."

# ch/anna/events.rpy:1752
translate russian anna_event_12_3196e984:
    mike.say "Наверное, это просто чистая случайность, Анна."

# ch/anna/events.rpy:1753
translate russian anna_event_12_a7c49f79:
    mike.say "Должно быть, я оказался там раньше всех!"

# ch/anna/events.rpy:1754
translate russian anna_event_12_c622349c:
    "Я не собираюсь признаваться, сколько часов я провел на линии, звоня в кассу."

# ch/anna/events.rpy:1755
translate russian anna_event_12_9c949e0c:
    "Или о том, как меня обманул перекупщик, когда первый план провалился."

# ch/anna/events.rpy:1756
translate russian anna_event_12_7a82a6b8:
    "Главное сейчас – это выражение чистейшего восторга на лице Анны."

# ch/anna/events.rpy:1758
translate russian anna_event_12_0e7b3277:
    "Ну, и то, как она смотрит на меня."

# ch/anna/events.rpy:1759
translate russian anna_event_12_f07a2eb5:
    "Как будто я – единственное, что она любит почти так же сильно, как группа, которую мы пришли послушать."

# ch/anna/events.rpy:1760
translate russian anna_event_12_e995767d:
    "В состоянии блаженства от очевидного восторга Анны, я не обращаю внимания на то, куда мы идем."

# ch/anna/events.rpy:1761
translate russian anna_event_12_f2928ede:
    "И прежде чем я успеваю опомниться, она пробирается сквозь большую часть толпы."

# ch/anna/events.rpy:1762
translate russian anna_event_12_f99e50e5:
    "Анна продолжает толкаться локтями и проталкиваться вперед, пока мы не достигаем барьеров в самом переднем ряду."

# ch/anna/events.rpy:1763
translate russian anna_event_12_312b3616:
    "Мне это не проблема, так как я могу легко видеть через головы людей, стоящих передо мной."

# ch/anna/events.rpy:1764
translate russian anna_event_12_11c13656:
    "Анна, в свою очередь, уже изо всех сил пытается что-нибудь разглядеть отсюда."

# ch/anna/events.rpy:1765
translate russian anna_event_12_075fa9cf:
    "Она пытается встать на носочки, а потом подпрыгивает на месте."

# ch/anna/events.rpy:1766
translate russian anna_event_12_5343f9a5:
    "Но это бесполезно, она не сможет увидеть сцену без какой-нибудь возвышенности или ходулей!"

# ch/anna/events.rpy:1767
translate russian anna_event_12_81ab76ca:
    mike.say "Эм, Анна..."

# ch/anna/events.rpy:1768
translate russian anna_event_12_5bd7df83:
    mike.say "Может быть, у нас будет лучший вид сзади?"

# ch/anna/events.rpy:1772
translate russian anna_event_12_72e0831a:
    anna.say "Ты что, спятил?!"

# ch/anna/events.rpy:1773
translate russian anna_event_12_ded8f606:
    anna.say "Это же концерт Metallikea, [lssb_anna.hero_name()]."

# ch/anna/events.rpy:1774
translate russian anna_event_12_f0db409f:
    anna.say "Кто захочет пропустить возможность быть как можно ближе?!?"

# ch/anna/events.rpy:1777
translate russian anna_event_12_01a45fcd:
    "В этот момент загорается свет, и толпа ревет в предвкушении."

# ch/anna/events.rpy:1778
translate russian anna_event_12_350cb7aa:
    "Что еще хуже, они бросаются вперед, надеясь получить наилучший вид."

# ch/anna/events.rpy:1781
translate russian anna_event_12_325c98c2:
    "Мы с Анной едва не падаем, даже до начала первой песни!"

# ch/anna/events.rpy:1782
translate russian anna_event_12_ae6daaf0:
    "Я изо всех сил стараюсь удержаться на ногах и одновременно поддержать ее."

# ch/anna/events.rpy:1783
translate russian anna_event_12_1bbfa73a:
    "Но все только ухудшается, когда первые аккорды гремят по звуковой системе."

# ch/anna/events.rpy:1784
translate russian anna_event_12_8e742e04:
    "Крепко держась за Анну, я узнаю песню, с которой они начинают выступление."

# ch/anna/events.rpy:1785
translate russian anna_event_12_f5cd4a12:
    "Это очень тяжелый номер, который почти всегда сводит толпу с ума."

# ch/anna/events.rpy:1786
translate russian anna_event_12_84aadf87:
    "А это значит лишь одно: МОШПИТ!!!"

# ch/anna/events.rpy:1788
translate russian anna_event_12_8b2b21a1:
    "Первое тело врезается в меня сзади через секунду."

# ch/anna/events.rpy:1790
translate russian anna_event_12_724e48cb:
    "Я слышу крик Анны, который мог быть вызван либо ужасом, либо восторгом."

# ch/anna/events.rpy:1791
translate russian anna_event_12_3dbd4641:
    "С трудом удерживаясь на ногах, я понимаю, что только я могу ее спасти!"

# ch/anna/events.rpy:1793
translate russian anna_event_12_dc6a5553:
    "К счастью, я ветеран толкучек и могу это доказать шрамами!"

# ch/anna/events.rpy:1794
translate russian anna_event_12_bcdd3c7f:
    "Еще до того, как второе тело ударится обо меня, я уже двигаюсь и увожу Анну с собой."

# ch/anna/events.rpy:1795
translate russian anna_event_12_d282c7f2:
    "Я перекатываюсь, уклоняясь от ударов, которые начинают сыпаться со всех сторон."

# ch/anna/events.rpy:1797
translate russian anna_event_12_1411f80a:
    "Но одновременно я пытаюсь использовать эти удары в своих интересах, подпрыгивая то туда, то сюда."

# ch/anna/events.rpy:1799
translate russian anna_event_12_7891753e:
    anna.say "[lssb_anna.hero_name()]!"

# ch/anna/events.rpy:1800
translate russian anna_event_12_0a208149:
    anna.say "Помоги мне!"

# ch/anna/events.rpy:1801
translate russian anna_event_12_49634b20:
    "Я мог бы остановиться и спросить Анну, что она вообще думает, что я сейчас делаю!"

# ch/anna/events.rpy:1802
translate russian anna_event_12_ca4e4e21:
    "Но сомневаюсь, что она услышала бы хоть слово из того, что я ей скажу."

# ch/anna/events.rpy:1803
translate russian anna_event_12_b6cac038:
    "Вместо этого я продолжаю двигаться, следя за тем, чтобы любой удар, который может попасть на нее, пришелся на меня."

# ch/anna/events.rpy:1804
translate russian anna_event_12_77d45cfc:
    "Тот факт, что я активно ищу Анну, означает, что я не могу достаточно хорошо защитить себя."

# ch/anna/events.rpy:1806
translate russian anna_event_12_9f0f2c6f:
    "Головы бьются о мою, локти ударяют в мои ребра, а несколько коленей попадают в пах."

# ch/anna/events.rpy:1807
translate russian anna_event_12_a9097983:
    "В какой-то момент я даже прикусываю язык и чувствую вкус крови."

# ch/anna/events.rpy:1808
translate russian anna_event_12_6c434572:
    "И вот, когда я думаю, что сейчас потеряю сознание, все заканчивается."

# ch/anna/events.rpy:1809
translate russian anna_event_12_e0bdc8a2:
    "Избитый и помятый, я наконец-то вываливаюсь из толпы, когда песня заканчивается."

# ch/anna/events.rpy:1810
translate russian anna_event_12_b891b470:
    "Честно говоря, думаю, я бы упал, если бы не Анна, которая меня поддерживала."

# ch/anna/events.rpy:1812
translate russian anna_event_12_c88ac2e3:
    anna.say "[lssb_anna.hero_name()], ты в порядке?"

# ch/anna/events.rpy:1813
translate russian anna_event_12_9c783553:
    "В ее голосе слышна искренняя тревога, когда она смотрит на меня."

# ch/anna/events.rpy:1814
translate russian anna_event_12_a1eb81c2:
    "Я качаю головой, пытаясь успокоить ее."

# ch/anna/events.rpy:1815
translate russian anna_event_12_2e985438:
    mike.say "Не волнуйся обо мне, Анна..."

# ch/anna/events.rpy:1816
translate russian anna_event_12_e7ab4285:
    "Атмосфера немного рушится, когда я на секунду сощуриваюсь от боли."

# ch/anna/events.rpy:1817
translate russian anna_event_12_03e99ffc:
    mike.say "Серьёзно, ты как?"

# ch/anna/events.rpy:1819
translate russian anna_event_12_42bda660:
    anna.say "Я в порядке, [lssb_anna.hero_name()], благодаря тебе."

# ch/anna/events.rpy:1821
translate russian anna_event_12_d4bad10a:
    anna.say "Ты спасла меня от того, чтобы меня затоптали там!"

# ch/anna/events.rpy:1825
translate russian anna_event_12_e9c67c58:
    "Она притягивает меня к себе и целует в губы."

# ch/anna/events.rpy:1826
translate russian anna_event_12_477a3a87:
    "Это поцелуй – страстный, искренний и полный чувств."

# ch/anna/events.rpy:1830
translate russian anna_event_12_939dec98:
    "Но Анна прерывает его, когда я морщусь и кричу от боли."

# ch/anna/events.rpy:1831
translate russian anna_event_12_47f8f63a:
    anna.say "Ох, боже мой."

# ch/anna/events.rpy:1832
translate russian anna_event_12_7f153f5c:
    anna.say "Бедный мой, раненый герой!"

# ch/anna/events.rpy:1833
translate russian anna_event_12_8f8cf823:
    anna.say "Пойдём, отведу тебя на балкон."

# ch/anna/events.rpy:1835
translate russian anna_event_12_31c681bb:
    anna.say "Медсестра Анна прописывает тебе пиво и все свое внимание!"

# ch/anna/events.rpy:1836
translate russian anna_event_12_19edbebd:
    "Я киваю и стараюсь следовать за Анной, которая уводит меня от толпы."

# ch/anna/events.rpy:1837
translate russian anna_event_12_d6cc1cdc:
    "И если она хочет уделять мне все свое внимание всю ночь, кто я такой, чтобы спорить?"

# ch/anna/events.rpy:1838
translate russian anna_event_12_5fbd906a:
    "В конце концов, она же сказала, что я ее герой!"

# ch/anna/events.rpy:1840
translate russian anna_event_12_410dbcec:
    "Хотя мне удается увернуться от первого, кто на меня нападает, со вторым все иначе."

# ch/anna/events.rpy:1842
translate russian anna_event_12_67e6aab8:
    "Все еще пошатываясь после первого столкновения, этот человек сбивает меня с ног, и я теряю хватку за Анну."

# ch/anna/events.rpy:1843
translate russian anna_event_12_531e4e5e:
    "Прежде чем я успеваю понять, куда меня толкнули, ее уводят от меня."

# ch/anna/events.rpy:1845
translate russian anna_event_12_08d2322b:
    "Из-за моего невысокого роста, я даже не могу разглядеть ее в этой толпе покачивающихся голов."

# ch/anna/events.rpy:1846
translate russian anna_event_12_7891753e_1:
    anna.say "[lssb_anna.hero_name()]!"

# ch/anna/events.rpy:1847
translate russian anna_event_12_0a208149_1:
    anna.say "Помогите мне!"

# ch/anna/events.rpy:1848
translate russian anna_event_12_19deb41e:
    "Я поворачиваюсь в ту сторону, откуда, как мне кажется, доносится ее голос, и бросаюсь в гущу событий."

# ch/anna/events.rpy:1850
translate russian anna_event_12_c0ab602a:
    "Но независимо от того, насколько сильно я толкаюсь, проталкиваюсь и наступаю на эту массу тел, это ни к чему не приводит."

# ch/anna/events.rpy:1851
translate russian anna_event_12_ea441426:
    "И тот факт, что я активно ищу Анну, означает, что я не могу достаточно хорошо защитить себя."

# ch/anna/events.rpy:1853
translate russian anna_event_12_9f0f2c6f_1:
    "Головы бьются о мою, локти ударяют в мои ребра, а несколько коленей попадают в пах."

# ch/anna/events.rpy:1854
translate russian anna_event_12_a9097983_1:
    "В какой-то момент я даже прикусываю язык и чувствую вкус крови."

# ch/anna/events.rpy:1855
translate russian anna_event_12_e0bdc8a2_1:
    "Избитый и помятый, я наконец-то вываливаюсь из толпы, когда песня заканчивается."

# ch/anna/events.rpy:1856
translate russian anna_event_12_805eea37:
    "Задыхаясь, я осматриваю толпу, отчаянно ища хоть какой-нибудь знак Анны."

# ch/anna/events.rpy:1857
translate russian anna_event_12_bf434e52:
    anna.say "Вот ты где!"

# ch/anna/events.rpy:1858
translate russian anna_event_12_13e11500:
    "Ошеломленный, услышав ее голос, я оборачиваюсь к Анне."

# ch/anna/events.rpy:1860
translate russian anna_event_12_db448074:
    "Она стоит там, скрестив руки на груди и постукивая ногой по полу."

# ch/anna/events.rpy:1861
translate russian anna_event_12_a7b59bab:
    "Да, она выглядит немного растрепанной."

# ch/anna/events.rpy:1862
translate russian anna_event_12_c218bad1:
    "Но это ничто по сравнению с тем бардаком, в котором я сейчас должен быть!"

# ch/anna/events.rpy:1863
translate russian anna_event_12_621132fd:
    mike.say "Анна..."

# ch/anna/events.rpy:1864
translate russian anna_event_12_e8fe4e5b:
    mike.say "Как ты...?"

# ch/anna/events.rpy:1866
translate russian anna_event_12_c51d56e3:
    anna.say "Один из охранников вытащил меня через несколько секунд."

# ch/anna/events.rpy:1868
translate russian anna_event_12_8fcdd62a:
    anna.say "И все это благодаря тебе!"

# ch/anna/events.rpy:1869
translate russian anna_event_12_c673d1ed:
    anna.say "Ты намеренно толкнул меня туда, чтобы это произошло, да?"

# ch/anna/events.rpy:1871
translate russian anna_event_12_5ea11c97:
    "Я смотрю на нее некоторое время."

# ch/anna/events.rpy:1872
translate russian anna_event_12_ca8567f1:
    "Мой рот открывается, но слов не выходит."

# ch/anna/events.rpy:1874
translate russian anna_event_12_4368c34d:
    anna.say "Ох, хватит уже вести себя как ребенок, [lssb_anna.hero_name()]!"

# ch/anna/events.rpy:1876
translate russian anna_event_12_66385a63:
    anna.say "Давай найдём место на балконе, как ты и хотел!"

# ch/anna/events.rpy:1877
translate russian anna_event_12_1452054a:
    "Анна хватает меня за запястье и болезненно тянет за собой."

# ch/anna/events.rpy:1878
translate russian anna_event_12_82683006:
    "Остаток выступления я провел в подавленном состоянии и с болью от множества ран."

# ch/anna/events.rpy:1879
translate russian anna_event_12_b3810404:
    "И всё это время я дивлюсь её уверенности в том, что мне намеренно наваляли!"

# ch/anna/events.rpy:1884
translate russian anna_event_13_e6f3c6a2:
    "Мне нравится заниматься с Анной интересными вещами, такими, которые создадут прекрасные воспоминания, которые мы никогда не забудем."

# ch/anna/events.rpy:1885
translate russian anna_event_13_374fbe26:
    "Но также приятно иметь возможность просто посидеть и провести время вместе с ней."

# ch/anna/events.rpy:1886
translate russian anna_event_13_3b4ddd2b:
    "Ну, просто болтать, смеяться вместе и наслаждаться обществом друг друга."

# ch/anna/events.rpy:1888
translate russian anna_event_13_bb9a48ca:
    "Например, сейчас мы сидим в пабе \"Уинчестер\", пьем и разговариваем обо всем, что приходит в голову."

# ch/anna/events.rpy:1889
translate russian anna_event_13_93c8d4fc:
    "Это напоминает мне о том, какая Анна на самом деле милая и забавная, а также невероятно сексуальная!"

# ch/anna/events.rpy:1890
translate russian anna_event_13_a75abf1c:
    "И это также напоминает мне о том, какой я счастливый парень, что она рядом со мной."

# ch/anna/events.rpy:1891
translate russian anna_event_13_44e1df9f:
    "Я наблюдаю, как Анна допивает свое пиво и ставит пустой бокал на стол."

# ch/anna/events.rpy:1892
translate russian anna_event_13_6ccbe3c1:
    "Через секунду она не может удержаться и издает небольшой звук отрыжки, покраснев от смущения."

# ch/anna/events.rpy:1893
translate russian anna_event_13_97a2e82e:
    anna.say "Ой..."

# ch/anna/events.rpy:1894
translate russian anna_event_13_561251f0:
    anna.say "Прости, [lssb_anna.hero_name()]!"

# ch/anna/events.rpy:1895
translate russian anna_event_13_ada81ff9:
    mike.say "Все в порядке, Анна."

# ch/anna/events.rpy:1896
translate russian anna_event_13_8ba52b01:
    mike.say "Хочешь, я закажу тебе еще?"

# ch/anna/events.rpy:1897
translate russian anna_event_13_99aa19c5:
    "Анна смеется над этим предложением, наклоняя голову набок с преувеличенным жестом."

# ch/anna/events.rpy:1898
translate russian anna_event_13_9683d2d9:
    "И только сейчас я замечаю, что она покраснела не только от смущения, но и из-за алкоголя."

# ch/anna/events.rpy:1899
translate russian anna_event_13_f844adf4:
    anna.say "Эй..."

# ch/anna/events.rpy:1900
translate russian anna_event_13_b8664e68:
    anna.say "Ты пытаешься меня напоить?!"

# ch/anna/events.rpy:1901
translate russian anna_event_13_a6ab80b3:
    "Мне кажется, что поезд уже ушел."

# ch/anna/events.rpy:1902
translate russian anna_event_13_1915288f:
    "Но вместо этого я сдерживаю себя и смеюсь вместе с Анной."

# ch/anna/events.rpy:1903
translate russian anna_event_13_853bd0ba:
    mike.say "А что, если я и пытаюсь?"

# ch/anna/events.rpy:1904
translate russian anna_event_13_c6546d5b:
    mike.say "Ты такая милая, когда пьяная, Анна!"

# ch/anna/events.rpy:1905
translate russian anna_event_13_d116995c:
    mike.say "И я знаю, что тебе нравится, когда я пользуюсь тобой..."

# ch/anna/events.rpy:1906
translate russian anna_event_13_bc8c7a9e:
    "От этого Анна просто заливается тихим смехом."

# ch/anna/events.rpy:1907
translate russian anna_event_13_7476e90d:
    "Она игриво хлопает меня по груди, но я уже вижу блеск в ее глазах."

# ch/anna/events.rpy:1908
translate russian anna_event_13_e440d604:
    "Это тот взгляд, который я знаю, означает, что она представляет себе возможности на эту ночь..."

# ch/anna/events.rpy:1911
translate russian anna_event_13_8b79e0b6:
    "Гвендолин" "Фу!"

# ch/anna/events.rpy:1912
translate russian anna_event_13_d34d3222:
    "Гвендолин" "Найдите себе отдельную комнату!"

# ch/anna/events.rpy:1914
translate russian anna_event_13_304543f6:
    "Этот голос принадлежит кому-то, кто проходил мимо нашего столика в сторону бара."

# ch/anna/events.rpy:1915
translate russian anna_event_13_f291c354:
    "Это довольно низкий голос и он исходит от высокого человека, которого я сначала принял за парня."

# ch/anna/events.rpy:1917
translate russian anna_event_13_63474e64:
    "Но потом я вижу, как лицо Анны становится темным от гнева, и понимаю, что это вовсе не парень."

# ch/anna/events.rpy:1918
translate russian anna_event_13_aae058df:
    "На самом деле, все гораздо хуже!"

# ch/anna/events.rpy:1920
translate russian anna_event_13_396e01c2:
    anna.say "ГВЕН!"

# ch/anna/events.rpy:1921
translate russian anna_event_13_997eccbe:
    anna.say "Что ты только что сказала?!"

# ch/anna/events.rpy:1924
translate russian anna_event_13_f542f933:
    "Прежде чем я успеваю произнести ни слова, бывшая девушка Анны резко оборачивается."

# ch/anna/events.rpy:1925
translate russian anna_event_13_98c94388:
    "Гвен недовольно смотрит на нас, используя каждый сантиметр своего роста в своих интересах."

# ch/anna/events.rpy:1926
translate russian anna_event_13_e12ec983:
    "Гвендолин" "Ты слышала, что я сказала, Анна."

# ch/anna/events.rpy:1927
translate russian anna_event_13_4e7cae13:
    "Гвендолин" "И этого мало, ты еще и опустилась после того, что было между нами."

# ch/anna/events.rpy:1928
translate russian anna_event_13_931b3e80:
    "Гвендолин" "Но тебе правда нужно вылизывать этого неудачника на публике?"

# ch/anna/events.rpy:1929
translate russian anna_event_13_d6213232:
    mike.say "Эй, кого это ты назвала неудачником?!"

# ch/anna/events.rpy:1930
translate russian anna_event_13_f136958f:
    "Почти одновременно Анна и Гвен поворачиваются ко мне."

# ch/anna/events.rpy:1931
translate russian anna_event_13_cd036650:
    "Гвендолин" "Да замолчи уже."

# ch/anna/events.rpy:1932
translate russian anna_event_13_eef76ee2:
    "Гвендолин" "Я не спрашивала этого говорящего члена для его мнения!"

# ch/anna/events.rpy:1934
translate russian anna_event_13_693d17c6:
    anna.say "Не разговаривай с ним так, сука!"

# ch/anna/events.rpy:1936
translate russian anna_event_13_5246941b:
    anna.say "Но серьезно, [lssb_anna.hero_name()], заткнись."

# ch/anna/events.rpy:1937
translate russian anna_event_13_774a6bce:
    anna.say "Это моя битва."

# ch/anna/events.rpy:1938
translate russian anna_event_13_0ecb0ee7:
    anna.say "Пришло время дать отпор ей, раз и навсегда!"

# ch/anna/events.rpy:1939
translate russian anna_event_13_e1ba349b:
    "Гвен взрывается смехом над заявлением Анны, скрестив руки на груди."

# ch/anna/events.rpy:1940
translate russian anna_event_13_d2a9b45a:
    "С моей точки зрения, это только подчеркивает ее сходство с персонажем из сказки – злобной ведьмой."

# ch/anna/events.rpy:1941
translate russian anna_event_13_63a4c40a:
    "На самом деле, я бы не удивился, если бы она ответила мне угрозой перемолоть мои кости в муку для хлеба!"

# ch/anna/events.rpy:1942
translate russian anna_event_13_9887c115:
    "Гвендолин" "Не заставляй меня смеяться еще громче, Анна."

# ch/anna/events.rpy:1943
translate russian anna_event_13_73e1814b:
    "Гвендолин" "Что ты собираешься делать, а?"

# ch/anna/events.rpy:1944
translate russian anna_event_13_73c199a3:
    "Гвендолин" "Ударить меня в коленки?"

# ch/anna/events.rpy:1945
translate russian anna_event_13_676e69a9:
    "Гвендолин" "Нападать на меня сзади?"

# ch/anna/events.rpy:1947
translate russian anna_event_13_0d9264c5:
    "Я вижу, как гнев растет в Анне каждую секунду."

# ch/anna/events.rpy:1948
translate russian anna_event_13_43800592:
    "И теперь румянец на ее щеках вызван чистой ненавистью к Гвен!"

# ch/anna/events.rpy:1949
translate russian anna_event_13_1c2eb984:
    "Прежде чем я успеваю остановить ее, она запрыгивает на сиденье своего стула."

# ch/anna/events.rpy:1951
translate russian anna_event_13_9e8ea081:
    "Анна приседает, как кошка, на мгновение, а затем бросается на Гвен."

# ch/anna/events.rpy:1952
translate russian anna_event_13_81704929:
    "Девушка выше ростом, которая была так же удивлена, как и я, не успевает защититься."

# ch/anna/events.rpy:1957
translate russian anna_event_13_833bdcab:
    "Что означает, что когда сжатый кулак Анны попадает ей в подбородок, она падает, как карточный домик."

# ch/anna/events.rpy:1959
translate russian anna_event_13_9ffee74b:
    "Гвен приземляется грудой на полу паба, а Анна оказывается сверху нее."

# ch/anna/events.rpy:1960
translate russian anna_event_13_0cc94706:
    "Она хватает горсть воротника Гвен и поднимает свой другой кулак для второго удара."

# ch/anna/events.rpy:1961
translate russian anna_event_13_d84cc06b:
    "Гвендолин" "Нет..."

# ch/anna/events.rpy:1962
translate russian anna_event_13_96c9ae98:
    "Гвендолин" "Нет, Анна, пожалуйста!"

# ch/anna/events.rpy:1968
translate russian anna_event_13_64642cb0:
    "Мне следовало бы сейчас же сказать Анне, чтобы она остановилась."

# ch/anna/events.rpy:1969
translate russian anna_event_13_1aa4881c:
    "Но часть меня знает, что ей нужно это сделать."

# ch/anna/events.rpy:1970
translate russian anna_event_13_09401598:
    "Гвен выглядит совершенно потрясенной от происходящего."

# ch/anna/events.rpy:1971
translate russian anna_event_13_f99168ab:
    "Думаю, она никогда не предполагала, что Анна на такое способна!"

# ch/anna/events.rpy:1972
translate russian anna_event_13_131b6026:
    anna.say "Не смей мне тут ныть, сука!"

# ch/anna/events.rpy:1973
translate russian anna_event_13_c14f9217:
    "Кулак Анны обрушивается."

# ch/anna/events.rpy:1977
translate russian anna_event_13_ce8b12cd:
    "И раздается отвратительный звук ломающегося хряща."

# ch/anna/events.rpy:1978
translate russian anna_event_13_be9ad9ac:
    "Гвендолин" "Ааа..."

# ch/anna/events.rpy:1979
translate russian anna_event_13_26888304:
    "Гвендолин" "Черт, черт, черт!"

# ch/anna/events.rpy:1980
translate russian anna_event_13_0cde489b:
    "Гвендолин" "Ты сломала мне нос, сука!"

# ch/anna/events.rpy:1982
translate russian anna_event_13_581abbde:
    "Анна слезает с более высокой девушки."

# ch/anna/events.rpy:1983
translate russian anna_event_13_ddbc249e:
    "Она стряхивает руки, на ее лице довольная улыбка."

# ch/anna/events.rpy:1984
translate russian anna_event_13_3ef196bf:
    anna.say "Ты сама этого захотела, Гвен."

# ch/anna/events.rpy:1985
translate russian anna_event_13_5614174d:
    anna.say "Я должна была сделать это ДАВНО!"

# ch/anna/events.rpy:1986
translate russian anna_event_13_7a4035dd:
    "Только сейчас Анна действительно смотрит на меня."

# ch/anna/events.rpy:1987
translate russian anna_event_13_c78823b2:
    "И мгновенно я вижу, как ее уверенность начинает угасать."

# ch/anna/events.rpy:1988
translate russian anna_event_13_79a2e9e1:
    "Мне очевидно, что она ищет моего одобрения ее действий."

# ch/anna/events.rpy:1991
translate russian anna_event_13_ee7efdd4:
    mike.say "Ого, Анна, ты моя героиня!"

# ch/anna/events.rpy:1992
translate russian anna_event_13_804ae279:
    mike.say "В следующий раз, когда кто-то начнет надо мной издеваться, я тебе позвоню!"

# ch/anna/events.rpy:1994
translate russian anna_event_13_f33b69b0:
    "Анна улыбается, и на этот раз она действительно краснеет."

# ch/anna/events.rpy:1995
translate russian anna_event_13_77f049ef:
    "Она подходит туда, где я сижу, и поднимает меня на ноги."

# ch/anna/events.rpy:1997
translate russian anna_event_13_1dddb2ad:
    anna.say "Давай, [lssb_anna.hero_name()]."

# ch/anna/events.rpy:1998
translate russian anna_event_13_89256ef8:
    anna.say "Теперь ты должен отвезти меня домой!"

# ch/anna/events.rpy:1999
translate russian anna_event_13_1a9e8f5f:
    mike.say "Ого... хорошо, хорошо!"

# ch/anna/events.rpy:2000
translate russian anna_event_13_0f94f2b6:
    mike.say "Что бы ты ни сказала, Анна."

# ch/anna/events.rpy:2001
translate russian anna_event_13_ce691d1a:
    mike.say "Только пообещай и меня не приложить. Разве что поцелуем!"

# ch/anna/events.rpy:2003
translate russian anna_event_13_aa29170a:
    "Анна смеется и обнимает меня руками, и мы идем к двери."

# ch/anna/events.rpy:2004
translate russian anna_event_13_5f7acac4:
    "Я не могу отвести взгляд от нее, даже один раз не оглядываясь на Гвен."

# ch/anna/events.rpy:2006
translate russian anna_event_13_be86d884:
    "Я знаю, что сейчас должен поддерживать Анну."

# ch/anna/events.rpy:2007
translate russian anna_event_13_a086b8f0:
    "Но выражение лица Гвен – это искренний страх."

# ch/anna/events.rpy:2008
translate russian anna_event_13_e8ea5a69:
    "Она даже не пытается сопротивляться."

# ch/anna/events.rpy:2009
translate russian anna_event_13_80dbf95d:
    "Какой бы я был мужик, если бы позволил ей так избивать?"

# ch/anna/events.rpy:2010
translate russian anna_event_13_9f68c4d2:
    mike.say "Анна, ты что, чёрт возьми, творишь?!"

# ch/anna/events.rpy:2011
translate russian anna_event_13_6a9a1b87:
    "От моего голоса кулак Анны замирает в воздухе."

# ch/anna/events.rpy:2012
translate russian anna_event_13_10abeed6:
    "Обе она и Гвен смотрят на меня снизу вверх, лежа на полу."

# ch/anna/events.rpy:2013
translate russian anna_event_13_59723b6f:
    "Мне кажется, я вижу облегчение и благодарность в глазах Гвен."

# ch/anna/events.rpy:2014
translate russian anna_event_13_4f548d1e:
    "Но Анна просто выглядит растерянной, как будто не понимает, что происходит."

# ch/anna/events.rpy:2016
translate russian anna_event_13_ad4abb06:
    anna.say "Ч...что ты имеешь в виду?"

# ch/anna/events.rpy:2017
translate russian anna_event_13_9308b3f2:
    anna.say "Ты слышал, что она сказала, [lssb_anna.hero_name()]!"

# ch/anna/events.rpy:2018
translate russian anna_event_13_1218b7ff:
    mike.say "Да, Анна, я услышал."

# ch/anna/events.rpy:2019
translate russian anna_event_13_5d258a48:
    mike.say "Но ты же первой нанесла удар!"

# ch/anna/events.rpy:2020
translate russian anna_event_13_f95998d7:
    mike.say "Как это делает тебя лучше нее?"

# ch/anna/events.rpy:2022
translate russian anna_event_13_229de9d6:
    "Анна слезает с Гвен, выглядя стыдно и смущенно."

# ch/anna/events.rpy:2026
translate russian anna_event_13_a773c6e3:
    anna.say "Я...я извинилась, [lssb_anna.hero_name()]."

# ch/anna/events.rpy:2027
translate russian anna_event_13_e7d511b1:
    anna.say "Я просто потеряла голову!"

# ch/anna/events.rpy:2029
translate russian anna_event_13_b674f959:
    "Я качаю головой, встаю и подхожу к тому месту, где Гвен все еще лежит на полу."

# ch/anna/events.rpy:2031
translate russian anna_event_13_69a2054e:
    "Опустившись на колени, я помогаю более высокой девушке подняться, не глядя в сторону Анны."

# ch/anna/events.rpy:2032
translate russian anna_event_13_56dc535d:
    mike.say "Ты в порядке, Гвен?"

# ch/anna/events.rpy:2033
translate russian anna_event_13_c2fbb5b3:
    "Она смотрит на меня так, будто впадает в состояние полного шока."

# ch/anna/events.rpy:2035
translate russian anna_event_13_c2936302:
    "Но затем она быстро кивает и отстраняется от меня."

# ch/anna/events.rpy:2036
translate russian anna_event_13_2e2fa63e:
    "Гвендолин" "Д...да..."

# ch/anna/events.rpy:2037
translate russian anna_event_13_802516a6:
    "Гвендолин" "У меня все хорошо..."

# ch/anna/events.rpy:2038
translate russian anna_event_13_847ea928:
    "И с этими словами она проталкивается сквозь толпу и выходит из паба."

# ch/anna/events.rpy:2040
translate russian anna_event_13_21eaeb48:
    "Я снова сажусь, а Анна следует за мной через некоторое время."

# ch/anna/events.rpy:2041
translate russian anna_event_13_f1bcbdd9:
    "Я чувствую, что она хочет спросить меня о том, что я только что сделал, почему я помог Гвен."

# ch/anna/events.rpy:2042
translate russian anna_event_13_a2c796fd:
    "Но неприятное ощущение от того, что мне пришлось \"потерять лицо\" перед всем пабом, все еще тяготит ее."

# ch/anna/events.rpy:2043
translate russian anna_event_13_964a51b1:
    "И поэтому она сидит там в тишине, одна со своими мыслями."

# ch/anna/events.rpy:2053
translate russian anna_male_ending_36090151:
    "Я думаю, что никогда по-настоящему не знаешь человека так хорошо, как тебе кажется, даже когда ты собираешься с ним жениться."

# ch/anna/events.rpy:2054
translate russian anna_male_ending_40ec4bd6:
    "Но я был уверен, что я достаточно хорошо знаю Анну за время нашего знакомства, как друзей и участников группы."

# ch/anna/events.rpy:2055
translate russian anna_male_ending_fbd5cfe2:
    "Особенно за то время, которое мы встречались и наши отношения становились все более серьезными."

# ch/anna/events.rpy:2056
translate russian anna_male_ending_bdc2dd4f:
    "Я имею в виду, что узнавать Анну и все ее маленькие особенности было тем, что заставило меня захотеть жениться на ней!"

# ch/anna/events.rpy:2057
translate russian anna_male_ending_af57ab27:
    "И, учитывая, что она не самая обычная девушка, я предполагал, что ей захочется, чтобы этот важный день был ярким и безумным."

# ch/anna/events.rpy:2058
translate russian anna_male_ending_53367b4a:
    "Я не знаю точно, что я себе представлял, может быть, пожениться во время прыжка с банджи или что-то в этом роде."

# ch/anna/events.rpy:2059
translate russian anna_male_ending_a6c3d54d:
    "Поэтому меня удивило, когда Анна начала говорить о церквях и белых платьях."

# ch/anna/events.rpy:2060
translate russian anna_male_ending_9922bb1a:
    "Ты знаешь, все то, что обычно ассоциируется с традиционной свадебной церемонией!"

# ch/anna/events.rpy:2061
translate russian anna_male_ending_7b22ac2c:
    "Сначала я не был уверен, говорит ли она мне правду, или просто говорит то, что, как ей кажется, я хочу услышать."

# ch/anna/events.rpy:2062
translate russian anna_male_ending_460d537d:
    "Но довольно скоро я убедился, что это действительно то, чего Анна хочет от дня, когда мы скажем \"да\"."

# ch/anna/events.rpy:2063
translate russian anna_male_ending_a0cf14a5:
    "И поэтому я просто пожал плечами и продолжил подготовку."

# ch/anna/events.rpy:2064
translate russian anna_male_ending_6e068956:
    "Разумеется, я не стал пожимать плечами прямо перед ней. Не настолько я глуп."

# ch/anna/events.rpy:2065
translate russian anna_male_ending_212bfaeb:
    "Я просто согласился с идеей сохранить все просто и традиционно, потому что этого хотела она."

# ch/anna/events.rpy:2066
translate russian anna_male_ending_1c99c4e7:
    "Но, несмотря на то, что я соглашался со всем этим, я никогда полностью не был уверен, что это правильно для нас."

# ch/anna/events.rpy:2067
translate russian anna_male_ending_0ad2dfaa:
    "И я чувствовал это до самой последней секунды."

# ch/anna/events.rpy:2068
translate russian anna_male_ending_7beeb7f8:
    "В тот момент, когда я слышу музыку, которую Анна выбрала для своего появления в церкви."

# ch/anna/events.rpy:2069
translate russian anna_male_ending_d8823b8e:
    "Мгновенно я перестаю возиться с этим неудобным галстуком, который мне пришлось надеть на этот случай."

# ch/anna/events.rpy:2070
translate russian anna_male_ending_0f1afe03:
    "И я с нетерпением оглядываюсь через плечо."

# ch/anna/events.rpy:2071
translate russian anna_male_ending_967953ad:
    "Сначала я вообще не могу ее увидеть, когда она входит в церковь."

# ch/anna/events.rpy:2072
translate russian anna_male_ending_bd4ec7f8:
    "Анна такая маленькая, что, когда все гости встают, она просто теряется из виду."

# ch/anna/events.rpy:2073
translate russian anna_male_ending_cdb393a1:
    "Но потом она поворачивается и идет по проходу, и я вижу ее впервые."

# ch/anna/events.rpy:2075
translate russian anna_male_ending_e6969058:
    "В этот момент все мои сомнения исчезают."

# ch/anna/events.rpy:2076
translate russian anna_male_ending_42cf67c0:
    "Все мои тревоги уходят в никуда."

# ch/anna/events.rpy:2077
translate russian anna_male_ending_33663bd6:
    "Я уверен, это так."

# ch/anna/events.rpy:2078
translate russian anna_male_ending_c02328e6:
    "И все из-за нее."

# ch/anna/events.rpy:2079
translate russian anna_male_ending_3648ff9a:
    "Из-за Анны."

# ch/anna/events.rpy:2080
translate russian anna_male_ending_50715cf0:
    "Слушай, я понимаю, что здесь должно быть все нежное и милое."

# ch/anna/events.rpy:2082
translate russian anna_male_ending_30bb3dcd:
    "Черт возьми, как же она хорошо выглядит в этом легком, белом платье!"

# ch/anna/events.rpy:2083
translate russian anna_male_ending_5af6ca0d:
    "Кто бы это ни сделал, старался сдержать все."

# ch/anna/events.rpy:2085
translate russian anna_male_ending_0728f9ac:
    "Но каждая изгиб ее прекрасного тела проступает сквозь него, словно поэзия в движении."

# ch/anna/events.rpy:2087
translate russian anna_male_ending_2d8a6129:
    "А еще этот взгляд на ее лице, улыбка и то, как сейчас сияют ее глаза."

# ch/anna/events.rpy:2088
translate russian anna_male_ending_4ee44d40:
    "Это почти так же возбуждает меня, как вид ее груди, покачивающейся под корсетом платья."

# ch/anna/events.rpy:2090
translate russian anna_male_ending_8ee6a7f7:
    "По привычке я представляю, как снимаю с нее одежду."

# ch/anna/events.rpy:2091
translate russian anna_male_ending_88778870:
    "Но могу только представить, каким может быть нижнее белье, которое она выбрала!"

# ch/anna/events.rpy:2093
translate russian anna_male_ending_27845501:
    "Я также вижу, что швея постаралась скрыть ее вздувшийся живот."

# ch/anna/events.rpy:2094
translate russian anna_male_ending_24ea6b7e:
    "Но, если честно, этот вид делает меня счастливее, чем когда-либо."

# ch/anna/events.rpy:2095
translate russian anna_male_ending_5f122b7f:
    "Ни для кого из нас нет стыда в том, что мы ждем ребенка."

# ch/anna/events.rpy:2096
translate russian anna_male_ending_4f528f41:
    "Это лишь доказательство нашей любви и обещание нашего совместного будущего."

# ch/anna/events.rpy:2098
translate russian anna_male_ending_f4a04457:
    "Анна, держа букет цветов в руках, подходит ко мне и выглядит так, будто вот-вот лопнет."

# ch/anna/events.rpy:2099
translate russian anna_male_ending_24724a47:
    "Когда священник просит всех сесть, я изо всех сил стараюсь отвести взгляд от нее."

# ch/anna/events.rpy:2100
translate russian anna_male_ending_84d57efc:
    "Священник" "Дорогие братья и сестры, мы собрались здесь сегодня, чтобы стать свидетелями союза этих двух душ."

# ch/anna/events.rpy:2101
translate russian anna_male_ending_981e5b9f:
    "Священник" "Их объединение в священные узы брака..."

# ch/anna/events.rpy:2102
translate russian anna_male_ending_071fc56f:
    "Остальная часть церемонии для меня проходит как в тумане."

# ch/anna/events.rpy:2103
translate russian anna_male_ending_7c68f25d:
    "Слова, которые мне следовало бы запомнить и услышать, но они не доходят до моего сознания."

# ch/anna/events.rpy:2105
translate russian anna_male_ending_0af9f2d6:
    "Все, что я могу делать, это смотреть на Анну, и я вижу, что она находится в такой же ситуации."

# ch/anna/events.rpy:2106
translate russian anna_male_ending_621643e0:
    "В конце концов, мы оба вздрагиваем только тогда, когда священник громко кашляет, и возвращаемся к реальности."

# ch/anna/events.rpy:2107
translate russian anna_male_ending_b6b86ea1:
    "Священник" "Кхм..."

# ch/anna/events.rpy:2109
translate russian anna_male_ending_c968483b:
    "Священник" "Простите меня, должно быть, у меня что-то застряло в горле."

# ch/anna/events.rpy:2110
translate russian anna_male_ending_7c94057c:
    "Священник" "Кажется, я спрашивал: согласны ли вы, Анна, взять этого мужчину в законные мужья?"

# ch/anna/events.rpy:2111
translate russian anna_male_ending_b195b28f:
    anna.say "Конечно! Ещё как согласна!"

# ch/anna/events.rpy:2112
translate russian anna_male_ending_f3c46936:
    "Священник удивленно поднимает брови, на его губах появляется легкая улыбка."

# ch/anna/events.rpy:2113
translate russian anna_male_ending_f7c4d834:
    "Кто знает, может быть, он не такой уж и строгий, как кажется?"

# ch/anna/events.rpy:2114
translate russian anna_male_ending_90d9c35e:
    "Священник" "Простого \"да\" было бы достаточно, дорогая моя."

# ch/anna/events.rpy:2115
translate russian anna_male_ending_f9e84209:
    "Анна смущается из-за его мягкого упрека и на мгновение опускает взгляд на свои ноги."

# ch/anna/events.rpy:2116
translate russian anna_male_ending_df9c0e9e:
    "Но затем она снова смотрит на меня, покраснев самым милым образом."

# ch/anna/events.rpy:2117
translate russian anna_male_ending_045faa85:
    "Священник" "А ты, [lssb_anna.hero_name()]."

# ch/anna/events.rpy:2118
translate russian anna_male_ending_f990bc53:
    "Священник" "Анна, принимаете ли вы эту женщину своей законной женой?"

# ch/anna/events.rpy:2119
translate russian anna_male_ending_a31db371:
    mike.say "Да, то, что она сказала!"

# ch/anna/events.rpy:2120
translate russian anna_male_ending_1de53067:
    "Священник на мгновение выглядит ошеломленным, но затем качает головой."

# ch/anna/events.rpy:2121
translate russian anna_male_ending_5e6949eb:
    "Священник" "Тогда я не вижу причин не объявить вас мужем и женой."

# ch/anna/events.rpy:2122
translate russian anna_male_ending_36a37d32:
    "Священник" "Вы можете поцеловать невесту."

# ch/anna/events.rpy:2123
translate russian anna_male_ending_8d6fb4f9:
    "Священник" "Желательно, прежде чем она скажет что-нибудь еще столь же... яркое."

# ch/anna/events.rpy:2125
translate russian anna_male_ending_52220b3b:
    "Я поворачиваюсь лицом к Анне и наклоняюсь, чтобы сделать то, что сказал священник."

# ch/anna/events.rpy:2126
translate russian anna_male_ending_de000233:
    "Но прежде чем я успеваю опуститься хотя бы наполовину до ее уровня, Анна почти подпрыгивает ко мне."

# ch/anna/events.rpy:2127
translate russian anna_male_ending_f3435af9:
    "Она бросает свой букет через плечо в толпу и сразу же прыгает мне на руки."

# ch/anna/events.rpy:2128
translate russian anna_male_ending_c9cdf61d:
    "Я едва слышу, как наши гости суетятся, пытаясь поймать цветы, пока она обвивает мои ноги вокруг меня."

# ch/anna/events.rpy:2129
translate russian anna_male_ending_e27878ff:
    "И я могу честно сказать, что мне все равно, кто в итоге их получит или сломают ли они себе кости в процессе."

# ch/anna/events.rpy:2134
translate russian anna_male_ending_713e229a:
    "Она прижимается своими губами к моим, и этот поцелуй явно не подходит для церковной обстановки!"

# ch/anna/events.rpy:2135
translate russian anna_male_ending_ebc2069b:
    "Когда он заканчивается, Анна даже не просит меня отпустить ее, а просто крепко цепляется за меня."

# ch/anna/events.rpy:2136
translate russian anna_male_ending_04d4e4f3:
    "Она смотрит мне глубоко в глаза, игнорируя хаос, происходящий позади нас."

# ch/anna/events.rpy:2140
translate russian anna_male_ending_f7ac53dc:
    anna.say "[lssb_anna.hero_name()], мы это сделали! Мы поженились!"

# ch/anna/events.rpy:2141
translate russian anna_male_ending_b9b5be5a:
    "Пусть она говорит очевидное, мне-то какое дело?"

# ch/anna/events.rpy:2142
translate russian anna_male_ending_40d349c4:
    mike.say "Мы это сделали, Анна…"

# ch/anna/events.rpy:2143
translate russian anna_male_ending_f396eca5:
    mike.say "Конечно, мы это сделали!"

# ch/anna/events.rpy:2147
translate russian anna_male_ending_643fb4e4:
    anna.say "Ох, [lssb_anna.hero_name()], мне пора начинать говорить?"

# ch/anna/events.rpy:2148
translate russian anna_male_ending_40fef3c7:
    anna.say "Или кто-нибудь скажет мне, когда?"

# ch/anna/events.rpy:2149
translate russian anna_male_ending_f2245139:
    anna.say "Что… что?"

# ch/anna/events.rpy:2150
translate russian anna_male_ending_de9ae4eb:
    anna.say "Люди слышат меня прямо сейчас?"

# ch/anna/events.rpy:2152
translate russian anna_male_ending_727daf70:
    anna.say "Вау... Я болтала все это время!"

# ch/anna/events.rpy:2153
translate russian anna_male_ending_33a5cea0:
    anna.say "И ты мне об этом не сказал?!"

# ch/anna/events.rpy:2154
translate russian anna_male_ending_1c42abb8:
    anna.say "Что ты имеешь в виду, что говоришь мне это только сейчас?!"

# ch/anna/events.rpy:2156
translate russian anna_male_ending_7e6dc5e7:
    anna.say "Сейчас уже слишком поздно!"

# ch/anna/events.rpy:2157
translate russian anna_male_ending_744b93ce:
    anna.say "Они подумают, что я какая-то глупая, рассеянная дурочка!"

# ch/anna/events.rpy:2158
translate russian anna_male_ending_52baaedd:
    anna.say "Ну ладно, может быть, я смогу изменить их мнение своим обаянием?"

# ch/anna/events.rpy:2161
translate russian anna_male_ending_562d6806:
    anna.say "ЧТО?!"

# ch/anna/events.rpy:2162
translate russian anna_male_ending_37bea6a2:
    anna.say "[lssb_anna.hero_name()], это очень грубо сказать!"

# ch/anna/events.rpy:2164
translate russian anna_male_ending_6ffeead9:
    anna.say "Хорошо... хорошо..."

# ch/anna/events.rpy:2165
translate russian anna_male_ending_f949974e:
    anna.say "Где я остановилась…"

# ch/anna/events.rpy:2166
translate russian anna_male_ending_3e9d9291:
    anna.say "Ах да, это я, Анна!"

# ch/anna/events.rpy:2167
translate russian anna_male_ending_94317e1c:
    anna.say "И вот тут мне предстоит рассказать историю, а не [lssb_anna.hero_name()]."

# ch/anna/events.rpy:2169
translate russian anna_male_ending_2247dae9:
    anna.say "Кстати, кто-то сейчас ведет себя со мной как полный идиот!"

# ch/anna/events.rpy:2171
translate russian anna_male_ending_d01b7e21:
    anna.say "Значит, мне тоже нужно быть с ним грубой!"

# ch/anna/events.rpy:2173
translate russian anna_male_ending_bc9c9e79:
    anna.say "Но... ну что я могу сказать."

# ch/anna/events.rpy:2174
translate russian anna_male_ending_3152a71a:
    anna.say "Просто посмотри на это лицо!"

# ch/anna/events.rpy:2175
translate russian anna_male_ending_6614b44c:
    anna.say "Я не могу долго злиться на него."

# ch/anna/events.rpy:2177
translate russian anna_male_ending_81d5a061:
    anna.say "Особенно когда дело касается папы моего любимого Томи!"

# ch/anna/events.rpy:2179
translate russian anna_male_ending_a2a48e51:
    anna.say "Особенно когда дело касается моего замечательного мужа!"

# ch/anna/events.rpy:2180
translate russian anna_male_ending_933ac6ad:
    anna.say "Знаешь, так странно думать о том, что могло бы произойти, если бы мы не встретились."

# ch/anna/events.rpy:2181
translate russian anna_male_ending_1b163f02:
    anna.say "Например, если бы наши пути никогда не пересеклись."

# ch/anna/events.rpy:2182
translate russian anna_male_ending_da83d0cb:
    anna.say "Если бы Саша не позвал его на одну из репетиций группы."

# ch/anna/events.rpy:2183
translate russian anna_male_ending_5ee2524e:
    anna.say "Если бы я не согласилась, когда этот здоровяк пригласил меня на свидание в первый раз!"

# ch/anna/events.rpy:2184
translate russian anna_male_ending_7fa24cef:
    anna.say "И если бы я не позволяла ему делать со мной то, что он делает в постели..."

# ch/anna/events.rpy:2186
translate russian anna_male_ending_f90058d7:
    anna.say "Ммм..."

# ch/anna/events.rpy:2187
translate russian anna_male_ending_e6be5cc1:
    anna.say "Только мысль об этом заставляет меня чувствовать себя странно..."

# ch/anna/events.rpy:2188
translate russian anna_male_ending_1dba6bf0:
    anna.say "Я прямо сейчас это представляю!"

# ch/anna/events.rpy:2189
translate russian anna_male_ending_c4bc3f97:
    anna.say "Я почти чувствую его..."

# ch/anna/events.rpy:2190
translate russian anna_male_ending_228ca07e:
    anna.say "Когда он делает то, что он обычно делает со своим..."

# ch/anna/events.rpy:2191
translate russian anna_male_ending_9cff0e0b:
    anna.say "Со мной..."

# ch/anna/events.rpy:2192
translate russian anna_male_ending_97a2e82e:
    anna.say "Ой..."

# ch/anna/events.rpy:2194
translate russian anna_male_ending_76751b5e:
    anna.say "Простите, на минутку отвлеклась!"

# ch/anna/events.rpy:2195
translate russian anna_male_ending_45dc036b:
    anna.say "Вам же не интересно это знать, правда?"

# ch/anna/events.rpy:2196
translate russian anna_male_ending_efe70991:
    anna.say "Кому вообще важно, что я сейчас представляю, как [lssb_anna.hero_name()] со мной поступает."

# ch/anna/events.rpy:2197
translate russian anna_male_ending_b0f5d952:
    anna.say "Вы все хотите услышать о том, как мы жили долго и счастливо, да?"

# ch/anna/events.rpy:2199
translate russian anna_male_ending_0fb2ed1c:
    anna.say "Я так и думала!"

# ch/anna/events.rpy:2201
translate russian anna_male_ending_531be6ed:
    anna.say "Ну ладно..."

# ch/anna/events.rpy:2202
translate russian anna_male_ending_e31ff968:
    anna.say "Мы вскоре после свадьбы отправились в тур с остальной частью группы."

# ch/anna/events.rpy:2203
translate russian anna_male_ending_029be58f:
    anna.say "Это был наш первый раз, когда мы были хедлайнерами, так что это было очень важное событие!"

# ch/anna/events.rpy:2204
translate russian anna_male_ending_0342edc0:
    anna.say "Мы выступали во всех этих клубах в разных городах."

# ch/anna/events.rpy:2205
translate russian anna_male_ending_37c737be:
    anna.say "И все это было как в тумане, понимаешь?"

# ch/anna/events.rpy:2207
translate russian anna_male_ending_703ea2b6:
    anna.say "Так что мы только что вернулись из тура, и мы осознали, что женаты!"

# ch/anna/events.rpy:2208
translate russian anna_male_ending_5fc95f3a:
    anna.say "Ну… мы просто не забыли, понимаешь?"

# ch/anna/events.rpy:2209
translate russian anna_male_ending_0a704e82:
    anna.say "У нас было много забот в то время."

# ch/anna/events.rpy:2210
translate russian anna_male_ending_9b65b32b:
    anna.say "И нам нужно было подумать о том, что делать дальше."

# ch/anna/events.rpy:2211
translate russian anna_male_ending_0fc3927e:
    anna.say "Сейчас [lssb_anna.hero_name()] все еще проводит половину времени у меня и половину у Саши."

# ch/anna/events.rpy:2212
translate russian anna_male_ending_e6ac5ca5:
    anna.say "Но это изменится, как только мы найдем место, достаточно большое для нас."

# ch/anna/events.rpy:2213
translate russian anna_male_ending_36eceb20:
    anna.say "И то, что [lssb_anna.hero_name()] постоянно рядом – это тоже здорово."

# ch/anna/events.rpy:2214
translate russian anna_male_ending_33c1a80a:
    anna.say "Это значит, что он только мой, и мне не нужно делиться им ни с кем!"

# ch/anna/events.rpy:2215
translate russian anna_male_ending_dad9e779:
    anna.say "Я до сих пор не уверена, всегда ли парни лучше девушек в этом… эээ… плане."

# ch/anna/events.rpy:2216
translate russian anna_male_ending_d513b13b:
    anna.say "Но я знаю точно, что [lssb_anna.hero_name()] – лучший из всех!"

# ch/anna/events.rpy:2217
translate russian anna_male_ending_26563bf0:
    anna.say "Хотя это не только про секс, конечно же!"

# ch/anna/events.rpy:2218
translate russian anna_male_ending_14749cfc:
    anna.say "Мы так хорошо вместе ладим, смеемся над шутками друг друга, даже договариваем фразы за другого."

# ch/anna/events.rpy:2219
translate russian anna_male_ending_73f9117a:
    anna.say "Иногда мне кажется, что у нас обоих половинки одного мозга!"

# ch/anna/events.rpy:2220
translate russian anna_male_ending_65d1a4fe:
    anna.say "Хм…"

# ch/anna/events.rpy:2221
translate russian anna_male_ending_f556daf3:
    anna.say "Что случилось, [lssb_anna.hero_name()]?"

# ch/anna/events.rpy:2222
translate russian anna_male_ending_bd003488:
    anna.say "Почему ты смеешься надо мной?"

# ch/anna/events.rpy:2223
translate russian anna_male_ending_18304f55:
    anna.say "Да ладно… просто игнорируй его, хорошо?"

# ch/anna/events.rpy:2224
translate russian anna_male_ending_b338abdb:
    anna.say "Ой, чёрт, сколько у меня осталось времени?"

# ch/anna/events.rpy:2225
translate russian anna_male_ending_13df7d6b:
    anna.say "Ой... всего пара секунд!"

# ch/anna/events.rpy:2226
translate russian anna_male_ending_b5d37963:
    anna.say "Я просто хочу сказать, что мы безумно любим друг друга, и он лучший."

# ch/anna/events.rpy:2227
translate russian anna_male_ending_6c88343b:
    anna.say "Хотя я это уже говорила."

# ch/anna/events.rpy:2228
translate russian anna_male_ending_c442e54f:
    anna.say "Но это правда, поэтому я могу говорить об этом сколько угодно раз."

# ch/anna/events.rpy:2229
translate russian anna_male_ending_7baf84db:
    anna.say "Вот и все!"

# ch/anna/events.rpy:2241
translate russian anna_sub_event_01_34ad811c:
    "Сегодняшняя поездка в торговый центр с Анной была довольно обычной."

# ch/anna/events.rpy:2242
translate russian anna_sub_event_01_39436f34:
    "Нечего особо жаловаться, но и ничего особенного, что запомнилось бы."

# ch/anna/events.rpy:2243
translate russian anna_sub_event_01_3806199e:
    "Мы несколько раз ходили от одного конца торгового центра до другого."

# ch/anna/events.rpy:2244
translate russian anna_sub_event_01_10af8e18:
    "В основном мы просто рассматривали товары в витринах."

# ch/anna/events.rpy:2245
translate russian anna_sub_event_01_db3785fb:
    "Зашли всего в пару магазинов за всякой мелочью, которая нам понадобилась по пути."

# ch/anna/events.rpy:2246
translate russian anna_sub_event_01_b69ebed4:
    "Через некоторое время я подумал о том, чтобы предложить вернуться домой."

# ch/anna/events.rpy:2247
translate russian anna_sub_event_01_f24cdc88:
    "Но я вижу, что Анна начинает немного нервничать."

# ch/anna/events.rpy:2249
translate russian anna_sub_event_01_0468c741:
    "Она поджимает губу и хмурится, пока мы идем."

# ch/anna/events.rpy:2250
translate russian anna_sub_event_01_621132fd:
    mike.say "Анна..."

# ch/anna/events.rpy:2251
translate russian anna_sub_event_01_df886bc4:
    mike.say "Что случилось?"

# ch/anna/events.rpy:2252
translate russian anna_sub_event_01_57c7f20f:
    mike.say "Я что-нибудь сказал, чтобы тебя разозлить?"

# ch/anna/events.rpy:2253
translate russian anna_sub_event_01_c2a3fe0b:
    "Я не готов к тому, что произойдет дальше."

# ch/anna/events.rpy:2255
translate russian anna_sub_event_01_e7a4c7a4:
    "Анна замирает и оборачивается на каблуках."

# ch/anna/events.rpy:2256
translate russian anna_sub_event_01_20dfff8c:
    "Она ставит руки на бедра и сердито смотрит на меня."

# ch/anna/events.rpy:2257
translate russian anna_sub_event_01_d70145e0:
    anna.say "Что это должно значить?"

# ch/anna/events.rpy:2259
translate russian anna_sub_event_01_93f1f0cb:
    anna.say "Разве я не могу менять настроение?"

# ch/anna/events.rpy:2260
translate russian anna_sub_event_01_d6bcd0c9:
    anna.say "Не все, что я делаю, связано с тобой, [lssb_anna.hero_name()]!"

# ch/anna/events.rpy:2262
translate russian anna_sub_event_01_00f01687:
    "Я инстинктивно отступаю назад, давая Анне немного пространства."

# ch/anna/events.rpy:2263
translate russian anna_sub_event_01_ffd36e59:
    "Но вместо того чтобы нападать на меня, она прижимает руки к животу."

# ch/anna/events.rpy:2264
translate russian anna_sub_event_01_4afa2cc2:
    "И я клянусь, что слышу, как оно урчит с расстояния шести футов!"

# ch/anna/events.rpy:2266
translate russian anna_sub_event_01_7477ddf6:
    anna.say "Ох..."

# ch/anna/events.rpy:2268
translate russian anna_sub_event_01_e7a3c42a:
    anna.say "Прости, [lssb_anna.hero_name()]."

# ch/anna/events.rpy:2269
translate russian anna_sub_event_01_bb50d8e0:
    anna.say "Думаю, я немного голодна!"

# ch/anna/events.rpy:2270
translate russian anna_sub_event_01_bf406451:
    anna.say "Я сегодня пропустила обед, и теперь это догоняет меня!"

# ch/anna/events.rpy:2271
translate russian anna_sub_event_01_cf0c8513:
    "Я киваю, внезапно понимая, в чем проблема."

# ch/anna/events.rpy:2272
translate russian anna_sub_event_01_2622eae9:
    "И начинаю оглядываться в поисках ближайшего места, где мы можем что-нибудь поесть."

# ch/anna/events.rpy:2273
translate russian anna_sub_event_01_e9ebd048:
    "Через мгновение я замечаю подходящий вариант."

# ch/anna/events.rpy:2274
translate russian anna_sub_event_01_a9dc3788:
    mike.say "Как насчет того, чтобы перекусить там, Анна?"

# ch/anna/events.rpy:2275
translate russian anna_sub_event_01_ed0c340c:
    mike.say "Я слышал хорошие отзывы об этой кондитерской."

# ch/anna/events.rpy:2276
translate russian anna_sub_event_01_ee5db71f:
    "Взгляд Анны следует за направлением, в котором я показываю."

# ch/anna/events.rpy:2277
translate russian anna_sub_event_01_597379de:
    "И как только она замечает это место, она с энтузиазмом кивает."

# ch/anna/events.rpy:2279
translate russian anna_sub_event_01_f90058d7:
    anna.say "Ммм..."

# ch/anna/events.rpy:2280
translate russian anna_sub_event_01_2e5a38fd:
    anna.say "Звучит очень вкусно!"

# ch/anna/events.rpy:2281
translate russian anna_sub_event_01_5485d53f:
    anna.say "Я ОБОЖАЮ пончики!"

# ch/anna/events.rpy:2283
translate russian anna_sub_event_01_eb3790ed:
    "Она хватает меня за руку и начинает двигаться довольно быстро."

# ch/anna/events.rpy:2284
translate russian anna_sub_event_01_1ea2c0f6:
    "Я оказываюсь увлеченным за ней, не в силах сопротивляться."

# ch/anna/events.rpy:2287
translate russian anna_sub_event_01_4d9711ae:
    "Мы встаем в очередь в кондитерской и ждем своей очереди."

# ch/anna/events.rpy:2288
translate russian anna_sub_event_01_896223fb:
    "И вскоре мы подходим к стойке."

# ch/anna/events.rpy:2289
translate russian anna_sub_event_01_7420fb3a:
    "Кажется, что с каждой минутой Анна становится все более голодной."

# ch/anna/events.rpy:2290
translate russian anna_sub_event_01_ef108fb8:
    "Возможно, поэтому она решает заказать целую коробку пончиков в форме колец."

# ch/anna/events.rpy:2291
translate russian anna_sub_event_01_18ef9cdb:
    "Я чувствую себя менее голодным, поэтому ограничиваюсь одним шоколадным эклером."

# ch/anna/events.rpy:2293
translate russian anna_sub_event_01_a17d5099:
    "Мы подходим к столу и садимся, чтобы съесть то, что купили."

# ch/anna/events.rpy:2294
translate russian anna_sub_event_01_f4d36cfa:
    "И я с удивлением наблюдаю, как Анна жадно набрасывается на коробку с пончиками."

# ch/anna/events.rpy:2295
translate russian anna_sub_event_01_e44e5a66:
    "Она съела уже два или три пончика, пока я даже не сделал ни одного укуса."

# ch/anna/events.rpy:2296
translate russian anna_sub_event_01_c300d65f:
    "Но потом она замечает, что я внимательно наблюдаю за ней, когда она облизывает следующий пончик."

# ch/anna/events.rpy:2297
translate russian anna_sub_event_01_3b0a225e:
    "Язык Анны пытался очистить его от сахара, но теперь она замерла."

# ch/anna/events.rpy:2298
translate russian anna_sub_event_01_7891753e:
    anna.say "[lssb_anna.hero_name()]!"

# ch/anna/events.rpy:2300
translate russian anna_sub_event_01_cb2d15ff:
    anna.say "Что ты на меня смотришь?!?"

# ch/anna/events.rpy:2301
translate russian anna_sub_event_01_e7a1e386:
    mike.say "Да ладно тебе, Анна!"

# ch/anna/events.rpy:2302
translate russian anna_sub_event_01_1eecf42b:
    mike.say "Ты буквально облизываешь кольцо прямо передо мной!"

# ch/anna/events.rpy:2303
translate russian anna_sub_event_01_589eb08c:
    anna.say "Ах!"

# ch/anna/events.rpy:2305
translate russian anna_sub_event_01_4f8c2059:
    anna.say "У тебя такие грязные мысли!"

# ch/anna/events.rpy:2306
translate russian anna_sub_event_01_1a9f2637:
    "Я наблюдаю, как взгляд Анны останавливается на моем несъеденном эклере."

# ch/anna/events.rpy:2307
translate russian anna_sub_event_01_b2cbeea0:
    anna.say "Я думаю, я могу угадать, зачем ты его купил!"

# ch/anna/events.rpy:2308
translate russian anna_sub_event_01_f4a2e3ae:
    anna.say "Самая длинная выпечка, которую они продавали?"

# ch/anna/events.rpy:2309
translate russian anna_sub_event_01_7231800b:
    anna.say "И еще начиненный кремом!"

# ch/anna/events.rpy:2310
translate russian anna_sub_event_01_1c4e83a5:
    mike.say "Ты хочешь сказать, что мой выбор выпечки как-то... фаллический?"

# ch/anna/events.rpy:2311
translate russian anna_sub_event_01_ba7969e8:
    "Анна не отвечает на мой вопрос."

# ch/anna/events.rpy:2313
translate russian anna_sub_event_01_2ada4ec1:
    "Она просто улыбается и наклоняется вперед."

# ch/anna/events.rpy:2314
translate russian anna_sub_event_01_b1bdca9a:
    "Затем она придвигает свой пончик к концу моего эклера."

# ch/anna/events.rpy:2316
translate russian anna_sub_event_01_b05c2da1:
    "Анна неконтролируемо хихикает, двигая им вверх и вниз."

# ch/anna/events.rpy:2317
translate russian anna_sub_event_01_399c67bf:
    "И должен сказать, что у нее неплохо получается."

# ch/anna/events.rpy:2319
translate russian anna_sub_event_01_b3e10dc5:
    "Если бы это были не кондитерские изделия, я бы чувствовал себя гораздо более возбужденным!"

# ch/anna/events.rpy:2320
translate russian anna_sub_event_01_fe79791e:
    "На самом деле, я смотрю на нее настолько внимательно, что не замечаю, как ее другая рука двигается."

# ch/anna/events.rpy:2321
translate russian anna_sub_event_01_6f89070f:
    "Мгновенно она сжимает мою руку этой рукой, той же самой, которая держит эклер."

# ch/anna/events.rpy:2322
translate russian anna_sub_event_01_98e85cca:
    "Давление заставляет крем вытекать из другого конца, который направлен к Анне."

# ch/anna/events.rpy:2323
translate russian anna_sub_event_01_8377cde6:
    "Она высовывает язык и ловит его во рту."

# ch/anna/events.rpy:2324
translate russian anna_sub_event_01_f037e175:
    "Затем она облизывает губы и проглатывает все разом."

# ch/anna/events.rpy:2325
translate russian anna_sub_event_01_43a5e148:
    anna.say "Почему ты смотришь на меня так, [lssb_anna.hero_name()]?"

# ch/anna/events.rpy:2327
translate russian anna_sub_event_01_89b1a860:
    anna.say "Я просто была голодна, вот и все!"

# ch/anna/events.rpy:2328
translate russian anna_sub_event_01_2ca85baa:
    "Анна моргает мне глазами, пытаясь выглядеть невинной."

# ch/anna/events.rpy:2329
translate russian anna_sub_event_01_2abaedd8:
    mike.say "Ну да..."

# ch/anna/events.rpy:2330
translate russian anna_sub_event_01_61dd9fcd:
    mike.say "Думаю, ты только что разбудила во мне аппетит к чему-то совершенно другому!"

# ch/anna/events.rpy:2339
translate russian anna_sub_event_02_6f5187c1:
    "Мы с Анной искренне пытались придумать, чем заняться на нашем свидании сегодня вечером."

# ch/anna/events.rpy:2340
translate russian anna_sub_event_02_0a08f12c:
    "Я знаю, что я долго ломал голову, чтобы найти идею, и она тоже предложила несколько вариантов."

# ch/anna/events.rpy:2341
translate russian anna_sub_event_02_d760e29b:
    "Но мы с тобой никак не могли прийти к согласию ни по одному из предложенных вариантов."

# ch/anna/events.rpy:2342
translate russian anna_sub_event_02_93a6855d:
    "И вот мы пришли к последнему средству – просто сесть и посмотреть фильм у меня дома."

# ch/anna/events.rpy:2343
translate russian anna_sub_event_02_b0136fd6:
    "Да, знаю. Не самое страшное испытание на свете."

# ch/anna/events.rpy:2344
translate russian anna_sub_event_02_32f4e428:
    "Но ведь в мире столько всего интересного!"

# ch/anna/events.rpy:2345
translate russian anna_sub_event_02_2ae10c7c:
    "И я могу сидеть на своем заднице и смотреть телевизор, когда не на свидании."

# ch/anna/events.rpy:2346
translate russian anna_sub_event_02_d6c61418:
    "У меня такое ощущение, что Анна чувствует то же самое."

# ch/anna/events.rpy:2347
translate russian anna_sub_event_02_1d35b14e:
    "Она прямо об этом не говорит, вероятно, чтобы не задеть мои чувства."

# ch/anna/events.rpy:2348
translate russian anna_sub_event_02_7d8c5200:
    "Но сегодня она какая-то тихая и не такая разговорчивая, как обычно."

# ch/anna/events.rpy:2349
translate russian anna_sub_event_02_d350c3d6:
    "Тем не менее, она прижимается ко мне на диване."

# ch/anna/events.rpy:2350
translate russian anna_sub_event_02_ed05d391:
    "И от того, что я чувствую ее так близко, мне начинает становиться немного лучше."

# ch/anna/events.rpy:2351
translate russian anna_sub_event_02_aae370b5:
    anna.say "Итак..."

# ch/anna/events.rpy:2352
translate russian anna_sub_event_02_b7e81890:
    anna.say "Что мы сегодня будем смотреть?"

# ch/anna/events.rpy:2353
translate russian anna_sub_event_02_6731b7fa:
    "Она смеется и игриво толкает меня локтем в ребра."

# ch/anna/events.rpy:2355
translate russian anna_sub_event_02_19713cfe:
    anna.say "Зная тебя, это будет какой-нибудь культовый научно-фантастический фильм!"

# ch/anna/events.rpy:2356
translate russian anna_sub_event_02_89d23d96:
    anna.say "Или какой-нибудь ужастик, который кто-то снял вообще без денег, верно?"

# ch/anna/events.rpy:2357
translate russian anna_sub_event_02_1eb9ad05:
    mike.say "На самом деле, это фильм, который Саша посоветовала нам посмотреть."

# ch/anna/events.rpy:2359
translate russian anna_sub_event_02_37e2a2a2:
    mike.say "Это называется, наверное, \"Шестьдесят девять оттенков серого\" или что-то в этом роде."

# ch/anna/events.rpy:2360
translate russian anna_sub_event_02_3e6bf527:
    mike.say "Наверное, это что-то такое же артхаусное, как тот фильм \"Три цвета: красный\", я думаю!"

# ch/anna/events.rpy:2361
translate russian anna_sub_event_02_7477ddf6:
    anna.say "Ох..."

# ch/anna/events.rpy:2362
translate russian anna_sub_event_02_e9010b89:
    anna.say "Звучит довольно претенциозно!"

# ch/anna/events.rpy:2363
translate russian anna_sub_event_02_79855572:
    anna.say "Обещай мне, что объяснишь, если я ничего не пойму?"

# ch/anna/events.rpy:2364
translate russian anna_sub_event_02_805c8ebb:
    mike.say "Я обещаю, Анна."

# ch/anna/events.rpy:2365
translate russian anna_sub_event_02_0ced650b:
    mike.say "Я буду внимательно следить только для тебя."

# ch/anna/events.rpy:2366
translate russian anna_sub_event_02_7643e8b2:
    "Мы оба откидываемся и расслабляемся, пока идут титры."

# ch/anna/events.rpy:2367
translate russian anna_sub_event_02_f4b647ba:
    "И, судя по началу, это кажется довольно знакомой историей."

# ch/anna/events.rpy:2368
translate russian anna_sub_event_02_bd15bfee:
    "Там есть милая молодая девушка, которая хочет доказать свою состоятельность."

# ch/anna/events.rpy:2369
translate russian anna_sub_event_02_78fc6ac0:
    "А еще там богатый парень, который выглядит высокомерным и отстраненным."

# ch/anna/events.rpy:2370
translate russian anna_sub_event_02_a389e73e:
    mike.say "Я уверен, что они сначала друг друга ненавидят."

# ch/anna/events.rpy:2371
translate russian anna_sub_event_02_4b8e24eb:
    mike.say "Потом они разозлятся и начнут проявлять страсть."

# ch/anna/events.rpy:2372
translate russian anna_sub_event_02_2a4e091c:
    mike.say "Что заставит их понять, что они не могут противиться друг другу."

# ch/anna/events.rpy:2373
translate russian anna_sub_event_02_2caed73d:
    mike.say "Просто подожди и увидишь, Анна!"

# ch/anna/events.rpy:2374
translate russian anna_sub_event_02_7891753e:
    anna.say "[lssb_anna.hero_name()]!"

# ch/anna/events.rpy:2376
translate russian anna_sub_event_02_e58999ad:
    anna.say "Можешь уже заткнуться и просто посмотреть фильм?"

# ch/anna/events.rpy:2377
translate russian anna_sub_event_02_d0e6216e:
    "Поддавшись словам Анны, я делаю то, что мне говорят."

# ch/anna/events.rpy:2379
translate russian anna_sub_event_02_aa1f2be2:
    "Но по мере развития сюжета фильма, я вижу, как мои предсказания сбываются."

# ch/anna/events.rpy:2380
translate russian anna_sub_event_02_e3f46036:
    "Я готов указать на экран и заявить, что был прав."

# ch/anna/events.rpy:2381
translate russian anna_sub_event_02_7172c854:
    "И вот тогда все принимает неожиданный оборот."

# ch/anna/events.rpy:2383
translate russian anna_sub_event_02_984ea5b3:
    anna.say "О..."

# ch/anna/events.rpy:2385
translate russian anna_sub_event_02_01d28843:
    anna.say "Боже мой..."

# ch/anna/events.rpy:2386
translate russian anna_sub_event_02_94eeb856:
    anna.say "Это вообще возможно в реальной жизни?!"

# ch/anna/events.rpy:2387
translate russian anna_sub_event_02_7172d437:
    mike.say "Я не знаю, Анна!"

# ch/anna/events.rpy:2388
translate russian anna_sub_event_02_2d1025e0:
    mike.say "Не может быть без страховочного троса, вазелина и врожденной гипермобильности суставов!"

# ch/anna/events.rpy:2389
translate russian anna_sub_event_02_b2bc8b1b:
    "То, что мы оба думали, будет артхаусным фильмом, превращается в парад разврата."

# ch/anna/events.rpy:2390
translate russian anna_sub_event_02_b0691487:
    "У нас на глазах происходят вещи, которые я считал сюжетом порнофильмов."

# ch/anna/events.rpy:2391
translate russian anna_sub_event_02_97cda47d:
    "Хотя, конечно, я не говорю, что это меня шокирует, вы понимаете?"

# ch/anna/events.rpy:2392
translate russian anna_sub_event_02_b036378c:
    "Я абсолютно спокоен по поводу веревок, латекса и плеток, которые они используют."

# ch/anna/events.rpy:2393
translate russian anna_sub_event_02_9e318f29:
    "Просто я не был готов увидеть это сегодня вечером."

# ch/anna/events.rpy:2395
translate russian anna_sub_event_02_190bf12e:
    "Кажется, Анна тоже заворожена, она все время прижимается ко мне."

# ch/anna/events.rpy:2396
translate russian anna_sub_event_02_60e85910:
    "Я слышу, как она задыхается и вздыхает, пока на экране телевизора разворачиваются события."

# ch/anna/events.rpy:2397
translate russian anna_sub_event_02_bb5e23b0:
    "В какой-то момент мне кажется, что я даже чувствую, как бешено бьётся её сердце!"

# ch/anna/events.rpy:2398
translate russian anna_sub_event_02_8b72476d:
    "Наконец, заканчиваются титры, и фильм завершается."

# ch/anna/events.rpy:2400
translate russian anna_sub_event_02_a5c98464:
    "Мы сидим в тишине некоторое время, ни один из нас не говорит."

# ch/anna/events.rpy:2401
translate russian anna_sub_event_02_b5fcee08:
    "Это похоже на то странное, нереальное ощущение, когда выходишь из кинотеатра."

# ch/anna/events.rpy:2402
translate russian anna_sub_event_02_92d1fb25:
    "Но в данном случае это также пронизано сексуальным напряжением."

# ch/anna/events.rpy:2404
translate russian anna_sub_event_02_590dae18:
    anna.say "[lssb_anna.hero_name()]..."

# ch/anna/events.rpy:2405
translate russian anna_sub_event_02_25a61e8a:
    mike.say "Да, Анна?"

# ch/anna/events.rpy:2406
translate russian anna_sub_event_02_f88f0cab:
    anna.say "Мне немного странно."

# ch/anna/events.rpy:2407
translate russian anna_sub_event_02_31f026bc:
    anna.say "Тебе тоже немного странно?"

# ch/anna/events.rpy:2408
translate russian anna_sub_event_02_b3e35cad:
    mike.say "Да, Анна."

# ch/anna/events.rpy:2409
translate russian anna_sub_event_02_8f706b9b:
    anna.say "Я думаю, фильм на меня повлиял."

# ch/anna/events.rpy:2410
translate russian anna_sub_event_02_6a7bbec3:
    mike.say "И на меня тоже, Анна, и на меня тоже."

# ch/anna/events.rpy:2411
translate russian anna_sub_event_02_561149f5:
    anna.say "Всё, что я знаю – это то, что я хочу попробовать это."

# ch/anna/events.rpy:2413
translate russian anna_sub_event_02_0a2850a8:
    anna.say "Я хочу попробовать некоторые из тех вещей, которые они там делали."

# ch/anna/events.rpy:2414
translate russian anna_sub_event_02_d352dc9f:
    anna.say "Ты думаешь, может быть, мы могли бы попробовать кое-что подобное?"

# ch/anna/events.rpy:2417
translate russian anna_sub_event_02_e6fd4390:
    "Я киваю головой, соглашаясь без малейших колебаний."

# ch/anna/events.rpy:2418
translate russian anna_sub_event_02_456f8f80:
    mike.say "Анна, я не думаю, что все это на самом деле возможно."

# ch/anna/events.rpy:2419
translate russian anna_sub_event_02_198d6172:
    mike.say "Некоторые вещи, как мне кажется, требуют лицензии для практики в этой стране."

# ch/anna/events.rpy:2420
translate russian anna_sub_event_02_a6c75a4a:
    mike.say "А кое-что из этого, я думаю, до сих пор карается смертной казнью в некоторых частях мира!"

# ch/anna/events.rpy:2421
translate russian anna_sub_event_02_d7b71465:
    mike.say "Но я готов попробовать, или умереть, пытаясь!"

# ch/anna/events.rpy:2422
translate russian anna_sub_event_02_e0c0145a:
    "Анна хлопает в ладоши и крепко обнимает меня."

# ch/anna/events.rpy:2423
translate russian anna_sub_event_02_7477ddf6_1:
    anna.say "Ох..."

# ch/anna/events.rpy:2425
translate russian anna_sub_event_02_765ad4c7:
    anna.say "Это будет так весело!"

# ch/anna/events.rpy:2426
translate russian anna_sub_event_02_fe8dae22:
    anna.say "Мы можем заехать в хозяйственный магазин и купить все, что нам понадобится..."

# ch/anna/events.rpy:2427
translate russian anna_sub_event_02_8e76c21c:
    "Я сглатываю при одной только мысли о том, чтобы покупать вещи для получения сексуального удовольствия в таком месте."

# ch/anna/events.rpy:2428
translate russian anna_sub_event_02_b9632aec:
    "Но я все равно киваю, уже представляя себе возможности."

# ch/anna/events.rpy:2429
translate russian anna_sub_event_02_d3308ac6:
    "Думаю, мне стоит поблагодарить Сашу за то, что он посоветовал этот фильм."

# ch/anna/events.rpy:2430
translate russian anna_sub_event_02_ea4c1de3:
    "И еще за то, что не стал говорить мне, о чем он вообще!"

# ch/anna/events.rpy:2435
translate russian anna_sub_event_02_67d2e4f6:
    "Я твердо качаю головой, отвергая эту идею."

# ch/anna/events.rpy:2436
translate russian anna_sub_event_02_456f8f80_1:
    mike.say "Анна, я не думаю, что все это на самом деле возможно."

# ch/anna/events.rpy:2437
translate russian anna_sub_event_02_198d6172_1:
    mike.say "Некоторые вещи, как мне кажется, требуют лицензии для практики в этой стране."

# ch/anna/events.rpy:2438
translate russian anna_sub_event_02_a6c75a4a_1:
    mike.say "А кое-что из этого, я думаю, до сих пор карается смертной казнью в некоторых частях мира!"

# ch/anna/events.rpy:2440
translate russian anna_sub_event_02_10e6f035:
    "Анна издает разочарованный звук и отворачивается от меня."

# ch/anna/events.rpy:2441
translate russian anna_sub_event_02_65d1a4fe:
    anna.say "Хм..."

# ch/anna/events.rpy:2442
translate russian anna_sub_event_02_8977ad31:
    anna.say "Я никогда не думала, что ты такой зануда!"

# ch/anna/events.rpy:2443
translate russian anna_sub_event_02_9c99ad8b:
    "Я качаю головой в полном недоумении от этого обвинения."

# ch/anna/events.rpy:2444
translate russian anna_sub_event_02_57b684c2:
    mike.say "Анна, о чем ты говоришь?"

# ch/anna/events.rpy:2445
translate russian anna_sub_event_02_49686b72:
    mike.say "Этот фильм показал, как рок-звезды вели себя раньше, и это выглядело как детский сад!"

# ch/anna/events.rpy:2446
translate russian anna_sub_event_02_4a04fcfd:
    mike.say "По таким меркам, девяносто девять процентов населения мира – зануды!"

# ch/anna/events.rpy:2447
translate russian anna_sub_event_02_eb6ad495:
    "Анна продолжает хмуриться, несмотря ни на что, что я говорю."

# ch/anna/events.rpy:2448
translate russian anna_sub_event_02_73564264:
    anna.say "Я просто пытаюсь внести разнообразие, [lssb_anna.hero_name()]!"

# ch/anna/events.rpy:2449
translate russian anna_sub_event_02_a8785182:
    anna.say "Не жалуйся мне, если тебе станет скучно в постели!"

# ch/anna/events.rpy:2458
translate russian anna_birthday_date_male_cbf59246:
    "А... определенно хорошо отдохнуть от городской суеты."

# ch/anna/events.rpy:2459
translate russian anna_birthday_date_male_a06b9ecb:
    "Заменить весь этот шум и загрязнение на чистый воздух и звуки природы."

# ch/anna/events.rpy:2460
translate russian anna_birthday_date_male_5a537da3:
    "С тех пор, как мы приехали в лес, я слышу только пение птиц на деревьях."

# ch/anna/events.rpy:2461
translate russian anna_birthday_date_male_193143a1:
    "Звук кристально чистой воды, стекающей по камням."

# ch/anna/events.rpy:2462
translate russian anna_birthday_date_male_c37a321f:
    "И звук..."

# ch/anna/events.rpy:2464
translate russian anna_birthday_date_male_ac57bc64:
    anna.say "Ой!"

# ch/anna/events.rpy:2465
translate russian anna_birthday_date_male_c8a271d1:
    anna.say "Ай-ай-ай!"

# ch/anna/events.rpy:2466
translate russian anna_birthday_date_male_eb8887f7:
    anna.say "[lssb_anna.hero_name()], помоги мне!"

# ch/anna/events.rpy:2467
translate russian anna_birthday_date_male_e0267386:
    anna.say "Я очень сильно поранилась!"

# ch/anna/events.rpy:2468
translate russian anna_birthday_date_male_a0b0aff5:
    "Внезапно чары, созданные ощущением уединения с природой, рассеиваются."

# ch/anna/events.rpy:2469
translate russian anna_birthday_date_male_ab74c41f:
    "И я оглядываюсь через плечо, ищу Анну."

# ch/anna/events.rpy:2470
translate russian anna_birthday_date_male_0872bce0:
    "Сначала я ее совсем не вижу, но потом спешу обратно по тропинке."

# ch/anna/events.rpy:2472
translate russian anna_birthday_date_male_b6b5d0cc:
    "Вскоре я нахожу ее возле последнего поворота, сидящей на пне."

# ch/anna/events.rpy:2473
translate russian anna_birthday_date_male_19de5cf9:
    "Это плохо, ведь мы должны были здесь разбить лагерь."

# ch/anna/events.rpy:2474
translate russian anna_birthday_date_male_f0995839:
    "А еще хуже то, что мы должны были это делать, чтобы отпраздновать день рождения Анны!"

# ch/anna/events.rpy:2475
translate russian anna_birthday_date_male_621132fd:
    mike.say "Анна..."

# ch/anna/events.rpy:2476
translate russian anna_birthday_date_male_c633af0c:
    mike.say "Ты в порядке?"

# ch/anna/events.rpy:2478
translate russian anna_birthday_date_male_3c0feb25:
    "На звук моего голоса Анна поднимает голову."

# ch/anna/events.rpy:2479
translate russian anna_birthday_date_male_2a469416:
    "И я вижу, что сейчас у нее на лице серьезная гримаса."

# ch/anna/events.rpy:2480
translate russian anna_birthday_date_male_7891753e:
    anna.say "[lssb_anna.hero_name()]!"

# ch/anna/events.rpy:2481
translate russian anna_birthday_date_male_c377bc7f:
    anna.say "Ты куда пропал?!"

# ch/anna/events.rpy:2482
translate russian anna_birthday_date_male_058a1bdb:
    anna.say "Я подумала, ты меня бросил!"

# ch/anna/events.rpy:2483
translate russian anna_birthday_date_male_bfb28783:
    "Я качаю головой, подхожу и опускаюсь на колени рядом с Анной."

# ch/anna/events.rpy:2487
translate russian anna_birthday_date_male_ca4c2b76:
    mike.say "Не глупи, Анна."

# ch/anna/events.rpy:2488
translate russian anna_birthday_date_male_a28a99f8:
    mike.say "Я был всего лишь немного дальше по тропе, вот и все."

# ch/anna/events.rpy:2489
translate russian anna_birthday_date_male_281b8479:
    mike.say "Что случилось?"

# ch/anna/events.rpy:2491
translate russian anna_birthday_date_male_2bd606ec:
    "В ответ Анна пинает меня ногой в пах."

# ch/anna/events.rpy:2492
translate russian anna_birthday_date_male_6de5ba20:
    "И она указывает на нее, широко раскрыв глаза."

# ch/anna/events.rpy:2493
translate russian anna_birthday_date_male_6fb12c18:
    anna.say "Моя нога, [lssb_anna.hero_name()]!"

# ch/anna/events.rpy:2494
translate russian anna_birthday_date_male_b5fe902c:
    anna.say "Я думаю, я ее сломала!"

# ch/anna/events.rpy:2495
translate russian anna_birthday_date_male_a811886f:
    anna.say "Я упала, и мне было очень трудно кое-как доковылять сюда!"

# ch/anna/events.rpy:2496
translate russian anna_birthday_date_male_09f317d6:
    mike.say "Ну что ж, давайте посмотрим..."

# ch/anna/events.rpy:2498
translate russian anna_birthday_date_male_53e79044:
    "Анна вскрикивает и вздрагивает, когда я снимаю с нее сапог."

# ch/anna/events.rpy:2499
translate russian anna_birthday_date_male_84eacd3e:
    "И она продолжает это делать, пока я осматриваю ее ногу."

# ch/anna/events.rpy:2500
translate russian anna_birthday_date_male_1a3ce696:
    "Я вижу, что ничего сломанного нет."

# ch/anna/events.rpy:2501
translate russian anna_birthday_date_male_4b583639:
    "Скорее всего, Анна просто немного вывихнула лодыжку."

# ch/anna/events.rpy:2502
translate russian anna_birthday_date_male_55e4fd7f:
    "Но как мне ей это объяснить?"

# ch/anna/events.rpy:2505
translate russian anna_birthday_date_male_533e9b97:
    "Я аккуратно надеваю Анне носок и начинаю снова засовывать ее ногу в сапог."

# ch/anna/events.rpy:2506
translate russian anna_birthday_date_male_9543f8e5:
    "И это вызывает у Анны крик удивления, но не боли."

# ch/anna/events.rpy:2508
translate russian anna_birthday_date_male_2fb2d056:
    anna.say "[lssb_anna.hero_name()], что ты делаешь?"

# ch/anna/events.rpy:2509
translate russian anna_birthday_date_male_35b5c0e7:
    anna.say "Тебе не стоило бы вызывать скорую помощь?"

# ch/anna/events.rpy:2510
translate russian anna_birthday_date_male_7e739489:
    anna.say "\"Или даже вертолет?\"."

# ch/anna/events.rpy:2511
translate russian anna_birthday_date_male_f91589ef:
    "Я поднимаю взгляд на Анну и улыбаюсь, качая головой."

# ch/anna/events.rpy:2512
translate russian anna_birthday_date_male_60a60e56:
    mike.say "Не нужно этого, Анна."

# ch/anna/events.rpy:2513
translate russian anna_birthday_date_male_27c9ba99:
    mike.say "Ты же ничего не сломала."

# ch/anna/events.rpy:2514
translate russian anna_birthday_date_male_aef8bf23:
    mike.say "У тебя просто немного болит лодыжка."

# ch/anna/events.rpy:2515
translate russian anna_birthday_date_male_52787fad:
    mike.say "Если ты наденешь свою обувь обратно, это поможет уменьшить отек."

# ch/anna/events.rpy:2516
translate russian anna_birthday_date_male_efb5167b:
    mike.say "А еще можно пройтись пешком, чтобы стало лучше."

# ch/anna/events.rpy:2518
translate russian anna_birthday_date_male_79d277ae:
    "Анна выглядит не слишком довольной таким диагнозом."

# ch/anna/events.rpy:2519
translate russian anna_birthday_date_male_f50453c4:
    "Поэтому я стараюсь помочь ей встать и беру у нее рюкзак."

# ch/anna/events.rpy:2520
translate russian anna_birthday_date_male_1615bac8:
    mike.say "Там недалеко до места, где мы сейчас разбиваем лагерь."

# ch/anna/events.rpy:2521
translate russian anna_birthday_date_male_c2671e44:
    mike.say "И я понесу это для тебя, хорошо?"

# ch/anna/events.rpy:2524
translate russian anna_birthday_date_male_1058e2f1:
    "Анна кивает, начиная выглядеть немного счастливее."

# ch/anna/events.rpy:2525
translate russian anna_birthday_date_male_f81183ff:
    "И она берет меня под руку, когда мы начинаем идти снова."

# ch/anna/events.rpy:2527
translate russian anna_birthday_date_male_3d35809a:
    "Я немедленно начинаю засовывать ногу Анны обратно в ее сапог."

# ch/anna/events.rpy:2528
translate russian anna_birthday_date_male_d95e68d9:
    "Это действие вызывает у нее еще больше слез и протестов."

# ch/anna/events.rpy:2530
translate russian anna_birthday_date_male_726c68e8:
    anna.say "Ой!"

# ch/anna/events.rpy:2531
translate russian anna_birthday_date_male_2fb2d056_1:
    anna.say "[lssb_anna.hero_name()], что ты делаешь?"

# ch/anna/events.rpy:2532
translate russian anna_birthday_date_male_35b5c0e7_1:
    anna.say "Тебе не стоило бы вызывать скорую помощь?"

# ch/anna/events.rpy:2533
translate russian anna_birthday_date_male_7e739489_1:
    anna.say "\"Или даже вертолет?\"."

# ch/anna/events.rpy:2534
translate russian anna_birthday_date_male_39b1b6e0:
    mike.say "Не будь такой драматичной, Анна."

# ch/anna/events.rpy:2535
translate russian anna_birthday_date_male_27c9ba99_1:
    mike.say "Ты же ничего не сломала."

# ch/anna/events.rpy:2536
translate russian anna_birthday_date_male_aef8bf23_1:
    mike.say "У тебя просто немного болит лодыжка."

# ch/anna/events.rpy:2537
translate russian anna_birthday_date_male_52787fad_1:
    mike.say "Если ты наденешь свою обувь обратно, это поможет уменьшить отек."

# ch/anna/events.rpy:2538
translate russian anna_birthday_date_male_efb5167b_1:
    mike.say "А еще можно пройтись пешком, чтобы стало лучше."

# ch/anna/events.rpy:2541
translate russian anna_birthday_date_male_79d277ae_1:
    "Анна выглядит не слишком довольной таким диагнозом."

# ch/anna/events.rpy:2542
translate russian anna_birthday_date_male_8d617fd7:
    "Но, кажется, она понимает, что спорить бесполезно."

# ch/anna/events.rpy:2543
translate russian anna_birthday_date_male_a0565d18:
    "Поэтому она встает и надевает рюкзак на плечи."

# ch/anna/events.rpy:2544
translate russian anna_birthday_date_male_1d93e102:
    "Хотя я вижу, что она нарочно прихрамывает, когда мы начинаем идти снова."

# ch/anna/events.rpy:2546
translate russian anna_birthday_date_male_7c881c25:
    "Я беру голую ногу Анны в свои руки и начинаю массировать опухшие участки."

# ch/anna/events.rpy:2547
translate russian anna_birthday_date_male_9543f8e5_1:
    "И это вызывает у Анны крик удивления, но не боли."

# ch/anna/events.rpy:2548
translate russian anna_birthday_date_male_2fb2d056_2:
    anna.say "[lssb_anna.hero_name()], что ты делаешь?"

# ch/anna/events.rpy:2549
translate russian anna_birthday_date_male_35b5c0e7_2:
    anna.say "Тебе не стоило бы вызывать скорую помощь?"

# ch/anna/events.rpy:2550
translate russian anna_birthday_date_male_7e739489_2:
    anna.say "\"Или даже вертолет?\"."

# ch/anna/events.rpy:2552
translate russian anna_birthday_date_male_f91589ef_1:
    "Я поднимаю взгляд на Анну и улыбаюсь, качая головой."

# ch/anna/events.rpy:2553
translate russian anna_birthday_date_male_60a60e56_1:
    mike.say "Не нужно этого, Анна."

# ch/anna/events.rpy:2554
translate russian anna_birthday_date_male_27c9ba99_2:
    mike.say "Ты же ничего не сломала."

# ch/anna/events.rpy:2555
translate russian anna_birthday_date_male_aef8bf23_2:
    mike.say "У тебя просто немного болит лодыжка."

# ch/anna/events.rpy:2556
translate russian anna_birthday_date_male_ef0c938f:
    mike.say "Этот массаж поможет предотвратить отек."

# ch/anna/events.rpy:2559
translate russian anna_birthday_date_male_03355538:
    "Анна кивает и наблюдает, как я массирую ей ногу."

# ch/anna/events.rpy:2560
translate russian anna_birthday_date_male_11d2ff3a:
    "И вскоре становится ясно, что ей это очень нравится!"

# ch/anna/events.rpy:2561
translate russian anna_birthday_date_male_7477ddf6:
    anna.say "Ох..."

# ch/anna/events.rpy:2563
translate russian anna_birthday_date_male_331b7fab:
    anna.say "Теперь немного лучше!"

# ch/anna/events.rpy:2564
translate russian anna_birthday_date_male_533e9b97_1:
    "Я аккуратно надеваю Анне носок и начинаю снова засовывать ее ногу в сапог."

# ch/anna/events.rpy:2565
translate russian anna_birthday_date_male_52787fad_2:
    mike.say "Если ты наденешь свою обувь обратно, это поможет уменьшить отек."

# ch/anna/events.rpy:2566
translate russian anna_birthday_date_male_efb5167b_2:
    mike.say "А еще можно пройтись пешком, чтобы стало лучше."

# ch/anna/events.rpy:2568
translate russian anna_birthday_date_male_79d277ae_2:
    "Анна выглядит не слишком довольной таким диагнозом."

# ch/anna/events.rpy:2569
translate russian anna_birthday_date_male_f50453c4_1:
    "Поэтому я стараюсь помочь ей встать и беру у нее рюкзак."

# ch/anna/events.rpy:2570
translate russian anna_birthday_date_male_1615bac8_1:
    mike.say "Там недалеко до места, где мы сейчас разбиваем лагерь."

# ch/anna/events.rpy:2571
translate russian anna_birthday_date_male_c2671e44_1:
    mike.say "И я понесу это для тебя, хорошо?"

# ch/anna/events.rpy:2574
translate russian anna_birthday_date_male_1058e2f1_1:
    "Анна кивает, начиная выглядеть немного счастливее."

# ch/anna/events.rpy:2575
translate russian anna_birthday_date_male_f81183ff_1:
    "И она берет меня под руку, когда мы начинаем идти снова."

# ch/anna/events.rpy:2579
translate russian anna_birthday_date_male_faa801ef:
    "Мы быстро добираемся до места, которое я выбрал для нашей ночевки."

# ch/anna/events.rpy:2580
translate russian anna_birthday_date_male_e4c1a7c0:
    "И как только мы приехали, я снимаю свой рюкзак и начинаю готовиться к установке лагеря."

# ch/anna/events.rpy:2583
translate russian anna_birthday_date_male_73af8179:
    "Но когда я поднимаю голову от того, что делаю, я вижу, как Анна смотрит на меня с вопросом."

# ch/anna/events.rpy:2584
translate russian anna_birthday_date_male_f1d8a63c:
    mike.say "Эм..."

# ch/anna/events.rpy:2585
translate russian anna_birthday_date_male_21721793:
    mike.say "Что случилось, Анна?"

# ch/anna/events.rpy:2586
translate russian anna_birthday_date_male_fa0a83b7:
    anna.say "Зачем мы остановились здесь, [lssb_anna.hero_name()]?"

# ch/anna/events.rpy:2587
translate russian anna_birthday_date_male_cfd3b882:
    anna.say "Это не похоже на место для кемпинга."

# ch/anna/events.rpy:2589
translate russian anna_birthday_date_male_71390f38:
    anna.say "Это просто где-то посреди леса!"

# ch/anna/events.rpy:2590
translate russian anna_birthday_date_male_da0041a2:
    mike.say "Ну что ж, это оно, Анна."

# ch/anna/events.rpy:2591
translate russian anna_birthday_date_male_8783650b:
    mike.say "Может быть, ты сможешь помочь мне установить палатку?"

# ch/anna/events.rpy:2592
translate russian anna_birthday_date_male_34b6bf47:
    "Анна качает головой."

# ch/anna/events.rpy:2594
translate russian anna_birthday_date_male_5830c977:
    anna.say "Нет!"

# ch/anna/events.rpy:2595
translate russian anna_birthday_date_male_12a63ec8:
    anna.say "Я постоянно ходила в походы со своими родителями, когда была маленькой."

# ch/anna/events.rpy:2596
translate russian anna_birthday_date_male_43d47418:
    anna.say "Так что я думаю, я знаю, как выглядит кемпинг!"

# ch/anna/events.rpy:2597
translate russian anna_birthday_date_male_a7c882c5:
    anna.say "Никак мой отец не смог бы проехать сюда на своем автодоме."

# ch/anna/events.rpy:2598
translate russian anna_birthday_date_male_094b97cb:
    "Думаю, начинаю понимать источник недоразумения."

# ch/anna/events.rpy:2599
translate russian anna_birthday_date_male_91dbf48c:
    mike.say "Нет, Анна..."

# ch/anna/events.rpy:2600
translate russian anna_birthday_date_male_3e34aed4:
    mike.say "Мы идём в поход дикарями. Ночевать будем в лесу."

# ch/anna/events.rpy:2602
translate russian anna_birthday_date_male_d21c39a4:
    anna.say "Но, но, но..."

# ch/anna/events.rpy:2603
translate russian anna_birthday_date_male_ebb0c790:
    anna.say "Где здесь ближайшие туалеты?!"

# ch/anna/events.rpy:2606
translate russian anna_birthday_date_male_e9b40fea:
    mike.say "Поверь мне, Анна."

# ch/anna/events.rpy:2607
translate russian anna_birthday_date_male_081190c2:
    mike.say "Здесь гораздо лучше."

# ch/anna/events.rpy:2609
translate russian anna_birthday_date_male_373f1bff:
    "Анна качает головой, как только я это говорю."

# ch/anna/events.rpy:2610
translate russian anna_birthday_date_male_85f6cb2a:
    anna.say "Как же ходить в туалет в лесу может быть лучше?!"

# ch/anna/events.rpy:2611
translate russian anna_birthday_date_male_a685cd77:
    mike.say "Мы здесь далеко от других людей, Анна."

# ch/anna/events.rpy:2612
translate russian anna_birthday_date_male_1c75615d:
    mike.say "Никто больше не шумит."

# ch/anna/events.rpy:2613
translate russian anna_birthday_date_male_1c4e27c5:
    mike.say "И никто нам не говорит, чтобы мы не шумели."

# ch/anna/events.rpy:2614
translate russian anna_birthday_date_male_0a51eb22:
    mike.say "Мы можем делать что угодно!"

# ch/anna/events.rpy:2616
translate russian anna_birthday_date_male_cc293e91:
    "Анна на мгновение задумалась."

# ch/anna/events.rpy:2617
translate russian anna_birthday_date_male_b51dbc5a:
    "Кажется, она немного смягчилась."

# ch/anna/events.rpy:2618
translate russian anna_birthday_date_male_9eaf3930:
    anna.say "О чем ты говоришь?"

# ch/anna/events.rpy:2619
translate russian anna_birthday_date_male_a99bf0b8:
    "Я подмигнул Анне."

# ch/anna/events.rpy:2620
translate russian anna_birthday_date_male_ae855e87:
    mike.say "Просто подожди и увидишь, Анна!"

# ch/anna/events.rpy:2623
translate russian anna_birthday_date_male_872e516d:
    "Кажется, это отвлекло Анну от менее приятных аспектов предстоящей ночи."

# ch/anna/events.rpy:2624
translate russian anna_birthday_date_male_5d9fdf3d:
    "И она начала помогать мне разбить лагерь."

# ch/anna/events.rpy:2626
translate russian anna_birthday_date_male_173bf553:
    mike.say "Я планирую выкопать яму."

# ch/anna/events.rpy:2627
translate russian anna_birthday_date_male_7cd1e053:
    "Я указал на ближайшую линию деревьев."

# ch/anna/events.rpy:2628
translate russian anna_birthday_date_male_ad4def08:
    mike.say "Примерно в ста ярдах отсюда."

# ch/anna/events.rpy:2629
translate russian anna_birthday_date_male_1d254958:
    mike.say "И я буду пользоваться ею, пока мы здесь."

# ch/anna/events.rpy:2630
translate russian anna_birthday_date_male_8706ce99:
    mike.say "Ты тоже можешь пользоваться моей ямой."

# ch/anna/events.rpy:2631
translate russian anna_birthday_date_male_047bd882:
    mike.say "Или ты можешь выкопать свою собственную."

# ch/anna/events.rpy:2632
translate russian anna_birthday_date_male_8c2509f0:
    "Я протянул лопату, которую взял с собой, чтобы проиллюстрировать свои слова."

# ch/anna/events.rpy:2634
translate russian anna_birthday_date_male_7f170300:
    "Но, похоже, Анна не в восторге от этой перспективы."

# ch/anna/events.rpy:2637
translate russian anna_birthday_date_male_87809e9f:
    anna.say "Ты имеешь в виду, что нам придется делать свои дела прямо в яме?"

# ch/anna/events.rpy:2638
translate russian anna_birthday_date_male_7eca74d4:
    anna.say "Как животные?!"

# ch/anna/events.rpy:2641
translate russian anna_birthday_date_male_667ee5b3:
    anna.say "О нет, это как в фильмах, где общество развалилось."

# ch/anna/events.rpy:2642
translate russian anna_birthday_date_male_0b61706f:
    anna.say "И больше ничего не работает. А может, даже хуже!"

# ch/anna/events.rpy:2643
translate russian anna_birthday_date_male_84f2e144:
    "Вскоре у меня на земле разложены все детали палатки."

# ch/anna/events.rpy:2645
translate russian anna_birthday_date_male_2a72a043:
    "Но рядом со мной стоит и Анна, которая смотрит на них с полным недоумением."

# ch/anna/events.rpy:2646
translate russian anna_birthday_date_male_3db9d7a0:
    mike.say "Что случилось, Анна?"

# ch/anna/events.rpy:2647
translate russian anna_birthday_date_male_f1f73f85:
    mike.say "Ты никогда раньше не видела палатку?"

# ch/anna/events.rpy:2648
translate russian anna_birthday_date_male_5562606b:
    "Анна хмурится на меня."

# ch/anna/events.rpy:2650
translate russian anna_birthday_date_male_ae0b8f08:
    anna.say "Конечно, я видела."

# ch/anna/events.rpy:2651
translate russian anna_birthday_date_male_9b0924b7:
    anna.say "Просто я никогда раньше не видела ее в таком виде, из таких частей!"

# ch/anna/events.rpy:2653
translate russian anna_birthday_date_male_2b34f631:
    anna.say "Ты уверен, что здесь все есть?"

# ch/anna/events.rpy:2654
translate russian anna_birthday_date_male_ac821560:
    "Я пожимаю плечами и наклоняюсь, чтобы поднять некоторые детали."

# ch/anna/events.rpy:2655
translate russian anna_birthday_date_male_742e38c6:
    mike.say "Есть только один способ узнать..."

# ch/anna/events.rpy:2657
translate russian anna_birthday_date_male_5d30f42b:
    "После этого мы начали собирать палатку."

# ch/anna/events.rpy:2658
translate russian anna_birthday_date_male_e1032371:
    "Вскоре мы добились реального прогресса."

# ch/anna/events.rpy:2659
translate russian anna_birthday_date_male_94b637c6:
    "Каркас готов, и мы можем натянуть водонепроницаемую ткань."

# ch/anna/events.rpy:2660
translate russian anna_birthday_date_male_621132fd_1:
    mike.say "Анна..."

# ch/anna/events.rpy:2661
translate russian anna_birthday_date_male_8c0ac702:
    mike.say "Накинь её сверху."

# ch/anna/events.rpy:2662
translate russian anna_birthday_date_male_17317618:
    mike.say "Я пойду внутрь и растяну её сверху."

# ch/anna/events.rpy:2664
translate russian anna_birthday_date_male_e465ea16:
    "Анна кивает, и я тороплюсь внутрь каркаса."

# ch/anna/events.rpy:2665
translate russian anna_birthday_date_male_7271ac1f:
    "Кажется, все идет по плану."

# ch/anna/events.rpy:2666
translate russian anna_birthday_date_male_b963b25b:
    "Но вдруг я слышу, как каркас рушится."

# ch/anna/events.rpy:2669
translate russian anna_birthday_date_male_8cee94b3:
    "И всё обрушивается на меня."

# ch/anna/events.rpy:2670
translate russian anna_birthday_date_male_818a57f3:
    "Застряв под всей палаткой, я пытаюсь выбраться."

# ch/anna/events.rpy:2671
translate russian anna_birthday_date_male_3337dc24:
    "Ситуацию не улучшает тот факт, что я слышу, как Анна смеется."

# ch/anna/events.rpy:2675
translate russian anna_birthday_date_male_cfb16d40:
    "Как только моя голова появляется наружу, она указывает на меня и снова смеется."

# ch/anna/events.rpy:2676
translate russian anna_birthday_date_male_49b12325:
    anna.say "Видишь, я знаю, как ставить палатку."

# ch/anna/events.rpy:2677
translate russian anna_birthday_date_male_b32fd9fc:
    anna.say "И как её разбирать!"

# ch/anna/events.rpy:2678
translate russian anna_birthday_date_male_0781cb3c:
    "Значит, во всем виновата была Анна!"

# ch/anna/events.rpy:2681
translate russian anna_birthday_date_male_64dd6cea:
    mike.say "Хорошо, Анна, хорошо..."

# ch/anna/events.rpy:2682
translate russian anna_birthday_date_male_d977e778:
    mike.say "Прости, что вел себя таким придурком."

# ch/anna/events.rpy:2683
translate russian anna_birthday_date_male_d8350a32:
    "Анна улыбается и кивает, принимая мои извинения."

# ch/anna/events.rpy:2684
translate russian anna_birthday_date_male_0e042a0d:
    "Затем она быстро подбегает, чтобы помочь мне выбраться из-под палатки."

# ch/anna/events.rpy:2686
translate russian anna_birthday_date_male_98038e85:
    "Когда мы в который раз взялись за дело, все идет гораздо лучше."

# ch/anna/events.rpy:2687
translate russian anna_birthday_date_male_480a68d4:
    "Благодаря тому, что мы работаем вместе, мы очень быстро ставим палатку."

# ch/anna/events.rpy:2688
translate russian anna_birthday_date_male_4a1eee77:
    "Чтобы закончить, мы достаем наши спальные мешки."

# ch/anna/events.rpy:2689
translate russian anna_birthday_date_male_a2c23433:
    "Потом мы закидываем туда и рюкзаки."

# ch/anna/events.rpy:2691
translate russian anna_birthday_date_male_f6077de5:
    mike.say "Анна!"

# ch/anna/events.rpy:2692
translate russian anna_birthday_date_male_0c2b7abd:
    mike.say "Ты не помогаешь!"

# ch/anna/events.rpy:2693
translate russian anna_birthday_date_male_0f6e15cd:
    "Кажется, Анне совершенно все равно, когда я пытаюсь ее отругать."

# ch/anna/events.rpy:2695
translate russian anna_birthday_date_male_f199e786:
    "На самом деле она продолжает смеяться, пока я выбираюсь из-под упавшей палатки."

# ch/anna/events.rpy:2696
translate russian anna_birthday_date_male_f711ed66:
    "Освободившись, я чувствую потребность уйти и немного успокоиться."

# ch/anna/events.rpy:2697
translate russian anna_birthday_date_male_7a2d2b9a:
    "Но когда я возвращаюсь, я удивляюсь, увидев, что Анна сама поставила палатку."

# ch/anna/events.rpy:2699
translate russian anna_birthday_date_male_79b3d69e:
    anna.say "Не волнуйся, [lssb_anna.hero_name()]."

# ch/anna/events.rpy:2701
translate russian anna_birthday_date_male_bf06adbc:
    anna.say "Я справлюсь!"

# ch/anna/events.rpy:2702
translate russian anna_birthday_date_male_cea016a3:
    "И вот она снова унизила меня!"

# ch/anna/events.rpy:2705
translate russian anna_birthday_date_male_6563db0f:
    "Анна высовывает голову из палатки и сладко улыбается мне."

# ch/anna/events.rpy:2706
translate russian anna_birthday_date_male_ee83d561:
    "Что очень хорошо, потому что это показывает, что она начинает получать удовольствие."

# ch/anna/events.rpy:2708
translate russian anna_birthday_date_male_f504c84f:
    anna.say "Хорошо, [lssb_anna.hero_name()]..."

# ch/anna/events.rpy:2709
translate russian anna_birthday_date_male_ed6b34d4:
    anna.say "Что мы теперь будем делать?"

# ch/anna/events.rpy:2710
translate russian anna_birthday_date_male_0ae754ba:
    "Я поднимаю голову от костра, который я разводил."

# ch/anna/events.rpy:2711
translate russian anna_birthday_date_male_85b35fae:
    "И должен признаться, это очень хороший вопрос."

# ch/anna/events.rpy:2714
translate russian anna_birthday_date_male_153b4ff8:
    "Я решаю, что это идеальный момент, чтобы достать свою гитару."

# ch/anna/events.rpy:2715
translate russian anna_birthday_date_male_d8c9e7cd:
    "И я небрежно перебираю струны, пока Анна подходит и садится рядом с костром."

# ch/anna/events.rpy:2716
translate russian anna_birthday_date_male_6c0b8495:
    mike.say "Я подумал, может быть, мы немного попоем вместе, Анна."

# ch/anna/events.rpy:2717
translate russian anna_birthday_date_male_c7687475:
    mike.say "Ну, как это обычно бывает?"

# ch/anna/events.rpy:2718
translate russian anna_birthday_date_male_fcc20faa:
    "Анна с энтузиазмом кивает головой, наклоняясь ко мне, когда я начинаю играть."

# ch/anna/events.rpy:2720
translate russian anna_birthday_date_male_aaeee857:
    anna.say "О да!"

# ch/anna/events.rpy:2721
translate russian anna_birthday_date_male_d6cd0917:
    anna.say "Я помню, как моя мама и папа пели у костра, когда я была маленькой!"

# ch/anna/events.rpy:2723
translate russian anna_birthday_date_male_85b20538:
    "Кажется, что проводить время на природе мне очень идет."

# ch/anna/events.rpy:2724
translate russian anna_birthday_date_male_ba82fe06:
    "Потому что с самого первого удара по струнам все получается отлично."

# ch/anna/events.rpy:2725
translate russian anna_birthday_date_male_4870b332:
    "Инструмент идеально настроен."

# ch/anna/events.rpy:2726
translate russian anna_birthday_date_male_0a63abf8:
    "Мои пальцы изящно и грациозно скользят по струнам."

# ch/anna/events.rpy:2727
translate russian anna_birthday_date_male_70dd2ef2:
    "И даже дым от костра, кажется, придает какой-то тембр моему голосу."

# ch/anna/events.rpy:2728
translate russian anna_birthday_date_male_f8fc8978:
    "Кажется, не имеет значения, что я играю."

# ch/anna/events.rpy:2729
translate russian anna_birthday_date_male_df027f19:
    "А Анна присоединяется, напевая все время."

# ch/anna/events.rpy:2731
translate russian anna_birthday_date_male_7684fff9:
    "Потом она прислоняется своей головой к моему плечу."

# ch/anna/events.rpy:2732
translate russian anna_birthday_date_male_bef29737:
    anna.say "Ой..."

# ch/anna/events.rpy:2733
translate russian anna_birthday_date_male_04f81720:
    anna.say "Это было просто замечательно, [lssb_anna.hero_name()]!"

# ch/anna/events.rpy:2736
translate russian anna_birthday_date_male_f3a4ad03:
    anna.say "Это сразу напомнило мне о походах в детстве."

# ch/anna/events.rpy:2738
translate russian anna_birthday_date_male_dea94513:
    "Я не знаю, что не так."

# ch/anna/events.rpy:2739
translate russian anna_birthday_date_male_b1a5ab70:
    "Но все начинает идти не так почти с самого начала."

# ch/anna/events.rpy:2741
translate russian anna_birthday_date_male_841e634f:
    "Моя гитара звучит как будто расстроена, хотя я знаю, что это невозможно."

# ch/anna/events.rpy:2742
translate russian anna_birthday_date_male_f0086aef:
    "И у меня все пальцы дрожат, наверное, из-за того, что я рубил дрова."

# ch/anna/events.rpy:2743
translate russian anna_birthday_date_male_603e1b1c:
    "Но самое ужасное – мой голос охрип и срывается, когда я пытаюсь петь."

# ch/anna/events.rpy:2744
translate russian anna_birthday_date_male_37fdc6fc:
    "Но когда я пытаюсь сделать глубокий вдох и откашляться, я вдыхаю дым от костра."

# ch/anna/events.rpy:2745
translate russian anna_birthday_date_male_67d5b96e:
    mike.say "Угх..."

# ch/anna/events.rpy:2746
translate russian anna_birthday_date_male_d5979dca:
    mike.say "А-а-а!"

# ch/anna/events.rpy:2749
translate russian anna_birthday_date_male_3706c7e1:
    "Анна закрывает руками уши и качает головой."

# ch/anna/events.rpy:2750
translate russian anna_birthday_date_male_6f940493:
    anna.say "О нет!"

# ch/anna/events.rpy:2751
translate russian anna_birthday_date_male_2aa95a20:
    anna.say "Пожалуйста, прекрати, [lssb_anna.hero_name()]!"

# ch/anna/events.rpy:2752
translate russian anna_birthday_date_male_4daaefed:
    anna.say "Ты мне уши сводишь!"

# ch/anna/events.rpy:2753
translate russian anna_birthday_date_male_d0d48b99:
    "Ну что ж, значит, эта идея не сработает."

# ch/anna/events.rpy:2755
translate russian anna_birthday_date_male_28173021:
    mike.say "Тебе уже не кажется, что ты немного проголодалась, Анна?"

# ch/anna/events.rpy:2756
translate russian anna_birthday_date_male_00138613:
    mike.say "В конце концов, мы шли сюда довольно долго."

# ch/anna/events.rpy:2757
translate russian anna_birthday_date_male_e15dde1d:
    mike.say "И установка палатки тоже потребовала немалых усилий."

# ch/anna/events.rpy:2759
translate russian anna_birthday_date_male_8cc391ff:
    "Сначала Анна, кажется, удивлена этим вопросом, как будто ей никогда не приходило это в голову."

# ch/anna/events.rpy:2760
translate russian anna_birthday_date_male_e4f3ac53:
    "Но потом она кладет руку на живот, и я почти слышу, как он урчит!"

# ch/anna/events.rpy:2762
translate russian anna_birthday_date_male_95d611c0:
    anna.say "Ого!"

# ch/anna/events.rpy:2763
translate russian anna_birthday_date_male_94901c96:
    anna.say "Раз уж ты заговорил об этом, я и правда проголодалась!"

# ch/anna/events.rpy:2765
translate russian anna_birthday_date_male_f85ada6f:
    mike.say "Хорошо, что я развел костер, правда?"

# ch/anna/events.rpy:2766
translate russian anna_birthday_date_male_b96a59f6:
    "Я поднимаю котелок и показываю Анне конструкцию, которую поставил, чтобы подвесить его над огнём."

# ch/anna/events.rpy:2768
translate russian anna_birthday_date_male_66c8fe91:
    mike.say "Не волнуйся."

# ch/anna/events.rpy:2769
translate russian anna_birthday_date_male_2a7eb0e1:
    mike.say "Ужин скоро будет готов!"

# ch/anna/events.rpy:2771
translate russian anna_birthday_date_male_07ab6427:
    "Анна с нетерпением наблюдает, как я слежу за кастрюлей."

# ch/anna/events.rpy:2773
translate russian anna_birthday_date_male_92a0c27f:
    "И она сияет от радости, когда я накладываю порцию для нас обоих."

# ch/anna/events.rpy:2774
translate russian anna_birthday_date_male_f8fcec75:
    mike.say "Вот, Анна."

# ch/anna/events.rpy:2775
translate russian anna_birthday_date_male_651a1402:
    mike.say "Угощайся!"

# ch/anna/events.rpy:2776
translate russian anna_birthday_date_male_77a3cf43:
    "Анна глубоко вдыхает аромат из своей горячей тарелки."

# ch/anna/events.rpy:2777
translate russian anna_birthday_date_male_13a1dea4:
    "И тут ее глаза загораются от чистого восторга."

# ch/anna/events.rpy:2778
translate russian anna_birthday_date_male_b62a8301:
    anna.say "Ммм!"

# ch/anna/events.rpy:2779
translate russian anna_birthday_date_male_75f607eb:
    anna.say "Это просто восхитительно пахнет!"

# ch/anna/events.rpy:2780
translate russian anna_birthday_date_male_f444008c:
    mike.say "Неважно, как это пахнет, Анна."

# ch/anna/events.rpy:2781
translate russian anna_birthday_date_male_2adec012:
    mike.say "Как на вкус?"

# ch/anna/events.rpy:2782
translate russian anna_birthday_date_male_1b7a1bb0:
    "Анна кивает и с энтузиазмом набирает ложкой немного еды в рот."

# ch/anna/events.rpy:2787
translate russian anna_birthday_date_male_f41a8174:
    "Затем она начинает зачерпывать ложку за ложкой и отправлять все это в себя."

# ch/anna/events.rpy:2788
translate russian anna_birthday_date_male_30e74fc5:
    mike.say "Эм..."

# ch/anna/events.rpy:2789
translate russian anna_birthday_date_male_fbe27bc6:
    mike.say "Анна?"

# ch/anna/events.rpy:2790
translate russian anna_birthday_date_male_c633af0c_1:
    mike.say "Ты в порядке?"

# ch/anna/events.rpy:2791
translate russian anna_birthday_date_male_ca99070f:
    "Я тянусь к Анне, но тут же отдергиваю руку."

# ch/anna/events.rpy:2793
translate russian anna_birthday_date_male_06610134:
    "Потому что она поднимает голову от своей тарелки, и я клянусь, мне показалось, что она на меня рычит!"

# ch/anna/events.rpy:2794
translate russian anna_birthday_date_male_102721cf:
    anna.say "Отойди, приятель!"

# ch/anna/events.rpy:2795
translate russian anna_birthday_date_male_f4870be2:
    anna.say "Это моя тарелка!"

# ch/anna/events.rpy:2797
translate russian anna_birthday_date_male_4878f200:
    "Практически сразу после этого Анна приходит в себя."

# ch/anna/events.rpy:2799
translate russian anna_birthday_date_male_857ee4a9:
    "Она выглядит смущенной и качает головой."

# ch/anna/events.rpy:2800
translate russian anna_birthday_date_male_6be68daa:
    anna.say "Ой... извини, [lssb_anna.hero_name()]!"

# ch/anna/events.rpy:2802
translate russian anna_birthday_date_male_98b43847:
    anna.say "Я не знаю, что на меня нашло."

# ch/anna/events.rpy:2803
translate russian anna_birthday_date_male_c445bfb8:
    anna.say "Наверное, я была голоднее, чем думала!"

# ch/anna/events.rpy:2804
translate russian anna_birthday_date_male_30f16d27:
    mike.say "Да... все в порядке, Анна."

# ch/anna/events.rpy:2805
translate russian anna_birthday_date_male_d393473f:
    mike.say "Зато теперь я знаю, что это вкусно..."

# ch/anna/events.rpy:2807
translate russian anna_birthday_date_male_07ab6427_1:
    "Анна с нетерпением наблюдает, как я слежу за кастрюлей."

# ch/anna/events.rpy:2809
translate russian anna_birthday_date_male_92a0c27f_1:
    "И она сияет от радости, когда я накладываю порцию для нас обоих."

# ch/anna/events.rpy:2810
translate russian anna_birthday_date_male_f8fcec75_1:
    mike.say "Вот, Анна."

# ch/anna/events.rpy:2811
translate russian anna_birthday_date_male_651a1402_1:
    mike.say "Приятного аппетита!"

# ch/anna/events.rpy:2812
translate russian anna_birthday_date_male_77a3cf43_1:
    "Анна глубоко вдыхает аромат из своей горячей тарелки."

# ch/anna/events.rpy:2814
translate russian anna_birthday_date_male_40ca0ccf:
    "Но потом она морщится и хмурится."

# ch/anna/events.rpy:2815
translate russian anna_birthday_date_male_8a6e44a2:
    anna.say "Фу!"

# ch/anna/events.rpy:2817
translate russian anna_birthday_date_male_d08bd8fe:
    anna.say "Так это должно пахнуть?"

# ch/anna/events.rpy:2818
translate russian anna_birthday_date_male_d00eef0e:
    anna.say "Как от вареных носков и... всякой гадости?"

# ch/anna/events.rpy:2819
translate russian anna_birthday_date_male_95129ce5:
    "Теперь моя очередь хмуриться в ответ Анне."

# ch/anna/events.rpy:2820
translate russian anna_birthday_date_male_200eb25b:
    mike.say "Эй!"

# ch/anna/events.rpy:2821
translate russian anna_birthday_date_male_6f4a996b:
    mike.say "Не оскорбляй мою готовку!"

# ch/anna/events.rpy:2822
translate russian anna_birthday_date_male_8a7a92cb:
    mike.say "Всё в порядке, и я докажу это..."

# ch/anna/events.rpy:2823
translate russian anna_birthday_date_male_26525daf:
    "Я набираю немного еды ложкой и отправляю ее в рот."

# ch/anna/events.rpy:2824
translate russian anna_birthday_date_male_3c375d03:
    "А через мгновение выплевываю её."

# ch/anna/events.rpy:2825
translate russian anna_birthday_date_male_0e614a09:
    mike.say "Угх!"

# ch/anna/events.rpy:2826
translate russian anna_birthday_date_male_5441231f:
    mike.say "Она действительно отвратительно пахнет носками и... всякой гадостью!"

# ch/anna/events.rpy:2827
translate russian anna_birthday_date_male_1f47d934:
    "Я смотрю, как Анна высыпает свою порцию на землю и качает головой."

# ch/anna/events.rpy:2829
translate russian anna_birthday_date_male_38dfe7d7:
    anna.say "Не волнуйся, [lssb_anna.hero_name()]..."

# ch/anna/events.rpy:2830
translate russian anna_birthday_date_male_5db86986:
    anna.say "У меня в сумке есть кое-какие закуски и чипсы."

# ch/anna/events.rpy:2833
translate russian anna_birthday_date_male_b1754e51:
    "Слышится шуршание где-то у линии деревьев."

# ch/anna/events.rpy:2834
translate russian anna_birthday_date_male_1b92efe8:
    "И когда Анна и я поднимаем головы, мы видим, как вокруг скачут какие-то маленькие животные."

# ch/anna/events.rpy:2835
translate russian anna_birthday_date_male_893b5acb:
    "Сначала трудно понять, что это такое."

# ch/anna/events.rpy:2836
translate russian anna_birthday_date_male_7adf6ac3:
    "Но потом кажется, что Анна видит их лучше, чем я."

# ch/anna/events.rpy:2838
translate russian anna_birthday_date_male_e85c3a2c:
    anna.say "Ой!"

# ch/anna/events.rpy:2839
translate russian anna_birthday_date_male_828412c9:
    anna.say "Смотри, [lssb_anna.hero_name()], семейство барсуков."

# ch/anna/events.rpy:2840
translate russian anna_birthday_date_male_20ea443b:
    anna.say "Они такие милые, правда?"

# ch/anna/events.rpy:2841
translate russian anna_birthday_date_male_b39d02ae:
    "Я слегка сморщиваюсь, когда лучше разглядываю этих животных."

# ch/anna/events.rpy:2842
translate russian anna_birthday_date_male_51388b8e:
    "Мне они кажутся довольно большими и потенциально опасными."

# ch/anna/events.rpy:2843
translate russian anna_birthday_date_male_5b914c01:
    mike.say "Я не уверен насчет этого, Анна..."

# ch/anna/events.rpy:2844
translate russian anna_birthday_date_male_794b8b67:
    mike.say "Мы не хотим, чтобы они добрались до наших запасов, пока мы спим."

# ch/anna/events.rpy:2845
translate russian anna_birthday_date_male_a84ab043:
    "Но похоже, что Анна ни слова из того, что я говорю, не слышит."

# ch/anna/events.rpy:2846
translate russian anna_birthday_date_male_d6f47c3e:
    "Она уже идет к барсукам с едой в руке."

# ch/anna/events.rpy:2847
translate russian anna_birthday_date_male_c2eb5fc6:
    anna.say "Эй, малыши!"

# ch/anna/events.rpy:2848
translate russian anna_birthday_date_male_ca810137:
    anna.say "Ты голоден?"

# ch/anna/events.rpy:2849
translate russian anna_birthday_date_male_f6077de5_1:
    mike.say "Анна!"

# ch/anna/events.rpy:2850
translate russian anna_birthday_date_male_4c843a4b:
    mike.say "Нет!"

# ch/anna/events.rpy:2851
translate russian anna_birthday_date_male_8b96519d:
    "Я подбегаю, пытаясь встать между Анной и барсуками."

# ch/anna/events.rpy:2853
translate russian anna_birthday_date_male_3e7ab221:
    "Конечно, это означает, что она и животные видят меня, и все замирают."

# ch/anna/events.rpy:2855
translate russian anna_birthday_date_male_590dae18:
    anna.say "[lssb_anna.hero_name()]..."

# ch/anna/events.rpy:2856
translate russian anna_birthday_date_male_b7b96865:
    anna.say "Что случилось?"

# ch/anna/events.rpy:2857
translate russian anna_birthday_date_male_ffe1cc97:
    mike.say "Будь осторожна, Анна!"

# ch/anna/events.rpy:2858
translate russian anna_birthday_date_male_df193e86:
    mike.say "Барсуки могут быть очень опасными, правда?"

# ch/anna/events.rpy:2859
translate russian anna_birthday_date_male_3ec53c7e:
    "Как только я это говорю, я вижу, как барсуки начинают действовать."

# ch/anna/events.rpy:2860
translate russian anna_birthday_date_male_92e180d4:
    "Одновременно они прыгают в воздух, показывая свои острые зубы."

# ch/anna/events.rpy:2861
translate russian anna_birthday_date_male_68d8e925:
    "И я смотрю с ужасом, уверенный, что Анна вот-вот подвергнется нападению."

# ch/anna/events.rpy:2862
translate russian anna_birthday_date_male_3c5d8f0a:
    "Что означает, что для меня это стало настоящим сюрпризом, когда все они на меня напали!"

# ch/anna/events.rpy:2865
translate russian anna_birthday_date_male_dba34620:
    "Внезапно на меня начали залезать барсуки."

# ch/anna/events.rpy:2866
translate russian anna_birthday_date_male_50fdd7b4:
    "Барсуки цепляются ко мне зубами и когтями."

# ch/anna/events.rpy:2868
translate russian anna_birthday_date_male_222c8d18:
    "И барсуки рычат в сантиметре от моего лица."

# ch/anna/events.rpy:2870
translate russian anna_birthday_date_male_4cb5b24f:
    mike.say "Аргх!"

# ch/anna/events.rpy:2871
translate russian anna_birthday_date_male_7ca0dcc2:
    mike.say "Снимите их с меня!"

# ch/anna/events.rpy:2872
translate russian anna_birthday_date_male_7ca0dcc2_1:
    mike.say "Снимите их с меня!"

# ch/anna/events.rpy:2873
translate russian anna_birthday_date_male_926ded51:
    "Анна делает все, что может, чтобы помочь."

# ch/anna/events.rpy:2874
translate russian anna_birthday_date_male_64220cf0:
    "Но в конце концов мне приходится физически отрывать барсуков от себя."

# ch/anna/events.rpy:2875
translate russian anna_birthday_date_male_c952410d:
    "И одного за другим я швыряю этих мелких засранцев как можно дальше."

# ch/anna/events.rpy:2877
translate russian anna_birthday_date_male_0a85d1d3:
    "Потом Анна как может помогает мне нашей походной аптечкой."

# ch/anna/events.rpy:2878
translate russian anna_birthday_date_male_f7c0a4cd:
    "Но у меня все еще исцарапано и изгрызено до ужаса."

# ch/anna/events.rpy:2880
translate russian anna_birthday_date_male_590dae18_1:
    anna.say "[lssb_anna.hero_name()]..."

# ch/anna/events.rpy:2881
translate russian anna_birthday_date_male_b7b96865_1:
    anna.say "Что случилось?"

# ch/anna/events.rpy:2882
translate russian anna_birthday_date_male_ffe1cc97_1:
    mike.say "Будь осторожна, Анна!"

# ch/anna/events.rpy:2883
translate russian anna_birthday_date_male_df193e86_1:
    mike.say "Барсуки могут быть очень опасными, правда?"

# ch/anna/events.rpy:2884
translate russian anna_birthday_date_male_e30c5a79:
    "И вот, когда я это говорю, я вижу, как барсуки приближаются."

# ch/anna/events.rpy:2885
translate russian anna_birthday_date_male_4a2b6ca7:
    "Я съёживаюсь и закрываю глаза, ожидая, что один из них укусит меня."

# ch/anna/events.rpy:2886
translate russian anna_birthday_date_male_38a3b431:
    "Но вместо этого я чувствую, как он облизывает мою руку."

# ch/anna/events.rpy:2887
translate russian anna_birthday_date_male_c89179ab:
    "Открыв глаза, я вижу картину, словно сошедшую со страниц сказки."

# ch/anna/events.rpy:2888
translate russian anna_birthday_date_male_ffa0b6c1:
    "Все барсуки собрались вокруг нас."

# ch/anna/events.rpy:2889
translate russian anna_birthday_date_male_3f02ffe8:
    "И Анна кормит их, как заколдованная принцесса!"

# ch/anna/events.rpy:2892
translate russian anna_birthday_date_male_4bbb4e2d:
    anna.say "\"Один для тебя\"."

# ch/anna/events.rpy:2893
translate russian anna_birthday_date_male_4bbb4e2d_1:
    anna.say "\"Один для тебя\"."

# ch/anna/events.rpy:2894
translate russian anna_birthday_date_male_db6cf206:
    anna.say "И тебя нельзя забывать, ведь ты ТАКОЙ милый!"

# ch/anna/events.rpy:2895
translate russian anna_birthday_date_male_1f9b8ac9:
    "Все, что я могу сделать, это покачать головой, наблюдая за тем, как барсуки спокойно берут еду."

# ch/anna/events.rpy:2896
translate russian anna_birthday_date_male_540cb829:
    "Затем они все убегают обратно в лес и оставляют нас одних у костра."

# ch/anna/events.rpy:2898
translate russian anna_birthday_date_male_e85c3a2c_1:
    anna.say "Ой!"

# ch/anna/events.rpy:2899
translate russian anna_birthday_date_male_93980df6:
    anna.say "Это было потрясающе!"

# ch/anna/events.rpy:2900
translate russian anna_birthday_date_male_c2bd3037:
    anna.say "Интересно, можно ли держать этих зверьков дома как питомцев?"

# ch/anna/events.rpy:2904
translate russian anna_birthday_date_male_f0afc262:
    "С наступлением вечера начинает падать температура."

# ch/anna/events.rpy:2905
translate russian anna_birthday_date_male_685486b4:
    "И вот тогда мы особенно рады костру."

# ch/anna/events.rpy:2907
translate russian anna_birthday_date_male_3cd84e90:
    "Для меня это еще один приятный бонус, что Анна прижимается ко мне."

# ch/anna/events.rpy:2908
translate russian anna_birthday_date_male_67b80071:
    "Я взял одеяло специально для таких случаев."

# ch/anna/events.rpy:2909
translate russian anna_birthday_date_male_75480571:
    "И я люблю ощущение ее рук, обнимающих меня под ним."

# ch/anna/events.rpy:2910
translate russian anna_birthday_date_male_590dae18_2:
    anna.say "[lssb_anna.hero_name()]..."

# ch/anna/events.rpy:2911
translate russian anna_birthday_date_male_6430fecb:
    mike.say "Да, Анна?"

# ch/anna/events.rpy:2912
translate russian anna_birthday_date_male_fada027f:
    anna.say "Ты же говорил, что берешь меня на природу в мой день рождения?"

# ch/anna/events.rpy:2913
translate russian anna_birthday_date_male_d8a05243:
    mike.say "Да, помню."

# ch/anna/events.rpy:2914
translate russian anna_birthday_date_male_21362daf:
    anna.say "Ну..."

# ch/anna/events.rpy:2915
translate russian anna_birthday_date_male_b541930e:
    anna.say "Это значит, что эта поездка – как... мой подарок на день рождения?"

# ch/anna/events.rpy:2917
translate russian anna_birthday_date_male_a5a68ac1:
    "Чёрт, я же знал, что должен был что-то сделать!"

# ch/anna/events.rpy:2918
translate russian anna_birthday_date_male_a53f60a4:
    "Из-за всех приготовлений к поездке, я забыл про подарок Анне на день рождения!"

# ch/anna/events.rpy:2919
translate russian anna_birthday_date_male_30e98180:
    "Похоже, мне придется импровизировать."

# ch/anna/events.rpy:2920
translate russian anna_birthday_date_male_a10117d5:
    mike.say "Да, Анна..."

# ch/anna/events.rpy:2921
translate russian anna_birthday_date_male_f604c5d8:
    mike.say "Ты очень наблюдательна."

# ch/anna/events.rpy:2922
translate russian anna_birthday_date_male_e11f6290:
    mike.say "Я подумал, что вместо того, чтобы купить тебе что-то..."

# ch/anna/events.rpy:2923
translate russian anna_birthday_date_male_d0af12ac:
    mike.say "Я подарю тебе воспоминания, которые останутся с тобой навсегда!"

# ch/anna/events.rpy:2924
translate russian anna_birthday_date_male_8e03a6e2:
    "Кажется, Анна немного задумалась."

# ch/anna/events.rpy:2925
translate russian anna_birthday_date_male_98109487:
    "И тогда она кивает."

# ch/anna/events.rpy:2928
translate russian anna_birthday_date_male_4ac83ca2:
    anna.say "Хорошо..."

# ch/anna/events.rpy:2929
translate russian anna_birthday_date_male_c9a9b5a4:
    anna.say "Я тоже так думала."

# ch/anna/events.rpy:2931
translate russian anna_birthday_date_male_6d1fb0cb:
    "Я чувствую по ее голосу, что она немного разочарована."

# ch/anna/events.rpy:2932
translate russian anna_birthday_date_male_802b5688:
    "Но хотя бы она приняла мою отговорку."

# ch/anna/events.rpy:2937
translate russian anna_birthday_date_male_32ca5f18:
    "Я качаю головой."

# ch/anna/events.rpy:2938
translate russian anna_birthday_date_male_365b7c69:
    mike.say "Надеюсь, воспоминания о сегодняшнем дне будут особенными, Анна."

# ch/anna/events.rpy:2939
translate russian anna_birthday_date_male_57ed4af6:
    mike.say "Но это не единственный подарок на твой день рождения."

# ch/anna/events.rpy:2940
translate russian anna_birthday_date_male_ab63cea0:
    "Я достаю подарок, который принес с собой, и дарю его Анне."

# ch/anna/events.rpy:2941
translate russian anna_birthday_date_male_14bab637:
    mike.say "С днем рождения, Анна!"

# ch/anna/events.rpy:2943
translate russian anna_birthday_date_male_bef29737_1:
    anna.say "Ой..."

# ch/anna/events.rpy:2944
translate russian anna_birthday_date_male_68f671cc:
    anna.say "Спасибо тебе огромное!"

# ch/anna/events.rpy:2946
translate russian anna_birthday_date_male_4b91b5f4:
    "Анна улыбается, когда рвет оберточную бумагу."

# ch/anna/events.rpy:2948
translate russian anna_birthday_date_male_0d14e0d8:
    "Но когда она видит, что внутри, ее челюсть отвисает."

# ch/anna/events.rpy:2950
translate russian anna_birthday_date_male_95d611c0_1:
    anna.say "Ого!"

# ch/anna/events.rpy:2951
translate russian anna_birthday_date_male_dab23265:
    anna.say "Я всегда хотела одну из этих!"

# ch/anna/events.rpy:2952
translate russian anna_birthday_date_male_563b140d:
    anna.say "Как ты узнал?"

# ch/anna/events.rpy:2953
translate russian anna_birthday_date_male_b006d08f:
    "Я пожимаю плечами и улыбаюсь, наслаждаясь удивлением Анны."

# ch/anna/events.rpy:2954
translate russian anna_birthday_date_male_5e283915:
    mike.say "Ну, ты же намекала, Анна!"

# ch/anna/events.rpy:2955
translate russian anna_birthday_date_male_ebd3e5f0:
    mike.say "И теперь у тебя есть доказательство того, что я слушаю тебя."

# ch/anna/events.rpy:2959
translate russian anna_birthday_date_male_83c6cb7d:
    "Анна крепче обнимает меня под одеялом."

# ch/anna/events.rpy:2960
translate russian anna_birthday_date_male_66d5ba8a:
    anna.say "Это здорово, [lssb_anna.hero_name()]."

# ch/anna/events.rpy:2961
translate russian anna_birthday_date_male_d5f08add:
    anna.say "И это еще лучше, потому что это от тебя!"

# ch/anna/events.rpy:2964
translate russian anna_birthday_date_male_b5d2c3f3:
    "Но когда она видит, что внутри, я замечаю, как ее лицо вытягивается."

# ch/anna/events.rpy:2966
translate russian anna_birthday_date_male_984ea5b3:
    anna.say "Ох..."

# ch/anna/events.rpy:2967
translate russian anna_birthday_date_male_aac1f42a:
    anna.say "Спасибо, [lssb_anna.hero_name()]."

# ch/anna/events.rpy:2969
translate russian anna_birthday_date_male_2fbf5c26:
    anna.say "Это… очень мило."

# ch/anna/events.rpy:2970
translate russian anna_birthday_date_male_c70ec06a:
    "Я понимаю, что Анна разочарована моим подарком."

# ch/anna/events.rpy:2971
translate russian anna_birthday_date_male_1d199365:
    "Но кажется, она изо всех сил старается это скрыть."

# ch/anna/events.rpy:2972
translate russian anna_birthday_date_male_9fc4b026:
    "Поэтому я могу только улыбаться и делать то же самое."

# ch/anna/events.rpy:2973
translate russian anna_birthday_date_male_3923b9b6:
    "Всю время проклиная свою неспособность выбрать для нее приличный подарок."

# ch/anna/events.rpy:2975
translate russian anna_birthday_date_male_a5a68ac1_1:
    "Чёрт, я же знал, что должен был что-то сделать!"

# ch/anna/events.rpy:2976
translate russian anna_birthday_date_male_a53f60a4_1:
    "Из-за всех приготовлений к поездке, я забыл про подарок Анне на день рождения!"

# ch/anna/events.rpy:2977
translate russian anna_birthday_date_male_30e98180_1:
    "Похоже, мне придется импровизировать."

# ch/anna/events.rpy:2978
translate russian anna_birthday_date_male_a10117d5_1:
    mike.say "Да, Анна..."

# ch/anna/events.rpy:2979
translate russian anna_birthday_date_male_f604c5d8_1:
    mike.say "Ты очень наблюдательна."

# ch/anna/events.rpy:2980
translate russian anna_birthday_date_male_e11f6290_1:
    mike.say "Я подумал, что вместо того, чтобы купить тебе что-то..."

# ch/anna/events.rpy:2981
translate russian anna_birthday_date_male_d0af12ac_1:
    mike.say "Я подарю тебе воспоминания, которые останутся с тобой навсегда!"

# ch/anna/events.rpy:2982
translate russian anna_birthday_date_male_8e03a6e2_1:
    "Кажется, Анна немного задумалась."

# ch/anna/events.rpy:2983
translate russian anna_birthday_date_male_98109487_1:
    "И тогда она кивает."

# ch/anna/events.rpy:2986
translate russian anna_birthday_date_male_4ac83ca2_1:
    anna.say "Хорошо..."

# ch/anna/events.rpy:2987
translate russian anna_birthday_date_male_c9a9b5a4_1:
    anna.say "Я тоже так думала."

# ch/anna/events.rpy:2988
translate russian anna_birthday_date_male_6d1fb0cb_1:
    "Я чувствую по ее голосу, что она немного разочарована."

# ch/anna/events.rpy:2989
translate russian anna_birthday_date_male_802b5688_1:
    "Но хотя бы она приняла мою отговорку."

# ch/anna/events.rpy:2991
translate russian anna_birthday_date_male_3bd22290:
    anna.say "О!"

# ch/anna/events.rpy:2992
translate russian anna_birthday_date_male_3c0843be:
    anna.say "Я только что вспомнила..."

# ch/anna/events.rpy:2994
translate russian anna_birthday_date_male_64503c09:
    anna.say "Я принесла зефир!"

# ch/anna/events.rpy:2996
translate russian anna_birthday_date_male_cde5c0da:
    "Анна выскальзывает из-под одеяла и начинает рыться в своей сумке."

# ch/anna/events.rpy:2997
translate russian anna_birthday_date_male_8b970d68:
    "Через несколько мгновений она возвращается с пакетом зефира и двумя палочками."

# ch/anna/events.rpy:2999
translate russian anna_birthday_date_male_bce5a1d2:
    anna.say "Давай пожарим эти вкусняшки!"

# ch/anna/events.rpy:3001
translate russian anna_birthday_date_male_917ead5a:
    "Вскоре у нас они уже на концах палочек."

# ch/anna/events.rpy:3002
translate russian anna_birthday_date_male_b24a2caa:
    "И мы поджариваем их над огнем."

# ch/anna/events.rpy:3003
translate russian anna_birthday_date_male_36f55f33:
    "Но, кажется, Анна держит свой слишком близко к огню."

# ch/anna/events.rpy:3004
translate russian anna_birthday_date_male_6c990ea2:
    "Потому что зефир вспыхивает пламенем."

# ch/anna/events.rpy:3005
translate russian anna_birthday_date_male_c8c97391:
    "Сахарное вещество горит ярким светом."

# ch/anna/events.rpy:3007
translate russian anna_birthday_date_male_6f940493_1:
    anna.say "О нет!"

# ch/anna/events.rpy:3008
translate russian anna_birthday_date_male_0baae609:
    anna.say "Что мне делать?!"

# ch/anna/events.rpy:3010
translate russian anna_birthday_date_male_eb8887f7_1:
    anna.say "[lssb_anna.hero_name()], помоги мне!"

# ch/anna/events.rpy:3014
translate russian anna_birthday_date_male_efa94122:
    "Я бросаю свою палочку в огонь, а затем беру палочку у Анны."

# ch/anna/events.rpy:3015
translate russian anna_birthday_date_male_2087a255:
    "И через мгновение я тоже бросаю ее в пламя."

# ch/anna/events.rpy:3016
translate russian anna_birthday_date_male_bb4e1753:
    "Затем я обращаю свое внимание на саму Анну."

# ch/anna/events.rpy:3017
translate russian anna_birthday_date_male_97e07d33:
    mike.say "Ты в порядке, Анна?"

# ch/anna/events.rpy:3018
translate russian anna_birthday_date_male_deb4b4a1:
    mike.say "Тебе не обожгло?"

# ch/anna/events.rpy:3020
translate russian anna_birthday_date_male_34b6bf47_1:
    "Анна качает головой."

# ch/anna/events.rpy:3021
translate russian anna_birthday_date_male_632312c9:
    "Но она все равно крепко меня обнимает."

# ch/anna/events.rpy:3023
translate russian anna_birthday_date_male_a66672fc:
    anna.say "Нет, [lssb_anna.hero_name()], со мной всё хорошо."

# ch/anna/events.rpy:3024
translate russian anna_birthday_date_male_5053bfaf:
    anna.say "Просто было страшно, вот и всё."

# ch/anna/events.rpy:3025
translate russian anna_birthday_date_male_bd15fd6c:
    "Я киваю и отвечаю на объятия."

# ch/anna/events.rpy:3026
translate russian anna_birthday_date_male_078b90ac:
    "Делаю все возможное, чтобы успокоить Анну."

# ch/anna/events.rpy:3028
translate russian anna_birthday_date_male_02d555f5:
    "Мне невольно хочется смеяться, глядя на то, как Анна отчаянно зовет на помощь."

# ch/anna/events.rpy:3030
translate russian anna_birthday_date_male_b1abb074:
    "И ее размахивания палкой только усугубляют ситуацию."

# ch/anna/events.rpy:3031
translate russian anna_birthday_date_male_862e6cca:
    "Ведь это только подливает масла в огонь."

# ch/anna/events.rpy:3032
translate russian anna_birthday_date_male_999bae75:
    mike.say "Ха-ха!"

# ch/anna/events.rpy:3033
translate russian anna_birthday_date_male_274b4a14:
    mike.say "Да что ж ты творишь, Анна!"

# ch/anna/events.rpy:3035
translate russian anna_birthday_date_male_a4ffb822:
    "В конце концов, Анна бросает всю эту штуку в огонь."

# ch/anna/events.rpy:3036
translate russian anna_birthday_date_male_e77978be:
    "Где она мгновенно вспыхивает и сгорает за считанные секунды."

# ch/anna/events.rpy:3037
translate russian anna_birthday_date_male_c46254a5:
    "Затем она сердито смотрит на меня."

# ch/anna/events.rpy:3040
translate russian anna_birthday_date_male_e0d0e577:
    anna.say "Это было совсем не смешно, [lssb_anna.hero_name()]!"

# ch/anna/events.rpy:3041
translate russian anna_birthday_date_male_c657d669:
    anna.say "Я действительно испугалась!"

# ch/anna/events.rpy:3042
translate russian anna_birthday_date_male_6e57a473:
    mike.say "Не знаю, Анна..."

# ch/anna/events.rpy:3043
translate russian anna_birthday_date_male_6ce78ed8:
    mike.say "Мне это показалось довольно забавным!"

# ch/anna/events.rpy:3044
translate russian anna_birthday_date_male_a820177f:
    "Когда наступает настоящая ночь, небо медленно заполняется звездами."

# ch/anna/events.rpy:3045
translate russian anna_birthday_date_male_af89d92c:
    "Анна и я немного времени смотрим на них."

# ch/anna/events.rpy:3047
translate russian anna_birthday_date_male_e9936e0d:
    "Но потом она издает очень громкий вздох."

# ch/anna/events.rpy:3048
translate russian anna_birthday_date_male_b0d07d00:
    anna.say "Ох..."

# ch/anna/events.rpy:3050
translate russian anna_birthday_date_male_3ac17481:
    anna.say "Я совершенно вымотана!"

# ch/anna/events.rpy:3051
translate russian anna_birthday_date_male_354d34b4:
    mike.say "Может, нам стоит лечь спать?"

# ch/anna/events.rpy:3052
translate russian anna_birthday_date_male_6a7c0f2b:
    mike.say "Мне тоже нужен сон."

# ch/anna/events.rpy:3053
translate russian anna_birthday_date_male_e77bb310:
    "Анна кивает, и мы забираемся в палатку, а затем в наши спальные мешки."

# ch/anna/events.rpy:3055
translate russian anna_birthday_date_male_fdd6e7eb:
    "Едва она застегивается, Анна прижимается ко мне."

# ch/anna/events.rpy:3056
translate russian anna_birthday_date_male_6491753f:
    "Мы оба устали, но это ощущение начинает меня будить."

# ch/anna/events.rpy:3057
translate russian anna_birthday_date_male_e5245d50:
    "И я имею в виду это в физическом смысле, если вы понимаете, о чем я..."

# ch/anna/events.rpy:3058
translate russian anna_birthday_date_male_dafdb6c1:
    "Да, Анна определенно трется своей задницей обо мне."

# ch/anna/events.rpy:3059
translate russian anna_birthday_date_male_e5af1bcf:
    "И при этом самым очевидным образом!"

# ch/anna/events.rpy:3061
translate russian anna_birthday_date_male_590dae18_3:
    anna.say "[lssb_anna.hero_name()]..."

# ch/anna/events.rpy:3062
translate russian anna_birthday_date_male_25a61e8a:
    mike.say "Да, Анна?"

# ch/anna/events.rpy:3063
translate russian anna_birthday_date_male_90e414fc:
    anna.say "Возможно, я не так уж и устала, как думала."

# ch/anna/events.rpy:3064
translate russian anna_birthday_date_male_f6629484:
    mike.say "Я тоже, Анна."

# ch/anna/events.rpy:3065
translate russian anna_birthday_date_male_68d46e87:
    anna.say "Мне кажется, у меня еще немного энергии осталось..."

# ch/anna/events.rpy:3066
translate russian anna_birthday_date_male_d3b69da1:
    "Я не знаю, кто первым начинает расстегивать молнию на спальном мешке."

# ch/anna/events.rpy:3067
translate russian anna_birthday_date_male_de04d4b3:
    "Но через мгновение мы оба начинаем двигаться навстречу друг другу..."

# ch/anna/events.rpy:3071
translate russian anna_birthday_date_male_37246c0d:
    "Едва Анна застегнула молнию, она поворачивается ко мне спиной."

# ch/anna/events.rpy:3072
translate russian anna_birthday_date_male_19b0ad4f:
    "А через несколько моментов я слышу, как она начинает храпеть."

# ch/anna/events.rpy:3073
translate russian anna_birthday_date_male_75499cc8:
    "Это немного разочаровывает, потому что я надеялся немного повеселиться."

# ch/anna/events.rpy:3074
translate russian anna_birthday_date_male_8bba0987:
    "И если не это, то хотя бы просто пообниматься."

# ch/anna/events.rpy:3075
translate russian anna_birthday_date_male_37487a99:
    "Но, наверное, мы оба очень устали после долгого дня."

# ch/anna/events.rpy:3076
translate russian anna_birthday_date_male_49bdde7d:
    "Поэтому я просто переворачиваюсь и тоже пытаюсь немного отдохнуть."

# ch/anna/events.rpy:3080
translate russian anna_birthday_sex_968c5902:
    "Раздевшись до белья, Анна выскальзывает из своего спальника и забирается в мой."

# ch/anna/events.rpy:3082
translate russian anna_birthday_sex_fe966881:
    "Маленькая, она прижимается ко мне спиной, согревая мой живот в спальнике, рассчитанном на одного."

# ch/anna/events.rpy:3084
translate russian anna_birthday_sex_155f9732:
    anna.say "М-м-м... Лучший день рождения, знаешь? Целая ночь здесь, только мы, деревья и миллион звёзд."

# ch/anna/events.rpy:3086
translate russian anna_birthday_sex_7ebec9e7:
    "В голосе девушки, которую так долго заставляли чувствовать себя ничтожеством, звучит тихое изумление. И оно каждый раз трогает меня."

# ch/anna/events.rpy:3088
translate russian anna_birthday_sex_90a430f3:
    anna.say "Но мне холодно, [lssb_anna.hero_name()]. Знаешь способ согреть свою именинницу?"

# ch/anna/events.rpy:3090
translate russian anna_birthday_sex_c824def6:
    "Она направляет одну мою руку к груди, а вторую — в трусики, точно зная, чего хочет."

# ch/anna/events.rpy:3092
translate russian anna_birthday_sex_4fc1034d:
    "Я целую её шею. Пальцы находят сосок, а другая рука дразнит влажные складки киски."

# ch/anna/events.rpy:3093
translate russian anna_birthday_sex_4c1e0922:
    "Но, когда я собираюсь проникнуть пальцами внутрь, она тянется вниз и хватает мою руку."

# ch/anna/events.rpy:3095
translate russian anna_birthday_sex_8eec209d:
    anna.say "Ах... Я не хочу их..."

# ch/anna/events.rpy:3097
translate russian anna_birthday_sex_3d8d23dc:
    anna.say "Я хочу это!"

# ch/anna/events.rpy:3098
translate russian anna_birthday_sex_fb5d71a3:
    "Она стягивает с меня шорты, пока я снимаю с неё трусики. В тесном спальнике мы отпихиваем их ногами."

# ch/anna/events.rpy:3099
translate russian anna_birthday_sex_a4e1f8a2:
    "Её маленькая ладонь находит меня в темноте и направляет к её телу. Когда головка начинает раздвигать её, она дрожит."

# ch/anna/events.rpy:3101
translate russian anna_birthday_sex_424913e1:
    anna.say "Боже, чувствуешь, как я готова к тебе, [lssb_anna.hero_name()]? От тебя я такая, даже когда ты просто дышишь рядом."

# ch/anna/events.rpy:3102
translate russian anna_birthday_sex_e64d47c2:
    "Я скольжу вдоль её щёлки, не входя, позволяя ей всё сильнее мокнуть и изнывать, прижимаясь ко всей длине."

# ch/anna/events.rpy:3104
translate russian anna_birthday_sex_74c03a04:
    anna.say "Хватит дразнить свою шлюшку-именинницу, просто вставь... Пожалуйста, пожалуйста, я весь день была такой хорошей."

# ch/anna/events.rpy:3105
translate russian anna_birthday_sex_359716d4:
    "Я ещё даже не начал, а она уже умоляет. И, боже помоги, именно такой я люблю её больше всего."

# ch/anna/events.rpy:3107
translate russian anna_birthday_sex_4be29ea0:
    "Я неторопливо целую её плечо и даю ей поизвиваться, затягивая момент, пока она сама не направляет меня внутрь."

# ch/anna/events.rpy:3113
translate russian anna_birthday_sex_2759a329:
    anna.say "М-м-м... Сегодня давай без этого, ладно, [lssb_anna.hero_name()]? Просто обними. Всё равно это лучший подарок."

# ch/anna/events.rpy:3114
translate russian anna_birthday_sex_671407cb:
    "Я прижимаю её к себе, устраиваю её голову под подбородком, и лес вокруг нас затихает."

# ch/anna/events.rpy:3119
translate russian anna_birthday_sex_d19e0583:
    anna.say "Ох... ух ты... Ты и правда в моей киске, [lssb_anna.hero_name()]. Мы почти никогда так не делаем, всё словно впервые."

# ch/anna/events.rpy:3120
translate russian anna_birthday_sex_8518bdd8:
    "Для девушки с татуировкой «АНАЛЬНАЯ ШЛЮХА» на спине это, наверное, и правда так."

# ch/anna/events.rpy:3122
translate russian anna_birthday_sex_d844f95a:
    anna.say "О да... вот так... С днём рождения меня, а?"

# ch/anna/events.rpy:3124
translate russian anna_birthday_sex_745016ab:
    anna.say "Эй... [lssb_anna.hero_name()]... Ты ведь всегда можешь вставить мне в попку. У меня день рождения."

# ch/anna/events.rpy:3125
translate russian anna_birthday_sex_8ec1a72f:
    "Но сегодня я хочу её именно так, как уже взял, и сообщаю об этом более сильным толчком."

# ch/anna/events.rpy:3126
translate russian anna_birthday_sex_9a201bca:
    anna.say "М-мх! Ладно-ладно, как хочешь, сэр. Тогда держи свою шлюшку прямо здесь, я вся твоя."

# ch/anna/events.rpy:3128
translate russian anna_birthday_sex_2c038b6f:
    anna.say "Давай, разнеси меня. Пусть твоя именинница чувствует это целую неделю."

# ch/anna/events.rpy:3131
translate russian anna_birthday_sex_e2a267a6:
    "Я кладу ладонь на её животик, а она накрывает её своей."

# ch/anna/events.rpy:3132
translate russian anna_birthday_sex_22d136a6:
    anna.say "Видишь? Теперь мне ничего не грозит, [lssb_anna.hero_name()]. Ты уже сделал своей шлюшке ребёнка. Так наполни меня и крепко обними."

# ch/anna/events.rpy:3135
translate russian anna_birthday_sex_2640a6fb:
    "Теперь Анна совсем перестала двигаться. Обмякшая, податливая — кукла, заведённая только для меня."

# ch/anna/events.rpy:3136
translate russian anna_birthday_sex_3e83459c:
    anna.say "Сегодня я для тебя просто дырка, сэр. Оплодотвори свою шлюшку, если хочешь. Для того я и нужна."

# ch/anna/events.rpy:3139
translate russian anna_birthday_sex_8d5210ed:
    anna.say "И не вздумай вынимать, когда кончишь. Кончай прямо в свою грязную шлюшку."

# ch/anna/events.rpy:3142
translate russian anna_birthday_sex_94435760:
    "Она обхватывает моё лицо ладонями и притягивает ближе, пока наши лбы не соприкасаются."

# ch/anna/events.rpy:3143
translate russian anna_birthday_sex_657fe3c3:
    anna.say "Я люблю тебя до глупости, [lssb_anna.hero_name()]. Однажды всё будет по-настоящему. Дом, малыш — вся эта дурацкая мечта."

# ch/anna/events.rpy:3144
translate russian anna_birthday_sex_f0551c06:
    "Из уст девушки, которая раньше вздрагивала от повышенного голоса, это звучит как клятва."

# ch/anna/events.rpy:3147
translate russian anna_birthday_sex_1a6319dc:
    anna.say "Боже, не заставляй меня так привязываться, [lssb_anna.hero_name()]. Сегодня просто развлекаемся. Хотя такого удовольствия у меня не было годами."

# ch/anna/events.rpy:3150
translate russian anna_birthday_sex_e9d1bf5e:
    anna.say "Вот так. Дай мне это, [lssb_anna.hero_name()]."

# ch/anna/events.rpy:3151
translate russian anna_birthday_sex_63c28364:
    "Ласковое прозвище срывается с её губ так, как бывает лишь тогда, когда она совсем теряет голову."

# ch/anna/events.rpy:3153
translate russian anna_birthday_sex_356fcc30:
    "Я поднимаю её колени к груди и вхожу глубже. В тесном спальнике едва хватает места, когда она выгибается."

# ch/anna/events.rpy:3154
translate russian anna_birthday_sex_b67d7a4c:
    anna.say "О блядь, вот там, вот там! Ты разрываешь меня, а мне всё равно."

# ch/anna/events.rpy:3156
translate russian anna_birthday_sex_215b47a0:
    "Холодный ночной воздух касается влажной кожи. Всё её тело напряжённо тянется навстречу каждому толчку."

# ch/anna/events.rpy:3157
translate russian anna_birthday_sex_86727c0c:
    anna.say "Сильнее, [lssb_anna.hero_name()], пожалуйста. Хочу чувствовать тебя завтра каждый раз, когда сажусь."

# ch/anna/events.rpy:3159
translate russian anna_birthday_sex_f8176fd2:
    "Подхватываю её рукой под спину и притягиваю к себе, пока между нами не остаётся места."

# ch/anna/events.rpy:3160
translate russian anna_birthday_sex_52975ebd:
    anna.say "Вот так, используй свою шлюшку до конца. Сегодня я твоя, сэр. Каждый развратный сантиметр."

# ch/anna/events.rpy:3161
translate russian anna_birthday_sex_265a0621:
    "Она уже болтает без всякого стеснения, а я трахаю её до самого предела собственного самообладания."

# ch/anna/events.rpy:3163
translate russian anna_birthday_sex_671b0ad0:
    anna.say "Не вздумай сдерживаться в мой день рождения. Дай мне всё, что можешь, [lssb_anna.hero_name()]."

# ch/anna/events.rpy:3170
translate russian anna_birthday_sex_df770279:
    "В последнее возможное мгновение я выхожу и кончаю ей на живот и грудь."

# ch/anna/events.rpy:3178
translate russian anna_birthday_sex_cd0a4a2f:
    anna.say "Эх, [lssb_anna.hero_name()]. В мой день рождения — и ты взял и вышел."

# ch/anna/events.rpy:3182
translate russian anna_birthday_sex_1acaa6b7:
    "К счастью для нас обоих, я заранее надел презерватив, поэтому двигаюсь в ней до самого конца."

# ch/anna/events.rpy:3184
translate russian anna_birthday_sex_ab4b7333:
    "Достигнув разрядки вместе со мной, Анна издаёт протяжный, почти звериный звук, а потом обмякает в спальнике."

# ch/anna/events.rpy:3186
translate russian anna_birthday_sex_a1f16eb5:
    anna.say "Лучший день рождения. Только пока не отпускай меня, ладно?"

# ch/anna/events.rpy:3188
translate russian anna_birthday_sex_3739b325:
    anna.say "Не... останавливайся... Я пью таблетки..."

# ch/anna/events.rpy:3191
translate russian anna_birthday_sex_3b57cd15:
    anna.say "О-ох... Вот чего я хотела... Весь мой день рождения в одном мгновении."

# ch/anna/events.rpy:3193
translate russian anna_birthday_sex_9c4bfc02:
    "Сейчас кончать в Анну не опасно: я прижимаюсь к её уже беременному животу."

# ch/anna/events.rpy:3196
translate russian anna_birthday_sex_c6dab09d:
    "Когда я теряю контроль, она не протестует. Просто остаётся на месте, тяжело дыша и тихо сияя в темноте."

# ch/anna/events.rpy:3198
translate russian anna_birthday_sex_6a78cf24:
    anna.say "М-м-м... Именно туда, куда нужно, [lssb_anna.hero_name()]."

# ch/anna/events.rpy:3200
translate russian anna_birthday_sex_c23dba35:
    "Надо бы выйти, прежде чем кончить внутрь. Но сегодня она позволяла мне решать всё остальное, а теперь уже всё равно поздно."

# ch/anna/events.rpy:3205
translate russian anna_birthday_sex_57c7f766:
    "Я крепко держу Анну и наполняю её последним толчком."

# ch/anna/events.rpy:3207
translate russian anna_birthday_sex_c4c0157e:
    anna.say "Ты и правда это сделал, [lssb_anna.hero_name()]. Наполнил свою шлюшку до краёв. Ещё и в мой день рождения."

# ch/anna/events.rpy:3209
translate russian anna_birthday_sex_a08bbf13:
    "Мы оба так увлеклись, что я прохожу точку невозврата и уже не могу выйти."

# ch/anna/events.rpy:3214
translate russian anna_birthday_sex_ce31bb11:
    "Сначала она довольно вздыхает, но, когда я выскальзываю из неё, звуки начинают меняться."

# ch/anna/events.rpy:3215
translate russian anna_birthday_sex_d11f885a:
    anna.say "Что... что ты только что сделал?.. Только не так. Не спросив меня. Не в мой день рождения."

# ch/anna/events.rpy:3217
translate russian anna_birthday_sex_3c4fdbc8:
    "Анна совсем потеряла голову, но я ненамного лучше. Не замечаю, насколько близок, пока оргазм не накрывает меня."

# ch/anna/events.rpy:3223
translate russian anna_birthday_sex_1e0c21ce:
    "Я готовлюсь к её вспышке. Но вместо этого она улыбается мне, сияя тем, что может быть только счастьем."

# ch/anna/events.rpy:3224
translate russian anna_birthday_sex_15777cc6:
    anna.say "Лучший... лучший день рождения, [lssb_anna.hero_name()]."

# ch/anna/events.rpy:3226
translate russian anna_birthday_sex_2739429d:
    "Мы снова сплетаемся в спальнике для одного, слишком измотанные, чтобы переживать из-за тесноты."

# ch/anna/events.rpy:3256
translate russian anna_preg_talk_f6038239:
    "Я сразу вижу, что у Анны что-то на уме."

# ch/anna/events.rpy:3257
translate russian anna_preg_talk_ca4929ad:
    "С такой честной и открытой девушкой, как Анна, ей почти невозможно скрыть то, о чем она на самом деле думает."

# ch/anna/events.rpy:3258
translate russian anna_preg_talk_2e3c05dd:
    "Огромные усилия, которые она прилагает, чтобы казаться нормальной, – это самый явный признак."

# ch/anna/events.rpy:3259
translate russian anna_preg_talk_4f3c41a5:
    "Не желая усложнять ее жизнь еще больше, я делаю вид, что все в порядке и что я ничего не подозреваю."

# ch/anna/events.rpy:3262
translate russian anna_preg_talk_c84159f8:
    "Она хорошо реагирует, когда я дарю ей страстный поцелуй и сжимаю ее ягодицы в процессе."

# ch/anna/events.rpy:3265
translate russian anna_preg_talk_41935eee:
    "Анна хихикает своим обычным непристойным смехом, и на мгновение кажется, что она снова вернулась к нормальному состоянию."

# ch/anna/events.rpy:3266
translate russian anna_preg_talk_063ca4e5:
    mike.say "Анна, ради бога, что случилось?"

# ch/anna/events.rpy:3267
translate russian anna_preg_talk_31802011:
    anna.say "Эм...о...ничего, наверное."

# ch/anna/events.rpy:3268
translate russian anna_preg_talk_62a27d91:
    mike.say "Либо ничего, либо что-то есть."

# ch/anna/events.rpy:3269
translate russian anna_preg_talk_d82a3677:
    mike.say "Может быть, ты просто расскажешь мне, вместо того чтобы гадать?"

# ch/anna/events.rpy:3271
translate russian anna_preg_talk_cc7303bb:
    "Анна смотрит на меня, ее глаза огромные и пристальные, из-за чего она выглядит больше как невинный щенок, чем когда-либо."

# ch/anna/events.rpy:3272
translate russian anna_preg_talk_43fe62b3:
    anna.say "Ну, я вот что подумала...мы можем заняться анальным сексом сегодня вечером?"

# ch/anna/events.rpy:3273
translate russian anna_preg_talk_d44d457c:
    "Я разразился смехом, просто не могу сдержаться."

# ch/anna/events.rpy:3274
translate russian anna_preg_talk_b456540c:
    mike.say "Анна, мы почти всегда делаем это именно так!"

# ch/anna/events.rpy:3275
translate russian anna_preg_talk_870c7edf:
    mike.say "Тебе это нравится, и мне нравится, что тебе это так сильно нравится."

# ch/anna/events.rpy:3276
translate russian anna_preg_talk_9269b390:
    mike.say "К тому же, это экономит деньги на презервативах и помогает нам избежать нежелательной беременности."

# ch/anna/events.rpy:3277
translate russian anna_preg_talk_36923cc3:
    "Когда он произносит последние слова, она мгновенно краснеет и нарочито отворачивается от меня."

# ch/anna/events.rpy:3278
translate russian anna_preg_talk_c8f4f4bc:
    mike.say "Анна... у тебя что-то есть, что ты хочешь мне сказать?"

# ch/anna/events.rpy:3279
translate russian anna_preg_talk_a2b70675:
    mike.say "Что-нибудь вроде того, что, я не знаю, у тебя пропустился какой-то важный женский цикл?"

# ch/anna/events.rpy:3280
translate russian anna_preg_talk_f6e52705:
    "Анна все еще не поворачивается и не смотрит мне в лицо."

# ch/anna/events.rpy:3281
translate russian anna_preg_talk_5273d852:
    "Но наконец она кивает, подтверждая мои подозрения."

# ch/anna/events.rpy:3282
translate russian anna_preg_talk_c9b97c38:
    mike.say "Но как?"

# ch/anna/events.rpy:3283
translate russian anna_preg_talk_be86874c:
    mike.say "Мы почти никогда не занимаемся этим нигде, кроме как ануса!"

# ch/anna/events.rpy:3284
translate russian anna_preg_talk_d7a2fc2f:
    mike.say "Боже мой, какая вероятность!"

# ch/anna/events.rpy:3286
translate russian anna_preg_talk_af00205c:
    "Анна наконец поворачивается, чтобы посмотреть мне в лицо."

# ch/anna/events.rpy:3287
translate russian anna_preg_talk_991f0582:
    "Ее глаза опухшие и красные, словно она вот-вот заплачет."

# ch/anna/events.rpy:3288
translate russian anna_preg_talk_e4241cfd:
    anna.say "Ну, мы никогда не беспокоились о предохранении, когда занимались этим... разве?"

# ch/anna/events.rpy:3289
translate russian anna_preg_talk_76a1cb3b:
    "Мне приходится кивнуть в знак согласия."

# ch/anna/events.rpy:3290
translate russian anna_preg_talk_42b6f57d:
    "Она совершенно права: мы так привыкли к анальному сексу, что в редких других случаях, видимо, просто ленились."

# ch/anna/events.rpy:3291
translate russian anna_preg_talk_19140678:
    "Мы думали, что будем в безопасности, просто потому что немного поигрались, и нас поймали."

# ch/anna/events.rpy:3292
translate russian anna_preg_talk_063e188f:
    anna.say "[lssb_anna.hero_name()], пожалуйста, не злись на меня?"

# ch/anna/events.rpy:3293
translate russian anna_preg_talk_46cdcc93:
    mike.say "Я виноват не меньше тебя, Анна. С чего мне на тебя злиться?"

# ch/anna/events.rpy:3294
translate russian anna_preg_talk_8b1c5f92:
    anna.say "Ну, понимаешь... Я хочу оставить это."

# ch/anna/events.rpy:3295
translate russian anna_preg_talk_e8a1b23e:
    "Кажется, что произнесение этих слов вслух как-то укрепляет ее решимость."

# ch/anna/events.rpy:3296
translate russian anna_preg_talk_b9bc1c96:
    anna.say "То есть... Я собираюсь оставить это."

# ch/anna/events.rpy:3297
translate russian anna_preg_talk_f23f134f:
    "Внезапно она выглядит очень уверенной и непреклонной."

# ch/anna/events.rpy:3298
translate russian anna_preg_talk_3790dcf0:
    "Тогда я понимаю, что она ждет моей реакции на то, что она только что сказала."

# ch/anna/events.rpy:3301
translate russian anna_preg_talk_6609766e:
    mike.say "Тебе решать, Анна. Твоё тело, твой выбор."

# ch/anna/events.rpy:3302
translate russian anna_preg_talk_a861d545:
    mike.say "Но сейчас двадцать первый век, и я современный человек."

# ch/anna/events.rpy:3303
translate russian anna_preg_talk_49d470db:
    mike.say "Я не позволю каким-то устаревшим представлениям о том, что 'правильно', управлять мной."

# ch/anna/events.rpy:3304
translate russian anna_preg_talk_b991ecbe:
    anna.say "Что... Что ты говоришь?"

# ch/anna/events.rpy:3305
translate russian anna_preg_talk_fdc49673:
    mike.say "Я говорю, Анна, что ты можешь оставить ребенка с моего благословения."

# ch/anna/events.rpy:3306
translate russian anna_preg_talk_aed51fc8:
    mike.say "Но тебе придется делать это самой."

# ch/anna/events.rpy:3307
translate russian anna_preg_talk_0ca087e8:
    "Глаза Анны еще больше расширяются, и она наконец начинает плакать."

# ch/anna/events.rpy:3308
translate russian anna_preg_talk_d0a7eef7:
    anna.say "Ты имеешь в виду, что... что между нами все кончено?"

# ch/anna/events.rpy:3309
translate russian anna_preg_talk_17805c68:
    mike.say "Да, я думаю, именно это я и имею в виду."

# ch/anna/events.rpy:3316
translate russian anna_preg_talk_29078a34:
    mike.say "Анна, ты действительно все обдумала?"

# ch/anna/events.rpy:3317
translate russian anna_preg_talk_b4be0c7f:
    mike.say "Я имею в виду, действительно все обдумала?"

# ch/anna/events.rpy:3318
translate russian anna_preg_talk_e59b8f89:
    anna.say "Ну, я знаю об этом не так уж и долго."

# ch/anna/events.rpy:3319
translate russian anna_preg_talk_cd89a5bd:
    anna.say "Я просто знаю, что хочу это оставить."

# ch/anna/events.rpy:3320
translate russian anna_preg_talk_852ae82b:
    anna.say "Мне кажется, это правильно, а вот избавляться от этого – нет."

# ch/anna/events.rpy:3321
translate russian anna_preg_talk_db25ce7e:
    "Я вздыхаю с разочарованием, желая остаться с Анной, но совершенно не готовый стать отцом."

# ch/anna/events.rpy:3322
translate russian anna_preg_talk_53f966a8:
    anna.say "Я хочу этого ребёнка, [lssb_anna.hero_name()]. С тобой или без тебя!"

# ch/anna/events.rpy:3323
translate russian anna_preg_talk_d19f505c:
    "Все, что я могу сделать, это грустно пожать плечами и отвести взгляд от нее."

# ch/anna/events.rpy:3324
translate russian anna_preg_talk_1eb42c12:
    anna.say "Думаю, тогда это будет без тебя..."

# ch/anna/events.rpy:3327
translate russian anna_preg_talk_a07715cd:
    "Несколько мгновений я молчу, но улыбка на моем лице начинает вызывать ответную улыбку у Анны."

# ch/anna/events.rpy:3329
translate russian anna_preg_talk_1600f66e:
    anna.say "Зачем ты так глупо улыбаешься, [lssb_anna.hero_name()]?"

# ch/anna/events.rpy:3330
translate russian anna_preg_talk_68a3f5b2:
    mike.say "Я просто представил тебя с огромным животиком!"

# ch/anna/events.rpy:3332
translate russian anna_preg_talk_d5c86816:
    anna.say "Эй!"

# ch/anna/events.rpy:3334
translate russian anna_preg_talk_2d96446b:
    mike.say "Нет, ты всё не так поняла. Думаю, беременность будет тебе очень идти."

# ch/anna/events.rpy:3335
translate russian anna_preg_talk_e9a048d2:
    mike.say "Я также думаю, что ты станешь отличной мамой."

# ch/anna/events.rpy:3336
translate russian anna_preg_talk_53d29607:
    "Анна смотрит на меня с надеждой, зная, что я еще не произнес тех слов, которые она хочет услышать."

# ch/anna/events.rpy:3337
translate russian anna_preg_talk_16ce9fa7:
    mike.say "Ладно, скажу прямо: я хочу быть с тобой. И с ребёнком тоже."

# ch/anna/events.rpy:3339
translate russian anna_preg_talk_14d531e5:
    "Мне больше ничего не нужно говорить, потому что выражение счастья в глазах Анны, когда она внезапно обнимает меня, говорит само за себя."

# ch/anna/events.rpy:3340
translate russian anna_preg_talk_3e4fd6f9:
    "Должно было быть еще много чего в этот вечер: больше слов сказано и дел сделано."

# ch/anna/events.rpy:3341
translate russian anna_preg_talk_59fe55a6:
    "Но все, что я могу вспомнить, даже после того, как Анна ушла, – это бомбу, которую она мне сбросила, и что это значит для наших отношений."

# ch/anna/events.rpy:3342
translate russian anna_preg_talk_283d56f3:
    "Все меняется отсюда, к лучшему или к худшему."

# ch/anna/events.rpy:3349
translate russian anna_kiss_me_2413ab9c:
    "Когда Анна почти подпрыгивает и хватает меня за воротник, я не могу не думать, что ее что-то напугало."

# ch/anna/events.rpy:3350
translate russian anna_kiss_me_93d26969:
    "Но потом я вижу ее глаза, всего в нескольких дюймах от моих, когда она крепко держит меня."

# ch/anna/events.rpy:3351
translate russian anna_kiss_me_e0eeb5da:
    "В них нет ни следа удивления или страха, только интенсивный взгляд желания."

# ch/anna/events.rpy:3355
translate russian anna_kiss_me_d38e097d:
    "И затем она прижимает свои губы к моим, целуя меня без секунды колебаний."

# ch/anna/events.rpy:3356
translate russian anna_kiss_me_47793c1d:
    "Не раздумывая, я обнимаю ее руками, поднимая ее с земли."

# ch/anna/events.rpy:3357
translate russian anna_kiss_me_fa763270:
    "Анна крепко держится за меня, как маленькая любвеобильная обезьянка, просто отказываясь отпускать даже на секунду."

# ch/anna/events.rpy:3362
translate russian anna_practice_01_d68e9522:
    "Поскольку \"Битва групп\" уже вот-вот начнется, кажется, что последние несколько дней я был заперт в репетиционной комнате с девушками каждую свободную минуту."

# ch/anna/events.rpy:3363
translate russian anna_practice_01_eede8248:
    "Стресс растет, и из-за того, что мы находимся в таком тесном помещении, почти чувствуешь напряжение, когда мы снова и снова повторяем одно и то же."

# ch/anna/events.rpy:3366
translate russian anna_practice_01_47a9d2d3:
    "Саша сегодня более прямолинейна, чем обычно, и трудно добиться от Клео чего-либо, кроме хмыканий и язвительных взглядов."

# ch/anna/events.rpy:3368
translate russian anna_practice_01_0bee3c0c:
    "Но Анна словно ничего не замечает: беззаботно колотит по барабанам и при первой возможности бросает на меня обожающие взгляды."

# ch/anna/events.rpy:3370
translate russian anna_practice_01_85f0a959:
    sasha.say "Анна, что за черт?!"

# ch/anna/events.rpy:3372
translate russian anna_practice_01_4c6ae201:
    anna.say "Что?"

# ch/anna/events.rpy:3373
translate russian anna_practice_01_d7531098:
    sasha.say "Ты не держишь ритм, это портит наш звук."

# ch/anna/events.rpy:3375
translate russian anna_practice_01_c58aa55d:
    kleio.say "Она права, Анна. Я тоже это слышала."

# ch/anna/events.rpy:3376
translate russian anna_practice_01_b5ca6cf0:
    "Анна выглядит удивленной и немного расстроенной из-за этого обвинения."

# ch/anna/events.rpy:3379
translate russian anna_practice_01_d51e8866:
    "Я понимаю, что, в отличие от Саши и Клео, я не заметил ошибки Анны."

# ch/anna/events.rpy:3380
translate russian anna_practice_01_9dd328c6:
    "И тут до меня доходит: дело было в том внимании, которое она уделяла мне. Наверное, поэтому и сбилась."

# ch/anna/events.rpy:3381
translate russian anna_practice_01_eb28e4bf:
    "Наступает неловкая тишина, пока девушки ждут, когда я выскажу свое мнение как участник группы."

# ch/anna/events.rpy:3385
translate russian anna_practice_01_2c1ea878:
    mike.say "Я этого не слышал, если это имеет значение."

# ch/anna/events.rpy:3387
translate russian anna_practice_01_6cf7abd0:
    "В глазах Анны читается благодарность за поддержку, и она кажется немного более жизнерадостной."

# ch/anna/events.rpy:3389
translate russian anna_practice_01_7f63d63d:
    kleio.say "Господи, чувак, я знала, что у тебя нет слуха. Но такое можно пропустить, только если ты совсем глухой!"

# ch/anna/events.rpy:3390
translate russian anna_practice_01_2a21daa7:
    mike.say "Погоди-ка, Клео... мы все сейчас на взводе и измотаны, и ссоры только ухудшат ситуацию."

# ch/anna/events.rpy:3392
translate russian anna_practice_01_1aeb18dc:
    sasha.say "Он прав, Клео. Да, Анна накосячила, но мы все на нервах. Давайте передохнём, пока ещё можем."

# ch/anna/events.rpy:3396
translate russian anna_practice_01_3fdf629d:
    mike.say "Может, ты немного и сбилась, Анна, но не сильно."

# ch/anna/events.rpy:3398
translate russian anna_practice_01_3ad6379f:
    "Глаза Анны расширяются, когда все трое из нас по сути соглашаемся с тем, что она совершила ошибку, и она грустно смотрит на барабанные палочки в своих руках."

# ch/anna/events.rpy:3399
translate russian anna_practice_01_ae95fe8e:
    anna.say "Мне очень жаль, ребята... наверное, я просто недостаточно старалась."

# ch/anna/events.rpy:3401
translate russian anna_practice_01_c7dcdd1d:
    sasha.say "Да мы все вымотались, Анна... Но мы команда и справимся. Давайте пять минут отдыха, чтобы прийти в себя."

# ch/anna/events.rpy:3404
translate russian anna_practice_01_050cb86d:
    mike.say "Они правы, Анна. Ты лажаешь в своей партии и сбиваешь нас всех."

# ch/anna/events.rpy:3406
translate russian anna_practice_01_efd35e53:
    "Глаза Анны мгновенно наполнились неуверенностью, ее губы слегка дрожали, и я понял, что она ожидала от меня защиты."

# ch/anna/events.rpy:3408
translate russian anna_practice_01_7ab7ac84:
    kleio.say "Он не ошибается, Анна. Но вешаться из-за этого не надо!"

# ch/anna/events.rpy:3410
translate russian anna_practice_01_fa896a4e:
    sasha.say "Да, Анна, до конкурса мы всё исправим. А сейчас нам нужно перевести дух."

# ch/anna/events.rpy:3416
translate russian anna_practice_01_92124534:
    "Все кладут свои инструменты, и ощущается почти физическое облегчение, как будто с нас всех сняли тяжелый груз."

# ch/anna/events.rpy:3417
translate russian anna_practice_01_b26a2538:
    "Я выхожу в коридор, где открыто окно, и есть возможность подышать свежим воздухом."

# ch/anna/events.rpy:3418
translate russian anna_practice_01_cf2a6553:
    "Я был там всего полминуты, когда услышал, как открылась дверь, и увидел, что Анна последовала за мной."

# ch/anna/events.rpy:3421
translate russian anna_practice_01_d9562ad6:
    anna.say "Привет, спасибо, что заступилась за меня."

# ch/anna/events.rpy:3422
translate russian anna_practice_01_d198a841:
    mike.say "Не за что… слушай, я знаю, ты была не в себе, потому что тебе нравлюсь я."

# ch/anna/events.rpy:3423
translate russian anna_practice_01_3bb0f25d:
    anna.say "Я такая очевидная?"

# ch/anna/events.rpy:3424
translate russian anna_practice_01_d9c66a94:
    mike.say "Не переживай, может быть, это стресс на тебя действует, все в порядке."

# ch/anna/events.rpy:3425
translate russian anna_practice_01_9d64a636:
    mike.say "Если честно, я не злюсь… наоборот, мне приятно."

# ch/anna/events.rpy:3427
translate russian anna_practice_01_0debe727:
    "Настроение Анны внезапно улучшилось, и она крепко обняла меня."

# ch/anna/events.rpy:3428
translate russian anna_practice_01_04afbc39:
    "Ее миниатюрная фигура означает, что она едва доходит до моей груди, но ее объятия очень сильные."

# ch/anna/events.rpy:3429
translate russian anna_practice_01_849d7d35:
    mike.say "Я просто хочу, чтобы ты знала, Анна… ты важнее, чем победа в этом конкурсе."

# ch/anna/events.rpy:3432
translate russian anna_practice_01_faf5c63a:
    anna.say "Ты действительно думал, что я испортила песню только что?"

# ch/anna/events.rpy:3433
translate russian anna_practice_01_9fc2c025:
    "Я делаю глубокий вдох и проведу рукой по лицу, пытаясь избавиться от усталости."

# ch/anna/events.rpy:3434
translate russian anna_practice_01_8cac0d57:
    mike.say "Послушай, Анна, прости, что мы так на тебя набросились. Но ты немного сбивалась."

# ch/anna/events.rpy:3435
translate russian anna_practice_01_a3a78c53:
    mike.say "Но, честно говоря, думаю, что ошиблись все... просто Саша заметила это первой, и мы все подхватили."

# ch/anna/events.rpy:3436
translate russian anna_practice_01_363d6443:
    "Анна кивает, все еще выглядит грустной, но, возможно, немного успокоившись от того, что она не является самым слабым звеном в группе."

# ch/anna/events.rpy:3437
translate russian anna_practice_01_a935dae1:
    anna.say "Ладно, я думаю, это кое-что значит."

# ch/anna/events.rpy:3439
translate russian anna_practice_01_cc200688:
    "Она обнимает меня нежно, скорее для того, чтобы убедиться в этом, чем из каких-либо других чувств, и я слабо обнимаю ее в ответ."

# ch/anna/events.rpy:3442
translate russian anna_practice_01_57e02a46:
    anna.say "Прости... пожалуйста, не злись на меня!"

