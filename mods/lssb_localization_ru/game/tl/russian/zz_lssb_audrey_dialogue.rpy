# ch/audrey/reactions.rpy:220
translate russian audrey_breakup_male_662b09c8:
    audrey.say "На самом деле, ты мне сделал одолжение."

# ch/audrey/reactions.rpy:221
translate russian audrey_breakup_male_30e74fc5:
    mike.say "Эм..."

# ch/audrey/reactions.rpy:222
