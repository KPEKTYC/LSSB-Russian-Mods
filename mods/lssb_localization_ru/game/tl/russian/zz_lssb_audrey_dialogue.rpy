# ch/audrey/reactions.rpy:291
translate russian audrey_pet_annoyed_male_23539d3e:
    audrey.say "Я тебе не домашняя зверушка, [lssb_audrey.hero_name()]. Прибереги это до места поукромнее, ладно?"

# ch/audrey/reactions.rpy:295
translate russian audrey_massage_intro_male_52b0f005:
    mike.say "Ты сегодня какая-то особенно вредная, Одри."

# ch/audrey/reactions.rpy:296
translate russian audrey_massage_intro_male_e1d52c09:
    mike.say "Хочешь массаж или что-нибудь в этом роде?"

# ch/audrey/reactions.rpy:297
translate russian audrey_massage_intro_male_d659dab6:
