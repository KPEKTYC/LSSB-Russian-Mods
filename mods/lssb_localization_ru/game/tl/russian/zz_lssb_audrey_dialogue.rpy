# ch/audrey/talk.rpy:375
translate russian submissive_interact_audrey_male_bcad0a8d:
    mike.say "А, может быть, ты права, Одри..."

# ch/audrey/texts.rpy:6
translate russian audrey_friendly_texts_de156a64:
    audrey_nvl "Ты хочешь пойти выпить кофе со мной?"

# ch/audrey/texts.rpy:7
translate russian audrey_friendly_texts_4fd278ca:
