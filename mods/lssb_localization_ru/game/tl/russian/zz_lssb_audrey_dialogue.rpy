# ch/audrey/events.rpy:1007
translate russian audrey_spanking_2_e96a7ee9:
    audrey.say "Ну, похоже, я была очень плохой девочкой."

# ch/audrey/events.rpy:1008
translate russian audrey_spanking_2_7edfe91d:
