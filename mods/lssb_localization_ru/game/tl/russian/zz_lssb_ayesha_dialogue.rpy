translate russian ayesha_date_play_arcade_lose_male_8ec2f3e3:
    mike.say "Что за чертовщина?"

# ch/ayesha/date.rpy:958
translate russian ayesha_date_play_arcade_lose_male_1317ede2:
    mike.say "Аиша, как ты это делаешь?!"

# ch/ayesha/date.rpy:959
translate russian ayesha_date_play_arcade_lose_male_fb192ce8:
    "Я постоянно поглядываю в сторону Аиши, пока мы играем."

# ch/ayesha/date.rpy:960
translate russian ayesha_date_play_arcade_lose_male_def2b240:
    "И я клянусь, она все время ухмыляется мне."

# ch/ayesha/date.rpy:961
translate russian ayesha_date_play_arcade_lose_male_200625ac:
    "Мне нравится, что она меня так легко обыгрывает!"

# ch/ayesha/date.rpy:962
translate russian ayesha_date_play_arcade_lose_male_c0b9cf9e:
    ayesha.say "Вау, [lssb_ayesha.hero_name()]..."

# ch/ayesha/date.rpy:963
translate russian ayesha_date_play_arcade_lose_male_b317c132:
    ayesha.say "Ты в этом настолько же плох, как был бы в реальной жизни!"

# ch/ayesha/date.rpy:964
translate russian ayesha_date_play_arcade_lose_male_f4bf2d4b:
    ayesha.say "Мне действительно стоит положить конец твоим страданиям..."

# ch/ayesha/date.rpy:965
translate russian ayesha_date_play_arcade_lose_male_4cf775c5:
    mike.say "Что?"

# ch/ayesha/date.rpy:966
translate russian ayesha_date_play_arcade_lose_male_c3aaddaa:
    mike.say "НЕТ...НЕТ...НЕТ, НЕТ, НЕТ!"

# ch/ayesha/date.rpy:967
translate russian ayesha_date_play_arcade_lose_male_7f828dfc:
    "Я смотрю, как виртуальный борец Аиши нокаутирует моего."

# ch/ayesha/date.rpy:968
translate russian ayesha_date_play_arcade_lose_male_f8b1292c:
    "И вот судья отсчитывает удержание: один, два, три."

# ch/ayesha/date.rpy:969
translate russian ayesha_date_play_arcade_lose_male_a9586e38:
    ayesha.say "Извини, [lssb_ayesha.hero_name()]."

# ch/ayesha/date.rpy:970
translate russian ayesha_date_play_arcade_lose_male_22c57739:
    ayesha.say "Никаких обид, хорошо?"

# ch/ayesha/date.rpy:971
translate russian ayesha_date_play_arcade_lose_male_dd6f2fa2:
    mike.say "Говори сама за себя, Аиша."

# ch/ayesha/date.rpy:972
translate russian ayesha_date_play_arcade_lose_male_9d9524eb:
    mike.say "Думаю, ты только что похоронила мою любовь к видеоиграм!"

# ch/ayesha/date.rpy:973
translate russian ayesha_date_play_arcade_lose_male_a70a97db:
    mike.say "По крайней мере, на некоторое время..."

# ch/ayesha/date.rpy:981
translate russian ayesha_dick_reactions_1b59615c:
    ayesha.say "Ох... ох, Боже мой!"

# ch/ayesha/date.rpy:982
translate russian ayesha_dick_reactions_49b44310:
    mike.say "Что случилось, Аиша?"

# ch/ayesha/date.rpy:984
translate russian ayesha_dick_reactions_d275c9b5:
    ayesha.say "Ничего... ничего..."

# ch/ayesha/date.rpy:985
translate russian ayesha_dick_reactions_78a2c749:
    ayesha.say "Просто... это так... огромно!"

# ch/ayesha/date.rpy:989
translate russian ayesha_dick_reactions_1b59615c_1:
    ayesha.say "Ох... ох, Боже мой!"

# ch/ayesha/date.rpy:990
translate russian ayesha_dick_reactions_49b44310_1:
    mike.say "Что случилось, Аиша?"

# ch/ayesha/date.rpy:992
translate russian ayesha_dick_reactions_d275c9b5_1:
    ayesha.say "Ничего... ничего..."

# ch/ayesha/date.rpy:993
translate russian ayesha_dick_reactions_b084e4d6:
    ayesha.say "Может быть, тебе хочется обняться?"

# ch/ayesha/date.rpy:1000
translate russian ayesha_halloween_invitation_d2a0edda:
    "Едва мы договорились о вечеринке на Хэллоуин, я сразу понял, кого хочу пригласить."

# ch/ayesha/date.rpy:1001
translate russian ayesha_halloween_invitation_7ce84f86:
    "Мы так здорово проводим время вместе, что Аиша – это единственный вариант."

# ch/ayesha/date.rpy:1002
translate russian ayesha_halloween_invitation_8f495769:
    "И к тому моменту, когда я решусь ее пригласить, я уже представляю себе вечер с ней."

# ch/ayesha/date.rpy:1003
translate russian ayesha_halloween_invitation_f49c2c79:
    "Так что теперь мне нужно просто отправить приглашение."

# ch/ayesha/date.rpy:1004
translate russian ayesha_halloween_invitation_33cb73bb:
    "Ну, и чтобы она согласилась!"

# ch/ayesha/date.rpy:1006
translate russian ayesha_halloween_invitation_74e8d35d:
    mike.say "Аиша..."

# ch/ayesha/date.rpy:1007
translate russian ayesha_halloween_invitation_d3735ff2:
    mike.say "Я просто подумал..."

# ch/ayesha/date.rpy:1009
translate russian ayesha_halloween_invitation_07abe5b3:
    "Аиша оглядывается, услышав мой голос."

# ch/ayesha/date.rpy:1010
translate russian ayesha_halloween_invitation_376516a5:
    "Её рот изогнулся в лукавой улыбке."

# ch/ayesha/date.rpy:1011
translate russian ayesha_halloween_invitation_7e4dfd0c:
    "А в её глазах читается заинтересованность и лёгкое amusement."

# ch/ayesha/date.rpy:1012
translate russian ayesha_halloween_invitation_8a6f3726:
    ayesha.say "Я знаю этот тон, [lssb_ayesha.hero_name()]!"

# ch/ayesha/date.rpy:1013
translate russian ayesha_halloween_invitation_7d851766:
    ayesha.say "Чего ты хочешь на этот раз, а?"

# ch/ayesha/date.rpy:1014
translate russian ayesha_halloween_invitation_f936b42a:
    mike.say "Что... что ты имеешь в виду?"

# ch/ayesha/date.rpy:1015
translate russian ayesha_halloween_invitation_e8e83882:
    ayesha.say "Ты всегда так говоришь, когда тебе что-то нужно."

# ch/ayesha/date.rpy:1016
translate russian ayesha_halloween_invitation_e2876023:
    ayesha.say "И ты всегда начинаешь оправдываться, вот точно так же!"

# ch/ayesha/date.rpy:1017
translate russian ayesha_halloween_invitation_f80e6b95:
    mike.say "Хорошо, Айша, хорошо."

# ch/ayesha/date.rpy:1018
translate russian ayesha_halloween_invitation_7ff24b5e:
    mike.say "Ты меня поймала."

# ch/ayesha/date.rpy:1019
translate russian ayesha_halloween_invitation_00b3c50b:
    "Айша кивает, наслаждаясь моим признанием вины."

# ch/ayesha/date.rpy:1021
translate russian ayesha_halloween_invitation_180e5c84:
    ayesha.say "Так что давай, выкладывай!"

# ch/ayesha/date.rpy:1022
translate russian ayesha_halloween_invitation_1c0d45e8:
    mike.say "Ну..."

# ch/ayesha/date.rpy:1023
translate russian ayesha_halloween_invitation_6ba87b0d:
    mike.say "У нас дома будет вечеринка на Хэллоуин."

# ch/ayesha/date.rpy:1024
translate russian ayesha_halloween_invitation_c21fd580:
    mike.say "И я хотел спросить, не согласишься ли ты быть моей спутницей?"

# ch/ayesha/date.rpy:1025
translate russian ayesha_halloween_invitation_2dcc1d8e:
    mike.say "Там ещё и костюмы будут."

# ch/ayesha/date.rpy:1026
translate russian ayesha_halloween_invitation_e11edcdc:
    mike.say "Так что можешь нарядиться, как ты это делаешь на ринге!"

# ch/ayesha/date.rpy:1029
translate russian ayesha_halloween_invitation_11e83608:
    "Айша хмурится и качает головой."

# ch/ayesha/date.rpy:1030
translate russian ayesha_halloween_invitation_e69e047d:
    ayesha.say "Это совсем не похоже на то, что я делаю на ринге."

# ch/ayesha/date.rpy:1031
translate russian ayesha_halloween_invitation_9860134f:
    ayesha.say "Это просто для развлечения, вот и все."

# ch/ayesha/date.rpy:1032
translate russian ayesha_halloween_invitation_60520bab:
    ayesha.say "Но у меня есть костюм, который я давно хотела надеть..."

# ch/ayesha/date.rpy:1033
translate russian ayesha_halloween_invitation_c864ef29:
    "Я чувствую возможность повлиять на Аишу и решаю воспользоваться ею."

# ch/ayesha/date.rpy:1034
translate russian ayesha_halloween_invitation_9e594538:
    mike.say "Ну тогда это идеальная возможность!"

# ch/ayesha/date.rpy:1035
translate russian ayesha_halloween_invitation_229eb5b2:
    mike.say "У меня дома будет твоя преданная публика."

# ch/ayesha/date.rpy:1037
translate russian ayesha_halloween_invitation_3f7b46ca:
    "Я вижу, что Аиша начинает проявлять интерес к этой идее."

# ch/ayesha/date.rpy:1038
translate russian ayesha_halloween_invitation_507ed656:
    "И с каждой секундой ее улыбка становится шире."

# ch/ayesha/date.rpy:1040
translate russian ayesha_halloween_invitation_de451203:
    ayesha.say "Ладно, [lssb_ayesha.hero_name()], ты победил."

# ch/ayesha/date.rpy:1041
translate russian ayesha_halloween_invitation_2593b8da:
    ayesha.say "Но только потому, что у меня не было других планов."

# ch/ayesha/date.rpy:1042
translate russian ayesha_halloween_invitation_b291cf5d:
    "Я вижу по блеску в глазах Аиши, что она врет."

# ch/ayesha/date.rpy:1043
translate russian ayesha_halloween_invitation_ed39c860:
    "Но если позволить ей сохранить лицо, и это поможет мне добиться своего, то пусть будет так."

# ch/ayesha/date.rpy:1044
translate russian ayesha_halloween_invitation_144b1a61:
    mike.say "Ну, мне повезло, что я первым предложил."

# ch/ayesha/date.rpy:1045
translate russian ayesha_halloween_invitation_f9e0c982:
    mike.say "Надеюсь, мне тоже повезет вечером!"

# ch/ayesha/date.rpy:1047
translate russian ayesha_halloween_invitation_5e05302e:
    ayesha.say "Это еще предстоит узнать!"

# ch/ayesha/date.rpy:1051
translate russian ayesha_halloween_invitation_11e83608_1:
    "Айша хмурится и качает головой."

# ch/ayesha/date.rpy:1052
translate russian ayesha_halloween_invitation_47fb3e8d:
    "Затем она скрещивает руки на груди."

# ch/ayesha/date.rpy:1053
translate russian ayesha_halloween_invitation_b5d75da2:
    "Ничто из этого нельзя назвать хорошим знаком."

# ch/ayesha/date.rpy:1054
translate russian ayesha_halloween_invitation_ba086b9e:
    ayesha.say "Что?!"

# ch/ayesha/date.rpy:1055
translate russian ayesha_halloween_invitation_5af76777:
    ayesha.say "Профессиональная борьба – это совсем не похоже на костюмированную вечеринку!"

# ch/ayesha/date.rpy:1056
translate russian ayesha_halloween_invitation_37066ba6:
    mike.say "Я не понимаю, Аиша."

# ch/ayesha/date.rpy:1057
translate russian ayesha_halloween_invitation_6dc843cb:
    mike.say "Ты надеваешь безумные наряды."

# ch/ayesha/date.rpy:1058
translate russian ayesha_halloween_invitation_5d3d6eab:
    mike.say "Ты притворяешься кем-то другим."

# ch/ayesha/date.rpy:1059
translate russian ayesha_halloween_invitation_a6346800:
    mike.say "Чем это отличается?"

# ch/ayesha/date.rpy:1062
translate russian ayesha_halloween_invitation_1b65a02a:
    "Аиша издает разочарованный стон."

# ch/ayesha/date.rpy:1063
translate russian ayesha_halloween_invitation_ca3809e2:
    "И я понимаю, что рискую проиграть."

# ch/ayesha/date.rpy:1064
translate russian ayesha_halloween_invitation_5d601daa:
    ayesha.say "То, что я делаю на ринге – это перформанс."

# ch/ayesha/date.rpy:1065
translate russian ayesha_halloween_invitation_415ddccb:
    ayesha.say "Это требует спортивных навыков, многолетних тренировок."

# ch/ayesha/date.rpy:1066
translate russian ayesha_halloween_invitation_97c6df2f:
    ayesha.say "И тебе нужно понимать психологию."

# ch/ayesha/date.rpy:1068
translate russian ayesha_halloween_invitation_a920d9be:
    ayesha.say "Как это похоже на то, чтобы переодеться на Хэллоуин!"

# ch/ayesha/date.rpy:1069
translate russian ayesha_halloween_invitation_5126f18f:
    mike.say "Я... прости, Айша."

# ch/ayesha/date.rpy:1070
translate russian ayesha_halloween_invitation_edca68fc:
    mike.say "Ты права, я сморозил глупость!"

# ch/ayesha/date.rpy:1072
translate russian ayesha_halloween_invitation_12532ee8:
    ayesha.say "Ты прав, [lssb_ayesha.hero_name()], это так."

# ch/ayesha/date.rpy:1073
translate russian ayesha_halloween_invitation_541eb780:
    ayesha.say "Можешь подумать об этом на своей глупой вечеринке."

# ch/ayesha/date.rpy:1074
translate russian ayesha_halloween_invitation_46d2a80a:
    ayesha.say "И у тебя будет время, чтобы это сделать."

# ch/ayesha/date.rpy:1075
translate russian ayesha_halloween_invitation_abba9097:
    ayesha.say "Потому что меня там не будет, чтобы отвлекать тебя!"

# ch/ayesha/date.rpy:1081
translate russian ayesha_halloween_arrival_26f45182:
    "Я открываю дверь, ожидая увидеть свою девушку."

# ch/ayesha/date.rpy:1083
translate russian ayesha_halloween_arrival_6aed1a12:
    "Но вместо этого я вижу огромную, внушительную фигуру, возвышающуюся надо мной."

# ch/ayesha/date.rpy:1084
translate russian ayesha_halloween_arrival_b7e695fa:
    "Ее тень накрывает меня, и я почти чувствую, как дрожу."

# ch/ayesha/date.rpy:1085
translate russian ayesha_halloween_arrival_99165b87:
    ayesha.say "Встань на колени перед пророком Великого Краккена!"

# ch/ayesha/date.rpy:1086
translate russian ayesha_halloween_arrival_cae6c87d:
    "Прежде чем я успеваю понять, что делаю, я подчиняюсь приказу."

# ch/ayesha/date.rpy:1087
translate russian ayesha_halloween_arrival_faa44c64:
    "Я встаю на колени в надежде, что мне будет оказано милосердие."

# ch/ayesha/date.rpy:1088
translate russian ayesha_halloween_arrival_4d472861:
    "В этот момент гигант у моего порога наклоняется вперед."

# ch/ayesha/date.rpy:1089
translate russian ayesha_halloween_arrival_b3231f63:
    "И выражение его лица меняется от строгого до обеспокоенного."

# ch/ayesha/date.rpy:1091
translate russian ayesha_halloween_arrival_945fe50e:
    ayesha.say "О, [lssb_ayesha.hero_name()]..."

# ch/ayesha/date.rpy:1092
translate russian ayesha_halloween_arrival_06e3311a:
    ayesha.say "Тебе на самом деле не обязательно это делать!"

# ch/ayesha/date.rpy:1093
translate russian ayesha_halloween_arrival_4adf13d1:
    mike.say "Аиша?"

# ch/ayesha/date.rpy:1094
translate russian ayesha_halloween_arrival_b68a4125:
    mike.say "О... моя... богиня!"

# ch/ayesha/date.rpy:1095
translate russian ayesha_halloween_arrival_81a07964:
    mike.say "Это ты?!"

# ch/ayesha/date.rpy:1096
translate russian ayesha_halloween_arrival_d6511585:
    "Она смотрит на меня сверху вниз, с огромной иконой, прикрепленной к ее плечу."

# ch/ayesha/date.rpy:1097
translate russian ayesha_halloween_arrival_24d5f580:
    "Костюм попал в точку: она выглядит совсем как жрица из игры."

# ch/ayesha/date.rpy:1099
translate russian ayesha_halloween_arrival_04539fbf:
    "Вдруг Аиша немного смущается."

# ch/ayesha/date.rpy:1100
translate russian ayesha_halloween_arrival_f2b4bd21:
    "Она оглядывается по сторонам, словно хочет зайти внутрь."

# ch/ayesha/date.rpy:1101
translate russian ayesha_halloween_arrival_3d4eda98:
    ayesha.say "Я... я почти не хотела наряжаться жрицей-кальмаром."

# ch/ayesha/date.rpy:1102
translate russian ayesha_halloween_arrival_e873b993:
    ayesha.say "Но это мой любимый персонаж в игре!"

# ch/ayesha/date.rpy:1103
translate russian ayesha_halloween_arrival_d3359d72:
    ayesha.say "А теперь я начинаю сомневаться, правильно ли выбрала..."

# ch/ayesha/date.rpy:1106
translate russian ayesha_halloween_arrival_caee2828:
    "Я не могу достаточно быстро покачать головой."

# ch/ayesha/date.rpy:1107
translate russian ayesha_halloween_arrival_a9e97789:
    "И я встаю на ноги, делая это."

# ch/ayesha/date.rpy:1108
translate russian ayesha_halloween_arrival_167a24cc:
    mike.say "Кому какое дело, что думают другие, Аиша?"

# ch/ayesha/date.rpy:1109
translate russian ayesha_halloween_arrival_1074fd52:
    mike.say "Ты моя спутница сегодня вечером."

# ch/ayesha/date.rpy:1110
translate russian ayesha_halloween_arrival_1900d0e6:
    mike.say "И я думаю, ты выглядишь божественно!"

# ch/ayesha/date.rpy:1111
translate russian ayesha_halloween_arrival_dbb57bad:
    mike.say "Если позволите мне игру слов..."

# ch/ayesha/date.rpy:1114
translate russian ayesha_halloween_arrival_f10e5545:
    "Аиша не может удержаться от покраснения, когда я восхищаюсь ею."

# ch/ayesha/date.rpy:1115
translate russian ayesha_halloween_arrival_bae6b68a:
    "Она оглядывается по сторонам, проверяя, одни ли мы."

# ch/ayesha/date.rpy:1116
translate russian ayesha_halloween_arrival_b7e6fe0d:
    ayesha.say "Прекрати, [lssb_ayesha.hero_name()]!"

# ch/ayesha/date.rpy:1117
translate russian ayesha_halloween_arrival_40953d13:
    ayesha.say "На самом деле, не прекращай!"

# ch/ayesha/date.rpy:1118
translate russian ayesha_halloween_arrival_93372a15:
    ayesha.say "Тебе действительно нравится мой костюм?"

# ch/ayesha/date.rpy:1119
translate russian ayesha_halloween_arrival_e4047bad:
    "Я с энтузиазмом киваю."

# ch/ayesha/date.rpy:1120
translate russian ayesha_halloween_arrival_7948b09c:
    mike.say "Конечно, мне он нравится, Аиша."

# ch/ayesha/date.rpy:1121
translate russian ayesha_halloween_arrival_cf70dc9b:
    mike.say "Ты сделала её моим любимым персонажем!"

# ch/ayesha/date.rpy:1123
translate russian ayesha_halloween_arrival_ef70fd43:
    "Ну что она вообще ожидала?"

# ch/ayesha/date.rpy:1124
translate russian ayesha_halloween_arrival_445e7635:
    "Аиша сама по себе практически гигантский персонаж."

# ch/ayesha/date.rpy:1125
translate russian ayesha_halloween_arrival_9358e1ce:
    "И переодевание в роль \"Жрицы-кальмара\" только добавляет ей величия."

# ch/ayesha/date.rpy:1126
translate russian ayesha_halloween_arrival_78237b17:
    mike.say "Тебе стоило лучше подумать, Аиша."

# ch/ayesha/date.rpy:1127
translate russian ayesha_halloween_arrival_4f93336d:
    mike.say "Теперь тебе придётся всю ночь быть в центре внимания!"

# ch/ayesha/date.rpy:1130
translate russian ayesha_halloween_arrival_42932e4b:
    "Судя по моему ответу, Аиша чувствует себя немного обиженной."

# ch/ayesha/date.rpy:1131
translate russian ayesha_halloween_arrival_89789bcf:
    "Она хмурится и смотрит на свои ноги."

# ch/ayesha/date.rpy:1132
translate russian ayesha_halloween_arrival_42b41dfb:
    ayesha.say "Тебе не стоило так прямо говорить, [lssb_ayesha.hero_name()]."

# ch/ayesha/date.rpy:1133
translate russian ayesha_halloween_arrival_b84d23ca:
    ayesha.say "Мог бы хоть немного пощадить мои чувства?"

# ch/ayesha/date.rpy:1134
translate russian ayesha_halloween_arrival_e50d5932:
    "Я отмахиваюсь и качаю головой."

# ch/ayesha/date.rpy:1135
translate russian ayesha_halloween_arrival_8b1a8946:
    "У меня сегодня совершенно нет времени на это."

# ch/ayesha/date.rpy:1136
translate russian ayesha_halloween_arrival_23108aed:
    "Последнее, что мне нужно, чтобы Аиша начала давить на меня чувством вины."

# ch/ayesha/date.rpy:1137
translate russian ayesha_halloween_arrival_ad0e33b6:
    mike.say "Что я могу сказать тебе, Аиша?"

# ch/ayesha/date.rpy:1138
translate russian ayesha_halloween_arrival_a8567a8b:
    mike.say "Я современный парень, говорю как есть!"

# ch/ayesha/date.rpy:1140
translate russian ayesha_halloween_arrival_6cf3c73b:
    "Аиша хмурится и поджимает губу."

# ch/ayesha/date.rpy:1141
translate russian ayesha_halloween_arrival_7af7cfab:
    "Но она все равно заходит в дом."

# ch/ayesha/date.rpy:1142
translate russian ayesha_halloween_arrival_7aefc8fd:
    "Хотя, думаю, мне стоит быть с ней вежливым отныне."

# ch/ayesha/date.rpy:1143
translate russian ayesha_halloween_arrival_a9bde9d3:
    "В конце концов, я не хочу, чтобы на меня обрушилась ее праведный гнев!"

# ch/ayesha/date.rpy:1152
translate russian ayesha_halloween_party_8cbb83b8:
    ayesha.say "Уходи, мерзкая язычница!"

# ch/ayesha/date.rpy:1153
translate russian ayesha_halloween_party_68c997e2:
    ayesha.say "Я говорю – уходи!"

# ch/ayesha/date.rpy:1154
translate russian ayesha_halloween_party_8ae424f6:
    ayesha.say "Если мне что-то нравится, я это беру, если я что-то ненавижу, я это ломаю."

# ch/ayesha/date.rpy:1155
translate russian ayesha_halloween_party_3359c7b9:
    ayesha.say "Во имя Великого Краккена, я караю тебя!"

# ch/ayesha/date.rpy:1156
translate russian ayesha_halloween_party_ac210aac:
    "Я сразу узнаю голос Аиши, как только слышу его."

# ch/ayesha/date.rpy:1157
translate russian ayesha_halloween_party_04060af2:
    "Сначала я думаю, что она просто играет свою роль, соответствуя своему костюму."

# ch/ayesha/date.rpy:1160
translate russian ayesha_halloween_party_cfad11d2:
    "Но потом я вижу, что она держит перед собой огромную икону, которую обычно носит с собой."

# ch/ayesha/date.rpy:1161
translate russian ayesha_halloween_party_494b75b6:
    "И еще тот факт, что Джек, похоже, прячется от нее!"

# ch/ayesha/date.rpy:1162
translate russian ayesha_halloween_party_685a28da:
    jack.say "Попал! Попал от жрицы-кальмара!"

# ch/ayesha/date.rpy:1163
translate russian ayesha_halloween_party_6c1cc8c2:
    jack.say "Вау, вот это смерть!"

# ch/ayesha/date.rpy:1164
translate russian ayesha_halloween_party_8a4f6159:
    jack.say "Я хочу, чтобы это было написано на моей могиле!"

# ch/ayesha/date.rpy:1165
translate russian ayesha_halloween_party_a22d933a:
    "Я спешу туда как можно быстрее."

# ch/ayesha/date.rpy:1166
translate russian ayesha_halloween_party_9986521d:
    "Решительно встаю между Джеком и огромным оружием Аиши."

# ch/ayesha/date.rpy:1169
translate russian ayesha_halloween_party_4d9b4710:
    mike.say "Стоп, стоп..."

# ch/ayesha/date.rpy:1170
translate russian ayesha_halloween_party_e5f718e7:
    mike.say "Что здесь происходит, Аиша?!"

# ch/ayesha/date.rpy:1171
translate russian ayesha_halloween_party_53eda2a0:
    mike.say "Что он с тобой сделал?"

# ch/ayesha/date.rpy:1173
translate russian ayesha_halloween_party_1d6d1b23:
    "Аиша опускает тяжелый предмет."

# ch/ayesha/date.rpy:1174
translate russian ayesha_halloween_party_f82992f7:
    "Но она все равно следит за Джеком одним глазом."

# ch/ayesha/date.rpy:1175
translate russian ayesha_halloween_party_7216d8c9:
    ayesha.say "Этот мелкий засранец схватил меня за задницу!"

# ch/ayesha/date.rpy:1177
translate russian ayesha_halloween_party_ecec703f:
    jack.say "Это был всего лишь легкий щипок."

# ch/ayesha/date.rpy:1178
translate russian ayesha_halloween_party_8b34e4e4:
    jack.say "Ничего не мог с собой поделать, меня загипнотизировали!"

# ch/ayesha/date.rpy:1179
translate russian ayesha_halloween_party_9ea3d6e0:
    "Я поворачиваюсь лицом к Джеку, нахмурившись из-за его оправданий."

# ch/ayesha/date.rpy:1180
translate russian ayesha_halloween_party_e5e7dd00:
    mike.say "Тебе повезло, что она не выбила тебе мозги!"

# ch/ayesha/date.rpy:1181
translate russian ayesha_halloween_party_f58338ab:
    mike.say "Аиша здесь может связать тебя узлом без особых усилий."

# ch/ayesha/date.rpy:1182
translate russian ayesha_halloween_party_d38e742f:
    "Этот последний комментарий был предназначен для того, чтобы напугать Джека."

# ch/ayesha/date.rpy:1184
translate russian ayesha_halloween_party_841210f3:
    "Но вместо этого я вижу, как загораются его глаза от этой перспективы."

# ch/ayesha/date.rpy:1185
translate russian ayesha_halloween_party_8ed0f8c5:
    jack.say "Она может пробовать это со мной в любое время!"

# ch/ayesha/date.rpy:1186
translate russian ayesha_halloween_party_39d05b61:
    "Не подумав, я хватаю значок из рук Айши."

# ch/ayesha/date.rpy:1188
translate russian ayesha_halloween_party_11ff9e3c:
    "А затем я использую его, чтобы самому угрожать Джеку."

# ch/ayesha/date.rpy:1189
translate russian ayesha_halloween_party_bad3bef1:
    "Он издает короткий крик и убегает."

# ch/ayesha/date.rpy:1193
translate russian ayesha_halloween_party_927b0505:
    "В результате остаются только Айша и я."

# ch/ayesha/date.rpy:1194
translate russian ayesha_halloween_party_36dadadf:
    ayesha.say "Ты бы действительно на него ударил?"

# ch/ayesha/date.rpy:1195
translate russian ayesha_halloween_party_61282b48:
    mike.say "Я могу задать тебе тот же вопрос, Айша!"

# ch/ayesha/date.rpy:1199
translate russian ayesha_halloween_party_1635bb6e:
    "Айша смеется и качает головой."

# ch/ayesha/date.rpy:1200
translate russian ayesha_halloween_party_8257b0d1:
    "Она наклоняется, чтобы забрать значок обратно, и шепчет мне на ухо."

# ch/ayesha/date.rpy:1201
translate russian ayesha_halloween_party_8416da56:
    ayesha.say "Ты можешь трогать мою задницу сколько угодно, [lssb_ayesha.hero_name()]."

# ch/ayesha/date.rpy:1202
translate russian ayesha_halloween_party_c2197c7e:
    ayesha.say "И я обещаю, тебе тоже понравится, когда я свяжу тебя."

# ch/ayesha/date.rpy:1204
translate russian ayesha_halloween_party_4d9b4710_1:
    mike.say "Стоп, стоп..."

# ch/ayesha/date.rpy:1205
translate russian ayesha_halloween_party_e5f718e7_1:
    mike.say "Что здесь происходит, Аиша?!"

# ch/ayesha/date.rpy:1206
translate russian ayesha_halloween_party_129ad85d:
    mike.say "Ты же не собираешься использовать эту штуку на нем, правда?"

# ch/ayesha/date.rpy:1208
translate russian ayesha_halloween_party_b5efcc83:
    "Айша сердито смотрит на меня, очевидно, она все еще злится."

# ch/ayesha/date.rpy:1209
translate russian ayesha_halloween_party_bc48340b:
    "Но она всё же опускает этот грубый предмет."

# ch/ayesha/date.rpy:1210
translate russian ayesha_halloween_party_938818b8:
    ayesha.say "– Я должна была прибить его этим!\""

# ch/ayesha/date.rpy:1211
translate russian ayesha_halloween_party_7216d8c9_1:
    ayesha.say "Этот мелкий засранец схватил меня за задницу!"

# ch/ayesha/date.rpy:1213
translate russian ayesha_halloween_party_ecec703f_1:
    jack.say "Это был всего лишь легкий щипок."

# ch/ayesha/date.rpy:1214
translate russian ayesha_halloween_party_8b34e4e4_1:
    jack.say "Ничего не мог с собой поделать, меня загипнотизировали!"

# ch/ayesha/date.rpy:1215
translate russian ayesha_halloween_party_1a61176b:
    mike.say "– Ты могла просто сказать мне, Айша."

# ch/ayesha/date.rpy:1216
translate russian ayesha_halloween_party_409db758:
    mike.say "– Я бы позаботился о том, чтобы это больше не повторилось."

# ch/ayesha/date.rpy:1222
translate russian ayesha_halloween_party_90bc4162:
    "Джек использует возможность, чтобы незаметно уйти, пока я разговариваю с Айшей."

# ch/ayesha/date.rpy:1223
translate russian ayesha_halloween_party_af29d41d:
    "И она, кажется, даже не замечает, как он уходит."

# ch/ayesha/date.rpy:1224
translate russian ayesha_halloween_party_f98690c7:
    "Она слишком занята тем, что выглядит смущенной и немного стыдится себя."

# ch/ayesha/date.rpy:1225
translate russian ayesha_halloween_party_4003202f:
    ayesha.say "– Я... я извиняюсь, [lssb_ayesha.hero_name()]."

# ch/ayesha/date.rpy:1226
translate russian ayesha_halloween_party_3be893a0:
    ayesha.say "– Я не подумала!"

# ch/ayesha/date.rpy:1227
translate russian ayesha_halloween_party_1be27869:
    mike.say "– Ну, постарайся так делать в следующий раз, хорошо?"

# ch/ayesha/date.rpy:1237
translate russian ayesha_halloween_dance_ed380cb0:
    "Всю ночь Айша смотрит на танцпол."

# ch/ayesha/date.rpy:1238
translate russian ayesha_halloween_dance_c25f122f:
    "Она постоянно поглядывает то на него, то на меня."

# ch/ayesha/date.rpy:1239
translate russian ayesha_halloween_dance_fbd85885:
    "Но каждый раз, когда я замечаю, что она это делает, она снова отворачивается."

# ch/ayesha/date.rpy:1240
translate russian ayesha_halloween_dance_868422fb:
    "И когда она так делает, на ее лице читается вина."

# ch/ayesha/date.rpy:1241
translate russian ayesha_halloween_dance_aabb2f98:
    "Сначала я не могу понять, что с ней происходит."

# ch/ayesha/date.rpy:1242
translate russian ayesha_halloween_dance_4beceea5:
    "Но потом меня осенило."

# ch/ayesha/date.rpy:1243
translate russian ayesha_halloween_dance_14bedcb3:
    "Аyesha, должно быть, ждет, пока я приглашу её потанцевать!"

# ch/ayesha/date.rpy:1244
translate russian ayesha_halloween_dance_e25f3437:
    "Очевидно, ей слишком стеснительно самой сделать первый шаг."

# ch/ayesha/date.rpy:1245
translate russian ayesha_halloween_dance_8072b9aa:
    mike.say "Эй, Аyesha..."

# ch/ayesha/date.rpy:1246
translate russian ayesha_halloween_dance_9fc8d5a4:
    mike.say "Ты хочешь потанцевать со мной?"

# ch/ayesha/date.rpy:1248
translate russian ayesha_halloween_dance_7669ba1d:
    "Я ожидал, что выражение лица Айши изменится."

# ch/ayesha/date.rpy:1249
translate russian ayesha_halloween_dance_9ebf8ec0:
    "Но теперь она выглядит еще более нервной, чем раньше!"

# ch/ayesha/date.rpy:1250
translate russian ayesha_halloween_dance_15c47699:
    ayesha.say "Я... я не знаю..."

# ch/ayesha/date.rpy:1251
translate russian ayesha_halloween_dance_3378278a:
    ayesha.say "Думаю, можем, если тебе этого хочется?"

# ch/ayesha/date.rpy:1254
translate russian ayesha_halloween_dance_283a2158:
    "Я немного хмурюсь, смущенный нерешительностью Айши."

# ch/ayesha/date.rpy:1255
translate russian ayesha_halloween_dance_e9117111:
    "Но потом я пожимаю плечами и улыбаюсь ей."

# ch/ayesha/date.rpy:1256
translate russian ayesha_halloween_dance_7b6e0779:
    mike.say "Да, Айша, мне этого хочется."

# ch/ayesha/date.rpy:1257
translate russian ayesha_halloween_dance_23448c2c:
    mike.say "Тогда пойдем танцевать!"

# ch/ayesha/date.rpy:1260
translate russian ayesha_halloween_dance_087dcc1d:
    "Айша не оказывает никакого сопротивления, когда я провожу ее на танцпол."

# ch/ayesha/date.rpy:1261
translate russian ayesha_halloween_dance_b4c50055:
    "Но она выглядит взволнованной все время, постоянно оглядываясь по сторонам."

# ch/ayesha/date.rpy:1262
translate russian ayesha_halloween_dance_917dc5e2:
    "Я стараюсь изо всех сил привлечь ее внимание к себе."

# ch/ayesha/date.rpy:1264
translate russian ayesha_halloween_dance_6487d3c5:
    "И тем не менее, кажется, что это ни на что не влияет."

# ch/ayesha/date.rpy:1265
translate russian ayesha_halloween_dance_54030d7c:
    "Айша остается скованной и неуклюжей на протяжении всего времени."

# ch/ayesha/date.rpy:1267
translate russian ayesha_halloween_dance_e893fd39:
    "Затем она сбегает сразу после того, как заканчивается песня."

# ch/ayesha/date.rpy:1268
translate russian ayesha_halloween_dance_30a8e03b:
    "Я следую за ней, гадая, не совершил ли я ошибку."

# ch/ayesha/date.rpy:1270
translate russian ayesha_halloween_dance_283a2158_1:
    "Я немного хмурюсь, смущенный нерешительностью Айши."

# ch/ayesha/date.rpy:1271
translate russian ayesha_halloween_dance_912dac83:
    "Но потом я качаю головой и улыбаюсь ей."

# ch/ayesha/date.rpy:1272
translate russian ayesha_halloween_dance_e688c43a:
    mike.say "\"Если тебе это не нравится, Айша\"."

# ch/ayesha/date.rpy:1273
translate russian ayesha_halloween_dance_4898dbfc:
    mike.say "И я думаю, что тебе это не нравится, да?"

# ch/ayesha/date.rpy:1275
translate russian ayesha_halloween_dance_3f823ad8:
    "Только сейчас выражение лица Айши меняется."

# ch/ayesha/date.rpy:1276
translate russian ayesha_halloween_dance_a039d34d:
    "Она внезапно выглядит облегченной."

# ch/ayesha/date.rpy:1277
translate russian ayesha_halloween_dance_75835ae4:
    "Как будто с нее сняли тяжелый груз."

# ch/ayesha/date.rpy:1278
translate russian ayesha_halloween_dance_4aa18bf0:
    ayesha.say "\"Я всегда чувствую себя неловко, когда танцую\"."

# ch/ayesha/date.rpy:1279
translate russian ayesha_halloween_dance_041e9b2d:
    ayesha.say "И то, что я так наряжена, только усугубляет это!"

# ch/ayesha/date.rpy:1280
translate russian ayesha_halloween_dance_0209db7d:
    mike.say "Ничего страшного, Айша."

# ch/ayesha/date.rpy:1281
translate russian ayesha_halloween_dance_2ed2e13d:
    mike.say "Давай просто закажем еще по одному напитку."

# ch/ayesha/date.rpy:1283
translate russian ayesha_halloween_dance_c1623f81:
    "Айша кивает и улыбается."

# ch/ayesha/date.rpy:1284
translate russian ayesha_halloween_dance_11ff8a93:
    "И я чувствую, что принял правильное решение."

# ch/ayesha/date.rpy:1293
translate russian ayesha_halloween_sex_02d08558:
    "Всю ночь мне было трудно сосредоточиться на чем-либо, кроме как на Айше."

# ch/ayesha/date.rpy:1294
translate russian ayesha_halloween_sex_7f1fdb2e:
    "Она выглядит настолько чертовски хорошо в этом костюме, я не могу удержаться."

# ch/ayesha/date.rpy:1295
translate russian ayesha_halloween_sex_094622c5:
    "Сначала я думал, что она может расстроиться из-за того, что я постоянно на нее смотрю."

# ch/ayesha/date.rpy:1296
translate russian ayesha_halloween_sex_dedf1aa2:
    "Но потом я заметил, что она начала улыбаться и подмигивать каждый раз, когда смотрела в мою сторону."

# ch/ayesha/date.rpy:1297
translate russian ayesha_halloween_sex_36e3d852:
    "Я не сразу понял, что она довольно сильно выпила."

# ch/ayesha/date.rpy:1298
translate russian ayesha_halloween_sex_d758a837:
    "И вот, к тому времени, как вечеринка подходит к концу, я общаюсь с довольно пьяной амазонкой!"

# ch/ayesha/date.rpy:1299
translate russian ayesha_halloween_sex_b7b07790:
    ayesha.say "Иди сюда, мелкий человечек!"

