# ch/ayesha/chat.rpy:21
translate russian ayesha_desire_1_male_9f1f07cf:
    mike.say "Не знаю, Айша."

# ch/ayesha/chat.rpy:22
translate russian ayesha_desire_1_male_ad87b212:
