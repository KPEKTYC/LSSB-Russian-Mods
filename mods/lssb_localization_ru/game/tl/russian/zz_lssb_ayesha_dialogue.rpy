# ch/ayesha/date.rpy:728
translate russian ayesha_date_nightclub_male_12582f4c:
    mike.say "Кажется, там только что освободилось немного места, Айша."

# ch/ayesha/date.rpy:729
translate russian ayesha_date_nightclub_male_fa470c3d:
