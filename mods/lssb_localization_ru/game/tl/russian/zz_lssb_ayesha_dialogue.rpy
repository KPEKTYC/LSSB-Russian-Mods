# ch/ayesha/date.rpy:782
translate russian ayesha_date_nightclub_male_cf430905:
    "Ладно, во-первых, я не хочу, чтобы кто-нибудь испортил Айше вечер."

# ch/ayesha/date.rpy:783
translate russian ayesha_date_nightclub_male_ff4d6c39:
