# ch/ayesha/chat.rpy:116
translate russian ayesha_love_2_male_939129b2:
    ayesha.say "Эти занятия в спортзале действительно приносят свои плоды!"

# ch/ayesha/chat.rpy:118
translate russian ayesha_love_2_male_4466da4b:
