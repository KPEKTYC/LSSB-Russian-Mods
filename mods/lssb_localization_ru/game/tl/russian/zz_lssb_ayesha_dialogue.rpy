# ch/ayesha/chat.rpy:109
translate russian ayesha_love_1_male_dab1aa0a:
    ayesha.say "Что, прости?!"

# ch/ayesha/chat.rpy:110
translate russian ayesha_love_1_male_a0eee8bb:
    ayesha.say "Следи за языком, [lssb_ayesha.hero_name()], пока я снова не уложила тебя на мат, где тебе и место."

# ch/ayesha/chat.rpy:115
translate russian ayesha_love_2_male_b0236bd6:
