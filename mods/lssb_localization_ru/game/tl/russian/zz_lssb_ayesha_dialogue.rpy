# ch/ayesha/chat.rpy:90
translate russian ayesha_love_0_male_09f15ca0:
    ayesha.say "Ты... ты правда хочешь это выслушать?"

# ch/ayesha/chat.rpy:91
translate russian ayesha_love_0_male_9df6e9a7:
    ayesha.say "Никто никогда не предлагает. Ладно. Позволю тебе отвлечь меня, как захочешь."

# ch/ayesha/chat.rpy:94
translate russian ayesha_love_0_male_65743ab3:
    mike.say "Скучно!"

# ch/ayesha/chat.rpy:95
translate russian ayesha_love_0_male_6823eb4f:
    mike.say "Это последнее, о чем я хочу слышать!"

# ch/ayesha/chat.rpy:100
translate russian ayesha_love_1_male_b3970fd1:
    ayesha.say "Эй, [lssb_ayesha.hero_name()]."

# ch/ayesha/chat.rpy:101
translate russian ayesha_love_1_male_6140990a:
    ayesha.say "Как ты себя чувствуешь сегодня?"

# ch/ayesha/chat.rpy:103
translate russian ayesha_love_1_male_6cf7f756:
    mike.say "Я чувствовал себя довольно плохо, Аиша."

# ch/ayesha/chat.rpy:104
translate russian ayesha_love_1_male_fc64d959:
    mike.say "Но, увидев тебя, мне сразу стало лучше."

# ch/ayesha/chat.rpy:107
translate russian ayesha_love_1_male_53d968e5:
