# ch/ayesha/date.rpy:755
translate russian ayesha_date_nightclub_male_eaa68d10:
    "Я начинаю немного освобождать место между Аейшей и мной на танцполе."

# ch/ayesha/date.rpy:756
translate russian ayesha_date_nightclub_male_3f3c6a1b:
