# ch/ayesha/date.rpy:685
translate russian ayesha_date_nightclub_male_e5cdcd89:
    "Мне пришлось приложить немало усилий, чтобы убедить Айшу в том, что нам стоит пойти в клуб на нашем очередном свидании."

# ch/ayesha/date.rpy:686
translate russian ayesha_date_nightclub_male_bad711e6:
