# ch/ayesha/date.rpy:707
translate russian ayesha_date_nightclub_male_f6007886:
    mike.say "Даже «просто ты» — это потрясающе, Айша, поверь!"

# ch/ayesha/date.rpy:709
translate russian ayesha_date_nightclub_male_7c15ccb5:
