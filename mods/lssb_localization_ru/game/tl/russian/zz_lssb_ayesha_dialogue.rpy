# ch/ayesha/chat.rpy:41
translate russian ayesha_desire_2_male_b9c97614:
    ayesha.say "Пф. Кто бы сомневался, что ты так скажешь, хрен моржовый."

# ch/ayesha/chat.rpy:42
translate russian ayesha_desire_2_male_50617b8d:
