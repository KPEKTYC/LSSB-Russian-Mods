# ch/ayesha/chat.rpy:155
translate russian ayesha_love_5_male_45ec49ee:
    ayesha.say "Но... я думаю... кажется, я влюбилась в тебя!"

# ch/ayesha/chat.rpy:157
translate russian ayesha_love_5_male_615b471d:
    mike.say "Боже мой, Айша, правда?!"

# ch/ayesha/chat.rpy:158
translate russian ayesha_love_5_male_7a5c0f09:
    mike.say "Я чувствую к тебе то же самое. То есть я люблю тебя!"

# ch/ayesha/chat.rpy:161
translate russian ayesha_love_5_male_d32a7f5b:
    mike.say "Это понятно, Айша."

# ch/ayesha/chat.rpy:162
translate russian ayesha_love_5_male_aca109be:
    mike.say "Я имею в виду, у тебя не так много опыта с парнями..."

# ch/ayesha/chat.rpy:169
translate russian ayesha_good_sweet_talk_male_4fe43e0f:
    mike.say "Я не знаю, как ты это делаешь, Айша."

# ch/ayesha/chat.rpy:170
translate russian ayesha_good_sweet_talk_male_517c2974:
    mike.say "Ты такая сильная и при этом такая нежная."

# ch/ayesha/chat.rpy:171
translate russian ayesha_good_sweet_talk_male_33ef6149:
    mike.say "И... ну, ты еще очень сексуальна!"

# ch/ayesha/chat.rpy:173
translate russian ayesha_good_sweet_talk_male_8ff879f2:
    ayesha.say "О, мне так нравится, когда ты говоришь обо мне так!"

# ch/ayesha/chat.rpy:175
translate russian ayesha_good_sweet_talk_male_66e6d2ba:
    mike.say "Мне нравится видеть тебя в платье, Айша."

# ch/ayesha/chat.rpy:176
translate russian ayesha_good_sweet_talk_male_e977b2ee:
    mike.say "Ты такая сильная и при этом такая сексуальная!"

# ch/ayesha/chat.rpy:177
translate russian ayesha_good_sweet_talk_male_1aeb858d:
    mike.say "Я такой счастливый парень!"

# ch/ayesha/chat.rpy:179
translate russian ayesha_good_sweet_talk_male_fc49e6fa:
    ayesha.say "Ты действительно это имеешь в виду?"

# ch/ayesha/chat.rpy:180
translate russian ayesha_good_sweet_talk_male_ae124249:
    ayesha.say "Думаю, мне тоже повезло!"

# ch/ayesha/chat.rpy:182
translate russian ayesha_good_sweet_talk_male_b6f1edd5:
    mike.say "Вау, Айша, какая же ты умная!"

# ch/ayesha/chat.rpy:183
translate russian ayesha_good_sweet_talk_male_d657bf1f:
    mike.say "И еще очень смешная!"

# ch/ayesha/chat.rpy:184
translate russian ayesha_good_sweet_talk_male_a03f4c25:
    mike.say "В тебе гораздо больше, чем может показаться на первый взгляд."

# ch/ayesha/chat.rpy:185
translate russian ayesha_good_sweet_talk_male_ddeac088:
    ayesha.say "Ох... ты заставляешь меня покраснеть!"

# ch/ayesha/chat.rpy:191
translate russian ayesha_bad_sweet_talk_male_326a3bc9:
    mike.say "Здорово, что сейчас можно найти сексуальную одежду в твоем размере, Айша!"

# ch/ayesha/chat.rpy:193
translate russian ayesha_bad_sweet_talk_male_9fbcb976:
    ayesha.say "Что ты хочешь сказать?"

# ch/ayesha/chat.rpy:194
translate russian ayesha_bad_sweet_talk_male_bd2d8765:
    ayesha.say "Что я какая-то гигантская уродка?!"

# ch/ayesha/chat.rpy:195
translate russian ayesha_bad_sweet_talk_male_164f6771:
    mike.say "Нет... нет, конечно же, нет, Айша!"

# ch/ayesha/condom.rpy:4
translate russian ayesha_use_condom_b375b8cd:
    "Даже когда я сосредоточен на том, чтобы Айше было комфортно, я все равно не могу забыть об основах."

# ch/ayesha/condom.rpy:5
translate russian ayesha_use_condom_e84ef0ee:
    "Поэтому я делаю паузу и беру презерватив, прежде чем двигаться дальше."

# ch/ayesha/condom.rpy:6
translate russian ayesha_use_condom_44f21274:
    "Сначала Айша кажется сбитой с толку, но она кивает, как только видит, что я собираюсь делать."

# ch/ayesha/condom.rpy:7
translate russian ayesha_use_condom_48c9e6c3:
    "Через несколько секунд все готово."

# ch/ayesha/condom.rpy:9
translate russian ayesha_use_condom_a546a741:
    "В этот момент меня осенило."

# ch/ayesha/condom.rpy:10
translate russian ayesha_use_condom_81c62d67:
    "Я поднимаю руку, чтобы остановить Айшу."

# ch/ayesha/condom.rpy:11
translate russian ayesha_use_condom_ddf4bfad:
    ayesha.say "Что?"

# ch/ayesha/condom.rpy:12
translate russian ayesha_use_condom_24fbaf17:
    ayesha.say "Что случилось, любимый?"

# ch/ayesha/condom.rpy:13
translate russian ayesha_use_condom_92295846:
    mike.say "Защита, Айша!"

# ch/ayesha/condom.rpy:14
translate russian ayesha_use_condom_c05cc951:
    mike.say "Нам действительно нужно использовать презерватив."

# ch/ayesha/condom.rpy:15
translate russian ayesha_use_condom_b2b20b34:
    "Айша выглядит шокированной, как будто она сама должна была об этом вспомнить."

# ch/ayesha/condom.rpy:16
translate russian ayesha_use_condom_683a3a64:
    "Она кивает и ждет, пока я беру презерватив со столика возле кровати."

# ch/ayesha/condom.rpy:17
translate russian ayesha_use_condom_7a243dbf:
    "Айша терпеливо ждет, пока я надеваю его, и затем мы готовы."

# ch/ayesha/condom.rpy:19
translate russian ayesha_use_condom_841e2307:
    "Но сначала самое главное – нельзя забывать об основах!"

# ch/ayesha/condom.rpy:20
translate russian ayesha_use_condom_0e76085e:
    "Я тянусь рукой и успеваю схватить презерватив со столика возле кровати."

# ch/ayesha/condom.rpy:21
translate russian ayesha_use_condom_0571cc08:
    "Айша оглядывается через плечо и кивает в знак одобрения."

# ch/ayesha/condom.rpy:22
translate russian ayesha_use_condom_45185fb9:
    "Ещё всего пара секунд, и мы будем готовы."

# ch/ayesha/condom.rpy:24
translate russian ayesha_use_condom_21113d4d:
    "Но как бы я ни был поглощен этой мыслью, я все равно не могу забыть об основах."

# ch/ayesha/condom.rpy:25
translate russian ayesha_use_condom_960db119:
    "Поэтому я беру презерватив, прежде чем двигаться дальше, заставляя Айшу немного подождать."

# ch/ayesha/condom.rpy:26
translate russian ayesha_use_condom_1d2b360b:
    "Она не издает ни звука протеста, уже понимая, что я собираюсь делать."

# ch/ayesha/condom.rpy:27
translate russian ayesha_use_condom_988ba64c:
    "И мне не нужно много времени, чтобы надеть его и быть готовым."

# ch/ayesha/condom.rpy:29
translate russian ayesha_use_condom_d94a9d8f:
    ayesha.say "М-м, всегда обо мне заботишься. А теперь хватит заставлять даму ждать, [lssb_ayesha.hero_name()]."

# ch/ayesha/condom.rpy:31
translate russian ayesha_use_condom_d65361d1:
    ayesha.say "Вот за это я тебя и держу, [lssb_ayesha.hero_name()]. А теперь иди сюда."

# ch/ayesha/condom.rpy:37
translate russian ayesha_intro_condom_6317dfcc:
    "Мои мысли настолько поглощены желанием сделать Айше комфортно, что я забываю почти обо всем остальном."

# ch/ayesha/condom.rpy:39
translate russian ayesha_intro_condom_314a5aef:
    "Я хочу её пизду, и больше ни о чём не думаю, когда тяну её к себе."

# ch/ayesha/condom.rpy:45
translate russian ayesha_warn_condom_536bc7c8:
    "Но то же самое нельзя сказать об Айше, которая смотрит на меня серьезным взглядом, останавливая меня."

# ch/ayesha/condom.rpy:46
translate russian ayesha_warn_condom_dc72a1ad:
    ayesha.say "Эй, [lssb_ayesha.hero_name()], ты ничего не забыл?"

# ch/ayesha/condom.rpy:48
translate russian ayesha_warn_condom_e3ba465c:
    "Но тут я впервые за этот вечер чувствую, что она сопротивляется."

# ch/ayesha/condom.rpy:49
translate russian ayesha_warn_condom_881c7ef2:
    "Айша поворачивает голову и смотрит на меня через плечо."

# ch/ayesha/condom.rpy:50
translate russian ayesha_warn_condom_e0e64423:
    ayesha.say "[lssb_ayesha.hero_name()], не забывай об одной маленькой детали, ладно?"

# ch/ayesha/condom.rpy:52
translate russian ayesha_warn_condom_64a9966b:
    "Внезапно Айша останавливается и качает головой."

# ch/ayesha/condom.rpy:53
translate russian ayesha_warn_condom_a3bbc907:
    ayesha.say "Подожди минутку, детка."

# ch/ayesha/condom.rpy:54
translate russian ayesha_warn_condom_3913c2e7:
    ayesha.say "Нам нужно использовать защиту!"

# ch/ayesha/condom.rpy:56
translate russian ayesha_warn_condom_7d0c0dde:
    "Айша останавливает меня на месте."

# ch/ayesha/condom.rpy:57
translate russian ayesha_warn_condom_dc72a1ad_1:
    ayesha.say "Эй, [lssb_ayesha.hero_name()], ты ничего не забыл?"

# ch/ayesha/condom.rpy:63
translate russian ayesha_force_condom_7fa2b566:
    "Сначала я немного опешил, но тут же кивнул, как только Айша показала мне презерватив."

# ch/ayesha/condom.rpy:64
translate russian ayesha_force_condom_4f224da9:
    "Я торопливо киваю, беру его и не теряя времени надеваю."

# ch/ayesha/condom.rpy:65
translate russian ayesha_force_condom_48c9e6c3:
    "Через несколько секунд все готово."

# ch/ayesha/condom.rpy:67
translate russian ayesha_force_condom_97187ccd:
    "Айша права, сначала главное — нельзя забывать об основах!"

# ch/ayesha/condom.rpy:68
translate russian ayesha_force_condom_0e76085e:
    "Я тянусь рукой и успеваю схватить презерватив со столика возле кровати."

# ch/ayesha/condom.rpy:69
translate russian ayesha_force_condom_3923b55b:
    "Она бросает взгляд через плечо и кивает в знак одобрения."

# ch/ayesha/condom.rpy:70
translate russian ayesha_force_condom_45185fb9:
    "Ещё всего пара секунд, и мы будем готовы."

# ch/ayesha/condom.rpy:72
translate russian ayesha_force_condom_65ff1c78:
    "Я терпеливо жду, пока Айша достанет презерватив из своей сумки."

# ch/ayesha/condom.rpy:73
translate russian ayesha_force_condom_4c53bd82:
    "И я затаив дыхание наблюдаю, как она открывает упаковку и надевает его на мой член."

# ch/ayesha/condom.rpy:74
translate russian ayesha_force_condom_4c218258:
    "Через мгновение все сделано, и Айша радостно кивает."

# ch/ayesha/condom.rpy:75
translate russian ayesha_force_condom_c2489b51:
    ayesha.say "Ну вот."

# ch/ayesha/condom.rpy:76
translate russian ayesha_force_condom_db88b7d3:
    ayesha.say "А теперь, где мы остановились..."

# ch/ayesha/condom.rpy:78
translate russian ayesha_force_condom_2e4a3ebf:
    "Сначала я немного растерялся, но тут же кивнул, как только она протянула мне презерватив."

# ch/ayesha/condom.rpy:79
translate russian ayesha_force_condom_9d95b8bb:
    "Приняв его из ее рук, я даже не говорю ни слова и сразу надеваю его."

# ch/ayesha/condom.rpy:80
translate russian ayesha_force_condom_f3db8f86:
    "В мгновение ока я готов."

# ch/ayesha/condom.rpy:86
translate russian ayesha_mad_condom_536bc7c8:
    "Но то же самое нельзя сказать об Айше, которая смотрит на меня серьезным взглядом, останавливая меня."

# ch/ayesha/condom.rpy:87
translate russian ayesha_mad_condom_dc72a1ad:
    ayesha.say "Эй, [lssb_ayesha.hero_name()], ты ничего не забыл?"

# ch/ayesha/condom.rpy:88
translate russian ayesha_mad_condom_da85da29:
    mike.say "Нет... Я так не думаю!"

# ch/ayesha/condom.rpy:89
translate russian ayesha_mad_condom_f9160510:
    "Айша издает звук презрительного фырканья."

# ch/ayesha/condom.rpy:90
translate russian ayesha_mad_condom_02591f94:
    ayesha.say "А как насчет презерватива, гений?!"

# ch/ayesha/condom.rpy:91
translate russian ayesha_mad_condom_2a660341:
    ayesha.say "Не верю! Ты собирался трахнуть меня без него!"

# ch/ayesha/condom.rpy:92
translate russian ayesha_mad_condom_c64359db:
    "Она толкает меня в грудь ладонью."

# ch/ayesha/condom.rpy:93
translate russian ayesha_mad_condom_48ab9755:
    "И впервые сегодня я вспоминаю, насколько она на самом деле сильна."

# ch/ayesha/condom.rpy:94
translate russian ayesha_mad_condom_aff85fa1:
    "Я задыхаюсь, воздух вырывается из моих легких, и я падаю на спину на кровать."

# ch/ayesha/condom.rpy:95
translate russian ayesha_mad_condom_bc476e74:
    "Я все еще ворочаюсь, пытаясь отдышаться, пока Айша встает и начинает одеваться."

# ch/ayesha/condom.rpy:96
translate russian ayesha_mad_condom_6b7f6377:
    "Затем я слышу звук открывающейся и захлопывающейся двери, когда она уходит."

# ch/ayesha/condom.rpy:99
translate russian ayesha_mad_condom_b1c25bf0:
    mike.say "Что это за мелочь?"

# ch/ayesha/condom.rpy:100
translate russian ayesha_mad_condom_3846b3ce:
    "Айша качает головой, пораженная моим ответом."

# ch/ayesha/condom.rpy:101
translate russian ayesha_mad_condom_a02afc0c:
    ayesha.say "Ну, презерватив, идиот!"

# ch/ayesha/condom.rpy:102
translate russian ayesha_mad_condom_1c2b9111:
    ayesha.say "Ты не собираешься засовывать это внутрь меня без него."

# ch/ayesha/condom.rpy:103
translate russian ayesha_mad_condom_42dce11b:
    "Айша слезает с меня, и делает это совсем не нежно."

# ch/ayesha/condom.rpy:104
translate russian ayesha_mad_condom_81f63820:
    "Я стону от боли, чувствуя себя слишком стыдным, чтобы возразить."

# ch/ayesha/condom.rpy:105
translate russian ayesha_mad_condom_fbd674ae:
    "В итоге я молча смотрю, как она одевается."

# ch/ayesha/condom.rpy:106
translate russian ayesha_mad_condom_2a09a7a2:
    "Затем она выбегает из комнаты, хлопнув дверью."

# ch/ayesha/condom.rpy:109
translate russian ayesha_mad_condom_20a07b7a:
    mike.say "Серьезно, Айша?"

# ch/ayesha/condom.rpy:110
translate russian ayesha_mad_condom_ac7bedb8:
    mike.say "Это просто испортит всю атмосферу!"

# ch/ayesha/condom.rpy:111
translate russian ayesha_mad_condom_37cd4e70:
    mike.say "Я уйду до конца, поверь мне."

# ch/ayesha/condom.rpy:112
translate russian ayesha_mad_condom_dc8c0488:
    ayesha.say "Да..."

# ch/ayesha/condom.rpy:113
translate russian ayesha_mad_condom_7c0c6fa2:
    ayesha.say "Кажется, ты сам испортил всю атмосферу!"

# ch/ayesha/condom.rpy:114
translate russian ayesha_mad_condom_a9cf4ad4:
    "С этими словами она слезает с меня, а затем со кровати."

# ch/ayesha/condom.rpy:115
translate russian ayesha_mad_condom_0094c631:
    "Айша начинает одеваться, и я смотрю на это в полном недоумении."

# ch/ayesha/condom.rpy:116
translate russian ayesha_mad_condom_92357866:
    mike.say "Ты действительно собираешься уйти?!"

# ch/ayesha/condom.rpy:117
translate russian ayesha_mad_condom_9319bbfe:
    ayesha.say "Ну да, именно это я и делаю."

# ch/ayesha/condom.rpy:118
translate russian ayesha_mad_condom_2ab3d51d:
    ayesha.say "Так что тебе лучше с этим смириться!"

# ch/ayesha/condom.rpy:119
translate russian ayesha_mad_condom_8c643512:
    "Все, что мне остается, – это молча наблюдать, как Айша выполняет свое обещание."

# ch/ayesha/condom.rpy:120
translate russian ayesha_mad_condom_b317ff3c:
    "Похоже, на этот раз я всё испортил. И всё из-за чёртова презерватива!"

# ch/ayesha/condom.rpy:122
translate russian ayesha_mad_condom_606efe9d:
    mike.say "Что за бред ты несешь?!"

# ch/ayesha/condom.rpy:123
translate russian ayesha_mad_condom_68aa5070:
    "Айша смотрит на меня взглядом, в котором читаются неверие и отвращение."

# ch/ayesha/condom.rpy:124
translate russian ayesha_mad_condom_83458927:
    ayesha.say "\"Защита, ты, черт побери!\", - говорит Айша Майку."

# ch/ayesha/condom.rpy:125
translate russian ayesha_mad_condom_0fc839cc:
    ayesha.say "\"Нам не двигаться дальше без этого\", - говорит Айша Майку."

# ch/ayesha/condom.rpy:126
translate russian ayesha_mad_condom_0a1dfad0:
    "Айша отталкивает меня, с легкостью бросая в сторону."

# ch/ayesha/condom.rpy:127
translate russian ayesha_mad_condom_7264f037:
    "Удар болезненный, но самое сильное впечатление произвело шоковое состояние."

# ch/ayesha/condom.rpy:128
translate russian ayesha_mad_condom_c2dc387f:
    "Я морщусь от дискомфорта, боясь сказать хоть слово из-за того, что она может сделать со мной."

# ch/ayesha/condom.rpy:129
translate russian ayesha_mad_condom_a5c36d6f:
    "В итоге я вынужден молча наблюдать за тем, как она одевается."

# ch/ayesha/condom.rpy:130
translate russian ayesha_mad_condom_d4897f28:
    "И единственный звук, который следует за этим, – это хлопок двери, которая закрывается за ней."

# ch/ayesha/date.rpy:2
translate russian ayesha_date_intro_valentine_male_3aca2941:
    ayesha.say "При...привет, [lssb_ayesha.hero_name()]!"

# ch/ayesha/date.rpy:3
translate russian ayesha_date_intro_valentine_male_7f25f158:
    ayesha.say "Я… немного нервничаю из-за сегодняшнего вечера."

# ch/ayesha/date.rpy:4
translate russian ayesha_date_intro_valentine_male_0ecd8f1c:
    ayesha.say "Не думаю, что я когда-либо была чьей-то возлюбленной!"

# ch/ayesha/date.rpy:5
translate russian ayesha_date_intro_valentine_male_793d41a1:
    "Едва слова слетают с ее губ, мое сердце сжимается от сочувствия к ней."

# ch/ayesha/date.rpy:6
translate russian ayesha_date_intro_valentine_male_511e9b9a:
    "Она выглядит такой беззащитной, и сейчас, несмотря на свою атлетическую фигуру."

# ch/ayesha/date.rpy:7
translate russian ayesha_date_intro_valentine_male_beed4dcd:
    mike.say "Не волнуйся, Аиша, просто следуй за мной."

# ch/ayesha/date.rpy:8
translate russian ayesha_date_intro_valentine_male_15d88afa:
    mike.say "Я бы не хотел никого другого в качестве своей возлюбленной, ни за что на свете!"

# ch/ayesha/date.rpy:12
translate russian ayesha_date_intro_halloween_male_b83442d2:
    mike.say "Привет, Айша, сегодня ты отлично выглядишь!"

# ch/ayesha/date.rpy:13
translate russian ayesha_date_intro_halloween_male_0e25bfb2:
    "Аиша краснеет и улыбается в ответ на мой комплимент."

# ch/ayesha/date.rpy:14
translate russian ayesha_date_intro_halloween_male_1a34974c:
    ayesha.say "Спасибо, [lssb_ayesha.hero_name()], ты тоже."

# ch/ayesha/date.rpy:15
translate russian ayesha_date_intro_halloween_male_427dc89d:
    ayesha.say "Я очень взволнована из-за сегодняшнего вечера."

# ch/ayesha/date.rpy:16
translate russian ayesha_date_intro_halloween_male_55a71ad1:
    ayesha.say "Не думаю, что я когда-либо ходила на свидание в Хэллоуин!"

# ch/ayesha/date.rpy:17
translate russian ayesha_date_intro_halloween_male_00ec73c6:
    "Услышав слово \"Хэллоуин\", я хлопаю себя по лбу."

# ch/ayesha/date.rpy:18
translate russian ayesha_date_intro_halloween_male_d0f13795:
    mike.say "Сегодня Хэллоуин, и я совершенно забыл!"

# ch/ayesha/date.rpy:19
translate russian ayesha_date_intro_halloween_male_062e0fba:
    mike.say "Мы должны были нарядиться для этого случая."

# ch/ayesha/date.rpy:20
translate russian ayesha_date_intro_halloween_male_4fcc6245:
    "Аиша качает головой в ответ на это."

# ch/ayesha/date.rpy:21
translate russian ayesha_date_intro_halloween_male_89c60743:
    ayesha.say "О нет, [lssb_ayesha.hero_name()], в странные костюмы я наряжаюсь только для рестлинга."

# ch/ayesha/date.rpy:25
translate russian ayesha_date_intro_christmas_male_03ac801a:
    ayesha.say "Счастливого Рождества, [lssb_ayesha.hero_name()]!"

# ch/ayesha/date.rpy:26
translate russian ayesha_date_intro_christmas_male_80afbc2c:
    ayesha.say "Ты готов к нашей встрече?"

# ch/ayesha/date.rpy:27
translate russian ayesha_date_intro_christmas_male_7b9e7c39:
    mike.say "Конечно, Аиша."

# ch/ayesha/date.rpy:28
translate russian ayesha_date_intro_christmas_male_a4573b3a:
    mike.say "Я ждал этого всю неделю!"

# ch/ayesha/date.rpy:29
translate russian ayesha_date_intro_christmas_male_a989c0b2:
    "Лицо Аиши озаряется, когда она слышит мой восторженный голос."

# ch/ayesha/date.rpy:30
translate russian ayesha_date_intro_christmas_male_d8613351:
    ayesha.say "Ну тогда пошли."

# ch/ayesha/date.rpy:31
translate russian ayesha_date_intro_christmas_male_5ad3a6b0:
    ayesha.say "И под первой же веточкой омелы я хочу праздничный поцелуй!"

# ch/ayesha/date.rpy:35
translate russian ayesha_date_intro_birthday_male_ec86fe2e:
    mike.say "С днем рождения, Аиша!"

# ch/ayesha/date.rpy:36
translate russian ayesha_date_intro_birthday_male_ff5ad866:
    ayesha.say "Т...ты помнишь?"

# ch/ayesha/date.rpy:37
translate russian ayesha_date_intro_birthday_male_0735ad81:
    ayesha.say "О, [lssb_ayesha.hero_name()], о моём дне рождения НИКТО не помнит!"

# ch/ayesha/date.rpy:38
translate russian ayesha_date_intro_birthday_male_bd9fc62f:
    mike.say "Никто, кроме меня, Аиша."

# ch/ayesha/date.rpy:39
translate russian ayesha_date_intro_birthday_male_7c29276d:
    mike.say "Ты для меня очень важна, и я хотел сделать этот день особенным для тебя."

# ch/ayesha/date.rpy:40
translate russian ayesha_date_intro_birthday_male_3f4e9afe:
    ayesha.say "Ты уже сделал это, [lssb_ayesha.hero_name()], ты уже сделал!"

# ch/ayesha/date.rpy:44
translate russian ayesha_date_intro_mc_birthday_male_36408d41:
    mike.say "Ты готова к нашей встрече, Аиша?"

# ch/ayesha/date.rpy:45
translate russian ayesha_date_intro_mc_birthday_male_c5e0ef62:
    ayesha.say "Да, [lssb_ayesha.hero_name()], да..."

# ch/ayesha/date.rpy:46
translate russian ayesha_date_intro_mc_birthday_male_d5701eb3:
    ayesha.say "Ох... Я не могу поверить, что чуть не забыла!"

# ch/ayesha/date.rpy:47
translate russian ayesha_date_intro_mc_birthday_male_c754a389:
    ayesha.say "С днем рождения, [lssb_ayesha.hero_name()]!"

# ch/ayesha/date.rpy:48
translate russian ayesha_date_intro_mc_birthday_male_856e5146:
    mike.say "Вау, Айша, спасибо, что не забыла!"

# ch/ayesha/date.rpy:49
translate russian ayesha_date_intro_mc_birthday_male_14df0b35:
    ayesha.say "Не смотри на меня так, [lssb_ayesha.hero_name()]."

# ch/ayesha/date.rpy:50
translate russian ayesha_date_intro_mc_birthday_male_d9454054:
    ayesha.say "Ты заставляешь меня краснеть!"

# ch/ayesha/date.rpy:55
translate russian ayesha_date_pub_male_b9bc20b8:
    ayesha.say "Так, это... твой район?"

# ch/ayesha/date.rpy:56
translate russian ayesha_date_pub_male_f0d3d6b4:
    mike.say "А, да, а почему ты спрашиваешь?"

# ch/ayesha/date.rpy:57
translate russian ayesha_date_pub_male_801bcc56:
    ayesha.say "Без причины..."

# ch/ayesha/date.rpy:58
translate russian ayesha_date_pub_male_1857c8a1:
    ayesha.say "Просто интересно, что это говорит о тебе..."

# ch/ayesha/date.rpy:64
translate russian ayesha_date_cinema_male_4bfbc26a:
    ayesha.say "Кинотеатр звучит как отличная идея."

# ch/ayesha/date.rpy:65
translate russian ayesha_date_cinema_male_a05beb42:
    ayesha.say "Главное, чтобы нам не пришлось смотреть что-нибудь жестокое и бессмысленное!"

# ch/ayesha/date.rpy:71
translate russian ayesha_date_familyrestaurant_male_9e8c6483:
    ayesha.say "Хм..."

# ch/ayesha/date.rpy:72
translate russian ayesha_date_familyrestaurant_male_21b6ab05:
    mike.say "Что случилось, Аиша?"

# ch/ayesha/date.rpy:73
translate russian ayesha_date_familyrestaurant_male_3bad8cf0:
    ayesha.say "Да ничего особенного, просто... здесь ОЧЕНЬ много шумных детей!"

# ch/ayesha/date.rpy:79
translate russian ayesha_date_restaurant_male_de295599:
    ayesha.say "Вау, это место совсем не такое, как я ожидала!"

# ch/ayesha/date.rpy:80
translate russian ayesha_date_restaurant_male_6885f03f:
    mike.say "Правда?"

# ch/ayesha/date.rpy:81
translate russian ayesha_date_restaurant_male_91781975:
    mike.say "Это одно из моих любимых мест, где можно поесть."

# ch/ayesha/date.rpy:82
translate russian ayesha_date_restaurant_male_334d2821:
    ayesha.say "Ну что ж, [lssb_ayesha.hero_name()], похоже, у тебя есть скрытые таланты!"

# ch/ayesha/date.rpy:88
translate russian ayesha_date_amusmentpark_male_08432d04:
    ayesha.say "Здесь очень много людей, [lssb_ayesha.hero_name()]."

# ch/ayesha/date.rpy:89
translate russian ayesha_date_amusmentpark_male_4f44d9a6:
    ayesha.say "Не отпускай мою руку!"

# ch/ayesha/date.rpy:95
translate russian ayesha_date_ride_the_ferris_wheel_f8296bed:
    ayesha.say "Ох... Мне не нравится вид на это колесо обозрения."

# ch/ayesha/date.rpy:96
translate russian ayesha_date_ride_the_ferris_wheel_28fec5c6:
    ayesha.say "Если мы поедем на нем, мне, возможно, придется держаться за тебя все время!"

# ch/ayesha/date.rpy:105
translate russian ayesha_date_waterpark_male_77691c57:
    "Когда я предложил ей, я немного ожидал, что Аиша отреагирует негативно на идею пойти со мной в аквапарк."

# ch/ayesha/date.rpy:106
translate russian ayesha_date_waterpark_male_5bd5e2bc:
    "Я думаю, я боялся, что она посчитает это довольно детским способом провести время и скажет мне, что это невозможно."

# ch/ayesha/date.rpy:107
translate russian ayesha_date_waterpark_male_1e70c87c:
    "В конце концов, она очень серьезно относится к физической дисциплине и поддержанию себя в форме."

# ch/ayesha/date.rpy:108
translate russian ayesha_date_waterpark_male_0990be01:
    "И трудно представить себе, как она может беззаботно плескаться в бассейне."

# ch/ayesha/date.rpy:109
translate russian ayesha_date_waterpark_male_1d2bdfcb:
    "Но когда я действительно звоню ей и спрашиваю, она удивляет меня своим ответом."

# ch/ayesha/date.rpy:110
translate russian ayesha_date_waterpark_male_4107a1cf:
    ayesha.say "Знаешь что, [lssb_ayesha.hero_name()], звучит заманчиво."

# ch/ayesha/date.rpy:111
translate russian ayesha_date_waterpark_male_63568193:
    "На мгновение я не знаю, что сказать."

# ch/ayesha/date.rpy:112
translate russian ayesha_date_waterpark_male_e84ef02c:
    "У меня были все мои аргументы и альтернативы наготове, если бы Аиша отказала."

# ch/ayesha/date.rpy:113
translate russian ayesha_date_waterpark_male_24c1ed9f:
    "Единственное, чего я никогда не ожидал – это того, что она согласится сразу!"

# ch/ayesha/date.rpy:114
translate russian ayesha_date_waterpark_male_352188a2:
    mike.say "Ну, если ты не хочешь, мы всегда можем..."

# ch/ayesha/date.rpy:115
translate russian ayesha_date_waterpark_male_e9eb93a9:
    mike.say "Постой... ты сказала \"да\"?"

# ch/ayesha/date.rpy:116
translate russian ayesha_date_waterpark_male_f1b620e3:
    ayesha.say "Ну да, [lssb_ayesha.hero_name()]."

# ch/ayesha/date.rpy:117
translate russian ayesha_date_waterpark_male_ba199228:
    ayesha.say "Это же не проблема, правда?"

# ch/ayesha/date.rpy:118
translate russian ayesha_date_waterpark_male_19f54735:
    ayesha.say "Я имею в виду, ты сама это предложила..."

# ch/ayesha/date.rpy:119
translate russian ayesha_date_waterpark_male_a2c093e9:
    mike.say "А, да... конечно, я!"

# ch/ayesha/date.rpy:120
translate russian ayesha_date_waterpark_male_958d1872:
    mike.say "Просто я не знал, понравится ли тебе такое."

# ch/ayesha/date.rpy:121
translate russian ayesha_date_waterpark_male_79faedbd:
    ayesha.say "Почему бы мне не понравилось?"

# ch/ayesha/date.rpy:122
translate russian ayesha_date_waterpark_male_3e19eea4:
    ayesha.say "Я люблю веселиться так же, как и все!"

# ch/ayesha/date.rpy:123
translate russian ayesha_date_waterpark_male_be8bbbf3:
    mike.say "Конечно, конечно, Айша."

# ch/ayesha/date.rpy:124
translate russian ayesha_date_waterpark_male_1c47a9c7:
    ayesha.say "Вот и отлично, [lssb_ayesha.hero_name()], рада, что мы это выяснили!"

# ch/ayesha/date.rpy:125
translate russian ayesha_date_waterpark_male_4b41b2dc:
    mike.say "Так... я должен быть там?"

# ch/ayesha/date.rpy:126
translate russian ayesha_date_waterpark_male_f59e4415:
    mike.say "Может, сегодня днем?"

# ch/ayesha/date.rpy:127
translate russian ayesha_date_waterpark_male_b163f680:
    ayesha.say "Звучит как отличный план!"

# ch/ayesha/date.rpy:128
translate russian ayesha_date_waterpark_male_122f4342:
    "И вот так я оказался в аквапарке вместе с Айшей."

# ch/ayesha/date.rpy:129
translate russian ayesha_date_waterpark_male_a002de42:
    "А потом, вскоре после этого, мы вышли из своих раздевалок."

# ch/ayesha/date.rpy:130
translate russian ayesha_date_waterpark_male_614c45df:
    "Я был готов немного раньше, чем она, и пока ждал, невольно смотрел на свое отражение."

# ch/ayesha/date.rpy:131
translate russian ayesha_date_waterpark_male_1774e055:
    "Можете называть меня тщеславным, если хотите, но я в последнее время очень много занимался спортом."

# ch/ayesha/date.rpy:132
translate russian ayesha_date_waterpark_male_06c3df73:
    "И я надеюсь, что Айша заметит улучшения во внешности."

# ch/ayesha/date.rpy:134
translate russian ayesha_date_waterpark_male_b3970fd1:
    ayesha.say "Привет, [lssb_ayesha.hero_name()]."

# ch/ayesha/date.rpy:135
translate russian ayesha_date_waterpark_male_f305f09d:
    ayesha.say "Ты готов окунуться?"

# ch/ayesha/date.rpy:137
translate russian ayesha_date_waterpark_male_66c5dc1a:
    "Но когда я оборачиваюсь, услышав ее голос, все мысли о том, чтобы произвести на нее впечатление своей фигурой, мгновенно исчезают."

# ch/ayesha/date.rpy:138
translate russian ayesha_date_waterpark_male_8a097af6:
    "Да, я видел Айшу в спортивной одежде в спортзале и на ринге для борьбы."

# ch/ayesha/date.rpy:139
translate russian ayesha_date_waterpark_male_cc031965:
    "Но вид ее, стоящей там в купальнике, заставляет меня остановиться."

# ch/ayesha/date.rpy:140
translate russian ayesha_date_waterpark_male_9edcbff8:
    "Может быть, дело просто в фасоне того, что она надела."

# ch/ayesha/date.rpy:141
translate russian ayesha_date_waterpark_male_11c40010:
    "А может, дело в улыбке, которая сейчас сияет на её лице."

# ch/ayesha/date.rpy:142
translate russian ayesha_date_waterpark_male_327c0489:
    "Так или иначе, выглядит она потрясающе, и я уже замечаю восхищённые взгляды, которые она притягивает."

# ch/ayesha/date.rpy:143
translate russian ayesha_date_waterpark_male_342952e8:
    mike.say "Эй, Айша, отлично выглядишь!"

# ch/ayesha/date.rpy:144
translate russian ayesha_date_waterpark_male_1673bc7a:
    "Я тороплюсь к ней, чтобы все знали, что эта ослепительная амазонка со мной!"

# ch/ayesha/date.rpy:146
translate russian ayesha_date_waterpark_male_cd30641f:
    ayesha.say "Ты...ты действительно так думаешь?"

# ch/ayesha/date.rpy:147
translate russian ayesha_date_waterpark_male_fe59c8f3:
    ayesha.say "Я думала, что это может быть слишком откровенно, понимаете?"

# ch/ayesha/date.rpy:149
translate russian ayesha_date_waterpark_male_151f7b66:
    ayesha.say "Что это покажет слишком много моих мышц?"

# ch/ayesha/date.rpy:150
translate russian ayesha_date_waterpark_male_e6058583:
    "Я качаю головой, когда она обнимает меня за руку, и мы начинаем идти вместе."

# ch/ayesha/date.rpy:151
translate russian ayesha_date_waterpark_male_94dc516f:
    mike.say "Ни за что, Аиша."

# ch/ayesha/date.rpy:152
translate russian ayesha_date_waterpark_male_5599453b:
    mike.say "Ты выглядишь как настоящая богиня в этом наряде!"

# ch/ayesha/date.rpy:153
translate russian ayesha_date_waterpark_male_63a88f19:
    "Аиша качает головой и смущенно отворачивается от моего замечания."

# ch/ayesha/date.rpy:154
translate russian ayesha_date_waterpark_male_3b311171:
    "Но, несмотря ни на что, я вижу, что она просто сияет от этого комплимента."

# ch/ayesha/date.rpy:155
translate russian ayesha_date_waterpark_male_966ff6db:
    "Я решаю начать все постепенно, и мы немного порезвились в одном из неглубоких бассейнов."

# ch/ayesha/date.rpy:158
translate russian ayesha_date_waterpark_male_7ef9682e:
    "Сначала Аиша, кажется, не хочет присоединяться к моим шалостям, когда я обрызгиваю ее водой и вообще веду себя как ребенок."

# ch/ayesha/date.rpy:159
translate russian ayesha_date_waterpark_male_7193434d:
    "Но затем, как только она начинает расслабляться и отвечает мне тем же, из-за наших спин раздается крик."

# ch/ayesha/date.rpy:160
translate russian ayesha_date_waterpark_male_5a39c227:
    "Мальчишка" "Эй, я тебя узнал!"

# ch/ayesha/date.rpy:161
translate russian ayesha_date_waterpark_male_fd7bb37f:
    "Другой мальчишка" "Да, это тот парень, который избил Кути Кавасаки!"

# ch/ayesha/date.rpy:162
translate russian ayesha_date_waterpark_male_b5640155:
    "Мы с Аишей одновременно оборачиваемся и видим двух очень сердитых мальчиков, стоящих немного в стороне."

# ch/ayesha/date.rpy:166
translate russian ayesha_date_waterpark_male_91c560e0:
    "Ни одному из них не может быть больше десяти лет."

# ch/ayesha/date.rpy:167
translate russian ayesha_date_waterpark_male_a7b5a5ba:
    "Но у них сжаты кулаки и нахмуренные лица."

# ch/ayesha/date.rpy:169
translate russian ayesha_date_waterpark_male_d271c137:
    ayesha.say "Эм... кажется, вы меня перепутали с кем-то другим, ребята."

# ch/ayesha/date.rpy:170
translate russian ayesha_date_waterpark_male_d4ac79f8:
    "Мальчишка" "Ни за что, дама!"

# ch/ayesha/date.rpy:171
translate russian ayesha_date_waterpark_male_13180ae3:
    "Другой мальчишка" "Мы большие фанаты рестлинга."

# ch/ayesha/date.rpy:172
translate russian ayesha_date_waterpark_male_3e6ea30c:
    "Мальчишка" "И мы знаем, кто ты на самом деле!"

# ch/ayesha/date.rpy:173
translate russian ayesha_date_waterpark_male_770104f4:
    "Айша отворачивает голову от парней и поворачивается ко мне."

# ch/ayesha/date.rpy:175
translate russian ayesha_date_waterpark_male_b95257e8:
    "И я вижу в ее глазах безмолственную мольбу о помощи..."

# ch/ayesha/date.rpy:178
translate russian ayesha_date_waterpark_male_b14dcfa4:
    "Да что эти сопляки себе позволяют, с кем они разговаривают?!"

# ch/ayesha/date.rpy:179
translate russian ayesha_date_waterpark_male_34a99d8f:
    "Айша и я только начали свидание, которое обещало быть очень интересным."

# ch/ayesha/date.rpy:180
translate russian ayesha_date_waterpark_male_86ee568c:
    "А теперь они собираются все испортить из-за какого-то глупого рестлинг-матча, на котором ее видели?!?"

# ch/ayesha/date.rpy:181
translate russian ayesha_date_waterpark_male_2af01b05:
    "Ну, вот что эти мерзкие сопляки думают!"

# ch/ayesha/date.rpy:182
translate russian ayesha_date_waterpark_male_54f32d13:
    mike.say "Эй, вы двое!"

# ch/ayesha/date.rpy:183
translate russian ayesha_date_waterpark_male_59efb5ef:
    "Головы мальчишек поворачиваются, как будто у них вместо шеи карандаши. Они услышали мой голос."

# ch/ayesha/date.rpy:184
translate russian ayesha_date_waterpark_male_7cceb6d3:
    mike.say "Да-да, я с тобой разговариваю!"

# ch/ayesha/date.rpy:185
translate russian ayesha_date_waterpark_male_bd6bf70a:
    mike.say "Это моя девушка, и ты проявляешь к ней неуважение, мне это не нравится."

# ch/ayesha/date.rpy:186
translate russian ayesha_date_waterpark_male_042541e5:
    "Мальчишка" "Она плохая, мистер!"

# ch/ayesha/date.rpy:187
translate russian ayesha_date_waterpark_male_e6ac595a:
    "Другой мальчишка" "Да, она всегда жульничает на ринге!"

# ch/ayesha/date.rpy:188
translate russian ayesha_date_waterpark_male_e0a6338d:
    "Я оглядываюсь по сторонам, смотрю то в одну, то в другую сторону."

# ch/ayesha/date.rpy:189
translate russian ayesha_date_waterpark_male_db3304ff:
    mike.say "Забавно, я не вижу здесь ни одного ринга для рестлинга."

# ch/ayesha/date.rpy:190
translate russian ayesha_date_waterpark_male_6c768a96:
    mike.say "И вы знаете, почему?"

# ch/ayesha/date.rpy:191
translate russian ayesha_date_waterpark_male_6897bbc2:
    "Мальчики нервно смотрят на меня и качают головами."

# ch/ayesha/date.rpy:192
translate russian ayesha_date_waterpark_male_3fa487d0:
    mike.say "Потому что это РЕАЛЬНЫЙ мир, балбесы."

# ch/ayesha/date.rpy:193
translate russian ayesha_date_waterpark_male_3c5a4846:
    mike.say "Борьба – это подделка, выдумка, и вы, тупицы, думаете, что это настоящее!"

# ch/ayesha/date.rpy:195
translate russian ayesha_date_waterpark_male_edb43245:
    "Мальчишка" "Что...что?!"

# ch/ayesha/date.rpy:196
translate russian ayesha_date_waterpark_male_e21a63bb:
    "Другой мальчишка" "Нет, сэр, это действительно так..."

# ch/ayesha/date.rpy:197
translate russian ayesha_date_waterpark_male_54ef6756:
    mike.say "Это ненастоящее, выдумка, сказка, как Санта-Клаус!"

# ch/ayesha/date.rpy:198
translate russian ayesha_date_waterpark_male_5037830c:
    "Я оставляю этих двух мальчиков переваривать эту информацию и беру Айшу под руку, уводя ее от них."

# ch/ayesha/date.rpy:199
translate russian ayesha_date_waterpark_male_5170b520:
    "Мальчишка" "Не может быть!"

# ch/ayesha/date.rpy:201
translate russian ayesha_date_waterpark_male_d43aa897:
    "Другой мальчишка" "Постой...что этот грубый мужчина сказал о Санте?!"

# ch/ayesha/date.rpy:203
translate russian ayesha_date_waterpark_male_b8b55ba3:
    "Айша бросает взгляд через плечо, когда мы уходим, оставляя их разбираться с правдой."

# ch/ayesha/date.rpy:204
translate russian ayesha_date_waterpark_male_2f289293:
    ayesha.say "Ты, наверное, не стоило этого говорить."

# ch/ayesha/date.rpy:206
translate russian ayesha_date_waterpark_male_0a5bf300:
    ayesha.say "Что, если они больше никогда не пойдут на борьбу после этого?"

# ch/ayesha/date.rpy:207
translate russian ayesha_date_waterpark_male_c96a6016:
    mike.say "Ну и что, если они не походят, Айша?"

# ch/ayesha/date.rpy:208
translate russian ayesha_date_waterpark_male_20171e7d:
    mike.say "Представь себе, это всего лишь два мерзких сопляка меньше, которые будут оскорблять тебя, пока ты там!"

# ch/ayesha/date.rpy:211
translate russian ayesha_date_waterpark_male_4459c110:
    "Мне нужно придумать выход из этой ситуации, и мне нужно сделать это быстро."

# ch/ayesha/date.rpy:212
translate russian ayesha_date_waterpark_male_0e0098d0:
    "Но проблема в том, что я не могу сделать ничего, что заставит их поверить, что борьба – это нереально."

# ch/ayesha/date.rpy:213
translate russian ayesha_date_waterpark_male_33bb8190:
    "И сказать Айше, чтобы она бросила их головой вниз в бассейн, этого недостаточно!"

# ch/ayesha/date.rpy:214
translate russian ayesha_date_waterpark_male_8fe81acf:
    "Я напрягаю все свои мысли, пытаясь придумать какое-нибудь правило борьбы, которое могло бы спасти ей задницу…"

# ch/ayesha/date.rpy:215
translate russian ayesha_date_waterpark_male_54f32d13_1:
    mike.say "Эй, вы двое!"

# ch/ayesha/date.rpy:216
translate russian ayesha_date_waterpark_male_59efb5ef_1:
    "Головы мальчишек поворачиваются, как будто у них вместо шеи карандаши. Они услышали мой голос."

# ch/ayesha/date.rpy:217
translate russian ayesha_date_waterpark_male_7cceb6d3_1:
    mike.say "Да-да, я с тобой разговариваю!"

# ch/ayesha/date.rpy:218
translate russian ayesha_date_waterpark_male_5b29ee5e:
    mike.say "Ты оскорбляешь моего партнера по команде, и мне это не нравится."

# ch/ayesha/date.rpy:219
translate russian ayesha_date_waterpark_male_042541e5_1:
    "Мальчишка" "Она плохая, мистер!"

# ch/ayesha/date.rpy:220
translate russian ayesha_date_waterpark_male_e6ac595a_1:
    "Другой мальчишка" "Да, она всегда жульничает на ринге!"

# ch/ayesha/date.rpy:221
translate russian ayesha_date_waterpark_male_d57fff73:
    mike.say "Ну и что вы мне сделаете, шпана?"

# ch/ayesha/date.rpy:222
translate russian ayesha_date_waterpark_male_7114cc53:
    mike.say "Ты же прекрасно знаешь, что правила не позволяют мужчине драться с женщиной."

# ch/ayesha/date.rpy:223
translate russian ayesha_date_waterpark_male_24ac8e14:
    mike.say "Значит, тебе придется взять меня к себе!"

# ch/ayesha/date.rpy:224
translate russian ayesha_date_waterpark_male_4fff3898:
    "Я встаю между Аейшей и этими ребятами, стараясь выглядеть как можно более устрашающе."

# ch/ayesha/date.rpy:225
translate russian ayesha_date_waterpark_male_fd278760:
    "Мальчишка" "Эй, я никогда раньше тебя на ринге не видел!"

# ch/ayesha/date.rpy:226
translate russian ayesha_date_waterpark_male_65eedab6:
    "Другой мальчишка" "Как мы можем быть уверены, что ты вообще борец?"

# ch/ayesha/date.rpy:227
translate russian ayesha_date_waterpark_male_9c12cca4:
    mike.say "Вот как?"

# ch/ayesha/date.rpy:228
translate russian ayesha_date_waterpark_male_ec03f58b:
    mike.say "А как насчет того, чтобы ты вышел на ринг и бросил мне вызов, братан?"

# ch/ayesha/date.rpy:229
translate russian ayesha_date_waterpark_male_546c3c52:
    mike.say "Или ты боишься, что [lssb_ayesha.hero_name()]mania сорвется на тебе?!?"

# ch/ayesha/date.rpy:230
translate russian ayesha_date_waterpark_male_9111472b:
    "Мальчишка" "Я... я думаю, он это имеет в виду!"

# ch/ayesha/date.rpy:231
translate russian ayesha_date_waterpark_male_1a333d25:
    "Другой мальчишка" "Да ну нафиг, я не собираюсь влезать в драку, чтобы тебя спасать!"

# ch/ayesha/date.rpy:233
translate russian ayesha_date_waterpark_male_51f31174:
    "И тут же они разворачиваются и убегают, оставляя Аишу и меня одних снова."

# ch/ayesha/date.rpy:235
translate russian ayesha_date_waterpark_male_1c913973:
    "Я поворачиваюсь к Аише, только сейчас осознавая, что все еще стою в своей лучшей позе борца."

# ch/ayesha/date.rpy:237
translate russian ayesha_date_waterpark_male_2d28a75a:
    ayesha.say "Отлично, [lssb_ayesha.hero_name()]."

# ch/ayesha/date.rpy:238
translate russian ayesha_date_waterpark_male_4ba3a9a4:
    ayesha.say "Ты действительно напугал этих ребят из начальной школы!"

# ch/ayesha/date.rpy:239
translate russian ayesha_date_waterpark_male_b3490c89:
    "Сбросив позу и пытаясь отмахнуться от всего этого, я начинаю извиняться."

# ch/ayesha/date.rpy:240
translate russian ayesha_date_waterpark_male_5348c4ba:
    mike.say "Прости меня, Аиша."

# ch/ayesha/date.rpy:241
translate russian ayesha_date_waterpark_male_8c92eff3:
    mike.say "Я пытался сохранить... что это, \"кайтейб\"?"

# ch/ayesha/date.rpy:242
translate russian ayesha_date_waterpark_male_bc1a02f5:
    "Она смеется и качает головой, ее улыбка успокаивает меня, показывая, что она не очень сердится."

# ch/ayesha/date.rpy:243
translate russian ayesha_date_waterpark_male_8898b6c0:
    ayesha.say "Всё хорошо, [lssb_ayesha.hero_name()], я знаю, ты хотел как лучше."

# ch/ayesha/date.rpy:245
translate russian ayesha_date_waterpark_male_f918aef8:
    ayesha.say "Мне, кстати, даже понравилось, когда ты назвал меня своим партнером по команде."

# ch/ayesha/date.rpy:246
translate russian ayesha_date_waterpark_male_c5f228a7:
    ayesha.say "Это было мило... даже романтично, пусть и немного по-гиковски!"

# ch/ayesha/date.rpy:248
translate russian ayesha_date_waterpark_male_4d98df11:
    "Теперь, когда угроза нашему веселью устранена, Аиша и я стараемся вернуться к тому, чем занимались до этого."

# ch/ayesha/date.rpy:250
translate russian ayesha_date_waterpark_male_51f97f16:
    "Сначала это кажется немного неловким и неестественным, но вскоре атмосфера снова начинает становиться более легкой."

# ch/ayesha/date.rpy:251
translate russian ayesha_date_waterpark_male_a599e2dc:
    "Вскоре почти создается впечатление, что этот инцидент вообще не происходил, и мы снова наслаждаемся общением."

# ch/ayesha/date.rpy:257
translate russian ayesha_date_waterpark_male_9763a9d3:
    ayesha.say "В аквапарк, значит?"

# ch/ayesha/date.rpy:258
translate russian ayesha_date_waterpark_male_36b76d42:
    ayesha.say "Придётся откопать купальник, который ещё налезет на наш животик, [lssb_ayesha.hero_name()]!"

# ch/ayesha/date.rpy:260
translate russian ayesha_date_waterpark_male_7cd2ff57:
    ayesha.say "Ну... про аквапарк?"

# ch/ayesha/date.rpy:261
translate russian ayesha_date_waterpark_male_378ed7d1:
    ayesha.say "Я... наверное, мне стоит достать свой купальник!"

# ch/ayesha/date.rpy:267
translate russian ayesha_date_park_male_ce5b4870:
    "Клянусь, что причина, по которой я решил сегодня погулять с Аишей в парке, была исключительно хорошая погода, и ничто больше."

# ch/ayesha/date.rpy:268
translate russian ayesha_date_park_male_d40e5f00:
    "Достаточно было быстро взглянуть в окно этим утром, чтобы увидеть, что будет ясный день с безоблачным голубым небом."

# ch/ayesha/date.rpy:269
translate russian ayesha_date_park_male_d335d13c:
    "Что может быть лучше, чем провести пару часов, гуляя по парку, наслаждаясь видами, звуками и ароматами природы?"

# ch/ayesha/date.rpy:270
translate russian ayesha_date_park_male_852440bc:
    "Это ни имеет никакого отношения к тому факту, что я проверил свой банковский счет, прежде чем выглянул в окно, и чуть не потерял сознание."

# ch/ayesha/date.rpy:271
translate russian ayesha_date_park_male_7afb48c0:
    "Ладно, ладно, признаю: в последнее время я, возможно, слегка разошёлся с тратами."

# ch/ayesha/date.rpy:272
translate russian ayesha_date_park_male_2121490a:
    "Но тот факт, что мне нужно быть более экономным до зарплаты, не делает парк плохим вариантом."

# ch/ayesha/date.rpy:273
translate russian ayesha_date_park_male_30b07741:
    "Может, и дешёвое, но неплохое!"

# ch/ayesha/date.rpy:274
translate russian ayesha_date_park_male_8b8127f5:
    "В любом случае, Аиша вроде бы не против этой идеи, когда я звоню ей и предлагаю."

# ch/ayesha/date.rpy:276
translate russian ayesha_date_park_male_2d807991:
    mike.say "Привет, Аиша."

# ch/ayesha/date.rpy:277
translate russian ayesha_date_park_male_b3970fd1:
    ayesha.say "Привет, [lssb_ayesha.hero_name()]."

# ch/ayesha/date.rpy:278
translate russian ayesha_date_park_male_c3567dea:
    ayesha.say "Итак, куда мы сегодня идем на свидание?"

# ch/ayesha/date.rpy:279
translate russian ayesha_date_park_male_1d5e9d6e:
    mike.say "Я думал, может быть, мы могли бы погулять в парке?"

# ch/ayesha/date.rpy:280
translate russian ayesha_date_park_male_be6f4768:
    mike.say "Я знаю, это не совсем американские горки."

# ch/ayesha/date.rpy:281
translate russian ayesha_date_park_male_c290eeee:
    mike.say "Но сегодня довольно хорошая погода, правда?"

# ch/ayesha/date.rpy:283
translate russian ayesha_date_park_male_28bfac67:
    ayesha.say "Не переживай, [lssb_ayesha.hero_name()]."

# ch/ayesha/date.rpy:284
translate russian ayesha_date_park_male_09c75f84:
    ayesha.say "Прогулка – это отличная идея."

# ch/ayesha/date.rpy:285
translate russian ayesha_date_park_male_f6cd673f:
    ayesha.say "Мы сможем провести время на природе и одновременно заняться спортом."

# ch/ayesha/date.rpy:286
translate russian ayesha_date_park_male_0727c385:
    ayesha.say "Кто знает, может быть, даже будет романтично!"

# ch/ayesha/date.rpy:287
translate russian ayesha_date_park_male_82bd4e47:
    "Я заканчиваю разговор, чувствуя легкое волнение от мысли, что Аише понравилась моя идея."

# ch/ayesha/date.rpy:288
translate russian ayesha_date_park_male_e112b48d:
    "Знаю, глупо, но от мысли, что ей это тоже нравится, я нервничаю куда сильнее, чем следовало бы."

# ch/ayesha/date.rpy:289
translate russian ayesha_date_park_male_781d3bc8:
    "Я гулял по парку с несколькими девушками раньше и не придавал этому особого значения."

# ch/ayesha/date.rpy:291
translate russian ayesha_date_park_male_232f7884:
    "Но почему-то с такой девушкой, как Айша, даже привычные вещи кажутся новыми и весьма волнующими."

# ch/ayesha/date.rpy:292
translate russian ayesha_date_park_male_31e6e796:
    "Вот почему я спешу в парк, очень желая быть там вовремя."

# ch/ayesha/date.rpy:293
translate russian ayesha_date_park_male_1ba8afa5:
    "И в своей спешке я прихожу туда чуть раньше и вынужден ждать, будучи единственным собеседником самому себе."

# ch/ayesha/date.rpy:294
translate russian ayesha_date_park_male_23f2ab08:
    "Я начинаю ходить взад-вперед, почти убеждаясь, что меня ждет разочарование."

# ch/ayesha/date.rpy:295
translate russian ayesha_date_park_male_17d86bbf:
    "Но тут я вижу, как Аиша идет ко мне, и я внезапно вспоминаю, что опоздал, а она пришла точно вовремя."

# ch/ayesha/date.rpy:296
translate russian ayesha_date_park_male_ce368024:
    "Я улыбаюсь, подходя к ней, но замечаю, что она оглядывается по сторонам."

# ch/ayesha/date.rpy:297
translate russian ayesha_date_park_male_37ddbf5a:
    mike.say "Айша, что случилось?"

# ch/ayesha/date.rpy:298
translate russian ayesha_date_park_male_be8e6a86:
    mike.say "Что ты ищешь?"

# ch/ayesha/date.rpy:299
translate russian ayesha_date_park_male_b9090b89:
    "Аиша смотрит на меня с легким удивлением в глазах."

# ch/ayesha/date.rpy:300
translate russian ayesha_date_park_male_6e1f5665:
    "Как будто я выдернул ее из размышлений и вернул в реальность."

# ch/ayesha/date.rpy:301
translate russian ayesha_date_park_male_add6f7b3:
    ayesha.say "Что...?"

# ch/ayesha/date.rpy:302
translate russian ayesha_date_park_male_af06f871:
    ayesha.say "Ой, нет... это совсем ничего, правда."

# ch/ayesha/date.rpy:303
translate russian ayesha_date_park_male_032851d4:
    mike.say "Ты уверена?"

# ch/ayesha/date.rpy:304
translate russian ayesha_date_park_male_cd2705e2:
    mike.say "Потому что мы всегда можем пойти куда-нибудь еще, если у тебя есть сомнения насчет этого места."

# ch/ayesha/date.rpy:305
translate russian ayesha_date_park_male_b40f7361:
    mike.say "Или ты просто не хочешь проводить время со мной?"

# ch/ayesha/date.rpy:306
translate russian ayesha_date_park_male_476baef5:
    ayesha.say "Нет, [lssb_ayesha.hero_name()], я же сказала, всё хорошо."

# ch/ayesha/date.rpy:308
translate russian ayesha_date_park_male_b59d905a:
    ayesha.say "Просто я давно здесь не была."

# ch/ayesha/date.rpy:309
translate russian ayesha_date_park_male_94f57a6a:
    ayesha.say "И похоже, что с тех пор кое-что изменилось."

# ch/ayesha/date.rpy:310
translate russian ayesha_date_park_male_b618fb80:
    "Я решаю принять объяснение Аиши таким, какое оно есть, и не хочу углубляться в детали."

# ch/ayesha/date.rpy:311
translate russian ayesha_date_park_male_2aee1d0f:
    "Да, это не очень логично, но лучше, чем оказаться брошенным, верно?"

# ch/ayesha/date.rpy:312
translate russian ayesha_date_park_male_e9fa1efd:
    "Поэтому я протягиваю руку, чтобы взять ее за руку, и мы начинаем нашу прогулку."

# ch/ayesha/date.rpy:313
translate russian ayesha_date_park_male_5344f432:
    "К моему облегчению, Аиша довольно быстро выходит из этого странного состояния."

# ch/ayesha/date.rpy:315
translate russian ayesha_date_park_male_3b86d475:
    "В парке много всего приятного, что можно увидеть, и вокруг нас слышен шум других людей, которые тоже отдыхают."

# ch/ayesha/date.rpy:316
translate russian ayesha_date_park_male_0a670ee4:
    "Даже когда нам приходится уворачиваться от велосипедистов и бегунов, мы просто смеемся и продолжаем наш путь."

# ch/ayesha/date.rpy:317
translate russian ayesha_date_park_male_6ba11ae5:
    "Только когда мы доходим до места, где парк представляет собой в основном луга, все начинает меняться."

# ch/ayesha/date.rpy:318
translate russian ayesha_date_park_male_2b750606:
    "Сначала я слышу лишь смутное эхо чьего-то крика вдалеке."

# ch/ayesha/date.rpy:319
translate russian ayesha_date_park_male_8b72727a:
    "Но вскоре шум становится громче, и источник этого шума быстро приближается к нам."

# ch/ayesha/date.rpy:320
translate russian ayesha_date_park_male_32a41127:
    "Вскоре я начинаю различать, что именно кричат, и это одно и то же слово, повторяющееся снова и снова."

# ch/ayesha/date.rpy:321
translate russian ayesha_date_park_male_d30ba8ca:
    "Хозяин собаки" "ЦЕЗАР... ЦЕЗАР... ЦЕЗАР!!!"

# ch/ayesha/date.rpy:322
translate russian ayesha_date_park_male_59415851:
    "В тот же момент Айша и я поворачиваем головы в направлении крика."

# ch/ayesha/date.rpy:323
translate russian ayesha_date_park_male_3ce124d8:
    "И тут мы его видим: существо, больше похожее на маленького пони, чем на собаку."

# ch/ayesha/date.rpy:324
translate russian ayesha_date_park_male_bda0efe4:
    "В глазах у него безумие, брыли развеваются на ветру, и несётся он прямо на нас."

# ch/ayesha/date.rpy:325
translate russian ayesha_date_park_male_b9da4d37:
    "Только вид ошейника и бирки с именем убеждают меня в том, что это действительно домашнее животное, а не какое-то чудовище из ада!"

# ch/ayesha/date.rpy:326
translate russian ayesha_date_park_male_069bd5aa:
    "Айша и я замираем на месте, всего в нескольких моментах от того, как это существо сократит расстояние между нами."

# ch/ayesha/date.rpy:328
translate russian ayesha_date_park_male_f23ae755:
    "Я понимаю, что нужно срочно что-то делать. Но что?!"

# ch/ayesha/date.rpy:330
translate russian ayesha_date_park_male_ecc05545:
    mike.say "А-а-аргх!"

# ch/ayesha/date.rpy:332
translate russian ayesha_date_park_male_b97d17c3:
    mike.say "Айша, спаси меня!"

# ch/ayesha/date.rpy:333
translate russian ayesha_date_park_male_fd202270:
    "И с этими совершенно трусливыми словами, сорвавшимися с моих уст, я прыгаю к своей девушке."

# ch/ayesha/date.rpy:334
translate russian ayesha_date_park_male_b29edb36:
    "Айша, будучи полностью застигнутой врасплох, ловит меня, когда я обнимаю ее за шею."

# ch/ayesha/date.rpy:335
translate russian ayesha_date_park_male_86c50a82:
    "Это означает, что когда эта скачущая, слюнявящаяся собака появляется на месте, я оказываюсь в ее объятиях."

# ch/ayesha/date.rpy:336
translate russian ayesha_date_park_male_555f0c81:
    "Затем она издает серию рычащих лаев и пытается подпрыгнуть к Айше."

# ch/ayesha/date.rpy:337
translate russian ayesha_date_park_male_2026e5f9:
    "Все это лишь заставляет меня крепче прижиматься к ней."

# ch/ayesha/date.rpy:338
translate russian ayesha_date_park_male_19b6b166:
    "Через мгновение хозяйка этой собаки, кажется, бежит следом за ней."

# ch/ayesha/date.rpy:339
translate russian ayesha_date_park_male_ce6dbf13:
    "Хозяин собаки" "Простите, простите."

# ch/ayesha/date.rpy:340
translate russian ayesha_date_park_male_ca3f1578:
    "Хозяин собаки" "Он на самом деле безобиден."

# ch/ayesha/date.rpy:341
translate russian ayesha_date_park_male_ea8cde71:
    "Хозяин собаки" "Извините, что он напугал твоего сына..."

# ch/ayesha/date.rpy:342
translate russian ayesha_date_park_male_5693b333:
    "Слова затихают, становится понятно, что я не ребенок, а взрослый мужчина."

# ch/ayesha/date.rpy:343
translate russian ayesha_date_park_male_7002d852:
    "Пробормотав что-то, чего я не могу разобрать, хозяин оставляет собаку на поводке и быстро уходит."

# ch/ayesha/date.rpy:345
translate russian ayesha_date_park_male_7818f429:
    ayesha.say "[lssb_ayesha.hero_name()]."

# ch/ayesha/date.rpy:346
translate russian ayesha_date_park_male_d6c590e1:
    mike.say "Да, Айша?"

# ch/ayesha/date.rpy:347
translate russian ayesha_date_park_male_8b2be2fe:
    ayesha.say "Собака уже ушла, хорошо?"

# ch/ayesha/date.rpy:348
translate russian ayesha_date_park_male_8378c8d5:
    mike.say "Да, Айша."

# ch/ayesha/date.rpy:350
translate russian ayesha_date_park_male_c486a90f:
    ayesha.say "Так я сейчас тебя опущу, хорошо?"

# ch/ayesha/date.rpy:351
translate russian ayesha_date_park_male_8378c8d5_1:
    mike.say "Да, Айша."

# ch/ayesha/date.rpy:352
translate russian ayesha_date_park_male_103658f0:
    "Медленно и очень осторожно, Айша опускает меня на ноги перед собой."

# ch/ayesha/date.rpy:353
translate russian ayesha_date_park_male_32f75581:
    "Но лучшее, что я могу сделать, чтобы объяснить себя – это глупо улыбнуться, а потом пожать плечами."

# ch/ayesha/date.rpy:354
translate russian ayesha_date_park_male_79d64c42:
    mike.say "Я...я всегда боялся собак."

# ch/ayesha/date.rpy:355
translate russian ayesha_date_park_male_60b0eaf7:
    mike.say "Знаю, глупо, но вот так."

# ch/ayesha/date.rpy:357
translate russian ayesha_date_park_male_5916d2b5:
    ayesha.say "Что, всех собак?"

# ch/ayesha/date.rpy:358
translate russian ayesha_date_park_male_fe5593cd:
    mike.say "Нет, конечно! Ты серьёзно думаешь, что я боюсь чихуахуа?!"

# ch/ayesha/date.rpy:359
translate russian ayesha_date_park_male_2b383f15:
    ayesha.say "Не знаю, [lssb_ayesha.hero_name()]."

# ch/ayesha/date.rpy:361
translate russian ayesha_date_park_male_fc45373b:
    ayesha.say "Это ты только что прыгнул ко мне на руки!"

# ch/ayesha/date.rpy:362
translate russian ayesha_date_park_male_819a0d0e:
    mike.say "Ну, эта штука была огромной."

# ch/ayesha/date.rpy:363
translate russian ayesha_date_park_male_b4ebe533:
    mike.say "На нее можно было бы седло надеть и выдать за лошадь!"

# ch/ayesha/date.rpy:364
translate russian ayesha_date_park_male_9f0353fb:
    "Аиша качает головой, явно развлеченная как моей выходкой, так и моими оправданиями."

# ch/ayesha/date.rpy:365
translate russian ayesha_date_park_male_04b8198c:
    ayesha.say "Ладно, [lssb_ayesha.hero_name()], ладно."

# ch/ayesha/date.rpy:366
translate russian ayesha_date_park_male_6947aa58:
    ayesha.say "Это не делает тебя менее мужественным!"

# ch/ayesha/date.rpy:367
translate russian ayesha_date_park_male_5ce30910:
    "Мы снова отправились на прогулку, и когда тема сменилась, я начал чувствовать себя менее неловко."

# ch/ayesha/date.rpy:368
translate russian ayesha_date_park_male_acadf131:
    "Наверное, это было довольно смешно – парень бросается в объятия девушки."

# ch/ayesha/date.rpy:369
translate russian ayesha_date_park_male_e571887c:
    "Я просто надеюсь, что это не значит, что Аиша потеряла ко мне какое-то уважение..."

# ch/ayesha/date.rpy:372
translate russian ayesha_date_park_male_9365beb3:
    "Не говоря ни слова, я встал между Аишей и приближающейся собакой."

# ch/ayesha/date.rpy:373
translate russian ayesha_date_park_male_8d152d83:
    "Я опускаюсь на колени, расставляя ноги и вытягивая руки навстречу ей."

# ch/ayesha/date.rpy:374
translate russian ayesha_date_park_male_a713ee74:
    "Это означает, что когда эта прыгающая, слюнявящаяся собака появляется, я оказываюсь прямо у нее на пути."

# ch/ayesha/date.rpy:375
translate russian ayesha_date_park_male_5a89299b:
    "Она начинает издавать серию рычащих лаев и подпрыгивает ко мне."

# ch/ayesha/date.rpy:377
translate russian ayesha_date_park_male_9f1e7a38:
    "И в следующий миг он врезается в меня, словно товарный поезд на полном ходу."

# ch/ayesha/date.rpy:378
translate russian ayesha_date_park_male_cb077d60:
    "От удара меня сносит с ног, и я оказываюсь на земле под ним."

# ch/ayesha/date.rpy:379
translate russian ayesha_date_park_male_e63ca13a:
    "Обернув руками его грудь, я переворачиваю собаку на спину."

# ch/ayesha/date.rpy:380
translate russian ayesha_date_park_male_7d75177b:
    "А затем я снова начинаю движения, проводя обеими руками по его животу."

# ch/ayesha/date.rpy:381
translate russian ayesha_date_park_male_a7705f01:
    ayesha.say "[lssb_ayesha.hero_name()]!"

# ch/ayesha/date.rpy:382
translate russian ayesha_date_park_male_461a7a29:
    ayesha.say "Боже мой!"

# ch/ayesha/date.rpy:384
translate russian ayesha_date_park_male_e38dad57:
    ayesha.say "Кто-нибудь, помогите ему!"

# ch/ayesha/date.rpy:385
translate russian ayesha_date_park_male_c4892158:
    "Услышав ее испуганный голос, я бросаю взгляд на Ayesha."

# ch/ayesha/date.rpy:386
translate russian ayesha_date_park_male_ea62b629:
    mike.say "Все в порядке, Ayesha."

# ch/ayesha/date.rpy:387
translate russian ayesha_date_park_male_e14bbedc:
    mike.say "Он просто хотел, чтобы его почесали животик."

# ch/ayesha/date.rpy:389
translate russian ayesha_date_park_male_dc7070b0:
    mike.say "Видишь?"

# ch/ayesha/date.rpy:390
translate russian ayesha_date_park_male_5edca4dd:
    "Я киваю головой в сторону собаки, которая теперь лежит на спине, с лапами вверх."

# ch/ayesha/date.rpy:391
translate russian ayesha_date_park_male_1efea365:
    "У него высунут язык, и он смотрит на меня с блаженным счастьем."

# ch/ayesha/date.rpy:392
translate russian ayesha_date_park_male_19b6b166_1:
    "Через мгновение хозяйка этой собаки, кажется, бежит следом за ней."

# ch/ayesha/date.rpy:393
translate russian ayesha_date_park_male_ce6dbf13_1:
    "Хозяин собаки" "Простите, простите."

# ch/ayesha/date.rpy:394
translate russian ayesha_date_park_male_ca3f1578_1:
    "Хозяин собаки" "Он совсем безобидный, правда."

# ch/ayesha/date.rpy:395
translate russian ayesha_date_park_male_bc05eb9c:
    "Я киваю и улыбаюсь, вставая на ноги."

# ch/ayesha/date.rpy:396
translate russian ayesha_date_park_male_4557a92a:
    mike.say "Не волнуйся."

# ch/ayesha/date.rpy:397
translate russian ayesha_date_park_male_e8b3b2a0:
    mike.say "Я вырос рядом с такими же псами, как он."

# ch/ayesha/date.rpy:398
translate russian ayesha_date_park_male_ecefac72:
    mike.say "Да, выглядят они страшно, но в душе это просто переросшие щенки!"

# ch/ayesha/date.rpy:399
translate russian ayesha_date_park_male_3b84727d:
    "Хозяйка благодарно кивает, рада, что ее не упрекали за то, что она не смогла держать собаку на поводке."

# ch/ayesha/date.rpy:400
translate russian ayesha_date_park_male_6d85aeda:
    "И как только собака снова оказывается на поводке, ее с трудом оттаскивают хозяин."

# ch/ayesha/date.rpy:401
translate russian ayesha_date_park_male_49e64b28:
    "Только тогда я обращаю внимание на Аишу и замечаю искренний страх в ее глазах."

# ch/ayesha/date.rpy:402
translate russian ayesha_date_park_male_200a50c9:
    mike.say "Боже, Аиша..."

# ch/ayesha/date.rpy:403
translate russian ayesha_date_park_male_c633af0c:
    mike.say "Ты в порядке?"

# ch/ayesha/date.rpy:404
translate russian ayesha_date_park_male_6e70f535:
    "Мне никогда не приходило в голову, что такая физически сильная девушка может бояться собак."

# ch/ayesha/date.rpy:405
translate russian ayesha_date_park_male_6e03c615:
    "Но когда я подхожу к ней, я вижу, что она действительно дрожит от страха."

# ch/ayesha/date.rpy:406
translate russian ayesha_date_park_male_7b36d039:
    ayesha.say "Я...я думала, он нападет на меня!"

# ch/ayesha/date.rpy:408
translate russian ayesha_date_park_male_40635368:
    ayesha.say "Н-но ты его остановил, [lssb_ayesha.hero_name()], ты меня спас!"

# ch/ayesha/date.rpy:409
translate russian ayesha_date_park_male_3f13c473:
    "Я осторожно обнимаю Аишу, пытаясь ее успокоить."

# ch/ayesha/date.rpy:410
translate russian ayesha_date_park_male_1c9a0554:
    mike.say "Эй, эй, все в порядке, Аиша."

# ch/ayesha/date.rpy:411
translate russian ayesha_date_park_male_bc3dfc50:
    mike.say "Да, вид у него грозный, но он просто хотел поиграть, вот и всё."

# ch/ayesha/date.rpy:412
translate russian ayesha_date_park_male_7e1af731:
    "Она кивает, но я вижу, что она не уверена."

# ch/ayesha/date.rpy:413
translate russian ayesha_date_park_male_b8f0684a:
    ayesha.say "Была собака...когда я была маленькой."

# ch/ayesha/date.rpy:414
translate russian ayesha_date_park_male_f2a48e2e:
    ayesha.say "Мы каждый день проходили мимо него, по дороге в школу и обратно."

# ch/ayesha/date.rpy:415
translate russian ayesha_date_park_male_cdb81254:
    ayesha.say "Он бы сходил с ума, дергаясь за свою цепь."

# ch/ayesha/date.rpy:416
translate russian ayesha_date_park_male_e58e6b6c:
    ayesha.say "И однажды цепь сломалась."

# ch/ayesha/date.rpy:418
translate russian ayesha_date_park_male_93374b1e:
    ayesha.say "И... и это коснулось меня..."

# ch/ayesha/date.rpy:419
translate russian ayesha_date_park_male_7dbea07d:
    ayesha.say "Я пыталась убежать... но это коснулось меня..."

# ch/ayesha/date.rpy:420
translate russian ayesha_date_park_male_bc767e90:
    "Не говоря ни слова, я притягиваю её как можно ближе к себе."

# ch/ayesha/date.rpy:421
translate russian ayesha_date_park_male_672db7dd:
    "Она отвечает на объятия, и эти сильные руки кажутся совсем не такими, какими они есть на самом деле."

# ch/ayesha/date.rpy:422
translate russian ayesha_date_park_male_0dd104aa:
    mike.say "Не волнуйся, Аиша."

# ch/ayesha/date.rpy:423
translate russian ayesha_date_park_male_31b5dc75:
    mike.say "Я не позволю этому случиться с тобой."

# ch/ayesha/date.rpy:424
translate russian ayesha_date_park_male_92774d07:
    mike.say "Пока я рядом с тобой."

# ch/ayesha/date.rpy:425
translate russian ayesha_date_park_male_eb7222c7:
    "Аиша остается в моих объятиях еще несколько минут."

# ch/ayesha/date.rpy:426
translate russian ayesha_date_park_male_3a7b36b1:
    "Затем, кажется, она приходит в себя настолько, что может продолжить нашу прогулку по парку."

# ch/ayesha/date.rpy:428
translate russian ayesha_date_park_male_ff1d6718:
    "Но все это время она крепко держится за мою руку, почти прислоняя голову к моему плечу."

# ch/ayesha/date.rpy:429
translate russian ayesha_date_park_male_7e2bfbcd:
    "Хотя у меня есть ощущение, что это не только из-за страха повторения того же события."

# ch/ayesha/date.rpy:430
translate russian ayesha_date_park_male_cb914a9a:
    "Я не могу не думать, что часть этого связана с тем, что теперь она видит во мне своего рода защитника."

# ch/ayesha/date.rpy:431
translate russian ayesha_date_park_male_ed423460:
    "Возможно, даже живой талисман против некоторых из ее самых страшных страхов..."

# ch/ayesha/date.rpy:438
translate russian ayesha_date_park_male_5066f975:
    ayesha.say "Неспешно погулять на свежем воздухе — сейчас именно то, что нужно, [lssb_ayesha.hero_name()]."

# ch/ayesha/date.rpy:439
translate russian ayesha_date_park_male_7a0db3e4:
    ayesha.say "Нам с малышом обоим полезно размяться."

# ch/ayesha/date.rpy:441
translate russian ayesha_date_park_male_87d80cf6:
    ayesha.say "Куда захочешь, туда и пойдём, [lssb_ayesha.hero_name()]. Сегодня я с удовольствием пойду за тобой."

# ch/ayesha/date.rpy:442
translate russian ayesha_date_park_male_2b681e4f:
    ayesha.say "Приятно для разнообразия позволить кому-то другому выбрать дорогу."

# ch/ayesha/date.rpy:444
translate russian ayesha_date_park_male_b08756f3:
    ayesha.say "Знаешь, я давно здесь не была."

# ch/ayesha/date.rpy:445
translate russian ayesha_date_park_male_19ed22c5:
    ayesha.say "Спасибо, [lssb_ayesha.hero_name()], это было отличная идея."

# ch/ayesha/date.rpy:451
translate russian ayesha_date_livingroom_male_831be3d9:
    "Я прекрасно понимаю, что приглашать девушку к себе домой – это одна из тех вещей, которые просто нужно делать."

# ch/ayesha/date.rpy:452
translate russian ayesha_date_livingroom_male_78b767b1:
    "Это такая банальность в современных отношениях, что большинство людей даже не задумаются, прежде чем предложить это и затем воплотить это в жизнь."

# ch/ayesha/date.rpy:453
translate russian ayesha_date_livingroom_male_61c419af:
    "Но я, будучи тем, кто я есть, не могу удержаться от того, чтобы слишком много думать обо всем сразу после того, как предлагаю это Айше, и она соглашается."

# ch/ayesha/date.rpy:454
translate russian ayesha_date_livingroom_male_77c811d5:
    "Я пытаюсь успокоиться, рационализируя все, сводя этот вечер к самым необходимым элементам."

# ch/ayesha/date.rpy:455
translate russian ayesha_date_livingroom_male_e8d9a799:
    "В конце концов, это просто означает, что Айша придет ко мне, и мы проведем время вместе, смотря что-нибудь по телевизору."

# ch/ayesha/date.rpy:456
translate russian ayesha_date_livingroom_male_6b5e3869:
    "Но потом я понимаю, что это значит, что она впервые войдет в мой дом."

# ch/ayesha/date.rpy:457
translate russian ayesha_date_livingroom_male_a326309d:
    "Что, если ей не понравится то, что она увидит?"

# ch/ayesha/date.rpy:458
translate russian ayesha_date_livingroom_male_5f4b3417:
    "Что, если это заставит ее подумать, что это отражение меня?"

# ch/ayesha/date.rpy:459
translate russian ayesha_date_livingroom_male_4e6467fb:
    "Нет... Я должен перестать драматизировать то, что должно быть просто возможностью провести время с Айшей."

# ch/ayesha/date.rpy:460
translate russian ayesha_date_livingroom_male_57d5d2d4:
    "Она придёт, мы вместе поваляемся на диване, и нам обоим будет хорошо. Вот и всё."

# ch/ayesha/date.rpy:461
translate russian ayesha_date_livingroom_male_0a6c8c6d:
    "Стоит ли говорить, что, открывая дверь, я весь как на иголках."

# ch/ayesha/date.rpy:462
translate russian ayesha_date_livingroom_male_31b12b93:
    "Когда я провожу ее в гостиную, я замечаю, что Айша с интересом осматривается."

# ch/ayesha/date.rpy:464
translate russian ayesha_date_livingroom_male_847c82bb:
    ayesha.say "Здесь очень приятный район, [lssb_ayesha.hero_name()]."

# ch/ayesha/date.rpy:465
translate russian ayesha_date_livingroom_male_074f406d:
    ayesha.say "Должна быть тихая жизнь, живя здесь, да?"

# ch/ayesha/date.rpy:466
translate russian ayesha_date_livingroom_male_9f8c9280:
    "Что она имеет в виду?"

# ch/ayesha/date.rpy:467
translate russian ayesha_date_livingroom_male_3e3ba117:
    "Она пытается сказать, что я скучный?"

# ch/ayesha/date.rpy:468
translate russian ayesha_date_livingroom_male_553cabce:
    "Нет, конечно, она просто говорит то, что думает."

# ch/ayesha/date.rpy:469
translate russian ayesha_date_livingroom_male_9823d834:
    "В конце концов, это хороший район."

# ch/ayesha/date.rpy:470
translate russian ayesha_date_livingroom_male_d0aa3d37:
    mike.say "Похоже на то, Аyesha."

# ch/ayesha/date.rpy:471
translate russian ayesha_date_livingroom_male_0d6e0ef0:
    mike.say "Я никогда особо об этом не задумывался."

# ch/ayesha/date.rpy:472
translate russian ayesha_date_livingroom_male_be1b2652:
    mike.say "В городе, где я вырос, было довольно малолюдно, поэтому большинство мест были похожи на это."

# ch/ayesha/date.rpy:473
translate russian ayesha_date_livingroom_male_512592e1:
    "Аиша кивает, когда мы садимся на диван."

# ch/ayesha/date.rpy:474
translate russian ayesha_date_livingroom_male_6972c2e5:
    ayesha.say "Это звучит как место, которое стоит посетить."

# ch/ayesha/date.rpy:475
translate russian ayesha_date_livingroom_male_2ccc2624:
    ayesha.say "Кто знает, может быть, ты сможешь показать мне его как-нибудь?"

# ch/ayesha/date.rpy:476
translate russian ayesha_date_livingroom_male_4e678801:
    ayesha.say "Район, где я выросла, был немного более... неблагополучным."

# ch/ayesha/date.rpy:477
translate russian ayesha_date_livingroom_male_f83e48ce:
    "На мгновение мне кажется, что Аиша вот-вот продолжит разговор на эту тему."

# ch/ayesha/date.rpy:478
translate russian ayesha_date_livingroom_male_9f1d2333:
    "Но потом она улыбается и качает головой, закрывая возможность заглянуть в ее прошлое."

# ch/ayesha/date.rpy:479
translate russian ayesha_date_livingroom_male_16b7f91c:
    ayesha.say "Но ты ведь не хочешь говорить о моем детстве."

# ch/ayesha/date.rpy:481
translate russian ayesha_date_livingroom_male_ea3bdc12:
    ayesha.say "Ведь нам же должно быть весело вместе!"

# ch/ayesha/date.rpy:482
translate russian ayesha_date_livingroom_male_7a0dc5f8:
    "Я думаю, стоит сказать Аише, что все в порядке, и побудить ее продолжить то, о чем она собиралась рассказать."

# ch/ayesha/date.rpy:483
translate russian ayesha_date_livingroom_male_25faa87e:
    "Но потом я передумал, подумав, что не стоит давить на нее и заставлять говорить, когда она уже сменила тему."

# ch/ayesha/date.rpy:484
translate russian ayesha_date_livingroom_male_59cdb08a:
    mike.say "Ладно, Айша, как скажешь."

# ch/ayesha/date.rpy:485
translate russian ayesha_date_livingroom_male_14184b84:
    mike.say "Ну, о чем мы говорили?"

# ch/ayesha/date.rpy:488
translate russian ayesha_date_livingroom_male_cbbd9458:
    ayesha.say "Собираешься просто поваляться и посмотреть телевизор?"

# ch/ayesha/date.rpy:489
translate russian ayesha_date_livingroom_male_6fd7eb8f:
    "Я киваю в знак согласия, беру пульт с подлокотника дивана и включаю телевизор."

# ch/ayesha/date.rpy:493
translate russian ayesha_date_livingroom_male_9e15d07a:
    bree.say "О-о, [lssb_ayesha.hero_name()], кто это?!"

# ch/ayesha/date.rpy:495
translate russian ayesha_date_livingroom_male_d0b9eef7:
    sasha.say "Да, [lssb_ayesha.hero_name()], ты же не говорил, что сегодня к тебе придут гости!"

# ch/ayesha/date.rpy:497
translate russian ayesha_date_livingroom_male_baebb96f:
    "Мы с Айшей одновременно оглядываемся, как виноватые дети, пойманные за тем, как они воруют печенье из банки."

# ch/ayesha/date.rpy:498
translate russian ayesha_date_livingroom_male_15e6e852:
    "И я совсем не удивляюсь, увидев [bree.name] и Сашу, выглядывающих из дверного проема."

# ch/ayesha/date.rpy:499
translate russian ayesha_date_livingroom_male_fdbe0c74:
    mike.say "Да, я почти на сто процентов уверен, что говорил об этом."

# ch/ayesha/date.rpy:500
translate russian ayesha_date_livingroom_male_dbd6d5b0:
    mike.say "А ещё, кажется, вы обещали куда-нибудь исчезнуть!"

# ch/ayesha/date.rpy:501
translate russian ayesha_date_livingroom_male_13a0b96a:
    "[bree.name] косится на Сашу, когда они крадутся в комнату."

# ch/ayesha/date.rpy:502
translate russian ayesha_date_livingroom_male_936494a2:
    "Саша просто пожимает плечами и качает головой, полностью игнорируя мои слова."

# ch/ayesha/date.rpy:503
translate russian ayesha_date_livingroom_male_e823d545:
    sasha.say "Если я правильно помню, мы сказали, что уйдем, когда она будет ЗДЕСЬ."

# ch/ayesha/date.rpy:504
translate russian ayesha_date_livingroom_male_2784c9de:
    bree.say "И вот она здесь."

# ch/ayesha/date.rpy:505
translate russian ayesha_date_livingroom_male_782544c0:
    sasha.say "И вот мы, собираемся уходить."

# ch/ayesha/date.rpy:507
translate russian ayesha_date_livingroom_male_4ed24d46:
    bree.say "Да, [lssb_ayesha.hero_name()], мы просто случайно встретили её по дороге!"

# ch/ayesha/date.rpy:508
translate russian ayesha_date_livingroom_male_ce4489f8:
    "Признавая поражение, я закатываю глаза на этих двоих."

# ch/ayesha/date.rpy:509
translate russian ayesha_date_livingroom_male_ee7841a3:
    mike.say "Ну ладно, ты победила!"

# ch/ayesha/date.rpy:512
translate russian ayesha_date_livingroom_male_d195b002:
    mike.say "Аyesha, познакомься, это [bree.name] и Саша."

# ch/ayesha/date.rpy:513
translate russian ayesha_date_livingroom_male_a9f4b071:
    mike.say "Они мои соседки по дому..."

# ch/ayesha/date.rpy:514
translate russian ayesha_date_livingroom_male_db2e43bb:
    "Когда Майк произнес слово \"соседки\", [bree.name] и Саша разразились смехом."

# ch/ayesha/date.rpy:517
translate russian ayesha_date_livingroom_male_54ea8bd4:
    "Действительно, этот приступ смеха кажется им настолько сильным, что они падают на диван."

# ch/ayesha/date.rpy:518
translate russian ayesha_date_livingroom_male_86b50fa3:
    "Одна оказывается по обе стороны от нас."

# ch/ayesha/date.rpy:519
translate russian ayesha_date_livingroom_male_b865971a:
    "И я вижу, как Айша немного отстраняется от этого вторжения в её личное пространство."

# ch/ayesha/date.rpy:521
translate russian ayesha_date_livingroom_male_38b72b6a:
    bree.say "Ой, он просто скромничает, Ayesha."

# ch/ayesha/date.rpy:523
translate russian ayesha_date_livingroom_male_2eba56c7:
    sasha.say "Да, он и правда так говорит, хотя на самом деле мы ГОРАЗДО больше, чем просто соседки!"

# ch/ayesha/date.rpy:525
translate russian ayesha_date_livingroom_male_fced86a2:
    ayesha.say "Эм...что ты имеешь в виду?"

# ch/ayesha/date.rpy:526
translate russian ayesha_date_livingroom_male_9b9910a3:
    bree.say "Ну, смотри, у нас здесь всё общее."

# ch/ayesha/date.rpy:527
translate russian ayesha_date_livingroom_male_38423e1a:
    sasha.say "Счета..."

# ch/ayesha/date.rpy:529
translate russian ayesha_date_livingroom_male_f4c23bb7:
    bree.say "Продукты..."

# ch/ayesha/date.rpy:531
translate russian ayesha_date_livingroom_male_31acf39d:
    sasha.say "И друг друга..."

# ch/ayesha/date.rpy:532
translate russian ayesha_date_livingroom_male_ad23c5cc:
    "Я вижу, как глаза Айши расширяются от удивления."

# ch/ayesha/date.rpy:533
translate russian ayesha_date_livingroom_male_de277229:
    "Но она пытается сохранять спокойствие и не паниковать."

# ch/ayesha/date.rpy:534
translate russian ayesha_date_livingroom_male_4535a95b:
    ayesha.say "Ты... ты такая современная!"

# ch/ayesha/date.rpy:536
translate russian ayesha_date_livingroom_male_795dad65:
    ayesha.say "Настоящая богемка, понимаешь?"

# ch/ayesha/date.rpy:537
translate russian ayesha_date_livingroom_male_e77124d2:
    "[bree.name] и Саша встают с дивана, обе улыбаются, глядя на неловкость Айши."

# ch/ayesha/date.rpy:540
translate russian ayesha_date_livingroom_male_30dac25d:
    bree.say "Ну что, нам пора."

# ch/ayesha/date.rpy:542
translate russian ayesha_date_livingroom_male_488be3ea:
    sasha.say "Ага, но помни, Айша: тебе здесь всегда рады!"

# ch/ayesha/date.rpy:545
translate russian ayesha_date_livingroom_male_e33f25d7:
    "И вот они уходят, оставляя меня разбираться с последствиями того, что они только что сделали."

# ch/ayesha/date.rpy:546
translate russian ayesha_date_livingroom_male_57fedef9:
    mike.say "Прости, Айша, мне стоило сказать тебе об этом раньше."

# ch/ayesha/date.rpy:547
translate russian ayesha_date_livingroom_male_43572808:
    mike.say "Если это изменит наши отношения... я понимаю."

# ch/ayesha/date.rpy:548
translate russian ayesha_date_livingroom_male_768dd26d:
    "К моему удивлению, Айша поворачивается ко мне с улыбкой и качает головой."

# ch/ayesha/date.rpy:550
translate russian ayesha_date_livingroom_male_5409aeb2:
    ayesha.say "Эй, поверь мне, за время моих соревнований по борьбе я видела вещи и похуже."

# ch/ayesha/date.rpy:551
translate russian ayesha_date_livingroom_male_6d9ee67c:
    ayesha.say "И если эти девчонки думают, что смогут меня запугать, они жестоко ошибаются!"

# ch/ayesha/date.rpy:552
translate russian ayesha_date_livingroom_male_06062714:
    "Все, что я могу сделать, это кивнуть, гадая, означает ли это, что Айша присоединится к [bree.name], Саше и мне в ближайшем будущем."

# ch/ayesha/date.rpy:554
translate russian ayesha_date_livingroom_male_d195b002_1:
    mike.say "Айша, познакомься с [bree.name] и Сашей."

# ch/ayesha/date.rpy:555
translate russian ayesha_date_livingroom_male_bc82d185:
    mike.say "Они мои соседки и проклятие всей моей жизни!"

# ch/ayesha/date.rpy:556
translate russian ayesha_date_livingroom_male_ccff5ab5:
    "Айша смеется над моим очевидным раздражением и игриво хлопает меня по плечу."

# ch/ayesha/date.rpy:558
translate russian ayesha_date_livingroom_male_f58e0964:
    ayesha.say "Всё в порядке, [lssb_ayesha.hero_name()]."

# ch/ayesha/date.rpy:559
translate russian ayesha_date_livingroom_male_9897d9ea:
    ayesha.say "Они просто интересуются твоей личной жизнью."

# ch/ayesha/date.rpy:560
translate russian ayesha_date_livingroom_male_8e2a555a:
    ayesha.say "Это мило. Словно у тебя есть две сестры, которые о тебе заботятся!"

# ch/ayesha/date.rpy:561
translate russian ayesha_date_livingroom_male_de14bbcf:
    "Я чувствую, как начинаю краснеть, когда [bree.name] и Саша присоединяются к смеху."

# ch/ayesha/date.rpy:564
translate russian ayesha_date_livingroom_male_8601e22f:
    bree.say "Да, [lssb_ayesha.hero_name()], тебе стоит слушаться своих сестричек!"

# ch/ayesha/date.rpy:565
translate russian ayesha_date_livingroom_male_3bbb2951:
    bree.say "Мы знаем, что лучше для тебя!"

# ch/ayesha/date.rpy:566
translate russian ayesha_date_livingroom_male_66a56420:
    sasha.say "Конечно, мы знаем."

# ch/ayesha/date.rpy:567
translate russian ayesha_date_livingroom_male_e3dd7197:
    sasha.say "И это относится и к тебе, сестра!"

# ch/ayesha/date.rpy:568
translate russian ayesha_date_livingroom_male_ae7b5bab:
    "В этот момент Саша переводит свой взгляд на Айшу."

# ch/ayesha/date.rpy:570
translate russian ayesha_date_livingroom_male_1948fba5:
    sasha.say "Ты обязательно должна присматривать за нашим братом."

# ch/ayesha/date.rpy:571
translate russian ayesha_date_livingroom_male_5a85e51e:
    sasha.say "Иначе будет несладко!"

# ch/ayesha/date.rpy:572
translate russian ayesha_date_livingroom_male_3e883b98:
    "Когда [bree.name] и Саша, наконец, исчезают, Айша качает головой."

# ch/ayesha/date.rpy:575
translate russian ayesha_date_livingroom_male_f1628980:
    ayesha.say "Мне кажется, или это была угроза?"

# ch/ayesha/date.rpy:576
translate russian ayesha_date_livingroom_male_4ae3f5b6:
    mike.say "Почему, Айша?"

# ch/ayesha/date.rpy:577
translate russian ayesha_date_livingroom_male_6203e65b:
    mike.say "Ты боишься их?"

# ch/ayesha/date.rpy:578
translate russian ayesha_date_livingroom_male_f599678f:
    mike.say "Просто будь ко мне добрее, и тебе не придется столкнуться с гневом моих сестер!"

# ch/ayesha/date.rpy:580
translate russian ayesha_date_livingroom_male_e3c9187a:
    "Я беру пульт дистанционного управления в руки и просматриваю доступные варианты."

# ch/ayesha/date.rpy:581
translate russian ayesha_date_livingroom_male_2751b905:
    "Ничего особенно привлекательного нам не попадается, поэтому в конце концов мы выбираем что-то спокойное, чтобы просто расслабиться."

# ch/ayesha/date.rpy:582
translate russian ayesha_date_livingroom_male_6f852954:
    "Сначала мы просто сидим рядом друг с другом, и наши бедра – это почти единственное, к чему прикасаемся."

# ch/ayesha/date.rpy:583
translate russian ayesha_date_livingroom_male_8b8b6402:
    "Но со временем я чувствую, как меняется атмосфера, словно она давит на нас обоих."

# ch/ayesha/date.rpy:584
translate russian ayesha_date_livingroom_male_c2f60b13:
    "Мы сидим здесь одни, в этом заброшенном доме, и ничто не мешает нам."

# ch/ayesha/date.rpy:585
translate russian ayesha_date_livingroom_male_404debaa:
    "Скоро кто-то должен что-то предпринять, иначе это станет просто невыносимым!"

# ch/ayesha/date.rpy:588
translate russian ayesha_date_livingroom_male_29a4ade0:
    "Честно говоря, я не знаю, что удерживает меня от того, чтобы сделать первый шаг."

# ch/ayesha/date.rpy:589
translate russian ayesha_date_livingroom_male_c42684ec:
    "Но мне кажется, что мои конечности вдруг скованы страхом перед риском."

# ch/ayesha/date.rpy:590
translate russian ayesha_date_livingroom_male_c090dcc9:
    "Если я ошибусь, это может стать началом конца для нас!"

# ch/ayesha/date.rpy:591
translate russian ayesha_date_livingroom_male_964fe270:
    "И именно в тот момент, когда я чувствую, как мой разум застревает в таких мыслях, это и происходит."

# ch/ayesha/date.rpy:592
translate russian ayesha_date_livingroom_male_d7327734:
    "Я чувствую, как чьи-то руки хватают меня за голову, поворачивая ее."

# ch/ayesha/date.rpy:593
translate russian ayesha_date_livingroom_male_3fca127e:
    "Прежде чем я успеваю понять, что происходит, я оказываюсь лицом к лицу с Аишей."

# ch/ayesha/date.rpy:594
translate russian ayesha_date_livingroom_male_4c6022e0:
    ayesha.say "Если ты не собираешься этого делать, то сделаю это я!"

# ch/ayesha/date.rpy:598
translate russian ayesha_date_livingroom_male_d629d6e3:
    "И с этими словами она прижимает свои губы к моим."

# ch/ayesha/date.rpy:599
translate russian ayesha_date_livingroom_male_d8930d0a:
    "Сначала я напрягаюсь, что означает, что Аише приходится почти насильно проталкивать свой язык между моими губами."

# ch/ayesha/date.rpy:600
translate russian ayesha_date_livingroom_male_03579fa2:
    "Но она справляется с этим довольно легко, и через мгновение я чувствую, как растворяюсь в этом."

# ch/ayesha/date.rpy:601
translate russian ayesha_date_livingroom_male_6182a8e1:
    "В том, как она берет контроль над ситуацией, есть что-то несомненно возбуждающее."

# ch/ayesha/date.rpy:602
translate russian ayesha_date_livingroom_male_2a1e5d34:
    "Кажется, само осознание того, насколько сильно она хочет меня, вызывает у меня огромный интерес."

# ch/ayesha/date.rpy:604
translate russian ayesha_date_livingroom_male_c33f081b:
    "\"Сейчас или никогда\", – говорю я себе, поворачиваясь лицом к Айше."

# ch/ayesha/date.rpy:605
translate russian ayesha_date_livingroom_male_d6087827:
    "Она смотрит на меня, ожидая увидеть, что я сделаю дальше."

# ch/ayesha/date.rpy:606
translate russian ayesha_date_livingroom_male_e36702d4:
    "И не дожидаясь разрешения, я обхватываю ее щеки руками."

# ch/ayesha/date.rpy:609
translate russian ayesha_date_livingroom_male_52154e7e:
    "Затем я целую ее, страстно и полно, отдавая все свои чувства."

# ch/ayesha/date.rpy:610
translate russian ayesha_date_livingroom_male_ddd389d9:
    "Поцелуй длится недолго, и я заканчиваю его через мгновение, чувствуя себя взволнованным."

# ch/ayesha/date.rpy:613
translate russian ayesha_date_livingroom_male_3bc8b497:
    "Айша остается в том же положении, в котором была, когда я ее поцеловал."

# ch/ayesha/date.rpy:614
translate russian ayesha_date_livingroom_male_61a3a52b:
    "Она смотрит на меня, ее глаза, кажется, все еще где-то далеко, пока они не фокусируются на мне."

# ch/ayesha/date.rpy:615
translate russian ayesha_date_livingroom_male_94800173:
    ayesha.say "О, [lssb_ayesha.hero_name()]..."

# ch/ayesha/date.rpy:616
translate russian ayesha_date_livingroom_male_5ab8903a:
    ayesha.say "Пожалуйста, не останавливайся!"

# ch/ayesha/date.rpy:617
translate russian ayesha_date_livingroom_male_aa8afad2:
    "Ее слова и выражение лица означают, что мне не нужно объяснять дважды."

# ch/ayesha/date.rpy:620
translate russian ayesha_date_livingroom_male_e6a6c619:
    "И через мгновение наши губы снова соприкасаются."

# ch/ayesha/date.rpy:621
translate russian ayesha_date_livingroom_male_4cccdc62:
    "Но на этот раз Айша тоже играет свою роль, и поэтому это становится еще более приятным."

# ch/ayesha/date.rpy:624
translate russian ayesha_date_livingroom_male_720becd3:
    "С этого момента все как будто открылось, и ничто больше не может нас остановить."

# ch/ayesha/date.rpy:625
translate russian ayesha_date_livingroom_male_60aaf91b:
    "Аиша и я превращаемся в клубок переплетенных конечностей и вздымающихся частей тела на диване."

# ch/ayesha/date.rpy:626
translate russian ayesha_date_livingroom_male_96dd5078:
    "Я забываю обо всем на свете, кроме девушки, которая находится у меня на руках."

# ch/ayesha/date.rpy:627
translate russian ayesha_date_livingroom_male_3329beba:
    "Я хочу почувствовать каждый сантиметр тела Аиши, своими руками и губами."

# ch/ayesha/date.rpy:628
translate russian ayesha_date_livingroom_male_8845f7bd:
    "Я встречал женщин самых разных комплекций, но ни одна из них не вызывала таких же чувств, как она."

# ch/ayesha/date.rpy:629
translate russian ayesha_date_livingroom_male_9fe1d938:
    "Мышцы Аиши не делают ее такой твердой, как камень, а скорее гибкой, как у большой кошки."

# ch/ayesha/date.rpy:630
translate russian ayesha_date_livingroom_male_1a34441c:
    "И все, о чем я могу думать, это то, что я так сильно хочу, чтобы этот хищник поймал меня..."

# ch/ayesha/date.rpy:631
translate russian ayesha_date_livingroom_male_c8586729:
    "Сейчас у меня довольно огромная и болезненная эрекция внизу живота."

# ch/ayesha/date.rpy:632
translate russian ayesha_date_livingroom_male_fded6382:
    "Единственное, чего я хочу, – это как можно скорее познакомить Аишу с этим."

# ch/ayesha/date.rpy:633
translate russian ayesha_date_livingroom_male_0ae7640d:
    "Но затем звук ключей в замке разрушает эту атмосферу, и реальность возвращается."

# ch/ayesha/date.rpy:634
translate russian ayesha_date_livingroom_male_f567f5fd:
    "По какой-то причине мы с Аишей отстраняемся друг от друга, как виноватые подростки, пойманные на месте преступления."

# ch/ayesha/date.rpy:635
translate russian ayesha_date_livingroom_male_eb3b2035:
    "Я могу только предположить, что она была так же увлечена этим, как и я, и ее мысли тоже блуждали в том же направлении."

# ch/ayesha/date.rpy:636
translate russian ayesha_date_livingroom_male_bcae88ec:
    "И оказаться пойманными за этим на диване [bree.name] или Сашей было бы довольно неловко."

# ch/ayesha/date.rpy:637
translate russian ayesha_date_livingroom_male_4db4c996:
    ayesha.say "Ого..."

# ch/ayesha/date.rpy:639
translate russian ayesha_date_livingroom_male_784c6732:
    ayesha.say "Ты видела, сколько времени?"

# ch/ayesha/date.rpy:640
translate russian ayesha_date_livingroom_male_47a7314f:
    ayesha.say "Мне действительно пора идти!"

# ch/ayesha/date.rpy:641
translate russian ayesha_date_livingroom_male_f55f891a:
    mike.say "Хорошо, Аиша."

# ch/ayesha/date.rpy:642
translate russian ayesha_date_livingroom_male_2efda1e2:
    mike.say "Если ты так считаешь…"

# ch/ayesha/date.rpy:645
translate russian ayesha_date_livingroom_male_dca31933:
    "Когда я провожу Айшу до двери, нам все еще кажется, что мы ведем себя как застенчивые подростки, порабощенные своими желаниями."

# ch/ayesha/date.rpy:646
translate russian ayesha_date_livingroom_male_6ff65388:
    ayesha.say "Мне было очень приятно, [lssb_ayesha.hero_name()]."

# ch/ayesha/date.rpy:647
translate russian ayesha_date_livingroom_male_cb310865:
    mike.say "Мне тоже!"

# ch/ayesha/date.rpy:648
translate russian ayesha_date_livingroom_male_57748075:
    mike.say "Нам стоит повторить это, и скоро."

# ch/ayesha/date.rpy:650
translate russian ayesha_date_livingroom_male_e90222d7:
    ayesha.say "Да, я бы с удовольствием."

