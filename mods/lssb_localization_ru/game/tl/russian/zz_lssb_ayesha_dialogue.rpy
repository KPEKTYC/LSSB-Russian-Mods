# ch/ayesha/chat.rpy:48
translate russian ayesha_desire_3_male_520ea401:
    ayesha.say "Но мне кажется, я хочу от нашей дружбы большего. Понимаешь, о чём я?"

# ch/ayesha/chat.rpy:50
translate russian ayesha_desire_3_male_b8df705b:
