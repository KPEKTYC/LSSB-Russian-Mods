# ch/harems_full/band/events.rpy:3578
translate russian naked_gig_65d1a4fe:
    anna.say "А..."

# ch/harems_full/band/events.rpy:3579
translate russian naked_gig_5335e1ec:
    anna.say "Тогда чем?"

# ch/harems_full/band/events.rpy:3580
translate russian naked_gig_d6d3d0ee:
    mike.say "Вообще-то, Анна..."

# ch/harems_full/band/events.rpy:3581
translate russian naked_gig_734194b1:
    mike.say "Тобой!"

# ch/harems_full/band/events.rpy:3582
translate russian naked_gig_cd3955df:
    "Перекинув гитару за спину, я подаюсь вперёд."

# ch/harems_full/band/events.rpy:3583
translate russian naked_gig_4606e4bb:
    "К счастью, барабанная установка Анны стоит на возвышении."

# ch/harems_full/band/events.rpy:3585
translate russian naked_gig_6f433e8d:
    "А значит, её задница на идеальной высоте для того, что я задумал."

# ch/harems_full/band/events.rpy:3586
translate russian naked_gig_9229fb22:
    "Головка моего члена упирается прямо между ягодицами Анны."

# ch/harems_full/band/events.rpy:3587
translate russian naked_gig_f57460bb:
    "Она взвизгивает от неожиданности, когда я начинаю продвигаться глубже."

# ch/harems_full/band/events.rpy:3588
translate russian naked_gig_62d482b1:
    anna.say "Ого..."

# ch/harems_full/band/events.rpy:3589
translate russian naked_gig_eda08e50:
    anna.say "Ты что?.."

# ch/harems_full/band/events.rpy:3591
translate russian naked_gig_9b291ac0:
    anna.say "Ты и правда!.."

# ch/harems_full/band/events.rpy:3592
translate russian naked_gig_3f606016:
    "Я чувствую, как Анна уже начинает прижиматься ко мне."

# ch/harems_full/band/events.rpy:3593
translate russian naked_gig_b840b34f:
    "Это даёт понять, что, несмотря на удивление, она тоже хочет."

# ch/harems_full/band/events.rpy:3594
translate russian naked_gig_ed7221c2:
    "И вскоре её тело посылает мне тот же сигнал."

# ch/harems_full/band/events.rpy:3596
translate russian naked_gig_04dc7562:
    "Сначала мышцы задницы Анны сопротивляются моим попыткам войти."

# ch/harems_full/band/events.rpy:3597
translate russian naked_gig_bb81d91c:
    "Но потом я чувствую, как они расслабляются, и постепенно проникаю внутрь."

# ch/harems_full/band/events.rpy:3598
translate russian naked_gig_711f1d0f:
    "Глядя через плечо Анны, я фактически смотрю прямо в зал."

# ch/harems_full/band/events.rpy:3600
translate russian naked_gig_7313ee4d_1:
    "И зрители быстро понимают, что мы делаем."

# ch/harems_full/band/events.rpy:3601
translate russian naked_gig_358ce085_1:
    "Я слышу приветственные крики и скандирование, обращённые прямо к нам и подбадривающие нас."

# ch/harems_full/band/events.rpy:3602
translate russian naked_gig_78a9d072:
    "От этого я начинаю трахать Анну ещё сильнее."

# ch/harems_full/band/events.rpy:3604
translate russian naked_gig_ab92275f:
    "Ей приходится упираться в свою барабанную установку."

# ch/harems_full/band/events.rpy:3605
translate russian naked_gig_2b8d5350_1:
    "Разумеется, одновременно играть мы оба уже не можем."

# ch/harems_full/band/events.rpy:3606
translate russian naked_gig_3e8c7496_1:
    "Но остальные участницы группы быстро подхватывают музыку."

# ch/harems_full/band/events.rpy:3607
translate russian naked_gig_319e0b68_1:
    "Девушки импровизируют, на ходу подбирая аккорды под наши движения."

# ch/harems_full/band/events.rpy:3609
translate russian naked_gig_e4790700:
    "Всё это лишь подстёгивает меня трахать Анну ещё жёстче."

# ch/harems_full/band/events.rpy:3610
translate russian naked_gig_3ca4f934:
    "А сама Анна стонет с каждым толчком."

# ch/harems_full/band/events.rpy:3611
translate russian naked_gig_e7499138:
    "От моих движений она ударяется о барабаны, и они гулко звучат нам в такт."

# ch/harems_full/band/events.rpy:3613
translate russian naked_gig_b34a837f:
    "Вдруг я перестаю сдерживаться и извергаюсь прямо в задницу Анны."

# ch/harems_full/band/events.rpy:3615
translate russian naked_gig_81b69b61:
    "Кажется, это доводит до оргазма и её: она вскидывает руки."

# ch/harems_full/band/events.rpy:3617
translate russian naked_gig_79eca33a:
    "Руки задевают тарелки, и раздавшийся грохот весьма точно передаёт её оргазм."

# ch/harems_full/band/events.rpy:3618
translate russian naked_gig_af622645:
    "Затем я осторожно опускаю её обратно на табурет."

# ch/harems_full/band/events.rpy:3619
translate russian naked_gig_59e864ed:
    "Она плавно соскальзывает с моего члена и бессильно склоняется над барабанами."

# ch/harems_full/band/events.rpy:3626
translate russian naked_gig_d9183aaf:
    "Я оглядываю сцену, поочерёдно смотря на каждую девушку."

# ch/harems_full/band/events.rpy:3630
translate russian naked_gig_e6994fe3:
    "Но стоит взгляду остановиться на Клео, как я забываю об остальных."

# ch/harems_full/band/events.rpy:3631
translate russian naked_gig_b6aaf983:
