# Native Band identifiers, current source catalog. Translation only.

# ch/harems_full/band/events.rpy:366
translate russian sasha_threesome_confrontation_2fdbbb1f:
    mike.say "Я не экстрасенс, Саша, но, кажется, тебя что-то гложет."

# ch/harems_full/band/events.rpy:368
translate russian sasha_threesome_confrontation_1415187a:
    sasha.say "Что? Нет, просто хотела поговорить."

# ch/harems_full/band/events.rpy:370
translate russian sasha_threesome_confrontation_743b0dc2:
    "Я сразу настораживаюсь, но пытаюсь изображать невинность."

# ch/harems_full/band/events.rpy:371
translate russian sasha_threesome_confrontation_6b9989e0:
    mike.say "О чём именно?"

# ch/harems_full/band/events.rpy:373
translate russian sasha_threesome_confrontation_965044b8:
    sasha.say "Да обо всём понемногу... Кажется, мы почему-то стали меньше общаться, хотя ты теперь в группе."

# ch/harems_full/band/events.rpy:374
translate russian sasha_threesome_confrontation_a9da461a:
    sasha.say "Странно, да?"

# ch/harems_full/band/events.rpy:376
translate russian sasha_threesome_confrontation_9b2f7c6d:
    "Я киваю, замечая, что пока в основном говорит она."

# ch/harems_full/band/events.rpy:378
translate russian sasha_threesome_confrontation_b4f8d883:
    sasha.say "Кстати, сегодня вы просто зажигали."

# ch/harems_full/band/events.rpy:380
translate russian sasha_threesome_confrontation_7a88cbcc:
    mike.say "Спасибо, Саша. Ты тоже была великолепна."

# ch/harems_full/band/events.rpy:382
translate russian sasha_threesome_confrontation_4355bef5:
    sasha.say "Да нет, я лажала."

# ch/harems_full/band/events.rpy:384
translate russian sasha_threesome_confrontation_fe1d148a:
    sasha.say "А вот ты, Анна и Клео... Не знаю, вы как будто вдруг невероятно сыгрались втроём."

# ch/harems_full/band/events.rpy:386
translate russian sasha_threesome_confrontation_b478b2b0:
    "Я стараюсь улыбаться комплименту, но уже боюсь, что Саша догадалась о наших отношениях втроём."

# ch/harems_full/band/events.rpy:388
translate russian sasha_threesome_confrontation_32dde0bf:
    sasha.say "Слушай, мы ведь группа из четырёх человек. Думаю, можем быть друг с другом честны. Правда?"

# ch/harems_full/band/events.rpy:390
translate russian sasha_threesome_confrontation_a3452958:
    "Я киваю, готовясь к худшему."

# ch/harems_full/band/events.rpy:392
translate russian sasha_threesome_confrontation_3f8fbc63:
    sasha.say "Просто скажи: вы втроём репетируете за моей спиной?"

# ch/harems_full/band/events.rpy:393
translate russian sasha_threesome_confrontation_a89ae2ee:
    sasha.say "Хотите выгнать меня из группы? Или сами уйдёте и создадите новую без меня?"

# ch/harems_full/band/events.rpy:395
translate russian sasha_threesome_confrontation_beb65b77:
    "Удивление, а затем облегчение наверняка написаны у меня на лице."

# ch/harems_full/band/events.rpy:396
translate russian sasha_threesome_confrontation_1ec641ac:
    "Саша сразу видит, насколько меня ошеломила эта мысль."

# ch/harems_full/band/events.rpy:398
translate russian sasha_threesome_confrontation_c1b5dfd7:
    "Но она не дура и вскоре понимает: за моей реакцией скрывается что-то ещё."

# ch/harems_full/band/events.rpy:400
translate russian sasha_threesome_confrontation_2cd7382b:
    sasha.say "Погоди... Значит, избавиться от меня вы не хотите. Но что-то всё-таки происходит?"

# ch/harems_full/band/events.rpy:402
translate russian sasha_threesome_confrontation_ac88fb47:
    "Я пытаюсь заговорить, но Саша перебивает."

# ch/harems_full/band/events.rpy:404
translate russian sasha_threesome_confrontation_e371c698:
    sasha.say "Я заподозрила неладное, когда вы явились с аккуратными пятиминутными интервалами."

# ch/harems_full/band/events.rpy:405
translate russian sasha_threesome_confrontation_bb65a512:
    sasha.say "Обычно Клео приходит рано, Анна опаздывает, а мы с тобой идём вместе."

# ch/harems_full/band/events.rpy:407
translate russian sasha_threesome_confrontation_2c3de679:
    "Я почти вижу, как крутятся шестерёнки у Саши в голове: она сама складывает картину."

# ch/harems_full/band/events.rpy:409
translate russian sasha_threesome_confrontation_6d00f024:
    sasha.say "Если вас всех что-то связывает, отчего вы так хорошо чувствуете друг друга, и вы об этом молчите..."

# ch/harems_full/band/events.rpy:411
translate russian sasha_threesome_confrontation_6d8786a1:
    "Вот оно: по её лицу я вижу момент, когда она понимает, что происходит между мной, Клео и Анной."

# ch/harems_full/band/events.rpy:412
translate russian sasha_threesome_confrontation_67477791:
    mike.say "Не знаю, что тебе сказать, Саша."

# ch/harems_full/band/events.rpy:413
translate russian sasha_threesome_confrontation_8f49aa0b:
    mike.say "Как-то само получилось. Я и сам удивлён больше всех!"

# ch/harems_full/band/events.rpy:416
translate russian sasha_threesome_confrontation_a2f9f439:
    "Саша морщится, словно почувствовала неприятный запах."

# ch/harems_full/band/events.rpy:417
translate russian sasha_threesome_confrontation_72edcbe4:
    sasha.say "Фу... Все трое, вместе, одновременно?!"

# ch/harems_full/band/events.rpy:418
translate russian sasha_threesome_confrontation_ab8b004a:
    mike.say "Начиналось не так, честно!"

# ch/harems_full/band/events.rpy:419
translate russian sasha_threesome_confrontation_7df444a2:
    mike.say "Я встречался с каждой отдельно, а потом они узнали друг о друге."

# ch/harems_full/band/events.rpy:420
translate russian sasha_threesome_confrontation_2d173403:
    sasha.say "И чем это лучше?"

# ch/harems_full/band/events.rpy:421
translate russian sasha_threesome_confrontation_2e74e29a:
    "Лишь произнеся объяснение, я понимаю, как плохо оно звучит."

# ch/harems_full/band/events.rpy:423
translate russian sasha_threesome_confrontation_8cefa203:
    sasha.say "Господи, чего я на тебя набросилась? Вы же все в этом участвуете и всем нравится."

# ch/harems_full/band/events.rpy:425
translate russian sasha_threesome_confrontation_f7402798:
    mike.say "Прости, если это что-то значит."

# ch/harems_full/band/events.rpy:426
translate russian sasha_threesome_confrontation_a4fcca7d:
    mike.say "Я не мог не влюбиться в двух женщин, которые меня хотели... Думал, ты достаточно необычная, чтобы спокойно к такому отнестись."

# ch/harems_full/band/events.rpy:428
translate russian sasha_threesome_confrontation_d9a890e1:
    sasha.say "Хм... Может, мои взгляды традиционнее, чем мы оба думали."

# ch/harems_full/band/events.rpy:432
translate russian sasha_threesome_confrontation_9de66bca:
    "Саша качает головой и присвистывает — похоже, с неохотным восхищением."

# ch/harems_full/band/events.rpy:433
translate russian sasha_threesome_confrontation_89c5a6f1:
    sasha.say "Ну ты и тёмная лошадка!"

# ch/harems_full/band/events.rpy:435
translate russian sasha_threesome_confrontation_a49a0e0c:
    mike.say "Да всё было совсем не так!"

# ch/harems_full/band/events.rpy:437
translate russian sasha_threesome_confrontation_12943f6c:
    sasha.say "Ну конечно. Вы просто случайно споткнулись и упали в одну кровать голыми?"

# ch/harems_full/band/events.rpy:439
translate russian sasha_threesome_confrontation_ba51f436:
    mike.say "Скорее я встречался с обеими, а они узнали."

# ch/harems_full/band/events.rpy:441
translate russian sasha_threesome_confrontation_d2e6161b:
    sasha.say "Повезло тебе, что они согласились делиться игрушками!"

# ch/harems_full/band/events.rpy:443
translate russian sasha_threesome_confrontation_04e5f94a:
    mike.say "Слушай, прости, что никто тебе не сказал, Саша."

# ch/harems_full/band/events.rpy:445
translate russian sasha_threesome_confrontation_e0f6fd16:
    sasha.say "Эй, зато сейчас рассказываешь!"

# ch/harems_full/band/events.rpy:447
translate russian sasha_threesome_confrontation_9d80e2a2:
    "Саша понимающе подмигивает."

# ch/harems_full/band/events.rpy:449
translate russian sasha_threesome_confrontation_00747752:
    sasha.say "Только в следующий раз с таким пикантным секретом не заставляй меня делать неверные выводы!"

# ch/harems_full/band/events.rpy:452
translate russian sasha_threesome_confrontation_8ca608e6:
    "Саша краснеет, смущается и с трудом смотрит мне в глаза."

# ch/harems_full/band/events.rpy:453
translate russian sasha_threesome_confrontation_a25fadc9:
    mike.say "Чёрт, Саша... Прости, если я тебя этим шокировал или разозлил."

# ch/harems_full/band/events.rpy:455
translate russian sasha_threesome_confrontation_11985321:
    sasha.say "Нет... нет, дело совсем не в этом."

# ch/harems_full/band/events.rpy:457
translate russian sasha_threesome_confrontation_e252a477:
    "Пока я пытаюсь понять её, Саша кладёт ладони на мои руки поверх стола."

# ch/harems_full/band/events.rpy:459
translate russian sasha_threesome_confrontation_f3e08b43:
    sasha.say "Мне трудно признаться, но Клео и Анна мне всегда немножко нравились..."

# ch/harems_full/band/events.rpy:461
translate russian sasha_threesome_confrontation_813d8335:
    mike.say "Это не странно, Саша. Многие находят друзей привлекательными, а благодаря группе мы все очень близки."

# ch/harems_full/band/events.rpy:463
translate russian sasha_threesome_confrontation_c76ca6b5:
    sasha.say "Ладно, объясню прямо: кажется, я пропускаю что-то интересное и хочу присоединиться!"

# ch/harems_full/band/events.rpy:467
translate russian sasha_threesome_confrontation_f3d4459c:
    sasha.say "Ты отлично изображаешь золотую рыбку, но ответа я так и не услышала."

# ch/harems_full/band/events.rpy:469
translate russian sasha_threesome_confrontation_bbe75ae4:
    mike.say "Саша... У меня уже от отношений с двумя женщинами голова кругом. Куда уж с тремя!"

# ch/harems_full/band/events.rpy:471
translate russian sasha_threesome_confrontation_a1160c04:
    sasha.say "Наверняка от троих до четверых не такой уж большой шаг?"

# ch/harems_full/band/events.rpy:473
translate russian sasha_threesome_confrontation_a3987add:
    mike.say "Ну, если так посмотреть..."

# ch/harems_full/band/events.rpy:475
translate russian sasha_threesome_confrontation_f0dc9038:
    sasha.say "Слушай, я просто спрашиваю. Может, замолвишь за меня словечко?"

# ch/harems_full/band/events.rpy:477
translate russian sasha_threesome_confrontation_121aff27:
    "Я киваю, стараясь пока не думать о том, какие возможности это открывает."

# ch/harems_full/band/events.rpy:480
translate russian sasha_threesome_confrontation_3f866188:
    "Мы немного сидим молча, а затем расходимся."

# ch/harems_full/band/events.rpy:481
translate russian sasha_threesome_confrontation_f1e3f35f:
    "Оба слишком заняты мыслями о последствиях разговора, чтобы продолжать болтать."

# ch/harems_full/band/events.rpy:482
translate russian sasha_threesome_confrontation_c3c10828:
    "Что бы ни случилось дальше, кое-что наверняка изменится навсегда."

# ch/harems_full/band/events.rpy:488
translate russian kleioannafoursome_a5d66fbe:
    "Мы все в спальне Саши и с нетерпением снимаем одежду."

# ch/harems_full/band/events.rpy:494
translate russian kleioannafoursome_f5d07993:
    "Анна и Клео охотно согласились зайти ко мне тем вечером, явно ожидая продолжения наших совместных развлечений."

# ch/harems_full/band/events.rpy:495
translate russian kleioannafoursome_74e851e7:
    "Я не разделял их воодушевления: от мысли о предстоящем разговоре про Сашу уже крутило живот."

# ch/harems_full/band/events.rpy:496
translate russian kleioannafoursome_3b93d82d:
    "Отношения с двумя девушками и так кружили голову. А теперь предстояло попросить впустить третью в наш необычный союз."

# ch/harems_full/band/events.rpy:498
translate russian kleioannafoursome_35efbe1b:
    "Клео пришла первой, одарила меня привычно непристойным долгим поцелуем и плюхнулась на диван."

# ch/harems_full/band/events.rpy:500
translate russian kleioannafoursome_af921cbb:
    "Анна появилась несколькими минутами позже, радостно обняла меня и примостилась на краешке дивана рядом с Клео."

# ch/harems_full/band/events.rpy:501
translate russian kleioannafoursome_080337c0:
    mike.say "Вы поели? Принести что-нибудь выпить?"

# ch/harems_full/band/events.rpy:502
translate russian kleioannafoursome_b5715fa5:
    anna.say "Ой, эм... Не думала, что ты такое спросишь!"

# ch/harems_full/band/events.rpy:504
translate russian kleioannafoursome_6c9b57a9:
    kleio.say "Может, позже. Сейчас у меня аппетит на другое!"

# ch/harems_full/band/events.rpy:505
translate russian kleioannafoursome_c467df1b:
    mike.say "А, да, конечно... У меня тоже."

# ch/harems_full/band/events.rpy:506
translate russian kleioannafoursome_5b38413e:
    mike.say "Просто подумал, было бы неплохо немного поговорить, прежде чем мы... ну, вы понимаете."

# ch/harems_full/band/events.rpy:507
translate russian kleioannafoursome_76406a07:
    mike.say "Не может же всё сводиться к сексу?"

# ch/harems_full/band/events.rpy:509
translate russian kleioannafoursome_ed60ec5e:
    kleio.say "Не вижу, почему бы и нет!"

# ch/harems_full/band/events.rpy:511
translate russian kleioannafoursome_be025d93:
    anna.say "Придумала! Может, поговорим о непристойностях?"

# ch/harems_full/band/events.rpy:512
translate russian kleioannafoursome_3e268089:
    "Я уже тереблю воротник и, наверное, выгляжу воплощением паники и уклончивости."

# ch/harems_full/band/events.rpy:514
translate russian kleioannafoursome_619e0d68:
    kleio.say "С сердцеедом что-то не так... Давай, выкладывай."

# ch/harems_full/band/events.rpy:515
translate russian kleioannafoursome_27bed0a9:
    "Я стараюсь не заикаться и не путаться в словах. Саша ждёт у себя в комнате, чем закончится моя попытка замолвить за неё слово."

# ch/harems_full/band/events.rpy:516
translate russian kleioannafoursome_313fd81a:
    mike.say "В общем, дело вот в чём... Мы с Сашей недавно ходили выпить."

# ch/harems_full/band/events.rpy:517
translate russian kleioannafoursome_80bd4815:
    mike.say "И она... ну... догадалась, что между нами происходит."

# ch/harems_full/band/events.rpy:520
translate russian kleioannafoursome_2a10d5a1:
    "Непонимание на лице Анны сменяется потрясением."

# ch/harems_full/band/events.rpy:521
translate russian kleioannafoursome_109040a7:
    "А Клео, к моему удивлению, скорее забавляется, чем злится."

# ch/harems_full/band/events.rpy:522
translate russian kleioannafoursome_b286042e:
    kleio.say "Ты ей всё рассказал?"

# ch/harems_full/band/events.rpy:523
translate russian kleioannafoursome_876394df:
    mike.say "Нет, клянусь! Она решила, что мы проводим время без неё, потому что хотим выгнать её из группы."

# ch/harems_full/band/events.rpy:524
translate russian kleioannafoursome_ce184e90:
    mike.say "Я сказал, что это не так. А она умная, вот и догадалась, в чём дело."

# ch/harems_full/band/events.rpy:526
translate russian kleioannafoursome_9670539d:
    kleio.say "И что? Злится, ревнует или всё сразу?"

# ch/harems_full/band/events.rpy:528
translate russian kleioannafoursome_b200d2c3:
    anna.say "Ох, если злится, надеюсь, не слишком сильно."

# ch/harems_full/band/events.rpy:529
translate russian kleioannafoursome_ff35a2bc:
    "Момент истины настал. Я стараюсь собраться с духом."

# ch/harems_full/band/events.rpy:530
translate russian kleioannafoursome_73230af4:
    mike.say "Она точно не злится. Но можно сказать, что ревнует."

# ch/harems_full/band/events.rpy:531
translate russian kleioannafoursome_726feae6:
    mike.say "Она попросила спросить вас... можно ли превратить наши отношения в союз четверых?"

# ch/harems_full/band/events.rpy:533
translate russian kleioannafoursome_52b9b0c1:
    kleio.say "Вот как?!"

# ch/harems_full/band/events.rpy:534
translate russian kleioannafoursome_fb33438e:
    mike.say "Это да или нет?"

# ch/harems_full/band/events.rpy:536
translate russian kleioannafoursome_e3e0efd8:
    kleio.say "Я не ханжа, так что да. Если можно втроём, почему не вчетвером?"

# ch/harems_full/band/events.rpy:537
translate russian kleioannafoursome_3b297079:
    mike.say "А ты что скажешь, Анна?"

# ch/harems_full/band/events.rpy:539
translate russian kleioannafoursome_096e230f:
    "Анна краснеет. Идея явно её заинтересовала, но прямой вопрос смущает."

# ch/harems_full/band/events.rpy:540
translate russian kleioannafoursome_f2c9c0bc:
    anna.say "Саша мне всегда немножко нравилась, так что я за!"

# ch/harems_full/band/events.rpy:541
translate russian kleioannafoursome_dcae906c:
    "Два голоса «за». Я, наверное, тоже уже согласился, когда обещал поговорить с Клео и Анной. Значит, единогласно."

# ch/harems_full/band/events.rpy:543
translate russian kleioannafoursome_d01a74da:
    "Я быстро киваю, нервно вздыхаю, встаю и направляюсь в коридор к спальне Саши, собираясь лично сообщить новость."

# ch/harems_full/band/events.rpy:545
translate russian kleioannafoursome_39eeb995:
    "Не знаю почему, но стараюсь не шуметь: крадусь к её двери и тихо стучу."

# ch/harems_full/band/events.rpy:549
translate russian kleioannafoursome_53acd721:
    "Клео и Анна за моей спиной подобной осторожностью не отличаются."

# ch/harems_full/band/events.rpy:550
translate russian kleioannafoursome_afb01d74:
    "Клео идёт следом, словно кошка, выслеживающая беспомощную птицу со сломанным крылом."

# ch/harems_full/band/events.rpy:551
translate russian kleioannafoursome_eebb6a1d:
    "А Анна то и дело хихикает — подозреваю, от волнения перед тем, что нас ждёт."

# ch/harems_full/band/events.rpy:552
translate russian kleioannafoursome_a61f354c:
    "Я оборачиваюсь, собираясь попросить их замолчать, но голос из-за двери опережает меня."

# ch/harems_full/band/events.rpy:553
translate russian kleioannafoursome_b0b3164d:
    sasha.say "Кто там?"

# ch/harems_full/band/events.rpy:554
translate russian kleioannafoursome_f0bb7e64:
    "Понимаю, что она наверняка сидела в тишине, ожидая результата моего разговора с девушками."

# ch/harems_full/band/events.rpy:555
translate russian kleioannafoursome_d360f174:
    mike.say "Это я... Можно войти?"

# ch/harems_full/band/events.rpy:556
translate russian kleioannafoursome_02f8051f:
    sasha.say "Наверное, да."

# ch/harems_full/band/events.rpy:560
translate russian kleioannafoursome_f4ccc76e:
    "Я как можно серьёзнее показываю Клео и Анне, чтобы тихо ждали в коридоре, затем открываю дверь и проскальзываю в спальню."

# ch/harems_full/band/events.rpy:561
translate russian kleioannafoursome_6c65f3d6:
    "В комнате полумрак, горит лишь прикроватная лампа. Раскрытая рядом книга говорит о безуспешной попытке Саши отвлечься."

# ch/harems_full/band/events.rpy:562
translate russian kleioannafoursome_3fd3530a:
    "Но я быстро забываю об этих деталях: Саша сидит на кровати в одной майке и шортах, глядя с надеждой."

# ch/harems_full/band/events.rpy:563
translate russian kleioannafoursome_bf0fcddb:
    "Нужно что-то сказать, но я могу лишь смотреть на Сашу и думать о новых возможностях для нас с Клео и Анной."

# ch/harems_full/band/events.rpy:564
translate russian kleioannafoursome_6c1d28df:
    sasha.say "Ну... каков вердикт?"

# ch/harems_full/band/events.rpy:565
translate russian kleioannafoursome_ae27e4be:
    mike.say "Я спросил их обеих, и... и..."

# ch/harems_full/band/events.rpy:566
translate russian kleioannafoursome_43971475:
    "Не успеваю закончить, как дверь за спиной резко распахивается, толкая меня вглубь комнаты."

# ch/harems_full/band/events.rpy:569
translate russian kleioannafoursome_01688a41:
    "Врываются хихикающие Клео и Анна. По их взглядам на Сашу понятно: думают они о том же, что и я."

# ch/harems_full/band/events.rpy:570
translate russian kleioannafoursome_16f54a53:
    kleio.say "Мы сказали ДА!"

# ch/harems_full/band/events.rpy:571
translate russian kleioannafoursome_4b1495fe:
    "Мы с Анной киваем, стараясь не отстать от напористой Клео."

# ch/harems_full/band/events.rpy:572
translate russian kleioannafoursome_a1ead154:
    kleio.say "Пока наш сердцеед собрался бы тебе сообщить, мы бы уже паутину с клиторов счищали!"

# ch/harems_full/band/events.rpy:574
translate russian kleioannafoursome_277a4f03:
    anna.say "Мы с [lssb_common.hero_name()] не такие напористые, как Клео, но очень рады, что ты присоединишься. Правда?"

# ch/harems_full/band/events.rpy:575
translate russian kleioannafoursome_abb08339:
    mike.say "Да... да. Как американские горки: захватывает и немного пугает, но приятно."

# ch/harems_full/band/events.rpy:576
translate russian kleioannafoursome_820a1908:
    "К этому моменту мы втроём уже садимся на кровать вокруг Саши."

# ch/harems_full/band/events.rpy:578
translate russian kleioannafoursome_e6919deb:
    "Она улыбается и старается выглядеть уверенно, но наверняка чувствует себя посвящаемой в какой-то странный извращённый культ."

# ch/harems_full/band/events.rpy:580
translate russian kleioannafoursome_f2188d00:
    sasha.say "Вот, значит, как вы хотите?"

# ch/harems_full/band/events.rpy:581
translate russian kleioannafoursome_e3e5b621:
    sasha.say "Будете обращаться со мной как с аттракционом для дешёвых острых ощущений?"

# ch/harems_full/band/events.rpy:583
translate russian kleioannafoursome_a62ea5a0:
    kleio.say "Не-а. Ты новенькая, так что кататься будешь на нас."

# ch/harems_full/band/events.rpy:584
translate russian kleioannafoursome_744cac08:
    "От слов Клео Саша слегка краснеет, явно пытаясь представить, что та задумала."

# ch/harems_full/band/events.rpy:585
translate russian kleioannafoursome_2e2b9295:
    "Кажется, я понимаю мысли Клео: мы с ней и Анной уже привыкли развлекаться втроём."

# ch/harems_full/band/events.rpy:586
translate russian kleioannafoursome_8b766f61:
    "Если хотим принять Сашу, стоит взять её за руку и показать дорогу."

# ch/harems_full/band/events.rpy:588
translate russian kleioannafoursome_03926e0d:
    "Не спрашивая разрешения, я тянусь к Анне и снимаю через голову её тесную футболку."

# ch/harems_full/band/events.rpy:590
translate russian kleioannafoursome_ba1509cb:
    "Анна не сопротивляется и хихикает ещё сильнее, когда её большая грудь обнажается."

# ch/harems_full/band/events.rpy:592
translate russian kleioannafoursome_c0339778:
    "Саша нерешительно протягивает руку. Анна мягко берёт её за запястье и направляет ладонь к своей груди."

# ch/harems_full/band/events.rpy:593
translate russian kleioannafoursome_9fefc1bf:
    "Одновременно Анна придвигается к Саше, просовывая одну руку ей под майку, а другую — за пояс шорт."

# ch/harems_full/band/events.rpy:595
translate russian kleioannafoursome_485dcd8d:
    "Клео тем временем забирается ко мне на колени, расстёгивает ширинку и гладит мой член."

# ch/harems_full/band/events.rpy:596
translate russian kleioannafoursome_06afb886:
    "Она довольно мурлычет, когда я отвечаю: одной рукой приподнимаю юбку и ласкаю её под трусиками, другой снимаю топ, освобождая грудь."

# ch/harems_full/band/events.rpy:599
translate russian kleioannafoursome_2d163e65:
    "Мы раздеваем и изучаем друг друга: мы с Клео в одной паре, Анна и Саша — в другой."

# ch/harems_full/band/events.rpy:600
translate russian kleioannafoursome_54364ea7:
    "Саша следит за нами с Клео не меньше, чем за ласками Анны."

# ch/harems_full/band/events.rpy:601
translate russian kleioannafoursome_bd402bb0:
    "В какой-то момент наши взгляды встречаются. Интересно, она так же поражена происходящим, как я?"

# ch/harems_full/band/events.rpy:602
translate russian kleioannafoursome_3b36d068:
    "Когда она впервые вошла в мой дом или знакомила меня с подругами по группе, никто из нас не мог представить, к чему это приведёт."

# ch/harems_full/band/events.rpy:603
translate russian kleioannafoursome_4e619a98:
    "Вскоре все раздеты: четыре обнажённых тела сходятся посреди кровати."

# ch/harems_full/band/events.rpy:604
translate russian kleioannafoursome_b1f204e8:
    "Саша пытается не смотреть на мой уже полностью вставший член, но не может удержаться. Остальные тоже быстро замечают."

# ch/harems_full/band/events.rpy:606
translate russian kleioannafoursome_35a2c1d0:
    kleio.say "Неплохой экземпляр, правда?"

# ch/harems_full/band/events.rpy:608
translate russian kleioannafoursome_b6d71138:
    anna.say "Лично рекомендую для любой из двух дырочек внизу. Очень хорош!"

# ch/harems_full/band/events.rpy:609
translate russian kleioannafoursome_a846eff6:
    "Саша нервно смеётся, не зная, что будет дальше."

# ch/harems_full/band/events.rpy:611
translate russian kleioannafoursome_cc0f256c:
    kleio.say "Только он у нас один."

# ch/harems_full/band/events.rpy:613
translate russian kleioannafoursome_f4001231:
    anna.say "Так что всё должно быть честно. Нужно согласиться делиться."

# ch/harems_full/band/events.rpy:615
translate russian kleioannafoursome_9ade2bd0:
    kleio.say "Да, Саша, не забирай член сердцееда себе целиком!"

# ch/harems_full/band/events.rpy:616
translate russian kleioannafoursome_1a2576f5:
    "Саша смотрит на меня, наверное, удивляясь, почему я не участвую в разговоре."

# ch/harems_full/band/events.rpy:618
translate russian kleioannafoursome_92d8c00c:
    kleio.say "Но у тебя привилегия новенькой."

# ch/harems_full/band/events.rpy:620
translate russian kleioannafoursome_00e9d6d4:
    anna.say "Ага! Раз ты впервые, тебе и скакать на нём!"

# ch/harems_full/band/events.rpy:621
translate russian kleioannafoursome_5a01bee5:
    "Меня немного злит, что Клео и Анна обсуждают меня как кусок мяса, несмотря на все разговоры о равенстве в группе."

# ch/harems_full/band/events.rpy:622
translate russian kleioannafoursome_1e44d3f9:
    "Но признаю: в таком использовании есть особое удовольствие, особенно когда они спорят, кому достанется мой член."

# ch/harems_full/band/events.rpy:623
translate russian kleioannafoursome_1368577f:
    "Я не успеваю ничего сказать: Анна уже укладывает меня на кровать, одновременно массируя член."

# ch/harems_full/band/events.rpy:624
translate russian kleioannafoursome_196daa38:
    "Вместе с Клео они направляют Сашу назад, всё ближе к моей эрекции."

# ch/harems_full/band/events.rpy:628
translate russian kleioannafoursome_61a7b53d:
    "Анна помогает Саше, а та оглядывается через плечо."

# ch/harems_full/band/events.rpy:629
translate russian kleioannafoursome_361274aa:
    "Только сейчас я понимаю: куда именно войдёт мой член, полностью решаю я."

# ch/harems_full/band/events.rpy:630
translate russian kleioannafoursome_5673a069:
    "За эти секунды я кладу ладони на бёдра Саши и делаю выбор."

# ch/harems_full/band/events.rpy:635
translate russian kleioannafoursome_0cfc2363:
    "Раз для Саши это впервые, решаю придерживаться привычного."

# ch/harems_full/band/events.rpy:636
translate russian kleioannafoursome_39345d10:
    "Медленно опускаю её на себя, направляя член между губками киски."

# ch/harems_full/band/events.rpy:638
translate russian kleioannafoursome_ee78b52b:
    "Саша уже очень влажная и почти не встречает сопротивления, садясь на меня."

# ch/harems_full/band/events.rpy:639
translate russian kleioannafoursome_61379610:
    "Под собственным весом она принимает меня целиком, до самого основания."

# ch/harems_full/band/events.rpy:641
translate russian kleioannafoursome_ebec5eb9:
    "Тем временем Клео целует один её обнажённый сосок, сжимая и пощипывая другой."

# ch/harems_full/band/events.rpy:642
translate russian kleioannafoursome_6061b15a:
    "Анна то лижет половые губки Саши, то переключается на основание моего члена."

# ch/harems_full/band/events.rpy:644
translate russian kleioannafoursome_0825be3b:
    "Саша инстинктивно пытается сменить позу, но ласки обступают её сразу с трёх сторон."

# ch/harems_full/band/events.rpy:646
translate russian kleioannafoursome_ee048d21:
    "Любое движение лишь усиливает ощущения, которые вот-вот захлестнут её."

# ch/harems_full/band/events.rpy:649
translate russian kleioannafoursome_7cb9c771:
    "Можно было бы взять Сашу обычным способом, но к чему консерватизм посреди секса вчетвером?"

# ch/harems_full/band/events.rpy:650
translate russian kleioannafoursome_2867f2ae:
    "Я слегка наклоняю Сашу вперёд и направляю член между ягодицами в её ничего не подозревающую попку."

# ch/harems_full/band/events.rpy:652
translate russian kleioannafoursome_a1d22708:
    "Опускаясь на мой член, Саша вскрикивает от неожиданного проникновения сзади."

# ch/harems_full/band/events.rpy:653
translate russian kleioannafoursome_0e6aec1f:
    "Но затем протяжно и громко стонет, когда язык Анны исследует складки её киски."

# ch/harems_full/band/events.rpy:655
translate russian kleioannafoursome_f7c7dbf9:
    "Клео тоже подключается, без остановки целуя, покусывая и сжимая затвердевшие соски Анны."

# ch/harems_full/band/events.rpy:657
translate russian kleioannafoursome_3fc14c42:
    "Честно говоря, не представляю, чем ещё можно сейчас усилить ощущения Саши."

# ch/harems_full/band/events.rpy:659
translate russian kleioannafoursome_7be3f069:
    "Она быстро приближается к оргазму, вздрагивая и извиваясь, пока мы втроём играем на ней, словно на одном из наших инструментов."

# ch/harems_full/band/events.rpy:662
translate russian kleioannafoursome_4a0b4223:
    "Не знаю, почему мне хочется пойти наперекор. Может, из-за близости тяжёлой груди и пухлых губ Анны."

# ch/harems_full/band/events.rpy:663
translate russian kleioannafoursome_176b662d:
    "Какова бы ни была причина, я решаю удивить Сашу и тянусь к голове Анны."

# ch/harems_full/band/events.rpy:665
translate russian kleioannafoursome_bc7c5890:
    "Одновременно поднимаю таз, и мой член скользит ей в рот, как раз когда она открывает его, собираясь спросить, что я делаю."

# ch/harems_full/band/events.rpy:667
translate russian kleioannafoursome_2fb2dafb:
    "Больше объяснений не нужно: Анна обводит член языком, умело возбуждая каждым движением."

# ch/harems_full/band/events.rpy:669
translate russian kleioannafoursome_6b994154:
    "Саша выглядит разочарованной, но Клео быстро отвлекает её, целуя и облизывая твердеющие соски."

# ch/harems_full/band/events.rpy:671
translate russian kleioannafoursome_3c1453bb:
    "Вскоре Саша словно забывает, что я не дал ей член, и с каждым мгновением поёт всё громче."

# ch/harems_full/band/events.rpy:672
translate russian kleioannafoursome_e75ef08b:
    "Когда она выгибает спину, готовясь кончить, я понимаю: не она одна близка к оргазму."

# ch/harems_full/band/events.rpy:675
translate russian kleioannafoursome_0b8235ec:
    "Уверен, Анна и раньше вытворяла всякие безумства."

# ch/harems_full/band/events.rpy:676
translate russian kleioannafoursome_e83ec035:
    "Но для Саши это первый раз, поэтому даже с Анной решаю не рисковать."

# ch/harems_full/band/events.rpy:678
translate russian kleioannafoursome_1248ec6e:
    "Крепко обхватываю её маленькую круглую попку и направляю член между ног."

# ch/harems_full/band/events.rpy:679
translate russian kleioannafoursome_e74f59f3:
    "Анна уже возбуждена и приятно влажная."

# ch/harems_full/band/events.rpy:680
translate russian kleioannafoursome_513acd56:
    "Поэтому я вхожу почти одним плавным движением."

# ch/harems_full/band/events.rpy:682
translate russian kleioannafoursome_8e8b30eb:
    "Тем временем Клео целует один обнажённый сосок Саши, сжимая и пощипывая другой."

# ch/harems_full/band/events.rpy:685
translate russian kleioannafoursome_7ccd11bd:
    "Любое движение лишь усиливает ощущения, которые вот-вот захлестнут Сашу."

# ch/harems_full/band/events.rpy:688
translate russian kleioannafoursome_ce4d8879:
    "Я достаточно хорошо знаю Анну, чтобы понимать: в таких делах она не новичок."

# ch/harems_full/band/events.rpy:690
translate russian kleioannafoursome_0b63ec64:
    "Поэтому, обхватив её маленькую круглую попку, без колебаний развожу ягодицы."

# ch/harems_full/band/events.rpy:691
translate russian kleioannafoursome_f372c842:
    "Затем направляю головку члена прямо в открывшуюся цель."

# ch/harems_full/band/events.rpy:692
translate russian kleioannafoursome_49138643:
    "Опускаясь на мой член, Анна вскрикивает от неожиданного проникновения сзади."

# ch/harems_full/band/events.rpy:693
translate russian kleioannafoursome_1dd0cf05:
    "Но когда я вхожу глубже, возгласы быстро сменяются стонами удовольствия."

# ch/harems_full/band/events.rpy:695
translate russian kleioannafoursome_8e8b30eb_1:
    "Тем временем Клео целует один обнажённый сосок Саши, сжимая и пощипывая другой."

# ch/harems_full/band/events.rpy:698
translate russian kleioannafoursome_7be3f069_1:
    "Она быстро приближается к оргазму, вздрагивая и извиваясь, пока мы втроём играем на ней, словно на одном из наших инструментов."

# ch/harems_full/band/events.rpy:701
translate russian kleioannafoursome_baa01d72:
    "Уверен, Клео и раньше участвовала в подобных безумствах, если не в более диких."

# ch/harems_full/band/events.rpy:702
translate russian kleioannafoursome_8ad4ddee:
    "Но для Саши это первый раз, поэтому даже с Клео решаю не рисковать."

# ch/harems_full/band/events.rpy:704
translate russian kleioannafoursome_ec0dfafe:
    "Крепко обхватываю её маленькие упругие груди и тяну её назад, на себя."

# ch/harems_full/band/events.rpy:705
translate russian kleioannafoursome_9ecb3808:
    "Клео вскрикивает от неожиданности, а затем стонет от удовольствия, почувствовав мой член между ног."

# ch/harems_full/band/events.rpy:706
translate russian kleioannafoursome_8d0bae70:
    "Я чувствую, как она влажна, и от этого хочу её ещё сильнее."

# ch/harems_full/band/events.rpy:707
translate russian kleioannafoursome_5314b802:
    "Я поспешно прижимаю головку к киске Клео и почти сразу чувствую, как она поддаётся."

# ch/harems_full/band/events.rpy:709
translate russian kleioannafoursome_1d98a812:
    "Тем временем она целует один обнажённый сосок Саши, сжимая и пощипывая другой."

# ch/harems_full/band/events.rpy:710
translate russian kleioannafoursome_04214d4b:
    "Анна уткнулась лицом Саше между ног и без остановки лижет её киску."

# ch/harems_full/band/events.rpy:711
translate russian kleioannafoursome_a7adbced:
    "Чем сильнее я толкаюсь в Клео, тем усерднее она целует грудь Саши!"

# ch/harems_full/band/events.rpy:712
translate russian kleioannafoursome_ee048d21_1:
    "Любое движение лишь усиливает ощущения, которые вот-вот захлестнут её."

# ch/harems_full/band/events.rpy:715
translate russian kleioannafoursome_0abb6c1b:
    "Клео — девушка дерзкая, из тех, кого безумствами не удивить."

# ch/harems_full/band/events.rpy:717
translate russian kleioannafoursome_555d9506:
    "С этой мыслью я обхватываю её груди и тяну назад, на себя."

# ch/harems_full/band/events.rpy:718
translate russian kleioannafoursome_65ca6091:
    "Одновременно направляю член между ягодицами к её попке."

# ch/harems_full/band/events.rpy:719
translate russian kleioannafoursome_6d751c90:
    "Клео удивлённо ахает, чувствуя, как я проникаю в неё всё глубже с каждой секундой."

# ch/harems_full/band/events.rpy:720
translate russian kleioannafoursome_1dd0cf05_1:
    "Но когда я вхожу глубже, возгласы быстро сменяются стонами удовольствия."

# ch/harems_full/band/events.rpy:722
translate russian kleioannafoursome_1d98a812_1:
    "Тем временем она целует один обнажённый сосок Саши, сжимая и пощипывая другой."

# ch/harems_full/band/events.rpy:723
translate russian kleioannafoursome_04214d4b_1:
    "Анна уткнулась лицом Саше между ног и без остановки лижет её киску."

# ch/harems_full/band/events.rpy:724
translate russian kleioannafoursome_b3cddd0b:
    "Чем сильнее я толкаюсь в Анну, тем усерднее она целует грудь Саши!"

# ch/harems_full/band/events.rpy:725
translate russian kleioannafoursome_ee048d21_2:
    "Любое движение лишь усиливает ощущения, которые вот-вот захлестнут её."

# ch/harems_full/band/events.rpy:726
translate russian kleioannafoursome_25bdedbe:
    "У меня есть секунд пять, чтобы решить, где именно я хочу быть в момент разрядки."

# ch/harems_full/band/events.rpy:729
translate russian kleioannafoursome_18828977:
    "Решив сделать Сашу центром внимания в её первый раз с нами, я вхожу в неё как можно глубже."

# ch/harems_full/band/events.rpy:732
translate russian kleioannafoursome_ab3459ca:
    "Когда больше не могу сдерживаться, отдаюсь оргазму и чувствую, как он толкает её за грань."

# ch/harems_full/band/events.rpy:733
translate russian kleioannafoursome_0e456742:
    "Саша вскрикивает и напрягается. Я уже перестал двигаться, но Клео и Анна останавливаться не собираются."

# ch/harems_full/band/events.rpy:735
translate russian kleioannafoursome_7282c5ea:
    "Сидя на мне и опираясь на девушек, она остаётся в вертикальном положении, испытывая всю силу ощущений без передышки."

# ch/harems_full/band/events.rpy:737
translate russian kleioannafoursome_5688c144:
    "Ласк Клео на сосках и языка Анны на киске наконец хватает, чтобы довести Сашу до оргазма."

# ch/harems_full/band/events.rpy:740
translate russian kleioannafoursome_c2bedd5c:
    "Чувствуя дрожь её напряжённого тела, я тоже срываюсь: мой член в её попке улавливает каждое сокращение."

# ch/harems_full/band/events.rpy:741
translate russian kleioannafoursome_a7957d48:
    "Когда я вдобавок кончаю в неё, Саша выгибает спину и неожиданно громко кричит."

# ch/harems_full/band/events.rpy:742
translate russian kleioannafoursome_f591d8fc:
    "Я наблюдаю, как она переживает каждую секунду оргазма, насаженная на мой член и не в силах сдвинуться."

# ch/harems_full/band/events.rpy:744
translate russian kleioannafoursome_ea85153e:
    "Мой член во рту Анны, и я не могу понять, кто из нас начинает кончать первым."

# ch/harems_full/band/events.rpy:748
translate russian kleioannafoursome_62bad794:
    "Но волны оргазма быстро уносят нас обоих за грань."

# ch/harems_full/band/events.rpy:749
translate russian kleioannafoursome_c8a179be:
    "Через несколько секунд приходит разрядка, пока член всё ещё окружён мягким теплом рта Анны."

# ch/harems_full/band/events.rpy:751
translate russian kleioannafoursome_593d1a12:
    "К счастью, она готова: не давится, ловит воздух и глотает, лишь усиливая моё удовольствие."

# ch/harems_full/band/events.rpy:753
translate russian kleioannafoursome_eaf213a8:
    "Я так глубоко в Анне, что ни о чём другом не могу думать, не говоря уж о том, чтобы вытащить!"

# ch/harems_full/band/events.rpy:756
translate russian kleioannafoursome_ab3459ca_1:
    "Когда больше не могу сдерживаться, отдаюсь оргазму и чувствую, как он толкает её за грань."

# ch/harems_full/band/events.rpy:757
translate russian kleioannafoursome_450d4c90:
    "Анна вскрикивает и напрягается. Я уже перестал двигаться, но Клео и Саша останавливаться не собираются."

# ch/harems_full/band/events.rpy:759
translate russian kleioannafoursome_8746b817:
    "Анна всё ещё сидит на моём члене, прижатая на месте, и не может ускользнуть, пока я кончаю в неё."

# ch/harems_full/band/events.rpy:761
translate russian kleioannafoursome_6a06b7f7:
    "Мой член уже так глубоко в попке Анны, как только возможно, и путь лишь вперёд."

# ch/harems_full/band/events.rpy:764
translate russian kleioannafoursome_fc8753ef:
    "Когда я теряю контроль, она принимает всё, что я даю, не имея возможности ускользнуть."

# ch/harems_full/band/events.rpy:765
translate russian kleioannafoursome_668f85e9:
    "Клео и Саша наверняка чем-то заняты, но я могу думать только о разрядке."

# ch/harems_full/band/events.rpy:767
translate russian kleioannafoursome_4d276d9c:
    "И слышу лишь стоны и всхлипы Анны, пока наполняю её всем, что могу отдать."

# ch/harems_full/band/events.rpy:769
translate russian kleioannafoursome_78ad0974:
    "Я так глубоко в Клео, что ни о чём другом не могу думать, не говоря уж о том, чтобы вытащить!"

# ch/harems_full/band/events.rpy:772
translate russian kleioannafoursome_ab3459ca_2:
    "Когда больше не могу сдерживаться, отдаюсь оргазму и чувствую, как он толкает её за грань."

# ch/harems_full/band/events.rpy:773
translate russian kleioannafoursome_c2d75c72:
    "Клео вскрикивает и напрягается. Я уже перестал двигаться, но Анна и Саша останавливаться не собираются."

# ch/harems_full/band/events.rpy:775
translate russian kleioannafoursome_8746b817_1:
    "Анна всё ещё сидит на моём члене, прижатая на месте, и не может ускользнуть, пока я кончаю в неё."

# ch/harems_full/band/events.rpy:777
translate russian kleioannafoursome_8212dba4:
    "Мой член уже так глубоко в попке Клео, как только возможно, и путь лишь вперёд."

# ch/harems_full/band/events.rpy:780
translate russian kleioannafoursome_fc8753ef_1:
    "Когда я теряю контроль, она принимает всё, что я даю, не имея возможности ускользнуть."

# ch/harems_full/band/events.rpy:781
translate russian kleioannafoursome_79858b62:
    "Анна и Саша наверняка чем-то заняты, но я могу думать только о разрядке."

# ch/harems_full/band/events.rpy:783
translate russian kleioannafoursome_752ecab5:
    "И слышу лишь стоны и всхлипы Клео, пока наполняю её всем, что могу отдать."

# ch/harems_full/band/events.rpy:785
translate russian kleioannafoursome_e5e0f6a6:
    "В последний миг я внезапно меняю решение."

# ch/harems_full/band/events.rpy:787
translate russian kleioannafoursome_95c20a6f:
    "Без предупреждения одним плавным движением выхожу из Саши, заставив её удивлённо застонать."

# ch/harems_full/band/events.rpy:789
translate russian kleioannafoursome_f704a087:
    "Успеваю лишь направить член на лицо Анны."

# ch/harems_full/band/events.rpy:791
translate russian kleioannafoursome_f283c710:
    "Я кончаю, не сдерживаясь, покрывая её лицо струями липкой белой спермы."

# ch/harems_full/band/events.rpy:795
translate russian kleioannafoursome_0f4dad99:
    "Анна ахает и тяжело дышит, пока сперма стекает по щекам и губам."

# ch/harems_full/band/events.rpy:807
translate russian kleioannafoursome_7624e65b:
    "Хотя кончили только мы с Сашей, все обессиленно падают на кровать, словно куклы, у которых разом обрезали нити."

# ch/harems_full/band/events.rpy:808
translate russian kleioannafoursome_f94878d3:
    "Никто не говорит, но все чувствуют: произошло нечто удивительное, изменившее нашу жизнь."

# ch/harems_full/band/events.rpy:809
translate russian kleioannafoursome_37636b3f:
    "Теперь мы не только играем в одной группе, но и стали любовниками."

# ch/harems_full/band/events.rpy:821
translate russian kleioannafoursome2_377c1e72:
    "Мы снова в моей спальне и все четверо с нетерпением снимаем одежду."

# ch/harems_full/band/events.rpy:823
translate russian kleioannafoursome2_16459398:
    "Может, мне кажется, но с тех пор, как мы решились на отношения вчетвером, группа стала куда более слаженной."

# ch/harems_full/band/events.rpy:824
translate russian kleioannafoursome2_a14813a5:
    "Даже на репетициях мы словно заранее знаем, что сделает другой, будто мыслим как одно целое."

# ch/harems_full/band/events.rpy:825
translate russian kleioannafoursome2_d6371a4f:
    "После первой же репетиции вслед за нашим дебютом вчетвером воздух в тесной комнате невероятно накаляется."

# ch/harems_full/band/events.rpy:826
translate russian kleioannafoursome2_f6a607b3:
    "Я играю как виртуоз, но всё равно представляю девушек в самых непристойных позах."

# ch/harems_full/band/events.rpy:827
translate russian kleioannafoursome2_1687c41e:
    "Они, должно быть, чувствуют то же: мы постоянно переглядываемся, а когда кажется, что никто не видит, откровенно разглядываем друг друга."

# ch/harems_full/band/events.rpy:828
translate russian kleioannafoursome2_fe9322d3:
    "Когда мы наконец решаем закончить на сегодня, совершенно ясно: заканчивать вечер никто не хочет."

# ch/harems_full/band/events.rpy:829
translate russian kleioannafoursome2_476654ad:
    mike.say "Эм... Может, кто-нибудь хочет зайти ко мне?"

# ch/harems_full/band/events.rpy:830
translate russian kleioannafoursome2_990d5006:
    mike.say "Можем... посмотреть что-нибудь на Nutflix?"

# ch/harems_full/band/events.rpy:832
translate russian kleioannafoursome2_8142bbf8:
    kleio.say "Ещё бы предложил зайти посмотреть твою коллекцию гравюр!"

# ch/harems_full/band/events.rpy:834
translate russian kleioannafoursome2_2c480c3b:
    sasha.say "Ты пытаешься позвать нас всех потрахаться?"

# ch/harems_full/band/events.rpy:836
translate russian kleioannafoursome2_7e8eb9d5:
    mike.say "Ну... раз уж ты заговорила об этом..."

# ch/harems_full/band/events.rpy:838
translate russian kleioannafoursome2_e5ed0aea:
    anna.say "Мне нравится! Иначе я просто пошла бы домой и снова ласкала себя, пока не усну!"

# ch/harems_full/band/events.rpy:839
translate russian kleioannafoursome2_84e716b9:
    "Что ж, вопрос решён."

# ch/harems_full/band/events.rpy:841
translate russian kleioannafoursome2_921e01a5:
    "Я ещё не успеваю толком осмыслить происходящее, а мы уже дома, в моей спальне, и все четверо нетерпеливо раздеваемся."

# ch/harems_full/band/events.rpy:842
translate russian kleioannafoursome2_f65ac336:
    "Клео кажется самой уставшей: она томно откидывается на изголовье."

# ch/harems_full/band/events.rpy:843
translate russian kleioannafoursome2_7c4662ae:
    "Саша растягивается сбоку кровати. Её тёмные глаза открыты, но сонливость лишь добавляет обаяния."

# ch/harems_full/band/events.rpy:844
translate russian kleioannafoursome2_d514bca5:
    "А Анна, напротив, бодрее и нетерпеливее всех: почти запрыгивает на середину кровати, словно возбуждённый щенок."

# ch/harems_full/band/events.rpy:846
translate russian kleioannafoursome2_84d6aa56:
    "Мы с Сашей и Клео понимающе улыбаемся: кажущаяся безграничной энергия Анны возбуждает и бодрит каждого."

# ch/harems_full/band/events.rpy:847
translate russian kleioannafoursome2_327ac2fb:
    kleio.say "Эй, тише, девочка!"

# ch/harems_full/band/events.rpy:848
translate russian kleioannafoursome2_f4c9ea61:
    "Словно поняв, что напоминает нам нетерпеливую собачку, Анна улыбается и встаёт на четвереньки."

# ch/harems_full/band/events.rpy:850
translate russian kleioannafoursome2_c42ca134:
    "Она высовывает язык и тянется лизнуть обнажённую киску Клео, заслужив возбуждённый смешок."

# ch/harems_full/band/events.rpy:852
translate russian kleioannafoursome2_ffe5ee3c:
    "Через секунду оглядывается на меня и виляет попкой, словно демонстрирует хвостик."

# ch/harems_full/band/events.rpy:853
translate russian kleioannafoursome2_a4f5439f:
    "Заметив реакцию моего члена, она ухмыляется, начинает часто дышать и поскуливать."

# ch/harems_full/band/events.rpy:854
translate russian kleioannafoursome2_15c1f4d1:
    "Я уже собираюсь наброситься на попку Анны, но Саша опирается на неё локтем и ловит мой взгляд."

# ch/harems_full/band/events.rpy:855
translate russian kleioannafoursome2_a19c4152:
    "Медленно улыбаясь, она гладит мой член снизу, явно предлагая совсем другой вариант."

# ch/harems_full/band/events.rpy:866
translate russian kleioannafoursome2_d3b34dd3:
    "Как ни хороши сейчас губы Саши, я смотрю лишь на те, что между ног у Анны."

# ch/harems_full/band/events.rpy:868
translate russian kleioannafoursome2_a2c951db:
    "Поспешно хватаю презерватив с тумбочки, надеваю и руками ещё шире развожу ягодицы Анны."

# ch/harems_full/band/events.rpy:870
translate russian kleioannafoursome2_5c920d1c:
    "Тянуть незачем: Анна уже более чем готова, и я медленно, но уверенно вхожу."

# ch/harems_full/band/events.rpy:871
translate russian kleioannafoursome2_3202ae8e:
    "Не обидевшись на небольшое пренебрежение, Саша наклоняется и лижет обнажённый анус Анны, а та продолжает ласкать языком киску Клео."

# ch/harems_full/band/events.rpy:872
translate russian kleioannafoursome2_1c0afbbe:
    "Мы с Сашей смотрим на Клео, наслаждающуюся языком Анны, словно передаём ей удовольствие через миниатюрную девушку."

# ch/harems_full/band/events.rpy:874
translate russian kleioannafoursome2_cae1867c:
    "Может, поэтому, когда я приближаюсь к пределу, а Анна начинает вскрикивать, Клео тоже ползёт вверх по изголовью навстречу своему оргазму."

# ch/harems_full/band/events.rpy:875
translate russian kleioannafoursome2_a566a544:
    "Наконец я кончаю, почти вколачиваясь в киску Анны; её ягодицы дрожат с каждым толчком."

# ch/harems_full/band/events.rpy:876
translate russian kleioannafoursome2_c622b0ab:
    "Презерватив удерживает всё как положено, но сила разрядки уносит за грань и Анну."

# ch/harems_full/band/events.rpy:877
translate russian kleioannafoursome2_4bcdce70:
    "Она перестаёт лизать Клео и отчаянно вскрикивает, поддавшись оргазму."

# ch/harems_full/band/events.rpy:879
translate russian kleioannafoursome2_3b1f1102:
    "Что тут скажешь? Киска Анны зовёт меня, и я отвечаю."

# ch/harems_full/band/events.rpy:881
translate russian kleioannafoursome2_c9a3ea3f:
    "На проникновение хватает нескольких секунд: она уже влажная и готова принять меня."

# ch/harems_full/band/events.rpy:882
translate russian kleioannafoursome2_1900304c:
    "Когда я начинаю двигаться, Саша склоняется над ягодицами Анны и лижет её тугой анус."

# ch/harems_full/band/events.rpy:883
translate russian kleioannafoursome2_796ad55b:
    "Анна продолжает лизать киску Клео, и мы четверо сливаемся в клубок голов, конечностей и отверстий, жаждущих наполнения."

# ch/harems_full/band/events.rpy:885
translate russian kleioannafoursome2_47230057:
    "Кажется, первой кончает Клео: откидывается спиной к стене и глубоко стонет."

# ch/harems_full/band/events.rpy:886
translate russian kleioannafoursome2_dffa4e16:
    "Затем волна словно проходит через нас: Анна дрожит, а через несколько секунд я тоже чувствую приближение оргазма."

# ch/harems_full/band/events.rpy:887
translate russian kleioannafoursome2_3e941e60:
    "Анна облегает меня как перчатка, сжимает так плотно, что внутри, кажется, больше ни для чего нет места."

# ch/harems_full/band/events.rpy:889
translate russian kleioannafoursome2_9f42e1f3:
    "Но когда я наконец теряю себя и взрываюсь в этой восхитительной тесноте, эффект оказывается оглушительным."

# ch/harems_full/band/events.rpy:891
translate russian kleioannafoursome2_65bf4192:
    "Анна беспомощно вскрикивает от возбуждения и тоже кончает, сжимая меня киской словно стиснутой ладонью."

# ch/harems_full/band/events.rpy:893
translate russian kleioannafoursome2_c836462b:
    "Передо мной и половые губки Анны, и накрашенные чёрным губы Саши: влажные, манящие и совсем рядом."

# ch/harems_full/band/events.rpy:894
translate russian kleioannafoursome2_19b5b625:
    "Выбрать настолько трудно, что я решаю не выбирать."

# ch/harems_full/band/events.rpy:896
translate russian kleioannafoursome2_60cbd865:
    "Сначала хватаю упругие ягодицы Анны и вхожу в неё как можно глубже."

# ch/harems_full/band/events.rpy:897
translate russian kleioannafoursome2_0106bcda:
    "Она пищит от удовольствия, а на лице обойдённой вниманием Саши мелькает разочарование."

# ch/harems_full/band/events.rpy:899
translate russian kleioannafoursome2_89c37863:
    "Но после нескольких толчков я без предупреждения выхожу и натягиваю губы Саши на свой член."

# ch/harems_full/band/events.rpy:900
translate russian kleioannafoursome2_75136fad:
    "Она на миг давится от неожиданности, но поддаётся, чтобы не задохнуться, и вскоре с энтузиазмом ласкает меня."

# ch/harems_full/band/events.rpy:902
translate russian kleioannafoursome2_a1239edd:
    "Прежде чем она успевает довести меня до оргазма, я отстраняюсь и без предупреждения снова вхожу в попку Анны."

# ch/harems_full/band/events.rpy:903
translate russian kleioannafoursome2_718c3761:
    "Её усталое дыхание опять сменяется пронзительным писком удовольствия."

# ch/harems_full/band/events.rpy:904
translate russian kleioannafoursome2_ba3c252b:
    "Саша смотрит на меня лёжа, по подбородку стекает слюна."

# ch/harems_full/band/events.rpy:905
translate russian kleioannafoursome2_51f7f8c5:
    "На её лице растерянность, щёки пылают, но рука уже тянется к киске от возбуждения."

# ch/harems_full/band/events.rpy:907
translate russian kleioannafoursome2_275f3c1b:
    "Я уже знаю, как Анна любит, когда её берут сзади, и от этого завожусь ещё сильнее."

# ch/harems_full/band/events.rpy:908
translate russian kleioannafoursome2_76252e0c:
    "Я всё яростнее толкаюсь в её маленькую упругую попку и слишком скоро чувствую приближение оргазма."

# ch/harems_full/band/events.rpy:910
translate russian kleioannafoursome2_454a6357:
    "Кажется, я не смог бы вытащить, даже если бы захотел. Слушая её возбуждённые крики, я непрерывно изливаюсь в неё."

# ch/harems_full/band/events.rpy:912
translate russian kleioannafoursome2_9342e9f2:
    "Но через секунду понимаю, что сам тоже на грани."

# ch/harems_full/band/events.rpy:913
translate russian kleioannafoursome2_a71d2af1:
    "Решаю, что Саша заслужила награду..."

# ch/harems_full/band/events.rpy:917
translate russian kleioannafoursome2_b937c263:
    "Обхватываю её голову обеими руками и опускаю ниже, когда меня наконец накрывает оргазм."

# ch/harems_full/band/events.rpy:919
translate russian kleioannafoursome2_1decbf07:
    "Слыша, как Саша давится и захлёбывается с полным ртом члена и спермы, надеюсь, что она не забыла дышать носом."

# ch/harems_full/band/events.rpy:922
translate russian kleioannafoursome2_29ed50c8:
    "Я решаю вытащить член из попки Анны."

# ch/harems_full/band/events.rpy:924
translate russian kleioannafoursome2_b6a2095d:
    "Влажный от соков, он на миг покачивается перед лицом Саши, а затем разражается фонтаном."

# ch/harems_full/band/events.rpy:926
translate russian kleioannafoursome2_60f005af:
    "Саша удивлённо открывает рот, и липкая белая масса покрывает её лицо. Я немного чувствую себя зверем, метящим территорию."

# ch/harems_full/band/events.rpy:929
translate russian kleioannafoursome2_0ed74eb6:
    "Вижу лишь покачивающуюся попку Анны и в эту секунду хочу её сильнее всего на свете."

# ch/harems_full/band/events.rpy:931
translate russian kleioannafoursome2_efc65459:
    "Обхватив ягодицы, безжалостно вхожу в её анус, проталкиваясь как можно глубже."

# ch/harems_full/band/events.rpy:932
translate russian kleioannafoursome2_94ed0ea9:
    "Удивлённый писк Анны лишь сильнее заводит меня. Я начинаю двигаться, надеясь услышать ещё."

# ch/harems_full/band/events.rpy:933
translate russian kleioannafoursome2_42bb52f4:
    "Пока я толкаюсь в неё, Саша склоняется над её ягодицами и одновременно лижет тугой анус и мой член."

# ch/harems_full/band/events.rpy:935
translate russian kleioannafoursome2_76eddbca:
    "Анне нужна вся сила воли, чтобы продолжать ласкать Клео, пока её саму ублажают сразу с двух сторон."

# ch/harems_full/band/events.rpy:936
translate russian kleioannafoursome2_e6393f00:
    "Мы все приближаемся к неизбежной разрядке. Интересно, нас возбуждают крики Анны потому, что мы её так завели..."

# ch/harems_full/band/events.rpy:937
translate russian kleioannafoursome2_d8b9304e:
    "Или потому, что она звучит как раненое беспомощное животное, а в нас вдруг проснулись охотники?"

# ch/harems_full/band/events.rpy:938
translate russian kleioannafoursome2_275f3c1b_1:
    "Я уже знаю, как Анна любит, когда её берут сзади, и от этого завожусь ещё сильнее."

# ch/harems_full/band/events.rpy:940
translate russian kleioannafoursome2_76252e0c_1:
    "Я всё яростнее толкаюсь в её маленькую упругую попку и слишком скоро чувствую приближение оргазма."

# ch/harems_full/band/events.rpy:941
translate russian kleioannafoursome2_454a6357_1:
    "Кажется, я не смог бы вытащить, даже если бы захотел. Слушая её возбуждённые крики, я непрерывно изливаюсь в неё."

# ch/harems_full/band/events.rpy:944
translate russian kleioannafoursome2_f4092e96:
    "Губки Анны манят, но не так сильно, как накрашенные чёрным губы Саши, которые она сейчас вызывающе облизывает."

# ch/harems_full/band/events.rpy:945
translate russian kleioannafoursome2_1eea9021:
    "Я поворачиваю член к Саше, вдруг забыв о подставленной попке Анны."

# ch/harems_full/band/events.rpy:947
translate russian kleioannafoursome2_cc013438:
    "Саша явно торжествует, начиная целовать и облизывать головку."

# ch/harems_full/band/events.rpy:948
translate russian kleioannafoursome2_3e47ea76:
    "Вскоре она шире раздвигает губы и медленно принимает головку в рот, затем — столько члена, сколько может."

# ch/harems_full/band/events.rpy:949
translate russian kleioannafoursome2_9a9bf902:
    "В эту секунду я забываю о двух других девушках: во рту Саши чертовски хорошо."

# ch/harems_full/band/events.rpy:951
translate russian kleioannafoursome2_396d0362:
    "Анна и Клео, должно быть, продолжают своё занятие: я слышу стоны, которые издаю не я и уж точно не Саша."

# ch/harems_full/band/events.rpy:952
translate russian kleioannafoursome2_9342e9f2_1:
    "Но через секунду понимаю, что сам тоже на грани."

# ch/harems_full/band/events.rpy:955
translate russian kleioannafoursome2_5338e94f:
    "Не знаю, собирается ли Саша отпустить меня до оргазма, но я этого не хочу."

# ch/harems_full/band/events.rpy:957
translate russian kleioannafoursome2_019758fe:
    "Обхватываю её голову обеими руками и удерживаю внизу, когда меня наконец накрывает оргазм."

# ch/harems_full/band/events.rpy:959
translate russian kleioannafoursome2_1decbf07_1:
    "Слыша, как Саша давится и захлёбывается с полным ртом члена и спермы, надеюсь, что она не забыла дышать носом."

# ch/harems_full/band/events.rpy:962
translate russian kleioannafoursome2_f3ed7015:
    "Прежде чем Саша решает за меня, я вынимаю член из её рта."

# ch/harems_full/band/events.rpy:964
translate russian kleioannafoursome2_93a4331f:
    "Влажный от слюны, он на миг покачивается перед её лицом, а затем разражается фонтаном."

# ch/harems_full/band/events.rpy:966
translate russian kleioannafoursome2_60f005af_1:
    "Саша удивлённо открывает рот, и липкая белая масса покрывает её лицо. Я немного чувствую себя зверем, метящим территорию."

# ch/harems_full/band/events.rpy:968
translate russian kleioannafoursome2_b19abe66:
    "Кажется, на пути к оргазму каждый потратил последние силы, оставшиеся после репетиции."

# ch/harems_full/band/events.rpy:969
translate russian kleioannafoursome2_0a6e0e98:
    "Даже Клео, почти не двигавшаяся во время наших ласк вчетвером, готова отключиться."

# ch/harems_full/band/events.rpy:970
translate russian kleioannafoursome2_229f68e7:
    "Не знаю, вызывать ли всем такси или предложить остаться на ночь."

# ch/harems_full/band/events.rpy:971
translate russian kleioannafoursome2_a2d2cbcf:
    "Но громкий храп Анны сразу снимает вопрос о том, чтобы выпроводить девушек до утра."

# ch/harems_full/band/events.rpy:972
translate russian kleioannafoursome2_326b6101:
    "Повезло, что я купил кровать, на которой мы почти можем удобно устроиться вчетвером."

# ch/harems_full/band/events.rpy:973
translate russian kleioannafoursome2_2f189de0:
    "А ещё больше повезло делить её с такими женщинами, как Саша, Клео и Анна."

# ch/harems_full/band/events.rpy:982
translate russian anna_kleio_propose_male_dfb97224:
    "Я бы и перед одной девушкой сильно нервничал, собираясь опуститься на колено и предложить выйти за меня."

# ch/harems_full/band/events.rpy:983
translate russian anna_kleio_propose_male_46494f4c:
    "Представляете, насколько страшнее сделать это перед двумя?"

# ch/harems_full/band/events.rpy:984
translate russian anna_kleio_propose_male_e06db9aa:
    "И словно этого мало, речь ведь об Анне и Клео."

# ch/harems_full/band/events.rpy:985
translate russian anna_kleio_propose_male_e3737821:
    "Ни одну из них не назовёшь простой девушкой с традиционными взглядами!"

# ch/harems_full/band/events.rpy:986
translate russian anna_kleio_propose_male_a6957c9f:
    "Но я люблю этих женщин и хочу провести с ними всю оставшуюся жизнь."

# ch/harems_full/band/events.rpy:987
translate russian anna_kleio_propose_male_a00fd908:
    "Значит, придётся постараться и понять, как всё устроить."

# ch/harems_full/band/events.rpy:988
translate russian anna_kleio_propose_male_b9e711be:
    "Полигамию узаконили совсем недавно, так что я, наверное, один из первых, кто делает такое предложение."

# ch/harems_full/band/events.rpy:989
translate russian anna_kleio_propose_male_c5459301:
    "Ориентироваться остаётся лишь на собственные чувства."

# ch/harems_full/band/events.rpy:990
translate russian anna_kleio_propose_male_980024f5:
    "Вот так я и оказываюсь на одном колене перед Анной и Клео."

# ch/harems_full/band/events.rpy:991
translate russian anna_kleio_propose_male_865e014c:
    "Я постарался придерживаться традиции и сделать сюрприз."

# ch/harems_full/band/events.rpy:992
translate russian anna_kleio_propose_male_e8b7182d:
    "Наверное, поэтому им требуется время, чтобы обернуться и заметить меня внизу."

# ch/harems_full/band/events.rpy:996
translate russian anna_kleio_propose_male_75b1b567:
    anna.say "Ой, я тебя там не заметила!"

# ch/harems_full/band/events.rpy:998
translate russian anna_kleio_propose_male_5ce75cf9:
    anna.say "Что случилось, [lssb_common.hero_name()]?"

# ch/harems_full/band/events.rpy:999
translate russian anna_kleio_propose_male_aae38c0d:
    kleio.say "Да, сердцеед, что такое?"

# ch/harems_full/band/events.rpy:1001
translate russian anna_kleio_propose_male_3f648e77:
    kleio.say "На какашке поскользнулся, что ли?"

# ch/harems_full/band/events.rpy:1002
translate russian anna_kleio_propose_male_241e347a:
    "Как обычно, лицо Анны читается как открытая книга: она явно не понимает, что я делаю."

# ch/harems_full/band/events.rpy:1003
translate russian anna_kleio_propose_male_5f566c6f:
    "Но и то, как Клео прячет свои чувства, я уже хорошо знаю."

# ch/harems_full/band/events.rpy:1004
translate russian anna_kleio_propose_male_a20ac7b1:
    "Поэтому вижу: за бравадой она застигнута врасплох не меньше Анны."

# ch/harems_full/band/events.rpy:1005
translate russian anna_kleio_propose_male_b6b8c715:
    "Стоило бы объясниться, хотя бы чтобы их успокоить."

# ch/harems_full/band/events.rpy:1006
translate russian anna_kleio_propose_male_81e4aaab:
    "Но я уже лезу в карман за парными кольцами, купленными для этого случая."

# ch/harems_full/band/events.rpy:1007
translate russian anna_kleio_propose_male_7fe01422:
    "Поэтому первые слова, наверное, объясняют происходящее."

# ch/harems_full/band/events.rpy:1008
translate russian anna_kleio_propose_male_0164d556:
    "Но одновременно переводят всё внимание на Анну и Клео: теперь вопрос к ним."

# ch/harems_full/band/events.rpy:1011
translate russian anna_kleio_propose_male_90cfca36:
    mike.say "А... Анна... Клео..."

# ch/harems_full/band/events.rpy:1012
translate russian anna_kleio_propose_male_0e210a73:
    mike.say "Я хотел спросить..."

# ch/harems_full/band/events.rpy:1014
translate russian anna_kleio_propose_male_48a18488:
    mike.say "И друг за друга, наверное, тоже!"

# ch/harems_full/band/events.rpy:1017
translate russian anna_kleio_propose_male_0f5b4c3f:
    "Не думал, что глаза Анны могут раскрыться ещё шире, но именно это и происходит."

# ch/harems_full/band/events.rpy:1018
translate russian anna_kleio_propose_male_4190dec4:
    "Она молча качает головой. Остаётся надеяться, что просто не верит."

# ch/harems_full/band/events.rpy:1019
translate russian anna_kleio_propose_male_6a1effa2:
    "Клео тоже молчит: её вечно язвительный рот приоткрыт от удивления."

# ch/harems_full/band/events.rpy:1020
translate russian anna_kleio_propose_male_76585f15:
    "Так что, каким бы ни был исход, одно можно сказать точно."

# ch/harems_full/band/events.rpy:1021
translate russian anna_kleio_propose_male_9148452c:
    "Я наконец сказал то, на что у неё не нашлось колкого ответа!"

# ch/harems_full/band/events.rpy:1022
translate russian anna_kleio_propose_male_bff146ba:
    "Всё это время я смотрю снизу то на Анну, то на Клео."

# ch/harems_full/band/events.rpy:1023
translate russian anna_kleio_propose_male_e3d311bc:
    "С моего вопроса прошло от силы около минуты."

# ch/harems_full/band/events.rpy:1024
translate russian anna_kleio_propose_male_fa0be218:
    "Но кажется, что я стою здесь уже целую вечность."

# ch/harems_full/band/events.rpy:1028
translate russian anna_kleio_propose_male_89c873d9:
    "Вдруг Клео разворачивает Анну к себе и притягивает поближе."

# ch/harems_full/band/events.rpy:1029
translate russian anna_kleio_propose_male_ac93148f:
    "Отвернувшись от меня, они начинают тихо совещаться."

# ch/harems_full/band/events.rpy:1030
translate russian anna_kleio_propose_male_dae51c28:
    "Как ни стараюсь, разобрать их слова не могу."

# ch/harems_full/band/events.rpy:1031
translate russian anna_kleio_propose_male_0da8d06b:
    "Остаётся ждать. Каждый их взгляд в мою сторону разжигает надежду."

# ch/harems_full/band/events.rpy:1032
translate russian anna_kleio_propose_male_3688e4a1:
    "Каждый раз я жду ответа, который, хорошим или плохим, закончит эту пытку."

# ch/harems_full/band/events.rpy:1036
translate russian anna_kleio_propose_male_419d39b2:
    "Но когда они наконец заканчивают совещание, напряжение ничуть не спадает."

# ch/harems_full/band/events.rpy:1037
translate russian anna_kleio_propose_male_4b0f81d1:
    "Теперь я жду их ответа, решения моей судьбы."

# ch/harems_full/band/events.rpy:1038
translate russian anna_kleio_propose_male_1129856e:
    "И, кажется, вся способность читать выражения их лиц меня покинула..."

# ch/harems_full/band/events.rpy:1041
translate russian anna_kleio_propose_male_a3d89adb:
    anna.say "[lssb_common.hero_name()], это так мило с твоей стороны!"

# ch/harems_full/band/events.rpy:1043
translate russian anna_kleio_propose_male_2f4a42e5:
    kleio.say "Да, сердцеед, даже я тронута."

# ch/harems_full/band/events.rpy:1044
translate russian anna_kleio_propose_male_4c3344fe:
    "О чёрт. Это не может означать ничего хорошего."

# ch/harems_full/band/events.rpy:1045
translate russian anna_kleio_propose_male_1c38a142:
    "Они просто льстят, говорят, как мило было сделать им предложение."

# ch/harems_full/band/events.rpy:1046
translate russian anna_kleio_propose_male_ad421760:
    "Ни малейшего намёка на да или нет."

# ch/harems_full/band/events.rpy:1047
translate russian anna_kleio_propose_male_cf33b279:
    "А будь ответ положительным, им незачем было бы щадить мои чувства и задабривать меня."

# ch/harems_full/band/events.rpy:1048
translate russian anna_kleio_propose_male_7a618a3b:
    "Значит, только нет."

# ch/harems_full/band/events.rpy:1049
translate russian anna_kleio_propose_male_7d58065e:
    mike.say "Но замуж за меня вы не хотите, верно?"

# ch/harems_full/band/events.rpy:1051
translate russian anna_kleio_propose_male_837c4817:
    "При этих словах брови Анны взлетают вверх. Она искренне потрясена."

# ch/harems_full/band/events.rpy:1052
translate russian anna_kleio_propose_male_691d6a9e:
    anna.say "Чт..."

# ch/harems_full/band/events.rpy:1053
translate russian anna_kleio_propose_male_fa184684:
    anna.say "Но как ты узнал?!"

# ch/harems_full/band/events.rpy:1055
translate russian anna_kleio_propose_male_bdea630e:
    "Клео закатывает глаза от восклицания Анны, но в её лице есть и другое."

# ch/harems_full/band/events.rpy:1056
translate russian anna_kleio_propose_male_6d42f42f:
    "Она понимает, что они практически раскрыли карты и выдали свои намерения."

# ch/harems_full/band/events.rpy:1057
translate russian anna_kleio_propose_male_ad6036ed:
    kleio.say "Неважно, как он узнал, Анна."

# ch/harems_full/band/events.rpy:1058
translate russian anna_kleio_propose_male_513bdd52:
    kleio.say "Важно, как он это примет."

# ch/harems_full/band/events.rpy:1060
translate russian anna_kleio_propose_male_996186ca:
    "Перед ответом я делаю паузу, не отводя глаз от Клео."

# ch/harems_full/band/events.rpy:1061
translate russian anna_kleio_propose_male_21fa2ecb:
    "Как всегда, в её взгляде невысказанный вызов."

# ch/harems_full/band/events.rpy:1062
translate russian anna_kleio_propose_male_505edadb:
    "Но за ним чувствуется и глубокая тоска, почти печаль от происходящего."

# ch/harems_full/band/events.rpy:1063
translate russian anna_kleio_propose_male_2ea12054:
    "Словно Клео понимает, что причиняет мне боль."

# ch/harems_full/band/events.rpy:1064
translate russian anna_kleio_propose_male_6b42c313:
    "И всё же не может согласиться лишь ради моих чувств."

# ch/harems_full/band/events.rpy:1065
translate russian anna_kleio_propose_male_acdb2e08:
    mike.say "Я... я понимаю, Клео."

# ch/harems_full/band/events.rpy:1066
translate russian anna_kleio_propose_male_7b0f7df1:
    mike.say "Ничего страшного..."

# ch/harems_full/band/events.rpy:1068
translate russian anna_kleio_propose_male_1d9d36a3:
    kleio.say "Дело не в тебе, сердцеед. Я серьёзно."

# ch/harems_full/band/events.rpy:1069
translate russian anna_kleio_propose_male_c9e6c0a9:
    kleio.say "Нам сейчас так хорошо, понимаешь?"

# ch/harems_full/band/events.rpy:1070
translate russian anna_kleio_propose_male_058b1d3a:
    kleio.say "Мы ещё не готовы надеть кольца и остепениться."

# ch/harems_full/band/events.rpy:1073
translate russian anna_kleio_propose_male_39171006:
    anna.say "Но... нам теперь не обязательно расставаться, правда?!"

# ch/harems_full/band/events.rpy:1074
translate russian anna_kleio_propose_male_900adf81:
    "Я качаю головой, стараясь ценить то, что у меня уже есть."

# ch/harems_full/band/events.rpy:1075
translate russian anna_kleio_propose_male_f13cdf80:
    "Повторяю себе, что всё хорошо и пока ничего не нужно менять."

# ch/harems_full/band/events.rpy:1076
translate russian anna_kleio_propose_male_03bf420a:
    mike.say "Нет, Анна, расставаться не обязательно."

# ch/harems_full/band/events.rpy:1077
translate russian anna_kleio_propose_male_c1635a38:
    mike.say "Если я вам обеим ещё нужен, вы мне точно нужны."

# ch/harems_full/band/events.rpy:1079
translate russian anna_kleio_propose_male_206673a7:
    anna.say "Ура!"

# ch/harems_full/band/events.rpy:1080
translate russian anna_kleio_propose_male_ba070b1e:
    anna.say "Отпразднуем жарким примирительным сексом!"

# ch/harems_full/band/events.rpy:1082
translate russian anna_kleio_propose_male_9632cd98:
    "Клео бросает на меня иронично-весёлый взгляд, и я смеюсь вместе с ней."

# ch/harems_full/band/events.rpy:1084
translate russian anna_kleio_propose_male_eaeccd85:
    "Но одновременно почти чувствую исходящее от неё облегчение..."

# ch/harems_full/band/events.rpy:1090
translate russian anna_kleio_propose_male_faf6c59d:
    "Когда Анна и Клео поворачиваются ко мне, я подаюсь вперёд в ожидании."

# ch/harems_full/band/events.rpy:1091
translate russian anna_kleio_propose_male_aa8c25ba:
    "Но Клео совершенно неожиданно выхватывает кольца из моей руки."

# ch/harems_full/band/events.rpy:1092
translate russian anna_kleio_propose_male_88dbc1ae:
    "Я ошеломлённо молчу, пока она натягивает одно на палец Анны."

# ch/harems_full/band/events.rpy:1093
translate russian anna_kleio_propose_male_1a0e85e2:
    "А потом надевает второе себе!"

# ch/harems_full/band/events.rpy:1094
translate russian anna_kleio_propose_male_a8e4db37:
    kleio.say "Повезло тебе, сердцеед."

# ch/harems_full/band/events.rpy:1096
translate russian anna_kleio_propose_male_77b857fe:
    kleio.say "Мы согласны!"

# ch/harems_full/band/events.rpy:1098
translate russian anna_kleio_propose_male_09ce1c20:
    anna.say "Да, [lssb_common.hero_name()], мы с радостью выйдем за тебя."

# ch/harems_full/band/events.rpy:1099
translate russian anna_kleio_propose_male_497cb035:
    anna.say "И друг за друга тоже!"

# ch/harems_full/band/events.rpy:1100
translate russian anna_kleio_propose_male_fce77757:
    "Я начинаю подниматься, пытаясь найти слова для своих чувств."

# ch/harems_full/band/events.rpy:1101
translate russian anna_kleio_propose_male_38cb3188:
    "Но губы лишь беззвучно шевелятся: эмоции захлёстывают."

# ch/harems_full/band/events.rpy:1103
translate russian anna_kleio_propose_male_e18b0a1a:
    kleio.say "Только не радуйся слишком бурно, сердцеед."

# ch/harems_full/band/events.rpy:1104
translate russian anna_kleio_propose_male_892edc4f:
    kleio.say "Нельзя же дать девушке почувствовать себя слишком особенной!"

# ch/harems_full/band/events.rpy:1106
translate russian anna_kleio_propose_male_ed54f106:
    anna.say "Не слушай её, [lssb_common.hero_name()]."

# ch/harems_full/band/events.rpy:1107
translate russian anna_kleio_propose_male_091ef623:
    anna.say "Она просто дразнится."

# ch/harems_full/band/events.rpy:1108
translate russian anna_kleio_propose_male_d94270f6:
    anna.say "И скрывает, что счастлива не меньше меня!"

# ch/harems_full/band/events.rpy:1109
translate russian anna_kleio_propose_male_4859c3b4:
    mike.say "Я... я тоже очень счастлив, Анна!"

# ch/harems_full/band/events.rpy:1110
translate russian anna_kleio_propose_male_0fef4811:
    kleio.say "Ещё бы, сердцеед."

# ch/harems_full/band/events.rpy:1112
translate russian anna_kleio_propose_male_c1d6c8b4:
    kleio.say "Не каждый день две горячие красотки говорят «да» такому неудачнику!"

# ch/harems_full/band/events.rpy:1114
translate russian anna_kleio_propose_male_995c6d84:
    anna.say "Эй, Клео! Если он неудачник, то кто тогда ты?"

# ch/harems_full/band/events.rpy:1115
translate russian anna_kleio_propose_male_ce4074d6:
    anna.say "Ты ведь за него выходишь!"

# ch/harems_full/band/events.rpy:1117
translate russian anna_kleio_propose_male_f97b081d:
    kleio.say "Я... ну... я не это..."

# ch/harems_full/band/events.rpy:1118
translate russian anna_kleio_propose_male_14ada042:
    kleio.say "А, заткнись, Анна!"

# ch/harems_full/band/events.rpy:1120
translate russian anna_kleio_propose_male_4c6ae4cb:
    "На лице Анны появляется кошачья улыбка."

# ch/harems_full/band/events.rpy:1121
translate russian anna_kleio_propose_male_145c2693:
    "Она явно довольна, что хоть раз загнала Клео в угол."

# ch/harems_full/band/events.rpy:1122
translate russian anna_kleio_propose_male_4fcb3bd4:
    mike.say "Оставь её, Анна."

# ch/harems_full/band/events.rpy:1123
translate russian anna_kleio_propose_male_058fba91:
    mike.say "Сейчас нам всем троим стоит праздновать."

# ch/harems_full/band/events.rpy:1125
translate russian anna_kleio_propose_male_43044036:
    anna.say "Ладно, [lssb_common.hero_name()], как скажешь."

# ch/harems_full/band/events.rpy:1126
translate russian anna_kleio_propose_male_e3f0d6e1:
    anna.say "Погоди! У меня кольцо есть, у Клео тоже."

# ch/harems_full/band/events.rpy:1127
translate russian anna_kleio_propose_male_41b36bc2:
    anna.say "А как же ты?"

# ch/harems_full/band/events.rpy:1128
translate russian anna_kleio_propose_male_120ebd04:
    anna.say "Тебе тоже купить?"

# ch/harems_full/band/events.rpy:1130
translate russian anna_kleio_propose_male_88319061:
    "Клео снова улыбается, оправившись от заминки."

# ch/harems_full/band/events.rpy:1131
translate russian anna_kleio_propose_male_bd89b036:
    kleio.say "У меня есть для тебя колечко, сердцеед."

# ch/harems_full/band/events.rpy:1132
translate russian anna_kleio_propose_male_54e3b835:
    "Она кладёт ладони на ягодицы и сжимает их."

# ch/harems_full/band/events.rpy:1133
translate russian anna_kleio_propose_male_f2edeea3:
    kleio.say "Вот здесь."

# ch/harems_full/band/events.rpy:1134
translate russian anna_kleio_propose_male_681f64e8:
    kleio.say "И надевать его я хочу вовсе не на палец..."

# ch/harems_full/band/events.rpy:1135
translate russian anna_kleio_propose_male_fe14bc43:
    "Анна нервно хихикает, а я начинаю потеть."

# ch/harems_full/band/events.rpy:1136
translate russian anna_kleio_propose_male_0c5f4a4f:
    "Если это лишь намёк на то, что ждёт меня в браке..."

# ch/harems_full/band/events.rpy:1137
translate russian anna_kleio_propose_male_6afc7de4:
    "Что ж, пусть он длится до конца наших жизней!"

# ch/harems_full/band/events.rpy:1150
translate russian anna_kleio_male_ending_9375bc7f:
    "Как большинство парней, я редко представлял, как будет выглядеть моя свадьба."

# ch/harems_full/band/events.rpy:1151
translate russian anna_kleio_male_ending_1722eda8:
    "Чёрт, я даже почти не задумывался, женюсь ли ВООБЩЕ."

# ch/harems_full/band/events.rpy:1152
translate russian anna_kleio_male_ending_5443ac8d:
    "Я знаю, что девушка, за годы заранее спланировавшая свадьбу, — всего лишь стереотип."

# ch/harems_full/band/events.rpy:1153
translate russian anna_kleio_male_ending_8872173d:
    "Но думаю, даже Анна и Клео никогда не представляли всё именно так!"

# ch/harems_full/band/events.rpy:1154
translate russian anna_kleio_male_ending_e3263839:
    "Уже то, что сегодня женимся мы трое, достаточно безумно."

# ch/harems_full/band/events.rpy:1155
translate russian anna_kleio_male_ending_c2a9746c:
    "А ведь мы ещё и решили сделать это в ночном клубе!"

# ch/harems_full/band/events.rpy:1156
translate russian anna_kleio_male_ending_fb60cc1d:
    "Конечно, не в случайном."

# ch/harems_full/band/events.rpy:1157
translate russian anna_kleio_male_ending_fb381ab8:
    "Это наше любимое место для ночных танцев в самых вызывающих позах."

# ch/harems_full/band/events.rpy:1158
translate russian anna_kleio_male_ending_73a1f11d:
    "С ним связаны и одни из лучших воспоминаний о нас троих."

# ch/harems_full/band/events.rpy:1159
translate russian anna_kleio_male_ending_852c9bf1:
    "Когда мы сели обсуждать детали, выбор показался совершенно естественным."

# ch/harems_full/band/events.rpy:1160
translate russian anna_kleio_male_ending_bec05a74:
    "Отношения у нас необычные — зачем тогда обычная свадьба?"

# ch/harems_full/band/events.rpy:1161
translate russian anna_kleio_male_ending_99059ad8:
    "А ещё есть мелочи, о которых не думаешь, пока не приходит время."

# ch/harems_full/band/events.rpy:1162
translate russian anna_kleio_male_ending_02f7eb30:
    "Например, кто стоит у алтаря, а кто идёт по проходу?"

# ch/harems_full/band/events.rpy:1163
translate russian anna_kleio_male_ending_ed0e0a59:
    "Одного передают двум другим? Или наоборот?"

# ch/harems_full/band/events.rpy:1164
translate russian anna_kleio_male_ending_506f46e2:
    "В итоге выбор ночного клуба разом решил немало таких вопросов."

# ch/harems_full/band/events.rpy:1165
translate russian anna_kleio_male_ending_58d93023:
    "Здесь нет ни алтаря, ни прохода к нему, так что мы просто обошлись без этого."

# ch/harems_full/band/events.rpy:1166
translate russian anna_kleio_male_ending_d3636631:
    "Вместо этого стоим перед гостями, заполнившими танцпол."

# ch/harems_full/band/events.rpy:1167
translate russian anna_kleio_male_ending_dce7be00:
    "Да, священник немного растерялся, увидев диджейский пульт вместо алтаря."

# ch/harems_full/band/events.rpy:1168
translate russian anna_kleio_male_ending_2f7a4a63:
    "Но довольно быстро проникся атмосферой."

# ch/harems_full/band/events.rpy:1169
translate russian anna_kleio_male_ending_fbacf7fd:
    "Судя по его лицу, ему самому любопытно, что из этого выйдет."

# ch/harems_full/band/events.rpy:1170
translate russian anna_kleio_male_ending_b1736a53:
    "И он здесь точно не один такой!"

# ch/harems_full/band/events.rpy:1171
translate russian anna_kleio_male_ending_7d147d39:
    "Думаю, то же чувствуют все гости и мы трое."

# ch/harems_full/band/events.rpy:1175
translate russian anna_kleio_male_ending_8c6afa0e:
    "Ну, пожалуй, кроме Анны."

# ch/harems_full/band/events.rpy:1176
translate russian anna_kleio_male_ending_d1a2c0db:
    "Она так возбуждена радостью, что почти подпрыгивает на месте."

# ch/harems_full/band/events.rpy:1178
translate russian anna_kleio_male_ending_e76b6c11:
    "Встретившись со мной взглядом, она улыбается так широко, что я боюсь за верхнюю половину её головы."

# ch/harems_full/band/events.rpy:1179
translate russian anna_kleio_male_ending_a6fcd353:
    "Переведя взгляд, я встречаюсь глазами с Клео, которая тоже смотрит на Анну."

# ch/harems_full/band/events.rpy:1180
translate russian anna_kleio_male_ending_67dfc05e:
    "Прежде чем она успевает изобразить дерзкую беспечность, я замечаю настоящие чувства."

# ch/harems_full/band/events.rpy:1182
translate russian anna_kleio_male_ending_8114b0f9:
    "Она счастлива не меньше Анны, просто куда лучше это скрывает."

# ch/harems_full/band/events.rpy:1184
translate russian anna_kleio_male_ending_72081356:
    "К тому же все смотрят на округлившиеся животы Анны и Клео!"

# ch/harems_full/band/events.rpy:1185
translate russian anna_kleio_male_ending_91fc3752:
    "Платья не могут скрыть, что обе вот-вот родят."

# ch/harems_full/band/events.rpy:1186
translate russian anna_kleio_male_ending_02560a17:
    "Пусть думают что хотят. Мы втроём с нетерпением ждём встречи с малышами."

# ch/harems_full/band/events.rpy:1188
translate russian anna_kleio_male_ending_343a3897:
    "К тому же все смотрят на округлившийся живот Анны!"

# ch/harems_full/band/events.rpy:1189
translate russian anna_kleio_male_ending_999611a5:
    "Платье не может скрыть, что она вот-вот родит."

# ch/harems_full/band/events.rpy:1190
translate russian anna_kleio_male_ending_9fc51b51:
    "Пусть думают что хотят. Мы втроём с нетерпением ждём встречи с малышом."

# ch/harems_full/band/events.rpy:1192
translate russian anna_kleio_male_ending_6ba9bdc2:
    "К тому же все смотрят на округлившийся живот Клео!"

# ch/harems_full/band/events.rpy:1193
translate russian anna_kleio_male_ending_999611a5_1:
    "Платье не может скрыть, что она вот-вот родит."

# ch/harems_full/band/events.rpy:1194
translate russian anna_kleio_male_ending_9fc51b51_1:
    "Пусть думают что хотят. Мы втроём с нетерпением ждём встречи с малышом."

# ch/harems_full/band/events.rpy:1196
translate russian anna_kleio_male_ending_017e1649:
    "Но если настроение и манеры у них разные, то платья совершенно одинаковые."

# ch/harems_full/band/events.rpy:1197
translate russian anna_kleio_male_ending_10005b0b:
    "Несмотря на разницу фигур, Анна и Клео выбрали один и тот же фасон."

# ch/harems_full/band/events.rpy:1198
translate russian anna_kleio_male_ending_fa6d2808:
    "Не уверен, что кто-то ещё понимает шутку, но самих девушек она очень веселит."

# ch/harems_full/band/events.rpy:1201
translate russian anna_kleio_male_ending_d785c78c:
    kleio.say "На что уставился, сердцеед?"

# ch/harems_full/band/events.rpy:1202
translate russian anna_kleio_male_ending_8ccdf9e0:
    "Клео шипит эти слова, но без яда и раздражения."

# ch/harems_full/band/events.rpy:1205
translate russian anna_kleio_male_ending_5f8ac076:
    "Анна тоже слышит её и переводит взгляд с Клео на меня."

# ch/harems_full/band/events.rpy:1206
translate russian anna_kleio_male_ending_72d2f4f3:
    "Недоумение на её лице всё нарастает."

# ch/harems_full/band/events.rpy:1207
translate russian anna_kleio_male_ending_b892bce0:
    mike.say "Хочешь знать, на что я смотрю, Клео?"

# ch/harems_full/band/events.rpy:1208
translate russian anna_kleio_male_ending_b940c23d:
    mike.say "На двух девушек, которых люблю."

# ch/harems_full/band/events.rpy:1209
translate russian anna_kleio_male_ending_020105f8:
    mike.say "Потому что они чертовски сексуальны, и я не могу дождаться, когда мы поженимся!"

# ch/harems_full/band/events.rpy:1211
translate russian anna_kleio_male_ending_e85c3a2c:
    anna.say "О-о!"

# ch/harems_full/band/events.rpy:1212
translate russian anna_kleio_male_ending_0ce0def8:
    anna.say "[lssb_common.hero_name()], это ТАК романтично!"

# ch/harems_full/band/events.rpy:1214
translate russian anna_kleio_male_ending_28702b59:
    kleio.say "Туше, сердцеед."

# ch/harems_full/band/events.rpy:1215
translate russian anna_kleio_male_ending_a4fff14d:
    kleio.say "Хорошо ответил!"

# ch/harems_full/band/events.rpy:1219
translate russian anna_kleio_male_ending_d027f16a:
    "Священник властно прочищает горло, и все разом поворачиваются вперёд."

# ch/harems_full/band/events.rpy:1220
translate russian anna_kleio_male_ending_5d427a78:
    "Священник" "Прошу садиться."

# ch/harems_full/band/events.rpy:1221
translate russian anna_kleio_male_ending_98206d2b:
    "В ответ весь зал пожимает плечами и качает головами."

# ch/harems_full/band/events.rpy:1222
translate russian anna_kleio_male_ending_53554c08:
    "Вскоре священник повторяет эти жесты, поняв, что стульев здесь нет."

# ch/harems_full/band/events.rpy:1223
translate russian anna_kleio_male_ending_11fd68b7:
    "Священник" "А... тогда оставайтесь стоять."

# ch/harems_full/band/events.rpy:1224
translate russian anna_kleio_male_ending_ca1091e5:
    "Священник" "Дорогие возлюбленные."

# ch/harems_full/band/events.rpy:1225
translate russian anna_kleio_male_ending_46d40d74:
    "Священник" "Сегодня мы собрались здесь, чтобы засвидетельствовать соединение этих трёх душ узами брака."

# ch/harems_full/band/events.rpy:1226
translate russian anna_kleio_male_ending_8dc74025:
    "Дальше идёт обычная церемония, знакомая всем наизусть."

# ch/harems_full/band/events.rpy:1227
translate russian anna_kleio_male_ending_18ac3375:
    "Знаю, странно звучит, но появление третьего участника не так уж многое меняет!"

# ch/harems_full/band/events.rpy:1228
translate russian anna_kleio_male_ending_6e82c819:
    "Вскоре мы доходим до обмена клятвами..."

# ch/harems_full/band/events.rpy:1229
translate russian anna_kleio_male_ending_ce627da0:
    "Священник" "Согласна ли ты, Анна, чтобы твоими законными супругами стали Клео и [lssb_common.hero_name()]?"

# ch/harems_full/band/events.rpy:1230
translate russian anna_kleio_male_ending_67bd0f15:
    "Священник" "Обещаешь ли почитать их и слушаться, утешать и поддерживать?"

# ch/harems_full/band/events.rpy:1231
translate russian anna_kleio_male_ending_ce2de45e:
    "Священник" "И, отвергнув всех других, хранить им верность, пока вы все живы?"

# ch/harems_full/band/events.rpy:1233
translate russian anna_kleio_male_ending_02cb178d:
    anna.say "О да, конечно!"

# ch/harems_full/band/events.rpy:1234
translate russian anna_kleio_male_ending_88b8561b:
    "Священник" "Согласна ли ты, Клео, чтобы твоими законными супругами стали Анна и [lssb_common.hero_name()]?"

# ch/harems_full/band/events.rpy:1235
translate russian anna_kleio_male_ending_67bd0f15_1:
    "Священник" "Обещаешь ли почитать их и слушаться, утешать и поддерживать?"

# ch/harems_full/band/events.rpy:1236
translate russian anna_kleio_male_ending_ce2de45e_1:
    "Священник" "И, отвергнув всех других, хранить им верность, пока вы все живы?"

# ch/harems_full/band/events.rpy:1238
translate russian anna_kleio_male_ending_fe0e5183:
    kleio.say "Конечно, какого чёрта! Назвался груздем — полезай в кузов!"

# ch/harems_full/band/events.rpy:1240
translate russian anna_kleio_male_ending_562b900d:
    mike.say "КЛЕО!"

# ch/harems_full/band/events.rpy:1243
translate russian anna_kleio_male_ending_14c4e7f9:
    anna.say "КЛЕО!"

# ch/harems_full/band/events.rpy:1245
translate russian anna_kleio_male_ending_fe39d9b1:
    kleio.say "Ладно, ладно... Обещаю!"

# ch/harems_full/band/events.rpy:1249
translate russian anna_kleio_male_ending_c9d86209:
    "Священник" "А ты, [lssb_common.hero_name()], согласен взять Анну и Клео в законные жёны?"

# ch/harems_full/band/events.rpy:1250
translate russian anna_kleio_male_ending_67bd0f15_2:
    "Священник" "Обещаешь ли почитать их и слушаться, утешать и поддерживать?"

# ch/harems_full/band/events.rpy:1251
translate russian anna_kleio_male_ending_ce2de45e_2:
    "Священник" "И, отвергнув всех других, хранить им верность, пока вы все живы?"

# ch/harems_full/band/events.rpy:1252
translate russian anna_kleio_male_ending_bd325a03:
    mike.say "Обещаю."

# ch/harems_full/band/events.rpy:1253
translate russian anna_kleio_male_ending_d00b3666:
    "Священник" "Прекрасно."

# ch/harems_full/band/events.rpy:1254
translate russian anna_kleio_male_ending_cf51f9bd:
    "Священник" "Тогда с радостью объявляю ваш брак заключённым перед законом."

# ch/harems_full/band/events.rpy:1255
translate russian anna_kleio_male_ending_cc67d0e7:
    "Священник" "Можете скрепить союз поцелуем."

# ch/harems_full/band/events.rpy:1258
translate russian anna_kleio_male_ending_7ceeeeee:
    "Глядя на Анну и Клео, я сияю как сумасшедший."

# ch/harems_full/band/events.rpy:1259
translate russian anna_kleio_male_ending_8a7cf9f8:
    "Мы сделали это! Правда сделали! Я женат на двух самых красивых девушках в мире!"

# ch/harems_full/band/events.rpy:1260
translate russian anna_kleio_male_ending_fb8febf1:
    "Чувствую, как мы сближаемся для объятия, достойного идеальной фотографии."

# ch/harems_full/band/events.rpy:1261
translate russian anna_kleio_male_ending_e03b6fa6:
    "И поцелуя, который станет вечным произведением искусства."

# ch/harems_full/band/events.rpy:1265
translate russian anna_kleio_male_ending_2f0f693b:
    "Но тут мы с Клео одновременно вскрикиваем от неожиданности."

# ch/harems_full/band/events.rpy:1266
translate russian anna_kleio_male_ending_0b154e6f:
    "Анна стягивает нас вместе и едва не сбивает с ног яростным объятием."

# ch/harems_full/band/events.rpy:1267
translate russian anna_kleio_male_ending_126c95d5:
    anna.say "Вы слышали! Давайте целоваться!"

# ch/harems_full/band/events.rpy:1270
translate russian anna_kleio_male_ending_731f5801:
    "И с этими словами заключает нас в тройное объятие."

# ch/harems_full/band/events.rpy:1271
translate russian anna_kleio_male_ending_2c541db8:
    "Всё это время я надеюсь, что кто-то снимает."

# ch/harems_full/band/events.rpy:1272
translate russian anna_kleio_male_ending_4934280c:
    "Ведь ничего более горячего со мной на свадьбах ещё не случалось!"

# ch/harems_full/band/events.rpy:1273
translate russian anna_kleio_male_ending_5625b700:
    "Мы ещё не закончили, а уже звучит выбранная нами музыка и церемония завершается."

# ch/harems_full/band/events.rpy:1274
translate russian anna_kleio_male_ending_289f0632:
    "Вокруг наполняется танцпол, гости начинают двигаться, но мы ничего не замечаем."

# ch/harems_full/band/events.rpy:1275
translate russian anna_kleio_male_ending_3e78b664:
    "Пообщаться со всеми приглашёнными ещё успеем."

# ch/harems_full/band/events.rpy:1276
translate russian anna_kleio_male_ending_250527a5:
    "А сейчас важно лишь показать Анне и Клео, как сильно я их люблю..."

# ch/harems_full/band/events.rpy:1281
translate russian anna_kleio_male_ending_e156bd45:
    kleio.say "Предоставь это мне, Анна."

# ch/harems_full/band/events.rpy:1282
translate russian anna_kleio_male_ending_1ae12248:
    kleio.say "Они хотят услышать ту, кто в наших отношениях носит брюки."

# ch/harems_full/band/events.rpy:1283
translate russian anna_kleio_male_ending_8285867c:
    kleio.say "Поверь!"

# ch/harems_full/band/events.rpy:1285
translate russian anna_kleio_male_ending_2121c30f:
    anna.say "Эй, Клео!"

# ch/harems_full/band/events.rpy:1286
translate russian anna_kleio_male_ending_fe4f8515:
    anna.say "Ты обещала вести себя хорошо."

# ch/harems_full/band/events.rpy:1287
translate russian anna_kleio_male_ending_4be99b4e:
    anna.say "И на тебе тоже не брюки, а короткие шорты!"

# ch/harems_full/band/events.rpy:1289
translate russian anna_kleio_male_ending_25045175:
    kleio.say "Анна, я не о..."

# ch/harems_full/band/events.rpy:1291
translate russian anna_kleio_male_ending_465d2197:
    anna.say "Ты почти никогда не носишь брюки... или джинсы."

# ch/harems_full/band/events.rpy:1292
translate russian anna_kleio_male_ending_2bc2864c:
    anna.say "[lssb_common.hero_name()] носит постоянно, и у меня несколько пар есть."

# ch/harems_full/band/events.rpy:1293
translate russian anna_kleio_male_ending_766480e1:
    anna.say "А вот ты..."

# ch/harems_full/band/events.rpy:1295
translate russian anna_kleio_male_ending_0a61280b:
    kleio.say "АННА..."

# ch/harems_full/band/events.rpy:1297
translate russian anna_kleio_male_ending_f9f1d4de:
    kleio.say "Анна... пожалуйста, хватит о брюках."

# ch/harems_full/band/events.rpy:1298
translate russian anna_kleio_male_ending_bd08b04d:
    kleio.say "Это метафора, понимаешь? Оборот речи."

# ch/harems_full/band/events.rpy:1300
translate russian anna_kleio_male_ending_9661cdfc:
    anna.say "А, понятно!"

# ch/harems_full/band/events.rpy:1301
translate russian anna_kleio_male_ending_65d803f1:
    anna.say "Прости, Клео. Кажется, я немного запуталась."

# ch/harems_full/band/events.rpy:1303
translate russian anna_kleio_male_ending_9562dec8:
    kleio.say "Уф..."

# ch/harems_full/band/events.rpy:1305
translate russian anna_kleio_male_ending_720f7fc3:
    kleio.say "Теперь понятно, почему я хотела справиться сама?"

# ch/harems_full/band/events.rpy:1306
translate russian anna_kleio_male_ending_479b892c:
    anna.say "Ладно, ладно."

# ch/harems_full/band/events.rpy:1307
translate russian anna_kleio_male_ending_664fbb1d:
    anna.say "Если считаешь, что так лучше."

# ch/harems_full/band/events.rpy:1308
translate russian anna_kleio_male_ending_6c87d5ff:
    kleio.say "Так, на чём я остановилась..."

# ch/harems_full/band/events.rpy:1309
translate russian anna_kleio_male_ending_8d0ae8f8:
    anna.say "На брюках, Клео."

# ch/harems_full/band/events.rpy:1310
translate russian anna_kleio_male_ending_a82050bc:
    kleio.say "Спасибо, Анна."

# ch/harems_full/band/events.rpy:1312
translate russian anna_kleio_male_ending_14cc2c65:
    anna.say "Пожалуйста."

# ch/harems_full/band/events.rpy:1313
translate russian anna_kleio_male_ending_d2796a0e:
    kleio.say "В общем, знаю, что все давно этого ждали."

# ch/harems_full/band/events.rpy:1314
translate russian anna_kleio_male_ending_c49ba43e:
    kleio.say "Услышать о наших отношениях от меня, а не от сердцееда!"

# ch/harems_full/band/events.rpy:1316
translate russian anna_kleio_male_ending_b7f6021d:
    anna.say "И от меня, Клео! Про меня тоже не забудь!"

# ch/harems_full/band/events.rpy:1318
translate russian anna_kleio_male_ending_953b46c0:
    kleio.say "Как о тебе вообще можно забыть, Анна?!"

# ch/harems_full/band/events.rpy:1320
translate russian anna_kleio_male_ending_4b2c956d:
    anna.say "Ох, спасибо, Клео! Ты тоже незабываемая!"

# ch/harems_full/band/events.rpy:1321
translate russian anna_kleio_male_ending_83820959:
    kleio.say "Да, я немного не это имела в виду."

# ch/harems_full/band/events.rpy:1323
translate russian anna_kleio_male_ending_670e2ca1:
    kleio.say "Но ладно..."

# ch/harems_full/band/events.rpy:1324
translate russian anna_kleio_male_ending_76a17bb8:
    kleio.say "Можете поверить, что мы обе вышли за сердцееда?"

# ch/harems_full/band/events.rpy:1325
translate russian anna_kleio_male_ending_a738fcdf:
    kleio.say "Кто бы мог такое предвидеть!"

# ch/harems_full/band/events.rpy:1327
translate russian anna_kleio_male_ending_9e9af1d0:
    anna.say "Ну, я вроде как могла."

# ch/harems_full/band/events.rpy:1329
translate russian anna_kleio_male_ending_2743a9a6:
    kleio.say "Что?"

# ch/harems_full/band/events.rpy:1331
translate russian anna_kleio_male_ending_ba27541b:
    kleio.say "Да брось, маленькая врунья!"

# ch/harems_full/band/events.rpy:1333
translate russian anna_kleio_male_ending_0c144860:
    anna.say "Ха-ха..."

# ch/harems_full/band/events.rpy:1334
translate russian anna_kleio_male_ending_332c4491:
    anna.say "Это правда, Клео. Честно!"

# ch/harems_full/band/events.rpy:1336
translate russian anna_kleio_male_ending_0a69debc:
    anna.say "[lssb_common.hero_name()] показался мне милым, едва вошёл в репетиционную."

# ch/harems_full/band/events.rpy:1337
translate russian anna_kleio_male_ending_144ed142:
    anna.say "Но когда ты стала ТАК ему грубить, я поняла: тебе он тоже понравился."

# ch/harems_full/band/events.rpy:1338
translate russian anna_kleio_male_ending_3cb60770:
    kleio.say "Эй! Я грубила, потому что считала его козлом."

# ch/harems_full/band/events.rpy:1339
translate russian anna_kleio_male_ending_46aec757:
    kleio.say "Ну, типичным парнем."

# ch/harems_full/band/events.rpy:1340
translate russian anna_kleio_male_ending_33734d40:
    anna.say "Нет-нет, Клео. Ты грубила по-другому."

# ch/harems_full/band/events.rpy:1341
translate russian anna_kleio_male_ending_955e209f:
    anna.say "Так, когда кто-то очень нравится, а признаться не можешь."

# ch/harems_full/band/events.rpy:1342
translate russian anna_kleio_male_ending_b52b2eea:
    anna.say "И вместо этого ведёшь себя с ним как стерва."

# ch/harems_full/band/events.rpy:1343
translate russian anna_kleio_male_ending_625210e5:
    kleio.say "Мы вообще-то должны говорить о сердцееде, а не обо мне!"

# ch/harems_full/band/events.rpy:1344
translate russian anna_kleio_male_ending_31db52c7:
    anna.say "Ладно, Клео."

# ch/harems_full/band/events.rpy:1345
translate russian anna_kleio_male_ending_32a37059:
    anna.say "Расскажи им, как ты совсем в него не влюбилась."

# ch/harems_full/band/events.rpy:1346
translate russian anna_kleio_male_ending_6a5b17ce:
    anna.say "И совсем не ухватилась за шанс побыть втроём ещё и со мной!"

# ch/harems_full/band/events.rpy:1348
translate russian anna_kleio_male_ending_fd60e2fc:
    kleio.say "Да, ну... Это была одна из лучших сторон его появления в нашей жизни."

# ch/harems_full/band/events.rpy:1349
translate russian anna_kleio_male_ending_329d4b69:
    kleio.say "Быть одновременно с очень горячим парнем и одной из лучших подруг!"

# ch/harems_full/band/events.rpy:1351
translate russian anna_kleio_male_ending_545d0b39:
    anna.say "Ох ты, романтичная душа!"

# ch/harems_full/band/events.rpy:1352
translate russian anna_kleio_male_ending_b881b840:
    anna.say "Здорово, что нас трое."

# ch/harems_full/band/events.rpy:1353
translate russian anna_kleio_male_ending_0edee002:
    anna.say "Никогда не бывает ни одиноко, ни скучно!"

# ch/harems_full/band/events.rpy:1355
translate russian anna_kleio_male_ending_633d404a:
    anna.say "А скоро нас будет пятеро!"

# ch/harems_full/band/events.rpy:1357
translate russian anna_kleio_male_ending_56e27b04:
    kleio.say "Уф... Не напоминай."

# ch/harems_full/band/events.rpy:1358
translate russian anna_kleio_male_ending_10e70ce9:
    kleio.say "Я сейчас чувствую себя грёбаным китом!"

# ch/harems_full/band/events.rpy:1360
translate russian anna_kleio_male_ending_954870a0:
    anna.say "Не переживай, Клео."

# ch/harems_full/band/events.rpy:1361
translate russian anna_kleio_male_ending_08c44b9a:
    anna.say "Как только Томми и Кортни родятся, пусть [lssb_common.hero_name()] меняет подгузники!"

# ch/harems_full/band/events.rpy:1362
translate russian anna_kleio_male_ending_62540b37:
    kleio.say "Ещё бы."

# ch/harems_full/band/events.rpy:1363
translate russian anna_kleio_male_ending_8c2ae1f0:
    kleio.say "Это ведь он нас обеих обрюхатил!"

# ch/harems_full/band/events.rpy:1365
translate russian anna_kleio_male_ending_049d7961:
    anna.say "А скоро нас будет четверо!"

# ch/harems_full/band/events.rpy:1366
translate russian anna_kleio_male_ending_436b1297:
    kleio.say "Чур, подгузники менять не я!"

# ch/harems_full/band/events.rpy:1368
translate russian anna_kleio_male_ending_14c4e7f9_1:
    anna.say "КЛЕО!"

# ch/harems_full/band/events.rpy:1369
translate russian anna_kleio_male_ending_0ff49d46:
    kleio.say "Шучу, Анна."

# ch/harems_full/band/events.rpy:1370
translate russian anna_kleio_male_ending_cace47cb:
    kleio.say "Не переживай, с Томми я помогу."

# ch/harems_full/band/events.rpy:1372
translate russian anna_kleio_male_ending_e52ed4fb:
    kleio.say "А скоро нас будет четверо."

# ch/harems_full/band/events.rpy:1374
translate russian anna_kleio_male_ending_7abe97e9:
    anna.say "Фу! Вонючие подгузники!"

# ch/harems_full/band/events.rpy:1376
translate russian anna_kleio_male_ending_91a35e9c:
    kleio.say "АННА!"

# ch/harems_full/band/events.rpy:1378
translate russian anna_kleio_male_ending_de4e2948:
    anna.say "Прости, Клео."

# ch/harems_full/band/events.rpy:1379
translate russian anna_kleio_male_ending_58487026:
    anna.say "Не переживай, с Кортни я помогу."

# ch/harems_full/band/events.rpy:1383
translate russian anna_kleio_male_ending_aed41887:
    kleio.say "И в дороге время так проходит быстрее."

# ch/harems_full/band/events.rpy:1384
translate russian anna_kleio_male_ending_f2d9a6c8:
    kleio.say "Легче переносить все эти незнакомые города."

# ch/harems_full/band/events.rpy:1385
translate russian anna_kleio_male_ending_b3f291c6:
    anna.say "М-м-м... Ага! Больше никаких техников и приставучих фанатов для этой девушки!"

# ch/harems_full/band/events.rpy:1386
translate russian anna_kleio_male_ending_a3ff332a:
    kleio.say "Анна, маленькая распутница!"

# ch/harems_full/band/events.rpy:1387
translate russian anna_kleio_male_ending_3254d08c:
    anna.say "Ой, помолчи, Клео."

# ch/harems_full/band/events.rpy:1388
translate russian anna_kleio_male_ending_5370fb9e:
    anna.say "Я обожаю член [lssb_common.hero_name()], и ты тоже!"

# ch/harems_full/band/events.rpy:1389
translate russian anna_kleio_male_ending_9cfb3042:
    kleio.say "Да, пожалуй, ты права."

# ch/harems_full/band/events.rpy:1390
translate russian anna_kleio_male_ending_51e9eeb6:
    kleio.say "Чур, сегодня он мой!"

# ch/harems_full/band/events.rpy:1391
translate russian anna_kleio_male_ending_7cfaa763:
    anna.say "Ой, Клео, нечестно!"

# ch/harems_full/band/events.rpy:1392
translate russian anna_kleio_male_ending_89af535e:
    anna.say "В прошлый раз он был у тебя!"

# ch/harems_full/band/events.rpy:1393
translate russian anna_kleio_male_ending_d83f12ec:
    kleio.say "Кто не успел, тот опоздал, Анна!"

# ch/harems_full/band/events.rpy:1394
translate russian anna_kleio_male_ending_abcc1d90:
    kleio.say "А если серьёзно, сердцеед сам должен нас умолять."

# ch/harems_full/band/events.rpy:1395
translate russian anna_kleio_male_ending_8858cd6c:
    kleio.say "Ему ТАК повезло заполучить двух горячих сучек вроде нас!"

# ch/harems_full/band/events.rpy:1396
translate russian anna_kleio_male_ending_4b6e49a1:
    anna.say "Да, пожалуй, мы особенные!"

# ch/harems_full/band/events.rpy:1397
translate russian anna_kleio_male_ending_27470e34:
    kleio.say "И я никогда не дам ему об этом забыть."

# ch/harems_full/band/events.rpy:1398
translate russian anna_kleio_male_ending_b9505ae9:
    kleio.say "Ни за что и никогда!"

# ch/harems_full/band/events.rpy:1406
translate russian anna_sasha_propose_male_cf1e9124:
    "Есть несколько удивительных вещей, которые я никогда не рассчитывал испытать."

# ch/harems_full/band/events.rpy:1407
translate russian anna_sasha_propose_male_10ec8243:
    "Например, жить в одном доме с двумя очень горячими девушками."

# ch/harems_full/band/events.rpy:1408
translate russian anna_sasha_propose_male_ee23e642:
    "Или играть на гитаре в по-настоящему крутой группе и всех покорять."

# ch/harems_full/band/events.rpy:1409
translate russian anna_sasha_propose_male_5ac30e66:
    "Но самым невероятным казалось встречаться с двумя девушками одновременно."

# ch/harems_full/band/events.rpy:1410
translate russian anna_sasha_propose_male_ea1b9556:
    "И что бы вы думали? Удалось всё."

# ch/harems_full/band/events.rpy:1411
translate russian anna_sasha_propose_male_cc22ad37:
    "Причём девушки в этих историях ещё и одни и те же!"

# ch/harems_full/band/events.rpy:1412
translate russian anna_sasha_propose_male_bc0531f1:
    "С Анной я выступаю и встречаюсь."

# ch/harems_full/band/events.rpy:1413
translate russian anna_sasha_propose_male_96d949e0:
    "А с Сашей живу, выступаю И встречаюсь."

# ch/harems_full/band/events.rpy:1414
translate russian anna_sasha_propose_male_029893a5:
    "И всё это совсем на меня не давит."

# ch/harems_full/band/events.rpy:1415
translate russian anna_sasha_propose_male_66ed85e3:
    "Жизнь, концерты и отношения идут своим чередом одновременно."

# ch/harems_full/band/events.rpy:1416
translate russian anna_sasha_propose_male_8236bda2:
    "Нам хорошо вместе, и всё становится только лучше."

# ch/harems_full/band/events.rpy:1417
translate russian anna_sasha_propose_male_850898cf:
    "Вообще-то я хочу, чтобы это длилось долго."

# ch/harems_full/band/events.rpy:1418
translate russian anna_sasha_propose_male_2e230466:
    "Поэтому на следующую встречу с девушками прихожу с двумя кольцами в кармане."

# ch/harems_full/band/events.rpy:1419
translate russian anna_sasha_propose_male_95758136:
    "Изо всех сил стараюсь не выдать, что что-то задумал."

# ch/harems_full/band/events.rpy:1420
translate russian anna_sasha_propose_male_c0284843:
    "И, кажется, получается."

# ch/harems_full/band/events.rpy:1421
translate russian anna_sasha_propose_male_d9ee3933:
    "Когда я опускаюсь перед ними на колено, и Анна, и Саша удивляются."

# ch/harems_full/band/events.rpy:1424
translate russian anna_sasha_propose_male_7477ddf6:
    anna.say "Ой..."

# ch/harems_full/band/events.rpy:1425
translate russian anna_sasha_propose_male_f556daf3:
    anna.say "Что такое, [lssb_common.hero_name()]?"

# ch/harems_full/band/events.rpy:1426
translate russian anna_sasha_propose_male_114b6c41:
    anna.say "Ты что-то уронил?"

# ch/harems_full/band/events.rpy:1428
translate russian anna_sasha_propose_male_5cbda1b3:
    sasha.say "Да нет же, Анна..."

# ch/harems_full/band/events.rpy:1429
translate russian anna_sasha_propose_male_4b3326d7:
    sasha.say "Ты хоть один романтический фильм видела?"

# ch/harems_full/band/events.rpy:1430
translate russian anna_sasha_propose_male_f65bae5c:
    sasha.say "Это тот момент, когда парень встаёт на колено и достаёт кольцо!"

# ch/harems_full/band/events.rpy:1432
translate russian anna_sasha_propose_male_50ae9d18:
    anna.say "Ох, блядь!"

# ch/harems_full/band/events.rpy:1433
translate russian anna_sasha_propose_male_3d7b4303:
    anna.say "Ты... хочешь сказать..."

# ch/harems_full/band/events.rpy:1434
translate russian anna_sasha_propose_male_3dd00a72:
    "Доставая кольца, я невольно усмехаюсь."

# ch/harems_full/band/events.rpy:1435
translate russian anna_sasha_propose_male_92ebe100:
    "Они такие чудачки. В том числе за это я их и люблю."

# ch/harems_full/band/events.rpy:1436
translate russian anna_sasha_propose_male_621132fd:
    mike.say "Анна..."

# ch/harems_full/band/events.rpy:1438
translate russian anna_sasha_propose_male_d28f27f3:
    mike.say "Саша..."

# ch/harems_full/band/events.rpy:1441
translate russian anna_sasha_propose_male_9a48d111:
    "Я улыбаюсь им снизу, молча умоляя обеих согласиться."

# ch/harems_full/band/events.rpy:1443
translate russian anna_sasha_propose_male_86285f10:
    "Не успеваю больше ничего сказать, как Анна и Саша переходят к делу."

# ch/harems_full/band/events.rpy:1447
translate russian anna_sasha_propose_male_4aa72207:
    "Обе одновременно бросаются на меня."

# ch/harems_full/band/events.rpy:1448
translate russian anna_sasha_propose_male_223d3fef:
    "И вот уже безумно обнимают и целуют."

# ch/harems_full/band/events.rpy:1450
translate russian anna_sasha_propose_male_5d5a1295:
    anna.say "Конечно, [lssb_common.hero_name()]!"

# ch/harems_full/band/events.rpy:1452
translate russian anna_sasha_propose_male_c670587e:
    sasha.say "Да, я тоже согласна!"

# ch/harems_full/band/events.rpy:1454
translate russian anna_sasha_propose_male_02171668:
    "Я изо всех сил пытаюсь надеть им кольца."

# ch/harems_full/band/events.rpy:1455
translate russian anna_sasha_propose_male_b0e4356e:
    "Но взволнованные Анна и Саша тоже включаются в процесс."

# ch/harems_full/band/events.rpy:1456
translate russian anna_sasha_propose_male_22207014:
    "В итоге мы надеваем их общими усилиями."

# ch/harems_full/band/events.rpy:1457
translate russian anna_sasha_propose_male_4771d224:
    mike.say "Ого..."

# ch/harems_full/band/events.rpy:1458
translate russian anna_sasha_propose_male_35b92284:
    mike.say "Я так боялся, что вы откажете!"

# ch/harems_full/band/events.rpy:1459
translate russian anna_sasha_propose_male_8272be5d:
    anna.say "С чего бы нам отказывать?"

# ch/harems_full/band/events.rpy:1461
translate russian anna_sasha_propose_male_93cd6631:
    anna.say "Мы ведь отлично ладим!"

# ch/harems_full/band/events.rpy:1463
translate russian anna_sasha_propose_male_bc14b8ae:
    sasha.say "Да, [lssb_common.hero_name()]..."

# ch/harems_full/band/events.rpy:1464
translate russian anna_sasha_propose_male_8a2f547c:
    sasha.say "Мы прекрасно играем вместе, а в отношениях ещё лучше."

# ch/harems_full/band/events.rpy:1466
translate russian anna_sasha_propose_male_c4a3b3ef:
    sasha.say "Думаю, и официальной семьёй втроём будем отличной!"

# ch/harems_full/band/events.rpy:1468
translate russian anna_sasha_propose_male_c2bad994:
    "Я могу лишь кивать и улыбаться."

# ch/harems_full/band/events.rpy:1469
translate russian anna_sasha_propose_male_9bf5a92c:
    "Потому что уже представляю наше будущее."

# ch/harems_full/band/events.rpy:1473
translate russian anna_sasha_propose_male_e31e52a2:
    "Анна и Саша обмениваются одним из тех многозначительных взглядов."

# ch/harems_full/band/events.rpy:1474
translate russian anna_sasha_propose_male_acacf988:
    "Вы понимаете, о чём я."

# ch/harems_full/band/events.rpy:1475
translate russian anna_sasha_propose_male_a191e5cc:
    "Любая девушка его прочтёт, а парень никогда не поймёт."

# ch/harems_full/band/events.rpy:1476
translate russian anna_sasha_propose_male_04ccb32c:
    "Затем они кивают и одновременно поворачиваются ко мне."

# ch/harems_full/band/events.rpy:1477
translate russian anna_sasha_propose_male_3e9a1309:
    anna.say "Ох, [lssb_common.hero_name()]..."

# ch/harems_full/band/events.rpy:1479
translate russian anna_sasha_propose_male_d90770cf:
    sasha.say "Нам очень лестно твоё предложение."

# ch/harems_full/band/events.rpy:1481
translate russian anna_sasha_propose_male_de939210:
    anna.say "Ещё как!"

# ch/harems_full/band/events.rpy:1483
translate russian anna_sasha_propose_male_d51eba6f:
    sasha.say "Но пожениться мы не можем, пусть теперь это и законно."

# ch/harems_full/band/events.rpy:1485
translate russian anna_sasha_propose_male_21028f79:
    "Я качаю головой, пытаясь оспорить их решение."

# ch/harems_full/band/events.rpy:1486
translate russian anna_sasha_propose_male_4e3f93f7:
    mike.say "Но почему, девчонки?"

# ch/harems_full/band/events.rpy:1487
translate russian anna_sasha_propose_male_05e72fe3:
    mike.say "Мы ведь отлично ладим?"

# ch/harems_full/band/events.rpy:1490
translate russian anna_sasha_propose_male_26083fb5:
    anna.say "Ну да..."

# ch/harems_full/band/events.rpy:1492
translate russian anna_sasha_propose_male_42235705:
    sasha.say "Но мы знали, что в любой момент можно уйти."

# ch/harems_full/band/events.rpy:1493
translate russian anna_sasha_propose_male_0f5276f4:
    sasha.say "А в браке это уже не весело, [lssb_common.hero_name()]!"

# ch/harems_full/band/events.rpy:1495
translate russian anna_sasha_propose_male_a9124bf9:
    "Я прячу кольца и медленно поднимаюсь."

# ch/harems_full/band/events.rpy:1496
translate russian anna_sasha_propose_male_d98e6ad4:
    mike.say "Ладно..."

# ch/harems_full/band/events.rpy:1497
translate russian anna_sasha_propose_male_ed398653:
    mike.say "Если вы правда так чувствуете..."

# ch/harems_full/band/events.rpy:1499
translate russian anna_sasha_propose_male_4edc8e99:
    anna.say "Не грусти, [lssb_common.hero_name()]!"

# ch/harems_full/band/events.rpy:1501
translate russian anna_sasha_propose_male_93a232de:
    sasha.say "Да, мы тебя не бросаем."

# ch/harems_full/band/events.rpy:1502
translate russian anna_sasha_propose_male_6b43fdf7:
    sasha.say "Просто замуж не хотим!"

# ch/harems_full/band/events.rpy:1509
translate russian anna_sasha_propose_male_69b7534b:
    "Анна бросается вперёд и обнимает меня."

# ch/harems_full/band/events.rpy:1511
translate russian anna_sasha_propose_male_48321e4b:
    anna.say "Конечно, [lssb_common.hero_name()]!"

# ch/harems_full/band/events.rpy:1512
translate russian anna_sasha_propose_male_c2f8552f:
    anna.say "Я с радостью выйду за тебя!"

# ch/harems_full/band/events.rpy:1514
translate russian anna_sasha_propose_male_f0a9643f:
    "Но я замечаю, что Саша держится в стороне."

# ch/harems_full/band/events.rpy:1516
translate russian anna_sasha_propose_male_f34cc441:
    sasha.say "Ох, [lssb_common.hero_name()]..."

# ch/harems_full/band/events.rpy:1518
translate russian anna_sasha_propose_male_e340a4af:
    sasha.say "Мне лестно твоё предложение."

# ch/harems_full/band/events.rpy:1520
translate russian anna_sasha_propose_male_d51eba6f_1:
    sasha.say "Но пожениться мы не можем, пусть теперь это и законно."

# ch/harems_full/band/events.rpy:1522
translate russian anna_sasha_propose_male_72088d68:
    "Я качаю головой, пытаясь оспорить решение Саши."

# ch/harems_full/band/events.rpy:1523
translate russian anna_sasha_propose_male_bae8c1dd:
    mike.say "Но почему, Саша?"

# ch/harems_full/band/events.rpy:1524
translate russian anna_sasha_propose_male_05e72fe3_1:
    mike.say "Мы ведь отлично ладим?"

# ch/harems_full/band/events.rpy:1526
translate russian anna_sasha_propose_male_4d034fd2:
    sasha.say "Конечно."

# ch/harems_full/band/events.rpy:1527
translate russian anna_sasha_propose_male_42235705_1:
    sasha.say "Но мы знали, что в любой момент можно уйти."

# ch/harems_full/band/events.rpy:1528
translate russian anna_sasha_propose_male_0f5276f4_1:
    sasha.say "А в браке это уже не весело, [lssb_common.hero_name()]!"

# ch/harems_full/band/events.rpy:1531
translate russian anna_sasha_propose_male_4ce008b2:
    anna.say "Н... но..."

# ch/harems_full/band/events.rpy:1533
translate russian anna_sasha_propose_male_9d25e856:
    anna.say "Мы-то ведь можем пожениться?"

# ch/harems_full/band/events.rpy:1534
translate russian anna_sasha_propose_male_bf373f2e:
    mike.say "Конечно, можем, Анна!"

# ch/harems_full/band/events.rpy:1536
translate russian anna_sasha_propose_male_f9ec58d8:
    "Едва я это произношу, Саша задумывается."

# ch/harems_full/band/events.rpy:1538
translate russian anna_sasha_propose_male_5fa9ce32:
    sasha.say "А вот если вы двое поженитесь, а наши отношения продолжатся..."

# ch/harems_full/band/events.rpy:1540
translate russian anna_sasha_propose_male_d388edc8:
    sasha.say "Это будет довольно пикантно."

# ch/harems_full/band/events.rpy:1541
translate russian anna_sasha_propose_male_b91e7fe6:
    sasha.say "Да, пожалуй, такой вариант мне подойдёт..."

# ch/harems_full/band/events.rpy:1547
translate russian anna_sasha_propose_male_3ab7317c:
    "Саша протягивает руку."

# ch/harems_full/band/events.rpy:1548
translate russian anna_sasha_propose_male_35273e91:
    "Я надеваю кольцо ей на палец."

# ch/harems_full/band/events.rpy:1550
translate russian anna_sasha_propose_male_b0030f8a:
    "Но мы оба удивляемся, когда Анна отступает."

# ch/harems_full/band/events.rpy:1551
translate russian anna_sasha_propose_male_c3ed7ab4:
    anna.say "Не-а!"

# ch/harems_full/band/events.rpy:1553
translate russian anna_sasha_propose_male_2f77db37:
    anna.say "Я не хочу замуж!"

# ch/harems_full/band/events.rpy:1554
translate russian anna_sasha_propose_male_a126e618:
    "Мы с Сашей недоумённо переглядываемся."

# ch/harems_full/band/events.rpy:1555
translate russian anna_sasha_propose_male_dc9d3fd7:
    sasha.say "Это ещё почему, Анна?"

# ch/harems_full/band/events.rpy:1557
translate russian anna_sasha_propose_male_d06829f7:
    mike.say "Да, Анна, почему?"

# ch/harems_full/band/events.rpy:1558
translate russian anna_sasha_propose_male_bb0ba162:
    mike.say "Я думал, у нас всё прекрасно!"

# ch/harems_full/band/events.rpy:1559
translate russian anna_sasha_propose_male_f9e90f11:
    "Анна немного дуется и смотрит в пол."

# ch/harems_full/band/events.rpy:1560
translate russian anna_sasha_propose_male_bbe5cdee:
    "Наверное, ей сейчас кажется, что мы с Сашей на неё набросились."

# ch/harems_full/band/events.rpy:1561
translate russian anna_sasha_propose_male_e3182642:
    anna.say "Да, я знаю!"

# ch/harems_full/band/events.rpy:1562
translate russian anna_sasha_propose_male_92511148:
    anna.say "Но если поженимся, всё изменится."

# ch/harems_full/band/events.rpy:1563
translate russian anna_sasha_propose_male_f1575681:
    anna.say "Вы скажете, что нет, но изменится!"

# ch/harems_full/band/events.rpy:1565
translate russian anna_sasha_propose_male_4fd275d7:
    sasha.say "Так..."

# ch/harems_full/band/events.rpy:1566
translate russian anna_sasha_propose_male_bce32168:
    sasha.say "Ты, значит, не хочешь, чтобы мы с [lssb_common.hero_name()] поженились?"

# ch/harems_full/band/events.rpy:1568
translate russian anna_sasha_propose_male_9c0c070a:
    "Анна пожимает плечами и продолжает дуться."

# ch/harems_full/band/events.rpy:1571
translate russian anna_sasha_propose_male_40299833:
    anna.say "Нет... Наверное, я не против."

# ch/harems_full/band/events.rpy:1573
translate russian anna_sasha_propose_male_e11bb096:
    anna.say "Но мы ведь всё ещё сможем вместе проводить время и развлекаться?"

# ch/harems_full/band/events.rpy:1582
translate russian kleio_sasha_propose_male_578c51dd:
    "Я ждал идеального момента: для такого нужно выбрать правильное время."

# ch/harems_full/band/events.rpy:1583
translate russian kleio_sasha_propose_male_3640c60f:
    "Похоже, оно наступает после особенно удачной репетиции."

# ch/harems_full/band/events.rpy:1584
translate russian kleio_sasha_propose_male_2ad835c6:
    "Мы всё ещё полны энергии от того, как хорошо сыграли вместе. Чувство потрясающее."

# ch/harems_full/band/events.rpy:1585
translate russian kleio_sasha_propose_male_58ddbf19:
    "Поэтому, оказавшись с Сашей и Клео, я решаю: пора."

# ch/harems_full/band/events.rpy:1586
translate russian kleio_sasha_propose_male_9237a5b8:
    "Знаю, ужасное клише, а мы вроде как ультрасовременные."

# ch/harems_full/band/events.rpy:1587
translate russian kleio_sasha_propose_male_3efae5d5:
    "Но, может, девушки сочтут это иронией?"

# ch/harems_full/band/events.rpy:1588
translate russian kleio_sasha_propose_male_6303e999:
    "Надеясь на лучшее, я опускаюсь на колено перед Сашей и Клео."

# ch/harems_full/band/events.rpy:1590
translate russian kleio_sasha_propose_male_420894f1:
    sasha.say "[lssb_common.hero_name()]..."

# ch/harems_full/band/events.rpy:1591
translate russian kleio_sasha_propose_male_894142fe:
    sasha.say "Ты что..."

# ch/harems_full/band/events.rpy:1594
translate russian kleio_sasha_propose_male_3021e7e6:
    kleio.say "Не может быть!"

# ch/harems_full/band/events.rpy:1595
translate russian kleio_sasha_propose_male_25c75c32:
    kleio.say "Ты..."

# ch/harems_full/band/events.rpy:1596
translate russian kleio_sasha_propose_male_2756780d:
    "Вместо ответа я лишь достаю два кольца."

# ch/harems_full/band/events.rpy:1597
translate russian kleio_sasha_propose_male_9e081f9a:
    kleio.say "Он, блядь, серьёзно!"

# ch/harems_full/band/events.rpy:1599
translate russian kleio_sasha_propose_male_1da8e856:
    sasha.say "Ого..."

# ch/harems_full/band/events.rpy:1600
translate russian kleio_sasha_propose_male_e28ae73d:
    sasha.say "Это нереально!"

# ch/harems_full/band/events.rpy:1602
translate russian kleio_sasha_propose_male_b740a2e7:
    "Признаюсь, такой реакции я не ожидал."

# ch/harems_full/band/events.rpy:1603
translate russian kleio_sasha_propose_male_111ab0dc:
    "Но ни одна пока не попыталась сбежать."

# ch/harems_full/band/events.rpy:1604
translate russian kleio_sasha_propose_male_e9198d67:
    "Так что я заставляю себя улыбнуться, игнорирую волнение и продолжаю."

# ch/harems_full/band/events.rpy:1605
translate russian kleio_sasha_propose_male_d28f27f3:
    mike.say "Саша..."

# ch/harems_full/band/events.rpy:1606
translate russian kleio_sasha_propose_male_efb77356:
    mike.say "Клео..."

# ch/harems_full/band/events.rpy:1607
translate russian kleio_sasha_propose_male_3271ce9a:
    mike.say "Вы выйдете за меня?"

# ch/harems_full/band/events.rpy:1610
translate russian kleio_sasha_propose_male_66dca6a8:
    "Саша и Клео одновременно разражаются смехом."

# ch/harems_full/band/events.rpy:1611
translate russian kleio_sasha_propose_male_52afbb52:
    "Уверенности мне это совсем не прибавляет."

# ch/harems_full/band/events.rpy:1612
translate russian kleio_sasha_propose_male_15fac6a7:
    "Но, едва рассмеявшись, девушки, кажется, осознают ошибку."

# ch/harems_full/band/events.rpy:1613
translate russian kleio_sasha_propose_male_6a578d84:
    sasha.say "О нет..."

# ch/harems_full/band/events.rpy:1615
translate russian kleio_sasha_propose_male_22959cf5:
    sasha.say "[lssb_common.hero_name()], я смеюсь не над мыслью выйти за тебя!"

# ch/harems_full/band/events.rpy:1618
translate russian kleio_sasha_propose_male_878628e9:
    kleio.say "Я, пожалуй, тоже!"

# ch/harems_full/band/events.rpy:1620
translate russian kleio_sasha_propose_male_9afd69c2:
    sasha.say "Просто это так неожиданно, понимаешь?"

# ch/harems_full/band/events.rpy:1622
translate russian kleio_sasha_propose_male_72b9c67f:
    kleio.say "Да, сердцеед, именно!"

# ch/harems_full/band/events.rpy:1623
translate russian kleio_sasha_propose_male_147c87db:
    mike.say "Эм... Ну ладно, наверное..."

# ch/harems_full/band/events.rpy:1624
translate russian kleio_sasha_propose_male_8e73cf8f:
    mike.say "Я просто хотел быть спонтанным!"

# ch/harems_full/band/events.rpy:1625
translate russian kleio_sasha_propose_male_deb3fd8c:
    "Между нами повисает неловкая тишина."

# ch/harems_full/band/events.rpy:1626
translate russian kleio_sasha_propose_male_b9262715:
    "А я так и стою на колене, ожидая ответа."

# ch/harems_full/band/events.rpy:1629
translate russian kleio_sasha_propose_male_8c0b66dd:
    mike.say "Ответ в ближайшее время будет?"

# ch/harems_full/band/events.rpy:1631
translate russian kleio_sasha_propose_male_784bdbe1:
    "Вдруг Саша и Клео словно приходят в себя."

# ch/harems_full/band/events.rpy:1632
translate russian kleio_sasha_propose_male_cb94377f:
    "Как будто мысль о нашей свадьбе разом стала реальной."

# ch/harems_full/band/events.rpy:1633
translate russian kleio_sasha_propose_male_37f9d607:
    "Они обмениваются многозначительным взглядом и смотрят на меня."

# ch/harems_full/band/events.rpy:1634
translate russian kleio_sasha_propose_male_7b0a582f:
    "Не могу избавиться от чувства, что сейчас откажут!"

# ch/harems_full/band/events.rpy:1636
translate russian kleio_sasha_propose_male_2aa8267d:
    sasha.say "Чёрт возьми, [lssb_common.hero_name()]!"

# ch/harems_full/band/events.rpy:1638
translate russian kleio_sasha_propose_male_950149b8:
    sasha.say "Почему мы сами не додумались?"

# ch/harems_full/band/events.rpy:1640
translate russian kleio_sasha_propose_male_021de14c:
    kleio.say "Да, сердцеед."

# ch/harems_full/band/events.rpy:1642
translate russian kleio_sasha_propose_male_3cf41c9c:
    kleio.say "Тут ведь много ума не нужно."

# ch/harems_full/band/events.rpy:1643
translate russian kleio_sasha_propose_male_7350b7fc:
    kleio.say "Наверное, поэтому ты и додумался первым!"

# ch/harems_full/band/events.rpy:1644
translate russian kleio_sasha_propose_male_39cf4f35:
    "От очередной колкости Клео я качаю головой."

# ch/harems_full/band/events.rpy:1645
translate russian kleio_sasha_propose_male_e38e7160:
    "Но вспоминаю, что должен принимать их такими, какие они есть."

# ch/harems_full/band/events.rpy:1646
translate russian kleio_sasha_propose_male_6a38063f:
    "Включая все её милые маленькие причуды!"

# ch/harems_full/band/events.rpy:1647
translate russian kleio_sasha_propose_male_d19605bd:
    mike.say "Так это ваш ответ?"

# ch/harems_full/band/events.rpy:1648
translate russian kleio_sasha_propose_male_1c8974c9:
    mike.say "Вообще-то традиционно говорят просто да или нет!"

# ch/harems_full/band/events.rpy:1650
translate russian kleio_sasha_propose_male_9b464731:
    sasha.say "Да, [lssb_common.hero_name()]! Я выйду за тебя!"

# ch/harems_full/band/events.rpy:1652
translate russian kleio_sasha_propose_male_9ba50aff:
    kleio.say "Я тоже, сердцеед!"

# ch/harems_full/band/events.rpy:1653
translate russian kleio_sasha_propose_male_9aeb9adf:
    kleio.say "Давай оформим всё официально."

# ch/harems_full/band/events.rpy:1656
translate russian kleio_sasha_propose_male_65f03a9d:
    "Они одновременно протягивают мне руки."

# ch/harems_full/band/events.rpy:1657
translate russian kleio_sasha_propose_male_5b44e851:
    "Я спешу надеть кольца им на пальцы."

# ch/harems_full/band/events.rpy:1658
translate russian kleio_sasha_propose_male_34090b32:
    "Словно боюсь, что иначе передумают."

# ch/harems_full/band/events.rpy:1659
translate russian kleio_sasha_propose_male_c04cd569:
    "Поднявшись, я смотрю, как они любуются кольцами."

# ch/harems_full/band/events.rpy:1660
translate russian kleio_sasha_propose_male_ae62c864:
    "И тут мне кое-что приходит в голову."

# ch/harems_full/band/events.rpy:1662
translate russian kleio_sasha_propose_male_a3a5ab79:
    mike.say "Погодите!"

# ch/harems_full/band/events.rpy:1663
translate russian kleio_sasha_propose_male_c39a942d:
    mike.say "А мне кольцо не полагается?"

# ch/harems_full/band/events.rpy:1664
translate russian kleio_sasha_propose_male_202ae217:
    sasha.say "Хм..."

# ch/harems_full/band/events.rpy:1666
translate russian kleio_sasha_propose_male_03c5ba9f:
    sasha.say "Хороший вопрос."

# ch/harems_full/band/events.rpy:1668
translate russian kleio_sasha_propose_male_d5329b78:
    kleio.say "Да, может, подберём то, что понравится всем."

# ch/harems_full/band/events.rpy:1670
translate russian kleio_sasha_propose_male_400076cd:
    kleio.say "Например, пирсинг члена?"

# ch/harems_full/band/events.rpy:1674
translate russian kleio_sasha_propose_male_784bdbe1_1:
    "Вдруг Саша и Клео словно приходят в себя."

# ch/harems_full/band/events.rpy:1675
translate russian kleio_sasha_propose_male_cb94377f_1:
    "Как будто мысль о нашей свадьбе разом стала реальной."

# ch/harems_full/band/events.rpy:1676
translate russian kleio_sasha_propose_male_37f9d607_1:
    "Они обмениваются многозначительным взглядом и смотрят на меня."

# ch/harems_full/band/events.rpy:1677
translate russian kleio_sasha_propose_male_31e5e657:
    "Не могу избавиться от чувства, что мне сейчас вынесут приговор!"

# ch/harems_full/band/events.rpy:1679
translate russian kleio_sasha_propose_male_40150773:
    sasha.say "Серьёзно, [lssb_common.hero_name()]..."

# ch/harems_full/band/events.rpy:1680
translate russian kleio_sasha_propose_male_1867c7fd:
    sasha.say "Ты ведь не всерьёз хочешь, чтобы мы все поженились?"

# ch/harems_full/band/events.rpy:1681
translate russian kleio_sasha_propose_male_3a43e31b:
    sasha.say "Или всерьёз?"

# ch/harems_full/band/events.rpy:1684
translate russian kleio_sasha_propose_male_9a6c4778:
    mike.say "Вообще-то да!"

# ch/harems_full/band/events.rpy:1685
translate russian kleio_sasha_propose_male_6f3fa142:
    kleio.say "Да ладно, сердцеед!"

# ch/harems_full/band/events.rpy:1687
translate russian kleio_sasha_propose_male_95b6a6c1:
    kleio.say "Нам троим и так прекрасно вместе."

# ch/harems_full/band/events.rpy:1688
translate russian kleio_sasha_propose_male_7f340228:
    kleio.say "Зачем тебе скреплять это кольцами?"

# ch/harems_full/band/events.rpy:1689
translate russian kleio_sasha_propose_male_26bae101:
    kleio.say "Оформишь официально — станет скучно!"

# ch/harems_full/band/events.rpy:1692
translate russian kleio_sasha_propose_male_e834e084:
    "Я начинаю подниматься и убираю кольца."

# ch/harems_full/band/events.rpy:1693
translate russian kleio_sasha_propose_male_f57c0bab:
    "Всё это время стараюсь держать лицо."

# ch/harems_full/band/events.rpy:1694
translate russian kleio_sasha_propose_male_356bc056:
    "Но такой отказ всё равно причиняет боль."

# ch/harems_full/band/events.rpy:1696
translate russian kleio_sasha_propose_male_420894f1_1:
    sasha.say "[lssb_common.hero_name()]..."

# ch/harems_full/band/events.rpy:1697
translate russian kleio_sasha_propose_male_44be02ff:
    sasha.say "Ты нормально это воспринимаешь?"

# ch/harems_full/band/events.rpy:1699
translate russian kleio_sasha_propose_male_ac30a658:
    kleio.say "Да, сердцеед!"

# ch/harems_full/band/events.rpy:1701
translate russian kleio_sasha_propose_male_a23ab6cf:
    kleio.say "Мы тебя не бросаем."

# ch/harems_full/band/events.rpy:1702
translate russian kleio_sasha_propose_male_0f5add56:
    kleio.say "Просто не хотим быть твоими жёнами!"

# ch/harems_full/band/events.rpy:1704
translate russian kleio_sasha_propose_male_1688c9a6:
    mike.say "Да, всё будет нормально."

# ch/harems_full/band/events.rpy:1705
translate russian kleio_sasha_propose_male_98324620:
    mike.say "Только дайте немного времени, ладно?"

# ch/harems_full/band/events.rpy:1711
translate russian kleio_sasha_propose_male_784bdbe1_2:
    "Вдруг Саша и Клео словно приходят в себя."

# ch/harems_full/band/events.rpy:1712
translate russian kleio_sasha_propose_male_cb94377f_2:
    "Как будто мысль о нашей свадьбе разом стала реальной."

# ch/harems_full/band/events.rpy:1713
translate russian kleio_sasha_propose_male_37f9d607_2:
    "Они обмениваются многозначительным взглядом и смотрят на меня."

# ch/harems_full/band/events.rpy:1714
translate russian kleio_sasha_propose_male_7b0a582f_1:
    "Не могу избавиться от чувства, что сейчас откажут!"

# ch/harems_full/band/events.rpy:1715
translate russian kleio_sasha_propose_male_386320ae:
    kleio.say "Да, блядь, сердцеед!"

# ch/harems_full/band/events.rpy:1717
translate russian kleio_sasha_propose_male_3cf41c9c_1:
    kleio.say "Тут ведь много ума не нужно."

# ch/harems_full/band/events.rpy:1718
translate russian kleio_sasha_propose_male_7350b7fc_1:
    kleio.say "Наверное, поэтому ты и додумался первым!"

# ch/harems_full/band/events.rpy:1720
translate russian kleio_sasha_propose_male_40150773_1:
    sasha.say "Серьёзно, [lssb_common.hero_name()]..."

# ch/harems_full/band/events.rpy:1721
translate russian kleio_sasha_propose_male_1867c7fd_1:
    sasha.say "Ты ведь не всерьёз хочешь, чтобы мы все поженились?"

# ch/harems_full/band/events.rpy:1722
translate russian kleio_sasha_propose_male_3a43e31b_1:
    sasha.say "Или всерьёз?"

# ch/harems_full/band/events.rpy:1724
translate russian kleio_sasha_propose_male_e834e084_1:
    "Я начинаю подниматься и убираю кольца."

# ch/harems_full/band/events.rpy:1725
translate russian kleio_sasha_propose_male_f57c0bab_1:
    "Всё это время стараюсь держать лицо."

# ch/harems_full/band/events.rpy:1726
translate russian kleio_sasha_propose_male_356bc056_1:
    "Но такой отказ всё равно причиняет боль."

# ch/harems_full/band/events.rpy:1729
translate russian kleio_sasha_propose_male_f6fe177c:
    "И вижу, что Саша и Клео тоже пристально смотрят друг на друга."

# ch/harems_full/band/events.rpy:1730
translate russian kleio_sasha_propose_male_642de809:
    kleio.say "Эй... Погоди, Саша!"

# ch/harems_full/band/events.rpy:1732
translate russian kleio_sasha_propose_male_e20a1f2a:
    kleio.say "Тебе не нравится мысль о браке со мной?"

# ch/harems_full/band/events.rpy:1734
translate russian kleio_sasha_propose_male_acfc6806:
    sasha.say "Я не это сказала, Клео!"

# ch/harems_full/band/events.rpy:1735
translate russian kleio_sasha_propose_male_88545737:
    sasha.say "Мне не нравится сама идея брака."

# ch/harems_full/band/events.rpy:1736
translate russian kleio_sasha_propose_male_8ab00a52:
    sasha.say "С вами или с кем-то другим — неважно."

# ch/harems_full/band/events.rpy:1739
translate russian kleio_sasha_propose_male_5bfa7a63:
    "Клео сердито фыркает и берёт меня за руку."

# ch/harems_full/band/events.rpy:1740
translate russian kleio_sasha_propose_male_e28fb601:
    kleio.say "А я, может, хочу!"

# ch/harems_full/band/events.rpy:1742
translate russian kleio_sasha_propose_male_da6518b6:
    kleio.say "Что скажешь, сердцеед?"

# ch/harems_full/band/events.rpy:1743
translate russian kleio_sasha_propose_male_9798a477:
    mike.say "Я... пожалуй, да, Клео."

# ch/harems_full/band/events.rpy:1744
translate russian kleio_sasha_propose_male_bbba487f:
    "Вот это да!"

# ch/harems_full/band/events.rpy:1745
translate russian kleio_sasha_propose_male_8db65693:
    "Не думал, что всё повернётся именно так!"

# ch/harems_full/band/events.rpy:1750
translate russian kleio_sasha_propose_male_784bdbe1_3:
    "Вдруг Саша и Клео словно приходят в себя."

# ch/harems_full/band/events.rpy:1751
translate russian kleio_sasha_propose_male_cb94377f_3:
    "Как будто мысль о нашей свадьбе разом стала реальной."

# ch/harems_full/band/events.rpy:1752
translate russian kleio_sasha_propose_male_37f9d607_3:
    "Они обмениваются многозначительным взглядом и смотрят на меня."

# ch/harems_full/band/events.rpy:1753
translate russian kleio_sasha_propose_male_7b0a582f_2:
    "Не могу избавиться от чувства, что сейчас откажут!"

# ch/harems_full/band/events.rpy:1755
translate russian kleio_sasha_propose_male_2aa8267d_1:
    sasha.say "Чёрт возьми, [lssb_common.hero_name()]!"

# ch/harems_full/band/events.rpy:1757
translate russian kleio_sasha_propose_male_950149b8_1:
    sasha.say "Почему мы сами не додумались?"

# ch/harems_full/band/events.rpy:1760
translate russian kleio_sasha_propose_male_6f3fa142_1:
    kleio.say "Да ладно, сердцеед!"

# ch/harems_full/band/events.rpy:1761
translate russian kleio_sasha_propose_male_95b6a6c1_1:
    kleio.say "Нам троим и так прекрасно вместе."

# ch/harems_full/band/events.rpy:1764
translate russian kleio_sasha_propose_male_7f340228_1:
    kleio.say "Зачем тебе скреплять это кольцами?"

# ch/harems_full/band/events.rpy:1765
translate russian kleio_sasha_propose_male_26bae101_1:
    kleio.say "Оформишь официально — станет скучно!"

# ch/harems_full/band/events.rpy:1766
translate russian kleio_sasha_propose_male_e834e084_2:
    "Я начинаю подниматься и убираю кольца."

# ch/harems_full/band/events.rpy:1767
translate russian kleio_sasha_propose_male_f57c0bab_2:
    "Всё это время стараюсь держать лицо."

# ch/harems_full/band/events.rpy:1768
translate russian kleio_sasha_propose_male_356bc056_2:
    "Но такой отказ всё равно причиняет боль."

# ch/harems_full/band/events.rpy:1770
translate russian kleio_sasha_propose_male_f6fe177c_1:
    "И вижу, что Саша и Клео тоже пристально смотрят друг на друга."

# ch/harems_full/band/events.rpy:1772
translate russian kleio_sasha_propose_male_e8597ffa:
    sasha.say "Что ты имеешь в виду, Клео?"

# ch/harems_full/band/events.rpy:1773
translate russian kleio_sasha_propose_male_e502c15f:
    sasha.say "Считаешь, в браке со мной будет скучно?"

# ch/harems_full/band/events.rpy:1775
translate russian kleio_sasha_propose_male_5448a35a:
    kleio.say "В браке с КЕМ УГОДНО будет скучно, Саша!"

# ch/harems_full/band/events.rpy:1777
translate russian kleio_sasha_propose_male_654218cc:
    kleio.say "Я хочу жить и веселиться."

# ch/harems_full/band/events.rpy:1778
translate russian kleio_sasha_propose_male_7495681e:
    kleio.say "А не остепениться и играть в счастливую семью!"

# ch/harems_full/band/events.rpy:1780
translate russian kleio_sasha_propose_male_0a176783:
    "Саша сердито фыркает и берёт меня за руку."

# ch/harems_full/band/events.rpy:1782
translate russian kleio_sasha_propose_male_f019a6b9:
    sasha.say "А я, может, хочу!"

# ch/harems_full/band/events.rpy:1784
translate russian kleio_sasha_propose_male_f492adbc:
    sasha.say "Что скажешь, [lssb_common.hero_name()]?"

# ch/harems_full/band/events.rpy:1786
translate russian kleio_sasha_propose_male_8ceb0f4a:
    mike.say "Я... пожалуй, да, Саша."

# ch/harems_full/band/events.rpy:1787
translate russian kleio_sasha_propose_male_bbba487f_1:
    "Вот это да!"

# ch/harems_full/band/events.rpy:1788
translate russian kleio_sasha_propose_male_8db65693_1:
    "Не думал, что всё повернётся именно так!"

# ch/harems_full/band/events.rpy:1795
translate russian anna_kleio_sasha_propose_male_608e0d33:
    "Я никогда не умел сохранять невозмутимость, когда что-то задумал, и скрывать намерения."

# ch/harems_full/band/events.rpy:1796
translate russian anna_kleio_sasha_propose_male_ee6c1105:
    "От этих усилий обычно начинаю проваливать даже самые привычные дела."

# ch/harems_full/band/events.rpy:1797
translate russian anna_kleio_sasha_propose_male_67c44aa0:
    "И оставляю у людей явное ощущение, что мыслями витаю где-то далеко."

# ch/harems_full/band/events.rpy:1798
translate russian anna_kleio_sasha_propose_male_a58c6b78:
    "Поэтому сегодня всю репетицию я лажаю без передышки."

# ch/harems_full/band/events.rpy:1799
translate russian anna_kleio_sasha_propose_male_039dc725:
    "Ничего не получается, и я чувствую, как сбиваю с толку ещё и девушек."

# ch/harems_full/band/events.rpy:1800
translate russian anna_kleio_sasha_propose_male_333bfeac:
    "Но ведь не могу сказать, что причина в четырёх одинаковых кольцах у меня в кармане?"

# ch/harems_full/band/events.rpy:1801
translate russian anna_kleio_sasha_propose_male_60dd0ca3:
    "И что они словно огромная тяжесть, мешающая думать о чём-либо ещё."

# ch/harems_full/band/events.rpy:1802
translate russian anna_kleio_sasha_propose_male_a023200c:
    "Всё достигает предела, когда я беру жалкую фальшивую ноту и разражаюсь руганью."

# ch/harems_full/band/events.rpy:1803
translate russian anna_kleio_sasha_propose_male_8d169ba4:
    "Даже бессильный пинок по усилителю в порыве досады проходит мимо!"

# ch/harems_full/band/events.rpy:1804
translate russian anna_kleio_sasha_propose_male_dcf5c6e4:
    mike.say "А, чёрт!"

# ch/harems_full/band/events.rpy:1805
translate russian anna_kleio_sasha_propose_male_0b3d3ee2:
    mike.say "Да ёб вашу мать!"

# ch/harems_full/band/events.rpy:1807
translate russian anna_kleio_sasha_propose_male_1afc5a8d:
    "Клео усмехается моей вспышке и качает головой, убирая микрофон повыше."

# ch/harems_full/band/events.rpy:1808
translate russian anna_kleio_sasha_propose_male_9aa00768:
    kleio.say "Эй, сердцеед! Не так уж плохо ты играешь!"

# ch/harems_full/band/events.rpy:1809
translate russian anna_kleio_sasha_propose_male_e5cd9194:
    kleio.say "То есть играешь ты, конечно, ПЛОХО."

# ch/harems_full/band/events.rpy:1811
translate russian anna_kleio_sasha_propose_male_474ceb6c:
    kleio.say "Но не хуже своего привычного паршивого уровня."

# ch/harems_full/band/events.rpy:1813
translate russian anna_kleio_sasha_propose_male_afa2f145:
    "Анна смотрит на неё с максимальным неодобрением."

# ch/harems_full/band/events.rpy:1814
translate russian anna_kleio_sasha_propose_male_2fed8a55:
    "То есть всё равно не грознее слегка рассерженного щенка."

# ch/harems_full/band/events.rpy:1816
translate russian anna_kleio_sasha_propose_male_3c5e0fbd:
    anna.say "Клео, тебе стоит помочь ему, а не унижать!"

# ch/harems_full/band/events.rpy:1818
translate russian anna_kleio_sasha_propose_male_71c46a05:
    anna.say "Всё хорошо, [lssb_common.hero_name()]. У всех бывают паршивые дни."

# ch/harems_full/band/events.rpy:1820
translate russian anna_kleio_sasha_propose_male_750b4186:
    anna.say "Просто скажи «да пошло оно» и двигайся дальше!"

# ch/harems_full/band/events.rpy:1821
translate russian anna_kleio_sasha_propose_male_8612f834:
    mike.say "А, да."

# ch/harems_full/band/events.rpy:1822
translate russian anna_kleio_sasha_propose_male_6fcae830:
    mike.say "Спасибо, Анна... наверное..."

# ch/harems_full/band/events.rpy:1824
translate russian anna_kleio_sasha_propose_male_4f00528b:
    "Вечно рассудительная миротворица Саша вмешивается, чтобы всех успокоить."

# ch/harems_full/band/events.rpy:1826
translate russian anna_kleio_sasha_propose_male_9e26c889:
    sasha.say "Мы уже давно занимаемся."

# ch/harems_full/band/events.rpy:1827
translate russian anna_kleio_sasha_propose_male_598ba63e:
    sasha.say "Может, передохнём, пока все не начали лажать?"

# ch/harems_full/band/events.rpy:1831
translate russian anna_kleio_sasha_propose_male_261c51db:
    "Не знаю, спасает меня предложение Саши или окончательно подставляет."

# ch/harems_full/band/events.rpy:1832
translate russian anna_kleio_sasha_propose_male_03a27172:
    "Но я слишком благодарен ей за этот выход из положения, чтобы хоть в чём-то сомневаться."

# ch/harems_full/band/events.rpy:1833
translate russian anna_kleio_sasha_propose_male_28ac0384:
    "Когда все откладывают инструменты и мы просто сидим в репетиционной, я понимаю: пора."

# ch/harems_full/band/events.rpy:1834
translate russian anna_kleio_sasha_propose_male_3b984a1a:
    "Да, я весь на нервах и сегодня чуть не испортил всем репетицию."

# ch/harems_full/band/events.rpy:1835
translate russian anna_kleio_sasha_propose_male_d29a8035:
    "Но именно кольца в кармане довели меня до такого состояния."

# ch/harems_full/band/events.rpy:1836
translate russian anna_kleio_sasha_propose_male_b6a8a62b:
    "И будет только хуже, если я поскорее ничего не предприму."

# ch/harems_full/band/events.rpy:1837
translate russian anna_kleio_sasha_propose_male_11d4aa91:
    "Ну, была не была..."

# ch/harems_full/band/events.rpy:1838
translate russian anna_kleio_sasha_propose_male_d431c728:
    mike.say "Э-э... девчонки?"

# ch/harems_full/band/events.rpy:1841
translate russian anna_kleio_sasha_propose_male_2ce121cc:
    sasha.say "Да, [lssb_common.hero_name()]?"

# ch/harems_full/band/events.rpy:1844
translate russian anna_kleio_sasha_propose_male_79d67e5b:
    anna.say "А? Что?"

# ch/harems_full/band/events.rpy:1846
translate russian anna_kleio_sasha_propose_male_bb4d1f45:
    kleio.say "Хочешь что-то сказать, сердцеед?"

# ch/harems_full/band/events.rpy:1847
translate russian anna_kleio_sasha_propose_male_64248a3a:
    "Сейчас все смотрят на меня, и их внимание целиком принадлежит мне."

# ch/harems_full/band/events.rpy:1848
translate russian anna_kleio_sasha_propose_male_0df3d7ca:
    "Давай, [lssb_common.hero_name()], хоть тут не облажайся!"

# ch/harems_full/band/events.rpy:1849
translate russian anna_kleio_sasha_propose_male_52e20ab5:
    mike.say "Дело в том, что сегодня я играю хреново не просто так."

# ch/harems_full/band/events.rpy:1851
translate russian anna_kleio_sasha_propose_male_f10353c5:
    kleio.say "Как, впрочем, и в любой другой день!"

# ch/harems_full/band/events.rpy:1852
translate russian anna_kleio_sasha_propose_male_b52361f5:
    mike.say "Ха-ха, Клео, очень смешно!"

# ch/harems_full/band/events.rpy:1853
translate russian anna_kleio_sasha_propose_male_f7f91489:
    mike.say "Нет, серьёзно, девчонки, пожалуйста, выслушайте."

# ch/harems_full/band/events.rpy:1855
translate russian anna_kleio_sasha_propose_male_37eabce5:
    "Я глубоко вдыхаю, на секунду задерживаю дыхание и выдыхаю."

# ch/harems_full/band/events.rpy:1856
translate russian anna_kleio_sasha_propose_male_f30098b4:
    mike.say "Знаете, я ещё никогда не играл в такой группе."

# ch/harems_full/band/events.rpy:1857
translate russian anna_kleio_sasha_propose_male_42d7afa0:
    mike.say "И никогда не был так близок с такими девушками, как вы."

# ch/harems_full/band/events.rpy:1858
translate russian anna_kleio_sasha_propose_male_130e1ed1:
    mike.say "Раньше, когда мы играли вместе, у меня в голове словно что-то вставало на место."

# ch/harems_full/band/events.rpy:1859
translate russian anna_kleio_sasha_propose_male_799774c8:
    mike.say "Я чувствовал: всё правильно. И до сих пор не могу ни объяснить это, ни выразить словами."

# ch/harems_full/band/events.rpy:1860
translate russian anna_kleio_sasha_propose_male_d4bc175c:
    mike.say "А потом, когда между нами возникло нечто гораздо большее..."

# ch/harems_full/band/events.rpy:1861
translate russian anna_kleio_sasha_propose_male_8c81124d:
    "Тут мне приходится замолчать, сдерживая эмоции, пока они меня не захлестнули."

# ch/harems_full/band/events.rpy:1862
translate russian anna_kleio_sasha_propose_male_ada18a83:
    "Да, знаю, звучит жалко: начинающая рок-звезда с тремя девушками чуть не плачет."

# ch/harems_full/band/events.rpy:1863
translate russian anna_kleio_sasha_propose_male_7649919f:
    "Но я ничего не могу поделать со своими чувствами."

# ch/harems_full/band/events.rpy:1864
translate russian anna_kleio_sasha_propose_male_f6375cec:
    mike.say "Скажем так: я ещё никогда в жизни не был настолько счастлив и не чувствовал такой полноты жизни."

# ch/harems_full/band/events.rpy:1865
translate russian anna_kleio_sasha_propose_male_99b01b71:
    mike.say "Я люблю вас всех сильнее, чем могу выразить словами."

# ch/harems_full/band/events.rpy:1866
translate russian anna_kleio_sasha_propose_male_6ee5b1b2:
    mike.say "И... и..."

# ch/harems_full/band/events.rpy:1867
translate russian anna_kleio_sasha_propose_male_31c62897:
    "Говоря всё это, я сам не замечаю, как опускаюсь на одно колено."

# ch/harems_full/band/events.rpy:1868
translate russian anna_kleio_sasha_propose_male_a5ebc99b:
    mike.say "Вы трое выйдете за меня?"

# ch/harems_full/band/events.rpy:1869
translate russian anna_kleio_sasha_propose_male_deea1423:
    mike.say "И... наверное, друг за друга тоже?"

# ch/harems_full/band/events.rpy:1873
translate russian anna_kleio_sasha_propose_male_e6bb79ff:
    "Я неловко достаю коробочку с кольцами, открываю её и протягиваю им."

# ch/harems_full/band/events.rpy:1874
translate russian anna_kleio_sasha_propose_male_aba83bf4:
    "В комнате повисает тишина. Саша, Анна и Клео смотрят на меня, на кольца, а потом друг на друга..."

# ch/harems_full/band/events.rpy:1876
translate russian anna_kleio_sasha_propose_male_a32a39a4:
    "Первой реагирует Клео: она мотает головой и машет перед собой руками."

# ch/harems_full/band/events.rpy:1877
translate russian anna_kleio_sasha_propose_male_1d42bda4:
    "Она пятится от меня, пока не натыкается на усилитель, словно я вдруг стал заразным."

# ch/harems_full/band/events.rpy:1879
translate russian anna_kleio_sasha_propose_male_43249cc7:
    kleio.say "Полегче, сердцеед!"

# ch/harems_full/band/events.rpy:1880
translate russian anna_kleio_sasha_propose_male_b575428c:
    kleio.say "Ты ведь понимаешь, на что предлагаешь нам согласиться?"

# ch/harems_full/band/events.rpy:1882
translate russian anna_kleio_sasha_propose_male_2e16d073:
    "Анна, напротив, подходит ко мне. На её лице тревога и полное непонимание."

# ch/harems_full/band/events.rpy:1883
translate russian anna_kleio_sasha_propose_male_03d2f7c6:
    "Она качает головой, и кажется, ещё миг — и из её глаз хлынут слёзы."

# ch/harems_full/band/events.rpy:1884
translate russian anna_kleio_sasha_propose_male_2b177811:
    anna.say "Ох, я совсем запуталась, [lssb_common.hero_name()]!"

# ch/harems_full/band/events.rpy:1885
translate russian anna_kleio_sasha_propose_male_b6a2ea99:
    anna.say "Кто к кому должен будет переехать?"

# ch/harems_full/band/events.rpy:1886
translate russian anna_kleio_sasha_propose_male_37c274ec:
    anna.say "И я буду для Клео и Саши женой или мужем?!"

# ch/harems_full/band/events.rpy:1888
translate russian anna_kleio_sasha_propose_male_3e333726:
    "В этот момент полного и бесповоротного унижения меня хоть немного утешает только Саша."

# ch/harems_full/band/events.rpy:1889
translate russian anna_kleio_sasha_propose_male_aea54f42:
    "Ей каким-то образом удаётся сохранять спокойствие. Она кивает мне, предлагая подняться с колена."

# ch/harems_full/band/events.rpy:1890
translate russian anna_kleio_sasha_propose_male_18549898:
    "Но всё же я вижу, что улыбка даётся ей с трудом."

# ch/harems_full/band/events.rpy:1891
translate russian anna_kleio_sasha_propose_male_ab048edf:
    "Наверное, она разрывается между собственными чувствами и сочувствием ко мне, получившему отказ."

# ch/harems_full/band/events.rpy:1893
translate russian anna_kleio_sasha_propose_male_cdd44f9e:
    sasha.say "Не принимай это близко к сердцу, [lssb_common.hero_name()]."

# ch/harems_full/band/events.rpy:1894
translate russian anna_kleio_sasha_propose_male_bdd16d53:
    sasha.say "Я знаю, что ты хотел как лучше. Мы все знаем."

# ch/harems_full/band/events.rpy:1895
translate russian anna_kleio_sasha_propose_male_865b8363:
    sasha.say "Просто, наверное, мы пока не готовы к таким обязательствам."

# ch/harems_full/band/events.rpy:1896
translate russian anna_kleio_sasha_propose_male_31db7e1a:
    sasha.say "Возможно, в таких отношениях подобные решения нужно принимать всем вместе."

# ch/harems_full/band/events.rpy:1898
translate russian anna_kleio_sasha_propose_male_87ed34c6:
    "Я киваю и поспешно прячу кольца обратно в карман, пытаясь сохранить хоть остатки достоинства."

# ch/harems_full/band/events.rpy:1899
translate russian anna_kleio_sasha_propose_male_44b1c185:
    mike.say "Да, наверное, ты права, Саша."

# ch/harems_full/band/events.rpy:1900
translate russian anna_kleio_sasha_propose_male_90f1e84c:
    mike.say "Глупая у меня была затея!"

# ch/harems_full/band/events.rpy:1902
translate russian anna_kleio_sasha_propose_male_0d10b1b8:
    "Услышав это, Саша качает головой и берёт меня за руку."

# ch/harems_full/band/events.rpy:1903
translate russian anna_kleio_sasha_propose_male_062b36a0:
    "Выражение её лица не меняется, но я чувствую, как крепко она сжимает мою ладонь."

# ch/harems_full/band/events.rpy:1905
translate russian anna_kleio_sasha_propose_male_9f6c3689:
    sasha.say "Не говори так, [lssb_common.hero_name()]."

# ch/harems_full/band/events.rpy:1906
translate russian anna_kleio_sasha_propose_male_b10af780:
    sasha.say "Совершать такие поступки из любви совсем не глупо."

# ch/harems_full/band/events.rpy:1907
translate russian anna_kleio_sasha_propose_male_908ba276:
    sasha.say "Да, возможно, мы оказались к этому не готовы."

# ch/harems_full/band/events.rpy:1908
translate russian anna_kleio_sasha_propose_male_87d87bb8:
    sasha.say "Но ты показал нам троим, насколько нам предан."

# ch/harems_full/band/events.rpy:1909
translate russian anna_kleio_sasha_propose_male_ca091ea7:
    sasha.say "А это ведь чего-то стоит, правда?"

# ch/harems_full/band/events.rpy:1911
translate russian anna_kleio_sasha_propose_male_0b0fb781:
    "Я киваю и впервые чувствую, что могу улыбнуться."

# ch/harems_full/band/events.rpy:1912
translate russian anna_kleio_sasha_propose_male_f0db8c6d:
    "Пожалуй, я даже начинаю видеть в этой ситуации хорошее."

# ch/harems_full/band/events.rpy:1913
translate russian anna_kleio_sasha_propose_male_7f902b31:
    "Наверное, у Саши просто талант находить в жизни эти ускользающие поводы для радости."

# ch/harems_full/band/events.rpy:1921
translate russian anna_kleio_sasha_propose_male_d3eb184b:
    "Клео застаёт всех врасплох, расталкивая локтями Анну и Сашу."

# ch/harems_full/band/events.rpy:1922
translate russian anna_kleio_sasha_propose_male_784530ea:
    "Она практически выхватывает одно из колец из коробочки и натягивает его на палец."

# ch/harems_full/band/events.rpy:1923
translate russian anna_kleio_sasha_propose_male_44c2ed11:
    "А потом поднимает его, словно трофей, и размахивает рукой над головой."

# ch/harems_full/band/events.rpy:1926
translate russian anna_kleio_sasha_propose_male_c84cee10:
    kleio.say "ХА... ДА... ДА!"

# ch/harems_full/band/events.rpy:1927
translate russian anna_kleio_sasha_propose_male_2a362338:
    kleio.say "Кто-то ВСЁ-ТАКИ хочет на мне жениться!"

# ch/harems_full/band/events.rpy:1928
translate russian anna_kleio_sasha_propose_male_007f3df3:
    kleio.say "Получила, мамочка?.. А ты, папочка, утрись..."

# ch/harems_full/band/events.rpy:1929
translate russian anna_kleio_sasha_propose_male_61f12411:
    "Она резко замирает, осознав, что все теперь смотрят на неё."

# ch/harems_full/band/events.rpy:1930
translate russian anna_kleio_sasha_propose_male_16a0e841:
    "Клео медленно опускает руку."

# ch/harems_full/band/events.rpy:1931
translate russian anna_kleio_sasha_propose_male_6321d773:
    "Но я замечаю, что она всё ещё прижимает руку с кольцом к груди."

# ch/harems_full/band/events.rpy:1932
translate russian anna_kleio_sasha_propose_male_2b2299fa:
    "Словно боится, что его кто-нибудь отнимет."

# ch/harems_full/band/events.rpy:1934
translate russian anna_kleio_sasha_propose_male_8dc5de36:
    kleio.say "Чего?!"

# ch/harems_full/band/events.rpy:1935
translate russian anna_kleio_sasha_propose_male_f3f6b189:
    kleio.say "Девушке уже и порадоваться нельзя, что на ней хотят жениться?!"

# ch/harems_full/band/events.rpy:1936
translate russian anna_kleio_sasha_propose_male_0476a7ff:
    "Саша качает головой, а Анна выглядит совершенно ошеломлённой."

# ch/harems_full/band/events.rpy:1937
translate russian anna_kleio_sasha_propose_male_28a7fd7e:
    sasha.say "Ладно, Клео, как скажешь."

# ch/harems_full/band/events.rpy:1939
translate russian anna_kleio_sasha_propose_male_60ce5910:
    sasha.say "Только не начинай называть его своей прелестью, ага?"

# ch/harems_full/band/events.rpy:1943
translate russian anna_kleio_sasha_propose_male_444b5278:
    "Пока Саша и Клео переговариваются, Анна тянется к кольцам."

# ch/harems_full/band/events.rpy:1944
translate russian anna_kleio_sasha_propose_male_7c418737:
    "Предугадав её движение, я достаю одно из коробочки и протягиваю ей."

# ch/harems_full/band/events.rpy:1945
translate russian anna_kleio_sasha_propose_male_94e21eb7:
    "Она поднимает на меня свои знакомые невинные глаза."

# ch/harems_full/band/events.rpy:1946
translate russian anna_kleio_sasha_propose_male_43de5e1c:
    "А потом на её лице расцветает самая милая улыбка, какую я когда-либо видел."

# ch/harems_full/band/events.rpy:1948
translate russian anna_kleio_sasha_propose_male_16516bd0:
    anna.say "Я с РАДОСТЬЮ стану твоей женой, [lssb_common.hero_name()]."

# ch/harems_full/band/events.rpy:1950
translate russian anna_kleio_sasha_propose_male_239bb9e5:
    anna.say "Только не знаю, стану ли я при этом женой Клео и Саши!"

# ch/harems_full/band/events.rpy:1951
translate russian anna_kleio_sasha_propose_male_a462dddd:
    anna.say "Или их мужем... или кем!"

# ch/harems_full/band/events.rpy:1952
translate russian anna_kleio_sasha_propose_male_6f9760fa:
    "Я не могу удержаться от смешка, надевая кольцо Анне на палец."

# ch/harems_full/band/events.rpy:1953
translate russian anna_kleio_sasha_propose_male_a6badb33:
    "Её непосредственность и искренность — две из тех черт, которые я в ней люблю больше всего."

# ch/harems_full/band/events.rpy:1955
translate russian anna_kleio_sasha_propose_male_33ebba00:
    sasha.say "Думаю, с подробностями мы разберёмся потом, Анна."

# ch/harems_full/band/events.rpy:1957
translate russian anna_kleio_sasha_propose_male_b3b194d9:
    "Я поднимаю глаза и вижу: хоть Саша обращается к Анне, смотрит она на меня."

# ch/harems_full/band/events.rpy:1958
translate russian anna_kleio_sasha_propose_male_ca100e0c:
    mike.say "Т... то есть ты тоже согласна, Саша?"

# ch/harems_full/band/events.rpy:1960
translate russian anna_kleio_sasha_propose_male_a2d3b18b:
    "Саша сама берёт одно из колец."

# ch/harems_full/band/events.rpy:1961
translate russian anna_kleio_sasha_propose_male_40d7b20e:
    "Но она берёт меня за руки, чтобы я помог надеть его ей на палец."

# ch/harems_full/band/events.rpy:1963
translate russian anna_kleio_sasha_propose_male_3825eb50:
    sasha.say "Серьёзно, [lssb_common.hero_name()]?"

# ch/harems_full/band/events.rpy:1964
translate russian anna_kleio_sasha_propose_male_7cd7b96e:
    sasha.say "Я терплю тебя в качестве соседа."

# ch/harems_full/band/events.rpy:1965
translate russian anna_kleio_sasha_propose_male_826189c0:
    sasha.say "Приняла тебя в группу."

# ch/harems_full/band/events.rpy:1966
translate russian anna_kleio_sasha_propose_male_52846999:
    sasha.say "И в свою постель тоже пустила."

# ch/harems_full/band/events.rpy:1967
translate russian anna_kleio_sasha_propose_male_4d2c07b5:
    sasha.say "Ты до сих пор не понял намёка?"

# ch/harems_full/band/events.rpy:1969
translate russian anna_kleio_sasha_propose_male_05ce863d:
    sasha.say "Да, я правда хочу разделить с тобой жизнь!"

# ch/harems_full/band/events.rpy:1971
translate russian anna_kleio_sasha_propose_male_7f8f10b6:
    "В коробочке остаётся лишь одно кольцо, и я сам его беру."

# ch/harems_full/band/events.rpy:1972
translate russian anna_kleio_sasha_propose_male_635bb207:
    mike.say "Я ведь не знаю, как всё это устроено."

# ch/harems_full/band/events.rpy:1973
translate russian anna_kleio_sasha_propose_male_5b81544f:
    mike.say "Но у мужчины обычно тоже есть кольцо, а мы тут все равноправные партнёры."

# ch/harems_full/band/events.rpy:1974
translate russian anna_kleio_sasha_propose_male_028981c5:
    mike.say "Вот я и себе одно купил..."

# ch/harems_full/band/events.rpy:1975
translate russian anna_kleio_sasha_propose_male_591647e6:
    "Саша молча забирает у меня кольцо."

# ch/harems_full/band/events.rpy:1976
translate russian anna_kleio_sasha_propose_male_d29ff369:
    "А потом они втроём одновременно надевают его мне на палец."

# ch/harems_full/band/events.rpy:1978
translate russian anna_kleio_sasha_propose_male_775e828c:
    kleio.say "Ну, теперь всё официально. Пора тебе заняться свадьбой, сердцеед!"

# ch/harems_full/band/events.rpy:1980
translate russian anna_kleio_sasha_propose_male_63746a90:
    anna.say "О да! Сделаем всё по традиции или устроим что-нибудь безумное?!"

# ch/harems_full/band/events.rpy:1981
translate russian anna_kleio_sasha_propose_male_d68cdbdc:
    mike.say "Ну, на этот счёт у меня тоже есть идея..."

# ch/harems_full/band/events.rpy:1996
translate russian anna_kleio_sasha_male_ending_37863df1:
    "Концерт проходит на редкость удачно: мы все четверо зажигаем, а публика с восторгом принимает каждую песню."

# ch/harems_full/band/events.rpy:1997
translate russian anna_kleio_sasha_male_ending_153abad6:
    "Не знаю, просто ли мы сегодня в отличной форме или нас так воодушевляет то, что задумано на конец концерта."

# ch/harems_full/band/events.rpy:1998
translate russian anna_kleio_sasha_male_ending_f515e1a0:
    "В любом случае никто из нас никогда не забудет это выступление. Надеюсь, зрители тоже!"

# ch/harems_full/band/events.rpy:1999
translate russian anna_kleio_sasha_male_ending_2a335308:
    "Никто не упоминает о предстоящем событии до того момента, когда мы обычно играем на бис."

# ch/harems_full/band/events.rpy:2000
translate russian anna_kleio_sasha_male_ending_f2053aa8:
    "Но вместо этого Клео хватает микрофон и резко рубит воздух ладонью."

# ch/harems_full/band/events.rpy:2001
translate russian anna_kleio_sasha_male_ending_26c0ef50:
    "Техников заранее предупредили о том, что будет, и это сигнал приготовиться."

# ch/harems_full/band/events.rpy:2003
translate russian anna_kleio_sasha_male_ending_b5399009:
    kleio.say "Так, засранцы, слушайте сюда!"

# ch/harems_full/band/events.rpy:2004
translate russian anna_kleio_sasha_male_ending_6e89f550:
    kleio.say "Обычно в этот момент мы щекочем ваши киски песенкой на бис."

# ch/harems_full/band/events.rpy:2005
translate russian anna_kleio_sasha_male_ending_165700ea:
    kleio.say "Но сегодня нет. Вот уж нет."

# ch/harems_full/band/events.rpy:2006
translate russian anna_kleio_sasha_male_ending_453c409a:
    "Разумеется, в ответ из зала несутся недовольные возгласы и просьбы сыграть ещё."

# ch/harems_full/band/events.rpy:2007
translate russian anna_kleio_sasha_male_ending_5e316be1:
    "Но Клео стоит на своём, качая головой и не поддаваясь ни на уговоры, ни на протесты."

# ch/harems_full/band/events.rpy:2009
translate russian anna_kleio_sasha_male_ending_db5950e0:
    kleio.say "Не-а, народ, ничего не выйдет."

# ch/harems_full/band/events.rpy:2010
translate russian anna_kleio_sasha_male_ending_4c6b6155:
    kleio.say "Потому что сейчас вы увидите на этой сцене кое-что совершенно особенное."

# ch/harems_full/band/events.rpy:2011
translate russian anna_kleio_sasha_male_ending_9323401c:
    "Она поворачивается и обводит рукой сцену, указывая на остальных. Мы позволяем ей говорить за всю группу."

# ch/harems_full/band/events.rpy:2012
translate russian anna_kleio_sasha_male_ending_89440529:
    kleio.say "Вы знаете меня, Клео, голос Deathless Harpies."

# ch/harems_full/band/events.rpy:2017
translate russian anna_kleio_sasha_male_ending_76868d68:
    kleio.say "Знаете Сашу на басу и Анну на ударных."

# ch/harems_full/band/events.rpy:2018
translate russian anna_kleio_sasha_male_ending_317d9703:
    kleio.say "Возможно, наш гитарист [lssb_common.hero_name()] вам знаком не так хорошо."

# ch/harems_full/band/events.rpy:2019
translate russian anna_kleio_sasha_male_ending_d59828ea:
    kleio.say "Но с его приходом наше трио стало квартетом."

# ch/harems_full/band/events.rpy:2021
translate russian anna_kleio_sasha_male_ending_bf7ba000:
    kleio.say "А потом... скажем так, мы стали играть вчетвером и вне сцены!"

# ch/harems_full/band/events.rpy:2022
translate russian anna_kleio_sasha_male_ending_eff22338:
    "Из толпы раздаются похотливые свистки."

# ch/harems_full/band/events.rpy:2023
translate russian anna_kleio_sasha_male_ending_f0de747d:
    "А вместе с ними — искренние возгласы удивления и поддержки."

# ch/harems_full/band/events.rpy:2024
translate russian anna_kleio_sasha_male_ending_d40a8e41:
    kleio.say "Спасибо за такой интерес к нашей личной жизни, извращенцы!"

# ch/harems_full/band/events.rpy:2025
translate russian anna_kleio_sasha_male_ending_4446c65d:
    kleio.say "В общем, [lssb_common.hero_name()] сделал предложение, и мы все согласились."

# ch/harems_full/band/events.rpy:2027
translate russian anna_kleio_sasha_male_ending_fc5b5ade:
    kleio.say "А поскольку поклонники Deathless Harpies нам как семья, вы все приглашены на свадьбу!"

# ch/harems_full/band/events.rpy:2032
translate russian anna_kleio_sasha_male_ending_d81b82b5:
    "Я отворачиваюсь от ликующей публики и киваю технику, стоящему за кулисами."

# ch/harems_full/band/events.rpy:2033
translate russian anna_kleio_sasha_male_ending_f16bce99:
    "Тот кивает в ответ. Это Ник, худощавый седой ветеран гастролей."

# ch/harems_full/band/events.rpy:2034
translate russian anna_kleio_sasha_male_ending_d48b16ed:
    "Он неторопливо выходит на сцену, совершенно не похожий на священнослужителя какого бы то ни было вероисповедания."

# ch/harems_full/band/events.rpy:2035
translate russian anna_kleio_sasha_male_ending_7e3afbd0:
    "Но я знал, что у него есть одно из тех свидетельств, которые можно оформить через интернет, чтобы проводить свадьбы."

# ch/harems_full/band/events.rpy:2036
translate russian anna_kleio_sasha_male_ending_03b8e93d:
    "Вот я и предложил его как идеального человека, готового поженить нас прямо на сцене."

# ch/harems_full/band/events.rpy:2038
translate russian anna_kleio_sasha_male_ending_a11ded82:
    "Ник" "Ладно, ладно, угомонитесь, шалавы."

# ch/harems_full/band/events.rpy:2039
translate russian anna_kleio_sasha_male_ending_b268ef6f:
    "Ник" "У нас тут вроде радостное событие, а не грёбаный бунт!"

# ch/harems_full/band/events.rpy:2040
translate russian anna_kleio_sasha_male_ending_25530c2b:
    "Ник жестом зовёт нас в центр сцены, и мы спешим выполнить его указание."

# ch/harems_full/band/events.rpy:2046
translate russian anna_kleio_sasha_male_ending_9b92dda9:
    "Ник" "Знаете, это напоминает мне, как я ездил в турне с Black Sabbath."

# ch/harems_full/band/events.rpy:2047
translate russian anna_kleio_sasha_male_ending_3101bc4a:
    "Ник" "Пришлось мне тогда женить одну из собачек его жены на вислобрюхой свинье, которую привёз мой приятель."

# ch/harems_full/band/events.rpy:2048
translate russian anna_kleio_sasha_male_ending_160e2721:
    "Ник" "И пока всё не пройдёт как надо, Оззи отказывался выходить на сцену."

# ch/harems_full/band/events.rpy:2049
translate russian anna_kleio_sasha_male_ending_599fed1b:
    "Ник" "Ну, как вы понимаете, вышел настоящий цирк..."

# ch/harems_full/band/events.rpy:2050
translate russian anna_kleio_sasha_male_ending_f90a5c5c:
    "Я подношу кулак ко рту и кашляю как можно громче."

# ch/harems_full/band/events.rpy:2051
translate russian anna_kleio_sasha_male_ending_5d39df5b:
    "Убедившись, что привлёк его внимание, я прошу Ника перейти к делу."

# ch/harems_full/band/events.rpy:2052
translate russian anna_kleio_sasha_male_ending_3395b48f:
    mike.say "Хватит баек о былых подвигах, Ник."

# ch/harems_full/band/events.rpy:2053
translate russian anna_kleio_sasha_male_ending_30fe972c:
    mike.say "Может, поторопишься, дружище?!"

# ch/harems_full/band/events.rpy:2054
translate russian anna_kleio_sasha_male_ending_d177d72a:
    "Ник" "Эй, парень, остынь, ладно?"

# ch/harems_full/band/events.rpy:2055
translate russian anna_kleio_sasha_male_ending_8eb4fed8:
    "Ник" "Успеем, всё успеем!"

# ch/harems_full/band/events.rpy:2056
translate russian anna_kleio_sasha_male_ending_01324e6b:
    "Ник" "Так, на чём я остановился..."

# ch/harems_full/band/events.rpy:2057
translate russian anna_kleio_sasha_male_ending_009c391a:
    "Ник" "А, да, свадьба."

# ch/harems_full/band/events.rpy:2058
translate russian anna_kleio_sasha_male_ending_02399491:
    "Ник" "И побыстрее, чем обычно, а то наша Мэвис совсем изведётся!"

# ch/harems_full/band/events.rpy:2059
translate russian anna_kleio_sasha_male_ending_fcdc78c7:
    "Поочерёдно указывая на каждого из нас, Ник сдерживает слово."

# ch/harems_full/band/events.rpy:2060
translate russian anna_kleio_sasha_male_ending_b950ff3a:
    "После этого словесного пинка он и правда берётся за дело."

# ch/harems_full/band/events.rpy:2061
translate russian anna_kleio_sasha_male_ending_2d81e35a:
    "Ник" "Итак, согласны ли вы, Саша, Анна, Клео и [lssb_common.hero_name()]..."

# ch/harems_full/band/events.rpy:2062
translate russian anna_kleio_sasha_male_ending_f2697986:
    "Ник" "Чтобы Саша, Анна, Клео и [lssb_common.hero_name()] стали вашими законными... кем вы там будете друг другу?"

# ch/harems_full/band/events.rpy:2063
translate russian anna_kleio_sasha_male_ending_465218fa:
    "Ник" "Отвергнув всех прочих, пока не надоедите друг другу, ага?"

# ch/harems_full/band/events.rpy:2065
translate russian anna_kleio_sasha_male_ending_c83bd37c:
    sasha.say "Я в деле."

# ch/harems_full/band/events.rpy:2068
translate russian anna_kleio_sasha_male_ending_36f0f9eb:
    anna.say "Да, я тоже!"

# ch/harems_full/band/events.rpy:2070
translate russian anna_kleio_sasha_male_ending_7c5c29ea:
    kleio.say "Присоединяюсь."

# ch/harems_full/band/events.rpy:2071
translate russian anna_kleio_sasha_male_ending_e20e0952:
    mike.say "Согласен!"

# ch/harems_full/band/events.rpy:2072
translate russian anna_kleio_sasha_male_ending_60ca2be0:
    "Ник широко улыбается: хитросплетения наших отношений явно его чрезвычайно забавляют."

# ch/harems_full/band/events.rpy:2073
translate russian anna_kleio_sasha_male_ending_c1477f7b:
    "Он кивает и продолжает церемонию."

# ch/harems_full/band/events.rpy:2074
translate russian anna_kleio_sasha_male_ending_2bcc7824:
    "Ник" "Обычно на этом этапе спрашивают, нет ли у кого возражений."

# ch/harems_full/band/events.rpy:2075
translate russian anna_kleio_sasha_male_ending_e00cce16:
    "Ник" "Но в наших весьма необычных обстоятельствах предлагаю им всем пойти нахрен, ага?"

# ch/harems_full/band/events.rpy:2076
translate russian anna_kleio_sasha_male_ending_f1b6ef8b:
    "Ник" "Так что с огромным удовольствием объявляю вас женатыми."

# ch/harems_full/band/events.rpy:2077
translate russian anna_kleio_sasha_male_ending_704063e9:
    "Ник" "Всех вас, мать вашу, четверых!"

# ch/harems_full/band/events.rpy:2078
translate russian anna_kleio_sasha_male_ending_7567a192:
    "Ник" "Можете поцеловаться или чем вы там занимаетесь."

# ch/harems_full/band/events.rpy:2079
translate russian anna_kleio_sasha_male_ending_d40b9654:
    "Ник" "Хотя это, конечно, не моё дело..."

# ch/harems_full/band/events.rpy:2085
translate russian anna_kleio_sasha_male_ending_85e21acb:
    "Болтовня Ника отходит на задний план, когда мы все четверо обнимаемся."

# ch/harems_full/band/events.rpy:2086
translate russian anna_kleio_sasha_male_ending_0a524dd5:
    "Знаю, всё это звучит как заветная мечта озабоченного подростка."

# ch/harems_full/band/events.rpy:2087
translate russian anna_kleio_sasha_male_ending_28b96984:
    "Но сейчас мои чувства настолько далеки от этого, что даже не верится."

# ch/harems_full/band/events.rpy:2088
translate russian anna_kleio_sasha_male_ending_878451d2:
    "Я и представить не мог такой настоящей любви — той, что чувствую к ним, и той, что получаю в ответ."

# ch/harems_full/band/events.rpy:2089
translate russian anna_kleio_sasha_male_ending_01c2ba10:
    "Я не знал, что такое возможно между четырьмя людьми. Что всё может быть настолько прекрасно."

# ch/harems_full/band/events.rpy:2090
translate russian anna_kleio_sasha_male_ending_97d13d8e:
    mike.say "Я вас люблю, девчонки."

# ch/harems_full/band/events.rpy:2093
translate russian anna_kleio_sasha_male_ending_af06c32b:
    anna.say "О-о, мы тебя тоже любим, [lssb_common.hero_name()]!"

# ch/harems_full/band/events.rpy:2095
translate russian anna_kleio_sasha_male_ending_8e094e28:
    kleio.say "Да, и теперь твоя задница ПРИНАДЛЕЖИТ нам, сердцеед!"

# ch/harems_full/band/events.rpy:2099
translate russian anna_kleio_sasha_male_ending_6eb95b7f:
    sasha.say "DEATHLESS HARPIES НАВСЕГДА!"

# ch/harems_full/band/events.rpy:2101
translate russian anna_kleio_sasha_male_ending_b060c1f9:
    "Я уже почти не слышу шума зрителей."

# ch/harems_full/band/events.rpy:2102
translate russian anna_kleio_sasha_male_ending_61579b80:
    "И понятия не имею, будем ли мы сегодня играть на бис или сразу уйдём со сцены."

# ch/harems_full/band/events.rpy:2103
translate russian anna_kleio_sasha_male_ending_73d53c68:
    "Мне важен лишь этот миг рядом с женщинами, которых я люблю."

# ch/harems_full/band/events.rpy:2104
translate russian anna_kleio_sasha_male_ending_41747f69:
    "Ведь кто сказал, что нельзя одновременно быть и группой, и любовниками?"

# ch/harems_full/band/events.rpy:2105
translate russian anna_kleio_sasha_male_ending_0f5e6e53:
    "Разве не в этом сам дух рок-н-ролла?"

# ch/harems_full/band/events.rpy:2111
translate russian anna_kleio_sasha_male_ending_a3bf4a33:
    kleio.say "Хочу сказать, что получить эту награду — просто охрененный кайф."

# ch/harems_full/band/events.rpy:2112
translate russian anna_kleio_sasha_male_ending_228ad144:
    anna.say "Да, мы даже не знали, что есть награда самым крутым девчонкам во всём метале!"

# ch/harems_full/band/events.rpy:2113
translate russian anna_kleio_sasha_male_ending_6ebe46ce:
    kleio.say "Но мы вроде как именно такие, так что победа закономерна!"

# ch/harems_full/band/events.rpy:2115
translate russian anna_kleio_sasha_male_ending_3c8a9405:
    sasha.say "Анна, Клео, что вы, чёрт возьми, творите?!"

# ch/harems_full/band/events.rpy:2116
translate russian anna_kleio_sasha_male_ending_cd2fcac6:
    sasha.say "Хватит дурачиться, пока [lssb_common.hero_name()] не услышал и не разозлился на нас!"

# ch/harems_full/band/events.rpy:2118
translate russian anna_kleio_sasha_male_ending_78ae6e14:
    kleio.say "Да он только ворчит, Саша. Дай нам повеселиться."

# ch/harems_full/band/events.rpy:2119
translate russian anna_kleio_sasha_male_ending_bd16fddf:
    anna.say "Знаешь, Саша, иногда он прямо как старая бабка."

# ch/harems_full/band/events.rpy:2121
translate russian anna_kleio_sasha_male_ending_6dfd91d6:
    kleio.say "Вечно одно и то же: «Клео, не выходи на сцену без трусов!»"

# ch/harems_full/band/events.rpy:2123
translate russian anna_kleio_sasha_male_ending_477fe6f8:
    anna.say "Ага, или: «Анна, хватит показывать сиськи фанатам!»"

# ch/harems_full/band/events.rpy:2126
translate russian anna_kleio_sasha_male_ending_89649521:
    sasha.say "Ладно, девчонки, как скажете."

# ch/harems_full/band/events.rpy:2127
translate russian anna_kleio_sasha_male_ending_f9411025:
    sasha.say "Вообще-то нам пора всё это заканчивать."

# ch/harems_full/band/events.rpy:2128
translate russian anna_kleio_sasha_male_ending_40020597:
    sasha.say "Рассказать, чем закончилась наша история и как мы теперь счастливы."

# ch/harems_full/band/events.rpy:2131
translate russian anna_kleio_sasha_male_ending_8b2cc936:
    anna.say "А?.. Кому рассказать, Саша?"

# ch/harems_full/band/events.rpy:2132
translate russian anna_kleio_sasha_male_ending_74fde09b:
    anna.say "Тут ведь только мы втроём!"

# ch/harems_full/band/events.rpy:2134
translate russian anna_kleio_sasha_male_ending_abe77471:
    kleio.say "Не знаю, Анна."

# ch/harems_full/band/events.rpy:2135
translate russian anna_kleio_sasha_male_ending_f9a530d1:
    kleio.say "Разве у тебя не бывает жутковатого ощущения, будто за нами постоянно наблюдают?"

# ch/harems_full/band/events.rpy:2138
translate russian anna_kleio_sasha_male_ending_562d6806:
    anna.say "ЧТО?!"

# ch/harems_full/band/events.rpy:2139
translate russian anna_kleio_sasha_male_ending_163e905c:
    anna.say "Хочешь сказать, кто-то смотрел, когда я разрешила... Когда [lssb_common.hero_name()]..."

# ch/harems_full/band/events.rpy:2140
translate russian anna_kleio_sasha_male_ending_44253842:
    anna.say "Когда я позволила ему засунуть сама знаешь что сама знаешь куда?!"

# ch/harems_full/band/events.rpy:2142
translate russian anna_kleio_sasha_male_ending_4026fbc5:
    sasha.say "Ох..."

# ch/harems_full/band/events.rpy:2144
translate russian anna_kleio_sasha_male_ending_95804109:
    sasha.say "Похоже, мне придётся справляться самой."

# ch/harems_full/band/events.rpy:2146
translate russian anna_kleio_sasha_male_ending_34c4211d:
    sasha.say "Но мы не просто остепенились."

# ch/harems_full/band/events.rpy:2147
translate russian anna_kleio_sasha_male_ending_f441f267:
    sasha.say "Ну, знаете: «И жили они долго и счастливо»?"

# ch/harems_full/band/events.rpy:2150
translate russian anna_kleio_sasha_male_ending_aeb12e9a:
    kleio.say "Хрен там! Мы сейчас сидим в хвосте гастрольного автобуса."

# ch/harems_full/band/events.rpy:2151
translate russian anna_kleio_sasha_male_ending_caa5e944:
    anna.say "И вообще, у нас мировое турне — играем на разогреве у METALLIKEA!"

# ch/harems_full/band/events.rpy:2152
translate russian anna_kleio_sasha_male_ending_28772ecd:
    sasha.say "Простите моих коллег и то, что они считают чувством юмора."

# ch/harems_full/band/events.rpy:2153
translate russian anna_kleio_sasha_male_ending_0439b410:
    sasha.say "Но не всё, что они несут, полная чушь. Мы ДЕЙСТВИТЕЛЬНО на гастролях."

# ch/harems_full/band/events.rpy:2154
translate russian anna_kleio_sasha_male_ending_036e0305:
    anna.say "В самом разгаре наш первый собственный тур — выступаем в больших городах!"

# ch/harems_full/band/events.rpy:2155
translate russian anna_kleio_sasha_male_ending_a9df0f30:
    kleio.say "Да, клубы небольшие, и мы вкалываем."

# ch/harems_full/band/events.rpy:2156
translate russian anna_kleio_sasha_male_ending_1332b592:
    kleio.say "Но наш труд начинает приносить плоды."

# ch/harems_full/band/events.rpy:2157
translate russian anna_kleio_sasha_male_ending_31fbe9f6:
    sasha.say "А главное — в дороге мы все вместе."

# ch/harems_full/band/events.rpy:2158
translate russian anna_kleio_sasha_male_ending_896663b6:
    sasha.say "Мы уехали почти сразу после свадьбы и с тех пор даже дух перевести не успели."

# ch/harems_full/band/events.rpy:2159
translate russian anna_kleio_sasha_male_ending_f5723029:
    kleio.say "Теперь мы по-настоящему живём рок-н-роллом!"

# ch/harems_full/band/events.rpy:2160
translate russian anna_kleio_sasha_male_ending_b9f56c57:
    sasha.say "Но по возвращении с гастролей придётся кое-что менять."

# ch/harems_full/band/events.rpy:2162
translate russian anna_kleio_sasha_male_ending_e8cdbf66:
    sasha.say "Формально мы всё ещё живём в одном доме: [lssb_common.hero_name()], [bree.name] и я."

# ch/harems_full/band/events.rpy:2163
translate russian anna_kleio_sasha_male_ending_6c332765:
    sasha.say "И я не знаю, нужно ли нам всем съехаться, чтобы наши отношения складывались."

# ch/harems_full/band/events.rpy:2164
translate russian anna_kleio_sasha_male_ending_0cf2dfe2:
    kleio.say "Пусть только сердцеед попробует не быть рядом, когда мы вернёмся из тура!"

# ch/harems_full/band/events.rpy:2165
translate russian anna_kleio_sasha_male_ending_fcaab293:
    kleio.say "Это ведь он нас всех обрюхатил!"

# ch/harems_full/band/events.rpy:2166
translate russian anna_kleio_sasha_male_ending_1eff9987:
    anna.say "Да! Томми, Далии и Кортни нужен папа рядом!"

# ch/harems_full/band/events.rpy:2167
translate russian anna_kleio_sasha_male_ending_1af3ea0c:
    sasha.say "О, об этом можете не волноваться, девчонки."

# ch/harems_full/band/events.rpy:2168
translate russian anna_kleio_sasha_male_ending_53a9efae:
    sasha.say "Теперь [lssb_common.hero_name()] в меньшинстве: шестеро против одного!"

# ch/harems_full/band/events.rpy:2170
translate russian anna_kleio_sasha_male_ending_e8cdbf66_1:
    sasha.say "Формально мы всё ещё живём в одном доме: [lssb_common.hero_name()], [bree.name] и я."

# ch/harems_full/band/events.rpy:2171
translate russian anna_kleio_sasha_male_ending_6c332765_1:
    sasha.say "И я не знаю, нужно ли нам всем съехаться, чтобы наши отношения складывались."

# ch/harems_full/band/events.rpy:2172
translate russian anna_kleio_sasha_male_ending_67fe1bd7:
    kleio.say "Эй, погоди-ка, сестричка!"

# ch/harems_full/band/events.rpy:2173
translate russian anna_kleio_sasha_male_ending_ad8a1aca:
    kleio.say "Не знаю, хочу ли я жить с парочкой пузатых мамаш!"

# ch/harems_full/band/events.rpy:2174
translate russian anna_kleio_sasha_male_ending_14c4e7f9:
    anna.say "КЛЕО!"

# ch/harems_full/band/events.rpy:2175
translate russian anna_kleio_sasha_male_ending_ad5d163c:
    sasha.say "Не слушай её, Анна, она просто выпендривается."

# ch/harems_full/band/events.rpy:2176
translate russian anna_kleio_sasha_male_ending_c84d20c3:
    sasha.say "Далия и Томми любят тётю Клео, и она их тоже!"

# ch/harems_full/band/events.rpy:2178
translate russian anna_kleio_sasha_male_ending_e8cdbf66_2:
    sasha.say "Формально мы всё ещё живём в одном доме: [lssb_common.hero_name()], [bree.name] и я."

# ch/harems_full/band/events.rpy:2179
translate russian anna_kleio_sasha_male_ending_6c332765_2:
    sasha.say "И я не знаю, нужно ли нам всем съехаться, чтобы наши отношения складывались."

# ch/harems_full/band/events.rpy:2180
translate russian anna_kleio_sasha_male_ending_06be768a:
    anna.say "Ой, я хочу переехать к вам! И чтобы Клео тоже!"

# ch/harems_full/band/events.rpy:2181
translate russian anna_kleio_sasha_male_ending_f423072e:
    anna.say "Далии и Кортни нужна тётя Анна, которая всегда под рукой!"

# ch/harems_full/band/events.rpy:2182
translate russian anna_kleio_sasha_male_ending_85f32075:
    kleio.say "Господи..."

# ch/harems_full/band/events.rpy:2183
translate russian anna_kleio_sasha_male_ending_c9c1f47f:
    kleio.say "А вот я не уверена, что мне это нужно!"

# ch/harems_full/band/events.rpy:2184
translate russian anna_kleio_sasha_male_ending_cfa2a354:
    sasha.say "Поверь, Клео, проще кивнуть и улыбнуться..."

# ch/harems_full/band/events.rpy:2186
translate russian anna_kleio_sasha_male_ending_e8cdbf66_3:
    sasha.say "Формально мы всё ещё живём в одном доме: [lssb_common.hero_name()], [bree.name] и я."

# ch/harems_full/band/events.rpy:2187
translate russian anna_kleio_sasha_male_ending_6c332765_3:
    sasha.say "И я не знаю, нужно ли нам всем съехаться, чтобы наши отношения складывались."

# ch/harems_full/band/events.rpy:2188
translate russian anna_kleio_sasha_male_ending_43b490c5:
    kleio.say "Ещё как съедетесь с нами — и ты, и [lssb_common.hero_name()]!"

# ch/harems_full/band/events.rpy:2189
translate russian anna_kleio_sasha_male_ending_09fedbbe:
    anna.say "Да! Томми и Кортни нужен папа рядом."

# ch/harems_full/band/events.rpy:2190
translate russian anna_kleio_sasha_male_ending_1b6f681c:
    anna.say "И тётя Саша тоже!"

# ch/harems_full/band/events.rpy:2191
translate russian anna_kleio_sasha_male_ending_41d8038f:
    sasha.say "Господи, а меня вообще кто-нибудь спросит?!"

# ch/harems_full/band/events.rpy:2193
translate russian anna_kleio_sasha_male_ending_e8cdbf66_4:
    sasha.say "Формально мы всё ещё живём в одном доме: [lssb_common.hero_name()], [bree.name] и я."

# ch/harems_full/band/events.rpy:2194
translate russian anna_kleio_sasha_male_ending_6c332765_4:
    sasha.say "И я не знаю, нужно ли нам всем съехаться, чтобы наши отношения складывались."

# ch/harems_full/band/events.rpy:2195
translate russian anna_kleio_sasha_male_ending_436b1297:
    kleio.say "Чур, я на смену подгузников не подписываюсь!"

# ch/harems_full/band/events.rpy:2196
translate russian anna_kleio_sasha_male_ending_f9be028c:
    anna.say "Ой, а я помогу, Саша! Маленькая Далия ТАКАЯ МИЛАЯ!"

# ch/harems_full/band/events.rpy:2198
translate russian anna_kleio_sasha_male_ending_e8cdbf66_5:
    sasha.say "Формально мы всё ещё живём в одном доме: [lssb_common.hero_name()], [bree.name] и я."

# ch/harems_full/band/events.rpy:2199
translate russian anna_kleio_sasha_male_ending_6c332765_5:
    sasha.say "И я не знаю, нужно ли нам всем съехаться, чтобы наши отношения складывались."

# ch/harems_full/band/events.rpy:2200
translate russian anna_kleio_sasha_male_ending_436b1297_1:
    kleio.say "Чур, я на смену подгузников не подписываюсь!"

# ch/harems_full/band/events.rpy:2201
translate russian anna_kleio_sasha_male_ending_14c4e7f9_1:
    anna.say "КЛЕО!"

# ch/harems_full/band/events.rpy:2202
translate russian anna_kleio_sasha_male_ending_70b3ff39:
    sasha.say "Не слушай её, Анна. Я помогу тебе с Томми."

# ch/harems_full/band/events.rpy:2204
translate russian anna_kleio_sasha_male_ending_e8cdbf66_6:
    sasha.say "Формально мы всё ещё живём в одном доме: [lssb_common.hero_name()], [bree.name] и я."

# ch/harems_full/band/events.rpy:2205
translate russian anna_kleio_sasha_male_ending_6c332765_6:
    sasha.say "И я не знаю, нужно ли нам всем съехаться, чтобы наши отношения складывались."

# ch/harems_full/band/events.rpy:2206
translate russian anna_kleio_sasha_male_ending_407870b4:
    anna.say "Фу, мне уже хватает этих вонючих подгузников в автобусе!"

# ch/harems_full/band/events.rpy:2207
translate russian anna_kleio_sasha_male_ending_6949b788:
    kleio.say "АННА! Мы вроде как женаты!"

# ch/harems_full/band/events.rpy:2208
translate russian anna_kleio_sasha_male_ending_f18be74d:
    sasha.say "Не волнуйся, Клео. Я помогу тебе с Кортни."

# ch/harems_full/band/events.rpy:2210
translate russian anna_kleio_sasha_male_ending_e8cdbf66_7:
    sasha.say "Формально мы всё ещё живём в одном доме: [lssb_common.hero_name()], [bree.name] и я."

# ch/harems_full/band/events.rpy:2211
translate russian anna_kleio_sasha_male_ending_6c332765_7:
    sasha.say "И я не знаю, нужно ли нам всем съехаться, чтобы наши отношения складывались."

# ch/harems_full/band/events.rpy:2212
translate russian anna_kleio_sasha_male_ending_87f2884d:
    anna.say "Если [bree.name] съедет, чур, её комната моя!"

# ch/harems_full/band/events.rpy:2213
translate russian anna_kleio_sasha_male_ending_eaf9a72a:
    sasha.say "Анна!"

# ch/harems_full/band/events.rpy:2214
translate russian anna_kleio_sasha_male_ending_62694fed:
    anna.say "Что?!"

# ch/harems_full/band/events.rpy:2215
translate russian anna_kleio_sasha_male_ending_4a52c6bc:
    anna.say "Хорошая комната, я её видела!"

# ch/harems_full/band/events.rpy:2216
translate russian anna_kleio_sasha_male_ending_6b57b2e0:
    kleio.say "А если будем жить вместе, сможем ещё и превратить дом в место для вечеринок!"

# ch/harems_full/band/events.rpy:2217
translate russian anna_kleio_sasha_male_ending_e062eb0a:
    sasha.say "Да повзрослейте вы уже обе!"

# ch/harems_full/band/events.rpy:2218
translate russian anna_kleio_sasha_male_ending_2daf3881:
    sasha.say "Думаю, многое зависит от того, добьётся ли группа успеха."

# ch/harems_full/band/events.rpy:2219
translate russian anna_kleio_sasha_male_ending_f4059471:
    sasha.say "Тогда мы сможем уволиться и полностью посвятить себя музыке."

# ch/harems_full/band/events.rpy:2220
translate russian anna_kleio_sasha_male_ending_3f94ced8:
    kleio.say "И нанять целую чёртову команду нянь!"

# ch/harems_full/band/events.rpy:2221
translate russian anna_kleio_sasha_male_ending_13e1d5a5:
    anna.say "Ой, а можно найти таких, которые будут кормить грудью вместо нас?"

# ch/harems_full/band/events.rpy:2222
translate russian anna_kleio_sasha_male_ending_eb091539:
    kleio.say "Что?.. Зачем?"

# ch/harems_full/band/events.rpy:2223
translate russian anna_kleio_sasha_male_ending_91b57a7e:
    anna.say "Ну... у меня сейчас ТАК болят соски!"

# ch/harems_full/band/events.rpy:2224
translate russian anna_kleio_sasha_male_ending_7b6cd82c:
    sasha.say "АННА!"

# ch/harems_full/band/events.rpy:2225
translate russian anna_kleio_sasha_male_ending_db2e591b:
    anna.say "Но ведь болят!"

# ch/harems_full/band/events.rpy:2226
translate russian anna_kleio_sasha_male_ending_e43e2e52:
    sasha.say "Ладно, на чём я остановилась..."

# ch/harems_full/band/events.rpy:2227
translate russian anna_kleio_sasha_male_ending_110f9efc:
    kleio.say "На том, как здорово быть с сердцеедом."

# ch/harems_full/band/events.rpy:2228
translate russian anna_kleio_sasha_male_ending_2dd2f946:
    kleio.say "И с его мужским достоинством!"

# ch/harems_full/band/events.rpy:2229
translate russian anna_kleio_sasha_male_ending_90566e54:
    sasha.say "Да, это тоже!"

# ch/harems_full/band/events.rpy:2230
translate russian anna_kleio_sasha_male_ending_e2cfda70:
    sasha.say "Вряд ли существует пособие о том, как жить с тремя другими людьми."

# ch/harems_full/band/events.rpy:2231
translate russian anna_kleio_sasha_male_ending_64d43415:
    sasha.say "Тем более такое, где объясняется, как одновременно играть с ними в группе и строить семейную жизнь."

# ch/harems_full/band/events.rpy:2232
translate russian anna_kleio_sasha_male_ending_70606294:
    sasha.say "Так что мы не спешим и решаем всё постепенно, день за днём."

# ch/harems_full/band/events.rpy:2233
translate russian anna_kleio_sasha_male_ending_ccfce4a2:
    sasha.say "И всегда помним, что у нас есть самое главное."

# ch/harems_full/band/events.rpy:2234
translate russian anna_kleio_sasha_male_ending_b51d40f9:
    sasha.say "Мы есть друг у друга..."

# ch/harems_full/band/events.rpy:2235
translate russian anna_kleio_sasha_male_ending_9613f7bf:
    anna.say "О-о, как мило, Саша! Кажется, я сейчас заплачу!"

# ch/harems_full/band/events.rpy:2236
translate russian anna_kleio_sasha_male_ending_42ee3392:
    kleio.say "Фу-у..."

# ch/harems_full/band/events.rpy:2237
translate russian anna_kleio_sasha_male_ending_48241e4a:
    kleio.say "Скорее стошнит! Передайте ведро!"

# ch/harems_full/band/events.rpy:2238
translate russian anna_kleio_sasha_male_ending_6194aa6f:
    sasha.say "Эй, вы двое! Это должна была быть последняя реплика!"

# ch/harems_full/band/events.rpy:2239
translate russian anna_kleio_sasha_male_ending_e24046cd:
    sasha.say "Положено сказать что-нибудь такое жизнеутверждающее, а потом картинка плавно гаснет."

# ch/harems_full/band/events.rpy:2240
translate russian anna_kleio_sasha_male_ending_3806cbb9:
    sasha.say "Глубокомысленно и трогательно! А вы, сучки, всё испортили!"

# ch/harems_full/band/events.rpy:2241
translate russian anna_kleio_sasha_male_ending_e7e27ca0:
    kleio.say "Вытащи трусы из киски и расслабься, Саша!"

# ch/harems_full/band/events.rpy:2242
translate russian anna_kleio_sasha_male_ending_e576cb97:
    anna.say "Прости, Саша! Мы тебя любим!"

# ch/harems_full/band/events.rpy:2243
translate russian anna_kleio_sasha_male_ending_5298c0e6:
    sasha.say "Ладно, ладно..."

# ch/harems_full/band/events.rpy:2244
translate russian anna_kleio_sasha_male_ending_2a8ee266:
    sasha.say "Я вас тоже люблю."

# ch/harems_full/band/events.rpy:2245
translate russian anna_kleio_sasha_male_ending_bc2d55c6:
    sasha.say "Хрен знает за что, но люблю..."

# ch/harems_full/band/events.rpy:2252
translate russian anna_kleio_anal_53d6e816:
    "Как бы неправильно ни было подслушивать чужие разговоры, порой избежать этого довольно трудно."

# ch/harems_full/band/events.rpy:2253
translate russian anna_kleio_anal_55b615a9:
    "Особенно если в первые же случайно услышанные мгновения понимаешь: тема-то весьма пикантная."

# ch/harems_full/band/events.rpy:2254
translate russian anna_kleio_anal_6dc16ba8:
    "А что, если вдобавок до тебя доходит, что этот разговор касается и тебя?"

# ch/harems_full/band/events.rpy:2255
translate russian anna_kleio_anal_069c1101:
    "В таких особых обстоятельствах, даже если ты не участвуешь в беседе, тебе ведь стоило бы в ней поучаствовать?"

# ch/harems_full/band/events.rpy:2256
translate russian anna_kleio_anal_53b9d74f:
    "Во всяком случае, я оправдываюсь именно так."

# ch/harems_full/band/events.rpy:2260
translate russian anna_kleio_anal_9c284cb4:
    kleio.say "Господи, Анна, да что ты так помешалась на сексе в задницу?!"

# ch/harems_full/band/events.rpy:2261
translate russian anna_kleio_anal_1a1ad566:
    anna.say "Ну брось, Клео! Ты говоришь так, будто это что-то странное или извращённое!"

# ch/harems_full/band/events.rpy:2262
translate russian anna_kleio_anal_2fe8f7d6:
    "Вот что я слышу, возвращаясь к нашему столику в местном пабе, и сразу навостряю уши."

# ch/harems_full/band/events.rpy:2263
translate russian anna_kleio_anal_a20f9a90:
    "Разве можно меня винить за то, что после такого я задерживаюсь и стараюсь расслышать продолжение?"

# ch/harems_full/band/events.rpy:2264
translate russian anna_kleio_anal_a1bd734b:
    kleio.say "Ну... да, Анна."

# ch/harems_full/band/events.rpy:2265
translate russian anna_kleio_anal_d9d47eb9:
    kleio.say "Пожалуй, именно это я и говорю."

# ch/harems_full/band/events.rpy:2266
translate russian anna_kleio_anal_e25d2a2f:
    "По хмурому лицу Клео видно: ей не нравится, что теперь она выглядит более консервативной, чем Анна."

# ch/harems_full/band/events.rpy:2267
translate russian anna_kleio_anal_4a515437:
    "Она скрещивает руки на груди. Обсуждать эту тему ей явно неуютно."

# ch/harems_full/band/events.rpy:2268
translate russian anna_kleio_anal_06d745a9:
    anna.say "Серьёзно, Клео, ты ведь наверняка уже пробовала в попу?"

# ch/harems_full/band/events.rpy:2269
translate russian anna_kleio_anal_55fc23f5:
    anna.say "Тебе же нравятся и парни, и девушки?"

# ch/harems_full/band/events.rpy:2271
translate russian anna_kleio_anal_e2c1c1bf:
    anna.say "Значит, ты наверняка вытворяла всякое безумие в постели... или где-нибудь ещё?"

# ch/harems_full/band/events.rpy:2272
translate russian anna_kleio_anal_e49f9f7e:
    "Клео прекрасно понимает похотливое подмигивание, которым Анна подкрепляет свои слова."

# ch/harems_full/band/events.rpy:2274
translate russian anna_kleio_anal_51bbd08b:
    kleio.say "Конечно, Анна, я же не чёртова монашка!"

# ch/harems_full/band/events.rpy:2275
translate russian anna_kleio_anal_90b6c0b6:
    kleio.say "Просто я..."

# ch/harems_full/band/events.rpy:2277
translate russian anna_kleio_anal_3a8364ff:
    anna.say "Боишься, что будет больно, Клео?"

# ch/harems_full/band/events.rpy:2278
translate russian anna_kleio_anal_6e87c834:
    anna.say "Ну, поначалу немного больно."

# ch/harems_full/band/events.rpy:2279
translate russian anna_kleio_anal_4670fad9:
    anna.say "Но привыкаешь очень быстро."

# ch/harems_full/band/events.rpy:2280
translate russian anna_kleio_anal_c9a3c2ab:
    "С этими словами она заговорщически придвигается к Клео."

# ch/harems_full/band/events.rpy:2282
translate russian anna_kleio_anal_2cbe0170:
    anna.say "А иногда боль — это самое ПРИЯТНОЕ!"

# ch/harems_full/band/events.rpy:2283
translate russian anna_kleio_anal_7bd5429c:
    "Клео откидывается назад, качает головой и оглядывает паб."

# ch/harems_full/band/events.rpy:2284
translate russian anna_kleio_anal_9b34be02:
    "Я понимаю, что она, вероятно, ждёт моего возвращения к столику, чтобы появился повод сменить тему."

# ch/harems_full/band/events.rpy:2285
translate russian anna_kleio_anal_28d688ab:
    "Поэтому поспешно прячусь так, чтобы меня не было видно, но разговор по-прежнему было хорошо слышно."

# ch/harems_full/band/events.rpy:2287
translate russian anna_kleio_anal_ae2842dd:
    kleio.say "Я... не знаю, Анна."

# ch/harems_full/band/events.rpy:2288
translate russian anna_kleio_anal_43f7dd8e:
    kleio.say "Может, я и попробовала бы. ОДИН РАЗ... и всё."

# ch/harems_full/band/events.rpy:2289
translate russian anna_kleio_anal_5a3ea80c:
    kleio.say "Но только с тем, кому доверяю."

# ch/harems_full/band/events.rpy:2291
translate russian anna_kleio_anal_9b142d7e:
    kleio.say "И всё равно уверена, что мне не понравится!"

# ch/harems_full/band/events.rpy:2293
translate russian anna_kleio_anal_24be7288:
    "Анна прямо сияет, словно это неопровержимое доказательство того, что Клео вот-вот отправится в настоящую анальную одиссею."

# ch/harems_full/band/events.rpy:2294
translate russian anna_kleio_anal_9eb6082c:
    anna.say "О, об этом не волнуйся."

# ch/harems_full/band/events.rpy:2295
translate russian anna_kleio_anal_afa0afc7:
    anna.say "Я знаю, кто прекрасно справится."

# ch/harems_full/band/events.rpy:2296
translate russian anna_kleio_anal_5a9def4e:
    anna.say "Ему я в любое время разрешу ворваться с чёрного хода!"

# ch/harems_full/band/events.rpy:2298
translate russian anna_kleio_anal_ba1da3dd:
    "Я быстро соображаю: Анна наверняка говорит обо мне!"

# ch/harems_full/band/events.rpy:2299
translate russian anna_kleio_anal_d673f7cc:
    "Я нервно сглатываю. Кажется, в пабе вдруг стало невыносимо жарко."

# ch/harems_full/band/events.rpy:2300
translate russian anna_kleio_anal_7752dcbb:
    "Мне едва удаётся вернуться за стол и сделать вид, будто я ничего не слышал."

# ch/harems_full/band/events.rpy:2301
translate russian anna_kleio_anal_d4efb3b6:
    "А в голове тем временем вихрем проносятся мысли о том, что Анна задумала для нас с Клео..."

# ch/harems_full/band/events.rpy:2308
translate russian kleio_anna_showdown_f8e8aec1:
    "Я слышу приближающиеся шаги..."

# ch/harems_full/band/events.rpy:2311
translate russian kleio_anna_showdown_38d934e4:
    "Бросив взгляд через плечо, я вижу Клео и Анну: обе направляются прямо ко мне."

# ch/harems_full/band/events.rpy:2312
translate russian kleio_anna_showdown_e44bc754:
    "Клео, как обычно, держится непринуждённо, но я уже научился читать её самоуверенную насмешливую улыбку и понимаю: ей хочется от меня чего-то интимного."

# ch/harems_full/band/events.rpy:2313
translate russian kleio_anna_showdown_87a83ae5:
    "Анна, как всегда, полная её противоположность: она почти подскакивает на ходу, словно восторженный щенок, и явно не терпит поскорее поделиться со мной своим воодушевлением."

# ch/harems_full/band/events.rpy:2314
translate russian kleio_anna_showdown_4590b119:
    "Я улыбаюсь им обеим, хотя внутри всё сжимается."

# ch/harems_full/band/events.rpy:2315
translate russian kleio_anna_showdown_d770fe79:
    "Может выйти неловко: уверен, ни одна не знает, что я трахаюсь с другой при каждой удобной возможности."

# ch/harems_full/band/events.rpy:2316
translate russian kleio_anna_showdown_88d67ff0:
    anna.say "Слушай, в последнее время ты здорово играешь на репетициях."

# ch/harems_full/band/events.rpy:2318
translate russian kleio_anna_showdown_cbe4032a:
    anna.say "Прямо гитарный волшебник... Ну, знаешь, с волшебной палочкой!"

# ch/harems_full/band/events.rpy:2319
translate russian kleio_anna_showdown_a98d12f8:
    "Она подмигивает так похотливо, как только умеет, хотя выглядит скорее милой и жаждущей внимания. Это намёк на наши разговоры в постели во время последней встречи."

# ch/harems_full/band/events.rpy:2321
translate russian kleio_anna_showdown_2b5badf0:
    kleio.say "Боже, Анна, может, сразу начнёшь лапать его за пах, как чихуахуа во время течки?!"

# ch/harems_full/band/events.rpy:2323
translate russian kleio_anna_showdown_33fd195c:
    kleio.say "Тебе никто не говорил, что некоторые парни предпочитают своенравных уличных кошек комнатным собачкам?"

# ch/harems_full/band/events.rpy:2324
translate russian kleio_anna_showdown_6ce50ba6:
    "Она склоняет голову и лукаво улыбается, зная, что я не могу не понять намёка на то, как мы трахались в переулке после совместной попойки."

# ch/harems_full/band/events.rpy:2326
translate russian kleio_anna_showdown_53e4850a:
    anna.say "Хм, ну, он ничего такого не говорил, когда сделал мне..."

# ch/harems_full/band/events.rpy:2327
translate russian kleio_anna_showdown_4ace2200:
    mike.say "Эй, не так быстро, Анна!"

# ch/harems_full/band/events.rpy:2329
translate russian kleio_anna_showdown_4417456b:
    kleio.say "А когда я ему позволила... он точно не жаловался."

# ch/harems_full/band/events.rpy:2330
translate russian kleio_anna_showdown_6975226e:
    mike.say "Секундочку, Клео!"

# ch/harems_full/band/events.rpy:2331
translate russian kleio_anna_showdown_ba1227c7:
    "Всё это похоже на ролики в интернете, где кто-то что-то разбивает, а потом запись показывают в замедленной съёмке."

# ch/harems_full/band/events.rpy:2334
translate russian kleio_anna_showdown_ca9f2f18:
    "На лицах обеих девушек появляется недоумение, вскоре сменяющееся осознанием, а затем — неизбежными ужасом и яростью."

# ch/harems_full/band/events.rpy:2337
translate russian kleio_anna_showdown_92bb70ae:
    "Они одновременно поворачиваются ко мне, скрестив руки. Их лица полны негодования."

# ch/harems_full/band/events.rpy:2338
translate russian kleio_anna_showdown_6738d8b0:
    mike.say "Девчонки, я могу всё объяснить..."

# ch/harems_full/band/events.rpy:2340
translate russian kleio_anna_showdown_a5d0a69f:
    kleio.say "Чёрт возьми, ты меня даже обрюхатил!"

# ch/harems_full/band/events.rpy:2341
translate russian kleio_anna_showdown_e98d0768:
    "В глазах Анны я замечаю тревогу."

# ch/harems_full/band/events.rpy:2343
translate russian kleio_anna_showdown_5138197d:
    anna.say "Можешь?"

# ch/harems_full/band/events.rpy:2344
translate russian kleio_anna_showdown_dded0f4a:
    kleio.say "Ну, это будет охрененно интересно!"

# ch/harems_full/band/events.rpy:2345
translate russian kleio_anna_showdown_9b7bb21d:
    "Они выжидающе смотрят на меня, но я могу только пожать плечами и вздохнуть."

# ch/harems_full/band/events.rpy:2346
translate russian kleio_anna_showdown_0ebbeaf6:
    mike.say "Нет... Пожалуй, объяснить я не могу."

# ch/harems_full/band/events.rpy:2347
translate russian kleio_anna_showdown_a990d8d9:
    mike.say "Простите... Просто мне было хорошо сразу с двумя потрясающими девушками, и я не смог удержаться."

# ch/harems_full/band/events.rpy:2348
translate russian kleio_anna_showdown_80cf8281:
    "Обе всё ещё явно расстроены и злятся, но моя честность хотя бы немного их смягчила."

# ch/harems_full/band/events.rpy:2349
translate russian kleio_anna_showdown_d0af3ee7:
    "Я собираюсь заговорить, но Клео перебивает меня."

# ch/harems_full/band/events.rpy:2350
translate russian kleio_anna_showdown_de3e61bc:
    kleio.say "А ты заткнись нахрен!"

# ch/harems_full/band/events.rpy:2351
translate russian kleio_anna_showdown_98186c74:
    kleio.say "Ты уже высказался. Всё это из-за того, что ты думал членом, так что спасибо большое!"

# ch/harems_full/band/events.rpy:2352
translate russian kleio_anna_showdown_e9618d45:
    kleio.say "Как всегда, разбираться придётся тем, у кого вагина."

# ch/harems_full/band/events.rpy:2353
translate russian kleio_anna_showdown_4926776e:
    "Анна ничего не добавляет к тираде Клео, но серьёзно кивает в знак согласия."

# ch/harems_full/band/events.rpy:2354
translate russian kleio_anna_showdown_69526e0d:
    "Так что я помалкиваю, ожидая, пока девушки решат мою судьбу."

# ch/harems_full/band/events.rpy:2355
translate russian kleio_anna_showdown_d8d34320:
    "Клео и Анна склоняются друг к другу. Они говорят достаточно громко, чтобы я слышал, но стоят ко мне спиной, напоминая, что здесь решаю не я."

# ch/harems_full/band/events.rpy:2359
translate russian kleio_anna_showdown_d89edf40:
    kleio.say "Ты меня знаешь, Анна. Я девушка довольно широких взглядов."

# ch/harems_full/band/events.rpy:2360
translate russian kleio_anna_showdown_3d1e3e07:
    kleio.say "Но мне слишком часто и слишком сильно делали больно, чтобы я позволила этому херу снова так со мной поступить."

# ch/harems_full/band/events.rpy:2362
translate russian kleio_anna_showdown_f384c7f1:
    anna.say "Прости, Клео, но он мне очень нравится."

# ch/harems_full/band/events.rpy:2363
translate russian kleio_anna_showdown_898d4a00:
    "В ответ на слова Анны она фыркает и раздражённо закатывает глаза."

# ch/harems_full/band/events.rpy:2364
translate russian kleio_anna_showdown_d09474e1:
    anna.say "Знаешь, Клео, ты сама говоришь, что секс — это просто близость двух людей."

# ch/harems_full/band/events.rpy:2365
translate russian kleio_anna_showdown_3386cf42:
    anna.say "Так почему ты меня осуждаешь за то, что мне всё ещё нужен [lssb_common.hero_name()]?"

# ch/harems_full/band/events.rpy:2367
translate russian kleio_anna_showdown_00a8c824:
    kleio.say "Анна, это другое, я..."

# ch/harems_full/band/events.rpy:2368
translate russian kleio_anna_showdown_41417125:
    anna.say "Почему со мной вдруг другое?"

# ch/harems_full/band/events.rpy:2369
translate russian kleio_anna_showdown_1697c096:
    anna.say "Ну и что, что он с тобой тоже спал?"

# ch/harems_full/band/events.rpy:2370
translate russian kleio_anna_showdown_becb28c1:
    anna.say "Мы все спали со многими... А мне нравится заниматься этим с ним."

# ch/harems_full/band/events.rpy:2372
translate russian kleio_anna_showdown_a7c9ea71:
    kleio.say "Ладно, Анна. Если ты так считаешь, забирай его с моего благословения!"

# ch/harems_full/band/events.rpy:2376
translate russian kleio_anna_showdown_90b31131:
    anna.say "Я не могу делить парня с кем-то ещё, Клео."

# ch/harems_full/band/events.rpy:2377
translate russian kleio_anna_showdown_975224a9:
    anna.say "Может, с девушкой было бы иначе... Но у меня так давно не было парня... И это казалось чем-то особенным."

# ch/harems_full/band/events.rpy:2378
translate russian kleio_anna_showdown_88962e0f:
    kleio.say "Понимаю, Анна... Просто... этот хер мне правда нравится. Не спрашивай почему!"

# ch/harems_full/band/events.rpy:2380
translate russian kleio_anna_showdown_38dacc5e:
    "Анна краснеет, явно вспоминая время, проведённое со мной в постели."

# ch/harems_full/band/events.rpy:2382
translate russian kleio_anna_showdown_a84d5a5e:
    anna.say "Что такое, Клео? Ты слишком крутая стерва, чтобы признать, что тебе нравится чувствовать его член внутри?"

# ch/harems_full/band/events.rpy:2383
translate russian kleio_anna_showdown_82e56449:
    "Мы с Клео потрясены тем, что Анна говорит такое на людях. Но мне удаётся промолчать... в отличие от Клео."

# ch/harems_full/band/events.rpy:2385
translate russian kleio_anna_showdown_d81fc885:
    kleio.say "Господи, Анна, сегодня ты никого не щадишь, да?"

# ch/harems_full/band/events.rpy:2386
translate russian kleio_anna_showdown_c7dcc836:
    anna.say "Я просто говорю честно, Клео... Может, и ты хоть раз будешь честной?"

# ch/harems_full/band/events.rpy:2388
translate russian kleio_anna_showdown_56a7df18:
    kleio.say "Ладно, ладно... Да, чёрт возьми, признаю: мне нравится этот хер... и хер этого хера."

# ch/harems_full/band/events.rpy:2390
translate russian kleio_anna_showdown_f2b444f3:
    "Анна улыбается: ей явно стало немного легче оттого, что она вытянула из Клео такое признание."

# ch/harems_full/band/events.rpy:2395
translate russian kleio_anna_showdown_be541cf1:
    kleio.say "Я понятия не имела, что он и тебя трахает, Анна."

# ch/harems_full/band/events.rpy:2396
translate russian kleio_anna_showdown_4807a5e6:
    anna.say "Я тоже... Прости."

# ch/harems_full/band/events.rpy:2397
translate russian kleio_anna_showdown_84380d5b:
    kleio.say "Эй, не вини себя! Из нас троих всё знал только этот придурок!"

# ch/harems_full/band/events.rpy:2398
translate russian kleio_anna_showdown_a6a203fe:
    kleio.say "Знаю, иногда я заносчиво рассуждаю о сексе, но когда дело касается такой подруги, как ты, всё это кажется неправильным."

# ch/harems_full/band/events.rpy:2399
translate russian kleio_anna_showdown_562aee7b:
    anna.say "Да, я чувствую примерно то же... Может, будь это какая-нибудь незнакомая нам обеим девушка, всё было бы иначе."

# ch/harems_full/band/events.rpy:2402
translate russian kleio_anna_showdown_87832347:
    "Я отчётливо чувствую: как бы хорошо девушкам ни было со мной, сейчас они объединяются, и их дружба побеждает."

# ch/harems_full/band/events.rpy:2403
translate russian kleio_anna_showdown_f5bfc197:
    kleio.say "Мы ведь всё ещё подруги?"

# ch/harems_full/band/events.rpy:2404
translate russian kleio_anna_showdown_66c2113b:
    anna.say "Да, наверное... Что нам какой-то хер?"

# ch/harems_full/band/events.rpy:2405
translate russian kleio_anna_showdown_eaaa2445:
    kleio.say "Именно! Ни хрена он не значит!"

# ch/harems_full/band/events.rpy:2408
translate russian kleio_anna_showdown_4aebbb26:
    "Девушки сцепляются мизинцами и с демонстративным удовольствием игнорируют меня."

# ch/harems_full/band/events.rpy:2412
translate russian kleio_anna_showdown_e53c331c:
    kleio.say "А знаешь, Анна, с тех пор как появился этот хер со своим хером, ты стала играть куда лучше!"

# ch/harems_full/band/events.rpy:2413
translate russian kleio_anna_showdown_9e15812c:
    anna.say "На себя посмотри, Клео! Благодаря [lssb_common.hero_name()] у тебя не только голос стал лучше настроен!"

# ch/harems_full/band/events.rpy:2414
translate russian kleio_anna_showdown_d2804632:
    "Вдруг обе смотрят на меня, и я понимаю, что должна чувствовать раненая газель под взглядами двух львиц."

# ch/harems_full/band/events.rpy:2416
translate russian kleio_anna_showdown_5f94b51e:
    kleio.say "На дворе двадцать первый век, Анна... И мы ведь хорошие подруги?"

# ch/harems_full/band/events.rpy:2418
translate russian kleio_anna_showdown_ebe19c4e:
    anna.say "Да, Клео... А хорошие подруги делятся, верно?"

# ch/harems_full/band/events.rpy:2420
translate russian kleio_anna_showdown_a37dbcf3:
    kleio.say "Конечно... Косметикой, одеждой, вибраторами... И достойным членом, когда такой наконец попадается."

# ch/harems_full/band/events.rpy:2422
translate russian kleio_anna_showdown_b262f862:
    anna.say "О, поверь... Я знаю, как долго такого приходится ждать!"

# ch/harems_full/band/events.rpy:2423
translate russian kleio_anna_showdown_5290ba3b:
    "Анна уже безудержно хихикает, наслаждаясь моим смущением."

# ch/harems_full/band/events.rpy:2424
translate russian kleio_anna_showdown_e955b47a:
    "Клео явно тоже весело, но что-то в её глазах подсказывает: она уже представляет открывающиеся возможности."

# ch/harems_full/band/events.rpy:2427
translate russian kleio_anna_showdown_111e3273:
    kleio.say "Как я всегда говорю, Анна, секс — это просто встреча двух людей... или трёх."

# ch/harems_full/band/events.rpy:2428
translate russian kleio_anna_showdown_98dfa8b1:
    anna.say "Ну, если он будет спать с другими девушками, пусть лучше это будем ты... и я!"

# ch/harems_full/band/events.rpy:2429
translate russian kleio_anna_showdown_fe3ee653:
    "Я невольно сглатываю, одновременно пугаясь и весьма возбуждаясь от такой перспективы."

# ch/harems_full/band/events.rpy:2430
translate russian kleio_anna_showdown_7045a24b:
    "Кажется, девушки решили оставить меня себе, совершенно не интересуясь моими чувствами!"

# ch/harems_full/band/events.rpy:2432
translate russian kleio_anna_showdown_3e264263:
    "О главном вслух никто не говорит..."

# ch/harems_full/band/events.rpy:2433
translate russian kleio_anna_showdown_3391754f:
    "Но я вижу, как Клео и Анна обмениваются многозначительными взглядами. Это безмолвный код, в который меня не посвящают."

# ch/harems_full/band/events.rpy:2434
translate russian kleio_anna_showdown_a3f612cf:
    "Сам я, честно говоря, никак не решу, хорошо или плохо то, что произошло."

# ch/harems_full/band/events.rpy:2435
translate russian kleio_anna_showdown_27defc27:
    "Но уверен: серьёзные последствия для меня не заставят себя долго ждать."

# ch/harems_full/band/events.rpy:2441
translate russian date_set_up_e98cfd23:
    "Во время репетиции ко мне подходят поговорить Клео и Анна."

# ch/harems_full/band/events.rpy:2444
translate russian date_set_up_6a9b5deb:
    kleio.say "Ты ведёшь нас на ужин."

# ch/harems_full/band/events.rpy:2445
translate russian date_set_up_1eb0943a:
    mike.say "Ого... хорошо!"

# ch/harems_full/band/events.rpy:2455
translate russian date_set_up_f5e215b8:
    anna.say "Будет так весело!"

# ch/harems_full/band/events.rpy:2460
translate russian kleio_and_anna_missed_454552b3:
    "Чёрт, я пропустил свидание с Клео и Анной."

# ch/harems_full/band/events.rpy:2470
translate russian kleio_and_anna_43740617:
    "Мне до сих пор трудно поверить в то, к чему мы пришли с Клео и Анной."

# ch/harems_full/band/events.rpy:2471
translate russian kleio_and_anna_30de7816:
    "Выяснив, что я встречался с каждой за спиной у другой, они решили меня делить."

# ch/harems_full/band/events.rpy:2472
translate russian kleio_and_anna_a9a89eaa:
    "С одной стороны, голова кружится от перспективы участвовать в том, что можно назвать «танцем на троих»."

# ch/harems_full/band/events.rpy:2473
translate russian kleio_and_anna_12ce5eee:
    "Но это совершенно неизведанная для меня территория, и на самом деле довольно страшно."

# ch/harems_full/band/events.rpy:2474
translate russian kleio_and_anna_ce115514:
    "Мы решаем не торопиться и начать с ужина в новом модном китайском ресторане в центре города."

# ch/harems_full/band/events.rpy:2475
translate russian kleio_and_anna_65f25cf0:
    "Я жду девушек на тротуаре, то и дело поглядывая на часы."

# ch/harems_full/band/events.rpy:2476
translate russian kleio_and_anna_6453c28f:
    anna.say "Привет!"

# ch/harems_full/band/events.rpy:2477
translate russian kleio_and_anna_1b959ec7:
    kleio.say "Здорово, парень!"

# ch/harems_full/band/events.rpy:2481
translate russian kleio_and_anna_8426bed9:
    "То, что они пришли вместе, должно было бы сразу насторожить меня, но я слишком занят, любуясь ими."

# ch/harems_full/band/events.rpy:2482
translate russian kleio_and_anna_e59ce05d:
    "На Анне яркая юбка, в которой она похожа на невероятно соблазнительную маленькую фею, и топ, подчёркивающий её впечатляющую грудь."

# ch/harems_full/band/events.rpy:2483
translate russian kleio_and_anna_71e6a999:
    "А Клео в короткой клетчатой юбке, колготках в сеточку и укороченном топе под кожаной курткой — настоящая панк-принцесса."

# ch/harems_full/band/events.rpy:2484
translate russian kleio_and_anna_67e77811:
    mike.say "Привет, девчонки... Вы сегодня потрясающе выглядите."

# ch/harems_full/band/events.rpy:2486
translate russian kleio_and_anna_558ca271:
    "Анна и Клео замечают мою нарядную рубашку, брюки и туфли."

# ch/harems_full/band/events.rpy:2488
translate russian kleio_and_anna_5c2fa884:
    kleio.say "Ого, какой у нас сегодня франт!"

# ch/harems_full/band/events.rpy:2490
translate russian kleio_and_anna_4dd22517:
    anna.say "Ну не язви, Клео... [lssb_common.hero_name()] так постарался ради нас. Это очень мило."

# ch/harems_full/band/events.rpy:2491
translate russian kleio_and_anna_f9f5a0f6:
    kleio.say "Как скажешь. Но если кто-нибудь примет тебя за нашего сутенёра, я обязательно подыграю — смеха ради."

# ch/harems_full/band/events.rpy:2495
translate russian kleio_and_anna_20cc3d36:
    "Анна и Клео замечают, что на мне рубашка поло и брюки цвета хаки."

# ch/harems_full/band/events.rpy:2497
translate russian kleio_and_anna_0fb9e500:
    kleio.say "Прямо из офисного загона к нам?"

# ch/harems_full/band/events.rpy:2499
translate russian kleio_and_anna_e21ae375:
    anna.say "Я забыла, что Саша говорила о твоей работе... Кажется, что-то с компьютерами?"

# ch/harems_full/band/events.rpy:2500
translate russian kleio_and_anna_de911126:
    kleio.say "Не переживай: вдруг в ресторане понадобится починить Wi-Fi, и ты станешь героем вечера!"

# ch/harems_full/band/events.rpy:2504
translate russian kleio_and_anna_bd9d2989:
    "Анна и Клео замечают мою кожаную куртку, футболку с группой и рваные джинсы."

# ch/harems_full/band/events.rpy:2506
translate russian kleio_and_anna_addbfdd2:
    anna.say "О-о... ОБОЖАЮ эту группу!"

# ch/harems_full/band/events.rpy:2508
translate russian kleio_and_anna_1b304157:
    kleio.say "Наш человек! Наш человек! Наш человек!"

# ch/harems_full/band/events.rpy:2509
translate russian kleio_and_anna_31bea9ff:
    "Я невольно расплываюсь в улыбке, понимая, что благодаря моей одежде мы выглядим как троица, противостоящая всему остальному обыденному миру."

# ch/harems_full/band/events.rpy:2515
translate russian kleio_and_anna_c03d39ab:
    kleio.say "Ого, [lssb_common.hero_name()]! Вот это постарался, чтобы девушка почувствовала себя особенной!"

# ch/harems_full/band/events.rpy:2517
translate russian kleio_and_anna_6458c820:
    anna.say "Не слушай её, [lssb_common.hero_name()]... Мы уже и коллеги по группе, и друзья... ну, и кое-что большее."

# ch/harems_full/band/events.rpy:2518
translate russian kleio_and_anna_f7f8fc50:
    anna.say "Тебе же не нужно производить первое впечатление."

# ch/harems_full/band/events.rpy:2526
translate russian kleio_and_anna_dcdc46f7:
    "Мы заходим внутрь. Официант у входа проверяет бронь и провожает нас к столику с мягкими диванами."

# ch/harems_full/band/events.rpy:2527
translate russian kleio_and_anna_aa5969a5:
    "Официант — молодой симпатичный азиат, и я чувствую, как он молча разглядывает Анну и Клео."

# ch/harems_full/band/events.rpy:2531
translate russian kleio_and_anna_e49e2bc7:
    "Его явное восхищение ещё сильнее пьянит меня: как же мне повезло пойти на свидание сразу с обеими!"

# ch/harems_full/band/events.rpy:2532
translate russian kleio_and_anna_969c952f:
    "Раздав меню, официант предлагает мне заказать напитки для всех."

# ch/harems_full/band/events.rpy:2535
translate russian kleio_and_anna_4cfe3a93:
    mike.say "Три малиновых «Космополитена», пожалуйста."

# ch/harems_full/band/events.rpy:2537
translate russian kleio_and_anna_14609ab8:
    anna.say "О-о, звучит вкусно... и крепко."

# ch/harems_full/band/events.rpy:2539
translate russian kleio_and_anna_7ce687b4:
    kleio.say "Ага, но сладенькие тут, похоже, не только коктейли!"

# ch/harems_full/band/events.rpy:2543
translate russian kleio_and_anna_3f859dbc:
    mike.say "Три пива, пожалуйста."

# ch/harems_full/band/events.rpy:2545
translate russian kleio_and_anna_81257d45:
    kleio.say "О да! И подносите ещё!"

# ch/harems_full/band/events.rpy:2547
translate russian kleio_and_anna_e1d3f7df:
    anna.say "А-а, но те коктейли были такие красивые и яркие..."

# ch/harems_full/band/events.rpy:2551
translate russian kleio_and_anna_071eda0e:
    mike.say "Три водки со льдом."

# ch/harems_full/band/events.rpy:2553
translate russian kleio_and_anna_f96c40da:
    anna.say "Ой, не помню, когда я в последний раз пила водку... В основном потому, сколько я тогда её выпила."

# ch/harems_full/band/events.rpy:2555
translate russian kleio_and_anna_832de1a2:
    kleio.say "Ого, ты не мелочишься... Люблю таких мужчин!"

# ch/harems_full/band/events.rpy:2560
translate russian kleio_and_anna_a6a8536a:
    mike.say "Кувшин воды из-под крана и три стакана, пожалуйста."

# ch/harems_full/band/events.rpy:2562
translate russian kleio_and_anna_8a85553f:
    kleio.say "Ух ты, какой щедрый господин!"

# ch/harems_full/band/events.rpy:2564
translate russian kleio_and_anna_72ada1a4:
    anna.say "Ну, вечер только начинается... Может, [lssb_common.hero_name()] любит начинать потихоньку, а потом набирать обороты?"

# ch/harems_full/band/events.rpy:2570
translate russian kleio_and_anna_318c6984:
    "Официант возвращается с напитками, и приходит пора заказать еду."

# ch/harems_full/band/events.rpy:2571
translate russian kleio_and_anna_619c7301:
    "Меню такое огромное и запутанное, что я теряюсь. Чтобы сохранить лицо, предлагаю взять один из готовых наборов на троих."

# ch/harems_full/band/events.rpy:2572
translate russian kleio_and_anna_6d272976:
    anna.say "Отличная идея, [lssb_common.hero_name()]! Сможем попробовать всего понемногу."

# ch/harems_full/band/events.rpy:2573
translate russian kleio_and_anna_2cc54297:
    kleio.say "По мне, здорово... Когда всё время одно и то же, рано или поздно надоедает."

# ch/harems_full/band/events.rpy:2574
translate russian kleio_and_anna_b9fac6b7:
    "Вскоре приносят еду. Меня поражает количество блюд на столе, и я даже не знаю, с чего начать."

# ch/harems_full/band/events.rpy:2575
translate russian kleio_and_anna_04ff8e0a:
    "Не могу не заметить сходства между этим ужином и моими новыми отношениями с Анной и Клео."

# ch/harems_full/band/events.rpy:2578
translate russian kleio_and_anna_6dfe3119:
    "Я начинаю есть ножом и вилкой: пользоваться палочками так и не научился."

# ch/harems_full/band/events.rpy:2579
translate russian kleio_and_anna_63e45936:
    kleio.say "Ну же, [lssb_common.hero_name()]! В чужой монастырь со своим уставом и всякая такая хрень!"

# ch/harems_full/band/events.rpy:2581
translate russian kleio_and_anna_b0579764:
    "Клео смеётся, давая понять, что просто подкалывает меня ради забавы."

# ch/harems_full/band/events.rpy:2582
translate russian kleio_and_anna_bd5197ed:
    "Анна нервно покашливает и придвигается ближе, прежде чем заговорить."

# ch/harems_full/band/events.rpy:2583
translate russian kleio_and_anna_db4b5bb9:
    anna.say "Не расстраивайся... Я тоже никогда ими не умела!"

# ch/harems_full/band/events.rpy:2587
translate russian kleio_and_anna_2c7af625:
    "Я хватаю палочки и принимаюсь за еду."

# ch/harems_full/band/events.rpy:2588
translate russian kleio_and_anna_320995b0:
    kleio.say "Ого... Какой утончённый едок с нами сегодня ужинает!"

# ch/harems_full/band/events.rpy:2590
translate russian kleio_and_anna_ba6ddbda:
    "Смех Клео и огонёк в её глазах дают понять, что она просто развлекается, подкалывая меня."

# ch/harems_full/band/events.rpy:2592
translate russian kleio_and_anna_d8c18ecd:
    anna.say "[lssb_common.hero_name()], у тебя настоящий талант!"

# ch/harems_full/band/events.rpy:2594
translate russian kleio_and_anna_6cae227e:
    anna.say "Покажешь, как это делается?.. А может, покормишь меня немножко?"

# ch/harems_full/band/events.rpy:2599
translate russian kleio_and_anna_832de639:
    "Время идёт, и свидание, кажется, складывается очень удачно."

# ch/harems_full/band/events.rpy:2600
translate russian kleio_and_anna_7bf081a8:
    "Мне очень нравятся перепалки Анны и Клео: они расслабляются и становятся всё непринуждённее."

# ch/harems_full/band/events.rpy:2601
translate russian kleio_and_anna_b1df222c:
    "Если вот так и выглядят настоящие отношения втроём, то это словно вечер с хорошими друзьями... только с перспективой группового секса в конце."

# ch/harems_full/band/events.rpy:2602
translate russian kleio_and_anna_10561878:
    "Вдруг я чувствую прикосновение к левому бедру."

# ch/harems_full/band/events.rpy:2604
translate russian kleio_and_anna_086af235:
    "Смотрю налево и вижу Анну: раскрасневшаяся от еды и выпивки, она маняще улыбается и сжимает мою левую ногу свободной рукой."

# ch/harems_full/band/events.rpy:2605
translate russian kleio_and_anna_3f975ce1:
    "Секунду спустя я чувствую похожее прикосновение справа."

# ch/harems_full/band/events.rpy:2607
translate russian kleio_and_anna_2378e757:
    "Я поворачиваю голову и вижу Клео: она многозначительно облизывает губы и щиплет меня за правую ногу как можно ближе к паху."

# ch/harems_full/band/events.rpy:2610
translate russian kleio_and_anna_7a3cfbd3:
    "Меня бросает в жар, и я немало паникую от мысли, что обе девушки ласкают меня в общественном месте."

# ch/harems_full/band/events.rpy:2611
translate russian kleio_and_anna_d4e37fa2:
    mike.say "Ого... Не знаю, как вы, а у меня штаны сейчас лопнут!"

# ch/harems_full/band/events.rpy:2612
translate russian kleio_and_anna_859ae22e:
    "Я нарочито подчёркиваю слова и пытаюсь взглядом указать на пах, чтобы передать их истинный смысл."

# ch/harems_full/band/events.rpy:2613
translate russian kleio_and_anna_6108b28f:
    "Клео вопросительно поднимает бровь. Кажется, она меня поняла."

# ch/harems_full/band/events.rpy:2615
translate russian kleio_and_anna_b7eda612:
    "А вот Анна поникает, явно решив, что я её отвергаю."

# ch/harems_full/band/events.rpy:2616
translate russian kleio_and_anna_92ff09a6:
    anna.say "А-а... А я ещё немного голодна."

# ch/harems_full/band/events.rpy:2618
translate russian kleio_and_anna_08893a51:
    kleio.say "Анна, дурочка! Он предлагает забрать угощение домой... НА ВЫНОС!"

# ch/harems_full/band/events.rpy:2620
translate russian kleio_and_anna_08cb99a5:
    "Анна не сразу понимает, а потом краснеет и смеётся чуть громче, чем следовало бы, развеселившись и возбудившись."

# ch/harems_full/band/events.rpy:2625
translate russian kleio_and_anna_23d65125:
    "Может, за меня думают алкоголь или нервы... Но вдруг мне хочется увидеть, как Анна ещё сильнее возбуждается на людях."

# ch/harems_full/band/events.rpy:2626
translate russian kleio_and_anna_01555dfa:
    "Я поворачиваюсь к ней, одновременно скользя рукой вверх по внутренней стороне её бедра."

# ch/harems_full/band/events.rpy:2627
translate russian kleio_and_anna_a23f6dd6:
    "Прикосновение к колготкам и тепло её бедра становятся ещё восхитительнее при виде того, как она тает."

# ch/harems_full/band/events.rpy:2628
translate russian kleio_and_anna_04def84f:
    "Добравшись до самого верха бедра, я едва касаюсь края её промежности."

# ch/harems_full/band/events.rpy:2630
translate russian kleio_and_anna_685ee1f5:
    "Щёки Анны заметно покраснели, и она уже почти задыхается. Кажется, я мог бы заставить её умолять, словно собачку, прямо здесь, в ресторане."

# ch/harems_full/band/events.rpy:2632
translate russian kleio_and_anna_f9b8c898:
    "Я смотрю на Клео и вижу, что она слегка хмурится, оставшись без внимания."

# ch/harems_full/band/events.rpy:2633
translate russian kleio_and_anna_502e167e:
    "Но замечаю и то, что её свободная рука замерла где-то у собственного паха: похоже, от недостатка внимания ей ещё сильнее хочется восстановить равновесие."

# ch/harems_full/band/events.rpy:2637
translate russian kleio_and_anna_954ed983:
    "Кажется, бунтарский дух Клео передаётся и мне: забыв о последствиях, я инстинктивно отвечаю на её ласки."

# ch/harems_full/band/events.rpy:2638
translate russian kleio_and_anna_355ade43:
    "Я поворачиваюсь к ней и смотрю в глаза, а правой рукой грубо хватаюсь за подол короткой юбки и ползу выше, словно огромный паук."

# ch/harems_full/band/events.rpy:2639
translate russian kleio_and_anna_c046c807:
    "Но сюрприз ждёт меня: кончики пальцев обнаруживают, что она уже горячая и влажная."

# ch/harems_full/band/events.rpy:2640
translate russian kleio_and_anna_dd9ca355:
    "И что трусиков на ней сегодня вообще нет."

# ch/harems_full/band/events.rpy:2642
translate russian kleio_and_anna_27c0d1d1:
    "Я не могу скрыть изумления, и лукавый взгляд Клео в ответ заставляет меня желать её сильнее прежнего."

# ch/harems_full/band/events.rpy:2643
translate russian kleio_and_anna_6ba2c850:
    "Наконец я отрываю взгляд от Клео и смотрю на Анну — скорее чтобы немного успокоиться, чем из настоящего беспокойства о второй девушке."

# ch/harems_full/band/events.rpy:2645
translate russian kleio_and_anna_4b112a07:
    "Анна явно расстроена вниманием, которое я уделяю Клео, но её обиженное выражение почему-то делает её ещё желаннее."

# ch/harems_full/band/events.rpy:2649
translate russian kleio_and_anna_187462ee:
    "Я разрываюсь, переводя взгляд с одной на другую: хочется одновременно вкусить и нежность Анны, и терпкую притягательность Клео."

# ch/harems_full/band/events.rpy:2650
translate russian kleio_and_anna_8ba6ccd3:
    "Думая, что, наверное, сошёл с ума, я кладу по руке на ближайшее ко мне бедро каждой девушки и начинаю сжимать их, скользя вверх."

# ch/harems_full/band/events.rpy:2651
translate russian kleio_and_anna_1489e999:
    "Контраст гладких колготок Анны и сеточки Клео на их тёплых бёдрах невероятно приятен."

# ch/harems_full/band/events.rpy:2654
translate russian kleio_and_anna_4ffd1d2c:
    "Я украдкой поглядываю на их лица: они смотрят друг на друга, явно возбуждённые тем, что один мужчина ласкает их обеих."

# ch/harems_full/band/events.rpy:2655
translate russian kleio_and_anna_eda10245:
    "Мгновение спустя я приподнимаю обе юбки ровно настолько, чтобы гладить девушек между ног."

# ch/harems_full/band/events.rpy:2656
translate russian kleio_and_anna_395470da:
    "Прикасаться к Анне даже через колготки и трусики восхитительно, но тут я с настоящим удивлением понимаю, что Клео её превзошла: на ней трусиков вообще нет."

# ch/harems_full/band/events.rpy:2660
translate russian kleio_and_anna_8e2bf4b9:
    "Нарочитое покашливание разрушает чары. Я поднимаю глаза и вижу официанта у нашего стола."

# ch/harems_full/band/events.rpy:2661
translate russian kleio_and_anna_74145f3b:
    "Мы втроём тут же приходим в себя и пытаемся изобразить, что просто изрядно выпили и хотим спать, а вовсе не разгорячились перед предстоящим сексом втроём."

# ch/harems_full/band/events.rpy:2662
translate russian kleio_and_anna_0801145c:
    "Понятия не имею, понял ли официант, что происходит и как устроены наши отношения."

# ch/harems_full/band/events.rpy:2663
translate russian kleio_and_anna_0fa2bae6:
    mike.say "Эм... Можно счёт, пожалуйста?"

# ch/harems_full/band/events.rpy:2666
translate russian kleio_and_anna_b276de0f:
    "Когда приносят счёт, я решаю сделать красивый жест и оплатить ужин."

# ch/harems_full/band/events.rpy:2667
translate russian kleio_and_anna_ad081f1e:
    mike.say "Не волнуйтесь, девчонки, я угощаю."

# ch/harems_full/band/events.rpy:2669
translate russian kleio_and_anna_c2982102:
    anna.say "О-о, спасибо, [lssb_common.hero_name()]... Какой джентльмен."

# ch/harems_full/band/events.rpy:2671
translate russian kleio_and_anna_d9a906de:
    kleio.say "Ура-ура... Мой рыцарь в сияющих доспехах!"

# ch/harems_full/band/events.rpy:2676
translate russian kleio_and_anna_9d5fbc73:
    "Когда приносят счёт, я понимаю, что забыл бумажник."

# ch/harems_full/band/events.rpy:2677
translate russian kleio_and_anna_edab677a:
    mike.say "Вот чёрт... Кажется, я оставил бумажник дома!"

# ch/harems_full/band/events.rpy:2679
translate russian kleio_and_anna_d9e23276:
    anna.say "Ох, [lssb_common.hero_name()]... Сейчас заплатим мы, а в следующий раз ты нас угостишь."

# ch/harems_full/band/events.rpy:2681
translate russian kleio_and_anna_b004e410:
    kleio.say "Охренеть, [lssb_common.hero_name()]! У тебя память дырявая, как швейцарский сыр!"

# ch/harems_full/band/events.rpy:2686
translate russian kleio_and_anna_0af1f6b5:
    "Когда приносят счёт, я вспоминаю, что в наших отношениях все равны — даже когда нужно за что-то платить."

# ch/harems_full/band/events.rpy:2687
translate russian kleio_and_anna_6e12fbaf:
    mike.say "Давайте каждый за себя."

# ch/harems_full/band/events.rpy:2689
translate russian kleio_and_anna_179f7619:
    anna.say "По-моему, справедливо."

# ch/harems_full/band/events.rpy:2691
translate russian kleio_and_anna_7aa29791:
    kleio.say "Ладно... Не нужно со мной нянчиться."

# ch/harems_full/band/events.rpy:2693
translate russian kleio_and_anna_f60c2c83:
    "Расплатившись, мы вызываем такси и едем ко мне, надеясь продолжить с того места, на котором недавно остановились."

# ch/harems_full/band/events.rpy:2700
translate russian kleio_and_anna_8be6b394:
    "Расплатившись, мы возвращаемся на улицу."

# ch/harems_full/band/events.rpy:2701
translate russian kleio_and_anna_9abc2cf6:
    anna.say "Спасибо, [lssb_common.hero_name()]. Был чудесный вечер."

# ch/harems_full/band/events.rpy:2702
translate russian kleio_and_anna_78b128ca:
    kleio.say "Да, надо бы скоро повторить."

# ch/harems_full/band/events.rpy:2713
translate russian kleio_anna_threesome_cc646905:
    "Такси высаживает нас троих у моего дома, и я стараюсь выглядеть уверенно, пропуская девушек внутрь."

# ch/harems_full/band/events.rpy:2714
translate russian kleio_anna_threesome_f7a92799:
    "Но на самом деле я уже потею: ведь я заранее не проверил, будет ли сегодня кто-нибудь дома."

# ch/harems_full/band/events.rpy:2719
translate russian kleio_anna_threesome_9055b0d3:
    "Мы заходим в гостиную. Анна и Клео уже хихикают, отпускают двусмысленные замечания, щиплют и щекочут меня — вообще-то это должно было бы радовать."

# ch/harems_full/band/events.rpy:2723
translate russian kleio_anna_threesome_1cfa77ad:
    "Я прикладываю палец к губам в тщетной надежде заставить их хоть на миг притихнуть."

# ch/harems_full/band/events.rpy:2724
translate russian kleio_anna_threesome_437795d8:
    mike.say "Эй... Есть кто дома?"

# ch/harems_full/band/events.rpy:2727
translate russian kleio_anna_threesome_3da91063:
    "В ответ лишь тишина, и я облегчённо вздыхаю."

# ch/harems_full/band/events.rpy:2729
translate russian kleio_anna_threesome_b3e4e447:
    anna.say "Что такое, [lssb_common.hero_name()]? Думал, кто-то дома?"

# ch/harems_full/band/events.rpy:2731
translate russian kleio_anna_threesome_3d0c7983:
    kleio.say "Без разницы! Я заставлю вас кончить так, что будет слышно на другом конце квартала!"

# ch/harems_full/band/events.rpy:2734
translate russian kleio_anna_threesome_0b7f6a86:
    "К моему ужасу, из-за двери гостиной выглядывает [bree.name]."

# ch/harems_full/band/events.rpy:2737
translate russian kleio_anna_threesome_b12263db:
    bree.say "Привет, [lssb_common.hero_name()], ты... О, и твоим подругам привет!"

# ch/harems_full/band/events.rpy:2738
translate russian kleio_anna_threesome_9eb913bb:
    mike.say "Мы... эм... пойдём ко мне. Просто чтобы ты знала... если услышишь что-нибудь странное."

# ch/harems_full/band/events.rpy:2740
translate russian kleio_anna_threesome_310bef89:
    "[bree.name] не может сдержать смешок, закрывая дверь. Она прекрасно понимает, что происходит между нами троими."

# ch/harems_full/band/events.rpy:2744
translate russian kleio_anna_threesome_f136ad8a:
    "Я остаюсь стоять с открытым ртом, когда Саша открывает дверь своей спальни и улыбается мне."

# ch/harems_full/band/events.rpy:2745
translate russian kleio_anna_threesome_a2350a3f:
    sasha.say "О, привет, [lssb_common.hero_name()]! Вы были в..."

# ch/harems_full/band/events.rpy:2747
translate russian kleio_anna_threesome_4f299d95:
    "Она замолкает, заметив за моей спиной своих растрёпанных и развеселившихся подруг по группе."

# ch/harems_full/band/events.rpy:2748
translate russian kleio_anna_threesome_4887bd8c:
    sasha.say "Это дела группы... или вы втроём работаете над побочным проектом у меня за спиной?"

# ch/harems_full/band/events.rpy:2751
translate russian kleio_anna_threesome_1a2795c9:
    "Анна и Клео разражаются непристойным смехом. Похоже, из-за всего этого нервничаю только я."

# ch/harems_full/band/events.rpy:2752
translate russian kleio_anna_threesome_f4260254:
    sasha.say "Не смотри так испуганно, [lssb_common.hero_name()]. Они меня уже предупредили!"

# ch/harems_full/band/events.rpy:2756
translate russian kleio_anna_threesome_98338cae:
    "Прежде чем я успеваю возразить, Анна и Клео заталкивают меня в спальню."

# ch/harems_full/band/events.rpy:2762
translate russian kleio_anna_threesome_5a11a019:
    "Из-за двери гостиной выглядывает [bree.name], а затем из своей спальни — Саша."

# ch/harems_full/band/events.rpy:2763
translate russian kleio_anna_threesome_fefc75c8:
    "Я открываю рот, но не могу вымолвить ни слова: обе мои соседки видят, что я привёл домой двух других девушек."

# ch/harems_full/band/events.rpy:2764
translate russian kleio_anna_threesome_88667fb1:
    bree.say "Эй, [lssb_common.hero_name()], у нас вечеринка?"

# ch/harems_full/band/events.rpy:2765
translate russian kleio_anna_threesome_6446f0c6:
    sasha.say "Или репетиция?"

# ch/harems_full/band/events.rpy:2767
translate russian kleio_anna_threesome_fa6a0b1f:
    kleio.say "Ни то ни другое... Но вам скоро пригодятся наушники!"

# ch/harems_full/band/events.rpy:2771
translate russian kleio_anna_threesome_d5c620f4:
    "[bree.name] и Саша понимающе посмеиваются и скрываются обратно в своих комнатах."

# ch/harems_full/band/events.rpy:2772
translate russian kleio_anna_threesome_07685f80:
    "А я остаюсь гадать, неужели во всём мире лишь я один не отношусь к сексу втроём с таким спокойствием."

# ch/harems_full/band/events.rpy:2776
translate russian kleio_anna_threesome_11932c93:
    "Каждая из девушек берёт меня за руку, и они ведут меня в спальню, едва не сбивая с ног."

# ch/harems_full/band/events.rpy:2781
translate russian kleio_anna_threesome_6b170efd:
    "Я пытаюсь собраться с мыслями и что-то сказать, но от их взгляда тут же замолкаю."

# ch/harems_full/band/events.rpy:2782
translate russian kleio_anna_threesome_c51015ee:
    "Клео толкает меня на кровать, Анна расстёгивает мою ширинку, и у меня возникает отчётливое ощущение, что они всё спланировали заранее."

# ch/harems_full/band/events.rpy:2783
translate russian kleio_anna_threesome_122a19a6:
    "Анна быстро стягивает мои брюки и бельё до щиколоток, с присущим ей рвением полностью обнажая меня ниже пояса."

# ch/harems_full/band/events.rpy:2784
translate russian kleio_anna_threesome_d8e7df26:
    "Клео, напротив, не торопится снимать с меня верх: водит по телу руками и время от времени целует."

# ch/harems_full/band/events.rpy:2785
translate russian kleio_anna_threesome_30783f82:
    anna.say "Ого, Клео! Иди посмотри!"

# ch/harems_full/band/events.rpy:2786
translate russian kleio_anna_threesome_0e2c48ae:
    kleio.say "Ну здравствуй, маленький [lssb_common.hero_name()]... Кажется, мы ему нравимся, Анна!"

# ch/harems_full/band/events.rpy:2787
translate russian kleio_anna_threesome_ae2c6fe6:
    "Анна уже стоит передо мной на коленях, а теперь и Клео опускается рядом с ней."

# ch/harems_full/band/events.rpy:2788
translate russian kleio_anna_threesome_c9a7cb3f:
    "Обе смотрят на меня снизу вверх и тянутся пальцами к моему быстро твердеющему члену."

# ch/harems_full/band/events.rpy:2789
translate russian kleio_anna_threesome_8a7ac235:
    "От прикосновений он покачивается, словно живая игрушка на пружине, к великому удовольствию девушек."

# ch/harems_full/band/events.rpy:2790
translate russian kleio_anna_threesome_4035f22c:
    kleio.say "Погоди, Анна. Здесь все равны, так что давай уравняем положение."

# ch/harems_full/band/events.rpy:2791
translate russian kleio_anna_threesome_365733dd:
    anna.say "А?"

# ch/harems_full/band/events.rpy:2793
translate russian kleio_anna_threesome_af16af65:
    "Не объясняя Анне своих слов, Клео снимает кожаную куртку, а затем стягивает через голову короткий топ."

# ch/harems_full/band/events.rpy:2794
translate russian kleio_anna_threesome_6e6c3a51:
    "Когда она расстёгивает бюстгальтер и освобождает небольшую грудь, Анна понимающе хихикает и следует её примеру."

# ch/harems_full/band/events.rpy:2796
translate russian kleio_anna_threesome_1dcd814f:
    "Спустя миг её гораздо более крупная и тяжёлая грудь тоже обнажена, и обе девушки стоят передо мной голые по пояс."

# ch/harems_full/band/events.rpy:2815
translate russian kleio_anna_threesome_4cda2baa:
    "Я никогда не увлекался античной мифологией, но сейчас, кажется, понимаю, что чувствовал древний грек, столкнувшийся с сиренами."

# ch/harems_full/band/events.rpy:2827
translate russian kleio_anna_threesome_6f97b4d6:
    "Я глубоко вдыхаю и тянусь к одной из двух девушек передо мной."

# ch/harems_full/band/events.rpy:2833
translate russian kleio_anna_threesome_9dd6b7b0:
    "Оказавшись в моей спальне, девушки не тратят времени на прелюдию."

# ch/harems_full/band/events.rpy:2834
translate russian kleio_anna_threesome_023eed07:
    "Раздеваясь, они толкают меня на кровать."

# ch/harems_full/band/events.rpy:2851
translate russian kleio_anna_threesome_98249f2a:
    "Хорошие девочки, может, и попадают в рай, но для меня всегда побеждают плохие. Я ложусь на спину и притягиваю Клео к себе."

# ch/harems_full/band/events.rpy:2852
translate russian kleio_anna_threesome_afa42c46:
    "Но она не позволяет себя тянуть и сама наползает на меня, словно уличная кошка в течке."

# ch/harems_full/band/events.rpy:2853
translate russian kleio_anna_threesome_534eea94:
    "Клео смотрит мне в глаза, и её почти насмешливый призыв заставляет меня уже через секунду войти в неё."

# ch/harems_full/band/events.rpy:2858
translate russian kleio_anna_threesome_6fd8fc19:
    "Когда я заполняю её, Клео почти мурлычет от удовольствия и скачет на мне, словно похотливая сучка. Её теснота заставляет меня двигаться сильнее и жёстче, чем я обычно решаюсь."

# ch/harems_full/band/events.rpy:2859
translate russian kleio_anna_threesome_0f9695f4:
    anna.say "Эй, вы двое... Про меня не забывайте!"

# ch/harems_full/band/events.rpy:2861
translate russian kleio_anna_threesome_b675450d:
    "Если Клео — дикая уличная кошка, то Анна — игривая кошечка. Она вынимает мой член из Клео и берёт его в рот."

# ch/harems_full/band/events.rpy:2862
translate russian kleio_anna_threesome_f72d8088:
    "Клео начинает ласкать свою небольшую грудь и лукаво усмехается: Анна доставляет удовольствие нам обоим сразу."

# ch/harems_full/band/events.rpy:2863
translate russian kleio_anna_threesome_b36cff17:
    "Анна целует основание моего члена — сначала нежно, потом всё настойчивее."

# ch/harems_full/band/events.rpy:2864
translate russian kleio_anna_threesome_d313b59f:
    "Продвигаясь выше, она начинает гладить его языком, а затем вылизывать по всей длине."

# ch/harems_full/band/events.rpy:2866
translate russian kleio_anna_threesome_70e0c445:
    "Через некоторое время она направляет мой член к киске Клео и вводит его внутрь."

# ch/harems_full/band/events.rpy:2867
translate russian kleio_anna_threesome_0d1b6569:
    "От наших совместных усилий Клео стонет и извивается. Её движения заставляют меня чувствовать приближение оргазма."

# ch/harems_full/band/events.rpy:2870
translate russian kleio_anna_threesome_2468ba9a:
    "От усилий и жара наших тел мы так вспотели, что Клео почти выскальзывает из моих рук."

# ch/harems_full/band/events.rpy:2872
translate russian kleio_anna_threesome_ae407645:
    "Но я удерживаю её, чувствуя, как меня наконец захлёстывает волна оргазма."

# ch/harems_full/band/events.rpy:2873
translate russian kleio_anna_threesome_4f4e355b:
    "Ощущения внутри Клео доводят и её до предела, и через мгновение она тоже кончает."

# ch/harems_full/band/events.rpy:2877
translate russian kleio_anna_threesome_839cfea7:
    "Когда меня начинает сотрясать дрожь, я одной рукой обхватываю затылок Анны и вхожу глубже. Она не возражает, хотя глаза немного слезятся."

# ch/harems_full/band/events.rpy:2879
translate russian kleio_anna_threesome_7990eef8:
    "Со стоном я хватаю ртом воздух. Мой член дёргается и пульсирует, посылая струи горячей спермы прямо ей в горло, и ей приходится быстро глотать."

# ch/harems_full/band/events.rpy:2880
translate russian kleio_anna_threesome_c19c9bd0:
    "Оргазм проходит не сразу. Когда это наконец происходит, я падаю обратно на кровать, тяжело дыша и пытаясь отдышаться."

# ch/harems_full/band/events.rpy:2881
translate russian kleio_anna_threesome_9ae88662:
    "Сквозь пелену ощущений я чувствую, как Анна нежно облизывает мой член, прежде чем отстраниться."

# ch/harems_full/band/events.rpy:2892
translate russian kleio_anna_threesome_a4d930d7:
    "Мы втроём лежим, мокрые от пота и скользкие после наших совместных стараний, а я начинаю испытывать странную гордость за то, что мы только что сделали."

# ch/harems_full/band/events.rpy:2893
translate russian kleio_anna_threesome_48919a71:
    "У всех, даже у Клео, довольные улыбки. Кажется, всем вполне достаточно помолчать и насладиться послевкусием."

# ch/harems_full/band/events.rpy:2894
translate russian kleio_anna_threesome_09d6b8bc:
    "Постепенно мы устраиваемся на кровати, свернувшись и прижавшись друг к другу почти так же тесно, как минуту назад во время секса."

# ch/harems_full/band/events.rpy:2897
translate russian kleio_anna_threesome_b906c424:
    "Вдруг Анна вздрагивает от громкого храпа."

# ch/harems_full/band/events.rpy:2898
translate russian kleio_anna_threesome_2f089abd:
    anna.say "Ой! Что это за звук?"

# ch/harems_full/band/events.rpy:2899
translate russian kleio_anna_threesome_335beb4d:
    mike.say "Кажется, мы вымотали Клео!"

# ch/harems_full/band/events.rpy:2900
translate russian kleio_anna_threesome_20b78b9b:
    "Мы с Анной смотрим на Клео: она спит без задних ног и храпит, словно лесопилка."

# ch/harems_full/band/events.rpy:2902
translate russian kleio_anna_threesome_70b23405:
    anna.say "Ну разве она не милая, когда спит?"

# ch/harems_full/band/events.rpy:2903
translate russian kleio_anna_threesome_70f8e357:
    "Я лишь тихо смеюсь, но не могу не признать: Анна права."

# ch/harems_full/band/events.rpy:2917
translate russian anna_concert_naked_e387a639:
    "Я всё стараюсь сохранять невозмутимое выражение лица."

# ch/harems_full/band/events.rpy:2918
translate russian anna_concert_naked_c5e964a7:
    "В надежде ничем не выдать своих истинных намерений."

# ch/harems_full/band/events.rpy:2919
translate russian anna_concert_naked_5c34b8ff:
    "Но рядом с Анной это довольно трудно."

# ch/harems_full/band/events.rpy:2920
translate russian anna_concert_naked_e81fc6f0:
    "Ведь всякий раз, глядя в её сторону, я невольно начинаю её разглядывать!"

# ch/harems_full/band/events.rpy:2922
translate russian anna_concert_naked_a7dd9a90:
    anna.say "[lssb_common.hero_name()]…"

# ch/harems_full/band/events.rpy:2923
translate russian anna_concert_naked_2dced2ff:
    anna.say "Ты делаешь то, о чём я думаю?"

# ch/harems_full/band/events.rpy:2925
translate russian anna_concert_naked_6e45c425:
    mike.say "Смотря о чём ты думаешь, Анна!"

# ch/harems_full/band/events.rpy:2927
translate russian anna_concert_naked_a9fef7f7:
    "Я слышу её милое хихиканье."

# ch/harems_full/band/events.rpy:2929
translate russian anna_concert_naked_ab5df83c:
    "А затем она появляется прямо перед моими глазами."

# ch/harems_full/band/events.rpy:2930
translate russian anna_concert_naked_21362daf:
    anna.say "Ну..."

# ch/harems_full/band/events.rpy:2931
translate russian anna_concert_naked_01e4559a:
    anna.say "Мне кажется, ты меня разглядывал!"

# ch/harems_full/band/events.rpy:2932
translate russian anna_concert_naked_b0469902:
    "Было бы гораздо проще смотреть ей в глаза, если бы в некоторых местах природа одарила её не так щедро."

# ch/harems_full/band/events.rpy:2933
translate russian anna_concert_naked_a307bfcb:
    "Вот сейчас, например, её грудь прижата прямо ко мне."

# ch/harems_full/band/events.rpy:2934
translate russian anna_concert_naked_19727ce0:
    "И при каждом движении грудь Анны подпрыгивает, словно пара мячей!"

# ch/harems_full/band/events.rpy:2936
translate russian anna_concert_naked_8c3e325f:
    mike.say "Возможно, Анна..."

# ch/harems_full/band/events.rpy:2938
translate russian anna_concert_naked_a18ae663:
    anna.say "Ох, [lssb_common.hero_name()]…"

# ch/harems_full/band/events.rpy:2939
translate russian anna_concert_naked_447f1b67:
    anna.say "Я совсем не против!"

# ch/harems_full/band/events.rpy:2941
translate russian anna_concert_naked_7d7ee5d2:
    anna.say "Просто подумала: может, ты хочешь рассмотреть получше?"

# ch/harems_full/band/events.rpy:2942
translate russian anna_concert_naked_359a8dee:
    "В подтверждение своих слов Анна выпячивает грудь ко мне."

# ch/harems_full/band/events.rpy:2943
translate russian anna_concert_naked_f5474419:
    "И я не преувеличиваю: она оказывается в паре сантиметров от моего лица."

# ch/harems_full/band/events.rpy:2944
translate russian anna_concert_naked_fc840307:
    "Я почти забываю, чего изначально добивался."

# ch/harems_full/band/events.rpy:2945
translate russian anna_concert_naked_90ee9a17:
    "Но, вспомнив, немного отступаю."

# ch/harems_full/band/events.rpy:2946
translate russian anna_concert_naked_24962a0e:
    mike.say "Спасибо, Анна..."

# ch/harems_full/band/events.rpy:2947
translate russian anna_concert_naked_f0dea6b1:
    mike.say "Но, может, позже, ладно?"

# ch/harems_full/band/events.rpy:2949
translate russian anna_concert_naked_767bafd6:
    "Мой ответ немного её огорчает."

# ch/harems_full/band/events.rpy:2950
translate russian anna_concert_naked_8aa61eac:
    "Так что я решаю перейти прямо к делу."

# ch/harems_full/band/events.rpy:2951
translate russian anna_concert_naked_31687b8a:
    "Возможно, это поможет отвлечь её и сменить тему."

# ch/harems_full/band/events.rpy:2952
translate russian anna_concert_naked_7a3a31b5:
    mike.say "Я тут подумал..."

# ch/harems_full/band/events.rpy:2954
translate russian anna_concert_naked_e80b1bf6:
    mike.say "Когда мы выступаем с группой..."

# ch/harems_full/band/events.rpy:2955
translate russian anna_concert_naked_a818a171:
    mike.say "Публика видит, какие мы талантливые и творческие."

# ch/harems_full/band/events.rpy:2956
translate russian anna_concert_naked_94c4038a:
    mike.say "Ну, слушая нашу музыку, понимаешь?"

# ch/harems_full/band/events.rpy:2958
translate russian anna_concert_naked_bbdef109:
    "Такая внезапная перемена темы немало озадачивает Анну."

# ch/harems_full/band/events.rpy:2959
translate russian anna_concert_naked_ebd059e8:
    "Но я вижу, что она всеми силами старается скрыть растерянность."

# ch/harems_full/band/events.rpy:2960
translate russian anna_concert_naked_177945e2:
    "Вместо этого она изо всех сил изображает интерес к моим словам."

# ch/harems_full/band/events.rpy:2962
translate russian anna_concert_naked_84973bf7:
    anna.say "Эм..."

# ch/harems_full/band/events.rpy:2963
translate russian anna_concert_naked_6de21f6a:
    anna.say "Да..."

# ch/harems_full/band/events.rpy:2964
translate russian anna_concert_naked_fdcdbf34:
    anna.say "Понимаю, о чём ты."

# ch/harems_full/band/events.rpy:2965
translate russian anna_concert_naked_d0e1a4ac:
    mike.say "Вот и жаль, что эту твою сторону они не видят, Анна."

# ch/harems_full/band/events.rpy:2966
translate russian anna_concert_naked_0599ca66:
    mike.say "Ведь твоё тело впечатляет не меньше, чем игра на барабанах."

# ch/harems_full/band/events.rpy:2968
translate russian anna_concert_naked_e9ecdaf8:
    "На лице Анны появляется смущённая улыбка."

# ch/harems_full/band/events.rpy:2969
translate russian anna_concert_naked_50639148:
    "Щёки тоже краснеют."

# ch/harems_full/band/events.rpy:2970
translate russian anna_concert_naked_c1bcc5fa:
    "Она оглядывается, словно боится, что кто-то меня услышал."

# ch/harems_full/band/events.rpy:2972
translate russian anna_concert_naked_57682eb7:
    anna.say "[lssb_common.hero_name()], какой же ты иногда озорник!"

# ch/harems_full/band/events.rpy:2973
translate russian anna_concert_naked_4367abc8:
    anna.say "Я бы ни за что не смогла... стоять голой на сцене."

# ch/harems_full/band/events.rpy:2975
translate russian anna_concert_naked_c397f263:
    mike.say "Почему нет, Анна?"

# ch/harems_full/band/events.rpy:2976
translate russian anna_concert_naked_140ab861:
    mike.say "Я видел, как многие артисты так делали."

# ch/harems_full/band/events.rpy:2977
translate russian anna_concert_naked_9151f68c:
    mike.say "А если ты артист, это не непристойность и не грязь."

# ch/harems_full/band/events.rpy:2979
translate russian anna_concert_naked_00fe92e7:
    "Теперь Анна хмурится, глядя на меня."

# ch/harems_full/band/events.rpy:2980
translate russian anna_concert_naked_5cce6ce8:
    "Больше ей не удаётся скрывать непонимание."

# ch/harems_full/band/events.rpy:2981
translate russian anna_concert_naked_b8ff07ba:
    anna.say "Правда?"

# ch/harems_full/band/events.rpy:2982
translate russian anna_concert_naked_91dbf48c:
    mike.say "Нет, Анна..."

# ch/harems_full/band/events.rpy:2983
translate russian anna_concert_naked_14129ebc:
    mike.say "Это искусство, а не пошлость!"

# ch/harems_full/band/events.rpy:2984
translate russian anna_concert_naked_f5e92f76:
    mike.say "Думаешь, почему на картинах и в скульптурах это допускается?"

# ch/harems_full/band/events.rpy:2986
translate russian anna_concert_naked_62072a09:
    "Я вижу, как Анна обдумывает мои слова."

# ch/harems_full/band/events.rpy:2987
translate russian anna_concert_naked_f9e5ecee:
    "Кажется, я почти слышу, как в её голове крутятся шестерёнки."

# ch/harems_full/band/events.rpy:2989
translate russian anna_concert_naked_0afd6b4f:
    anna.say "А, точно..."

# ch/harems_full/band/events.rpy:2990
translate russian anna_concert_naked_51890180:
    anna.say "Я всегда этому удивлялась!"

# ch/harems_full/band/events.rpy:2992
translate russian anna_concert_naked_7bf340a2:
    "Я даю ей ещё несколько мгновений переварить эту мысль."

# ch/harems_full/band/events.rpy:2993
translate russian anna_concert_naked_5c174a5c:
    "Ровно столько, чтобы Анна успела запутаться во всех этих непростых новых идеях и возможностях."

# ch/harems_full/band/events.rpy:2994
translate russian anna_concert_naked_04a84a32:
    "А потом задаю вопрос."

# ch/harems_full/band/events.rpy:2995
translate russian anna_concert_naked_f4beea33:
    "Тот самый, к которому всё это время подводил."

# ch/harems_full/band/events.rpy:2998
translate russian anna_concert_naked_8a25b1d2:
    mike.say "Может, нашей группе тоже стоит выступать голыми?"

# ch/harems_full/band/events.rpy:3001
translate russian anna_concert_naked_bdb7d2e7:
    "Услышав это, Анна тут же начинает кивать."

# ch/harems_full/band/events.rpy:3002
translate russian anna_concert_naked_df563417:
    "И я вижу, как от этой мысли её глаза расширяются."

# ch/harems_full/band/events.rpy:3004
translate russian anna_concert_naked_40483f35:
    anna.say "Ты прав, [lssb_common.hero_name()]…"

# ch/harems_full/band/events.rpy:3006
translate russian anna_concert_naked_232a8c8c:
    anna.say "Люди ведь всегда говорят, что человеческое тело прекрасно."

# ch/harems_full/band/events.rpy:3007
translate russian anna_concert_naked_c85785dd:
    anna.say "Что его совсем не нужно стесняться, понимаешь?"

# ch/harems_full/band/events.rpy:3008
translate russian anna_concert_naked_666faae1:
    anna.say "Так почему бы нам не показать свои тела?"

# ch/harems_full/band/events.rpy:3010
translate russian anna_concert_naked_cc9ed2b3:
    "Я уже с готовностью киваю."

# ch/harems_full/band/events.rpy:3011
translate russian anna_concert_naked_348c57de:
    "Всеми силами стараюсь подбодрить Анну."

# ch/harems_full/band/events.rpy:3012
translate russian anna_concert_naked_d9bfd3fb:
    mike.say "В самую точку, Анна."

# ch/harems_full/band/events.rpy:3013
translate russian anna_concert_naked_f0f5f70a:
    mike.say "Мы должны подавать пример."

# ch/harems_full/band/events.rpy:3014
translate russian anna_concert_naked_c4a7c9da:
    mike.say "Раздеться на идейной почве!"

# ch/harems_full/band/events.rpy:3016
translate russian anna_concert_naked_34436865:
    "Анна смотрит на меня с недоумением."

# ch/harems_full/band/events.rpy:3017
translate russian anna_concert_naked_9ca68c29:
    anna.say "Где?"

# ch/harems_full/band/events.rpy:3018
translate russian anna_concert_naked_e70323be:
    anna.say "Я думала, мы будем делать это на сцене?"

# ch/harems_full/band/events.rpy:3019
translate russian anna_concert_naked_919f7a3e:
    mike.say "Это образное выражение, Анна..."

# ch/harems_full/band/events.rpy:3020
translate russian anna_concert_naked_ccdc8780:
    mike.say "Помнишь, мы об этом говорили?"

# ch/harems_full/band/events.rpy:3022
translate russian anna_concert_naked_0f4f6eed:
    "Анна кивает и улыбается."

# ch/harems_full/band/events.rpy:3023
translate russian anna_concert_naked_03f8510b:
    "Но я сомневаюсь, что она помнит."

# ch/harems_full/band/events.rpy:3025
translate russian anna_concert_naked_96e3f8da:
    anna.say "В общем..."

# ch/harems_full/band/events.rpy:3027
translate russian anna_concert_naked_c1471a22:
    anna.say "Я позвоню девчонкам."

# ch/harems_full/band/events.rpy:3028
translate russian anna_concert_naked_7cce9414:
    anna.say "И расскажу им о твоей замечательной идее!"

# ch/harems_full/band/events.rpy:3031
translate russian anna_concert_naked_91dbf48c_1:
    mike.say "Нет, Анна..."

# ch/harems_full/band/events.rpy:3032
translate russian anna_concert_naked_dfc06beb:
    mike.say "Лучше предоставь это мне. Ведь идея моя, да?"

# ch/harems_full/band/events.rpy:3033
translate russian anna_concert_naked_88ebfdd0:
    "Анна пожимает плечами."

# ch/harems_full/band/events.rpy:3035
translate russian anna_concert_naked_73a34cd7:
    anna.say "Как скажешь, [lssb_common.hero_name()]…"

# ch/harems_full/band/events.rpy:3036
translate russian anna_concert_naked_51bcaca7:
    anna.say "Но я уверена, что они тоже захотят."

# ch/harems_full/band/events.rpy:3038
translate russian anna_concert_naked_d409d77f:
    anna.say "Особенно когда узнают, что всё это ради искусства и всякого такого!"

# ch/harems_full/band/events.rpy:3042
translate russian anna_concert_naked_0cbe383a:
    "Услышав эти слова, Анна словно приходит в себя."

# ch/harems_full/band/events.rpy:3043
translate russian anna_concert_naked_e15fe21d:
    "До этого она широко раскрывала глаза и ловила каждое моё слово."

# ch/harems_full/band/events.rpy:3044
translate russian anna_concert_naked_c533293b:
    "Но теперь в этих же глазах настоящий страх."

# ch/harems_full/band/events.rpy:3046
translate russian anna_concert_naked_b19436e4:
    anna.say "О нет, [lssb_common.hero_name()]…"

# ch/harems_full/band/events.rpy:3047
translate russian anna_concert_naked_770d4490:
    anna.say "Я так не смогу!"

# ch/harems_full/band/events.rpy:3048
translate russian anna_concert_naked_ee91b4b1:
    anna.say "Такое годится только для художников и статуйщиков, как ты и сказал!"

# ch/harems_full/band/events.rpy:3049
translate russian anna_concert_naked_43f8ec26:
    mike.say "Скульпторов, Анна..."

# ch/harems_full/band/events.rpy:3050
translate russian anna_concert_naked_7c05c7b9:
    mike.say "Людей, которые делают статуи, называют скульпторами."

# ch/harems_full/band/events.rpy:3051
translate russian anna_concert_naked_1ee88865:
    "Анна слишком взволнована, чтобы обижаться на поправку."

# ch/harems_full/band/events.rpy:3052
translate russian anna_concert_naked_3d977c0f:
    "Хоть на том спасибо."

# ch/harems_full/band/events.rpy:3054
translate russian anna_concert_naked_ec095988:
    anna.say "Как бы они ни назывались, это другое."

# ch/harems_full/band/events.rpy:3055
translate russian anna_concert_naked_d364545c:
    anna.say "Я всего лишь барабанщица в рок-группе."

# ch/harems_full/band/events.rpy:3056
translate russian anna_concert_naked_2f942a8c:
    anna.say "Не могу же я выйти туда голой!"

# ch/harems_full/band/events.rpy:3059
translate russian anna_concert_naked_08ff9ac8:
    "Я подумываю ещё немного поспорить с Анной."

# ch/harems_full/band/events.rpy:3060
translate russian anna_concert_naked_9227178e:
    "Но по её лицу вижу, что смысла нет."

# ch/harems_full/band/events.rpy:3061
translate russian anna_concert_naked_bfa74043:
    "Она уже почти довела себя до паники."

# ch/harems_full/band/events.rpy:3062
translate russian anna_concert_naked_f5104fe6:
    "А когда доведёт, успокаиваться будет несколько часов."

# ch/harems_full/band/events.rpy:3063
translate russian anna_concert_naked_4257190b:
    "Так что пока я решаю оставить эту тему."

# ch/harems_full/band/events.rpy:3064
translate russian anna_concert_naked_a97e5019:
    "Может, доработаю доводы и попробую в другой раз."

# ch/harems_full/band/events.rpy:3065
translate russian anna_concert_naked_4fbd67ed:
    "К тому времени Анна, возможно, вообще забудет об этом предложении."

# ch/harems_full/band/events.rpy:3066
translate russian anna_concert_naked_251b1556:
    "И можно будет начать с чистого листа."

# ch/harems_full/band/events.rpy:3073
translate russian kleio_concert_naked_4948948e:
    "С любой другой девушкой я начал бы издалека, прежде чем рассказать о своей идее."

# ch/harems_full/band/events.rpy:3074
translate russian kleio_concert_naked_75c6e403:
    "Рассыпал бы условные хлебные крошки, чтобы подвести её к сути дела."

# ch/harems_full/band/events.rpy:3075
translate russian kleio_concert_naked_e154fa4f:
    "Но с Клео такое не сработает: она почти сразу меня раскусит."

# ch/harems_full/band/events.rpy:3076
translate russian kleio_concert_naked_c1d7eafa:
    "С ней нужен другой подход, который на первый взгляд кажется куда грубее."

# ch/harems_full/band/events.rpy:3077
translate russian kleio_concert_naked_3635e4f9:
    "Хотя на самом деле под поверхностью скрываются собственные хитрости и тонкости."

# ch/harems_full/band/events.rpy:3078
translate russian kleio_concert_naked_8c8ab87e:
    "Проверенное временем искусство обратной психологии..."

# ch/harems_full/band/events.rpy:3080
translate russian kleio_concert_naked_647913e6:
    mike.say "Эй, Клео..."

# ch/harems_full/band/events.rpy:3081
translate russian kleio_concert_naked_ea4275cd:
    mike.say "Ты когда-нибудь..."

# ch/harems_full/band/events.rpy:3083
translate russian kleio_concert_naked_26ed5c3a:
    kleio.say "Что я когда-нибудь, сердцеед?"

# ch/harems_full/band/events.rpy:3084
translate russian kleio_concert_naked_33ff4d7e:
    "Как только Клео отвечает, я замолкаю, а потом качаю головой."

# ch/harems_full/band/events.rpy:3085
translate russian kleio_concert_naked_e9b3b5cf:
    mike.say "Не..."

# ch/harems_full/band/events.rpy:3086
translate russian kleio_concert_naked_19a2840a:
    mike.say "Забудь, Клео."

# ch/harems_full/band/events.rpy:3088
translate russian kleio_concert_naked_1840de9d:
    mike.say "Ничего важного."

# ch/harems_full/band/events.rpy:3090
translate russian kleio_concert_naked_41f33b48:
    "Я ещё не успеваю отвернуться, а Клео уже заглотила наживку."

# ch/harems_full/band/events.rpy:3091
translate russian kleio_concert_naked_7fa55c1b:
    "Чувствую, как её рука ложится мне на плечо и разворачивает обратно."

# ch/harems_full/band/events.rpy:3093
translate russian kleio_concert_naked_a0f27cff:
    kleio.say "Ну уж хрен тебе!"

# ch/harems_full/band/events.rpy:3094
translate russian kleio_concert_naked_4657f32a:
    kleio.say "Знаешь же, как меня это бесит..."

# ch/harems_full/band/events.rpy:3095
translate russian kleio_concert_naked_abef3719:
    kleio.say "Так что говори, что хотел, пока я сама из тебя не вытрясла!"

# ch/harems_full/band/events.rpy:3097
translate russian kleio_concert_naked_bcfc72ce:
    "Всё ещё стараясь держать роль, я пожимаю плечами."

# ch/harems_full/band/events.rpy:3098
translate russian kleio_concert_naked_672f943e:
    "А потом вздыхаю с надеждой, что это убедительно прозвучит как капитуляция."

# ch/harems_full/band/events.rpy:3099
translate russian kleio_concert_naked_24f879c1:
    mike.say "Ладно, Клео, ладно..."

# ch/harems_full/band/events.rpy:3100
translate russian kleio_concert_naked_295a0f46:
    mike.say "Просто у меня появилась безумная идея для нашей группы."

# ch/harems_full/band/events.rpy:3101
translate russian kleio_concert_naked_e1eff554:
    mike.say "Нечто настолько дерзкое и сумасшедшее, что это по-настоящему бросило бы вызов публике."

# ch/harems_full/band/events.rpy:3102
translate russian kleio_concert_naked_fce0aa92:
    mike.say "Я хотел предложить её тебе, но потом подумал: нет."

# ch/harems_full/band/events.rpy:3103
translate russian kleio_concert_naked_6d54643f:
    mike.say "Лучше рассказать Саше. Или даже Анне."

# ch/harems_full/band/events.rpy:3104
translate russian kleio_concert_naked_8e54bb12:
    "Странно: у человека ведь не должна вставать дыбом шерсть."

# ch/harems_full/band/events.rpy:3105
translate russian kleio_concert_naked_36362935:
    "Но, клянусь, я вижу, как Клео ощетинивается, словно кошка, почуявшая настоящую угрозу."

# ch/harems_full/band/events.rpy:3107
translate russian kleio_concert_naked_ca4bee16:
    kleio.say "И с какого хрена, позволь спросить?"

# ch/harems_full/band/events.rpy:3108
translate russian kleio_concert_naked_2f87a722:
    kleio.say "С каких пор эти две дурочки стали дерзче меня?"

# ch/harems_full/band/events.rpy:3109
translate russian kleio_concert_naked_a17c6d84:
    kleio.say "Да они не узнали бы ничего дерзкого, даже проснувшись с ним в одной постели после пьянки!"

# ch/harems_full/band/events.rpy:3111
translate russian kleio_concert_naked_79f8833d:
    "Я изо всех сил сдерживаю улыбку: Клео идёт прямиком в мою ловушку."

# ch/harems_full/band/events.rpy:3112
translate russian kleio_concert_naked_663ff0de:
    "Она так злится из-за того, что её обошли, что это застилает ей глаза."

# ch/harems_full/band/events.rpy:3113
translate russian kleio_concert_naked_f5f01823:
    "А значит, ей куда сложнее трезво обдумать моё предложение."

# ch/harems_full/band/events.rpy:3114
translate russian kleio_concert_naked_b20fbb4d:
    mike.say "Как скажешь, Клео..."

# ch/harems_full/band/events.rpy:3115
translate russian kleio_concert_naked_22210ff5:
    mike.say "Я просто подумал: нагота — это ведь последний рубеж?"

# ch/harems_full/band/events.rpy:3116
translate russian kleio_concert_naked_77ecd990:
    mike.say "Все заявляют о себе тем, как одеваются."

# ch/harems_full/band/events.rpy:3117
translate russian kleio_concert_naked_4a60695e:
    mike.say "Так что, если Deathless Harpies выйдут на сцену вообще без одежды..."

# ch/harems_full/band/events.rpy:3118
translate russian kleio_concert_naked_c0877dc7:
    mike.say "Разве мы не станем самой смелой и передовой группой?"

# ch/harems_full/band/events.rpy:3120
translate russian kleio_concert_naked_042a4c95:
    "Когда моя мысль наконец проясняется, Клео хмурится."

# ch/harems_full/band/events.rpy:3121
translate russian kleio_concert_naked_2bb7e5f5:
    kleio.say "Что ты такое говоришь, сердцеед?"

# ch/harems_full/band/events.rpy:3123
translate russian kleio_concert_naked_221a39b8:
    kleio.say "Хочешь, чтобы мы давали концерты голышом?!"

# ch/harems_full/band/events.rpy:3124
translate russian kleio_concert_naked_9a2a3472:
    "Я с готовностью киваю, стараясь говорить убедительно."

# ch/harems_full/band/events.rpy:3125
translate russian kleio_concert_naked_8454c8c5:
    mike.say "Именно, Клео..."

# ch/harems_full/band/events.rpy:3126
translate russian kleio_concert_naked_843869eb:
    mike.say "Нам всем стоит выступать голыми!"

# ch/harems_full/band/events.rpy:3129
translate russian kleio_concert_naked_7c7851a2:
    "На миг мне кажется, что Клео сейчас рассмеётся мне в лицо."

# ch/harems_full/band/events.rpy:3130
translate russian kleio_concert_naked_07c6f3c8:
    "Но потом я вижу, что она всерьёз задумалась."

# ch/harems_full/band/events.rpy:3131
translate russian kleio_concert_naked_1eaf91ca:
    kleio.say "А знаешь..."

# ch/harems_full/band/events.rpy:3133
translate russian kleio_concert_naked_d305af93:
    kleio.say "В этом что-то есть!"

# ch/harems_full/band/events.rpy:3134
translate russian kleio_concert_naked_04a94ecf:
    kleio.say "Всю жизнь на нас вешают ярлыки и загоняют в рамки."

# ch/harems_full/band/events.rpy:3135
translate russian kleio_concert_naked_b5a5f152:
    kleio.say "Даже наша одежда — по сути корпоративные бирки и рекламные щиты."

# ch/harems_full/band/events.rpy:3137
translate russian kleio_concert_naked_660647e2:
    kleio.say "Только раздевшись, мы сбрасываем всю эту хрень."

# ch/harems_full/band/events.rpy:3138
translate russian kleio_concert_naked_e3a3c2ec:
    kleio.say "И показываем себя настоящих!"

# ch/harems_full/band/events.rpy:3140
translate russian kleio_concert_naked_bf19fab1:
    "Пожалуй, я понимаю меньше половины того, что говорит Клео."

# ch/harems_full/band/events.rpy:3141
translate russian kleio_concert_naked_06be3e31:
    "Но чувствую: в основном она согласна и всё больше загорается."

# ch/harems_full/band/events.rpy:3142
translate russian kleio_concert_naked_8cc423af:
    "А значит, Клео вот-вот с головой бросится в эту затею."

# ch/harems_full/band/events.rpy:3143
translate russian kleio_concert_naked_3d3c8bae:
    mike.say "Знал ведь, что надо довериться чутью, Клео..."

# ch/harems_full/band/events.rpy:3144
translate russian kleio_concert_naked_a4c26f30:
    mike.say "Знал, что нужно сначала прийти к тебе!"

# ch/harems_full/band/events.rpy:3145
translate russian kleio_concert_naked_eb056641:
    mike.say "Ты всегда мыслишь нестандартно!"

# ch/harems_full/band/events.rpy:3147
translate russian kleio_concert_naked_db587fde:
    "Клео может сколько угодно притворяться, что не любит похвалу и лесть."

# ch/harems_full/band/events.rpy:3148
translate russian kleio_concert_naked_a65db5d5:
    "Но на самом деле они ей нравятся ничуть не меньше, чем любой другой девушке."

# ch/harems_full/band/events.rpy:3149
translate russian kleio_concert_naked_7552dd2f:
    "А может, и больше, если льстить её представлению о себе как о бунтарке."

# ch/harems_full/band/events.rpy:3151
translate russian kleio_concert_naked_a39a7895:
    kleio.say "Вот тут ты прав, сердцеед!"

# ch/harems_full/band/events.rpy:3152
translate russian kleio_concert_naked_7a6794b9:
    kleio.say "Если у кого и хватит яиц выйти голой на сцену, так это у меня."

# ch/harems_full/band/events.rpy:3154
translate russian kleio_concert_naked_f6a5f573:
    kleio.say "А теперь иди и предложи остальным."

# ch/harems_full/band/events.rpy:3155
translate russian kleio_concert_naked_bec9b9f0:
    kleio.say "Посмотрим, хватит ли и у них духу!"

# ch/harems_full/band/events.rpy:3157
translate russian kleio_concert_naked_f501773d:
    "Я киваю, соглашаясь со всем, что говорит Клео."

# ch/harems_full/band/events.rpy:3158
translate russian kleio_concert_naked_be1a7674:
    "И изо всех сил делаю вид, будто идея принадлежала ей."

# ch/harems_full/band/events.rpy:3159
translate russian kleio_concert_naked_fa0cc09c:
    "Это ведь ещё один способ вить из неё верёвки."

# ch/harems_full/band/events.rpy:3160
translate russian kleio_concert_naked_b97df585:
    "Причём и его она вряд ли заметит."

# ch/harems_full/band/events.rpy:3164
translate russian kleio_concert_naked_867584d9:
    "Клео запрокидывает голову и смеётся над моим предложением."

# ch/harems_full/band/events.rpy:3165
translate russian kleio_concert_naked_b18e2203:
    "А потом смотрит мне в глаза и демонстративно смеётся прямо в лицо."

# ch/harems_full/band/events.rpy:3166
translate russian kleio_concert_naked_794bacfd:
    kleio.say "Ха!"

# ch/harems_full/band/events.rpy:3168
translate russian kleio_concert_naked_dfde929b:
    kleio.say "Придётся придумать что-нибудь получше, сердцеед."

# ch/harems_full/band/events.rpy:3170
translate russian kleio_concert_naked_72d6981a:
    "Я качаю головой, стараясь выглядеть озадаченным её ответом."

# ch/harems_full/band/events.rpy:3171
translate russian kleio_concert_naked_6f715477:
    mike.say "Не понимаю, Клео..."

# ch/harems_full/band/events.rpy:3172
translate russian kleio_concert_naked_eaca306b:
    mike.say "О чём ты?"

# ch/harems_full/band/events.rpy:3174
translate russian kleio_concert_naked_69493d63:
    "Клео закатывает глаза."

# ch/harems_full/band/events.rpy:3175
translate russian kleio_concert_naked_879aed3a:
    "Похоже, она видит мою игру насквозь."

# ch/harems_full/band/events.rpy:3177
translate russian kleio_concert_naked_1e469115:
    kleio.say "Думаешь, меня раньше так не обрабатывали?"

# ch/harems_full/band/events.rpy:3178
translate russian kleio_concert_naked_c40e5029:
    kleio.say "Сначала сказать, что другие скорее поймут твою идею..."

# ch/harems_full/band/events.rpy:3180
translate russian kleio_concert_naked_ba60d99b:
    kleio.say "А потом подцепить меня, задев за живое?"

# ch/harems_full/band/events.rpy:3181
translate russian kleio_concert_naked_470c5edd:
    kleio.say "И выступать голышом?"

# ch/harems_full/band/events.rpy:3182
translate russian kleio_concert_naked_4156f483:
    kleio.say "Серьёзно?"

# ch/harems_full/band/events.rpy:3184
translate russian kleio_concert_naked_150e12c3:
    kleio.say "За какую дуру ты меня держишь?!"

# ch/harems_full/band/events.rpy:3186
translate russian kleio_concert_naked_22b95526:
    "Я чувствую, как меня охватывают смущение и неловкость."

# ch/harems_full/band/events.rpy:3187
translate russian kleio_concert_naked_cbb7b6a2:
    "Вскоре я уже смотрю по сторонам, избегая её взгляда."

# ch/harems_full/band/events.rpy:3188
translate russian kleio_concert_naked_b250b96f:
    mike.say "Нет, Клео..."

# ch/harems_full/band/events.rpy:3189
translate russian kleio_concert_naked_7e825e4d:
    mike.say "Всё совсем не так."

# ch/harems_full/band/events.rpy:3191
translate russian kleio_concert_naked_c83ebca6:
    "Клео наклоняется ко мне с улыбкой."

# ch/harems_full/band/events.rpy:3192
translate russian kleio_concert_naked_1f80ba21:
    "Такой милой, что я совершенно теряю бдительность."

# ch/harems_full/band/events.rpy:3194
translate russian kleio_concert_naked_8e9d680f:
    "Но тут она хватает меня за яйца и сжимает, а я ахаю."

# ch/harems_full/band/events.rpy:3195
translate russian kleio_concert_naked_223b50fd:
    mike.say "А-а-а..."

# ch/harems_full/band/events.rpy:3197
translate russian kleio_concert_naked_8d5e6604:
    kleio.say "Радуйся, что вообще можешь видеть меня голой, сердцеед..."

# ch/harems_full/band/events.rpy:3200
translate russian kleio_concert_naked_dd3fb684:
    kleio.say "Иначе я отрежу эти штуки и сделаю из них ожерелье!"

# ch/harems_full/band/events.rpy:3207
translate russian sasha_concert_naked_f6c2eb46:
    "Некоторых девушек нужно постепенно подводить к теме."

# ch/harems_full/band/events.rpy:3208
translate russian sasha_concert_naked_87f8bcef:
    "Других — убедить, что идея принадлежит им."

# ch/harems_full/band/events.rpy:3209
translate russian sasha_concert_naked_59951ec1:
    "Но с такой девушкой, как Саша, ни то ни другое не сработает."

# ch/harems_full/band/events.rpy:3210
translate russian sasha_concert_naked_a0f9ff6b:
    "Ей придётся сказать всё прямо."

# ch/harems_full/band/events.rpy:3211
translate russian sasha_concert_naked_9e717119:
    "А согласится она или нет — зависит от того, как преподнести идею."

# ch/harems_full/band/events.rpy:3212
translate russian sasha_concert_naked_921177e8:
    "Проблема лишь в том, о чём именно мне нужно попросить Сашу."

# ch/harems_full/band/events.rpy:3213
translate russian sasha_concert_naked_295f9151:
    "Ведь помимо согласия или отказа есть ещё шанс, что она разозлится."

# ch/harems_full/band/events.rpy:3214
translate russian sasha_concert_naked_12fff500:
    "А значит, нужно быть готовым уносить ноги."

# ch/harems_full/band/events.rpy:3215
translate russian sasha_concert_naked_9ed03a2a:
    "И следить за признаками того, что дело идёт именно к этому."

# ch/harems_full/band/events.rpy:3217
translate russian sasha_concert_naked_d28f27f3:
    mike.say "Саша..."

# ch/harems_full/band/events.rpy:3218
translate russian sasha_concert_naked_94a9f242:
    mike.say "Тут никак не приукрасишь."

# ch/harems_full/band/events.rpy:3219
translate russian sasha_concert_naked_395a4abb:
    mike.say "Поэтому я просто скажу как есть, ладно?"

# ch/harems_full/band/events.rpy:3221
translate russian sasha_concert_naked_39db8bb6:
    "Пока я говорю, Саша поворачивается ко мне."

# ch/harems_full/band/events.rpy:3222
translate russian sasha_concert_naked_db386ab9:
    "И я вижу, что она ещё и приподняла брови."

# ch/harems_full/band/events.rpy:3224
translate russian sasha_concert_naked_601ee3c6:
    sasha.say "О..."

# ch/harems_full/band/events.rpy:3225
translate russian sasha_concert_naked_ff188b8a:
    sasha.say "Вот как?"

# ch/harems_full/band/events.rpy:3228
translate russian sasha_concert_naked_8eecbff6:
    mike.say "Да, именно."

# ch/harems_full/band/events.rpy:3229
translate russian sasha_concert_naked_4040acb2:
    mike.say "Только выслушай меня, прежде чем судить..."

# ch/harems_full/band/events.rpy:3231
translate russian sasha_concert_naked_a2f0691d:
    "Теперь Саша заинтригована ещё сильнее."

# ch/harems_full/band/events.rpy:3232
translate russian sasha_concert_naked_5ed88194:
    "Я чувствую напряжение под её пристальным взглядом."

# ch/harems_full/band/events.rpy:3234
translate russian sasha_concert_naked_2b3367c1:
    mike.say "Я тут подумал..."

# ch/harems_full/band/events.rpy:3235
translate russian sasha_concert_naked_114b607b:
    "Саша кивает."

# ch/harems_full/band/events.rpy:3237
translate russian sasha_concert_naked_3b9aad76:
    sasha.say "Я подозревала, что с тобой иногда такое случается."

# ch/harems_full/band/events.rpy:3238
translate russian sasha_concert_naked_1c370746:
    mike.say "Ха-ха..."

# ch/harems_full/band/events.rpy:3239
translate russian sasha_concert_naked_0389827d:
    mike.say "В общем..."

# ch/harems_full/band/events.rpy:3241
translate russian sasha_concert_naked_16d4b972:
    mike.say "Я думал о группе."

# ch/harems_full/band/events.rpy:3242
translate russian sasha_concert_naked_e9746800:
    mike.say "Точнее, о том, как привлечь к нам больше внимания."

# ch/harems_full/band/events.rpy:3244
translate russian sasha_concert_naked_8ab8941b:
    "При упоминании группы выражение лица Саши меняется."

# ch/harems_full/band/events.rpy:3245
translate russian sasha_concert_naked_3686cca5:
    "Словно она впервые услышала что-то, к чему относится серьёзно."

# ch/harems_full/band/events.rpy:3247
translate russian sasha_concert_naked_30ef279c:
    sasha.say "Правда?"

# ch/harems_full/band/events.rpy:3248
translate russian sasha_concert_naked_cda3880f:
    sasha.say "Здорово, [lssb_common.hero_name()]!"

# ch/harems_full/band/events.rpy:3249
translate russian sasha_concert_naked_0376ade2:
    sasha.say "И что ты придумал?"

# ch/harems_full/band/events.rpy:3250
translate russian sasha_concert_naked_54784dfc:
    sasha.say "Я постоянно придумываю что-нибудь сама..."

# ch/harems_full/band/events.rpy:3251
translate russian sasha_concert_naked_abf56875:
    sasha.say "Но хочу услышать любую твою идею!"

# ch/harems_full/band/events.rpy:3253
translate russian sasha_concert_naked_713555f3:
    "Я глубоко вдыхаю, готовясь сделать решительный шаг."

# ch/harems_full/band/events.rpy:3254
translate russian sasha_concert_naked_168c740d:
    "Потому что это будет своего рода ставка."

# ch/harems_full/band/events.rpy:3255
translate russian sasha_concert_naked_1050c9bf:
    mike.say "Ладно, Саша..."

# ch/harems_full/band/events.rpy:3256
translate russian sasha_concert_naked_4965f68a:
    mike.say "Попробуй на минуту выйти за привычные рамки..."

# ch/harems_full/band/events.rpy:3257
translate russian sasha_concert_naked_e7f9998e:
    mike.say "И представь, какое впечатление мы произведём, выступая голыми!"

# ch/harems_full/band/events.rpy:3259
translate russian sasha_concert_naked_646fc910:
    "Саша несколько мгновений смотрит на меня без выражения."

# ch/harems_full/band/events.rpy:3260
translate russian sasha_concert_naked_e91ed89a:
    "Потом моргает и качает головой."

# ch/harems_full/band/events.rpy:3261
translate russian sasha_concert_naked_3346b4ef:
    "Словно не уверена, что правильно расслышала."

# ch/harems_full/band/events.rpy:3263
translate russian sasha_concert_naked_ab3fc45d:
    sasha.say "Прости..."

# ch/harems_full/band/events.rpy:3264
translate russian sasha_concert_naked_eed53f90:
    sasha.say "Ты сейчас сказал «голыми»?"

# ch/harems_full/band/events.rpy:3265
translate russian sasha_concert_naked_8c8fd10e:
    sasha.say "В смысле, нагишом?"

# ch/harems_full/band/events.rpy:3267
translate russian sasha_concert_naked_6ddc325e:
    "Я киваю, всё ещё стараясь выглядеть серьёзно."

# ch/harems_full/band/events.rpy:3268
translate russian sasha_concert_naked_5b71b7a5:
    "По-моему, иначе её не убедить."

# ch/harems_full/band/events.rpy:3269
translate russian sasha_concert_naked_210264d7:
    mike.say "Именно это я и сказал, Саша."

# ch/harems_full/band/events.rpy:3270
translate russian sasha_concert_naked_6dd106fc:
    mike.say "Я предлагаю Deathless Harpies выступать голыми."

# ch/harems_full/band/events.rpy:3271
translate russian sasha_concert_naked_307799f7:
    mike.say "Думаю, это выделит нас среди других и сделает уникальными."

# ch/harems_full/band/events.rpy:3273
translate russian sasha_concert_naked_a04aa045:
    "Я ожидаю, что Саша назовёт меня сумасшедшим."

# ch/harems_full/band/events.rpy:3274
translate russian sasha_concert_naked_7cfc22c2:
    "Поэтому у меня уже приготовлены ещё пара доводов."

# ch/harems_full/band/events.rpy:3276
translate russian sasha_concert_naked_91a80d3c:
    "Но, к моему огромному удивлению, она кивает!"

# ch/harems_full/band/events.rpy:3278
translate russian sasha_concert_naked_614c5c5b:
