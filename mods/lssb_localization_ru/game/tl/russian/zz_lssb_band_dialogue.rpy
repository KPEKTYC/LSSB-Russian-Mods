# ch/harems_full/band/events.rpy:3574
translate russian naked_gig_21062ef2:
    mike.say "Я кое-чем хочу заняться..."

# ch/harems_full/band/events.rpy:3575
translate russian naked_gig_4bb80318:
    mike.say "Но это будет не соло."

# ch/harems_full/band/events.rpy:3576
translate russian naked_gig_2ff5e24f:
    "Анна, кажется, слишком растеряна, чтобы сопротивляться, когда я поднимаю её на ноги."

# ch/harems_full/band/events.rpy:3577
translate russian naked_gig_21f9e60e:
