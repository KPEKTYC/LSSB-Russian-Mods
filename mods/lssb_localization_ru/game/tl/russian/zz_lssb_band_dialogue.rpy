# ch/harems_full/band/events.rpy:3410
translate russian naked_gig_30c21635:
    amy.say "Некогда, народ..."

# ch/harems_full/band/events.rpy:3412
translate russian naked_gig_5d4efa9e:
    amy.say "Нам выходить!"

# ch/harems_full/band/events.rpy:3415
translate russian naked_gig_0b63076a:
