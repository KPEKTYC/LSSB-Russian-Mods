# ch/harems_full/band/events.rpy:3470
translate russian naked_gig_3ab553a1:
    "И... ну... положить на другой мой инструмент!"

# ch/harems_full/band/events.rpy:3471
translate russian naked_gig_2997340a:
    "Я успеваю увернуться, и ей удаётся лишь ущипнуть меня за ягодицу."

# ch/harems_full/band/events.rpy:3475
translate russian naked_gig_5ecae210:
    "Но, оказавшись вне досягаемости, я внимательно оглядываю девушек."

# ch/harems_full/band/events.rpy:3476
translate russian naked_gig_403d65fc:
    "И с изумлением замечаю явные признаки того, что все они примерно в таком же состоянии, как я."

# ch/harems_full/band/events.rpy:3477
translate russian naked_gig_8b14532e:
    "Каким-то образом выступление голышом возбуждает и их!"

# ch/harems_full/band/events.rpy:3478
translate russian naked_gig_513be3cc:
    "Но это ещё не всё. Начинается кое-что ещё."

# ch/harems_full/band/events.rpy:3479
translate russian naked_gig_2a5adac5:
    "Из-за нашего состояния мы начинаем ошибаться и в музыке."

# ch/harems_full/band/events.rpy:3480
translate russian naked_gig_cfb0a9ff:
    "Пока мелочи — к счастью, слишком незаметные для публики."

# ch/harems_full/band/events.rpy:3481
translate russian naked_gig_cf029428:
    "Но если я скоро ничего не предприму, у нас будут серьёзные неприятности."

# ch/harems_full/band/events.rpy:3482
translate russian naked_gig_6f0163d9:
    "Вот только что именно мне делать?"

# ch/harems_full/band/events.rpy:3483
translate russian naked_gig_635dd9d2:
    "Какой спонтанный поступок мог бы снять всё это сексуальное напряжение?"

# ch/harems_full/band/events.rpy:3484
translate russian naked_gig_2b375fe9:
    "Вдруг меня осеняет, и я украдкой смотрю вниз на свой всё ещё болезненно твёрдый член."

# ch/harems_full/band/events.rpy:3485
translate russian naked_gig_91ad614c:
    "Придётся пустить его в дело — трахнуть одну из девушек прямо здесь и сейчас!"

# ch/harems_full/band/events.rpy:3486
translate russian naked_gig_61a09765:
    "Но кого именно?"

# ch/harems_full/band/events.rpy:3489
translate russian naked_gig_1c61e614:
    "Я смотрю налево и вижу Эми: она играет как одержимая."

# ch/harems_full/band/events.rpy:3492
translate russian naked_gig_5265911c:
    "И прежде чем успеваю осознать, уже иду прямо к ней."

# ch/harems_full/band/events.rpy:3493
translate russian naked_gig_1b2626cb:
    "Когда я подхожу, она поворачивается и замечает меня."

# ch/harems_full/band/events.rpy:3494
translate russian naked_gig_0e23af76:
    amy.say "[lssb_common.hero_name()]..."

# ch/harems_full/band/events.rpy:3495
translate russian naked_gig_edd9ac41:
    amy.say "Мне кажется..."

# ch/harems_full/band/events.rpy:3496
translate russian naked_gig_d874b805:
    amy.say "Или тут стало ОЧЕНЬ жарко?"

# ch/harems_full/band/events.rpy:3497
translate russian naked_gig_0ccc0b61:
    "Я киваю и изо всех сил стараюсь смотреть Эми в глаза."

# ch/harems_full/band/events.rpy:3498
translate russian naked_gig_e50b583f:
    "Но взгляд всё время отвлекается на её великолепную грудь."

# ch/harems_full/band/events.rpy:3499
translate russian naked_gig_0c586ab9:
    "И то, что я на неё пялюсь, явно не ускользает от Эми."

# ch/harems_full/band/events.rpy:3500
translate russian naked_gig_8a76094b:
    mike.say "Да, Эми..."

# ch/harems_full/band/events.rpy:3501
translate russian naked_gig_9f6cc6ab:
    mike.say "Так горячо..."

# ch/harems_full/band/events.rpy:3502
translate russian naked_gig_f6f707de:
    mike.say "Просто невероятно горячо!"

# ch/harems_full/band/events.rpy:3503
translate russian naked_gig_847431df:
    amy.say "Считаешь, это горячо?"

# ch/harems_full/band/events.rpy:3504
translate russian naked_gig_76ae3a49:
    amy.say "Тогда погоди, сейчас увидишь!"

# ch/harems_full/band/events.rpy:3505
translate russian naked_gig_11396760:
    "Прежде чем я понимаю, что происходит, Эми поворачивается ко мне спиной."

# ch/harems_full/band/events.rpy:3509
translate russian naked_gig_64801920:
    "А затем буквально вжимается задницей в мой пах!"

# ch/harems_full/band/events.rpy:3510
translate russian naked_gig_8979a696:
    "Её попка отодвигает гитару, обнажая мой болезненно твёрдый член."

# ch/harems_full/band/events.rpy:3511
translate russian naked_gig_8c07da4a:
    "И он, конечно же, тут же оказывается между бёдрами Эми."

# ch/harems_full/band/events.rpy:3512
translate russian naked_gig_9bc4c3bb:
