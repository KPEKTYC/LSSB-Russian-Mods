# ch/harems/home/events/home_harem_beach_date.rpy:1990
translate russian home_harem_lexi_minami_samantha_beach_date_dabafb44:
    lexi.say "ЧТО?!"

# ch/harems/home/events/home_harem_beach_date.rpy:1992
translate russian home_harem_lexi_minami_samantha_beach_date_09a453c7:
    lexi.say "Ты с ума сошёл?"

# ch/harems/home/events/home_harem_beach_date.rpy:1993
translate russian home_harem_lexi_minami_samantha_beach_date_a46511c4:
    minami.say "Наверняка!"

# ch/harems/home/events/home_harem_beach_date.rpy:1995
translate russian home_harem_lexi_minami_samantha_beach_date_0cd0d84a:
    minami.say "Мы тебя обыграем, братишка!"

# ch/harems/home/events/home_harem_beach_date.rpy:1996
translate russian home_harem_lexi_minami_samantha_beach_date_92f00ad2:
    samantha.say "Трое против одного?"

# ch/harems/home/events/home_harem_beach_date.rpy:1998
translate russian home_harem_lexi_minami_samantha_beach_date_825fede3:
    samantha.say "У тебя нет шансов!"

# ch/harems/home/events/home_harem_beach_date.rpy:2003
translate russian home_harem_lexi_minami_samantha_beach_date_db67a848:
    "Когда этот обмен подколками заканчивается, мы начинаем играть всерьёз."

# ch/harems/home/events/home_harem_beach_date.rpy:2009
translate russian home_harem_lexi_minami_samantha_beach_date_dc05eb4f:
    "И вскоре я понимаю: девушки играют гораздо лучше меня!"

# ch/harems/home/events/home_harem_beach_date.rpy:2015
translate russian home_harem_lexi_minami_samantha_beach_date_e3ced265:
    "Не знаю, то ли я ещё не отошёл от недавней дремоты."

# ch/harems/home/events/home_harem_beach_date.rpy:2021
translate russian home_harem_lexi_minami_samantha_beach_date_28fd4657:
    "То ли они просто лучше играют в волейбол."

# ch/harems/home/events/home_harem_beach_date.rpy:2022
translate russian home_harem_lexi_minami_samantha_beach_date_1b3bdc28:
    "Но так или иначе большую часть времени я оказываюсь лицом в песке."

# ch/harems/home/events/home_harem_beach_date.rpy:2023
translate russian home_harem_lexi_minami_samantha_beach_date_b039f68e:
    "Подняв голову и сплюнув песок, я молю о пощаде."

# ch/harems/home/events/home_harem_beach_date.rpy:2025
translate russian home_harem_lexi_minami_samantha_beach_date_447fd1e9:
    mike.say "Хватит, сдаюсь!"

# ch/harems/home/events/home_harem_beach_date.rpy:2026
translate russian home_harem_lexi_minami_samantha_beach_date_2ad5c1fb:
    "Понятия не имею, какой был счёт и кто выиграл."

# ch/harems/home/events/home_harem_beach_date.rpy:2027
translate russian home_harem_lexi_minami_samantha_beach_date_1e010a5f:
    "Я просто счастлив, что мои мучения закончились."

# ch/harems/home/events/home_harem_beach_date.rpy:2029
translate russian home_harem_lexi_minami_samantha_beach_date_fe58f2ea:
    mike.say "Господи..."

# ch/harems/home/events/home_harem_beach_date.rpy:2030
translate russian home_harem_lexi_minami_samantha_beach_date_5ccb7c79:
    mike.say "Я и не заметил, как жарко!"

# ch/harems/home/events/home_harem_beach_date.rpy:2032
translate russian home_harem_lexi_minami_samantha_beach_date_889276cb:
    mike.say "Кексик права — надо охладиться в море."

# ch/harems/home/events/home_harem_beach_date.rpy:2034
translate russian home_harem_lexi_minami_samantha_beach_date_48136139:
    mike.say "Сэм права — надо охладиться в море."

# ch/harems/home/events/home_harem_beach_date.rpy:2035
translate russian home_harem_lexi_minami_samantha_beach_date_43c8c38c:
    "Сэм тут же встаёт и хватает меня за руку."

# ch/harems/home/events/home_harem_beach_date.rpy:2037
translate russian home_harem_lexi_minami_samantha_beach_date_89648532:
    "Она успевает поднять меня раньше, чем Лекси и Минами начинают возражать."

# ch/harems/home/events/home_harem_beach_date.rpy:2038
translate russian home_harem_lexi_minami_samantha_beach_date_57859102:
    "И тащит по песку к воде."

# ch/harems/home/events/home_harem_beach_date.rpy:2041
translate russian home_harem_lexi_minami_samantha_beach_date_832b21e2:
    "Я слышу, как остальные ворчат, идя следом."

# ch/harems/home/events/home_harem_beach_date.rpy:2042
translate russian home_harem_lexi_minami_samantha_beach_date_aa480b86:
    "Но Сэм просто не обращает внимания, да и я ни слова не разбираю."

# ch/harems/home/events/home_harem_beach_date.rpy:2043
translate russian home_harem_lexi_minami_samantha_beach_date_870ac94b_1:
    samantha.say "Пойдём, [lssb_common.hero_name()]."

# ch/harems/home/events/home_harem_beach_date.rpy:2044
translate russian home_harem_lexi_minami_samantha_beach_date_cc3078b0:
    samantha.say "Кто последний в воду — тот неудачник!"

# ch/harems/home/events/home_harem_beach_date.rpy:2046
translate russian home_harem_lexi_minami_samantha_beach_date_67c80c59:
    mike.say "Подожди-ка..."

# ch/harems/home/events/home_harem_beach_date.rpy:2047
translate russian home_harem_lexi_minami_samantha_beach_date_2c5de549:
    "Сэм даже не думает меня слушать."

# ch/harems/home/events/home_harem_beach_date.rpy:2048
translate russian home_harem_lexi_minami_samantha_beach_date_bc05a354:
    "Вместо этого тянет прямо в воду."

# ch/harems/home/events/home_harem_beach_date.rpy:2049
translate russian home_harem_lexi_minami_samantha_beach_date_47d650c8:
    "Я подпрыгиваю и ругаюсь."

# ch/harems/home/events/home_harem_beach_date.rpy:2050
translate russian home_harem_lexi_minami_samantha_beach_date_9639d6d0:
    "Потому что вода ледяная!"

# ch/harems/home/events/home_harem_beach_date.rpy:2051
translate russian home_harem_lexi_minami_samantha_beach_date_149c35dc:
    "Не думая о последствиях, я опускаю руки в волны."

# ch/harems/home/events/home_harem_beach_date.rpy:2056
translate russian home_harem_lexi_minami_samantha_beach_date_54a62e59:
    "А затем окатываю Сэм таким количеством воды, какое только могу зачерпнуть."

# ch/harems/home/events/home_harem_beach_date.rpy:2057
translate russian home_harem_lexi_minami_samantha_beach_date_6c6e8854:
    samantha.say "А-а..."

# ch/harems/home/events/home_harem_beach_date.rpy:2058
translate russian home_harem_lexi_minami_samantha_beach_date_7537b8de:
    samantha.say "О боже!"

# ch/harems/home/events/home_harem_beach_date.rpy:2059
translate russian home_harem_lexi_minami_samantha_beach_date_50187e01:
    samantha.say "Как холодно!"

# ch/harems/home/events/home_harem_beach_date.rpy:2060
translate russian home_harem_lexi_minami_samantha_beach_date_b50ce667:
    "Прежде чем я успеваю сказать хоть слово, Сэм слышит позади смех."

# ch/harems/home/events/home_harem_beach_date.rpy:2065
translate russian home_harem_lexi_minami_samantha_beach_date_d3d6477d:
    "Она оборачивается: в паре шагов стоят в воде Лекси и Минами."

# ch/harems/home/events/home_harem_beach_date.rpy:2070
translate russian home_harem_lexi_minami_samantha_beach_date_0b3b576e:
    "Обе показывают на неё пальцем и хихикают."

# ch/harems/home/events/home_harem_beach_date.rpy:2071
translate russian home_harem_lexi_minami_samantha_beach_date_8ab90710:
    "Но ни одна не успевает уклониться от мести Сэм."

# ch/harems/home/events/home_harem_beach_date.rpy:2072
translate russian home_harem_lexi_minami_samantha_beach_date_8f049c7a:
    "Она, как и я, зачерпывает воду и обрызгивает их."

# ch/harems/home/events/home_harem_beach_date.rpy:2073
translate russian home_harem_lexi_minami_samantha_beach_date_05bb986c:
    lexi.say "Чт..."

# ch/harems/home/events/home_harem_beach_date.rpy:2074
translate russian home_harem_lexi_minami_samantha_beach_date_533aff89:
    lexi.say "Господи, блядь!"

# ch/harems/home/events/home_harem_beach_date.rpy:2079
translate russian home_harem_lexi_minami_samantha_beach_date_0cfbdcf7:
    minami.say "О-о... о нет..."

# ch/harems/home/events/home_harem_beach_date.rpy:2080
translate russian home_harem_lexi_minami_samantha_beach_date_a47c63cf:
    minami.say "Помоги мне, братишка!"

# ch/harems/home/events/home_harem_beach_date.rpy:2081
translate russian home_harem_lexi_minami_samantha_beach_date_5b7da6bb:
    "Я коварно улыбаюсь и делаю ровно наоборот."

# ch/harems/home/events/home_harem_beach_date.rpy:2086
translate russian home_harem_lexi_minami_samantha_beach_date_c3081da3:
    "Присоединяюсь к Сэм, помогая ей окатить Лекси и Минами."

# ch/harems/home/events/home_harem_beach_date.rpy:2087
translate russian home_harem_lexi_minami_samantha_beach_date_fd041e08:
    "Они быстро начинают отвечать."

# ch/harems/home/events/home_harem_beach_date.rpy:2092
translate russian home_harem_lexi_minami_samantha_beach_date_a4f0f28b:
    "И вскоре все четверо уже участвуют в водяной битве."

# ch/harems/home/events/home_harem_beach_date.rpy:2093
translate russian home_harem_lexi_minami_samantha_beach_date_fe992448:
    "Боевые действия заканчиваются, только когда мы совершенно выдыхаемся."

# ch/harems/home/events/home_harem_beach_date.rpy:2094
translate russian home_harem_lexi_minami_samantha_beach_date_dfba838f:
    "И хотя нам удалось охладиться, устали мы ещё сильнее."

# ch/harems/home/events/home_harem_beach_date.rpy:2100
translate russian home_harem_lexi_minami_samantha_beach_date_0d8203da:
    mike.say "Всё это отличные идеи."

# ch/harems/home/events/home_harem_beach_date.rpy:2101
translate russian home_harem_lexi_minami_samantha_beach_date_66a67532:
    mike.say "Но мне нужно как следует проснуться."

# ch/harems/home/events/home_harem_beach_date.rpy:2102
translate russian home_harem_lexi_minami_samantha_beach_date_312e7a11:
    mike.say "Пойду прогуляюсь по пляжу."

# ch/harems/home/events/home_harem_beach_date.rpy:2103
translate russian home_harem_lexi_minami_samantha_beach_date_113591f1:
    mike.say "Вы все тоже можете присоединиться."

# ch/harems/home/events/home_harem_beach_date.rpy:2104
translate russian home_harem_lexi_minami_samantha_beach_date_6f3e5e17:
    "Девушки обмениваются недовольными взглядами."

# ch/harems/home/events/home_harem_beach_date.rpy:2108
translate russian home_harem_lexi_minami_samantha_beach_date_6f937e84:
    "Но я уже всё решил и просто поднимаюсь на ноги."

# ch/harems/home/events/home_harem_beach_date.rpy:2109
translate russian home_harem_lexi_minami_samantha_beach_date_8e451848:
    "И к тому времени, когда я готов идти, они меняют тон."

# ch/harems/home/events/home_harem_beach_date.rpy:2110
translate russian home_harem_lexi_minami_samantha_beach_date_c632c70a:
    lexi.say "Ты тайком уходишь куда-то развлекаться?"

# ch/harems/home/events/home_harem_beach_date.rpy:2112
translate russian home_harem_lexi_minami_samantha_beach_date_68eb6d09:
    lexi.say "Если да, то я тоже хочу!"

# ch/harems/home/events/home_harem_beach_date.rpy:2113
translate russian home_harem_lexi_minami_samantha_beach_date_b083cbc2:
    minami.say "Не оставляй меня, братишка!"

# ch/harems/home/events/home_harem_beach_date.rpy:2115
translate russian home_harem_lexi_minami_samantha_beach_date_e496fee5:
    minami.say "Я тоже хочу с тобой."

# ch/harems/home/events/home_harem_beach_date.rpy:2116
translate russian home_harem_lexi_minami_samantha_beach_date_b6b47426:
    samantha.say "Ну, пожалуй, мне не помешает размять ноги."

# ch/harems/home/events/home_harem_beach_date.rpy:2118
translate russian home_harem_lexi_minami_samantha_beach_date_46082e8f:
    samantha.say "Я тоже иду!"

# ch/harems/home/events/home_harem_beach_date.rpy:2119
translate russian home_harem_lexi_minami_samantha_beach_date_bc5d2923:
    "Не могу удержаться от хитрой улыбки, пока они торопятся следом."

# ch/harems/home/events/home_harem_beach_date.rpy:2120
translate russian home_harem_lexi_minami_samantha_beach_date_e2fd9fc9:
    "Но успеваю спрятать её прежде, чем кто-нибудь заметит."

# ch/harems/home/events/home_harem_beach_date.rpy:2121
translate russian home_harem_lexi_minami_samantha_beach_date_ee2f703e:
    "Я и не собирался устраивать какой-то безумный поход на выносливость."

# ch/harems/home/events/home_harem_beach_date.rpy:2122
translate russian home_harem_lexi_minami_samantha_beach_date_f1af08f5:
    "Просто пройтись вдоль пляжа и насладиться атмосферой."

# ch/harems/home/events/home_harem_beach_date.rpy:2123
translate russian home_harem_lexi_minami_samantha_beach_date_de72cbf8:
    "И вскоре остальные, похоже, тоже понимают, что в этом хорошего."

# ch/harems/home/events/home_harem_beach_date.rpy:2124
translate russian home_harem_lexi_minami_samantha_beach_date_5214567c:
    "Мы не спеша проходим пляж из конца в конец и возвращаемся обратно."

# ch/harems/home/events/home_harem_beach_date.rpy:2125
translate russian home_harem_lexi_minami_samantha_beach_date_bb267f15:
    "К тому времени, как добираемся до своих вещей, все уже вполне расслабились."

# ch/harems/home/events/home_harem_beach_date.rpy:2131
translate russian home_harem_lexi_minami_samantha_beach_date_b5b5ea62:
    mike.say "Делайте что хотите."

# ch/harems/home/events/home_harem_beach_date.rpy:2132
translate russian home_harem_lexi_minami_samantha_beach_date_cdb3e3d7:
    mike.say "А я снова посплю!"

# ch/harems/home/events/home_harem_beach_date.rpy:2133
translate russian home_harem_lexi_minami_samantha_beach_date_a2a1454f:
    "С этими словами я ложусь и закрываю глаза."

# ch/harems/home/events/home_harem_beach_date.rpy:2134
translate russian home_harem_lexi_minami_samantha_beach_date_32ea31c5:
    "И ответная реакция не заставляет себя ждать."

# ch/harems/home/events/home_harem_beach_date.rpy:2135
translate russian home_harem_lexi_minami_samantha_beach_date_0e3031cd:
    lexi.say "Уф..."

# ch/harems/home/events/home_harem_beach_date.rpy:2137
translate russian home_harem_lexi_minami_samantha_beach_date_4575a3b6:
    lexi.say "Какой ленивый засранец!"

# ch/harems/home/events/home_harem_beach_date.rpy:2139
translate russian home_harem_lexi_minami_samantha_beach_date_634e1605:
    minami.say "Ага, братишка порой та ещё заноза!"

# ch/harems/home/events/home_harem_beach_date.rpy:2140
translate russian home_harem_lexi_minami_samantha_beach_date_f62f7c0f:
    samantha.say "Кажется, на этот раз он не шутит."

# ch/harems/home/events/home_harem_beach_date.rpy:2142
translate russian home_harem_lexi_minami_samantha_beach_date_9bd8bf55:
    samantha.say "Лучше оставим его в покое..."

# ch/harems/home/events/home_harem_beach_date.rpy:2143
translate russian home_harem_lexi_minami_samantha_beach_date_431a8053:
    "Постепенно их голоса начинают стихать."

# ch/harems/home/events/home_harem_beach_date.rpy:2144
translate russian home_harem_lexi_minami_samantha_beach_date_ff3d7a38:
    "Не знаю, то ли девушки отходят от меня."

# ch/harems/home/events/home_harem_beach_date.rpy:2145
translate russian home_harem_lexi_minami_samantha_beach_date_54adbc58:
    "То ли я уже погружаюсь в сон."

# ch/harems/home/events/home_harem_beach_date.rpy:2146
translate russian home_harem_lexi_minami_samantha_beach_date_da074e84:
    "В любом случае у меня хорошие шансы отдохнуть."

# ch/harems/home/events/home_harem_beach_date.rpy:2171
translate russian home_harem_lexi_minami_samantha_beach_date_d221afee:
    "День идёт, и солнце поднимается всё выше."

# ch/harems/home/events/home_harem_beach_date.rpy:2172
translate russian home_harem_lexi_minami_samantha_beach_date_dfc70812:
    "Вскоре мне кажется, что я лежу на гриле и меня жарят заживо!"

# ch/harems/home/events/home_harem_beach_date.rpy:2173
translate russian home_harem_lexi_minami_samantha_beach_date_78883b5c:
    "Когда мы приехали, все намазались солнцезащитным кремом."

# ch/harems/home/events/home_harem_beach_date.rpy:2174
translate russian home_harem_lexi_minami_samantha_beach_date_f1f2ef1f:
    "Но почти одновременно понимаем, что пора нанести ещё один слой."

# ch/harems/home/events/home_harem_beach_date.rpy:2175
translate russian home_harem_lexi_minami_samantha_beach_date_690fdb98:
    "Я уже собираюсь добавить крема, когда слышу голос сбоку."

# ch/harems/home/events/home_harem_beach_date.rpy:2176
translate russian home_harem_lexi_minami_samantha_beach_date_e7b69d66:
    lexi.say "О, [lssb_common.hero_name()]..."

# ch/harems/home/events/home_harem_beach_date.rpy:2178
translate russian home_harem_lexi_minami_samantha_beach_date_49b255fe:
    lexi.say "Не побудешь героем и не намажешь меня?"

# ch/harems/home/events/home_harem_beach_date.rpy:2179
translate russian home_harem_lexi_minami_samantha_beach_date_bbc61d0c:
    "Оборачиваюсь и вижу, что Лекси протягивает мне крем от солнца."

