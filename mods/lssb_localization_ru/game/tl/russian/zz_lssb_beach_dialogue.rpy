# Native Beach identifiers, current source catalog. Translation only.

# ch/harems/home/events/home_harem_beach_date.rpy:43
translate russian home_harem_beach_date_set_up_ffbc3518:
    "Может, позже."

# ch/harems/home/events/home_harem_beach_date.rpy:69
translate russian home_harem_beach_date_set_up_de134bc7:
    sasha.say "Ты везёшь нас на пляж."

# ch/harems/home/events/home_harem_beach_date.rpy:74
translate russian home_harem_beach_date_set_up_1eb0943a:
    mike.say "Ого... ладно!"

# ch/harems/home/events/home_harem_beach_date.rpy:81
translate russian home_harem_beach_date_set_up_1977bf3b:
    bree.say "Будет так здорово!"

# ch/harems/home/events/home_harem_beach_date.rpy:98
translate russian home_harem_bree_sasha_beach_date_2df28f9e:
    mike.say "Простите, девчонки, моя машина в ремонте."

# ch/harems/home/events/home_harem_beach_date.rpy:99
translate russian home_harem_bree_sasha_beach_date_425fed07:
    mike.say "Придётся отложить нашу поездку на пляж."

# ch/harems/home/events/home_harem_beach_date.rpy:103
translate russian home_harem_bree_sasha_beach_date_6aeef5d5:
    "Впервые за, кажется, несколько недель стоит такая хорошая погода: солнце сияет в чистом голубом небе."

# ch/harems/home/events/home_harem_beach_date.rpy:104
translate russian home_harem_bree_sasha_beach_date_b03fa9d5:
    "Мы все — [lssb_beach.bree_name()], Саша и я — думаем только об одном: НАДО ехать на пляж и ловить момент!"

# ch/harems/home/events/home_harem_beach_date.rpy:105
translate russian home_harem_bree_sasha_beach_date_07bf3651:
    "Поэтому собираем всё необходимое и забираемся в мою машину, как только все трое готовы."

# ch/harems/home/events/home_harem_beach_date.rpy:107
translate russian home_harem_bree_sasha_beach_date_c42b4752:
    "Мы добираемся до пляжа вовремя, раньше первого наплыва отдыхающих, так что можем выбрать хорошее место."

# ch/harems/home/events/home_harem_beach_date.rpy:108
translate russian home_harem_bree_sasha_beach_date_4c695c62:
    "Но сначала нужно припарковаться и выгрузить все вещи."

# ch/harems/home/events/home_harem_beach_date.rpy:110
translate russian home_harem_bree_sasha_beach_date_5972f9f6:
    bree.say "Я возьму холодильник!"

# ch/harems/home/events/home_harem_beach_date.rpy:112
translate russian home_harem_bree_sasha_beach_date_d1114a9d:
    sasha.say "Хорошо, а я — зонтик и полотенца."

# ch/harems/home/events/home_harem_beach_date.rpy:113
translate russian home_harem_bree_sasha_beach_date_e9baf468:
    "Я смотрю, как [lssb_beach.bree_name()] возится с переносным холодильником, набитым напитками и закусками."

# ch/harems/home/events/home_harem_beach_date.rpy:115
translate russian home_harem_bree_sasha_beach_date_f68c0a65:
    "Она с трудом вытаскивает его из багажника и чуть не роняет на землю."

# ch/harems/home/events/home_harem_beach_date.rpy:116
translate russian home_harem_bree_sasha_beach_date_98b7a3d9:
    "Первый порыв — броситься на помощь и забрать ношу, явно слишком тяжёлую для неё."

# ch/harems/home/events/home_harem_beach_date.rpy:118
translate russian home_harem_bree_sasha_beach_date_9cb42007:
    "Но тут я замечаю Сашу, которой тоже непросто совладать со всеми полотенцами и зонтиком."

# ch/harems/home/events/home_harem_beach_date.rpy:119
translate russian home_harem_bree_sasha_beach_date_37019520:
    "Они легче холодильника, но ей явно не помешала бы ещё одна пара рук."

# ch/harems/home/events/home_harem_beach_date.rpy:120
translate russian home_harem_bree_sasha_beach_date_9be58000:
    "Кроме вещей, с которыми мучаются девушки, нести мне, по сути, нечего."

# ch/harems/home/events/home_harem_beach_date.rpy:121
translate russian home_harem_bree_sasha_beach_date_dae3a24c:
    "Поэтому логично было бы подойти и забрать у кого-нибудь часть груза."

# ch/harems/home/events/home_harem_beach_date.rpy:122
translate russian home_harem_bree_sasha_beach_date_8aab1686:
    "Проблема лишь в том, что помочь обеим я не могу — придётся выбирать!"

# ch/harems/home/events/home_harem_beach_date.rpy:128
translate russian home_harem_bree_sasha_beach_date_2fe7af57:
    "Решаю, что лучше всего взять холодильник."

# ch/harems/home/events/home_harem_beach_date.rpy:129
translate russian home_harem_bree_sasha_beach_date_a41b3b9e:
    "Тогда [lssb_beach.bree_name()] и Саша смогут поделить между собой полотенца и зонтик."

# ch/harems/home/events/home_harem_beach_date.rpy:130
translate russian home_harem_bree_sasha_beach_date_2d967f96:
    mike.say "Эй, [lssb_beach.bree_name()]."

# ch/harems/home/events/home_harem_beach_date.rpy:131
translate russian home_harem_bree_sasha_beach_date_c4340890:
    mike.say "Это для тебя слишком тяжело."

# ch/harems/home/events/home_harem_beach_date.rpy:132
translate russian home_harem_bree_sasha_beach_date_06165867:
    mike.say "Давай лучше я понесу."

# ch/harems/home/events/home_harem_beach_date.rpy:134
translate russian home_harem_bree_sasha_beach_date_f8b90c96:
    bree.say "Ой, ты уверен, [lssb_common.hero_name()]?"

# ch/harems/home/events/home_harem_beach_date.rpy:136
translate russian home_harem_bree_sasha_beach_date_fd2a8d20:
    "По выражению лица видно, что [lssb_beach.bree_name()] спрашивает лишь из вежливости."

# ch/harems/home/events/home_harem_beach_date.rpy:137
translate russian home_harem_bree_sasha_beach_date_2b003cb9:
    "И в подтверждение она без дальнейших возражений передаёт мне холодильник."

# ch/harems/home/events/home_harem_beach_date.rpy:138
translate russian home_harem_bree_sasha_beach_date_be9fa5dd:
    "Стоит мне его взять, как я удивляюсь, что она вообще смогла его поднять."

# ch/harems/home/events/home_harem_beach_date.rpy:139
translate russian home_harem_bree_sasha_beach_date_71f1fb0d:
    "Не то чтобы [lssb_beach.bree_name()] была слабачкой, но даже мне приходится туго!"

# ch/harems/home/events/home_harem_beach_date.rpy:140
translate russian home_harem_bree_sasha_beach_date_c0b07a72:
    mike.say "Без... проблем... [lssb_beach.bree_name()]!"

# ch/harems/home/events/home_harem_beach_date.rpy:141
translate russian home_harem_bree_sasha_beach_date_9c2c7ea7:
    "Я начинаю ковылять в сторону пляжа."

# ch/harems/home/events/home_harem_beach_date.rpy:142
translate russian home_harem_bree_sasha_beach_date_d5d48758:
    "С каждым шагом молюсь, чтобы добраться раньше, чем откажут руки."

# ch/harems/home/events/home_harem_beach_date.rpy:147
translate russian home_harem_bree_sasha_beach_date_2caa1eea:
    "Но из-за этого не могу оглянуться и посмотреть, что делают [lssb_beach.bree_name()] и Саша."

# ch/harems/home/events/home_harem_beach_date.rpy:148
translate russian home_harem_bree_sasha_beach_date_33e5ad5e:
    "Наконец добравшись до подходящего места и опустив эту махину, я оборачиваюсь."

# ch/harems/home/events/home_harem_beach_date.rpy:149
translate russian home_harem_bree_sasha_beach_date_29b3129f:
    "И у меня падает сердце: [lssb_beach.bree_name()] идёт следом налегке, с совершенно пустыми руками."

# ch/harems/home/events/home_harem_beach_date.rpy:150
translate russian home_harem_bree_sasha_beach_date_2d242637:
    "Она явно в восторге от моего рыцарского поступка."

# ch/harems/home/events/home_harem_beach_date.rpy:151
translate russian home_harem_bree_sasha_beach_date_7b7575a0:
    "Чего никак не скажешь о Саше."

# ch/harems/home/events/home_harem_beach_date.rpy:153
translate russian home_harem_bree_sasha_beach_date_8594874f:
    "Та медленно появляется в поле зрения, волоча за собой по песку свою поклажу."

# ch/harems/home/events/home_harem_beach_date.rpy:157
translate russian home_harem_bree_sasha_beach_date_a45a5750:
    "Я подумываю забрать холодильник, который несёт [lssb_beach.bree_name()], чтобы ускорить дело."

# ch/harems/home/events/home_harem_beach_date.rpy:158
translate russian home_harem_bree_sasha_beach_date_76b0a95b:
    "Но тут понимаю, что сомневаться в её силах было бы довольно обидно."

# ch/harems/home/events/home_harem_beach_date.rpy:159
translate russian home_harem_bree_sasha_beach_date_9466bf40:
    "А в таких вопросах я очень современный парень, поэтому решаю не вмешиваться."

# ch/harems/home/events/home_harem_beach_date.rpy:160
translate russian home_harem_bree_sasha_beach_date_79b2e40a:
    mike.say "Эй, Саша."

# ch/harems/home/events/home_harem_beach_date.rpy:161
translate russian home_harem_bree_sasha_beach_date_7554ac1a:
    mike.say "Давай я возьму часть вещей."

# ch/harems/home/events/home_harem_beach_date.rpy:163
translate russian home_harem_bree_sasha_beach_date_974ab438:
    sasha.say "Ты уверен, [lssb_common.hero_name()]?"

# ch/harems/home/events/home_harem_beach_date.rpy:164
translate russian home_harem_bree_sasha_beach_date_ad0a5821:
    sasha.say "Этот холодильник выглядит тяжёлым!"

# ch/harems/home/events/home_harem_beach_date.rpy:165
translate russian home_harem_bree_sasha_beach_date_23592220:
    mike.say "[lssb_beach.bree_name()] справится — не зря же она столько тренируется!"

# ch/harems/home/events/home_harem_beach_date.rpy:167
translate russian home_harem_bree_sasha_beach_date_b4f0a00d:
    "Саша пожимает плечами и передаёт мне примерно половину своих вещей."

# ch/harems/home/events/home_harem_beach_date.rpy:168
translate russian home_harem_bree_sasha_beach_date_93d8391b:
    "Теперь ей гораздо удобнее, да и я не перегружен."

# ch/harems/home/events/home_harem_beach_date.rpy:170
translate russian home_harem_bree_sasha_beach_date_fd71917e:
    "Мы вместе выходим на песок, болтая и присматривая хорошее место."

# ch/harems/home/events/home_harem_beach_date.rpy:171
translate russian home_harem_bree_sasha_beach_date_fe3f90c0:
    "Нам настолько приятно, что мы совсем забываем: [lssb_beach.bree_name()] осталась позади."

# ch/harems/home/events/home_harem_beach_date.rpy:172
translate russian home_harem_bree_sasha_beach_date_e36f6406:
    mike.say "Эм, Саша..."

# ch/harems/home/events/home_harem_beach_date.rpy:174
translate russian home_harem_bree_sasha_beach_date_2ce121cc:
    sasha.say "Да, [lssb_common.hero_name()]?"

# ch/harems/home/events/home_harem_beach_date.rpy:175
translate russian home_harem_bree_sasha_beach_date_4b72ed22:
    mike.say "А куда делась [lssb_beach.bree_name()]?"

# ch/harems/home/events/home_harem_beach_date.rpy:176
translate russian home_harem_bree_sasha_beach_date_45c25f45:
    "Мы оба опускаем вещи и начинаем оглядываться."

# ch/harems/home/events/home_harem_beach_date.rpy:178
translate russian home_harem_bree_sasha_beach_date_3a82fa4c:
    "Но долго искать третью участницу нашей компании не приходится."

# ch/harems/home/events/home_harem_beach_date.rpy:180
translate russian home_harem_bree_sasha_beach_date_fb5b4c84:
    "[lssb_beach.bree_name()] медленно появляется из-за дюн позади нас."

# ch/harems/home/events/home_harem_beach_date.rpy:182
translate russian home_harem_bree_sasha_beach_date_3d4df5b9:
    "Она уже выглядит измотанной и окончательно перестала пытаться нести холодильник."

# ch/harems/home/events/home_harem_beach_date.rpy:183
translate russian home_harem_bree_sasha_beach_date_866f34a7:
    "Вместо этого волочит его за собой, оставляя глубокую борозду в песке."

# ch/harems/home/events/home_harem_beach_date.rpy:187
translate russian home_harem_bree_sasha_beach_date_9d48dd6b:
    "Обменявшись достаточным количеством сердитых взглядов и колкостей, мы начинаем обустраивать своё место."

# ch/harems/home/events/home_harem_beach_date.rpy:188
translate russian home_harem_bree_sasha_beach_date_704b42cd:
    "Полотенца разложены на песке, зонтик установлен — остаётся лишь лечь и расслабиться."

# ch/harems/home/events/home_harem_beach_date.rpy:189
translate russian home_harem_bree_sasha_beach_date_d18a4c37:
    "Мы только пришли, и никому пока не хочется бежать куда-то и активно двигаться."

# ch/harems/home/events/home_harem_beach_date.rpy:190
translate russian home_harem_bree_sasha_beach_date_47591f87:
    "А некоторые ещё и устали тащить вещи, так что мы просто откидываемся и ненадолго закрываем глаза."

# ch/harems/home/events/home_harem_beach_date.rpy:194
translate russian home_harem_bree_sasha_beach_date_289a0da4:
    "В какой-то момент я, видимо, заснул: следующее, что я помню, — просыпаюсь от голосов."

# ch/harems/home/events/home_harem_beach_date.rpy:195
translate russian home_harem_bree_sasha_beach_date_b9ae4d9d:
    "Сонно приподнявшись на локте, я вижу, как [lssb_beach.bree_name()] и Саша горячо спорят возле холодильника."

# ch/harems/home/events/home_harem_beach_date.rpy:199
translate russian home_harem_bree_sasha_beach_date_ceec05d5:
    bree.say "Смотри, [lssb_common.hero_name()] уже проснулся."

# ch/harems/home/events/home_harem_beach_date.rpy:200
translate russian home_harem_bree_sasha_beach_date_63ba4e9e:
    sasha.say "Это ты его своими воплями разбудила!"

# ch/harems/home/events/home_harem_beach_date.rpy:202
translate russian home_harem_bree_sasha_beach_date_852fdd15:
    bree.say "Да что за..."

# ch/harems/home/events/home_harem_beach_date.rpy:204
translate russian home_harem_bree_sasha_beach_date_df0a8f2c:
    bree.say "Скорее он учуял твой обед!"

# ch/harems/home/events/home_harem_beach_date.rpy:205
translate russian home_harem_bree_sasha_beach_date_020b66c6:
    sasha.say "Как скажешь, [lssb_beach.bree_name()]. Пусть он нас рассудит."

# ch/harems/home/events/home_harem_beach_date.rpy:206
translate russian home_harem_bree_sasha_beach_date_01cd8121:
    "Мне отчасти любопытно, из-за чего девушки препираются."

# ch/harems/home/events/home_harem_beach_date.rpy:207
translate russian home_harem_bree_sasha_beach_date_5c6dda85:
    "Но другая часть меня хочет притвориться спящей и предоставить им разбираться самим."

# ch/harems/home/events/home_harem_beach_date.rpy:208
translate russian home_harem_bree_sasha_beach_date_d1e39743:
    mike.say "А... что случилось?"

# ch/harems/home/events/home_harem_beach_date.rpy:210
translate russian home_harem_bree_sasha_beach_date_95a939d1:
    bree.say "Я сделала сэндвичи на обед, как и обещала."

# ch/harems/home/events/home_harem_beach_date.rpy:212
translate russian home_harem_bree_sasha_beach_date_20a1d7f7:
    sasha.say "А я — роллы, потому что мне она об этом не сказала."

# ch/harems/home/events/home_harem_beach_date.rpy:213
translate russian home_harem_bree_sasha_beach_date_2ba09f41:
    "Я пожимаю плечами и жду продолжения, но его не следует."

# ch/harems/home/events/home_harem_beach_date.rpy:214
translate russian home_harem_bree_sasha_beach_date_b485d418:
    mike.say "И в чём... собственно, проблема?"

# ch/harems/home/events/home_harem_beach_date.rpy:216
translate russian home_harem_bree_sasha_beach_date_80efe16d:
    bree.say "Я сделала сэндвичи с варёной колбасой, потому что ты их больше всего любишь."

# ch/harems/home/events/home_harem_beach_date.rpy:218
translate russian home_harem_bree_sasha_beach_date_a80ac9e7:
    sasha.say "Ничего подобного, [lssb_beach.bree_name()], он больше всего любит роллы с курицей."

# ch/harems/home/events/home_harem_beach_date.rpy:219
translate russian home_harem_bree_sasha_beach_date_165af400:
    sasha.say "Именно их я и приготовила!"

# ch/harems/home/events/home_harem_beach_date.rpy:222
translate russian home_harem_bree_sasha_beach_date_5b91d02c:
    "Вдруг каждая из защитниц своего блюда суёт мне его прямо под нос."

# ch/harems/home/events/home_harem_beach_date.rpy:223
translate russian home_harem_bree_sasha_beach_date_ca393418:
    "Хотя время обеда уже близко, я не ожидал, что он превратится в настоящее сражение!"

# ch/harems/home/events/home_harem_beach_date.rpy:224
translate russian home_harem_bree_sasha_beach_date_954b4bed:
    "Вполне возможно, в разное время я называл любимыми и то и другое."

# ch/harems/home/events/home_harem_beach_date.rpy:225
translate russian home_harem_bree_sasha_beach_date_fcb13020:
    "Просто не думал, что это когда-нибудь так мне аукнется!"

# ch/harems/home/events/home_harem_beach_date.rpy:228
translate russian home_harem_bree_sasha_beach_date_60df469a:
    "Отсюда Сашин ролл с курицей выглядит весьма аппетитно."

# ch/harems/home/events/home_harem_beach_date.rpy:229
translate russian home_harem_bree_sasha_beach_date_7b3eebd3:
    "Но тут я замечаю, что [lssb_beach.bree_name()] держит сэндвич с колбасой, из которого капает горчица."

# ch/harems/home/events/home_harem_beach_date.rpy:230
translate russian home_harem_bree_sasha_beach_date_852077a7:
    "Возможно, я ещё пожалею, но это решает дело."

# ch/harems/home/events/home_harem_beach_date.rpy:231
translate russian home_harem_bree_sasha_beach_date_ba7f7e02:
    mike.say "Ничего себе..."

# ch/harems/home/events/home_harem_beach_date.rpy:232
translate russian home_harem_bree_sasha_beach_date_0717c783:
    mike.say "И то и другое выглядит очень вкусно."

# ch/harems/home/events/home_harem_beach_date.rpy:233
translate russian home_harem_bree_sasha_beach_date_0b34000b:
    mike.say "Но сегодня мне, пожалуй, больше хочется сэндвич."

# ch/harems/home/events/home_harem_beach_date.rpy:236
translate russian home_harem_bree_sasha_beach_date_5a725429:
    "Я беру сэндвич, который протягивает [lssb_beach.bree_name()], и одновременно пытаюсь извиняющимся жестом обратиться к Саше."

# ch/harems/home/events/home_harem_beach_date.rpy:237
translate russian home_harem_bree_sasha_beach_date_37dd038a:
    "Неизбежный итог: девушка, чьё блюдо я выбрал, сияет от победы."

# ch/harems/home/events/home_harem_beach_date.rpy:241
translate russian home_harem_bree_sasha_beach_date_fed5ff39:
    "А та, которой я отказал, отворачивается и бормочет что-то себе под нос."

# ch/harems/home/events/home_harem_beach_date.rpy:243
translate russian home_harem_bree_sasha_beach_date_b939a7c6:
    "Сэндвич с колбасой, который приготовила [lssb_beach.bree_name()], отсюда выглядит весьма аппетитно."

# ch/harems/home/events/home_harem_beach_date.rpy:244
translate russian home_harem_bree_sasha_beach_date_280c6454:
    "Но тут я замечаю, что из ролла с курицей в руке Саши капает майонез."

# ch/harems/home/events/home_harem_beach_date.rpy:245
translate russian home_harem_bree_sasha_beach_date_852077a7_1:
    "Возможно, я ещё пожалею, но это решает дело."

# ch/harems/home/events/home_harem_beach_date.rpy:246
translate russian home_harem_bree_sasha_beach_date_ba7f7e02_1:
    mike.say "Ничего себе..."

# ch/harems/home/events/home_harem_beach_date.rpy:247
translate russian home_harem_bree_sasha_beach_date_0717c783_1:
    mike.say "И то и другое выглядит очень вкусно."

# ch/harems/home/events/home_harem_beach_date.rpy:248
translate russian home_harem_bree_sasha_beach_date_66c06586:
    mike.say "Но сегодня мне, пожалуй, больше хочется ролл."

# ch/harems/home/events/home_harem_beach_date.rpy:253
translate russian home_harem_bree_sasha_beach_date_58a300dc:
    "Я беру ролл, который протягивает Саша, и пожимаю плечами, надеясь, что [lssb_beach.bree_name()] поймёт мой извиняющийся жест."

# ch/harems/home/events/home_harem_beach_date.rpy:254
translate russian home_harem_bree_sasha_beach_date_37dd038a_1:
    "Неизбежный итог: девушка, чьё блюдо я выбрал, сияет от победы."

# ch/harems/home/events/home_harem_beach_date.rpy:256
translate russian home_harem_bree_sasha_beach_date_fed5ff39_1:
    "А та, которой я отказал, отворачивается и бормочет что-то себе под нос."

# ch/harems/home/events/home_harem_beach_date.rpy:259
translate russian home_harem_bree_sasha_beach_date_10be6150:
    "Пока я доедаю выбранный обед, чувствую, как атмосфера между нами становится всё напряжённее."

# ch/harems/home/events/home_harem_beach_date.rpy:260
translate russian home_harem_bree_sasha_beach_date_73410a29:
    "И понимаю, что как минимум одна из девушек проведёт остаток дня в дурном настроении."

# ch/harems/home/events/home_harem_beach_date.rpy:261
translate russian home_harem_bree_sasha_beach_date_55693adc:
    "Поэтому, немного подождав после еды, я встаю и жестом предлагаю остальным сделать то же самое."

# ch/harems/home/events/home_harem_beach_date.rpy:262
translate russian home_harem_bree_sasha_beach_date_62b5d2db:
    mike.say "Ну же, девчонки."

# ch/harems/home/events/home_harem_beach_date.rpy:263
translate russian home_harem_bree_sasha_beach_date_92a279ff:
    mike.say "Хватит нам сидеть на задницах."

# ch/harems/home/events/home_harem_beach_date.rpy:264
translate russian home_harem_bree_sasha_beach_date_4c9d9722:
    mike.say "Пойдём купаться!"

# ch/harems/home/events/home_harem_beach_date.rpy:267
translate russian home_harem_bree_sasha_beach_date_71046694:
    "Предложение, похоже, даёт нужный эффект: обе девушки с готовностью кивают."

# ch/harems/home/events/home_harem_beach_date.rpy:268
translate russian home_harem_bree_sasha_beach_date_3886e81d:
    "[lssb_beach.bree_name()] первой вскакивает на ноги и хватает пляжный мяч, который мы взяли с собой."

# ch/harems/home/events/home_harem_beach_date.rpy:269
translate russian home_harem_bree_sasha_beach_date_d2647c0b:
    bree.say "Кто последним в воду — тащит холодильник обратно!"

# ch/harems/home/events/home_harem_beach_date.rpy:271
translate russian home_harem_bree_sasha_beach_date_b95f67f6:
    "С этими словами она срывается с места и бежит к воде."

# ch/harems/home/events/home_harem_beach_date.rpy:273
translate russian home_harem_bree_sasha_beach_date_d6e411fd:
    sasha.say "Эй, так нечестно!"

# ch/harems/home/events/home_harem_beach_date.rpy:275
translate russian home_harem_bree_sasha_beach_date_df30dbda:
    "Саша тоже вскакивает, в спешке разбрасывая песок."

# ch/harems/home/events/home_harem_beach_date.rpy:276
translate russian home_harem_bree_sasha_beach_date_ddc3dfd5:
    "И тут она косится на меня, прищурив глаза."

# ch/harems/home/events/home_harem_beach_date.rpy:277
translate russian home_harem_bree_sasha_beach_date_154288ee:
    "Я чуть поздновато понимаю, что теперь за второе место боремся мы с ней."

# ch/harems/home/events/home_harem_beach_date.rpy:279
translate russian home_harem_bree_sasha_beach_date_85839c6f:
    sasha.say "Увидимся, неудачник!"

# ch/harems/home/events/home_harem_beach_date.rpy:281
translate russian home_harem_bree_sasha_beach_date_3255faab:
    "Саша бросается следом; [lssb_beach.bree_name()] уже впереди, а мне остаётся опомниться и побежать за ними."

# ch/harems/home/events/home_harem_beach_date.rpy:283
translate russian home_harem_bree_sasha_beach_date_6fd2d794:
    "Она добегает до воды на секунду-другую раньше меня и победно вскидывает кулак."

# ch/harems/home/events/home_harem_beach_date.rpy:285
translate russian home_harem_bree_sasha_beach_date_a8ff1dbf:
    "А я довожу её триумф до совершенства: спотыкаюсь и падаю лицом прямо в набегающую волну."

# ch/harems/home/events/home_harem_beach_date.rpy:289
translate russian home_harem_bree_sasha_beach_date_c5ceffd0:
    "[lssb_beach.bree_name()] и Саша дают друг другу пять, пока я кое-как поднимаюсь."

# ch/harems/home/events/home_harem_beach_date.rpy:290
translate russian home_harem_bree_sasha_beach_date_4f6798aa:
    bree.say "Не повезло, [lssb_common.hero_name()]!"

# ch/harems/home/events/home_harem_beach_date.rpy:291
translate russian home_harem_bree_sasha_beach_date_3a3c878a:
    sasha.say "Ага, побереги силы — тебе ещё всю эту тяжеленную хрень тащить!"

# ch/harems/home/events/home_harem_beach_date.rpy:292
translate russian home_harem_bree_sasha_beach_date_3ec475d9:
    mike.say "Ха-ха... очень смешно, девчонки."

# ch/harems/home/events/home_harem_beach_date.rpy:293
translate russian home_harem_bree_sasha_beach_date_fc88cd2a:
    mike.say "Знаете что? Давайте отыграюсь."

# ch/harems/home/events/home_harem_beach_date.rpy:294
translate russian home_harem_bree_sasha_beach_date_0f6a88b5:
    mike.say "Поиграем в мяч, только не дадим ему упасть, ладно?"

# ch/harems/home/events/home_harem_beach_date.rpy:295
translate russian home_harem_bree_sasha_beach_date_a6aff807:
    mike.say "Кто из вас уронит его в воду, та поможет мне нести вещи."

# ch/harems/home/events/home_harem_beach_date.rpy:296
translate russian home_harem_bree_sasha_beach_date_30dc1227:
    mike.say "А если уроню я, понесу всё сам."

# ch/harems/home/events/home_harem_beach_date.rpy:299
translate russian home_harem_bree_sasha_beach_date_d1cabfd9:
    "Саша хмурится, а [lssb_beach.bree_name()] недоумённо склоняет голову набок."

# ch/harems/home/events/home_harem_beach_date.rpy:300
translate russian home_harem_bree_sasha_beach_date_1f0701fb:
    bree.say "Но разве ты и так не должен всё нести?"

# ch/harems/home/events/home_harem_beach_date.rpy:301
translate russian home_harem_bree_sasha_beach_date_73b68f28:
    sasha.say "Да, [lssb_common.hero_name()], предложи что-нибудь получше, а то мы не согласимся!"

# ch/harems/home/events/home_harem_beach_date.rpy:302
translate russian home_harem_bree_sasha_beach_date_87f649e3:
    mike.say "Ладно, ладно, дайте подумать..."

# ch/harems/home/events/home_harem_beach_date.rpy:303
translate russian home_harem_bree_sasha_beach_date_07de9c94:
    "Тут мой взгляд падает на киоск дальше по пляжу, где продаются напитки и всякие вкусности."

# ch/harems/home/events/home_harem_beach_date.rpy:304
translate russian home_harem_bree_sasha_beach_date_7b82d555:
    mike.say "Всё, придумал."

# ch/harems/home/events/home_harem_beach_date.rpy:305
translate russian home_harem_bree_sasha_beach_date_812f3f67:
    mike.say "Если проиграю, покупаю всем мороженое. Идёт?"

# ch/harems/home/events/home_harem_beach_date.rpy:307
translate russian home_harem_bree_sasha_beach_date_837dbcf5:
    bree.say "О-о, звучит здорово!"

# ch/harems/home/events/home_harem_beach_date.rpy:308
translate russian home_harem_bree_sasha_beach_date_e1875b84:
    sasha.say "Да, но выбирать будем МЫ."

# ch/harems/home/events/home_harem_beach_date.rpy:309
translate russian home_harem_bree_sasha_beach_date_a99b27b5:
    sasha.say "Не вздумай на нас экономить!"

# ch/harems/home/events/home_harem_beach_date.rpy:310
translate russian home_harem_bree_sasha_beach_date_a249e618:
    mike.say "Ладно, какое захотите."

# ch/harems/home/events/home_harem_beach_date.rpy:312
translate russian home_harem_bree_sasha_beach_date_cb89a130:
    "Обмен кивками и рукопожатиями скрепляет сделку, и мы начинаем играть."

# ch/harems/home/events/home_harem_beach_date.rpy:313
translate russian home_harem_bree_sasha_beach_date_094e7645:
    "Двое против одного — расклад был бы не в мою пользу, будь хоть одна из них серьёзной спортсменкой."

# ch/harems/home/events/home_harem_beach_date.rpy:314
translate russian home_harem_bree_sasha_beach_date_937f5192:
    "Но меня не особенно волнует, кто победит в этой маленькой схватке."

# ch/harems/home/events/home_harem_beach_date.rpy:315
translate russian home_harem_bree_sasha_beach_date_0067d609:
    "В конце концов, что мне стоит купить пару порций мороженого и отнести вещи к машине?"

# ch/harems/home/events/home_harem_beach_date.rpy:317
translate russian home_harem_bree_sasha_beach_date_2bdfc973:
    "Особенно если уже сейчас я могу плескаться рядом, пока [lssb_beach.bree_name()] и Саша резвятся в купальниках?"

# ch/harems/home/events/home_harem_beach_date.rpy:318
translate russian home_harem_bree_sasha_beach_date_cd12b261:
    "В самой игре ничего особенного, а вот вид прыгающих туда-сюда девушек — совсем другое дело."

# ch/harems/home/events/home_harem_beach_date.rpy:319
translate russian home_harem_bree_sasha_beach_date_b1180da2:
    "И хотя я сказал, что не боюсь проиграть, делаю всё возможное, чтобы растянуть удовольствие."

# ch/harems/home/events/home_harem_beach_date.rpy:321
translate russian home_harem_bree_sasha_beach_date_f4ee4423:
    "Но мои планы рушатся, когда Саша вдруг пронзительно вскрикивает."

# ch/harems/home/events/home_harem_beach_date.rpy:323
translate russian home_harem_bree_sasha_beach_date_002ad273:
    "Секунду спустя она уже подпрыгивает от боли, пропуская мяч, который падает в воду."

# ch/harems/home/events/home_harem_beach_date.rpy:325
translate russian home_harem_bree_sasha_beach_date_32076a38:
    bree.say "Эй, Саша, ты уронила мяч!"

# ch/harems/home/events/home_harem_beach_date.rpy:326
translate russian home_harem_bree_sasha_beach_date_05b261db:
    sasha.say "Ай... чёрт..."

# ch/harems/home/events/home_harem_beach_date.rpy:327
translate russian home_harem_bree_sasha_beach_date_865545b2:
    sasha.say "Больно!"

# ch/harems/home/events/home_harem_beach_date.rpy:328
translate russian home_harem_bree_sasha_beach_date_6971ffdd:
    "Когда я подхожу по воде, пытаясь понять, в чём дело, Саша поворачивается ко мне."

# ch/harems/home/events/home_harem_beach_date.rpy:329
translate russian home_harem_bree_sasha_beach_date_786b9056:
    "Она машет ногой примерно в мою сторону, и только теперь я вижу, что висит у неё на большом пальце."

# ch/harems/home/events/home_harem_beach_date.rpy:330
translate russian home_harem_bree_sasha_beach_date_d8f2dccf:
    mike.say "Эй, Саша, у тебя на пальце краб висит!"

# ch/harems/home/events/home_harem_beach_date.rpy:332
translate russian home_harem_bree_sasha_beach_date_ab82924c:
    sasha.say "Да неужели, гений!"

# ch/harems/home/events/home_harem_beach_date.rpy:334
translate russian home_harem_bree_sasha_beach_date_92b3842c:
    sasha.say "Может, ты подумаешь о том, чтобы... не знаю... СНЯТЬ ЕГО?!"

# ch/harems/home/events/home_harem_beach_date.rpy:338
translate russian home_harem_bree_sasha_beach_date_df0554d1:
    "Отчаянных требований Саши вполне хватает, чтобы заставить меня действовать."

# ch/harems/home/events/home_harem_beach_date.rpy:339
translate russian home_harem_bree_sasha_beach_date_0882c640:
    "Я бросаюсь вперёд и хватаю нахального ракообразного обеими руками."

# ch/harems/home/events/home_harem_beach_date.rpy:340
translate russian home_harem_bree_sasha_beach_date_28e83195:
    "Тот отважно пытается ущипнуть и меня."

# ch/harems/home/events/home_harem_beach_date.rpy:341
translate russian home_harem_bree_sasha_beach_date_af0577a4:
    "И прежде чем всё заканчивается, успевает несколько раз чувствительно цапнуть меня за пальцы."

# ch/harems/home/events/home_harem_beach_date.rpy:342
translate russian home_harem_bree_sasha_beach_date_0d874337:
    "Но против моих десяти пальцев у него всего две клешни, и вскоре он проигрывает."

# ch/harems/home/events/home_harem_beach_date.rpy:344
translate russian home_harem_bree_sasha_beach_date_8721c9ff:
    "Даже сняв его с пальца и избавив Сашу от опасности, я не бросаю краба куда попало."

# ch/harems/home/events/home_harem_beach_date.rpy:345
translate russian home_harem_bree_sasha_beach_date_326cb1d0:
    "Вместо этого выношу его на берег и опускаю в ближайшую лужицу между камнями."

# ch/harems/home/events/home_harem_beach_date.rpy:346
translate russian home_harem_bree_sasha_beach_date_f5db9f93:
    "И, возвращаясь к девушкам, вижу, что сам этот поступок заметно поднял меня в их глазах."

# ch/harems/home/events/home_harem_beach_date.rpy:347
translate russian home_harem_bree_sasha_beach_date_7807a07e:
    sasha.say "Ох, спасибо, [lssb_common.hero_name()]."

# ch/harems/home/events/home_harem_beach_date.rpy:348
translate russian home_harem_bree_sasha_beach_date_35d54606:
    sasha.say "Было ТАК больно!"

# ch/harems/home/events/home_harem_beach_date.rpy:351
translate russian home_harem_bree_sasha_beach_date_03f1e0b2:
    bree.say "И о бедном крабике ты тоже позаботился!"

# ch/harems/home/events/home_harem_beach_date.rpy:353
translate russian home_harem_bree_sasha_beach_date_7a82b8ce:
    bree.say "Конечно, крабы меня жутко пугают."

# ch/harems/home/events/home_harem_beach_date.rpy:354
translate russian home_harem_bree_sasha_beach_date_067d51cd:
    bree.say "Но ты обращался с ним так бережно!"

# ch/harems/home/events/home_harem_beach_date.rpy:357
translate russian home_harem_bree_sasha_beach_date_a876793d:
    bree.say "Фу-у..."

# ch/harems/home/events/home_harem_beach_date.rpy:358
translate russian home_harem_bree_sasha_beach_date_c42e5e3e:
    bree.say "Помоги ей, [lssb_common.hero_name()], скорее!"

# ch/harems/home/events/home_harem_beach_date.rpy:359
translate russian home_harem_bree_sasha_beach_date_9e02fdfa:
    bree.say "Бр-р, НЕНАВИЖУ крабов!"

# ch/harems/home/events/home_harem_beach_date.rpy:360
translate russian home_harem_bree_sasha_beach_date_9d2d2b4e:
    "Я уже собираюсь подчиниться."

# ch/harems/home/events/home_harem_beach_date.rpy:361
translate russian home_harem_bree_sasha_beach_date_afba929b:
    "Но тут в голову приходит жестокая, хотя и забавная мысль."

# ch/harems/home/events/home_harem_beach_date.rpy:362
translate russian home_harem_bree_sasha_beach_date_76d6f28a:
    mike.say "Ах... чёрт!"

# ch/harems/home/events/home_harem_beach_date.rpy:363
translate russian home_harem_bree_sasha_beach_date_23433228:
    bree.say "Чт... что случилось?!"

# ch/harems/home/events/home_harem_beach_date.rpy:364
translate russian home_harem_bree_sasha_beach_date_017e6c02:
    mike.say "Я... кажется, у меня судорога... ногу свело!"

# ch/harems/home/events/home_harem_beach_date.rpy:365
translate russian home_harem_bree_sasha_beach_date_c0adfadb:
    mike.say "[lssb_beach.bree_name()], тебе придётся помочь Саше, и побыстрее!"

# ch/harems/home/events/home_harem_beach_date.rpy:368
translate russian home_harem_bree_sasha_beach_date_5a90f6b0:
    "[lssb_beach.bree_name()] содрогается от одного предложения и отчаянно мотает головой."

# ch/harems/home/events/home_harem_beach_date.rpy:369
translate russian home_harem_bree_sasha_beach_date_529e88a7:
    bree.say "Я... нет... не могу..."

# ch/harems/home/events/home_harem_beach_date.rpy:370
translate russian home_harem_bree_sasha_beach_date_14f08977:
    sasha.say "Да твою же мать, [lssb_beach.bree_name()]!"

# ch/harems/home/events/home_harem_beach_date.rpy:372
translate russian home_harem_bree_sasha_beach_date_1a68bbc3:
    sasha.say "ПОМОГИ МНЕ!"

# ch/harems/home/events/home_harem_beach_date.rpy:374
translate russian home_harem_bree_sasha_beach_date_e117ae39:
    "После Сашиного крика [lssb_beach.bree_name()] наконец бросается вперёд."

# ch/harems/home/events/home_harem_beach_date.rpy:375
translate russian home_harem_bree_sasha_beach_date_d15f05d5:
    "Но при этом старается отвести глаза и отвернуться всем телом."

# ch/harems/home/events/home_harem_beach_date.rpy:376
translate russian home_harem_bree_sasha_beach_date_4391b939:
    "Дальше разыгрывается настоящий фарс: Саша машет ногой, а [lssb_beach.bree_name()] пытается схватить её не глядя."

# ch/harems/home/events/home_harem_beach_date.rpy:377
translate russian home_harem_bree_sasha_beach_date_121adc54:
    "Наконец [lssb_beach.bree_name()] везёт: она хватает краба."

# ch/harems/home/events/home_harem_beach_date.rpy:378
translate russian home_harem_bree_sasha_beach_date_776fe65f:
    "Не заботясь об ощущениях Саши, она отрывает ракообразного и швыряет в сторону."

# ch/harems/home/events/home_harem_beach_date.rpy:379
translate russian home_harem_bree_sasha_beach_date_16810894:
    "Несчастный краб пролетает изрядное расстояние и исчезает под водой."

# ch/harems/home/events/home_harem_beach_date.rpy:382
translate russian home_harem_bree_sasha_beach_date_9a0300a0:
    "Опасность миновала, и теперь слышны лишь вздохи и стоны девушек."

# ch/harems/home/events/home_harem_beach_date.rpy:383
translate russian home_harem_bree_sasha_beach_date_3506d81b:
    "Я прикусываю язык и подавляю желание сказать, что они делают из мухи слона."

# ch/harems/home/events/home_harem_beach_date.rpy:384
translate russian home_harem_bree_sasha_beach_date_4da6ac50:
    "Вместо этого решаю, что при таких обстоятельствах не могу принять столь сомнительную победу."

# ch/harems/home/events/home_harem_beach_date.rpy:385
translate russian home_harem_bree_sasha_beach_date_0697e09b:
    mike.say "То мороженое, которое я обещал, поможет вам прийти в себя?"

# ch/harems/home/events/home_harem_beach_date.rpy:386
translate russian home_harem_bree_sasha_beach_date_b5551611:
    "При одном упоминании мороженого [lssb_beach.bree_name()] и Саша словно забывают о своих бедах."

# ch/harems/home/events/home_harem_beach_date.rpy:389
translate russian home_harem_bree_sasha_beach_date_7ba414cf:
    bree.say "О-о, ты серьёзно?"

# ch/harems/home/events/home_harem_beach_date.rpy:390
translate russian home_harem_bree_sasha_beach_date_9059eccb:
    sasha.say "Ага, с чего вдруг?"

# ch/harems/home/events/home_harem_beach_date.rpy:391
translate russian home_harem_bree_sasha_beach_date_fb22744d:
    sasha.say "Ты ведь выиграл?"

# ch/harems/home/events/home_harem_beach_date.rpy:392
translate russian home_harem_bree_sasha_beach_date_a41c0a9c:
    "Я нарочито пожимаю плечами и направляюсь к киоску."

# ch/harems/home/events/home_harem_beach_date.rpy:394
translate russian home_harem_bree_sasha_beach_date_937ba05d:
    mike.say "Краб всё равно испортил игру, так что давайте забудем."

# ch/harems/home/events/home_harem_beach_date.rpy:398
translate russian home_harem_bree_sasha_beach_date_f28bf91c:
    "У киоска я выслушиваю, кто что хочет, а затем раздаю готовое мороженое."

# ch/harems/home/events/home_harem_beach_date.rpy:399
translate russian home_harem_bree_sasha_beach_date_f184f103:
    "Все мы выбрали рожки с шариками мороженого и добавками."

# ch/harems/home/events/home_harem_beach_date.rpy:402
translate russian home_harem_bree_sasha_beach_date_5ba98cd1:
    "Но [lssb_beach.bree_name()] выбрала самую высокую башню и уже с трудом справляется с ней, пока мы отходим."

# ch/harems/home/events/home_harem_beach_date.rpy:403
translate russian home_harem_bree_sasha_beach_date_e7f5e2fa:
    "Я смотрю, как она тщетно пытается удержать равновесие этой конструкции, грозящей обрушиться."

# ch/harems/home/events/home_harem_beach_date.rpy:404
translate russian home_harem_bree_sasha_beach_date_046a98a3:
    "Даже попытки облизывать её в стратегически важных местах не дают нужного результата."

# ch/harems/home/events/home_harem_beach_date.rpy:405
translate russian home_harem_bree_sasha_beach_date_fcf7cc98:
    "К тому времени, как мы возвращаемся к своим вещам, Саша тоже наблюдает за этим представлением."

# ch/harems/home/events/home_harem_beach_date.rpy:406
translate russian home_harem_bree_sasha_beach_date_b03731c6:
    mike.say "Эм, [lssb_beach.bree_name()]..."

# ch/harems/home/events/home_harem_beach_date.rpy:407
translate russian home_harem_bree_sasha_beach_date_ec729de2:
    mike.say "Тебе помочь?"

# ch/harems/home/events/home_harem_beach_date.rpy:408
translate russian home_harem_bree_sasha_beach_date_cd690650:
    bree.say "А?!"

# ch/harems/home/events/home_harem_beach_date.rpy:409
translate russian home_harem_bree_sasha_beach_date_4fd67a29:
    "Из-за моего вопроса [lssb_beach.bree_name()] отвлекается ровно настолько, чтобы всё пошло прахом."

# ch/harems/home/events/home_harem_beach_date.rpy:410
translate russian home_harem_bree_sasha_beach_date_b0343c94:
    "И я беспомощно молчу, глядя, как верхний шарик мороженого срывается с башни."

# ch/harems/home/events/home_harem_beach_date.rpy:411
translate russian home_harem_bree_sasha_beach_date_7f116928:
    bree.say "А-а-а..."

# ch/harems/home/events/home_harem_beach_date.rpy:412
translate russian home_harem_bree_sasha_beach_date_66bb21d4:
    bree.say "Чёрт, оно же ледяное!"

# ch/harems/home/events/home_harem_beach_date.rpy:413
translate russian home_harem_bree_sasha_beach_date_1588e9e7:
    "Я слышу, что говорит [lssb_beach.bree_name()], но взгляд прикован к мороженому."

# ch/harems/home/events/home_harem_beach_date.rpy:414
translate russian home_harem_bree_sasha_beach_date_32870cde:
    "Мне остаётся лишь смотреть, как оно сползает по её груди, в ложбинку..."

# ch/harems/home/events/home_harem_beach_date.rpy:417
translate russian home_harem_bree_sasha_beach_date_b8776b71:
    "Не знаю, что заставляет меня это сделать и почему я вообще думаю, что [lssb_beach.bree_name()] этого хочет."

# ch/harems/home/events/home_harem_beach_date.rpy:419
translate russian home_harem_bree_sasha_beach_date_e87649a9:
    "Но я без малейшего колебания наклоняюсь к ней и открываю рот."

# ch/harems/home/events/home_harem_beach_date.rpy:420
translate russian home_harem_bree_sasha_beach_date_00616e48:
    "Пока [lssb_beach.bree_name()] приходила в себя, почти весь шарик скатился с её груди на песок."

# ch/harems/home/events/home_harem_beach_date.rpy:421
translate russian home_harem_bree_sasha_beach_date_679619c1:
    "Так что я принимаюсь слизывать оставленный им след."

# ch/harems/home/events/home_harem_beach_date.rpy:426
translate russian home_harem_bree_sasha_beach_date_7a46e27e:
    bree.say "Что ты..."

# ch/harems/home/events/home_harem_beach_date.rpy:427
translate russian home_harem_bree_sasha_beach_date_71440e33:
    "В её голосе скорее удивление, чем возражение."

# ch/harems/home/events/home_harem_beach_date.rpy:428
translate russian home_harem_bree_sasha_beach_date_edcef0fe:
    "И когда я действительно начинаю очищать её грудь языком, оно тает, как само мороженое."

# ch/harems/home/events/home_harem_beach_date.rpy:430
translate russian home_harem_bree_sasha_beach_date_ce2770ee:
    bree.say "Ох, [lssb_common.hero_name()]..."

# ch/harems/home/events/home_harem_beach_date.rpy:431
translate russian home_harem_bree_sasha_beach_date_b9888b0b:
    "Поначалу я ощущаю вкус мороженого."

# ch/harems/home/events/home_harem_beach_date.rpy:432
translate russian home_harem_bree_sasha_beach_date_57c0860b:
    "Но вскоре к нему примешивается вкус пота и крема от солнца, которым намазалась [lssb_beach.bree_name()]."

# ch/harems/home/events/home_harem_beach_date.rpy:433
translate russian home_harem_bree_sasha_beach_date_e607c17d:
    "Даже когда с мороженым, кажется, покончено, я не останавливаюсь."

# ch/harems/home/events/home_harem_beach_date.rpy:434
translate russian home_harem_bree_sasha_beach_date_c5c8f2de:
    "Мой язык обводит контур груди, и [lssb_beach.bree_name()] чувствует, как он грозит скользнуть ещё дальше..."

# ch/harems/home/events/home_harem_beach_date.rpy:436
translate russian home_harem_bree_sasha_beach_date_ec4f9c86:
    bree.say "Ах..."

# ch/harems/home/events/home_harem_beach_date.rpy:437
translate russian home_harem_bree_sasha_beach_date_6a6bd10c:
    bree.say "К... кажется, ты уже всё слизал!"

# ch/harems/home/events/home_harem_beach_date.rpy:438
translate russian home_harem_bree_sasha_beach_date_1b5e2123:
    "Как бы мне ни хотелось продолжить, намёки я понимаю."

# ch/harems/home/events/home_harem_beach_date.rpy:439
translate russian home_harem_bree_sasha_beach_date_ad50671e:
    "Поэтому убираю язык и отстраняюсь."

# ch/harems/home/events/home_harem_beach_date.rpy:442
translate russian home_harem_bree_sasha_beach_date_c8891222:
    "Я подумываю помочь сам и даже начинаю наклоняться вперёд."

# ch/harems/home/events/home_harem_beach_date.rpy:444
translate russian home_harem_bree_sasha_beach_date_5d89a124:
    "Но тут мне приходит в голову куда более заманчивая возможность, и я замираю."

# ch/harems/home/events/home_harem_beach_date.rpy:445
translate russian home_harem_bree_sasha_beach_date_d28f27f3:
    mike.say "Саша..."

# ch/harems/home/events/home_harem_beach_date.rpy:446
translate russian home_harem_bree_sasha_beach_date_170bd579:
    mike.say "Почему бы тебе не помочь? [lssb_beach.bree_name()] вся в мороженом."

# ch/harems/home/events/home_harem_beach_date.rpy:450
translate russian home_harem_bree_sasha_beach_date_287fee5e:
    "Саша мгновение смотрит на меня, явно не понимая, что я имею в виду."

# ch/harems/home/events/home_harem_beach_date.rpy:451
translate russian home_harem_bree_sasha_beach_date_1e62c281:
    "Я улыбаюсь и многозначительно облизываю губы."

# ch/harems/home/events/home_harem_beach_date.rpy:454
translate russian home_harem_bree_sasha_beach_date_a6da803b:
    "Она выглядит удивлённой, затем смущённой, но всё же кивает."

# ch/harems/home/events/home_harem_beach_date.rpy:459
translate russian home_harem_bree_sasha_beach_date_5c3d07f7:
    "Лишь когда Саша наклоняется к её груди, [lssb_beach.bree_name()] замечает происходящее."

# ch/harems/home/events/home_harem_beach_date.rpy:460
translate russian home_harem_bree_sasha_beach_date_a84a8368:
    bree.say "Саша?"

# ch/harems/home/events/home_harem_beach_date.rpy:461
translate russian home_harem_bree_sasha_beach_date_7a46e27e_1:
    bree.say "Что ты..."

# ch/harems/home/events/home_harem_beach_date.rpy:464
translate russian home_harem_bree_sasha_beach_date_c6a65ff8:
    bree.say "О-о, Саша..."

# ch/harems/home/events/home_harem_beach_date.rpy:465
translate russian home_harem_bree_sasha_beach_date_15b1e1f3:
    "Я смотрю всё более заворожённо: Саша начинает облизывать грудь, а [lssb_beach.bree_name()] стоит перед ней."

# ch/harems/home/events/home_harem_beach_date.rpy:466
translate russian home_harem_bree_sasha_beach_date_00616e48_1:
    "Пока [lssb_beach.bree_name()] приходила в себя, почти весь шарик скатился с её груди на песок."

# ch/harems/home/events/home_harem_beach_date.rpy:467
translate russian home_harem_bree_sasha_beach_date_c4df852e:
    "Так что Саша сразу пускает в ход язык, собирая липкие остатки с кожи подруги."

# ch/harems/home/events/home_harem_beach_date.rpy:468
translate russian home_harem_bree_sasha_beach_date_fa26ada9:
    "Сначала [lssb_beach.bree_name()] издаёт удивлённые и встревоженные звуки."

# ch/harems/home/events/home_harem_beach_date.rpy:469
translate russian home_harem_bree_sasha_beach_date_7c68a8ba:
    "Но вскоре они тают, словно мороженое, становясь тихими и чувственными."

# ch/harems/home/events/home_harem_beach_date.rpy:470
translate russian home_harem_bree_sasha_beach_date_6f4c60e1:
    "Поначалу я почти сам ощущаю вкус мороженого."

# ch/harems/home/events/home_harem_beach_date.rpy:471
translate russian home_harem_bree_sasha_beach_date_d602472e:
    "Затем представляю, как к нему примешивается вкус пота и крема от солнца, которым намазалась [lssb_beach.bree_name()]."

# ch/harems/home/events/home_harem_beach_date.rpy:472
translate russian home_harem_bree_sasha_beach_date_01d27312:
    "Даже слизав всё мороженое, Саша не останавливается."

# ch/harems/home/events/home_harem_beach_date.rpy:473
translate russian home_harem_bree_sasha_beach_date_45866a01:
    "Её язык обводит контур груди, и [lssb_beach.bree_name()] чувствует, как он грозит скользнуть ещё дальше..."

# ch/harems/home/events/home_harem_beach_date.rpy:474
translate russian home_harem_bree_sasha_beach_date_ec4f9c86_1:
    bree.say "Ах..."

# ch/harems/home/events/home_harem_beach_date.rpy:475
translate russian home_harem_bree_sasha_beach_date_6a6bd10c_1:
    bree.say "К... кажется, ты уже всё слизала!"

# ch/harems/home/events/home_harem_beach_date.rpy:478
translate russian home_harem_bree_sasha_beach_date_d02fdaca:
    "Мне хотелось бы увидеть продолжение, но [lssb_beach.bree_name()] просит остановиться, и Саша слушается."

# ch/harems/home/events/home_harem_beach_date.rpy:483
translate russian home_harem_bree_sasha_beach_date_9eccaf97:
    "Когда мы садимся на полотенца доедать мороженое, повисает неловкая тишина."

# ch/harems/home/events/home_harem_beach_date.rpy:484
translate russian home_harem_bree_sasha_beach_date_c9ee74f6:
    "Кажется, после того как [lssb_beach.bree_name()] помогли очиститься от мороженого, мы все немного взбудоражены."

# ch/harems/home/events/home_harem_beach_date.rpy:485
translate russian home_harem_bree_sasha_beach_date_12916a6f:
    "Никому не хочется открывать рот для разговора, поэтому мы продолжаем наполнять его мороженым."

# ch/harems/home/events/home_harem_beach_date.rpy:486
translate russian home_harem_bree_sasha_beach_date_7e986b92:
    "Но моя голова полна образов, навеянных тем, что только что произошло."

# ch/harems/home/events/home_harem_beach_date.rpy:487
translate russian home_harem_bree_sasha_beach_date_3dba615c:
    "И я более чем уверен, что [lssb_beach.bree_name()] и Саша думают о том же."

# ch/harems/home/events/home_harem_beach_date.rpy:492
translate russian home_harem_bree_sasha_beach_date_5bf6613a:
    "Пока мы собираемся и отправляемся домой, никто ни разу об этом не заговаривает."

# ch/harems/home/events/home_harem_beach_date.rpy:493
translate russian home_harem_bree_sasha_beach_date_8ca68c1a:
