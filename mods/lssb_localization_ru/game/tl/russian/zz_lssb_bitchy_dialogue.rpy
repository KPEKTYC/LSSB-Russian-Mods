# ch/harems_full/bitchy/events.rpy:3351
translate russian cassidy_palla_propose_male_69741153:
    cassidy.say "Ты что..."

# ch/harems_full/bitchy/events.rpy:3352
translate russian cassidy_palla_propose_male_fbf7e272:
    "Я киваю и поднимаю кольца повыше."

# ch/harems_full/bitchy/events.rpy:3353
translate russian cassidy_palla_propose_male_57f3a148:
