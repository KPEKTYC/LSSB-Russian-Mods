# ch/harems_full/bitchy/events.rpy:3217
translate russian audrey_palla_propose_male_1ce7df30:
    "Но через несколько секунд обе кивают, и меня накрывает волна облегчения."

# ch/harems_full/bitchy/events.rpy:3218
translate russian audrey_palla_propose_male_e5e708d6:
    audrey.say "Ого!"

# ch/harems_full/bitchy/events.rpy:3219
translate russian audrey_palla_propose_male_576b9af3:
    audrey.say "Вот это ты ошарашил!"

# ch/harems_full/bitchy/events.rpy:3221
translate russian audrey_palla_propose_male_2411dba5:
    audrey.say "Да какого чёрта — выйду я за тебя."

# ch/harems_full/bitchy/events.rpy:3222
translate russian audrey_palla_propose_male_4c3191de:
    audrey.say "Кто ещё на такое согласится?"

# ch/harems_full/bitchy/events.rpy:3223
translate russian audrey_palla_propose_male_0aa2b48b:
    palla.say "Я тоже, [lssb_common.hero_name()]."

# ch/harems_full/bitchy/events.rpy:3224
translate russian audrey_palla_propose_male_4118edb2:
    palla.say "Ты, конечно, не самый стильный парень на свете."

# ch/harems_full/bitchy/events.rpy:3226
translate russian audrey_palla_propose_male_1bda3935:
    palla.say "Но когда постараешься, выглядишь вполне прилично!"

# ch/harems_full/bitchy/events.rpy:3227
translate russian audrey_palla_propose_male_7fee8e29:
    "Не знаю, от чего у меня голова кругом: от того, что обе согласились..."

# ch/harems_full/bitchy/events.rpy:3228
translate russian audrey_palla_propose_male_141eb384:
