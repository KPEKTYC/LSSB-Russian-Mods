# ch/harems_full/bitchy/events.rpy:1859
translate russian bitchy_harem_foursome_nightclub_intro_ad3d1c46:
    "Закончив оглядывать комнату, я даже отступаю на шаг от удивления."

# ch/harems_full/bitchy/events.rpy:1864
translate russian bitchy_harem_foursome_nightclub_intro_be81922d:
    "Потому что она уже больше чем наполовину разделась!"

# ch/harems_full/bitchy/events.rpy:1865
translate russian bitchy_harem_foursome_nightclub_intro_bce0b6a7:
    "Одри и Палла, кажется, всё это время наблюдали за Кэссиди."

# ch/harems_full/bitchy/events.rpy:1868
translate russian bitchy_harem_foursome_nightclub_intro_152ab074:
    "Они совсем не удивлены и уже начинают следовать её примеру!"

# ch/harems_full/bitchy/events.rpy:1870
translate russian bitchy_harem_foursome_nightclub_intro_5554c185:
    palla.say "Что такое, [lssb_common.hero_name()]?"

# ch/harems_full/bitchy/events.rpy:1871
translate russian bitchy_harem_foursome_nightclub_intro_e0682761:
    palla.say "Ты будто немного потрясён!"

# ch/harems_full/bitchy/events.rpy:1873
translate russian bitchy_harem_foursome_nightclub_intro_e81b04aa:
    audrey.say "Ты ведь понимаешь, что для этого нужно раздеться?"

# ch/harems_full/bitchy/events.rpy:1874
translate russian bitchy_harem_foursome_nightclub_intro_901fbec4:
