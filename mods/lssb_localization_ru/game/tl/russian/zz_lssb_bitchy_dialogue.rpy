# ch/harems_full/bitchy/events.rpy:1884
translate russian bitchy_harem_foursome_nightclub_intro_ca2eb651:
    "Для быстрого и нехитрого развлечения это вполне подходит."

# ch/harems_full/bitchy/events.rpy:1885
translate russian bitchy_harem_foursome_nightclub_intro_e451fd97:
    "Но мы ведь собирались устроить полноценный секс вчетвером."

# ch/harems_full/bitchy/events.rpy:1889
translate russian bitchy_harem_foursome_nightclub_intro_0c8fbcbd:
    "Значит, кому-то придётся взять инициативу."

# ch/harems_full/bitchy/events.rpy:1894
translate russian bitchy_harem_foursome_nightclub_intro_e28ce0bb:
    "Когда всё заканчивается, мы откидываемся, тяжело дыша и пытаясь отдышаться."

# ch/harems_full/bitchy/events.rpy:1895
translate russian bitchy_harem_foursome_nightclub_intro_892d9a6b:
    "Но первой в реальность возвращается Кэссиди."

# ch/harems_full/bitchy/events.rpy:1897
translate russian bitchy_harem_foursome_nightclub_intro_9aa85180:
    cassidy.say "Всем одеваться! СЕЙЧАС ЖЕ!"

# ch/harems_full/bitchy/events.rpy:1898
translate russian bitchy_harem_foursome_nightclub_intro_4d0179e0:
    "Она начинает подбирать что попало из одежды и бросать нам."

# ch/harems_full/bitchy/events.rpy:1901
translate russian bitchy_harem_foursome_nightclub_intro_6051cfc0:
    "Одри и Паллу это заметно раздражает."

# ch/harems_full/bitchy/events.rpy:1902
translate russian bitchy_harem_foursome_nightclub_intro_1ee1bfd7:
    "А я не могу не посмеиваться над явной паникой Кэссиди."

# ch/harems_full/bitchy/events.rpy:1903
translate russian bitchy_harem_foursome_nightclub_intro_cc49dc06:
    audrey.say "Эй!"

# ch/harems_full/bitchy/events.rpy:1904
translate russian bitchy_harem_foursome_nightclub_intro_25ef4f4c:
    palla.say "Да, Кэссиди, какого чёрта?!"

# ch/harems_full/bitchy/events.rpy:1905
translate russian bitchy_harem_foursome_nightclub_intro_7c92e23b:
    mike.say "Что случилось, Кэссиди?"

# ch/harems_full/bitchy/events.rpy:1906
translate russian bitchy_harem_foursome_nightclub_intro_f9b89488:
    mike.say "Ты же сказала, что родители уехали."

# ch/harems_full/bitchy/events.rpy:1907
translate russian bitchy_harem_foursome_nightclub_intro_1a871644:
    cassidy.say "Нет, я сказала, что их сейчас нет."

# ch/harems_full/bitchy/events.rpy:1908
translate russian bitchy_harem_foursome_nightclub_intro_15691bea:
    cassidy.say "Но скоро будут!"

# ch/harems_full/bitchy/events.rpy:1913
translate russian bitchy_harem_foursome_nightclub_intro_679ed493:
    "Этого открытия достаточно, чтобы я вскочил и зашевелился."

# ch/harems_full/bitchy/events.rpy:1915
translate russian bitchy_harem_foursome_nightclub_intro_adaa691a:
    "В мгновение ока мы с Одри и Паллой одеты."

# ch/harems_full/bitchy/events.rpy:1917
translate russian bitchy_harem_foursome_nightclub_intro_82df233a:
    "И в рекордные сроки оказываемся за дверью в поисках такси."

# ch/harems_full/bitchy/events.rpy:1918
translate russian bitchy_harem_foursome_nightclub_intro_a69b78f3:
