    audrey.say "Я больше не могу..."

# ch/harems_full/bitchy/events.rpy:2402
translate russian bitchy_harem_foursome_219a6763:
    audrey.say "Сейчас кончу!"

# ch/harems_full/bitchy/events.rpy:2403
translate russian bitchy_harem_foursome_f0ed6330:
    mike.say "И не говори, Одри!"

# ch/harems_full/bitchy/events.rpy:2404
translate russian bitchy_harem_foursome_fa4d621f:
    mike.say "Я тоже..."

# ch/harems_full/bitchy/events.rpy:2407
translate russian bitchy_harem_foursome_e7b6c042_1:
