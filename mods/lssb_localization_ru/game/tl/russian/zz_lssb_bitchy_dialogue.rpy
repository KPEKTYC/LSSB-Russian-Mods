# ch/harems_full/bitchy/events.rpy:1826
translate russian bitchy_harem_foursome_nightclub_intro_b5e79ef7:
    mike.say "Э-э, девчонки..."

# ch/harems_full/bitchy/events.rpy:1827
translate russian bitchy_harem_foursome_nightclub_intro_d9f0358b:
    mike.say "Может, объявим перемирие?"

# ch/harems_full/bitchy/events.rpy:1828
translate russian bitchy_harem_foursome_nightclub_intro_b75c3557:
    cassidy.say "Вы вообще о чём?"

# ch/harems_full/bitchy/events.rpy:1831
translate russian bitchy_harem_foursome_nightclub_intro_75b0de23:
    cassidy.say "Я же говорила, это не мой дом."

# ch/harems_full/bitchy/events.rpy:1832
translate russian bitchy_harem_foursome_nightclub_intro_66f2952a:
    cassidy.say "Он принадлежит папе и мачехе!"

# ch/harems_full/bitchy/events.rpy:1833
translate russian bitchy_harem_foursome_nightclub_intro_69432e3b:
    "От одного упоминания родителей Кэссиди у меня волосы встают дыбом."

# ch/harems_full/bitchy/events.rpy:1834
translate russian bitchy_harem_foursome_nightclub_intro_497c13c5:
    "Я невольно оглядываюсь по сторонам, вдруг осознав, где мы."

# ch/harems_full/bitchy/events.rpy:1837
translate russian bitchy_harem_foursome_nightclub_intro_eaa04a58:
