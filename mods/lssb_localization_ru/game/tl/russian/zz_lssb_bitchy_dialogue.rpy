# ch/harems_full/bitchy/events.rpy:1822
translate russian bitchy_harem_foursome_nightclub_intro_0eee9c51:
    palla.say "Да..."

# ch/harems_full/bitchy/events.rpy:1823
translate russian bitchy_harem_foursome_nightclub_intro_6ea7e98e:
