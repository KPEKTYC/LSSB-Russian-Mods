# ch/harems_full/bitchy/events.rpy:1857
translate russian bitchy_harem_foursome_nightclub_intro_26d4092b:
    "Я почти боюсь к чему-либо прикоснуться, чтобы не сломать."

# ch/harems_full/bitchy/events.rpy:1858
translate russian bitchy_harem_foursome_nightclub_intro_4485850e:
