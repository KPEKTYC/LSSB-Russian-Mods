translate russian cassidy_palla_propose_male_0832f562:
    "Они так долго смотрят друг другу в глаза, что я уже не жду ничего хорошего."

# ch/harems_full/bitchy/events.rpy:3362
translate russian cassidy_palla_propose_male_7eadcd9a:
    "Но затем улыбаются и начинают кивать."

# ch/harems_full/bitchy/events.rpy:3363
translate russian cassidy_palla_propose_male_ace15370:
    palla.say "Конечно, я выйду за тебя, [lssb_common.hero_name()]."

# ch/harems_full/bitchy/events.rpy:3365
translate russian cassidy_palla_propose_male_6c947844:
    palla.say "Думал, я откажусь?"

# ch/harems_full/bitchy/events.rpy:3366
translate russian cassidy_palla_propose_male_58e0bfcf:
    cassidy.say "Я тоже, [lssb_common.hero_name()]!"

# ch/harems_full/bitchy/events.rpy:3368
translate russian cassidy_palla_propose_male_4e60c855:
    cassidy.say "Я ОЧЕНЬ хочу, чтобы ты стал моим мужем!"

# ch/harems_full/bitchy/events.rpy:3369
translate russian cassidy_palla_propose_male_3a8c28fa:
    "Они одновременно протягивают мне руки."

# ch/harems_full/bitchy/events.rpy:3370
translate russian cassidy_palla_propose_male_1f762ddf:
    "И я торопливо надеваю кольца им на пальцы."

# ch/harems_full/bitchy/events.rpy:3371
translate russian cassidy_palla_propose_male_ace9d7d3:
    "Кажется, будто всё это мне снится."

# ch/harems_full/bitchy/events.rpy:3372
translate russian cassidy_palla_propose_male_2970e0b1:
    "Будто я вот-вот проснусь и всё исчезнет."

# ch/harems_full/bitchy/events.rpy:3373
translate russian cassidy_palla_propose_male_26e03429:
    "Поднимаясь, я невольно качаю головой."

# ch/harems_full/bitchy/events.rpy:3374
translate russian cassidy_palla_propose_male_ba7f7e02:
    mike.say "Ого..."

# ch/harems_full/bitchy/events.rpy:3375
translate russian cassidy_palla_propose_male_6d40ad41:
    mike.say "Вы согласились!"

# ch/harems_full/bitchy/events.rpy:3376
translate russian cassidy_palla_propose_male_650553b0:
    mike.say "Вы обе согласились!"

# ch/harems_full/bitchy/events.rpy:3377
translate russian cassidy_palla_propose_male_6aa619ba:
    "Палла и Кэссиди смеются, понимающе переглядываясь."

# ch/harems_full/bitchy/events.rpy:3378
translate russian cassidy_palla_propose_male_28200073:
    cassidy.say "Ну конечно, [lssb_common.hero_name()]!"

# ch/harems_full/bitchy/events.rpy:3380
translate russian cassidy_palla_propose_male_a35ffd74:
    cassidy.say "Ты единственный мужчина, который обращается со мной как с принцессой даже лучше, чем папочка."

# ch/harems_full/bitchy/events.rpy:3381
translate russian cassidy_palla_propose_male_6ed311ca:
    cassidy.say "А когда мы вместе, я и вовсе чувствую себя королевой!"

# ch/harems_full/bitchy/events.rpy:3382
translate russian cassidy_palla_propose_male_ba0d0440:
    palla.say "Да, это правда."

# ch/harems_full/bitchy/events.rpy:3384
translate russian cassidy_palla_propose_male_25eabfe1:
    palla.say "Мы ещё и хорошо смотримся вместе."

# ch/harems_full/bitchy/events.rpy:3385
translate russian cassidy_palla_propose_male_ddb98768:
    palla.say "Благодаря мне ты теперь куда лучше одеваешься."

# ch/harems_full/bitchy/events.rpy:3386
translate russian cassidy_palla_propose_male_0a591f24:
    palla.say "Но всё же недостаточно хорошо, чтобы отвлекать внимание от меня."

# ch/harems_full/bitchy/events.rpy:3388
translate russian cassidy_palla_propose_male_b07789f4:
    mike.say "Спасибо, Палла... наверное..."

# ch/harems_full/bitchy/events.rpy:3389
translate russian cassidy_palla_propose_male_590823a0:
    "Я улыбаюсь и вскоре забываю об этом сомнительном комплименте."

# ch/harems_full/bitchy/events.rpy:3390
translate russian cassidy_palla_propose_male_84570695:
    "Думать могу лишь о том, что они согласились."

# ch/harems_full/bitchy/events.rpy:3391
translate russian cassidy_palla_propose_male_6010ed8b:
    "Это правда происходит — мы женимся!"

# ch/harems_full/bitchy/events.rpy:3395
translate russian cassidy_palla_propose_male_84a1a9cf:
    "Палла качает головой и заливается смехом."

# ch/harems_full/bitchy/events.rpy:3396
translate russian cassidy_palla_propose_male_78e3419f:
    palla.say "Да ладно вам!"

# ch/harems_full/bitchy/events.rpy:3398
translate russian cassidy_palla_propose_male_2bc03a7f:
    palla.say "Ты ведь не всерьёз?"

# ch/harems_full/bitchy/events.rpy:3399
translate russian cassidy_palla_propose_male_34326214:
    palla.say "Правда?"

# ch/harems_full/bitchy/events.rpy:3401
translate russian cassidy_palla_propose_male_870d0f97:
    mike.say "Вообще-то всерьёз!"

# ch/harems_full/bitchy/events.rpy:3402
translate russian cassidy_palla_propose_male_9a628f3c:
    "Не успеваю я сказать ни слова, как вмешивается Кэссиди."

# ch/harems_full/bitchy/events.rpy:3403
translate russian cassidy_palla_propose_male_e1ed032b:
    cassidy.say "Палла, ты о чём вообще?!"

# ch/harems_full/bitchy/events.rpy:3405
translate russian cassidy_palla_propose_male_2c08a93a:
    cassidy.say "Я хочу выйти за тебя, [lssb_common.hero_name()]!"

# ch/harems_full/bitchy/events.rpy:3407
translate russian cassidy_palla_propose_male_a35ffd74_1:
    cassidy.say "Ты единственный мужчина, который обращается со мной как с принцессой даже лучше, чем папочка."

# ch/harems_full/bitchy/events.rpy:3408
translate russian cassidy_palla_propose_male_6ed311ca_1:
    cassidy.say "А когда мы вместе, я и вовсе чувствую себя королевой!"

# ch/harems_full/bitchy/events.rpy:3409
translate russian cassidy_palla_propose_male_8ef85d45:
    "Я умоляюще смотрю на Паллу, надеясь, что она передумает."

# ch/harems_full/bitchy/events.rpy:3410
translate russian cassidy_palla_propose_male_a1a19d3c:
    "Но она лишь отворачивается и уходит."

# ch/harems_full/bitchy/events.rpy:3413
translate russian cassidy_palla_propose_male_b8582e82:
    "Я поднимаюсь и смотрю ей вслед."

# ch/harems_full/bitchy/events.rpy:3414
translate russian cassidy_palla_propose_male_2889e503:
    "Через мгновение Кэссиди отвлекает меня, почти бросаясь в мои объятия."

# ch/harems_full/bitchy/events.rpy:3415
translate russian cassidy_palla_propose_male_6d0b0678:
    "Она протягивает руку, и я торопливо надеваю кольцо ей на палец."

# ch/harems_full/bitchy/events.rpy:3416
translate russian cassidy_palla_propose_male_91196251:
    "Не представляю, что теперь будет у нас с Паллой."

# ch/harems_full/bitchy/events.rpy:3417
translate russian cassidy_palla_propose_male_1386c36b:
    "А пока мне остаётся лишь крепко обнять Кэссиди."

# ch/harems_full/bitchy/events.rpy:3422
translate russian cassidy_palla_propose_male_26f020f7:
    "Кэссиди морщит нос и качает головой."

# ch/harems_full/bitchy/events.rpy:3423
translate russian cassidy_palla_propose_male_93327b38:
    cassidy.say "[lssb_common.hero_name()], я слишком молода для замужества!"

# ch/harems_full/bitchy/events.rpy:3425
translate russian cassidy_palla_propose_male_46d166f2:
    cassidy.say "Женятся всякие старики."

# ch/harems_full/bitchy/events.rpy:3426
translate russian cassidy_palla_propose_male_bf286589:
    cassidy.say "Вроде моих родителей!"

# ch/harems_full/bitchy/events.rpy:3427
translate russian cassidy_palla_propose_male_0d1c0b1c:
    cassidy.say "Ты ведь не всерьёз?"

# ch/harems_full/bitchy/events.rpy:3428
translate russian cassidy_palla_propose_male_04d18d28:
    cassidy.say "Правда?"

# ch/harems_full/bitchy/events.rpy:3430
translate russian cassidy_palla_propose_male_870d0f97_1:
    mike.say "Вообще-то всерьёз!"

# ch/harems_full/bitchy/events.rpy:3431
translate russian cassidy_palla_propose_male_539ba091:
    "Не успеваю я сказать ни слова, как вмешивается Палла."

# ch/harems_full/bitchy/events.rpy:3432
translate russian cassidy_palla_propose_male_faf3ec4d:
    palla.say "А я хочу выйти за тебя, [lssb_common.hero_name()]."

# ch/harems_full/bitchy/events.rpy:3434
translate russian cassidy_palla_propose_male_9b446466:
    palla.say "Мы хорошо смотримся вместе."

# ch/harems_full/bitchy/events.rpy:3435
translate russian cassidy_palla_propose_male_ddb98768_1:
    palla.say "Благодаря мне ты теперь куда лучше одеваешься."

# ch/harems_full/bitchy/events.rpy:3436
translate russian cassidy_palla_propose_male_0a591f24_1:
    palla.say "Но всё же недостаточно хорошо, чтобы отвлекать внимание от меня."

# ch/harems_full/bitchy/events.rpy:3438
translate russian cassidy_palla_propose_male_b07789f4_1:
    mike.say "Спасибо, Палла... наверное..."

# ch/harems_full/bitchy/events.rpy:3439
translate russian cassidy_palla_propose_male_7c6e4ae2:
    "Я улыбаюсь в ответ на этот сомнительный комплимент."

# ch/harems_full/bitchy/events.rpy:3440
translate russian cassidy_palla_propose_male_9dd8cdfa:
    "Я умоляюще смотрю на Кэссиди, надеясь, что она передумает."

# ch/harems_full/bitchy/events.rpy:3441
translate russian cassidy_palla_propose_male_a1a19d3c_1:
    "Но она лишь отворачивается и уходит."

# ch/harems_full/bitchy/events.rpy:3444
translate russian cassidy_palla_propose_male_b8582e82_1:
    "Я поднимаюсь и смотрю ей вслед."

# ch/harems_full/bitchy/events.rpy:3445
translate russian cassidy_palla_propose_male_063d4708:
    "Через мгновение Палла отвлекает меня, обнимая."

# ch/harems_full/bitchy/events.rpy:3446
translate russian cassidy_palla_propose_male_6d0b0678_1:
    "Она протягивает руку, и я торопливо надеваю кольцо ей на палец."

# ch/harems_full/bitchy/events.rpy:3447
translate russian cassidy_palla_propose_male_b78ea138:
    "Не представляю, что теперь будет у нас с Кэссиди."

# ch/harems_full/bitchy/events.rpy:3448
translate russian cassidy_palla_propose_male_d85a16c2:
    "А пока мне остаётся лишь крепко обнять Паллу."

# ch/harems_full/bitchy/events.rpy:3453
translate russian cassidy_palla_propose_male_52fcad40:
    "Девушки одновременно качают головами и смеются."

# ch/harems_full/bitchy/events.rpy:3456
translate russian cassidy_palla_propose_male_4fd97e11:
    "Совсем не такой ответ я хотел услышать."

# ch/harems_full/bitchy/events.rpy:3457
translate russian cassidy_palla_propose_male_df9d1b5e:
    "Заметив моё разочарование, Кэссиди, кажется, немного тревожится."

# ch/harems_full/bitchy/events.rpy:3458
translate russian cassidy_palla_propose_male_5b4cbac9:
    "А Палла лишь закатывает глаза и презрительно фыркает."

# ch/harems_full/bitchy/events.rpy:3459
translate russian cassidy_palla_propose_male_78e3419f_1:
    palla.say "Да ладно вам!"

# ch/harems_full/bitchy/events.rpy:3461
translate russian cassidy_palla_propose_male_2bc03a7f_1:
    palla.say "Ты ведь не всерьёз?"

# ch/harems_full/bitchy/events.rpy:3462
translate russian cassidy_palla_propose_male_34326214_1:
    palla.say "Правда?"

# ch/harems_full/bitchy/events.rpy:3464
translate russian cassidy_palla_propose_male_870d0f97_2:
    mike.say "Вообще-то всерьёз!"

# ch/harems_full/bitchy/events.rpy:3465
translate russian cassidy_palla_propose_male_93327b38_1:
    cassidy.say "[lssb_common.hero_name()], я слишком молода для замужества!"

# ch/harems_full/bitchy/events.rpy:3467
translate russian cassidy_palla_propose_male_46d166f2_1:
    cassidy.say "Женятся всякие старики."

# ch/harems_full/bitchy/events.rpy:3468
translate russian cassidy_palla_propose_male_bf286589_1:
    cassidy.say "Вроде моих родителей!"

# ch/harems_full/bitchy/events.rpy:3469
translate russian cassidy_palla_propose_male_86395c41:
    "Я медленно поднимаюсь."

# ch/harems_full/bitchy/events.rpy:3470
translate russian cassidy_palla_propose_male_7127eeee:
    "И заодно убираю кольца."

# ch/harems_full/bitchy/events.rpy:3471
translate russian cassidy_palla_propose_male_5ffbec68:
    mike.say "Просто подумал, что нам так хорошо вместе, понимаете?"

# ch/harems_full/bitchy/events.rpy:3472
translate russian cassidy_palla_propose_male_d433afce:
    mike.say "Почему бы не оформить всё официально?"

# ch/harems_full/bitchy/events.rpy:3473
translate russian cassidy_palla_propose_male_02e5fdf6:
    "Палла и Кэссиди снова качают головами."

# ch/harems_full/bitchy/events.rpy:3474
translate russian cassidy_palla_propose_male_349dcb52:
    mike.say "То есть это отказ?"

# ch/harems_full/bitchy/events.rpy:3475
translate russian cassidy_palla_propose_male_46bfe9c6:
    "На этот раз они кивают."

# ch/harems_full/bitchy/events.rpy:3476
translate russian cassidy_palla_propose_male_13c899c3:
    "И я понимаю, что разговор окончен."

# ch/harems_full/bitchy/events.rpy:3490
translate russian audrey_cassidy_palla_male_ending_75f5b76c:
    "Знаю, что подумает большинство парней: ну и везучий же я сукин сын, да?"

# ch/harems_full/bitchy/events.rpy:3491
translate russian audrey_cassidy_palla_male_ending_aa2d4991:
    "Встречаюсь сразу с Одри, Кэссиди и Паллой, и им всё нравится."

# ch/harems_full/bitchy/events.rpy:3492
translate russian audrey_cassidy_palla_male_ending_8dbdd042:
    "А главное, мы все вот-вот поженимся."

# ch/harems_full/bitchy/events.rpy:3493
translate russian audrey_cassidy_palla_male_ending_f37ea9cd:
    "Но иногда мне кажется, что с ними тремя я только и делаю, что пытаюсь удержать всё на весу."

# ch/harems_full/bitchy/events.rpy:3494
translate russian audrey_cassidy_palla_male_ending_02ab0581:
    "У каждой высокие требования, и каждая хочет, чтобы ей угождали."

# ch/harems_full/bitchy/events.rpy:3495
translate russian audrey_cassidy_palla_male_ending_de8aa5c0:
    "И поскольку мужчина в этих отношениях только один, эта обязанность обычно достаётся мне."

# ch/harems_full/bitchy/events.rpy:3496
translate russian audrey_cassidy_palla_male_ending_2e43914c:
    "А теперь добавьте ко всему этому ещё и свадьбу!"

# ch/harems_full/bitchy/events.rpy:3497
translate russian audrey_cassidy_palla_male_ending_75aa5abd:
    "В ней всё до последней мелочи должно быть идеальным."

# ch/harems_full/bitchy/events.rpy:3498
translate russian audrey_cassidy_palla_male_ending_03640ffe:
    "И при этом угодить нужно трём совершенно разным невестам-тираншам!"

# ch/harems_full/bitchy/events.rpy:3499
translate russian audrey_cassidy_palla_male_ending_279e3dfa:
    "Поэтому к тому моменту, когда я наконец оказываюсь у алтаря, голова уже идёт кругом."

# ch/harems_full/bitchy/events.rpy:3500
translate russian audrey_cassidy_palla_male_ending_998742a9:
    "Я так поражён, что мы вообще сюда добрались, что мне кажется, будто это сон!"

# ch/harems_full/bitchy/events.rpy:3501
translate russian audrey_cassidy_palla_male_ending_53801559:
    "Оглядываюсь через плечо, чтобы вернуться к реальности."

# ch/harems_full/bitchy/events.rpy:3502
translate russian audrey_cassidy_palla_male_ending_97f95aa7:
    "И вижу позади своих друзей и родных."

# ch/harems_full/bitchy/events.rpy:3503
translate russian audrey_cassidy_palla_male_ending_26083823:
    "Их примерно столько же, сколько гостей Одри, и выглядят они столь же обычно."

# ch/harems_full/bitchy/events.rpy:3504
translate russian audrey_cassidy_palla_male_ending_b2043a3a:
    "А вот гостей Кэссиди я узнаю сразу."

# ch/harems_full/bitchy/events.rpy:3506
translate russian audrey_cassidy_palla_male_ending_7c023a1c:
    "Вижу Дуэйна, её отца и моего начальника."

# ch/harems_full/bitchy/events.rpy:3507
translate russian audrey_cassidy_palla_male_ending_5f2f0685:
    "Рядом с ним Шери, его жена и мачеха Кэссиди, — всё такая же красотка!"

# ch/harems_full/bitchy/events.rpy:3509
translate russian audrey_cassidy_palla_male_ending_1204ac58:
    "Вижу Шери, её мачеху, — всё такую же красотку!"

# ch/harems_full/bitchy/events.rpy:3510
translate russian audrey_cassidy_palla_male_ending_b69a0cf7:
    "Но сильнее всего выделяются гости Паллы."

# ch/harems_full/bitchy/events.rpy:3511
translate russian audrey_cassidy_palla_male_ending_a8aa99ab:
    "Чёрт возьми, они словно пришли на Неделю моды в Париже!"

# ch/harems_full/bitchy/events.rpy:3512
translate russian audrey_cassidy_palla_male_ending_d72891fc:
    "На их фоне я уже чувствую себя невзрачно одетым."

# ch/harems_full/bitchy/events.rpy:3513
translate russian audrey_cassidy_palla_male_ending_eb9922b9:
    "Машинально начинаю поправлять одежду."

# ch/harems_full/bitchy/events.rpy:3514
translate russian audrey_cassidy_palla_male_ending_5308f0f6:
    "Но тут звучит музыка, и я отвлекаюсь."

# ch/harems_full/bitchy/events.rpy:3519
translate russian audrey_cassidy_palla_male_ending_8f168cd8:
    "Наблюдаю, как в часовню входят Одри, Кэссиди и Палла."

# ch/harems_full/bitchy/events.rpy:3520
translate russian audrey_cassidy_palla_male_ending_daa95b20:
    "И невольно улыбаюсь: все трое идут в один ряд."

# ch/harems_full/bitchy/events.rpy:3521
translate russian audrey_cassidy_palla_male_ending_8f7ad9ce:
    "Можно было догадаться."

# ch/harems_full/bitchy/events.rpy:3522
translate russian audrey_cassidy_palla_male_ending_1cf4d2ed:
    "Ни одна ни за что не пропустила бы остальных вперёд!"

# ch/harems_full/bitchy/events.rpy:3523
translate russian audrey_cassidy_palla_male_ending_aa5e06ac:
    "Пока невесты идут к алтарю, я по очереди разглядываю каждую."

# ch/harems_full/bitchy/events.rpy:3524
translate russian audrey_cassidy_palla_male_ending_b2e0bb9b:
    "Вот Одри — такая же язвительная и колючая, как в день нашего знакомства на работе."

# ch/harems_full/bitchy/events.rpy:3525
translate russian audrey_cassidy_palla_male_ending_8066c59a:
    "А её платье заодно напоминает обо всех достоинствах её фигуры."

# ch/harems_full/bitchy/events.rpy:3527
translate russian audrey_cassidy_palla_male_ending_a482080e:
    "Кажется, даже свой беременный живот она выставляет напоказ как вызов."

# ch/harems_full/bitchy/events.rpy:3528
translate russian audrey_cassidy_palla_male_ending_0ba9e9f9:
    "Будто ей совершенно плевать, что о ней подумают."

# ch/harems_full/bitchy/events.rpy:3529
translate russian audrey_cassidy_palla_male_ending_de2acfea:
    "Кэссиди сейчас похожа на принцессу как никогда."

# ch/harems_full/bitchy/events.rpy:3530
translate russian audrey_cassidy_palla_male_ending_2fb2744a:
    "Словно она родилась, чтобы быть в центре внимания."

# ch/harems_full/bitchy/events.rpy:3532
translate russian audrey_cassidy_palla_male_ending_481fb0b6:
    "Даже заметная беременность, кажется, её совсем не смущает."

# ch/harems_full/bitchy/events.rpy:3533
translate russian audrey_cassidy_palla_male_ending_1c2f2ba3:
    "Она воспринимает всё как должное и счастливо улыбается."

# ch/harems_full/bitchy/events.rpy:3534
translate russian audrey_cassidy_palla_male_ending_5041d538:
    "Палла, конечно же, идёт так, будто вышла на подиум."

# ch/harems_full/bitchy/events.rpy:3535
translate russian audrey_cassidy_palla_male_ending_ddc70d88:
    "В каждом шаге — уверенность, а её платье само совершенство."

# ch/harems_full/bitchy/events.rpy:3537
translate russian audrey_cassidy_palla_male_ending_324a1536:
    "К тому же оно скроено с учётом её беременного живота."

# ch/harems_full/bitchy/events.rpy:3538
translate russian audrey_cassidy_palla_male_ending_bc2ca2bf:
    "Не то чтобы скрывает его, просто он не сразу бросается в глаза."

# ch/harems_full/bitchy/events.rpy:3539
translate russian audrey_cassidy_palla_male_ending_3f91ccbf:
    "Когда они подходят к алтарю, мы успеваем лишь улыбнуться друг другу."

# ch/harems_full/bitchy/events.rpy:3540
translate russian audrey_cassidy_palla_male_ending_e7388c18:
    "Ведь здесь у нас всё строго по расписанию."

# ch/harems_full/bitchy/events.rpy:3541
translate russian audrey_cassidy_palla_male_ending_b983abba:
    "Как-никак невест целых три!"

# ch/harems_full/bitchy/events.rpy:3546
translate russian audrey_cassidy_palla_male_ending_d601e095:
    "Священник" "Мы собрались здесь сегодня..."

# ch/harems_full/bitchy/events.rpy:3547
translate russian audrey_cassidy_palla_male_ending_1356f122:
    "Священник" "Чтобы соединить этих четверых священными узами брака."

# ch/harems_full/bitchy/events.rpy:3548
translate russian audrey_cassidy_palla_male_ending_1a604e14:
    "Мы столько раз репетировали церемонию, что я мог бы пройти её задом наперёд."

# ch/harems_full/bitchy/events.rpy:3549
translate russian audrey_cassidy_palla_male_ending_47be3eed:
    "И все четверо сразу откликаемся на первые слова священника."

# ch/harems_full/bitchy/events.rpy:3550
translate russian audrey_cassidy_palla_male_ending_9ad2c940:
    "Церемония пролетает незаметно, пока не наступает время клятв."

# ch/harems_full/bitchy/events.rpy:3551
translate russian audrey_cassidy_palla_male_ending_aa364aa8:
    "Священник" "Согласны ли вы, Одри..."

# ch/harems_full/bitchy/events.rpy:3552
translate russian audrey_cassidy_palla_male_ending_0d6d07d8:
    "Священник" "Взять этих людей..."

# ch/harems_full/bitchy/events.rpy:3553
translate russian audrey_cassidy_palla_male_ending_8c7361cd:
    "Священник" "В законные супруги?"

# ch/harems_full/bitchy/events.rpy:3555
translate russian audrey_cassidy_palla_male_ending_944edfac:
    audrey.say "Согласна."

# ch/harems_full/bitchy/events.rpy:3556
translate russian audrey_cassidy_palla_male_ending_dda31d6d:
    "Священник" "Согласны ли вы, Кэссиди..."

# ch/harems_full/bitchy/events.rpy:3557
translate russian audrey_cassidy_palla_male_ending_0d6d07d8_1:
    "Священник" "Взять этих людей..."

# ch/harems_full/bitchy/events.rpy:3558
translate russian audrey_cassidy_palla_male_ending_8c7361cd_1:
    "Священник" "В законные супруги?"

# ch/harems_full/bitchy/events.rpy:3560
translate russian audrey_cassidy_palla_male_ending_95766bb4:
    cassidy.say "Согласна."

# ch/harems_full/bitchy/events.rpy:3561
translate russian audrey_cassidy_palla_male_ending_b30b6a31:
    "Священник" "А вы, Палла, согласны..."

# ch/harems_full/bitchy/events.rpy:3562
translate russian audrey_cassidy_palla_male_ending_0d6d07d8_2:
    "Священник" "Взять этих людей..."

# ch/harems_full/bitchy/events.rpy:3563
translate russian audrey_cassidy_palla_male_ending_8c7361cd_2:
    "Священник" "В законные супруги?"

# ch/harems_full/bitchy/events.rpy:3565
translate russian audrey_cassidy_palla_male_ending_41c4547f:
    palla.say "Согласна."

# ch/harems_full/bitchy/events.rpy:3566
translate russian audrey_cassidy_palla_male_ending_f732b602:
    "Священник" "И наконец..."

# ch/harems_full/bitchy/events.rpy:3567
translate russian audrey_cassidy_palla_male_ending_70117281:
    "Священник" "Согласны ли вы, [lssb_common.hero_name()]..."

# ch/harems_full/bitchy/events.rpy:3568
translate russian audrey_cassidy_palla_male_ending_0d6d07d8_3:
    "Священник" "Взять этих людей..."

# ch/harems_full/bitchy/events.rpy:3569
translate russian audrey_cassidy_palla_male_ending_8c7361cd_3:
    "Священник" "В законные супруги?"

# ch/harems_full/bitchy/events.rpy:3570
translate russian audrey_cassidy_palla_male_ending_cc481164:
    mike.say "Согласен."

# ch/harems_full/bitchy/events.rpy:3571
translate russian audrey_cassidy_palla_male_ending_108a8344:
    "Священник" "Уф..."

# ch/harems_full/bitchy/events.rpy:3572
translate russian audrey_cassidy_palla_male_ending_3831da4f:
    "Священник" "Объявляю вас супругами."

# ch/harems_full/bitchy/events.rpy:3573
translate russian audrey_cassidy_palla_male_ending_41a204ee:
    "Священник" "Если кому-либо из присутствующих известны причины, по которым эти люди не могут вступить в брак..."

# ch/harems_full/bitchy/events.rpy:3574
translate russian audrey_cassidy_palla_male_ending_713d080b:
    "Священник" "Пусть скажет сейчас или молчит вечно!"

# ch/harems_full/bitchy/events.rpy:3575
translate russian audrey_cassidy_palla_male_ending_b6275cfb:
    "Следует обычная пауза, среди гостей раздаётся смех."

# ch/harems_full/bitchy/events.rpy:3576
translate russian audrey_cassidy_palla_male_ending_5ace7d26:
    "Но какая-то часть меня всерьёз боится, что кто-нибудь возразит."

# ch/harems_full/bitchy/events.rpy:3578
translate russian audrey_cassidy_palla_male_ending_31c19b55:
    "Мой взгляд невольно устремляется туда, где сидит Дуэйн."

# ch/harems_full/bitchy/events.rpy:3579
translate russian audrey_cassidy_palla_male_ending_31a92fd8:
    "К счастью, он, похоже, намерен помалкивать."

# ch/harems_full/bitchy/events.rpy:3580
translate russian audrey_cassidy_palla_male_ending_e524799f:
    "Священник" "Прекрасно."

# ch/harems_full/bitchy/events.rpy:3581
translate russian audrey_cassidy_palla_male_ending_83275ab6:
    "Священник" "Можете обменяться поцелуями."

# ch/harems_full/bitchy/events.rpy:3585
translate russian audrey_cassidy_palla_male_ending_0ed61245:
    "Мы следуем словам священника и нежно обнимаем друг друга."

# ch/harems_full/bitchy/events.rpy:3586
translate russian audrey_cassidy_palla_male_ending_d8d57218:
    "Сейчас все, кажется, счастливы и согласны друг с другом."

# ch/harems_full/bitchy/events.rpy:3587
translate russian audrey_cassidy_palla_male_ending_daa62f02:
    "Одному богу известно, сколько это продлится."

# ch/harems_full/bitchy/events.rpy:3588
translate russian audrey_cassidy_palla_male_ending_0c78cf57:
    "Но я буду наслаждаться каждым мгновением, пока есть возможность."

# ch/harems_full/bitchy/events.rpy:3593
translate russian audrey_cassidy_palla_male_ending_8eee000f:
    palla.say "Вам двоим совсем не обязательно здесь находиться."

# ch/harems_full/bitchy/events.rpy:3594
translate russian audrey_cassidy_palla_male_ending_62ae6e2e:
    palla.say "Думаю, я могу выступить от лица всех."

# ch/harems_full/bitchy/events.rpy:3595
translate russian audrey_cassidy_palla_male_ending_f8d2cac1:
    cassidy.say "Да неужели, Палла?"

# ch/harems_full/bitchy/events.rpy:3596
translate russian audrey_cassidy_palla_male_ending_6c5b76da:
    cassidy.say "Умеешь ходить по подиуму — ещё не значит, что справишься с этим!"

# ch/harems_full/bitchy/events.rpy:3597
translate russian audrey_cassidy_palla_male_ending_f191a6fc:
    audrey.say "А по-твоему, Кэссиди, нам лучше поручить всё тебе?"

# ch/harems_full/bitchy/events.rpy:3598
translate russian audrey_cassidy_palla_male_ending_af97d6f2:
    audrey.say "Я так не думаю!"

# ch/harems_full/bitchy/events.rpy:3599
translate russian audrey_cassidy_palla_male_ending_f112b478:
    cassidy.say "Ладно, ладно..."

# ch/harems_full/bitchy/events.rpy:3600
translate russian audrey_cassidy_palla_male_ending_c7d2b8e3:
    cassidy.say "Тайм-аут, девочки!"

# ch/harems_full/bitchy/events.rpy:3601
translate russian audrey_cassidy_palla_male_ending_5f9627e0:
    cassidy.say "При [lssb_common.hero_name()] вы бы так себя не вели..."

# ch/harems_full/bitchy/events.rpy:3602
translate russian audrey_cassidy_palla_male_ending_9532023c:
    palla.say "Уф..."

# ch/harems_full/bitchy/events.rpy:3603
translate russian audrey_cassidy_palla_male_ending_bc6d3538:
    palla.say "Не хочется это признавать, Одри."

# ch/harems_full/bitchy/events.rpy:3604
translate russian audrey_cassidy_palla_male_ending_e9f8f401:
    palla.say "Но Кэссиди права."

# ch/harems_full/bitchy/events.rpy:3605
translate russian audrey_cassidy_palla_male_ending_b8bbcdff:
    audrey.say "Знаю, знаю..."

# ch/harems_full/bitchy/events.rpy:3606
translate russian audrey_cassidy_palla_male_ending_9e70460c:
    audrey.say "Меня это тоже бесит."

# ch/harems_full/bitchy/events.rpy:3607
translate russian audrey_cassidy_palla_male_ending_dcc96641:
    audrey.say "И как ему это удаётся?!"

# ch/harems_full/bitchy/events.rpy:3608
translate russian audrey_cassidy_palla_male_ending_922d51c0:
    cassidy.say "Разве не очевидно?"

# ch/harems_full/bitchy/events.rpy:3609
translate russian audrey_cassidy_palla_male_ending_39c4c29f:
    cassidy.say "С ним каждая из нас становится лучше!"

# ch/harems_full/bitchy/events.rpy:3610
translate russian audrey_cassidy_palla_male_ending_fba25947:
    cassidy.say "Он нас всех объединяет!"

# ch/harems_full/bitchy/events.rpy:3611
translate russian audrey_cassidy_palla_male_ending_0036caf2:
    audrey.say "Фу!"

# ch/harems_full/bitchy/events.rpy:3612
translate russian audrey_cassidy_palla_male_ending_b20ee14c:
    palla.say "Она опять права, Одри."

# ch/harems_full/bitchy/events.rpy:3613
translate russian audrey_cassidy_palla_male_ending_d8575c62:
    palla.say "Раньше я думала только о том, как стать успешной моделью."

# ch/harems_full/bitchy/events.rpy:3614
translate russian audrey_cassidy_palla_male_ending_3bbccbc8:
    palla.say "Но с тех пор как в моей жизни появился [lssb_common.hero_name()], я понимаю, что есть вещи поважнее."

# ch/harems_full/bitchy/events.rpy:3615
translate russian audrey_cassidy_palla_male_ending_e5640023:
    cassidy.say "Я тоже — благодаря ему я думаю обо всех вас."

# ch/harems_full/bitchy/events.rpy:3616
translate russian audrey_cassidy_palla_male_ending_05e2a3a1:
    cassidy.say "Мы словно настоящая семья!"

# ch/harems_full/bitchy/events.rpy:3617
translate russian audrey_cassidy_palla_male_ending_e160d18f:
    audrey.say "О боже..."

# ch/harems_full/bitchy/events.rpy:3618
translate russian audrey_cassidy_palla_male_ending_8c623d36:
    audrey.say "Я стала воплощением всего, что раньше ненавидела!"

# ch/harems_full/bitchy/events.rpy:3619
translate russian audrey_cassidy_palla_male_ending_e10bf568:
    audrey.say "У меня отношения, полные любви, и с каждым днём они всё лучше!"

# ch/harems_full/bitchy/events.rpy:3620
translate russian audrey_cassidy_palla_male_ending_5ffaff28:
    cassidy.say "Ха-ха!"

# ch/harems_full/bitchy/events.rpy:3621
translate russian audrey_cassidy_palla_male_ending_c6c790c8:
    cassidy.say "Ты ведь знаешь, что любишь нас, Одри!"

# ch/harems_full/bitchy/events.rpy:3622
translate russian audrey_cassidy_palla_male_ending_782fc2f5:
    palla.say "Ага!"

# ch/harems_full/bitchy/events.rpy:3623
translate russian audrey_cassidy_palla_male_ending_c473f58b:
    palla.say "Теперь нам друг от друга никуда не деться!"

# ch/harems_full/bitchy/events.rpy:3625
translate russian audrey_cassidy_palla_male_ending_e9aba89e:
    audrey.say "Ну, [lssb_common.hero_name()], пожалуй, хороший отец."

# ch/harems_full/bitchy/events.rpy:3626
translate russian audrey_cassidy_palla_male_ending_f05630cc:
    audrey.say "И маленький Ли обожает своего папу."

# ch/harems_full/bitchy/events.rpy:3628
translate russian audrey_cassidy_palla_male_ending_4913cb7d:
    cassidy.say "[lssb_common.hero_name()] души не чает в Софии."

# ch/harems_full/bitchy/events.rpy:3629
translate russian audrey_cassidy_palla_male_ending_c3905b8c:
    cassidy.say "Он для меня такой замечательный папочка..."

# ch/harems_full/bitchy/events.rpy:3630
translate russian audrey_cassidy_palla_male_ending_fe7c6a0a:
    cassidy.say "Для них! То есть для них!"

# ch/harems_full/bitchy/events.rpy:3632
translate russian audrey_cassidy_palla_male_ending_468f4753:
    palla.say "Без [lssb_common.hero_name()] я бы точно не родила Мэри."

# ch/harems_full/bitchy/events.rpy:3633
translate russian audrey_cassidy_palla_male_ending_db6e8ed8:
    palla.say "И она для меня значит куда больше, чем когда-либо значила карьера."

# ch/harems_full/bitchy/events.rpy:3634
translate russian audrey_cassidy_palla_male_ending_58ce0261:
    cassidy.say "И давайте признаем, девочки..."

# ch/harems_full/bitchy/events.rpy:3635
translate russian audrey_cassidy_palla_male_ending_a6f534fd:
    cassidy.say "[lssb_common.hero_name()] тоже в нас нуждается!"

# ch/harems_full/bitchy/events.rpy:3636
translate russian audrey_cassidy_palla_male_ending_8e046b42:
    audrey.say "Вот уж точно!"

# ch/harems_full/bitchy/events.rpy:3637
translate russian audrey_cassidy_palla_male_ending_b0a8bc82:
    audrey.say "Без нас он бы совсем распустился: мы держим его в тонусе."

# ch/harems_full/bitchy/events.rpy:3638
translate russian audrey_cassidy_palla_male_ending_95ea3639:
    cassidy.say "Совсем беспомощный неряха."

# ch/harems_full/bitchy/events.rpy:3639
translate russian audrey_cassidy_palla_male_ending_2b6329e0:
    cassidy.say "Иногда мне даже приходится выбирать ему одежду!"

# ch/harems_full/bitchy/events.rpy:3640
translate russian audrey_cassidy_palla_male_ending_8ba9e2fa:
    audrey.say "Давайте признаем, девочки..."

# ch/harems_full/bitchy/events.rpy:3641
translate russian audrey_cassidy_palla_male_ending_ec7c090e:
    audrey.say "[lssb_common.hero_name()] — отличный парень."

# ch/harems_full/bitchy/events.rpy:3642
translate russian audrey_cassidy_palla_male_ending_fceac138:
    audrey.say "Но ему повезло, что у него есть мы трое."

# ch/harems_full/bitchy/events.rpy:3643
translate russian audrey_cassidy_palla_male_ending_0b4c459e:
    audrey.say "Потому что мы лучше него самого знаем, что ему нужно!"

# ch/harems_full/bitchy/events.rpy:3654
translate russian audrey_palla_male_ending_85c09cd6:
    "Забавно: два вещества по отдельности могут быть совершенно безопасны."

# ch/harems_full/bitchy/events.rpy:3655
translate russian audrey_palla_male_ending_68cafa2a:
    "А стоит смешать — и всё взорвётся прямо у тебя перед носом!"

# ch/harems_full/bitchy/events.rpy:3656
translate russian audrey_palla_male_ending_4c18acae:
    "Примерно так и обстоят дела с Одри и Паллой!"

# ch/harems_full/bitchy/events.rpy:3657
translate russian audrey_palla_male_ending_b6171a12:
    "Нет-нет... Погодите, не совсем так."

# ch/harems_full/bitchy/events.rpy:3658
translate russian audrey_palla_male_ending_8bc5e327:
    "Они и поодиночке довольно взрывоопасны!"

# ch/harems_full/bitchy/events.rpy:3659
translate russian audrey_palla_male_ending_1d20a475:
    "Скорее уж вместе динамит превращается в атомную бомбу!"

# ch/harems_full/bitchy/events.rpy:3660
translate russian audrey_palla_male_ending_0ea7d7f6:
    "Какая-то часть меня не верила, что мы зайдём так далеко."

# ch/harems_full/bitchy/events.rpy:3661
translate russian audrey_palla_male_ending_96787213:
    "Что я действительно буду стоять у алтаря и ждать их обеих."

# ch/harems_full/bitchy/events.rpy:3662
translate russian audrey_palla_male_ending_156902ee:
    "И поверьте, готовиться пришлось долго."

# ch/harems_full/bitchy/events.rpy:3663
translate russian audrey_palla_male_ending_b144d60b:
    "Для такой взыскательной девушки, как Палла, всё должно быть безупречно."

# ch/harems_full/bitchy/events.rpy:3664
translate russian audrey_palla_male_ending_568ee816:
    "А Одри на каждом шагу отпускала колкости и провоцировала ссоры!"

# ch/harems_full/bitchy/events.rpy:3665
translate russian audrey_palla_male_ending_5accb4f7:
    "Но вот великий день настал, а я всё оглядываюсь через плечо."

# ch/harems_full/bitchy/events.rpy:3666
translate russian audrey_palla_male_ending_6e07eed7:
    "Вижу в часовне своих друзей и родных."

# ch/harems_full/bitchy/events.rpy:3667
translate russian audrey_palla_male_ending_03ef2e5a:
    "Попадается и немало знакомых лиц с работы."

# ch/harems_full/bitchy/events.rpy:3668
translate russian audrey_palla_male_ending_abf78d77:
    "Полагаю, все эти до неприличия модные люди пришли со стороны Паллы."

# ch/harems_full/bitchy/events.rpy:3669
translate russian audrey_palla_male_ending_bccdca69:
    "Уж очень серьёзно они, судя по всему, относятся к своему стилю!"

# ch/harems_full/bitchy/events.rpy:3670
translate russian audrey_palla_male_ending_135a341d:
    "Я собираюсь присмотреться к некоторым из них."

# ch/harems_full/bitchy/events.rpy:3671
translate russian audrey_palla_male_ending_960ee510:
    "Но в этот момент начинает играть музыка."

# ch/harems_full/bitchy/events.rpy:3672
translate russian audrey_palla_male_ending_192a7840:
    "И все поворачиваются к входу в часовню."

# ch/harems_full/bitchy/events.rpy:3674
translate russian audrey_palla_male_ending_b2e0bb9b:
    "Вот Одри — такая же язвительная и колючая, как в день нашего знакомства на работе."

# ch/harems_full/bitchy/events.rpy:3675
translate russian audrey_palla_male_ending_8066c59a:
    "А её платье заодно напоминает обо всех достоинствах её фигуры."

# ch/harems_full/bitchy/events.rpy:3677
translate russian audrey_palla_male_ending_a482080e:
    "Кажется, даже свой беременный живот она выставляет напоказ как вызов."

# ch/harems_full/bitchy/events.rpy:3678
translate russian audrey_palla_male_ending_0ba9e9f9:
    "Будто ей совершенно плевать, что о ней подумают."

# ch/harems_full/bitchy/events.rpy:3679
translate russian audrey_palla_male_ending_5041d538:
    "Палла, конечно же, идёт так, будто вышла на подиум."

# ch/harems_full/bitchy/events.rpy:3681
translate russian audrey_palla_male_ending_ddc70d88:
    "В каждом шаге — уверенность, а её платье само совершенство."

# ch/harems_full/bitchy/events.rpy:3683
translate russian audrey_palla_male_ending_324a1536:
    "К тому же оно скроено с учётом её беременного живота."

# ch/harems_full/bitchy/events.rpy:3684
translate russian audrey_palla_male_ending_bc2ca2bf:
    "Не то чтобы скрывает его, просто он не сразу бросается в глаза."

# ch/harems_full/bitchy/events.rpy:3685
translate russian audrey_palla_male_ending_3f91ccbf:
    "Когда они подходят к алтарю, мы успеваем лишь улыбнуться друг другу."

# ch/harems_full/bitchy/events.rpy:3686
translate russian audrey_palla_male_ending_e7388c18:
    "Ведь здесь у нас всё строго по расписанию."

# ch/harems_full/bitchy/events.rpy:3687
translate russian audrey_palla_male_ending_474143be:
    "Как-никак невест целых две!"

# ch/harems_full/bitchy/events.rpy:3691
translate russian audrey_palla_male_ending_d601e095:
    "Священник" "Мы собрались здесь сегодня..."

# ch/harems_full/bitchy/events.rpy:3692
translate russian audrey_palla_male_ending_c8700efd:
    "Священник" "Чтобы соединить этих троих священными узами брака."

# ch/harems_full/bitchy/events.rpy:3693
translate russian audrey_palla_male_ending_1a604e14:
    "Мы столько раз репетировали церемонию, что я мог бы пройти её задом наперёд."

# ch/harems_full/bitchy/events.rpy:3694
translate russian audrey_palla_male_ending_f9549be5:
    "И все трое сразу откликаемся на первые слова священника."

# ch/harems_full/bitchy/events.rpy:3695
translate russian audrey_palla_male_ending_9ad2c940:
    "Церемония пролетает незаметно, пока не наступает время клятв."

# ch/harems_full/bitchy/events.rpy:3696
translate russian audrey_palla_male_ending_aa364aa8:
    "Священник" "Согласны ли вы, Одри..."

# ch/harems_full/bitchy/events.rpy:3697
translate russian audrey_palla_male_ending_0d6d07d8:
    "Священник" "Взять этих людей..."

# ch/harems_full/bitchy/events.rpy:3698
translate russian audrey_palla_male_ending_8c7361cd:
    "Священник" "В законные супруги?"

# ch/harems_full/bitchy/events.rpy:3699
translate russian audrey_palla_male_ending_944edfac:
    audrey.say "Согласна."

# ch/harems_full/bitchy/events.rpy:3701
translate russian audrey_palla_male_ending_b30b6a31:
    "Священник" "А вы, Палла, согласны..."

# ch/harems_full/bitchy/events.rpy:3702
translate russian audrey_palla_male_ending_0d6d07d8_1:
    "Священник" "Взять этих людей..."

# ch/harems_full/bitchy/events.rpy:3703
translate russian audrey_palla_male_ending_8c7361cd_1:
    "Священник" "В законные супруги?"

# ch/harems_full/bitchy/events.rpy:3704
translate russian audrey_palla_male_ending_41c4547f:
    palla.say "Согласна."

# ch/harems_full/bitchy/events.rpy:3706
translate russian audrey_palla_male_ending_f732b602:
    "Священник" "И наконец..."

# ch/harems_full/bitchy/events.rpy:3707
translate russian audrey_palla_male_ending_70117281:
    "Священник" "Согласны ли вы, [lssb_common.hero_name()]..."

# ch/harems_full/bitchy/events.rpy:3708
translate russian audrey_palla_male_ending_0d6d07d8_2:
    "Священник" "Взять этих людей..."

# ch/harems_full/bitchy/events.rpy:3709
translate russian audrey_palla_male_ending_8c7361cd_2:
    "Священник" "В законные супруги?"

# ch/harems_full/bitchy/events.rpy:3710
translate russian audrey_palla_male_ending_cc481164:
    mike.say "Согласен."

# ch/harems_full/bitchy/events.rpy:3711
translate russian audrey_palla_male_ending_3831da4f:
    "Священник" "Объявляю вас супругами."

# ch/harems_full/bitchy/events.rpy:3712
translate russian audrey_palla_male_ending_41a204ee:
    "Священник" "Если кому-либо из присутствующих известны причины, по которым эти люди не могут вступить в брак..."

# ch/harems_full/bitchy/events.rpy:3713
translate russian audrey_palla_male_ending_713d080b:
    "Священник" "Пусть скажет сейчас или молчит вечно!"

# ch/harems_full/bitchy/events.rpy:3714
translate russian audrey_palla_male_ending_b6275cfb:
    "Следует обычная пауза, среди гостей раздаётся смех."

# ch/harems_full/bitchy/events.rpy:3715
translate russian audrey_palla_male_ending_5ace7d26:
    "Но какая-то часть меня всерьёз боится, что кто-нибудь возразит."

# ch/harems_full/bitchy/events.rpy:3716
translate russian audrey_palla_male_ending_ae83ddf3:
    "К счастью, все молчат."

# ch/harems_full/bitchy/events.rpy:3717
translate russian audrey_palla_male_ending_e524799f:
    "Священник" "Прекрасно."

# ch/harems_full/bitchy/events.rpy:3718
translate russian audrey_palla_male_ending_83275ab6:
    "Священник" "Можете обменяться поцелуями."

# ch/harems_full/bitchy/events.rpy:3721
translate russian audrey_palla_male_ending_0ed61245:
    "Мы следуем словам священника и нежно обнимаем друг друга."

# ch/harems_full/bitchy/events.rpy:3722
translate russian audrey_palla_male_ending_d8d57218:
    "Сейчас все, кажется, счастливы и согласны друг с другом."

# ch/harems_full/bitchy/events.rpy:3723
translate russian audrey_palla_male_ending_daa62f02:
    "Одному богу известно, сколько это продлится."

# ch/harems_full/bitchy/events.rpy:3724
translate russian audrey_palla_male_ending_0c78cf57:
    "Но я буду наслаждаться каждым мгновением, пока есть возможность."

# ch/harems_full/bitchy/events.rpy:3729
translate russian audrey_palla_male_ending_f81c2a44:
    audrey.say "Не-а, тебе не обязательно в это вмешиваться, Палла."

# ch/harems_full/bitchy/events.rpy:3730
translate russian audrey_palla_male_ending_31daed61:
    audrey.say "Просто оставь всё мне, ладно?"

# ch/harems_full/bitchy/events.rpy:3731
translate russian audrey_palla_male_ending_67647fc5:
    palla.say "О чём ты, Одри?"

# ch/harems_full/bitchy/events.rpy:3732
translate russian audrey_palla_male_ending_2993819e:
    palla.say "Мы же обе должны рассказать, каково жить с [lssb_common.hero_name()]!"

# ch/harems_full/bitchy/events.rpy:3733
translate russian audrey_palla_male_ending_90cc79b7:
    audrey.say "Да, я знаю..."

# ch/harems_full/bitchy/events.rpy:3734
translate russian audrey_palla_male_ending_0b5801dc:
    audrey.say "Но обычно говорю в основном я, правда?"

# ch/harems_full/bitchy/events.rpy:3735
translate russian audrey_palla_male_ending_c01d6863:
    audrey.say "А ты вроде как профессиональный манекен, да?"

# ch/harems_full/bitchy/events.rpy:3736
translate russian audrey_palla_male_ending_fadce551:
    audrey.say "Ну, знаешь, пустышка?"

# ch/harems_full/bitchy/events.rpy:3737
translate russian audrey_palla_male_ending_71a02bed:
    palla.say "ЭЙ!"

# ch/harems_full/bitchy/events.rpy:3738
translate russian audrey_palla_male_ending_a8699fef:
    palla.say "Ты обещала больше меня так не называть!"

# ch/harems_full/bitchy/events.rpy:3739
translate russian audrey_palla_male_ending_f166e503:
    audrey.say "Как скажешь, Палла."

# ch/harems_full/bitchy/events.rpy:3740
translate russian audrey_palla_male_ending_368f81de:
    audrey.say "Но согласись, если взять тебя и [lssb_common.hero_name()]..."

# ch/harems_full/bitchy/events.rpy:3741
translate russian audrey_palla_male_ending_b534ed8e:
    audrey.say "То мозг нашей компании — всё-таки я!"

# ch/harems_full/bitchy/events.rpy:3742
translate russian audrey_palla_male_ending_426a75ea:
    palla.say "Скорее задница, Одри!"

# ch/harems_full/bitchy/events.rpy:3743
translate russian audrey_palla_male_ending_2902a7f8:
    audrey.say "Ай!"

# ch/harems_full/bitchy/events.rpy:3744
translate russian audrey_palla_male_ending_10daafe2:
    audrey.say "Кому-то пора налить молочка в блюдце, Палла!"

# ch/harems_full/bitchy/events.rpy:3745
translate russian audrey_palla_male_ending_9532023c:
    palla.say "Уф..."

# ch/harems_full/bitchy/events.rpy:3746
translate russian audrey_palla_male_ending_c6f768f4:
    palla.say "Ты всегда такая, когда [lssb_common.hero_name()] нет рядом!"

# ch/harems_full/bitchy/events.rpy:3747
translate russian audrey_palla_male_ending_c90d1d75:
    audrey.say "На себя посмотри!"

# ch/harems_full/bitchy/events.rpy:3748
translate russian audrey_palla_male_ending_7cd6dda3:
    palla.say "Нет, Одри, я серьёзно."

# ch/harems_full/bitchy/events.rpy:3749
translate russian audrey_palla_male_ending_57d87080:
    palla.say "Он словно держит нас обеих в узде — в хорошем смысле!"

# ch/harems_full/bitchy/events.rpy:3750
translate russian audrey_palla_male_ending_25adb6a5:
    audrey.say "Да-да..."

# ch/harems_full/bitchy/events.rpy:3751
translate russian audrey_palla_male_ending_d3c62cac:
    audrey.say "Что-то в этом есть."

# ch/harems_full/bitchy/events.rpy:3752
translate russian audrey_palla_male_ending_8fbbfb32:
    audrey.say "Наверное, рядом с ним я и правда спокойнее."

# ch/harems_full/bitchy/events.rpy:3753
translate russian audrey_palla_male_ending_fc52fcaa:
    palla.say "Вот и я о том же."

# ch/harems_full/bitchy/events.rpy:3754
translate russian audrey_palla_male_ending_3da46653:
    palla.say "Мне тоже не хочется это признавать."

# ch/harems_full/bitchy/events.rpy:3755
translate russian audrey_palla_male_ending_0961e444:
    palla.say "Но благодаря ему мы становимся лучше."

# ch/harems_full/bitchy/events.rpy:3756
translate russian audrey_palla_male_ending_91da2a79:
    audrey.say "Ага..."

# ch/harems_full/bitchy/events.rpy:3757
translate russian audrey_palla_male_ending_615dd9cb:
    audrey.say "Так бесит."

# ch/harems_full/bitchy/events.rpy:3758
translate russian audrey_palla_male_ending_a861ca98:
    audrey.say "Ненавижу в нём это!"

# ch/harems_full/bitchy/events.rpy:3759
translate russian audrey_palla_male_ending_6573f2e5:
    palla.say "До встречи с ним я даже представить не могла, что выйду замуж."

# ch/harems_full/bitchy/events.rpy:3760
translate russian audrey_palla_male_ending_730660ed:
    audrey.say "Не-а, я тоже."

# ch/harems_full/bitchy/events.rpy:3761
translate russian audrey_palla_male_ending_dd730a9a:
    audrey.say "Особенно за такую, как ты!"

# ch/harems_full/bitchy/events.rpy:3762
translate russian audrey_palla_male_ending_095586f9:
    palla.say "Спасибо, Одри, это взаимно!"

# ch/harems_full/bitchy/events.rpy:3763
translate russian audrey_palla_male_ending_5126ad62:
    palla.say "Но ему каким-то образом удаётся делать нас семьёй."

# ch/harems_full/bitchy/events.rpy:3765
translate russian audrey_palla_male_ending_e9aba89e:
    audrey.say "Ну, [lssb_common.hero_name()], пожалуй, хороший отец."

# ch/harems_full/bitchy/events.rpy:3766
translate russian audrey_palla_male_ending_368413a6:
    audrey.say "И маленький Томми обожает своего папу."

# ch/harems_full/bitchy/events.rpy:3768
translate russian audrey_palla_male_ending_468f4753:
    palla.say "Без [lssb_common.hero_name()] я бы точно не родила Мэри."

# ch/harems_full/bitchy/events.rpy:3769
translate russian audrey_palla_male_ending_db6e8ed8:
    palla.say "И она для меня значит куда больше, чем когда-либо значила карьера."

# ch/harems_full/bitchy/events.rpy:3771
translate russian audrey_palla_male_ending_a462c473:
    audrey.say "Палла..."

# ch/harems_full/bitchy/events.rpy:3772
translate russian audrey_palla_male_ending_37c5da2e:
    audrey.say "А ты..."

# ch/harems_full/bitchy/events.rpy:3773
translate russian audrey_palla_male_ending_415455b7:
    palla.say "Да говори уже, Одри!"

# ch/harems_full/bitchy/events.rpy:3774
translate russian audrey_palla_male_ending_e7638100:
    audrey.say "Ты думаешь о том, чтобы родить от него детей?"

# ch/harems_full/bitchy/events.rpy:3775
translate russian audrey_palla_male_ending_a0469727:
    palla.say "Ты тоже, да?"

# ch/harems_full/bitchy/events.rpy:3776
translate russian audrey_palla_male_ending_9b1fe580:
    palla.say "Да, Одри, постоянно!"

# ch/harems_full/bitchy/events.rpy:3777
translate russian audrey_palla_male_ending_b35c2863:
    audrey.say "Значит, мы согласны?"

# ch/harems_full/bitchy/events.rpy:3778
translate russian audrey_palla_male_ending_deb6d23b:
    audrey.say "[lssb_common.hero_name()] — практически идеальный муж."

# ch/harems_full/bitchy/events.rpy:3779
translate russian audrey_palla_male_ending_5f9b1688:
    audrey.say "И он сделал нас обеих до отвращения счастливыми."

# ch/harems_full/bitchy/events.rpy:3780
translate russian audrey_palla_male_ending_c3468ac4:
    palla.say "На все сто."

# ch/harems_full/bitchy/events.rpy:3781
translate russian audrey_palla_male_ending_26978c12:
    palla.say "И ещё кое-что, даже важнее."

# ch/harems_full/bitchy/events.rpy:3782
translate russian audrey_palla_male_ending_b6c5ed63:
    audrey.say "Да?"

# ch/harems_full/bitchy/events.rpy:3783
translate russian audrey_palla_male_ending_b7a848c1:
    palla.say "Ни при каких обстоятельствах он не должен об этом узнать."

# ch/harems_full/bitchy/events.rpy:3784
translate russian audrey_palla_male_ending_b2cb0817:
    palla.say "Договорились?"

# ch/harems_full/bitchy/events.rpy:3785
translate russian audrey_palla_male_ending_73b20940:
    audrey.say "Договорились!"
