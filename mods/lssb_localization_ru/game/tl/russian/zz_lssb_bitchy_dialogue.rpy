# ch/harems_full/bitchy/events.rpy:1776
translate russian bitchy_harem_nightclub_encounter_4ca52061:
    mike.say "Тем более когда мы все хотим одного и того же!"

# ch/harems_full/bitchy/events.rpy:1779
translate russian bitchy_harem_nightclub_encounter_51e2439b:
    "В ответ девушки пожимают плечами и кивают."

# ch/harems_full/bitchy/events.rpy:1780
translate russian bitchy_harem_nightclub_encounter_4320c374:
