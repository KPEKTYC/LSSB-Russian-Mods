# ch/harems_full/bitchy/events.rpy:2260
translate russian bitchy_harem_foursome_89e7a367:
    "Едва Одри поворачивается ко мне, я действую."

# ch/harems_full/bitchy/events.rpy:2261
translate russian bitchy_harem_foursome_af5af8e6:
