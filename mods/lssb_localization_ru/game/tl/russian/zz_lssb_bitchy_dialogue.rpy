translate russian audrey_cassidy_propose_male_283cc2de:
    "Именно поэтому я опустошил свои сбережения ради двух одинаковых колец, которые сейчас лежат у меня в кармане."

# ch/harems_full/bitchy/events.rpy:3042
translate russian audrey_cassidy_propose_male_d115b19a:
    "Как только представится подходящий момент, я сделаю предложение."

# ch/harems_full/bitchy/events.rpy:3043
translate russian audrey_cassidy_propose_male_4692ea1d:
    "Остаётся лишь дождаться..."

# ch/harems_full/bitchy/events.rpy:3045
translate russian audrey_cassidy_propose_male_f8f41615:
    audrey.say "Кэссиди, ты хоть раз в жизни за что-нибудь платила сама?"

# ch/harems_full/bitchy/events.rpy:3046
translate russian audrey_cassidy_propose_male_b7286c7a:
    audrey.say "Или за всё твоё барахло всегда платит папочка?"

# ch/harems_full/bitchy/events.rpy:3048
translate russian audrey_cassidy_propose_male_165a4847:
    cassidy.say "Уф..."

# ch/harems_full/bitchy/events.rpy:3049
translate russian audrey_cassidy_propose_male_edf2cd37:
    cassidy.say "Ты сноб, Одри, только наоборот: презираешь богатых!"

# ch/harems_full/bitchy/events.rpy:3050
translate russian audrey_cassidy_propose_male_69189de9:
    cassidy.say "Скажи ей, [lssb_common.hero_name()], пусть замолчит!"

# ch/harems_full/bitchy/events.rpy:3051
translate russian audrey_cassidy_propose_male_b45c78df:
    audrey.say "Э-э, [lssb_common.hero_name()]..."

# ch/harems_full/bitchy/events.rpy:3052
translate russian audrey_cassidy_propose_male_88e3a519:
    audrey.say "Ты что делаешь?!"

# ch/harems_full/bitchy/events.rpy:3053
translate russian audrey_cassidy_propose_male_2325b46b:
    "Я поднимаю два кольца, по одному в каждой руке."

# ch/harems_full/bitchy/events.rpy:3054
translate russian audrey_cassidy_propose_male_39c3bc2c:
    "Качаю головой, стараясь выглядеть уверенно."

# ch/harems_full/bitchy/events.rpy:3055
translate russian audrey_cassidy_propose_male_e4602081:
    mike.say "А на что похоже, Одри?"

# ch/harems_full/bitchy/events.rpy:3056
translate russian audrey_cassidy_propose_male_1b0ced82:
    mike.say "Пытаюсь сделать предложение вам обеим!"

# ch/harems_full/bitchy/events.rpy:3059
translate russian audrey_cassidy_propose_male_98ed7685:
    "Кажется, впервые в жизни Одри и Кэссиди обе потеряли дар речи."

# ch/harems_full/bitchy/events.rpy:3060
translate russian audrey_cassidy_propose_male_8809748e:
    "Они могут лишь смотреть на меня в полном изумлении."

# ch/harems_full/bitchy/events.rpy:3061
translate russian audrey_cassidy_propose_male_7ec15d6a:
    mike.say "Ну?"

# ch/harems_full/bitchy/events.rpy:3062
translate russian audrey_cassidy_propose_male_3facd8fb:
    mike.say "Вы мне ответите?"

# ch/harems_full/bitchy/events.rpy:3064
translate russian audrey_cassidy_propose_male_ecd5dd2f:
    "Когда девушки открывают рты, я едва не вздрагиваю."

# ch/harems_full/bitchy/events.rpy:3065
translate russian audrey_cassidy_propose_male_15827ed3:
    "Ведь какая-то часть меня уверена, что они откажут."

# ch/harems_full/bitchy/events.rpy:3066
translate russian audrey_cassidy_propose_male_10f1e2d9:
    audrey.say "О-о..."

# ch/harems_full/bitchy/events.rpy:3067
translate russian audrey_cassidy_propose_male_998fac86:
    audrey.say "Ну как отказать, когда ты так смотришь!"

# ch/harems_full/bitchy/events.rpy:3069
translate russian audrey_cassidy_propose_male_c235082f:
    audrey.say "Серьёзно, [lssb_common.hero_name()], у тебя вид побитого щенка!"

# ch/harems_full/bitchy/events.rpy:3070
translate russian audrey_cassidy_propose_male_100c28e4:
    cassidy.say "Не злобствуй, Одри!"

# ch/harems_full/bitchy/events.rpy:3071
translate russian audrey_cassidy_propose_male_e1b7815e:
    cassidy.say "Да, [lssb_common.hero_name()]!"

# ch/harems_full/bitchy/events.rpy:3073
translate russian audrey_cassidy_propose_male_f179a043:
    cassidy.say "Конечно, я хочу выйти за тебя."

# ch/harems_full/bitchy/events.rpy:3074
translate russian audrey_cassidy_propose_male_accd58d6:
    cassidy.say "И она тоже!"

# ch/harems_full/bitchy/events.rpy:3075
translate russian audrey_cassidy_propose_male_5908cf58:
    "Чувства почти переполняют меня."

# ch/harems_full/bitchy/events.rpy:3076
translate russian audrey_cassidy_propose_male_fdfc1b94:
    "Надевая кольца им на пальцы, я дрожу."

# ch/harems_full/bitchy/events.rpy:3077
translate russian audrey_cassidy_propose_male_d81e6fe8:
    "Пытаюсь подняться, но им приходится мне помочь."

# ch/harems_full/bitchy/events.rpy:3079
translate russian audrey_cassidy_propose_male_ef31247c:
    mike.say "Похоже, я немного переволновался!"

# ch/harems_full/bitchy/events.rpy:3080
translate russian audrey_cassidy_propose_male_60c834dd:
    cassidy.say "Не переживай, мы тебе поможем!"

# ch/harems_full/bitchy/events.rpy:3081
translate russian audrey_cassidy_propose_male_80fa7ad2:
    audrey.say "Да, [lssb_common.hero_name()]..."

# ch/harems_full/bitchy/events.rpy:3083
translate russian audrey_cassidy_propose_male_84e082bc:
    audrey.say "Мы ведь собираемся пожениться."

# ch/harems_full/bitchy/events.rpy:3084
translate russian audrey_cassidy_propose_male_55efb9cb:
    audrey.say "Так что придётся поднимать твою жалкую задницу!"

# ch/harems_full/bitchy/events.rpy:3085
translate russian audrey_cassidy_propose_male_9fd3ee41:
    "Я смеюсь и качаю головой."

# ch/harems_full/bitchy/events.rpy:3086
translate russian audrey_cassidy_propose_male_b064c187:
    "И уже гадаю, во что я ввязался!"

# ch/harems_full/bitchy/events.rpy:3090
translate russian audrey_cassidy_propose_male_10f1e2d9_1:
    audrey.say "О-о..."

# ch/harems_full/bitchy/events.rpy:3091
translate russian audrey_cassidy_propose_male_998fac86_1:
    audrey.say "Ну как отказать, когда ты так смотришь!"

# ch/harems_full/bitchy/events.rpy:3093
translate russian audrey_cassidy_propose_male_c235082f_1:
    audrey.say "Серьёзно, [lssb_common.hero_name()], у тебя вид побитого щенка!"

# ch/harems_full/bitchy/events.rpy:3094
translate russian audrey_cassidy_propose_male_53c3b0ba:
    cassidy.say "Ты, должно быть, шутишь!"

# ch/harems_full/bitchy/events.rpy:3095
translate russian audrey_cassidy_propose_male_34d295dc:
    cassidy.say "Я не могу выйти замуж."

# ch/harems_full/bitchy/events.rpy:3097
translate russian audrey_cassidy_propose_male_1296a90a:
    cassidy.say "Я слишком молодая и красивая!"

# ch/harems_full/bitchy/events.rpy:3098
translate russian audrey_cassidy_propose_male_8a218cd0:
    "Я начинаю подниматься."

# ch/harems_full/bitchy/events.rpy:3099
translate russian audrey_cassidy_propose_male_40a180d8:
    "И одновременно пытаюсь уговорить Кэссиди."

# ch/harems_full/bitchy/events.rpy:3100
translate russian audrey_cassidy_propose_male_20afe0d8:
    "Но Одри меня опережает."

# ch/harems_full/bitchy/events.rpy:3101
translate russian audrey_cassidy_propose_male_d8c6bea4:
    audrey.say "А, забудь о ней, [lssb_common.hero_name()]."

# ch/harems_full/bitchy/events.rpy:3103
translate russian audrey_cassidy_propose_male_8cdc5722:
    audrey.say "Тебе в жёны нужна настоящая женщина."

# ch/harems_full/bitchy/events.rpy:3104
translate russian audrey_cassidy_propose_male_8522af38:
    audrey.say "А не избалованная капризуля!"

# ch/harems_full/bitchy/events.rpy:3105
translate russian audrey_cassidy_propose_male_f921d321:
    "Лицо Кэссиди мрачнеет."

# ch/harems_full/bitchy/events.rpy:3106
translate russian audrey_cassidy_propose_male_caa3511b:
    "На мгновение мне кажется, что она сейчас начнёт спорить."

# ch/harems_full/bitchy/events.rpy:3107
translate russian audrey_cassidy_propose_male_9dd406e1:
    "Но она отворачивается и в ярости уходит."

# ch/harems_full/bitchy/events.rpy:3110
translate russian audrey_cassidy_propose_male_01f7366e:
    "Одри тем временем протягивает руку."

# ch/harems_full/bitchy/events.rpy:3111
translate russian audrey_cassidy_propose_male_0e2abedc:
    "Мне остаётся лишь надеть кольцо ей на палец."

# ch/harems_full/bitchy/events.rpy:3112
translate russian audrey_cassidy_propose_male_7b703620:
    "От случившегося у меня до сих пор голова идёт кругом."

# ch/harems_full/bitchy/events.rpy:3117
translate russian audrey_cassidy_propose_male_e5850a24:
    audrey.say "Да ну нахрен, [lssb_common.hero_name()]!"

# ch/harems_full/bitchy/events.rpy:3119
translate russian audrey_cassidy_propose_male_f31f3de5:
    audrey.say "Ты ведь шутишь, да?"

# ch/harems_full/bitchy/events.rpy:3120
translate russian audrey_cassidy_propose_male_100c28e4_1:
    cassidy.say "Не злобствуй, Одри!"

# ch/harems_full/bitchy/events.rpy:3121
translate russian audrey_cassidy_propose_male_e1b7815e_1:
    cassidy.say "Да, [lssb_common.hero_name()]!"

# ch/harems_full/bitchy/events.rpy:3123
translate russian audrey_cassidy_propose_male_f179a043_1:
    cassidy.say "Конечно, я хочу выйти за тебя."

# ch/harems_full/bitchy/events.rpy:3124
translate russian audrey_cassidy_propose_male_8a218cd0_1:
    "Я начинаю подниматься."

# ch/harems_full/bitchy/events.rpy:3125
translate russian audrey_cassidy_propose_male_0428b198:
    "И одновременно пытаюсь уговорить Одри."

# ch/harems_full/bitchy/events.rpy:3126
translate russian audrey_cassidy_propose_male_7899af6e:
    "Но Кэссиди меня опережает."

# ch/harems_full/bitchy/events.rpy:3127
translate russian audrey_cassidy_propose_male_8cbdf149:
    cassidy.say "А, забудь о ней, [lssb_common.hero_name()]."

# ch/harems_full/bitchy/events.rpy:3128
translate russian audrey_cassidy_propose_male_8d989a0c:
    cassidy.say "Тебе в жёны нужна та, кому ты дорог."

# ch/harems_full/bitchy/events.rpy:3129
translate russian audrey_cassidy_propose_male_054eefee:
    cassidy.say "А не эта злобная стерва!"

# ch/harems_full/bitchy/events.rpy:3130
translate russian audrey_cassidy_propose_male_a5c24ebd:
    "Лицо Одри мрачнеет."

# ch/harems_full/bitchy/events.rpy:3131
translate russian audrey_cassidy_propose_male_caa3511b_1:
    "На мгновение мне кажется, что она сейчас начнёт спорить."

# ch/harems_full/bitchy/events.rpy:3132
translate russian audrey_cassidy_propose_male_9dd406e1_1:
    "Но она отворачивается и в ярости уходит."

# ch/harems_full/bitchy/events.rpy:3135
translate russian audrey_cassidy_propose_male_309e5aa3:
    "Кэссиди тем временем протягивает руку."

# ch/harems_full/bitchy/events.rpy:3136
translate russian audrey_cassidy_propose_male_0e2abedc_1:
    "Мне остаётся лишь надеть кольцо ей на палец."

# ch/harems_full/bitchy/events.rpy:3137
translate russian audrey_cassidy_propose_male_7b703620_1:
    "От случившегося у меня до сих пор голова идёт кругом."

# ch/harems_full/bitchy/events.rpy:3142
translate russian audrey_cassidy_propose_male_ecd5dd2f_1:
    "Когда девушки открывают рты, я едва не вздрагиваю."

# ch/harems_full/bitchy/events.rpy:3143
translate russian audrey_cassidy_propose_male_15827ed3_1:
    "Ведь какая-то часть меня уверена, что они откажут."

# ch/harems_full/bitchy/events.rpy:3144
translate russian audrey_cassidy_propose_male_e5850a24_1:
    audrey.say "Да ну нахрен, [lssb_common.hero_name()]!"

# ch/harems_full/bitchy/events.rpy:3146
translate russian audrey_cassidy_propose_male_f31f3de5_1:
    audrey.say "Ты ведь шутишь, да?"

# ch/harems_full/bitchy/events.rpy:3147
translate russian audrey_cassidy_propose_male_daad4c8d:
    cassidy.say "Наверняка!"

# ch/harems_full/bitchy/events.rpy:3149
translate russian audrey_cassidy_propose_male_34d295dc_1:
    cassidy.say "Я не могу выйти замуж."

# ch/harems_full/bitchy/events.rpy:3150
translate russian audrey_cassidy_propose_male_1296a90a_1:
    cassidy.say "Я слишком молодая и красивая!"

# ch/harems_full/bitchy/events.rpy:3151
translate russian audrey_cassidy_propose_male_4976bd63:
    "Засовываю кольца обратно в карман и медленно поднимаюсь."

# ch/harems_full/bitchy/events.rpy:3153
translate russian audrey_cassidy_propose_male_e67efa2f:
    mike.say "Ага, вроде того!"

# ch/harems_full/bitchy/events.rpy:3155
translate russian audrey_cassidy_propose_male_8a0f1107:
    "Одри заливается смехом и качает головой."

# ch/harems_full/bitchy/events.rpy:3156
translate russian audrey_cassidy_propose_male_41b6d068:
    "А вот Кэссиди, похоже, немного за меня переживает."

# ch/harems_full/bitchy/events.rpy:3158
translate russian audrey_cassidy_propose_male_4f0ec1d1:
    cassidy.say "Ой..."

# ch/harems_full/bitchy/events.rpy:3159
translate russian audrey_cassidy_propose_male_0c331be3:
    audrey.say "Не парься, Кэссиди."

# ch/harems_full/bitchy/events.rpy:3161
translate russian audrey_cassidy_propose_male_2841e881:
    audrey.say "Переживёт."

# ch/harems_full/bitchy/events.rpy:3162
translate russian audrey_cassidy_propose_male_6dd2e935:
    audrey.say "Правда ведь?"

# ch/harems_full/bitchy/events.rpy:3163
translate russian audrey_cassidy_propose_male_52e52d23:
    "Мне остаётся только пожать плечами и кивнуть."

# ch/harems_full/bitchy/events.rpy:3164
translate russian audrey_cassidy_propose_male_3c64a355:
    mike.say "Я... наверное."

# ch/harems_full/bitchy/events.rpy:3172
translate russian audrey_palla_propose_male_4c642252:
    "Встречаться одновременно с Одри и Паллой — то ещё испытание."

# ch/harems_full/bitchy/events.rpy:3173
translate russian audrey_palla_propose_male_ef8ae8b5:
    "Обе точно знают, чего хотят и как этого добиться."

# ch/harems_full/bitchy/events.rpy:3174
translate russian audrey_palla_propose_male_75d5208c:
    "Но при всём сходстве они очень разные."

# ch/harems_full/bitchy/events.rpy:3175
translate russian audrey_palla_propose_male_37e87756:
    "Палла, например, обожает красоваться и быть в центре внимания."

# ch/harems_full/bitchy/events.rpy:3176
translate russian audrey_palla_propose_male_79fd5121:
    "Ей хочется показать всему миру свой очередной наряд."

# ch/harems_full/bitchy/events.rpy:3177
translate russian audrey_palla_propose_male_335b8d3f:
    "Одри тоже жаждет внимания, но модой впечатлить никого не пытается."

# ch/harems_full/bitchy/events.rpy:3178
translate russian audrey_palla_propose_male_0ad8af47:
    "Ей нравится устраивать сцены и вызывать у людей бурную реакцию."

# ch/harems_full/bitchy/events.rpy:3179
translate russian audrey_palla_propose_male_12151187:
    "Часто я чувствую себя жонглёром, пытаясь управиться с ними обеими."

# ch/harems_full/bitchy/events.rpy:3180
translate russian audrey_palla_propose_male_61723a67:
    "Стараюсь угодить каждой."

# ch/harems_full/bitchy/events.rpy:3181
translate russian audrey_palla_propose_male_b8c94d87:
    "И постоянно рискую где-нибудь напортачить."

# ch/harems_full/bitchy/events.rpy:3182
translate russian audrey_palla_propose_male_69422a53:
    "Кажется, пора что-то немного изменить."

# ch/harems_full/bitchy/events.rpy:3183
translate russian audrey_palla_propose_male_4af00502:
    "И, думаю, я знаю, что именно."

# ch/harems_full/bitchy/events.rpy:3184
translate russian audrey_palla_propose_male_38a4dcca:
    "Нужны лишь два кольца и подходящий момент..."

# ch/harems_full/bitchy/events.rpy:3186
translate russian audrey_palla_propose_male_ea9ee73e:
    palla.say "Э-э, Одри..."

# ch/harems_full/bitchy/events.rpy:3187
translate russian audrey_palla_propose_male_62b9bfc9:
    palla.say "На что ты так смотришь?"

# ch/harems_full/bitchy/events.rpy:3189
translate russian audrey_palla_propose_male_45a1f5ff:
    audrey.say "А ты сама скажи, Палла."

# ch/harems_full/bitchy/events.rpy:3190
translate russian audrey_palla_propose_male_6180d65d:
    audrey.say "Это же тебе хватило наглости такое надеть!"

# ch/harems_full/bitchy/events.rpy:3191
translate russian audrey_palla_propose_male_65f833a3:
    palla.say "Ах ты..."

# ch/harems_full/bitchy/events.rpy:3193
translate russian audrey_palla_propose_male_2a85dc58:
    palla.say "[lssb_common.hero_name()], что ты делаешь?"

# ch/harems_full/bitchy/events.rpy:3194
translate russian audrey_palla_propose_male_0c16cb1f:
    audrey.say "А?"

# ch/harems_full/bitchy/events.rpy:3196
translate russian audrey_palla_propose_male_191660a3:
    audrey.say "А и правда, какого чёрта ты делаешь?"

# ch/harems_full/bitchy/events.rpy:3197
translate russian audrey_palla_propose_male_f84c1e88:
    "Я лезу в карман и достаю кольца."

# ch/harems_full/bitchy/events.rpy:3198
translate russian audrey_palla_propose_male_16f32bfb:
    "Затем показываю их, надеясь, что этого объяснения хватит."

# ch/harems_full/bitchy/events.rpy:3200
translate russian audrey_palla_propose_male_d92a72bd:
    audrey.say "Погоди-ка..."

# ch/harems_full/bitchy/events.rpy:3201
translate russian audrey_palla_propose_male_3edb5084:
    audrey.say "Это что..."

# ch/harems_full/bitchy/events.rpy:3203
translate russian audrey_palla_propose_male_c82edd2a:
    palla.say "Помолвочные кольца!"

# ch/harems_full/bitchy/events.rpy:3204
translate russian audrey_palla_propose_male_363b75e8:
    palla.say "Стильные, модные помолвочные кольца!"

# ch/harems_full/bitchy/events.rpy:3205
translate russian audrey_palla_propose_male_49ec773f:
    "Надеюсь, моя улыбка выглядит уверенной."

# ch/harems_full/bitchy/events.rpy:3206
translate russian audrey_palla_propose_male_ef6366f4:
    "Потому что внутри у меня сейчас всё переворачивается от волнения!"

# ch/harems_full/bitchy/events.rpy:3207
translate russian audrey_palla_propose_male_2ac7dd92:
    mike.say "Одри..."

# ch/harems_full/bitchy/events.rpy:3209
translate russian audrey_palla_propose_male_65a8831b:
    mike.say "Палла..."

# ch/harems_full/bitchy/events.rpy:3212
translate russian audrey_palla_propose_male_e1c01f17:
    "Кажется, я даже перестал дышать в ожидании ответа."

# ch/harems_full/bitchy/events.rpy:3213
translate russian audrey_palla_propose_male_29fde375:
    "И боюсь упасть в обморок раньше, чем его услышу!"

# ch/harems_full/bitchy/events.rpy:3215
translate russian audrey_palla_propose_male_3d3b7649:
    "Одри и Палла обмениваются лукавыми улыбками."

# ch/harems_full/bitchy/events.rpy:3216
translate russian audrey_palla_propose_male_8c5abbe1:
