# ch/harems_full/bitchy/events.rpy:3354
translate russian cassidy_palla_propose_male_18cec7a6:
    mike.say "Ну так что скажете?"

# ch/harems_full/bitchy/events.rpy:3356
translate russian cassidy_palla_propose_male_40f81cc2:
