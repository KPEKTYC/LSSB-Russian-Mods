# ch/harems_full/bitchy/events.rpy:1604
translate russian bitchy_harem_foursome_ask_cassidy_34c26983:
    "Может, даже немного возбуждения?"

# ch/harems_full/bitchy/events.rpy:1605
translate russian bitchy_harem_foursome_ask_cassidy_5810042f:
    cassidy.say "МЕНЯ?!"

# ch/harems_full/bitchy/events.rpy:1606
translate russian bitchy_harem_foursome_ask_cassidy_7e69e33b:
    cassidy.say "Что им может от меня понадобиться?"

# ch/harems_full/bitchy/events.rpy:1607
translate russian bitchy_harem_foursome_ask_cassidy_dfdeff42:
    mike.say "Они хотят, чтобы мы все собрались и занялись сексом, Кэссиди."

# ch/harems_full/bitchy/events.rpy:1608
translate russian bitchy_harem_foursome_ask_cassidy_e44e73ff:
    mike.say "Хотят секс вчетвером с нами!"

# ch/harems_full/bitchy/events.rpy:1611
translate russian bitchy_harem_foursome_ask_cassidy_0d4a583d:
    "Когда я заканчиваю сообщать новость, Кэссиди замолкает."

# ch/harems_full/bitchy/events.rpy:1612
translate russian bitchy_harem_foursome_ask_cassidy_a819a4fd:
    "Она, кажется, погружается в раздумья, осмысляя услышанное."

# ch/harems_full/bitchy/events.rpy:1613
translate russian bitchy_harem_foursome_ask_cassidy_56afd1e2:
    "Это ведь хороший знак?"

# ch/harems_full/bitchy/events.rpy:1614
translate russian bitchy_harem_foursome_ask_cassidy_a7693023:
    "Если бы собиралась отказать, разве не взорвалась бы сразу?"

# ch/harems_full/bitchy/events.rpy:1615
translate russian bitchy_harem_foursome_ask_cassidy_1de832ab:
    cassidy.say "Я..."

# ch/harems_full/bitchy/events.rpy:1616
translate russian bitchy_harem_foursome_ask_cassidy_703a56d2:
    cassidy.say "Мне всегда было интересно, каково это."

# ch/harems_full/bitchy/events.rpy:1617
translate russian bitchy_harem_foursome_ask_cassidy_6b54f534:
    cassidy.say "Ну, сделать что-нибудь настолько вызывающее?"

# ch/harems_full/bitchy/events.rpy:1618
translate russian bitchy_harem_foursome_ask_cassidy_6990c186:
    mike.say "Это захватывает, Кэссиди."

# ch/harems_full/bitchy/events.rpy:1619
translate russian bitchy_harem_foursome_ask_cassidy_f3935db6:
    mike.say "Ощущения просто сносят голову!"

# ch/harems_full/bitchy/events.rpy:1620
translate russian bitchy_harem_foursome_ask_cassidy_558906f1:
    "Теперь я вижу, что Кэссиди борется сама с собой."

# ch/harems_full/bitchy/events.rpy:1621
translate russian bitchy_harem_foursome_ask_cassidy_6c0f7b7a:
    "Часть её хочет согласиться."

# ch/harems_full/bitchy/events.rpy:1622
translate russian bitchy_harem_foursome_ask_cassidy_3476c699:
    "Но другая часть боится."

# ch/harems_full/bitchy/events.rpy:1623
translate russian bitchy_harem_foursome_ask_cassidy_f3d80c84:
    mike.say "Если это поможет, я доверяю Одри и Палле."

# ch/harems_full/bitchy/events.rpy:1624
translate russian bitchy_harem_foursome_ask_cassidy_4dd489ec:
    mike.say "И не позволю, чтобы с тобой случилось что-то плохое."

# ch/harems_full/bitchy/events.rpy:1626
translate russian bitchy_harem_foursome_ask_cassidy_001cd40d:
    "Кэссиди, кажется, немного оживляется."

# ch/harems_full/bitchy/events.rpy:1627
translate russian bitchy_harem_foursome_ask_cassidy_f414a5a0:
    "Мои заверения, похоже, помогают."

# ch/harems_full/bitchy/events.rpy:1628
translate russian bitchy_harem_foursome_ask_cassidy_323d02c1:
    cassidy.say "Обещаешь, [lssb_common.hero_name()]?"

# ch/harems_full/bitchy/events.rpy:1629
translate russian bitchy_harem_foursome_ask_cassidy_ed06afae:
    cassidy.say "Ты меня защитишь?"

# ch/harems_full/bitchy/events.rpy:1630
translate russian bitchy_harem_foursome_ask_cassidy_d3d5e20a:
    mike.say "Обещаю, Кэссиди."

# ch/harems_full/bitchy/events.rpy:1632
translate russian bitchy_harem_foursome_ask_cassidy_8468dc63:
    cassidy.say "Тогда я согласна!"

# ch/harems_full/bitchy/events.rpy:1633
translate russian bitchy_harem_foursome_ask_cassidy_efcee0cb:
    "Конечно, я безумно рад это слышать."

# ch/harems_full/bitchy/events.rpy:1634
translate russian bitchy_harem_foursome_ask_cassidy_74185289:
    "Но стараюсь сдержать восторг и лишь киваю с улыбкой."

# ch/harems_full/bitchy/events.rpy:1635
translate russian bitchy_harem_foursome_ask_cassidy_9571078b:
    "Не хочу выглядеть слишком нетерпеливым."

# ch/harems_full/bitchy/events.rpy:1636
translate russian bitchy_harem_foursome_ask_cassidy_195e402b:
    "Иначе Кэссиди может подумать, что я что-то скрываю."

# ch/harems_full/bitchy/events.rpy:1637
translate russian bitchy_harem_foursome_ask_cassidy_097d5828:
    "Вместо этого я готовлюсь сообщить Одри и Палле хорошую новость."

# ch/harems_full/bitchy/events.rpy:1641
translate russian bitchy_harem_foursome_ask_cassidy_9657db7a:
    "Кэссиди отвечает быстрее, чем я мог ожидать."

# ch/harems_full/bitchy/events.rpy:1642
translate russian bitchy_harem_foursome_ask_cassidy_df4870e7:
    "И гораздо резче, чем я был готов услышать."

# ch/harems_full/bitchy/events.rpy:1643
translate russian bitchy_harem_foursome_ask_cassidy_7985cc49:
    cassidy.say "Да они грёбаные извращенки!"

# ch/harems_full/bitchy/events.rpy:1644
translate russian bitchy_harem_foursome_ask_cassidy_ab6f3810:
    cassidy.say "Ни за что не позволю им ко мне прикоснуться!"

# ch/harems_full/bitchy/events.rpy:1646
translate russian bitchy_harem_foursome_ask_cassidy_b2b77fa3:
    mike.say "Считать это отказом?"

# ch/harems_full/bitchy/events.rpy:1648
translate russian bitchy_harem_foursome_ask_cassidy_d454c27b:
    cassidy.say "Считай это «ни хрена подобного»!"

# ch/harems_full/bitchy/events.rpy:1649
translate russian bitchy_harem_foursome_ask_cassidy_d30f1d82:
    cassidy.say "И передай, что я больше никогда не хочу их видеть!"

# ch/harems_full/bitchy/events.rpy:1651
translate russian bitchy_harem_foursome_ask_cassidy_5961f6cd:
    "Я могу лишь поспешно кивнуть, стараясь показать, что всё понял."

# ch/harems_full/bitchy/events.rpy:1652
translate russian bitchy_harem_foursome_ask_cassidy_6c3d5adb:
    "Конечно, я очень разочарован тем, что секс вчетвером не состоится."

# ch/harems_full/bitchy/events.rpy:1653
translate russian bitchy_harem_foursome_ask_cassidy_9d3297cf:
    "Но Кэссиди и так проявила немало понимания."

# ch/harems_full/bitchy/events.rpy:1654
translate russian bitchy_harem_foursome_ask_cassidy_8ef64543:
    "Две разные девушки вмешались в наши встречи."

# ch/harems_full/bitchy/events.rpy:1655
translate russian bitchy_harem_foursome_ask_cassidy_4ad5e500:
    "И оба раза происходили довольно безумные вещи."

# ch/harems_full/bitchy/events.rpy:1656
translate russian bitchy_harem_foursome_ask_cassidy_692e7130:
    "Наверное, мне повезло, что после такого она вообще со мной разговаривает!"

# ch/harems_full/bitchy/events.rpy:1657
translate russian bitchy_harem_foursome_ask_cassidy_76b2b4d0:
    "Поэтому я оставляю эту тему."

# ch/harems_full/bitchy/events.rpy:1658
translate russian bitchy_harem_foursome_ask_cassidy_8b1e8d0b:
    "И уже думаю, как сообщить Одри и Палле плохую новость."

# ch/harems_full/bitchy/events.rpy:1668
translate russian bitchy_harem_nightclub_encounter_a927064b:
    "Мы с Кэссиди отлично проводим время в ночном клубе, наслаждаясь каждым мгновением."

# ch/harems_full/bitchy/events.rpy:1669
translate russian bitchy_harem_nightclub_encounter_38987204:
    "Музыка прекрасна, да и место на танцполе нам каким-то образом досталось одно из лучших."

# ch/harems_full/bitchy/events.rpy:1670
translate russian bitchy_harem_nightclub_encounter_83a064ea:
    "Мне настолько хорошо, что я совсем теряю бдительность."

# ch/harems_full/bitchy/events.rpy:1671
translate russian bitchy_harem_nightclub_encounter_fd3b757d:
    "Вижу лишь сияющее лицо Кэссиди."

# ch/harems_full/bitchy/events.rpy:1672
translate russian bitchy_harem_nightclub_encounter_65c78d32:
    "Все остальные лица вокруг расплываются."

# ch/harems_full/bitchy/events.rpy:1673
translate russian bitchy_harem_nightclub_encounter_f95e154f:
    "Но вот мы немного замедляемся, и я замечаю две пары глаз, смотрящих прямо на меня."

# ch/harems_full/bitchy/events.rpy:1674
translate russian bitchy_harem_nightclub_encounter_e5e2bc67:
    "БЛЯДЬ! Это Одри и Палла!"

# ch/harems_full/bitchy/events.rpy:1675
translate russian bitchy_harem_nightclub_encounter_21308d27:
    "Какого чёрта они узнали, что я приведу сюда Кэссиди сегодня вечером?!"

# ch/harems_full/bitchy/events.rpy:1676
translate russian bitchy_harem_nightclub_encounter_20625db1:
    "На миг я тщетно надеюсь, что через танцпол они меня не заметили."

# ch/harems_full/bitchy/events.rpy:1677
translate russian bitchy_harem_nightclub_encounter_356f2d4f:
    "Но потом вижу, как они одновременно качают головами, и понимаю: моя судьба решена."

# ch/harems_full/bitchy/events.rpy:1681
translate russian bitchy_harem_nightclub_encounter_e1fc776c:
    cassidy.say "Что случилось, [lssb_common.hero_name()]?"

# ch/harems_full/bitchy/events.rpy:1682
translate russian bitchy_harem_nightclub_encounter_543bfa87:
    cassidy.say "У тебя такой вид, будто ты привидение увидел!"

# ch/harems_full/bitchy/events.rpy:1684
translate russian bitchy_harem_nightclub_encounter_c4152998:
    mike.say "Э-э... Не совсем привидение, Кэссиди."

# ch/harems_full/bitchy/events.rpy:1685
translate russian bitchy_harem_nightclub_encounter_8a23f631:
    mike.say "Но примерно столь же страшное!"

# ch/harems_full/bitchy/events.rpy:1686
translate russian bitchy_harem_nightclub_encounter_59dfe4c7:
    cassidy.say "А?"

# ch/harems_full/bitchy/events.rpy:1687
translate russian bitchy_harem_nightclub_encounter_0b484746:
    cassidy.say "Что это значит?"

# ch/harems_full/bitchy/events.rpy:1688
translate russian bitchy_harem_nightclub_encounter_ac9832d2:
    mike.say "Неважно..."

# ch/harems_full/bitchy/events.rpy:1689
translate russian bitchy_harem_nightclub_encounter_95625a45:
    mike.say "Просто иди за мной. Надо уходить!"

# ch/harems_full/bitchy/events.rpy:1691
translate russian bitchy_harem_nightclub_encounter_97d655b0:
    cassidy.say "Что..."

# ch/harems_full/bitchy/events.rpy:1694
translate russian bitchy_harem_nightclub_encounter_209b2eeb:
    "Не дожидаясь согласия Кэссиди, я беру её за руку."

# ch/harems_full/bitchy/events.rpy:1695
translate russian bitchy_harem_nightclub_encounter_fbd78fe5:
    "И веду с танцпола, таща за собой."

# ch/harems_full/bitchy/events.rpy:1696
translate russian bitchy_harem_nightclub_encounter_999fcac5:
    "Нарочно направляюсь в сторону, противоположную той, где заметил Одри и Паллу."

# ch/harems_full/bitchy/events.rpy:1697
translate russian bitchy_harem_nightclub_encounter_1b6e45c1:
    "Но они, разумеется, не дуры, так что далеко уйти не получается..."

# ch/harems_full/bitchy/events.rpy:1701
translate russian bitchy_harem_nightclub_encounter_960c0dea:
    audrey.say "Привет, [lssb_common.hero_name()]..."

# ch/harems_full/bitchy/events.rpy:1702
translate russian bitchy_harem_nightclub_encounter_677a2dc3:
    audrey.say "Какая встреча!"

# ch/harems_full/bitchy/events.rpy:1703
translate russian bitchy_harem_nightclub_encounter_271728fe:
    palla.say "И ты не один."

# ch/harems_full/bitchy/events.rpy:1704
translate russian bitchy_harem_nightclub_encounter_b665e6fb:
    palla.say "Кажется, я даже узнаю твою очаровательную спутницу!"

# ch/harems_full/bitchy/events.rpy:1706
translate russian bitchy_harem_nightclub_encounter_b46f6abf:
    cassidy.say "О..."

# ch/harems_full/bitchy/events.rpy:1707
translate russian bitchy_harem_nightclub_encounter_8eb97b3f:
    cassidy.say "Привет, Палла!"

# ch/harems_full/bitchy/events.rpy:1708
translate russian bitchy_harem_nightclub_encounter_e197502a:
    cassidy.say "Что ты здесь делаешь?"

# ch/harems_full/bitchy/events.rpy:1709
translate russian bitchy_harem_nightclub_encounter_f02f97dd:
    audrey.say "Мы хотели спросить то же самое!"

# ch/harems_full/bitchy/events.rpy:1711
translate russian bitchy_harem_nightclub_encounter_510dffd2:
    mike.say "У нас ведь нет проблем?"

# ch/harems_full/bitchy/events.rpy:1712
translate russian bitchy_harem_nightclub_encounter_246b3ef3:
    mike.say "В прошлый раз мы все отлично поладили, правда?"

# ch/harems_full/bitchy/events.rpy:1713
translate russian bitchy_harem_nightclub_encounter_06c7b7e5:
    cassidy.say "А, точно, секс вчетвером!"

# ch/harems_full/bitchy/events.rpy:1714
translate russian bitchy_harem_nightclub_encounter_02bf4d23:
    cassidy.say "Это ведь были вы двое?"

# ch/harems_full/bitchy/events.rpy:1717
translate russian bitchy_harem_nightclub_encounter_e47b03b5:
    "Одри и Паллу немного удивляет тон Кэссиди."

# ch/harems_full/bitchy/events.rpy:1718
translate russian bitchy_harem_nightclub_encounter_a9018aa2:
    "Словно тот факт, что мы все тогда переспали, заслуживает большего внимания."

# ch/harems_full/bitchy/events.rpy:1720
translate russian bitchy_harem_nightclub_encounter_919fa6e1:
    audrey.say "Да, мы!"

# ch/harems_full/bitchy/events.rpy:1721
translate russian bitchy_harem_nightclub_encounter_9bc7a84c:
    palla.say "Мы как-то думали, что ты помнишь!"

# ch/harems_full/bitchy/events.rpy:1723
translate russian bitchy_harem_nightclub_encounter_5c941798:
    cassidy.say "Ну, когда светский календарь так забит, как у меня..."

# ch/harems_full/bitchy/events.rpy:1724
translate russian bitchy_harem_nightclub_encounter_88731a85:
    cassidy.say "Очень легко забыть, что ты делала и с кем!"

# ch/harems_full/bitchy/events.rpy:1725
translate russian bitchy_harem_nightclub_encounter_27c19cd6:
    "Я чувствую, что нужно вмешаться и разрядить растущее напряжение."

# ch/harems_full/bitchy/events.rpy:1726
translate russian bitchy_harem_nightclub_encounter_ea966da7:
    mike.say "Это всё неважно."

# ch/harems_full/bitchy/events.rpy:1727
translate russian bitchy_harem_nightclub_encounter_a6ad5c8c:
    mike.say "Важно, что сейчас мы все здесь."

# ch/harems_full/bitchy/events.rpy:1728
translate russian bitchy_harem_nightclub_encounter_8a8b640f:
    mike.say "Так давайте общаться и хорошо проводить время!"

# ch/harems_full/bitchy/events.rpy:1730
translate russian bitchy_harem_nightclub_encounter_6d3a3feb:
    "Я уже открываю рот, собираясь оправдываться."

# ch/harems_full/bitchy/events.rpy:1731
translate russian bitchy_harem_nightclub_encounter_7899af6e:
    "Но Кэссиди меня опережает."

# ch/harems_full/bitchy/events.rpy:1732
translate russian bitchy_harem_nightclub_encounter_b46f6abf_1:
    cassidy.say "О..."

# ch/harems_full/bitchy/events.rpy:1733
translate russian bitchy_harem_nightclub_encounter_8eb97b3f_1:
    cassidy.say "Привет, Палла!"

# ch/harems_full/bitchy/events.rpy:1734
translate russian bitchy_harem_nightclub_encounter_cd8a174a:
    cassidy.say "С каких пор тебя снова сюда пускают?"

# ch/harems_full/bitchy/events.rpy:1737
translate russian bitchy_harem_nightclub_encounter_f6e17e52:
    "Одри хмурится и переводит взгляд на Паллу."

# ch/harems_full/bitchy/events.rpy:1738
translate russian bitchy_harem_nightclub_encounter_509b5df1:
    "А та выглядит весьма неловко."

# ch/harems_full/bitchy/events.rpy:1739
translate russian bitchy_harem_nightclub_encounter_d92a72bd:
    audrey.say "Погодите..."

# ch/harems_full/bitchy/events.rpy:1740
translate russian bitchy_harem_nightclub_encounter_e91c2b22:
    audrey.say "Вы знакомы?!"

# ch/harems_full/bitchy/events.rpy:1741
translate russian bitchy_harem_nightclub_encounter_ce33937e:
    palla.say "Ну... да..."

# ch/harems_full/bitchy/events.rpy:1742
translate russian bitchy_harem_nightclub_encounter_ee796f7a:
    palla.say "Скажем так: мы вращаемся в одних кругах, ладно?"

# ch/harems_full/bitchy/events.rpy:1743
translate russian bitchy_harem_nightclub_encounter_18fefe72:
    "Пока внимание Одри и Паллы отвлеклось, я чувствую свой шанс."

# ch/harems_full/bitchy/events.rpy:1744
translate russian bitchy_harem_nightclub_encounter_0783ae8c:
    "Вот бы воспользоваться этой возможностью..."

# ch/harems_full/bitchy/events.rpy:1745
translate russian bitchy_harem_nightclub_encounter_92058e04:
    mike.say "Вот это совпадение!"

# ch/harems_full/bitchy/events.rpy:1746
translate russian bitchy_harem_nightclub_encounter_72707116:
    mike.say "Мир тесен!"

# ch/harems_full/bitchy/events.rpy:1747
translate russian bitchy_harem_nightclub_encounter_3322a9a0:
    mike.say "А знаете что? Давайте выпьем и поболтаем."

# ch/harems_full/bitchy/events.rpy:1748
translate russian bitchy_harem_nightclub_encounter_c8946682:
    mike.say "Вдруг выясним, что все связаны какими-нибудь невероятными знакомствами!"

