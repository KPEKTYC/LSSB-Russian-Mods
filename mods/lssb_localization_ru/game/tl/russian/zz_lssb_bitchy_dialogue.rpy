# ch/harems_full/bitchy/events.rpy:1791
translate russian bitchy_harem_nightclub_encounter_afbd74df:
    cassidy.say "Поехали ко мне!"

# ch/harems_full/bitchy/events.rpy:1792
translate russian bitchy_harem_nightclub_encounter_f5739517:
    "И вот мы уже садимся в такси и уезжаем."

# ch/harems_full/bitchy/events.rpy:1798
translate russian bitchy_harem_foursome_nightclub_intro_b9739bb0:
    "К выходу из клуба мы столько выпили, что всё расплывается."

# ch/harems_full/bitchy/events.rpy:1799
translate russian bitchy_harem_foursome_nightclub_intro_1f924f83:
    "Мне даже требуется время, чтобы вспомнить, куда мы едем и что собираемся делать."

# ch/harems_full/bitchy/events.rpy:1801
translate russian bitchy_harem_foursome_nightclub_intro_1b43e209:
    "Но, выбравшись из такси, я узнаю роскошный дом Кэссиди."

# ch/harems_full/bitchy/events.rpy:1802
translate russian bitchy_harem_foursome_nightclub_intro_81eadabe:
    "И этого достаточно, чтобы память мгновенно вернулась!"

# ch/harems_full/bitchy/events.rpy:1803
translate russian bitchy_harem_foursome_nightclub_intro_ef718868:
    "Мы здесь ради секса вчетвером: Кэссиди, Одри, Палла и я!"

# ch/harems_full/bitchy/events.rpy:1806
translate russian bitchy_harem_foursome_nightclub_intro_a0abb59f:
    "Мы выстраиваемся за Кэссиди, пока она отпирает дверь."

# ch/harems_full/bitchy/events.rpy:1807
translate russian bitchy_harem_foursome_nightclub_intro_14e7c07e:
    "Когда дверь открывается, мы всей нестройной процессией вваливаемся в прихожую."

# ch/harems_full/bitchy/events.rpy:1814
translate russian bitchy_harem_foursome_nightclub_intro_d3426437:
    audrey.say "Мне кажется..."

# ch/harems_full/bitchy/events.rpy:1815
translate russian bitchy_harem_foursome_nightclub_intro_3ee8353a:
    audrey.say "Или с прошлого раза здесь стало ещё шикарнее?"

# ch/harems_full/bitchy/events.rpy:1816
translate russian bitchy_harem_foursome_nightclub_intro_f58f1c90:
    palla.say "По-моему, здесь ничего не изменилось, Одри."

# ch/harems_full/bitchy/events.rpy:1818
translate russian bitchy_harem_foursome_nightclub_intro_64798301:
    palla.say "Может, это ты стала выглядеть дешевле?"

# ch/harems_full/bitchy/events.rpy:1820
translate russian bitchy_harem_foursome_nightclub_intro_80ea7439:
    audrey.say "Ого..."

# ch/harems_full/bitchy/events.rpy:1821
translate russian bitchy_harem_foursome_nightclub_intro_cab31d30:
