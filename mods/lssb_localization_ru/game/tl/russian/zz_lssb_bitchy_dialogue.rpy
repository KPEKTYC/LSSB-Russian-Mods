# ch/harems_full/bitchy/events.rpy:2078
translate russian bitchy_harem_foursome_e2cd9d5a:
    "Поэтому справедливо, чтобы львиная доля внимания досталась ей."

# ch/harems_full/bitchy/events.rpy:2079
translate russian bitchy_harem_foursome_4ac3061b:
