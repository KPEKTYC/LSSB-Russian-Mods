# ch/harems_full/bitchy/events.rpy:3334
translate russian cassidy_palla_propose_male_abc76e2a:
    cassidy.say "Ого!"

# ch/harems_full/bitchy/events.rpy:3335
translate russian cassidy_palla_propose_male_7f700548:
    cassidy.say "Ты там в порядке?"

# ch/harems_full/bitchy/events.rpy:3336
translate russian cassidy_palla_propose_male_ded4c852:
    "Смотрю на них снизу вверх и выдавливаю улыбку."

# ch/harems_full/bitchy/events.rpy:3337
translate russian cassidy_palla_propose_male_ffc7c44e:
    "Одновременно нащупываю кольца в кармане."

# ch/harems_full/bitchy/events.rpy:3338
translate russian cassidy_palla_propose_male_65a8831b:
    mike.say "Палла..."

# ch/harems_full/bitchy/events.rpy:3340
translate russian cassidy_palla_propose_male_7d3a0e63:
    mike.say "Кэссиди..."

# ch/harems_full/bitchy/events.rpy:3342
translate russian cassidy_palla_propose_male_3de48516:
    mike.say "Я... я хочу вас кое о чём спросить..."

# ch/harems_full/bitchy/events.rpy:3343
translate russian cassidy_palla_propose_male_6319d513:
    "Поднимаю кольца так, чтобы их было хорошо видно."

# ch/harems_full/bitchy/events.rpy:3344
translate russian cassidy_palla_propose_male_fc3e4ba0:
