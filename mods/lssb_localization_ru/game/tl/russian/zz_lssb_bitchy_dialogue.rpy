# ch/harems_full/bitchy/events.rpy:2411
translate russian bitchy_harem_foursome_0481fb71_1:
    audrey.say "Ты сейчас заставишь меня..."

# ch/harems_full/bitchy/events.rpy:2414
translate russian bitchy_harem_foursome_193099c3_1:
    audrey.say "Я... я кончаю!"

# ch/harems_full/bitchy/events.rpy:2416
translate russian bitchy_harem_foursome_0631a436_1:
    "Одри скачет на моём члене, пока я извергаюсь в неё до последней капли."

# ch/harems_full/bitchy/events.rpy:2417
translate russian bitchy_harem_foursome_de6a7be1_1:
    "Она вскрикивает и задыхается, принимая всё и не в силах сопротивляться."

# ch/harems_full/bitchy/events.rpy:2418
translate russian bitchy_harem_foursome_83ceb4cf_2:
    "Почти сразу после того, как я заканчиваю, мышцы Одри расслабляются."

# ch/harems_full/bitchy/events.rpy:2419
translate russian bitchy_harem_foursome_f10a3e23_1:
    "Она бессильно наваливается на меня, пытаясь отдышаться."

# ch/harems_full/bitchy/events.rpy:2424
translate russian bitchy_harem_foursome_22bef6df_1:
    "Я мог бы оставить Одри именно там, где она находится, до последнего мгновения."

# ch/harems_full/bitchy/events.rpy:2425
translate russian bitchy_harem_foursome_133ddf0a_1:
    "Ей не выбраться, пока я не позволю."

# ch/harems_full/bitchy/events.rpy:2426
translate russian bitchy_harem_foursome_eb00df3d:
    "Но тут я вспоминаю, как мой член погружался в её киску."

# ch/harems_full/bitchy/events.rpy:2427
translate russian bitchy_harem_foursome_29279ed8_1:
    "И невольно гадаю, каково будет ощутить обратное движение."

# ch/harems_full/bitchy/events.rpy:2428
translate russian bitchy_harem_foursome_4d0350d8_4:
    audrey.say "Ох, блядь..."

# ch/harems_full/bitchy/events.rpy:2429
translate russian bitchy_harem_foursome_a77930cf_1:
    audrey.say "Что ты..."

# ch/harems_full/bitchy/events.rpy:2430
translate russian bitchy_harem_foursome_98b8b766_1:
    audrey.say "Ты заставишь меня кончить!"

# ch/harems_full/bitchy/events.rpy:2432
translate russian bitchy_harem_foursome_f4cd8aef:
    "Я начинаю как можно быстрее вынимать член из киски Одри."

# ch/harems_full/bitchy/events.rpy:2433
translate russian bitchy_harem_foursome_25e65a22_1:
    "Она вскрикивает и задыхается, не в силах сопротивляться."

# ch/harems_full/bitchy/events.rpy:2434
translate russian bitchy_harem_foursome_ece3af45_1:
    "И начинает кончать ещё до того, как я выхожу полностью."

# ch/harems_full/bitchy/events.rpy:2437
translate russian bitchy_harem_foursome_a4bbfbaf_1:
    "Едва член оказывается снаружи, я теряю контроль и извергаюсь."

# ch/harems_full/bitchy/events.rpy:2438
translate russian bitchy_harem_foursome_83ceb4cf_3:
    "Почти сразу после того, как я заканчиваю, мышцы Одри расслабляются."

# ch/harems_full/bitchy/events.rpy:2439
translate russian bitchy_harem_foursome_eb6fe427_1:
    "Она бессильно наваливается на меня, пытаясь отдышаться."

# ch/harems_full/bitchy/events.rpy:2440
translate russian bitchy_harem_foursome_2287a325_1:
    "Я чувствую свою сперму между её задницей и моими бёдрами."

# ch/harems_full/bitchy/events.rpy:2448
translate russian bitchy_harem_foursome_3018e550:
    "Выбирать между Кэссиди, Одри и Паллой в любом случае было бы непросто."

# ch/harems_full/bitchy/events.rpy:2449
translate russian bitchy_harem_foursome_9be72835:
    "Каждая из них сама по себе была бы потрясающим выбором."

# ch/harems_full/bitchy/events.rpy:2450
translate russian bitchy_harem_foursome_77f77baa:
    "Но вместе выбрать одну из троих почти невозможно."

# ch/harems_full/bitchy/events.rpy:2451
translate russian bitchy_harem_foursome_eb4b6c93:
    "Поэтому я решаю опереться на уверенность и опыт."

# ch/harems_full/bitchy/events.rpy:2452
translate russian bitchy_harem_foursome_150f18f8:
    "Самый длинный язык, бесспорно, у Одри."

# ch/harems_full/bitchy/events.rpy:2453
translate russian bitchy_harem_foursome_34033f95:
    "Но в самоуверенной дерзости Палла её превосходит."

# ch/harems_full/bitchy/events.rpy:2454
translate russian bitchy_harem_foursome_971ad2fb:
    "Так что выбираю её."

# ch/harems_full/bitchy/events.rpy:2455
translate russian bitchy_harem_foursome_de1de4ef:
    "Я ложусь на пол и подзываю Паллу."

# ch/harems_full/bitchy/events.rpy:2457
translate russian bitchy_harem_foursome_3f95862b:
    "Одри появляется за её спиной и берёт за плечи."

# ch/harems_full/bitchy/events.rpy:2458
translate russian bitchy_harem_foursome_75b1b401:
    "Поначалу Палла немного удивлена, но затем поддаётся."

# ch/harems_full/bitchy/events.rpy:2460
translate russian bitchy_harem_foursome_6feac0b8:
    palla.say "Ладно, ладно..."

# ch/harems_full/bitchy/events.rpy:2461
translate russian bitchy_harem_foursome_4539d5fd:
    palla.say "Будь по-вашему!"

# ch/harems_full/bitchy/events.rpy:2462
translate russian bitchy_harem_foursome_1a83e4bb:
    palla.say "Только смотрите, чтобы мне понравилось!"

# ch/harems_full/bitchy/events.rpy:2463
translate russian bitchy_harem_foursome_f414da4c:
    "Кэссиди без колебаний опускается с нами на пол."

# ch/harems_full/bitchy/events.rpy:2465
translate russian bitchy_harem_foursome_824a45ce:
    "А вот Кэссиди на миг задерживается, затем спешит последовать примеру."

# ch/harems_full/bitchy/events.rpy:2466
translate russian bitchy_harem_foursome_03bf90d8:
    "Потом наклоняется и крепко берётся за мой член."

# ch/harems_full/bitchy/events.rpy:2468
translate russian bitchy_harem_foursome_0790759e:
    "Они окружают Паллу спереди и сзади."

# ch/harems_full/bitchy/events.rpy:2469
translate russian bitchy_harem_foursome_c991b321:
    "Словно думают, что она в любой миг попытается сбежать."

# ch/harems_full/bitchy/events.rpy:2470
translate russian bitchy_harem_foursome_cc2d458e:
    "Не то чтобы я собирался это допустить."

# ch/harems_full/bitchy/events.rpy:2471
translate russian bitchy_harem_foursome_15de4303:
    "Мой член твёрдый как камень, и мне не терпится начать."

# ch/harems_full/bitchy/events.rpy:2472
translate russian bitchy_harem_foursome_9c63d7ad:
    "Я почти ощущаю жар её киски!"

# ch/harems_full/bitchy/events.rpy:2475
translate russian bitchy_harem_foursome_9c314333:
    "Можно было бы просто направить головку к киске Паллы."

# ch/harems_full/bitchy/events.rpy:2476
translate russian bitchy_harem_foursome_06035e5b:
    "Но что интересного в таком осторожном подходе?"

# ch/harems_full/bitchy/events.rpy:2477
translate russian bitchy_harem_foursome_90b9c5b9:
    "В конце концов, у нас тут секс вчетвером."

# ch/harems_full/bitchy/events.rpy:2478
translate russian bitchy_harem_foursome_7e49de36:
    "Так что стоит действовать как можно смелее, верно?"

# ch/harems_full/bitchy/events.rpy:2479
translate russian bitchy_harem_foursome_86943a75:
    "Вот почему я выбираю другую дырочку."

# ch/harems_full/bitchy/events.rpy:2480
translate russian bitchy_harem_foursome_506a05bf:
