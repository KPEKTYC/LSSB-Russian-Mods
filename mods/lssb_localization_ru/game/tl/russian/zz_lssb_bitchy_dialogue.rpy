# ch/harems_full/bitchy/events.rpy:2098
translate russian bitchy_harem_foursome_5eeee050:
    "Хочу, чтобы Одри и Палла тоже запомнили эту встречу, хотя сейчас очередь не их."

# ch/harems_full/bitchy/events.rpy:2099
translate russian bitchy_harem_foursome_77dedb55:
    "Зная, что Кэссиди довольно неопытна, я не колеблюсь ни мгновения."

# ch/harems_full/bitchy/events.rpy:2100
translate russian bitchy_harem_foursome_6bcf7134:
    "Раздвигаю её бёдра и направляюсь к намеченной цели."

# ch/harems_full/bitchy/events.rpy:2101
