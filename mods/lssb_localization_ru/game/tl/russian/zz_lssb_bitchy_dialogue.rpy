# ch/harems_full/bitchy/events.rpy:1844
translate russian bitchy_harem_foursome_nightclub_intro_4bf2f3c4:
    cassidy.say "Её здесь нет!"

# ch/harems_full/bitchy/events.rpy:1846
translate russian bitchy_harem_foursome_nightclub_intro_3c1953d1:
    cassidy.say "Если бы была, нас бы здесь не было!"

# ch/harems_full/bitchy/events.rpy:1848
translate russian bitchy_harem_foursome_nightclub_intro_c9cd6005:
    cassidy.say "Их здесь нет!"

# ch/harems_full/bitchy/events.rpy:1850
translate russian bitchy_harem_foursome_nightclub_intro_9b17c38c:
    cassidy.say "Если бы были, нас бы здесь не было!"

# ch/harems_full/bitchy/events.rpy:1855
translate russian bitchy_harem_foursome_nightclub_intro_f97ce184:
    "Кэссиди ведёт нас в весьма роскошную гостиную."

# ch/harems_full/bitchy/events.rpy:1856
translate russian bitchy_harem_foursome_nightclub_intro_71d8308a:
