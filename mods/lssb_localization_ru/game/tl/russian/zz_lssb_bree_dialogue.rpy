# ch/bree/date.rpy:192
translate russian bree_date_play_arcade_win_male_c979f79b:
    "Но [bree.name], наверное, самый заядлый геймер, которого я знаю!"

# ch/bree/date.rpy:193
translate russian bree_date_play_arcade_win_male_7a8ca400:
    "Она почти так же хороша, как я. Но всё-таки немного уступает."

# ch/bree/date.rpy:194
translate russian bree_date_play_arcade_win_male_3ed97693:
    bree.say "Этот гриб мой!"

# ch/bree/date.rpy:195
translate russian bree_date_play_arcade_win_male_4ea084fb:
    bree.say "Эй!"

# ch/bree/date.rpy:196
translate russian bree_date_play_arcade_win_male_d4a81237:
