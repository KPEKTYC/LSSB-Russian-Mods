# ch/bree/date.rpy:247
translate russian bree_date_play_arcade_lose_male_e4987bab:
    "И это для меня гораздо более ценный трофей, чем победа над ней в видеоигре!"

# ch/bree/date.rpy:252
translate russian bree_pet_activity_male_a2f5e84e:
    "Я погладил великолепные светлые волосы [bree.name]."

# ch/bree/date.rpy:256
