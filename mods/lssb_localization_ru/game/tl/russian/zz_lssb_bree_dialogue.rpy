# ch/bree/date.rpy:222
translate russian bree_date_play_arcade_lose_male_6952f14c:
    mike.say "Этот гриб мой!"

# ch/bree/date.rpy:223
translate russian bree_date_play_arcade_lose_male_75c06a0b:
    mike.say "Эй!"

# ch/bree/date.rpy:224
