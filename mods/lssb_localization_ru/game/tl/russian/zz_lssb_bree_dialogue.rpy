# ch/bree/date.rpy:153
translate russian bree_date_buy_a_round_fb20fd2c:
    "Я хочу угостить пивом весь паб."

# ch/bree/date.rpy:154
translate russian bree_date_buy_a_round_291f0d68:
    "Но, похоже, [bree.name] не хочет пить, поэтому я воздерживаюсь."

# ch/bree/date.rpy:159
translate russian bree_dance_with_13cf6b89:
