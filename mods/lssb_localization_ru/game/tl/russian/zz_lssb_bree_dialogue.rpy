# ch/bree/date.rpy:185
translate russian bree_date_play_arcade_intro_male_e144d6f7:
    bree.say "Ты готов, [hero.name]?"

# ch/bree/date.rpy:186
translate russian bree_date_play_arcade_intro_male_068baf5c:
