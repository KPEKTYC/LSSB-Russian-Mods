    mike.say "Я чемпион!"

# ch/bree/date.rpy:212
translate russian bree_date_play_arcade_win_male_7b852243:
    "[bree.name] качает головой и фыркает от разочарования."

# ch/bree/date.rpy:213
translate russian bree_date_play_arcade_win_male_e8db3c26:
    "Но она все равно старается быть хорошей проигравшей."

# ch/bree/date.rpy:214
translate russian bree_date_play_arcade_win_male_cd2facec:
    bree.say "Ты победил, [hero.name]."

# ch/bree/date.rpy:215
translate russian bree_date_play_arcade_win_male_dffa98c1:
    bree.say "Но я тебя одолею в следующий раз!"

# ch/bree/date.rpy:219
