translate russian bree_gift_collar_male_761722d2:
    "Просто мы будто так и не признали вслух, что теперь это часть наших отношений."

# ch/bree/gift.rpy:154
translate russian bree_gift_collar_male_d44e2910:
    "И это мешает мне предложить зайти дальше и вместе попробовать что-нибудь ещё безумнее."

# ch/bree/gift.rpy:155
translate russian bree_gift_collar_male_7e5dcd1a:
    "Думаю, здесь нужен какой-нибудь жест с моей стороны."

# ch/bree/gift.rpy:156
translate russian bree_gift_collar_male_3e8025af:
    "Надо дать [bree.name] понять, в каком направлении мне хочется двигаться."

# ch/bree/gift.rpy:157
translate russian bree_gift_collar_male_acc97fd0:
    "И подходящий способ быстро приходит мне в голову."

# ch/bree/gift.rpy:158
translate russian bree_gift_collar_male_dfaa244c:
    "Остаётся только выбрать момент..."

# ch/bree/gift.rpy:159
translate russian bree_gift_collar_male_fe7e321b:
    mike.say "Слушай, [bree.name]..."

# ch/bree/gift.rpy:160
translate russian bree_gift_collar_male_97512740:
    mike.say "У меня для тебя кое-что есть."

# ch/bree/gift.rpy:161
translate russian bree_gift_collar_male_274f0621:
    mike.say "Небольшой сюрприз."

# ch/bree/gift.rpy:164
translate russian bree_gift_collar_male_e2a96186:
    "При одном упоминании подарка глаза [bree.name] загораются."

# ch/bree/gift.rpy:165
translate russian bree_gift_collar_male_678a6dec:
    "Она ведь тоже человек. Да и какая девушка не любит, когда её балуют?"

# ch/bree/gift.rpy:166
translate russian bree_gift_collar_male_670ad1a7:
    bree.say "Ого!"

# ch/bree/gift.rpy:167
translate russian bree_gift_collar_male_654feffc:
    bree.say "Это ТАК мило с твоей стороны, [hero.name]!"

# ch/bree/gift.rpy:169
translate russian bree_gift_collar_male_a950146c:
    bree.say "Что там?!"

# ch/bree/gift.rpy:170
translate russian bree_gift_collar_male_fb08b3e6:
    "Её восторг радует меня, и я усмехаюсь, глядя на [bree.name]."

# ch/bree/gift.rpy:171
translate russian bree_gift_collar_male_78cd724c:
    "Но качаю головой, ласково журя её за этот вопрос."

# ch/bree/gift.rpy:172
translate russian bree_gift_collar_male_36089441:
    mike.say "Это же сюрприз, помнишь?"

# ch/bree/gift.rpy:173
translate russian bree_gift_collar_male_62fd0b46:
    mike.say "Скажем так: это кое-что из одежды."

# ch/bree/gift.rpy:174
translate russian bree_gift_collar_male_3d75d6ea:
    mike.say "Мне кажется, тебе очень пойдёт."

# ch/bree/gift.rpy:175
translate russian bree_gift_collar_male_0a782e82:
    "[bree.name] радостно хлопает в ладоши."

# ch/bree/gift.rpy:176
translate russian bree_gift_collar_male_6a4102a5:
    "Вижу, как она лихорадочно перебирает догадки."

# ch/bree/gift.rpy:177
translate russian bree_gift_collar_male_cbb73ac8:
    bree.say "О-о..."

# ch/bree/gift.rpy:178
translate russian bree_gift_collar_male_da1af861:
    bree.say "Симпатичная футболка?"

# ch/bree/gift.rpy:179
translate russian bree_gift_collar_male_8dd3c776:
    bree.say "Может, что-то для бассейна?"

# ch/bree/gift.rpy:180
translate russian bree_gift_collar_male_f812e243:
    bree.say "Или... или сексуальное бельё, да?!"

# ch/bree/gift.rpy:181
translate russian bree_gift_collar_male_602f6979:
    "Я не даю [bree.name] слишком увлечься догадками."

# ch/bree/gift.rpy:182
translate russian bree_gift_collar_male_25dde9b4:
    "Вместо этого достаю подарок из укрытия."

# ch/bree/gift.rpy:183
translate russian bree_gift_collar_male_65b321c0:
    "[bree.name] хихикает и пытается разглядеть, что у меня в руках."

# ch/bree/gift.rpy:184
translate russian bree_gift_collar_male_38876e61:
    "Я раскрываю ладони, показывая розовый кожаный ошейник."

# ch/bree/gift.rpy:185
translate russian bree_gift_collar_male_8da1d8cf:
    "Похож на собачий, только больше."

# ch/bree/gift.rpy:186
translate russian bree_gift_collar_male_82cb0b1b:
    "На табличке спереди заглавными буквами написано «ЗВЕРЮШКА»."

# ch/bree/gift.rpy:187
translate russian bree_gift_collar_male_3e15845b:
    "Смех [bree.name] внезапно обрывается."

# ch/bree/gift.rpy:188
translate russian bree_gift_collar_male_b0c08e07:
    "Она прикрывает рот обеими руками."

# ch/bree/gift.rpy:189
translate russian bree_gift_collar_male_476b9910:
    "Не могу понять — от восторга или от ужаса!"

# ch/bree/gift.rpy:191
translate russian bree_gift_collar_male_d54c9b2e:
    "Но [bree.name] быстро избавляет меня от сомнений."

# ch/bree/gift.rpy:192
translate russian bree_gift_collar_male_1f775134:
    "Она взвизгивает — явно от восторга."

# ch/bree/gift.rpy:193
translate russian bree_gift_collar_male_036616fe:
    "И буквально выхватывает ошейник у меня из рук."

# ch/bree/gift.rpy:195
translate russian bree_gift_collar_male_eba9cddf:
    bree.say "ОГО!"

# ch/bree/gift.rpy:196
translate russian bree_gift_collar_male_791a3253:
    bree.say "Нет, серьёзно, ОГО!"

# ch/bree/gift.rpy:197
translate russian bree_gift_collar_male_d457dfd0:
    bree.say "Как ты, чёрт возьми, догадался?!"

# ch/bree/gift.rpy:198
translate russian bree_gift_collar_male_0a880397:
    "Внезапный восторг [bree.name] застаёт меня врасплох."

# ch/bree/gift.rpy:199
translate russian bree_gift_collar_male_b730d2c5:
    "С трудом беру себя в руки, чтобы ответить."

# ch/bree/gift.rpy:200
translate russian bree_gift_collar_male_c49e7e64:
    mike.say "Ну, понимаешь, [bree.name]..."

# ch/bree/gift.rpy:201
translate russian bree_gift_collar_male_831c0209:
    mike.say "Мы, современные мужчины, тонко чувствуем такие вещи."

# ch/bree/gift.rpy:202
translate russian bree_gift_collar_male_7449e842:
    mike.say "Улавливаем даже самые деликатные намёки девушки..."

# ch/bree/gift.rpy:203
translate russian bree_gift_collar_male_14bf4cf9:
    "[bree.name] нетерпеливо кивает, но, кажется, совсем меня не слушает."

# ch/bree/gift.rpy:204
translate russian bree_gift_collar_male_d54cbb41:
    "Она поднимает ошейник и начинает убирать волосы с шеи."

# ch/bree/gift.rpy:205
translate russian bree_gift_collar_male_34fda1e8:
    bree.say "Да-да..."

# ch/bree/gift.rpy:206
translate russian bree_gift_collar_male_c5e9cb95:
    bree.say "Как скажешь..."

# ch/bree/gift.rpy:207
translate russian bree_gift_collar_male_b84ca2ab:
    bree.say "Поможешь мне с этой штукой?"

# ch/bree/gift.rpy:212
translate russian bree_gift_collar_male_7b51b6f7:
    "Я киваю и поспешно подчиняюсь."

# ch/bree/gift.rpy:215
translate russian bree_gift_collar_male_e72139a0:
    "Через несколько секунд ошейник уже застёгнут."

# ch/bree/gift.rpy:216
translate russian bree_gift_collar_male_5437c291:
    "[bree.name] с радостью опускает на него взгляд и смеётся."

# ch/bree/gift.rpy:217
translate russian bree_gift_collar_male_569bea09:
    "Поднимает руки, будто собачка, которой велели просить лакомство."

# ch/bree/gift.rpy:218
translate russian bree_gift_collar_male_84ad5171:
    "Высовывает язык и начинает часто дышать."

# ch/bree/gift.rpy:219
translate russian bree_gift_collar_male_f1d0e7c2:
    bree.say "Ну как, [hero.name]?"

# ch/bree/gift.rpy:220
translate russian bree_gift_collar_male_b10a0ac8:
    bree.say "Позволишь мне стать твоей домашней сучкой?"

# ch/bree/gift.rpy:221
translate russian bree_gift_collar_male_0b48a897:
    bree.say "Пусть я не породистая, зато ОЧЕНЬ послушная!"

# ch/bree/gift.rpy:222
translate russian bree_gift_collar_male_50df2899:
    bree.say "А какие трюки я для тебя умею..."

# ch/bree/gift.rpy:223
translate russian bree_gift_collar_male_9bd16cb9:
    "Внезапно я чувствую, как краснею от смущения."

# ch/bree/gift.rpy:224
translate russian bree_gift_collar_male_060a72c3:
    "Это ведь я собирался убеждать [bree.name], что идея хорошая."

# ch/bree/gift.rpy:225
translate russian bree_gift_collar_male_4a5ae58e:
    "А теперь она ухитрилась перевернуть всё с ног на голову!"

# ch/bree/gift.rpy:226
translate russian bree_gift_collar_male_99b01efb:
    mike.say "З-звучит отлично, [bree.name]!"

# ch/bree/gift.rpy:227
translate russian bree_gift_collar_male_6136b4ee:
    mike.say "Но, может, немного подождём?"

# ch/bree/gift.rpy:228
translate russian bree_gift_collar_male_bbd04dfa:
    mike.say "Хотя бы пока не окажемся в более уединённом месте?"

# ch/bree/gift.rpy:229
translate russian bree_gift_collar_male_303a5559:
    "Вместо улыбки [bree.name] демонстративно надувает губы."

# ch/bree/gift.rpy:230
translate russian bree_gift_collar_male_709b41ad:
    "И ОЧЕНЬ убедительно скулит."

# ch/bree/gift.rpy:231
translate russian bree_gift_collar_male_dd5af811:
    bree.say "Ну вот... теперь твоему щеночку грустно!"

# ch/bree/gift.rpy:232
translate russian bree_gift_collar_male_b4d37717:
    bree.say "Придётся с ней поиграть, [hero.name]!"

# ch/bree/gift.rpy:233
translate russian bree_gift_collar_male_4f11c48d:
    bree.say "А она уже знает, в какие игры ей хочется..."

# ch/bree/gift.rpy:234
translate russian bree_gift_collar_male_acde0bb4:
    "[bree.name] берёт меня за руку и ведёт бог знает куда."

# ch/bree/gift.rpy:235
translate russian bree_gift_collar_male_de4c8858:
    "Я с волнением предвкушаю то, что она задумала."

# ch/bree/gift.rpy:236
translate russian bree_gift_collar_male_d3d0b9b8:
    "Надеюсь только, место будет менее людным!"

# ch/bree/gift.rpy:240
translate russian bree_gift_collar_male_d54c9b2e_1:
    "Но [bree.name] быстро избавляет меня от сомнений."

# ch/bree/gift.rpy:243
translate russian bree_gift_collar_male_573024a9:
    "Она ахает — явно от ужаса."

# ch/bree/gift.rpy:244
translate russian bree_gift_collar_male_f9ade02a:
    "И показывает на ошейник у меня в руках."

# ch/bree/gift.rpy:245
translate russian bree_gift_collar_male_da7930aa:
    bree.say "Это ещё ЧТО ТАКОЕ?!"

# ch/bree/gift.rpy:246
translate russian bree_gift_collar_male_370d4cd4:
    bree.say "Похоже на то, что надевают на собак!"

# ch/bree/gift.rpy:247
translate russian bree_gift_collar_male_a4f285dc:
    bree.say "По-твоему, это смешно?!"

# ch/bree/gift.rpy:248
translate russian bree_gift_collar_male_06c271be:
    "Застигнутый врасплох, я качаю головой."

# ch/bree/gift.rpy:249
translate russian bree_gift_collar_male_60011c00:
    "Такой реакции я определённо не ожидал."

# ch/bree/gift.rpy:250
translate russian bree_gift_collar_male_4210b0ff:
    "Ни оправдания, ни объяснения наготове у меня нет."

# ch/bree/gift.rpy:251
translate russian bree_gift_collar_male_22ed606c:
    mike.say "Э-это просто ради забавы, [bree.name]!"

# ch/bree/gift.rpy:252
translate russian bree_gift_collar_male_0f31f5a2:
    mike.say "Ну, можно надеть и посмеяться!"

# ch/bree/gift.rpy:253
translate russian bree_gift_collar_male_f7d60971:
    mike.say "В чём проблема?"

# ch/bree/gift.rpy:254
translate russian bree_gift_collar_male_8eac1891:
    "Услышав мои слова, [bree.name] качает головой."

# ch/bree/gift.rpy:255
translate russian bree_gift_collar_male_ee5949ca:
    "Словно не верит собственным ушам."

# ch/bree/gift.rpy:258
translate russian bree_gift_collar_male_0708fb0b:
    bree.say "Ты совсем рехнулся?"

# ch/bree/gift.rpy:259
translate russian bree_gift_collar_male_16a4cca2:
    bree.say "Это грёбаный собачий ошейник!"

# ch/bree/gift.rpy:260
translate russian bree_gift_collar_male_bb778a9c:
    bree.say "И что мне, по-твоему, в нём делать?"

# ch/bree/gift.rpy:261
translate russian bree_gift_collar_male_4f72bf33:
    bree.say "Нюхать твою промежность?"

# ch/bree/gift.rpy:262
translate russian bree_gift_collar_male_8c11405d:
    bree.say "Ссать и срать на людях?!"

# ch/bree/gift.rpy:263
translate russian bree_gift_collar_male_c18ce9f4:
    "[bree.name] в ярости всплёскивает руками."

# ch/bree/gift.rpy:264
translate russian bree_gift_collar_male_eafb757e:
    "И громко топает ногой."

# ch/bree/gift.rpy:265
translate russian bree_gift_collar_male_9e7a22e9:
    "Я невольно отскакиваю."

# ch/bree/gift.rpy:266
translate russian bree_gift_collar_male_bc453149:
    "Вдруг она сейчас ещё и замахнётся!"

# ch/bree/gift.rpy:267
translate russian bree_gift_collar_male_77830841:
    mike.say "Ладно, [bree.name], ладно!"

# ch/bree/gift.rpy:268
translate russian bree_gift_collar_male_a2b8081e:
    mike.say "Всё, понял!"

# ch/bree/gift.rpy:269
translate russian bree_gift_collar_male_a0a9ace3:
    mike.say "Тебе не нравится ошейник. Я понял!"

# ch/bree/gift.rpy:270
translate russian bree_gift_collar_male_adf2e4fc:
    bree.say "Правда, [hero.name]?"

# ch/bree/gift.rpy:271
translate russian bree_gift_collar_male_960b2e88:
    bree.say "Точно понял?"

# ch/bree/gift.rpy:272
translate russian bree_gift_collar_male_e5fae068:
    bree.say "Потому что такие выходки заставляют меня сомневаться!"

# ch/bree/gift.rpy:273
translate russian bree_gift_collar_male_a8c47ebc:
    "С этими словами [bree.name] резко разворачивается и уходит."

# ch/bree/gift.rpy:274
translate russian bree_gift_collar_male_fb8354c8:
    "А я остаюсь один, по-прежнему сжимая ошейник."

# ch/bree/gift.rpy:275
translate russian bree_gift_collar_male_b608816e:
    "Не до конца понимаю, что только что произошло."

# ch/bree/gift.rpy:276
translate russian bree_gift_collar_male_608ccd7c:
    "Неужели я настолько неверно всё оценил?"

# ch/bree/gift.rpy:277
translate russian bree_gift_collar_male_d57dbee3:
    "И если так, не испортил ли я отношения с [bree.name]?"

# ch/bree/gift.rpy:278
translate russian bree_gift_collar_male_5f5ac615:
    "Может, даже безвозвратно?"

# ch/bree/gift.rpy:287
translate russian bree_gift_sexy_dress_male_acf98931:
    bree.say "Ой, [hero.name], это мне?"

# ch/bree/gift.rpy:288
translate russian bree_gift_sexy_dress_male_8b8f6d76:
    "Она разворачивает сексуальное платье."

# ch/bree/gift.rpy:291
translate russian bree_gift_sexy_dress_male_059a9364:
    bree.say "Спасибо, [hero.name]."

# ch/bree/gift.rpy:297
translate russian bree_gift_sexy_dress_male_732fa38e:
    bree.say "Спасибо, но я откажусь, [hero.name]. Мне в таком будет ужасно неловко..."

# ch/bree/gift.rpy:303
translate russian bree_gift_slutty_dress_male_e6dd61b7:
    bree.say "Эй, [hero.name]..."

# ch/bree/gift.rpy:304
translate russian bree_gift_slutty_dress_male_90845088:
    bree.say "Что это у тебя там?"

# ch/bree/gift.rpy:306
translate russian bree_gift_slutty_dress_male_eb604713:
    "[bree.name] словно возникает передо мной из ниоткуда."

# ch/bree/gift.rpy:307
translate russian bree_gift_slutty_dress_male_64eef92c:
    "Серьёзно: секунду назад её нигде не было, а теперь она прямо перед моим носом."

# ch/bree/gift.rpy:308
translate russian bree_gift_slutty_dress_male_585c68fc:
    "Я вздрагиваю и неловко прячу за спиной то, что держу."

# ch/bree/gift.rpy:309
translate russian bree_gift_slutty_dress_male_714e4816:
    mike.say "А-А-А!"

# ch/bree/gift.rpy:310
translate russian bree_gift_slutty_dress_male_ec4150dc:
    mike.say "Какого..."

# ch/bree/gift.rpy:311
translate russian bree_gift_slutty_dress_male_7a0278f6:
    "[bree.name] пытается юркнуть мне за спину, и я едва успеваю поворачиваться следом."

# ch/bree/gift.rpy:312
translate russian bree_gift_slutty_dress_male_d4ee8848:
    "Мы нелепо кружим на месте, и я чувствую себя затравленным крабом."

# ch/bree/gift.rpy:314
translate russian bree_gift_slutty_dress_male_d17451a0:
    bree.say "Ну же, [hero.name]..."

# ch/bree/gift.rpy:315
translate russian bree_gift_slutty_dress_male_b3270036:
    bree.say "Я ведь вижу обёрточную бумагу и бантик."

# ch/bree/gift.rpy:316
translate russian bree_gift_slutty_dress_male_176593cd:
    bree.say "Значит, это подарок."

# ch/bree/gift.rpy:317
translate russian bree_gift_slutty_dress_male_5d479bb1:
    bree.say "А если он не мне, зачем ты его прячешь?"

# ch/bree/gift.rpy:319
translate russian bree_gift_slutty_dress_male_114b5cd9:
    "Понимаю, что переубедить [bree.name] не выйдет."

# ch/bree/gift.rpy:320
translate russian bree_gift_slutty_dress_male_3ee712f7:
    "Тем более она совершенно права."

# ch/bree/gift.rpy:321
translate russian bree_gift_slutty_dress_male_eb8e255b:
    "Так зачем продолжать этот спектакль?"

# ch/bree/gift.rpy:322
translate russian bree_gift_slutty_dress_male_6e154b71:
    mike.say "Ладно, ладно..."

# ch/bree/gift.rpy:323
translate russian bree_gift_slutty_dress_male_55ac19ad:
    mike.say "Твоя взяла, [bree.name]. Сдаюсь!"

# ch/bree/gift.rpy:324
translate russian bree_gift_slutty_dress_male_a302ff83:
    "Я достаю коробку и протягиваю её [bree.name]."

# ch/bree/gift.rpy:325
translate russian bree_gift_slutty_dress_male_7d27bf70:
    "Она тут же начинает подпрыгивать на месте."

# ch/bree/gift.rpy:327
translate russian bree_gift_slutty_dress_male_95cabaf9:
    bree.say "Ого!"

# ch/bree/gift.rpy:328
translate russian bree_gift_slutty_dress_male_84bef466:
    bree.say "Огромное спасибо, [hero.name]!"

# ch/bree/gift.rpy:329
translate russian bree_gift_slutty_dress_male_c4c44bd4:
    bree.say "Это так..."

# ch/bree/gift.rpy:330
translate russian bree_gift_slutty_dress_male_bd61c179:
    bree.say "Ничего себе!"

# ch/bree/gift.rpy:332
translate russian bree_gift_slutty_dress_male_3f5a2d7c:
    "[bree.name] достаёт из коробки откровенное платье и разворачивает его."

# ch/bree/gift.rpy:333
translate russian bree_gift_slutty_dress_male_4a34b2e7:
    "Потом смотрит на него, кажется, в полном изумлении."

# ch/bree/gift.rpy:335
translate russian bree_gift_slutty_dress_male_b7b82dbe:
    "Она молчит, и я чувствую, что надо что-нибудь сказать."

# ch/bree/gift.rpy:336
translate russian bree_gift_slutty_dress_male_6757cf6b:
    mike.say "Ну..."

# ch/bree/gift.rpy:337
translate russian bree_gift_slutty_dress_male_5b921c1f:
    mike.say "Твоё молчание означает, что ты ошеломлена?"

# ch/bree/gift.rpy:338
translate russian bree_gift_slutty_dress_male_7eaf2835:
    mike.say "Просто потеряла дар речи?"

# ch/bree/gift.rpy:340
translate russian bree_gift_slutty_dress_male_4fe1bc70:
    "Мой голос словно выводит [bree.name] из транса."

# ch/bree/gift.rpy:341
translate russian bree_gift_slutty_dress_male_2826d963:
    "Ещё не успев ответить, она уже кивает."

# ch/bree/gift.rpy:343
translate russian bree_gift_slutty_dress_male_a2ef6a38:
    bree.say "Да, [hero.name]..."

# ch/bree/gift.rpy:344
translate russian bree_gift_slutty_dress_male_02592898:
    bree.say "Потеряла дар речи от твоей смелости!"

# ch/bree/gift.rpy:345
translate russian bree_gift_slutty_dress_male_06c6d4f3:
    bree.say "Серьёзно, я бы сама ни за что до такого не додумалась."

# ch/bree/gift.rpy:347
translate russian bree_gift_slutty_dress_male_b5b32a21:
    "Я с растущим удовольствием смотрю, как [bree.name] прикладывает платье к себе."

# ch/bree/gift.rpy:348
translate russian bree_gift_slutty_dress_male_da524483:
    "Ведь по ней видно, насколько оно ей нравится."

# ch/bree/gift.rpy:350
translate russian bree_gift_slutty_dress_male_6c37ff31:
    bree.say "А теперь понимаю, чего себя лишала!"

# ch/bree/gift.rpy:351
translate russian bree_gift_slutty_dress_male_8a6ac858:
    "Слушая [bree.name], я охотно киваю."

# ch/bree/gift.rpy:352
translate russian bree_gift_slutty_dress_male_3b5d67d1:
    "И всё ещё с трудом верю, что она в таком восторге."

# ch/bree/gift.rpy:353
translate russian bree_gift_slutty_dress_male_3216dd00:
    mike.say "Ну, тут не только моя заслуга, [bree.name]."

# ch/bree/gift.rpy:354
translate russian bree_gift_slutty_dress_male_e97c213f:
    mike.say "Без тебя я бы до этого не додумался."

# ch/bree/gift.rpy:355
translate russian bree_gift_slutty_dress_male_f6788962:
    mike.say "Я представил тебя в чём-то подобном..."

# ch/bree/gift.rpy:356
translate russian bree_gift_slutty_dress_male_959cda68:
    mike.say "И это вдохновило меня рискнуть."

# ch/bree/gift.rpy:357
translate russian bree_gift_slutty_dress_male_1ed5cf3e:
    "[bree.name] смотрит на меня почти обжигающим взглядом."

# ch/bree/gift.rpy:358
translate russian bree_gift_slutty_dress_male_5d14b2c7:
    "А на её лице появляется чуть ли не хищная улыбка."

# ch/bree/gift.rpy:360
translate russian bree_gift_slutty_dress_male_3794a36c:
    bree.say "Нужен повод надеть это платье, [hero.name]..."

# ch/bree/gift.rpy:361
translate russian bree_gift_slutty_dress_male_0783af78:
    bree.say "И поскорее!"

# ch/bree/gift.rpy:363
translate russian bree_gift_slutty_dress_male_3f8382ca:
    mike.say "Ого..."

# ch/bree/gift.rpy:364
translate russian bree_gift_slutty_dress_male_6e154b71_1:
    mike.say "Ладно, ладно..."

# ch/bree/gift.rpy:365
translate russian bree_gift_slutty_dress_male_1979cf32:
    mike.say "Уже ломаю голову изо всех сил!"

# ch/bree/gift.rpy:366
translate russian bree_gift_slutty_dress_male_fd13c17a:
    "И я не преувеличиваю: мысли действительно несутся наперегонки."

# ch/bree/gift.rpy:367
translate russian bree_gift_slutty_dress_male_0033cc3f:
    "Отчаянно пытаюсь на ходу что-нибудь придумать."

# ch/bree/gift.rpy:368
translate russian bree_gift_slutty_dress_male_5ceff1f8:
    "Потому что сейчас больше всего на свете хочу увидеть [bree.name] в этом платье!"

# ch/bree/gift.rpy:372
translate russian bree_gift_slutty_dress_male_4fe1bc70_1:
    "Мой голос словно выводит [bree.name] из транса."

# ch/bree/gift.rpy:373
translate russian bree_gift_slutty_dress_male_03ba5d85:
    "Ещё не успев ответить, она уже качает головой."

# ch/bree/gift.rpy:375
translate russian bree_gift_slutty_dress_male_a2ef6a38_1:
    bree.say "Да, [hero.name]..."

# ch/bree/gift.rpy:376
translate russian bree_gift_slutty_dress_male_00918d19:
    bree.say "Потеряла дар речи от того, насколько плохо ты разбираешься в платьях!"

# ch/bree/gift.rpy:378
translate russian bree_gift_slutty_dress_male_93236d15:
    "Ответ [bree.name] заметно сбивает с меня спесь."

# ch/bree/gift.rpy:379
translate russian bree_gift_slutty_dress_male_c8676877:
    "Да, платье довольно броское, но вовсе не вульгарное."

# ch/bree/gift.rpy:380
translate russian bree_gift_slutty_dress_male_60e205db:
    "Я бы скорее назвал его авангардным."

# ch/bree/gift.rpy:381
translate russian bree_gift_slutty_dress_male_22f0c35c:
    mike.say "Серьезно, [bree.name]?"

# ch/bree/gift.rpy:382
translate russian bree_gift_slutty_dress_male_bfddaf54:
    mike.say "Я думал, ты свободнее от предрассудков!"

# ch/bree/gift.rpy:384
translate russian bree_gift_slutty_dress_male_e860fe62:
    bree.say "А ты, похоже, настолько освободил голову, что мозги выпали!"

# ch/bree/gift.rpy:385
translate russian bree_gift_slutty_dress_male_4e0db71a:
    bree.say "Надеюсь, ты хотя бы сохранил чек."

# ch/bree/gift.rpy:387
translate russian bree_gift_slutty_dress_male_84b3e376:
    "С этими словами [bree.name] суёт платье обратно мне в руки."

# ch/bree/gift.rpy:388
translate russian bree_gift_slutty_dress_male_2cf3f757:
    "И уходит, качая головой и что-то бормоча себе под нос."

# ch/bree/gift.rpy:395
translate russian bree_gift_butt_plug_male_acf98931:
    bree.say "Ой, [hero.name], это мне?"

# ch/bree/gift.rpy:396
translate russian bree_gift_butt_plug_male_1a19f559:
    "Она разворачивает анальную пробку."

# ch/bree/gift.rpy:399
translate russian bree_gift_butt_plug_male_cff0a49c:
    bree.say "..."

# ch/bree/gift.rpy:400
translate russian bree_gift_butt_plug_male_901dcfca:
    bree.say "Оставь себе... Мне это не нужно, так что забирай."

# ch/bree/gift.rpy:401
translate russian bree_gift_butt_plug_male_b0b9faa4:
    bree.say "Уверена, тебе оно пригодится больше, чем мне."

# ch/bree/gift.rpy:405
translate russian bree_gift_butt_plug_male_69dc6133:
    bree.say "Просто идеально!"

# ch/bree/gift.rpy:407
translate russian bree_gift_butt_plug_male_4d7fcff5:
    bree.say "Спасибо, [hero.name]. Обязательно пригодится."

# ch/bree/reactions.rpy:2
translate russian bree_ice_cream_reaction_male_0ff08367:
    mike.say "Знаешь, что нам сейчас нужно для полного счастья, [bree.name]? Мороженое!"

# ch/bree/reactions.rpy:3
translate russian bree_ice_cream_reaction_male_01a9b132:
    bree.say "О да! С мороженым всё становится лучше!"

# ch/bree/reactions.rpy:4
translate russian bree_ice_cream_reaction_male_73a4ddd7:
    "У киоска с мороженым я покупаю рожок с парой разных шариков."

# ch/bree/reactions.rpy:5
translate russian bree_ice_cream_reaction_male_ff8d40b4:
    "[bree.name] берёт такой же рожок, но выбирает другое сочетание вкусов."

# ch/bree/reactions.rpy:6
translate russian bree_ice_cream_reaction_male_3bde6de0:
    bree.say "М-м-м... как вкусно!"

# ch/bree/reactions.rpy:7
translate russian bree_ice_cream_reaction_male_18f47563:
    bree.say "Я... ой, холодно!"

# ch/bree/reactions.rpy:8
translate russian bree_ice_cream_reaction_male_8bd0771a:
    "Я смотрю вниз вслед за [bree.name] и невольно распахиваю глаза."

# ch/bree/reactions.rpy:9
translate russian bree_ice_cream_reaction_male_fd0898be:
    "Мороженое из её рожка тает и стекает прямо ей на грудь!"

# ch/bree/reactions.rpy:10
translate russian bree_ice_cream_reaction_male_1f296b57:
    bree.say "Ой, какой ужас! Наверное, ты считаешь меня ужасной растяпой!"

# ch/bree/reactions.rpy:11
translate russian bree_ice_cream_reaction_male_578a8ca3:
    mike.say "А... да, [bree.name]... именно об этом я сейчас и думаю!"

# ch/bree/reactions.rpy:15
translate russian bree_study_with_intro_male_41dd22ef:
    "В последнее время [bree.name] усердно грызёт гранит науки, занимаясь при любой возможности."

# ch/bree/reactions.rpy:16
translate russian bree_study_with_intro_male_3ef9ac6d:
    "Ну а я, как порядочный человек, просто обязан был предложить помощь."

# ch/bree/reactions.rpy:17
translate russian bree_study_with_intro_male_66c7bf32:
    "И вот мы сидим среди её книг и вместе продираемся через материал."

# ch/bree/reactions.rpy:18
translate russian bree_study_with_intro_male_bd02b7d8:
    bree.say "Просто хотела сказать спасибо, [hero.name]."

# ch/bree/reactions.rpy:19
translate russian bree_study_with_intro_male_14a543ac:
    bree.say "Очень здорово, что ты мне помогаешь!"

# ch/bree/reactions.rpy:20
translate russian bree_study_with_intro_male_e3b2765b:
    mike.say "Не за что, [bree.name]."

# ch/bree/reactions.rpy:21
translate russian bree_study_with_intro_male_bb766d06:
    mike.say "Для этого и нужны друзья, правда?"

# ch/bree/reactions.rpy:22
translate russian bree_study_with_intro_male_77ebd857:
    "[bree.name] радостно кивает и снова с головой погружается в книги."

# ch/bree/reactions.rpy:23
translate russian bree_study_with_intro_male_d225555f:
    "Вскоре я увлекаюсь не меньше неё!"

# ch/bree/reactions.rpy:24
translate russian bree_study_with_intro_male_079d21b5:
    "Поначалу мне вполне удаётся за ней поспевать."

# ch/bree/reactions.rpy:25
translate russian bree_study_with_intro_male_6ad52d11:
    "Но потом [bree.name] натыкается на задачу, которая ставит её в тупик."

# ch/bree/reactions.rpy:26
translate russian bree_study_with_intro_male_ec4f9c86:
    bree.say "Ах..."

# ch/bree/reactions.rpy:27
translate russian bree_study_with_intro_male_ec59b5f9:
    bree.say "С ума сейчас сойду!"

# ch/bree/reactions.rpy:28
translate russian bree_study_with_intro_male_f1d0e7c2:
    bree.say "Ну как, [hero.name]?"

# ch/bree/reactions.rpy:29
translate russian bree_study_with_intro_male_d9778d3b:
    "Я наклоняюсь, чтобы лучше рассмотреть страницу."

# ch/bree/reactions.rpy:30
translate russian bree_study_with_intro_male_0dc8423c:
    "Моя щека почти касается щеки [bree.name]."

# ch/bree/reactions.rpy:34
translate russian bree_study_with_success_male_e3b3aff5:
    "Некоторое время внимательно изучаю страницу сверху донизу."

# ch/bree/reactions.rpy:35
translate russian bree_study_with_success_male_940acdda:
    "Просматриваю всё, что на ней написано."

# ch/bree/reactions.rpy:36
translate russian bree_study_with_success_male_2bd8f3ac:
    "И тут краем глаза замечаю грудь [bree.name]."

# ch/bree/reactions.rpy:37
translate russian bree_study_with_success_male_27c11298:
    "Конечно, хочется присмотреться повнимательнее!"

# ch/bree/reactions.rpy:38
translate russian bree_study_with_success_male_843bbb89:
    "Но я понимаю, что сейчас важнее разобраться с задачей."

# ch/bree/reactions.rpy:39
translate russian bree_study_with_success_male_e1d914e5:
    mike.say "Хм..."

# ch/bree/reactions.rpy:40
translate russian bree_study_with_success_male_2666d110:
    mike.say "Не уверен, [bree.name]."

# ch/bree/reactions.rpy:41
translate russian bree_study_with_success_male_d86ba035:
    mike.say "Но она напоминает задачу, которая была парой страниц раньше."

# ch/bree/reactions.rpy:42
translate russian bree_study_with_success_male_e981ddb2:
    mike.say "Помнишь её?"

# ch/bree/reactions.rpy:43
translate russian bree_study_with_success_male_ba72dd1b:
    "[bree.name] хмурит брови."

# ch/bree/reactions.rpy:44
translate russian bree_study_with_success_male_dba3aa98:
    "И листает книгу назад."

# ch/bree/reactions.rpy:45
translate russian bree_study_with_success_male_a741d8b0:
    bree.say "Ты об этой?"

# ch/bree/reactions.rpy:46
translate russian bree_study_with_success_male_741c7c57:
    bree.say "А, да! Теперь вижу!"

# ch/bree/reactions.rpy:47
translate russian bree_study_with_success_male_bc040a2f:
    bree.say "Спасибо, [hero.name]."

# ch/bree/reactions.rpy:48
translate russian bree_study_with_success_male_9210621d:
    bree.say "Спасибо, сама бы ни за что не вспомнила!"

# ch/bree/reactions.rpy:49
translate russian bree_study_with_success_male_2a2b60a2:
    mike.say "Уверен, вспомнила бы, [bree.name]."

# ch/bree/reactions.rpy:50
translate russian bree_study_with_success_male_ea8f01b9:
    mike.say "Ты умнее, чем думаешь!"

# ch/bree/reactions.rpy:51
translate russian bree_study_with_success_male_889999c0:
    "От комплимента глаза [bree.name] расширяются."

# ch/bree/reactions.rpy:52
translate russian bree_study_with_success_male_7596ae34:
    "А щёки заливает румянец."

# ch/bree/reactions.rpy:53
translate russian bree_study_with_success_male_4f12f27e:
    "Но она всё равно мило улыбается моим словам."

# ch/bree/reactions.rpy:57
translate russian bree_study_with_failure_male_f4362110:
    "Едва взглянув на страницу, я понимаю: дело безнадёжное."

# ch/bree/reactions.rpy:58
translate russian bree_study_with_failure_male_3eed6b5d:
    "Вижу только мешанину слов и символов."

# ch/bree/reactions.rpy:59
translate russian bree_study_with_failure_male_7e076c86:
    "Ничего не понимаю!"

# ch/bree/reactions.rpy:60
translate russian bree_study_with_failure_male_47383fd3:
    "Хуже того, мне на глаза попадается грудь [bree.name]."

# ch/bree/reactions.rpy:61
translate russian bree_study_with_failure_male_97d0008d:
    "И с этого момента я могу думать только о ней!"

# ch/bree/reactions.rpy:62
translate russian bree_study_with_failure_male_30e74fc5:
    mike.say "Эм..."

# ch/bree/reactions.rpy:63
translate russian bree_study_with_failure_male_339179d1:
    mike.say "Не знаю, [bree.name]."

# ch/bree/reactions.rpy:64
translate russian bree_study_with_failure_male_74408a68:
    mike.say "Ты точно не вверх ногами на это смотришь?"

# ch/bree/reactions.rpy:65
translate russian bree_study_with_failure_male_ba72dd1b:
    "[bree.name] хмурит брови."

# ch/bree/reactions.rpy:66
translate russian bree_study_with_failure_male_10c0b9e8:
    "Она тоже опускает взгляд на страницу."

# ch/bree/reactions.rpy:67
translate russian bree_study_with_failure_male_f1548778:
    bree.say "Конечно, не вверх ногами!"

# ch/bree/reactions.rpy:68
translate russian bree_study_with_failure_male_4b6585fd:
    bree.say "Погоди... ты что..."

# ch/bree/reactions.rpy:69
translate russian bree_study_with_failure_male_211ef691:
    bree.say "Ты на мои сиськи пялишься!"

# ch/bree/reactions.rpy:70
translate russian bree_study_with_failure_male_23304a26:
    bree.say "Неудивительно, что толку от тебя никакого!"

# ch/bree/reactions.rpy:71
translate russian bree_study_with_failure_male_5f6e0eca:
    mike.say "Нет, подожди..."

# ch/bree/reactions.rpy:72
translate russian bree_study_with_failure_male_7cd79698:
    mike.say "Я не..."

# ch/bree/reactions.rpy:73
translate russian bree_study_with_failure_male_358b45fa:
    mike.say "То есть да... но..."

# ch/bree/reactions.rpy:74
translate russian bree_study_with_failure_male_abd5f302:
    bree.say "Ой, не надо, [hero.name]!"

# ch/bree/reactions.rpy:75
translate russian bree_study_with_failure_male_250b11aa:
    bree.say "Я могу заниматься сама."

# ch/bree/reactions.rpy:76
