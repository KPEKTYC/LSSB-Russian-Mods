# ch/bree/date.rpy:129
translate russian bree_date_pub_play_pool_140db425:
    "Держа копье в руке, [bree.name] заставляет меня бороться за свою жизнь у бильярдного стола."

# ch/bree/date.rpy:130
translate russian bree_date_pub_play_pool_606fc9da:
