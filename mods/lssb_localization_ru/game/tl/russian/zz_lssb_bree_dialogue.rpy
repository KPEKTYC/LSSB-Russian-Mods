# ch/bree/date.rpy:172
translate russian bree_date_play_arcade_intro_male_4103cdb4:
    mike.say "Подожди, [bree.name]!"

# ch/bree/date.rpy:173
translate russian bree_date_play_arcade_intro_male_a701e886:
    mike.say "У нас полно времени, чтобы все это посмотреть."

# ch/bree/date.rpy:174
translate russian bree_date_play_arcade_intro_male_5f888d96:
    "[bree.name] смотрит на меня так, будто я говорю ерунду."

# ch/bree/date.rpy:175
translate russian bree_date_play_arcade_intro_male_02f85185:
    "И она качает головой в недоумении."

# ch/bree/date.rpy:176
translate russian bree_date_play_arcade_intro_male_3e44fc12:
    bree.say "Вау!"

# ch/bree/date.rpy:177
translate russian bree_date_play_arcade_intro_male_3e20a98f:
