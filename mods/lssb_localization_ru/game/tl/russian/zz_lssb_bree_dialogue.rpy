    bree.say "О...Боже..."

# ch/bree/date.rpy:268
translate russian bree_dick_reactions_ac59b097:
    bree.say "Мы живем вместе уже так долго, [hero.name]."

# ch/bree/date.rpy:269
translate russian bree_dick_reactions_ee009eb5:
