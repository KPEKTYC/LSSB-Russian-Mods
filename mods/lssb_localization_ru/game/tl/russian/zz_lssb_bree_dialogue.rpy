# ch/bree/date.rpy:229
translate russian bree_date_play_arcade_lose_male_1e891edb:
    "И я ничего не могу сделать, чтобы догнать ее."

# ch/bree/date.rpy:230
translate russian bree_date_play_arcade_lose_male_a78eefd3:
    "Я слышу, как мы оба отчаянно жмём кнопки."

# ch/bree/date.rpy:231
translate russian bree_date_play_arcade_lose_male_73bf1e6d:
    "Но я также слышу, как тяжело дышит [bree.name]."

# ch/bree/date.rpy:232
translate russian bree_date_play_arcade_lose_male_36e5acb8:
    "Она, наверное, сейчас подпрыгивает на месте!"

# ch/bree/date.rpy:233
translate russian bree_date_play_arcade_lose_male_c1d2ed6f:
    "Хочется взглянуть на неё, понимаешь?"

# ch/bree/date.rpy:234
translate russian bree_date_play_arcade_lose_male_33b13f2d:
