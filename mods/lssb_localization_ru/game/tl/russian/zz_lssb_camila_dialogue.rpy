# ch/camila/talk.rpy:509
translate russian camila_talk_investigation_male_791365b3:
    camila.say "Чего тебе тогда бояться?"

# ch/camila/talk.rpy:510
translate russian camila_talk_investigation_male_7dcd7ae6:
    "Я выдавливаю нервную улыбку и киваю."

# ch/camila/talk.rpy:511
translate russian camila_talk_investigation_male_c258ffc8:
    mike.say "А... да, Камила!"

# ch/camila/talk.rpy:512
translate russian camila_talk_investigation_male_74ab4901:
    mike.say "Всё верно..."

# ch/camila/talk.rpy:553
translate russian submissive_interact_camila_male_dcf0bd4b:
    mike.say "Эй, Камила..."

# ch/camila/talk.rpy:554
translate russian submissive_interact_camila_male_b28f50c4:
    mike.say "Знаешь, что было бы забавно?"

# ch/camila/talk.rpy:555
translate russian submissive_interact_camila_male_5b41ba41:
