# ch/camila/gift.rpy:310
translate russian camila_gift_swimsuit_male_5ecb4878:
    camila.say "Но ты ведь..."

# ch/camila/gift.rpy:311
translate russian camila_gift_swimsuit_male_0c77a314:
    camila.say "Ты же видел некоторые мои шрамы, правда?"

# ch/camila/gift.rpy:312
translate russian camila_gift_swimsuit_male_474b26ab:
    "В ответ на её вопрос я могу лишь моргнуть."

# ch/camila/gift.rpy:313
translate russian camila_gift_swimsuit_male_ab1e6cca:
    "Просто не понимаю, при чём тут это."

# ch/camila/gift.rpy:314
translate russian camila_gift_swimsuit_male_70cba8e0:
    mike.say "Ну да, Камила."

# ch/camila/gift.rpy:315
translate russian camila_gift_swimsuit_male_234940d0:
    mike.say "Но разве это проблема?"

# ch/camila/gift.rpy:316
translate russian camila_gift_swimsuit_male_453d6751:
    mike.say "Ты ведь получила их при исполнении?"

# ch/camila/gift.rpy:317
translate russian camila_gift_swimsuit_male_70ccd27e:
    mike.say "И меня... меня они даже немного заводят!"

# ch/camila/gift.rpy:318
translate russian camila_gift_swimsuit_male_ca9803fe:
    "От моих слов щёки Камилы краснеют."

# ch/camila/gift.rpy:319
translate russian camila_gift_swimsuit_male_fcc40f0b:
    "Не сразу до меня доходит, что она и правда смущена."

# ch/camila/gift.rpy:320
translate russian camila_gift_swimsuit_male_3e1e3014:
    "Я заставил покраснеть этого сурового копа!"

# ch/camila/gift.rpy:321
translate russian camila_gift_swimsuit_male_16d02245:
    camila.say "П... правда?!?"

# ch/camila/gift.rpy:322
translate russian camila_gift_swimsuit_male_79edea29:
    camila.say "Ну, пожалуй, я могу примерить."

# ch/camila/gift.rpy:323
translate russian camila_gift_swimsuit_male_17d51cab:
    camila.say "Раз уж ты так старался, выбирая его..."

# ch/camila/gift.rpy:324
translate russian camila_gift_swimsuit_male_974cb74a:
    "Кажется, после этого Камила говорит что-то ещё."

# ch/camila/gift.rpy:325
translate russian camila_gift_swimsuit_male_ef8ce611:
    "Но, честно говоря, я всё пропускаю мимо ушей."

# ch/camila/gift.rpy:326
translate russian camila_gift_swimsuit_male_549d24a3:
    "Потому что в голове уже возникают её образы."

# ch/camila/gift.rpy:327
translate russian camila_gift_swimsuit_male_85b39d67:
    "Её образы в этом самом купальнике..."

# ch/camila/gift.rpy:332
translate russian camila_gift_swimsuit_male_3beb9c9f:
    "На лице Камилы появляется беспомощное разочарование."

# ch/camila/gift.rpy:333
translate russian camila_gift_swimsuit_male_bc73338c:
    "А когда она ещё и качает головой, я понимаю: всё идёт не по моему плану."

# ch/camila/gift.rpy:334
translate russian camila_gift_swimsuit_male_607224ba:
    camila.say "Эм... он... симпатичный, [lssb_camila.hero_name()]."

# ch/camila/gift.rpy:335
translate russian camila_gift_swimsuit_male_e2cdf353:
    camila.say "Но проблема в том, что это не моё!"

# ch/camila/gift.rpy:336
translate russian camila_gift_swimsuit_male_a6047c65:
    camila.say "Не пойми неправильно: очень мило, что ты купил мне подарок!"

# ch/camila/gift.rpy:337
translate russian camila_gift_swimsuit_male_cbcb0987:
    "Я киваю, принимая купальник обратно."

# ch/camila/gift.rpy:338
translate russian camila_gift_swimsuit_male_23ccd46a:
    "И всё это время пытаюсь не показать, насколько расстроен."

# ch/camila/gift.rpy:339
translate russian camila_gift_swimsuit_male_19bdb0f9:
    mike.say "Я... прости, Камила."

# ch/camila/gift.rpy:340
translate russian camila_gift_swimsuit_male_bb6046f5:
    mike.say "Наверное, сначала стоило спросить..."

# ch/camila/gift.rpy:341
translate russian camila_gift_swimsuit_male_206b4b5c:
    "Услышав это, Камила качает головой."

# ch/camila/gift.rpy:342
translate russian camila_gift_swimsuit_male_f06b8364:
    "И не нужно быть гением, чтобы понять: я заставил её почувствовать вину."

# ch/camila/gift.rpy:343
translate russian camila_gift_swimsuit_male_cb0625c0:
    camila.say "Нет, [lssb_camila.hero_name()], дело не в тебе, а во мне."

# ch/camila/gift.rpy:344
translate russian camila_gift_swimsuit_male_fe6ea99e:
    camila.say "Мне... мне трудно показывать своё тело, вот и всё."

# ch/camila/gift.rpy:345
translate russian camila_gift_swimsuit_male_37eeaa34:
    camila.say "Это глупо, но ничего не могу с собой поделать!"

# ch/camila/gift.rpy:346
translate russian camila_gift_swimsuit_male_3e4c6769:
    "Я знаю, что она пытается меня утешить."

# ch/camila/gift.rpy:347
translate russian camila_gift_swimsuit_male_a726b48e:
    "Но от этого я лишь сильнее чувствую себя бестолковым."

# ch/camila/gift.rpy:348
translate russian camila_gift_swimsuit_male_94abbecf:
    "У Камилы явно есть болезненная тема, а я протоптался по ней как идиот!"

# ch/camila/gift.rpy:349
translate russian camila_gift_swimsuit_male_f186e4ea:
    mike.say "Давай просто забудем, ладно?"

# ch/camila/gift.rpy:350
translate russian camila_gift_swimsuit_male_5c190c01:
    camila.say "Конечно, [lssb_camila.hero_name()]."

# ch/camila/gift.rpy:351
translate russian camila_gift_swimsuit_male_50b2a51a:
    camila.say "Будем считать, что ничего не было!"

# ch/camila/gift.rpy:352
translate russian camila_gift_swimsuit_male_5382cc0e:
    "Я киваю и улыбаюсь, но легче мне от этого не становится."

# ch/camila/gift.rpy:357
translate russian camila_gift_collar_male_f6d28964:
    "Я прячу подарок для Камилы до тех пор, пока не наступит подходящий момент."

# ch/camila/gift.rpy:358
translate russian camila_gift_collar_male_08249ccd:
    "Если выбрать неудачное время, всё может очень быстро пойти наперекосяк."

# ch/camila/gift.rpy:359
translate russian camila_gift_collar_male_78ba9ff4:
    "И поверьте: это последнее, чего мне хочется!"

# ch/camila/gift.rpy:360
translate russian camila_gift_collar_male_8af8eccd:
    "Поэтому я жду, когда Камила будет в самом лучшем настроении."

# ch/camila/gift.rpy:361
translate russian camila_gift_collar_male_96c01fac:
    "Когда она смеётся и шутит так, будто у неё нет ни одной заботы."

# ch/camila/gift.rpy:362
translate russian camila_gift_collar_male_78ea234b:
    "Вот тогда я и лезу в карман, доставая то, что приготовил для неё..."

# ch/camila/gift.rpy:364
translate russian camila_gift_collar_male_3aa962b5:
    mike.say "Эм, Камила..."

# ch/camila/gift.rpy:365
translate russian camila_gift_collar_male_3665de2e:
    mike.say "Знаю, сегодня не праздник и не особый день."

# ch/camila/gift.rpy:366
translate russian camila_gift_collar_male_0711c819:
    mike.say "Но я купил тебе кое-что, что, по-моему, тебе понравится..."

# ch/camila/gift.rpy:367
translate russian camila_gift_collar_male_14aadb45:
    "Камила приподнимает брови, явно заинтригованная моим признанием."

# ch/camila/gift.rpy:368
translate russian camila_gift_collar_male_67871a3c:
    "Она изо всех сил поддерживает образ сурового, закалённого копа."

# ch/camila/gift.rpy:369
translate russian camila_gift_collar_male_4040cfda:
    "Но я всё равно вижу, что подарок интересует её не меньше любой другой девушки."

# ch/camila/gift.rpy:371
translate russian camila_gift_collar_male_a16f8002:
    camila.say "Ох, [lssb_camila.hero_name()]!"

# ch/camila/gift.rpy:372
translate russian camila_gift_collar_male_1ef19731:
    camila.say "Не стоило."

# ch/camila/gift.rpy:373
translate russian camila_gift_collar_male_822dadb4:
    camila.say "Но это очень мило!"

# ch/camila/gift.rpy:374
translate russian camila_gift_collar_male_0519fd3d:
    mike.say "Как я и сказал, Камила, уверен, тебе понравится."

# ch/camila/gift.rpy:375
translate russian camila_gift_collar_male_eca10cac:
    mike.say "Ты, конечно, никогда прямо не говорила, что тебе такое нравится."

# ch/camila/gift.rpy:376
translate russian camila_gift_collar_male_b0f7b6fb:
    mike.say "Но, кажется, я правильно понял твои намёки."

# ch/camila/gift.rpy:377
translate russian camila_gift_collar_male_16fbd4b7:
    mike.say "Я прав?"

# ch/camila/gift.rpy:378
translate russian camila_gift_collar_male_24a08243:
    "И вот в этот самый момент я показываю Камиле подарок."

# ch/camila/gift.rpy:379
translate russian camila_gift_collar_male_e2765a28:
    "Она опускает взгляд, когда я раскрываю ладони с кожаным ошейником."

# ch/camila/gift.rpy:380
translate russian camila_gift_collar_male_d2d6d5a5:
    "Он очень похож на обычный собачий ошейник."

# ch/camila/gift.rpy:381
translate russian camila_gift_collar_male_bee7aa84:
    "Разве что на нём висит золотая звезда, напоминающая полицейский значок."

# ch/camila/gift.rpy:382
translate russian camila_gift_collar_male_e3e5e894:
    mike.say "Это ошейник, Камила."

# ch/camila/gift.rpy:383
translate russian camila_gift_collar_male_f18bee99:
    mike.say "Будешь носить, чтобы все знали, что ты моя!"

# ch/camila/gift.rpy:385
translate russian camila_gift_collar_male_9bba5e49:
    "Глаза Камилы расширяются так, как я ещё никогда не видел."

# ch/camila/gift.rpy:386
translate russian camila_gift_collar_male_598fdcfd:
    "Поначалу она молчит и только качает головой, глядя на подарок."

# ch/camila/gift.rpy:387
translate russian camila_gift_collar_male_1e658392:
    mike.say "Камила?"

# ch/camila/gift.rpy:388
translate russian camila_gift_collar_male_e8efcba5:
    mike.say "Тебе нравится?"

# ch/camila/gift.rpy:389
translate russian camila_gift_collar_male_069b6909:
    mike.say "Правда?"

# ch/camila/gift.rpy:391
translate russian camila_gift_collar_male_8c9d1235:
    "Вдруг Камила начинает качать головой ещё быстрее."

# ch/camila/gift.rpy:392
translate russian camila_gift_collar_male_10544c00:
    "И одновременно её лицо мрачнеет."

# ch/camila/gift.rpy:393
translate russian camila_gift_collar_male_12f9a77c:
    "Подняв на меня глаза, она сердито щурится."

# ch/camila/gift.rpy:395
translate russian camila_gift_collar_male_977ddfcf:
    camila.say "Нет, конечно мне, блядь, не нравится!"

# ch/camila/gift.rpy:396
translate russian camila_gift_collar_male_b9a6b1cd:
    camila.say "Ты совсем идиот?!?"

# ch/camila/gift.rpy:397
translate russian camila_gift_collar_male_f2108a8b:
    "Прежде чем я успеваю придумать ответ, Камила выбивает ошейник из моей руки."

# ch/camila/gift.rpy:398
translate russian camila_gift_collar_male_24bfdad6:
    mike.say "Ай!"

# ch/camila/gift.rpy:399
translate russian camila_gift_collar_male_c994585c:
    mike.say "Эй, больно же!"

# ch/camila/gift.rpy:400
translate russian camila_gift_collar_male_09e14466:
    camila.say "Так и задумано, придурок!"

# ch/camila/gift.rpy:401
translate russian camila_gift_collar_male_d300d8c6:
    camila.say "Радуйся, что я тебя этой штукой не придушила, приятель!"

# ch/camila/gift.rpy:402
translate russian camila_gift_collar_male_dbdf9fcc:
    "Я невольно отступаю и поднимаю руки, защищаясь."

# ch/camila/gift.rpy:403
translate russian camila_gift_collar_male_9ba1d603:
    "На шее Камилы сейчас буквально вздулись жилы!"

# ch/camila/gift.rpy:404
translate russian camila_gift_collar_male_1986fcba:
    camila.say "Ты о чём думал?"

# ch/camila/gift.rpy:405
translate russian camila_gift_collar_male_46b64338:
    camila.say "Что я целыми днями вкалываю, чтобы какой-то мудак обращался со мной как с собакой?!?"

# ch/camila/gift.rpy:406
translate russian camila_gift_collar_male_3ba81a7e:
    camila.say "Я тебе не принадлежу, [lssb_camila.hero_name()]. Никому не принадлежу!"

# ch/camila/gift.rpy:407
translate russian camila_gift_collar_male_02220950:
    "С этими словами Камила резко разворачивается и уходит прочь."

# ch/camila/gift.rpy:408
translate russian camila_gift_collar_male_c136cfbc:
    "А я остаюсь один, смущённо поднимаю ошейник и смотрю ей вслед."

# ch/camila/gift.rpy:413
translate russian camila_gift_collar_male_2b36fac9:
    "Глядя на ошейник, Камила густо краснеет."

# ch/camila/gift.rpy:414
translate russian camila_gift_collar_male_c01b57bf:
    "Я вижу, как она сглатывает и оглядывается, словно боится, что кто-то заметит."

# ch/camila/gift.rpy:415
translate russian camila_gift_collar_male_137a7f29:
    "Затем подходит вплотную, почти прижимаясь ко мне."

# ch/camila/gift.rpy:417
translate russian camila_gift_collar_male_e9865b2e:
    camila.say "Н... но это же собачий ошейник, [lssb_camila.hero_name()]!"

# ch/camila/gift.rpy:418
translate russian camila_gift_collar_male_e37a83f4:
    camila.say "Я буду как твоя..."

# ch/camila/gift.rpy:419
translate russian camila_gift_collar_male_e8741a62:
    mike.say "Моя питомица, Камила?"

# ch/camila/gift.rpy:420
translate russian camila_gift_collar_male_2af8df6f:
    mike.say "Тебе бы понравилось?"

# ch/camila/gift.rpy:421
translate russian camila_gift_collar_male_168bdbf0:
    camila.say "Ты бы обращался со мной как с собакой?"

# ch/camila/gift.rpy:422
translate russian camila_gift_collar_male_235fccfc:
    camila.say "Г... говорил бы, что я хорошая девочка?"

# ch/camila/gift.rpy:423
translate russian camila_gift_collar_male_a71c3bbe:
    camila.say "Может... наказывал бы, когда я плохо себя веду?"

# ch/camila/gift.rpy:424
translate russian camila_gift_collar_male_d19c6a47:
    "Теперь Камила прижимается совсем близко."

# ch/camila/gift.rpy:425
translate russian camila_gift_collar_male_115e660a:
    "И в её взгляде столько мольбы."

# ch/camila/gift.rpy:426
translate russian camila_gift_collar_male_8c6ba108:
    "Не думаю, что смог бы отказать."

# ch/camila/gift.rpy:427
translate russian camila_gift_collar_male_61f67ef2:
    "Даже если бы сам этого не хотел!"

# ch/camila/gift.rpy:428
translate russian camila_gift_collar_male_dc513c80:
    mike.say "Конечно, Камила."

# ch/camila/gift.rpy:429
translate russian camila_gift_collar_male_91529f2e:
    mike.say "Всё, что пожелаешь!"

# ch/camila/gift.rpy:432
translate russian camila_gift_collar_male_8b97dfca:
    "Камила улыбается, позволяя мне застегнуть ошейник у неё на шее."

# ch/camila/gift.rpy:433
translate russian camila_gift_collar_male_81ab55e1:
    "И когда всё готово, смотрит на меня почти застенчиво."

# ch/camila/gift.rpy:434
translate russian camila_gift_collar_male_93a73c71:
    "Этот взгляд напоминает собаку, которая до этого только и делала, что лаяла."

# ch/camila/gift.rpy:435
translate russian camila_gift_collar_male_e4b9b6f6:
    "Но стоило почесать ей живот, как она превратилась в послушную комнатную собачку!"

# ch/camila/gift.rpy:442
translate russian camila_gift_butt_plug_male_76819dbb:
    camila.say "О, [lssb_camila.hero_name()], это мне?"

# ch/camila/gift.rpy:443
translate russian camila_gift_butt_plug_male_1a19f559:
    "Она разворачивает анальную пробку."

# ch/camila/gift.rpy:446
translate russian camila_gift_butt_plug_male_3cdc4ddb:
    camila.say "..."

# ch/camila/gift.rpy:447
translate russian camila_gift_butt_plug_male_0354e3a9:
    camila.say "Оставь себе... Я этого не хочу, так что оставь себе."

# ch/camila/gift.rpy:448
translate russian camila_gift_butt_plug_male_2a1a6bc4:
    camila.say "Уверена, тебе она нужнее, чем мне."

# ch/camila/gift.rpy:452
translate russian camila_gift_butt_plug_male_99f44e32:
    camila.say "Идеально!"

# ch/camila/gift.rpy:454
translate russian camila_gift_butt_plug_male_4a4ad432:
    camila.say "Спасибо, [lssb_camila.hero_name()], я найду ей хорошее применение."

# ch/camila/reactions.rpy:2
translate russian camila_ice_cream_reaction_male_12a29ea3:
    mike.say "Уф... Я больше не выдержу эту жару, Камила!"

# ch/camila/reactions.rpy:3
translate russian camila_ice_cream_reaction_male_e269c5d9:
    mike.say "Давай купим мороженого, чтобы охладиться?"

# ch/camila/reactions.rpy:5
translate russian camila_ice_cream_reaction_male_929a8a5e:
    camila.say "Читаешь мои мысли. Из-за малыша меня весь день тянет на холодное."

# ch/camila/reactions.rpy:6
translate russian camila_ice_cream_reaction_male_ca8b86c9:
    "В киоске с мороженым я покупаю нам по рожку, а ей беру ещё дополнительный шарик."

# ch/camila/reactions.rpy:7
translate russian camila_ice_cream_reaction_male_32522f49:
    "Камила расправляется со своим раньше, чем я съедаю хотя бы половину."

# ch/camila/reactions.rpy:8
translate russian camila_ice_cream_reaction_male_1539762c:
    camila.say "Даже не вздумай меня осуждать, [lssb_camila.hero_name()]. Я за двоих ем, помнишь?"

# ch/camila/reactions.rpy:10
translate russian camila_ice_cream_reaction_male_1bc4fe1a:
    camila.say "Не-а, у меня и так хладнокровия хватает. Но ты бери."

# ch/camila/reactions.rpy:11
translate russian camila_ice_cream_reaction_male_73a4ddd7:
    "У киоска с мороженым я покупаю рожок с парой разных шариков."

# ch/camila/reactions.rpy:12
translate russian camila_ice_cream_reaction_male_47a07581:
    "Я поднимаю мороженое, пытаясь переубедить Камилу."

# ch/camila/reactions.rpy:13
translate russian camila_ice_cream_reaction_male_cbc361f3:
    "Но она не клюёт на приманку, лишь улыбается и качает головой."

# ch/camila/reactions.rpy:14
translate russian camila_ice_cream_reaction_male_2f615f62:
    "Из-за этого мне немного неловко есть мороженое в одиночку."

# ch/camila/reactions.rpy:15
translate russian camila_ice_cream_reaction_male_d451c8eb:
    "Но я стараюсь скрыть это и улыбаюсь Камиле в ответ, продолжая лизать."

# ch/camila/reactions.rpy:16
translate russian camila_ice_cream_reaction_male_75e450c7:
    camila.say "Ты не шутил, когда сказал, что хочешь мороженого!"

# ch/camila/reactions.rpy:18
translate russian camila_ice_cream_reaction_male_1dc08251:
    camila.say "Интересно, что ты позже заставишь меня так же облизывать, а?"

# ch/camila/reactions.rpy:20
translate russian camila_ice_cream_reaction_male_71e372df:
    camila.say "Продолжай так лизать, и я начну представлять себя перед тобой на коленях."

# ch/camila/reactions.rpy:22
translate russian camila_ice_cream_reaction_male_6768fb07:
    camila.say "Интересно, что ещё ты стал бы так лизать!"

# ch/camila/reactions.rpy:23
translate russian camila_ice_cream_reaction_male_ee6d6bbf:
    "Едва поняв намёк Камилы, я чувствую, как краснеют щёки."

# ch/camila/reactions.rpy:27
translate russian camila_ask_phone_male_bbcb387f:
    mike.say "Камила, я хотел спросить..."

# ch/camila/reactions.rpy:28
translate russian camila_ask_phone_male_998aba57:
    mike.say "Дашь мне свой номер?"

# ch/camila/reactions.rpy:33
translate russian camila_ask_phone_male_622edd0f:
    camila.say "Держи, [lssb_camila.hero_name()]. Мой личный. Звони, когда захочешь меня увидеть, в любое время дня и ночи."

# ch/camila/reactions.rpy:35
translate russian camila_ask_phone_male_e6934f2d:
    camila.say "Конечно дам, [lssb_camila.hero_name()]. Звони когда угодно, даже во время смены."

# ch/camila/reactions.rpy:36
translate russian camila_ask_phone_male_3f1f1535:
    camila.say "Только сержанту моему не говори, ладно?"

# ch/camila/reactions.rpy:38
translate russian camila_ask_phone_male_006c1a6c:
    camila.say "Да, [lssb_camila.hero_name()], держи."

# ch/camila/reactions.rpy:39
translate russian camila_ask_phone_male_943bb2bd:
    camila.say "И это мой личный номер."

# ch/camila/reactions.rpy:40
translate russian camila_ask_phone_male_2637b051:
    camila.say "НЕ рабочий, ясно?"

# ch/camila/reactions.rpy:45
translate russian camila_ask_phone_male_fe10bef0:
    camila.say "Я не раздаю свой личный номер, [lssb_camila.hero_name()]."

# ch/camila/reactions.rpy:46
translate russian camila_ask_phone_male_dc061902:
    camila.say "Прости, такая уж полицейская привычка."

# ch/camila/reactions.rpy:50
translate russian camila_ask_birthday_male_b6578785:
    mike.say "Мне стало интересно, когда у тебя день рождения, Камила."

# ch/camila/reactions.rpy:51
translate russian camila_ask_birthday_male_a6541797:
    mike.say "Ты ведь так и не сказала?"

# ch/camila/reactions.rpy:56
translate russian camila_ask_birthday_male_d0804fab:
    camila.say "Третьего числа зимы, [lssb_camila.hero_name()]. И теперь, когда от меня никуда не денешься, лучше запомни."

# ch/camila/reactions.rpy:57
translate russian camila_ask_birthday_male_11ab2909:
    camila.say "Я не любительница тортов со свечками... но ради тебя, может, и позволю."

# ch/camila/reactions.rpy:59
translate russian camila_ask_birthday_male_c3cc2562:
    camila.say "Знаешь что, [lssb_camila.hero_name()], у тебя же есть моя визитка."

# ch/camila/reactions.rpy:60
translate russian camila_ask_birthday_male_0225319b:
    camila.say "Я напишу с обратной стороны, ладно?"

# ch/camila/reactions.rpy:61
translate russian camila_ask_birthday_male_9ceb2f95:
    camila.say "Тогда дата всегда будет под рукой. Вот: 3-е число зимы."

# ch/camila/reactions.rpy:66
translate russian camila_ask_birthday_male_44cf2de1:
    camila.say "Эй, никогда не спрашивай такое у женщины!"

# ch/camila/reactions.rpy:67
translate russian camila_ask_birthday_male_96f20736:
    camila.say "Я ещё не такая старая."

# ch/camila/reactions.rpy:68
translate russian camila_ask_birthday_male_6f6da595:
    camila.say "Просто эта работа изматывает, вот и всё!"

# ch/camila/reactions.rpy:72
translate russian camila_offer_a_drink_male_ad453e45:
    mike.say "Надо взять ещё пива."

# ch/camila/reactions.rpy:73
translate russian camila_offer_a_drink_male_92667635:
    mike.say "Может, и тебе принести, Камила?"

# ch/camila/reactions.rpy:74
translate russian camila_offer_a_drink_male_b9426228:
    "Едва я успеваю договорить, Камила поворачивается ко мне."

# ch/camila/reactions.rpy:78
translate russian camila_offer_a_drink_male_fafbc6a5:
    camila.say "Думаешь, нашему ребёнку мало досталось?"

# ch/camila/reactions.rpy:79
translate russian camila_offer_a_drink_male_c43bcc66:
    camila.say "У него уже мама с опасной работой."

# ch/camila/reactions.rpy:80
translate russian camila_offer_a_drink_male_0f060c5f:
    camila.say "Ещё не хватало, чтобы я его алкоголем заливала!"

# ch/camila/reactions.rpy:86
translate russian camila_offer_a_drink_male_1c510b3d:
    camila.say "Только если ты тоже выпьешь, [lssb_camila.hero_name()]. Я выпью всё, что ты мне дашь."

# ch/camila/reactions.rpy:88
translate russian camila_offer_a_drink_male_cb9e0440:
    camila.say "После последней смены мне нужно столько выпивки, сколько влезет!"

# ch/camila/reactions.rpy:89
translate russian camila_offer_a_drink_male_c859080f:
    camila.say "Мне виски. И с порцией не скупись."

# ch/camila/reactions.rpy:101
translate russian camila_offer_a_drink_male_18e7a082:
    camila.say "Господи, [lssb_camila.hero_name()], мне через пару часов на смену!"

# ch/camila/reactions.rpy:102
translate russian camila_offer_a_drink_male_e75c2a52:
    camila.say "Ты чего добиваешься? Чтобы меня из полиции выгнали?"

# ch/camila/reactions.rpy:108
translate russian camila_slap_ass_intro_male_7cbe329a:
    "Обычно я до смерти боялся бы сделать такое."

# ch/camila/reactions.rpy:109
translate russian camila_slap_ass_intro_male_069e729b:
    "Сама мысль шлёпнуть Камилу по заднице отдаёт опасностью."

# ch/camila/reactions.rpy:110
translate russian camila_slap_ass_intro_male_fddbebd5:
    "Но как сейчас двигается её попка..."

# ch/camila/reactions.rpy:111
translate russian camila_slap_ass_intro_male_224c06bc:
    "Может, ради такого преступления стоит и наказание стерпеть?"

# ch/camila/reactions.rpy:115
translate russian camila_slap_ass_happy_male_afac4b9c:
    camila.say "Что..."

# ch/camila/reactions.rpy:116
translate russian camila_slap_ass_happy_male_085579a1:
    camila.say "Какого чёрта?!?"

# ch/camila/reactions.rpy:117
translate russian camila_slap_ass_happy_male_062cc71a:
    "Камила резко оборачивается и ловит меня на месте преступления."

# ch/camila/reactions.rpy:118
translate russian camila_slap_ass_happy_male_e8a732ce:
    "Её глаза полны негодования и злости."

# ch/camila/reactions.rpy:119
translate russian camila_slap_ass_happy_male_fc704efe:
    "Но ещё и неверия."

# ch/camila/reactions.rpy:121
translate russian camila_slap_ass_happy_male_30159014:
    camila.say "М-м-м... сделай это ещё раз, [lssb_camila.hero_name()]."

# ch/camila/reactions.rpy:122
translate russian camila_slap_ass_happy_male_04799a76:
    camila.say "На этот раз сильнее. Я плохо себя вела."

# ch/camila/reactions.rpy:124
translate russian camila_slap_ass_happy_male_6cb4d439:
    camila.say "А, вот как, [lssb_camila.hero_name()]!"

# ch/camila/reactions.rpy:125
translate russian camila_slap_ass_happy_male_03237696:
    camila.say "Хочешь поиграть в хорошего и плохого копа!"

# ch/camila/reactions.rpy:126
translate russian camila_slap_ass_happy_male_9683a3fc:
    camila.say "Тогда я буду ПЛОХИМ!"

# ch/camila/reactions.rpy:130
translate russian camila_slap_ass_angry_male_afac4b9c:
    camila.say "Что..."

# ch/camila/reactions.rpy:131
translate russian camila_slap_ass_angry_male_085579a1:
    camila.say "Какого чёрта?!?"

# ch/camila/reactions.rpy:132
translate russian camila_slap_ass_angry_male_062cc71a:
    "Камила резко оборачивается и ловит меня на месте преступления."

# ch/camila/reactions.rpy:133
translate russian camila_slap_ass_angry_male_e8a732ce:
    "Её глаза полны негодования и злости."

# ch/camila/reactions.rpy:134
translate russian camila_slap_ass_angry_male_fc704efe:
    "Но ещё и неверия."

# ch/camila/reactions.rpy:135
translate russian camila_slap_ass_angry_male_0c320424:
    camila.say "Нельзя бить представителя закона, [lssb_camila.hero_name()]."

# ch/camila/reactions.rpy:136
translate russian camila_slap_ass_angry_male_5358b0f6:
    camila.say "Можно получить струю из перцового баллончика."

# ch/camila/reactions.rpy:137
translate russian camila_slap_ass_angry_male_e20c5575:
    camila.say "Или что похуже..."

# ch/camila/reactions.rpy:142
translate russian camila_breakup_male_cdc573d2:
    "Набраться смелости и сказать девушке, что хочешь расстаться, и без того непросто."

# ch/camila/reactions.rpy:143
translate russian camila_breakup_male_55423ed3:
    "Но когда эта девушка по совместительству ещё и суровый коп..."

# ch/camila/reactions.rpy:144
translate russian camila_breakup_male_a97d9ecb:
    "Тогда боишься ещё и получить по заднице за свои старания!"

# ch/camila/reactions.rpy:145
translate russian camila_breakup_male_56f0ebce:
    "Но я не могу просто улыбаться и делать вид, что у нас с Камилой всё хорошо."

# ch/camila/reactions.rpy:146
translate russian camila_breakup_male_706fa4a1:
    "Поэтому придётся подавить страх и сообщить ей неприятную новость."

# ch/camila/reactions.rpy:147
translate russian camila_breakup_male_9061644d:
    mike.say "Камила..."

# ch/camila/reactions.rpy:148
translate russian camila_breakup_male_b2d26ae1:
    mike.say "Тут такое дело..."

# ch/camila/reactions.rpy:149
translate russian camila_breakup_male_59b77dfa:
    "Почти сразу же, как я начинаю говорить, Камила поворачивается ко мне."

# ch/camila/reactions.rpy:150
translate russian camila_breakup_male_59751f23:
    "Из-за этого я замолкаю, так и не сказав, что хочу расстаться."

# ch/camila/reactions.rpy:151
translate russian camila_breakup_male_988b59f8:
    "Она смотрит на меня с привычным серьёзным выражением закалённого копа."

# ch/camila/reactions.rpy:152
translate russian camila_breakup_male_b6b7d1f7:
    camila.say "Хм..."

# ch/camila/reactions.rpy:153
translate russian camila_breakup_male_302b838e:
    camila.say "Ну давай, [lssb_camila.hero_name()]."

# ch/camila/reactions.rpy:154
translate russian camila_breakup_male_73f7174a:
    camila.say "Выкладывай."

# ch/camila/reactions.rpy:155
translate russian camila_breakup_male_8f88fd24:
    "Внезапно я чувствую себя на жёстком допросе."

# ch/camila/reactions.rpy:156
translate russian camila_breakup_male_e67ec54d:
    "Нервно сглатываю и оглядываюсь по сторонам."

# ch/camila/reactions.rpy:157
translate russian camila_breakup_male_3070c104:
    "Но Камила продолжает смотреть, словно заглядывая в самую душу."

# ch/camila/reactions.rpy:158
translate russian camila_breakup_male_962d5e5e:
    "И я понимаю: от этого взгляда не уйти."

# ch/camila/reactions.rpy:159
translate russian camila_breakup_male_9c430be4:
    mike.say "Это о нас, Камила."

# ch/camila/reactions.rpy:160
translate russian camila_breakup_male_dfd8caf2:
    mike.say "О тебе и обо мне."

# ch/camila/reactions.rpy:161
translate russian camila_breakup_male_6b5e6447:
    mike.say "Кажется, я больше не хочу продолжать..."

# ch/camila/reactions.rpy:163
translate russian camila_breakup_male_7f12fbc0:
    "Признаваясь, я едва удерживаюсь, чтобы не зажмуриться."

# ch/camila/reactions.rpy:164
translate russian camila_breakup_male_c9a9201d:
    "В глубине души знаю, что Камила не набросится на меня."

# ch/camila/reactions.rpy:165
translate russian camila_breakup_male_8b1b3e32:
    "Да, она суровый коп, но не подлый."

# ch/camila/reactions.rpy:166
translate russian camila_breakup_male_2b0643f0:
    "В итоге я вижу лишь едва заметную перемену на её лице."

# ch/camila/reactions.rpy:167
translate russian camila_breakup_male_c7e0d64a:
    "Может, подёргивание века, пока она старается держать себя в руках."

# ch/camila/reactions.rpy:168
translate russian camila_breakup_male_44e91309:
    camila.say "Дай уточню, [lssb_camila.hero_name()]."

# ch/camila/reactions.rpy:169
translate russian camila_breakup_male_b755d3df:
    camila.say "Ты хочешь меня бросить?"

# ch/camila/reactions.rpy:170
translate russian camila_breakup_male_7e37e1e8:
    camila.say "Даже после всего, что мы вместе пережили?"

# ch/camila/reactions.rpy:171
translate russian camila_breakup_male_e3942042:
    mike.say "Я... я понимаю, как это выглядит, Камила."

# ch/camila/reactions.rpy:172
translate russian camila_breakup_male_dff15847:
    mike.say "И по-прежнему благодарен за всё, что ты для меня сделала."

# ch/camila/reactions.rpy:173
translate russian camila_breakup_male_ba04dc98:
    mike.say "Но не могу игнорировать свои чувства."

# ch/camila/reactions.rpy:174
translate russian camila_breakup_male_a9a9a13f:
    mike.say "И врать тебе тоже не хочу!"

# ch/camila/reactions.rpy:175
translate russian camila_breakup_male_0bf36696:
    "На мгновение взгляд Камилы смягчается."

# ch/camila/reactions.rpy:176
translate russian camila_breakup_male_a078eccd:
    "Кажется, мои слова до неё дошли."

# ch/camila/reactions.rpy:177
translate russian camila_breakup_male_96f8b4d9:
    "Но затем она напрягается, и на лице вновь появляется маска сурового копа."

# ch/camila/reactions.rpy:178
translate russian camila_breakup_male_9c6a8399:
    camila.say "Как скажешь, [lssb_camila.hero_name()]."

# ch/camila/reactions.rpy:179
translate russian camila_breakup_male_d06f9ab6:
    camila.say "Мне не нужна твоя жалость."

# ch/camila/reactions.rpy:180
translate russian camila_breakup_male_afd4ecaf:
    camila.say "И если когда-нибудь снова понадобится вызвать полицию..."

# ch/camila/reactions.rpy:181
translate russian camila_breakup_male_ab951c86:
    camila.say "Проси кого угодно, только не меня."

# ch/camila/reactions.rpy:182
translate russian camila_breakup_male_7f7c500f:
    camila.say "Потому что я больше никогда не хочу тебя видеть!"

# ch/camila/reactions.rpy:186
translate russian camila_go_steady_intro_male_21366279:
    mike.say "Я тут подумал, Камила..."

# ch/camila/reactions.rpy:187
translate russian camila_go_steady_intro_male_b8968dba:
    mike.say "Нам стоит стать настоящей парой."

# ch/camila/reactions.rpy:188
translate russian camila_go_steady_intro_male_63572e8b:
    mike.say "Логично ведь, да?"

# ch/camila/reactions.rpy:193
translate russian camila_go_steady_yes_male_3ca9c9a8:
    camila.say "А разве нужно спрашивать, [lssb_camila.hero_name()]?"

# ch/camila/reactions.rpy:194
translate russian camila_go_steady_yes_male_24aef92b:
    camila.say "Я твоя. Официально, неофициально — как пожелаешь."

# ch/camila/reactions.rpy:196
translate russian camila_go_steady_yes_male_f7a0235b:
    camila.say "И почему я сама об этом не подумала, [lssb_camila.hero_name()]?!?"

# ch/camila/reactions.rpy:197
translate russian camila_go_steady_yes_male_ce4eaeda:
    camila.say "Конечно стоит."

# ch/camila/reactions.rpy:198
translate russian camila_go_steady_yes_male_f302f3f9:
    camila.say "Считай, мы официально вместе!"

# ch/camila/reactions.rpy:199
translate russian camila_go_steady_yes_male_2d7afa08:
    "Камила подкрепляет свои слова ударом кулака по моей руке."

# ch/camila/reactions.rpy:200
translate russian camila_go_steady_yes_male_29a52603:
    "Больно, конечно, но я улыбаюсь сквозь боль."

# ch/camila/reactions.rpy:204
translate russian camila_go_steady_no_male_152e1591:
    camila.say "Ого!"

# ch/camila/reactions.rpy:205
translate russian camila_go_steady_no_male_82cd66fc:
    camila.say "Притормози, [lssb_camila.hero_name()]."

# ch/camila/reactions.rpy:206
translate russian camila_go_steady_no_male_0d1ed812:
    camila.say "Для такого матёрого ветерана, как я, ты пока ещё новичок!"

# ch/camila/reactions.rpy:210
translate russian camila_pet_intro_male_16235aa5:
    "Я жалею об этом в тот же миг, как ладонь касается головы Камилы."

# ch/camila/reactions.rpy:211
translate russian camila_pet_intro_male_6bc6a595:
    "Но уже поздно отступать или говорить, что это вышло случайно."

# ch/camila/reactions.rpy:212
translate russian camila_pet_intro_male_039bad17:
    "Я только что погладил сурового копа по голове, и теперь придётся отвечать!"

# ch/camila/reactions.rpy:216
translate russian camila_pet_happy_male_afac4b9c:
    camila.say "Что..."

# ch/camila/reactions.rpy:218
translate russian camila_pet_happy_male_cb9297c5:
    camila.say "М-м-м... ещё, пожалуйста."

