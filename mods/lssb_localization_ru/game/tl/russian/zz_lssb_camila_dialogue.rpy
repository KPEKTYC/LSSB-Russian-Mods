# ch/camila/texts.rpy:34
translate russian camila_friendly_texts_c45563df:
    camila_nvl "Что бы ни делала, часть меня просто ждёт вашего следующего приказа."

# ch/camila/texts.rpy:35
translate russian camila_friendly_texts_dbeb71b5:
