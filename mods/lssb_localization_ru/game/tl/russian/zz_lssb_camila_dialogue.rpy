# ch/camila/texts.rpy:18
translate russian camila_friendly_texts_719ece72:
    camila_nvl "Хочу услышать твой голос и хоть раз позволить тебе всем руководить."

# ch/camila/texts.rpy:20
translate russian camila_friendly_texts_c6905f0d:
