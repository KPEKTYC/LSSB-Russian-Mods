# ch/camila/texts.rpy:21
translate russian camila_friendly_texts_bbede373:
    camila_nvl "День был тяжёлый, и я хотела услышать только твой голос."

# ch/camila/texts.rpy:22
translate russian camila_friendly_texts_0bef6e41:
    camila_nvl "Даже стыдно, насколько легче мне от тебя становится, да?"

# ch/camila/texts.rpy:24
translate russian camila_friendly_texts_120ad7a3_1:
