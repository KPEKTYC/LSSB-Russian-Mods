# ch/camila/base.rpy:297
translate russian camila_propose_male_71207a74:
    "На мгновение Камила выглядит обезоруженной."

# ch/camila/base.rpy:298
translate russian camila_propose_male_0c7c6558:
    "Я вижу выражение её глаз и точно понимаю, что оно значит."

# ch/camila/base.rpy:299
translate russian camila_propose_male_4299846f:
    "Это тот миг, когда её суровая маска спадает."

# ch/camila/base.rpy:300
translate russian camila_propose_male_5ef9cf1a:
    "Ровно настолько, чтобы я понял: она благодарна за мою заботу."

# ch/camila/base.rpy:301
translate russian camila_propose_male_f733ec62:
    "Но затем так же быстро снова закрывается."

# ch/camila/base.rpy:303
translate russian camila_propose_male_827ba16a:
    camila.say "А..."

# ch/camila/base.rpy:304
translate russian camila_propose_male_c239dd61:
    camila.say "Хватит меня опекать, [lssb_camila.hero_name()]!"

# ch/camila/base.rpy:305
translate russian camila_propose_male_cf321443:
    camila.say "Я выпила кофе в конце смены!"

# ch/camila/base.rpy:306
translate russian camila_propose_male_ace58573:
    camila.say "Чего тебе ещё надо, а?"

# ch/camila/base.rpy:308
translate russian camila_propose_male_ad36841f:
    mike.say "Не знаю, Камила..."

# ch/camila/base.rpy:309
translate russian camila_propose_male_846f2052:
    mike.say "Я думал о том, чего может хотеться тебе."

# ch/camila/base.rpy:310
translate russian camila_propose_male_bfa95369:
    mike.say "Например, одного из этих красавцев?"

# ch/camila/base.rpy:311
translate russian camila_propose_male_37f951d2:
    "Именно в этот момент я достаю из-за спины коробку."

# ch/camila/base.rpy:312
translate russian camila_propose_male_73b66ccc:
    "Затем поднимаю крышку, показывая, что внутри."

# ch/camila/base.rpy:313
translate russian camila_propose_male_a283809c:
    "Камила смотрит на ряды свежих, сладко пахнущих пончиков."

# ch/camila/base.rpy:314
translate russian camila_propose_male_07166e39:
    "Но затем поднимает на меня подозрительно прищуренные глаза."

# ch/camila/base.rpy:317
translate russian camila_propose_male_0a8058c9:
    camila.say "Что это, [lssb_camila.hero_name()]?"

# ch/camila/base.rpy:318
translate russian camila_propose_male_90e902fd:
    camila.say "Какая-то шутка?"

# ch/camila/base.rpy:319
translate russian camila_propose_male_6eeb1c4b:
    camila.say "Ты серьёзно думаешь, что я буду есть пончики на людях?"

# ch/camila/base.rpy:322
translate russian camila_propose_male_f207af73:
    mike.say "Да брось, Камила!"

# ch/camila/base.rpy:323
translate russian camila_propose_male_9a3b0e3a:
    mike.say "Ты ведь не боишься этого старого стереотипа?"

# ch/camila/base.rpy:324
translate russian camila_propose_male_ffb0b2f3:
    mike.say "На дворе двадцать первый век, ради бога!"

# ch/camila/base.rpy:325
translate russian camila_propose_male_08292f53:
    mike.say "И это всего один пончик!"

# ch/camila/base.rpy:327
translate russian camila_propose_male_f451e8ae:
    "Я выбираю один и протягиваю ей."

# ch/camila/base.rpy:328
translate russian camila_propose_male_5ce47259:
    "Вижу, что она уже начинает сдаваться."

# ch/camila/base.rpy:329
translate russian camila_propose_male_b7ca96be:
    "Теперь даже я слышу, как урчит у Камилы в животе."

# ch/camila/base.rpy:330
translate russian camila_propose_male_7f47e327:
    "И знаю, что она обожает пончики, хоть и не признаётся."

# ch/camila/base.rpy:331
translate russian camila_propose_male_0dcdff36:
    mike.say "Вот..."

# ch/camila/base.rpy:332
translate russian camila_propose_male_ba14a568:
    mike.say "Этот выглядит аппетитно!"

# ch/camila/base.rpy:334
translate russian camila_propose_male_c5a505ae:
    "Рука Камилы движется быстрее, чем я успеваю заметить."

# ch/camila/base.rpy:335
translate russian camila_propose_male_26da5860:
    "Наверное, пистолет она выхватывает с безумной скоростью!"

# ch/camila/base.rpy:336
translate russian camila_propose_male_c6db276a:
    "Она так быстра, что пончик словно сам материализуется у неё в руке."

# ch/camila/base.rpy:337
translate russian camila_propose_male_15a175e1:
    "Когда она собирается откусить, я понимаю, что мой план сейчас закончится катастрофой."

# ch/camila/base.rpy:338
translate russian camila_propose_male_cda1b267:
    mike.say "Камила, погоди!"

# ch/camila/base.rpy:339
translate russian camila_propose_male_86f705b4:
    mike.say "Что там в середине?"

# ch/camila/base.rpy:340
translate russian camila_propose_male_70129d26:
    mike.say "В дырочке что-то застряло!"

# ch/camila/base.rpy:342
translate russian camila_propose_male_ac711382:
    "Камила поднимает пончик, разглядывая то, что виднеется в отверстии."

# ch/camila/base.rpy:344
translate russian camila_propose_male_6d27dd28:
    "Затем вытаскивает находку и изумлённо смотрит на кольцо в своей руке."

# ch/camila/base.rpy:346
translate russian camila_propose_male_f355fdf9:
    camila.say "А?"

# ch/camila/base.rpy:350
translate russian camila_propose_male_085579a1:
    camila.say "Какого чёрта?!"

# ch/camila/base.rpy:351
translate russian camila_propose_male_0ad63d38:
    "Но, повернувшись ко мне, она сталкивается с ещё одним сюрпризом."

# ch/camila/base.rpy:352
translate russian camila_propose_male_f12fc33b:
    "Потому что я стою перед ней на колене."

# ch/camila/base.rpy:353
translate russian camila_propose_male_964f8210:
    "И смотрю на неё снизу вверх с нервной улыбкой."

# ch/camila/base.rpy:356
translate russian camila_propose_male_2412e0b9:
    camila.say "[lssb_camila.hero_name()]..."

# ch/camila/base.rpy:357
translate russian camila_propose_male_49a9997d:
    camila.say "Что ты..."

# ch/camila/base.rpy:359
translate russian camila_propose_male_9061644d:
    mike.say "Камила..."

# ch/camila/base.rpy:360
translate russian camila_propose_male_8069cfae:
    mike.say "Ты выйдешь за меня?"

# ch/camila/base.rpy:361
translate russian camila_propose_male_b4433dfd:
    "Такого выражения лица у Камилы я ещё никогда не видел."

# ch/camila/base.rpy:362
translate russian camila_propose_male_2b011d5e:
    "В нём смешались удивление, страх и полная беспомощность."

# ch/camila/base.rpy:363
translate russian camila_propose_male_ae797adb:
    "Впервые я вижу, как Камила теряется и не может найти слов!"

# ch/camila/base.rpy:365
translate russian camila_propose_male_446475c5:
    "Она отрывает от меня взгляд и смотрит на кольцо в руке."

# ch/camila/base.rpy:366
translate russian camila_propose_male_83a62c87:
    "Но затем я вижу, как Камила изо всех сил пытается совладать с чувствами."

# ch/camila/base.rpy:367
translate russian camila_propose_male_aa0fac77:
    "Кажется, ей это удаётся: она глубоко вдыхает и качает головой."

# ch/camila/base.rpy:371
translate russian camila_propose_male_08c42cc8:
    camila.say "Встанешь ты уже с земли, чёрт побери?"

# ch/camila/base.rpy:372
translate russian camila_propose_male_d9de97f5:
    camila.say "Люди на тебя смотрят!"

# ch/camila/base.rpy:374
translate russian camila_propose_male_1d0f7975:
    "Я слушаюсь, чувствуя всё большую неловкость."

# ch/camila/base.rpy:376
translate russian camila_propose_male_a70b7446:
    "Как только я поднимаюсь, Камила кладёт пончик обратно в коробку."

# ch/camila/base.rpy:377
translate russian camila_propose_male_871bf480:
    "И я замечаю, что кольцо она тоже аккуратно возвращает туда."

# ch/camila/base.rpy:378
translate russian camila_propose_male_8fb73da4:
    mike.say "Я..."

# ch/camila/base.rpy:379
translate russian camila_propose_male_40bb5ffe:
    mike.say "Полагаю, это значит «нет»?"

# ch/camila/base.rpy:380
translate russian camila_propose_male_522911fe:
    "Когда я задаю вопрос, мой голос дрожит от чувств."

# ch/camila/base.rpy:381
translate russian camila_propose_male_773f0abc:
    "Ничего не могу с собой поделать, понимаете?"

# ch/camila/base.rpy:382
translate russian camila_propose_male_1aaf7988:
    "Я предложил любимой девушке выйти за меня, а она отказала."

# ch/camila/base.rpy:383
translate russian camila_propose_male_eb830a55:
    "Я не суровый коп, как Камила!"

# ch/camila/base.rpy:384
translate russian camila_propose_male_b0449e6f:
    "К моему удивлению, её суровость тоже даёт трещину, когда я показываю свои чувства."

# ch/camila/base.rpy:385
translate russian camila_propose_male_76f794f3:
    "Она искренне тревожится, что сделала мне больно."

# ch/camila/base.rpy:386
translate russian camila_propose_male_fe5886f7:
    "И от этого чувство отверженности становится только тяжелее."

# ch/camila/base.rpy:388
translate russian camila_propose_male_67509fe7:
    camila.say "Я не могу, [lssb_camila.hero_name()], ты же знаешь!"

# ch/camila/base.rpy:389
translate russian camila_propose_male_f1453bc2:
    camila.say "Я словно уже замужем за полицией."

# ch/camila/base.rpy:390
translate russian camila_propose_male_c0fa0880:
    camila.say "Поверь, я видела достаточно супругов полицейских, оставшихся вдовами и вдовцами!"

# ch/camila/base.rpy:392
translate russian camila_propose_male_6b28e536:
    mike.say "Я... наверное, ты права, Камила..."

# ch/camila/base.rpy:394
translate russian camila_propose_male_07187a2b:
    camila.say "Да брось, [lssb_camila.hero_name()]!"

# ch/camila/base.rpy:395
translate russian camila_propose_male_4fa942bb:
    camila.say "Я же тебя не бросаю!"

# ch/camila/base.rpy:397
translate russian camila_propose_male_88388b4d:
    camila.say "Мы ведь всё ещё вместе, да?"

# ch/camila/base.rpy:399
translate russian camila_propose_male_7a498874:
    mike.say "Конечно, Камила!"

# ch/camila/base.rpy:400
translate russian camila_propose_male_ca247bbb:
    mike.say "И, может, ты скоро захочешь уйти со службы?"

# ch/camila/base.rpy:401
translate russian camila_propose_male_b2b4bc08:
    mike.say "Тогда сможешь выйти за меня, правда?"

# ch/camila/base.rpy:403
translate russian camila_propose_male_e0e33ed3:
    camila.say "Давай решать проблемы по мере поступления, ладно?"

# ch/camila/base.rpy:405
translate russian camila_propose_male_d85c9054:
    "Я киваю, желая сделать Камилу как можно счастливее."

# ch/camila/base.rpy:406
translate russian camila_propose_male_758e5953:
    "С предложением всё, возможно, пошло не по плану."

# ch/camila/base.rpy:407
translate russian camila_propose_male_852fd294:
    "Но мы хотя бы всё ещё вместе!"

# ch/camila/base.rpy:409
translate russian camila_propose_male_446475c5_1:
    "Она отрывает от меня взгляд и смотрит на кольцо в руке."

# ch/camila/base.rpy:410
translate russian camila_propose_male_0609f871:
    "Я вижу, как Камила изо всех сил пытается совладать с чувствами."

# ch/camila/base.rpy:411
translate russian camila_propose_male_6dd1ff33:
    "Но затем она издаёт какой-то звук и резко прикрывает рот рукой."

# ch/camila/base.rpy:412
translate russian camila_propose_male_968a621a:
    "Это что... она только что всхлипнула?"

# ch/camila/base.rpy:413
translate russian camila_propose_male_c8de0b6c:
    "У Камилы и правда сейчас слёзы в глазах?"

# ch/camila/base.rpy:414
translate russian camila_propose_male_974751fc:
    "Я просто не привык видеть, чтобы она так проявляла чувства."

# ch/camila/base.rpy:415
translate russian camila_propose_male_0b581573:
    "Поэтому мне требуется мгновение, чтобы справиться с изумлением."

# ch/camila/base.rpy:416
translate russian camila_propose_male_d3ddadbf:
    "Но как только это удаётся, я вскакиваю и спешу утешить Камилу."

# ch/camila/base.rpy:417
translate russian camila_propose_male_1e658392:
    mike.say "Камила?"

# ch/camila/base.rpy:418
translate russian camila_propose_male_c633af0c:
    mike.say "Ты в порядке?"

# ch/camila/base.rpy:419
translate russian camila_propose_male_13502532:
    "Я беру её за руки и смотрю в глаза."

# ch/camila/base.rpy:420
translate russian camila_propose_male_a3100b06:
    "Камила кивает, всё ещё не в силах произнести ни слова."

# ch/camila/base.rpy:421
translate russian camila_propose_male_c2942cf4:
    "Теперь я точно вижу слёзы у неё в глазах."

# ch/camila/base.rpy:422
translate russian camila_propose_male_1c5ae4da:
    "Когда ей наконец удаётся заговорить, слова вырываются сами."

# ch/camila/base.rpy:424
translate russian camila_propose_male_63a70723:
    camila.say "ДА!"

# ch/camila/base.rpy:426
translate russian camila_propose_male_cb1c5012:
    camila.say "Да, да, да!"

# ch/camila/base.rpy:428
translate russian camila_propose_male_30e74fc5:
    mike.say "Эм..."

# ch/camila/base.rpy:429
translate russian camila_propose_male_98826da2:
    mike.say "Это «да, я в порядке»?"

# ch/camila/base.rpy:430
translate russian camila_propose_male_c37934a1:
    mike.say "Или «да, я выйду за тебя»?"

# ch/camila/base.rpy:433
translate russian camila_propose_male_89baa4cd:
    "Вместо ответа Камила обвивает мою шею руками."

# ch/camila/base.rpy:434
translate russian camila_propose_male_28c02dad:
    "В следующий миг её губы уже прижаты к моим."

# ch/camila/base.rpy:435
translate russian camila_propose_male_71e36258:
    "Я обнимаю её за талию, почти отрывая от земли."

# ch/camila/base.rpy:436
translate russian camila_propose_male_f8461f70:
    "Когда поцелуй наконец заканчивается, мы оба задыхаемся."

# ch/camila/base.rpy:438
translate russian camila_propose_male_86d07102:
    mike.say "А..."

# ch/camila/base.rpy:439
translate russian camila_propose_male_4771d224:
    mike.say "Ого..."

# ch/camila/base.rpy:440
translate russian camila_propose_male_35b92284:
    mike.say "Я так боялся, что ты скажешь «нет»!"

# ch/camila/base.rpy:441
translate russian camila_propose_male_60f1f4e1:
    mike.say "Что выдашь речь о том, как уже замужем за полицией!"

# ch/camila/base.rpy:443
translate russian camila_propose_male_107c7aa7:
    camila.say "Фух..."

# ch/camila/base.rpy:444
translate russian camila_propose_male_bdb11870:
    camila.say "Я... я бы так и сделала..."

# ch/camila/base.rpy:445
translate russian camila_propose_male_eb237f17:
    camila.say "Раньше я всегда так поступала, когда кто-то подходил слишком близко."

# ch/camila/base.rpy:446
translate russian camila_propose_male_66862cb0:
    camila.say "Но с тобой... странно..."

# ch/camila/base.rpy:447
translate russian camila_propose_male_f49de6c4:
    camila.say "Словно я больше не хочу откладывать жизнь с тобой из страха тебя потерять."

# ch/camila/base.rpy:448
translate russian camila_propose_male_0281c074:
    camila.say "Ни с кем другим я такого не чувствовала!"

# ch/camila/base.rpy:450
translate russian camila_propose_male_9c63b2e4:
    "Камила протягивает руку, и я надеваю кольцо ей на палец."

# ch/camila/base.rpy:451
translate russian camila_propose_male_618909e1:
    "Она поднимает руку и любуется тем, как на ней смотрится кольцо."

# ch/camila/base.rpy:453
translate russian camila_propose_male_7dd49c4f:
    camila.say "Лучше тебе быть к этому готовым, [lssb_camila.hero_name()]."

# ch/camila/base.rpy:454
translate russian camila_propose_male_c5fc8e0a:
    camila.say "Нелегко быть женой полицейского!"

# ch/camila/base.rpy:456
translate russian camila_propose_male_232885ff:
    camila.say "А с малышом на подходе ты подписываешься на куда большее."

# ch/camila/base.rpy:457
translate russian camila_propose_male_f699b73b:
    mike.say "Мужем! Ты хотела сказать — мужем полицейской!"

# ch/camila/base.rpy:459
translate russian camila_propose_male_0d125575:
    camila.say "Я знаю, что хотела сказать, [lssb_camila.hero_name()]..."

# ch/camila/base.rpy:503
translate russian camila_ask_date_camila_kiara_d97ba878:
    mike.say "Камила, как насчёт ещё одной поездки в лимузине Киары?"

# ch/camila/base.rpy:504
translate russian camila_ask_date_camila_kiara_50f33a69:
    camila.say "Ха! Всё гадала, когда ты снова спросишь."

# ch/camila/base.rpy:505
translate russian camila_ask_date_camila_kiara_52984ccb:
    camila.say "Одно твоё слово — и я буду там. Без формы."

# ch/camila/base.rpy:518
translate russian camila_ask_date_alone_male_6e08df28:
    mike.say "Камила, хочешь пойти со мной на свидание?"

# ch/camila/base.rpy:520
translate russian camila_ask_date_alone_male_eba0c7c3:
    camila.say "Прости, [lssb_camila.hero_name()], я не воспринимаю тебя в таком качестве."

# ch/camila/base.rpy:523
translate russian camila_ask_date_alone_male_25c4eb7a:
    camila.say "Свидание? В моём положении? Ладно, почему бы и нет, [lssb_camila.hero_name()]. Только за преступниками бегать не заставляй."

# ch/camila/base.rpy:526
translate russian camila_ask_date_alone_male_aaed7ba1:
    camila.say "Свидание с тобой? С удовольствием, папочка. Только скажи, когда и где."

# ch/camila/base.rpy:529
translate russian camila_ask_date_alone_male_5060491b:
    camila.say "Ещё спрашиваешь? Я вся твоя, [lssb_camila.hero_name()]. Когда идём?"

# ch/camila/base.rpy:532
translate russian camila_ask_date_alone_male_4fd9c5fb:
