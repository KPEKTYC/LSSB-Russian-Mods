# ch/cassidy/gift.rpy:186
translate russian cassidy_gift_slutty_dress_male_078faa9b:
    cassidy.say "Ты издеваешься?"

# ch/cassidy/gift.rpy:188
translate russian cassidy_gift_slutty_dress_male_4f4c2415:
    cassidy.say "Знаешь, что сделает со мной мачеха, если увидит меня в этом?"

# ch/cassidy/gift.rpy:190
translate russian cassidy_gift_slutty_dress_male_68d1f020:
