translate russian cassidy_ask_fuck_date_male_03e32005:
    cassidy.say "Спасибо, [lssb_cassidy.hero_name()]. Я этого не забуду!"

# ch/cassidy/base.rpy:325
translate russian cassidy_walk_outside_1643fb2d:
    mike.say "Кэссиди!"

# ch/cassidy/base.rpy:326
translate russian cassidy_walk_outside_c3bb432f:
    mike.say "Ко мне, девочка!"

# ch/cassidy/base.rpy:327
translate russian cassidy_walk_outside_76c104c2:
    mike.say "Пора гулять!"

# ch/cassidy/base.rpy:328
translate russian cassidy_walk_outside_7c3308bb:
    "Едва я успеваю произнести эти слова, слышу, как Кэссиди встаёт."

# ch/cassidy/base.rpy:329
translate russian cassidy_walk_outside_0aa0d03c:
    "Но это не значит, что я ожидаю увидеть её уже через пару секунд. О нет."

# ch/cassidy/base.rpy:330
translate russian cassidy_walk_outside_0f664182:
    "Ведь я знаю, что она будет собираться."

# ch/cassidy/base.rpy:331
translate russian cassidy_walk_outside_4c15149b:
    "Причём совершенно определённым образом!"

# ch/cassidy/base.rpy:332
translate russian cassidy_walk_outside_06b006a2:
    "Если я прав, Кэссиди должна быть готова с минуты на минуту..."

# ch/cassidy/base.rpy:333
translate russian cassidy_walk_outside_bb55d4c3:
    cassidy.say "Вот и я, [lssb_cassidy.hero_name()]!"

# ch/cassidy/base.rpy:335
translate russian cassidy_walk_outside_f95c240f:
    cassidy.say "Я готова, пойдём!"

# ch/cassidy/base.rpy:337
translate russian cassidy_walk_outside_730b6aa0:
    "Меня ничуть не удивляет, что Кэссиди появляется на четвереньках."

# ch/cassidy/base.rpy:338
translate russian cassidy_walk_outside_ddb90e4d:
    "И то, что она совершенно голая, меня тоже не шокирует."

# ch/cassidy/base.rpy:339
translate russian cassidy_walk_outside_98c9aac9:
    "Ей потребовалось ровно столько времени, чтобы сбросить одежду."

# ch/cassidy/base.rpy:340
translate russian cassidy_walk_outside_9b9922da:
    "Теперь на ней только собачий ошейник!"

# ch/cassidy/base.rpy:341
translate russian cassidy_walk_outside_7092cbbd:
    "Я улыбаюсь и киваю, протягивая руку за подходящим поводком."

# ch/cassidy/base.rpy:342
translate russian cassidy_walk_outside_0f5c8d6f:
    "Пристёгиваю его и легонько тяну."

# ch/cassidy/base.rpy:343
translate russian cassidy_walk_outside_d1063144:
    mike.say "Хорошая девочка, Кэссиди!"

# ch/cassidy/base.rpy:344
translate russian cassidy_walk_outside_88a21f96:
    mike.say "Ну, пошли..."

# ch/cassidy/base.rpy:345
translate russian cassidy_walk_outside_a21d38bc:
    "Если бы у Кэссиди был хвост, она бы сейчас вовсю им виляла."

# ch/cassidy/base.rpy:346
translate russian cassidy_walk_outside_426e8bdf:
    "Вместо этого она сияет от гордости, пока я открываю входную дверь и вывожу её наружу."

# ch/cassidy/base.rpy:347
translate russian cassidy_walk_outside_f824a3dc:
    "От моего дома до парка недалеко."

# ch/cassidy/base.rpy:348
translate russian cassidy_walk_outside_46247661:
    "А в это время ночи в районе всегда мёртвая тишина."

# ch/cassidy/base.rpy:349
translate russian cassidy_walk_outside_516e1f1e:
    "К тому же я знаю путь в обход большинства уличных фонарей."

# ch/cassidy/base.rpy:350
translate russian cassidy_walk_outside_6d273b36:
    "Я не переживаю, если кто-нибудь увидит, как я выгуливаю голую Кэссиди посреди ночи."

# ch/cassidy/base.rpy:351
translate russian cassidy_walk_outside_b25b731e:
    "В лучшем случае примут меня за человека с большой собакой."

# ch/cassidy/base.rpy:352
translate russian cassidy_walk_outside_c5422f13:
    "В худшем — поймут, что я на самом деле делаю."

# ch/cassidy/base.rpy:353
translate russian cassidy_walk_outside_6b1c263c:
    "И будут слишком ошарашены, чтобы что-то предпринять."

# ch/cassidy/base.rpy:354
translate russian cassidy_walk_outside_24edff9b:
    "Я так уверен, что нас не поймают, что даже не слежу за обстановкой."

# ch/cassidy/base.rpy:357
translate russian cassidy_walk_outside_19f044cb:
    "Большую часть пути до парка я любуюсь Кэссиди, идущей рядом."

# ch/cassidy/base.rpy:358
translate russian cassidy_walk_outside_2908d098:
    "Никогда не думал, что такой избалованной принцессе понравится нечто подобное."

# ch/cassidy/base.rpy:359
translate russian cassidy_walk_outside_fde282ce:
    "Но ей, похоже, нравится, когда её заставляют вести себя как собаку."

# ch/cassidy/base.rpy:360
translate russian cassidy_walk_outside_c787ed9e:
    "И её характер при этом тоже проявляется."

# ch/cassidy/base.rpy:361
translate russian cassidy_walk_outside_9fb35009:
    "То есть она не просто повторяет обычные собачьи повадки."

# ch/cassidy/base.rpy:362
translate russian cassidy_walk_outside_08064f64:
    "О нет, Кэссиди добавляет изрядную долю высокомерия."

# ch/cassidy/base.rpy:363
translate russian cassidy_walk_outside_c98ef9b5:
    "Она ведёт себя как одна из тех избалованных собачек, которых встречаешь в богатых кварталах."

# ch/cassidy/base.rpy:364
translate russian cassidy_walk_outside_2f31668b:
    "Кэссиди шествует на четвереньках, едва ли не задрав нос."

# ch/cassidy/base.rpy:365
translate russian cassidy_walk_outside_48ee53e7:
    "Да, она представляет себя собакой."

# ch/cassidy/base.rpy:366
translate russian cassidy_walk_outside_27952019:
    "Но одной из самых редких и дорогих пород!"

# ch/cassidy/base.rpy:367
translate russian cassidy_walk_outside_44769eba:
    "Я знаю, что Кэссиди замечает мой неотрывный взгляд."

# ch/cassidy/base.rpy:368
translate russian cassidy_walk_outside_c485b236:
    "Потому что начинает почти подпрыгивать, двигаясь рядом со мной."

# ch/cassidy/base.rpy:369
translate russian cassidy_walk_outside_5b77bc61:
    "С каждым шагом её попка покачивается из стороны в сторону."

# ch/cassidy/base.rpy:370
translate russian cassidy_walk_outside_cc585ebb:
    "А грудь одновременно колышется внизу!"

# ch/cassidy/base.rpy:371
translate russian cassidy_walk_outside_def86cc9:
    "Мне с трудом удаётся продолжать идти прямо к парку."

# ch/cassidy/base.rpy:372
translate russian cassidy_walk_outside_d96efb91:
    "Человек с настоящей собакой никогда бы так не отвлекался!"

# ch/cassidy/base.rpy:373
translate russian cassidy_walk_outside_0d08d70d:
    "По крайней мере, надеюсь..."

# ch/cassidy/base.rpy:374
translate russian cassidy_walk_outside_b1030e1f:
    "Когда мы наконец добираемся до парка, я с облегчением вижу, что он пуст."

# ch/cassidy/base.rpy:375
translate russian cassidy_walk_outside_b7a84cbe:
    "Так что весь парк в нашем с Кэссиди распоряжении."

# ch/cassidy/base.rpy:377
translate russian cassidy_walk_outside_9316355f:
    "Я выхожу на траву и отстёгиваю поводок."

# ch/cassidy/base.rpy:378
translate russian cassidy_walk_outside_399afb0d:
    "Кэссиди продолжает играть свою роль, бегая туда-сюда."

# ch/cassidy/base.rpy:379
translate russian cassidy_walk_outside_3219bfd9:
    "Чёрт, она даже некоторое время красуется, катаясь на спине."

# ch/cassidy/base.rpy:380
translate russian cassidy_walk_outside_2c7bf788:
    "И не прекращает, пока я как следует не почешу ей живот."

# ch/cassidy/base.rpy:381
translate russian cassidy_walk_outside_284e8c6b:
    "Я достаю из кармана теннисный мяч."

# ch/cassidy/base.rpy:382
translate russian cassidy_walk_outside_f1691794:
    "Но едва показываю его, Кэссиди презрительно фыркает."

# ch/cassidy/base.rpy:383
translate russian cassidy_walk_outside_5a76a902:
    "И буквально воротит от него нос!"

# ch/cassidy/base.rpy:384
translate russian cassidy_walk_outside_906af92f:
    "Видимо, Кэссиди считает ниже своего достоинства приносить мяч."

# ch/cassidy/base.rpy:385
translate russian cassidy_walk_outside_a9f51e34:
    "Она ещё немного гордо расхаживает по траве."

# ch/cassidy/base.rpy:386
translate russian cassidy_walk_outside_4cf1430f:
    "Но вскоре на её лице появляется выражение срочной нужды."

# ch/cassidy/base.rpy:387
translate russian cassidy_walk_outside_f91c340e:
    "Кэссиди спешит ко мне с широко раскрытыми глазами."

# ch/cassidy/base.rpy:388
translate russian cassidy_walk_outside_9620654f:
    "Садится на пятки и скребёт рукой мою ногу."

# ch/cassidy/base.rpy:390
translate russian cassidy_walk_outside_0226519e:
    cassidy.say "Нам нужно вернуться к тебе. СЕЙЧАС ЖЕ!"

# ch/cassidy/base.rpy:391
translate russian cassidy_walk_outside_e02d61fd:
    cassidy.say "Пожалуйста, [lssb_cassidy.hero_name()], нужно спешить!"

# ch/cassidy/base.rpy:392
translate russian cassidy_walk_outside_ca87f4eb:
    mike.say "Так, так, так..."

# ch/cassidy/base.rpy:393
translate russian cassidy_walk_outside_1f2a6285:
    mike.say "Погоди-ка, Кэссиди."

# ch/cassidy/base.rpy:394
translate russian cassidy_walk_outside_ad0eeba1:
    mike.say "Вся суть в том, что ты собака, а я хозяин."

# ch/cassidy/base.rpy:395
translate russian cassidy_walk_outside_b5d3d06e:
    mike.say "Поэтому я решаю, когда и куда мы идём, ясно?"

# ch/cassidy/base.rpy:396
translate russian cassidy_walk_outside_cd4f26ee:
    cassidy.say "Но, [lssb_cassidy.hero_name()]..."

# ch/cassidy/base.rpy:397
translate russian cassidy_walk_outside_89f467d6:
    cassidy.say "Ты не понимаешь, мне нужно пописать!"

# ch/cassidy/base.rpy:398
translate russian cassidy_walk_outside_2e68ee0f:
    "От этого признания мои глаза немного расширяются."

# ch/cassidy/base.rpy:399
translate russian cassidy_walk_outside_8fee6980:
    "Но затем я оглядываю пустой парк и пожимаю плечами."

# ch/cassidy/base.rpy:400
translate russian cassidy_walk_outside_4997ebb9:
    mike.say "Просто пописай здесь, Кэссиди."

# ch/cassidy/base.rpy:401
translate russian cassidy_walk_outside_e5ad2420:
    mike.say "Собака бы так и сделала, верно?"

# ch/cassidy/base.rpy:402
translate russian cassidy_walk_outside_c28487d4:
    mike.say "Если хочешь, я даже отвернусь!"

# ch/cassidy/base.rpy:403
translate russian cassidy_walk_outside_c45d37e9:
    "Кэссиди смотрит на меня с ужасом."

# ch/cassidy/base.rpy:404
translate russian cassidy_walk_outside_debe14fd:
    "Похоже, она готова терпеть, когда её водят голой на собачьем поводке."

# ch/cassidy/base.rpy:405
translate russian cassidy_walk_outside_cbb352da:
    "Но вот писать в общественном месте для неё почему-то уже слишком."

# ch/cassidy/base.rpy:406
translate russian cassidy_walk_outside_027a65b4:
    cassidy.say "НЕТ!"

# ch/cassidy/base.rpy:407
translate russian cassidy_walk_outside_da70d0f9:
    cassidy.say "Ты должен отвести меня домой!"

# ch/cassidy/base.rpy:408
translate russian cassidy_walk_outside_fa03af55:
    cassidy.say "Ты не можешь заставить меня сходить в туалет здесь!"

# ch/cassidy/base.rpy:411
translate russian cassidy_walk_outside_f5107535:
    "В ответ на мольбы Кэссиди я качаю головой."

# ch/cassidy/base.rpy:412
translate russian cassidy_walk_outside_bdb7d5b2:
    "От игры с мячом я ещё могу её избавить."

# ch/cassidy/base.rpy:413
translate russian cassidy_walk_outside_7321d1ab:
    "Но это уже основа собачьей жизни."

# ch/cassidy/base.rpy:414
translate russian cassidy_walk_outside_8d36647c:
    mike.say "Два варианта, Кэссиди."

# ch/cassidy/base.rpy:415
translate russian cassidy_walk_outside_c955c234:
    mike.say "Первый: я отвожу тебя к тому дереву, и ты делаешь это там."

# ch/cassidy/base.rpy:416
translate russian cassidy_walk_outside_0c6946ec:
    mike.say "Второй: мы остаёмся здесь, пока природа не возьмёт своё."

# ch/cassidy/base.rpy:417
translate russian cassidy_walk_outside_06537d7b:
    mike.say "Что выбираешь?"

# ch/cassidy/base.rpy:418
translate russian cassidy_walk_outside_36283c09:
    "Кэссиди смотрит на деревья, затем снова на меня."

# ch/cassidy/base.rpy:419
translate russian cassidy_walk_outside_cb83b06a:
    "Я вижу мольбу в её глазах."

# ch/cassidy/base.rpy:420
translate russian cassidy_walk_outside_866cb0e5:
    "Наверняка, когда она очаровывала папочку, это срабатывало каждый раз."

# ch/cassidy/base.rpy:421
translate russian cassidy_walk_outside_e69148f8:
    "Но со мной не сработает."

# ch/cassidy/base.rpy:422
translate russian cassidy_walk_outside_facbb419:
    "Я просто скрещиваю руки на груди и смотрю на неё сверху вниз."

# ch/cassidy/base.rpy:423
translate russian cassidy_walk_outside_ebd58315:
    "И в итоге оказываюсь прав: первой сдаётся Кэссиди."

# ch/cassidy/base.rpy:424
translate russian cassidy_walk_outside_f112b478:
    cassidy.say "Ладно, ладно..."

# ch/cassidy/base.rpy:425
translate russian cassidy_walk_outside_720e28cb:
    cassidy.say "Отведи меня к деревьям."

# ch/cassidy/base.rpy:426
translate russian cassidy_walk_outside_4beb1378:
    cassidy.say "Только быстрее!"

# ch/cassidy/base.rpy:427
translate russian cassidy_walk_outside_392d40a3:
    "Я пристёгиваю поводок к ошейнику Кэссиди и направляюсь к деревьям."

# ch/cassidy/base.rpy:428
translate russian cassidy_walk_outside_7a2f7f7b:
    "Конечно, по пути я не мешкаю."

# ch/cassidy/base.rpy:429
translate russian cassidy_walk_outside_811909f3:
    "Но и бежать сломя голову не собираюсь."

# ch/cassidy/base.rpy:430
translate russian cassidy_walk_outside_542b9640:
    "Когда мы добираемся, Кэссиди уже ёрзает и извивается."

# ch/cassidy/base.rpy:431
translate russian cassidy_walk_outside_72207248:
    "Она смотрит на меня снизу вверх, и я быстро киваю."

# ch/cassidy/base.rpy:432
translate russian cassidy_walk_outside_4fda18a2:
    "Тогда она подползает к ближайшему дереву и поворачивается к нему задом."

# ch/cassidy/base.rpy:434
translate russian cassidy_walk_outside_3f204903:
    cassidy.say "А-а-ах..."

# ch/cassidy/base.rpy:435
translate russian cassidy_walk_outside_4fbe6d35:
    cassidy.say "ТАК гораздо лучше!"

# ch/cassidy/base.rpy:436
translate russian cassidy_walk_outside_663d32bc:
    cassidy.say "П... погоди, ты же сказал, что не будешь смотреть!"

# ch/cassidy/base.rpy:437
translate russian cassidy_walk_outside_23a7f295:
    "Я невольно усмехаюсь, наблюдая, как краснеют щёки Кэссиди."

# ch/cassidy/base.rpy:438
translate russian cassidy_walk_outside_2d5b7a68:
    "Унижение едва не заставляет её трястись от злости."

# ch/cassidy/base.rpy:439
translate russian cassidy_walk_outside_6da011e9:
    "И после всех её капризов это для меня отличная награда."

# ch/cassidy/base.rpy:440
translate russian cassidy_walk_outside_81eae6ab:
    mike.say "Я сказал, что отвернусь, если ты захочешь, Кэссиди."

# ch/cassidy/base.rpy:441
translate russian cassidy_walk_outside_54925d60:
    mike.say "Но прежде чем начать писать, ты так и не приняла предложение."

# ch/cassidy/base.rpy:442
translate russian cassidy_walk_outside_1ffbdc61:
    mike.say "Поэтому я решил, что ты не против моего взгляда."

# ch/cassidy/base.rpy:444
translate russian cassidy_walk_outside_ed898da0:
    "Когда я вывожу Кэссиди из парка, она бормочет и ругается себе под нос."

# ch/cassidy/base.rpy:445
translate russian cassidy_walk_outside_1e158714:
    "А по дороге домой ведёт себя высокомернее прежнего."

# ch/cassidy/base.rpy:446
translate russian cassidy_walk_outside_4823b493:
    "Не то чтобы меня это сильно беспокоило."

# ch/cassidy/base.rpy:447
translate russian cassidy_walk_outside_2886403c:
    "Мне даже нравится, как она изображает нервную породистую сучку!"

# ch/cassidy/base.rpy:450
translate russian cassidy_walk_outside_4b4d0485:
    "Я оглядываюсь, всерьёз подумывая заставить Кэссиди пописать прямо здесь."

# ch/cassidy/base.rpy:451
translate russian cassidy_walk_outside_4cb5e2df:
    "Но затем вздыхаю и качаю головой, признавая поражение."

# ch/cassidy/base.rpy:452
translate russian cassidy_walk_outside_35f767a4:
    "Я уже надел на девушку ошейник и выгулял её голой."

# ch/cassidy/base.rpy:453
translate russian cassidy_walk_outside_43e29ea7:
    "Много ли добавит к этому то, что она пописает в парке?"

# ch/cassidy/base.rpy:454
translate russian cassidy_walk_outside_99ec7d9f:
    mike.say "Ладно, Кэссиди..."

# ch/cassidy/base.rpy:455
translate russian cassidy_walk_outside_9e35f525:
    mike.say "Пойдём домой."

# ch/cassidy/base.rpy:456
translate russian cassidy_walk_outside_5ffa40cc:
    cassidy.say "Ох, спасибо!"

# ch/cassidy/base.rpy:457
translate russian cassidy_walk_outside_6c1204af:
    cassidy.say "Спасибо, что не заставляешь писать здесь!"

# ch/cassidy/base.rpy:458
translate russian cassidy_walk_outside_e71d73e6:
    cassidy.say "Теперь я буду хорошей девочкой, обещаю!"

# ch/cassidy/base.rpy:459
translate russian cassidy_walk_outside_1a1e1edc:
    "Понятия не имею, что именно подразумевается под хорошим поведением Кэссиди."

# ch/cassidy/base.rpy:460
translate russian cassidy_walk_outside_649ff32c:
    "Но уверен, что, когда понадобится, что-нибудь придумаю."

# ch/cassidy/base.rpy:461
translate russian cassidy_walk_outside_cff84214:
    "Я снова пристёгиваю поводок, и мы идём обратно."

# ch/cassidy/base.rpy:463
translate russian cassidy_walk_outside_b36bc6ab:
    "На этот раз я задаю темп быстрее, и Кэссиди приходится поспевать."

# ch/cassidy/base.rpy:464
translate russian cassidy_walk_outside_f420502e:
    "Время от времени она словно собирается пожаловаться или попросить меня сбавить шаг."

# ch/cassidy/base.rpy:465
translate russian cassidy_walk_outside_f21fd75a:
    "Но затем что-то её останавливает, и она продолжает идти."

# ch/cassidy/base.rpy:466
translate russian cassidy_walk_outside_272d1d76:
    "Не знаю, то ли дело в недавнем обещании."

# ch/cassidy/base.rpy:467
translate russian cassidy_walk_outside_ba25a18e:
    "То ли мочевой пузырь вдруг напоминает, насколько он полон."

# ch/cassidy/base.rpy:468
translate russian cassidy_walk_outside_dcb72734:
    "Так или иначе, домой мы возвращаемся в рекордное время."

# ch/cassidy/base.rpy:469
translate russian cassidy_walk_outside_ba748b85:
    "Я едва успеваю открыть дверь, прежде чем Кэссиди влетает внутрь."

# ch/cassidy/base.rpy:470
translate russian cassidy_walk_outside_44067d38:
    "Выпускаю поводок, позволяя ей юркнуть в ванную."

# ch/cassidy/base.rpy:471
translate russian cassidy_walk_outside_96538eef:
    "И не могу сдержать улыбку, услышав через мгновение вздох облегчения."

# ch/cassidy/base.rpy:472
translate russian cassidy_walk_outside_551167d8:
    "Похоже, над послушанием и туалетными привычками нам ещё предстоит поработать."

# ch/cassidy/base.rpy:473
translate russian cassidy_walk_outside_bda41de6:
    "Но это подождёт до следующей прогулки с Кэссиди."

# ch/cassidy/base.rpy:474
translate russian cassidy_walk_outside_2cc7d208:
    "А пока можно придумать, чем поощрять её учиться."

# ch/cassidy/base.rpy:475
translate russian cassidy_walk_outside_fe36078d:
    "Может, и несколько наказаний..."

# ch/cassidy/base.rpy:481
translate russian cassidy_propose_male_f88d8506:
    "Мне нужно всё сделать правильно, как никогда прежде в жизни."

# ch/cassidy/base.rpy:482
translate russian cassidy_propose_male_b1a597c8:
    "Нет, даже не так: всё должно быть абсолютно, совершенно идеально!"

# ch/cassidy/base.rpy:483
translate russian cassidy_propose_male_7222b855:
    "Нельзя допустить ни одной ошибки, когда имеешь дело с Кэссиди."

# ch/cassidy/base.rpy:484
translate russian cassidy_propose_male_97ea7d1b:
    "Она становится для меня какой-то странной зависимостью."

# ch/cassidy/base.rpy:485
translate russian cassidy_propose_male_4abd96ad:
    "Чем больше времени я провожу с ней, тем больше хочу проводить."

# ch/cassidy/base.rpy:486
translate russian cassidy_propose_male_23fabdca:
    "А в разлуке думаю только о ней, пока мы снова не увидимся."

# ch/cassidy/base.rpy:487
translate russian cassidy_propose_male_f35deadb:
    "Поэтому я решил сделать всё возможное, чтобы быть рядом круглые сутки."

# ch/cassidy/base.rpy:488
translate russian cassidy_propose_male_c982738f:
    "В кармане спрятано кольцо, за которое я отдал больше денег, чем готов признать."

# ch/cassidy/base.rpy:489
translate russian cassidy_propose_male_9bb8c212:
    "Я столько раз отрепетировал всё в голове, что теперь помню намертво."

# ch/cassidy/base.rpy:490
translate russian cassidy_propose_male_cc709242:
    "Остаётся лишь выбрать подходящий момент для предложения."

# ch/cassidy/base.rpy:491
translate russian cassidy_propose_male_bfd4fa90:
    "Думаю, если удастся, Кэссиди почти наверняка согласится."

# ch/cassidy/base.rpy:492
translate russian cassidy_propose_male_aa0b7835:
    "О другом исходе я даже думать не хочу."

# ch/cassidy/base.rpy:493
translate russian cassidy_propose_male_8fb4f16e:
    "Не хочу представлять, что будет, если Кэссиди откажет..."

# ch/cassidy/base.rpy:494
translate russian cassidy_propose_male_829da182:
    "Нет, это я просто зря нагоняю мрачные мысли."

# ch/cassidy/base.rpy:495
translate russian cassidy_propose_male_e649eec8:
    "Сейчас мне нужен позитивный настрой."

# ch/cassidy/base.rpy:496
translate russian cassidy_propose_male_55e48f26:
    "Ну и смелость, чтобы наконец решиться!"

# ch/cassidy/base.rpy:498
translate russian cassidy_propose_male_954a5a68:
    cassidy.say "И тогда я ей сказала..."

# ch/cassidy/base.rpy:499
translate russian cassidy_propose_male_8718a4a0:
    cassidy.say "Я сказала..."

# ch/cassidy/base.rpy:501
translate russian cassidy_propose_male_e9dc51e5:
    cassidy.say "[lssb_cassidy.hero_name()]!"

# ch/cassidy/base.rpy:502
translate russian cassidy_propose_male_1a619a93:
    cassidy.say "Ты вообще меня слушаешь?!?"

# ch/cassidy/base.rpy:504
translate russian cassidy_propose_male_5f20b5be:
    "Внезапно голос Кэссиди возвращает меня к действительности."

# ch/cassidy/base.rpy:505
translate russian cassidy_propose_male_25d00390:
    "Я чувствую себя загнанным в угол и впадаю в панику."

# ch/cassidy/base.rpy:506
translate russian cassidy_propose_male_c0cc03a2:
    "Почему-то все мои инстинкты срабатывают невпопад."

# ch/cassidy/base.rpy:507
translate russian cassidy_propose_male_c84b1289:
    "И в, наверное, самый неподходящий момент я просто начинаю."

# ch/cassidy/base.rpy:508
translate russian cassidy_propose_male_808118bb:
    "Начинаю речь, которую готовил для самого подходящего момента."

# ch/cassidy/base.rpy:509
translate russian cassidy_propose_male_233b27a9:
    "Не успеваю опомниться, как уже стою на одном колене и достаю кольцо."

# ch/cassidy/base.rpy:510
translate russian cassidy_propose_male_7d3a0e63:
    mike.say "Кэссиди..."

# ch/cassidy/base.rpy:511
translate russian cassidy_propose_male_bc650587:
    mike.say "Ты выйдешь..."

# ch/cassidy/base.rpy:512
translate russian cassidy_propose_male_8069cfae:
    mike.say "Ты выйдешь за меня?"

# ch/cassidy/base.rpy:514
translate russian cassidy_propose_male_cc2db20c:
    "Если я и выглядел растерянным, до Кэссиди мне далеко."

# ch/cassidy/base.rpy:515
translate russian cassidy_propose_male_1e0dbbec:
    "Кажется, происходящее застаёт её совершенно врасплох."

# ch/cassidy/base.rpy:516
translate russian cassidy_propose_male_055cab00:
    "Будто этого она ожидала меньше всего на свете."

# ch/cassidy/base.rpy:517
translate russian cassidy_propose_male_594dbb93:
    "Вот только я не знаю, хорошо это или плохо!"

# ch/cassidy/base.rpy:519
translate russian cassidy_propose_male_1de832ab:
    cassidy.say "Я..."

# ch/cassidy/base.rpy:521
translate russian cassidy_propose_male_7fe582a6:
    cassidy.say "Я не знаю!"

# ch/cassidy/base.rpy:523
translate russian cassidy_propose_male_2a348534:
    "Я быстро верчу головой, оглядываясь."

# ch/cassidy/base.rpy:524
translate russian cassidy_propose_male_955c135e:
    "Все вокруг с интересом смотрят на нас."

# ch/cassidy/base.rpy:525
translate russian cassidy_propose_male_a2713a2a:
    "Кто-то ждёт милой романтической сцены прямо перед собой."

# ch/cassidy/base.rpy:526
translate russian cassidy_propose_male_1a02aad8:
    "Но я уверен, что некоторые смакуют моё неловкое положение."

# ch/cassidy/base.rpy:527
translate russian cassidy_propose_male_5adf1448:
    "И предвкушают, как мои надежды раздавят словно букашку!"

# ch/cassidy/base.rpy:528
translate russian cassidy_propose_male_1c0d45e8:
    mike.say "Ну..."

# ch/cassidy/base.rpy:529
translate russian cassidy_propose_male_1f59eaf6:
    mike.say "Может, ты... не знаю..."

# ch/cassidy/base.rpy:530
translate russian cassidy_propose_male_5c3d6a37:
    mike.say "Немного подумаешь и всё-таки ответишь в ближайшее время?"

# ch/cassidy/base.rpy:532
translate russian cassidy_propose_male_d5905eff:
    "Я вижу, как мои слова доходят до Кэссиди и выражение её лица начинает меняться."

# ch/cassidy/base.rpy:533
translate russian cassidy_propose_male_ed67b689:
    "И тут понимаю, что совершил ужасную ошибку."

# ch/cassidy/base.rpy:534
translate russian cassidy_propose_male_d9b73f46:
    "Потому что она мрачнеет с каждой секундой."

# ch/cassidy/base.rpy:535
translate russian cassidy_propose_male_1e449f06:
    "Прежде чем я успеваю отреагировать, Кэссиди бьёт по руке с кольцом."

# ch/cassidy/base.rpy:536
translate russian cassidy_propose_male_bce0fe8f:
    "Я едва успеваю отдёрнуть её, чтобы не выронить кольцо!"

# ch/cassidy/base.rpy:537
translate russian cassidy_propose_male_200eb25b:
    mike.say "Эй!"

# ch/cassidy/base.rpy:538
translate russian cassidy_propose_male_3480111f:
    mike.say "Какого чёрта, Кэссиди?!?"

# ch/cassidy/base.rpy:539
translate russian cassidy_propose_male_59ad3274:
    "Теперь обе её руки сжаты в кулаки."

# ch/cassidy/base.rpy:540
translate russian cassidy_propose_male_65adb9d4:
    "Она упирает их в бёдра и сердито смотрит на меня сверху."

# ch/cassidy/base.rpy:542
translate russian cassidy_propose_male_d50783c5:
    cassidy.say "Как ты смеешь так внезапно ошарашивать меня подобным?"

# ch/cassidy/base.rpy:543
translate russian cassidy_propose_male_35f5a1f3:
    cassidy.say "Вот так запросто брать и делать предложение?"

# ch/cassidy/base.rpy:544
translate russian cassidy_propose_male_8e40aad6:
    cassidy.say "Если хотел устроить сюрприз, нужно было предупредить заранее!"

# ch/cassidy/base.rpy:546
translate russian cassidy_propose_male_f871cc9c:
    "Я слышу слова Кэссиди."

# ch/cassidy/base.rpy:547
translate russian cassidy_propose_male_a1684623:
    "И в каком-то смысле они кажутся совершенно логичными."

# ch/cassidy/base.rpy:548
translate russian cassidy_propose_male_dc19f10d:
    "Но затем я недоумённо моргаю."

# ch/cassidy/base.rpy:549
translate russian cassidy_propose_male_7e8327b3:
    "Она что..."

# ch/cassidy/base.rpy:550
translate russian cassidy_propose_male_a4ad41c3:
    "Она и правда только что сказала, что о сюрпризе нужно предупреждать заранее?"

# ch/cassidy/base.rpy:551
translate russian cassidy_propose_male_2b1191ee:
    mike.say "Но, Кэссиди..."

# ch/cassidy/base.rpy:552
translate russian cassidy_propose_male_ae8edff8:
    mike.say "Если я заранее скажу..."

# ch/cassidy/base.rpy:553
translate russian cassidy_propose_male_1e65bfd2:
    mike.say "То это уже не будет сюрпризом, правда?"

# ch/cassidy/base.rpy:554
translate russian cassidy_propose_male_fec7729e:
    "Кэссиди закатывает глаза и раздражённо фыркает."

# ch/cassidy/base.rpy:555
translate russian cassidy_propose_male_4395009d:
    "Выглядит так, будто объясняет простейшую вещь идиоту."

# ch/cassidy/base.rpy:557
translate russian cassidy_propose_male_165a4847:
    cassidy.say "Уф..."

# ch/cassidy/base.rpy:558
translate russian cassidy_propose_male_a336cee1:
    cassidy.say "Дайте мне сил!"

# ch/cassidy/base.rpy:559
translate russian cassidy_propose_male_f14d1ed7:
    cassidy.say "Не нужно прямо говорить, что собираешься сделать предложение."

# ch/cassidy/base.rpy:560
translate russian cassidy_propose_male_1a01872e:
    cassidy.say "Но нужно тонко намекать, чтобы я знала, что всё к этому идёт!"

# ch/cassidy/base.rpy:561
translate russian cassidy_propose_male_cb53368b:
    cassidy.say "Тогда я смогу подготовиться к самому моменту!"

# ch/cassidy/base.rpy:563
translate russian cassidy_propose_male_50ddb94c:
    mike.say "Нужно?"

# ch/cassidy/base.rpy:564
translate russian cassidy_propose_male_ba7f7e02:
    mike.say "Ого..."

# ch/cassidy/base.rpy:565
translate russian cassidy_propose_male_b202e364:
    mike.say "Я и не знал!"

# ch/cassidy/base.rpy:567
translate russian cassidy_propose_male_83a42295:
    cassidy.say "Уж это очевидно!"

# ch/cassidy/base.rpy:569
translate russian cassidy_propose_male_b1999cb0:
    "Я смотрю на кольцо, затем снова на Кэссиди."

# ch/cassidy/base.rpy:570
translate russian cassidy_propose_male_91c93981:
    mike.say "Знаешь, Кэссиди..."

# ch/cassidy/base.rpy:571
translate russian cassidy_propose_male_9e4f903a:
    mike.say "Ты ведь так и не ответила на вопрос..."

# ch/cassidy/base.rpy:573
translate russian cassidy_propose_male_1ba36923:
    cassidy.say "НЕТ!" with vpunch

# ch/cassidy/base.rpy:574
translate russian cassidy_propose_male_daad3488:
    cassidy.say "Мой ответ — нет, [lssb_cassidy.hero_name()]."

# ch/cassidy/base.rpy:575
translate russian cassidy_propose_male_d8e4d854:
    cassidy.say "И таким останется, пока ты не начнёшь соображать!"

# ch/cassidy/base.rpy:577
translate russian cassidy_propose_male_7041c68d:
    "С этими словами Кэссиди сердито уходит."

# ch/cassidy/base.rpy:578
translate russian cassidy_propose_male_fb375c2d:
    "А я медленно поднимаюсь на ноги."

# ch/cassidy/base.rpy:579
translate russian cassidy_propose_male_385b6821:
    "Пряча кольцо, чувствую на себе взгляды всех вокруг."

# ch/cassidy/base.rpy:580
translate russian cassidy_propose_male_cd8f5782:
    "Вот тебе и идеально подготовленное предложение!"

# ch/cassidy/base.rpy:584
translate russian cassidy_propose_male_d5905eff_1:
    "Я вижу, как мои слова доходят до Кэссиди и выражение её лица начинает меняться."

# ch/cassidy/base.rpy:585
translate russian cassidy_propose_male_1a98a08f:
    "И тут у меня щемит сердце от нежности к ней."

# ch/cassidy/base.rpy:587
translate russian cassidy_propose_male_34d92cac:
    "Растерянность на её лице сменяется изумлением."

# ch/cassidy/base.rpy:588
translate russian cassidy_propose_male_048c0216:
    "И кажется, она даже сдерживает слёзы!"

# ch/cassidy/base.rpy:589
translate russian cassidy_propose_male_9fee5fdb:
    mike.say "Кэссиди?"

# ch/cassidy/base.rpy:590
translate russian cassidy_propose_male_c633af0c:
    mike.say "Ты в порядке?"

# ch/cassidy/base.rpy:591
translate russian cassidy_propose_male_1d159bb5:
    "Кэссиди кивает и машет рукой, пытаясь заговорить."

# ch/cassidy/base.rpy:593
translate russian cassidy_propose_male_099ce028:
    cassidy.say "Д... да..."

# ch/cassidy/base.rpy:595
translate russian cassidy_propose_male_78436085:
    cassidy.say "Да на оба вопроса!"

# ch/cassidy/base.rpy:597
translate russian cassidy_propose_male_fd740ca1:
    "На мгновение я смотрю на неё с недоумением."

# ch/cassidy/base.rpy:598
translate russian cassidy_propose_male_7607efb4:
    "Затем до меня доходит смысл."

# ch/cassidy/base.rpy:599
translate russian cassidy_propose_male_82c3efa9:
    "Я радостно киваю и наклоняюсь вперёд."

# ch/cassidy/base.rpy:600
translate russian cassidy_propose_male_e63f0815:
    "Кэссиди протягивает мне руку."

# ch/cassidy/base.rpy:601
translate russian cassidy_propose_male_6ee48159:
    "И я надеваю кольцо ей на палец."

# ch/cassidy/base.rpy:602
translate russian cassidy_propose_male_b68d0842:
    "Она изумлённо разглядывает его, буквально потеряв дар речи."

# ch/cassidy/base.rpy:603
translate russian cassidy_propose_male_c29a7a58:
    "Зато у меня появляется возможность встать и собраться с мыслями."

# ch/cassidy/base.rpy:604
translate russian cassidy_propose_male_722b919b:
    mike.say "Ты на миг меня напугала, Кэссиди."

# ch/cassidy/base.rpy:605
translate russian cassidy_propose_male_78861c28:
    mike.say "Я решил, что ты откажешь."

# ch/cassidy/base.rpy:606
translate russian cassidy_propose_male_fe5c19be:
    mike.say "Или, того хуже, взорвёшься!"

# ch/cassidy/base.rpy:607
translate russian cassidy_propose_male_4e3fbd7b:
    "Кэссиди отрывает взгляд от кольца."

# ch/cassidy/base.rpy:608
translate russian cassidy_propose_male_a39d0488:
    "Затем качает головой."

# ch/cassidy/base.rpy:610
translate russian cassidy_propose_male_f45dd524:
    cassidy.say "Что?"

# ch/cassidy/base.rpy:611
translate russian cassidy_propose_male_ea83b3d8:
    cassidy.say "Ты правда думаешь, что я могла бы так поступить?!?"

# ch/cassidy/base.rpy:612
translate russian cassidy_propose_male_935ff479:
    cassidy.say "Ни за что, [lssb_cassidy.hero_name()]!"

# ch/cassidy/base.rpy:613
translate russian cassidy_propose_male_9d5c68d0:
    cassidy.say "Ты просто застал меня врасплох, вот и всё."

# ch/cassidy/base.rpy:615
translate russian cassidy_propose_male_f5324c97:
    "Я киваю и улыбаюсь, не вполне уверенный, что она говорит всю правду."

# ch/cassidy/base.rpy:616
translate russian cassidy_propose_male_b7c548ed:
    "Но ни за что не стану в этом копаться."

# ch/cassidy/base.rpy:617
translate russian cassidy_propose_male_3a8178da:
    "Не тогда, когда Кэссиди только что согласилась выйти за меня!"

# ch/cassidy/base.rpy:618
translate russian cassidy_propose_male_d83f9878:
    mike.say "Конечно нет, Кэссиди."

# ch/cassidy/base.rpy:619
translate russian cassidy_propose_male_8bac9d8f:
    mike.say "Просто нервы сдали, понимаешь?"

# ch/cassidy/base.rpy:620
translate russian cassidy_propose_male_8a0f9d86:
    mike.say "Вот и напридумывал всякой ерунды."

# ch/cassidy/base.rpy:621
translate russian cassidy_propose_male_49f096d8:
    "Кэссиди довольно кивает, принимая объяснение."

# ch/cassidy/base.rpy:622
translate russian cassidy_propose_male_f6526156:
    "Затем снова принимается рассматривать кольцо."

# ch/cassidy/base.rpy:624
translate russian cassidy_propose_male_87b930eb:
    cassidy.say "Так когда я получу настоящее кольцо?"

# ch/cassidy/base.rpy:626
translate russian cassidy_propose_male_30e74fc5:
    mike.say "Эм..."

# ch/cassidy/base.rpy:627
translate russian cassidy_propose_male_584a5d94:
    mike.say "В смысле, Кэссиди?"

# ch/cassidy/base.rpy:629
translate russian cassidy_propose_male_4ab1704f:
    cassidy.say "Ну это же не настоящее кольцо, да?"

# ch/cassidy/base.rpy:630
translate russian cassidy_propose_male_59c96cac:
    cassidy.say "Ты ведь купил его только на первое время?"

# ch/cassidy/base.rpy:631
translate russian cassidy_propose_male_3268cd74:
    cassidy.say "Пока не найдёшь что-нибудь пороскошнее?"

# ch/cassidy/base.rpy:633
translate russian cassidy_propose_male_25c0db37:
    "Я смотрю на Кэссиди в полном изумлении."

# ch/cassidy/base.rpy:634
translate russian cassidy_propose_male_ce7bf9ac:
    "Рот открывается и закрывается, словно у оглушённой рыбы."

# ch/cassidy/base.rpy:636
translate russian cassidy_propose_male_6701b43c:
    cassidy.say "Шучу!"

# ch/cassidy/base.rpy:637
translate russian cassidy_propose_male_bd6626fa:
    cassidy.say "Я просто шучу, [lssb_cassidy.hero_name()]!"

# ch/cassidy/base.rpy:638
translate russian cassidy_propose_male_522ea5a6:
    cassidy.say "Мне нравится это. Оно идеально!"

# ch/cassidy/base.rpy:640
translate russian cassidy_propose_male_53fdcf27:
    "Я киваю и улыбаюсь, пытаясь посмеяться над шуткой Кэссиди."

# ch/cassidy/base.rpy:641
translate russian cassidy_propose_male_e003e64a:
    "Но сердце всё ещё колотится в груди..."

# ch/cassidy/base.rpy:660
translate russian cassidy_ask_date_audrey_cassidy_palla_98ef998d:
    mike.say "Хочешь собраться с Одри и Паллой и повеселиться?"

# ch/cassidy/base.rpy:662
translate russian cassidy_ask_date_audrey_cassidy_palla_ea707c6c:
    cassidy.say "Ещё бы, блядь!"

# ch/cassidy/base.rpy:674
translate russian cassidy_ask_date_audrey_cassidy_palla_760cbb94:
    cassidy.say "Не хочется, прости."

# ch/cassidy/base.rpy:678
translate russian cassidy_ask_date_cassidy_palla_ea28e1f6:
    mike.say "Вы с Паллой не хотите повеселиться вместе, как тогда в клубе?"

# ch/cassidy/base.rpy:680
translate russian cassidy_ask_date_cassidy_palla_ea707c6c:
    cassidy.say "Ещё бы, блядь!"

# ch/cassidy/base.rpy:692
translate russian cassidy_ask_date_cassidy_palla_760cbb94:
    cassidy.say "Не хочется, прости."

# ch/cassidy/base.rpy:696
translate russian cassidy_ask_date_alone_male_0e5b745f:
    mike.say "Кэссиди, не хочешь сходить со мной на свидание?"

# ch/cassidy/base.rpy:698
translate russian cassidy_ask_date_alone_male_2eb185dc:
    cassidy.say "Прости, [lssb_cassidy.hero_name()], я не воспринимаю тебя в таком качестве."

# ch/cassidy/base.rpy:701
translate russian cassidy_ask_date_alone_male_76af992c:
    cassidy.say "Конечно, может быть весело. Когда пойдём?"

# ch/cassidy/chat.rpy:3
translate russian cassidy_desire_0_male_130aa59e:
    cassidy.say "Стань поинтереснее, иначе я начну делать тебе больно просто ради твоих криков."

# ch/cassidy/chat.rpy:4
translate russian cassidy_desire_0_male_cc45fbc5:
    mike.say "Это не очень-то мило."

# ch/cassidy/chat.rpy:5
translate russian cassidy_desire_0_male_f504c12e:
    cassidy.say "Вот новость!"

# ch/cassidy/chat.rpy:8
translate russian cassidy_desire_0_male_cae2d34e:
    cassidy.say "Не верится, что я позволила тебе так со мной поступить."

# ch/cassidy/chat.rpy:9
translate russian cassidy_desire_0_male_c970eff1:
    mike.say "Ты здорово облажалась, правда?"

# ch/cassidy/chat.rpy:10
translate russian cassidy_desire_0_male_448dca53:
    cassidy.say "Да."

# ch/cassidy/chat.rpy:11
translate russian cassidy_desire_0_male_124ccb8e:
    mike.say "Вот и я тебя здорово оттрахаю."

# ch/cassidy/chat.rpy:12
translate russian cassidy_desire_0_male_c4777e94:
    "Кэссиди вздыхает."

# ch/cassidy/chat.rpy:15
translate russian cassidy_desire_0_male_b66850c7:
    cassidy.say "Чего тебе, [lssb_cassidy.hero_name()]? Надеюсь, ты принёс что-нибудь поесть."

# ch/cassidy/chat.rpy:16
translate russian cassidy_desire_0_male_393014ce:
    mike.say "Трудный день?"

# ch/cassidy/chat.rpy:17
translate russian cassidy_desire_0_male_a14bae23:
    cassidy.say "Твой ребёнок с рассвета использует мой мочевой пузырь как батут. Так что да."

# ch/cassidy/chat.rpy:19
translate russian cassidy_desire_0_male_5c25b4f4:
    cassidy.say "Вот ты где. Я уже собиралась отправить кого-нибудь на поиски."

# ch/cassidy/chat.rpy:20
translate russian cassidy_desire_0_male_20c700de:
    mike.say "Скучала?"

# ch/cassidy/chat.rpy:21
translate russian cassidy_desire_0_male_6ae90d0d:
    cassidy.say "Я такого не говорила. Но можешь так думать, если тебе от этого приятно."

# ch/cassidy/chat.rpy:23
translate russian cassidy_desire_0_male_0e0b093a:
    cassidy.say "Чего тебе, [lssb_cassidy.hero_name()]?"

# ch/cassidy/chat.rpy:32
translate russian cassidy_desire_2_male_7a9cf613:
    cassidy.say "Надо признать, на коленях ты выглядишь чертовски потрясающе."

# ch/cassidy/chat.rpy:33
translate russian cassidy_desire_2_male_4eb7eaf8:
    mike.say "Ты тоже!"

# ch/cassidy/chat.rpy:34
translate russian cassidy_desire_2_male_70c031f6:
    cassidy.say "Ты не заслуживаешь, чтобы я перед тобой вставала на колени."

# ch/cassidy/chat.rpy:35
translate russian cassidy_desire_2_male_230db1bf:
    mike.say "Ай! Обидно."

# ch/cassidy/chat.rpy:36
translate russian cassidy_desire_2_male_6ccfd2d9:
    cassidy.say "Хорошо, нужно знать своё место. К счастью, ты там отлично смотришься."

# ch/cassidy/chat.rpy:40
translate russian cassidy_desire_2_male_2a2b097a:
    cassidy.say "[lssb_cassidy.hero_name()], единственное, что делает это терпимым, — ты чертовски сексуален."

# ch/cassidy/chat.rpy:41
translate russian cassidy_desire_2_male_fec147da:
    mike.say "И в сексе я тоже чертовски хорош."

# ch/cassidy/chat.rpy:42
translate russian cassidy_desire_2_male_184c591c:
    cassidy.say "Правда, ещё ты редкостный придурок."

# ch/cassidy/chat.rpy:44
translate russian cassidy_desire_2_male_826cab59:
    cassidy.say "Трудно привыкнуть к нашей... договорённости. Раньше я ездила куда угодно, а теперь должна оставаться здесь и целыми днями сидеть в твоём офисе."

# ch/cassidy/chat.rpy:45
translate russian cassidy_desire_2_male_e62175d3:
    mike.say "Бывает и гораздо хуже."

# ch/cassidy/chat.rpy:46
translate russian cassidy_desire_2_male_963a4afb:
    cassidy.say "Да ну? Назови десять примеров."

# ch/cassidy/chat.rpy:47
translate russian cassidy_desire_2_male_a49e2dbb:
    mike.say "Целый день в моём офисе со связанными за спиной руками и анальной пробкой во рту. Остальные девять сама додумай."

# ch/cassidy/chat.rpy:51
translate russian cassidy_desire_2_male_7562b35c:
    cassidy.say "Уф, посмотри на меня. Раньше я притягивала все взгляды, [lssb_cassidy.hero_name()]."

# ch/cassidy/chat.rpy:52
translate russian cassidy_desire_2_male_2fe31783:
    mike.say "И сейчас притягиваешь. А ещё все замечают, как ты сияешь."

# ch/cassidy/chat.rpy:53
translate russian cassidy_desire_2_male_ff81651b:
    cassidy.say "Сияю. Ну да. Хотя повтори-ка. На этот раз помедленнее."

# ch/cassidy/chat.rpy:55
translate russian cassidy_desire_2_male_f53f2ed6:
    cassidy.say "Тебе говорили, что, когда приведёшь себя в порядок, ты удивительно хорош, [lssb_cassidy.hero_name()]?"

# ch/cassidy/chat.rpy:56
translate russian cassidy_desire_2_male_5a1fc92b:
    mike.say "Только ты."

# ch/cassidy/chat.rpy:57
translate russian cassidy_desire_2_male_5d7a9ae9:
    cassidy.say "Отлично. Пусть так и остаётся."

# ch/cassidy/chat.rpy:59
translate russian cassidy_desire_2_male_ab0b724f:
    cassidy.say "Пожалуй, ты сойдёшь. В качестве красивого спутника."

# ch/cassidy/chat.rpy:60
translate russian cassidy_desire_2_male_6377f597:
    mike.say "Высокая похвала."

# ch/cassidy/chat.rpy:61
translate russian cassidy_desire_2_male_acd40a3a:
    cassidy.say "Выше сегодня не получишь, так что цени."

# ch/cassidy/chat.rpy:68
translate russian cassidy_desire_3_male_e95f0f1d:
    cassidy.say "Я подумывала для разнообразия позволить тебе быть сверху."

# ch/cassidy/chat.rpy:69
translate russian cassidy_desire_3_male_d1e638fa:
    cassidy.say "Но только если скажешь, какая я богиня!"

# ch/cassidy/chat.rpy:71
translate russian cassidy_desire_3_male_eb1190b2:
    cassidy.say "Тебе стоит почаще отдаваться мне, [lssb_cassidy.hero_name()]."

# ch/cassidy/chat.rpy:72
translate russian cassidy_desire_3_male_ff291236:
    mike.say "Что ты имеешь в виду?"

# ch/cassidy/chat.rpy:73
translate russian cassidy_desire_3_male_789f5c76:
    cassidy.say "Для моего раба ты слишком редко радуешь меня своим членом."

# ch/cassidy/chat.rpy:74
translate russian cassidy_desire_3_male_46dcd80e:
    cassidy.say "Лучше своди меня куда-нибудь и накорми своим членом. И поскорее."

# ch/cassidy/chat.rpy:75
translate russian cassidy_desire_3_male_eaf4fc67:
    mike.say "Да, госпожа!"

# ch/cassidy/chat.rpy:78
translate russian cassidy_desire_3_male_40cfd7be:
    cassidy.say "Знаешь, что странно? Недавно я легла спать — дома, я имею в виду — и думала о тебе."

# ch/cassidy/chat.rpy:79
translate russian cassidy_desire_3_male_4dd720ba:
    mike.say "Хорошее или плохое?"

# ch/cassidy/chat.rpy:80
translate russian cassidy_desire_3_male_0976f0d9:
    cassidy.say "Ну, я плакала."

# ch/cassidy/chat.rpy:81
translate russian cassidy_desire_3_male_72701b5b:
    mike.say "Когда я говорил, что хочу довести тебя до крика, имел в виду крики «Ещё!» или «О боже!»."

# ch/cassidy/chat.rpy:82
translate russian cassidy_desire_3_male_ed84525f:
    cassidy.say "Вообще-то «О боже» я, кажется, тоже кричала."

# ch/cassidy/chat.rpy:83
translate russian cassidy_desire_3_male_8f0630ea:
    mike.say "Боюсь спросить."

# ch/cassidy/chat.rpy:84
translate russian cassidy_desire_3_male_bd414169:
    cassidy.say "Да, а потом: «Что я натворила!»"

# ch/cassidy/chat.rpy:85
translate russian cassidy_desire_3_male_8aa7fe6a:
    mike.say "Ты меня дразнишь."

# ch/cassidy/chat.rpy:86
translate russian cassidy_desire_3_male_adbfd649:
    cassidy.say "Немного!"

# ch/cassidy/chat.rpy:96
translate russian cassidy_desire_4_male_f50391a5:
    cassidy.say "[lssb_cassidy.hero_name()], я всё думаю, какой матерью стану."

# ch/cassidy/chat.rpy:97
translate russian cassidy_desire_4_male_1a2e08e6:
    mike.say "Замечательной."

# ch/cassidy/chat.rpy:98
translate russian cassidy_desire_4_male_883728cc:
    cassidy.say "Мама ушла, когда я была маленькой. Папочка спихнул меня на нянь. У меня, мягко говоря, нет примера перед глазами."

# ch/cassidy/chat.rpy:99
translate russian cassidy_desire_4_male_be297b26:
    mike.say "Значит, создай свой. У тебя есть я, и я никуда не денусь."

# ch/cassidy/chat.rpy:100
translate russian cassidy_desire_4_male_08f8966d:
    cassidy.say "...От этого не должно становиться легче. Но немного становится. Как всегда."

# ch/cassidy/chat.rpy:102
translate russian cassidy_desire_4_male_fd9c25cd:
    cassidy.say "[lssb_cassidy.hero_name()], ты вообще ещё общаешься с родителями?"

# ch/cassidy/chat.rpy:103
translate russian cassidy_desire_4_male_885ecb99:
    mike.say "Ну да, конечно."

# ch/cassidy/chat.rpy:104
translate russian cassidy_desire_4_male_276e112b:
    cassidy.say "Мама ушла, когда я была маленькой, а папочка всегда занят работой. И ещё, фу, мачеха. Она едва старше меня."

# ch/cassidy/chat.rpy:105
translate russian cassidy_desire_4_male_df1d2236:
    mike.say "То есть ты почти ни с кем из них не разговариваешь?"

# ch/cassidy/chat.rpy:106
translate russian cassidy_desire_4_male_3b4f8692:
    cassidy.say "Почти нет."

# ch/cassidy/chat.rpy:107
translate russian cassidy_desire_4_male_bd249699:
    mike.say "Грустно. Но посмотри с другой стороны: у тебя есть я, а я разговариваю с тобой постоянно!"

# ch/cassidy/chat.rpy:108
translate russian cassidy_desire_4_male_6561a62d:
    cassidy.say "Это правда. Ты у меня есть и действительно разговариваешь. От этого не должно становиться легче, но немного становится."

# ch/cassidy/chat.rpy:118
translate russian cassidy_desire_5_male_128e1ab6:
    cassidy.say "Чем я заслужила такого сексуального и обаятельного парня, как ты?"

# ch/cassidy/chat.rpy:120
translate russian cassidy_desire_5_male_82f709b7:
    cassidy.say "Чем я заслужила такого раздолбая, как ты? Милого, конечно, но всё-таки раздолбая."

# ch/cassidy/chat.rpy:121
translate russian cassidy_desire_5_male_6daa6609:
    mike.say "Ты пыталась меня шантажировать, подстроив всё так, будто я украл у компании три миллиона долларов."

# ch/cassidy/chat.rpy:123
translate russian cassidy_desire_5_male_f72146fd:
    mike.say "И сработало, так что, выходит, преступления окупаются."

# ch/cassidy/chat.rpy:126
translate russian cassidy_desire_5_male_5feb484f:
    mike.say "Но у тебя это вышло хреново, ты попалась, и теперь сосёшь у меня."

# ch/cassidy/chat.rpy:128
translate russian cassidy_desire_5_male_43fb836f:
    cassidy.say "А ещё ты романтичный как пень."

# ch/cassidy/chat.rpy:135
translate russian cassidy_love_0_male_ad9cf76b:
    cassidy.say "По-моему, если ты не лижешь мою киску, чем дольше твой рот закрыт, тем лучше."

# ch/cassidy/chat.rpy:136
translate russian cassidy_love_0_male_24092189:
    mike.say "Это не оч..."

# ch/cassidy/chat.rpy:137
translate russian cassidy_love_0_male_827cfc37:
    cassidy.say "Заткнись, [lssb_cassidy.hero_name()]! Не хочу слушать."

# ch/cassidy/chat.rpy:140
translate russian cassidy_love_0_male_f0e5687a:
    cassidy.say "Как ты развлекаешься?"

# ch/cassidy/chat.rpy:141
translate russian cassidy_love_0_male_489a3763:
    mike.say "С тобой!"

# ch/cassidy/chat.rpy:142
translate russian cassidy_love_0_male_12501f02:
    cassidy.say "Мило. Ты со всеми девушками так?"

# ch/cassidy/chat.rpy:143
translate russian cassidy_love_0_male_7362f45f:
    mike.say "Нет, только с теми, кто пытался упечь меня за решётку и провалился. То есть только с тобой."

# ch/cassidy/chat.rpy:147
translate russian cassidy_love_0_male_e91f0a6e:
    cassidy.say "Кажется, у меня есть ошейник с твоим именем."

# ch/cassidy/chat.rpy:148
translate russian cassidy_love_0_male_2f6303f2:
    mike.say "Ого, откуда это взялось?"

# ch/cassidy/chat.rpy:149
translate russian cassidy_love_0_male_6dce0394:
    cassidy.say "Купила в зоомагазине."

# ch/cassidy/chat.rpy:150
translate russian cassidy_love_0_male_5126ef1f:
    mike.say "Нет, я о том, почему ты вообще это сказала?"

# ch/cassidy/chat.rpy:151
translate russian cassidy_love_0_male_b4e5c373:
    cassidy.say "Просто представила тебя в нём, на коленях, выпрашивающего... косточку."

# ch/cassidy/chat.rpy:152
translate russian cassidy_love_0_male_a9549dcc:
    "Вот чёрт, не пойму, возбуждает это или пугает. Наверное, и то и другое."

# ch/cassidy/chat.rpy:153
translate russian cassidy_love_0_male_525d2347:
    cassidy.say "Это помогает скрасить скуку, которую я испытываю в твоей компании."

# ch/cassidy/chat.rpy:156
translate russian cassidy_love_0_male_485cdd33:
    cassidy.say "Послушай, ты милый, [lssb_cassidy.hero_name()], но даже не думай, что у тебя есть со мной шансы."

# ch/cassidy/chat.rpy:157
translate russian cassidy_love_0_male_0ff62900:
    mike.say "Тогда почему ты всё ещё со мной разговариваешь?"

# ch/cassidy/chat.rpy:158
translate russian cassidy_love_0_male_566e6739:
    cassidy.say "Хороший вопрос!"

# ch/cassidy/chat.rpy:166
translate russian cassidy_love_2_male_6ee5c175:
    cassidy.say "Что самое впечатляющее ты умеешь делать?"

# ch/cassidy/chat.rpy:168
translate russian cassidy_love_2_male_b90fcd26:
    mike.say "Я бы сказал, мои навыки вылизывания кисок весьма впечатляют."

# ch/cassidy/chat.rpy:169
translate russian cassidy_love_2_male_1c6c717d:
    cassidy.say "Эм, тебе ещё тренироваться и тренироваться. Попробуй ещё раз."

# ch/cassidy/chat.rpy:170
translate russian cassidy_love_2_male_64143c52:
    mike.say "А, я умею совмещать тебя, работу и двух потрясающих соседок."

# ch/cassidy/chat.rpy:171
translate russian cassidy_love_2_male_0742a79a:
    "Кэссиди смотрит на меня без всякого выражения."

# ch/cassidy/chat.rpy:172
translate russian cassidy_love_2_male_bfec4590:
    cassidy.say "Ты их трахаешь?"

# ch/cassidy/chat.rpy:174
translate russian cassidy_love_2_male_1f755d86:
    mike.say "Нет, ещё не приходилось. А что, стоит?"

# ch/cassidy/chat.rpy:175
translate russian cassidy_love_2_male_a63dc7f7:
    cassidy.say "Пока ты мой раб — не посмеешь!"

# ch/cassidy/chat.rpy:178
translate russian cassidy_love_2_male_653b531d:
    mike.say "Эм, было несколько раз, но ничего серьёзного."

# ch/cassidy/chat.rpy:179
translate russian cassidy_love_2_male_fd3198d8:
    cassidy.say "Ты ведь перестал?"

# ch/cassidy/chat.rpy:180
translate russian cassidy_love_2_male_4cf775c5:
    mike.say "Что?"

# ch/cassidy/chat.rpy:181
translate russian cassidy_love_2_male_de1608e2:
    cassidy.say "Перестал их трахать, когда всё это началось, да?"

# ch/cassidy/chat.rpy:182
translate russian cassidy_love_2_male_383d0879:
    mike.say "Я... нет. Не думал, что наша договорённость подразумевает исключительность. Я же просто твоя секс-игрушка? Хочешь сказать, мне нельзя иметь другие отношения?"

# ch/cassidy/chat.rpy:183
translate russian cassidy_love_2_male_4911fb0d:
    cassidy.say "Хм. Возможно. Я подумаю."

# ch/cassidy/chat.rpy:186
translate russian cassidy_love_2_male_5000b2b8:
    mike.say "Я умею поставить девушку на колени."

# ch/cassidy/chat.rpy:188
translate russian cassidy_love_2_male_73680816:
    cassidy.say "Шантажируя её? Угрожая погубить, если не сделает, что ты хочешь?"

# ch/cassidy/chat.rpy:190
translate russian cassidy_love_2_male_12ff5a6c:
    cassidy.say "Шантажируя её? Угрожая добиться увольнения её папочки, если не сделает, что ты хочешь?"

# ch/cassidy/chat.rpy:191
translate russian cassidy_love_2_male_7672b5a4:
    mike.say "Можешь честно сказать, что она этого не заслужила?"

# ch/cassidy/chat.rpy:192
translate russian cassidy_love_2_male_e6d541ef:
    "Кэссиди открывает рот, собираясь возразить, но останавливается."

# ch/cassidy/chat.rpy:193
translate russian cassidy_love_2_male_7ca57f08:
    mike.say "Вот видишь?"

# ch/cassidy/chat.rpy:197
translate russian cassidy_love_3_male_d3571bec:
    cassidy.say "Где ты любишь гулять?"

# ch/cassidy/chat.rpy:198
translate russian cassidy_love_3_male_f117cbb9:
    mike.say "Странный вопрос."

# ch/cassidy/chat.rpy:199
translate russian cassidy_love_3_male_402add05:
    cassidy.say "Я просто пытаюсь узнать тебя получше."

# ch/cassidy/chat.rpy:200
translate russian cassidy_love_3_male_69798fe7:
    mike.say "Ну, люблю парк. Обычно там тихо. Днём, правда, людно, но прохожие просто создают фон и в основном довольны. Так или иначе, это успокаивает."

# ch/cassidy/chat.rpy:201
translate russian cassidy_love_3_male_388509df:
    mike.say "А ты?"

# ch/cassidy/chat.rpy:202
translate russian cassidy_love_3_male_aaf581ae:
    cassidy.say "В центре города, особенно в Испании и Италии. Люблю архитектуру, людские голоса. В Барселоне могу часами бродить, пить вино с тапас и наблюдать за прохожими."

# ch/cassidy/chat.rpy:203
translate russian cassidy_love_3_male_ca7add0a:
    mike.say "Что такое тапас?"

# ch/cassidy/chat.rpy:204
translate russian cassidy_love_3_male_e9c2d70a:
    cassidy.say "Серьёзно, ты вообще хоть что-нибудь знаешь?"

# ch/cassidy/chat.rpy:205
translate russian cassidy_love_3_male_64e4ce93:
    mike.say "Видимо, нет."

# ch/cassidy/chat.rpy:206
translate russian cassidy_love_3_male_7a04eb7a:
    cassidy.say "В Испании так подают закуски на маленьких тарелках, можно взять сразу несколько. Недорого, вкусно, без церемоний. А тарелкой накрывают стакан, чтобы не лезли мухи."

# ch/cassidy/chat.rpy:207
translate russian cassidy_love_3_male_9c419153:
    mike.say "О, странно."

# ch/cassidy/chat.rpy:208
translate russian cassidy_love_3_male_7f45bed4:
    cassidy.say "Нет, это чудесно. Впитываешь всё вокруг, и там так... всё можно."

# ch/cassidy/chat.rpy:210
translate russian cassidy_love_3_male_22da910f:
    cassidy.say "Возьму тебя с собой, как только снова смогу влезть в самолёт. Ты, я и малыш. Храни бог Барселону."

# ch/cassidy/chat.rpy:212
translate russian cassidy_love_3_male_184068c3:
    cassidy.say "Я тебя отвезу. Без всяких «может быть». Хочу лично посмотреть, как ты не знаешь, что такое тапас."

# ch/cassidy/chat.rpy:213
translate russian cassidy_love_3_male_278e1708:
    mike.say "Для меня честь позорить тебя на международном уровне."

# ch/cassidy/chat.rpy:214
translate russian cassidy_love_3_male_fe0edc5a:
    cassidy.say "Вот ИМЕННО поэтому я и оставляю тебя себе."

# ch/cassidy/chat.rpy:216
translate russian cassidy_love_3_male_a216aeaf:
    cassidy.say "Может, как-нибудь возьму тебя с собой."

# ch/cassidy/chat.rpy:221
translate russian cassidy_love_4_male_e6d65270:
    cassidy.say "Если бы ты жил в виртуальной реальности собственного создания, какой бы она была?"

# ch/cassidy/chat.rpy:222
translate russian cassidy_love_4_male_823c6138:
    mike.say "Думаю, похожей на твою жизнь. Огромный особняк, бассейн, слуги. Никаких забот о деньгах."

# ch/cassidy/chat.rpy:223
translate russian cassidy_love_4_male_f03d706e:
    cassidy.say "Ну да, это довольно здорово."

# ch/cassidy/chat.rpy:224
translate russian cassidy_love_4_male_ae606a82:
    mike.say "И, конечно, кто-то... нет, шестеро, чья единственная работа — делать мне минет по первому желанию."

# ch/cassidy/chat.rpy:226
translate russian cassidy_love_4_male_bd64a2de:
    cassidy.say "Шесть таких, как я, ты бы не выдержал."

# ch/cassidy/chat.rpy:227
translate russian cassidy_love_4_male_ce07fcdd:
    mike.say "С радостью попробовал бы!"

# ch/cassidy/chat.rpy:229
translate russian cassidy_love_4_male_c93bdba1:
    cassidy.say "То есть моя жизнь, но с шестью тобой. Тобой с сиськами. Хм. Интересно, нравился бы ты мне с сиськами?"

# ch/cassidy/chat.rpy:230
translate russian cassidy_love_4_male_4c16b16c:
    mike.say "Давай не будем проверять, ладно?"

# ch/cassidy/chat.rpy:233
translate russian cassidy_love_4_male_7a2cf9f3:
    mike.say "Честно, Кэссиди: целый дворец красоток, наперебой старающихся тебе угодить? Вот настоящая мечта."

# ch/cassidy/chat.rpy:235
translate russian cassidy_love_4_male_97fe8a1e:
    cassidy.say "...Ладно. Если так посмотреть... По красотке под каждой рукой, и все отчаянно хотят меня порадовать?"

# ch/cassidy/chat.rpy:236
translate russian cassidy_love_4_male_0752ec44:
    cassidy.say "Девушка может поклоняться мне не хуже мужчины, [lssb_cassidy.hero_name()]. Иногда даже лучше. Они знают, где что находится."

# ch/cassidy/chat.rpy:240
translate russian cassidy_love_4_male_151be424:
    mike.say "Да нет. Вся эта нежность тебе наскучит. Тебе нужен настоящий мужчина рядом."

# ch/cassidy/chat.rpy:242
translate russian cassidy_love_4_male_3ce49b9c:
    cassidy.say "Ой, избавь. Я играю со своими подружками ради собственного удовольствия, а не чужого. И уж точно не нуждаюсь в мужском надзоре."

# ch/cassidy/chat.rpy:243
translate russian cassidy_love_4_male_aefa1011:
    cassidy.say "Моё внимание получает тот, кто его заслужил. Иногда это ты. Только не зазнавайся."

# ch/cassidy/chat.rpy:247
translate russian cassidy_love_4_male_fcb40004:
    cassidy.say "Шесть таких, как я. Боже, мир бы не выдержал. Он и с одной едва справляется."

# ch/cassidy/chat.rpy:254
translate russian cassidy_love_5_male_9ca8d1e9:
    cassidy.say "Думаю, я оставлю тебя себе."

# ch/cassidy/chat.rpy:255
translate russian cassidy_love_5_male_370386fa:
    mike.say "Как содержанца? Ты за всё платишь, а мне нужно лишь иногда щекотать твою киску?"

# ch/cassidy/chat.rpy:256
translate russian cassidy_love_5_male_6a6e38d4:
    cassidy.say "Звучит неплохо, правда?"

# ch/cassidy/chat.rpy:257
translate russian cassidy_love_5_male_5a96be4a:
    mike.say "Вполне..."

# ch/cassidy/chat.rpy:259
translate russian cassidy_love_5_male_a7125d93:
    cassidy.say "Знаешь, я рада, что мой план провалился. Было бы весело какое-то время тобой помыкать, но мне всегда становится скучно."

# ch/cassidy/chat.rpy:261
translate russian cassidy_love_5_male_94f8183e:
    cassidy.say "А ты мне не надоел. И это всё тоже. Мне... даже немного нравится."

# ch/cassidy/chat.rpy:263
translate russian cassidy_love_5_male_8d11ed1b:
    cassidy.say "Ты мне пока не надоел, хотя хотелось бы почаще быть сверху."

# ch/cassidy/chat.rpy:266
translate russian cassidy_love_5_male_979412b0:
    cassidy.say "Я никогда не представляла себя такой. Толстой, счастливой и привязанной к тебе."

# ch/cassidy/chat.rpy:267
translate russian cassidy_love_5_male_15fec34c:
    mike.say "Счастливой?"

# ch/cassidy/chat.rpy:268
translate russian cassidy_love_5_male_7189dd05:
    cassidy.say "Сотри эту ухмылку. Но... да. Счастливой."

# ch/cassidy/chat.rpy:270
translate russian cassidy_love_5_male_17827b77:
    cassidy.say "Думаю, я оставлю тебя себе, [lssb_cassidy.hero_name()]."

# ch/cassidy/chat.rpy:271
translate russian cassidy_love_5_male_6b50c303:
    mike.say "Говоришь так, будто это тебе решать."

# ch/cassidy/chat.rpy:272
translate russian cassidy_love_5_male_1026f102:
    cassidy.say "Всё решать мне. Но рада, что хотя бы тут ты не сопротивляешься."

# ch/cassidy/chat.rpy:274
translate russian cassidy_love_5_male_fbccd288:
    cassidy.say "Ты мне всё больше нравишься, [lssb_cassidy.hero_name()]. Прилип как грибок, только милый."

# ch/cassidy/chat.rpy:275
translate russian cassidy_love_5_male_bbabc40f:
    mike.say "Сойдёт."

# ch/cassidy/chat.rpy:276
translate russian cassidy_love_5_male_62a8387a:
    cassidy.say "Возьмёшь то, что даю. Но это кое-что значит. Не упусти."

# ch/cassidy/chat.rpy:282
translate russian cassidy_good_sweet_talk_male_27225069:
    mike.say "Ты невероятно выглядишь, Кэссиди. Знаешь об этом?"

# ch/cassidy/chat.rpy:283
translate russian cassidy_good_sweet_talk_male_c13c35aa:
    mike.say "Наш малыш украшает тебя больше любого платья."

# ch/cassidy/chat.rpy:285
translate russian cassidy_good_sweet_talk_male_36213589:
    cassidy.say "Осторожнее, [lssb_cassidy.hero_name()]. Продолжишь в том же духе — и я начну верить."

# ch/cassidy/chat.rpy:286
translate russian cassidy_good_sweet_talk_male_283a0202:
    cassidy.say "...Но повтори ещё раз. Для протокола."

# ch/cassidy/chat.rpy:288
translate russian cassidy_good_sweet_talk_male_fd2021bc:
    mike.say "Иногда мне приходится щипать себя, Кэссиди."

# ch/cassidy/chat.rpy:289
translate russian cassidy_good_sweet_talk_male_908fcb5e:
    mike.say "Чтобы напомнить себе: ты настоящая, и мы вместе!"

# ch/cassidy/chat.rpy:291
translate russian cassidy_good_sweet_talk_male_15673982:
    cassidy.say "О, как мило с твоей стороны!"

# ch/cassidy/chat.rpy:292
translate russian cassidy_good_sweet_talk_male_90758b17:
    cassidy.say "То есть это правда, но всё равно мило, что ты сказал."

# ch/cassidy/chat.rpy:294
translate russian cassidy_good_sweet_talk_male_d690291a:
    mike.say "Быть с тобой — такая честь, Кэссиди."

# ch/cassidy/chat.rpy:295
translate russian cassidy_good_sweet_talk_male_b1b435d7:
    mike.say "Каждый встречный парень мне завидует. И большинство девушек тоже!"

# ch/cassidy/chat.rpy:297
translate russian cassidy_good_sweet_talk_male_cca56d63:
    cassidy.say "Когда выглядишь так хорошо, как я, к этому привыкаешь!"

# ch/cassidy/chat.rpy:298
translate russian cassidy_good_sweet_talk_male_49e5dce1:
    cassidy.say "Но всё равно спасибо, что заметил."

# ch/cassidy/chat.rpy:300
translate russian cassidy_good_sweet_talk_male_8a6a9a67:
    mike.say "Ух ты, Кэссиди!"

# ch/cassidy/chat.rpy:301
translate russian cassidy_good_sweet_talk_male_d811a06f:
    mike.say "Ты точно умеешь притягивать взгляды!"

# ch/cassidy/chat.rpy:303
translate russian cassidy_good_sweet_talk_male_5ffa40cc:
    cassidy.say "Ох, спасибо!"

# ch/cassidy/chat.rpy:304
translate russian cassidy_good_sweet_talk_male_b6993a8a:
    cassidy.say "Это мой природный талант."

# ch/cassidy/chat.rpy:310
translate russian cassidy_bad_sweet_talk_male_46a8bc7b:
    mike.say "Ого... Выглядишь на миллион долларов, Кэссиди!"

# ch/cassidy/chat.rpy:311
translate russian cassidy_bad_sweet_talk_male_6c7ef448:
    mike.say "Отличный способ потратить папины деньги!"

# ch/cassidy/chat.rpy:313
translate russian cassidy_bad_sweet_talk_male_a5d5be42:
    cassidy.say "Вот какой ты меня видишь?"

# ch/cassidy/chat.rpy:314
translate russian cassidy_bad_sweet_talk_male_105e2080:
    cassidy.say "Просто избалованной богатенькой девочкой?!?"

# ch/cassidy/chat.rpy:316
translate russian cassidy_bad_sweet_talk_male_fa1da8e3:
    mike.say "Нет, Кэссиди, я не это имел в виду!"

# ch/cassidy/condom.rpy:4
translate russian cassidy_use_condom_58e611aa:
    "И, конечно, это значит, что нужно позаботиться о защите!"

# ch/cassidy/condom.rpy:5
translate russian cassidy_use_condom_450f6f5e:
    "Поэтому я тянусь за презервативом на прикроватной тумбочке."

# ch/cassidy/condom.rpy:6
translate russian cassidy_use_condom_5e207716:
    cassidy.say "Эй!"

# ch/cassidy/condom.rpy:7
translate russian cassidy_use_condom_12f60960:
    cassidy.say "Чего ты ждёшь?!?"

# ch/cassidy/condom.rpy:8
translate russian cassidy_use_condom_aada3560:
    "Кэссиди оглядывается через плечо, чтобы понять, что меня задерживает."

# ch/cassidy/condom.rpy:9
translate russian cassidy_use_condom_9c9ad6be:
    "Но, увидев презерватив у меня в руке, с готовностью кивает."

# ch/cassidy/condom.rpy:10
translate russian cassidy_use_condom_683d4240:
    "Я торопливо надеваю его, и мы готовы продолжать."

# ch/cassidy/condom.rpy:12
translate russian cassidy_use_condom_5514f7b1:
    "Но я ещё немного сопротивляюсь этому соблазну."

# ch/cassidy/condom.rpy:13
translate russian cassidy_use_condom_bc93ddf4:
    "Кэссиди оглядывается через плечо, чтобы понять, в чём дело."

# ch/cassidy/condom.rpy:14
translate russian cassidy_use_condom_acaed28a:
    cassidy.say "Что ты..."

# ch/cassidy/condom.rpy:15
translate russian cassidy_use_condom_bdfe2188:
    "Я поднимаю руку с презервативом."

# ch/cassidy/condom.rpy:16
translate russian cassidy_use_condom_3732d105:
    "И этого ответа Кэссиди вполне достаточно."

# ch/cassidy/condom.rpy:17
translate russian cassidy_use_condom_ea9cb3dd:
    cassidy.say "А, понятно..."

# ch/cassidy/condom.rpy:18
translate russian cassidy_use_condom_24bd9a7f:
    cassidy.say "Ну так надевай уже!"

# ch/cassidy/condom.rpy:19
translate russian cassidy_use_condom_92f4da75:
    "Я делаю, как велено."

# ch/cassidy/condom.rpy:20
translate russian cassidy_use_condom_27fa45bd:
    "И вот мы готовы продолжать."

# ch/cassidy/condom.rpy:22
translate russian cassidy_use_condom_18a3836b:
    mike.say "Я тоже, Кэссиди."

# ch/cassidy/condom.rpy:23
translate russian cassidy_use_condom_fcbf8c68:
    mike.say "Но сначала нужно предохраниться."

# ch/cassidy/condom.rpy:24
translate russian cassidy_use_condom_59dfe4c7:
    cassidy.say "А?"

# ch/cassidy/condom.rpy:25
translate russian cassidy_use_condom_251a53fd:
    mike.say "Нужно надеть презерватив!"

# ch/cassidy/condom.rpy:26
translate russian cassidy_use_condom_378c64f5:
    cassidy.say "А, хорошо!"

# ch/cassidy/condom.rpy:27
translate russian cassidy_use_condom_7970478c:
    "Кэссиди терпеливо ждёт, пока я беру презерватив."

# ch/cassidy/condom.rpy:28
translate russian cassidy_use_condom_a1de1abe:
    "Затем я надеваю его, и мы готовы продолжать."

# ch/cassidy/condom.rpy:30
translate russian cassidy_use_condom_dd151b4b:
    "Но тут я вдруг кое-что вспоминаю."

# ch/cassidy/condom.rpy:31
translate russian cassidy_use_condom_d1416637:
    "И поднимаю руку, останавливая Кэссиди."

# ch/cassidy/condom.rpy:32
translate russian cassidy_use_condom_e8f92553:
    "Она сурово смотрит на меня, недовольная тем, что я перехватываю инициативу."

# ch/cassidy/condom.rpy:33
translate russian cassidy_use_condom_5e207716_1:
    cassidy.say "Эй!"

# ch/cassidy/condom.rpy:34
translate russian cassidy_use_condom_4b770abf:
    cassidy.say "Что ты делаешь?!?"

# ch/cassidy/condom.rpy:35
translate russian cassidy_use_condom_0e7eca6b:
    mike.say "Нам стоит предохраниться, Кэссиди."

# ch/cassidy/condom.rpy:36
translate russian cassidy_use_condom_45df66dc:
    mike.say "Мы же не хотим никаких неожиданностей, верно?"

# ch/cassidy/condom.rpy:37
translate russian cassidy_use_condom_241a9594:
    "Я вижу, как до Кэссиди доходит смысл."

# ch/cassidy/condom.rpy:38
translate russian cassidy_use_condom_8c77be2a:
    "И понимаю, что мои слова немного её пристыдили."

# ch/cassidy/condom.rpy:39
translate russian cassidy_use_condom_a08273bd:
    "Потому что она лишь быстро кивает, позволяя мне взять презерватив."

# ch/cassidy/condom.rpy:40
translate russian cassidy_use_condom_7714b3fb:
    "Затем терпеливо ждёт, пока я его надеваю."

# ch/cassidy/condom.rpy:41
translate russian cassidy_use_condom_3558fd6d:
    "Как только это сделано, мы готовы продолжать."

# ch/cassidy/condom.rpy:47
translate russian cassidy_warn_condom_e0e82954:
    "Кэссиди смотрит на меня через плечо."

# ch/cassidy/condom.rpy:48
translate russian cassidy_warn_condom_388b2014:
    cassidy.say "Мы ничего не забыли?"

# ch/cassidy/condom.rpy:49
translate russian cassidy_warn_condom_cd77bc4e:
    cassidy.say "Ты ведь собирался предохраниться?"

# ch/cassidy/condom.rpy:51
translate russian cassidy_warn_condom_e0e82954_1:
    "Кэссиди смотрит на меня через плечо."

# ch/cassidy/condom.rpy:52
translate russian cassidy_warn_condom_ccc8dbb4:
    "И я вижу, что она ждёт от меня какого-то действия."

# ch/cassidy/condom.rpy:53
translate russian cassidy_warn_condom_3d76bed9:
    cassidy.say "Эм, алло?"

# ch/cassidy/condom.rpy:54
translate russian cassidy_warn_condom_00513113:
    cassidy.say "А как насчёт защиты?"

# ch/cassidy/condom.rpy:56
translate russian cassidy_warn_condom_066bf4fb:
    cassidy.say "Ой, погоди..."

# ch/cassidy/condom.rpy:57
translate russian cassidy_warn_condom_e1319344:
    cassidy.say "Нам не стоит воспользоваться презервативом?"

# ch/cassidy/condom.rpy:59
translate russian cassidy_warn_condom_32eef55c:
    "Вдруг Кэссиди поднимает руку."

# ch/cassidy/condom.rpy:60
translate russian cassidy_warn_condom_48d7b0e8:
    "И перестаёт тереть мой член о свою киску."

# ch/cassidy/condom.rpy:61
translate russian cassidy_warn_condom_f0b73cbe:
    mike.say "Эй, Кэссиди!"

# ch/cassidy/condom.rpy:62
translate russian cassidy_warn_condom_b046a326:
    mike.say "Что такое?!"

# ch/cassidy/condom.rpy:63
translate russian cassidy_warn_condom_28cc2f2e:
    cassidy.say "Я тут вспомнила, [lssb_cassidy.hero_name()]."

# ch/cassidy/condom.rpy:64
translate russian cassidy_warn_condom_23327214:
    cassidy.say "Нам стоит предохраняться!"

# ch/cassidy/condom.rpy:70
translate russian cassidy_force_condom_a701ebb7:
    mike.say "Раз уж ты об этом заговорила, Кэссиди..."

# ch/cassidy/condom.rpy:71
translate russian cassidy_force_condom_9a5cf1d8:
    mike.say "Думаю, стоит!"

# ch/cassidy/condom.rpy:72
translate russian cassidy_force_condom_6b124a3d:
    "Кэссиди закатывает глаза."

# ch/cassidy/condom.rpy:73
translate russian cassidy_force_condom_75f4d285:
    "Затем свешивается с кровати и тянется к своей одежде на полу."

# ch/cassidy/condom.rpy:74
translate russian cassidy_force_condom_115fa4f2:
    cassidy.say "Хорошо, что хоть кто-то из нас подумал об этом заранее!"

# ch/cassidy/condom.rpy:75
translate russian cassidy_force_condom_f002e9fa:
    "Она протягивает мне презерватив, и я торопливо надеваю его."

# ch/cassidy/condom.rpy:76
translate russian cassidy_force_condom_27fa45bd:
    "Теперь мы готовы продолжать."

# ch/cassidy/condom.rpy:78
translate russian cassidy_force_condom_195540d1:
    "Не успеваю я выставить себя неподготовленным дурачком, как Кэссиди приходит на помощь."

# ch/cassidy/condom.rpy:79
translate russian cassidy_force_condom_d5957211:
    "Она свешивается с кровати и тянется к кучке своей одежды на полу."

# ch/cassidy/condom.rpy:80
translate russian cassidy_force_condom_8c1e69f0:
    "Затем выпрямляется с презервативом в руке и передаёт его мне."

# ch/cassidy/condom.rpy:81
translate russian cassidy_force_condom_683d4240:
    "Я торопливо надеваю его, и мы готовы продолжать."

# ch/cassidy/condom.rpy:83
translate russian cassidy_force_condom_20e31f98:
    cassidy.say "Не волнуйся, [lssb_cassidy.hero_name()]."

# ch/cassidy/condom.rpy:84
translate russian cassidy_force_condom_aaf7f767:
    cassidy.say "У меня как раз есть!"

# ch/cassidy/condom.rpy:85
translate russian cassidy_force_condom_16e51e86:
    "Кэссиди слезает с меня и идёт за презервативом."

# ch/cassidy/condom.rpy:86
translate russian cassidy_force_condom_cb8a4b59:
    "Когда она возвращается, я откидываюсь на спину и позволяю ей надеть его."

# ch/cassidy/condom.rpy:87
translate russian cassidy_force_condom_5bf137de:
    "Теперь можно продолжать."

# ch/cassidy/condom.rpy:89
translate russian cassidy_force_condom_6dbe3cf1:
    "Не успеваю я сказать ещё хоть слово, как Кэссиди достаёт презерватив."

# ch/cassidy/condom.rpy:90
translate russian cassidy_force_condom_581058c6:
    "Понятия не имею, откуда он взялся, и спрашивать не собираюсь."

# ch/cassidy/condom.rpy:91
translate russian cassidy_force_condom_430a3488:
    "Просто беру его у неё и надеваю."

# ch/cassidy/condom.rpy:92
translate russian cassidy_force_condom_37c479ee:
    "Кэссиди терпеливо ждёт, пока я его надену."

# ch/cassidy/condom.rpy:93
translate russian cassidy_force_condom_3558fd6d:
    "После этого можно продолжать."

# ch/cassidy/condom.rpy:99
translate russian cassidy_mad_condom_30e74fc5:
    mike.say "Эм..."

# ch/cassidy/condom.rpy:100
translate russian cassidy_mad_condom_b25becab:
    mike.say "Забавно, Кэссиди..."

# ch/cassidy/condom.rpy:101
translate russian cassidy_mad_condom_a7d17093:
    mike.say "А я как-то не собирался!"

# ch/cassidy/condom.rpy:102
translate russian cassidy_mad_condom_efcaa9a6:
    "Кэссиди с ужасом смотрит на меня."

# ch/cassidy/condom.rpy:103
translate russian cassidy_mad_condom_e7ac4646:
    "Затем вскакивает с кровати."

# ch/cassidy/condom.rpy:104
translate russian cassidy_mad_condom_8612407f:
    cassidy.say "Если ты такого обо мне мнения, [lssb_cassidy.hero_name()]..."

# ch/cassidy/condom.rpy:106
translate russian cassidy_mad_condom_786b6712:
    cassidy.say "То о сексе сегодня вечером можешь забыть!"

# ch/cassidy/condom.rpy:108
translate russian cassidy_mad_condom_d92d572a:
    cassidy.say "То о сексе сегодня можешь забыть!"

# ch/cassidy/condom.rpy:109
translate russian cassidy_mad_condom_b0ef750a:
    "С этими словами она одевается и в ярости выходит из комнаты."

# ch/cassidy/condom.rpy:111
translate russian cassidy_mad_condom_b2cb3c71:
    mike.say "Да ладно тебе, Кэссиди!"

# ch/cassidy/condom.rpy:112
translate russian cassidy_mad_condom_7461831f:
    mike.say "Я думал, тебе самой не терпится начать!"

# ch/cassidy/condom.rpy:113
translate russian cassidy_mad_condom_6db92b98:
    mike.say "Я могу просто вытащить перед тем, как кончу!"

# ch/cassidy/condom.rpy:114
translate russian cassidy_mad_condom_e443b1da:
    "Кэссиди закатывает глаза и качает головой."

# ch/cassidy/condom.rpy:115
translate russian cassidy_mad_condom_333f91df:
    "И молча слезает с меня."

# ch/cassidy/condom.rpy:116
translate russian cassidy_mad_condom_96c14df2:
    "Я переворачиваюсь и смотрю, как она начинает одеваться."

# ch/cassidy/condom.rpy:117
translate russian cassidy_mad_condom_7600688a:
    mike.say "Т... ты уходишь?"

# ch/cassidy/condom.rpy:118
translate russian cassidy_mad_condom_6107a506:
    cassidy.say "Какая наблюдательность, [lssb_cassidy.hero_name()]."

# ch/cassidy/condom.rpy:119
translate russian cassidy_mad_condom_87f80e43:
    cassidy.say "Что меня выдало?"

# ch/cassidy/condom.rpy:120
translate russian cassidy_mad_condom_c8880648:
    "Мне остаётся только лежать и смотреть, как она заканчивает одеваться и сердито уходит."

# ch/cassidy/condom.rpy:121
translate russian cassidy_mad_condom_60dc1954:
    "Мой член всё это время разочарованно поникает."

# ch/cassidy/condom.rpy:123
translate russian cassidy_mad_condom_5ae8110c:
    mike.say "Ты серьёзно, Кэссиди?"

# ch/cassidy/condom.rpy:124
translate russian cassidy_mad_condom_e7868696:
    mike.say "Я думал, мы тут решили пошалить?"

# ch/cassidy/condom.rpy:125
translate russian cassidy_mad_condom_9aa08299:
    mike.say "Ну, поддаться порыву!"

# ch/cassidy/condom.rpy:126
translate russian cassidy_mad_condom_165a4847:
    cassidy.say "Уф..."

# ch/cassidy/condom.rpy:127
translate russian cassidy_mad_condom_3de7e56d:
    cassidy.say "Это не шалость, [lssb_cassidy.hero_name()]."

# ch/cassidy/condom.rpy:128
translate russian cassidy_mad_condom_6f81b1c9:
    cassidy.say "Это просто тупость!"

# ch/cassidy/condom.rpy:129
translate russian cassidy_mad_condom_5e6cecd9:
    "Кэссиди вздыхает, слезает с меня и начинает одеваться."

# ch/cassidy/condom.rpy:130
translate russian cassidy_mad_condom_fb153ce4:
    cassidy.say "И спасибо, что испортил настроение, придурок!"

# ch/cassidy/condom.rpy:131
translate russian cassidy_mad_condom_b8af145e:
    "Я продолжаю возражать и упрашивать её."

# ch/cassidy/condom.rpy:132
translate russian cassidy_mad_condom_01a5b3d3:
    "Но это бесполезно."

# ch/cassidy/condom.rpy:133
translate russian cassidy_mad_condom_9e010c39:
    "Одевшись, Кэссиди в ярости уходит."

# ch/cassidy/condom.rpy:134
translate russian cassidy_mad_condom_c925adc4:
    "А я снова остаюсь в кабинете один."

# ch/cassidy/condom.rpy:136
translate russian cassidy_mad_condom_920e7962:
    mike.say "А?!"

# ch/cassidy/condom.rpy:137
translate russian cassidy_mad_condom_0cd88e12:
    mike.say "Может, хоть раз обойдёмся без него, Кэссиди?"

# ch/cassidy/condom.rpy:138
translate russian cassidy_mad_condom_bb385340:
    mike.say "Если сейчас остановиться, всё настроение пропадёт!"

# ch/cassidy/condom.rpy:139
translate russian cassidy_mad_condom_3fadb084:
    "Кэссиди смотрит на меня с нескрываемым отвращением."

# ch/cassidy/condom.rpy:140
translate russian cassidy_mad_condom_a89afdb6:
    "Затем слезает с меня и встаёт с кровати."

# ch/cassidy/condom.rpy:141
translate russian cassidy_mad_condom_3225ddcf:
    cassidy.say "Нет, по-моему, ты уже сам его испортил, [lssb_cassidy.hero_name()]!"

# ch/cassidy/condom.rpy:142
translate russian cassidy_mad_condom_ce7ac0f7:
    cassidy.say "И, пожалуй, я пойду домой."

# ch/cassidy/condom.rpy:143
translate russian cassidy_mad_condom_42120115:
    "Никакие мои слова не могут переубедить Кэссиди."

# ch/cassidy/condom.rpy:144
translate russian cassidy_mad_condom_5be27fb8:
    "Вскоре она уже одета."

# ch/cassidy/condom.rpy:145
translate russian cassidy_mad_condom_17bec698:
    "Затем она сердито выходит за дверь, оставив меня одного."

# ch/cassidy/condom.rpy:149
translate russian cassidy_sub_warn_condom_727290ca:
    "Глаза Кэссиди округляются, когда она понимает, что я делаю."

# ch/cassidy/condom.rpy:150
translate russian cassidy_sub_warn_condom_0181dff0:
    cassidy.say "Нет! Мне нельзя забеременеть! Пожалуйста, не делай этого! Умоляю!"

# ch/cassidy/condom.rpy:158
translate russian cassidy_sub_use_condom_ba1390eb:
    mike.say "Нет, сучка. Примешь мой член без резинки, и тебе это понравится!"

# ch/cassidy/condom.rpy:163
translate russian cassidy_sub_use_condom_ab169713:
    mike.say "У меня нет с собой презервативов. В этот раз так и быть, но только в этот. Не хочешь от меня ребёнка — начинай пить таблетки."

# ch/cassidy/condom.rpy:164
translate russian cassidy_sub_use_condom_095247f1:
    cassidy.say "Да, [lssb_cassidy.hero_name()], спасибо, [lssb_cassidy.hero_name()]. Завтра же схожу за таблетками!"

# ch/cassidy/date.rpy:3
translate russian cassidy_date_intro_valentine_male_8177e508:
    cassidy.say "Привет, [lssb_cassidy.hero_name()]..."

# ch/cassidy/date.rpy:4
translate russian cassidy_date_intro_valentine_male_81ac95d6:
    cassidy.say "Готов стать моим Валентином?"

# ch/cassidy/date.rpy:7
translate russian cassidy_date_intro_valentine_male_ca7cf6d6:
    "Говоря это, она кладёт ладонь на округлившийся живот, и у меня щемит в груди."

# ch/cassidy/date.rpy:9
translate russian cassidy_date_intro_valentine_male_b8175870:
    cassidy.say "Надеюсь, да. Ты сделал мне ребёнка, так что теперь будешь моим Валентином навсегда."

# ch/cassidy/date.rpy:12
translate russian cassidy_date_intro_valentine_male_a10b51fa:
    cassidy.say "Впрочем, я и не спрашивала. Сегодня ты мой, как и всегда."

# ch/cassidy/date.rpy:15
translate russian cassidy_date_intro_valentine_male_bc323b65:
    cassidy.say "Только если ты согласен, [lssb_cassidy.hero_name()]. Я бы этого хотела. Очень хотела."

# ch/cassidy/date.rpy:18
translate russian cassidy_date_intro_valentine_male_62acc08d:
    cassidy.say "Конечно, готов. Кто в здравом уме откажется?"

# ch/cassidy/date.rpy:21
translate russian cassidy_date_intro_valentine_male_deab2a36:
    cassidy.say "И, честно говоря, [lssb_cassidy.hero_name()], кроме тебя мне никто не нужен."

# ch/cassidy/date.rpy:23
translate russian cassidy_date_intro_valentine_male_068241e7:
    "Я нервно сглатываю и киваю."

# ch/cassidy/date.rpy:24
translate russian cassidy_date_intro_valentine_male_885fbde3:
    "Меня можно понять: Кэссиди выглядит сногсшибательно!"

# ch/cassidy/date.rpy:25
translate russian cassidy_date_intro_valentine_male_38f24f14:
    mike.say "О да, Кэссиди!"

# ch/cassidy/date.rpy:26
translate russian cassidy_date_intro_valentine_male_48d3b7df:
    mike.say "Я готов!"

# ch/cassidy/date.rpy:27
translate russian cassidy_date_intro_valentine_male_c28c9519:
    "Кэссиди улыбается и одобрительно кивает."

# ch/cassidy/date.rpy:28
translate russian cassidy_date_intro_valentine_male_ab55309e:
    "И мы отправляемся на свидание."

# ch/cassidy/date.rpy:32
translate russian cassidy_date_intro_halloween_male_e5a98444:
    mike.say "Привет, Кэссиди! Сегодня ты выглядишь особенно пугающе!"

# ch/cassidy/date.rpy:33
translate russian cassidy_date_intro_halloween_male_eccdc04d:
    mike.say "Мне нравится!"

# ch/cassidy/date.rpy:35
translate russian cassidy_date_intro_halloween_male_ee86b95b:
    "Кэссиди хмурится и слегка морщит нос."

# ch/cassidy/date.rpy:37
translate russian cassidy_date_intro_halloween_male_9c01e62b:
    cassidy.say "Ч... что ты хочешь сказать, [lssb_cassidy.hero_name()]?"

# ch/cassidy/date.rpy:38
translate russian cassidy_date_intro_halloween_male_56e72e64:
    cassidy.say "Я не пугающая! Это готы пугающие!"

# ch/cassidy/date.rpy:40
translate russian cassidy_date_intro_halloween_male_3ecf8195:
    mike.say "Эм... сегодня Хэллоуин, Кэссиди. Я просто сделал тебе комплимент!"

# ch/cassidy/date.rpy:42
translate russian cassidy_date_intro_halloween_male_4a9f52bc:
    "Лицо Кэссиди светлеет: она наконец понимает, что я имел в виду."

# ch/cassidy/date.rpy:44
translate russian cassidy_date_intro_halloween_male_df82feff:
    cassidy.say "А... тогда ладно!"

# ch/cassidy/date.rpy:45
translate russian cassidy_date_intro_halloween_male_5f0cb520:
    cassidy.say "Если на Хэллоуин «пугающая» значит то же самое, что «милая» в остальное время."

# ch/cassidy/date.rpy:47
translate russian cassidy_date_intro_halloween_male_a809aeb7:
    cassidy.say "Хотя попробуй-ка найти костюм, в который поместится этот живот, которым ты меня наградил."

# ch/cassidy/date.rpy:49
translate russian cassidy_date_intro_halloween_male_324a73b2:
    cassidy.say "Ты ведь всегда считаешь меня милой, правда, [lssb_cassidy.hero_name()]? Даже когда я вредничаю."

# ch/cassidy/date.rpy:51
translate russian cassidy_date_intro_halloween_male_af344b98:
    cassidy.say "Милая, прекрасная, устрашающая... Выбирай то слово, за которое получишь меньше пощёчин, [lssb_cassidy.hero_name()]."

# ch/cassidy/date.rpy:53
translate russian cassidy_date_intro_halloween_male_37d8e629:
    cassidy.say "Если ты так считаешь, [lssb_cassidy.hero_name()], чужое мнение меня не волнует."

# ch/cassidy/date.rpy:57
translate russian cassidy_date_intro_christmas_male_96006367:
    mike.say "С Рождеством, Кэссиди!"

# ch/cassidy/date.rpy:58
translate russian cassidy_date_intro_christmas_male_584b5cd4:
    mike.say "Готова к свиданию?"

# ch/cassidy/date.rpy:59
translate russian cassidy_date_intro_christmas_male_d99e6081:
    "Кэссиди кивает, вся сияя от радости."

# ch/cassidy/date.rpy:61
translate russian cassidy_date_intro_christmas_male_1564d038:
    cassidy.say "Ещё как, [lssb_cassidy.hero_name()]."

# ch/cassidy/date.rpy:63
translate russian cassidy_date_intro_christmas_male_3350c08e:
    cassidy.say "Обожаю это время года! Оно такое волшебное!"

# ch/cassidy/date.rpy:64
translate russian cassidy_date_intro_christmas_male_ced1aba2:
    cassidy.say "Мамочка с папочкой всегда делали этот праздник особенным."

# ch/cassidy/date.rpy:65
translate russian cassidy_date_intro_christmas_male_0ca592af:
    cassidy.say "А теперь и ты делаешь его ещё прекраснее!"

# ch/cassidy/date.rpy:68
translate russian cassidy_date_intro_christmas_male_31c3ef96:
    "Она кладёт ладонь на живот, и в её голосе звучит непривычная нежность."

# ch/cassidy/date.rpy:70
translate russian cassidy_date_intro_christmas_male_883d9d61:
    cassidy.say "На следующее Рождество нас будет трое, [lssb_cassidy.hero_name()]. Представляешь?"

# ch/cassidy/date.rpy:72
translate russian cassidy_date_intro_christmas_male_020cd436:
    cassidy.say "Так что радуйся, что я вообще разрешаю тебе провести его со мной."

# ch/cassidy/date.rpy:74
translate russian cassidy_date_intro_christmas_male_d920b4f3:
    cassidy.say "Лучшим подарком было бы провести его на коленях у твоего кресла, [lssb_cassidy.hero_name()]."

# ch/cassidy/date.rpy:76
translate russian cassidy_date_intro_christmas_male_34c527ec:
    cassidy.say "Я и не думала, что захочу разделить этот день с кем-то. А потом появился ты."

# ch/cassidy/date.rpy:80
translate russian cassidy_date_intro_birthday_male_5d5f2ba6:
    mike.say "С днём рождения, Кэссиди!"

# ch/cassidy/date.rpy:81
translate russian cassidy_date_intro_birthday_male_ed03b183:
    mike.say "Надеюсь, ты готова повеселиться."

# ch/cassidy/date.rpy:82
translate russian cassidy_date_intro_birthday_male_604c5176:
    mike.say "Потому что я устрою нам потрясающее свидание!"

# ch/cassidy/date.rpy:84
translate russian cassidy_date_intro_birthday_male_69beca7d:
    cassidy.say "Спасибо, [lssb_cassidy.hero_name()]. Уверена, всё будет отлично."

# ch/cassidy/date.rpy:86
translate russian cassidy_date_intro_birthday_male_f2797cb2:
    cassidy.say "Может, не так роскошно, как на вечеринках, которые устраивает мне мачеха."

# ch/cassidy/date.rpy:88
translate russian cassidy_date_intro_birthday_male_c3773056:
    cassidy.say "Может, не так роскошно, как на вечеринках, которые устраивает мне папочка."

# ch/cassidy/date.rpy:89
translate russian cassidy_date_intro_birthday_male_d6649232:
    cassidy.say "Но с тобой оно всё равно будет чудесным..."

# ch/cassidy/date.rpy:91
translate russian cassidy_date_intro_birthday_male_cff586e0:
    cassidy.say "Честно говоря, лучший подарок я сделала себе сама, когда позволила тебе сделать мне ребёнка."

# ch/cassidy/date.rpy:93
translate russian cassidy_date_intro_birthday_male_8cdd9ab4:
    cassidy.say "И, конечно, ты будешь баловать меня весь день. Считай это своей единственной задачей, [lssb_cassidy.hero_name()]."

# ch/cassidy/date.rpy:95
translate russian cassidy_date_intro_birthday_male_d452ff61:
    cassidy.say "В этом году я хочу только одного: быть для тебя хорошей девочкой, [lssb_cassidy.hero_name()]."

# ch/cassidy/date.rpy:97
translate russian cassidy_date_intro_birthday_male_c2d3abe4:
    cassidy.say "Знаешь, подарки не важны. Я просто хочу провести этот день с тобой."

# ch/cassidy/date.rpy:101
translate russian cassidy_date_intro_mc_birthday_male_abbf69ea:
    mike.say "Привет, Кэссиди..."

# ch/cassidy/date.rpy:102
translate russian cassidy_date_intro_mc_birthday_male_1f3dd852:
    mike.say "Ты готова к нашему свиданию?"

# ch/cassidy/date.rpy:104
translate russian cassidy_date_intro_mc_birthday_male_ee38ab74:
    cassidy.say "Подожди-ка, [lssb_cassidy.hero_name()]..."

# ch/cassidy/date.rpy:105
translate russian cassidy_date_intro_mc_birthday_male_1b8c559d:
    cassidy.say "Разве у тебя сегодня не день рождения?"

# ch/cassidy/date.rpy:107
translate russian cassidy_date_intro_mc_birthday_male_1c0f2642:
    mike.say "Эм... да, сегодня."

# ch/cassidy/date.rpy:109
translate russian cassidy_date_intro_mc_birthday_male_f7d13153:
    cassidy.say "Так почему ты мне не сказал?"

# ch/cassidy/date.rpy:111
translate russian cassidy_date_intro_mc_birthday_male_25f16312:
    mike.say "Не знаю, Кэссиди. Для меня это, наверное, не так уж важно."

# ch/cassidy/date.rpy:113
translate russian cassidy_date_intro_mc_birthday_male_4e4c4979:
    cassidy.say "ЧТО?!"

# ch/cassidy/date.rpy:115
translate russian cassidy_date_intro_mc_birthday_male_bde95f2c:
    cassidy.say "Дни рождения ещё как важны!"

# ch/cassidy/date.rpy:116
translate russian cassidy_date_intro_mc_birthday_male_04299456:
    cassidy.say "Я бы ТАК разозлилась, если бы кто-нибудь забыл про мой!"

# ch/cassidy/date.rpy:118
translate russian cassidy_date_intro_mc_birthday_male_7e04313b:
    cassidy.say "Но раз сегодня твой, пожалуй, разрешу целый день баловать тебя, а не меня."

# ch/cassidy/date.rpy:120
translate russian cassidy_date_intro_mc_birthday_male_a3693a55:
    cassidy.say "Позволь мне загладить вину, [lssb_cassidy.hero_name()]. Сегодня всё будет только для тебя."

# ch/cassidy/date.rpy:122
translate russian cassidy_date_intro_mc_birthday_male_28062ac9:
    cassidy.say "Ну, теперь-то я не забуду. Сегодня весь день твой, хочешь ты того или нет, [lssb_cassidy.hero_name()]."

# ch/cassidy/date.rpy:127
translate russian cassidy_date_eat_a_burger_16febe5a:
    "Но стоит поставить перед ней бургер, как что-то меняется."

# ch/cassidy/date.rpy:128
translate russian cassidy_date_eat_a_burger_aedc2724:
    "Похоже, вызванный беременностью аппетит оказывается сильнее даже её снобизма."

# ch/cassidy/date.rpy:129
translate russian cassidy_date_eat_a_burger_c7908691:
    cassidy.say "Только попробуй кому-нибудь об этом рассказать, [lssb_cassidy.hero_name()]."

# ch/cassidy/date.rpy:130
translate russian cassidy_date_eat_a_burger_5689bf4e:
    "Затем она пожирает бургер целиком с таким рвением, что мне становится не по себе."

# ch/cassidy/date.rpy:132
translate russian cassidy_date_eat_a_burger_bcfd0620:
    "Едва перед Кэссиди появляется бургер, она воротит нос."

# ch/cassidy/date.rpy:133
translate russian cassidy_date_eat_a_burger_40e237d7:
    "Сама мысль о том, чтобы прикоснуться к нему, вызывает у неё отвращение, не говоря уже о том, чтобы взять его в рот."

# ch/cassidy/date.rpy:134
translate russian cassidy_date_eat_a_burger_57780532:
    "В итоге я даже не уверен, откусила ли она хоть кусочек."

# ch/cassidy/date.rpy:136
translate russian cassidy_date_eat_a_burger_03f1103c:
    cassidy.say "Еда для простолюдинов. Захоти я питаться как прислуга, [lssb_cassidy.hero_name()], осталась бы дома."

# ch/cassidy/date.rpy:138
translate russian cassidy_date_eat_a_burger_7d674a28:
    cassidy.say "Я съем, если ты велишь, [lssb_cassidy.hero_name()]. Только... пожалуйста, не заставляй меня."

# ch/cassidy/date.rpy:145
translate russian cassidy_date_buy_drink_f995236d:
    cassidy.say "[lssb_cassidy.hero_name()], ты... ты чудовище!"

# ch/cassidy/date.rpy:146
translate russian cassidy_date_buy_drink_c15c91e7:
    cassidy.say "Сначала сделал мне ребёнка."

# ch/cassidy/date.rpy:147
translate russian cassidy_date_buy_drink_a8b67c65:
    cassidy.say "А теперь подвергаешь его опасности, предлагая мне алкоголь!"

# ch/cassidy/date.rpy:151
translate russian cassidy_date_buy_drink_ad505093:
    "Когда приносят напиток, Кэссиди берёт его, почти не замечая, откуда он взялся."

# ch/cassidy/date.rpy:152
translate russian cassidy_date_buy_drink_b1023de7:
    "Она держит бокал в руке и изредка отпивает, словно это ещё один аксессуар."

# ch/cassidy/date.rpy:153
translate russian cassidy_date_buy_drink_5a349134:
    "Интересно, она вообще знает, что пьёт?"

# ch/cassidy/date.rpy:155
translate russian cassidy_date_buy_drink_c809e183:
    cassidy.say "Разумеется, ты будешь заказывать их весь вечер. Считай это привилегией, [lssb_cassidy.hero_name()]."

# ch/cassidy/date.rpy:157
translate russian cassidy_date_buy_drink_94eb326f:
    cassidy.say "Спасибо, [lssb_cassidy.hero_name()]. Ты всегда так хорошо обо мне заботишься."

# ch/cassidy/date.rpy:161
translate russian cassidy_date_play_darts_48c5f4c6:
    "Кэссиди стонет и жалуется, услышав предложение поиграть в дартс."

# ch/cassidy/date.rpy:162
translate russian cassidy_date_play_darts_77ab3583:
    "Да так, что я всерьёз жду, когда она в сердцах швырнёт дротики через плечо."

# ch/cassidy/date.rpy:163
translate russian cassidy_date_play_darts_e94a7c5b:
    "До этого не доходит, но в мишень она не попадает ни разу."

# ch/cassidy/date.rpy:165
translate russian cassidy_date_play_darts_92f3a2f0:
    cassidy.say "Это ниже моего достоинства, [lssb_cassidy.hero_name()]. Принеси мне выпить, и забудем об этом."

# ch/cassidy/date.rpy:167
translate russian cassidy_date_play_darts_d721a24d:
    cassidy.say "Прости, что я такая неумеха, [lssb_cassidy.hero_name()]. Покажи, как надо, и я постараюсь."

# ch/cassidy/date.rpy:169
translate russian cassidy_date_play_darts_15472d6d:
    cassidy.say "Ладно-ладно, играю я ужасно. Но смеяться надо мной нельзя, [lssb_cassidy.hero_name()]."

# ch/cassidy/date.rpy:173
translate russian cassidy_date_pub_play_pool_811f655d:
    "Кэссиди дуется у бильярдного стола, явно недовольная тем, что я предложил ей сыграть со мной."

# ch/cassidy/date.rpy:174
translate russian cassidy_date_pub_play_pool_9da77764:
    "Она столько раз нарушает правила и едва не рвёт сукно, что я прекращаю игру."

# ch/cassidy/date.rpy:175
translate russian cassidy_date_pub_play_pool_d4022c73:
    "Играть с ней в таком настроении и без того неприятно, а ещё платить за нанесённый ущерб мне совсем не хочется."

# ch/cassidy/date.rpy:177
translate russian cassidy_date_pub_play_pool_74287e73:
    cassidy.say "Игры для тех, кому больше нечем заняться, [lssb_cassidy.hero_name()]. Для тебя, видимо."

# ch/cassidy/date.rpy:179
translate russian cassidy_date_pub_play_pool_0bba8986:
    cassidy.say "Я бы лучше сделала что-нибудь для тебя, чем гоняла дурацкие шары, [lssb_cassidy.hero_name()]."

# ch/cassidy/date.rpy:186
translate russian cassidy_date_buy_a_round_f995236d:
    cassidy.say "[lssb_cassidy.hero_name()], ты... ты чудовище!"

# ch/cassidy/date.rpy:187
translate russian cassidy_date_buy_a_round_c15c91e7:
    cassidy.say "Сначала сделал мне ребёнка."

# ch/cassidy/date.rpy:188
translate russian cassidy_date_buy_a_round_a8b67c65:
    cassidy.say "А теперь подвергаешь его опасности, предлагая мне алкоголь!"

# ch/cassidy/date.rpy:192
translate russian cassidy_date_buy_a_round_c9047084:
    "В ответ на моё предложение угостить всех выпивкой Кэссиди лишь равнодушно кивает."

# ch/cassidy/date.rpy:193
translate russian cassidy_date_buy_a_round_c643d925:
    "Она настолько привыкла, что ей всё должны, что считает это само собой разумеющимся."

# ch/cassidy/date.rpy:194
translate russian cassidy_date_buy_a_round_9a9f0e02:
    "Сильно сомневаюсь, что в следующий раз она угостит меня в ответ."

# ch/cassidy/date.rpy:200
translate russian cassidy_date_buy_a_round_51d21acf:
    cassidy.say "Хороший мальчик. Порадуй всех здесь ради меня, [lssb_cassidy.hero_name()]."

# ch/cassidy/date.rpy:202
translate russian cassidy_date_buy_a_round_139c4779:
    cassidy.say "Ты такой щедрый, [lssb_cassidy.hero_name()]. Пусть все хоть немного почувствуют, как мне повезло."

# ch/cassidy/date.rpy:205
translate russian cassidy_date_buy_a_round_fb20fd2c:
    "Я хочу угостить пивом весь паб."

# ch/cassidy/date.rpy:206
translate russian cassidy_date_buy_a_round_98e3ac1d:
    "Но Кэссиди, похоже, не хочет пить, так что я отказываюсь от этой затеи."

# ch/cassidy/date.rpy:211
translate russian cassidy_dance_with_e7c4a756:
    "Движения Кэссиди довольно скромны и целомудренны, но её глаза говорят об обратном."

# ch/cassidy/date.rpy:212
translate russian cassidy_dance_with_4af49d16:
    "На танцполе они горят едва сдерживаемым желанием."

# ch/cassidy/date.rpy:213
translate russian cassidy_dance_with_75f16abe:
    "Будто она знает что-то, чего не знаю я, и решает, стоит ли меня просветить..."

# ch/cassidy/date.rpy:215
translate russian cassidy_dance_with_0e91c6cd:
    "Покачиваясь в танце, я кладу ладонь на её округлый живот, и на этот раз она не убирает мою руку."

# ch/cassidy/date.rpy:216
translate russian cassidy_dance_with_f396ceda:
    cassidy.say "Осторожнее, [lssb_cassidy.hero_name()]. Будешь так со мной танцевать — снова доведёшь меня до беды."

# ch/cassidy/date.rpy:218
translate russian cassidy_dance_with_a75ebc7c:
    cassidy.say "Наслаждайся, [lssb_cassidy.hero_name()]. Большинство мужчин лишь мечтают оказаться так близко ко мне."

# ch/cassidy/date.rpy:220
translate russian cassidy_dance_with_39ab1941:
    cassidy.say "Я могла бы простоять так всю ночь, прижимаясь к тебе, [lssb_cassidy.hero_name()]."

# ch/cassidy/date.rpy:222
translate russian cassidy_dance_with_2829aef7:
    cassidy.say "Знаешь, для неопрятного ничтожества ты неплохо умеешь дать девушке почувствовать себя единственной во всём зале."

# ch/cassidy/date.rpy:226
translate russian cassidy_date_play_arcade_intro_male_f5aa37d5:
    cassidy.say "Фу!"

# ch/cassidy/date.rpy:227
translate russian cassidy_date_play_arcade_intro_male_e73f01d0:
    cassidy.say "Здесь странно пахнет!"

# ch/cassidy/date.rpy:228
translate russian cassidy_date_play_arcade_intro_male_3d1b6502:
    cassidy.say "И ноги прилипают к ковру!"

# ch/cassidy/date.rpy:229
translate russian cassidy_date_play_arcade_intro_male_5e44eb14:
    "Я оборачиваюсь к Кэссиди, стараясь не хмуриться."

# ch/cassidy/date.rpy:230
translate russian cassidy_date_play_arcade_intro_male_1b7bab26:
    "И без того было непросто уговорить её пойти в зал игровых автоматов."

# ch/cassidy/date.rpy:231
translate russian cassidy_date_play_arcade_intro_male_c5700976:
    "Но теперь, когда мы здесь, она только и делает, что жалуется!"

# ch/cassidy/date.rpy:232
translate russian cassidy_date_play_arcade_intro_male_bafff4e2:
    mike.say "Сюда приходят не ради интерьера, Кэссиди."

# ch/cassidy/date.rpy:233
translate russian cassidy_date_play_arcade_intro_male_9ef63dee:
    mike.say "Главное — погрузиться в игры."

# ch/cassidy/date.rpy:234
translate russian cassidy_date_play_arcade_intro_male_435547ed:
    mike.say "Они открывают дверь в другой мир."

# ch/cassidy/date.rpy:235
translate russian cassidy_date_play_arcade_intro_male_f573bd23:
    mike.say "Мир фантазий и приключений!"

# ch/cassidy/date.rpy:236
translate russian cassidy_date_play_arcade_intro_male_56a4c9d1:
    "Кэссиди закатывает глаза."

# ch/cassidy/date.rpy:237
translate russian cassidy_date_play_arcade_intro_male_41a7eb0f:
    cassidy.say "Кому захочется идти в такую вонючую дыру?"

# ch/cassidy/date.rpy:238
translate russian cassidy_date_play_arcade_intro_male_07ec24de:
    cassidy.say "Особенно когда в телефоне есть игры получше!"

# ch/cassidy/date.rpy:239
translate russian cassidy_date_play_arcade_intro_male_62816882:
    "Я отчаянно оглядываюсь в поисках хоть какого-нибудь возражения."

# ch/cassidy/date.rpy:240
translate russian cassidy_date_play_arcade_intro_male_5cf574dd:
    "И замечаю ряд классических автоматов."

# ch/cassidy/date.rpy:241
translate russian cassidy_date_play_arcade_intro_male_a8adcfda:
    mike.say "Только не эти, Кэссиди."

# ch/cassidy/date.rpy:242
translate russian cassidy_date_play_arcade_intro_male_0d00b8f2:
    mike.say "Это старые аркадные игры."

# ch/cassidy/date.rpy:243
translate russian cassidy_date_play_arcade_intro_male_694047f2:
    mike.say "Классика, которую никогда не выпускали ни на телефонах, ни на консолях."

# ch/cassidy/date.rpy:244
translate russian cassidy_date_play_arcade_intro_male_26d8b15c:
    cassidy.say "Правда?"

# ch/cassidy/date.rpy:245
translate russian cassidy_date_play_arcade_intro_male_91e7ef86:
    mike.say "Правда."

# ch/cassidy/date.rpy:246
translate russian cassidy_date_play_arcade_intro_male_73e3274e:
    cassidy.say "То есть, если я выложу в соцсети селфи, где играю в них..."

# ch/cassidy/date.rpy:247
translate russian cassidy_date_play_arcade_intro_male_76e0be49:
    mike.say "Это будет довольно необычно. Может, даже совсем оригинально."

# ch/cassidy/date.rpy:248
translate russian cassidy_date_play_arcade_intro_male_471dfe0c:
    cassidy.say "Ладно, [lssb_cassidy.hero_name()], ладно."

# ch/cassidy/date.rpy:249
translate russian cassidy_date_play_arcade_intro_male_642239a1:
    cassidy.say "Давай сыграем... вот в эту!"

# ch/cassidy/date.rpy:250
translate russian cassidy_date_play_arcade_intro_male_adaee92c:
    mike.say "О, отличный выбор! Называется «Буйство»."

# ch/cassidy/date.rpy:251
translate russian cassidy_date_play_arcade_intro_male_9cc599d6:
    mike.say "Тут играешь за огромного монстра, который громит город!"

# ch/cassidy/date.rpy:252
translate russian cassidy_date_play_arcade_intro_male_5057b8d5:
    cassidy.say "Тогда опускай монетку, [lssb_cassidy.hero_name()]!"

# ch/cassidy/date.rpy:253
translate russian cassidy_date_play_arcade_intro_male_ede79276:
    cassidy.say "Я буду за эту чешуйчатую ящерицу."

# ch/cassidy/date.rpy:254
translate russian cassidy_date_play_arcade_intro_male_95e5f381:
    cassidy.say "А ты можешь взять большую волосатую обезьяну!"

# ch/cassidy/date.rpy:258
translate russian cassidy_date_play_arcade_win_male_c1a551cf:
    "В детстве у моего отца была ретроконсоль, и среди игр на ней была эта."

# ch/cassidy/date.rpy:259
translate russian cassidy_date_play_arcade_win_male_2886242f:
    "Я, наверное, часами рубился в неё до одури."

# ch/cassidy/date.rpy:260
translate russian cassidy_date_play_arcade_win_male_4ea4d166:
    "Так что в этой игре я настоящий мастер."

# ch/cassidy/date.rpy:261
translate russian cassidy_date_play_arcade_win_male_46ce32f8:
    cassidy.say "Эй, так нечестно!"

# ch/cassidy/date.rpy:262
translate russian cassidy_date_play_arcade_win_male_e9512aea:
    cassidy.say "Я собиралась разнести это здание, [lssb_cassidy.hero_name()]!"

# ch/cassidy/date.rpy:263
translate russian cassidy_date_play_arcade_win_male_c4d6543f:
    cassidy.say "И девиц в беде ты схватил больше, чем я!"

# ch/cassidy/date.rpy:264
translate russian cassidy_date_play_arcade_win_male_6f0e8b0b:
    mike.say "Нужно внимательнее следить за игрой, Кэссиди."

# ch/cassidy/date.rpy:265
translate russian cassidy_date_play_arcade_win_male_d276c102:
    mike.say "Жалобами очков не заработаешь!"

# ch/cassidy/date.rpy:266
translate russian cassidy_date_play_arcade_win_male_ae56061b:
    "Кэссиди фыркает, и мы продолжаем играть."

# ch/cassidy/date.rpy:267
translate russian cassidy_date_play_arcade_win_male_d46bb731:
    "Но, похоже, она не прислушалась к моему совету."

# ch/cassidy/date.rpy:268
translate russian cassidy_date_play_arcade_win_male_b267c489:
    "Всю игру я уверенно лидирую."

# ch/cassidy/date.rpy:269
translate russian cassidy_date_play_arcade_win_male_faabbb52:
    "И когда оплаченные попытки заканчиваются, я далеко впереди."

# ch/cassidy/date.rpy:270
translate russian cassidy_date_play_arcade_win_male_165a4847:
    cassidy.say "Уф..."

# ch/cassidy/date.rpy:271
translate russian cassidy_date_play_arcade_win_male_0b46b850:
    cassidy.say "Рада, что это закончилось!"

# ch/cassidy/date.rpy:272
translate russian cassidy_date_play_arcade_win_male_6abbc86b:
    cassidy.say "Теперь насчёт селфи..."

# ch/cassidy/date.rpy:273
translate russian cassidy_date_play_arcade_win_male_61000141:
    cassidy.say "Я просто скажу, что твои очки — мои, хорошо?"

# ch/cassidy/date.rpy:274
translate russian cassidy_date_play_arcade_win_male_f6ea4529:
    mike.say "Как хочешь, Кэссиди."

# ch/cassidy/date.rpy:275
translate russian cassidy_date_play_arcade_win_male_ed7acc7c:
    mike.say "Лишь бы ты была довольна."

# ch/cassidy/date.rpy:277
translate russian cassidy_date_play_arcade_win_male_1080683c:
    cassidy.say "Умный ответ. Учишься, [lssb_cassidy.hero_name()]."

# ch/cassidy/date.rpy:279
translate russian cassidy_date_play_arcade_win_male_f61ede4a:
    cassidy.say "Ты меня балуешь, [lssb_cassidy.hero_name()]. Даришь победу, хотя я её не заслужила."

# ch/cassidy/date.rpy:281
translate russian cassidy_date_play_arcade_win_male_1e71a15c:
    cassidy.say "Ты слишком добр ко мне, знаешь? Я тебя не заслуживаю, но меня это даже не волнует."

# ch/cassidy/date.rpy:285
translate russian cassidy_date_play_arcade_lose_male_c1a551cf:
    "В детстве у моего отца была ретроконсоль, и среди игр на ней была эта."

# ch/cassidy/date.rpy:286
translate russian cassidy_date_play_arcade_lose_male_be353893:
    "Едва мы начинаем играть, я жалею, что не уделял ей больше времени!"

# ch/cassidy/date.rpy:287
translate russian cassidy_date_play_arcade_lose_male_15902bf1:
    "Потому что играю я не лучше Кэссиди: мы оба полные новички."

# ch/cassidy/date.rpy:288
translate russian cassidy_date_play_arcade_lose_male_0b9e75fc:
    mike.say "Э... эй, что это было?"

# ch/cassidy/date.rpy:289
translate russian cassidy_date_play_arcade_lose_male_daab434a:
    mike.say "Кэссиди, я собирался разнести это здание!"

# ch/cassidy/date.rpy:290
translate russian cassidy_date_play_arcade_lose_male_e7bd58ec:
    mike.say "И эту девицу в беде тоже собирался схватить я!"

# ch/cassidy/date.rpy:291
translate russian cassidy_date_play_arcade_lose_male_761a39e2:
    cassidy.say "Да забудь уже, [lssb_cassidy.hero_name()]."

# ch/cassidy/date.rpy:292
translate russian cassidy_date_play_arcade_lose_male_2b7c985f:
    cassidy.say "У тебя был шанс."

# ch/cassidy/date.rpy:293
translate russian cassidy_date_play_arcade_lose_male_3a404e0a:
    cassidy.say "А знаешь что? Игра-то очень весёлая!"

# ch/cassidy/date.rpy:294
translate russian cassidy_date_play_arcade_lose_male_5b5cd93b:
    "Я стараюсь не дуться, пока Кэссиди продолжает уверенно лидировать."

# ch/cassidy/date.rpy:295
translate russian cassidy_date_play_arcade_lose_male_7b7cc405:
    "Невероятно, словно у неё врождённый талант к этой игре."

# ch/cassidy/date.rpy:296
translate russian cassidy_date_play_arcade_lose_male_239b30a2:
    "Что бы я ни пробовал, догнать её не получается."

# ch/cassidy/date.rpy:297
translate russian cassidy_date_play_arcade_lose_male_453c66af:
    "Когда оплаченные попытки заканчиваются, она далеко впереди!"

# ch/cassidy/date.rpy:298
translate russian cassidy_date_play_arcade_lose_male_67d5b96e:
    mike.say "Угх..."

# ch/cassidy/date.rpy:299
translate russian cassidy_date_play_arcade_lose_male_dbe32273:
    mike.say "Наконец-то всё?"

# ch/cassidy/date.rpy:300
translate russian cassidy_date_play_arcade_lose_male_26f9897c:
    cassidy.say "Хватит ныть, [lssb_cassidy.hero_name()]."

# ch/cassidy/date.rpy:301
translate russian cassidy_date_play_arcade_lose_male_2ef1cb4d:
    cassidy.say "А теперь сделаем селфи..."

# ch/cassidy/date.rpy:302
translate russian cassidy_date_play_arcade_lose_male_23169a47:
    mike.say "Эм, Кэссиди..."

# ch/cassidy/date.rpy:303
translate russian cassidy_date_play_arcade_lose_male_9e642db9:
    mike.say "Может, сделаем вид, что твои очки — мои?"

# ch/cassidy/date.rpy:305
translate russian cassidy_date_play_arcade_lose_male_d5133f80:
    cassidy.say "Исключено. Победителям достаются трофеи, [lssb_cassidy.hero_name()]. А проигравшие таскают сумки."

# ch/cassidy/date.rpy:307
translate russian cassidy_date_play_arcade_lose_male_150e10ba:
    cassidy.say "Конечно, [lssb_cassidy.hero_name()]. Всё моё и так принадлежит тебе."

# ch/cassidy/date.rpy:309
translate russian cassidy_date_play_arcade_lose_male_aa97c614:
    cassidy.say "Уф, ладно. Но только потому, что это ты. Не зазнавайся."

# ch/cassidy/date.rpy:311
translate russian cassidy_date_play_arcade_lose_male_bab21db6:
    cassidy.say "Мечтай, [lssb_cassidy.hero_name()]. Делай своё селфи."

# ch/cassidy/date.rpy:319
translate russian cassidy_dick_reactions_6bff2e6b:
    cassidy.say "Весьма внушительный размер!"

# ch/cassidy/date.rpy:320
translate russian cassidy_dick_reactions_f05354b5:
    mike.say "Эм... спасибо за комплимент."

# ch/cassidy/date.rpy:322
translate russian cassidy_dick_reactions_35695af8:
    cassidy.say "Не за что, [lssb_cassidy.hero_name()]."

# ch/cassidy/date.rpy:323
translate russian cassidy_dick_reactions_5c0589f1:
    cassidy.say "Просто иди сюда и дай мне его!"

# ch/cassidy/date.rpy:327
translate russian cassidy_dick_reactions_8e62519c:
    cassidy.say "Ох... я ожидала, что он будет больше!"

# ch/cassidy/date.rpy:328
translate russian cassidy_dick_reactions_d45ababc:
    mike.say "Эм... прости, что разочаровал тебя, Кэссиди!"

# ch/cassidy/date.rpy:329
translate russian cassidy_dick_reactions_c0234912:
    cassidy.say "Ну что ж..."

# ch/cassidy/date.rpy:331
translate russian cassidy_dick_reactions_1cde7179:
    cassidy.say "Придётся довольствоваться тем, что есть!"

# ch/cassidy/date.rpy:338
translate russian cassidy_halloween_invitation_cb17aa45:
    "Как только мы решаем устроить вечеринку на Хэллоуин, я понимаю, что хочу пригласить Кэссиди."

# ch/cassidy/date.rpy:339
translate russian cassidy_halloween_invitation_82811a42:
    "В идеальном мире я бы просто подошёл и пригласил её, не раздумывая."

# ch/cassidy/date.rpy:340
translate russian cassidy_halloween_invitation_4f3fa988:
    "Но с такими девушками, как она, этот номер не проходит."

# ch/cassidy/date.rpy:341
translate russian cassidy_halloween_invitation_e2f8715b:
    "И всё потому, что она..."

# ch/cassidy/date.rpy:342
translate russian cassidy_halloween_invitation_a782b8b4:
    "Будем честны: иногда она бывает немного избалованной!"

# ch/cassidy/date.rpy:343
translate russian cassidy_halloween_invitation_83ef68f4:
    "Ладно, ладно... Иногда она бывает ОЧЕНЬ избалованной."

# ch/cassidy/date.rpy:344
translate russian cassidy_halloween_invitation_dacec438:
    "Но уверен: если правильно к ней подступиться, у меня всё получится."

# ch/cassidy/date.rpy:345
translate russian cassidy_halloween_invitation_bd4e41f1:
    "Нужно лишь найти подход и как следует всё преподнести..."

# ch/cassidy/date.rpy:346
translate russian cassidy_halloween_invitation_abbf69ea:
    mike.say "Привет, Кэссиди..."

# ch/cassidy/date.rpy:348
translate russian cassidy_halloween_invitation_2354f562:
    mike.say "Не хочешь прийти ко мне на вечеринку в честь Хэллоуина?"

# ch/cassidy/date.rpy:349
translate russian cassidy_halloween_invitation_cc0aaee9:
    "А-а-а!"

# ch/cassidy/date.rpy:350
translate russian cassidy_halloween_invitation_7475f0fb:
    "Что я, чёрт возьми, только что сделал?!"

# ch/cassidy/date.rpy:351
translate russian cassidy_halloween_invitation_701f0246:
    "Слова вырвались раньше, чем я успел подумать!"

# ch/cassidy/date.rpy:352
translate russian cassidy_halloween_invitation_9e778b08:
    "И я прямо на глазах вижу, как они действуют на Кэссиди."

# ch/cassidy/date.rpy:354
translate russian cassidy_halloween_invitation_a870aa38:
    cassidy.say "Что ты сказал, [lssb_cassidy.hero_name()]?"

# ch/cassidy/date.rpy:355
translate russian cassidy_halloween_invitation_d644aaa2:
    cassidy.say "Ты правда только что пригласил меня на вечеринку в честь Хэллоуина?"

# ch/cassidy/date.rpy:357
translate russian cassidy_halloween_invitation_af0badac:
    cassidy.say "Ещё и в ту дыру, где ты живёшь?"

# ch/cassidy/date.rpy:359
translate russian cassidy_halloween_invitation_367a19fd:
    "От каждого её слова хочется скривиться и застонать."

# ch/cassidy/date.rpy:360
translate russian cassidy_halloween_invitation_f47762f5:
    "Они бьют под дых, словно удары профессионального боксёра."

# ch/cassidy/date.rpy:361
translate russian cassidy_halloween_invitation_ee4d35ed:
    "Я произнёс всего две фразы, а Кэссиди уже прижала меня к канатам!"

# ch/cassidy/date.rpy:362
translate russian cassidy_halloween_invitation_6f993e85:
    mike.say "А... ха-ха!"

# ch/cassidy/date.rpy:363
translate russian cassidy_halloween_invitation_79288877:
    mike.say "Да, тут не поспоришь!"

# ch/cassidy/date.rpy:364
translate russian cassidy_halloween_invitation_0f57b534:
    mike.say "Но это настолько убого, что даже круто, правда?"

# ch/cassidy/date.rpy:365
translate russian cassidy_halloween_invitation_7239ab56:
    mike.say "Ну, в ироническом смысле?"

# ch/cassidy/date.rpy:366
translate russian cassidy_halloween_invitation_52b0cb75:
    "Кэссиди закатывает глаза и неодобрительно цокает языком."

# ch/cassidy/date.rpy:369
translate russian cassidy_halloween_invitation_1131cfac:
    cassidy.say "Погоди-ка..."

# ch/cassidy/date.rpy:370
translate russian cassidy_halloween_invitation_59c86435:
    cassidy.say "Твои соседки по дому — все девушки, верно?"

# ch/cassidy/date.rpy:372
translate russian cassidy_halloween_invitation_70cf9c09:
    mike.say "Н... наверное, да, Кэссиди."

# ch/cassidy/date.rpy:373
translate russian cassidy_halloween_invitation_00cf04d8:
    "Кэссиди на мгновение замолкает."

# ch/cassidy/date.rpy:374
translate russian cassidy_halloween_invitation_d3563db2:
    "Но я вижу, что мысли у неё в голове так и крутятся."

# ch/cassidy/date.rpy:376
translate russian cassidy_halloween_invitation_3ba770ec:
    cassidy.say "А эта ваша вечеринка..."

# ch/cassidy/date.rpy:377
translate russian cassidy_halloween_invitation_621ecdad:
    cassidy.say "Она будет костюмированной?"

# ch/cassidy/date.rpy:379
translate russian cassidy_halloween_invitation_f1b40822:
    mike.say "О да, будет."

# ch/cassidy/date.rpy:380
translate russian cassidy_halloween_invitation_bac4508c:
    mike.say "Я как раз хотел об этом сказать!"

# ch/cassidy/date.rpy:382
translate russian cassidy_halloween_invitation_81df5277:
    "На лице Кэссиди медленно появляется улыбка."

# ch/cassidy/date.rpy:383
translate russian cassidy_halloween_invitation_675ea173:
    "Хотелось бы сказать, что это сразу меня успокаивает."

# ch/cassidy/date.rpy:384
translate russian cassidy_halloween_invitation_0bb1cc98:
    "Но от такой улыбки мне становится тревожно."

# ch/cassidy/date.rpy:386
translate russian cassidy_halloween_invitation_1eb2fab2:
    cassidy.say "Ладно, [lssb_cassidy.hero_name()]."

# ch/cassidy/date.rpy:388
translate russian cassidy_halloween_invitation_24611220:
    cassidy.say "Я приду на твою вечериночку."

# ch/cassidy/date.rpy:390
translate russian cassidy_halloween_invitation_925f6f7a:
    cassidy.say "И надену кое-что, от чего у тебя снесёт крышу."

# ch/cassidy/date.rpy:392
translate russian cassidy_halloween_invitation_07a39f55:
    cassidy.say "Заодно и твоих соседушек затмю!"

# ch/cassidy/date.rpy:394
translate russian cassidy_halloween_invitation_c0c69b26:
    mike.say "Д... да, Кэссиди."

# ch/cassidy/date.rpy:395
translate russian cassidy_halloween_invitation_be08dd0c:
    mike.say "Звучит здорово!"

# ch/cassidy/date.rpy:400
translate russian cassidy_halloween_invitation_165a4847:
    cassidy.say "Уф..."

# ch/cassidy/date.rpy:401
translate russian cassidy_halloween_invitation_98a51edf:
    cassidy.say "Сделаю вид, что ты этого не говорил, [lssb_cassidy.hero_name()]!"

# ch/cassidy/date.rpy:403
translate russian cassidy_halloween_invitation_b6d16935:
    cassidy.say "А потом начнём этот разговор сначала, хорошо?"

# ch/cassidy/date.rpy:405
translate russian cassidy_halloween_invitation_dab19190:
    "Я осторожно киваю, чувствуя себя растоптанным."

# ch/cassidy/date.rpy:406
translate russian cassidy_halloween_invitation_f1d8a63c:
    mike.say "Эм..."

# ch/cassidy/date.rpy:407
translate russian cassidy_halloween_invitation_c29f8fe6:
    mike.say "Хорошо, Кэссиди."

# ch/cassidy/date.rpy:408
translate russian cassidy_halloween_invitation_66ce4894:
    mike.say "Эм... спасибо... наверное?"

# ch/cassidy/date.rpy:409
translate russian cassidy_halloween_invitation_4c33c4da:
    "Кэссиди снова цокает языком."

# ch/cassidy/date.rpy:410
translate russian cassidy_halloween_invitation_a39d0488:
    "А затем качает головой."

# ch/cassidy/date.rpy:411
translate russian cassidy_halloween_invitation_cd114be9:
    "Видимо, это значит, что вопрос официально закрыт."

# ch/cassidy/date.rpy:413
translate russian cassidy_halloween_invitation_ae65fcd1:
    cassidy.say "Разрешаю тебе попытаться ещё раз, [lssb_cassidy.hero_name()]."

# ch/cassidy/date.rpy:414
translate russian cassidy_halloween_invitation_631f2c1a:
    cassidy.say "Так что в следующий раз постарайся получше."

# ch/cassidy/date.rpy:416
translate russian cassidy_halloween_invitation_0ba0ef51:
    cassidy.say "Иначе проведёшь Хэллоуин без меня."

# ch/cassidy/date.rpy:417
translate russian cassidy_halloween_invitation_18ed1877:
    cassidy.say "А это хуже, чем провести его в одиночестве!"

# ch/cassidy/date.rpy:422
translate russian cassidy_halloween_arrival_7e70cafc:
    "От хлопот хозяина вечеринки у меня до сих пор голова идёт кругом."

# ch/cassidy/date.rpy:423
translate russian cassidy_halloween_arrival_1ac2b8d3:
    "Поэтому, открывая дверь, я толком не соображаю, что делаю."

# ch/cassidy/date.rpy:425
translate russian cassidy_halloween_arrival_2fc99de7:
    "Но зрелище за порогом заставляет меня замереть."

# ch/cassidy/date.rpy:426
translate russian cassidy_halloween_arrival_bf8fc11c:
    "Я могу лишь стоять, вытаращив глаза и открыв рот."

# ch/cassidy/date.rpy:428
translate russian cassidy_halloween_arrival_d15ba3ba:
    cassidy.say "Привет, [lssb_cassidy.hero_name()]."

# ch/cassidy/date.rpy:429
translate russian cassidy_halloween_arrival_8bf9073e:
    cassidy.say "Не маловат ли ты для моего кавалера?"

# ch/cassidy/date.rpy:431
translate russian cassidy_halloween_arrival_3ebea99b:
    "Вдруг на меня накатывают все неловкие воспоминания юности."

# ch/cassidy/date.rpy:432
translate russian cassidy_halloween_arrival_a3dd19a4:
    "Тот самый образ, что врезался в память каждому парню, смотревшему «Возвращение джеуди»."

# ch/cassidy/date.rpy:433
translate russian cassidy_halloween_arrival_bf52a9ca:
    "Металлическое бикини."

# ch/cassidy/date.rpy:434
translate russian cassidy_halloween_arrival_fe0d15e4:
    "Столько обнажённой кожи."

# ch/cassidy/date.rpy:435
translate russian cassidy_halloween_arrival_bd59533a:
    mike.say "Принцесса..."

# ch/cassidy/date.rpy:436
translate russian cassidy_halloween_arrival_20f491bd:
    mike.say "Лейла..."

# ch/cassidy/date.rpy:437
translate russian cassidy_halloween_arrival_c0d96cb6:
    "Кэссиди хихикает и кружится на месте."

# ch/cassidy/date.rpy:438
translate russian cassidy_halloween_arrival_9d0ca549:
    "Будто забралась мне в душу и ухватила за горло моего внутреннего гика."

# ch/cassidy/date.rpy:440
translate russian cassidy_halloween_arrival_2ad1f57e:
    cassidy.say "Да, именно."

# ch/cassidy/date.rpy:442
translate russian cassidy_halloween_arrival_836bbdbe:
    cassidy.say "Я так и думала, что тебе понравится!"

# ch/cassidy/date.rpy:443
translate russian cassidy_halloween_arrival_309944f7:
    cassidy.say "Ну что, ты собираешься меня впускать?"

# ch/cassidy/date.rpy:444
translate russian cassidy_halloween_arrival_0880fb03:
    cassidy.say "Этот костюм, мягко говоря, не самый тёплый!"

# ch/cassidy/date.rpy:447
translate russian cassidy_halloween_arrival_9ee0e447:
    "Цепочки и кусочки металла совсем не скрывают округлый живот, но от этого она почему-то ещё сногсшибательнее."

# ch/cassidy/date.rpy:449
translate russian cassidy_halloween_arrival_be1df01f:
    cassidy.say "Да, живот уже заметен. Нет, меня это не волнует. Я всё равно выгляжу лучше всех, кого ты сегодня увидишь."

# ch/cassidy/date.rpy:452
translate russian cassidy_halloween_arrival_a29fdd01:
    cassidy.say "И я выбрала его специально для тебя, [lssb_cassidy.hero_name()]. Так что изволь оценить каждый сантиметр."

# ch/cassidy/date.rpy:456
translate russian cassidy_halloween_arrival_f06794c6:
    "Внезапно оцепенение проходит."

# ch/cassidy/date.rpy:457
translate russian cassidy_halloween_arrival_9b7e6c09:
    "Я отступаю в сторону и жестом приглашаю Кэссиди войти."

# ch/cassidy/date.rpy:458
translate russian cassidy_halloween_arrival_5fec450a:
    mike.say "Конечно, Кэссиди, конечно."

# ch/cassidy/date.rpy:459
translate russian cassidy_halloween_arrival_6d58d6d5:
    mike.say "Заходи, пока совсем не замёрзла!"

# ch/cassidy/date.rpy:460
translate russian cassidy_halloween_arrival_91521e17:
    "Кэссиди улыбается в ответ на мою почтительность."

# ch/cassidy/date.rpy:461
translate russian cassidy_halloween_arrival_abadc2c5:
    "Затем гордо входит в дом, словно настоящая принцесса."

# ch/cassidy/date.rpy:462
translate russian cassidy_halloween_arrival_78fb2a83:
    "Всё это время она явно наслаждается моей реакцией на её костюм."

# ch/cassidy/date.rpy:463
translate russian cassidy_halloween_arrival_6485aa38:
    "А я, не в силах сопротивляться, следую за ней."

# ch/cassidy/date.rpy:467
translate russian cassidy_halloween_arrival_ad593d4f:
    cassidy.say "О-о, как ты на меня смотришь!"

# ch/cassidy/date.rpy:468
translate russian cassidy_halloween_arrival_f80990a6:
    cassidy.say "Прямо как в фильме, знаешь?"

# ch/cassidy/date.rpy:470
translate russian cassidy_halloween_arrival_297f62db:
    mike.say "Что..."

# ch/cassidy/date.rpy:471
translate russian cassidy_halloween_arrival_12a93b41:
    mike.say "Я напоминаю тебе Хана Одиночку, который пришёл на выручку?"

# ch/cassidy/date.rpy:473
translate russian cassidy_halloween_arrival_e6e86c9a:
    cassidy.say "Не-а, я не о нём подумала."

# ch/cassidy/date.rpy:474
translate russian cassidy_halloween_arrival_9875b78b:
    cassidy.say "Скорее о том здоровенном слизняке, который облизывается!"

# ch/cassidy/date.rpy:476
translate russian cassidy_halloween_arrival_200eb25b:
    mike.say "Эй!"

# ch/cassidy/date.rpy:477
translate russian cassidy_halloween_arrival_c56d7312:
    mike.say "Прошу не сравнивать меня с Джобой Членастым!"

# ch/cassidy/date.rpy:479
translate russian cassidy_halloween_arrival_2689ee17:
    "Мне удаётся взять себя в руки."

# ch/cassidy/date.rpy:480
translate russian cassidy_halloween_arrival_17307750:
    "Я жестом приглашаю Кэссиди войти."

# ch/cassidy/date.rpy:481
translate russian cassidy_halloween_arrival_cc0652b0:
    "Но что-то есть в её движениях."

# ch/cassidy/date.rpy:482
translate russian cassidy_halloween_arrival_26f2cf38:
    "В том, как этот костюм подчёркивает её тело..."

# ch/cassidy/date.rpy:483
translate russian cassidy_halloween_arrival_8b1cc92e:
    "Я просто не могу удержаться."

# ch/cassidy/date.rpy:488
translate russian cassidy_halloween_arrival_e88a80fc:
    "Когда она проходит мимо меня в дверях, я шлёпаю её по попке."

# ch/cassidy/date.rpy:489
translate russian cassidy_halloween_arrival_f544c6f8:
    "Звук почти как щелчок кнута."

# ch/cassidy/date.rpy:491
translate russian cassidy_halloween_arrival_c1c02b4d:
    cassidy.say "Ай!"

# ch/cassidy/date.rpy:493
translate russian cassidy_halloween_arrival_5c3ee275:
    cassidy.say "ЭЙ!"

# ch/cassidy/date.rpy:494
translate russian cassidy_halloween_arrival_3f42cec3:
    cassidy.say "Ты не можешь так со мной обращаться! Я принцесса!"

# ch/cassidy/date.rpy:496
translate russian cassidy_halloween_arrival_e4fd5249:
    "Я качаю головой и смеюсь."

# ch/cassidy/date.rpy:497
translate russian cassidy_halloween_arrival_355bf64d:
    "Кэссиди такая милая, когда злится!"

# ch/cassidy/date.rpy:498
translate russian cassidy_halloween_arrival_d4ba2342:
    mike.say "Да, но нужно следовать сюжету фильма, Кэссиди."

# ch/cassidy/date.rpy:499
translate russian cassidy_halloween_arrival_0d271ec4:
    mike.say "Когда Лейла носила этот костюм, она была пленницей Джобы Членастого."

# ch/cassidy/date.rpy:500
translate russian cassidy_halloween_arrival_d6a288d1:
    mike.say "Значит, сегодня я могу обращаться с тобой как со своей пленницей."

# ch/cassidy/date.rpy:502
translate russian cassidy_halloween_arrival_a55187e1:
    "Кэссиди презрительно кривит губы."

# ch/cassidy/date.rpy:503
translate russian cassidy_halloween_arrival_79dfdab2:
    "Но затем ей что-то приходит в голову, и она приподнимает бровь."

# ch/cassidy/date.rpy:505
translate russian cassidy_halloween_arrival_56343aba:
    cassidy.say "Тогда получается, что ты — Джоба, да?"

# ch/cassidy/date.rpy:507
translate russian cassidy_halloween_arrival_200eb25b_1:
    mike.say "Эй!"

# ch/cassidy/date.rpy:508
translate russian cassidy_halloween_arrival_c56d7312_1:
    mike.say "Прошу не сравнивать меня с Джобой Членастым!"

# ch/cassidy/date.rpy:517
translate russian cassidy_halloween_party_78330777:
    jack.say "Принцесса... Лейла..."

# ch/cassidy/date.rpy:518
translate russian cassidy_halloween_party_20549834:
    scottie.say "Металлическое... бикини..."

# ch/cassidy/date.rpy:519
translate russian cassidy_halloween_party_cb5c3960:
    cassidy.say "А-а-а!"

# ch/cassidy/date.rpy:520
translate russian cassidy_halloween_party_970dd7aa:
    cassidy.say "ЗОМБИ!"

# ch/cassidy/date.rpy:521
translate russian cassidy_halloween_party_007ea843:
    cassidy.say "Спаси меня, [lssb_cassidy.hero_name()]!"

# ch/cassidy/date.rpy:522
translate russian cassidy_halloween_party_b0e78d25:
    "Я оборачиваюсь, чтобы понять, что так напугало Кэссиди."

# ch/cassidy/date.rpy:527
translate russian cassidy_halloween_party_acdc0284:
    "И вижу Джека и Скотти, которые, шаркая ногами, идут к ней."

# ch/cassidy/date.rpy:528
translate russian cassidy_halloween_party_2b3f466a:
    "Рты у них открыты, а глаза остекленели."

# ch/cassidy/date.rpy:529
translate russian cassidy_halloween_party_edcbeecc:
    "Оба стонут и тянут к ней руки."

# ch/cassidy/date.rpy:530
translate russian cassidy_halloween_party_60d0336e:
    "Когда они приближаются, Кэссиди юркает мне за спину."

# ch/cassidy/date.rpy:531
translate russian cassidy_halloween_party_48bb4667:
    "Затем выглядывает из-за моего плеча с испуганным лицом."

# ch/cassidy/date.rpy:533
translate russian cassidy_halloween_party_da291297:
    cassidy.say "Не дай им меня схватить."

# ch/cassidy/date.rpy:534
translate russian cassidy_halloween_party_88f80001:
    cassidy.say "Не дай им съесть мои мозги!"

# ch/cassidy/date.rpy:536
translate russian cassidy_halloween_party_3adbeade:
    "Конечно, никакие они не зомби."

# ch/cassidy/date.rpy:537
translate russian cassidy_halloween_party_e440a205:
    "Просто оба попали под чары костюма Кэссиди!"

# ch/cassidy/date.rpy:540
translate russian cassidy_halloween_party_72772e81:
    mike.say "Отойди, Кэссиди."

# ch/cassidy/date.rpy:541
translate russian cassidy_halloween_party_cf9e3bff:
    mike.say "Я разберусь с этими безмозглыми чудовищами!"

# ch/cassidy/date.rpy:543
translate russian cassidy_halloween_party_d4278d58:
    "Я шагаю вперёд и щёлкаю пальцами перед их лицами."

# ch/cassidy/date.rpy:546
translate russian cassidy_halloween_party_5bb03551:
    "Сначала реагирует Джек, затем Скотти."

# ch/cassidy/date.rpy:547
translate russian cassidy_halloween_party_1207239e:
    "Они выходят из оцепенения и растерянно оглядываются."

# ch/cassidy/date.rpy:548
translate russian cassidy_halloween_party_caec75fc:
    jack.say "Эй, куда делась принцесса?"

# ch/cassidy/date.rpy:550
translate russian cassidy_halloween_party_2ff28d28:
    scottie.say "Ага, где сиськи?!"

# ch/cassidy/date.rpy:551
translate russian cassidy_halloween_party_1cf59883:
    mike.say "По-моему, передо мной как раз парочка самых больших придурков на этой вечеринке!"

# ch/cassidy/date.rpy:552
translate russian cassidy_halloween_party_7b5b1d1f:
    mike.say "Вы можете держать свои подростковые фантазии при себе?"

# ch/cassidy/date.rpy:553
translate russian cassidy_halloween_party_198d114d:
    jack.say "А... прости, чувак."

# ch/cassidy/date.rpy:555
translate russian cassidy_halloween_party_8cba6a76:
    scottie.say "Наш косяк, дружище."

# ch/cassidy/date.rpy:558
translate russian cassidy_halloween_party_e0b3fd92:
    "Джек и Скотти уныло уходят, разочарованно бормоча."

# ch/cassidy/date.rpy:561
translate russian cassidy_halloween_party_4e2110b2:
    "А Кэссиди выходит из-за моей спины, явно довольная моими действиями."

# ch/cassidy/date.rpy:563
translate russian cassidy_halloween_party_236f78a7:
    cassidy.say "Ты им показал, [lssb_cassidy.hero_name()]!"

# ch/cassidy/date.rpy:564
translate russian cassidy_halloween_party_7005cc54:
    cassidy.say "В награду можешь стать моим рыцарем-джеуди в сияющих доспехах."

# ch/cassidy/date.rpy:566
translate russian cassidy_halloween_party_ae64d4e7:
    cassidy.say "Или позже я сама встану перед тобой на колени, [lssb_cassidy.hero_name()]. Выбирай."

# ch/cassidy/date.rpy:568
translate russian cassidy_halloween_party_20b964b7:
    cassidy.say "Считай это великой честью. Я не раздаю титулы кому попало, [lssb_cassidy.hero_name()]."

# ch/cassidy/date.rpy:570
translate russian cassidy_halloween_party_f56566aa:
    mike.say "Не глупи, Кэссиди."

# ch/cassidy/date.rpy:571
translate russian cassidy_halloween_party_6cd862c7:
    mike.say "Они не настоящие зомби."

# ch/cassidy/date.rpy:572
translate russian cassidy_halloween_party_c34fc7a3:
    mike.say "У них просто мозги расплавились, пока они пялились на тебя в этом костюме!"

# ch/cassidy/date.rpy:574
translate russian cassidy_halloween_party_d4278d58_1:
    "Я шагаю вперёд и щёлкаю пальцами перед их лицами."

# ch/cassidy/date.rpy:577
translate russian cassidy_halloween_party_5bb03551_1:
    "Сначала реагирует Джек, затем Скотти."

# ch/cassidy/date.rpy:578
translate russian cassidy_halloween_party_1207239e_1:
    "Они выходят из оцепенения и растерянно оглядываются."

# ch/cassidy/date.rpy:579
translate russian cassidy_halloween_party_caec75fc_1:
    jack.say "Эй, куда делась принцесса?"

# ch/cassidy/date.rpy:581
translate russian cassidy_halloween_party_2ff28d28_1:
    scottie.say "Ага, где сиськи?!"

# ch/cassidy/date.rpy:582
translate russian cassidy_halloween_party_2f0f0c18:
    mike.say "Парни, вам лучше отойти, ладно?"

# ch/cassidy/date.rpy:583
translate russian cassidy_halloween_party_bca19c06:
    mike.say "Сегодня Кэссиди пришла со мной."

# ch/cassidy/date.rpy:586
translate russian cassidy_halloween_party_e0b3fd92_1:
    "Джек и Скотти уныло уходят, разочарованно бормоча."

# ch/cassidy/date.rpy:589
translate russian cassidy_halloween_party_0b9a06f7:
    "Но Кэссиди, похоже, тоже не слишком довольна тем, как я всё уладил."

# ch/cassidy/date.rpy:599
translate russian cassidy_halloween_dance_db2f0505:
    bree.say "Привет, [lssb_cassidy.hero_name()]."

# ch/cassidy/date.rpy:600
translate russian cassidy_halloween_dance_0cd7be67:
    bree.say "Знаю, ты любишь эту песню."

# ch/cassidy/date.rpy:602
translate russian cassidy_halloween_dance_ce0fa9d7:
    bree.say "Пойдём танцевать!"

# ch/cassidy/date.rpy:604
translate russian cassidy_halloween_dance_91c80847:
    "Я оглядываюсь и вижу, как [bree.name] зовёт меня с танцпола."

# ch/cassidy/date.rpy:605
translate russian cassidy_halloween_dance_e1644e03:
    "Играет песня из игры, которая нам обоим очень нравится."

# ch/cassidy/date.rpy:606
translate russian cassidy_halloween_dance_efc767e7:
    "Обычно я бы с радостью воспользовался возможностью потанцевать с [bree.name]."

# ch/cassidy/date.rpy:607
translate russian cassidy_halloween_dance_2e73def5:
    "Но Кэссиди только что отлучилась в туалет."

# ch/cassidy/date.rpy:608
translate russian cassidy_halloween_dance_ca1fac4f:
    "И вряд ли ей понравится увидеть меня танцующим с другой девушкой."

# ch/cassidy/date.rpy:611
translate russian cassidy_halloween_dance_1fb573a6:
    mike.say "Я бы с радостью, [bree.name]."

# ch/cassidy/date.rpy:612
translate russian cassidy_halloween_dance_6a73ab4b:
    mike.say "Но я жду Кэссиди."

# ch/cassidy/date.rpy:614
translate russian cassidy_halloween_dance_fc026cb0:
    "Получив отказ, [bree.name] нарочито надувает губы."

# ch/cassidy/date.rpy:616
translate russian cassidy_halloween_dance_35b4ce07:
    "Но затем пожимает плечами, давая понять, что не обиделась."

# ch/cassidy/date.rpy:618
translate russian cassidy_halloween_dance_92529934:
    bree.say "Сам виноват!"

# ch/cassidy/date.rpy:620
translate russian cassidy_halloween_dance_bf576f90:
    "С этими словами она отворачивается и танцует одна."

# ch/cassidy/date.rpy:622
translate russian cassidy_halloween_dance_25ffe378:
    "Через мгновение рядом со мной появляется Кэссиди."

# ch/cassidy/date.rpy:624
translate russian cassidy_halloween_dance_843b08b8:
    cassidy.say "Что там у блондиночки, а?"

# ch/cassidy/date.rpy:625
translate russian cassidy_halloween_dance_72f9e26e:
    cassidy.say "Она подкатывала к моему кавалеру?"

# ch/cassidy/date.rpy:627
translate russian cassidy_halloween_dance_8e108e29:
    mike.say "Вовсе нет, Кэссиди!"

# ch/cassidy/date.rpy:628
translate russian cassidy_halloween_dance_411ed609:
    mike.say "[bree.name] просто пригласила меня потанцевать."

# ch/cassidy/date.rpy:630
translate russian cassidy_halloween_dance_dd256135:
    cassidy.say "Ах, вот как!"

# ch/cassidy/date.rpy:632
translate russian cassidy_halloween_dance_1047e2eb:
    mike.say "Не волнуйся, я сказал, что жду тебя."

# ch/cassidy/date.rpy:635
translate russian cassidy_halloween_dance_069f6e7d:
    "Услышав это, Кэссиди кивает и победоносно хмыкает."

# ch/cassidy/date.rpy:637
translate russian cassidy_halloween_dance_8071ab0c:
    cassidy.say "За такое полагается награда."

# ch/cassidy/date.rpy:641
translate russian cassidy_halloween_dance_3403a9a7:
    "Кэссиди тащит меня на танцпол."

# ch/cassidy/date.rpy:642
translate russian cassidy_halloween_dance_08f80df6:
    "И прижимается так, словно приклеилась ко мне."

# ch/cassidy/date.rpy:643
translate russian cassidy_halloween_dance_36a97674:
    "Всё это время она не сводит глаз с [bree.name]."

# ch/cassidy/date.rpy:644
translate russian cassidy_halloween_dance_ab7a326c:
    "Словно помечает меня как свою собственность."

# ch/cassidy/date.rpy:645
translate russian cassidy_halloween_dance_b125c56c:
    "Может, это звучит странно."

# ch/cassidy/date.rpy:646
translate russian cassidy_halloween_dance_164705e7:
    "Но меня это даже заводит."

# ch/cassidy/date.rpy:647
translate russian cassidy_halloween_dance_15243563:
    "Будто она так сильно меня хочет!"

# ch/cassidy/date.rpy:649
translate russian cassidy_halloween_dance_9ef4ff4e:
    cassidy.say "Ты мой, [lssb_cassidy.hero_name()]. Я не делюсь. Даже на один танец."

# ch/cassidy/date.rpy:651
translate russian cassidy_halloween_dance_e038b84d:
    cassidy.say "Пусть блондиночка смотрит, [lssb_cassidy.hero_name()]. Ей полезно увидеть то, чего ей не получить."

# ch/cassidy/date.rpy:653
translate russian cassidy_halloween_dance_8e5ee797:
    mike.say "Конечно, [bree.name]."

# ch/cassidy/date.rpy:654
translate russian cassidy_halloween_dance_f7bfd4a2:
    mike.say "Кэссиди тоже сможет присоединиться, когда вернётся."

# ch/cassidy/date.rpy:659
