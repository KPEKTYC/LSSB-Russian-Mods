# ch/cassidy/gift.rpy:285
translate russian cassidy_gift_butt_plug_male_902cbf4d:
    cassidy.say "..."

# ch/cassidy/gift.rpy:286
translate russian cassidy_gift_butt_plug_male_1637661d:
    cassidy.say "Оставь себе... Я не хочу, так что забирай."

# ch/cassidy/gift.rpy:287
translate russian cassidy_gift_butt_plug_male_cba8c50b:
