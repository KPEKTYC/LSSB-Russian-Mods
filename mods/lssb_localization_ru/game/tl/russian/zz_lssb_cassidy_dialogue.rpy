# ch/cassidy/reactions.rpy:418
translate russian cassidy_belly_caress_male_7d704c4f:
    "Провожу ладонью по округлости и наслаждаюсь её теплом."

# ch/cassidy/reactions.rpy:419
translate russian cassidy_belly_caress_male_c492b8c4:
    "И я говорю это не просто ради того, чтобы её утешить."

# ch/cassidy/reactions.rpy:420
translate russian cassidy_belly_caress_male_d29923c4:
    "Для меня она сейчас и правда потрясающая: красивая и полная жизни."

# ch/cassidy/reactions.rpy:422
translate russian cassidy_belly_caress_male_dda9b41e:
    "К моему облегчению, настроение Кэссиди, кажется, немного улучшается."

# ch/cassidy/reactions.rpy:424
translate russian cassidy_belly_caress_male_21298e49:
    "Она улыбается и качает головой, посмеиваясь над моими словами."

# ch/cassidy/reactions.rpy:426
translate russian cassidy_belly_caress_male_5aaaaaef:
    cassidy.say "Ох, [lssb_cassidy.hero_name()]..."

# ch/cassidy/reactions.rpy:428
translate russian cassidy_belly_caress_male_9a4a5e62:
    cassidy.say "Никогда бы не подумала, что ты из таких!"

# ch/cassidy/reactions.rpy:430
translate russian cassidy_belly_caress_male_5066ed5b:
    "От этих слов Кэссиди я невольно хмурюсь."

# ch/cassidy/reactions.rpy:431
translate russian cassidy_belly_caress_male_932b3773:
    "Что она вообще имеет в виду?"

# ch/cassidy/reactions.rpy:432
translate russian cassidy_belly_caress_male_f1d8a63c:
    mike.say "Эм..."

# ch/cassidy/reactions.rpy:433
translate russian cassidy_belly_caress_male_77d90904:
    mike.say "Из каких, Кэссиди?"

# ch/cassidy/reactions.rpy:434
translate russian cassidy_belly_caress_male_b481d43f:
    mike.say "Я думал, что я самый обычный парень."

# ch/cassidy/reactions.rpy:435
translate russian cassidy_belly_caress_male_350c41e3:
    mike.say "Разве что чуть интереснее среднего?"

# ch/cassidy/reactions.rpy:437
translate russian cassidy_belly_caress_male_16f49980:
    "Кэссиди снова хихикает и подаётся животом ко мне."

# ch/cassidy/reactions.rpy:438
translate russian cassidy_belly_caress_male_d405862c:
    cassidy.say "Всё в порядке, [lssb_cassidy.hero_name()]..."

# ch/cassidy/reactions.rpy:439
translate russian cassidy_belly_caress_male_ec163786:
    cassidy.say "Многим парням нравятся пышные девушки!"

# ch/cassidy/reactions.rpy:441
translate russian cassidy_belly_caress_male_1a081ae4:
    mike.say "Ч... что?!"

# ch/cassidy/reactions.rpy:442
translate russian cassidy_belly_caress_male_6f931a5f:
    mike.say "Мне не нравятся пышные девушки!"

# ch/cassidy/reactions.rpy:443
translate russian cassidy_belly_caress_male_7c25400c:
    mike.say "Я... то есть я ничего против них не имею."

# ch/cassidy/reactions.rpy:444
translate russian cassidy_belly_caress_male_733a01e1:
    mike.say "Просто они нравятся мне не больше девушек любого другого телосложения!"

# ch/cassidy/reactions.rpy:446
translate russian cassidy_belly_caress_male_49f5095e:
    "Кэссиди кивает и подмигивает мне."

# ch/cassidy/reactions.rpy:447
translate russian cassidy_belly_caress_male_0447ac99:
    cassidy.say "Ну конечно..."

# ch/cassidy/reactions.rpy:448
translate russian cassidy_belly_caress_male_65e258dd:
    cassidy.say "Твой секрет со мной в безопасности!"

# ch/cassidy/reactions.rpy:450
translate russian cassidy_belly_caress_male_81894b58:
    mike.say "Какой секрет?"

# ch/cassidy/reactions.rpy:451
translate russian cassidy_belly_caress_male_e2342dc6:
    mike.say "Нет никакого секрета!"

# ch/cassidy/reactions.rpy:452
translate russian cassidy_belly_caress_male_31b6caf4:
    "Но что бы я ни делал, Кэссиди только кивает и улыбается."

# ch/cassidy/reactions.rpy:457
translate russian cassidy_belly_listen_male_7d3a0e63:
    mike.say "Кэссиди..."

# ch/cassidy/reactions.rpy:458
translate russian cassidy_belly_listen_male_21a8406e:
    mike.say "Подойдёшь сюда?"

# ch/cassidy/reactions.rpy:460
translate russian cassidy_belly_listen_male_ff59ae79:
    "Услышав своё имя, Кэссиди сразу оживляется."

# ch/cassidy/reactions.rpy:462
translate russian cassidy_belly_listen_male_2a4d2f57:
    "На её лице появляется улыбка, и она спешит ко мне."

# ch/cassidy/reactions.rpy:464
translate russian cassidy_belly_listen_male_287dd6f5:
    cassidy.say "Вот и я, [lssb_cassidy.hero_name()]..."

# ch/cassidy/reactions.rpy:465
translate russian cassidy_belly_listen_male_8b127f4e:
    cassidy.say "Чего ты хотел?"

# ch/cassidy/reactions.rpy:467
translate russian cassidy_belly_listen_male_d04bb766:
    "Мне требуется мгновение, чтобы привыкнуть к такому поведению Кэссиди."

# ch/cassidy/reactions.rpy:468
translate russian cassidy_belly_listen_male_1d26bc60:
    "Просто я не привык, что она так стремится угодить."

# ch/cassidy/reactions.rpy:469
translate russian cassidy_belly_listen_male_68db793b:
    "Обычно внимания требует она сама."

# ch/cassidy/reactions.rpy:470
translate russian cassidy_belly_listen_male_a8949170:
    "И привыкла его получать!"

# ch/cassidy/reactions.rpy:471
translate russian cassidy_belly_listen_male_ee06f6b0:
    "Наверное, ей кажется, что малышу достаётся больше внимания, чем ей."

# ch/cassidy/reactions.rpy:472
translate russian cassidy_belly_listen_male_51ddf1fd:
    "Но если так, мне придётся разочаровать Кэссиди ещё сильнее."

# ch/cassidy/reactions.rpy:473
translate russian cassidy_belly_listen_male_c8ef4f97:
    mike.say "Просто стой здесь, Кэссиди..."

# ch/cassidy/reactions.rpy:474
translate russian cassidy_belly_listen_male_95362371:
    mike.say "И, может, немного выпяти живот?"

# ch/cassidy/reactions.rpy:476
translate russian cassidy_belly_listen_male_d27bcdab:
    "Кэссиди выглядит весьма озадаченной."

# ch/cassidy/reactions.rpy:477
translate russian cassidy_belly_listen_male_f44e2ed8:
    "Но всё равно делает, как я прошу."

# ch/cassidy/reactions.rpy:478
translate russian cassidy_belly_listen_male_784eda8e:
    "Наверное, не хочет упускать возможность получить хоть какое-то внимание."

# ch/cassidy/reactions.rpy:480
translate russian cassidy_belly_listen_male_2827f63c:
    cassidy.say "Ладно, [lssb_cassidy.hero_name()]..."

# ch/cassidy/reactions.rpy:481
translate russian cassidy_belly_listen_male_3f6f8c7a:
    cassidy.say "Но зачем?"

# ch/cassidy/reactions.rpy:483
translate russian cassidy_belly_listen_male_b3ffafc2:
    "Когда она задаёт этот вопрос, я уже опускаюсь на одно колено."

# ch/cassidy/reactions.rpy:484
translate russian cassidy_belly_listen_male_ad043250:
    "Поэтому отвечаю немного рассеянно."

# ch/cassidy/reactions.rpy:485
translate russian cassidy_belly_listen_male_5494b2ba:
    "Ведь мне сейчас важнее приложить ухо к её животу."

# ch/cassidy/reactions.rpy:486
translate russian cassidy_belly_listen_male_75568118:
    mike.say "О, я хочу послушать малыша, Кэссиди."

# ch/cassidy/reactions.rpy:487
translate russian cassidy_belly_listen_male_91ff043a:
    mike.say "Понимаешь, вдруг услышу, как он там шевелится?"

# ch/cassidy/reactions.rpy:488
translate russian cassidy_belly_listen_male_d702ffb4:
    "Кэссиди скрещивает руки над животом и хмуро смотрит на меня сверху."

# ch/cassidy/reactions.rpy:490
translate russian cassidy_belly_listen_male_5aaaaaef:
    cassidy.say "Ох, [lssb_cassidy.hero_name()]..."

# ch/cassidy/reactions.rpy:491
translate russian cassidy_belly_listen_male_eb03215d:
    cassidy.say "А я думала, ты для разнообразия хочешь уделить всё внимание мне!"

# ch/cassidy/reactions.rpy:493
translate russian cassidy_belly_listen_male_c0e5ef06:
    "В ответ я могу лишь неопределённо махнуть рукой."

# ch/cassidy/reactions.rpy:494
translate russian cassidy_belly_listen_male_b667c135:
    "Потому что полностью сосредоточен на своём занятии."

# ch/cassidy/reactions.rpy:495
translate russian cassidy_belly_listen_male_951cd0b0:
    mike.say "Т-с-с!"

# ch/cassidy/reactions.rpy:497
translate russian cassidy_belly_listen_male_5e207716:
    cassidy.say "Эй!"

# ch/cassidy/reactions.rpy:498
translate russian cassidy_belly_listen_male_8ed2e94e:
    cassidy.say "Не смей на меня шикать!"

# ch/cassidy/reactions.rpy:499
translate russian cassidy_belly_listen_male_7cf87a8d:
    cassidy.say "Я не привыкла, чтобы со мной разговаривали таким..."

# ch/cassidy/reactions.rpy:501
translate russian cassidy_belly_listen_male_ef8ff1ae:
    cassidy.say "Погоди... почему ты... ты что..."

# ch/cassidy/reactions.rpy:502
translate russian cassidy_belly_listen_male_297a8969:
    cassidy.say "Ты правда что-то слышишь?"

# ch/cassidy/reactions.rpy:504
translate russian cassidy_belly_listen_male_fa6e7548:
    "Я усердно киваю, уже воодушевлённый тем, что слышу."

# ch/cassidy/reactions.rpy:505
translate russian cassidy_belly_listen_male_5be3c53d:
    mike.say "Ещё как, Кэссиди..."

# ch/cassidy/reactions.rpy:507
translate russian cassidy_belly_listen_male_7d59e320:
    mike.say "Малыш там двигается..."

# ch/cassidy/reactions.rpy:508
translate russian cassidy_belly_listen_male_f53ff239:
    mike.say "Плавает, наверное!"

# ch/cassidy/reactions.rpy:510
translate russian cassidy_belly_listen_male_26d8b15c:
    cassidy.say "Правда?"

# ch/cassidy/reactions.rpy:511
translate russian cassidy_belly_listen_male_5301cbd6:
    cassidy.say "О-о..."

# ch/cassidy/reactions.rpy:513
translate russian cassidy_belly_listen_male_98d941e1:
    cassidy.say "Вот бы и мне это услышать!"

# ch/cassidy/reactions.rpy:514
translate russian cassidy_belly_listen_male_221185db:
    "Я с облегчением замечаю, что Кэссиди тоже проникается этим мгновением."

# ch/cassidy/reactions.rpy:516
translate russian cassidy_belly_listen_male_f95d4276:
    "Отчасти потому, что она наконец перестаёт ко мне придираться."

# ch/cassidy/reactions.rpy:517
translate russian cassidy_belly_listen_male_eec55132:
    "Но больше оттого, что сейчас малыш интересует её сильнее, чем она сама."

# ch/cassidy/reactions.rpy:518
translate russian cassidy_belly_listen_male_9e8f9522:
    "И это вселяет в меня большую надежду на будущее."

# ch/cassidy/talk.rpy:4
translate russian cassidy_talk_love_male_24c0aaa9:
    cassidy.say "Любовь? Кому она нужна? Мне важны развлечения. Если это не весело, оно не стоит моего времени."

# ch/cassidy/talk.rpy:6
translate russian cassidy_talk_love_male_db770c2b:
    cassidy.say "[lssb_cassidy.hero_name()], ты ведь уже бывал влюблён. Что чувствуешь, когда любишь?"

# ch/cassidy/talk.rpy:7
translate russian cassidy_talk_love_male_832231e1:
    mike.say "Это трудно выразить словами."

# ch/cassidy/talk.rpy:9
translate russian cassidy_talk_love_male_95d86e9d:
    cassidy.say "Попробуй."

# ch/cassidy/talk.rpy:11
translate russian cassidy_talk_love_male_c6807aaf:
    cassidy.say "И всё?"

# ch/cassidy/talk.rpy:13
translate russian cassidy_talk_love_male_0111f044:
    mike.say "Ну... когда чужое благополучие волнует тебя не меньше своего, а то и больше. Когда замечаешь какие-то мелочи и хочешь рассказать о них этому человеку."

# ch/cassidy/talk.rpy:14
translate russian cassidy_talk_love_male_67c8152b:
    mike.say "Когда рядом с ним тебе хорошо, а без него — не по себе."

# ch/cassidy/talk.rpy:15
translate russian cassidy_talk_love_male_b2fb8dbd:
    mike.say "Наверное. Не знаю, удалось ли передать это чувство, но лучше я не объясню."

# ch/cassidy/talk.rpy:17
translate russian cassidy_talk_love_male_b252c5b5:
    cassidy.say "О. Я ещё никогда не влюблялась."

# ch/cassidy/talk.rpy:19
translate russian cassidy_talk_love_male_4b08378e:
    mike.say "Это довольно грустно."

# ch/cassidy/talk.rpy:21
translate russian cassidy_talk_love_male_171c8e76:
    cassidy.say "Может быть."

# ch/cassidy/talk.rpy:24
translate russian cassidy_talk_love_male_23450403:
    cassidy.say "Я толком не знаю, что такое любовь, но, кажется, люблю тебя."

# ch/cassidy/talk.rpy:26
translate russian cassidy_talk_love_male_6b942c47:
    cassidy.say "Особенно когда стою на коленях."

# ch/cassidy/talk.rpy:29
translate russian cassidy_talk_love_male_70e3dc64:
    cassidy.say "Особенно когда ты стоишь на коленях."

# ch/cassidy/talk.rpy:32
translate russian cassidy_talk_love_male_c08a95c4:
    cassidy.say "...А теперь появится ещё целый маленький человек, который тоже будет тебя любить. Это страшно, [lssb_cassidy.hero_name()]. Только попробуй меня подвести."

# ch/cassidy/talk.rpy:40
translate russian cassidy_talk_sex_male_2423b9a2:
    cassidy.say "Секс — это то, чем ты занимаешься, когда я велю."

# ch/cassidy/talk.rpy:42
translate russian cassidy_talk_sex_male_0947d7d7:
    mike.say "Да, но вам нравится?"

# ch/cassidy/talk.rpy:45
translate russian cassidy_talk_sex_male_34e51281:
    cassidy.say "Ну, сойдёт. Ты должен стараться лучше."

# ch/cassidy/talk.rpy:47
translate russian cassidy_talk_sex_male_20ef2212:
    mike.say "Ай, это обидно."

# ch/cassidy/talk.rpy:49
translate russian cassidy_talk_sex_male_ff6cee6b:
    cassidy.say "Секс не должен причинять боль! Хотя, может, тебе немного и стоит. Вдруг от этого станет лучше!"

# ch/cassidy/talk.rpy:51
translate russian cassidy_talk_sex_male_44cfaee8:
    mike.say "Пожалуй, мне лучше замолчать."

# ch/cassidy/talk.rpy:53
translate russian cassidy_talk_sex_male_de2c5303:
    cassidy.say "Умный мальчик."

# ch/cassidy/talk.rpy:56
translate russian cassidy_talk_sex_male_35673d50:
    cassidy.say "Что ж, мне нравится кончать у тебя на лице."

# ch/cassidy/talk.rpy:58
translate russian cassidy_talk_sex_male_a13d6c13:
    cassidy.say "Но, думаю, тебе нужно ещё немного практики. Стоит над этим поработать."

# ch/cassidy/talk.rpy:61
translate russian cassidy_talk_sex_male_c467eb3e:
    cassidy.say "Надо признать, от всех этих тренировок ты стал гораздо лучше работать языком. Я уже жду следующего раза!"

# ch/cassidy/talk.rpy:65
translate russian cassidy_talk_sex_male_a6b0a8db:
    cassidy.say "Обожаю обхватывать тебя бёдрами и сжимать, пока ты не кончишь, словно лопнувшая виноградина."

# ch/cassidy/talk.rpy:67
translate russian cassidy_talk_sex_male_f105d9df:
    mike.say "Звучит на удивление непривлекательно для того, что должно быть сексуальным."

# ch/cassidy/talk.rpy:69
translate russian cassidy_talk_sex_male_81ce0a82:
    cassidy.say "Ты сейчас серьёзно сказал, что мои бёдра вокруг тебя — это непривлекательно?!"

# ch/cassidy/talk.rpy:72
translate russian cassidy_talk_sex_male_d9da088d:
    mike.say "Нет, госпожа, я бы никогда такого не сказал!"

# ch/cassidy/talk.rpy:74
translate russian cassidy_talk_sex_male_5b10aaba:
    mike.say "Я... должен признать, мне нравится находиться между ваших бёдер."

# ch/cassidy/talk.rpy:76
translate russian cassidy_talk_sex_male_344dd79e:
    cassidy.say "Хороший мальчик."

# ch/cassidy/talk.rpy:81
translate russian cassidy_talk_sex_male_c5890a6e:
    cassidy.say "Раньше мне нравился секс."

# ch/cassidy/talk.rpy:83
translate russian cassidy_talk_sex_male_66fea4b0:
    mike.say "Да? И что случилось?"

# ch/cassidy/talk.rpy:85
translate russian cassidy_talk_sex_male_cd1e4a1b:
    cassidy.say "Ты."

# ch/cassidy/talk.rpy:87
translate russian cassidy_talk_sex_male_96911f2e:
    mike.say "Вини только себя."

# ch/cassidy/talk.rpy:89
translate russian cassidy_talk_sex_male_c4777e94:
    "Кэссиди вздыхает."

# ch/cassidy/talk.rpy:92
translate russian cassidy_talk_sex_male_9c1da443:
    cassidy.say "Раньше во время секса я предпочитала быть сверху."

# ch/cassidy/talk.rpy:94
translate russian cassidy_talk_sex_male_07b72922:
    mike.say "Раньше? А теперь?"

# ch/cassidy/talk.rpy:97
translate russian cassidy_talk_sex_male_277201c7:
    cassidy.say "По-прежнему предпочитаю быть сверху."

# ch/cassidy/talk.rpy:100
translate russian cassidy_talk_sex_male_326ec6ba:
    cassidy.say "Ты показал мне, что снизу тоже неплохо."

# ch/cassidy/talk.rpy:103
translate russian cassidy_talk_sex_male_56012c20:
    cassidy.say "Когда-то секс был для меня просто способом скоротать время."

# ch/cassidy/talk.rpy:105
translate russian cassidy_talk_sex_male_57573cb1:
    mike.say "Что-то изменилось?"

# ch/cassidy/talk.rpy:107
translate russian cassidy_talk_sex_male_136dd044:
    cassidy.say "Ну, я всё ещё хочу заниматься с тобой сексом, так что, наверное, изменилось."

# ch/cassidy/talk.rpy:109
translate russian cassidy_talk_sex_male_59d39e29:
    cassidy.say "Ещё бы. Посмотри, к чему привело наше коротание времени, [lssb_cassidy.hero_name()]. Я бы сказала, что пора сбавить темп, но... нет."

# ch/cassidy/talk.rpy:111
translate russian cassidy_talk_sex_male_02a5bf69:
    mike.say "Это даже мило, хоть и странно."

# ch/cassidy/talk.rpy:115
translate russian cassidy_talk_sex_male_22997d9d:
    cassidy.say "О, уже пытаешься залезть ко мне в трусики?"

# ch/cassidy/talk.rpy:117
translate russian cassidy_talk_sex_male_316c3cf7:
    mike.say "Нет, я просто хотел узнать, что ты об этом думаешь. Что тебе нравится?"

# ch/cassidy/talk.rpy:119
translate russian cassidy_talk_sex_male_2b2e0025:
    cassidy.say "Мне положено знать, а тебе — оставаться в неведении."

# ch/cassidy/talk.rpy:121
translate russian cassidy_talk_sex_male_58187c09:
    "Она ненадолго замолкает и косится на меня."

# ch/cassidy/talk.rpy:123
translate russian cassidy_talk_sex_male_035d7c81:
    cassidy.say "Хотя, может, и узнаешь. Но для этого придётся встать на колени."

# ch/cassidy/talk.rpy:132
translate russian cassidy_talk_politics_male_8b6b2c19:
    cassidy.say "На прошлой неделе мы с мачехой ужинали у нас дома с нашим сенатором."

# ch/cassidy/talk.rpy:134
translate russian cassidy_talk_politics_male_68a41530:
    cassidy.say "На прошлой неделе мы с папочкой и мачехой ужинали у нас дома с нашим сенатором."

# ch/cassidy/talk.rpy:135
translate russian cassidy_talk_politics_male_c5dfe9b2:
    mike.say "Ничего себе, ты часто ужинаешь с сенаторами?"

# ch/cassidy/talk.rpy:137
translate russian cassidy_talk_politics_male_a294b5b0:
    cassidy.say "Ну, раз в несколько месяцев, наверное? Мачеха делает крупные пожертвования на его кампанию."

# ch/cassidy/talk.rpy:139
translate russian cassidy_talk_politics_male_71959b94:
    cassidy.say "Ну, раз в несколько месяцев, наверное? Папочка делает крупные пожертвования на его кампанию."

# ch/cassidy/talk.rpy:141
translate russian cassidy_talk_politics_male_99e2dd0f:
    mike.say "И какой он?"

# ch/cassidy/talk.rpy:143
translate russian cassidy_talk_politics_male_7fdca80d:
    cassidy.say "Скучный. Даже не посмотрел, когда я ему грудь показала. Хотя, может, потому, что рядом сидела жена."

# ch/cassidy/talk.rpy:145
translate russian cassidy_talk_politics_male_fa29c598:
    mike.say "Погоди, ему же вроде лет семьдесят?"

# ch/cassidy/talk.rpy:147
translate russian cassidy_talk_politics_male_83349c73:
    cassidy.say "И что?"

# ch/cassidy/talk.rpy:149
translate russian cassidy_talk_politics_male_927d0e19:
    mike.say "Фу! Хочешь, чтобы на тебя пускал слюни старый похабник?"

# ch/cassidy/talk.rpy:151
translate russian cassidy_talk_politics_male_bfdde940:
    cassidy.say "Старый похабник, который к тому же сенатор? О да, влиятельные мужчины сексуальны! Он, конечно, не Шон Коннери, но в своей скользкой манере всё равно ничего."

# ch/cassidy/talk.rpy:155
translate russian cassidy_talk_politics_male_3e3b2b0f:
    cassidy.say "Не дуйся, [lssb_cassidy.hero_name()]. Ты единственный мужчина, чьё слюнотечение мне нужно. Сенатору достаётся только зрелище."

# ch/cassidy/talk.rpy:157
translate russian cassidy_talk_politics_male_c1bb1347:
    cassidy.say "Тебе-то какое дело, кому я показываю грудь? Займись своей скучной жизнью."

# ch/cassidy/talk.rpy:163
translate russian cassidy_talk_food_male_078d8d59:
    cassidy.say "В каких ресторанах с тремя звёздами Мишлен ты бывал?"

# ch/cassidy/talk.rpy:165
translate russian cassidy_talk_food_male_7d540191:
    mike.say "Что это?"

# ch/cassidy/talk.rpy:167
translate russian cassidy_talk_food_male_4c2808b4:
    cassidy.say "Ты не знаешь, что такое звёзды Мишлен?"

# ch/cassidy/talk.rpy:169
translate russian cassidy_talk_food_male_7683e53c:
    mike.say "Они разве не шины делают или что-то такое?"

# ch/cassidy/talk.rpy:171
translate russian cassidy_talk_food_male_d353c814:
    cassidy.say "Нет... то есть, может, и делают, но ещё оценивают рестораны. Даже одну звезду получают только лучшие в мире. А трёхзвёздочных всего около сотни."

# ch/cassidy/talk.rpy:173
translate russian cassidy_talk_food_male_286af37e:
    mike.say "А-а, шикарно. Наверняка все дорогие."

# ch/cassidy/talk.rpy:175
translate russian cassidy_talk_food_male_4ab9f2b3:
    cassidy.say "Ой, не знаю. Может быть? Я не особо обращаю внимание на такие вещи."

# ch/cassidy/talk.rpy:177
translate russian cassidy_talk_food_male_563d9fe2:
    mike.say "Наверное, это приятно. Так в каких трёхзвёздочных ресторанах ты была?"

# ch/cassidy/talk.rpy:179
translate russian cassidy_talk_food_male_8bef2372:
    cassidy.say "Примерно в пятидесяти, кажется."

# ch/cassidy/talk.rpy:181
translate russian cassidy_talk_food_male_47cc0e99:
    cassidy.say "Хотя сейчас мне хочется только солёных огурцов и молочного коктейля в два часа ночи. Твой ребёнок совсем испортил мне вкус, [lssb_cassidy.hero_name()]."

# ch/cassidy/talk.rpy:183
translate russian cassidy_talk_food_male_f5ec8d28:
    cassidy.say "Вообще-то нам стоит сходить вместе. Хочу посмотреть, как ты будешь выговаривать названия из меню. И хочу видеть тебя напротив, [lssb_cassidy.hero_name()]. В основном это."

# ch/cassidy/talk.rpy:187
translate russian cassidy_talk_food_male_bd16197c:
    mike.say "Может, как-нибудь сводишь меня в один из них?"

# ch/cassidy/talk.rpy:189
translate russian cassidy_talk_food_male_ec39c29e:
    cassidy.say "А ты вообще сумеешь оценить такую еду?"

# ch/cassidy/talk.rpy:191
translate russian cassidy_talk_food_male_bfdfda70:
    mike.say "Ещё как! Я люблю вкусно поесть. Просто такие места слишком дорогие."

# ch/cassidy/talk.rpy:193
translate russian cassidy_talk_food_male_dc21e726:
    cassidy.say "Что ж, возможно, свожу."

# ch/cassidy/talk.rpy:197
translate russian cassidy_talk_food_male_228ddd2c:
    mike.say "Если там есть хороший стейк, я за."

# ch/cassidy/talk.rpy:199
translate russian cassidy_talk_food_male_67d6adad:
    cassidy.say "Тогда ответ — нет."

# ch/cassidy/talk.rpy:202
translate russian cassidy_talk_food_male_97d43126:
    mike.say "Я не любитель таких роскошных мест. Туда, наверное, без пиджака и галстука даже не войти."

# ch/cassidy/talk.rpy:204
translate russian cassidy_talk_food_male_0b8f4e7b:
    cassidy.say "Ну да, у них есть требования. Тебя бы, наверное, и не пустили."

# ch/cassidy/talk.rpy:211
translate russian cassidy_talk_travels_male_bd582e66:
    cassidy.say "Так где ты бывал, [lssb_cassidy.hero_name()]?"

# ch/cassidy/talk.rpy:213
translate russian cassidy_talk_travels_male_cf8f8015:
    mike.say "Эм. В основном здесь."

# ch/cassidy/talk.rpy:215
translate russian cassidy_talk_travels_male_fcd4ad6a:
    cassidy.say "Ты когда-нибудь был в Кот-д’Ивуаре?"

# ch/cassidy/talk.rpy:217
translate russian cassidy_talk_travels_male_4913ba68:
    mike.say "Где?"

# ch/cassidy/talk.rpy:219
translate russian cassidy_talk_travels_male_5ac105e7:
    cassidy.say "Значит, нет. А в Новой Зеландии?"

# ch/cassidy/talk.rpy:221
translate russian cassidy_talk_travels_male_784d34c2:
    mike.say "Ну, о Новой Зеландии я хотя бы слышал."

# ch/cassidy/talk.rpy:223
translate russian cassidy_talk_travels_male_b203a373:
    cassidy.say "А на Багамах?"

# ch/cassidy/talk.rpy:225
translate russian cassidy_talk_travels_male_ac503dbf:
    mike.say "Тоже нет."

# ch/cassidy/talk.rpy:227
translate russian cassidy_talk_travels_male_fe314c42:
    cassidy.say "Эм. В Аргентине?"

# ch/cassidy/talk.rpy:229
translate russian cassidy_talk_travels_male_bc765863:
    mike.say "Не-а."

# ch/cassidy/talk.rpy:231
translate russian cassidy_talk_travels_male_b40e7e21:
    cassidy.say "Ты вообще хоть где-нибудь был?"

# ch/cassidy/talk.rpy:233
translate russian cassidy_talk_travels_male_dac546c6:
    mike.say "Во Франции. Один раз."

# ch/cassidy/talk.rpy:236
translate russian cassidy_talk_travels_male_a5c5c4aa:
    cassidy.say "Во Франции, один раз. Как мило. Что ж, теперь увидишь мир, [lssb_cassidy.hero_name()]. Мне нужен камердинер, который за мной поспеет. Начинай читать путеводители."

# ch/cassidy/talk.rpy:239
translate russian cassidy_talk_travels_male_f27b6b08:
    cassidy.say "Во Франции, один раз. Ох, [lssb_cassidy.hero_name()]. Ладно, я это исправлю. Собирай сумку: я везу тебя туда, где есть пляж и никто нас не знает."

# ch/cassidy/talk.rpy:243
translate russian cassidy_talk_travels_male_be3d852b:
    cassidy.say "Тебе нужно больше путешествовать."

# ch/cassidy/talk.rpy:251
translate russian cassidy_talk_tv_male_baab8d2e:
    cassidy.say "В четырнадцать лет я пробовалась в один из подростковых музыкальных сериалов. Его описывали как что-то вроде «Остина и Элли»."

# ch/cassidy/talk.rpy:253
translate russian cassidy_talk_tv_male_1ddfb838:
    mike.say "Эм, никогда о нём не слышал."

# ch/cassidy/talk.rpy:255
translate russian cassidy_talk_tv_male_b9952636:
    cassidy.say "Ну, вроде «Ханны Монтаны»?"

# ch/cassidy/talk.rpy:257
translate russian cassidy_talk_tv_male_ae548a1c:
    mike.say "Да, о ней слышал. Ну и... необычной она выросла."

# ch/cassidy/talk.rpy:259
translate russian cassidy_talk_tv_male_b66904b4:
    cassidy.say "Она неплохо устроилась."

# ch/cassidy/talk.rpy:261
translate russian cassidy_talk_tv_male_db63a288:
    mike.say "И как прошло твоё прослушивание?"

# ch/cassidy/talk.rpy:263
translate russian cassidy_talk_tv_male_2dbc1236:
    cassidy.say "Кастинг-директор сказал, что я пою как кошка, которую душат скрипкой."

# ch/cassidy/talk.rpy:265
translate russian cassidy_talk_tv_male_379f49a2:
    mike.say "Ого, жестоко."

# ch/cassidy/talk.rpy:267
translate russian cassidy_talk_tv_male_d49a480b:
    cassidy.say "Так что я попросила папочку добиться его увольнения. Весь сериал закрыли ещё до съёмок пилотной серии."

# ch/cassidy/talk.rpy:269
translate russian cassidy_talk_tv_male_2c8eaf82:
    mike.say "Ни хрена себе!"

# ch/cassidy/talk.rpy:270
translate russian cassidy_talk_tv_male_75e1716d:
    "Кэссиди улыбается мне с недобрым блеском в глазах."

# ch/cassidy/talk.rpy:273
translate russian cassidy_talk_tv_male_c918a2dc:
    cassidy.say "Не смотри на меня так, [lssb_cassidy.hero_name()]. Он заслужил."

# ch/cassidy/talk.rpy:274
translate russian cassidy_talk_tv_male_f1fa14a7:
    cassidy.say "...Но было обидно. Я очень хотела эту дурацкую роль. Обычно я никому об этом не рассказываю."

# ch/cassidy/talk.rpy:281
translate russian cassidy_talk_sports_male_ca6d4338:
    cassidy.say "Я не особо люблю спорт."

# ch/cassidy/talk.rpy:283
translate russian cassidy_talk_sports_male_62942136:
    cassidy.say "А вот спортсменов люблю. Особенно крупных мускулистых темнокожих спортсменов с большими членами."

# ch/cassidy/talk.rpy:285
translate russian cassidy_talk_sports_male_e9cef975:
    mike.say "Ого, это уже лишние подробности!"

# ch/cassidy/talk.rpy:286
translate russian cassidy_talk_sports_male_342f4ce6:
    "Кэссиди пожимает плечами."

# ch/cassidy/talk.rpy:289
translate russian cassidy_talk_sports_male_e0d916d1:
    cassidy.say "Ой, расслабься, [lssb_cassidy.hero_name()]. Это мой типаж, а не список покупок. Рядом с собой я ведь держу тебя, правда?"

# ch/cassidy/talk.rpy:292
translate russian cassidy_talk_sports_male_89506a40:
    cassidy.say "Что? Сам спросил. Я не собираюсь врать ради твоих нежных чувств."

# ch/cassidy/talk.rpy:299
translate russian cassidy_talk_fashion_male_bd0a455b:
    cassidy.say "Обожаю ходить по магазинам! Столько милых и красивых вещей. Найти то, чего больше никто не носит, — тяжёлый труд. Но оно того стоит!"

# ch/cassidy/talk.rpy:301
translate russian cassidy_talk_fashion_male_26c42300:
    cassidy.say "Хотя сейчас на меня ничего не лезет, а всё подходящее похоже на палатку. Ты представляешь, как трудно выглядеть так хорошо, будучи размером с дом, [lssb_cassidy.hero_name()]? Я просто гений."

# ch/cassidy/talk.rpy:302
translate russian cassidy_talk_fashion_male_40ce7547:
    cassidy.say "Любишь ходить по магазинам, [lssb_cassidy.hero_name()]?"

# ch/cassidy/talk.rpy:304
translate russian cassidy_talk_fashion_male_7dfeb79c:
    mike.say "Нет."

# ch/cassidy/talk.rpy:306
translate russian cassidy_talk_fashion_male_bdfe8a13:
    cassidy.say "Почему?"

# ch/cassidy/talk.rpy:308
translate russian cassidy_talk_fashion_male_b96a8260:
    mike.say "Мне не хватает терпения рассматривать каждую мелочь. Хочу просто зайти, взять нужное и уйти."

# ch/cassidy/talk.rpy:310
translate russian cassidy_talk_fashion_male_5abb4597:
    cassidy.say "Неудивительно, что ты так одеваешься."

# ch/cassidy/talk.rpy:312
translate russian cassidy_talk_fashion_male_f22133c9:
    mike.say "Как — так?"

# ch/cassidy/talk.rpy:313
translate russian cassidy_talk_fashion_male_0b4ed981:
    "Она небрежно машет в мою сторону, примерно указывая на рубашку."

# ch/cassidy/talk.rpy:315
translate russian cassidy_talk_fashion_male_f975ebcc:
    cassidy.say "Вот ТАК!"

# ch/cassidy/talk.rpy:317
translate russian cassidy_talk_fashion_male_9ff4486e:
    mike.say "Эм. Но мне нравится, как я одеваюсь."

# ch/cassidy/talk.rpy:319
translate russian cassidy_talk_fashion_male_9e69914c:
    cassidy.say "Да, придётся это изменить."

# ch/cassidy/talk.rpy:321
translate russian cassidy_talk_fashion_male_e893c5a3:
    mike.say "Что-что?"

# ch/cassidy/talk.rpy:324
translate russian cassidy_talk_fashion_male_a1434194:
    cassidy.say "Будешь носить мои пакеты и примерять всё, на что я укажу. Считай это частью своих обязанностей, [lssb_cassidy.hero_name()]. А эту рубашку мы точно сожжём."

# ch/cassidy/talk.rpy:327
translate russian cassidy_talk_fashion_male_5b6bebd7:
    cassidy.say "Своди меня по магазинам. Носи мои пакеты, говори, какая я красивая, и, если будешь очень хорошим, разрешу выбрать одну вещь, которую надену дома только для тебя, [lssb_cassidy.hero_name()]."

# ch/cassidy/talk.rpy:329
translate russian cassidy_talk_fashion_male_65463475:
    cassidy.say "Давай как-нибудь пройдёмся по магазинам. Скажешь, какая милая вещица мне идёт больше всего, а я помогу тебе подобрать что-нибудь, чтобы ты меньше напоминал... бомжа."

# ch/cassidy/talk.rpy:333
translate russian cassidy_talk_fashion_male_4f646c6c:
    mike.say "Конечно, звучит как много-много часов веселья."

# ch/cassidy/talk.rpy:335
translate russian cassidy_talk_fashion_male_0b2cc6c2:
    cassidy.say "Замечательно!"

# ch/cassidy/talk.rpy:338
translate russian cassidy_talk_fashion_male_7344ff00:
    mike.say "Ни за что! Я наверняка усну."

# ch/cassidy/talk.rpy:340
translate russian cassidy_talk_fashion_male_d0ee9aee:
    cassidy.say "Сам виноват."

# ch/cassidy/talk.rpy:348
translate russian cassidy_talk_books_male_b61952c7:
    cassidy.say "Книги? Скорее журналы. В журналах бывает очень красивая одежда."

# ch/cassidy/talk.rpy:350
translate russian cassidy_talk_books_male_1b369751:
    mike.say "Что, ты не читаешь?"

# ch/cassidy/talk.rpy:352
translate russian cassidy_talk_books_male_c78ae3ea:
    cassidy.say "Читаю! Я читаю! Читаю... журналы. И, эм... всякое."

# ch/cassidy/talk.rpy:355
translate russian cassidy_talk_books_male_1d4e603d:
    cassidy.say "Ой, не ухмыляйся, [lssb_cassidy.hero_name()]. Почитай мне как-нибудь, и, может, я передумаю. Что-нибудь с принцем."

# ch/cassidy/talk.rpy:358
translate russian cassidy_talk_books_male_fce4f3fe:
    cassidy.say "Чего ты на меня так смотришь? Читают те, кому больше нечем заняться."

# ch/cassidy/talk.rpy:365
translate russian cassidy_talk_people_male_a43384b7:
    cassidy.say "Большинство людей только мешают. Обошлась бы и без них. Кроме тех, кто нас возит и следит за домом. Ну и мачехи, конечно."

# ch/cassidy/talk.rpy:367
translate russian cassidy_talk_people_male_3e8db9f2:
    cassidy.say "Большинство людей только мешают. Обошлась бы и без них. Кроме тех, кто нас возит и следит за домом. Ну и папочки, конечно."

# ch/cassidy/talk.rpy:369
translate russian cassidy_talk_people_male_81895705:
    cassidy.say "И вот этого, пожалуй."

# ch/cassidy/talk.rpy:371
translate russian cassidy_talk_people_male_b5983656:
    "Она кладёт руку на живот, словно сама не замечает этого движения."

# ch/cassidy/talk.rpy:373
translate russian cassidy_talk_people_male_66415d37:
    cassidy.say "Ещё ничего не сделал, а уже попал в этот очень короткий список. Никому не говори, что я это сказала, [lssb_cassidy.hero_name()]."

# ch/cassidy/talk.rpy:375
translate russian cassidy_talk_people_male_822ce310:
    cassidy.say "И ты, разумеется. Не заставляй повторять."

# ch/cassidy/talk.rpy:377
translate russian cassidy_talk_people_male_10ccd56e:
    cassidy.say "А все остальные пусть ищут другой дом, где смогут пригодиться."

# ch/cassidy/talk.rpy:383
translate russian cassidy_talk_computers_male_3daccc25:
    cassidy.say "Единственный компьютер, которым я пользуюсь, — мой телефон."

# ch/cassidy/talk.rpy:385
translate russian cassidy_talk_computers_male_193532b3:
    mike.say "В наше время это тоже считается компьютером."

# ch/cassidy/talk.rpy:387
translate russian cassidy_talk_computers_male_84f763c9:
    cassidy.say "О, тогда я, наверное, неплохо разбираюсь в компьютерах. По крайней мере, если речь о соцсетях."

# ch/cassidy/talk.rpy:389
translate russian cassidy_talk_computers_male_5e266ed9:
    cassidy.say "Видел бы ты, сколько у меня подписчиков, [lssb_cassidy.hero_name()]. Хотя в последнее время я в основном делаю скриншоты, чтобы отправлять тебе. Перестань улыбаться."

# ch/cassidy/talk.rpy:391
translate russian cassidy_talk_computers_male_677c1baf:
    cassidy.say "Хотя вряд ли ты в этом хоть что-то понимаешь."

# ch/cassidy/talk.rpy:398
translate russian cassidy_talk_music_male_eb58e240:
    mike.say "Так какую музыку ты любишь, Кэссиди?"

# ch/cassidy/talk.rpy:400
translate russian cassidy_talk_music_male_ce94b9e5:
    cassidy.say "Мама любила Бродвей, песни из мюзиклов и всё такое. Кое-что очень хорошее. Но я люблю хип-хоп и танцевальную музыку."

# ch/cassidy/talk.rpy:401
translate russian cassidy_talk_music_male_8ad598ac:
    cassidy.say "Обожаю ходить в клуб и находить, с кем потанцевать. А дальше — как пойдёт."

# ch/cassidy/talk.rpy:403
translate russian cassidy_talk_music_male_ae6d664f:
    cassidy.say "Ну, раньше обожала. Никто не хочет тереться о девушку, прячущую под одеждой пляжный мяч, [lssb_cassidy.hero_name()]. Теперь клуб приходит ко мне: ты, хорошие колонки и никаких каблуков."

# ch/cassidy/talk.rpy:407
translate russian cassidy_talk_music_male_c6aaf540:
    mike.say "И кто-нибудь в последнее время тебе там приглянулся?"

# ch/cassidy/talk.rpy:409
translate russian cassidy_talk_music_male_22306a20:
    cassidy.say "М-м-м. На прошлой неделе была одна девушка. Красотка, конечно, иначе я бы и взгляда на неё не потратила."

# ch/cassidy/talk.rpy:410
translate russian cassidy_talk_music_male_d4e49246:
    cassidy.say "Я позволила ей покупать мне выпивку и танцевать слишком близко. Смазливая милашка может обожать меня не хуже любого мужчины, [lssb_cassidy.hero_name()]."

# ch/cassidy/talk.rpy:414
translate russian cassidy_talk_music_male_1179294d:
    mike.say "Но тебя ведь там интересуют только парни, да?"

# ch/cassidy/talk.rpy:416
translate russian cassidy_talk_music_male_d65ec090:
    cassidy.say "Да брось, [lssb_cassidy.hero_name()]. Я не целуюсь с подружками взасос ради чьей-то телефонной камеры."

# ch/cassidy/talk.rpy:417
translate russian cassidy_talk_music_male_d06bf813:
    cassidy.say "Если уж я перед кем-то и унижусь, то перед настоящим мужчиной."

# ch/cassidy/talk.rpy:425
translate russian cassidy_talk_birthday_male_5d5f2ba6:
    mike.say "С днём рождения, Кэссиди!"

# ch/cassidy/talk.rpy:427
translate russian cassidy_talk_birthday_male_f8a9b6f8:
    cassidy.say "Что ты мне подаришь?!"

# ch/cassidy/talk.rpy:429
translate russian cassidy_talk_birthday_male_fff182cc:
    "Вот чёрт. А ЧТО я ей приготовил? Нужно срочно выкручиваться!"

# ch/cassidy/talk.rpy:430
translate russian cassidy_talk_birthday_male_386e02f9:
    mike.say "Это сюрприз!"

# ch/cassidy/talk.rpy:433
translate russian cassidy_talk_birthday_male_59bcafaa:
    cassidy.say "Надеюсь, хороший! И никакого детского барахла. Сегодня МОЙ день, [lssb_cassidy.hero_name()]. У малыша свой день рождения будет позже, и тогда я тоже собираюсь обойти тебя по подаркам."

# ch/cassidy/talk.rpy:436
translate russian cassidy_talk_birthday_male_835feb70:
    cassidy.say "Надеюсь, хороший! ...Хотя, знаешь? Ты вспомнил. Уже это очень приятно."

# ch/cassidy/talk.rpy:438
translate russian cassidy_talk_birthday_male_a604508c:
    cassidy.say "Надеюсь, хороший! У меня очень высокие требования и очень долгая память."

# ch/cassidy/talk.rpy:487
translate russian submissive_interact_cassidy_male_abbf69ea:
    mike.say "Эй, Кэссиди..."

# ch/cassidy/talk.rpy:488
translate russian submissive_interact_cassidy_male_e3b61145:
    mike.say "Тебе ведь нравится целоваться со мной по-французски?"

# ch/cassidy/talk.rpy:490
translate russian submissive_interact_cassidy_male_81d8e55f:
    cassidy.say "Ну да, [lssb_cassidy.hero_name()]."

# ch/cassidy/talk.rpy:491
translate russian submissive_interact_cassidy_male_06f343da:
    cassidy.say "Конечно, нравится!"

# ch/cassidy/talk.rpy:493
translate russian submissive_interact_cassidy_male_9ef07c38:
    mike.say "Тогда почему бы тебе не говорить об этом при каждой встрече?"

# ch/cassidy/talk.rpy:494
translate russian submissive_interact_cassidy_male_a8776e2b:
    mike.say "Можешь даже сказать, как тебе нравится, когда я целую ВСЕ твои губки."

# ch/cassidy/talk.rpy:497
translate russian submissive_interact_cassidy_male_503a275f:
    cassidy.say "Если ты действительно этого хочешь."

# ch/cassidy/talk.rpy:498
translate russian submissive_interact_cassidy_male_000cafd6:
    cassidy.say "Конечно, я, наверное, что-нибудь придумаю."

# ch/cassidy/talk.rpy:499
translate russian submissive_interact_cassidy_male_c086cca9:
    cassidy.say "Всё, лишь бы ты был счастлив, [lssb_cassidy.hero_name()]!"

# ch/cassidy/talk.rpy:503
translate russian submissive_interact_cassidy_male_e1ff51b7:
    cassidy.say "Ты, должно быть, шутишь, [lssb_cassidy.hero_name()]!"

# ch/cassidy/talk.rpy:504
translate russian submissive_interact_cassidy_male_45d10bd2:
    cassidy.say "Я бы никогда не смогла сказать такое."

# ch/cassidy/talk.rpy:506
translate russian submissive_interact_cassidy_male_f70b57e0:
    mike.say "Да, Кэссиди, ты меня раскусила."

# ch/cassidy/talk.rpy:507
translate russian submissive_interact_cassidy_male_d9691781:
    mike.say "Я просто пошутил..."

# ch/cassidy/texts.rpy:8
translate russian cassidy_friendly_texts_c88d7f98:
    cassidy_nvl "Твой ребёнок только что меня пнул. Сильно. Пока я пыталась подремать."

# ch/cassidy/texts.rpy:9
translate russian cassidy_friendly_texts_c10ee955:
    cassidy_nvl "Разумеется, во всём этом я виню тебя."

# ch/cassidy/texts.rpy:10
translate russian cassidy_friendly_texts_12cb71d3:
    cassidy_nvl "...Но приходи потрогать. Это довольно невероятно."

# ch/cassidy/texts.rpy:12
translate russian cassidy_friendly_texts_c8a24328:
    cassidy_nvl "Сегодня я опять всё переставила в детской."

# ch/cassidy/texts.rpy:13
translate russian cassidy_friendly_texts_0fb02e39:
    cassidy_nvl "Раньше тоже было нормально. Просто появились силы. Не проси объяснять."

# ch/cassidy/texts.rpy:14
translate russian cassidy_friendly_texts_26641448:
    cassidy_nvl "Видимо, инстинкт гнездования. Уф. Я превращаюсь в человека, который вьёт гнездо."

# ch/cassidy/texts.rpy:20
translate russian cassidy_friendly_texts_eef3d165:
    cassidy_nvl "Мне скучно, и исправить это — твоя работа."

# ch/cassidy/texts.rpy:21
translate russian cassidy_friendly_texts_a72c551e:
    cassidy_nvl "Бросай всё, чем занят. Всё равно ничего важного."

# ch/cassidy/texts.rpy:22
translate russian cassidy_friendly_texts_aa227464:
    cassidy_nvl "Это не просьба, если ты вдруг не понял."

# ch/cassidy/texts.rpy:24
translate russian cassidy_friendly_texts_fc88359f:
    cassidy_nvl "Всё представляю, как ты стоишь на коленях у моего дивана и обмахиваешь меня журналом."

# ch/cassidy/texts.rpy:25
translate russian cassidy_friendly_texts_4df4f7a5:
    cassidy_nvl "Ты бы выглядел очаровательно."

# ch/cassidy/texts.rpy:26
translate russian cassidy_friendly_texts_4366566d:
    cassidy_nvl "Так что приезжай и докажи, что я права."

# ch/cassidy/texts.rpy:32
translate russian cassidy_friendly_texts_48935598:
    cassidy_nvl "Эй, почему ты до сих пор не ответил?!"

# ch/cassidy/texts.rpy:33
translate russian cassidy_friendly_texts_402575ef:
    cassidy_nvl "Ладно, признаю. Я правда скучаю, когда ты молчишь."

# ch/cassidy/texts.rpy:34
translate russian cassidy_friendly_texts_c06f74b5:
    cassidy_nvl "Вот. Сказала. Теперь ответь, пока я не передумала."

# ch/cassidy/texts.rpy:36
translate russian cassidy_friendly_texts_a861c3d1:
    cassidy_nvl "Эй, когда ты уже ответишь на мои сообщения?!"

# ch/cassidy/texts.rpy:37
translate russian cassidy_friendly_texts_bcb14848:
    cassidy_nvl "Не то чтобы я отчаянно ждала весточки от тебя..."

# ch/cassidy/texts.rpy:38
translate russian cassidy_friendly_texts_998d79ae:
    cassidy_nvl "Просто отвечать — это вежливо, знаешь ли."

# ch/cassidy/texts.rpy:40
translate russian cassidy_friendly_texts_4304c9a5:
    cassidy_nvl "Я отлично провела время на нашем недавнем свидании."

# ch/cassidy/texts.rpy:41
translate russian cassidy_friendly_texts_3ceea081:
    cassidy_nvl "С тобой я почувствовала себя особенной!"

# ch/cassidy/texts.rpy:42
translate russian cassidy_friendly_texts_537d21da:
    cassidy_nvl "Не терпится снова тебя увидеть!"

# ch/cassidy/texts.rpy:45
translate russian cassidy_friendly_texts_4893ecb9:
    cassidy_nvl "Я всё время о тебе думаю. Постоянно. Честно говоря, это раздражает."

# ch/cassidy/texts.rpy:46
translate russian cassidy_friendly_texts_b8ac1b98:
    cassidy_nvl "Раньше я всё время думала о СЕБЕ. А теперь о тебе."

# ch/cassidy/texts.rpy:47
translate russian cassidy_friendly_texts_8ef173b7:
    cassidy_nvl "Посмотри, что ты со мной сделал, [lssb_cassidy.hero_name()]."

# ch/cassidy/texts.rpy:49
translate russian cassidy_friendly_texts_ff4c483b:
    cassidy_nvl "Ты часто обо мне думаешь?"

# ch/cassidy/texts.rpy:50
translate russian cassidy_friendly_texts_9e0a4225:
    cassidy_nvl "Потому что странно: я всё время думаю о тебе!"

# ch/cassidy/texts.rpy:51
translate russian cassidy_friendly_texts_fd88917d:
    cassidy_nvl "И не знаю почему..."

# ch/cassidy/texts.rpy:61
translate russian cassidy_flirty_texts_70523328:
    cassidy_nvl "Ни одна из моих милых вещичек больше не налезает, и это целиком твоя вина."

# ch/cassidy/texts.rpy:62
translate russian cassidy_flirty_texts_671ad027:
    cassidy_nvl "Но видел бы ты меня сейчас совсем без одежды..."

# ch/cassidy/texts.rpy:63
translate russian cassidy_flirty_texts_1d4e6fe5:
    cassidy_nvl "Оказывается, я всё ещё прекрасно знаю, как привлечь твоё внимание."

# ch/cassidy/texts.rpy:65
translate russian cassidy_flirty_texts_3b59415d:
    cassidy_nvl "Это странно, что на таком сроке беременности я стала ненасытной?"

# ch/cassidy/texts.rpy:66
translate russian cassidy_flirty_texts_f12e7a3e:
    cassidy_nvl "Потому что хочу видеть тебя здесь немедленно, [lssb_cassidy.hero_name()]."

# ch/cassidy/texts.rpy:67
translate russian cassidy_flirty_texts_a66c2d89:
    cassidy_nvl "Гормоны. Вини гормоны. А потом садись в машину."

# ch/cassidy/texts.rpy:73
translate russian cassidy_flirty_texts_241cec04:
    cassidy_nvl "Я уже решила, что именно заставлю тебя делать со мной позже."

# ch/cassidy/texts.rpy:74
translate russian cassidy_flirty_texts_7a806aeb:
    cassidy_nvl "Твоё мнение не спрашивают. От тебя требуется только сказать спасибо."

# ch/cassidy/texts.rpy:75
translate russian cassidy_flirty_texts_10e0cbd4:
    cassidy_nvl "К моему приходу будь готов и стой на коленях."

# ch/cassidy/texts.rpy:77
translate russian cassidy_flirty_texts_afdc696a:
    cassidy_nvl "На мне кое-что, от чего ты бы совсем потерял голову."

# ch/cassidy/texts.rpy:78
translate russian cassidy_flirty_texts_83c87634:
    cassidy_nvl "Но трогать нельзя, пока я не разрешу."

# ch/cassidy/texts.rpy:79
translate russian cassidy_flirty_texts_288e0e65:
    cassidy_nvl "В этом и удовольствие. Для меня, по крайней мере."

# ch/cassidy/texts.rpy:84
translate russian cassidy_flirty_texts_281b6867:
    cassidy_nvl "Привет, выбираю наряд для нашего следующего свидания."

# ch/cassidy/texts.rpy:85
translate russian cassidy_flirty_texts_5ee73a9c:
    cassidy_nvl "Думала для разнообразия одеться позакрытее..."

# ch/cassidy/texts.rpy:86
translate russian cassidy_flirty_texts_52a6e171:
    cassidy_nvl "Шучу! Оголюсь ещё сильнее, чем в прошлый раз!"

# ch/cassidy/texts.rpy:88
translate russian cassidy_flirty_texts_d608f745:
    cassidy_nvl "Хочу получить максимум острых ощущений при следующей встрече."

# ch/cassidy/texts.rpy:89
translate russian cassidy_flirty_texts_c5638235:
    cassidy_nvl "Поэтому придумываю самые порочные вещи, которыми мы можем заняться."

# ch/cassidy/texts.rpy:90
translate russian cassidy_flirty_texts_da4c0606:
    cassidy_nvl "Такие, от которых родители умерли бы, если бы узнали!"

# ch/cassidy/texts.rpy:93
translate russian cassidy_flirty_texts_cd0c81b4:
    cassidy_nvl "Я так скучаю по тебе, что даже неловко."

# ch/cassidy/texts.rpy:94
translate russian cassidy_flirty_texts_90ec386c:
    cassidy_nvl "Хочу чувствовать твои руки на всём теле и тебя внутри..."

# ch/cassidy/texts.rpy:95
translate russian cassidy_flirty_texts_e9bab2a3:
    cassidy_nvl "А потом хочу, чтобы ты просто остался. Странно, да? Всё равно приезжай."

# ch/cassidy/texts.rpy:97
translate russian cassidy_flirty_texts_30d3010c:
    cassidy_nvl "Я скучаю! Когда увидимся, а?"

# ch/cassidy/texts.rpy:98
translate russian cassidy_flirty_texts_7ece4e68:
    cassidy_nvl "Хочу чувствовать твои руки на всём теле."

# ch/cassidy/texts.rpy:99
translate russian cassidy_flirty_texts_9e5588c4:
    cassidy_nvl "И тебя внутри тоже!"

# ch/cassidy/texts.rpy:109
translate russian cassidy_dirty_texts_5ddb1b7d:
    cassidy_nvl "Все говорят, что беременные становятся похотливыми. Раньше мне казалось, что это мерзко."

# ch/cassidy/texts.rpy:110
translate russian cassidy_dirty_texts_23ed6e71:
    cassidy_nvl "Теперь так не кажется. Приезжай. Сейчас же."

# ch/cassidy/texts.rpy:111
translate russian cassidy_dirty_texts_76fcb6ac:
    cassidy_nvl "Только нежно. Более-менее."

# ch/cassidy/texts.rpy:113
translate russian cassidy_dirty_texts_a9a4842c:
    cassidy_nvl "Приезжай и напомни мне, как именно я оказалась в таком положении."

# ch/cassidy/texts.rpy:114
translate russian cassidy_dirty_texts_fbb6d061:
    cassidy_nvl "Весь день об этом думаю и места себе не нахожу."

# ch/cassidy/texts.rpy:115
translate russian cassidy_dirty_texts_10c88ee5:
    cassidy_nvl "Это ты со мной сделал, так что приезжай и отвечай за последствия."

# ch/cassidy/texts.rpy:121
translate russian cassidy_dirty_texts_5bfe8414:
    cassidy_nvl "Хочу твой рот. Это всё сообщение."

# ch/cassidy/texts.rpy:122
translate russian cassidy_dirty_texts_55048690:
    cassidy_nvl "Ложись на спину и жди, пока я сяду тебе на лицо."

# ch/cassidy/texts.rpy:123
translate russian cassidy_dirty_texts_ba06a319:
    cassidy_nvl "И когда закончу, лучше поблагодари меня как следует."

# ch/cassidy/texts.rpy:125
translate russian cassidy_dirty_texts_9716d79d:
    cassidy_nvl "Я решила, что сегодня тебе разрешено довести меня до оргазма."

# ch/cassidy/texts.rpy:126
translate russian cassidy_dirty_texts_6cc448e9:
    cassidy_nvl "Тебе. Это не значит, что получишь что-то взамен. Не жадничай."

# ch/cassidy/texts.rpy:127
translate russian cassidy_dirty_texts_c7d9791d:
    cassidy_nvl "А теперь приезжай, заслужи эту честь и называй меня как положено."

# ch/cassidy/texts.rpy:133
translate russian cassidy_dirty_texts_a03c9ab0:
    cassidy_nvl "Не могу перестать думать о том, как в прошлый раз ты нагнул меня над своим столом."

# ch/cassidy/texts.rpy:134
translate russian cassidy_dirty_texts_519b5065:
    cassidy_nvl "Пожалуйста, господин, мне нужно снова почувствовать тебя внутри."

# ch/cassidy/texts.rpy:135
translate russian cassidy_dirty_texts_f3ff41c8:
    cassidy_nvl "Я буду очень хорошей. Обещаю. Только скажи когда."

# ch/cassidy/texts.rpy:137
translate russian cassidy_dirty_texts_7650aa08:
    cassidy_nvl "Весь день изнываю от желания к тебе. Это сводит меня с ума."

# ch/cassidy/texts.rpy:138
translate russian cassidy_dirty_texts_21bfc853:
    cassidy_nvl "Можно я приеду и приласкаю тебя ртом?"

# ch/cassidy/texts.rpy:139
translate russian cassidy_dirty_texts_0c454064:
    cassidy_nvl "Скажу «пожалуйста» столько раз, сколько захочешь."

# ch/cassidy/texts.rpy:144
translate russian cassidy_dirty_texts_754dfa81:
    cassidy_nvl "Эй, можешь приехать ко мне?"

# ch/cassidy/texts.rpy:145
translate russian cassidy_dirty_texts_8e058e04:
    cassidy_nvl "Мне пришла САМАЯ лучшая идея!"

# ch/cassidy/texts.rpy:147
translate russian cassidy_dirty_texts_a7868ac7:
    cassidy_nvl "Давай займёмся этим на кровати мачехи!"

# ch/cassidy/texts.rpy:149
translate russian cassidy_dirty_texts_350a3a8c:
    cassidy_nvl "Давай займёмся этим на кровати папочки и мачехи!"

# ch/cassidy/texts.rpy:151
translate russian cassidy_dirty_texts_406db0c4:
    cassidy_nvl "Пожалуйста, снова засунь в меня свой член!"

# ch/cassidy/texts.rpy:152
translate russian cassidy_dirty_texts_40f0273b:
    cassidy_nvl "Мне так хорошо, когда мы трахаемся!"

# ch/cassidy/texts.rpy:153
translate russian cassidy_dirty_texts_2d11b9a3:
    cassidy_nvl "С тобой я чувствую себя настоящей женщиной!"

# ch/cassidy/texts.rpy:156
translate russian cassidy_dirty_texts_514523a9:
    cassidy_nvl "Быть одной — отстой, и ненавижу это признавать!"

