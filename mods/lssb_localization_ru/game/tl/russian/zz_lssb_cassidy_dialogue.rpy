# ch/cassidy/gift.rpy:291
translate russian cassidy_gift_butt_plug_male_3cd3fea2:
    cassidy.say "Просто идеально!"

# ch/cassidy/gift.rpy:292
translate russian cassidy_gift_butt_plug_male_8b0183d6:
    cassidy.say "Спасибо, [lssb_cassidy.hero_name()], я найду ей достойное применение."

# ch/cassidy/reactions.rpy:2
translate russian cassidy_ice_cream_reaction_male_688377e5:
    mike.say "Сегодня так жарко, Кэссиди! Нам просто необходимо мороженое!"

# ch/cassidy/reactions.rpy:3
translate russian cassidy_ice_cream_reaction_male_08a016db:
    cassidy.say "Ура! Я ОБОЖАЮ мороженое!"

# ch/cassidy/reactions.rpy:4
translate russian cassidy_ice_cream_reaction_male_73a4ddd7:
    "У киоска с мороженым я покупаю рожок с парой разных шариков."

# ch/cassidy/reactions.rpy:5
translate russian cassidy_ice_cream_reaction_male_1e7d7a01:
    "Но Кэссиди заказывает себе роскошный десерт из мороженого, к которому прилагается длинная ложка."

# ch/cassidy/reactions.rpy:6
translate russian cassidy_ice_cream_reaction_male_1327e82d:
    mike.say "Ух ты, Кэссиди, выглядит потрясающе!"

# ch/cassidy/reactions.rpy:7
translate russian cassidy_ice_cream_reaction_male_bae357dd:
    cassidy.say "Если уж я ем мороженое, то подхожу к делу серьёзно!"

# ch/cassidy/reactions.rpy:8
translate russian cassidy_ice_cream_reaction_male_ccd3a041:
    "Кэссиди косится на меня, отправляя ложку мороженого в рот."

# ch/cassidy/reactions.rpy:9
translate russian cassidy_ice_cream_reaction_male_bd8e0f6c:
    "А мой рожок так и остаётся нетронутым: я смотрю на неё как заворожённый."

# ch/cassidy/reactions.rpy:10
translate russian cassidy_ice_cream_reaction_male_39d68ce9:
    "Я вспоминаю о нём лишь тогда, когда чувствую, как мороженое тает и стекает по пальцам!"

# ch/cassidy/reactions.rpy:12
translate russian cassidy_ice_cream_reaction_male_8b4da9e5:
    cassidy.say "Купи мне ещё одно, [lssb_cassidy.hero_name()]. Твой малыш хочет добавки, и я тоже."

# ch/cassidy/reactions.rpy:14
translate russian cassidy_ice_cream_reaction_male_407dce8b:
    cassidy.say "Платишь, разумеется, ты. Считай это привилегией, [lssb_cassidy.hero_name()]."

# ch/cassidy/reactions.rpy:16
translate russian cassidy_ice_cream_reaction_male_66df5ac0:
    cassidy.say "Вот, [lssb_cassidy.hero_name()], попробуй моё. Только на этот раз: сегодня я щедрая."

# ch/cassidy/reactions.rpy:18
translate russian cassidy_ice_cream_reaction_male_36e9a210:
    cassidy.say "М-м-м... ладно, [lssb_cassidy.hero_name()], можешь попробовать одну ложечку моего. Одну!"

# ch/cassidy/reactions.rpy:20
translate russian cassidy_ice_cream_reaction_male_245a31d6:
    cassidy.say "Даже не думай просить попробовать моё, [lssb_cassidy.hero_name()]."

# ch/cassidy/reactions.rpy:24
translate russian cassidy_ask_phone_male_abbf69ea:
    mike.say "Эй, Кэссиди..."

# ch/cassidy/reactions.rpy:25
translate russian cassidy_ask_phone_male_c7338e75:
    mike.say "Нам стоит обменяться номерами."

# ch/cassidy/reactions.rpy:29
translate russian cassidy_ask_phone_male_29df895e:
    cassidy.say "Отличная идея, [lssb_cassidy.hero_name()]!"

# ch/cassidy/reactions.rpy:30
translate russian cassidy_ask_phone_male_8c4ac81b:
    cassidy.say "Я даже знаю, какую мелодию поставить на твой звонок!"

# ch/cassidy/reactions.rpy:35
translate russian cassidy_ask_phone_male_cff3fb36:
    cassidy.say "Не думаю, [lssb_cassidy.hero_name()]."

# ch/cassidy/reactions.rpy:36
translate russian cassidy_ask_phone_male_9d6eead6:
    cassidy.say "Я не готова дать тебе свой номер."

# ch/cassidy/reactions.rpy:37
translate russian cassidy_ask_phone_male_b569e425:
    cassidy.say "Во всяком случае, пока."

# ch/cassidy/reactions.rpy:41
translate russian cassidy_ask_birthday_male_abbf69ea:
    mike.say "Эй, Кэссиди..."

# ch/cassidy/reactions.rpy:42
translate russian cassidy_ask_birthday_male_79f1e136:
    mike.say "Когда у тебя день рождения?"

# ch/cassidy/reactions.rpy:46
translate russian cassidy_ask_birthday_male_48fbe26a:
    cassidy.say "О, это тебе действительно стоит знать."

# ch/cassidy/reactions.rpy:47
translate russian cassidy_ask_birthday_male_e9e2d4c6:
    cassidy.say "Тогда у тебя не будет оправдания, если забудешь!"

# ch/cassidy/reactions.rpy:48
translate russian cassidy_ask_birthday_male_ba4b639a:
    cassidy.say "Девятого дня весны."

# ch/cassidy/reactions.rpy:53
translate russian cassidy_ask_birthday_male_ddb53b17:
    cassidy.say "Почему ты спрашиваешь, [lssb_cassidy.hero_name()]?"

# ch/cassidy/reactions.rpy:54
translate russian cassidy_ask_birthday_male_38644064:
    cassidy.say "Я достаточно взрослая, чтобы курить, пить И водить машину!"

# ch/cassidy/reactions.rpy:58
translate russian cassidy_offer_a_drink_male_b3c7d40d:
    mike.say "Хочешь выпить, Кэссиди?"

# ch/cassidy/reactions.rpy:59
translate russian cassidy_offer_a_drink_male_dcf6d18b:
    mike.say "Я как раз собирался к бару."

# ch/cassidy/reactions.rpy:60
translate russian cassidy_offer_a_drink_male_29efbd05:
    "Едва я заканчиваю говорить, Кэссиди поворачивается ко мне."

# ch/cassidy/reactions.rpy:64
translate russian cassidy_offer_a_drink_male_f995236d:
    cassidy.say "[lssb_cassidy.hero_name()], ты... ты чудовище!"

# ch/cassidy/reactions.rpy:65
translate russian cassidy_offer_a_drink_male_c15c91e7:
    cassidy.say "Сначала я беременею от тебя."

# ch/cassidy/reactions.rpy:66
translate russian cassidy_offer_a_drink_male_a8b67c65:
    cassidy.say "А потом ты подвергаешь нашего ребёнка опасности, предлагая мне алкоголь!"

# ch/cassidy/reactions.rpy:71
translate russian cassidy_offer_a_drink_male_bfbd4411:
    cassidy.say "Как мило, что ты спросил, [lssb_cassidy.hero_name()]."

# ch/cassidy/reactions.rpy:72
translate russian cassidy_offer_a_drink_male_8340477e:
    cassidy.say "Мне один из этих изысканных коктейлей, спасибо!"

# ch/cassidy/reactions.rpy:84
translate russian cassidy_offer_a_drink_male_456bfd72:
    cassidy.say "Не утруждайся, [lssb_cassidy.hero_name()]."

# ch/cassidy/reactions.rpy:85
translate russian cassidy_offer_a_drink_male_8bb8f5da:
    cassidy.say "Всё равно тебе наверняка не по карману то, что я хочу!"

# ch/cassidy/reactions.rpy:91
translate russian cassidy_slap_ass_intro_male_6f92b1a4:
    "Кэссиди беззаботно идёт рядом со мной, покачивая бёдрами."

# ch/cassidy/reactions.rpy:92
translate russian cassidy_slap_ass_intro_male_53599ac5:
    "Её попка всё это время движется в собственном ритме."

# ch/cassidy/reactions.rpy:93
translate russian cassidy_slap_ass_intro_male_878566ed:
    "Как ни стараюсь, я не могу отвести от неё глаз."

# ch/cassidy/reactions.rpy:94
translate russian cassidy_slap_ass_intro_male_19d85c11:
    "Вскоре мне хочется её шлёпнуть."

# ch/cassidy/reactions.rpy:95
translate russian cassidy_slap_ass_intro_male_57156398:
    "Не сильно — всего лишь слегка хлопнуть..."

# ch/cassidy/reactions.rpy:99
translate russian cassidy_slap_ass_happy_male_f74ad9b1:
    "Кэссиди слегка подпрыгивает."

# ch/cassidy/reactions.rpy:100
translate russian cassidy_slap_ass_happy_male_dc286298:
    "И одновременно удивлённо вскрикивает."

# ch/cassidy/reactions.rpy:101
translate russian cassidy_slap_ass_happy_male_dfb792e7:
    cassidy.say "Ай..."

# ch/cassidy/reactions.rpy:102
translate russian cassidy_slap_ass_happy_male_8f70d797:
    cassidy.say "Это ещё что?!"

# ch/cassidy/reactions.rpy:103
translate russian cassidy_slap_ass_happy_male_626392b8:
    "Она потирает попку и смотрит на меня."

# ch/cassidy/reactions.rpy:104
translate russian cassidy_slap_ass_happy_male_da9c8e56:
    "Ей не требуется много времени, чтобы всё понять."

# ch/cassidy/reactions.rpy:105
translate russian cassidy_slap_ass_happy_male_fc3e754f:
    cassidy.say "Просто не смог сдержаться, да?"

# ch/cassidy/reactions.rpy:107
translate russian cassidy_slap_ass_happy_male_f16ccbb0:
    cassidy.say "Осторожнее, [lssb_cassidy.hero_name()], к этой попке теперь прилагается ценный груз!"

# ch/cassidy/reactions.rpy:108
translate russian cassidy_slap_ass_happy_male_eb30b8bb:
    cassidy.say "Хотя... пожалуй, я не против внимания."

# ch/cassidy/reactions.rpy:110
translate russian cassidy_slap_ass_happy_male_a19553a1:
    cassidy.say "Смело. Разве я разрешала меня трогать, [lssb_cassidy.hero_name()]?"

# ch/cassidy/reactions.rpy:111
translate russian cassidy_slap_ass_happy_male_178825bb:
    cassidy.say "Сделай ещё раз, и, может, я закрою на это глаза."

# ch/cassidy/reactions.rpy:113
translate russian cassidy_slap_ass_happy_male_d123defd:
    cassidy.say "М-м-м... можешь шлёпать свою питомицу когда захочешь, [lssb_cassidy.hero_name()]."

# ch/cassidy/reactions.rpy:114
translate russian cassidy_slap_ass_happy_male_690ffa63:
    cassidy.say "Даже спрашивать не нужно!"

# ch/cassidy/reactions.rpy:116
translate russian cassidy_slap_ass_happy_male_0e4038c5:
    cassidy.say "Если хочешь меня потрогать, [lssb_cassidy.hero_name()]..."

# ch/cassidy/reactions.rpy:117
translate russian cassidy_slap_ass_happy_male_899fea9a:
    cassidy.say "Нужно всего лишь попросить!"

# ch/cassidy/reactions.rpy:121
translate russian cassidy_slap_ass_angry_male_f74ad9b1:
    "Кэссиди слегка подпрыгивает."

# ch/cassidy/reactions.rpy:122
translate russian cassidy_slap_ass_angry_male_dc286298:
    "И одновременно удивлённо вскрикивает."

# ch/cassidy/reactions.rpy:123
translate russian cassidy_slap_ass_angry_male_dfb792e7:
    cassidy.say "Ай..."

# ch/cassidy/reactions.rpy:124
translate russian cassidy_slap_ass_angry_male_8f70d797:
    cassidy.say "Это ещё что?!"

# ch/cassidy/reactions.rpy:125
translate russian cassidy_slap_ass_angry_male_626392b8:
    "Она потирает попку и смотрит на меня."

# ch/cassidy/reactions.rpy:126
translate russian cassidy_slap_ass_angry_male_da9c8e56:
    "Ей не требуется много времени, чтобы всё понять."

# ch/cassidy/reactions.rpy:127
translate russian cassidy_slap_ass_angry_male_b020322a:
    cassidy.say "Знаешь, это свинство, [lssb_cassidy.hero_name()]!"

# ch/cassidy/reactions.rpy:128
translate russian cassidy_slap_ass_angry_male_86329596:
    cassidy.say "Я бы, может, и разрешила меня потрогать."

# ch/cassidy/reactions.rpy:129
translate russian cassidy_slap_ass_angry_male_8492033b:
    cassidy.say "Если бы тебе хватило воспитания сначала спросить!"

# ch/cassidy/reactions.rpy:134
translate russian cassidy_breakup_male_218fb0e5:
    "Наверное, это как вырвать зуб, понимаешь?"

# ch/cassidy/reactions.rpy:135
translate russian cassidy_breakup_male_d2bcf7d6:
    "Очень хочется вообще этого не делать."

# ch/cassidy/reactions.rpy:136
translate russian cassidy_breakup_male_cbf05bc8:
    "Знаешь, что будет чертовски больно."

# ch/cassidy/reactions.rpy:137
translate russian cassidy_breakup_male_e7f056ba:
    "Но понимаешь, что оставлять всё гнить тоже нельзя."

# ch/cassidy/reactions.rpy:138
translate russian cassidy_breakup_male_a5c3a421:
    "Поэтому в конце концов нужно просто решиться..."

# ch/cassidy/reactions.rpy:139
translate russian cassidy_breakup_male_7d3a0e63:
    mike.say "Кэссиди..."

# ch/cassidy/reactions.rpy:140
translate russian cassidy_breakup_male_adb5b2a5:
    mike.say "Я тут думал..."

# ch/cassidy/reactions.rpy:141
translate russian cassidy_breakup_male_ea496260:
    mike.say "О нас, понимаешь?"

# ch/cassidy/reactions.rpy:142
translate russian cassidy_breakup_male_5f60465f:
    "Кэссиди смотрит на меня со странным выражением лица."

# ch/cassidy/reactions.rpy:143
translate russian cassidy_breakup_male_025c6d2c:
    "В нём смешались тревога и недоумение."

# ch/cassidy/reactions.rpy:144
translate russian cassidy_breakup_male_dffe660e:
    "Будто она впервые в жизни столкнулась с чем-то подобным."

# ch/cassidy/reactions.rpy:145
translate russian cassidy_breakup_male_59dfe4c7:
    cassidy.say "А?"

# ch/cassidy/reactions.rpy:146
translate russian cassidy_breakup_male_8f377ff2:
    cassidy.say "И что это должно означать, [lssb_cassidy.hero_name()]?"

# ch/cassidy/reactions.rpy:147
translate russian cassidy_breakup_male_5f504dad:
    cassidy.say "Я всё время о нас думаю. И что?"

# ch/cassidy/reactions.rpy:148
translate russian cassidy_breakup_male_627e8469:
    "Объясняясь, я стараюсь говорить ровным голосом."

# ch/cassidy/reactions.rpy:149
translate russian cassidy_breakup_male_996782b3:
    "Сейчас я не понимаю, притворяется ли Кэссиди дурочкой."

# ch/cassidy/reactions.rpy:150
translate russian cassidy_breakup_male_7520e2f4:
    "Или она и правда не понимает, к чему я клоню."

# ch/cassidy/reactions.rpy:151
translate russian cassidy_breakup_male_2be91fb8:
    mike.say "Я говорю о нас, Кэссиди. О наших отношениях."

# ch/cassidy/reactions.rpy:152
translate russian cassidy_breakup_male_6054de0a:
    mike.say "Мне кажется, у нас ничего не получается."

# ch/cassidy/reactions.rpy:154
translate russian cassidy_breakup_male_89a549e5:
    "Кэссиди отшатывается, словно её ужалили."

# ch/cassidy/reactions.rpy:155
translate russian cassidy_breakup_male_2b8af51f:
    "Затем качает головой, показывая, что всё ещё не понимает."

# ch/cassidy/reactions.rpy:157
translate russian cassidy_breakup_male_1131cfac:
    cassidy.say "Погоди-ка..."

# ch/cassidy/reactions.rpy:158
translate russian cassidy_breakup_male_8e659ce7:
    cassidy.say "Ты хочешь сказать, что ты..."

# ch/cassidy/reactions.rpy:159
translate russian cassidy_breakup_male_a77f1743:
    cassidy.say "Ты меня БРОСАЕШЬ?!"

# ch/cassidy/reactions.rpy:160
translate russian cassidy_breakup_male_a9aa21d4:
    cassidy.say "Меня ещё никто никогда не бросал!"

# ch/cassidy/reactions.rpy:161
translate russian cassidy_breakup_male_cdba1139:
    cassidy.say "Это я всех бросаю!"

# ch/cassidy/reactions.rpy:162
translate russian cassidy_breakup_male_0e1a92ae:
    "Честно говоря, приятного в этом мало."

# ch/cassidy/reactions.rpy:163
translate russian cassidy_breakup_male_646cac9c:
    "Быть первым, кто бросил Кэссиди, — нечем гордиться!"

# ch/cassidy/reactions.rpy:164
translate russian cassidy_breakup_male_04f13d9c:
    "Наоборот, от этого всё становится ещё неловче."

# ch/cassidy/reactions.rpy:165
translate russian cassidy_breakup_male_1efe5538:
    mike.say "Прости, Кэссиди."

# ch/cassidy/reactions.rpy:166
translate russian cassidy_breakup_male_f5c33e2b:
    mike.say "Но я именно это и чувствую."

# ch/cassidy/reactions.rpy:167
translate russian cassidy_breakup_male_f4508b6a:
    mike.say "Уверен, ты это переживёшь... со временем!"

# ch/cassidy/reactions.rpy:168
translate russian cassidy_breakup_male_6746759a:
    "Кэссиди прищуривается и впивается в меня суровым взглядом."

# ch/cassidy/reactions.rpy:169
translate russian cassidy_breakup_male_f87e2b8a:
    "Я почти физически чувствую, как начинаю под ним ёжиться."

# ch/cassidy/reactions.rpy:170
translate russian cassidy_breakup_male_0fb039af:
    cassidy.say "О, я-то переживу, [lssb_cassidy.hero_name()]."

# ch/cassidy/reactions.rpy:171
translate russian cassidy_breakup_male_827ae92c:
    cassidy.say "Вообще-то я УЖЕ пережила. Мне совершенно всё равно!"

# ch/cassidy/reactions.rpy:172
translate russian cassidy_breakup_male_7b519cb6:
    cassidy.say "Это ты меня никогда не забудешь!"

# ch/cassidy/reactions.rpy:176
translate russian cassidy_go_steady_intro_male_afa69f7e:
    mike.say "У нас ведь всё хорошо, правда, Кэссиди?"

# ch/cassidy/reactions.rpy:177
translate russian cassidy_go_steady_intro_male_a5131a1d:
    mike.say "Так давай сделаем это официальным."

# ch/cassidy/reactions.rpy:178
translate russian cassidy_go_steady_intro_male_2b91237a:
    mike.say "Ну, будем парой?"

# ch/cassidy/reactions.rpy:182
translate russian cassidy_go_steady_yes_male_a8b2d291:
    cassidy.say "Хм..."

# ch/cassidy/reactions.rpy:183
translate russian cassidy_go_steady_yes_male_d0352828:
    cassidy.say "Наверное, ты прав, [lssb_cassidy.hero_name()]."

# ch/cassidy/reactions.rpy:184
translate russian cassidy_go_steady_yes_male_0516f55f:
    cassidy.say "Нам действительно стоит стать парой!"

# ch/cassidy/reactions.rpy:185
translate russian cassidy_go_steady_yes_male_71c5f2b8:
    "Кэссиди улыбается и наклоняется, чтобы поцеловать меня в щёку."

# ch/cassidy/reactions.rpy:186
translate russian cassidy_go_steady_yes_male_31f9c894:
    "И на моём лице тут же расплывается улыбка."

# ch/cassidy/reactions.rpy:191
translate russian cassidy_go_steady_no_male_a8b2d291:
    cassidy.say "Хм..."

# ch/cassidy/reactions.rpy:192
translate russian cassidy_go_steady_no_male_d978d93a:
    cassidy.say "Не думаю, что это случится, [lssb_cassidy.hero_name()]."

# ch/cassidy/reactions.rpy:193
translate russian cassidy_go_steady_no_male_c59f0355:
    cassidy.say "По крайней мере, не сейчас."

# ch/cassidy/reactions.rpy:195
translate russian cassidy_go_steady_no_male_4db4aa2a:
    mike.say "Я хочу, чтобы мы стали официальной парой, как говорят, «встречались всерьёз»."

# ch/cassidy/reactions.rpy:196
translate russian cassidy_go_steady_no_male_414ab54c:
    cassidy.say "Не глупи. При наших договорённостях это не имеет смысла."

# ch/cassidy/reactions.rpy:200
translate russian cassidy_pet_intro_male_34d5519b:
    "Меня вдруг захлёстывает нежность к Кэссиди."

# ch/cassidy/reactions.rpy:201
translate russian cassidy_pet_intro_male_1aa8f5b8:
    "Настолько сильная, что я не могу сдержаться."

# ch/cassidy/reactions.rpy:202
translate russian cassidy_pet_intro_male_c340b226:
    "Я просто протягиваю руку и глажу её по голове."

# ch/cassidy/reactions.rpy:206
translate russian cassidy_pet_happy_male_3140813c:
    cassidy.say "О-о..."

# ch/cassidy/reactions.rpy:207
translate russian cassidy_pet_happy_male_1da6dc43:
    cassidy.say "С... спасибо, [lssb_cassidy.hero_name()]."

# ch/cassidy/reactions.rpy:208
translate russian cassidy_pet_happy_male_75d33967:
    cassidy.say "Хи-хи... значит, я хорошая девочка!"

# ch/cassidy/reactions.rpy:212
translate russian cassidy_pet_annoyed_male_5e207716:
    cassidy.say "Эй!"

# ch/cassidy/reactions.rpy:213
translate russian cassidy_pet_annoyed_male_cbdbda0f:
    cassidy.say "Ты с чего взял, что можешь так меня гладить?!"

# ch/cassidy/reactions.rpy:214
translate russian cassidy_pet_annoyed_male_b53f78d5:
    cassidy.say "Я тебе не собака, знаешь ли!"

# ch/cassidy/reactions.rpy:218
translate russian cassidy_massage_intro_male_5eaae3fb:
    mike.say "У тебя сильно напряжены плечи, Кэссиди."

# ch/cassidy/reactions.rpy:219
translate russian cassidy_massage_intro_male_dfedcaad:
    mike.say "Хочешь, я сделаю тебе массаж?"

# ch/cassidy/reactions.rpy:220
translate russian cassidy_massage_intro_male_26627991:
    mike.say "Мне говорили, что у меня волшебные пальцы!"

# ch/cassidy/reactions.rpy:225
translate russian cassidy_massage_accept_male_0a98fbd2:
    cassidy.say "О да, пожалуйста, [lssb_cassidy.hero_name()]. С тех пор как появился животик, спина просто отваливается."

# ch/cassidy/reactions.rpy:226
translate russian cassidy_massage_accept_male_b9171c15:
    cassidy.say "Андре бы ни за что не посмел, но тебе разрешаю помассировать мне плечи."

# ch/cassidy/reactions.rpy:228
translate russian cassidy_massage_accept_male_b98be5f6:
    cassidy.say "Ладно. Встань на колени и принеси хоть какую-то пользу, [lssb_cassidy.hero_name()]."

# ch/cassidy/reactions.rpy:229
translate russian cassidy_massage_accept_male_034007f8:
    cassidy.say "И если твои волшебные пальцы меня разочаруют, пожалеешь."

# ch/cassidy/reactions.rpy:231
translate russian cassidy_massage_accept_male_78c47256:
    cassidy.say "Да, [lssb_cassidy.hero_name()], с удовольствием."

# ch/cassidy/reactions.rpy:232
translate russian cassidy_massage_accept_male_1a303b63:
    cassidy.say "Ты всегда точно знаешь, как обо мне позаботиться."

# ch/cassidy/reactions.rpy:234
translate russian cassidy_massage_accept_male_5d1d0285:
    cassidy.say "Вообще-то обычно мне делает массаж Андре в загородном клубе."

# ch/cassidy/reactions.rpy:235
translate russian cassidy_massage_accept_male_6cba3515:
    cassidy.say "Но сейчас у меня и правда всё затекло."

# ch/cassidy/reactions.rpy:236
