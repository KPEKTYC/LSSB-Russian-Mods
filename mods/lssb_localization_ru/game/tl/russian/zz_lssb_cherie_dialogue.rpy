# ch/cherie/events.rpy:2159
translate russian dwayne_corpse_discovery_1792a71d:
    "К счастью, когда я вхожу в дом, там темно и тихо."

# ch/cherie/events.rpy:2161
translate russian dwayne_corpse_discovery_e398157b:
    mike.say "Саша?.. [bree.name]?.."

# ch/cherie/events.rpy:2163
translate russian dwayne_corpse_discovery_e621aed7:
    mike.say "Саша?.."

# ch/cherie/events.rpy:2165
translate russian dwayne_corpse_discovery_26b819d9:
    mike.say "[bree.name]?.."

# ch/cherie/events.rpy:2167
translate russian dwayne_corpse_discovery_fbc4dc7d:
    mike.say "Минами?.."

# ch/cherie/events.rpy:2170
translate russian dwayne_corpse_discovery_7a438f2a:
    mike.say "Сэм?.. Лекси?.."

# ch/cherie/events.rpy:2172
translate russian dwayne_corpse_discovery_dcae0275:
    mike.say "Сэм?.."

# ch/cherie/events.rpy:2174
translate russian dwayne_corpse_discovery_a5674a97:
    mike.say "Лекси?.."

# ch/cherie/events.rpy:2175
translate russian dwayne_corpse_discovery_5b943fbe:
    mike.say "Есть кто дома?"

# ch/cherie/events.rpy:2176
translate russian dwayne_corpse_discovery_ef49fac6:
    "Никто не отвечает, и я с облегчением вздыхаю и иду прямо в гостиную."

# ch/cherie/events.rpy:2177
translate russian dwayne_corpse_discovery_2e6a0532:
    "Там я сразу скидываю обувь и валюсь на диван."

# ch/cherie/events.rpy:2178
translate russian dwayne_corpse_discovery_5a1d9654:
    "Рука сама находит пульт."

# ch/cherie/events.rpy:2179
translate russian dwayne_corpse_discovery_c01ad466:
    "Я включаю телевизор, и на загоревшемся экране появляется один из местных новостных каналов."

# ch/cherie/events.rpy:2180
translate russian dwayne_corpse_discovery_184edcf4:
    "Ведущий" "А сейчас мы в прямом эфире связываемся с нашим корреспондентом на месте событий..."

# ch/cherie/events.rpy:2181
translate russian dwayne_corpse_discovery_c2e836b5:
    "Ведущий" "Итак, что вам удалось узнать на данный момент?"

# ch/cherie/events.rpy:2182
translate russian dwayne_corpse_discovery_4ab20f9d:
    "Я слушаю вполуха и почти не замечаю, что происходит на экране."

# ch/cherie/events.rpy:2183
translate russian dwayne_corpse_discovery_980c2920:
    "Мой уставший мозг воспринимает это как ещё один якобы важный новостной сюжет."

# ch/cherie/events.rpy:2195
translate russian dwayne_corpse_discovery_50d17a4a:
    "И глаза едва улавливают фигуру корреспондента, говорящего на камеру."

# ch/cherie/events.rpy:2196
translate russian dwayne_corpse_discovery_ccbc302a:
    "Корреспондент" "Полиция пока осторожно делится с нами информацией..."

# ch/cherie/events.rpy:2197
translate russian dwayne_corpse_discovery_76c8050e:
    "Корреспондент" "Однако нам сообщили, что личность погибшего уже установлена."

# ch/cherie/events.rpy:2198
translate russian dwayne_corpse_discovery_de6fac05:
    "Корреспондент" "Это не кто иной, как пропавший без вести бизнес-магнат и филантроп Дуэйн Джексон!"

# ch/cherie/events.rpy:2199
translate russian dwayne_corpse_discovery_deb2b75c:
    "Корреспондент произносит имя с той серьёзной, драматичной интонацией, которая им так свойственна."

# ch/cherie/events.rpy:2200
translate russian dwayne_corpse_discovery_4e409318:
    "И лишь это наконец пробивается сквозь моё оцепенение и доходит до сознания."

# ch/cherie/events.rpy:2201
translate russian dwayne_corpse_discovery_07c55682:
    "Я мгновенно прихожу в себя, подаюсь вперёд на диване и прибавляю громкость."

# ch/cherie/events.rpy:2204
translate russian dwayne_corpse_discovery_f8c56251:
    "Корреспондент" "По нашим сведениям, тело обнаружил здесь прохожий…"

# ch/cherie/events.rpy:2205
translate russian dwayne_corpse_discovery_0a7af0ac:
    "Корреспондент поворачивается и указывает на пляж за своей спиной."

# ch/cherie/events.rpy:2206
translate russian dwayne_corpse_discovery_6de1a0c9:
    "Корреспондент" "Оно было запутано в рыболовной сети и выброшено на берег приливом."

# ch/cherie/events.rpy:2208
translate russian dwayne_corpse_discovery_213d7325:
    "Корреспондент" "Неподалёку также нашли огнестрельное оружие, предположительно ставшее орудием убийства."

# ch/cherie/events.rpy:2209
translate russian dwayne_corpse_discovery_7d5a7ce8:
    "Мне хочется изо всех сил влепить себе пощёчину."

# ch/cherie/events.rpy:2210
translate russian dwayne_corpse_discovery_f0cc0ae6:
    "С чего я, чёрт возьми, решил, что сработает план с телом в море?"

# ch/cherie/events.rpy:2211
translate russian dwayne_corpse_discovery_5357363a:
    "На берег же постоянно выносит всякое дерьмо."

# ch/cherie/events.rpy:2212
translate russian dwayne_corpse_discovery_124ecbc2:
    "Так что такое огромное дерьмо, как Дуэйн, в конце концов обязательно должно было туда попасть."

# ch/cherie/events.rpy:2214
translate russian dwayne_corpse_discovery_83396bf8:
    "Не говоря уже о пистолете: почему я решил, что спрятать его в том же месте — хорошая идея?!"

# ch/cherie/events.rpy:2217
translate russian dwayne_corpse_discovery_f8c56251_1:
    "Корреспондент" "По нашим сведениям, тело обнаружил здесь прохожий…"

# ch/cherie/events.rpy:2218
translate russian dwayne_corpse_discovery_b9a671e1:
    "Корреспондент поворачивается и указывает на деревья за своей спиной."

# ch/cherie/events.rpy:2219
translate russian dwayne_corpse_discovery_5ba9764d:
    "Корреспондент" "Оно было закопано в неглубокой могиле; на нём обнаружены следы зубов животных."

# ch/cherie/events.rpy:2221
translate russian dwayne_corpse_discovery_213d7325_1:
    "Корреспондент" "Неподалёку также нашли огнестрельное оружие, предположительно ставшее орудием убийства."

# ch/cherie/events.rpy:2222
translate russian dwayne_corpse_discovery_7d5a7ce8_1:
    "Мне хочется изо всех сил влепить себе пощёчину."

# ch/cherie/events.rpy:2223
translate russian dwayne_corpse_discovery_bfd5a1e6:
    "С чего я, чёрт возьми, решил, что сработает план с телом в лесу?"

# ch/cherie/events.rpy:2224
translate russian dwayne_corpse_discovery_b68bd48e:
    "Я ведь постоянно читаю о том, как люди находят там тела, выгуливая собак."

# ch/cherie/events.rpy:2225
translate russian dwayne_corpse_discovery_b3b79d8b:
    "Почему в этот раз должно было быть иначе?"

# ch/cherie/events.rpy:2227
translate russian dwayne_corpse_discovery_83396bf8_1:
    "Не говоря уже о пистолете: почему я решил, что спрятать его в том же месте — хорошая идея?!"

# ch/cherie/events.rpy:2230
translate russian dwayne_corpse_discovery_93d991cb:
    "Корреспондент" "По нашим сведениям, тело обнаружили здесь сотрудники полиции..."

# ch/cherie/events.rpy:2231
translate russian dwayne_corpse_discovery_ee52b459:
    "Корреспондент поворачивается и указывает на дом за своей спиной, оцепленный полицейской лентой."

# ch/cherie/events.rpy:2232
translate russian dwayne_corpse_discovery_173e11e4:
    "Корреспондент" "Прибывшие по сообщениям о гнилостном запахе, исходившем из подвала."

# ch/cherie/events.rpy:2234
translate russian dwayne_corpse_discovery_213d7325_2:
    "Корреспондент" "Неподалёку также нашли огнестрельное оружие, предположительно ставшее орудием убийства."

# ch/cherie/events.rpy:2235
translate russian dwayne_corpse_discovery_7d5a7ce8_2:
    "Мне хочется изо всех сил влепить себе пощёчину."

# ch/cherie/events.rpy:2236
translate russian dwayne_corpse_discovery_870c15f3:
    "Почему я, чёрт возьми, не заставил Шери избавиться от этого чёртова тела?"

# ch/cherie/events.rpy:2237
translate russian dwayne_corpse_discovery_0de89498:
    "Надо было догадаться, что такое огромное дерьмо, как Дуэйн, будет вонять."

# ch/cherie/events.rpy:2238
translate russian dwayne_corpse_discovery_1464e47f:
    "Да так, что за километр учуют."

# ch/cherie/events.rpy:2240
translate russian dwayne_corpse_discovery_83396bf8_2:
    "Не говоря уже о пистолете: почему я решил, что спрятать его в том же месте — хорошая идея?!"

# ch/cherie/events.rpy:2241
translate russian dwayne_corpse_discovery_79328e4e:
    "Корреспондент" "Как нам стало известно, Шери Джексон..."

# ch/cherie/events.rpy:2242
translate russian dwayne_corpse_discovery_64bbb3ac:
    "Корреспондент" "Супруга мистера Джексона... а теперь его вдова..."

# ch/cherie/events.rpy:2243
translate russian dwayne_corpse_discovery_3771f4c4:
    "Корреспондент" "Заявила властям о пропаже мужа, когда тот не вернулся из зарубежной деловой поездки."

# ch/cherie/events.rpy:2244
translate russian dwayne_corpse_discovery_77b66502:
    "Корреспондент" "Однако обнаружение тела ставит эту версию под сомнение: возможно, он вообще не покидал город."

# ch/cherie/events.rpy:2245
translate russian dwayne_corpse_discovery_feedf124:
    "Я изо всех сил стараюсь сохранять спокойствие и слушать слова корреспондента."

# ch/cherie/events.rpy:2246
translate russian dwayne_corpse_discovery_d14694dd:
    "Пытаюсь вычленить важные сведения из обычных скандальных сплетен."

# ch/cherie/events.rpy:2247
translate russian dwayne_corpse_discovery_3d1c6e38:
    "Понимая, что от этого может зависеть моя шкура и судьба всех причастных."

# ch/cherie/events.rpy:2248
translate russian dwayne_corpse_discovery_a139fa15:
    "Корреспондент" "Разумеется, полиция крайне немногословна и отказывается раскрывать многие подробности."

# ch/cherie/events.rpy:2249
translate russian dwayne_corpse_discovery_4a72ae1d:
    "Корреспондент" "Однако, по нашим сведениям, смерть мистера Джексона теперь официально расследуется как убийство."

# ch/cherie/events.rpy:2250
translate russian dwayne_corpse_discovery_4879b43c:
    "Корреспондент" "При этом уже известно, что Джексон и его компания находились под пристальным вниманием финансовых органов."

# ch/cherie/events.rpy:2251
translate russian dwayne_corpse_discovery_079dd341:
    "Корреспондент" "Кроме того, его личная жизнь была предметом многочисленных домыслов и слухов."

# ch/cherie/events.rpy:2252
translate russian dwayne_corpse_discovery_1b9bd865:
    "Корреспондент" "Поэтому неудивительно, что обсуждается и версия мести — на личной почве или в связи с его деловой деятельностью."

# ch/cherie/events.rpy:2254
translate russian dwayne_corpse_discovery_158d6c75:
    "Репортаж заканчивается, и ведущий переходит к следующему сюжету."

# ch/cherie/events.rpy:2255
translate russian dwayne_corpse_discovery_7c99ced9:
    "Но я уже совершенно не могу разобрать, о чём идёт речь."

# ch/cherie/events.rpy:2256
translate russian dwayne_corpse_discovery_abccafe0:
    "Потому что снова и снова прокручиваю в голове всё услышанное."

# ch/cherie/events.rpy:2257
translate russian dwayne_corpse_discovery_5be9ee95:
    "Разбирая каждую мелочь с мучительной тщательностью и зацикливаясь на том, что всё это может значить."

# ch/cherie/events.rpy:2258
translate russian dwayne_corpse_discovery_da351c57:
    "Так и хочется достать телефон и немедленно позвонить Шери или Алетте."

# ch/cherie/events.rpy:2259
translate russian dwayne_corpse_discovery_3a5c8f3e:
    "Но я усилием воли сдерживаю себя: это выглядело бы весьма подозрительно."

# ch/cherie/events.rpy:2260
translate russian dwayne_corpse_discovery_fe4ddccc:
    "И кто знает — возможно, полиция уже следит за всеми подозреваемыми."

# ch/cherie/events.rpy:2261
translate russian dwayne_corpse_discovery_8d98ee26:
    "Прослушивает наши звонки и читает нашу почту."

# ch/cherie/events.rpy:2262
translate russian dwayne_corpse_discovery_9ed69017:
    "Нет, лучше подождать и поговорить с ними завтра в офисе."

# ch/cherie/events.rpy:2263
translate russian dwayne_corpse_discovery_96bb9e88:
    "Там меньше шансов, что нас подслушают или за нами будут шпионить."

# ch/cherie/events.rpy:2264
translate russian dwayne_corpse_discovery_fe9bff2f:
    "Хотя чувствую, что до этого меня ждёт долгая бессонная ночь."

# ch/cherie/events.rpy:2271
translate russian dwayne_murder_mike_arrest_534e2ae6:
    "Похоже, сейчас середина ночи; я просыпаюсь, почувствовав присутствие посторонних в спальне."

# ch/cherie/events.rpy:2273
translate russian dwayne_murder_mike_arrest_f1ce2044:
    "Сначала меня охватывает паника, но, увидев полицейскую форму, я всё понимаю."

# ch/cherie/events.rpy:2274
translate russian dwayne_murder_mike_arrest_556b0e6b:
    "Я догадываюсь о причине ещё до того, как встаю с кровати."

# ch/cherie/events.rpy:2275
translate russian dwayne_murder_mike_arrest_62058963:
    "Ведь, по правде говоря, я давно ждал этого момента."

# ch/cherie/events.rpy:2281
translate russian dwayne_murder_mike_arrest_308fd391:
    "Поэтому вид детектива Майклза и Камилы, идущих ко мне, ничуть меня не удивляет."

# ch/cherie/events.rpy:2282
translate russian dwayne_murder_mike_arrest_68aeb843:
    "А мрачная решимость на их лицах лишь подтверждает мои догадки."

# ch/cherie/events.rpy:2283
translate russian dwayne_murder_mike_arrest_5b9b04e8:
    "Игра окончена: они пришли меня арестовать."

# ch/cherie/events.rpy:2284
translate russian dwayne_murder_mike_arrest_d1b34285:
    "Когда они подходят к моему столу, я нарочито встаю и протягиваю руки."

# ch/cherie/events.rpy:2285
translate russian dwayne_murder_mike_arrest_5d843762:
    "Надеясь, что они поймут: я не собираюсь сопротивляться."

# ch/cherie/events.rpy:2287
translate russian dwayne_murder_mike_arrest_ed5a397a:
    "Майклз" "[lssb_cherie.hero_name()] [hero.family_name]…"

# ch/cherie/events.rpy:2288
translate russian dwayne_murder_mike_arrest_b7ac7768:
    "Майклз" "Вы арестованы по подозрению в убийстве Дуэйна Джексона."

# ch/cherie/events.rpy:2289
translate russian dwayne_murder_mike_arrest_05bb5982:
    "Майклз" "Вы имеете право хранить молчание..."

# ch/cherie/events.rpy:2290
translate russian dwayne_murder_mike_arrest_3db17312:
    "Майклз" "Однако если при допросе вы не сообщите о чём-либо, на что впоследствии будете ссылаться в суде, это может повредить вашей защите."

# ch/cherie/events.rpy:2291
translate russian dwayne_murder_mike_arrest_9b4b1856:
    "Майклз" "Всё сказанное вами может быть использовано в качестве доказательств."

# ch/cherie/events.rpy:2293
translate russian dwayne_murder_mike_arrest_349f718b:
    "Я плотно сжимаю губы и молчу, пока Майклз зачитывает мне права."

# ch/cherie/events.rpy:2294
translate russian dwayne_murder_mike_arrest_9a9e26a3:
    "Закончив, детектив кивает Камиле."

# ch/cherie/events.rpy:2296
translate russian dwayne_murder_mike_arrest_3d0fec1e:
    "Она подходит, достаёт наручники и защёлкивает их у меня на запястьях."

# ch/cherie/events.rpy:2297
translate russian dwayne_murder_mike_arrest_fcdc93c1:
    "При этом она стоит так близко, что никто другой не может нас услышать."

# ch/cherie/events.rpy:2299
translate russian dwayne_murder_mike_arrest_e752a80a:
    camila.say "Доказательства против тебя неопровержимы."

# ch/cherie/events.rpy:2300
translate russian dwayne_murder_mike_arrest_1af7b435:
    camila.say "Что за маньяк хранит труп своей жертвы на память?!"

# ch/cherie/events.rpy:2301
translate russian dwayne_murder_mike_arrest_3e9dcd05:
    camila.say "Надеюсь, тебя запрут и выбросят ключ!"

# ch/cherie/events.rpy:2303
translate russian dwayne_murder_mike_arrest_5531be8e:
    "Я мог бы что-нибудь ответить."

# ch/cherie/events.rpy:2304
translate russian dwayne_murder_mike_arrest_4133f1a8:
    "Но что мне это даст?"

# ch/cherie/events.rpy:2305
translate russian dwayne_murder_mike_arrest_c0a1b62b:
    "Если Камила говорит правду, конечно же, она будет меня ненавидеть."

# ch/cherie/events.rpy:2306
translate russian dwayne_murder_mike_arrest_38ccd891:
    "Нет, лучше промолчать и попытаться сохранить хоть крупицу достоинства."

# ch/cherie/events.rpy:2309
translate russian dwayne_murder_mike_arrest_3e27bb81:
    "Из других комнат доносятся голоса моих соседок, но я не разбираю ни слова."

# ch/cherie/events.rpy:2310
translate russian dwayne_murder_mike_arrest_84c1f183:
    "Должно быть, полицейские не дают им вмешаться в мой арест."

# ch/cherie/events.rpy:2312
translate russian dwayne_murder_mike_arrest_fd5c35cf:
    "Но меня уже выводят наружу, и я не могу оглянуться."

# ch/cherie/events.rpy:2313
translate russian dwayne_murder_mike_arrest_e9daf0f5:
    "Что ж, похоже, на этом моя история заканчивается — по крайней мере, история свободного человека."

# ch/cherie/events.rpy:2318
translate russian dwayne_murder_mike_arrest_b93411e5:
    "Дуэйн мёртв, Алетта вырвалась из его щупалец, а Шери получает компанию."

# ch/cherie/events.rpy:2319
translate russian dwayne_murder_mike_arrest_0560ff9e:
    "А мне, видимо, достаётся вина за всё это."

# ch/cherie/events.rpy:2320
translate russian dwayne_murder_mike_arrest_735d94f9:
    "И отдельная камера, где можно сидеть и размышлять, в какой момент всё пошло не так."
