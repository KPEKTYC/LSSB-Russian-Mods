# ch/harems_full/college/events.rpy:1233
translate russian anna_bree_propose_male_bf26ee8b:
    "Конечно, я хочу, чтобы [bree.name] стала моей женой, но как же Анна?"

# ch/harems_full/college/events.rpy:1234
translate russian anna_bree_propose_male_54e91897_1:
    "Сможем ли мы остаться втроём, если она не вступит с нами в брак?"

# ch/harems_full/college/events.rpy:1247
translate russian anna_bree_male_ending_411f6ee2:
    "Часовня полна гостей, пришедших поддержать двух невест и жениха."

# ch/harems_full/college/events.rpy:1248
translate russian anna_bree_male_ending_01ac6644:
    "Оглядываюсь и вижу среди них своих друзей и родных."

# ch/harems_full/college/events.rpy:1249
translate russian anna_bree_male_ending_820f841a:
    "Но узнаю и некоторых из тех, кого пригласили Анна и [bree.name]."

# ch/harems_full/college/events.rpy:1250
translate russian anna_bree_male_ending_16ab4321:
    "Конечно, Саша сидит прямо в первом ряду, по центру."

# ch/harems_full/college/events.rpy:1251
translate russian anna_bree_male_ending_0322d6d9:
    "Она ведь живёт с нами: [bree.name], я и Саша делим один дом."

# ch/harems_full/college/events.rpy:1252
translate russian anna_bree_male_ending_4a68308d:
    "К тому же она играет в одной группе с Анной, и они хорошие подруги."

# ch/harems_full/college/events.rpy:1253
translate russian anna_bree_male_ending_cb8685ec:
    "Рядом с ней сидит Клео, та самая колючая вокалистка группы."

# ch/harems_full/college/events.rpy:1254
translate russian anna_bree_male_ending_a5f8c74e:
    "Когда я обвожу взглядом зал, наши глаза встречаются."

# ch/harems_full/college/events.rpy:1255
translate russian anna_bree_male_ending_0e18e1cb:
    "Саша улыбается и машет мне, а Клео показывает язык и два пальца."

# ch/harems_full/college/events.rpy:1256
translate russian anna_bree_male_ending_272adb0f:
    "Но я достаточно хорошо её знаю, чтобы не обижаться: так она проявляет дружелюбие!"

# ch/harems_full/college/events.rpy:1257
translate russian anna_bree_male_ending_3d823d74:
    "Уже думаю ответить тем же, когда часовню наполняет музыка."

# ch/harems_full/college/events.rpy:1258
translate russian anna_bree_male_ending_0ad77767:
    "Моё внимание тут же переключается на двери: они открываются, впуская невест."

# ch/harems_full/college/events.rpy:1262
translate russian anna_bree_male_ending_cecde08b:
    "Анна и [bree.name] входят вместе и идут к алтарю бок о бок."

# ch/harems_full/college/events.rpy:1265
translate russian anna_bree_male_ending_402beab3:
    "Первой мне, конечно, бросается в глаза [bree.name] — просто потому, что она выше."

# ch/harems_full/college/events.rpy:1266
translate russian anna_bree_male_ending_3d5cc903:
    "Светлые волосы покачиваются при ходьбе, а голубые глаза сияют."

# ch/harems_full/college/events.rpy:1267
translate russian anna_bree_male_ending_55e853fe:
    "И платье скроено идеально."

# ch/harems_full/college/events.rpy:1268
translate russian anna_bree_male_ending_4fcffcd6:
    "Оно подчёркивает фигуру, оставаясь изящным."

# ch/harems_full/college/events.rpy:1270
translate russian anna_bree_male_ending_d37814f3:
    "Даже округлившийся живот учтён."

# ch/harems_full/college/events.rpy:1271
translate russian anna_bree_male_ending_9ca0cac5:
    "Платье подчёркивает её беременность, а не пытается её скрыть."

# ch/harems_full/college/events.rpy:1272
translate russian anna_bree_male_ending_4b9c0af3:
    "Затем перевожу взгляд на Анну и вновь понимаю, как сильно её обожаю."

# ch/harems_full/college/events.rpy:1273
translate russian anna_bree_male_ending_f769c22b:
    "Миниатюрная и полная жизни, она неизбежно притягивает взгляд."

# ch/harems_full/college/events.rpy:1274
translate russian anna_bree_male_ending_6cb18b32:
    "А в этом платье выглядит прекраснее, чем когда-либо!"

# ch/harems_full/college/events.rpy:1276
translate russian anna_bree_male_ending_c1aa0c87:
    "К тому же оно подчёркивает её живот."

# ch/harems_full/college/events.rpy:1277
translate russian anna_bree_male_ending_cf227a87:
    "И мне так нравится видеть, как Анна носит нашего ребёнка."

# ch/harems_full/college/events.rpy:1278
translate russian anna_bree_male_ending_405f3e77:
    "Это добавляет зрелой женственности её обычно девичьему нраву."

# ch/harems_full/college/events.rpy:1281
translate russian anna_bree_male_ending_190b9471:
    "Возможность любоваться ими заканчивается, когда они подходят к алтарю."

# ch/harems_full/college/events.rpy:1282
translate russian anna_bree_male_ending_8c0227f4:
    "Готовясь к церемонии, мы только улыбаемся и краснеем."

# ch/harems_full/college/events.rpy:1286
translate russian anna_bree_male_ending_8bfbfcf3:
    "Стоит священнику кашлянуть, как все в часовне замирают."

# ch/harems_full/college/events.rpy:1288
translate russian anna_bree_male_ending_d601e095:
    "Священник" "Мы собрались здесь сегодня..."

# ch/harems_full/college/events.rpy:1289
translate russian anna_bree_male_ending_d97c7e24:
    "Священник" "Чтобы соединить этих троих..."

# ch/harems_full/college/events.rpy:1290
translate russian anna_bree_male_ending_9182c80f:
    "Священник" "Священными узами брака."

# ch/harems_full/college/events.rpy:1291
translate russian anna_bree_male_ending_c285bc74:
    "Что происходит дальше, вы знаете."

# ch/harems_full/college/events.rpy:1292
translate russian anna_bree_male_ending_f6333014:
    "Священник произносит все положенные слова."

# ch/harems_full/college/events.rpy:1293
translate russian anna_bree_male_ending_fa16ee28:
    "И до самих клятв ничего особенного не случается."

# ch/harems_full/college/events.rpy:1294
translate russian anna_bree_male_ending_30bc8367:
    "Так что немного перемотаем вперёд..."

# ch/harems_full/college/events.rpy:1295
translate russian anna_bree_male_ending_9646d0d5:
    "Священник" "Согласны ли вы, Анна..."

# ch/harems_full/college/events.rpy:1296
translate russian anna_bree_male_ending_54ecd1b6:
    "Священник" "Взять этих двоих..."

# ch/harems_full/college/events.rpy:1297
translate russian anna_bree_male_ending_8c7361cd:
    "Священник" "В законные супруги?"

# ch/harems_full/college/events.rpy:1299
translate russian anna_bree_male_ending_a42bb97a:
    anna.say "Ещё как согласна!"

# ch/harems_full/college/events.rpy:1300
translate russian anna_bree_male_ending_abc6242b:
    "Священник" "Кхм..."

# ch/harems_full/college/events.rpy:1301
translate russian anna_bree_male_ending_97df1d8c:
    "Священник" "Да, да, прекрасно."

# ch/harems_full/college/events.rpy:1302
translate russian anna_bree_male_ending_3167e5e5:
    "Священник" "Согласны ли вы, [bree.name]..."

# ch/harems_full/college/events.rpy:1303
translate russian anna_bree_male_ending_54ecd1b6_1:
    "Священник" "Взять этих двоих..."

# ch/harems_full/college/events.rpy:1304
translate russian anna_bree_male_ending_8c7361cd_1:
    "Священник" "В законные супруги?"

# ch/harems_full/college/events.rpy:1306
translate russian anna_bree_male_ending_d5c27cda:
    bree.say "Согласна."

# ch/harems_full/college/events.rpy:1307
translate russian anna_bree_male_ending_d034391f:
    "Священник" "А вы, [lssb_common.hero_name()], согласны..."

# ch/harems_full/college/events.rpy:1308
translate russian anna_bree_male_ending_54ecd1b6_2:
    "Священник" "Взять этих двоих..."

# ch/harems_full/college/events.rpy:1309
translate russian anna_bree_male_ending_8c7361cd_2:
    "Священник" "В законные супруги?"

# ch/harems_full/college/events.rpy:1310
translate russian anna_bree_male_ending_cc481164:
    mike.say "Согласен."

# ch/harems_full/college/events.rpy:1311
translate russian anna_bree_male_ending_5ad281d7:
    "Священник" "Обращаюсь ко всем присутствующим..."

# ch/harems_full/college/events.rpy:1312
translate russian anna_bree_male_ending_2b07aa78:
    "Священник" "Если вам известны законные причины..."

# ch/harems_full/college/events.rpy:1313
translate russian anna_bree_male_ending_8c2768bb:
    "Священник" "По которым эти трое не могут вступить в брак..."

# ch/harems_full/college/events.rpy:1314
translate russian anna_bree_male_ending_713d080b:
    "Священник" "Скажите сейчас или молчите вечно!"

# ch/harems_full/college/events.rpy:1315
translate russian anna_bree_male_ending_4d558ce8:
    "Анна, [bree.name] и я нервно переглядываемся и тихонько смеёмся."

# ch/harems_full/college/events.rpy:1316
translate russian anna_bree_male_ending_723c9b5e:
    "Но, к счастью, никто не решает возразить."

# ch/harems_full/college/events.rpy:1317
translate russian anna_bree_male_ending_d00b3666:
    "Священник" "Очень хорошо."

# ch/harems_full/college/events.rpy:1318
translate russian anna_bree_male_ending_874b6270:
    "Священник" "Тогда с радостью объявляю вас супругами."

# ch/harems_full/college/events.rpy:1319
translate russian anna_bree_male_ending_bb79df60:
    "Священник" "Можете отметить это так, как сочтёте нужным."

# ch/harems_full/college/events.rpy:1320
translate russian anna_bree_male_ending_a18559fa:
    "Я понимаю, почему священник выбрал именно такие слова."

# ch/harems_full/college/events.rpy:1321
translate russian anna_bree_male_ending_3c550628:
    "Но для нас это может означать только поцелуй!"

# ch/harems_full/college/events.rpy:1325
translate russian anna_bree_male_ending_9766c76f:
    "Анна, [bree.name] и я обнимаемся и сливаемся в долгом поцелуе."

# ch/harems_full/college/events.rpy:1326
translate russian anna_bree_male_ending_6130138a:
    "Словно никто не хочет, чтобы этот миг заканчивался, и не желает первым разомкнуть объятия."

# ch/harems_full/college/events.rpy:1327
translate russian anna_bree_male_ending_45a0b049:
    "Поцелуй длится долго, и я наслаждаюсь каждой секундой!"

# ch/harems_full/college/events.rpy:1333
translate russian anna_bree_male_ending_3bd22290:
    anna.say "О-о!"

# ch/harems_full/college/events.rpy:1334
translate russian anna_bree_male_ending_258d1d15:
    anna.say "Это будет ТАК круто, [bree.name]!"

# ch/harems_full/college/events.rpy:1336
translate russian anna_bree_male_ending_143acf55:
    bree.say "Правда?"

# ch/harems_full/college/events.rpy:1338
translate russian anna_bree_male_ending_ff6cb021:
    anna.say "Конечно!"

# ch/harems_full/college/events.rpy:1339
translate russian anna_bree_male_ending_f3ab84fa:
    anna.say "Хоть раз говорить будем мы."

# ch/harems_full/college/events.rpy:1341
translate russian anna_bree_male_ending_487f4e13:
    anna.say "А не [lssb_common.hero_name()], который всем рассказывает, как оно есть!"

# ch/harems_full/college/events.rpy:1342
translate russian anna_bree_male_ending_9ada12e8:
    bree.say "Хм..."

# ch/harems_full/college/events.rpy:1344
translate russian anna_bree_male_ending_8d3fc5d5:
    bree.say "Пожалуй, ты права, Анна."

# ch/harems_full/college/events.rpy:1345
translate russian anna_bree_male_ending_ba0c21e0:
    bree.say "Нам тоже стоит дать слово, чтобы рассказать свою версию."

# ch/harems_full/college/events.rpy:1347
translate russian anna_bree_male_ending_45ed99c9:
    anna.say "И мы обе знаем, кого нужно поблагодарить в первую очередь."

# ch/harems_full/college/events.rpy:1349
translate russian anna_bree_male_ending_263a788f:
    bree.say "Правда?"

# ch/harems_full/college/events.rpy:1350
translate russian anna_bree_male_ending_3c760198:
    anna.say "Конечно!"

# ch/harems_full/college/events.rpy:1351
translate russian anna_bree_male_ending_1e29b8fc:
    anna.say "Сашу!"

# ch/harems_full/college/events.rpy:1353
translate russian anna_bree_male_ending_03df5abb:
    bree.say "САШУ?!"

# ch/harems_full/college/events.rpy:1354
translate russian anna_bree_male_ending_a1408e9c:
    bree.say "А она тут при чём?"

# ch/harems_full/college/events.rpy:1355
translate russian anna_bree_male_ending_cf579c81:
    anna.say "Ну же, [bree.name], ты и сама всё понимаешь!"

# ch/harems_full/college/events.rpy:1356
translate russian anna_bree_male_ending_29f111b0:
    anna.say "Если бы Саша к вам не переехала, я бы так и не узнала, что есть такой [lssb_common.hero_name()]."

# ch/harems_full/college/events.rpy:1358
translate russian anna_bree_male_ending_3cd39562:
    bree.say "Ну, это правда."

# ch/harems_full/college/events.rpy:1359
translate russian anna_bree_male_ending_1105a72d:
    bree.say "А если бы она не крутилась по дому..."

# ch/harems_full/college/events.rpy:1361
translate russian anna_bree_male_ending_a030aa64:
    bree.say "[lssb_common.hero_name()] мог бы и не понять, насколько я сексуальнее неё!"

# ch/harems_full/college/events.rpy:1363
translate russian anna_bree_male_ending_94c797e7:
    anna.say "БРИ!"

# ch/harems_full/college/events.rpy:1365
translate russian anna_bree_male_ending_dd2b9435:
    bree.say "Шучу!"

# ch/harems_full/college/events.rpy:1367
translate russian anna_bree_male_ending_dbf686b9:
    anna.say "Ладно, [bree.name], хватит язвить!"

# ch/harems_full/college/events.rpy:1370
translate russian anna_bree_male_ending_bfec3cf0:
    bree.say "Пожалуй, нам и правда есть о чём поговорить."

# ch/harems_full/college/events.rpy:1371
translate russian anna_bree_male_ending_ab276fc3:
    bree.say "Как-никак мы состояли в отношениях втроём и поженились."

# ch/harems_full/college/events.rpy:1372
translate russian anna_bree_male_ending_10a9ed02:
    anna.say "О да."

# ch/harems_full/college/events.rpy:1373
translate russian anna_bree_male_ending_4da179cc:
    anna.say "Раньше я встречалась и с парнями, и с девушками."

# ch/harems_full/college/events.rpy:1374
translate russian anna_bree_male_ending_57b96470:
    anna.say "Но никогда одновременно."

# ch/harems_full/college/events.rpy:1376
translate russian anna_bree_male_ending_b6604ab3:
    anna.say "И уж точно не думала, что вступлю в брак и с тем, и с другой!"

# ch/harems_full/college/events.rpy:1378
translate russian anna_bree_male_ending_54eadd4a:
    bree.say "Мне нравится, как ты это сказала, Анна."

# ch/harems_full/college/events.rpy:1379
translate russian anna_bree_male_ending_913f822c:
    bree.say "Будто собрала полный комплект!"

# ch/harems_full/college/events.rpy:1381
translate russian anna_bree_male_ending_4d9b792a:
    anna.say "Но [lssb_common.hero_name()] ведь замечательный, правда?"

# ch/harems_full/college/events.rpy:1382
translate russian anna_bree_male_ending_2d5fec6b:
    anna.say "Например, он разрешил мне остаться в группе после свадьбы."

# ch/harems_full/college/events.rpy:1384
translate russian anna_bree_male_ending_73797ed4:
    bree.say "А он тут при чём, Анна?"

# ch/harems_full/college/events.rpy:1385
translate russian anna_bree_male_ending_b8858360:
    bree.say "Ты ведь осталась в группе, потому что сама этого хотела?"

# ch/harems_full/college/events.rpy:1387
translate russian anna_bree_male_ending_a5ddd076:
    anna.say "Да, но он был не против!"

# ch/harems_full/college/events.rpy:1388
translate russian anna_bree_male_ending_c3ad303c:
    anna.say "Это тоже кое-что значит."

# ch/harems_full/college/events.rpy:1391
translate russian anna_bree_male_ending_34fda1e8:
    bree.say "Да, да..."

# ch/harems_full/college/events.rpy:1392
translate russian anna_bree_male_ending_bab4e088:
    bree.say "Пожалуй, он и меня поддержал, когда я захотела продолжить работать."

# ch/harems_full/college/events.rpy:1393
translate russian anna_bree_male_ending_866d6379:
    bree.say "Не стал упрекать за то, что я всё ещё официантка."

# ch/harems_full/college/events.rpy:1395
translate russian anna_bree_male_ending_82f2cde3:
    anna.say "Вот видишь, [bree.name], я же говорила, что он замечательный!"

# ch/harems_full/college/events.rpy:1398
translate russian anna_bree_male_ending_34fda1e8_1:
    bree.say "Да, да..."

# ch/harems_full/college/events.rpy:1399
translate russian anna_bree_male_ending_bab4e088_1:
    bree.say "Пожалуй, он и меня поддержал, когда я захотела продолжить работать."

# ch/harems_full/college/events.rpy:1400
translate russian anna_bree_male_ending_8011dfdd:
    bree.say "Не стал упрекать за то, что я всё ещё профессионально играю."

# ch/harems_full/college/events.rpy:1402
translate russian anna_bree_male_ending_82f2cde3_1:
    anna.say "Вот видишь, [bree.name], я же говорила, что он замечательный!"

# ch/harems_full/college/events.rpy:1420
translate russian anna_bree_male_ending_45f7af48:
    bree.say "Семейная жизнь тоже оказалась очень даже хороша."

# ch/harems_full/college/events.rpy:1422
translate russian anna_bree_male_ending_70bdfb71:
    bree.say "Должна признать."

# ch/harems_full/college/events.rpy:1424
translate russian anna_bree_male_ending_0f56d2a7:
    anna.say "О, с тех пор как я переехала к вам, всё стало гораздо лучше."

# ch/harems_full/college/events.rpy:1425
translate russian anna_bree_male_ending_6bedbf5e:
    anna.say "Жаль только, что Саше пришлось съехать!"

# ch/harems_full/college/events.rpy:1427
translate russian anna_bree_male_ending_9cbd7bc8:
    bree.say "Не знаю, Анна."

# ch/harems_full/college/events.rpy:1428
translate russian anna_bree_male_ending_70357a92:
    bree.say "Здесь уже становилось тесновато."

# ch/harems_full/college/events.rpy:1430
translate russian anna_bree_male_ending_66a7f484:
    anna.say "Хм..."

# ch/harems_full/college/events.rpy:1431
translate russian anna_bree_male_ending_aa99eec1:
    anna.say "Наверное, особенно с маленьким Томми, который носится по всему дому!"

# ch/harems_full/college/events.rpy:1432
translate russian anna_bree_male_ending_e240ac2a:
    bree.say "Ага, в основном изматывая папочку!"

# ch/harems_full/college/events.rpy:1433
translate russian anna_bree_male_ending_01f2997f:
    anna.say "А Брианна?"

# ch/harems_full/college/events.rpy:1434
translate russian anna_bree_male_ending_9059b50e:
    anna.say "С ней тоже не соскучишься!"

# ch/harems_full/college/events.rpy:1435
translate russian anna_bree_male_ending_dca9140c:
    bree.say "Можешь не напоминать!"

# ch/harems_full/college/events.rpy:1437
translate russian anna_bree_male_ending_66a7f484_1:
    anna.say "Хм..."

# ch/harems_full/college/events.rpy:1438
translate russian anna_bree_male_ending_aa99eec1_1:
    anna.say "Наверное, особенно с маленьким Томми, который носится по всему дому!"

# ch/harems_full/college/events.rpy:1439
translate russian anna_bree_male_ending_e240ac2a_1:
    bree.say "Ага, в основном изматывая папочку!"

# ch/harems_full/college/events.rpy:1441
translate russian anna_bree_male_ending_01f2997f_1:
    anna.say "А Брианна?"

# ch/harems_full/college/events.rpy:1442
translate russian anna_bree_male_ending_9059b50e_1:
    anna.say "С ней тоже не соскучишься!"

# ch/harems_full/college/events.rpy:1443
translate russian anna_bree_male_ending_dca9140c_1:
    bree.say "Можешь не напоминать!"

# ch/harems_full/college/events.rpy:1445
translate russian anna_bree_male_ending_345b19e2:
    anna.say "Да, но для небольшого пополнения место ещё найдётся."

# ch/harems_full/college/events.rpy:1446
translate russian anna_bree_male_ending_2ba36b18:
    anna.say "Если понимаешь, о чём я."

# ch/harems_full/college/events.rpy:1447
translate russian anna_bree_male_ending_faf3bbd3:
    bree.say "Ещё как понимаю, Анна."

# ch/harems_full/college/events.rpy:1448
translate russian anna_bree_male_ending_3d8200ea:
    bree.say "И когда это случится, [lssb_common.hero_name()] просто не будет знать, что на него свалилось!"

# ch/harems_full/college/events.rpy:1449
translate russian anna_bree_male_ending_e3d94f31:
    anna.say "По-моему, у нас всё отлично сложилось, [bree.name]."

# ch/harems_full/college/events.rpy:1451
translate russian anna_bree_male_ending_0f6b5ddc:
    bree.say "Знаешь, Анна, ты права."

# ch/harems_full/college/events.rpy:1452
