# ch/harems_full/college/events.rpy:1196
translate russian anna_bree_propose_male_4799ceba:
    "Конечно, я хочу жениться на Анне, но как же [bree.name]?"

# ch/harems_full/college/events.rpy:1197
translate russian anna_bree_propose_male_54e91897:
