# ch/gen/events.rpy:78
translate russian landlord_house_offer_d5d014ad:
    mike.say "Ясно... Буду иметь в виду."

# ch/gen/events.rpy:86
translate russian house_purchase_deal_0d5865e9:
    mike.say "Договорились. Я переведу деньги сегодня."

# ch/gen/events.rpy:87
translate russian house_purchase_deal_b5a54ab9:
    "Хозяин дома" "Вот это да. Сегодня после обеда пришлю тебе документы."

# ch/gen/events.rpy:88
translate russian house_purchase_deal_b2c15464:
    "Хозяин дома" "Приятно иметь с вами дело, мистер [hero.family_name]."

# ch/gen/events.rpy:90
translate russian house_purchase_deal_c13b4242:
    "Вот так, за скромную сумму в [house_price]{image=gui/icons/icon_money.png}, дом становится моим."

# ch/gen/events.rpy:91
translate russian house_purchase_deal_f72771a9:
    "Больше никакой арендной платы по понедельникам. Отныне каждый заработанный цент остаётся у меня."

# ch/gen/events.rpy:99
translate russian call_buy_house_561ab99d:
