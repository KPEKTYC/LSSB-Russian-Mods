# da/date_restaurant.rpy:286
translate russian date_restaurant_noisykids_eecd2324:
    "[date_girl.name] тоже слышит его — безошибочно узнаваемый гвалт целой семьи, пришедшей вместе поесть."

# da/date_restaurant.rpy:288
translate russian date_restaurant_noisykids_b9dc3fcb:
