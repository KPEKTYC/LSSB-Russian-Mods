# ch/harems_full/criminal/events.rpy:1256
translate russian criminal_harem_event_04_27f3b593_2:
    mike.say "Но у меня ещё осталось местечко!"

# ch/harems_full/criminal/events.rpy:1257
translate russian criminal_harem_event_04_f216b043_2:
    "Чувствую, что нужно подкрепить слова делом."

# ch/harems_full/criminal/events.rpy:1258
translate russian criminal_harem_event_04_2c6620f6:
    "Поэтому показываю вилкой на тарелки Камилы и Лекси."

# ch/harems_full/criminal/events.rpy:1259
translate russian criminal_harem_event_04_a491db95_2:
    mike.say "Вы это будете доедать?"

# ch/harems_full/criminal/events.rpy:1260
translate russian criminal_harem_event_04_1f59d342_1:
    "Камила изумлённо качает головой."

# ch/harems_full/criminal/events.rpy:1262
translate russian criminal_harem_event_04_7243d4ed_1:
    camila.say "Нет, наверное..."

# ch/harems_full/criminal/events.rpy:1263
translate russian criminal_harem_event_04_63c0bd1d_1:
    "Лекси хмурится и качает головой."

# ch/harems_full/criminal/events.rpy:1264
translate russian criminal_harem_event_04_3c2b7372_1:
    lexi.say "Не-а, больше ни кусочка не влезет!"

# ch/harems_full/criminal/events.rpy:1266
translate russian criminal_harem_event_04_304208e1_2:
    mike.say "Тогда передавайте сюда!"

# ch/harems_full/criminal/events.rpy:1267
translate russian criminal_harem_event_04_9deeb8fa:
    "Протягиваю руки и забираю тарелки."

# ch/harems_full/criminal/events.rpy:1268
translate russian criminal_harem_event_04_c2f6a3bf:
    "Затем принимаюсь уничтожать остатки ужина Камилы и Лекси."

# ch/harems_full/criminal/events.rpy:1269
translate russian criminal_harem_event_04_462a1715:
    "При этом замечаю, что они начинают краснеть."

# ch/harems_full/criminal/events.rpy:1272
translate russian criminal_harem_event_04_93067e8b:
    "На мгновение задумываюсь, не смущаю ли я девушек."

# ch/harems_full/criminal/events.rpy:1273
translate russian criminal_harem_event_04_b0bc987c:
    "Затем убеждаю себя, что им, скорее всего, стыдно за себя."

# ch/harems_full/criminal/events.rpy:1274
translate russian criminal_harem_event_04_2c288921_2:
    "Надо же: отдать столько денег за еду, которую не можешь доесть!"

# ch/harems_full/criminal/events.rpy:1278
translate russian criminal_harem_event_04_ed74befd:
    mike.say "Сейчас я не голоден."

# ch/harems_full/criminal/events.rpy:1279
translate russian criminal_harem_event_04_7f1e9afb:
    mike.say "Но вы не против, если я попрошу официанта упаковать остатки с собой?"

# ch/harems_full/criminal/events.rpy:1280
translate russian criminal_harem_event_04_768fca53:
    mike.say "Еда здесь такая дорогая."

# ch/harems_full/criminal/events.rpy:1281
translate russian criminal_harem_event_04_032ac204:
    mike.say "Жаль, если пропадёт!"

# ch/harems_full/criminal/events.rpy:1282
translate russian criminal_harem_event_04_e20bf92a:
    "Честно говоря, ожидаю возражений от Камилы и Лекси."

# ch/harems_full/criminal/events.rpy:1283
translate russian criminal_harem_event_04_145285c6:
    "Но, обдумав предложение, они, кажется, соглашаются."

# ch/harems_full/criminal/events.rpy:1286
translate russian criminal_harem_event_04_86d4b208:
    camila.say "Почему бы и нет, [lssb_common.hero_name()]."

# ch/harems_full/criminal/events.rpy:1287
translate russian criminal_harem_event_04_c5160cd5:
    camila.say "Меня беспокоили расходы."

# ch/harems_full/criminal/events.rpy:1288
translate russian criminal_harem_event_04_6ebaaf12:
    camila.say "Но раз еду всё-таки съедят, уже не так обидно."

# ch/harems_full/criminal/events.rpy:1289
translate russian criminal_harem_event_04_395f7378:
    "Лекси кивает и тоже вступает в разговор."

# ch/harems_full/criminal/events.rpy:1290
translate russian criminal_harem_event_04_1ff0f54e:
    lexi.say "Нет ничего плохого в том, чтобы забрать остатки."

# ch/harems_full/criminal/events.rpy:1291
translate russian criminal_harem_event_04_07c628e5:
    lexi.say "Бережливость никогда не выходит из моды!"

# ch/harems_full/criminal/events.rpy:1292
translate russian criminal_harem_event_04_f4d6adb6:
    "Я киваю и подзываю официанта."

# ch/harems_full/criminal/events.rpy:1293
translate russian criminal_harem_event_04_d88fc617:
    "Затем тихо излагаю ему просьбу."

# ch/harems_full/criminal/events.rpy:1294
translate russian criminal_harem_event_04_44d4ec68:
    "Он кивает и начинает убирать тарелки."

# ch/harems_full/criminal/events.rpy:1295
translate russian criminal_harem_event_04_52ec1441:
    "Закончив, спешит выполнить мою просьбу."

# ch/harems_full/criminal/events.rpy:1301
translate russian criminal_harem_event_04_eb73048b:
    "Ужин окончен, и официант приносит счёт."

# ch/harems_full/criminal/events.rpy:1302
translate russian criminal_harem_event_04_05676b13:
    "Он лежит в кожаной папке, скрывающей итоговую сумму."

# ch/harems_full/criminal/events.rpy:1303
translate russian criminal_harem_event_04_e2bbb337:
    "Мы по очереди заглядываем внутрь и морщимся."

# ch/harems_full/criminal/events.rpy:1305
translate russian criminal_harem_event_04_b8e0d5b6:
    camila.say "Ох!"

# ch/harems_full/criminal/events.rpy:1306
translate russian criminal_harem_event_04_62eb7224:
    camila.say "Хорошо, что мы нечасто так ужинаем."

# ch/harems_full/criminal/events.rpy:1307
translate russian criminal_harem_event_04_9ee6e110:
    camila.say "А то пришлось бы начать брать взятки, чтобы платить за себя!"

# ch/harems_full/criminal/events.rpy:1309
translate russian criminal_harem_event_04_f38add70:
    lexi.say "О-о..."

# ch/harems_full/criminal/events.rpy:1310
translate russian criminal_harem_event_04_aad07096:
    lexi.say "Может, вы всё-таки не против смыться, не заплатив?"

# ch/harems_full/criminal/events.rpy:1311
translate russian criminal_harem_event_04_108d3921:
    "За это предложение мы с Камилой одариваем Лекси суровыми взглядами."

# ch/harems_full/criminal/events.rpy:1313
translate russian criminal_harem_event_04_7727b68f:
    lexi.say "Шучу!"

# ch/harems_full/criminal/events.rpy:1315
translate russian criminal_harem_event_04_b26be9c1:
    lexi.say "Я просто пошутила!"

# ch/harems_full/criminal/events.rpy:1316
translate russian criminal_harem_event_04_c793709b:
    mike.say "Понимаю, сумма кажется большой."

# ch/harems_full/criminal/events.rpy:1317
translate russian criminal_harem_event_04_cd49e39d:
    mike.say "Но и свидание у нас особенное."

# ch/harems_full/criminal/events.rpy:1318
translate russian criminal_harem_event_04_f5c146aa:
    mike.say "И еда была отличной."

# ch/harems_full/criminal/events.rpy:1319
translate russian criminal_harem_event_04_28798e4f:
    mike.say "Так сколько оставим на чай — двадцать пять процентов?"

# ch/harems_full/criminal/events.rpy:1320
translate russian criminal_harem_event_04_4b305b79:
    "Камила и Лекси резко втягивают воздух."

# ch/harems_full/criminal/events.rpy:1321
translate russian criminal_harem_event_04_1a366575:
    "Затем обе начинают качать головами."

# ch/harems_full/criminal/events.rpy:1322
translate russian criminal_harem_event_04_2f4d542d:
    lexi.say "Конечно, чаевые оставить надо."

# ch/harems_full/criminal/events.rpy:1324
translate russian criminal_harem_event_04_0eb2ced7:
    lexi.say "Но десяти процентов более чем достаточно."

# ch/harems_full/criminal/events.rpy:1325
translate russian criminal_harem_event_04_a580e248:
    camila.say "О чём вы вообще?"

# ch/harems_full/criminal/events.rpy:1326
translate russian criminal_harem_event_04_51af44a3:
    camila.say "Мы же оплатим счёт."

# ch/harems_full/criminal/events.rpy:1328
translate russian criminal_harem_event_04_edfb8a68:
    camila.say "Зачем ещё оставлять чаевые?"

# ch/harems_full/criminal/events.rpy:1331
translate russian criminal_harem_event_04_c052b745:
    mike.say "Двадцать пять процентов — вполне обычные чаевые, девочки."

# ch/harems_full/criminal/events.rpy:1332
translate russian criminal_harem_event_04_89ea756c:
    mike.say "Примерно столько нужно, чтобы официанты нормально зарабатывали."

# ch/harems_full/criminal/events.rpy:1333
translate russian criminal_harem_event_04_3654eb7d:
    mike.say "Если вы столько не оставите, я доплачу сам."

# ch/harems_full/criminal/events.rpy:1334
translate russian criminal_harem_event_04_6b4a9194:
    "Понимаю, что симпатий Камилы и Лекси это мне не прибавляет."

# ch/harems_full/criminal/events.rpy:1335
translate russian criminal_harem_event_04_efc2d897:
    "Но скрещиваю руки на груди, давая понять, что не отступлю."

# ch/harems_full/criminal/events.rpy:1336
translate russian criminal_harem_event_04_0ba32ade:
    "В конце концов первой сдаётся Камила."

# ch/harems_full/criminal/events.rpy:1337
translate russian criminal_harem_event_04_d4bb7583:
    camila.say "Ладно, уговорил. Но только на этот раз!"

# ch/harems_full/criminal/events.rpy:1339
translate russian criminal_harem_event_04_c53a58a7:
    camila.say "Представь, если бы я просила чаевые перед арестом, ради бога!"

# ch/harems_full/criminal/events.rpy:1340
translate russian criminal_harem_event_04_ea7a4da1:
    "Уступка Камилы, похоже, ослабляет и решимость Лекси."

# ch/harems_full/criminal/events.rpy:1341
translate russian criminal_harem_event_04_4c2bdedf:
    "Вскоре сдаётся и она."

# ch/harems_full/criminal/events.rpy:1342
translate russian criminal_harem_event_04_968319e9:
    lexi.say "Ладно, ладно..."

# ch/harems_full/criminal/events.rpy:1344
translate russian criminal_harem_event_04_cc455a6a:
    lexi.say "Но это грабёж средь бела дня!"

# ch/harems_full/criminal/events.rpy:1345
translate russian criminal_harem_event_04_e02f7c7c:
    "Я предпочитаю не замечать иронии в словах Лекси."

# ch/harems_full/criminal/events.rpy:1346
translate russian criminal_harem_event_04_f9a5b91b:
    "И просто принимаюсь оплачивать счёт."

# ch/harems_full/criminal/events.rpy:1350
translate russian criminal_harem_event_04_c052b745_1:
    mike.say "Двадцать пять процентов — вполне обычные чаевые, девочки."

# ch/harems_full/criminal/events.rpy:1351
translate russian criminal_harem_event_04_89ea756c_1:
    mike.say "Примерно столько нужно, чтобы официанты нормально зарабатывали."

# ch/harems_full/criminal/events.rpy:1352
translate russian criminal_harem_event_04_9d5eae5b:
    mike.say "Но ради мира и согласия оставим десять процентов."

# ch/harems_full/criminal/events.rpy:1353
translate russian criminal_harem_event_04_65f56dab:
    "Понимаю, что симпатий Камилы это мне не прибавляет."

# ch/harems_full/criminal/events.rpy:1354
translate russian criminal_harem_event_04_790c3bdb:
    "Но Лекси вмешивается раньше, чем та успевает возразить."

# ch/harems_full/criminal/events.rpy:1355
translate russian criminal_harem_event_04_82575482:
    lexi.say "Договорились!"

# ch/harems_full/criminal/events.rpy:1357
translate russian criminal_harem_event_04_c79e476c:
    lexi.say "Давай, Камила, раскошеливайся!"

# ch/harems_full/criminal/events.rpy:1358
translate russian criminal_harem_event_04_d4bb7583_1:
    camila.say "Ладно, уговорил. Но только на этот раз!"

# ch/harems_full/criminal/events.rpy:1360
translate russian criminal_harem_event_04_c53a58a7_1:
    camila.say "Представь, если бы я просила чаевые перед арестом, ради бога!"

# ch/harems_full/criminal/events.rpy:1361
translate russian criminal_harem_event_04_36ca4614:
    "Я предпочитаю не замечать нелепости слов Камилы."

# ch/harems_full/criminal/events.rpy:1362
translate russian criminal_harem_event_04_f9a5b91b_1:
    "И просто принимаюсь оплачивать счёт."

# ch/harems_full/criminal/events.rpy:1366
translate russian criminal_harem_event_04_c052b745_2:
    mike.say "Двадцать пять процентов — вполне обычные чаевые, девочки."

# ch/harems_full/criminal/events.rpy:1367
translate russian criminal_harem_event_04_89ea756c_2:
    mike.say "Примерно столько нужно, чтобы официанты нормально зарабатывали."

# ch/harems_full/criminal/events.rpy:1368
translate russian criminal_harem_event_04_b7f59cfc:
    mike.say "Но ради мира и согласия..."

# ch/harems_full/criminal/events.rpy:1369
translate russian criminal_harem_event_04_6927f79c:
    mike.say "На этот раз обойдёмся без чаевых."

# ch/harems_full/criminal/events.rpy:1370
translate russian criminal_harem_event_04_7445d249:
    "Понимаю, что симпатий Лекси это мне не прибавляет."

# ch/harems_full/criminal/events.rpy:1371
translate russian criminal_harem_event_04_ab2b2bd2:
    "Но Камила вмешивается раньше, чем та успевает возразить."

# ch/harems_full/criminal/events.rpy:1372
translate russian criminal_harem_event_04_8f8b7474:
    camila.say "Согласна!"

# ch/harems_full/criminal/events.rpy:1374
translate russian criminal_harem_event_04_1bd712df:
    camila.say "Два против одного, Лекси."

# ch/harems_full/criminal/events.rpy:1375
translate russian criminal_harem_event_04_84ded7d9:
    camila.say "Ты в меньшинстве!"

# ch/harems_full/criminal/events.rpy:1376
translate russian criminal_harem_event_04_968319e9_1:
    lexi.say "Ладно, ладно..."

# ch/harems_full/criminal/events.rpy:1378
translate russian criminal_harem_event_04_c7ad4c0b:
    lexi.say "Но вы обираете бедного официанта!"

# ch/harems_full/criminal/events.rpy:1379
translate russian criminal_harem_event_04_e02f7c7c_1:
    "Я предпочитаю не замечать иронии в словах Лекси."

# ch/harems_full/criminal/events.rpy:1380
translate russian criminal_harem_event_04_f9a5b91b_2:
    "И просто принимаюсь оплачивать счёт."

# ch/harems_full/criminal/events.rpy:1384
translate russian criminal_harem_event_04_c052b745_3:
    mike.say "Двадцать пять процентов — вполне обычные чаевые, девочки."

# ch/harems_full/criminal/events.rpy:1385
translate russian criminal_harem_event_04_89ea756c_3:
    mike.say "Примерно столько нужно, чтобы официанты нормально зарабатывали."

# ch/harems_full/criminal/events.rpy:1386
translate russian criminal_harem_event_04_9d5eae5b_1:
    mike.say "Но ради мира и согласия оставим десять процентов."

# ch/harems_full/criminal/events.rpy:1387
translate russian criminal_harem_event_04_c8a0ddef:
    mike.say "А ты, Камила, можешь вообще не скидываться на чай."

# ch/harems_full/criminal/events.rpy:1388
translate russian criminal_harem_event_04_a28a04fa:
    mike.say "Если тебе так хочется?"

# ch/harems_full/criminal/events.rpy:1389
translate russian criminal_harem_event_04_5434280e:
    "Вижу, что ни Камила, ни Лекси не вполне довольны."

# ch/harems_full/criminal/events.rpy:1392
translate russian criminal_harem_event_04_474ae0cc:
    "Но, похоже, обе готовы смириться."

# ch/harems_full/criminal/events.rpy:1393
translate russian criminal_harem_event_04_088613eb:
    camila.say "Не пытайся вызвать у меня чувство вины."

# ch/harems_full/criminal/events.rpy:1394
translate russian criminal_harem_event_04_c53a58a7_2:
    camila.say "Представь, если бы я просила чаевые перед арестом, ради бога!"

# ch/harems_full/criminal/events.rpy:1395
translate russian criminal_harem_event_04_968319e9_2:
    lexi.say "Ладно, ладно..."

# ch/harems_full/criminal/events.rpy:1396
translate russian criminal_harem_event_04_c7ad4c0b_1:
    lexi.say "Но вы обираете бедного официанта!"

# ch/harems_full/criminal/events.rpy:1397
translate russian criminal_harem_event_04_360e1f94:
    "Я предпочитаю не обращать внимания на слова девушек."

# ch/harems_full/criminal/events.rpy:1398
translate russian criminal_harem_event_04_f9a5b91b_3:
    "И просто принимаюсь оплачивать счёт."

# ch/harems_full/criminal/events.rpy:1399
translate russian criminal_harem_event_04_3cfeb824:
    "Не забываю довести чаевые до двадцати пяти процентов."

# ch/harems_full/criminal/events.rpy:1400
translate russian criminal_harem_event_04_f9827028:
    "Но доплачиваю из своего кармана, пока они не смотрят."

# ch/harems_full/criminal/events.rpy:1405
translate russian criminal_harem_event_04_0343fbac:
    "Возвращаю счёт официанту, ожидая, что он уйдёт."

# ch/harems_full/criminal/events.rpy:1406
translate russian criminal_harem_event_04_70076761:
    "Но он задерживается и негромко кашляет, прикрыв рот ладонью."

# ch/harems_full/criminal/events.rpy:1407
translate russian criminal_harem_event_04_450d8034:
    "Официант" "Желаете что-нибудь ещё, сэр?"

# ch/harems_full/criminal/events.rpy:1408
translate russian criminal_harem_event_04_44e66fb3:
    "Официант" "Чай?"

# ch/harems_full/criminal/events.rpy:1409
translate russian criminal_harem_event_04_8f649d7c:
    "Официант" "Кофе?"

# ch/harems_full/criminal/events.rpy:1410
translate russian criminal_harem_event_04_108c610b:
    "Официант" "Может быть, даже рюмочку чего-нибудь покрепче?"

# ch/harems_full/criminal/events.rpy:1411
translate russian criminal_harem_event_04_caeb16f8:
    "Поглядываю на Камилу и Лекси."

# ch/harems_full/criminal/events.rpy:1412
translate russian criminal_harem_event_04_b4cbcac2:
    mike.say "Что скажете?"

# ch/harems_full/criminal/events.rpy:1413
translate russian criminal_harem_event_04_d0765024:
    mike.say "Я бы выпил кофе."

# ch/harems_full/criminal/events.rpy:1414
translate russian criminal_harem_event_04_51f2c2de:
    "Лекси радостно хлопает в ладоши."

# ch/harems_full/criminal/events.rpy:1415
translate russian criminal_harem_event_04_3c01693b:
    lexi.say "Да ну этот кофе."

# ch/harems_full/criminal/events.rpy:1417
translate russian criminal_harem_event_04_bc659600:
    lexi.say "Мне нравится идея чего-нибудь покрепче!"

# ch/harems_full/criminal/events.rpy:1418
translate russian criminal_harem_event_04_396f36b7:
    "Но Камила качает головой."

# ch/harems_full/criminal/events.rpy:1419
translate russian criminal_harem_event_04_bf016366:
    camila.say "Мы уже расплатились."

# ch/harems_full/criminal/events.rpy:1421
translate russian criminal_harem_event_04_0678fe02:
    camila.say "Пойдём отсюда, пока нас не заставили потратить ещё!"

# ch/harems_full/criminal/events.rpy:1424
translate russian criminal_harem_event_04_3003ca95:
    "Я мог бы согласиться с одной из девушек."

# ch/harems_full/criminal/events.rpy:1425
translate russian criminal_harem_event_04_a46357bd:
    "Но перед чашкой хорошего кофе устоять слишком трудно."

# ch/harems_full/criminal/events.rpy:1426
translate russian criminal_harem_event_04_31c1c1d9:
    mike.say "Крепкий алкоголь или ничего — какие-то крайности!"

# ch/harems_full/criminal/events.rpy:1427
translate russian criminal_harem_event_04_617d88d6:
    mike.say "Думаю, пара чашек кофе станет хорошим компромиссом."

# ch/harems_full/criminal/events.rpy:1428
translate russian criminal_harem_event_04_c1b09a66:
    "Камила и Лекси качают головами, недовольные моим решением."

# ch/harems_full/criminal/events.rpy:1431
translate russian criminal_harem_event_04_364d338f:
    camila.say "Это просто пустая трата денег, [lssb_common.hero_name()]."

# ch/harems_full/criminal/events.rpy:1432
translate russian criminal_harem_event_04_0f67f471:
    camila.say "Можно же пойти куда-нибудь подешевле!"

# ch/harems_full/criminal/events.rpy:1433
translate russian criminal_harem_event_04_b872be27:
    lexi.say "Ну блин..."

# ch/harems_full/criminal/events.rpy:1434
translate russian criminal_harem_event_04_476aee4b:
    lexi.say "Какие же вы СКУЧНЫЕ!"

# ch/harems_full/criminal/events.rpy:1435
translate russian criminal_harem_event_04_99c70600:
    "Я заказываю кофе, стараясь их не слушать."

# ch/harems_full/criminal/events.rpy:1436
translate russian criminal_harem_event_04_4ce57047:
    "И убеждаю себя, что, когда его принесут, они ещё скажут спасибо."

# ch/harems_full/criminal/events.rpy:1440
translate russian criminal_harem_event_04_edf5bb2e:
    "Едва Лекси упоминает что-нибудь покрепче, я передумываю."

# ch/harems_full/criminal/events.rpy:1441
translate russian criminal_harem_event_04_305b894b:
    "Рюмочка крепкого станет прекрасным завершением ужина."

# ch/harems_full/criminal/events.rpy:1442
translate russian criminal_harem_event_04_b7c37e62:
    mike.say "Лекси права, Камила."

# ch/harems_full/criminal/events.rpy:1443
translate russian criminal_harem_event_04_59a795bd:
    mike.say "Мы ведь сегодня выбрались повеселиться."

# ch/harems_full/criminal/events.rpy:1444
translate russian criminal_harem_event_04_fb7e9074:
    mike.say "Так давай немного расслабимся!"

# ch/harems_full/criminal/events.rpy:1446
translate russian criminal_harem_event_04_3cabebbf:
    "Камила качает головой, недовольная моим решением."

# ch/harems_full/criminal/events.rpy:1447
translate russian criminal_harem_event_04_364d338f_1:
    camila.say "Это просто пустая трата денег, [lssb_common.hero_name()]."

# ch/harems_full/criminal/events.rpy:1448
translate russian criminal_harem_event_04_0f67f471_1:
    camila.say "Можно же пойти куда-нибудь подешевле!"

# ch/harems_full/criminal/events.rpy:1449
translate russian criminal_harem_event_04_835c44b5:
    "Зато по лицу Лекси вижу, что она одобряет."

# ch/harems_full/criminal/events.rpy:1453
translate russian criminal_harem_event_04_288cd42f:
    "Едва Камила напоминает о расходах, я передумываю."

# ch/harems_full/criminal/events.rpy:1454
translate russian criminal_harem_event_04_bf9f9539:
    "Словно чувствую, как мой кошелёк трещит по швам!"

# ch/harems_full/criminal/events.rpy:1455
translate russian criminal_harem_event_04_4cf91156:
    mike.say "Камила права, Лекси."

# ch/harems_full/criminal/events.rpy:1456
translate russian criminal_harem_event_04_67e2c96f:
    mike.say "Мы уже немало потратили."

# ch/harems_full/criminal/events.rpy:1457
translate russian criminal_harem_event_04_5a9f44d8:
    mike.say "Выпить всегда можно где-нибудь подешевле."

# ch/harems_full/criminal/events.rpy:1458
translate russian criminal_harem_event_04_cb46b395:
    "Лекси кривит губы, недовольная моим решением."

# ch/harems_full/criminal/events.rpy:1460
translate russian criminal_harem_event_04_b872be27_1:
    lexi.say "Ну блин..."

# ch/harems_full/criminal/events.rpy:1461
translate russian criminal_harem_event_04_476aee4b_1:
    lexi.say "Какие же вы СКУЧНЫЕ!"

# ch/harems_full/criminal/events.rpy:1462
translate russian criminal_harem_event_04_f644a674:
    "Зато по лицу Камилы вижу, что она одобряет."

# ch/harems_full/criminal/events.rpy:1466
translate russian criminal_harem_event_04_4c5217a8:
    "Вдруг вспоминаю, что здесь есть вполне хороший бар."

# ch/harems_full/criminal/events.rpy:1467
translate russian criminal_harem_event_04_c31ac344:
    mike.say "Ладно, как насчёт такого..."

# ch/harems_full/criminal/events.rpy:1468
translate russian criminal_harem_event_04_40c089e9:
    mike.say "По дороге к выходу зайдём в бар?"

# ch/harems_full/criminal/events.rpy:1469
translate russian criminal_harem_event_04_0f626b15:
    mike.say "Там каждый закажет что захочет."

# ch/harems_full/criminal/events.rpy:1470
translate russian criminal_harem_event_04_0e2d1f06:
    mike.say "Или ничего, если не захочет. Как вам?"

# ch/harems_full/criminal/events.rpy:1471
translate russian criminal_harem_event_04_da69d2d2:
    "Наблюдаю, как Камила и Лекси обдумывают предложение."

# ch/harems_full/criminal/events.rpy:1474
translate russian criminal_harem_event_04_150309d0:
    "И облегчённо вздыхаю, когда обе кивают."

# ch/harems_full/criminal/events.rpy:1475
translate russian criminal_harem_event_04_29c2ca8b:
    camila.say "Только пусть никто не осуждает меня за то, что я воздержусь."

# ch/harems_full/criminal/events.rpy:1476
translate russian criminal_harem_event_04_aa4ea14d:
    lexi.say "А меня — за желание выпить чего покрепче!"

# ch/harems_full/criminal/events.rpy:1483
translate russian criminal_harem_event_04_c64eab06:
    "Выходя из ресторана, я начинаю думать о продолжении вечера."

# ch/harems_full/criminal/events.rpy:1484
translate russian criminal_harem_event_04_79c19ff1:
    "Стоя с ними на улице, пытаюсь задать вопрос как можно непринуждённее."

# ch/harems_full/criminal/events.rpy:1486
translate russian criminal_harem_event_04_4b731d4b:
    mike.say "Ну что, на сегодня заканчиваем?"

# ch/harems_full/criminal/events.rpy:1487
translate russian criminal_harem_event_04_48ff6d26:
    mike.say "Или хотите ещё чем-нибудь заняться?"

# ch/harems_full/criminal/events.rpy:1489
translate russian criminal_harem_event_04_1b3ac6b8:
    camila.say "Я не против продолжить."

# ch/harems_full/criminal/events.rpy:1491
translate russian criminal_harem_event_04_89a08621:
    camila.say "Что ты предлагаешь?"

# ch/harems_full/criminal/events.rpy:1492
translate russian criminal_harem_event_04_f881a04b:
    lexi.say "Я тоже!"

# ch/harems_full/criminal/events.rpy:1494
translate russian criminal_harem_event_04_ec12317a:
    lexi.say "Пойдём куда-нибудь развлекаться!"

# ch/harems_full/criminal/events.rpy:1496
translate russian criminal_harem_event_04_ffe75d99:
    "Я надеялся, что хотя бы одна согласится."

# ch/harems_full/criminal/events.rpy:1497
translate russian criminal_harem_event_04_c731431f:
    "Но чтобы обе захотели продолжить свидание..."

# ch/harems_full/criminal/events.rpy:1498
translate russian criminal_harem_event_04_ed0ea68f:
    "Это же полная победа!"

# ch/harems_full/criminal/events.rpy:1501
translate russian criminal_harem_event_04_0d16ad46:
    lexi.say "Мне утром рано вставать."

# ch/harems_full/criminal/events.rpy:1502
translate russian criminal_harem_event_04_59946644:
    lexi.say "Так что я домой!"

# ch/harems_full/criminal/events.rpy:1503
translate russian criminal_harem_event_04_1b3ac6b8_1:
    camila.say "Я не против продолжить."

# ch/harems_full/criminal/events.rpy:1505
translate russian criminal_harem_event_04_89a08621_1:
    camila.say "Что ты предлагаешь?"

# ch/harems_full/criminal/events.rpy:1507
translate russian criminal_harem_event_04_5a810c63:
    "Лекси уходит искать такси."

# ch/harems_full/criminal/events.rpy:1508
translate russian criminal_harem_event_04_34c72e56:
    "А мы с Камилой обсуждаем, чем заняться дальше."

# ch/harems_full/criminal/events.rpy:1509
translate russian criminal_harem_event_04_c485a1b9:
    "Я убеждаю себя, что одна девушка лучше, чем ни одной."

# ch/harems_full/criminal/events.rpy:1512
translate russian criminal_harem_event_04_2f937ca6:
    camila.say "Я всё ещё вымотана после работы, [lssb_common.hero_name()]."

# ch/harems_full/criminal/events.rpy:1513
translate russian criminal_harem_event_04_6d141c36:
    camila.say "Так что на сегодня хватит."

# ch/harems_full/criminal/events.rpy:1514
translate russian criminal_harem_event_04_58e6573e:
    lexi.say "А я ещё нет!"

# ch/harems_full/criminal/events.rpy:1516
translate russian criminal_harem_event_04_60009d3e:
    lexi.say "Я не против сходить куда-нибудь ещё."

# ch/harems_full/criminal/events.rpy:1518
translate russian criminal_harem_event_04_83a910c3:
    "Камила уходит искать такси."

# ch/harems_full/criminal/events.rpy:1519
translate russian criminal_harem_event_04_df89fee1:
    "А мы с Лекси обсуждаем, чем заняться дальше."

# ch/harems_full/criminal/events.rpy:1520
translate russian criminal_harem_event_04_c485a1b9_1:
    "Я убеждаю себя, что одна девушка лучше, чем ни одной."

# ch/harems_full/criminal/events.rpy:1523
translate russian criminal_harem_event_04_2f937ca6_1:
    camila.say "Я всё ещё вымотана после работы, [lssb_common.hero_name()]."

# ch/harems_full/criminal/events.rpy:1524
translate russian criminal_harem_event_04_6d141c36_1:
    camila.say "Так что на сегодня хватит."

# ch/harems_full/criminal/events.rpy:1525
translate russian criminal_harem_event_04_0d16ad46_1:
    lexi.say "Мне утром рано вставать."

# ch/harems_full/criminal/events.rpy:1526
translate russian criminal_harem_event_04_59946644_1:
    lexi.say "Так что я домой!"

# ch/harems_full/criminal/events.rpy:1527
translate russian criminal_harem_event_04_4b2b42f2:
    "Я киваю и стараюсь выглядеть довольным."

# ch/harems_full/criminal/events.rpy:1531
translate russian criminal_harem_event_04_f4a98df7:
    "Но пока девушки уходят искать такси, думаю, не стоило ли мне постараться сильнее."

# ch/harems_full/criminal/events.rpy:1539
translate russian camila_lexi_threesome_658bc955:
    "Часть меня не может поверить, что мы зашли так далеко."

# ch/harems_full/criminal/events.rpy:1540
translate russian camila_lexi_threesome_a5904ddf:
    "Само свидание с Камилой и Лекси — уже довольно безумная затея."

# ch/harems_full/criminal/events.rpy:1541
translate russian camila_lexi_threesome_d0e9d885:
    "Пройти через него без публичного скандала — одно дело."

# ch/harems_full/criminal/events.rpy:1542
translate russian camila_lexi_threesome_f4774513:
    "Но чтобы всё прошло настолько хорошо, что после него все нашли общий язык..."

# ch/harems_full/criminal/events.rpy:1543
translate russian camila_lexi_threesome_2bc10e50:
    "Это уже почти не укладывается у меня в голове!"

# ch/harems_full/criminal/events.rpy:1544
translate russian camila_lexi_threesome_413dc4e3:
    "И всё же вот мы втроём выходим из такси у моего дома."

# ch/harems_full/criminal/events.rpy:1546
translate russian camila_lexi_threesome_d9ce0d53:
    "Мы смеёмся и шутим, пока подходим к входу и я открываю дверь."

# ch/harems_full/criminal/events.rpy:1549
translate russian camila_lexi_threesome_de83f390:
    "Никто даже не возражает, когда я веду их прямо в спальню."

# ch/harems_full/criminal/events.rpy:1553
translate russian camila_lexi_threesome_39c59ca7:
    "Стоит открыть дверь, как Камила и Лекси сразу заходят!"

# ch/harems_full/criminal/events.rpy:1554
translate russian camila_lexi_threesome_ad46f384:
    "Иду следом, закрываю дверь, и в моей походке уже появляется самоуверенность."

# ch/harems_full/criminal/events.rpy:1555
translate russian camila_lexi_threesome_e68a0d21:
    "Чувствую себя волшебником, способным очаровать любую девушку!"

# ch/harems_full/criminal/events.rpy:1556
translate russian camila_lexi_threesome_bf781e67:
    "Но стоит обернуться, как самодовольство тут же улетучивается."

# ch/harems_full/criminal/events.rpy:1557
translate russian camila_lexi_threesome_367ddb18:
    "Девушки стоят по разные стороны моей кровати."

# ch/harems_full/criminal/events.rpy:1558
translate russian camila_lexi_threesome_25ccf7f5:
    "Не то чтобы Камила и Лекси что-то сказали."

# ch/harems_full/criminal/events.rpy:1559
translate russian camila_lexi_threesome_f7371462:
    "Наоборот, они уже начинают раздеваться."

# ch/harems_full/criminal/events.rpy:1563
translate russian camila_lexi_threesome_4ae6e4fb:
    "Казалось бы, я должен радоваться ещё сильнее."

# ch/harems_full/criminal/events.rpy:1564
translate russian camila_lexi_threesome_086f8494:
    "Но в том, как они на меня смотрят, есть что-то особенное."

# ch/harems_full/criminal/events.rpy:1565
translate russian camila_lexi_threesome_af6c069e:
    "Что-то, напоминающее крупных кошек из фильмов о природе."

# ch/harems_full/criminal/events.rpy:1566
translate russian camila_lexi_threesome_d872fc89:
    "Их взгляд на бедное беззащитное животное, которым они вот-вот полакомятся!"

# ch/harems_full/criminal/events.rpy:1569
translate russian camila_lexi_threesome_58f151da:
    mike.say "Ну вот мы и здесь..."

# ch/harems_full/criminal/events.rpy:1570
translate russian camila_lexi_threesome_71f8a1b4:
    mike.say "Все трое!"

# ch/harems_full/criminal/events.rpy:1571
translate russian camila_lexi_threesome_1be71a64:
    "Камила и Лекси понимающе переглядываются."

# ch/harems_full/criminal/events.rpy:1572
translate russian camila_lexi_threesome_50ce6a4c:
    "Затем Камила манит меня согнутым пальцем."

# ch/harems_full/criminal/events.rpy:1573
translate russian camila_lexi_threesome_9ad4c973:
    "А Лекси садится на кровать и хлопает ладонью рядом с собой."

# ch/harems_full/criminal/events.rpy:1574
translate russian camila_lexi_threesome_54af390d:
    lexi.say "Мы обе здесь, [lssb_common.hero_name()]."

# ch/harems_full/criminal/events.rpy:1576
translate russian camila_lexi_threesome_0288daa0:
    lexi.say "Присоединишься к нам?"

# ch/harems_full/criminal/events.rpy:1577
translate russian camila_lexi_threesome_60b648df:
    camila.say "Да, [lssb_common.hero_name()]..."

# ch/harems_full/criminal/events.rpy:1579
translate russian camila_lexi_threesome_ea091e3e:
    camila.say "Чего ждёшь?"

# ch/harems_full/criminal/events.rpy:1580
translate russian camila_lexi_threesome_9a9d94e9:
    "Совершенное безумие."

# ch/harems_full/criminal/events.rpy:1583
translate russian camila_lexi_threesome_bca32cba:
    "Мне бы броситься к ним и запрыгнуть на кровать."

# ch/harems_full/criminal/events.rpy:1584
translate russian camila_lexi_threesome_0dfd518d:
    "Но получается лишь медленно переставлять ноги в их сторону."

# ch/harems_full/criminal/events.rpy:1585
translate russian camila_lexi_threesome_3005897b:
    "Камила и Лекси уже совершенно голые."

# ch/harems_full/criminal/events.rpy:1586
translate russian camila_lexi_threesome_760d997d:
    "Трудно описать, как прекрасно они выглядят."

# ch/harems_full/criminal/events.rpy:1587
translate russian camila_lexi_threesome_10794578:
    "Я столько старался, чтобы они наконец поладили."

# ch/harems_full/criminal/events.rpy:1588
translate russian camila_lexi_threesome_cd19bf09:
    "Но теперь, когда они заодно, становится даже страшновато!"

# ch/harems_full/criminal/events.rpy:1589
translate russian camila_lexi_threesome_b411a6ee:
    "Вся энергия, уходившая на ссоры и колкости, теперь направлена в другое русло."

# ch/harems_full/criminal/events.rpy:1590
translate russian camila_lexi_threesome_dd4659f2:
    "Словно они объединились, чтобы заставить меня оказаться именно там, где им нужно."

# ch/harems_full/criminal/events.rpy:1591
translate russian camila_lexi_threesome_dcd1e6ab:
    "Камила и Лекси смотрят так, будто прекрасно знают, о чём я думаю."

# ch/harems_full/criminal/events.rpy:1594
translate russian camila_lexi_threesome_ef40df2c:
    "Пока я приближаюсь, они хихикают и качают головами."

# ch/harems_full/criminal/events.rpy:1595
translate russian camila_lexi_threesome_407ba7dc:
    "Улыбаются, наблюдая, как я снимаю одну вещь за другой."

# ch/harems_full/criminal/events.rpy:1596
translate russian camila_lexi_threesome_6cd9405a:
    camila.say "Ну же, [lssb_common.hero_name()]..."

# ch/harems_full/criminal/events.rpy:1598
translate russian camila_lexi_threesome_5e129a25:
