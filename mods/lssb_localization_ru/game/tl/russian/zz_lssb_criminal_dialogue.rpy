# Native Criminal identifiers, current source catalog. Translation only.

# ch/harems_full/criminal/events.rpy:70
translate russian criminal_harem_event_01_417a1852:
    "Услышав звонок, я сразу хватаю телефон."

# ch/harems_full/criminal/events.rpy:71
translate russian criminal_harem_event_01_baaa8000:
    "Но прежде чем ответить, проверяю, кто звонит."

# ch/harems_full/criminal/events.rpy:72
translate russian criminal_harem_event_01_d9a65a8b:
    "На экране появляется имя Лекси."

# ch/harems_full/criminal/events.rpy:78
translate russian criminal_harem_event_01_39eba6c7:
    "Других причин ответить мне уже не нужно."

# ch/harems_full/criminal/events.rpy:79
translate russian criminal_harem_event_01_ab238733:
    "Потому что звонки Лекси обычно того стоят."

# ch/harems_full/criminal/events.rpy:80
translate russian criminal_harem_event_01_952f7724:
    "Чаще всего это довольно прозрачное приглашение как следует развлечься!"

# ch/harems_full/criminal/events.rpy:81
translate russian criminal_harem_event_01_3a9a986a:
    mike.say "Привет, Лекси!"

# ch/harems_full/criminal/events.rpy:82
translate russian criminal_harem_event_01_47366b2a:
    mike.say "Как дела?"

# ch/harems_full/criminal/events.rpy:83
translate russian criminal_harem_event_01_c32520f7:
    lexi.say "А... привет, [lssb_common.hero_name()]."

# ch/harems_full/criminal/events.rpy:84
translate russian criminal_harem_event_01_89e70d2b:
    lexi.say "Мне... вроде как нужна твоя помощь, понимаешь?"

# ch/harems_full/criminal/events.rpy:85
translate russian criminal_harem_event_01_926f419e:
    "Мне уже интересно, что Лекси от меня понадобилось."

# ch/harems_full/criminal/events.rpy:86
translate russian criminal_harem_event_01_72ca5303:
    "Но я стараюсь говорить спокойно и дружелюбно."

# ch/harems_full/criminal/events.rpy:87
translate russian criminal_harem_event_01_2a1465db:
    "Хотя в голове всё время проносятся разные варианты."

# ch/harems_full/criminal/events.rpy:88
translate russian criminal_harem_event_01_f68213ee:
    mike.say "Конечно, Лекси."

# ch/harems_full/criminal/events.rpy:89
translate russian criminal_harem_event_01_1984b5a2:
    mike.say "Что мне с тобой сделать?"

# ch/harems_full/criminal/events.rpy:90
translate russian criminal_harem_event_01_87b8de72:
    mike.say "То есть что мне сделать ДЛЯ тебя!"

# ch/harems_full/criminal/events.rpy:91
translate russian criminal_harem_event_01_a07aecb0:
    lexi.say "Просто помолчи и послушай, [lssb_common.hero_name()]..."

# ch/harems_full/criminal/events.rpy:92
translate russian criminal_harem_event_01_ecb0b2cc:
    lexi.say "Приезжай в участок."

# ch/harems_full/criminal/events.rpy:93
translate russian criminal_harem_event_01_ae973e21:
    lexi.say "У тебя ведь есть деньги?"

# ch/harems_full/criminal/events.rpy:94
translate russian criminal_harem_event_01_58c55505:
    lexi.say "Внесёшь за меня залог?"

# ch/harems_full/criminal/events.rpy:95
translate russian criminal_harem_event_01_c9b4bca2:
    "Разговор внезапно принимает мрачный оборот."

# ch/harems_full/criminal/events.rpy:96
translate russian criminal_harem_event_01_64cc50e7:
    "Все мысли о флирте и намёках тут же исчезают."

# ch/harems_full/criminal/events.rpy:97
translate russian criminal_harem_event_01_22a48728:
    mike.say "Ты имеешь в виду полицейский участок?!"

# ch/harems_full/criminal/events.rpy:98
translate russian criminal_harem_event_01_75112c72:
    lexi.say "Нет, [lssb_common.hero_name()], пожарную часть."

# ch/harems_full/criminal/events.rpy:99
translate russian criminal_harem_event_01_f17eb9b8:
    lexi.say "Конечно, блядь, полицейский участок!"

# ch/harems_full/criminal/events.rpy:100
translate russian criminal_harem_event_01_b45deb3b:
    mike.say "Тебя арестовали?"

# ch/harems_full/criminal/events.rpy:101
translate russian criminal_harem_event_01_06f2696e:
    mike.say "Что ты, чёрт возьми, натворила, Лекси?!"

# ch/harems_full/criminal/events.rpy:102
translate russian criminal_harem_event_01_9c5d850f:
    "Лекси пренебрежительно фыркает в ответ."

# ch/harems_full/criminal/events.rpy:103
translate russian criminal_harem_event_01_af7f9a84:
    "Похоже, подробности для неё неважны."

# ch/harems_full/criminal/events.rpy:104
translate russian criminal_harem_event_01_ad3f61c8:
    lexi.say "Какая разница?"

# ch/harems_full/criminal/events.rpy:105
translate russian criminal_harem_event_01_07de84c4:
    lexi.say "Ты же знаешь копов."

# ch/harems_full/criminal/events.rpy:106
translate russian criminal_harem_event_01_55eddf38:
    lexi.say "Вечно придумывают какую-нибудь хрень, чтобы докопаться до таких, как я!"

# ch/harems_full/criminal/events.rpy:108
translate russian criminal_harem_event_01_8c6cb500:
    mike.say "Не уверен, что это совсем справедливо..."

# ch/harems_full/criminal/events.rpy:109
translate russian criminal_harem_event_01_92bee536:
    "Лекси снова фыркает, перебивая меня."

# ch/harems_full/criminal/events.rpy:110
translate russian criminal_harem_event_01_4b38f53b:
    "И возвращается к тому, что для неё важно."

# ch/harems_full/criminal/events.rpy:111
translate russian criminal_harem_event_01_d614a597:
    lexi.say "Бла-бла-бла... Как скажешь, [lssb_common.hero_name()]."

# ch/harems_full/criminal/events.rpy:112
translate russian criminal_harem_event_01_ef02b5c0:
    lexi.say "Ты внесёшь за меня залог или нет?"

# ch/harems_full/criminal/events.rpy:113
translate russian criminal_harem_event_01_50a2158f:
    lexi.say "Всего-то тысяча долларов."

# ch/harems_full/criminal/events.rpy:114
translate russian criminal_harem_event_01_7c2cff8d:
    lexi.say "У тебя наверняка столько мелочью в карманах!"

# ch/harems_full/criminal/events.rpy:117
translate russian criminal_harem_event_01_42f746d7:
    "Да, знаю, о чём большинство из вас сейчас думает."

# ch/harems_full/criminal/events.rpy:118
translate russian criminal_harem_event_01_3597a9a3:
    "Нужно послать её подальше и закончить разговор."

# ch/harems_full/criminal/events.rpy:119
translate russian criminal_harem_event_01_77dea9ba:
    "Но, может, именно поэтому Лекси и попадает в такие ситуации."

# ch/harems_full/criminal/events.rpy:120
translate russian criminal_harem_event_01_fd8f3b87:
    "В трудный момент ей не к кому обратиться."

# ch/harems_full/criminal/events.rpy:121
translate russian criminal_harem_event_01_f263ed8a:
    "Конечно, есть и куда менее приятное объяснение."

# ch/harems_full/criminal/events.rpy:122
translate russian criminal_harem_event_01_4f9b619e:
    "Я просто очередной в длинной веренице лохов."

# ch/harems_full/criminal/events.rpy:123
translate russian criminal_harem_event_01_e732e8ce:
    "Ещё один наивный парень, которым Лекси вертит как хочет."

# ch/harems_full/criminal/events.rpy:124
translate russian criminal_harem_event_01_37782c8c:
    "Хотя, может, ради такой девушки, как Лекси, и стоит побыть лохом?"

# ch/harems_full/criminal/events.rpy:125
translate russian criminal_harem_event_01_446e269d:
    mike.say "Ладно, Лекси, жди."

# ch/harems_full/criminal/events.rpy:126
translate russian criminal_harem_event_01_6883fde9:
    mike.say "Я уже еду."

# ch/harems_full/criminal/events.rpy:128
translate russian criminal_harem_event_01_64c07e98:
    lexi.say "Знала, что могу на тебя положиться, [lssb_common.hero_name()]!"

# ch/harems_full/criminal/events.rpy:129
translate russian criminal_harem_event_01_9ca1c5a8:
    lexi.say "Давай тащи сюда свою задницу поскорее."

# ch/harems_full/criminal/events.rpy:130
translate russian criminal_harem_event_01_0ea0918b:
    lexi.say "Мне уже лучше."

# ch/harems_full/criminal/events.rpy:131
translate russian criminal_harem_event_01_305f02dd:
    lexi.say "Я даже чувствую себя ОЧЕНЬ щедрой..."

# ch/harems_full/criminal/events.rpy:132
translate russian criminal_harem_event_01_2d335568:
    "Я изо всех сил стараюсь думать о деле."

# ch/harems_full/criminal/events.rpy:133
translate russian criminal_harem_event_01_1f368804:
    "Но слова Лекси уже рисуют в воображении заманчивые картины."

# ch/harems_full/criminal/events.rpy:134
translate russian criminal_harem_event_01_a6c35c26:
    mike.say "Просто жди, Лекси."

# ch/harems_full/criminal/events.rpy:135
translate russian criminal_harem_event_01_fad1922c:
    mike.say "Скоро я тебя заберу."

# ch/harems_full/criminal/events.rpy:136
translate russian criminal_harem_event_01_af0362a4:
    lexi.say "Буду ждать!"

# ch/harems_full/criminal/events.rpy:138
translate russian criminal_harem_event_01_60a9cd43:
    "Внести за неё тысячу долларов залога!"

# ch/harems_full/criminal/events.rpy:139
translate russian criminal_harem_event_01_3055d24c:
    "Кем она меня считает?"

# ch/harems_full/criminal/events.rpy:140
translate russian criminal_harem_event_01_1d1eb231:
    "Ходячим банкоматом?!"

# ch/harems_full/criminal/events.rpy:141
translate russian criminal_harem_event_01_4993df05:
    mike.say "Не думаю, Лекси."

# ch/harems_full/criminal/events.rpy:142
translate russian criminal_harem_event_01_97123023:
    mike.say "Придётся тебе позвонить кому-нибудь другому."

# ch/harems_full/criminal/events.rpy:143
translate russian criminal_harem_event_01_ca417c11:
    lexi.say "А?"

# ch/harems_full/criminal/events.rpy:144
translate russian criminal_harem_event_01_74f6df89:
    lexi.say "Какого хрена?!"

# ch/harems_full/criminal/events.rpy:145
translate russian criminal_harem_event_01_6d354220:
    lexi.say "Ты не можешь просто оставить меня здесь!"

# ch/harems_full/criminal/events.rpy:146
translate russian criminal_harem_event_01_a70f7fc1:
    mike.say "Ещё как могу, Лекси."

# ch/harems_full/criminal/events.rpy:147
translate russian criminal_harem_event_01_14d095ef:
    mike.say "Ты взрослая девочка и способна о себе позаботиться."

# ch/harems_full/criminal/events.rpy:148
translate russian criminal_harem_event_01_d3fb363e:
    "На другом конце провода Лекси начинает ругаться."

# ch/harems_full/criminal/events.rpy:149
translate russian criminal_harem_event_01_9e28b131:
    "Я просто отодвигаю телефон от уха и жду, пока поток брани иссякнет."

# ch/harems_full/criminal/events.rpy:151
translate russian criminal_harem_event_01_0e3031cd:
    lexi.say "Уф..."

# ch/harems_full/criminal/events.rpy:152
translate russian criminal_harem_event_01_b63938ec:
    lexi.say "Не верится, что ты вот так бросаешь меня в беде!"

# ch/harems_full/criminal/events.rpy:153
translate russian criminal_harem_event_01_53a47723:
    lexi.say "Хорош же ты друг!"

# ch/harems_full/criminal/events.rpy:154
translate russian criminal_harem_event_01_2ef3cca9:
    "С этими словами она бросает трубку."

# ch/harems_full/criminal/events.rpy:155
translate russian criminal_harem_event_01_fb63c158:
    "Меня тут же начинает грызть вина за то, что я не помог."

# ch/harems_full/criminal/events.rpy:156
translate russian criminal_harem_event_01_c44a1ac1:
    "Но я продолжаю убеждать себя, что Лекси неправа."

# ch/harems_full/criminal/events.rpy:157
translate russian criminal_harem_event_01_2908c603:
    "Как раз сейчас я поступаю как друг."

# ch/harems_full/criminal/events.rpy:158
translate russian criminal_harem_event_01_f6793226:
    "Заставляю её отвечать за свои действия."

# ch/harems_full/criminal/events.rpy:159
translate russian criminal_harem_event_01_a753ee5d:
    "И кто знает, может, ночь в камере — именно то, что ей нужно?"

# ch/harems_full/criminal/events.rpy:160
translate russian criminal_harem_event_01_adb8b693:
    "Пусть лучше остынет там, чем ещё и на меня сорвётся!"

# ch/harems_full/criminal/events.rpy:164
translate russian criminal_harem_event_01_9b306de5:
    "Приезжаю в полицейский участок, стараясь не выглядеть скрытным или подозрительным."

# ch/harems_full/criminal/events.rpy:165
translate russian criminal_harem_event_01_70329926:
    "Все старания идут прахом, едва я подхожу к стойке дежурного."

# ch/harems_full/criminal/events.rpy:166
translate russian criminal_harem_event_01_2c3a1df9:
    lexi.say "Эй, [lssb_common.hero_name()]!"

# ch/harems_full/criminal/events.rpy:167
translate russian criminal_harem_event_01_c8993fe9:
    lexi.say "Сюда!"

# ch/harems_full/criminal/events.rpy:169
translate russian criminal_harem_event_01_18807c27:
    "Резко поворачиваю голову и вижу возле стойки Лекси."

# ch/harems_full/criminal/events.rpy:170
translate russian criminal_harem_event_01_6d74d288:
    "Рядом стоит измученный на вид полицейский с пачкой бумаг."

# ch/harems_full/criminal/events.rpy:171
translate russian criminal_harem_event_01_fdda42b4:
    "Когда я спешу к ним, он радуется моему приходу почти так же, как сама Лекси!"

# ch/harems_full/criminal/events.rpy:172
translate russian criminal_harem_event_01_1297c9f7:
    mike.say "А... привет, Лекси."

# ch/harems_full/criminal/events.rpy:173
translate russian criminal_harem_event_01_68b8f363:
    mike.say "Я бы приехал раньше."

# ch/harems_full/criminal/events.rpy:174
translate russian criminal_harem_event_01_1181c410:
    mike.say "Но нужно было снять деньги на залог."

# ch/harems_full/criminal/events.rpy:176
translate russian criminal_harem_event_01_a78ffc62:
    lexi.say "О-о, мой рыцарь в сияющих доспехах!"

# ch/harems_full/criminal/events.rpy:177
translate russian criminal_harem_event_01_82fdd3ad:
    lexi.say "Не знаю, что бы я без тебя делала!"

# ch/harems_full/criminal/events.rpy:178
translate russian criminal_harem_event_01_e28be600:
    mike.say "Может, переночевала бы в камере?"

# ch/harems_full/criminal/events.rpy:179
translate russian criminal_harem_event_01_1448b0fa:
    "Последние слова я бормочу так тихо, что Лекси их не слышит."

# ch/harems_full/criminal/events.rpy:181
translate russian criminal_harem_event_01_ca417c11_1:
    lexi.say "А?"

# ch/harems_full/criminal/events.rpy:182
translate russian criminal_harem_event_01_0de6c862:
    lexi.say "Ты что-то сказал?"

# ch/harems_full/criminal/events.rpy:184
translate russian criminal_harem_event_01_90af0ebd:
    mike.say "Вообще ничего!"

# ch/harems_full/criminal/events.rpy:187
translate russian criminal_harem_event_01_a2689581:
    "Отдаю деньги и подписываю все необходимые бумаги."

# ch/harems_full/criminal/events.rpy:188
translate russian criminal_harem_event_01_36324ea5:
    "Вот так полиция избавляется от Лекси."

# ch/harems_full/criminal/events.rpy:191
translate russian criminal_harem_event_01_2f4307df:
    "Зато теперь, похоже, за неё отвечаю я."

# ch/harems_full/criminal/events.rpy:192
translate russian criminal_harem_event_01_d5950bb9:
    "Осознав это, я сразу веду её к выходу."

# ch/harems_full/criminal/events.rpy:193
translate russian criminal_harem_event_01_ef998582:
    "Но прежде чем успеваю вытолкнуть Лекси за дверь, слышу знакомый голос."

# ch/harems_full/criminal/events.rpy:197
translate russian criminal_harem_event_01_5a6c6af5:
    camila.say "Так-так-так..."

# ch/harems_full/criminal/events.rpy:198
translate russian criminal_harem_event_01_8c2619fa:
    camila.say "Посмотрите, в какую дрянь кошка наступила!"

# ch/harems_full/criminal/events.rpy:199
translate russian criminal_harem_event_01_58a08a51:
    "На мгновение я не понимаю, что имеет в виду Камила."

# ch/harems_full/criminal/events.rpy:200
translate russian criminal_harem_event_01_61092927:
    "Затем доходит: она обращается к Лекси, а не ко мне."

# ch/harems_full/criminal/events.rpy:201
translate russian criminal_harem_event_01_f4ccd43f:
    "Вообще-то меня она, кажется, ещё даже не заметила."

# ch/harems_full/criminal/events.rpy:203
translate russian criminal_harem_event_01_f228ad4f:
    lexi.say "О, привет! Грязная Гарриет собственной персоной!"

# ch/harems_full/criminal/events.rpy:204
translate russian criminal_harem_event_01_736c3500:
    lexi.say "Всё ещё подбрасываешь улики и докапываешься до людей?"

# ch/harems_full/criminal/events.rpy:206
translate russian criminal_harem_event_01_ca04f3c8:
    "Вижу, что Камила уже собирается огрызнуться."

# ch/harems_full/criminal/events.rpy:207
translate russian criminal_harem_event_01_881b383b:
    "Но тут замирает с открытым ртом."

# ch/harems_full/criminal/events.rpy:208
translate russian criminal_harem_event_01_c1726503:
    "Понимаю: наконец заметила меня."

# ch/harems_full/criminal/events.rpy:210
translate russian criminal_harem_event_01_e88a7eda:
    camila.say "Ч-что ты здесь делаешь, [lssb_common.hero_name()]?"

# ch/harems_full/criminal/events.rpy:211
translate russian criminal_harem_event_01_5c5965a5:
    camila.say "Погоди-ка..."

# ch/harems_full/criminal/events.rpy:212
translate russian criminal_harem_event_01_ef1e1af3:
    camila.say "Вы двое... знакомы?!"

# ch/harems_full/criminal/events.rpy:213
translate russian criminal_harem_event_01_e83388a5:
    "Я перевожу взгляд с Камилы на Лекси и обратно."

# ch/harems_full/criminal/events.rpy:214
translate russian criminal_harem_event_01_58215196:
    "Камила потрясена и явно ничего не понимает."

# ch/harems_full/criminal/events.rpy:216
translate russian criminal_harem_event_01_cb008405:
    "А по лицу Лекси уже расползается ехидная улыбка."

# ch/harems_full/criminal/events.rpy:217
translate russian criminal_harem_event_01_b0ed8c2a:
    lexi.say "Ну да! Ты разве не знала?"

# ch/harems_full/criminal/events.rpy:219
translate russian criminal_harem_event_01_2a88f344:
    lexi.say "Мы с [lssb_common.hero_name()] давние друзья."

# ch/harems_full/criminal/events.rpy:220
translate russian criminal_harem_event_01_139fa330:
    lexi.say "Очень близкие, кстати."

# ch/harems_full/criminal/events.rpy:221
translate russian criminal_harem_event_01_057102e0:
    lexi.say "Я позвонила ему, чтобы внёс за меня залог."

# ch/harems_full/criminal/events.rpy:222
translate russian criminal_harem_event_01_a262cfc1:
    lexi.say "И он тут же прибежал!"

# ch/harems_full/criminal/events.rpy:224
translate russian criminal_harem_event_01_85f6c990:
    mike.say "Ну... «прибежал» — это громко сказано!"

# ch/harems_full/criminal/events.rpy:225
translate russian criminal_harem_event_01_b17ab138:
    mike.say "Да, мы друзья, но давние?"

# ch/harems_full/criminal/events.rpy:226
translate russian criminal_harem_event_01_1b942b7f:
    mike.say "Я бы так далеко не заходил!"

# ch/harems_full/criminal/events.rpy:227
translate russian criminal_harem_event_01_de7b76a4:
    mike.say "Просто пытаюсь помочь, вот и всё."

# ch/harems_full/criminal/events.rpy:229
translate russian criminal_harem_event_01_06e3ffaa:
    "Такое выражение лица у Камилы я вижу редко."

# ch/harems_full/criminal/events.rpy:230
translate russian criminal_harem_event_01_6a550adc:
    "Она выглядит неуверенной."

# ch/harems_full/criminal/events.rpy:231
translate russian criminal_harem_event_01_7fb307da:
    "И, что хуже, кажется, не уверена теперь и во мне."

# ch/harems_full/criminal/events.rpy:232
translate russian criminal_harem_event_01_d68d9731:
    camila.say "Я... я понятия не имела."

# ch/harems_full/criminal/events.rpy:233
translate russian criminal_harem_event_01_74b4dbe4:
    camila.say "Вообще не знала..."

# ch/harems_full/criminal/events.rpy:234
translate russian criminal_harem_event_01_18170ef8:
    "Я тоже понятия не имею — как теперь спасти положение."

# ch/harems_full/criminal/events.rpy:235
translate russian criminal_harem_event_01_60f26642:
    "Пока Камила рядом, Лекси не перестанет злорадствовать."

# ch/harems_full/criminal/events.rpy:236
translate russian criminal_harem_event_01_87ec988f:
    "Но Камила здесь работает, она полицейская."

# ch/harems_full/criminal/events.rpy:237
translate russian criminal_harem_event_01_03becfec:
    "Нельзя допустить, чтобы её унижали перед коллегами."

# ch/harems_full/criminal/events.rpy:238
translate russian criminal_harem_event_01_53c25886:
    "Единственный выход — увести отсюда Лекси."

# ch/harems_full/criminal/events.rpy:239
translate russian criminal_harem_event_01_88a2dd37:
    "Хватаю её за руку и направляюсь к двери."

# ch/harems_full/criminal/events.rpy:241
translate russian criminal_harem_event_01_05bb986c:
    lexi.say "Что..."

# ch/harems_full/criminal/events.rpy:242
translate russian criminal_harem_event_01_0eccd4c3:
    lexi.say "Эй!"

# ch/harems_full/criminal/events.rpy:243
translate russian criminal_harem_event_01_712427ae:
    mike.say "Пойдём, Лекси, мы уходим."

# ch/harems_full/criminal/events.rpy:244
translate russian criminal_harem_event_01_aabd0e1c:
    mike.say "Уверен, Камила слишком занята, чтобы тут болтать!"

# ch/harems_full/criminal/events.rpy:245
translate russian criminal_harem_event_01_b6ad3452:
    "С этими словами я быстро вывожу Лекси за дверь и спускаюсь с ней по ступенькам."

# ch/harems_full/criminal/events.rpy:246
translate russian criminal_harem_event_01_1609a0b4:
    "За всё это время Камила не произносит ни слова."

# ch/harems_full/criminal/events.rpy:247
translate russian criminal_harem_event_01_6ca8b48b:
    "Просто стоит и смотрит нам вслед в неловком молчании."

# ch/harems_full/criminal/events.rpy:252
translate russian criminal_harem_event_02_c0da3feb:
    camila.say "Послушай, [lssb_common.hero_name()]..."

# ch/harems_full/criminal/events.rpy:253
translate russian criminal_harem_event_02_aa294d76:
    camila.say "Не моё дело, на что ты тратишь свои деньги."

# ch/harems_full/criminal/events.rpy:254
translate russian criminal_harem_event_02_40d5ce7f:
    camila.say "Но я бы не советовала вносить залог за некоторых людей."

# ch/harems_full/criminal/events.rpy:256
translate russian criminal_harem_event_02_d1d9bb49:
    camila.say "И Лекси точно из их числа!"

# ch/harems_full/criminal/events.rpy:258
translate russian criminal_harem_event_02_18df302c:
    "Повисает неловкая пауза."

# ch/harems_full/criminal/events.rpy:259
translate russian criminal_harem_event_02_d37e4239:
    "Мне остаётся только кивнуть и согласиться."

# ch/harems_full/criminal/events.rpy:260
translate russian criminal_harem_event_02_3241b997:
    mike.say "Я... понимаю тебя, Камила."

# ch/harems_full/criminal/events.rpy:261
translate russian criminal_harem_event_02_535d18fa:
    mike.say "Но я же сказал: просто хотел помочь!"

# ch/harems_full/criminal/events.rpy:263
translate russian criminal_harem_event_02_805a8d98:
    camila.say "Ага..."

# ch/harems_full/criminal/events.rpy:264
translate russian criminal_harem_event_02_53fd4b9e:
    camila.say "Насчёт этого..."

# ch/harems_full/criminal/events.rpy:265
translate russian criminal_harem_event_02_8926b1f8:
    camila.say "Я неплохо распознаю ложь, [lssb_common.hero_name()]."

# ch/harems_full/criminal/events.rpy:266
translate russian criminal_harem_event_02_46ab3d9e:
    camila.say "В моей работе это полезный навык."

# ch/harems_full/criminal/events.rpy:268
translate russian criminal_harem_event_02_1d2ef58f:
    "Камила не говорит прямо, что я несу чушь."

# ch/harems_full/criminal/events.rpy:269
translate russian criminal_harem_event_02_c3e6413d:
    "Но ей это и не нужно."

# ch/harems_full/criminal/events.rpy:270
translate russian criminal_harem_event_02_d6f7f3ce:
    "Вопрос лишь в том, признаться ли мне сейчас."

# ch/harems_full/criminal/events.rpy:271
translate russian criminal_harem_event_02_d29cc9ab:
    "Или продолжать настаивать на прежней версии?"

# ch/harems_full/criminal/events.rpy:275
translate russian criminal_harem_event_02_39bfc4be:
    mike.say "Не обижайся, Камила."

# ch/harems_full/criminal/events.rpy:276
translate russian criminal_harem_event_02_fdf03a88:
    mike.say "Но, по-моему, на этот раз чутьё тебя подвело."

# ch/harems_full/criminal/events.rpy:277
translate russian criminal_harem_event_02_ca115b3b:
    "Камила приподнимает бровь."

# ch/harems_full/criminal/events.rpy:278
translate russian criminal_harem_event_02_2d8d9fba:
    "Её явно не убедило."

# ch/harems_full/criminal/events.rpy:280
translate russian criminal_harem_event_02_2b8361e9:
    camila.say "Правда, [lssb_common.hero_name()]?"

# ch/harems_full/criminal/events.rpy:281
translate russian criminal_harem_event_02_9e4aed0b:
    camila.say "Потому что, если ты мне врёшь..."

# ch/harems_full/criminal/events.rpy:282
translate russian criminal_harem_event_02_68a7d3bd:
    "Я качаю головой и закатываю глаза."

# ch/harems_full/criminal/events.rpy:283
translate russian criminal_harem_event_02_6812c337:
    "Всеми силами стараюсь убедить Камилу."

# ch/harems_full/criminal/events.rpy:284
translate russian criminal_harem_event_02_a5c73b0f:
    mike.say "Ты ведь говорила, что хорошо знаешь Лекси?"

# ch/harems_full/criminal/events.rpy:285
translate russian criminal_harem_event_02_1d2e887d:
    mike.say "Тогда должна знать, что она та ещё врушка, верно?"

# ch/harems_full/criminal/events.rpy:286
translate russian criminal_harem_event_02_e8550d7f:
    camila.say "Я... наверное."

# ch/harems_full/criminal/events.rpy:287
translate russian criminal_harem_event_02_482625de:
    mike.say "Камила, она тебя разыгрывала."

# ch/harems_full/criminal/events.rpy:288
translate russian criminal_harem_event_02_cd8075f2:
    mike.say "Поняла, что мы знакомы."

# ch/harems_full/criminal/events.rpy:289
translate russian criminal_harem_event_02_fd25e937:
    mike.say "И воспользовалась случаем, чтобы тебя позлить, вот и всё."

# ch/harems_full/criminal/events.rpy:291
translate russian criminal_harem_event_02_d2216ed6:
    "Похоже, Камила начинает сомневаться в себе."

# ch/harems_full/criminal/events.rpy:292
translate russian criminal_harem_event_02_a4a1ff42:
    "Это даёт мне повод продолжить нажим."

# ch/harems_full/criminal/events.rpy:293
translate russian criminal_harem_event_02_8081e750:
    mike.say "Она мне в лучшем случае знакомая через знакомых."

# ch/harems_full/criminal/events.rpy:294
translate russian criminal_harem_event_02_35d022e7:
    mike.say "Я внёс залог по чужой просьбе."

# ch/harems_full/criminal/events.rpy:297
translate russian criminal_harem_event_02_92bd1af0:
    camila.say "Ладно, [lssb_common.hero_name()], я тебе верю."

# ch/harems_full/criminal/events.rpy:298
translate russian criminal_harem_event_02_6440f41e:
    camila.say "Но лучше бы ты не вешал мне лапшу на уши!"

# ch/harems_full/criminal/events.rpy:299
translate russian criminal_harem_event_02_2533f0bd:
    "Я улыбаюсь и качаю головой."

# ch/harems_full/criminal/events.rpy:300
translate russian criminal_harem_event_02_95183ca1:
    "Но невольно тревожусь о том, что будет, если обман раскроется!"

# ch/harems_full/criminal/events.rpy:302
translate russian criminal_harem_event_02_d9bab186:
    mike.say "Не знаю, как тебе сказать, Камила."

# ch/harems_full/criminal/events.rpy:303
translate russian criminal_harem_event_02_96242012:
    mike.say "Но ты права: я врал тебе насчёт Лекси."

# ch/harems_full/criminal/events.rpy:304
translate russian criminal_harem_event_02_4f1fcc6f:
    "Камила реагирует сразу, едва я произношу эти слова."

# ch/harems_full/criminal/events.rpy:305
translate russian criminal_harem_event_02_47635940:
    "Но её реакция меня удивляет."

# ch/harems_full/criminal/events.rpy:306
translate russian criminal_harem_event_02_e12a11a1:
    "Она сжимает кулак и торжествующе вскидывает его."

# ch/harems_full/criminal/events.rpy:308
translate russian criminal_harem_event_02_63a70723:
    camila.say "ДА!"

# ch/harems_full/criminal/events.rpy:309
translate russian criminal_harem_event_02_e6cfed4a:
    camila.say "Я ЗНАЛА!"

# ch/harems_full/criminal/events.rpy:310
translate russian criminal_harem_event_02_16249f30:
    camila.say "Знала, что чутьё меня не подвело!"

# ch/harems_full/criminal/events.rpy:311
translate russian criminal_harem_event_02_21debdb8:
    "Вдруг Камила замечает моё удивлённое лицо."

# ch/harems_full/criminal/events.rpy:312
translate russian criminal_harem_event_02_988bda5a:
    "И с заметным усилием пытается выглядеть серьёзнее."

# ch/harems_full/criminal/events.rpy:315
translate russian criminal_harem_event_02_6e6e8296:
    mike.say "Я... пойму, если между нами всё кончено, Камила."

# ch/harems_full/criminal/events.rpy:316
translate russian criminal_harem_event_02_2887b8b0:
    mike.say "Ты полицейская, а она преступница."

# ch/harems_full/criminal/events.rpy:317
translate russian criminal_harem_event_02_566130c0:
    mike.say "Так что я понимаю..."

# ch/harems_full/criminal/events.rpy:319
translate russian criminal_harem_event_02_f358e05d:
    "Пока я говорю, Камила начинает качать головой."

# ch/harems_full/criminal/events.rpy:320
translate russian criminal_harem_event_02_535dcdbd:
    "И наклоняется чуть ближе."

# ch/harems_full/criminal/events.rpy:321
translate russian criminal_harem_event_02_5be2e6d5:
    "Словно не хочет, чтобы нас услышали."

# ch/harems_full/criminal/events.rpy:323
translate russian criminal_harem_event_02_744f6d23:
    camila.say "Нет-нет-нет..."

# ch/harems_full/criminal/events.rpy:324
translate russian criminal_harem_event_02_ed45ff0f:
    camila.say "Ты сказал мне правду, [lssb_common.hero_name()]."

# ch/harems_full/criminal/events.rpy:325
translate russian criminal_harem_event_02_02054381:
    camila.say "Теперь я отвечу тебе тем же!"

# ch/harems_full/criminal/events.rpy:326
translate russian criminal_harem_event_02_bea3a93a:
    "Я могу лишь растерянно моргать."

# ch/harems_full/criminal/events.rpy:327
translate russian criminal_harem_event_02_f7575a73:
    "Совершенно не понимаю, что имеет в виду Камила."

# ch/harems_full/criminal/events.rpy:328
translate russian criminal_harem_event_02_f12a9c79:
    camila.say "Вообще-то я тебе и так не верила."

# ch/harems_full/criminal/events.rpy:329
translate russian criminal_harem_event_02_961c8057:
    camila.say "И никак не могла выбросить это из головы."

# ch/harems_full/criminal/events.rpy:330
translate russian criminal_harem_event_02_6a3237bc:
    camila.say "Всё представляла вас с ней вместе!"

# ch/harems_full/criminal/events.rpy:331
translate russian criminal_harem_event_02_1ac60156:
    mike.say "Что, нас с Лекси?!"

# ch/harems_full/criminal/events.rpy:332
translate russian criminal_harem_event_02_42a31fe5:
    "Камила почти отчаянно кивает."

# ch/harems_full/criminal/events.rpy:334
translate russian criminal_harem_event_02_4500f4f6:
    "Вижу, что она раскраснелась и разволновалась."

# ch/harems_full/criminal/events.rpy:335
translate russian criminal_harem_event_02_4f2132ab:
    "Одного разговора о нас с Лекси ей уже достаточно."

# ch/harems_full/criminal/events.rpy:336
translate russian criminal_harem_event_02_805a8d98_1:
    camila.say "Ага..."

# ch/harems_full/criminal/events.rpy:337
translate russian criminal_harem_event_02_24636a38:
    camila.say "Она такая... развратная!"

# ch/harems_full/criminal/events.rpy:338
translate russian criminal_harem_event_02_12b23e9d:
    camila.say "Такая плохая, понимаешь?"

# ch/harems_full/criminal/events.rpy:339
translate russian criminal_harem_event_02_ed8063e1:
    camila.say "Мне всегда немного хотелось быть такой, как она..."

# ch/harems_full/criminal/events.rpy:340
translate russian criminal_harem_event_02_319f6ff4:
    camila.say "Но я должна оставаться хорошим копом."

# ch/harems_full/criminal/events.rpy:341
translate russian criminal_harem_event_02_a60fc60a:
    camila.say "Я бы никогда не смогла попросить её... научить меня."

# ch/harems_full/criminal/events.rpy:342
translate russian criminal_harem_event_02_629da83e:
    "Камила смотрит мне в глаза."

# ch/harems_full/criminal/events.rpy:343
translate russian criminal_harem_event_02_0a744702:
    "Я ещё никогда не видел в её взгляде столько желания."

# ch/harems_full/criminal/events.rpy:344
translate russian criminal_harem_event_02_9246038a:
    camila.say "Но, может, ты бы мог..."

# ch/harems_full/criminal/events.rpy:345
translate russian criminal_harem_event_02_a50c7025:
    camila.say "Может, мы втроём смогли бы..."

# ch/harems_full/criminal/events.rpy:346
translate russian criminal_harem_event_02_10f794a9:
    "До меня доходит, и я киваю."

# ch/harems_full/criminal/events.rpy:347
translate russian criminal_harem_event_02_32320568:
    mike.say "Понимаю, о чём ты просишь, Камила."

# ch/harems_full/criminal/events.rpy:348
translate russian criminal_harem_event_02_2dc2e6f9:
    mike.say "Не волнуйся."

# ch/harems_full/criminal/events.rpy:349
translate russian criminal_harem_event_02_382676db:
    mike.say "Уверен, я смогу уговорить Лекси."

# ch/harems_full/criminal/events.rpy:352
translate russian criminal_harem_event_02_ebfa58f1:
    "Камила вдруг краснеет."

# ch/harems_full/criminal/events.rpy:353
translate russian criminal_harem_event_02_c1a45fdf:
    "Уверен, не только от облегчения, но и от желания."

# ch/harems_full/criminal/events.rpy:357
translate russian criminal_harem_event_02_2c6e6c7b:
    camila.say "Вообще-то это совсем нехорошо, [lssb_common.hero_name()]."

# ch/harems_full/criminal/events.rpy:358
translate russian criminal_harem_event_02_a665d092:
    camila.say "Ты мне врал и злоупотребил моим доверием."

# ch/harems_full/criminal/events.rpy:359
translate russian criminal_harem_event_02_ba66d6b0:
    camila.say "И хуже того — всё это с известной преступницей!"

# ch/harems_full/criminal/events.rpy:361
translate russian criminal_harem_event_02_ad798abc:
    "Я беспомощно пожимаю плечами."

# ch/harems_full/criminal/events.rpy:362
translate russian criminal_harem_event_02_971e09da:
    "В свою защиту мне действительно нечего сказать."

# ch/harems_full/criminal/events.rpy:363
translate russian criminal_harem_event_02_84a2c291:
    mike.say "Прости, Камила."

# ch/harems_full/criminal/events.rpy:364
translate russian criminal_harem_event_02_1ac2f170:
    mike.say "Знаю, это ничего не изменит."

# ch/harems_full/criminal/events.rpy:365
translate russian criminal_harem_event_02_b2379ce7:
    mike.say "Но мне правда жаль."

# ch/harems_full/criminal/events.rpy:366
translate russian criminal_harem_event_02_4e714f5f:
    "Она кивает."

# ch/harems_full/criminal/events.rpy:367
translate russian criminal_harem_event_02_39dc7e9a:
    "Затем разочарованно вздыхает."

# ch/harems_full/criminal/events.rpy:369
translate russian criminal_harem_event_02_5edd0207:
    camila.say "Мне тоже, [lssb_common.hero_name()]."

# ch/harems_full/criminal/events.rpy:370
translate russian criminal_harem_event_02_247559d1:
    camila.say "Потому что теперь мы не можем продолжать встречаться."

# ch/harems_full/criminal/events.rpy:371
translate russian criminal_harem_event_02_b403616a:
    camila.say "Мне жаль, что между нами всё кончено."

# ch/harems_full/criminal/events.rpy:373
translate russian criminal_harem_event_02_2191234e:
    "Но Камила поднимает руку, не давая мне заговорить."

# ch/harems_full/criminal/events.rpy:374
translate russian criminal_harem_event_02_00d2245b:
    "Затем уходит."

# ch/harems_full/criminal/events.rpy:375
translate russian criminal_harem_event_02_b391dd6d:
    "Я остаюсь один, сожалея о своих дурных решениях."

# ch/harems_full/criminal/events.rpy:385
translate russian criminal_harem_event_03_bf66d578:
    "Мы с Лекси только что решили закончить свидание и отправиться домой."

# ch/harems_full/criminal/events.rpy:386
translate russian criminal_harem_event_03_7eb10d6e:
    "Не потому, что всё прошло плохо: напротив, вечер был отличным."

# ch/harems_full/criminal/events.rpy:387
translate russian criminal_harem_event_03_44e7ce91:
    "Просто утром мне на работу, так что нужно хоть немного поспать."

# ch/harems_full/criminal/events.rpy:388
translate russian criminal_harem_event_03_02ec0294:
    "А Лекси... э-э... Я, вообще-то, не знаю, чем Лекси займётся завтра."

# ch/harems_full/criminal/events.rpy:389
translate russian criminal_harem_event_03_2db52aec:
    "Но, полагаю, ей тоже нужно выспаться, чтобы набраться сил!"

# ch/harems_full/criminal/events.rpy:391
translate russian criminal_harem_event_03_f7be0067:
    mike.say "Может, вызовем такси?"

# ch/harems_full/criminal/events.rpy:392
translate russian criminal_harem_event_03_a97eff0c:
    mike.say "Эта дорога ведёт через довольно стрёмный район!"

# ch/harems_full/criminal/events.rpy:394
translate russian criminal_harem_event_03_e33001f1:
    "Лекси смотрит на меня так, будто из моего рта торчит дымящееся дерьмо."

# ch/harems_full/criminal/events.rpy:396
translate russian criminal_harem_event_03_db1cc5ae:
    "Затем разражается смехом, едва не захлёбываясь."

# ch/harems_full/criminal/events.rpy:397
translate russian criminal_harem_event_03_09979d75:
    lexi.say "Пф-ф..."

# ch/harems_full/criminal/events.rpy:399
translate russian criminal_harem_event_03_ba994996:
    lexi.say "Прости, что ты сейчас сказал?"

# ch/harems_full/criminal/events.rpy:400
translate russian criminal_harem_event_03_f8c9f2c4:
    lexi.say "Считаешь этот район стрёмным?"

# ch/harems_full/criminal/events.rpy:402
translate russian criminal_harem_event_03_f3d7a808:
    lexi.say "Да брось! Я тут всякую хрень творила ещё совсем мелкой!"

# ch/harems_full/criminal/events.rpy:404
translate russian criminal_harem_event_03_0b348b7a:
    "Словно в доказательство Лекси хватает меня за руку."

# ch/harems_full/criminal/events.rpy:405
translate russian criminal_harem_event_03_7fadd3ce:
    "И тащит за собой в сторону неблагополучного района."

# ch/harems_full/criminal/events.rpy:407
translate russian criminal_harem_event_03_ad0c08c1:
    lexi.say "Если кто-нибудь к нам полезет, сам пожалеет!"

# ch/harems_full/criminal/events.rpy:408
translate russian criminal_harem_event_03_1c15bf8b:
    "На моём лице появляется нервная улыбка."

# ch/harems_full/criminal/events.rpy:409
translate russian criminal_harem_event_03_908fdb2d:
    "А про себя я стараюсь поверить её словам."

# ch/harems_full/criminal/events.rpy:410
translate russian criminal_harem_event_03_ff80ba10:
    "Всё-таки она И ПРАВДА боевая девушка."

# ch/harems_full/criminal/events.rpy:411
translate russian criminal_harem_event_03_db87c0d9:
    "Значит, пройти здесь насквозь вполне безопасно, да?"

# ch/harems_full/criminal/events.rpy:412
translate russian criminal_harem_event_03_ca7ef97d:
    "Боже, до чего я докатился?"

# ch/harems_full/criminal/events.rpy:413
translate russian criminal_harem_event_03_040f9c3f:
    "Надеюсь, что моя девушка защитит меня от грабителей и всяких уродов!"

# ch/harems_full/criminal/events.rpy:414
translate russian criminal_harem_event_03_c38d1918:
    "Наверное, мы уже прошли половину опасного района."

# ch/harems_full/criminal/events.rpy:415
translate russian criminal_harem_event_03_3e7c3f54:
    "Я даже начинаю думать, что всё обойдётся."

# ch/harems_full/criminal/events.rpy:416
translate russian criminal_harem_event_03_42cbb5f0:
    "Но тут позади раздаётся строгий властный голос."

# ch/harems_full/criminal/events.rpy:419
translate russian criminal_harem_event_03_6811af4e:
    "???" "Стоять!"

# ch/harems_full/criminal/events.rpy:420
translate russian criminal_harem_event_03_55c38a38:
    "???" "Так-так-так... Кто это у нас тут?"

# ch/harems_full/criminal/events.rpy:421
translate russian criminal_harem_event_03_7aec83aa:
    "???" "Небось очередная грязная шлюшка со своим клиентом!"

# ch/harems_full/criminal/events.rpy:424
translate russian criminal_harem_event_03_7e711ae1:
    "Лекси закатывает глаза, явно привыкнув к такому обращению."

# ch/harems_full/criminal/events.rpy:425
translate russian criminal_harem_event_03_dddf6907:
    "Но в голосе есть что-то знакомое."

# ch/harems_full/criminal/events.rpy:426
translate russian criminal_harem_event_03_20393c5e:
    "Я невольно оборачиваюсь, чтобы посмотреть, кому он принадлежит."

# ch/harems_full/criminal/events.rpy:431
translate russian criminal_harem_event_03_9514e353:
    "Перед нами Камила, в полной форме и с пистолетом на поясе!"

# ch/harems_full/criminal/events.rpy:432
translate russian criminal_harem_event_03_ab297908:
    mike.say "КАМИЛА?!"

# ch/harems_full/criminal/events.rpy:434
translate russian criminal_harem_event_03_43bec077:
    camila.say "[hero.name!u]?!"

# ch/harems_full/criminal/events.rpy:436
translate russian criminal_harem_event_03_96edab1c:
    lexi.say "О..."

# ch/harems_full/criminal/events.rpy:437
translate russian criminal_harem_event_03_846d9e0a:
    lexi.say "Привет, Камила!"

# ch/harems_full/criminal/events.rpy:438
translate russian criminal_harem_event_03_46016f8c:
    lexi.say "Мир тесен, да?"

# ch/harems_full/criminal/events.rpy:439
translate russian criminal_harem_event_03_c7fb49de:
    lexi.say "Давно ты меня не задерживала!"

# ch/harems_full/criminal/events.rpy:440
translate russian criminal_harem_event_03_2c8addd0:
    "Изумлённо смотрю на Лекси."

# ch/harems_full/criminal/events.rpy:441
translate russian criminal_harem_event_03_bc5089aa:
    "Затем поворачиваюсь к Камиле, всё ещё ничего не понимая."

# ch/harems_full/criminal/events.rpy:442
translate russian criminal_harem_event_03_be82c074:
    mike.say "Задерживала?"

# ch/harems_full/criminal/events.rpy:443
translate russian criminal_harem_event_03_043dc87a:
    mike.say "Что значит «задерживала»?!"

# ch/harems_full/criminal/events.rpy:444
translate russian criminal_harem_event_03_2c43d6cf:
    mike.say "Мы ничего не делали, просто шли по улице!"

# ch/harems_full/criminal/events.rpy:446
translate russian criminal_harem_event_03_13f1afe4:
    "Лекси наклоняется ко мне и заговорщически подмигивает."

# ch/harems_full/criminal/events.rpy:447
translate russian criminal_harem_event_03_6c1a9a2f:
    lexi.say "Хорошо придумал, [lssb_common.hero_name()]."

# ch/harems_full/criminal/events.rpy:448
translate russian criminal_harem_event_03_7b258d0d:
    lexi.say "Я всегда так копам и говорила!"

# ch/harems_full/criminal/events.rpy:449
translate russian criminal_harem_event_03_0db7bd96:
    mike.say "Что это, чёрт возьми, значит, Лекси?"

# ch/harems_full/criminal/events.rpy:450
translate russian criminal_harem_event_03_27893d2e:
    mike.say "Мы просто возвращались домой со свидания!"

# ch/harems_full/criminal/events.rpy:451
translate russian criminal_harem_event_03_c1360d8f:
    "Когда Камила нас остановила, она выглядела не менее удивлённой, чем я."

# ch/harems_full/criminal/events.rpy:453
translate russian criminal_harem_event_03_da8b6c3a:
    "Но стоило Лекси заговорить, как ей стало весело."

# ch/harems_full/criminal/events.rpy:454
translate russian criminal_harem_event_03_cc7b8852:
    "И всё же при одном упоминании свидания её настроение снова меняется."

# ch/harems_full/criminal/events.rpy:455
translate russian criminal_harem_event_03_640c8a8c:
    "Теперь она раздражена, почти как будто ревнует."

# ch/harems_full/criminal/events.rpy:456
translate russian criminal_harem_event_03_d1197306:
    camila.say "Знаешь что, Лекси..."

# ch/harems_full/criminal/events.rpy:457
translate russian criminal_harem_event_03_59b00b01:
    camila.say "За то, что ты привела сюда такого бедолагу, как [lssb_common.hero_name()], тебя и правда стоит загрести!"

# ch/harems_full/criminal/events.rpy:459
translate russian criminal_harem_event_03_7f766da0:
    "Лекси тут же ощетинивается в ответ."

# ch/harems_full/criminal/events.rpy:460
translate russian criminal_harem_event_03_9446c2ce:
    lexi.say "Это ещё что значит, а?"

# ch/harems_full/criminal/events.rpy:461
translate russian criminal_harem_event_03_e4ba3b76:
    lexi.say "Со мной ему здесь куда безопаснее, чем с тобой где бы то ни было!"

# ch/harems_full/criminal/events.rpy:463
translate russian criminal_harem_event_03_f68854f3:
    "Камила усмехается и качает головой."

# ch/harems_full/criminal/events.rpy:464
translate russian criminal_harem_event_03_8d212604:
    camila.say "Ты просто дешёвая шлюшка, Лекси."

# ch/harems_full/criminal/events.rpy:465
translate russian criminal_harem_event_03_bcfbe6a3:
    camila.say "Я знаю эти улицы лучше, чем ты когда-либо будешь!"

# ch/harems_full/criminal/events.rpy:466
translate russian criminal_harem_event_03_526a3bdb:
    lexi.say "Да ну?!"

# ch/harems_full/criminal/events.rpy:467
translate russian criminal_harem_event_03_5d166729:
    camila.say "ДА!"

# ch/harems_full/criminal/events.rpy:469
translate russian criminal_harem_event_03_229eba9b:
    mike.say "Девочки?"

# ch/harems_full/criminal/events.rpy:473
translate russian criminal_harem_event_03_413bfd4a:
    "Камила и Лекси одновременно оборачиваются и сверлят меня взглядами."

# ch/harems_full/criminal/events.rpy:474
translate russian criminal_harem_event_03_026fe411:
    "От выражения их глаз я невольно отступаю на шаг."

# ch/harems_full/criminal/events.rpy:475
translate russian criminal_harem_event_03_5129834f:
    mike.say "Обязательно выяснять это прямо на улице?"

# ch/harems_full/criminal/events.rpy:478
translate russian criminal_harem_event_03_d3f1adeb:
    "К моему удивлению, Камила и Лекси кивают."

# ch/harems_full/criminal/events.rpy:479
translate russian criminal_harem_event_03_ce122837:
    camila.say "Ты прав, [lssb_common.hero_name()]."

# ch/harems_full/criminal/events.rpy:480
translate russian criminal_harem_event_03_5dd3c991:
    mike.say "Прав?"

# ch/harems_full/criminal/events.rpy:482
translate russian criminal_harem_event_03_9ce04822:
    lexi.say "Ага, разберёмся вон в том переулке!"

# ch/harems_full/criminal/events.rpy:483
translate russian criminal_harem_event_03_b4e964cb:
    "Прежде чем успеваю возразить, каждая хватает меня за запястье." with hpunch

# ch/harems_full/criminal/events.rpy:484
translate russian criminal_harem_event_03_d44865c6:
    "И они тащат меня за собой в переулок."

# ch/harems_full/criminal/events.rpy:485
translate russian criminal_harem_event_03_ed0bc444:
    "Скрывшись от чужих глаз, останавливаются и отпускают меня."

# ch/harems_full/criminal/events.rpy:491
translate russian criminal_harem_event_03_6f1623be:
    "Я приваливаюсь к стене."

# ch/harems_full/criminal/events.rpy:492
translate russian criminal_harem_event_03_86a03780:
    camila.say "Ладно, как будем решать спор?"

# ch/harems_full/criminal/events.rpy:493
translate russian criminal_harem_event_03_9af872b8:
    lexi.say "Хм..."

# ch/harems_full/criminal/events.rpy:495
translate russian criminal_harem_event_03_1fa41541:
    lexi.say "Дуэль на минетах?"

# ch/harems_full/criminal/events.rpy:497
translate russian criminal_harem_event_03_a8733f0d:
    camila.say "Принимаю вызов!"

# ch/harems_full/criminal/events.rpy:500
translate russian criminal_harem_event_03_29570a06:
    "Камила и Лекси одновременно надвигаются на меня."

# ch/harems_full/criminal/events.rpy:501
translate russian criminal_harem_event_03_67c80c59:
    mike.say "Погодите-ка..."

# ch/harems_full/criminal/events.rpy:503
translate russian criminal_harem_event_03_1c6491ca:
    "Не успеваю закончить, как они стягивают с меня брюки и трусы." with vpunch

# ch/harems_full/criminal/events.rpy:504
translate russian criminal_harem_event_03_da2b515a:
    "Затем опускаются передо мной на колени, каждая со своей стороны."

# ch/harems_full/criminal/events.rpy:505
translate russian criminal_harem_event_03_644334dc:
    "Камила протягивает руки и в мгновение ока расстёгивает мне ширинку."

# ch/harems_full/criminal/events.rpy:506
translate russian criminal_harem_event_03_7e3f0e25:
    "Едва она открывается, Лекси засовывает руку мне в брюки!"

# ch/harems_full/criminal/events.rpy:507
translate russian criminal_harem_event_03_711d4979:
    lexi.say "О... о..."

# ch/harems_full/criminal/events.rpy:508
translate russian criminal_harem_event_03_74ebafcf:
    lexi.say "Поймала!"

# ch/harems_full/criminal/events.rpy:510
translate russian criminal_harem_event_03_0b9a0f6f:
    "Я ахаю, когда Лекси вытаскивает мой член."

# ch/harems_full/criminal/events.rpy:511
translate russian criminal_harem_event_03_417f5b7a:
    "Не успеваю сказать ни слова, как Камила тоже за него хватается."

# ch/harems_full/criminal/events.rpy:514
translate russian criminal_harem_event_03_30e409a9:
    "Какие бы звуки я ни издавал, им, похоже, всё равно."

# ch/harems_full/criminal/events.rpy:515
translate russian criminal_harem_event_03_37fccf1c:
    "Увлечённые своим странным противостоянием, Камила и Лекси полностью меня игнорируют."

# ch/harems_full/criminal/events.rpy:517
translate russian criminal_harem_event_03_280f47ef:
    "Теперь обе гладят мой член."

# ch/harems_full/criminal/events.rpy:518
translate russian criminal_harem_event_03_587ef84d:
    "Наверное, пытаются сделать это чувственно и возбуждающе."

# ch/harems_full/criminal/events.rpy:519
translate russian criminal_harem_event_03_5968ecec:
    "Но мне кажется, что от их стараний останутся сплошные синяки!"

# ch/harems_full/criminal/events.rpy:520
translate russian criminal_harem_event_03_2e96c148:
    "Всё меняется, лишь когда они начинают пихаться и толкать друг друга."

# ch/harems_full/criminal/events.rpy:521
translate russian criminal_harem_event_03_7a10d52e:
    "Камила и Лекси просто шлёпаются по рукам и препираются."

# ch/harems_full/criminal/events.rpy:522
translate russian criminal_harem_event_03_61a514b1:
    "Но это зрелище каким-то странным образом возбуждает."

# ch/harems_full/criminal/events.rpy:523
translate russian criminal_harem_event_03_9ecd7da4:
    "И я ничего не могу поделать с тем, что у меня встаёт!"

# ch/harems_full/criminal/events.rpy:524
translate russian criminal_harem_event_03_531e0423:
    camila.say "Смотри!"

# ch/harems_full/criminal/events.rpy:525
translate russian criminal_harem_event_03_3d2109fe:
    camila.say "Работает!"

# ch/harems_full/criminal/events.rpy:526
translate russian criminal_harem_event_03_c175f104:
    lexi.say "То есть это Я заставляю его работать!"

# ch/harems_full/criminal/events.rpy:527
translate russian criminal_harem_event_03_fc90c15c:
    "Едва член становится полутвёрдым, они набрасываются на него."

# ch/harems_full/criminal/events.rpy:529
translate russian criminal_harem_event_03_6911dbf7:
    "Камила и Лекси обе наклоняются, открыв рты и высунув языки."

# ch/harems_full/criminal/events.rpy:530
translate russian criminal_harem_event_03_5365453a:
    "Но занять одно и то же место они не могут."

# ch/harems_full/criminal/events.rpy:532
translate russian criminal_harem_event_03_551ec57b:
    "И сталкиваются лбами!" with hpunch

# ch/harems_full/criminal/events.rpy:533
translate russian criminal_harem_event_03_b8e0d5b6:
    camila.say "Ай!"

# ch/harems_full/criminal/events.rpy:534
translate russian criminal_harem_event_03_8aad4907:
    lexi.say "О-о, похоже, у меня голова крепче!"

# ch/harems_full/criminal/events.rpy:535
translate russian criminal_harem_event_03_6b70b350:
    "Лекси пользуется случаем и первой обхватывает губами головку."

# ch/harems_full/criminal/events.rpy:536
translate russian criminal_harem_event_03_223a9029:
    "Старается изо всех сил доставить мне удовольствие."

# ch/harems_full/criminal/events.rpy:537
translate russian criminal_harem_event_03_682b09db:
    "Но спустя пару секунд Камила оттаскивает её!"

# ch/harems_full/criminal/events.rpy:539
translate russian criminal_harem_event_03_c7d9cd1b:
    "Оттолкнув Лекси, Камила занимает её место."

# ch/harems_full/criminal/events.rpy:541
translate russian criminal_harem_event_03_3cc1e2e4:
    "Теперь уже она сосёт и лижет так, словно от этого зависит её жизнь!"

# ch/harems_full/criminal/events.rpy:543
translate russian criminal_harem_event_03_baf7a5b2:
    "Девушки снова и снова оттесняют друг друга, пока одна не устраивается сверху, а другая снизу."

# ch/harems_full/criminal/events.rpy:544
translate russian criminal_harem_event_03_9fdab7cd:
    "Вдруг ощущения становятся куда приятнее."

# ch/harems_full/criminal/events.rpy:545
translate russian criminal_harem_event_03_76683dc3:
    "Одна ласкает головку, другая — ствол."

# ch/harems_full/criminal/events.rpy:546
translate russian criminal_harem_event_03_bf8eb1ce:
    "С каждым мгновением мне всё лучше, и я откидываюсь на стену."

# ch/harems_full/criminal/events.rpy:547
translate russian criminal_harem_event_03_e8b8f5fb:
    "Прекратив борьбу, девушки тоже словно успокаиваются."

# ch/harems_full/criminal/events.rpy:549
translate russian criminal_harem_event_03_b7d6e344:
    "С удивлением вижу, как они несколько раз меняются местами."

# ch/harems_full/criminal/events.rpy:551
translate russian criminal_harem_event_03_8234545e:
    "Причём плавно и без ссор!"

# ch/harems_full/criminal/events.rpy:552
translate russian criminal_harem_event_03_eb4c9d02:
    "Мне остаётся лишь опереться на стену и изумлённо смотреть на них сверху вниз."

# ch/harems_full/criminal/events.rpy:553
translate russian criminal_harem_event_03_2eb2affc:
    "Словно кто-то их заколдовал."

# ch/harems_full/criminal/events.rpy:554
translate russian criminal_harem_event_03_1ec7a698:
    "Языки, губы и зубы словно танцуют вокруг моего члена."

# ch/harems_full/criminal/events.rpy:555
translate russian criminal_harem_event_03_f7de8ddb:
    "И с каждым мгновением становится всё лучше."

# ch/harems_full/criminal/events.rpy:559
translate russian criminal_harem_event_03_593a934a:
    "Не знаю, понимают ли девушки по моим сбивчивым словам."

# ch/harems_full/criminal/events.rpy:560
translate russian criminal_harem_event_03_f086c84e:
    "Или чувствуют это по движениям тела."

# ch/harems_full/criminal/events.rpy:562
translate russian criminal_harem_event_03_bc3e63ea:
    "Но, похоже, они узнают, что я сейчас кончу, раньше меня самого."

# ch/harems_full/criminal/events.rpy:564
translate russian criminal_harem_event_03_509097cf:
    "На мгновение кажется, что они будут действовать сообща до самого конца."

# ch/harems_full/criminal/events.rpy:566
translate russian criminal_harem_event_03_32ee01e4:
    "Но тут Камила толкает Лекси локтем в рёбра и оттесняет её." with hpunch

# ch/harems_full/criminal/events.rpy:568
translate russian criminal_harem_event_03_cb66da56:
    "Затем набрасывается на мой член и берёт его в рот."

# ch/harems_full/criminal/events.rpy:570
translate russian criminal_harem_event_03_d0f37f5c:
    "Едва её губы смыкаются вокруг него, я кончаю."

# ch/harems_full/criminal/events.rpy:571
translate russian criminal_harem_event_03_c1aa62f8:
    "И Камила без колебаний проглатывает всё до последней капли."

# ch/harems_full/criminal/events.rpy:572
translate russian criminal_harem_event_03_0e3031cd:
    lexi.say "Уф..."

# ch/harems_full/criminal/events.rpy:573
translate russian criminal_harem_event_03_afff893d:
    lexi.say "Типичный коп — прогнила насквозь!"

# ch/harems_full/criminal/events.rpy:575
translate russian criminal_harem_event_03_509097cf_1:
    "На мгновение кажется, что они будут действовать сообща до самого конца."

# ch/harems_full/criminal/events.rpy:577
translate russian criminal_harem_event_03_bd6343b0:
    "Но тут Лекси толкает Камилу локтем в рёбра и оттесняет её." with hpunch

# ch/harems_full/criminal/events.rpy:579
translate russian criminal_harem_event_03_cb66da56_1:
    "Затем набрасывается на мой член и берёт его в рот."

# ch/harems_full/criminal/events.rpy:581
translate russian criminal_harem_event_03_d0f37f5c_1:
    "Едва её губы смыкаются вокруг него, я кончаю."

# ch/harems_full/criminal/events.rpy:583
translate russian criminal_harem_event_03_29a38aa5:
    "И Лекси без колебаний проглатывает всё до последней капли."

# ch/harems_full/criminal/events.rpy:584
translate russian criminal_harem_event_03_5fe868f8:
    camila.say "Уф..."

# ch/harems_full/criminal/events.rpy:585
translate russian criminal_harem_event_03_bbb6c7f5:
    camila.say "Ты никогда не меняешься, Лекси..."

# ch/harems_full/criminal/events.rpy:586
translate russian criminal_harem_event_03_dab9bce8:
    camila.say "Была жуликоватой — такой и останешься!"

# ch/harems_full/criminal/events.rpy:588
translate russian criminal_harem_event_03_1dd96f1c:
    "Камила и Лекси стоят передо мной на коленях бок о бок."

# ch/harems_full/criminal/events.rpy:589
translate russian criminal_harem_event_03_b9852fb9:
    "Похоже, перемирие всё ещё действует."

# ch/harems_full/criminal/events.rpy:591
translate russian criminal_harem_event_03_fa339be4:
    "Оно сохраняется даже тогда, когда я кончаю на них."

# ch/harems_full/criminal/events.rpy:593
translate russian criminal_harem_event_03_13471c36:
    "Оба улыбающихся лица покрываются спермой."

# ch/harems_full/criminal/events.rpy:594
translate russian criminal_harem_event_03_bfa19cb3:
    "Струи ложатся то на одну, то на другую."

# ch/harems_full/criminal/events.rpy:596
translate russian criminal_harem_event_03_4fcf7f66:
    "Так что между их лицами тоже тянутся капли."

# ch/harems_full/criminal/events.rpy:597
translate russian criminal_harem_event_03_5fe868f8_1:
    camila.say "Уф..."

# ch/harems_full/criminal/events.rpy:598
translate russian criminal_harem_event_03_656fc805:
    camila.say "Мне это было нужно!"

# ch/harems_full/criminal/events.rpy:599
translate russian criminal_harem_event_03_99d13971:
    lexi.say "Видишь, [lssb_common.hero_name()]?"

# ch/harems_full/criminal/events.rpy:600
translate russian criminal_harem_event_03_0761424f:
    lexi.say "Я же говорила, что район не такой уж плохой!"

# ch/harems_full/criminal/events.rpy:604
translate russian criminal_harem_event_03_70cce918:
    "Камила и Лекси оставляют меня одного посреди переулка."

# ch/harems_full/criminal/events.rpy:605
translate russian criminal_harem_event_03_8eb5c355:
    "Я возвращаюсь домой и ложусь спать."

# ch/harems_full/criminal/events.rpy:613
translate russian missed_criminal_harem_date_0085429a:
    "Чёрт, я пропустил свидание. Лекси и Камила будут злиться."

# ch/harems_full/criminal/events.rpy:621
translate russian criminal_harem_event_04_da43a77d:
    "Я стою на улице перед рестораном."

# ch/harems_full/criminal/events.rpy:622
translate russian criminal_harem_event_04_62f57fc0:
    "И, кажется, каждые несколько секунд проверяю время."

# ch/harems_full/criminal/events.rpy:623
translate russian criminal_harem_event_04_546dcb27:
    "А думаю только о документальных фильмах, где ради окончания войны договариваются о перемирии."

# ch/harems_full/criminal/events.rpy:624
translate russian criminal_harem_event_04_9f0ee3d6:
    "Да, понимаю: довольно странные мысли для человека, который пришёл на свидание."

# ch/harems_full/criminal/events.rpy:625
translate russian criminal_harem_event_04_a02dd0ad:
    "Но стоит вспомнить, через что я прошёл, организуя всё это, и сходство кажется очевидным."

# ch/harems_full/criminal/events.rpy:626
translate russian criminal_harem_event_04_d4cd551e:
    "Камила и Лекси, конечно, не две воюющие страны."

# ch/harems_full/criminal/events.rpy:627
translate russian criminal_harem_event_04_b3c946fb:
    "Но, с моей точки зрения, общего немало."

# ch/harems_full/criminal/events.rpy:628
translate russian criminal_harem_event_04_64a9acf5:
    "Я, наверное, предложил сотню вариантов совместного свидания."

# ch/harems_full/criminal/events.rpy:629
translate russian criminal_harem_event_04_76f6bf2d:
    "И девяносто девять из них отвергли без всякой пощады."

# ch/harems_full/criminal/events.rpy:630
translate russian criminal_harem_event_04_799915db:
    "Лекси не хочет в боулинг, потому что там выдают отвратительные туфли."

# ch/harems_full/criminal/events.rpy:631
translate russian criminal_harem_event_04_6467009d:
    "Камила против картинга: он может напомнить ей о погонях на работе."

# ch/harems_full/criminal/events.rpy:632
translate russian criminal_harem_event_04_acc950d8:
    "И так без конца, пока я не предложил просто поужинать в хорошем ресторане."

# ch/harems_full/criminal/events.rpy:633
translate russian criminal_harem_event_04_44c80590:
    "Ожидал, что обе сочтут идею скучной и откажутся."

# ch/harems_full/criminal/events.rpy:634
translate russian criminal_harem_event_04_b8e91654:
    "Но, к моему удивлению, обе согласились!"

# ch/harems_full/criminal/events.rpy:635
translate russian criminal_harem_event_04_faaa8cb1:
    "Только теперь обе опаздывают, и я начинаю тревожиться..."

# ch/harems_full/criminal/events.rpy:637
translate russian criminal_harem_event_04_396b5112:
    lexi.say "Приветик, [lssb_common.hero_name()]!"

# ch/harems_full/criminal/events.rpy:640
translate russian criminal_harem_event_04_df0cc3cf:
    "Да, понимаю: взвизгнуть и подскочить на метр — не слишком мужественно."

# ch/harems_full/criminal/events.rpy:641
translate russian criminal_harem_event_04_86af3423:
    "Но Лекси практически подкралась и заговорила прямо мне в ухо!"

# ch/harems_full/criminal/events.rpy:643
translate russian criminal_harem_event_04_1823ebfb:
    lexi.say "Господи..."

# ch/harems_full/criminal/events.rpy:644
translate russian criminal_harem_event_04_e292430a:
    lexi.say "Что ты такой нервный?"

# ch/harems_full/criminal/events.rpy:645
translate russian criminal_harem_event_04_94ec7d23:
    mike.say "Не знаю, Лекси..."

# ch/harems_full/criminal/events.rpy:646
translate russian criminal_harem_event_04_0efc3640:
    mike.say "Может, дело в тех, кто опаздывает?"

# ch/harems_full/criminal/events.rpy:647
translate russian criminal_harem_event_04_b807162d:
    mike.say "И заодно пугает меня до смерти!"

# ch/harems_full/criminal/events.rpy:648
translate russian criminal_harem_event_04_b5838544:
    "Лекси закатывает глаза и отмахивается."

# ch/harems_full/criminal/events.rpy:652
translate russian criminal_harem_event_04_068a6276:
    "Недвусмысленно даёт понять, что ей плевать."

# ch/harems_full/criminal/events.rpy:653
translate russian criminal_harem_event_04_3cf3794e:
    lexi.say "Как скажешь, [lssb_common.hero_name()]."

# ch/harems_full/criminal/events.rpy:655
translate russian criminal_harem_event_04_37dc19f7:
    lexi.say "Не ТАК уж я и опоздала!"

# ch/harems_full/criminal/events.rpy:656
translate russian criminal_harem_event_04_f6e59d2d:
    lexi.say "И вообще, что-то я тут нигде не вижу Грязную Гарриет!"

# ch/harems_full/criminal/events.rpy:657
translate russian criminal_harem_event_04_80beecc6:
    "Хмурюсь: приходится признать, что Лекси права."

# ch/harems_full/criminal/events.rpy:658
translate russian criminal_harem_event_04_22533df5:
    "Она опоздала, но всё же пришла раньше Камилы."

# ch/harems_full/criminal/events.rpy:659
translate russian criminal_harem_event_04_044712d1:
    mike.say "Не знаю, Лекси."

# ch/harems_full/criminal/events.rpy:660
translate russian criminal_harem_event_04_c693bbc1:
    mike.say "Она даже не позвонила."

# ch/harems_full/criminal/events.rpy:661
translate russian criminal_harem_event_04_363e9b84:
    lexi.say "А я голодная!"

# ch/harems_full/criminal/events.rpy:662
translate russian criminal_harem_event_04_d009a656:
    lexi.say "Пойдём уже внутрь, а?"

# ch/harems_full/criminal/events.rpy:663
translate russian criminal_harem_event_04_9807f578:
    lexi.say "Она присоединится, когда дотащит сюда свою задницу!"

# ch/harems_full/criminal/events.rpy:666
translate russian criminal_harem_event_04_b351b521:
    mike.say "Мы не можем зайти без Камилы."

# ch/harems_full/criminal/events.rpy:667
translate russian criminal_harem_event_04_6728af09:
    mike.say "Придётся подождать её здесь."

# ch/harems_full/criminal/events.rpy:669
translate russian criminal_harem_event_04_5c48b4b4:
    "Вижу, что Лекси эта идея сразу не нравится."

# ch/harems_full/criminal/events.rpy:670
translate russian criminal_harem_event_04_9aed39c5:
    "Но я намеренно не стал спрашивать."

# ch/harems_full/criminal/events.rpy:671
translate russian criminal_harem_event_04_49ec4ab1:
    "И не даю ей возможности возразить."

# ch/harems_full/criminal/events.rpy:672
translate russian criminal_harem_event_04_7b0d00e1:
    "Просто избегаю встречаться с ней взглядом."

# ch/harems_full/criminal/events.rpy:673
translate russian criminal_harem_event_04_15b3f0a2:
    "И смотрю на улицу, пока наконец не замечаю приближающуюся Камилу."

# ch/harems_full/criminal/events.rpy:675
translate russian criminal_harem_event_04_5de1f8e8:
    camila.say "Что вы тут стоите?"

# ch/harems_full/criminal/events.rpy:677
translate russian criminal_harem_event_04_fdbfd48a:
    mike.say "Ждём тебя, Камила!"

# ch/harems_full/criminal/events.rpy:678
translate russian criminal_harem_event_04_b67ba260:
    lexi.say "А на что, чёрт возьми, похоже?"

# ch/harems_full/criminal/events.rpy:680
translate russian criminal_harem_event_04_885c5f41:
    camila.say "Почему не подождали внутри?"

# ch/harems_full/criminal/events.rpy:681
translate russian criminal_harem_event_04_cdbe4914:
    camila.say "Например, у бара?"

# ch/harems_full/criminal/events.rpy:683
translate russian criminal_harem_event_04_811495aa:
    lexi.say "Я так и сказала!"

# ch/harems_full/criminal/events.rpy:685
translate russian criminal_harem_event_04_d427d59e:
    mike.say "Лекси, это неправда!"

# ch/harems_full/criminal/events.rpy:686
translate russian criminal_harem_event_04_f154de6f:
    mike.say "Ты хотела поесть без неё!"

# ch/harems_full/criminal/events.rpy:690
translate russian criminal_harem_event_04_9477cfd2:
    "Когда мы начинаем препираться, Камила встаёт между нами."

# ch/harems_full/criminal/events.rpy:691
translate russian criminal_harem_event_04_49fd8775:
    "И поднимает руку, заставляя обоих замолчать."

# ch/harems_full/criminal/events.rpy:693
translate russian criminal_harem_event_04_5fe868f8:
    camila.say "Уф..."

# ch/harems_full/criminal/events.rpy:694
translate russian criminal_harem_event_04_5ff21799:
    camila.say "Вы двое можете прекратить?"

# ch/harems_full/criminal/events.rpy:695
translate russian criminal_harem_event_04_0ce7ff19:
    camila.say "У меня был тяжёлый день, и я не в настроении!"

# ch/harems_full/criminal/events.rpy:696
translate russian criminal_harem_event_04_9e36bda5:
    "Мы с Лекси подчиняемся, бормоча себе под нос и обмениваясь обвиняющими взглядами."

# ch/harems_full/criminal/events.rpy:697
translate russian criminal_harem_event_04_b63d6e99:
    "Затем все вместе заходим в ресторан, уже чувствуя раздражение и неловкость."

# ch/harems_full/criminal/events.rpy:701
translate russian criminal_harem_event_04_4efec6eb:
    "Вдруг я кое-что вспоминаю о ресторане."

# ch/harems_full/criminal/events.rpy:702
translate russian criminal_harem_event_04_a2168ab0:
    "В нём есть небольшой бар как раз для таких случаев."

# ch/harems_full/criminal/events.rpy:703
translate russian criminal_harem_event_04_e9a9b39f:
    "Недостаточно большой, чтобы провести там всю ночь за выпивкой."

# ch/harems_full/criminal/events.rpy:704
translate russian criminal_harem_event_04_c14120c4:
    "Но в самый раз, чтобы дождаться опаздывающего спутника."

# ch/harems_full/criminal/events.rpy:705
translate russian criminal_harem_event_04_3e874ab5:
    mike.say "Может, найдём компромисс, Лекси?"

# ch/harems_full/criminal/events.rpy:706
translate russian criminal_harem_event_04_3949cea6:
    mike.say "Выпьем и подождём у бара?"

# ch/harems_full/criminal/events.rpy:708
translate russian criminal_harem_event_04_bcfd2b01:
    "Лекси словно собирается возразить из принципа."

# ch/harems_full/criminal/events.rpy:709
translate russian criminal_harem_event_04_7c99da65:
    "Но затем обдумывает предложение, и выражение её лица меняется."

# ch/harems_full/criminal/events.rpy:711
translate russian criminal_harem_event_04_c8c0603e:
    lexi.say "Конечно, почему бы и нет?"

# ch/harems_full/criminal/events.rpy:715
translate russian criminal_harem_event_04_98b8e5cf:
    "Мы заходим внутрь и заказываем по напитку у бара."

# ch/harems_full/criminal/events.rpy:717
translate russian criminal_harem_event_04_35b47c9d:
    "Немного погодя приходит Камила."

# ch/harems_full/criminal/events.rpy:718
translate russian criminal_harem_event_04_8c37ddf8:
    camila.say "Извините за опоздание."

# ch/harems_full/criminal/events.rpy:719
translate russian criminal_harem_event_04_b1032d25:
    camila.say "Под конец смены оказалась связана по рукам и ногам."

# ch/harems_full/criminal/events.rpy:721
translate russian criminal_harem_event_04_4db623c7:
    lexi.say "Надеюсь, в буквальном смысле!"

# ch/harems_full/criminal/events.rpy:722
translate russian criminal_harem_event_04_3c7c5eae:
    mike.say "Ничего страшного, Камила."

# ch/harems_full/criminal/events.rpy:723
translate russian criminal_harem_event_04_4c85b9ba:
    mike.say "Давай я закажу тебе выпить."

# ch/harems_full/criminal/events.rpy:724
translate russian criminal_harem_event_04_a2fa6fe8:
    mike.say "А потом пойдём за столик..."

# ch/harems_full/criminal/events.rpy:726
translate russian criminal_harem_event_04_fe758b1b:
    "Камилу такой порядок, похоже, устраивает."

# ch/harems_full/criminal/events.rpy:727
translate russian criminal_harem_event_04_cc26870d:
    "Да и алкоголь немного смягчил настроение Лекси."

# ch/harems_full/criminal/events.rpy:728
translate russian criminal_harem_event_04_caa2dd89:
    "Хотя бы маленькая победа."

# ch/harems_full/criminal/events.rpy:732
translate russian criminal_harem_event_04_ecd1405c:
    mike.say "Знаешь, Лекси, а ты права!"

# ch/harems_full/criminal/events.rpy:734
translate russian criminal_harem_event_04_8373ae87:
    lexi.say "Правда?!"

# ch/harems_full/criminal/events.rpy:735
translate russian criminal_harem_event_04_39a36a9f:
    mike.say "Конечно."

# ch/harems_full/criminal/events.rpy:736
translate russian criminal_harem_event_04_e7f3592a:
    mike.say "Камила могла позвонить и предупредить, что опаздывает."

# ch/harems_full/criminal/events.rpy:737
translate russian criminal_harem_event_04_fb80364c:
    mike.say "Так что сама виновата, если мы начнём без неё."

# ch/harems_full/criminal/events.rpy:739
translate russian criminal_harem_event_04_f67752d8:
    "Лекси чертовски довольна моим решением."

# ch/harems_full/criminal/events.rpy:740
translate russian criminal_harem_event_04_e5a1a5fa:
    "Берёт меня под руку, и я веду её внутрь."

# ch/harems_full/criminal/events.rpy:744
translate russian criminal_harem_event_04_6aa130af:
    "Вскоре мы уже сидим за столиком и изучаем меню."

# ch/harems_full/criminal/events.rpy:745
translate russian criminal_harem_event_04_785504d1:
    "И именно в этот момент входит Камила."

# ch/harems_full/criminal/events.rpy:747
translate russian criminal_harem_event_04_725a467c:
    camila.say "Что вы делаете?"

# ch/harems_full/criminal/events.rpy:750
translate russian criminal_harem_event_04_cc0e11c1:
    mike.say "Садимся ужинать, Камила!"

# ch/harems_full/criminal/events.rpy:751
translate russian criminal_harem_event_04_b67ba260_1:
    lexi.say "А на что, чёрт возьми, похоже?"

# ch/harems_full/criminal/events.rpy:752
translate russian criminal_harem_event_04_0937f663:
    camila.say "Почему вы меня не подождали?"

# ch/harems_full/criminal/events.rpy:754
translate russian criminal_harem_event_04_cdbe4914_1:
    camila.say "Например, у бара?"

# ch/harems_full/criminal/events.rpy:755
translate russian criminal_harem_event_04_550e1a4b:
    mike.say "Ты не позвонила и не предупредила, что опаздываешь, Камила."

# ch/harems_full/criminal/events.rpy:756
translate russian criminal_harem_event_04_fc6051da:
    lexi.say "Вот мы и начали без тебя!"

# ch/harems_full/criminal/events.rpy:757
translate russian criminal_harem_event_04_53412ee6:
    "Камила поднимает руку, заставляя нас обоих замолчать."

# ch/harems_full/criminal/events.rpy:758
translate russian criminal_harem_event_04_5fe868f8_1:
    camila.say "Уф..."

# ch/harems_full/criminal/events.rpy:759
translate russian criminal_harem_event_04_5ff21799_1:
    camila.say "Вы двое можете прекратить?"

# ch/harems_full/criminal/events.rpy:761
translate russian criminal_harem_event_04_0ce7ff19_1:
    camila.say "У меня был тяжёлый день, и я не в настроении!"

# ch/harems_full/criminal/events.rpy:766
translate russian criminal_harem_event_04_b0577092:
    "Она садится за стол, явно недовольная нами с Лекси."

# ch/harems_full/criminal/events.rpy:767
translate russian criminal_harem_event_04_4ab1a44a:
    "Начало свидания получается неловким."

# ch/harems_full/criminal/events.rpy:771
translate russian criminal_harem_event_04_4efec6eb_1:
    "Вдруг я кое-что вспоминаю о ресторане."

# ch/harems_full/criminal/events.rpy:772
translate russian criminal_harem_event_04_a2168ab0_1:
    "В нём есть небольшой бар как раз для таких случаев."

# ch/harems_full/criminal/events.rpy:773
translate russian criminal_harem_event_04_e9a9b39f_1:
    "Недостаточно большой, чтобы провести там всю ночь за выпивкой."

# ch/harems_full/criminal/events.rpy:774
translate russian criminal_harem_event_04_c14120c4_1:
    "Но в самый раз, чтобы дождаться опаздывающего спутника."

# ch/harems_full/criminal/events.rpy:775
translate russian criminal_harem_event_04_01b46399:
    mike.say "Я подожду Камилу у бара."

# ch/harems_full/criminal/events.rpy:776
translate russian criminal_harem_event_04_e5092d15:
    mike.say "Присоединишься?"

# ch/harems_full/criminal/events.rpy:778
translate russian criminal_harem_event_04_35443e3a:
    "Лекси фыркает и качает головой."

# ch/harems_full/criminal/events.rpy:779
translate russian criminal_harem_event_04_1234739c:
    lexi.say "Ха!"

# ch/harems_full/criminal/events.rpy:781
translate russian criminal_harem_event_04_f8014d45:
    lexi.say "Ещё чего!"

# ch/harems_full/criminal/events.rpy:782
translate russian criminal_harem_event_04_51a062ee:
    lexi.say "Делай что хочешь, а я пойду за столик."

# ch/harems_full/criminal/events.rpy:784
translate russian criminal_harem_event_04_019ae50e:
    "Качаю головой, пока Лекси решительно уходит одна."

# ch/harems_full/criminal/events.rpy:786
translate russian criminal_harem_event_04_e38b6db9:
    "Затем направляюсь к бару и заказываю себе напиток."

# ch/harems_full/criminal/events.rpy:787
translate russian criminal_harem_event_04_35b47c9d_1:
    "Немного погодя приходит Камила."

# ch/harems_full/criminal/events.rpy:789
translate russian criminal_harem_event_04_8c37ddf8_1:
    camila.say "Извините за опоздание."

# ch/harems_full/criminal/events.rpy:791
translate russian criminal_harem_event_04_b1032d25_1:
    camila.say "Под конец смены оказалась связана по рукам и ногам."

# ch/harems_full/criminal/events.rpy:792
translate russian criminal_harem_event_04_df35ef90:
    mike.say "Надеюсь, не в буквальном смысле!"

# ch/harems_full/criminal/events.rpy:793
translate russian criminal_harem_event_04_4c85b9ba_1:
    mike.say "Давай я закажу тебе выпить."

# ch/harems_full/criminal/events.rpy:794
translate russian criminal_harem_event_04_a2fa6fe8_1:
    mike.say "А потом пойдём за столик..."

# ch/harems_full/criminal/events.rpy:796
translate russian criminal_harem_event_04_00f31b65:
    "Камила кивает, затем недоумённо оглядывается."

# ch/harems_full/criminal/events.rpy:797
translate russian criminal_harem_event_04_b27fd7e0:
    camila.say "Лекси ещё не пришла?"

# ch/harems_full/criminal/events.rpy:798
translate russian criminal_harem_event_04_6145a1d7:
    mike.say "Пришла, но сразу пошла за столик."

# ch/harems_full/criminal/events.rpy:800
translate russian criminal_harem_event_04_f4efbf0a:
    "Камила закатывает глаза и качает головой."

# ch/harems_full/criminal/events.rpy:801
translate russian criminal_harem_event_04_15b3f822:
    camila.say "Вся в её духе!"

# ch/harems_full/criminal/events.rpy:803
translate russian criminal_harem_event_04_c484f564:
    "Получив напиток для Камилы, мы идём к столику."

# ch/harems_full/criminal/events.rpy:804
translate russian criminal_harem_event_04_af34aab9:
    "Она явно недовольна Лекси."

# ch/harems_full/criminal/events.rpy:805
translate russian criminal_harem_event_04_4ab1a44a_1:
    "Начало свидания получается неловким."

# ch/harems_full/criminal/events.rpy:806
translate russian criminal_harem_event_04_7165b0e8:
    "Но хотя бы злится не на меня!"

# ch/harems_full/criminal/events.rpy:813
translate russian criminal_harem_event_04_7cd1e31f:
    "Теперь, когда все за столом, свидание можно начинать."

# ch/harems_full/criminal/events.rpy:814
translate russian criminal_harem_event_04_a9348362:
    "Я дарю Камиле и Лекси улыбку, надеюсь, одну из своих лучших."

# ch/harems_full/criminal/events.rpy:815
translate russian criminal_harem_event_04_84bf0b3e:
    mike.say "Надеюсь, вам здесь понравится."

# ch/harems_full/criminal/events.rpy:816
translate russian criminal_harem_event_04_54b5c5e2:
    mike.say "Я слышал об этом месте много хорошего!"

# ch/harems_full/criminal/events.rpy:817
translate russian criminal_harem_event_04_d5f7ee37:
    "Жду, что хотя бы одна из девушек ответит."

# ch/harems_full/criminal/events.rpy:818
translate russian criminal_harem_event_04_ada5b54b:
    "Но они, кажется, просто сверлят друг друга взглядами."

# ch/harems_full/criminal/events.rpy:819
translate russian criminal_harem_event_04_fdbdbd09:
    lexi.say "Я не против хорошо провести время, [lssb_common.hero_name()]."

# ch/harems_full/criminal/events.rpy:821
translate russian criminal_harem_event_04_4f9628e1:
    lexi.say "Всё-таки именно я пришла вовремя!"

# ch/harems_full/criminal/events.rpy:823
translate russian criminal_harem_event_04_e49cfadd:
    camila.say "Я уже объяснила, Лекси."

# ch/harems_full/criminal/events.rpy:824
translate russian criminal_harem_event_04_22a79e2b:
    camila.say "Была занята на работе."

# ch/harems_full/criminal/events.rpy:826
translate russian criminal_harem_event_04_cca8519f:
    camila.say "Возможно, задерживала твоих лучших друзей!"

# ch/harems_full/criminal/events.rpy:828
translate russian criminal_harem_event_04_d089bd7d:
    lexi.say "Что ты сказала?!"

# ch/harems_full/criminal/events.rpy:829
translate russian criminal_harem_event_04_f956cbb7:
    lexi.say "Большинство моих старых дружков были продажными копами!"

# ch/harems_full/criminal/events.rpy:831
translate russian criminal_harem_event_04_ee2bc65e:
    "Вдруг обе выглядят так, будто готовы сцепиться."

# ch/harems_full/criminal/events.rpy:832
translate russian criminal_harem_event_04_6dea7832:
    "Понимаю, что нужно что-то сделать, пока до этого не дошло!"

# ch/harems_full/criminal/events.rpy:835
translate russian criminal_harem_event_04_127036d2:
    "Обычно я могу пропустить мимо ушей большую часть того, что говорит Лекси."

# ch/harems_full/criminal/events.rpy:836
translate russian criminal_harem_event_04_f9bf38f7:
    "Но сейчас её нападки на Камилу почему-то задевают меня."

# ch/harems_full/criminal/events.rpy:837
translate russian criminal_harem_event_04_2d9d0ac2:
    mike.say "Не стоит так говорить о работе Камилы, Лекси."

# ch/harems_full/criminal/events.rpy:838
translate russian criminal_harem_event_04_67d8cdaa:
    mike.say "Она почти каждый день выходит на улицы, чтобы там было безопасно."

# ch/harems_full/criminal/events.rpy:839
translate russian criminal_harem_event_04_8c8d2761:
    mike.say "Да и с теми, кого она арестовывает, тебе жилось не так уж прекрасно."

# ch/harems_full/criminal/events.rpy:840
translate russian criminal_harem_event_04_175da1ea:
    mike.say "Только не говори, что этот громила Дэнни никогда с тобой плохо не обращался!"

# ch/harems_full/criminal/events.rpy:843
translate russian criminal_harem_event_04_129f4d99:
    "От моего отпора Лекси изумлённо замирает."

# ch/harems_full/criminal/events.rpy:844
translate russian criminal_harem_event_04_20489e14:
    "Но удивление быстро сменяется смущением."

# ch/harems_full/criminal/events.rpy:845
translate russian criminal_harem_event_04_9671adb0:
    lexi.say "Ладно, ладно..."

# ch/harems_full/criminal/events.rpy:847
translate russian criminal_harem_event_04_517bf3e3:
    lexi.say "Я поняла!"

# ch/harems_full/criminal/events.rpy:848
translate russian criminal_harem_event_04_6a8925c0:
    lexi.say "Не надо тыкать меня в это носом..."

# ch/harems_full/criminal/events.rpy:849
translate russian criminal_harem_event_04_2d4f42c3:
    "Мне становится немного стыдно за то, как я обошёлся с Лекси."

# ch/harems_full/criminal/events.rpy:850
translate russian criminal_harem_event_04_3e9bfce7:
    "Но затем напоминаю себе, что это всё-таки сработало."

# ch/harems_full/criminal/events.rpy:851
translate russian criminal_harem_event_04_391bcbbb:
    "Она оставила эту тему."

# ch/harems_full/criminal/events.rpy:852
translate russian criminal_harem_event_04_5a3f1071:
    "Надеюсь, на сегодня с этим покончено."

# ch/harems_full/criminal/events.rpy:856
translate russian criminal_harem_event_04_3ea85435:
    "Знаю, что прошлое Лекси далеко не безупречно."

# ch/harems_full/criminal/events.rpy:857
translate russian criminal_harem_event_04_6fc9b450:
    "А Камила старается жить по совести."

# ch/harems_full/criminal/events.rpy:858
translate russian criminal_harem_event_04_3859d725:
    "Но мне не нравится, как она постоянно разговаривает с Лекси."

# ch/harems_full/criminal/events.rpy:859
translate russian criminal_harem_event_04_b141d364:
    mike.say "Ладно, Камила, мы поняли."

# ch/harems_full/criminal/events.rpy:860
translate russian criminal_harem_event_04_dd302836:
    mike.say "У Лекси сомнительное прошлое."

# ch/harems_full/criminal/events.rpy:861
translate russian criminal_harem_event_04_ab999172:
    mike.say "А ты суровый коп, который не даёт ей об этом забыть."

# ch/harems_full/criminal/events.rpy:862
translate russian criminal_harem_event_04_eb15e27e:
    mike.say "Может, оставим это хотя бы на время ужина?"

# ch/harems_full/criminal/events.rpy:865
translate russian criminal_harem_event_04_c63f6612:
    "От моего отпора Камила изумлённо замирает."

# ch/harems_full/criminal/events.rpy:866
translate russian criminal_harem_event_04_20489e14_1:
    "Но удивление быстро сменяется смущением."

# ch/harems_full/criminal/events.rpy:867
translate russian criminal_harem_event_04_fde9cfba:
    camila.say "Я... не знала, что ты так к этому относишься, [lssb_common.hero_name()]."

# ch/harems_full/criminal/events.rpy:869
translate russian criminal_harem_event_04_f4d1fdcc:
    camila.say "Раз тебя это так задевает, я перестану, ладно?"

# ch/harems_full/criminal/events.rpy:870
translate russian criminal_harem_event_04_499276db:
    camila.say "Только не продолжай меня этим попрекать..."

# ch/harems_full/criminal/events.rpy:871
translate russian criminal_harem_event_04_de220e73:
    "Мне становится немного стыдно за то, как я обошёлся с Камилой."

# ch/harems_full/criminal/events.rpy:872
translate russian criminal_harem_event_04_3e9bfce7_1:
    "Но затем напоминаю себе, что это всё-таки сработало."

# ch/harems_full/criminal/events.rpy:873
translate russian criminal_harem_event_04_391bcbbb_1:
    "Она оставила эту тему."

# ch/harems_full/criminal/events.rpy:874
translate russian criminal_harem_event_04_5a3f1071_1:
    "Надеюсь, на сегодня с этим покончено."

# ch/harems_full/criminal/events.rpy:878
translate russian criminal_harem_event_04_4562d06d:
    "Уф..."

# ch/harems_full/criminal/events.rpy:879
translate russian criminal_harem_event_04_258789a9:
    "Почему с ними двумя всё всегда вот так?"

# ch/harems_full/criminal/events.rpy:880
translate russian criminal_harem_event_04_0e18fdc1:
    "Неужели нельзя провести хоть одно свидание без ссор?"

# ch/harems_full/criminal/events.rpy:881
translate russian criminal_harem_event_04_10fda81d:
    mike.say "Так, хватит!"

# ch/harems_full/criminal/events.rpy:882
translate russian criminal_harem_event_04_7bfd7b2b:
    mike.say "Вы можете уже перестать спорить?"

# ch/harems_full/criminal/events.rpy:885
translate russian criminal_harem_event_04_835f5655:
    "Камила и Лекси одновременно поворачиваются ко мне."

# ch/harems_full/criminal/events.rpy:886
translate russian criminal_harem_event_04_02843957:
    "Обе удивлены тем, что я вмешался."

# ch/harems_full/criminal/events.rpy:887
translate russian criminal_harem_event_04_6a71dd16:
    camila.say "Н-но..."

# ch/harems_full/criminal/events.rpy:888
translate russian criminal_harem_event_04_f4d28b08:
    camila.say "Она первая начала!"

# ch/harems_full/criminal/events.rpy:889
translate russian criminal_harem_event_04_718c4d8a:
    lexi.say "Лживая корова!"

# ch/harems_full/criminal/events.rpy:890
translate russian criminal_harem_event_04_d6a65955:
    lexi.say "Ничего я не начинала!"

# ch/harems_full/criminal/events.rpy:891
translate russian criminal_harem_event_04_d2d290a8:
    mike.say "Мне плевать."

# ch/harems_full/criminal/events.rpy:892
translate russian criminal_harem_event_04_8616e201:
    mike.say "Просто прекратите, хорошо?"

# ch/harems_full/criminal/events.rpy:895
translate russian criminal_harem_event_04_e29fff27:
    "Обе кивают и опускают взгляды на стол."

# ch/harems_full/criminal/events.rpy:896
translate russian criminal_harem_event_04_ff42f2b6:
    "Мне становится немного стыдно за то, как я с ними обошёлся."

# ch/harems_full/criminal/events.rpy:897
translate russian criminal_harem_event_04_3e9bfce7_2:
    "Но затем напоминаю себе, что это всё-таки сработало."

# ch/harems_full/criminal/events.rpy:898
translate russian criminal_harem_event_04_ff8a4ab0:
    "Они оставили эту тему."

# ch/harems_full/criminal/events.rpy:899
translate russian criminal_harem_event_04_5a3f1071_2:
    "Надеюсь, на сегодня с этим покончено."

# ch/harems_full/criminal/events.rpy:903
translate russian criminal_harem_event_04_c3a17791:
    "Мне совсем не хочется принимать чью-то сторону."

# ch/harems_full/criminal/events.rpy:904
translate russian criminal_harem_event_04_09b465ec:
    "Но чувствую, что обязан остановить ссору."

# ch/harems_full/criminal/events.rpy:905
translate russian criminal_harem_event_04_65534873:
    "Ломаю голову в поисках решения, и вдруг меня осеняет."

# ch/harems_full/criminal/events.rpy:906
translate russian criminal_harem_event_04_30f0f197:
    mike.say "А знаете..."

# ch/harems_full/criminal/events.rpy:907
translate russian criminal_harem_event_04_78bf1855:
    mike.say "Вы словно две половинки одного целого!"

# ch/harems_full/criminal/events.rpy:910
translate russian criminal_harem_event_04_835f5655_1:
    "Камила и Лекси одновременно поворачиваются ко мне."

# ch/harems_full/criminal/events.rpy:911
translate russian criminal_harem_event_04_dc19fe75:
    "Обе чертовски удивлены моим словам."

# ch/harems_full/criminal/events.rpy:912
translate russian criminal_harem_event_04_9326a775:
    camila.say "Это ещё что значит?"

# ch/harems_full/criminal/events.rpy:914
translate russian criminal_harem_event_04_d3c0ebd5:
    lexi.say "Ага, у нас вообще ничего общего!"

# ch/harems_full/criminal/events.rpy:916
translate russian criminal_harem_event_04_7e215afb:
    mike.say "Именно, Лекси! Я об этом!"

# ch/harems_full/criminal/events.rpy:917
translate russian criminal_harem_event_04_07dcae70:
    mike.say "Вы обе крутые девчонки."

# ch/harems_full/criminal/events.rpy:918
translate russian criminal_harem_event_04_6bba2442:
    mike.say "Только одна на стороне добра, а другая — зла!"

# ch/harems_full/criminal/events.rpy:919
translate russian criminal_harem_event_04_f997dc70:
    camila.say "Погоди..."

# ch/harems_full/criminal/events.rpy:921
translate russian criminal_harem_event_04_5509a292:
    camila.say "Кажется, я понимаю!"

# ch/harems_full/criminal/events.rpy:922
translate russian criminal_harem_event_04_4a8b5e2f:
    lexi.say "Я тоже..."

# ch/harems_full/criminal/events.rpy:924
translate russian criminal_harem_event_04_4cdabe97:
    lexi.say "То есть Камила злая, потому что она коп?"

# ch/harems_full/criminal/events.rpy:925
translate russian criminal_harem_event_04_b710576f:
    camila.say "Эй, он не это имеет в виду!"

# ch/harems_full/criminal/events.rpy:926
translate russian criminal_harem_event_04_c41b06f1:
    "Не могу не усмехнуться: они всё равно продолжают препираться."

# ch/harems_full/criminal/events.rpy:927
translate russian criminal_harem_event_04_819d409a:
    mike.say "Вам бы вместе книгу написать."

# ch/harems_full/criminal/events.rpy:928
translate russian criminal_harem_event_04_21754fb6:
    mike.say "Или хотя бы подкаст записывать!"

# ch/harems_full/criminal/events.rpy:929
translate russian criminal_harem_event_04_5d9c6d62:
    "Затея была рискованная, но всё же сработала."

# ch/harems_full/criminal/events.rpy:930
translate russian criminal_harem_event_04_fcc7dffd:
    "Они оставили прежнюю тему и заговорили о другом."

# ch/harems_full/criminal/events.rpy:931
translate russian criminal_harem_event_04_361ceb0f:
    "Надеюсь, на сегодня со ссорами покончено."

# ch/harems_full/criminal/events.rpy:936
translate russian criminal_harem_event_04_dfc2bc94:
    "Наконец все изучают меню так, словно от этого зависит жизнь."

# ch/harems_full/criminal/events.rpy:937
translate russian criminal_harem_event_04_1a3411d3:
    "Давно пора: у меня уже почти слышно, как урчит живот!"

# ch/harems_full/criminal/events.rpy:940
translate russian criminal_harem_event_04_c9b74543:
    "Вдруг Лекси отрывается от меню."

# ch/harems_full/criminal/events.rpy:941
translate russian criminal_harem_event_04_32f28af3:
    "На лице у неё серьёзная обеспокоенность."

# ch/harems_full/criminal/events.rpy:942
translate russian criminal_harem_event_04_a82dedf8:
    lexi.say "Эй, ребята..."

# ch/harems_full/criminal/events.rpy:944
translate russian criminal_harem_event_04_2c801ae4:
    lexi.say "Мне тут важная мысль пришла!"

# ch/harems_full/criminal/events.rpy:945
translate russian criminal_harem_event_04_fb77d962:
    lexi.say "Кто за всё это платит?"

# ch/harems_full/criminal/events.rpy:946
translate russian criminal_harem_event_04_c7aff8cb:
    "Камила косится на неё."

# ch/harems_full/criminal/events.rpy:948
translate russian criminal_harem_event_04_7023c510:
    "Она явно озадачена."

# ch/harems_full/criminal/events.rpy:949
translate russian criminal_harem_event_04_f355fdf9:
    camila.say "А?"

# ch/harems_full/criminal/events.rpy:950
translate russian criminal_harem_event_04_b64cad84:
    camila.say "Я думала, мы разделим счёт!"

# ch/harems_full/criminal/events.rpy:951
translate russian criminal_harem_event_04_54e70a5b:
    lexi.say "Тебе легко говорить..."

# ch/harems_full/criminal/events.rpy:952
translate russian criminal_harem_event_04_c8ed9741:
    lexi.say "С твоей жирной полицейской зарплатой!"

# ch/harems_full/criminal/events.rpy:953
translate russian criminal_harem_event_04_eb268365:
    lexi.say "Не у всех столько денег."

# ch/harems_full/criminal/events.rpy:954
translate russian criminal_harem_event_04_432e4a88:
    camila.say "В чём проблема, Лекси?"

# ch/harems_full/criminal/events.rpy:956
translate russian criminal_harem_event_04_9f7d22d0:
    camila.say "Мало кошельков стащила в этом месяце?"

# ch/harems_full/criminal/events.rpy:959
translate russian criminal_harem_event_04_a2f2bb39:
    "Похоже, придётся вмешаться во второй раз."

# ch/harems_full/criminal/events.rpy:962
translate russian criminal_harem_event_04_a71ed34a:
    mike.say "Тебе это не понравится, Камила..."

# ch/harems_full/criminal/events.rpy:963
translate russian criminal_harem_event_04_839c14ef:
    mike.say "Но Лекси в чём-то права."

# ch/harems_full/criminal/events.rpy:964
translate russian criminal_harem_event_04_5ddf8104:
    mike.say "Из нас всех ты, наверное, зарабатываешь больше!"

# ch/harems_full/criminal/events.rpy:967
translate russian criminal_harem_event_04_84fbaca0:
    "Камила бросает на меня взгляд, от которого молоко могло бы скиснуть."

# ch/harems_full/criminal/events.rpy:968
translate russian criminal_harem_event_04_6a5bba1a:
    camila.say "И что с того?"

# ch/harems_full/criminal/events.rpy:969
translate russian criminal_harem_event_04_c08f385b:
    camila.say "Моя работа в сто раз опаснее твоей!"

# ch/harems_full/criminal/events.rpy:970
translate russian criminal_harem_event_04_80abbdd3:
    camila.say "А у Лекси с каких пор вообще есть настоящая работа?"

# ch/harems_full/criminal/events.rpy:972
translate russian criminal_harem_event_04_68ceca6d:
    lexi.say "«Настоящая» — слишком узкое понятие!"

# ch/harems_full/criminal/events.rpy:973
translate russian criminal_harem_event_04_f1c45abb:
    lexi.say "Я предпочитаю считать себя разносторонней..."

# ch/harems_full/criminal/events.rpy:974
translate russian criminal_harem_event_04_1ced2276:
    mike.say "Да, Камила..."

# ch/harems_full/criminal/events.rpy:975
translate russian criminal_harem_event_04_d35d937d:
    mike.say "Я всё понимаю."

# ch/harems_full/criminal/events.rpy:976
translate russian criminal_harem_event_04_af1c522f:
    mike.say "Но разве тебе платит не государство?"

# ch/harems_full/criminal/events.rpy:977
translate russian criminal_harem_event_04_d5cbf02d:
    mike.say "А эти деньги разве не берутся из моих налогов?"

# ch/harems_full/criminal/events.rpy:978
translate russian criminal_harem_event_04_63849676:
    "На мгновение мне кажется, что Камила сейчас влепит мне пощёчину."

# ch/harems_full/criminal/events.rpy:979
translate russian criminal_harem_event_04_c78dfc47:
    "Но она, похоже, сдерживает ярость."

# ch/harems_full/criminal/events.rpy:981
translate russian criminal_harem_event_04_2c0db7bb:
    camila.say "Мы разделим счёт, ясно?"

# ch/harems_full/criminal/events.rpy:982
translate russian criminal_harem_event_04_21d4a12f:
    camila.say "И на этом всё!"

# ch/harems_full/criminal/events.rpy:986
translate russian criminal_harem_event_04_7a36a8f4:
    mike.say "Тебе это не понравится, Лекси..."

# ch/harems_full/criminal/events.rpy:987
translate russian criminal_harem_event_04_fb34e456:
    mike.say "Но Камила в чём-то права."

# ch/harems_full/criminal/events.rpy:988
translate russian criminal_harem_event_04_10641416:
    mike.say "Ты вечно хвастаешься, сколько приносят твои махинации."

# ch/harems_full/criminal/events.rpy:989
translate russian criminal_harem_event_04_9d6e0df6:
    mike.say "Но как поделиться, денег у тебя никогда нет!"

# ch/harems_full/criminal/events.rpy:990
translate russian criminal_harem_event_04_33ecc5c3:
    "Говоря это, я стараюсь улыбаться."

# ch/harems_full/criminal/events.rpy:993
translate russian criminal_harem_event_04_17760b77:
    "Но вижу, что Лекси прожигает меня взглядом."

# ch/harems_full/criminal/events.rpy:994
translate russian criminal_harem_event_04_2b64f94c:
    lexi.say "Не твоё дело, [lssb_common.hero_name()]."

# ch/harems_full/criminal/events.rpy:995
translate russian criminal_harem_event_04_83287ed3:
    lexi.say "И даже если я зарабатываю кучу денег..."

# ch/harems_full/criminal/events.rpy:996
translate russian criminal_harem_event_04_f73fbb9b:
    lexi.say "Разве тогда вы не будете пользоваться преступными доходами?"

# ch/harems_full/criminal/events.rpy:998
translate russian criminal_harem_event_04_805a8d98:
    camila.say "Ага..."

# ch/harems_full/criminal/events.rpy:999
translate russian criminal_harem_event_04_0012e6ff:
    camila.say "А ведь тут она права!"

# ch/harems_full/criminal/events.rpy:1000
translate russian criminal_harem_event_04_d5968e2a:
    mike.say "Но, с другой стороны, Лекси..."

# ch/harems_full/criminal/events.rpy:1001
translate russian criminal_harem_event_04_9200efb6:
    mike.say "Мы могли бы уже сообщить о тебе властям."

# ch/harems_full/criminal/events.rpy:1002
translate russian criminal_harem_event_04_7df6fad7:
    mike.say "Так что за наше молчание ты нам вроде как должна!"

# ch/harems_full/criminal/events.rpy:1003
translate russian criminal_harem_event_04_778b6cfd:
    "На мгновение мне кажется, что Лекси сейчас влепит мне пощёчину."

# ch/harems_full/criminal/events.rpy:1004
translate russian criminal_harem_event_04_c78dfc47_1:
    "Но она, похоже, сдерживает ярость."

# ch/harems_full/criminal/events.rpy:1006
translate russian criminal_harem_event_04_02324958:
    lexi.say "Мы разделим счёт, ясно?"

# ch/harems_full/criminal/events.rpy:1007
translate russian criminal_harem_event_04_80b7445c:
    lexi.say "И на этом всё!"

# ch/harems_full/criminal/events.rpy:1012
translate russian criminal_harem_event_04_75271f7b:
    mike.say "Это я предложил сюда прийти."

# ch/harems_full/criminal/events.rpy:1013
translate russian criminal_harem_event_04_eae25ebe:
    mike.say "Так что на этот раз могу заплатить."

# ch/harems_full/criminal/events.rpy:1014
translate russian criminal_harem_event_04_a8ae9633:
    mike.say "Будете моими гостями, а?"

# ch/harems_full/criminal/events.rpy:1015
translate russian criminal_harem_event_04_d7b046b0:
    "Ожидаю, что Камила и Лекси сразу меня поблагодарят."

# ch/harems_full/criminal/events.rpy:1016
translate russian criminal_harem_event_04_b92b4e53:
    "Но обе вместо этого сердито смотрят на меня."

# ch/harems_full/criminal/events.rpy:1019
translate russian criminal_harem_event_04_ed341a55:
    camila.say "Думаешь, я не могу за себя заплатить?"

# ch/harems_full/criminal/events.rpy:1020
translate russian criminal_harem_event_04_0c91b551:
    camila.say "Что мне нужна твоя помощь?"

# ch/harems_full/criminal/events.rpy:1021
translate russian criminal_harem_event_04_6f8be6e2:
    lexi.say "Должна сказать, [lssb_common.hero_name()]..."

# ch/harems_full/criminal/events.rpy:1022
translate russian criminal_harem_event_04_e15d966e:
    lexi.say "Сексизмом попахивает!"

# ch/harems_full/criminal/events.rpy:1023
translate russian criminal_harem_event_04_eaca306b:
    mike.say "О чём вы вообще?"

# ch/harems_full/criminal/events.rpy:1024
translate russian criminal_harem_event_04_63207ed5:
    mike.say "Я просто хотел быть джентльменом!"

# ch/harems_full/criminal/events.rpy:1025
translate russian criminal_harem_event_04_f1babb8b:
    lexi.say "Ты что, в прошлом веке живёшь?"

# ch/harems_full/criminal/events.rpy:1026
translate russian criminal_harem_event_04_4917c2ef:
    lexi.say "Ещё пальто над лужами расстилать начни!"

# ch/harems_full/criminal/events.rpy:1027
translate russian criminal_harem_event_04_89bdebce:
    camila.say "Оставь своё патриархальное угнетение при себе, [lssb_common.hero_name()]."

# ch/harems_full/criminal/events.rpy:1029
translate russian criminal_harem_event_04_2bbe200b:
    mike.say "Да разделим мы этот чёртов счёт!"

# ch/harems_full/criminal/events.rpy:1033
translate russian criminal_harem_event_04_a11a48c9:
    mike.say "Извините, девочки..."

# ch/harems_full/criminal/events.rpy:1034
translate russian criminal_harem_event_04_2d69cdc0:
    mike.say "Я просто думал, что мы поделим счёт на троих!"

# ch/harems_full/criminal/events.rpy:1035
translate russian criminal_harem_event_04_c5faacbf:
    "Надеялся, этого хватит, чтобы закрыть вопрос."

# ch/harems_full/criminal/events.rpy:1036
translate russian criminal_harem_event_04_11a9dc51:
    "Но Камила и Лекси явно мной недовольны."

# ch/harems_full/criminal/events.rpy:1039
translate russian criminal_harem_event_04_28c22296:
    camila.say "О нет, я уже ходила ужинать с коллегами из участка."

# ch/harems_full/criminal/events.rpy:1040
translate russian criminal_harem_event_04_00297de0:
    camila.say "Знаю, как это бывает!"

# ch/harems_full/criminal/events.rpy:1041
translate russian criminal_harem_event_04_1e21d529:
    lexi.say "Всегда найдётся тот, кто предлагает поделить счёт."

# ch/harems_full/criminal/events.rpy:1042
translate russian criminal_harem_event_04_003b09c8:
    lexi.say "А потом заказывает самую дорогущую хрень!"

# ch/harems_full/criminal/events.rpy:1043
translate russian criminal_harem_event_04_dc1a23df:
    lexi.say "Пока ты стараешься экономить!"

# ch/harems_full/criminal/events.rpy:1045
translate russian criminal_harem_event_04_48a35e01:
    "Камила удивлённо смотрит на Лекси."

# ch/harems_full/criminal/events.rpy:1046
translate russian criminal_harem_event_04_687f998f:
    camila.say "Э-э..."

# ch/harems_full/criminal/events.rpy:1047
translate russian criminal_harem_event_04_7340a3da:
    camila.say "Я собиралась сказать почти слово в слово то же самое."

# ch/harems_full/criminal/events.rpy:1049
translate russian criminal_harem_event_04_39d6619b:
    lexi.say "Странно!"

# ch/harems_full/criminal/events.rpy:1050
translate russian criminal_harem_event_04_e423ad87:
    lexi.say "Может, копы и жулики всё-таки не так уж отличаются?"

# ch/harems_full/criminal/events.rpy:1051
translate russian criminal_harem_event_04_69d1f742:
    mike.say "Послушайте..."

# ch/harems_full/criminal/events.rpy:1052
translate russian criminal_harem_event_04_6030287c:
    mike.say "У меня для этого есть приложение."

# ch/harems_full/criminal/events.rpy:1053
translate russian criminal_harem_event_04_40d51c7d:
    mike.say "Каждый вводит свой заказ и его стоимость."

# ch/harems_full/criminal/events.rpy:1054
translate russian criminal_harem_event_04_4832065d:
    mike.say "А в конце ужина оно показывает, сколько именно кто должен."

# ch/harems_full/criminal/events.rpy:1056
translate russian criminal_harem_event_04_b6b7d1f7:
    camila.say "Хм..."

# ch/harems_full/criminal/events.rpy:1057
translate russian criminal_harem_event_04_78fc0799:
    camila.say "Меня устраивает."

# ch/harems_full/criminal/events.rpy:1059
translate russian criminal_harem_event_04_84edfd59:
    lexi.say "Меня тоже."

# ch/harems_full/criminal/events.rpy:1060
translate russian criminal_harem_event_04_13e035a6:
    mike.say "Отлично, девочки..."

# ch/harems_full/criminal/events.rpy:1061
translate russian criminal_harem_event_04_d04548f4:
    mike.say "Значит, договорились!"

# ch/harems_full/criminal/events.rpy:1065
translate russian criminal_harem_event_04_1823ebfb_1:
    lexi.say "Господи..."

# ch/harems_full/criminal/events.rpy:1067
translate russian criminal_harem_event_04_ea0ff235:
    lexi.say "Тут в меню какая-то совсем странная хрень!"

# ch/harems_full/criminal/events.rpy:1068
translate russian criminal_harem_event_04_14716b5e:
    "Поднимаю взгляд и вижу, как Лекси качает головой."

# ch/harems_full/criminal/events.rpy:1069
translate russian criminal_harem_event_04_15665849:
    mike.say "О чём ты, Лекси?"

# ch/harems_full/criminal/events.rpy:1070
translate russian criminal_harem_event_04_11b38cb6:
    mike.say "Я ничего необычного не вижу."

# ch/harems_full/criminal/events.rpy:1071
translate russian criminal_harem_event_04_ef2f44b5:
    "Тут с другой стороны стола подаёт голос Камила."

# ch/harems_full/criminal/events.rpy:1072
translate russian criminal_harem_event_04_4ebb1e02:
    camila.say "Она права, [lssb_common.hero_name()]."

# ch/harems_full/criminal/events.rpy:1074
translate russian criminal_harem_event_04_73cb54e5:
    camila.say "Сам посмотри..."

# ch/harems_full/criminal/events.rpy:1075
translate russian criminal_harem_event_04_64acebc7:
    "Камила тычет пальцем в меню."

# ch/harems_full/criminal/events.rpy:1076
translate russian criminal_harem_event_04_283b115f:
    camila.say "У них в меню какой-то гравий!"

# ch/harems_full/criminal/events.rpy:1078
translate russian criminal_harem_event_04_6bb8fe83:
    "Я смотрю, куда она показывает."

# ch/harems_full/criminal/events.rpy:1079
translate russian criminal_harem_event_04_13bfc3cb:
    "И с трудом сдерживаю смех."

# ch/harems_full/criminal/events.rpy:1080
translate russian criminal_harem_event_04_856c902d:
    "С этим Камила сильно промахнулась."

# ch/harems_full/criminal/events.rpy:1081
translate russian criminal_harem_event_04_01cbf6dc:
    lexi.say "Ага!"

# ch/harems_full/criminal/events.rpy:1083
translate russian criminal_harem_event_04_da281777:
    lexi.say "Вижу, о чём ты."

# ch/harems_full/criminal/events.rpy:1084
translate russian criminal_harem_event_04_0b27b148:
    "О нет, теперь и Лекси туда же!"

# ch/harems_full/criminal/events.rpy:1087
translate russian criminal_harem_event_04_e4fd5249:
    "Я качаю головой и усмехаюсь."

# ch/harems_full/criminal/events.rpy:1088
translate russian criminal_harem_event_04_ce37bd6e:
    mike.say "Не гравий, Камила..."

# ch/harems_full/criminal/events.rpy:1089
translate russian criminal_harem_event_04_c3b074f8:
    mike.say "Гравлакс!"

# ch/harems_full/criminal/events.rpy:1090
translate russian criminal_harem_event_04_4bb485ce:
    "От моего смеха Камила хмурится."

# ch/harems_full/criminal/events.rpy:1092
translate russian criminal_harem_event_04_59dafb18:
