    camila.say "До того, как мы сошлись, я бы ни за что не согласилась."

# ch/harems_full/criminal/events.rpy:2672
translate russian camila_lexi_propose_male_ecba780f:
    camila.say "Сказала бы, что уже замужем за работой в полиции."

# ch/harems_full/criminal/events.rpy:2674
translate russian camila_lexi_propose_male_fd068a0b:
    camila.say "Но не знаю... Сейчас всё кажется правильным."

# ch/harems_full/criminal/events.rpy:2675
translate russian camila_lexi_propose_male_a8f440a0:
    lexi.say "Поверь, я никогда не думала, что выйду замуж."

# ch/harems_full/criminal/events.rpy:2676
translate russian camila_lexi_propose_male_c31ec1dd:
    lexi.say "Но и встречаться с полицейской я тоже не планировала."

# ch/harems_full/criminal/events.rpy:2678
translate russian camila_lexi_propose_male_90d31fc0:
    lexi.say "Так что я согласна!"

# ch/harems_full/criminal/events.rpy:2681
translate russian camila_lexi_propose_male_21643db8:
    "Они протягивают мне руки."

# ch/harems_full/criminal/events.rpy:2682
translate russian camila_lexi_propose_male_94443b0d:
    "И я спешу надеть кольца им на пальцы."

# ch/harems_full/criminal/events.rpy:2686
translate russian camila_lexi_propose_male_fe9c4cba:
    mike.say "Я сейчас так нервничал."

# ch/harems_full/criminal/events.rpy:2687
translate russian camila_lexi_propose_male_66d2d628:
    mike.say "Был уверен, что вы откажете!"

# ch/harems_full/criminal/events.rpy:2689
translate russian camila_lexi_propose_male_01d7baae:
    camila.say "Эй, если я за что-то берусь, то всерьёз!"

# ch/harems_full/criminal/events.rpy:2691
translate russian camila_lexi_propose_male_e7115bc1:
    lexi.say "Ага, я того же мнения!"

# ch/harems_full/criminal/events.rpy:2695
translate russian camila_lexi_propose_male_21deca3a:
    "Камила и Лекси словно внезапно возвращаются к реальности."

# ch/harems_full/criminal/events.rpy:2696
translate russian camila_lexi_propose_male_0dfc370f:
    "Будто только сейчас осознают, что я действительно сделал им предложение."

# ch/harems_full/criminal/events.rpy:2697
translate russian camila_lexi_propose_male_8f4bcd4a:
    "Теперь они хмурятся и качают головами."

# ch/harems_full/criminal/events.rpy:2699
translate russian camila_lexi_propose_male_5d879403:
    camila.say "Ты с ума сошёл, [lssb_common.hero_name()]?"

# ch/harems_full/criminal/events.rpy:2700
translate russian camila_lexi_propose_male_6a938778:
    camila.say "Выйти за тебя — возможно."

# ch/harems_full/criminal/events.rpy:2702
translate russian camila_lexi_propose_male_db2bfba2:
    camila.say "За известную преступницу — ни за что!"

# ch/harems_full/criminal/events.rpy:2706
translate russian camila_lexi_propose_male_21758ac3:
    lexi.say "Кого ты назвала преступницей?"

# ch/harems_full/criminal/events.rpy:2708
translate russian camila_lexi_propose_male_8f03890a:
    camila.say "Ой, да брось, Лекси."

# ch/harems_full/criminal/events.rpy:2709
translate russian camila_lexi_propose_male_f7eb2075:
    camila.say "На тебя целое досье накопилось!"

# ch/harems_full/criminal/events.rpy:2710
translate russian camila_lexi_propose_male_18f5a588:
    "Я поспешно встаю, пряча кольца в карман."

# ch/harems_full/criminal/events.rpy:2711
translate russian camila_lexi_propose_male_abb2112a:
    "И всё это время пытаюсь их помирить."

# ch/harems_full/criminal/events.rpy:2712
translate russian camila_lexi_propose_male_11eee510:
    mike.say "Да ладно вам, девчонки!"

# ch/harems_full/criminal/events.rpy:2713
translate russian camila_lexi_propose_male_ac4b2b19:
    mike.say "Ну зачем ссориться?"

# ch/harems_full/criminal/events.rpy:2714
translate russian camila_lexi_propose_male_26529da6:
    mike.say "Может, будем просто ладить, как обычно?"

# ch/harems_full/criminal/events.rpy:2715
translate russian camila_lexi_propose_male_8287e212:
    "В разгоревшемся споре предложение руки и сердца быстро забывается."

# ch/harems_full/criminal/events.rpy:2716
translate russian camila_lexi_propose_male_ccda793c:
    "Для меня это даже облегчение: похоже, именно оно и стало причиной ссоры."

# ch/harems_full/criminal/events.rpy:2722
translate russian camila_lexi_propose_male_c1c31aab_1:
    "Камила и Лекси долго смотрят друг другу в глаза."

# ch/harems_full/criminal/events.rpy:2723
translate russian camila_lexi_propose_male_dc201e3c_1:
    "И всё это время я жду, что обе откажут."

# ch/harems_full/criminal/events.rpy:2724
translate russian camila_lexi_propose_male_87f0c817_1:
    camila.say "Знаешь..."

# ch/harems_full/criminal/events.rpy:2725
translate russian camila_lexi_propose_male_2d7c1bd1_1:
    camila.say "До того, как мы сошлись, я бы ни за что не согласилась."

# ch/harems_full/criminal/events.rpy:2726
translate russian camila_lexi_propose_male_ecba780f_1:
    camila.say "Сказала бы, что уже замужем за работой в полиции."

# ch/harems_full/criminal/events.rpy:2728
translate russian camila_lexi_propose_male_fd068a0b_1:
    camila.say "Но не знаю... Сейчас всё кажется правильным."

# ch/harems_full/criminal/events.rpy:2729
translate russian camila_lexi_propose_male_22757f12:
    camila.say "Даже если у одной из нас сомнительное прошлое!"

# ch/harems_full/criminal/events.rpy:2732
translate russian camila_lexi_propose_male_21758ac3_1:
    lexi.say "Кого ты назвала преступницей?"

# ch/harems_full/criminal/events.rpy:2733
translate russian camila_lexi_propose_male_8f03890a_1:
    camila.say "Ой, да брось, Лекси."

# ch/harems_full/criminal/events.rpy:2735
translate russian camila_lexi_propose_male_f7eb2075_1:
    camila.say "На тебя целое досье накопилось!"

# ch/harems_full/criminal/events.rpy:2736
translate russian camila_lexi_propose_male_18f5a588_1:
    "Я поспешно встаю, пряча кольца в карман."

# ch/harems_full/criminal/events.rpy:2737
translate russian camila_lexi_propose_male_abb2112a_1:
    "И всё это время пытаюсь их помирить."

# ch/harems_full/criminal/events.rpy:2738
translate russian camila_lexi_propose_male_11eee510_1:
    mike.say "Да ладно вам, девчонки!"

# ch/harems_full/criminal/events.rpy:2739
translate russian camila_lexi_propose_male_ac4b2b19_1:
    mike.say "Ну зачем ссориться?"

# ch/harems_full/criminal/events.rpy:2740
translate russian camila_lexi_propose_male_26529da6_1:
    mike.say "Может, будем просто ладить, как обычно?"

# ch/harems_full/criminal/events.rpy:2741
translate russian camila_lexi_propose_male_d2d0f66c:
    lexi.say "Я не собираюсь любезничать с той, кто так со мной разговаривает!"

# ch/harems_full/criminal/events.rpy:2742
translate russian camila_lexi_propose_male_6320a032:
    "Лекси поворачивается к нам с Камилой спиной и сердито уходит."

# ch/harems_full/criminal/events.rpy:2746
translate russian camila_lexi_propose_male_cb15a0cb:
    "Прежде чем я успеваю пойти за ней, Камила надевает одно из колец."

# ch/harems_full/criminal/events.rpy:2747
translate russian camila_lexi_propose_male_ea200279:
    "Я рад, но по-прежнему не понимаю, что теперь будет."

# ch/harems_full/criminal/events.rpy:2752
translate russian camila_lexi_propose_male_a8f440a0_1:
    lexi.say "Поверь, я никогда не думала, что выйду замуж."

# ch/harems_full/criminal/events.rpy:2753
translate russian camila_lexi_propose_male_c31ec1dd_1:
    lexi.say "Но и встречаться с полицейской я тоже не планировала."

# ch/harems_full/criminal/events.rpy:2755
translate russian camila_lexi_propose_male_90d31fc0_1:
    lexi.say "Так что я согласна!"

# ch/harems_full/criminal/events.rpy:2756
translate russian camila_lexi_propose_male_5d879403_1:
    camila.say "Ты с ума сошёл, [lssb_common.hero_name()]?"

# ch/harems_full/criminal/events.rpy:2757
translate russian camila_lexi_propose_male_6a938778_1:
    camila.say "Выйти за тебя — возможно."

# ch/harems_full/criminal/events.rpy:2759
translate russian camila_lexi_propose_male_db2bfba2_1:
    camila.say "За известную преступницу — ни за что!"

# ch/harems_full/criminal/events.rpy:2762
translate russian camila_lexi_propose_male_21758ac3_2:
    lexi.say "Кого ты назвала преступницей?"

# ch/harems_full/criminal/events.rpy:2764
translate russian camila_lexi_propose_male_8f03890a_2:
    camila.say "Ой, да брось, Лекси."

# ch/harems_full/criminal/events.rpy:2765
translate russian camila_lexi_propose_male_f7eb2075_2:
    camila.say "На тебя целое досье накопилось!"

# ch/harems_full/criminal/events.rpy:2766
translate russian camila_lexi_propose_male_18f5a588_2:
    "Я поспешно встаю, пряча кольца в карман."

# ch/harems_full/criminal/events.rpy:2767
translate russian camila_lexi_propose_male_abb2112a_2:
    "И всё это время пытаюсь их помирить."

# ch/harems_full/criminal/events.rpy:2768
translate russian camila_lexi_propose_male_11eee510_2:
    mike.say "Да ладно вам, девчонки!"

# ch/harems_full/criminal/events.rpy:2769
translate russian camila_lexi_propose_male_ac4b2b19_2:
    mike.say "Ну зачем ссориться?"

# ch/harems_full/criminal/events.rpy:2770
translate russian camila_lexi_propose_male_26529da6_2:
    mike.say "Может, будем просто ладить, как обычно?"

# ch/harems_full/criminal/events.rpy:2772
translate russian camila_lexi_propose_male_0d0a9422:
    camila.say "Забудь!"

# ch/harems_full/criminal/events.rpy:2774
translate russian camila_lexi_propose_male_b6a6cd00:
    camila.say "Я не выйду за эту уголовницу-шлюху!"

# ch/harems_full/criminal/events.rpy:2775
translate russian camila_lexi_propose_male_0d0837c4:
    "Камила поворачивается к нам с Лекси спиной и сердито уходит."

# ch/harems_full/criminal/events.rpy:2779
translate russian camila_lexi_propose_male_841687b1:
    "Прежде чем я успеваю пойти за ней, Лекси надевает одно из колец."

# ch/harems_full/criminal/events.rpy:2780
translate russian camila_lexi_propose_male_ea200279_1:
    "Я рад, но по-прежнему не понимаю, что теперь будет."

# ch/harems_full/criminal/events.rpy:2793
translate russian camila_lexi_male_ending_9e4843c5:
    "Я всегда знал, что встречаться с такими разными девушками, как Камила и Лекси, будет непросто."

# ch/harems_full/criminal/events.rpy:2794
translate russian camila_lexi_male_ending_e2322979:
    "Но они как противоположные вкусы, которые каким-то образом прекрасно сочетаются."

# ch/harems_full/criminal/events.rpy:2795
translate russian camila_lexi_male_ending_19d2e285:
    "С одной стороны — суровая, несгибаемая полицейская."

# ch/harems_full/criminal/events.rpy:2796
translate russian camila_lexi_male_ending_5c9fdad2:
    "С другой — дерзкая плохая девчонка, знающая законы улиц."

# ch/harems_full/criminal/events.rpy:2797
translate russian camila_lexi_male_ending_a7fbcf3a:
    "Когда всё складывается удачно, Камила ровно настолько приструнивает Лекси, чтобы всем было весело."

# ch/harems_full/criminal/events.rpy:2798
translate russian camila_lexi_male_ending_75d6fd27:
    "А Лекси находит к Камиле подход и помогает ей расслабиться."

# ch/harems_full/criminal/events.rpy:2799
translate russian camila_lexi_male_ending_abb0451d:
    "Но вот я предложил им обеим выйти за меня — и они согласились!"

# ch/harems_full/criminal/events.rpy:2800
translate russian camila_lexi_male_ending_c8d79e97:
    "И теперь стою у алтаря в костюме и жду их появления."

# ch/harems_full/criminal/events.rpy:2801
translate russian camila_lexi_male_ending_c6f713a1:
    "И не могу удержаться, чтобы время от времени не оглядываться на гостей."

# ch/harems_full/criminal/events.rpy:2802
translate russian camila_lexi_male_ending_3adaa5ac:
    "Конечно, здесь все мои друзья и родные."

# ch/harems_full/criminal/events.rpy:2803
translate russian camila_lexi_male_ending_decaf605:
    "Но в пот меня бросает оттого, насколько разные гости пришли к Камиле и Лекси."

# ch/harems_full/criminal/events.rpy:2804
translate russian camila_lexi_male_ending_9cfeb3fb:
    "Серьёзно: с одной стороны часовни сидят суровые полицейские."

# ch/harems_full/criminal/events.rpy:2805
translate russian camila_lexi_male_ending_3fd558fe:
    "Все словно только что с патрулирования и вполне могут быть при оружии."

# ch/harems_full/criminal/events.rpy:2806
translate russian camila_lexi_male_ending_8541afa6:
    "А с другой — люди, ради которых я бы перешёл на противоположную сторону улицы."

# ch/harems_full/criminal/events.rpy:2807
translate russian camila_lexi_male_ending_3a4883b1:
    "Любой из гостей Лекси отлично смотрелся бы среди подозреваемых на опознании!"

# ch/harems_full/criminal/events.rpy:2808
translate russian camila_lexi_male_ending_e108c675:
    "Хуже того, обе стороны тоже это заметили."

# ch/harems_full/criminal/events.rpy:2809
translate russian camila_lexi_male_ending_04490ad7:
    "Копы и жулики разглядывают друг друга через проход."

# ch/harems_full/criminal/events.rpy:2810
translate russian camila_lexi_male_ending_ea1b3f35:
    "А я боюсь, что за моей спиной вот-вот начнётся перестрелка!"

# ch/harems_full/criminal/events.rpy:2811
translate russian camila_lexi_male_ending_19821a9a:
    "К счастью, через несколько секунд часовню наполняет музыка."

# ch/harems_full/criminal/events.rpy:2812
translate russian camila_lexi_male_ending_62685188:
    "Этого, похоже, хватает, чтобы всех отвлечь."

# ch/harems_full/criminal/events.rpy:2813
translate russian camila_lexi_male_ending_686f6f22:
    "И я мысленно благодарю своих невест за то, что они пришли на помощь именно сейчас."

# ch/harems_full/criminal/events.rpy:2814
translate russian camila_lexi_male_ending_11f61c9b:
    "Я почти не слышу музыку, под которую они идут к алтарю."

# ch/harems_full/criminal/events.rpy:2815
translate russian camila_lexi_male_ending_7241002b:
    "Потому что не могу оторвать восхищённого взгляда от будущих жён."

# ch/harems_full/criminal/events.rpy:2817
translate russian camila_lexi_male_ending_1a16d195:
    "Обычно Камила выглядит суровой и непреклонной."

# ch/harems_full/criminal/events.rpy:2818
translate russian camila_lexi_male_ending_cf0d51f7:
    "Но это платье словно раскрывает её истинную красоту."

# ch/harems_full/criminal/events.rpy:2819
translate russian camila_lexi_male_ending_d17a506b:
    "Кажется, я ещё никогда не видел её такой прекрасной."

# ch/harems_full/criminal/events.rpy:2821
translate russian camila_lexi_male_ending_45136346:
    "Она буквально сияет."

# ch/harems_full/criminal/events.rpy:2822
translate russian camila_lexi_male_ending_572c2eb7:
    "И с гордостью придерживает округлившийся живот."

# ch/harems_full/criminal/events.rpy:2823
translate russian camila_lexi_male_ending_45e481f5:
    "Словно предлагает любому недовольному высказать свои претензии."

# ch/harems_full/criminal/events.rpy:2825
translate russian camila_lexi_male_ending_3867abd1:
    "Лекси в своём платье просто загляденье, но при этом всё так же дерзка."

# ch/harems_full/criminal/events.rpy:2826
translate russian camila_lexi_male_ending_1ee65bb8:
    "Она что... она... точно!"

# ch/harems_full/criminal/events.rpy:2827
translate russian camila_lexi_male_ending_baac21c6:
    "Она действительно идёт к алтарю, жуёт жвачку и надувает пузыри!"

# ch/harems_full/criminal/events.rpy:2829
translate russian camila_lexi_male_ending_10f16bd9:
    "И свою беременность, похоже, тоже не собирается скрывать."

# ch/harems_full/criminal/events.rpy:2830
translate russian camila_lexi_male_ending_4aa2e017:
    "Платье скорее подчёркивает её, чем прячет."

# ch/harems_full/criminal/events.rpy:2831
translate russian camila_lexi_male_ending_ec54204d:
    "И каким-то образом это ей удивительно идёт!"

# ch/harems_full/criminal/events.rpy:2832
translate russian camila_lexi_male_ending_bd85019b:
    "Когда Камила и Лекси подходят к алтарю, я поворачиваюсь к ним."

# ch/harems_full/criminal/events.rpy:2833
translate russian camila_lexi_male_ending_3bc55b23:
    "Я уже собираюсь пошутить, но меня прерывают."

# ch/harems_full/criminal/events.rpy:2835
translate russian camila_lexi_male_ending_73e457fe:
    "Священник" "Начнём?"

# ch/harems_full/criminal/events.rpy:2836
translate russian camila_lexi_male_ending_53da0a87:
    "Этого хватает, чтобы все трое замолчали."

# ch/harems_full/criminal/events.rpy:2839
translate russian camila_lexi_male_ending_523ef36f:
    "Мы с Камилой и Лекси киваем и занимаем свои места."

# ch/harems_full/criminal/events.rpy:2840
translate russian camila_lexi_male_ending_fd59af5f:
    "И церемония начинается."

# ch/harems_full/criminal/events.rpy:2841
translate russian camila_lexi_male_ending_eef8efc1:
    "Большая её часть проходит для меня как в тумане: слова, кивающие головы."

# ch/harems_full/criminal/events.rpy:2842
translate russian camila_lexi_male_ending_3e43eddc:
    "Всё становится реальным лишь тогда, когда приходит время обменяться клятвами."

# ch/harems_full/criminal/events.rpy:2843
translate russian camila_lexi_male_ending_8834fa51:
    "Священник" "Камила, согласна ли ты..."

# ch/harems_full/criminal/events.rpy:2844
translate russian camila_lexi_male_ending_54ecd1b6:
    "Священник" "Вступить с этими двумя людьми..."

# ch/harems_full/criminal/events.rpy:2845
translate russian camila_lexi_male_ending_8c7361cd:
    "Священник" "В законный брак?"

# ch/harems_full/criminal/events.rpy:2847
translate russian camila_lexi_male_ending_6520c6d6:
    camila.say "Согласна."

# ch/harems_full/criminal/events.rpy:2848
translate russian camila_lexi_male_ending_a93b9cc4:
    "Священник" "А ты, Лекси, согласна ли..."

# ch/harems_full/criminal/events.rpy:2849
translate russian camila_lexi_male_ending_54ecd1b6_1:
    "Священник" "Вступить с этими двумя людьми..."

# ch/harems_full/criminal/events.rpy:2850
translate russian camila_lexi_male_ending_8c7361cd_1:
    "Священник" "В законный брак?"

# ch/harems_full/criminal/events.rpy:2852
translate russian camila_lexi_male_ending_65061d00:
    lexi.say "Ещё бы!"

# ch/harems_full/criminal/events.rpy:2853
translate russian camila_lexi_male_ending_29f4af29:
    "Священник поднимает бровь, услышав ответ Лекси."

# ch/harems_full/criminal/events.rpy:2854
translate russian camila_lexi_male_ending_a0875bbe:
    "Но затем словно отмахивается от этого и поворачивается ко мне."

# ch/harems_full/criminal/events.rpy:2855
translate russian camila_lexi_male_ending_2f91345e:
    "Священник" "И наконец, [lssb_common.hero_name()], согласен ли ты..."

# ch/harems_full/criminal/events.rpy:2856
translate russian camila_lexi_male_ending_54ecd1b6_2:
    "Священник" "Вступить с этими двумя людьми..."

# ch/harems_full/criminal/events.rpy:2857
translate russian camila_lexi_male_ending_8c7361cd_2:
    "Священник" "В законный брак?"

# ch/harems_full/criminal/events.rpy:2858
translate russian camila_lexi_male_ending_cc481164:
    mike.say "Согласен."

# ch/harems_full/criminal/events.rpy:2859
translate russian camila_lexi_male_ending_049064d9:
    "Священник кивает и поворачивается к собравшимся гостям."

# ch/harems_full/criminal/events.rpy:2860
translate russian camila_lexi_male_ending_58c83231:
    "Священник" "Обращаюсь ко всем присутствующим..."

# ch/harems_full/criminal/events.rpy:2861
translate russian camila_lexi_male_ending_e79ba4bf:
    "Священник" "Если кому-либо известна законная причина, по которой эти трое не могут вступить в брак..."

# ch/harems_full/criminal/events.rpy:2862
translate russian camila_lexi_male_ending_713d080b:
    "Священник" "Пусть скажет сейчас или навеки умолкнет!"

# ch/harems_full/criminal/events.rpy:2863
translate russian camila_lexi_male_ending_2a1cd9fe:
    "Обычно в этот момент все понимающе посмеиваются."

# ch/harems_full/criminal/events.rpy:2864
translate russian camila_lexi_male_ending_f3baabf4:
    "Но я всерьёз боюсь, что сейчас всё вспыхнет."

# ch/harems_full/criminal/events.rpy:2865
translate russian camila_lexi_male_ending_59ce84e5:
    "Уже представляю, как один из копов встаёт и зачитывает список преступлений Лекси."

# ch/harems_full/criminal/events.rpy:2866
translate russian camila_lexi_male_ending_a042c483:
    "Или кто-нибудь из жуликов объявляет, что Камила отправила его брата на электрический стул!"

# ch/harems_full/criminal/events.rpy:2867
translate russian camila_lexi_male_ending_31927f15:
    "А потом кто-то выхватит пистолет и откроет стрельбу!"

# ch/harems_full/criminal/events.rpy:2868
translate russian camila_lexi_male_ending_d00b3666:
    "Священник" "Что ж."

# ch/harems_full/criminal/events.rpy:2869
translate russian camila_lexi_male_ending_24b3a9e2:
    "Священник" "Объявляю вас супругами."

# ch/harems_full/criminal/events.rpy:2870
translate russian camila_lexi_male_ending_4bc65549:
    "Священник" "Можете поцеловать друг друга."

# ch/harems_full/criminal/events.rpy:2871
translate russian camila_lexi_male_ending_64942d0b:
    "И вот так просто мои страхи исчезают."

# ch/harems_full/criminal/events.rpy:2872
translate russian camila_lexi_male_ending_caee5ca7:
    "Ни возражений, ни выстрелов."

# ch/harems_full/criminal/events.rpy:2873
translate russian camila_lexi_male_ending_cb04ef17:
    "Только улыбающиеся мне Камила и Лекси."

# ch/harems_full/criminal/events.rpy:2876
translate russian camila_lexi_male_ending_d4868295:
    "Не дожидаясь, пока я сделаю первый шаг, они обнимают меня с двух сторон."

# ch/harems_full/criminal/events.rpy:2877
translate russian camila_lexi_male_ending_974fc568:
    "И наши поцелуи развеивают последние тревоги."

# ch/harems_full/criminal/events.rpy:2878
translate russian camila_lexi_male_ending_856ca69e:
    "У меня получилось!"

# ch/harems_full/criminal/events.rpy:2879
translate russian camila_lexi_male_ending_15261682:
    "Я женился на Камиле и Лекси!"

# ch/harems_full/criminal/events.rpy:2880
translate russian camila_lexi_male_ending_634f9852:
    "И сейчас я совершенно счастлив."

# ch/harems_full/criminal/events.rpy:2884
translate russian camila_lexi_male_ending_c5b428f8:
    camila.say "Так..."

# ch/harems_full/criminal/events.rpy:2885
translate russian camila_lexi_male_ending_0f2fbf2e:
    camila.say "Нам нужно всем рассказать, какой [lssb_common.hero_name()] замечательный муж?"

# ch/harems_full/criminal/events.rpy:2886
translate russian camila_lexi_male_ending_675bcdec:
    camila.say "Хм... Мы тут под присягой или как?"

# ch/harems_full/criminal/events.rpy:2887
translate russian camila_lexi_male_ending_cc9a6390:
    lexi.say "Да не будь такой серьёзной, Камила!"

# ch/harems_full/criminal/events.rpy:2888
translate russian camila_lexi_male_ending_43e7a5cf:
    lexi.say "Надо всего лишь поговорить о нашем мужчине."

# ch/harems_full/criminal/events.rpy:2889
translate russian camila_lexi_male_ending_c057e7c7:
    lexi.say "И чего тут стесняться, а?"

# ch/harems_full/criminal/events.rpy:2890
translate russian camila_lexi_male_ending_00a32224:
    camila.say "Ага... Наверное, ты права, Лекси."

# ch/harems_full/criminal/events.rpy:2891
translate russian camila_lexi_male_ending_a022be56:
    camila.say "Скажем так: [lssb_common.hero_name()] — отличный муж."

# ch/harems_full/criminal/events.rpy:2892
translate russian camila_lexi_male_ending_8406bff2:
    lexi.say "Ещё бы, Камила!"

# ch/harems_full/criminal/events.rpy:2893
translate russian camila_lexi_male_ending_1fe39c91:
    lexi.say "Я наконец смогла съехать из трейлерного парка."

# ch/harems_full/criminal/events.rpy:2894
translate russian camila_lexi_male_ending_4d8ff2a8:
    lexi.say "И он не заставляет меня продавать себя, как раньше Дэнни."

# ch/harems_full/criminal/events.rpy:2895
translate russian camila_lexi_male_ending_857e8d04:
    camila.say "Да, Лекси..."

# ch/harems_full/criminal/events.rpy:2896
translate russian camila_lexi_male_ending_26cd3e5e:
    camila.say "Потому что знает, что я с ним сделаю, если он хоть заикнётся!"

# ch/harems_full/criminal/events.rpy:2897
translate russian camila_lexi_male_ending_faefa8e6:
    lexi.say "Ой, спасибо, Камила!"

# ch/harems_full/criminal/events.rpy:2898
translate russian camila_lexi_male_ending_99207a9b:
    lexi.say "С тобой жить тоже здорово."

# ch/harems_full/criminal/events.rpy:2899
translate russian camila_lexi_male_ending_8095eec6:
    lexi.say "Даже если ты КОП..."

# ch/harems_full/criminal/events.rpy:2900
translate russian camila_lexi_male_ending_c903c6da:
    lexi.say "И признай: [lssb_common.hero_name()] отнёсся к этому спокойно."

# ch/harems_full/criminal/events.rpy:2901
translate russian camila_lexi_male_ending_e0260b54:
    lexi.say "Ну, не стал мешать тебе остаться в полиции."

# ch/harems_full/criminal/events.rpy:2902
translate russian camila_lexi_male_ending_a1d7e730:
    camila.say "Это было моё решение!"

# ch/harems_full/criminal/events.rpy:2903
translate russian camila_lexi_male_ending_6b2a67a2:
    camila.say "Но да, я рада, что он не донимал меня из-за этого."

# ch/harems_full/criminal/events.rpy:2904
translate russian camila_lexi_male_ending_1007c41c:
    camila.say "Бывших копов не бывает, Лекси."

# ch/harems_full/criminal/events.rpy:2905
translate russian camila_lexi_male_ending_65c5847c:
    camila.say "От этой работы так просто не уйдёшь!"

# ch/harems_full/criminal/events.rpy:2906
translate russian camila_lexi_male_ending_11671a2b:
    lexi.say "Ага..."

# ch/harems_full/criminal/events.rpy:2907
translate russian camila_lexi_male_ending_bd178c1f:
    lexi.say "Но теперь мы женаты, да?"

# ch/harems_full/criminal/events.rpy:2908
translate russian camila_lexi_male_ending_fcb6f7cb:
    lexi.say "Но я и [lssb_common.hero_name()] можем быть спокойны? Нас-то ты не сдашь?"

# ch/harems_full/criminal/events.rpy:2909
translate russian camila_lexi_male_ending_db57ee6e:
    camila.say "Хотела бы знать, Лекси!"

# ch/harems_full/criminal/events.rpy:2910
translate russian camila_lexi_male_ending_33029a41:
    lexi.say "Ну нет, Камила!"

# ch/harems_full/criminal/events.rpy:2911
translate russian camila_lexi_male_ending_6c5d8c53:
    lexi.say "Так нечестно!"

# ch/harems_full/criminal/events.rpy:2912
translate russian camila_lexi_male_ending_76abf3ab:
    camila.say "В общем..."

# ch/harems_full/criminal/events.rpy:2913
translate russian camila_lexi_male_ending_7bf5a38d:
    camila.say "Я рада, что теперь у меня есть вы оба — ты и [lssb_common.hero_name()]."

# ch/harems_full/criminal/events.rpy:2914
translate russian camila_lexi_male_ending_830a3a32:
    camila.say "Раньше все мои друзья были из полиции."

# ch/harems_full/criminal/events.rpy:2915
translate russian camila_lexi_male_ending_87a04b39:
    lexi.say "Понимаю тебя, Камила."

# ch/harems_full/criminal/events.rpy:2916
translate russian camila_lexi_male_ending_e9b7f52f:
    lexi.say "Все мои друзья были..."

# ch/harems_full/criminal/events.rpy:2917
translate russian camila_lexi_male_ending_f4e07783:
    lexi.say "Ну, они были..."

# ch/harems_full/criminal/events.rpy:2918
translate russian camila_lexi_male_ending_eb2f48e9:
    camila.say "Жуликами?"

# ch/harems_full/criminal/events.rpy:2919
translate russian camila_lexi_male_ending_0e3031cd:
    lexi.say "Уф..."

# ch/harems_full/criminal/events.rpy:2920
translate russian camila_lexi_male_ending_dcd3bf75:
    lexi.say "Наверное!"

# ch/harems_full/criminal/events.rpy:2921
translate russian camila_lexi_male_ending_d183fb16:
    camila.say "Скажем так: [lssb_common.hero_name()] познакомил нас обеих с новыми людьми, да?"

# ch/harems_full/criminal/events.rpy:2922
translate russian camila_lexi_male_ending_eeaf9c5d:
    lexi.say "Он сделал больше."

# ch/harems_full/criminal/events.rpy:2923
translate russian camila_lexi_male_ending_7ad4accf:
    lexi.say "Он превратил нас в семью!"

# ch/harems_full/criminal/events.rpy:2925
translate russian camila_lexi_male_ending_5a79cab2:
    camila.say "И не говори!"

# ch/harems_full/criminal/events.rpy:2926
translate russian camila_lexi_male_ending_771924eb:
    camila.say "Каковы были шансы, что мы ОБЕ родим двойню?"

# ch/harems_full/criminal/events.rpy:2927
translate russian camila_lexi_male_ending_581983a9:
    lexi.say "Вот именно!"

# ch/harems_full/criminal/events.rpy:2928
translate russian camila_lexi_male_ending_7c5d831e:
    lexi.say "Сначала ты родила Нову и Серен."

# ch/harems_full/criminal/events.rpy:2929
translate russian camila_lexi_male_ending_afc54923:
    lexi.say "А потом у меня появились Шантель и Тайрон!"

# ch/harems_full/criminal/events.rpy:2930
translate russian camila_lexi_male_ending_eb39bfa3:
    camila.say "Теперь хотя бы знаем, что [lssb_common.hero_name()] холостыми не стреляет!"

# ch/harems_full/criminal/events.rpy:2931
translate russian camila_lexi_male_ending_27d3c3cd:
    lexi.say "Ага, но пусть надевает на ствол колпачок."

# ch/harems_full/criminal/events.rpy:2932
translate russian camila_lexi_male_ending_a93a5a87:
    lexi.say "А то больше ко мне с этой штукой не подойдёт!"

# ch/harems_full/criminal/events.rpy:2934
translate russian camila_lexi_male_ending_5a79cab2_1:
    camila.say "И не говори!"

# ch/harems_full/criminal/events.rpy:2935
translate russian camila_lexi_male_ending_9a8c8bbf:
    camila.say "Каковы были шансы, что я рожу двойню?"

# ch/harems_full/criminal/events.rpy:2936
translate russian camila_lexi_male_ending_581983a9_1:
    lexi.say "Вот именно!"

# ch/harems_full/criminal/events.rpy:2937
translate russian camila_lexi_male_ending_4c9e9e49:
    lexi.say "Взяла и родила Нову и Серен — вот так сюрприз!"

# ch/harems_full/criminal/events.rpy:2938
translate russian camila_lexi_male_ending_eb39bfa3_1:
    camila.say "Теперь хотя бы знаем, что [lssb_common.hero_name()] холостыми не стреляет!"

# ch/harems_full/criminal/events.rpy:2939
translate russian camila_lexi_male_ending_27d3c3cd_1:
    lexi.say "Ага, но пусть надевает на ствол колпачок."

# ch/harems_full/criminal/events.rpy:2940
translate russian camila_lexi_male_ending_a93a5a87_1:
    lexi.say "А то больше ко мне с этой штукой не подойдёт!"

# ch/harems_full/criminal/events.rpy:2942
translate russian camila_lexi_male_ending_5a79cab2_2:
    camila.say "И не говори!"

# ch/harems_full/criminal/events.rpy:2943
translate russian camila_lexi_male_ending_61401505:
    camila.say "Каковы были шансы, что ты родишь двойню?"

# ch/harems_full/criminal/events.rpy:2944
translate russian camila_lexi_male_ending_581983a9_2:
    lexi.say "Вот именно!"

# ch/harems_full/criminal/events.rpy:2945
translate russian camila_lexi_male_ending_59645f8c:
    lexi.say "Взяла и родила Шантель и Тайрона — вот так сюрприз!"

# ch/harems_full/criminal/events.rpy:2946
translate russian camila_lexi_male_ending_eb39bfa3_2:
    camila.say "Теперь хотя бы знаем, что [lssb_common.hero_name()] холостыми не стреляет!"

# ch/harems_full/criminal/events.rpy:2947
translate russian camila_lexi_male_ending_27d3c3cd_2:
    lexi.say "Ага, но пусть надевает на ствол колпачок."

# ch/harems_full/criminal/events.rpy:2948
translate russian camila_lexi_male_ending_a93a5a87_2:
    lexi.say "А то больше ко мне с этой штукой не подойдёт!"

# ch/harems_full/criminal/events.rpy:2950
translate russian camila_lexi_male_ending_75948a64:
    camila.say "Да, но мы ещё не настоящая семья..."

# ch/harems_full/criminal/events.rpy:2951
translate russian camila_lexi_male_ending_1e950029:
    lexi.say "А, понимаю!"

# ch/harems_full/criminal/events.rpy:2952
translate russian camila_lexi_male_ending_7d512744:
    lexi.say "Хочешь залететь!"

# ch/harems_full/criminal/events.rpy:2953
translate russian camila_lexi_male_ending_dc95c751:
    camila.say "Я имею в виду, что хочу детей, Лекси!"

# ch/harems_full/criminal/events.rpy:2954
translate russian camila_lexi_male_ending_0ee0ce96:
    camila.say "А ты разве не хочешь?"

# ch/harems_full/criminal/events.rpy:2955
translate russian camila_lexi_male_ending_ccc31dee:
    camila.say "Хотелось бы убедиться, что [lssb_common.hero_name()] холостыми не стреляет!"

# ch/harems_full/criminal/events.rpy:2956
translate russian camila_lexi_male_ending_7a3bd225:
    lexi.say "Ага, и колпачок на ствол надевать ему не давай!"

# ch/harems_full/criminal/events.rpy:2957
translate russian camila_lexi_male_ending_5613e62a:
    lexi.say "Кстати, у нас в семье двойняшки рождаются очень часто."

# ch/harems_full/criminal/events.rpy:2958
translate russian camila_lexi_male_ending_aa76929a:
    camila.say "Надо же, у нас тоже!"

# ch/harems_full/criminal/events.rpy:2959
translate russian camila_lexi_male_ending_f73a9a33:
    lexi.say "Значит, в итоге всё сложилось хорошо, да?"

# ch/harems_full/criminal/events.rpy:2960
translate russian camila_lexi_male_ending_7d6b979e:
    lexi.say "[lssb_common.hero_name()] избавил меня от жизни в трейлерном парке."

# ch/harems_full/criminal/events.rpy:2961
translate russian camila_lexi_male_ending_ed734414:
    lexi.say "А тебя — от участи вечно быть зажатой копшей!"

# ch/harems_full/criminal/events.rpy:2962
translate russian camila_lexi_male_ending_dd537149:
    camila.say "ЭЙ!"

# ch/harems_full/criminal/events.rpy:2963
translate russian camila_lexi_male_ending_fbdf808a:
    camila.say "Меня ни от чего спасать не надо!"

# ch/harems_full/criminal/events.rpy:2964
translate russian camila_lexi_male_ending_5f5dee29:
    lexi.say "О-о..."

# ch/harems_full/criminal/events.rpy:2965
translate russian camila_lexi_male_ending_5fd8c320:
    lexi.say "Значит, признаёшь, что ты зажатая?"

# ch/harems_full/criminal/events.rpy:2966
translate russian camila_lexi_male_ending_4b1296b2:
    camila.say "Какого..."

# ch/harems_full/criminal/events.rpy:2967
translate russian camila_lexi_male_ending_0a372dd8:
    camila.say "Заткнись, Лекси!"

# ch/harems_full/criminal/events.rpy:2968
translate russian camila_lexi_male_ending_c6984eba:
    lexi.say "Ха-ха!"

# ch/harems_full/criminal/events.rpy:2969
translate russian camila_lexi_male_ending_26c32228:
    lexi.say "Да ладно, Камила!"

# ch/harems_full/criminal/events.rpy:2970
translate russian camila_lexi_male_ending_9acd46bf:
    lexi.say "Ты ведь знаешь, что на самом деле любишь меня!"
