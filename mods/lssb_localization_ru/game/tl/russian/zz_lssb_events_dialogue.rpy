# ch/gen_full/battle_of_the_bands.rpy:701
translate russian battle_of_the_bands_win_restaurant_1db4936b:
    anna.say "Я еле могла сосредоточиться на барабанах."

# ch/gen_full/battle_of_the_bands.rpy:702
translate russian battle_of_the_bands_win_restaurant_a2425b06:
    anna.say "Всё время думала, как он будет внутри меня!"

# ch/gen_full/battle_of_the_bands.rpy:703
translate russian battle_of_the_bands_win_restaurant_2b1aa745:
    anna.say "И до сих пор не могу..."

# ch/gen_full/battle_of_the_bands.rpy:704
translate russian battle_of_the_bands_win_restaurant_33b3999e:
    "Анна придвигается ещё ближе и теперь действительно шепчет мне на ухо."

# ch/gen_full/battle_of_the_bands.rpy:706
translate russian battle_of_the_bands_win_restaurant_590dae18:
    anna.say "[lssb_common.hero_name()]..."

# ch/gen_full/battle_of_the_bands.rpy:707
translate russian battle_of_the_bands_win_restaurant_cff7468b:
    anna.say "Хочу, чтобы ты трахнул меня под столом!"

# ch/gen_full/battle_of_the_bands.rpy:708
translate russian battle_of_the_bands_win_restaurant_a16d2cb3:
    "Я, конечно, пьян, но плохую идею всё ещё узнаю!"

# ch/gen_full/battle_of_the_bands.rpy:709
translate russian battle_of_the_bands_win_restaurant_d0468199:
    mike.say "Э-э, нет, Анна..."

# ch/gen_full/battle_of_the_bands.rpy:710
translate russian battle_of_the_bands_win_restaurant_3885cd84:
    mike.say "Давай подождём, пока останемся вдвоём, ладно?"

# ch/gen_full/battle_of_the_bands.rpy:711
translate russian battle_of_the_bands_win_restaurant_bef29737:
    anna.say "Ну-у..."

# ch/gen_full/battle_of_the_bands.rpy:713
translate russian battle_of_the_bands_win_restaurant_72646ec8:
    anna.say "Ладно, [lssb_common.hero_name()]. Но обещай!"

# ch/gen_full/battle_of_the_bands.rpy:714
translate russian battle_of_the_bands_win_restaurant_5c31fd3e_1:
    "Как только все доедают, я прошу счёт, и мы встаём."

# ch/gen_full/battle_of_the_bands.rpy:715
translate russian battle_of_the_bands_win_restaurant_52fa6ef4:
    "Саша и Клео начинают шумно ловить такси."

# ch/gen_full/battle_of_the_bands.rpy:716
translate russian battle_of_the_bands_win_restaurant_dde89147:
    "А Анна цепляется за мою руку, словно боится потерять меня прежде, чем исполнит обещание..."

# ch/gen_full/battle_of_the_bands.rpy:718
translate russian battle_of_the_bands_win_restaurant_b4e2f0d3:
    "Когда мы начинаем есть, разговор продолжается урывками между кусками."

# ch/gen_full/battle_of_the_bands.rpy:719
translate russian battle_of_the_bands_win_restaurant_685480a9:
    "Но в нём, кажется, участвуют все за столом."

# ch/gen_full/battle_of_the_bands.rpy:720
translate russian battle_of_the_bands_win_restaurant_426fc637:
    "То есть мы либо что-то вставляем с набитым ртом..."

# ch/gen_full/battle_of_the_bands.rpy:721
translate russian battle_of_the_bands_win_restaurant_968243a3:
    "Либо киваем и качаем головами, реагируя на сказанное."

# ch/gen_full/battle_of_the_bands.rpy:722
translate russian battle_of_the_bands_win_restaurant_c66f20cd:
    "Но вскоре Саша и Анна увлекаются разговором друг с другом."

# ch/gen_full/battle_of_the_bands.rpy:723
translate russian battle_of_the_bands_win_restaurant_034322e8:
    "И мы с Клео можем без помех уделить внимание друг другу."

# ch/gen_full/battle_of_the_bands.rpy:724
translate russian battle_of_the_bands_win_restaurant_88da8642:
    "Она игриво толкает меня локтем в бок и прижимается ко мне."

# ch/gen_full/battle_of_the_bands.rpy:726
translate russian battle_of_the_bands_win_restaurant_f5e72711:
    kleio.say "Сегодня ты хорошо справился, сердцеед."

# ch/gen_full/battle_of_the_bands.rpy:727
translate russian battle_of_the_bands_win_restaurant_7e6d8f07:
    kleio.say "ОЧЕНЬ хорошо..."

# ch/gen_full/battle_of_the_bands.rpy:728
translate russian battle_of_the_bands_win_restaurant_fa0ccfc4:
    "Я улыбаюсь и смущённо хихикаю, стараясь казаться скромным."

# ch/gen_full/battle_of_the_bands.rpy:729
translate russian battle_of_the_bands_win_restaurant_4033507c:
    "Хотя на самом деле комплименты от Клео — большая редкость."

# ch/gen_full/battle_of_the_bands.rpy:730
translate russian battle_of_the_bands_win_restaurant_241f8c21:
    "И стоит ей польстить моему самолюбию, как я уже у неё на крючке."

# ch/gen_full/battle_of_the_bands.rpy:731
translate russian battle_of_the_bands_win_restaurant_61ca2f36:
    mike.say "А... я старался, Клео."

# ch/gen_full/battle_of_the_bands.rpy:732
translate russian battle_of_the_bands_win_restaurant_56226483:
    mike.say "Думаю, мы просто сыгрались, понимаешь?"

# ch/gen_full/battle_of_the_bands.rpy:734
translate russian battle_of_the_bands_win_restaurant_ac32b19b:
    kleio.say "Не скромничай, [lssb_common.hero_name()]."

# ch/gen_full/battle_of_the_bands.rpy:735
translate russian battle_of_the_bands_win_restaurant_3059c0a0:
    kleio.say "Ты играл очень умело."

# ch/gen_full/battle_of_the_bands.rpy:736
translate russian battle_of_the_bands_win_restaurant_fe49ad94:
    kleio.say "А мне всё время хотелось, чтобы вместо гитары ты играл на мне!"

# ch/gen_full/battle_of_the_bands.rpy:737
translate russian battle_of_the_bands_win_restaurant_c146613c:
    "Тут я замечаю, что рука Клео лежит на моём члене."

# ch/gen_full/battle_of_the_bands.rpy:738
translate russian battle_of_the_bands_win_restaurant_283621ca:
    "И гладит его совершенно недвусмысленно."

# ch/gen_full/battle_of_the_bands.rpy:740
translate russian battle_of_the_bands_win_restaurant_9b678ad3:
    kleio.say "Слушай..."

# ch/gen_full/battle_of_the_bands.rpy:741
translate russian battle_of_the_bands_win_restaurant_246125a9:
    kleio.say "Не хочешь улизнуть в туалет? Или в переулок за рестораном?"

# ch/gen_full/battle_of_the_bands.rpy:742
translate russian battle_of_the_bands_win_restaurant_44b1df40:
    "Я так близок к согласию, что слова уже вертятся на языке..."

# ch/gen_full/battle_of_the_bands.rpy:744
translate russian battle_of_the_bands_win_restaurant_dc01c99b:
    anna.say "Всё, я доела! Пошли в клуб!"

# ch/gen_full/battle_of_the_bands.rpy:746
translate russian battle_of_the_bands_win_restaurant_d6194d6e:
    sasha.say "Чёрт возьми, отличная мысль!"

# ch/gen_full/battle_of_the_bands.rpy:748
translate russian battle_of_the_bands_win_restaurant_8c827142:
    "Клео досадливо закатывает глаза: её планы сорвались."

# ch/gen_full/battle_of_the_bands.rpy:749
translate russian battle_of_the_bands_win_restaurant_75920cee:
    mike.say "Не переживай, Клео."

# ch/gen_full/battle_of_the_bands.rpy:750
translate russian battle_of_the_bands_win_restaurant_3885cd84_1:
    mike.say "Давай подождём, пока останемся вдвоём, ладно?"

# ch/gen_full/battle_of_the_bands.rpy:751
translate russian battle_of_the_bands_win_restaurant_5bd5743f:
    kleio.say "Ладно, [lssb_common.hero_name()]. Только смотри, держи слово!"

# ch/gen_full/battle_of_the_bands.rpy:752
translate russian battle_of_the_bands_win_restaurant_c698d2f0_1:
    "Я киваю, прошу счёт, и мы встаём."

# ch/gen_full/battle_of_the_bands.rpy:753
translate russian battle_of_the_bands_win_restaurant_bcabbe4f:
    "Саша и Анна начинают шумно ловить такси."

# ch/gen_full/battle_of_the_bands.rpy:754
translate russian battle_of_the_bands_win_restaurant_65c577a2:
    "А Клео крепко держит меня за руку."

# ch/gen_full/battle_of_the_bands.rpy:755
translate russian battle_of_the_bands_win_restaurant_4041102f:
    "Сжимает её так, словно боится потерять меня прежде, чем я выполню свою часть уговора..."

# ch/gen_full/battle_of_the_bands.rpy:757
translate russian battle_of_the_bands_win_restaurant_75ed1ea3:
    "Кажется, один за другим мы забываем, как пользоваться ножом и вилкой."

# ch/gen_full/battle_of_the_bands.rpy:758
translate russian battle_of_the_bands_win_restaurant_88081dcd:
    "Стоит кому-нибудь уронить еду на стол или пол, как это становится самой смешной вещью на свете."

# ch/gen_full/battle_of_the_bands.rpy:759
translate russian battle_of_the_bands_win_restaurant_280da3a1:
    "Вскоре мы уже пытаемся кормить друг друга кусочками со своих тарелок."

# ch/gen_full/battle_of_the_bands.rpy:760
translate russian battle_of_the_bands_win_restaurant_21dc91f9:
    "А один пьяный, кормящий другого с дрожащей вилки, — это, оказывается, в десять раз смешнее."

# ch/gen_full/battle_of_the_bands.rpy:764
translate russian battle_of_the_bands_win_restaurant_93b2b7d2:
    "И как вы думаете, что бывает, когда пьяный смеётся с набитым ртом?"

# ch/gen_full/battle_of_the_bands.rpy:765
translate russian battle_of_the_bands_win_restaurant_3a169214:
    "Я не замечаю, кто именно разбрызгивает свой ужин по столу."

# ch/gen_full/battle_of_the_bands.rpy:766
translate russian battle_of_the_bands_win_restaurant_426ed80d:
    "Впрочем, личность виновника уже не так важна."

# ch/gen_full/battle_of_the_bands.rpy:767
translate russian battle_of_the_bands_win_restaurant_4bf05d61:
    mike.say "Э-э, ребята."

# ch/gen_full/battle_of_the_bands.rpy:768
translate russian battle_of_the_bands_win_restaurant_d8d9e557:
    mike.say "Думаю, пора попросить счёт!"

# ch/gen_full/battle_of_the_bands.rpy:769
translate russian battle_of_the_bands_win_restaurant_ab8e17e4:
    "Как ни стараюсь говорить тихо, всё равно почти выкрикиваю эти слова."

# ch/gen_full/battle_of_the_bands.rpy:770
translate russian battle_of_the_bands_win_restaurant_d3a806f4:
    "Разумеется, все сразу притихают и украдкой оглядываются на официанта."

# ch/gen_full/battle_of_the_bands.rpy:772
translate russian battle_of_the_bands_win_restaurant_52a81a63:
    anna.say "Ой... надеюсь, они на нас не сердятся!"

# ch/gen_full/battle_of_the_bands.rpy:773
translate russian battle_of_the_bands_win_restaurant_6a1bb5e5:
    kleio.say "Да пошли они! Не им нами командовать!"

# ch/gen_full/battle_of_the_bands.rpy:774
translate russian battle_of_the_bands_win_restaurant_586e63f7:
    "К счастью, Саша, кажется, понимает серьёзность положения."

# ch/gen_full/battle_of_the_bands.rpy:775
translate russian battle_of_the_bands_win_restaurant_d33a011b:
    sasha.say "[lssb_common.hero_name()] прав, ребята."

# ch/gen_full/battle_of_the_bands.rpy:776
translate russian battle_of_the_bands_win_restaurant_970464ab:
    sasha.say "Давайте уйдём куда-нибудь повеселее!"

# ch/gen_full/battle_of_the_bands.rpy:777
translate russian battle_of_the_bands_win_restaurant_de9ce319:
    "Мы встаём и собираемся уходить."

# ch/gen_full/battle_of_the_bands.rpy:778
translate russian battle_of_the_bands_win_restaurant_efd8a7a3:
    "Но, несмотря на все мои слова, шумим так, что мёртвых разбудим."

# ch/gen_full/battle_of_the_bands.rpy:779
translate russian battle_of_the_bands_win_restaurant_0cd5f4f2:
    "В конце концов официант, по-моему, просто сдерживается и улыбается."

# ch/gen_full/battle_of_the_bands.rpy:780
translate russian battle_of_the_bands_win_restaurant_86bef955_1:
    "Зато дверь за нами он захлопывает с явным удовольствием."

# ch/gen_full/battle_of_the_bands.rpy:782
translate russian battle_of_the_bands_win_restaurant_220154a9_1:
    "Кроме меня, этого никто не замечает: девушки уже шумно ловят такси через дорогу."

# ch/gen_full/battle_of_the_bands.rpy:788
translate russian battle_of_the_bands_win_nightclub_09e4032a:
    "Наконец найдя таксиста, согласного нас везти, мы вчетвером с энтузиазмом забираемся в машину."

# ch/gen_full/battle_of_the_bands.rpy:789
translate russian battle_of_the_bands_win_nightclub_0e169b5d:
    "И когда нас спрашивают, куда мы, чёрт возьми, направляемся, неудивительно, что все одновременно требуют одного и того же."

# ch/gen_full/battle_of_the_bands.rpy:795
translate russian battle_of_the_bands_win_nightclub_a69ed8c4:
    "Таксист" "Итак, куда едем?"

# ch/gen_full/battle_of_the_bands.rpy:797
translate russian battle_of_the_bands_win_nightclub_1e3e2d7d:
    kleio.say "А сам как думаешь, дурень?"

# ch/gen_full/battle_of_the_bands.rpy:798
translate russian battle_of_the_bands_win_nightclub_2163c25f:
    kleio.say "В грёбаную оперу?!"

# ch/gen_full/battle_of_the_bands.rpy:799
translate russian battle_of_the_bands_win_nightclub_2f46b021:
    anna.say "Ага, нам туда, где играют метал."

# ch/gen_full/battle_of_the_bands.rpy:801
translate russian battle_of_the_bands_win_nightclub_4997b42b:
    anna.say "Так громко, чтобы из ушей кровь пошла!"

# ch/gen_full/battle_of_the_bands.rpy:803
translate russian battle_of_the_bands_win_nightclub_a25879a0:
    sasha.say "Вот это я понимаю!"

# ch/gen_full/battle_of_the_bands.rpy:804
translate russian battle_of_the_bands_win_nightclub_3e8b65af:
    "После того как три девушки прокричали ему прямо в лицо, таксист смотрит на меня с мольбой."

# ch/gen_full/battle_of_the_bands.rpy:805
translate russian battle_of_the_bands_win_nightclub_b4d8b455:
    "Дело не в сексизме: он просто надеется, что я хоть немного трезвее."

# ch/gen_full/battle_of_the_bands.rpy:806
translate russian battle_of_the_bands_win_nightclub_1683f128:
    mike.say "Просто отвезите нас в клуб, ладно?"

# ch/gen_full/battle_of_the_bands.rpy:807
translate russian battle_of_the_bands_win_nightclub_792f0e13:
    "Он кивает с искренним облегчением: наконец-то назван конкретный адрес."

# ch/gen_full/battle_of_the_bands.rpy:808
translate russian battle_of_the_bands_win_nightclub_274c50ec:
    "И, наверное, радуется, что теперь знает, сколько ещё терпеть нашу компанию."

# ch/gen_full/battle_of_the_bands.rpy:817
translate russian battle_of_the_bands_win_nightclub_d099c1e6:
    "Вскоре такси останавливается у клуба, и мы вываливаемся на тротуар."

# ch/gen_full/battle_of_the_bands.rpy:818
translate russian battle_of_the_bands_win_nightclub_9e8b07d4:
    "Водитель получает деньги и тут же уезжает."

# ch/gen_full/battle_of_the_bands.rpy:819
translate russian battle_of_the_bands_win_nightclub_eafb55cc:
    "Интересно, хватит ли этой суммы на штрафы, которые придут ему по почте?"

# ch/gen_full/battle_of_the_bands.rpy:820
translate russian battle_of_the_bands_win_nightclub_38c980ce:
    "По пути сюда он наверняка пронёсся мимо полудюжины камер с изрядным превышением скорости."

# ch/gen_full/battle_of_the_bands.rpy:825
translate russian battle_of_the_bands_win_nightclub_75ced615:
    "Как только мы встаём в очередь, мысли обо всём, кроме клуба, мгновенно исчезают."

# ch/gen_full/battle_of_the_bands.rpy:826
translate russian battle_of_the_bands_win_nightclub_711dbbf0:
    "Очередь, как обычно, длинная. Надеюсь, мы не успеем протрезветь до входа."

# ch/gen_full/battle_of_the_bands.rpy:827
translate russian battle_of_the_bands_win_nightclub_f629cc5f:
    "Но тут мне кое-что приходит в голову, и я отчаянно шарю по карманам."

# ch/gen_full/battle_of_the_bands.rpy:828
translate russian battle_of_the_bands_win_nightclub_61be6662:
    sasha.say "Эй, [lssb_common.hero_name()], прекрати!"

# ch/gen_full/battle_of_the_bands.rpy:830
translate russian battle_of_the_bands_win_nightclub_eba9f379:
    sasha.say "Надо было ещё в ресторане сходить, знаешь ли!"

# ch/gen_full/battle_of_the_bands.rpy:831
translate russian battle_of_the_bands_win_nightclub_099bf3f8:
    anna.say "А?.. Что такое?"

# ch/gen_full/battle_of_the_bands.rpy:832
translate russian battle_of_the_bands_win_nightclub_ab2c811e:
    kleio.say "Ого, сердцеед, похоже, трогает себя на публике!"

# ch/gen_full/battle_of_the_bands.rpy:833
translate russian battle_of_the_bands_win_nightclub_bc4269d8:
    "Я поднимаю на них глаза в недоумении и с изрядным раздражением."

# ch/gen_full/battle_of_the_bands.rpy:835
translate russian battle_of_the_bands_win_nightclub_d99b8eec:
    mike.say "Да не хочу я ссать, чёрт возьми!"

# ch/gen_full/battle_of_the_bands.rpy:836
translate russian battle_of_the_bands_win_nightclub_949f90d9:
    mike.say "У нас VIP-пропуска, помните?!"

# ch/gen_full/battle_of_the_bands.rpy:838
translate russian battle_of_the_bands_win_nightclub_20f1408a:
    "Саша первой понимает, о чём речь, и с улыбкой кивает."

# ch/gen_full/battle_of_the_bands.rpy:839
translate russian battle_of_the_bands_win_nightclub_f932988d:
    sasha.say "Точно! Подарочные пакеты с «Битвы групп»!"

# ch/gen_full/battle_of_the_bands.rpy:841
translate russian battle_of_the_bands_win_nightclub_cfe68d02:
    anna.say "У нас VIP-пропуска! УРА!"

# ch/gen_full/battle_of_the_bands.rpy:843
translate russian battle_of_the_bands_win_nightclub_dba5d473:
    kleio.say "Правда?"

# ch/gen_full/battle_of_the_bands.rpy:844
translate russian battle_of_the_bands_win_nightclub_4beaa6da:
    kleio.say "Так какого чёрта мы стоим в очереди с этими неудачниками?!"

# ch/gen_full/battle_of_the_bands.rpy:845
translate russian battle_of_the_bands_win_nightclub_c22322f5:
    "В отличие от Клео, я слышу хор возмущённых голосов, вызванный её словами."

# ch/gen_full/battle_of_the_bands.rpy:846
translate russian battle_of_the_bands_win_nightclub_f0cf62ef:
    "Размахивая изрядно помятыми пропусками, я торопливо пробираюсь к началу очереди."

