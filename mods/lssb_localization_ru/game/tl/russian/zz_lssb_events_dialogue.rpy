# ch/gen_full/battle_of_the_bands.rpy:1104
translate russian battle_of_the_bands_win_nightclub_8ae859a9_2:
    "Каждый раз, когда она прижимается ко мне, я хочу её ещё сильнее."

# ch/gen_full/battle_of_the_bands.rpy:1105
translate russian battle_of_the_bands_win_nightclub_980c4700_2:
    "И чувствую, что в ней нарастает то же желание."

# ch/gen_full/battle_of_the_bands.rpy:1106
translate russian battle_of_the_bands_win_nightclub_8ee6d7cb_4:
    "Никогда ещё я так ясно не понимал, насколько такой танец похож на прелюдию."

# ch/gen_full/battle_of_the_bands.rpy:1107
translate russian battle_of_the_bands_win_nightclub_78e935e8_4:
    "Если вскоре мы не перейдём к логичному продолжению, я, кажется, сойду с ума."

# ch/gen_full/battle_of_the_bands.rpy:1108
translate russian battle_of_the_bands_win_nightclub_dd34172d:
    "Я наклоняюсь ближе, стараясь говорить прямо Клео в ухо."

# ch/gen_full/battle_of_the_bands.rpy:1109
translate russian battle_of_the_bands_win_nightclub_695d1fac:
    mike.say "Клео, мне нужно остаться с тобой наедине!"

# ch/gen_full/battle_of_the_bands.rpy:1110
translate russian battle_of_the_bands_win_nightclub_ba9d8c09_2:
    "Но грохот музыки не даёт ей меня услышать."

# ch/gen_full/battle_of_the_bands.rpy:1111
translate russian battle_of_the_bands_win_nightclub_f7b333da_2:
    kleio.say "А?"

# ch/gen_full/battle_of_the_bands.rpy:1113
translate russian battle_of_the_bands_win_nightclub_7a5f857b_2:
    kleio.say "Ты... хочешь позвонить с моего телефона?!"

# ch/gen_full/battle_of_the_bands.rpy:1114
translate russian battle_of_the_bands_win_nightclub_66eafd49_4:
    mike.say "Нет... я хочу заняться с тобой любовью!"

# ch/gen_full/battle_of_the_bands.rpy:1116
translate russian battle_of_the_bands_win_nightclub_f4963bae:
    kleio.say "Что?.. Хочешь залить перчатку клеем?!"

# ch/gen_full/battle_of_the_bands.rpy:1117
translate russian battle_of_the_bands_win_nightclub_bac7837c_4:
    mike.say "Нет... Я ХОЧУ ТЕБЯ ТРАХНУТЬ!!!"

# ch/gen_full/battle_of_the_bands.rpy:1118
translate russian battle_of_the_bands_win_nightclub_79f68397_4:
    "Разумеется, именно в эту секунду песня заканчивается, и над танцполом повисает тишина."

# ch/gen_full/battle_of_the_bands.rpy:1119
translate russian battle_of_the_bands_win_nightclub_847b114d_4:
    "Внезапно я понимаю, что все смотрят на меня."

# ch/gen_full/battle_of_the_bands.rpy:1120
translate russian battle_of_the_bands_win_nightclub_02a97a4d:
    "Анна и Саша тоже смотрят: первая широко раскрыла глаза, а вторая уже ухмыляется."

# ch/gen_full/battle_of_the_bands.rpy:1124
translate russian battle_of_the_bands_win_nightclub_2a511bd9:
    "А Клео лишь качает головой, глядя мне в глаза без малейшего смущения."

# ch/gen_full/battle_of_the_bands.rpy:1125
translate russian battle_of_the_bands_win_nightclub_a9ebade5_2:
    kleio.say "Господи, ну ты и растяпа, [lssb_common.hero_name()]."

# ch/gen_full/battle_of_the_bands.rpy:1127
translate russian battle_of_the_bands_win_nightclub_5ba1ad04_2:
    kleio.say "Но за это я тебя и люблю!"

# ch/gen_full/battle_of_the_bands.rpy:1128
translate russian battle_of_the_bands_win_nightclub_21857a5a_4:
    "Я бреду с танцпола, всё ещё сгорая от стыда."

# ch/gen_full/battle_of_the_bands.rpy:1129
translate russian battle_of_the_bands_win_nightclub_ea6a9a49:
    "Клео всё это время держит меня за руку и отпускает, лишь когда мы садимся в такси до моего дома."

# ch/gen_full/battle_of_the_bands.rpy:1136
translate russian battle_of_the_bands_win_nightclub_f0fb0467:
    "На танцполе мы инстинктивно держимся вчетвером."

# ch/gen_full/battle_of_the_bands.rpy:1137
translate russian battle_of_the_bands_win_nightclub_017d8cdf:
    "Нас связывают лишь платоническая дружба и товарищество."

# ch/gen_full/battle_of_the_bands.rpy:1142
translate russian battle_of_the_bands_win_nightclub_0bd4ffc3:
    "Но мы всё равно немного флиртуем и танцуем довольно тесно."

# ch/gen_full/battle_of_the_bands.rpy:1143
translate russian battle_of_the_bands_win_nightclub_338128dc:
    "Каждый из нас не раз привлекает внимание потенциального партнёра."

# ch/gen_full/battle_of_the_bands.rpy:1144
translate russian battle_of_the_bands_win_nightclub_4022e285:
    "И всё же сейчас в нашей общей связи есть что-то особенное."

# ch/gen_full/battle_of_the_bands.rpy:1145
translate russian battle_of_the_bands_win_nightclub_2c4ee294:
    "Поэтому мы полностью игнорируем даже самые явные попытки познакомиться."

# ch/gen_full/battle_of_the_bands.rpy:1146
translate russian battle_of_the_bands_win_nightclub_b1cd47dd:
    "Словно наше достижение священно и чужак мог бы его осквернить."

# ch/gen_full/battle_of_the_bands.rpy:1147
translate russian battle_of_the_bands_win_nightclub_0b0dd62e:
    "И самое странное — меня это полностью устраивает."

# ch/gen_full/battle_of_the_bands.rpy:1148
translate russian battle_of_the_bands_win_nightclub_7bd0cedf:
    "Не то чтобы я потерял интерес к таким вещам."

# ch/gen_full/battle_of_the_bands.rpy:1149
translate russian battle_of_the_bands_win_nightclub_027b36a3:
    "Просто прежде у меня никогда не было такой дружбы с девушками."

# ch/gen_full/battle_of_the_bands.rpy:1150
translate russian battle_of_the_bands_win_nightclub_3e49ca07:
    "Саша, Анна и Клео — каждая по-своему очень привлекательна."

# ch/gen_full/battle_of_the_bands.rpy:1151
translate russian battle_of_the_bands_win_nightclub_9757eabd:
    "Но сейчас я люблю их как подруг, а не вижу в них будущие победы на любовном фронте."

# ch/gen_full/battle_of_the_bands.rpy:1152
translate russian battle_of_the_bands_win_nightclub_8c13e65e:
    "Кто знает, может, в будущем это изменится, а может, и нет."

# ch/gen_full/battle_of_the_bands.rpy:1153
translate russian battle_of_the_bands_win_nightclub_98eaa7e5:
    "Сейчас они мои подруги и товарищи по группе. Этого мне достаточно."

# ch/gen_full/battle_of_the_bands.rpy:1154
translate russian battle_of_the_bands_win_nightclub_d2c5873b:
    "Остаток ночи сливается в туман: ещё выпивка и ещё больше танцев."

# ch/gen_full/battle_of_the_bands.rpy:1156
translate russian battle_of_the_bands_win_nightclub_2e8fa834:
    "В какой-то момент мы, должно быть, вываливаемся из клуба и садимся в очередное такси."

# ch/gen_full/battle_of_the_bands.rpy:1158
translate russian battle_of_the_bands_win_nightclub_f5436184:
    "Последнее, что помню: девушки несут меня в комнату."

# ch/gen_full/battle_of_the_bands.rpy:1160
translate russian battle_of_the_bands_win_nightclub_e626c5e5:
    sasha.say "Поспи, [lssb_common.hero_name()]."

# ch/gen_full/battle_of_the_bands.rpy:1162
translate russian battle_of_the_bands_win_nightclub_741c5ca1:
    anna.say "Ох... утром у него будет адское похмелье!"

# ch/gen_full/battle_of_the_bands.rpy:1164
translate russian battle_of_the_bands_win_nightclub_d1927e16:
    kleio.say "Спи спокойно, милый принц!"

# ch/gen_full/battle_of_the_bands.rpy:1166
translate russian battle_of_the_bands_win_nightclub_554077a0:
    "И я отключаюсь, всё ещё слыша их голоса..."

# ch/gen_full/battle_of_the_bands.rpy:1174
translate russian battle_of_the_bands_round_two_86b4e50c:
    "Мы добираемся до площадки в рекордные сроки."

# ch/gen_full/battle_of_the_bands.rpy:1175
translate russian battle_of_the_bands_round_two_33a2ce1e:
    "Клео то ли бодрее, то ли просто воинственнее остальных: она первой находит порядок выступлений."

# ch/gen_full/battle_of_the_bands.rpy:1177
translate russian battle_of_the_bands_round_two_e7089e0c:
    kleio.say "БЛЯДЬ! Нас поставили последними!"

# ch/gen_full/battle_of_the_bands.rpy:1179
translate russian battle_of_the_bands_round_two_8f5283e4:
    anna.say "Это хорошо... или плохо?"

# ch/gen_full/battle_of_the_bands.rpy:1181
translate russian battle_of_the_bands_round_two_08d0066c:
    sasha.say "Просто факт. Неважно, когда выступаем. Важно, как сыграем."

# ch/gen_full/battle_of_the_bands.rpy:1183
translate russian battle_of_the_bands_round_two_b7b9aa04:
    "Я киваю и добавляю что-то невнятное, надеясь, что звучит достаточно ободряюще. К моему облегчению, все улыбаются."

# ch/gen_full/battle_of_the_bands.rpy:1184
translate russian battle_of_the_bands_round_two_b67e94aa:
    "Оставшееся время ползёт, как гонка увечного слизня с черепахой, больной артритом."

# ch/gen_full/battle_of_the_bands.rpy:1185
translate russian battle_of_the_bands_round_two_aa4f0a35:
    "Все берегут больные головы и изображают интерес к грохочущей музыке, от которой виски раскалываются ещё сильнее."

# ch/gen_full/battle_of_the_bands.rpy:1186
translate russian battle_of_the_bands_round_two_0f6e9df4:
    "Лишь перед самым выходом на сцену я чувствую, как похмелье уступает место адреналину и радостному предвкушению."

# ch/gen_full/battle_of_the_bands.rpy:1187
translate russian battle_of_the_bands_round_two_032f3459:
    "Саша кивает, мы по очереди киваем в ответ и молча выходим на сцену."

# ch/gen_full/battle_of_the_bands.rpy:1188
translate russian battle_of_the_bands_round_two_2a1c620b:
    "Не могу понять, те ли лица в толпе, что вчера, но стараюсь об этом не думать."

# ch/gen_full/battle_of_the_bands.rpy:1189
translate russian battle_of_the_bands_round_two_98a5ccb6:
    "Говорю себе: вчера они только попробовали Deathless Harpies, а сегодня получат полную порцию — на пределе возможностей."

# ch/gen_full/battle_of_the_bands.rpy:1192
translate russian battle_of_the_bands_round_two_e0f95251:
    kleio.say "Мы Deathless Harpies и хотим выиграть весь этот грёбаный конкурс!"

# ch/gen_full/battle_of_the_bands.rpy:1193
translate russian battle_of_the_bands_round_two_6e3cd433:
    kleio.say "Но сначала нужно покорить вас, засранцы... так что погнали!"

# ch/gen_full/battle_of_the_bands.rpy:1196
translate russian battle_of_the_bands_round_two_a787bbee:
    "Мы начинаем с пары вчерашних песен, чтобы напомнить публике, кто мы."

# ch/gen_full/battle_of_the_bands.rpy:1203
translate russian battle_of_the_bands_round_two_c7a13ef2:
    "Потом переходим к другому материалу — лучшему, который специально приберегли."

# ch/gen_full/battle_of_the_bands.rpy:1204
translate russian battle_of_the_bands_round_two_79a25e99:
    "На случай, если дойдём так далеко и понадобится последний удар под дых для победы."

# ch/gen_full/battle_of_the_bands.rpy:1207
translate russian battle_of_the_bands_round_two_243bc61c:
    "В одной из песен мы доходим до места, где, по моему убеждению, нужно гитарное соло."

# ch/gen_full/battle_of_the_bands.rpy:1208
translate russian battle_of_the_bands_round_two_96a03cb6:
    "На репетиции идею отклонили: два голоса против одного, один воздержался."

# ch/gen_full/battle_of_the_bands.rpy:1209
translate russian battle_of_the_bands_round_two_e4a03de8:
    "Но теперь, на сцене, я уверен в ней как никогда, и никто не помешает мне попробовать."

# ch/gen_full/battle_of_the_bands.rpy:1213
translate russian battle_of_the_bands_round_two_50f07ab1:
    "Я до сих пор не знаю, считает ли публика меня долговязой девушкой или понимает, что я переодетый парень."

# ch/gen_full/battle_of_the_bands.rpy:1214
translate russian battle_of_the_bands_round_two_0d312c3c:
    "В любом случае никто не готов к тому, что я поставлю ногу в чулке на колонку и выдам соло такого масштаба."

# ch/gen_full/battle_of_the_bands.rpy:1215
translate russian battle_of_the_bands_round_two_5418d29e:
    "В эту секунду я готов поверить, что заставил всех в зале — мужчин и женщин любой ориентации — захотеть меня."

# ch/gen_full/battle_of_the_bands.rpy:1216
translate russian battle_of_the_bands_round_two_d556f838:
    "Женский образ ощущается идеальной бронёй, второй кожей, превращающей меня в настоящую звезду."

# ch/gen_full/battle_of_the_bands.rpy:1219
translate russian battle_of_the_bands_round_two_b1677430:
    "В тот момент, когда нужно следовать плану, я внезапно ухожу в эффектное соло."

# ch/gen_full/battle_of_the_bands.rpy:1220
translate russian battle_of_the_bands_round_two_95d53d5b:
    "Стараюсь не замечать реакции девушек и сосредотачиваюсь на музыке, превращая инстинкт в чистый звук."

# ch/gen_full/battle_of_the_bands.rpy:1221
translate russian battle_of_the_bands_round_two_e8808109:
    "Клео плавно подстраивается. Поднимаясь по метафорической лестнице в небо, я едва слышу нарастающий рёв восторга."

# ch/gen_full/battle_of_the_bands.rpy:1222
translate russian battle_of_the_bands_round_two_8b904eb8:
    "Заканчивая соло, надеюсь, что зрители примут мои вздохи за торжество, а не просто облегчение."

# ch/gen_full/battle_of_the_bands.rpy:1225
translate russian battle_of_the_bands_round_two_09209551:
    "Едва я отступаю от надёжного плана, как почти физически чувствую: всё идёт не так."

# ch/gen_full/battle_of_the_bands.rpy:1226
translate russian battle_of_the_bands_round_two_6658f928:
    "Моя импровизация не вписывается в общее звучание и сбивает девушек с их партий."

# ch/gen_full/battle_of_the_bands.rpy:1227
translate russian battle_of_the_bands_round_two_da5bd467:
    "Чтобы спасти лицо, приходится изобразить обрыв струны или что-то подобное и совсем перестать играть."

# ch/gen_full/battle_of_the_bands.rpy:1228
translate russian battle_of_the_bands_round_two_640d292d:
    "Щёки горят от стыда, а девушки уже шипят, требуя объяснений."

# ch/gen_full/battle_of_the_bands.rpy:1232
translate russian battle_of_the_bands_round_two_21866222:
    "К последним песням я замечаю, что сегодня никто из музыкантов ещё не прыгал в толпу."

# ch/gen_full/battle_of_the_bands.rpy:1233
translate russian battle_of_the_bands_round_two_5ee922c5:
    "Предупредить остальных нет возможности. Остаётся наблюдать за публикой и выбирать подходящий момент."

# ch/gen_full/battle_of_the_bands.rpy:1237
translate russian battle_of_the_bands_round_two_37276c8b:
    "Я нахожу в толпе группу крепких ребят, выжидаю и через секунду прыгаю в зал."

# ch/gen_full/battle_of_the_bands.rpy:1238
translate russian battle_of_the_bands_round_two_7aa7e989:
    "К счастью, достаточно людей замечают мой прыжок. Я удерживаю гитару и продолжаю играть, плывя над толпой."

# ch/gen_full/battle_of_the_bands.rpy:1239
translate russian battle_of_the_bands_round_two_9af76ce5:
    "В какой-то момент я сбиваюсь: чья-то рука явно залезает мне под платье и лапает."

# ch/gen_full/battle_of_the_bands.rpy:1240
translate russian battle_of_the_bands_round_two_891374fe:
    "Соло удалось, но запомнится мне другое: я узнал, каково женщине среди любителей распускать руки."

# ch/gen_full/battle_of_the_bands.rpy:1243
translate russian battle_of_the_bands_round_two_1e832818:
    "Взлетая в воздух с гитарой, молюсь, чтобы пара здоровяков, на которых я нацелился, не сдвинулась."

# ch/gen_full/battle_of_the_bands.rpy:1244
translate russian battle_of_the_bands_round_two_deb8dcab:
    "Хотя бы один из них замечает меня, и я приземляюсь на подставленные руки. Кабеля гитары чудом тоже хватает."

# ch/gen_full/battle_of_the_bands.rpy:1245
translate russian battle_of_the_bands_round_two_bc0e064b:
    "Покачиваясь над головами, я доигрываю песню, видя перед собой лишь потолок зала."

# ch/gen_full/battle_of_the_bands.rpy:1246
translate russian battle_of_the_bands_round_two_0051617d:
    "Неудобство того стоит: публика явно в восторге от такой безрассудной смелости."

# ch/gen_full/battle_of_the_bands.rpy:1249
translate russian battle_of_the_bands_round_two_1847f696:
    "Прыгая со сцены, молюсь всем, кто услышит, чтобы здоровяки, на которых я нацелился, не сдвинулись."

# ch/gen_full/battle_of_the_bands.rpy:1250
translate russian battle_of_the_bands_round_two_2e64dc8a:
    "Но удача отворачивается: толпа оттесняет их в сторону, и я лечу к стайке девочек-подростков."

# ch/gen_full/battle_of_the_bands.rpy:1251
translate russian battle_of_the_bands_round_two_2c33fd7f:
    "Не заметив моего приближения и вряд ли сумев бы меня поймать, они инстинктивно разбегаются. Я с грохотом падаю на пол."

# ch/gen_full/battle_of_the_bands.rpy:1252
translate russian battle_of_the_bands_round_two_67781eb6:
    "Песня заканчивается раньше, чем я дохрамываю до ограждения и смущённо забираюсь на сцену, избегая убийственных взглядов публики и группы."

# ch/gen_full/battle_of_the_bands.rpy:1262
translate russian battle_of_the_bands_round_two_cc5c94af:
    "Когда последняя песня заканчивается и затихают ноты, мы плетёмся со сцены совершенно измотанные, выжатые досуха."

# ch/gen_full/battle_of_the_bands.rpy:1263
translate russian battle_of_the_bands_round_two_5a959b95:
    "Мы так устали, что пропускаем объявление результатов. Их приходится пересказывать одному из работников за кулисами."

# ch/gen_full/battle_of_the_bands.rpy:1266
translate russian battle_of_the_bands_round_two_90ed7ed2:
    "После выступления мы словно оглушены, и смысл его слов доходит не сразу."

# ch/gen_full/battle_of_the_bands.rpy:1273
translate russian battle_of_the_bands_round_two_d3edba40:
    sasha.say "Что, погоди... мы выиграли?"

# ch/gen_full/battle_of_the_bands.rpy:1275
translate russian battle_of_the_bands_round_two_025acb37:
    kleio.say "Ну он ведь именно это, блядь, и сказал?"

# ch/gen_full/battle_of_the_bands.rpy:1277
translate russian battle_of_the_bands_round_two_b8488e1a:
    anna.say "Кажется, я так и услышала."

# ch/gen_full/battle_of_the_bands.rpy:1278
translate russian battle_of_the_bands_round_two_7c9795e3:
    mike.say "Ты всё правильно услышала, Анна. Мы выиграли конкурс!"

# ch/gen_full/battle_of_the_bands.rpy:1282
translate russian battle_of_the_bands_round_two_57c8f325:
    "Главное, конечно, наша победа. Но никто не упускает случая добавить, как здорово, что у нас такая открытая для всех группа."

# ch/gen_full/battle_of_the_bands.rpy:1284
translate russian battle_of_the_bands_round_two_3ae589ce:
    anna.say "Что они имеют в виду?"

# ch/gen_full/battle_of_the_bands.rpy:1286
translate russian battle_of_the_bands_round_two_b236f31e:
    kleio.say "Что вот этот хер в платье принёс нам симпатии ЛГБТК+."

# ch/gen_full/battle_of_the_bands.rpy:1288
translate russian battle_of_the_bands_round_two_8a202620:
    sasha.say "Но это же здорово? Мы ведь этого и хотели с самого начала?"

# ch/gen_full/battle_of_the_bands.rpy:1289
translate russian battle_of_the_bands_round_two_3d6736f1:
    mike.say "Да ну вас! Здорово, что сработало, но вы просто хотели поставить меня в неловкое положение!"

# ch/gen_full/battle_of_the_bands.rpy:1293
translate russian battle_of_the_bands_round_two_0930eae1:
    "Глядя на их растерянные лица, я не могу сдержать смех. Они сами не понимают, то ли сознательно выступили за прогресс и политкорректность, то ли просто удачно пошутили, как дети."

# ch/gen_full/battle_of_the_bands.rpy:1295
translate russian battle_of_the_bands_round_two_2ec141d2:
    "Внезапно все начинают обниматься и целоваться, и за кулисами вот-вот грянет оргия всей группы."

# ch/gen_full/battle_of_the_bands.rpy:1297
translate russian battle_of_the_bands_round_two_98fce113:
    "Сначала слова сотрудника не укладываются в голове, но потом я почти чувствую, как у девушек опускаются сердца."

# ch/gen_full/battle_of_the_bands.rpy:1304
translate russian battle_of_the_bands_round_two_ebe369a1:
    kleio.say "Это бред, чувак! Мы играли лучше всего того мусора на сцене!"

# ch/gen_full/battle_of_the_bands.rpy:1306
translate russian battle_of_the_bands_round_two_05aaeadc:
    sasha.say "Да чтоб меня... После выхода в финал я правда думала, что победа у нас в кармане."

# ch/gen_full/battle_of_the_bands.rpy:1308
translate russian battle_of_the_bands_round_two_e40632ec:
    anna.say "Ой... значит, мы не выиграли?"

# ch/gen_full/battle_of_the_bands.rpy:1309
translate russian battle_of_the_bands_round_two_cdaddb68:
    mike.say "Нет, Анна... не выиграли."

# ch/gen_full/battle_of_the_bands.rpy:1312
translate russian battle_of_the_bands_round_two_be236166:
    "Хочется сказать что-нибудь ободряющее, что главное — участие, или хотя бы услышать это от остальных."

# ch/gen_full/battle_of_the_bands.rpy:1313
translate russian battle_of_the_bands_round_two_a1684982:
    "Но я так вымотан физически и душевно, что просто не могу."

# ch/gen_full/battle_of_the_bands.rpy:1315
translate russian battle_of_the_bands_round_two_691404a3:
    "Как и вчера, на сцене что-то вручают, а потом устраивают вечеринку."

# ch/gen_full/battle_of_the_bands.rpy:1316
translate russian battle_of_the_bands_round_two_6ab5fe82:
    "Но мы настолько измотаны и взвинчены, что при первой возможности все вместе извиняемся и уходим."

# ch/gen_full/battle_of_the_bands.rpy:1317
translate russian battle_of_the_bands_round_two_9cf0ccbb:
    "Не представляю, что сегодняшний вечер значит для группы и для нас четверых."

# ch/gen_full/battle_of_the_bands.rpy:1318
translate russian battle_of_the_bands_round_two_a5e2a0fb:
    "Но в одном уверен: перемены впереди неизбежны — к лучшему или к худшему."

# ch/gen_full/battle_of_the_bands.rpy:1324
translate russian battle_of_the_bands_round_one_a711e7c9:
    "Кажется, мы целую жизнь вкалывали в репетиционной, но день «Битвы групп» наконец настал."

# ch/gen_full/battle_of_the_bands.rpy:1325
translate russian battle_of_the_bands_round_one_aa420014:
    "Все четверо нервничают и скрывают это по-своему: угрюмостью, весельем или притворным безразличием к результату."

# ch/gen_full/battle_of_the_bands.rpy:1326
translate russian battle_of_the_bands_round_one_739da76e:
    "Сегодня пятница, поэтому мы приезжаем как можно раньше и начинаем выгружать оборудование из фургона."

# ch/gen_full/battle_of_the_bands.rpy:1331
translate russian battle_of_the_bands_round_one_e4b4c554:
    anna.say "Ого, гляньте на их аппаратуру... вот это вещи!"

# ch/gen_full/battle_of_the_bands.rpy:1334
translate russian battle_of_the_bands_round_one_bb6ddfc0:
    kleio.say "Дорогие игрушки не заменят настоящего грёбаного таланта!"

# ch/gen_full/battle_of_the_bands.rpy:1335
translate russian battle_of_the_bands_round_one_9b9e8b5a:
    mike.say "Клео права, Анна. Мы не хуже остальных, и это просто ещё один концерт."

# ch/gen_full/battle_of_the_bands.rpy:1337
translate russian battle_of_the_bands_round_one_d4c0d6eb:
    sasha.say "Два, ты хотел сказать."

# ch/gen_full/battle_of_the_bands.rpy:1339
translate russian battle_of_the_bands_round_one_a0b6f165:
    sasha.say "Тут два тура: сегодня полуфинал, а через две недели — главный финал."

# ch/gen_full/battle_of_the_bands.rpy:1342
translate russian battle_of_the_bands_round_one_8c2fec61:
    anna.say "Целых два концерта?!"

# ch/gen_full/battle_of_the_bands.rpy:1344
translate russian battle_of_the_bands_round_one_e2005872:
    kleio.say "Господи, Саша! Могла бы предупредить!"

# ch/gen_full/battle_of_the_bands.rpy:1346
translate russian battle_of_the_bands_round_one_3fa43f3c:
    sasha.say "Я думала, что уже сказала!"

# ch/gen_full/battle_of_the_bands.rpy:1350
translate russian battle_of_the_bands_round_one_7dc80e20:
    "Взгляды обращаются ко мне: все ждут моего мнения."

# ch/gen_full/battle_of_the_bands.rpy:1353
translate russian battle_of_the_bands_round_one_cdac1268:
    mike.say "Рискну предположить, что я забыл, потому что был занят мыслями о необходимости краситься и надевать платье!"

# ch/gen_full/battle_of_the_bands.rpy:1354
translate russian battle_of_the_bands_round_one_096292e6:
    mike.say "Если я с этим справлюсь, вы трое хотя бы можете сыграть со мной два концерта!"

# ch/gen_full/battle_of_the_bands.rpy:1358
translate russian battle_of_the_bands_round_one_f97b7c22:
    "Все трое хихикают: мысль обо мне в женском образе отвлекает их от предстоящего."

# ch/gen_full/battle_of_the_bands.rpy:1363
translate russian battle_of_the_bands_round_one_a8122cb7:
    mike.say "Может, она и говорила, но мы давно на взводе. Наверное, не отложилось."

# ch/gen_full/battle_of_the_bands.rpy:1366
translate russian battle_of_the_bands_round_one_fe6d4f82:
    anna.say "У меня до сих пор голова кругом!"

# ch/gen_full/battle_of_the_bands.rpy:1368
translate russian battle_of_the_bands_round_one_a5549340:
    kleio.say "А, плевать! Мы готовы хоть к одному концерту, хоть к сотне."

# ch/gen_full/battle_of_the_bands.rpy:1371
translate russian battle_of_the_bands_round_one_65c2af0c:
    mike.say "Не знаю... По-моему, разницы нет."

# ch/gen_full/battle_of_the_bands.rpy:1375
translate russian battle_of_the_bands_round_one_5bc00224:
    kleio.say "Господи, можно быть ещё бесполезнее?"

# ch/gen_full/battle_of_the_bands.rpy:1377
translate russian battle_of_the_bands_round_one_16365b83:
    sasha.say "Что бы вы ни думали, концертов всё равно два."

# ch/gen_full/battle_of_the_bands.rpy:1379
translate russian battle_of_the_bands_round_one_bca63b0a:
    mike.say "А как же то, что мы одна грёбаная группа?!"

# ch/gen_full/battle_of_the_bands.rpy:1383
translate russian battle_of_the_bands_round_one_e120c571:
    sasha.say "Да ёб вашу мать, я же сказала, что предупреждала вас, придурки!"

# ch/gen_full/battle_of_the_bands.rpy:1385
translate russian battle_of_the_bands_round_one_1b0c9a1f:
    anna.say "Эй, ребята... Не думаю, что сейчас стоит ссориться."

# ch/gen_full/battle_of_the_bands.rpy:1391
translate russian battle_of_the_bands_round_one_8d7a0f3a:
    "После этой небольшой заминки мы теснимся в отведённой гримёрке и с волнением ждём вызова."

# ch/gen_full/battle_of_the_bands.rpy:1392
translate russian battle_of_the_bands_round_one_75fbfbfc:
    "Разговаривать никому не хочется, а музыка остальных групп доносится настолько глухо, что почти ничего не разобрать."

# ch/gen_full/battle_of_the_bands.rpy:1393
translate russian battle_of_the_bands_round_one_445caefb:
    "Когда нас зовут, мы почти крадёмся на сцену, ослеплённые светом и ошеломлённые размером толпы."

# ch/gen_full/battle_of_the_bands.rpy:1397
translate russian battle_of_the_bands_round_one_1185a41b:
    kleio.say "Мы Deathless Harpies! Мы пришли выиграть этот конкурс, но сначала завоюем ваши сердца!"

# ch/gen_full/battle_of_the_bands.rpy:1407
translate russian battle_of_the_bands_round_one_781455ae:
    "И мы начинаем: каждый словно забывает о нервах и играет свою партию."

# ch/gen_full/battle_of_the_bands.rpy:1408
translate russian battle_of_the_bands_round_one_4a2213d2:
    "Атмосфера захватывает меня, и вскоре я пробуждаю внутреннего бога рока самыми безумными движениями."

# ch/gen_full/battle_of_the_bands.rpy:1412
translate russian battle_of_the_bands_round_one_bfac7ea9:
    "Платье и макияж почему-то только добавляют уверенности, пока я стараюсь покорить сцену."

# ch/gen_full/battle_of_the_bands.rpy:1413
translate russian battle_of_the_bands_round_one_74d6154c:
    "Рост и эффектный женский образ делают меня куда более заметным."

# ch/gen_full/battle_of_the_bands.rpy:1414
translate russian battle_of_the_bands_round_one_500b5aef:
    "Не знаю, считают меня женщиной или переодетым парнем, но в любом случае публика в восторге."

# ch/gen_full/battle_of_the_bands.rpy:1419
translate russian battle_of_the_bands_round_one_f23f0470:
    "Я невольно вспоминаю движения Ангуса Янга, Слэша и, возможно, даже Найджела Тафнела."

# ch/gen_full/battle_of_the_bands.rpy:1420
translate russian battle_of_the_bands_round_one_9f56806b:
    "Повторяю их и добавляю свои, расхаживая по сцене с гитарой."

# ch/gen_full/battle_of_the_bands.rpy:1421
translate russian battle_of_the_bands_round_one_b9d39b67:
    "Остановившись лицом к залу, слышу, как публика восторженно реагирует на мои позы."

# ch/gen_full/battle_of_the_bands.rpy:1424
translate russian battle_of_the_bands_round_one_ab60cf81:
    "Я знаю, что должны делать ноги, пока остальное тело играет на гитаре."

# ch/gen_full/battle_of_the_bands.rpy:1425
translate russian battle_of_the_bands_round_one_6987d4d6:
    "Но они словно не понимают указаний и живут своей жизнью."

# ch/gen_full/battle_of_the_bands.rpy:1426
translate russian battle_of_the_bands_round_one_de63a184:
    "В какой-то момент ноги путаются в проводах, я падаю и едва не срываю всю песню."

# ch/gen_full/battle_of_the_bands.rpy:1430
translate russian battle_of_the_bands_round_one_7e89f081:
    "Песня за песней наш список тает, время выходит, и мы начинаем последний номер."

# ch/gen_full/battle_of_the_bands.rpy:1435
translate russian battle_of_the_bands_round_one_b5753d14:
    "Все выкладываются до конца, но мне всё кажется, что чего-то не хватает."

# ch/gen_full/battle_of_the_bands.rpy:1437
translate russian battle_of_the_bands_round_one_a20a5b61:
    "Я подхожу к микрофону Клео и присоединяюсь к её пению ради эффектного финала."

# ch/gen_full/battle_of_the_bands.rpy:1439
translate russian battle_of_the_bands_round_one_885e885b:
    "Я втискиваюсь к Клео и её микрофону, начиная петь вместе с ней."

# ch/gen_full/battle_of_the_bands.rpy:1440
translate russian battle_of_the_bands_round_one_6e0132a3:
    "Сначала она удивляется, но через секунду публика принимает идею, и Клео приходит в себя, почти не выдав потрясения."

# ch/gen_full/battle_of_the_bands.rpy:1441
translate russian battle_of_the_bands_round_one_5f842313:
    "Наверное, контраст высокого парня в платье и девушки пониже, такой суровой и колючей, как Клео, просто работает."

# ch/gen_full/battle_of_the_bands.rpy:1442
translate russian battle_of_the_bands_round_one_5438b89d:
    "Клео полностью завладевает остатком песни, и я невольно любуюсь исходящими от неё силой и сексуальностью."

# ch/gen_full/battle_of_the_bands.rpy:1445
translate russian battle_of_the_bands_round_one_88266caa:
    "Мой внезапный подход удивляет Клео, но она не сбивается ни на долю, когда я встаю рядом и начинаю петь."

# ch/gen_full/battle_of_the_bands.rpy:1446
translate russian battle_of_the_bands_round_one_55cac544:
    "Может, дело в часах репетиций, а может, в чём-то более близком, но мы мгновенно сливаемся в дуэт."

# ch/gen_full/battle_of_the_bands.rpy:1447
translate russian battle_of_the_bands_round_one_777f0188:
    "Мой голос поддерживает и дополняет Клео, помогая ей превзойти себя. Мы завершаем песню вокальной дуэлью, искрящейся сексуальным напряжением."

# ch/gen_full/battle_of_the_bands.rpy:1450
translate russian battle_of_the_bands_round_one_c616e03d:
    "Клео сразу теряется, когда я без предупреждения подхожу и делю с ней микрофон."

# ch/gen_full/battle_of_the_bands.rpy:1451
translate russian battle_of_the_bands_round_one_8fe3904b:
    "Она сбивается, теряет сосредоточенность и, пытаясь вернуться в ритм, яростно бьёт меня локтем в живот."

# ch/gen_full/battle_of_the_bands.rpy:1452
translate russian battle_of_the_bands_round_one_24b84be4:
    "Остаётся кое-как дотянуть песню, проклиная себя за выходку, которая могла стоить нам конкурса."

# ch/gen_full/battle_of_the_bands.rpy:1455
translate russian battle_of_the_bands_round_one_14e42902:
    "После выступления мы нетерпеливо ждём, пока доиграют последние группы и объявят результаты."

# ch/gen_full/battle_of_the_bands.rpy:1456
translate russian battle_of_the_bands_round_one_ca668a04:
    "Когда ведущий выходит на сцену, мы все затаиваем дыхание."

# ch/gen_full/battle_of_the_bands.rpy:1458
translate russian battle_of_the_bands_round_one_6d5b80ba:
    "Сквозь гул толпы и разговоры музыкантов за кулисами мы слышим Deathless Harpies среди прошедших в финал."

# ch/gen_full/battle_of_the_bands.rpy:1459
translate russian battle_of_the_bands_round_one_d6cee923:
    "Получилось! У нас ещё есть шанс выиграть весь конкурс!"

# ch/gen_full/battle_of_the_bands.rpy:1463
translate russian battle_of_the_bands_round_one_68ae8ada:
    "Мы ждём до последнего названия, но Deathless Harpies так и не звучит."

# ch/gen_full/battle_of_the_bands.rpy:1464
translate russian battle_of_the_bands_round_one_baa8b53d:
    "Похоже, мы оказались недостаточно хороши и завтра вечером сюда не вернёмся."

# ch/gen_full/battle_of_the_bands.rpy:1466
translate russian battle_of_the_bands_round_one_5792535e:
    "Мы молча покидаем площадку, всё ещё во власти эмоций и адреналина."

# ch/gen_full/battle_of_the_bands.rpy:1467
translate russian battle_of_the_bands_round_one_f71d1c75:
    "Кажется, никто не ожидал такого исхода, и никто не знает, что принесёт завтра."

# ch/gen_full/battle_of_the_bands.rpy:1475
translate russian first_gig_12320d26:
    "До «Битвы групп» оставалась буквально неделя. Я думал, что напряжение уже достигло предела."

# ch/gen_full/battle_of_the_bands.rpy:1476
translate russian first_gig_47ae63ef:
    "Но тут Саша вдруг появилась в репетиционной и огорошила нас новостью."

# ch/gen_full/battle_of_the_bands.rpy:1478
translate russian first_gig_cbe715c9:
    sasha.say "Хватайте вещи, ребята! У нас концерт!"

# ch/gen_full/battle_of_the_bands.rpy:1480
translate russian first_gig_365733dd:
    anna.say "А?"

# ch/gen_full/battle_of_the_bands.rpy:1482
translate russian first_gig_8da8475f:
    kleio.say "Какого чёрта?!"

# ch/gen_full/battle_of_the_bands.rpy:1483
translate russian first_gig_05afe39a:
    mike.say "Саша, ты о чём? Настоящий концерт?"

# ch/gen_full/battle_of_the_bands.rpy:1485
translate russian first_gig_52744915:
    sasha.say "Нет, ненастоящий. Перед картонными зрителями!"

# ch/gen_full/battle_of_the_bands.rpy:1487
translate russian first_gig_f4bfcc6f:
    sasha.say "Конечно, настоящий."

# ch/gen_full/battle_of_the_bands.rpy:1489
translate russian first_gig_0d5bd98f:
    "Клео с таким шумом носилась по комнате, что почти заглушала собственную ругань."

# ch/gen_full/battle_of_the_bands.rpy:1491
translate russian first_gig_224bcbc2:
    "Анна, наоборот, молча сидела за барабанами. Но её лицо выдавало страх перед внезапным концертом."

# ch/gen_full/battle_of_the_bands.rpy:1493
translate russian first_gig_82e2df8c:
    sasha.say "Да ладно вам! Отличная возможность применить всю нашу практику... на практике!"

# ch/gen_full/battle_of_the_bands.rpy:1494
translate russian first_gig_62e4fe99:
    sasha.say "Если мы не можем выступить сейчас, то как выступим через неделю?"

# ch/gen_full/battle_of_the_bands.rpy:1497
translate russian first_gig_4e62cf3e:
    "Саша выжидающе смотрит на меня. И тут я замечаю, что Клео и Анна тоже."

# ch/gen_full/battle_of_the_bands.rpy:1498
translate russian first_gig_9209916a:
    "Клео уже устроила привычную истерику, Анна, как всегда, притихла, а я ещё не высказался."

# ch/gen_full/battle_of_the_bands.rpy:1502
translate russian first_gig_8b67cad5:
    mike.say "Да, неожиданно. Но лови момент и всякая такая хрень! Давайте выступим!"

# ch/gen_full/battle_of_the_bands.rpy:1505
translate russian first_gig_6eb57e65:
    "Саша рада моей поддержке, но Клео и Анна всё ещё не убеждены."

# ch/gen_full/battle_of_the_bands.rpy:1506
translate russian first_gig_1c8c6219:
    mike.say "Вы можете в себя не верить, но я верю. Клео, Анна, сегодня вы отлично сыграли всё, что мы репетировали."

# ch/gen_full/battle_of_the_bands.rpy:1507
translate russian first_gig_9022ea0b:
    mike.say "Давайте схватим этот концерт за шкирку и будем трясти, пока он не взмолится о пощаде!"

# ch/gen_full/battle_of_the_bands.rpy:1510
translate russian first_gig_5c37fb8e:
    mike.say "Честно, Саша, ставить нас перед фактом — так себе поступок."

# ch/gen_full/battle_of_the_bands.rpy:1512
translate russian first_gig_7cc35177:
    "Саша слегка задета: она явно надеялась на большую поддержку."

# ch/gen_full/battle_of_the_bands.rpy:1513
translate russian first_gig_a4a70077:
    mike.say "Но я не пытаюсь обосрать тебя или саму идею. Думаю, мы справимся и, наверное, должны попробовать."

# ch/gen_full/battle_of_the_bands.rpy:1514
translate russian first_gig_930d20a7:
    mike.say "Просто хотелось бы знать заранее, чтобы хотя бы подготовиться."

# ch/gen_full/battle_of_the_bands.rpy:1517
translate russian first_gig_a4eb059f:
    mike.say "Да ёб твою мать, Саша! Будто нам и так проблем мало?!"

# ch/gen_full/battle_of_the_bands.rpy:1519
translate russian first_gig_0a1bd8e4:
    "Саша удивляется моему напору, а затем её лицо мрачнеет."

# ch/gen_full/battle_of_the_bands.rpy:1521
translate russian first_gig_8e9477a0:
    mike.say "Мы все поглощены репетициями, а теперь нужно резко переключиться и выступать перед живой публикой?"

# ch/gen_full/battle_of_the_bands.rpy:1526
translate russian first_gig_53cf0cc9:
    "Вдруг Клео и Анна прекращают жаловаться и начинают хитро поглядывать на меня, подмигивать и посмеиваться."

# ch/gen_full/battle_of_the_bands.rpy:1528
translate russian first_gig_226a268e:
    "Саша тоже веселеет, поняв причину их забавы."

# ch/gen_full/battle_of_the_bands.rpy:1529
translate russian first_gig_354def42:
    mike.say "Погодите. Вы же не рассчитываете, что я выйду на концерт в женской одежде?"

# ch/gen_full/battle_of_the_bands.rpy:1531
translate russian first_gig_38aa5b5e:
    sasha.say "Это ведь генеральная репетиция в костюмах, [lssb_common.hero_name()]."

# ch/gen_full/battle_of_the_bands.rpy:1532
translate russian first_gig_3e9861b7:
    kleio.say "Ага! Так что в твоём случае — репетиция в платье!"

# ch/gen_full/battle_of_the_bands.rpy:1533
translate russian first_gig_0ab5f795:
    "Я уже паникую от мысли о переодевании перед незнакомцами. Но хотя бы моя неловкость на время примирила девушек."

# ch/gen_full/battle_of_the_bands.rpy:1540
translate russian first_gig_a55f465d:
    sasha.say "Ладно, хватит. Нужно отнести всё вниз и загрузить в фургон. ПРЯМО СЕЙЧАС!"

# ch/gen_full/battle_of_the_bands.rpy:1541
translate russian first_gig_b61c3c23:
    "Мы суетимся, собирая инструменты и аппаратуру, и хотя бы ненадолго забываем о нервах и взаимных упрёках."

# ch/gen_full/battle_of_the_bands.rpy:1542
translate russian first_gig_3c5782d9:
    "Не проходит и пятнадцати минут, как мы, запыхавшиеся и потные, уже сидим в фургоне со всем необходимым."

# ch/gen_full/battle_of_the_bands.rpy:1546
translate russian first_gig_a1b20ceb:
    anna.say "Ой, Саша, ты не сказала, куда мы едем."

# ch/gen_full/battle_of_the_bands.rpy:1548
translate russian first_gig_cf60ec1c:
    sasha.say "В «Лидмилл». Парень с моего курса знаком с управляющим, а тому срочно нужна группа на замену."

# ch/gen_full/battle_of_the_bands.rpy:1550
translate russian first_gig_d0e63040:
    kleio.say "Ого, там суровая публика... Слышала, вокалиста одной группы стащили со сцены и отметелили: решили, что он отстой."

# ch/gen_full/battle_of_the_bands.rpy:1551
translate russian first_gig_b6791e42:
    mike.say "ЧТО?!"

# ch/gen_full/battle_of_the_bands.rpy:1553
translate russian first_gig_f82e79ec:
    sasha.say "Не паникуй, [lssb_common.hero_name()]. Это просто городская легенда."

# ch/gen_full/battle_of_the_bands.rpy:1555
translate russian first_gig_6e2651d4:
    mike.say "Ты так говоришь, Саша... Но если они так поступают с плохими музыкантами, что сделают, узнав, что я парень в колготках и набитом лифчике?"

# ch/gen_full/battle_of_the_bands.rpy:1556
translate russian first_gig_a66bc74d:
    sasha.say "Я же сказала, не переживай. Свет будет таким ярким, что даже ты в платье покажешься красавицей."

# ch/gen_full/battle_of_the_bands.rpy:1566
translate russian first_gig_439235d7:
    "С Клео за рулём мы приезжаем с запасом времени. Поездка встряхнула нас почти так же сильно, как новость о концерте."

# ch/gen_full/battle_of_the_bands.rpy:1567
translate russian first_gig_7c554af6:
    "Переодеваться приходится на ходу в задней части фургона: я борюсь с нарядом рокерши, кувыркаясь среди незакреплённой аппаратуры."

# ch/gen_full/battle_of_the_bands.rpy:1570
translate russian first_gig_bddf2f61:
    "К счастью, на площадке есть пара рабочих сцены. Они разгружают аппаратуру, а мы идём в крошечную гримёрку: название группы на двери написано маркером на чём-то вроде салфетки."

# ch/gen_full/battle_of_the_bands.rpy:1572
translate russian first_gig_906927bd:
    "Сотрудник объясняет: мы заменяем вторую группу на разогреве. Главную группу я не знаю, но девушки воодушевлённо кивают — им она знакома."

# ch/gen_full/battle_of_the_bands.rpy:1573
translate russian first_gig_aa1b2a5f:
    "Время пролетает незаметно, и вот мы уже стоим за кулисами, ожидая выхода."

# ch/gen_full/battle_of_the_bands.rpy:1577
translate russian first_gig_3e91f49b:
    kleio.say "Привет... Мы Deathless Harpies, и сейчас у вас пойдёт кровь из ушей!"

# ch/gen_full/battle_of_the_bands.rpy:1579
translate russian first_gig_345163e9:
    "Как только начинаю играть, все оставшиеся переживания из-за женского образа отходят на второй план."

# ch/gen_full/battle_of_the_bands.rpy:1585
translate russian first_gig_35cd472c:
    "Жажда выступления берёт верх, и эта одежда вдруг начинает странным образом раскрепощать."

# ch/gen_full/battle_of_the_bands.rpy:1586
translate russian first_gig_f4a13c5d:
    "Не знаю, кого во мне видит публика — мужчину или женщину. Эта неопределённость освобождает и позволяет говорить музыке."

# ch/gen_full/battle_of_the_bands.rpy:1587
translate russian first_gig_ba40d762:
    "Мой энтузиазм словно передаётся девушкам. Они начинают играть лучше, и результат слышен сразу."

# ch/gen_full/battle_of_the_bands.rpy:1588
translate russian first_gig_fea24991:
    "Только закончив выступление и сойдя со сцены, я вспоминаю, во что одет, и начинаю возвращаться на землю."

# ch/gen_full/battle_of_the_bands.rpy:1598
translate russian first_gig_7236a56b:
    kleio.say "Всем привет! Ну как вы тут, чёрт возьми?"

# ch/gen_full/battle_of_the_bands.rpy:1599
translate russian first_gig_714eec09:
    kleio.say "Мы Deathless Harpies и пришли вас развлечь!"

# ch/gen_full/battle_of_the_bands.rpy:1601
translate russian first_gig_38b43b4c:
    "Не знаю, откуда у Клео берутся эти слова, но они сразу заводят зал."

# ch/gen_full/battle_of_the_bands.rpy:1607
translate russian first_gig_f6f53cc8:
    "Остальное выступление проходит как в тумане: всё сходится, мы становимся единым целым, большим, чем сумма отдельных музыкантов."

# ch/gen_full/battle_of_the_bands.rpy:1608
translate russian first_gig_d5e35cf4:
    "Адреналин берёт верх, и каждый играет так, словно от этого зависит жизнь."

# ch/gen_full/battle_of_the_bands.rpy:1609
translate russian first_gig_e7800da1:
    "Мы сходим со сцены мокрые и измотанные, но от приветственных криков улыбаемся, как четыре клоуна."

# ch/gen_full/battle_of_the_bands.rpy:1613
translate russian first_gig_d54a5148:
    kleio.say "Мы Deathless Harpies, и... мы... мы здесь, чтобы играть рок."

# ch/gen_full/battle_of_the_bands.rpy:1615
translate russian first_gig_abb1ef72:
    "Представляя нас, Клео запинается, и её волнение быстро передаётся всем на сцене."

# ch/gen_full/battle_of_the_bands.rpy:1621
translate russian first_gig_47a5de25:
    "Мы начинаем неуверенно, и это заметно. Но неоднозначная реакция публики почему-то подстёгивает."

# ch/gen_full/battle_of_the_bands.rpy:1622
translate russian first_gig_93673e47:
    "Мы с Сашей, Клео и Анной вспоминаем, где и когда вступать. Старания каждого помогают нам снова собраться в настоящую группу."

# ch/gen_full/battle_of_the_bands.rpy:1623
translate russian first_gig_6cc728e1:
    "Уходя со сцены после выступления, мы не празднуем. Но кивки и улыбки говорят: что-то всё же удалось спасти."

# ch/gen_full/battle_of_the_bands.rpy:1627
translate russian first_gig_1c5e8b8c:
    kleio.say "Привет всем сучкам и шовинистическим свиньям!"

# ch/gen_full/battle_of_the_bands.rpy:1628
translate russian first_gig_c5a6ec6d:
    kleio.say "Мы Deathless Harpies, ваши будущие кумиры!"

# ch/gen_full/battle_of_the_bands.rpy:1630
translate russian first_gig_7a0254ee:
    "Слова Клео падают камнем: публика смотрит ошеломлённо и даже ругается, хотя мы ещё не начали играть."

# ch/gen_full/battle_of_the_bands.rpy:1636
translate russian first_gig_62a84423:
    "Негатив передаётся остальным, и мы словно забываем, для чего вообще нужны инструменты."

# ch/gen_full/battle_of_the_bands.rpy:1637
translate russian first_gig_462a6a8d:
    "В каждой песне кто-нибудь лажает. Под конец мы почти бегом уходим со сцены, лишь бы не слышать свист."

# ch/gen_full/battle_of_the_bands.rpy:1639
translate russian first_gig_e0fbbff6:
    "Мы молча возвращаемся в гримёрку, пока рабочие грузят оборудование обратно в фургон."

# ch/gen_full/battle_of_the_bands.rpy:1640
translate russian first_gig_7a3004a0:
    "Все явно на взводе после концерта. Саша и Клео выглядят так, будто готовы поделиться впечатлениями."

# ch/gen_full/battle_of_the_bands.rpy:1650
translate russian first_gig_c26e6472:
    "Но почему-то мы невольно молчим, пока не остаёмся одни в фургоне по дороге в репетиционную."

# ch/gen_full/battle_of_the_bands.rpy:1657
translate russian first_gig_1e62fac6:
    sasha.say "Итак, что-то хорошо, что-то плохо. До конкурса есть над чем поработать."

# ch/gen_full/battle_of_the_bands.rpy:1659
translate russian first_gig_ded979df:
    kleio.say "Ловко ты обходишь слона в фургоне, Саша!"

# ch/gen_full/battle_of_the_bands.rpy:1660
translate russian first_gig_38ea5c45:
    "Я хмурюсь, не понимая Клео, но тут слышу хихиканье Анны рядом."

# ch/gen_full/battle_of_the_bands.rpy:1662
translate russian first_gig_b82f9754:
    anna.say "Она о тебе, [lssb_common.hero_name()]... Ты ведь забыл переодеться!"

# ch/gen_full/battle_of_the_bands.rpy:1663
translate russian first_gig_edcdb985:
    "Я с искренним удивлением смотрю вниз и впервые замечаю, что всё ещё в женской одежде."

# ch/gen_full/battle_of_the_bands.rpy:1664
translate russian first_gig_70330150:
    mike.say "Чёрт... Видимо, забыл в суете после концерта!"

# ch/gen_full/battle_of_the_bands.rpy:1666
translate russian first_gig_f35d0484:
    anna.say "Как скажешь! Не переживай, по-моему, ты так очень мило выглядишь!"

# ch/gen_full/battle_of_the_bands.rpy:1668
translate russian first_gig_f67f675e:
    kleio.say "Ага, рядом с такой страшилой, как ты, мы все сразу в десять раз красивее!"

# ch/gen_full/battle_of_the_bands.rpy:1669
translate russian first_gig_246c0847:
    sasha.say "Не слушай её. По-моему, ты отлично справился, и это даже добавило группе изюминку."

# ch/gen_full/battle_of_the_bands.rpy:1679
translate russian first_gig_119b3204:
    sasha.say "Вот видите! Я говорила, что нам это нужно!"

# ch/gen_full/battle_of_the_bands.rpy:1681
translate russian first_gig_67e82c24:
    kleio.say "Господи, Саша... Только не зазнавайся!"

# ch/gen_full/battle_of_the_bands.rpy:1683
translate russian first_gig_0bec4cde:
    anna.say "Ого, Клео не бросается тебе на горло. Значит, считает, что ты права, Саша!"

# ch/gen_full/battle_of_the_bands.rpy:1685
translate russian first_gig_eabefa29:
    "Я смеюсь: Анна умеет расшифровывать грубость Клео и угадывать её настоящий смысл."

# ch/gen_full/battle_of_the_bands.rpy:1686
translate russian first_gig_94dd15cd:
    "В эту минуту я чувствую нежность ко всем троим, видя, как проступают их лучшие стороны."

# ch/gen_full/battle_of_the_bands.rpy:1687
translate russian first_gig_a5f6f04e:
    mike.say "Скажу прямо: девчонки, вы были потрясающие... По-моему, мы все были."

# ch/gen_full/battle_of_the_bands.rpy:1697
translate russian first_gig_20ef032e:
    sasha.say "Не скажу, что нельзя было лучше, но в целом хорошего было больше, чем плохого."

# ch/gen_full/battle_of_the_bands.rpy:1698
translate russian first_gig_629bc775:
    kleio.say "Хм... Ну да... Наверное, ты права."

# ch/gen_full/battle_of_the_bands.rpy:1699
translate russian first_gig_fd8babc9:
    kleio.say "Только в следующий раз предупреждай, прежде чем такое устраивать, ладно?"

# ch/gen_full/battle_of_the_bands.rpy:1701
translate russian first_gig_bd0ee6c0:
    anna.say "Ну что ж, всем снова за работу!"

# ch/gen_full/battle_of_the_bands.rpy:1702
translate russian first_gig_dda2cf87:
    "Все устали, чьё-то самолюбие сильно пострадало, но я улыбаюсь: в конце концов мы всё-таки справились."

# ch/gen_full/battle_of_the_bands.rpy:1712
translate russian first_gig_7054b11c:
    sasha.say "Скажу прямо, Клео: что это за херня была в начале выступления?"

# ch/gen_full/battle_of_the_bands.rpy:1714
translate russian first_gig_be9048a0:
    kleio.say "Теперь каждое слово с тобой согласовывать?"

# ch/gen_full/battle_of_the_bands.rpy:1715
translate russian first_gig_74587dc1:
    sasha.say "Если собираешься нести такой бред, то, возможно, да!"

# ch/gen_full/battle_of_the_bands.rpy:1717
translate russian first_gig_cb9a0b92:
    anna.say "Ну, по-моему..."

# ch/gen_full/battle_of_the_bands.rpy:1722
translate russian first_gig_cc4dd589:
    "Слова Анны тонут в перепалке Саши и Клео из-за провального концерта."

# ch/gen_full/battle_of_the_bands.rpy:1723
translate russian first_gig_d2e90ade:
    "Кажется, нужно вмешаться, заступиться за Анну или хотя бы попросить их прекратить."

# ch/gen_full/battle_of_the_bands.rpy:1724
translate russian first_gig_253ad382:
    "Но я настолько устал и подавлен паршивым выступлением, что просто смотрю в окно на проплывающие фонари."

# ch/gen_full/battle_of_the_bands.rpy:1726
translate russian first_gig_452fb49c:
    "Потом на всех опускается странная усталая тишина. Никто не говорит, пока фургон не останавливается у репетиционной."

# ch/gen_full/battle_of_the_bands.rpy:1727
translate russian first_gig_21cdbeab:
    "Наверное, каждый обдумывает концерт и то, что он значит для нас в преддверии конкурса."

# ch/gen_full/events.rpy:51
translate russian ryan_bus_b87f1148:
    "Буквально несколько секунд назад я просто шёл по улице по своим делам."

# ch/gen_full/events.rpy:52
translate russian ryan_bus_b6700e0e:
    "Честно говоря, в голове почти ничего не было, кроме пути к цели."

# ch/gen_full/events.rpy:53
translate russian ryan_bus_0c3985e1:
    "И тут впереди, у пешеходного перехода, я замечаю знакомое лицо."

# ch/gen_full/events.rpy:55
translate russian ryan_bus_4764ba19:
    "Райан..."

# ch/gen_full/events.rpy:56
translate russian ryan_bus_35b91891:
    "Обычно один вид этого парня вызывает во мне раздражение и ревность."

# ch/gen_full/events.rpy:57
translate russian ryan_bus_bda9d323:
    "Я давно его терпеть не могу за то, как он изменял Сэм."

# ch/gen_full/events.rpy:58
translate russian ryan_bus_14bb9a2f:
    "Но это было до того, как я узнал о фотографиях, которые этот урод прятал на чердаке."

# ch/gen_full/events.rpy:59
translate russian ryan_bus_cc26fca5:
    "Теперь я знаю, что Райан не просто мерзкий изменщик."

# ch/gen_full/events.rpy:60
translate russian ryan_bus_c33026fa:
    "Он ещё и серьёзно больной ублюдок!"

# ch/gen_full/events.rpy:61
translate russian ryan_bus_5e4cd7f0:
    "Сейчас он стоит всего в паре метров от меня."

# ch/gen_full/events.rpy:62
translate russian ryan_bus_55cb6bf3:
    "И всё его внимание приковано к пешеходному светофору."

# ch/gen_full/events.rpy:63
translate russian ryan_bus_8bc21c18:
    "Почти уверен, он меня вообще не заметил."

# ch/gen_full/events.rpy:64
translate russian ryan_bus_8fc11111:
    "Это радует: можно просто пройти мимо."

# ch/gen_full/events.rpy:65
translate russian ryan_bus_e7d038b4:
    "И даже не придётся выбирать — притворяться другом или выяснять отношения!"

# ch/gen_full/events.rpy:66
translate russian ryan_bus_d5137e24:
    "Примерно в этот момент я замечаю автобус, приближающийся к нам по улице."

# ch/gen_full/events.rpy:67
translate russian ryan_bus_0a8575a9:
    "Внезапно в голове возникает мысль."

# ch/gen_full/events.rpy:68
translate russian ryan_bus_69b7ce37:
    "Достаточно одного лёгкого толчка в нужный момент."

# ch/gen_full/events.rpy:69
translate russian ryan_bus_575600a7:
    "Водитель автобуса никак не успеет остановиться."

# ch/gen_full/events.rpy:70
translate russian ryan_bus_5075aa01:
    "Если всё сделать точно, никто даже не поймёт, что я его толкнул."

# ch/gen_full/events.rpy:71
translate russian ryan_bus_f12f166f:
    "Решат, что он споткнулся и упал на дорогу."

# ch/gen_full/events.rpy:72
translate russian ryan_bus_2e1a6522:
    "Или шагнул под машину, не посмотрев."

# ch/gen_full/events.rpy:73
translate russian ryan_bus_86e4ab0a:
    "Один толчок — и с Райаном покончено."

# ch/gen_full/events.rpy:74
translate russian ryan_bus_7be307a7:
    "Сэм избавится от него, и он больше не причинит вреда ни одной девушке."

# ch/gen_full/events.rpy:78
translate russian ryan_bus_1fef394b:
    "Я снова смотрю на автобус, затем на Райана."

# ch/gen_full/events.rpy:79
translate russian ryan_bus_d25b1a14:
    "Автобус уже почти поравнялся с ним."

# ch/gen_full/events.rpy:80
translate russian ryan_bus_9cc54d0e:
    "Ещё несколько секунд — и проедет мимо..."

# ch/gen_full/events.rpy:83
translate russian ryan_bus_791a71d2:
    "Прежде чем совесть успевает вмешаться, я действую."

# ch/gen_full/events.rpy:84
translate russian ryan_bus_b0cc08c0:
    "Петляя сквозь толпу, я резко подаюсь к Райану."

# ch/gen_full/events.rpy:85
translate russian ryan_bus_71370fe6:
    "Достаточно толчка локтем в поясницу."

# ch/gen_full/events.rpy:87
translate russian ryan_bus_626e0185:
    ryan.say "Ах..."

# ch/gen_full/events.rpy:89
translate russian ryan_bus_32e8fb5c:
    ryan.say "Чт..."

# ch/gen_full/events.rpy:90
translate russian ryan_bus_6fda9512:
    "Я не останавливаюсь, чтобы посмотреть, получилось ли."

# ch/gen_full/events.rpy:93
translate russian ryan_bus_10582e3a:
    "Продолжаю идти, прислушиваясь к происходящему позади."

# ch/gen_full/events.rpy:94
translate russian ryan_bus_47e62552:
    "И тут слышу громкий гудок и визг тормозов."

# ch/gen_full/events.rpy:99
translate russian ryan_bus_63addabc:
    "Но к человеческому воплю следом я не готов."

# ch/gen_full/events.rpy:100
translate russian ryan_bus_d9831199:
    "А к жуткому хрусту — и подавно!"

# ch/gen_full/events.rpy:102
translate russian ryan_bus_de1a6ef4:
    "И всё же я не останавливаюсь и не оглядываюсь, пока не отхожу подальше от места преступления."

# ch/gen_full/events.rpy:103
translate russian ryan_bus_758491d9:
    "Лишь у следующего угла решаюсь остановиться и взглянуть назад."

# ch/gen_full/events.rpy:104
translate russian ryan_bus_77b52d5d:
    "Автобус стоит прямо на переходе, вокруг суетятся люди."

# ch/gen_full/events.rpy:105
translate russian ryan_bus_0590d79d:
    "Они столпились так тесно, что я не вижу, что стало с Райаном."

# ch/gen_full/events.rpy:106
translate russian ryan_bus_306342bd:
    "Но по ужасу на их лицах понимаю: всё плохо."

# ch/gen_full/events.rpy:107
translate russian ryan_bus_7e710b07:
    "Некоторые даже снимают на телефоны!"

# ch/gen_full/events.rpy:108
translate russian ryan_bus_59976c64:
    "Значит, скоро это будет во всех соцсетях."

# ch/gen_full/events.rpy:109
translate russian ryan_bus_727edff0:
    "Я сворачиваю за угол и торопливо ухожу, опустив голову."

# ch/gen_full/events.rpy:110
translate russian ryan_bus_831dc1d4:
    "Я отчасти ожидал, что сейчас почувствую вину."

# ch/gen_full/events.rpy:111
translate russian ryan_bus_581868bd:
    "Но на самом деле чувствую облегчение."

# ch/gen_full/events.rpy:112
translate russian ryan_bus_b0b49d97:
    "Теперь никому больше не нужно беспокоиться из-за Райана."

# ch/gen_full/events.rpy:113
translate russian ryan_bus_fd5bf22d:
    "И вдобавок всё выглядит несчастным случаем."

# ch/gen_full/events.rpy:114
translate russian ryan_bus_1bf4d765:
    "А понадобился лишь толчок в нужную сторону."

# ch/gen_full/events.rpy:117
translate russian ryan_bus_60fffc0e:
    "О чём я, чёрт возьми, думаю?"

# ch/gen_full/events.rpy:118
translate russian ryan_bus_8b1b0366:
    "Да, Райан оказался ещё большим мерзавцем, чем я мог представить."

# ch/gen_full/events.rpy:119
translate russian ryan_bus_aca6b7d1:
    "Но кем стану я, если убью его?"

# ch/gen_full/events.rpy:120
translate russian ryan_bus_affa3e6e:
    "Как смогу смотреть Сэм в глаза, зная, что сделал?"

# ch/gen_full/events.rpy:121
translate russian ryan_bus_9d09a640:
    "Я замираю посреди тротуара."

# ch/gen_full/events.rpy:122
translate russian ryan_bus_25e67996:
    "Через мгновение автобус проносится мимо."

# ch/gen_full/events.rpy:123
translate russian ryan_bus_4928210a:
    "Стоящих у перехода людей обдаёт порывом воздуха."

# ch/gen_full/events.rpy:124
translate russian ryan_bus_e75a127f:
    "Но никто не сдвигается с места."

# ch/gen_full/events.rpy:125
translate russian ryan_bus_9ca8e6f5:
    "Ещё через секунду для них загорается зелёный."

# ch/gen_full/events.rpy:129
translate russian ryan_bus_b41aed5b:
    "Я смотрю, как Райан переходит улицу и скрывается из виду."

# ch/gen_full/events.rpy:130
translate russian ryan_bus_392d3959:
    "Он никогда не узнает, насколько близок сегодня был к страшному концу."

# ch/gen_full/events.rpy:131
translate russian ryan_bus_b1bbc313:
    "Но я рад, что вовремя опомнился."

# ch/gen_full/events.rpy:132
translate russian ryan_bus_4c6fb138:
    "Уходя, я чувствую слабость в ногах и лёгкое головокружение."

# ch/gen_full/events.rpy:133
translate russian ryan_bus_f935a5e6:
    "Я чуть не сделал это."

# ch/gen_full/events.rpy:134
translate russian ryan_bus_80426906:
    "Чуть не толкнул его под автобус!"

# ch/gen_full/events.rpy:135
translate russian ryan_bus_6ad63cdc:
    "Но нужно помнить: я не довёл дело до конца."

# ch/gen_full/events.rpy:136
translate russian ryan_bus_7bb9f403:
    "Что-то остановило меня."

# ch/gen_full/events.rpy:137
translate russian ryan_bus_16a03913:
    "Хочется верить, что совесть."

# ch/gen_full/events.rpy:138
translate russian ryan_bus_73be427f:
    "Или страх за то, как это повлияло бы на отношения с Сэм."

# ch/gen_full/events.rpy:139
translate russian ryan_bus_52587cda:
    "Чёрт, я даже согласен считать это простой трусостью!"

# ch/gen_full/events.rpy:140
translate russian ryan_bus_218cbf48:
    "Всё лучше, чем оказаться способным убить человека!"

# ch/gen_full/events.rpy:145
translate russian ayesha_emma_event_01_6bb74de4:
    "Заходя в кофейню, я всегда словно включаю автопилот."

# ch/gen_full/events.rpy:146
translate russian ayesha_emma_event_01_8504d556:
    "Я ведь знаю это место как свои пять пальцев и точно знаю, чего хочу."

# ch/gen_full/events.rpy:147
translate russian ayesha_emma_event_01_4b1b5864:
    "Бариста тоже меня знают и всегда готовят мой заказ."

# ch/gen_full/events.rpy:148
translate russian ayesha_emma_event_01_cfbd47b7:
    "Обычно даже от телефона отрываться почти не приходится."

# ch/gen_full/events.rpy:149
translate russian ayesha_emma_event_01_b60d98d9:
    "Я бурчу что-то смутно дружелюбное и прикладываю телефон для оплаты."

# ch/gen_full/events.rpy:150
translate russian ayesha_emma_event_01_32d71412:
    "Потом протягиваю руку, хватаю кофе и ухожу."

# ch/gen_full/events.rpy:151
translate russian ayesha_emma_event_01_bff06191:
    "Только сегодня хватаю вовсе не свой кофе."

# ch/gen_full/events.rpy:152
translate russian ayesha_emma_event_01_4e2a93bf:
    emma.say "Эй!"

# ch/gen_full/events.rpy:154
translate russian ayesha_emma_event_01_41cf77c8:
    emma.say "Какого чёрта?!"

# ch/gen_full/events.rpy:155
translate russian ayesha_emma_event_01_d7b515fe:
    emma.say "Ты зачем меня хватаешь?!"

# ch/gen_full/events.rpy:156
translate russian ayesha_emma_event_01_e0b7f606:
    mike.say "А... что..."

# ch/gen_full/events.rpy:158
translate russian ayesha_emma_event_01_d88378e8:
    "Я стряхиваю оцепенение и поднимаю глаза."

# ch/gen_full/events.rpy:159
translate russian ayesha_emma_event_01_c492fc14:
    "Только теперь замечаю, что держу чужую руку."

# ch/gen_full/events.rpy:160
translate russian ayesha_emma_event_01_8cbd014b:
    "Она обхватывает стакан, который я принял за свой!"

# ch/gen_full/events.rpy:161
translate russian ayesha_emma_event_01_c4286a7c:
    "Проследив взглядом вдоль руки, я тут же отпускаю её."

# ch/gen_full/events.rpy:163
translate russian ayesha_emma_event_01_ff182c16:
    "Это рука Эммы, и она явно удивлена."

# ch/gen_full/events.rpy:164
translate russian ayesha_emma_event_01_b408e128:
    mike.say "Ой, Эмма..."

# ch/gen_full/events.rpy:165
translate russian ayesha_emma_event_01_f7c9e754:
    mike.say "Прости, пожалуйста!"

# ch/gen_full/events.rpy:166
translate russian ayesha_emma_event_01_4b55cf31:
    mike.say "Я думал, это мой флэт уайт с двойным эспрессо на совсем обезжиренном молоке!"

# ch/gen_full/events.rpy:168
translate russian ayesha_emma_event_01_82edc184:
    emma.say "А вот и нет, [lssb_common.hero_name()]!"

# ch/gen_full/events.rpy:169
translate russian ayesha_emma_event_01_a7ae926c:
    emma.say "Это МОЙ флэт уайт с двойным эспрессо на совсем обезжиренном молоке!"

# ch/gen_full/events.rpy:170
translate russian ayesha_emma_event_01_9b09dc3a:
    emma.say "Тут моё имя написано, видишь?"

# ch/gen_full/events.rpy:171
translate russian ayesha_emma_event_01_5a211841:
    emma.say "Я знаю, что он мой, потому что больше никто такого не заказывает!"

# ch/gen_full/events.rpy:173
translate russian ayesha_emma_event_01_ad1e1881:
    "Едва произнеся это, Эмма понимает свою ошибку."

# ch/gen_full/events.rpy:174
translate russian ayesha_emma_event_01_bd657ec1:
    mike.say "Ну... кроме меня!"

# ch/gen_full/events.rpy:175
translate russian ayesha_emma_event_01_5727d12e:
    mike.say "И я схватил его ровно по той же причине!"

# ch/gen_full/events.rpy:176
translate russian ayesha_emma_event_01_8eb46ab6:
    mike.say "Эм... странно и неловко получилось, да?"

# ch/gen_full/events.rpy:178
translate russian ayesha_emma_event_01_a0641200:
    "Эмма смягчается, её щёки краснеют."

# ch/gen_full/events.rpy:180
translate russian ayesha_emma_event_01_3dffa977:
    "Она прикрывает рот ладонями и хихикает."

# ch/gen_full/events.rpy:181
translate russian ayesha_emma_event_01_8fc6b830:
    "И выглядит при этом невероятно мило!"

# ch/gen_full/events.rpy:182
translate russian ayesha_emma_event_01_079db344:
    emma.say "Не знаю, [lssb_common.hero_name()]."

# ch/gen_full/events.rpy:183
translate russian ayesha_emma_event_01_c3aa97eb:
    emma.say "Может, это скорее судьба?"

# ch/gen_full/events.rpy:184
translate russian ayesha_emma_event_01_eab87d1d:
    emma.say "Ну как ещё два человека могут заказывать что-то настолько специфическое?"

# ch/gen_full/events.rpy:185
translate russian ayesha_emma_event_01_bd736c80:
    mike.say "Да уж, да уж..."

# ch/gen_full/events.rpy:186
translate russian ayesha_emma_event_01_26614e57:
    mike.say "Может, займём столик и выпьем кофе здесь?"

# ch/gen_full/events.rpy:187
translate russian ayesha_emma_event_01_a3da6e3d:
    mike.say "Я никуда не тороплюсь и был бы рад компании."

# ch/gen_full/events.rpy:189
translate russian ayesha_emma_event_01_104fb6dd:
    emma.say "Хорошо, [lssb_common.hero_name()]."

# ch/gen_full/events.rpy:190
translate russian ayesha_emma_event_01_274822a0:
    emma.say "С удовольствием!"

# ch/gen_full/events.rpy:193
translate russian ayesha_emma_event_01_5b51e81a:
    "Я хочу произвести на Эмму хорошее впечатление."

# ch/gen_full/events.rpy:194
translate russian ayesha_emma_event_01_5e31da20:
    "Поэтому решаю поступить как джентльмен и заплатить."

# ch/gen_full/events.rpy:195
translate russian ayesha_emma_event_01_3f32708c:
    mike.say "Я оплачу кофе, Эмма."

# ch/gen_full/events.rpy:196
translate russian ayesha_emma_event_01_bbfd2ee9:
    mike.say "Ты ведь уже почтила меня своей компанией."

# ch/gen_full/events.rpy:197
translate russian ayesha_emma_event_01_b2321c0c:
    mike.say "Если ты не против?"

# ch/gen_full/events.rpy:199
translate russian ayesha_emma_event_01_fe5065ac:
    "Эмма немного удивляется такому жесту."

# ch/gen_full/events.rpy:200
translate russian ayesha_emma_event_01_4fcd45f9:
    "Потом кивает и улыбается."

# ch/gen_full/events.rpy:201
translate russian ayesha_emma_event_01_104fb6dd_1:
    emma.say "Хорошо, [lssb_common.hero_name()]."

# ch/gen_full/events.rpy:203
translate russian ayesha_emma_event_01_ded42b38:
    emma.say "В этот раз можешь заплатить."

# ch/gen_full/events.rpy:204
translate russian ayesha_emma_event_01_e03d94d0:
    emma.say "Но не думай, что я беспомощная маленькая женщина!"

# ch/gen_full/events.rpy:205
translate russian ayesha_emma_event_01_442c9160:
    emma.say "В следующий раз платим пополам, ладно?"

# ch/gen_full/events.rpy:206
translate russian ayesha_emma_event_01_8af8016a:
    "Я киваю и улыбаюсь, довольный, что смог её убедить."

# ch/gen_full/events.rpy:208
translate russian ayesha_emma_event_01_87574055:
    "Значит, можно быть джентльменом и при этом правильно относиться к современной девушке!"

# ch/gen_full/events.rpy:211
translate russian ayesha_emma_event_01_a02e01cd:
    "На этот раз я беру свой кофе и киваю на свободный столик."

# ch/gen_full/events.rpy:212
translate russian ayesha_emma_event_01_d06a6891:
    "Эмма на миг медлит, словно ждёт от меня чего-то."

# ch/gen_full/events.rpy:214
translate russian ayesha_emma_event_01_6adc60fb:
    "Но затем кивает и идёт к столику."

# ch/gen_full/events.rpy:215
translate russian ayesha_emma_event_01_b378ff7e:
    "Может, она ожидала, что я предложу оплатить её кофе."

# ch/gen_full/events.rpy:217
translate russian ayesha_emma_event_01_fc5cfa78:
    "И, возможно, это было бы по-джентльменски."

# ch/gen_full/events.rpy:218
translate russian ayesha_emma_event_01_193e61b7:
    "Но она современная девушка, а современные девушки вполне самостоятельны."

# ch/gen_full/events.rpy:219
translate russian ayesha_emma_event_01_3f4e630a:
    "Надеюсь, она и меня сочтёт современным парнем."

# ch/gen_full/events.rpy:220
translate russian ayesha_emma_event_01_08d99df6:
    "А не просто невоспитанным скрягой!"

# ch/gen_full/events.rpy:225
translate russian ayesha_emma_event_01_607a18a6:
    "Мы с Эммой садимся за столик, уже вовсю болтая."

# ch/gen_full/events.rpy:226
translate russian ayesha_emma_event_01_30e9b27a:
    "Это один из тех разговоров обо всём и ни о чём."

# ch/gen_full/events.rpy:227
translate russian ayesha_emma_event_01_9f99529e:
    "После такого едва вспомнишь, что именно обсуждали."

# ch/gen_full/events.rpy:229
translate russian ayesha_emma_event_01_a3b66726:
    "Но нам так хорошо, что я почти не замечаю, как меняется освещение."

# ch/gen_full/events.rpy:230
translate russian ayesha_emma_event_01_591ebb11:
    "Только что было довольно светло, а теперь мы в тени."

# ch/gen_full/events.rpy:231
translate russian ayesha_emma_event_01_cbf2418b:
    "Я поднимаю глаза, думая, что кто-то закрыл жалюзи."

# ch/gen_full/events.rpy:232
translate russian ayesha_emma_event_01_199f2aad:
    "Или снаружи припарковался грузовик и заслонил солнце."

# ch/gen_full/events.rpy:237
translate russian ayesha_emma_event_01_b3970fd1:
    ayesha.say "Привет, [lssb_common.hero_name()]."

# ch/gen_full/events.rpy:238
translate russian ayesha_emma_event_01_872b76a4:
    ayesha.say "Какая встреча!"

# ch/gen_full/events.rpy:239
translate russian ayesha_emma_event_01_cc18d9ab:
    mike.say "Айша!"

# ch/gen_full/events.rpy:240
translate russian ayesha_emma_event_01_d6bfffbb:
    mike.say "Прости, я тебя не заметил!"

# ch/gen_full/events.rpy:242
translate russian ayesha_emma_event_01_79bd550f:
    "От моего объяснения Айша слегка хмурится."

# ch/gen_full/events.rpy:243
translate russian ayesha_emma_event_01_dd14ba4d:
    "Что вполне понятно, учитывая её внушительные габариты."

# ch/gen_full/events.rpy:244
translate russian ayesha_emma_event_01_92db3b94:
    "Но через мгновение она, кажется, забывает об этом и смотрит на Эмму."

# ch/gen_full/events.rpy:246
translate russian ayesha_emma_event_01_6ad597ef:
    ayesha.say "Ну что, представишь меня?"

# ch/gen_full/events.rpy:247
translate russian ayesha_emma_event_01_b9ce0b29:
    mike.say "Конечно... конечно..."

# ch/gen_full/events.rpy:248
translate russian ayesha_emma_event_01_e7a346cc:
    mike.say "Эмма, это Айша."

# ch/gen_full/events.rpy:249
translate russian ayesha_emma_event_01_2a1f389f:
    mike.say "Айша, это Эмма."

# ch/gen_full/events.rpy:250
translate russian ayesha_emma_event_01_7f672a75:
    ayesha.say "Привет, Эмма! Рада познакомиться!"

# ch/gen_full/events.rpy:252
translate russian ayesha_emma_event_01_3a21fb15:
    "Эмма отрывается от кофе и смотрит по сторонам."

# ch/gen_full/events.rpy:253
translate russian ayesha_emma_event_01_138807f9:
    "На её лице то же недоумение, что только что было у меня."

# ch/gen_full/events.rpy:254
translate russian ayesha_emma_event_01_4ac9d180:
    emma.say "А?!"

# ch/gen_full/events.rpy:256
translate russian ayesha_emma_event_01_51299b52:
    emma.say "Кто это сказал?"

# ch/gen_full/events.rpy:257
translate russian ayesha_emma_event_01_7d6b4366:
    ayesha.say "Эм... я."

# ch/gen_full/events.rpy:259
translate russian ayesha_emma_event_01_e7f7aaed:
    ayesha.say "Привет... я здесь, наверху."

# ch/gen_full/events.rpy:260
translate russian ayesha_emma_event_01_931de1a7:
    "Я наблюдаю, как Эмма поворачивается на голос Айши."

# ch/gen_full/events.rpy:262
translate russian ayesha_emma_event_01_992930e6:
    "И вздрагивает, поняв, что та возвышается прямо над ней."

# ch/gen_full/events.rpy:263
translate russian ayesha_emma_event_01_1ee77181:
    emma.say "Ого!"

# ch/gen_full/events.rpy:264
translate russian ayesha_emma_event_01_02c1e76e:
    emma.say "Я тебя не заметила, Айша!"

# ch/gen_full/events.rpy:265
translate russian ayesha_emma_event_01_205e8a08:
    emma.say "Приняла за часть стены!"

# ch/gen_full/events.rpy:266
translate russian ayesha_emma_event_01_380220e2:
    "Айша смотрит на меня, потом снова на Эмму."

# ch/gen_full/events.rpy:268
translate russian ayesha_emma_event_01_7af82d09:
    "Вижу, это замечание её несколько ошарашило."

# ch/gen_full/events.rpy:269
translate russian ayesha_emma_event_01_d40142d0:
    ayesha.say "А, да... спасибо, Эмма!"

# ch/gen_full/events.rpy:271
translate russian ayesha_emma_event_01_8cb823e6:
    ayesha.say "Меня постоянно путают с архитектурой..."

# ch/gen_full/events.rpy:272
translate russian ayesha_emma_event_01_266c411e:
    emma.say "Ой, правда?"

# ch/gen_full/events.rpy:274
translate russian ayesha_emma_event_01_f5768b37:
    emma.say "Наверное, неловко получается!"

# ch/gen_full/events.rpy:275
translate russian ayesha_emma_event_01_e03ed951:
    emma.say "Но ты ТАКАЯ большая! Прямо великанша!"

# ch/gen_full/events.rpy:276
translate russian ayesha_emma_event_01_bf765853:
    emma.say "Кем ты работаешь?"

# ch/gen_full/events.rpy:277
translate russian ayesha_emma_event_01_1c3a3867:
    emma.say "Ты тяжелоатлетка?"

# ch/gen_full/events.rpy:278
translate russian ayesha_emma_event_01_99c85209:
    "Айша искоса смотрит на меня с понимающей улыбкой."

# ch/gen_full/events.rpy:279
translate russian ayesha_emma_event_01_764c5a7d:
    "Ясно, что она ждёт, когда я расскажу Эмме подробности."

# ch/gen_full/events.rpy:282
translate russian ayesha_emma_event_01_104ef506:
    "Айша ведь не только профессионально занимается рестлингом."

# ch/gen_full/events.rpy:283
translate russian ayesha_emma_event_01_4b3c6ac8:
    "Но это, пожалуй, самое необычное и интересное в её жизни."

# ch/gen_full/events.rpy:284
translate russian ayesha_emma_event_01_a7111563:
    "И я хочу представить её Эмме в хорошем свете."

# ch/gen_full/events.rpy:285
translate russian ayesha_emma_event_01_fd2c19b0:
    "Начну с этого — посмотрим, что выйдет."

# ch/gen_full/events.rpy:286
translate russian ayesha_emma_event_01_2e68de80:
    mike.say "Айша — профессиональная рестлерша, Эмма!"

# ch/gen_full/events.rpy:287
translate russian ayesha_emma_event_01_50437383:
    mike.say "Поэтому она такая амазонка!"

# ch/gen_full/events.rpy:288
translate russian ayesha_emma_event_01_d8616768:
    mike.say "Надирает задницы в спандексе."

# ch/gen_full/events.rpy:289
translate russian ayesha_emma_event_01_ce0056f8:
    mike.say "И на ринге выглядит потрясающе!"

# ch/gen_full/events.rpy:291
translate russian ayesha_emma_event_01_918c0d34:
    "Айша смеётся и отмахивается."

# ch/gen_full/events.rpy:292
translate russian ayesha_emma_event_01_713027c8:
    "Вижу, она пытается умерить мои похвалы."

# ch/gen_full/events.rpy:293
translate russian ayesha_emma_event_01_2dca3e03:
    "Но при этом широко мне улыбается."

# ch/gen_full/events.rpy:294
translate russian ayesha_emma_event_01_8aea52d9:
    "Словно втайне наслаждается тем, как я восхищаюсь её способностями."

# ch/gen_full/events.rpy:297
translate russian ayesha_emma_event_01_56071f80:
    "Мне почему-то неловко признаться, что Айша занимается рестлингом."

# ch/gen_full/events.rpy:298
translate russian ayesha_emma_event_01_25be3118:
    "Но ведь это не единственное её занятие?"

# ch/gen_full/events.rpy:299
translate russian ayesha_emma_event_01_db3ff1aa:
    mike.say "Айша — персональный тренер, Эмма."

# ch/gen_full/events.rpy:300
translate russian ayesha_emma_event_01_2a9f5186:
    mike.say "И ещё занимается смешанными единоборствами."

# ch/gen_full/events.rpy:301
translate russian ayesha_emma_event_01_7ff7f7c9:
    mike.say "Она отлично научит тебя защищаться!"

# ch/gen_full/events.rpy:303
translate russian ayesha_emma_event_01_59a7daeb:
    emma.say "Ничего себе!"

# ch/gen_full/events.rpy:305
translate russian ayesha_emma_event_01_f0a0917b:
    ayesha.say "А ещё я профессиональная рестлерша."

# ch/gen_full/events.rpy:307
translate russian ayesha_emma_event_01_a283346a:
    ayesha.say "О чём [lssb_common.hero_name()] предпочёл умолчать!"

# ch/gen_full/events.rpy:310
translate russian ayesha_emma_event_01_ec08e064:
    emma.say "Не может быть, Айша!"

# ch/gen_full/events.rpy:312
translate russian ayesha_emma_event_01_2035f1ec:
    emma.say "Это ТАК круто!"

# ch/gen_full/events.rpy:313
translate russian ayesha_emma_event_01_fe45dbf0:
    emma.say "Неудивительно, что ты такая большая."

# ch/gen_full/events.rpy:314
translate russian ayesha_emma_event_01_0192cb60:
    emma.say "Тебя, наверное, не остановить!"

# ch/gen_full/events.rpy:316
translate russian ayesha_emma_event_01_0fa09d6f:
    "Айша качает головой, стараясь казаться скромной."

# ch/gen_full/events.rpy:318
translate russian ayesha_emma_event_01_8535d743:
    "На неискушённую Эмму это, скорее всего, действует."

# ch/gen_full/events.rpy:319
translate russian ayesha_emma_event_01_00961584:
    "А вот я вижу её насквозь."

# ch/gen_full/events.rpy:320
translate russian ayesha_emma_event_01_8f81d8f8:
    "Айша — прирождённая артистка, но и на похвалу падкая."

# ch/gen_full/events.rpy:321
translate russian ayesha_emma_event_01_69ad7ef0:
    "Сейчас Эмма невероятно льстит её самолюбию."

# ch/gen_full/events.rpy:322
translate russian ayesha_emma_event_01_cbd10315:
    "Может, мне стоит помочь разговору..."

# ch/gen_full/events.rpy:325
translate russian ayesha_emma_event_01_00f8e8f2:
    mike.say "Серьёзно, Эмма..."

# ch/gen_full/events.rpy:326
translate russian ayesha_emma_event_01_e562bc2a:
    mike.say "Тебе нужно увидеть Айшу в настоящем матче."

# ch/gen_full/events.rpy:327
translate russian ayesha_emma_event_01_807f1b72:
    mike.say "Она потрясающая! Полностью владеет рингом!"

# ch/gen_full/events.rpy:328
translate russian ayesha_emma_event_01_b2068550:
    "Эмма с энтузиазмом кивает."

# ch/gen_full/events.rpy:329
translate russian ayesha_emma_event_01_d9651052:
    emma.say "Звучит здорово!"

# ch/gen_full/events.rpy:331
translate russian ayesha_emma_event_01_4c443200:
    emma.say "Когда сможем сходить?"

# ch/gen_full/events.rpy:332
translate russian ayesha_emma_event_01_7654ded9:
    emma.say "Айша, когда у тебя следующее шоу?"

# ch/gen_full/events.rpy:333
translate russian ayesha_emma_event_01_dee378f2:
    ayesha.say "Ну..."

# ch/gen_full/events.rpy:335
translate russian ayesha_emma_event_01_4d4bc9fd:
    ayesha.say "Через пару дней у нас выступление в спортзале."

# ch/gen_full/events.rpy:336
translate russian ayesha_emma_event_01_8497d78d:
    ayesha.say "Могу достать вам два билета."

# ch/gen_full/events.rpy:338
translate russian ayesha_emma_event_01_5a49dbd0:
    "Эмма снова кивает."

# ch/gen_full/events.rpy:340
translate russian ayesha_emma_event_01_5366ae6d:
    emma.say "Сходим, [lssb_common.hero_name()]?"

# ch/gen_full/events.rpy:341
translate russian ayesha_emma_event_01_bce142d7:
    mike.say "Почему бы и нет, Эмма?"

# ch/gen_full/events.rpy:342
translate russian ayesha_emma_event_01_016c3e01:
    ayesha.say "Хорошо, ребята, я всё устрою."

# ch/gen_full/events.rpy:344
translate russian ayesha_emma_event_01_f133ed6d:
    "Айша напоследок кивает и улыбается."

# ch/gen_full/events.rpy:345
translate russian ayesha_emma_event_01_f4f8145b:
    "Потом выходит из кофейни."

# ch/gen_full/events.rpy:347
translate russian ayesha_emma_event_01_81cedbf8:
    "Мы снова остаёмся вдвоём, но Эмма всё ещё в восторге."

# ch/gen_full/events.rpy:348
translate russian ayesha_emma_event_01_4bc552f1:
    emma.say "Ох, будет ТАК здорово, [lssb_common.hero_name()]!"

# ch/gen_full/events.rpy:350
translate russian ayesha_emma_event_01_740ebba5:
    emma.say "В детстве я смотрела рестлинг."

# ch/gen_full/events.rpy:351
translate russian ayesha_emma_event_01_f274ec83:
    emma.say "Но вживую ни разу не видела."

# ch/gen_full/events.rpy:352
translate russian ayesha_emma_event_01_be23a6f2:
    emma.say "А теперь ещё и с одной из участниц знакома!"

# ch/gen_full/events.rpy:353
translate russian ayesha_emma_event_01_d59e11fa:
    "Я невольно улыбаюсь: энтузиазм Эммы заразителен."

# ch/gen_full/events.rpy:354
translate russian ayesha_emma_event_01_183a077d:
    mike.say "Ты права, Эмма."

# ch/gen_full/events.rpy:355
translate russian ayesha_emma_event_01_a01e9292:
    mike.say "Будет здорово."

# ch/gen_full/events.rpy:356
translate russian ayesha_emma_event_01_acbc41a6:
    mike.say "Уверен, с нашей поддержкой Айша просто не сможет проиграть!"

# ch/gen_full/events.rpy:360
translate russian ayesha_emma_event_01_46e0a5fd:
    mike.say "Айша ещё и отличный преподаватель, Эмма."

# ch/gen_full/events.rpy:361
translate russian ayesha_emma_event_01_ce86aaed:
    mike.say "А ты, похоже, любишь рестлинг."

# ch/gen_full/events.rpy:362
translate russian ayesha_emma_event_01_3f777a20:
    mike.say "Почему бы не попробовать сходить к ней на занятие?"

# ch/gen_full/events.rpy:364
translate russian ayesha_emma_event_01_b4e3553f:
    "От моего предложения глаза Эммы становятся огромными."

# ch/gen_full/events.rpy:365
translate russian ayesha_emma_event_01_1a55605e:
    emma.say "Ой... нет..."

# ch/gen_full/events.rpy:366
translate russian ayesha_emma_event_01_14f1df8a:
    emma.say "Я бы ни за что..."

# ch/gen_full/events.rpy:368
translate russian ayesha_emma_event_01_4c9f3a12:
    emma.say "Я ведь СЛИШКОМ маленькая, чтобы..."

# ch/gen_full/events.rpy:369
translate russian ayesha_emma_event_01_099af965:
    "Айша перебивает, не дав ей закончить."

# ch/gen_full/events.rpy:370
translate russian ayesha_emma_event_01_345643e5:
    "И я уже чувствую, как она берёт разговор в свои руки."

# ch/gen_full/events.rpy:371
translate russian ayesha_emma_event_01_ab845248:
    ayesha.say "Не переживай, Эмма!"

# ch/gen_full/events.rpy:373
translate russian ayesha_emma_event_01_6e42decc:
    ayesha.say "Не все рестлеры такие большие, как я!"

# ch/gen_full/events.rpy:374
translate russian ayesha_emma_event_01_0938f7a4:
    ayesha.say "С твоим телосложением самое место в полутяжёлом весе."

# ch/gen_full/events.rpy:376
translate russian ayesha_emma_event_01_d79bbbfd:
    ayesha.say "Из тебя выйдет отличная любительница воздушных приёмов!"

# ch/gen_full/events.rpy:378
translate russian ayesha_emma_event_01_53719565:
    emma.say "Но я..."

# ch/gen_full/events.rpy:379
translate russian ayesha_emma_event_01_15fd5444:
    ayesha.say "Я внесу тебя в расписание, ладно?"

# ch/gen_full/events.rpy:381
translate russian ayesha_emma_event_01_7e56c92b:
    emma.say "Ну, я не..."

# ch/gen_full/events.rpy:383
translate russian ayesha_emma_event_01_66662a09:
    ayesha.say "Не волнуйся, уже записала!"

# ch/gen_full/events.rpy:385
translate russian ayesha_emma_event_01_4e0b06a6:
    emma.say "А если я..."

# ch/gen_full/events.rpy:386
translate russian ayesha_emma_event_01_f3ffa250:
    ayesha.say "Увидимся на тренировочном ринге!"

# ch/gen_full/events.rpy:387
translate russian ayesha_emma_event_01_eb062b6b:
    "С этими словами Айша радостно уходит."

# ch/gen_full/events.rpy:390
translate russian ayesha_emma_event_01_132a0311:
    "А Эмма смотрит на меня с паникой в глазах."

# ch/gen_full/events.rpy:391
translate russian ayesha_emma_event_01_7009d427:
    emma.say "Ч... что со мной только что произошло?"

# ch/gen_full/events.rpy:392
translate russian ayesha_emma_event_01_c0db49f6:
    mike.say "Кажется, тебя записали на рестлинг, Эмма!"

# ch/gen_full/events.rpy:394
translate russian ayesha_emma_event_01_14a0934c:
    emma.say "Н... но... я не хочу быть рестлершей!"

# ch/gen_full/events.rpy:396
translate russian ayesha_emma_event_01_0fe0d11b:
    mike.say "У меня такое чувство, что выбора у тебя почти нет!"

# dlc_lively/ch/aletta/images.rpy:76
translate russian test_aletta_exps_eb34dbe2:
    "Злость"

# dlc_lively/ch/aletta/images.rpy:80
translate russian test_aletta_exps_4b788da4:
    "Раздражение"

# dlc_lively/ch/aletta/images.rpy:84
translate russian test_aletta_exps_dc38ecae:
