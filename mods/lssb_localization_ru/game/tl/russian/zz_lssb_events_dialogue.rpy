# ch/gen_full/battle_of_the_bands.rpy:1000
translate russian battle_of_the_bands_win_nightclub_21857a5a_1:
    "Я бреду с танцпола, всё ещё сгорая от стыда."

# ch/gen_full/battle_of_the_bands.rpy:1001
translate russian battle_of_the_bands_win_nightclub_23273d2a:
    "Анна и Клео всё это время держат меня за руки и отпускают, лишь когда мы садимся в такси до моего дома."

