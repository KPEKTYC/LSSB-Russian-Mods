# Native Events identifiers, current source catalog. Translation only.

# ch/gen_full/battle_of_the_bands.rpy:138
translate russian battle_of_the_bands_lose_ae2cc141:
    "После конкурса, когда официально объявили, что Deathless Harpies в числе проигравших, никто не проронил ни слова."

# ch/gen_full/battle_of_the_bands.rpy:139
translate russian battle_of_the_bands_lose_b9d3689a:
    "Мы с Сашей, Анной и Клео понуро поплелись за кулисы собирать оборудование. Разочарование висело над нами тучей."

# ch/gen_full/battle_of_the_bands.rpy:140
translate russian battle_of_the_bands_lose_6a9c3c51:
    "Как я ни старался отвлечься, уходя, всё равно видел и слышал, как победители празднуют успех."

# ch/gen_full/battle_of_the_bands.rpy:141
translate russian battle_of_the_bands_lose_1dcdf1ed:
    "Потом мы загрузили фургон и отправились в «Винчестер», словно на автопилоте."

# ch/gen_full/battle_of_the_bands.rpy:147
translate russian battle_of_the_bands_lose_d2f7b428:
    "Усевшись за свободный столик, мы обмениваемся взглядами, которые в этой напряжённой тишине говорят больше любых слов."

# ch/gen_full/battle_of_the_bands.rpy:148
translate russian battle_of_the_bands_lose_befbacf4:
    "Но один за другим мы отводим глаза, качаем головами и что-то бормочем себе под нос."

# ch/gen_full/battle_of_the_bands.rpy:150
translate russian battle_of_the_bands_lose_9452b81c:
    "Только Саша чуть дольше выдерживает мой взгляд, беспомощно улыбаясь."

# ch/gen_full/battle_of_the_bands.rpy:151
translate russian battle_of_the_bands_lose_69fa2ce7:
    "Может, потому, что её я знаю дольше всех."

# ch/gen_full/battle_of_the_bands.rpy:152
translate russian battle_of_the_bands_lose_61e80913:
    "Или потому, что совместная жизнь сделала нашу дружбу особенно близкой."

# ch/gen_full/battle_of_the_bands.rpy:153
translate russian battle_of_the_bands_lose_493111e9:
    "Как бы то ни было, когда она пожимает плечами, мне почему-то становится легче."

# ch/gen_full/battle_of_the_bands.rpy:154
translate russian battle_of_the_bands_lose_34a8f465:
    "Мы заказываем выпивку, чтобы утопить в ней печали, и напряжение понемногу спадает."

# ch/gen_full/battle_of_the_bands.rpy:155
translate russian battle_of_the_bands_lose_d0accdd3:
    "Но кто-то должен набраться духу и первым нарушить молчание."

# ch/gen_full/battle_of_the_bands.rpy:156
translate russian battle_of_the_bands_lose_d3e1fbfc:
    "Мы украдкой переглядываемся через стол, ожидая, кто же это сделает..."

# ch/gen_full/battle_of_the_bands.rpy:158
translate russian battle_of_the_bands_lose_02f61fd9:
    "В конце концов я больше не могу смотреть на унылые лица Саши, Анны и Клео."

# ch/gen_full/battle_of_the_bands.rpy:159
translate russian battle_of_the_bands_lose_77c44c7f:
    "Они столько трудились, столько сил отдали этому делу — видеть их такими невыносимо."

# ch/gen_full/battle_of_the_bands.rpy:160
translate russian battle_of_the_bands_lose_55e55b1a:
    "И я понимаю, что люблю их так сильно, что грудь вот-вот разорвётся."

# ch/gen_full/battle_of_the_bands.rpy:161
translate russian battle_of_the_bands_lose_ea588944:
    mike.say "Знаю, сейчас скажу чертовски банальную вещь."

# ch/gen_full/battle_of_the_bands.rpy:162
translate russian battle_of_the_bands_lose_8cef40f1:
    mike.say "Но вам нечего стыдиться. Совершенно нечего!"

# ch/gen_full/battle_of_the_bands.rpy:163
translate russian battle_of_the_bands_lose_43c8b24c:
    "Анна грустно улыбается, склонив голову набок."

# ch/gen_full/battle_of_the_bands.rpy:165
translate russian battle_of_the_bands_lose_11d909f5:
    anna.say "Ох... спасибо, [lssb_common.hero_name()]!"

# ch/gen_full/battle_of_the_bands.rpy:167
translate russian battle_of_the_bands_lose_a0c21225:
    "А в улыбке Клео гораздо больше горькой иронии."

# ch/gen_full/battle_of_the_bands.rpy:168
translate russian battle_of_the_bands_lose_dbd449c8:
    kleio.say "Мило, сердцеед."

# ch/gen_full/battle_of_the_bands.rpy:171
translate russian battle_of_the_bands_lose_e64176be:
    kleio.say "Но это не меняет того, что мы проиграли!"

# ch/gen_full/battle_of_the_bands.rpy:172
translate russian battle_of_the_bands_lose_ef719d0c:
    "И только теперь Саша решает вступить в разговор."

# ch/gen_full/battle_of_the_bands.rpy:173
translate russian battle_of_the_bands_lose_f70114a9:
    sasha.say "Нет, Клео, он прав."

# ch/gen_full/battle_of_the_bands.rpy:174
translate russian battle_of_the_bands_lose_526f975d:
    sasha.say "Да, мы все понимали, какой это шанс для группы."

# ch/gen_full/battle_of_the_bands.rpy:175
translate russian battle_of_the_bands_lose_39885d7a:
    sasha.say "Но одно поражение — не повод всё бросать."

# ch/gen_full/battle_of_the_bands.rpy:176
translate russian battle_of_the_bands_lose_18c5f8e6:
    "Пока Саша говорит, я поворачиваюсь и смотрю Клео в глаза."

# ch/gen_full/battle_of_the_bands.rpy:177
translate russian battle_of_the_bands_lose_671183ad:
    mike.say "Ты ведь не собираешься уходить, Клео?"

# ch/gen_full/battle_of_the_bands.rpy:179
translate russian battle_of_the_bands_lose_ec5393aa:
    "При одном упоминании об этом Анна встревоженно подаёт голос."

# ch/gen_full/battle_of_the_bands.rpy:181
translate russian battle_of_the_bands_lose_f4808263:
    anna.say "Что ты имеешь в виду, [lssb_common.hero_name()]?"

# ch/gen_full/battle_of_the_bands.rpy:182
translate russian battle_of_the_bands_lose_1155550d:
    anna.say "Клео, ты же не уходишь?!"

# ch/gen_full/battle_of_the_bands.rpy:184
translate russian battle_of_the_bands_lose_6563b86e:
    anna.say "Группа ведь не распадается?!"

# ch/gen_full/battle_of_the_bands.rpy:185
translate russian battle_of_the_bands_lose_ced3ad08:
    "Представив самое худшее, Анна уже чуть ли не плачет."

# ch/gen_full/battle_of_the_bands.rpy:186
translate russian battle_of_the_bands_lose_0bb7bad6:
    "Признаюсь, мне немного стыдно, что я так науськал её на Клео."

# ch/gen_full/battle_of_the_bands.rpy:187
translate russian battle_of_the_bands_lose_84a6f014:
    "Но я уже вижу, как это действует."

# ch/gen_full/battle_of_the_bands.rpy:189
translate russian battle_of_the_bands_lose_20c8a8af:
    kleio.say "Нет... ни за что, Анна!"

# ch/gen_full/battle_of_the_bands.rpy:191
translate russian battle_of_the_bands_lose_94bb6568:
    kleio.say "Я никуда не ухожу, ясно?"

# ch/gen_full/battle_of_the_bands.rpy:192
translate russian battle_of_the_bands_lose_a29e5e2b:
    sasha.say "Успокойся, Анна. Группа не распадается."

# ch/gen_full/battle_of_the_bands.rpy:193
translate russian battle_of_the_bands_lose_51273594:
    mike.say "Мы сильнее этого, девчонки."

# ch/gen_full/battle_of_the_bands.rpy:194
translate russian battle_of_the_bands_lose_fd15d844:
    mike.say "Потому что мы больше, чем просто группа."

# ch/gen_full/battle_of_the_bands.rpy:196
translate russian battle_of_the_bands_lose_3f2f97a1:
    "Я беру за руки Анну и Клео, сидящих по обе стороны от меня."

# ch/gen_full/battle_of_the_bands.rpy:197
translate russian battle_of_the_bands_lose_626082dc:
    "Уловив намёк, они берут за руки Сашу, замыкая круг."

# ch/gen_full/battle_of_the_bands.rpy:198
translate russian battle_of_the_bands_lose_1425fcdd:
    "Да, знаю, выглядит ужасно слащаво."

# ch/gen_full/battle_of_the_bands.rpy:199
translate russian battle_of_the_bands_lose_e2ff2df1:
    "Но плевать: сейчас нам нужно именно это."

# ch/gen_full/battle_of_the_bands.rpy:200
translate russian battle_of_the_bands_lose_fece94ae:
    mike.say "Да здравствуют Deathless Harpies!"

# ch/gen_full/battle_of_the_bands.rpy:202
translate russian battle_of_the_bands_lose_206673a7:
    anna.say "Ура!"

# ch/gen_full/battle_of_the_bands.rpy:204
translate russian battle_of_the_bands_lose_71707181:
    kleio.say "Да, блядь!"

# ch/gen_full/battle_of_the_bands.rpy:206
translate russian battle_of_the_bands_lose_2be268fe:
    sasha.say "Чёрт возьми, да!"

# ch/gen_full/battle_of_the_bands.rpy:208
translate russian battle_of_the_bands_lose_5eb3ddca:
    "Саша глубоко и горестно вздыхает, делая большой глоток."

# ch/gen_full/battle_of_the_bands.rpy:209
translate russian battle_of_the_bands_lose_610c46f6:
    "Она с силой ставит стакан на стол и качает головой."

# ch/gen_full/battle_of_the_bands.rpy:211
translate russian battle_of_the_bands_lose_1fbf2609:
    sasha.say "Да чтоб вас, ребята."

# ch/gen_full/battle_of_the_bands.rpy:212
translate russian battle_of_the_bands_lose_1c6c105a:
    sasha.say "Я была так уверена, что мы всех порвём."

# ch/gen_full/battle_of_the_bands.rpy:214
translate russian battle_of_the_bands_lose_7c92821d:
    anna.say "Да, Саша, я тоже!"

# ch/gen_full/battle_of_the_bands.rpy:216
translate russian battle_of_the_bands_lose_956ee7a6:
    kleio.say "Я тоже ничего не понимаю."

# ch/gen_full/battle_of_the_bands.rpy:217
translate russian battle_of_the_bands_lose_ce2028a6:
    kleio.say "Месяц назад мы бы этих ребят в порошок стёрли!"

# ch/gen_full/battle_of_the_bands.rpy:218
translate russian battle_of_the_bands_lose_1ef58b4d:
    mike.say "Тогда что, чёрт возьми, мы сделали не так?"

# ch/gen_full/battle_of_the_bands.rpy:220
translate russian battle_of_the_bands_lose_55d4f5e0:
    "Анна не находит ответа, Клео тоже качает головой."

# ch/gen_full/battle_of_the_bands.rpy:221
translate russian battle_of_the_bands_lose_0dd97b3a:
    "И тут я замечаю, как Саша хмурится."

# ch/gen_full/battle_of_the_bands.rpy:223
translate russian battle_of_the_bands_lose_0ad2e4ce:
    sasha.say "Может, дело не в том, что мы что-то сделали не так."

# ch/gen_full/battle_of_the_bands.rpy:224
translate russian battle_of_the_bands_lose_dfc393f3:
    sasha.say "А в том, что у нас что-то изменилось?"

# ch/gen_full/battle_of_the_bands.rpy:225
translate russian battle_of_the_bands_lose_25758b0a:
    "Анна и Клео смотрят на Сашу, а потом прослеживают её взгляд."

# ch/gen_full/battle_of_the_bands.rpy:226
translate russian battle_of_the_bands_lose_f96a40dc:
    "Поскольку всё это время она смотрела на меня, теперь я оказываюсь под пристальным взглядом всех троих."

# ch/gen_full/battle_of_the_bands.rpy:227
translate russian battle_of_the_bands_lose_1d9595f5:
    mike.say "На что ты намекаешь, Саша?"

# ch/gen_full/battle_of_the_bands.rpy:228
translate russian battle_of_the_bands_lose_096c8786:
    mike.say "Хочешь сказать, это моя вина?"

# ch/gen_full/battle_of_the_bands.rpy:230
translate russian battle_of_the_bands_lose_adbdf688:
    anna.say "Саша, ты правда так думаешь?"

# ch/gen_full/battle_of_the_bands.rpy:231
translate russian battle_of_the_bands_lose_4ab371dd:
    kleio.say "Да, Саша! А как же «мы одна команда»?!"

# ch/gen_full/battle_of_the_bands.rpy:233
translate russian battle_of_the_bands_lose_e31bb0c2:
    "Неожиданно оказавшись под ударом, Саша поднимает руки, словно защищаясь."

# ch/gen_full/battle_of_the_bands.rpy:234
translate russian battle_of_the_bands_lose_1dc5b9fc:
    sasha.say "Я не обвиняю [lssb_common.hero_name()]. По крайней мере, не его одного."

# ch/gen_full/battle_of_the_bands.rpy:235
translate russian battle_of_the_bands_lose_c2905ac4:
    sasha.say "Но признайте: с его приходом группа изменилась."

# ch/gen_full/battle_of_the_bands.rpy:236
translate russian battle_of_the_bands_lose_d59ee0a9:
    sasha.say "Не могу точно сказать, в чём дело."

# ch/gen_full/battle_of_the_bands.rpy:238
translate russian battle_of_the_bands_lose_10c5586c:
    sasha.say "Просто между вами троими что-то есть."

# ch/gen_full/battle_of_the_bands.rpy:239
translate russian battle_of_the_bands_lose_4541dcac:
    sasha.say "Как будто вы объединились против меня, понимаете?"

# ch/gen_full/battle_of_the_bands.rpy:240
translate russian battle_of_the_bands_lose_948c394d:
    "Скрыть украдкой брошенные взгляды, которыми мы с Анной и Клео обмениваемся, невозможно."

# ch/gen_full/battle_of_the_bands.rpy:241
translate russian battle_of_the_bands_lose_c36bacc9:
    "Но, похоже, это отвечает на вопрос, что крепче: группа или наши отношения!"

# ch/gen_full/battle_of_the_bands.rpy:242
translate russian battle_of_the_bands_lose_2eb78833:
    mike.say "Думаю, тебя просто выбило из колеи поражение, Саша."

# ch/gen_full/battle_of_the_bands.rpy:243
translate russian battle_of_the_bands_lose_d07d5486:
    mike.say "Поэтому всё кажется в десять раз хуже!"

# ch/gen_full/battle_of_the_bands.rpy:244
translate russian battle_of_the_bands_lose_a5c8f915:
    kleio.say "Да, Саша, мы сейчас все не в себе."

# ch/gen_full/battle_of_the_bands.rpy:245
translate russian battle_of_the_bands_lose_c05404a4:
    anna.say "Может, нам вместе переспать?"

# ch/gen_full/battle_of_the_bands.rpy:247
translate russian battle_of_the_bands_lose_a02b1f37:
    anna.say "То есть переспать с этой мыслью! Тебе стоит с ней переспать!"

# ch/gen_full/battle_of_the_bands.rpy:249
translate russian battle_of_the_bands_lose_13e89ab3:
    "Саша недоумённо смотрит на неё, а Клео прожигает взглядом покрасневшую Анну."

# ch/gen_full/battle_of_the_bands.rpy:250
translate russian battle_of_the_bands_lose_a33fee4c:
    "Пытаясь предотвратить полную катастрофу и распад группы, я поднимаю стакан."

# ch/gen_full/battle_of_the_bands.rpy:251
translate russian battle_of_the_bands_lose_fece94ae_1:
    mike.say "Да здравствуют Deathless Harpies!"

# ch/gen_full/battle_of_the_bands.rpy:255
translate russian battle_of_the_bands_lose_13f033cb:
    "Все трое смотрят на меня и поспешно тоже поднимают стаканы."

# ch/gen_full/battle_of_the_bands.rpy:258
translate russian battle_of_the_bands_lose_243ba142:
    "Но, произнося тост, я вижу лишь вину в глазах Анны и Клео."

# ch/gen_full/battle_of_the_bands.rpy:260
translate russian battle_of_the_bands_lose_be0e5ec3:
    "А в глазах Саши растерянность, кажется, сменяется подозрением."

# ch/gen_full/battle_of_the_bands.rpy:263
translate russian battle_of_the_bands_lose_899cd33f:
    "Клео улыбается мне и насмешливо поднимает стакан."

# ch/gen_full/battle_of_the_bands.rpy:264
translate russian battle_of_the_bands_lose_354e975a:
    "По её взгляду я понимаю: сейчас мне достанется по полной."

# ch/gen_full/battle_of_the_bands.rpy:265
translate russian battle_of_the_bands_lose_7588c63c:
    kleio.say "За тебя, сердцеед."

# ch/gen_full/battle_of_the_bands.rpy:266
translate russian battle_of_the_bands_lose_a0814e2c:
    kleio.say "Хоть на что-то твоя правая рука ещё годится!"

# ch/gen_full/battle_of_the_bands.rpy:267
translate russian battle_of_the_bands_lose_a2125caa:
    "Я закатываю глаза, давно привыкнув быть мишенью для колкостей Клео."

# ch/gen_full/battle_of_the_bands.rpy:268
translate russian battle_of_the_bands_lose_42fe4886:
    "Я уже ожидал, что виноватым она назначит меня."

# ch/gen_full/battle_of_the_bands.rpy:269
translate russian battle_of_the_bands_lose_a68e142e:
    "Я новичок в группе, да ещё и парень, так что это было почти неизбежно."

# ch/gen_full/battle_of_the_bands.rpy:270
translate russian battle_of_the_bands_lose_7a1647af:
    sasha.say "Кто бы говорил, Клео."

# ch/gen_full/battle_of_the_bands.rpy:272
translate russian battle_of_the_bands_lose_a4fe3083:
    sasha.say "Если бы ты чаще перебирала струны баса, чем свою киску, всё могло бы закончиться иначе!"

# ch/gen_full/battle_of_the_bands.rpy:273
translate russian battle_of_the_bands_lose_072d73c7:
    "Ответ Саши настолько неожидан, что я совершенно теряюсь."

# ch/gen_full/battle_of_the_bands.rpy:276
translate russian battle_of_the_bands_lose_805edc5c:
    "Вижу, на Анну и Клео он произвёл примерно такое же впечатление!"

# ch/gen_full/battle_of_the_bands.rpy:277
translate russian battle_of_the_bands_lose_89f0585a:
    anna.say "Саша, ты сейчас..."

# ch/gen_full/battle_of_the_bands.rpy:278
translate russian battle_of_the_bands_lose_d28c8e18:
    anna.say "Ты сейчас сказала, что Клео..."

# ch/gen_full/battle_of_the_bands.rpy:279
translate russian battle_of_the_bands_lose_f75f947e:
    anna.say "Что она слишком много себя трогает?!"

# ch/gen_full/battle_of_the_bands.rpy:280
translate russian battle_of_the_bands_lose_9331a6ad:
    "Саша ни на секунду не отводит глаз от Клео."

# ch/gen_full/battle_of_the_bands.rpy:281
translate russian battle_of_the_bands_lose_8039b260:
    "Но всё же кивает в ответ на вопрос Анны."

# ch/gen_full/battle_of_the_bands.rpy:283
translate russian battle_of_the_bands_lose_e477720a:
    sasha.say "Да, Анна, именно это я и сказала."

# ch/gen_full/battle_of_the_bands.rpy:284
translate russian battle_of_the_bands_lose_e255df19:
    sasha.say "Не понимаю, с какой стати она всё валит на [lssb_common.hero_name()]."

# ch/gen_full/battle_of_the_bands.rpy:286
translate russian battle_of_the_bands_lose_ad0e6250:
    "Уже вижу, как Клео готовится огрызнуться и защищаться."

