    "Я закатываю глаза, давно привыкнув быть мишенью для колкостей Клео."

# ch/gen_full/battle_of_the_bands.rpy:431
translate russian battle_of_the_bands_lose_e49da293:
    "Саша по той же причине горько усмехается, не желая клевать на приманку."

# ch/gen_full/battle_of_the_bands.rpy:432
translate russian battle_of_the_bands_lose_4a33dc20:
    "А вот Анна — совсем другое дело."

# ch/gen_full/battle_of_the_bands.rpy:434
translate russian battle_of_the_bands_lose_01a66aad:
    anna.say "Клео, хочешь сказать, что мы проиграли из-за [lssb_common.hero_name()]?"

# ch/gen_full/battle_of_the_bands.rpy:435
translate russian battle_of_the_bands_lose_f82c2c87:
    anna.say "Если да, то это очень подло!"

# ch/gen_full/battle_of_the_bands.rpy:437
translate russian battle_of_the_bands_lose_d6a3bd32:
    kleio.say "Я лишь говорю, что за последнее время у нас изменилось только одно: появился он."

# ch/gen_full/battle_of_the_bands.rpy:438
translate russian battle_of_the_bands_lose_3df4bcbe:
    anna.say "Ничего подобного, Клео! [lssb_common.hero_name()] — наш талисман!"

# ch/gen_full/battle_of_the_bands.rpy:440
translate russian battle_of_the_bands_lose_1d013b1f:
    "Клео злорадно хихикает, забавляясь её наивностью."

# ch/gen_full/battle_of_the_bands.rpy:441
translate russian battle_of_the_bands_lose_f2be452c:
    kleio.say "Да-да, конечно, Анна."

# ch/gen_full/battle_of_the_bands.rpy:442
translate russian battle_of_the_bands_lose_2d0a6918:
    kleio.say "Только приносит он одни несчастья!"

# ch/gen_full/battle_of_the_bands.rpy:444
translate russian battle_of_the_bands_lose_2121c30f:
    anna.say "Эй, Клео!"

# ch/gen_full/battle_of_the_bands.rpy:445
translate russian battle_of_the_bands_lose_4ec8bbad:
    anna.say "Хватит говорить гадости!"

# ch/gen_full/battle_of_the_bands.rpy:447
translate russian battle_of_the_bands_lose_558f061c:
    sasha.say "Она права, Клео."

# ch/gen_full/battle_of_the_bands.rpy:448
translate russian battle_of_the_bands_lose_c4f62eea:
    sasha.say "Мы группа, а значит, держимся вместе."

# ch/gen_full/battle_of_the_bands.rpy:449
translate russian battle_of_the_bands_lose_a14f321f:
    sasha.say "Мы либо побеждаем всей группой, либо вместе проигрываем."

# ch/gen_full/battle_of_the_bands.rpy:450
translate russian battle_of_the_bands_lose_7bc12c0d:
    anna.say "Да, Саша! Один за всех и все за одного."

# ch/gen_full/battle_of_the_bands.rpy:451
translate russian battle_of_the_bands_lose_403c8941:
    anna.say "Слушайте... это не из песни Оззи?"

# ch/gen_full/battle_of_the_bands.rpy:453
translate russian battle_of_the_bands_lose_469786c6:
    "Клео качает головой: нравоучение её явно не убедило."

# ch/gen_full/battle_of_the_bands.rpy:454
translate russian battle_of_the_bands_lose_6aad9327:
    "Но она наконец готова оставить эту тему."

# ch/gen_full/battle_of_the_bands.rpy:456
translate russian battle_of_the_bands_lose_5b982944:
    "Во всяком случае, в ответ не огрызается."

# ch/gen_full/battle_of_the_bands.rpy:457
translate russian battle_of_the_bands_lose_a09bcb6a:
    "И даже очередную глупость Анны оставляет без комментариев."

# ch/gen_full/battle_of_the_bands.rpy:459
translate russian battle_of_the_bands_lose_166b78fb:
    mike.say "Спасибо, что заступаетесь за меня. Я это очень ценю."

# ch/gen_full/battle_of_the_bands.rpy:460
translate russian battle_of_the_bands_lose_5de43d14:
    mike.say "И чувства Клео, кажется, тоже понимаю."

# ch/gen_full/battle_of_the_bands.rpy:461
translate russian battle_of_the_bands_lose_615a4769:
    mike.say "Но можно я сам за себя скажу?"

# ch/gen_full/battle_of_the_bands.rpy:464
translate russian battle_of_the_bands_lose_516731b7:
    "Клео фыркает, Анна удивлённо смотрит на меня, а Саша просто ждёт, что я скажу."

# ch/gen_full/battle_of_the_bands.rpy:465
translate russian battle_of_the_bands_lose_4f664b87:
    mike.say "Думаю, мы рискуем увидеть здесь лишь наполовину пустой стакан."

# ch/gen_full/battle_of_the_bands.rpy:466
translate russian battle_of_the_bands_lose_521c6fd4:
    kleio.say "Скорее, полный до краёв мочи!"

# ch/gen_full/battle_of_the_bands.rpy:467
translate russian battle_of_the_bands_lose_032db4c5:
    anna.say "Да, [lssb_common.hero_name()], мы ведь проиграли."

# ch/gen_full/battle_of_the_bands.rpy:468
translate russian battle_of_the_bands_lose_f79394d7:
    "Только Саша молчит."

# ch/gen_full/battle_of_the_bands.rpy:469
translate russian battle_of_the_bands_lose_dba90574:
    mike.say "Да, Анна, проиграли."

# ch/gen_full/battle_of_the_bands.rpy:470
translate russian battle_of_the_bands_lose_ebc90893:
    mike.say "Но сегодня мы хорошо сыграли перед большой публикой."

# ch/gen_full/battle_of_the_bands.rpy:471
translate russian battle_of_the_bands_lose_d653735d:
    sasha.say "[lssb_common.hero_name()] прав. Стоит порадоваться, что нас услышало столько людей."

# ch/gen_full/battle_of_the_bands.rpy:472
translate russian battle_of_the_bands_lose_9b6fac76:
    sasha.say "Ну проиграли. И что?"

# ch/gen_full/battle_of_the_bands.rpy:473
translate russian battle_of_the_bands_lose_6b3cacf0:
    sasha.say "Теперь всё бросите?"

# ch/gen_full/battle_of_the_bands.rpy:475
translate russian battle_of_the_bands_lose_90bae8e4:
    sasha.say "Я вот не собираюсь. Ни за что!"

# ch/gen_full/battle_of_the_bands.rpy:476
translate russian battle_of_the_bands_lose_143787fe:
    "Анна и Клео ненадолго замолкают, а затем поднимают стаканы в сторону Саши."

# ch/gen_full/battle_of_the_bands.rpy:478
translate russian battle_of_the_bands_lose_ae8b030a:
    anna.say "Я тоже нет!"

# ch/gen_full/battle_of_the_bands.rpy:480
translate russian battle_of_the_bands_lose_8b6e6dfa:
    kleio.say "Хрен там!"

# ch/gen_full/battle_of_the_bands.rpy:481
translate russian battle_of_the_bands_lose_80213419:
    "Все трое смотрят на меня, и я поспешно поднимаю свой стакан."

# ch/gen_full/battle_of_the_bands.rpy:482
translate russian battle_of_the_bands_lose_fece94ae_5:
    mike.say "Да здравствуют Deathless Harpies!"

# ch/gen_full/battle_of_the_bands.rpy:488
translate russian battle_of_the_bands_win_restaurant_d1e4da2a:
    "Я знаю, что это всего лишь местный конкурс: возможность для любительских групп показать свой талант."

# ch/gen_full/battle_of_the_bands.rpy:489
translate russian battle_of_the_bands_win_restaurant_515c9d47:
    "Но с той минуты, когда нас объявляют победителями, мне кажется, что мы покорили весь мир."

# ch/gen_full/battle_of_the_bands.rpy:490
translate russian battle_of_the_bands_win_restaurant_495cd6aa:
    "Судя по тому, как мы радуемся, обнимаемся и поздравляем друг друга, остальные чувствуют то же самое."

# ch/gen_full/battle_of_the_bands.rpy:491
translate russian battle_of_the_bands_win_restaurant_ee0b97bb:
    "Всё, что происходит после конкурса, сливается в череду поздравлений и дружеских похлопываний, пока мы собираем оборудование."

# ch/gen_full/battle_of_the_bands.rpy:492
translate russian battle_of_the_bands_win_restaurant_c99c7beb:
    "Я едва успеваю следить за событиями и вскоре уже сижу в ресторане с головой, идущей кругом."

# ch/gen_full/battle_of_the_bands.rpy:494
translate russian battle_of_the_bands_win_restaurant_592f7cf6:
    "Смутно помню лишь предложение отпраздновать за ужином и то, как я согласно кивнул."

# ch/gen_full/battle_of_the_bands.rpy:495
translate russian battle_of_the_bands_win_restaurant_f4009b64:
    "По правде говоря, мы к этому моменту пустили по кругу уже не одну бутылку."

# ch/gen_full/battle_of_the_bands.rpy:496
translate russian battle_of_the_bands_win_restaurant_825fb9f9:
    "И мой пустой, сжатый от волнения желудок уже чувствует последствия."

# ch/gen_full/battle_of_the_bands.rpy:497
translate russian battle_of_the_bands_win_restaurant_f626e87f:
    "Обычно я бы притормозил и поел, прежде чем столько пить."

# ch/gen_full/battle_of_the_bands.rpy:498
translate russian battle_of_the_bands_win_restaurant_17cd7eba:
    "Но меня всё ещё несёт волна восторга."

# ch/gen_full/battle_of_the_bands.rpy:499
translate russian battle_of_the_bands_win_restaurant_6a5ec9c3:
    "Так что очнуться и начать вести себя разумно сейчас не получится."

# ch/gen_full/battle_of_the_bands.rpy:500
translate russian battle_of_the_bands_win_restaurant_72da0064:
    "К тому же за столом не смолкают разговоры и шутки."

# ch/gen_full/battle_of_the_bands.rpy:501
translate russian battle_of_the_bands_win_restaurant_4c7675a1:
    "Этого достаточно, чтобы махнуть рукой на осторожность и гулять так, словно завтра не наступит."

# ch/gen_full/battle_of_the_bands.rpy:502
translate russian battle_of_the_bands_win_restaurant_3c620b2a:
    "А через мгновение исчезает и последняя надежда осознать, насколько я пьян."

# ch/gen_full/battle_of_the_bands.rpy:503
translate russian battle_of_the_bands_win_restaurant_d93224be:
    "Клео с отвращением бросает меню на стол."

# ch/gen_full/battle_of_the_bands.rpy:508
translate russian battle_of_the_bands_win_restaurant_f6e0588c:
    kleio.say "Фу!"

# ch/gen_full/battle_of_the_bands.rpy:509
translate russian battle_of_the_bands_win_restaurant_556bbc80:
    kleio.say "Слишком уж вычурная хрень."

# ch/gen_full/battle_of_the_bands.rpy:510
translate russian battle_of_the_bands_win_restaurant_2c450199:
    kleio.say "Надо было просто взять шаурму и уже идти в клуб!"

# ch/gen_full/battle_of_the_bands.rpy:512
translate russian battle_of_the_bands_win_restaurant_b0a6eb01:
    "От этого предложения Анна брезгливо морщит нос."

# ch/gen_full/battle_of_the_bands.rpy:513
translate russian battle_of_the_bands_win_restaurant_8a6e44a2:
    anna.say "Фу-у!"

# ch/gen_full/battle_of_the_bands.rpy:514
translate russian battle_of_the_bands_win_restaurant_f5fb5ab7:
    anna.say "Не люблю эту гадость."

# ch/gen_full/battle_of_the_bands.rpy:515
translate russian battle_of_the_bands_win_restaurant_c80822ab:
    anna.say "Мне однажды сказали, что её делают из слоновьей ноги!"

# ch/gen_full/battle_of_the_bands.rpy:519
translate russian battle_of_the_bands_win_restaurant_638ad1f2:
    "Саша и Клео тут же разражаются смехом, и я едва удерживаюсь от того же."

# ch/gen_full/battle_of_the_bands.rpy:520
translate russian battle_of_the_bands_win_restaurant_16e74ff7:
    anna.say "Эй, чего смешного?!"

# ch/gen_full/battle_of_the_bands.rpy:522
translate russian battle_of_the_bands_win_restaurant_62ada0e6:
    sasha.say "Это просто мясные обрезки, Анна."

# ch/gen_full/battle_of_the_bands.rpy:523
translate russian battle_of_the_bands_win_restaurant_9cc72555:
    sasha.say "И куча жирных хрящей."

# ch/gen_full/battle_of_the_bands.rpy:525
translate russian battle_of_the_bands_win_restaurant_2737d47b:
    kleio.say "Да, дурёха, слоны вообще-то вымирают."

# ch/gen_full/battle_of_the_bands.rpy:526
translate russian battle_of_the_bands_win_restaurant_0bf53632:
    kleio.say "Слоновую кость купить нельзя — откуда у шаурмичной возьмётся слоновья нога?!"

# ch/gen_full/battle_of_the_bands.rpy:528
translate russian battle_of_the_bands_win_restaurant_b5c01955:
    "Анна хмурится и скрещивает руки на груди."

# ch/gen_full/battle_of_the_bands.rpy:529
translate russian battle_of_the_bands_win_restaurant_c81d1f2d:
    "Наверное, стоит вмешаться и спасти её от девушек."

# ch/gen_full/battle_of_the_bands.rpy:530
translate russian battle_of_the_bands_win_restaurant_95d0ba13:
    "Но она такая миниатюрная, что в гневе выглядит довольно забавно."

# ch/gen_full/battle_of_the_bands.rpy:532
translate russian battle_of_the_bands_win_restaurant_10d99de4:
    anna.say "Я же не говорила, что поверила!"

# ch/gen_full/battle_of_the_bands.rpy:533
translate russian battle_of_the_bands_win_restaurant_499a0801:
    mike.say "Не переживай, Анна."

# ch/gen_full/battle_of_the_bands.rpy:534
translate russian battle_of_the_bands_win_restaurant_73c5f6b4:
    mike.say "Они просто тебя подкалывают!"

# ch/gen_full/battle_of_the_bands.rpy:536
translate russian battle_of_the_bands_win_restaurant_ae6ee14a:
    "Анна смотрит на меня, и злость в её глазах сменяется удивлением."

# ch/gen_full/battle_of_the_bands.rpy:537
translate russian battle_of_the_bands_win_restaurant_283b9c03:
    anna.say "Правда, [lssb_common.hero_name()]?"

# ch/gen_full/battle_of_the_bands.rpy:538
translate russian battle_of_the_bands_win_restaurant_40eef6ca:
    "Она поворачивается к остальным и смотрит на них такими же широко раскрытыми глазами."

# ch/gen_full/battle_of_the_bands.rpy:539
translate russian battle_of_the_bands_win_restaurant_95b81ba6:
    anna.say "Это правда?"

# ch/gen_full/battle_of_the_bands.rpy:540
translate russian battle_of_the_bands_win_restaurant_431633fa:
    anna.say "Вы шутите?"

# ch/gen_full/battle_of_the_bands.rpy:542
translate russian battle_of_the_bands_win_restaurant_3ec185ca:
    sasha.say "Ох, Анна, тебя так легко разыграть!"

# ch/gen_full/battle_of_the_bands.rpy:544
translate russian battle_of_the_bands_win_restaurant_cef42a76:
    kleio.say "Ага, расслабься, глупышка!"

# ch/gen_full/battle_of_the_bands.rpy:545
translate russian battle_of_the_bands_win_restaurant_a65c2a2c:
    "Ну, пожалуй, большего сходства с извинением от Клео ждать не приходится!"

# ch/gen_full/battle_of_the_bands.rpy:546
translate russian battle_of_the_bands_win_restaurant_519273ed:
    "Я беру меню и прочищаю горло, привлекая внимание остальных."

# ch/gen_full/battle_of_the_bands.rpy:547
translate russian battle_of_the_bands_win_restaurant_c6e3680b:
    mike.say "Кхм!"

# ch/gen_full/battle_of_the_bands.rpy:548
translate russian battle_of_the_bands_win_restaurant_a833ef81:
    mike.say "Может, уже что-нибудь закажем?"

# ch/gen_full/battle_of_the_bands.rpy:549
translate russian battle_of_the_bands_win_restaurant_4423e96b:
    mike.say "Я умираю с голоду, а клуб ждёт!"

# ch/gen_full/battle_of_the_bands.rpy:553
translate russian battle_of_the_bands_win_restaurant_7715b345:
    "Девушки согласно кивают."

# ch/gen_full/battle_of_the_bands.rpy:554
translate russian battle_of_the_bands_win_restaurant_3d6a1b19:
    "Вскоре они уже сосредоточенно изучают меню в пьяной тишине."

# ch/gen_full/battle_of_the_bands.rpy:555
translate russian battle_of_the_bands_win_restaurant_5663d708:
    "Официант принимает заказ, стараясь не показывать раздражения от того, насколько мы пьяны."

# ch/gen_full/battle_of_the_bands.rpy:556
translate russian battle_of_the_bands_win_restaurant_5e160dcc:
    "Но, хотя с едой мы наконец определились, пить никто не перестаёт."

# ch/gen_full/battle_of_the_bands.rpy:557
translate russian battle_of_the_bands_win_restaurant_b29c11a6:
    "Так что, едва еду приносят и мы начинаем есть, её действие сводит на нет новая порция выпивки."

# ch/gen_full/battle_of_the_bands.rpy:559
translate russian battle_of_the_bands_win_restaurant_859d24d3:
    "Наверное, рано или поздно это должно было случиться."

# ch/gen_full/battle_of_the_bands.rpy:560
translate russian battle_of_the_bands_win_restaurant_7c5105d6:
    "Во-первых, мы только что всей группой выиграли важный конкурс."

# ch/gen_full/battle_of_the_bands.rpy:561
translate russian battle_of_the_bands_win_restaurant_284d6f27:
    "А во-вторых, нас связывает не только музыка."

# ch/gen_full/battle_of_the_bands.rpy:562
translate russian battle_of_the_bands_win_restaurant_950cc6d8:
    "Какие уж тут шансы долго держать руки при себе?"

# ch/gen_full/battle_of_the_bands.rpy:563
translate russian battle_of_the_bands_win_restaurant_c534de24:
    "Никто не настолько безумен, чтобы что-то делать над столом."

# ch/gen_full/battle_of_the_bands.rpy:564
translate russian battle_of_the_bands_win_restaurant_671f24d8:
    "А вот под столом — совсем другая история."

# ch/gen_full/battle_of_the_bands.rpy:565
translate russian battle_of_the_bands_win_restaurant_b0b369a2:
    "Мы ещё не съели и половины, а у каждого уже одна рука там."

# ch/gen_full/battle_of_the_bands.rpy:566
translate russian battle_of_the_bands_win_restaurant_5b696e7a:
    "И я чувствую как минимум одну ступню, выскользнувшую из туфли и поглаживающую меня между ног."

# ch/gen_full/battle_of_the_bands.rpy:567
translate russian battle_of_the_bands_win_restaurant_37839c54:
    "Всё идёт отлично: все веселятся и обмениваются многозначительными взглядами."

# ch/gen_full/battle_of_the_bands.rpy:568
translate russian battle_of_the_bands_win_restaurant_27ffb99e:
    "Но тут моя ладонь поднимается по бедру Анны опасно близко к промежности."

# ch/gen_full/battle_of_the_bands.rpy:570
translate russian battle_of_the_bands_win_restaurant_5bc2aea0:
    anna.say "ОЙ, БЛЯДЬ!"

# ch/gen_full/battle_of_the_bands.rpy:571
translate russian battle_of_the_bands_win_restaurant_588c6799:
    "Её испуганный возглас перекрывает ресторанный гул."

# ch/gen_full/battle_of_the_bands.rpy:572
translate russian battle_of_the_bands_win_restaurant_143f5832:
    "Всё словно замирает, и все взгляды разом обращаются к нам."

# ch/gen_full/battle_of_the_bands.rpy:573
translate russian battle_of_the_bands_win_restaurant_41e91762:
    "Никто из нас не произносит ни слова. Мы уставились в тарелки."

# ch/gen_full/battle_of_the_bands.rpy:574
