# ch/gen_full/battle_of_the_bands.rpy:586
translate russian battle_of_the_bands_win_restaurant_98d20f54:
    sasha.say "Ладно, ребята. По-моему, мы легко отделались."

# ch/gen_full/battle_of_the_bands.rpy:588
