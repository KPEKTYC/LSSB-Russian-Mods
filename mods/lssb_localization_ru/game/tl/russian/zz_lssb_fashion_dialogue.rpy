    palla.say "У модели жизнь очень насыщенная!"

# ch/harems_full/fashion/events.rpy:827
translate russian palla_sasha_male_ending_fdf96986:
    sasha.say "Ага, не знала, что быть вешалкой для одежды так тяжело!"

# ch/harems_full/fashion/events.rpy:829
