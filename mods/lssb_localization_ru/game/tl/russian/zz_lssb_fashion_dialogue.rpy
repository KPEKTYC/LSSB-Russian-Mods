# ch/harems_full/fashion/events.rpy:870
translate russian palla_sasha_male_ending_468f4753:
    palla.say "Если бы не [lssb_common.hero_name()], у меня бы не было Мэри."

# ch/harems_full/fashion/events.rpy:872
