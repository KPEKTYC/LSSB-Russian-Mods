    palla.say "Пожалуй."

# ch/harems_full/fashion/events.rpy:803
translate russian palla_sasha_male_ending_1d8a176e:
    palla.say "Он уж точно никогда не пытался меня затмить!"

# ch/harems_full/fashion/events.rpy:804
translate russian palla_sasha_male_ending_a057a42e:
