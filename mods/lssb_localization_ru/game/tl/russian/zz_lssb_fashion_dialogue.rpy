translate russian palla_sasha_male_ending_d860f31b:
    sasha.say "Я тоже постоянно куда-то мотаюсь с группой."

# ch/harems_full/fashion/events.rpy:835
translate russian palla_sasha_male_ending_89fd46bb:
    palla.say "А, да..."

# ch/harems_full/fashion/events.rpy:837
translate russian palla_sasha_male_ending_a0fda468:
    palla.say "Вы уже научились играть без фальши?"

# ch/harems_full/fashion/events.rpy:839
translate russian palla_sasha_male_ending_92d5bd3f:
    sasha.say "Палла!"

# ch/harems_full/fashion/events.rpy:864
translate russian palla_sasha_male_ending_8e4295b2:
    sasha.say "Господи, ты только посмотри на нас!"

# ch/harems_full/fashion/events.rpy:865
translate russian palla_sasha_male_ending_fe2f4cfe:
