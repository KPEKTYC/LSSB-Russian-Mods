# ch/harems_full/fashion/events.rpy:796
translate russian palla_sasha_male_ending_47fdcfe5:
    sasha.say "О нет!"

# ch/harems_full/fashion/events.rpy:798
translate russian palla_sasha_male_ending_5a604697:
    sasha.say "Ума надеть поверх белья хотя бы халат мне хватает!"

# ch/harems_full/fashion/events.rpy:799
translate russian palla_sasha_male_ending_ae7e9be9:
    sasha.say "Но признай, Палла..."

# ch/harems_full/fashion/events.rpy:800
translate russian palla_sasha_male_ending_d5b9005e:
    sasha.say "С ним ведь довольно весело жить, да?"

# ch/harems_full/fashion/events.rpy:801
