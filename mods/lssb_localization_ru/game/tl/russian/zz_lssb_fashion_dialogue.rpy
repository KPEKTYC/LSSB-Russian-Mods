# ch/harems_full/fashion/events.rpy:737
translate russian palla_sasha_male_ending_5de06d69:
    "Мне кажется, кто-нибудь из друзей Паллы объявит, что я слишком немодный."

# ch/harems_full/fashion/events.rpy:738
translate russian palla_sasha_male_ending_67db9e63:
    "Или кто-нибудь из друзей Саши обвинит меня в тайной любви к кей-попу!"

# ch/harems_full/fashion/events.rpy:739
translate russian palla_sasha_male_ending_031674ca:
    "Но, к счастью, все держат рот на замке."

# ch/harems_full/fashion/events.rpy:740
translate russian palla_sasha_male_ending_d00b3666:
    "Священник" "Что ж."

# ch/harems_full/fashion/events.rpy:741
translate russian palla_sasha_male_ending_874b6270:
    "Священник" "Тогда с радостью объявляю вас супругами."

# ch/harems_full/fashion/events.rpy:742
translate russian palla_sasha_male_ending_bb79df60:
    "Священник" "Можете отметить это так, как считаете нужным."

# ch/harems_full/fashion/events.rpy:746
translate russian palla_sasha_male_ending_59ba10ed:
    "Мы с Паллой и Сашей обнимаемся втроём."

# ch/harems_full/fashion/events.rpy:747
translate russian palla_sasha_male_ending_e80b2b0d:
    "Затем целуемся — сначала медленно и чувственно."

# ch/harems_full/fashion/events.rpy:748
translate russian palla_sasha_male_ending_f51aed2b:
    "Но с каждой секундой поцелуй становится всё страстнее."

# ch/harems_full/fashion/events.rpy:749
translate russian palla_sasha_male_ending_f50375b0:
    "Конечно, впереди у нас целая жизнь для таких вещей."

# ch/harems_full/fashion/events.rpy:750
translate russian palla_sasha_male_ending_eba178b3:
    "Но когда женат на таких девушках, зачем терять время?"

# ch/harems_full/fashion/events.rpy:756
translate russian palla_sasha_male_ending_f8ac8e7a:
    palla.say "Что значит — нужно подождать Сашу?"

# ch/harems_full/fashion/events.rpy:757
translate russian palla_sasha_male_ending_d31b8e3a:
    palla.say "Я уже сказала, что она занята."

# ch/harems_full/fashion/events.rpy:759
translate russian palla_sasha_male_ending_e5f4e159:
    palla.say "И она не против, чтобы я справилась сама, ясно?"

# ch/harems_full/fashion/events.rpy:762
translate russian palla_sasha_male_ending_5ace3312:
    sasha.say "Эй!"

# ch/harems_full/fashion/events.rpy:763
translate russian palla_sasha_male_ending_2902e81f:
    sasha.say "Какого чёрта ты делаешь, Палла?"

# ch/harems_full/fashion/events.rpy:766
translate russian palla_sasha_male_ending_5892aed5:
