# ch/harems_full/fashion/events.rpy:85
translate russian best_customer_service_1febcd17:
    "Конечно, в магазине было полно народу: он ведь только что получил награду."

# ch/harems_full/fashion/events.rpy:86
translate russian best_customer_service_27effd07:
