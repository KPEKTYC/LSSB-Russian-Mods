    sasha.say "А, да..."

# ch/harems_full/fashion/events.rpy:780
translate russian palla_sasha_male_ending_c929c2c4:
    sasha.say "Ну... с ним-то жить несложно, Палла."

# ch/harems_full/fashion/events.rpy:781
translate russian palla_sasha_male_ending_33a54cda:
    sasha.say "Вот с тобой — другое дело!"

# ch/harems_full/fashion/events.rpy:783
translate russian palla_sasha_male_ending_c69b8051:
    palla.say "Прошу прощения?!"

# ch/harems_full/fashion/events.rpy:784
translate russian palla_sasha_male_ending_47b23f38:
    sasha.say "Да ладно тебе, Палла!"

# ch/harems_full/fashion/events.rpy:785
translate russian palla_sasha_male_ending_2d316273:
    sasha.say "Я и [lssb_common.hero_name()] довольно спокойные люди."

# ch/harems_full/fashion/events.rpy:786
translate russian palla_sasha_male_ending_d4361a8f:
    sasha.say "А тебе вечно нужно, чтобы всё было строго по-твоему!"

# ch/harems_full/fashion/events.rpy:788
translate russian palla_sasha_male_ending_ee1f105c:
    palla.say "И разве меня можно винить?"

# ch/harems_full/fashion/events.rpy:789
translate russian palla_sasha_male_ending_0988632d:
    palla.say "Вы двое хотите жить как варвары!"

# ch/harems_full/fashion/events.rpy:790
translate russian palla_sasha_male_ending_43decfec:
    palla.say "Таких нерях я в жизни не встречала!"

# ch/harems_full/fashion/events.rpy:791
translate russian palla_sasha_male_ending_90422610:
