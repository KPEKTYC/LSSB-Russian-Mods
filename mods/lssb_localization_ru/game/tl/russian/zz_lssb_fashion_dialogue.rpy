# ch/harems_full/fashion/events.rpy:720
translate russian palla_sasha_male_ending_8c7361cd:
    "Священник" "В законный брак?"

# ch/harems_full/fashion/events.rpy:722
translate russian palla_sasha_male_ending_41c4547f:
    palla.say "Согласна."

# ch/harems_full/fashion/events.rpy:723
translate russian palla_sasha_male_ending_e524799f:
    "Священник" "Прекрасно."

# ch/harems_full/fashion/events.rpy:724
translate russian palla_sasha_male_ending_30ef69f0:
