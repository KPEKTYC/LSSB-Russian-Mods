# ch/harems_full/fashion/events.rpy:718
translate russian palla_sasha_male_ending_21a7d6d9:
    "Священник" "Палла, согласна ли ты..."

# ch/harems_full/fashion/events.rpy:719
translate russian palla_sasha_male_ending_54ecd1b6:
