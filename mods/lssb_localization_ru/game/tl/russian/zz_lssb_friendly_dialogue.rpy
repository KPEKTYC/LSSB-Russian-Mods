# ch/harems/friendly/events.rpy:331
translate russian emma_samantha_showdown_c8aa527c:
    "Реакция Сэм немного ошеломляет Эмму."

# ch/harems/friendly/events.rpy:332
translate russian emma_samantha_showdown_80e28710:
