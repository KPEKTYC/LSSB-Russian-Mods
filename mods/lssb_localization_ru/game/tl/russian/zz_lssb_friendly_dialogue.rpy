# ch/harems/friendly/events.rpy:402
translate russian emma_samantha_threesome_intro_c741778e:
    samantha.say "Привет, Эмма! Я так рада, что ты пришла!"

# ch/harems/friendly/events.rpy:403
translate russian emma_samantha_threesome_intro_24e36c7c:
    samantha.say "Эм..."

# ch/harems/friendly/events.rpy:404
translate russian emma_samantha_threesome_intro_fbd7a665:
    samantha.say "Извини, что здесь такой бардак."

# ch/harems/friendly/events.rpy:406
translate russian emma_samantha_threesome_intro_4381c4fb:
    samantha.say "Кто-то забыл о своих домашних обязанностях."

# ch/harems/friendly/events.rpy:407
translate russian emma_samantha_threesome_intro_cd656575:
    "Эмма качает головой."

# ch/harems/friendly/events.rpy:408
translate russian emma_samantha_threesome_intro_409cdb24:
    emma.say "Всё в порядке, [lssb_common.hero_name()]."

# ch/harems/friendly/events.rpy:410
translate russian emma_samantha_threesome_intro_7abfb8ec:
    emma.say "Я пришла повидаться с тобой, а не оценивать, как ты ведёшь хозяйство!"

# ch/harems/friendly/events.rpy:413
translate russian emma_samantha_threesome_intro_0ad3b370:
    "Потому что на пороге стоят Эмма и Сэм."

# ch/harems/friendly/events.rpy:417
translate russian emma_samantha_threesome_intro_aedfd249:
    samantha.say "Привет, [lssb_common.hero_name()]!"

# ch/harems/friendly/events.rpy:418
translate russian emma_samantha_threesome_intro_2c86d3f7_1:
    emma.say "Сюрприз!"

# ch/harems/friendly/events.rpy:420
translate russian emma_samantha_threesome_intro_26f77e01:
    samantha.say "Мы решили заглянуть в гости!"

# ch/harems/friendly/events.rpy:421
translate russian emma_samantha_threesome_intro_8bb39091_1:
    "Несколько мгновений я молча стою на месте."

# ch/harems/friendly/events.rpy:422
translate russian emma_samantha_threesome_intro_468d2a89_1:
    "Мне даже приходится пару раз моргнуть, прежде чем я верю своим глазам."

# ch/harems/friendly/events.rpy:424
translate russian emma_samantha_threesome_intro_73cc1e5b_1:
    mike.say "Вот это сюрприз!"

# ch/harems/friendly/events.rpy:425
translate russian emma_samantha_threesome_intro_99db2e7f_1:
    mike.say "Т... тогда заходите!"

# ch/harems/friendly/events.rpy:426
translate russian emma_samantha_threesome_intro_91f28738:
    "Я отступаю в сторону и пропускаю их в дом."

# ch/harems/friendly/events.rpy:427
translate russian emma_samantha_threesome_intro_70b06d06:
    "Затем закрываю за ними дверь, уже жалея, что не прибрался."

# ch/harems/friendly/events.rpy:433
translate russian emma_samantha_threesome_intro_063f97a0:
    mike.say "Простите за бардак, девчонки."

# ch/harems/friendly/events.rpy:434
translate russian emma_samantha_threesome_intro_ef279cea:
    mike.say "Я сегодня не ждал гостей!"

# ch/harems/friendly/events.rpy:435
translate russian emma_samantha_threesome_intro_6363742a:
    "Эмма и Сэм одновременно качают головами."

# ch/harems/friendly/events.rpy:436
translate russian emma_samantha_threesome_intro_8a8951b3:
    "И сразу же отмахиваются от моих извинений."

# ch/harems/friendly/events.rpy:437
translate russian emma_samantha_threesome_intro_6174fdf8:
    samantha.say "Всё в порядке, [lssb_common.hero_name()]."

# ch/harems/friendly/events.rpy:438
translate russian emma_samantha_threesome_intro_4b62f0a4:
    samantha.say "Мы пришли повидаться с тобой, а не оценивать, как ты ведёшь хозяйство!"

# ch/harems/friendly/events.rpy:439
translate russian emma_samantha_threesome_intro_2c40b24c:
    emma.say "И нам вовсе не обязательно сидеть здесь."

# ch/harems/friendly/events.rpy:441
translate russian emma_samantha_threesome_intro_117da3db:
    emma.say "Пойдём к тебе в комнату и просто побудем вместе."

# ch/harems/friendly/events.rpy:442
translate russian emma_samantha_threesome_intro_6226a7c3:
    emma.say "Что скажешь?"

# ch/harems/friendly/events.rpy:443
translate russian emma_samantha_threesome_intro_a16504cd:
    "Я в последний раз оглядываю прихожую, отмечая царящий вокруг хаос."

# ch/harems/friendly/events.rpy:444
translate russian emma_samantha_threesome_intro_10393af3:
    "Затем снова смотрю на Эмму и Сэм: обе мило мне улыбаются."

# ch/harems/friendly/events.rpy:445
translate russian emma_samantha_threesome_intro_2ecd742b:
    "Разве тут вообще есть над чем думать?"

# ch/harems/friendly/events.rpy:446
translate russian emma_samantha_threesome_intro_2d020930:
    mike.say "Знаете что..."

# ch/harems/friendly/events.rpy:447
translate russian emma_samantha_threesome_intro_1a017939:
    mike.say "Отличная идея."

# ch/harems/friendly/events.rpy:448
translate russian emma_samantha_threesome_intro_4c012a0c:
    mike.say "Пойдёмте."

# ch/harems/friendly/events.rpy:449
translate russian emma_samantha_threesome_intro_041d881a:
    "Эмма и Сэм идут следом, пока я веду их к своей комнате."

# ch/harems/friendly/events.rpy:454
translate russian emma_samantha_threesome_intro_13d7b9fe:
    "Открываю дверь, пропускаю их внутрь, захожу сам и быстро её закрываю."

# ch/harems/friendly/events.rpy:455
translate russian emma_samantha_threesome_intro_ed922936:
    "Но когда поворачиваюсь, собираясь сказать что-нибудь остроумное, меня ждёт сюрприз."

# ch/harems/friendly/events.rpy:456
translate russian emma_samantha_threesome_intro_0d58eaf3:
    "Эмма и Сэм не теряли времени даром и уже устроились поудобнее."

# ch/harems/friendly/events.rpy:457
translate russian emma_samantha_threesome_intro_2f73b7f4:
    "А именно — обе полулежат на моей кровати и смотрят на меня."

# ch/harems/friendly/events.rpy:458
translate russian emma_samantha_threesome_intro_60c1ae28:
    "И ни одна не скрывает, что пытается привлечь моё внимание."

# ch/harems/friendly/events.rpy:459
translate russian emma_samantha_threesome_intro_e63d132f:
    samantha.say "На что уставился, [lssb_common.hero_name()]?"

# ch/harems/friendly/events.rpy:461
translate russian emma_samantha_threesome_intro_ce79c5f7:
    samantha.say "Мы просто устраиваемся поудобнее, только и всего!"

# ch/harems/friendly/events.rpy:462
translate russian emma_samantha_threesome_intro_170381d2:
    emma.say "Д... да, [lssb_common.hero_name()]..."

# ch/harems/friendly/events.rpy:464
translate russian emma_samantha_threesome_intro_7df9a2d5:
    emma.say "Не хочешь к нам присоединиться?"

# ch/harems/friendly/events.rpy:465
translate russian emma_samantha_threesome_intro_91e602f6:
    "Что ж, это уже принимает интересный оборот!"

# ch/harems/friendly/events.rpy:466
translate russian emma_samantha_threesome_intro_d11747b3:
    "Озорной взгляд Сэм мне прекрасно знаком."

# ch/harems/friendly/events.rpy:467
translate russian emma_samantha_threesome_intro_795da26d:
    "А вот Эмма ещё никогда не устраивала для меня подобных представлений."

# ch/harems/friendly/events.rpy:468
translate russian emma_samantha_threesome_intro_75a25f1a:
    "Наверняка именно Сэм придумала эту маленькую авантюру."

# ch/harems/friendly/events.rpy:469
translate russian emma_samantha_threesome_intro_3ac6efb5:
    "И всё же очень любопытно смотреть, как Эмма тоже пытается вести себя соблазнительно."

# ch/harems/friendly/events.rpy:470
translate russian emma_samantha_threesome_intro_06d91760:
    "Пожалуй, то, как неловко у неё это выходит, даже заводит!"

# ch/harems/friendly/events.rpy:471
translate russian emma_samantha_threesome_intro_67c80c59:
    mike.say "Минутку..."

# ch/harems/friendly/events.rpy:472
translate russian emma_samantha_threesome_intro_536c0f10:
    mike.say "Я просто хочу уточнить..."

# ch/harems/friendly/events.rpy:473
translate russian emma_samantha_threesome_intro_bd7d8c26:
    mike.say "У нас тут намечается секс втроём, правильно?"

# ch/harems/friendly/events.rpy:474
translate russian emma_samantha_threesome_intro_1db0b4f4:
    "Чувствую, что своим вопросом я немного разрушил чары."

# ch/harems/friendly/events.rpy:475
translate russian emma_samantha_threesome_intro_58b70280:
    "Сэм и Эмма садятся и недоумённо переглядываются."

# ch/harems/friendly/events.rpy:477
translate russian emma_samantha_threesome_intro_a94b0d4d:
    samantha.say "Ну... да!"

# ch/harems/friendly/events.rpy:479
translate russian emma_samantha_threesome_intro_c13b9016:
    emma.say "Мы же говорили, что будем делить тебя, — помнишь?"

# ch/harems/friendly/events.rpy:480
translate russian emma_samantha_threesome_intro_76b19ed8:
    "Не могу удержаться от смеха, пока подхожу к кровати и сажусь между ними."

# ch/harems/friendly/events.rpy:481
translate russian emma_samantha_threesome_intro_e23ff751:
    mike.say "Конечно, помню."

# ch/harems/friendly/events.rpy:482
translate russian emma_samantha_threesome_intro_96bdbb87:
    mike.say "Просто меня забыли предупредить, что мы уже дошли до этого этапа!"

# ch/harems/friendly/events.rpy:483
translate russian emma_samantha_threesome_intro_e11204b4:
    mike.say "Но сразу скажу: я полностью за!"

# ch/harems/friendly/events.rpy:484
translate russian emma_samantha_threesome_intro_a6f54422:
    "Сэм и Эмма снова переглядываются и радостно кивают."

# ch/harems/friendly/events.rpy:486
translate russian emma_samantha_threesome_intro_d3a99af2:
    samantha.say "А... ну тогда ладно!"

# ch/harems/friendly/events.rpy:487
translate russian emma_samantha_threesome_intro_c4ddd359:
    emma.say "Вот и отлично!"

# ch/harems/friendly/events.rpy:488
translate russian emma_samantha_threesome_intro_7a289eac:
    "Я едва успеваю заметить, как они кивают друг другу, прежде чем всё начинается."

# ch/harems/friendly/events.rpy:489
translate russian emma_samantha_threesome_intro_87795e31:
    "Сначала Сэм, а потом и Эмма набрасываются на меня, прижимая к кровати."

# ch/harems/friendly/events.rpy:490
translate russian emma_samantha_threesome_intro_9974eb03:
    "Одна целует меня в губы, а другая стягивает с меня одежду."

# ch/harems/friendly/events.rpy:491
translate russian emma_samantha_threesome_intro_d4acb84f:
    "В этой суматохе я, честно говоря, уже не понимаю, кто из них что делает."

# ch/harems/friendly/events.rpy:492
translate russian emma_samantha_threesome_intro_ed8512b0:
    "И уверен, что они не раз умудряются поменяться местами!"

# ch/harems/friendly/events.rpy:493
translate russian emma_samantha_threesome_intro_9197c823:
    "Так меня и раздевают догола, пока чей-то язык исследует мой рот."

# ch/harems/friendly/events.rpy:494
translate russian emma_samantha_threesome_intro_e7eda7f0:
    "Когда мне наконец позволяют приподняться, на мне уже ничего нет."

# ch/harems/friendly/events.rpy:495
translate russian emma_samantha_threesome_intro_0dffd6e9:
    "И мой член тоже стоит по стойке смирно, покачиваясь при каждом движении."

# ch/harems/friendly/events.rpy:496
translate russian emma_samantha_threesome_intro_3d543b89:
    "Но всё моё внимание приковано к тому, что сейчас делают Сэм и Эмма."

# ch/harems/friendly/events.rpy:497
translate russian emma_samantha_threesome_intro_b17b1845:
    "Пока я пытался прийти в себя, они успели соскользнуть с кровати."

# ch/harems/friendly/events.rpy:498
translate russian emma_samantha_threesome_intro_21c98596:
    "И теперь раздевают друг друга прямо передо мной."

# ch/harems/friendly/events.rpy:499
translate russian emma_samantha_threesome_intro_d7a08adc:
    "Я понимаю, что это представление должно меня возбудить."

# ch/harems/friendly/events.rpy:503
translate russian emma_samantha_threesome_intro_4546dbc0:
    "И внимательно смотрю, как две желанные девушки красуются передо мной."

# ch/harems/friendly/events.rpy:504
translate russian emma_samantha_threesome_intro_01fbbc81:
    "Сэм, как я и ожидал, берёт инициативу на себя."

# ch/harems/friendly/events.rpy:505
translate russian emma_samantha_threesome_intro_d77e8c51:
    "А Эмма старательно следует её примеру."

# ch/harems/friendly/events.rpy:506
translate russian emma_samantha_threesome_intro_f7c0508e:
    "Они снимают друг с друга одну вещь за другой."

# ch/harems/friendly/events.rpy:509
translate russian emma_samantha_threesome_intro_95cd40c6:
    "И к тому моменту, когда обе остаются голыми, я уже смотрю на них как зачарованный."

# ch/harems/friendly/events.rpy:510
translate russian emma_samantha_threesome_intro_d1b24669:
    "Обе стоят передо мной, и на них нет ничего, кроме улыбок."

# ch/harems/friendly/events.rpy:511
translate russian emma_samantha_threesome_intro_45692041:
    "Но я не сразу понимаю, почему они больше ничего не делают."

# ch/harems/friendly/events.rpy:512
translate russian emma_samantha_threesome_intro_d67d88ca:
    "А потом до меня доходит: они ждут моих указаний!"

# ch/harems/friendly/events.rpy:518
translate russian emma_samantha_threesome_appointment_intro_0e5e480a:
    "Наконец настало время нашего свидания."

# ch/harems/friendly/events.rpy:520
translate russian emma_samantha_threesome_appointment_intro_bf37fed4:
    "Услышав звонок, я едва не бегом бросаюсь к двери."

# ch/harems/friendly/events.rpy:524
translate russian emma_samantha_threesome_appointment_intro_08b35a3c:
    "На пороге стоит Эмма."

# ch/harems/friendly/events.rpy:525
translate russian emma_samantha_threesome_appointment_intro_9f82b9ba:
    emma.say "Привет, [lssb_common.hero_name()]!"

# ch/harems/friendly/events.rpy:526
translate russian emma_samantha_threesome_appointment_intro_45f44c2e:
    "Я отступаю в сторону и пропускаю её в дом."

# ch/harems/friendly/events.rpy:527
translate russian emma_samantha_threesome_appointment_intro_458b51bb:
    "Через несколько секунд появляется Саманта."

# ch/harems/friendly/events.rpy:529
translate russian emma_samantha_threesome_appointment_intro_c4a40b04:
    samantha.say "Привет, Эмма!"

# ch/harems/friendly/events.rpy:531
translate russian emma_samantha_threesome_appointment_intro_f7a4699f:
    "На пороге стоят Эмма и Сэм."

