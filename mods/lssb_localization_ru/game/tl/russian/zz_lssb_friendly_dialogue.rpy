# ch/harems/friendly/events.rpy:335
translate russian emma_samantha_showdown_3cae19fc:
    mike.say "Кексик немного преувеличивает, Эмма."

# ch/harems/friendly/events.rpy:337
translate russian emma_samantha_showdown_dcefc33d:
