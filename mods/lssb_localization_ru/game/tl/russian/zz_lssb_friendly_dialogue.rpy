# ch/harems/friendly/events.rpy:326
translate russian emma_samantha_showdown_25290f68:
    samantha.say "Правда?"

# ch/harems/friendly/events.rpy:328
translate russian emma_samantha_showdown_d9c8d4c2:
    samantha.say "Как же я рада это слышать."

# ch/harems/friendly/events.rpy:329
translate russian emma_samantha_showdown_5461ec65:
    samantha.say "[lssb_common.hero_name()] был так добр ко мне, Эмма."

# ch/harems/friendly/events.rpy:330
translate russian emma_samantha_showdown_383d4d59:
