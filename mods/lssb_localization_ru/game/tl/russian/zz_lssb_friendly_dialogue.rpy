# ch/harems/friendly/events.rpy:254
translate russian emma_samantha_showdown_9b6f28ab:
    mike.say "Спасибо, что напомнила!"

# ch/harems/friendly/events.rpy:261
translate russian emma_samantha_showdown_fea79242_1:
    "Стоит Эмме упомянуть, что мы встречаемся, как выражение лица Сэм меняется."

# ch/harems/friendly/events.rpy:262
translate russian emma_samantha_showdown_c871b3d5_1:
    "До этого ей явно было интересно вытянуть из нас подробности."

# ch/harems/friendly/events.rpy:263
translate russian emma_samantha_showdown_e4689f63:
    "Но теперь она, кажется, злится всё сильнее с каждой секундой!"

# ch/harems/friendly/events.rpy:265
translate russian emma_samantha_showdown_cc66cb95:
    samantha.say "Вы что?"

# ch/harems/friendly/events.rpy:267
translate russian emma_samantha_showdown_ae961982:
    samantha.say "Вы издеваетесь, что ли?!"

# ch/harems/friendly/events.rpy:268
translate russian emma_samantha_showdown_5aa7389f:
    "Сэм вскакивает, едва не опрокинув столик."

# ch/harems/friendly/events.rpy:269
translate russian emma_samantha_showdown_51540beb:
    "Затем резко разворачивается и в ярости выходит из кофейни."

# ch/harems/friendly/events.rpy:272
translate russian emma_samantha_showdown_26e114e0:
