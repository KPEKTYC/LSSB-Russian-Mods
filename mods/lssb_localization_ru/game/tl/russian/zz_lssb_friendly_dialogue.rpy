# ch/harems/friendly/events.rpy:386
translate russian emma_samantha_threesome_intro_2c86d3f7:
    emma.say "Сюрприз!"

# ch/harems/friendly/events.rpy:387
translate russian emma_samantha_threesome_intro_2045d900:
    emma.say "Сэм сказала, что она дома, и пригласила меня в гости!"

# ch/harems/friendly/events.rpy:388
translate russian emma_samantha_threesome_intro_8bb39091:
    "Несколько мгновений я молча стою на месте."

# ch/harems/friendly/events.rpy:389
translate russian emma_samantha_threesome_intro_468d2a89:
