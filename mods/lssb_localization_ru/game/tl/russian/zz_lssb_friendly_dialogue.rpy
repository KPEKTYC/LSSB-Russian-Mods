# ch/harems/friendly/events.rpy:354
translate russian emma_samantha_showdown_58f775b9:
    emma.say "Ну, я..."

# ch/harems/friendly/events.rpy:355
translate russian emma_samantha_showdown_64972065:
    emma.say "Ничего себе... Как же мне повезло!"

# ch/harems/friendly/events.rpy:356
translate russian emma_samantha_showdown_f6b53f8b:
    "Сэм улыбается и кивает, довольная реакцией Эммы."

# ch/harems/friendly/events.rpy:357
translate russian emma_samantha_showdown_792be107:
    "Моя улыбка гораздо скромнее: я всё ещё смущён."

# ch/harems/friendly/events.rpy:358
translate russian emma_samantha_showdown_0589268a:
    "Но я чувствую, как Эмма держит меня за руку под столом."

# ch/harems/friendly/events.rpy:359
translate russian emma_samantha_showdown_d43523bd:
    "Она сжимает её ещё крепче и прижимается ко мне."

# ch/harems/friendly/events.rpy:360
translate russian emma_samantha_showdown_0a7f85e3:
    "Это я предпочитаю считать хорошим знаком."

# ch/harems/friendly/events.rpy:366
translate russian emma_samantha_threesome_intro_b9952b69:
    "Знаете такие дни, когда просто сидишь дома и занимаешься своими делами?"

# ch/harems/friendly/events.rpy:367
translate russian emma_samantha_threesome_intro_fff53861:
    "Никаких планов, а мысли блуждают о чём попало."

# ch/harems/friendly/events.rpy:368
translate russian emma_samantha_threesome_intro_4801a514:
