# ch/harems/friendly/events.rpy:273
translate russian emma_samantha_showdown_04ebf01d:
    emma.say "Чт... что это было?"

# ch/harems/friendly/events.rpy:275
translate russian emma_samantha_showdown_8ccc98bc:
    emma.say "Почему она так разозлилась и ушла?"

# ch/harems/friendly/events.rpy:276
translate russian emma_samantha_showdown_8a79850a:
    emma.say "Я же... всего лишь сказала, что мы встречаемся!"

# ch/harems/friendly/events.rpy:277
translate russian emma_samantha_showdown_7039519f:
    "Мне остаётся лишь беспомощно пожать плечами."

# ch/harems/friendly/events.rpy:278
translate russian emma_samantha_showdown_a35ab4dc:
    mike.say "Понятия не имею, Эмма!"

# ch/harems/friendly/events.rpy:279
translate russian emma_samantha_showdown_d359bae7:
    mike.say "Честно, не знаю!"

# ch/harems/friendly/events.rpy:281
translate russian emma_samantha_showdown_56eeecc3:
    "Эмма кивает, показывая, что верит мне."

# ch/harems/friendly/events.rpy:283
translate russian emma_samantha_showdown_10fb0b13:
    "Потом глубоко вздыхает и опускает взгляд на свой кофе."

# ch/harems/friendly/events.rpy:284
translate russian emma_samantha_showdown_f1c3519f:
    emma.say "У тебя со всеми такие странные отношения, [lssb_common.hero_name()]?"

# ch/harems/friendly/events.rpy:285
translate russian emma_samantha_showdown_3994e8e6:
    emma.say "Если да, то, по-моему, тебе стоит меня предупреждать."

# ch/harems/friendly/events.rpy:286
translate russian emma_samantha_showdown_9543df18:
    emma.say "Знаешь — ДО того, как мы с ними столкнёмся!"

# ch/harems/friendly/events.rpy:287
translate russian emma_samantha_showdown_a20dba72:
    mike.say "Нет, Эмма... с большинством людей у меня вполне нормальные отношения."

# ch/harems/friendly/events.rpy:289
translate russian emma_samantha_showdown_043249d7:
    mike.say "И я думал, что с Кексиком тоже."

# ch/harems/friendly/events.rpy:291
translate russian emma_samantha_showdown_1b2a8417:
    mike.say "И я думал, что с Сэм тоже."

# ch/harems/friendly/events.rpy:292
translate russian emma_samantha_showdown_535b38f4:
    "После этого мы пытаемся вернуться к нашему свиданию."

# ch/harems/friendly/events.rpy:293
translate russian emma_samantha_showdown_78db2fc4:
    "Но, как ни стараемся, всё уже не то."

# ch/harems/friendly/events.rpy:294
translate russian emma_samantha_showdown_18457652:
    "Эта странная встреча с Сэм, похоже, испортила настроение."

# ch/harems/friendly/events.rpy:297
translate russian emma_samantha_showdown_59fb6524_1:
    "Эмма хмурится и качает головой."

# ch/harems/friendly/events.rpy:298
translate russian emma_samantha_showdown_d329dd79_1:
    "Потом тоже встаёт."

# ch/harems/friendly/events.rpy:299
translate russian emma_samantha_showdown_78779ddc:
    emma.say "Кажется, я тебе не верю, [lssb_common.hero_name()]."

# ch/harems/friendly/events.rpy:301
translate russian emma_samantha_showdown_891133b8:
    emma.say "Потому что я бы отреагировала точно так же, если бы узнала, что мне изменяют!"

# ch/harems/friendly/events.rpy:302
translate russian emma_samantha_showdown_628b7b1d:
