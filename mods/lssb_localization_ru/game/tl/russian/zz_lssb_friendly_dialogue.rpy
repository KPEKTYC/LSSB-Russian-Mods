# Native Friendly identifiers, current source catalog. Translation only.

# ch/harems/friendly/events.rpy:57
translate russian emma_samantha_showdown_b4beaf1d:
    "До дня свидания с Эммой я изрядно поломал голову."

# ch/harems/friendly/events.rpy:58
translate russian emma_samantha_showdown_93ee9276:
    "Но, как ни старался, ничего не мог придумать."

# ch/harems/friendly/events.rpy:59
translate russian emma_samantha_showdown_f6bc91a1:
    "Все подходящие места оказывались либо закрыты, либо забронированы заранее."

# ch/harems/friendly/events.rpy:60
translate russian emma_samantha_showdown_e8c1af9b:
    "И когда пришло время встречаться, я всё ещё не знал, куда пойти."

# ch/harems/friendly/events.rpy:61
translate russian emma_samantha_showdown_82348066:
    "В итоге просто предложил сходить в торговый центр."

# ch/harems/friendly/events.rpy:62
translate russian emma_samantha_showdown_469c6477:
    "И, к моему удивлению, Эмма сочла это отличной идеей."

# ch/harems/friendly/events.rpy:64
translate russian emma_samantha_showdown_43f58f3e:
    emma.say "Конечно, [lssb_common.hero_name()]..."

# ch/harems/friendly/events.rpy:65
translate russian emma_samantha_showdown_b37df6e9:
    emma.say "Свидание в торговом центре — замечательно!"

# ch/harems/friendly/events.rpy:66
translate russian emma_samantha_showdown_4f9556ba:
    mike.say "Правда, Эмма?"

# ch/harems/friendly/events.rpy:67
translate russian emma_samantha_showdown_032851d4:
    mike.say "Ты уверена?"

# ch/harems/friendly/events.rpy:68
translate russian emma_samantha_showdown_1e953af0:
    mike.say "Я пытался придумать что-нибудь поинтереснее..."

# ch/harems/friendly/events.rpy:70
translate russian emma_samantha_showdown_f5ef51be:
    "Эмма качает головой."

# ch/harems/friendly/events.rpy:71
translate russian emma_samantha_showdown_e3f84047:
    "Затем берёт меня за руку и сжимает её."

# ch/harems/friendly/events.rpy:72
translate russian emma_samantha_showdown_1b23ee69:
    emma.say "Не беспокойся."

# ch/harems/friendly/events.rpy:73
translate russian emma_samantha_showdown_efcfe36e:
    emma.say "Можем просто погулять вместе."

# ch/harems/friendly/events.rpy:74
translate russian emma_samantha_showdown_92078850:
    emma.say "Будет сколько угодно времени поболтать."

# ch/harems/friendly/events.rpy:75
translate russian emma_samantha_showdown_ea00af12:
    emma.say "И не придётся переживать, что испортится погода!"

# ch/harems/friendly/events.rpy:76
translate russian emma_samantha_showdown_aaed2e14:
    "Вот так мы и оказываемся в торговом центре, неспешно гуляя."

# ch/harems/friendly/events.rpy:77
translate russian emma_samantha_showdown_85cd4790:
    "Идём за руку и говорим обо всём, что приходит в голову."

# ch/harems/friendly/events.rpy:78
translate russian emma_samantha_showdown_17146fea:
    "Иногда останавливаемся рассмотреть что-нибудь в витрине."

# ch/harems/friendly/events.rpy:79
translate russian emma_samantha_showdown_fa7577b9:
    "Но в основном просто наслаждаемся обществом друг друга."

# ch/harems/friendly/events.rpy:80
translate russian emma_samantha_showdown_487479c6:
    emma.say "Видишь?"

# ch/harems/friendly/events.rpy:81
translate russian emma_samantha_showdown_755ba076:
    emma.say "Я же говорила, что идея отличная!"

# ch/harems/friendly/events.rpy:82
translate russian emma_samantha_showdown_d4abd698:
    mike.say "Да, Эмма..."

# ch/harems/friendly/events.rpy:83
translate russian emma_samantha_showdown_3457a6b9:
    mike.say "Похоже, ты была права."

# ch/harems/friendly/events.rpy:84
translate russian emma_samantha_showdown_9a6faaaa:
    mike.say "Нам просто нужна была возможность побыть вместе."

# ch/harems/friendly/events.rpy:86
translate russian emma_samantha_showdown_dbfc0f4f:
    "Эмма улыбается и тянет меня за руку, приглашая продолжить прогулку."

# ch/harems/friendly/events.rpy:87
translate russian emma_samantha_showdown_0b39ceb8:
    "Но стоит нам двинуться дальше, как я замечаю, что кто-то стоит на пути."

# ch/harems/friendly/events.rpy:91
translate russian emma_samantha_showdown_227b506a:
    samantha.say "О, привет, [lssb_common.hero_name()]!"

# ch/harems/friendly/events.rpy:92
translate russian emma_samantha_showdown_38f39cdd:
    samantha.say "Так и подумала, что это ты."

# ch/harems/friendly/events.rpy:93
translate russian emma_samantha_showdown_37bb001e:
    "Услышав знакомый голос, я замираю на месте."

# ch/harems/friendly/events.rpy:94
translate russian emma_samantha_showdown_82f19f02:
    "Это Сэм, стоит прямо перед нами."

# ch/harems/friendly/events.rpy:96
translate russian emma_samantha_showdown_f2d98220:
    "Чувствую, что уже начинаю потеть."

# ch/harems/friendly/events.rpy:97
translate russian emma_samantha_showdown_bed0a0c1:
    "Она проследила за нами?"

# ch/harems/friendly/events.rpy:98
translate russian emma_samantha_showdown_294bf5c7:
    "Шпионит за мной?!"

# ch/harems/friendly/events.rpy:99
translate russian emma_samantha_showdown_22f066aa:
    "Ей достаточно сказать одно слово, чтобы всё рухнуло!"

# ch/harems/friendly/events.rpy:101
translate russian emma_samantha_showdown_e375fc5d:
    "Сэм опускает взгляд и видит, что мы с Эммой держимся за руки."

# ch/harems/friendly/events.rpy:102
translate russian emma_samantha_showdown_31bdb75c:
    samantha.say "Ой..."

# ch/harems/friendly/events.rpy:103
translate russian emma_samantha_showdown_a60186f1:
    samantha.say "Какие вы милые!"

# ch/harems/friendly/events.rpy:105
translate russian emma_samantha_showdown_2dcae54c:
    samantha.say "Похоже, отлично ладите!"

# ch/harems/friendly/events.rpy:106
translate russian emma_samantha_showdown_f8b2719f:
    mike.say "А... да, конечно!"

# ch/harems/friendly/events.rpy:110
translate russian emma_samantha_showdown_c44066b9:
    "Неловко получается!"

# ch/harems/friendly/events.rpy:111
translate russian emma_samantha_showdown_45792bd0:
    "Конечно, именно Сэм познакомила нас с Эммой."

# ch/harems/friendly/events.rpy:112
translate russian emma_samantha_showdown_5004e145:
    "Но она никогда не говорила, что хотела нас свести!"

# ch/harems/friendly/events.rpy:113
translate russian emma_samantha_showdown_46ce08ac:
    "Эмма заметно смущена тем, как Сэм подошла прямо к нам."

# ch/harems/friendly/events.rpy:114
translate russian emma_samantha_showdown_9297504c:
    "Но вижу, что она изо всех сил старается улыбаться и справляться с неловкостью."

# ch/harems/friendly/events.rpy:115
translate russian emma_samantha_showdown_634f46c3:
    "Порой я забываю, что Эмма не такая напористая, как Сэм."

# ch/harems/friendly/events.rpy:117
translate russian emma_samantha_showdown_6851773c:
    emma.say "Эм..."

# ch/harems/friendly/events.rpy:118
translate russian emma_samantha_showdown_10ed7079:
    emma.say "Привет, Сэм!"

# ch/harems/friendly/events.rpy:119
translate russian emma_samantha_showdown_f58ec557:
    "Да, неловкость быстро нарастает!"

# ch/harems/friendly/events.rpy:120
translate russian emma_samantha_showdown_0f4120f6:
    "Нужно что-то с этим сделать."

# ch/harems/friendly/events.rpy:121
translate russian emma_samantha_showdown_457e59a8:
    mike.say "Может, пойдём перекусим?"

# ch/harems/friendly/events.rpy:122
translate russian emma_samantha_showdown_8314fd60:
    mike.say "Сядем и спокойно поболтаем, да?"

# ch/harems/friendly/events.rpy:123
translate russian emma_samantha_showdown_74627e3d:
    samantha.say "М-м..."

# ch/harems/friendly/events.rpy:125
translate russian emma_samantha_showdown_21c29228:
    samantha.say "На чашку кофе время найдётся."

# ch/harems/friendly/events.rpy:127
translate russian emma_samantha_showdown_2034e8d8:
    emma.say "О... звучит неплохо."

# ch/harems/friendly/events.rpy:128
translate russian emma_samantha_showdown_45d6cff1:
    emma.say "Давайте!"

# ch/harems/friendly/events.rpy:133
translate russian emma_samantha_showdown_c869aaf0:
    "Мы втроём идём в ближайшую кофейню."

# ch/harems/friendly/events.rpy:134
translate russian emma_samantha_showdown_c65c618f:
    "К счастью, есть свободный столик, и вскоре мы заказываем напитки."

# ch/harems/friendly/events.rpy:135
translate russian emma_samantha_showdown_096b2fb8:
    "Затем пора заняться серьёзным делом — обменяться сплетнями."

# ch/harems/friendly/events.rpy:136
translate russian emma_samantha_showdown_216126bd:
    "Я открываю рот, чтобы начать разговор."

# ch/harems/friendly/events.rpy:137
translate russian emma_samantha_showdown_20174483:
    "Но Сэм меня опережает!"

# ch/harems/friendly/events.rpy:138
translate russian emma_samantha_showdown_27033afc:
    samantha.say "Ну что, Эмма..."

# ch/harems/friendly/events.rpy:139
translate russian emma_samantha_showdown_61c69082:
    samantha.say "Что между вами происходит?"

# ch/harems/friendly/events.rpy:140
translate russian emma_samantha_showdown_d927d918:
    "Эмма слегка краснеет, но всё же отвечает."

# ch/harems/friendly/events.rpy:141
translate russian emma_samantha_showdown_6487b5c2:
    emma.say "Ну, Сэм..."

# ch/harems/friendly/events.rpy:142
translate russian emma_samantha_showdown_89ed4c2c:
    emma.say "Всё закрутилось так стремительно."

# ch/harems/friendly/events.rpy:143
translate russian emma_samantha_showdown_9db12a0d:
    emma.say "Словно мы только что познакомились."

# ch/harems/friendly/events.rpy:144
translate russian emma_samantha_showdown_c40e666e:
    emma.say "А уже в следующую секунду начали встречаться!"

# ch/harems/friendly/events.rpy:146
translate russian emma_samantha_showdown_fea79242:
    "Как только Эмма упоминает наши отношения, выражение лица Сэм меняется."

# ch/harems/friendly/events.rpy:147
translate russian emma_samantha_showdown_c871b3d5:
    "До этого она выглядела искренне заинтересованной в подробностях."

# ch/harems/friendly/events.rpy:148
translate russian emma_samantha_showdown_bf7994dc:
    "Теперь улыбается, и, кажется, я знаю почему."

# ch/harems/friendly/events.rpy:149
translate russian emma_samantha_showdown_9939640b:
    samantha.say "Твой парень — [lssb_common.hero_name()]?"

# ch/harems/friendly/events.rpy:151
translate russian emma_samantha_showdown_a2a2da76:
    samantha.say "Какое совпадение, Эмма!"

# ch/harems/friendly/events.rpy:153
translate russian emma_samantha_showdown_13a681dc:
    samantha.say "Мой тоже!"

# ch/harems/friendly/events.rpy:154
translate russian emma_samantha_showdown_8603de8b:
    "На миг Эмма выглядит так, словно получила пощёчину."

# ch/harems/friendly/events.rpy:156
translate russian emma_samantha_showdown_e68aeb3e:
    "Она молча смотрит на Сэм с открытым ртом."

# ch/harems/friendly/events.rpy:157
translate russian emma_samantha_showdown_4209efc3:
    "Но, едва опомнившись, поворачивается ко мне."

# ch/harems/friendly/events.rpy:158
translate russian emma_samantha_showdown_f3752a24:
    emma.say "О чём она говорит, [lssb_common.hero_name()]?"

# ch/harems/friendly/events.rpy:160
translate russian emma_samantha_showdown_4e362a7b:
    emma.say "Это... какая-то шутка?"

# ch/harems/friendly/events.rpy:161
translate russian emma_samantha_showdown_bb4a3c97:
    mike.say "Эм... нет, Эмма."

# ch/harems/friendly/events.rpy:163
translate russian emma_samantha_showdown_0d616322:
    mike.say "Мы с Кексиком уже какое-то время вроде как встречаемся."

# ch/harems/friendly/events.rpy:165
translate russian emma_samantha_showdown_affecbcb:
    mike.say "Мы с Сэм уже какое-то время вроде как встречаемся."

# ch/harems/friendly/events.rpy:166
translate russian emma_samantha_showdown_07f617d0:
    mike.say "Наверное, мы так давно дружим и так близки, что до меня только сейчас дошло."

# ch/harems/friendly/events.rpy:167
translate russian emma_samantha_showdown_40e156fb:
    "Эмма открывает рот, собираясь что-то сказать."

# ch/harems/friendly/events.rpy:168
translate russian emma_samantha_showdown_5ff54ef8:
    "Но Сэм перебивает её прежде, чем та успевает заговорить."

# ch/harems/friendly/events.rpy:169
translate russian emma_samantha_showdown_a0ae83ea:
    samantha.say "Я понимаю, Эмма. Правда."

# ch/harems/friendly/events.rpy:170
translate russian emma_samantha_showdown_b6216c36:
    samantha.say "Но [lssb_common.hero_name()] не заслуживает твоей злости."

# ch/harems/friendly/events.rpy:171
translate russian emma_samantha_showdown_56727d33:
    samantha.say "Он поддержал меня, когда недавно распался мой брак."

# ch/harems/friendly/events.rpy:173
translate russian emma_samantha_showdown_608aecfa:
    samantha.say "Он единственный остался рядом и дал мне то, что было нужно..."

# ch/harems/friendly/events.rpy:174
translate russian emma_samantha_showdown_89d726b7:
    "Эмма хмуро смотрит на Саманту."

# ch/harems/friendly/events.rpy:175
translate russian emma_samantha_showdown_d32f587d:
    "И объяснение, похоже, её не успокаивает."

# ch/harems/friendly/events.rpy:176
translate russian emma_samantha_showdown_0c59e0d0:
    emma.say "Полагаю, нужен тебе был секс?"

# ch/harems/friendly/events.rpy:178
translate russian emma_samantha_showdown_02f959de:
    emma.say "Много секса, да?"

# ch/harems/friendly/events.rpy:179
translate russian emma_samantha_showdown_6055ac3d:
    "Сэм пожимает плечами, а затем кивает."

# ch/harems/friendly/events.rpy:181
translate russian emma_samantha_showdown_ecbb6c9f:
    samantha.say "Он особенный парень, Эмма."

# ch/harems/friendly/events.rpy:182
translate russian emma_samantha_showdown_f67deb26:
    samantha.say "И я не собственница, обещаю."

# ch/harems/friendly/events.rpy:183
translate russian emma_samantha_showdown_3a4dfa34:
    samantha.say "Я готова делить его... с подходящей девушкой."

# ch/harems/friendly/events.rpy:185
translate russian emma_samantha_showdown_b3010200:
    emma.say "Ч-что ты имеешь в виду?"

# ch/harems/friendly/events.rpy:187
translate russian emma_samantha_showdown_3ef6fbdf:
    emma.say "Как это — делить его?"

# ch/harems/friendly/events.rpy:189
translate russian emma_samantha_showdown_4ce3ba8e:
    mike.say "Я вообще-то здесь, вы в курсе?"

# ch/harems/friendly/events.rpy:190
translate russian emma_samantha_showdown_ca427781:
    mike.say "Вы обсуждаете меня так, будто я номер в гостинице!"

# ch/harems/friendly/events.rpy:191
translate russian emma_samantha_showdown_139f05cd:
    "По взглядам, которыми обмениваются Эмма и Сэм, всё ясно."

# ch/harems/friendly/events.rpy:194
translate russian emma_samantha_showdown_ab5392a7:
    "Сейчас обе хотят, чтобы я заткнулся!"

# ch/harems/friendly/events.rpy:195
translate russian emma_samantha_showdown_c38d9bf4:
    samantha.say "Я вот о чём, Эмма..."

# ch/harems/friendly/events.rpy:197
translate russian emma_samantha_showdown_9e15c568:
    samantha.say "Он очень помог мне."

# ch/harems/friendly/events.rpy:198
translate russian emma_samantha_showdown_c69764ea:
    samantha.say "И тебе с ним тоже будет хорошо."

# ch/harems/friendly/events.rpy:199
translate russian emma_samantha_showdown_b1e88152:
    samantha.say "Но ведь нам обеим может быть с ним хорошо — одновременно!"

# ch/harems/friendly/events.rpy:201
translate russian emma_samantha_showdown_eaa8b07d:
    "Когда смысл слов Сэм доходит до Эммы, та заметно нервничает."

# ch/harems/friendly/events.rpy:202
translate russian emma_samantha_showdown_65a7bd73:
    "Но я замечаю, что она не отвергает эту мысль с ходу."

# ch/harems/friendly/events.rpy:203
translate russian emma_samantha_showdown_77322965:
    "А это уже хороший знак."

# ch/harems/friendly/events.rpy:204
translate russian emma_samantha_showdown_50ab9171:
    emma.say "Я... наверное, могла бы попробовать."

# ch/harems/friendly/events.rpy:206
translate russian emma_samantha_showdown_ad35341e:
    emma.say "Только если мне не придётся делать то, чего я не хочу!"

# ch/harems/friendly/events.rpy:207
translate russian emma_samantha_showdown_4f86eac2:
    "Сэм улыбается и поднимает руки, словно сдаваясь."

# ch/harems/friendly/events.rpy:208
translate russian emma_samantha_showdown_ad16775f:
    samantha.say "Обещаю, Эмма."

# ch/harems/friendly/events.rpy:209
translate russian emma_samantha_showdown_d42f540b:
    samantha.say "Никто не будет на тебя давить."

# ch/harems/friendly/events.rpy:210
translate russian emma_samantha_showdown_ce842ecf:
    samantha.say "Что скажешь, [lssb_common.hero_name()]?"

# ch/harems/friendly/events.rpy:211
translate russian emma_samantha_showdown_3b751fc9:
    "Не могу сдержать лёгкого раздражения: наконец-то и мне дали слово."

# ch/harems/friendly/events.rpy:212
translate russian emma_samantha_showdown_e5985e15:
    "Но потом я осознаю происходящее и изо всех сил стараюсь забыть об обиде."

# ch/harems/friendly/events.rpy:213
translate russian emma_samantha_showdown_9001dcdf:
    "Во-первых, похоже, мне сойдёт с рук то, что я встречаюсь сразу с двумя девушками."

# ch/harems/friendly/events.rpy:214
translate russian emma_samantha_showdown_e0f135f3:
    "А вдобавок всё может закончиться весьма приятным сексом втроём!"

# ch/harems/friendly/events.rpy:215
translate russian emma_samantha_showdown_9a57c698:
    mike.say "Я за, девчонки!"

# ch/harems/friendly/events.rpy:216
translate russian emma_samantha_showdown_a519a261:
    mike.say "Так когда и где мы этим займёмся?"

# ch/harems/friendly/events.rpy:217
translate russian emma_samantha_showdown_582a0778:
    "Услышав это, Эмма и Сэм многозначительно переглядываются и качают головами."

# ch/harems/friendly/events.rpy:218
translate russian emma_samantha_showdown_438f2b42:
    "Но я не собираюсь расстраиваться, когда на горизонте маячит секс втроём!"

