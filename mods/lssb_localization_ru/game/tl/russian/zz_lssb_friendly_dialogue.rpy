# ch/harems/friendly/events.rpy:393
translate russian emma_samantha_threesome_intro_45f44c2e:
    "Я отступаю в сторону и пропускаю её в дом."

# ch/harems/friendly/events.rpy:398
translate russian emma_samantha_threesome_intro_5f26df73:
    mike.say "Кексик где-то рядом. Сейчас позову."

# ch/harems/friendly/events.rpy:400
translate russian emma_samantha_threesome_intro_c011b2e2:
