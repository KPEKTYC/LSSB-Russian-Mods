# ch/harems/friendly/events.rpy:573
translate russian emma_samantha_threesome_now_intro_f228de18:
    samantha.say "Позвоню Эмме и скажу, чтобы встретила нас дома."

# ch/harems/friendly/events.rpy:574
translate russian emma_samantha_threesome_now_intro_af63675b:
    "Когда мы возвращаемся домой, Эмма уже ждёт перед домом."

# ch/harems/friendly/events.rpy:577
translate russian emma_samantha_threesome_now_intro_9f82b9ba:
    emma.say "Привет, [lssb_common.hero_name()]!"

# ch/harems/friendly/events.rpy:579
translate russian emma_samantha_threesome_now_intro_c4a40b04:
    samantha.say "Привет, Эмма!"

# ch/harems/friendly/events.rpy:581
translate russian emma_samantha_threesome_now_intro_f58eb451:
    emma.say "Позвоню Саманте и скажу, чтобы встретила нас дома."

# ch/harems/friendly/events.rpy:582
translate russian emma_samantha_threesome_now_intro_48801197:
    "Когда мы возвращаемся домой, Саманта уже ждёт перед домом."

# ch/harems/friendly/events.rpy:585
translate russian emma_samantha_threesome_now_intro_aedfd249:
    samantha.say "Привет, [lssb_common.hero_name()]!"

# ch/harems/friendly/events.rpy:587
translate russian emma_samantha_threesome_now_intro_a00dbd01:
    emma.say "Привет, Эмма!"

# ch/harems/friendly/events.rpy:588
translate russian emma_samantha_threesome_now_intro_00ea5365:
    mike.say "Пойдём?"

# ch/harems/friendly/events.rpy:589
translate russian emma_samantha_threesome_now_intro_041d881a:
    "Эмма и Сэм идут следом, пока я веду их к своей комнате."

# ch/harems/friendly/events.rpy:593
translate russian emma_samantha_threesome_now_intro_5e7a59d7:
    "Открываю дверь и пропускаю их внутрь."

# ch/harems/friendly/events.rpy:594
translate russian emma_samantha_threesome_now_intro_0d58eaf3:
    "Эмма и Сэм не теряли времени даром и уже устроились поудобнее."

# ch/harems/friendly/events.rpy:595
translate russian emma_samantha_threesome_now_intro_2f73b7f4:
    "А именно — обе полулежат на моей кровати и смотрят на меня."

# ch/harems/friendly/events.rpy:596
translate russian emma_samantha_threesome_now_intro_21c98596:
    "И теперь раздевают друг друга прямо передо мной."

# ch/harems/friendly/events.rpy:597
translate russian emma_samantha_threesome_now_intro_d7a08adc:
    "Я понимаю, что это представление должно меня возбудить."

# ch/harems/friendly/events.rpy:600
translate russian emma_samantha_threesome_now_intro_4546dbc0:
    "И внимательно смотрю, как две желанные девушки красуются передо мной."

# ch/harems/friendly/events.rpy:601
translate russian emma_samantha_threesome_now_intro_01fbbc81:
    "Сэм, как я и ожидал, берёт инициативу на себя."

# ch/harems/friendly/events.rpy:602
translate russian emma_samantha_threesome_now_intro_d77e8c51:
    "А Эмма старательно следует её примеру."

# ch/harems/friendly/events.rpy:603
translate russian emma_samantha_threesome_now_intro_f7c0508e:
    "Они снимают друг с друга одну вещь за другой."

# ch/harems/friendly/events.rpy:606
translate russian emma_samantha_threesome_now_intro_95cd40c6:
    "И к тому моменту, когда обе остаются голыми, я уже смотрю на них как зачарованный."

# ch/harems/friendly/events.rpy:607
translate russian emma_samantha_threesome_now_intro_d1b24669:
    "Обе стоят передо мной, и на них нет ничего, кроме улыбок."

# ch/harems/friendly/events.rpy:608
translate russian emma_samantha_threesome_now_intro_45692041:
    "Но я не сразу понимаю, почему они больше ничего не делают."

# ch/harems/friendly/events.rpy:609
translate russian emma_samantha_threesome_now_intro_d67d88ca:
    "А потом до меня доходит: они ждут моих указаний!"

# ch/harems/friendly/events.rpy:617
translate russian emma_samantha_threesome_e753bdfc:
    "Вместо ответа я встаю и делаю несколько шагов к ним."

# ch/harems/friendly/events.rpy:618
translate russian emma_samantha_threesome_a3baf103:
    "Сэм и Эмма молча и неподвижно смотрят, как я приближаюсь."

# ch/harems/friendly/events.rpy:619
translate russian emma_samantha_threesome_fa06cc43:
    "Подойдя, я кладу по руке на плечо каждой из них."

# ch/harems/friendly/events.rpy:620
translate russian emma_samantha_threesome_04c17859:
    "Затем мягко надавливаю вниз, подкрепляя жест кивком."

# ch/harems/friendly/events.rpy:621
translate russian emma_samantha_threesome_912b8136:
    "Эмма выглядит заметно растерянной."

# ch/harems/friendly/events.rpy:622
translate russian emma_samantha_threesome_f220ffbf:
    "Но Сэм, похоже, замечает это и берёт инициативу на себя."

# ch/harems/friendly/events.rpy:624
translate russian emma_samantha_threesome_f79804dd:
    "По одному её взгляду я понимаю: она точно знает, чего я хочу."

# ch/harems/friendly/events.rpy:625
translate russian emma_samantha_threesome_b3c50c21:
    "Сэм помогает Эмме опуститься ниже и направляет её руки к моим яйцам."

# ch/harems/friendly/events.rpy:627
translate russian emma_samantha_threesome_ca3e6fe8:
    "А сама в это время крепко обхватывает мой член."

# ch/harems/friendly/events.rpy:628
translate russian emma_samantha_threesome_be3b9022:
    "Затем открывает рот и высовывает язык."

# ch/harems/friendly/events.rpy:629
translate russian emma_samantha_threesome_ac05bb17:
    "Мы с Эммой заворожённо смотрим, как она закрывает глаза и приступает к делу."

# ch/harems/friendly/events.rpy:630
translate russian emma_samantha_threesome_0bdfa660:
    "Сначала Сэм дразнит головку моего члена, едва касаясь её губами."

# ch/harems/friendly/events.rpy:632
translate russian emma_samantha_threesome_188c668c:
    "Но постепенно берёт его в рот всё глубже."

# ch/harems/friendly/events.rpy:633
translate russian emma_samantha_threesome_22b58c4f:
    "Я вижу, насколько Эмму захватило это зрелище."

# ch/harems/friendly/events.rpy:634
translate russian emma_samantha_threesome_0b9a5bac:
    "И понемногу она начинает повторять за Сэм."

# ch/harems/friendly/events.rpy:635
translate russian emma_samantha_threesome_e17b9fda:
    "Я шумно втягиваю воздух, когда Эмма открывает рот и начинает сосать мои яйца."

# ch/harems/friendly/events.rpy:637
translate russian emma_samantha_threesome_96f97768:
    "Ей больше свойственен энтузиазм, чем умение, и это чувствуется в каждом движении."

# ch/harems/friendly/events.rpy:638
translate russian emma_samantha_threesome_fab6ce86:
    "Но Эмме всё равно удаётся сделать ласки Сэм ещё более яркими."

# ch/harems/friendly/events.rpy:640
translate russian emma_samantha_threesome_83f60073:
    "Тем временем Сэм ускоряет темп."

# ch/harems/friendly/events.rpy:641
translate russian emma_samantha_threesome_dbd2e44f:
    "Она берёт мой член в рот всё глубже."

# ch/harems/friendly/events.rpy:643
translate russian emma_samantha_threesome_4358195b:
    "Её голова непрерывно движется вверх-вниз."

# ch/harems/friendly/events.rpy:644
translate russian emma_samantha_threesome_5e7397b9:
    "И я уже жалею, что не ухватился за что-нибудь до того, как они начали!"

# ch/harems/friendly/events.rpy:646
translate russian emma_samantha_threesome_c339f2d1:
    "Серьёзно, они так хорошо меня ласкают, что у меня едва не кружится голова."

# ch/harems/friendly/events.rpy:647
translate russian emma_samantha_threesome_00ae53ed:
    "Ощущения достигают пика, когда Сэм начинает ещё и сжимать мой член рукой."

# ch/harems/friendly/events.rpy:649
translate russian emma_samantha_threesome_c7f0c74f:
    "Ни один его участок не остаётся без внимания."

# ch/harems/friendly/events.rpy:650
translate russian emma_samantha_threesome_e711ce48:
    "В такой ситуации долго не выдержит никто."

# ch/harems/friendly/events.rpy:652
translate russian emma_samantha_threesome_702f60cb:
    "Сэм, кажется, тоже это понимает и быстро выпускает мой член изо рта."

# ch/harems/friendly/events.rpy:653
translate russian emma_samantha_threesome_aac2631e:
    "Затем приподнимает Эмму, и теперь обе стоят передо мной на коленях."

# ch/harems/friendly/events.rpy:655
translate russian emma_samantha_threesome_656ee723:
    emma.say "А?"

# ch/harems/friendly/events.rpy:656
translate russian emma_samantha_threesome_6d2796bc:
    emma.say "Что теперь?"

# ch/harems/friendly/events.rpy:657
translate russian emma_samantha_threesome_dd282512:
    "Сэм лишь улыбается и открывает рот."

# ch/harems/friendly/events.rpy:659
translate russian emma_samantha_threesome_86646b4c:
    "И мгновение спустя я кончаю ей на лицо."

# ch/harems/friendly/events.rpy:661
translate russian emma_samantha_threesome_de1054f4:
    emma.say "Ах..."

# ch/harems/friendly/events.rpy:662
translate russian emma_samantha_threesome_f264f28b:
    emma.say "О боже..."

# ch/harems/friendly/events.rpy:663
translate russian emma_samantha_threesome_f609aa28:
    "Сэм заранее открыла рот в предвкушении."

# ch/harems/friendly/events.rpy:664
translate russian emma_samantha_threesome_9726a1ba:
    "И благодаря этому мне удаётся попасть прямо в него!"

# ch/harems/friendly/events.rpy:665
translate russian emma_samantha_threesome_5f050882:
    "Остальное ложится полосами на её щёки и брызгает на подбородок."

# ch/harems/friendly/events.rpy:666
translate russian emma_samantha_threesome_c5d210bf:
    "Сэм смеётся и проглатывает всё, что набрала в рот."

# ch/harems/friendly/events.rpy:668
translate russian emma_samantha_threesome_a7db058b:
    "Эмма всё ещё немного держится в стороне, словно робеет."

# ch/harems/friendly/events.rpy:669
translate russian emma_samantha_threesome_4bff752b:
    "Я прекрасно это вижу, а по взгляду Сэм понимаю, что она тоже заметила."

# ch/harems/friendly/events.rpy:670
translate russian emma_samantha_threesome_d5d707bb:
    "Никто из нас не собирается говорить об этом вслух и смущать Эмму."

# ch/harems/friendly/events.rpy:671
translate russian emma_samantha_threesome_cab90623:
    "Но почти одновременно мы начинаем действовать, показывая ей, что делать дальше."

# ch/harems/friendly/events.rpy:672
translate russian emma_samantha_threesome_7edca6a8:
    "Сэм забирается на меня и заставляет откинуться спиной на кровать."

# ch/harems/friendly/events.rpy:673
translate russian emma_samantha_threesome_f9c2b4b1:
    "И через считаные секунды уже сидит верхом на моих бёдрах."

# ch/harems/friendly/events.rpy:674
translate russian emma_samantha_threesome_1ec72435:
    "Я почти целиком поглощён тем, что Сэм сейчас со мной делает."

# ch/harems/friendly/events.rpy:675
translate russian emma_samantha_threesome_2b49e439:
    "Но всё же умудряюсь украдкой взглянуть на Эмму."

# ch/harems/friendly/events.rpy:676
translate russian emma_samantha_threesome_de093662:
    "И с огромным облегчением вижу, что она подбирается всё ближе."

# ch/harems/friendly/events.rpy:680
translate russian emma_samantha_threesome_bed4f3c8:
    "Значит, я могу сосредоточить всё внимание на Сэм."

# ch/harems/friendly/events.rpy:681
translate russian emma_samantha_threesome_f6969334:
    "Особенно сейчас, когда она опускает руку и обхватывает мой член!"

# ch/harems/friendly/events.rpy:682
translate russian emma_samantha_threesome_732a803d:
    samantha.say "Ну что, [lssb_common.hero_name()]..."

# ch/harems/friendly/events.rpy:683
translate russian emma_samantha_threesome_d79da832:
    samantha.say "Приступим к делу!"

# ch/harems/friendly/events.rpy:686
translate russian emma_samantha_threesome_7bc7b7e5:
    "Хотя Сэм произносит это властным тоном, командовать здесь одной ей не придётся."

# ch/harems/friendly/events.rpy:687
translate russian emma_samantha_threesome_58044e37:
    "Потому что я готов и хочу начать ничуть не меньше."

# ch/harems/friendly/events.rpy:688
translate russian emma_samantha_threesome_f85b5238:
    "Именно поэтому следом с её губ срывается удивлённый вскрик."

# ch/harems/friendly/events.rpy:689
translate russian emma_samantha_threesome_25aae950:
    "Обхватив Сэм за талию, я тяну её вниз."

# ch/harems/friendly/events.rpy:690
translate russian emma_samantha_threesome_3709cd2e:
    "Она держит мой член, так что мне даже не приходится целиться."

# ch/harems/friendly/events.rpy:691
translate russian emma_samantha_threesome_fda93181:
    "Головка направлена прямо к её киске."

# ch/harems/friendly/events.rpy:692
translate russian emma_samantha_threesome_015b9f69:
    "И оказывается именно там, потираясь о половые губы."

# ch/harems/friendly/events.rpy:693
translate russian emma_samantha_threesome_c6fd6576:
    "А они с каждой секундой становятся всё влажнее!"

# ch/harems/friendly/events.rpy:694
translate russian emma_samantha_threesome_09fbeb17:
    samantha.say "О-о..."

# ch/harems/friendly/events.rpy:695
translate russian emma_samantha_threesome_6375cd3b:
    samantha.say "Ох, боже..."

# ch/harems/friendly/events.rpy:696
translate russian emma_samantha_threesome_981c3ed0:
    mike.say "Нравится, да?"

# ch/harems/friendly/events.rpy:697
translate russian emma_samantha_threesome_bd8692d6:
    "Сэм отчаянно кивает, продолжая тихонько постанывать."

# ch/harems/friendly/events.rpy:698
translate russian emma_samantha_threesome_ed8c6dce:
    mike.say "Хочешь ещё?"

# ch/harems/friendly/events.rpy:699
translate russian emma_samantha_threesome_35a0b7be:
    "Сэм снова кивает и уже сама опускается на меня."

# ch/harems/friendly/events.rpy:700
translate russian emma_samantha_threesome_f87437dc:
    "Я киваю и улыбаюсь, с радостью готовый исполнить её желание."

# ch/harems/friendly/events.rpy:706
translate russian emma_samantha_threesome_7e413be4:
    "Мне достаточно слегка толкнуться, а ей — немного податься навстречу."

# ch/harems/friendly/events.rpy:707
translate russian emma_samantha_threesome_93a9b89b:
    "И я чувствую, как половые губы Сэм начинают раздвигаться."

# ch/harems/friendly/events.rpy:708
translate russian emma_samantha_threesome_4ee1c6be:
    "Поначалу я ожидаю, что она будет опускаться медленно, понемногу."

# ch/harems/friendly/events.rpy:709
translate russian emma_samantha_threesome_4834770e:
    "Но вдруг сопротивление почти совсем исчезает."

# ch/harems/friendly/events.rpy:710
translate russian emma_samantha_threesome_469685d5:
    "И Сэм одним движением насаживается на меня."

# ch/harems/friendly/events.rpy:712
translate russian emma_samantha_threesome_04e2951a:
    "Она стонет, когда мой член заполняет её, не в силах замедлиться."

# ch/harems/friendly/events.rpy:713
translate russian emma_samantha_threesome_919dcd26:
    "А когда глубже уже некуда, издаёт удовлетворённый стон."

# ch/harems/friendly/events.rpy:714
translate russian emma_samantha_threesome_b9748bfd:
    "Всё произошло так быстро, что я почти обязан сменить темп."

# ch/harems/friendly/events.rpy:715
translate russian emma_samantha_threesome_70c88445:
    "Поэтому начинаю двигаться в Сэм так медленно, как только могу."

# ch/harems/friendly/events.rpy:716
translate russian emma_samantha_threesome_c73956df:
    "Кажется, она ценит мои старания и кивает, когда я начинаю трахать её."

# ch/harems/friendly/events.rpy:717
translate russian emma_samantha_threesome_3013801f:
    "Она опирается на мою грудь и позволяет мне делать с ней всё, что захочу."

# ch/harems/friendly/events.rpy:718
translate russian emma_samantha_threesome_763556dc:
    "Только теперь я замечаю необычные движения и стоны Сэм."

# ch/harems/friendly/events.rpy:720
translate russian emma_samantha_threesome_ef39c4e7:
    "Она двигается так, словно удовольствие доставляет ей что-то ещё."

# ch/harems/friendly/events.rpy:721
translate russian emma_samantha_threesome_72988f61:
    "Загадка раскрывается, когда за её плечом я замечаю Эмму."

# ch/harems/friendly/events.rpy:722
translate russian emma_samantha_threesome_b325547f:
    "Часть меня допускала, что она вообще решит остаться в стороне."

# ch/harems/friendly/events.rpy:723
translate russian emma_samantha_threesome_b9ba0a24:
    "Что в этот раз просто посмотрит, как мы с Сэм занимаемся сексом."

# ch/harems/friendly/events.rpy:724
translate russian emma_samantha_threesome_b3cdbc97:
    "Но теперь я вижу: Эмма, наоборот, пользуется ситуацией."

# ch/harems/friendly/events.rpy:725
translate russian emma_samantha_threesome_6b8f1b8b:
    "Пока мы с Сэм заняты, она вольна делать почти всё, что захочет."

# ch/harems/friendly/events.rpy:726
translate russian emma_samantha_threesome_e83db660:
    "И эту свободу она использует, чтобы ласкать тело Сэм."

# ch/harems/friendly/events.rpy:728
translate russian emma_samantha_threesome_f3619e9d:
    "Эмма играет с ней, почти что экспериментирует."

# ch/harems/friendly/events.rpy:729
translate russian emma_samantha_threesome_dc19fad7:
    "И замечает каждый раз, когда её ласки особенно нравятся подруге."

# ch/harems/friendly/events.rpy:730
translate russian emma_samantha_threesome_4b42d5c7:
    "Сама Сэм будто бы почти не замечает присутствия Эммы."

# ch/harems/friendly/events.rpy:731
translate russian emma_samantha_threesome_f05c4db1:
    "Сейчас она слишком увлечена тем, как скачет на моём члене!"

# ch/harems/friendly/events.rpy:732
translate russian emma_samantha_threesome_37b94a58:
    "Но я вижу, как сильно действуют на неё старания Эммы."

# ch/harems/friendly/events.rpy:733
translate russian emma_samantha_threesome_51aa33d3:
    "Выглянув из-за плеча подруги, Эмма ловит мой взгляд."

# ch/harems/friendly/events.rpy:734
translate russian emma_samantha_threesome_48777884:
    "И одаривает меня лукавой улыбкой."

# ch/harems/friendly/events.rpy:735
translate russian emma_samantha_threesome_65632edc:
    "Звучит странно, но это будоражит почти так же сильно, как находиться внутри Сэм!"

