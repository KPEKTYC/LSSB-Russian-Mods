# ch/harems/friendly/events.rpy:303
translate russian emma_samantha_showdown_643d4607_1:
    "Теперь и я вскакиваю на ноги."

# ch/harems/friendly/events.rpy:304
translate russian emma_samantha_showdown_7f54c672_1:
    "И протягиваю руку к Эмме."

# ch/harems/friendly/events.rpy:305
translate russian emma_samantha_showdown_8eb89f35_1:
    mike.say "Эмма, пожалуйста!"

# ch/harems/friendly/events.rpy:306
translate russian emma_samantha_showdown_989a17b8_1:
    mike.say "Ты всё не так поняла..."

# ch/harems/friendly/events.rpy:308
translate russian emma_samantha_showdown_0e1a7e0f_1:
    mike.say "Кексик — просто моя давняя подруга, вот и всё."

# ch/harems/friendly/events.rpy:310
translate russian emma_samantha_showdown_685f1ec8_1:
    mike.say "Сэм — просто моя давняя подруга, вот и всё."

# ch/harems/friendly/events.rpy:311
translate russian emma_samantha_showdown_f71e2f45_1:
    mike.say "Ей в последнее время нелегко пришлось."

# ch/harems/friendly/events.rpy:312
translate russian emma_samantha_showdown_962f5ac5:
