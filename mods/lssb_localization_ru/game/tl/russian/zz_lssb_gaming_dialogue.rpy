# Native Gaming identifiers, current source catalog. Translation only.

# ch/harems_full/gaming/events.rpy:53
translate russian bree_kat_threesome_02cab52d:
    "Я отрываюсь от стопки игр перед собой, когда [bree.name] поспешно входит в гостиную."

# ch/harems_full/gaming/events.rpy:54
translate russian bree_kat_threesome_27cbf110:
    "У неё серьёзное лицо — почти такое же серьёзное, как сейчас у меня."

# ch/harems_full/gaming/events.rpy:55
translate russian bree_kat_threesome_1bd45b8d:
    mike.say "Всё готово, [bree.name]?"

# ch/harems_full/gaming/events.rpy:56
translate russian bree_kat_threesome_a25ca313:
    mike.say "Можно начинать?"

# ch/harems_full/gaming/events.rpy:57
translate russian bree_kat_threesome_63672c06:
    "[bree.name] чётко кивает, словно стоит по стойке смирно и отдаёт мне честь."

# ch/harems_full/gaming/events.rpy:59
translate russian bree_kat_threesome_49d3baac:
    bree.say "Так точно, [lssb_common.hero_name()]!"

# ch/harems_full/gaming/events.rpy:60
translate russian bree_kat_threesome_dba261a0:
    bree.say "Мы готовы на все сто процентов."

# ch/harems_full/gaming/events.rpy:61
translate russian bree_kat_threesome_c0b864ff:
    bree.say "Обо всём позаботились!"

# ch/harems_full/gaming/events.rpy:63
translate russian bree_kat_threesome_95f1b51d:
    "Я прищуриваюсь, словно хочу насквозь увидеть, что скрывает [bree.name]."

# ch/harems_full/gaming/events.rpy:64
translate russian bree_kat_threesome_648134d4:
    mike.say "Уверена, [bree.name]?"

# ch/harems_full/gaming/events.rpy:65
translate russian bree_kat_threesome_93d63763:
    mike.say "Все двери заперты?"

# ch/harems_full/gaming/events.rpy:67
translate russian bree_kat_threesome_a627bb6c:
    bree.say "Заперты И закрыты на засов."

# ch/harems_full/gaming/events.rpy:68
translate russian bree_kat_threesome_853f0cae:
    mike.say "Телефон выключен?"

# ch/harems_full/gaming/events.rpy:70
translate russian bree_kat_threesome_30198d1e:
    bree.say "Мёртв, как окаменевший кирпич."

# ch/harems_full/gaming/events.rpy:71
translate russian bree_kat_threesome_d406eb51:
    mike.say "Перекуса нам хватит?"

# ch/harems_full/gaming/events.rpy:73
translate russian bree_kat_threesome_26468ef1:
    bree.say "Чипсов и пиццы столько, что прыщами покроемся до конца жизни!"

# ch/harems_full/gaming/events.rpy:74
translate russian bree_kat_threesome_7f3added:
    mike.say "И ты ТОЧНО уверена, что Саши нет дома?"

# ch/harems_full/gaming/events.rpy:76
translate russian bree_kat_threesome_aecea63d:
    bree.say "У неё репетиция с группой, а потом бар."

# ch/harems_full/gaming/events.rpy:77
translate russian bree_kat_threesome_fb434804:
    bree.say "Она скорее вырубится под столом, чем доберётся домой!"

# ch/harems_full/gaming/events.rpy:78
translate russian bree_kat_threesome_fa0335fc:
    "Я киваю, наконец убедившись, что всё действительно предусмотрено."

# ch/harems_full/gaming/events.rpy:80
translate russian bree_kat_threesome_e3aee183:
    mike.say "ВОТ ТЕПЕР можно как следует поиграть!"

# ch/harems_full/gaming/events.rpy:82
translate russian bree_kat_threesome_19fbc8e9:
    bree.say "УРА!"

# ch/harems_full/gaming/events.rpy:83
translate russian bree_kat_threesome_d4145577:
    "[bree.name] подпрыгивает на месте и хлопает в ладоши."

# ch/harems_full/gaming/events.rpy:85
translate russian bree_kat_threesome_7ee42f75:
    "Затем подбегает и хватает геймпад."

# ch/harems_full/gaming/events.rpy:86
translate russian bree_kat_threesome_49f6458e:
    "Усевшись на пол рядом со мной, она громко хрустит пальцами."

# ch/harems_full/gaming/events.rpy:87
translate russian bree_kat_threesome_a3c010d7:
    bree.say "Я готова, [lssb_common.hero_name()]."

# ch/harems_full/gaming/events.rpy:88
translate russian bree_kat_threesome_b225590a:
    bree.say "Поехали!"

# ch/harems_full/gaming/events.rpy:90
translate russian bree_kat_threesome_e6f5aea5:
    "[bree.name] и я относимся к играм серьёзно!"

# ch/harems_full/gaming/events.rpy:91
translate russian bree_kat_threesome_fe792442:
    "Конечно, иногда мы играем просто так, под настроение."

# ch/harems_full/gaming/events.rpy:92
translate russian bree_kat_threesome_791ca31c:
    "Но сейчас намечен серьёзный игровой марафон, который мы давно планировали."

# ch/harems_full/gaming/events.rpy:93
translate russian bree_kat_threesome_69e156c4:
    "А значит, [bree.name] и я уделим ему всё наше внимание."

# ch/harems_full/gaming/events.rpy:94
translate russian bree_kat_threesome_f2d50f95:
    "Помня об этом, мы молча обмениваемся кивками."

# ch/harems_full/gaming/events.rpy:95
translate russian bree_kat_threesome_af547411:
    "И приступаем!"

# ch/harems_full/gaming/events.rpy:96
translate russian bree_kat_threesome_c75b55e8:
    mike.say "Надеюсь, ты готова получить по заднице, [bree.name]!"

# ch/harems_full/gaming/events.rpy:97
translate russian bree_kat_threesome_1b96789a:
    bree.say "Ах да?"

# ch/harems_full/gaming/events.rpy:98
translate russian bree_kat_threesome_04989d2d:
    bree.say "Ещё посмотрим, чья задница пострадает, [lssb_common.hero_name()]!"

# ch/harems_full/gaming/events.rpy:99
translate russian bree_kat_threesome_1021b2f7:
    "Теперь мы буквально сверлим друг друга взглядами."

# ch/harems_full/gaming/events.rpy:100
translate russian bree_kat_threesome_39a4d847:
    "Оба на взводе и готовы к бою!"

# ch/harems_full/gaming/events.rpy:101
translate russian bree_kat_threesome_ac5dfd6f:
    "Господи... У других людей совместные игры тоже вызывают такое сексуальное напряжение?"

# ch/harems_full/gaming/events.rpy:103
translate russian bree_kat_threesome_620a020a:
    "И именно в этот момент всё прерывает стук в дверь."

# ch/harems_full/gaming/events.rpy:107
translate russian bree_kat_threesome_7dd6c7e2:
    "[bree.name] бросает злобный взгляд на входную дверь."

# ch/harems_full/gaming/events.rpy:109
translate russian bree_kat_threesome_c5eaf117:
    "[bree.name] и я одновременно бросаем злобные взгляды на входную дверь."

# ch/harems_full/gaming/events.rpy:110
translate russian bree_kat_threesome_ed2eb72c:
    bree.say "Кого ещё чёрт принёс?"

# ch/harems_full/gaming/events.rpy:111
translate russian bree_kat_threesome_535106c7:
    mike.say "Понятия не имею!"

# ch/harems_full/gaming/events.rpy:113
translate russian bree_kat_threesome_1b1c91ca:
    "На самом деле я прекрасно знаю, кто это."

# ch/harems_full/gaming/events.rpy:114
translate russian bree_kat_threesome_7eda1f69:
    "Потому что сам пригласил её."

# ch/harems_full/gaming/events.rpy:115
translate russian bree_kat_threesome_f088c151:
    "За дверью Кэт."

# ch/harems_full/gaming/events.rpy:116
translate russian bree_kat_threesome_9f41501b:
    "И тут я с ужасом понимаю, что [bree.name] ничего об этом не знает: я забыл ей сказать."

# ch/harems_full/gaming/events.rpy:117
translate russian bree_kat_threesome_34df5659:
    "А ещё хуже то, что я забыл упомянуть: Кэт хочет секса втроём с нами!"

# ch/harems_full/gaming/events.rpy:119
translate russian bree_kat_threesome_9ada12e8:
    bree.say "Хм..."

# ch/harems_full/gaming/events.rpy:120
translate russian bree_kat_threesome_646de1f8:
    bree.say "Может, если не обращать внимания, им надоест и они уйдут?"

# ch/harems_full/gaming/events.rpy:121
translate russian bree_kat_threesome_d4b49925:
    mike.say "Не-а... Могут вернуться и постучать ещё раз."

# ch/harems_full/gaming/events.rpy:122
translate russian bree_kat_threesome_665f2953:
    mike.say "Давай просто посмотрим, кто там, и отделаемся от них."

# ch/harems_full/gaming/events.rpy:124
translate russian bree_kat_threesome_8c65a947:
    "[bree.name] кивает, и мы оба встаём, чтобы открыть."

# ch/harems_full/gaming/events.rpy:125
translate russian bree_kat_threesome_32705d5a:
    "В прихожей я распахиваю входную дверь."

# ch/harems_full/gaming/events.rpy:126
translate russian bree_kat_threesome_bdb4a9df:
    "[bree.name] стоит рядом со мной, скрестив руки на груди."

# ch/harems_full/gaming/events.rpy:127
translate russian bree_kat_threesome_1de81d01:
    "С таким её видом я бы сейчас не рискнул с ней связываться!"

# ch/harems_full/gaming/events.rpy:132
translate russian bree_kat_threesome_caf315db:
    "Но, увидев, кто пришёл, [bree.name] не может скрыть удивления."

# ch/harems_full/gaming/events.rpy:134
translate russian bree_kat_threesome_ab8a4ad9:
    "Но, увидев, кто пришёл, мы оба не можем скрыть удивления."

# ch/harems_full/gaming/events.rpy:135
translate russian bree_kat_threesome_73306953:
    kat.say "Эм..."

# ch/harems_full/gaming/events.rpy:136
translate russian bree_kat_threesome_af2c7651:
    kat.say "Привет, ребята!"

# ch/harems_full/gaming/events.rpy:137
translate russian bree_kat_threesome_6058ea01:
    kat.say "Это я, Кэт. Вы ведь меня помните?"

# ch/harems_full/gaming/events.rpy:139
translate russian bree_kat_threesome_9162fe0e:
    "[bree.name] озадаченно смотрит на меня, а затем снова на нашу неожиданную гостью."

# ch/harems_full/gaming/events.rpy:141
translate russian bree_kat_threesome_caf6042a:
    "[bree.name] и я озадаченно переглядываемся, а затем снова смотрим на нашу неожиданную гостью."

# ch/harems_full/gaming/events.rpy:142
translate russian bree_kat_threesome_4474f40e:
    "Фиолетовые волосы и слегка угрюмое выражение лица ни с чем не спутаешь."

# ch/harems_full/gaming/events.rpy:144
translate russian bree_kat_threesome_954765c4:
    "[bree.name] точно узнаёт Кэт, свою соперницу по игровому турниру."

# ch/harems_full/gaming/events.rpy:145
translate russian bree_kat_threesome_5db161e6:
    "[bree.name] на секунду отводит взгляд от нас обоих, и Кэт подмигивает мне."

# ch/harems_full/gaming/events.rpy:146
translate russian bree_kat_threesome_0d3c7d22:
    "Напоминая о плане, который мы вместе придумали."

# ch/harems_full/gaming/events.rpy:148
translate russian bree_kat_threesome_bc480a9d:
    "Это точно Кэт, та самая девушка, с которой [bree.name] состязалась на игровом турнире."

# ch/harems_full/gaming/events.rpy:149
translate russian bree_kat_threesome_724d690e:
    mike.say "Да, конечно..."

# ch/harems_full/gaming/events.rpy:152
translate russian bree_kat_threesome_7fff7565:
    bree.say "Привет, Кэт..."

# ch/harems_full/gaming/events.rpy:153
translate russian bree_kat_threesome_149139f8:
    bree.say "Вот уж не ожидала увидеть тебя здесь!"

# ch/harems_full/gaming/events.rpy:156
translate russian bree_kat_threesome_36e168fa:
    bree.say "Ты чего-то хотела?"

# ch/harems_full/gaming/events.rpy:157
translate russian bree_kat_threesome_ed5596c0:
    bree.say "Или теперь ходишь по домам и что-то продаёшь?"

# ch/harems_full/gaming/events.rpy:159
translate russian bree_kat_threesome_06093889:
    mike.say "Ты чего-то хотела?"

# ch/harems_full/gaming/events.rpy:160
translate russian bree_kat_threesome_b11f573c:
    mike.say "Или теперь ходишь по домам и что-то продаёшь?"

# ch/harems_full/gaming/events.rpy:161
translate russian bree_kat_threesome_fe4b955d:
    "Кэт слегка краснеет и выглядит ещё более неловко, чем обычно."

# ch/harems_full/gaming/events.rpy:163
translate russian bree_kat_threesome_76706b5f:
    "Она поглядывает на меня, словно ждёт, что я приду на помощь."

# ch/harems_full/gaming/events.rpy:164
translate russian bree_kat_threesome_7a340d88:
    mike.say "Ладно, [bree.name]..."

# ch/harems_full/gaming/events.rpy:165
translate russian bree_kat_threesome_73072930:
    mike.say "Раскрою карты."

# ch/harems_full/gaming/events.rpy:166
translate russian bree_kat_threesome_52d96d19:
    mike.say "Кэт спросила, можно ли ей присоединиться к нашим играм."

# ch/harems_full/gaming/events.rpy:167
translate russian bree_kat_threesome_018ae00f:
    mike.say "Я согласился и собирался потом обсудить это с тобой."

# ch/harems_full/gaming/events.rpy:168
translate russian bree_kat_threesome_908275ce:
    mike.say "Но взял и забыл."

# ch/harems_full/gaming/events.rpy:169
translate russian bree_kat_threesome_1cd6bf68:
    kat.say "Так что скажешь, [bree.name]?"

# ch/harems_full/gaming/events.rpy:170
translate russian bree_kat_threesome_9d288ca5:
    kat.say "Не против, если я тоже поиграю?"

# ch/harems_full/gaming/events.rpy:172
translate russian bree_kat_threesome_ac87ceab:
    "Но она всё же набирается смелости объясниться."

# ch/harems_full/gaming/events.rpy:173
translate russian bree_kat_threesome_8addc338:
    kat.say "Я... я просто увидела, что вы играете в видеоигры."

# ch/harems_full/gaming/events.rpy:174
translate russian bree_kat_threesome_dc6e3def:
    kat.say "И подумала: может, вы не против, если я присоединюсь?"

# ch/harems_full/gaming/events.rpy:175
translate russian bree_kat_threesome_68a75209:
    "Я невольно хмурюсь и оглядываюсь."

# ch/harems_full/gaming/events.rpy:177
translate russian bree_kat_threesome_e43bc011:
    mike.say "Откуда ты узнала?"

# ch/harems_full/gaming/events.rpy:178
translate russian bree_kat_threesome_369586f2:
    mike.say "Ты за нами шпионила?!"

# ch/harems_full/gaming/events.rpy:179
translate russian bree_kat_threesome_2af107d0:
    "Кэт качает головой и показывает телефон."

# ch/harems_full/gaming/events.rpy:180
translate russian bree_kat_threesome_91bb36be:
    kat.say "Нет!"

# ch/harems_full/gaming/events.rpy:181
translate russian bree_kat_threesome_b5bdf3a3:
    kat.say "Конечно нет!"

# ch/harems_full/gaming/events.rpy:182
translate russian bree_kat_threesome_7d6a12e4:
    kat.say "Вы просто вошли в Zbox Network, вот и всё..."

# ch/harems_full/gaming/events.rpy:184
translate russian bree_kat_threesome_b6249b7f:
    "[bree.name] хлопает себя по лбу и стонет."

# ch/harems_full/gaming/events.rpy:186
translate russian bree_kat_threesome_7f32961a:
    bree.say "Ну конечно, вот что мы забыли!"

# ch/harems_full/gaming/events.rpy:187
translate russian bree_kat_threesome_477c7d62:
    mike.say "Чёрт..."

# ch/harems_full/gaming/events.rpy:188
translate russian bree_kat_threesome_9cb169f3:
    mike.say "Все в сети видят, во что мы играем!"

# ch/harems_full/gaming/events.rpy:189
translate russian bree_kat_threesome_b96002ef:
    "Кэт кивает и нервно улыбается."

# ch/harems_full/gaming/events.rpy:190
translate russian bree_kat_threesome_cda71d6d:
    kat.say "Так..."

# ch/harems_full/gaming/events.rpy:191
translate russian bree_kat_threesome_5e437194:
    kat.say "Что скажете?"

# ch/harems_full/gaming/events.rpy:195
translate russian bree_kat_threesome_8b4e023e:
    "[bree.name] пожимает плечами и поворачивается ко мне."

# ch/harems_full/gaming/events.rpy:196
translate russian bree_kat_threesome_3e5e4650:
    bree.say "Думаю, место для неё найдётся?"

# ch/harems_full/gaming/events.rpy:198
translate russian bree_kat_threesome_f0144bb5:
    bree.say "Но на тебя я злюсь, [lssb_common.hero_name()]!"

# ch/harems_full/gaming/events.rpy:199
translate russian bree_kat_threesome_1029a68a:
    mike.say "Прости, [bree.name]..."

# ch/harems_full/gaming/events.rpy:200
translate russian bree_kat_threesome_a835fd8c:
    mike.say "Я заглажу вину, хорошо?"

# ch/harems_full/gaming/events.rpy:201
translate russian bree_kat_threesome_d738e061:
    mike.say "И вообще, я же не нуба пригласил, правда?"

# ch/harems_full/gaming/events.rpy:202
translate russian bree_kat_threesome_037d5d86:
    mike.say "Ты уже знаешь, как хорошо Кэт играет."

# ch/harems_full/gaming/events.rpy:207
translate russian bree_kat_threesome_f1d0e7c2:
    bree.say "Что думаешь, [lssb_common.hero_name()]?"

# ch/harems_full/gaming/events.rpy:211
translate russian bree_kat_threesome_0a255b68:
    mike.say "Мне не очень нравится, что она следит за нами в Zbox Network, [bree.name]!"

# ch/harems_full/gaming/events.rpy:212
translate russian bree_kat_threesome_7c5bf220:
    mike.say "Может, пригласим её в следующий раз."

# ch/harems_full/gaming/events.rpy:213
translate russian bree_kat_threesome_66af5f0e:
    mike.say "Но сейчас я хочу поиграть только с тобой!"

# ch/harems_full/gaming/events.rpy:215
translate russian bree_kat_threesome_4b20decc:
    "[bree.name] кивает."

# ch/harems_full/gaming/events.rpy:217
translate russian bree_kat_threesome_b447912b:
    "Затем поворачивается к Кэт и качает головой."

# ch/harems_full/gaming/events.rpy:218
translate russian bree_kat_threesome_c24fa568:
    bree.say "Прости, Кэт, ты слышала, что он сказал!"

# ch/harems_full/gaming/events.rpy:219
translate russian bree_kat_threesome_01faf92b:
    bree.say "Свяжись с нами в следующий раз, ладно?"

# ch/harems_full/gaming/events.rpy:220
translate russian bree_kat_threesome_9d418cd2:
    "На лицо Кэт возвращается привычное безразличие."

# ch/harems_full/gaming/events.rpy:221
translate russian bree_kat_threesome_96ff4fc7:
    "Она кивает, словно разочарованная, но смирившаяся."

# ch/harems_full/gaming/events.rpy:222
translate russian bree_kat_threesome_88ba0897:
