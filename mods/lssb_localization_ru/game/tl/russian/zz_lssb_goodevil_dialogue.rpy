    lexi.say "Я поняла."

# ch/harems_full/goodevil/events.rpy:554
translate russian goodevil_harem_event_01_e6a00c09:
    "Я киваю, пытаясь закрыть тему."

# ch/harems_full/goodevil/events.rpy:555
translate russian goodevil_harem_event_01_e2792fcd:
    "Неприятно ссориться в самом начале свидания."

# ch/harems_full/goodevil/events.rpy:556
translate russian goodevil_harem_event_01_3a16dc2b:
    "Но иногда приходится проявить твёрдость."

# ch/harems_full/goodevil/events.rpy:560
translate russian goodevil_harem_event_01_2ff92c5b:
    "Я поднимаю руки, призывая к миру."

# ch/harems_full/goodevil/events.rpy:562
translate russian goodevil_harem_event_01_fad1b5b8:
    mike.say "Неважно, кто во сколько пришёл."

# ch/harems_full/goodevil/events.rpy:563
translate russian goodevil_harem_event_01_d6b7b619:
    mike.say "Главное, что теперь мы все здесь."

# ch/harems_full/goodevil/events.rpy:564
translate russian goodevil_harem_event_01_5eeb4e73:
    mike.say "И отлично проведём время, правда?"

# ch/harems_full/goodevil/events.rpy:567
translate russian goodevil_harem_event_01_7049e662:
    "Обе девушки открывают рот, собираясь возразить."

# ch/harems_full/goodevil/events.rpy:568
translate russian goodevil_harem_event_01_95dabce2:
    "Но замечают, что другая делает то же самое."

# ch/harems_full/goodevil/events.rpy:571
translate russian goodevil_harem_event_01_c8124e18:
    "И этого, похоже, хватает, чтобы не раздувать ссору."

# ch/harems_full/goodevil/events.rpy:572
translate russian goodevil_harem_event_01_93d09f33:
    "Ладно, извинений ни от одной я не услышал."

# ch/harems_full/goodevil/events.rpy:573
translate russian goodevil_harem_event_01_cc4ac7ce:
    "Но это хотя бы временное перемирие."

# ch/harems_full/goodevil/events.rpy:574
translate russian goodevil_harem_event_01_744cc2e8_2:
    harmony.say "Хорошо, [lssb_common.hero_name()]..."

# ch/harems_full/goodevil/events.rpy:576
translate russian goodevil_harem_event_01_1fcf2a3f_2:
    harmony.say "Я тебя поняла."

# ch/harems_full/goodevil/events.rpy:577
translate russian goodevil_harem_event_01_9671adb0_2:
    lexi.say "Ладно, ладно..."

# ch/harems_full/goodevil/events.rpy:579
translate russian goodevil_harem_event_01_68551276_2:
    lexi.say "Я поняла."

# ch/harems_full/goodevil/events.rpy:580
translate russian goodevil_harem_event_01_e6a00c09_1:
    "Я киваю, пытаясь закрыть тему."

# ch/harems_full/goodevil/events.rpy:581
translate russian goodevil_harem_event_01_54933fc4:
    "Приятно, что удалось избежать ссоры в самом начале."

# ch/harems_full/goodevil/events.rpy:582
translate russian goodevil_harem_event_01_f129305e:
    "Надеюсь, дальше будет только лучше."

# ch/harems_full/goodevil/events.rpy:588
translate russian goodevil_harem_event_01_8700337a:
    "Заходя в стрип-клуб, я на мгновение окидываю девушек взглядом."

# ch/harems_full/goodevil/events.rpy:593
translate russian goodevil_harem_event_01_12f350d0:
    "Обе одеты в своём привычном, узнаваемом стиле."

# ch/harems_full/goodevil/events.rpy:594
translate russian goodevil_harem_event_01_1e31dcc0:
    "И ни одна не видит особого смысла прикрывать тело."

# ch/harems_full/goodevil/events.rpy:595
translate russian goodevil_harem_event_01_95384a1e:
    "Но Хармони явно предпочитает более броские вещи."

# ch/harems_full/goodevil/events.rpy:596
translate russian goodevil_harem_event_01_d58c6925:
    "А Лекси по-прежнему верна стилю трейлерного парка!"

# ch/harems_full/goodevil/events.rpy:597
translate russian goodevil_harem_event_01_90a40ac8:
    "Мой взгляд скользит от одной к другой."

# ch/harems_full/goodevil/events.rpy:598
translate russian goodevil_harem_event_01_7cabb854:
    "Но, похоже, незаметно это сделать не удалось."

# ch/harems_full/goodevil/events.rpy:599
translate russian goodevil_harem_event_01_56d7ad9b:
    lexi.say "Прямо чувствую, как ты меня разглядываешь, [lssb_common.hero_name()]!"

# ch/harems_full/goodevil/events.rpy:601
translate russian goodevil_harem_event_01_701f2d0b:
    lexi.say "Нравится то, что видишь?"

# ch/harems_full/goodevil/events.rpy:603
translate russian goodevil_harem_event_01_9b52ceb8:
    harmony.say "Прошу прощения..."

# ch/harems_full/goodevil/events.rpy:605
translate russian goodevil_harem_event_01_952d738a:
    harmony.say "Вообще-то он разглядывал меня!"

# ch/harems_full/goodevil/events.rpy:606
translate russian goodevil_harem_event_01_4562d06d:
    "Уф..."

# ch/harems_full/goodevil/events.rpy:607
translate russian goodevil_harem_event_01_2793823e:
    "Мы внутри всего пару минут."

# ch/harems_full/goodevil/events.rpy:608
translate russian goodevil_harem_event_01_0eca71e1:
    "А они уже начинают новую ссору!"

# ch/harems_full/goodevil/events.rpy:611
translate russian goodevil_harem_event_01_72f8a846:
    mike.say "Послушай, Лекси..."

# ch/harems_full/goodevil/events.rpy:612
translate russian goodevil_harem_event_01_1749a190:
    mike.say "Мне нравится твой наряд, правда."

# ch/harems_full/goodevil/events.rpy:615
translate russian goodevil_harem_event_01_be574f00:
    mike.say "Но Хармони просто чуть больше постаралась."

# ch/harems_full/goodevil/events.rpy:617
translate russian goodevil_harem_event_01_cf13e300:
    mike.say "Разве нет?"

# ch/harems_full/goodevil/events.rpy:619
translate russian goodevil_harem_event_01_df7c46d7:
    "При этих словах в глазах Лекси вспыхивает злость."

# ch/harems_full/goodevil/events.rpy:621
translate russian goodevil_harem_event_01_9e4dff55:
    "А Хармони почти краснеет от комплимента."

# ch/harems_full/goodevil/events.rpy:622
translate russian goodevil_harem_event_01_3c223e58:
    harmony.say "Ну, спасибо!"

# ch/harems_full/goodevil/events.rpy:623
translate russian goodevil_harem_event_01_41f94544:
    harmony.say "Я действительно стараюсь."

# ch/harems_full/goodevil/events.rpy:627
translate russian goodevil_harem_event_01_68c6b84b:
    mike.say "Послушай, Хармони..."

# ch/harems_full/goodevil/events.rpy:628
translate russian goodevil_harem_event_01_ba5f7a38:
    mike.say "Я вижу, что ты постаралась, правда."

# ch/harems_full/goodevil/events.rpy:631
translate russian goodevil_harem_event_01_c20df40f:
    mike.say "Но, кажется, даже перестаралась."

# ch/harems_full/goodevil/events.rpy:633
translate russian goodevil_harem_event_01_017391c9:
    mike.say "Мне больше по душе непринуждённость — как у Лекси."

# ch/harems_full/goodevil/events.rpy:635
translate russian goodevil_harem_event_01_29c9d423:
    "Когда я высказываю своё мнение, в глазах Хармони вспыхивает злость."

# ch/harems_full/goodevil/events.rpy:637
translate russian goodevil_harem_event_01_6ed8970f:
    "А Лекси купается в моей похвале."

# ch/harems_full/goodevil/events.rpy:638
translate russian goodevil_harem_event_01_f35f9423:
    lexi.say "Если ты и так хороша, зачем стараться сильнее?"

# ch/harems_full/goodevil/events.rpy:639
translate russian goodevil_harem_event_01_c9b66bb5:
    lexi.say "Правда, [lssb_common.hero_name()]?"

# ch/harems_full/goodevil/events.rpy:643
translate russian goodevil_harem_event_01_1904be90:
    mike.say "А можно любоваться вами обеими?"

# ch/harems_full/goodevil/events.rpy:646
translate russian goodevil_harem_event_01_8af0de0a:
    mike.say "Я ведь встречаюсь с вами двумя!"

# ch/harems_full/goodevil/events.rpy:647
translate russian goodevil_harem_event_01_317565c0:
    mike.say "И это должно быть одним из плюсов, верно?"

# ch/harems_full/goodevil/events.rpy:648
translate russian goodevil_harem_event_01_3fdbc9df:
    "Пока я объясняюсь, Хармони и Лекси переглядываются."

# ch/harems_full/goodevil/events.rpy:651
translate russian goodevil_harem_event_01_f9599bd1:
    "И затем, к моему облегчению, первая кивает, а вторая пожимает плечами."

# ch/harems_full/goodevil/events.rpy:653
translate russian goodevil_harem_event_01_320004f5:
    harmony.say "Он прав, Лекси."

# ch/harems_full/goodevil/events.rpy:654
translate russian goodevil_harem_event_01_d1956cc9:
    harmony.say "На нас ведь есть что посмотреть!"

# ch/harems_full/goodevil/events.rpy:656
translate russian goodevil_harem_event_01_642c1ebc:
    lexi.say "Вот тут ты права, Хармони."

# ch/harems_full/goodevil/events.rpy:657
translate russian goodevil_harem_event_01_11734823:
    lexi.say "Удивляюсь, как он вообще с нами справляется!"

# ch/harems_full/goodevil/events.rpy:662
translate russian goodevil_harem_event_01_fe6c2fa1:
    mike.say "Девочки, мы в стрип-клубе."

# ch/harems_full/goodevil/events.rpy:665
translate russian goodevil_harem_event_01_950dc9e5:
    mike.say "Я смотрю на ВСЕХ девушек здесь."

# ch/harems_full/goodevil/events.rpy:666
translate russian goodevil_harem_event_01_a79aee13:
    mike.say "А не только на вас!"

# ch/harems_full/goodevil/events.rpy:667
translate russian goodevil_harem_event_01_3fdbc9df_1:
    "Пока я объясняюсь, Хармони и Лекси переглядываются."

# ch/harems_full/goodevil/events.rpy:670
translate russian goodevil_harem_event_01_a2fbc2f9:
    "И, надо сказать, мои слова их удивляют."

# ch/harems_full/goodevil/events.rpy:671
translate russian goodevil_harem_event_01_f9599bd1_1:
    "И затем, к моему облегчению, первая кивает, а вторая пожимает плечами."

# ch/harems_full/goodevil/events.rpy:673
translate russian goodevil_harem_event_01_e1f251dd:
    harmony.say "Ну, если дело обстоит так..."

# ch/harems_full/goodevil/events.rpy:674
translate russian goodevil_harem_event_01_a0cd0e3b:
    harmony.say "Нам придётся больше стараться, чтобы завладеть твоим вниманием!"

# ch/harems_full/goodevil/events.rpy:676
translate russian goodevil_harem_event_01_e9e61615:
    lexi.say "Ещё бы!"

# ch/harems_full/goodevil/events.rpy:677
translate russian goodevil_harem_event_01_b0e75f59:
    lexi.say "К концу вечера ты больше ни на кого смотреть не захочешь!"

# ch/harems_full/goodevil/events.rpy:684
translate russian goodevil_harem_event_01_10e083d9:
    "Теперь, когда мы внутри, я наконец могу осмотреться и проникнуться атмосферой."

# ch/harems_full/goodevil/events.rpy:685
translate russian goodevil_harem_event_01_8748db5c:
    "В клубе довольно людно, атмосфера приятная, и я нахожу нам места."

# ch/harems_full/goodevil/events.rpy:689
translate russian goodevil_harem_event_01_f5b920db:
    "Хармони и Лекси уже собираются сесть, но я поднимаю руку."

# ch/harems_full/goodevil/events.rpy:691
translate russian goodevil_harem_event_01_fe4c17bf:
    mike.say "Нужно взять выпить."

# ch/harems_full/goodevil/events.rpy:692
translate russian goodevil_harem_event_01_aec4cb5b:
    harmony.say "А, точно!"

# ch/harems_full/goodevil/events.rpy:694
translate russian goodevil_harem_event_01_8fd330c9:
    harmony.say "Хорошая мысль, [lssb_common.hero_name()]."

# ch/harems_full/goodevil/events.rpy:695
translate russian goodevil_harem_event_01_c8fe1fb5:
    lexi.say "И что ещё важнее..."

# ch/harems_full/goodevil/events.rpy:697
translate russian goodevil_harem_event_01_ec97cc91:
    lexi.say "Нужно решить, кто за выпивкой пойдёт!"

# ch/harems_full/goodevil/events.rpy:702
translate russian goodevil_harem_event_01_0947215f:
    "Я немного раздумываю, стараясь быть справедливым."

# ch/harems_full/goodevil/events.rpy:703
translate russian goodevil_harem_event_01_1b3fc907:
    "И тут мне приходит идея."

# ch/harems_full/goodevil/events.rpy:704
translate russian goodevil_harem_event_01_8e31ea41:
    mike.say "Почему бы не идти по английскому алфавиту?"

# ch/harems_full/goodevil/events.rpy:705
translate russian goodevil_harem_event_01_87dd0124:
    "Прежде чем я успеваю продолжить, Лекси вмешивается."

# ch/harems_full/goodevil/events.rpy:707
translate russian goodevil_harem_event_01_d05085dc:
    lexi.say "Отличная идея!"

# ch/harems_full/goodevil/events.rpy:708
translate russian goodevil_harem_event_01_5c0bce92:
    lexi.say "Так и сделаем!"

# ch/harems_full/goodevil/events.rpy:709
translate russian goodevil_harem_event_01_bbb3cd53:
    mike.say "Хорошо, значит, двое за."

# ch/harems_full/goodevil/events.rpy:710
translate russian goodevil_harem_event_01_537ca249:
    mike.say "А ты что скажешь, Хармони?"

# ch/harems_full/goodevil/events.rpy:713
translate russian goodevil_harem_event_01_ba8be2e5:
    "Стоит повернуться к Хармони, как я начинаю жалеть о своём решении."

# ch/harems_full/goodevil/events.rpy:714
translate russian goodevil_harem_event_01_dc85c145:
    "По её лицу сразу видно: она не в восторге."

# ch/harems_full/goodevil/events.rpy:715
translate russian goodevil_harem_event_01_c58cb06a:
    harmony.say "Конечно, я против."

# ch/harems_full/goodevil/events.rpy:716
translate russian goodevil_harem_event_01_72680e1c:
    harmony.say "По-английски Хармони идёт гораздо раньше, чем Лекси и [lssb_common.hero_name()]!"

# ch/harems_full/goodevil/events.rpy:717
translate russian goodevil_harem_event_01_2e1011f3:
    lexi.say "Жаль, Хармони."

# ch/harems_full/goodevil/events.rpy:718
translate russian goodevil_harem_event_01_314cd54a:
    lexi.say "Ты в меньшинстве: два против одного!"

# ch/harems_full/goodevil/events.rpy:720
translate russian goodevil_harem_event_01_27cf00d4:
    "Я смотрю, как Хармони встаёт и идёт к бару."

# ch/harems_full/goodevil/events.rpy:721
translate russian goodevil_harem_event_01_79a10f12:
    "И всю дорогу что-то бормочет себе под нос."

# ch/harems_full/goodevil/events.rpy:726
translate russian goodevil_harem_event_01_d7614307:
    "Стоит повернуться к Хармони, как я вижу: ей эта идея нравится."

# ch/harems_full/goodevil/events.rpy:727
translate russian goodevil_harem_event_01_c84931cf:
    harmony.say "Это действительно отличная идея."

# ch/harems_full/goodevil/events.rpy:728
translate russian goodevil_harem_event_01_d3be1af6:
    harmony.say "Спасибо, [lssb_common.hero_name()]."

# ch/harems_full/goodevil/events.rpy:729
translate russian goodevil_harem_event_01_ab35f8db:
    "Я киваю, встаю и направляюсь к бару."

# ch/harems_full/goodevil/events.rpy:730
translate russian goodevil_harem_event_01_9fc6d893:
    "Довольный, что наконец нашёл способ угодить обеим."

# ch/harems_full/goodevil/events.rpy:731
translate russian goodevil_harem_event_01_5f407d2a:
    "Ну, хотя бы способ, для которого не нужно раздеваться."

# ch/harems_full/goodevil/events.rpy:735
translate russian goodevil_harem_event_01_0947215f_1:
    "Я немного раздумываю, стараясь быть справедливым."

# ch/harems_full/goodevil/events.rpy:736
translate russian goodevil_harem_event_01_1b3fc907_1:
    "И тут мне приходит идея."

# ch/harems_full/goodevil/events.rpy:737
translate russian goodevil_harem_event_01_915cab66:
    mike.say "Почему бы не идти по возрасту?"

# ch/harems_full/goodevil/events.rpy:738
translate russian goodevil_harem_event_01_a61484a2:
    mike.say "Сначала старшие, да?"

# ch/harems_full/goodevil/events.rpy:739
translate russian goodevil_harem_event_01_ba828c25:
    "Прежде чем я успеваю продолжить, Хармони вмешивается."

# ch/harems_full/goodevil/events.rpy:741
translate russian goodevil_harem_event_01_e5b2d9d8:
    harmony.say "Отличная идея!"

