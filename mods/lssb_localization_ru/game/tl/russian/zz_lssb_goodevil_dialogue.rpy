# ch/harems_full/goodevil/events.rpy:422
translate russian harmony_lexi_showdown_a70f16e8:
    "Оглядываюсь и вижу, что Лекси придвинулась ко мне."

# ch/harems_full/goodevil/events.rpy:423
translate russian harmony_lexi_showdown_e1c82bc3:
    lexi.say "Забудь об этой жирной корове, [lssb_common.hero_name()]."

# ch/harems_full/goodevil/events.rpy:424
translate russian harmony_lexi_showdown_24a902d1:
    lexi.say "Я хочу поговорить о твоём ответе."

# ch/harems_full/goodevil/events.rpy:426
translate russian harmony_lexi_showdown_ed954385:
    lexi.say "О том, что я сосу лучше всех, кто у тебя был..."

# ch/harems_full/goodevil/events.rpy:433
translate russian missed_goodevil_harem_date_fd197f42:
    "Чёрт, я пропустил свидание. Хармони и Лекси будут злиться."

# ch/harems_full/goodevil/events.rpy:441
translate russian goodevil_harem_event_01_3a7e6249:
    "Я изо всех сил стараюсь совмещать отношения с Хармони и Лекси."

# ch/harems_full/goodevil/events.rpy:442
translate russian goodevil_harem_event_01_8b345322:
    "Один день свидание с Хармони, другой — с Лекси."

# ch/harems_full/goodevil/events.rpy:443
translate russian goodevil_harem_event_01_fbba318a:
    "Чёрт, я даже пытался встречаться с одной днём, а с другой вечером."

# ch/harems_full/goodevil/events.rpy:444
translate russian goodevil_harem_event_01_a4e10d17:
    "И попытка угодить обеим за один день чуть меня не прикончила!"

# ch/harems_full/goodevil/events.rpy:445
translate russian goodevil_harem_event_01_cf13de94:
    "Конечно, проще, когда обе девушки спокойно относятся к тому, что делят меня."

# ch/harems_full/goodevil/events.rpy:446
translate russian goodevil_harem_event_01_ff942d0d:
    "Но я знаю: каждой интересно, чем я занимаюсь без неё."

# ch/harems_full/goodevil/events.rpy:447
translate russian goodevil_harem_event_01_a25db04a:
    "Лекси и Хармони любят всякие непристойности, так что это, пожалуй, естественно."

# ch/harems_full/goodevil/events.rpy:448
translate russian goodevil_harem_event_01_4a696593:
    "И вскоре мы решаем сходить на свидание втроём."

# ch/harems_full/goodevil/events.rpy:449
translate russian goodevil_harem_event_01_dab2537e:
    "И какое же место подойдёт для такого случая?"

# ch/harems_full/goodevil/events.rpy:450
translate russian goodevil_harem_event_01_4d5ef97f:
    "Церковный вечер?"

# ch/harems_full/goodevil/events.rpy:451
translate russian goodevil_harem_event_01_e9133c8d:
    "Барбекю у моих родителей?"

# ch/harems_full/goodevil/events.rpy:452
translate russian goodevil_harem_event_01_ace332f6:
    "Или, может, опера?"

# ch/harems_full/goodevil/events.rpy:453
translate russian goodevil_harem_event_01_67fa97cd:
    "Конечно нет!"

# ch/harems_full/goodevil/events.rpy:454
translate russian goodevil_harem_event_01_8de7a623:
    "Вечер в стрип-клубе — то, что доктор прописал."

# ch/harems_full/goodevil/events.rpy:455
translate russian goodevil_harem_event_01_528a750c:
    "Я договариваюсь встретить их обеих вечером у входа."

# ch/harems_full/goodevil/events.rpy:456
translate russian goodevil_harem_event_01_158b59e4:
    "И обязательно сообщаю, во сколько нужно прийти."

# ch/harems_full/goodevil/events.rpy:460
translate russian goodevil_harem_event_01_1765830f:
    "Поэтому меня немного удивляет, что Хармони уже здесь, когда я прихожу."

# ch/harems_full/goodevil/events.rpy:462
translate russian goodevil_harem_event_01_11505ee4:
    mike.say "Привет, Хармони!"

# ch/harems_full/goodevil/events.rpy:463
translate russian goodevil_harem_event_01_16238faf:
    mike.say "Не рановато ли ты?"

# ch/harems_full/goodevil/events.rpy:465
translate russian goodevil_harem_event_01_395cc772:
    "Хармони одаривает меня одной из своих неотразимых улыбок — тех, от которых у меня легко встаёт."

# ch/harems_full/goodevil/events.rpy:466
translate russian goodevil_harem_event_01_fa4a0364:
    "А ещё хлопает ресницами, что только усиливает эффект."

# ch/harems_full/goodevil/events.rpy:468
translate russian goodevil_harem_event_01_dc420955:
    harmony.say "Привет, [lssb_common.hero_name()]..."

# ch/harems_full/goodevil/events.rpy:469
translate russian goodevil_harem_event_01_d424f690:
    harmony.say "Я не рано."

# ch/harems_full/goodevil/events.rpy:470
translate russian goodevil_harem_event_01_491e1947:
    harmony.say "Мне просто не терпится!"

# ch/harems_full/goodevil/events.rpy:472
translate russian goodevil_harem_event_01_f0a013a5:
    "Хармони хихикает, словно для убедительности."

# ch/harems_full/goodevil/events.rpy:473
translate russian goodevil_harem_event_01_c7205d67:
    "А мне остаётся лишь кивнуть и улыбнуться в ответ."

# ch/harems_full/goodevil/events.rpy:475
translate russian goodevil_harem_event_01_087f5205:
    mike.say "Уже почти то время, на которое мы договаривались."

# ch/harems_full/goodevil/events.rpy:476
translate russian goodevil_harem_event_01_5c2e7418:
    mike.say "Интересно, куда подевалась Лекси?"

# ch/harems_full/goodevil/events.rpy:478
translate russian goodevil_harem_event_01_fb255d6c:
    "Хармони пожимает плечами, и мы оба оглядываем улицу в обе стороны."

# ch/harems_full/goodevil/events.rpy:479
translate russian goodevil_harem_event_01_1c5b0a42:
    "Но Лекси нигде не видно."

# ch/harems_full/goodevil/events.rpy:481
translate russian goodevil_harem_event_01_6ab46e9d:
    "Минуты идут, а мы с Хармони болтаем."

# ch/harems_full/goodevil/events.rpy:482
translate russian goodevil_harem_event_01_3c431e11:
    "Проходит немало времени, прежде чем Лекси наконец появляется из-за угла."

# ch/harems_full/goodevil/events.rpy:483
translate russian goodevil_harem_event_01_e7386f43:
    "Подходя, она машет нам — ни намёка на извинение."

# ch/harems_full/goodevil/events.rpy:485
translate russian goodevil_harem_event_01_734cd37f:
    lexi.say "А вот и я!"

# ch/harems_full/goodevil/events.rpy:486
translate russian goodevil_harem_event_01_ae343a4b:
    lexi.say "Ну, чего ждём?"

# ch/harems_full/goodevil/events.rpy:488
translate russian goodevil_harem_event_01_d75bf801:
    harmony.say "Тебя, вообще-то!"

# ch/harems_full/goodevil/events.rpy:489
translate russian goodevil_harem_event_01_dda75f73:
    harmony.say "Я и [lssb_common.hero_name()] уже сто лет тут стоим!"

# ch/harems_full/goodevil/events.rpy:491
translate russian goodevil_harem_event_01_31ed5ca5:
    lexi.say "Похоже, это ваши проблемы, а не мои!"

# ch/harems_full/goodevil/events.rpy:492
translate russian goodevil_harem_event_01_d271a8d3:
    lexi.say "Могли бы просто подождать меня внутри."

# ch/harems_full/goodevil/events.rpy:494
translate russian goodevil_harem_event_01_ed1a0b93:
    "Хармони поворачивается ко мне."

# ch/harems_full/goodevil/events.rpy:496
translate russian goodevil_harem_event_01_25006df5:
    "Затем то же самое делает Лекси."

# ch/harems_full/goodevil/events.rpy:497
translate russian goodevil_harem_event_01_b98032a5:
    "Похоже, они ждут, что я вмешаюсь и разрешу спор."

# ch/harems_full/goodevil/events.rpy:500
translate russian goodevil_harem_event_01_bdb982a8:
    mike.say "Нехорошо заставлять нас столько ждать, Лекси."

# ch/harems_full/goodevil/events.rpy:501
translate russian goodevil_harem_event_01_7fe490fa:
    mike.say "Мы не пошли внутрь, потому что у нас общее свидание."

# ch/harems_full/goodevil/events.rpy:502
translate russian goodevil_harem_event_01_5dbff96e:
    mike.say "Не хотели начинать веселье без тебя."

# ch/harems_full/goodevil/events.rpy:504
translate russian goodevil_harem_event_01_cb4705ca:
    "Лекси открывает рот, чтобы возразить."

# ch/harems_full/goodevil/events.rpy:505
translate russian goodevil_harem_event_01_d9f2d3fb:
    "Но затем, похоже, осознаёт, как всё выглядит."

# ch/harems_full/goodevil/events.rpy:507
translate russian goodevil_harem_event_01_386c14d2:
    "И немного дуется."

# ch/harems_full/goodevil/events.rpy:508
translate russian goodevil_harem_event_01_9671adb0:
    lexi.say "Ладно, ладно..."

# ch/harems_full/goodevil/events.rpy:509
translate russian goodevil_harem_event_01_68551276:
    lexi.say "Я поняла."

# ch/harems_full/goodevil/events.rpy:511
translate russian goodevil_harem_event_01_fdc59f1a:
    "А Хармони выглядит так, словно её правоту подтвердили."

# ch/harems_full/goodevil/events.rpy:512
translate russian goodevil_harem_event_01_5880b7b6:
    "Хорошо хоть на этот раз она молчит."

# ch/harems_full/goodevil/events.rpy:516
translate russian goodevil_harem_event_01_4c1927ea:
    mike.say "Ты тоже пришла не вовремя, Хармони."

# ch/harems_full/goodevil/events.rpy:517
translate russian goodevil_harem_event_01_d740540a:
    mike.say "Да, ты пришла раньше."

# ch/harems_full/goodevil/events.rpy:518
translate russian goodevil_harem_event_01_2ee7e92f:
    mike.say "Но зачем?"

# ch/harems_full/goodevil/events.rpy:519
translate russian goodevil_harem_event_01_a08d01e6:
    mike.say "Хочешь, чтобы остальным стало неловко?"

# ch/harems_full/goodevil/events.rpy:521
translate russian goodevil_harem_event_01_15d3acb3:
    "Хармони открывает рот, чтобы возразить."

# ch/harems_full/goodevil/events.rpy:522
