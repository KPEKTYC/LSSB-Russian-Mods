# Native Goodevil identifiers, current source catalog. Translation only.

# ch/harems_full/goodevil/events.rpy:116
translate russian harmony_lexi_showdown_c9606ec4:
    "Сегодня такая замечательная погода, что мы с Лекси просто не могли не пойти на пляж."

# ch/harems_full/goodevil/events.rpy:117
translate russian harmony_lexi_showdown_ac0adb20:
    "Под таким палящим солнцем оставаться где-то ещё было бы безумием."

# ch/harems_full/goodevil/events.rpy:118
translate russian harmony_lexi_showdown_de6339d9:
    "В эту жару только и остаётся, что раздеться до купальника и лежать на песке."

# ch/harems_full/goodevil/events.rpy:119
translate russian harmony_lexi_showdown_98133953:
    "Ну, в моём случае — лежать на песке и всё время пялиться на Лекси."

# ch/harems_full/goodevil/events.rpy:120
translate russian harmony_lexi_showdown_563721df:
    "Никакая жара ведь не сравнится с тем, насколько она горяча!"

# ch/harems_full/goodevil/events.rpy:122
translate russian harmony_lexi_showdown_702cd86a:
    "И Лекси, похоже, нравится это внимание: она довольна, что я не свожу с неё глаз."

# ch/harems_full/goodevil/events.rpy:123
translate russian harmony_lexi_showdown_1f7463fa:
    "Бёдра, живот, грудь..."

# ch/harems_full/goodevil/events.rpy:125
translate russian harmony_lexi_showdown_98bc5cdc:
    "И, конечно, похотливая улыбка на её прекрасном лице."

# ch/harems_full/goodevil/events.rpy:126
translate russian harmony_lexi_showdown_0e6ddb41:
    "Жаль, что я не взял шляпу, чтобы прикрыть пах."

# ch/harems_full/goodevil/events.rpy:127
translate russian harmony_lexi_showdown_ddb20977:
    "Потому что сейчас у меня от неё стоит до боли!"

# ch/harems_full/goodevil/events.rpy:128
translate russian harmony_lexi_showdown_680ecad2:
    lexi.say "Нравится, а?"

# ch/harems_full/goodevil/events.rpy:130
translate russian harmony_lexi_showdown_117f843f:
    lexi.say "Хочешь увидеть побольше?"

# ch/harems_full/goodevil/events.rpy:131
translate russian harmony_lexi_showdown_3133c924:
    "Я уже собираюсь кивнуть, высунув язык, словно пёс."

# ch/harems_full/goodevil/events.rpy:132
translate russian harmony_lexi_showdown_a38d182d:
    "Но тут кое-что отвлекает мой взгляд от Лекси."

# ch/harems_full/goodevil/events.rpy:133
translate russian harmony_lexi_showdown_e687a2ed:
    "Разумеется, другая девушка."

# ch/harems_full/goodevil/events.rpy:134
translate russian harmony_lexi_showdown_444031e7:
    "Только совсем иного телосложения."

# ch/harems_full/goodevil/events.rpy:135
translate russian harmony_lexi_showdown_af433d37:
    "Полные бёдра и ягодицы, округлый живот и потрясающая грудь."

# ch/harems_full/goodevil/events.rpy:136
translate russian harmony_lexi_showdown_e2cb60fb:
    "И к тому времени, как мой взгляд добирается до лица, я уже точно знаю, кто это."

# ch/harems_full/goodevil/events.rpy:138
translate russian harmony_lexi_showdown_ffa9b7d6:
    mike.say "Хармони!"

# ch/harems_full/goodevil/events.rpy:140
translate russian harmony_lexi_showdown_f81b55b0:
    harmony.say "Привет, [lssb_common.hero_name()]..."

# ch/harems_full/goodevil/events.rpy:141
translate russian harmony_lexi_showdown_c77e6f98:
    harmony.say "Вот уж не ожидала встретить тебя на пляже!"

# ch/harems_full/goodevil/events.rpy:142
translate russian harmony_lexi_showdown_4e5fdc5e:
    "Хармони стоит на песке в паре шагов от нас с Лекси."

# ch/harems_full/goodevil/events.rpy:143
translate russian harmony_lexi_showdown_d908fc2f:
    "Уперев руки в пышные бёдра, она смотрит на нас сверху вниз."

# ch/harems_full/goodevil/events.rpy:144
translate russian harmony_lexi_showdown_123caad7:
    "И по её взгляду видно, что она очень рада меня видеть."

# ch/harems_full/goodevil/events.rpy:146
translate russian harmony_lexi_showdown_4fd0ea2e:
    lexi.say "Кхм!"

# ch/harems_full/goodevil/events.rpy:148
translate russian harmony_lexi_showdown_1a2206cf:
    lexi.say "Это ещё кто, блядь, [lssb_common.hero_name()]?"

# ch/harems_full/goodevil/events.rpy:149
translate russian harmony_lexi_showdown_88908f16:
    lexi.say "Какая-то твоя знакомая шлюха?"

# ch/harems_full/goodevil/events.rpy:152
translate russian harmony_lexi_showdown_66e638f0:
    "Я поворачиваюсь к Лекси с расширенными глазами."

# ch/harems_full/goodevil/events.rpy:153
translate russian harmony_lexi_showdown_bab04086:
    "Знаю, что она далеко не самая вежливая и воспитанная девушка из всех, кого я встречал."

# ch/harems_full/goodevil/events.rpy:154
translate russian harmony_lexi_showdown_b25e745b:
    "Но даже так не могу поверить, что она только что сказала."

# ch/harems_full/goodevil/events.rpy:155
translate russian harmony_lexi_showdown_8ed7de59:
    mike.say "ЛЕКСИ!"

# ch/harems_full/goodevil/events.rpy:156
translate russian harmony_lexi_showdown_f50afd53:
    mike.say "Не разговаривай так с Хармони!"

# ch/harems_full/goodevil/events.rpy:157
translate russian harmony_lexi_showdown_66c810d7:
    "Я жду, что Хармони оскорбит грубость Лекси."

# ch/harems_full/goodevil/events.rpy:159
translate russian harmony_lexi_showdown_12b32105:
    "Но если и так, она не подаёт виду."

# ch/harems_full/goodevil/events.rpy:161
translate russian harmony_lexi_showdown_c9de859d:
    "Вместо этого садится на песок прямо рядом с нами."

# ch/harems_full/goodevil/events.rpy:162
translate russian harmony_lexi_showdown_547ada33:
    harmony.say "Всё хорошо, [lssb_common.hero_name()]."

# ch/harems_full/goodevil/events.rpy:163
translate russian harmony_lexi_showdown_f7d6a9be:
    harmony.say "Шлюха шлюху видит издалека."

# ch/harems_full/goodevil/events.rpy:165
translate russian harmony_lexi_showdown_5ce4e738:
    harmony.say "Правда, Лекси?"

# ch/harems_full/goodevil/events.rpy:166
translate russian harmony_lexi_showdown_1a88d5a4:
    "Лекси фыркает и щурится."

# ch/harems_full/goodevil/events.rpy:168
translate russian harmony_lexi_showdown_a74283cc:
    lexi.say "Я не какая-нибудь заурядная шлюха."

# ch/harems_full/goodevil/events.rpy:170
translate russian harmony_lexi_showdown_f6130961:
    lexi.say "Я исключительная шлюха!"

# ch/harems_full/goodevil/events.rpy:172
translate russian harmony_lexi_showdown_581086c9:
    "Хармони приподнимает брови, услышав эту тираду."

# ch/harems_full/goodevil/events.rpy:173
translate russian harmony_lexi_showdown_c0751b6e:
    "Но затем ей словно приходит в голову мысль."

# ch/harems_full/goodevil/events.rpy:174
translate russian harmony_lexi_showdown_e514c187:
    harmony.say "Правда так думаешь, Лекси?"

# ch/harems_full/goodevil/events.rpy:175
translate russian harmony_lexi_showdown_21f639e8:
    harmony.say "Вот [lssb_common.hero_name()] точно может рассудить."

# ch/harems_full/goodevil/events.rpy:176
translate russian harmony_lexi_showdown_fc1ee34b:
    harmony.say "Он лично испытал, на что я способна."

# ch/harems_full/goodevil/events.rpy:179
translate russian harmony_lexi_showdown_d40c8a04:
    harmony.say "А ты похожа на ту, кто дала ему всё ещё на первом свидании!"

# ch/harems_full/goodevil/events.rpy:180
translate russian harmony_lexi_showdown_107ef78b:
    "Лекси легко заглатывает наживку."

# ch/harems_full/goodevil/events.rpy:181
translate russian harmony_lexi_showdown_aebfdba1:
    "И садится, глядя Хармони прямо в глаза."

# ch/harems_full/goodevil/events.rpy:182
translate russian harmony_lexi_showdown_85e463aa:
    lexi.say "Хочешь со мной потягаться, сучка?"

# ch/harems_full/goodevil/events.rpy:184
translate russian harmony_lexi_showdown_d53e05b1:
    lexi.say "Гарантирую: проиграешь!"

# ch/harems_full/goodevil/events.rpy:185
translate russian harmony_lexi_showdown_fd61df6f:
    "Хармони по-прежнему улыбается и переводит взгляд на меня."

# ch/harems_full/goodevil/events.rpy:186
translate russian harmony_lexi_showdown_edda5f6b:
    harmony.say "Что думаешь, [lssb_common.hero_name()]?"

# ch/harems_full/goodevil/events.rpy:187
translate russian harmony_lexi_showdown_fb0f258e:
    harmony.say "Ты готов?"

# ch/harems_full/goodevil/events.rpy:188
translate russian harmony_lexi_showdown_c67effc0:
    "Теперь обе смотрят на меня."

# ch/harems_full/goodevil/events.rpy:189
translate russian harmony_lexi_showdown_9aceca7d:
    "Первое желание, конечно, отказаться."

# ch/harems_full/goodevil/events.rpy:190
translate russian harmony_lexi_showdown_cae23ad3:
    "Но я почти уверен, что такой ответ их не остановит."

# ch/harems_full/goodevil/events.rpy:193
translate russian harmony_lexi_showdown_c543238a:
    mike.say "Только вы должны уважать моё решение, ладно?"

# ch/harems_full/goodevil/events.rpy:194
translate russian harmony_lexi_showdown_2ce10294:
    mike.say "Без обид на меня."

# ch/harems_full/goodevil/events.rpy:196
translate russian harmony_lexi_showdown_186b017e:
    harmony.say "Конечно."

# ch/harems_full/goodevil/events.rpy:198
translate russian harmony_lexi_showdown_5bdcf8f3:
    lexi.say "Договорились."

# ch/harems_full/goodevil/events.rpy:199
translate russian harmony_lexi_showdown_da308020:
    lexi.say "А по какому критерию он нас оценит?"

# ch/harems_full/goodevil/events.rpy:200
translate russian harmony_lexi_showdown_77b7bc11:
    harmony.say "Хм..."

# ch/harems_full/goodevil/events.rpy:201
translate russian harmony_lexi_showdown_e0df06e2:
    harmony.say "Как насчёт оральных ласк?"

# ch/harems_full/goodevil/events.rpy:202
translate russian harmony_lexi_showdown_f79f930c:
    lexi.say "Меня устраивает."

# ch/harems_full/goodevil/events.rpy:203
translate russian harmony_lexi_showdown_fb735734:
    lexi.say "Ладно, [lssb_common.hero_name()], кто лучше сосёт?"

# ch/harems_full/goodevil/events.rpy:204
translate russian harmony_lexi_showdown_52ad696f:
    lexi.say "Я или эта двойная задница?"

# ch/harems_full/goodevil/events.rpy:205
translate russian harmony_lexi_showdown_1126db6f:
    "Я смотрю с Лекси на Хармони и обратно."

# ch/harems_full/goodevil/events.rpy:206
translate russian harmony_lexi_showdown_6a5ea7f6:
    "Господи... Похоже, они действительно заставят меня выбирать!"

# ch/harems_full/goodevil/events.rpy:207
translate russian harmony_lexi_showdown_cafe101b:
    "Я качаю головой и пытаюсь вспомнить, когда каждая в последний раз мне отсасывала."

# ch/harems_full/goodevil/events.rpy:208
translate russian harmony_lexi_showdown_f6a8066a:
    "И тут остаётся лишь один возможный ответ..."

# ch/harems_full/goodevil/events.rpy:210
translate russian harmony_lexi_showdown_503a2a91:
    "Я никак не могу выбрать между ними."

# ch/harems_full/goodevil/events.rpy:211
translate russian harmony_lexi_showdown_ac432bd3:
    "Обе делают просто неземной минет."

# ch/harems_full/goodevil/events.rpy:212
translate russian harmony_lexi_showdown_4bce32b3:
    "Но сравнить их и решить, кто лучше, невозможно."

# ch/harems_full/goodevil/events.rpy:213
translate russian harmony_lexi_showdown_6e7484a5:
    "И выбрать одну лишь ради прекращения спора я тоже не могу."

# ch/harems_full/goodevil/events.rpy:214
translate russian harmony_lexi_showdown_6a532ed6:
    "Стоит так сделать, и вторая тут же на меня набросится!"

# ch/harems_full/goodevil/events.rpy:215
translate russian harmony_lexi_showdown_cdd24b00:
    "Может, если честно это объяснить, они образумятся?"

# ch/harems_full/goodevil/events.rpy:216
translate russian harmony_lexi_showdown_e6ae7139:
    mike.say "Как я могу выбрать одну из вас, девочки?"

# ch/harems_full/goodevil/events.rpy:217
translate russian harmony_lexi_showdown_b3f86099:
    mike.say "У каждой своя неповторимая техника."

# ch/harems_full/goodevil/events.rpy:218
translate russian harmony_lexi_showdown_285335b1:
    mike.say "И потом, я не помню каждый минет, который вы мне делали!"

# ch/harems_full/goodevil/events.rpy:219
translate russian harmony_lexi_showdown_2c9f5b82:
    mike.say "Как же мне их сравнить?"

# ch/harems_full/goodevil/events.rpy:222
translate russian harmony_lexi_showdown_0f514dc6:
    "Хармони и Лекси явно не рады моему ответу."

# ch/harems_full/goodevil/events.rpy:223
translate russian harmony_lexi_showdown_472368dd:
    "И, похоже, попытка объявить ничью тоже не сработает."

# ch/harems_full/goodevil/events.rpy:224
translate russian harmony_lexi_showdown_a420c97f:
    lexi.say "Вообще-то ты должен помнить каждый раз, когда я тебе отсасывала!"

# ch/harems_full/goodevil/events.rpy:225
translate russian harmony_lexi_showdown_e45d9838:
    lexi.say "И быть благодарным, что я вообще это делала!"

# ch/harems_full/goodevil/events.rpy:226
translate russian harmony_lexi_showdown_4d3252b6:
    "На мгновение кажется, что Хармони тоже собирается меня отчитать."

# ch/harems_full/goodevil/events.rpy:227
translate russian harmony_lexi_showdown_2c21aca9:
    "Но затем на её лице появляется задумчивое выражение."

# ch/harems_full/goodevil/events.rpy:228
translate russian harmony_lexi_showdown_60836b27:
    "И я сразу понимаю: она что-то придумала."

# ch/harems_full/goodevil/events.rpy:230
translate russian harmony_lexi_showdown_0ef4e46f:
    harmony.say "Раз [lssb_common.hero_name()] клянётся, что не помнит, мы быстро это исправим."

# ch/harems_full/goodevil/events.rpy:231
translate russian harmony_lexi_showdown_ca417c11:
    lexi.say "А?"

# ch/harems_full/goodevil/events.rpy:233
translate russian harmony_lexi_showdown_cb698f30:
    lexi.say "Ты о чём?"

# ch/harems_full/goodevil/events.rpy:234
translate russian harmony_lexi_showdown_5718b403:
    harmony.say "Нужно всего лишь отвести его вон туда..."

# ch/harems_full/goodevil/events.rpy:235
translate russian harmony_lexi_showdown_868463e6:
    "Хармони кивает на камни неподалёку от нас."

# ch/harems_full/goodevil/events.rpy:236
translate russian harmony_lexi_showdown_96e15796:
    harmony.say "Убедиться, что никто не увидит, чем мы заняты..."

# ch/harems_full/goodevil/events.rpy:237
translate russian harmony_lexi_showdown_4128f606:
    "Вдруг Лекси, кажется, всё понимает."

# ch/harems_full/goodevil/events.rpy:238
translate russian harmony_lexi_showdown_96edab1c:
    lexi.say "А..."

# ch/harems_full/goodevil/events.rpy:239
translate russian harmony_lexi_showdown_12d22c3e:
    lexi.say "Поняла!"

# ch/harems_full/goodevil/events.rpy:241
translate russian harmony_lexi_showdown_62ad629a:
    lexi.say "Оттащим его туда и отсосём!"

# ch/harems_full/goodevil/events.rpy:242
translate russian harmony_lexi_showdown_cf44a2af:
    "Хармони улыбается и кивает Лекси."

# ch/harems_full/goodevil/events.rpy:243
translate russian harmony_lexi_showdown_0eaf5660:
    harmony.say "Именно, Лекси."

# ch/harems_full/goodevil/events.rpy:245
translate russian harmony_lexi_showdown_95db145b:
    harmony.say "Более честного способа решить спор не придумаешь."

# ch/harems_full/goodevil/events.rpy:246
translate russian harmony_lexi_showdown_edda5f6b_1:
    harmony.say "Что думаешь, [lssb_common.hero_name()]?"

# ch/harems_full/goodevil/events.rpy:249
translate russian harmony_lexi_showdown_09ea7419:
    "Что я думаю?!"

# ch/harems_full/goodevil/events.rpy:250
translate russian harmony_lexi_showdown_9a77d8e8:
    "Ещё несколько секунд назад я был зажат между двумя злыми девушками."

# ch/harems_full/goodevil/events.rpy:251
translate russian harmony_lexi_showdown_800ec87b:
    "А теперь они просят позволить им посоревноваться, кто лучше сосёт!"

# ch/harems_full/goodevil/events.rpy:252
translate russian harmony_lexi_showdown_f1e081fb:
    "Конечно, я считаю это прекрасной идеей!"

# ch/harems_full/goodevil/events.rpy:254
translate russian harmony_lexi_showdown_a084f3cd:
    mike.say "Ладно, девочки."

# ch/harems_full/goodevil/events.rpy:255
translate russian harmony_lexi_showdown_fbf888ee:
    mike.say "Думаю, я могу на это согласиться..."

# ch/harems_full/goodevil/events.rpy:256
translate russian harmony_lexi_showdown_2da51c93:
    "Соглашаясь на соревнование, я изо всех сил стараюсь не выдать восторга."

# ch/harems_full/goodevil/events.rpy:257
translate russian harmony_lexi_showdown_37a13ffe:
    "В основном потому, что боюсь: если слишком обрадуюсь, они снова на меня ополчатся."

# ch/harems_full/goodevil/events.rpy:258
translate russian harmony_lexi_showdown_f29a5549:
    "Нужно удержать их внимание на соперничестве."

# ch/harems_full/goodevil/events.rpy:259
translate russian harmony_lexi_showdown_9c663d40:
    "И отвлечь от того, что прежде я получал удовольствие от обеих."

# ch/harems_full/goodevil/events.rpy:260
translate russian harmony_lexi_showdown_e44cbb87:
    "План, похоже, работает: Хармони и Лекси хватают меня за запястья."

# ch/harems_full/goodevil/events.rpy:261
translate russian harmony_lexi_showdown_4afaa472:
    "И вместе бесцеремонно поднимают на ноги."

# ch/harems_full/goodevil/events.rpy:262
translate russian harmony_lexi_showdown_a7b100cd:
    "Затем, не теряя времени, тащат к ближайшим камням."

# ch/harems_full/goodevil/events.rpy:263
translate russian harmony_lexi_showdown_36392930:
    "Оказавшись за ними, я понимаю, что Хармони была права."

# ch/harems_full/goodevil/events.rpy:264
translate russian harmony_lexi_showdown_f9402d65:
    "Никто нас здесь не увидит."

# ch/harems_full/goodevil/events.rpy:265
translate russian harmony_lexi_showdown_712388ce:
    "Мы в тени, вдали от солнца и моря."

# ch/harems_full/goodevil/events.rpy:266
translate russian harmony_lexi_showdown_d98e6ad4:
    mike.say "Ладно..."

# ch/harems_full/goodevil/events.rpy:267
translate russian harmony_lexi_showdown_d270ebc1:
    mike.say "И как мы будем..."

# ch/harems_full/goodevil/events.rpy:268
translate russian harmony_lexi_showdown_12788e83:
    "Прежде чем я заканчиваю, Хармони и Лекси стягивают с меня плавки."

# ch/harems_full/goodevil/events.rpy:269
translate russian harmony_lexi_showdown_81a0f8df:
    "Затем опускаются передо мной на колени с самым решительным видом."

# ch/harems_full/goodevil/events.rpy:270
translate russian harmony_lexi_showdown_ac1d2439:
    lexi.say "Думаю, я должна быть первой."

# ch/harems_full/goodevil/events.rpy:272
translate russian harmony_lexi_showdown_a3d11d65:
    lexi.say "Мы ведь были на свидании ещё до того, как ты появилась."

# ch/harems_full/goodevil/events.rpy:273
translate russian harmony_lexi_showdown_0112cfd0:
    harmony.say "По очереди нельзя!"

# ch/harems_full/goodevil/events.rpy:275
translate russian harmony_lexi_showdown_12a2bccf:
    harmony.say "Вдруг он не сможет два раза без перерыва? Рисковать нельзя."

# ch/harems_full/goodevil/events.rpy:277
translate russian harmony_lexi_showdown_36385b4b:
    lexi.say "И что, чёрт возьми, нам делать?"

# ch/harems_full/goodevil/events.rpy:279
translate russian harmony_lexi_showdown_515d2a90:
    harmony.say "Нужно действовать одновременно."

# ch/harems_full/goodevil/events.rpy:280
translate russian harmony_lexi_showdown_5b507f97:
    "С этими словами Хармони поднимает голову и смотрит мне в глаза."

# ch/harems_full/goodevil/events.rpy:281
translate russian harmony_lexi_showdown_db118023:
    harmony.say "А закончишь с той, кто, по-твоему, справилась лучше."

# ch/harems_full/goodevil/events.rpy:282
translate russian harmony_lexi_showdown_1a5925cc:
    harmony.say "Хорошо, [lssb_common.hero_name()]?"

# ch/harems_full/goodevil/events.rpy:283
translate russian harmony_lexi_showdown_5aa0194e:
    "Я с готовностью киваю, согласный на всё, лишь бы они начали."

# ch/harems_full/goodevil/events.rpy:284
translate russian harmony_lexi_showdown_4f5f22e1:
    mike.say "Конечно, Хармони."

# ch/harems_full/goodevil/events.rpy:285
translate russian harmony_lexi_showdown_9a3211fc:
    mike.say "Выберу до того, как кончу!"

# ch/harems_full/goodevil/events.rpy:286
translate russian harmony_lexi_showdown_8fcd43e2:
    "Хармони и Лекси обе кивают."

# ch/harems_full/goodevil/events.rpy:287
translate russian harmony_lexi_showdown_a6ba6272:
    "Полагаю, это самое близкое к спортивному рукопожатию, на что они способны."

# ch/harems_full/goodevil/events.rpy:288
translate russian harmony_lexi_showdown_de08c005:
    "Я жду, что Хармони подаст сигнал начинать."

# ch/harems_full/goodevil/events.rpy:289
translate russian harmony_lexi_showdown_3007522b:
    "Или они обе дождутся моей команды."

# ch/harems_full/goodevil/events.rpy:290
translate russian harmony_lexi_showdown_50faa996:
    "Но вместо этого одновременно набрасываются на меня."

# ch/harems_full/goodevil/events.rpy:292
translate russian harmony_lexi_showdown_5e4f7021:
    "Дальше начинается, пожалуй, самый странный минет в моей жизни."

# ch/harems_full/goodevil/events.rpy:293
translate russian harmony_lexi_showdown_564edaca:
    "Хармони и Лекси толкаются, стараясь оттеснить друг друга."

# ch/harems_full/goodevil/events.rpy:294
translate russian harmony_lexi_showdown_f93194f2:
    "И при этом обе пытаются добраться до моего члена!"

# ch/harems_full/goodevil/events.rpy:295
translate russian harmony_lexi_showdown_197490d4:
    "В конце концов Хармони первой добирается до головки."

# ch/harems_full/goodevil/events.rpy:297
translate russian harmony_lexi_showdown_0df0e1d3:
    "И улыбается мне, беря её в рот."

# ch/harems_full/goodevil/events.rpy:298
translate russian harmony_lexi_showdown_72c7dd1c:
    "Обычно она не спешит, но сейчас хочет лишь поскорее завладеть им."

# ch/harems_full/goodevil/events.rpy:299
translate russian harmony_lexi_showdown_e1fd971b:
    "Не желая уступать, Лекси опускается ниже и начинает сосать мои яйца."

# ch/harems_full/goodevil/events.rpy:300
translate russian harmony_lexi_showdown_86260bd6:
    "Как я и говорил, никакой постепенности: они сразу берутся за дело."

# ch/harems_full/goodevil/events.rpy:301
translate russian harmony_lexi_showdown_103b8edc:
    "И я тоже оказываюсь втянут в этот стремительный темп."

# ch/harems_full/goodevil/events.rpy:302
translate russian harmony_lexi_showdown_26826750:
    "И тут же вспоминаю, насколько трудно будет выбрать победительницу."

# ch/harems_full/goodevil/events.rpy:303
translate russian harmony_lexi_showdown_5a976314:
    "Ведь Хармони и Лекси практически равны."

# ch/harems_full/goodevil/events.rpy:304
translate russian harmony_lexi_showdown_e52c7efe:
    "У Лекси огромный опыт — она настоящий профессионал."

# ch/harems_full/goodevil/events.rpy:305
translate russian harmony_lexi_showdown_fa076154:
    "А годы подавленных желаний превратили Хармони в своего рода сексуального гения!"

# ch/harems_full/goodevil/events.rpy:306
translate russian harmony_lexi_showdown_4d0c5ec4:
    "Жаль, что они считают нужным соперничать."

# ch/harems_full/goodevil/events.rpy:307
translate russian harmony_lexi_showdown_a359185c:
    "Лаская разные части моего тела, они прекрасно дополняют друг друга."

# ch/harems_full/goodevil/events.rpy:308
translate russian harmony_lexi_showdown_f73ec817:
    "Чем больше они увлекаются, тем яснее: мне, возможно, повезёт ещё сильнее."

# ch/harems_full/goodevil/events.rpy:309
translate russian harmony_lexi_showdown_4e94afaf:
    "Потому что Хармони и Лекси, похоже, сосредоточились на моём удовольствии."

# ch/harems_full/goodevil/events.rpy:310
translate russian harmony_lexi_showdown_0bfb2767:
    "Вместо того чтобы расталкивать друг друга."

# ch/harems_full/goodevil/events.rpy:311
translate russian harmony_lexi_showdown_937d0203:
    "Пока Хармони заглатывает мой член, Лекси играет с яйцами."

# ch/harems_full/goodevil/events.rpy:312
translate russian harmony_lexi_showdown_8655ba61:
    "И, клянусь, я не раз вижу, как они меняются местами."

# ch/harems_full/goodevil/events.rpy:314
translate russian harmony_lexi_showdown_dbff0242:
    "Причём умудряются совсем друг другу не мешать."

# ch/harems_full/goodevil/events.rpy:316
translate russian harmony_lexi_showdown_d806e2ea:
    "Мне даже становится трудно запомнить, кто сейчас где."

# ch/harems_full/goodevil/events.rpy:318
translate russian harmony_lexi_showdown_75a167fc:
    "Не раз я закрываю глаза, пока мой член во рту у Лекси."

# ch/harems_full/goodevil/events.rpy:320
translate russian harmony_lexi_showdown_e85ec339:
    "А открыв их, вижу на её месте Хармони!"

# ch/harems_full/goodevil/events.rpy:321
translate russian harmony_lexi_showdown_c39e4c44:
    "Но кто же справляется лучше?"

# ch/harems_full/goodevil/events.rpy:322
translate russian harmony_lexi_showdown_3724a298:
    "Я понимаю, что скоро придётся принять решение."

# ch/harems_full/goodevil/events.rpy:323
translate russian harmony_lexi_showdown_d21f9aaf:
    "Потому что долго я так не выдержу!"

# ch/harems_full/goodevil/events.rpy:326
translate russian harmony_lexi_showdown_1d7d1e86:
    "В следующий раз, когда я смотрю вниз и вижу свой член во рту Хармони, всё решается."

# ch/harems_full/goodevil/events.rpy:328
translate russian harmony_lexi_showdown_ad94c749:
    "Я больше не могу сдерживаться, и, похоже, именно она довела меня до этого."

# ch/harems_full/goodevil/events.rpy:329
translate russian harmony_lexi_showdown_a3c929a3:
    "Так что просто отпускаю себя и позволяю всему идти своим чередом."

# ch/harems_full/goodevil/events.rpy:332
translate russian harmony_lexi_showdown_7597281e:
    "Даже не думаю вынимать член изо рта Хармони."

# ch/harems_full/goodevil/events.rpy:334
translate russian harmony_lexi_showdown_a85bec1c:
    "Просто кончаю прямо ей в горло!"

# ch/harems_full/goodevil/events.rpy:336
translate russian harmony_lexi_showdown_1decd15d:
    "Глаза Хармони расширяются от неожиданности, но затем она понимает, что происходит."

# ch/harems_full/goodevil/events.rpy:338
translate russian harmony_lexi_showdown_bdaea30c:
    "И без заминки проглатывает всё до последней капли."

# ch/harems_full/goodevil/events.rpy:340
translate russian harmony_lexi_showdown_b2ffa27b:
    "В самый последний момент я вынимаю член изо рта Хармони."

# ch/harems_full/goodevil/events.rpy:341
translate russian harmony_lexi_showdown_d5eafa95:
    "Она ахает, а затем тут же начинает повизгивать."

# ch/harems_full/goodevil/events.rpy:343
translate russian harmony_lexi_showdown_d2c7df03:
    "Потому что тёплые липкие струйки спермы покрывают её лицо."

# ch/harems_full/goodevil/events.rpy:345
translate russian harmony_lexi_showdown_6c2b16c3:
    "Но Хармони остаётся на коленях, пока я не заканчиваю."

# ch/harems_full/goodevil/events.rpy:347
translate russian harmony_lexi_showdown_fa37e93d:
    "В следующий раз, когда я смотрю вниз и вижу свой член во рту Лекси, всё решается."

# ch/harems_full/goodevil/events.rpy:349
translate russian harmony_lexi_showdown_ad94c749_1:
    "Я больше не могу сдерживаться, и, похоже, именно она довела меня до этого."

# ch/harems_full/goodevil/events.rpy:350
translate russian harmony_lexi_showdown_a3c929a3_1:
    "Так что просто отпускаю себя и позволяю всему идти своим чередом."

# ch/harems_full/goodevil/events.rpy:353
translate russian harmony_lexi_showdown_4ab6e1e6:
    "Даже не думаю вынимать член изо рта Лекси."

# ch/harems_full/goodevil/events.rpy:355
translate russian harmony_lexi_showdown_a85bec1c_1:
    "Просто кончаю прямо ей в горло!"

# ch/harems_full/goodevil/events.rpy:357
translate russian harmony_lexi_showdown_1539f007:
    "Глаза Лекси расширяются от неожиданности, но затем она понимает, что происходит."

# ch/harems_full/goodevil/events.rpy:359
translate russian harmony_lexi_showdown_bdaea30c_1:
    "И без заминки проглатывает всё до последней капли."

# ch/harems_full/goodevil/events.rpy:361
translate russian harmony_lexi_showdown_0a1a767c:
    "В самый последний момент я вынимаю член изо рта Лекси."

# ch/harems_full/goodevil/events.rpy:362
translate russian harmony_lexi_showdown_12f22cc3:
    "Она ахает, а затем тут же расплывается в улыбке."

# ch/harems_full/goodevil/events.rpy:364
translate russian harmony_lexi_showdown_d2c7df03_1:
    "Потому что тёплые липкие струйки спермы покрывают её лицо."

# ch/harems_full/goodevil/events.rpy:366
translate russian harmony_lexi_showdown_fd1e1090:
    "Но Лекси остаётся на коленях, пока я не заканчиваю."

# ch/harems_full/goodevil/events.rpy:368
translate russian harmony_lexi_showdown_a58cd2ce:
    "И по её щекам тянутся полоски спермы."

# ch/harems_full/goodevil/events.rpy:369
translate russian harmony_lexi_showdown_3ab6bded:
    "После я натягиваю плавки, вдруг вспомнив, что мы в общественном месте."

# ch/harems_full/goodevil/events.rpy:370
translate russian harmony_lexi_showdown_239c78e9:
    "Хармони и Лекси всё ещё сидят на земле, тяжело дышат и поглядывают друг на друга."

# ch/harems_full/goodevil/events.rpy:371
translate russian harmony_lexi_showdown_2c7db3be:
    "Но, кажется, в их взглядах появилось что-то новое."

# ch/harems_full/goodevil/events.rpy:372
translate russian harmony_lexi_showdown_2d24621e:
    "Я схожу с ума или между ними зарождается какое-то странное уважение?"

# ch/harems_full/goodevil/events.rpy:376
translate russian harmony_lexi_showdown_8fa1ae14:
    mike.say "Пойми меня правильно, Лекси..."

# ch/harems_full/goodevil/events.rpy:377
translate russian harmony_lexi_showdown_8b75677c:
    mike.say "Ты хороша."

# ch/harems_full/goodevil/events.rpy:378
translate russian harmony_lexi_showdown_801d59eb:
    mike.say "Но Хармони — лучшая из всех, кто у меня был."

# ch/harems_full/goodevil/events.rpy:380
translate russian harmony_lexi_showdown_60450244:
    "Хармони улыбается во весь рот."

# ch/harems_full/goodevil/events.rpy:381
translate russian harmony_lexi_showdown_97550f66:
    "А Лекси выглядит так, словно готова меня убить."

# ch/harems_full/goodevil/events.rpy:382
translate russian harmony_lexi_showdown_06c513c3:
    lexi.say "Какого хрена, [lssb_common.hero_name()]?"

# ch/harems_full/goodevil/events.rpy:384
translate russian harmony_lexi_showdown_c99d6c00:
    lexi.say "Что за херня вообще?!"

# ch/harems_full/goodevil/events.rpy:385
translate russian harmony_lexi_showdown_90d4eb28:
    "Я поднимаю руки, пытаясь отгородиться от Лекси."

# ch/harems_full/goodevil/events.rpy:387
translate russian harmony_lexi_showdown_8060b480:
    mike.say "Ты же обещала не обижаться на меня!"

# ch/harems_full/goodevil/events.rpy:388
translate russian harmony_lexi_showdown_282a202a:
    "Все мои оправдания приносят лишь пощёчину от Лекси."

# ch/harems_full/goodevil/events.rpy:389
translate russian harmony_lexi_showdown_87140f0d:
    "Пока я прихожу в себя, она встаёт и хватает свои вещи."

# ch/harems_full/goodevil/events.rpy:390
translate russian harmony_lexi_showdown_190e6e61:
    lexi.say "Пошёл ты, [lssb_common.hero_name()]."

# ch/harems_full/goodevil/events.rpy:392
translate russian harmony_lexi_showdown_1831cbbe:
    "Я смотрю, как Лекси в ярости уходит по пляжу."

# ch/harems_full/goodevil/events.rpy:393
translate russian harmony_lexi_showdown_d610d81f:
    "Но тут чувствую чью-то руку у себя на паху."

# ch/harems_full/goodevil/events.rpy:394
translate russian harmony_lexi_showdown_a0565d21:
    "Оглядываюсь и вижу, что Хармони придвинулась ко мне."

# ch/harems_full/goodevil/events.rpy:395
translate russian harmony_lexi_showdown_727f8aba:
    harmony.say "Забудь об этой сучке, [lssb_common.hero_name()]."

# ch/harems_full/goodevil/events.rpy:396
translate russian harmony_lexi_showdown_60964503:
    harmony.say "Я хочу поговорить о твоём ответе."

# ch/harems_full/goodevil/events.rpy:398
translate russian harmony_lexi_showdown_1b03fa83:
    harmony.say "О том, что я сосу лучше всех, кто у тебя был..."

# ch/harems_full/goodevil/events.rpy:404
translate russian harmony_lexi_showdown_26f5eb34:
    mike.say "Не сердись, Хармони..."

# ch/harems_full/goodevil/events.rpy:405
translate russian harmony_lexi_showdown_773c1a8c:
    mike.say "Ты прекрасно делаешь минет."

# ch/harems_full/goodevil/events.rpy:406
translate russian harmony_lexi_showdown_787fc0b4:
    mike.say "Но в этом Лекси тебя обошла."

# ch/harems_full/goodevil/events.rpy:408
translate russian harmony_lexi_showdown_c27821ae:
    "Лекси улыбается во весь рот."

# ch/harems_full/goodevil/events.rpy:409
translate russian harmony_lexi_showdown_47ec3120:
    "А Хармони, похоже, чертовски зла."

# ch/harems_full/goodevil/events.rpy:410
translate russian harmony_lexi_showdown_0bd6e39d:
    harmony.say "Как ты можешь такое говорить, [lssb_common.hero_name()]?"

# ch/harems_full/goodevil/events.rpy:412
translate russian harmony_lexi_showdown_75148f2c:
    harmony.say "Как ты можешь предпочесть мне эту дешёвую шлюху?!"

# ch/harems_full/goodevil/events.rpy:413
translate russian harmony_lexi_showdown_a9e323a4:
    "Я поднимаю руки, пытаясь отгородиться от Хармони."

# ch/harems_full/goodevil/events.rpy:415
translate russian harmony_lexi_showdown_498044e7:
    mike.say "Это была твоя идея, Хармони!"

# ch/harems_full/goodevil/events.rpy:416
translate russian harmony_lexi_showdown_2de9fd6f:
    "Все мои оправдания приносят лишь пощёчину от Хармони."

# ch/harems_full/goodevil/events.rpy:417
translate russian harmony_lexi_showdown_87140f0d_1:
