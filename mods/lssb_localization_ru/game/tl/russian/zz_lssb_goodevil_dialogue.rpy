    mike.say "Хорошо, значит, двое за."

# ch/harems_full/goodevil/events.rpy:744
translate russian goodevil_harem_event_01_d3175e9a:
    mike.say "А ты что скажешь, Лекси?"

# ch/harems_full/goodevil/events.rpy:747
translate russian goodevil_harem_event_01_d726db3a:
    "Стоит повернуться к Лекси, как я начинаю жалеть о своём решении."

# ch/harems_full/goodevil/events.rpy:748
translate russian goodevil_harem_event_01_dc85c145_1:
    "По её лицу сразу видно: она не в восторге."

# ch/harems_full/goodevil/events.rpy:749
translate russian goodevil_harem_event_01_d13cc423:
    lexi.say "Конечно, я против."

# ch/harems_full/goodevil/events.rpy:750
translate russian goodevil_harem_event_01_1be31a88:
    lexi.say "И спасибо, что напомнил: я тут самая старая!"

# ch/harems_full/goodevil/events.rpy:751
translate russian goodevil_harem_event_01_63287a28:
    harmony.say "Жаль, Лекси."

# ch/harems_full/goodevil/events.rpy:752
translate russian goodevil_harem_event_01_603a2227:
    harmony.say "Ты в меньшинстве: два против одного!"

# ch/harems_full/goodevil/events.rpy:754
translate russian goodevil_harem_event_01_f011c54c:
    "Я смотрю, как Лекси встаёт и идёт к бару."

# ch/harems_full/goodevil/events.rpy:755
translate russian goodevil_harem_event_01_79a10f12_1:
    "И всю дорогу что-то бормочет себе под нос."

# ch/harems_full/goodevil/events.rpy:760
translate russian goodevil_harem_event_01_08fbfffa:
    "Стоит повернуться к Лекси, как я вижу: ей эта идея нравится."

# ch/harems_full/goodevil/events.rpy:761
translate russian goodevil_harem_event_01_bbe87466:
    lexi.say "Это действительно отличная идея."

# ch/harems_full/goodevil/events.rpy:762
translate russian goodevil_harem_event_01_8e7f2038:
    lexi.say "Спасибо, [lssb_common.hero_name()]."

# ch/harems_full/goodevil/events.rpy:763
