    bree.say "Хм... тот парень из «Трона»?"

# ch/harems/home/events/home_harem_halloween_event.rpy:405
translate russian halloween_event_7f48bc4b:
    bree.say "Которого омолаживали компьютерной графикой?"

# ch/harems/home/events/home_harem_halloween_event.rpy:407
translate russian halloween_event_95ba8700:
    mike.say "Нет, [lssb_halloween.bree_name()], я тот же парень, но из первого фильма."

# ch/harems/home/events/home_harem_halloween_event.rpy:408
translate russian halloween_event_d52c9c8d:
    bree.say "Был ещё один фильм «Трон»?!?"

# ch/harems/home/events/home_harem_halloween_event.rpy:409
translate russian halloween_event_d58ea437:
    sasha.say "И зачем выбирать персонажа из древнего кино?"

# ch/harems/home/events/home_harem_halloween_event.rpy:411
translate russian halloween_event_e7a5985e:
    "Я раздражённо закатываю глаза."

# ch/harems/home/events/home_harem_halloween_event.rpy:412
translate russian halloween_event_eeaf29cd:
    mike.say "К твоему сведению, Саша, это классика."

# ch/harems/home/events/home_harem_halloween_event.rpy:413
translate russian halloween_event_042b2467:
    mike.say "И он программист, как и я, вообще-то."

# ch/harems/home/events/home_harem_halloween_event.rpy:414
translate russian halloween_event_c5a2c5e9:
    bree.say "Он там вроде застревает внутри игры, да?"

# ch/harems/home/events/home_harem_halloween_event.rpy:415
translate russian halloween_event_48f81b94:
    bree.say "Какой кошмар!"

# ch/harems/home/events/home_harem_halloween_event.rpy:417
translate russian halloween_event_1ff28d33:
    "Я киваю и тут же содрогаюсь от одной мысли о такой участи."

# ch/harems/home/events/home_harem_halloween_event.rpy:419
translate russian halloween_event_e07fe8a4:
    "Не представляю, как ужасно было бы, если бы моей жизнью управлял кто-то другой!"

# ch/harems/home/events/home_harem_halloween_event.rpy:422
translate russian halloween_event_0837f25e:
    "Но дверной звонок заставляет отбросить эту мысль."

# ch/harems/home/events/home_harem_halloween_event.rpy:423
translate russian halloween_event_d8f619fc:
    "Пора вернуться в реальность и перестать думать о видеоиграх."

# ch/harems/home/events/home_harem_halloween_event.rpy:428
translate russian halloween_event_da15e0e5:
    "Я поворачиваюсь, открываю дверь — и вижу, как на меня опускается меч."

# ch/harems/home/events/home_harem_halloween_event.rpy:431
translate russian halloween_event_4cb5b24f:
    mike.say "А-А-А!"

# ch/harems/home/events/home_harem_halloween_event.rpy:432
translate russian halloween_event_ff19246e:
    jack.say "Ого!"

# ch/harems/home/events/home_harem_halloween_event.rpy:433
translate russian halloween_event_eb2cb7e1:
    jack.say "Прости, дружище!"

# ch/harems/home/events/home_harem_halloween_event.rpy:435
translate russian halloween_event_a348b09d:
    "Открываю глаза: на пороге стоит Джек."

# ch/harems/home/events/home_harem_halloween_event.rpy:437
translate russian halloween_event_3af4b253:
    "Пластмассовый меч теперь опущен, а сам он выглядит немного смущённым."

# ch/harems/home/events/home_harem_halloween_event.rpy:443
translate russian halloween_event_ac45422d:
    "Отступив, чтобы впустить его, я наконец замечаю костюм."

# ch/harems/home/events/home_harem_halloween_event.rpy:444
translate russian halloween_event_c979f866:
    "На нём меховые шорты, сапоги и почти больше ничего."

# ch/harems/home/events/home_harem_halloween_event.rpy:445
translate russian halloween_event_73924d5d:
    jack.say "Приветствую вас от имени Киммерии!"

# ch/harems/home/events/home_harem_halloween_event.rpy:447
translate russian halloween_event_9d74283b:
    sasha.say "О, силой Серого Черепа!"

# ch/harems/home/events/home_harem_halloween_event.rpy:448
translate russian halloween_event_860a3ddf:
    jack.say "А?"

# ch/harems/home/events/home_harem_halloween_event.rpy:450
translate russian halloween_event_76510f1e:
    sasha.say "Ты ведь Хи-Мен, да?"

# ch/harems/home/events/home_harem_halloween_event.rpy:452
translate russian halloween_event_c573c172:
    bree.say "Не-а, Саша, он Конан!"

# ch/harems/home/events/home_harem_halloween_event.rpy:456
translate russian halloween_event_917cc110:
    "Было бы легко посмеяться вместе с Сашей."

# ch/harems/home/events/home_harem_halloween_event.rpy:457
translate russian halloween_event_f2fc74fb:
    "Но Джек мой друг, и я должен его защитить."

# ch/harems/home/events/home_harem_halloween_event.rpy:458
translate russian halloween_event_8efa4b15:
    mike.say "Ты права, [lssb_halloween.bree_name()]."

# ch/harems/home/events/home_harem_halloween_event.rpy:460
translate russian halloween_event_25719655:
    mike.say "Он точно Конан."

# ch/harems/home/events/home_harem_halloween_event.rpy:461
translate russian halloween_event_a7a51c8f:
    mike.say "У Хи-Мена нагрудник и стрижка каре!"

# ch/harems/home/events/home_harem_halloween_event.rpy:463
translate russian halloween_event_76f639ec:
    "Джек, кажется, немного приходит в себя."

# ch/harems/home/events/home_harem_halloween_event.rpy:464
translate russian halloween_event_268188cc:
    "Кивает и слабо улыбается."

# ch/harems/home/events/home_harem_halloween_event.rpy:465
translate russian halloween_event_b85a6f9a:
    jack.say "Спасибо, дружище."

# ch/harems/home/events/home_harem_halloween_event.rpy:467
translate russian halloween_event_fc2d9424:
    jack.say "Я столько возился с этим костюмом!"

# ch/harems/home/events/home_harem_halloween_event.rpy:469
translate russian halloween_event_dfdb8a83:
    "Саша качает головой, глядя на нас троих."

# ch/harems/home/events/home_harem_halloween_event.rpy:470
translate russian halloween_event_daca4460:
    sasha.say "Господи, да расслабьтесь вы!"

# ch/harems/home/events/home_harem_halloween_event.rpy:471
translate russian halloween_event_7d698355:
    sasha.say "У нас вообще-то вечеринка."

# ch/harems/home/events/home_harem_halloween_event.rpy:473
translate russian halloween_event_906d9fb5:
    "Но в то же время я замечаю, что [lssb_halloween.bree_name()] мне улыбается."

# ch/harems/home/events/home_harem_halloween_event.rpy:474
translate russian halloween_event_ae9e6bc3:
    "Похоже, ей понравилось, что я заступился за Джека."

# ch/harems/home/events/home_harem_halloween_event.rpy:476
translate russian halloween_event_fd5cc94d:
    "Не могу удержаться от смеха при виде лица Джека."

# ch/harems/home/events/home_harem_halloween_event.rpy:477
translate russian halloween_event_5b958c9a:
    "Совершенно очевидно, что он нарядился Конаном."

# ch/harems/home/events/home_harem_halloween_event.rpy:478
translate russian halloween_event_d4302c7d:
    "Но Хи-Мен куда смешнее!"

# ch/harems/home/events/home_harem_halloween_event.rpy:479
translate russian halloween_event_dbc78cf1:
    mike.say "Ага, Джек, Саша права."

# ch/harems/home/events/home_harem_halloween_event.rpy:482
translate russian halloween_event_739d44e7:
    mike.say "Вылитый Хи-Мен!"

# ch/harems/home/events/home_harem_halloween_event.rpy:484
translate russian halloween_event_dff061b8:
    "Джек явно обижен."

# ch/harems/home/events/home_harem_halloween_event.rpy:485
translate russian halloween_event_04262783:
    "Даже меч в его руке словно поникает."

# ch/harems/home/events/home_harem_halloween_event.rpy:486
translate russian halloween_event_2b2a7d7b:
    jack.say "Эй, я столько возился с этим костюмом!"

# ch/harems/home/events/home_harem_halloween_event.rpy:488
translate russian halloween_event_66fec46a:
    bree.say "Да, [lssb_common.hero_name()], не будь злым!"

# ch/harems/home/events/home_harem_halloween_event.rpy:490
translate russian halloween_event_b19879fa:
    "Мы с Сашей продолжаем смеяться."

# ch/harems/home/events/home_harem_halloween_event.rpy:491
translate russian halloween_event_c5af1027:
    "А [lssb_halloween.bree_name()] хмурится и качает головой."

# ch/harems/home/events/home_harem_halloween_event.rpy:493
translate russian halloween_event_efb7f836:
    "Она пытается утешить Джека как может."

# ch/harems/home/events/home_harem_halloween_event.rpy:494
translate russian halloween_event_623e4950:
    "И я почти сразу вижу, как его настроение улучшается."

# ch/harems/home/events/home_harem_halloween_event.rpy:496
translate russian halloween_event_6b8e3219:
    "Едва мы успеваем завести Джека внутрь, звонок раздаётся снова."

# ch/harems/home/events/home_harem_halloween_event.rpy:497
translate russian halloween_event_d7e7ec18:
    "Я всё ещё ближе всех к двери, поэтому открываю почти не задумываясь."

# ch/harems/home/events/home_harem_halloween_event.rpy:502
translate russian halloween_event_ceee40cc:
    "И сразу вижу три острых зубца в паре сантиметров от носа."

# ch/harems/home/events/home_harem_halloween_event.rpy:504
translate russian halloween_event_ce514055:
    "Да блядь, это уже становится нелепым!"

# ch/harems/home/events/home_harem_halloween_event.rpy:506
translate russian halloween_event_e0dd5762:
    scottie.say "Трепещите перед моей могучей морской мускулатурой!"

# ch/harems/home/events/home_harem_halloween_event.rpy:507
translate russian halloween_event_94bdf302:
    "Я моргаю: передо мной Скотти с резиновым трезубцем."

# ch/harems/home/events/home_harem_halloween_event.rpy:508
translate russian halloween_event_680032f3:
    "На нём оранжевый верх и зелёные легинсы, и то и другое с рисунком чешуи."

# ch/harems/home/events/home_harem_halloween_event.rpy:509
translate russian halloween_event_9d410b5f:
    "Но больше всего привлекает внимание рыжий парик."

# ch/harems/home/events/home_harem_halloween_event.rpy:510
translate russian halloween_event_301c1d0a:
    mike.say "Входи, о владыка глубин!"

# ch/harems/home/events/home_harem_halloween_event.rpy:516
translate russian halloween_event_51fae463:
    "Приходится прикрыть рот, чтобы не рассмеяться."

# ch/harems/home/events/home_harem_halloween_event.rpy:518
translate russian halloween_event_a8db07e6:
    "Я вижу, как лицо Скотти становится озадаченным."

# ch/harems/home/events/home_harem_halloween_event.rpy:520
translate russian halloween_event_7a15c416:
    scottie.say "Эм... что такое, чувак?"

# ch/harems/home/events/home_harem_halloween_event.rpy:521
translate russian halloween_event_3e0048d4:
    scottie.say "Я же типа Аквамен, да?"

# ch/harems/home/events/home_harem_halloween_event.rpy:522
translate russian halloween_event_16b6ad25:
    scottie.say "Ну, тот, по которому девчонки с ума сходят?"

# ch/harems/home/events/home_harem_halloween_event.rpy:523
translate russian halloween_event_af164e6d:
    sasha.say "Ты точно Аквамен, Скотти."

# ch/harems/home/events/home_harem_halloween_event.rpy:525
translate russian halloween_event_3e3ab95e:
    bree.say "Ой... только не тот Аквамен!"

# ch/harems/home/events/home_harem_halloween_event.rpy:528
translate russian halloween_event_2c870918:
    "Бедный Скотти: он хотел быть Акваменом в исполнении Джейсона Момоа."

# ch/harems/home/events/home_harem_halloween_event.rpy:529
translate russian halloween_event_25b65663:
    "А ему продали костюм классической версии!"

# ch/harems/home/events/home_harem_halloween_event.rpy:530
translate russian halloween_event_3433fa2c:
    "Над ним было бы проще простого посмеяться."

# ch/harems/home/events/home_harem_halloween_event.rpy:532
translate russian halloween_event_9c2e6088:
    "Но я вижу, что Саше уже жалко парня."

# ch/harems/home/events/home_harem_halloween_event.rpy:533
translate russian halloween_event_c246ee3d:
    mike.say "Скотти, не знал, что ты такой ценитель первоисточника!"

# ch/harems/home/events/home_harem_halloween_event.rpy:534
translate russian halloween_event_c3608caf:
    scottie.say "Я... кто?!?"

# ch/harems/home/events/home_harem_halloween_event.rpy:535
translate russian halloween_event_8e079bfc:
    mike.say "Любой другой пришёл бы Акваменом из кино."

# ch/harems/home/events/home_harem_halloween_event.rpy:536
translate russian halloween_event_dfd4d665:
    mike.say "А вот классического Аквамена выбрал бы только настоящий знаток!"

# ch/harems/home/events/home_harem_halloween_event.rpy:537
translate russian halloween_event_86f6419a:
    "Мозгу Скотти требуется несколько секунд, чтобы это переварить."

# ch/harems/home/events/home_harem_halloween_event.rpy:539
translate russian halloween_event_75aa9597:
    "Но потом он вдруг кивает и улыбается."

# ch/harems/home/events/home_harem_halloween_event.rpy:540
translate russian halloween_event_7c669280:
    scottie.say "Эм... ага... точно!"

# ch/harems/home/events/home_harem_halloween_event.rpy:541
translate russian halloween_event_3c42c15d:
    scottie.say "Как ты и сказал, чувак."

# ch/harems/home/events/home_harem_halloween_event.rpy:542
translate russian halloween_event_262e2e6d:
    "[lssb_halloween.bree_name()] всё ещё тихонько хихикает."

# ch/harems/home/events/home_harem_halloween_event.rpy:544
translate russian halloween_event_f50dbabd:
    "А Саша бросает на меня благодарный взгляд."

# ch/harems/home/events/home_harem_halloween_event.rpy:546
translate russian halloween_event_5127ee90:
    "Меня это вполне устраивает: я сделал это ради неё, а не Скотти!"

# ch/harems/home/events/home_harem_halloween_event.rpy:548
translate russian halloween_event_10c6e0b2:
    "Наверное, стоит заступиться за Скотти."

# ch/harems/home/events/home_harem_halloween_event.rpy:549
translate russian halloween_event_a3395d17:
    "Но стоит он здесь с таким глупым видом."

# ch/harems/home/events/home_harem_halloween_event.rpy:550
translate russian halloween_event_e52f0f09:
    "Не могу удержаться."

# ch/harems/home/events/home_harem_halloween_event.rpy:551
translate russian halloween_event_f6732714:
    mike.say "Ого... Ну ты и лопух, Скотти!"

# ch/harems/home/events/home_harem_halloween_event.rpy:553
translate russian halloween_event_f3066194:
    scottie.say "Чт... что?!?"

# ch/harems/home/events/home_harem_halloween_event.rpy:554
translate russian halloween_event_5797053d:
    mike.say "Ты хотел быть сексуальным Акваменом из кино."

# ch/harems/home/events/home_harem_halloween_event.rpy:555
translate russian halloween_event_9fa6028a:
    mike.say "А тебе продали костюм унылого Аквамена из комиксов!"

# ch/harems/home/events/home_harem_halloween_event.rpy:556
translate russian halloween_event_a08bdcf9:
    "Кажется, мозгу Скотти требуется несколько секунд, чтобы это переварить."

# ch/harems/home/events/home_harem_halloween_event.rpy:557
translate russian halloween_event_76dabe12:
    "Затем он начинает мотать головой и возмущённо бормотать."

# ch/harems/home/events/home_harem_halloween_event.rpy:558
translate russian halloween_event_ed945362:
    scottie.say "Ах, чёрт!"

# ch/harems/home/events/home_harem_halloween_event.rpy:559
translate russian halloween_event_bbe7c29c:
    scottie.say "Так вот почему продавец в магазине костюмов смеялся!"

# ch/harems/home/events/home_harem_halloween_event.rpy:560
translate russian halloween_event_5f1da51e:
    scottie.say "Откуда мне знать все эти задротские штуки?!?"

# ch/harems/home/events/home_harem_halloween_event.rpy:562
translate russian halloween_event_1fba3ea4:
    "Саша смотрит на меня так, что молоко бы скисло."

# ch/harems/home/events/home_harem_halloween_event.rpy:563
translate russian halloween_event_8eeb29b4:
    "Она принимается утешать уязвлённое самолюбие Скотти."

# ch/harems/home/events/home_harem_halloween_event.rpy:564
translate russian halloween_event_ea876c0b:
    "И при этом демонстративно отворачивается от меня."

# ch/harems/home/events/home_harem_halloween_event.rpy:566
translate russian halloween_event_a6268bef:
    "А [lssb_halloween.bree_name()] всё это время продолжает хихикать в ладошку."

# ch/harems/home/events/home_harem_halloween_event.rpy:572
translate russian halloween_event_e7a4ff50:
    "Внезапно я замечаю, как сильно колотится сердце."

# ch/harems/home/events/home_harem_halloween_event.rpy:573
translate russian halloween_event_d18f5775:
    "Не понимаю, что со мной, а затем вспоминаю."

# ch/harems/home/events/home_harem_halloween_event.rpy:574
translate russian halloween_event_0d423a6f:
    "Единственная гостья, которую мы ещё ждём, — моя спутница."

# ch/harems/home/events/home_harem_halloween_event.rpy:575
translate russian halloween_event_f37e4674:
    "Значит, следующей на пороге должна появиться она!"

# ch/harems/home/events/home_harem_halloween_event.rpy:588
translate russian halloween_event_ee9b2a56:
    "Вот и все гости."

# ch/harems/home/events/home_harem_halloween_event.rpy:589
translate russian halloween_event_186aa97a:
    "Теперь пора заняться вечеринкой."

# ch/harems/home/events/home_harem_halloween_event.rpy:592
translate russian halloween_event_e86787e8:
    "Но прежде чем успеваю об этом подумать, в дверь снова стучат."

# ch/harems/home/events/home_harem_halloween_event.rpy:623
translate russian nodate_halloween_party_fc34486d:
    "Кажется, вечеринка начинается удачно."

# ch/harems/home/events/home_harem_halloween_event.rpy:624
translate russian nodate_halloween_party_e36a86bd:
    "Все либо весело болтают,"

# ch/harems/home/events/home_harem_halloween_event.rpy:625
translate russian nodate_halloween_party_f43e33a9:
    "либо танцуют на импровизированном танцполе."

# ch/harems/home/events/home_harem_halloween_event.rpy:626
translate russian nodate_halloween_party_3de4584d:
    "А наш хэллоуинский плейлист отлично дополняет атмосферу."

# ch/harems/home/events/home_harem_halloween_event.rpy:627
translate russian nodate_halloween_party_8f262a0e:
    "Я и сам начинаю проникаться настроением."

# ch/harems/home/events/home_harem_halloween_event.rpy:628
translate russian nodate_halloween_party_40368a89:
    "Пока все веселятся, время просто летит."

# ch/harems/home/events/home_harem_halloween_event.rpy:629
translate russian nodate_halloween_party_7046145e:
    "И лишь повышенные голоса возвращают меня к происходящему."

# ch/harems/home/events/home_harem_halloween_event.rpy:630
translate russian nodate_halloween_party_a2d5474d:
    "Сперва я думаю, кто-то просто пытается перекричать музыку."

# ch/harems/home/events/home_harem_halloween_event.rpy:631
translate russian nodate_halloween_party_4764d3b1:
    "Но затем понимаю, что это [lssb_halloween.bree_name()] и Саша, и они явно не в духе."

# ch/harems/home/events/home_harem_halloween_event.rpy:632
translate russian nodate_halloween_party_9599278f:
    "Иду на голоса и нахожу их у стола в столовой."

# ch/harems/home/events/home_harem_halloween_event.rpy:633
translate russian nodate_halloween_party_4b8ebc86:
    "Мы заранее выставили там еду и напитки в духе Хэллоуина."

# ch/harems/home/events/home_harem_halloween_event.rpy:634
translate russian nodate_halloween_party_f0fb0bbb:
    "Пунш, миски с конфетами и прочее угощение."

# ch/harems/home/events/home_harem_halloween_event.rpy:635
translate russian nodate_halloween_party_cc39de2b:
    "Конечно, никакого грандиозного пира."

# ch/harems/home/events/home_harem_halloween_event.rpy:636
translate russian nodate_halloween_party_82fba777:
    "Просто подумали, что гостям захочется перекусить."

# ch/harems/home/events/home_harem_halloween_event.rpy:643
translate russian nodate_halloween_party_f7e79d63:
    "Добравшись до источника шума, вижу: [lssb_halloween.bree_name()] и Саша стоят по одну сторону стола."

# ch/harems/home/events/home_harem_halloween_event.rpy:644
translate russian nodate_halloween_party_4e739875:
    "Они строго и неодобрительно смотрят на другую сторону."

# ch/harems/home/events/home_harem_halloween_event.rpy:645
translate russian nodate_halloween_party_94138baa:
    "Там стоят Джек и Скотти с явно смущённым видом."

# ch/harems/home/events/home_harem_halloween_event.rpy:646
translate russian nodate_halloween_party_2c335350:
    "Замечаю, что оба держат тарелки."

# ch/harems/home/events/home_harem_halloween_event.rpy:647
translate russian nodate_halloween_party_e70c0be2:
    "Тарелки с опасно высокими горами еды со стола."

# ch/harems/home/events/home_harem_halloween_event.rpy:648
translate russian nodate_halloween_party_801e16a4:
    "При виде меня все словно оживают."

# ch/harems/home/events/home_harem_halloween_event.rpy:650
translate russian nodate_halloween_party_326ae400:
    bree.say "Ты только посмотри на них, [lssb_common.hero_name()]?!?"

# ch/harems/home/events/home_harem_halloween_event.rpy:652
translate russian nodate_halloween_party_a951266d:
    sasha.say "Ага, [lssb_halloween.bree_name()] права: они настоящие свиньи!"

# ch/harems/home/events/home_harem_halloween_event.rpy:655
translate russian nodate_halloween_party_c1f82c2e:
    "Прежде чем я успеваю что-то сказать, Джек и Скотти начинают говорить."

# ch/harems/home/events/home_harem_halloween_event.rpy:656
translate russian nodate_halloween_party_d4f1a15c:
    "Оба спешат себя защитить."

# ch/harems/home/events/home_harem_halloween_event.rpy:657
translate russian nodate_halloween_party_f291c99f:
    jack.say "Эй, так нечестно!"

# ch/harems/home/events/home_harem_halloween_event.rpy:658
translate russian nodate_halloween_party_8f7651a0:
    jack.say "Мы просто проголодались, вот и всё!"

# ch/harems/home/events/home_harem_halloween_event.rpy:660
translate russian nodate_halloween_party_1a610b8c:
    scottie.say "Точно, чувак!"

# ch/harems/home/events/home_harem_halloween_event.rpy:661
translate russian nodate_halloween_party_04d2df0f:
    scottie.say "Мы не знали, что тут еда по талонам!"

# ch/harems/home/events/home_harem_halloween_event.rpy:662
translate russian nodate_halloween_party_2c9ccce7:
    "Кажется, все высказались."

# ch/harems/home/events/home_harem_halloween_event.rpy:663
translate russian nodate_halloween_party_18546d6d:
    "Теперь все смотрят на меня."

# ch/harems/home/events/home_harem_halloween_event.rpy:664
translate russian nodate_halloween_party_90d17d2a:
    "Явно ждут, что я разрешу спор."

# ch/harems/home/events/home_harem_halloween_event.rpy:665
translate russian nodate_halloween_party_b3d92bd6:
    "И у меня такое чувство, что каждый уверен: я встану именно на его сторону!"

# ch/harems/home/events/home_harem_halloween_event.rpy:668
translate russian nodate_halloween_party_fe4d3cb0:
    "Понимаю, никто не предупреждал Джека и Скотти, чтобы не налегали на угощение."

# ch/harems/home/events/home_harem_halloween_event.rpy:669
translate russian nodate_halloween_party_5605d00d:
    "Но они ведь вроде взрослые люди."

# ch/harems/home/events/home_harem_halloween_event.rpy:670
translate russian nodate_halloween_party_da182cda:
    "И должны знать хотя бы простое правило: не съедать всё самим!"

# ch/harems/home/events/home_harem_halloween_event.rpy:671
translate russian nodate_halloween_party_7586f2d7:
    mike.say "Не помню, чтобы я обещал пир!"

# ch/harems/home/events/home_harem_halloween_event.rpy:672
translate russian nodate_halloween_party_d5de5f79:
    mike.say "Вам стоило поесть до прихода."

# ch/harems/home/events/home_harem_halloween_event.rpy:675
translate russian nodate_halloween_party_f81348ab:
    "Обрадовавшись моей поддержке, [lssb_halloween.bree_name()] и Саша тоже идут в наступление."

# ch/harems/home/events/home_harem_halloween_event.rpy:677
translate russian nodate_halloween_party_a447fbff:
    bree.say "То, что на тарелках, можете съесть."

# ch/harems/home/events/home_harem_halloween_event.rpy:678
translate russian nodate_halloween_party_74e68fda:
    bree.say "Но больше я вас у этого стола видеть не хочу!"

# ch/harems/home/events/home_harem_halloween_event.rpy:680
translate russian nodate_halloween_party_9c0a9876:
    sasha.say "И молитесь, чтобы еда не закончилась."

# ch/harems/home/events/home_harem_halloween_event.rpy:681
translate russian nodate_halloween_party_d46ec76a:
    sasha.say "Потому что иначе будете заказывать пиццу всем остальным!"

# ch/harems/home/events/home_harem_halloween_event.rpy:684
translate russian nodate_halloween_party_a6b01bd2:
    jack.say "Ну-у..."

# ch/harems/home/events/home_harem_halloween_event.rpy:685
translate russian nodate_halloween_party_3e7bf54c:
    jack.say "Так нечестно!"

# ch/harems/home/events/home_harem_halloween_event.rpy:687
translate russian nodate_halloween_party_4c643171:
    scottie.say "Но... эм..."

# ch/harems/home/events/home_harem_halloween_event.rpy:688
translate russian nodate_halloween_party_c458b124:
    scottie.say "Если всё-таки придётся брать пиццу..."

# ch/harems/home/events/home_harem_halloween_event.rpy:689
translate russian nodate_halloween_party_85d48e2d:
    scottie.say "Нам тоже можно будет, да?"

# ch/harems/home/events/home_harem_halloween_event.rpy:691
translate russian nodate_halloween_party_4d901268:
    "[lssb_halloween.bree_name()] и Саша закатывают глаза и стонут."

# ch/harems/home/events/home_harem_halloween_event.rpy:692
translate russian nodate_halloween_party_4ce59bab:
    bree.say "Как вы ВСЁ ЕЩЁ можете быть голодными?"

# ch/harems/home/events/home_harem_halloween_event.rpy:693
translate russian nodate_halloween_party_c83246b4:
    sasha.say "У вас солитёр, что ли?!?"

# ch/harems/home/events/home_harem_halloween_event.rpy:695
translate russian nodate_halloween_party_2bf8d640:
    "Понимаю, что [lssb_halloween.bree_name()] и Саша злятся: парни совсем потеряли меру."

# ch/harems/home/events/home_harem_halloween_event.rpy:696
translate russian nodate_halloween_party_7083e8c2:
    "Но они правы: мы не говорили им себя ограничивать."

# ch/harems/home/events/home_harem_halloween_event.rpy:697
translate russian nodate_halloween_party_07760f2b:
    "Да и еда предназначалась для гостей."

# ch/harems/home/events/home_harem_halloween_event.rpy:698
translate russian nodate_halloween_party_400bc1c4:
    mike.say "Да ладно вам, у нас же вечеринка."

# ch/harems/home/events/home_harem_halloween_event.rpy:699
translate russian nodate_halloween_party_767e844d:
    mike.say "Кому охота весь вечер спорить?"

# ch/harems/home/events/home_harem_halloween_event.rpy:702
translate russian nodate_halloween_party_3a10d48d:
    "[lssb_halloween.bree_name()] и Саша возмущены тем, как я отмахнулся от их недовольства."

# ch/harems/home/events/home_harem_halloween_event.rpy:703
translate russian nodate_halloween_party_83802797:
    "А Джек и Скотти тут же меня поддерживают."

# ch/harems/home/events/home_harem_halloween_event.rpy:705
translate russian nodate_halloween_party_6e101b98:
    jack.say "Просто всё выглядело таким вкусным!"

# ch/harems/home/events/home_harem_halloween_event.rpy:706
translate russian nodate_halloween_party_1432c61b:
    jack.say "Мы не удержались!"

# ch/harems/home/events/home_harem_halloween_event.rpy:707
translate russian nodate_halloween_party_99612fe3:
    scottie.say "Ага, точно."

# ch/harems/home/events/home_harem_halloween_event.rpy:708
translate russian nodate_halloween_party_95de9ff4:
    scottie.say "Давно ничего вкуснее не ел!"

# ch/harems/home/events/home_harem_halloween_event.rpy:710
translate russian nodate_halloween_party_b1e163fb:
    bree.say "О..."

# ch/harems/home/events/home_harem_halloween_event.rpy:711
translate russian nodate_halloween_party_3826200c:
    bree.say "Вы правда так думаете?"

# ch/harems/home/events/home_harem_halloween_event.rpy:712
translate russian nodate_halloween_party_77a36002:
    "[lssb_halloween.bree_name()], возможно, и поддалась на внезапную лесть."

# ch/harems/home/events/home_harem_halloween_event.rpy:713
translate russian nodate_halloween_party_2e6f93a7:
    "Но Саша сделана из более крепкого теста."

# ch/harems/home/events/home_harem_halloween_event.rpy:714
translate russian nodate_halloween_party_bef10869:
    sasha.say "Ну, молитесь, чтобы еда не закончилась."

# ch/harems/home/events/home_harem_halloween_event.rpy:716
translate russian nodate_halloween_party_d46ec76a_1:
    sasha.say "Потому что тогда вы заказываете пиццу для всех остальных!"

# ch/harems/home/events/home_harem_halloween_event.rpy:719
translate russian nodate_halloween_party_a6b01bd2_1:
    jack.say "Ну-у..."

# ch/harems/home/events/home_harem_halloween_event.rpy:720
translate russian nodate_halloween_party_3e7bf54c_1:
    jack.say "Так нечестно!"

# ch/harems/home/events/home_harem_halloween_event.rpy:722
translate russian nodate_halloween_party_4c643171_1:
    scottie.say "Но... э-э..."

# ch/harems/home/events/home_harem_halloween_event.rpy:723
translate russian nodate_halloween_party_c458b124_1:
    scottie.say "Если нам всё-таки придётся заказать пиццу..."

# ch/harems/home/events/home_harem_halloween_event.rpy:724
translate russian nodate_halloween_party_85d48e2d_1:
    scottie.say "Нам ведь тоже можно будет поесть, да?"

# ch/harems/home/events/home_harem_halloween_event.rpy:726
translate russian nodate_halloween_party_4d901268_1:
    "[lssb_halloween.bree_name()] и Саша закатывают глаза и стонут."

# ch/harems/home/events/home_harem_halloween_event.rpy:727
translate russian nodate_halloween_party_4ce59bab_1:
    bree.say "Как вы можете ДО СИХ ПОР быть голодными?"

# ch/harems/home/events/home_harem_halloween_event.rpy:729
translate russian nodate_halloween_party_c83246b4_1:
    sasha.say "У вас что, глисты?!"

# ch/harems/home/events/home_harem_halloween_event.rpy:737
translate russian nodate_halloween_dance_16be8622:
    "Когда мне наконец снова удаётся остановиться и перевести дух, до меня кое-что доходит."

# ch/harems/home/events/home_harem_halloween_event.rpy:738
translate russian nodate_halloween_dance_c95c14a9:
    "С начала вечеринки прошло уже несколько часов."

# ch/harems/home/events/home_harem_halloween_event.rpy:739
translate russian nodate_halloween_dance_718f2825:
    "А я ещё ни разу не успел потанцевать!"

# ch/harems/home/events/home_harem_halloween_event.rpy:740
translate russian nodate_halloween_dance_857d627f:
    "Оглядываю комнату в поисках партнёрши."

# ch/harems/home/events/home_harem_halloween_event.rpy:741
translate russian nodate_halloween_dance_9f599f26:
    "Которую же счастливицу пригласить на танец?"

# ch/harems/home/events/home_harem_halloween_event.rpy:745
translate russian nodate_halloween_dance_fe7e321b:
    mike.say "Эй, [lssb_halloween.bree_name()]..."

# ch/harems/home/events/home_harem_halloween_event.rpy:746
translate russian nodate_halloween_dance_91c8aa7e:
    mike.say "Хочешь потанцевать со мной?"

# ch/harems/home/events/home_harem_halloween_event.rpy:748
translate russian nodate_halloween_dance_d0e6e503:
    "[lssb_halloween.bree_name()] выглядит немного удивлённой моим вопросом."

# ch/harems/home/events/home_harem_halloween_event.rpy:749
translate russian nodate_halloween_dance_acd3f6e8:
    "Но это приятное удивление, понимаете?"

# ch/harems/home/events/home_harem_halloween_event.rpy:750
translate russian nodate_halloween_dance_4a5e177d:
    "Скорее неожиданное, но желанное предложение."

# ch/harems/home/events/home_harem_halloween_event.rpy:753
translate russian nodate_halloween_dance_f5dad005:
    "Конечно, [lssb_common.hero_name()]."

# ch/harems/home/events/home_harem_halloween_event.rpy:754
translate russian nodate_halloween_dance_fcf2ade3:
    bree.say "Будет весело!"

# ch/harems/home/events/home_harem_halloween_event.rpy:755
translate russian nodate_halloween_dance_72abf980:
    "[lssb_halloween.bree_name()] радостно хихикает, пока я веду её танцевать."

# ch/harems/home/events/home_harem_halloween_event.rpy:759
translate russian nodate_halloween_dance_50342e03:
    "Стоит нам начать танец, и музыка будто перестаёт иметь значение."

# ch/harems/home/events/home_harem_halloween_event.rpy:760
translate russian nodate_halloween_dance_313dc4a2:
    "Важно лишь то, что мы вместе и нам хорошо."

# ch/harems/home/events/home_harem_halloween_event.rpy:761
translate russian nodate_halloween_dance_2f255db2:
    "Меня вполне устраивает просто веселиться без лишних мыслей."

# ch/harems/home/events/home_harem_halloween_event.rpy:762
translate russian nodate_halloween_dance_6303667c:
    "Но вскоре я начинаю подозревать, что [lssb_halloween.bree_name()] задумала кое-что ещё."

# ch/harems/home/events/home_harem_halloween_event.rpy:763
translate russian nodate_halloween_dance_17bbc04c:
    "Она танцует так близко ко мне, как только может."

# ch/harems/home/events/home_harem_halloween_event.rpy:764
translate russian nodate_halloween_dance_0e96a926:
    "И, кажется, всё время прижимается ко мне."

# ch/harems/home/events/home_harem_halloween_event.rpy:765
translate russian nodate_halloween_dance_119d0d00:
    "Я совсем не жалуюсь."

# ch/harems/home/events/home_harem_halloween_event.rpy:766
translate russian nodate_halloween_dance_1e96e404:
    "Более того, уже чувствую, как в одном месте становится твёрже!"

# ch/harems/home/events/home_harem_halloween_event.rpy:767
translate russian nodate_halloween_dance_ab9c4416:
    "[lssb_halloween.bree_name()], похоже, тоже это замечает."

# ch/harems/home/events/home_harem_halloween_event.rpy:768
translate russian nodate_halloween_dance_1d637f39:
    "Она снова хихикает и трёт ладонью мою промежность."

# ch/harems/home/events/home_harem_halloween_event.rpy:769
translate russian nodate_halloween_dance_6058448b:
    bree.say "Эй, [lssb_common.hero_name()]!"

# ch/harems/home/events/home_harem_halloween_event.rpy:770
translate russian nodate_halloween_dance_5317a19e:
    bree.say "Вообще-то механик здесь я."

# ch/harems/home/events/home_harem_halloween_event.rpy:771
translate russian nodate_halloween_dance_14636cb3:
    bree.say "Почему же такой здоровенный инструмент у тебя?"

# ch/harems/home/events/home_harem_halloween_event.rpy:772
translate russian nodate_halloween_dance_ebab8af0:
    "Я нервно смеюсь, не находя, что ещё сделать."

# ch/harems/home/events/home_harem_halloween_event.rpy:773
translate russian nodate_halloween_dance_367f5b79:
    "И до конца танца чувствую, как мой член становится всё твёрже!"

# ch/harems/home/events/home_harem_halloween_event.rpy:774
translate russian nodate_halloween_dance_97173d56:
    "Я и не знал, что [lssb_halloween.bree_name()] умеет так флиртовать!"

# ch/harems/home/events/home_harem_halloween_event.rpy:777
translate russian nodate_halloween_dance_b473e365:
    mike.say "Эй, Саша..."

# ch/harems/home/events/home_harem_halloween_event.rpy:778
translate russian nodate_halloween_dance_c1cf4b29:
    mike.say "Как дела?"

# ch/harems/home/events/home_harem_halloween_event.rpy:780
translate russian nodate_halloween_dance_43cb7daf:
    "Саша натянуто улыбается мне."

# ch/harems/home/events/home_harem_halloween_event.rpy:781
translate russian nodate_halloween_dance_a39d0488:
    "А потом качает головой."

# ch/harems/home/events/home_harem_halloween_event.rpy:783
translate russian nodate_halloween_dance_f371d296:
    sasha.say "Скотти подкатывает ко мне почти весь вечер."

# ch/harems/home/events/home_harem_halloween_event.rpy:784
translate russian nodate_halloween_dance_7071324c:
    sasha.say "А я сейчас СОВСЕМ не в настроении слушать его чушь."

# ch/harems/home/events/home_harem_halloween_event.rpy:785
translate russian nodate_halloween_dance_67febd5c:
    "Она смотрит туда, где стоит Скотти."

# ch/harems/home/events/home_harem_halloween_event.rpy:787
translate russian nodate_halloween_dance_7c8c33e0:
    "А потом неожиданно придвигается ко мне."

# ch/harems/home/events/home_harem_halloween_event.rpy:788
translate russian nodate_halloween_dance_b3d1ee2e:
    "Саша наклоняется, почти прижимаясь к моему боку."

# ch/harems/home/events/home_harem_halloween_event.rpy:789
translate russian nodate_halloween_dance_9ffa4a85:
    sasha.say "Прости, [lssb_common.hero_name()]."

# ch/harems/home/events/home_harem_halloween_event.rpy:790
translate russian nodate_halloween_dance_e16d1acf:
    sasha.say "Просто мне нужно было, чтобы он увидел нас так близко друг к другу."

# ch/harems/home/events/home_harem_halloween_event.rpy:792
translate russian nodate_halloween_dance_82ad94fe:
    sasha.say "До него дошло!"

# ch/harems/home/events/home_harem_halloween_event.rpy:793
translate russian nodate_halloween_dance_c13a0d32:
    "Я киваю, стараясь выглядеть невозмутимо, словно всё понимаю."

# ch/harems/home/events/home_harem_halloween_event.rpy:794
translate russian nodate_halloween_dance_1dc942d1:
    "Но когда Саша так близко, это очень приятно."

# ch/harems/home/events/home_harem_halloween_event.rpy:795
translate russian nodate_halloween_dance_e40e74e0:
    "Может, получится продлить этот момент?"

# ch/harems/home/events/home_harem_halloween_event.rpy:796
translate russian nodate_halloween_dance_160dc45c:
    mike.say "Не переживай, Саша."

# ch/harems/home/events/home_harem_halloween_event.rpy:797
translate russian nodate_halloween_dance_073145c6:
    mike.say "Всегда рад помочь подруге."

# ch/harems/home/events/home_harem_halloween_event.rpy:798
translate russian nodate_halloween_dance_381b4f5c:
    mike.say "Как насчёт танца в знак благодарности?"

# ch/harems/home/events/home_harem_halloween_event.rpy:800
translate russian nodate_halloween_dance_0fb23b84:
    "Саша улыбается мне и кивает."

# ch/harems/home/events/home_harem_halloween_event.rpy:804
translate russian nodate_halloween_dance_dfcf0697:
    "И как только начинает играть песня, которая ей нравится, мы идём танцевать."

# ch/harems/home/events/home_harem_halloween_event.rpy:805
translate russian nodate_halloween_dance_f6bc716c:
    "Со мной Саша вовсе не держится так отстранённо, как со Скотти."

# ch/harems/home/events/home_harem_halloween_event.rpy:806
translate russian nodate_halloween_dance_43977638:
    "С самого начала между нами становится жарко!"

# ch/harems/home/events/home_harem_halloween_event.rpy:807
translate russian nodate_halloween_dance_9cd13fc4:
    "Она двигается в такт музыке, не отдаляясь от меня ни на сантиметр."

# ch/harems/home/events/home_harem_halloween_event.rpy:808
translate russian nodate_halloween_dance_597dc193:
    "А я двигаюсь в такт с Сашей, полностью сосредоточившись на ней."

# ch/harems/home/events/home_harem_halloween_event.rpy:812
translate russian nodate_halloween_dance_e6f4e811:
    mike.say "Эй, Минами, хочешь потанцевать?"

# ch/harems/home/events/home_harem_halloween_event.rpy:814
translate russian nodate_halloween_dance_00ad477e:
    "Стоит мне спросить, и лицо Минами озаряется улыбкой."

# ch/harems/home/events/home_harem_halloween_event.rpy:815
translate russian nodate_halloween_dance_94a1ae15:
    minami.say "Конечно, братик."

# ch/harems/home/events/home_harem_halloween_event.rpy:816
translate russian nodate_halloween_dance_4b9f0263:
    minami.say "Пойдём танцевать!"

# ch/harems/home/events/home_harem_halloween_event.rpy:820
translate russian nodate_halloween_dance_fac35f26:
    "Я позволяю Минами тащить меня за собой."

# ch/harems/home/events/home_harem_halloween_event.rpy:821
translate russian nodate_halloween_dance_c771752a:
    "Сначала она подпрыгивает как на пружинках."

# ch/harems/home/events/home_harem_halloween_event.rpy:822
translate russian nodate_halloween_dance_c2bea60f:
    "Но потом обнимает меня и крепко прижимается."

# ch/harems/home/events/home_harem_halloween_event.rpy:823
translate russian nodate_halloween_dance_68e2a9ad:
    "И теперь вся её энергия уходит на то, чтобы держаться за меня."

# ch/harems/home/events/home_harem_halloween_event.rpy:824
translate russian nodate_halloween_dance_e6823cd0:
    "Это совсем не похоже на медленные танцы из кино."

# ch/harems/home/events/home_harem_halloween_event.rpy:825
translate russian nodate_halloween_dance_dfbfcab4:
    "Вообще-то она немного напоминает мне восторженного щенка."

# ch/harems/home/events/home_harem_halloween_event.rpy:826
translate russian nodate_halloween_dance_3a6e8119:
    "Но весь её пыл направлен на танец со мной."

# ch/harems/home/events/home_harem_halloween_event.rpy:827
translate russian nodate_halloween_dance_f9421235:
    "Когда я кладу ладони ей на попку, Минами поднимает на меня глаза и улыбается."

# ch/harems/home/events/home_harem_halloween_event.rpy:828
translate russian nodate_halloween_dance_dc1cca72:
    minami.say "Видишь, братик?"

# ch/harems/home/events/home_harem_halloween_event.rpy:829
translate russian nodate_halloween_dance_5131e130:
    minami.say "Я же говорила, что будет весело!"

# ch/harems/home/events/home_harem_halloween_event.rpy:830
translate russian nodate_halloween_dance_72ad076d:
    "Минами обнимает меня за шею."

# ch/harems/home/events/home_harem_halloween_event.rpy:831
translate russian nodate_halloween_dance_2023dc7f:
    "А потом тянет вниз, так близко, что могла бы поцеловать."

# ch/harems/home/events/home_harem_halloween_event.rpy:832
translate russian nodate_halloween_dance_0de9b0ea:
    "На мгновение кажется, что она именно это и делает."

# ch/harems/home/events/home_harem_halloween_event.rpy:833
translate russian nodate_halloween_dance_de2d50f3:
    "Но на самом деле она просто смотрит мне в глаза."

# ch/harems/home/events/home_harem_halloween_event.rpy:834
translate russian nodate_halloween_dance_3d271d11:
    "Я почти чувствую, как её заразительная энергия передаётся мне."

# ch/harems/home/events/home_harem_halloween_event.rpy:835
translate russian nodate_halloween_dance_4d148acc:
    "Песня, должно быть, уже давно закончилась и сменилась следующей."

# ch/harems/home/events/home_harem_halloween_event.rpy:836
translate russian nodate_halloween_dance_06f2e858:
    "Но я даже не замечаю перемены."

# ch/harems/home/events/home_harem_halloween_event.rpy:837
translate russian nodate_halloween_dance_0835f2a3:
    "Всё это время я думаю только о Минами."

# ch/harems/home/events/home_harem_halloween_event.rpy:841
translate russian nodate_halloween_dance_861f0718:
    mike.say "А, Кексик..."

# ch/harems/home/events/home_harem_halloween_event.rpy:843
translate russian nodate_halloween_dance_af04b155:
    mike.say "А, Сэм..."

# ch/harems/home/events/home_harem_halloween_event.rpy:844
translate russian nodate_halloween_dance_0c4f3e14:
    mike.say "Хочешь потанцевать?"

# ch/harems/home/events/home_harem_halloween_event.rpy:846
translate russian nodate_halloween_dance_2d8aff8a:
    samantha.say "Что... а..."

# ch/harems/home/events/home_harem_halloween_event.rpy:848
translate russian nodate_halloween_dance_723fed6c:
    samantha.say "Прости, [lssb_common.hero_name()]."

# ch/harems/home/events/home_harem_halloween_event.rpy:849
translate russian nodate_halloween_dance_674e87ef:
    samantha.say "Я задумалась."

# ch/harems/home/events/home_harem_halloween_event.rpy:851
translate russian nodate_halloween_dance_e0e03935:
    samantha.say "Вспоминала, как жила здесь с Райаном."

# ch/harems/home/events/home_harem_halloween_event.rpy:852
translate russian nodate_halloween_dance_bae92238:
    "Едва произнеся имя Райана, Сэм вздрагивает."

# ch/harems/home/events/home_harem_halloween_event.rpy:853
translate russian nodate_halloween_dance_d0f7c8f5:
    "Будто пытается стряхнуть с себя воспоминания о прошлом."

# ch/harems/home/events/home_harem_halloween_event.rpy:855
translate russian nodate_halloween_dance_8821fe9b:
    samantha.say "Но к чёрту этого типа, правда?"

# ch/harems/home/events/home_harem_halloween_event.rpy:857
translate russian nodate_halloween_dance_bc4cea4e:
    samantha.say "Ты прав, надо потанцевать!"

# ch/harems/home/events/home_harem_halloween_event.rpy:861
translate russian nodate_halloween_dance_2ef0d4b0:
    "Сэм позволяет мне увести её танцевать."

# ch/harems/home/events/home_harem_halloween_event.rpy:862
translate russian nodate_halloween_dance_364cd0b3:
    "Начинает играть медленная песня."

# ch/harems/home/events/home_harem_halloween_event.rpy:863
translate russian nodate_halloween_dance_170d29b5:
    "И мы танцуем так же медленно."

# ch/harems/home/events/home_harem_halloween_event.rpy:864
translate russian nodate_halloween_dance_531ecf8b:
    "Медленно и очень близко друг к другу."

# ch/harems/home/events/home_harem_halloween_event.rpy:865
translate russian nodate_halloween_dance_4332f033:
    "Всё это время мы оба молчим."

# ch/harems/home/events/home_harem_halloween_event.rpy:866
translate russian nodate_halloween_dance_bba2b587:
    "От чего мне только легче."

# ch/harems/home/events/home_harem_halloween_event.rpy:867
translate russian nodate_halloween_dance_df80e064:
    "Ведь так я могу просто наслаждаться близостью Сэм."

# ch/harems/home/events/home_harem_halloween_event.rpy:868
translate russian nodate_halloween_dance_2f747afd:
    "В своём костюме она выглядит потрясающе, прекраснее, чем когда-либо."

# ch/harems/home/events/home_harem_halloween_event.rpy:869
translate russian nodate_halloween_dance_8895ebee:
    "Не понимаю, как Райан мог её упустить."

# ch/harems/home/events/home_harem_halloween_event.rpy:870
translate russian nodate_halloween_dance_97f8a2fa:
    "И в этот миг обещаю себе никогда не совершать такой ошибки."

# ch/harems/home/events/home_harem_halloween_event.rpy:871
translate russian nodate_halloween_dance_bea8611c:
    "Что бы ни случилось между мной и Сэм, она всегда будет частью моей жизни."

# ch/harems/home/events/home_harem_halloween_event.rpy:874
translate russian nodate_halloween_dance_28eea78e:
    mike.say "Лекси..."

# ch/harems/home/events/home_harem_halloween_event.rpy:875
translate russian nodate_halloween_dance_91c8aa7e_1:
    mike.say "Хочешь потанцевать со мной?"

# ch/harems/home/events/home_harem_halloween_event.rpy:877
translate russian nodate_halloween_dance_18a147a6:
    "Лицо Лекси озаряется улыбкой."

# ch/harems/home/events/home_harem_halloween_event.rpy:878
translate russian nodate_halloween_dance_05093892:
    lexi.say "Да, ещё как!"

# ch/harems/home/events/home_harem_halloween_event.rpy:879
translate russian nodate_halloween_dance_cfb9342c:
    lexi.say "Я уж думала, ты никогда не спросишь!"

# ch/harems/home/events/home_harem_halloween_event.rpy:880
translate russian nodate_halloween_dance_a5ca01c0:
    "Но она не успевает ответить."

# ch/harems/home/events/home_harem_halloween_event.rpy:881
translate russian nodate_halloween_dance_1a1a9c0b:
    "Я открываю рот, чтобы ответить."

# ch/harems/home/events/home_harem_halloween_event.rpy:882
translate russian nodate_halloween_dance_19c9dacb:
    "Но вместо слов вырывается вскрик: Лекси хватает меня за запястье."

# ch/harems/home/events/home_harem_halloween_event.rpy:886
translate russian nodate_halloween_dance_2a512cf1:
    "И без колебаний тащит танцевать."

# ch/harems/home/events/home_harem_halloween_event.rpy:887
translate russian nodate_halloween_dance_56783c50:
    lexi.say "О да."

# ch/harems/home/events/home_harem_halloween_event.rpy:888
translate russian nodate_halloween_dance_2054c048:
    lexi.say "Вот это я понимаю!"

# ch/harems/home/events/home_harem_halloween_event.rpy:889
translate russian nodate_halloween_dance_a0a6310f:
    "Конечно, медленного танца не будет."

# ch/harems/home/events/home_harem_halloween_event.rpy:890
translate russian nodate_halloween_dance_7db84c22:
    "Лекси даёт это понять с самого начала."

# ch/harems/home/events/home_harem_halloween_event.rpy:891
translate russian nodate_halloween_dance_3375ad6e:
    "Кажется, нет ни мгновения, когда бы она не тёрлась об меня!"

# ch/harems/home/events/home_harem_halloween_event.rpy:892
translate russian nodate_halloween_dance_18a54e0e:
    "Лекси всё время вращает бёдрами и трётся об меня, не сбавляя темпа."

# ch/harems/home/events/home_harem_halloween_event.rpy:893
translate russian nodate_halloween_dance_9f20f5f7:
    "Мне с трудом удаётся не покраснеть."

# ch/harems/home/events/home_harem_halloween_event.rpy:894
translate russian nodate_halloween_dance_fd9440a8:
    "Но это не значит, что я хочу, чтобы она остановилась."

# ch/harems/home/events/home_harem_halloween_event.rpy:895
translate russian nodate_halloween_dance_a703b0ce:
    "Я почти чувствую на нас взгляды остальных гостей."

# ch/harems/home/events/home_harem_halloween_event.rpy:896
translate russian nodate_halloween_dance_6828f17d:
    "Ведь Лекси танцует как стриптизёрша в мужском клубе."

# ch/harems/home/events/home_harem_halloween_event.rpy:897
translate russian nodate_halloween_dance_20e0939c:
    "К концу песни я вымотан и тяжело дышу."

# ch/harems/home/events/home_harem_halloween_event.rpy:898
translate russian nodate_halloween_dance_dda841cd:
    "А член в штанах твёрдый как камень."

# ch/harems/home/events/home_harem_halloween_event.rpy:899
translate russian nodate_halloween_dance_4273bf1a:
    "Сегодня мне будет сниться только Лекси!"
