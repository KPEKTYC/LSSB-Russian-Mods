    lexi.say "Зацените: из меня неплохая Джули, да?"

# ch/harems/home/events/home_harem_halloween_event.rpy:333
translate russian halloween_event_0b5a7933_1:
    mike.say "Ещё какая, Лекси."

# ch/harems/home/events/home_harem_halloween_event.rpy:334
translate russian halloween_event_19a18855_1:
    mike.say "Это что, настоящая бензопила?!?"

# ch/harems/home/events/home_harem_halloween_event.rpy:335
translate russian halloween_event_3cae00f8_1:
    minami.say "Эй!"

# ch/harems/home/events/home_harem_halloween_event.rpy:339
translate russian halloween_event_f503713b_1:
    minami.say "А как же я, братик?!?"

# ch/harems/home/events/home_harem_halloween_event.rpy:340
