# Native Halloween identifiers, current source catalog. Translation only.

# ch/harems/home/events/home_harem_halloween_event.rpy:141
translate russian halloween_invite_a6782c65:
    active_girl.say "Да, у меня уже есть планы."

# ch/harems/home/events/home_harem_halloween_event.rpy:143
translate russian halloween_invite_11667073:
    active_girl.say "Прости, [lssb_common.hero_name()], может, в следующем году?"

# ch/harems/home/events/home_harem_halloween_event.rpy:144
translate russian halloween_invite_07f13fbf:
    mike.say "Конечно..."

# ch/harems/home/events/home_harem_halloween_event.rpy:152
translate russian cancel_halloween_invite_a398daa9:
    mike.say "Насчёт вечеринки..."

# ch/harems/home/events/home_harem_halloween_event.rpy:153
translate russian cancel_halloween_invite_e66bf4b3:
    mike.say "Я приглашу другую..."

# ch/harems/home/events/home_harem_halloween_event.rpy:162
translate russian halloween_intro_cd887ee6:
    "Бывало у вас так: входишь в комнату, а тебя встречает тишина, которую иначе как многозначительной не назовёшь?"

# ch/harems/home/events/home_harem_halloween_event.rpy:163
translate russian halloween_intro_bfa3aab8:
    "Ну знаете: застаёшь людей за разговором, и стоит им увидеть тебя, как все мгновенно замолкают?"

# ch/harems/home/events/home_harem_halloween_event.rpy:168
translate russian halloween_intro_ef9b0dc0:
    "Именно это и происходит, когда я открываю дверь гостиной: [lssb_halloween.bree_name()] и Саша увлечённо что-то обсуждают."

# ch/harems/home/events/home_harem_halloween_event.rpy:175
translate russian halloween_intro_7a04cb39:
    "Долю секунды назад они сидели, наклонившись друг к другу, а теперь выпрямились и делают вид, будто ничего не происходит."

# ch/harems/home/events/home_harem_halloween_event.rpy:176
translate russian halloween_intro_cdd346f1:
    "Мне, честно говоря, больше хочется плюхнуться на диван и посмотреть что-нибудь незамысловатое, расслабляясь после дня, поэтому решаю подыграть."

# ch/harems/home/events/home_harem_halloween_event.rpy:177
translate russian halloween_intro_0ad68c00:
    "Не спрашивая, что за скандальная тема заставила их замолчать при одном моём виде, нахожу свободное место и начинаю искать пульт."

# ch/harems/home/events/home_harem_halloween_event.rpy:179
translate russian halloween_intro_f3d3a45d:
    "Чувствую их взгляды и даже наслаждаюсь тем, как мучаю их, не задавая вопрос, которого они так ждут."

# ch/harems/home/events/home_harem_halloween_event.rpy:180
translate russian halloween_intro_2b41bbd4:
    "Найдя какую-то жвачку для глаз, которую можно включить на телевизоре, невинно поглядываю на них."

# ch/harems/home/events/home_harem_halloween_event.rpy:183
translate russian halloween_intro_d9a068ad:
    "Саша явно раздражена моим невниманием, а [lssb_halloween.bree_name()] едва не лопается от сдерживаемого восторга."

# ch/harems/home/events/home_harem_halloween_event.rpy:184
translate russian halloween_intro_d09b8338:
    "Значит, прежде чем сдаться и их выслушать, стоит помучить ещё немного."

# ch/harems/home/events/home_harem_halloween_event.rpy:185
translate russian halloween_intro_a221bd28:
    mike.say "Эй, девушки..."

# ch/harems/home/events/home_harem_halloween_event.rpy:186
translate russian halloween_intro_c53140e6:
    "Я стараюсь говорить с любопытством, но растягиваю каждое слово, продлевая их муки."

# ch/harems/home/events/home_harem_halloween_event.rpy:193
translate russian halloween_intro_9c76d0f3:
    "Обе тут же выпрямляются и настораживаются, словно собаки Павлова при звуке звонка."

# ch/harems/home/events/home_harem_halloween_event.rpy:194
translate russian halloween_intro_2058ea3b:
    mike.say "Как... у вас обеих прошёл день на работе?"

# ch/harems/home/events/home_harem_halloween_event.rpy:195
translate russian halloween_intro_4207d1e5:
    "Они ловят каждое слово, пока я не сворачиваю в сторону, задав совершенно посторонний вопрос."

# ch/harems/home/events/home_harem_halloween_event.rpy:198
translate russian halloween_intro_a122b09d:
    "Глаза Саши расширяются. Клянусь, в её зрачках вспыхивает адское пламя."

# ch/harems/home/events/home_harem_halloween_event.rpy:199
translate russian halloween_intro_7364dda5:
    "А [lssb_halloween.bree_name()] просто издаёт высокий возмущённый писк, ясно давая понять: предел моего дозволенного нахальства достигнут."

# ch/harems/home/events/home_harem_halloween_event.rpy:200
translate russian halloween_intro_ca779497:
    mike.say "Ладно-ладно... Простите, правда!"

# ch/harems/home/events/home_harem_halloween_event.rpy:201
translate russian halloween_intro_1bc14b8f:
    mike.say "О чём вы говорили, когда я вошёл?"

# ch/harems/home/events/home_harem_halloween_event.rpy:204
translate russian halloween_intro_8ae23140:
    "Саша саркастически смотрит на меня и скрещивает руки на груди, словно собирается заставить меня потрудиться ради ответа."

# ch/harems/home/events/home_harem_halloween_event.rpy:205
translate russian halloween_intro_a36113f0:
    "Но [lssb_halloween.bree_name()] тут же разрушает её замысел: тянется за диван и достаёт довольно большую тыкву с вырезанной рожицей."

# ch/harems/home/events/home_harem_halloween_event.rpy:208
translate russian halloween_intro_b6056066:
    "Она поднимает её к лицу, и я с трудом понимаю, у кого из них улыбка шире."

# ch/harems/home/events/home_harem_halloween_event.rpy:209
translate russian halloween_intro_1bad77f3:
    bree.say "Мы планируем вечеринку на Хэллоуин! Будет просто потрясающе!"

# ch/harems/home/events/home_harem_halloween_event.rpy:210
translate russian halloween_intro_6fc9dbcb:
    sasha.say "Ага, всё так!"

# ch/harems/home/events/home_harem_halloween_event.rpy:211
translate russian halloween_intro_057f11ee:
    "Ну, это далеко не самое зловещее, что они могли обсуждать за моей спиной."

# ch/harems/home/events/home_harem_halloween_event.rpy:212
translate russian halloween_intro_b21ef1f9:
    mike.say "А, понятно... Но к чему такая секретность?"

# ch/harems/home/events/home_harem_halloween_event.rpy:214
translate russian halloween_intro_4f651938:
    mike.say "Почему сразу не сказали, когда я вошёл?"

# ch/harems/home/events/home_harem_halloween_event.rpy:215
translate russian halloween_intro_8cb9980d:
    sasha.say "Мы решили сначала получить твоё согласие, а потом уже строить конкретные планы."

# ch/harems/home/events/home_harem_halloween_event.rpy:216
translate russian halloween_intro_960da6af:
    bree.say "Ага, у нас ведь вроде демократия, и мы хотели услышать твой голос, [lssb_common.hero_name()]."

# ch/harems/home/events/home_harem_halloween_event.rpy:217
translate russian halloween_intro_6728fc45:
    "Не знаю, насчёт демократии здесь."

# ch/harems/home/events/home_harem_halloween_event.rpy:218
translate russian halloween_intro_6eb315fe:
    "По-моему, большую часть времени это скорее чистая анархия."

# ch/harems/home/events/home_harem_halloween_event.rpy:219
translate russian halloween_intro_0f80c321:
    "Но, наверное, стоит быть благодарным, что они решили спросить, а не устроить всё, не считаясь со мной."

# ch/harems/home/events/home_harem_halloween_event.rpy:222
translate russian halloween_intro_5d48ab85:
    mike.say "Спасибо, что предупредили, девушки. Очень заботливо с вашей стороны."

# ch/harems/home/events/home_harem_halloween_event.rpy:223
translate russian halloween_intro_a0f00da5:
    mike.say "Но Хэллоуин мне никогда особенно не нравился, понимаете?"

# ch/harems/home/events/home_harem_halloween_event.rpy:224
translate russian halloween_intro_3796f11d:
    mike.say "Что поделать — мне ближе «Семейка Брейди», чем «Семейка Аддамс»!"

# ch/harems/home/events/home_harem_halloween_event.rpy:227
translate russian halloween_intro_f1054fd4:
    "[lssb_halloween.bree_name()] тут же сникает: весь задор, с которым она делала объявление, сменяется разочарованием."

# ch/harems/home/events/home_harem_halloween_event.rpy:228
translate russian halloween_intro_4564db97:
    "Саша издаёт удручённое хмыканье, которое я понимаю так: я и зануда, и обломщик."

# ch/harems/home/events/home_harem_halloween_event.rpy:229
translate russian halloween_intro_9558143d:
    "Мне остаётся лишь беспомощно улыбнуться и пожать плечами. Неприятно их разочаровывать, но я пытаюсь утешиться тем, что хотя бы честен."

# ch/harems/home/events/home_harem_halloween_event.rpy:232
translate russian halloween_intro_bb4f8d88:
    mike.say "Как вы могли не знать, что Хэллоуин — мой любимый праздник?!?"

# ch/harems/home/events/home_harem_halloween_event.rpy:233
translate russian halloween_intro_5c421a23:
    mike.say "Конечно, я хочу устроить вечеринку!"

# ch/harems/home/events/home_harem_halloween_event.rpy:234
translate russian halloween_intro_0dc150b4:
    mike.say "И не просто вечеринку, а лучший Хэллоуин, какой мы только сможем организовать!"

# ch/harems/home/events/home_harem_halloween_event.rpy:236
translate russian halloween_intro_6f68c50f:
    "[lssb_halloween.bree_name()] от моего энтузиазма вскрикивает от восторга и хлопает в ладоши."

# ch/harems/home/events/home_harem_halloween_event.rpy:237
translate russian halloween_intro_8e104c1a:
    "Саша, как обычно, сдержаннее. Но по глазам видно, что моя объявленная любовь к этому празднику её как минимум заинтриговала."

# ch/harems/home/events/home_harem_halloween_event.rpy:238
translate russian halloween_intro_36058e89:
    "В конце концов, когда ещё её любимый стиль одежды будут считать почти нормальным?"

# ch/harems/home/events/home_harem_halloween_event.rpy:251
translate russian halloween_party_missed_758a16fb:
    "Чёрт, я пропустил вечеринку на Хэллоуин. Девушки рассердятся."

# ch/harems/home/events/home_harem_halloween_event.rpy:259
translate russian halloween_party_cancelled_5ee75363:
    "[lssb_halloween.bree_name()] и Саша не смогут быть на Хэллоуине."

# ch/harems/home/events/home_harem_halloween_event.rpy:261
translate russian halloween_party_cancelled_44f7a056:
    "[lssb_halloween.bree_name()] не сможет быть на Хэллоуине."

# ch/harems/home/events/home_harem_halloween_event.rpy:263
translate russian halloween_party_cancelled_b67f9429:
    "Саша не сможет быть на Хэллоуине."

# ch/harems/home/events/home_harem_halloween_event.rpy:264
translate russian halloween_party_cancelled_62fad47c:
    "Придётся отменить вечеринку."

# ch/harems/home/events/home_harem_halloween_event.rpy:275
translate russian halloween_event_47453329:
    "Все усердно трудились, чтобы успеть подготовиться к вечеринке."

# ch/harems/home/events/home_harem_halloween_event.rpy:276
translate russian halloween_event_6720a400:
    "Благодаря нашим стараниям дом теперь похож на съёмочную площадку фильма ужасов."

# ch/harems/home/events/home_harem_halloween_event.rpy:277
translate russian halloween_event_ac03b768:
    "Не поймите неправильно — в хорошем смысле!"

# ch/harems/home/events/home_harem_halloween_event.rpy:278
translate russian halloween_event_494fcabe:
    "Повсюду украшения и реквизит, создающие жутковатую, но весёлую атмосферу."

# ch/harems/home/events/home_harem_halloween_event.rpy:279
translate russian halloween_event_df91d21d:
    "Мы так увлеклись подготовкой, что на себя почти не осталось времени."

# ch/harems/home/events/home_harem_halloween_event.rpy:280
translate russian halloween_event_efa041ea:
    "В последний момент, перед самым приходом гостей, все разбегаются по комнатам."

# ch/harems/home/events/home_harem_halloween_event.rpy:281
translate russian halloween_event_c006802f:
    "Никто не говорил, в каком будет костюме, так что нас ждёт сюрприз."

# ch/harems/home/events/home_harem_halloween_event.rpy:282
translate russian halloween_event_654c2c60:
    "Втиснувшись в свой костюм, я спешу в коридор."

# ch/harems/home/events/home_harem_halloween_event.rpy:287
translate russian halloween_event_60d1be60:
    "И должен признать: открывшееся зрелище весьма впечатляет!"

# ch/harems/home/events/home_harem_halloween_event.rpy:288
translate russian halloween_event_7456db16:
    "Честно — вот бы у меня хватало глаз смотреть на всех сразу!"

# ch/harems/home/events/home_harem_halloween_event.rpy:289
translate russian halloween_event_ba7f7e02:
    mike.say "Ого..."

# ch/harems/home/events/home_harem_halloween_event.rpy:290
translate russian halloween_event_1446268f:
    mike.say "Просто... ого!"

# ch/harems/home/events/home_harem_halloween_event.rpy:292
translate russian halloween_event_28d63341:
    bree.say "Я знала, что ты узнаешь, [lssb_common.hero_name()]."

# ch/harems/home/events/home_harem_halloween_event.rpy:293
translate russian halloween_event_909372af:
    bree.say "Мы же, наверное, сутками играли в ту игру!"

# ch/harems/home/events/home_harem_halloween_event.rpy:295
translate russian halloween_event_23e4a46a:
    mike.say "Да, [lssb_halloween.bree_name()], разве можно забыть Синди?!?"

# ch/harems/home/events/home_harem_halloween_event.rpy:296
translate russian halloween_event_ea7b65e1:
    mike.say "А ты, Саша..."

# ch/harems/home/events/home_harem_halloween_event.rpy:297
translate russian halloween_event_57e29c79:
    mike.say "Тебе невероятно идут белые волосы!"

# ch/harems/home/events/home_harem_halloween_event.rpy:298
translate russian halloween_event_de450373:
    sasha.say "Всегда думала, что из меня получится отличная B2."

# ch/harems/home/events/home_harem_halloween_event.rpy:299
translate russian halloween_event_ab132bbe:
    sasha.say "А платье — просто вишенка на торте!"

# ch/harems/home/events/home_harem_halloween_event.rpy:301
translate russian halloween_event_b156c7da:
    lexi.say "Эй, не только вы тут разбираетесь в видеоиграх!"

# ch/harems/home/events/home_harem_halloween_event.rpy:303
translate russian halloween_event_85439ed8:
    lexi.say "Зацените: из меня неплохая Джули, да?"

# ch/harems/home/events/home_harem_halloween_event.rpy:304
translate russian halloween_event_0b5a7933:
    mike.say "Ещё какая, Лекси."

# ch/harems/home/events/home_harem_halloween_event.rpy:305
translate russian halloween_event_19a18855:
    mike.say "Это что, настоящая бензопила?!?"

# ch/harems/home/events/home_harem_halloween_event.rpy:306
translate russian halloween_event_3cae00f8:
    minami.say "Эй!"

# ch/harems/home/events/home_harem_halloween_event.rpy:310
translate russian halloween_event_f503713b:
    minami.say "А как же я, братик?!?"

# ch/harems/home/events/home_harem_halloween_event.rpy:311
translate russian halloween_event_ff4960ac:
    mike.say "Ого, Минами..."

# ch/harems/home/events/home_harem_halloween_event.rpy:312
translate russian halloween_event_945e631e:
    mike.say "Когда мы учились в школе, ты ничего такого не носила!"

# ch/harems/home/events/home_harem_halloween_event.rpy:313
translate russian halloween_event_3a3b98bb:
    samantha.say "Надеюсь, тебе нравится мой костюм, [lssb_common.hero_name()]."

# ch/harems/home/events/home_harem_halloween_event.rpy:317
translate russian halloween_event_305c1c49:
    samantha.say "Я не ожидала, что он окажется таким тесным!"

# ch/harems/home/events/home_harem_halloween_event.rpy:319
translate russian halloween_event_5a54034a:
    mike.say "Что ты, Кексик, ты потрясающе выглядишь."

# ch/harems/home/events/home_harem_halloween_event.rpy:321
translate russian halloween_event_030bb46d:
    mike.say "Что ты, Сэм, ты потрясающе выглядишь."

# ch/harems/home/events/home_harem_halloween_event.rpy:322
translate russian halloween_event_42052b7e:
    mike.say "Милашка-паучиха ещё никогда не выглядела лучше!"

# ch/harems/home/events/home_harem_halloween_event.rpy:330
translate russian halloween_event_b156c7da_1:
    lexi.say "Эй, не только вы тут разбираетесь в видеоиграх!"

# ch/harems/home/events/home_harem_halloween_event.rpy:332
