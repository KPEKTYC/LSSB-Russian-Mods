    mike.say "Когда мы учились в школе, ты ничего такого не носила!"

# ch/harems/home/events/home_harem_halloween_event.rpy:344
translate russian halloween_event_b156c7da_2:
    lexi.say "Эй, не только вы тут разбираетесь в видеоиграх!"

# ch/harems/home/events/home_harem_halloween_event.rpy:346
translate russian halloween_event_85439ed8_2:
