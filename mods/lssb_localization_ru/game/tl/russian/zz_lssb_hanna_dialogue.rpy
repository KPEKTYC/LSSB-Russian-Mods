# ch/hanna/events.rpy:5322
translate russian hanna_birthday_sex_dae97a4b:
    "Ханна замечает это раньше меня и ободряюще кивает."

# ch/hanna/events.rpy:5324
translate russian hanna_birthday_sex_eebd3074:
    hanna.say "Я ведь бываю здесь каждый день."

# ch/hanna/events.rpy:5325
translate russian hanna_birthday_sex_6934c058:
    hanna.say "На всех стенах зеркала."

# ch/hanna/events.rpy:5326
translate russian hanna_birthday_sex_7b2b46dc:
    hanna.say "Можно видеть каждое своё движение с любого ракурса."

# ch/hanna/events.rpy:5328
translate russian hanna_birthday_sex_00d32ea2:
    hanna.say "И мне всегда было интересно посмотреть, как я занимаюсь сексом!"

# ch/hanna/events.rpy:5329
translate russian hanna_birthday_sex_e607c3b3:
    "Рассказывая это, Ханна сидит верхом у меня на бёдрах."

# ch/hanna/events.rpy:5331
translate russian hanna_birthday_sex_2384f2e1:
    "И одновременно снимает остатки одежды."

# ch/hanna/events.rpy:5332
translate russian hanna_birthday_sex_376be8a7:
    "Глядя на неё снизу вверх, я теряю последние остатки сопротивления."

# ch/hanna/events.rpy:5333
translate russian hanna_birthday_sex_db130b62:
    "Остаётся лишь кивать и позволить ей делать что хочет."

# ch/hanna/events.rpy:5334
translate russian hanna_birthday_sex_095c2b28:
    "Вид отсюда потрясающий."

# ch/hanna/events.rpy:5335
translate russian hanna_birthday_sex_345b1057:
    "Даже без отражения на все триста шестьдесят градусов!"

# ch/hanna/events.rpy:5336
translate russian hanna_birthday_sex_bddaa6cd:
    "Она замечает, как действует на меня."

# ch/hanna/events.rpy:5337
translate russian hanna_birthday_sex_aaa36fda:
    "С улыбкой смотрит вниз."

# ch/hanna/events.rpy:5338
translate russian hanna_birthday_sex_4bed3723:
    "И для верности покачивает грудью из стороны в сторону."

# ch/hanna/events.rpy:5339
translate russian hanna_birthday_sex_6a6e3057:
    hanna.say "Нравится то, что видишь?"

# ch/hanna/events.rpy:5340
