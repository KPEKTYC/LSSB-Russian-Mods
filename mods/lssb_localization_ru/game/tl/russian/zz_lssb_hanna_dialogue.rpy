    hanna.say "Вставляй уже!"

# ch/hanna/events.rpy:3028
translate russian hanna_event_10_f543a85c:
    "Она говорит это, оглядываясь через плечо."

# ch/hanna/events.rpy:3029
translate russian hanna_event_10_fa7b3c16_1:
