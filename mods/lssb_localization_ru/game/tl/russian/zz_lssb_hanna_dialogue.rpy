# ch/hanna/events.rpy:4364
translate russian hanna_masturbate_258b2f50:
    "Ладонь трёт клитор, а она снова надолго вдыхает мой запах."

# ch/hanna/events.rpy:4365
translate russian hanna_masturbate_3d51226c:
    "Девушка" "В... вот так! Обожаю. Твой запах, твой вкус, а-а-ах!"

# ch/hanna/events.rpy:4366
translate russian hanna_masturbate_22c3cac6:
    "Она яростно двигает бёдрами навстречу ладони, жадно усиливая трение."

# ch/hanna/events.rpy:4367
translate russian hanna_masturbate_4802e18b:
    "Девушка" "Глубже... Боже, глубже. Заставь меня это заслужить."

# ch/hanna/events.rpy:4368
translate russian hanna_masturbate_68de4815:
    "Приподнимает задницу, вставая на носки, и вскрикивает."

# ch/hanna/events.rpy:4369
translate russian hanna_masturbate_85369c80:
    "Девушка" "Да, давай... сделаем это! Лучшая тренировка. Грубее, грубее!"

# ch/hanna/events.rpy:4370
translate russian hanna_masturbate_4ccd8493:
    "Девушка" "Сжигай калории, качай мышцы, чтобы в следующий раз трахать меня дольше!"

# ch/hanna/events.rpy:4371
translate russian hanna_masturbate_d8b2a0d8:
    "Девушка" "Ведь это наша цель? Сильнее, жёстче, дольше. Никаких оправданий."

# ch/hanna/events.rpy:4372
translate russian hanna_masturbate_24ff6d60:
    "Она извивается, кусая губу. Я не могу перестать смотреть."

# ch/hanna/events.rpy:4373
translate russian hanna_masturbate_820dacc6:
    "Ни капли стыда. Девушка занимается своим удовольствием, словно это самая тяжёлая и потная тренировка в её жизни."

# ch/hanna/events.rpy:4374
translate russian hanna_masturbate_12714887:
    "Очевидно, она считает меня каким-то богом фитнеса."

# ch/hanna/events.rpy:4375
translate russian hanna_masturbate_a463578a:
    "Глядя, как быстро она работает пальцами, я начинаю немного завидовать самому себе."

# ch/hanna/events.rpy:4376
translate russian hanna_masturbate_bd01a510:
    "Она отбрасывает мои брюки и вслепую шарит по полу, продолжая трахать себя рукой."

# ch/hanna/events.rpy:4377
translate russian hanna_masturbate_4d0a3d46:
    "Я приседаю, беру свои пропотевшие боксеры и подбрасываю поближе к ней."

# ch/hanna/events.rpy:4378
translate russian hanna_masturbate_e790dbcc:
    "Шарящие пальцы находят ткань, и она подносит её к лицу."

# ch/hanna/events.rpy:4379
translate russian hanna_masturbate_fe5db350:
    "Девушка" "О, блядь, да..."

# ch/hanna/events.rpy:4380
translate russian hanna_masturbate_d1fd805b:
    "Шипит она и прижимает к лицу ту часть, что была между ног."

# ch/hanna/events.rpy:4381
translate russian hanna_masturbate_5a707baa:
    "Девушка" "О-о, чёрт! Этот запах!"

# ch/hanna/events.rpy:4382
translate russian hanna_masturbate_37d1e665:
    "Пальцы ног поджимаются на плитке, каждое сухожилие на ногах резко выступает."

# ch/hanna/events.rpy:4383
translate russian hanna_masturbate_6cbd153c:
    "Она тихонько смеётся."

# ch/hanna/events.rpy:4384
translate russian hanna_masturbate_f43c0ddd:
    "Девушка" "Лучший запах на свете. Ну же, [lssb_hanna.hero_name()], трахни меня, как животное. Мы ведь животные."

# ch/hanna/events.rpy:4385
translate russian hanna_masturbate_fc878782:
    "Она не играет на публику. Думает, что одна. Просто такова её натура: она создана для этого и жаждет этого."

# ch/hanna/events.rpy:4386
translate russian hanna_masturbate_467c226b:
    "Девушка" "Для этого... для этого и нужны наши тела!"

# ch/hanna/events.rpy:4387
translate russian hanna_masturbate_0cae2f45:
    "Бёдра уже дрожат мелкой дрожью спортсмена на последнем усилии перед отказом мышц."

# ch/hanna/events.rpy:4388
translate russian hanna_masturbate_5fb6f558:
    "Девушка" "Почти... почти, [lssb_hanna.hero_name()]. Только не останавливайся!"

# ch/hanna/events.rpy:4390
translate russian hanna_masturbate_84242a54:
    "Девушка" "Да... да, вот так, именно там, [lssb_hanna.hero_name()]!"

# ch/hanna/events.rpy:4391
translate russian hanna_masturbate_2c7622a5:
    "Она неистово двигает бёдрами в такт пальцам, всё громче хватая воздух."

# ch/hanna/events.rpy:4392
translate russian hanna_masturbate_61cec03a:
    "Тело застывает, спина выгибается над скамейкой. Она переживает волну оргазма, всё ещё прижимая мои боксеры к лицу."

# ch/hanna/events.rpy:4394
translate russian hanna_masturbate_810b5c8c:
    "Я на цыпочках отступаю, не упуская из виду её движения, и вскоре возвращаюсь в душевую кабинку."

# ch/hanna/events.rpy:4395
translate russian hanna_masturbate_e86e158f:
    "С громким стуком перекрываю воду. В затихшей комнате остаётся лишь звук падающих капель."

# ch/hanna/events.rpy:4396
translate russian hanna_masturbate_7b94163f:
    "Она прикусывает палец, подавляя тихие всхлипы."

# ch/hanna/events.rpy:4397
translate russian hanna_masturbate_8ebb10b4:
    "Потом быстро садится и натягивает одежду. Погодите... она до этого была без белья?!"

# ch/hanna/events.rpy:4398
translate russian hanna_masturbate_dbfc87d1:
    "Не успеваю осмыслить это, как дверь уже захлопывается, оставляя меня одного."

# ch/hanna/events.rpy:4399
translate russian hanna_masturbate_5893a73a:
    "Вернувшись к скамейке, я присвистываю: будто здесь никого и не было."

# ch/hanna/events.rpy:4400
translate russian hanna_masturbate_505ee673:
    "Вся одежда снова в моём шкафчике, где я её оставил."

# ch/hanna/events.rpy:4401
translate russian hanna_masturbate_d7bab9b3:
    "Изменилось лишь одно: пятно на скамейке."

# ch/hanna/events.rpy:4402
translate russian hanna_masturbate_64259665:
    "А я-то думал, что такая девушка мне не по зубам."

# ch/hanna/events.rpy:4403
translate russian hanna_masturbate_6f774a8a:
    "Теперь, похоже, это ОНА мной восхищается."

# ch/hanna/events.rpy:4404
translate russian hanna_masturbate_a20cefa7:
    "..."

# ch/hanna/events.rpy:4405
translate russian hanna_masturbate_a20cefa7_1:
    "..."

# ch/hanna/events.rpy:4406
translate russian hanna_masturbate_91a6eeb9:
    "Но как, чёрт возьми, её зовут? И как мне ТЕПЕРЬ представиться?!"

# ch/hanna/events.rpy:4414
translate russian hanna_preg_talk_e44d4152:
    hanna.say "Эй... эй, [lssb_hanna.hero_name()]... привет!"

# ch/hanna/events.rpy:4416
translate russian hanna_preg_talk_1189e2ab:
    "Я резко оборачиваюсь и вижу Ханну: явно на пробежке и направляется прямо ко мне."

# ch/hanna/events.rpy:4420
translate russian hanna_preg_talk_03dcec95:
    "Никогда не был фанатом «Спасателей Малибу», но она всё равно словно бежит в замедленной съёмке."

# ch/hanna/events.rpy:4421
translate russian hanna_preg_talk_833fbc61:
    "Шорты открывают стройные ноги, грудь покачивается в такт движениям, а волосы подпрыгивают вокруг лица, словно золотой ореол."

# ch/hanna/events.rpy:4422
translate russian hanna_preg_talk_c9584c8a:
    "Звучит так, будто я перечисляю достоинства богини?"

# ch/hanna/events.rpy:4423
translate russian hanna_preg_talk_617e06b6:
    "Ну и что с того?"

# ch/hanna/events.rpy:4424
translate russian hanna_preg_talk_2e818393:
    "Она потрясающе выглядит. Точка."

# ch/hanna/events.rpy:4428
translate russian hanna_preg_talk_30883816:
    mike.say "О, привет, Ханна."

# ch/hanna/events.rpy:4430
translate russian hanna_preg_talk_43f28700:
    "Она останавливается передо мной, наклоняется, уперев руки в бёдра, и переводит дыхание."

# ch/hanna/events.rpy:4431
translate russian hanna_preg_talk_175249b9:
    "Какое же мучение — смотреть, как при этом натягиваются её обтягивающие шорты!"

# ch/hanna/events.rpy:4433
translate russian hanna_preg_talk_0caa2da5:
    "Она выпрямляется и ещё немного тянется. Так близко, что я чувствую тепло и запах пота от её тела."

# ch/hanna/events.rpy:4434
translate russian hanna_preg_talk_a5f5a979:
    "Странно: обычно чужой пот меня отталкивает."

# ch/hanna/events.rpy:4435
translate russian hanna_preg_talk_7a52d6e4:
    "Но с ней это почему-то сексуально. Будто она выделяет феромоны."

# ch/hanna/events.rpy:4437
translate russian hanna_preg_talk_578754c4:
    hanna.say "Я уже несколько месяцев почти каждый день здесь пробегаю."

# ch/hanna/events.rpy:4438
translate russian hanna_preg_talk_98c83651:
    hanna.say "Как мы раньше ни разу не встретились?"

# ch/hanna/events.rpy:4440
translate russian hanna_preg_talk_ac5092fe:
    mike.say "Ну... вон там моё здание."

# ch/hanna/events.rpy:4441
translate russian hanna_preg_talk_266663f0:
    mike.say "Обычно столько дел, что обедаю прямо за столом."

# ch/hanna/events.rpy:4443
translate russian hanna_preg_talk_87bd7456:
    "Она недоверчиво качает головой. Во взгляде читается: ни один здравомыслящий человек не позволит приковать себя к столу на весь день."

# ch/hanna/events.rpy:4445
translate russian hanna_preg_talk_ef300c33:
    hanna.say "А сегодня сумел сбежать?"

# ch/hanna/events.rpy:4447
translate russian hanna_preg_talk_8c314875:
    mike.say "Да, можно и так сказать."

# ch/hanna/events.rpy:4448
translate russian hanna_preg_talk_a3ed7828:
    mike.say "И встретил тебя. Пожалуй, это судьба!"

# ch/hanna/events.rpy:4450
translate russian hanna_preg_talk_6278192e:
    "По изменившемуся выражению её лица понимаю: шутка совсем не удалась."

# ch/hanna/events.rpy:4451
translate russian hanna_preg_talk_4b435ebc:
    "Но хоть убей не понимаю почему."

# ch/hanna/events.rpy:4452
translate russian hanna_preg_talk_024b984a:
    hanna.say "Ну... возможно, чуть позже ты ещё подумаешь, веришь ли в это."

# ch/hanna/events.rpy:4454
translate russian hanna_preg_talk_4b7fe16d:
    mike.say "Что... почему, Ханна?"

# ch/hanna/events.rpy:4456
translate russian hanna_preg_talk_ba2fc19c:
    hanna.say "Я уже некоторое время хочу тебе кое-что сказать."

# ch/hanna/events.rpy:4457
translate russian hanna_preg_talk_e7c8d0cb:
    "О чёрт, началось."

# ch/hanna/events.rpy:4459
translate russian hanna_preg_talk_21f66cdd:
    hanna.say "Пыталась выбрать подходящие время и место, но ничего не придумала."

# ch/hanna/events.rpy:4460
translate russian hanna_preg_talk_220890d0:
    hanna.say "Раз судьба случайно свела нас, здесь и сейчас ничем не хуже любого другого момента."

# ch/hanna/events.rpy:4462
translate russian hanna_preg_talk_fb5c0f6c:
    mike.say "Ханна, ты меня пугаешь. Хочешь сказать, что мы расстаёмся?"

# ch/hanna/events.rpy:4464
translate russian hanna_preg_talk_852595fc:
    hanna.say "[lssb_hanna.hero_name()], нет... боже, нет! Не это!"

# ch/hanna/events.rpy:4466
translate russian hanna_preg_talk_c4ca035c:
    hanna.say "Но почти так же серьёзно, наверное."

# ch/hanna/events.rpy:4467
translate russian hanna_preg_talk_9f7a2beb:
    mike.say "Ох, чёрт... просто скажи, пожалуйста."

# ch/hanna/events.rpy:4469
translate russian hanna_preg_talk_83ba0468:
    "Она ненадолго оглядывается, будто собираясь с духом."

# ch/hanna/events.rpy:4471
translate russian hanna_preg_talk_f2a08932:
    hanna.say "Ну, [lssb_hanna.hero_name()]... вот: я беременна."

# ch/hanna/events.rpy:4476
translate russian hanna_preg_talk_e9bf757c:
    "Словно кто-то подкрался и ударил меня кувалдой в живот."

# ch/hanna/events.rpy:4478
translate russian hanna_preg_talk_fa7589e8:
    mike.say "Ты... уверена?"

# ch/hanna/events.rpy:4480
translate russian hanna_preg_talk_877dac75:
    hanna.say "Насколько возможно. Пару дней назад сделала тест — положительный."

# ch/hanna/events.rpy:4481
translate russian hanna_preg_talk_d5dbd589:
    hanna.say "Поэтому я в последнее время и пропадала."

# ch/hanna/events.rpy:4482
translate russian hanna_preg_talk_76b33408:
    hanna.say "Нужно было самой осмыслить, прежде чем сказать тебе."

# ch/hanna/events.rpy:4483
translate russian hanna_preg_talk_3f0ccfa4:
    hanna.say "Так что будем делать?"

# ch/hanna/events.rpy:4488
translate russian hanna_preg_talk_6a1a1b14:
    "Часть меня злится: Ханна долго собиралась с мыслями, а потом вывалила всё на меня прямо на улице, без предупреждения."

# ch/hanna/events.rpy:4489
translate russian hanna_preg_talk_de902cb8:
    "Но дело действительно серьёзное. Злость и обиды в итоге ничего не облегчат."

# ch/hanna/events.rpy:4494
translate russian hanna_preg_talk_a95999d3:
    mike.say "Господи, Ханна, я к этому не готов!"

# ch/hanna/events.rpy:4496
translate russian hanna_preg_talk_7db140f4:
    hanna.say "Я понимаю, что огорошила тебя. Новость серьёзная."

# ch/hanna/events.rpy:4497
translate russian hanna_preg_talk_ced8cb38:
    hanna.say "Если нужно подумать, может, встретимся вечером?"

# ch/hanna/events.rpy:4499
translate russian hanna_preg_talk_54c04ad2:
    mike.say "Нет, Ханна, ты не понимаешь."

# ch/hanna/events.rpy:4500
translate russian hanna_preg_talk_b4548517:
    mike.say "Я не готов стать отцом. Совершенно!"

# ch/hanna/events.rpy:4502
translate russian hanna_preg_talk_a239a81a:
    hanna.say "Но..."

# ch/hanna/events.rpy:4504
translate russian hanna_preg_talk_fcafa621:
    mike.say "И ты, по-моему, тоже не готова."

# ch/hanna/events.rpy:4506
translate russian hanna_preg_talk_65512cb1:
    "Она сразу выглядит раздавленной, отчаянно пытаясь придумать возражение."

# ch/hanna/events.rpy:4507
translate russian hanna_preg_talk_7c7dd3c4:
    mike.say "И я не только о чувствах."

# ch/hanna/events.rpy:4508
translate russian hanna_preg_talk_47c46c33:
    mike.say "На работе я на таком взводе, что вот-вот сорвусь. А дома всё ещё сдаю комнаты, чтобы свести концы с концами."

# ch/hanna/events.rpy:4509
translate russian hanna_preg_talk_fe825999:
    mike.say "Да, твой отец владеет спортзалом. Но мы ведь оба не хотим садиться ему на шею?"

# ch/hanna/events.rpy:4511
translate russian hanna_preg_talk_25d05091:
    mike.say "И теперь ты живёшь на зарплату инструктора, а отец лишь начал приходить в себя."

# ch/hanna/events.rpy:4513
translate russian hanna_preg_talk_fe825999_1:
    mike.say "Да, твой отец владеет спортзалом. Но мы ведь оба не хотим садиться ему на шею?"

# ch/hanna/events.rpy:4515
translate russian hanna_preg_talk_32c314f8:
    hanna.say "То есть ты думаешь, нам... нам нужно..."

# ch/hanna/events.rpy:4517
translate russian hanna_preg_talk_5137f72b:
    "Она не может даже произнести это слово, и мне приходится сделать это за неё."

# ch/hanna/events.rpy:4518
translate russian hanna_preg_talk_91686abb:
    mike.say "Аборт, Ханна. Да, думаю, нужно прервать беременность."

# ch/hanna/events.rpy:4521
translate russian hanna_preg_talk_b7f02946:
    "Из её огромных голубых глаз текут искренние, горькие слёзы."

# ch/hanna/events.rpy:4526
translate russian hanna_preg_talk_080ec15a:
    "Я обнимаю её прямо посреди улицы."

# ch/hanna/events.rpy:4527
translate russian hanna_preg_talk_540ad9a5:
    "Произнести это было тяжело, но в нынешних обстоятельствах я действительно считаю такой выход лучшим для нас обоих."

# ch/hanna/events.rpy:4533
translate russian hanna_preg_talk_fd9c13a0:
    mike.say "Ханна, нужно было сказать сразу, как только узнала!"

# ch/hanna/events.rpy:4535
translate russian hanna_preg_talk_552e4eb9:
    hanna.say "О боже, [lssb_hanna.hero_name()], ты ведь на меня не злишься?"

# ch/hanna/events.rpy:4537
translate russian hanna_preg_talk_4cf775c5:
    mike.say "Что?"

# ch/hanna/events.rpy:4538
translate russian hanna_preg_talk_2c187b07:
    mike.say "Нет, Ханна... я... я... наоборот... понимаешь?"

# ch/hanna/events.rpy:4540
translate russian hanna_preg_talk_4bc2e1c9:
    hanna.say "Рад?"

# ch/hanna/events.rpy:4542
translate russian hanna_preg_talk_aaa1fff7:
    mike.say "Да, Ханна! Я очень, очень рад!"

# ch/hanna/events.rpy:4544
translate russian hanna_preg_talk_a2dfdf9c:
    "Сама она выглядит скорее ошеломлённой, чем счастливой."

# ch/hanna/events.rpy:4546
translate russian hanna_preg_talk_f3b1f33f:
    hanna.say "Боже, я думала, ты разозлишься... или скажешь избавиться от него!"

# ch/hanna/events.rpy:4548
translate russian hanna_preg_talk_7909161b:
    mike.say "Нет... с чего бы?"

# ch/hanna/events.rpy:4550
translate russian hanna_preg_talk_2fd1ab95:
    hanna.say "Поэтому я так долго не говорила."

# ch/hanna/events.rpy:4551
translate russian hanna_preg_talk_015492de:
    hanna.say "Сначала боялась, что ты не захочешь ребёнка. Или больше не захочешь быть со мной."

# ch/hanna/events.rpy:4552
translate russian hanna_preg_talk_08d7f687:
    hanna.say "Потом думала, как тебя выматывает работа, а у меня ведь не лучше..."

# ch/hanna/events.rpy:4554
translate russian hanna_preg_talk_5badda46:
    mike.say "К чёрту работу, Ханна! Я хоть туалеты драить готов, лишь бы быть с тобой... и нашим ребёнком!"

# ch/hanna/events.rpy:4555
translate russian hanna_preg_talk_e22d037c:
    mike.say "Это всё мелочи. Что-нибудь придумаем, как люди придумывали с самого, чёрт возьми, начала времён!"

# ch/hanna/events.rpy:4561
translate russian hanna_preg_talk_9b8e6f3c:
    "Ханна обнимает меня так крепко, что едва не выдавливает воздух из лёгких."

# ch/hanna/events.rpy:4563
translate russian hanna_preg_talk_572e7e79:
    "Она плачет, но уверен: это слёзы облегчения и, надеюсь, счастья."

# ch/hanna/events.rpy:4569
translate russian hanna_preg_talk_a481682a:
    "Наконец приходится прервать объятия и вернуться в офис."

# ch/hanna/events.rpy:4571
translate russian hanna_preg_talk_f9f610bd:
    "Выглядит она растрёпанной, щёки ещё мокрые от слёз."

# ch/hanna/events.rpy:4573
translate russian hanna_preg_talk_efde1a38:
    "Но уверяет, что всё хорошо. Договариваемся встретиться вечером и поговорить дальше."

# ch/hanna/events.rpy:4575
translate russian hanna_preg_talk_f1c5368e:
    "Как бы тяжело ни работалось утром, после обеда будет ещё труднее: такие новости теперь не выйдут из головы."

# ch/hanna/events.rpy:4583
translate russian hanna_birthday_date_male_27590974:
    "Входя в холл спортзала и оглядываясь, я почти уверен, что пришёл вовремя."

# ch/hanna/events.rpy:4584
translate russian hanna_birthday_date_male_5094e138:
    "Смотрю на часы: всё верно, именно на это время и договаривались."

# ch/hanna/events.rpy:4585
translate russian hanna_birthday_date_male_390cd206:
    "Так где, чёрт возьми, Ханна?"

# ch/hanna/events.rpy:4586
translate russian hanna_birthday_date_male_adbbd6df:
    "И почему заставляет меня ждать в собственный день рождения?"

# ch/hanna/events.rpy:4587
translate russian hanna_birthday_date_male_d9838694:
    "Я продолжаю искать её взглядом и проверяю сообщения."

# ch/hanna/events.rpy:4588
translate russian hanna_birthday_date_male_68ba6934:
    "Но ни самой Ханны, ни объяснения задержки."

# ch/hanna/events.rpy:4589
translate russian hanna_birthday_date_male_6fdf881c:
    "Раздражённо вздохнув, прохожу дальше в зал."

# ch/hanna/events.rpy:4592
translate russian hanna_birthday_date_male_0fb6f709:
    "И тут слышу голос, похожий на её."

# ch/hanna/events.rpy:4593
translate russian hanna_birthday_date_male_ff4df8dd:
    "Спешу на звук, надеясь её найти."

# ch/hanna/events.rpy:4595
translate russian hanna_birthday_date_male_fb96292b:
    hanna.say "Раз, два, три..."

# ch/hanna/events.rpy:4596
translate russian hanna_birthday_date_male_a4c1ba7c:
    hanna.say "Вот так."

# ch/hanna/events.rpy:4598
translate russian hanna_birthday_date_male_97c36f7d:
    hanna.say "Ну же, парни и девушки! Я знаю, вы можете!"

# ch/hanna/events.rpy:4600
translate russian hanna_birthday_date_male_1c2e368f:
    "Вот она."

# ch/hanna/events.rpy:4601
translate russian hanna_birthday_date_male_fa06cc7c:
    "И к свиданию совсем не готова."

# ch/hanna/events.rpy:4602
translate russian hanna_birthday_date_male_646f05ae:
    "Вместо этого ведёт занятие по аэробике!"

# ch/hanna/events.rpy:4605
translate russian hanna_birthday_date_male_95c4f40b:
    "Ханна замечает меня и встречается со мной взглядом."

# ch/hanna/events.rpy:4607
translate russian hanna_birthday_date_male_89c3ee56:
    "Но стоит ей улыбнуться, как я начинаю забывать, почему злился."

# ch/hanna/events.rpy:4609
translate russian hanna_birthday_date_male_24b68b91:
    "И просто не могу отвести от неё глаз."

# ch/hanna/events.rpy:4610
translate russian hanna_birthday_date_male_7c2e2e01:
    "Подумаешь, бронь в ресторане."

# ch/hanna/events.rpy:4611
translate russian hanna_birthday_date_male_9e6bc9e9:
    "Особенно когда можно смотреть, как твоя девушка потеет в обтягивающей форме!"

# ch/hanna/events.rpy:4612
translate russian hanna_birthday_date_male_075f4121:
    "Наверное, улыбаюсь как болван, потому что Ханна прямо сияет в ответ."

# ch/hanna/events.rpy:4614
translate russian hanna_birthday_date_male_1d7d07e9:
    "Когда занятие наконец заканчивается, она подходит ко мне."

# ch/hanna/events.rpy:4616
translate russian hanna_birthday_date_male_41e403d2:
    hanna.say "Ладно, ладно..."

# ch/hanna/events.rpy:4617
translate russian hanna_birthday_date_male_4a48f5fb:
    hanna.say "Знаю, мне следовало уже быть готовой, [lssb_hanna.hero_name()]."

# ch/hanna/events.rpy:4619
translate russian hanna_birthday_date_male_c1dc3439:
    hanna.say "Но кое-кто заболел, пришлось подменить."

# ch/hanna/events.rpy:4621
translate russian hanna_birthday_date_male_699c3740:
    hanna.say "Я бы позвонила заранее."

# ch/hanna/events.rpy:4622
translate russian hanna_birthday_date_male_fa8a0d56:
    hanna.say "Только всё случилось в последний момент."

# ch/hanna/events.rpy:4623
translate russian hanna_birthday_date_male_558680cf:
    mike.say "Не переживай, Ханна."

# ch/hanna/events.rpy:4624
translate russian hanna_birthday_date_male_fec3dd50:
    mike.say "Позвоню в ресторан и попробую что-нибудь придумать."

# ch/hanna/events.rpy:4625
translate russian hanna_birthday_date_male_ec459312:
    mike.say "Может, перенесут бронь попозже."

# ch/hanna/events.rpy:4626
translate russian hanna_birthday_date_male_da67f52f:
    mike.say "А если нет... ну, пойдём в другое место."

# ch/hanna/events.rpy:4632
translate russian hanna_birthday_date_male_4fe17f47:
    "Она улыбается и кивает."

# ch/hanna/events.rpy:4634
translate russian hanna_birthday_date_male_33477c42:
    hanna.say "Ладно, пойду переоденусь."

# ch/hanna/events.rpy:4638
translate russian hanna_birthday_date_male_d36964e3:
    hanna.say "Постараюсь побыстрее."

# ch/hanna/events.rpy:4640
translate russian hanna_birthday_date_male_cddaff92:
    "Она спешит прочь, а я достаю телефон."

# ch/hanna/events.rpy:4641
translate russian hanna_birthday_date_male_f4f5cf33:
    "Да, всё идёт не совсем по плану."

# ch/hanna/events.rpy:4642
translate russian hanna_birthday_date_male_b6856a6e:
    "Но уверен, мы ещё всё наладим."

# ch/hanna/events.rpy:4644
translate russian hanna_birthday_date_male_95c4f40b_1:
    "Ханна замечает меня и встречается со мной взглядом."

# ch/hanna/events.rpy:4646
translate russian hanna_birthday_date_male_2e960cdc:
    "Но её улыбка действует на меня как красная тряпка на быка."

# ch/hanna/events.rpy:4647
translate russian hanna_birthday_date_male_3eddd06f:
    "Я хмурюсь так выразительно, как только могу с другого конца зала."

# ch/hanna/events.rpy:4648
translate russian hanna_birthday_date_male_f056ddf9:
    "И показываю на запястье, давая понять, что дело во времени."

# ch/hanna/events.rpy:4650
translate russian hanna_birthday_date_male_f76843d6:
    "Она замечает раздражение и выглядит неловко."

# ch/hanna/events.rpy:4651
translate russian hanna_birthday_date_male_64392ee0:
    "Но ради меня занятие не прекращает."

# ch/hanna/events.rpy:4653
translate russian hanna_birthday_date_male_415dc90e:
    "Просто отворачивается и продолжает."

# ch/hanna/events.rpy:4655
translate russian hanna_birthday_date_male_1d7d07e9_1:
    "Когда занятие наконец заканчивается, она подходит ко мне."

# ch/hanna/events.rpy:4657
translate russian hanna_birthday_date_male_6a6b8331:
    hanna.say "Что случилось, [lssb_hanna.hero_name()]?"

# ch/hanna/events.rpy:4658
translate russian hanna_birthday_date_male_8d7e6b48:
    hanna.say "Ты прямо взбешён!"

# ch/hanna/events.rpy:4659
translate russian hanna_birthday_date_male_375e8bc9:
    mike.say "Конечно, взбешён, Ханна."

# ch/hanna/events.rpy:4660
translate russian hanna_birthday_date_male_40c81dc7:
    mike.say "Мы уже опаздываем к назначенному времени!"

# ch/hanna/events.rpy:4663
translate russian hanna_birthday_date_male_7d05d594:
    hanna.say "Уф..."

# ch/hanna/events.rpy:4666
translate russian hanna_birthday_date_male_84bb0f6d:
    hanna.say "Слушай, прости, ладно?"

# ch/hanna/events.rpy:4667
translate russian hanna_birthday_date_male_2ce337c5:
    hanna.say "Кое-кто заболел, пришлось подменить."

# ch/hanna/events.rpy:4669
translate russian hanna_birthday_date_male_fe9ad6e6:
    hanna.say "Знаю, нужно было позвонить заранее."

# ch/hanna/events.rpy:4671
translate russian hanna_birthday_date_male_fa8a0d56_1:
    hanna.say "Только всё случилось в последний момент."

# ch/hanna/events.rpy:4672
translate russian hanna_birthday_date_male_57557190:
    mike.say "Ладно, Ханна, просто иди переодевайся."

# ch/hanna/events.rpy:4673
translate russian hanna_birthday_date_male_eb21051b:
    mike.say "Может, удастся перенести бронь..."

# ch/hanna/events.rpy:4676
translate russian hanna_birthday_date_male_134b1958:
    "Она недовольна, но всё же уходит, как я и попросил."

# ch/hanna/events.rpy:4678
translate russian hanna_birthday_date_male_f804ff8e:
    "Как бы то ни было, свидание началось паршиво."

# ch/hanna/events.rpy:4682
translate russian hanna_birthday_date_male_2fcf8f21:
    "Ханна приняла душ, переоделась и готова к свиданию. Пора уходить."

# ch/hanna/events.rpy:4686
translate russian hanna_birthday_date_male_fef663e6:
    "К счастью, до ночного клуба, где я заказал столик, недалеко."

# ch/hanna/events.rpy:4687
translate russian hanna_birthday_date_male_a77fab6b:
    "Но я совсем не ожидал такой огромной очереди в столь ранний час."

# ch/hanna/events.rpy:4689
translate russian hanna_birthday_date_male_f1e0b81f:
    "Ханна смотрит на неё и раздражённо фыркает."

# ch/hanna/events.rpy:4692
translate russian hanna_birthday_date_male_7d05d594_1:
    hanna.say "Уф..."

# ch/hanna/events.rpy:4693
translate russian hanna_birthday_date_male_8405ce46:
    hanna.say "Я спешила с работы, чтобы постоять в очереди?"

# ch/hanna/events.rpy:4696
translate russian hanna_birthday_date_male_7a4a323a:
    hanna.say "Знаешь, [lssb_hanna.hero_name()]..."

# ch/hanna/events.rpy:4698
translate russian hanna_birthday_date_male_efeb6606:
    hanna.say "Не так я представляла свой день рождения!"

# ch/hanna/events.rpy:4699
translate russian hanna_birthday_date_male_ab0c6598:
    "Стараюсь не поддаваться её недовольству."

# ch/hanna/events.rpy:4700
translate russian hanna_birthday_date_male_c44321a0:
    "Вместо этого улыбаюсь и качаю головой."

# ch/hanna/events.rpy:4701
translate russian hanna_birthday_date_male_4c5534b4:
    mike.say "Мы не будем стоять в очереди, Ханна."

# ch/hanna/events.rpy:4702
translate russian hanna_birthday_date_male_de8c2607:
    mike.say "Я заказал столик, помнишь?"

# ch/hanna/events.rpy:4704
translate russian hanna_birthday_date_male_ec38b296:
    "Беру её за руку и направляюсь к началу очереди."

# ch/hanna/events.rpy:4705
translate russian hanna_birthday_date_male_4fafbd62:
    "Вслед летят сердитые взгляды и приглушённые замечания."

# ch/hanna/events.rpy:4706
translate russian hanna_birthday_date_male_1e755ec7:
    "Стараюсь не обращать внимания и привлекаю охранников у входа."

# ch/hanna/events.rpy:4708
translate russian hanna_birthday_date_male_0edfa280:
    "Вышибала" "Чем могу помочь, сэр?"

# ch/hanna/events.rpy:4709
translate russian hanna_birthday_date_male_700f54ac:
    mike.say "Да..."

# ch/hanna/events.rpy:4710
translate russian hanna_birthday_date_male_4e5c692b:
    mike.say "У нас бронь."

# ch/hanna/events.rpy:4711
translate russian hanna_birthday_date_male_7550674b:
    mike.say "А значит, можно без очереди."

# ch/hanna/events.rpy:4712
translate russian hanna_birthday_date_male_8ee4880d:
    mike.say "На фамилию [hero.family_name]."

# ch/hanna/events.rpy:4713
translate russian hanna_birthday_date_male_adf22e2b:
    "Охранник заглядывает в список гостей."

# ch/hanna/events.rpy:4714
translate russian hanna_birthday_date_male_9915e66b:
    "Но, к моему огорчению, качает головой."

# ch/hanna/events.rpy:4715
translate russian hanna_birthday_date_male_98b68daa:
    "Вышибала" "Нет..."

# ch/hanna/events.rpy:4716
translate russian hanna_birthday_date_male_a39e1d41:
    "Вышибала" "Такой записи не вижу."

# ch/hanna/events.rpy:4718
translate russian hanna_birthday_date_male_6d2d7574:
    "Ханна бросает на меня умоляющий взгляд."

# ch/hanna/events.rpy:4719
translate russian hanna_birthday_date_male_9493a8da:
    "Словно просит поскорее решить проблему."

# ch/hanna/events.rpy:4720
translate russian hanna_birthday_date_male_97576da4:
    "Глубоко вдыхаю и стараюсь улыбнуться как можно обаятельнее."

# ch/hanna/events.rpy:4722
translate russian hanna_birthday_date_male_c4e57862:
    mike.say "Правда?"

# ch/hanna/events.rpy:4723
translate russian hanna_birthday_date_male_20a9b0b4:
    mike.say "Вот не повезло нам, приятель!"

# ch/hanna/events.rpy:4724
translate russian hanna_birthday_date_male_e01205c7:
    mike.say "У моей девушки день рождения."

# ch/hanna/events.rpy:4725
translate russian hanna_birthday_date_male_d0bb599a:
    mike.say "Хотел её порадовать, устроить что-нибудь особенное."

# ch/hanna/events.rpy:4726
translate russian hanna_birthday_date_male_eaf30256:
    "Охранник на миг переводит взгляд на Ханну."

# ch/hanna/events.rpy:4728
translate russian hanna_birthday_date_male_a880043d:
    "Она не теряется и широко улыбается."

# ch/hanna/events.rpy:4729
translate russian hanna_birthday_date_male_65eb32d1:
    "Вижу, как он её разглядывает, но сейчас это может нам помочь."

# ch/hanna/events.rpy:4730
translate russian hanna_birthday_date_male_d151c8f5:
    mike.say "Что ж, Ханна..."

# ch/hanna/events.rpy:4731
translate russian hanna_birthday_date_male_6edb6ebd:
    mike.say "Похоже, придётся встать в конец очереди!"

# ch/hanna/events.rpy:4732
translate russian hanna_birthday_date_male_4c0d1c93:
    "Поворачиваюсь уходить, но охранник поднимает руку, останавливая меня."

# ch/hanna/events.rpy:4734
translate russian hanna_birthday_date_male_8bba4c5f:
    "Вышибала" "Погоди, приятель."

# ch/hanna/events.rpy:4735
translate russian hanna_birthday_date_male_928734f5:
    "Вышибала" "Незачем портить девушке праздник."

# ch/hanna/events.rpy:4736
translate russian hanna_birthday_date_male_c72c118d:
    "Вышибала" "Наверное, кто-то напутал со списком."

# ch/hanna/events.rpy:4737
translate russian hanna_birthday_date_male_a5f64358:
    "Вышибала" "Проходите так."

# ch/hanna/events.rpy:4738
translate russian hanna_birthday_date_male_c54cfd61:
    "И вот мы уже заходим в клуб."

# ch/hanna/events.rpy:4741
translate russian hanna_birthday_date_male_a93ecbc4:
    hanna.say "Ух ты, [lssb_hanna.hero_name()]..."

# ch/hanna/events.rpy:4743
translate russian hanna_birthday_date_male_79d0e763:
    hanna.say "Ловко получилось!"

# ch/hanna/events.rpy:4745
translate russian hanna_birthday_date_male_31e03c23:
    mike.say "Слушай, приятель..."

# ch/hanna/events.rpy:4746
translate russian hanna_birthday_date_male_ea7d9ad7:
    mike.say "Я точно знаю, что бронировал столик."

# ch/hanna/events.rpy:4747
translate russian hanna_birthday_date_male_13bc105c:
    mike.say "Может, позовёшь начальника?"

# ch/hanna/events.rpy:4748
translate russian hanna_birthday_date_male_e5894cd5:
    mike.say "Или кого-нибудь, кто действительно способен принимать решения?"

# ch/hanna/events.rpy:4749
translate russian hanna_birthday_date_male_c7d37f5d:
    "Едва я это произношу, поведение охранника резко меняется."

# ch/hanna/events.rpy:4750
translate russian hanna_birthday_date_male_f9b637b7:
    "До этого он был равнодушен, а теперь выглядит всерьёз разозлённым."

# ch/hanna/events.rpy:4751
translate russian hanna_birthday_date_male_2f9810b6:
    "Вышибала" "Так, приятель..."

# ch/hanna/events.rpy:4752
translate russian hanna_birthday_date_male_eb0e6871:
    "Вышибала" "Я старался быть вежливым."

# ch/hanna/events.rpy:4753
translate russian hanna_birthday_date_male_a3f0f0d0:
    "Вышибала" "Но всё, хватит."

# ch/hanna/events.rpy:4754
translate russian hanna_birthday_date_male_f729e860:
    "Вышибала" "Твоей фамилии в списке нет."

# ch/hanna/events.rpy:4755
translate russian hanna_birthday_date_male_3025c10f:
    "Вышибала" "Значит, ждёшь со всеми в очереди."

# ch/hanna/events.rpy:4756
translate russian hanna_birthday_date_male_4b196fdf:
    "Нам с Ханной приходится с позором идти в конец очереди."

# ch/hanna/events.rpy:4757
translate russian hanna_birthday_date_male_5266640c:
    "Под взглядами всех, мимо кого мы только что прошли."

# ch/hanna/events.rpy:4760
translate russian hanna_birthday_date_male_d73593b3:
    hanna.say "Молодец, [lssb_hanna.hero_name()]."

# ch/hanna/events.rpy:4761
translate russian hanna_birthday_date_male_ed0f44c6:
    hanna.say "Уж ты ему показал."

# ch/hanna/events.rpy:4763
translate russian hanna_birthday_date_male_30dea628:
    "Вышибала" "Чем могу помочь?"

# ch/hanna/events.rpy:4764
translate russian hanna_birthday_date_male_d5596bcc:
    mike.say "Надеюсь, сможешь, приятель..."

# ch/hanna/events.rpy:4765
translate russian hanna_birthday_date_male_956631e4:
    mike.say "Я заказал столик на двоих."

# ch/hanna/events.rpy:4766
translate russian hanna_birthday_date_male_cd787c84:
    mike.say "Значит, мы можем пройти без очереди?"

# ch/hanna/events.rpy:4767
translate russian hanna_birthday_date_male_69bb4a64:
    "Вышибала" "Да, сэр, всё верно."

# ch/hanna/events.rpy:4768
translate russian hanna_birthday_date_male_541bfa01:
    "Вышибала" "На какую фамилию?"

# ch/hanna/events.rpy:4769
translate russian hanna_birthday_date_male_c4cb83da:
    mike.say "[hero.family_name]."

# ch/hanna/events.rpy:4770
translate russian hanna_birthday_date_male_229ea699:
    "Охранник кивает и начинает проверять список."

# ch/hanna/events.rpy:4771
translate russian hanna_birthday_date_male_ad758f41:
    "Но через пару неловких секунд качает головой."

# ch/hanna/events.rpy:4772
translate russian hanna_birthday_date_male_405ea890:
    "Вышибала" "Не хотелось бы вас расстраивать..."

# ch/hanna/events.rpy:4773
translate russian hanna_birthday_date_male_8b0365da:
    "Вышибала" "Но такой фамилии в списке нет."

# ch/hanna/events.rpy:4775
translate russian hanna_birthday_date_male_8cae5716:
    "Ханна умоляюще смотрит на меня, явно надеясь, что я всё улажу."

# ch/hanna/events.rpy:4776
translate russian hanna_birthday_date_male_993c5b86:
    "Но одного взгляда на охранника хватает, чтобы понять: фамилия внезапно не найдётся."

# ch/hanna/events.rpy:4777
translate russian hanna_birthday_date_male_65fe2089:
    "Придётся самому придумать решение, и быстро!"

# ch/hanna/events.rpy:4780
translate russian hanna_birthday_date_male_999c2e42:
    "Стараясь сделать это незаметно, вытаскиваю купюру из кармана."

# ch/hanna/events.rpy:4781
translate russian hanna_birthday_date_male_b01ceed9:
    "Затем вкладываю её в руку охраннику, не глядя в глаза."

# ch/hanna/events.rpy:4782
translate russian hanna_birthday_date_male_253c6b1f:
    "Выжидаю пару секунд и снова смотрю."

# ch/hanna/events.rpy:4783
translate russian hanna_birthday_date_male_bbc33425:
    "С удовольствием замечаю, что купюра исчезла."

# ch/hanna/events.rpy:4784
translate russian hanna_birthday_date_male_f1d8a63c:
    mike.say "Эм..."

# ch/hanna/events.rpy:4785
translate russian hanna_birthday_date_male_37d98b90:
    mike.say "Ну как теперь список?"

# ch/hanna/events.rpy:4786
translate russian hanna_birthday_date_male_cccecbc9:
    mike.say "Знаешь, иногда со второго раза лучше находится!"

# ch/hanna/events.rpy:4787
translate russian hanna_birthday_date_male_8690d9c2:
    "Охранник демонстративно снова смотрит в список."

# ch/hanna/events.rpy:4788
translate russian hanna_birthday_date_male_46dbe8a0:
    "Но я вижу, как уголок его рта поднимается в усмешке."

# ch/hanna/events.rpy:4789
translate russian hanna_birthday_date_male_bb7fe99f:
    "Потом он кивает и тихо посмеивается."

# ch/hanna/events.rpy:4790
translate russian hanna_birthday_date_male_7ebecf82:
    "Вышибала" "Знаете, сэр..."

# ch/hanna/events.rpy:4791
translate russian hanna_birthday_date_male_2c00926c:
    "Вышибала" "Похоже, вы правы."

# ch/hanna/events.rpy:4794
translate russian hanna_birthday_date_male_c302d5ab:
    "Вышибала" "Ваша фамилия всё время была здесь."

# ch/hanna/events.rpy:4795
translate russian hanna_birthday_date_male_df294dee:
    "Вышибала" "Наверное, я сначала пропустил."

# ch/hanna/events.rpy:4796
translate russian hanna_birthday_date_male_a77b0e88:
    "Вышибала" "Можете проходить."

# ch/hanna/events.rpy:4797
translate russian hanna_birthday_date_male_c54cfd61_1:
    "И вот мы уже заходим в клуб."

# ch/hanna/events.rpy:4800
translate russian hanna_birthday_date_male_a93ecbc4_1:
    hanna.say "Ух ты, [lssb_hanna.hero_name()]..."

# ch/hanna/events.rpy:4802
translate russian hanna_birthday_date_male_79d0e763_1:
    hanna.say "Ловко получилось!"

# ch/hanna/events.rpy:4804
translate russian hanna_birthday_date_male_7d73130f:
    "Я стараюсь выглядеть серьёзно, даже немного устрашающе."

# ch/hanna/events.rpy:4805
translate russian hanna_birthday_date_male_9bac2770:
    "И меняю тон, пытаясь показать, что шутки кончились."

# ch/hanna/events.rpy:4806
translate russian hanna_birthday_date_male_d98e6ad4:
    mike.say "Так..."

# ch/hanna/events.rpy:4807
translate russian hanna_birthday_date_male_c41d7d28:
    mike.say "Теперь слушай меня внимательно."

# ch/hanna/events.rpy:4808
translate russian hanna_birthday_date_male_aeb7b71b:
    mike.say "Я точно знаю, что заказал столик."

# ch/hanna/events.rpy:4809
translate russian hanna_birthday_date_male_0af8e886:
    mike.say "Так что лучше впусти нас прямо сейчас."

# ch/hanna/events.rpy:4810
translate russian hanna_birthday_date_male_5b5d0d2a:
    mike.say "Или зови начальника, я расскажу ему, какой ты бесполезный!"

# ch/hanna/events.rpy:4811
translate russian hanna_birthday_date_male_1a703dcf:
    "Лично мне кажется, вышло неплохо."

# ch/hanna/events.rpy:4812
translate russian hanna_birthday_date_male_428a1598:
    "Но на охранника мои слова действуют совсем не так, как хотелось."

# ch/hanna/events.rpy:4813
translate russian hanna_birthday_date_male_cb3909a4:
    "Его лицо словно захлопывается, будто запертая ставня."

# ch/hanna/events.rpy:4814
translate russian hanna_birthday_date_male_9824e6e6:
    "Вышибала" "Да ну?"

# ch/hanna/events.rpy:4815
translate russian hanna_birthday_date_male_85c7fd98:
    "Вышибала" "По-моему, разговор окончен."

# ch/hanna/events.rpy:4816
translate russian hanna_birthday_date_male_8d34b08a:
    "Вышибала" "Стойте в очереди, как все."

# ch/hanna/events.rpy:4817
translate russian hanna_birthday_date_male_4b196fdf_1:
    "Нам с Ханной приходится с позором идти в конец очереди."

# ch/hanna/events.rpy:4818
translate russian hanna_birthday_date_male_5266640c_1:
    "Под взглядами всех, мимо кого мы только что прошли."

# ch/hanna/events.rpy:4821
translate russian hanna_birthday_date_male_d73593b3_1:
    hanna.say "Молодец, [lssb_hanna.hero_name()]."

# ch/hanna/events.rpy:4822
translate russian hanna_birthday_date_male_ed0f44c6_1:
    hanna.say "Уж ты ему показал."

# ch/hanna/events.rpy:4828
translate russian hanna_birthday_date_male_47d6c9c7:
    "Внутри клуба настроение Ханны почти сразу улучшается."

# ch/hanna/events.rpy:4829
translate russian hanna_birthday_date_male_ba83f041:
    "Она улыбается и с интересом оглядывается."

# ch/hanna/events.rpy:4831
translate russian hanna_birthday_date_male_f454fc94:
    hanna.say "Хороший выбор, [lssb_hanna.hero_name()]!"

# ch/hanna/events.rpy:4833
translate russian hanna_birthday_date_male_4e5d4501:
    hanna.say "Здесь отличная атмосфера."

# ch/hanna/events.rpy:4834
translate russian hanna_birthday_date_male_86b60eb1:
    mike.say "Если тебе нравится это, Ханна..."

# ch/hanna/events.rpy:4835
translate russian hanna_birthday_date_male_285c4d84:
    mike.say "Подожди, пока увидишь нашу VIP-ложу на вечер!"

# ch/hanna/events.rpy:4836
translate russian hanna_birthday_date_male_e81fad89:
    "Пока я веду её к VIP-зоне, она выглядит очень заинтригованной."

# ch/hanna/events.rpy:4837
translate russian hanna_birthday_date_male_63c06854:
    "А увидев её, буквально расцветает."

# ch/hanna/events.rpy:4842
translate russian hanna_birthday_date_male_a5aab89e:
    hanna.say "ВАУ!"

# ch/hanna/events.rpy:4845
translate russian hanna_birthday_date_male_1ac34647:
    hanna.say "Отсюда весь клуб видно!"

# ch/hanna/events.rpy:4846
translate russian hanna_birthday_date_male_3487f21e:
    hanna.say "И все видят меня!"

# ch/hanna/events.rpy:4850
translate russian hanna_birthday_date_male_3a4fa1c2:
    hanna.say "НАС... то есть все видят нас..."

# ch/hanna/events.rpy:4851
translate russian hanna_birthday_date_male_a9896b79:
    "Я киваю, улыбаюсь и сажусь рядом."

# ch/hanna/events.rpy:4852
translate russian hanna_birthday_date_male_03d5981f:
    "Но через мгновение меня застаёт врасплох официантка, появившаяся словно из ниоткуда."

# ch/hanna/events.rpy:4853
translate russian hanna_birthday_date_male_8d5b69d9:
    "Официантка" "Добрый вечер, сэр..."

# ch/hanna/events.rpy:4854
translate russian hanna_birthday_date_male_42a7bbc2:
    "Официантка" "Добрый вечер, мадам..."

# ch/hanna/events.rpy:4855
translate russian hanna_birthday_date_male_765e0d16:
    "Официантка" "Что будете пить?"

# ch/hanna/events.rpy:4857
translate russian hanna_birthday_date_male_a38633d6:
    "Ханна явно впечатлена."

# ch/hanna/events.rpy:4859
translate russian hanna_birthday_date_male_1b285f19:
    hanna.say "Погоди..."

# ch/hanna/events.rpy:4861
translate russian hanna_birthday_date_male_3f07f85b:
    hanna.say "Нас ещё и за столиком обслуживают?!"

# ch/hanna/events.rpy:4862
translate russian hanna_birthday_date_male_dded45de:
    mike.say "Да, Ханна. Для тебя только лучшее."

# ch/hanna/events.rpy:4863
translate russian hanna_birthday_date_male_0f6b2a18:
    mike.say "Что закажем?"

# ch/hanna/events.rpy:4864
translate russian hanna_birthday_date_male_da76c72c:
    "Берём по напитку и начинаем болтать."

# ch/hanna/events.rpy:4865
translate russian hanna_birthday_date_male_c86197e6:
    "Но не успеваю оглянуться, как Ханна уже допивает свой."

# ch/hanna/events.rpy:4867
translate russian hanna_birthday_date_male_8650386c:
    hanna.say "Эй..."

# ch/hanna/events.rpy:4868
translate russian hanna_birthday_date_male_053b6128:
    hanna.say "Куда делась официантка?"

# ch/hanna/events.rpy:4870
translate russian hanna_birthday_date_male_be246d17:
    hanna.say "Мне нужен ещё один такой!"

# ch/hanna/events.rpy:4873
translate russian hanna_birthday_date_male_1aa6d67b:
    "Я смотрю на свой стакан."

# ch/hanna/events.rpy:4874
translate russian hanna_birthday_date_male_42994221:
    "И пожимаю плечами."

# ch/hanna/events.rpy:4875
translate russian hanna_birthday_date_male_69d9db70:
    mike.say "А почему бы и нет?"

# ch/hanna/events.rpy:4876
translate russian hanna_birthday_date_male_707a5db8:
    mike.say "Эй, официантка!"

# ch/hanna/events.rpy:4877
translate russian hanna_birthday_date_male_1599030e:
    mike.say "Можно нам ещё два таких же?"

# ch/hanna/events.rpy:4880
translate russian hanna_birthday_date_male_09b2f1e5:
    "Когда приносят второй заказ, Ханна улыбается."

# ch/hanna/events.rpy:4882
translate russian hanna_birthday_date_male_17ffb97c:
    hanna.say "Знаешь, я думала, ты сейчас начнёшь меня отчитывать."

# ch/hanna/events.rpy:4884
translate russian hanna_birthday_date_male_0868207b:
    hanna.say "Ты ведь даже первый ещё не допил!"

# ch/hanna/events.rpy:4885
translate russian hanna_birthday_date_male_41531d01:
    "Я снова пожимаю плечами и залпом допиваю остаток."

# ch/hanna/events.rpy:4886
translate russian hanna_birthday_date_male_481cf44c:
    mike.say "А-а!"

# ch/hanna/events.rpy:4887
translate russian hanna_birthday_date_male_b415e0e4:
    mike.say "То что надо."

# ch/hanna/events.rpy:4888
translate russian hanna_birthday_date_male_f1d549c7:
    mike.say "Не время занудствовать, Ханна."

# ch/hanna/events.rpy:4889
translate russian hanna_birthday_date_male_183ac0ef:
    mike.say "Мы празднуем."

# ch/hanna/events.rpy:4890
translate russian hanna_birthday_date_male_a10612e2:
    mike.say "Так давай повеселимся."

# ch/hanna/events.rpy:4892
translate russian hanna_birthday_date_male_3f8382ca:
    mike.say "Ого..."

# ch/hanna/events.rpy:4893
translate russian hanna_birthday_date_male_6413a65b:
    mike.say "Притормози немного, Ханна!"

# ch/hanna/events.rpy:4894
translate russian hanna_birthday_date_male_9b489ad9:
    mike.say "У нас ведь весь вечер впереди."

# ch/hanna/events.rpy:4896
translate russian hanna_birthday_date_male_31c3c729:
    "Она хмурится и смотрит на меня прищурившись."

# ch/hanna/events.rpy:4898
translate russian hanna_birthday_date_male_62b164e2:
    hanna.say "Ты о чём?"

# ch/hanna/events.rpy:4899
translate russian hanna_birthday_date_male_154c3ad3:
    hanna.say "У меня день рождения."

# ch/hanna/events.rpy:4901
translate russian hanna_birthday_date_male_356f6462:
    hanna.say "Мы разве не праздновать пришли?"

# ch/hanna/events.rpy:4902
translate russian hanna_birthday_date_male_8903daf3:
    mike.say "Я понимаю."

# ch/hanna/events.rpy:4903
translate russian hanna_birthday_date_male_1ac001f5:
    mike.say "Но это не соревнование, кто быстрее напьётся до беспамятства!"

# ch/hanna/events.rpy:4906
translate russian hanna_birthday_date_male_78eb08ab:
    "Она скрещивает руки на груди."

# ch/hanna/events.rpy:4908
translate russian hanna_birthday_date_male_84c07c9c:
    "И откидывается на сиденье."

# ch/hanna/events.rpy:4910
translate russian hanna_birthday_date_male_568aa94e:
    hanna.say "Хм..."

# ch/hanna/events.rpy:4911
translate russian hanna_birthday_date_male_4adb9480:
    hanna.say "И не соревнование на самого скучного."

# ch/hanna/events.rpy:4913
translate russian hanna_birthday_date_male_38997716:
    hanna.say "Тут победитель уже известен!"

# ch/hanna/events.rpy:4918
translate russian hanna_birthday_date_male_4d2936de:
    "Я наконец расслабляюсь и проникаюсь атмосферой клуба."

# ch/hanna/events.rpy:4919
translate russian hanna_birthday_date_male_daf63751:
    "Наверное, помогают алкоголь и возможность смотреть на Ханну!"

# ch/hanna/events.rpy:4920
translate russian hanna_birthday_date_male_888f380a:
    "Сегодня она чертовски сексуальна."

# ch/hanna/events.rpy:4921
translate russian hanna_birthday_date_male_ec278b50:
    "Часть меня до сих пор не верит, что она пришла со мной!"

# ch/hanna/events.rpy:4923
translate russian hanna_birthday_date_male_cd8a9608:
    hanna.say "Эй, [lssb_hanna.hero_name()]..."

# ch/hanna/events.rpy:4925
translate russian hanna_birthday_date_male_20445c0a:
    hanna.say "Хватит просиживать штаны!"

# ch/hanna/events.rpy:4927
translate russian hanna_birthday_date_male_7ed36472:
    hanna.say "Пойдём танцевать..."

# ch/hanna/events.rpy:4928
translate russian hanna_birthday_date_male_aeba359f:
    "Не успеваю даже подумать о возражении, как она поднимает меня на ноги."

# ch/hanna/events.rpy:4929
translate russian hanna_birthday_date_male_1cb0f669:
    "И без промедления ведёт на танцпол."

# ch/hanna/events.rpy:4934
translate russian hanna_birthday_date_male_8caa1753:
    "Едва мы оказываемся там, Ханна пускается в пляс."

# ch/hanna/events.rpy:4935
translate russian hanna_birthday_date_male_1879ab02:
    "Танцует так, будто от этого зависит её жизнь."

# ch/hanna/events.rpy:4936
translate russian hanna_birthday_date_male_2fa6ee30:
    "И я вижу, как сказываются занятия, которые она ведёт в зале."

# ch/hanna/events.rpy:4937
translate russian hanna_birthday_date_male_4783503f:
    "Серьёзно, вы ничего не видели, если не были на её танцевальной тренировке!"

# ch/hanna/events.rpy:4938
translate russian hanna_birthday_date_male_7f033ec6:
    "И сегодня она показывает здесь все эти движения."

# ch/hanna/events.rpy:4939
translate russian hanna_birthday_date_male_3d1fc8c7:
    "Я сам бывал на паре таких занятий."

# ch/hanna/events.rpy:4940
translate russian hanna_birthday_date_male_fc80881d:
    "Поэтому решаю, что лучше двигаться в том же духе."

# ch/hanna/events.rpy:4941
translate russian hanna_birthday_date_male_4c130f19:
    "Вот бы только вспомнить, чему она учила..."

# ch/hanna/events.rpy:4943
translate russian hanna_birthday_date_male_aee89604:
    "Стоит начать танцевать, как все уроки всплывают в памяти."

# ch/hanna/events.rpy:4944
translate russian hanna_birthday_date_male_b686549e:
    "Помогает и природное чувство стиля и грации."

# ch/hanna/events.rpy:4945
translate russian hanna_birthday_date_male_cce1dcc8:
    "Не успевает Ханна опомниться, как я почти затмеваю её!"

# ch/hanna/events.rpy:4946
translate russian hanna_birthday_date_male_03ee3939:
    "По удивлённому лицу видно: она не подозревала, что я умею так двигаться."

# ch/hanna/events.rpy:4947
translate russian hanna_birthday_date_male_6bd22c3c:
    "Теперь ей остаётся лишь продолжать танцевать."

# ch/hanna/events.rpy:4948
translate russian hanna_birthday_date_male_8fae986f:
    "И тщетно пытаться за мной угнаться!"

# ch/hanna/events.rpy:4950
translate russian hanna_birthday_date_male_24ae4158:
    "Вскоре Ханна уже повторяет мои движения вместо своих."

# ch/hanna/events.rpy:4951
translate russian hanna_birthday_date_male_c398b54f:
    "И тут замечаю, что остальные делают то же самое!"

# ch/hanna/events.rpy:4953
translate russian hanna_birthday_date_male_50535e78:
    "Невероятно! Танцпол будто превратился в сцену танцевального шоу!"

# ch/hanna/events.rpy:4955
translate russian hanna_birthday_date_male_11f31761:
    "Наверное, на тех занятиях я слушал невнимательно."

# ch/hanna/events.rpy:4956
translate russian hanna_birthday_date_male_fbce99ac:
    "Или у меня от природы две левые ноги."

# ch/hanna/events.rpy:4957
translate russian hanna_birthday_date_male_7fbc316f:
    "Потому что любое движение заканчивается полным провалом."

# ch/hanna/events.rpy:4958
translate russian hanna_birthday_date_male_19291a94:
    "То и дело врезаюсь в Ханну на танцполе."

# ch/hanna/events.rpy:4959
translate russian hanna_birthday_date_male_7b0569d5:
    "Или наступаю ей на ноги, заставляя вскрикивать от боли."

# ch/hanna/events.rpy:4961
translate russian hanna_birthday_date_male_af2dc189:
    "В конце концов она отодвигает меня на безопасное расстояние."

# ch/hanna/events.rpy:4962
translate russian hanna_birthday_date_male_8ed016c6:
    "И с этого момента следит, чтобы я его соблюдал."

# ch/hanna/events.rpy:4964
translate russian hanna_birthday_date_male_abcdb19e:
    "Сегодня Ханна выкладывается на танцполе по полной."

# ch/hanna/events.rpy:4965
translate russian hanna_birthday_date_male_5066fe18:
    "Не верится, что до этого она отработала целый день в зале."

# ch/hanna/events.rpy:4966
translate russian hanna_birthday_date_male_1c2a07a8:
    "И никаких признаков усталости."

# ch/hanna/events.rpy:4967
translate russian hanna_birthday_date_male_98909ca9:
    "Откуда столько энергии — понятия не имею!"

# ch/hanna/events.rpy:4968
translate russian hanna_birthday_date_male_31785f2d:
    "Мне остаётся лишь изо всех сил поспевать."

# ch/hanna/events.rpy:4969
translate russian hanna_birthday_date_male_7dd6032f:
    "Я, конечно, не развалина."

# ch/hanna/events.rpy:4970
translate russian hanna_birthday_date_male_03e1db06:
    "Но всё же человек."

# ch/hanna/events.rpy:4971
translate russian hanna_birthday_date_male_cbfa5245:
    "А Ханна сейчас словно машина!"

# ch/hanna/events.rpy:4973
translate russian hanna_birthday_date_male_47be5929:
    "Но я ведь в спортзал ходил не только ради сауны!"

# ch/hanna/events.rpy:4974
translate russian hanna_birthday_date_male_45673745:
    "Благодаря занятиям у Ханны я в отличной форме."

# ch/hanna/events.rpy:4975
translate russian hanna_birthday_date_male_415c333a:
    "И вполне готов принять вызов."

# ch/hanna/events.rpy:4976
translate russian hanna_birthday_date_male_09fd5868:
    "Мне удаётся отвечать на каждое её движение."

# ch/hanna/events.rpy:4977
translate russian hanna_birthday_date_male_511345a5:
    "Что, похоже, немного её удивляет."

# ch/hanna/events.rpy:4978
translate russian hanna_birthday_date_male_ddbea39e:
    "Видимо, привыкла сама задавать темп на занятиях."

# ch/hanna/events.rpy:4979
translate russian hanna_birthday_date_male_cbaf2cb0:
    "Но мы не в спортзале, и это не тренировка."

# ch/hanna/events.rpy:4980
translate russian hanna_birthday_date_male_8d0082fe:
    "Поэтому я совершенно не стесняюсь держаться с ней наравне."

# ch/hanna/events.rpy:4981
translate russian hanna_birthday_date_male_f3b05573:
    "А может, даже подталкивать к новым высотам!"

# ch/hanna/events.rpy:4982
translate russian hanna_birthday_date_male_fbfcf169:
    "В итоге первой начинает сдавать Ханна."

# ch/hanna/events.rpy:4983
translate russian hanna_birthday_date_male_f1753842:
    "Именно она уводит меня с танцпола."

# ch/hanna/events.rpy:4987
translate russian hanna_birthday_date_male_09391e6d:
    mike.say "Что такое, Ханна?"

# ch/hanna/events.rpy:4988
translate russian hanna_birthday_date_male_bb7e3e50:
    mike.say "Я думал, мы только разогрелись?"

# ch/hanna/events.rpy:4991
translate russian hanna_birthday_date_male_b53c3951:
    hanna.say "Что?!"

# ch/hanna/events.rpy:4993
translate russian hanna_birthday_date_male_5bd25dde:
    hanna.say "Ты шутишь!"

# ch/hanna/events.rpy:4998
translate russian hanna_birthday_date_male_30020985:
    hanna.say "Так ты меня просто убьёшь!"

# ch/hanna/events.rpy:5000
translate russian hanna_birthday_date_male_b21a578d:
    "Изо всех сил пытаюсь дышать и не дать сердцу остановиться."

# ch/hanna/events.rpy:5001
translate russian hanna_birthday_date_male_13b4ff4a:
    "Но темп Ханны мне не по силам."

# ch/hanna/events.rpy:5002
translate russian hanna_birthday_date_male_306eceb0:
    "Вскоре начинаю выдыхаться и отставать."

# ch/hanna/events.rpy:5003
translate russian hanna_birthday_date_male_40028605:
    "А потом уже задыхаюсь."

# ch/hanna/events.rpy:5004
translate russian hanna_birthday_date_male_625d82b4:
    "Хуже того, перед глазами, клянусь, мелькают мушки!"

# ch/hanna/events.rpy:5006
translate russian hanna_birthday_date_male_8e80931f:
    "Наконец машу рукой, сдаваясь, и, шатаясь, ухожу с танцпола."

# ch/hanna/events.rpy:5009
translate russian hanna_birthday_date_male_44f625d1:
    "Через какое-то время Ханна возвращается в ложу меня проведать."

# ch/hanna/events.rpy:5011
translate russian hanna_birthday_date_male_d03179d4:
    hanna.say "Всё хорошо, [lssb_hanna.hero_name()]?"

# ch/hanna/events.rpy:5012
translate russian hanna_birthday_date_male_e734c09e:
    hanna.say "Я там за тебя испугалась!"

# ch/hanna/events.rpy:5013
translate russian hanna_birthday_date_male_a921212b:
    mike.say "Буду в порядке, Ханна."

# ch/hanna/events.rpy:5014
translate russian hanna_birthday_date_male_cbdcb276:
    mike.say "Просто нужно немного отдохнуть."

# ch/hanna/events.rpy:5016
translate russian hanna_birthday_date_male_68c06ae6:
    hanna.say "Ничего."

# ch/hanna/events.rpy:5019
translate russian hanna_birthday_date_male_c944d859:
    hanna.say "За мной там куча парней присматривала."

# ch/hanna/events.rpy:5020
translate russian hanna_birthday_date_male_9f22f531:
    mike.say "О... отлично."

# ch/hanna/events.rpy:5021
translate russian hanna_birthday_date_male_ec5bcd8c:
    mike.say "Наверное..."

# ch/hanna/events.rpy:5025
translate russian hanna_birthday_date_male_3a2a7ef1:
    "Наконец, полностью покорив танцпол, Ханна готова его покинуть."

# ch/hanna/events.rpy:5029
translate russian hanna_birthday_date_male_47372916:
    "К нашей ложе она идёт словно королева, осматривающая владения перед тем, как сесть на трон."

# ch/hanna/events.rpy:5030
translate russian hanna_birthday_date_male_362a98f4:
    "Но, подойдя, я замечаю ждущий нас на столе напиток."

# ch/hanna/events.rpy:5031
translate russian hanna_birthday_date_male_1ccab2e1:
    mike.say "Хм..."

# ch/hanna/events.rpy:5032
translate russian hanna_birthday_date_male_c05e9d37:
    mike.say "Не помню, чтобы заказывал это!"

# ch/hanna/events.rpy:5033
translate russian hanna_birthday_date_male_a146e1e0:
    mike.say "А ты, Ханна?"

# ch/hanna/events.rpy:5035
translate russian hanna_birthday_date_male_60c65b85:
    hanna.say "Не-а."

# ch/hanna/events.rpy:5037
translate russian hanna_birthday_date_male_7966143a:
    hanna.say "Но выглядит впечатляюще!"

# ch/hanna/events.rpy:5038
translate russian hanna_birthday_date_male_870efe04:
    "Приходится признать: она права."

# ch/hanna/events.rpy:5039
translate russian hanna_birthday_date_male_5b39d874:
    "Выглядит действительно впечатляюще."

# ch/hanna/events.rpy:5040
translate russian hanna_birthday_date_male_39cf6762:
    "И дорого!"

# ch/hanna/events.rpy:5041
translate russian hanna_birthday_date_male_c8b23eb2:
    "Подзываю проходящую мимо официантку."

# ch/hanna/events.rpy:5042
translate russian hanna_birthday_date_male_4da27abd:
    mike.say "Извините..."

# ch/hanna/events.rpy:5043
translate russian hanna_birthday_date_male_f9bc4251:
    mike.say "Мы не заказывали этот напиток."

# ch/hanna/events.rpy:5044
translate russian hanna_birthday_date_male_e19ac030:
    "Она улыбается и качает головой."

# ch/hanna/events.rpy:5045
translate russian hanna_birthday_date_male_1b7eafc5:
    "Официантка" "Нет, сэр..."

# ch/hanna/events.rpy:5046
translate russian hanna_birthday_date_male_964f1617:
    "Официантка" "Его заказали джентльмены вон в той ложе."

# ch/hanna/events.rpy:5047
translate russian hanna_birthday_date_male_7e84cc53:
    "Официантка" "Для вашей спутницы."

# ch/hanna/events.rpy:5050
translate russian hanna_birthday_date_male_1912cf93:
    "Брови Ханны взлетают вверх."

# ch/hanna/events.rpy:5052
translate russian hanna_birthday_date_male_d886d1ec:
    "Она вытягивает шею, пытаясь разглядеть, на кого указывает официантка."

# ch/hanna/events.rpy:5053
translate russian hanna_birthday_date_male_37565de3:
    "Я делаю то же самое."

# ch/hanna/events.rpy:5054
translate russian hanna_birthday_date_male_613c3e73:
    "И совсем не рад видеть там компанию парней."

# ch/hanna/events.rpy:5055
translate russian hanna_birthday_date_male_f8681139:
    "Заметив наши взгляды, они расплываются в улыбках."

# ch/hanna/events.rpy:5056
translate russian hanna_birthday_date_male_c33eaa2a:
    "Машут Ханне и подмигивают."

# ch/hanna/events.rpy:5057
translate russian hanna_birthday_date_male_54a07f75:
    "Нехорошо."

# ch/hanna/events.rpy:5058
translate russian hanna_birthday_date_male_94f84755:
    "Похоже, придётся что-то предпринять."

# ch/hanna/events.rpy:5062
translate russian hanna_birthday_date_male_2f81dd94:
    "Беру напиток и передаю Ханне."

# ch/hanna/events.rpy:5063
translate russian hanna_birthday_date_male_e73dafbc:
    "Затем привлекаю внимание парня из соседней ложи."

# ch/hanna/events.rpy:5064
translate russian hanna_birthday_date_male_90c61d9a:
    "Улыбаюсь, дружелюбно машу. Это лишь ещё больше их забавляет."

# ch/hanna/events.rpy:5065
translate russian hanna_birthday_date_male_258baca7:
    "Но потом демонстративно обнимаю Ханну."

# ch/hanna/events.rpy:5071
translate russian hanna_birthday_date_male_ab8a4f3b:
    "И целую прямо в губы."

# ch/hanna/events.rpy:5072
translate russian hanna_birthday_date_male_ba493e77:
    "Поначалу она немного удивлена."

# ch/hanna/events.rpy:5073
translate russian hanna_birthday_date_male_feb12bda:
    "Но затем тоже подаётся навстречу."

# ch/hanna/events.rpy:5074
translate russian hanna_birthday_date_male_c314a58f:
    "Поцелуй долгий и страстный, и мы наслаждаемся каждой секундой."

# ch/hanna/events.rpy:5079
translate russian hanna_birthday_date_male_1eed5ad5:
    "Когда он заканчивается, я снова улыбаюсь парням."

# ch/hanna/events.rpy:5080
translate russian hanna_birthday_date_male_7546d583:
    "На этот раз — с явным торжеством."

# ch/hanna/events.rpy:5081
translate russian hanna_birthday_date_male_5d3d7784:
    "Как и ожидалось, они склоняются над своими стаканами."

# ch/hanna/events.rpy:5082
translate russian hanna_birthday_date_male_eeaa8eb9:
    "Им вдруг становится не так весело."

# ch/hanna/events.rpy:5083
translate russian hanna_birthday_date_male_7a70e84b:
    mike.say "Ну как напиток, Ханна?"

# ch/hanna/events.rpy:5085
translate russian hanna_birthday_date_male_782fe241:
    hanna.say "Эм..."

# ch/hanna/events.rpy:5086
translate russian hanna_birthday_date_male_387a8027:
    hanna.say "Очень неплохо, [lssb_hanna.hero_name()]."

# ch/hanna/events.rpy:5088
translate russian hanna_birthday_date_male_6f9dfa3c:
    hanna.say "Ты..."

# ch/hanna/events.rpy:5089
translate russian hanna_birthday_date_male_ce0dec3a:
    hanna.say "Ты правда не против такого?"

# ch/hanna/events.rpy:5091
translate russian hanna_birthday_date_male_e36c9e41:
    mike.say "Конечно, Ханна."

# ch/hanna/events.rpy:5092
translate russian hanna_birthday_date_male_79f299f1:
    mike.say "Не винить же их за хороший вкус!"

# ch/hanna/events.rpy:5095
translate russian hanna_birthday_date_male_ea742115:
    "Она округляет глаза и краснеет от комплимента."

# ch/hanna/events.rpy:5097
translate russian hanna_birthday_date_male_b73a129b:
    "Я пододвигаю напиток к официантке."

# ch/hanna/events.rpy:5098
translate russian hanna_birthday_date_male_7c33caee:
    mike.say "Будьте добры, уберите это."

# ch/hanna/events.rpy:5099
translate russian hanna_birthday_date_male_46066f53:
    mike.say "И больше никаких чужих напитков не приносите."

# ch/hanna/events.rpy:5100
translate russian hanna_birthday_date_male_910025d2:
    "Она выглядит немного неловко."

# ch/hanna/events.rpy:5101
translate russian hanna_birthday_date_male_11e0c4be:
    "Но кивает и выполняет просьбу."

# ch/hanna/events.rpy:5102
translate russian hanna_birthday_date_male_11fb1db4:
    "Я поворачиваюсь к Ханне, намеренно садясь спиной к соседней ложе."

# ch/hanna/events.rpy:5106
translate russian hanna_birthday_date_male_7b09ed6e:
    hanna.say "Зачем ты так?"

# ch/hanna/events.rpy:5107
translate russian hanna_birthday_date_male_9febf060:
    hanna.say "Это всего один напиток, [lssb_hanna.hero_name()]."

# ch/hanna/events.rpy:5108
translate russian hanna_birthday_date_male_6dfb42fa:
    hanna.say "Парни просто хотели быть любезными!"

# ch/hanna/events.rpy:5110
translate russian hanna_birthday_date_male_85ba59f0:
    mike.say "Они пытались с тобой флиртовать, Ханна."

# ch/hanna/events.rpy:5111
translate russian hanna_birthday_date_male_9a1f423f:
    mike.say "Прямо у меня под носом!"

# ch/hanna/events.rpy:5112
translate russian hanna_birthday_date_male_583e6c45:
    mike.say "Посреди нашего свидания!"

# ch/hanna/events.rpy:5114
translate russian hanna_birthday_date_male_f7c4bf69:
    "Она отводит взгляд, словно готова закрыть тему."

# ch/hanna/events.rpy:5115
translate russian hanna_birthday_date_male_995ad4ee:
    "Да, не самый приятный способ разобраться с проблемой."

# ch/hanna/events.rpy:5116
translate russian hanna_birthday_date_male_4108db1d:
    "Зато теперь Ханна точно знает, что я об этом думаю."

# ch/hanna/events.rpy:5118
translate russian hanna_birthday_date_male_23754d16:
    hanna.say "[lssb_hanna.hero_name()]..."

# ch/hanna/events.rpy:5119
translate russian hanna_birthday_date_male_2a711237:
    mike.say "Да, Ханна?"

# ch/hanna/events.rpy:5121
translate russian hanna_birthday_date_male_70776b6a:
    hanna.say "Сегодня ведь мой день рождения?"

# ch/hanna/events.rpy:5122
translate russian hanna_birthday_date_male_92895b1e:
    mike.say "Насколько мне известно."

# ch/hanna/events.rpy:5126
translate russian hanna_birthday_date_male_308d42b5:
    hanna.say "А что бывает на день рождения?"

# ch/hanna/events.rpy:5128
translate russian hanna_birthday_date_male_595bd372:
    "Вот чёрт!"

# ch/hanna/events.rpy:5129
translate russian hanna_birthday_date_male_27748ce5:
    "Ханна намекает на подарок."

# ch/hanna/events.rpy:5130
translate russian hanna_birthday_date_male_ceda5f36:
    "А я не потрудился ничего купить!"

# ch/hanna/events.rpy:5131
translate russian hanna_birthday_date_male_6a71eb18:
    "Может, как-нибудь выкручусь..."

# ch/hanna/events.rpy:5133
translate russian hanna_birthday_date_male_f2fdf1de:
    mike.say "Ну, Ханна..."

# ch/hanna/events.rpy:5134
translate russian hanna_birthday_date_male_0f046d1c:
    mike.say "Если повезёт, кто-нибудь устроит прекрасное свидание!"

# ch/hanna/events.rpy:5136
translate russian hanna_birthday_date_male_c1cb3b39:
    "Несколько секунд она молча смотрит на меня."

# ch/hanna/events.rpy:5140
translate russian hanna_birthday_date_male_94e524c9:
    "Потом лицо вытягивается: она понимает, что подарка не будет."

# ch/hanna/events.rpy:5143
translate russian hanna_birthday_date_male_09ad1bc8:
    hanna.say "А... да..."

# ch/hanna/events.rpy:5144
translate russian hanna_birthday_date_male_90f602e1:
    hanna.say "Наверное, мне очень повезло!"

# ch/hanna/events.rpy:5149
translate russian hanna_birthday_date_male_0ae24709:
    "Я ждал подходящего момента, чтобы достать подарок."

# ch/hanna/events.rpy:5150
translate russian hanna_birthday_date_male_9d3aa83b:
    "Но, похоже, Ханна сама его создала."

# ch/hanna/events.rpy:5151
translate russian hanna_birthday_date_male_523cf43c:
    mike.say "Ладно, Ханна, намёк понял."

# ch/hanna/events.rpy:5152
translate russian hanna_birthday_date_male_360116a9:
    mike.say "С днём рождения!"

# ch/hanna/events.rpy:5155
translate russian hanna_birthday_date_male_58f74ab1:
    "Когда я протягиваю подарок, её лицо озаряется."

# ch/hanna/events.rpy:5158
translate russian hanna_birthday_date_male_f5e06414:
    "Она тут же разрывает упаковку."

# ch/hanna/events.rpy:5162
translate russian hanna_birthday_date_male_74e81f31:
    hanna.say "О..."

# ch/hanna/events.rpy:5163
translate russian hanna_birthday_date_male_dace6b1e:
    hanna.say "Ого..."

# ch/hanna/events.rpy:5166
translate russian hanna_birthday_date_male_dd0b28e4:
    "Она поднимает подарок и изумлённо разглядывает."

# ch/hanna/events.rpy:5167
translate russian hanna_birthday_date_male_09391e6d_1:
    mike.say "Что такое, Ханна?"

# ch/hanna/events.rpy:5168
translate russian hanna_birthday_date_male_d780b03d:
    mike.say "Тебе нравится?"

# ch/hanna/events.rpy:5170
translate russian hanna_birthday_date_male_22447744:
    hanna.say "Не просто хорошо."

# ch/hanna/events.rpy:5173
translate russian hanna_birthday_date_male_b0b3177d:
    hanna.say "Это потрясающе!"

# ch/hanna/events.rpy:5176
translate russian hanna_birthday_date_male_d775eab8:
    hanna.say "Огромное спасибо!"

# ch/hanna/events.rpy:5177
translate russian hanna_birthday_date_male_cfa5f677:
    "Я киваю и улыбаюсь, радуясь удачному выбору."

# ch/hanna/events.rpy:5178
translate russian hanna_birthday_date_male_bd7b9603:
    "Видеть её такой счастливой стоило всех усилий."

# ch/hanna/events.rpy:5181
translate russian hanna_birthday_date_male_74e81f31_1:
    hanna.say "О..."

# ch/hanna/events.rpy:5183
translate russian hanna_birthday_date_male_ad7e78b0:
    hanna.say "Спасибо, наверное..."

# ch/hanna/events.rpy:5186
translate russian hanna_birthday_date_male_e493974d:
    "Она смотрит на подарок с явным разочарованием."

# ch/hanna/events.rpy:5188
translate russian hanna_birthday_date_male_e74bbd2e:
    mike.say "Что-то не так, Ханна?"

# ch/hanna/events.rpy:5190
translate russian hanna_birthday_date_male_1e0627f1:
    hanna.say "Что?"

# ch/hanna/events.rpy:5192
translate russian hanna_birthday_date_male_666dd28a:
    hanna.say "О нет, всё хорошо."

# ch/hanna/events.rpy:5193
translate russian hanna_birthday_date_male_d5313321:
    "Мы обмениваемся неловкими улыбками, пока она убирает подарок."

# ch/hanna/events.rpy:5194
translate russian hanna_birthday_date_male_769c50a8:
    "А я делаю себе заметку в следующий раз постараться лучше."

# ch/hanna/events.rpy:5196
translate russian hanna_birthday_date_male_595bd372_1:
    "Вот чёрт!"

# ch/hanna/events.rpy:5197
translate russian hanna_birthday_date_male_27748ce5_1:
    "Ханна намекает на подарок."

# ch/hanna/events.rpy:5198
translate russian hanna_birthday_date_male_ceda5f36_1:
    "А я не потрудился ничего купить!"

# ch/hanna/events.rpy:5199
translate russian hanna_birthday_date_male_6a71eb18_1:
    "Может, как-нибудь выкручусь..."

# ch/hanna/events.rpy:5201
translate russian hanna_birthday_date_male_f2fdf1de_1:
    mike.say "Ну, Ханна..."

# ch/hanna/events.rpy:5202
translate russian hanna_birthday_date_male_0f046d1c_1:
    mike.say "Если повезёт, кто-нибудь устроит прекрасное свидание!"

# ch/hanna/events.rpy:5204
translate russian hanna_birthday_date_male_c1cb3b39_1:
    "Несколько секунд она молча смотрит на меня."

# ch/hanna/events.rpy:5208
translate russian hanna_birthday_date_male_94e524c9_1:
    "Потом лицо вытягивается: она понимает, что подарка не будет."

# ch/hanna/events.rpy:5211
translate russian hanna_birthday_date_male_09ad1bc8_1:
    hanna.say "А... да..."

# ch/hanna/events.rpy:5212
translate russian hanna_birthday_date_male_90f602e1_1:
    hanna.say "Наверное, мне очень повезло!"

# ch/hanna/events.rpy:5214
translate russian hanna_birthday_date_male_1c7e0d1a:
    "Смотрю на часы и собираюсь сказать, что уже поздно."

# ch/hanna/events.rpy:5215
translate russian hanna_birthday_date_male_4baaff7f:
    "Но вспоминаю: мы в ночном клубе. Уже скорее рано!"

# ch/hanna/events.rpy:5216
translate russian hanna_birthday_date_male_a270a6d3:
    mike.say "Видела, сколько времени, Ханна?"

# ch/hanna/events.rpy:5217
translate russian hanna_birthday_date_male_b9e63f58:
    mike.say "Нас отсюда скоро выгонят!"

# ch/hanna/events.rpy:5220
translate russian hanna_birthday_date_male_bd34d24c:
    hanna.say "Ого!"

# ch/hanna/events.rpy:5222
translate russian hanna_birthday_date_male_622a2c26:
    hanna.say "Я совсем потеряла счёт времени!"

# ch/hanna/events.rpy:5224
translate russian hanna_birthday_date_male_30e74fc5:
    mike.say "Эм..."

# ch/hanna/events.rpy:5225
translate russian hanna_birthday_date_male_6acb7236:
    mike.say "Ну что... домой?"

# ch/hanna/events.rpy:5226
translate russian hanna_birthday_date_male_3c910878:
    mike.say "Или у тебя ещё остались силы?"

# ch/hanna/events.rpy:5231
translate russian hanna_birthday_date_male_e56e4e3f:
    "Она энергично кивает."

# ch/hanna/events.rpy:5235
translate russian hanna_birthday_date_male_97b769e3:
    hanna.say "Ещё немного осталось."

# ch/hanna/events.rpy:5237
translate russian hanna_birthday_date_male_5dc59b04:
    hanna.say "А у тебя?"

# ch/hanna/events.rpy:5238
translate russian hanna_birthday_date_male_094ae650:
    mike.say "Я бы продержался ещё чуть-чуть."

# ch/hanna/events.rpy:5239
translate russian hanna_birthday_date_male_1f7ba09b:
    mike.say "Но куда пойдём в такое время?"

# ch/hanna/events.rpy:5241
translate russian hanna_birthday_date_male_4490c039:
    "Ханна ненадолго задумывается."

# ch/hanna/events.rpy:5245
translate russian hanna_birthday_date_male_cb8fd213:
    "Потом улыбается и кивает."

# ch/hanna/events.rpy:5247
translate russian hanna_birthday_date_male_1276f10e:
    hanna.say "Не волнуйся, [lssb_hanna.hero_name()]..."

# ch/hanna/events.rpy:5249
translate russian hanna_birthday_date_male_e1f3fc37:
    hanna.say "Я знаю одно место."

# ch/hanna/events.rpy:5251
translate russian hanna_birthday_date_male_1ecd1784:
    hanna.say "Пойдём, покажу."

# ch/hanna/events.rpy:5257
translate russian hanna_birthday_date_male_e04bb86f:
    "В ответ она весьма внушительно зевает."

# ch/hanna/events.rpy:5258
translate russian hanna_birthday_date_male_c1ba0753:
    "Хотя мне хочется думать, что это напоказ."

# ch/hanna/events.rpy:5261
translate russian hanna_birthday_date_male_78f19383:
    hanna.say "Не-а..."

# ch/hanna/events.rpy:5263
translate russian hanna_birthday_date_male_f4ddcebb:
    hanna.say "Я совсем вымоталась!"

# ch/hanna/events.rpy:5264
translate russian hanna_birthday_date_male_a9482597:
    hanna.say "Если не посплю, завтра на работе буду как зомби!"

# ch/hanna/events.rpy:5266
translate russian hanna_birthday_date_male_b46f73d4:
    mike.say "Ладно, Ханна..."

# ch/hanna/events.rpy:5267
translate russian hanna_birthday_date_male_9973b6e0:
    mike.say "Попробуем поймать такси."

# ch/hanna/events.rpy:5268
translate russian hanna_birthday_date_male_cee79b66:
    "Я бы, наверное, продержался ещё немного."

# ch/hanna/events.rpy:5269
translate russian hanna_birthday_date_male_3ea84bdd:
    "Но лучше довольствоваться тем, что есть, и закончить вечер."

# ch/hanna/events.rpy:5280
translate russian hanna_birthday_sex_4a873f8c:
    "Я немало удивляюсь, когда Ханна тащит меня обратно в спортзал."

# ch/hanna/events.rpy:5281
translate russian hanna_birthday_sex_b95265f7:
    "Настолько, что нахожу слова лишь после того, как она отпирает дверь и затягивает меня внутрь."

# ch/hanna/events.rpy:5282
translate russian hanna_birthday_sex_5319dfd1:
    "Пока она запирает за нами двери, я наконец озвучиваю своё недоумение."

# ch/hanna/events.rpy:5283
translate russian hanna_birthday_sex_75e9974f:
    mike.say "Ты серьёзно, Ханна?"

# ch/hanna/events.rpy:5284
translate russian hanna_birthday_sex_bccf0f61:
    mike.say "Хочешь пошалить здесь?"

# ch/hanna/events.rpy:5285
translate russian hanna_birthday_sex_3c993be7:
    mike.say "На работе?!"

# ch/hanna/events.rpy:5287
translate russian hanna_birthday_sex_34b94669:
    "Она поворачивается ко мне, уже с готовностью кивая."

# ch/hanna/events.rpy:5288
translate russian hanna_birthday_sex_1c1f2e43:
    hanna.say "А почему бы и нет, [lssb_hanna.hero_name()]?"

# ch/hanna/events.rpy:5289
translate russian hanna_birthday_sex_67ed30f5:
    hanna.say "Рядом, и ключи у меня."

# ch/hanna/events.rpy:5290
translate russian hanna_birthday_sex_913145d8:
    hanna.say "К тому же до утра здесь никого."

# ch/hanna/events.rpy:5291
translate russian hanna_birthday_sex_6b3ddad3:
    hanna.say "По-моему, идеально."

# ch/hanna/events.rpy:5292
translate russian hanna_birthday_sex_3c07acbd:
    mike.say "А как же камеры?"

# ch/hanna/events.rpy:5293
translate russian hanna_birthday_sex_b6c446ac:
    mike.say "Я знаю, у вас есть видеонаблюдение."

# ch/hanna/events.rpy:5295
translate russian hanna_birthday_sex_bce7ba17:
    hanna.say "Да, есть."

# ch/hanna/events.rpy:5296
translate russian hanna_birthday_sex_98a2a86f:
    hanna.say "Но кто, по-твоему, смотрит записи?"

# ch/hanna/events.rpy:5298
translate russian hanna_birthday_sex_18f686c6:
    hanna.say "Только я."

# ch/hanna/events.rpy:5299
translate russian hanna_birthday_sex_abdfb849:
    mike.say "И ты их сотрёшь, да?"

# ch/hanna/events.rpy:5300
translate russian hanna_birthday_sex_61931db8:
    hanna.say "Ни о чём не волнуйся, [lssb_hanna.hero_name()]."

# ch/hanna/events.rpy:5301
translate russian hanna_birthday_sex_3bfe56cc:
    hanna.say "Я всё улажу."

# ch/hanna/events.rpy:5302
translate russian hanna_birthday_sex_7f10c0e4:
    "Я киваю, надеясь, что правильно понял её слова."

# ch/hanna/events.rpy:5303
translate russian hanna_birthday_sex_ced442f8:
    "И убеждаю себя, что просто слишком осторожничаю."

# ch/hanna/events.rpy:5304
translate russian hanna_birthday_sex_a599ba38:
    "Наверное, Ханна привела меня сюда только потому, что удобно."

# ch/hanna/events.rpy:5305
translate russian hanna_birthday_sex_5011f71b:
    "И захочет заняться этим где-нибудь в кабинете."

# ch/hanna/events.rpy:5306
translate russian hanna_birthday_sex_30c2b9ed:
    "Где камеры, возможно, вообще нет."

# ch/hanna/events.rpy:5307
translate russian hanna_birthday_sex_91a64565:
    hanna.say "Ну же, [lssb_hanna.hero_name()]..."

# ch/hanna/events.rpy:5308
translate russian hanna_birthday_sex_509104bc:
    hanna.say "Чего мы ждём?"

# ch/hanna/events.rpy:5309
translate russian hanna_birthday_sex_7cedbfa0:
    "Она снова берёт меня за руку и тянет следом."

# ch/hanna/events.rpy:5310
translate russian hanna_birthday_sex_aa8d8228:
