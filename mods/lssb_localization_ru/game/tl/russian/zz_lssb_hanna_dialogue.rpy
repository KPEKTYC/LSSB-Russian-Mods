# ch/hanna/gift.rpy:223
translate russian hanna_gift_collar_male_ff5b8af0:
    "Если я не возьму себя и ситуацию под контроль, всё очень скоро пойдёт наперекосяк."

# ch/hanna/gift.rpy:224
translate russian hanna_gift_collar_male_34cf9ff8:
    mike.say "Дело в том, Ханна, что за последнее время я, кажется, неплохо тебя узнал."

# ch/hanna/gift.rpy:225
translate russian hanna_gift_collar_male_fc256145:
    mike.say "Достаточно хорошо, чтобы понять, чего ты на самом деле хочешь от наших отношений."

# ch/hanna/gift.rpy:226
translate russian hanna_gift_collar_male_402f1465:
    mike.say "Может быть, даже то, о чём ты сама пока не догадываешься..."

# ch/hanna/gift.rpy:227
translate russian hanna_gift_collar_male_1ec48ff1:
    "Ханна искоса смотрит на меня с лёгким недоумением."

# ch/hanna/gift.rpy:228
translate russian hanna_gift_collar_male_25505f11:
    "Но раз не перебивает, я считаю, что она хочет услышать продолжение."

# ch/hanna/gift.rpy:229
translate russian hanna_gift_collar_male_e0436021:
    "Я уже сжимаю ошейник в руке, нервно теребя его в кармане."

# ch/hanna/gift.rpy:230
translate russian hanna_gift_collar_male_85806084:
    "Приходится по-настоящему собрать волю в кулак, чтобы достать его и впервые показать Ханне."

# ch/hanna/gift.rpy:231
translate russian hanna_gift_collar_male_a11cf1d6:
    mike.say "И думаю, Ханна, одно из твоих желаний — приковывать к себе внимание, где бы ты ни появлялась."

# ch/hanna/gift.rpy:232
translate russian hanna_gift_collar_male_35ce1e4a:
    mike.say "Тебе нравится, когда на тебя смотрят. А с этим все взгляды будут устремлены на тебя, уж поверь..."

# ch/hanna/gift.rpy:233
translate russian hanna_gift_collar_male_4ff92437:
    "Я поднимаю ошейник, чтобы она разглядела его и не приняла за обычное украшение."

# ch/hanna/gift.rpy:234
translate russian hanna_gift_collar_male_61ef5c41:
    "Кожа ошейника насыщенного королевского синего цвета, на ней закреплена серебристая пластинка."

# ch/hanna/gift.rpy:235
translate russian hanna_gift_collar_male_36777ad4:
    "На ней выгравировано слово «Сочная»."

# ch/hanna/gift.rpy:236
translate russian hanna_gift_collar_male_ea19d2d2:
    "Поначалу Ханна лишь беззвучно шевелит губами. Её глаза расширяются, когда она осознаёт, что я ей предлагаю."

# ch/hanna/gift.rpy:237
translate russian hanna_gift_collar_male_8f7f01c8:
    "Она смотрит на меня, затем быстро переводит взгляд на ошейник."

# ch/hanna/gift.rpy:238
translate russian hanna_gift_collar_male_cdcb0b2d:
    "И наконец обретает дар речи."

# ch/hanna/gift.rpy:243
translate russian hanna_gift_collar_male_4dfe5269:
    hanna.say "Ох, [lssb_hanna.hero_name()]... о нет... нет..."

# ch/hanna/gift.rpy:244
translate russian hanna_gift_collar_male_5223f0a9:
    "Пока я протягиваю ей ошейник, Ханна начинает качать головой."

# ch/hanna/gift.rpy:245
translate russian hanna_gift_collar_male_97b287d5:
    "Она отводит его в сторону — не грубо, а словно не в силах даже видеть его у меня в руках."

# ch/hanna/gift.rpy:246
translate russian hanna_gift_collar_male_56625320:
    mike.say "Ханна... я думал..."

# ch/hanna/gift.rpy:247
translate russian hanna_gift_collar_male_5e664310:
    "Как бы я ни пытался объясниться, она не смотрит мне в глаза."

# ch/hanna/gift.rpy:248
translate russian hanna_gift_collar_male_c31bb059:
    "Сначала отворачивается, затем поворачивается ко мне спиной."

# ch/hanna/gift.rpy:249
translate russian hanna_gift_collar_male_e3c54774:
    "Я и опомниться не успеваю, как она снова убегает размеренным шагом."

# ch/hanna/gift.rpy:250
translate russian hanna_gift_collar_male_d86a8ed3:
    mike.say "Ханна... подожди!"

# ch/hanna/gift.rpy:251
translate russian hanna_gift_collar_male_65cd6b74:
    "Она не оборачивается и ничего не говорит, лишь отмахивается и ускоряет бег."

# ch/hanna/gift.rpy:252
translate russian hanna_gift_collar_male_7909dba4:
    "Через мгновение я остаюсь один, мучительно осознавая, как сильно облажался."

# ch/hanna/gift.rpy:256
translate russian hanna_gift_collar_male_d88e57a8:
    hanna.say "Чт... что это?"

# ch/hanna/gift.rpy:257
translate russian hanna_gift_collar_male_09b7c122:
    hanna.say "Похоже на... собачий ошейник!"

# ch/hanna/gift.rpy:258
translate russian hanna_gift_collar_male_3ca32cfc:
    "По её лицу я вижу, что она скорее заинтригована, чем оскорблена."

# ch/hanna/gift.rpy:259
translate russian hanna_gift_collar_male_68d3aa59:
    "А раз не отвергает идею сразу, у меня ещё есть пространство для манёвра."

# ch/hanna/gift.rpy:260
translate russian hanna_gift_collar_male_6764f05f:
    mike.say "Да, Ханна, он похож на собачий ошейник."

# ch/hanna/gift.rpy:261
translate russian hanna_gift_collar_male_6873dba9:
    mike.say "Но он твоего размера... и я хочу, чтобы ты его носила."

# ch/hanna/gift.rpy:262
translate russian hanna_gift_collar_male_feae51bc:
    "Она нервно облизывает губы, не сводя глаз с ошейника в моей руке."

# ch/hanna/gift.rpy:263
translate russian hanna_gift_collar_male_b2fe151c:
    hanna.say "Ты хочешь, чтобы я, что, изображала твою собаку?"

# ch/hanna/gift.rpy:264
translate russian hanna_gift_collar_male_556a9545:
    "Я неопределённо мычу и покачиваю головой из стороны в сторону."

# ch/hanna/gift.rpy:265
translate russian hanna_gift_collar_male_9ec0af81:
    mike.say "Не то чтобы я хотел, чтобы ты притворялась собакой, Ханна."

# ch/hanna/gift.rpy:266
translate russian hanna_gift_collar_male_b7e515ea:
    mike.say "Скорее хочу показывать тебя всем как настоящий образец превосходной породы."

# ch/hanna/gift.rpy:267
translate russian hanna_gift_collar_male_9faf5347:
    hanna.say "Ты хочешь... показывать меня всем?"

# ch/hanna/gift.rpy:268
translate russian hanna_gift_collar_male_84f1daf6:
    mike.say "Хочу выгуливать тебя, как люди выгуливают своих дорогих собак."

# ch/hanna/gift.rpy:269
translate russian hanna_gift_collar_male_d0c39b4d:
    mike.say "Наслаждаясь тем, что все оборачиваются им вслед."

# ch/hanna/gift.rpy:270
translate russian hanna_gift_collar_male_786424ac:
    "Ханна скрещивает руки на груди и прикусывает губу, обдумывая мои слова."

# ch/hanna/gift.rpy:271
translate russian hanna_gift_collar_male_24347ed8:
    mike.say "Представь все эти взгляды, Ханна. Люди не смогут оторвать глаз, пока ты не скроешься из виду..."

# ch/hanna/gift.rpy:272
translate russian hanna_gift_collar_male_3ce362b2:
    mike.say "Тебе больше не придётся притворяться, будто ты не хочешь, чтобы на тебя смотрели."

# ch/hanna/gift.rpy:273
translate russian hanna_gift_collar_male_f370dbf4:
    mike.say "Можно просто купаться во внимании и оставлять их жаждать большего."

# ch/hanna/gift.rpy:274
translate russian hanna_gift_collar_male_335e3609:
    "Медленно, очень медленно Ханна осторожно протягивает руку и забирает у меня ошейник."

# ch/hanna/gift.rpy:275
translate russian hanna_gift_collar_male_ebae8c6a:
    "Несколько раз переворачивает его, поглядывая на меня."

# ch/hanna/gift.rpy:276
translate russian hanna_gift_collar_male_af1920e2:
    "Наконец подносит к шее и поворачивается, чтобы я застегнул ремешок."

# ch/hanna/gift.rpy:280
translate russian hanna_gift_collar_male_3252264e:
    "Когда ошейник надет, она поворачивается ко мне лицом. Щёки пылают румянцем."

# ch/hanna/gift.rpy:281
translate russian hanna_gift_collar_male_ddd7752a:
    hanna.say "Как я выгляжу, [lssb_hanna.hero_name()]?"

# ch/hanna/gift.rpy:282
translate russian hanna_gift_collar_male_1cfd80fa:
    "Я слегка неодобрительно качаю головой."

# ch/hanna/gift.rpy:283
translate russian hanna_gift_collar_male_07f27377:
    mike.say "Ты только что позволила мне надеть на тебя ошейник, Ханна."

# ch/hanna/gift.rpy:284
translate russian hanna_gift_collar_male_f6e4f680:
    mike.say "Пора привыкать называть меня господином."

# ch/hanna/gift.rpy:285
translate russian hanna_gift_collar_male_d879b13f:
    "Она охотно кивает."

# ch/hanna/gift.rpy:286
translate russian hanna_gift_collar_male_d64bd261:
    hanna.say "Да... господин!"

# ch/hanna/gift.rpy:293
translate russian hanna_gift_butt_plug_male_57d752f5:
    hanna.say "Ой, [lssb_hanna.hero_name()], это мне?"

# ch/hanna/gift.rpy:294
translate russian hanna_gift_butt_plug_male_1a19f559:
    "Она разворачивает анальную пробку."

# ch/hanna/gift.rpy:297
translate russian hanna_gift_butt_plug_male_2338efd9:
    hanna.say "..."

# ch/hanna/gift.rpy:298
translate russian hanna_gift_butt_plug_male_e13084bb:
    hanna.say "Оставь себе... Мне не нужно, так что забирай."

# ch/hanna/gift.rpy:299
translate russian hanna_gift_butt_plug_male_5e50bce3:
    hanna.say "Уверена, ты найдёшь этому лучшее применение, чем я."

# ch/hanna/gift.rpy:303
translate russian hanna_gift_butt_plug_male_01c758b8:
    hanna.say "Просто идеально!"

# ch/hanna/gift.rpy:305
translate russian hanna_gift_butt_plug_male_ff90eb9a:
    hanna.say "Спасибо, [lssb_hanna.hero_name()]. Я найду ей хорошее применение."

# ch/hanna/reactions.rpy:2
translate russian hanna_ice_cream_reaction_male_6321a1eb:
    mike.say "Нужно освежиться, Ханна. Пойдём купим мороженого!"

# ch/hanna/reactions.rpy:3
translate russian hanna_ice_cream_reaction_male_645d7b50:
    hanna.say "Да, отличная идея!"

# ch/hanna/reactions.rpy:4
translate russian hanna_ice_cream_reaction_male_73a4ddd7:
    "У киоска с мороженым я покупаю рожок с парой разных шариков."

# ch/hanna/reactions.rpy:5
translate russian hanna_ice_cream_reaction_male_892ffc18:
    "Она выбирает то же самое, но с другим сочетанием вкусов."

# ch/hanna/reactions.rpy:6
translate russian hanna_ice_cream_reaction_male_598112f9:
    hanna.say "Обожаю мороженое... но..."

# ch/hanna/reactions.rpy:7
translate russian hanna_ice_cream_reaction_male_d4a0cd84:
    hanna.say "Уф... чёрт... ну-ка сюда!"

# ch/hanna/reactions.rpy:8
translate russian hanna_ice_cream_reaction_male_5a4da279:
    "Когда Ханна пытается лизнуть мороженое, один шарик выскальзывает из рожка."

# ch/hanna/reactions.rpy:9
translate russian hanna_ice_cream_reaction_male_57ea45dc:
    "Он стекает по её руке, а она отчаянно пытается слизнуть его."

# ch/hanna/reactions.rpy:10
translate russian hanna_ice_cream_reaction_male_508d61bf:
    "Я не могу отвести глаз: это выглядит так двусмысленно."

# ch/hanna/reactions.rpy:11
translate russian hanna_ice_cream_reaction_male_a078ca97:
    "И могу думать лишь о том, как Ханна орудует языком в куда более интимной обстановке!"

# ch/hanna/reactions.rpy:15
translate russian hanna_ask_phone_male_70120823:
    mike.say "Дашь свой номер, Ханна?"

# ch/hanna/reactions.rpy:16
translate russian hanna_ask_phone_male_c94b6df7:
    mike.say "У меня есть только номер спортзала!"

# ch/hanna/reactions.rpy:20
translate russian hanna_ask_phone_male_b53c3951:
    hanna.say "Что?!"

# ch/hanna/reactions.rpy:21
translate russian hanna_ask_phone_male_e17d2cfb:
    hanna.say "У тебя его нет?"

# ch/hanna/reactions.rpy:23
translate russian hanna_ask_phone_male_8cdedd50:
    hanna.say "Ну, это мы быстро исправим!"

# ch/hanna/reactions.rpy:28
translate russian hanna_ask_phone_male_d5f8477a:
    hanna.say "Пока хватит и номера спортзала, [lssb_hanna.hero_name()]."

# ch/hanna/reactions.rpy:29
translate russian hanna_ask_phone_male_1e457fa7:
    hanna.say "Просто попроси на стойке регистрации передать мне сообщение."

# ch/hanna/reactions.rpy:33
translate russian hanna_ask_birthday_male_1a984ec9:
    mike.say "А твой день рождения, Ханна?"

# ch/hanna/reactions.rpy:34
translate russian hanna_ask_birthday_male_f8c5e018:
    mike.say "Напомни, когда он?"

# ch/hanna/reactions.rpy:38
translate russian hanna_ask_birthday_male_2f42555c:
    hanna.say "А?!"

# ch/hanna/reactions.rpy:40
translate russian hanna_ask_birthday_male_7244fb37:
    hanna.say "Не могу поверить, что ещё тебе не сказала!"

# ch/hanna/reactions.rpy:42
translate russian hanna_ask_birthday_male_294099cd:
    hanna.say "Тридцатого дня осени."

# ch/hanna/reactions.rpy:47
translate russian hanna_ask_birthday_male_d6af8f37:
    hanna.say "Эй!"

# ch/hanna/reactions.rpy:48
translate russian hanna_ask_birthday_male_c204303b:
    hanna.say "Я так хорошо выгляжу не только благодаря тренировкам."

# ch/hanna/reactions.rpy:49
translate russian hanna_ask_birthday_male_afeb3418:
    hanna.say "И возраст свой я тоже не скрываю!"

# ch/hanna/reactions.rpy:53
translate russian hanna_offer_a_drink_male_1e886204:
    mike.say "Хочешь выпить, Ханна?"

# ch/hanna/reactions.rpy:54
translate russian hanna_offer_a_drink_male_ddf7f91f:
    mike.say "Я иду к бару, могу и тебе что-нибудь взять."

# ch/hanna/reactions.rpy:55
translate russian hanna_offer_a_drink_male_176e89df:
    "Едва я заканчиваю фразу, Ханна поворачивается ко мне."

# ch/hanna/reactions.rpy:59
translate russian hanna_offer_a_drink_male_6a565115:
    hanna.say "Алкоголь, [lssb_hanna.hero_name()]?"

# ch/hanna/reactions.rpy:60
translate russian hanna_offer_a_drink_male_36e2ac9d:
    hanna.say "Серьёзно?!"

# ch/hanna/reactions.rpy:61
translate russian hanna_offer_a_drink_male_36811d01:
    hanna.say "Об этом ребёнке забочусь только я?"

# ch/hanna/reactions.rpy:66
translate russian hanna_offer_a_drink_male_aaa8fba0:
    hanna.say "Конечно, [lssb_hanna.hero_name()]."

# ch/hanna/reactions.rpy:67
translate russian hanna_offer_a_drink_male_d5547cb4:
    hanna.say "Мне лёгкого пива."

# ch/hanna/reactions.rpy:68
translate russian hanna_offer_a_drink_male_7361650e:
    hanna.say "И спасибо, что подумал обо мне!"

# ch/hanna/reactions.rpy:80
translate russian hanna_offer_a_drink_male_7d05d594:
    hanna.say "Уф..."

# ch/hanna/reactions.rpy:81
translate russian hanna_offer_a_drink_male_64634e11:
    hanna.say "Нет, [lssb_hanna.hero_name()], не хочу."

# ch/hanna/reactions.rpy:82
translate russian hanna_offer_a_drink_male_f905ac6d:
    hanna.say "Ты же знаешь, в этом месяце я слежу за здоровьем!"

# ch/hanna/reactions.rpy:88
translate russian hanna_slap_ass_intro_male_497a2ada:
    "Сегодня я никак не могу оторвать глаз от попки Ханны."

# ch/hanna/reactions.rpy:89
translate russian hanna_slap_ass_intro_male_154a4405:
    "При ходьбе она выглядит такой подтянутой и упругой."

# ch/hanna/reactions.rpy:90
translate russian hanna_slap_ass_intro_male_3f4d143f:
    "Настоящая живая реклама спортзала, где она работает."

# ch/hanna/reactions.rpy:91
translate russian hanna_slap_ass_intro_male_3b684ba1:
    "Я просто не могу удержаться от игривого шлепка!"

# ch/hanna/reactions.rpy:95
translate russian hanna_slap_ass_happy_male_2ef96c6b:
    hanna.say "Ого..."

# ch/hanna/reactions.rpy:96
translate russian hanna_slap_ass_happy_male_23754d16:
    hanna.say "[lssb_hanna.hero_name()]..."

# ch/hanna/reactions.rpy:97
translate russian hanna_slap_ass_happy_male_02ec9ff7:
    hanna.say "Ты сейчас сделал то, о чём я думаю?!"

# ch/hanna/reactions.rpy:98
translate russian hanna_slap_ass_happy_male_d385a596:
    "От её вопроса я слегка краснею."

# ch/hanna/reactions.rpy:99
translate russian hanna_slap_ass_happy_male_fa3f816a:
    "Но всё же заставляю себя кивнуть."

# ch/hanna/reactions.rpy:100
translate russian hanna_slap_ass_happy_male_59446aee:
    hanna.say "Ах ты негодник!"

# ch/hanna/reactions.rpy:101
translate russian hanna_slap_ass_happy_male_01b03e71:
    hanna.say "Но всё-таки..."

# ch/hanna/reactions.rpy:102
translate russian hanna_slap_ass_happy_male_23eaea17:
    hanna.say "Спасибо за комплимент!"

# ch/hanna/reactions.rpy:106
translate russian hanna_slap_ass_angry_male_2ef96c6b:
    hanna.say "Ого..."

# ch/hanna/reactions.rpy:107
translate russian hanna_slap_ass_angry_male_23754d16:
    hanna.say "[lssb_hanna.hero_name()]..."

# ch/hanna/reactions.rpy:108
translate russian hanna_slap_ass_angry_male_02ec9ff7:
    hanna.say "Ты сейчас сделал то, о чём я думаю?!"

# ch/hanna/reactions.rpy:109
translate russian hanna_slap_ass_angry_male_d385a596:
    "От её вопроса я слегка краснею."

# ch/hanna/reactions.rpy:110
translate russian hanna_slap_ass_angry_male_fa3f816a:
    "Но всё же заставляю себя кивнуть."

# ch/hanna/reactions.rpy:111
translate russian hanna_slap_ass_angry_male_7d05d594:
    hanna.say "Уф..."

# ch/hanna/reactions.rpy:112
translate russian hanna_slap_ass_angry_male_58458a86:
    hanna.say "Не могу поверить, что ты так поступил!"

# ch/hanna/reactions.rpy:113
