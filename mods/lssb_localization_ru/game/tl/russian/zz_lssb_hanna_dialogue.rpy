translate russian hanna_bye_f7138c66:
    hanna.say "Мне, пожалуй, пора спать."

# ch/hanna/base.rpy:28
translate russian hanna_bye_d61d85c3:
    hanna.say "Пойду в ванную. Только попробуй подглядывать!"

# ch/hanna/base.rpy:30
translate russian hanna_bye_96e492fa:
    hanna.say "У меня сейчас занятия, пора идти."

# ch/hanna/base.rpy:32
translate russian hanna_bye_b9e8095e:
    hanna.say "Как же я проголодалась..."

# ch/hanna/base.rpy:34
translate russian hanna_bye_da0cb83e:
    hanna.say "Не знаешь, что сейчас по телевизору?"

# ch/hanna/base.rpy:36
translate russian hanna_bye_d5f08774:
    hanna.say "Пойду в паб, пропущу стаканчик. Увидимся."

# ch/hanna/base.rpy:38
translate russian hanna_bye_9a9b5d27:
    hanna.say "Сегодня солнечно, пожалуй, пойду позагораю."

# ch/hanna/base.rpy:40
translate russian hanna_bye_5d3b65bf:
    hanna.say "Хочется пройтись по магазинам."

# ch/hanna/base.rpy:42
translate russian hanna_bye_8ebd1a3f:
    hanna.say "Пойду почитаю. Начала одну отличную книгу."

# ch/hanna/base.rpy:44
translate russian hanna_bye_150bf190:
    hanna.say "Пойду в клуб, хочется повеселиться."

# ch/hanna/base.rpy:46
translate russian hanna_bye_250d7f47:
    hanna.say "Мне бы немного попотеть. До встречи."

# ch/hanna/base.rpy:48
translate russian hanna_bye_ced935ab:
    hanna.say "Пойду оденусь."

# ch/hanna/base.rpy:56
translate russian hanna_cheated_2e2ddfda:
    hanna.say "Ты ничего не забыл?"

# ch/hanna/base.rpy:58
translate russian hanna_cheated_bce9bf10:
    "И Ханна без предупреждения целует меня."

# ch/hanna/base.rpy:65
