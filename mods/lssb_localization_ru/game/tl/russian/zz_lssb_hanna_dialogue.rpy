    mike.say "Привет."

# ch/hanna/base.rpy:113
translate russian hanna_greet_dialogues_male_323d1ecb:
    mike.say "Привет, Ханна."

# ch/hanna/base.rpy:115
translate russian hanna_greet_dialogues_male_f90e27db:
    mike.say "Доброе утро, Ханна."

# ch/hanna/base.rpy:117
