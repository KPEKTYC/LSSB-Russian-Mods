    hanna.say "О боже..."

# ch/hanna/events.rpy:3050
translate russian hanna_event_10_ffe9db75:
    hanna.say "Твой... твой член стал больше?"

# ch/hanna/events.rpy:3051
translate russian hanna_event_10_4f748153:
    hanna.say "Клянусь, в прошлый раз ты так меня не заполнял!"

# ch/hanna/events.rpy:3054
translate russian hanna_event_10_bda66ef5:
