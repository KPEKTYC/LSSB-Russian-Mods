# ch/hanna/events.rpy:3024
translate russian hanna_event_10_d18b9499:
    hanna.say "Ну же, [lssb_hanna.hero_name()]."

# ch/hanna/events.rpy:3025
translate russian hanna_event_10_599b50be:
    hanna.say "Чего ты ждёшь?"

# ch/hanna/events.rpy:3026
