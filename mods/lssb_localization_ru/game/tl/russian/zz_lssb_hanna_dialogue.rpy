# ch/hanna/events.rpy:5350
translate russian hanna_birthday_sex_0746ece3:
    "Ханна буквально держит всё в своих руках."

# ch/hanna/events.rpy:5351
translate russian hanna_birthday_sex_ea8fffdc:
