# ch/hanna/events.rpy:618
translate russian hanna_event_02_4249c651:
    "Даже если бы я хотел сблизиться с ней, едва ли стоит начинать, пока она на работе и от неё зависит мой доступ в зал."

# ch/hanna/events.rpy:619
translate russian hanna_event_02_13a8b827:
    "Намекая, что знаю её секрет, я, пожалуй, перегибаю палку."

# ch/hanna/events.rpy:622
translate russian hanna_event_02_79756fcd:
    mike.say "Знаешь..."

# ch/hanna/events.rpy:623
translate russian hanna_event_02_a8fc5aea:
    mike.say "Я заметил, как ты на днях меня разглядывала..."

# ch/hanna/events.rpy:625
translate russian hanna_event_02_637adf73:
    "Её глаза тут же начинают бегать."

# ch/hanna/events.rpy:627
translate russian hanna_event_02_2ae06fa5:
    hanna.say "А, что? О чём ты?"

# ch/hanna/events.rpy:631
translate russian hanna_event_02_5293daa8:
    mike.say "Ну, когда была на беговой дорожке."

# ch/hanna/events.rpy:636
translate russian hanna_event_02_0c2654c4:
    "Ханна сжимает пальцы и шумно выдыхает."

# ch/hanna/events.rpy:638
translate russian hanna_event_02_9fb7efa1:
    hanna.say "Я... что делала?"

# ch/hanna/events.rpy:640
translate russian hanna_event_02_b012b2df:
    mike.say "Ты ведь украдкой поглядывала на меня, да?"

# ch/hanna/events.rpy:642
translate russian hanna_event_02_2e62131c:
    "Она на секунду отводит взгляд и чешет щёку."

# ch/hanna/events.rpy:644
translate russian hanna_event_02_200deed1:
    hanna.say "Мне... не положено пялиться на клиентов."

# ch/hanna/events.rpy:645
translate russian hanna_event_02_57d09851:
    mike.say "Но ты пялилась. И мне понравилось."

# ch/hanna/events.rpy:647
translate russian hanna_event_02_ffb6d8d5:
    "Она немного молчит, убирая руки от компьютера и кладя их на колени."

# ch/hanna/events.rpy:650
translate russian hanna_event_02_5184abb1:
    hanna.say "Мне... мне правда нужно поработать."

# ch/hanna/events.rpy:652
translate russian hanna_event_02_3498d042:
    "Раз мы наконец заговорили лицом к лицу, возможно, удастся получить от неё ответы."

# ch/hanna/events.rpy:653
translate russian hanna_event_02_79756fcd_1:
    mike.say "Знаешь..."

# ch/hanna/events.rpy:654
translate russian hanna_event_02_dc59af9e:
    mike.say "Я уже некоторое время хочу с тобой поговорить."

# ch/hanna/events.rpy:656
translate russian hanna_event_02_6f208418:
    hanna.say "О... о чём?"

# ch/hanna/events.rpy:658
translate russian hanna_event_02_90e2d345:
    "Спрашивает она, но по тому, как кусает губу, ясно: она прекрасно знает, что я сейчас скажу."

# ch/hanna/events.rpy:660
translate russian hanna_event_02_bd1acc62:
    mike.say "Сначала я не понял, что ты делаешь. Подумал, заблудилась и зашла не в ту раздевалку."

# ch/hanna/events.rpy:663
translate russian hanna_event_02_03ae19c4:
    "Она ёрзает на стуле, крепко обхватив ладонями колени."

# ch/hanna/events.rpy:664
translate russian hanna_event_02_5c72fa97:
    mike.say "А потом услышал, как ты выкрикиваешь моё имя. Это тоже было довольно странно."

# ch/hanna/events.rpy:665
translate russian hanna_event_02_066849d6:
    mike.say "Но теперь, когда я знаю, что ты здесь РАБОТАЕШЬ, всё начинает сходиться."

# ch/hanna/events.rpy:667
translate russian hanna_event_02_4290474e:
    "Она смотрит на меня, красная как свёкла, с приоткрытыми губами."

# ch/hanna/events.rpy:669
translate russian hanna_event_02_e88fd876:
    hanna.say "А-а... ха..."

# ch/hanna/events.rpy:673
translate russian hanna_event_02_7d3f85b3:
    mike.say "А ты лежала на скамейке, нюхала мои вещи и ласкала себя пальцами."

# ch/hanna/events.rpy:674
translate russian hanna_event_02_6f9edfb0:
    "Я говорю непринуждённо, наблюдая, как она ёрзает. И соврал бы, сказав, что мне это совсем не нравится."

# ch/hanna/events.rpy:679
translate russian hanna_event_02_9a6e9c7c:
    "Я наклоняюсь ближе через стойку."

# ch/hanna/events.rpy:680
translate russian hanna_event_02_f5c99715:
    mike.say "Просто не мог удержаться и смотрел на тебя."

# ch/hanna/events.rpy:682
translate russian hanna_event_02_1a251fd2:
    "Продолжаю я, усмехаясь, когда она чуть отодвигается."

# ch/hanna/events.rpy:684
translate russian hanna_event_02_a5e44a50:
    hanna.say "Я... прости."

# ch/hanna/events.rpy:686
translate russian hanna_event_02_471f7cdd:
    mike.say "Говорю же, не надо. Давно не видел ничего более возбуждающего."

# ch/hanna/events.rpy:688
translate russian hanna_event_02_2ce512a2:
    "У неё перехватывает дыхание, и извинения замирают на губах."

# ch/hanna/events.rpy:689
translate russian hanna_event_02_9045e10f:
    mike.say "Не нужно."

# ch/hanna/events.rpy:690
translate russian hanna_event_02_0a819ce9:
    mike.say "Пойду тренироваться. Приятной работы. Ещё увидимся."

# ch/hanna/events.rpy:694
translate russian hanna_event_02_6428d123:
    "Я поворачиваюсь, чтобы уйти."

# ch/hanna/events.rpy:695
translate russian hanna_event_02_8558fe75:
    hanna.say "Подожди!"

# ch/hanna/events.rpy:699
translate russian hanna_event_02_9b255422:
    "Останавливаюсь и оборачиваюсь. Она сцепила ладони, сама удивившись, как громко крикнула."

# ch/hanna/events.rpy:701
translate russian hanna_event_02_e6d21bd6:
    hanna.say "Давай..."

# ch/hanna/events.rpy:703
translate russian hanna_event_02_35cdeec2:
    hanna.say "Давай поговорим об этом, когда я закончу работать. Вот..."

# ch/hanna/events.rpy:706
translate russian hanna_event_02_399aa507:
    "Она что-то быстро записывает и протягивает мне стикер."

# ch/hanna/events.rpy:708
translate russian hanna_event_02_fc194cae:
    hanna.say "Мой номер."

# ch/hanna/events.rpy:709
translate russian hanna_event_02_5657c5ba:
    hanna.say "Позвони, когда захочешь поговорить."

# ch/hanna/events.rpy:714
translate russian hanna_event_02_ab9712c0:
    "Я улыбаюсь и машу ей. Может, тренировка сегодня подождёт?"

# ch/hanna/events.rpy:726
translate russian hanna_event_03_9e283c2f:
    "После долгой тренировки, вытирая лоб, я замечаю, как пристально Ханна на меня смотрит."

# ch/hanna/events.rpy:728
translate russian hanna_event_03_de720c41:
    "Таким оценивающим взглядом она осматривала бы новый тренажёр, изучая каждую деталь."

# ch/hanna/events.rpy:730
translate russian hanna_event_03_79ba41ec:
    hanna.say "Неплохо, [lssb_hanna.hero_name()]. Сегодня ты действительно поработал. Я вижу."

# ch/hanna/events.rpy:732
translate russian hanna_event_03_9fab911b:
    mike.say "Из твоих уст это высокая похвала."

# ch/hanna/events.rpy:734
translate russian hanna_event_03_fd2b949b:
    hanna.say "[lssb_hanna.hero_name()], не хочешь помыться?"

# ch/hanna/events.rpy:736
translate russian hanna_event_03_8c3cd13a:
    mike.say "Хех, а я думал, тебе нравится быть грязной."

# ch/hanna/events.rpy:740
translate russian hanna_event_03_72cc309a:
    "Она усмехается, разворачивается и направляется к женской раздевалке."

# ch/hanna/events.rpy:742
translate russian hanna_event_03_508b58a7:
    hanna.say "Только не засиживайся там. Жалко будет зря смывать такой хороший пот."

# ch/hanna/events.rpy:743
translate russian hanna_event_03_4d334b43:
    hanna.say "Ладно, тогда до встречи!"

# ch/hanna/events.rpy:745
translate russian hanna_event_03_a689e891:
    "Я пожимаю плечами и иду в раздевалку."

# ch/hanna/events.rpy:748
translate russian hanna_event_03_cf10fd5c:
    "Но что-то было в её тоне. Будто она уже точно знала, где я окажусь."

# ch/hanna/events.rpy:751
translate russian hanna_event_03_6d75f5b9:
    "Там раздеваюсь и встаю под душ."

# ch/hanna/events.rpy:752
translate russian hanna_event_03_19525db9:
    "В спортзале мёртвая тишина: только я и стук воды по плитке."

# ch/hanna/events.rpy:753
translate russian hanna_event_03_71afd543:
    "Нет ничего лучше душа после хорошей тренировки!"

# ch/hanna/events.rpy:754
translate russian hanna_event_03_b234051c:
    "Тепло расслабляет каждую мышцу, которую я мучил на тренажёрах, и я на секунду закрываю глаза под струями."

# ch/hanna/events.rpy:756
translate russian hanna_event_03_1111b65f:
    "Мысли, конечно же, возвращаются к тому, как Ханна на меня смотрела."

# ch/hanna/events.rpy:760
translate russian hanna_event_03_edc671a4:
    "Пока вода стекает по мне, шторка резко отодвигается. За ней стоит Ханна, прикусив губу, всё ещё в белой спортивной одежде."

# ch/hanna/events.rpy:762
translate russian hanna_event_03_532b4ae7:
    hanna.say "Привет, [lssb_hanna.hero_name()]. Не против, если присоединюсь?"

# ch/hanna/events.rpy:764
translate russian hanna_event_03_4b7ef02f:
    "Её взгляд бесстыдно скользит по моему телу, жадно изучая каждый сантиметр."

# ch/hanna/events.rpy:766
translate russian hanna_event_03_3362e3e4:
    mike.say "Ханна, это мужской душ."

# ch/hanna/events.rpy:768
translate russian hanna_event_03_a68de862:
    hanna.say "Я никогда не любила правила, [lssb_hanna.hero_name()]. Ты уже должен был заметить."

# ch/hanna/events.rpy:771
translate russian hanna_event_03_a90c3714:
    mike.say "Х... Ханна?! Я просто принимаю душ! Что ты делаешь?"

# ch/hanna/events.rpy:774
translate russian hanna_event_03_fb61f53f:
    hanna.say "Ч... что? Ой, прости, чёрт! Блядь!"

# ch/hanna/events.rpy:778
translate russian hanna_event_03_0cc7bf18:
    "Она резко задёргивает шторку и выбегает, красная как свёкла."

# ch/hanna/events.rpy:779
translate russian hanna_event_03_161b536c:
    "Кажется, я облажался."

# ch/hanna/events.rpy:783
translate russian hanna_event_03_393fd07d:
    "Я отступаю и приглашаю Ханну внутрь."

# ch/hanna/events.rpy:785
translate russian hanna_event_03_3a1a4ad7:
    "Получив желаемое, она не колеблется и даже не краснеет."

# ch/hanna/events.rpy:787
translate russian hanna_event_03_ad557fc9:
    "Медленно входит и прижимается ко мне, выдыхая, пока вода собирается у неё на груди."

# ch/hanna/events.rpy:789
translate russian hanna_event_03_21e6501e:
    "Каждый упругий изгиб её тела плотно прижат ко мне — тёплый и скользкий под струями."

# ch/hanna/events.rpy:791
translate russian hanna_event_03_4cfe33f8:
    hanna.say "Я мечтала об этом с самого первого повторения."

# ch/hanna/events.rpy:793
translate russian hanna_event_03_98a52877:
    mike.say "Ты так давно об этом думаешь?"

# ch/hanna/events.rpy:795
translate russian hanna_event_03_4736d478:
    hanna.say "С самого первого, [lssb_hanna.hero_name()]. Девушки замечают такие вещи."

# ch/hanna/events.rpy:797
translate russian hanna_event_03_8d1d78fd:
    "Вскоре она начинает скользить вниз вдоль моего тела, проводя майкой по моей груди."

# ch/hanna/events.rpy:801
translate russian hanna_event_03_7caf839c:
    "Вода льётся между её грудями и поверх них; белая ткань тяжелеет, становится прозрачной и липнет к телу."

# ch/hanna/events.rpy:802
translate russian hanna_event_03_da33c9b2:
    "Будто на ней ничего нет, только намного, намного горячее!"

# ch/hanna/events.rpy:803
translate russian hanna_event_03_49b1da7d:
    "Она смотрит на меня сквозь струи воды, не переставая самоуверенно улыбаться."

# ch/hanna/events.rpy:804
translate russian hanna_event_03_2b908b65:
    "Её груди скользят вниз по моему члену."

# ch/hanna/events.rpy:806
translate russian hanna_event_03_9e2ebac5:
    "Он выскальзывает между ними, уже полностью готовый к вниманию."

# ch/hanna/events.rpy:807
translate russian hanna_event_03_fd6a4db8:
    hanna.say "М-м-м. Вот он. Кто-то правильно питается."

# ch/hanna/events.rpy:808
translate russian hanna_event_03_91d69f6f:
    "Вода стекает по её лицу, а она смотрит на меня снизу вверх полуприкрытыми, полными желания глазами."

# ch/hanna/events.rpy:809
translate russian hanna_event_03_d4a70493:
    hanna.say "Ну, [lssb_hanna.hero_name()], посмотрим, так ли хороша твоя выносливость, как физическая форма."

# ch/hanna/events.rpy:810
translate russian hanna_event_03_f6f7120d:
    "Она наклоняется, обдавая мою кожу горячим дыханием."

# ch/hanna/events.rpy:813
translate russian hanna_event_03_3fd37835:
    "В её глазах настоящий голод, пока она разглядывает мой член."

# ch/hanna/events.rpy:814
translate russian hanna_event_03_03027364:
    "Она мычит, заглушая шум воды стоном, и переносит ладони с моих бёдер на свою грудь."

# ch/hanna/events.rpy:815
translate russian hanna_event_03_c27c7492:
    "Сжимает груди вокруг меня, усиливая трение, совершенно в своей стихии."

# ch/hanna/events.rpy:817
translate russian hanna_event_03_ad9f954d:
    "Губы обхватывают головку, и она начинает двигаться вдоль члена, не сводя с меня глаз — ищет одобрения, жаждет доставить мне удовольствие."

# ch/hanna/events.rpy:818
translate russian hanna_event_03_c5d4a851:
    "Мокрая ткань обволакивает член. Честно говоря, ничего подобного я раньше не чувствовал."

# ch/hanna/events.rpy:819
translate russian hanna_event_03_4ade192e:
    "Она задаёт медленный, размеренный ритм, будто мысленно считает повторения."

# ch/hanna/events.rpy:822
translate russian hanna_event_03_62147186:
    "Мягкость груди смешивается с шероховатой, липнущей тканью майки."

# ch/hanna/events.rpy:823
translate russian hanna_event_03_1cf0db8b:
    "Я морщусь, когда ткань цепляет кожу, а она смеётся и отстраняется."

# ch/hanna/events.rpy:824
translate russian hanna_event_03_1dc9da20:
    hanna.say "Ха-ха... да, глупая идея."

# ch/hanna/events.rpy:826
translate russian hanna_event_03_b3b1e177:
    "Покраснев, она стягивает майку через голову."

# ch/hanna/events.rpy:828
translate russian hanna_event_03_171d1778:
    "Как любой нормальный мужчина, я пользуюсь случаем и просовываю член между её грудями, пока он не появляется сверху."

# ch/hanna/events.rpy:832
translate russian hanna_event_03_a1784e8e:
    "Теперь она словно носит мой член на себе. Снова обхватывает его губами, за всё это время ни разу не отведя взгляда."

# ch/hanna/events.rpy:833
translate russian hanna_event_03_c4c8ae24:
    "Поразительно, как долго она не моргает, даже под душем."

# ch/hanna/events.rpy:834
translate russian hanna_event_03_cd0e47d9:
    "Подходит к этому как к упражнению: челюсть собрана, взгляд неподвижен, дыхание через нос идеально выверено."

# ch/hanna/events.rpy:835
translate russian hanna_event_03_a475ef19:
    "Теперь, когда член обхватывает её большая красивая грудь и липкая майка не мешает, я смелею и толкаюсь вперёд."

# ch/hanna/events.rpy:836
translate russian hanna_event_03_645f33c9:
    "Она стонет от внезапного напора, но справляется как чемпионка, снова и снова двигая головой с упорством, доступным лишь фанатке фитнеса."

# ch/hanna/events.rpy:837
translate russian hanna_event_03_6bf7a19a:
    "Продолжает делать повторения грудью, будто я какой-то снаряд."

# ch/hanna/events.rpy:838
translate russian hanna_event_03_d6b05134:
    hanna.say "Вот так... дожимай. На последнем подходе не халтурят."

# ch/hanna/events.rpy:839
translate russian hanna_event_03_c0d173b6:
    "Она бормочет это с моим членом во рту, то поддразнивая, то искренне подбадривая."

# ch/hanna/events.rpy:840
translate russian hanna_event_03_dd4e9986:
    "Её тело и правда получает хорошую нагрузку, пока язык скользит под головкой и вдоль боков члена."

# ch/hanna/events.rpy:841
translate russian hanna_event_03_6c50fdae:
    "Даже отличный спортсмен не выдержит вечно. Как бегун, слишком резво стартовавший, я тоже выдыхаюсь."

# ch/hanna/events.rpy:842
translate russian hanna_event_03_5c9c6f2a:
    "Всё тело напрягается: знакомый пик накатывает быстрее, чем я успеваю сопротивляться."

# ch/hanna/events.rpy:851
translate russian hanna_event_03_cf0c6d4c:
    "Я оттягиваю её назад и кончаю ей на лицо."

# ch/hanna/events.rpy:854
translate russian hanna_event_03_84d67909:
    "Ханна громко, сладострастно стонет, пока сперма смешивается с водой, льющейся ей на лицо."

# ch/hanna/events.rpy:855
translate russian hanna_event_03_f16ad707:
    "Скоро всё смоется, но сперва она успевает провести ладонями по щекам и вздрогнуть."

# ch/hanna/events.rpy:857
translate russian hanna_event_03_23cd7eba:
    hanna.say "Тёплая... Боже, как приятно жжёт."

# ch/hanna/events.rpy:858
translate russian hanna_event_03_e69b5259:
    hanna.say "А-а, ничто не сравнится с признаками хорошей тренировки."

# ch/hanna/events.rpy:859
translate russian hanna_event_03_925d779c:
    hanna.say "Тело потеет... мышцы ноют, веки тяжелеют, а член извергает сперму."

# ch/hanna/events.rpy:860
translate russian hanna_event_03_ba7c4145:
    hanna.say "Чудесно, правда? На что способно тело."

# ch/hanna/events.rpy:861
translate russian hanna_event_03_0c1f562b:
    "Она проводит большим пальцем по щеке и, ухмыляясь, облизывает его, будто это просто ещё один вид протеина."

# ch/hanna/events.rpy:862
translate russian hanna_event_03_25c41d70:
    "Я усмехаюсь и со вздохом прислоняюсь к стенке душа."

# ch/hanna/events.rpy:864
translate russian hanna_event_03_e9b0f26a:
    mike.say "Да, чудесно. Но иди сюда. Теперь и тебе самой нужно помыться."

# ch/hanna/events.rpy:867
translate russian hanna_event_03_6aa87458:
    "Ханна вскакивает, обнимает меня и прижимается грудью."

# ch/hanna/events.rpy:869
translate russian hanna_event_03_b3e6cf88:
    "Немного трётся об меня, позволяя воде ещё поструиться по нашим телам, и наконец отстраняется."

# ch/hanna/events.rpy:871
translate russian hanna_event_03_be36ff99:
    "При всей её браваде в том, как она сейчас льнёт ко мне, есть что-то нежное."

# ch/hanna/events.rpy:873
translate russian hanna_event_03_3c502e28:
    hanna.say "Ладно, помоешь мне спину, [lssb_hanna.hero_name()]?"

# ch/hanna/events.rpy:875
translate russian hanna_event_03_c600b17a:
    "С радостью беру мыло."

# ch/hanna/events.rpy:886
translate russian hanna_event_04_f52a1200:
    "Итак, я бегаю уже пару месяцев и отношусь к этому всё серьёзнее."

# ch/hanna/events.rpy:887
translate russian hanna_event_04_6113dc02:
    "Сразу уточню: я не стесняюсь, а раннее утро выбираю лишь потому, что тогда тише."

# ch/hanna/events.rpy:888
translate russian hanna_event_04_dc6a2405:
    "Ну... может, чуточку и стесняюсь. Совсем немного!"

# ch/hanna/events.rpy:889
translate russian hanna_event_04_e2f945c3:
    "Раньше я всегда насмехался над самодовольными типами, бегающими в обтягивающей синтетике."

# ch/hanna/events.rpy:890
translate russian hanna_event_04_ea9424a1:
    "Но я не молодею, а это дешёвый и простой способ размяться без похода в спортзал."

# ch/hanna/events.rpy:891
translate russian hanna_event_04_8e7cbdf4:
    "Просто не хотел, чтобы кто-то узнал, пока сам окончательно не освоюсь. Только и всего."

# ch/hanna/events.rpy:892
translate russian hanna_event_04_4433f3a4:
    "Может, я знаю мало любителей бега, а может, они живут слишком далеко от моего парка."

# ch/hanna/events.rpy:893
translate russian hanna_event_04_21843f42:
    "Как бы то ни было, всё шло прекрасно: знакомых на пробежках я не встречал."

# ch/hanna/events.rpy:895
translate russian hanna_event_04_b88e3854:
    "До одного утра, когда я успел пробежать всего пару сотен метров по привычному маршруту."

# ch/hanna/events.rpy:896
translate russian hanna_event_04_f9b451e0:
    hanna.say "[lssb_hanna.hero_name()]... эй... [lssb_hanna.hero_name()]!"

# ch/hanna/events.rpy:897
translate russian hanna_event_04_8c31a810:
    "Я в наушниках, слушаю какой-то подкаст."

# ch/hanna/events.rpy:898
translate russian hanna_event_04_6eeea004:
    "Поэтому замечаю Ханну лишь тогда, когда она буквально выскакивает передо мной."

# ch/hanna/events.rpy:901
translate russian hanna_event_04_dd7c2a59:
    mike.say "А-а... блядь!"

# ch/hanna/events.rpy:903
translate russian hanna_event_04_ba0aea26:
    hanna.say "Эй, не обделайся, [lssb_hanna.hero_name()]!"

# ch/hanna/events.rpy:905
translate russian hanna_event_04_d393345f:
    "Вытаскиваю наушники, стараясь сделать вид, что сердце колотится только от бега."

# ch/hanna/events.rpy:906
translate russian hanna_event_04_d4db8dd9:
    mike.say "Господи, Ханна!"

# ch/hanna/events.rpy:907
translate russian hanna_event_04_f517140b:
    mike.say "Не делай так..."

# ch/hanna/events.rpy:909
translate russian hanna_event_04_ef7736b7:
    "В ответ Ханна хихикает, будто не способна воспринимать мои слова всерьёз."

# ch/hanna/events.rpy:910
translate russian hanna_event_04_0cfdbb5a:
    "Иногда я забываю, что у неё есть эта раздражающая привычка многих спортсменов."

# ch/hanna/events.rpy:911
translate russian hanna_event_04_b292e468:
    "Абсолютная неспособность отличить чужое раздражение от весёлой перепалки."

# ch/hanna/events.rpy:913
translate russian hanna_event_04_0832f0d8:
    "Но тут я что-то подозреваю и прищуриваюсь."

# ch/hanna/events.rpy:914
translate russian hanna_event_04_fd4cdf3f:
    mike.say "Погоди-ка, а ты что здесь делаешь?"

# ch/hanna/events.rpy:916
translate russian hanna_event_04_11e65dc3:
    hanna.say "А на что похоже?"

# ch/hanna/events.rpy:930
translate russian hanna_event_04_64876433:
    "Ханна демонстративно обегает меня тесным кругом."

# ch/hanna/events.rpy:931
translate russian hanna_event_04_ca3ba507:
    "Я медленно поворачиваюсь вслед за ней."

# ch/hanna/events.rpy:932
translate russian hanna_event_04_88d0e7bf:
    "Лишь через несколько секунд замечаю, что она тоже одета для пробежки."

# ch/hanna/events.rpy:934
translate russian hanna_event_04_e9bf930f:
    "Просто я настолько привык видеть её в спортивной одежде..."

# ch/hanna/events.rpy:936
translate russian hanna_event_04_c5804898:
    "Что порой действительно трудно понять, чем именно она сейчас занимается."

# ch/hanna/events.rpy:938
translate russian hanna_event_04_9f5596bb:
    mike.say "Не знал, что ты бегаешь здесь, Ханна."

# ch/hanna/events.rpy:939
translate russian hanna_event_04_d0ca549b:
    mike.say "Никогда тебя не видел."

# ch/hanna/events.rpy:941
translate russian hanna_event_04_46a3a8f9:
    "Ханна пожимает плечами, качает головой и улыбается."

# ch/hanna/events.rpy:943
translate russian hanna_event_04_ae9e6e16:
    hanna.say "Не видел? [lssb_hanna.hero_name()], я прямо мимо тебя пробегала."

# ch/hanna/events.rpy:944
translate russian hanna_event_04_8de2629b:
    hanna.say "Дважды. Оба раза у тебя эти штуки торчали из ушей."

# ch/hanna/events.rpy:948
translate russian hanna_event_04_26638909:
    "Подчёркивая свои слова, она легонько бьёт меня по руке."

# ch/hanna/events.rpy:949
translate russian hanna_event_04_7b1b61d4:
    "Стараюсь не обращать внимания ни на этот жест, ни на то, что оказалось больнее, чем я ожидал."

# ch/hanna/events.rpy:951
translate russian hanna_event_04_8ec53ff9:
    mike.say "А если серьёзно: ты случайно не переехала в мой район?"

# ch/hanna/events.rpy:953
translate russian hanna_event_04_d6ea60ef:
    hanna.say "Нет, просто все маршруты возле дома надоели."

# ch/hanna/events.rpy:955
translate russian hanna_event_04_72b03ff2:
    hanna.say "Вот я и села в машину, чтобы поискать новые."

# ch/hanna/events.rpy:957
translate russian hanna_event_04_22e80f0f:
    hanna.say "А встреча с тобой — приятный бонус."

# ch/hanna/events.rpy:959
translate russian hanna_event_04_fd560679:
    mike.say "Эм... бонус?"

# ch/hanna/events.rpy:961
translate russian hanna_event_04_160f4042:
    hanna.say "Конечно, бонус, [lssb_hanna.hero_name()]."

# ch/hanna/events.rpy:962
translate russian hanna_event_04_7a88c059:
    hanna.say "Теперь ты можешь составить мне компанию на пробежке!"

# ch/hanna/events.rpy:964
translate russian hanna_event_04_1b880313:
    mike.say "Ну... наверное..."

# ch/hanna/events.rpy:968
translate russian hanna_event_04_5f36cb1b:
    hanna.say "Но не думай, что я буду поддаваться только потому, что мы друзья!"

# ch/hanna/events.rpy:972
translate russian hanna_event_04_a82f5568:
    "С этими словами она срывается с места, смеясь и оглядываясь на меня."

# ch/hanna/events.rpy:975
translate russian hanna_event_04_89078fce:
    "Я не раздумывая бросаюсь следом, стараясь догнать."

# ch/hanna/events.rpy:976
translate russian hanna_event_04_095dd504:
    "Знаю, глупо позволять ей так меня задевать."

# ch/hanna/events.rpy:977
translate russian hanna_event_04_c4c9ff86:
    "Но есть что-то в этой её потребности всегда быть в центре внимания и во всём лучше остальных."

# ch/hanna/events.rpy:978
translate russian hanna_event_04_262e4831:
    "Даже в лучшие дни от этого остаётся лишь обречённо качать головой."

# ch/hanna/events.rpy:979
translate russian hanna_event_04_6ef242ed:
    "Когда она просто ищет внимания и одобрения, это бывает мило, даже трогательно."

# ch/hanna/events.rpy:980
translate russian hanna_event_04_40039d29:
    "Но сюда я прихожу утром побыть один, прежде чем встретиться с дневными заботами."

# ch/hanna/events.rpy:981
translate russian hanna_event_04_e5fc8725:
    "Кем она себя возомнила, вот так вторгаясь в мою жизнь?"

# ch/hanna/events.rpy:982
translate russian hanna_event_04_33be6fe8:
    "Догоняя Ханну, я стараюсь помнить две вещи."

# ch/hanna/events.rpy:983
translate russian hanna_event_04_adbebed6:
    "Во-первых, она ужасно любит красоваться и сделает всё, чтобы я не сводил с неё глаз."

# ch/hanna/events.rpy:985
translate russian hanna_event_04_f8aee04a:
    "Во-вторых, при всей её отличной форме этот парк я знаю гораздо лучше..."

# ch/hanna/events.rpy:986
translate russian hanna_event_04_6e663fd9:
    "Начинаю неспешно, позволяя Ханне думать, будто она меня уже раскусила."

# ch/hanna/events.rpy:987
translate russian hanna_event_04_a30716e5:
    "Почти не отвожу глаз от её тела, наблюдая, как оно покачивается под обтягивающей тканью."

# ch/hanna/events.rpy:988
translate russian hanna_event_04_c98da519:
    "Но разница в том, что маршрут я знаю наизусть."

# ch/hanna/events.rpy:990
translate russian hanna_event_04_b309311a:
    "А значит, могу распределить силы на предстоящий участок, даже не отводя взгляда."

# ch/hanna/events.rpy:991
translate russian hanna_event_04_bea18ad0:
    "Ханна же слишком занята довольными улыбками в ответ на мои взгляды, чтобы заметить что-то подобное."

# ch/hanna/events.rpy:992
translate russian hanna_event_04_9028679d:
    "И не поймите неправильно: я действительно на неё пялюсь!"

# ch/hanna/events.rpy:994
translate russian hanna_event_04_b77e27e4:
    "Просто сейчас у меня есть ещё и скрытая цель."

# ch/hanna/events.rpy:996
translate russian hanna_event_04_a0f0c00f:
    "Ханна замечает неладное лишь тогда, когда начинает отставать."

# ch/hanna/events.rpy:998
translate russian hanna_event_04_a7d29e8f:
    "Она впечатляюще пытается наверстать упущенное, но уже поздно."

# ch/hanna/events.rpy:1001
translate russian hanna_event_04_5ac73f58:
    "Я заканчиваю маршрут за полминуты до того, как запыхавшаяся Ханна поднимается на холм, где я жду."

# ch/hanna/events.rpy:1003
translate russian hanna_event_04_ef9c849b:
    "Согнувшись пополам и упёршись руками в бёдра, она жадно хватает воздух, пытаясь восстановиться."

# ch/hanna/events.rpy:1005
translate russian hanna_event_04_a73c2198:
    hanna.say "Это было... очень... круто... [lssb_hanna.hero_name()]..."

# ch/hanna/events.rpy:1006
translate russian hanna_event_04_9eba257b:
    hanna.say "Где ты... прятал... такую выносливость?!"

# ch/hanna/events.rpy:1008
translate russian hanna_event_04_0b2a0e56:
    "Я небрежно пожимаю плечами, стараясь не выглядеть слишком самодовольным засранцем."

# ch/hanna/events.rpy:1009
translate russian hanna_event_04_f69c6611:
    mike.say "Да ничего особенного, Ханна."

# ch/hanna/events.rpy:1010
translate russian hanna_event_04_d84233c9:
    mike.say "Наверное, просто хорошо знаю это место."

# ch/hanna/events.rpy:1011
translate russian hanna_event_04_0f8939ad:
    mike.say "Всё-таки бегаю здесь почти каждое утро..."

# ch/hanna/events.rpy:1013
translate russian hanna_event_04_b5f954ef:
    "К этому времени Ханна уже выпрямилась и почти отдышалась."

# ch/hanna/events.rpy:1015
translate russian hanna_event_04_1f2f5862:
    hanna.say "Ну... конечно, [lssb_hanna.hero_name()]."

# ch/hanna/events.rpy:1017
translate russian hanna_event_04_9cb501a9:
    hanna.say "Интересно, на что ещё тебе хватает такой выносливости..."

# ch/hanna/events.rpy:1030
translate russian hanna_event_05_fd15166f:
    "Обычно я предпочитаю тренироваться один, если не считать музыки в наушниках."

# ch/hanna/events.rpy:1031
translate russian hanna_event_05_24642466:
    "В современной жизни столько суеты и стресса, что нужно хотя бы ненадолго разгрузить голову."

# ch/hanna/events.rpy:1032
translate russian hanna_event_05_6d167f02:
    "Тренировка — не совсем отдых, но порой отвлечься от одной нагрузки можно лишь с помощью другой."

# ch/hanna/events.rpy:1034
translate russian hanna_event_05_177be790:
    "Поэтому сегодня мне кажется странным, что, выйдя из раздевалки, я обнаруживаю ждущую меня Ханну."

# ch/hanna/events.rpy:1038
translate russian hanna_event_05_3261c1f9:
    mike.say "А... привет, Ханна."

# ch/hanna/events.rpy:1039
translate russian hanna_event_05_44f5865a:
    mike.say "Кого-то ждёшь?"

# ch/hanna/events.rpy:1040
translate russian hanna_event_05_005541e9:
    mike.say "Нового клиента на индивидуальную тренировку?"

# ch/hanna/events.rpy:1042
translate russian hanna_event_05_cdc25d90:
    "Ханна качает головой, отвергая мои догадки."

# ch/hanna/events.rpy:1044
translate russian hanna_event_05_22640c27:
    hanna.say "Нет, сегодня нет."

# ch/hanna/events.rpy:1045
translate russian hanna_event_05_a635f24f:
    hanna.say "Хотела быстренько пройтись по тренажёрам."

# ch/hanna/events.rpy:1047
translate russian hanna_event_05_8fd4b60a:
    hanna.say "И подумала: может, составишь мне компанию?"

# ch/hanna/events.rpy:1049
translate russian hanna_event_05_aae0d716:
    "Я пожимаю плечами, изображая непринуждённость, хотя на самом деле изрядно насторожился."

# ch/hanna/events.rpy:1050
translate russian hanna_event_05_5bebc069:
    mike.say "Конечно, Ханна."

# ch/hanna/events.rpy:1051
translate russian hanna_event_05_fae6f7fc:
    mike.say "Компания мне не помешает."

# ch/hanna/events.rpy:1053
translate russian hanna_event_05_eeabc8b1:
    "Если Ханна и замечает моё удивление, то отлично это скрывает."

# ch/hanna/events.rpy:1055
translate russian hanna_event_05_fbf352dc:
    "Пусть я кажусь параноиком, но для неё это совсем нетипично."

# ch/hanna/events.rpy:1056
translate russian hanna_event_05_d894bf78:
    "Я прекрасно знаю, что обычно Ханна не тренируется в зале в рабочее время."

# ch/hanna/events.rpy:1057
translate russian hanna_event_05_54a1e6f4:
    "Она постоянно занята занятиями или другими рабочими делами."

# ch/hanna/events.rpy:1059
translate russian hanna_event_05_634846ed:
    "Поэтому трудно поверить, что она просто случайно меня подкараулила."

# ch/hanna/events.rpy:1067
translate russian hanna_event_05_b91eef7f:
    "По дороге к первому тренажёру я стараюсь говорить непринуждённо."

# ch/hanna/events.rpy:1068
translate russian hanna_event_05_2b21f6a5:
    mike.say "Я уже примерно наметил себе программу на сегодня."

# ch/hanna/events.rpy:1069
translate russian hanna_event_05_8cdeb791:
    mike.say "Но могу немного поменять, если у тебя есть пожелания."

# ch/hanna/events.rpy:1071
translate russian hanna_event_05_3b8fd781:
    hanna.say "Нет-нет, всё хорошо."

# ch/hanna/events.rpy:1072
translate russian hanna_event_05_6083d7d4:
    hanna.say "Делай как собирался."

# ch/hanna/events.rpy:1074
translate russian hanna_event_05_452e6605:
    hanna.say "А я пойду за тобой, ладно?"

# ch/hanna/events.rpy:1076
translate russian hanna_event_05_faf9676f:
    "Всё страньше и страньше..."

# ch/hanna/events.rpy:1077
translate russian hanna_event_05_a38ba6a4:
    "Я киваю и начинаю обычную тренировку."

# ch/hanna/events.rpy:1078
translate russian hanna_event_05_ff076712:
    "Но не могу отделаться от мысли, как странно, что Ханна с радостью ходит за мной по залу."

# ch/hanna/events.rpy:1079
translate russian hanna_event_05_07a668cd:
    "Я точно знаю: фитнесом она увлечена куда сильнее меня."

# ch/hanna/events.rpy:1080
translate russian hanna_event_05_2a2caaca:
    "Моя программа должна быть легче даже самой непринуждённой её тренировки."

# ch/hanna/events.rpy:1081
translate russian hanna_event_05_a178a65c:
    "Скорее разминка по сравнению с её нагрузками!"

# ch/hanna/events.rpy:1082
translate russian hanna_event_05_ebbf03bb:
    "Начинаю медленнее обычного, поглядывая на Ханну через плечо."

# ch/hanna/events.rpy:1084
translate russian hanna_event_05_47609e8c:
    "Она улыбается в ответ, занимая соседний тренажёр."

# ch/hanna/events.rpy:1085
translate russian hanna_event_05_8ace0aee:
    "Но я уже вижу, что она намеренно сбавляет темп."

# ch/hanna/events.rpy:1086
translate russian hanna_event_05_a635a314:
    "Остаётся либо совсем остановиться и спросить, что происходит, либо продолжать."

# ch/hanna/events.rpy:1088
translate russian hanna_event_05_5ab05f15:
    "Я качаю головой и пытаюсь погрузиться в привычный ритм упражнений."

# ch/hanna/events.rpy:1090
translate russian hanna_event_05_f0664819:
    "Ненадолго это удаётся, но потом я оборачиваюсь и замечаю, чем занята Ханна."

# ch/hanna/events.rpy:1094
translate russian hanna_event_05_fa43bc04:
    "Ладно... ладно, буду честен."

# ch/hanna/events.rpy:1095
translate russian hanna_event_05_bad83c51:
    "На самом деле я оборачиваюсь, чтобы на неё поглазеть: она ведь занимается на таком же тренажёре."

# ch/hanna/events.rpy:1099
translate russian hanna_event_05_fb07cda5:
    "Я знаю, как он заставляет двигаться тело."

# ch/hanna/events.rpy:1103
translate russian hanna_event_05_36b497fe:
    "И хочу посмотреть, как это будет выглядеть у Ханны."

# ch/hanna/events.rpy:1106
translate russian hanna_event_05_a20cefa7:
    "..."

# ch/hanna/events.rpy:1109
translate russian hanna_event_05_daaa9394:
    "И тут понимаю: она делает ровно то же самое со мной!" with hpunch

# ch/hanna/events.rpy:1116
translate russian hanna_event_05_2c8c9b39:
    "Конечно, едва я поворачиваюсь, она отводит взгляд."

# ch/hanna/events.rpy:1118
translate russian hanna_event_05_d6c62c65:
    "Но попытка тут же с головой уйти в тренировку выдаёт её с потрохами."

# ch/hanna/events.rpy:1120
translate russian hanna_event_05_19555fe5:
    "Поначалу я не знаю, как ко всему этому относиться."

# ch/hanna/events.rpy:1121
translate russian hanna_event_05_187dfccf:
    "Сам-то я частенько заглядывался на девушек в спортзале."

# ch/hanna/events.rpy:1122
translate russian hanna_event_05_7ea99251:
    "И всегда гадал, смотрит ли кто-нибудь так же на меня."

# ch/hanna/events.rpy:1123
translate russian hanna_event_05_0edb3b11:
    "Но теперь, когда я точно знаю, что это происходит прямо сейчас, немного теряюсь!"

# ch/hanna/events.rpy:1127
translate russian hanna_event_05_ddc7eb67:
    "Одно я знаю точно: прерывать тренировку и жаловаться Ханне не стану."

# ch/hanna/events.rpy:1128
translate russian hanna_event_05_68aae493:
    "Чувствовал бы себя лицемером, а выглядел ханжой!"

# ch/hanna/events.rpy:1129
translate russian hanna_event_05_11a79167:
    "Наверное, мне должно льстить такое внимание."

# ch/hanna/events.rpy:1130
translate russian hanna_event_05_9a0f1087:
    "В конце концов, я и сам любуюсь телом Ханны."

# ch/hanna/events.rpy:1131
translate russian hanna_event_05_4bd647e4:
    "Это ведь не случайная незнакомка, которая вдруг начала на меня пялиться."

# ch/hanna/events.rpy:1132
translate russian hanna_event_05_d236fbed:
    "На дворе двадцать первый век. Почему бы девушке не разглядывать парня?"

# ch/hanna/events.rpy:1136
translate russian hanna_event_05_d2fb8a05:
    "С этой мыслью я продолжаю тренировку, стараясь больше об этом не думать."

# ch/hanna/events.rpy:1137
translate russian hanna_event_05_3d3e94f5:
    "Удерживаюсь от соблазна устроить Ханне ещё более впечатляющее представление."

# ch/hanna/events.rpy:1138
translate russian hanna_event_05_1daa9b33:
    "Я ведь не танцор, ждущий купюр за резинкой шорт."

# ch/hanna/events.rpy:1140
translate russian hanna_event_05_67dc5347:
    "А если слишком стараться, она поймёт, что я обо всём догадался."

# ch/hanna/events.rpy:1143
translate russian hanna_event_05_8d97fddf:
    "После тренировки стараюсь говорить так, будто ничего не заметил."

# ch/hanna/events.rpy:1144
translate russian hanna_event_05_aa2d6800:
    mike.say "Ну как тебе, Ханна?"

# ch/hanna/events.rpy:1145
translate russian hanna_event_05_1d1a340d:
    mike.say "Нашла в моей программе что-нибудь интересное?"

# ch/hanna/events.rpy:1147
translate russian hanna_event_05_e0925663:
    "Она кивает, будто понимая вопрос буквально."

# ch/hanna/events.rpy:1149
translate russian hanna_event_05_0ce047f1:
    hanna.say "О да, [lssb_hanna.hero_name()]."

# ch/hanna/events.rpy:1150
translate russian hanna_event_05_d91e0a9e:
    hanna.say "Даже нашлось кое-что, на что хочется посмотреть ещё."

# ch/hanna/events.rpy:1152
translate russian hanna_event_05_42d55254:
    hanna.say "Может, покажешь на индивидуальном занятии?"

# ch/hanna/events.rpy:1158
translate russian hanna_event_05_6e528ca6:
    "С этими словами она уходит, оставляя меня гадать, что именно имела в виду..."

# ch/hanna/events.rpy:1169
translate russian hanna_event_06_eeda8a0d:
    mike.say "Ханна... что с тобой?"

# ch/hanna/events.rpy:1170
translate russian hanna_event_06_efff3cdd:
    mike.say "Выглядишь так, будто весь мир держишь на плечах."

# ch/hanna/events.rpy:1172
translate russian hanna_event_06_98a58759:
    "Ханна тихонько шмыгает носом, поднимает глаза и с явным усилием выдавливает улыбку."

# ch/hanna/events.rpy:1174
translate russian hanna_event_06_fa541e91:
    hanna.say "О, [lssb_hanna.hero_name()]..."

# ch/hanna/events.rpy:1178
translate russian hanna_event_06_68e640a8:
    hanna.say "Прости, наверное, я ужасно выгляжу!"

# ch/hanna/events.rpy:1180
translate russian hanna_event_06_79f67cb7:
    "Качаю головой и улыбаюсь в ответ, давая понять, что извиняться не за что."

# ch/hanna/events.rpy:1181
translate russian hanna_event_06_d504e482:
    mike.say "Нет... нет, просто немного устала, вот и всё."

# ch/hanna/events.rpy:1183
translate russian hanna_event_06_2ee09717:
    "Конечно, я вру."

# ch/hanna/events.rpy:1184
translate russian hanna_event_06_2a299446:
    "Ханна выглядит паршиво, но прямота сейчас ей ничем не поможет."

# ch/hanna/events.rpy:1188
translate russian hanna_event_06_7e3f43b5:
    "Вдруг она качает головой, явно собирая волю в кулак."

# ch/hanna/events.rpy:1190
translate russian hanna_event_06_7486ef37:
    hanna.say "Всё в порядке. Правда."

# ch/hanna/events.rpy:1192
translate russian hanna_event_06_d6a98407:
    hanna.say "Это как раз связано с тем, что довело меня до такого состояния."

# ch/hanna/events.rpy:1194
translate russian hanna_event_06_0035a185:
    "Всё с той же натянутой улыбкой Ханна поспешно вытирает уголки глаз тыльной стороной ладони."

# ch/hanna/events.rpy:1197
translate russian hanna_event_06_a13fc313:
    hanna.say "Ладно, рассказываю!"

# ch/hanna/events.rpy:1199
translate russian hanna_event_06_a9fb43ea:
    "Я киваю, почти затаив дыхание и готовясь услышать очень плохие новости."

# ch/hanna/events.rpy:1201
translate russian hanna_event_06_2057f2a7:
    hanna.say "Дело в спортзале."

# ch/hanna/events.rpy:1204
translate russian hanna_event_06_30d56424:
    "Погоди... что? Она сказала «в спортзале»?"

# ch/hanna/events.rpy:1205
translate russian hanna_event_06_d1d09dd2:
    "Что такого важного ей нужно рассказать о спортзале?"

# ch/hanna/events.rpy:1207
translate russian hanna_event_06_4eab2dbb:
    "И тут меня осеняет..."

# ch/hanna/events.rpy:1208
translate russian hanna_event_06_8c36b2fe:
    mike.say "Ханна, это из-за моего абонемента?"

# ch/hanna/events.rpy:1209
translate russian hanna_event_06_bf9163dd:
    mike.say "Если да, то я был уверен, что всё оплатил!"

# ch/hanna/events.rpy:1210
translate russian hanna_event_06_ad454bce:
    mike.say "Обычно мне присылают письмо или сообщение."

# ch/hanna/events.rpy:1211
translate russian hanna_event_06_a9115f1d:
    mike.say "Никто раньше не просил денег лично!"

# ch/hanna/events.rpy:1215
translate russian hanna_event_06_50e27933:
    "Ханна смотрит на меня с недоверием, затем качает головой."

# ch/hanna/events.rpy:1217
translate russian hanna_event_06_98cfd32b:
    hanna.say "Нет, [lssb_hanna.hero_name()], я не собираюсь обсуждать твой абонемент!"

# ch/hanna/events.rpy:1219
translate russian hanna_event_06_637a95ad:
    "На меня накатывает смесь облегчения и стыда: я совершенно не понял ситуацию."

# ch/hanna/events.rpy:1220
translate russian hanna_event_06_77c17e32:
    mike.say "А... ясно... прости, Ханна."

# ch/hanna/events.rpy:1222
translate russian hanna_event_06_ff4211ad:
    hanna.say "Мне нужно поговорить о самом спортзале."

# ch/hanna/events.rpy:1224
translate russian hanna_event_06_f6dec076:
    hanna.say "Но это непросто, потому что проблема... личная."

# ch/hanna/events.rpy:1226
translate russian hanna_event_06_78af3823:
    mike.say "Я слушаю, Ханна. Что бы ты ни рассказала, ни одна душа об этом не узнает. Обещаю."

# ch/hanna/events.rpy:1230
translate russian hanna_event_06_ee6c943d:
    "Она кивает. Радостнее ей не стало, но продолжить она настроена решительно."

# ch/hanna/events.rpy:1232
translate russian hanna_event_06_878be53a:
    hanna.say "Дело в папе. У него всегда была слабость к азартным играм."

# ch/hanna/events.rpy:1234
translate russian hanna_event_06_fcb5822e:
    hanna.say "Раньше ничего серьёзного: суммы небольшие, и я не обращала внимания."

# ch/hanna/events.rpy:1235
translate russian hanna_event_06_099b55ef:
    hanna.say "Да и точные суммы он от меня всегда скрывал."

# ch/hanna/events.rpy:1237
translate russian hanna_event_06_31b1c113:
    hanna.say "Проблема была очевидна, но мы о ней не говорили, понимаешь?"

# ch/hanna/events.rpy:1239
translate russian hanna_event_06_e4bb5efe:
    "Ох... кажется, я понимаю, к чему всё идёт. Ничем хорошим это не кончится."

# ch/hanna/events.rpy:1241
translate russian hanna_event_06_bff51e65:
    hanna.say "Но в последнее время стало хуже. Ставки всё крупнее, шансы всё безумнее."

# ch/hanna/events.rpy:1243
translate russian hanna_event_06_12e18ce0:
    hanna.say "И на всё это он тайком брал деньги из бизнеса."

# ch/hanna/events.rpy:1245
translate russian hanna_event_06_2d4f28e0:
    mike.say "Господи, Ханна. Насколько всё плохо?"

# ch/hanna/events.rpy:1247
translate russian hanna_event_06_ab9a0fa4:
    hanna.say "Плохо. Залу нужно около пяти тысяч — просто чтобы не закрыться."

# ch/hanna/events.rpy:1250
translate russian hanna_event_06_6ce01869:
    "Я лишь поднимаю брови и шумно выдыхаю от изумления."

# ch/hanna/events.rpy:1251
translate russian hanna_event_06_a3a71215:
    mike.say "Это большие деньги, Ханна!"

# ch/hanna/events.rpy:1253
translate russian hanna_event_06_71631edd:
    hanna.say "Можешь мне не говорить!"

# ch/hanna/events.rpy:1256
translate russian hanna_event_06_e016ac34:
    hanna.say "Что же мне, чёрт возьми, делать?!"

# ch/hanna/events.rpy:1260
translate russian hanna_event_06_6c6c1256:
    mike.say "По-моему, что бы ты ни сделала для спасения бизнеса, это будет лишь временной мерой."

# ch/hanna/events.rpy:1261
translate russian hanna_event_06_570c1d3b:
    mike.say "Тебе не понравится мой совет, Ханна, но лучше сейчас ограничить потери."

# ch/hanna/events.rpy:1264
translate russian hanna_event_06_961a5c63:
    "Когда смысл моих слов доходит до Ханны, на её лице появляется потрясение."

# ch/hanna/events.rpy:1265
translate russian hanna_event_06_6bfde556:
    hanna.say "[lssb_hanna.hero_name()], ты же не предлагаешь..."

# ch/hanna/events.rpy:1267
translate russian hanna_event_06_3167e385:
    mike.say "Да. Я думаю, нужно продать спортзал и расплатиться с долгами."

# ch/hanna/events.rpy:1268
translate russian hanna_event_06_ca1f3d38:
    mike.say "И позаботиться, чтобы отец больше не мог добраться до денег."

# ch/hanna/events.rpy:1273
translate russian hanna_event_06_3739f51e:
    "Ханна качает головой. Слёзы, прежде лишь блестевшие в глазах, снова готовы хлынуть."

# ch/hanna/events.rpy:1275
translate russian hanna_event_06_ddaef666:
    hanna.say "Но, [lssb_hanna.hero_name()], папа создал это место с нуля! Это всё, что у меня есть!"

# ch/hanna/events.rpy:1277
translate russian hanna_event_06_088d3020:
    mike.say "Я понимаю, Ханна. Правда."

# ch/hanna/events.rpy:1278
translate russian hanna_event_06_a97b41be:
    mike.say "Но если так продолжится, ты увидишь, как отец разрушит всё, что построил."

# ch/hanna/events.rpy:1279
translate russian hanna_event_06_3adc633c:
    mike.say "Лучше покончить с этим сейчас и найти для него необходимую помощь, пока не стало слишком поздно."

# ch/hanna/events.rpy:1283
translate russian hanna_event_06_4667cc3d:
    "Она печально кивает, наконец начиная понимать мои доводы."

# ch/hanna/events.rpy:1285
translate russian hanna_event_06_ee46939d:
    hanna.say "Может, ты и прав, [lssb_hanna.hero_name()]."

# ch/hanna/events.rpy:1287
translate russian hanna_event_06_abc6a604:
    hanna.say "Очень больно. Но, может, если изменить его окружение, ему будет легче избавиться от старых привычек?"

# ch/hanna/events.rpy:1290
translate russian hanna_event_06_206cde62:
    "Я киваю, ободряюще улыбаюсь и кладу ладонь поверх её руки."

# ch/hanna/events.rpy:1291
translate russian hanna_event_06_1f296984:
    "Но больше не давлю: я уже дал ей достаточно пищи для размышлений."

# ch/hanna/events.rpy:1295
translate russian hanna_event_06_25d05091:
    mike.say "И теперь ты живёшь на зарплату инструктора, а отец лишь начал приходить в себя."

# ch/hanna/events.rpy:1297
translate russian hanna_event_06_f86438bb:
    mike.say "Ты сказала, пяти тысяч хватит, чтобы зал продолжил работать?"

# ch/hanna/events.rpy:1299
translate russian hanna_event_06_af7e33a1:
    "В глазах Ханны вдруг вспыхивает надежда."

# ch/hanna/events.rpy:1301
translate russian hanna_event_06_a2bb4117:
    hanna.say "Да... да, верно."

# ch/hanna/events.rpy:1302
translate russian hanna_event_06_ccc7f992:
    hanna.say "Этого хватит на счета, и у меня появится необходимая передышка."

# ch/hanna/events.rpy:1304
translate russian hanna_event_06_ad8ef280:
    mike.say "Хм... наверное, я мог бы одолжить тебе такую сумму из накоплений."

# ch/hanna/events.rpy:1305
translate russian hanna_event_06_d5ae4398:
    mike.say "И к возврату долга отнесусь с большим пониманием, чем любой банк."

# ch/hanna/events.rpy:1308
translate russian hanna_event_06_5569624d:
    hanna.say "Правда?"

# ch/hanna/events.rpy:1311
translate russian hanna_event_06_11081c6b:
    hanna.say "Ты сделаешь это ради меня?!"

# ch/hanna/events.rpy:1313
translate russian hanna_event_06_a69a08fc:
    "Тут нужно быть осторожным: сейчас она уязвима и в отчаянии."

# ch/hanna/events.rpy:1314
translate russian hanna_event_06_96be62f4:
    "Слишком легко поддаться её бурной благодарности и наобещать с три короба."

# ch/hanna/events.rpy:1315
translate russian hanna_event_06_dffa9c2b:
    mike.say "Конечно, Ханна. Для чего ещё нужны друзья?"

# ch/hanna/events.rpy:1317
translate russian hanna_event_06_668cd4cf:
    "Я пожимаю плечами, делая вид, будто это пустяки и я постоянно так поступаю."

# ch/hanna/events.rpy:1318
translate russian hanna_event_06_b0d92cae:
    "Но на деле я серьёзно рискую, и никто не гарантирует, что деньги когда-нибудь вернутся."

# ch/hanna/events.rpy:1319
translate russian hanna_event_06_d02e5912:
    "Невольно думаю: предложил бы я такое другу-мужчине, окажись он в похожей беде?"

# ch/hanna/events.rpy:1323
translate russian hanna_event_06_f67dd2c9:
    hanna.say "О, спасибо, спасибо, спасибо!"

# ch/hanna/events.rpy:1326
translate russian hanna_event_06_64e6edc2:
    hanna.say "Ты не пожалеешь, обещаю!"

# ch/hanna/events.rpy:1328
translate russian hanna_event_06_34f1a6c8:
    "Хоть я и улыбаюсь, не могу сказать, что разделяю её оптимизм."

# ch/hanna/events.rpy:1333
translate russian hanna_event_06_ac28c177:
    mike.say "Вообще-то одна идея у меня есть."

# ch/hanna/events.rpy:1334
translate russian hanna_event_06_44e334fc:
    mike.say "Она могла бы оживить бизнес."

# ch/hanna/events.rpy:1335
translate russian hanna_event_06_e2d5ab50:
    mike.say "Но... эм, не уверен, что тебе такое подойдёт..."

# ch/hanna/events.rpy:1338
translate russian hanna_event_06_8556f9eb:
    "Отчаяние в глазах Ханны видно так же ясно, как их голубой цвет."

# ch/hanna/events.rpy:1339
translate russian hanna_event_06_6f3e5301:
    "Она настолько жаждет решения, что готова схватиться за любую соломинку."

# ch/hanna/events.rpy:1340
translate russian hanna_event_06_c4665e67:
    "Нужно лишь действовать осторожно: дать ей заглотить наживку и мягко подтянуть."

# ch/hanna/events.rpy:1342
translate russian hanna_event_06_cf3a4985:
    hanna.say "Нет, серьёзно, что за идея?"

# ch/hanna/events.rpy:1344
translate russian hanna_event_06_cc9a4d98:
    hanna.say "Может, именно свежий взгляд нам и нужен!"

# ch/hanna/events.rpy:1347
translate russian hanna_event_06_de27d18e:
    mike.say "Ладно, ладно."

# ch/hanna/events.rpy:1348
translate russian hanna_event_06_f3de3a96:
    mike.say "У вас ведь спортзал."

# ch/hanna/events.rpy:1349
translate russian hanna_event_06_a3119971:
    mike.say "А спортзал, по сути, продаёт возможность обрести красивое тело, верно?"

# ch/hanna/events.rpy:1352
translate russian hanna_event_06_0b3e7598:
    "Ханна кивает, даже слишком охотно."

# ch/hanna/events.rpy:1353
translate russian hanna_event_06_9b1f8196:
    mike.say "Вот приходишь, например, в автосалон за машиной — товар там выставлен напоказ."

# ch/hanna/events.rpy:1356
translate russian hanna_event_06_ef0cba36:
    "Она снова кивает, но уже выглядит менее уверенно."

# ch/hanna/events.rpy:1357
translate russian hanna_event_06_b12349d5:
    mike.say "Вам нужно то же самое: показывать красивое тело, которое можно получить, тренируясь у вас."

# ch/hanna/events.rpy:1359
translate russian hanna_event_06_0756377f:
    hanna.say "То есть нам нужно..."

# ch/hanna/events.rpy:1361
translate russian hanna_event_06_eb9af495:
    mike.say "Одеть инструкторов так, чтобы были видны их идеальные фигуры."

# ch/hanna/events.rpy:1363
translate russian hanna_event_06_cf8e1753:
    hanna.say "Но, [lssb_hanna.hero_name()], мы и так работаем в лайкре."

# ch/hanna/events.rpy:1365
translate russian hanna_event_06_40f60799:
    hanna.say "А она, поверь, оставляет воображению совсем немного!"

# ch/hanna/events.rpy:1367
translate russian hanna_event_06_416827e8:
    mike.say "Конечно, Ханна, я понимаю."

# ch/hanna/events.rpy:1368
translate russian hanna_event_06_a4ef59af:
    mike.say "Я предлагаю избавиться от лишних рукавов, штанин и всего, что закрывает пресс."

# ch/hanna/events.rpy:1371
translate russian hanna_event_06_2c0540c9:
    hanna.say "Ты предлагаешь носить более откровенную одежду?"

# ch/hanna/events.rpy:1373
translate russian hanna_event_06_80ffc749:
    "Я решительно киваю."

# ch/hanna/events.rpy:1375
translate russian hanna_event_06_00084ccd:
    hanna.say "Но... это не будет непрофессионально? Или даже... не знаю, пошло?"

# ch/hanna/events.rpy:1377
translate russian hanna_event_06_997c1097:
    mike.say "Конечно нет!"

# ch/hanna/events.rpy:1378
translate russian hanna_event_06_4b9ac327:
    mike.say "На дворе двадцать первый век, Ханна. Время свободных взглядов."

# ch/hanna/events.rpy:1379
translate russian hanna_event_06_d9e8736d:
    mike.say "Нужно лишь, чтобы зал шёл в ногу со временем и извлекал из этого пользу!"

# ch/hanna/events.rpy:1382
translate russian hanna_event_06_572ccb7d:
    "Ханна кивает, обдумывая мои слова."

# ch/hanna/events.rpy:1384
translate russian hanna_event_06_6bf5d115:
    "Если повезло, мне удалось склонить её на свою сторону."

# ch/hanna/events.rpy:1385
translate russian hanna_event_06_576b268b:
    "Осталось поддерживать её и проявлять понимание — и наблюдать, как спортзал меняется."

# ch/hanna/events.rpy:1397
translate russian hanna_event_07a_b53ee57d:
    "При следующей встрече с Ханной я ещё пытаюсь привыкнуть к дыре в пять тысяч долларов в своих накоплениях."

# ch/hanna/events.rpy:1400
translate russian hanna_event_07a_8c824f2e:
    "Но стоит увидеть, насколько лучше она выглядит после моего займа, как сомнения в разумности поступка куда-то исчезают."

# ch/hanna/events.rpy:1403
translate russian hanna_event_07a_8550e35d:
    "Ханна просто сияет: спешит ко мне с огромной улыбкой и раскинутыми для объятий руками."

# ch/hanna/events.rpy:1407
translate russian hanna_event_07a_a05b7513:
    "Она обнимает меня совершенно неожиданно, но не скажу, что стал бы сопротивляться, знай я заранее."

# ch/hanna/events.rpy:1408
translate russian hanna_event_07a_e28038b5:
    "Прижавшись к её телу, я словно чувствую энергию, которая снова наполняет Ханну."

# ch/hanna/events.rpy:1410
translate russian hanna_event_07a_e7f921c6:
    "Она обнимает меня около минуты, несколько раз приятно сжимает покрепче, а затем отпускает и легко целует в щёку."

# ch/hanna/events.rpy:1414
translate russian hanna_event_07a_cfbf0908:
    "Может, я и хотел бы большего, но начало определённо положено..."

# ch/hanna/events.rpy:1415
translate russian hanna_event_07a_8c3eac11:
    mike.say "Что ж, судя по этому, дела у тебя идут на лад!"

# ch/hanna/events.rpy:1417
translate russian hanna_event_07a_ef21fd77:
    hanna.say "Ещё как, [lssb_hanna.hero_name()]."

# ch/hanna/events.rpy:1421
translate russian hanna_event_07a_c40cbadb:
    hanna.say "И всё благодаря тебе!"

# ch/hanna/events.rpy:1423
translate russian hanna_event_07a_d040d7c2:
    "Мне так приятно пользоваться её расположением, что я почти забываю причину."

# ch/hanna/events.rpy:1424
translate russian hanna_event_07a_206e1872:
    "Но всё же немного прихожу в себя и вспоминаю кое-какие подробности."

# ch/hanna/events.rpy:1425
translate russian hanna_event_07a_86a83a89:
    mike.say "Значит, деньги помогли расплатиться с самыми насущными долгами?"

# ch/hanna/events.rpy:1427
translate russian hanna_event_07a_0d4372d3:
    "Ханне тоже требуется несколько мгновений, чтобы сосредоточиться, и часть восторга сходит с её лица."

# ch/hanna/events.rpy:1429
translate russian hanna_event_07a_d7a7bb2a:
    "Но паниковать рано: наверное, она просто задумалась."

# ch/hanna/events.rpy:1431
translate russian hanna_event_07a_76af5e44:
    hanna.say "Да, я всё оплатила лично."

# ch/hanna/events.rpy:1432
translate russian hanna_event_07a_ccf4b5e2:
    hanna.say "Папа к твоим деньгам даже не приближался."

# ch/hanna/events.rpy:1434
translate russian hanna_event_07a_fceb7c4c:
    "Меня тут же захлёстывает облегчение. Стараюсь его скрыть, чтобы Ханна не подумала, будто я в ней сомневался."

# ch/hanna/events.rpy:1435
translate russian hanna_event_07a_30921f8f:
    mike.say "А что дальше?"

# ch/hanna/events.rpy:1436
translate russian hanna_event_07a_9fd25f77:
    mike.say "Какой второй шаг в твоём плане?"

# ch/hanna/events.rpy:1438
translate russian hanna_event_07a_144dd642:
    "Ханна выглядит неловко и смущённо, словно вопрос застал её врасплох."

# ch/hanna/events.rpy:1440
translate russian hanna_event_07a_868138ac:
    hanna.say "Эм... думаю, теперь мне самой нужно управлять спортзалом."

# ch/hanna/events.rpy:1442
translate russian hanna_event_07a_83b1f8bc:
    hanna.say "Больше нельзя доверять папе эту сторону бизнеса!"

# ch/hanna/events.rpy:1444
translate russian hanna_event_07a_a70d6826:
    "Неплохо, но могло быть и лучше."

# ch/hanna/events.rpy:1445
translate russian hanna_event_07a_1dc07582:
    "Я-то ожидал, что она уже продумала хоть какой-то план и знает, куда двигаться."

# ch/hanna/events.rpy:1446
translate russian hanna_event_07a_e5d3da20:
    "Начинаю опасаться: не купил ли я невольно долю в обречённом предприятии?"

# ch/hanna/events.rpy:1447
translate russian hanna_event_07a_5812e593:
    "Возможно, Ханне понадобится ещё помощь, иначе с пятью тысячами можно попрощаться."

# ch/hanna/events.rpy:1449
translate russian hanna_event_07a_612845be:
    "Хотя возможность чаще давать ей советы и сделать её ещё более обязанной мне тоже имеет свои плюсы..."

# ch/hanna/events.rpy:1450
translate russian hanna_event_07a_ddc777df:
    mike.say "Чтобы выбраться из этой передряги, тебе нужен бизнес-план, Ханна."

# ch/hanna/events.rpy:1451
translate russian hanna_event_07a_dc8023ab:
    mike.say "Встреться с бухгалтером, пусть введёт тебя в курс всех дел."

# ch/hanna/events.rpy:1455
translate russian hanna_event_07a_e48c6c09:
    "Она кивает так, словно эта мысль ей совершенно в новинку."

# ch/hanna/events.rpy:1457
translate russian hanna_event_07a_96b652b1:
    hanna.say "Думаешь, мне стоит так сделать, [lssb_hanna.hero_name()]?"

# ch/hanna/events.rpy:1459
translate russian hanna_event_07a_7025de8d:
    mike.say "Да, Ханна."

# ch/hanna/events.rpy:1460
translate russian hanna_event_07a_07536b96:
    mike.say "А что с твоим отцом?"

# ch/hanna/events.rpy:1464
translate russian hanna_event_07a_66656ccb:
    hanna.say "А... а что с ним?"

# ch/hanna/events.rpy:1466
translate russian hanna_event_07a_3bf8e36e:
    "Господи, кажется, я начинаю понимать, как они вообще попали в эту ситуацию!"

# ch/hanna/events.rpy:1467
translate russian hanna_event_07a_6df6557b:
    mike.say "Ты помогла ему обратиться к специалисту?"

# ch/hanna/events.rpy:1468
translate russian hanna_event_07a_9aa5d289:
    mike.say "Похоже, у него игровая зависимость, причём серьёзная."

# ch/hanna/events.rpy:1472
translate russian hanna_event_07a_933dab0a:
    "Ханна кивает, будто начиная понимать, к чему я клоню."

# ch/hanna/events.rpy:1474
translate russian hanna_event_07a_7ce51e71:
    hanna.say "А, да. Он обещал пойти в одну из этих групп анонимных игроков."

# ch/hanna/events.rpy:1476
translate russian hanna_event_07a_262a2c1c:
    hanna.say "Чтобы поговорить с другими... другими зависимыми..."

# ch/hanna/events.rpy:1478
translate russian hanna_event_07a_c8c2282e:
    mike.say "Для начала хорошо. Но нужно убедиться, что он сдержит слово, Ханна."

# ch/hanna/events.rpy:1482
translate russian hanna_event_07a_cd543903:
    "Она кивает. Предстоящая задача явно её пугает."

# ch/hanna/events.rpy:1483
translate russian hanna_event_07a_8c04b0b0:
    mike.say "Не волнуйся, я помогу, когда понадоблюсь. Хорошо?"

# ch/hanna/events.rpy:1485
translate russian hanna_event_07a_75fb040b:
    "Это действует: вскоре она снова улыбается, понимая, что может на меня опереться."

# ch/hanna/events.rpy:1487
translate russian hanna_event_07a_169d0951:
    hanna.say "Прости, что всё время сваливаю на тебя свои проблемы, [lssb_hanna.hero_name()]."

# ch/hanna/events.rpy:1489
translate russian hanna_event_07a_a2b0208f:
    hanna.say "Но я правда не знаю, что делала бы без твоей помощи."

# ch/hanna/events.rpy:1491
translate russian hanna_event_07a_d1162235:
    mike.say "Всё хорошо, Ханна."

# ch/hanna/events.rpy:1492
translate russian hanna_event_07a_dc19b161:
    mike.say "Для чего ещё нужны друзья?"

# ch/hanna/events.rpy:1496
translate russian hanna_event_07a_1e111638:
    "Она обхватывает мою руку обеими своими и прижимается ближе."

# ch/hanna/events.rpy:1498
translate russian hanna_event_07a_88da61d9:
    hanna.say "Мы ведь друзья, [lssb_hanna.hero_name()]?"

# ch/hanna/events.rpy:1500
translate russian hanna_event_07a_27fb2df5:
    hanna.say "Очень близкие друзья..."

# ch/hanna/events.rpy:1502
translate russian hanna_event_07a_d1d5fd90:
    "Я нервно сглатываю, но не могу сдержать радостного волнения от её нежности."

# ch/hanna/events.rpy:1506
translate russian hanna_event_07a_b99e9698:
    "Может, наградой за всё это станет не только возврат моих накоплений."

# ch/hanna/events.rpy:1517
translate russian hanna_event_07b_6918ec6c:
    "Вообще-то мне не нужен повод зайти в спортзал и посмотреть, воспользовалась ли Ханна моим советом."

# ch/hanna/events.rpy:1518
translate russian hanna_event_07b_3b84df16:
    "У меня есть абонемент, и я всё равно собирался прийти на обычную тренировку хотя бы раз на этой неделе."

# ch/hanna/events.rpy:1519
translate russian hanna_event_07b_870d9bd3:
    "Хотя, если благодаря моему совету дела действительно пойдут в гору, стоит кое-что с ней обсудить."

# ch/hanna/events.rpy:1520
translate russian hanna_event_07b_b824cbc4:
    "Если новых клиентов будет достаточно, разве они не смогут сделать мой абонемент бесплатным?"

# ch/hanna/events.rpy:1522
translate russian hanna_event_07b_bc1038f6:
    "С улицы всё выглядит по-прежнему, но первое же изменение внутри буквально бьёт в глаза."

# ch/hanna/events.rpy:1525
translate russian hanna_event_07b_6fab155a:
    "За стойкой стоит один из инструкторов-мужчин. На нём то, что едва можно назвать майкой: обтягивающая, почти прозрачная ткань."

# ch/hanna/events.rpy:1526
translate russian hanna_event_07b_4a9ac684:
    "Ладно, лично мне не по вкусу, но любителям подтянутых парней в тесной одежде наверняка понравится."

# ch/hanna/events.rpy:1527
translate russian hanna_event_07b_0f2f6a56:
    "Похоже, Ханна приняла мой совет близко к сердцу и взялась за дело!"

# ch/hanna/events.rpy:1530
translate russian hanna_event_07b_3a868602:
    "По дороге к раздевалкам замечаю и менее явные перемены в оформлении."

# ch/hanna/events.rpy:1531
translate russian hanna_event_07b_ce2d5a25:
    "Кажется, исчезли все плакаты с тяжёлыми тренировками и серьёзными темами вроде питания и физической подготовки."

# ch/hanna/events.rpy:1532
translate russian hanna_event_07b_65bbe00e:
    "Теперь на рекламе занятий — эффектные модели в крохотных спортивных нарядах и даже дорогие марки легинсов и спортивных бюстгальтеров."

# ch/hanna/events.rpy:1533
translate russian hanna_event_07b_d31f537b:
    "Забавно. Ничего такого я Ханне не предлагал..."

# ch/hanna/events.rpy:1535
translate russian hanna_event_07b_6247a49e:
    "Переодевшись, выхожу в сам зал и сразу вижу, где произошли главные перемены."

# ch/hanna/events.rpy:1536
translate russian hanna_event_07b_4660c087:
    "Все до единого тренеры и инструкторы одеты так же, как парень на стойке."

# ch/hanna/events.rpy:1537
translate russian hanna_event_07b_39af3e4f:
    "Ведут ли они группу или консультируют клиента — облегающая лайкра прикрывает лишь малую часть их упругих, подтянутых тел."

# ch/hanna/events.rpy:1538
translate russian hanna_event_07b_583b944e:
    "Руки, ноги и животы если и закрыты, то почти прозрачной тканью, не менее соблазнительной, чем голая кожа."

# ch/hanna/events.rpy:1539
translate russian hanna_event_07b_4b048f73:
    "Но изменилось не только это."

# ch/hanna/events.rpy:1541
translate russian hanna_event_07b_96a7a29d:
    "Свет словно приглушили, а зеркал на стенах стало заметно больше."

# ch/hanna/events.rpy:1542
translate russian hanna_event_07b_97765326:
    "Гремит музыка, и зал с тренирующимися вокруг людьми теперь почти напоминает ночной клуб."

# ch/hanna/events.rpy:1545
translate russian hanna_event_07b_b3378251:
    "Немного изменились и сами тренажёры, и их расположение."

# ch/hanna/events.rpy:1546
translate russian hanna_event_07b_18c93e3a:
    "Исчезли те, на которых непременно выглядишь дураком, а после — обливаешься потом."

# ch/hanna/events.rpy:1548
translate russian hanna_event_07b_98dcdd32:
    "Остались лишь тренажёры, позволяющие телу изгибаться и тянуться весьма приятным глазу образом."

# ch/hanna/events.rpy:1549
translate russian hanna_event_07b_67cb65a2:
    "Наблюдая за посетителями, я вскоре понимаю, что расставлены они тоже не случайно."

# ch/hanna/events.rpy:1550
translate russian hanna_event_07b_1734e2ee:
    "С каждого открывается самый выгодный ракурс на человека рядом, который заодно может разглядывать тебя."

# ch/hanna/events.rpy:1553
translate russian hanna_event_07b_bdc155c6:
    "Всё это трудно осмыслить сразу."

# ch/hanna/events.rpy:1554
translate russian hanna_event_07b_78707c51:
    "Поэтому я стою в лёгком оцепенении, не зная, с чего начать."

# ch/hanna/events.rpy:1555
translate russian hanna_event_07b_d14c5f71:
    hanna.say "Ну, что скажешь?!"

# ch/hanna/events.rpy:1559
translate russian hanna_event_07b_1007f82c:
    "Растерявшись, я не заметил, как подошла Ханна, и даже не сразу услышал её голос."

# ch/hanna/events.rpy:1561
translate russian hanna_event_07b_4f988377:
    hanna.say "[lssb_hanna.hero_name()], ау! Я вообще-то здесь!"

# ch/hanna/events.rpy:1563
translate russian hanna_event_07b_ebe93558:
    mike.say "Да, Ханна, теперь вижу."

# ch/hanna/events.rpy:1566
translate russian hanna_event_07b_a9d2ce54:
    "Она разводит руками, обводя пространство вокруг, и с улыбкой поворачивается на месте."

# ch/hanna/events.rpy:1568
translate russian hanna_event_07b_05344f00:
    hanna.say "Та-дам! Нравится то, что видишь?"

# ch/hanna/events.rpy:1570
translate russian hanna_event_07b_d8e3c7a0:
    hanna.say "В конце концов, всё это твоя идея!"

# ch/hanna/events.rpy:1573
translate russian hanna_event_07b_817ff2ee:
    "А вижу я сейчас потрясающее зрелище: Ханна кружится передо мной."

# ch/hanna/events.rpy:1574
translate russian hanna_event_07b_70dda321:
    "В обновление спортзала она явно включила и себя."

# ch/hanna/events.rpy:1575
translate russian hanna_event_07b_786248c4:
    "Ханна одета так же, как остальные сотрудники, и выглядит, мягко говоря, очень приятно!"

# ch/hanna/events.rpy:1582
translate russian hanna_event_07b_8deed641:
    "Я слышно сглатываю и облизываю губы, пытаясь придумать ответ."

# ch/hanna/events.rpy:1583
translate russian hanna_event_07b_00fc6e83:
    "Желательно не тот, что пришёл в голову, когда она начала красоваться передо мной."

# ch/hanna/events.rpy:1584
translate russian hanna_event_07b_7097d9e2:
    "Что-нибудь, от чего я не покажусь пускающим слюни извращенцем..."

# ch/hanna/events.rpy:1585
translate russian hanna_event_07b_3445106c:
    mike.say "Это... это... столько всего сразу!"

# ch/hanna/events.rpy:1586
translate russian hanna_event_07b_18927e20:
    mike.say "Ты действительно прислушалась к моему совету."

# ch/hanna/events.rpy:1588
translate russian hanna_event_07b_5f557013:
    "Ханна сияет, наверное, решив, что меня ошеломил новый вид спортзала."

# ch/hanna/events.rpy:1589
translate russian hanna_event_07b_074d6820:
    "А не её подтянутое тело в этом невероятном наряде!"

# ch/hanna/events.rpy:1590
translate russian hanna_event_07b_56c8155c:
    hanna.say "Да, правда же!"

# ch/hanna/events.rpy:1592
translate russian hanna_event_07b_94feb9db:
    hanna.say "Конечно, поначалу кое-кто из сотрудников был против."

# ch/hanna/events.rpy:1594
translate russian hanna_event_07b_872611ea:
    hanna.say "Но большинство поняло: если хотим спасти зал, нужно что-то менять."

# ch/hanna/events.rpy:1599
translate russian hanna_event_07b_0d2f1f65:
    "Наконец оторвав глаза от Ханны, я быстро оглядываюсь."

# ch/hanna/events.rpy:1600
translate russian hanna_event_07b_34b78d7e:
    mike.say "Здесь и правда всё кипит."

# ch/hanna/events.rpy:1601
translate russian hanna_event_07b_2d613b53:
    mike.say "Не помню, когда в последний раз было столько народу."

# ch/hanna/events.rpy:1602
translate russian hanna_event_07b_11b73e4c:
    mike.say "И так громко..."

# ch/hanna/events.rpy:1604
translate russian hanna_event_07b_abbbd87e:
    "Ханна либо не замечает подколку насчёт шума, либо решает её проигнорировать."

# ch/hanna/events.rpy:1606
translate russian hanna_event_07b_d0ccbccc:
    hanna.say "Да, за последние несколько дней дела оживились."

# ch/hanna/events.rpy:1607
translate russian hanna_event_07b_afe13417:
    hanna.say "Сарафанное радио, соцсети и всё такое."

# ch/hanna/events.rpy:1609
translate russian hanna_event_07b_fa08bcd0:
    "Я киваю: тут не поспоришь."

# ch/hanna/events.rpy:1610
translate russian hanna_event_07b_f77de997:
    "Но всё же не могу удержаться от неизбежного вопроса."

# ch/hanna/events.rpy:1611
translate russian hanna_event_07b_58a7d95a:
    mike.say "Ханна, тебе не кажется, что вы рискуете слишком далеко уйти от самой идеи спортзала?"

# ch/hanna/events.rpy:1612
translate russian hanna_event_07b_861f8adb:
    mike.say "Если не знать, что здесь происходит, это место можно принять за ночной клуб."

# ch/hanna/events.rpy:1616
translate russian hanna_event_07b_21cc845f:
    "Она качает головой, сразу отвергая мои опасения."

# ch/hanna/events.rpy:1618
translate russian hanna_event_07b_846c4c59:
    hanna.say "Ни за что, [lssb_hanna.hero_name()]!"

# ch/hanna/events.rpy:1620
translate russian hanna_event_07b_481e7a61:
    hanna.say "Мы делаем всё то же самое, просто добавили немного дерзости и уверенности."

# ch/hanna/events.rpy:1624
translate russian hanna_event_07b_295c31a2:
    hanna.say "Как и с нашими телами: показываем их, чтобы клиенты знали, к чему стремиться!"

# ch/hanna/events.rpy:1626
translate russian hanna_event_07b_e434d57e:
    mike.say "Ладно, Ханна, как скажешь..."

# ch/hanna/events.rpy:1627
translate russian hanna_event_07b_9550b53e:
    "Я всё напоминаю себе, что изначально это была моя идея."

# ch/hanna/events.rpy:1628
translate russian hanna_event_07b_2115a594:
    "Если Ханна уверена в своих действиях и знает, куда движется, о чём волноваться?"

# ch/hanna/events.rpy:1629
translate russian hanna_event_07b_4e4ad57f:
    "Может, стоит просто принять перемены?"

# ch/hanna/events.rpy:1631
translate russian hanna_event_07b_2d8a305c:
    hanna.say "Ладно, мне пора! Нужно вести занятие!"

# ch/hanna/events.rpy:1632
translate russian hanna_event_07b_361a12c9:
    hanna.say "Поговорим позже."

# ch/hanna/events.rpy:1634
translate russian hanna_event_07b_41871ace:
    hanna.say "Приятной тренировки!"

# ch/hanna/events.rpy:1638
translate russian hanna_event_07b_e60de82f:
    "Я киваю, немного нервно машу ей и пытаюсь приступить к занятиям."

# ch/hanna/events.rpy:1639
translate russian hanna_event_07b_33d743b3:
    "Только удержать программу в голове неожиданно трудно, когда вокруг столько отвлекающих зрелищ..."

# ch/hanna/events.rpy:1648
translate russian hanna_event_07c_05651344:
    "Когда после разговора о спортзале мы наконец снова встречаемся, я жду новостей о её отце и денежных проблемах."

# ch/hanna/events.rpy:1650
translate russian hanna_event_07c_adbf91f0:
    "Но, едва увидев Ханну, понимаю: сейчас она думает о другом и встретиться хотела по иной причине."

# ch/hanna/events.rpy:1652
translate russian hanna_event_07c_f896953f:
    "На её лице странная смесь усталости и облегчения, будто часть прежней ноши спала с плеч."

# ch/hanna/events.rpy:1653
translate russian hanna_event_07c_1911ca08:
    mike.say "Ханна, очень рад тебя видеть."

# ch/hanna/events.rpy:1654
translate russian hanna_event_07c_58b9da57:
    mike.say "Надеюсь, у тебя хорошие новости."

# ch/hanna/events.rpy:1656
translate russian hanna_event_07c_cdee16a7:
    "Она улыбается, но в улыбке столько боли, что хорошего это не предвещает."

# ch/hanna/events.rpy:1658
translate russian hanna_event_07c_0ecc50bd:
    hanna.say "Да, [lssb_hanna.hero_name()], есть."

# ch/hanna/events.rpy:1659
translate russian hanna_event_07c_e9b4b13a:
    hanna.say "И не очень хорошие тоже..."

# ch/hanna/events.rpy:1661
translate russian hanna_event_07c_cd158303:
    "Значит, я не ошибся."

# ch/hanna/events.rpy:1662
translate russian hanna_event_07c_d736424a:
    mike.say "Ладно. Какие хорошие?"

# ch/hanna/events.rpy:1665
translate russian hanna_event_07c_ae55fa5e:
    "Она вздыхает, затем глубоко вдыхает, собираясь всё рассказать."

# ch/hanna/events.rpy:1667
translate russian hanna_event_07c_2628389b:
    hanna.say "Я последовала твоему совету и продала спортзал."

# ch/hanna/events.rpy:1671
translate russian hanna_event_07c_d59eea77:
    hanna.say "Не знаю, хорошо это или плохо."

# ch/hanna/events.rpy:1673
translate russian hanna_event_07c_e5d40481:
    hanna.say "Но разом решилось много проблем. Будем считать, что хорошо."

# ch/hanna/events.rpy:1675
translate russian hanna_event_07c_d56bf136:
    "Я сочувственно киваю, готовясь слушать дальше."

# ch/hanna/events.rpy:1677
translate russian hanna_event_07c_c61b9bea:
    hanna.say "А папа согласился обратиться к специалисту из-за своей зависимости от азартных игр."

# ch/hanna/events.rpy:1678
translate russian hanna_event_07c_238e029c:
    hanna.say "И теперь будет каждую неделю ходить на встречи анонимных игроков."

# ch/hanna/events.rpy:1680
translate russian hanna_event_07c_cdcccac0:
    "Она замолкает, а я гадаю, что из этого было плохой новостью."

# ch/hanna/events.rpy:1681
translate russian hanna_event_07c_08b9bea8:
    "По мне, для всех это хорошее начало."

# ch/hanna/events.rpy:1683
translate russian hanna_event_07c_25d13bb9:
    "Но тут понимаю, что Ханна ещё не закончила."

# ch/hanna/events.rpy:1684
translate russian hanna_event_07c_e24aa332:
    mike.say "А что плохого, Ханна?"

# ch/hanna/events.rpy:1686
translate russian hanna_event_07c_2fe49a30:
    hanna.say "Вот это принять труднее, [lssb_hanna.hero_name()]."

# ch/hanna/events.rpy:1687
translate russian hanna_event_07c_b35b6f81:
    hanna.say "Понятное дело, после продажи зала я тоже осталась без работы."

# ch/hanna/events.rpy:1689
translate russian hanna_event_07c_32830a97:
    hanna.say "Новые владельцы по доброте душевной позволили пока остаться."

# ch/hanna/events.rpy:1691
translate russian hanna_event_07c_1ff31be2:
    hanna.say "Но только инструктором и совсем не на ту зарплату, которую я получала как дочка босса!"

# ch/hanna/events.rpy:1693
translate russian hanna_event_07c_e6ceb207:
    "Логично. Понимаю, почему Ханне тяжело после такого сокращения дохода."

# ch/hanna/events.rpy:1694
translate russian hanna_event_07c_593a1fca:
    "Хотя звучит не настолько драматично, как она это представляет."

# ch/hanna/events.rpy:1695
translate russian hanna_event_07c_14e06617:
    mike.say "То есть... ты ищешь место получше?"

# ch/hanna/events.rpy:1696
translate russian hanna_event_07c_830a6b24:
    mike.say "Наверняка есть десятки залов, которым нужен управляющий с твоим опытом?"

# ch/hanna/events.rpy:1698
translate russian hanna_event_07c_c8ea29da:
    hanna.say "Конечно, их полно."

# ch/hanna/events.rpy:1700
translate russian hanna_event_07c_0cca982f:
    hanna.say "Но ни одного в нашем городе или хотя бы достаточно близко, чтобы ездить на работу отсюда."

# ch/hanna/events.rpy:1702
translate russian hanna_event_07c_054739cf:
    "А, теперь я начинаю понимать, в чём плохая новость..."

# ch/hanna/events.rpy:1703
translate russian hanna_event_07c_e5aa703c:
    "Очень похоже, что Ханна подводит к тому, что уезжает."

# ch/hanna/events.rpy:1704
translate russian hanna_event_07c_59d735c1:
    mike.say "Ханна... ты ведь не собираешься переезжать?"

# ch/hanna/events.rpy:1705
translate russian hanna_event_07c_9608ad30:
    "Она отвечает не сразу, а я жду, затаив дыхание."

# ch/hanna/events.rpy:1707
translate russian hanna_event_07c_e571528c:
    hanna.say "Я думала об этом, [lssb_hanna.hero_name()]."

# ch/hanna/events.rpy:1708
translate russian hanna_event_07c_12961ee5:
    hanna.say "В одном месте, примерно в дне пути отсюда, меня хоть завтра возьмут управляющей."

# ch/hanna/events.rpy:1710
translate russian hanna_event_07c_29e6ed93:
    hanna.say "Я даже узнала, сколько там стоит аренда."

# ch/hanna/events.rpy:1712
translate russian hanna_event_07c_337dfe82:
    "В животе неприятно сжимается. Изо всех сил стараюсь не показать этого."

# ch/hanna/events.rpy:1713
translate russian hanna_event_07c_8f602fc3:
    mike.say "И?"

# ch/hanna/events.rpy:1715
translate russian hanna_event_07c_0570c32f:
    hanna.say "А потом села и подумала, на что мне придётся это обменять."

# ch/hanna/events.rpy:1716
translate russian hanna_event_07c_cc9f4cbe:
    hanna.say "Папа здесь. За ним ещё долго нужно будет присматривать."

# ch/hanna/events.rpy:1717
translate russian hanna_event_07c_80e3a2fa:
    hanna.say "Все мои знакомые здесь."

# ch/hanna/events.rpy:1719
translate russian hanna_event_07c_2dd470e1:
    hanna.say "Ты здесь."

# ch/hanna/events.rpy:1721
translate russian hanna_event_07c_1ee0dafe:
    "Последнее она произносит тише, чем всё остальное, и вдруг начинает внимательно изучать пол."

# ch/hanna/events.rpy:1722
translate russian hanna_event_07c_db872010:
    "Я молчу, главным образом потому, что не уверен, сработает ли голос."

# ch/hanna/events.rpy:1724
translate russian hanna_event_07c_40f20dc6:
    hanna.say "Поэтому я остаюсь."

# ch/hanna/events.rpy:1725
translate russian hanna_event_07c_d79b8e87:
    hanna.say "Сказала новым владельцам, что согласна быть инструктором. Со следующей недели выхожу по их графику."

# ch/hanna/events.rpy:1727
translate russian hanna_event_07c_833de518:
    mike.say "Ханна, это же...!"

# ch/hanna/events.rpy:1728
translate russian hanna_event_07c_bf28aa7b:
    "Успеваю остановиться, прежде чем выдать, какое облегчение испытываю."

# ch/hanna/events.rpy:1729
translate russian hanna_event_07c_244062f3:
    mike.say "То есть ты уверена, что хочешь именно этого?"

# ch/hanna/events.rpy:1730
translate russian hanna_event_07c_eff365e3:
    mike.say "После управления целым залом это серьёзное понижение."

# ch/hanna/events.rpy:1733
translate russian hanna_event_07c_caf197f7:
    "Ханна смеётся, и впервые за весь разговор смех звучит искренне."

# ch/hanna/events.rpy:1734
translate russian hanna_event_07c_19df2fc1:
    hanna.say "Меньше зарплата и гораздо меньше бумажной работы."

# ch/hanna/events.rpy:1735
translate russian hanna_event_07c_ae9ecc77:
    hanna.say "И знаешь, что ещё?"

# ch/hanna/events.rpy:1736
translate russian hanna_event_07c_b2d0dcef:
    hanna.say "Впервые за шесть лет я смогу закончить смену — и больше ни о чём не думать."

# ch/hanna/events.rpy:1738
translate russian hanna_event_07c_63ee7911:
    hanna.say "Честно, пока даже не знаю, куда девать столько времени."

# ch/hanna/events.rpy:1740
translate russian hanna_event_07c_2c6afeab:
    hanna.say "Но уверена, что-нибудь придумаю."

# ch/hanna/events.rpy:1742
translate russian hanna_event_07c_230fbd3d:
    "Чувства смешанные: мне жаль всего, что Ханна потеряла, и стыдно, ведь отказаться от этого посоветовал я."

# ch/hanna/events.rpy:1743
translate russian hanna_event_07c_6b45d853:
    mike.say "Знаешь, мне кажется, всё это моя вина."

# ch/hanna/events.rpy:1744
translate russian hanna_event_07c_f2ec2521:
    mike.say "Ведь это я предложил продать зал."

# ch/hanna/events.rpy:1748
translate russian hanna_event_07c_243eb437:
    "Она качает головой и улыбается — в улыбке гораздо больше тепла, чем жалости."

# ch/hanna/events.rpy:1750
translate russian hanna_event_07c_b68d0df1:
    hanna.say "Не надо так думать. Правда, не надо."

# ch/hanna/events.rpy:1752
translate russian hanna_event_07c_2b81cc16:
    hanna.say "Думаю, именно привычная колея позволила папиной зависимости взять над ним верх."

# ch/hanna/events.rpy:1754
translate russian hanna_event_07c_7c95037c:
    hanna.say "Мы так привыкли к удобному распорядку, что не замечали беды, пока едва не стало слишком поздно."

# ch/hanna/events.rpy:1756
translate russian hanna_event_07c_855bafba:
    hanna.say "Только ты решился сказать об этом вслух."

# ch/hanna/events.rpy:1760
translate russian hanna_event_07c_014d7d38:
    hanna.say "Я хотела, чтобы ты одним из первых узнал о моём решении."

# ch/hanna/events.rpy:1764
translate russian hanna_event_07c_0a6f2925:
    hanna.say "И поблагодарить тебя за дружбу и за то, что помог спасти папу от самого себя."

# ch/hanna/events.rpy:1766
translate russian hanna_event_07c_793f4873:
    mike.say "Всё хорошо, Ханна. Для чего ещё нужны друзья?"

# ch/hanna/events.rpy:1769
translate russian hanna_event_07c_ec70cc0c:
    "Она наклоняется и целует меня в щёку. На этот раз в поцелуе нет ни капли грусти."

# ch/hanna/events.rpy:1785
translate russian hanna_event_08_4e907eff:
    "Это один из тех вечеров, когда всё складывается идеально."

# ch/hanna/events.rpy:1786
translate russian hanna_event_08_c6ca0b61:
    "Я почти не замечаю времени — оно словно летит!"

# ch/hanna/events.rpy:1788
translate russian hanna_event_08_b65741e1:
    "Ханне весело: она смеётся над моими шутками и ловит каждое слово."

# ch/hanna/events.rpy:1790
translate russian hanna_event_08_2c26420b:
    "Даже когда мы выходим из ресторана и идём по улице."

# ch/hanna/events.rpy:1792
translate russian hanna_event_08_e79b4f9b:
    "Она так увлечена разговором, что я удивляюсь, когда её внимание привлекает что-то ещё."

# ch/hanna/events.rpy:1793
translate russian hanna_event_08_30e74fc5:
    mike.say "Эм..."

# ch/hanna/events.rpy:1794
translate russian hanna_event_08_476e5e82:
    mike.say "Ханна?"

# ch/hanna/events.rpy:1795
translate russian hanna_event_08_865605d1:
    mike.say "Земля вызывает Ханну!"

# ch/hanna/events.rpy:1798
translate russian hanna_event_08_e6bdbc17:
    "Теперь она выглядит такой же удивлённой, как я пару секунд назад."

# ch/hanna/events.rpy:1802
translate russian hanna_event_08_ba70e306:
    "Но вскоре качает головой, улыбается и возвращается к реальности."

# ch/hanna/events.rpy:1804
translate russian hanna_event_08_e46e1fb4:
    hanna.say "Прости, прости..."

# ch/hanna/events.rpy:1808
translate russian hanna_event_08_f7659ad9:
    hanna.say "Просто задумалась о таких местах..."

# ch/hanna/events.rpy:1811
translate russian hanna_event_08_ee7cd98a:
    "Она кивает на фасад здания, возле которого мы остановились."

# ch/hanna/events.rpy:1812
translate russian hanna_event_08_a29fc58a:
    "Только теперь замечаю: это стриптиз-клуб."

# ch/hanna/events.rpy:1814
translate russian hanna_event_08_f20b066f:
    "Точнее, тот самый, в котором я пару раз бывал!" with hpunch

# ch/hanna/events.rpy:1815
translate russian hanna_event_08_02659430:
    "Не то чтобы я завсегдатай."

# ch/hanna/events.rpy:1816
translate russian hanna_event_08_c61c3ba9:
    "Но у кого-нибудь из персонала может быть хорошая память на лица!"

# ch/hanna/events.rpy:1817
translate russian hanna_event_08_1638f19f:
    mike.say "А... ты про стриптиз-клуб?!"

# ch/hanna/events.rpy:1818
translate russian hanna_event_08_0c1347c5:
    mike.say "А что с ним, Ханна?"

# ch/hanna/events.rpy:1819
translate russian hanna_event_08_4fe34958:
    mike.say "То есть... какие мысли он у тебя вызывает?"

# ch/hanna/events.rpy:1822
translate russian hanna_event_08_bea0e8e0:
    "Она задумчиво кивает."

# ch/hanna/events.rpy:1824
translate russian hanna_event_08_34b81ba5:
    hanna.say "Просто интересно, каково заниматься чем-то таким, понимаешь?"

# ch/hanna/events.rpy:1826
translate russian hanna_event_08_b360b470:
    hanna.say "Постоянно быть на виду у стольких людей!"

# ch/hanna/events.rpy:1828
translate russian hanna_event_08_69a2014a:
    mike.say "Ты о чём, Ханна?"

# ch/hanna/events.rpy:1829
translate russian hanna_event_08_8bfb7a8a:
    mike.say "Ты каждый день ведёшь занятия в зале."

# ch/hanna/events.rpy:1830
translate russian hanna_event_08_2dd06123:
    mike.say "Все участники постоянно на тебя смотрят."

# ch/hanna/events.rpy:1832
translate russian hanna_event_08_88a1a8af:
    hanna.say "Это совсем другое, глупенький!"

# ch/hanna/events.rpy:1834
translate russian hanna_event_08_8583cb51:
    hanna.say "Они смотрят, чтобы повторять за мной."

# ch/hanna/events.rpy:1836
translate russian hanna_event_08_e8955ded:
    hanna.say "Они думают только о том, как улучшить форму!"

# ch/hanna/events.rpy:1838
translate russian hanna_event_08_0f04f176:
    "Я невольно усмехаюсь."

# ch/hanna/events.rpy:1839
translate russian hanna_event_08_40645843:
    "Когда смотрю на Ханну в обтягивающем, о физической форме думаю в последнюю очередь."

# ch/hanna/events.rpy:1840
translate russian hanna_event_08_6d355eb5:
    "Не знаю, верит ли она сама в свои слова."

# ch/hanna/events.rpy:1841
translate russian hanna_event_08_e6a30b24:
    "Или просто строит из себя невинную."

# ch/hanna/events.rpy:1842
translate russian hanna_event_08_afe417c3:
    "Решаю проверить, что будет, если поймать её на слове."

# ch/hanna/events.rpy:1843
translate russian hanna_event_08_10c83b66:
    mike.say "Похоже, тебе любопытно, что там внутри, Ханна."

# ch/hanna/events.rpy:1844
translate russian hanna_event_08_d234bf37:
    mike.say "Почему бы не зайти и не посмотреть самой?"

# ch/hanna/events.rpy:1848
translate russian hanna_event_08_9fa339e4:
    hanna.say "Я... думаю, ничего плохого не случится."

# ch/hanna/events.rpy:1850
translate russian hanna_event_08_4f65ad0a:
    hanna.say "Ладно... пойдём!"

# ch/hanna/events.rpy:1852
translate russian hanna_event_08_7940f9f4:
    "От её ответа я смеюсь."

# ch/hanna/events.rpy:1853
translate russian hanna_event_08_dd86a17c:
    "А ведь думал, придётся хоть немного уговаривать!"

# ch/hanna/events.rpy:1854
translate russian hanna_event_08_b111405f:
    "Хватило лёгкого толчка."

# ch/hanna/events.rpy:1855
translate russian hanna_event_08_c26eace5:
    "И вот она уже согласна!"

# ch/hanna/events.rpy:1858
translate russian hanna_event_08_4fd11058:
    "Ханна берёт меня за руку и сжимает её."

# ch/hanna/events.rpy:1859
translate russian hanna_event_08_cf2336fa:
    "Мы направляемся к двери и заходим внутрь."

# ch/hanna/events.rpy:1866
translate russian hanna_event_08_5e95a283:
    "Я уже готов изображать, будто совсем не завсегдатай таких мест."

# ch/hanna/events.rpy:1867
translate russian hanna_event_08_150fb858:
    "Но по восторженному лицу Ханны понимаю: можно не стараться."

# ch/hanna/events.rpy:1869
translate russian hanna_event_08_9079848c:
    "Она смотрит по сторонам широко раскрытыми от интереса и удивления глазами."

# ch/hanna/events.rpy:1870
translate russian hanna_event_08_bce97965:
    "Повсюду, как всегда, девушки в самых скудных нарядах."

# ch/hanna/events.rpy:1871
translate russian hanna_event_08_4215d6f6:
    "И привычная толпа посетителей, глазеющих во все глаза."

# ch/hanna/events.rpy:1873
translate russian hanna_event_08_9279185b:
    mike.say "Всё хорошо, Ханна?"

# ch/hanna/events.rpy:1874
translate russian hanna_event_08_1cfc5bb3:
    mike.say "То есть... большинству девушек такие места не нравятся!"

# ch/hanna/events.rpy:1875
translate russian hanna_event_08_2f0222f1:
    mike.say "Если тебе некомфортно, можем уйти."

# ch/hanna/events.rpy:1880
translate russian hanna_event_08_6c56dfe6:
    "Ханна качает головой и тянет меня дальше в клуб."

# ch/hanna/events.rpy:1882
translate russian hanna_event_08_ba966588:
    hanna.say "Не глупи, [lssb_hanna.hero_name()]!"

# ch/hanna/events.rpy:1884
translate russian hanna_event_08_76eda3a7:
    hanna.say "Здесь потрясающе!"

# ch/hanna/events.rpy:1886
translate russian hanna_event_08_4e2a9cdb:
    hanna.say "От этих девушек никто глаз не может оторвать."

# ch/hanna/events.rpy:1888
translate russian hanna_event_08_afda5326:
    hanna.say "Будто им поклоняются!"

# ch/hanna/events.rpy:1891
translate russian hanna_event_08_b4caf4da:
    "Вдруг что-то привлекает внимание Ханны."

# ch/hanna/events.rpy:1893
translate russian hanna_event_08_86b49362:
    "Она пытается разглядеть происходящее на сцене."

# ch/hanna/events.rpy:1895
translate russian hanna_event_08_7b4cbcd6:
    hanna.say "Почему у того пилона никого нет?"

# ch/hanna/events.rpy:1896
translate russian hanna_event_08_b61c2ffb:
    hanna.say "У того, на сцене. Почему вокруг него никто не танцует?"

# ch/hanna/events.rpy:1898
translate russian hanna_event_08_b36c9332:
    "Я пожимаю плечами и оглядываюсь в поисках ответа."

# ch/hanna/events.rpy:1899
translate russian hanna_event_08_bb826c1b:
    "Вскоре замечаю табличку, которая всё объясняет."

# ch/hanna/events.rpy:1900
translate russian hanna_event_08_5ba9af22:
    mike.say "Похоже, сегодня «Вечер свободного пилона», Ханна."

# ch/hanna/events.rpy:1904
translate russian hanna_event_08_2f42555c:
    hanna.say "А?!"

# ch/hanna/events.rpy:1905
translate russian hanna_event_08_f1473c1e:
    hanna.say "Что это значит?"

# ch/hanna/events.rpy:1907
translate russian hanna_event_08_02bed558:
    mike.say "Наверное, как открытый микрофон, только с пилоном!"

# ch/hanna/events.rpy:1908
translate russian hanna_event_08_364a0fc9:
    mike.say "Любой может выйти на сцену и попробовать станцевать."

# ch/hanna/events.rpy:1910
translate russian hanna_event_08_acdeb16b:
    "Ханна смотрит на меня в изумлении."

# ch/hanna/events.rpy:1911
translate russian hanna_event_08_9646475d:
    "Никогда ещё не видел её глаза такими огромными и восторженными."

# ch/hanna/events.rpy:1913
translate russian hanna_event_08_ea2e44d8:
    hanna.say "А..."

# ch/hanna/events.rpy:1914
translate russian hanna_event_08_9f72cd24:
    hanna.say "Как думаешь..."

# ch/hanna/events.rpy:1916
translate russian hanna_event_08_de71b195:
    hanna.say "Мне стоит выйти?"

# ch/hanna/events.rpy:1917
translate russian hanna_event_08_612e6410:
    hanna.say "Попробовать самой?!"

# ch/hanna/events.rpy:1921
translate russian hanna_event_08_33672488:
    "Сначала просит отвести её в стриптиз-клуб."

# ch/hanna/events.rpy:1922
translate russian hanna_event_08_d47dbb78:
    "Теперь хочет моего разрешения выйти и станцевать у пилона!"

# ch/hanna/events.rpy:1923
translate russian hanna_event_08_ea3ea96d:
    "Ханна — лучшая девушка на свете или как?!"

# ch/hanna/events.rpy:1924
translate russian hanna_event_08_71c96bca:
    mike.say "Конечно стоит, Ханна!"

# ch/hanna/events.rpy:1925
translate russian hanna_event_08_41234eab:
    mike.say "Ты сногсшибательная и в отличной форме!"

# ch/hanna/events.rpy:1926
translate russian hanna_event_08_eaf258cd:
    mike.say "И... погоди-ка..."

# ch/hanna/events.rpy:1927
translate russian hanna_event_08_d555f549:
    mike.say "Разве у тебя в зале не было занятий на пилоне?"

# ch/hanna/events.rpy:1929
translate russian hanna_event_08_982ee7f1:
    "От моей похвалы Ханна и так сияет."

# ch/hanna/events.rpy:1932
translate russian hanna_event_08_40108a5f:
    "Но при упоминании занятий на пилоне чуть не начинает мурлыкать!"

# ch/hanna/events.rpy:1934
translate russian hanna_event_08_3f5fef00:
    hanna.say "Надо было догадаться, что ты об этом помнишь!"

# ch/hanna/events.rpy:1938
translate russian hanna_event_08_b6acc237:
    hanna.say "И, похоже, хочешь выступление на бис!"

# ch/hanna/events.rpy:1940
translate russian hanna_event_08_dc6928ce:
    hanna.say "Вот..."

# ch/hanna/events.rpy:1941
translate russian hanna_event_08_d05e2e61:
    hanna.say "Подержи мой напиток..."

# ch/hanna/events.rpy:1945
translate russian hanna_event_08_2f89221b:
    hanna.say "И одежду тоже!"

# ch/hanna/events.rpy:1946
translate russian hanna_event_08_cb6dc1a6:
    "Прежде чем я успеваю что-то сказать, Ханна суёт мне в руку стакан."

# ch/hanna/events.rpy:1949
translate russian hanna_event_08_7682deb9:
    "Следом отправляется одежда, которую она быстро срывает с себя."

# ch/hanna/events.rpy:1953
translate russian hanna_event_08_71148efe:
    "И вот она уже бежит к сцене совершенно голая."

# ch/hanna/events.rpy:1954
translate russian hanna_event_08_a2e2b224:
    "Сначала остальные посетители удивлены не меньше меня."

# ch/hanna/events.rpy:1960
translate russian hanna_event_08_bf67be7b:
    "Но вскоре начинают радостно кричать."

# ch/hanna/events.rpy:1962
translate russian hanna_event_08_eff370c9:
    "А кто бы не стал?"

# ch/hanna/events.rpy:1963
translate russian hanna_event_08_070e110b:
    "На сцену только что выбежала спортивная блондинка с обалденной фигурой."

# ch/hanna/events.rpy:1964
translate russian hanna_event_08_f087ce39:
    "Даже если она не умеет танцевать на пилоне, на это уже стоит посмотреть!"

# ch/hanna/events.rpy:1969
translate russian hanna_event_08_36e6084c:
    "Я протискиваюсь ближе к сцене, отвоёвывая себе место."

# ch/hanna/events.rpy:1970
translate russian hanna_event_08_73e0eda2:
    "И наконец пробираюсь в самый первый ряд."

# ch/hanna/events.rpy:1971
translate russian hanna_event_08_9b85d44b:
    "Хлопаю как могу: мешают напитки и одежда Ханны."

# ch/hanna/events.rpy:1972
translate russian hanna_event_08_998ad5bf:
    "Она замечает меня мгновенно, словно всё это время искала взглядом."

# ch/hanna/events.rpy:1973
translate russian hanna_event_08_dc88b20c:
    "И, увидев меня, будто получает сигнал начинать."

# ch/hanna/events.rpy:1975
translate russian hanna_event_08_725015ef:
    "С первых секунд ясно: она настроена серьёзно."

# ch/hanna/events.rpy:1979
translate russian hanna_event_08_6e541434:
    "Ханна шагает по сцене и обвивается вокруг пилона."

# ch/hanna/events.rpy:1980
translate russian hanna_event_08_233e995d:
    "Я столько раз видел это упругое, чувственное тело в движении в спортзале."

# ch/hanna/events.rpy:1981
translate russian hanna_event_08_dacb7a6f:
    "Но здесь, под светом клубных софитов, всё ощущается иначе."

# ch/hanna/events.rpy:1982
translate russian hanna_event_08_0a654ce7:
    "В зале я смотрел украдкой."

# ch/hanna/events.rpy:1983
translate russian hanna_event_08_c730afaa:
    "Прекрасно знал, что откровенно пялиться не принято."

# ch/hanna/events.rpy:1984
translate russian hanna_event_08_4fb2f5b2:
    "А здесь Ханна демонстрирует своё тело прямо передо мной."

# ch/hanna/events.rpy:1985
translate russian hanna_event_08_7e065097:
    "И делает всё, чтобы я больше ни на что не смотрел!"

# ch/hanna/events.rpy:1987
translate russian hanna_event_08_9e683f26:
    "Она извивается и кружится вокруг пилона, словно змея."

# ch/hanna/events.rpy:1991
translate russian hanna_event_08_418e3ef9:
    "Поднимается по нему с помощью рук и ног, не переставая вращаться."

# ch/hanna/events.rpy:1992
translate russian hanna_event_08_08d865c6:
    "То висит вниз головой, то удерживается боком."

# ch/hanna/events.rpy:1993
translate russian hanna_event_08_e8c7dfa6:
    "Кажется, её ноги вообще не касаются пола!"

# ch/hanna/events.rpy:1994
translate russian hanna_event_08_7e7bd810:
    "И всё это время мышцы напрягаются, словно стальные тросы."

# ch/hanna/events.rpy:1995
translate russian hanna_event_08_d6daa0d8:
    "Но её женственного обаяния это ничуть не уменьшает."

# ch/hanna/events.rpy:1997
translate russian hanna_event_08_38290402:
    "Скорее наоборот: от силы, которую демонстрирует Ханна, у меня стоит ещё крепче!"

# ch/hanna/events.rpy:1998
translate russian hanna_event_08_c0556dff:
    "А в сочетании с формой её ног, упругой грудью и ещё более упругой попкой..."

# ch/hanna/events.rpy:1999
translate russian hanna_event_08_2567cbc8:
    "Я могу думать лишь о том, что она сейчас могла бы со мной сделать!"

# ch/hanna/events.rpy:2000
translate russian hanna_event_08_0d60bf30:
    "Кажется, каждый в этом зале завидует чёртову пилону!"

# ch/hanna/events.rpy:2006
translate russian hanna_event_08_099aa211:
    "Ханна завершает танец под восторженные аплодисменты."

# ch/hanna/events.rpy:2010
translate russian hanna_event_08_be6e7f0d:
    "Спешит со сцены ко мне."

# ch/hanna/events.rpy:2011
translate russian hanna_event_08_f860c439:
    "Она тяжело дышит, а кожа блестит от тонкого слоя пота."

# ch/hanna/events.rpy:2015
translate russian hanna_event_08_08662797:
    "Но по-прежнему на взводе и наслаждается тем, что все смотрят на неё."

# ch/hanna/events.rpy:2017
translate russian hanna_event_08_18a9a14f:
    "Забирает у меня вещи по одной и быстро одевается."

# ch/hanna/events.rpy:2019
translate russian hanna_event_08_841faf52:
    "Потом допивает напиток залпом, всё ещё тяжело дыша от усталости."

# ch/hanna/events.rpy:2020
translate russian hanna_event_08_2fdecf64:
    mike.say "Это..."

# ch/hanna/events.rpy:2021
translate russian hanna_event_08_97fc9107:
    mike.say "Это было потрясающе, Ханна!"

# ch/hanna/events.rpy:2023
translate russian hanna_event_08_5cc52393:
    hanna.say "Да... я знаю!"

# ch/hanna/events.rpy:2025
translate russian hanna_event_08_0fcdb3a3:
    hanna.say "И танцевать было не менее потрясающе!"

# ch/hanna/events.rpy:2027
translate russian hanna_event_08_24c83094:
    hanna.say "ОБЯЗАТЕЛЬНО повторим. И поскорее!"

# ch/hanna/events.rpy:2029
translate russian hanna_event_08_ef649bad:
    "Я с готовностью киваю, всё ещё не в силах перестать смотреть на неё с нескрываемым желанием."

# ch/hanna/events.rpy:2030
translate russian hanna_event_08_1d0d5e7c:
    "Хочется сказать, какой у меня сейчас стояк и как сильно я хочу её трахнуть!"

# ch/hanna/events.rpy:2031
translate russian hanna_event_08_d6fc728e:
    "Но, пожалуй, немного подожду."

# ch/hanna/events.rpy:2032
translate russian hanna_event_08_71ac5c0c:
    "Хотя бы пока она отдышится!"

# ch/hanna/events.rpy:2036
translate russian hanna_event_08_b3540056:
    "На Ханну и так постоянно смотрят, даже когда мы просто идём по улице."

# ch/hanna/events.rpy:2037
translate russian hanna_event_08_c1ad77ca:
    "И меньше всего мне хочется увидеть её на сцене чёртова стриптиз-клуба!"

# ch/hanna/events.rpy:2038
translate russian hanna_event_08_0cc94660:
    mike.say "Не знаю, Ханна..."

# ch/hanna/events.rpy:2039
translate russian hanna_event_08_b09074ba:
    mike.say "Ты, конечно, спортивная."

# ch/hanna/events.rpy:2040
translate russian hanna_event_08_6bac6be9:
    mike.say "Но танцы на пилоне сложнее, чем кажутся."

# ch/hanna/events.rpy:2042
translate russian hanna_event_08_7ce80915:
    "От моего отсутствия энтузиазма Ханна сразу разочаровывается."

# ch/hanna/events.rpy:2044
translate russian hanna_event_08_990d95c1:
    "Хмурится и надувает губы: ей не дают покрасоваться."

# ch/hanna/events.rpy:2046
translate russian hanna_event_08_d6af8f37:
    hanna.say "Эй!"

# ch/hanna/events.rpy:2047
translate russian hanna_event_08_a0f21be1:
    hanna.say "У нас вообще-то были занятия на пилоне, знаешь ли!"

# ch/hanna/events.rpy:2049
translate russian hanna_event_08_d6868557:
    mike.say "Да, но здесь другое, Ханна."

# ch/hanna/events.rpy:2050
translate russian hanna_event_08_a79acb44:
    mike.say "Ты и фитнес с боксёрскими движениями ведёшь."

# ch/hanna/events.rpy:2051
translate russian hanna_event_08_abe32cac:
    mike.say "Но это не значит, что выдержишь двенадцать раундов с чемпионом-тяжеловесом!"

# ch/hanna/events.rpy:2053
translate russian hanna_event_08_a19b0258:
    "Ханна досадливо фыркает."

# ch/hanna/events.rpy:2054
translate russian hanna_event_08_ba86f6ba:
    "Но я вижу, что мои слова подействовали."

# ch/hanna/events.rpy:2056
translate russian hanna_event_08_676f69a2:
    hanna.say "Ладно, ладно... твоя взяла!"

# ch/hanna/events.rpy:2058
translate russian hanna_event_08_fbd24b2e:
    hanna.say "Просто постою и посмотрю."

# ch/hanna/events.rpy:2062
translate russian hanna_event_08_20efde0c:
    "Дальше становится довольно неловко."

# ch/hanna/events.rpy:2063
translate russian hanna_event_08_28f058d5:
    "Мы с Ханной смотрим, как любители пробуют силы на сцене."

# ch/hanna/events.rpy:2065
translate russian hanna_event_08_4a482871:
    "Одни довольно хороши, другие откровенно ужасны."

# ch/hanna/events.rpy:2066
translate russian hanna_event_08_089594b3:
    "Большинство же где-то посередине."

# ch/hanna/events.rpy:2068
translate russian hanna_event_08_b2e21e92:
    "Через некоторое время Ханна, похоже, решает, что с неё хватит."

# ch/hanna/events.rpy:2070
translate russian hanna_event_08_448a8f3c:
    hanna.say "Я что-то устала, [lssb_hanna.hero_name()]."

# ch/hanna/events.rpy:2072
translate russian hanna_event_08_2c9b0bc2:
    hanna.say "Может, отвезёшь меня домой?"

# ch/hanna/events.rpy:2073
translate russian hanna_event_08_83718410:
    mike.say "Эм... ладно, Ханна."

# ch/hanna/events.rpy:2074
translate russian hanna_event_08_34efa998:
    mike.say "Если ты так хочешь..."

# ch/hanna/events.rpy:2079
translate russian hanna_event_08_9efc0ab8:
    "Что ж, могло получиться и лучше."

# ch/hanna/events.rpy:2080
translate russian hanna_event_08_b7080433:
    "По дороге к выходу взвешиваю плюсы и минусы."

# ch/hanna/events.rpy:2081
translate russian hanna_event_08_b589cee0:
    "Из минусов: я явно разозлил Ханну, не поддержав её желание танцевать."

# ch/hanna/events.rpy:2082
translate russian hanna_event_08_f9de1aa0:
    "Зато сумел отговорить и предотвратить возможную катастрофу."

# ch/hanna/events.rpy:2083
translate russian hanna_event_08_dafca737:
    "Так что, хоть она сейчас и играет со мной в молчанку, могло быть хуже."

# ch/hanna/events.rpy:2084
translate russian hanna_event_08_9295ed0d:
    "Это ведь хорошо, правда?"

# ch/hanna/events.rpy:2098
translate russian hanna_event_08a_6fcf42df:
    "С тех пор как Ханна рассказала о проблемах спортзала, прошло уже какое-то время."

# ch/hanna/events.rpy:2099
translate russian hanna_event_08a_c3eea5b7:
    "И мне по-прежнему приятно, что она позволила помочь ей займом."

# ch/hanna/events.rpy:2102
translate russian hanna_event_08a_8e1888d6:
    "Поэтому, когда она поднимает эту тему, я слушаю с большим интересом."

# ch/hanna/events.rpy:2103
translate russian hanna_event_08a_c8cd3bc0:
    hanna.say "Ах да..."

# ch/hanna/events.rpy:2105
translate russian hanna_event_08a_1610144a:
    hanna.say "Хотела сказать: у меня хорошие новости!"

# ch/hanna/events.rpy:2107
translate russian hanna_event_08a_50ddb94c:
    mike.say "Правда?"

# ch/hanna/events.rpy:2109
translate russian hanna_event_08a_c8886118:
    hanna.say "Угу..."

# ch/hanna/events.rpy:2110
translate russian hanna_event_08a_67af484b:
    hanna.say "Дела у спортзала снова идут как надо."

# ch/hanna/events.rpy:2112
translate russian hanna_event_08a_2a3e3cbe:
    hanna.say "Даже лучше прежнего."

# ch/hanna/events.rpy:2114
translate russian hanna_event_08a_57d53b22:
    "Я киваю и улыбаюсь, искренне радуясь её удаче."

# ch/hanna/events.rpy:2115
translate russian hanna_event_08a_732b665d:
    "И намеренно не упоминаю о долге, пока слушаю новости."

# ch/hanna/events.rpy:2116
translate russian hanna_event_08a_62fee49f:
    "Иначе показался бы человеком, помешанным на деньгах!"

# ch/hanna/events.rpy:2117
translate russian hanna_event_08a_352127da:
    mike.say "Это действительно хорошие новости, Ханна!"

# ch/hanna/events.rpy:2118
translate russian hanna_event_08a_812ccd67:
    mike.say "Я заметил, что ты выглядишь счастливее, чем в последнее время."

# ch/hanna/events.rpy:2119
translate russian hanna_event_08a_700f4540:
    mike.say "Значит, из тебя вышла хорошая деловая женщина."

# ch/hanna/events.rpy:2123
translate russian hanna_event_08a_dc2a47f5:
    "Ханна качает головой и бросает на меня понимающий взгляд."

# ch/hanna/events.rpy:2125
translate russian hanna_event_08a_05d106a6:
    "Редко увидишь её такой застенчивой."

# ch/hanna/events.rpy:2126
translate russian hanna_event_08a_1fe909c0:
    "И я снова вспоминаю, какая же она милая."

# ch/hanna/events.rpy:2130
translate russian hanna_event_08a_2081af83:
    hanna.say "Ну перестань, [lssb_hanna.hero_name()]..."

# ch/hanna/events.rpy:2132
translate russian hanna_event_08a_1b43bdd4:
    hanna.say "Хватит мне льстить."

# ch/hanna/events.rpy:2133
translate russian hanna_event_08a_f4eae03e:
    hanna.say "И скромничать тоже хватит."

# ch/hanna/events.rpy:2135
translate russian hanna_event_08a_91547924:
    hanna.say "Хотя нет, только скромничать перестань. Льстить можешь сколько угодно!"

# ch/hanna/events.rpy:2137
translate russian hanna_event_08a_62de1aac:
    "Ханна с видимым усилием становится серьёзнее."

# ch/hanna/events.rpy:2140
translate russian hanna_event_08a_7b54394f:
    "И берёт меня за руку."

# ch/hanna/events.rpy:2142
translate russian hanna_event_08a_3e85e9ab:
    hanna.say "Послушай, [lssb_hanna.hero_name()]..."

# ch/hanna/events.rpy:2143
translate russian hanna_event_08a_2408696e:
    hanna.say "Мы оба знаем, что всё получилось благодаря твоему займу."

# ch/hanna/events.rpy:2147
translate russian hanna_event_08a_8dbc7e64:
    hanna.say "Да, у меня, может, и нашлось несколько удачных идей."

# ch/hanna/events.rpy:2149
translate russian hanna_event_08a_228b4921:
    hanna.say "Но без твоих денег я не смогла бы удержать зал на плаву."

# ch/hanna/events.rpy:2151
translate russian hanna_event_08a_fb28cfbd:
    "Я отмахиваюсь, всё ещё пытаясь преуменьшить свою роль."

# ch/hanna/events.rpy:2152
translate russian hanna_event_08a_f2579ec4:
    mike.say "Я просто помогал подруге, Ханна."

# ch/hanna/events.rpy:2153
translate russian hanna_event_08a_ba8d13e4:
    mike.say "На моём месте ты поступила бы так же."

# ch/hanna/events.rpy:2156
translate russian hanna_event_08a_d493c4f0:
    "Чувствую, как она крепче сжимает мою руку."

# ch/hanna/events.rpy:2157
translate russian hanna_event_08a_8345e071:
    "И смотрит мне прямо в глаза."

# ch/hanna/events.rpy:2160
translate russian hanna_event_08a_1884ecd9:
    hanna.say "Думаю, мы уже больше чем друзья, [lssb_hanna.hero_name()]."

# ch/hanna/events.rpy:2162
translate russian hanna_event_08a_6135f5a2:
    hanna.say "И я хочу пригласить тебя куда-нибудь в благодарность."

# ch/hanna/events.rpy:2163
translate russian hanna_event_08a_88a1cc1d:
    hanna.say "Как насчёт ужина в хорошем ресторане?"

# ch/hanna/events.rpy:2167
translate russian hanna_event_08a_fc8bb777:
    hanna.say "Я угощаю!"

# ch/hanna/events.rpy:2171
translate russian hanna_event_08a_54b62588:
    mike.say "Не нужно меня благодарить, Ханна."

# ch/hanna/events.rpy:2172
translate russian hanna_event_08a_4e9f083e:
    mike.say "Но если хочешь накормить ужином, я не против!"

# ch/hanna/events.rpy:2175
translate russian hanna_event_08a_894f8450:
    "Ханна улыбается и кивает."

# ch/hanna/events.rpy:2177
translate russian hanna_event_08a_331c55d6:
    "Довольна, что добилась своего."

# ch/hanna/events.rpy:2180
translate russian hanna_event_08a_2d810da6:
    hanna.say "Отлично!"

# ch/hanna/events.rpy:2182
translate russian hanna_event_08a_ba5a32d5:
    hanna.say "Я знаю идеальное место."

# ch/hanna/events.rpy:2186
translate russian hanna_event_08a_9ce54801:
    hanna.say "Поверь, тебе понравится!"

# ch/hanna/events.rpy:2188
translate russian hanna_event_08a_ccf1a304:
    mike.say "Уверен, что так."

# ch/hanna/events.rpy:2191
translate russian hanna_event_08a_71352adc:
    mike.say "Я за ужин в хорошем месте, Ханна."

# ch/hanna/events.rpy:2194
translate russian hanna_event_08a_732ae84b:
    mike.say "Но не хочу, чтобы ты платила за всё одна."

# ch/hanna/events.rpy:2196
translate russian hanna_event_08a_227b418e:
    "Она хмурится."

# ch/hanna/events.rpy:2198
translate russian hanna_event_08a_7352fc8d:
    hanna.say "Почему?"

# ch/hanna/events.rpy:2200
translate russian hanna_event_08a_0bd09bfe:
    hanna.say "Теперь, когда дела у зала наладились, я могу себе это позволить."

# ch/hanna/events.rpy:2202
translate russian hanna_event_08a_28993be1:
    hanna.say "И хочу тебя отблагодарить."

# ch/hanna/events.rpy:2204
translate russian hanna_event_08a_67ee6ba3:
    mike.say "Просто у меня такой пунктик насчёт награды за добрые дела, Ханна."

# ch/hanna/events.rpy:2205
translate russian hanna_event_08a_489cb201:
    mike.say "Если приму, буду чувствовать, будто наживаюсь на том, что поступил правильно."

# ch/hanna/events.rpy:2207
translate russian hanna_event_08a_fc048b17:
    "Мой ответ заметно озадачивает и расстраивает её."

# ch/hanna/events.rpy:2210
translate russian hanna_event_08a_71a8528e:
    "И всё же она кивает."

# ch/hanna/events.rpy:2212
translate russian hanna_event_08a_25caa0f2:
    hanna.say "Ладно..."

# ch/hanna/events.rpy:2214
translate russian hanna_event_08a_0f9fe85e:
    hanna.say "Сходим куда-нибудь."

# ch/hanna/events.rpy:2216
translate russian hanna_event_08a_5811e2d3:
    hanna.say "Но счёт пополам, хорошо?"

# ch/hanna/events.rpy:2218
translate russian hanna_event_08a_11b46f3c:
    mike.say "Договорились."

# ch/hanna/events.rpy:2220
translate russian hanna_event_08a_fb66ceaa:
    "Когда вопрос решён, Ханна немного веселеет."

# ch/hanna/events.rpy:2222
translate russian hanna_event_08a_01796836:
    "Но меня всё ещё беспокоит, поняла ли она мои причины."

# ch/hanna/events.rpy:2235
translate russian hanna_event_08c_48dc4830:
    "Прошло несколько недель с тех пор, как у спортзала сменились владельцы, и всё это время я приглядываю за Ханной."

# ch/hanna/events.rpy:2236
translate russian hanna_event_08c_e0c30a96:
    "Наверное, жду, когда её настигнет осознание случившегося."

# ch/hanna/events.rpy:2237
translate russian hanna_event_08c_03321137:
    "Но этот момент, похоже, так и не наступает."

# ch/hanna/events.rpy:2239
translate russian hanna_event_08c_f2faaf39:
    "Она выглядит даже лучше, чем когда на вывеске было её имя."

# ch/hanna/events.rpy:2240
translate russian hanna_event_08c_cc386ee1:
    hanna.say "Ладно, выкладывай."

# ch/hanna/events.rpy:2241
translate russian hanna_event_08c_8eeba415:
    mike.say "Что выкладывать?"

# ch/hanna/events.rpy:2242
translate russian hanna_event_08c_8a4a5a11:
    hanna.say "Ты уже недели две смотришь на меня так, будто я вот-вот расплачусь."

# ch/hanna/events.rpy:2243
translate russian hanna_event_08c_732fd09f:
    "Открываю рот, чтобы возразить, но решаю не пытаться обмануть Ханну."

# ch/hanna/events.rpy:2244
translate russian hanna_event_08c_56c15b51:
    mike.say "Виноват."

# ch/hanna/events.rpy:2245
translate russian hanna_event_08c_aa42bd55:
    mike.say "Просто думал, потеря спортзала ударит по тебе сильнее."

# ch/hanna/events.rpy:2247
translate russian hanna_event_08c_4fcd8736:
    "Ханна скрещивает руки и ненадолго задумывается."

# ch/hanna/events.rpy:2248
translate russian hanna_event_08c_aff48a22:
    hanna.say "Ударила."

# ch/hanna/events.rpy:2249
translate russian hanna_event_08c_5824e5f4:
    hanna.say "В первое утро, когда я пришла и увидела, что график составил кто-то другой..."

# ch/hanna/events.rpy:2250
translate russian hanna_event_08c_f11b834b:
    hanna.say "Было тяжело."

# ch/hanna/events.rpy:2252
translate russian hanna_event_08c_e071be2d:
    hanna.say "А потом я закончила смену, пошла домой — и всё."

# ch/hanna/events.rpy:2253
translate russian hanna_event_08c_2aaa103c:
    hanna.say "Никто не звонил в одиннадцать вечера из-за сломанного бойлера."

# ch/hanna/events.rpy:2254
translate russian hanna_event_08c_60aeffc5:
    hanna.say "Никому не нужно было, чтобы я что-то подписала."

# ch/hanna/events.rpy:2255
translate russian hanna_event_08c_ed321752:
    hanna.say "Ты представляешь, как это странно?"

# ch/hanna/events.rpy:2256
translate russian hanna_event_08c_d1957543:
    mike.say "Похоже на работу большинства людей, Ханна."

# ch/hanna/events.rpy:2258
translate russian hanna_event_08c_eb1e53ab:
    hanna.say "Именно!"

# ch/hanna/events.rpy:2259
translate russian hanna_event_08c_e8adbfb6:
    hanna.say "Я этим занимаюсь с девятнадцати и никогда не работала как обычный человек."

# ch/hanna/events.rpy:2260
translate russian hanna_event_08c_ace24745:
    "Она смеётся над собой и качает головой."

# ch/hanna/events.rpy:2262
translate russian hanna_event_08c_7dc9ae49:
    hanna.say "Папа ходит на встречи, долгов нет, а я могу просто... быть инструктором."

# ch/hanna/events.rpy:2263
translate russian hanna_event_08c_0c386029:
    hanna.say "Прийти, хорошо поработать и уйти домой."

# ch/hanna/events.rpy:2264
translate russian hanna_event_08c_b7fb9bce:
    hanna.say "Оказывается, у меня неплохо получается, когда не приходится заодно быть начальницей."

# ch/hanna/events.rpy:2265
translate russian hanna_event_08c_d52cb27a:
    "Я искренне киваю. Ещё никогда не видел её такой беззаботной."

# ch/hanna/events.rpy:2267
translate russian hanna_event_08c_a438aa70:
    hanna.say "Правда, с одной вещью ещё не разобралась."

# ch/hanna/events.rpy:2268
translate russian hanna_event_08c_7d540191:
    mike.say "С какой?"

# ch/hanna/events.rpy:2269
translate russian hanna_event_08c_2b47a34f:
    hanna.say "Куда девать столько свободного времени."

# ch/hanna/events.rpy:2270
translate russian hanna_event_08c_f04dae4d:
    hanna.say "У меня теперь есть вечера, [lssb_hanna.hero_name()]."

# ch/hanna/events.rpy:2271
translate russian hanna_event_08c_15d893d8:
    hanna.say "Настоящие свободные вечера."

# ch/hanna/events.rpy:2272
translate russian hanna_event_08c_a08d327c:
    "По её тону ясно: вопрос не риторический."

# ch/hanna/events.rpy:2274
translate russian hanna_event_08c_5673e943:
    hanna.say "И я не могу не замечать, что ты постоянно сюда заглядываешь."

# ch/hanna/events.rpy:2275
translate russian hanna_event_08c_f7943330:
    hanna.say "Довольно много усилий для человека, который просто старается быть хорошим другом."

# ch/hanna/events.rpy:2276
translate russian hanna_event_08c_d93b75b6:
    "Я мог бы притвориться, что не понимаю намёка."

# ch/hanna/events.rpy:2277
translate russian hanna_event_08c_f74b540e:
    "Но чувствую: Ханна сразу меня раскусит, и поделом."

# ch/hanna/events.rpy:2278
translate russian hanna_event_08c_34c4e810:
    mike.say "Может, я хочу быть не только хорошим другом."

# ch/hanna/events.rpy:2280
translate russian hanna_event_08c_20510a60:
    hanna.say "Долго же ты собирался с духом!"

# ch/hanna/events.rpy:2287
translate russian hanna_event_09_intro_68b98b00:
    "Давайте сразу проясним: я знаю, что Ханна любит всеобщее внимание и обожает выставлять себя напоказ."

# ch/hanna/events.rpy:2288
translate russian hanna_event_09_intro_93db18a6:
    "За время наших встреч с этим пришлось смириться."

# ch/hanna/events.rpy:2289
translate russian hanna_event_09_intro_464a8a68:
    "Да, приглашение в стриптиз-клуб было попыткой немного поменяться с ней ролями."

# ch/hanna/events.rpy:2292
translate russian hanna_event_09_intro_018fbd30:
    "Но когда я наконец набираюсь смелости и предлагаю это, её ответ застаёт меня врасплох."

# ch/hanna/events.rpy:2293
translate russian hanna_event_09_intro_394f83ef:
    mike.say "Эй, Ханна."

# ch/hanna/events.rpy:2294
translate russian hanna_event_09_intro_e3ec8bd1:
    mike.say "У меня отличная идея для нашего сегодняшнего свидания."

# ch/hanna/events.rpy:2296
translate russian hanna_event_09_intro_3602724a:
    hanna.say "Да?"

# ch/hanna/events.rpy:2298
translate russian hanna_event_09_intro_743818b4:
    hanna.say "Ну же, выкладывай!"

# ch/hanna/events.rpy:2300
translate russian hanna_event_09_intro_7a4d0d43:
    mike.say "Давай сходим в стриптиз-клуб!"

# ch/hanna/events.rpy:2301
translate russian hanna_event_09_intro_941a1dd0:
    mike.say "Будет весело. В таком ироничном, постмодернистском духе, понимаешь?"

# ch/hanna/events.rpy:2303
translate russian hanna_event_09_intro_39fc4169:
    "Ханна несколько секунд смотрит на меня искоса, явно обдумывая идею."

# ch/hanna/events.rpy:2304
translate russian hanna_event_09_intro_da077c48:
    "За это короткое время я почти убеждаюсь, что она откажет."

# ch/hanna/events.rpy:2305
translate russian hanna_event_09_intro_b52cbb82:
    "Меня бы это устроило: я ведь просто хотел безобидно её поддразнить."

# ch/hanna/events.rpy:2307
translate russian hanna_event_09_intro_7de508c9:
    hanna.say "Да, понимаю, [lssb_hanna.hero_name()]."

# ch/hanna/events.rpy:2311
translate russian hanna_event_09_intro_572a9038:
    hanna.say "Может получиться забавно."

# ch/hanna/events.rpy:2313
translate russian hanna_event_09_intro_3253b47b:
    hanna.say "Так чего мы ждём?"

# ch/hanna/events.rpy:2316
translate russian hanna_event_09_intro_fbb2caae:
    hanna.say "Пойдём уже!"

# ch/hanna/events.rpy:2318
translate russian hanna_event_09_intro_0fcc6b02:
    mike.say "Эм... я..."

# ch/hanna/events.rpy:2319
translate russian hanna_event_09_intro_518c4002:
    mike.say "Да, Ханна, конечно. Пойдём..."

# ch/hanna/events.rpy:2323
translate russian hanna_event_09_intro_9050b179:
    "До клуба, который я имел в виду, мы добираемся быстро."

# ch/hanna/events.rpy:2324
translate russian hanna_event_09_intro_297708bb:
    "Не то чтобы я знал их огромное количество, конечно..."

# ch/hanna/events.rpy:2325
translate russian hanna_event_09_intro_3af9aecd:
    "По дороге я в основном киваю и улыбаюсь, словно на автопилоте."

# ch/hanna/events.rpy:2327
translate russian hanna_event_09_intro_e0b462b8:
    "Честно говоря, всё ещё ошеломлён тем, что Ханна действительно согласилась!"

# ch/hanna/events.rpy:2340
translate russian hanna_event_09_0eb9cd6b:
    "Но когда мы заходим и выбираем столик прямо у сцены, я замечаю нечто необычное."

# ch/hanna/events.rpy:2343
translate russian hanna_event_09_697438e5:
    "Внимание привлекают развешанные по залу таблички."

# ch/hanna/events.rpy:2347
translate russian hanna_event_09_d2e507d5:
    mike.say "Эй, это что?"

# ch/hanna/events.rpy:2349
translate russian hanna_event_09_bba4a1b9:
    hanna.say "Написано: «Вечер свободного пилона»."

# ch/hanna/events.rpy:2351
translate russian hanna_event_09_5f180a3c:
    hanna.say "Это значит то, что я думаю?"

# ch/hanna/events.rpy:2353
translate russian hanna_event_09_391b9b20:
    "Сначала я могу лишь кивнуть: смысл этих слов уже доходит до меня."

# ch/hanna/events.rpy:2354
translate russian hanna_event_09_8da887c9:
    "Обретя дар речи, подтверждаю её догадку."

# ch/hanna/events.rpy:2355
translate russian hanna_event_09_1557d925:
    mike.say "Наверное, как открытый микрофон, Ханна."

# ch/hanna/events.rpy:2356
translate russian hanna_event_09_eeb80c1a:
    mike.say "Только без микрофона."

# ch/hanna/events.rpy:2357
translate russian hanna_event_09_4acc4231:
    mike.say "Зато с танцами в откровенных нарядах!"

# ch/hanna/events.rpy:2360
translate russian hanna_event_09_aee260f3:
    "Едва я произношу последние слова, её глаза загораются."

# ch/hanna/events.rpy:2361
translate russian hanna_event_09_6a343750:
    "Мне совершенно ясно, о чём она думает, даже без намёков."

# ch/hanna/events.rpy:2364
translate russian hanna_event_09_f649bc6a:
    "Ханна смотрит на меня с одним из самых милых выражений лица."

# ch/hanna/events.rpy:2365
translate russian hanna_event_09_3f88f412:
    "От него мне всегда становится жарко при мысли о её желаниях."

# ch/hanna/events.rpy:2368
translate russian hanna_event_09_13f6725a:
    "Она сладко улыбается и кивает на пустую сцену."

# ch/hanna/events.rpy:2370
translate russian hanna_event_09_23754d16:
    hanna.say "[lssb_hanna.hero_name()]..."

# ch/hanna/events.rpy:2374
translate russian hanna_event_09_98f21cf0:
    hanna.say "Как думаешь..."

# ch/hanna/events.rpy:2376
translate russian hanna_event_09_b523744c:
    mike.say "Т... ты хочешь танцевать?"

# ch/hanna/events.rpy:2377
translate russian hanna_event_09_4b98b7d3:
    mike.say "На сцене?!"

# ch/hanna/events.rpy:2380
translate russian hanna_event_09_70cbf061:
    "Ханна досадливо вздыхает и закатывает глаза."

# ch/hanna/events.rpy:2382
translate russian hanna_event_09_7d05d594:
    hanna.say "Уф..."

# ch/hanna/events.rpy:2383
translate russian hanna_event_09_cb27bb2c:
    hanna.say "Нет, [lssb_hanna.hero_name()]... не ты, а я!"

# ch/hanna/events.rpy:2385
translate russian hanna_event_09_a9c09e9e:
    hanna.say "Конечно, я хочу станцевать на сцене!"

# ch/hanna/events.rpy:2387
translate russian hanna_event_09_aab04db5:
    "Затем она впивается в меня тем особым взглядом, который так хорошо удаётся девушкам."

# ch/hanna/events.rpy:2388
translate russian hanna_event_09_8e4a63ba:
    "Взглядом, который говорит: соглашайся, и побыстрее."

# ch/hanna/events.rpy:2389
translate russian hanna_event_09_c7bdedc6:
    "А если нет — приготовь очень убедительное объяснение!"

# ch/hanna/events.rpy:2392
translate russian hanna_event_09_ecdb093c:
    "Я уже жалею, что вообще привёл её сюда."

# ch/hanna/events.rpy:2393
translate russian hanna_event_09_bd96cba2:
    "Но этого мало: теперь я будто на скамье подсудимых."

# ch/hanna/events.rpy:2394
translate russian hanna_event_09_58988340:
    "И за что?"

# ch/hanna/events.rpy:2395
translate russian hanna_event_09_a6d9faf9:
    "За нежелание позволять ей выставляться на публике!"

# ch/hanna/events.rpy:2396
translate russian hanna_event_09_b0baeba6:
    "Другой парень, может, посмеялся бы и сказал: вперёд."

# ch/hanna/events.rpy:2397
translate russian hanna_event_09_6f7c76aa:
    "Но я уже чувствую, как внутри закипает ревность."

# ch/hanna/events.rpy:2398
translate russian hanna_event_09_1aaf4b6c:
    "Сама мысль о том, что все в зале будут смотреть на Ханну, мне ненавистна."

# ch/hanna/events.rpy:2399
translate russian hanna_event_09_932773f5:
    "Может, пора честно ей об этом сказать?"

# ch/hanna/events.rpy:2400
translate russian hanna_event_09_2d04e00e:
    mike.say "Ханна..."

# ch/hanna/events.rpy:2401
translate russian hanna_event_09_e0c6a2d3:
    mike.say "Пожалуйста, не надо."

# ch/hanna/events.rpy:2403
translate russian hanna_event_09_b16da54e:
    "Она поднимает брови и ждёт продолжения."

# ch/hanna/events.rpy:2405
translate russian hanna_event_09_ac7bf267:
    "Очевидно, одной просьбы будет недостаточно."

# ch/hanna/events.rpy:2406
translate russian hanna_event_09_a813e758:
    mike.say "Слушай, я знаю, что сам предложил сюда прийти."

# ch/hanna/events.rpy:2407
translate russian hanna_event_09_e888eccc:
    mike.say "И да, думал, получится дикое и необычное свидание."

# ch/hanna/events.rpy:2408
translate russian hanna_event_09_e3c051f6:
    mike.say "Но... я..."

# ch/hanna/events.rpy:2409
translate russian hanna_event_09_0fc4a3bd:
    mike.say "Просто мне не нравится мысль, что все будут на тебя смотреть."

# ch/hanna/events.rpy:2411
translate russian hanna_event_09_f7d2eccb:
    "Ханна хмурится и склоняет голову набок, обдумывая мои слова."

# ch/hanna/events.rpy:2413
translate russian hanna_event_09_20882067:
    hanna.say "Вот как?"

# ch/hanna/events.rpy:2415
translate russian hanna_event_09_104cec6b:
    hanna.say "А сам ты приходишь сюда смотреть, как другие девушки делают то же самое?"

# ch/hanna/events.rpy:2417
translate russian hanna_event_09_1eb68ffe:
    "От её слов я уже чувствую, как краснею."

# ch/hanna/events.rpy:2418
translate russian hanna_event_09_0a4046fd:
    "Тут она действительно припёрла меня к стенке."

# ch/hanna/events.rpy:2419
translate russian hanna_event_09_db033fe7:
    mike.say "Наверное, я лицемер, Ханна."

# ch/hanna/events.rpy:2420
translate russian hanna_event_09_7466ceb2:
    mike.say "Потому что хочу, чтобы ты была только моей..."

# ch/hanna/events.rpy:2421
translate russian hanna_event_09_af3d7f62:
    "Жду, что она снова меня отчихвостит. И, пожалуй, заслуженно."

# ch/hanna/events.rpy:2423
translate russian hanna_event_09_1729f2a3:
    "Но вдруг выражение её лица смягчается."

# ch/hanna/events.rpy:2425
translate russian hanna_event_09_0f9b4b5d:
    hanna.say "Я... настолько тебе нравлюсь?"

# ch/hanna/events.rpy:2427
translate russian hanna_event_09_6d7b6e4e:
    hanna.say "Что ж, наверное, это даже льстит, [lssb_hanna.hero_name()]."

# ch/hanna/events.rpy:2429
translate russian hanna_event_09_67b5f07c:
    hanna.say "Но лицемер ты всё равно!"

# ch/hanna/events.rpy:2431
translate russian hanna_event_09_a7a922b8:
    hanna.say "Ладно, не переживай."

# ch/hanna/events.rpy:2432
translate russian hanna_event_09_edf52013:
    hanna.say "Раз ты так хочешь, танцевать не буду."

# ch/hanna/events.rpy:2437
translate russian hanna_event_09_3b0f066f:
    hanna.say "Кто знает, может, позже сегодня устрою тебе личное представление..."

# ch/hanna/events.rpy:2439
translate russian hanna_event_09_4e6a4aff:
    "Мы устраиваемся смотреть выступления девушек, записавшихся на сцену."

# ch/hanna/events.rpy:2440
translate russian hanna_event_09_9e11902a:
    "Не могу сказать, что наслаждаюсь шоу так же, как мог бы при других обстоятельствах."

# ch/hanna/events.rpy:2441
translate russian hanna_event_09_d2bd21fd:
    "Но Ханна всё это время держит меня за руку под столом."

# ch/hanna/events.rpy:2442
translate russian hanna_event_09_750de27e:
    "И это радует меня больше любого любительского стриптиза."

# ch/hanna/events.rpy:2446
translate russian hanna_event_09_2e1acef5:
    "Не скажу, что мне нравится идея всеобщего внимания к Ханне на сцене."

# ch/hanna/events.rpy:2447
translate russian hanna_event_09_a1fdab12:
    "Но трусить тоже не собираюсь: прийти сюда предложил я."

# ch/hanna/events.rpy:2451
translate russian hanna_event_09_80409d9c:
    "Быстро оглядываю её привычно короткий и откровенный наряд."

# ch/hanna/events.rpy:2458
translate russian hanna_event_09_19730406:
    "Потом смотрю на других девушек, ждущих очереди или записывающихся на выступление."

# ch/hanna/events.rpy:2462
translate russian hanna_event_09_b732e6b5:
    "Ханна без труда затмевает любую из них, да и одета подходяще."

# ch/hanna/events.rpy:2463
translate russian hanna_event_09_2fc5e258:
    "К тому же при приглушённом свете я никого здесь не узнаю."

# ch/hanna/events.rpy:2464
translate russian hanna_event_09_5f2a02fe:
    mike.say "А, какого чёрта."

# ch/hanna/events.rpy:2465
translate russian hanna_event_09_5473b21e:
    mike.say "Обязательно попробуй."

# ch/hanna/events.rpy:2469
translate russian hanna_event_09_96577a73:
    hanna.say "Ты правда так думаешь, [lssb_hanna.hero_name()]?"

# ch/hanna/events.rpy:2471
translate russian hanna_event_09_852e7770:
    mike.say "Конечно!"

# ch/hanna/events.rpy:2472
translate russian hanna_event_09_742e2960:
    mike.say "Уверен, у тебя талант, Ханна."

# ch/hanna/events.rpy:2475
translate russian hanna_event_09_42b04543:
    "По её лицу расплывается восторженная, довольная улыбка."

# ch/hanna/events.rpy:2479
translate russian hanna_event_09_b281765e:
    "Мгновение спустя она уже спешит к бару, чтобы вписать своё имя."

# ch/hanna/events.rpy:2480
translate russian hanna_event_09_29789ad0:
    "После этого время до её выхода на сцену будто ускоряется."

# ch/hanna/events.rpy:2481
translate russian hanna_event_09_4a627ba8:
    "Смотрю на выступающих перед ней любительниц и пытаюсь вести непринуждённую беседу."

# ch/hanna/events.rpy:2482
translate russian hanna_event_09_a39054cf:
    "Но сосредоточиться дольше чем на пару секунд не получается."

# ch/hanna/events.rpy:2483
translate russian hanna_event_09_fee257fe:
    "Все мысли о том, что я увижу, когда настанет её очередь."

# ch/hanna/events.rpy:2484
translate russian hanna_event_09_0aef6293:
    "Да, за время знакомства я немало часов провёл, разглядывая тело Ханны."

# ch/hanna/events.rpy:2485
translate russian hanna_event_09_42304c94:
    "И разве меня можно винить?"

# ch/hanna/events.rpy:2486
translate russian hanna_event_09_18e98602:
    "Знаю, что она тоже не из стеснительных."

# ch/hanna/events.rpy:2487
translate russian hanna_event_09_2123ebb7:
    "Но впервые она будет делать это открыто, без всяких предлогов."

# ch/hanna/events.rpy:2488
translate russian hanna_event_09_58fcca5f:
    "Почему-то от этого предстоящее зрелище волнует ещё сильнее."

# ch/hanna/events.rpy:2489
translate russian hanna_event_09_6ef4a484:
    "Словно раньше был только флирт, а теперь всё по-настоящему."

# ch/hanna/events.rpy:2490
translate russian hanna_event_09_d4880de1:
    "Поэтому, когда объявляют выход Ханны, я оказываюсь совершенно не готов."

# ch/hanna/events.rpy:2496
translate russian hanna_event_09_e3d859ee:
    "Не успеваю пожелать удачи, как она уже вскакивает и выходит."

# ch/hanna/events.rpy:2497
translate russian hanna_event_09_b97297fe:
    "Под светом софитов Ханна на миг замирает и глубоко вдыхает."

# ch/hanna/events.rpy:2498
translate russian hanna_event_09_6f060951:
    "Но едва начинает греметь музыка, вся нервозность исчезает."

# ch/hanna/events.rpy:2501
translate russian hanna_event_09_634bad44:
    "Она вскидывает голову, берётся одной рукой за пилон и начинает обходить его."

# ch/hanna/events.rpy:2502
translate russian hanna_event_09_5e4eb769:
    "Дальше происходит настоящее откровение: такое выступление я забуду нескоро."

# ch/hanna/events.rpy:2503
translate russian hanna_event_09_d4fa35dc:
    "Ханна двигается так, будто хочет показать каждому в зале всё, на что способна."

# ch/hanna/events.rpy:2504
translate russian hanna_event_09_532a561f:
    "Её стройное, подтянутое тело не позволяет отвести взгляд даже на секунду."

# ch/hanna/events.rpy:2507
translate russian hanna_event_09_2519ff82:
    "Только что она стояла на ногах — и вот уже висит на пилоне вниз головой."

# ch/hanna/events.rpy:2508
translate russian hanna_event_09_ddb6a943:
    "Каждое движение плавное, дерзкое и наполнено уверенностью."

# ch/hanna/events.rpy:2509
translate russian hanna_event_09_f3340a73:
    "Так вот что Ханна представляла себе?"

# ch/hanna/events.rpy:2510
translate russian hanna_event_09_bcf2c228:
    "Об этом мечтала, когда вела занятия или ловила восхищённые взгляды на улице?"

# ch/hanna/events.rpy:2511
translate russian hanna_event_09_412ca84f:
    "Если да, я наконец понимаю её улыбку в такие моменты."

# ch/hanna/events.rpy:2512
translate russian hanna_event_09_3fedc65e:
    "И эту непреодолимую тягу красоваться!"

# ch/hanna/events.rpy:2516
translate russian hanna_event_09_e337164f:
    "Её выступление завораживает меня."

# ch/hanna/events.rpy:2517
translate russian hanna_event_09_6f972536:
    "Настолько, что я едва замечаю аплодисменты и свист вокруг."

# ch/hanna/events.rpy:2518
translate russian hanna_event_09_caa0ce30:
    "Возможно, потому, что она старательно не сводит с меня глаз."

# ch/hanna/events.rpy:2519
translate russian hanna_event_09_8a1a7012:
    "И хотя публика в восторге, мне кажется, будто Ханна танцует только для меня."

# ch/hanna/events.rpy:2524
translate russian hanna_event_09_8dc84836:
    "Отведённое ей время заканчивается слишком быстро."

# ch/hanna/events.rpy:2526
translate russian hanna_event_09_289996d6:
    "К всеобщему разочарованию ей приходится покинуть сцену."

# ch/hanna/events.rpy:2527
translate russian hanna_event_09_48d8929f:
    "Я всё ещё немного ошеломлён, когда она садится рядом."

# ch/hanna/events.rpy:2528
translate russian hanna_event_09_7b05dc88:
    "Но тут чувствую, как под столом её рука сжимает мой член через брюки." with vpunch

# ch/hanna/events.rpy:2530
translate russian hanna_event_09_011ecc32:
    hanna.say "М-м-м..."

# ch/hanna/events.rpy:2534
translate russian hanna_event_09_63716e37:
    hanna.say "Похоже, ты под большим впечатлением, [lssb_hanna.hero_name()]!"

# ch/hanna/events.rpy:2536
translate russian hanna_event_09_b1217d3a:
    mike.say "А... я... пожалуй, да, Ханна!"

# ch/hanna/events.rpy:2538
translate russian hanna_event_09_1128f397:
    hanna.say "Чтобы ты знал: я думала о том, что сейчас держу в руке."

# ch/hanna/events.rpy:2543
translate russian hanna_event_09_a612887d:
    hanna.say "Только об этом всё время на сцене!"

# ch/hanna/events.rpy:2545
translate russian hanna_event_09_5d5d620e:
    "Я лишь громко сглатываю и хватаюсь за напиток: в горле вдруг пересохло."

# ch/hanna/events.rpy:2547
translate russian hanna_event_09_9599a0d2:
    "Ханна смеётся над моим возбуждённым замешательством, пока музыка не объявляет следующее выступление."

# ch/hanna/events.rpy:2549
translate russian hanna_event_09_89170185:
    "Остаток вечера мы в приятном молчании смотрим других любительниц."

# ch/hanna/events.rpy:2550
translate russian hanna_event_09_087ef940:
    "И до самого ухода она ни разу не убирает руку..."

# ch/hanna/events.rpy:2563
translate russian hanna_event_09a_1c076ec8:
    "Признаю: рестораны Ханна выбирает со вкусом."

# ch/hanna/events.rpy:2564
translate russian hanna_event_09a_79e8c704:
    "И, похоже, не поленилась заранее позвонить и заказать столик."

# ch/hanna/events.rpy:2570
translate russian hanna_event_09a_f19b8b6d:
    "Стоит нам войти, как она уверенно направляется к первому же официанту."

# ch/hanna/events.rpy:2572
translate russian hanna_event_09a_bdac5eb8:
    hanna.say "Извините..."

# ch/hanna/events.rpy:2573
translate russian hanna_event_09a_3f87cd5c:
    "Официант" "Да, мадам?"

# ch/hanna/events.rpy:2575
translate russian hanna_event_09a_b888f0b7:
    hanna.say "У нас заказан столик на двоих."

# ch/hanna/events.rpy:2576
translate russian hanna_event_09a_bdf8ce53:
    hanna.say "На имя Ханны."

# ch/hanna/events.rpy:2578
translate russian hanna_event_09a_38eadf2d:
    "Официант подходит к небольшой стойке у входа и проверяет список."

# ch/hanna/events.rpy:2579
translate russian hanna_event_09a_c8925728:
    "Потом поднимает глаза с елейной улыбкой."

# ch/hanna/events.rpy:2580
translate russian hanna_event_09a_c6bffd86:
    "Официант" "Ах да..."

# ch/hanna/events.rpy:2581
translate russian hanna_event_09a_3dac22b9:
    "Официант" "Вот, нашёл."

# ch/hanna/events.rpy:2582
translate russian hanna_event_09a_4e84bff7:
    "Официант" "Прошу за мной..."

# ch/hanna/events.rpy:2585
translate russian hanna_event_09a_51d55e6d:
    "Мы с Ханной следуем за ним к столику."

# ch/hanna/events.rpy:2587
translate russian hanna_event_09a_4f96c2b6:
    "Как и сам ресторан, столик производит на меня впечатление."

# ch/hanna/events.rpy:2590
translate russian hanna_event_09a_3ad29a85:
    "Ханна это замечает и сияет, глядя на меня через стол."

# ch/hanna/events.rpy:2591
translate russian hanna_event_09a_4d3aa67e:
    hanna.say "Полагаю, ты одобряешь, [lssb_hanna.hero_name()]?"

# ch/hanna/events.rpy:2592
translate russian hanna_event_09a_a18a5f90:
    hanna.say "Тебе нравится?"

# ch/hanna/events.rpy:2593
translate russian hanna_event_09a_edccf7c2:
    mike.say "Прекрасное место, Ханна!"

# ch/hanna/events.rpy:2594
translate russian hanna_event_09a_c301fe55:
    mike.say "Но..."

# ch/hanna/events.rpy:2595
translate russian hanna_event_09a_d5b1cdf0:
    mike.say "И, кажется, довольно дорогое!"

# ch/hanna/events.rpy:2597
translate russian hanna_event_09a_42cab1d0:
    "Она демонстративно качает головой и отмахивается."

# ch/hanna/events.rpy:2599
translate russian hanna_event_09a_50420663:
    hanna.say "Не волнуйся об этом."

# ch/hanna/events.rpy:2600
translate russian hanna_event_09a_399448f4:
    hanna.say "Теперь, когда зал снова на плаву, я легко могу себе это позволить."

# ch/hanna/events.rpy:2601
translate russian hanna_event_09a_fdf094fe:
    hanna.say "К тому же сегодня угощаю я."

# ch/hanna/events.rpy:2602
translate russian hanna_event_09a_cc5f8d8a:
    hanna.say "Так я благодарю тебя за спасение, помнишь?"

# ch/hanna/events.rpy:2603
translate russian hanna_event_09a_52a435de:
    "Напоминание о займе вызывает у меня нервную улыбку."

# ch/hanna/events.rpy:2604
translate russian hanna_event_09a_a4ebe1a2:
    "Я невольно чешу затылок, пытаясь справиться со смущением."

# ch/hanna/events.rpy:2605
translate russian hanna_event_09a_f1d8a63c:
    mike.say "Эм..."

# ch/hanna/events.rpy:2606
translate russian hanna_event_09a_9c21f3a9:
    mike.say "Не нужно постоянно об этом говорить, Ханна!"

# ch/hanna/events.rpy:2607
translate russian hanna_event_09a_823eef72:
    mike.say "Как я уже сказал, любой настоящий друг поступил бы так же."

# ch/hanna/events.rpy:2609
translate russian hanna_event_09a_d33f2abc:
    "Ханна со смешком закатывает глаза."

# ch/hanna/events.rpy:2611
translate russian hanna_event_09a_99e9c4c9:
    hanna.say "Тебе правда пора перестать это делать, [lssb_hanna.hero_name()]."

# ch/hanna/events.rpy:2612
translate russian hanna_event_09a_bbfe54c9:
    hanna.say "От того, что ты повторяешь это снова и снова..."

# ch/hanna/events.rpy:2613
translate russian hanna_event_09a_6afc4c46:
    hanna.say "Правдой оно не станет!"

# ch/hanna/events.rpy:2616
translate russian hanna_event_09a_6d22f0fa:
    "Она протягивает руку через стол и берёт мою."

# ch/hanna/events.rpy:2617
translate russian hanna_event_09a_67d31d05:
    "Крепко сжимает, улыбаясь ещё шире."

# ch/hanna/events.rpy:2618
translate russian hanna_event_09a_75a519e6:
    hanna.say "Ты дал мне взаймы, потому что ты совершенно особенный друг."

# ch/hanna/events.rpy:2619
translate russian hanna_event_09a_2855ae98:
    hanna.say "Один на миллион. Такие встречаются раз в жизни."

# ch/hanna/events.rpy:2620
translate russian hanna_event_09a_1c46d09d:
    hanna.say "Я этого никогда не забуду."

# ch/hanna/events.rpy:2621
translate russian hanna_event_09a_3560f059:
    hanna.say "И вот первый шаг к тому, чтобы отплатить тебе..."

# ch/hanna/events.rpy:2623
translate russian hanna_event_09a_4081a25a:
    "Неожиданно Ханна достаёт из-под стола вторую руку."

# ch/hanna/events.rpy:2627
translate russian hanna_event_09a_e6c60c0c:
    "И кладёт передо мной толстую пачку купюр." with vpunch

# ch/hanna/events.rpy:2628
translate russian hanna_event_09a_d16d97a4:
    "Несколько секунд я могу лишь удивлённо моргать."

# ch/hanna/events.rpy:2629
translate russian hanna_event_09a_ae9ece6b:
    "Потом понимаю, что это."

# ch/hanna/events.rpy:2630
translate russian hanna_event_09a_2d04e00e:
    mike.say "Ханна..."

# ch/hanna/events.rpy:2631
translate russian hanna_event_09a_b5c10683:
    mike.say "Это..."

# ch/hanna/events.rpy:2633
translate russian hanna_event_09a_43e4bb47:
    hanna.say "Всё, что ты мне одолжил, до последнего цента, [lssb_hanna.hero_name()]."

# ch/hanna/events.rpy:2634
translate russian hanna_event_09a_95c8ce43:
    hanna.say "Можешь пересчитать, если хочешь."

# ch/hanna/events.rpy:2635
translate russian hanna_event_09a_67b94ebf:
    hanna.say "Я не обижусь!"

# ch/hanna/events.rpy:2637
translate russian hanna_event_09a_4d62a9a9:
    "Я смотрю на пачку, потом снова на Ханну."

# ch/hanna/events.rpy:2638
translate russian hanna_event_09a_92805c12:
    "И на мгновение совершенно теряю дар речи."

# ch/hanna/events.rpy:2639
translate russian hanna_event_09a_3c602100:
    "Меньше всего я ожидал именно этого!"

# ch/hanna/events.rpy:2644
translate russian hanna_event_09a_b8ebb07f:
    "Быстро оглядываю ресторан, надеясь, что никто не заметил деньги."

# ch/hanna/events.rpy:2645
translate russian hanna_event_09a_3a839a69:
    "Затем протягиваю руку и забираю пачку, решив, что так будет лучше."

# ch/hanna/events.rpy:2646
translate russian hanna_event_09a_c7bcdd95:
    "Торопливо запихиваю её в задний карман брюк и неловко улыбаюсь."

# ch/hanna/events.rpy:2648
translate russian hanna_event_09a_f1d8a63c_1:
    mike.say "Эм..."

# ch/hanna/events.rpy:2649
translate russian hanna_event_09a_2da83f43:
    mike.say "Спасибо, Ханна..."

# ch/hanna/events.rpy:2650
translate russian hanna_event_09a_d19e6d80:
    mike.say "Но уверен, всё на месте!"

# ch/hanna/events.rpy:2651
translate russian hanna_event_09a_3dfc1ce8:
    "Хотя денег больше не видно, я всё равно их чувствую."

# ch/hanna/events.rpy:2652
translate russian hanna_event_09a_dcd06d1e:
    "Потому что карман теперь буквально трещит по швам."

# ch/hanna/events.rpy:2653
translate russian hanna_event_09a_79756fcd:
    mike.say "Знаешь..."

# ch/hanna/events.rpy:2654
translate russian hanna_event_09a_11b64e18:
    mike.say "Можно было просто сделать перевод."

# ch/hanna/events.rpy:2655
translate russian hanna_event_09a_ed5ce47f:
    mike.say "Или хотя бы выписать чек."

# ch/hanna/events.rpy:2657
translate russian hanna_event_09a_3a7b7257:
    "Ханна улыбается и пожимает плечами."

# ch/hanna/events.rpy:2658
translate russian hanna_event_09a_a6ca95bb:
    "Явно не замечая моего неудобства."

# ch/hanna/events.rpy:2659
translate russian hanna_event_09a_78f19383:
    hanna.say "Не-а..."

# ch/hanna/events.rpy:2660
translate russian hanna_event_09a_4fa7a9d9:
    hanna.say "Зато так ты это навсегда запомнишь!"

# ch/hanna/events.rpy:2662
translate russian hanna_event_09a_9ccdf74b:
    "Весь оставшийся ужин пачка упирается мне в зад."

# ch/hanna/events.rpy:2663
translate russian hanna_event_09a_d549687d:
    "И я уже гадаю, что, чёрт возьми, с ней делать."

# ch/hanna/events.rpy:2664
translate russian hanna_event_09a_92abffc6:
    "Отнести в банк и попытаться внести всю сумму?"

# ch/hanna/events.rpy:2665
translate russian hanna_event_09a_2f5853e9:
    "Или забрать домой и спрятать в матрас на чёрный день?"

# ch/hanna/events.rpy:2669
translate russian hanna_event_09a_b8ebb07f_1:
    "Быстро оглядываю ресторан, надеясь, что никто не заметил деньги."

# ch/hanna/events.rpy:2670
translate russian hanna_event_09a_cb78ea7c:
    "Затем решительно отодвигаю пачку обратно к Ханне."

# ch/hanna/events.rpy:2671
translate russian hanna_event_09a_085a7a0d:
    "Ей остаётся лишь убрать деньги туда, откуда достала."

# ch/hanna/events.rpy:2673
translate russian hanna_event_09a_aab0c852:
    "Но видно, что мой поступок сильно её озадачил."

# ch/hanna/events.rpy:2674
translate russian hanna_event_09a_aea9275b:
    hanna.say "Что такое, [lssb_hanna.hero_name()]?"

# ch/hanna/events.rpy:2675
translate russian hanna_event_09a_59b0eeed:
    hanna.say "Это твои деньги."

# ch/hanna/events.rpy:2676
translate russian hanna_event_09a_da873859:
    hanna.say "Ты не хочешь их забрать?"

# ch/hanna/events.rpy:2678
translate russian hanna_event_09a_b26beead:
    "Я качаю головой и пытаюсь объясниться."

# ch/hanna/events.rpy:2679
translate russian hanna_event_09a_2cb511d3:
    mike.say "Послушай, Ханна..."

# ch/hanna/events.rpy:2680
translate russian hanna_event_09a_58663f67:
    mike.say "Я не хвастаюсь."

# ch/hanna/events.rpy:2681
translate russian hanna_event_09a_5cba1477:
    mike.say "Но возвращать мне деньги действительно необязательно."

# ch/hanna/events.rpy:2682
translate russian hanna_event_09a_ea0e33ee:
    mike.say "Хочу, чтобы ты оставила их себе. Это подарок."

# ch/hanna/events.rpy:2684
translate russian hanna_event_09a_932d3a41:
    "Ханна выглядит совершенно ошеломлённой."

# ch/hanna/events.rpy:2685
translate russian hanna_event_09a_bc76e728:
    "Несколько раз моргает."

# ch/hanna/events.rpy:2686
translate russian hanna_event_09a_0e2035ee:
    "И наконец находит слова."

# ch/hanna/events.rpy:2687
translate russian hanna_event_09a_aa84dfa8:
    hanna.say "Ладно, [lssb_hanna.hero_name()]..."

# ch/hanna/events.rpy:2688
translate russian hanna_event_09a_9673e833:
    hanna.say "Если ты действительно этого хочешь."

# ch/hanna/events.rpy:2689
translate russian hanna_event_09a_bfb5df0c:
    hanna.say "Мне снова вложить их в спортзал?"

# ch/hanna/events.rpy:2690
translate russian hanna_event_09a_0c12cf06:
    "Я пожимаю плечами."

# ch/hanna/events.rpy:2691
translate russian hanna_event_09a_160492de:
    mike.say "Если считаешь, что так лучше, Ханна."

# ch/hanna/events.rpy:2692
translate russian hanna_event_09a_da1207f3:
    mike.say "Но можешь потратить их как захочешь."

# ch/hanna/events.rpy:2693
translate russian hanna_event_09a_071dc6cd:
    mike.say "Мне будет приятно просто знать, что я тебе помог."

# ch/hanna/events.rpy:2695
translate russian hanna_event_09a_e14c4064:
    "До конца ужина Ханна остаётся слегка ошеломлённой."

# ch/hanna/events.rpy:2698
translate russian hanna_event_09a_04a7d3dd:
    "Но я замечаю, что смотрит она на меня пристальнее прежнего."

# ch/hanna/events.rpy:2699
translate russian hanna_event_09a_46b5f34c:
    "Кажется, вообще не может отвести глаз."

# ch/hanna/events.rpy:2703
translate russian hanna_event_09a_b8ebb07f_2:
    "Быстро оглядываю ресторан, надеясь, что никто не заметил деньги."

# ch/hanna/events.rpy:2704
translate russian hanna_event_09a_cb78ea7c_1:
    "Затем решительно отодвигаю пачку обратно к Ханне."

# ch/hanna/events.rpy:2705
translate russian hanna_event_09a_085a7a0d_1:
    "Ей остаётся лишь убрать деньги туда, откуда достала."

# ch/hanna/events.rpy:2707
translate russian hanna_event_09a_aab0c852_1:
    "Но видно, что мой поступок сильно её озадачил."

# ch/hanna/events.rpy:2708
translate russian hanna_event_09a_aea9275b_1:
    hanna.say "Что такое, [lssb_hanna.hero_name()]?"

# ch/hanna/events.rpy:2709
translate russian hanna_event_09a_59b0eeed_1:
    hanna.say "Это твои деньги."

# ch/hanna/events.rpy:2710
translate russian hanna_event_09a_da873859_1:
    hanna.say "Ты не хочешь их забрать?"

# ch/hanna/events.rpy:2712
translate russian hanna_event_09a_b26beead_1:
    "Я качаю головой и пытаюсь объясниться."

# ch/hanna/events.rpy:2713
translate russian hanna_event_09a_2ea627c5:
    mike.say "Ты сказала, это вложение помогло спортзалу снова встать на ноги?"

# ch/hanna/events.rpy:2714
translate russian hanna_event_09a_96fde87d:
    "Ханна кивает."

# ch/hanna/events.rpy:2715
translate russian hanna_event_09a_ba425a2c:
    hanna.say "Да, [lssb_hanna.hero_name()]..."

# ch/hanna/events.rpy:2716
translate russian hanna_event_09a_04cc9881:
    hanna.say "Мы погасили долги и обновили то, что давно пора было заменить."

# ch/hanna/events.rpy:2718
translate russian hanna_event_09a_1c71e30e:
    hanna.say "Но сейчас уже заработали больше этой суммы."

# ch/hanna/events.rpy:2719
translate russian hanna_event_09a_284089c0:
    hanna.say "Так что можешь забрать её обратно."

# ch/hanna/events.rpy:2721
translate russian hanna_event_09a_802a6ba7:
    mike.say "А если снова вложить деньги в спортзал?"

# ch/hanna/events.rpy:2722
translate russian hanna_event_09a_d7d9688a:
    mike.say "И ты позволишь мне стать совладельцем небольшой доли?"

# ch/hanna/events.rpy:2724
translate russian hanna_event_09a_932d3a41_1:
    "Ханна выглядит совершенно ошеломлённой."

# ch/hanna/events.rpy:2725
translate russian hanna_event_09a_bc76e728_1:
    "Несколько раз моргает."

# ch/hanna/events.rpy:2726
translate russian hanna_event_09a_0e2035ee_1:
    "И наконец находит слова."

# ch/hanna/events.rpy:2727
translate russian hanna_event_09a_aa84dfa8_1:
    hanna.say "Ладно, [lssb_hanna.hero_name()]..."

# ch/hanna/events.rpy:2728
translate russian hanna_event_09a_9673e833_1:
    hanna.say "Если ты действительно этого хочешь."

# ch/hanna/events.rpy:2730
translate russian hanna_event_09a_54b9adb3:
    hanna.say "Мы станем деловыми партнёрами!"

# ch/hanna/events.rpy:2731
translate russian hanna_event_09a_9ae84223:
    "Я улыбаюсь и киваю."

# ch/hanna/events.rpy:2732
translate russian hanna_event_09a_3b2acbff:
    mike.say "Мне нравится эта мысль, Ханна."

# ch/hanna/events.rpy:2733
translate russian hanna_event_09a_23db250b:
    mike.say "Мы ведь хорошо ладим?"

# ch/hanna/events.rpy:2734
translate russian hanna_event_09a_d44d7939:
    mike.say "Думаю, и партнёрами по бизнесу будем хорошими."

# ch/hanna/events.rpy:2736
translate russian hanna_event_09a_e14c4064_1:
    "До конца ужина Ханна остаётся слегка ошеломлённой."

# ch/hanna/events.rpy:2739
translate russian hanna_event_09a_04a7d3dd_1:
    "Но я замечаю, что смотрит она на меня пристальнее прежнего."

# ch/hanna/events.rpy:2740
translate russian hanna_event_09a_46b5f34c_1:
    "Кажется, вообще не может отвести глаз."

# ch/hanna/events.rpy:2747
translate russian missed_hanna_event_09a_8fc3cd1e:
    "Я пропустил свидание с Ханной."

# ch/hanna/events.rpy:2758
translate russian hanna_event_10_88f7cc4f:
    "Сегодня один из тех дней, когда всё складывается удачно."

# ch/hanna/events.rpy:2759
translate russian hanna_event_10_3db82005:
    "Не то чтобы я выиграл в лотерею. Просто мелочи, понимаете?"

# ch/hanna/events.rpy:2760
translate russian hanna_event_10_84167d47:
    "В кофейне нет очереди, светофоры вовремя переключаются на зелёный."

# ch/hanna/events.rpy:2761
translate russian hanna_event_10_d339ff52:
    "А теперь и тренировка идёт как по маслу."

# ch/hanna/events.rpy:2765
translate russian hanna_event_10_1a7c8ced:
    "Программа обычная, но к её завершению я чувствую невероятный подъём."

# ch/hanna/events.rpy:2766
translate russian hanna_event_10_90fec63e:
    "Наверное, он заметен не только в настроении, но и внешне."

# ch/hanna/events.rpy:2770
translate russian hanna_event_10_39508e9f:
    "Потому что, подняв глаза, я вижу неподалёку наблюдающую за мной Ханну."

# ch/hanna/events.rpy:2771
translate russian hanna_event_10_a099c0d7:
    "Я невольно улыбаюсь ей: настроение прекрасное."

# ch/hanna/events.rpy:2772
translate russian hanna_event_10_b42cdd66:
    "К тому же в рабочей обтягивающей лайкре она всегда выглядит отлично."

# ch/hanna/events.rpy:2776
translate russian hanna_event_10_703dd295:
    "Ханна улыбается в ответ, затем оглядывается, словно что-то ищет."

# ch/hanna/events.rpy:2777
translate russian hanna_event_10_22689d4e:
    "С недоумением и растущим интересом смотрю, как она возится с дверью."

# ch/hanna/events.rpy:2780
translate russian hanna_event_10_400c3be4:
    "Открываю рот, чтобы спросить, что она делает."

# ch/hanna/events.rpy:2783
translate russian hanna_event_10_76e87f28:
    "Но она уже спешит ко мне."

# ch/hanna/events.rpy:2784
translate russian hanna_event_10_632f48bf:
    mike.say "Привет, Ханна..."

# ch/hanna/events.rpy:2785
translate russian hanna_event_10_47366b2a:
    mike.say "Что такое?"

# ch/hanna/events.rpy:2787
translate russian hanna_event_10_42077a8e:
    hanna.say "Да ничего..."

# ch/hanna/events.rpy:2788
translate russian hanna_event_10_0a512712:
    hanna.say "Просто хотела узнать, ты уже закончил тренировку?"

# ch/hanna/events.rpy:2790
translate russian hanna_event_10_dcbb2b78:
    "Я небрежно пожимаю плечами и киваю."

# ch/hanna/events.rpy:2791
translate russian hanna_event_10_cf63fa99:
    mike.say "Только что."

# ch/hanna/events.rpy:2792
translate russian hanna_event_10_88f64c97:
    mike.say "А что?"

# ch/hanna/events.rpy:2794
translate russian hanna_event_10_d1bec8c1:
    "Лишь теперь замечаю, что Ханна будто что-то скрывает."

# ch/hanna/events.rpy:2795
translate russian hanna_event_10_b8e24b6e:
    "Лгать она явно не мастерица."

# ch/hanna/events.rpy:2796
translate russian hanna_event_10_4fa86efb:
    "И сейчас выдаёт себя почти всеми возможными способами."

# ch/hanna/events.rpy:2798
translate russian hanna_event_10_5d44aa99:
    hanna.say "Просто так..."

# ch/hanna/events.rpy:2800
translate russian hanna_event_10_40830018:
    hanna.say "Хотела поговорить о том, чтобы кое-что добавить в твою программу."

# ch/hanna/events.rpy:2801
translate russian hanna_event_10_2b4c5ed5:
    mike.say "Думаешь, мне нужно заниматься ещё больше?"

# ch/hanna/events.rpy:2803
translate russian hanna_event_10_b8f45fab:
    hanna.say "Думаю, прямо сейчас тебе стоит заняться кое-чем ещё."

# ch/hanna/events.rpy:2804
translate russian hanna_event_10_9c12cca4:
    mike.say "Вот как?"

# ch/hanna/events.rpy:2805
translate russian hanna_event_10_d3122af2:
    mike.say "И чем же?"

# ch/hanna/events.rpy:2809
translate russian hanna_event_10_dd459102:
    hanna.say "Мной!"

# ch/hanna/events.rpy:2810
translate russian hanna_event_10_f45e3b8e:
    "Подчёркивая свои слова, Ханна наклоняется ближе."

# ch/hanna/events.rpy:2816
translate russian hanna_event_10_b95bdbe7:
    "Целует меня прямо в губы."

# ch/hanna/events.rpy:2817
translate russian hanna_event_10_9679580d:
    "И её язык скользит мне в рот."

# ch/hanna/events.rpy:2820
translate russian hanna_event_10_631fe4c1:
    "Я отвечаю на поцелуй, не в силах сопротивляться ни секунды."

# ch/hanna/events.rpy:2821
translate russian hanna_event_10_80baae56:
    "Хватаю Ханну за задницу и сжимаю её через лайкру."

# ch/hanna/events.rpy:2822
translate russian hanna_event_10_16172ea9:
    "Чувствую, как её упругое, женственное тело прижимается к моему."

# ch/hanna/events.rpy:2823
translate russian hanna_event_10_e9632511:
    "Хочется просунуть руку под тесную эластичную ткань."

# ch/hanna/events.rpy:2824
translate russian hanna_event_10_4f5c9fba:
    "Выше талии — и обхватить грудь ладонью."

# ch/hanna/events.rpy:2825
translate russian hanna_event_10_9847f73c:
    "Или ниже — проверить, насколько мокро у неё между ног."

# ch/hanna/events.rpy:2826
translate russian hanna_event_10_59a7f433:
    "Ханне, похоже, приходит в голову нечто подобное."

# ch/hanna/events.rpy:2827
translate russian hanna_event_10_d7d82776:
    "Я чувствую, как она гладит мой всё более твёрдый член."

# ch/hanna/events.rpy:2830
translate russian hanna_event_10_f3cf10fc:
    "Но тут вспоминаю, где мы."

# ch/hanna/events.rpy:2832
translate russian hanna_event_10_269c9cf1:
    "Да, Ханна, может, и занимает высокую должность в спортзале."

# ch/hanna/events.rpy:2833
translate russian hanna_event_10_09a1300f:
    "Но это не значит, что ей можно попадаться в такой ситуации!"

# ch/hanna/events.rpy:2834
translate russian hanna_event_10_ec614f9c:
    "Чтобы замять скандал, её почти наверняка придётся уволить."

# ch/hanna/events.rpy:2835
translate russian hanna_event_10_35163448:
    "Поэтому через мгновение я прерываю поцелуй."

# ch/hanna/events.rpy:2840
translate russian hanna_event_10_011ecc32:
    hanna.say "М-м-м..."

# ch/hanna/events.rpy:2844
translate russian hanna_event_10_2f42555c:
    hanna.say "А?!"

# ch/hanna/events.rpy:2845
translate russian hanna_event_10_277c58be:
    hanna.say "Что случилось?"

# ch/hanna/events.rpy:2847
translate russian hanna_event_10_6f33ea21:
    hanna.say "Я уже была готова идти до конца!"

# ch/hanna/events.rpy:2848
translate russian hanna_event_10_4e9d5843:
    mike.say "Я тоже, Ханна."

# ch/hanna/events.rpy:2849
translate russian hanna_event_10_6818c41b:
    mike.say "Но не хочу, чтобы тебя застукали!"

# ch/hanna/events.rpy:2851
translate russian hanna_event_10_5de12809:
    "Она качает головой и хихикает."

# ch/hanna/events.rpy:2853
translate russian hanna_event_10_3bd5c6f4:
    hanna.say "Не переживай, [lssb_hanna.hero_name()]."

# ch/hanna/events.rpy:2855
translate russian hanna_event_10_f900f73f:
    hanna.say "Я заперла дверь, когда вошла."

# ch/hanna/events.rpy:2856
translate russian hanna_event_10_9349b60c:
    hanna.say "А запись с камер потом сотру."

# ch/hanna/events.rpy:2858
translate russian hanna_event_10_0f29c140:
    "Так вот чем она занималась у входа!"

# ch/hanna/events.rpy:2859
translate russian hanna_event_10_86d07102:
    mike.say "А..."

# ch/hanna/events.rpy:2860
translate russian hanna_event_10_b46f73d4:
    mike.say "Ладно, Ханна..."

# ch/hanna/events.rpy:2861
translate russian hanna_event_10_e384c13c:
    mike.say "Теперь чувствую себя глупо!"

# ch/hanna/events.rpy:2863
translate russian hanna_event_10_644e7294:
    hanna.say "Ничего, [lssb_hanna.hero_name()]."

# ch/hanna/events.rpy:2866
translate russian hanna_event_10_a2ec17f7:
    hanna.say "Так... на чём мы остановились?"

# ch/hanna/events.rpy:2869
translate russian hanna_event_10_b744f56b:
    "Говоря это, Ханна уже начинает раздеваться."

# ch/hanna/events.rpy:2871
translate russian hanna_event_10_ed98be58:
    "Я с нескрываемым восторгом смотрю, как она снимает топ."

# ch/hanna/events.rpy:2872
translate russian hanna_event_10_049225d0:
    "Затем, пока грудь покачивается от движений, она стягивает легинсы."

# ch/hanna/events.rpy:2873
translate russian hanna_event_10_9b6799c3:
    "Видимо, вместе с трусиками."

# ch/hanna/events.rpy:2875
translate russian hanna_event_10_a4c6ac11:
    "Потому что теперь она стоит передо мной совершенно голая!"

# ch/hanna/events.rpy:2878
translate russian hanna_event_10_2550c3a7:
    "Медленно опускается на пол и встаёт на четвереньки."

# ch/hanna/events.rpy:2879
translate russian hanna_event_10_f2717b3a:
    "Поднимает задницу и оглядывается через плечо."

# ch/hanna/events.rpy:2883
translate russian hanna_event_10_9cb72aad:
    hanna.say "Чего ждёшь, [lssb_hanna.hero_name()]?"

# ch/hanna/events.rpy:2884
translate russian hanna_event_10_88e01d12:
    hanna.say "Оседлай меня уже!"

# ch/hanna/events.rpy:2886
translate russian hanna_event_10_456ff31d:
    "Я торопливо киваю и срываю с себя одежду."

# ch/hanna/events.rpy:2888
translate russian hanna_event_10_077e0917:
    "Затем опускаюсь позади Ханны и хватаю её обеими руками."

# ch/hanna/events.rpy:2891
translate russian hanna_event_10_14602a37:
    "Она ахает, потом хихикает и игриво виляет передо мной задницей."

# ch/hanna/events.rpy:2893
translate russian hanna_event_10_52d12908:
    "Остаётся лишь решить, куда его направить!"

# ch/hanna/events.rpy:2896
translate russian hanna_event_10_2214695f:
    "Всё происходит торопливо и грязно."

# ch/hanna/events.rpy:2897
translate russian hanna_event_10_ac1cf45b:
    "Будто нас действительно могут застукать!"

# ch/hanna/events.rpy:2898
translate russian hanna_event_10_74e72db4:
    "Но осторожничать из-за этого мне не хочется."

# ch/hanna/events.rpy:2899
translate russian hanna_event_10_d34d9cfd:
    "Наоборот, внезапно тянет повысить ставки до предела."

# ch/hanna/events.rpy:2902
translate russian hanna_event_10_bd549fa9:
    "Поэтому я раздвигаю её ягодицы и направляю член между ними."

# ch/hanna/events.rpy:2904
translate russian hanna_event_10_70d63d79:
    "Она быстро понимает мой замысел."

# ch/hanna/events.rpy:2908
translate russian hanna_event_10_78a5b4c3:
    "Хихикает и подаёт задницу назад."

# ch/hanna/events.rpy:2909
translate russian hanna_event_10_b932fc60:
    "Давая ясно понять, что согласна."

# ch/hanna/events.rpy:2910
translate russian hanna_event_10_5e9dfb73:
    hanna.say "Хочешь мою попку?"

# ch/hanna/events.rpy:2911
translate russian hanna_event_10_9a04f9d6:
    hanna.say "Я не против!"

# ch/hanna/events.rpy:2912
translate russian hanna_event_10_c11c8297:
    hanna.say "Только выложись по полной, [lssb_hanna.hero_name()]!"

# ch/hanna/events.rpy:2914
translate russian hanna_event_10_c4d6de7b:
    "Всё это она говорит, глядя на меня через плечо."

# ch/hanna/events.rpy:2915
translate russian hanna_event_10_fa7b3c16:
    "Я киваю: понял."

# ch/hanna/events.rpy:2916
translate russian hanna_event_10_e21f66a4:
    "Ханна отворачивается, когда я начинаю продвигаться вперёд."

# ch/hanna/events.rpy:2917
translate russian hanna_event_10_4dc25d7a:
    "Её задница невероятно тугая и подтянутая, как всё остальное тело."

# ch/hanna/events.rpy:2918
translate russian hanna_event_10_af5da4be:
    "Но это не значит, что она меня одолеет."

# ch/hanna/events.rpy:2919
translate russian hanna_event_10_baca21dc:
    "Ведь и меня Ханна привела в форму."

# ch/hanna/events.rpy:2920
translate russian hanna_event_10_36fce374:
    "Забавная ирония: она сделала из меня такой образцовый экземпляр."

# ch/hanna/events.rpy:2921
translate russian hanna_event_10_bf6129de:
    "И теперь именно эту силу и выносливость я использую, чтобы войти в неё!"

# ch/hanna/events.rpy:2925
translate russian hanna_event_10_cf8d20fd:
    "Когда головка входит в её задницу, Ханна начинает стонать."

# ch/hanna/events.rpy:2927
translate russian hanna_event_10_077688dd:
    "Я продвигаюсь медленно, но уверенно, сантиметр за сантиметром."

# ch/hanna/events.rpy:2928
translate russian hanna_event_10_041ffb59:
    "От этого удовольствие лишь растягивается."

# ch/hanna/events.rpy:2929
translate russian hanna_event_10_ae4214fd:
    "Для меня погружение туда восхитительно и кажется бесконечным."

# ch/hanna/events.rpy:2930
translate russian hanna_event_10_ea2a35eb:
    "Могу только представить, что ощущает Ханна."

# ch/hanna/events.rpy:2931
translate russian hanna_event_10_3cff6ae1:
    "Хотя по её звукам нетрудно догадаться!"

# ch/hanna/events.rpy:2932
translate russian hanna_event_10_89d2bf47:
    mike.say "Тебе..."

# ch/hanna/events.rpy:2933
translate russian hanna_event_10_094afe92:
    mike.say "Нравится..."

# ch/hanna/events.rpy:2934
translate russian hanna_event_10_e84ffc6f:
    mike.say "Что?"

# ch/hanna/events.rpy:2936
translate russian hanna_event_10_86a9e79d:
    "Сначала Ханна лишь тихо мяукает."

# ch/hanna/events.rpy:2940
translate russian hanna_event_10_2cf03b17:
    "Кивает, словно не в силах говорить."

# ch/hanna/events.rpy:2941
translate russian hanna_event_10_6b1c7ac5:
    "Потом судорожно вздыхает и будто приходит в себя."

# ch/hanna/events.rpy:2942
translate russian hanna_event_10_011ecc32_1:
    hanna.say "М-м-м..."

# ch/hanna/events.rpy:2943
translate russian hanna_event_10_1441914c:
    hanna.say "О да..."

# ch/hanna/events.rpy:2944
translate russian hanna_event_10_9c93ab5e:
    hanna.say "Боже, да!"

# ch/hanna/events.rpy:2945
translate russian hanna_event_10_8f0b415a:
    "К тому моменту я уже глубоко внутри."

# ch/hanna/events.rpy:2946
translate russian hanna_event_10_8dcfd055:
    "Почти настолько глубоко, насколько вообще могу."

# ch/hanna/events.rpy:2947
translate russian hanna_event_10_16ff7360:
    "С другой девушкой я бы сейчас начал волноваться."

# ch/hanna/events.rpy:2948
translate russian hanna_event_10_c3405100:
    "Думал бы о том, как двигаться медленно и осторожно."

# ch/hanna/events.rpy:2950
translate russian hanna_event_10_96748e14:
    "Чтобы не сделать ничего, что оказалось бы для неё чрезмерным."

# ch/hanna/events.rpy:2951
translate russian hanna_event_10_26d055f6:
    "Но такой крепкой и спортивной девушки, как Ханна, у меня, кажется, ещё не было."

# ch/hanna/events.rpy:2952
translate russian hanna_event_10_f48d9ba1:
    "И я знаю: ей по силам всё, что я могу предложить."

# ch/hanna/events.rpy:2954
translate russian hanna_event_10_1c44176a:
    "Поэтому набираю темп так быстро, как могу."

# ch/hanna/events.rpy:2955
translate russian hanna_event_10_22d59edd:
    "Вкладываю все силы в движения внутри неё."

# ch/hanna/events.rpy:2956
translate russian hanna_event_10_6b327d40:
    "Мышцы её задницы по-прежнему крепко сжимают меня."

# ch/hanna/events.rpy:2957
translate russian hanna_event_10_abae509a:
    "Но уже поддались настолько, что двигаться довольно легко."

# ch/hanna/events.rpy:2959
translate russian hanna_event_10_a9f1be61:
    "Я пользуюсь этим и разгоняюсь почти так же, как если бы трахал её в киску."

# ch/hanna/events.rpy:2960
translate russian hanna_event_10_11ecb6fd:
    "Ханна быстро доказывает, что я не ошибся насчёт её выносливости."

# ch/hanna/events.rpy:2961
translate russian hanna_event_10_c4fe7cd5:
    "Почти любая другая уже молила бы о пощаде и просила сбавить темп."

# ch/hanna/events.rpy:2962
translate russian hanna_event_10_862dba5d:
    "А Ханна лишь без конца кивает."

# ch/hanna/events.rpy:2963
translate russian hanna_event_10_8df5a572:
    "И своими стонами словно подгоняет меня."

# ch/hanna/events.rpy:2967
translate russian hanna_event_10_f8eded0c:
    "Её тело принимает всё, что я даю, и хочет ещё!"

# ch/hanna/events.rpy:2968
translate russian hanna_event_10_1fa90a83:
    "Я-то не могу продолжать бесконечно, даже если Ханна способна."

# ch/hanna/events.rpy:2969
translate russian hanna_event_10_8ce38f64:
