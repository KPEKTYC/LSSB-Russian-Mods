    hanna.say "О да..."

# ch/hanna/events.rpy:3060
translate russian hanna_event_10_d73bda50:
    hanna.say "Можешь делать это со мной хоть целый день!"

# ch/hanna/events.rpy:3062
translate russian hanna_event_10_d10447ff:
    "От её похвалы я невольно улыбаюсь."

# ch/hanna/events.rpy:3063
translate russian hanna_event_10_58773f92:
