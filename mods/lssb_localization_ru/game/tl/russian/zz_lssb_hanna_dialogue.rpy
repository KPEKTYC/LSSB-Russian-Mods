    hanna.say "Привет, [lssb_hanna.hero_name()]."

# ch/hanna/base.rpy:87
translate russian hanna_greet_bb202e12:
    hanna.say "Рада тебя видеть, [lssb_hanna.hero_name()]."

# ch/hanna/base.rpy:90
translate russian hanna_greet_1bccffe1:
    hanna.say "Доброе утро, [lssb_hanna.hero_name()]."

# ch/hanna/base.rpy:92
translate russian hanna_greet_6bac87ba:
    hanna.say "Добрый день, [lssb_hanna.hero_name()]."

# ch/hanna/base.rpy:94
translate russian hanna_greet_3daea286:
    hanna.say "Добрый вечер, [lssb_hanna.hero_name()]."

# ch/hanna/base.rpy:98
translate russian hanna_greet_3fb92809:
    hanna.say "Выгуляй меня по улице, как собаку, [lssb_hanna.hero_name()]. Пусть все видят, какая я сучка!"

# ch/hanna/base.rpy:100
translate russian hanna_greet_6b3eaee3:
    hanna.say "Когда я тебя вижу, мне становится... жарко, что ли."

# ch/hanna/base.rpy:101
translate russian hanna_greet_8031e9c5:
    hanna.say "Мне так хочется показать тебе больше. Прямо здесь..."

# ch/hanna/base.rpy:108
