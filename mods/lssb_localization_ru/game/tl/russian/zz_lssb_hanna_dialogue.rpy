# ch/hanna/events.rpy:4361
translate russian hanna_masturbate_041e24a1:
    "Девушка" "О-о... трахни меня, [lssb_hanna.hero_name()]."

# ch/hanna/events.rpy:4362
translate russian hanna_masturbate_6be8ec50:
    "По тому, как она произносит моё имя, можно подумать, будто я приз, ради которого она тренировалась весь сезон."

# ch/hanna/events.rpy:4363
translate russian hanna_masturbate_a53d15ca:
