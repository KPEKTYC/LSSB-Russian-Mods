# ch/hanna/chat.rpy:105
translate russian hanna_good_sweet_talk_male_058e296a:
    mike.say "Мне так повезло быть рядом с такой красавицей."

# ch/hanna/chat.rpy:107
translate russian hanna_good_sweet_talk_male_7b00d431:
    hanna.say "Ах ты, [lssb_hanna.hero_name()], какой льстец!"

# ch/hanna/chat.rpy:108
translate russian hanna_good_sweet_talk_male_2f0854bb:
    hanna.say "Но я бы соврала, сказав, что мне это не нравится!"

# ch/hanna/chat.rpy:110
translate russian hanna_good_sweet_talk_male_20402ccb:
    mike.say "Ты так хорошо следишь за собой, Ханна."

# ch/hanna/chat.rpy:111
translate russian hanna_good_sweet_talk_male_f5e68757:
    mike.say "И результат налицо: выглядишь потрясающе!"

# ch/hanna/chat.rpy:113
translate russian hanna_good_sweet_talk_male_ddd3efa2:
    hanna.say "Ой... спасибо за комплимент!"

# ch/hanna/chat.rpy:114
translate russian hanna_good_sweet_talk_male_9c729472:
    hanna.say "Но я ПРАВДА немало тружусь, чтобы быть в форме."

# ch/hanna/chat.rpy:120
translate russian hanna_bad_sweet_talk_male_72ae2cad:
    mike.say "Здорово, что в наше время и девушка может быть накачанной."

# ch/hanna/chat.rpy:121
translate russian hanna_bad_sweet_talk_male_2c276c56:
    mike.say "Правда, Ханна?"

# ch/hanna/chat.rpy:123
translate russian hanna_bad_sweet_talk_male_3d1cf39b:
    hanna.say "Т... ты считаешь, что я похожа на парня?"

# ch/hanna/chat.rpy:124
translate russian hanna_bad_sweet_talk_male_f9306b56:
    hanna.say "Честно: ты когда-нибудь принимал меня за парня?!"

# ch/hanna/chat.rpy:125
translate russian hanna_bad_sweet_talk_male_2f509c14:
    mike.say "Нет, Ханна, нет!"

# ch/hanna/condom.rpy:4
translate russian hanna_use_condom_06c86696:
    "Но это всё же не повод забывать об осторожности."

# ch/hanna/condom.rpy:5
translate russian hanna_use_condom_95acc0e7:
    "Поэтому я беру презерватив и быстро разрываю упаковку."

# ch/hanna/condom.rpy:6
translate russian hanna_use_condom_c52f4982:
    "Ханна так же быстро кивает, и я понимаю, что мы друг друга поняли."

# ch/hanna/condom.rpy:7
translate russian hanna_use_condom_c4c8da30:
    "Мгновение спустя презерватив надет, и всё готово."

# ch/hanna/condom.rpy:9
translate russian hanna_use_condom_b39793e3:
    "Как бы мне ни хотелось поскорее начать, о предохранении я забывать не собираюсь."

# ch/hanna/condom.rpy:10
translate russian hanna_use_condom_a6522819:
    "Поэтому на миг останавливаюсь, беру презерватив и разрываю упаковку."

# ch/hanna/condom.rpy:11
translate russian hanna_use_condom_fd778d9f:
    "Ханна оглядывается, пытаясь понять причину заминки."

# ch/hanna/condom.rpy:12
translate russian hanna_use_condom_67c2b173:
    "Но, увидев, что я делаю, одобрительно кивает."

# ch/hanna/condom.rpy:14
translate russian hanna_use_condom_22ebf025:
    "Осталась одна мелочь."

# ch/hanna/condom.rpy:15
translate russian hanna_use_condom_376f2638:
    "Я отступаю к брошенным джинсам, достаю из кармана презерватив и надеваю его."

# ch/hanna/condom.rpy:17
translate russian hanna_use_condom_40ef83b7:
    "Но как бы мне ни хотелось начать, на предохранение время всегда найдётся."

# ch/hanna/condom.rpy:18
translate russian hanna_use_condom_e9636e29:
    "Я тянусь к прикроватной тумбочке и беру презерватив."

# ch/hanna/condom.rpy:19
translate russian hanna_use_condom_18ca1f53:
    "Ханна немного недовольна задержкой, но всё же кивает."

# ch/hanna/condom.rpy:20
translate russian hanna_use_condom_7ad57aa9:
    "Я торопливо вскрываю упаковку зубами и надеваю презерватив."

# ch/hanna/condom.rpy:22
translate russian hanna_use_condom_575c66ab:
    "Но тут вспоминаю, что нужно предохраняться."

# ch/hanna/condom.rpy:23
translate russian hanna_use_condom_9be2ca8b:
    mike.say "Погоди секунду, Ханна."

# ch/hanna/condom.rpy:24
translate russian hanna_use_condom_586365f1:
    mike.say "Кажется, у меня в кармане есть презерватив..."

# ch/hanna/condom.rpy:25
translate russian hanna_use_condom_ae2e289f:
    hanna.say "Ты носишь их в кармане?!"

# ch/hanna/condom.rpy:26
translate russian hanna_use_condom_4c5818a8:
    mike.say "Лучше бы вообще не брал?"

# ch/hanna/condom.rpy:27
translate russian hanna_use_condom_24ebb8bb:
    hanna.say "Ладно, убедил!"

# ch/hanna/condom.rpy:28
translate russian hanna_use_condom_6575fdca:
    "Надеть его — дело пары секунд."

# ch/hanna/condom.rpy:29
translate russian hanna_use_condom_0157951c:
    "Теперь можно начинать."

# ch/hanna/condom.rpy:35
translate russian hanna_intro_condom_f50aa8e5:
    "Она явно готова и хочет продолжить, но тут словно что-то вспоминает и резко, почти неслышно вздыхает."

# ch/hanna/condom.rpy:36
translate russian hanna_intro_condom_1370943d:
    "Густо покраснев, она всё же улыбается и подзывает меня ближе."

# ch/hanna/condom.rpy:38
translate russian hanna_intro_condom_95d866a4:
    "Мне так не терпится начать, что хочется без промедления перейти к делу."

# ch/hanna/condom.rpy:40
translate russian hanna_intro_condom_ac283cdd:
    "Я подступаю к кровати, как оборотень к овечке, готовый проглотить её целиком."

# ch/hanna/condom.rpy:42
translate russian hanna_intro_condom_7111dc8a:
    "Сейчас мне отчаянно нужно оказаться внутри Ханны!"

# ch/hanna/condom.rpy:43
translate russian hanna_intro_condom_ecb6e3d5:
    "Ни о чём другом я думать не могу."

# ch/hanna/condom.rpy:45
translate russian hanna_intro_condom_c4318fd9:
    "Её киска блестит на свету — влажная и манящая."

# ch/hanna/condom.rpy:51
translate russian hanna_warn_condom_85219355:
    hanna.say "Кхм!"

# ch/hanna/condom.rpy:52
translate russian hanna_warn_condom_735b9f9f:
    hanna.say "Прежде чем браться за меня, ты ничего не хочешь сделать?"

# ch/hanna/condom.rpy:54
translate russian hanna_warn_condom_fec54c98:
    "Но когда я пытаюсь продолжить, Ханна немного отодвигается."

# ch/hanna/condom.rpy:55
translate russian hanna_warn_condom_4233feda:
    "Она вопросительно смотрит на меня."

# ch/hanna/condom.rpy:56
translate russian hanna_warn_condom_0182cf9f:
    "И тут я понимаю: она хочет знать, почему я не надеваю презерватив."

# ch/hanna/condom.rpy:58
translate russian hanna_warn_condom_3f61f892:
    hanna.say "Чёрт возьми!"

# ch/hanna/condom.rpy:59
translate russian hanna_warn_condom_3e0a1122:
    hanna.say "Нам нужен презерватив!"

# ch/hanna/condom.rpy:60
translate russian hanna_warn_condom_e84ffc6f:
    mike.say "Что?"

# ch/hanna/condom.rpy:62
translate russian hanna_warn_condom_1b285f19:
    hanna.say "Погоди..."

# ch/hanna/condom.rpy:63
translate russian hanna_warn_condom_0b0fb3a9:
    "Она явно готова и хочет продолжить, но тут словно что-то вспоминает и резко, почти неслышно вздыхает. Рука от губ тут же опускается ниже, прикрывая губки между ног."

# ch/hanna/condom.rpy:69
translate russian hanna_force_condom_17ecbff4:
    "Ханна показывает презерватив, вопросительно приподняв бровь."

# ch/hanna/condom.rpy:70
translate russian hanna_force_condom_0349f156:
    "Я киваю, радуясь, что мы одинаково об этом думаем."

# ch/hanna/condom.rpy:71
translate russian hanna_force_condom_3055d7df:
    "Беру у Ханны презерватив и разрываю упаковку."

# ch/hanna/condom.rpy:72
translate russian hanna_force_condom_c4c8da30:
    "Мгновение спустя презерватив надет, и всё готово."

# ch/hanna/condom.rpy:79
translate russian hanna_force_condom_09d3d735:
    hanna.say "Давай предохраняться."

# ch/hanna/condom.rpy:80
translate russian hanna_force_condom_261b29ab:
    "Я шарю по прикроватной тумбочке в поисках презерватива, но ничего не нахожу."

# ch/hanna/condom.rpy:81
translate russian hanna_force_condom_479879e4:
    mike.say "Чёрт... закончились!"

# ch/hanna/condom.rpy:82
translate russian hanna_force_condom_70c47031:
    hanna.say "Прости, тогда в другой раз..."

# ch/hanna/condom.rpy:85
translate russian hanna_force_condom_6b251d86:
    "Ханна тихонько кашляет и кивает на кучку сброшенной одежды."

# ch/hanna/condom.rpy:86
translate russian hanna_force_condom_4a2653c5:
    "Я прослеживаю её взгляд и быстро обыскиваю карманы, пока не нахожу нужное."

# ch/hanna/condom.rpy:87
translate russian hanna_force_condom_930083dc:
    "Презерватив. Я тут же разрываю упаковку и надеваю его."

# ch/hanna/condom.rpy:88
translate russian hanna_force_condom_607c3cf5:
    "Ханна довольно кивает, готовая продолжить с того места, где мы остановились."

# ch/hanna/condom.rpy:90
translate russian hanna_force_condom_3ede7760:
    hanna.say "Конечно нужен!"

# ch/hanna/condom.rpy:91
translate russian hanna_force_condom_6f710077:
    hanna.say "Не волнуйся, у меня как раз есть!"

# ch/hanna/condom.rpy:92
translate russian hanna_force_condom_cb4a9b6e:
    mike.say "Ты носишь их с собой?!"

# ch/hanna/condom.rpy:93
translate russian hanna_force_condom_0d042795:
    hanna.say "Лучше бы не носила?"

# ch/hanna/condom.rpy:94
translate russian hanna_force_condom_813cc72a:
    mike.say "Ладно, убедила!"

# ch/hanna/condom.rpy:95
translate russian hanna_force_condom_6575fdca:
    "Надеть его — дело пары секунд."

# ch/hanna/condom.rpy:96
translate russian hanna_force_condom_0157951c:
    "Теперь можно начинать."

# ch/hanna/condom.rpy:98
translate russian hanna_force_condom_ee25b9e1:
    "Но Ханна успела подумать о предохранении."

# ch/hanna/condom.rpy:99
translate russian hanna_force_condom_306ce00a:
    "Одной рукой она останавливает меня, а другой показывает презерватив."

# ch/hanna/condom.rpy:100
translate russian hanna_force_condom_7178bc05:
    "Задержка меня немного расстраивает, но я всё же киваю."

# ch/hanna/condom.rpy:101
translate russian hanna_force_condom_1f4a2462:
    "Торопливо вскрываю упаковку зубами и надеваю его."

# ch/hanna/condom.rpy:103
translate russian hanna_force_condom_0c62aad0:
    "Чёрт."

# ch/hanna/condom.rpy:108
translate russian hanna_force_condom_09d3d735_1:
    hanna.say "Давай предохраняться."

# ch/hanna/condom.rpy:109
translate russian hanna_force_condom_261b29ab_1:
    "Я шарю по прикроватной тумбочке в поисках презерватива, но ничего не нахожу."

# ch/hanna/condom.rpy:110
translate russian hanna_force_condom_479879e4_1:
    mike.say "Чёрт... закончились!"

# ch/hanna/condom.rpy:111
translate russian hanna_force_condom_70c47031_1:
    hanna.say "Прости, тогда в другой раз..."

# ch/hanna/condom.rpy:118
translate russian hanna_mad_condom_1ccab2e1:
    mike.say "Хм..."

# ch/hanna/condom.rpy:119
translate russian hanna_mad_condom_0944829f:
    mike.say "Я думал, ты уже готова!"

# ch/hanna/condom.rpy:120
translate russian hanna_mad_condom_5ac62810:
    "Лицо Ханны мрачнеет, и я сразу понимаю: только что я облажался."

# ch/hanna/condom.rpy:121
translate russian hanna_mad_condom_bd33e68c:
    "Ханна брыкается и больно попадает мне сбоку по голове."

# ch/hanna/condom.rpy:122
translate russian hanna_mad_condom_3d57c2e4:
    mike.say "Ай... чёрт!"

# ch/hanna/condom.rpy:123
translate russian hanna_mad_condom_6717afb4:
    "Пока я держусь за лицо, она встаёт и собирает разбросанную одежду."

# ch/hanna/condom.rpy:124
translate russian hanna_mad_condom_2308649b:
    hanna.say "Придурок!"

# ch/hanna/condom.rpy:125
translate russian hanna_mad_condom_0158caec:
    "Я скорее слышу, чем вижу, как она уходит, громко хлопнув дверью."

# ch/hanna/condom.rpy:127
translate russian hanna_mad_condom_2f0bf63e:
    mike.say "Нам не нужно предохраняться, Ханна."

# ch/hanna/condom.rpy:128
translate russian hanna_mad_condom_a20f3bc3:
    mike.say "К тому же это только испортит ощущения!"

# ch/hanna/condom.rpy:129
translate russian hanna_mad_condom_819c5901:
    "Ханна смотрит на меня в потрясении."

# ch/hanna/condom.rpy:130
translate russian hanna_mad_condom_af2ecb5c:
    hanna.say "Как можно быть таким безответственным?!"

# ch/hanna/condom.rpy:131
translate russian hanna_mad_condom_3059d569:
    hanna.say "Ты всё настроение убил!"

# ch/hanna/condom.rpy:132
translate russian hanna_mad_condom_2b2a4d16:
    "Прежде чем я успеваю возразить, Ханна уже встаёт и одевается."

# ch/hanna/condom.rpy:133
translate russian hanna_mad_condom_d7a11c1e:
    "С её крохотными нарядами много времени на это не требуется!"

# ch/hanna/condom.rpy:134
translate russian hanna_mad_condom_089b8562:
    "Мне остаётся лишь последовать её примеру и смотреть, как она гневно удаляется."

# ch/hanna/condom.rpy:135
translate russian hanna_mad_condom_235249d8:
    "Спорить с ней я не могу: в спортзале ещё полно народу."

# ch/hanna/condom.rpy:137
translate russian hanna_mad_condom_23102f7e:
    hanna.say "Эй... минутку."

# ch/hanna/condom.rpy:138
translate russian hanna_mad_condom_d136b000:
    mike.say "Ч... что такое?!"

# ch/hanna/condom.rpy:139
translate russian hanna_mad_condom_2e2ddfda:
    hanna.say "Ты ничего не забыл?"

# ch/hanna/condom.rpy:140
translate russian hanna_mad_condom_06c9b976:
    mike.say "Ты про презерватив? Серьёзно?"

# ch/hanna/condom.rpy:141
translate russian hanna_mad_condom_6cabdd3f:
    hanna.say "А ТЫ?!"

# ch/hanna/condom.rpy:142
translate russian hanna_mad_condom_f2632cdb:
    "С этими словами она так сильно толкает меня, что я скатываюсь с неё."

# ch/hanna/condom.rpy:143
translate russian hanna_mad_condom_0ce3a47c:
    hanna.say "Господи, [lssb_hanna.hero_name()], повзрослей уже и включи голову!"

# ch/hanna/condom.rpy:145
translate russian hanna_mad_condom_bbbf8cdb:
    "Я пожимаю плечами, пытаясь перевести всё в шутку."

# ch/hanna/condom.rpy:146
translate russian hanna_mad_condom_7e0861c3:
    mike.say "Может, тогда в задницу?"

# ch/hanna/condom.rpy:147
translate russian hanna_mad_condom_7f4a7840:
    mike.say "Так и презерватив не понадобится!"

# ch/hanna/condom.rpy:148
translate russian hanna_mad_condom_2e78d5af:
    "Едва она слышит это, её лицо искажается от негодования."

# ch/hanna/condom.rpy:149
translate russian hanna_mad_condom_e98fde0d:
    hanna.say "Думаешь, это смешно?!"

# ch/hanna/condom.rpy:150
translate russian hanna_mad_condom_3fd4890d:
    hanna.say "Тогда вот тебе ещё повод посмеяться: я ухожу домой!"

# ch/hanna/condom.rpy:151
translate russian hanna_mad_condom_26119d7f:
    "Сказав это, она отодвигается от меня и встаёт."

# ch/hanna/condom.rpy:152
translate russian hanna_mad_condom_adbd6834:
    "Я несколько раз пытаюсь её уговорить."

# ch/hanna/condom.rpy:153
translate russian hanna_mad_condom_e314530f:
    "Но стоит открыть рот, как Ханна бросает на меня убийственный взгляд, и я снова замолкаю."

# ch/hanna/condom.rpy:154
translate russian hanna_mad_condom_62f76479:
    "Через пару минут она уходит, оставив меня одного в комнате."

# ch/hanna/condom.rpy:155
translate russian hanna_mad_condom_b2f50706:
    "Я разочарованно смотрю, как член поникает прямо на глазах."

# ch/hanna/date.rpy:2
translate russian hanna_date_intro_valentine_male_0daff702:
    mike.say "Ух ты, Ханна..."

# ch/hanna/date.rpy:3
translate russian hanna_date_intro_valentine_male_ece3d828:
    mike.say "Кажется, у меня самая красивая спутница на День святого Валентина!"

# ch/hanna/date.rpy:4
translate russian hanna_date_intro_valentine_male_6b7a9231:
    mike.say "Просто не могу отвести от тебя глаз."

# ch/hanna/date.rpy:5
translate russian hanna_date_intro_valentine_male_0d4e163e:
    "Ханна улыбается и отмахивается от комплиментов, будто они ничего не значат."

# ch/hanna/date.rpy:6
translate russian hanna_date_intro_valentine_male_d573b3de:
    "Но я вижу, как она довольна: ещё немного — и замурлычет, словно кошка."

# ch/hanna/date.rpy:7
translate russian hanna_date_intro_valentine_male_6abe2aee:
    hanna.say "Ну не глупи, [lssb_hanna.hero_name()]!"

# ch/hanna/date.rpy:8
translate russian hanna_date_intro_valentine_male_e1c300a4:
    hanna.say "Сегодня мне нужны только твои взгляды..."

# ch/hanna/date.rpy:12
translate russian hanna_date_intro_halloween_male_f4b2135a:
    mike.say "Слушай, Ханна, надо было нарядиться на Хэллоуин."

# ch/hanna/date.rpy:13
translate russian hanna_date_intro_halloween_male_ece29818:
    mike.say "Во что-нибудь готическое и жутковатое, а?"

# ch/hanna/date.rpy:14
translate russian hanna_date_intro_halloween_male_47edde97:
    "Ханна приподнимает бровь, словно обдумывая мои слова."

# ch/hanna/date.rpy:15
translate russian hanna_date_intro_halloween_male_c5939bad:
    hanna.say "Да, ты прав, [lssb_hanna.hero_name()]."

# ch/hanna/date.rpy:16
translate russian hanna_date_intro_halloween_male_f13bcff3:
    hanna.say "Блин, надо было об этом подумать!"

# ch/hanna/date.rpy:17
translate russian hanna_date_intro_halloween_male_02eb20e6:
    hanna.say "Я могла бы надеть что-нибудь очень обтягивающее и броское, понимаешь?"

# ch/hanna/date.rpy:18
translate russian hanna_date_intro_halloween_male_42731951:
    "В голове тут же возникает множество вариантов."

# ch/hanna/date.rpy:19
translate russian hanna_date_intro_halloween_male_26abfeb0:
    mike.say "Было бы здорово, Ханна!"

# ch/hanna/date.rpy:20
translate russian hanna_date_intro_halloween_male_1e33b2a7:
    mike.say "Надо обязательно вспомнить в следующем году."

# ch/hanna/date.rpy:24
translate russian hanna_date_intro_christmas_male_99735f62:
    mike.say "Привет, Ханна! С Рождеством!"

# ch/hanna/date.rpy:25
translate russian hanna_date_intro_christmas_male_89b8c2da:
    "Ханна фыркает и качает головой."

# ch/hanna/date.rpy:26
translate russian hanna_date_intro_christmas_male_b73cfb03:
    hanna.say "Да-да, [lssb_hanna.hero_name()], как скажешь."

# ch/hanna/date.rpy:27
translate russian hanna_date_intro_christmas_male_e737a973:
    hanna.say "Уф... терпеть не могу холод!"

# ch/hanna/date.rpy:28
translate russian hanna_date_intro_christmas_male_8b1c4571:
    mike.say "Тебе некомфортно?"

# ch/hanna/date.rpy:29
translate russian hanna_date_intro_christmas_male_02611c2e:
    hanna.say "Нет... не люблю так кутаться."

# ch/hanna/date.rpy:30
translate russian hanna_date_intro_christmas_male_ada8bb22:
    hanna.say "Под всей этой одеждой никто не видит, ради чего я столько вкалываю в спортзале!"

# ch/hanna/date.rpy:34
translate russian hanna_date_intro_birthday_male_a1a90f00:
    mike.say "С днём рождения, Ханна!"

# ch/hanna/date.rpy:35
translate russian hanna_date_intro_birthday_male_a8ecb7b2:
    mike.say "Должен сказать, сегодня ты выглядишь особенно потрясающе."

# ch/hanna/date.rpy:36
translate russian hanna_date_intro_birthday_male_45e59d6d:
    mike.say "Такое чувство, будто это я получил подарок на день рождения!"

# ch/hanna/date.rpy:37
translate russian hanna_date_intro_birthday_male_94c69917:
    hanna.say "Ой, [lssb_hanna.hero_name()]!"

# ch/hanna/date.rpy:38
translate russian hanna_date_intro_birthday_male_ef1e1b0a:
    hanna.say "Говори это сколько угодно."

# ch/hanna/date.rpy:39
translate russian hanna_date_intro_birthday_male_c616382f:
    hanna.say "Мне никогда не надоест слушать!"

# ch/hanna/date.rpy:43
translate russian hanna_date_intro_mc_birthday_male_c03ce0bb:
    mike.say "Готова к свиданию, Ханна?"

# ch/hanna/date.rpy:44
translate russian hanna_date_intro_mc_birthday_male_7301435e:
    hanna.say "Конечно, [lssb_hanna.hero_name()]."

# ch/hanna/date.rpy:45
translate russian hanna_date_intro_mc_birthday_male_80f387bd:
    hanna.say "Но сначала главное: с днём рождения!"

# ch/hanna/date.rpy:46
translate russian hanna_date_intro_mc_birthday_male_c46405f7:
    mike.say "Ух ты, Ханна!"

# ch/hanna/date.rpy:47
translate russian hanna_date_intro_mc_birthday_male_519b2003:
    mike.say "Ты запомнила дату! Впечатляет."

# ch/hanna/date.rpy:48
translate russian hanna_date_intro_mc_birthday_male_31589d69:
    hanna.say "Нет, [lssb_hanna.hero_name()], глупенький!"

# ch/hanna/date.rpy:50
translate russian hanna_date_intro_mc_birthday_male_dc3b221c:
    hanna.say "Ты ведь записан в спортзал, помнишь?"

# ch/hanna/date.rpy:51
translate russian hanna_date_intro_mc_birthday_male_f2feb7e6:
    hanna.say "Я, может, уже и не начальница, но в документы заглянуть ещё могу!"

# ch/hanna/date.rpy:53
translate russian hanna_date_intro_mc_birthday_male_a02f762d:
    hanna.say "Ты ведь записан в мой спортзал, помнишь?"

# ch/hanna/date.rpy:54
translate russian hanna_date_intro_mc_birthday_male_bb071326:
    hanna.say "Все твои данные есть в анкете!"

# ch/hanna/date.rpy:59
translate russian hanna_date_pub_male_537454a4:
    hanna.say "«Винчестер»?!"

# ch/hanna/date.rpy:60
translate russian hanna_date_pub_male_d1b32f93:
    hanna.say "В колледже я постоянно смотрела здесь спортивные матчи!"

# ch/hanna/date.rpy:66
translate russian hanna_date_cinema_male_9577f34e:
    hanna.say "Ладно, но обычно я смотрю кино по телевизору."

# ch/hanna/date.rpy:67
translate russian hanna_date_cinema_male_7538cfc3:
    hanna.say "В кинотеатре так темно — меня никто не видит."

# ch/hanna/date.rpy:68
translate russian hanna_date_cinema_male_36e9d9df:
    hanna.say "Нет-нет, я хотела сказать, я никого не вижу. Конечно же..."

# ch/hanna/date.rpy:74
translate russian hanna_date_familyrestaurant_male_dc24dee2:
    hanna.say "Конечно, можем поесть здесь, [lssb_hanna.hero_name()]."

# ch/hanna/date.rpy:75
translate russian hanna_date_familyrestaurant_male_85650a5e:
    hanna.say "Если тебя не смущают все эти родители."

# ch/hanna/date.rpy:76
translate russian hanna_date_familyrestaurant_male_5484e481:
    hanna.say "Ну почему все папаши на меня пялятся?"

# ch/hanna/date.rpy:77
translate russian hanna_date_familyrestaurant_male_2e62b95e:
    hanna.say "А мамаши смотрят так, будто убить готовы!"

# ch/hanna/date.rpy:83
translate russian hanna_date_restaurant_male_06fc7ffb:
    hanna.say "Ого! Вот это действительно шикарное место."

# ch/hanna/date.rpy:84
translate russian hanna_date_restaurant_male_a4e249a2:
    hanna.say "В такие места ходят, чтобы СЕБЯ ПОКАЗАТЬ!"

# ch/hanna/date.rpy:90
translate russian hanna_date_amusmentpark_male_80ff2877:
    hanna.say "В таких местах всегда кипит жизнь."

# ch/hanna/date.rpy:91
translate russian hanna_date_amusmentpark_male_2a71e267:
    hanna.say "Столько людей и столько взглядов на тебе!"

# ch/hanna/date.rpy:98
translate russian hanna_date_waterpark_male_5f132897:
    hanna.say "Аквапарк?"

# ch/hanna/date.rpy:99
translate russian hanna_date_waterpark_male_cbdfbc21:
    hanna.say "Отличная идея! Я как раз купила прелестный купальник!"

# ch/hanna/date.rpy:105
translate russian hanna_date_park_male_dff86107:
    hanna.say "Свежий воздух и возможность размять ноги!"

# ch/hanna/date.rpy:106
translate russian hanna_date_park_male_c8bb23c4:
    hanna.say "Что может не нравиться в прогулке по парку?"

# ch/hanna/date.rpy:111
translate russian hanna_date_eat_a_burger_126e1445:
    "При виде бургера у Ханны едва не текут слюнки."

# ch/hanna/date.rpy:112
translate russian hanna_date_eat_a_burger_9d14991f:
    "Она хватает его обеими руками, откусывает огромный кусок и с аппетитом жуёт."

# ch/hanna/date.rpy:113
translate russian hanna_date_eat_a_burger_7341da11:
    "Видимо, столько времени в спортзале и правда нагоняет аппетит!"

# ch/hanna/date.rpy:120
translate russian hanna_date_buy_drink_6a565115:
    hanna.say "Алкоголь, [lssb_hanna.hero_name()]?"

# ch/hanna/date.rpy:121
translate russian hanna_date_buy_drink_36e2ac9d:
    hanna.say "Серьёзно?!"

# ch/hanna/date.rpy:122
translate russian hanna_date_buy_drink_36811d01:
    hanna.say "О нашем ребёнке здесь только я думаю?"

# ch/hanna/date.rpy:126
translate russian hanna_date_buy_drink_4a49600d:
    "Ханна берёт предложенный напиток и сразу выпивает примерно половину."

# ch/hanna/date.rpy:127
translate russian hanna_date_buy_drink_50065716:
    "И не маленькими глоточками — залпом!"

# ch/hanna/date.rpy:128
translate russian hanna_date_buy_drink_fedbeb94:
    "Потом улыбается мне, вытирая губы тыльной стороной ладони."

# ch/hanna/date.rpy:132
translate russian hanna_date_play_darts_22741b1e:
    "Ханна с восторгом хватается за возможность сыграть со мной в дартс."

# ch/hanna/date.rpy:133
translate russian hanna_date_play_darts_ca681785:
    "И очень быстро доказывает, что играет гораздо лучше меня."

# ch/hanna/date.rpy:134
translate russian hanna_date_play_darts_8910683e:
    "Она разбивает меня в пух и прах и от души празднует победу."

# ch/hanna/date.rpy:138
translate russian hanna_date_pub_play_pool_c502d695:
    "Ханна принимает кий так, будто ей вручили оружие для смертельной дуэли."

# ch/hanna/date.rpy:139
translate russian hanna_date_pub_play_pool_e084d6b6:
    "И играет почти с такой же беспощадностью!"

# ch/hanna/date.rpy:140
translate russian hanna_date_pub_play_pool_6e07c6e0:
    "В итоге мне едва удаётся свести партию вничью."

# ch/hanna/date.rpy:147
translate russian hanna_date_buy_a_round_6a565115:
    hanna.say "Алкоголь, [lssb_hanna.hero_name()]?"

# ch/hanna/date.rpy:148
translate russian hanna_date_buy_a_round_36e2ac9d:
    hanna.say "Серьёзно?!"

# ch/hanna/date.rpy:149
translate russian hanna_date_buy_a_round_36811d01:
    hanna.say "О нашем ребёнке здесь только я думаю?"

# ch/hanna/date.rpy:153
translate russian hanna_date_buy_a_round_da841d20:
    mike.say "Может, ещё по одной?"

# ch/hanna/date.rpy:154
translate russian hanna_date_buy_a_round_aaa8fba0:
    hanna.say "Конечно, [lssb_hanna.hero_name()]."

# ch/hanna/date.rpy:155
translate russian hanna_date_buy_a_round_d13a822d:
    hanna.say "Но сиди — теперь моя очередь угощать!"

# ch/hanna/date.rpy:162
translate russian hanna_date_buy_a_round_fb20fd2c:
    "Я хочу угостить пивом весь паб."

# ch/hanna/date.rpy:163
translate russian hanna_date_buy_a_round_15fccdd3:
    "Но Ханна, похоже, пить не хочет, поэтому я тоже воздерживаюсь."

# ch/hanna/date.rpy:168
translate russian hanna_dance_with_a1aafe43:
    "Уговаривать Ханну потанцевать со мной не приходится."

# ch/hanna/date.rpy:169
translate russian hanna_dance_with_593070c0:
    "Скорее мне самому нужно за ней поспевать!"

# ch/hanna/date.rpy:170
translate russian hanna_dance_with_d5b3deda:
    "А на танцполе она прижимается ближе и двигается восхитительно непристойно..."

# ch/hanna/date.rpy:174
translate russian hanna_date_play_arcade_intro_male_7f1015e7:
    hanna.say "Эх... это совсем не моё, [lssb_hanna.hero_name()]."

# ch/hanna/date.rpy:175
translate russian hanna_date_play_arcade_intro_male_79b9214c:
    hanna.say "Тренажёры я, конечно, люблю."

# ch/hanna/date.rpy:176
translate russian hanna_date_play_arcade_intro_male_cc38ba91:
    hanna.say "Но такие, на которых мышцы качают, а не кнопки жмут!"

# ch/hanna/date.rpy:177
translate russian hanna_date_play_arcade_intro_male_0ecdcede:
    "В таком месте мне трудно уделять внимание Ханне."

# ch/hanna/date.rpy:178
translate russian hanna_date_play_arcade_intro_male_7c320217:
    "Обожаю зал игровых автоматов — одно из моих любимых мест."

# ch/hanna/date.rpy:179
translate russian hanna_date_play_arcade_intro_male_36e30f35:
    "Но раз ей здесь не нравится, нужно постараться ради неё."

# ch/hanna/date.rpy:180
translate russian hanna_date_play_arcade_intro_male_e39b30b6:
    mike.say "Да, Ханна, я знаю, ты любишь активный отдых."

# ch/hanna/date.rpy:181
translate russian hanna_date_play_arcade_intro_male_761e4754:
    mike.say "Но в видеоигры играют не только жирные лентяи, знаешь ли."

# ch/hanna/date.rpy:182
translate russian hanna_date_play_arcade_intro_male_d1d0baaf:
    mike.say "В некоторых нужно танцевать или бегать."

# ch/hanna/date.rpy:183
translate russian hanna_date_play_arcade_intro_male_5086b7b0:
    mike.say "Пот с тебя тоже сойдёт!"

# ch/hanna/date.rpy:184
translate russian hanna_date_play_arcade_intro_male_971a23ad:
    "Ханна закатывает глаза."

# ch/hanna/date.rpy:185
translate russian hanna_date_play_arcade_intro_male_4e278cd2:
    "И вздыхает."

# ch/hanna/date.rpy:186
translate russian hanna_date_play_arcade_intro_male_fad6e82c:
    hanna.say "Кому охота потеть и перегреваться за пределами спортзала?"

# ch/hanna/date.rpy:187
translate russian hanna_date_play_arcade_intro_male_d6dc0878:
    hanna.say "Звучит жутко неудобно. И противно!"

# ch/hanna/date.rpy:188
translate russian hanna_date_play_arcade_intro_male_b7d0a83e:
    mike.say "Но здесь есть и спортивные игры, Ханна!"

# ch/hanna/date.rpy:189
translate russian hanna_date_play_arcade_intro_male_77b0912c:
    mike.say "Как тебе эта?"

# ch/hanna/date.rpy:190
translate russian hanna_date_play_arcade_intro_male_92fcebc0:
    mike.say "«Крэк энд Пил» — про лёгкую атлетику."

# ch/hanna/date.rpy:191
translate russian hanna_date_play_arcade_intro_male_fb7b3856:
    "Ханна смотрит через моё плечо на автомат."

# ch/hanna/date.rpy:192
translate russian hanna_date_play_arcade_intro_male_2f42644b:
    "На мгновение хмурится, затем кивает."

# ch/hanna/date.rpy:193
translate russian hanna_date_play_arcade_intro_male_36520e61:
    hanna.say "Хм..."

# ch/hanna/date.rpy:194
translate russian hanna_date_play_arcade_intro_male_994d7bbe:
    hanna.say "Выглядит довольно просто."

# ch/hanna/date.rpy:195
translate russian hanna_date_play_arcade_intro_male_95160fbb:
    hanna.say "Если сыграю, потом уйдём?"

# ch/hanna/date.rpy:196
translate russian hanna_date_play_arcade_intro_male_a87fd8a8:
    mike.say "Конечно, Ханна."

# ch/hanna/date.rpy:197
translate russian hanna_date_play_arcade_intro_male_6b55288e:
    mike.say "Просто дай игре шанс."

# ch/hanna/date.rpy:198
translate russian hanna_date_play_arcade_intro_male_a78658a2:
    mike.say "Если всё равно будет скучно, пойдём куда-нибудь ещё."

# ch/hanna/date.rpy:199
translate russian hanna_date_play_arcade_intro_male_4f5c035f:
    "Сказав это, я начинаю опускать монеты в прорезь."

# ch/hanna/date.rpy:203
translate russian hanna_date_play_arcade_win_male_3ddfbb70:
    "Странно наблюдать за тем, как Ханна пытается играть."

# ch/hanna/date.rpy:204
translate russian hanna_date_play_arcade_win_male_02c0190f:
    "Обычно у неё отличная координация, она даже грациозна."

# ch/hanna/date.rpy:205
translate russian hanna_date_play_arcade_win_male_b35e74a7:
    "А здесь всего-то и нужно вовремя нажимать кнопки."

# ch/hanna/date.rpy:206
translate russian hanna_date_play_arcade_win_male_83409930:
    "Ну и молотить по ним как сумасшедший!"

# ch/hanna/date.rpy:207
translate russian hanna_date_play_arcade_win_male_05c1b3c7:
    "Но почему-то Ханна никак не может приноровиться."

# ch/hanna/date.rpy:208
translate russian hanna_date_play_arcade_win_male_7d05d594:
    hanna.say "Уф..."

# ch/hanna/date.rpy:209
translate russian hanna_date_play_arcade_win_male_bcc1d483:
    hanna.say "Почему мой мужик так медленно бежит?!"

# ch/hanna/date.rpy:210
translate russian hanna_date_play_arcade_win_male_85ceb867:
    hanna.say "И почему бросает как слабак?!"

# ch/hanna/date.rpy:211
translate russian hanna_date_play_arcade_win_male_ee210eff:
    mike.say "Честно, не знаю, Ханна."

# ch/hanna/date.rpy:212
translate russian hanna_date_play_arcade_win_male_f6030efc:
    mike.say "Но по кнопкам лучше бить потише."

# ch/hanna/date.rpy:213
translate russian hanna_date_play_arcade_win_male_363d079e:
    mike.say "Так ты автомат сломаешь."

# ch/hanna/date.rpy:214
translate russian hanna_date_play_arcade_win_male_bafd5359:
    mike.say "Или себе пальцы!"

# ch/hanna/date.rpy:215
translate russian hanna_date_play_arcade_win_male_64240213:
    "Вскоре игра заканчивается, и страсти утихают."

# ch/hanna/date.rpy:216
translate russian hanna_date_play_arcade_win_male_cb95c741:
    "Победитель очевиден."

# ch/hanna/date.rpy:217
translate russian hanna_date_play_arcade_win_male_ab8a133a:
    "У меня очков гораздо больше, чем у Ханны."

# ch/hanna/date.rpy:218
translate russian hanna_date_play_arcade_win_male_a847a1c3:
    hanna.say "Ну вот, [lssb_hanna.hero_name()]."

# ch/hanna/date.rpy:219
translate russian hanna_date_play_arcade_win_male_5d3f5380:
    hanna.say "Сыграли в твою дурацкую игру."

# ch/hanna/date.rpy:220
translate russian hanna_date_play_arcade_win_male_097fd1ca:
    hanna.say "Ты победил, я проиграла."

# ch/hanna/date.rpy:221
translate russian hanna_date_play_arcade_win_male_3f368fb7:
    hanna.say "Теперь можно уйти?"

# ch/hanna/date.rpy:222
translate russian hanna_date_play_arcade_win_male_940781c2:
    mike.say "Думаю, да, Ханна."

# ch/hanna/date.rpy:223
translate russian hanna_date_play_arcade_win_male_c11f26ce:
    mike.say "Таков был уговор..."

# ch/hanna/date.rpy:224
translate russian hanna_date_play_arcade_win_male_36964ff3:
    "По пути к выходу делаю себе пару заметок."

# ch/hanna/date.rpy:225
translate russian hanna_date_play_arcade_win_male_f2977452:
    "Во-первых, больше никогда не приводить сюда Ханну."

# ch/hanna/date.rpy:226
translate russian hanna_date_play_arcade_win_male_576376b2:
    "Во-вторых, помнить, что проигрывать она совершенно не умеет."

# ch/hanna/date.rpy:230
translate russian hanna_date_play_arcade_lose_male_861e7ae4:
    "Глядя на игру Ханны, я почти не верю своим глазам."

# ch/hanna/date.rpy:231
translate russian hanna_date_play_arcade_lose_male_83a36162:
    "Хотя нужно-то всего лишь попадать в ритм."

# ch/hanna/date.rpy:232
translate russian hanna_date_play_arcade_lose_male_83409930:
    "Ну и молотить по кнопкам как сумасшедший!"

# ch/hanna/date.rpy:233
translate russian hanna_date_play_arcade_lose_male_5e4154c6:
    "Похоже, природная грация и координация Ханны дают о себе знать."

# ch/hanna/date.rpy:234
translate russian hanna_date_play_arcade_lose_male_d4de731d:
    "Она осваивает игру почти мгновенно."

# ch/hanna/date.rpy:235
translate russian hanna_date_play_arcade_lose_male_b5ec6639:
    hanna.say "ДА!"

# ch/hanna/date.rpy:236
translate russian hanna_date_play_arcade_lose_male_5d385cb3:
    hanna.say "На дорожке меня не догнать!"

# ch/hanna/date.rpy:237
translate russian hanna_date_play_arcade_lose_male_b48949c3:
    hanna.say "А копьё я только что отправила на орбиту!"

# ch/hanna/date.rpy:238
translate russian hanna_date_play_arcade_lose_male_d2c86de2:
    mike.say "Притормози, Ханна!"

# ch/hanna/date.rpy:239
translate russian hanna_date_play_arcade_lose_male_9048bdf3:
    mike.say "Мы просто играем, помнишь?"

# ch/hanna/date.rpy:240
translate russian hanna_date_play_arcade_lose_male_a4245c61:
    mike.say "Такими темпами я кнопки сломаю."

# ch/hanna/date.rpy:241
translate russian hanna_date_play_arcade_lose_male_d7f9cff3:
    mike.say "Или собственные чёртовы пальцы!"

# ch/hanna/date.rpy:242
translate russian hanna_date_play_arcade_lose_male_64240213:
    "Вскоре игра заканчивается, и страсти утихают."

# ch/hanna/date.rpy:243
translate russian hanna_date_play_arcade_lose_male_cb95c741:
    "Победитель очевиден."

# ch/hanna/date.rpy:244
translate russian hanna_date_play_arcade_lose_male_5670b102:
    "У Ханны очков гораздо больше, чем у меня."

# ch/hanna/date.rpy:245
translate russian hanna_date_play_arcade_lose_male_715915bb:
    hanna.say "У-у!"

# ch/hanna/date.rpy:246
translate russian hanna_date_play_arcade_lose_male_b0e0c9c2:
    hanna.say "Она поднимается на пьедестал!"

# ch/hanna/date.rpy:247
translate russian hanna_date_play_arcade_lose_male_cb9e133c:
    hanna.say "Трибуны ликуют!"

# ch/hanna/date.rpy:248
translate russian hanna_date_play_arcade_lose_male_0a669095:
    hanna.say "Слышишь, как скандируют: «Ханна! Ханна! Ханна!»?"

# ch/hanna/date.rpy:249
translate russian hanna_date_play_arcade_lose_male_266745d6:
    mike.say "А... ладно, Ханна."

# ch/hanna/date.rpy:250
translate russian hanna_date_play_arcade_lose_male_1ce32c33:
    mike.say "Ты победила, только не зазнавайся, а?"

# ch/hanna/date.rpy:251
translate russian hanna_date_play_arcade_lose_male_96d6467d:
    mike.say "Кстати... ты ведь хотела уйти, когда доиграем?"

# ch/hanna/date.rpy:252
translate russian hanna_date_play_arcade_lose_male_6c582fbd:
    hanna.say "Ни за что, [lssb_hanna.hero_name()]! Ещё партию!"

# ch/hanna/date.rpy:260
translate russian hanna_dick_reactions_011ecc32:
    hanna.say "М-м-м..."

# ch/hanna/date.rpy:261
translate russian hanna_dick_reactions_594759f4:
    hanna.say "Здравствуй! Это кто у нас тут?"

# ch/hanna/date.rpy:262
translate russian hanna_dick_reactions_b685240b:
    mike.say "Т... тебе нравится, Ханна?"

# ch/hanna/date.rpy:264
translate russian hanna_dick_reactions_c0b5b5f2:
    hanna.say "Ещё бы, [lssb_hanna.hero_name()]."

# ch/hanna/date.rpy:265
translate russian hanna_dick_reactions_20dc8ad6:
    hanna.say "А теперь посмотрим, куда пристроить этого монстра!"

# ch/hanna/date.rpy:269
translate russian hanna_dick_reactions_11a997a0:
    hanna.say "А..."

# ch/hanna/date.rpy:271
translate russian hanna_dick_reactions_221b1937:
    hanna.say "Это всё, что у тебя там есть?"

# ch/hanna/date.rpy:272
translate russian hanna_dick_reactions_ac2593e1:
    mike.say "Эм... ну да, вроде!"

# ch/hanna/date.rpy:273
translate russian hanna_dick_reactions_01a6c2ac:
    hanna.say "Что ж, уверена, ты сумеешь это компенсировать."

# ch/hanna/date.rpy:275
translate russian hanna_dick_reactions_b9af4eb6:
    hanna.say "Просто придётся особенно постараться, ладно?"

# ch/hanna/date.rpy:282
translate russian hanna_halloween_invitation_3b83c679:
    "Конечно, на вечеринку в честь Хэллоуина я хочу пригласить только одну девушку."

# ch/hanna/date.rpy:283
translate russian hanna_halloween_invitation_a6457480:
    "Не представляю в роли своей спутницы в этот вечер никого, кроме Ханны."

# ch/hanna/date.rpy:284
translate russian hanna_halloween_invitation_672b54e4:
    "И почти уверен, что она сразу согласится."

# ch/hanna/date.rpy:285
translate russian hanna_halloween_invitation_d055476b:
    "Ведь я знаю, как она любит производить впечатление."

# ch/hanna/date.rpy:286
translate russian hanna_halloween_invitation_e5405896:
    "А где это сделать лучше, чем на костюмированной вечеринке?"

# ch/hanna/date.rpy:287
translate russian hanna_halloween_invitation_6d9f549c:
    "Поэтому при первой возможности задаю вопрос."

# ch/hanna/date.rpy:288
translate russian hanna_halloween_invitation_2d04e00e:
    mike.say "Ханна..."

# ch/hanna/date.rpy:289
translate russian hanna_halloween_invitation_9a74b3f2:
    mike.say "У тебя есть планы на Хэллоуин?"

# ch/hanna/date.rpy:291
translate russian hanna_halloween_invitation_d1521148:
    "Ханна оборачивается, услышав неожиданный вопрос."

# ch/hanna/date.rpy:292
translate russian hanna_halloween_invitation_eb32b09c:
    "На её лице искренние удивление и интерес."

# ch/hanna/date.rpy:293
translate russian hanna_halloween_invitation_9e77a09c:
    hanna.say "Хэллоуин..."

# ch/hanna/date.rpy:294
translate russian hanna_halloween_invitation_36520e61:
    hanna.say "Хм..."

# ch/hanna/date.rpy:296
translate russian hanna_halloween_invitation_e2eebc53:
    hanna.say "Вроде бы нет."

# ch/hanna/date.rpy:297
translate russian hanna_halloween_invitation_faf3f2e0:
    mike.say "Вот и отлично!"

# ch/hanna/date.rpy:298
translate russian hanna_halloween_invitation_fc5743f6:
    mike.say "То есть... не отлично, что у тебя нет планов."

# ch/hanna/date.rpy:299
translate russian hanna_halloween_invitation_c2ca15fb:
    mike.say "А отлично, потому что у нас дома будет вечеринка."

# ch/hanna/date.rpy:300
translate russian hanna_halloween_invitation_4ca6c683:
    mike.say "И я хотел спросить, не пойдёшь ли ты со мной?"

# ch/hanna/date.rpy:301
translate russian hanna_halloween_invitation_d05e481b:
    "Ханна приподнимает брови."

# ch/hanna/date.rpy:302
translate russian hanna_halloween_invitation_9430ec5f:
    hanna.say "Вечеринка у тебя?"

# ch/hanna/date.rpy:303
translate russian hanna_halloween_invitation_e797c980:
    hanna.say "Звучит весело."

# ch/hanna/date.rpy:304
translate russian hanna_halloween_invitation_6929d4b8:
    "Я энергично киваю, стараясь побудить её продолжить."

# ch/hanna/date.rpy:305
translate russian hanna_halloween_invitation_b9ebe658:
    "Она вроде заинтересовалась, но пока так и не согласилась."

# ch/hanna/date.rpy:306
translate russian hanna_halloween_invitation_a44a197f:
    mike.say "Будет здорово, Ханна."

# ch/hanna/date.rpy:307
translate russian hanna_halloween_invitation_2dcc1d8e:
    mike.say "И вечеринка костюмированная."

# ch/hanna/date.rpy:308
translate russian hanna_halloween_invitation_6488f5e5:
    mike.say "Так что нужно будет нарядиться!"

# ch/hanna/date.rpy:309
translate russian hanna_halloween_invitation_209b7992:
    "Эта последняя деталь словно пробуждает у Ханны какую-то мысль."

# ch/hanna/date.rpy:310
translate russian hanna_halloween_invitation_e42a3070:
    "И я почти чувствую, что сейчас получу ответ."

# ch/hanna/date.rpy:312
translate russian hanna_halloween_invitation_19f05b99:
    hanna.say "Знаешь, я уже собиралась отказаться."

# ch/hanna/date.rpy:313
translate russian hanna_halloween_invitation_2e29161e:
    hanna.say "Но ты сказал, что вечеринка костюмированная."

# ch/hanna/date.rpy:316
translate russian hanna_halloween_invitation_cb3750e6:
    hanna.say "А я ОБОЖАЮ наряжаться!"

# ch/hanna/date.rpy:317
translate russian hanna_halloween_invitation_e68bde2d:
    "Теперь я киваю ещё энергичнее."

# ch/hanna/date.rpy:318
translate russian hanna_halloween_invitation_03b351ce:
    "И улыбаюсь как дурак."

# ch/hanna/date.rpy:319
translate russian hanna_halloween_invitation_3ba8cb58:
    mike.say "Значит, придёшь?"

# ch/hanna/date.rpy:320
translate russian hanna_halloween_invitation_c350a8a1:
    mike.say "Это «да»?"

# ch/hanna/date.rpy:321
translate russian hanna_halloween_invitation_e6b288db:
    hanna.say "Конечно да, [lssb_hanna.hero_name()]!"

# ch/hanna/date.rpy:322
translate russian hanna_halloween_invitation_28ff6a24:
    hanna.say "Ни за что не пропущу."

# ch/hanna/date.rpy:323
translate russian hanna_halloween_invitation_1a0e3943:
    mike.say "Отлично, Ханна!"

# ch/hanna/date.rpy:324
translate russian hanna_halloween_invitation_e095d2f3:
    mike.say "Просто отлично!"

# ch/hanna/date.rpy:325
translate russian hanna_halloween_invitation_d071e98f:
    "Я на миг замолкаю: в голову приходит мысль."

# ch/hanna/date.rpy:326
translate russian hanna_halloween_invitation_ef6df9f8:
    "Продолжаю уже другим тоном, стараясь говорить небрежно."

# ch/hanna/date.rpy:327
translate russian hanna_halloween_invitation_cff114e6:
    mike.say "Слушай..."

# ch/hanna/date.rpy:328
translate russian hanna_halloween_invitation_32405696:
    mike.say "А какой костюм ты собираешься надеть?"

# ch/hanna/date.rpy:329
translate russian hanna_halloween_invitation_3c70f906:
    mike.say "Если скажешь, я прослежу, чтобы никто не пришёл в таком же..."

# ch/hanna/date.rpy:331
translate russian hanna_halloween_invitation_78291674:
    "Ханна смеётся и качает головой."

# ch/hanna/date.rpy:332
translate russian hanna_halloween_invitation_7db02631:
    "Я понимаю: она меня раскусила."

# ch/hanna/date.rpy:333
translate russian hanna_halloween_invitation_413ad896:
    hanna.say "Хорошая попытка, [lssb_hanna.hero_name()]!"

# ch/hanna/date.rpy:334
translate russian hanna_halloween_invitation_a76f2fa2:
    hanna.say "Придётся подождать и увидеть самому."

# ch/hanna/date.rpy:336
translate russian hanna_halloween_invitation_00ba0781:
    hanna.say "Но обещаю: ты не разочаруешься!"

# ch/hanna/date.rpy:341
translate russian hanna_halloween_invitation_72d29a42:
    hanna.say "Знаешь, пожалуй, я откажусь."

# ch/hanna/date.rpy:342
translate russian hanna_halloween_invitation_f6021dd6:
    "Мне требуется мгновение, чтобы осознать её слова."

# ch/hanna/date.rpy:343
translate russian hanna_halloween_invitation_e1ff9de2:
    "Потом я качаю головой, не веря, что она отказала."

# ch/hanna/date.rpy:344
translate russian hanna_halloween_invitation_0aa7bfb1:
    mike.say "Н... но почему, Ханна?"

# ch/hanna/date.rpy:345
translate russian hanna_halloween_invitation_58b12b0c:
    mike.say "У нас будет пунш и музыка."

# ch/hanna/date.rpy:346
translate russian hanna_halloween_invitation_9c8dded6:
    mike.say "И народу придёт полно."

# ch/hanna/date.rpy:347
translate russian hanna_halloween_invitation_6ef0fa83:
    mike.say "Жизнью клянусь, скучно не будет!"

# ch/hanna/date.rpy:349
translate russian hanna_halloween_invitation_c5e19ee8:
    "Ханна снисходительно улыбается."

# ch/hanna/date.rpy:350
translate russian hanna_halloween_invitation_d3978451:
    "Я чувствую себя ребёнком, которому взрослый объясняет очевидные вещи."

# ch/hanna/date.rpy:351
translate russian hanna_halloween_invitation_9735ef41:
    hanna.say "Ты наверняка решишь, что я та ещё стерва, [lssb_hanna.hero_name()]."

# ch/hanna/date.rpy:352
translate russian hanna_halloween_invitation_fa8f3ab5:
    hanna.say "Но таким я развлекалась ещё подростком."

# ch/hanna/date.rpy:353
translate russian hanna_halloween_invitation_3de55cac:
    hanna.say "Я не осуждаю тебя и твоих друзей."

# ch/hanna/date.rpy:354
translate russian hanna_halloween_invitation_064d0908:
    hanna.say "Просто теперь я взрослая и предпочитаю вести себя соответственно!"

# ch/hanna/date.rpy:355
translate russian hanna_halloween_invitation_0f793624:
    "Я открываю рот, собираясь поспорить."

# ch/hanna/date.rpy:356
translate russian hanna_halloween_invitation_2aa1c692:
    "Но потом качаю головой и решаю оставить эту тему."

# ch/hanna/date.rpy:357
translate russian hanna_halloween_invitation_ed351ebb:
    "Она права, мы оба взрослые."

# ch/hanna/date.rpy:358
translate russian hanna_halloween_invitation_a021f976:
    "Если не хочет приходить, на том и закончим."

# ch/hanna/date.rpy:359
translate russian hanna_halloween_invitation_c74b0bd6:
    mike.say "Ладно, Ханна."

# ch/hanna/date.rpy:360
translate russian hanna_halloween_invitation_72ef53c5:
    mike.say "Раз ты так считаешь, никаких проблем."

# ch/hanna/date.rpy:361
translate russian hanna_halloween_invitation_b74f028d:
    "Ханна снова снисходительно улыбается."

# ch/hanna/date.rpy:362
translate russian hanna_halloween_invitation_e44ae1ce:
    "И мы переходим к другой теме."

# ch/hanna/date.rpy:367
translate russian hanna_halloween_arrival_d249807e:
    "Я открываю дверь, толком не зная, чего ожидать."

# ch/hanna/date.rpy:368
translate russian hanna_halloween_arrival_21055b0d:
    "Да, я знаю, что Ханна любит выставлять себя напоказ."

# ch/hanna/date.rpy:369
translate russian hanna_halloween_arrival_21aecacc:
    "Но значит ли это, что она придёт в чём-то совсем уж невероятном?"

# ch/hanna/date.rpy:370
translate russian hanna_halloween_arrival_430770de:
    "В конце концов, это просто Хэллоуин — повод повеселиться."

# ch/hanna/date.rpy:372
translate russian hanna_halloween_arrival_e5a7fe68:
    hanna.say "Привет, [lssb_hanna.hero_name()]!"

# ch/hanna/date.rpy:373
translate russian hanna_halloween_arrival_6c8b48b7:
    hanna.say "Я не опоздала?"

# ch/hanna/date.rpy:374
translate russian hanna_halloween_arrival_dc985644:
    "Не сразу понимаю, что Ханна задала вопрос."

# ch/hanna/date.rpy:375
translate russian hanna_halloween_arrival_d00725b6:
    "Потому что глаза у меня чуть не вылезли из орбит!"

# ch/hanna/date.rpy:376
translate russian hanna_halloween_arrival_2d4c6d78:
    mike.say "Н... нет, Ханна..."

# ch/hanna/date.rpy:377
translate russian hanna_halloween_arrival_b6b1b81b:
    mike.say "Ты как раз вовремя!"

# ch/hanna/date.rpy:379
translate russian hanna_halloween_arrival_5fb10a37:
    "Ханна замечает моё изумление."

# ch/hanna/date.rpy:380
translate russian hanna_halloween_arrival_67c15920:
    "И от этого улыбается ещё шире."

# ch/hanna/date.rpy:381
translate russian hanna_halloween_arrival_bf313d3c:
    hanna.say "Нравится, да?"

# ch/hanna/date.rpy:382
translate russian hanna_halloween_arrival_737e0a0e:
    hanna.say "Я просто ОБЯЗАНА была прийти Радугой Смэш!"

# ch/hanna/date.rpy:383
translate russian hanna_halloween_arrival_d141d2b7:
    "На Ханне опасно короткие шорты и майка."

# ch/hanna/date.rpy:384
translate russian hanna_halloween_arrival_fe29ed6f:
    "А волосы окрашены во все цвета радуги."

# ch/hanna/date.rpy:385
translate russian hanna_halloween_arrival_4cf775c5:
    mike.say "Что?"

# ch/hanna/date.rpy:386
translate russian hanna_halloween_arrival_169679c1:
    mike.say "Как та пони?"

# ch/hanna/date.rpy:388
translate russian hanna_halloween_arrival_8db9e3a8:
    "Ханна радостно кивает."

# ch/hanna/date.rpy:389
translate russian hanna_halloween_arrival_71a1ac45:
    hanna.say "Да, именно!"

# ch/hanna/date.rpy:390
translate russian hanna_halloween_arrival_3c15efd3:
    hanna.say "Здорово, правда?"

# ch/hanna/date.rpy:393
translate russian hanna_halloween_arrival_8bb8c2be:
    "Конечно, здорово."

# ch/hanna/date.rpy:394
translate russian hanna_halloween_arrival_bd90bcf6:
    "Ханна пришла, выставив почти всё напоказ."

# ch/hanna/date.rpy:395
translate russian hanna_halloween_arrival_a10cb43f:
    "И без дурацкого костюма лошади!"

# ch/hanna/date.rpy:396
translate russian hanna_halloween_arrival_faedfcd0:
    mike.say "Идеально, Ханна."

# ch/hanna/date.rpy:397
translate russian hanna_halloween_arrival_ccdf64c9:
    mike.say "Сразу видно: «Я пони»."

# ch/hanna/date.rpy:398
translate russian hanna_halloween_arrival_5ef23876:
    mike.say "И при этом ты не взвалила на себя целую сбрую!"

# ch/hanna/date.rpy:400
translate russian hanna_halloween_arrival_a749dd55:
    "Ханна закатывает глаза от моих нарочитых каламбуров."

# ch/hanna/date.rpy:402
translate russian hanna_halloween_arrival_a2edd40a:
    "Но, похоже, готова их простить."

# ch/hanna/date.rpy:403
translate russian hanna_halloween_arrival_5331d068:
    hanna.say "Ну..."

# ch/hanna/date.rpy:404
translate russian hanna_halloween_arrival_ccd9777f:
    hanna.say "Может, и не целую сбрую..."

# ch/hanna/date.rpy:405
translate russian hanna_halloween_arrival_3ff051da:
    "Тут я навостряю уши."

# ch/hanna/date.rpy:406
translate russian hanna_halloween_arrival_0a513e04:
    "Почти как накладные ушки на голове у Ханны."

# ch/hanna/date.rpy:407
translate russian hanna_halloween_arrival_f1d8a63c:
    mike.say "Эм..."

# ch/hanna/date.rpy:408
translate russian hanna_halloween_arrival_0b1ad887:
    mike.say "Что ты имеешь в виду, Ханна?"

# ch/hanna/date.rpy:409
translate russian hanna_halloween_arrival_238c167a:
    hanna.say "Ну, знаешь..."

# ch/hanna/date.rpy:412
translate russian hanna_halloween_arrival_33b2cae7:
    hanna.say "Люблю покрасоваться."

# ch/hanna/date.rpy:413
translate russian hanna_halloween_arrival_38a4d6ba:
    hanna.say "Блеснуть на танцполе."

# ch/hanna/date.rpy:414
translate russian hanna_halloween_arrival_cf43e947:
    hanna.say "И иногда совсем не против, чтобы на мне покатались..."

# ch/hanna/date.rpy:415
translate russian hanna_halloween_arrival_1ccab2e1:
    mike.say "Хм..."

# ch/hanna/date.rpy:416
translate russian hanna_halloween_arrival_49cfb36c:
    mike.say "Что ты там сказала в конце?!"

# ch/hanna/date.rpy:418
translate russian hanna_halloween_arrival_6574d652:
    "Ханна улыбается и легко проскальзывает мимо меня в дом."

# ch/hanna/date.rpy:419
translate russian hanna_halloween_arrival_6bf3f3d8:
    "А я иду за ней по пятам."

# ch/hanna/date.rpy:421
translate russian hanna_halloween_arrival_bd139db4:
    "Я немного отступаю и внимательно осматриваю её костюм."

# ch/hanna/date.rpy:422
translate russian hanna_halloween_arrival_6c292032:
    "Затем качаю головой — ничего не понимаю."

# ch/hanna/date.rpy:423
translate russian hanna_halloween_arrival_3a5ebceb:
    mike.say "Какая же ты Радуга Смэш, Ханна?"

# ch/hanna/date.rpy:424
translate russian hanna_halloween_arrival_49bcf10f:
    mike.say "Просто надела ушки на голову."

# ch/hanna/date.rpy:425
translate russian hanna_halloween_arrival_124881c6:
    mike.say "А где копыта и хвост?"

# ch/hanna/date.rpy:428
translate russian hanna_halloween_arrival_483fe315:
    "Ханна смотрит на меня с нескрываемым изумлением."

# ch/hanna/date.rpy:429
translate russian hanna_halloween_arrival_2af5817d:
    "И скрещивает руки на груди."

# ch/hanna/date.rpy:430
translate russian hanna_halloween_arrival_f8792a36:
    hanna.say "Чтобы быть Радугой Смэш, не обязательно становиться настоящей лошадью, [lssb_hanna.hero_name()]!"

# ch/hanna/date.rpy:431
translate russian hanna_halloween_arrival_ad90d01e:
    hanna.say "Они постоянно появляются в человеческом облике, все это знают!"

# ch/hanna/date.rpy:432
translate russian hanna_halloween_arrival_4a284caf:
    "Я хмурюсь: объяснение Ханны меня не убеждает."

# ch/hanna/date.rpy:433
translate russian hanna_halloween_arrival_e30622bc:
    mike.say "Как скажешь, Ханна."

# ch/hanna/date.rpy:434
translate russian hanna_halloween_arrival_64c23ca4:
    mike.say "Можешь считать меня старомодным."

# ch/hanna/date.rpy:435
translate russian hanna_halloween_arrival_bb4b1bea:
    mike.say "Но, по-моему, у пони должны быть копыта и хвост."

# ch/hanna/date.rpy:436
translate russian hanna_halloween_arrival_b73cfb03:
    hanna.say "Да-да, [lssb_hanna.hero_name()], как скажешь."

# ch/hanna/date.rpy:437
translate russian hanna_halloween_arrival_559fcbe4:
    hanna.say "Можно мне уже войти?!"

# ch/hanna/date.rpy:446
translate russian hanna_halloween_party_a4c476ab:
    scottie.say "Ого!"

# ch/hanna/date.rpy:447
translate russian hanna_halloween_party_cb4abb29:
    scottie.say "Вот такую пони я понимаю!"

# ch/hanna/date.rpy:448
translate russian hanna_halloween_party_a0347fff:
    scottie.say "Сегодня покатаешь желающих или как?!"

# ch/hanna/date.rpy:449
translate russian hanna_halloween_party_f8ec37bf:
    "Мне требуется секунда, чтобы сообразить, о чём речь."

# ch/hanna/date.rpy:450
translate russian hanna_halloween_party_38d02c88:
    "Но затем я резко поворачиваюсь к Скотти."

# ch/hanna/date.rpy:451
translate russian hanna_halloween_party_f9d02100:
    "Он с явным вожделением говорит о пони и катании."

# ch/hanna/date.rpy:452
translate russian hanna_halloween_party_5163f5c1:
    "А значит, его внимание может быть направлено лишь на одну гостью!"

# ch/hanna/date.rpy:455
translate russian hanna_halloween_party_bb398011:
    hanna.say "Ха!"

# ch/hanna/date.rpy:456
translate russian hanna_halloween_party_6a53efb4:
    hanna.say "Думаешь, я выдержу твой вес?"

# ch/hanna/date.rpy:457
translate russian hanna_halloween_party_43ef7fa9:
    hanna.say "Может, я совсем не такая пони!"

# ch/hanna/date.rpy:458
translate russian hanna_halloween_party_4c3b3c8b:
    "По голосу Ханны слышно: ей нравится возможность пофлиртовать."

# ch/hanna/date.rpy:459
translate russian hanna_halloween_party_4118fa82:
    "А Скотти из тех, кого чужая девушка нисколько не смущает."

# ch/hanna/date.rpy:460
translate russian hanna_halloween_party_79df07ae:
    "Если хочу предотвратить неприятности, нужно действовать быстро."

# ch/hanna/date.rpy:461
translate russian hanna_halloween_party_609c7133:
    "Но что я могу сделать?!"

# ch/hanna/date.rpy:464
translate russian hanna_halloween_party_325b7ce1:
    mike.say "Эй, Скотти, полегче."

# ch/hanna/date.rpy:465
translate russian hanna_halloween_party_6a714521:
    mike.say "Место в седле уже занято."

# ch/hanna/date.rpy:466
translate russian hanna_halloween_party_0eb64d39:
    mike.say "Найди себе другую!"

# ch/hanna/date.rpy:470
translate russian hanna_halloween_party_f323fba5:
    "Ханна и Скотти оборачиваются ко мне."

# ch/hanna/date.rpy:471
translate russian hanna_halloween_party_ec523feb:
    "Он удивлён и немного смущён."

# ch/hanna/date.rpy:472
translate russian hanna_halloween_party_835495aa:
    "А глаза Ханны загораются от моих слов."

# ch/hanna/date.rpy:473
translate russian hanna_halloween_party_ae15b510:
    "И видно, что она возбуждена!"

# ch/hanna/date.rpy:474
translate russian hanna_halloween_party_3c681d25:
    scottie.say "О... привет!"

# ch/hanna/date.rpy:475
translate russian hanna_halloween_party_4bc0b3bc:
    scottie.say "Не заметил тебя, чувак."

# ch/hanna/date.rpy:476
translate russian hanna_halloween_party_141e195b:
    scottie.say "Не переживай, я просто шутил."

# ch/hanna/date.rpy:477
translate russian hanna_halloween_party_8ae6455f:
    "Скотти кивает."

# ch/hanna/date.rpy:481
translate russian hanna_halloween_party_a242ff0b:
    "И поспешно уходит."

# ch/hanna/date.rpy:482
translate russian hanna_halloween_party_2345cf5e:
    mike.say "Прости, Ханна."

# ch/hanna/date.rpy:483
translate russian hanna_halloween_party_58336e87:
    mike.say "Другие могут смотреть сколько угодно."

# ch/hanna/date.rpy:484
translate russian hanna_halloween_party_ff3d2df4:
    mike.say "Но скакать на тебе буду только я!"

# ch/hanna/date.rpy:485
translate russian hanna_halloween_party_bd6be938:
    hanna.say "Н... ничего страшного, [lssb_hanna.hero_name()]."

# ch/hanna/date.rpy:486
translate russian hanna_halloween_party_737d8184:
    hanna.say "Всё хорошо."

# ch/hanna/date.rpy:488
translate russian hanna_halloween_party_16c8e521:
    hanna.say "Только сдержи своё обещание!"

# ch/hanna/date.rpy:490
translate russian hanna_halloween_party_03c9c85f:
    mike.say "Эм... привет!"

# ch/hanna/date.rpy:491
translate russian hanna_halloween_party_535dd69f:
    mike.say "У вас двоих совесть есть?"

# ch/hanna/date.rpy:492
translate russian hanna_halloween_party_42c64736:
    mike.say "Я вообще-то здесь стою!"

# ch/hanna/date.rpy:497
translate russian hanna_halloween_party_f323fba5_1:
    "Ханна и Скотти оборачиваются ко мне."

# ch/hanna/date.rpy:498
translate russian hanna_halloween_party_ec523feb_1:
    "Он удивлён и немного смущён."

# ch/hanna/date.rpy:499
translate russian hanna_halloween_party_97085975:
    "А Ханна лишь раздражённо смотрит на меня."

# ch/hanna/date.rpy:500
translate russian hanna_halloween_party_3c681d25_1:
    scottie.say "О... привет!"

# ch/hanna/date.rpy:501
translate russian hanna_halloween_party_4bc0b3bc_1:
    scottie.say "Не заметил тебя, чувак."

# ch/hanna/date.rpy:502
translate russian hanna_halloween_party_141e195b_1:
    scottie.say "Не переживай, я просто шутил."

# ch/hanna/date.rpy:503
translate russian hanna_halloween_party_8ae6455f_1:
    "Скотти кивает."

# ch/hanna/date.rpy:507
translate russian hanna_halloween_party_a242ff0b_1:
    "И поспешно уходит."

# ch/hanna/date.rpy:508
translate russian hanna_halloween_party_4dc7440d:
    hanna.say "Обязательно было так делать, [lssb_hanna.hero_name()]?"

# ch/hanna/date.rpy:509
translate russian hanna_halloween_party_9319e550:
    hanna.say "Он просто был любезен!"

# ch/hanna/date.rpy:510
translate russian hanna_halloween_party_ad4c5193:
    "Я отвожу взгляд, чувствуя себя капризным придурком."

# ch/hanna/date.rpy:511
translate russian hanna_halloween_party_5aba8084:
    "И в ответ могу лишь что-то пробормотать себе под нос."

# ch/hanna/date.rpy:521
translate russian hanna_halloween_dance_115e1224:
    hanna.say "Ну же, [lssb_hanna.hero_name()]!"

# ch/hanna/date.rpy:522
translate russian hanna_halloween_dance_76bb8038:
    hanna.say "Когда мы уже пойдём танцевать?"

# ch/hanna/date.rpy:523
translate russian hanna_halloween_dance_b965d391:
    "В голосе Ханны слышится нетерпение."

# ch/hanna/date.rpy:524
translate russian hanna_halloween_dance_71bcd8cd:
    "Она весь вечер поглядывает на наш импровизированный танцпол."

# ch/hanna/date.rpy:525
translate russian hanna_halloween_dance_b5024d63:
    "Но сам я почему-то не рвусь туда так же сильно."

# ch/hanna/date.rpy:526
translate russian hanna_halloween_dance_f9d722cf:
    "Если бы Ханна уделяла мне столько же внимания..."

# ch/hanna/date.rpy:527
translate russian hanna_halloween_dance_668406b0:
    "Возможно, я бы чувствовал себя иначе."

# ch/hanna/date.rpy:528
translate russian hanna_halloween_dance_da85f5cd:
    hanna.say "Ну?"

# ch/hanna/date.rpy:529
translate russian hanna_halloween_dance_24ebc0b4:
    hanna.say "Ты идёшь или нет?!"

# ch/hanna/date.rpy:532
translate russian hanna_halloween_dance_05167811:
    "Значит, сама она уделять мне внимание не собирается?"

# ch/hanna/date.rpy:533
translate russian hanna_halloween_dance_2536230b:
    "Тогда я добьюсь его сам!"

# ch/hanna/date.rpy:535
translate russian hanna_halloween_dance_a87fd8a8:
    mike.say "Конечно, Ханна."

# ch/hanna/date.rpy:536
translate russian hanna_halloween_dance_2a76de18:
    mike.say "Нам обязательно нужно потанцевать вместе."

# ch/hanna/date.rpy:540
translate russian hanna_halloween_dance_88aaa35e:
    "Беру Ханну за руку и тяну на танцпол."

# ch/hanna/date.rpy:541
translate russian hanna_halloween_dance_53d827d7:
    "С этого момента всё моё внимание принадлежит только ей."

# ch/hanna/date.rpy:542
translate russian hanna_halloween_dance_84732abf:
    "Слежу за каждым движением и отвечаю своим."

# ch/hanna/date.rpy:543
translate russian hanna_halloween_dance_07f53b86:
    "Иду за ней, куда бы она ни направилась, не сводя глаз."

# ch/hanna/date.rpy:544
translate russian hanna_halloween_dance_fac7f651:
    "И, как и следовало ожидать, Ханна упивается вниманием."

# ch/hanna/date.rpy:545
translate russian hanna_halloween_dance_96a46907:
    "Я открыто восхищаюсь всем, что она делает."

# ch/hanna/date.rpy:546
translate russian hanna_halloween_dance_651593cd:
    "Даю ей почувствовать себя единственной девушкой в комнате."

# ch/hanna/date.rpy:547
translate russian hanna_halloween_dance_bbaa74ef:
    "Словно раздуваю огонь, а потом ещё подливаю бензина!"

# ch/hanna/date.rpy:548
translate russian hanna_halloween_dance_619b2cd8:
    "Мы танцуем одну песню за другой."

# ch/hanna/date.rpy:549
translate russian hanna_halloween_dance_eb176b0a:
    "И Ханна купается в моём безраздельном внимании."

# ch/hanna/date.rpy:551
translate russian hanna_halloween_dance_b3d63486:
    "Похоже, Ханна пойдёт танцевать независимо от моего ответа."

# ch/hanna/date.rpy:552
translate russian hanna_halloween_dance_ac94bbf4:
    "Значит, ей всё равно, пойду ли я с ней!"

# ch/hanna/date.rpy:553
translate russian hanna_halloween_dance_3654acfe:
    mike.say "Знаешь, Ханна..."

# ch/hanna/date.rpy:554
translate russian hanna_halloween_dance_e43366e8:
    mike.say "Я, пожалуй, пропущу."

# ch/hanna/date.rpy:555
translate russian hanna_halloween_dance_fd3a28bb:
    mike.say "А ты иди, если..."

# ch/hanna/date.rpy:556
translate russian hanna_halloween_dance_0afb395b:
    "Не успеваю договорить, как Ханна уже уходит."

# ch/hanna/date.rpy:557
translate russian hanna_halloween_dance_beed054b:
    "Словно ей даже не нужно моё разрешение оставить меня одного."

# ch/hanna/date.rpy:558
translate russian hanna_halloween_dance_5fa2f334:
    hanna.say "Как хочешь, [lssb_hanna.hero_name()]."

# ch/hanna/date.rpy:559
translate russian hanna_halloween_dance_c151d26e:
    hanna.say "Увидимся!"

# ch/hanna/date.rpy:562
translate russian hanna_halloween_dance_a4044218:
    "Вот так просто она уходит."

# ch/hanna/date.rpy:563
translate russian hanna_halloween_dance_52b54591:
    "Я стою и смотрю, как Ханна танцует одну песню за другой."

# ch/hanna/date.rpy:564
translate russian hanna_halloween_dance_208685c3:
    "Сначала с Джеком."

# ch/hanna/date.rpy:565
translate russian hanna_halloween_dance_ec6d8a24:
    "Потом со Скотти."

# ch/hanna/date.rpy:566
translate russian hanna_halloween_dance_1cb9b641:
    "А затем одновременно с Джеком и Скотти."

# ch/hanna/date.rpy:567
translate russian hanna_halloween_dance_58b513f3:
    "А я могу лишь твердить себе, что всё нормально."

# ch/hanna/date.rpy:568
translate russian hanna_halloween_dance_3f818bd9:
    "Всё нормально, и я ни капельки не ревную..."

# ch/hanna/date.rpy:579
translate russian hanna_halloween_sex_03434a97:
    "Не секрет, что Ханне нравится притягивать все взгляды в комнате."

# ch/hanna/date.rpy:580
translate russian hanna_halloween_sex_a65b3263:
    "Сегодня она сделала всё, чтобы оказаться в центре внимания."

# ch/hanna/date.rpy:581
translate russian hanna_halloween_sex_1898a3e7:
    "Флиртовала, веселилась и была душой компании."

# ch/hanna/date.rpy:582
translate russian hanna_halloween_sex_bb2103d7:
    "Поэтому весь вечер ею любовались и в открытую, и издалека."

# ch/hanna/date.rpy:583
translate russian hanna_halloween_sex_dd6f5845:
    "Не то чтобы это меня сильно волновало или заставляло безумно ревновать."

# ch/hanna/date.rpy:584
translate russian hanna_halloween_sex_e643a1c6:
    "Ведь большую часть внимания она всё это время уделяла мне."

# ch/hanna/date.rpy:585
translate russian hanna_halloween_sex_be885444:
    "Не раз я ловлю Джека и Скотти на том, что они откровенно глазеют на Ханну."

# ch/hanna/date.rpy:586
translate russian hanna_halloween_sex_fab6ee7d:
    "И от этого лишь ещё сильнее радуюсь, что именно она пришла со мной."

# ch/hanna/date.rpy:587
translate russian hanna_halloween_sex_28eb598b:
    hanna.say "Видел, как они весь вечер на меня смотрели, [lssb_hanna.hero_name()]?"

# ch/hanna/date.rpy:588
translate russian hanna_halloween_sex_6ab7c2af:
    hanna.say "Пусть смотрят. Такое тело само собой не появляется."

# ch/hanna/date.rpy:589
translate russian hanna_halloween_sex_10f06010:
    "Она сгибает руку, демонстрируя мышцы, которыми так гордится."

# ch/hanna/date.rpy:590
translate russian hanna_halloween_sex_c24ddb8e:
    "Потом наклоняется ближе и понижает голос, чтобы слышал только я."

# ch/hanna/date.rpy:591
translate russian hanna_halloween_sex_3a9fb0e6:
    hanna.say "Но трогать разрешено лишь тебе, [lssb_hanna.hero_name()]."

# ch/hanna/date.rpy:592
translate russian hanna_halloween_sex_6a97f254:
    "А в спальне я точно знаю: сейчас она только моя."

# ch/hanna/date.rpy:596
translate russian hanna_halloween_sex_796dc0c5:
    "Наконец оставшись наедине, Ханна не теряет времени."

# ch/hanna/date.rpy:597
translate russian hanna_halloween_sex_db972bf5:
    hanna.say "Боже, я уже несколько часов мечтаю остаться с тобой вдвоём."

# ch/hanna/date.rpy:598
translate russian hanna_halloween_sex_ca223f9a:
    "Она снимает часть костюма, позволяя мне наблюдать каждую секунду."

# ch/hanna/date.rpy:599
translate russian hanna_halloween_sex_aabfc031:
    hanna.say "Нравится? Ну же, признайся."

# ch/hanna/date.rpy:600
translate russian hanna_halloween_sex_13a6fc71:
    "Подтянутая, упругая и возбуждённая — только для меня."

# ch/hanna/date.rpy:601
translate russian hanna_halloween_sex_6f6beda4:
    hanna.say "Ты это заслужил, так что не стесняйся."

# ch/hanna/date.rpy:602
translate russian hanna_halloween_sex_15c92f6a:
    "Будто сейчас я способен смотреть куда-то ещё."

# ch/hanna/date.rpy:605
translate russian hanna_halloween_sex_626dc186:
    hanna.say "Ты был хорошим мальчиком, [lssb_hanna.hero_name()]."

# ch/hanna/date.rpy:607
translate russian hanna_halloween_sex_37785043:
    hanna.say "А значит, получишь награду!"

# ch/hanna/date.rpy:608
translate russian hanna_halloween_sex_96cb629f:
    "Я с готовностью киваю, заворожённый её движениями."

# ch/hanna/date.rpy:610
translate russian hanna_halloween_sex_fe5e0c41:
    "И с трудом сосредотачиваюсь на её словах."

# ch/hanna/date.rpy:611
translate russian hanna_halloween_sex_b8135daf:
    mike.say "Д... да, Ханна..."

# ch/hanna/date.rpy:612
translate russian hanna_halloween_sex_1ebe68e2:
    mike.say "Как скажешь!"

# ch/hanna/date.rpy:613
translate russian hanna_halloween_sex_ed2cbef5:
    "Ханна тоже кивает и останавливается у изножья кровати."

# ch/hanna/date.rpy:615
translate russian hanna_halloween_sex_a5334d91:
    "Забирается на матрас спиной вперёд, задирая топ."

# ch/hanna/date.rpy:616
translate russian hanna_halloween_sex_1735b1c8:
    "Освободившаяся грудь покачивается в такт её движениям."

# ch/hanna/date.rpy:617
