# ch/hanna/reactions.rpy:314
translate russian hanna_belly_caress_male_4cb4331c:
    "Из-за меньшей активности в последнее время она немного прибавила в весе."

# ch/hanna/reactions.rpy:315
translate russian hanna_belly_caress_male_874f00e1:
    "При этом по-прежнему носит в основном обтягивающую эластичную одежду."

# ch/hanna/reactions.rpy:316
translate russian hanna_belly_caress_male_52110d6d:
    "Она ничего не скрывает от воображения, да ещё и живот заметно выступает вперёд!"

# ch/hanna/reactions.rpy:317
translate russian hanna_belly_caress_male_531c0085:
    "Поэтому мне хочется прикасаться к ней при любой возможности."

# ch/hanna/reactions.rpy:318
translate russian hanna_belly_caress_male_edd4ce45:
    mike.say "О-ох..."

# ch/hanna/reactions.rpy:319
translate russian hanna_belly_caress_male_2d04e00e:
    mike.say "Ханна..."

# ch/hanna/reactions.rpy:320
translate russian hanna_belly_caress_male_e5189b1d:
    mike.say "Дай мне..."

# ch/hanna/reactions.rpy:322
translate russian hanna_belly_caress_male_93787ea1:
    "Не успеваю я закончить, как она перебивает меня."

# ch/hanna/reactions.rpy:323
translate russian hanna_belly_caress_male_b24183c4:
    "И одновременно упирается в меня своим огромным животом!"

# ch/hanna/reactions.rpy:325
translate russian hanna_belly_caress_male_a22bb7d6:
    hanna.say "Не трать дыхание на вопросы, [lssb_hanna.hero_name()]."

# ch/hanna/reactions.rpy:326
translate russian hanna_belly_caress_male_3ed1bdb8:
    hanna.say "Я знаю, что ты собираешься сказать."

# ch/hanna/reactions.rpy:327
translate russian hanna_belly_caress_male_978031ec:
    hanna.say "То же, что в последнее время говорят все."

# ch/hanna/reactions.rpy:329
translate russian hanna_belly_caress_male_a5d3930c:
    hanna.say "«Ой, можно потрогать твой животик?»"

# ch/hanna/reactions.rpy:331
translate russian hanna_belly_caress_male_4bcfbcf7:
    "Мои руки уже лежат у неё на животе, так что я принимаю это за разрешение."

# ch/hanna/reactions.rpy:332
translate russian hanna_belly_caress_male_955baa26:
    "И с удовольствием начинаю гладить его, слушая её жалобы на беременность."

# ch/hanna/reactions.rpy:334
translate russian hanna_belly_caress_male_7e2ad052:
    hanna.say "Раньше все хотели потрогать мой плоский как доска пресс."

# ch/hanna/reactions.rpy:335
translate russian hanna_belly_caress_male_81efb05b:
    hanna.say "Или пощупать, какие крепкие у меня бицепсы."

# ch/hanna/reactions.rpy:336
translate russian hanna_belly_caress_male_4172f3b2:
    hanna.say "Чёрт, сейчас я бы даже не возражала, если бы кто-то захотел ущипнуть меня за задницу!"

# ch/hanna/reactions.rpy:337
translate russian hanna_belly_caress_male_026d3103:
    hanna.say "Но всех интересует только этот огромный живот."

# ch/hanna/reactions.rpy:339
translate russian hanna_belly_caress_male_9157060a:
    "Пока Ханна продолжает жаловаться, я стараюсь вовремя кивать."

# ch/hanna/reactions.rpy:340
translate russian hanna_belly_caress_male_8725a409:
    "Но на самом деле почти не слушаю её."

# ch/hanna/reactions.rpy:341
translate russian hanna_belly_caress_male_52fb28d8:
    "Лишь улыбаюсь, ощущая тяжесть её живота."

# ch/hanna/reactions.rpy:342
translate russian hanna_belly_caress_male_eb469a03:
    "И уже мечтаю о том, как стану папой."

# ch/hanna/reactions.rpy:349
translate russian hanna_belly_listen_male_5331d068:
    hanna.say "Ну..."

# ch/hanna/reactions.rpy:350
translate russian hanna_belly_listen_male_5015eae1:
    hanna.say "Слышишь что-нибудь?"

# ch/hanna/reactions.rpy:352
translate russian hanna_belly_listen_male_39924f3e:
    "Прижавшись ухом к животу Ханны, я машу рукой в воздухе."

# ch/hanna/reactions.rpy:353
translate russian hanna_belly_listen_male_d6d1e88a:
    mike.say "Пока ты задаёшь вопросы, ничего не слышу!"

# ch/hanna/reactions.rpy:354
translate russian hanna_belly_listen_male_f5fbda8e:
    mike.say "Помолчи минутку, ладно?"

# ch/hanna/reactions.rpy:356
translate russian hanna_belly_listen_male_c7a1ad47:
    "В ответ она что-то бормочет себе под нос."

# ch/hanna/reactions.rpy:357
translate russian hanna_belly_listen_male_9daca7b0:
    "Но хотя бы больше не говорит громко."

# ch/hanna/reactions.rpy:358
translate russian hanna_belly_listen_male_13d3dfaf:
    "И в наступившей тишине я наконец впервые что-то слышу."

# ch/hanna/reactions.rpy:360
translate russian hanna_belly_listen_male_9765f328:
    "Я стараюсь убедиться, что это не сердцебиение самой Ханны."

# ch/hanna/reactions.rpy:361
translate russian hanna_belly_listen_male_025c53ac:
    "А затем понимаю: звук исходит от ребёнка."

# ch/hanna/reactions.rpy:362
translate russian hanna_belly_listen_male_674c9ff2:
    mike.say "Вот..."

# ch/hanna/reactions.rpy:363
translate russian hanna_belly_listen_male_b5f9acc3:
    mike.say "Слышу..."

# ch/hanna/reactions.rpy:364
translate russian hanna_belly_listen_male_4196e57b:
    mike.say "Слышу, как малыш шевелится!"

# ch/hanna/reactions.rpy:366
translate russian hanna_belly_listen_male_76f29f0a:
    hanna.say "Правда?"

# ch/hanna/reactions.rpy:367
translate russian hanna_belly_listen_male_2da5c454:
    hanna.say "Ох, как я завидую!"

# ch/hanna/reactions.rpy:368
translate russian hanna_belly_listen_male_052f099c:
    hanna.say "Вот бы и мне как-нибудь послушать."

# ch/hanna/reactions.rpy:370
translate russian hanna_belly_listen_male_ca386a0e:
    hanna.say "Может, получится записать или что-то вроде того?"

# ch/hanna/reactions.rpy:371
translate russian hanna_belly_listen_male_2b2a6355:
    "Я рассеянно киваю, снова почти не слыша её слов."

# ch/hanna/reactions.rpy:372
translate russian hanna_belly_listen_male_d67239a6:
    "Ведь я слышу, как там шевелится мой ещё не родившийся ребёнок."

# ch/hanna/reactions.rpy:373
translate russian hanna_belly_listen_male_07221088:
    "Я уже видел снимки и слышал эти звуки через аппараты в больнице."

# ch/hanna/reactions.rpy:374
translate russian hanna_belly_listen_male_b3d8efa4:
    "Но когда слышишь собственным ухом, всё почему-то кажется реальнее."

# ch/hanna/reactions.rpy:375
translate russian hanna_belly_listen_male_6b5fb7cb:
    "И именно в этот момент до меня наконец доходит."

# ch/hanna/reactions.rpy:376
translate russian hanna_belly_listen_male_7fa9cbb2:
    "Вот чёрт, я и правда стану отцом!"

# ch/hanna/talk.rpy:3
translate russian hanna_talk_love_male_2ec78658:
    hanna.say "Ты когда-нибудь думал о том, чтобы влюбиться? Какой должна быть твоя любимая?"

# ch/hanna/talk.rpy:6
translate russian hanna_talk_love_male_459cd3b0:
    mike.say "Ну, вообще-то... я особо об этом не задумывался, пока не встретил тебя."

# ch/hanna/talk.rpy:8
translate russian hanna_talk_love_male_8aa19965:
    hanna.say "Ч... что? Меня? [lssb_hanna.hero_name()], подожди, я... ты так торопишься!"

# ch/hanna/talk.rpy:11
translate russian hanna_talk_love_male_778285c6:
    mike.say "О да, думаю, с одной девушкой у нас очень сильная связь. Может, это и есть настоящая любовь."

# ch/hanna/talk.rpy:13
translate russian hanna_talk_love_male_bcaefabe:
    hanna.say "Д... да что ты...? Ну, ей очень повезло."

# ch/hanna/talk.rpy:16
translate russian hanna_talk_love_male_54f9a824:
    mike.say "Любовь? Ха. Не нужна."

# ch/hanna/talk.rpy:17
translate russian hanna_talk_love_male_108276c6:
    mike.say "Мы всего лишь млекопитающие, и единственная нужная нам «любовь» — физическая."

# ch/hanna/talk.rpy:18
translate russian hanna_talk_love_male_125abad3:
    mike.say "Понимаешь, о чём я."

# ch/hanna/talk.rpy:19
translate russian hanna_talk_love_male_997b1425:
    hanna.say "Т... ты и правда... настоящий зверь!"

# ch/hanna/talk.rpy:22
translate russian hanna_talk_love_male_039c3e88:
    mike.say "Я понял: чтобы любить других, нужно любить себя. И, честно говоря, себя я люблю так сильно, что больше мне никто не нужен."

# ch/hanna/talk.rpy:24
translate russian hanna_talk_love_male_d0a2e7de:
    hanna.say "О, ну, то есть, ты... ты и правда замечательный, но... совсем никто?.."

# ch/hanna/talk.rpy:31
translate russian hanna_talk_sex_male_29aa19e9:
    hanna.say "Ну, а ты, эм... уже занимался с кем-нибудь сексом? Что... тебе нравится?"

# ch/hanna/talk.rpy:34
translate russian hanna_talk_sex_male_28f4557b:
    mike.say "Секс — это здорово. Мне всегда мало! Только иногда трудно найти девушек, которые тоже хотят, понимаешь?"

# ch/hanna/talk.rpy:35
translate russian hanna_talk_sex_male_ecd06e9e:
    hanna.say "Тебе правда трудно? Ух ты, никогда бы не подумала!"

# ch/hanna/talk.rpy:38
translate russian hanna_talk_sex_male_383e6bfe:
    mike.say "Что? Ты предлагаешь? Потому что если да, то я согласен!"

# ch/hanna/talk.rpy:40
translate russian hanna_talk_sex_male_8412f34c:
    hanna.say "Что? Я разве сказала, что хочу? Кажется, нет... не то чтобы я не хотела... ой, боже!"

# ch/hanna/talk.rpy:43
translate russian hanna_talk_sex_male_b714d885:
    mike.say "Ещё бы. Сейчас мне очень хочется выпустить наружу свою властную мужскую натуру."

# ch/hanna/talk.rpy:44
translate russian hanna_talk_sex_male_7db1a2d3:
    mike.say "Дать волю зверю и хорошенько оттрахать девушку, понимаешь?"

# ch/hanna/talk.rpy:46
translate russian hanna_talk_sex_male_0246f76b:
    hanna.say "А-а... н... ну... это... сильно!"

# ch/hanna/talk.rpy:49
translate russian hanna_talk_sex_male_9d57fa07:
    mike.say "Мне очень нравится, когда женщина берёт всё в свои руки."

# ch/hanna/talk.rpy:50
translate russian hanna_talk_sex_male_5e240e75:
    mike.say "Если она скажет, чего хочет, я её послушаю."

# ch/hanna/talk.rpy:51
translate russian hanna_talk_sex_male_a98df277:
    mike.say "Сделаю всё, о чём попросит. Вот это настоящее блаженство."

# ch/hanna/talk.rpy:52
translate russian hanna_talk_sex_male_346f8377:
    hanna.say "Т... то есть тебе нравятся властные женщины... Понятно..."

# ch/hanna/talk.rpy:59
translate russian hanna_talk_politics_male_e4d3a5ef:
    hanna.say "В мире столько проблем... А я просто хочу стать лучше, понимаешь?"

# ch/hanna/talk.rpy:60
translate russian hanna_talk_politics_male_5598c52d:
    hanna.say "Не хочу лезть во всю эту политическую кашу."

# ch/hanna/talk.rpy:63
translate russian hanna_talk_politics_male_3b430c75:
    mike.say "Понимаю. Трудно что-то сделать для мира, если собственное тело — дряблая развалина."

# ch/hanna/talk.rpy:64
translate russian hanna_talk_politics_male_21de1b82:
    hanna.say "Да, знаю. Но ведь совершенствовать себя можно бесконечно, правда?"

# ch/hanna/talk.rpy:65
translate russian hanna_talk_politics_male_cb172a05:
    hanna.say "Вот что здорово! Никаких забот об окружающем мире, только наши собственные желания."

# ch/hanna/talk.rpy:66
translate russian hanna_talk_politics_male_83d72670:
    hanna.say "Если бы каждый просто старался стать лучше, все были бы счастливее!"

# ch/hanna/talk.rpy:69
translate russian hanna_talk_politics_male_e7ee93a2:
    mike.say "Нельзя просто игнорировать всё, что происходит в мире, Ханна."

# ch/hanna/talk.rpy:70
translate russian hanna_talk_politics_male_7501a3e1:
    mike.say "Даже если мы всю жизнь проведём за тренировками, после нас останется мир, с которым другим придётся что-то делать."

# ch/hanna/talk.rpy:72
translate russian hanna_talk_politics_male_c5e74336:
    hanna.say "Но я же не могу тренироваться за других? Вот пусть и решают всё сами."

# ch/hanna/talk.rpy:75
translate russian hanna_talk_politics_male_f839284a:
    mike.say "Ханна, улучшая себя, можно помогать и другим."

# ch/hanna/talk.rpy:76
translate russian hanna_talk_politics_male_a6f26e67:
    hanna.say "Да? Это как?"

# ch/hanna/talk.rpy:77
translate russian hanna_talk_politics_male_4ffe4768:
    mike.say "Ну, ты ведь отлично разбираешься в фитнесе."

# ch/hanna/talk.rpy:78
translate russian hanna_talk_politics_male_4656d0bb:
    mike.say "Я бы точно не ходил в зал так часто, если бы не надеялся тебя увидеть."

# ch/hanna/talk.rpy:79
translate russian hanna_talk_politics_male_ba0b200a:
    mike.say "В политике тоже есть вопросы здоровья и физкультуры: например, как приучить детей заниматься спортом и правильно питаться."

# ch/hanna/talk.rpy:80
translate russian hanna_talk_politics_male_f91ab44f:
    hanna.say "Хм... Знаешь, может, ты и прав."

# ch/hanna/talk.rpy:81
translate russian hanna_talk_politics_male_f7e0218e:
    hanna.say "Может, стоит чаще показывать себя и вдохновлять людей действовать."

# ch/hanna/talk.rpy:84
translate russian hanna_talk_politics_male_e545efd8:
    mike.say "Да я в этом особо не разбираюсь. Наверное, просто стараюсь не думать ни об этом, ни о чём-то слишком серьёзном."

# ch/hanna/talk.rpy:85
translate russian hanna_talk_politics_male_87a56a12:
    hanna.say "Мы всего лишь животные, [lssb_hanna.hero_name()]. Всё сводится к выживанию."

# ch/hanna/talk.rpy:92
translate russian hanna_talk_food_male_7bf81767:
    hanna.say "Ладно, [lssb_hanna.hero_name()], вот настоящая проверка. Как ты питаешься?"

# ch/hanna/talk.rpy:95
translate russian hanna_talk_food_male_94f1e8c6:
    mike.say "Да особо не заморачиваюсь. Ем что хочется, а мышцы поддерживаю тренировками."

# ch/hanna/talk.rpy:96
translate russian hanna_talk_food_male_6908aec1:
    hanna.say "Ну уж нет! На одних тренировках отличную фигуру не удержишь!"

# ch/hanna/talk.rpy:97
translate russian hanna_talk_food_male_57dcadc3:
    hanna.say "Нужно понимать, что вкладываешь в своё тело, прежде чем требовать от него отдачи!"

# ch/hanna/talk.rpy:100
translate russian hanna_talk_food_male_fcf15fa3:
    mike.say "Давай мне самую вредную еду, какую найдёшь. Фастфуд, пиццу, бургеры — что угодно!"

# ch/hanna/talk.rpy:101
translate russian hanna_talk_food_male_71f916ad:
    hanna.say "Ха-ха, тут я тебя понимаю."

# ch/hanna/talk.rpy:102
translate russian hanna_talk_food_male_c1ffec90:
    hanna.say "Но если поведёшь меня куда-нибудь объедаться, после этого тебе ПРИДЁТСЯ тренироваться ЧАСАМИ."

# ch/hanna/talk.rpy:103
translate russian hanna_talk_food_male_d0e2d8f2:
    hanna.say "Отличный повод провести в зале побольше времени!"

# ch/hanna/talk.rpy:106
translate russian hanna_talk_food_male_39043368:
    mike.say "Я больше по морепродуктам и салатам."

# ch/hanna/talk.rpy:108
translate russian hanna_talk_food_male_39379784:
    hanna.say "Что? ПОСТОЯННО?"

# ch/hanna/talk.rpy:110
translate russian hanna_talk_food_male_fc0503b3:
    hanna.say "Да ладно, как ты собираешься тренироваться на четырёхстах калориях в день?"

# ch/hanna/talk.rpy:112
translate russian hanna_talk_food_male_13a9f1be:
    hanna.say "Еда — это здорово! Просто сначала её нужно заслужить."

# ch/hanna/talk.rpy:115
translate russian hanna_talk_food_male_984b2c30:
    mike.say "Вообще-то я веган."

# ch/hanna/talk.rpy:117
translate russian hanna_talk_food_male_a62189e9:
    hanna.say "Чего?.."

# ch/hanna/talk.rpy:124
translate russian hanna_talk_travels_male_e3a73be8:
    hanna.say "А ты хотел бы куда-нибудь съездить?"

# ch/hanna/talk.rpy:127
translate russian hanna_talk_travels_male_9629a463:
    mike.say "Раз уж ты спросила, было бы здорово подготовиться к пешему походу."

# ch/hanna/talk.rpy:128
translate russian hanna_talk_travels_male_3b9f4245:
    mike.say "Ночевать в палатке, быть на природе, показать, как хорошо моё тело справляется с нагрузками."

# ch/hanna/talk.rpy:130
translate russian hanna_talk_travels_male_aab0819c:
    hanna.say "Хм... да, как-нибудь можно было бы попробовать!"

# ch/hanna/talk.rpy:133
translate russian hanna_talk_travels_male_4e68d74b:
    mike.say "Вообще я просто хочу посмотреть мир. Познакомиться с другой культурой, понимаешь?"

# ch/hanna/talk.rpy:134
translate russian hanna_talk_travels_male_b094f99d:
    mike.say "Например, съездить в Италию и вблизи посмотреть на мраморные статуи."

# ch/hanna/talk.rpy:135
translate russian hanna_talk_travels_male_c22303f7:
    hanna.say "Хм... Не знаю. Может, они и вдохновляют совершенствовать тело, но, думаю, сами бы мне позавидовали."

# ch/hanna/talk.rpy:138
translate russian hanna_talk_travels_male_a6bdd7c1:
    mike.say "Есть один огромный парк развлечений, куда я с детства мечтал попасть. Аттракционы и жареные сладости? Я за!"

# ch/hanna/talk.rpy:140
translate russian hanna_talk_travels_male_2c82aaea:
    hanna.say "Эх, на аттракционах слишком много сидишь."

# ch/hanna/talk.rpy:141
translate russian hanna_talk_travels_male_9976ce7e:
    hanna.say "Какой азарт в сидении? Лучшее средство передвижения — моё тело!"

# ch/hanna/talk.rpy:144
translate russian hanna_talk_travels_male_73be1319:
    mike.say "Нет. Мне нравится здесь. В моём маленьком мире и так хорошо."

# ch/hanna/talk.rpy:145
translate russian hanna_talk_travels_male_aec7fe5a:
    hanna.say "Хм... Не знаю. Мне бы хотелось как-нибудь испытать свои силы."

# ch/hanna/talk.rpy:146
translate russian hanna_talk_travels_male_6538a3ab:
    hanna.say "ПО-НАСТОЯЩЕМУ пропотеть летом где-нибудь в приятном влажном климате..."

# ch/hanna/talk.rpy:153
translate russian hanna_talk_tv_male_579ed1c0:
    hanna.say "Забавно. В последнее время я почти ничего не смотрела."

# ch/hanna/talk.rpy:154
translate russian hanna_talk_tv_male_765948f9:
    hanna.say "Не то чтобы мне неинтересно, но я почти всё время здесь и вхожу в рабочий ритм, понимаешь? А ты?"

# ch/hanna/talk.rpy:157
translate russian hanna_talk_tv_male_0617041b:
    mike.say "Хм, да, понимаю. Я тоже так занят, что почти ничего не смотрю."

# ch/hanna/talk.rpy:159
translate russian hanna_talk_tv_male_847167b1:
    hanna.say "Ха-ха, да. Ведь развлечься можно по-разному, правда?"

# ch/hanna/talk.rpy:162
translate russian hanna_talk_tv_male_6dc2b8ff:
    mike.say "Не могу жить без своих сериалов. Успеет ли Альфонсо сделать предложение Лизе до её тайной свадьбы с его братом-близнецом? Я должен узнать!"

# ch/hanna/talk.rpy:164
translate russian hanna_talk_tv_male_31c38697:
    hanna.say "Из всего мыла меня интересует только гель для душа. И то лишь затем, чтобы смыть пот и снова как следует вспотеть."

# ch/hanna/talk.rpy:167
translate russian hanna_talk_tv_male_ddf10751:
    mike.say "Я скорее люблю смотреть запоем, чем по расписанию. Заглядывай как-нибудь ко мне, расслабимся."

# ch/hanna/talk.rpy:169
translate russian hanna_talk_tv_male_5f6bcfef:
    hanna.say "Расслабимся? Прости, [lssb_hanna.hero_name()], я люблю погорячее и повлажнее!"

# ch/hanna/talk.rpy:171
translate russian hanna_talk_tv_male_d803597f:
    mike.say "Очень жду сегодняшний новый кроссовер."

# ch/hanna/talk.rpy:172
translate russian hanna_talk_tv_male_02f2b87c:
    mike.say "В этих супергеройских сериалах умеют передавать дух комиксов!"

# ch/hanna/talk.rpy:174
translate russian hanna_talk_tv_male_50471f27:
    hanna.say "А, фантазии о силе для тех, кто не хочет трудиться над собственной физической формой."

# ch/hanna/talk.rpy:180
translate russian hanna_talk_sports_male_28d0afb2:
    hanna.say "Ты тренируешься для какого-нибудь вида спорта? Или просто любишь смотреть?"

# ch/hanna/talk.rpy:183
translate russian hanna_talk_sports_male_6123d202:
    mike.say "Нет, я скорее просто поддерживаю себя в форме."

# ch/hanna/talk.rpy:184
translate russian hanna_talk_sports_male_d04efa48:
    hanna.say "Ну да, в этом нет ничего плохого."

# ch/hanna/talk.rpy:186
translate russian hanna_talk_sports_male_c0b1ec54:
    mike.say "Мне очень нравится смотреть киберспорт и скоростные прохождения игр."

# ch/hanna/talk.rpy:188
translate russian hanna_talk_sports_male_0c7d5ece:
    hanna.say "Ой, да ладно! От дрочки и то больше нагрузки, чем от щёлканья мышкой!"

# ch/hanna/talk.rpy:191
translate russian hanna_talk_sports_male_bec25ffd:
    mike.say "Вообще-то я подумываю поучаствовать в одном из ближайших забегов."

# ch/hanna/talk.rpy:193
translate russian hanna_talk_sports_male_82a2614d:
    hanna.say "Да? Звучит здорово!"

# ch/hanna/talk.rpy:196
translate russian hanna_talk_sports_male_d8aefb58:
    mike.say "Честно говоря, я поддерживаю форму лишь затем, чтобы дольше продержаться в постели."

# ch/hanna/talk.rpy:198
translate russian hanna_talk_sports_male_afe77b35:
    hanna.say "Т... ты хочешь... повысить выносливость... ради... ради секса?"

# ch/hanna/talk.rpy:199
translate russian hanna_talk_sports_male_01c007eb:
    mike.say "Что-то не так?"

# ch/hanna/talk.rpy:200
translate russian hanna_talk_sports_male_69bfbdca:
    hanna.say "Н... нет, но это ведь не совсем спорт, хоть цель и достойная!"

# ch/hanna/talk.rpy:207
translate russian hanna_talk_fashion_male_4f7aa0d0:
    hanna.say "Честно говоря, я не задумывалась, что надевать на свидания и всё такое."

# ch/hanna/talk.rpy:208
translate russian hanna_talk_fashion_male_adf891e5:
    hanna.say "Как думаешь, что бы мне пошло?"

# ch/hanna/talk.rpy:211
translate russian hanna_talk_fashion_male_095f92b1:
    mike.say "Может, попробуешь что-нибудь милое? Тебе бы подошло."

# ch/hanna/talk.rpy:213
translate russian hanna_talk_fashion_male_d018c412:
    hanna.say "Милое? Такой девушке, как я? Никогда об этом не думала..."

# ch/hanna/talk.rpy:216
translate russian hanna_talk_fashion_male_d70f5c19:
    mike.say "Почему бы не показать себя? Оденься как настоящая шлюшка и продемонстрируй своё тело."

# ch/hanna/talk.rpy:218
translate russian hanna_talk_fashion_male_b76ea560:
    hanna.say "Хе-хе, а знаешь что? Точно! Пусть любуются моими бицепсами и кубиками!"

# ch/hanna/talk.rpy:221
translate russian hanna_talk_fashion_male_2562507b:
    mike.say "Что бы ты ни надела, главное — хорошенько в этом вспотеть."

# ch/hanna/talk.rpy:223
translate russian hanna_talk_fashion_male_b7002564:
    hanna.say "Хочешь, чтобы я пришла после тренировки, не принимая душ? А... а ты мог бы так же?"

# ch/hanna/talk.rpy:226
translate russian hanna_talk_fashion_male_ca62a1dc:
    mike.say "А совсем ничего не надевать не думала?"

# ch/hanna/talk.rpy:228
translate russian hanna_talk_fashion_male_a2118c7d:
    hanna.say "Ну хватит! Если собираешься куда-то меня пригласить, говори серьёзно."

# ch/hanna/talk.rpy:235
translate russian hanna_talk_books_male_3b8d8ed2:
    hanna.say "Знаешь, к книгам я довольно равнодушна. У тебя есть что-то на примете?"

# ch/hanna/talk.rpy:238
translate russian hanna_talk_books_male_066741b7:
    mike.say "Ну, если у тебя много свободного времени, сейчас очень популярна одна фэнтезийная эпопея."

# ch/hanna/talk.rpy:239
translate russian hanna_talk_books_male_68e9093b:
    mike.say "От первой до двенадцатой книги там сто тысяч стра..."

# ch/hanna/talk.rpy:241
translate russian hanna_talk_books_male_4595b7ee:
    hanna.say "Уф, нет уж, спасибо! Я столько не усидела бы на месте. И одновременно читать и бежать на дорожке нельзя."

# ch/hanna/talk.rpy:242
translate russian hanna_talk_books_male_affe2bcf:
    hanna.say "Это опасно."

# ch/hanna/talk.rpy:245
translate russian hanna_talk_books_male_f25e9e8c:
    mike.say "А о книгах по фитнесу не думала?"

# ch/hanna/talk.rpy:246
translate russian hanna_talk_books_male_b2e8c793:
    hanna.say "Наверное, было бы неплохо. Не то чтобы я уже не знала всё, что можно."

# ch/hanna/talk.rpy:249
translate russian hanna_talk_books_male_87868a11:
    mike.say "Может, попробуешь любовные романы?"

# ch/hanna/talk.rpy:250
translate russian hanna_talk_books_male_0dbd7631:
    hanna.say "Не совсем моё."

# ch/hanna/talk.rpy:251
translate russian hanna_talk_books_male_392c252b:
    hanna.say "Я не из тех девушек, которых заводят парни с расстёгнутыми рубашками, уносящие их на руках."

# ch/hanna/talk.rpy:252
translate russian hanna_talk_books_male_f1479496:
    hanna.say "У меня более... специфические вкусы."

# ch/hanna/talk.rpy:255
translate russian hanna_talk_books_male_f8b540f9:
    mike.say "Комиксы — беспроигрышный вариант. Есть одна серия про бегуна, который..."

# ch/hanna/talk.rpy:256
translate russian hanna_talk_books_male_1354db8a:
    hanna.say "Комиксы, точно! Можно смотреть картинки и не тратить время на чтение!"

# ch/hanna/talk.rpy:257
translate russian hanna_talk_books_male_71a69da7:
    mike.say "Они не совсем так работают, ты... ладно, забудь."

# ch/hanna/talk.rpy:264
translate russian hanna_talk_people_male_b98f106c:
    hanna.say "Ну и каково это — быть общительным человеком?"

# ch/hanna/talk.rpy:267
translate russian hanna_talk_people_male_6ca75a95:
    mike.say "Если бы я не любил знакомиться с новыми людьми, я бы не заговорил с тобой, правда?"

# ch/hanna/talk.rpy:268
translate russian hanna_talk_people_male_ff529368:
    mike.say "Знакомиться здорово. Друзья, любовницы — кто попадётся."

# ch/hanna/talk.rpy:269
translate russian hanna_talk_people_male_0d64c561:
    hanna.say "Хм... Да что ты?.. Правда, мне не хочется отнимать время у тренировок..."

# ch/hanna/talk.rpy:272
translate russian hanna_talk_people_male_b6a2e497:
    mike.say "Без понятия. В целом я ненавижу людей. Мне небезразличны лишь немногие."

# ch/hanna/talk.rpy:273
translate russian hanna_talk_people_male_aed0f15c:
    hanna.say "Да что ты? Интересно."

# ch/hanna/talk.rpy:275
translate russian hanna_talk_people_male_2e420496:
    mike.say "Зависит от того, с кем общаюсь. С кем-то хочется, с кем-то нет."

# ch/hanna/talk.rpy:276
translate russian hanna_talk_people_male_72d1c42a:
    mike.say "Я ищу самых интересных людей."

# ch/hanna/talk.rpy:278
translate russian hanna_talk_people_male_96299bd1:
    hanna.say "Тогда, наверное, стоит поблагодарить тебя за то, что считаешь меня интересной!"

# ch/hanna/talk.rpy:281
translate russian hanna_talk_people_male_3d87a97d:
    mike.say "Мне интереснее, почему ты сама не считаешь себя общительной."

# ch/hanna/talk.rpy:283
translate russian hanna_talk_people_male_9fde2bc9:
    hanna.say "А, заинтересовался мной? Ну, я люблю тела, физическую силу, ту первобытную мощь, на которую способны люди!"

# ch/hanna/talk.rpy:286
translate russian hanna_talk_people_male_d0385822:
    mike.say "Да ладно, ты наверняка замечаешь других женщин в зале. Некоторые в отличной форме."

# ch/hanna/talk.rpy:288
translate russian hanna_talk_people_male_461753e7:
    hanna.say "Ха! Поймал. Да, когда видно, что девушка как следует потрудилась, я не могу не посмотреть."

# ch/hanna/talk.rpy:289
translate russian hanna_talk_people_male_6985a831:
    hanna.say "Нет ничего плохого в том, чтобы любоваться телом, над которым усердно работали, верно? Иногда замечаю, что засмотрелась..."

# ch/hanna/talk.rpy:292
translate russian hanna_talk_people_male_42eae15b:
    mike.say "Ты всё любуешься... А кто-нибудь из этих девушек в зале по-настоящему вскружил тебе голову?"

# ch/hanna/talk.rpy:294
translate russian hanna_talk_people_male_0b3b34d4:
    hanna.say "Пф-ф, ещё чего. Смотреть мне нравится, [lssb_hanna.hero_name()], но на этом всё."

# ch/hanna/talk.rpy:295
translate russian hanna_talk_people_male_9ad626ee:
    hanna.say "Хочу, чтобы меня подстраховывал только ты. Смотри на меня, и всё будет хорошо."

# ch/hanna/talk.rpy:302
translate russian hanna_talk_computers_male_dfca9908:
    hanna.say "Уф, ненавижу возиться с компьютером на работе."

# ch/hanna/talk.rpy:304
translate russian hanna_talk_computers_male_c3c84d63:
    hanna.say "Хоть теперь, когда зал продан, сбои системы записи — не моя проблема."

# ch/hanna/talk.rpy:305
translate russian hanna_talk_computers_male_b2727885:
    hanna.say "Всё так запутанно. Тут нажми, там напечатай."

# ch/hanna/talk.rpy:306
translate russian hanna_talk_computers_male_4f8e5de4:
    hanna.say "Почему бы просто... не запоминать всё это? Отличная тренировка для мозга."

# ch/hanna/talk.rpy:309
translate russian hanna_talk_computers_male_4dd92a71:
    mike.say "Могу как-нибудь тебя научить. Я неплохо разбираюсь в компьютерах."

# ch/hanna/talk.rpy:311
translate russian hanna_talk_computers_male_36768ba8:
    hanna.say "Эх, не знаю. Ты правда хочешь провести со мной время именно так? Правда?"

# ch/hanna/talk.rpy:314
translate russian hanna_talk_computers_male_f88910c9:
    mike.say "Да, компьютеры очень мешают настоящему, физическому общению."

# ch/hanna/talk.rpy:315
translate russian hanna_talk_computers_male_06a162c4:
    hanna.say "Вот именно. Любое общение должно быть физическим. Без исключений."

# ch/hanna/talk.rpy:317
translate russian hanna_talk_computers_male_34e5a041:
    mike.say "Да ладно, не можешь же ты НАСТОЛЬКО плохо разбираться в компьютерах."

# ch/hanna/talk.rpy:319
translate russian hanna_talk_computers_male_87a66c84:
    hanna.say "Что, называешь меня лгуньей?!"

# ch/hanna/talk.rpy:326
translate russian hanna_talk_music_male_9a9ee16d:
    hanna.say "А ты что делаешь во время тренировок? Слушаешь песни или что-то такое?"

# ch/hanna/talk.rpy:329
translate russian hanna_talk_music_male_c1956c8b:
    mike.say "Поверишь, если скажу, что обычно нет? Музыка сбивает меня с настроя."

# ch/hanna/talk.rpy:331
translate russian hanna_talk_music_male_1036da2e:
    hanna.say "Понятно. Интересно, смогла бы я выдерживать столько же, если бы ничем себя не отвлекала. Обычно меня отвлекают не звуки..."

# ch/hanna/talk.rpy:334
translate russian hanna_talk_music_male_eeba36cc:
    mike.say "Мне обязательно нужно врубить музыку из старых спортивных фильмов про путь неудачника к победе."

# ch/hanna/talk.rpy:335
translate russian hanna_talk_music_male_733fc57e:
    mike.say "Знаешь, такую, что играла в семидесятых и восьмидесятых?"

# ch/hanna/talk.rpy:336
translate russian hanna_talk_music_male_758c132e:
    hanna.say "Ого, сколько же тебе лет?"

# ch/hanna/talk.rpy:339
translate russian hanna_talk_music_male_267be91e:
    mike.say "Энергичные песни из заставок аниме всегда задают нужный настрой."

# ch/hanna/talk.rpy:340
translate russian hanna_talk_music_male_88cd592c:
    hanna.say "А что такое аниме?.."

# ch/hanna/talk.rpy:343
translate russian hanna_talk_music_male_28cd7e22:
    mike.say "Только рок и метал. Пробуждают первобытные чувства."

# ch/hanna/talk.rpy:344
translate russian hanna_talk_music_male_65bb4dbe:
    hanna.say "Хм... О теле нужно заботиться, [lssb_hanna.hero_name()]. И об ушах тоже."

# ch/hanna/talk.rpy:350
translate russian hanna_talk_birthday_male_1d947883:
    mike.say "С днём рождения, Ханна."

# ch/hanna/talk.rpy:352
translate russian hanna_talk_birthday_male_7667f626:
    hanna.say "Спасибо, [lssb_hanna.hero_name()]."

# ch/hanna/talk.rpy:380
translate russian submissive_interact_hanna_male_6ca7511e:
    mike.say "Эм, Ханна..."

# ch/hanna/talk.rpy:382
translate russian submissive_interact_hanna_male_219f1caf:
    hanna.say "Да, [lssb_hanna.hero_name()]?"

# ch/hanna/talk.rpy:384
translate russian submissive_interact_hanna_male_1124b97b:
    mike.say "Знаешь, когда ты со мной здороваешься..."

# ch/hanna/talk.rpy:385
translate russian submissive_interact_hanna_male_ebac0add:
    mike.say "Я подумал: может, ты могла бы говорить что-нибудь другое?"

# ch/hanna/talk.rpy:387
translate russian submissive_interact_hanna_male_2f01d49d:
    hanna.say "Например что?"

# ch/hanna/talk.rpy:389
translate russian submissive_interact_hanna_male_da8b255d:
    mike.say "Что-нибудь о том, как ты любишь красоваться."

# ch/hanna/talk.rpy:390
translate russian submissive_interact_hanna_male_418f6856:
    mike.say "Может, что хочешь, чтобы я показывал тебя всем?"

# ch/hanna/talk.rpy:393
translate russian submissive_interact_hanna_male_dca0f296:
    hanna.say "Мне... мне правда нравится, когда на меня смотрят."

# ch/hanna/talk.rpy:394
translate russian submissive_interact_hanna_male_c62fdd80:
    hanna.say "Звучит неплохо."

# ch/hanna/talk.rpy:396
translate russian submissive_interact_hanna_male_023ed77a:
    hanna.say "Хорошо, буду!"

# ch/hanna/talk.rpy:400
translate russian submissive_interact_hanna_male_d6c90630:
    hanna.say "Я люблю хорошо выглядеть, [lssb_hanna.hero_name()]."

# ch/hanna/talk.rpy:401
translate russian submissive_interact_hanna_male_af72c73e:
    hanna.say "Но я не собака, которой можно хвастаться!"

# ch/hanna/talk.rpy:403
translate russian submissive_interact_hanna_male_c9425a31:
    mike.say "Конечно нет, Ханна!"

# ch/hanna/talk.rpy:404
translate russian submissive_interact_hanna_male_3d788e00:
    mike.say "Просто забудь об этом, ладно?"

# ch/hanna/texts.rpy:7
translate russian hanna_friendly_texts_09884052:
    hanna_nvl "Сегодня никак не могу сосредоточиться на тренировке."

# ch/hanna/texts.rpy:8
translate russian hanna_friendly_texts_cda02568:
    hanna_nvl "Каждый раз, когда думаю о тебе, отвлекаюсь!"

# ch/hanna/texts.rpy:9
translate russian hanna_friendly_texts_7f22833e:
    hanna_nvl "И это ещё когда тебя нет рядом!"

# ch/hanna/texts.rpy:11
translate russian hanna_friendly_texts_cc799c73:
    hanna_nvl "У меня сейчас немного свободного времени между занятиями."

# ch/hanna/texts.rpy:12
translate russian hanna_friendly_texts_59206863:
    hanna_nvl "Подумала, может, хочешь поболтать?"

# ch/hanna/texts.rpy:13
translate russian hanna_friendly_texts_4dd297c9:
    hanna_nvl "Если не занят и нет ничего поинтереснее..."

# ch/hanna/texts.rpy:15
translate russian hanna_friendly_texts_43ebb711:
    hanna_nvl "Ты здорово придумал с нашим недавним свиданием."

# ch/hanna/texts.rpy:16
translate russian hanna_friendly_texts_eec058dc:
