# ch/harmony/texts.rpy:47
translate russian harmony_dirty_texts_831c5891:
    harmony_nvl "Теперь я хочу каждый вечер стоять на коленях и сосать твой член, [lssb_harmony.hero_name()]!"

# ch/harmony/texts.rpy:49
translate russian harmony_dirty_texts_00b42590:
