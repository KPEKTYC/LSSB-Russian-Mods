translate russian harmony_birthday_date_pure_male_354de380:
    "Хотя она всё равно пытается улыбнуться."

# ch/harmony/events.rpy:6024
translate russian harmony_birthday_date_pure_male_8a7fe316:
    harmony.say "Раз ты так говоришь, [lssb_harmony.hero_name()]."

# ch/harmony/events.rpy:6025
translate russian harmony_birthday_date_pure_male_56f2054a:
    harmony.say "Я всё равно не особенно голодна."

# ch/harmony/events.rpy:6026
translate russian harmony_birthday_date_pure_male_2d33cdae:
    harmony.say "Наверное, возьму что-нибудь лёгкое."

# ch/harmony/events.rpy:6027
translate russian harmony_birthday_date_pure_male_e6b7cee7:
    harmony.say "Салат, например."

# ch/harmony/events.rpy:6029
translate russian harmony_birthday_date_pure_male_c912f095:
    "Я качаю головой, не понимая её тревог."

# ch/harmony/events.rpy:6030
translate russian harmony_birthday_date_pure_male_cad321e9:
    mike.say "Как скажешь, Хармони."

# ch/harmony/events.rpy:6031
translate russian harmony_birthday_date_pure_male_63ba4401:
    mike.say "Если аппетит вернётся, просто дай знать."

# ch/harmony/events.rpy:6037
translate russian harmony_birthday_date_pure_male_db7b2fb0:
    "Пока официант ищет моё имя в списке, я нервничаю."

# ch/harmony/events.rpy:6038
translate russian harmony_birthday_date_pure_male_30e965eb:
    "Почти задерживаю дыхание, ожидая услышать, что меня там нет."

# ch/harmony/events.rpy:6039
translate russian harmony_birthday_date_pure_male_cc1337da:
    "Но он поднимает голову и одаривает меня отработанной улыбкой."

# ch/harmony/events.rpy:6040
translate russian harmony_birthday_date_pure_male_321642cb:
    "Официант" "Вот, нашёл, сэр..."

# ch/harmony/events.rpy:6041
translate russian harmony_birthday_date_pure_male_18174c93:
    "Официант" "Прошу за мной."

# ch/harmony/events.rpy:6045
translate russian harmony_birthday_date_pure_male_71e388ca:
    "Мы с Хармони послушно следуем за ним."

# ch/harmony/events.rpy:6046
translate russian harmony_birthday_date_pure_male_93662330:
    "Официант ведёт нас через ресторан прямо к нашему столику."

# ch/harmony/events.rpy:6047
translate russian harmony_birthday_date_pure_male_c0e86a0d:
    "Затем жестом предлагает сесть."

# ch/harmony/events.rpy:6050
translate russian harmony_birthday_date_pure_male_adf85955:
    "Я сразу указываю на ближайший стул."

# ch/harmony/events.rpy:6051
translate russian harmony_birthday_date_pure_male_75b6727a:
    mike.say "Позволь помочь тебе, Хармони..."

# ch/harmony/events.rpy:6052
translate russian harmony_birthday_date_pure_male_055224bc:
    "Да, я сейчас довольно голоден."

# ch/harmony/events.rpy:6053
translate russian harmony_birthday_date_pure_male_1c04eef7:
    "Наверное, из-за нервов после всей этой организации."

# ch/harmony/events.rpy:6054
translate russian harmony_birthday_date_pure_male_b2a421c5:
    "Но это не повод забывать о манерах."

# ch/harmony/events.rpy:6055
translate russian harmony_birthday_date_pure_male_b03313d4:
    "По реакции Хармони я понимаю, что поступил правильно."

# ch/harmony/events.rpy:6058
translate russian harmony_birthday_date_pure_male_904c8711:
    "Она буквально сияет, когда я помогаю ей сесть."

# ch/harmony/events.rpy:6059
translate russian harmony_birthday_date_pure_male_1b66b75f:
    "Улыбается мне снизу вверх, довольная как кошка, добравшаяся до сливок."

# ch/harmony/events.rpy:6060
translate russian harmony_birthday_date_pure_male_a805c8e3:
    "Поворачиваясь к своему стулу, я замечаю выражение лица официанта."

# ch/harmony/events.rpy:6061
translate russian harmony_birthday_date_pure_male_e745da35:
    "Сначала не понимаю, почему он вдруг так разозлился."

# ch/harmony/events.rpy:6062
translate russian harmony_birthday_date_pure_male_40e14151:
    "Потом до меня доходит: наверное, он привык, что мужчины этого не делают."

# ch/harmony/events.rpy:6063
translate russian harmony_birthday_date_pure_male_2e267670:
    "Спорим, он уже приготовился выскочить и помочь Хармони сам!"

# ch/harmony/events.rpy:6064
translate russian harmony_birthday_date_pure_male_ead9a29a:
    "От этого меня переполняет самодовольство."

# ch/harmony/events.rpy:6065
translate russian harmony_birthday_date_pure_male_e58e4d01:
    "Не только потому, что я не забыл о хорошем тоне."

# ch/harmony/events.rpy:6066
translate russian harmony_birthday_date_pure_male_48d01b33:
    "Но и потому, что лишил официанта возможности побыть приторным прилипалой!"

# ch/harmony/events.rpy:6068
translate russian harmony_birthday_date_pure_male_ba439949:
    "Я сразу сажусь на ближайший стул."

# ch/harmony/events.rpy:6069
translate russian harmony_birthday_date_pure_male_f5fa3915:
    "Голод нарастает с каждой минутой, наверное, от нервов."

# ch/harmony/events.rpy:6070
translate russian harmony_birthday_date_pure_male_6cb041a1:
    "И не хочу, чтобы что-то вставало между мной и меню!"

# ch/harmony/events.rpy:6073
translate russian harmony_birthday_date_pure_male_d0f537d5:
    "Лишь подняв голову, я замечаю, что Хармони смотрит на меня."

# ch/harmony/events.rpy:6074
translate russian harmony_birthday_date_pure_male_315661f7:
    "И официант тоже."

# ch/harmony/events.rpy:6075
translate russian harmony_birthday_date_pure_male_6e2c44e4:
    "Что с ними?"

# ch/harmony/events.rpy:6076
translate russian harmony_birthday_date_pure_male_4dbe88f6:
    "У меня что-то в зубах застряло?"

# ch/harmony/events.rpy:6077
translate russian harmony_birthday_date_pure_male_b41ff56d:
    "Официант" "Позвольте, мадам..."

# ch/harmony/events.rpy:6078
translate russian harmony_birthday_date_pure_male_decb204e:
    "Официант" "Вам помочь?"

# ch/harmony/events.rpy:6080
translate russian harmony_birthday_date_pure_male_fc362cfa:
    harmony.say "О!"

# ch/harmony/events.rpy:6081
translate russian harmony_birthday_date_pure_male_506fdb16:
    harmony.say "Да, это было бы очень любезно."

# ch/harmony/events.rpy:6083
translate russian harmony_birthday_date_pure_male_54a0fda7:
    "Официант кивает и помогает Хармони сесть."

# ch/harmony/events.rpy:6084
translate russian harmony_birthday_date_pure_male_8ce87cbb:
    "Усаживаясь, она одаривает меня убийственным взглядом."

# ch/harmony/events.rpy:6085
translate russian harmony_birthday_date_pure_male_5b2d537b:
    "Я смотрю на официанта и получаю в ответ самодовольную усмешку."

# ch/harmony/events.rpy:6086
translate russian harmony_birthday_date_pure_male_58ed2472:
    "Только тогда понимаю: мне следовало сделать это самому."

# ch/harmony/events.rpy:6087
translate russian harmony_birthday_date_pure_male_380dcc79:
    "По крайней мере, так поступил бы джентльмен."

# ch/harmony/events.rpy:6088
translate russian harmony_birthday_date_pure_male_7ec8d80f:
    "Похоже, пора освежить знания этикета!"

# ch/harmony/events.rpy:6091
translate russian harmony_birthday_date_pure_male_19eed81e:
    "Как только мы усаживаемся, официант вручает каждому меню."

# ch/harmony/events.rpy:6093
translate russian harmony_birthday_date_pure_male_b008df22:
    "Я сразу начинаю изучать блюда."

# ch/harmony/events.rpy:6094
translate russian harmony_birthday_date_pure_male_25d00ff7:
    "Стоит увидеть что-то подходящее, как выбор сделан."

# ch/harmony/events.rpy:6095
translate russian harmony_birthday_date_pure_male_260038db:
    "Я уже собираюсь объявить свой заказ."

# ch/harmony/events.rpy:6096
translate russian harmony_birthday_date_pure_male_b03deead:
    "Но поднимаю глаза и вижу, что Хармони всё ещё изучает меню."

# ch/harmony/events.rpy:6097
translate russian harmony_birthday_date_pure_male_dd3da950:
    mike.say "Всё хорошо, Хармони?"

# ch/harmony/events.rpy:6099
translate russian harmony_birthday_date_pure_male_d33b0494:
    "Услышав мой голос, она поднимает голову."

# ch/harmony/events.rpy:6100
translate russian harmony_birthday_date_pure_male_e51ffb70:
    harmony.say "Ох..."

# ch/harmony/events.rpy:6101
translate russian harmony_birthday_date_pure_male_46c3f259:
    harmony.say "Я немного запуталась..."

# ch/harmony/events.rpy:6102
translate russian harmony_birthday_date_pure_male_ab9aa3d8:
    harmony.say "Все эти блюда выглядят такими сложными."

# ch/harmony/events.rpy:6103
translate russian harmony_birthday_date_pure_male_3303315a:
    harmony.say "Кажется, я вообще не понимаю, что здесь подают!"

# ch/harmony/events.rpy:6104
translate russian harmony_birthday_date_pure_male_f8ec8f44:
    harmony.say "А мне хотелось заказать что-нибудь... ну, лёгкое."

# ch/harmony/events.rpy:6105
translate russian harmony_birthday_date_pure_male_b8ad1acc:
    harmony.say "Понимаешь?"

# ch/harmony/events.rpy:6106
translate russian harmony_birthday_date_pure_male_79485eb5:
    "Я киваю и ещё раз смотрю в меню."

# ch/harmony/events.rpy:6107
translate russian harmony_birthday_date_pure_male_94e806f5:
    "Уверен, что смогу помочь Хармони."

# ch/harmony/events.rpy:6108
translate russian harmony_birthday_date_pure_male_30796e6f:
    "Обычно я неплохо разбираюсь в таких вещах."

# ch/harmony/events.rpy:6109
translate russian harmony_birthday_date_pure_male_33c3791f:
    "И здесь быстро всё понимаю."

# ch/harmony/events.rpy:6110
translate russian harmony_birthday_date_pure_male_fdd23126:
    mike.say "Не волнуйся, Хармони..."

# ch/harmony/events.rpy:6111
translate russian harmony_birthday_date_pure_male_a45f9b3d:
    mike.say "Меню словно нарочно написали как можно сложнее."

# ch/harmony/events.rpy:6112
translate russian harmony_birthday_date_pure_male_2cd6a094:
    mike.say "Но его составители не такие умники, какими себя считают."

# ch/harmony/events.rpy:6113
translate russian harmony_birthday_date_pure_male_99e40361:
    mike.say "Стоит это понять — и всё становится просто."

# ch/harmony/events.rpy:6114
translate russian harmony_birthday_date_pure_male_92810ee4:
    "Я объясняю Хармони, что это за блюда."

# ch/harmony/events.rpy:6115
translate russian harmony_birthday_date_pure_male_aabf7485:
    "Даже указываю на менее калорийные."

# ch/harmony/events.rpy:6116
translate russian harmony_birthday_date_pure_male_37e0cec2:
    "Тут у меня появляется ощущение, что за нами наблюдают."

# ch/harmony/events.rpy:6117
translate russian harmony_birthday_date_pure_male_73d54964:
    "Официант" "Кхм..."

# ch/harmony/events.rpy:6119
translate russian harmony_birthday_date_pure_male_fe0c63b0:
    "Мы одновременно оборачиваемся и видим наклонившегося к нам официанта."

# ch/harmony/events.rpy:6120
translate russian harmony_birthday_date_pure_male_6f9c1687:
    "Официант" "Если возникли затруднения..."

# ch/harmony/events.rpy:6121
translate russian harmony_birthday_date_pure_male_5012200c:
    "Официант" "Возможно, я мог бы помочь?"

# ch/harmony/events.rpy:6122
translate russian harmony_birthday_date_pure_male_e4ea2fea:
    mike.say "Не нужно, мы разобрались."

# ch/harmony/events.rpy:6123
translate russian harmony_birthday_date_pure_male_2e349520:
    "В ответ официант пренебрежительно фыркает."

# ch/harmony/events.rpy:6124
translate russian harmony_birthday_date_pure_male_89eaa253:
    "Кажется, он злится, что не смог вмешаться и помочь."

# ch/harmony/events.rpy:6126
translate russian harmony_birthday_date_pure_male_eac90ab9:
    "Наверное, ему нравится снисходительно объяснять всё менее осведомлённым посетителям."

# ch/harmony/events.rpy:6128
translate russian harmony_birthday_date_pure_male_19fefeb4:
    "Но сейчас не тот случай: мы с Хармони уверенно делаем заказ."

# ch/harmony/events.rpy:6130
translate russian harmony_birthday_date_pure_male_d33b0494_1:
    "Услышав мой голос, она поднимает голову."

# ch/harmony/events.rpy:6131
translate russian harmony_birthday_date_pure_male_e51ffb70_1:
    harmony.say "Ох..."

# ch/harmony/events.rpy:6132
translate russian harmony_birthday_date_pure_male_2e011533:
    harmony.say "Я просто задумалась..."

# ch/harmony/events.rpy:6133
translate russian harmony_birthday_date_pure_male_7e909201:
    harmony.say "Почему столько названий в меню на французском?"

# ch/harmony/events.rpy:6134
translate russian harmony_birthday_date_pure_male_e16a7035:
    harmony.say "Я ведь его не понимаю!"

# ch/harmony/events.rpy:6136
translate russian harmony_birthday_date_pure_male_2533f0bd:
    "Я улыбаюсь и качаю головой."

# ch/harmony/events.rpy:6137
translate russian harmony_birthday_date_pure_male_67224a4f:
    mike.say "Не волнуйся, Хармони."

# ch/harmony/events.rpy:6138
translate russian harmony_birthday_date_pure_male_f06608b9:
    mike.say "Французы просто любят покрасоваться."

# ch/harmony/events.rpy:6139
translate russian harmony_birthday_date_pure_male_8dc79a12:
    mike.say "Я довольно хорошо знаю язык."

# ch/harmony/events.rpy:6140
translate russian harmony_birthday_date_pure_male_e3de74c9:
    mike.say "Дай посмотрю..."

# ch/harmony/events.rpy:6141
translate russian harmony_birthday_date_pure_male_d27b3451:
    "Я уверенно беру у Хармони меню."

# ch/harmony/events.rpy:6142
translate russian harmony_birthday_date_pure_male_3dadc0a7:
    "И начинаю перечислять все блюда на понятном английском."

# ch/harmony/events.rpy:6143
translate russian harmony_birthday_date_pure_male_30fccec9:
    "Всё это время я вижу, как официант пытается скрыть раздражение."

# ch/harmony/events.rpy:6144
translate russian harmony_birthday_date_pure_male_fbe040b8:
    "Наверное, ждал возможности показать своё превосходство."

# ch/harmony/events.rpy:6145
translate russian harmony_birthday_date_pure_male_c9ced23d:
    "Но теперь вынужден прикусить язык и молчать."

# ch/harmony/events.rpy:6147
translate russian harmony_birthday_date_pure_male_78a93c6e:
    harmony.say "О, спасибо, [lssb_harmony.hero_name()]..."

# ch/harmony/events.rpy:6148
translate russian harmony_birthday_date_pure_male_7fbee316:
    harmony.say "Так гораздо проще!"

# ch/harmony/events.rpy:6149
translate russian harmony_birthday_date_pure_male_3fb45b0a:
    harmony.say "Теперь я знаю, что закажу."

# ch/harmony/events.rpy:6150
translate russian harmony_birthday_date_pure_male_52a6beed:
    "Через пару минут заказ сделан."

# ch/harmony/events.rpy:6151
translate russian harmony_birthday_date_pure_male_bc653e93:
    "Официант удаляется к кухне, оставляя нас в покое."

# ch/harmony/events.rpy:6152
translate russian harmony_birthday_date_pure_male_9209b213:
    "Наверное, здорово злится, что не смог посмотреть на нас свысока."

# ch/harmony/events.rpy:6154
translate russian harmony_birthday_date_pure_male_84e5c207:
    "Я бегло заглядываю в меню."

# ch/harmony/events.rpy:6155
translate russian harmony_birthday_date_pure_male_a6329d8d:
    "И понимаю, что Хармони права."

# ch/harmony/events.rpy:6156
translate russian harmony_birthday_date_pure_male_9777138d:
    "Просто выбранное мной блюдо случайно оказалось не на французском."

# ch/harmony/events.rpy:6157
translate russian harmony_birthday_date_pure_male_1ddcff66:
    "А почти всё остальное и вправду написано на иностранном языке!"

# ch/harmony/events.rpy:6158
translate russian harmony_birthday_date_pure_male_30e74fc5:
    mike.say "Эм..."

# ch/harmony/events.rpy:6159
translate russian harmony_birthday_date_pure_male_a79a7364:
    mike.say "Я тоже не понимаю, Хармони!"

# ch/harmony/events.rpy:6160
translate russian harmony_birthday_date_pure_male_294e6099:
    mike.say "Может, попробуешь угадать?"

# ch/harmony/events.rpy:6161
translate russian harmony_birthday_date_pure_male_99d73ba7:
    "Ничего лучше я придумать не могу."

# ch/harmony/events.rpy:6162
translate russian harmony_birthday_date_pure_male_2f7cf4f4:
    "Но Хармони такой ответ явно не нравится."

# ch/harmony/events.rpy:6164
translate russian harmony_birthday_date_pure_male_4ba2c288:
    harmony.say "Ладно, неважно."

# ch/harmony/events.rpy:6165
translate russian harmony_birthday_date_pure_male_c3892683:
    harmony.say "Просто спрошу официанта..."

# ch/harmony/events.rpy:6166
translate russian harmony_birthday_date_pure_male_8de1df13:
    "Я открываю рот, чтобы возразить, попросить её остановиться."

# ch/harmony/events.rpy:6167
translate russian harmony_birthday_date_pure_male_a13a858a:
    "Но уже поздно."

# ch/harmony/events.rpy:6168
translate russian harmony_birthday_date_pure_male_9b52ceb8:
    harmony.say "Простите..."

# ch/harmony/events.rpy:6170
translate russian harmony_birthday_date_pure_male_e54fbeb3:
    harmony.say "Мы не говорим по-французски!"

# ch/harmony/events.rpy:6171
translate russian harmony_birthday_date_pure_male_ac6057fe:
    "Едва услышав это, официант расплывается в высокомерной улыбке."

# ch/harmony/events.rpy:6172
translate russian harmony_birthday_date_pure_male_6f188f2e:
    "Следующие несколько минут я вынужден ёрзать на стуле."

# ch/harmony/events.rpy:6173
translate russian harmony_birthday_date_pure_male_5b3f1ce6:
    "Ведь он, конечно, наслаждается возможностью смотреть на нас обоих свысока."

# ch/harmony/events.rpy:6175
translate russian harmony_birthday_date_pure_male_5670a50b:
    "Спустя, кажется, целую вечность нам наконец удаётся заказать еду."

# ch/harmony/events.rpy:6176
translate russian harmony_birthday_date_pure_male_08910630:
    "Но чувствуем мы себя после этого крошечными и жалкими."

# ch/harmony/events.rpy:6178
translate russian harmony_birthday_date_pure_male_90fe14d0:
    "Вскоре приносят еду, и мы принимаемся за неё."

# ch/harmony/events.rpy:6179
translate russian harmony_birthday_date_pure_male_a632c273:
    "Быстро становится ясно: ожидание того стоило."

# ch/harmony/events.rpy:6180
translate russian harmony_birthday_date_pure_male_379e4806:
    "Всё так вкусно, что ужин заканчивается в рекордные сроки."

# ch/harmony/events.rpy:6181
translate russian harmony_birthday_date_pure_male_4fec1f5d:
    "Когда мы доедаем, Хармони улыбается и многозначительно смотрит на меня."

# ch/harmony/events.rpy:6182
translate russian harmony_birthday_date_pure_male_d1379e66:
    harmony.say "Итак..."

# ch/harmony/events.rpy:6183
translate russian harmony_birthday_date_pure_male_9497165b:
    harmony.say "Мы ведь отмечаем кое-чей день рождения!"

# ch/harmony/events.rpy:6185
translate russian harmony_birthday_date_pure_male_44e1fc4f:
    "Вот чёрт!"

# ch/harmony/events.rpy:6186
translate russian harmony_birthday_date_pure_male_00563c37:
    "Я знал, что что-то забыл."

# ch/harmony/events.rpy:6187
translate russian harmony_birthday_date_pure_male_df565c15:
    "Хармони намекает на подарок."

# ch/harmony/events.rpy:6188
translate russian harmony_birthday_date_pure_male_8e02975d:
    "А подарить мне нечего!"

# ch/harmony/events.rpy:6189
translate russian harmony_birthday_date_pure_male_6a747e10:
    "Придётся выкручиваться на ходу."

# ch/harmony/events.rpy:6190
translate russian harmony_birthday_date_pure_male_e293c08c:
    mike.say "Я знаю, Хармони."

# ch/harmony/events.rpy:6191
translate russian harmony_birthday_date_pure_male_d7cee7df:
    mike.say "Разве не здорово просто наслаждаться обществом друг друга?"

# ch/harmony/events.rpy:6192
translate russian harmony_birthday_date_pure_male_8cdd4be0:
    mike.say "Без всяких материальных вещей?"

# ch/harmony/events.rpy:6193
translate russian harmony_birthday_date_pure_male_51991dbd:
    mike.say "Как поступили бы Иисус или кто-нибудь из этих религиозных деятелей?"

# ch/harmony/events.rpy:6194
translate russian harmony_birthday_date_pure_male_e3d480d3:
    "Хармони моргает, удивлённая таким поворотом."

# ch/harmony/events.rpy:6195
translate russian harmony_birthday_date_pure_male_720bb7da:
    "Но быстро приходит в себя и согласно кивает."

# ch/harmony/events.rpy:6198
translate russian harmony_birthday_date_pure_male_e51ffb70_2:
    harmony.say "О..."

# ch/harmony/events.rpy:6199
translate russian harmony_birthday_date_pure_male_7813e59f:
    harmony.say "Конечно!"

# ch/harmony/events.rpy:6200
translate russian harmony_birthday_date_pure_male_f1775210:
    harmony.say "Материальные вещи тут совсем ни к чему!"

# ch/harmony/events.rpy:6201
translate russian harmony_birthday_date_pure_male_1dc085e4:
    "Фух... кажется, выкрутился."

# ch/harmony/events.rpy:6202
translate russian harmony_birthday_date_pure_male_10a66c3f:
    "Да, немного стыдно так пользоваться убеждениями Хармони."

# ch/harmony/events.rpy:6203
translate russian harmony_birthday_date_pure_male_f7f46c47:
    "Но это лучше, чем признаться, что забыл подарок, правда?"

# ch/harmony/events.rpy:6208
translate russian harmony_birthday_date_pure_male_04e85a3b:
    "Я киваю и улыбаюсь."

# ch/harmony/events.rpy:6209
translate russian harmony_birthday_date_pure_male_ebfcc32e:
    mike.say "Ладно, Хармони..."

# ch/harmony/events.rpy:6210
translate russian harmony_birthday_date_pure_male_5c7fc607:
    mike.say "Можешь больше не намекать."

# ch/harmony/events.rpy:6211
translate russian harmony_birthday_date_pure_male_5f5380d3:
    "Я достаю приготовленный подарок и вручаю ей."

# ch/harmony/events.rpy:6212
translate russian harmony_birthday_date_pure_male_506653e5:
    harmony.say "О, спасибо!"

# ch/harmony/events.rpy:6213
translate russian harmony_birthday_date_pure_male_1f881a03:
    harmony.say "Не стоило, но я очень рада!"

# ch/harmony/events.rpy:6216
translate russian harmony_birthday_date_pure_male_310bb595:
    "Хармони широко улыбается, открывая коробку."

# ch/harmony/events.rpy:6217
translate russian harmony_birthday_date_pure_male_825efd67:
    "Но, увидев содержимое, совершенно замирает."

# ch/harmony/events.rpy:6218
translate russian harmony_birthday_date_pure_male_a4b7f970_1:
    mike.say "Всё хорошо, Хармони?"

# ch/harmony/events.rpy:6219
translate russian harmony_birthday_date_pure_male_e9b13dff:
    mike.say "Что-то не так?"

# ch/harmony/events.rpy:6220
translate russian harmony_birthday_date_pure_male_ad082459:
    harmony.say "Что?"

# ch/harmony/events.rpy:6221
translate russian harmony_birthday_date_pure_male_1fa5cbc0:
    harmony.say "О... нет..."

# ch/harmony/events.rpy:6223
translate russian harmony_birthday_date_pure_male_01db7a12:
    harmony.say "Это лучший подарок на свете!"

# ch/harmony/events.rpy:6224
translate russian harmony_birthday_date_pure_male_1e6f7968:
    harmony.say "Огромное спасибо!"

# ch/harmony/events.rpy:6225
translate russian harmony_birthday_date_pure_male_93e5a1f6:
    "Я киваю и улыбаюсь, стараясь выглядеть скромно."

# ch/harmony/events.rpy:6226
translate russian harmony_birthday_date_pure_male_ce3d8468:
    "Но на самом деле меня распирает от гордости."

# ch/harmony/events.rpy:6228
translate russian harmony_birthday_date_pure_male_310bb595_1:
    "Хармони широко улыбается, открывая коробку."

# ch/harmony/events.rpy:6229
translate russian harmony_birthday_date_pure_male_92767d1d:
    "Но, увидев содержимое, мрачнеет."

# ch/harmony/events.rpy:6230
translate russian harmony_birthday_date_pure_male_a4b7f970_2:
    mike.say "Всё хорошо, Хармони?"

# ch/harmony/events.rpy:6231
translate russian harmony_birthday_date_pure_male_e9b13dff_1:
    mike.say "Что-то не так?"

# ch/harmony/events.rpy:6232
translate russian harmony_birthday_date_pure_male_ad082459_1:
    harmony.say "Что?"

# ch/harmony/events.rpy:6233
translate russian harmony_birthday_date_pure_male_916f85cd:
    harmony.say "Нет-нет, всё хорошо."

# ch/harmony/events.rpy:6235
translate russian harmony_birthday_date_pure_male_b967f553:
    harmony.say "Это... очень мило."

# ch/harmony/events.rpy:6236
translate russian harmony_birthday_date_pure_male_04e85a3b_1:
    "Я киваю и улыбаюсь."

# ch/harmony/events.rpy:6237
translate russian harmony_birthday_date_pure_male_f15b797c:
    "Но не нужно быть гением, чтобы понять: подарок её сильно разочаровал."

# ch/harmony/events.rpy:6239
