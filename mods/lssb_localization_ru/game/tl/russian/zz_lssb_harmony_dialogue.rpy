# Native Harmony identifiers, current source catalog. Translation only.

# ch/harmony/base.rpy:26
translate russian harmony_bye_d91d40e6:
    harmony.say "Мне, наверное, пора спать."

# ch/harmony/base.rpy:28
translate russian harmony_bye_ce8461a2:
    harmony.say "Пойду в ванную. Только попробуй подглядеть!"

# ch/harmony/base.rpy:30
translate russian harmony_bye_a051076f:
    harmony.say "У меня сейчас занятия, пожалуй, пора идти."

# ch/harmony/base.rpy:32
translate russian harmony_bye_759ae2fa:
    harmony.say "Я так проголодалась..."

# ch/harmony/base.rpy:34
translate russian harmony_bye_bcba239c:
    harmony.say "Не знаешь, что сейчас по телевизору?"

# ch/harmony/base.rpy:36
translate russian harmony_bye_0362e8bc:
    harmony.say "Пойду выпью в пабе. Увидимся."

# ch/harmony/base.rpy:38
translate russian harmony_bye_ec1b14a7:
    harmony.say "Сегодня солнечно. Думаю, пойду позагораю."

# ch/harmony/base.rpy:40
translate russian harmony_bye_3053307f:
    harmony.say "Хочется пройтись по магазинам."

# ch/harmony/base.rpy:42
translate russian harmony_bye_37a38aa2:
    harmony.say "Пойду почитаю. Начала очень хорошую книгу."

# ch/harmony/base.rpy:44
translate russian harmony_bye_0ec5c7c4:
    harmony.say "Пойду в клуб, хочется повеселиться."

# ch/harmony/base.rpy:46
translate russian harmony_bye_c57ae77a:
    harmony.say "Мне бы немного размяться до пота. До встречи."

# ch/harmony/base.rpy:48
translate russian harmony_bye_3432cc25:
    harmony.say "Пойду оденусь."

# ch/harmony/base.rpy:50
translate russian harmony_bye_44f04e71:
    harmony.say "Да хранит тебя Бог до нашей следующей встречи, [lssb_harmony.hero_name()]!"

# ch/harmony/base.rpy:54
translate russian harmony_bye_40b4d765:
    harmony.say "Не пропадай надолго. Мне так тебя не хватает, когда некому сказать, что делать..."

# ch/harmony/base.rpy:56
translate russian harmony_bye_7b3d60ab:
    harmony.say "Возвращайся скорее, [lssb_harmony.hero_name()]. У меня столько грешных мыслей, в которых нужно тебе признаться."

# ch/harmony/base.rpy:64
translate russian harmony_cheated_a1c78e90:
    harmony.say "Ты ничего не забыл?"

# ch/harmony/base.rpy:66
translate russian harmony_cheated_a2cea0fc:
    "И без предупреждения Хармони целует меня."

# ch/harmony/base.rpy:73
translate russian harmony_cheated_ffafe838:
    "Я замечаю, как Хармони смотрит, как я [lssb_harmony.action_text(action)] другую. В её глазах зависть и похоть."

# ch/harmony/base.rpy:81
translate russian harmony_cheated_8af0faed:
    "Хармони смотрит, как я [lssb_harmony.action_text(action)] другую, и складывает ладони словно для молитвы."

# ch/harmony/base.rpy:83
translate russian harmony_cheated_c52c62d9:
    harmony.say "Я помолюсь за тебя, [lssb_harmony.hero_name()]. Искушение привело к первородному греху, и теперь явно снова нашло тебя."

# ch/harmony/base.rpy:86
translate russian harmony_cheated_53aa2ad0:
    "Хармони смотрит, как я [lssb_harmony.action_text(action)] другую, с обидой моргая, чтобы сдержать слёзы."

# ch/harmony/base.rpy:88
translate russian harmony_cheated_d25d7082:
    harmony.say "Как ты мог, [lssb_harmony.hero_name()]? Я искренне верила, что твоё сердце способно на большую верность."

# ch/harmony/base.rpy:92
translate russian harmony_cheated_419257dc:
    "Хармони смотрит, как я [lssb_harmony.action_text(action)] другую. Её челюсти сжаты, глаза блестят."

# ch/harmony/base.rpy:94
translate russian harmony_cheated_6f201ae9:
    harmony.say "Я изо всех сил стараюсь простить это, [lssb_harmony.hero_name()]. Но Господь никогда не обещал, что будет легко."

# ch/harmony/base.rpy:98
translate russian harmony_cheated_27e2ee9f:
    "Хармони смотрит, как я [lssb_harmony.action_text(action)] другую, и на её лице мелькает что-то мрачное и собственническое."

# ch/harmony/base.rpy:100
translate russian harmony_cheated_c461946a:
    harmony.say "Ты должен быть моим, [lssb_harmony.hero_name()]. Я не делюсь тем, что Бог счёл нужным мне подарить."

# ch/harmony/base.rpy:104
translate russian harmony_cheated_11b18394:
    "Хармони смотрит, как я [lssb_harmony.action_text(action)] другую, и её милое лицо искажает яростная ревность."

# ch/harmony/base.rpy:106
translate russian harmony_cheated_34d4e3f6:
    harmony.say "Мой. Ты мой, [lssb_harmony.hero_name()], и даже сам ад не вырвет тебя из моих рук."

# ch/harmony/base.rpy:117
translate russian harmony_greet_951851f0:
    harmony.say "Здравствуй, [lssb_harmony.hero_name()]."

# ch/harmony/base.rpy:119
translate russian harmony_greet_054ab89f:
    harmony.say "Привет, [lssb_harmony.hero_name()]."

# ch/harmony/base.rpy:121
translate russian harmony_greet_ec24f48c:
    harmony.say "Рада тебя видеть, [lssb_harmony.hero_name()]."

# ch/harmony/base.rpy:124
translate russian harmony_greet_ab615f48:
    harmony.say "Доброе утро, [lssb_harmony.hero_name()]."

# ch/harmony/base.rpy:126
translate russian harmony_greet_58e36792:
    harmony.say "Добрый день, [lssb_harmony.hero_name()]."

# ch/harmony/base.rpy:128
translate russian harmony_greet_5e4585f8:
    harmony.say "Добрый вечер, [lssb_harmony.hero_name()]."

# ch/harmony/base.rpy:133
translate russian harmony_greet_f8ba8e1a:
    harmony.say "Благословение Господа растёт во мне с каждым днём, [lssb_harmony.hero_name()]."

# ch/harmony/base.rpy:134
translate russian harmony_greet_ba4bb7fd:
    harmony.say "Каждое утро я благодарю Его в молитве за то, что Он избрал меня!"

# ch/harmony/base.rpy:137
translate russian harmony_greet_16e347a7:
    harmony.say "Подойди, потрогай, [lssb_harmony.hero_name()]. Во мне растёт твой ребёнок."

# ch/harmony/base.rpy:138
translate russian harmony_greet_0156fd12:
    harmony.say "Мне всегда говорили, что грех рождает зло. Но теперь это — вся моя вера."

# ch/harmony/base.rpy:141
translate russian harmony_greet_2115376b:
    harmony.say "Господь привёл друга к моему порогу. Какое чудесное утро, [lssb_harmony.hero_name()]!"

# ch/harmony/base.rpy:144
translate russian harmony_greet_66825c09:
    harmony.say "Как же я рада тебя видеть! Я немного помолилась, чтобы ты сегодня заглянул."

# ch/harmony/base.rpy:147
translate russian harmony_greet_a6609f08:
    harmony.say "Ой! Ты застал меня за мыслями о тебе, [lssb_harmony.hero_name()]."

# ch/harmony/base.rpy:148
translate russian harmony_greet_9c342b9e:
    harmony.say "То есть за молитвой. Я молилась о тебе. Это же совсем не одно и то же, правда?"

# ch/harmony/base.rpy:151
translate russian harmony_greet_632d44ea:
    harmony.say "Вот и ты. Я вся извелась, пока тебя ждала."

# ch/harmony/base.rpy:152
translate russian harmony_greet_a8dccdfd:
    harmony.say "Прости меня, Господи, но, кажется, скучала я не по твоей душе."

# ch/harmony/base.rpy:155
translate russian harmony_greet_26cbe72a:
    harmony.say "М-м-м, кто пришёл. Я всё утро изнываю от желания, [lssb_harmony.hero_name()]."

# ch/harmony/base.rpy:157
translate russian harmony_greet_8c094512:
    harmony.say "Каждый день с тобой — словно ответ на молитву. Я серьёзно."

# ch/harmony/base.rpy:160
translate russian harmony_greet_48340763:
    harmony.say "М-м-м... Хочу встать на колени и поклоняться твоему члену!"

# ch/harmony/base.rpy:162
translate russian harmony_greet_dced3ef2:
    harmony.say "Думаю, мне стоит основать культ, [lssb_harmony.hero_name()]."

# ch/harmony/base.rpy:163
translate russian harmony_greet_e1ba2db4:
    harmony.say "Единственная цель которого — поклонение твоему могучему члену."

# ch/harmony/base.rpy:170
translate russian harmony_greet_dialogues_male_fa164580:
    mike.say "Здравствуй, Хармони."

# ch/harmony/base.rpy:172
translate russian harmony_greet_dialogues_male_6810e1f5:
    mike.say "Привет."

# ch/harmony/base.rpy:175
translate russian harmony_greet_dialogues_male_91f9f944:
    mike.say "Привет, Хармони."

# ch/harmony/base.rpy:177
translate russian harmony_greet_dialogues_male_372c6daa:
    mike.say "Доброе утро, Хармони."

# ch/harmony/base.rpy:179
translate russian harmony_greet_dialogues_male_e7ff6179:
    mike.say "Добрый день, Хармони."

# ch/harmony/base.rpy:181
translate russian harmony_greet_dialogues_male_027957ee:
    mike.say "Добрый вечер, Хармони."

# ch/harmony/base.rpy:188
translate russian harmony_kiss_d1991823:
    "Я знаю, что Хармони не обычная девушка. Она гораздо невиннее и, возможно, наивнее большинства."

# ch/harmony/base.rpy:189
translate russian harmony_kiss_0e614b0b:
    "Поэтому я так долго ждал и так тщательно искал подходящий момент для подобного шага."

# ch/harmony/base.rpy:190
translate russian harmony_kiss_7164164d:
    "Мне уже целую вечность хочется её поцеловать. Да и кому бы не хотелось?"

# ch/harmony/base.rpy:191
translate russian harmony_kiss_ab75f66e:
    "Вы только посмотрите на неё!"

# ch/harmony/base.rpy:192
translate russian harmony_kiss_7bee394f:
    "Но, должно быть, я неверно понял её намёки или просто увлёкся собственными чувствами."

# ch/harmony/base.rpy:193
translate russian harmony_kiss_6dbb73ea:
    "Ведь едва я наклоняюсь за самым мимолётным и целомудренным поцелуем, Хармони резко отстраняется."

# ch/harmony/base.rpy:194
translate russian harmony_kiss_2201472b:
    "К счастью, она ничего не говорит, чтобы не усугублять неловкость."

# ch/harmony/base.rpy:195
translate russian harmony_kiss_a5018a78:
    "А я чувствую себя полным болваном, растоптавшим её нежные чувства."

# ch/harmony/base.rpy:204
translate russian harmony_kiss_2185753d:
    "Я сдерживался так долго, что это уже почти причиняет физическую боль."

# ch/harmony/base.rpy:205
translate russian harmony_kiss_02344869:
    "И в этот момент решаю: больше ждать не могу, к чёрту последствия."

# ch/harmony/base.rpy:206
translate russian harmony_kiss_10564685:
    "Я наклоняюсь и касаюсь губ Хармони своими, гадая, как она отреагирует на такой смелый шаг."

# ch/harmony/base.rpy:207
translate russian harmony_kiss_6033edd6:
    "Она на мгновение замирает, чего я вполне ожидал."

# ch/harmony/base.rpy:208
translate russian harmony_kiss_b1b85c6c:
    "Но затем напряжение словно тает, и я чувствую, как она отвечает на поцелуй."

# ch/harmony/base.rpy:209
translate russian harmony_kiss_11e35c52:
    "Поначалу нежный, он постепенно становится страстнее."

# ch/harmony/base.rpy:210
translate russian harmony_kiss_d88f53c6:
    "Я не питаю иллюзий: такая застенчивая и чистая девушка, как Хармони, не станет совать язык мне в горло."

# ch/harmony/base.rpy:211
translate russian harmony_kiss_c9d03329:
    "И именно поэтому понимаю, насколько много чувств она сейчас проявляет."

# ch/harmony/base.rpy:220
translate russian harmony_kiss_01220934:
    "Можно было бы подумать, что из-за застенчивости и целомудрия Хармони с ней совсем не весело."

# ch/harmony/base.rpy:221
translate russian harmony_kiss_fff37b46:
    "Но ей просто нужно уединение: оставшись со мной наедине, она даёт волю страсти."

# ch/harmony/base.rpy:222
translate russian harmony_kiss_68d89cf5:
    "Её поцелуи не дикие и порочные, а долгие, неторопливые, заставляющие её трепетать от чувств."

# ch/harmony/base.rpy:223
translate russian harmony_kiss_46d3171b:
    "Всякий раз, когда я пользуюсь случаем поцеловать её, дыхание Хармони становится тяжелее и горячее."

# ch/harmony/base.rpy:224
translate russian harmony_kiss_cb4e172c:
    "Держа её в объятиях, я чувствую, как учащается биение её сердца."

# ch/harmony/base.rpy:225
translate russian harmony_kiss_0680ad4b:
    "Странно: поначалу всегда кажется, что сильнее всего тебя будут заводить раскованные девушки."

# ch/harmony/base.rpy:226
translate russian harmony_kiss_5eae47b5:
    "Но один звук почти прерывистого дыхания Хармони во время поцелуя — нечто особенное."

# ch/harmony/base.rpy:227
translate russian harmony_kiss_c4d2956f:
    "Наверное, всё дело в мысли о том, что она может сделать дальше..."

# ch/harmony/base.rpy:238
translate russian harmony_propose_male_7613b486:
    "Это не должно было бы превращать меня в дрожащий комок нервов."

# ch/harmony/base.rpy:239
translate russian harmony_propose_male_87a475ff:
    "Мы с Хармони уже довольно давно встречаемся и отлично ладим."

# ch/harmony/base.rpy:240
translate russian harmony_propose_male_5803cdb1:
    "По крайней мере, мне так кажется. Значит, перейти на следующий уровень вполне логично, верно?"

# ch/harmony/base.rpy:242
translate russian harmony_propose_male_856839bc:
    "Она ведь подаёт, как мне кажется, вполне подходящие знаки."

# ch/harmony/base.rpy:243
translate russian harmony_propose_male_9d1e87d7:
    "Мы говорили о будущем и о том, чего каждый из нас на самом деле хочет от жизни."

# ch/harmony/base.rpy:244
translate russian harmony_propose_male_6bd46348:
    "Для меня это достаточно ясный намёк: Хармони хочет, чтобы я сделал решительный шаг."

# ch/harmony/base.rpy:246
translate russian harmony_propose_male_ac1c2585:
    "Вот почему в моём кармане лежит крошечная коробочка, которая будто весит целую тонну!"

# ch/harmony/base.rpy:247
translate russian harmony_propose_male_db2e3fb5:
    "Остаётся взять себя в руки и дождаться подходящего момента..."

# ch/harmony/base.rpy:249
translate russian harmony_propose_male_8ba57427:
    harmony.say "...вот я и сказала ей, что она неправа."

# ch/harmony/base.rpy:250
translate russian harmony_propose_male_2b1d315f:
    harmony.say "Этот библейский стих никак нельзя истолковать подобным образом!"

# ch/harmony/base.rpy:251
translate russian harmony_propose_male_d9536115:
    harmony.say "Ты ведь согласен, [lssb_harmony.hero_name()]?"

# ch/harmony/base.rpy:253
translate russian harmony_propose_male_3a79f076:
    harmony.say "[lssb_harmony.hero_name()]... что ты делаешь?!"

# ch/harmony/base.rpy:255
translate russian harmony_propose_male_19f350c9:
    "Я бы сказал, что это довольно очевидно."

# ch/harmony/base.rpy:257
translate russian harmony_propose_male_3f4b63c1:
    "Стою перед Хармони на колене."

# ch/harmony/base.rpy:258
translate russian harmony_propose_male_da9bf417:
    "И держу кольцо между большим и указательным пальцами."

# ch/harmony/base.rpy:259
translate russian harmony_propose_male_a1b2627e:
    "Но она, наверное, совсем растерялась, так что стоит проявить снисхождение."

# ch/harmony/base.rpy:260
translate russian harmony_propose_male_cd815953:
    mike.say "Хармони..."

# ch/harmony/base.rpy:261
translate russian harmony_propose_male_91e14a1f:
    mike.say "Ты знаешь, как сильно я тебя люблю."

# ch/harmony/base.rpy:262
translate russian harmony_propose_male_946c2b1c:
    mike.say "Поэтому я хочу, чтобы ты вышла за меня."

# ch/harmony/base.rpy:263
translate russian harmony_propose_male_3d1c35ba:
    mike.say "Скажи «да», Хармони. Скажи, что станешь моей женой?"

# ch/harmony/base.rpy:266
translate russian harmony_propose_male_fb5e6734:
    "Кажется, я ещё никогда не видел такого выражения на её лице."

# ch/harmony/base.rpy:267
translate russian harmony_propose_male_b7b475c7:
    "Обычно она сама уверенность — в своей вере и убеждениях."

# ch/harmony/base.rpy:269
translate russian harmony_propose_male_f1e59326:
    "Но сейчас она выглядит потрясённой до глубины души."

# ch/harmony/base.rpy:270
translate russian harmony_propose_male_4e9afbf8:
    "Хармони моргает, её губы шевелятся, но поначалу ни звука."

# ch/harmony/base.rpy:271
translate russian harmony_propose_male_6e583bfa:
    "Я остаюсь на месте, терпеливо ожидая ответа."

# ch/harmony/base.rpy:273
translate russian harmony_propose_male_b4b103ea:
    "Наконец её голова начинает двигаться."

# ch/harmony/base.rpy:274
translate russian harmony_propose_male_a9f8cb94:
    "Я затаив дыхание жду, каким окажется этот жест..."

# ch/harmony/base.rpy:276
translate russian harmony_propose_male_b17fd098:
    "Но когда вижу, что Хармони качает головой, у меня всё внутри обрывается."

# ch/harmony/base.rpy:277
translate russian harmony_propose_male_5a5a5f99:
    "Наверное, то, что она при этом улыбается, должно хоть немного утешить."

# ch/harmony/base.rpy:278
translate russian harmony_propose_male_b7624f29:
    "Как и то, что она берёт меня за руки и помогает встать."

# ch/harmony/base.rpy:279
translate russian harmony_propose_male_19b69b7c:
    "Но вместо этого я чувствую унижение, будто каждый её жест полон снисхождения."

# ch/harmony/base.rpy:281
translate russian harmony_propose_male_c146ab0c:
    harmony.say "Ох, [lssb_harmony.hero_name()]..."

# ch/harmony/base.rpy:282
translate russian harmony_propose_male_067b9afb:
    harmony.say "Что на тебя нашло?"

# ch/harmony/base.rpy:284
translate russian harmony_propose_male_fbb0121f:
    mike.say "Ч... что ты имеешь в виду, Хармони?"

# ch/harmony/base.rpy:285
translate russian harmony_propose_male_9aefb5ce:
    mike.say "Я так сильно тебя люблю!"

# ch/harmony/base.rpy:286
translate russian harmony_propose_male_4d403d09:
    mike.say "И хочу на тебе жениться!"

# ch/harmony/base.rpy:287
translate russian harmony_propose_male_834d8e30:
    mike.say "Разве ты не чувствуешь того же?"

# ch/harmony/base.rpy:289
translate russian harmony_propose_male_b829e8f4:
    "Хармони закатывает глаза и цокает языком."

# ch/harmony/base.rpy:290
translate russian harmony_propose_male_dcdeb6cc:
    "Мне кажется, будто она разговаривает с непонятливым ребёнком."

# ch/harmony/base.rpy:292
translate russian harmony_propose_male_9933a95d:
    harmony.say "Конечно, я тебя люблю, глупенький!"

# ch/harmony/base.rpy:293
translate russian harmony_propose_male_62549268:
    harmony.say "И брак — достойный способ освятить нашу любовь перед Богом."

# ch/harmony/base.rpy:294
translate russian harmony_propose_male_270f223b:
    harmony.say "Но к таким обязательствам мы ещё не готовы, [lssb_harmony.hero_name()]."

# ch/harmony/base.rpy:296
translate russian harmony_propose_male_6125bf0a:
    "Я качаю головой, всё ещё не понимая её слов."

# ch/harmony/base.rpy:297
translate russian harmony_propose_male_9709654f:
    mike.say "Мы... не готовы?"

# ch/harmony/base.rpy:298
translate russian harmony_propose_male_ec46c37d:
    mike.say "Мне казалось, мы вполне благочестивы, Хармони!"

# ch/harmony/base.rpy:300
translate russian harmony_propose_male_38acb9cf:
    "Она снова улыбается, словно прощая мою глупость."

# ch/harmony/base.rpy:302
translate russian harmony_propose_male_4de5f030:
    harmony.say "Ну, я, пожалуй, уже почти готова."

# ch/harmony/base.rpy:303
translate russian harmony_propose_male_0473d4bd:
    harmony.say "А вот тебе нужно стать чуть благочестивее, [lssb_harmony.hero_name()]."

# ch/harmony/base.rpy:304
translate russian harmony_propose_male_5212ce61:
    harmony.say "Самую капельку чище и непорочнее!"

# ch/harmony/base.rpy:306
translate russian harmony_propose_male_ac248111:
    "Хармони поднимает руку, оставляя маленький промежуток между большим и указательным пальцами."

# ch/harmony/base.rpy:307
translate russian harmony_propose_male_a01c1603:
    "Показывает, насколько, по её мнению, я близок к божественному совершенству."

# ch/harmony/base.rpy:308
translate russian harmony_propose_male_ac49fec7:
    "Мне остаётся лишь кивнуть и убрать кольцо."

# ch/harmony/base.rpy:309
translate russian harmony_propose_male_64ea79ff:
    "Но чувство унижения никуда не девается."

# ch/harmony/base.rpy:310
translate russian harmony_propose_male_db61351d:
    "Будто я недостаточно хорош для Хармони, сколько бы ни старался."

# ch/harmony/base.rpy:312
translate russian harmony_propose_male_ee2bd75c:
    harmony.say "Не переживай, [lssb_harmony.hero_name()]..."

# ch/harmony/base.rpy:313
translate russian harmony_propose_male_2cc5e6cf:
    harmony.say "Как только станешь достаточно благочестивым, я тебе скажу!"

# ch/harmony/base.rpy:318
translate russian harmony_propose_male_185d946f:
    "Но когда я вижу, что Хармони кивает, меня захлёстывает облегчение."

# ch/harmony/base.rpy:319
translate russian harmony_propose_male_38c79f82:
    "Все прежние сомнения словно испаряются."

# ch/harmony/base.rpy:320
translate russian harmony_propose_male_f6e3f2f2:
    "Я вскакиваю на ноги и поспешно беру её за руку."

# ch/harmony/base.rpy:321
translate russian harmony_propose_male_5330615f:
    "Затем как можно скорее надеваю кольцо ей на палец."

# ch/harmony/base.rpy:322
translate russian harmony_propose_male_fb1dede9:
    "Будто боюсь, что в любую секунду она передумает."

# ch/harmony/base.rpy:323
translate russian harmony_propose_male_cbd969e3:
    "Будто кольцо на пальце каким-то образом скрепляет нашу договорённость."

# ch/harmony/base.rpy:324
translate russian harmony_propose_male_8a75832e:
    mike.say "Боже мой, Хармони..."

# ch/harmony/base.rpy:325
translate russian harmony_propose_male_513e9b96:
    mike.say "Я до смерти боялся, что ты откажешь!"

# ch/harmony/base.rpy:326
translate russian harmony_propose_male_cc7826c2:
    "Она отрывает взгляд от кольца на своём пальце."

# ch/harmony/base.rpy:327
translate russian harmony_propose_male_53bbb16b:
    "И я замечаю, что в её глазах стоят слёзы."

# ch/harmony/base.rpy:329
translate russian harmony_propose_male_c146ab0c_1:
    harmony.say "Ох, [lssb_harmony.hero_name()]..."

# ch/harmony/base.rpy:330
translate russian harmony_propose_male_e49c77ab:
    harmony.say "Как ты мог такое подумать?"

# ch/harmony/base.rpy:331
translate russian harmony_propose_male_01c17e66:
    harmony.say "Я так ждала этого мгновения, так мечтала о нём!"

# ch/harmony/base.rpy:333
translate russian harmony_propose_male_0a2c4fbc:
    "Хармони набирает полную грудь воздуха."

# ch/harmony/base.rpy:334
translate russian harmony_propose_male_e7686ba6:
    "На мгновение задерживает дыхание, и её пышная грудь поднимается."

# ch/harmony/base.rpy:335
translate russian harmony_propose_male_61ad7bd7:
    "Затем выдыхает долгим вздохом чистого счастья и удовлетворения."

# ch/harmony/base.rpy:337
translate russian harmony_propose_male_b70a6f80:
    harmony.say "Я позволяла себе мечтать, что это случится."

# ch/harmony/base.rpy:338
translate russian harmony_propose_male_b62c68f4:
    harmony.say "Даже молилась об этом."

# ch/harmony/base.rpy:339
translate russian harmony_propose_male_2393e822:
    harmony.say "Молилась, хотя знала, что это эгоистично!"

# ch/harmony/base.rpy:340
translate russian harmony_propose_male_d02a7ea3:
    harmony.say "Но Бог услышал и решил благословить меня!"

# ch/harmony/base.rpy:342
translate russian harmony_propose_male_3cb7f857:
    "Не знаю, как относиться к тому, что все заслуги приписывают Богу."

# ch/harmony/base.rpy:343
translate russian harmony_propose_male_848c9bcf:
    "Вообще-то на кольцо раскошелился я."

# ch/harmony/base.rpy:344
translate russian harmony_propose_male_0f230eea:
    "И когда только что делал предложение, особой божественной помощи не ощущал!"

# ch/harmony/base.rpy:345
translate russian harmony_propose_male_b52f0e78:
    "Но я слишком счастлив, что Хармони согласилась, чтобы всерьёз об этом задумываться."

# ch/harmony/base.rpy:346
translate russian harmony_propose_male_91853db9:
    mike.say "Ох, Хармони..."

# ch/harmony/base.rpy:347
translate russian harmony_propose_male_ed939129:
    mike.say "Мы поженимся!"

# ch/harmony/base.rpy:348
translate russian harmony_propose_male_9038f998:
    mike.say "Не могу дождаться начала нашей совместной жизни!"

# ch/harmony/base.rpy:350
translate russian harmony_propose_male_2e5f7ebb:
    "Она улыбается и радостно кивает."

# ch/harmony/base.rpy:352
translate russian harmony_propose_male_2458cfe0:
    harmony.say "А уж после свадьбы, [lssb_harmony.hero_name()], вот увидишь."

# ch/harmony/base.rpy:354
translate russian harmony_propose_male_d733eb90:
    harmony.say "Супругам можно столько всего приятного."

# ch/harmony/base.rpy:355
translate russian harmony_propose_male_0d62040e:
    harmony.say "И самое прекрасное — Бог всё это одобряет!"

# ch/harmony/base.rpy:358
translate russian harmony_propose_male_060f39a3:
    "Прежде чем продолжить, хочу кое-что прояснить."

# ch/harmony/base.rpy:359
translate russian harmony_propose_male_4d4dc665:
    "Мне нравится Хармони такой, какая она есть, и я не хочу её менять."

# ch/harmony/base.rpy:361
translate russian harmony_propose_male_efed900d:
    "Но мне становится трудно угнаться за её требованиями."

# ch/harmony/base.rpy:362
translate russian harmony_propose_male_5c858326:
    "И я подумал, что это может помочь мне и немного успокоить её."

# ch/harmony/base.rpy:363
translate russian harmony_propose_male_85cf358d:
    "Поэтому я залезаю в сбережения и покупаю для Хармони кольцо."

# ch/harmony/base.rpy:365
translate russian harmony_propose_male_9319a014:
    "Хочу предложить ей выйти за меня, показать, что я никуда не собираюсь уходить."

# ch/harmony/base.rpy:366
translate russian harmony_propose_male_d41c787d:
    "Может, тогда она поймёт, что не нужно так стараться!"

# ch/harmony/base.rpy:367
translate russian harmony_propose_male_79f4560d:
    "Кольцо уже в кармане. Осталось выбрать подходящий момент..."

# ch/harmony/base.rpy:369
translate russian harmony_propose_male_24681a75:
    harmony.say "...так что, оказывается, он довольно большой!"

# ch/harmony/base.rpy:370
translate russian harmony_propose_male_4f97e7ad:
    harmony.say "Меня это, честно говоря, удивило."

# ch/harmony/base.rpy:371
translate russian harmony_propose_male_ff0b047f:
    harmony.say "Я-то хотела бы гораздо больше..."

# ch/harmony/base.rpy:373
translate russian harmony_propose_male_e9784b66:
    harmony.say "[lssb_harmony.hero_name()], ты вообще меня слушаешь?"

# ch/harmony/base.rpy:375
translate russian harmony_propose_male_15500f94:
    "Хармони оглядывается, поняв, что меня уже нет там, где она ожидала."

# ch/harmony/base.rpy:377
translate russian harmony_propose_male_19ee8df5:
    "Затем опускает взгляд и видит меня перед собой на колене."

# ch/harmony/base.rpy:379
translate russian harmony_propose_male_62a4296c:
    harmony.say "[lssb_harmony.hero_name()], что ты там делаешь?!"

# ch/harmony/base.rpy:381
translate russian harmony_propose_male_a1ec33c4:
    "Она серьёзно это спрашивает?"

# ch/harmony/base.rpy:382
translate russian harmony_propose_male_08506d8e:
    "Кольцо у меня в руке, по-моему, довольно ясная подсказка!"

# ch/harmony/base.rpy:384
translate russian harmony_propose_male_012e4dae:
    harmony.say "О-о..."

# ch/harmony/base.rpy:385
translate russian harmony_propose_male_d59676f4:
    harmony.say "Это эрекционное кольцо?"

# ch/harmony/base.rpy:386
translate russian harmony_propose_male_d8c3fad8:
    harmony.say "Или новое украшение для пирсинга моей киски?"

# ch/harmony/base.rpy:388
translate russian harmony_propose_male_13b78027:
    "Я моргаю, поражённый её вопросами."

# ch/harmony/base.rpy:389
translate russian harmony_propose_male_77db4d5e:
    mike.say "Эм, нет, Хармони..."

# ch/harmony/base.rpy:390
translate russian harmony_propose_male_31995cb6:
    mike.say "Я пытаюсь сделать тебе предложение!"

# ch/harmony/base.rpy:391
translate russian harmony_propose_male_68e19989:
    mike.say "Я люблю тебя больше всего на свете..."

# ch/harmony/base.rpy:392
translate russian harmony_propose_male_8069cfae:
    mike.say "Ты выйдешь за меня?"

# ch/harmony/base.rpy:394
translate russian harmony_propose_male_a6a796fe:
    "Впервые на моей памяти Хармони не находит слов."

# ch/harmony/base.rpy:395
translate russian harmony_propose_male_ca077d5e:
    "Качает головой и беззвучно шевелит губами."

# ch/harmony/base.rpy:396
translate russian harmony_propose_male_811e2b43:
    "Какая-то часть меня боится, что сейчас ей станет дурно."

# ch/harmony/base.rpy:397
translate russian harmony_propose_male_29162cc4:
    "Что она упадёт от удивления в обморок прямо на меня!"

# ch/harmony/base.rpy:398
translate russian harmony_propose_male_519e5bb3:
    "Я готовлюсь её подхватить, а это труднее, чем можно подумать."

# ch/harmony/base.rpy:399
translate russian harmony_propose_male_7a85d75d:
    "Ведь Хармони никогда не была лёгкой девушкой, а её пышные формы непросто удержать!"

# ch/harmony/base.rpy:402
translate russian harmony_propose_male_2d9056f3:
    "Но тут выражение её лица меняется."

# ch/harmony/base.rpy:403
translate russian harmony_propose_male_4b56f340:
    "Она улыбается мне сверху и одновременно качает головой."

# ch/harmony/base.rpy:405
translate russian harmony_propose_male_1e48289a:
    harmony.say "О нет, [lssb_harmony.hero_name()]..."

# ch/harmony/base.rpy:406
translate russian harmony_propose_male_bec5a799:
    harmony.say "Я не могу!"

# ch/harmony/base.rpy:408
translate russian harmony_propose_male_3486cfbd:
    "Поражённый ответом, я чуть ли не вскакиваю."

# ch/harmony/base.rpy:409
translate russian harmony_propose_male_70dff5a3:
    "Качаю головой, пока мысли лихорадочно мечутся."

# ch/harmony/base.rpy:410
translate russian harmony_propose_male_ca9f5e4f:
    "Не понимаю, почему Хармони отказывает!"

# ch/harmony/base.rpy:411
translate russian harmony_propose_male_86327def:
    mike.say "Чт... что не так, Хармони?"

# ch/harmony/base.rpy:412
translate russian harmony_propose_male_51885e51:
    mike.say "Почему ты не хочешь выйти за меня?"

# ch/harmony/base.rpy:413
translate russian harmony_propose_male_4ee2b718:
    mike.say "Я для тебя недостаточно интересен?"

# ch/harmony/base.rpy:414
translate russian harmony_propose_male_dd8bf052:
    mike.say "Ну... я исправлюсь, вот увидишь!"

# ch/harmony/base.rpy:415
translate russian harmony_propose_male_bc133f45:
    mike.say "Я сделаю всё, что ты захочешь, Хармони."

# ch/harmony/base.rpy:416
translate russian harmony_propose_male_ce32ee66:
    mike.say "Где угодно, когда угодно, в любой позе!"

# ch/harmony/base.rpy:417
translate russian harmony_propose_male_1636a8be:
    mike.say "Только, пожалуйста, согласись выйти за меня!"

# ch/harmony/base.rpy:419
translate russian harmony_propose_male_5d770b9d:
    "Хармони разражается смехом."

# ch/harmony/base.rpy:421
translate russian harmony_propose_male_671c9721:
    harmony.say "Ох, [lssb_harmony.hero_name()], ты такой смешной!"

# ch/harmony/base.rpy:422
translate russian harmony_propose_male_2c8e7f8c:
    harmony.say "Я хочу когда-нибудь выйти за тебя. Просто не сейчас."

# ch/harmony/base.rpy:423
translate russian harmony_propose_male_3ec158d3:
    harmony.say "Мы поженимся, когда придёт время."

# ch/harmony/base.rpy:424
translate russian harmony_propose_male_755d1b1f:
    harmony.say "Но до этого у меня целый список того, что хочется попробовать!"

# ch/harmony/base.rpy:425
translate russian harmony_propose_male_e281af8f:
    harmony.say "И кое-что из этого супружеским парам, по-моему, вообще запрещено!"

# ch/harmony/base.rpy:427
translate russian harmony_propose_male_b1153c2b:
    "Я киваю, изо всех сил пытаясь осмыслить её слова."

# ch/harmony/base.rpy:428
translate russian harmony_propose_male_9a57a6f0:
    "Конечно, обидно получить отказ после всех стараний."

# ch/harmony/base.rpy:429
translate russian harmony_propose_male_15b23154:
    "Но, пожалуй, в её словах есть смысл."

# ch/harmony/base.rpy:430
translate russian harmony_propose_male_4196fe56:
    "И всё же Хармони видит, что я задет."

# ch/harmony/base.rpy:432
translate russian harmony_propose_male_98d37bf0:
    "Она вздыхает и пытается объясниться."

# ch/harmony/base.rpy:434
translate russian harmony_propose_male_fe5a293e:
    harmony.say "Помнишь, какой я была, когда мы познакомились?"

# ch/harmony/base.rpy:435
translate russian harmony_propose_male_fbfb14e5:
    harmony.say "Я так зациклилась на религии, что она управляла всей моей жизнью."

# ch/harmony/base.rpy:436
translate russian harmony_propose_male_9691da80:
    harmony.say "Но ты это изменил. Показал, что жизнь не ограничивается этим."

# ch/harmony/base.rpy:438
translate russian harmony_propose_male_0266ca08:
    mike.say "Что ты имеешь в виду, Хармони?"

# ch/harmony/base.rpy:439
translate russian harmony_propose_male_1e54ce59:
    mike.say "Не хочешь замуж, потому что это связано с религией?"

# ch/harmony/base.rpy:440
translate russian harmony_propose_male_c804c0fb:
    mike.say "Можем просто зарегистрировать брак без венчания."

# ch/harmony/base.rpy:442
translate russian harmony_propose_male_21123683:
    harmony.say "Нет, [lssb_harmony.hero_name()]..."

# ch/harmony/base.rpy:443
translate russian harmony_propose_male_d9edffbf:
    harmony.say "Дело не в этом."

# ch/harmony/base.rpy:444
translate russian harmony_propose_male_8171063c:
    harmony.say "Сейчас всё хорошо. Зачем что-то менять?"

# ch/harmony/base.rpy:446
translate russian harmony_propose_male_d56d898c:
    "Я обдумываю её слова и понимаю, что где-то уже такое слышал."

# ch/harmony/base.rpy:447
translate russian harmony_propose_male_87ee803c:
    "Ведь это почти стандартный мужской ответ на предложение серьёзных обязательств."

# ch/harmony/base.rpy:448
translate russian harmony_propose_male_7f8d9d72:
    "Если сейчас всё хорошо, зачем что-то менять?"

# ch/harmony/base.rpy:449
translate russian harmony_propose_male_9224f095:
    mike.say "В этом есть смысл, Хармони!"

# ch/harmony/base.rpy:450
translate russian harmony_propose_male_3e6e5930:
    mike.say "Пожениться мы всегда успеем."

# ch/harmony/base.rpy:451
translate russian harmony_propose_male_6e5fd341:
    mike.say "А пока можем как следует повеселиться!"

# ch/harmony/base.rpy:453
translate russian harmony_propose_male_eff817d1:
    "Она наклоняется и целует меня в щёку."

# ch/harmony/base.rpy:454
translate russian harmony_propose_male_a7a2b17d:
    "Я невольно улыбаюсь."

# ch/harmony/base.rpy:455
translate russian harmony_propose_male_42467638:
    "Да, я хотел услышать другой ответ."

# ch/harmony/base.rpy:456
translate russian harmony_propose_male_43a4f1a3:
    "Но теперь чувствую себя счастливее, чем прежде."

# ch/harmony/base.rpy:457
translate russian harmony_propose_male_3dc14d0a:
    "А ещё мне кажется, что я гораздо лучше понимаю Хармони!"

# ch/harmony/base.rpy:458
translate russian harmony_propose_male_b433e621:
    "Остаётся кивать и улыбаться, уже гадая, во что я ввязался..."

# ch/harmony/base.rpy:463
translate russian harmony_propose_male_2d9056f3_1:
    "Но тут выражение её лица меняется."

# ch/harmony/base.rpy:464
translate russian harmony_propose_male_83758a52:
    "Она смотрит на меня сверху, улыбается и начинает хихикать."

# ch/harmony/base.rpy:466
translate russian harmony_propose_male_605a5081:
    harmony.say "Это даже лучше эрекционного кольца!"

# ch/harmony/base.rpy:467
translate russian harmony_propose_male_e0a5cb6d:
    harmony.say "Конечно, да, [lssb_harmony.hero_name()]!"

# ch/harmony/base.rpy:469
translate russian harmony_propose_male_2e77783c:
    "Она протягивает мне руку."

# ch/harmony/base.rpy:471
translate russian harmony_propose_male_39cd6176:
    harmony.say "Чего ты ждёшь?"

# ch/harmony/base.rpy:473
translate russian harmony_propose_male_e930d695:
    "Не желая терять ни секунды, я делаю, как велено."

# ch/harmony/base.rpy:474
translate russian harmony_propose_male_bcd1ce9a:
    "Надеваю кольцо на палец Хармони и встаю."

# ch/harmony/base.rpy:475
translate russian harmony_propose_male_a0874185:
    "Она уже вытягивает руку и любуется тем, как оно смотрится."

# ch/harmony/base.rpy:477
translate russian harmony_propose_male_67dc4fba:
    harmony.say "Я... не могу поверить, что это происходит!"

# ch/harmony/base.rpy:478
translate russian harmony_propose_male_f405348c:
    harmony.say "Словно мечта сбылась!"

# ch/harmony/base.rpy:480
translate russian harmony_propose_male_060dd99e:
    "Затем я качаю головой, понемногу приходя в себя."

# ch/harmony/base.rpy:481
translate russian harmony_propose_male_25bc7104:
    mike.say "Ты серьёзно, Хармони?"

# ch/harmony/base.rpy:482
translate russian harmony_propose_male_aaee6dae:
    mike.say "Ты правда хочешь выйти за меня?!"

# ch/harmony/base.rpy:484
translate russian harmony_propose_male_cc7826c2_1:
    "Она отрывает взгляд от кольца на своём пальце."

# ch/harmony/base.rpy:485
translate russian harmony_propose_male_4a612376:
    "И, кажется, мой вопрос её немало озадачивает."

# ch/harmony/base.rpy:487
translate russian harmony_propose_male_562b849f:
    harmony.say "Эм... да, [lssb_harmony.hero_name()]!"

# ch/harmony/base.rpy:488
translate russian harmony_propose_male_f02359f0:
    harmony.say "Зачем бы ещё я согласилась?"

# ch/harmony/base.rpy:490
translate russian harmony_propose_male_4991aa35:
    mike.say "Ну... потому что я... потому что ты..."

# ch/harmony/base.rpy:491
translate russian harmony_propose_male_74c5e851:
    mike.say "Да чёрт, Хармони, не знаю!"

# ch/harmony/base.rpy:492
translate russian harmony_propose_male_8188ecf7:
    mike.say "Я просто боялся, что ты откажешь, вот и всё!"

# ch/harmony/base.rpy:494
translate russian harmony_propose_male_bdd32268:
    "Хармони смеётся надо мной и качает головой."

# ch/harmony/base.rpy:496
translate russian harmony_propose_male_3ab86ad6:
    harmony.say "Тут и думать нечего, [lssb_harmony.hero_name()]!"

# ch/harmony/base.rpy:497
translate russian harmony_propose_male_85d179ed:
    harmony.say "Ты ведь помнишь, какой я была, правда?"

# ch/harmony/base.rpy:498
translate russian harmony_propose_male_1e3553e3:
    harmony.say "Я была одержима религией, это была вся моя жизнь!"

# ch/harmony/base.rpy:499
translate russian harmony_propose_male_de6f8983:
    harmony.say "И думала, что так будет всегда. Пока не появился ты!"

# ch/harmony/base.rpy:500
translate russian harmony_propose_male_b53ddd66:
    harmony.say "Ты показал мне, что я упускаю жизнь... и все эти члены!"

# ch/harmony/base.rpy:502
translate russian harmony_propose_male_23519e78:
    "В подтверждение своих слов она издаёт особенно развратный смешок."

# ch/harmony/base.rpy:503
translate russian harmony_propose_male_c99b0b6f:
    "Но одновременно обнимает меня за талию."

# ch/harmony/base.rpy:504
translate russian harmony_propose_male_1df6ab52:
    "И заключает в тёплые объятия, прижимаясь ко мне своими пышными формами."

# ch/harmony/base.rpy:505
translate russian harmony_propose_male_407ea49b:
    "Этот жест напоминает, что для Хармони важен не только секс."

# ch/harmony/base.rpy:506
translate russian harmony_propose_male_88c1987a:
    "За всем этим скрывается и настоящая любовь ко мне."

# ch/harmony/base.rpy:507
translate russian harmony_propose_male_b38d3316:
    mike.say "Ну, после свадьбы мы сможем жить в своём темпе, да?"

# ch/harmony/base.rpy:508
translate russian harmony_propose_male_48d8ed75:
    mike.say "Нам уже не придётся ничего никому доказывать."

# ch/harmony/base.rpy:509
translate russian harmony_propose_male_b656f1da:
    mike.say "А то мне кажется, мы слегка разошлись, понимаешь?"

# ch/harmony/base.rpy:511
translate russian harmony_propose_male_3bf29753:
    "Хармони издаёт самый развратный смешок, какой я когда-либо слышал."

# ch/harmony/base.rpy:512
translate russian harmony_propose_male_a5ba5e47:
    "Качает головой и кладёт её мне на плечо."

# ch/harmony/base.rpy:514
translate russian harmony_propose_male_10cb5f44:
    harmony.say "Ха!"

# ch/harmony/base.rpy:515
translate russian harmony_propose_male_811a658b:
    harmony.say "Хорошая шутка, [lssb_harmony.hero_name()]!"

# ch/harmony/base.rpy:517
translate russian harmony_propose_male_ae9a91c4:
    harmony.say "У меня целый список безумств, которые я хочу попробовать!"

# ch/harmony/base.rpy:518
translate russian harmony_propose_male_3d39e3c0:
    harmony.say "И кое-что из этого неженатым парам, по-моему, вообще запрещено!"

# ch/harmony/base.rpy:519
translate russian harmony_propose_male_4c986a52:
    harmony.say "После свадьбы всё это станет нам доступно!"

# ch/harmony/base.rpy:522
translate russian harmony_propose_male_c7a22222:
    "Уже какое-то время рядом с Хармони меня преследует странное чувство."

# ch/harmony/base.rpy:523
translate russian harmony_propose_male_5d9fb47f:
    "Поначалу было трудно понять, в чём дело."

# ch/harmony/base.rpy:524
translate russian harmony_propose_male_974effd5:
    "Вроде бы мы оба счастливы и нам хорошо вместе."

# ch/harmony/base.rpy:525
translate russian harmony_propose_male_651fbd89:
    "Но мне всё казалось, что я о чём-то забыл."

# ch/harmony/base.rpy:526
translate russian harmony_propose_male_6535757c:
    "О чём-то важном, что ускользало всякий раз, когда я пытался вспомнить."

# ch/harmony/base.rpy:527
translate russian harmony_propose_male_2500bef1:
    "А потом меня осенило: я чувствовал, что нам пора перейти на следующий уровень!"

# ch/harmony/base.rpy:529
translate russian harmony_propose_male_6607e660:
    "Да, знаю, знаю..."

# ch/harmony/base.rpy:530
translate russian harmony_propose_male_eade566a:
    "Считается, что парни не думают о более серьёзных отношениях."

# ch/harmony/base.rpy:531
translate russian harmony_propose_male_9408d115:
    "Мы должны содрогаться от одного упоминания долгосрочных обязательств."

# ch/harmony/base.rpy:532
translate russian harmony_propose_male_6e56d002:
    "Но ничего не могу объяснить: я просто так чувствовал."

# ch/harmony/base.rpy:534
translate russian harmony_propose_male_ae4ad464:
    "И знал, что мне нужно как-то выразить эти чувства."

# ch/harmony/base.rpy:535
translate russian harmony_propose_male_ac0ec75c:
    "Что ещё делать парню в таком положении?"

# ch/harmony/base.rpy:536
translate russian harmony_propose_male_380f0bb8:
    "Я залез в сбережения, отправился к местному ювелиру и купил кольцо."

# ch/harmony/base.rpy:537
translate russian harmony_propose_male_a043cc49:
    "И вот теперь жду подходящего момента, чтобы задать главный вопрос..."

# ch/harmony/base.rpy:539
translate russian harmony_propose_male_2524318b:
    harmony.say "...не могу поверить, что мне когда-то так промыли мозги!"

# ch/harmony/base.rpy:540
translate russian harmony_propose_male_296a861a:
    harmony.say "В последнее время я, вообще-то, много читаю о других религиях."

# ch/harmony/base.rpy:541
translate russian harmony_propose_male_09799208:
    harmony.say "И просто поражаюсь, насколько они интересные, понимаешь?"

# ch/harmony/base.rpy:543
translate russian harmony_propose_male_3772b955:
    harmony.say "[lssb_harmony.hero_name()], ты вообще меня сейчас слушаешь?"

# ch/harmony/base.rpy:544
translate russian harmony_propose_male_d1ebaad4:
    harmony.say "П... постой... что ты делаешь?!"

# ch/harmony/base.rpy:546
translate russian harmony_propose_male_fa72aee6:
    "Лицо Хармони, смотрящей на меня сверху вниз, нужно видеть."

# ch/harmony/base.rpy:548
translate russian harmony_propose_male_78b83600:
    "Иначе и не получится: я ведь стою перед ней на колене."

# ch/harmony/base.rpy:549
translate russian harmony_propose_male_63a00697:
    "Пока она не опомнилась, я достаю кольцо."

# ch/harmony/base.rpy:550
translate russian harmony_propose_male_cd815953_1:
    mike.say "Хармони..."

# ch/harmony/base.rpy:551
translate russian harmony_propose_male_26e62cb6:
    mike.say "Я люблю тебя больше всего и всех на свете..."

# ch/harmony/base.rpy:552
translate russian harmony_propose_male_8069cfae_1:
    mike.say "Ты выйдешь за меня?"

# ch/harmony/base.rpy:554
translate russian harmony_propose_male_f60c5209:
    "Внезапно она словно теряет дар речи."

# ch/harmony/base.rpy:555
translate russian harmony_propose_male_c141f403:
    "Прикрывает ладонями уже покрасневшие щёки."

# ch/harmony/base.rpy:556
translate russian harmony_propose_male_75be537a:
    "Моргает, будто не веря своим глазам."

# ch/harmony/base.rpy:559
translate russian harmony_propose_male_96f4a038:
    harmony.say "Я... я..."

# ch/harmony/base.rpy:560
translate russian harmony_propose_male_8d48c2f4:
    harmony.say "Ч... чт... что..."

# ch/harmony/base.rpy:561
translate russian harmony_propose_male_0608a7bb:
    harmony.say "Ох... ох... ох..."

# ch/harmony/base.rpy:563
translate russian harmony_propose_male_725eb42c:
    "Я остаюсь на месте, продолжая смотреть на Хармони снизу вверх."

# ch/harmony/base.rpy:564
translate russian harmony_propose_male_0b633dce:
    "В моём лице — терпение и надежда."

# ch/harmony/base.rpy:565
translate russian harmony_propose_male_3a1396ea:
    "Я просто жду её ответа..."

# ch/harmony/base.rpy:568
translate russian harmony_propose_male_0068f5c9:
    "Вдруг она словно приходит в себя."

# ch/harmony/base.rpy:569
translate russian harmony_propose_male_62ed9b55:
    "Качает головой и берёт меня за руки."

# ch/harmony/base.rpy:570
translate russian harmony_propose_male_d4e52c3a:
    "На мгновение я думаю, что она собирается принять кольцо."

# ch/harmony/base.rpy:571
translate russian harmony_propose_male_e90bf535:
    "Но она лишь помогает мне подняться."

# ch/harmony/base.rpy:573
translate russian harmony_propose_male_af02685e:
    harmony.say "Убери его, [lssb_harmony.hero_name()]!"

# ch/harmony/base.rpy:574
translate russian harmony_propose_male_18dc3aa6:
    harmony.say "Это очень мило с твоей стороны, правда."

# ch/harmony/base.rpy:575
translate russian harmony_propose_male_96d2c2a5:
    harmony.say "Но до этого мы ещё не дошли."

# ch/harmony/base.rpy:577
translate russian harmony_propose_male_896612bd:
    "Я подчиняюсь, скорее от растерянности, чем по иной причине."

# ch/harmony/base.rpy:578
translate russian harmony_propose_male_060dd99e_1:
    "Затем я качаю головой, понемногу приходя в себя."

# ch/harmony/base.rpy:579
translate russian harmony_propose_male_0266ca08_1:
    mike.say "Что ты имеешь в виду, Хармони?"

# ch/harmony/base.rpy:580
translate russian harmony_propose_male_b5fb61ad:
    mike.say "Разве в последнее время у нас не всё замечательно?"

# ch/harmony/base.rpy:581
translate russian harmony_propose_male_a850d1df:
    mike.say "Так почему бы не оформить отношения?"

# ch/harmony/base.rpy:583
translate russian harmony_propose_male_97045e6a:
    "Она улыбается мне и тоже качает головой."

# ch/harmony/base.rpy:585
translate russian harmony_propose_male_9626c2d3:
    harmony.say "Со всем этим я согласна, [lssb_harmony.hero_name()]."

# ch/harmony/base.rpy:586
translate russian harmony_propose_male_71a6207c:
    harmony.say "До того места, где ты попытался надеть на меня кольцо!"

# ch/harmony/base.rpy:588
translate russian harmony_propose_male_b9bdbd35:
    "Хармони вздыхает и пытается объясниться."

# ch/harmony/base.rpy:590
translate russian harmony_propose_male_fe5a293e_1:
    harmony.say "Помнишь, какой я была, когда мы познакомились?"

# ch/harmony/base.rpy:591
translate russian harmony_propose_male_fbfb14e5_1:
    harmony.say "Я так зациклилась на религии, что она управляла всей моей жизнью."

# ch/harmony/base.rpy:592
translate russian harmony_propose_male_9691da80_1:
    harmony.say "Но ты это изменил. Показал, что жизнь не ограничивается этим."

# ch/harmony/base.rpy:594
translate russian harmony_propose_male_0266ca08_2:
    mike.say "Что ты имеешь в виду, Хармони?"

# ch/harmony/base.rpy:595
translate russian harmony_propose_male_1e54ce59_1:
    mike.say "Не хочешь замуж, потому что это связано с религией?"

# ch/harmony/base.rpy:596
translate russian harmony_propose_male_c804c0fb_1:
    mike.say "Можем просто зарегистрировать брак без венчания."

# ch/harmony/base.rpy:598
translate russian harmony_propose_male_21123683_1:
    harmony.say "Нет, [lssb_harmony.hero_name()]..."

# ch/harmony/base.rpy:599
translate russian harmony_propose_male_d9edffbf_1:
    harmony.say "Дело не в этом."

# ch/harmony/base.rpy:600
translate russian harmony_propose_male_48eab8f1:
    harmony.say "Скорее я не хочу торопиться с такими серьёзными обязательствами."

# ch/harmony/base.rpy:601
translate russian harmony_propose_male_f31b8b76:
    harmony.say "Согласна, сейчас всё хорошо. Зачем что-то менять?"

# ch/harmony/base.rpy:603
translate russian harmony_propose_male_d56d898c_1:
    "Я обдумываю её слова и понимаю, что где-то уже такое слышал."

# ch/harmony/base.rpy:604
translate russian harmony_propose_male_87ee803c_1:
    "Ведь это почти стандартный мужской ответ на предложение серьёзных обязательств."

# ch/harmony/base.rpy:605
translate russian harmony_propose_male_7f8d9d72_1:
    "Если сейчас всё хорошо, зачем что-то менять?"

# ch/harmony/base.rpy:606
translate russian harmony_propose_male_9224f095_1:
    mike.say "В этом есть смысл, Хармони!"

# ch/harmony/base.rpy:607
translate russian harmony_propose_male_afade9c0:
    mike.say "Наверное, я сделал предложение, потому что думал, что так положено."

# ch/harmony/base.rpy:608
translate russian harmony_propose_male_6a5f8ed2:
    mike.say "Будто иначе ты сочла бы мои намерения несерьёзными!"

# ch/harmony/base.rpy:610
translate russian harmony_propose_male_eff817d1_1:
    "Она наклоняется и целует меня в щёку."

# ch/harmony/base.rpy:612
translate russian harmony_propose_male_dbbd9dac:
    harmony.say "Дай мне передышку, [lssb_harmony.hero_name()]!"

# ch/harmony/base.rpy:613
translate russian harmony_propose_male_bff3fb01:
    harmony.say "Я ведь совсем недавно начала жить без религиозного помешательства!"

# ch/harmony/base.rpy:615
translate russian harmony_propose_male_a7a2b17d_1:
    "Я невольно улыбаюсь."

# ch/harmony/base.rpy:616
translate russian harmony_propose_male_42467638_1:
    "Да, я хотел услышать другой ответ."

# ch/harmony/base.rpy:617
translate russian harmony_propose_male_43a4f1a3_1:
    "Но теперь чувствую себя счастливее, чем прежде."

# ch/harmony/base.rpy:618
translate russian harmony_propose_male_3dc14d0a_1:
    "А ещё мне кажется, что я гораздо лучше понимаю Хармони!"

# ch/harmony/base.rpy:622
translate russian harmony_propose_male_0068f5c9_1:
    "Вдруг она словно приходит в себя."

# ch/harmony/base.rpy:623
translate russian harmony_propose_male_28c55283:
    "Кивает и берёт меня за руки."

# ch/harmony/base.rpy:624
translate russian harmony_propose_male_4fe81fcb:
    "На миг я пугаюсь, что она не примет кольцо."

# ch/harmony/base.rpy:625
translate russian harmony_propose_male_e90bf535_1:
    "Но она лишь помогает мне подняться."

# ch/harmony/base.rpy:627
translate russian harmony_propose_male_e0a5cb6d_1:
    harmony.say "Конечно, да, [lssb_harmony.hero_name()]!"

# ch/harmony/base.rpy:628
translate russian harmony_propose_male_30e3aa0a:
    harmony.say "Надевай его на меня!"

# ch/harmony/base.rpy:630
translate russian harmony_propose_male_896612bd_1:
    "Я подчиняюсь, скорее от растерянности, чем по иной причине."

# ch/harmony/base.rpy:631
translate russian harmony_propose_male_060dd99e_2:
    "Затем я качаю головой, понемногу приходя в себя."

# ch/harmony/base.rpy:632
translate russian harmony_propose_male_25bc7104_1:
    mike.say "Ты серьёзно, Хармони?"

# ch/harmony/base.rpy:633
translate russian harmony_propose_male_aaee6dae_1:
    mike.say "Ты правда хочешь выйти за меня?!"

# ch/harmony/base.rpy:635
translate russian harmony_propose_male_cc7826c2_2:
    "Она отрывает взгляд от кольца на своём пальце."

# ch/harmony/base.rpy:636
translate russian harmony_propose_male_4a612376_1:
    "И, кажется, мой вопрос её немало озадачивает."

# ch/harmony/base.rpy:638
translate russian harmony_propose_male_562b849f_1:
    harmony.say "Эм... да, [lssb_harmony.hero_name()]!"

# ch/harmony/base.rpy:639
translate russian harmony_propose_male_f02359f0_1:
    harmony.say "Зачем бы ещё я согласилась?"

# ch/harmony/base.rpy:641
translate russian harmony_propose_male_4991aa35_1:
    mike.say "Ну... потому что я... потому что ты..."

# ch/harmony/base.rpy:642
translate russian harmony_propose_male_74c5e851_1:
    mike.say "Да чёрт, Хармони, не знаю!"

# ch/harmony/base.rpy:643
translate russian harmony_propose_male_8188ecf7_1:
    mike.say "Я просто боялся, что ты откажешь, вот и всё!"

# ch/harmony/base.rpy:645
translate russian harmony_propose_male_bdd32268_1:
    "Хармони смеётся надо мной и качает головой."

# ch/harmony/base.rpy:647
translate russian harmony_propose_male_aed1fe61:
    harmony.say "Признаюсь, это было совершенно неожиданно."

# ch/harmony/base.rpy:648
translate russian harmony_propose_male_f2b42aca:
    harmony.say "Но стоило тебе произнести эти слова, как я поняла: всё правильно."

# ch/harmony/base.rpy:649
translate russian harmony_propose_male_1b20088a:
    harmony.say "Я тоже не смогла бы это объяснить!"

# ch/harmony/base.rpy:651
translate russian harmony_propose_male_0056abfa:
    "Прежде чем продолжить, она слегка краснеет."

# ch/harmony/base.rpy:653
translate russian harmony_propose_male_85d179ed_1:
    harmony.say "Ты ведь помнишь, какой я была, правда?"

# ch/harmony/base.rpy:654
translate russian harmony_propose_male_1e3553e3_1:
    harmony.say "Я была одержима религией, это была вся моя жизнь!"

# ch/harmony/base.rpy:655
translate russian harmony_propose_male_de6f8983_1:
    harmony.say "И думала, что так будет всегда. Пока не появился ты!"

# ch/harmony/base.rpy:656
translate russian harmony_propose_male_0e071f6e:
    harmony.say "Ты показал мне, что я упускаю жизнь... и любовь!"

# ch/harmony/base.rpy:657
translate russian harmony_propose_male_2066f585:
    harmony.say "Пока что твои безумные идеи приносили мне только хорошее."

# ch/harmony/base.rpy:659
translate russian harmony_propose_male_eff817d1_2:
    "Она наклоняется и целует меня в щёку."

# ch/harmony/base.rpy:660
translate russian harmony_propose_male_a7a2b17d_2:
    "Я невольно улыбаюсь."

# ch/harmony/base.rpy:661
translate russian harmony_propose_male_82551aa3:
    "Объяснение у неё странноватое и, может, даже немного безумное."

# ch/harmony/base.rpy:662
translate russian harmony_propose_male_706c5512:
    "Но это на сто процентов в духе Хармони!"

# ch/harmony/base.rpy:663
translate russian harmony_propose_male_c342a3dc:
    "И я точно знаю: нас ждёт невероятное приключение!"

# ch/harmony/base.rpy:668
translate russian harmony_propose_male_6b5bbb7b:
    harmony.say "Соединиться перед Богом, [lssb_harmony.hero_name()]. Нет обещания святее, которое могла бы дать душа."

# ch/harmony/base.rpy:669
translate russian harmony_propose_male_29cad58f:
    harmony.say "Я буду тебе верной женой, и весь наш дом останется в Его благодати."

# ch/harmony/base.rpy:672
translate russian harmony_propose_male_5ba3f0bc:
    harmony.say "Ох, сердце так и колотится, [lssb_harmony.hero_name()]. Кажется, мне нужно присесть!"

# ch/harmony/base.rpy:673
translate russian harmony_propose_male_11cb9d13:
    harmony.say "Свадьба. Я мечтала об этом с детства и молилась, чтобы моим избранником стал ты."

# ch/harmony/base.rpy:676
translate russian harmony_propose_male_56f4be11:
    harmony.say "Мой муж. Стоит это произнести, и мне становится жарко в местах, которые нельзя называть, [lssb_harmony.hero_name()]."

# ch/harmony/base.rpy:677
translate russian harmony_propose_male_42941778:
    harmony.say "Прости меня, Господи, но медового месяца я, кажется, жду куда больше самой церемонии."

# ch/harmony/base.rpy:680
translate russian harmony_propose_male_a875689a:
    harmony.say "Мой. Наконец ты по-настоящему мой, [lssb_harmony.hero_name()], и мне совсем не нужно чувствовать себя виноватой."

# ch/harmony/base.rpy:681
translate russian harmony_propose_male_41171699:
    harmony.say "Бог подарил тебя мне, и я намерена занять тебя очень, очень надолго."

# ch/harmony/base.rpy:685
translate russian harmony_propose_male_d950e93b:
    harmony.say "Я твоя, чтобы подчиняться, а теперь и чтобы остаться навсегда, [lssb_harmony.hero_name()]. Другой клятвы мне не нужно."

# ch/harmony/base.rpy:686
translate russian harmony_propose_male_d3605ee8:
    harmony.say "Женись на мне и владей мной. Я буду поклоняться тебе, как Евангелию, от которого отказалась ради тебя."

# ch/harmony/base.rpy:689
translate russian harmony_propose_male_382f86d4:
    harmony.say "Наконец-то. Весь мой, и теперь любая наша грязная шалость — таинство, [lssb_harmony.hero_name()]."

# ch/harmony/base.rpy:690
translate russian harmony_propose_male_11920c4d:
    harmony.say "Это кольцо значит, что никто больше не посмеет прикоснуться к тому, что принадлежит мне."

# ch/harmony/base.rpy:730
translate russian harmony_ask_date_alone_male_033062e0:
    mike.say "Хармони, хочешь пойти со мной на свидание?"

# ch/harmony/base.rpy:732
translate russian harmony_ask_date_alone_male_eb80beb1:
    harmony.say "Прости, [lssb_harmony.hero_name()], но я не вижу в тебе парня для отношений."

# ch/harmony/base.rpy:735
translate russian harmony_ask_date_alone_male_2b350620:
    harmony.say "Конечно, может быть весело. Когда хочешь пойти?"

# ch/harmony/chat.rpy:2
translate russian harmony_desire_0_male_4e11d4fc:
    harmony.say "Скажи, [lssb_harmony.hero_name()], как тебе изучение Библии на этой неделе?"

# ch/harmony/chat.rpy:3
translate russian harmony_desire_0_male_0eac84be:
    harmony.say "Очень хочется узнать, что ты для себя вынес!"

# ch/harmony/chat.rpy:6
translate russian harmony_desire_0_male_839b5b09:
    mike.say "Честно говоря, Хармони, я был поражён."

# ch/harmony/chat.rpy:7
translate russian harmony_desire_0_male_7d1b5b58:
    mike.say "Многое из того, что мы разбирали, оказалось для меня очень осмысленным!"

# ch/harmony/chat.rpy:13
translate russian harmony_desire_0_male_2a608397:
    mike.say "Ох, я старался, Хармони. Честно."

# ch/harmony/chat.rpy:14
translate russian harmony_desire_0_male_01cf5d75:
    mike.say "Но меня ничего не тронуло."

# ch/harmony/chat.rpy:23
translate russian harmony_desire_1_male_61047cc2:
    harmony.say "Должна сказать, [lssb_harmony.hero_name()], я очень впечатлена тем, что ты продолжаешь изучать Библию."

# ch/harmony/chat.rpy:26
translate russian harmony_desire_1_male_9f870752:
    mike.say "Спасибо, Хармони. И спасибо, что приобщила меня к этому."

# ch/harmony/chat.rpy:27
translate russian harmony_desire_1_male_d6fadcb5:
    mike.say "Это даёт мне гораздо больше, чем я мог представить!"

# ch/harmony/chat.rpy:30
translate russian harmony_desire_1_male_1018246a:
    mike.say "Даже не знаю."

# ch/harmony/chat.rpy:31
translate russian harmony_desire_1_male_f86a7823:
    mike.say "Не уверен, что для меня во всём этом есть смысл."

# ch/harmony/chat.rpy:34
translate russian harmony_desire_1_male_24963fca:
    harmony.say "Я так рада, что мы можем просто болтать, [lssb_harmony.hero_name()]."

# ch/harmony/chat.rpy:35
translate russian harmony_desire_1_male_e06472f3:
    harmony.say "Раньше я думала, что для разговора с парнем нужен повод."

# ch/harmony/chat.rpy:36
translate russian harmony_desire_1_male_e0b9a918:
    harmony.say "Будто говорить не об Иисусе или чём-то подобном — грех!"

# ch/harmony/chat.rpy:39
translate russian harmony_desire_1_male_fafcd308:
    mike.say "Жаль, что ты так долго шла к этой мысли, Хармони."

# ch/harmony/chat.rpy:40
translate russian harmony_desire_1_male_a1798196:
    mike.say "С тобой ведь очень интересно разговаривать."

# ch/harmony/chat.rpy:43
translate russian harmony_desire_1_male_e49ab1b3:
    mike.say "Я понимаю тебя, Хармони."

# ch/harmony/chat.rpy:44
translate russian harmony_desire_1_male_43c93dc5:
    mike.say "Но над умением вести беседу тебе ещё нужно поработать!"

# ch/harmony/chat.rpy:50
translate russian harmony_desire_2_male_bd5757fa:
    harmony.say "Так приятно видеть тебя по воскресеньям в церкви, [lssb_harmony.hero_name()]!"

# ch/harmony/chat.rpy:53
translate russian harmony_desire_2_male_4fec1500:
    mike.say "Мне приятно туда приходить, Хармони."

# ch/harmony/chat.rpy:54
translate russian harmony_desire_2_male_5e094ee8:
    mike.say "Раньше я ходил просто по привычке."

# ch/harmony/chat.rpy:55
translate russian harmony_desire_2_male_fad90268:
    mike.say "Но благодаря тебе стал получать от этого гораздо больше!"

# ch/harmony/chat.rpy:58
translate russian harmony_desire_2_male_0acaabc1:
    mike.say "Я рад тебя видеть, Хармони."

# ch/harmony/chat.rpy:59
translate russian harmony_desire_2_male_a9bd4d48:
    mike.say "Но в последнее время религию я соблюдаю только на словах."

# ch/harmony/chat.rpy:62
translate russian harmony_desire_2_male_c5fef519:
    harmony.say "Мне правда кажется, что мы становимся ближе, [lssb_harmony.hero_name()]."

# ch/harmony/chat.rpy:63
translate russian harmony_desire_2_male_821ad55a:
    harmony.say "Ну, словно становимся хорошими друзьями?"

# ch/harmony/chat.rpy:66
translate russian harmony_desire_2_male_379e92a5:
    mike.say "Понимаю, о чём ты, Хармони."

# ch/harmony/chat.rpy:67
translate russian harmony_desire_2_male_a8b68211:
    mike.say "Я всегда с нетерпением жду встречи и времени, которое мы проведём вместе."

# ch/harmony/chat.rpy:70
translate russian harmony_desire_2_male_878c9739:
    mike.say "Это мило, Хармони."

# ch/harmony/chat.rpy:71
translate russian harmony_desire_2_male_955d99ff:
    mike.say "Но мне кажется, мы едва знаем друг друга."

# ch/harmony/chat.rpy:74
translate russian harmony_desire_2_male_1f7177dc:
    mike.say "Ты там сблизилась с кем-нибудь из девушек, Хармони?"

# ch/harmony/chat.rpy:76
translate russian harmony_desire_2_male_c77e9332:
    harmony.say "Есть Лекси. Она такая тёплая и милая, что иногда я ловлю себя на том, что просто смотрю на неё."

# ch/harmony/chat.rpy:77
translate russian harmony_desire_2_male_a8df39e7:
    harmony.say "Грешно так сильно хотеть дружбы, [lssb_harmony.hero_name()]? Это немного похоже на искушение."

# ch/harmony/chat.rpy:80
translate russian harmony_desire_2_male_28c1a133:
    mike.say "Забудь о других девушках, Хармони. Ты должна смотреть только на меня."

# ch/harmony/chat.rpy:81
translate russian harmony_desire_2_male_f0c58f57:
    harmony.say "Ты, конечно, прав. Такие блуждания лишь сбивают девушку с пути."

# ch/harmony/chat.rpy:84
translate russian harmony_desire_2_male_46225a1d:
    harmony.say "Раньше мне просто нравилось видеть тебя в церкви по воскресеньям, [lssb_harmony.hero_name()]."

# ch/harmony/chat.rpy:85
translate russian harmony_desire_2_male_134468b2:
    harmony.say "Но теперь даже стыдно признаться..."

# ch/harmony/chat.rpy:86
translate russian harmony_desire_2_male_50e3181f:
    harmony.say "Я прихожу в церковь чуть ли не только ради встречи с тобой!"

# ch/harmony/chat.rpy:92
translate russian harmony_desire_3_male_155e0570:
    harmony.say "Ох, [lssb_harmony.hero_name()], я так тобой горжусь."

# ch/harmony/chat.rpy:93
translate russian harmony_desire_3_male_c239b073:
    harmony.say "Ты решил идти по пути спасения."

# ch/harmony/chat.rpy:94
translate russian harmony_desire_3_male_c04505db:
    harmony.say "Ты обязательно спасёшь свою душу. Я знаю!"

# ch/harmony/chat.rpy:97
translate russian harmony_desire_3_male_6624aafd:
    mike.say "С тех пор как я посвятил Иисусу свой разум, тело и душу, мне стало гораздо лучше."

# ch/harmony/chat.rpy:98
translate russian harmony_desire_3_male_90505a77:
    mike.say "Но без тебя ничего бы не получилось, Хармони!"

# ch/harmony/chat.rpy:101
translate russian harmony_desire_3_male_3aae4eb2:
    mike.say "Думаю, ты видишь лишь то, что хочешь видеть, Хармони."

# ch/harmony/chat.rpy:102
translate russian harmony_desire_3_male_c3795baf:
    mike.say "Я чувствую себя точно так же, как раньше."

# ch/harmony/chat.rpy:105
translate russian harmony_desire_3_male_e876ffb8:
    harmony.say "Не пойми меня неправильно, [lssb_harmony.hero_name()]."

# ch/harmony/chat.rpy:106
translate russian harmony_desire_3_male_2915bc80:
    harmony.say "Но сейчас я чувствую себя гораздо ближе к тебе, чем при нашей первой встрече."

# ch/harmony/chat.rpy:109
translate russian harmony_desire_3_male_91fb8c87:
    mike.say "Я тоже, Хармони, я тоже."

# ch/harmony/chat.rpy:110
translate russian harmony_desire_3_male_946d84f8:
    mike.say "Будто между нами какая-то особая связь."

# ch/harmony/chat.rpy:113
translate russian harmony_desire_3_male_878c9739:
    mike.say "Это мило, Хармони."

# ch/harmony/chat.rpy:114
translate russian harmony_desire_3_male_955d99ff:
    mike.say "Но мне кажется, мы едва знаем друг друга."

# ch/harmony/chat.rpy:117
translate russian harmony_desire_3_male_6aeb6db2:
    harmony.say "Мы всё время говорим о том, чтобы вместе открывать что-нибудь новое, [lssb_harmony.hero_name()]."

# ch/harmony/chat.rpy:118
translate russian harmony_desire_3_male_66dea7f7:
    harmony.say "Вот я и подумала: может, таким открытием могла бы стать я?"

# ch/harmony/chat.rpy:121
translate russian harmony_desire_3_male_47c65b80:
    mike.say "Я бы с удовольствием тебя исследовал, Хармони."

# ch/harmony/chat.rpy:122
translate russian harmony_desire_3_male_812cd6e2:
    mike.say "Только боюсь, что потеряюсь и больше никогда не захочу, чтобы меня нашли!"

# ch/harmony/chat.rpy:125
translate russian harmony_desire_3_male_da5e2d63:
    mike.say "Пожалуй, не стоит, Хармони."

# ch/harmony/chat.rpy:126
translate russian harmony_desire_3_male_2bb16824:
    mike.say "Некоторым вещам лучше оставаться загадкой."

# ch/harmony/chat.rpy:127
translate russian harmony_desire_3_male_9e3eccb8:
    mike.say "И не без причины!"

# ch/harmony/chat.rpy:130
translate russian harmony_desire_3_male_7a7d401a:
    harmony.say "Прозвучит очень банально, [lssb_harmony.hero_name()]."

# ch/harmony/chat.rpy:131
translate russian harmony_desire_3_male_de25aa43:
    harmony.say "Но знакомство с тобой будто открыло для меня целый новый мир впечатлений!"

# ch/harmony/chat.rpy:134
translate russian harmony_desire_3_male_9a992d7a:
    mike.say "А мне было не менее приятно показывать тебе всё это."

# ch/harmony/chat.rpy:135
translate russian harmony_desire_3_male_c041c54b:
    mike.say "Благодаря тебе я сам открыл это заново, Хармони."

# ch/harmony/chat.rpy:138
translate russian harmony_desire_3_male_d8e3e796:
    mike.say "За тебя я рад, Хармони."

# ch/harmony/chat.rpy:139
translate russian harmony_desire_3_male_3239eb84:
    mike.say "А вот мне досталось всё то же старое дерьмо!"

# ch/harmony/chat.rpy:145
translate russian harmony_desire_4_male_c1ed7efd:
    harmony.say "Ох, [lssb_harmony.hero_name()], я хочу сказать тебе кое-что чудесное!"

# ch/harmony/chat.rpy:146
translate russian harmony_desire_4_male_939c20de:
    harmony.say "Вчера вечером я читала Библию, пытаясь разобраться в своих чувствах к тебе."

# ch/harmony/chat.rpy:147
translate russian harmony_desire_4_male_27b3d17b:
    harmony.say "И вдруг поняла: я люблю тебя самой чистой и святой любовью!"

# ch/harmony/chat.rpy:150
translate russian harmony_desire_4_male_adf489bc:
    mike.say "Ох, Хармони, я чувствую то же самое."

# ch/harmony/chat.rpy:151
translate russian harmony_desire_4_male_de59b035:
    mike.say "И если Библия говорит, что наша любовь освящена Богом, кто я такой, чтобы спорить!"

# ch/harmony/chat.rpy:154
translate russian harmony_desire_4_male_3a1c468f:
    mike.say "Ради всего святого, Хармони, эту книгу написали дикари в каменном веке."

# ch/harmony/chat.rpy:155
translate russian harmony_desire_4_male_83725ffd:
    mike.say "Люди веками оправдывают ею свою чушь!"

# ch/harmony/chat.rpy:158
translate russian harmony_desire_4_male_0b2b7a63:
    harmony.say "Ох, [lssb_harmony.hero_name()]... я... не знаю, как сказать..."

# ch/harmony/chat.rpy:159
translate russian harmony_desire_4_male_befcab07:
    harmony.say "Но я... кажется, влюбляюсь в тебя!"

# ch/harmony/chat.rpy:162
translate russian harmony_desire_4_male_2de36600:
    mike.say "Ого, Хармони, теперь я не знаю, что ответить!"

# ch/harmony/chat.rpy:163
translate russian harmony_desire_4_male_adcb0ee5:
    mike.say "Кажется, я тоже испытываю к тебе такие чувства."

# ch/harmony/chat.rpy:166
translate russian harmony_desire_4_male_3894bec7:
    mike.say "Так влюбляешься или нет, Хармони?"

# ch/harmony/chat.rpy:167
translate russian harmony_desire_4_male_5e11d48a:
    mike.say "Потому что в таких вещах нужно быть уверенной!"

# ch/harmony/chat.rpy:170
translate russian harmony_desire_4_male_39d92159:
    harmony.say "Обожаю, когда ты меня трахаешь, [lssb_harmony.hero_name()]."

# ch/harmony/chat.rpy:171
translate russian harmony_desire_4_male_5292c2d7:
    harmony.say "Но когда ты груб со мной, мне нравится ГОРАЗДО больше!"

# ch/harmony/chat.rpy:174
translate russian harmony_desire_4_male_6e9bc229:
    mike.say "Всё дело в твоих соблазнительных изгибах, Хармони."

# ch/harmony/chat.rpy:175
translate russian harmony_desire_4_male_2a3e5cca:
    mike.say "Они пробуждают во мне желание завоевать тебя."

# ch/harmony/chat.rpy:176
translate russian harmony_desire_4_male_42462dbc:
    mike.say "Водрузить свой флаг как можно глубже!"

# ch/harmony/chat.rpy:179
translate russian harmony_desire_4_male_5825360a:
    mike.say "Правда, Хармони?"

# ch/harmony/chat.rpy:180
translate russian harmony_desire_4_male_128191d2:
    mike.say "В последнее время кажется, что больше ты ни о чём не думаешь."

# ch/harmony/chat.rpy:183
translate russian harmony_desire_4_male_4315a177:
    harmony.say "Я просто хотела сказать, что..."

# ch/harmony/chat.rpy:184
translate russian harmony_desire_4_male_bbe772dc:
    harmony.say "Что я люблю..."

# ch/harmony/chat.rpy:185
translate russian harmony_desire_4_male_a1ee2337:
    harmony.say "Люблю заниматься с тобой сексом, [lssb_harmony.hero_name()]!"

# ch/harmony/chat.rpy:188
translate russian harmony_desire_4_male_b445bdf2:
    mike.say "Это у нас взаимно, Хармони."

# ch/harmony/chat.rpy:189
translate russian harmony_desire_4_male_49e9a1fd:
    mike.say "Ты в этом деле тоже чертовски хороша!"

# ch/harmony/chat.rpy:192
translate russian harmony_desire_4_male_bb81b9ed:
    mike.say "Не может же всё сводиться к сексу, Хармони!"

# ch/harmony/chat.rpy:195
translate russian harmony_desire_4_male_dbeaacbb:
    harmony.say "Я уже давно это чувствую, [lssb_harmony.hero_name()]."

# ch/harmony/chat.rpy:196
translate russian harmony_desire_4_male_0175cf17:
    harmony.say "Но прежде чем говорить, хотела убедиться."

# ch/harmony/chat.rpy:197
translate russian harmony_desire_4_male_227bfe0c:
    harmony.say "Так вот... я... я люблю тебя!"

# ch/harmony/chat.rpy:200
translate russian harmony_desire_4_male_525233a9:
    mike.say "Правда?!"

# ch/harmony/chat.rpy:201
translate russian harmony_desire_4_male_ce920c69:
    mike.say "Хармони, я тоже тебя люблю!"

# ch/harmony/chat.rpy:204
translate russian harmony_desire_4_male_f240c5a0:
    mike.say "Ну, теперь стало неловко, Хармони."

# ch/harmony/chat.rpy:205
translate russian harmony_desire_4_male_f1d8eacc:
    mike.say "Потому что я не могу сказать, что испытываю то же самое!"

# ch/harmony/chat.rpy:211
translate russian harmony_desire_5_male_b4130194:
    harmony.say "Я долго и серьёзно думала об этом, [lssb_harmony.hero_name()]."

# ch/harmony/chat.rpy:212
translate russian harmony_desire_5_male_4365c576:
    harmony.say "Читала Библию и молилась."

# ch/harmony/chat.rpy:213
translate russian harmony_desire_5_male_f0876c48:
    harmony.say "И теперь уверена: ты моя единственная настоящая родственная душа!"

# ch/harmony/chat.rpy:216
translate russian harmony_desire_5_male_74c16120:
    mike.say "Я чувствую к тебе то же самое, Хармони."

# ch/harmony/chat.rpy:217
translate russian harmony_desire_5_male_3676aceb:
    mike.say "Словно Бог создал нас, чтобы мы нашли друг друга!"

# ch/harmony/chat.rpy:220
translate russian harmony_desire_5_male_33fe51f6:
    mike.say "Ты сумасшедшая, Хармони."

# ch/harmony/chat.rpy:221
translate russian harmony_desire_5_male_273757b3:
    mike.say "И хуже всего то, что ты просто прикрываешься словом Божьим!"

# ch/harmony/chat.rpy:224
translate russian harmony_desire_5_male_5645fea2:
    harmony.say "[lssb_harmony.hero_name()], пожалуйста, не пугайся, но мне нужно кое-что тебе сказать."

# ch/harmony/chat.rpy:225
translate russian harmony_desire_5_male_ad5ae689:
    harmony.say "Может, это неожиданно, но, кажется, ты тот самый, кто мне нужен..."

# ch/harmony/chat.rpy:228
translate russian harmony_desire_5_male_9e871199:
    mike.say "Нет, Хармони... всё хорошо."

# ch/harmony/chat.rpy:229
translate russian harmony_desire_5_male_25ffbd35:
    mike.say "Кажется, я тоже начал испытывать к тебе такие чувства."

# ch/harmony/chat.rpy:232
translate russian harmony_desire_5_male_6018d92c:
    mike.say "Знаю, тебе было нелегко признаться, Хармони."

# ch/harmony/chat.rpy:233
translate russian harmony_desire_5_male_eb1ae4c8:
    mike.say "Но я тоже должен быть честен."

# ch/harmony/chat.rpy:234
translate russian harmony_desire_5_male_3c980918:
    mike.say "Мне кажется, мы знакомы недостаточно долго, чтобы быть уверенными в своих чувствах."

# ch/harmony/chat.rpy:237
translate russian harmony_desire_5_male_1a034e12:
    harmony.say "Я влюблена, [lssb_harmony.hero_name()], и жить без него не могу!"

# ch/harmony/chat.rpy:238
translate russian harmony_desire_5_male_8f856558:
    harmony.say "Я по уши влюблена в твой член!"

# ch/harmony/chat.rpy:239
translate russian harmony_desire_5_male_b2d87cab:
    harmony.say "Только с ним внутри я чувствую себя полноценной!"

# ch/harmony/chat.rpy:242
translate russian harmony_desire_5_male_611dc67a:
    mike.say "Твоя киска вызывает во мне то же самое, Хармони!"

# ch/harmony/chat.rpy:243
translate russian harmony_desire_5_male_3834d4bf:
    mike.say "Ему только и хочется, что встать и оказаться в тебе!"

# ch/harmony/chat.rpy:246
translate russian harmony_desire_5_male_a5483acb:
    mike.say "Господи, блядь, Хармони! Я человек, а не кусок мяса!"

# ch/harmony/chat.rpy:247
translate russian harmony_desire_5_male_3445ae52:
    mike.say "Когда ты превратилась в такую жадную до членов шлюху?!"

# ch/harmony/chat.rpy:250
translate russian harmony_desire_5_male_74e177aa:
    harmony.say "Думаю, я люблю тебя, [lssb_harmony.hero_name()]."

# ch/harmony/chat.rpy:251
translate russian harmony_desire_5_male_9f68fc67:
    harmony.say "Но я ТОЧНО знаю, что люблю, когда ты занимаешься со мной любовью!"

# ch/harmony/chat.rpy:254
translate russian harmony_desire_5_male_d4cfb2b9:
    mike.say "У нас лучшее из обоих миров, Хармони."

# ch/harmony/chat.rpy:255
translate russian harmony_desire_5_male_6761617f:
    mike.say "Мы любим друг друга и любим заниматься любовью!"

# ch/harmony/chat.rpy:258
translate russian harmony_desire_5_male_bbe50372:
    mike.say "Хм... С тобой весело, Хармони."

# ch/harmony/chat.rpy:259
translate russian harmony_desire_5_male_01b06ae9:
    mike.say "Но иногда я не уверен, любишь ты меня или только секс..."

# ch/harmony/chat.rpy:262
translate russian harmony_desire_5_male_d2b4095d:
    harmony.say "Мне кажется, с тобой я могу говорить прямо и честно, [lssb_harmony.hero_name()]."

# ch/harmony/chat.rpy:263
translate russian harmony_desire_5_male_0e406eb9:
    harmony.say "Так что скажу без обиняков: думаю, я хочу провести с тобой всю жизнь..."

# ch/harmony/chat.rpy:266
translate russian harmony_desire_5_male_55cfec6f:
    mike.say "Можешь, Хармони. И то и другое."

# ch/harmony/chat.rpy:267
translate russian harmony_desire_5_male_26f2cc9a:
    mike.say "Я тоже хочу провести с тобой жизнь."

# ch/harmony/chat.rpy:270
translate russian harmony_desire_5_male_6b4d4769:
    mike.say "Ценю твою честность, Хармони."

# ch/harmony/chat.rpy:271
translate russian harmony_desire_5_male_e6996039:
    mike.say "Поэтому буду так же честен в ответ."

# ch/harmony/chat.rpy:272
translate russian harmony_desire_5_male_30f39d43:
    mike.say "Возможно, ты и чувствуешь это ко мне, но я пока не могу ответить тем же."

# ch/harmony/chat.rpy:278
translate russian harmony_love_0_male_b15e98df:
    harmony.say "Скажи, [lssb_harmony.hero_name()], что ты думаешь о Боге?"

# ch/harmony/chat.rpy:279
translate russian harmony_love_0_male_08d2cf1f:
    harmony.say "Я могла бы свидетельствовать о Его любви с рассвета до заката и ни разу не устать!"

# ch/harmony/chat.rpy:281
translate russian harmony_love_0_male_b15e98df_1:
    harmony.say "Скажи, [lssb_harmony.hero_name()], что ты думаешь о Боге?"

# ch/harmony/chat.rpy:282
translate russian harmony_love_0_male_75fcf4f8:
    harmony.say "Моя вера — самое истинное, что у меня есть, и больше всего мне хочется поделиться с тобой именно ею."

# ch/harmony/chat.rpy:284
translate russian harmony_love_0_male_b15e98df_2:
    harmony.say "Скажи, [lssb_harmony.hero_name()], что ты думаешь о Боге?"

# ch/harmony/chat.rpy:285
translate russian harmony_love_0_male_2defb82a:
    harmony.say "Я по-прежнему молюсь каждый вечер, честно. Только в последнее время мысли уносятся к... другим вещам."

# ch/harmony/chat.rpy:287
translate russian harmony_love_0_male_b15e98df_3:
    harmony.say "Скажи, [lssb_harmony.hero_name()], что ты думаешь о Боге?"

# ch/harmony/chat.rpy:288
translate russian harmony_love_0_male_e66ec466:
    harmony.say "Я всё ещё верю, обещаю. Просто теперь у моих молитв привкус вины. И желания."

# ch/harmony/chat.rpy:292
translate russian harmony_love_0_male_91a4ca8e:
    harmony.say "Бог? Ох, [lssb_harmony.hero_name()], ты давно занял Его место."

# ch/harmony/chat.rpy:293
translate russian harmony_love_0_male_9b81d7f5:
    harmony.say "Я преклоняю колени перед тобой. Исповедуюсь тебе. Живу, чтобы ты мной пользовался. Другого поклонения во мне не осталось."

# ch/harmony/chat.rpy:295
translate russian harmony_love_0_male_a7787076:
    harmony.say "Бог? Честно говоря, [lssb_harmony.hero_name()], по-моему, ты уже давно заменил Его для меня."

# ch/harmony/chat.rpy:296
translate russian harmony_love_0_male_2e10a032:
    harmony.say "Теперь я встаю на колени только перед тобой и ничуть об этом не жалею."

# ch/harmony/chat.rpy:299
translate russian harmony_love_0_male_96071808:
    mike.say "Я верю в Бога, но не чувствую личной связи с Ним."

# ch/harmony/chat.rpy:302
translate russian harmony_love_0_male_21d61dd4:
    mike.say "Честно говоря, не знаю, верю ли я в Бога..."

# ch/harmony/chat.rpy:304
translate russian harmony_love_0_male_a22ba89c:
    mike.say "Да, я подпеваю в церкви и всё такое, но, скорее всего, Бога просто выдумали."

# ch/harmony/chat.rpy:310
translate russian harmony_love_1_male_60616158:
    harmony.say "Знаешь, [lssb_harmony.hero_name()], было бы здорово видеть тебя в церкви КАЖДОЕ воскресенье."

# ch/harmony/chat.rpy:313
translate russian harmony_love_1_male_9a15c2bf:
    mike.say "Ну, когда я прихожу, это действительно многое мне даёт."

# ch/harmony/chat.rpy:314
translate russian harmony_love_1_male_5e903e8a:
    mike.say "Может, стоит постараться ходить регулярно."

# ch/harmony/chat.rpy:317
translate russian harmony_love_1_male_a3f8c9f7:
    mike.say "Не знаю, Хармони."

# ch/harmony/chat.rpy:318
translate russian harmony_love_1_male_26e0934e:
    mike.say "У меня сейчас и так жизнь суматошная."

# ch/harmony/chat.rpy:319
translate russian harmony_love_1_male_91ea00a9:
    mike.say "Лишние хлопоты мне совсем ни к чему."

# ch/harmony/chat.rpy:322
translate russian harmony_love_1_male_002c9bfe:
    harmony.say "Знаешь, раньше я хотела чаще видеть тебя в церкви."

# ch/harmony/chat.rpy:323
translate russian harmony_love_1_male_8b19ccb4:
    harmony.say "Но в последнее время всё больше радуюсь встрече с тобой где угодно!"

# ch/harmony/chat.rpy:326
translate russian harmony_love_1_male_1d6c5f3e:
    mike.say "Прекрасно понимаю, Хармони."

# ch/harmony/chat.rpy:327
translate russian harmony_love_1_male_345b1f18:
    mike.say "Бывало, приду в церковь, а тебя нет — и мне уже ничего не интересно!"

# ch/harmony/chat.rpy:330
translate russian harmony_love_1_male_d2096289:
    mike.say "Ого, Хармони. Просто ого!"

# ch/harmony/chat.rpy:331
translate russian harmony_love_1_male_141ed562:
    mike.say "Звучит так, будто ты ходила в церковь только ради знакомства с парнями..."

# ch/harmony/chat.rpy:337
translate russian harmony_love_2_male_ec5f6e18:
    harmony.say "Приятно видеть тебя в церкви и на изучении Библии, [lssb_harmony.hero_name()]."

# ch/harmony/chat.rpy:338
translate russian harmony_love_2_male_89cab1ef:
    harmony.say "Но ты не думал провести время вместе за... не знаю, чем-нибудь ещё?"

# ch/harmony/chat.rpy:341
translate russian harmony_love_2_male_5f7583cf:
    mike.say "Мне очень нравится проводить с тобой время, Хармони."

# ch/harmony/chat.rpy:342
translate russian harmony_love_2_male_d25af8cb:
    mike.say "Но я бы солгал, сказав, что всё это время думаю только об Иисусе."

# ch/harmony/chat.rpy:343
translate russian harmony_love_2_male_823cd97e:
    mike.say "Стыдно признаться, но иногда я думаю о других занятиях... с тобой!"

# ch/harmony/chat.rpy:346
translate russian harmony_love_2_male_e7ab181f:
    mike.say "Хармони, тебе должно быть стыдно!"

# ch/harmony/chat.rpy:347
translate russian harmony_love_2_male_4ece837d:
    mike.say "А я всё это время считал, что ты размышляешь о Боге."

# ch/harmony/chat.rpy:348
translate russian harmony_love_2_male_a5a6de20:
    mike.say "Хотя на самом деле ты позволяла себе поддаваться искушению!"

# ch/harmony/chat.rpy:351
translate russian harmony_love_2_male_d7fd9958:
    harmony.say "Как думаешь, мы могли бы проводить время вместе и вне церкви, [lssb_harmony.hero_name()]?"

# ch/harmony/chat.rpy:352
translate russian harmony_love_2_male_85869282:
    harmony.say "Ну, не знаю... может, поужинать в хорошем ресторане?"

# ch/harmony/chat.rpy:355
translate russian harmony_love_2_male_d2ebeb0f:
    mike.say "Ты права, Хармони. Не верится, что я сам не додумался!"

# ch/harmony/chat.rpy:356
translate russian harmony_love_2_male_310e509e:
    mike.say "Я бы с радостью узнал о тебе больше, чем можно узнать в церкви..."

# ch/harmony/chat.rpy:359
translate russian harmony_love_2_male_ce3736b9:
    mike.say "Из всего, что можно было предложить, ты выбрала еду в ресторане?"

# ch/harmony/chat.rpy:360
translate russian harmony_love_2_male_4f550284:
    mike.say "По-моему, откармливаться тебе нужно в ПОСЛЕДНЮЮ очередь, Хармони!"

# ch/harmony/chat.rpy:363
translate russian harmony_love_2_male_135055d1:
    harmony.say "Мне хочется попробовать то, чем занимаются обычные люди, [lssb_harmony.hero_name()]."

# ch/harmony/chat.rpy:364
translate russian harmony_love_2_male_894fa399:
    harmony.say "Может, как-нибудь скоро сводишь меня на пляж?"

# ch/harmony/chat.rpy:367
translate russian harmony_love_2_male_90b7a423:
    mike.say "Отличная идея, Хармони!"

# ch/harmony/chat.rpy:368
translate russian harmony_love_2_male_f128cba3:
    mike.say "Уверен, в купальнике ты выглядишь потрясающе..."

# ch/harmony/chat.rpy:371
translate russian harmony_love_2_male_b808b0be:
    mike.say "Серьёзно, на пляж?!"

# ch/harmony/chat.rpy:372
translate russian harmony_love_2_male_8891a568:
    mike.say "Не боишься, что тебя примут за выбросившегося на берег кита и покатят обратно в море?"

# ch/harmony/chat.rpy:378
translate russian harmony_love_3_male_a55d15ef:
    harmony.say "[lssb_harmony.hero_name()], мне очень хочется узнать тебя лучше."

# ch/harmony/chat.rpy:379
translate russian harmony_love_3_male_a5da79f4:
    harmony.say "Хочется узнать твою душу..."

# ch/harmony/chat.rpy:382
translate russian harmony_love_3_male_9fff6cb0:
    mike.say "Я чувствую то же самое, Хармони."

# ch/harmony/chat.rpy:383
translate russian harmony_love_3_male_3527721c:
    mike.say "Если мы узнаем души друг друга, между нами не останется никаких тайн!"

# ch/harmony/chat.rpy:386
translate russian harmony_love_3_male_99416797:
    mike.say "Боже, Хармони, не уверен, что хочу, чтобы кто-то знал меня настолько глубоко."

# ch/harmony/chat.rpy:387
translate russian harmony_love_3_male_7c26da60:
    mike.say "Даже я сам!"

# ch/harmony/chat.rpy:390
translate russian harmony_love_3_male_4ddcb673:
    harmony.say "Знаешь, [lssb_harmony.hero_name()], мне хочется узнать тебя получше."

# ch/harmony/chat.rpy:393
translate russian harmony_love_3_male_c21506a6:
    mike.say "Понимаю, о чём ты, Хармони."

# ch/harmony/chat.rpy:394
translate russian harmony_love_3_male_e88d7ebd:
    mike.say "Мы проводим вместе столько времени, но почти никогда не говорим о себе."

# ch/harmony/chat.rpy:397
translate russian harmony_love_3_male_e5a9af92:
    mike.say "Почему сейчас все такие? Вечно хотят разрушать границы и делиться сокровенным."

# ch/harmony/chat.rpy:398
translate russian harmony_love_3_male_1a43f8cd:
    mike.say "Жизнь гораздо проще, когда всё аккуратно разложено по полочкам!"

# ch/harmony/chat.rpy:401
translate russian harmony_love_3_male_18b3c90a:
    harmony.say "Знаешь что, [lssb_harmony.hero_name()]? Думаю, нам нужно узнать друг друга получше."

# ch/harmony/chat.rpy:402
translate russian harmony_love_3_male_c455fe42:
    harmony.say "Точнее, познать друг друга в самом буквальном смысле..."

# ch/harmony/chat.rpy:405
translate russian harmony_love_3_male_fc02fcfe:
    mike.say "Ух ты, Хармони! Я так давно ждал этих слов!"

# ch/harmony/chat.rpy:406
translate russian harmony_love_3_male_5f5ef9c9:
    mike.say "Хочу познать каждый сантиметр твоего тела..."

# ch/harmony/chat.rpy:409
translate russian harmony_love_3_male_987b6210:
    mike.say "Ох... Заманчивое предложение, Хармони."

# ch/harmony/chat.rpy:410
translate russian harmony_love_3_male_b85d4284:
    mike.say "Но тебя так много, что на исследование, боюсь, уйдёт целая жизнь!"

# ch/harmony/chat.rpy:413
translate russian harmony_love_3_male_03fbebbe:
    harmony.say "Думаю, нам было бы полезно узнать друг друга получше."

# ch/harmony/chat.rpy:414
translate russian harmony_love_3_male_e59952b0:
    harmony.say "Выяснить, что у нас на самом деле общего..."

# ch/harmony/chat.rpy:417
translate russian harmony_love_3_male_5d85af4e:
    mike.say "Ты права, так и стоит поступить."

# ch/harmony/chat.rpy:418
translate russian harmony_love_3_male_11ba4178:
    mike.say "Мы уже так сблизились, что как друзья просто обязаны это сделать."

# ch/harmony/chat.rpy:421
translate russian harmony_love_3_male_f667f01f:
    mike.say "По-моему, у нас и сейчас вполне хорошие отношения, Хармони."

# ch/harmony/chat.rpy:422
translate russian harmony_love_3_male_e2115219:
    mike.say "Уверена, что хочешь рисковать ими, делясь самыми мрачными и сокровенными тайнами?"

# ch/harmony/chat.rpy:428
translate russian harmony_love_4_male_508ed790:
    harmony.say "Должна сказать, [lssb_harmony.hero_name()], я ещё никогда не встречала никого похожего на тебя."

# ch/harmony/chat.rpy:429
translate russian harmony_love_4_male_762826d4:
    harmony.say "И я так счастлива, что помогла тебе прийти к Богу!"

# ch/harmony/chat.rpy:432
translate russian harmony_love_4_male_78a33cb9:
    mike.say "Без тебя ничего бы не получилось, Хармони."

# ch/harmony/chat.rpy:433
translate russian harmony_love_4_male_2e0374eb:
    mike.say "Я и правда был заблудшей овцой, пока ты не появилась и не нашла меня!"

# ch/harmony/chat.rpy:436
translate russian harmony_love_4_male_ac5444a6:
    mike.say "Хм... Кажется, ты пытаешься приписать себе заслугу в том, что я обрёл Бога, Хармони!"

# ch/harmony/chat.rpy:439
translate russian harmony_love_4_male_4980aaec:
    harmony.say "От одной этой мысли чувствую себя героиней дешёвого фильма, но всё равно это правда."

# ch/harmony/chat.rpy:440
translate russian harmony_love_4_male_f5681170:
    harmony.say "Кажется, я никогда не встречала такого человека, как ты, [lssb_harmony.hero_name()]..."

# ch/harmony/chat.rpy:443
translate russian harmony_love_4_male_e08ad5aa:
    mike.say "Наверное, иногда голливудские клише сбываются, Хармони."

# ch/harmony/chat.rpy:444
translate russian harmony_love_4_male_bbaaadf0:
    mike.say "Потому что я думаю о тебе то же самое!"

# ch/harmony/chat.rpy:447
translate russian harmony_love_4_male_b0e74826:
    mike.say "Кажется, у этого фильма неожиданный поворот, Хармони."

# ch/harmony/chat.rpy:448
translate russian harmony_love_4_male_6141bf9c:
    mike.say "Потому что я совсем не чувствую того же!"

# ch/harmony/chat.rpy:451
translate russian harmony_love_4_male_5a87cdf5:
    harmony.say "О боже, как же я люблю, когда ты меня трахаешь, [lssb_harmony.hero_name()]!"

# ch/harmony/chat.rpy:452
translate russian harmony_love_4_male_85db4826:
    harmony.say "Когда ты во мне, я не могу ясно мыслить."

# ch/harmony/chat.rpy:453
translate russian harmony_love_4_male_cb3a7787:
    harmony.say "А когда нет, думаю только о том, когда ты снова окажешься внутри!"

# ch/harmony/chat.rpy:456
translate russian harmony_love_4_male_488990a1:
    mike.say "Думаешь, я могу думать о чём-то другом, когда не трахаю тебя?"

# ch/harmony/chat.rpy:457
translate russian harmony_love_4_male_7b5a1db2:
    mike.say "Лучше воспоминания о том, как я был в тебе, только снова оказаться внутри!"

# ch/harmony/chat.rpy:460
translate russian harmony_love_4_male_34373e67:
    mike.say "Честно говоря, Хармони, я даже не помню ощущений от нашего секса."

# ch/harmony/chat.rpy:461
translate russian harmony_love_4_male_b3a06e1e:
    mike.say "Большую часть времени я в ужасе боюсь, что ты перевернёшься и раздавишь меня насмерть!"

# ch/harmony/chat.rpy:464
translate russian harmony_love_4_male_c151bc82:
    harmony.say "Мне немного неловко это говорить, [lssb_harmony.hero_name()]."

# ch/harmony/chat.rpy:465
translate russian harmony_love_4_male_20adcb93:
    harmony.say "Но я ТАК счастлива быть твоей девушкой!"

# ch/harmony/chat.rpy:468
translate russian harmony_love_4_male_aa3de7ad:
    mike.say "Наверное, потому, что ты делаешь меня таким же счастливым, Хармони!"

# ch/harmony/chat.rpy:469
translate russian harmony_love_4_male_95a8b0fc:
    mike.say "Всякий раз, вспоминая, что ты моя, я чувствую себя везунчиком."

# ch/harmony/chat.rpy:472
translate russian harmony_love_4_male_322e306a:
    mike.say "Ну, думаю, это естественно, Хармони."

# ch/harmony/chat.rpy:473
translate russian harmony_love_4_male_80f80a76:
    mike.say "Тебе действительно стоит быть благодарной за такого парня, как я!"

# ch/harmony/chat.rpy:476
translate russian harmony_love_4_male_507a43f9:
    harmony.say "Я уже говорила, как счастлива, что мы стали больше чем просто хорошими друзьями?"

# ch/harmony/chat.rpy:477
translate russian harmony_love_4_male_ae645ff6:
    harmony.say "Так рада называть тебя своим парнем, [lssb_harmony.hero_name()]!"

# ch/harmony/chat.rpy:480
translate russian harmony_love_4_male_714f72b7:
    mike.say "Ты была отличной подругой, Хармони."

# ch/harmony/chat.rpy:481
translate russian harmony_love_4_male_7101ea15:
    mike.say "Но девушка из тебя ещё лучше."

# ch/harmony/chat.rpy:484
translate russian harmony_love_4_male_aea5f5c1:
    mike.say "Да, знаю..."

# ch/harmony/chat.rpy:485
translate russian harmony_love_4_male_241b5510:
    mike.say "Но как же хорошо мы проводили время, когда были просто друзьями!"

# ch/harmony/chat.rpy:491
translate russian harmony_love_5_male_b3217220:
    harmony.say "Кажется, я знаю тебя, [lssb_harmony.hero_name()]: твоё тело, разум и душу."

# ch/harmony/chat.rpy:492
translate russian harmony_love_5_male_14606fd1:
    harmony.say "Если однажды ты сделаешь мне предложение, думаю, я соглашусь!"

# ch/harmony/chat.rpy:495
translate russian harmony_love_5_male_fa20b5a8:
    mike.say "Ох, Хармони!"

# ch/harmony/chat.rpy:496
translate russian harmony_love_5_male_97635468:
    mike.say "Даст Бог, этот день настанет совсем скоро!"

# ch/harmony/chat.rpy:499
translate russian harmony_love_5_male_25cf9762:
    mike.say "Ну да... я бы на твоём месте особо не ждал!"

# ch/harmony/chat.rpy:502
translate russian harmony_love_5_male_d12db303:
    harmony.say "Думаю, из тебя получится отличный отец, [lssb_harmony.hero_name()]."

# ch/harmony/chat.rpy:503
translate russian harmony_love_5_male_f1c531e6:
    harmony.say "Было бы чудесно создать с тобой семью, когда придёт время..."

# ch/harmony/chat.rpy:506
translate russian harmony_love_5_male_f3029809:
    mike.say "Очень надеюсь, что оно придёт скоро, Хармони."

# ch/harmony/chat.rpy:509
translate russian harmony_love_5_male_aa4c0ce6:
    mike.say "Эм... возможно, оно придёт как раз после дождичка в четверг!"

# ch/harmony/chat.rpy:513
translate russian harmony_love_5_male_4036e990:
    harmony.say "Мне больше незачем это отрицать, [lssb_harmony.hero_name()]."

# ch/harmony/chat.rpy:514
translate russian harmony_love_5_male_5d400441:
    harmony.say "Я твоя игрушка для секса и рабыня. Поклонение тебе теперь вся моя вера."

# ch/harmony/chat.rpy:515
translate russian harmony_love_5_male_70d0153e:
    harmony.say "Пользуйся мной когда, где и как пожелаешь. Я молюсь лишь о том, чтобы ты владел мной."

# ch/harmony/chat.rpy:517
translate russian harmony_love_5_male_b10df15e:
    harmony.say "А, к чёрту, [lssb_harmony.hero_name()]! Больше не могу отрицать."

# ch/harmony/chat.rpy:518
translate russian harmony_love_5_male_a5953945:
    harmony.say "Я хочу лишь быть твоей игрушкой для секса!"

# ch/harmony/chat.rpy:519
translate russian harmony_love_5_male_ba222136:
    harmony.say "Хочу, чтобы ты пользовался мной когда, где и как пожелаешь!"

# ch/harmony/chat.rpy:520
translate russian harmony_love_5_male_bdac9cef:
    harmony.say "Прости меня, Господи, но щёки всё ещё горят каждый раз, когда я произношу это вслух."

# ch/harmony/chat.rpy:523
translate russian harmony_love_5_male_6b7636a0:
    mike.say "Если ты этого хочешь, Хармони..."

# ch/harmony/chat.rpy:524
translate russian harmony_love_5_male_eb6add34:
    mike.say "А у меня полная голова идей о том, как тобой пользоваться!"

# ch/harmony/chat.rpy:527
translate russian harmony_love_5_male_187f77a5:
    mike.say "Уф... Ты и правда опустилась ещё ниже, да?"

# ch/harmony/chat.rpy:528
translate russian harmony_love_5_male_8b185e95:
    mike.say "Что же произошло, что ты стала такой развратной шлюхой?"

# ch/harmony/chat.rpy:532
translate russian harmony_love_5_male_0cad0c14:
    harmony.say "Чувствуешь, [lssb_harmony.hero_name()]? Твой малыш растёт здесь, внутри меня."

# ch/harmony/chat.rpy:533
translate russian harmony_love_5_male_4945a9c4:
    harmony.say "Раньше я считала беременность вне брака самым страшным грехом."

# ch/harmony/chat.rpy:534
translate russian harmony_love_5_male_1b33b9e1:
    harmony.say "Теперь я знаю лучше. Это Божий замысел, и Он выбрал тебя, чтобы ты наполнил меня."

# ch/harmony/chat.rpy:537
translate russian harmony_love_5_male_5b671dc8:
    mike.say "Ты никогда не была так прекрасна, как сейчас, Хармони."

# ch/harmony/chat.rpy:540
translate russian harmony_love_5_male_b990e700:
    mike.say "Давай не будем забегать вперёд, Хармони."

# ch/harmony/chat.rpy:543
translate russian harmony_love_5_male_691cfadc:
    harmony.say "Думаю, мы готовы к следующему шагу в отношениях, [lssb_harmony.hero_name()]."

# ch/harmony/chat.rpy:544
translate russian harmony_love_5_male_d092c1b9:
    harmony.say "Как насчёт того, чтобы съехаться?"

# ch/harmony/chat.rpy:547
translate russian harmony_love_5_male_a639f1bc:
    mike.say "Я в восторге, Хармони!"

# ch/harmony/chat.rpy:548
translate russian harmony_love_5_male_8fca0c1b:
    mike.say "Как скоро сможешь собрать вещи?"

# ch/harmony/chat.rpy:551
translate russian harmony_love_5_male_3cf72911:
    mike.say "Не уверен, что готов, Хармони."

# ch/harmony/chat.rpy:552
translate russian harmony_love_5_male_3c673803:
    mike.say "Просто не знаю, выдержит ли моя кровать."

# ch/harmony/chat.rpy:553
translate russian harmony_love_5_male_9c45440e:
    mike.say "Или половицы!"

# ch/harmony/chat.rpy:556
translate russian harmony_love_5_male_6d250a9f:
    harmony.say "По-моему, мы неплохо подходим друг другу, [lssb_harmony.hero_name()]."

# ch/harmony/chat.rpy:557
translate russian harmony_love_5_male_7e085f17:
    harmony.say "Может, объявим себя парой и будем встречаться всерьёз?"

# ch/harmony/chat.rpy:560
translate russian harmony_love_5_male_d9232790:
    mike.say "Мне кажется, мы и так уже пара, Хармони!"

# ch/harmony/chat.rpy:561
translate russian harmony_love_5_male_7e457303:
    mike.say "Так что почему бы и нет."

# ch/harmony/chat.rpy:564
translate russian harmony_love_5_male_856bdb63:
    mike.say "Ох, не знаю, Хармони..."

# ch/harmony/chat.rpy:565
translate russian harmony_love_5_male_5cb7f848:
    mike.say "Похоже, после этого всё начнёт набирать обороты."

# ch/harmony/chat.rpy:566
translate russian harmony_love_5_male_183cc795:
    mike.say "А я боюсь в итоге оказаться раздавленным, если понимаешь, о чём я."

# ch/harmony/chat.rpy:573
translate russian harmony_good_sweet_talk_male_c0109ff2:
    mike.say "Ты такая ГОРЯЧАЯ, Хармони!"

# ch/harmony/chat.rpy:574
translate russian harmony_good_sweet_talk_male_3a7abf30:
    mike.say "Не могу перестать думать о том, что хочу сделать с тобой дальше!"

# ch/harmony/chat.rpy:576
translate russian harmony_good_sweet_talk_male_f46a4d40:
    mike.say "Мне нравится, как ты выглядишь, Хармони."

# ch/harmony/chat.rpy:577
translate russian harmony_good_sweet_talk_male_4c14d1b6:
    mike.say "Сразу видно, какая у тебя красивая фигура."

# ch/harmony/chat.rpy:579
translate russian harmony_good_sweet_talk_male_6cc4a26b:
    mike.say "Здорово проводить с тобой время вне церкви, Хармони."

# ch/harmony/chat.rpy:580
translate russian harmony_good_sweet_talk_male_e5a9c8e7:
    mike.say "Так я могу узнать тебя настоящую."

# ch/harmony/chat.rpy:583
translate russian harmony_good_sweet_talk_male_a56e251a:
    harmony.say "Ох! Тебе не стоит говорить такие вещи, [lssb_harmony.hero_name()]."

# ch/harmony/chat.rpy:584
translate russian harmony_good_sweet_talk_male_9576ef25:
    harmony.say "Лесть — тоже искушение, знаешь ли. А искушение привело к первородному греху!"

# ch/harmony/chat.rpy:586
translate russian harmony_good_sweet_talk_male_d5b3737c:
    harmony.say "Тс-с... Нас могут услышать!"

# ch/harmony/chat.rpy:587
translate russian harmony_good_sweet_talk_male_2ce05c48:
    harmony.say "Знаю, что не должна предаваться гордыне или похоти, но мне так приятно это слышать!"

# ch/harmony/chat.rpy:589
translate russian harmony_good_sweet_talk_male_64324003:
    harmony.say "Боже мой, [lssb_harmony.hero_name()]. Из-за тебя так трудно сосредоточиться на молитвах."

# ch/harmony/chat.rpy:590
translate russian harmony_good_sweet_talk_male_9e190b1c:
    harmony.say "Всё велю себе отвести взгляд — и всё никак не отвожу."

# ch/harmony/chat.rpy:592
translate russian harmony_good_sweet_talk_male_958ebbf6:
    harmony.say "Продолжай в том же духе, [lssb_harmony.hero_name()], и, прости меня Господи, мне не захочется тебя останавливать."

# ch/harmony/chat.rpy:593
translate russian harmony_good_sweet_talk_male_22286a83:
    harmony.say "Раньше я краснела от комплимента. Теперь хочу услышать все твои самые грязные слова."

# ch/harmony/chat.rpy:596
translate russian harmony_good_sweet_talk_male_3b266c8a:
    harmony.say "М-м-м, скажи ещё, [lssb_harmony.hero_name()]. Скажи, кто я для тебя."

# ch/harmony/chat.rpy:597
translate russian harmony_good_sweet_talk_male_0b27c7ce:
    harmony.say "Хвали меня, пользуйся мной, владей мной. Твой голос — единственное Писание, которое мне теперь нужно."

# ch/harmony/chat.rpy:599
translate russian harmony_good_sweet_talk_male_a93d22af:
    harmony.say "Не останавливайся, [lssb_harmony.hero_name()]. Я могла бы упиваться твоими словами целый день."

# ch/harmony/chat.rpy:600
translate russian harmony_good_sweet_talk_male_91ae9a85:
    harmony.say "Скажи что-нибудь погрязнее. Я давно перестала притворяться, что мне это не нравится."

# ch/harmony/chat.rpy:606
translate russian harmony_bad_sweet_talk_male_8c527ba4:
    mike.say "Я знал, что ты никогда не верила во все эти религиозные штуки, Хармони."

# ch/harmony/chat.rpy:607
translate russian harmony_bad_sweet_talk_male_e6dc413d:
    mike.say "По-настоящему!"

# ch/harmony/chat.rpy:610
translate russian harmony_bad_sweet_talk_male_4474056e:
    harmony.say "Эй!"

# ch/harmony/chat.rpy:611
translate russian harmony_bad_sweet_talk_male_61bfc22a:
    harmony.say "Ты называешь меня лицемеркой?"

# ch/harmony/chat.rpy:612
translate russian harmony_bad_sweet_talk_male_09520c79:
    harmony.say "Лгуньей?!"

# ch/harmony/chat.rpy:613
translate russian harmony_bad_sweet_talk_male_84323405:
    harmony.say "Моя вера — самое истинное во мне, и я не позволю тебе над ней насмехаться!"

# ch/harmony/chat.rpy:614
translate russian harmony_bad_sweet_talk_male_75a7f64e:
    mike.say "Эм, нет... не совсем!"

# ch/harmony/chat.rpy:617
translate russian harmony_bad_sweet_talk_male_4474056e_1:
    harmony.say "Эй!"

# ch/harmony/chat.rpy:618
translate russian harmony_bad_sweet_talk_male_61bfc22a_1:
    harmony.say "Ты называешь меня лицемеркой?"

# ch/harmony/chat.rpy:619
translate russian harmony_bad_sweet_talk_male_09520c79_1:
    harmony.say "Лгуньей?!"

# ch/harmony/chat.rpy:620
translate russian harmony_bad_sweet_talk_male_75a7f64e_1:
    mike.say "Эм, нет... не совсем!"

# ch/harmony/chat.rpy:623
translate russian harmony_bad_sweet_talk_male_6bc2f8dc:
    harmony.say "Это... это несправедливо, [lssb_harmony.hero_name()]."

# ch/harmony/chat.rpy:624
translate russian harmony_bad_sweet_talk_male_7fc8f354:
    harmony.say "Я ВЕРЮ. Просто в последнее время появились сомнения. Это не делает меня притворщицей!"

# ch/harmony/chat.rpy:625
translate russian harmony_bad_sweet_talk_male_d8300581:
    mike.say "Эй, я не хотел задеть за живое."

# ch/harmony/chat.rpy:628
translate russian harmony_bad_sweet_talk_male_d5a6466c:
    harmony.say "Возможно, ты не совсем неправ, [lssb_harmony.hero_name()]."

# ch/harmony/chat.rpy:629
translate russian harmony_bad_sweet_talk_male_df1b210e:
    harmony.say "Я всё ещё верю, правда. Но иногда по вечерам встаю на колени совсем не ради молитвы."

# ch/harmony/chat.rpy:630
translate russian harmony_bad_sweet_talk_male_a156cc25:
    mike.say "Так-так... Кто-то наконец заговорил честно."

# ch/harmony/chat.rpy:634
translate russian harmony_bad_sweet_talk_male_360e7998:
    harmony.say "Ты видишь меня насквозь, [lssb_harmony.hero_name()]. Как всегда."

# ch/harmony/chat.rpy:635
translate russian harmony_bad_sweet_talk_male_590342b7:
    harmony.say "Теперь моя единственная религия — ты. Преклонять колени, подчиняться, позволять тебе пользоваться мной. Зачем это скрывать?"

# ch/harmony/chat.rpy:638
translate russian harmony_bad_sweet_talk_male_3c40ddbf:
    harmony.say "Признаю свою вину, [lssb_harmony.hero_name()]."

# ch/harmony/chat.rpy:639
translate russian harmony_bad_sweet_talk_male_0d8af900:
    harmony.say "Я променяла пение гимнов на то, от чего меня по-настоящему трясёт. И не жалею!"

# ch/harmony/chat.rpy:640
translate russian harmony_bad_sweet_talk_male_c3f882ec:
    mike.say "Ха! Всегда знал, что за всеми этими гимнами прячется дьяволица."

# ch/harmony/condom.rpy:3
translate russian harmony_use_condom_0980ff79:
    "В Хармони уже растёт ребёнок, так что тянуться сейчас за презервативом было бы странно."

# ch/harmony/condom.rpy:5
translate russian harmony_use_condom_81c61006:
    harmony.say "Даже не смей, [lssb_harmony.hero_name()]."

# ch/harmony/condom.rpy:6
translate russian harmony_use_condom_95f205a1:
    harmony.say "Ты уже одарил меня благословением. Теперь наполни ещё раз и поблагодари за это Господа!"

# ch/harmony/condom.rpy:8
translate russian harmony_use_condom_97c8268b:
    harmony.say "Теперь в этом нет нужды, [lssb_harmony.hero_name()]."

# ch/harmony/condom.rpy:9
translate russian harmony_use_condom_93bf506e:
    harmony.say "Бог уже сотворил во мне своё маленькое чудо."

# ch/harmony/condom.rpy:13
translate russian harmony_use_condom_2b86ab43:
    "На кону слишком многое, чтобы рисковать."

# ch/harmony/condom.rpy:14
translate russian harmony_use_condom_8c8cc1c7:
    "Поэтому я прерываюсь и беру презерватив из стопки на прикроватном столике."

# ch/harmony/condom.rpy:16
translate russian harmony_use_condom_73e2f121:
    harmony.say "Ох... боже мой. Так вот как они выглядят вблизи."

# ch/harmony/condom.rpy:17
translate russian harmony_use_condom_ca63275f:
    harmony.say "Благослови тебя Бог за такую заботу, [lssb_harmony.hero_name()]. Ребёнок вне брака был бы ужасным грехом."

# ch/harmony/condom.rpy:19
translate russian harmony_use_condom_70e95cbc:
    harmony.say "Да... да, стоит проявить благоразумие, [lssb_harmony.hero_name()]."

# ch/harmony/condom.rpy:20
translate russian harmony_use_condom_a5cd7212:
    "Она отворачивается с пылающими щеками и шепчет короткую молитву, пока я готовлюсь."

# ch/harmony/condom.rpy:22
translate russian harmony_use_condom_66de73c0:
    "Хармони прикусывает губу, и на миг, клянусь, выглядит почти разочарованной."

# ch/harmony/condom.rpy:23
translate russian harmony_use_condom_700e5773:
    harmony.say "Это... наверное, разумно, [lssb_harmony.hero_name()]. Прости меня, Господи, за то, что я даже колебалась."

# ch/harmony/condom.rpy:25
translate russian harmony_use_condom_82a48bb0:
    harmony.say "Если нужно, [lssb_harmony.hero_name()]. Хотя грешная часть меня хочет, чтобы между нами совсем ничего не было..."

# ch/harmony/condom.rpy:26
translate russian harmony_use_condom_62af41f3:
    harmony.say "Прости меня, Боже, за такое сильное желание."

# ch/harmony/condom.rpy:29
translate russian harmony_use_condom_1b14799f:
    harmony.say "Как считаешь нужным, [lssb_harmony.hero_name()]. Моё тело твоё: наполняй его или береги."

# ch/harmony/condom.rpy:30
translate russian harmony_use_condom_23854081:
    harmony.say "Но как же я молюсь, чтобы ты всё-таки решил наполнить меня..."

# ch/harmony/condom.rpy:32
translate russian harmony_use_condom_dad3c42c:
    harmony.say "Презерватив, [lssb_harmony.hero_name()]? Я хочу чувствовать каждую твою каплю."

# ch/harmony/condom.rpy:33
translate russian harmony_use_condom_f2fbcb12:
    harmony.say "Плодиться — Божий замысел, и я намерена следовать ему очень, очень ревностно."

# ch/harmony/condom.rpy:34
translate russian harmony_use_condom_6d9c832c:
    "Хармони не возражает против задержки и, кажется, охотно ждёт."

# ch/harmony/condom.rpy:35
translate russian harmony_use_condom_0a194aae:
    "Через пару секунд я готов."

# ch/harmony/condom.rpy:37
translate russian harmony_use_condom_62a47b98:
    "Но нужно позаботиться о безопасности."

# ch/harmony/condom.rpy:38
translate russian harmony_use_condom_ffc254ad:
    "Я поднимаю руку, останавливая Хармони."

# ch/harmony/condom.rpy:39
translate russian harmony_use_condom_3925fb03:
    mike.say "Подожди минутку, Хармони."

# ch/harmony/condom.rpy:40
translate russian harmony_use_condom_5932d637:
    mike.say "Нам следует воспользоваться защитой."

# ch/harmony/condom.rpy:42
translate russian harmony_use_condom_c0bab92c:
    "Она смотрит на меня и моргает, будто совсем об этом забыла."

# ch/harmony/condom.rpy:43
translate russian harmony_use_condom_43559041:
    harmony.say "Ой! Конечно, [lssb_harmony.hero_name()]. Как ответственно с твоей стороны."

# ch/harmony/condom.rpy:44
translate russian harmony_use_condom_6a350c34:
    "Затем кивает, призывая меня поскорее всё уладить."

# ch/harmony/condom.rpy:46
translate russian harmony_use_condom_bf95accb:
    "Хармони колеблется. В глазах мелькает голодное желание, прежде чем она наконец кивает."

# ch/harmony/condom.rpy:47
translate russian harmony_use_condom_0f64010b:
    harmony.say "Ты прав, стоит. Прости меня, Боже, за мои недавние мысли, [lssb_harmony.hero_name()]."

# ch/harmony/condom.rpy:50
translate russian harmony_use_condom_6a3f4ca5:
    harmony.say "Если ты так хочешь, [lssb_harmony.hero_name()], я буду хорошей девочкой."

# ch/harmony/condom.rpy:52
translate russian harmony_use_condom_cbbd6e46:
    harmony.say "Ну обязательно, [lssb_harmony.hero_name()]? Я так хотела почувствовать, как ты кончаешь в меня..."

# ch/harmony/condom.rpy:53
translate russian harmony_use_condom_5c938a8c:
    "Я понимаю намёк, хватаю презерватив и надеваю его с рекордной скоростью."

# ch/harmony/condom.rpy:54
translate russian harmony_use_condom_d0a062e8:
    "Теперь всё готово."

# ch/harmony/condom.rpy:58
translate russian harmony_intro_condom_7faa438f:
    "Спустив шорты, я готовлюсь к более чем приятному занятию."

# ch/harmony/condom.rpy:60
translate russian harmony_intro_condom_564a4b6a:
    harmony.say "Теперь незачем суетиться, [lssb_harmony.hero_name()]. Ты уже однажды благословил меня."

# ch/harmony/condom.rpy:61
translate russian harmony_intro_condom_c96f4ade:
    harmony.say "Так что не смей заставлять меня ждать ни мгновения дольше."

# ch/harmony/condom.rpy:64
translate russian harmony_intro_condom_dea941b3:
    harmony.say "Боже мой. Это правда происходит, [lssb_harmony.hero_name()]? Не верится, что я на такое решилась."

# ch/harmony/condom.rpy:65
translate russian harmony_intro_condom_6c4728bb:
    harmony.say "Будь нежным и не забудь... о мерах предосторожности. Я даже смотреть боюсь."

# ch/harmony/condom.rpy:67
translate russian harmony_intro_condom_1f8f54db:
    harmony.say "Так. Сначала нужно проявить благоразумие, [lssb_harmony.hero_name()]. Благоразумие и осторожность... Ох, я заговариваюсь."

# ch/harmony/condom.rpy:68
translate russian harmony_intro_condom_71e40976:
    harmony.say "Просто скажи, когда будешь готов. А я пока помолюсь."

# ch/harmony/condom.rpy:70
translate russian harmony_intro_condom_edb6bb81:
    harmony.say "Сердце так и колотится, [lssb_harmony.hero_name()]. Всё убеждаю себя, что ничего страшного, ведь мы будем осторожны."

# ch/harmony/condom.rpy:71
translate russian harmony_intro_condom_e8819837:
    harmony.say "Господи, дай мне терпения подождать, пока ты с этим разберёшься..."

# ch/harmony/condom.rpy:73
translate russian harmony_intro_condom_7814883b:
    harmony.say "Нам обязательно прерываться ради этого, [lssb_harmony.hero_name()]? Я весь вечер изнываю от желания."

# ch/harmony/condom.rpy:74
translate russian harmony_intro_condom_4f65b98b:
    harmony.say "Прости меня, Боже, но поторопись. Кажется, я больше не вынесу ожидания."

# ch/harmony/condom.rpy:77
translate russian harmony_intro_condom_97610fb2:
    harmony.say "Делай как считаешь нужным, [lssb_harmony.hero_name()]. Хотя я молюсь, чтобы ты взял меня без него."

# ch/harmony/condom.rpy:78
translate russian harmony_intro_condom_1f84c2ad:
    harmony.say "Я хочу чувствовать тебя целиком, без преград. Теперь я поклоняюсь тебе именно так."

# ch/harmony/condom.rpy:80
translate russian harmony_intro_condom_8e6661a5:
    harmony.say "Это правда обязательно, [lssb_harmony.hero_name()]? Хочу чувствовать тебя всего: кожа к коже, без всяких преград."

# ch/harmony/condom.rpy:81
translate russian harmony_intro_condom_f861da6c:
    harmony.say "В Писании ведь сказано плодиться. Так позволь мне щедро исполнить это с тобой."

# ch/harmony/condom.rpy:85
translate russian harmony_warn_condom_cb4b150c:
    "Но тут от лежащей подо мной Хармони раздаётся тихое, но настойчивое покашливание."

# ch/harmony/condom.rpy:87
translate russian harmony_warn_condom_3ed477e4:
    harmony.say "Кхм. [lssb_harmony.hero_name()]. Мы кое-что важное забываем, не так ли?"

# ch/harmony/condom.rpy:89
translate russian harmony_warn_condom_12cf30e5:
    harmony.say "[lssb_harmony.hero_name()]... предохранение, помнишь? Я не стану рисковать таким грехом даже ради тебя."

# ch/harmony/condom.rpy:91
translate russian harmony_warn_condom_b9bfb892:
    "Она ёрзает подо мной, разрываясь между напоминанием и желанием, написанным на лице."

# ch/harmony/condom.rpy:92
translate russian harmony_warn_condom_be0fb723:
    harmony.say "Нам стоит быть осторожными, [lssb_harmony.hero_name()]... пусть какая-то часть меня и умоляет об обратном."

# ch/harmony/condom.rpy:95
translate russian harmony_warn_condom_7d3445d1:
    harmony.say "Только если ты хочешь, [lssb_harmony.hero_name()]. Я приму всё, что ты решишь мне дать."

# ch/harmony/condom.rpy:97
translate russian harmony_warn_condom_12f98c8c:
    harmony.say "Можно просто... обойтись без него, [lssb_harmony.hero_name()]. Я совсем не буду против."

# ch/harmony/condom.rpy:101
translate russian harmony_force_condom_4ce17640:
    "Хармони протягивает презерватив, и я смущённо беру его."

# ch/harmony/condom.rpy:103
translate russian harmony_force_condom_b68786b4:
    harmony.say "Я держу один среди запасных Библий, [lssb_harmony.hero_name()]. На случай чрезвычайных плотских обстоятельств."

# ch/harmony/condom.rpy:104
translate russian harmony_force_condom_7e460e35:
    "Неловко, что мне пришлось напоминать о такой простой предосторожности."

# ch/harmony/condom.rpy:105
translate russian harmony_force_condom_0346935f:
    "И вдвойне неловко, что напомнила такая невинная девушка, как Хармони!"

# ch/harmony/condom.rpy:107
translate russian harmony_force_condom_e6e471a4:
    harmony.say "Лучше перестраховаться, чем потом жалеть, [lssb_harmony.hero_name()]. Господь помогает тем, кто помогает себе сам."

# ch/harmony/condom.rpy:108
translate russian harmony_force_condom_aee0ec80:
    "Неловко, что о такой простой предосторожности мне напоминает столь набожная девушка."

# ch/harmony/condom.rpy:110
translate russian harmony_force_condom_68631617:
    "Она вкладывает его мне в ладонь, но задерживает пальцы, словно ей хочется смять его и забыть."

# ch/harmony/condom.rpy:111
translate russian harmony_force_condom_f6191577:
    harmony.say "Надень, [lssb_harmony.hero_name()]. Пока я не уговорила нас обоих на что-нибудь, в чём придётся исповедоваться."

# ch/harmony/condom.rpy:114
translate russian harmony_force_condom_fac0b0b1:
    harmony.say "Я взяла его на случай, если ты захочешь, [lssb_harmony.hero_name()]. Но выбор всегда за тобой."

# ch/harmony/condom.rpy:116
translate russian harmony_force_condom_c4daa8ea:
    harmony.say "Я взяла его из ответственности, [lssb_harmony.hero_name()]. Но честно? Молюсь, чтобы ты отбросил его в сторону."

# ch/harmony/condom.rpy:117
translate russian harmony_force_condom_2127cce8:
    "Через пару секунд презерватив надет, и я готов."

# ch/harmony/condom.rpy:122
translate russian harmony_mad_condom_5551d6a2:
    harmony.say "Презерватив, [lssb_harmony.hero_name()]? Я уже ношу твоего ребёнка!"

# ch/harmony/condom.rpy:123
translate russian harmony_mad_condom_559e7679:
    harmony.say "Теперь нечего опасаться, глупенький. Иди сюда и закончи начатое."

# ch/harmony/condom.rpy:126
translate russian harmony_mad_condom_cd365593:
    harmony.say "[lssb_harmony.hero_name()], о чём ты только думаешь?"

# ch/harmony/condom.rpy:127
translate russian harmony_mad_condom_3057aad4:
    harmony.say "Ты же знаешь, как для меня это важно!"

# ch/harmony/condom.rpy:128
translate russian harmony_mad_condom_2bbaf60f:
    harmony.say "Где презерватив?"

# ch/harmony/condom.rpy:129
translate russian harmony_mad_condom_8a0dda7c:
    mike.say "Да ладно тебе, Хармони!"

# ch/harmony/condom.rpy:130
translate russian harmony_mad_condom_66d99588:
    mike.say "Каковы вообще шансы, что ты забеременеешь?"

# ch/harmony/condom.rpy:131
translate russian harmony_mad_condom_203c2b41:
    "Она широко раскрывает глаза от недоверия и гнева."

# ch/harmony/condom.rpy:132
translate russian harmony_mad_condom_b95267d1:
    "Отталкивает меня и перекатывается к краю кровати."

# ch/harmony/condom.rpy:133
translate russian harmony_mad_condom_b6f02d07:
    "Схватив одежду, выбегает из комнаты, оставив меня одного — злого и неудовлетворённого."

# ch/harmony/condom.rpy:135
translate russian harmony_mad_condom_eade1980:
    harmony.say "[lssb_harmony.hero_name()]... мы ведь ничем не предохранялись?"

# ch/harmony/condom.rpy:136
translate russian harmony_mad_condom_1eabbf11:
    "Она выглядит растерянной; на раскрасневшемся лице борются вина и желание."

# ch/harmony/condom.rpy:137
translate russian harmony_mad_condom_d6b6cff9:
    harmony.say "Прости меня, Боже, но я не смогла заставить себя остановить тебя."

# ch/harmony/condom.rpy:138
translate russian harmony_mad_condom_2af3dfa1:
    harmony.say "Просто... будь бережен с моим сердцем, ладно? Я не готова к возможным последствиям."

# ch/harmony/condom.rpy:141
translate russian harmony_mad_condom_d4fdd95b:
    harmony.say "Между нами совсем ничего, [lssb_harmony.hero_name()]? Значит, теперь я по-настоящему вся твоя."

# ch/harmony/condom.rpy:142
translate russian harmony_mad_condom_627b6378:
    harmony.say "Наполняй меня сколько захочешь. Это Божий замысел, и я так рада ему подчиниться."

# ch/harmony/condom.rpy:144
translate russian harmony_mad_condom_0c2eddfa:
    harmony.say "М-м-м... Никаких преград, [lssb_harmony.hero_name()]. Именно так, как я хотела."

# ch/harmony/condom.rpy:145
translate russian harmony_mad_condom_c19a2b3b:
    harmony.say "И если Господь сегодня благословит меня ребёнком, так тому и быть!"

# ch/harmony/date.rpy:2
translate russian harmony_date_intro_valentine_male_4464f16f:
    mike.say "С Днём святого Валентина, Хармони!"

# ch/harmony/date.rpy:3
translate russian harmony_date_intro_valentine_male_7d6060d7:
    mike.say "Я так рад, что сегодня у меня свидание с тобой."

# ch/harmony/date.rpy:4
translate russian harmony_date_intro_valentine_male_ad4a6ae8:
    mike.say "Ведь лучшую возлюбленную невозможно и представить!"

# ch/harmony/date.rpy:7
translate russian harmony_date_intro_valentine_male_41c26bb4:
    harmony.say "О-о... Как мило, [lssb_harmony.hero_name()]!"

# ch/harmony/date.rpy:10
translate russian harmony_date_intro_valentine_male_7b5a592e:
    harmony.say "Знаешь, каждый вечер я благодарю Бога за то, что Он привёл меня к тебе."

# ch/harmony/date.rpy:11
translate russian harmony_date_intro_valentine_male_0db1e009:
    harmony.say "Ни с кем на свете я не хотела бы провести жизнь больше, чем с тобой."

# ch/harmony/date.rpy:13
translate russian harmony_date_intro_valentine_male_e05db344:
    harmony.say "Я чувствую к тебе то же самое."

# ch/harmony/date.rpy:15
translate russian harmony_date_intro_valentine_male_64d65128:
    harmony.say "Боже мой, [lssb_harmony.hero_name()]... От твоих слов сердце бьётся так грешно быстро."

# ch/harmony/date.rpy:16
translate russian harmony_date_intro_valentine_male_ba00ded5:
    harmony.say "Прости меня, Господи, но я хочу, чтобы вечер закончился чем-нибудь очень непристойным."

# ch/harmony/date.rpy:18
translate russian harmony_date_intro_valentine_male_3db29adb:
    harmony.say "Продолжай говорить со мной так, [lssb_harmony.hero_name()]."

# ch/harmony/date.rpy:19
translate russian harmony_date_intro_valentine_male_bf7e2bbc:
    harmony.say "Ты меня ТАК возбуждаешь!"

# ch/harmony/date.rpy:21
translate russian harmony_date_intro_valentine_male_e48359f2:
    harmony.say "Я чувствую то же самое, [lssb_harmony.hero_name()]."

# ch/harmony/date.rpy:22
translate russian harmony_date_intro_valentine_male_d29011ac:
    harmony.say "Сегодня будет очень весело!"

# ch/harmony/date.rpy:26
translate russian harmony_date_intro_halloween_male_2974d7a5:
    mike.say "Слушай, Хармони, я думал, ты нарядишься на Хэллоуин."

# ch/harmony/date.rpy:27
translate russian harmony_date_intro_halloween_male_e6ac24a7:
    mike.say "Ну, наденешь для меня что-нибудь жуткое и сексуальное?"

# ch/harmony/date.rpy:29
translate russian harmony_date_intro_halloween_male_d294d842:
    "Она выглядит удивлённой, будто совсем об этом забыла."

# ch/harmony/date.rpy:32
translate russian harmony_date_intro_halloween_male_10952791:
    harmony.say "Я бы никогда так не поступила, [lssb_harmony.hero_name()]."

# ch/harmony/date.rpy:33
translate russian harmony_date_intro_halloween_male_d2d77f15:
    harmony.say "Хэллоуин — нечестивый языческий праздник!"

# ch/harmony/date.rpy:36
translate russian harmony_date_intro_halloween_male_24dc4db0:
    harmony.say "Вот чёрт, я совсем забыла!"

# ch/harmony/date.rpy:38
translate russian harmony_date_intro_halloween_male_b6eddb7d:
    harmony.say "Не волнуйся, [lssb_harmony.hero_name()], в следующем году надену что-нибудь особенно сексуальное!"

# ch/harmony/date.rpy:41
translate russian harmony_date_intro_halloween_male_71d0c14f:
    harmony.say "Может, в следующем году, [lssb_harmony.hero_name()]."

# ch/harmony/date.rpy:42
translate russian harmony_date_intro_halloween_male_66516ced:
    harmony.say "Давай просто хорошо проведём наше свидание, ладно?"

# ch/harmony/date.rpy:44
translate russian harmony_date_intro_halloween_male_68641dbe:
    "Я киваю, соглашаясь с Хармони."

# ch/harmony/date.rpy:45
translate russian harmony_date_intro_halloween_male_e5efb7ac:
    "К тому же это лучший способ не испортить свидание!"

# ch/harmony/date.rpy:46
translate russian harmony_date_intro_halloween_male_5f547ea4:
    mike.say "Отлично, Хармони."

# ch/harmony/date.rpy:47
translate russian harmony_date_intro_halloween_male_ab669a30:
    mike.say "Пойдём."

# ch/harmony/date.rpy:51
translate russian harmony_date_intro_christmas_male_cd320f85:
    mike.say "С Рождеством, Хармони!"

# ch/harmony/date.rpy:52
translate russian harmony_date_intro_christmas_male_1f3dd852:
    mike.say "Ты готова к нашему свиданию?"

# ch/harmony/date.rpy:54
translate russian harmony_date_intro_christmas_male_f5456d5b:
    "Она кивает и улыбается."

# ch/harmony/date.rpy:57
translate russian harmony_date_intro_christmas_male_13598611:
    harmony.say "Главное — хранить в сердце истинный смысл Рождества, [lssb_harmony.hero_name()]."

# ch/harmony/date.rpy:58
translate russian harmony_date_intro_christmas_male_cbc2081a:
    harmony.say "Помни: мы празднуем рождение Иисуса!"

# ch/harmony/date.rpy:60
translate russian harmony_date_intro_christmas_male_d3e4fc74:
    harmony.say "Ещё бы, [lssb_harmony.hero_name()]!"

# ch/harmony/date.rpy:61
translate russian harmony_date_intro_christmas_male_58f17ed3:
    harmony.say "Меня тошнит от этой чуши про «истинный смысл Рождества»."

# ch/harmony/date.rpy:62
translate russian harmony_date_intro_christmas_male_eadd4847:
    harmony.say "Я хочу веселиться!"

# ch/harmony/date.rpy:64
translate russian harmony_date_intro_christmas_male_92b5d763:
    harmony.say "Да, [lssb_harmony.hero_name()], мне нужно расслабиться и повеселиться!"

# ch/harmony/date.rpy:68
translate russian harmony_date_intro_birthday_male_44f4605b:
    mike.say "С днём рождения, Хармони!"

# ch/harmony/date.rpy:69
translate russian harmony_date_intro_birthday_male_06d60db9:
    mike.say "И раз сегодня твой день рождения, я хочу сделать наше свидание особенно замечательным!"

# ch/harmony/date.rpy:72
translate russian harmony_date_intro_birthday_male_876f5cc1:
    harmony.say "Благослови тебя Бог, [lssb_harmony.hero_name()]!"

# ch/harmony/date.rpy:73
translate russian harmony_date_intro_birthday_male_4e953cd1:
    harmony.say "Давай вместе хорошо и благопристойно повеселимся."

# ch/harmony/date.rpy:75
translate russian harmony_date_intro_birthday_male_37735afc:
    harmony.say "О-о... Звучит ТАК интригующе!"

# ch/harmony/date.rpy:77
translate russian harmony_date_intro_birthday_male_98721228:
    harmony.say "Надеюсь, для этого нужно раздеться и трахаться как звери!"

# ch/harmony/date.rpy:79
translate russian harmony_date_intro_birthday_male_dcad941c:
    harmony.say "Ух ты, [lssb_harmony.hero_name()], ты помнишь!"

# ch/harmony/date.rpy:80
translate russian harmony_date_intro_birthday_male_153bfb1b:
    harmony.say "Я думала, парням это несвойственно."

# ch/harmony/date.rpy:84
translate russian harmony_date_intro_mc_birthday_male_51b596a7:
    mike.say "Готова к свиданию, Хармони?"

# ch/harmony/date.rpy:87
translate russian harmony_date_intro_mc_birthday_male_88e1c860:
    harmony.say "Сперва самое важное, [lssb_harmony.hero_name()]..."

# ch/harmony/date.rpy:88
translate russian harmony_date_intro_mc_birthday_male_e852ebbc:
    harmony.say "С днём рождения тебя!"

# ch/harmony/date.rpy:90
translate russian harmony_date_intro_mc_birthday_male_ad5daa08:
    harmony.say "С днём рождения, [lssb_harmony.hero_name()]..."

# ch/harmony/date.rpy:91
translate russian harmony_date_intro_mc_birthday_male_1bffff50:
    harmony.say "Я молилась, чтобы придумать что-нибудь особенное. Некоторые идеи были, ну... не слишком святыми."

# ch/harmony/date.rpy:93
translate russian harmony_date_intro_mc_birthday_male_bf30e55f:
    harmony.say "Сначала хочу поздравить тебя с днём рождения, [lssb_harmony.hero_name()]."

# ch/harmony/date.rpy:94
translate russian harmony_date_intro_mc_birthday_male_b91d90d5:
    harmony.say "И хочу ДОЛГИЙ праздничный поцелуй, с языком!"

# ch/harmony/date.rpy:96
translate russian harmony_date_intro_mc_birthday_male_13d76136:
    harmony.say "Да, [lssb_harmony.hero_name()]..."

# ch/harmony/date.rpy:97
translate russian harmony_date_intro_mc_birthday_male_b2714510:
    harmony.say "Но сперва я хотела поздравить тебя с днём рождения!"

# ch/harmony/date.rpy:99
translate russian harmony_date_intro_mc_birthday_male_9df9cb71:
    mike.say "О-о... Спасибо, Хармони!"

# ch/harmony/date.rpy:100
translate russian harmony_date_intro_mc_birthday_male_8648d77b:
    mike.say "Очень приятно, что ты помнишь."

# ch/harmony/date.rpy:105
translate russian harmony_date_eat_a_burger_99e9fe4f:
    "Едва перед Хармони появляется бургер, она набрасывается на него с аппетитом женщины, которая ест за двоих."

# ch/harmony/date.rpy:106
translate russian harmony_date_eat_a_burger_3c9762bb:
    "Между кусочками она гладит округлившийся живот и тихо благодарит Господа за каждый укус."

# ch/harmony/date.rpy:107
translate russian harmony_date_eat_a_burger_2aeea60a:
    harmony.say "Не осуждай меня, [lssb_harmony.hero_name()]. Мы с твоим ребёнком ужасно голодны! Наверняка чревоугодие простительно ради такого благословения!"

# ch/harmony/date.rpy:109
translate russian harmony_date_eat_a_burger_f5647bf8:
    "Едва приносят еду, по лицу Хармони я понимаю, что совершил ошибку."

# ch/harmony/date.rpy:110
translate russian harmony_date_eat_a_burger_45c50e68:
    "Она смотрит на бургер словно на дьявольское создание, посланное из самого ада, чтобы её мучить."

# ch/harmony/date.rpy:111
translate russian harmony_date_eat_a_burger_070adc3f:
    "Самое большее — неловко откусывает край булочки и, возможно, немного зелени. Больше ничего."

# ch/harmony/date.rpy:113
translate russian harmony_date_eat_a_burger_ebf2a1af:
    "Когда перед Хармони ставят бургер, её глаза буквально загораются."

# ch/harmony/date.rpy:114
translate russian harmony_date_eat_a_burger_3790a1f6:
    "Не дожидаясь меня, она набрасывается на него и поглощает так, словно голодала."

# ch/harmony/date.rpy:115
translate russian harmony_date_eat_a_burger_139ca4d2:
    "Она заканчивает задолго до меня и облизывает пальцы с выражением полного удовлетворения."

# ch/harmony/date.rpy:117
translate russian harmony_date_eat_a_burger_47631b7d:
    "Хармони, кажется, рада появлению еды: улыбается и всем видом показывает, что проголодалась."

# ch/harmony/date.rpy:118
translate russian harmony_date_eat_a_burger_444715b2:
    "Она ест с аппетитом, но бургер не занимает всего её внимания."

# ch/harmony/date.rpy:119
translate russian harmony_date_eat_a_burger_7ffdd4e5:
    "В итоге немного еды остаётся, однако съеденным она, похоже, довольна."

# ch/harmony/date.rpy:126
translate russian harmony_date_buy_drink_08c9b1ae:
    harmony.say "Что, навредить ребёнку, который растёт во мне?!"

# ch/harmony/date.rpy:127
translate russian harmony_date_buy_drink_12f2fd8e:
    harmony.say "Ты с ума сошёл, [lssb_harmony.hero_name()]?"

# ch/harmony/date.rpy:128
translate russian harmony_date_buy_drink_33f8b6d1:
    harmony.say "В тебя бес вселился?!"

# ch/harmony/date.rpy:133
translate russian harmony_date_buy_drink_65b3d068:
    "При одном упоминании алкоголя Хармони морщит нос и качает головой."

# ch/harmony/date.rpy:134
translate russian harmony_date_buy_drink_40ee3283:
    "Бормочет что-то о корне всех зол и снова качает головой."

# ch/harmony/date.rpy:135
translate russian harmony_date_buy_drink_44f271eb:
    "В конце концов мне становится неловко даже держать собственный стакан."

# ch/harmony/date.rpy:137
translate russian harmony_date_buy_drink_427eb049:
    "Что бы я ни пил, Хармони хочет того же — и столько же!"

# ch/harmony/date.rpy:138
translate russian harmony_date_buy_drink_604d7f7a:
    "Стоит стакану оказаться у неё в руке, как она без колебаний и довольно быстро его осушает."

# ch/harmony/date.rpy:139
translate russian harmony_date_buy_drink_eb9824cf:
    "Я едва поспеваю за ней: она уже допивает и высматривает следующую порцию."

# ch/harmony/date.rpy:141
translate russian harmony_date_buy_drink_0e50108a:
    "Хармони принимает предложение выпить, но выбирает небольшую порцию чего-нибудь некрепкого."

# ch/harmony/date.rpy:142
translate russian harmony_date_buy_drink_8cdcebf6:
    "Пьёт маленькими глотками, словно стараясь растянуть напиток как можно дольше."

# ch/harmony/date.rpy:143
translate russian harmony_date_buy_drink_3b6ead28:
    "Хотя делает она это сознательно или нет, я не понимаю."

# ch/harmony/date.rpy:148
translate russian harmony_date_play_darts_6588b9ea:
    "Хармони отшатывается от дротиков, словно я вручил ей горсть грехов с заточенными остриями."

# ch/harmony/date.rpy:149
translate russian harmony_date_play_darts_d86da028:
    "Такая кроткая и миролюбивая душа, она не выносит мысли о чём-то достаточно остром, чтобы пустить кровь."

# ch/harmony/date.rpy:150
translate russian harmony_date_play_darts_328837ff:
    "В итоге кладёт их на стол, складывает ладони и шепчет молитву, чтобы я выбрал игру подобрее."

# ch/harmony/date.rpy:152
translate russian harmony_date_play_darts_eb035639:
    "Она смотрит на дротики в руке словно на окровавленные ножи, которые я только что вытащил из чьего-то мёртвого тела."

# ch/harmony/date.rpy:153
translate russian harmony_date_play_darts_30ecbf55:
    "И избавляется от них соответственно, швыряя примерно в сторону мишени."

# ch/harmony/date.rpy:154
translate russian harmony_date_play_darts_78daa84d:
    "Чаще всего они отскакивают от стены, едва не задевая случайных прохожих."

# ch/harmony/date.rpy:156
translate russian harmony_date_play_darts_e0dc8fef:
    "Хармони почти не смотрит на мишень. Вместо этого напоказ наклоняется над линией броска, выгибая спину так, чтобы юбка задиралась выше."

# ch/harmony/date.rpy:157
translate russian harmony_date_play_darts_3c617cd1:
    "Каждый дротик — лишь повод прижаться ко мне сзади и промурлыкать, что мне непременно стоит направить её руку."

# ch/harmony/date.rpy:158
translate russian harmony_date_play_darts_04a8c4d3:
    "К концу игры я никуда не попал, но нам обоим совершенно всё равно."

# ch/harmony/date.rpy:160
translate russian harmony_date_play_darts_2879e11d:
    "Хармони признаётся, что понятия не имеет, как играть в дартс, но готова учиться."

# ch/harmony/date.rpy:161
translate russian harmony_date_play_darts_c3426dec:
    "Приходится придвинуться вплотную сзади и объяснять ей каждое действие."

# ch/harmony/date.rpy:162
translate russian harmony_date_play_darts_68b2d1ea:
    "Хотя не уверен, что её попытки откинуться назад и потереться попкой о мой пах помогают игре..."

# ch/harmony/date.rpy:167
translate russian harmony_date_pub_play_pool_c404bc29:
    "Хармони подозрительно оглядывает длинный твёрдый кий и весь стол, словно сама игра — изощрённое искушение."

# ch/harmony/date.rpy:168
translate russian harmony_date_pub_play_pool_8c72308f:
    "Она соглашается взять кий, но держит его на вытянутых руках и едва задевает хоть один шар."

# ch/harmony/date.rpy:169
translate russian harmony_date_pub_play_pool_568ae437:
    "Вскоре самым милым тоном спрашивает, нельзя ли заняться чем-нибудь чуть более благопристойным."

# ch/harmony/date.rpy:171
translate russian harmony_date_pub_play_pool_559349ea:
    "Она нехотя соглашается сыграть в пул, но совершенно не старается."

# ch/harmony/date.rpy:172
translate russian harmony_date_pub_play_pool_8be9ee77:
    "Чаще всего едва попадает по битку, не говоря уже об остальных шарах."

# ch/harmony/date.rpy:173
translate russian harmony_date_pub_play_pool_eac627f8:
    "Вскоре я уже рад забивать свои шары один за другим, лишь бы закончить."

# ch/harmony/date.rpy:175
translate russian harmony_date_pub_play_pool_176e379e:
    "Хармони даже не притворяется, что ей интересна игра. Она ложится грудью на стол и оглядывается на меня через плечо."

# ch/harmony/date.rpy:176
translate russian harmony_date_pub_play_pool_eb97cd0b:
    "Каждый удар сопровождается медленным, нарочитым движением бёдер. Она всё забывает, как прицелиться, вынуждая меня прижаться сзади."

# ch/harmony/date.rpy:177
translate russian harmony_date_pub_play_pool_8756a621:
    "Бог знает, что думают остальные посетители паба, но Хармони явно волнует только то, как меня подразнить."

# ch/harmony/date.rpy:179
translate russian harmony_date_pub_play_pool_d3316d77:
    "Хармони уверяет, что совершенно безнадёжна в пуле, но с радостью хватается за возможность немного поучиться."

# ch/harmony/date.rpy:180
translate russian harmony_date_pub_play_pool_cfbaf1aa:
    "В результате мне самому становится трудно сосредоточиться на игре."

# ch/harmony/date.rpy:181
translate russian harmony_date_pub_play_pool_842b279e:
    "А кому было бы легко, стоя вплотную позади неё, пока она наклоняется над столом и раздвигает ноги перед каждым ударом?"

# ch/harmony/date.rpy:188
translate russian harmony_date_buy_a_round_08c9b1ae:
    harmony.say "Что, навредить ребёнку, который растёт во мне?!"

# ch/harmony/date.rpy:189
translate russian harmony_date_buy_a_round_12f2fd8e:
    harmony.say "Ты с ума сошёл, [lssb_harmony.hero_name()]?"

# ch/harmony/date.rpy:190
translate russian harmony_date_buy_a_round_33f8b6d1:
    harmony.say "В тебя бес вселился?!"

# ch/harmony/date.rpy:195
translate russian harmony_date_buy_a_round_ee37f920:
    "Когда я встаю и объявляю, что угощу ещё одной порцией, Хармони почти не обращает внимания."

# ch/harmony/date.rpy:196
translate russian harmony_date_buy_a_round_3db00831:
    "А когда прямо спрашиваю, что она хочет выпить, вовсе игнорирует меня и отворачивается."

# ch/harmony/date.rpy:197
translate russian harmony_date_buy_a_round_577411d4:
    "Наверное, стоило внимательнее читать её намёки!"

# ch/harmony/date.rpy:199
translate russian harmony_date_buy_a_round_ec4defa7:
    "Хармони мило улыбается и благодарит за предложение, попросив то же самое."

# ch/harmony/date.rpy:200
translate russian harmony_date_buy_a_round_72f0be42:
    "Берёт стакан, и мы возвращаемся к разговору ровно там, где остановились."

# ch/harmony/date.rpy:201
translate russian harmony_date_buy_a_round_8b03b4dc:
    "Она, кажется, благодарна за выпивку, но снимать за это трусики не собирается!"

# ch/harmony/date.rpy:203
translate russian harmony_date_buy_a_round_3b742894:
    "Когда я встаю за новой порцией, Хармони охотно кивает, глядя на меня огромными глазами и широко улыбаясь."

# ch/harmony/date.rpy:204
translate russian harmony_date_buy_a_round_cd79116c:
    "Кажется, она уже хорошо навеселе, но она взрослая девушка и должна знать свою меру."

# ch/harmony/date.rpy:205
translate russian harmony_date_buy_a_round_82f5aa6a:
    "Едва получив стакан, она начинает осушать его, глядя на меня почти голодными глазами!"

# ch/harmony/date.rpy:212
translate russian harmony_date_buy_a_round_fb20fd2c:
    "Я хочу угостить пивом весь паб."

# ch/harmony/date.rpy:213
translate russian harmony_date_buy_a_round_a28e898c:
    "Но Хармони, похоже, не хочет выпивать, поэтому я отказываюсь от этой затеи."

# ch/harmony/date.rpy:219
translate russian harmony_dance_with_01ee3b1c:
    "Она соглашается танцевать, но только если мы всё время будем держаться на целомудренном, приличном расстоянии."

# ch/harmony/date.rpy:220
translate russian harmony_dance_with_46fc4f00:
    "Держится прямо и скованно, мягко направляя мои руки именно туда, где им и положено быть у джентльмена."

# ch/harmony/date.rpy:221
translate russian harmony_dance_with_5ca0493b:
    "И всё же в её покачиваниях есть застенчивая прелесть. Видно, что ей нравится, несмотря ни на что."

# ch/harmony/date.rpy:223
translate russian harmony_dance_with_a8053a78:
    "Поначалу Хармони не хочет, но в итоге я уговариваю её потанцевать со мной."

# ch/harmony/date.rpy:224
translate russian harmony_dance_with_de23c08e:
    "Мы находим место и начинаем двигаться под музыку. Она смущается и всё время краснеет."

# ch/harmony/date.rpy:225
translate russian harmony_dance_with_ed427bd3:
    "Но от этого танцевать с ней мне лишь приятнее!"

# ch/harmony/date.rpy:227
translate russian harmony_dance_with_d89f2a59:
    "Едва начинается музыка, Хармони обвивается вокруг меня, словно воплощённый грех."

# ch/harmony/date.rpy:228
translate russian harmony_dance_with_528f855b:
    "Медленными, непристойными круговыми движениями трётся о моё бедро и шепчет, что танец — всего лишь молитва бёдрами."

# ch/harmony/date.rpy:229
translate russian harmony_dance_with_ab478edc:
    "К концу песни я мучительно ясно понимаю: все вокруг знают, чем закончится наш вечер."

# ch/harmony/date.rpy:231
translate russian harmony_dance_with_540acbb2:
    "Едва выйдя на танцпол, Хармони становится словно одержимой."

# ch/harmony/date.rpy:232
translate russian harmony_dance_with_9a2db38d:
    "Что бы ни включил диджей, она прижимается ко мне и безжалостно трётся."

# ch/harmony/date.rpy:233
translate russian harmony_dance_with_069e7708:
    "В итоге двигаться трудно уже мне — из-за того, как она действует на мой член!"

# ch/harmony/date.rpy:238
translate russian harmony_date_play_arcade_intro_male_60d51da0:
    harmony.say "Ох, [lssb_harmony.hero_name()], по-моему, мне совсем не место в таком заведении."

# ch/harmony/date.rpy:239
translate russian harmony_date_play_arcade_intro_male_badafa4e:
    harmony.say "Все эти мигающие огни и жестокие игры... Настоящее логово искушения!"

# ch/harmony/date.rpy:241
translate russian harmony_date_play_arcade_intro_male_1715bcb9:
    harmony.say "Не уверена, что это хорошая идея, [lssb_harmony.hero_name()]."

# ch/harmony/date.rpy:242
translate russian harmony_date_play_arcade_intro_male_84d51633:
    harmony.say "Подобные места довольно грешны!"

# ch/harmony/date.rpy:244
translate russian harmony_date_play_arcade_intro_male_0debecac:
    harmony.say "Будет скучно, [lssb_harmony.hero_name()]."

# ch/harmony/date.rpy:245
translate russian harmony_date_play_arcade_intro_male_1448acda:
    harmony.say "Может, займёмся чем-нибудь повеселее?"

# ch/harmony/date.rpy:246
translate russian harmony_date_play_arcade_intro_male_d68fd200:
    "Я знал, что приглашать Хармони в зал игровых автоматов — риск."

# ch/harmony/date.rpy:247
translate russian harmony_date_play_arcade_intro_male_baec2b68:
    "Раньше она никогда особо не интересовалась видеоиграми."

# ch/harmony/date.rpy:248
translate russian harmony_date_play_arcade_intro_male_4a74f740:
    "Но я это люблю и хотел разделить своё увлечение с ней."

# ch/harmony/date.rpy:249
translate russian harmony_date_play_arcade_intro_male_1154730a:
    "Наверное, надеялся, что хоть что-нибудь её заинтересует."

# ch/harmony/date.rpy:250
translate russian harmony_date_play_arcade_intro_male_6ac723cd:
    mike.say "Просто попробуй, Хармони."

# ch/harmony/date.rpy:251
translate russian harmony_date_play_arcade_intro_male_900cad43:
    mike.say "Это всё, о чём я прошу, ладно?"

# ch/harmony/date.rpy:252
translate russian harmony_date_play_arcade_intro_male_e1a6e529:
    mike.say "Давай сыграем пару раз и посмотрим."

# ch/harmony/date.rpy:253
translate russian harmony_date_play_arcade_intro_male_ea6dc017:
    mike.say "Если после этого тебе не понравится, уйдём."

# ch/harmony/date.rpy:254
translate russian harmony_date_play_arcade_intro_male_5423a9ae:
    harmony.say "Ладно, [lssb_harmony.hero_name()]."

# ch/harmony/date.rpy:255
translate russian harmony_date_play_arcade_intro_male_547838d2:
    harmony.say "Я постараюсь..."

# ch/harmony/date.rpy:256
translate russian harmony_date_play_arcade_intro_male_64dc08e4:
    "Я оглядываюсь в поисках подходящей игры."

# ch/harmony/date.rpy:257
translate russian harmony_date_play_arcade_intro_male_a36559da:
    "Наконец замечаю ту, которая должна сработать."

# ch/harmony/date.rpy:258
translate russian harmony_date_play_arcade_intro_male_b1b4d87a:
    mike.say "Как насчёт этой, Хармони?"

# ch/harmony/date.rpy:259
translate russian harmony_date_play_arcade_intro_male_4900c465:
    mike.say "«Ночь Носферату»?"

# ch/harmony/date.rpy:261
translate russian harmony_date_play_arcade_intro_male_ee0de515:
    harmony.say "Вампиры?"

# ch/harmony/date.rpy:262
translate russian harmony_date_play_arcade_intro_male_681f5f53:
    harmony.say "Мерзкие создания, пьющие кровь невинных?! Какая гадость!"

# ch/harmony/date.rpy:264
translate russian harmony_date_play_arcade_intro_male_ee0de515_1:
    harmony.say "Вампиры?"

# ch/harmony/date.rpy:265
translate russian harmony_date_play_arcade_intro_male_468f58ce:
    harmony.say "Похотливые прислужники дьявола?!"

# ch/harmony/date.rpy:267
translate russian harmony_date_play_arcade_intro_male_1a6831e8:
    harmony.say "Уф... вампиры?"

# ch/harmony/date.rpy:268
translate russian harmony_date_play_arcade_intro_male_05fdab44:
    harmony.say "Они уже далеко не такие горячие, как раньше!"

# ch/harmony/date.rpy:269
translate russian harmony_date_play_arcade_intro_male_dfdaa9fc:
    mike.say "В этой игре ты не вампир, Хармони."

# ch/harmony/date.rpy:270
translate russian harmony_date_play_arcade_intro_male_25563496:
    mike.say "Ты охотница на вампиров!"

# ch/harmony/date.rpy:272
translate russian harmony_date_play_arcade_intro_male_4643bfd4:
    harmony.say "Святая воительница, разящая нечестивых во имя Господа?"

# ch/harmony/date.rpy:273
translate russian harmony_date_play_arcade_intro_male_85b498ad:
    harmony.say "Вот ЭТО по-настоящему праведное призвание!"

# ch/harmony/date.rpy:275
translate russian harmony_date_play_arcade_intro_male_738a83b6:
    harmony.say "Святая воительница?"

# ch/harmony/date.rpy:276
translate russian harmony_date_play_arcade_intro_male_e627e244:
    harmony.say "Как здорово!"

# ch/harmony/date.rpy:278
translate russian harmony_date_play_arcade_intro_male_f336a171:
    harmony.say "Я смогу их убивать?"

# ch/harmony/date.rpy:279
translate russian harmony_date_play_arcade_intro_male_cbf0e64c:
    harmony.say "Пускать им кровь?!"

# ch/harmony/date.rpy:280
translate russian harmony_date_play_arcade_intro_male_21c47695:
    "Я охотно киваю, опуская монеты в автомат."

# ch/harmony/date.rpy:281
translate russian harmony_date_play_arcade_intro_male_06cb2bc1:
    "Лучше воспользоваться случаем, пока Хармони ещё заинтересована."

# ch/harmony/date.rpy:285
translate russian harmony_date_play_arcade_win_male_689a1fd4:
    "Едва мы начинаем играть, она теряется."

# ch/harmony/date.rpy:286
translate russian harmony_date_play_arcade_win_male_39244e16:
    "А когда события набирают обороты, становится только хуже!"

# ch/harmony/date.rpy:287
translate russian harmony_date_play_arcade_win_male_51c10453:
    harmony.say "А-а!"

# ch/harmony/date.rpy:288
translate russian harmony_date_play_arcade_win_male_9319a57f:
    harmony.say "Что это?!"

# ch/harmony/date.rpy:289
translate russian harmony_date_play_arcade_win_male_c4045c84:
    harmony.say "Помоги, [lssb_harmony.hero_name()], стреляй!"

# ch/harmony/date.rpy:290
translate russian harmony_date_play_arcade_win_male_2214cec8:
    mike.say "Твой пистолет тоже работает, Хармони."

# ch/harmony/date.rpy:291
translate russian harmony_date_play_arcade_win_male_abd7e5c5:
    mike.say "Вместе мы убьём его быстрее!"

# ch/harmony/date.rpy:292
translate russian harmony_date_play_arcade_win_male_1aba6f22:
    "Дальше начинается мучительная игра, в которой почти всё приходится делать мне."

# ch/harmony/date.rpy:293
translate russian harmony_date_play_arcade_win_male_c881011a:
    "Хармони вздрагивает от каждой внезапной пугалки."

# ch/harmony/date.rpy:294
translate russian harmony_date_play_arcade_win_male_4113a6e8:
    "И чаще всего стреляет не туда."

# ch/harmony/date.rpy:295
translate russian harmony_date_play_arcade_win_male_863da087:
    "К тому времени, как оплаченные попытки заканчиваются, она уже комок нервов."

# ch/harmony/date.rpy:296
translate russian harmony_date_play_arcade_win_male_75088692:
    "И счёт это отражает."

# ch/harmony/date.rpy:297
translate russian harmony_date_play_arcade_win_male_8cc136d9:
    mike.say "Эм... Можешь открыть глаза, Хармони."

# ch/harmony/date.rpy:298
translate russian harmony_date_play_arcade_win_male_a71db5f7:
    mike.say "Игра закончилась, вампиров больше нет."

# ch/harmony/date.rpy:299
translate russian harmony_date_play_arcade_win_male_02d266a6:
    harmony.say "Обещаешь, [lssb_harmony.hero_name()]?"

# ch/harmony/date.rpy:300
translate russian harmony_date_play_arcade_win_male_098079c2:
    mike.say "Обещаю, Хармони."

# ch/harmony/date.rpy:301
translate russian harmony_date_play_arcade_win_male_aaf3cd6a:
    harmony.say "Тогда... можно уйти?"

# ch/harmony/date.rpy:302
translate russian harmony_date_play_arcade_win_male_8c9ae51d:
    mike.say "Да, Хармони, можно."

# ch/harmony/date.rpy:303
translate russian harmony_date_play_arcade_win_male_44c45b9a:
    mike.say "Думаю, нам действительно стоит попробовать что-нибудь другое..."

# ch/harmony/date.rpy:307
translate russian harmony_date_play_arcade_lose_male_65816d9b:
    "Почти сразу после начала игры Хармони преображается."

# ch/harmony/date.rpy:308
translate russian harmony_date_play_arcade_lose_male_ef0f9a0d:
    "Только что робкая и неуверенная, теперь она полна решимости."

# ch/harmony/date.rpy:309
translate russian harmony_date_play_arcade_lose_male_54739f41:
    harmony.say "Получай, прислужник зла!"

# ch/harmony/date.rpy:310
translate russian harmony_date_play_arcade_lose_male_442956c8:
    harmony.say "Мои пули положат тебе конец!"

# ch/harmony/date.rpy:311
translate russian harmony_date_play_arcade_lose_male_d1b1c546:
    harmony.say "Давай, [lssb_harmony.hero_name()], нам нужно истреблять вампиров!"

# ch/harmony/date.rpy:312
translate russian harmony_date_play_arcade_lose_male_3f8382ca:
    mike.say "Ого..."

# ch/harmony/date.rpy:313
translate russian harmony_date_play_arcade_lose_male_686ef7b0:
    mike.say "Притормози, Хармони!"

# ch/harmony/date.rpy:314
translate russian harmony_date_play_arcade_lose_male_e63536c5:
    mike.say "Оставь хоть кого-нибудь мне!"

# ch/harmony/date.rpy:315
translate russian harmony_date_play_arcade_lose_male_8be204df:
    "Дальше начинается настоящая бойня."

# ch/harmony/date.rpy:316
translate russian harmony_date_play_arcade_lose_male_1cb7ba2c:
    "Она расстреливает всё на своём пути."

# ch/harmony/date.rpy:317
translate russian harmony_date_play_arcade_lose_male_dd6bdd41:
    "А мне остаётся лишь плестись следом."

# ch/harmony/date.rpy:318
translate russian harmony_date_play_arcade_lose_male_2398bc51:
    "К концу игры она оставляет меня далеко позади."

# ch/harmony/date.rpy:319
translate russian harmony_date_play_arcade_lose_male_5160b305:
    mike.say "Эм... Можешь больше не стрелять, Хармони."

# ch/harmony/date.rpy:320
translate russian harmony_date_play_arcade_lose_male_a71db5f7:
    mike.say "Игра закончилась, вампиров больше нет."

# ch/harmony/date.rpy:321
translate russian harmony_date_play_arcade_lose_male_ae44f403:
    harmony.say "О-ох..."

# ch/harmony/date.rpy:322
translate russian harmony_date_play_arcade_lose_male_0e4743cf:
    harmony.say "А мне было так весело!"

# ch/harmony/date.rpy:323
translate russian harmony_date_play_arcade_lose_male_40d3464f:
    harmony.say "Значит... теперь нужно уходить?"

# ch/harmony/date.rpy:324
translate russian harmony_date_play_arcade_lose_male_3a1a32a4:
    mike.say "Да, Хармони, нужно."

# ch/harmony/date.rpy:325
translate russian harmony_date_play_arcade_lose_male_44c45b9a:
    mike.say "Думаю, нам действительно стоит попробовать что-нибудь другое..."

# ch/harmony/date.rpy:333
translate russian harmony_dick_reactions_a33f7e22:
    harmony.say "О Господи!"

# ch/harmony/date.rpy:334
translate russian harmony_dick_reactions_9485e22f:
    harmony.say "Никогда не думала, что он может быть ТАКИМ большим!"

# ch/harmony/date.rpy:335
translate russian harmony_dick_reactions_5fcc4702:
    mike.say "Ха... да... Пожалуй, великоват!"

# ch/harmony/date.rpy:336
translate russian harmony_dick_reactions_aac169ec:
    harmony.say "Н... но всё равно это часть Божьего чуда."

# ch/harmony/date.rpy:338
translate russian harmony_dick_reactions_f1a62710:
    harmony.say "А значит, я... должна быть за него благодарна..."

# ch/harmony/date.rpy:343
translate russian harmony_dick_reactions_57e24c25:
    harmony.say "Боже мой, какой крошечный!"

# ch/harmony/date.rpy:344
translate russian harmony_dick_reactions_807af0c5:
    mike.say "Эй, мужчине такое слышать неприятно!"

# ch/harmony/date.rpy:345
translate russian harmony_dick_reactions_af112386:
    harmony.say "Нет, я о том, что он маленький, но совершенно правильной формы."

# ch/harmony/date.rpy:346
translate russian harmony_dick_reactions_589d8f6c:
    harmony.say "Будто Бог сотворил маленькое произведение искусства!"

# ch/harmony/date.rpy:347
translate russian harmony_dick_reactions_55070bb8:
    mike.say "Спасибо... наверное..."

# ch/harmony/date.rpy:354
translate russian harmony_halloween_invitation_6dd3608d:
    "Я с самого начала знал, что хочу пригласить на хэллоуинскую вечеринку именно Хармони."

# ch/harmony/date.rpy:355
translate russian harmony_halloween_invitation_cae7588a:
    "Не нужно было садиться и взвешивать варианты: я и так почти постоянно о ней думаю!"

# ch/harmony/date.rpy:356
translate russian harmony_halloween_invitation_95350610:
    "Проблема лишь в том, что нужно очень осторожно подобрать слова."

# ch/harmony/date.rpy:357
translate russian harmony_halloween_invitation_29ad0c1b:
    "Она чувствительная, и мне не хочется ляпнуть что-нибудь, что уничтожит мои шансы."

# ch/harmony/date.rpy:358
translate russian harmony_halloween_invitation_717987b8:
    "Поэтому я стараюсь упомянуть об этом мимоходом, а не выложить всё сразу."

# ch/harmony/date.rpy:359
translate russian harmony_halloween_invitation_ba7f7e02:
    mike.say "Надо же..."

# ch/harmony/date.rpy:360
translate russian harmony_halloween_invitation_53073010:
    mike.say "Не верится, что уже снова это время года!"

# ch/harmony/date.rpy:362
translate russian harmony_halloween_invitation_77b7bc11:
    harmony.say "Хм..."

# ch/harmony/date.rpy:364
translate russian harmony_halloween_invitation_9fda2a98:
    harmony.say "Ты о том, что наступила осень?"

# ch/harmony/date.rpy:366
translate russian harmony_halloween_invitation_7e0a8c1f:
    mike.say "Именно, Хармони."

# ch/harmony/date.rpy:367
translate russian harmony_halloween_invitation_6cfac04b:
    mike.say "Как раз об этом."

# ch/harmony/date.rpy:369
translate russian harmony_halloween_invitation_6209c252:
    "Она дарит мне широкую, искреннюю улыбку."

# ch/harmony/date.rpy:370
translate russian harmony_halloween_invitation_89fef550:
    "И радостно кивает."

# ch/harmony/date.rpy:372
translate russian harmony_halloween_invitation_d5bc3e1b:
    harmony.say "Понимаю тебя, [lssb_harmony.hero_name()]."

# ch/harmony/date.rpy:373
translate russian harmony_halloween_invitation_8884c787:
    harmony.say "Я тоже люблю это время года."

# ch/harmony/date.rpy:374
translate russian harmony_halloween_invitation_53943db8:
    harmony.say "Огненные листья."

# ch/harmony/date.rpy:375
translate russian harmony_halloween_invitation_d6ca00e9:
    harmony.say "Ранние сумерки."

# ch/harmony/date.rpy:377
translate russian harmony_halloween_invitation_03360db5:
    "Прежде чем продолжить, она немного краснеет."

# ch/harmony/date.rpy:379
translate russian harmony_halloween_invitation_9e305907:
    harmony.say "Можно уютно прижаться к тому, кто тебе дорог!"

# ch/harmony/date.rpy:381
translate russian harmony_halloween_invitation_3ba5b28b:
    "Ого..."

# ch/harmony/date.rpy:382
translate russian harmony_halloween_invitation_b19531d6:
    "Какой приятный образ!"

# ch/harmony/date.rpy:383
translate russian harmony_halloween_invitation_2072ff34:
    "Но о чём я собирался говорить?"

# ch/harmony/date.rpy:384
translate russian harmony_halloween_invitation_6e070395:
    "Ах да, о Хэллоуине!"

# ch/harmony/date.rpy:385
translate russian harmony_halloween_invitation_687c8390:
    mike.say "И Хэллоуин, Хармони."

# ch/harmony/date.rpy:386
translate russian harmony_halloween_invitation_54a94370:
    mike.say "Не забывай про Хэллоуин!"

# ch/harmony/date.rpy:388
translate russian harmony_halloween_invitation_e51ffb70:
    harmony.say "Ох..."

# ch/harmony/date.rpy:389
translate russian harmony_halloween_invitation_04bdf4cf:
    harmony.say "Конечно."

# ch/harmony/date.rpy:391
translate russian harmony_halloween_invitation_aad35387:
    mike.say "Кстати, о Хэллоуине..."

# ch/harmony/date.rpy:392
translate russian harmony_halloween_invitation_c760d9f5:
    mike.say "Мы устраиваем вечеринку у меня дома."

# ch/harmony/date.rpy:393
translate russian harmony_halloween_invitation_75ec9ed5:
    mike.say "Я подумал, может, ты хочешь прийти?"

# ch/harmony/date.rpy:394
translate russian harmony_halloween_invitation_2f1910d2:
    mike.say "Ну, со мной, в качестве пары?"

# ch/harmony/date.rpy:396
translate russian harmony_halloween_invitation_0649abb3:
    "Хармони выглядит немного неловко, может, даже смущённо."

# ch/harmony/date.rpy:398
translate russian harmony_halloween_invitation_93cb2d01:
    harmony.say "Я... думаю, мне бы хотелось, [lssb_harmony.hero_name()]."

# ch/harmony/date.rpy:399
translate russian harmony_halloween_invitation_3884995f:
    harmony.say "Просто... ну..."

# ch/harmony/date.rpy:400
translate russian harmony_halloween_invitation_cabdc6b1:
    harmony.say "Я никогда не была на хэллоуинской вечеринке."

# ch/harmony/date.rpy:402
translate russian harmony_halloween_invitation_41358d1e:
    mike.say "Ты шутишь?!"

# ch/harmony/date.rpy:404
translate russian harmony_halloween_invitation_d3962681:
    "От моего удивления она краснеет."

# ch/harmony/date.rpy:406
translate russian harmony_halloween_invitation_676a789c:
    harmony.say "Мои родители были очень строгими, [lssb_harmony.hero_name()]."

# ch/harmony/date.rpy:407
translate russian harmony_halloween_invitation_8a02714f:
    harmony.say "Особенно в вопросах религии."

# ch/harmony/date.rpy:408
translate russian harmony_halloween_invitation_b984c382:
    harmony.say "Они считали, что праздновать Хэллоуин — всё равно что поклоняться дьяволу!"

# ch/harmony/date.rpy:410
translate russian harmony_halloween_invitation_68283597:
    mike.say "Ого, Хармони!"

# ch/harmony/date.rpy:411
translate russian harmony_halloween_invitation_bff90c04:
    mike.say "Слушай, обещаю, ничего такого не будет."

# ch/harmony/date.rpy:412
translate russian harmony_halloween_invitation_ddffe045:
    mike.say "Нечистый дух разве что из пунша потянет, если кто-то плеснёт туда спиртного."

# ch/harmony/date.rpy:414
translate russian harmony_halloween_invitation_13529ad0:
    "Она кивает и улыбается мне."

# ch/harmony/date.rpy:416
translate russian harmony_halloween_invitation_fef02de1:
    harmony.say "Я справлюсь, [lssb_harmony.hero_name()]."

# ch/harmony/date.rpy:417
translate russian harmony_halloween_invitation_fbe87171:
    harmony.say "Только пообещай присмотреть за мной."

# ch/harmony/date.rpy:419
translate russian harmony_halloween_invitation_6af936d4:
    mike.say "Конечно, Хармони."

# ch/harmony/date.rpy:420
translate russian harmony_halloween_invitation_1b41868d:
    mike.say "И поверь, ты отлично проведёшь время!"

# ch/harmony/date.rpy:424
translate russian harmony_halloween_invitation_485d6a33:
    "Хармони мгновенно расплывается в улыбке."

# ch/harmony/date.rpy:425
translate russian harmony_halloween_invitation_e52949e9:
    "Честно говоря, даже немного пугающей!"

# ch/harmony/date.rpy:427
translate russian harmony_halloween_invitation_9c5db439:
    harmony.say "Ты говоришь о настоящей хэллоуинской вечеринке, [lssb_harmony.hero_name()]?"

# ch/harmony/date.rpy:428
translate russian harmony_halloween_invitation_6b0da81e:
    harmony.say "С откровенными костюмами?"

# ch/harmony/date.rpy:429
translate russian harmony_halloween_invitation_9d79ee1d:
    harmony.say "Пуншем с алкоголем?"

# ch/harmony/date.rpy:430
translate russian harmony_halloween_invitation_a7193332:
    harmony.say "Может, даже с доской для вызова духов?!"

# ch/harmony/date.rpy:432
translate russian harmony_halloween_invitation_f1d8a63c:
    mike.say "Эм..."

# ch/harmony/date.rpy:433
translate russian harmony_halloween_invitation_2866e6cc:
    mike.say "Я... насчёт всего этого не знаю, Хармони!"

# ch/harmony/date.rpy:434
translate russian harmony_halloween_invitation_9ca713bb:
    mike.say "Это просто повод собраться компанией, понимаешь?"

# ch/harmony/date.rpy:435
translate russian harmony_halloween_invitation_216abc3a:
    mike.say "Немного выпить, поиграть, хорошо провести время."

# ch/harmony/date.rpy:439
translate russian harmony_halloween_invitation_e053268c:
    "Она с готовностью кивает."

# ch/harmony/date.rpy:441
translate russian harmony_halloween_invitation_9a90f201:
    harmony.say "Я только за!"

# ch/harmony/date.rpy:443
translate russian harmony_halloween_invitation_d88902e3:
    harmony.say "Мои родители были жуткими занудами, такими строгими."

# ch/harmony/date.rpy:444
translate russian harmony_halloween_invitation_ff78170e:
    harmony.say "В детстве мне не позволяли ничего грешного."

# ch/harmony/date.rpy:446
translate russian harmony_halloween_invitation_d62ec948:
    mike.say "Кажется, я начинаю понимать почему..."

# ch/harmony/date.rpy:448
translate russian harmony_halloween_invitation_54fb5992:
    harmony.say "А?"

# ch/harmony/date.rpy:449
translate russian harmony_halloween_invitation_d21d9c15:
    harmony.say "Что ты сказал?"

# ch/harmony/date.rpy:451
translate russian harmony_halloween_invitation_4e8435ae:
    mike.say "Да ничего..."

# ch/harmony/date.rpy:452
translate russian harmony_halloween_invitation_5440d40e:
    mike.say "Значит, записываю тебя в список гостей?"

# ch/harmony/date.rpy:454
translate russian harmony_halloween_invitation_3e6f0ce3:
    harmony.say "Конечно..."

# ch/harmony/date.rpy:455
translate russian harmony_halloween_invitation_b3f97c47:
    harmony.say "И я уже знаю, какой надену костюм!"

# ch/harmony/date.rpy:457
translate russian harmony_halloween_invitation_c24ecf1c:
    "Ну что ж, всё прошло хорошо."

# ch/harmony/date.rpy:458
translate russian harmony_halloween_invitation_4916d995:
    "Только почему мне теперь немного страшно?"

# ch/harmony/date.rpy:463
translate russian harmony_halloween_invitation_c0b4d6b8:
    "Хармони резко отстраняется."

# ch/harmony/date.rpy:464
translate russian harmony_halloween_invitation_1e947293:
    "Качает головой и грозит мне пальцем."

# ch/harmony/date.rpy:466
translate russian harmony_halloween_invitation_dea5522d:
    harmony.say "Как можно устраивать вечеринку в честь Хэллоуина, [lssb_harmony.hero_name()]?"

# ch/harmony/date.rpy:467
translate russian harmony_halloween_invitation_bba2276a:
    harmony.say "Разве ты не знаешь, что в эту ночь Сатана и его демоны бродят по земле?!"

# ch/harmony/date.rpy:469
translate russian harmony_halloween_invitation_925e3726:
    mike.say "Н... н... но, Хармони!"

# ch/harmony/date.rpy:470
translate russian harmony_halloween_invitation_c2163df5:
    mike.say "Это просто вечеринка, безобидное развлечение!"

# ch/harmony/date.rpy:472
translate russian harmony_halloween_invitation_0c843117:
    harmony.say "Нет, [lssb_harmony.hero_name()], это путь к поклонению дьяволу!"

# ch/harmony/date.rpy:474
translate russian harmony_halloween_invitation_bac079e7:
    harmony.say "Я буду делать то же, что и всегда в эту ночь."

# ch/harmony/date.rpy:476
translate russian harmony_halloween_invitation_4488a154:
    mike.say "И что же... именно?"

# ch/harmony/date.rpy:478
translate russian harmony_halloween_invitation_67295dba:
    harmony.say "Участвовать в ночном молитвенном бдении в церкви, конечно!"

# ch/harmony/date.rpy:479
translate russian harmony_halloween_invitation_2b8b97b3:
    harmony.say "И тебе стоит присоединиться."

# ch/harmony/date.rpy:481
translate russian harmony_halloween_invitation_cb835b14:
    mike.say "Эм... Я ещё дам знать, Хармони."

# ch/harmony/date.rpy:482
translate russian harmony_halloween_invitation_e531f257:
    mike.say "Похоже, ты слишком безудержна для меня!"

# ch/harmony/date.rpy:488
translate russian harmony_halloween_arrival_26a0215a:
    "Открывая дверь, мне, пожалуй, следовало быть осторожнее."

# ch/harmony/date.rpy:489
translate russian harmony_halloween_arrival_6bb9ae1f:
    "Особенно после происшествий с мечом Джека и трезубцем Скотти."

# ch/harmony/date.rpy:491
translate russian harmony_halloween_arrival_686515a6:
    "Но меня снова застают врасплох: что-то большое и мягкое утыкается мне в лицо."

# ch/harmony/date.rpy:492
translate russian harmony_halloween_arrival_9c23f641:
    mike.say "М-м-м..."

# ch/harmony/date.rpy:493
translate russian harmony_halloween_arrival_9f933d60:
    mike.say "М-м-х..."

# ch/harmony/date.rpy:494
translate russian harmony_halloween_arrival_ab95d724:
    mike.say "Не могу... дышать!"

# ch/harmony/date.rpy:496
translate russian harmony_halloween_arrival_0daf8a06:
    harmony.say "Ой..."

# ch/harmony/date.rpy:497
translate russian harmony_halloween_arrival_a63072b2:
    harmony.say "Прости, [lssb_harmony.hero_name()]!"

# ch/harmony/date.rpy:501
translate russian harmony_halloween_arrival_0714e427:
    "Лишь когда Хармони отступает, я вижу, что меня чуть не задушило."

# ch/harmony/date.rpy:502
translate russian harmony_halloween_arrival_706709a9:
    "Но даже после этого не могу обрести дар речи."

# ch/harmony/date.rpy:503
translate russian harmony_halloween_arrival_37d824ff:
    "Остаётся лишь пялиться на платье, обтягивающее её тело."

# ch/harmony/date.rpy:504
translate russian harmony_halloween_arrival_f136877e:
    "Красное, подчёркивающее каждый изгиб, в паре с длинными фиолетовыми перчатками."

# ch/harmony/date.rpy:505
translate russian harmony_halloween_arrival_19d2885a:
    "Волосы выкрашены в рыжий и зачёсаны набок, закрывая один из ярко накрашенных глаз."

# ch/harmony/date.rpy:506
translate russian harmony_halloween_arrival_4dd63520:
    mike.say "Д... Джессика..."

# ch/harmony/date.rpy:507
translate russian harmony_halloween_arrival_308081b1:
    mike.say "Джессика Банни!"

# ch/harmony/date.rpy:509
translate russian harmony_halloween_arrival_edda5f6b:
    harmony.say "Что скажешь, [lssb_harmony.hero_name()]?"

# ch/harmony/date.rpy:510
translate russian harmony_halloween_arrival_f6386978:
    harmony.say "Я не плохая... Просто так одета!"

# ch/harmony/date.rpy:512
translate russian harmony_halloween_arrival_7c1ed6dd:
    harmony.say "Хотя, боже мой, я в нём едва дышу и всё время его подтягиваю!"

# ch/harmony/date.rpy:513
translate russian harmony_halloween_arrival_26e79305:
    harmony.say "Решилась надеть только ради Хэллоуина. В любой другой вечер это точно был бы смертный грех!"

# ch/harmony/date.rpy:515
translate russian harmony_halloween_arrival_eec4de3c:
    harmony.say "Я чувствую себя ТАКОЙ раздетой, [lssb_harmony.hero_name()]. Всю дорогу сюда щёки горели!"

# ch/harmony/date.rpy:516
translate russian harmony_halloween_arrival_0532c808:
    harmony.say "Обещаешь сегодня быть рядом? Не думаю, что мне хватит смелости ходить так одной."

# ch/harmony/date.rpy:518
translate russian harmony_halloween_arrival_1cfb6619:
    harmony.say "Не буду врать: какая-то часть меня ужасно боялась выйти из дома в таком виде."

# ch/harmony/date.rpy:519
translate russian harmony_halloween_arrival_69e88203:
    harmony.say "А другой части... очень нравится, как все провожают меня глазами. Помоги мне, Боже."

# ch/harmony/date.rpy:521
translate russian harmony_halloween_arrival_e69f2193:
    harmony.say "Я выбрала его, потому что знала: ты будешь смотреть, [lssb_harmony.hero_name()]."

# ch/harmony/date.rpy:522
translate russian harmony_halloween_arrival_6884ede1:
    harmony.say "Прежняя я умерла бы от стыда. А сегодня хочу, чтобы на меня смотрели. И хочу, чтобы смотрел ты."

# ch/harmony/date.rpy:525
translate russian harmony_halloween_arrival_f8fc6940:
    harmony.say "Я нарядилась для тебя, [lssb_harmony.hero_name()]. Только для тебя."

# ch/harmony/date.rpy:526
translate russian harmony_halloween_arrival_b54e6ae8:
    harmony.say "Води меня повсюду, показывай всем, делай со мной сегодня что хочешь. Я твоя, можешь хвастаться."

# ch/harmony/date.rpy:528
translate russian harmony_halloween_arrival_4ff725b3:
    harmony.say "Каждый мужчина там будет представлять меня без этого платья, [lssb_harmony.hero_name()]."

# ch/harmony/date.rpy:529
translate russian harmony_halloween_arrival_57d6a069:
    harmony.say "А я буду наслаждаться каждой секундой. Грех ещё никогда не был таким приятным."

# ch/harmony/date.rpy:533
translate russian harmony_halloween_arrival_ba7f7e02:
    mike.say "Ого..."

# ch/harmony/date.rpy:534
translate russian harmony_halloween_arrival_70f39399:
    mike.say "Хармони... ты выглядишь..."

# ch/harmony/date.rpy:535
translate russian harmony_halloween_arrival_d22245f8:
    mike.say "Потрясающе... Ты выглядишь потрясающе!"

# ch/harmony/date.rpy:538
translate russian harmony_halloween_arrival_f90762d3:
    "Она улыбается и счастливо хихикает."

# ch/harmony/date.rpy:539
translate russian harmony_halloween_arrival_d83ba01c:
    "От этого её грудь тоже подрагивает."

# ch/harmony/date.rpy:541
translate russian harmony_halloween_arrival_59ee2222:
    harmony.say "Я так рада, что тебе нравится, [lssb_harmony.hero_name()]."

# ch/harmony/date.rpy:543
translate russian harmony_halloween_arrival_2f008d46:
    "Я могу лишь кивать в ошеломлённом молчании."

# ch/harmony/date.rpy:544
translate russian harmony_halloween_arrival_46a9b76e:
    "Хочу немедленно снова уткнуться головой ей в грудь!"

# ch/harmony/date.rpy:545
translate russian harmony_halloween_arrival_e9584bfc:
    mike.say "Д... да, Хармони."

# ch/harmony/date.rpy:546
translate russian harmony_halloween_arrival_a2790df3:
    mike.say "Я в восторге."

# ch/harmony/date.rpy:548
translate russian harmony_halloween_arrival_048b6592:
    harmony.say "Отлично... просто отлично."

# ch/harmony/date.rpy:549
translate russian harmony_halloween_arrival_adad36ff:
    harmony.say "Эм..."

# ch/harmony/date.rpy:550
translate russian harmony_halloween_arrival_149d1f3b:
    harmony.say "Может, зайдём внутрь?"

# ch/harmony/date.rpy:551
translate russian harmony_halloween_arrival_0ecd20c1:
    harmony.say "Ну, пока сегодняшний вечер не закончился?"

# ch/harmony/date.rpy:553
translate russian harmony_halloween_arrival_3399263d:
    "Наконец мне удаётся прийти в себя."

# ch/harmony/date.rpy:554
translate russian harmony_halloween_arrival_dc419c74:
    mike.say "Ох... да..."

# ch/harmony/date.rpy:555
translate russian harmony_halloween_arrival_0c84ae59:
    mike.say "Где мои манеры!"

# ch/harmony/date.rpy:556
translate russian harmony_halloween_arrival_85f5d119:
    mike.say "Заходи, Хармони."

# ch/harmony/date.rpy:558
translate russian harmony_halloween_arrival_f1d8a63c:
    mike.say "Эм..."

# ch/harmony/date.rpy:559
translate russian harmony_halloween_arrival_206cf696:
    mike.say "Это уже перебор, Хармони."

# ch/harmony/date.rpy:561
translate russian harmony_halloween_arrival_c96a4a9b:
    "Когда смысл моих слов доходит до неё, она хмурится."

# ch/harmony/date.rpy:562
translate russian harmony_halloween_arrival_6650886b:
    "Качает головой, не понимая моей реакции."

# ch/harmony/date.rpy:564
translate russian harmony_halloween_arrival_7c5a8b2d:
    harmony.say "Не понимаю, [lssb_harmony.hero_name()]."

# ch/harmony/date.rpy:565
translate russian harmony_halloween_arrival_066ee188:
    harmony.say "Я думала, тебе такое нравится."

# ch/harmony/date.rpy:566
translate russian harmony_halloween_arrival_4c402f27:
    harmony.say "Ты ведь всегда поощряешь мои откровенные наряды."

# ch/harmony/date.rpy:568
translate russian harmony_halloween_arrival_65b60a38:
    mike.say "Может, когда мы идём в клуб или ресторан."

# ch/harmony/date.rpy:569
translate russian harmony_halloween_arrival_53696916:
    mike.say "Но это просто домашняя вечеринка."

# ch/harmony/date.rpy:570
translate russian harmony_halloween_arrival_cd281fe0:
    mike.say "Я не хочу, чтобы все мои друзья на тебя пялились."

# ch/harmony/date.rpy:573
translate russian harmony_halloween_arrival_be621691:
    "Хармони занимает оборонительную позицию."

# ch/harmony/date.rpy:574
translate russian harmony_halloween_arrival_448d9817:
    "Скрещивает руки на груди."

# ch/harmony/date.rpy:576
translate russian harmony_halloween_arrival_ce970652:
    harmony.say "А, теперь понятно."

# ch/harmony/date.rpy:577
translate russian harmony_halloween_arrival_227ac73e:
    harmony.say "Тебе на меня пялиться можно."

# ch/harmony/date.rpy:578
translate russian harmony_halloween_arrival_3e09f562:
    harmony.say "А другим нельзя, да?"

# ch/harmony/date.rpy:579
translate russian harmony_halloween_arrival_d7792d3d:
    harmony.say "Ты ревнуешь из-за того, что на меня будут смотреть другие парни!"

# ch/harmony/date.rpy:581
translate russian harmony_halloween_arrival_bf459a3c:
    mike.say "Да..."

# ch/harmony/date.rpy:582
translate russian harmony_halloween_arrival_1ed212cc:
    mike.say "То есть нет..."

# ch/harmony/date.rpy:583
translate russian harmony_halloween_arrival_462735b0:
    mike.say "Эм... поговорим потом."

# ch/harmony/date.rpy:584
translate russian harmony_halloween_arrival_0923fdd8:
    mike.say "Ты уже здесь, так что всё."

# ch/harmony/date.rpy:595
translate russian harmony_halloween_party_25a40503:
    scottie.say "Ого..."

# ch/harmony/date.rpy:596
translate russian harmony_halloween_party_745d2c53:
    scottie.say "Сколько же весят эти штуки?!"

# ch/harmony/date.rpy:599
translate russian harmony_halloween_party_c9a54709:
    harmony.say "Ох! Боже мой..."

# ch/harmony/date.rpy:600
translate russian harmony_halloween_party_6a197602:
    harmony.say "Я... не знаю, куда смотреть. Прошу прощения!"

# ch/harmony/date.rpy:601
translate russian harmony_halloween_party_a503a263:
    harmony.say "Вот ИМЕННО поэтому и нужна скромность. Я так и знала!"

# ch/harmony/date.rpy:603
translate russian harmony_halloween_party_66a3c487:
    harmony.say "Ой! Эм..."

# ch/harmony/date.rpy:604
translate russian harmony_halloween_party_fc6a341b:
    harmony.say "С-спасибо? Наверное? Боже, у меня щёки горят."

# ch/harmony/date.rpy:606
translate russian harmony_halloween_party_73df5704:
    harmony.say "О боже..."

# ch/harmony/date.rpy:607
translate russian harmony_halloween_party_62cb72ee:
    harmony.say "Это ты со мной разговариваешь?"

# ch/harmony/date.rpy:608
translate russian harmony_halloween_party_e5ee2b16:
    harmony.say "Мне не должно нравиться, когда на меня так смотрят. И всё же..."

# ch/harmony/date.rpy:610
translate russian harmony_halloween_party_73df5704_1:
    harmony.say "О боже..."

# ch/harmony/date.rpy:611
translate russian harmony_halloween_party_e9f17637:
    harmony.say "Нравится то, что видишь?"

# ch/harmony/date.rpy:612
translate russian harmony_halloween_party_bb83d94b:
    harmony.say "Прости меня, Господи, но девушке так приятно быть в центре внимания."

# ch/harmony/date.rpy:615
translate russian harmony_halloween_party_2f622ef3:
    harmony.say "Давай, смотри сколько хочешь."

# ch/harmony/date.rpy:616
translate russian harmony_halloween_party_c4c67117:
    harmony.say "Только не мне решать, кому можно мной наслаждаться. Это решает [lssb_harmony.hero_name()]."

# ch/harmony/date.rpy:618
translate russian harmony_halloween_party_73df5704_2:
    harmony.say "О боже..."

# ch/harmony/date.rpy:619
translate russian harmony_halloween_party_e0f1dac3:
    harmony.say "Смотри сколько угодно, милый. За взгляд денег не берут."

# ch/harmony/date.rpy:620
translate russian harmony_halloween_party_35e1e0cb:
    harmony.say "Но на сегодня они уже заняты."

# ch/harmony/date.rpy:622
translate russian harmony_halloween_party_1c8f9032:
    "Я оборачиваюсь и вижу, как Скотти разговаривает с Хармони."

# ch/harmony/date.rpy:623
translate russian harmony_halloween_party_178751de:
    "У него глаза чуть из орбит не вылезают."

# ch/harmony/date.rpy:624
translate russian harmony_halloween_party_b2d455d0:
    "И я его прекрасно понимаю."

# ch/harmony/date.rpy:625
translate russian harmony_halloween_party_d803d539:
    "В этом платье Хармони выглядит потрясающе."

# ch/harmony/date.rpy:626
translate russian harmony_halloween_party_4bd3b254:
    "Но сегодня она пришла со мной."

# ch/harmony/date.rpy:627
translate russian harmony_halloween_party_d3f51fe7:
    "Хотя по её поведению этого не скажешь!"

# ch/harmony/date.rpy:630
translate russian harmony_halloween_party_d510a616:
    mike.say "Загляденье, правда?"

# ch/harmony/date.rpy:631
translate russian harmony_halloween_party_92ed3fb2:
    mike.say "А, Скотти?"

# ch/harmony/date.rpy:633
translate russian harmony_halloween_party_6d16f660:
    scottie.say "Д... да, чувак!"

# ch/harmony/date.rpy:635
translate russian harmony_halloween_party_f2463052:
    mike.say "Но они целиком мои."

# ch/harmony/date.rpy:636
translate russian harmony_halloween_party_9402091d:
    mike.say "Так что найди себе другую пару прелестей!"

# ch/harmony/date.rpy:637
translate russian harmony_halloween_party_8d4ca80e:
    "Я обнимаю Хармони за плечи и притягиваю к себе."

# ch/harmony/date.rpy:640
translate russian harmony_halloween_party_5fbfbd64:
    "Она хихикает и прижимается ко мне боком."

# ch/harmony/date.rpy:641
translate russian harmony_halloween_party_4920f443:
    "А Скотти встряхивается, словно только что очнулся."

# ch/harmony/date.rpy:643
translate russian harmony_halloween_party_af219e8c:
    scottie.say "Эм... ага..."

# ch/harmony/date.rpy:644
translate russian harmony_halloween_party_ca07175f:
    scottie.say "Без проблем, чувак."

# ch/harmony/date.rpy:646
translate russian harmony_halloween_party_bb15f979:
    scottie.say "Я просто смотрел — и всё!"

# ch/harmony/date.rpy:648
translate russian harmony_halloween_party_a7befe2a:
    "Я киваю."

# ch/harmony/date.rpy:649
translate russian harmony_halloween_party_93be769d:
    mike.say "Смотри сколько хочешь, Скотти."

# ch/harmony/date.rpy:650
translate russian harmony_halloween_party_296d4374:
    mike.say "Но трогать можно только мне!"

# ch/harmony/date.rpy:652
translate russian harmony_halloween_party_1c3987e5:
    mike.say "Эй, Скотти, отвали!"

# ch/harmony/date.rpy:653
translate russian harmony_halloween_party_62ded789:
    mike.say "Сегодня Хармони пришла со мной."

# ch/harmony/date.rpy:654
translate russian harmony_halloween_party_75ff7be4:
    mike.say "И мне не нравится, что ты к ней клеишься!"

# ch/harmony/date.rpy:656
translate russian harmony_halloween_party_4920f443_1:
    "А Скотти встряхивается, словно только что очнулся."

# ch/harmony/date.rpy:658
translate russian harmony_halloween_party_af219e8c_1:
    scottie.say "Эм... ага..."

# ch/harmony/date.rpy:659
translate russian harmony_halloween_party_ca07175f_1:
    scottie.say "Без проблем, чувак."

# ch/harmony/date.rpy:661
translate russian harmony_halloween_party_bb15f979_1:
    scottie.say "Я просто смотрел — и всё!"

# ch/harmony/date.rpy:663
translate russian harmony_halloween_party_a7befe2a_1:
    "Я киваю."

# ch/harmony/date.rpy:664
translate russian harmony_halloween_party_93be769d_1:
    mike.say "Смотри сколько хочешь, Скотти."

# ch/harmony/date.rpy:665
translate russian harmony_halloween_party_296d4374_1:
    mike.say "Но трогать можно только мне!"

# ch/harmony/date.rpy:670
translate russian harmony_halloween_party_2307efb2:
    "Хармони недовольно фыркает, когда Скотти поспешно уходит."

# ch/harmony/date.rpy:672
translate russian harmony_halloween_party_2c370983:
    harmony.say "Я всего лишь флиртовала, [lssb_harmony.hero_name()]."

# ch/harmony/date.rpy:673
translate russian harmony_halloween_party_ef9c343a:
    harmony.say "Не надо портить всё веселье!"

# ch/harmony/date.rpy:683
translate russian harmony_halloween_dance_f7d67c4e:
    harmony.say "Эй, [lssb_harmony.hero_name()]."

# ch/harmony/date.rpy:684
translate russian harmony_halloween_dance_26b9c537:
    harmony.say "Пойдём на танцпол!"

# ch/harmony/date.rpy:686
translate russian harmony_halloween_dance_ed442941:
    "По голосу Хармони ясно, что отказа она не примет."

# ch/harmony/date.rpy:687
translate russian harmony_halloween_dance_f1d8a63c:
    mike.say "Эм..."

# ch/harmony/date.rpy:688
translate russian harmony_halloween_dance_c4669ccc:
    mike.say "А что, Хармони?"

# ch/harmony/date.rpy:689
translate russian harmony_halloween_dance_ac1ef365:
    mike.say "Тебе нравится эта песня?"

# ch/harmony/date.rpy:691
translate russian harmony_halloween_dance_5ddf03f9:
    "Хармони хихикает и качает головой."

# ch/harmony/date.rpy:693
translate russian harmony_halloween_dance_ad082459:
    harmony.say "Что?"

# ch/harmony/date.rpy:694
translate russian harmony_halloween_dance_409dfdfb:
    harmony.say "А, нет, я её впервые слышу."

# ch/harmony/date.rpy:695
translate russian harmony_halloween_dance_20bcdef8:
    harmony.say "Мне просто хочется потанцевать!"

# ch/harmony/date.rpy:699
translate russian harmony_halloween_dance_f9a1fe80:
    "Я уже заметил, как Хармони поглядывает на Джека и Скотти."

# ch/harmony/date.rpy:700
translate russian harmony_halloween_dance_6201f53b:
    "И знаю, что они тоже обратили на неё внимание."

# ch/harmony/date.rpy:701
translate russian harmony_halloween_dance_cf2b1950:
    "Но какой толк пытаться её прятать?"

# ch/harmony/date.rpy:702
translate russian harmony_halloween_dance_94059eb3:
    "Может, стоит поступить наоборот?"

# ch/harmony/date.rpy:703
translate russian harmony_halloween_dance_286ae4e7:
    mike.say "Конечно, Хармони."

# ch/harmony/date.rpy:704
translate russian harmony_halloween_dance_24aa0d9a:
    mike.say "Пойдём танцевать!"

# ch/harmony/date.rpy:707
translate russian harmony_halloween_dance_71f48bbc:
    "Хармони радостно хлопает в ладоши."

# ch/harmony/date.rpy:709
translate russian harmony_halloween_dance_4b51594f:
    "И я веду её на импровизированный танцпол."

# ch/harmony/date.rpy:710
translate russian harmony_halloween_dance_2825282b:
    "Хармони с самого начала даёт понять, чего хочет."

# ch/harmony/date.rpy:712
translate russian harmony_halloween_dance_c1482d74:
    "Она прижимается ко мне и крепко обнимает."

# ch/harmony/date.rpy:713
translate russian harmony_halloween_dance_99b00394:
    "Я обнимаю её в ответ, ощущая соблазнительную мягкость её тела."

# ch/harmony/date.rpy:714
translate russian harmony_halloween_dance_df807609:
    "У меня сам собой вырывается глубокий выдох."

# ch/harmony/date.rpy:715
translate russian harmony_halloween_dance_78820f82:
    mike.say "Фух..."

# ch/harmony/date.rpy:716
translate russian harmony_halloween_dance_5b4b8769:
    mike.say "Какая же ты мягкая, Хармони!"

# ch/harmony/date.rpy:717
translate russian harmony_halloween_dance_5cdce9c8:
    harmony.say "М-м-м..."

# ch/harmony/date.rpy:718
translate russian harmony_halloween_dance_8c847ec8:
    harmony.say "Ты тоже очень приятный на ощупь, [lssb_harmony.hero_name()]."

# ch/harmony/date.rpy:721
translate russian harmony_halloween_dance_d20c3963:
    harmony.say "Такой твёрдый!"

# ch/harmony/date.rpy:722
translate russian harmony_halloween_dance_632e5be3:
    "Хармони хихикает, а я понимаю, что она права."

# ch/harmony/date.rpy:723
translate russian harmony_halloween_dance_0317eeb5:
    "Теперь у меня есть ещё одна причина не выпускать её из объятий."

# ch/harmony/date.rpy:724
translate russian harmony_halloween_dance_a4aeee9a:
    "Надо скрыть, как сильно она меня возбудила!"

# ch/harmony/date.rpy:725
translate russian harmony_halloween_dance_ab456a6b:
    "Само собой, бурных танцев у нас не получается."

# ch/harmony/date.rpy:726
translate russian harmony_halloween_dance_8929799e:
    "Всё это время я обнимаю Хармони, крепко прижимая к себе."

# ch/harmony/date.rpy:728
translate russian harmony_halloween_dance_0b415eaa:
    "Я невольно приподнимаю брови."

# ch/harmony/date.rpy:729
translate russian harmony_halloween_dance_bd38d6b8:
    "Намерения Хармони уже вызывают у меня подозрения."

# ch/harmony/date.rpy:730
translate russian harmony_halloween_dance_c19131c7:
    "Она чуть ли не при мне пожирала глазами Джека и Скотти."

# ch/harmony/date.rpy:731
translate russian harmony_halloween_dance_31e2223e:
    "Так что меньше всего мне хочется давать ей возможность красоваться."

# ch/harmony/date.rpy:732
translate russian harmony_halloween_dance_1cb4d97d:
    mike.say "Думаю, не стоит, Хармони."

# ch/harmony/date.rpy:734
translate russian harmony_halloween_dance_1f148c94:
    harmony.say "Ну-у..."

# ch/harmony/date.rpy:735
translate russian harmony_halloween_dance_31070bbf:
    harmony.say "Почему?"

# ch/harmony/date.rpy:737
translate russian harmony_halloween_dance_af39e6d4:
    mike.say "Хочу дождаться подходящей песни."

# ch/harmony/date.rpy:738
translate russian harmony_halloween_dance_fb6ed5ed:
    mike.say "Не волнуйся, как только её услышу, сразу скажу."

# ch/harmony/date.rpy:740
translate russian harmony_halloween_dance_f65f4de0:
    "Хармони скрещивает руки на груди."

# ch/harmony/date.rpy:741
translate russian harmony_halloween_dance_9cdfdd3c:
    "В этом платье ей это даётся нелегко."

# ch/harmony/date.rpy:743
translate russian harmony_halloween_dance_ce589391:
    harmony.say "Хм..."

# ch/harmony/date.rpy:744
translate russian harmony_halloween_dance_003da17c:
    harmony.say "С тобой никакого веселья!"

# ch/harmony/date.rpy:752
translate russian harmony_halloween_sex_43bf7785:
    "Уже поздно, и хотя вечеринка ещё не закончилась, она постепенно затихает."

# ch/harmony/date.rpy:753
translate russian harmony_halloween_sex_ba44e52f:
    "Все либо пьяны, либо устали, либо и то и другое, и охотно отдыхают вместо бурного веселья."

# ch/harmony/date.rpy:755
translate russian harmony_halloween_sex_9e60b27f:
    "Но одного взгляда на Хармони достаточно, чтобы понять: она исключение."

# ch/harmony/date.rpy:756
translate russian harmony_halloween_sex_c1ce9132:
    "С виду она, конечно, такая же спокойная и притихшая, как остальные гости."

# ch/harmony/date.rpy:757
translate russian harmony_halloween_sex_3eaab4cf:
    "Но по её глазам я вижу, что запас энергии у неё ещё есть."

# ch/harmony/date.rpy:758
translate russian harmony_halloween_sex_1541deac:
    "И как только мы вроде бы остаёмся одни, она переходит к действию."

# ch/harmony/date.rpy:760
translate russian harmony_halloween_sex_0072c1d1:
    harmony.say "Эй, [lssb_harmony.hero_name()]!"

# ch/harmony/date.rpy:762
translate russian harmony_halloween_sex_67bd1791:
    mike.say "А, да, Хармони?"

# ch/harmony/date.rpy:764
translate russian harmony_halloween_sex_399bd9c4:
    harmony.say "Где спальня кого-нибудь из твоих соседок?"

# ch/harmony/date.rpy:766
translate russian harmony_halloween_sex_0232e63e:
    "Вопрос такой странный, что я не сразу нахожусь с ответом."

# ch/harmony/date.rpy:767
translate russian harmony_halloween_sex_ce50fe98:
    "Я лишь качаю головой и недоумённо смотрю на неё."

# ch/harmony/date.rpy:768
translate russian harmony_halloween_sex_4cf775c5:
    mike.say "Что?"

# ch/harmony/date.rpy:769
translate russian harmony_halloween_sex_bccb6b29:
    mike.say "Наверху, слева."

# ch/harmony/date.rpy:770
translate russian harmony_halloween_sex_4efd274d:
    mike.say "Ты... ты хочешь спать?!"

# ch/harmony/date.rpy:772
translate russian harmony_halloween_sex_308ac2af:
    "Хармони смеётся и качает головой."

# ch/harmony/date.rpy:773
translate russian harmony_halloween_sex_5737c340:
    "В её глазах всё ещё горит нетерпеливый, чуть безумный огонёк."

# ch/harmony/date.rpy:775
translate russian harmony_halloween_sex_bcba1e00:
    harmony.say "Нет, нет, нет!"

# ch/harmony/date.rpy:776
translate russian harmony_halloween_sex_cf07769a:
    harmony.say "Я хочу, чтобы ты меня там трахнул."

# ch/harmony/date.rpy:778
translate russian harmony_halloween_sex_812272f5:
    "Я снова недоумённо моргаю."

# ch/harmony/date.rpy:779
translate russian harmony_halloween_sex_91fcbe69:
    "Хармони говорит так прямо и буднично."

# ch/harmony/date.rpy:780
translate russian harmony_halloween_sex_f29b65d0:
    "Мне требуется мгновение, чтобы осознать смысл её слов."

# ch/harmony/date.rpy:781
translate russian harmony_halloween_sex_1505de7f:
    mike.say "Ты хочешь заняться сексом в постели моей соседки?"

# ch/harmony/date.rpy:782
translate russian harmony_halloween_sex_3cb7e516:
    "Хармони кивает."

# ch/harmony/date.rpy:783
translate russian harmony_halloween_sex_dfc790ec:
    mike.say "Но... почему бы нам не пойти в мою постель?"

# ch/harmony/date.rpy:784
translate russian harmony_halloween_sex_d87e264f:
    mike.say "Она ведь ближе, да и удобнее будет."

# ch/harmony/date.rpy:786
translate russian harmony_halloween_sex_e8d4da1f:
    harmony.say "Это скучно, [lssb_harmony.hero_name()]!"

# ch/harmony/date.rpy:788
translate russian harmony_halloween_sex_4055159b:
    harmony.say "У нас вечеринка."

# ch/harmony/date.rpy:789
translate russian harmony_halloween_sex_1d342522:
    harmony.say "А на вечеринках люди тайком сбегают потрахаться!"

# ch/harmony/date.rpy:791
translate russian harmony_halloween_sex_bf82f052:
    mike.say "Наверное, ты права, Хармони..."

# ch/harmony/date.rpy:792
translate russian harmony_halloween_sex_15003079:
    "Не успеваю я больше ничего сказать, как Хармони хватает меня за запястье."

# ch/harmony/date.rpy:794
translate russian harmony_halloween_sex_66b71979:
    "И тащит в сторону спальни Саши."

# ch/harmony/date.rpy:795
translate russian harmony_halloween_sex_049866f4:
    "Конечно, я мог бы настоять на своём."

# ch/harmony/date.rpy:796
translate russian harmony_halloween_sex_9bb72ed5:
    "Сказать, что либо в моей комнате, либо никак."

# ch/harmony/date.rpy:797
translate russian harmony_halloween_sex_fca19d8e:
    "Но если Хармони хочется потрахаться в чужой, я не против."

# ch/harmony/date.rpy:798
translate russian harmony_halloween_sex_939aa267:
    "В конце концов, в этом есть своя пикантность и острые ощущения."

# ch/harmony/date.rpy:799
translate russian harmony_halloween_sex_6fb211db:
    "Найдя спальню Саши, Хармони не теряет времени."

# ch/harmony/date.rpy:801
translate russian harmony_halloween_sex_5656fc63:
    "Она открывает дверь и буквально заталкивает меня внутрь."

# ch/harmony/date.rpy:802
translate russian harmony_halloween_sex_0219857d:
    "Я вваливаюсь в комнату, едва не споткнувшись о бас-гитару Саши на стойке."

# ch/harmony/date.rpy:804
translate russian harmony_halloween_sex_e82984d6:
    "Но прежде чем я успеваю упасть, она набрасывается на меня!"

# ch/harmony/date.rpy:806
translate russian harmony_halloween_sex_8289b5dd:
    "Хармони захлопывает за собой дверь и кидается мне в объятия."

# ch/harmony/date.rpy:807
translate russian harmony_halloween_sex_020ba7c5:
    "Её тело ударяется о моё, руки обвивают меня."

# ch/harmony/date.rpy:808
translate russian harmony_halloween_sex_c49ee576:
    "Её грудь и бёдра мягкие и тёплые, как и губы."

# ch/harmony/date.rpy:809
translate russian harmony_halloween_sex_d10af51f:
    "И вскоре я забываю о неловкости."

# ch/harmony/date.rpy:816
translate russian harmony_halloween_sex_5cdce9c8:
    harmony.say "М-м-м..."

# ch/harmony/date.rpy:818
translate russian harmony_halloween_sex_5adff841:
    harmony.say "Я весь вечер этого ждала."

# ch/harmony/date.rpy:819
translate russian harmony_halloween_sex_f7062975:
    harmony.say "У меня такая мокрая киска..."

# ch/harmony/date.rpy:820
translate russian harmony_halloween_sex_bba3e820:
    harmony.say "Она хочет твой член..."

# ch/harmony/date.rpy:824
translate russian harmony_halloween_sex_8d09854e:
    "Мы падаем на кровать: Хармони оказывается на спине, а я — сверху."

# ch/harmony/date.rpy:825
translate russian harmony_halloween_sex_1a55f569:
    "Мне не нужно ждать, пока Хармони начнёт умолять."

# ch/harmony/date.rpy:826
translate russian harmony_halloween_sex_12d6db02:
    "Достаточно одного уверенного толчка вперёд и вверх..."

# ch/harmony/date.rpy:828
translate russian harmony_halloween_sex_bfeed941:
    harmony.say "Ох, блядь..."

# ch/harmony/date.rpy:829
translate russian harmony_halloween_sex_3b0ed575:
    harmony.say "Вот так..."

# ch/harmony/date.rpy:831
translate russian harmony_halloween_sex_00f435dd:
    harmony.say "Трахай меня, [lssb_harmony.hero_name()]... трахай сильнее!"

# ch/harmony/date.rpy:833
translate russian harmony_halloween_sex_996992b8:
    harmony.say "Пользуйся мной как хочешь. Я твоя, делай со мной что угодно!"

# ch/harmony/date.rpy:834
translate russian harmony_halloween_sex_cba31fbd:
    harmony.say "Моё тело — подношение, а ты — единственный алтарь, перед которым я теперь преклоняю колени..."

# ch/harmony/date.rpy:835
translate russian harmony_halloween_sex_8143b937:
    "Входить в Хармони — ни с чем не сравнимое ощущение."

# ch/harmony/date.rpy:836
translate russian harmony_halloween_sex_1d9cf237:
    "Внутри она такая же мягкая и податливая, как снаружи."

# ch/harmony/date.rpy:838
translate russian harmony_halloween_sex_f45ee09e:
    "Я с наслаждением проникаю в неё как можно глубже."

# ch/harmony/date.rpy:839
translate russian harmony_halloween_sex_2fa7f43a:
    "И с каждым моим движением она стонет от удовольствия."

# ch/harmony/date.rpy:840
translate russian harmony_halloween_sex_71d10cc3:
    "Теперь я беру инициативу на себя и прижимаю Хармони к матрасу."

# ch/harmony/date.rpy:842
translate russian harmony_halloween_sex_f24f8081:
    "А затем ускоряюсь, вбиваясь в неё всё сильнее."

# ch/harmony/date.rpy:843
translate russian harmony_halloween_sex_f4f429cc:
    "Обвив меня ногами, она принимает всё, что я ей даю."

# ch/harmony/date.rpy:844
translate russian harmony_halloween_sex_0fda0185:
    "Её пышное тело легко выдерживает мои толчки."

# ch/harmony/date.rpy:845
translate russian harmony_halloween_sex_8f045563:
    "Я слышу собственное тяжёлое дыхание, пока трахаю Хармони."

# ch/harmony/date.rpy:846
translate russian harmony_halloween_sex_45d2c82f:
    "Да и неистовый стук сердца невозможно не заметить."

# ch/harmony/date.rpy:847
translate russian harmony_halloween_sex_3ff512c8:
    "Видимо, сил у меня оставалось больше, чем я думал."

# ch/harmony/date.rpy:848
translate russian harmony_halloween_sex_3a83d792:
    "И это хорошо, потому что Хармони хочет получить всё!"

# ch/harmony/date.rpy:849
translate russian harmony_halloween_sex_f1f2c20a:
    "К этому времени её платье сползает, обнажая грудь."

# ch/harmony/date.rpy:850
translate russian harmony_halloween_sex_ee305a37:
    "И я не могу удержаться, чтобы не уткнуться лицом между её грудями."

# ch/harmony/date.rpy:851
translate russian harmony_halloween_sex_cca5c886:
    "Лишь вблизи понимаешь, насколько они огромные."

# ch/harmony/date.rpy:852
translate russian harmony_halloween_sex_b1e17109:
    "Уверен, между грудей Хармони можно задохнуться."

# ch/harmony/date.rpy:853
translate russian harmony_halloween_sex_200d61a9:
    "А эти соски — твёрдые, торчащие..."

# ch/harmony/date.rpy:854
translate russian harmony_halloween_sex_02cf8f62:
    "Сам не замечаю, как один из них оказывается у меня во рту."

# ch/harmony/date.rpy:855
translate russian harmony_halloween_sex_7b144576:
    "И я принимаюсь самозабвенно его сосать!"

# ch/harmony/date.rpy:856
translate russian harmony_halloween_sex_e51ffb70:
    harmony.say "Ох..."

# ch/harmony/date.rpy:857
translate russian harmony_halloween_sex_2bdd3c39:
    harmony.say "О боже..."

# ch/harmony/date.rpy:858
translate russian harmony_halloween_sex_1688ac8b:
    harmony.say "Я сейчас кончу!"

# ch/harmony/date.rpy:860
translate russian harmony_halloween_sex_517af4ee:
    "Хармони сжимает меня бёдрами."

# ch/harmony/date.rpy:862
translate russian harmony_halloween_sex_5329e1c3:
    "А её киска стискивает мой член, словно кулак."

# ch/harmony/date.rpy:864
translate russian harmony_halloween_sex_e923f132:
    "Не уверен, но, кажется, мы кончаем одновременно."

# ch/harmony/date.rpy:865
translate russian harmony_halloween_sex_748334d7:
    "И меня очень удивляет, что мы при этом не ломаем Сашину кровать."

# ch/harmony/events.rpy:828
translate russian harmony_event_03_d7d73a0b:
    "Я всё ещё сомневаюсь и переживаю, правильно ли поступил, согласившись изучать Библию с Хармони."

# ch/harmony/events.rpy:829
translate russian harmony_event_03_24e30930:
    "Это чувство не покидает меня даже в следующее воскресенье утром, когда мы садимся в церкви на первое занятие."

# ch/harmony/events.rpy:830
translate russian harmony_event_03_15c4089e:
    "Меня должно бы утешать, что Хармони тоже выглядит напряжённой и смущённой."

# ch/harmony/events.rpy:831
translate russian harmony_event_03_d085475a:
    "Но у неё есть преимущество: та бодрая, жизнерадостная маска, которую глубоко верующие, кажется, всегда умеют надеть."

# ch/harmony/events.rpy:833
translate russian harmony_event_03_d8f042ef:
    harmony.say "Ладно, [lssb_harmony.hero_name()], давай попробуем начать."

# ch/harmony/events.rpy:834
translate russian harmony_event_03_551f738f:
    harmony.say "Не волнуйся, я не кусаюсь!"

# ch/harmony/events.rpy:836
translate russian harmony_event_03_91e8c496:
    "Она хихикает и улыбается, явно пытаясь разрядить обстановку."

# ch/harmony/events.rpy:838
translate russian harmony_event_03_184b411a:
    "Но я могу лишь вымученно улыбнуться в ответ: перед глазами снова встаёт её лицо, забрызганное моей спермой."

# ch/harmony/events.rpy:840
translate russian harmony_event_03_287b7220:
    harmony.say "Если ты не против, я буду считать, что ты совсем новичок."

# ch/harmony/events.rpy:841
translate russian harmony_event_03_b85e61d8:
    harmony.say "Начнём с Книги Бытия и пойдём дальше."

# ch/harmony/events.rpy:843
translate russian harmony_event_03_1ecdbc57:
    "Хармони берёт свою зачитанную Библию и раскрывает её ближе к началу."

# ch/harmony/events.rpy:845
translate russian harmony_event_03_82e92024:
    harmony.say "Эм, [lssb_harmony.hero_name()], тебе тоже стоит открыть свою Библию!"

# ch/harmony/events.rpy:847
translate russian harmony_event_03_2a2b4216:
    "Свою Библию?"

# ch/harmony/events.rpy:848
translate russian harmony_event_03_9f8c9280:
    "О чём она?"

# ch/harmony/events.rpy:849
translate russian harmony_event_03_f35faf44:
    "Чёрт, я должен был принести собственный экземпляр?"

# ch/harmony/events.rpy:850
translate russian harmony_event_03_eb7acdc2:
    "Мне остаётся лишь беспомощно и довольно жалко пожать плечами."

# ch/harmony/events.rpy:851
translate russian harmony_event_03_3d6a1608:
    mike.say "А... прости, Хармони."

# ch/harmony/events.rpy:852
translate russian harmony_event_03_4995e2a7:
    mike.say "Наверное, оставил свою дома!"

# ch/harmony/events.rpy:853
translate russian harmony_event_03_77ff7930:
    "Хармони косится на меня, видимо, решив, что я ещё безнадёжнее, чем она думала."

# ch/harmony/events.rpy:855
translate russian harmony_event_03_4ca0d2c8:
    "Но снова напускает на себя бодрость и качает головой с натянутой улыбкой."

# ch/harmony/events.rpy:857
translate russian harmony_event_03_622f9486:
    harmony.say "Нет, не переживай. Ничего страшного."

# ch/harmony/events.rpy:858
translate russian harmony_event_03_a96bc96a:
    harmony.say "Наверное, мне просто стоило выразиться яснее."

# ch/harmony/events.rpy:859
translate russian harmony_event_03_21d9ba14:
    harmony.say "Вот, возьми одну из моих запасных Библий."

# ch/harmony/events.rpy:861
translate russian harmony_event_03_296ca6df:
    "Я стараюсь выглядеть довольным и обрадованным, пока Хармони достаёт из сумки вторую Библию."

# ch/harmony/events.rpy:862
translate russian harmony_event_03_7e60ee39:
    "Но не могу не удивляться, что она носит с собой запасную на случай таких чрезвычайных ситуаций."

# ch/harmony/events.rpy:863
translate russian harmony_event_03_17907dfa:
    "К тому же она сказала «запасных Библий», во множественном числе. Сколько же этих чёртовых книг она вообще таскает с собой?"

# ch/harmony/events.rpy:864
translate russian harmony_event_03_cba8fce5:
    "Отбросив бесполезные мысли, я принимаю Библию и торопливо нахожу нужную страницу."

# ch/harmony/events.rpy:866
translate russian harmony_event_03_8166cf10:
    harmony.say "Мне показалось, что нам подойдёт история об Адаме и Еве и о том, как змей их искушал."

# ch/harmony/events.rpy:867
translate russian harmony_event_03_88a9b24a:
    harmony.say "Думаю, ты согласишься, что в повседневной жизни сталкиваешься с похожими трудностями, [lssb_harmony.hero_name()]!"

# ch/harmony/events.rpy:869
translate russian harmony_event_03_3e755ac3:
    "Уж что-что, а соблазнительный запретный плод в священном месте меня точно искушает!"

# ch/harmony/events.rpy:870
translate russian harmony_event_03_10790e8d:
    "Хармони сразу переходит к делу и, кажется, предвкушает предстоящую работу."

# ch/harmony/events.rpy:871
translate russian harmony_event_03_c2740e10:
    "Особенно подходящие, по её мнению, стихи она зачитывает с таким пылом, словно хочет вбить эти слова мне прямо в голову."

# ch/harmony/events.rpy:872
translate russian harmony_event_03_8fbfa733:
    "Затем Хармони пытается раскрыть глубинный смысл, который, как она уверена, скрывается в этих стихах."

# ch/harmony/events.rpy:873
translate russian harmony_event_03_6d1a8282:
    "Наконец, после словесного натиска, который, кажется, длился несколько часов, она замолкает и склоняет голову набок."

# ch/harmony/events.rpy:875
translate russian harmony_event_03_cc5c160a:
    harmony.say "Ну что думаешь, [lssb_harmony.hero_name()]?"

# ch/harmony/events.rpy:879
translate russian harmony_event_03_a5e251c2:
    "Не знаю, то ли я так нервничаю, то ли меня всё ещё мучает искреннее чувство вины за случившееся в ванной."

# ch/harmony/events.rpy:880
translate russian harmony_event_03_882fc0f9:
    "Но что-то в словах Хармони и её объяснениях действительно меня трогает."

# ch/harmony/events.rpy:881
translate russian harmony_event_03_27861917:
    "Поначалу я кивал лишь затем, чтобы не раздражать её."

# ch/harmony/events.rpy:882
translate russian harmony_event_03_d3b241d3:
    "Теперь же замечаю, что киваю, действительно соглашаясь с её словами."

# ch/harmony/events.rpy:884
translate russian harmony_event_03_80fdbe51:
    mike.say "Теперь мне всё ясно, Хармони."

# ch/harmony/events.rpy:885
translate russian harmony_event_03_71df03f3:
    mike.say "Я и не знал, что все мои переживания, мысли и чувства уже описаны на этих страницах!"

# ch/harmony/events.rpy:887
translate russian harmony_event_03_9655ac31:
    "Если я и сомневался в собственных словах, все сомнения исчезают, когда Хармони улыбается в ответ."

# ch/harmony/events.rpy:888
translate russian harmony_event_03_268f55ae:
    "Её лицо так светится, что я забываю обо всём, что мы только что обсуждали."

# ch/harmony/events.rpy:889
translate russian harmony_event_03_38e0027f:
    "Боже, она просто ангел!"

# ch/harmony/events.rpy:890
translate russian harmony_event_03_a3131874:
    "Честно говоря, не знаю, поверил бы я в это всё, услышав от кого-то другого."

# ch/harmony/events.rpy:891
translate russian harmony_event_03_6222c5b8:
    "И отчасти уверен: даже говори она на иностранном языке, я всё равно кивал бы как дурак."

# ch/harmony/events.rpy:893
translate russian harmony_event_03_47134a77:
    harmony.say "Как приятно это слышать, [lssb_harmony.hero_name()]!"

# ch/harmony/events.rpy:894
translate russian harmony_event_03_2a4af5d0:
    harmony.say "Просто помни: вся мудрость, которая тебе когда-либо понадобится, собрана здесь."

# ch/harmony/events.rpy:896
translate russian harmony_event_03_043ea9eb:
    "С этими словами она прижимает Библию к своей более чем пышной груди."

# ch/harmony/events.rpy:897
translate russian harmony_event_03_42292118:
    "Я снова киваю, гадая, понимает ли она, насколько далеко мои мысли от самой Библии."

# ch/harmony/events.rpy:899
translate russian harmony_event_03_8fabc5e6:
    "Размышляя о нашем разговоре, я невольно недоумённо хмурюсь."

# ch/harmony/events.rpy:900
translate russian harmony_event_03_489eef41:
    "Прежде я никогда не садился и не задумывался так подробно о содержании Библии."

# ch/harmony/events.rpy:901
translate russian harmony_event_03_9759d6f8:
    "Я и раньше знал, что в ней полно странных историй и невероятных событий."

# ch/harmony/events.rpy:902
translate russian harmony_event_03_e04741ac:
    "Но всегда полагал, что, если прочитать их целиком, в них найдётся какой-то смысл."

# ch/harmony/events.rpy:903
translate russian harmony_event_03_dc5f6af7:
    "Теперь я в этом уже не так уверен..."

# ch/harmony/events.rpy:904
translate russian harmony_event_03_74cdc08e:
    mike.say "Эм, Хармони... У меня есть вопросы."

# ch/harmony/events.rpy:906
translate russian harmony_event_03_a9279f8c:
    "Она улыбается и кивает, предлагая мне поделиться тем, что меня волнует."

# ch/harmony/events.rpy:907
translate russian harmony_event_03_71e815d7:
    mike.say "Ладно... Для начала: зачем Бог положил прямо перед людьми плоды, которые им нельзя есть?"

# ch/harmony/events.rpy:909
translate russian harmony_event_03_ef600127:
    harmony.say "Ну, [lssb_harmony.hero_name()], понимаешь, Он хотел их испытать."

# ch/harmony/events.rpy:911
translate russian harmony_event_03_3719170a:
    mike.say "Но разве не змея это сделала?"

# ch/harmony/events.rpy:913
translate russian harmony_event_03_00738771:
    harmony.say "Нет-нет... Змей их искушал."

# ch/harmony/events.rpy:915
translate russian harmony_event_03_778e2263:
    mike.say "Тем, что Бог уже поместил туда, чтобы их испытать?"

# ch/harmony/events.rpy:917
translate russian harmony_event_03_7476c1ad:
    harmony.say "Да, наверное..."

# ch/harmony/events.rpy:919
translate russian harmony_event_03_f776429e:
    mike.say "Значит, Бог хотел, чтобы змея их искушала, верно?"

# ch/harmony/events.rpy:921
translate russian harmony_event_03_985a595a:
    harmony.say "Это был змей... И нет, по-моему, в истории совсем не об этом!"

# ch/harmony/events.rpy:923
translate russian harmony_event_03_d91a2555:
    mike.say "Почему? Разве Бог не избавился бы от змеи, если бы не хотел этого допустить?"

# ch/harmony/events.rpy:924
translate russian harmony_event_03_09f11d07:
    mike.say "Ну, поразил бы её карой какой-нибудь?"

# ch/harmony/events.rpy:926
translate russian harmony_event_03_96231eb8:
    "Улыбка Хармони становится всё более натянутой, а взгляд от моих вопросов почти стекленеет."

# ch/harmony/events.rpy:929
translate russian harmony_event_03_48004419:
    harmony.say "Я... Мне кажется, мы рискуем отвлечься от главного, [lssb_harmony.hero_name()]!"

# ch/harmony/events.rpy:930
translate russian harmony_event_03_783da2fb:
    harmony.say "Может... пока на этом остановимся?"

# ch/harmony/events.rpy:931
translate russian harmony_event_03_ae913fad:
    harmony.say "И продолжим через пару дней с того же места?"

# ch/harmony/events.rpy:932
translate russian harmony_event_03_feb79181:
    harmony.say "Когда мой мозг успеет восстановиться..."

# ch/harmony/events.rpy:934
translate russian harmony_event_03_2ab3e266:
    "На этом мы заканчиваем, и Хармони торопливо задаёт мне немного почитать к следующему занятию."

# ch/harmony/events.rpy:935
translate russian harmony_event_03_190fa3f4:
    "Я собираюсь вернуть Библию, но она останавливает меня и пододвигает книгу обратно."

# ch/harmony/events.rpy:937
translate russian harmony_event_03_b6d0dac2:
    harmony.say "Нет, лучше оставь её себе. Это мой подарок."

# ch/harmony/events.rpy:938
translate russian harmony_event_03_bb5751f8:
    harmony.say "У меня таких ещё много!"

# ch/harmony/events.rpy:940
translate russian harmony_event_03_43757732:
    "Я поспешно киваю: тепло её рук на моих трогает меня куда сильнее, чем подаренная Библия."

# ch/harmony/events.rpy:946
translate russian harmony_event_04_11ad3bc6:
    "Для второго занятия по изучению Библии я предложил сменить обстановку и встретиться в парке."

# ch/harmony/events.rpy:947
translate russian harmony_event_04_63f5066c:
    "Хармони тут же отвергла эту идею, и я задумался, не стесняется ли она появляться со мной на людях."

# ch/harmony/events.rpy:948
translate russian harmony_event_04_8e057a81:
    "Как бы то ни было, я спешу с Библией в руках в комнату при церкви, где мы договорились встретиться."

# ch/harmony/events.rpy:950
translate russian harmony_event_04_b6c318ec:
    "Хармони, конечно же, уже там. Она улыбается и похлопывает по стулу рядом с собой."

# ch/harmony/events.rpy:951
translate russian harmony_event_04_3d6c8031:
    "Меня и уговаривать не нужно: я торопливо подхожу и сажусь куда она предлагает."

# ch/harmony/events.rpy:953
translate russian harmony_event_04_ef69c058:
    harmony.say "Здравствуй, [lssb_harmony.hero_name()]. Правда, чудесный день?"

# ch/harmony/events.rpy:954
translate russian harmony_event_04_afe066cb:
    harmony.say "Божий дар, который поможет нам постичь мудрость Священного Писания!"

# ch/harmony/events.rpy:956
translate russian harmony_event_04_93923709:
    "Я киваю и достаю Библию, которую она подарила мне в конце прошлого занятия."

# ch/harmony/events.rpy:957
translate russian harmony_event_04_c0b3ad77:
    "Рядом с Хармони я всё ещё ужасно нервничаю, но смущаюсь уже гораздо меньше."

# ch/harmony/events.rpy:958
translate russian harmony_event_04_0ca293c6:
    "Возможно, стыд за случившееся в свободной комнате наконец начинает стираться из памяти."

# ch/harmony/events.rpy:959
translate russian harmony_event_04_77fca195:
    "А может, на меня просто так действует её близость..."

# ch/harmony/events.rpy:961
translate russian harmony_event_04_bde72262:
    harmony.say "Я подумала, сегодня можно немного забежать вперёд. Ты не против?"

# ch/harmony/events.rpy:963
translate russian harmony_event_04_1b6785f9:
    mike.say "Эм, ладно... Наверное, нет, Хармони."

# ch/harmony/events.rpy:965
translate russian harmony_event_04_03882fc4:
    "Она улыбается и кивает в ответ, явно наслаждаясь ролью учительницы с внимательным учеником."

# ch/harmony/events.rpy:967
translate russian harmony_event_04_1340f033:
    harmony.say "Но не слишком далеко: мы всё ещё останемся в Ветхом Завете."

# ch/harmony/events.rpy:968
translate russian harmony_event_04_62448299:
    harmony.say "Прочитаем историю о Давиде и Голиафе..."

# ch/harmony/events.rpy:970
translate russian harmony_event_04_b4f16986:
    "Дальше всё идёт примерно так же, как в прошлый раз."

# ch/harmony/events.rpy:971
translate russian harmony_event_04_2ac27a51:
    "Хармони зачитывает нужные отрывки, время от времени останавливаясь для пояснений."

# ch/harmony/events.rpy:972
translate russian harmony_event_04_b4cfac48:
    "И снова это одна из тех библейских историй, которые я знаю в общих чертах."

# ch/harmony/events.rpy:973
translate russian harmony_event_04_6c9225cd:
    "Но настолько подробно я её ещё никогда не разбирал."

# ch/harmony/events.rpy:974
translate russian harmony_event_04_07d248ff:
    "Мне кажется, я полностью погружаюсь в повествование, увлечённый ходом событий."

# ch/harmony/events.rpy:975
translate russian harmony_event_04_adb53e1f:
    "Но когда Хармони заканчивает читать и вопросительно смотрит на меня, я понимаю: всё это время я был очарован ею самой."

# ch/harmony/events.rpy:977
translate russian harmony_event_04_7878b1fd:
    harmony.say "Ну что скажешь, [lssb_harmony.hero_name()]?"

# ch/harmony/events.rpy:981
translate russian harmony_event_04_65edad31:
    "Мне хватает всего пары секунд, чтобы обдумать вопрос и найти ответ."

# ch/harmony/events.rpy:982
translate russian harmony_event_04_31b4fe23:
    "Кто знает, может, я и правда начинаю разбираться в изучении Библии?"

# ch/harmony/events.rpy:983
translate russian harmony_event_04_1817ba60:
    mike.say "Ну... ведь смысл не в том, чтобы ходить и убивать здоровяков в доспехах?"

# ch/harmony/events.rpy:985
translate russian harmony_event_04_3e8ba783:
    "Хармони отвечает своей обычной сдержанной улыбкой, но по глазам видно: ей не терпится услышать продолжение."

# ch/harmony/events.rpy:987
translate russian harmony_event_04_e86d4717:
    harmony.say "Продолжай, [lssb_harmony.hero_name()]. Объясни, что ты имеешь в виду."

# ch/harmony/events.rpy:989
translate russian harmony_event_04_5f08e1aa:
    mike.say "А, ладно..."

# ch/harmony/events.rpy:990
translate russian harmony_event_04_4d81d0e8:
    mike.say "Все эти здоровяки отказались сражаться с Голиафом, а Давид вызвался."

# ch/harmony/events.rpy:991
translate russian harmony_event_04_01d01b5d:
    mike.say "И победил, потому что верил и не боялся."

# ch/harmony/events.rpy:992
translate russian harmony_event_04_94f3fc30:
    "Я смотрю Хармони в глаза, ища подтверждение тому, что всё понял верно."

# ch/harmony/events.rpy:993
translate russian harmony_event_04_793de7f0:
    "Она молчит, но кивает, предлагая продолжать."

# ch/harmony/events.rpy:994
translate russian harmony_event_04_ecc7600c:
    mike.say "Я ведь в каком-то смысле похож на Давида?"

# ch/harmony/events.rpy:995
translate russian harmony_event_04_b34ce5cd:
    mike.say "А моя... эм... моя проблема..."

# ch/harmony/events.rpy:996
translate russian harmony_event_04_b403a4e9:
    "Я замолкаю и киваю вниз, примерно в сторону паха."

# ch/harmony/events.rpy:997
translate russian harmony_event_04_2bf31c5d:
    mike.say "Это вроде как мой собственный Голиаф... да?"

# ch/harmony/events.rpy:998
translate russian harmony_event_04_48507dcd:
    "На мгновение я даже пугаюсь, что она сейчас разнесёт мои рассуждения в пух и прах."

# ch/harmony/events.rpy:1000
translate russian harmony_event_04_074e3ee6:
    "Но Хармони кладёт Библию на колени и тихонько мне аплодирует."

# ch/harmony/events.rpy:1002
translate russian harmony_event_04_40884973:
    harmony.say "Совершенно верно, [lssb_harmony.hero_name()]!"

# ch/harmony/events.rpy:1003
translate russian harmony_event_04_b93daae9:
    harmony.say "Мы все похожи на Давида: нам нужно найти смелость, чтобы противостоять Голиафу."

# ch/harmony/events.rpy:1004
translate russian harmony_event_04_9506023a:
    harmony.say "Только у каждого из нас свой Голиаф внутри."

# ch/harmony/events.rpy:1007
translate russian harmony_event_04_816bf147:
    "Я широко улыбаюсь, чувствуя, как внутри разливается приятное тепло."

# ch/harmony/events.rpy:1008
translate russian harmony_event_04_a36e1e0d:
    "Но хоть убей, не могу понять: радуюсь ли я тому, что усвоил урок."

# ch/harmony/events.rpy:1009
translate russian harmony_event_04_4c362ba8:
    "Или тому, что Хармони так мной довольна."

# ch/harmony/events.rpy:1011
translate russian harmony_event_04_0457e272:
    mike.say "Я не знаю..."

# ch/harmony/events.rpy:1012
translate russian harmony_event_04_117063fe:
    mike.say "Но разве этот Давид не был тем ещё мудаком?"

# ch/harmony/events.rpy:1014
translate russian harmony_event_04_a251ba19:
    "Хармони открывает рот, собираясь что-то сказать, но затем лишь качает головой в явном изумлении."

# ch/harmony/events.rpy:1015
translate russian harmony_event_04_1a84924b:
    harmony.say "М... мудаком?"

# ch/harmony/events.rpy:1016
translate russian harmony_event_04_861c2c0d:
    harmony.say "Я... я не понимаю..."

# ch/harmony/events.rpy:1018
translate russian harmony_event_04_68021b64:
    "Я пожимаю плечами и стараюсь объяснить свою мысль как можно яснее."

# ch/harmony/events.rpy:1019
translate russian harmony_event_04_13bab70d:
    mike.say "Слушай, я уверен, что какая-то мораль здесь есть."

# ch/harmony/events.rpy:1020
translate russian harmony_event_04_f20b2b6d:
    mike.say "Ну, не знаю... Встреться со своими демонами лицом к лицу и не будь трусливой сучкой."

# ch/harmony/events.rpy:1021
translate russian harmony_event_04_c9c16f9f:
    mike.say "Но серьёзно: он ведь убил его из чёртовой пращи, издалека."

# ch/harmony/events.rpy:1022
translate russian harmony_event_04_53d55ae4:
    mike.say "Не очень-то это храбро или благородно, правда?"

# ch/harmony/events.rpy:1023
translate russian harmony_event_04_69b2aa9f:
    "Хармони подносит руку к губам и выглядит так, будто её мозг с трудом переваривает мои слова."

# ch/harmony/events.rpy:1024
translate russian harmony_event_04_0d56335e:
    mike.say "То есть урок в том... в чём? Что быть мудаком — хорошо?"

# ch/harmony/events.rpy:1027
translate russian harmony_event_04_90f24dcf:
    harmony.say "Я... я никогда не смотрела на это с такой стороны."

# ch/harmony/events.rpy:1028
translate russian harmony_event_04_86707cf5:
    harmony.say "Пока ты так не сказал."

# ch/harmony/events.rpy:1029
translate russian harmony_event_04_3c955d9a:
    harmony.say "Но, наверное, он и правда поступил не слишком храбро..."

# ch/harmony/events.rpy:1031
translate russian harmony_event_04_ac7be140:
    "Но тут Хармони качает головой."

# ch/harmony/events.rpy:1033
translate russian harmony_event_04_bc93ecff:
    harmony.say "Однако это было во время войны!"

# ch/harmony/events.rpy:1034
translate russian harmony_event_04_83e4744a:
    harmony.say "На войне нельзя применять те же нравственные мерки."

# ch/harmony/events.rpy:1036
translate russian harmony_event_04_b4a795a7:
    "Я хмурюсь, но всё же киваю."

# ch/harmony/events.rpy:1037
translate russian harmony_event_04_2078bd61:
    "В этом Хармони права."

# ch/harmony/events.rpy:1040
translate russian harmony_event_04_6f8c017a:
    "Но затем мне в голову приходит одна мысль."

# ch/harmony/events.rpy:1041
translate russian harmony_event_04_61394bd8:
    mike.say "Погоди-ка, Хармони..."

# ch/harmony/events.rpy:1042
translate russian harmony_event_04_f1487099:
    "Я начинаю листать её Библию в поисках нужного отрывка."

# ch/harmony/events.rpy:1043
translate russian harmony_event_04_5869f915:
    mike.say "Вот, в Книге Самуила..."

# ch/harmony/events.rpy:1044
translate russian harmony_event_04_b20fd15b:
    mike.say "Давид берёт Вирсавию в жёны."

# ch/harmony/events.rpy:1046
translate russian harmony_event_04_79f7bb61:
    harmony.say "Эм..."

# ch/harmony/events.rpy:1047
translate russian harmony_event_04_4f04e53b:
    harmony.say "И что в этом плохого?"

# ch/harmony/events.rpy:1049
translate russian harmony_event_04_45e1066b:
    mike.say "Сама прочти эту историю, Хармони."

# ch/harmony/events.rpy:1050
translate russian harmony_event_04_263237eb:
    mike.say "Она тогда была замужем за другим!"

# ch/harmony/events.rpy:1051
translate russian harmony_event_04_f925bd1e:
    "Я вижу, как лицо Хармони становится всё более растерянным."

# ch/harmony/events.rpy:1053
translate russian harmony_event_04_5cbaab44:
    harmony.say "О боже!"

# ch/harmony/events.rpy:1054
translate russian harmony_event_04_5d1dc366:
    harmony.say "Это совсем нехорошо!"

# ch/harmony/events.rpy:1056
translate russian harmony_event_04_d407f853:
    "Теперь уже моё лицо озаряется широкой улыбкой."

# ch/harmony/events.rpy:1057
translate russian harmony_event_04_86923ec0:
    mike.say "Здорово, Хармони."

# ch/harmony/events.rpy:1058
translate russian harmony_event_04_57402f54:
    mike.say "Правда чувствую, что на этом занятии мы оба чему-то учимся."

# ch/harmony/events.rpy:1059
translate russian harmony_event_04_7dd5b687:
    mike.say "Ну, ставим под сомнение свои убеждения и узнаём о себе что-то новое!"

# ch/harmony/events.rpy:1061
translate russian harmony_event_04_e013243b:
    harmony.say "Эм... да... наверное..."

# ch/harmony/events.rpy:1062
translate russian harmony_event_04_e1a59581:
    harmony.say "Слушай, может, на сегодня закончим, [lssb_harmony.hero_name()]?"

# ch/harmony/events.rpy:1064
translate russian harmony_event_04_70509f71:
    mike.say "О, ты устала?"

# ch/harmony/events.rpy:1066
translate russian harmony_event_04_7ce7e81e:
    harmony.say "Ну, скажем так: ты дал мне немало пищи для размышлений..."

# ch/harmony/events.rpy:1068
translate russian harmony_event_04_b8fb0907:
    "Я машу Хармони на прощание с чувством, что на этом занятии серьёзно продвинулся вперёд."

# ch/harmony/events.rpy:1069
translate russian harmony_event_04_ac1d1c14:
    "Хотя и не могу точно сказать, в чём именно."

# ch/harmony/events.rpy:1070
translate russian harmony_event_04_deee4b40:
    "Но что бы это ни было, есть ещё один плюс: я стал чуточку ближе к Хармони."

# ch/harmony/events.rpy:1077
translate russian harmony_event_05_c81e7b18:
    "Садясь в неуютной тесной комнатке, где до сих пор проходили все наши занятия по Библии, я чувствую что-то в воздухе."

# ch/harmony/events.rpy:1078
translate russian harmony_event_05_0fecf58e:
    "И это не только привычное сексуальное напряжение и жгучий стыд от воспоминания о том, как она застала меня в ванной."

# ch/harmony/events.rpy:1079
translate russian harmony_event_05_bad3b786:
    "Конечно, она приветливо улыбается, похлопывает по сиденью рядом с собой и берёт Библию."

# ch/harmony/events.rpy:1080
translate russian harmony_event_05_85f6f07e:
    "Но в ней чувствуется какая-то нервозность, из-за которой всё это кажется натянутым, словно даётся ей с трудом."

# ch/harmony/events.rpy:1081
translate russian harmony_event_05_6c458c44:
    mike.say "Эм, Хармони..."

# ch/harmony/events.rpy:1082
translate russian harmony_event_05_c633af0c:
    mike.say "Ты в порядке?"

# ch/harmony/events.rpy:1083
translate russian harmony_event_05_f946400f:
    mike.say "Ты выглядишь немного... ну, напряжённой."

# ch/harmony/events.rpy:1085
translate russian harmony_event_05_545c767b:
    "Улыбка Хармони становится ещё шире и мучительно неестественнее."

# ch/harmony/events.rpy:1086
translate russian harmony_event_05_40ab91b6:
    "Она качает головой, явно пытаясь отмахнуться от моих опасений и перейти к намеченной теме."

# ch/harmony/events.rpy:1088
translate russian harmony_event_05_04046df8:
    harmony.say "О чём ты, [lssb_harmony.hero_name()]?"

# ch/harmony/events.rpy:1090
translate russian harmony_event_05_8cc82d40:
    harmony.say "Я? Напряжена? Не говори глупостей!"

# ch/harmony/events.rpy:1092
translate russian harmony_event_05_d790c203:
    "Она замолкает, чтобы тихонько кашлянуть, и я замечаю, как её щёки на глазах заливает румянец."

# ch/harmony/events.rpy:1093
translate russian harmony_event_05_69d5e147:
    mike.say "Ты уверена?"

# ch/harmony/events.rpy:1094
translate russian harmony_event_05_e0c3ef4d:
    mike.say "Если плохо себя чувствуешь, мы всегда можем перенести занятие."

# ch/harmony/events.rpy:1096
translate russian harmony_event_05_d7fefe0c:
    harmony.say "Нет, правда, со мной всё хорошо."

# ch/harmony/events.rpy:1097
translate russian harmony_event_05_a2d873af:
    harmony.say "И вообще, это очень важный урок."

# ch/harmony/events.rpy:1098
translate russian harmony_event_05_adcad309:
    harmony.say "На этой неделе мы обойдёмся без чтения отрывка из Библии."

# ch/harmony/events.rpy:1100
translate russian harmony_event_05_0404e3c3:
    mike.say "Это как?"

# ch/harmony/events.rpy:1101
translate russian harmony_event_05_c90462f3:
    mike.say "Разве можно назвать это изучением Библии, если мы её не изучаем?"

# ch/harmony/events.rpy:1103
translate russian harmony_event_05_f876ccb9:
    "На лице Хармони вновь появляется натянутая улыбка, и она отмахивается от моего вопроса свободной рукой."

# ch/harmony/events.rpy:1105
translate russian harmony_event_05_f767f11b:
    harmony.say "Мне кажется, пора начать применять полученные знания к нашей жизни и привычкам."

# ch/harmony/events.rpy:1106
translate russian harmony_event_05_04a483ca:
    harmony.say "Точнее, к твоим, [lssb_harmony.hero_name()]."

# ch/harmony/events.rpy:1108
translate russian harmony_event_05_87bb14a5:
    "А... Надо было догадаться, что рано или поздно речь зайдёт об этом."

# ch/harmony/events.rpy:1109
translate russian harmony_event_05_d4d8de7a:
    mike.say "Ты про то, что случилось..."

# ch/harmony/events.rpy:1111
translate russian harmony_event_05_1fafcbf6:
    harmony.say "В свободной комнате, да."

# ch/harmony/events.rpy:1112
translate russian harmony_event_05_0f3c0c87:
    harmony.say "Но сами подробности неважны."

# ch/harmony/events.rpy:1113
translate russian harmony_event_05_9edf555b:
    harmony.say "По крайней мере, для этого урока."

# ch/harmony/events.rpy:1115
translate russian harmony_event_05_98b51e2a:
    "По тому, как торопливо Хармони обходит неприятные подробности, я понимаю: это воспоминание всё ещё её тревожит."

# ch/harmony/events.rpy:1116
translate russian harmony_event_05_e2ab8668:
    "Так вот почему я почувствовал напряжение, едва войдя в комнату?"

# ch/harmony/events.rpy:1118
translate russian harmony_event_05_bfd6c20e:
    harmony.say "Ты должен понимать: то, чем ты... занимался, не просто мерзко."

# ch/harmony/events.rpy:1119
translate russian harmony_event_05_47c236a3:
    harmony.say "Это ещё и грех, [lssb_harmony.hero_name()]!"

# ch/harmony/events.rpy:1121
translate russian harmony_event_05_8f1ba151:
    "Мне остаётся лишь пожать плечами и робко ответить."

# ch/harmony/events.rpy:1122
translate russian harmony_event_05_3c64a355:
    mike.say "Я... наверное, да."

# ch/harmony/events.rpy:1124
translate russian harmony_event_05_bd87e555:
    harmony.say "Бог дал тебе эти части тела, чтобы создавать новую жизнь, [lssb_harmony.hero_name()]."

# ch/harmony/events.rpy:1125
translate russian harmony_event_05_568e435e:
    harmony.say "А ты своим поступком растратил этот дар впустую."

# ch/harmony/events.rpy:1126
translate russian harmony_event_05_32cf0fce:
    harmony.say "Ради эгоистичного удовольствия!"

# ch/harmony/events.rpy:1128
translate russian harmony_event_05_31af3f71:
    "В голосе Хармони звучит странное рвение, когда она говорит на столь интимную тему."

# ch/harmony/events.rpy:1129
translate russian harmony_event_05_240111da:
    "То она словно пылает священной праведностью."

# ch/harmony/events.rpy:1130
translate russian harmony_event_05_7f9d0ea9:
    "То в её голосе появляется что-то мрачное и виноватое, когда она задерживается на подробностях греха."

# ch/harmony/events.rpy:1131
translate russian harmony_event_05_bbcc2033:
    mike.say "А если кто-то хочет... ну, заняться сексом без беременности?"

# ch/harmony/events.rpy:1132
translate russian harmony_event_05_7facabb4:
    mike.say "Разве этот дар не пропадает зря и тогда, когда парень надевает резинку?"

# ch/harmony/events.rpy:1134
translate russian harmony_event_05_312f888a:
    harmony.say "Контрацепция — ЗЛО! А презервативы — резиновые сапожки дьявола!"

# ch/harmony/events.rpy:1136
translate russian harmony_event_05_0e5ecd8e:
    "От этой вспышки я даже слегка отшатываюсь. Похоже, я задел её за живое."

# ch/harmony/events.rpy:1139
translate russian harmony_event_05_4d3efc9f:
    mike.say "Никогда не думал об этом с такой стороны, Хармони."

# ch/harmony/events.rpy:1140
translate russian harmony_event_05_26a0d76c:
    mike.say "Но если Бог дал нам эти неприличные части тела для зачатия детей, ты права."

# ch/harmony/events.rpy:1141
translate russian harmony_event_05_c104e181:
    mike.say "Использовать их ради плотских удовольствий было бы неправильно и порочно."

# ch/harmony/events.rpy:1143
translate russian harmony_event_05_d5471b0e:
    "Фанатичный блеск в глазах Хармони сменяется почти самодовольным удовлетворением."

# ch/harmony/events.rpy:1145
translate russian harmony_event_05_3e103042:
    harmony.say "Нет ничего плохого в том, чтобы мужчина и женщина славили Господа своими телами, [lssb_harmony.hero_name()]."

# ch/harmony/events.rpy:1146
translate russian harmony_event_05_f4d9c56b:
    harmony.say "Если они делают это в священных узах брака и не переходят к... ну, странным и богопротивным вещам."

# ch/harmony/events.rpy:1147
translate russian harmony_event_05_d1dc2d1e:
    harmony.say "И если им повезёт, их союз будет благословлён новой жизнью."

# ch/harmony/events.rpy:1149
translate russian harmony_event_05_cb277d9f:
    "Отложенное удовольствие — не самая заманчивая философия."

# ch/harmony/events.rpy:1150
translate russian harmony_event_05_12ad074a:
    "Но, может, это сработает?"

# ch/harmony/events.rpy:1151
translate russian harmony_event_05_64c3de2a:
    mike.say "Звучит чудесно, Хармони."

# ch/harmony/events.rpy:1152
translate russian harmony_event_05_c509b4fe:
    mike.say "Только боюсь, что я слишком слаб и слишком подвержен плотским искушениям!"

# ch/harmony/events.rpy:1155
translate russian harmony_event_05_5c405b9d:
    "Хармони кладёт руку на мою и снисходительно улыбается в ответ на признание в слабости."

# ch/harmony/events.rpy:1157
translate russian harmony_event_05_18a59539:
    harmony.say "Нужна сила, чтобы признать свою слабость, [lssb_harmony.hero_name()]."

# ch/harmony/events.rpy:1158
translate russian harmony_event_05_4b321486:
    harmony.say "Не волнуйся. Я помогу тебе пройти путь к праведности."

# ch/harmony/events.rpy:1160
translate russian harmony_event_05_9367c6c7:
    "Почему-то сама мысль о поддержке Хармони — исключительно духовной — очень меня утешает."

# ch/harmony/events.rpy:1161
translate russian harmony_event_05_0069b337:
    "С её помощью я, возможно, и смогу воплотить в жизнь эти идеи воздержания и целомудрия."

# ch/harmony/events.rpy:1163
translate russian harmony_event_05_c293fe51:
    mike.say "Прости, Хармони, но меня это совсем не убеждает!"

# ch/harmony/events.rpy:1166
translate russian harmony_event_05_1a2fae7c:
    harmony.say "Я... ч... что ты сказал?"

# ch/harmony/events.rpy:1167
translate russian harmony_event_05_ae5eb257:
    harmony.say "Ты не понял урока?"

# ch/harmony/events.rpy:1169
translate russian harmony_event_05_abdcae63:
    "Теперь уже я качаю головой, решительно отвергая это предположение."

# ch/harmony/events.rpy:1170
translate russian harmony_event_05_0c9fe67f:
    mike.say "Я понял, что ты сказала, Хармони."

# ch/harmony/events.rpy:1171
translate russian harmony_event_05_331724a6:
    mike.say "Просто считаю, что ты неправа. Вот и всё."

# ch/harmony/events.rpy:1173
translate russian harmony_event_05_85d37e7b:
    "Хармони хмурится: моё пренебрежение моралью, которую она так старается мне привить, начинает её раздражать."

# ch/harmony/events.rpy:1175
translate russian harmony_event_05_dcdd865a:
    harmony.say "Ах вот как ты считаешь?"

# ch/harmony/events.rpy:1177
translate russian harmony_event_05_e5d60e4b:
    mike.say "Ладно-ладно, выслушай меня."

# ch/harmony/events.rpy:1178
translate russian harmony_event_05_8284f6ee:
    mike.say "Бог создал тебя, верно?"

# ch/harmony/events.rpy:1179
translate russian harmony_event_05_1fccacd0:
    "Хармони кивает, продолжая хмуриться."

# ch/harmony/events.rpy:1180
translate russian harmony_event_05_32a5deaf:
    mike.say "И Он хочет, чтобы ты была счастлива, да?"

# ch/harmony/events.rpy:1181
translate russian harmony_event_05_c4965133:
    "Хармони снова кивает, теперь уже не понимая, к чему я веду."

# ch/harmony/events.rpy:1182
translate russian harmony_event_05_376f3e8c:
    mike.say "Тогда почему Он создал тебя так, что грех способен сделать тебя счастливой?"

# ch/harmony/events.rpy:1183
translate russian harmony_event_05_03067cd5:
    mike.say "И если секс нужен только для зачатия детей, почему начало этого процесса такое приятное?"

# ch/harmony/events.rpy:1184
translate russian harmony_event_05_137edd13:
    mike.say "Потому что, насколько я слышал, в конце веселья совсем мало!"

# ch/harmony/events.rpy:1186
translate russian harmony_event_05_54ad2c9e:
    "Хармони отводит взгляд и качает головой, словно пытаясь вытряхнуть из неё тревожные мысли."

# ch/harmony/events.rpy:1187
translate russian harmony_event_05_e914a51a:
    "Мои слова явно её задевают, иначе она бы уже читала мне проповедь или хотя бы возражала."

# ch/harmony/events.rpy:1190
translate russian harmony_event_05_321874f2:
    harmony.say "Нет, это... это порочно!"

# ch/harmony/events.rpy:1192
translate russian harmony_event_05_e8cdc803:
    mike.say "Вот взять то, чем я занимался в свободной комнате, Хармони."

# ch/harmony/events.rpy:1194
translate russian harmony_event_05_25cae7b2:
    harmony.say "[lssb_harmony.hero_name()], прошу... не надо!"

# ch/harmony/events.rpy:1196
translate russian harmony_event_05_b35e52fd:
    mike.say "Бог создал тебя красивой, желанной..."

# ch/harmony/events.rpy:1197
translate russian harmony_event_05_ef337729:
    mike.say "Меня побудила к этому твоя красота. Красота, данная тебе Богом."

# ch/harmony/events.rpy:1198
translate russian harmony_event_05_572dda2f:
    mike.say "Так что я в каком-то смысле восхвалял Его творение, как мы это делаем в церкви..."

# ch/harmony/events.rpy:1200
translate russian harmony_event_05_dfe041cb:
    harmony.say "[lssb_harmony.hero_name()], прекрати... пожалуйста!"

# ch/harmony/events.rpy:1202
translate russian harmony_event_05_ef45d005:
    "Я выполняю её просьбу, но вижу, как глубоко её задели мои слова."

# ch/harmony/events.rpy:1204
translate russian harmony_event_05_6b092bfa:
    "На этом мы заканчиваем занятие: нам обоим есть о чём подумать, и для этого хочется побыть наедине с собой."

# ch/harmony/events.rpy:1205
translate russian harmony_event_05_6e7cbe34:
    "Хармони необычно молчалива, когда мы выходим из комнаты и расходимся."

# ch/harmony/events.rpy:1207
translate russian harmony_event_05_3c9cc3bf:
    "И я гадаю, влияют ли эти занятия на неё так же сильно, как на меня."

# ch/harmony/events.rpy:1214
translate russian harmony_event_06_a4c02eca:
    "Приближается час нашего четвёртого занятия по Библии, и мне совсем не стоило бы так нервничать."

# ch/harmony/events.rpy:1215
translate russian harmony_event_06_77a0eda0:
    "Мы встречались уже несколько раз, и всё вроде бы шло неплохо."

# ch/harmony/events.rpy:1216
translate russian harmony_event_06_f34de4f2:
    "Если не считать немного неловкого начала..."

# ch/harmony/events.rpy:1217
translate russian harmony_event_06_3340a284:
    "Пора бы уже привыкнуть к тому, что мы проводим время наедине, верно?"

# ch/harmony/events.rpy:1218
translate russian harmony_event_06_abf1d48a:
    "Хотя, возможно, я меньше волновался бы, если бы мы перестали встречаться на нейтральной территории."

# ch/harmony/events.rpy:1219
translate russian harmony_event_06_10773da5:
    "Несмотря на все прошедшие занятия, мы по-прежнему встречаемся в той же комнате при церкви."

# ch/harmony/events.rpy:1220
translate russian harmony_event_06_8009e8c0:
    "Честно говоря, я уже не помню, как возникла эта идея, но с тех пор место не менялось."

# ch/harmony/events.rpy:1221
translate russian harmony_event_06_0badf180:
    "Зато помню: именно Хармони предложила узнать друг друга немного лучше."

# ch/harmony/events.rpy:1222
translate russian harmony_event_06_fcd6d163:
    "Видимо, она считает, что нам уже незачем держать столько преград между собой."

# ch/harmony/events.rpy:1223
translate russian harmony_event_06_e1309968:
    "А глубокие, содержательные беседы о слове Божьем должны легче даваться мне в Его доме."

# ch/harmony/events.rpy:1224
translate russian harmony_event_06_b220c3d1:
    "Конечно, сидеть так близко к такой девушке, как Хармони, мне совсем не трудно. Особенно в церкви!"

# ch/harmony/events.rpy:1225
translate russian harmony_event_06_eb89ca9c:
    "Если вы не поняли, это был сарказм."

# ch/harmony/events.rpy:1226
translate russian harmony_event_06_fad58846:
    "Мне и среди толпы нелегко находиться рядом с Хармони."

# ch/harmony/events.rpy:1227
translate russian harmony_event_06_8005710a:
    "Кроме этих занятий, мы были так близко наедине лишь однажды — в той ванной..."

# ch/harmony/events.rpy:1228
translate russian harmony_event_06_60da5fc1:
    "Но вряд ли сейчас стоит ворошить именно это воспоминание."

# ch/harmony/events.rpy:1230
translate russian harmony_event_06_0072c1d1:
    harmony.say "Привет, [lssb_harmony.hero_name()]!"

# ch/harmony/events.rpy:1231
translate russian harmony_event_06_e2544954:
    harmony.say "Прости, что у нас не получилось позаниматься у тебя."

# ch/harmony/events.rpy:1232
translate russian harmony_event_06_814e4c62:
    harmony.say "Уверена, у тебя очень... мило."

# ch/harmony/events.rpy:1234
translate russian harmony_event_06_9f8c9280:
    "Что она этим хочет сказать?"

# ch/harmony/events.rpy:1235
translate russian harmony_event_06_3281fc6b:
    "Думала, я живу в какой-нибудь захваченной развалюхе в плохом районе?!"

# ch/harmony/events.rpy:1236
translate russian harmony_event_06_a7d5c2ac:
    "Нет... нет, совсем не это. Просто невинное замечание, и ничего больше."

# ch/harmony/events.rpy:1237
translate russian harmony_event_06_6c3fae34:
    mike.say "А... спасибо, Хармони."

# ch/harmony/events.rpy:1238
translate russian harmony_event_06_f0a25468:
    mike.say "Только после моих соседок дом обычно выглядит так, будто туда попала бомба!"

# ch/harmony/events.rpy:1240
translate russian harmony_event_06_f3ec9d5f:
    "При упоминании [bree.name] и Саши по лицу Хармони пробегает явное неодобрение."

# ch/harmony/events.rpy:1242
translate russian harmony_event_06_73516587:
    harmony.say "Ах да, помню, ты о них говорил. [bree.name] и... Саша, верно?"

# ch/harmony/events.rpy:1244
translate russian harmony_event_06_c0e99bea:
    "Говорит она легко и непринуждённо, но, произнося имена девушек, слегка кривится."

# ch/harmony/events.rpy:1245
translate russian harmony_event_06_55eb9acb:
    "На мгновение мне кажется, будто её заставили вспомнить пару тараканов и ей это совсем не понравилось."

# ch/harmony/events.rpy:1246
translate russian harmony_event_06_36617f84:
    "Я уже собираюсь вступиться за них, но вспоминаю, насколько она религиозна и старомодна."

# ch/harmony/events.rpy:1247
translate russian harmony_event_06_5299ddfb:
    "Несомненно, сама мысль о двух молодых незамужних женщинах, живущих с мужчиной, кажется ей греховной."

# ch/harmony/events.rpy:1248
translate russian harmony_event_06_ee5739d5:
    "На секунду я задумываюсь, почему ко мне она относится иначе."

# ch/harmony/events.rpy:1249
translate russian harmony_event_06_9470d049:
    "Но потом вспоминаю: она ведь старается спасти мою душу от проклятия и, вероятно, хочет избавить меня от этой ужасной участи..."

# ch/harmony/events.rpy:1251
translate russian harmony_event_06_f2799553:
    "Хармони улыбается, достаёт Библию и жестом предлагает мне сделать то же самое."

# ch/harmony/events.rpy:1253
translate russian harmony_event_06_62b7525b:
    harmony.say "Итак, надеюсь, нам никто не помешает: сегодня мы затронем очень важную тему."

# ch/harmony/events.rpy:1254
translate russian harmony_event_06_527af818:
    harmony.say "Только не пугайся, [lssb_harmony.hero_name()]. Сегодня мы поговорим о том, что тесно связано с твоими личными проблемами."

# ch/harmony/events.rpy:1255
translate russian harmony_event_06_a779de67:
    harmony.say "Прочитаем историю Самсона и Далилы, а затем обсудим опасность необузданной страсти."

# ch/harmony/events.rpy:1257
translate russian harmony_event_06_2aca678e:
    "Я киваю, стараясь не показывать, как меня тревожат её планы."

# ch/harmony/events.rpy:1258
translate russian harmony_event_06_24d1e790:
    "Многие библейские истории я помню лишь смутно, но эту знаю."

# ch/harmony/events.rpy:1259
translate russian harmony_event_06_d92de8cd:
    "Чёрт, по ней даже фильм сняли!"

# ch/harmony/events.rpy:1260
translate russian harmony_event_06_176e3969:
    "Я улыбаюсь и киваю, пока Хармони рассказывает, как могучий Самсон истреблял филистимлян своей верной ослиной челюстью."

# ch/harmony/events.rpy:1261
translate russian harmony_event_06_865352b5:
    "Но к моменту, когда остриженный и преданный Самсон обрушивает здание на всех собравшихся, она уже вовсю входит во вкус."

# ch/harmony/events.rpy:1262
translate russian harmony_event_06_4ca419b2:
    "Описывая душевные терзания Самсона, она почти задыхается, а её грудь бурно вздымается."

# ch/harmony/events.rpy:1263
translate russian harmony_event_06_db2c8b91:
    "Господи, как же у меня сейчас от неё стоит!"

# ch/harmony/events.rpy:1266
translate russian harmony_event_06_c38cba8f:
    "Надо её остановить, а то, боюсь, я кончу прямо в штаны!"

# ch/harmony/events.rpy:1267
translate russian harmony_event_06_06deb8d1:
    mike.say "Хармони, я понял!"

# ch/harmony/events.rpy:1270
translate russian harmony_event_06_a8ec7aab:
    "Она внезапно замолкает и смотрит на меня глазами, пылающими от пережитых чувств."

# ch/harmony/events.rpy:1271
translate russian harmony_event_06_28b26b08:
    mike.say "Правда, понял!"

# ch/harmony/events.rpy:1272
translate russian harmony_event_06_953dd16e:
    mike.say "Бог наделил Самсона чудесным даром."

# ch/harmony/events.rpy:1273
translate russian harmony_event_06_ce2f2479:
    mike.say "А он всё растратил ради низменной страсти и тем самым навлёк на себя гнев Всевышнего!"

# ch/harmony/events.rpy:1275
translate russian harmony_event_06_96ab093f:
    "Я выпаливаю эти слова, а Хармони кивает всё горячее, пока я объясняю, что усвоил."

# ch/harmony/events.rpy:1276
translate russian harmony_event_06_9b7fae78:
    mike.say "Я шёл тем же путём, Хармони. Теперь я это вижу."

# ch/harmony/events.rpy:1277
translate russian harmony_event_06_acc48ca2:
    mike.say "И готов был всё обрушить на самого себя!"

# ch/harmony/events.rpy:1278
translate russian harmony_event_06_4962dbad:
    mike.say "Ну, в переносном смысле..."

# ch/harmony/events.rpy:1280
translate russian harmony_event_06_6b99a448:
    "У неё даже выступают слёзы, и она одобрительно хлопает в ладоши."

# ch/harmony/events.rpy:1282
translate russian harmony_event_06_b15c1227:
    harmony.say "О, [lssb_harmony.hero_name()], пелена наконец спала с твоих глаз!"

# ch/harmony/events.rpy:1284
translate russian harmony_event_06_0e800894:
    "Она обнимает меня, и я обнимаю её в ответ."

# ch/harmony/events.rpy:1285
translate russian harmony_event_06_4777ad5d:
    "Но впервые не чувствую ни неловкости, ни всепоглощающей похоти."

# ch/harmony/events.rpy:1286
translate russian harmony_event_06_0c529599:
    "Неужели это возможно?"

# ch/harmony/events.rpy:1287
translate russian harmony_event_06_ca2386f8:
    "Неужели она и вправду спасла мою душу?"

# ch/harmony/events.rpy:1289
translate russian harmony_event_06_f1ab9549:
    "Я должен её остановить: больше так продолжаться не может."

# ch/harmony/events.rpy:1290
translate russian harmony_event_06_06deb8d1_1:
    mike.say "Хармони, я понял!"

# ch/harmony/events.rpy:1292
translate russian harmony_event_06_a8ec7aab_1:
    "Она внезапно замолкает и смотрит на меня глазами, пылающими от пережитых чувств."

# ch/harmony/events.rpy:1293
translate russian harmony_event_06_28b26b08_1:
    mike.say "Правда, понял!"

# ch/harmony/events.rpy:1294
translate russian harmony_event_06_eafac785:
    mike.say "Я понял, чего ты всё это время добивалась."

# ch/harmony/events.rpy:1295
translate russian harmony_event_06_ce14e067:
    mike.say "Ты делала вид, что спасаешь меня, а на самом деле хотела, чтобы я спас тебя!"

# ch/harmony/events.rpy:1297
translate russian harmony_event_06_383c5f04:
    "Хармони собирается ответить, но слова замирают у неё на губах, когда до неё доходит сказанное."

# ch/harmony/events.rpy:1299
translate russian harmony_event_06_53375537:
    mike.say "Ты могла выбрать любую другую библейскую историю о любви, но выбрала именно эту."

# ch/harmony/events.rpy:1300
translate russian harmony_event_06_0f8f000a:
    mike.say "Теперь я понимаю: ты не меня имела в виду, говоря о Самсоне."

# ch/harmony/events.rpy:1301
translate russian harmony_event_06_2f1916cb:
    mike.say "Ты видела себя в Далиле!"

# ch/harmony/events.rpy:1303
translate russian harmony_event_06_0eb50da0:
    "Хармони начинает качать головой, пытаясь привычно вернуть себе контроль над разговором."

# ch/harmony/events.rpy:1305
translate russian harmony_event_06_001c65c5:
    harmony.say "Нет, [lssb_harmony.hero_name()]... Нет, ты неправильно понял, что я пыталась..."

# ch/harmony/events.rpy:1307
translate russian harmony_event_06_d8b1b859:
    mike.say "Нет, Хармони. Хватит лгать самой себе."

# ch/harmony/events.rpy:1308
translate russian harmony_event_06_9525cde5:
    mike.say "Ты ведь и сама понимаешь: будь Далила честна с собой, признайся она себе в любви к Самсону и останься ему верна..."

# ch/harmony/events.rpy:1309
translate russian harmony_event_06_2b145d71:
    mike.say "Ничего ужасного из того, что случилось в конце истории, могло бы и не произойти!"

# ch/harmony/events.rpy:1311
translate russian harmony_event_06_a64bdd80:
    "В её глазах растёт растерянность: она действительно начинает обдумывать мои слова."

# ch/harmony/events.rpy:1312
translate russian harmony_event_06_f6fd8905:
    "В глубине души она понимает, что в них есть смысл, хотя прежде никогда не смотрела на это с такой стороны."

# ch/harmony/events.rpy:1314
translate russian harmony_event_06_6c3f9ff5:
    mike.say "Бог создал нас обоих, Хармони."

# ch/harmony/events.rpy:1315
translate russian harmony_event_06_f098e2c5:
    mike.say "И если двое Его детей любят друг друга, кто мы такие, чтобы считать это неправильным?"

# ch/harmony/events.rpy:1316
translate russian harmony_event_06_1f2d35fc:
    mike.say "Разве есть более естественный и прекрасный способ восславить чудеса Его творения?"

# ch/harmony/events.rpy:1317
translate russian harmony_event_06_74b4e6c3:
    "Я наклоняюсь к ней так близко, как только осмеливаюсь, понимая: сейчас я либо выиграю всё, либо всё потеряю."

# ch/harmony/events.rpy:1323
translate russian harmony_event_06_754cbbbe:
    "Она не пытается меня остановить, когда мои губы касаются её губ."

# ch/harmony/events.rpy:1324
translate russian harmony_event_06_991a9ccc:
    "На одно страшное мгновение мне кажется, что сейчас она отпрянет и даст мне такую пощёчину, что искры из глаз посыплются."

# ch/harmony/events.rpy:1325
translate russian harmony_event_06_1c723336:
    "Но я чувствую, как её сопротивление слабеет, а через секунду словно совсем растворяется."

# ch/harmony/events.rpy:1326
translate russian harmony_event_06_e2d5e7be:
    "Хармони отвечает на поцелуй: её страсть нарастает постепенно, но вскоре становится упоительно сильной."

# ch/harmony/events.rpy:1327
translate russian harmony_event_06_b3a22314:
    "Конечно, она не срывает с меня одежду и не падает передо мной на пол."

# ch/harmony/events.rpy:1328
translate russian harmony_event_06_01051c43:
    "Но для такой нравственной и чистой девушки даже поцелуй — огромный шаг."

# ch/harmony/events.rpy:1329
translate russian harmony_event_06_0996cebe:
    "И главное, это отличное начало!"

# ch/harmony/events.rpy:1335
translate russian harmony_event_07_11625357:
    "Трудно придумать достаточно благопристойное свидание для такой девушки, как Хармони."

# ch/harmony/events.rpy:1336
translate russian harmony_event_07_6dd2a404:
    "В конце концов я выбираю первое, что приходит в голову без всяких непристойных намёков."

# ch/harmony/events.rpy:1337
translate russian harmony_event_07_b23939a6:
    mike.say "Эм, может, в следующую субботу покатаемся на роликах, Хармони?"

# ch/harmony/events.rpy:1339
translate russian harmony_event_07_86d41d03:
    "Хармони смотрит на меня с лёгким недоумением."

# ch/harmony/events.rpy:1340
translate russian harmony_event_07_2c404601:
    "Такого предложения она явно не ожидала."

# ch/harmony/events.rpy:1343
translate russian harmony_event_07_414b4c82:
    harmony.say "На роликах? О, какая хорошая, невинная идея!"

# ch/harmony/events.rpy:1344
translate russian harmony_event_07_6fa67310:
    harmony.say "В здоровой физической нагрузке нет ничего греховного. С удовольствием, [lssb_harmony.hero_name()]!"

# ch/harmony/events.rpy:1346
translate russian harmony_event_07_3043ec93:
    harmony.say "Конечно, [lssb_harmony.hero_name()]... почему бы и нет!"

# ch/harmony/events.rpy:1347
translate russian harmony_event_07_dad1aaaa:
    harmony.say "Я сто лет не надевала ролики. Будет весело!"

# ch/harmony/events.rpy:1349
translate russian harmony_event_07_2fc9030e:
    harmony.say "Покататься? Звучит неплохо..."

# ch/harmony/events.rpy:1350
translate russian harmony_event_07_86a16382:
    harmony.say "Наверное, мне понадобится кто-нибудь, кто поймает меня, если я упаду. Правда, [lssb_harmony.hero_name()]?"

# ch/harmony/events.rpy:1352
translate russian harmony_event_07_236fdf06:
    harmony.say "М-м-м, значит, на роликах ты будешь всё время меня держать..."

# ch/harmony/events.rpy:1353
translate russian harmony_event_07_f6fba694:
    harmony.say "Господи, помоги: я уже жду не дождусь, [lssb_harmony.hero_name()]."

# ch/harmony/events.rpy:1356
translate russian harmony_event_07_f4a06f15:
    harmony.say "Я согласна на всё, чем ты захочешь со мной заняться, [lssb_harmony.hero_name()]."

# ch/harmony/events.rpy:1357
translate russian harmony_event_07_fdfe982f:
    harmony.say "Только скажи — и я твоя на весь день."

# ch/harmony/events.rpy:1359
translate russian harmony_event_07_23a70295:
    harmony.say "Ролики, значит? Мило."

# ch/harmony/events.rpy:1360
translate russian harmony_event_07_05c3c80b:
    harmony.say "Главное, чтобы к концу ты из-за меня весь вспотел и запыхался, [lssb_harmony.hero_name()]."

# ch/harmony/events.rpy:1368
translate russian missed_harmony_event_08_5abfa82e:
    "Чёрт, я пропустил свидание. Хармони будет злиться."

# ch/harmony/events.rpy:1384
translate russian harmony_event_08_d42cb89c:
    "Часть меня всё ещё не верит, что я пригласил Хармони на свидание покататься на роликах."

# ch/harmony/events.rpy:1385
translate russian harmony_event_08_94c751da:
    "А другая половина откровенно поражена тем, что она согласилась!"

# ch/harmony/events.rpy:1386
translate russian harmony_event_08_0948b616:
    "Я пытался придумать что-нибудь весёлое, но не слишком банальное."

# ch/harmony/events.rpy:1387
translate russian harmony_event_08_e0bb9667:
    "Более невинное, чем обычное свидание, но и не совсем скучное."

# ch/harmony/events.rpy:1388
translate russian harmony_event_08_9ff59077:
    "И смог придумать только ролики."

# ch/harmony/events.rpy:1389
translate russian harmony_event_08_1504bab5:
    "Я решил, что так смогу держаться поближе к Хармони без всяких предлогов."

# ch/harmony/events.rpy:1390
translate russian harmony_event_08_6f0e7f9c:
    "Проблема в том, что я не катался с детства."

# ch/harmony/events.rpy:1391
translate russian harmony_event_08_3c2b5a6d:
    "Но Хармони я об этом не скажу!"

# ch/harmony/events.rpy:1392
translate russian harmony_event_08_3e521dac:
    "Вот так я и оказался в фойе роллердрома, ожидая её прихода."

# ch/harmony/events.rpy:1393
translate russian harmony_event_08_5c5d39bd:
    "Стараюсь не замечать, что большинство посетителей — дети с родителями."

# ch/harmony/events.rpy:1394
translate russian harmony_event_08_242c1605:
    "Такие дурацкие комплексы способны испортить вполне весёлое свидание."

# ch/harmony/events.rpy:1395
translate russian harmony_event_08_e6374320:
    "По крайней мере, в этом я убеждаю себя, оглядываясь в поисках Хармони."

# ch/harmony/events.rpy:1396
translate russian harmony_event_08_c210679c:
    "Когда она появляется, заметить её нетрудно."

# ch/harmony/events.rpy:1397
translate russian harmony_event_08_fefa40f9:
    "Во-первых, она одна из немногих взрослых, за кем не тянется стайка детей."

# ch/harmony/events.rpy:1398
translate russian harmony_event_08_6614e190:
    "А во-вторых, она, без сомнения, самая горячая девушка во всём зале..."

# ch/harmony/events.rpy:1413
translate russian harmony_event_08_92d18fa8:
    "Может, зря я посоветовал Хармони надеть что-нибудь свободное и короткое."

# ch/harmony/events.rpy:1414
translate russian harmony_event_08_27befe86:
    "Особенно когда вокруг столько невинных глаз!"

# ch/harmony/events.rpy:1415
translate russian harmony_event_08_a5193b75:
    "Кажется, она выбрала самую короткую и откровенную юбку, какую только можно вообразить."

# ch/harmony/events.rpy:1416
translate russian harmony_event_08_ca63a216:
    "Пока она идёт ко мне, отцы провожают её похотливыми взглядами, а матери смотрят так, будто готовы испепелить."

# ch/harmony/events.rpy:1417
translate russian harmony_event_08_da456d4f:
    "Лишь когда она подходит ближе, я замечаю кое-что, от чего у меня перехватывает дыхание."

# ch/harmony/events.rpy:1418
translate russian harmony_event_08_f1053bc2:
    "Не ручаюсь, но почти уверен: под этой юбкой у неё ничего нет!"

# ch/harmony/events.rpy:1420
translate russian harmony_event_08_f73d659e:
    "Я посоветовал Хармони надеть что-нибудь свободное и короткое."

# ch/harmony/events.rpy:1421
translate russian harmony_event_08_67e3381c:
    "И, судя по тому, как она покачивает бёдрами, приближаясь ко мне, она к совету прислушалась."

# ch/harmony/events.rpy:1422
translate russian harmony_event_08_2f9f643b:
    "Юбка у неё и правда очень короткая, и Хармони заботится о том, чтобы она подпрыгивала и задиралась при каждом шаге."

# ch/harmony/events.rpy:1423
translate russian harmony_event_08_a8813eb9:
    "Мой мгновенно вспыхнувший интерес тоже не ускользает от её внимания."

# ch/harmony/events.rpy:1424
translate russian harmony_event_08_50d2a431:
    "Заметив, как явно я одобряю её наряд, Хармони почти озорно улыбается."

# ch/harmony/events.rpy:1426
translate russian harmony_event_08_5ad4ec6a:
    "Похоже, Хармони прислушалась к моему совету насчёт одежды для катания."

# ch/harmony/events.rpy:1427
translate russian harmony_event_08_bcd57818:
    "Я предложил что-нибудь свободное и короткое, и её юбка точно отвечает обоим требованиям."

# ch/harmony/events.rpy:1428
translate russian harmony_event_08_a091df11:
    "Кажется, Хармони немного смущает её длина, особенно по сравнению с привычной одеждой."

# ch/harmony/events.rpy:1429
translate russian harmony_event_08_9492204a:
    "Но то, что она не одёргивает юбку каждую секунду, я считаю хорошим знаком."

# ch/harmony/events.rpy:1430
translate russian harmony_event_08_8f5b43ed:
    "Более того, моя одобрительная улыбка словно помогает ей меньше стесняться своего наряда."

# ch/harmony/events.rpy:1431
translate russian harmony_event_08_e7938517:
    "Когда Хармони наконец подходит, я заставляю себя улыбнуться и стараюсь забыть о её одежде."

# ch/harmony/events.rpy:1433
translate russian harmony_event_08_a7e24099:
    "Она улыбается в ответ, и её милое, невинное лицо озаряется, кажется, искренней радостью при виде меня."

# ch/harmony/events.rpy:1434
translate russian harmony_event_08_9cb17844:
    mike.say "Привет, Хармони."

# ch/harmony/events.rpy:1435
translate russian harmony_event_08_adb56836:
    mike.say "Как здорово, что ты решила прийти!"

# ch/harmony/events.rpy:1436
translate russian harmony_event_08_7084a24d:
    "Вот чёрт, зачем я выпалил такую жалкую фразу?"

# ch/harmony/events.rpy:1437
translate russian harmony_event_08_ded478ad:
    "Теперь кажется, будто я боялся, что она меня продинамит!"

# ch/harmony/events.rpy:1439
translate russian harmony_event_08_a6f5e589:
    "Хармони продолжает улыбаться, но удивлённо приподнимает брови."

# ch/harmony/events.rpy:1441
translate russian harmony_event_08_3f3f18e5:
    harmony.say "Ну конечно, я пришла, [lssb_harmony.hero_name()]!"

# ch/harmony/events.rpy:1442
translate russian harmony_event_08_cd6eea2d:
    harmony.say "Я просто ОБОЖАЮ кататься на роликах."

# ch/harmony/events.rpy:1444
translate russian harmony_event_08_e5201784:
    "Хармони подкрепляет свои слова широким жестом."

# ch/harmony/events.rpy:1446
translate russian harmony_event_08_5b877d4c:
    harmony.say "Раньше я постоянно каталась."

# ch/harmony/events.rpy:1447
translate russian harmony_event_08_e33b7fd6:
    harmony.say "Выиграла тогда кучу кубков и медалей."

# ch/harmony/events.rpy:1450
translate russian harmony_event_08_fa26c812:
    "Она, кажется, не замечает, как от этого признания у меня округляются глаза."

# ch/harmony/events.rpy:1452
translate russian harmony_event_08_ad04950a:
    harmony.say "Но не волнуйся: уверена, большинство старых движений я ещё помню!"

# ch/harmony/events.rpy:1454
translate russian harmony_event_08_c006a0b6:
    "Она подмигивает, берёт меня за руку и тащит к стойке проката роликов."

# ch/harmony/events.rpy:1456
translate russian harmony_event_08_c043079d:
    "Неудивительно, что она так охотно согласилась покататься."

# ch/harmony/events.rpy:1457
translate russian harmony_event_08_2f9b5e7a:
    "Да она какая-то олимпийская чемпионка по роликам!"

# ch/harmony/events.rpy:1458
translate russian harmony_event_08_145f1c5b:
    "А я сейчас буду выглядеть неуклюжим увальнем на колёсах..."

# ch/harmony/events.rpy:1459
translate russian harmony_event_08_91ce5da5:
    "Пока мы получаем и надеваем ролики, я всё боюсь выставить себя дураком."

# ch/harmony/events.rpy:1460
translate russian harmony_event_08_183d8403:
    "Только когда мы выезжаем на площадку, мои страхи немного стихают."

# ch/harmony/events.rpy:1461
translate russian harmony_event_08_c1d114bd:
    "Хармони снова хватает меня за руку и нетерпеливо тянет за собой."

# ch/harmony/events.rpy:1462
translate russian harmony_event_08_9e381c24:
    "К счастью, ей так хочется показать своё мастерство, что болтаться самому по себе она мне не даст!"

# ch/harmony/events.rpy:1464
translate russian harmony_event_08_71e48d46:
    "Я качусь следом, а она улыбается, явно наслаждаясь ролью ведущей."

# ch/harmony/events.rpy:1465
translate russian harmony_event_08_a0699e22:
    "Вскоре я и сам чувствую, что начинаю осваиваться."

# ch/harmony/events.rpy:1467
translate russian harmony_event_08_b9a07167:
    "Хармони тоже замечает, что я держусь увереннее."

# ch/harmony/events.rpy:1468
translate russian harmony_event_08_8356692c:
    "И вовлекает меня во всё более сложные движения, заставляя держаться ближе к ней."

# ch/harmony/events.rpy:1471
translate russian harmony_event_08_a6a4065e:
    "Может, я и начинаю увереннее чувствовать себя на роликах."

# ch/harmony/events.rpy:1472
translate russian harmony_event_08_7932f932:
    "Но мне всё ещё слишком не по себе, чтобы даже думать о том, чтобы повести самому."

# ch/harmony/events.rpy:1473
translate russian harmony_event_08_196b8047:
    "Так что я решаю расслабиться и отдать инициативу Хармони."

# ch/harmony/events.rpy:1474
translate russian harmony_event_08_f1543797:
    "Пока я здесь полный новичок, лучше вести себя прилично."

# ch/harmony/events.rpy:1475
translate russian harmony_event_08_e6112304:
    "Шалости на колёсах подождут!"

# ch/harmony/events.rpy:1478
translate russian harmony_event_08_72124d86:
    "Хармони почти сразу понимает, что я хочу следовать за ней."

# ch/harmony/events.rpy:1479
translate russian harmony_event_08_b3425a60:
    "И с явным удовольствием ведёт меня через сложную последовательность движений, которую сама придумала."

# ch/harmony/events.rpy:1480
translate russian harmony_event_08_3e066e1f:
    "Мы кружимся, разворачиваемся и меняем направление так быстро, что я порой не понимаю, куда еду!"

# ch/harmony/events.rpy:1481
translate russian harmony_event_08_5fe7f8cc:
    "И хотя мы почти не касаемся друг друга, ощущения всё равно потрясающие."

# ch/harmony/events.rpy:1482
translate russian harmony_event_08_3b996d4d:
    "Когда наша программа, похоже, заканчивается, Хармони выглядит искренне довольной моими успехами."

# ch/harmony/events.rpy:1483
translate russian harmony_event_08_4ab57a1a:
    "Она уводит меня с площадки, сияя от счастья и улыбаясь как Чеширский кот."

# ch/harmony/events.rpy:1487
translate russian harmony_event_08_72124d86_1:
    "Хармони почти сразу понимает, что я хочу следовать за ней."

# ch/harmony/events.rpy:1488
translate russian harmony_event_08_b3425a60_1:
    "И с явным удовольствием ведёт меня через сложную последовательность движений, которую сама придумала."

# ch/harmony/events.rpy:1489
translate russian harmony_event_08_3e066e1f_1:
    "Мы кружимся, разворачиваемся и меняем направление так быстро, что я порой не понимаю, куда еду!"

# ch/harmony/events.rpy:1490
translate russian harmony_event_08_c3ac5a95:
    "Пару раз мы почти соприкасаемся, но я стараюсь держать дистанцию."

# ch/harmony/events.rpy:1491
translate russian harmony_event_08_346000a6:
    "Когда наша программа, похоже, заканчивается, Хармони выглядит вполне довольной моими успехами."

# ch/harmony/events.rpy:1492
translate russian harmony_event_08_b954c977:
    "Она улыбается, но я гадаю, не ждала ли она от меня чуть больше инициативы."

# ch/harmony/events.rpy:1496
translate russian harmony_event_08_72124d86_2:
    "Хармони почти сразу понимает, что я хочу следовать за ней."

# ch/harmony/events.rpy:1497
translate russian harmony_event_08_56e3db20:
    "Но заодно воспринимает это как явное приглашение ни в чём себе не отказывать."

# ch/harmony/events.rpy:1498
translate russian harmony_event_08_3e066e1f_2:
    "Мы кружимся, разворачиваемся и меняем направление так быстро, что я порой не понимаю, куда еду!"

# ch/harmony/events.rpy:1499
translate russian harmony_event_08_3036e888:
    "Она всё время прижимается ко мне и трётся об меня."

# ch/harmony/events.rpy:1500
translate russian harmony_event_08_51c21af1:
    "Хармони изо всех сил старается затащить мои руки под свою и без того крохотную юбку."

# ch/harmony/events.rpy:1501
translate russian harmony_event_08_d176b99d:
    "Но я постоянно уклоняюсь от её заигрываний, и в итоге она остаётся неудовлетворённой."

# ch/harmony/events.rpy:1502
translate russian harmony_event_08_dde736ef:
    "Когда она уводит меня с площадки, то выглядит взбудораженной и раздражённой."

# ch/harmony/events.rpy:1506
translate russian harmony_event_08_72124d86_3:
    "Хармони почти сразу понимает, что я хочу следовать за ней."

# ch/harmony/events.rpy:1507
translate russian harmony_event_08_29e14c07:
    "Но по тому, как она ведёт меня дальше, я понимаю: ей это не очень нравится."

# ch/harmony/events.rpy:1508
translate russian harmony_event_08_3e066e1f_3:
    "Мы кружимся, разворачиваемся и меняем направление так быстро, что я порой не понимаю, куда еду!"

# ch/harmony/events.rpy:1509
translate russian harmony_event_08_9ad85013:
    "Кажется, Хармони использует любую возможность, чтобы прижаться ко мне."

# ch/harmony/events.rpy:1510
translate russian harmony_event_08_4aab9b08:
    "А я уклоняюсь и делаю всё, чтобы вести себя прилично перед нашей юной публикой."

# ch/harmony/events.rpy:1511
translate russian harmony_event_08_f5175284:
    "Поэтому, когда она уводит меня с площадки, то выглядит довольно раздосадованной и раздражённой."

# ch/harmony/events.rpy:1515
translate russian harmony_event_08_72124d86_4:
    "Хармони почти сразу понимает, что я хочу следовать за ней."

# ch/harmony/events.rpy:1516
translate russian harmony_event_08_6761f95e:
    "Она не возражает и ведёт меня через сложную последовательность движений собственного сочинения."

# ch/harmony/events.rpy:1517
translate russian harmony_event_08_3e066e1f_4:
    "Мы кружимся, разворачиваемся и меняем направление так быстро, что я порой не понимаю, куда еду!"

# ch/harmony/events.rpy:1518
translate russian harmony_event_08_07b8d940:
    "Она не раз прижимается ко мне, но я стараюсь не переходить границ приличия."

# ch/harmony/events.rpy:1519
translate russian harmony_event_08_ff25ca52:
    "Когда наша программа, похоже, заканчивается, Хармони приветливо мне улыбается."

# ch/harmony/events.rpy:1520
translate russian harmony_event_08_6177d94b:
    "Но я сразу чувствую: она была бы счастливее, прояви я больше инициативы."

# ch/harmony/events.rpy:1523
translate russian harmony_event_08_24e6819f:
    "На роликах я чувствую себя всё увереннее."

# ch/harmony/events.rpy:1524
translate russian harmony_event_08_30a3e45b:
    "Настолько, что, едва мы выезжаем на площадку, я без колебаний беру инициативу на себя."

# ch/harmony/events.rpy:1525
translate russian harmony_event_08_f146b8d5:
    "Хармони удивлена: наверное, она думала, что вести будет она."

# ch/harmony/events.rpy:1526
translate russian harmony_event_08_c3477c80:
    "Сейчас я ей покажу, что перед ней не полный новичок."

# ch/harmony/events.rpy:1527
translate russian harmony_event_08_96f5ceaf:
    "И скрывать от неё свои желания я тоже не собираюсь..."

# ch/harmony/events.rpy:1530
translate russian harmony_event_08_b62f5b30:
    "Хармони мгновенно напрягается и почти каменеет, поняв мои истинные намерения."

# ch/harmony/events.rpy:1531
translate russian harmony_event_08_ef995823:
    "Мне не удаётся осуществить даже малой части задуманного."

# ch/harmony/events.rpy:1532
translate russian harmony_event_08_9b109cbb:
    "Словно у неё шестое чувство на непристойные намерения и терпеть их она не намерена."

# ch/harmony/events.rpy:1533
translate russian harmony_event_08_ab151ee3:
    "То немногое, что у меня получается, выходит ужасно неловким и разочаровывающим."

# ch/harmony/events.rpy:1534
translate russian harmony_event_08_9d7e2bbb:
    "А Хармони всё это время остаётся негнущейся, словно труп."

# ch/harmony/events.rpy:1535
translate russian harmony_event_08_f77c91b6:
    "При первой возможности она вырывается и сердито уезжает с площадки."

# ch/harmony/events.rpy:1539
translate russian harmony_event_08_384340dc:
    "Хармони заметно напрягается, едва понимает, что я собираюсь вести."

# ch/harmony/events.rpy:1540
translate russian harmony_event_08_5797c9ad:
    "А когда до неё доходит, что я хочу держаться как можно ближе, её лицо застывает от испуга."

# ch/harmony/events.rpy:1541
translate russian harmony_event_08_ad0a91a5:
    "Какое-то время она подчиняется, но постоянно озирается."

# ch/harmony/events.rpy:1542
translate russian harmony_event_08_2885f9df:
    "Будто уверена, что нас в любую минуту выгонят за непристойное поведение."

# ch/harmony/events.rpy:1543
translate russian harmony_event_08_3471ad7e:
    "Всё время на площадке она так и не расслабляется."

# ch/harmony/events.rpy:1544
translate russian harmony_event_08_52a3e1c5:
    "А когда мы уходим, молчит и смотрит в пол перед собой."

# ch/harmony/events.rpy:1548
translate russian harmony_event_08_f3ba49b0:
    "Хармони отдаёт себя в мои руки почти сразу, как мы выезжаем на площадку."

# ch/harmony/events.rpy:1549
translate russian harmony_event_08_29104f87:
    "Если она и пользуется своим превосходством в катании, то лишь затем, чтобы я всё время её держал."

# ch/harmony/events.rpy:1550
translate russian harmony_event_08_ff5f58d4:
    "Я-то всего лишь собирался устроить нам горячие танцы, пока мы катаемся по кругу."

# ch/harmony/events.rpy:1551
translate russian harmony_event_08_2b44257b:
    "Но при первой же возможности Хармони хватает мою руку и суёт себе под юбку."

# ch/harmony/events.rpy:1552
translate russian harmony_event_08_a5f2bde5:
    "Мгновение спустя я уже точно знаю, что трусиков на ней нет и что там у неё чертовски мокро."

# ch/harmony/events.rpy:1553
translate russian harmony_event_08_8d6c3371:
    "Она слышно стонет, когда я глажу её между ног, и в ответ довольно крепко сжимает мой член!"

# ch/harmony/events.rpy:1554
translate russian harmony_event_08_7a051138:
    "То, что никто, кажется, не замечает происходящего, — маленькое чудо."

# ch/harmony/events.rpy:1555
translate russian harmony_event_08_3dab9b01:
    "Когда мы наконец покидаем площадку, я почти согнут пополам и могу думать лишь о том, как войти в Хармони..."

# ch/harmony/events.rpy:1559
translate russian harmony_event_08_6c3b76a9:
    "Хармони ничуть не удивляется, когда я даю понять, что вести собираюсь я."

# ch/harmony/events.rpy:1560
translate russian harmony_event_08_1e3acce8:
    "И вместо того чтобы с помощью своего мастерства ускользать от моих ухаживаний, делает ровно наоборот."

# ch/harmony/events.rpy:1561
translate russian harmony_event_08_a633db92:
    "Куда бы мы ни ехали, я постоянно чувствую прижатое ко мне мягкое, тёплое тело."

# ch/harmony/events.rpy:1562
translate russian harmony_event_08_f3cfeae4:
    "Мне почти не приходится стараться: Хармони буквально прилипает ко мне."

# ch/harmony/events.rpy:1563
translate russian harmony_event_08_6dd0e4df:
    "Она ясно даёт понять, что тоже возбуждена: тяжело дышит и вздыхает мне на ухо."

# ch/harmony/events.rpy:1564
translate russian harmony_event_08_80c66b7c:
    "К тому времени, как мы наконец покидаем площадку, мне жарко, я весь в поту и без сил."

# ch/harmony/events.rpy:1565
translate russian harmony_event_08_f9296858:
    "Я слежу, чтобы Хармони оставалась прямо передо мной и скрывала мой каменный стояк."

# ch/harmony/events.rpy:1569
translate russian harmony_event_08_ec93292e:
    "Хармони слегка напрягается, поняв, что я хочу вести и не собираюсь принимать отказ."

# ch/harmony/events.rpy:1570
translate russian harmony_event_08_6e0ac6b8:
    "Но затем так же быстро привыкает к этой мысли и снова расслабляется."

# ch/harmony/events.rpy:1571
translate russian harmony_event_08_ba4add22:
    "Осмелев, я пускаю в ход самые недвусмысленные движения."

# ch/harmony/events.rpy:1572
translate russian harmony_event_08_17525081:
    "Поняв мои истинные намерения, она ахает, но не даёт мне пощёчины и не убегает."

# ch/harmony/events.rpy:1573
translate russian harmony_event_08_c288da7b:
    "Вместо этого она превращает уклонение от моих объятий в своеобразную игру."

# ch/harmony/events.rpy:1574
translate russian harmony_event_08_e61d555a:
    "Катается она куда лучше меня, так что ей это совсем нетрудно."

# ch/harmony/events.rpy:1575
translate russian harmony_event_08_21dda432:
    "К концу я вымотан, немного раздосадован, но очень возбуждён её выходками."

# ch/harmony/events.rpy:1583
translate russian harmony_event_09_d66b79b3:
    "С Хармони мы там ещё не были, но большинство знакомых девушек используют любой повод туда сходить."

# ch/harmony/events.rpy:1584
translate russian harmony_event_09_0c51d5cc:
    mike.say "Как насчёт торгового центра, Хармони?"

# ch/harmony/events.rpy:1585
translate russian harmony_event_09_4a5253f7:
    mike.say "Может, погуляем там пару часов в следующую субботу?"

# ch/harmony/events.rpy:1588
translate russian harmony_event_09_c3e0fec2:
    harmony.say "О! В торговый центр?"

# ch/harmony/events.rpy:1589
translate russian harmony_event_09_513d456e:
    harmony.say "Ну, если мы устоим перед чревоугодием и тщеславием, полюбоваться витринами, наверное, не грех. Хорошо, [lssb_harmony.hero_name()]!"

# ch/harmony/events.rpy:1591
translate russian harmony_event_09_9d705eda:
    harmony.say "О-о, целый день вместе, только вдвоём?"

# ch/harmony/events.rpy:1592
translate russian harmony_event_09_6f1f9ea5:
    harmony.say "Звучит очень весело, [lssb_harmony.hero_name()]!"

# ch/harmony/events.rpy:1594
translate russian harmony_event_09_9a9259d0:
    harmony.say "Только ты и я, весь день вместе?"

# ch/harmony/events.rpy:1595
translate russian harmony_event_09_56bc4092:
    harmony.say "Мне бы этого хотелось. Возможно, даже больше, чем следовало бы, [lssb_harmony.hero_name()]."

# ch/harmony/events.rpy:1597
translate russian harmony_event_09_2288a300:
    harmony.say "М-м-м, свидание?"

# ch/harmony/events.rpy:1598
translate russian harmony_event_09_f995a80a:
    harmony.say "Прости меня, Господи, но я использую любой предлог, чтобы заполучить тебя целиком, [lssb_harmony.hero_name()]."

# ch/harmony/events.rpy:1601
translate russian harmony_event_09_4747db8b:
    harmony.say "Свидание? Да, пожалуйста."

# ch/harmony/events.rpy:1602
translate russian harmony_event_09_e3001581:
    harmony.say "Веди меня куда хочешь, [lssb_harmony.hero_name()]. А потом — куда-нибудь в укромное место, чтобы я могла как следует отблагодарить тебя."

# ch/harmony/events.rpy:1604
translate russian harmony_event_09_9c797659:
    harmony.say "Свидание? Вот это уже разговор."

# ch/harmony/events.rpy:1605
translate russian harmony_event_09_5d1824a1:
    harmony.say "Купи мне что-нибудь красивое, и, возможно, потом я позабочусь, чтобы ты не пожалел, [lssb_harmony.hero_name()]."

# ch/harmony/events.rpy:1613
translate russian missed_harmony_event_10_5abfa82e:
    "Чёрт, я пропустил свидание. Хармони будет злиться."

# ch/harmony/events.rpy:1630
translate russian harmony_event_10_606da8ae:
    "Признаюсь, я сомневался, стоит ли звать Хармони погулять по торговому центру."

# ch/harmony/events.rpy:1631
translate russian harmony_event_10_9c38127f:
    "Это звучит совершенно невинно и обычно, но не забывайте: она очень предана Иисусу."

# ch/harmony/events.rpy:1632
translate russian harmony_event_10_a64df07f:
    "А глубоко верующие порой весьма неодобрительно относятся к царящему в таких местах культу потребления."

# ch/harmony/events.rpy:1633
translate russian harmony_event_10_93cf513b:
    "Но едва мы проходим через автоматические двери, я уже могу мысленно вздохнуть с облегчением."

# ch/harmony/events.rpy:1634
translate russian harmony_event_10_6b634852:
    "Как и у любой другой девушки, у Хармони загораются глаза при виде всех блестящих вещей в магазинах."

# ch/harmony/events.rpy:1635
translate russian harmony_event_10_3eb01087:
    "Я невольно улыбаюсь: она висит у меня на руке, смеётся и болтает обо всём и ни о чём."

# ch/harmony/events.rpy:1636
translate russian harmony_event_10_c38d36bd:
    "Разговор вовсе не односторонний, но мне трудно вспомнить собственные реплики."

# ch/harmony/events.rpy:1637
translate russian harmony_event_10_93fb7ae4:
    "Гораздо интереснее украдкой поглядывать на Хармони или любоваться её отражением в витринах."

# ch/harmony/events.rpy:1638
translate russian harmony_event_10_77d73ad9:
    "А восхищённые взгляды встречных парней ещё и льстят моему самолюбию."

# ch/harmony/events.rpy:1639
translate russian harmony_event_10_a9ec53d5:
    "Некоторые девушки тоже смотрят на неё с неприкрытой завистью."

# ch/harmony/events.rpy:1640
translate russian harmony_event_10_9e6703a0:
    "Но Хармони словно не замечает внимания ни тех, ни других."

# ch/harmony/events.rpy:1642
translate russian harmony_event_10_638d85b3:
    "Она вполне довольна тем, что купается в моём внимании."

# ch/harmony/events.rpy:1643
translate russian harmony_event_10_31c67302:
    "А я, по счастливому совпадению, дарю ей его с огромным удовольствием."

# ch/harmony/events.rpy:1644
translate russian harmony_event_10_db56e85c:
    "Мы неспешно бродим по торговому центру уже, наверное, почти час."

# ch/harmony/events.rpy:1645
translate russian harmony_event_10_90f35151:
    "До сих пор время пролетало словно в приятной дымке, пока мы переходили от витрины к витрине."

# ch/harmony/events.rpy:1647
translate russian harmony_event_10_e81d295e:
    "Но вдруг я замечаю, что Хармони рядом со мной притихла."

# ch/harmony/events.rpy:1648
translate russian harmony_event_10_69e4592e:
    "Я смотрю на неё, пытаясь понять, в чём дело."

# ch/harmony/events.rpy:1649
translate russian harmony_event_10_047ad7d1:
    "Она молча глядит прямо перед собой."

# ch/harmony/events.rpy:1650
translate russian harmony_event_10_0c0c80de:
    "Я собираюсь что-то сказать, но замолкаю и просто прослеживаю за её взглядом."

# ch/harmony/events.rpy:1651
translate russian harmony_event_10_0a134d26:
    "И вижу, что за стеклом так её зачаровало."

# ch/harmony/events.rpy:1654
translate russian harmony_event_10_2fc91824:
    "Витрина заполнена манекенами в свадебных платьях."

# ch/harmony/events.rpy:1655
translate russian harmony_event_10_72d9efe7:
    "Перед нами все мыслимые фасоны и оттенки белого, слоновой кости и жемчуга."

# ch/harmony/events.rpy:1656
translate russian harmony_event_10_685e2e67:
    "Взгляд Хармони перебегает с одного платья на другое."

# ch/harmony/events.rpy:1657
translate russian harmony_event_10_22dd8d94:
    "И, клянусь, её грудь вздымается всё чаще."

# ch/harmony/events.rpy:1660
translate russian harmony_event_10_c29c4baf:
    harmony.say "О, [lssb_harmony.hero_name()]!"

# ch/harmony/events.rpy:1661
translate russian harmony_event_10_b851f1b2:
    harmony.say "Разве они не прекрасны?"

# ch/harmony/events.rpy:1662
translate russian harmony_event_10_7f056cc9:
    harmony.say "Белоснежные — как стыдливые, невинные невесты, для которых их шьют!"

# ch/harmony/events.rpy:1664
translate russian harmony_event_10_d9d65044:
    "В её словах слышится неподдельный пыл."

# ch/harmony/events.rpy:1665
translate russian harmony_event_10_6339cb22:
    "Прежде чем ответить, я нервно сглатываю."

# ch/harmony/events.rpy:1666
translate russian harmony_event_10_56c3778e:
    mike.say "Да, Хармони, они и правда особенные!"

# ch/harmony/events.rpy:1667
translate russian harmony_event_10_16df644e:
    "Знаю, звучит жалко, но она так переполнена восторгом, что я не нахожу других слов!"

# ch/harmony/events.rpy:1671
translate russian harmony_event_10_0550b6d4:
    harmony.say "Ах, сколько белых платьев."

# ch/harmony/events.rpy:1673
translate russian harmony_event_10_a04e364a:
    "Она качает головой, словно внезапно приуныв."

# ch/harmony/events.rpy:1675
translate russian harmony_event_10_7bf7bfbe:
    harmony.say "[lssb_harmony.hero_name()], почему столько девушек надевают белое?"

# ch/harmony/events.rpy:1676
translate russian harmony_event_10_ef81c44c:
    harmony.say "Неужели они не ценят девственную чистоту — этот великий дар?!"

# ch/harmony/events.rpy:1678
translate russian harmony_event_10_58add13b:
    "Я сглатываю, слушая страстную тираду Хармони о падении современных нравов."

# ch/harmony/events.rpy:1679
translate russian harmony_event_10_43e6655e:
    mike.say "Наверное, они просто не так близки к Богу, как ты, Хармони!"

# ch/harmony/events.rpy:1680
translate russian harmony_event_10_5b0bf21e:
    "Она кивает, а затем качает головой, сокрушаясь о женской распущенности."

# ch/harmony/events.rpy:1684
translate russian harmony_event_10_5dad8db0:
    harmony.say "Невинные невесты, все в белом."

# ch/harmony/events.rpy:1685
translate russian harmony_event_10_37ac3133:
    harmony.say "Ха! Что за чушь собачья!"

# ch/harmony/events.rpy:1686
translate russian harmony_event_10_17d48ea8:
    harmony.say "Спорим, половина тех, кто покупает эти платья, в день свадьбы сосёт у другого мужика!"

# ch/harmony/events.rpy:1688
translate russian harmony_event_10_b1c2c342:
    "От этих слов Хармони я невольно ахаю, поражённый до глубины души."

# ch/harmony/events.rpy:1689
translate russian harmony_event_10_a81627d3:
    mike.say "Хармони, прошу, тебя же услышат!"

# ch/harmony/events.rpy:1691
translate russian harmony_event_10_3d25c0d2:
    "Хармони презрительно кривит губы, явно раздражённая моим ханжеством."

# ch/harmony/events.rpy:1693
translate russian harmony_event_10_476c5193:
    harmony.say "Господи, [lssb_harmony.hero_name()], кто тебе тампон дёрнул?"

# ch/harmony/events.rpy:1695
translate russian harmony_event_10_5c6458b1:
    "Она громко смеётся и уходит, с явным отвращением качая головой."

# ch/harmony/events.rpy:1699
translate russian harmony_event_10_a1612434:
    harmony.say "О-о... сколько белого!"

# ch/harmony/events.rpy:1700
translate russian harmony_event_10_1406c810:
    harmony.say "Интересно, сколько невест НА САМОМ ДЕЛЕ девственницы?"

# ch/harmony/events.rpy:1702
translate russian harmony_event_10_c58b9ce2:
    "С этими словами она самым недвусмысленным образом прижимается ко мне спиной."

# ch/harmony/events.rpy:1704
translate russian harmony_event_10_42b54486:
    harmony.say "Если они и правда девственницы, то не знают, чего лишаются!"

# ch/harmony/events.rpy:1705
translate russian harmony_event_10_a7e46c07:
    "Я тут же смущаюсь и отталкиваю её, едва не впечатав в витрину."

# ch/harmony/events.rpy:1707
translate russian harmony_event_10_f8559ad2:
    harmony.say "ЭЙ!"

# ch/harmony/events.rpy:1708
translate russian harmony_event_10_ec5a1770:
    harmony.say "Боже, [lssb_harmony.hero_name()], с каких пор ты стал таким ханжой?!"

# ch/harmony/events.rpy:1712
translate russian harmony_event_10_c7c25e8c:
    harmony.say "Я всегда мечтала о своей свадьбе."

# ch/harmony/events.rpy:1713
translate russian harmony_event_10_c06b4067:
    harmony.say "Представляла каждую мелочь, вплоть до цвета цветов."

# ch/harmony/events.rpy:1715
translate russian harmony_event_10_4b663e2e:
    "Она с лёгкой грустью качает головой."

# ch/harmony/events.rpy:1717
translate russian harmony_event_10_08a33392:
    harmony.say "Но теперь всё это кажется мне немного странным."

# ch/harmony/events.rpy:1718
translate russian harmony_event_10_c9546e0f:
    harmony.say "Словно что-то изменилось, а я даже не заметила..."

# ch/harmony/events.rpy:1720
translate russian harmony_event_10_f42bd7e6:
    mike.say "Наверное, все маленькие девочки об этом мечтают."

# ch/harmony/events.rpy:1721
translate russian harmony_event_10_222df03a:
    mike.say "Может, ты просто немного повзрослела?"

# ch/harmony/events.rpy:1722
translate russian harmony_event_10_2d7a9db2:
    "Хармони кивает, но по лицу видно: эта мысль всё ещё её тревожит."

# ch/harmony/events.rpy:1724
translate russian harmony_event_10_722b5ef3:
    "Витрина полна манекенов — ничего необычного."

# ch/harmony/events.rpy:1725
translate russian harmony_event_10_8ae41f5e:
    "Вот только все они одеты в одно нижнее бельё."

# ch/harmony/events.rpy:1726
translate russian harmony_event_10_0edecc86:
    "И я имею в виду вовсе не утягивающие трусы и практичные бюстгальтеры."

# ch/harmony/events.rpy:1727
translate russian harmony_event_10_9e01c296:
    "Перед глазами только кружева и нейлон: белые, чёрные и красные."

# ch/harmony/events.rpy:1728
translate russian harmony_event_10_ae4fb22d:
    "Это всего лишь обычный приличный магазин белья, без всяких крайностей и фетишей."

# ch/harmony/events.rpy:1729
translate russian harmony_event_10_b0f09194:
    "Но глаза Хармони всё равно становятся как блюдца, пока она смотрит сквозь стекло..."

# ch/harmony/events.rpy:1732
translate russian harmony_event_10_1778be89:
    harmony.say "Фу-у!"

# ch/harmony/events.rpy:1733
translate russian harmony_event_10_9131b415:
    harmony.say "Разврат, разврат и ещё раз разврат!"

# ch/harmony/events.rpy:1734
translate russian harmony_event_10_67534a61:
    harmony.say "Какая шлюха станет такое носить?"

# ch/harmony/events.rpy:1735
translate russian harmony_event_10_f16ee9fc:
    harmony.say "И какой мужчина захочет увидеть в этом женщину?!"

# ch/harmony/events.rpy:1737
translate russian harmony_event_10_257f5e52:
    "Задав последний вопрос, Хармони резко поворачивается ко мне."

# ch/harmony/events.rpy:1738
translate russian harmony_event_10_9cfad67c:
    "Я чувствую на себе её тяжёлый взгляд и понимаю: она ждёт моей поддержки."

# ch/harmony/events.rpy:1739
translate russian harmony_event_10_5517fa53:
    mike.say "Не знаю, Хармони."

# ch/harmony/events.rpy:1740
translate russian harmony_event_10_674a8d51:
    mike.say "Не стоит осуждать людей за то, чем они занимаются за закрытыми дверями..."

# ch/harmony/events.rpy:1741
translate russian harmony_event_10_45a9006a:
    "На мгновение мне кажется, что она сейчас даст мне пощёчину, и я съёживаюсь в ожидании удара."

# ch/harmony/events.rpy:1742
translate russian harmony_event_10_02d0c1c0:
    "Но она лишь громко фыркает и сердито уходит одна."

# ch/harmony/events.rpy:1746
translate russian harmony_event_10_b7f1d033:
    harmony.say "Фу!"

# ch/harmony/events.rpy:1747
translate russian harmony_event_10_379a2635:
    harmony.say "Какая гадость, правда, [lssb_harmony.hero_name()]?"

# ch/harmony/events.rpy:1748
translate russian harmony_event_10_a1df8007:
    harmony.say "Ты ведь не хотел бы увидеть меня в таком, да?"

# ch/harmony/events.rpy:1750
translate russian harmony_event_10_5648266f:
    "Мне кажется, что вопроса с большим подвохом не бывает, и я начинаю потеть."

# ch/harmony/events.rpy:1751
translate russian harmony_event_10_45197674:
    "Я смотрю на откровенное бельё, а затем на великолепную фигуру Хармони."

# ch/harmony/events.rpy:1752
translate russian harmony_event_10_59869e7f:
    mike.say "Я... не знаю, Хармони..."

# ch/harmony/events.rpy:1753
translate russian harmony_event_10_e263b981:
    mike.say "Кое-что, может, и неплохое. Вот это, похоже, отлично поддерживает грудь."

# ch/harmony/events.rpy:1755
translate russian harmony_event_10_04d88107:
    "Хармони неодобрительно смотрит на меня и качает головой."

# ch/harmony/events.rpy:1757
translate russian harmony_event_10_3e8fb1e2:
    harmony.say "Ох, [lssb_harmony.hero_name()], что же мне с тобой делать?"

# ch/harmony/events.rpy:1758
translate russian harmony_event_10_b6de7443:
    harmony.say "Нам явно нужно усиленно заняться изучением Библии!"

# ch/harmony/events.rpy:1760
translate russian harmony_event_10_a22591fe:
    "С этими словами она хватает меня за руку и уводит от магазина белья."

# ch/harmony/events.rpy:1764
translate russian harmony_event_10_ba47963d:
    harmony.say "Ух ты... Я ОЧЕНЬ даже представляю себя в чём-нибудь таком."

# ch/harmony/events.rpy:1765
translate russian harmony_event_10_5350cbe4:
    harmony.say "И тебя внутри себя заодно..."

# ch/harmony/events.rpy:1766
translate russian harmony_event_10_b336563c:
    "До меня не сразу доходит непристойный смысл слов Хармони."

# ch/harmony/events.rpy:1768
translate russian harmony_event_10_d207af49:
    "А она уже вовсю трётся попкой о мой пах."

# ch/harmony/events.rpy:1769
translate russian harmony_event_10_03b9bc36:
    harmony.say "Хочется, чтобы покупка оправдала себя."

# ch/harmony/events.rpy:1770
translate russian harmony_event_10_f4afdb08:
    harmony.say "Чтобы ты при виде этого белья захотел довести меня до крика!"

# ch/harmony/events.rpy:1771
translate russian harmony_event_10_8d88ac99:
    "Тут я чувствую, как рука Хармони скользит мне за пояс."

# ch/harmony/events.rpy:1772
translate russian harmony_event_10_92749b4c:
    "Она хватает мой уже твёрдый член, безжалостно сжимая и поглаживая его."

# ch/harmony/events.rpy:1773
translate russian harmony_event_10_3a0caa14:
    harmony.say "Может, сделаем всё ещё интереснее?"

# ch/harmony/events.rpy:1774
translate russian harmony_event_10_3bb31692:
    harmony.say "Добавим кожи... а может, даже латекса?"

# ch/harmony/events.rpy:1775
translate russian harmony_event_10_90a5f0ee:
    "Я не могу сдержаться и через несколько секунд кончаю прямо в трусы."

# ch/harmony/events.rpy:1776
translate russian harmony_event_10_a76e3d9b:
    "Хармони порочно улыбается, наслаждаясь ощущением моей спермы и растирая её между пальцами."

# ch/harmony/events.rpy:1777
translate russian harmony_event_10_4e3f120a:
    harmony.say "Буду считать, что это «да»!"

# ch/harmony/events.rpy:1781
translate russian harmony_event_10_e5268927:
    harmony.say "О-о, [lssb_harmony.hero_name()], иди посмотри, что тут есть!"

# ch/harmony/events.rpy:1783
translate russian harmony_event_10_e964ff6a:
    "Хармони прижимает ладони к витрине, восхищённо рассматривая всё за стеклом."

# ch/harmony/events.rpy:1785
translate russian harmony_event_10_ed09591b:
    harmony.say "Интересно, есть что-нибудь моего размера?"

# ch/harmony/events.rpy:1787
translate russian harmony_event_10_105a5b62:
    "Вдруг она немного смущается и опускает взгляд на себя."

# ch/harmony/events.rpy:1789
translate russian harmony_event_10_3e7b285c:
    harmony.say "Ну... иногда больших размеров у них нет..."

# ch/harmony/events.rpy:1791
translate russian harmony_event_10_f6ae8e9a:
    "Но затем снова смотрит на меня и многозначительно приподнимает брови."

# ch/harmony/events.rpy:1793
translate russian harmony_event_10_e36d5db6:
    harmony.say "Представь, [lssb_harmony.hero_name()]: тебе придётся довольствоваться мной голой!"

# ch/harmony/events.rpy:1795
translate russian harmony_event_10_f6d168b6:
    "Меня внезапно бросает в жар от возбуждения и осознания того, сколько людей вокруг."

# ch/harmony/events.rpy:1796
translate russian harmony_event_10_6a9ed5a8:
    "Одной многозначительной улыбки Хармони хватает, чтобы мой член встал в рекордные сроки."

# ch/harmony/events.rpy:1797
translate russian harmony_event_10_d3746b05:
    mike.say "Мы... мы могли бы... спросить..."

# ch/harmony/events.rpy:1798
translate russian harmony_event_10_34aec71c:
    mike.say "Всегда можно зайти и спросить!"

# ch/harmony/events.rpy:1800
translate russian harmony_event_10_40f7bb26:
    "Хармони почти визжит от радости, хватает меня за руку и тащит за собой в магазин белья."

# ch/harmony/events.rpy:1804
translate russian harmony_event_10_275189c4:
    harmony.say "Знаешь, странно."

# ch/harmony/events.rpy:1805
translate russian harmony_event_10_5f82cb50:
    harmony.say "До знакомства с тобой такое меня бы жутко разозлило."

# ch/harmony/events.rpy:1806
translate russian harmony_event_10_1f728c36:
    harmony.say "А теперь... ну, я уже не вижу в этом ничего особенного!"

# ch/harmony/events.rpy:1808
translate russian harmony_event_10_8d055358:
    "Я пытаюсь отшутиться, не желая выглядеть тем, кто развратил Хармони."

# ch/harmony/events.rpy:1809
translate russian harmony_event_10_41c79151:
    "Но по тому, как она смотрит на витрину, вижу: она говорит правду."

# ch/harmony/events.rpy:1810
translate russian harmony_event_10_d315c09d:
    "Когда мы только познакомились, она бы ворвалась туда с вилами и горящим факелом!"

# ch/harmony/events.rpy:1811
translate russian harmony_event_10_b86f1048:
    mike.say "Ты так говоришь, будто я сбиваю тебя с пути истинного!"

# ch/harmony/events.rpy:1813
translate russian harmony_event_10_5a060a3a:
    "Теперь смеётся она и игриво хлопает меня по плечу."

# ch/harmony/events.rpy:1815
translate russian harmony_event_10_1a8b5aaf:
    harmony.say "Так далеко я бы не заходила!"

# ch/harmony/events.rpy:1816
translate russian harmony_event_10_87c06ee0:
    harmony.say "Наверное, ты просто помог мне расширить кругозор. Вот и всё."

# ch/harmony/events.rpy:1818
translate russian harmony_event_10_4a373dad:
    "Хармони улыбается, берёт меня под руку и уводит от магазина белья."

# ch/harmony/events.rpy:1819
translate russian harmony_event_10_effdb06d:
    "А я всё это время представляю её в нарядах с той витрины..."

# ch/harmony/events.rpy:1825
translate russian harmony_event_01_slutty_b295ed75:
    mike.say "Можно пригласить тебя к себе, Хармони?"

# ch/harmony/events.rpy:1826
translate russian harmony_event_01_slutty_365f23b8:
    mike.say "Мы могли бы приятно провести время вдвоём."

# ch/harmony/events.rpy:1827
translate russian harmony_event_01_slutty_400fc093:
    mike.say "Может, на следующей неделе, если хочешь?"

# ch/harmony/events.rpy:1828
translate russian harmony_event_01_slutty_77b7bc11:
    harmony.say "Хм..."

# ch/harmony/events.rpy:1830
translate russian harmony_event_01_slutty_da2a2d67:
    harmony.say "Хорошо, [lssb_harmony.hero_name()], я приду!"

# ch/harmony/events.rpy:1841
translate russian missed_harmony_event_02_vanilla_5abfa82e:
    "Чёрт, я пропустил свидание. Хармони будет злиться."

# ch/harmony/events.rpy:1849
translate russian missed_harmony_event_02_slutty_5abfa82e:
    "Чёрт, я пропустил свидание. Хармони будет злиться."

# ch/harmony/events.rpy:1866
translate russian harmony_event_02_slutty_b8df7607:
    "Я готов к домашнему вечеру с Хармони и слежу, чтобы в доме было чисто и прибрано."

# ch/harmony/events.rpy:1867
translate russian harmony_event_02_slutty_8f6795af:
    "Свидание дома может показаться скучной затеей, но вы бы сильно ошиблись!"

# ch/harmony/events.rpy:1868
translate russian harmony_event_02_slutty_d065f840:
    "Ведь мне удалось выпроводить [bree.name] и Сашу на весь вечер."

# ch/harmony/events.rpy:1869
translate russian harmony_event_02_slutty_11972d04:
    "А значит, весь дом в моём распоряжении. И Хармони тоже будет только моей!"

# ch/harmony/events.rpy:1871
translate russian harmony_event_02_slutty_eb36d99b:
    "Я заканчиваю последние приготовления, когда раздаётся звонок в дверь."

# ch/harmony/events.rpy:1872
translate russian harmony_event_02_slutty_e97893ca:
    "В последний раз оглядываю гостиную и довольно киваю: постарался на славу."

# ch/harmony/events.rpy:1873
translate russian harmony_event_02_slutty_ed1e2ca3:
    "А затем мчусь к входной двери."

# ch/harmony/events.rpy:1874
translate russian harmony_event_02_slutty_059c3fef:
    "Я с радостью открываю её, уже улыбаясь от одной мысли, что сейчас увижу Хармони."

# ch/harmony/events.rpy:1878
translate russian harmony_event_02_slutty_b3b414f9:
    "И она ничуть не разочаровывает — просто загляденье!"

# ch/harmony/events.rpy:1879
translate russian harmony_event_02_slutty_a36f249c:
    "Я разглядываю каждый изгиб её тела и чуть не забываю поздороваться!"

# ch/harmony/events.rpy:1880
translate russian harmony_event_02_slutty_030e40a2:
    mike.say "П... привет, Хармони!"

# ch/harmony/events.rpy:1881
translate russian harmony_event_02_slutty_81d0f638:
    mike.say "Как же я рад, что ты наконец здесь!"

# ch/harmony/events.rpy:1883
translate russian harmony_event_02_slutty_cdbb1f96:
    "Хармони улыбается и тихонько смеётся."

# ch/harmony/events.rpy:1884
translate russian harmony_event_02_slutty_9cfbd836:
    "При этом она слегка недоумённо склоняет голову набок."

# ch/harmony/events.rpy:1886
translate russian harmony_event_02_slutty_e51ffb70:
    harmony.say "Ой..."

# ch/harmony/events.rpy:1888
translate russian harmony_event_02_slutty_2ce52c61:
    harmony.say "Я ведь не опоздала?"

# ch/harmony/events.rpy:1889
translate russian harmony_event_02_slutty_fdb4e15f:
