# ch/harmony/events.rpy:4122
translate russian harmony_event_06_slutty_bd2472ca:
    "Глаза широко раскрыты, а взгляд почти затуманен покорностью и благодарностью."

# ch/harmony/events.rpy:4123
translate russian harmony_event_06_slutty_a34f34e7:
    "Хармони кивает, раскрыв рот и задыхаясь от удовольствия."

# ch/harmony/events.rpy:4124
translate russian harmony_event_06_slutty_2b7dd8f8:
    "Она выглядит совершенно покорной, готовой принять всё, что я ей дам."

# ch/harmony/events.rpy:4125
translate russian harmony_event_06_slutty_5b2488f1:
    "И при этом я вижу, что она абсолютно счастлива!"

# ch/harmony/events.rpy:4126
translate russian harmony_event_06_slutty_8e19fd29:
    "Именно этого Хармони хочет: чтобы я пользовался ею ради своего удовольствия."

# ch/harmony/events.rpy:4127
translate russian harmony_event_06_slutty_e916d81f:
    "Особенно если всё происходит на публике!"

# ch/harmony/events.rpy:4128
translate russian harmony_event_06_slutty_f1d8a63c:
    mike.say "Эм..."

# ch/harmony/events.rpy:4129
translate russian harmony_event_06_slutty_b31eea63:
    mike.say "Блядь, Хармони..."

# ch/harmony/events.rpy:4130
translate russian harmony_event_06_slutty_c4ab0996:
    mike.say "Я сейчас кончу!"

# ch/harmony/events.rpy:4131
translate russian harmony_event_06_slutty_da911480:
    harmony.say "Кончи в меня, пожалуйста!"

# ch/harmony/events.rpy:4132
translate russian harmony_event_06_slutty_622f5b6e:
    harmony.say "Я хочу этого!"

# ch/harmony/events.rpy:4133
translate russian harmony_event_06_slutty_9678f151:
    harmony.say "Наполни меня у всех на глазах!"

# ch/harmony/events.rpy:4134
translate russian harmony_event_06_slutty_0ad13185:
    "Не уверен, что у меня вообще есть выбор!"

# ch/harmony/events.rpy:4138
translate russian harmony_event_06_slutty_6b50031f:
    "В следующее мгновение я уже изливаюсь в Хармони."

# ch/harmony/events.rpy:4140
translate russian harmony_event_06_slutty_2d049cf8:
    "Она почти кричит, извиваясь на моём члене."

# ch/harmony/events.rpy:4142
translate russian harmony_event_06_slutty_c77458da:
    "И всё время кивает, призывая меня продолжать."

# ch/harmony/events.rpy:4143
translate russian harmony_event_06_slutty_f98f2133:
    "Потом я представляю, как нам придётся со стыдом выбираться отсюда тайком."

# ch/harmony/events.rpy:4147
translate russian harmony_event_06_slutty_2a26cd75:
    "Но, когда мы приводим себя в порядок, одеваемся и садимся на места, всё оказывается иначе."

# ch/harmony/events.rpy:4148
translate russian harmony_event_06_slutty_60ba0a2c:
    "Нас с Хармони встречают аплодисментами и восхищёнными взглядами."

# ch/harmony/events.rpy:4149
translate russian harmony_event_06_slutty_6f381982:
    "Кто-то даже анонимно угощает нас выпивкой!"

# ch/harmony/events.rpy:4150
translate russian harmony_event_06_slutty_fd55d7f9:
    mike.say "Я... кажется, им понравилось, Хармони!"

# ch/harmony/events.rpy:4152
translate russian harmony_event_06_slutty_ffd298fd:
    harmony.say "Что я тебе говорила, [lssb_harmony.hero_name()]?"

# ch/harmony/events.rpy:4153
translate russian harmony_event_06_slutty_1b2ac7e6:
    harmony.say "Я всё продумала!"

# ch/harmony/events.rpy:4155
translate russian harmony_event_06_slutty_41f914e1:
    mike.say "Похоже на то!"

# ch/harmony/events.rpy:4156
translate russian harmony_event_06_slutty_10a591e0:
    mike.say "Только в следующий раз будь добра сначала спросить меня, ладно?"

# ch/harmony/events.rpy:4158
translate russian harmony_event_06_slutty_c30d240c:
    harmony.say "Но так же совсем неинтересно!"

# ch/harmony/events.rpy:4159
translate russian harmony_event_06_slutty_731fd7f8:
    harmony.say "И как я тогда пойму, что тебе правда нравится, а не что ты притворяешься?"

# ch/harmony/events.rpy:4161
translate russian harmony_event_06_slutty_60e0aa6d:
    "Я качаю головой и переключаюсь на бесплатную выпивку."

# ch/harmony/events.rpy:4162
translate russian harmony_event_06_slutty_d9fcef5d:
    "Но, по правде говоря, мне понравилось гораздо больше, чем я мог представить."

# ch/harmony/events.rpy:4163
translate russian harmony_event_06_slutty_abbcd836:
    "И я уже гадаю, какие ещё идеи роятся у Хармони в голове..."

# ch/harmony/events.rpy:4168
translate russian harmony_purity_01_bb6d3516:
    "Хармони поглядывает на меня искоса, словно хочет что-то сказать, но не решается."

# ch/harmony/events.rpy:4169
translate russian harmony_purity_01_82d14c75:
    mike.say "Что тебя тревожит, Хармони?"

# ch/harmony/events.rpy:4171
translate russian harmony_purity_01_5f08bf0f:
    harmony.say "Ну..."

# ch/harmony/events.rpy:4172
translate russian harmony_purity_01_c92a4791:
    harmony.say "Ты знаешь, в эти выходные ежегодный танцевальный вечер при церкви?"

# ch/harmony/events.rpy:4174
translate russian harmony_purity_01_363ba451:
    "Хотя я вроде как активный прихожанин, признаюсь: не знал."

# ch/harmony/events.rpy:4175
translate russian harmony_purity_01_5f83f9dd:
    "Но Хармони я этого не скажу!"

# ch/harmony/events.rpy:4176
translate russian harmony_purity_01_cf41d4ef:
    mike.say "Конечно знаю, Хармони."

# ch/harmony/events.rpy:4177
translate russian harmony_purity_01_ecf3d442:
    mike.say "А что?"

# ch/harmony/events.rpy:4179
translate russian harmony_purity_01_c9bfa685:
    harmony.say "Я хотела спросить..."

# ch/harmony/events.rpy:4180
translate russian harmony_purity_01_162211a5:
    harmony.say "Может, ты тоже придёшь?"

# ch/harmony/events.rpy:4181
translate russian harmony_purity_01_26efb4db:
    harmony.say "В этом году нам не помешало бы побольше гостей!"

# ch/harmony/events.rpy:4185
translate russian harmony_purity_01_01ce77a3:
    mike.say "А, прости, Хармони."

# ch/harmony/events.rpy:4186
translate russian harmony_purity_01_27b9e385:
    mike.say "У меня уже есть планы на выходные!"

# ch/harmony/events.rpy:4187
translate russian harmony_purity_01_6f2de6f9:
    mike.say "В другой раз я бы сразу согласился."

# ch/harmony/events.rpy:4189
translate russian harmony_purity_01_2a7ef64d:
    "Хармони заметно разочарована, но всё же кивает."

# ch/harmony/events.rpy:4191
translate russian harmony_purity_01_ffaa176b:
    harmony.say "Ну что ж, я просто решила спросить."

# ch/harmony/events.rpy:4194
translate russian harmony_purity_01_6096e155:
    mike.say "У меня были планы на выходные."

# ch/harmony/events.rpy:4196
translate russian harmony_purity_01_4c194f0a:
    mike.say "Но раз просишь ты, отменю их и приду на танцы."

# ch/harmony/events.rpy:4198
translate russian harmony_purity_01_042d704f:
    "Хармони улыбается и едва не хлопает в ладоши от радости."

# ch/harmony/events.rpy:4200
translate russian harmony_purity_01_4d77dc0a:
    harmony.say "О, спасибо, [lssb_harmony.hero_name()]!"

# ch/harmony/events.rpy:4201
translate russian harmony_purity_01_1edbb14d:
    harmony.say "Обещаю, ты не пожалеешь."

# ch/harmony/events.rpy:4208
translate russian missed_harmony_purity_02_5abfa82e:
    "Чёрт, я пропустил свидание. Хармони будет злиться."

# ch/harmony/events.rpy:4222
translate russian harmony_purity_02_d737d7be:
    "Да-да-да, знаю: трудно придумать что-нибудь скучнее церковных танцев."

# ch/harmony/events.rpy:4223
translate russian harmony_purity_02_c7cbac8a:
    "И вы были бы правы. Здесь собраны все ожидаемые клише и даже больше!"

# ch/harmony/events.rpy:4224
translate russian harmony_purity_02_59be8219:
    "Полно стариков, надоедливых детей и людей, слишком уж увлечённых Иисусом."

# ch/harmony/events.rpy:4225
translate russian harmony_purity_02_68eceaaf:
    "Но здесь есть и Хармони."

# ch/harmony/events.rpy:4226
translate russian harmony_purity_02_ab7426ad:
    "А пока она рядом, я готов терпеть всё остальное."

# ch/harmony/events.rpy:4228
translate russian harmony_purity_02_951851f0:
    harmony.say "Здравствуй, [lssb_harmony.hero_name()]."

# ch/harmony/events.rpy:4229
translate russian harmony_purity_02_ac7626c5:
    harmony.say "Как я рада, что ты пришёл!"

# ch/harmony/events.rpy:4231
translate russian harmony_purity_02_9cb17844:
    mike.say "Привет, Хармони."

# ch/harmony/events.rpy:4232
translate russian harmony_purity_02_9d995110:
    mike.say "Ни за что бы не пропустил."

# ch/harmony/events.rpy:4233
translate russian harmony_purity_02_381d901e:
    mike.say "Особенно после твоего приглашения!"

# ch/harmony/events.rpy:4235
translate russian harmony_purity_02_c6a96324:
    "От моего восторга по поводу её приглашения щёки Хармони слегка краснеют."

# ch/harmony/events.rpy:4236
translate russian harmony_purity_02_e091c9ce:
    "Иногда я забываю, насколько она невинна, и боюсь напугать её своим напором."

# ch/harmony/events.rpy:4238
translate russian harmony_purity_02_76af397f:
    mike.say "Но я бы и так пришёл... Конечно!"

# ch/harmony/events.rpy:4239
translate russian harmony_purity_02_2d3d8abd:
    mike.say "Нужно ведь вносить свой вклад в жизнь церкви?"

# ch/harmony/events.rpy:4241
translate russian harmony_purity_02_183c451f:
    "Хармони так же быстро приходит в себя и широко улыбается."

# ch/harmony/events.rpy:4243
translate russian harmony_purity_02_99c2f31f:
    harmony.say "Д... да... конечно!"

# ch/harmony/events.rpy:4244
translate russian harmony_purity_02_2a01132b:
    harmony.say "Ведь мы одна большая христианская община!"

# ch/harmony/events.rpy:4246
translate russian harmony_purity_02_e6eea54e:
    "Она поворачивается к танцплощадке, словно пытаясь сменить тему."

# ch/harmony/events.rpy:4247
translate russian harmony_purity_02_41dfa8ed:
    "Хотя зал полон, танцплощадка почти пуста."

# ch/harmony/events.rpy:4248
translate russian harmony_purity_02_956e01d3:
    mike.say "Желающих пока немного, да?"

# ch/harmony/events.rpy:4249
translate russian harmony_purity_02_4f39956d:
    "Хармони коротко кивает и улыбается."

# ch/harmony/events.rpy:4250
translate russian harmony_purity_02_723da459:
    "В её духе увидеть в этом возможность, а не проблему..."

# ch/harmony/events.rpy:4252
translate russian harmony_purity_02_2baade5b:
    harmony.say "Ну что, может, мы с тобой это исправим?"

# ch/harmony/events.rpy:4254
translate russian harmony_purity_02_d9624f31:
    mike.say "Эм, ладно. Что ты предлагаешь?"

# ch/harmony/events.rpy:4256
translate russian harmony_purity_02_f15c0aca:
    harmony.say "Кажется, я знаю одну даму, которая с радостью потанцует с таким высоким красавцем, как ты, [lssb_harmony.hero_name()]!"

# ch/harmony/events.rpy:4258
translate russian harmony_purity_02_4e5bbc70:
    "Конечно, от этих слов у меня тут же загораются глаза."

# ch/harmony/events.rpy:4259
translate russian harmony_purity_02_525f442c:
    "Я думал, придётся долго собираться с духом, чтобы пригласить Хармони."

# ch/harmony/events.rpy:4260
translate russian harmony_purity_02_02e45350:
    "А она сама предлагает мне такую возможность, едва я успел войти!"

# ch/harmony/events.rpy:4261
translate russian harmony_purity_02_04d749e6:
    mike.say "Хорошо, Хармони. Невежливо ведь отказывать даме?"

# ch/harmony/events.rpy:4265
translate russian harmony_purity_02_0cb440f8:
    "Хармони кивает и ловко отступает в сторону."

# ch/harmony/events.rpy:4266
translate russian harmony_purity_02_71693df0:
    "За ней оказывается маленькая девочка, которая всё это время пряталась."

# ch/harmony/events.rpy:4268
translate russian harmony_purity_02_6d43364a:
    harmony.say "Видишь, Селеста? Я же говорила, [lssb_harmony.hero_name()] с тобой потанцует!"

# ch/harmony/events.rpy:4270
translate russian harmony_purity_02_e0df3f03:
    "Девочка лет шести-семи улыбается, показывая брекеты."

# ch/harmony/events.rpy:4271
translate russian harmony_purity_02_abddb1ba:
    "Она хватает меня за руку и тянет к танцплощадке, а Хармони одобрительно смотрит вслед."

# ch/harmony/events.rpy:4272
translate russian harmony_purity_02_30652d9b:
    "Конечно, я разочарован тем, что неправильно всё понял."

# ch/harmony/events.rpy:4273
translate russian harmony_purity_02_fa59cb23:
    "Но я не настолько мерзавец, чтобы показать это милой маленькой девочке!"

# ch/harmony/events.rpy:4274
translate russian harmony_purity_02_754952c7:
    "Поэтому послушно танцую с ней под пару спокойных мелодий и всё время улыбаюсь."

# ch/harmony/events.rpy:4278
translate russian harmony_purity_02_fff83362:
    "Когда мы уходим с площадки, я вижу, что Хармони очень мной довольна."

# ch/harmony/events.rpy:4280
translate russian harmony_purity_02_4eefe85e:
    "Наверное, стоит радоваться тому, сколько очков я набрал в её глазах."

# ch/harmony/events.rpy:4282
translate russian harmony_purity_02_1c47cee3:
    harmony.say "Ох, как мило с твоей стороны, [lssb_harmony.hero_name()]."

# ch/harmony/events.rpy:4284
translate russian harmony_purity_02_a9a5d689:
    mike.say "Не за что, Хармони."

# ch/harmony/events.rpy:4285
translate russian harmony_purity_02_6181fc3a:
    mike.say "Рад, что смог порадовать Селесту."

# ch/harmony/events.rpy:4287
translate russian harmony_purity_02_07b3c90f:
    harmony.say "Знаешь, кое-кто всё это время наблюдал за тобой."

# ch/harmony/events.rpy:4289
translate russian harmony_purity_02_dca96ee0:
    mike.say "Правда?"

# ch/harmony/events.rpy:4291
translate russian harmony_purity_02_e5b1492f:
    harmony.say "Конечно!"

# ch/harmony/events.rpy:4292
translate russian harmony_purity_02_75c07799:
    harmony.say "И настолько впечатлился, что тоже хочет с тобой потанцевать."

# ch/harmony/events.rpy:4294
translate russian harmony_purity_02_abc38b1b:
    "Вот она, награда за доброту к маленькой девочке!"

# ch/harmony/events.rpy:4295
translate russian harmony_purity_02_b9aff9b8:
    mike.say "Ну, на следующий танец у меня пары нет..."

# ch/harmony/events.rpy:4299
translate russian harmony_purity_02_5e759ecc:
    "Когда Хармони снова отступает в сторону, меня охватывает страшное дежавю."

# ch/harmony/events.rpy:4300
translate russian harmony_purity_02_3688a4a6:
    "Передо мной одна из самых старых прихожанок."

# ch/harmony/events.rpy:4301
translate russian harmony_purity_02_08d499d8:
    "Представьте белокожего Йоду с голубоватой сединой и толстыми очками."

# ch/harmony/events.rpy:4303
translate russian harmony_purity_02_3e95840d:
    harmony.say "Вот, Пруденс, он весь ваш."

# ch/harmony/events.rpy:4305
translate russian harmony_purity_02_f0a57eea:
    "Я снова выхожу на площадку и осторожно веду хрупкую старушку через простейшие движения."

# ch/harmony/events.rpy:4306
translate russian harmony_purity_02_a6657f3a:
    "И всё время поглядываю на Хармони, гадая, удастся ли мне вообще с ней потанцевать."

# ch/harmony/events.rpy:4310
translate russian harmony_purity_02_41910538:
    "Когда я возвращаюсь, она встречает меня ещё теплее, чем после прошлого танца."

# ch/harmony/events.rpy:4311
translate russian harmony_purity_02_011a9179:
    "Я стараюсь улыбаться в ответ и не показывать недовольства."

# ch/harmony/events.rpy:4313
translate russian harmony_purity_02_7a9462c6:
    "Но Хармони всё же замечает, что что-то не так."

# ch/harmony/events.rpy:4314
translate russian harmony_purity_02_9b8a1a32:
    "Она кладёт ладонь на мою руку, даже не подозревая, как от этого колотится моё сердце."

# ch/harmony/events.rpy:4316
translate russian harmony_purity_02_6731ed86:
    harmony.say "[lssb_harmony.hero_name()], что случилось?"

# ch/harmony/events.rpy:4318
translate russian harmony_purity_02_096f727a:
    mike.say "Ничего, Хармони."

# ch/harmony/events.rpy:4320
translate russian harmony_purity_02_c76cb742:
    harmony.say "Нет, [lssb_harmony.hero_name()], что-то случилось."

# ch/harmony/events.rpy:4321
translate russian harmony_purity_02_c9e28eae:
    harmony.say "Мы ведь друзья?"

# ch/harmony/events.rpy:4323
translate russian harmony_purity_02_ba54a72a:
    harmony.say "Ты можешь сказать, что тебя тревожит."

# ch/harmony/events.rpy:4325
translate russian harmony_purity_02_cb568d29:
    "Я пожимаю плечами и тихонько смеюсь."

# ch/harmony/events.rpy:4326
translate russian harmony_purity_02_5517fa53:
    mike.say "Не знаю, Хармони."

# ch/harmony/events.rpy:4327
translate russian harmony_purity_02_99c776ce:
    mike.say "Это прозвучит глупо!"

# ch/harmony/events.rpy:4329
translate russian harmony_purity_02_c65c60b4:
    harmony.say "Нет, не прозвучит. Говори!"

# ch/harmony/events.rpy:4331
translate russian harmony_purity_02_4da60630:
    mike.say "Ладно... попробую..."

# ch/harmony/events.rpy:4332
translate russian harmony_purity_02_7116b3c7:
    mike.say "Я немного расстроен, что пока так и не потанцевал с тобой!"

# ch/harmony/events.rpy:4335
translate russian harmony_purity_02_10b6821a:
    "Глаза Хармони округляются, и она снова краснеет."

# ch/harmony/events.rpy:4337
translate russian harmony_purity_02_c146ab0c:
    harmony.say "Ох, [lssb_harmony.hero_name()]..."

# ch/harmony/events.rpy:4338
translate russian harmony_purity_02_60528974:
    harmony.say "Прости! Какая же я плохая подруга!"

# ch/harmony/events.rpy:4339
translate russian harmony_purity_02_67110fa1:
    harmony.say "Конечно, я с тобой потанцую. Прямо сейчас!"

# ch/harmony/events.rpy:4342
translate russian harmony_purity_02_7c34b3e1:
    "Она берёт меня за руку и ведёт на танцплощадку."

# ch/harmony/events.rpy:4349
translate russian harmony_purity_02_9e09c002:
    "Я так нервничаю, следуя за Хармони, что едва не путаюсь в собственных ногах."

# ch/harmony/events.rpy:4350
translate russian harmony_purity_02_6cc0d606:
    "Труднее всего сосредоточиться на самом танце."

# ch/harmony/events.rpy:4351
translate russian harmony_purity_02_1f98678d:
    "Стоит отвлечься, и я могу лишь смотреть ей в глаза."

# ch/harmony/events.rpy:4352
translate russian harmony_purity_02_e6b22f5d:
    "Поэтому наш танец получается медленным и размеренным."

# ch/harmony/events.rpy:4353
translate russian harmony_purity_02_4ee5f1c6:
    "Но, кажется, такой темп прекрасно подходит нам обоим."

# ch/harmony/events.rpy:4354
translate russian harmony_purity_02_07f1a98f:
    "Как бы сильно Хармони ни привлекала меня физически, теперь я знаю: между нами есть нечто большее."

# ch/harmony/events.rpy:4355
translate russian harmony_purity_02_1690a40a:
    "Почему-то даже отсутствие прикосновений волнует меня почти так же сильно, как сами прикосновения."

# ch/harmony/events.rpy:4356
translate russian harmony_purity_02_15ee9240:
    "Будто всякий раз, когда мы так близко, между нами накапливается энергия."

# ch/harmony/events.rpy:4357
translate russian harmony_purity_02_d54e459d:
    "Что-то вроде статического электричества, которое лишь усиливается, пока мы сопротивляемся искушению дать ему разрядиться."

# ch/harmony/events.rpy:4358
translate russian harmony_purity_02_0e814b1a:
    "Глядя в глаза Хармони, я уверен: она тоже это чувствует."

# ch/harmony/events.rpy:4359
translate russian harmony_purity_02_d58a3721:
    "Она долго не отводит взгляда, словно заглядывает мне в душу."

# ch/harmony/events.rpy:4360
translate russian harmony_purity_02_7826ca4f:
    "А когда наконец отводит, мне кажется, что она боится слишком рано почувствовать слишком многое."

# ch/harmony/events.rpy:4361
translate russian harmony_purity_02_37f4d9b5:
    "Когда танец сам собой заканчивается, мы оба молчим."

# ch/harmony/events.rpy:4362
translate russian harmony_purity_02_225dd5f8:
    "Слова не нужны: я уверен, что между нами только что произошло нечто очень важное."

# ch/harmony/events.rpy:4369
translate russian harmony_purity_02_bd8ee827:
    "Я так долго ждал этого момента, что, наверное, немного теряю голову."

# ch/harmony/events.rpy:4370
translate russian harmony_purity_02_ec9c235a:
    "Едва мы выходим на площадку, я обхватываю Хармони за бёдра."

# ch/harmony/events.rpy:4371
translate russian harmony_purity_02_8714c5ee:
    "Она тихонько вскрикивает от неожиданности и машинально обвивает руками мою шею."

# ch/harmony/events.rpy:4372
translate russian harmony_purity_02_b94b3452:
    "Прежде чем она успевает возразить, я начинаю плавно покачиваться."

# ch/harmony/events.rpy:4373
translate russian harmony_purity_02_7c0013d8:
    "Хармони немного извивается, пытаясь отстраниться."

# ch/harmony/events.rpy:4374
translate russian harmony_purity_02_21b49071:
    "Но от этого мои движения лишь становятся выразительнее."

# ch/harmony/events.rpy:4375
translate russian harmony_purity_02_78fffeab:
    "Она опускает взгляд на наши тесно прижатые тела."

# ch/harmony/events.rpy:4376
translate russian harmony_purity_02_8172257b:
    "Затем смотрит на меня широко раскрытыми от страха глазами."

# ch/harmony/events.rpy:4377
translate russian harmony_purity_02_241ee182:
    "От страха и чего-то ещё..."

# ch/harmony/events.rpy:4378
translate russian harmony_purity_02_23cea035:
    "И именно на этом «ещё» я решаю сосредоточиться."

# ch/harmony/events.rpy:4379
translate russian harmony_purity_02_7c2a1387:
    "Медленно, очень медленно сопротивление Хармони начинает ослабевать."

# ch/harmony/events.rpy:4380
translate russian harmony_purity_02_6479a2bf:
    "Она движется со мной свободнее и больше не пытается отстраниться."

# ch/harmony/events.rpy:4381
translate russian harmony_purity_02_66517c18:
    "Скованность в её теле наконец тает."

# ch/harmony/events.rpy:4382
translate russian harmony_purity_02_4a74d8d3:
    "Она моргает, а затем почти закрывает глаза."

# ch/harmony/events.rpy:4383
translate russian harmony_purity_02_4a158d85:
    "Я чувствую, как её голова опускается мне на плечо."

# ch/harmony/events.rpy:4384
translate russian harmony_purity_02_9c49de9a:
    "И Хармони отдаётся танцу — и мне."

# ch/harmony/events.rpy:4385
translate russian harmony_purity_02_37f4d9b5_1:
    "Когда танец сам собой заканчивается, мы оба молчим."

# ch/harmony/events.rpy:4386
translate russian harmony_purity_02_225dd5f8_1:
    "Слова не нужны: я уверен, что между нами только что произошло нечто очень важное."

# ch/harmony/events.rpy:4394
translate russian harmony_purity_03_11625357:
    "Трудно придумать достаточно благопристойное свидание для такой девушки, как Хармони."

# ch/harmony/events.rpy:4395
translate russian harmony_purity_03_6dd2a404:
    "В конце концов я выбираю первое, что приходит в голову без всяких непристойных намёков."

# ch/harmony/events.rpy:4396
translate russian harmony_purity_03_ad4ae1a8:
    mike.say "Эм, может, устроим пикник в следующее воскресенье, Хармони?"

# ch/harmony/events.rpy:4397
translate russian harmony_purity_03_86d41d03:
    "Хармони смотрит на меня с лёгким недоумением."

# ch/harmony/events.rpy:4398
translate russian harmony_purity_03_2c404601:
    "Такого предложения она явно не ожидала."

# ch/harmony/events.rpy:4399
translate russian harmony_purity_03_3043ec93:
    harmony.say "Конечно, [lssb_harmony.hero_name()]... почему бы и нет!"

# ch/harmony/events.rpy:4407
translate russian missed_harmony_purity_04_5abfa82e:
    "Чёрт, я пропустил свидание. Хармони будет злиться."

# ch/harmony/events.rpy:4423
translate russian harmony_purity_04_951851f0:
    harmony.say "Здравствуй, [lssb_harmony.hero_name()]."

# ch/harmony/events.rpy:4425
translate russian harmony_purity_04_4cded362:
    mike.say "Эм... привет, Хармони."

# ch/harmony/events.rpy:4427
translate russian harmony_purity_04_141b6d49:
    "Она снова хихикает над моим волнением, явно находя его милым."

# ch/harmony/events.rpy:4429
translate russian harmony_purity_04_b3ca94bd:
    harmony.say "Не нужно волноваться, [lssb_harmony.hero_name()]."

# ch/harmony/events.rpy:4430
translate russian harmony_purity_04_14295c0c:
    harmony.say "Пикник — это всего лишь возможность поесть на лоне природы!"

# ch/harmony/events.rpy:4431
translate russian harmony_purity_04_2259717d:
    harmony.say "А я научу тебя всему, что нужно знать..."

# ch/harmony/events.rpy:4433
translate russian harmony_purity_04_d5f006bf:
    "Вот чёрт, зачем она сказала «лоно»?"

# ch/harmony/events.rpy:4434
translate russian harmony_purity_04_e29dae45:
    "Теперь я могу только пялиться на её грудь!"

# ch/harmony/events.rpy:4437
translate russian harmony_purity_04_d2b10403:
    "Для примерной христианки Хармони удивительно хорошо умеет меня искушать."

# ch/harmony/events.rpy:4438
translate russian harmony_purity_04_15bbbf2c:
    "Я сейчас чувствую себя Адамом, а она скорее соблазнительный змей, чем невинная Ева!"

# ch/harmony/events.rpy:4440
translate russian harmony_purity_04_b3a07552:
    harmony.say "Может, начнём со стакана лимонада?"

# ch/harmony/events.rpy:4441
translate russian harmony_purity_04_00e79ab1:
    harmony.say "А потом перейдём к сэндвичам с огурцом!"

# ch/harmony/events.rpy:4443
translate russian harmony_purity_04_b76cc82f:
    "Я прекрасно понимаю, что это совершенно обычные еда и напитки."

# ch/harmony/events.rpy:4444
translate russian harmony_purity_04_ef21ffc9:
    "Так почему из уст Хармони это звучит как самые грязные намёки?"

# ch/harmony/events.rpy:4445
translate russian harmony_purity_04_8a44f276:
    "Я изо всех сил гоню нечистые мысли и пытаюсь просто наслаждаться пикником."

# ch/harmony/events.rpy:4446
translate russian harmony_purity_04_0fcace95:
    "Уж это-то мне должно быть по силам?"

# ch/harmony/events.rpy:4448
translate russian harmony_purity_04_98822764:
    "И, когда мы приступаем к приготовленной Хармони еде, я именно так и стараюсь поступить."

# ch/harmony/events.rpy:4449
translate russian harmony_purity_04_7fffde08:
    "Вскоре обстановка и приятная беседа помогают мне расслабиться."

# ch/harmony/events.rpy:4450
translate russian harmony_purity_04_2ac555f8:
    "Я почти забываю о сексуальном напряжении, отошедшем на второй план."

# ch/harmony/events.rpy:4451
translate russian harmony_purity_04_7df7437a:
    "Но всё меняется, стоит Хармони достать из корзины лоток клубники."

# ch/harmony/events.rpy:4452
translate russian harmony_purity_04_5b910bec:
    "Она улыбается, ставя его на покрывало между нами. Казалось бы, просто улыбка."

# ch/harmony/events.rpy:4453
translate russian harmony_purity_04_f65de5e8:
    "Но клубника ведь очень чувственная ягода, правда?"

# ch/harmony/events.rpy:4454
translate russian harmony_purity_04_5876c9cf:
    "Спелая, сочная, полная вкуса..."

# ch/harmony/events.rpy:4455
translate russian harmony_purity_04_d3488f44:
    "Погодите... Я сейчас о клубнике или о Хармони?!"

# ch/harmony/events.rpy:4456
translate russian harmony_purity_04_0fff69ab:
    "Как бы то ни было, мы по очереди берём ягоды и почти застенчиво их едим."

# ch/harmony/events.rpy:4457
translate russian harmony_purity_04_b2639a31:
    "Не уверен, но, кажется, Хармони тоже начинает чувствовать неловкость."

# ch/harmony/events.rpy:4458
translate russian harmony_purity_04_2671c2c3:
    "И тут наши руки соприкасаются: мы одновременно потянулись за последней ягодой."

# ch/harmony/events.rpy:4459
translate russian harmony_purity_04_aa10f3e0:
    mike.say "Ой... прости."

# ch/harmony/events.rpy:4460
translate russian harmony_purity_04_89454e62:
    harmony.say "Нет-нет, это мне надо было сначала посмотреть."

# ch/harmony/events.rpy:4461
translate russian harmony_purity_04_e7fa46da:
    mike.say "Возьми её, Хармони."

# ch/harmony/events.rpy:4462
translate russian harmony_purity_04_72386896:
    mike.say "Ведь ты принесла всю еду."

# ch/harmony/events.rpy:4463
translate russian harmony_purity_04_29500af1:
    harmony.say "Не могу."

# ch/harmony/events.rpy:4464
translate russian harmony_purity_04_91312168:
    harmony.say "Это было бы нехорошо с моей стороны..."

# ch/harmony/events.rpy:4465
translate russian harmony_purity_04_75a3536d:
    mike.say "Может, поделимся?"

# ch/harmony/events.rpy:4466
translate russian harmony_purity_04_44005e86:
    harmony.say "Разрежем пополам?"

# ch/harmony/events.rpy:4467
translate russian harmony_purity_04_92751eee:
    "В животе порхают бабочки, пока я набираюсь смелости произнести эти слова."

# ch/harmony/events.rpy:4468
translate russian harmony_purity_04_817a4a98:
    mike.say "Эм, нет..."

# ch/harmony/events.rpy:4469
translate russian harmony_purity_04_e7707e81:
    mike.say "Я подумал, может... будем откусывать по очереди?"

# ch/harmony/events.rpy:4470
translate russian harmony_purity_04_0b08bdce:
    harmony.say "Хорошо, [lssb_harmony.hero_name()]. Звучит забавно!"

# ch/harmony/events.rpy:4471
translate russian harmony_purity_04_d42f8186:
    "Я подношу клубнику к губам Хармони, и она смущённо откусывает маленький кусочек."

# ch/harmony/events.rpy:4472
translate russian harmony_purity_04_bc481b81:
    "Затем она кормит меня, и её пальцы легко касаются моей губы."

# ch/harmony/events.rpy:4473
translate russian harmony_purity_04_a3a31f33:
    "Ягода большая, поэтому остаётся ещё на один укус."

# ch/harmony/events.rpy:4474
translate russian harmony_purity_04_f6f28564:
    "И тут мы оба наклоняемся, собираясь съесть последний кусочек."

# ch/harmony/events.rpy:4475
translate russian harmony_purity_04_ffb72873:
    "Конечно, клубники достаётся нам обоим."

# ch/harmony/events.rpy:4478
translate russian harmony_purity_04_ad7d6b50:
    "Но заодно соприкасаются и наши губы."

# ch/harmony/events.rpy:4481
translate russian harmony_purity_04_d5e4c55e:
    "В это мгновение я словно переживаю озарение."

# ch/harmony/events.rpy:4482
translate russian harmony_purity_04_3043eb4b:
    "Внезапно понимаю, откуда берётся всё напряжение между нами."

# ch/harmony/events.rpy:4483
translate russian harmony_purity_04_38f3d4df:
    "Я сам виноват: позволяю её красоте отвлекать меня."

# ch/harmony/events.rpy:4484
translate russian harmony_purity_04_39654ea7:
    "Если, даст Бог, наши отношения будут развиваться и мы сблизимся, для этого ещё придёт время."

# ch/harmony/events.rpy:4485
translate russian harmony_purity_04_98bb9258:
    "А сейчас нужно держать свои чувства в узде."

# ch/harmony/events.rpy:4486
translate russian harmony_purity_04_b6c69130:
    "Сосредоточиться на том, что Хармони для меня друг и близкий человек."

# ch/harmony/events.rpy:4487
translate russian harmony_purity_04_a124d1c2:
    "Ценить её ум и характер, а не сидеть и думать о теле."

# ch/harmony/events.rpy:4491
translate russian harmony_purity_04_25ec6fb5:
    "Поэтому я прерываю случайный поцелуй и обязательно улыбаюсь ей."

# ch/harmony/events.rpy:4492
translate russian harmony_purity_04_e3d6605d:
    mike.say "Прости, Хармони."

# ch/harmony/events.rpy:4493
translate russian harmony_purity_04_6f621bd4:
    mike.say "Это было прекрасно, но мне не следовало позволять себе такую вольность."

# ch/harmony/events.rpy:4494
translate russian harmony_purity_04_90ad4ce7:
    "Хармони на мгновение отворачивается, и я не вижу её первой реакции на извинение."

# ch/harmony/events.rpy:4495
translate russian harmony_purity_04_8ee63079:
    "Когда она снова поворачивается ко мне, на лице появляется робкая, скромная улыбка."

# ch/harmony/events.rpy:4496
translate russian harmony_purity_04_547ada33:
    harmony.say "Всё хорошо, [lssb_harmony.hero_name()]."

# ch/harmony/events.rpy:4497
translate russian harmony_purity_04_3a8ada3d:
    harmony.say "Я виновата ничуть не меньше тебя."

# ch/harmony/events.rpy:4498
translate russian harmony_purity_04_8fd8f814:
    "Она на мгновение замолкает, затем решается добавить ещё кое-что."

# ch/harmony/events.rpy:4499
translate russian harmony_purity_04_9198076d:
    harmony.say "Если что, мне тоже было очень приятно..."

# ch/harmony/events.rpy:4500
translate russian harmony_purity_04_fdd85d92:
    "Я улыбаюсь и беру её за руку."

# ch/harmony/events.rpy:4501
translate russian harmony_purity_04_59c780ff:
    "Как хорошо знать, что мы понимаем друг друга."

# ch/harmony/events.rpy:4502
translate russian harmony_purity_04_ca923740:
    "Возможно, сейчас мы немного поспешили и зашли слишком далеко."

# ch/harmony/events.rpy:4503
translate russian harmony_purity_04_c71a1944:
    "Но, думаю, это напомнит нам быть осторожнее в будущем."

# ch/harmony/events.rpy:4504
translate russian harmony_purity_04_ed224954:
    "Хармони для меня такая особенная, что я не хочу ничем рисковать."

# ch/harmony/events.rpy:4505
translate russian harmony_purity_04_61fbe8b9:
    "Кто знает, может, она и есть та самая, которую я ждал!"

# ch/harmony/events.rpy:4509
translate russian harmony_purity_04_1ec8e05e:
    "Когда наши губы соприкасаются, всё кажется правильным."

# ch/harmony/events.rpy:4510
translate russian harmony_purity_04_938314c8:
    "Я всегда знал, откуда на самом деле берётся напряжение между нами."

# ch/harmony/events.rpy:4511
translate russian harmony_purity_04_d75a9385:
    "И теперь не собираюсь упускать шанс немного его снять."

# ch/harmony/events.rpy:4512
translate russian harmony_purity_04_18eb5fb3:
    "Я поворачиваю голову и усиливаю поцелуй, до этого такой целомудренный."

# ch/harmony/events.rpy:4513
translate russian harmony_purity_04_23a8ce67:
    "Хармони удивлённо пищит, когда я плотнее прижимаюсь к её губам."

# ch/harmony/events.rpy:4514
translate russian harmony_purity_04_8e525003:
    "Но этот звук тут же превращается в беспомощный, прерывистый вздох."

# ch/harmony/events.rpy:4515
translate russian harmony_purity_04_fe055e23:
    "Уже через секунду-другую она отвечает с такой же страстью."

# ch/harmony/events.rpy:4516
translate russian harmony_purity_04_66161354:
    "Не поймите неправильно: мы не самозабвенно целуемся взасос посреди парка."

# ch/harmony/events.rpy:4517
translate russian harmony_purity_04_9de472b4:
    "По моим обычным меркам всё довольно скромно."

# ch/harmony/events.rpy:4518
translate russian harmony_purity_04_b250ce6a:
    "Но сейчас я дарю один из первых наших поцелуев совсем не обычной девушке."

# ch/harmony/events.rpy:4519
translate russian harmony_purity_04_271dda50:
    "Из-за невинности и чистоты Хармони мне кажется, что я заодно её чему-то учу."

# ch/harmony/events.rpy:4520
translate russian harmony_purity_04_e4251492:
    "А может, даже немного развращаю..."

# ch/harmony/events.rpy:4521
translate russian harmony_purity_04_733d180a:
    "И всё же никто не обманывает её и не заставляет отвечать на поцелуй."

# ch/harmony/events.rpy:4522
translate russian harmony_purity_04_7dce3b47:
    "Наоборот, с каждой секундой она становится увереннее."

# ch/harmony/events.rpy:4523
translate russian harmony_purity_04_47ca7d22:
    "Клянусь, я не раз чувствую, как кончик её языка проскальзывает между моими губами."

# ch/harmony/events.rpy:4524
translate russian harmony_purity_04_fff29931:
    "Не знаю, сколько длится поцелуй, но в конце концов он сам собой заканчивается."

# ch/harmony/events.rpy:4528
translate russian harmony_purity_04_2862f17e:
    "Мы с Хармони смотрим друг на друга, раскрасневшись и пытаясь отдышаться."

# ch/harmony/events.rpy:4529
translate russian harmony_purity_04_e3d6605d_1:
    mike.say "Прости, Хармони."

# ch/harmony/events.rpy:4530
translate russian harmony_purity_04_4d3ebc2e:
    mike.say "Я не хотел..."

# ch/harmony/events.rpy:4531
translate russian harmony_purity_04_90275c12:
    "Хармони качает головой, отвергая мои сбивчивые извинения ещё до того, как я заканчиваю."

# ch/harmony/events.rpy:4532
translate russian harmony_purity_04_9c8b4cc7:
    harmony.say "Не глупи, [lssb_harmony.hero_name()]."

# ch/harmony/events.rpy:4533
translate russian harmony_purity_04_835b03fc:
    harmony.say "Я этого хотела не меньше тебя!"

# ch/harmony/events.rpy:4534
translate russian harmony_purity_04_9da2ae1f:
    "Я тут же чувствую облегчение."

# ch/harmony/events.rpy:4535
translate russian harmony_purity_04_5b31271c:
    "Её слова помогают понять: я не просто навязался ей."

# ch/harmony/events.rpy:4536
translate russian harmony_purity_04_ed2f2a2e:
    "Это было взаимное, спонтанное желание."

# ch/harmony/events.rpy:4537
translate russian harmony_purity_04_e1785a44:
    harmony.say "И... мне правда было очень приятно."

# ch/harmony/events.rpy:4538
translate russian harmony_purity_04_6885f03f:
    mike.say "Правда?"

# ch/harmony/events.rpy:4539
translate russian harmony_purity_04_65a2449d:
    harmony.say "Да, глупенький, конечно!"

# ch/harmony/events.rpy:4540
translate russian harmony_purity_04_fd8fe838:
    mike.say "Эм... хочешь повторить?"

# ch/harmony/events.rpy:4541
translate russian harmony_purity_04_a3ae4b72:
    "Хармони смеётся, качает головой и целует меня снова."

# ch/harmony/events.rpy:4542
translate russian harmony_purity_04_4356cb1e:
    "Этот поцелуй длится гораздо дольше."

# ch/harmony/events.rpy:4543
translate russian harmony_purity_04_736dc96d:
    "И да, теперь уже с языком..."

# ch/harmony/events.rpy:4551
translate russian harmony_purity_05_fe3b00cb:
    "Помню время, когда ходить на мессу казалось утомительной обязанностью."

# ch/harmony/events.rpy:4552
translate russian harmony_purity_05_f25441cc:
    "Чем-то, что я должен делать, а не хочу."

# ch/harmony/events.rpy:4553
translate russian harmony_purity_05_f319bf4f:
    "Но всё изменилось после знакомства с Хармони и начала наших отношений."

# ch/harmony/events.rpy:4554
translate russian harmony_purity_05_ae5e5946:
    "Теперь я с волнением жду каждой мессы."

# ch/harmony/events.rpy:4555
translate russian harmony_purity_05_b94e6f8f:
    "Хотелось бы сказать, что её чистота и благочестие передаются мне."

# ch/harmony/events.rpy:4556
translate russian harmony_purity_05_26204e73:
    "Но будем честны: дело в том, что она невероятно сексуальна!"

# ch/harmony/events.rpy:4557
translate russian harmony_purity_05_f40a898b:
    "Большую часть службы я украдкой поглядываю на неё."

# ch/harmony/events.rpy:4558
translate russian harmony_purity_05_2c0d3b12:
    "Серьёзно, священник мог бы с тем же успехом говорить на иностранном языке."

# ch/harmony/events.rpy:4559
translate russian harmony_purity_05_d3c47d78:
    "Пока мы сидим на церковной скамье, всё моё внимание приковано к Хармони."

# ch/harmony/events.rpy:4561
translate russian harmony_purity_05_16a6e651:
    "Вот и сейчас мы сидим рядом, держась за руки."

# ch/harmony/events.rpy:4562
translate russian harmony_purity_05_b19ee0ec:
    "У каждого на коленях раскрыта Библия, и мы делаем вид, что слушаем проповедь."

# ch/harmony/events.rpy:4563
translate russian harmony_purity_05_455e46fd:
    "Но у меня в голове одна Хармони."

# ch/harmony/events.rpy:4564
translate russian harmony_purity_05_a6e33055:
    "Ну, Хармони и то, как сильно у меня от неё стоит!"

# ch/harmony/events.rpy:4565
translate russian harmony_purity_05_122478d2:
    "Внезапно мне хочется показать ей, как она на меня действует."

# ch/harmony/events.rpy:4566
translate russian harmony_purity_05_a6edfc46:
    "Часть меня понимает, что такой мысли нужно стыдиться."

# ch/harmony/events.rpy:4567
translate russian harmony_purity_05_228134a9:
    "Всё-таки мы в доме Божьем."

# ch/harmony/events.rpy:4568
translate russian harmony_purity_05_b903a17a:
    "Но искушение всегда умело заглушить во мне здравый смысл."

# ch/harmony/events.rpy:4569
translate russian harmony_purity_05_06a33ab5:
    "Я приподнимаю Библию и осторожно тяну её руку под книгу."

# ch/harmony/events.rpy:4571
translate russian harmony_purity_05_6dca902a:
    "Поначалу она смотрит на меня с интересом."

# ch/harmony/events.rpy:4572
translate russian harmony_purity_05_4771bfed:
    "Но, почувствовав твёрдость моего члена, широко раскрывает глаза."

# ch/harmony/events.rpy:4574
translate russian harmony_purity_05_8a68fa9f:
    "Хармони на мгновение переводит взгляд на священника."

# ch/harmony/events.rpy:4575
translate russian harmony_purity_05_aff3e1c0:
    "Я почти уверен, что сейчас она отдёрнет руку."

# ch/harmony/events.rpy:4577
translate russian harmony_purity_05_964523f3:
    "Но вместо этого по её лицу медленно расползается порочная улыбка."

# ch/harmony/events.rpy:4578
translate russian harmony_purity_05_ab0c342e:
    "Конечно, она молчит. Слова здесь и не нужны."

# ch/harmony/events.rpy:4579
translate russian harmony_purity_05_aba4cbc5:
    "Я чувствую, как Хармони находит молнию на моих брюках."

# ch/harmony/events.rpy:4580
translate russian harmony_purity_05_479beaad:
    "Затем ловко расстёгивает её и запускает пальцы внутрь."

# ch/harmony/events.rpy:4581
translate russian harmony_purity_05_0a6d72c7:
    "Сначала она лишь гладит меня через трусы."

# ch/harmony/events.rpy:4582
translate russian harmony_purity_05_dcfcb348:
    "Даже этого хватает, чтобы я стал твёрдым как камень."

# ch/harmony/events.rpy:4583
translate russian harmony_purity_05_d2de9b89:
    "Хочется застонать от удовольствия, кивнуть и подбодрить её."

# ch/harmony/events.rpy:4584
translate russian harmony_purity_05_90c57ea2:
    "Но нельзя ни на секунду выдать происходящее."

# ch/harmony/events.rpy:4585
translate russian harmony_purity_05_00a5b4ca:
    "Мы сидим в церкви среди прихожан."

# ch/harmony/events.rpy:4586
translate russian harmony_purity_05_e1005219:
    "К счастью, Хармони, похоже, не нужны подсказки."

# ch/harmony/events.rpy:4587
translate russian harmony_purity_05_96ed31ae:
    "Её пальцы скользят в трусы и обхватывают мой член."

# ch/harmony/events.rpy:4588
translate russian harmony_purity_05_d27b42ab:
    "Через секунду она неожиданно сильно сжимает его."

# ch/harmony/events.rpy:4589
translate russian harmony_purity_05_d1b28e9a:
    "Мне приходится прикусить язык, чтобы не вскрикнуть."

# ch/harmony/events.rpy:4590
translate russian harmony_purity_05_711debc4:
    "Я кошусь на Хармони: она улыбается шире прежнего."

# ch/harmony/events.rpy:4591
translate russian harmony_purity_05_7679c5d2:
    "Ей это нравится, и с каждой секундой она становится смелее."

# ch/harmony/events.rpy:4592
translate russian harmony_purity_05_d5d505b4:
    "Её губы едва шевелятся, но я чувствую тёплое дыхание возле уха."

# ch/harmony/events.rpy:4593
translate russian harmony_purity_05_df6d5e0a:
    harmony.say "Прости меня, [lssb_harmony.hero_name()]..."

# ch/harmony/events.rpy:4594
translate russian harmony_purity_05_9e6c3e2f:
    harmony.say "Я прекрасно знаю, что это грех, но просто не могу с собой совладать."

# ch/harmony/events.rpy:4595
translate russian harmony_purity_05_8977c45c:
    "Шепча это, она не отрывает взгляда от алтаря."

# ch/harmony/events.rpy:4596
translate russian harmony_purity_05_27b7ac5c:
    "Будто Господь закроет глаза на её поступок, если она будет выглядеть достаточно благочестиво."

# ch/harmony/events.rpy:4597
translate russian harmony_purity_05_fc9ef7a6:
    "За её милым выражением лица я вижу настоящую борьбу."

# ch/harmony/events.rpy:4598
translate russian harmony_purity_05_fd351907:
    "С одной стороны — вера, с другой — жажда, которую она только начинает открывать в себе."

# ch/harmony/events.rpy:4599
translate russian harmony_purity_05_3a25b95b:
    "И сейчас, на этой скамье, жажда побеждает с огромным перевесом."

# ch/harmony/events.rpy:4601
translate russian harmony_purity_05_8db61833:
    "Хармони начинает водить рукой по всей длине члена."

# ch/harmony/events.rpy:4602
translate russian harmony_purity_05_33318c11:
    "Ей не приходится сильно сжимать или особенно стараться."

# ch/harmony/events.rpy:4603
translate russian harmony_purity_05_3f00096d:
    "Ведь страх, что нас обнаружат, никуда не исчезает."

# ch/harmony/events.rpy:4604
translate russian harmony_purity_05_d5137903:
    "От него сердце колотится, а каждое прикосновение кажется опасным."

# ch/harmony/events.rpy:4605
translate russian harmony_purity_05_ef6efcbd:
    "Я украдкой смотрю на раскрытую Библию на колене."

# ch/harmony/events.rpy:4606
translate russian harmony_purity_05_7102e494:
    "Слова на странице расплываются в бессмысленные очертания."

# ch/harmony/events.rpy:4607
translate russian harmony_purity_05_4f754381:
    "Как я должен следить за Писанием, когда рука Хармони обхватывает мой член?"

# ch/harmony/events.rpy:4608
translate russian harmony_purity_05_8d806e78:
    "Все выученные заповеди начисто вылетают из головы."

# ch/harmony/events.rpy:4609
translate russian harmony_purity_05_de4d82f1:
    "И, судя по румянцу на её щеках, у неё тоже."

# ch/harmony/events.rpy:4611
translate russian harmony_purity_05_0daf0d89:
    "Хармони сжимает меня крепче, заставая врасплох."

# ch/harmony/events.rpy:4612
translate russian harmony_purity_05_633e2280:
    "Я невольно дёргаюсь и выпрямляюсь на скамье."

# ch/harmony/events.rpy:4613
translate russian harmony_purity_05_4361b589:
    "Словно встал по стойке смирно."

# ch/harmony/events.rpy:4614
translate russian harmony_purity_05_b7f760d6:
    "К счастью, большинство ничего не замечает."

# ch/harmony/events.rpy:4615
translate russian harmony_purity_05_ba6b3a27:
    "Может, думают, я задремал и вдруг проснулся."

# ch/harmony/events.rpy:4616
translate russian harmony_purity_05_71f93318:
    "Но Хармони-то точно знает, что происходит."

# ch/harmony/events.rpy:4617
translate russian harmony_purity_05_e4fdeeaa:
    "Орган звучит громче, и прихожане негромко отвечают."

# ch/harmony/events.rpy:4618
translate russian harmony_purity_05_3c654dd9:
    "Под прикрытием этого шума Хармони наклоняется чуть ближе."

# ch/harmony/events.rpy:4619
translate russian harmony_purity_05_7d2cc1ae:
    harmony.say "Неужели так порочно получать от этого столько удовольствия?"

# ch/harmony/events.rpy:4620
translate russian harmony_purity_05_e7d489fb:
    "Её шёпот настолько тих, что я скорее чувствую его, чем слышу."

# ch/harmony/events.rpy:4621
translate russian harmony_purity_05_bdc5ecc9:
    harmony.say "Потому что сейчас мне, кажется, совершенно всё равно, [lssb_harmony.hero_name()]."

# ch/harmony/events.rpy:4622
translate russian harmony_purity_05_e460ec1b:
    "От такого признания моей чопорной, набожной Хармони я едва не кончаю на месте."

# ch/harmony/events.rpy:4624
translate russian harmony_purity_05_b89a0351:
    "Она тихонько хихикает, вытаскивая мой член из брюк."

# ch/harmony/events.rpy:4625
translate russian harmony_purity_05_e811c5b1:
    "Я пытаюсь её остановить, но ничего не могу сделать."

# ch/harmony/events.rpy:4626
translate russian harmony_purity_05_bc027137:
    "По крайней мере, не устроив сцену!"

# ch/harmony/events.rpy:4627
translate russian harmony_purity_05_55f0dec1:
    "Я чувствую прохладную обложку Библии на своём члене."

# ch/harmony/events.rpy:4629
translate russian harmony_purity_05_18ab999f:
    "А Хармони снова принимается водить рукой вверх-вниз."

# ch/harmony/events.rpy:4630
translate russian harmony_purity_05_aaaa3ed4:
    "Теперь она движется ещё быстрее и старательнее."

# ch/harmony/events.rpy:4631
translate russian harmony_purity_05_b65eca6c:
    "Может, её возбуждает, что происходящее скрывает только Библия."

# ch/harmony/events.rpy:4632
translate russian harmony_purity_05_7657d62d:
    "А может, она просто настолько увлеклась, что теряет голову."

# ch/harmony/events.rpy:4633
translate russian harmony_purity_05_097190b4:
    "Впрочем, причина её энтузиазма уже неважна."

# ch/harmony/events.rpy:4634
translate russian harmony_purity_05_e22092db:
    "Я смотрю вперёд и стараюсь придать лицу самое благочестивое выражение."

# ch/harmony/events.rpy:4635
translate russian harmony_purity_05_854959e7:
    "Но внутри я целиком в её власти."

# ch/harmony/events.rpy:4636
translate russian harmony_purity_05_62fb5660:
    "Номера гимнов на табличке для меня будто написаны на чужом языке."

# ch/harmony/events.rpy:4637
translate russian harmony_purity_05_85d0747e:
    "Весь мой мир сузился до маленьких тайных движений её руки."

# ch/harmony/events.rpy:4638
translate russian harmony_purity_05_231f576d:
    "Каждое движение приближает меня к весьма нечестивой развязке."

# ch/harmony/events.rpy:4639
translate russian harmony_purity_05_2259de0d:
    "Я чувствую, как она всё ближе подводит меня к потере контроля."

# ch/harmony/events.rpy:4640
translate russian harmony_purity_05_c56b9235:
    "И тут замечаю, как люди тянутся за сборниками гимнов."

# ch/harmony/events.rpy:4641
translate russian harmony_purity_05_9e6752c3:
    "Вот чёрт, сейчас будут вставать и петь!"

# ch/harmony/events.rpy:4643
translate russian harmony_purity_05_34b2ef68:
    "В следующее мгновение меня сотрясает дрожь, и я кончаю."

# ch/harmony/events.rpy:4645
translate russian harmony_purity_05_e5a6d4d4:
    "Сперма брызжет на руку Хармони и обложку Библии."

# ch/harmony/events.rpy:4647
translate russian harmony_purity_05_342a7885:
    "Она хихикает мне в ухо, вытирая руку салфеткой из сумочки."

# ch/harmony/events.rpy:4648
translate russian harmony_purity_05_03529e1a:
    "Затем берёт свой сборник гимнов, пока я судорожно привожу себя в порядок."

# ch/harmony/events.rpy:4652
translate russian harmony_purity_05_bcf0d4d8:
    "Едва успеваю застегнуть ширинку."

# ch/harmony/events.rpy:4653
translate russian harmony_purity_05_d082e056:
    "Чуть не устроив члену обрезание!"

# ch/harmony/events.rpy:4654
translate russian harmony_purity_05_b54cd04a:
    "Забрызганную Библию бросаю под скамью — разберусь потом."

# ch/harmony/events.rpy:4655
translate russian harmony_purity_05_c0a9b53a:
    "Всё ещё растрёпанный и ошалевший, я встаю рядом с Хармони."

# ch/harmony/events.rpy:4656
translate russian harmony_purity_05_27295c3b:
    "А она уже поёт вовсю, сияя улыбкой."

# ch/harmony/events.rpy:4658
translate russian harmony_purity_05_5223e944:
    "Выглядит так, словно только что пережила откровение."

# ch/harmony/events.rpy:4659
translate russian harmony_purity_05_0df74784:
    "Хотя, возможно, и не религиозное."

# ch/harmony/events.rpy:4667
translate russian harmony_purity_06_fda9399e:
    "Сегодня вечером в Хармони что-то изменилось."

# ch/harmony/events.rpy:4668
translate russian harmony_purity_06_b3660f32:
    "Будто её гложет какое-то неутолённое желание."

# ch/harmony/events.rpy:4669
translate russian harmony_purity_06_21d992aa:
    "И она прекрасно замечает все взгляды в свою сторону."

# ch/harmony/events.rpy:4670
translate russian harmony_purity_06_a57c9b0c:
    "Мне уже не раз приходится уводить её от очередного парня."

# ch/harmony/events.rpy:4671
translate russian harmony_purity_06_04e69fa1:
    "Знаю, она всего лишь улыбается в ответ на восхищённый взгляд."

# ch/harmony/events.rpy:4672
translate russian harmony_purity_06_4af0fb2d:
    "Но что-то в её сегодняшнем поведении меня тревожит."

# ch/harmony/events.rpy:4673
translate russian harmony_purity_06_dcccb303:
    "И я не хочу, чтобы всё вышло из-под контроля."

# ch/harmony/events.rpy:4674
translate russian harmony_purity_06_03d33913:
    mike.say "Слушай, Хармони..."

# ch/harmony/events.rpy:4675
translate russian harmony_purity_06_7ecef72d:
    mike.say "Может, перейдём в ВИП-зону?"

# ch/harmony/events.rpy:4677
translate russian harmony_purity_06_e1412cde:
    "Это предложение полностью завладевает её вниманием."

# ch/harmony/events.rpy:4678
translate russian harmony_purity_06_ffe8f4f2:
    "Она приподнимает брови и согласно кивает."

# ch/harmony/events.rpy:4679
translate russian harmony_purity_06_ff384ee8:
    harmony.say "Ты правда можешь нас туда провести?!"

# ch/harmony/events.rpy:4680
translate russian harmony_purity_06_66b9d9b8:
    harmony.say "Если да, я ОБЕИМИ руками за!"

# ch/harmony/events.rpy:4681
translate russian harmony_purity_06_81f2c911:
    "Хармони цепляется за меня, пока я веду её в ВИП-зону."

# ch/harmony/events.rpy:4682
translate russian harmony_purity_06_fa4e01cd:
    "Охранник проверяет мой доступ и пропускает нас."

# ch/harmony/events.rpy:4686
translate russian harmony_purity_06_27159004:
    harmony.say "Ого..."

# ch/harmony/events.rpy:4687
translate russian harmony_purity_06_77bc5cbf:
    harmony.say "Как же это круто, [lssb_harmony.hero_name()]!"

# ch/harmony/events.rpy:4688
translate russian harmony_purity_06_3b8cb647:
    harmony.say "Весь клуб сейчас на нас смотрит!"

# ch/harmony/events.rpy:4690
translate russian harmony_purity_06_ffd75197:
    "Произнося это, Хармони словно вздрагивает."

# ch/harmony/events.rpy:4691
translate russian harmony_purity_06_39b3603a:
    "Будто по всему её телу проходит волна восторга."

# ch/harmony/events.rpy:4692
translate russian harmony_purity_06_f1d8a63c:
    mike.say "Эм..."

# ch/harmony/events.rpy:4693
translate russian harmony_purity_06_ebfcc32e:
    mike.say "Ну что, Хармони..."

# ch/harmony/events.rpy:4694
translate russian harmony_purity_06_12b41255:
    mike.say "Хочешь ещё выпить?"

# ch/harmony/events.rpy:4696
translate russian harmony_purity_06_97084710:
    harmony.say "Нет, [lssb_harmony.hero_name()], я хочу трахаться!"

# ch/harmony/events.rpy:4697
translate russian harmony_purity_06_2f1b2f33:
    "Мне требуется мгновение, чтобы осознать её слова."

# ch/harmony/events.rpy:4698
translate russian harmony_purity_06_d4dfd6c7:
    "Смысл произнесённого я понимаю."

# ch/harmony/events.rpy:4699
translate russian harmony_purity_06_15ce90ca:
    "Но с обстановкой он никак не вяжется."

# ch/harmony/events.rpy:4700
translate russian harmony_purity_06_2c89da38:
    mike.say "Что ты хочешь?"

# ch/harmony/events.rpy:4702
translate russian harmony_purity_06_cd2da79a:
    harmony.say "Я сказала, что хочу трахаться, [lssb_harmony.hero_name()]!"

# ch/harmony/events.rpy:4703
translate russian harmony_purity_06_b4989d52:
    harmony.say "Хочу заняться с тобой сексом прямо здесь и сейчас."

# ch/harmony/events.rpy:4704
translate russian harmony_purity_06_ceef1cb0:
    harmony.say "Можно вон там, в одной из тех кабинок!"

# ch/harmony/events.rpy:4706
translate russian harmony_purity_06_074dde4e:
    "Я смотрю на свободную кабинку, которую показывает Хармони."

# ch/harmony/events.rpy:4707
translate russian harmony_purity_06_8f6b3d0e:
    "Затем снова перевожу взгляд на неё."

# ch/harmony/events.rpy:4708
translate russian harmony_purity_06_b4abbf2e:
    "Здесь возможен только один ответ."

# ch/harmony/events.rpy:4711
translate russian harmony_purity_06_a5888b1c:
    mike.say "Ты читаешь мои мысли, Хармони!"

# ch/harmony/events.rpy:4712
translate russian harmony_purity_06_6219a07f:
    mike.say "Я всегда хотел сделать это в таком месте."

# ch/harmony/events.rpy:4713
translate russian harmony_purity_06_5ffd8aa7:
    mike.say "В конце концов, какой смысл быть важной персоной, если нельзя нарушать правила!"

# ch/harmony/events.rpy:4716
translate russian harmony_purity_06_0bd70097:
    "Лицо Хармони светлеет от моих слов."

# ch/harmony/events.rpy:4717
translate russian harmony_purity_06_33375b49:
    "Она хлопает в ладоши, пока мы спешим к кабинке."

# ch/harmony/events.rpy:4719
translate russian harmony_purity_06_5cdce9c8:
    harmony.say "М-м-м..."

# ch/harmony/events.rpy:4721
translate russian harmony_purity_06_5a31efa3:
    harmony.say "Я так возбуждена, [lssb_harmony.hero_name()]!"

# ch/harmony/events.rpy:4722
translate russian harmony_purity_06_ecb4d97b:
    harmony.say "Не терпится почувствовать тебя внутри!"

# ch/harmony/events.rpy:4724
translate russian harmony_purity_06_71399d7d:
    "Я нетерпеливо киваю и начинаю раздеваться."

# ch/harmony/events.rpy:4725
translate russian harmony_purity_06_ccbcb5a0:
    "От одной мысли о сексе с Хармони у меня уже стоит."

# ch/harmony/events.rpy:4726
translate russian harmony_purity_06_b71bcdee:
    "А то, что всё это время на нас будут смотреть..."

# ch/harmony/events.rpy:4727
translate russian harmony_purity_06_3c0c7eaa:
    "Добавляет совершенно новых острых ощущений!"

# ch/harmony/events.rpy:4729
translate russian harmony_purity_06_79ad04bd:
    "Мы с Хармони раздеваемся с рекордной скоростью, отбрасывая одежду."

# ch/harmony/events.rpy:4730
translate russian harmony_purity_06_29c6a142:
    "Я почти уверен, что никто не станет нам мешать."

# ch/harmony/events.rpy:4731
translate russian harmony_purity_06_4f1ac2dd:
    "Но рисковать незачем."

# ch/harmony/events.rpy:4732
translate russian harmony_purity_06_92c17e4a:
    "Поэтому, раздевшись, мы сразу переходим к делу."

# ch/harmony/events.rpy:4734
translate russian harmony_purity_06_3c713d1c:
    "Я просто крепко хватаю Хармони за пышные бёдра."

# ch/harmony/events.rpy:4735
translate russian harmony_purity_06_817597fa:
    "И одним резким движением тяну назад, насаживая на себя."

# ch/harmony/events.rpy:4736
translate russian harmony_purity_06_35b67366:
    "Она не лгала, когда говорила, что готова."

# ch/harmony/events.rpy:4738
translate russian harmony_purity_06_bde6799d:
    "Мой член лишь на секунду упирается в губы её киски."

# ch/harmony/events.rpy:4740
translate russian harmony_purity_06_d4de9c25:
    "А затем скользит внутрь до самого конца."

# ch/harmony/events.rpy:4741
translate russian harmony_purity_06_e51ffb70:
    harmony.say "Ох..."

# ch/harmony/events.rpy:4742
translate russian harmony_purity_06_6f8fb440:
    harmony.say "Ох, блядь, да!"

# ch/harmony/events.rpy:4744
translate russian harmony_purity_06_23a456a6:
    harmony.say "Как хорошо, [lssb_harmony.hero_name()]!"

# ch/harmony/events.rpy:4745
translate russian harmony_purity_06_75e1e243:
    "И она говорит это не только ради меня."

# ch/harmony/events.rpy:4746
translate russian harmony_purity_06_22a6c839:
    "Мне тоже невероятно приятно."

# ch/harmony/events.rpy:4748
translate russian harmony_purity_06_caedacc5:
    "Так что я сразу начинаю активно двигаться."

# ch/harmony/events.rpy:4749
translate russian harmony_purity_06_6611108c:
    "Люди замечают происходящее даже позже, чем я ожидал."

# ch/harmony/events.rpy:4750
translate russian harmony_purity_06_c1077395:
    "В конце концов, это ночной клуб: свет приглушён, музыка громкая."

# ch/harmony/events.rpy:4751
translate russian harmony_purity_06_c5ec62a6:
    "Но вскоре головы поворачиваются в нашу сторону, взгляды останавливаются на нас."

# ch/harmony/events.rpy:4752
translate russian harmony_purity_06_f5af610d:
    "Никто, похоже, не собирается вмешиваться или требовать прекратить."

# ch/harmony/events.rpy:4753
translate russian harmony_purity_06_286aa1af:
    "Может, вмешались бы, если бы заметили раньше."

# ch/harmony/events.rpy:4754
translate russian harmony_purity_06_478da540:
    "Наверное, куда труднее остановить людей, когда они уже трахаются!"

# ch/harmony/events.rpy:4756
translate russian harmony_purity_06_e2af6563:
    "Едва я убеждаюсь, что мы в центре внимания, как чувствую перемену в Хармони."

# ch/harmony/events.rpy:4757
translate russian harmony_purity_06_a60b4027:
    "Чем больше людей смотрит, тем сильнее она возбуждается."

# ch/harmony/events.rpy:4758
translate russian harmony_purity_06_f8692cdb:
    "Она стонет и задыхается, двигаясь на моём члене словно от этого зависит её жизнь."

# ch/harmony/events.rpy:4759
translate russian harmony_purity_06_5a2cb54e:
    "Чем больше на неё смотрят, тем развратнее она себя ведёт."

# ch/harmony/events.rpy:4760
translate russian harmony_purity_06_f0193273:
    "А чем сильнее Хармони унижает себя, тем больше возбуждаюсь я."

# ch/harmony/events.rpy:4761
translate russian harmony_purity_06_6bf98d22:
    "Её щёки уже пылают."

# ch/harmony/events.rpy:4762
translate russian harmony_purity_06_52bc533f:
    "Только не пойму, от усилий или от смущения!"

# ch/harmony/events.rpy:4763
translate russian harmony_purity_06_adad36ff:
    harmony.say "Ах..."

# ch/harmony/events.rpy:4764
translate russian harmony_purity_06_8270f152:
    harmony.say "Я такая грязная... дешёвая... я дрянь..."

# ch/harmony/events.rpy:4765
translate russian harmony_purity_06_989256db:
    harmony.say "Используй меня как шлюху, [lssb_harmony.hero_name()]... пожалуйста!"

# ch/harmony/events.rpy:4766
translate russian harmony_purity_06_ea2de091:
    "Эти слова окончательно толкают меня за грань."

# ch/harmony/events.rpy:4769
translate russian harmony_purity_06_adb816bf:
    "Я кончаю в Хармони."

# ch/harmony/events.rpy:4771
translate russian harmony_purity_06_5fa6079d:
    "Она вскрикивает."

# ch/harmony/events.rpy:4773
translate russian harmony_purity_06_92e9f1d7:
    "Её тело трепещет и дрожит."

# ch/harmony/events.rpy:4774
translate russian harmony_purity_06_0272e165:
    "Пока я начинаю одеваться, все взгляды всё ещё прикованы к ней."

# ch/harmony/events.rpy:4775
translate russian harmony_purity_06_b9be1204:
    "Я слышу её тяжёлое дыхание и смотрю, как сперма вытекает из её киски."

# ch/harmony/events.rpy:4776
translate russian harmony_purity_06_c07a32fb:
    "Но всё же гадаю: хватило ли Хармони этого, чтобы утолить своё желание?"

# ch/harmony/events.rpy:4780
translate russian harmony_purity_06_b17a1cfc:
    mike.say "Ты не можешь говорить серьёзно, Хармони!"

# ch/harmony/events.rpy:4781
translate russian harmony_purity_06_1f60b98a:
    mike.say "Уверен, это будет непристойное обнажение."

# ch/harmony/events.rpy:4782
translate russian harmony_purity_06_68f09925:
    mike.say "И, наверное, ещё с полдюжины нарушений закона!"

# ch/harmony/events.rpy:4785
translate russian harmony_purity_06_9097b675:
    "Хармони потрясена и разочарована моим отказом."

# ch/harmony/events.rpy:4786
translate russian harmony_purity_06_bc42c39b:
    "Она скрещивает руки на груди и надувает губы."

# ch/harmony/events.rpy:4787
translate russian harmony_purity_06_681279a4:
    harmony.say "Это преступление, только если кто-нибудь заявит."

# ch/harmony/events.rpy:4789
translate russian harmony_purity_06_83f077ec:
    harmony.say "И вообще, какой смысл быть важной персоной?"

# ch/harmony/events.rpy:4790
translate russian harmony_purity_06_ef2d5875:
    harmony.say "Особенно если нельзя делать безумные вещи!"

# ch/harmony/events.rpy:4791
translate russian harmony_purity_06_6cc41714:
    "Я оглядываюсь и замечаю, что наш разговор привлекает внимание."

# ch/harmony/events.rpy:4792
translate russian harmony_purity_06_2916f601:
    "А чего ещё ждать, обсуждая секс в общественном месте?"

# ch/harmony/events.rpy:4793
translate russian harmony_purity_06_896d57db:
    mike.say "Хармони, нам правда лучше уйти."

# ch/harmony/events.rpy:4794
translate russian harmony_purity_06_d7f778e0:
    mike.say "Если хочешь секса, можем заняться им у меня."

# ch/harmony/events.rpy:4795
translate russian harmony_purity_06_9657606f:
    harmony.say "Уф..."

# ch/harmony/events.rpy:4796
translate russian harmony_purity_06_1122a5c0:
    harmony.say "У тебя мы можем трахаться когда угодно, [lssb_harmony.hero_name()]."

# ch/harmony/events.rpy:4797
translate russian harmony_purity_06_a7e2e77a:
    harmony.say "Не верится, что ты такой скучный!"

# ch/harmony/events.rpy:4799
translate russian harmony_purity_06_3d72f061:
    "С этими словами Хармони разворачивается и уходит."

# ch/harmony/events.rpy:4800
translate russian harmony_purity_06_2c0790de:
    "Я спешу за ней, всё ещё пытаясь её переубедить."

# ch/harmony/events.rpy:4808
translate russian harmony_preg_talk_94816de3:
    "Хармони не из тех девушек, которые хорошо скрывают чувства."

# ch/harmony/events.rpy:4809
translate russian harmony_preg_talk_fcf85430:
    "Если её что-то занимает, хорошее или плохое, заметить это нетрудно."

# ch/harmony/events.rpy:4810
translate russian harmony_preg_talk_0cf8879f:
    "Это либо написано у неё на лице, либо полностью поглощает её мысли."

# ch/harmony/events.rpy:4811
translate russian harmony_preg_talk_025dd79e:
    "Поэтому обычно я вижу, когда нам нужно сесть и поговорить."

# ch/harmony/events.rpy:4812
translate russian harmony_preg_talk_f9c93b88:
    "Сегодня я снова замечаю эти признаки и решаю проявить инициативу."

# ch/harmony/events.rpy:4813
translate russian harmony_preg_talk_03d33913:
    mike.say "Слушай, Хармони..."

# ch/harmony/events.rpy:4816
translate russian harmony_preg_talk_77b7bc11:
    harmony.say "Хм..."

# ch/harmony/events.rpy:4819
translate russian harmony_preg_talk_2ead3ada:
    harmony.say "Ой... да, [lssb_harmony.hero_name()]!"

# ch/harmony/events.rpy:4820
translate russian harmony_preg_talk_d9539ff9:
    harmony.say "Прости, я совсем задумалась!"

# ch/harmony/events.rpy:4822
translate russian harmony_preg_talk_54bda9dc:
    mike.say "Я вижу, Хармони!"

# ch/harmony/events.rpy:4823
translate russian harmony_preg_talk_0264dfed:
    mike.say "Что тебя тревожит?"

# ch/harmony/events.rpy:4824
translate russian harmony_preg_talk_d2756a35:
    mike.say "Нам нужно о чём-то поговорить?"

# ch/harmony/events.rpy:4826
translate russian harmony_preg_talk_6928c3f7:
    "Стоит мне предложить разговор, как её реакция говорит сама за себя."

# ch/harmony/events.rpy:4827
translate russian harmony_preg_talk_3db0efd7:
    "Щёки краснеют, и она избегает моего взгляда."

# ch/harmony/events.rpy:4829
translate russian harmony_preg_talk_3e4277f1:
    harmony.say "К... как ты догадался?"

# ch/harmony/events.rpy:4830
translate russian harmony_preg_talk_0031e754:
    harmony.say "О боже..."

# ch/harmony/events.rpy:4831
translate russian harmony_preg_talk_b6cd8edf:
    harmony.say "А я-то думала, что такая скрытная и хитрая!"

# ch/harmony/events.rpy:4833
translate russian harmony_preg_talk_b7b990bf:
    "Я смеюсь и качаю головой."

# ch/harmony/events.rpy:4834
translate russian harmony_preg_talk_323c556b:
    "Иногда Хармони бывает невероятно милой."

# ch/harmony/events.rpy:4835
translate russian harmony_preg_talk_7c59a10c:
    mike.say "Наверное, чутьё!"

# ch/harmony/events.rpy:4836
translate russian harmony_preg_talk_6757cf6b:
    mike.say "Ну..."

# ch/harmony/events.rpy:4837
translate russian harmony_preg_talk_6d39bb47:
    mike.say "О чём ты хотела поговорить?"

# ch/harmony/events.rpy:4838
translate russian harmony_preg_talk_c8903c9f:
    "Хармони глубоко вдыхает, готовясь к предстоящему разговору."

# ch/harmony/events.rpy:4840
translate russian harmony_preg_talk_7473eafd:
    "Затем наконец поворачивается и смотрит мне прямо в глаза."

# ch/harmony/events.rpy:4842
translate russian harmony_preg_talk_fe3f23b4:
    harmony.say "Боюсь, у меня плохие новости, [lssb_harmony.hero_name()]."

# ch/harmony/events.rpy:4843
translate russian harmony_preg_talk_62d1b4fe:
    harmony.say "Кажется, у нас произошла небольшая... случайность!"

# ch/harmony/events.rpy:4845
translate russian harmony_preg_talk_cd815953:
    mike.say "Хармони..."

# ch/harmony/events.rpy:4846
translate russian harmony_preg_talk_2b2061a8:
    mike.say "Ты же не..."

# ch/harmony/events.rpy:4847
translate russian harmony_preg_talk_e0cbb4e7:
    "Хармони вздыхает."

# ch/harmony/events.rpy:4849
translate russian harmony_preg_talk_36b8b510:
    harmony.say "Да, именно."

# ch/harmony/events.rpy:4850
translate russian harmony_preg_talk_4a87d960:
    harmony.say "Утром я сделала тест. Он положительный."

# ch/harmony/events.rpy:4851
translate russian harmony_preg_talk_855f9eee:
    harmony.say "У нас будет ребёнок!"

# ch/harmony/events.rpy:4853
translate russian harmony_preg_talk_8f2efbac:
    "Кажется, глаза сейчас вылезут из орбит."

# ch/harmony/events.rpy:4854
translate russian harmony_preg_talk_7626bb6b:
    "Ещё мгновение назад я самодовольно расспрашивал Хармони."

# ch/harmony/events.rpy:4855
translate russian harmony_preg_talk_53e54769:
    "А теперь моя очередь выглядеть потрясённым."

# ch/harmony/events.rpy:4856
translate russian harmony_preg_talk_b227fbc8:
    mike.say "Ты уверена?!"

# ch/harmony/events.rpy:4857
translate russian harmony_preg_talk_80b17034:
    mike.say "Ты правильно сделала тест?!"

# ch/harmony/events.rpy:4858
translate russian harmony_preg_talk_6ed9d376:
    mike.say "Знаешь, с ними бывает непросто!"

# ch/harmony/events.rpy:4860
translate russian harmony_preg_talk_3dcd4507:
    "Хармони хмурится и немного надувает губы."

# ch/harmony/events.rpy:4862
translate russian harmony_preg_talk_827db278:
    harmony.say "Конечно уверена, [lssb_harmony.hero_name()]!"

# ch/harmony/events.rpy:4863
translate russian harmony_preg_talk_87cd9fda:
    harmony.say "Я бы не стала шутить о таком серьёзном."

# ch/harmony/events.rpy:4866
translate russian harmony_preg_talk_c7f47033:
    harmony.say "И, [lssb_harmony.hero_name()]... часть меня в ужасе, но ещё большая часть испытывает благоговение."

# ch/harmony/events.rpy:4867
translate russian harmony_preg_talk_43e3f552:
    harmony.say "Новая жизнь. Душа растёт внутри меня. Разве это не чудо?"

# ch/harmony/events.rpy:4868
translate russian harmony_preg_talk_644dd402:
    harmony.say "Должно быть, такова Божья воля. Он не послал бы нам благословение, которое нам не суждено принять."

# ch/harmony/events.rpy:4871
translate russian harmony_preg_talk_41f5ce50:
    harmony.say "Я всё думаю: это знак, [lssb_harmony.hero_name()]. Мы всегда были предназначены стать семьёй."

# ch/harmony/events.rpy:4872
translate russian harmony_preg_talk_0e403208:
    harmony.say "Я до смерти напугана, но всё же чувствую: это ещё и благословение."

# ch/harmony/events.rpy:4875
translate russian harmony_preg_talk_65c39dfe:
    harmony.say "Я не знаю, как к этому относиться, [lssb_harmony.hero_name()]. Честно."

# ch/harmony/events.rpy:4876
translate russian harmony_preg_talk_3e9f2bd0:
    harmony.say "То я в ужасе, то ловлю себя на улыбке. Всю неделю молилась об этом."

# ch/harmony/events.rpy:4879
translate russian harmony_preg_talk_4e52948a:
    harmony.say "Прости меня, Господи, но, увидев тест, я обрадовалась, [lssb_harmony.hero_name()]."

# ch/harmony/events.rpy:4880
translate russian harmony_preg_talk_2bcad166:
    harmony.say "Неужели так плохо хотеть от тебя ребёнка после всего, что между нами было?"

# ch/harmony/events.rpy:4884
translate russian harmony_preg_talk_5120a4e9:
    harmony.say "Вот ты и обрюхатил меня, [lssb_harmony.hero_name()]. После стольких раз, когда ты в меня кончал, это было лишь вопросом времени."

# ch/harmony/events.rpy:4885
translate russian harmony_preg_talk_ea70f99a:
    harmony.say "И я этим горжусь. Я отдала тебе своё тело, и посмотри, что мы создали. Попроси — я бы снова встала на колени и всё повторила."

# ch/harmony/events.rpy:4888
translate russian harmony_preg_talk_f1fb9374:
    harmony.say "Так что да. Ты меня обрюхатил, [lssb_harmony.hero_name()]. Такое бывает."

# ch/harmony/events.rpy:4889
translate russian harmony_preg_talk_8b4768ba:
    harmony.say "И знаешь что? В глубине души я даже горжусь, что мы вместе сделали ребёнка."

# ch/harmony/events.rpy:4890
translate russian harmony_preg_talk_b69f8832:
    harmony.say "И что нам теперь делать?!"

# ch/harmony/events.rpy:4894
translate russian harmony_preg_talk_f98b497e:
    "Будто мне исподтишка ударили прямо под дых!"

# ch/harmony/events.rpy:4895
translate russian harmony_preg_talk_63ab012e:
    "Но Хармони права: нужно собраться и принять решение."

# ch/harmony/events.rpy:4896
translate russian harmony_preg_talk_fa6bd629:
    "И честный ответ у меня только один."

# ch/harmony/events.rpy:4897
translate russian harmony_preg_talk_1d2056cc:
    mike.say "Мы должны оставить ребёнка, Хармони."

# ch/harmony/events.rpy:4898
translate russian harmony_preg_talk_221e0c9d:
    mike.say "Нельзя оборвать жизнь ребёнка, которого мы создали вместе!"

# ch/harmony/events.rpy:4902
translate russian harmony_preg_talk_a05525a7:
    "Хармони тут же складывает ладони, словно для молитвы."

# ch/harmony/events.rpy:4903
translate russian harmony_preg_talk_dd22aec9:
    "Раздаётся хлопок, и я вздрагиваю."

# ch/harmony/events.rpy:4905
translate russian harmony_preg_talk_ad963957:
    harmony.say "Слава Господу!"

# ch/harmony/events.rpy:4906
translate russian harmony_preg_talk_aeca6de9:
    harmony.say "Я ЗНАЛА, что ты хороший человек, [lssb_harmony.hero_name()]!"

# ch/harmony/events.rpy:4907
translate russian harmony_preg_talk_e43b8336:
    harmony.say "Праведный человек, в котором живёт Святой Дух!"

# ch/harmony/events.rpy:4911
translate russian harmony_preg_talk_635c8e5a:
    "Хармони разводит руки и буквально бросается на меня."

# ch/harmony/events.rpy:4912
translate russian harmony_preg_talk_f3bf11f3:
    "Обнимает и сжимает словно удав!"

# ch/harmony/events.rpy:4913
translate russian harmony_preg_talk_eeb05891:
    mike.say "Х... Хармони..."

# ch/harmony/events.rpy:4914
translate russian harmony_preg_talk_e17d9106:
    mike.say "Я... не могу... дышать!"

# ch/harmony/events.rpy:4916
translate russian harmony_preg_talk_d60260fa:
    harmony.say "Ой... боже!"

# ch/harmony/events.rpy:4919
translate russian harmony_preg_talk_d8d1ef1d:
    "Она отпускает меня, и я судорожно вдыхаю."

# ch/harmony/events.rpy:4921
translate russian harmony_preg_talk_5916d475:
    harmony.say "Прости, [lssb_harmony.hero_name()]."

# ch/harmony/events.rpy:4922
translate russian harmony_preg_talk_936d2133:
    harmony.say "Я просто так счастлива, что мы станем семьёй!"

# ch/harmony/events.rpy:4923
translate russian harmony_preg_talk_cccaf58a:
    harmony.say "Теперь можно пожениться, остепениться и планировать всю нашу дальнейшую жизнь!"

# ch/harmony/events.rpy:4925
translate russian harmony_preg_talk_a496114c:
    mike.say "А... да, Хармони..."

# ch/harmony/events.rpy:4926
translate russian harmony_preg_talk_7f6ef347:
    mike.say "Звучит... прекрасно!"

# ch/harmony/events.rpy:4928
translate russian harmony_preg_talk_9efe4a16:
    "Хармони глубоко вдыхает, затем устало выдыхает."

# ch/harmony/events.rpy:4929
translate russian harmony_preg_talk_a89246c9:
    "Кивает с невесёлой улыбкой."

# ch/harmony/events.rpy:4933
translate russian harmony_preg_talk_5deed3f2:
    harmony.say "Вот чёрт..."

# ch/harmony/events.rpy:4934
translate russian harmony_preg_talk_4864968c:
    harmony.say "Я надеялась, что ты скажешь обратное!"

# ch/harmony/events.rpy:4935
translate russian harmony_preg_talk_8266ddc4:
    harmony.say "Но если ты правда этого хочешь..."

# ch/harmony/events.rpy:4937
translate russian harmony_preg_talk_d105b87f:
    mike.say "Хочу, Хармони."

# ch/harmony/events.rpy:4938
translate russian harmony_preg_talk_85bba2d1:
    mike.say "Думаю, вместе мы справимся."

# ch/harmony/events.rpy:4940
translate russian harmony_preg_talk_c978ea48:
    "Хармони фыркает и немного надувает губы."

# ch/harmony/events.rpy:4942
translate russian harmony_preg_talk_f7ced413:
    harmony.say "Ну хорошо..."

# ch/harmony/events.rpy:4943
translate russian harmony_preg_talk_ce219c0f:
    harmony.say "Только обещай, что мы не перестанем веселиться!"

# ch/harmony/events.rpy:4944
translate russian harmony_preg_talk_86e610d8:
    harmony.say "До знакомства с тобой я СЛИШКОМ долго была помешана на Иисусе."

# ch/harmony/events.rpy:4945
translate russian harmony_preg_talk_b03c5fd4:
    harmony.say "Если оставим ребёнка, даже не думай переставать меня трахать, ладно?"

# ch/harmony/events.rpy:4947
translate russian harmony_preg_talk_7d6d3f94:
    mike.say "Хорошо, Хармони."

# ch/harmony/events.rpy:4948
translate russian harmony_preg_talk_11b46f3c:
    mike.say "Договорились."

# ch/harmony/events.rpy:4951
translate russian harmony_preg_talk_9efe4a16_1:
    "Хармони глубоко вдыхает, затем устало выдыхает."

# ch/harmony/events.rpy:4952
translate russian harmony_preg_talk_a89246c9_1:
    "Кивает с невесёлой улыбкой."

# ch/harmony/events.rpy:4954
translate russian harmony_preg_talk_e2e18895:
    harmony.say "Я не знала, что ты решишь, [lssb_harmony.hero_name()]."

# ch/harmony/events.rpy:4955
translate russian harmony_preg_talk_986fcd37:
    harmony.say "Поэтому решила довериться случаю и согласиться с твоим выбором."

# ch/harmony/events.rpy:4956
translate russian harmony_preg_talk_8f140824:
    harmony.say "Ладно... видимо, пора мне взрослеть!"

# ch/harmony/events.rpy:4958
translate russian harmony_preg_talk_d2c11c7a:
    "Хармони смотрит мне прямо в глаза."

# ch/harmony/events.rpy:4960
translate russian harmony_preg_talk_01eb2338:
    harmony.say "Но и тебе тоже, мистер!"

# ch/harmony/events.rpy:4961
translate russian harmony_preg_talk_fda89c97:
    harmony.say "Если берёмся за это, то вместе. Понял?"

# ch/harmony/events.rpy:4963
translate russian harmony_preg_talk_99b94ee5:
    "Я киваю, всё ещё немного удивлённый её напором."

# ch/harmony/events.rpy:4964
translate russian harmony_preg_talk_de6fd761:
    mike.say "Конечно, Хармони!"

# ch/harmony/events.rpy:4965
translate russian harmony_preg_talk_2ef48f94:
    mike.say "Ты и я против всего мира!"

# ch/harmony/events.rpy:4967
translate russian harmony_preg_talk_00abf480:
    "Хармони улыбается."

# ch/harmony/events.rpy:4969
translate russian harmony_preg_talk_72937eb0:
    "Затем обнимает меня."

# ch/harmony/events.rpy:4971
translate russian harmony_preg_talk_6a490963:
    harmony.say "Я справлюсь, [lssb_harmony.hero_name()]."

# ch/harmony/events.rpy:4972
translate russian harmony_preg_talk_fcc07858:
    harmony.say "Если ты рядом, я знаю, что справлюсь!"

# ch/harmony/events.rpy:4974
translate russian harmony_preg_talk_f98b497e_1:
    "Будто мне исподтишка ударили прямо под дых!"

# ch/harmony/events.rpy:4975
translate russian harmony_preg_talk_63ab012e_1:
    "Но Хармони права: нужно собраться и принять решение."

# ch/harmony/events.rpy:4976
translate russian harmony_preg_talk_fa6bd629_1:
    "И честный ответ у меня только один."

# ch/harmony/events.rpy:4977
translate russian harmony_preg_talk_7947a14d:
    mike.say "Мы не можем оставить ребёнка, Хармони."

# ch/harmony/events.rpy:4978
translate russian harmony_preg_talk_3c858f8d:
    mike.say "Заводить ребёнка по случайности — ужасная идея."

# ch/harmony/events.rpy:4979
translate russian harmony_preg_talk_74bd22cc:
    mike.say "Думаю, нужно прервать беременность."

# ch/harmony/events.rpy:4983
translate russian harmony_preg_talk_403bfe09:
    "Едва я произношу это, Хармони в ужасе ахает."

# ch/harmony/events.rpy:4984
translate russian harmony_preg_talk_df8b96b5:
    "Будто впервые видит меня настоящего."

# ch/harmony/events.rpy:4985
translate russian harmony_preg_talk_e9bceef9:
    "И только что поняла, что всё это время я был чудовищем!"

# ch/harmony/events.rpy:4987
translate russian harmony_preg_talk_80fb8cdb:
    harmony.say "О нет..."

# ch/harmony/events.rpy:4988
translate russian harmony_preg_talk_62813608:
    harmony.say "Нет, нет, нет!"

# ch/harmony/events.rpy:4989
translate russian harmony_preg_talk_46072a6d:
    harmony.say "Господи, спаси меня! Святые, защитите!"

# ch/harmony/events.rpy:4990
translate russian harmony_preg_talk_de58dc48:
    harmony.say "Я и не знала, что встречаюсь с детоубийцей!"

# ch/harmony/events.rpy:4992
translate russian harmony_preg_talk_500bc8ae:
    "Хармони уже начинает пятиться."

# ch/harmony/events.rpy:4993
translate russian harmony_preg_talk_ef609d97:
    "Я тянусь к ней, пытаясь объясниться."

# ch/harmony/events.rpy:4994
translate russian harmony_preg_talk_c3a7f114:
    mike.say "Хармони, пожалуйста!"

# ch/harmony/events.rpy:4995
translate russian harmony_preg_talk_742beba7:
    mike.say "Тебе не кажется, что ты слишком остро реагируешь?"

# ch/harmony/events.rpy:4996
translate russian harmony_preg_talk_f8075036:
    "Но всё бесполезно: она отскакивает, избегая моей руки."

# ch/harmony/events.rpy:4998
translate russian harmony_preg_talk_f4e909d8:
    harmony.say "Не трогай меня!"

# ch/harmony/events.rpy:4999
translate russian harmony_preg_talk_6825c4b2:
    harmony.say "Теперь я всё вижу!"

# ch/harmony/events.rpy:5000
translate russian harmony_preg_talk_1ea01fe2:
    harmony.say "В тебе сидит дьявол!"

# ch/harmony/events.rpy:5001
translate russian harmony_preg_talk_4dccbdad:
    harmony.say "Ты хочешь склонить меня ко греху, заманить в ад!"

# ch/harmony/events.rpy:5002
translate russian harmony_preg_talk_711c9fa6:
    harmony.say "Но я не позволю! Я выращу своего ребёнка в свете Божьем!"

# ch/harmony/events.rpy:5004
translate russian harmony_preg_talk_b9eb438c:
    "Не дав мне сказать больше ни слова, Хармони разворачивается и убегает."

# ch/harmony/events.rpy:5005
translate russian harmony_preg_talk_8c156737:
    "Глядя ей вслед, я чувствую, что между нами всё только что закончилось."

# ch/harmony/events.rpy:5011
translate russian harmony_preg_talk_f5399955:
    harmony.say "Боже, [lssb_harmony.hero_name()]!"

# ch/harmony/events.rpy:5012
translate russian harmony_preg_talk_95ebf0d3:
    harmony.say "Как же я рада это слышать!"

# ch/harmony/events.rpy:5013
translate russian harmony_preg_talk_3eab8f12:
    harmony.say "Я думала, ты захочешь оставить ребёнка!"

# ch/harmony/events.rpy:5015
translate russian harmony_preg_talk_57e49470:
    "Сначала меня охватывает облегчение: мы с Хармони согласны."

# ch/harmony/events.rpy:5016
translate russian harmony_preg_talk_fbebaafd:
    "Но затем я задумываюсь, как быстро она, кажется, с этим примирилась."

# ch/harmony/events.rpy:5017
translate russian harmony_preg_talk_a5b9a1d8:
    mike.say "Не хочешь стать мамой, Хармони?"

# ch/harmony/events.rpy:5018
translate russian harmony_preg_talk_5eee584c:
    mike.say "Семья тебя совсем не привлекает? Даже в будущем?"

# ch/harmony/events.rpy:5020
translate russian harmony_preg_talk_8de700b1:
    "Хармони фыркает от смеха и качает головой."

# ch/harmony/events.rpy:5022
translate russian harmony_preg_talk_b63f05aa:
    harmony.say "Не-а!"

# ch/harmony/events.rpy:5023
translate russian harmony_preg_talk_b57660e9:
    harmony.say "Раньше мне всё это нравилось."

# ch/harmony/events.rpy:5024
translate russian harmony_preg_talk_712b722a:
    harmony.say "Когда голова была забита религиозной чушью, помнишь?"

# ch/harmony/events.rpy:5025
translate russian harmony_preg_talk_c3580f1e:
    harmony.say "Но теперь мне слишком весело, чтобы останавливаться и остепеняться!"

# ch/harmony/events.rpy:5027
translate russian harmony_preg_talk_6d27e68f:
    "Я киваю, убеждая себя, что именно это и хотел услышать."

# ch/harmony/events.rpy:5028
translate russian harmony_preg_talk_502df1ef:
    "Ведь я тоже так считаю... Наверное."

# ch/harmony/events.rpy:5031
translate russian harmony_preg_talk_9efe4a16_2:
    "Хармони глубоко вдыхает, затем устало выдыхает."

# ch/harmony/events.rpy:5032
translate russian harmony_preg_talk_a89246c9_2:
    "Кивает с невесёлой улыбкой."

# ch/harmony/events.rpy:5035
translate russian harmony_preg_talk_a04f1c24:
    harmony.say "Ты прав, [lssb_harmony.hero_name()], мы не можем растить ребёнка."

# ch/harmony/events.rpy:5036
translate russian harmony_preg_talk_568e98fc:
    harmony.say "По крайней мере сейчас. Мы к этому не готовы."

# ch/harmony/events.rpy:5037
translate russian harmony_preg_talk_8e159260:
    harmony.say "Я знала, что другого ответа нет."

# ch/harmony/events.rpy:5039
translate russian harmony_preg_talk_e6c7aba9:
    harmony.say "Наверное, просто хотела услышать это и от тебя."

# ch/harmony/events.rpy:5042
translate russian harmony_preg_talk_7ef81a98:
    "Хармони прижимается ко мне, положив голову на плечо."

# ch/harmony/events.rpy:5043
translate russian harmony_preg_talk_68242b96:
    "Мы долго молча обнимаемся."

# ch/harmony/events.rpy:5044
translate russian harmony_preg_talk_963711a5:
    "Каждый погружён в свои мысли."

# ch/harmony/events.rpy:5045
translate russian harmony_preg_talk_7eb8d753:
    "Но оба знаем, что делаем правильный выбор."

# ch/harmony/events.rpy:5046
translate russian harmony_preg_talk_29b6869b:
    "Потому что только этот выбор имеет смысл."

# ch/harmony/events.rpy:5047
translate russian harmony_preg_talk_ac670d14:
    "Хотя радоваться ему мы не обязаны."

# ch/harmony/events.rpy:5051
translate russian harmony_preg_talk_b65f465a:
    harmony.say "Я знала, что ты так скажешь."

# ch/harmony/events.rpy:5052
translate russian harmony_preg_talk_aac78f63:
    harmony.say "Ты пока не готов стать отцом."

# ch/harmony/events.rpy:5053
translate russian harmony_preg_talk_05d6d7ef:
    harmony.say "Я уважаю это, [lssb_harmony.hero_name()]."

# ch/harmony/events.rpy:5054
translate russian harmony_preg_talk_ab2ccd0a:
    harmony.say "Но я не стану прерывать жизнь собственного ребёнка."

# ch/harmony/events.rpy:5056
translate russian harmony_preg_talk_952d64d8:
    "Хармони слабо и устало улыбается."

# ch/harmony/events.rpy:5058
translate russian harmony_preg_talk_0a0fee2f:
    harmony.say "Поэтому справлюсь сама."

# ch/harmony/events.rpy:5060
translate russian harmony_preg_talk_cd815953_1:
    mike.say "Хармони..."

# ch/harmony/events.rpy:5061
translate russian harmony_preg_talk_553a46cf:
    mike.say "Ты не обязана..."

# ch/harmony/events.rpy:5063
translate russian harmony_preg_talk_0e6d1058:
    harmony.say "Нет, [lssb_harmony.hero_name()], обязана!"

# ch/harmony/events.rpy:5064
translate russian harmony_preg_talk_a3d9f1bd:
    harmony.say "Может, попробуем снова, когда ты будешь готов к другому."

# ch/harmony/events.rpy:5065
translate russian harmony_preg_talk_b4d89887:
    harmony.say "Но пока, видимо, прощай!"

# ch/harmony/events.rpy:5067
translate russian harmony_preg_talk_3dc5bbbe:
    "Хармони целует меня в щёку."

# ch/harmony/events.rpy:5069
translate russian harmony_preg_talk_a5c99418:
    "Затем машет рукой и уходит."

# ch/harmony/events.rpy:5070
translate russian harmony_preg_talk_7ad256f7:
    "А я стою один с чувством, будто получил пощёчину."

# ch/harmony/events.rpy:5082
translate russian harmony_male_ending_d4c8535c:
    "Не помню, когда в последний раз видел часовню настолько полной людей и радостного ожидания."

# ch/harmony/events.rpy:5083
translate russian harmony_male_ending_b513f184:
    "Всё украшено цветами, и каждый, кажется, постарался красиво одеться."

# ch/harmony/events.rpy:5084
translate russian harmony_male_ending_046e3ed8:
    "Я почти физически ощущаю тепло, исходящее от гостей."

# ch/harmony/events.rpy:5085
translate russian harmony_male_ending_e0702bf5:
    "И все эти добрые чувства обращены к нам с Хармони. Даже не верится!"

# ch/harmony/events.rpy:5086
translate russian harmony_male_ending_0e41c017:
    "Я думал, только меня переполняет счастье от предстоящей свадьбы с любовью всей моей жизни."

# ch/harmony/events.rpy:5087
translate russian harmony_male_ending_50bfe98c:
    "Но достаточно оглядеть часовню, чтобы понять: здесь все рады нашему союзу."

# ch/harmony/events.rpy:5088
translate russian harmony_male_ending_1b10dc04:
    "Я вижу своих родных и друзей, и это успокаивает."

# ch/harmony/events.rpy:5089
translate russian harmony_male_ending_f5f18699:
    "Хотя гостей со стороны Хармони, кажется, почти вдвое больше."

# ch/harmony/events.rpy:5090
translate russian harmony_male_ending_698d72e7:
    "Вот её родные, с которыми я уже познакомился."

# ch/harmony/events.rpy:5091
translate russian harmony_male_ending_05e9ac0d:
    "Кажется, узнаю и нескольких её друзей."

# ch/harmony/events.rpy:5092
translate russian harmony_male_ending_ee5d8244:
    "И ещё множество прихожан церкви, в которую мы оба ходим!"

# ch/harmony/events.rpy:5093
translate russian harmony_male_ending_daed1385:
    "Сердце переполняется теплом от мысли, как сильно любят Хармони."

# ch/harmony/events.rpy:5094
translate russian harmony_male_ending_2d9f0f70:
    "И именно на этой девушке я женюсь!"

# ch/harmony/events.rpy:5095
translate russian harmony_male_ending_3c909799:
    "Я так погружён в мысли о Хармони, что почти не замечаю музыку."

# ch/harmony/events.rpy:5096
translate russian harmony_male_ending_bd90f787:
    "Часовню наполняет изящная традиционная мелодия, которую она выбрала для своего выхода к алтарю."

# ch/harmony/events.rpy:5097
translate russian harmony_male_ending_e155c87c:
    "Когда все встают, встречая невесту, я наконец возвращаюсь к реальности."

# ch/harmony/events.rpy:5098
translate russian harmony_male_ending_8dcdcd59:
    "Но уже через мгновение всё снова кажется сном."

# ch/harmony/events.rpy:5100
translate russian harmony_male_ending_40053747:
    "Потому что Хармони входит в часовню — словно сбывшаяся мечта!"

# ch/harmony/events.rpy:5101
translate russian harmony_male_ending_f8fafb78:
    "Её платье, конечно, белоснежное, символ добродетели и чистоты."

# ch/harmony/events.rpy:5102
translate russian harmony_male_ending_1ae6d696:
    "Но именно её лицо притягивает мой взгляд и заставляет тянуться к ней."

# ch/harmony/events.rpy:5104
translate russian harmony_male_ending_7554f716:
    "Хармони буквально сияет, шагая к алтарю."

# ch/harmony/events.rpy:5105
translate russian harmony_male_ending_0c8dffa8:
    "С самого её появления она смотрит только на меня."

# ch/harmony/events.rpy:5106
translate russian harmony_male_ending_e0aa7e47:
    "С каждым её шагом я всё сильнее убеждаюсь: нам суждено быть вместе."

# ch/harmony/events.rpy:5107
translate russian harmony_male_ending_0a668d41:
    "Улыбка и любовь в её глазах почти завораживают меня."

# ch/harmony/events.rpy:5108
translate russian harmony_male_ending_8d0a4f31:
    "Мне даже приходится сунуть руку в карман брюк и ущипнуть себя."

# ch/harmony/events.rpy:5110
translate russian harmony_male_ending_401376a5:
    "Чтобы, когда она встанет рядом, поверить: всё происходит наяву!"

# ch/harmony/events.rpy:5111
translate russian harmony_male_ending_b6b86ea1:
    "Священник" "Кхм..."

# ch/harmony/events.rpy:5113
translate russian harmony_male_ending_ef8ec674:
    "Услышав покашливание священника, мы с Хармони выпрямляемся."

# ch/harmony/events.rpy:5114
translate russian harmony_male_ending_3faaa974:
    "Мы репетировали этот момент столько раз, что довели всё до совершенства."

# ch/harmony/events.rpy:5115
translate russian harmony_male_ending_008d1185:
    "Так что никто из нас не боится пропустить свою реплику."

# ch/harmony/events.rpy:5116
translate russian harmony_male_ending_81a70b3a:
    "Священник" "Дорогие собравшиеся..."

# ch/harmony/events.rpy:5117
translate russian harmony_male_ending_d601e095:
    "Священник" "Мы собрались здесь сегодня..."

# ch/harmony/events.rpy:5118
translate russian harmony_male_ending_ee2c07fb:
    "Священник" "Чтобы соединить этих двоих священными узами брака."

# ch/harmony/events.rpy:5119
translate russian harmony_male_ending_bfcb0a69:
    "Конечно, Хармони настояла на самой традиционной церемонии."

# ch/harmony/events.rpy:5120
translate russian harmony_male_ending_218334fc:
    "А значит, разные люди долго читают отрывки из Библии."

# ch/harmony/events.rpy:5121
translate russian harmony_male_ending_78314a4c:
    "Звучит немало гимнов, которые присутствующие то бормочут, то завывают."

# ch/harmony/events.rpy:5122
translate russian harmony_male_ending_f800b6b3:
    "И священник произносит множество витиеватых слов, совершая обряд."

# ch/harmony/events.rpy:5123
translate russian harmony_male_ending_5f511598:
    "Но главная часть церемонии остаётся прежней."

# ch/harmony/events.rpy:5124
translate russian harmony_male_ending_2c5b282b:
    "Священник" "Берёшь ли ты, Хармони, этого мужчину..."

# ch/harmony/events.rpy:5125
translate russian harmony_male_ending_cf2a6223:
    "Священник" "В законные мужья?"

# ch/harmony/events.rpy:5126
translate russian harmony_male_ending_2f1ed4e5:
    "Священник" "Обещаешь ли любить его, почитать и слушаться?"

# ch/harmony/events.rpy:5127
translate russian harmony_male_ending_cd69d463:
    harmony.say "Да."

# ch/harmony/events.rpy:5128
translate russian harmony_male_ending_2ec4e4f4:
    "Священник" "А ты, [lssb_harmony.hero_name()], берёшь ли эту женщину..."

# ch/harmony/events.rpy:5129
translate russian harmony_male_ending_2a1666d2:
    "Священник" "В законные жёны?"

# ch/harmony/events.rpy:5130
translate russian harmony_male_ending_d7a57b58:
    "Священник" "Обещаешь ли любить её, почитать и слушаться?"

# ch/harmony/events.rpy:5131
translate russian harmony_male_ending_cc481164:
    mike.say "Да."

# ch/harmony/events.rpy:5132
translate russian harmony_male_ending_e524799f:
    "Священник" "Прекрасно."

# ch/harmony/events.rpy:5133
translate russian harmony_male_ending_58c83231:
    "Священник" "Обращаюсь ко всем присутствующим..."

# ch/harmony/events.rpy:5134
translate russian harmony_male_ending_dfe1d15d:
    "Священник" "Если кому-то известна законная причина, по которой эти двое не могут вступить в брак..."

# ch/harmony/events.rpy:5135
translate russian harmony_male_ending_713d080b:
    "Священник" "Пусть скажет сейчас или замолчит навеки!"

# ch/harmony/events.rpy:5136
translate russian harmony_male_ending_64e2fd56:
    "Конечно, в этот момент все слегка посмеиваются."

# ch/harmony/events.rpy:5137
translate russian harmony_male_ending_0746383a:
    "Никому и в голову не придёт встать и что-то сказать."

# ch/harmony/events.rpy:5138
translate russian harmony_male_ending_bd37822d:
    "Да и кто найдёт хоть одно пятнышко на репутации Хармони?"

# ch/harmony/events.rpy:5139
translate russian harmony_male_ending_42a8b42a:
    "В моём прошлом, возможно, и найдутся мелкие поводы для придирок."

# ch/harmony/events.rpy:5140
translate russian harmony_male_ending_586b0e65:
    "Но не в её. Она практически ангел во плоти!"

# ch/harmony/events.rpy:5141
translate russian harmony_male_ending_e524799f_1:
    "Священник" "Прекрасно."

# ch/harmony/events.rpy:5142
translate russian harmony_male_ending_b11b7ee3:
    "Священник" "Тогда с огромной радостью объявляю вас мужем и женой."

# ch/harmony/events.rpy:5143
translate russian harmony_male_ending_5afd38c2:
    "Священник" "Можете поцеловать невесту!"

# ch/harmony/events.rpy:5148
translate russian harmony_male_ending_c005e1b7:
    "Мы с Хармони следуем указанию, и через мгновение наши губы соприкасаются."

# ch/harmony/events.rpy:5149
translate russian harmony_male_ending_f6f3689d:
    "Я ожидаю вполне целомудренного поцелуя."

# ch/harmony/events.rpy:5150
translate russian harmony_male_ending_edca36a9:
    "Но Хармони застаёт меня врасплох, скользнув языком между моими губами!"

# ch/harmony/events.rpy:5151
translate russian harmony_male_ending_8b8cae5b:
    "Я инстинктивно растворяюсь в поцелуе, наслаждаясь каждым мгновением."

# ch/harmony/events.rpy:5152
translate russian harmony_male_ending_7bfdaccc:
    "Но где-то на краю сознания всё же гадаю, что это значит."

# ch/harmony/events.rpy:5153
translate russian harmony_male_ending_32819e8a:
    "Неужели теперь, когда мы официально женаты, в Хармони просыпается новая сторона?"

# ch/harmony/events.rpy:5154
translate russian harmony_male_ending_871bb4e3:
    "Она ведь намекала, что в супружеской постели можно веселиться, не боясь осуждения!"

# ch/harmony/events.rpy:5155
translate russian harmony_male_ending_546ae43a:
    "Может, меня ждёт брачная ночь, которая задаст тон всей нашей жизни..."

# ch/harmony/events.rpy:5159
translate russian harmony_male_ending_c199f454:
    harmony.say "Хм... Не уверена, что у меня это получится."

# ch/harmony/events.rpy:5160
translate russian harmony_male_ending_40c3b875:
    harmony.say "Понимаете, я девушка очень традиционных взглядов. Люблю думать, что знаю своё место."

# ch/harmony/events.rpy:5161
translate russian harmony_male_ending_e27637ca:
    harmony.say "Обычно такими делами за нас обоих занимается [lssb_harmony.hero_name()]."

# ch/harmony/events.rpy:5162
translate russian harmony_male_ending_f1a93b2e:
    harmony.say "Но, наверное, это всё-таки ВАЖНО. А он иногда немного путается..."

# ch/harmony/events.rpy:5163
translate russian harmony_male_ending_c7ae0618:
    harmony.say "Ладно-ладно... хорошо. Расскажу, что думаю о нас и о том, как всё сложилось."

# ch/harmony/events.rpy:5164
translate russian harmony_male_ending_7300d3ae:
    harmony.say "Только не вырывайте мои слова из контекста, обещаете?"

# ch/harmony/events.rpy:5165
translate russian harmony_male_ending_3bbac3c8:
    harmony.say "Ладно, начнём..."

# ch/harmony/events.rpy:5166
translate russian harmony_male_ending_6900ae74:
    harmony.say "Очень долго я думала, что в моей жизни будет лишь одна настоящая любовь."

# ch/harmony/events.rpy:5167
translate russian harmony_male_ending_6ade7b3b:
    harmony.say "И, конечно, это была любовь к Богу!"

# ch/harmony/events.rpy:5168
translate russian harmony_male_ending_78d3b5ac:
    harmony.say "Вера всегда была для меня важна, она освещала путь во тьме."

# ch/harmony/events.rpy:5169
translate russian harmony_male_ending_4062b55b:
    harmony.say "Поэтому, когда однажды в воскресенье в церкви появился [lssb_harmony.hero_name()], я приняла его без вопросов."

# ch/harmony/events.rpy:5170
translate russian harmony_male_ending_0699bfbe:
    harmony.say "Для меня он был ещё одним заблудшим агнцем, которого нужно вернуть в стадо."

# ch/harmony/events.rpy:5171
translate russian harmony_male_ending_a1b71bd5:
    harmony.say "Но вскоре я заметила, что он становится для меня гораздо большим."

# ch/harmony/events.rpy:5172
translate russian harmony_male_ending_4bdca95f:
    harmony.say "Я постоянно думала о нём, искала поводы побыть рядом."

# ch/harmony/events.rpy:5173
translate russian harmony_male_ending_b8b45dcf:
    harmony.say "Вскоре я уже считала нас хорошими друзьями, понимаете?"

# ch/harmony/events.rpy:5174
translate russian harmony_male_ending_a6209b45:
    harmony.say "Но на этом всё не закончилось. Он занял все мои мысли."

# ch/harmony/events.rpy:5175
translate russian harmony_male_ending_cf8203da:
    harmony.say "Мне стало трудно думать о чём-то другом!"

# ch/harmony/events.rpy:5176
translate russian harmony_male_ending_3c1be41a:
    harmony.say "Даже найти время для молитвы или изучения Библии было почти невозможно."

# ch/harmony/events.rpy:5177
translate russian harmony_male_ending_2b4a4c74:
    harmony.say "Вот тогда мне стало тяжело."

# ch/harmony/events.rpy:5178
translate russian harmony_male_ending_f6203ee4:
    harmony.say "Меня тянуло к [lssb_harmony.hero_name()]."

# ch/harmony/events.rpy:5179
translate russian harmony_male_ending_2b8eb30f:
    harmony.say "Но он же отвлекал меня от веры!"

# ch/harmony/events.rpy:5180
translate russian harmony_male_ending_e6d1b6db:
    harmony.say "И я пришла к единственному логичному выводу."

# ch/harmony/events.rpy:5181
translate russian harmony_male_ending_8b7d008a:
    harmony.say "Его послал дьявол, чтобы искушать меня!"

# ch/harmony/events.rpy:5182
translate russian harmony_male_ending_c3e385a9:
    harmony.say "Каждый раз, когда во мне просыпалось греховное желание к [lssb_harmony.hero_name()], я боролась с ним."

# ch/harmony/events.rpy:5183
translate russian harmony_male_ending_2fa9e768:
    harmony.say "Я не могла отказать ему во встречах: это было бы нехристианским поступком."

# ch/harmony/events.rpy:5184
translate russian harmony_male_ending_b5920ce3:
    harmony.say "Так что продолжала, прикрываясь верой словно щитом от искушения."

# ch/harmony/events.rpy:5185
translate russian harmony_male_ending_d88c1715:
    harmony.say "Всё время ждала, что [lssb_harmony.hero_name()] начнёт испытывать мою стойкость."

# ch/harmony/events.rpy:5186
translate russian harmony_male_ending_c5900d88:
    harmony.say "Думала, он изо всех сил постарается склонить меня ко греху!"

# ch/harmony/events.rpy:5187
translate russian harmony_male_ending_26f69c97:
    harmony.say "Но, к моему удивлению, он ничего такого не делал."

# ch/harmony/events.rpy:5188
translate russian harmony_male_ending_9f5d68c8:
    harmony.say "Конечно, он всего лишь человек. К тому же мужчина!"

# ch/harmony/events.rpy:5189
translate russian harmony_male_ending_66ab94f5:
    harmony.say "Иногда было совершенно ясно, что он считает меня привлекательной."

# ch/harmony/events.rpy:5190
translate russian harmony_male_ending_d4820777:
    harmony.say "Но он как-то умел держать себя в руках и уважать мои границы."

# ch/harmony/events.rpy:5191
translate russian harmony_male_ending_25431b33:
    harmony.say "Это запутывало меня ещё сильнее."

# ch/harmony/events.rpy:5192
translate russian harmony_male_ending_b89eda88:
    harmony.say "Если он орудие дьявола, почему сдерживается?"

# ch/harmony/events.rpy:5193
translate russian harmony_male_ending_49dc709b:
    harmony.say "Почему готов уважать меня и при этом всё равно хочет видеться?"

# ch/harmony/events.rpy:5194
translate russian harmony_male_ending_c1d84bf4:
    harmony.say "И однажды я поняла, что ошибалась."

# ch/harmony/events.rpy:5195
translate russian harmony_male_ending_8f2264cf:
    harmony.say "[lssb_harmony.hero_name()] был послан не дьяволом для искушения."

# ch/harmony/events.rpy:5196
translate russian harmony_male_ending_d6303062:
    harmony.say "Его послал Бог, чтобы испытать мою веру."

# ch/harmony/events.rpy:5197
translate russian harmony_male_ending_c00bece2:
    harmony.say "Бог послал мне доброго, любящего мужчину, который будет меня уважать."

# ch/harmony/events.rpy:5198
translate russian harmony_male_ending_3991af45:
    harmony.say "Испытывали меня: достойна ли я его!"

# ch/harmony/events.rpy:5199
translate russian harmony_male_ending_3b92bcf9:
    harmony.say "Всю жизнь я считала себя доброй христианкой."

# ch/harmony/events.rpy:5200
translate russian harmony_male_ending_db54c87a:
    harmony.say "Теперь предстояло это доказать."

# ch/harmony/events.rpy:5201
translate russian harmony_male_ending_df72e74b:
    harmony.say "Доказать, что я могу завоевать любовь этого мужчины."

# ch/harmony/events.rpy:5202
translate russian harmony_male_ending_c5169f42:
    harmony.say "И сделать это, не предлагая ему своего тела."

# ch/harmony/events.rpy:5203
translate russian harmony_male_ending_a66b8c70:
    harmony.say "Порой было трудно, почти невыносимо."

# ch/harmony/events.rpy:5204
translate russian harmony_male_ending_3aa07987:
    harmony.say "Но когда он опустился на одно колено и предложил выйти за него..."

# ch/harmony/events.rpy:5205
translate russian harmony_male_ending_a4b71864:
    harmony.say "Я поняла, что выдержала испытание!"

# ch/harmony/events.rpy:5206
translate russian harmony_male_ending_360cb0c3:
    harmony.say "А после этого... всё было как в сказке!"

# ch/harmony/events.rpy:5207
translate russian harmony_male_ending_1ecbfc82:
    harmony.say "Мы с [lssb_harmony.hero_name()] обосновались в маленьком собственном доме."

# ch/harmony/events.rpy:5208
translate russian harmony_male_ending_7e3c19cd:
    harmony.say "Он по-прежнему каждый день усердно трудится в офисе, чтобы оплачивать счета."

# ch/harmony/events.rpy:5209
translate russian harmony_male_ending_e2f326c4:
    harmony.say "Но я стараюсь убедить его бросить это и заняться чем-нибудь более полезным."

# ch/harmony/events.rpy:5210
translate russian harmony_male_ending_1a31e91e:
    harmony.say "Например, стать пастором или даже миссионером!"

# ch/harmony/events.rpy:5211
translate russian harmony_male_ending_682206be:
    harmony.say "И скажем так: своими супружескими обязанностями я тоже не пренебрегаю."

# ch/harmony/events.rpy:5212
translate russian harmony_male_ending_eee2bc2d:
    harmony.say "До свадьбы я, возможно, заставляла его сдерживать животные инстинкты."

# ch/harmony/events.rpy:5213
translate russian harmony_male_ending_8fade7df:
    harmony.say "Но в браке такие вещи почти поощряются!"

# ch/harmony/events.rpy:5214
translate russian harmony_male_ending_d4c9d5df:
    harmony.say "Он показал мне столько удивительного, что мне почти кажется, будто раньше я многое упускала!"

# ch/harmony/events.rpy:5216
translate russian harmony_male_ending_298f2a7f:
    harmony.say "Ах да, ещё кое-что..."

# ch/harmony/events.rpy:5217
translate russian harmony_male_ending_d90e7d98:
    harmony.say "Не знаю, заметил ли [lssb_harmony.hero_name()], что мой животик округляется."

# ch/harmony/events.rpy:5218
translate russian harmony_male_ending_37cfbcc4:
    harmony.say "С каждым днём он растёт, так что скоро муж узнает: наша семья станет больше!"

# ch/harmony/events.rpy:5219
translate russian harmony_male_ending_30077b64:
    harmony.say "Врач говорит, будет мальчик."

# ch/harmony/events.rpy:5220
translate russian harmony_male_ending_bb878f97:
    harmony.say "И я знаю, как обрадуется [lssb_harmony.hero_name()], когда я ему скажу!"

# ch/harmony/events.rpy:5221
translate russian harmony_male_ending_d5e885d8:
    harmony.say "Вот и вся моя история."

# ch/harmony/events.rpy:5222
translate russian harmony_male_ending_66218e09:
    harmony.say "Мне кажется, я получила награду за верность своей вере."

# ch/harmony/events.rpy:5223
translate russian harmony_male_ending_4765a412:
    harmony.say "Оставшись верной себе, я получила всё, чего хотела, и даже больше."

# ch/harmony/events.rpy:5225
translate russian harmony_male_ending_3a57f10e:
    harmony.say "Теперь буду так же верна мужу — [lssb_harmony.hero_name()] — и нашему сыну, когда он появится!"

# ch/harmony/events.rpy:5229
translate russian harmony_male_ending_0d2a3d9b:
    "Часть меня всё ещё не верит, что я действительно стою у алтаря."

# ch/harmony/events.rpy:5230
translate russian harmony_male_ending_6a0ab17f:
    "И жду, когда Хармони пройдёт ко мне по проходу."

# ch/harmony/events.rpy:5231
translate russian harmony_male_ending_72424f5a:
    "Конечно, отчасти я просто поражён тем, что женюсь."

# ch/harmony/events.rpy:5232
translate russian harmony_male_ending_20b60f49:
    "Но во многом дело в том, что свадьба едва вообще состоялась!"

# ch/harmony/events.rpy:5233
translate russian harmony_male_ending_28f06d60:
    "Знаю, многие девушки планируют свадьбу с юных лет."

# ch/harmony/events.rpy:5234
translate russian harmony_male_ending_21d93e9e:
    "Но то, что придумала Хармони, вряд ли было её детской мечтой."

# ch/harmony/events.rpy:5235
translate russian harmony_male_ending_d644e939:
    "Думаю, это скорее плод её новой, раскованной жизни."

# ch/harmony/events.rpy:5236
translate russian harmony_male_ending_219f897f:
    "Не хочу вдаваться в подробности."

# ch/harmony/events.rpy:5237
translate russian harmony_male_ending_083160ec:
    "Скажем так: Хармони хотела устроить нечто весьма скандальное!"

# ch/harmony/events.rpy:5238
translate russian harmony_male_ending_78c9f944:
    "К счастью, мне удалось отговорить её от большей части затей."

# ch/harmony/events.rpy:5239
translate russian harmony_male_ending_224155e7:
    "К моменту окончательного решения она пошла на компромисс."

# ch/harmony/events.rpy:5240
translate russian harmony_male_ending_6e5bb8be:
    "Поэтому сегодня мы венчаемся в часовне, а не оскверняем её!"

# ch/harmony/events.rpy:5241
translate russian harmony_male_ending_a77820cf:
    "Оглядев гостей, я понимаю, почему большинство из них здесь."

# ch/harmony/events.rpy:5242
translate russian harmony_male_ending_aa546a4c:
    "Моя половина часовни почти заполнена родными и друзьями."

# ch/harmony/events.rpy:5243
translate russian harmony_male_ending_0428d43f:
    "Но со стороны Хармони картина совсем другая."

# ch/harmony/events.rpy:5244
translate russian harmony_male_ending_82382662:
    "Там гораздо меньше людей, скамьи почти наполовину пусты."

# ch/harmony/events.rpy:5245
translate russian harmony_male_ending_5c978323:
    "Наверное, это отражает то, как сильно Хармони изменилась с нашего знакомства."

# ch/harmony/events.rpy:5246
translate russian harmony_male_ending_428578be:
    "Тогда она принадлежала к церковной общине и имела там много друзей."

# ch/harmony/events.rpy:5247
translate russian harmony_male_ending_26f22f02:
    "Но, когда стала отходить от прежней жизни, эти люди отвернулись от неё."

# ch/harmony/events.rpy:5248
translate russian harmony_male_ending_9ae7ec95:
    "От одной мысли об этом будто нож вонзается в живот."

# ch/harmony/events.rpy:5249
translate russian harmony_male_ending_d5eda966:
    "Я отвожу взгляд от её половины часовни."

# ch/harmony/events.rpy:5250
translate russian harmony_male_ending_6c4dd461:
    "И молча клянусь делать всё, что в моих силах, ради будущей жены."

# ch/harmony/events.rpy:5251
translate russian harmony_male_ending_5ed6c6e4:
    "Пусть те люди от неё отвернулись."

# ch/harmony/events.rpy:5252
translate russian harmony_male_ending_981acc2a:
    "Я всегда буду рядом и поддержу её, что бы ни случилось!"

# ch/harmony/events.rpy:5253
translate russian harmony_male_ending_6983cb30:
    "Пока я даю себе это обещание, часовня вдруг оживает."

# ch/harmony/events.rpy:5254
translate russian harmony_male_ending_2e422461:
    "Музыка звучит громче, гости дружно встают и оборачиваются."

# ch/harmony/events.rpy:5255
translate russian harmony_male_ending_f79656bc:
    "Я тоже смотрю туда, стараясь разглядеть то же, что и они."

# ch/harmony/events.rpy:5257
translate russian harmony_male_ending_a7fc0783:
    "Когда Хармони наконец входит, по залу проносится восхищённый вздох."

# ch/harmony/events.rpy:5258
translate russian harmony_male_ending_1b83a879:
    "Хотя не знаю, от восторга он или от потрясения."

# ch/harmony/events.rpy:5259
translate russian harmony_male_ending_1f08ac0b:
    "Потому что платье было одной из вещей, насчёт которых она не уступила."

# ch/harmony/events.rpy:5260
translate russian harmony_male_ending_1aafbf06:
    "Свадебное платье Хармони невероятно смелое."

# ch/harmony/events.rpy:5261
translate russian harmony_male_ending_c3afa146:
    "Оно подчёркивает каждую линию и каждый изгиб её тела."

# ch/harmony/events.rpy:5262
translate russian harmony_male_ending_691fc5fb:
    "И каким-то образом при этом всё ещё остаётся приличным!"

# ch/harmony/events.rpy:5263
translate russian harmony_male_ending_3d8fb94c:
    "Другой мужчина мог бы ужаснуться такому наряду."

# ch/harmony/events.rpy:5264
translate russian harmony_male_ending_532f6bdc:
    "Но не я. Я просто сражён тем, как прекрасна моя невеста!"

# ch/harmony/events.rpy:5266
translate russian harmony_male_ending_abcb2a37:
    "Моя улыбка становится шире, когда я замечаю растущий животик Хармони."

# ch/harmony/events.rpy:5267
translate russian harmony_male_ending_8dcba420:
    "Платье почти совсем не скрывает её беременность."

# ch/harmony/events.rpy:5268
translate russian harmony_male_ending_903eb6ab:
    "Но зачем её скрывать?"

# ch/harmony/events.rpy:5269
translate russian harmony_male_ending_22943d3e:
    "Нам обоим нечего стыдиться."

# ch/harmony/events.rpy:5270
translate russian harmony_male_ending_677e5cd3:
    "Наш ребёнок зачат в любви, и расти он будет тоже в любви."

# ch/harmony/events.rpy:5272
translate russian harmony_male_ending_da1514bf:
    "В миниатюрных стройных женщинах нет ничего плохого."

# ch/harmony/events.rpy:5273
translate russian harmony_male_ending_7cd442a0:
    "Но, побывав с такой пышной девушкой, как Хармони..."

# ch/harmony/events.rpy:5274
translate russian harmony_male_ending_cfe9f94b:
    "Нет, я не скажу, что к другим уже не вернёшься!"

# ch/harmony/events.rpy:5275
translate russian harmony_male_ending_e94cb67f:
    "Но такую фигуру точно никогда не забудешь!"

# ch/harmony/events.rpy:5276
translate russian harmony_male_ending_27525c99:
    "К алтарю Хармони подходит с широкой улыбкой."

# ch/harmony/events.rpy:5277
translate russian harmony_male_ending_6949d67c:
    "Вблизи она ещё прекраснее, чем казалась в проходе."

# ch/harmony/events.rpy:5280
translate russian harmony_male_ending_d20c4353:
    harmony.say "Ну что, [lssb_harmony.hero_name()]..."

# ch/harmony/events.rpy:5281
translate russian harmony_male_ending_2dbd33a7:
    harmony.say "Как тебе твоя будущая жена?"

# ch/harmony/events.rpy:5283
translate russian harmony_male_ending_0a8f8f7b:
    mike.say "Ух ты, Хармони... просто ух ты!"

# ch/harmony/events.rpy:5284
translate russian harmony_male_ending_4be28ea4:
    mike.say "Ты великолепна!"

# ch/harmony/events.rpy:5286
translate russian harmony_male_ending_cbc840c0:
    harmony.say "Спасибо, [lssb_harmony.hero_name()]!"

# ch/harmony/events.rpy:5287
translate russian harmony_male_ending_c6ea2f6c:
    harmony.say "Я и сама чувствую себя ТАКОЙ сексуальной!"

# ch/harmony/events.rpy:5289
translate russian harmony_male_ending_bf449e7f:
    harmony.say "Все на меня смотрят, я ТАК возбуждаюсь!"

# ch/harmony/events.rpy:5291
translate russian harmony_male_ending_b6b86ea1_1:
    "Священник" "Кхм..."

# ch/harmony/events.rpy:5293
translate russian harmony_male_ending_2fa31e93:
    "Мы оба слегка вздрагиваем, когда священник прочищает горло."

# ch/harmony/events.rpy:5294
translate russian harmony_male_ending_00cf8ca5:
    "Не знаю, слышал ли он наш разговор."

# ch/harmony/events.rpy:5295
translate russian harmony_male_ending_9dfd344a:
    "Но всё равно чувствую, как краснею."

# ch/harmony/events.rpy:5296
translate russian harmony_male_ending_126a19c4:
    "К счастью, он делает вид, будто лишь напоминает нам о церемонии."

# ch/harmony/events.rpy:5297
translate russian harmony_male_ending_da0db528:
    "Священник" "Может, начнём?"

# ch/harmony/events.rpy:5298
translate russian harmony_male_ending_0deea157:
    "Мы киваем и стараемся выглядеть готовыми."

# ch/harmony/events.rpy:5299
translate russian harmony_male_ending_0f6d6f6a:
    "Священник" "Прекрасно..."

# ch/harmony/events.rpy:5300
translate russian harmony_male_ending_81a70b3a_1:
    "Священник" "Дорогие собравшиеся..."

# ch/harmony/events.rpy:5301
translate russian harmony_male_ending_d601e095_1:
    "Священник" "Мы собрались здесь сегодня..."

# ch/harmony/events.rpy:5302
translate russian harmony_male_ending_ee2c07fb_1:
    "Священник" "Чтобы соединить этих двоих священными узами брака."

# ch/harmony/events.rpy:5304
translate russian harmony_male_ending_c5832088:
    "Услышав слово «узы», Хармони хихикает."

# ch/harmony/events.rpy:5305
translate russian harmony_male_ending_1697fefe:
    "И бросает на меня похотливый взгляд, сразу выдающий её мысли."

# ch/harmony/events.rpy:5306
translate russian harmony_male_ending_ef4d1f9e:
    "Я невольно улыбаюсь и качаю головой, хотя пытаюсь сохранить серьёзное лицо."

# ch/harmony/events.rpy:5308
translate russian harmony_male_ending_9e1fd09f:
    "Большая часть церемонии проходит вполне ожидаемо."

# ch/harmony/events.rpy:5309
translate russian harmony_male_ending_c5e09999:
    "Мы настояли, чтобы её сократили до необходимого минимума."

# ch/harmony/events.rpy:5310
translate russian harmony_male_ending_ae24a3a0:
    "Главным образом потому, что Хармони разошлась во взглядах с религией."

# ch/harmony/events.rpy:5311
translate russian harmony_male_ending_181a88e9:
    "Так что до главного мы добираемся довольно быстро."

# ch/harmony/events.rpy:5312
translate russian harmony_male_ending_890065b5:
    "Священник" "Берёшь ли ты, Хармони..."

# ch/harmony/events.rpy:5313
translate russian harmony_male_ending_19d4c65b:
    "Священник" "Этого мужчину по имени [lssb_harmony.hero_name()]..."

# ch/harmony/events.rpy:5314
translate russian harmony_male_ending_cf2a6223_1:
    "Священник" "В законные мужья?"

# ch/harmony/events.rpy:5316
translate russian harmony_male_ending_bd148fcf:
    harmony.say "Ещё бы!"

# ch/harmony/events.rpy:5317
translate russian harmony_male_ending_9ad51d3e:
    "Священник" "Эм... да, прекрасно..."

# ch/harmony/events.rpy:5319
translate russian harmony_male_ending_d034391f:
    "Священник" "А ты, [lssb_harmony.hero_name()], берёшь ли..."

# ch/harmony/events.rpy:5320
translate russian harmony_male_ending_7ec529cd:
    "Священник" "Эту женщину, Хармони..."

# ch/harmony/events.rpy:5321
translate russian harmony_male_ending_2a1666d2_1:
    "Священник" "В законные жёны?"

# ch/harmony/events.rpy:5322
translate russian harmony_male_ending_e20e0952:
    mike.say "Да!"

# ch/harmony/events.rpy:5323
translate russian harmony_male_ending_87a43dbc:
    "Священник" "Тогда да поможет тебе Бог!"

# ch/harmony/events.rpy:5324
translate russian harmony_male_ending_e84ffc6f:
    mike.say "Что?"

# ch/harmony/events.rpy:5326
translate russian harmony_male_ending_d21d9c15:
    harmony.say "Что вы сказали?"

# ch/harmony/events.rpy:5327
translate russian harmony_male_ending_050f7d53:
    "Священник" "О... ничего, совсем ничего!"

# ch/harmony/events.rpy:5329
translate russian harmony_male_ending_b6b86ea1_2:
    "Священник" "Кхм..."

# ch/harmony/events.rpy:5330
translate russian harmony_male_ending_01ce6b7f:
    "Священник" "После того как они произнесли свои клятвы перед вами..."

# ch/harmony/events.rpy:5331
translate russian harmony_male_ending_65f783f3:
    "Священник" "Я обязан спросить..."

# ch/harmony/events.rpy:5332
translate russian harmony_male_ending_ed58698d:
    "Священник" "Если кому-то известна законная причина..."

# ch/harmony/events.rpy:5333
translate russian harmony_male_ending_663b0a15:
    "Священник" "По которой эти двое не могут соединиться священными узами брака..."

# ch/harmony/events.rpy:5334
translate russian harmony_male_ending_713d080b_1:
    "Священник" "Пусть скажет сейчас или замолчит навеки!"

# ch/harmony/events.rpy:5335
translate russian harmony_male_ending_0b744242:
    "Повисает привычная многозначительная пауза, пока священник осматривает часовню."

# ch/harmony/events.rpy:5336
translate russian harmony_male_ending_33834c43:
    "Конечно, все слегка посмеиваются, пока он для вида ждёт ответа."

# ch/harmony/events.rpy:5337
translate russian harmony_male_ending_1f7d3663:
    "Но я невольно думаю, что именно сейчас за Хармони могут прийти."

# ch/harmony/events.rpy:5338
translate russian harmony_male_ending_fed33d70:
    "Что сюда ворвутся фанатичные прихожане её прежней церкви."

# ch/harmony/events.rpy:5339
translate russian harmony_male_ending_79aadf5d:
    "И утащат её спасать от греховной жизни!"

# ch/harmony/events.rpy:5340
translate russian harmony_male_ending_ff587b61:
    "К счастью, этого не происходит, и священник довольно кивает."

# ch/harmony/events.rpy:5341
translate russian harmony_male_ending_7ad1ece9:
    "Священник" "Прекрасно!"

# ch/harmony/events.rpy:5342
translate russian harmony_male_ending_83450df4:
    "Священник" "Тогда властью, данной мне..."

# ch/harmony/events.rpy:5343
translate russian harmony_male_ending_2a30dc55:
    "Священник" "Объявляю вас мужем и женой!"

# ch/harmony/events.rpy:5344
translate russian harmony_male_ending_5afd38c2_1:
    "Священник" "Можете поцеловать невесту!"

# ch/harmony/events.rpy:5345
translate russian harmony_male_ending_9c7af1e9:
    "Я поворачиваюсь исполнить сказанное, но Хармони меня опережает."

# ch/harmony/events.rpy:5350
translate russian harmony_male_ending_a1587171:
    "Едва я оборачиваюсь к ней, она буквально набрасывается на меня."

# ch/harmony/events.rpy:5351
translate russian harmony_male_ending_c5d52a63:
    "Её губы впиваются в мои, язык проскальзывает мне в рот."

# ch/harmony/events.rpy:5352
translate russian harmony_male_ending_432f1bb1:
    "Я чуть ли не держусь за неё, чтобы не упасть!"

# ch/harmony/events.rpy:5353
translate russian harmony_male_ending_8090f2ad:
    "Но быстро прихожу в себя."

# ch/harmony/events.rpy:5354
translate russian harmony_male_ending_00404fb8:
    "И отвечаю на поцелуй почти с такой же страстью."

# ch/harmony/events.rpy:5355
translate russian harmony_male_ending_ddb9a256:
    "Как же хорошо держать Хармони в объятиях — такую тёплую и отзывчивую."

# ch/harmony/events.rpy:5356
translate russian harmony_male_ending_6a77e83e:
    "Но лучше всего знать, что этому не нужно заканчиваться."

# ch/harmony/events.rpy:5357
translate russian harmony_male_ending_bd58ed81:
    "С этого мгновения впереди у нас вся жизнь вместе."

# ch/harmony/events.rpy:5359
translate russian harmony_male_ending_53bd08ed:
    harmony.say "Вам легко просить меня о таком."

# ch/harmony/events.rpy:5360
translate russian harmony_male_ending_bcdb1489:
    harmony.say "Просто сесть и рассказать всё о нас с [lssb_harmony.hero_name()]."

# ch/harmony/events.rpy:5361
translate russian harmony_male_ending_7cc577ae:
    harmony.say "Но вы попробуйте посмотреть на это моими глазами."

# ch/harmony/events.rpy:5362
translate russian harmony_male_ending_fc94ad72:
    harmony.say "[lssb_harmony.hero_name()] — не просто случайный парень, с которым я познакомилась и начала встречаться."

# ch/harmony/events.rpy:5363
translate russian harmony_male_ending_a5212a0c:
    harmony.say "До его появления я была совершенно другим человеком."

# ch/harmony/events.rpy:5364
translate russian harmony_male_ending_acd579ba:
    harmony.say "Он изменил всю мою жизнь. Изменил меня саму!"

# ch/harmony/events.rpy:5365
translate russian harmony_male_ending_ad082459:
    harmony.say "Что?"

# ch/harmony/events.rpy:5366
translate russian harmony_male_ending_8224564f:
    harmony.say "А... ладно... Наверное, могу просто объяснить, как это случилось."

# ch/harmony/events.rpy:5367
translate russian harmony_male_ending_f10ea8b8:
    harmony.say "Но я не согласна, что слишком всё усложняю!"

# ch/harmony/events.rpy:5368
translate russian harmony_male_ending_5318ac62:
    harmony.say "По-моему, это вы не понимаете..."

# ch/harmony/events.rpy:5369
translate russian harmony_male_ending_6f86b1b9:
    harmony.say "Так вот, тогда я была целиком поглощена религией."

# ch/harmony/events.rpy:5370
translate russian harmony_male_ending_d94a8534:
    harmony.say "Она составляла почти весь мой круг общения и занимала все мысли."

# ch/harmony/events.rpy:5371
translate russian harmony_male_ending_a8ef900f:
    harmony.say "Если что-то не касалось Бога и Иисуса, меня это не интересовало."

# ch/harmony/events.rpy:5372
translate russian harmony_male_ending_abb9cab4:
    harmony.say "Не хотела бы я встретить прежнюю себя. Та ещё скучная корова!"

# ch/harmony/events.rpy:5373
translate russian harmony_male_ending_966144d6:
    harmony.say "Вечно старалась быть хорошей, изображала кротость и прижимала к себе Библию."

# ch/harmony/events.rpy:5374
translate russian harmony_male_ending_4fd647fa:
    harmony.say "Уф... Меня передёргивает от мысли, что я когда-то была такой!"

# ch/harmony/events.rpy:5375
translate russian harmony_male_ending_62a2326b:
    harmony.say "И, конечно, когда мы с [lssb_harmony.hero_name()] познакомились, всё снова сводилось к Богу!"

# ch/harmony/events.rpy:5376
translate russian harmony_male_ending_69bafda9:
    harmony.say "Глядя на него, я видела лишь очередную заблудшую овечку, которую нужно спасти."

# ch/harmony/events.rpy:5377
translate russian harmony_male_ending_72feb3b4:
    harmony.say "Ему не хватало пыла в вере."

# ch/harmony/events.rpy:5378
translate russian harmony_male_ending_86cb9cdb:
    harmony.say "Не хватало преданности Тому, Кто Наверху."

# ch/harmony/events.rpy:5379
translate russian harmony_male_ending_76ee9d7f:
    harmony.say "И я, как настоящая религиозная дура, решила, что обязана его изменить."

# ch/harmony/events.rpy:5380
translate russian harmony_male_ending_a6d8f19e:
    harmony.say "Всё началось как обычно: дружелюбие пополам со снисходительностью."

# ch/harmony/events.rpy:5381
translate russian harmony_male_ending_563e4d60:
    harmony.say "Я потакала его явному интересу к моим женским прелестям."

# ch/harmony/events.rpy:5382
translate russian harmony_male_ending_81854cef:
    harmony.say "Да-да, не думайте, будто я не знала, что я горячая штучка!"

# ch/harmony/events.rpy:5383
translate russian harmony_male_ending_084f4290:
    harmony.say "И не думайте, будто тогда я брезговала пользоваться этим ради своего!"

# ch/harmony/events.rpy:5384
translate russian harmony_male_ending_24143a41:
    harmony.say "Я заманила его — [lssb_harmony.hero_name()] — в свою религиозную паутинку и принялась за обработку."

# ch/harmony/events.rpy:5385
translate russian harmony_male_ending_9732c461:
    harmony.say "Думала, много времени это не займёт: лёгкая добыча."

# ch/harmony/events.rpy:5386
translate russian harmony_male_ending_fb1001d4:
    harmony.say "Но вскоре сама стала путаться и забывать, что делаю и зачем."

# ch/harmony/events.rpy:5387
translate russian harmony_male_ending_dd680370:
    harmony.say "Знаете почему?"

# ch/harmony/events.rpy:5388
translate russian harmony_male_ending_674d6e82:
    harmony.say "Потому что [lssb_harmony.hero_name()] начал хорошо ко мне относиться и интересоваться мной."

# ch/harmony/events.rpy:5389
translate russian harmony_male_ending_f88142e0:
    harmony.say "Не той религиозной чушью, которую я пыталась ему всучить."

# ch/harmony/events.rpy:5390
translate russian harmony_male_ending_4194a31e:
    harmony.say "И не возможностью использовать меня для собственного удовольствия."

# ch/harmony/events.rpy:5391
translate russian harmony_male_ending_1b427243:
    harmony.say "Ему просто хотелось быть рядом!"

# ch/harmony/events.rpy:5392
translate russian harmony_male_ending_5fb78d75:
    harmony.say "И да, мне это нравилось."

# ch/harmony/events.rpy:5393
translate russian harmony_male_ending_dc08e3d8:
    harmony.say "Очень нравилось!"

# ch/harmony/events.rpy:5394
translate russian harmony_male_ending_e5c20a60:
    harmony.say "Вскоре я уже ждала наших свиданий ради самих свиданий."

# ch/harmony/events.rpy:5395
translate russian harmony_male_ending_9c137c33:
    harmony.say "А... ну... потом он познакомил меня и с физической стороной отношений!"

# ch/harmony/events.rpy:5396
translate russian harmony_male_ending_3fc11ae6:
    harmony.say "Мне всегда твердили, что предаваться плотским удовольствиям порочно."

# ch/harmony/events.rpy:5397
translate russian harmony_male_ending_e9cdcbe4:
    harmony.say "Что этот путь может привести лишь в адское пламя!"

# ch/harmony/events.rpy:5398
translate russian harmony_male_ending_1352a699:
    harmony.say "Но то, что я чувствовала во время наших поцелуев и занятий любовью..."

# ch/harmony/events.rpy:5399
translate russian harmony_male_ending_666f7410:
    harmony.say "Почти сразу я поняла: это не может быть чем-то плохим."

# ch/harmony/events.rpy:5400
translate russian harmony_male_ending_8f00dbc5:
    harmony.say "Да, [lssb_harmony.hero_name()] разжёг во мне огонь."

# ch/harmony/events.rpy:5401
translate russian harmony_male_ending_7fc296c6:
    harmony.say "Он горит до сих пор, и я хочу поддерживать это пламя!"

# ch/harmony/events.rpy:5403
translate russian harmony_male_ending_ece0f0ab:
    harmony.say "И да, в итоге я забеременела."

# ch/harmony/events.rpy:5404
translate russian harmony_male_ending_49072453:
    harmony.say "Но мы оба взрослые люди, а не глупые дети."

# ch/harmony/events.rpy:5405
translate russian harmony_male_ending_d25e6026:
    harmony.say "И вместе решили создать семью."

# ch/harmony/events.rpy:5406
translate russian harmony_male_ending_fd8fa80b:
    harmony.say "Поверьте, [lssb_harmony.hero_name()] далеко не идеальный папа!"

# ch/harmony/events.rpy:5407
translate russian harmony_male_ending_983abaed:
    harmony.say "Но он очень старается, и Джейми его за это любит."

# ch/harmony/events.rpy:5409
translate russian harmony_male_ending_f46bb5ea:
    harmony.say "И хотя он освободил меня от сексуальных запретов, глупыми детьми мы не были."

# ch/harmony/events.rpy:5410
translate russian harmony_male_ending_9cd59661:
    harmony.say "Мы всё равно предохранялись и следили, чтобы обойтись без неожиданностей."

# ch/harmony/events.rpy:5411
translate russian harmony_male_ending_89308db6:
    harmony.say "Так что теперь у нас есть все условия, чтобы задуматься о детях."

# ch/harmony/events.rpy:5412
translate russian harmony_male_ending_e7941312:
    harmony.say "[lssb_harmony.hero_name()] прекрасно справляется с работой, и дома у него тоже всё отлично."

# ch/harmony/events.rpy:5413
translate russian harmony_male_ending_977524b3:
    harmony.say "А я?"

# ch/harmony/events.rpy:5414
translate russian harmony_male_ending_08942eec:
    harmony.say "Ну... раньше я всегда думала, что стану монахиней."

# ch/harmony/events.rpy:5415
translate russian harmony_male_ending_f5128f42:
    harmony.say "Можете поверить?"

# ch/harmony/events.rpy:5416
translate russian harmony_male_ending_c3145e83:
    harmony.say "А теперь я подумываю пробиться в кино для взрослых."

# ch/harmony/events.rpy:5417
translate russian harmony_male_ending_c059dca7:
    harmony.say "Или стать профессиональной танцовщицей на пилоне!"

# ch/harmony/events.rpy:5418
translate russian harmony_male_ending_60041a2f:
    harmony.say "Современной, сексуально раскрепощённой женщине доступно всё!"

# ch/harmony/events.rpy:5420
translate russian harmony_male_ending_48171d07:
    "Немного странно снова стоять в часовне и ждать появления Хармони."

# ch/harmony/events.rpy:5421
translate russian harmony_male_ending_46dc69ac:
    "Ведь мы познакомились в церкви, когда она была гораздо религиознее."

# ch/harmony/events.rpy:5422
translate russian harmony_male_ending_abe436b1:
    "С тех пор она оставила многое позади, стала больше интересоваться мирской жизнью и открываться новому."

# ch/harmony/events.rpy:5423
translate russian harmony_male_ending_c8a7d8a5:
    "Это особенно заметно по лицам людей на скамьях позади меня."

# ch/harmony/events.rpy:5424
translate russian harmony_male_ending_f71802cb:
    "Почти никого из тех, кого мы раньше видели по воскресеньям в церкви, здесь нет."

# ch/harmony/events.rpy:5425
translate russian harmony_male_ending_64ef4a2a:
    "Но, думаю, это больше говорит о них, чем о нас с Хармони."

# ch/harmony/events.rpy:5426
translate russian harmony_male_ending_88151725:
    "Если они не пришли лишь потому, что она стала менее религиозной, пусть идут к чёрту."

# ch/harmony/events.rpy:5427
translate russian harmony_male_ending_028d0622:
    "Значит, других причин дружить с нами у них никогда и не было."

# ch/harmony/events.rpy:5428
translate russian harmony_male_ending_538d4be8:
    "Зато скамьи заполняют наши родные."

# ch/harmony/events.rpy:5429
translate russian harmony_male_ending_b84198fd:
    "И настоящие друзья тоже здесь, радуются нашей свадьбе."

# ch/harmony/events.rpy:5430
translate russian harmony_male_ending_9a034242:
    "Я поворачиваюсь к алтарю, и священник улыбается мне."

# ch/harmony/events.rpy:5431
translate russian harmony_male_ending_ba36ed0e:
    "Я улыбаюсь в ответ, радуясь, что он почти незнакомый человек."

# ch/harmony/events.rpy:5432
translate russian harmony_male_ending_a285680b:
    "Значит, не станет читать нам нотации о том, что мы отвернулись от Бога!"

# ch/harmony/events.rpy:5433
translate russian harmony_male_ending_108acf15:
    "Священник открывает рот, словно собираясь что-то сказать."

# ch/harmony/events.rpy:5434
translate russian harmony_male_ending_88542ec6:
    "Но в этот момент часовню наполняет музыка."

# ch/harmony/events.rpy:5435
translate russian harmony_male_ending_5998aa38:
    "Мы все как один оборачиваемся к входу."

# ch/harmony/events.rpy:5437
translate russian harmony_male_ending_cae18646:
    "И в дверях появляется Хармони."

# ch/harmony/events.rpy:5438
translate russian harmony_male_ending_31c4c366:
    "Я почти не замечаю волну восхищённых замечаний от гостей."

# ch/harmony/events.rpy:5439
translate russian harmony_male_ending_c92b1803:
    "Потому что могу лишь смотреть на приближающуюся невесту."

# ch/harmony/events.rpy:5440
translate russian harmony_male_ending_cf930465:
    "Хармони сияет и кажется мне прекрасной как никогда."

# ch/harmony/events.rpy:5441
translate russian harmony_male_ending_3a67a97e:
    "Платье идеально подчёркивает её пышную фигуру."

# ch/harmony/events.rpy:5442
translate russian harmony_male_ending_44a75109:
    "Клянусь, я чувствую, как сердце переполняет грудь!"

# ch/harmony/events.rpy:5444
translate russian harmony_male_ending_92bc1e73:
    "Я переживал, что живот Хармони будет слишком заметен."

# ch/harmony/events.rpy:5445
translate russian harmony_male_ending_bd5df0cc:
    "И теперь вижу: не заметить его невозможно."

# ch/harmony/events.rpy:5446
translate russian harmony_male_ending_b2533aea:
    "Но это лишь добавляет ей красоты."

# ch/harmony/events.rpy:5447
translate russian harmony_male_ending_d76d87e2:
    "Знаю, это клише, но она действительно светится!"

# ch/harmony/events.rpy:5449
translate russian harmony_male_ending_d7c3e6d1:
    "Признаюсь, многие мужчины не сводят с неё глаз."

# ch/harmony/events.rpy:5450
translate russian harmony_male_ending_4d05ebbd:
    "И разве можно винить их за хороший вкус?"

# ch/harmony/events.rpy:5451
translate russian harmony_male_ending_6a58c8ab:
    "Да и немало худеньких девушек смотрят с явной завистью!"

# ch/harmony/events.rpy:5452
translate russian harmony_male_ending_4d47ef3a:
    "Ведь такие формы, как у Хармони, — нечто особенное."

# ch/harmony/events.rpy:5456
translate russian harmony_male_ending_a30cf6c8:
    "Подойдя к алтарю, Хармони незаметно берёт меня за руку."

# ch/harmony/events.rpy:5457
translate russian harmony_male_ending_d03e60b4:
    "Сжимает её, давая понять, что волнуется не меньше меня."

# ch/harmony/events.rpy:5458
translate russian harmony_male_ending_d09ea952:
    "Но на большее времени нет: священник начинает церемонию."

# ch/harmony/events.rpy:5459
translate russian harmony_male_ending_81a70b3a_2:
    "Священник" "Дорогие собравшиеся..."

# ch/harmony/events.rpy:5460
translate russian harmony_male_ending_d601e095_2:
    "Священник" "Мы собрались здесь сегодня..."

# ch/harmony/events.rpy:5461
translate russian harmony_male_ending_ee2c07fb_2:
    "Священник" "Чтобы соединить этих двоих священными узами брака."

# ch/harmony/events.rpy:5462
translate russian harmony_male_ending_1764b14e:
    "Хармони совсем не настаивала на соблюдении традиций."

# ch/harmony/events.rpy:5463
translate russian harmony_male_ending_c110294e:
    "Поэтому мы выбрали довольно короткую церемонию."

# ch/harmony/events.rpy:5464
translate russian harmony_male_ending_96f2125f:
    "Решили, что для нас важны только самые главные её части."

# ch/harmony/events.rpy:5465
translate russian harmony_male_ending_940335dc:
    "Так что вскоре доходит до самих клятв."

# ch/harmony/events.rpy:5466
translate russian harmony_male_ending_2c5b282b_1:
    "Священник" "Берёшь ли ты, Хармони, этого мужчину..."

# ch/harmony/events.rpy:5467
translate russian harmony_male_ending_cf2a6223_2:
    "Священник" "В законные мужья?"

# ch/harmony/events.rpy:5469
translate russian harmony_male_ending_cd69d463_1:
    harmony.say "Да."

# ch/harmony/events.rpy:5471
translate russian harmony_male_ending_2ec4e4f4_1:
    "Священник" "А ты, [lssb_harmony.hero_name()], берёшь ли эту женщину..."

# ch/harmony/events.rpy:5472
translate russian harmony_male_ending_2a1666d2_2:
    "Священник" "В законные жёны?"

# ch/harmony/events.rpy:5473
translate russian harmony_male_ending_cc481164_1:
    mike.say "Да."

# ch/harmony/events.rpy:5474
translate russian harmony_male_ending_e524799f_2:
    "Священник" "Прекрасно."

# ch/harmony/events.rpy:5476
translate russian harmony_male_ending_58c83231_1:
    "Священник" "Обращаюсь ко всем присутствующим..."

# ch/harmony/events.rpy:5477
translate russian harmony_male_ending_dfe1d15d_1:
    "Священник" "Если кому-то известна законная причина, по которой эти двое не могут вступить в брак..."

# ch/harmony/events.rpy:5478
translate russian harmony_male_ending_713d080b_2:
    "Священник" "Пусть скажет сейчас или замолчит навеки!"

# ch/harmony/events.rpy:5479
translate russian harmony_male_ending_64e2fd56_1:
    "Конечно, в этот момент все слегка посмеиваются."

# ch/harmony/events.rpy:5480
translate russian harmony_male_ending_0746383a_1:
    "Никому и в голову не придёт встать и что-то сказать."

# ch/harmony/events.rpy:5481
translate russian harmony_male_ending_52eb4077:
    "Но я всё же боюсь, что где-то притаился религиозный псих."

# ch/harmony/events.rpy:5482
translate russian harmony_male_ending_4d9811f2:
    "И только ждёт, чтобы ворваться сюда и потребовать от Хармони вернуться к Богу!"

# ch/harmony/events.rpy:5483
translate russian harmony_male_ending_e524799f_3:
    "Священник" "Прекрасно."

# ch/harmony/events.rpy:5484
translate russian harmony_male_ending_b11b7ee3_1:
    "Священник" "Тогда с огромной радостью объявляю вас мужем и женой."

# ch/harmony/events.rpy:5485
translate russian harmony_male_ending_5afd38c2_2:
    "Священник" "Можете поцеловать невесту!"

# ch/harmony/events.rpy:5490
translate russian harmony_male_ending_c005e1b7_1:
    "Мы с Хармони следуем указанию, и через мгновение наши губы соприкасаются."

# ch/harmony/events.rpy:5491
translate russian harmony_male_ending_f6f3689d_1:
    "Я ожидаю вполне целомудренного поцелуя."

# ch/harmony/events.rpy:5492
translate russian harmony_male_ending_edca36a9_1:
    "Но Хармони застаёт меня врасплох, скользнув языком между моими губами!"

# ch/harmony/events.rpy:5493
translate russian harmony_male_ending_8b8cae5b_1:
    "Я инстинктивно растворяюсь в поцелуе, наслаждаясь каждым мгновением."

# ch/harmony/events.rpy:5494
translate russian harmony_male_ending_d57191c1:
    "Мы сделали это! Мы действительно поженились!"

# ch/harmony/events.rpy:5495
translate russian harmony_male_ending_5b4d0c5b:
    "Теперь осталось лишь решить, что будет дальше..."

# ch/harmony/events.rpy:5497
translate russian harmony_male_ending_090caf1a:
    harmony.say "Есть некоторая ирония в том, что вы просите меня об этом."

# ch/harmony/events.rpy:5498
translate russian harmony_male_ending_d47e927a:
    harmony.say "Ну, рассказать всё о том, кто для меня [lssb_harmony.hero_name()] и что он значит?"

# ch/harmony/events.rpy:5499
translate russian harmony_male_ending_11bd325d:
    harmony.say "Ведь до знакомства с ним я бы на такое не решилась!"

# ch/harmony/events.rpy:5500
translate russian harmony_male_ending_24acd47c:
    harmony.say "Не то чтобы я была затворницей или безумной отшельницей."

# ch/harmony/events.rpy:5501
translate russian harmony_male_ending_a0d01f12:
    harmony.say "Но он определённо помог мне вырасти как личности."

# ch/harmony/events.rpy:5502
translate russian harmony_male_ending_b428d11f:
    harmony.say "До него в моей жизни не было ничего, кроме религии."

# ch/harmony/events.rpy:5503
translate russian harmony_male_ending_6d42620a:
    harmony.say "Я даже не помню времени, когда не была целиком предана церкви!"

# ch/harmony/events.rpy:5504
translate russian harmony_male_ending_ec6feff7:
    harmony.say "И всегда думала, что так будет и дальше."

# ch/harmony/events.rpy:5505
translate russian harmony_male_ending_7dcf1e3c:
    harmony.say "Я была счастлива... По крайней мере, мне так казалось."

# ch/harmony/events.rpy:5506
translate russian harmony_male_ending_3903af66:
    harmony.say "Странная вещь — быть настолько поглощённой чем-то одним."

# ch/harmony/events.rpy:5507
translate russian harmony_male_ending_dda8c871:
    harmony.say "Живёшь внутри пузыря и даже этого не знаешь."

# ch/harmony/events.rpy:5508
translate russian harmony_male_ending_f046d4c5:
    harmony.say "Видишь, что происходит снаружи."

# ch/harmony/events.rpy:5509
translate russian harmony_male_ending_1a8067bf:
    harmony.say "Но пузырь искажает всё, не даёт увидеть настоящие очертания."

# ch/harmony/events.rpy:5510
translate russian harmony_male_ending_26923bbc:
    harmony.say "Уф... Мне трудно в этом признаться!"

# ch/harmony/events.rpy:5511
translate russian harmony_male_ending_5e210142:
    harmony.say "Но да, я была из тех УЖАСНО надоедливых религиозных людей!"

# ch/harmony/events.rpy:5512
translate russian harmony_male_ending_e5d9964c:
    harmony.say "Думала, что знаю все ответы."

# ch/harmony/events.rpy:5513
translate russian harmony_male_ending_c726432b:
    harmony.say "Что единственная нужная мне книга — Библия."

# ch/harmony/events.rpy:5514
translate russian harmony_male_ending_e6b8fce9:
    harmony.say "И когда в церкви появился [lssb_harmony.hero_name()], я увидела возможность."

# ch/harmony/events.rpy:5515
translate russian harmony_male_ending_59e2f6a0:
    harmony.say "Он казался мне человеком, которого нужно спасти."

# ch/harmony/events.rpy:5516
translate russian harmony_male_ending_11fdfadb:
    harmony.say "Которому кто-то должен показать путь к спасению."

# ch/harmony/events.rpy:5517
translate russian harmony_male_ending_2ac795a9:
    harmony.say "И, конечно, я была уверена, что этот кто-то — я!"

# ch/harmony/events.rpy:5518
translate russian harmony_male_ending_2a7033b2:
    harmony.say "Подружившись с ним, я взялась за привычное."

# ch/harmony/events.rpy:5519
translate russian harmony_male_ending_3e5dffc8:
    harmony.say "Приглашала его вместе изучать Библию."

# ch/harmony/events.rpy:5520
translate russian harmony_male_ending_4e5fb189:
    harmony.say "Водила на церковные мероприятия."

# ch/harmony/events.rpy:5521
translate russian harmony_male_ending_ab5731c5:
    harmony.say "Поначалу была уверена: успех — лишь вопрос времени."

# ch/harmony/events.rpy:5522
translate russian harmony_male_ending_50bbfcab:
    harmony.say "Я сделаю из него лучшего христианина и заодно докажу собственную добродетель."

# ch/harmony/events.rpy:5523
translate russian harmony_male_ending_d6c26074:
    harmony.say "Но, как обычно, была самонадеянна и упустила две вещи."

# ch/harmony/events.rpy:5524
translate russian harmony_male_ending_c9fdc40a:
    harmony.say "Во-первых, он задавал вопросы, на которые у меня не было ответов."

# ch/harmony/events.rpy:5525
translate russian harmony_male_ending_245ff7eb:
    harmony.say "И после них я часто сама начинала сомневаться."

# ch/harmony/events.rpy:5526
translate russian harmony_male_ending_9c36ba7b:
    harmony.say "Во-вторых, он нравился мне гораздо сильнее, чем я понимала."

# ch/harmony/events.rpy:5527
translate russian harmony_male_ending_34804389:
    harmony.say "Вскоре я ждала встречи с ним больше всего на свете."

# ch/harmony/events.rpy:5528
translate russian harmony_male_ending_04c4bb2a:
    harmony.say "Почти забыла, ради чего мы вообще начали встречаться."

# ch/harmony/events.rpy:5529
translate russian harmony_male_ending_65084c7f:
    harmony.say "Примерно тогда он стал приглашать меня на свидания."

# ch/harmony/events.rpy:5530
translate russian harmony_male_ending_dbc83633:
    harmony.say "Конечно, он так их не называл, да и я так о них не думала."

# ch/harmony/events.rpy:5531
translate russian harmony_male_ending_5746ed93:
    harmony.say "Но парень и девушка вместе куда-то ходили и что-то делали."

# ch/harmony/events.rpy:5532
translate russian harmony_male_ending_ecd99662:
    harmony.say "Так что же это ещё могло быть?"

# ch/harmony/events.rpy:5533
translate russian harmony_male_ending_46ed17b1:
    harmony.say "Мне было страшно делать столько вещей, которые мне называли греховными."

# ch/harmony/events.rpy:5534
translate russian harmony_male_ending_bb7cbd96:
    harmony.say "Но [lssb_harmony.hero_name()] делал их и при этом был хорошим человеком."

# ch/harmony/events.rpy:5535
translate russian harmony_male_ending_f049fe5f:
    harmony.say "Разве они могли быть плохими?"

# ch/harmony/events.rpy:5536
translate russian harmony_male_ending_342d9c4b:
    harmony.say "И вскоре я поняла: в них нет ничего плохого. Они очень даже приятные!"

# ch/harmony/events.rpy:5537
translate russian harmony_male_ending_37f7f916:
    harmony.say "Постепенно я заметила, что совсем забываю о Боге."

# ch/harmony/events.rpy:5538
translate russian harmony_male_ending_4d57432c:
    harmony.say "Когда мы были вместе, [lssb_harmony.hero_name()] занимал все мои мысли."

# ch/harmony/events.rpy:5539
translate russian harmony_male_ending_d8240fe2:
    harmony.say "Я не перестала ходить в церковь и не отказалась от духовной жизни."

# ch/harmony/events.rpy:5540
translate russian harmony_male_ending_d1fdc8a1:
    harmony.say "Просто нашла ещё кое-что, что тоже полюбила."

# ch/harmony/events.rpy:5541
translate russian harmony_male_ending_c0c11bbc:
    harmony.say "Тогда я начала понимать: всё не так просто, как мне казалось."

# ch/harmony/events.rpy:5542
translate russian harmony_male_ending_d40b1618:
    harmony.say "Порой слова из Библии совсем не помогали разобраться в происходящем."

# ch/harmony/events.rpy:5543
translate russian harmony_male_ending_b4c4c698:
    harmony.say "А иногда даже казались совершенно неправильными!"

# ch/harmony/events.rpy:5544
translate russian harmony_male_ending_68a98892:
    harmony.say "Прежде я бы пережила кризис веры."

# ch/harmony/events.rpy:5545
translate russian harmony_male_ending_a3dd515a:
    harmony.say "Но [lssb_harmony.hero_name()] помог посмотреть на всё иначе."

# ch/harmony/events.rpy:5546
translate russian harmony_male_ending_42ceed0d:
    harmony.say "И да, давайте поговорим о том, о чём все думают!"

# ch/harmony/events.rpy:5547
translate russian harmony_male_ending_9d6f5cde:
    harmony.say "Открыть для себя секс, которого я столько лет себя лишала, было настоящим откровением!"

# ch/harmony/events.rpy:5548
translate russian harmony_male_ending_4a37eafc:
    harmony.say "Пожалуй, уже ради одного этого всё стоило затеять."

# ch/harmony/events.rpy:5550
translate russian harmony_male_ending_ece0f0ab_1:
    harmony.say "И да, в итоге я забеременела."

# ch/harmony/events.rpy:5551
translate russian harmony_male_ending_49072453_1:
    harmony.say "Но мы оба взрослые люди, а не глупые дети."

# ch/harmony/events.rpy:5552
translate russian harmony_male_ending_d25e6026_1:
    harmony.say "И вместе решили создать семью."

# ch/harmony/events.rpy:5553
translate russian harmony_male_ending_fd8fa80b_1:
    harmony.say "Поверьте, [lssb_harmony.hero_name()] далеко не идеальный папа!"

# ch/harmony/events.rpy:5554
translate russian harmony_male_ending_983abaed_1:
    harmony.say "Но он очень старается, и Джейми его за это любит."

# ch/harmony/events.rpy:5556
translate russian harmony_male_ending_f46bb5ea_1:
    harmony.say "И хотя он освободил меня от сексуальных запретов, глупыми детьми мы не были."

# ch/harmony/events.rpy:5557
translate russian harmony_male_ending_9cd59661_1:
    harmony.say "Мы всё равно предохранялись и следили, чтобы обойтись без неожиданностей."

# ch/harmony/events.rpy:5558
translate russian harmony_male_ending_89308db6_1:
    harmony.say "Так что теперь у нас есть все условия, чтобы задуматься о детях."

# ch/harmony/events.rpy:5559
translate russian harmony_male_ending_9c853736:
    harmony.say "[lssb_harmony.hero_name()] добивается всё больших успехов в карьере."

# ch/harmony/events.rpy:5560
translate russian harmony_male_ending_ca88081e:
    harmony.say "А я работаю в центре помощи девушкам, спасающимся от религиозных преследований."

# ch/harmony/events.rpy:5561
translate russian harmony_male_ending_cccdbdd0:
    harmony.say "В детстве я представляла своё будущее иначе."

# ch/harmony/events.rpy:5562
translate russian harmony_male_ending_1b7cd252:
    harmony.say "Но наконец чувствую, что действительно делаю что-то хорошее."

# ch/harmony/events.rpy:5563
translate russian harmony_male_ending_71bd781e:
    harmony.say "Так что да, я рада, что [lssb_harmony.hero_name()] вошёл в церковь в то судьбоносное воскресное утро."

# ch/harmony/events.rpy:5564
translate russian harmony_male_ending_006d2712:
    harmony.say "Но теперь воскресное утро я лучше проведу с ним в постели!"

# ch/harmony/events.rpy:5577
translate russian harmony_kiss_me_b923a582:
    "С Хармони что-то происходит. Я чувствую это, едва увидев её."

# ch/harmony/events.rpy:5578
translate russian harmony_kiss_me_dfb8c587:
    "Она и в лучшие времена не слишком хорошо скрывает чувства."

# ch/harmony/events.rpy:5579
translate russian harmony_kiss_me_af278d1a:
    "А сейчас по лицу ясно видно: её что-то тяготит."

# ch/harmony/events.rpy:5580
translate russian harmony_kiss_me_30d39836:
    "Я не тороплю её, давая время набраться смелости и заговорить."

# ch/harmony/events.rpy:5581
translate russian harmony_kiss_me_af2fd633:
    "Но вместо того чтобы рассказать о своих переживаниях, Хармони наклоняется ко мне."

# ch/harmony/events.rpy:5586
translate russian harmony_kiss_me_73699924:
    "Решив, что ей нужны объятия, я охотно тянусь обнять её."

# ch/harmony/events.rpy:5587
translate russian harmony_kiss_me_43db1955:
    "И очень удивляюсь, когда она наклоняет голову и целует меня прямо в губы."

# ch/harmony/events.rpy:5588
translate russian harmony_kiss_me_9a2607d4:
    "Пару секунд я ошеломлён, но затем инстинкт берёт верх, и я отвечаю."

# ch/harmony/events.rpy:5590
translate russian harmony_kiss_me_9dc2e7e2:
    "Поцелуй заканчивается, и какое-то время мы оба молчим."

# ch/harmony/events.rpy:5593
translate russian harmony_kiss_me_e36d1652:
    harmony.say "Боже мой..."

# ch/harmony/events.rpy:5594
translate russian harmony_kiss_me_113c05da:
    harmony.say "Господи, прости меня... [lssb_harmony.hero_name()], что я наделала?"

# ch/harmony/events.rpy:5595
translate russian harmony_kiss_me_741e7e6a:
    harmony.say "Это ведь грех, да? Я поддалась искушению и даже не пыталась сопротивляться!"

# ch/harmony/events.rpy:5597
translate russian harmony_kiss_me_8d02bdf8:
    "Она прижимает дрожащие пальцы к губам, словно может всё отменить, потрясённая собственной смелостью."

# ch/harmony/events.rpy:5598
translate russian harmony_kiss_me_2ae342ad:
    "Лишь позже я понимаю, чего такой решительный шаг стоил столь набожной девушке, как Хармони..."

# ch/harmony/events.rpy:5601
translate russian harmony_kiss_me_4531d217:
    harmony.say "Я... не верю, что только что это сделала!"

# ch/harmony/events.rpy:5602
translate russian harmony_kiss_me_fa137c26:
    harmony.say "Прости, [lssb_harmony.hero_name()], не знаю, что на меня нашло!"

# ch/harmony/events.rpy:5604
translate russian harmony_kiss_me_0aa36c8c:
    "Но даже смущаясь, она сияет, и пылающие щёки не скрывают, как она счастлива после поцелуя."

# ch/harmony/events.rpy:5605
translate russian harmony_kiss_me_bf6f1536:
    "Лишь позже я понимаю, чего такой решительный шаг стоил столь застенчивой девушке, как Хармони..."

# ch/harmony/events.rpy:5608
translate russian harmony_kiss_me_15b0d921:
    harmony.say "Я всё твержу себе, что хотеть этого неправильно, [lssb_harmony.hero_name()]..."

# ch/harmony/events.rpy:5609
translate russian harmony_kiss_me_d2682535:
    harmony.say "А потом всё равно беру и делаю."

# ch/harmony/events.rpy:5611
translate russian harmony_kiss_me_045ec105:
    "Она разрывается между сомнениями и желанием, словно молится, но её взгляд снова и снова возвращается к моим губам."

# ch/harmony/events.rpy:5614
translate russian harmony_kiss_me_9b253474:
    harmony.say "Прости меня, Господи, но я так давно хотела это сделать, [lssb_harmony.hero_name()]..."

# ch/harmony/events.rpy:5615
translate russian harmony_kiss_me_31b22266:
    harmony.say "Одного поцелуя будет мало. Я уже знаю."

# ch/harmony/events.rpy:5617
translate russian harmony_kiss_me_0ea46c49:
    "В её глазах всё ещё есть вина, но есть и жажда, которую больше не скрыть."

# ch/harmony/events.rpy:5621
translate russian harmony_kiss_me_03532a8e:
    harmony.say "М-м-м... не останавливайся, [lssb_harmony.hero_name()]."

# ch/harmony/events.rpy:5622
translate russian harmony_kiss_me_6d5a7fc7:
    harmony.say "Целуй меня как хочешь. Пользуйся моим ртом. Я твоя, делай со мной что угодно."

# ch/harmony/events.rpy:5624
translate russian harmony_kiss_me_c5295e88:
    "Она тает в моих объятиях и отдаётся мне: вся прежняя набожность теперь обращена в поклонение мне."

# ch/harmony/events.rpy:5627
translate russian harmony_kiss_me_d7dbbf09:
    harmony.say "Наконец-то!"

# ch/harmony/events.rpy:5628
translate russian harmony_kiss_me_e1d0d6c4:
    harmony.say "Мне так хотелось показать, как сильно я тебя хочу, [lssb_harmony.hero_name()]."

# ch/harmony/events.rpy:5630
translate russian harmony_kiss_me_251da9b1:
    "Она отвечает бесстыдным поцелуем: язык, зубы, жадные тихие звуки — ни капли смущения."

# ch/harmony/events.rpy:5637
translate russian harmony_stripclub_event_01_9565b9dd:
    "Хармони не умеет скрывать, что у неё что-то на уме."

# ch/harmony/events.rpy:5638
translate russian harmony_stripclub_event_01_eb94fff8:
    "Она может молчать об этом и не сказать рядом с тобой ни слова."

# ch/harmony/events.rpy:5639
translate russian harmony_stripclub_event_01_c58d12e7:
    "Но обязательно выдаст себя: начнёт напевать или накручивать волосы на палец."

# ch/harmony/events.rpy:5640
translate russian harmony_stripclub_event_01_5d17798b:
    "Сейчас она делает и то и другое, заодно полностью игнорируя меня!"

# ch/harmony/events.rpy:5641
translate russian harmony_stripclub_event_01_ffa9b7d6:
    mike.say "Хармони!"

# ch/harmony/events.rpy:5642
translate russian harmony_stripclub_event_01_d0ea27f1:
    mike.say "Ты меня вообще слышишь?"

# ch/harmony/events.rpy:5643
translate russian harmony_stripclub_event_01_12199df4:
    mike.say "Хоть одно слово услышала?!"

# ch/harmony/events.rpy:5645
translate russian harmony_stripclub_event_01_1bf085fd:
    "От моего повышенного и довольно раздражённого голоса Хармони приходит в себя."

# ch/harmony/events.rpy:5646
translate russian harmony_stripclub_event_01_596795e6:
    "Она слегка вздрагивает и наконец замечает моё присутствие."

# ch/harmony/events.rpy:5648
translate russian harmony_stripclub_event_01_fc362cfa:
    harmony.say "Ой!"

# ch/harmony/events.rpy:5649
translate russian harmony_stripclub_event_01_ad082459:
    harmony.say "Что?"

# ch/harmony/events.rpy:5650
translate russian harmony_stripclub_event_01_047356c3:
    harmony.say "Ты о чём?"

# ch/harmony/events.rpy:5651
translate russian harmony_stripclub_event_01_223443a6:
    harmony.say "Конечно, я слушаю!"

# ch/harmony/events.rpy:5653
translate russian harmony_stripclub_event_01_67dd0015:
    "Я мог бы потребовать повторить последнюю мою фразу."

# ch/harmony/events.rpy:5654
translate russian harmony_stripclub_event_01_c992cd16:
    "Но раздражение уже проходит."

# ch/harmony/events.rpy:5655
translate russian harmony_stripclub_event_01_a723c70d:
    "Так что я просто качаю головой и решаю проявить великодушие."

# ch/harmony/events.rpy:5656
translate russian harmony_stripclub_event_01_90f583a8:
    mike.say "Ты какая-то рассеянная, Хармони."

# ch/harmony/events.rpy:5657
translate russian harmony_stripclub_event_01_34171dee:
    mike.say "Тебя что-то беспокоит?"

# ch/harmony/events.rpy:5658
translate russian harmony_stripclub_event_01_eafdc06f:
    "Хармони мнёт руки и смотрит в землю."

# ch/harmony/events.rpy:5659
translate russian harmony_stripclub_event_01_bdec0806:
    "Потом поднимает на меня серьёзный взгляд."

# ch/harmony/events.rpy:5661
translate russian harmony_stripclub_event_01_d6b7fce2:
    harmony.say "Ну да..."

# ch/harmony/events.rpy:5662
translate russian harmony_stripclub_event_01_a7daac23:
    harmony.say "Я хотела кое о чём тебя спросить."

# ch/harmony/events.rpy:5663
translate russian harmony_stripclub_event_01_4e6b3d1c:
    harmony.say "Мне нужен совет насчёт работы."

# ch/harmony/events.rpy:5665
translate russian harmony_stripclub_event_01_1442cbdd:
    "Я едва сдерживаюсь, чтобы не рассмеяться."

# ch/harmony/events.rpy:5666
translate russian harmony_stripclub_event_01_d135ec1a:
    "С тех пор как Хармони оставила благочестивую жизнь, она почти не знает удержу."

# ch/harmony/events.rpy:5667
translate russian harmony_stripclub_event_01_6ca015e5:
    "Будто всеми силами наверстывает пропущенные вечеринки."

# ch/harmony/events.rpy:5668
translate russian harmony_stripclub_event_01_63fd98ae:
    "Так что трудно поверить, что она хочет уделить время карьере."

# ch/harmony/events.rpy:5669
translate russian harmony_stripclub_event_01_30e74fc5:
    mike.say "Эм..."

# ch/harmony/events.rpy:5670
translate russian harmony_stripclub_event_01_ebfcc32e:
    mike.say "Ладно, Хармони..."

# ch/harmony/events.rpy:5671
translate russian harmony_stripclub_event_01_cfe2d44d:
    mike.say "Какой именно совет тебе нужен?"

# ch/harmony/events.rpy:5673
translate russian harmony_stripclub_event_01_d9d7b3e6:
    "Она начинает объяснять с серьёзным лицом."

# ch/harmony/events.rpy:5675
translate russian harmony_stripclub_event_01_d3e9d82c:
    harmony.say "Хорошо, выслушай меня..."

# ch/harmony/events.rpy:5676
translate russian harmony_stripclub_event_01_718c6776:
    harmony.say "Ты ведь считаешь меня красивой?"

# ch/harmony/events.rpy:5677
translate russian harmony_stripclub_event_01_b144fa8a:
    harmony.say "Считаешь, что у меня сексуальное тело?"

# ch/harmony/events.rpy:5679
translate russian harmony_stripclub_event_01_59ece941:
    "Я тут же начинаю кивать."

# ch/harmony/events.rpy:5680
translate russian harmony_stripclub_event_01_76acbcc1:
    "А как иначе?"

# ch/harmony/events.rpy:5681
translate russian harmony_stripclub_event_01_bc1938ac:
    "Хармони — одна из самых красивых девушек, которых я встречал."

# ch/harmony/events.rpy:5682
translate russian harmony_stripclub_event_01_dc3e5e30:
    "И всё её тело — сплошные идеальные изгибы."

# ch/harmony/events.rpy:5683
translate russian harmony_stripclub_event_01_021fca95:
    "В ней прекрасно всё!"

# ch/harmony/events.rpy:5684
translate russian harmony_stripclub_event_01_a876881d:
    mike.say "Конечно, Хармони!"

# ch/harmony/events.rpy:5685
translate russian harmony_stripclub_event_01_d32ab5f1:
    mike.say "Ты богиня!"

# ch/harmony/events.rpy:5687
translate russian harmony_stripclub_event_01_a9edcff3:
    "От комплимента она слегка краснеет."

# ch/harmony/events.rpy:5688
translate russian harmony_stripclub_event_01_db8aec93:
    "А в глазах появляется знакомый чувственный огонёк!"

# ch/harmony/events.rpy:5689
translate russian harmony_stripclub_event_01_be9c2345:
    harmony.say "Ох!"

# ch/harmony/events.rpy:5691
translate russian harmony_stripclub_event_01_96124173:
    harmony.say "Спасибо, [lssb_harmony.hero_name()]!"

# ch/harmony/events.rpy:5692
translate russian harmony_stripclub_event_01_99164aa9:
    harmony.say "Значит, считаешь, мне стоит попробовать стать стриптизёршей?"

# ch/harmony/events.rpy:5694
translate russian harmony_stripclub_event_01_02d4aab0:
    "От одного слова «стриптизёрша» у меня глаза чуть не вылезают из орбит."

# ch/harmony/events.rpy:5695
translate russian harmony_stripclub_event_01_df05e477:
    "Это ещё откуда взялось?"

# ch/harmony/events.rpy:5696
translate russian harmony_stripclub_event_01_d2bef1a5:
    mike.say "В смысле стриптизёршей?"

# ch/harmony/events.rpy:5697
translate russian harmony_stripclub_event_01_564056e9:
    mike.say "С каких пор ты хочешь стать стриптизёршей?!"

# ch/harmony/events.rpy:5698
translate russian harmony_stripclub_event_01_18008151:
    mike.say "Мне никто не говорил, что ты собираешься стать стриптизёршей!"

# ch/harmony/events.rpy:5700
translate russian harmony_stripclub_event_01_4524c21b:
    "Моя реакция немало удивляет Хармони."

# ch/harmony/events.rpy:5702
translate russian harmony_stripclub_event_01_54fb5992:
    harmony.say "А?"

# ch/harmony/events.rpy:5704
translate russian harmony_stripclub_event_01_51894707:
    harmony.say "Ты же постоянно говоришь, что я отлично выгляжу, [lssb_harmony.hero_name()]."

# ch/harmony/events.rpy:5705
translate russian harmony_stripclub_event_01_d03e531f:
    harmony.say "И любуешься мной голой при каждом удобном случае!"

# ch/harmony/events.rpy:5706
translate russian harmony_stripclub_event_01_636cc195:
    harmony.say "Ревнуешь к мысли, что голой меня увидят другие мужчины?!"

# ch/harmony/events.rpy:5710
translate russian harmony_stripclub_event_01_65150184:
    "Едва она заканчивает, я качаю головой."

# ch/harmony/events.rpy:5711
translate russian harmony_stripclub_event_01_db5dd15f:
    "Я ведь знаю, что способен спокойно отнестись к чужим взглядам на её обнажённое тело."

# ch/harmony/events.rpy:5712
translate russian harmony_stripclub_event_01_9a44ccbb:
    "Особенно если сам смогу любоваться её танцем на сцене!"

# ch/harmony/events.rpy:5713
translate russian harmony_stripclub_event_01_6fbb324e:
    mike.say "Конечно нет, Хармони!"

# ch/harmony/events.rpy:5714
translate russian harmony_stripclub_event_01_1ead8e0d:
    mike.say "Я вполне современный парень."

# ch/harmony/events.rpy:5715
translate russian harmony_stripclub_event_01_8fa38f84:
    mike.say "И ничего не имею против стриптиза как профессии."

# ch/harmony/events.rpy:5716
translate russian harmony_stripclub_event_01_2a3c4d06:
    mike.say "Более того, с радостью тебя поддержу."

# ch/harmony/events.rpy:5717
translate russian harmony_stripclub_event_01_980c9ace:
    "Поначалу Хармони просто удивлена."

# ch/harmony/events.rpy:5718
translate russian harmony_stripclub_event_01_fc759fed:
    "Будто не знает, как реагировать."

# ch/harmony/events.rpy:5719
translate russian harmony_stripclub_event_01_a68175b7:
    "Наверное, она готовилась к отказу."

# ch/harmony/events.rpy:5721
translate russian harmony_stripclub_event_01_2165e7ad:
    "Но затем снова улыбается."

# ch/harmony/events.rpy:5723
translate russian harmony_stripclub_event_01_84323b26:
    harmony.say "Ты серьёзно, [lssb_harmony.hero_name()]?"

# ch/harmony/events.rpy:5724
translate russian harmony_stripclub_event_01_dde5c66c:
    harmony.say "Тебя устраивает встречаться со стриптизёршей?"

# ch/harmony/events.rpy:5726
translate russian harmony_stripclub_event_01_a988b028:
    mike.say "Хармони, ещё как устраивает."

# ch/harmony/events.rpy:5727
translate russian harmony_stripclub_event_01_164bf45e:
    mike.say "По-моему, это очень возбуждающая идея!"

# ch/harmony/events.rpy:5728
translate russian harmony_stripclub_event_01_24e0da38:
    "Теперь она начинает прикусывать губу и краснеть."

# ch/harmony/events.rpy:5729
translate russian harmony_stripclub_event_01_8ac7a93a:
    "Именно так она делает, когда возбуждается."

# ch/harmony/events.rpy:5731
translate russian harmony_stripclub_event_01_c29c4baf:
    harmony.say "О, [lssb_harmony.hero_name()]!"

# ch/harmony/events.rpy:5732
translate russian harmony_stripclub_event_01_782b99ea:
    harmony.say "Какой же ты замечательный!"

# ch/harmony/events.rpy:5734
translate russian harmony_stripclub_event_01_7bfdb220:
    harmony.say "Может, хочешь первым увидеть мой номер?"

# ch/harmony/events.rpy:5738
translate russian harmony_stripclub_event_01_65150184_1:
    "Едва она заканчивает, я качаю головой."

# ch/harmony/events.rpy:5739
translate russian harmony_stripclub_event_01_03e06f48:
    "Конечно, она совершенно права."

# ch/harmony/events.rpy:5740
translate russian harmony_stripclub_event_01_073509e6:
    "Меньше всего мне хочется, чтобы другие мужчины пялились на её голое тело."

# ch/harmony/events.rpy:5741
translate russian harmony_stripclub_event_01_4a76196b:
    "Но признаваться в этом необязательно."

# ch/harmony/events.rpy:5742
translate russian harmony_stripclub_event_01_6fbb324e_1:
    mike.say "Конечно нет, Хармони!"

# ch/harmony/events.rpy:5743
translate russian harmony_stripclub_event_01_1ead8e0d_1:
    mike.say "Я вполне современный парень."

# ch/harmony/events.rpy:5744
translate russian harmony_stripclub_event_01_8fa38f84_1:
    mike.say "И ничего не имею против стриптиза как профессии."

# ch/harmony/events.rpy:5745
translate russian harmony_stripclub_event_01_8766422c:
    mike.say "Просто думаю, что тебе стоит метить выше."

# ch/harmony/events.rpy:5747
translate russian harmony_stripclub_event_01_0a44f3bf:
    "Хармони хмурится, явно не поверив."

# ch/harmony/events.rpy:5748
translate russian harmony_stripclub_event_01_8d6c59da:
    harmony.say "Хмф..."

# ch/harmony/events.rpy:5750
translate russian harmony_stripclub_event_01_164837a9:
    harmony.say "Куда уж выше?"

# ch/harmony/events.rpy:5751
translate russian harmony_stripclub_event_01_a47555bb:
    harmony.say "Особенно если я всё равно хочу раздеваться!"

# ch/harmony/events.rpy:5753
translate russian harmony_stripclub_event_01_2a88329c:
    "Я вымученно улыбаюсь и лихорадочно соображаю."

# ch/harmony/events.rpy:5754
translate russian harmony_stripclub_event_01_a31db5ac:
    "И тут в голову приходит идея."

# ch/harmony/events.rpy:5755
translate russian harmony_stripclub_event_01_14114795:
    "Не знаю, удачная она или нет."

# ch/harmony/events.rpy:5756
translate russian harmony_stripclub_event_01_1eab6d53:
    "Но времени проверять нет."

# ch/harmony/events.rpy:5757
translate russian harmony_stripclub_event_01_b988bbcc:
    mike.say "Ты могла бы..."

# ch/harmony/events.rpy:5758
translate russian harmony_stripclub_event_01_8d5c41f9:
    mike.say "Стать натурщицей?"

# ch/harmony/events.rpy:5759
translate russian harmony_stripclub_event_01_875f0874:
    mike.say "Да, точно! Натурщицей!"

# ch/harmony/events.rpy:5760
translate russian harmony_stripclub_event_01_259528e2:
    mike.say "Они раздеваются догола, когда позируют художникам!"

# ch/harmony/events.rpy:5762
translate russian harmony_stripclub_event_01_e9de121f:
    harmony.say "Серьёзно, [lssb_harmony.hero_name()]?"

# ch/harmony/events.rpy:5764
translate russian harmony_stripclub_event_01_e6f43411:
    harmony.say "Звучит не так весело, как стриптиз!"

# ch/harmony/events.rpy:5766
translate russian harmony_stripclub_event_01_e3af6a98:
    mike.say "Может, и не так прибыльно, Хармони."

# ch/harmony/events.rpy:5767
translate russian harmony_stripclub_event_01_fcd723df:
    mike.say "Зато в этом куда больше художественной ценности."

# ch/harmony/events.rpy:5769
translate russian harmony_stripclub_event_01_607ee7fa:
    harmony.say "Ты уверен?"

# ch/harmony/events.rpy:5771
translate russian harmony_stripclub_event_01_f5ba61c7:
    "Я вздыхаю с облегчением, когда мы начинаем это обсуждать."

# ch/harmony/events.rpy:5772
translate russian harmony_stripclub_event_01_2f6cd536:
    "Конечно, натурщицей я её тоже, возможно, видеть не хочу."

# ch/harmony/events.rpy:5773
translate russian harmony_stripclub_event_01_9e668566:
    "Но суть не в этом."

# ch/harmony/events.rpy:5774
translate russian harmony_stripclub_event_01_89ec15ef:
    "Главное — отвлечь её от мысли о стриптизе."

# ch/harmony/events.rpy:5775
translate russian harmony_stripclub_event_01_60de2129:
    "По крайней мере, я выиграл немного времени."

# ch/harmony/events.rpy:5776
translate russian harmony_stripclub_event_01_b82c05d9:
    "Теперь осталось придумать план получше."

# ch/harmony/events.rpy:5782
translate russian harmony_stripclub_event_02_eab7fa55:
    "Подходя к стриптиз-клубу и входя внутрь, я не могу сдержать самодовольства."

# ch/harmony/events.rpy:5783
translate russian harmony_stripclub_event_02_1e6f3333:
    "Большинство парней тайком пробираются сюда и надеются, что девушки не узнают."

# ch/harmony/events.rpy:5784
translate russian harmony_stripclub_event_02_c0ed550d:
    "А я спокойно иду проверить, последовала ли моя девушка совету и устроилась ли здесь на работу."

# ch/harmony/events.rpy:5785
translate russian harmony_stripclub_event_02_43a4b13a:
    "Если да, я, очевидно, пришёл её поддержать."

# ch/harmony/events.rpy:5786
translate russian harmony_stripclub_event_02_b4160ec4:
    "А если нет, скажу, что заходил лишь узнать, не устроилась ли она."

# ch/harmony/events.rpy:5787
translate russian harmony_stripclub_event_02_f34a7f01:
    "В любом случае можно устроиться поудобнее и смотреть на горячие танцы."

# ch/harmony/events.rpy:5788
translate russian harmony_stripclub_event_02_a4537903:
    "Иногда быть мной очень приятно!"

# ch/harmony/events.rpy:5789
translate russian harmony_stripclub_event_02_7d128c0d:
    "Взяв выпить в баре, я сажусь как можно ближе к пилону."

# ch/harmony/events.rpy:5790
translate russian harmony_stripclub_event_02_5a43d4da:
    "И устраиваюсь ждать появления Хармони."

# ch/harmony/events.rpy:5791
translate russian harmony_stripclub_event_02_0bc37523:
    "Но ничто не мешает полюбоваться теми, кто выступает до неё."

# ch/harmony/events.rpy:5792
translate russian harmony_stripclub_event_02_3415aed6:
    "Разумеется, исключительно с художественной точки зрения!"

# ch/harmony/events.rpy:5793
translate russian harmony_stripclub_event_02_a4b870c6:
    "Поначалу я чувствую себя королём мира."

# ch/harmony/events.rpy:5796
translate russian harmony_stripclub_event_02_552da0b0:
    "Девушки одна за другой выходят на сцену."

# ch/harmony/events.rpy:5800
translate russian harmony_stripclub_event_02_7f57b19d:
    "А я смотрю, как они обвиваются вокруг пилона передо мной."

# ch/harmony/events.rpy:5802
translate russian harmony_stripclub_event_02_fef90baa:
    "Но Хармони среди них нет, и я начинаю раздражаться."

# ch/harmony/events.rpy:5803
translate russian harmony_stripclub_event_02_4a6f9741:
    "Напитки здесь дорогие и стремительно опустошают мой кошелёк."

# ch/harmony/events.rpy:5804
translate russian harmony_stripclub_event_02_bcb506b2:
    "Боюсь, когда Хармони наконец выйдет, я уже выдохнусь!"

# ch/harmony/events.rpy:5805
translate russian harmony_stripclub_event_02_72d6b6a6:
    "Отпив из, кажется, сотого бокала, я устало вздыхаю."

# ch/harmony/events.rpy:5806
translate russian harmony_stripclub_event_02_aec6edae:
    "И тут слышу рядом чей-то смешок."

# ch/harmony/events.rpy:5807
translate russian harmony_stripclub_event_02_09a60676:
    "Настолько знакомый, что я сразу понимаю, кому он принадлежит!"

# ch/harmony/events.rpy:5808
translate russian harmony_stripclub_event_02_e7ca6d2c:
    "Поднимаю голову и вижу улыбающуюся мне сверху Хармони."

# ch/harmony/events.rpy:5810
translate russian harmony_stripclub_event_02_0072c1d1:
    harmony.say "Привет, [lssb_harmony.hero_name()]!"

# ch/harmony/events.rpy:5811
translate russian harmony_stripclub_event_02_5678fe82:
    harmony.say "Ты пришёл посмотреть мой танец!"

# ch/harmony/events.rpy:5812
translate russian harmony_stripclub_event_02_e613921e:
    harmony.say "Как мило с твоей стороны!"

# ch/harmony/events.rpy:5814
translate russian harmony_stripclub_event_02_eeb05891:
    mike.say "Х... Хармони..."

# ch/harmony/events.rpy:5815
translate russian harmony_stripclub_event_02_ba7f7e02:
    mike.say "Ух ты..."

# ch/harmony/events.rpy:5816
translate russian harmony_stripclub_event_02_8b7b11c3:
    mike.say "Это правда ты?!"

# ch/harmony/events.rpy:5817
translate russian harmony_stripclub_event_02_d10d60be:
    "Хармони возвышается надо мной, демонстрируя свою великолепную фигуру."

# ch/harmony/events.rpy:5818
translate russian harmony_stripclub_event_02_8b3d31df:
    "На ней крошечная юбка и бюстгальтер, покрытый блестящими розовыми пайетками."

# ch/harmony/events.rpy:5819
translate russian harmony_stripclub_event_02_59dac150:
    "Над поясом юбки виднеются тесёмки стрингов."

# ch/harmony/events.rpy:5820
translate russian harmony_stripclub_event_02_b90500dc:
    "А ниже — стройные ноги в чулках в сеточку."

# ch/harmony/events.rpy:5821
translate russian harmony_stripclub_event_02_4fd60d1a:
    "Наряд завершают умопомрачительные каблуки, с которыми Хармони кажется ещё выше."

# ch/harmony/events.rpy:5823
translate russian harmony_stripclub_event_02_66959697:
    harmony.say "О да, [lssb_harmony.hero_name()]."

# ch/harmony/events.rpy:5824
translate russian harmony_stripclub_event_02_419c2030:
    harmony.say "Ты не спишь."

# ch/harmony/events.rpy:5825
translate russian harmony_stripclub_event_02_dbd68025:
    harmony.say "Это действительно я."

# ch/harmony/events.rpy:5826
translate russian harmony_stripclub_event_02_77fd3fc3:
    harmony.say "Но я — твоя сбывшаяся мечта!"

# ch/harmony/events.rpy:5828
translate russian harmony_stripclub_event_02_ead13d7b:
    "Хармони кружится на месте и хватается за пилон."

# ch/harmony/events.rpy:5832
translate russian harmony_stripclub_event_02_66a6c113:
    "Даже на таких каблуках она движется удивительно быстро и грациозно."

# ch/harmony/events.rpy:5833
translate russian harmony_stripclub_event_02_a07dc72c:
    "Через мгновение она уже поднимается на пилоне, отрываясь от пола."

# ch/harmony/events.rpy:5834
