# ch/harmony/reactions.rpy:636
translate russian harmony_belly_caress_male_44a0e94f:
    harmony.say "Сразу хочется забеременеть ещё раз!"

# ch/harmony/reactions.rpy:638
translate russian harmony_belly_caress_male_079bc47e:
    harmony.say "Я вижу, что ты делаешь, [lssb_harmony.hero_name()]…"

# ch/harmony/reactions.rpy:639
translate russian harmony_belly_caress_male_5e299786:
    harmony.say "Опять на меня пялишься!"

# ch/harmony/reactions.rpy:641
translate russian harmony_belly_caress_male_0e68d171:
    "Под взглядом Хармони я начинаю потеть."

# ch/harmony/reactions.rpy:642
translate russian harmony_belly_caress_male_2e79c8ed:
    "Конечно, она ведь меня не ругает..."

# ch/harmony/reactions.rpy:643
translate russian harmony_belly_caress_male_ca86bc67:
    "Но мне всё равно отчаянно хочется быть ближе к ней."

# ch/harmony/reactions.rpy:644
translate russian harmony_belly_caress_male_af051712:
    "Прикоснуться к этому невероятному телу."

# ch/harmony/reactions.rpy:646
translate russian harmony_belly_caress_male_8b7ee15e:
    "Я придвигаюсь, стараясь выглядеть как можно невиннее."

# ch/harmony/reactions.rpy:647
translate russian harmony_belly_caress_male_94da01e0:
    "Не отводя глаз, протягиваю руку."

# ch/harmony/reactions.rpy:649
translate russian harmony_belly_caress_male_4f26ff61:
    "Задерживаю дыхание, когда кладу ладонь на округлившийся живот Хармони."

# ch/harmony/reactions.rpy:650
translate russian harmony_belly_caress_male_18133720:
    "На мгновение мне кажется, что она оттолкнёт её."

# ch/harmony/reactions.rpy:651
translate russian harmony_belly_caress_male_e86608ea:
    "Скажет держать руки при себе."

# ch/harmony/reactions.rpy:653
translate russian harmony_belly_caress_male_8432c67f:
    "Но вместо этого прикосновение, кажется, быстро смягчает Хармони."

# ch/harmony/reactions.rpy:654
translate russian harmony_belly_caress_male_140cf0c9:
    "Она кладёт свою ладонь поверх моей."

# ch/harmony/reactions.rpy:655
translate russian harmony_belly_caress_male_c0e5d22a:
    "Потом склоняет голову мне на плечо и тихонько вздыхает."

# ch/harmony/reactions.rpy:656
translate russian harmony_belly_caress_male_ce472a0d:
    "Я собираюсь спросить, всё ли хорошо и не нужно ли ей чего-нибудь."

# ch/harmony/reactions.rpy:657
translate russian harmony_belly_caress_male_8176dcbd:
    "Но понимаю: это один из тех моментов, когда лучше помолчать."

# ch/harmony/reactions.rpy:658
translate russian harmony_belly_caress_male_c345af65:
    "Маленький островок спокойствия в бушующем море жизни."

# ch/harmony/reactions.rpy:659
translate russian harmony_belly_caress_male_edd9d803:
    "Поэтому просто устраиваюсь поудобнее и стараюсь им насладиться."

# ch/harmony/reactions.rpy:666
translate russian harmony_belly_listen_male_31e0f652:
    "Я наклоняюсь к округлому животу Хармони и прижимаюсь к нему ухом."

# ch/harmony/reactions.rpy:668
translate russian harmony_belly_listen_male_263f7f26:
    "И тут же почти физически чувствую на себе её взгляд."

# ch/harmony/reactions.rpy:669
translate russian harmony_belly_listen_male_12f89511:
    "Что вполне понятно, ведь я внимательно прислушиваюсь к части её тела."

# ch/harmony/reactions.rpy:670
translate russian harmony_belly_listen_male_c36f5352:
    "Но всё равно не могу удержаться от тихого смешка."

# ch/harmony/reactions.rpy:671
translate russian harmony_belly_listen_male_622f489c:
    "Представляю её лицо, пока она пытается разглядеть, что я там делаю."

# ch/harmony/reactions.rpy:673
translate russian harmony_belly_listen_male_b756427f:
    harmony.say "Эм, [lssb_harmony.hero_name()]…"

# ch/harmony/reactions.rpy:674
translate russian harmony_belly_listen_male_b4615829:
    harmony.say "Что ты..."

# ch/harmony/reactions.rpy:675
translate russian harmony_belly_listen_male_2a0f8490:
    harmony.say "Что ты там делаешь?"

# ch/harmony/reactions.rpy:677
translate russian harmony_belly_listen_male_3f76baf2:
    "Я взмахиваю рукой, пытаясь попросить Хармони помолчать."

# ch/harmony/reactions.rpy:678
translate russian harmony_belly_listen_male_0cfc977f:
    "И так трудно что-либо расслышать в её животе."

# ch/harmony/reactions.rpy:679
translate russian harmony_belly_listen_male_4cca8920:
    mike.say "Тс-с!"

# ch/harmony/reactions.rpy:680
translate russian harmony_belly_listen_male_48549e14:
    mike.say "Пытаюсь услышать, как там шевелится малыш, Хармони..."

# ch/harmony/reactions.rpy:681
translate russian harmony_belly_listen_male_f5c936ad:
    mike.say "А пока слышу только твои вопросы!"

# ch/harmony/reactions.rpy:683
translate russian harmony_belly_listen_male_ff7d5eb9:
    "После моего замечания Хармони слегка шевелится."

# ch/harmony/reactions.rpy:684
translate russian harmony_belly_listen_male_20ab78b0:
    "Наверное, её задел мой тон."

# ch/harmony/reactions.rpy:686
translate russian harmony_belly_listen_male_c044bc47:
    "Но она быстро оправляется и снова начинает спрашивать."

# ch/harmony/reactions.rpy:687
translate russian harmony_belly_listen_male_64ec73e8:
    "Только теперь шёпотом."

# ch/harmony/reactions.rpy:689
translate russian harmony_belly_listen_male_38a90c76:
    harmony.say "Ты..."

# ch/harmony/reactions.rpy:690
translate russian harmony_belly_listen_male_7f76a668:
    harmony.say "Ты уже что-нибудь слышишь?"

# ch/harmony/reactions.rpy:692
translate russian harmony_belly_listen_male_3335ed69:
    "Я собираюсь ответить «нет» и снова попросить помолчать."

# ch/harmony/reactions.rpy:693
translate russian harmony_belly_listen_male_3de0d042:
    "Но тут чувствую движение возле уха."

# ch/harmony/reactions.rpy:694
translate russian harmony_belly_listen_male_1453d7ba:
    "За ним следует череда странных звуков."

# ch/harmony/reactions.rpy:695
translate russian harmony_belly_listen_male_3f8382ca:
    mike.say "Ого..."

# ch/harmony/reactions.rpy:696
translate russian harmony_belly_listen_male_68402caf:
    mike.say "Вот!"

# ch/harmony/reactions.rpy:697
translate russian harmony_belly_listen_male_39a3efc9:
    mike.say "Шевелится, Хармони!"

# ch/harmony/reactions.rpy:698
translate russian harmony_belly_listen_male_eb9413ec:
    "Я продолжаю прижиматься ухом к её животу, пытаясь следовать за звуками."

# ch/harmony/reactions.rpy:699
translate russian harmony_belly_listen_male_deee2bf6:
    "Понятия не имею, удаётся ли мне поспевать за движениями малыша."

# ch/harmony/reactions.rpy:700
translate russian harmony_belly_listen_male_ef4815d3:
    "Но это не так важно: само переживание уже того стоит."

# ch/harmony/reactions.rpy:702
translate russian harmony_belly_listen_male_62716603:
    "Я перемещаю ухо по животу Хармони и стараюсь рассказывать ей, что слышу."

# ch/harmony/reactions.rpy:703
translate russian harmony_belly_listen_male_ada0fcc7:
    "Не знаю, полезны ли мои описания и есть ли в них вообще смысл."

# ch/harmony/reactions.rpy:704
translate russian harmony_belly_listen_male_5ae3b4ab:
    "Но она внимательно слушает и задаёт вопросы, на которые мне непросто ответить."

# ch/harmony/reactions.rpy:705
translate russian harmony_belly_listen_male_b05cb27f:
    "Когда всё заканчивается, кажется, будто мы вместе совершили маленькое странное путешествие."

# ch/harmony/reactions.rpy:706
translate russian harmony_belly_listen_male_1277bd69:
    "Не первое и, уверен, не последнее."

# ch/harmony/reactions.rpy:709
translate russian harmony_belly_listen_male_a3b014cd:
    harmony.say "Маленькая жизнь, [lssb_harmony.hero_name()]. Бог соткал её во мне, а ты помог."

# ch/harmony/reactions.rpy:710
translate russian harmony_belly_listen_male_147dc0fe:
    harmony.say "Никогда не думала, что можно быть такой счастливой и так бояться одновременно."

# ch/harmony/reactions.rpy:713
translate russian harmony_belly_listen_male_e2b6212b:
    harmony.say "Ты наполнил меня, и вот что выросло. Думаю, для этого я и создана, [lssb_harmony.hero_name()]."

# ch/harmony/reactions.rpy:714
translate russian harmony_belly_listen_male_47d1d657:
    harmony.say "Твоя хорошая девочка, округлившаяся от твоего ребёнка. Теперь это единственное Писание, которое мне нужно."

# ch/harmony/reactions.rpy:717
translate russian harmony_belly_listen_male_803242f0:
    harmony.say "Все называли грехом то, как мы зачали этого малыша. Пусть."

# ch/harmony/reactions.rpy:718
translate russian harmony_belly_listen_male_1e1df318:
    harmony.say "Это было райское наслаждение. И посмотри, что подарили нам небеса."

# ch/harmony/talk.rpy:9
translate russian harmony_talk_love_male_356c09fc:
    mike.say "Скажи честно, Хармони: что ты думаешь о любви?"

# ch/harmony/talk.rpy:12
translate russian harmony_talk_love_male_b08872f9:
    harmony.say "Ох, [lssb_harmony.hero_name()], конечно же я верю в любовь!"

# ch/harmony/talk.rpy:14
translate russian harmony_talk_love_male_664e3aac:
    harmony.say "Бог любит всех Своих детей, и мы тоже должны любить друг друга!"

# ch/harmony/talk.rpy:17
translate russian harmony_talk_love_male_210cb396:
    harmony.say "Я верю в настоящую любовь, правда."

# ch/harmony/talk.rpy:19
translate russian harmony_talk_love_male_07ab5be3:
    harmony.say "Это самое прекрасное, что я могу представить между двумя людьми!"

# ch/harmony/talk.rpy:22
translate russian harmony_talk_love_male_82efbed8:
    harmony.say "Забудь всю эту слезливую, сентиментальную чушь."

# ch/harmony/talk.rpy:24
translate russian harmony_talk_love_male_d47480ac:
    harmony.say "Я ни за что не полюблю кого-то без огромного члена!"

# ch/harmony/talk.rpy:27
translate russian harmony_talk_love_male_4cf3f3c9:
    harmony.say "Ну... Ведь есть два вида любви?"

# ch/harmony/talk.rpy:28
translate russian harmony_talk_love_male_ee126190:
    harmony.say "Любовь из стихов и валентинок, а ещё ДРУГАЯ любовь!"

# ch/harmony/talk.rpy:29
translate russian harmony_talk_love_male_8a14ce55:
    harmony.say "И не вижу причин, почему нельзя иметь и то и другое!"

# ch/harmony/talk.rpy:32
translate russian harmony_talk_love_male_73ab688f:
    harmony.say "Всё непросто, но я верю, что любовь существует."

# ch/harmony/talk.rpy:33
translate russian harmony_talk_love_male_a885f218:
    harmony.say "Просто ради неё нужно трудиться, как ради всего стоящего в жизни."

# ch/harmony/talk.rpy:37
translate russian harmony_talk_sex_male_85e94449:
    mike.say "В вопросах секса ты современная девушка или скорее придерживаешься традиций?"

# ch/harmony/talk.rpy:40
translate russian harmony_talk_sex_male_0838d371:
    harmony.say "Искушение привело к первородному греху!"

# ch/harmony/talk.rpy:41
translate russian harmony_talk_sex_male_bb6ddd88:
    harmony.say "Нельзя поддаваться искушению."

# ch/harmony/talk.rpy:45
translate russian harmony_talk_sex_male_59d2cdef:
    harmony.say "Вряд ли тебе подобает задавать мне такие вопросы!"

# ch/harmony/talk.rpy:46
translate russian harmony_talk_sex_male_74c1936a:
    harmony.say "Особенно когда мы не женаты и даже не помолвлены."

# ch/harmony/talk.rpy:51
translate russian harmony_talk_sex_male_4ab2e82d:
    harmony.say "Традиций? Ох, [lssb_harmony.hero_name()], теперь я принадлежу тебе душой и телом."

# ch/harmony/talk.rpy:52
translate russian harmony_talk_sex_male_5aa717d7:
    harmony.say "У меня осталась одна традиция: поклоняться твоему члену, словно это вся моя религия."

# ch/harmony/talk.rpy:53
translate russian harmony_talk_sex_male_748a6260:
    harmony.say "Скажешь встать на колени — встану. Вот и всё моё вероучение."

# ch/harmony/talk.rpy:56
translate russian harmony_talk_sex_male_febd8384:
    harmony.say "Не верится, какой я раньше была недотрогой!"

# ch/harmony/talk.rpy:58
translate russian harmony_talk_sex_male_09a300f3:
    harmony.say "Наверное, большой твёрдый член внутри — именно то, что мне было нужно, чтобы это прошло..."

# ch/harmony/talk.rpy:59
translate russian harmony_talk_sex_male_f908c579:
    harmony.say "Прости меня, Господи, но щёки всё ещё горят, когда я признаюсь, как сильно этого хочу."

# ch/harmony/talk.rpy:62
translate russian harmony_talk_sex_male_506cea55:
    harmony.say "Раньше всё, что касалось секса, ужасно меня смущало."

# ch/harmony/talk.rpy:64
translate russian harmony_talk_sex_male_5186974c:
    harmony.say "Но с тех пор, как я встретила тебя, меня это очень увлекло!"

# ch/harmony/talk.rpy:67
translate russian harmony_talk_sex_male_c1429293:
    harmony.say "Ох, [lssb_harmony.hero_name()], перестань! Ты меня смущаешь!"

# ch/harmony/talk.rpy:72
translate russian harmony_talk_politics_male_24c3639c:
    mike.say "Каких политических взглядов ты придерживаешься, Хармони?"

# ch/harmony/talk.rpy:74
translate russian harmony_talk_politics_male_e5938acd:
    harmony.say "О политике нужно судить не по его программе."

# ch/harmony/talk.rpy:75
translate russian harmony_talk_politics_male_e414ad6e:
    harmony.say "А только по тому, есть ли у него добрые христианские ценности."

# ch/harmony/talk.rpy:79
translate russian harmony_talk_politics_male_44ad2f7f:
    harmony.say "Уф... Политика отбивает всякое желание!"

# ch/harmony/talk.rpy:80
translate russian harmony_talk_politics_male_58ef2692:
    harmony.say "Лучше поговорим о чём-нибудь другом."

# ch/harmony/talk.rpy:85
translate russian harmony_talk_food_male_4c02e2e9:
    mike.say "Тебе бывает хочется сходить куда-нибудь перекусить, Хармони?"

# ch/harmony/talk.rpy:87
translate russian harmony_talk_food_male_ea2cbf68:
    harmony.say "Я... мне хочется, правда..."

# ch/harmony/talk.rpy:89
translate russian harmony_talk_food_male_6bb5298e:
    harmony.say "Но чревоугодие — один из семи смертных грехов!"

# ch/harmony/talk.rpy:92
translate russian harmony_talk_food_male_0f265b14:
    harmony.say "А... да, конечно."

# ch/harmony/talk.rpy:93
translate russian harmony_talk_food_male_d868047f:
    harmony.say "Проблема в том, что я думаю об этом СЛИШКОМ часто!"

# ch/harmony/talk.rpy:96
translate russian harmony_talk_food_male_661b66b8:
    harmony.say "Даже не знаю."

# ch/harmony/talk.rpy:98
translate russian harmony_talk_food_male_e8569a7f:
    harmony.say "Но НИЧТО не сравнится по вкусу с твоим членом, [lssb_harmony.hero_name()]!"

# ch/harmony/talk.rpy:104
translate russian harmony_talk_travels_male_dd9869da:
    mike.say "Итак, Хармони: у тебя билет в любую точку мира. Куда полетишь?"

# ch/harmony/talk.rpy:106
translate russian harmony_talk_travels_male_a29bd27a:
    harmony.say "О, это просто."

# ch/harmony/talk.rpy:107
translate russian harmony_talk_travels_male_077ba294:
    harmony.say "Прямиком в Рим, а может, в Иерусалим."

# ch/harmony/talk.rpy:109
translate russian harmony_talk_travels_male_c93b7680:
    harmony.say "Представь, каково оказаться в таком святом месте, которого коснулась рука Божья!"

# ch/harmony/talk.rpy:112
translate russian harmony_talk_travels_male_3dd9c236:
    harmony.say "Я всегда думала съездить в Африку."

# ch/harmony/talk.rpy:113
translate russian harmony_talk_travels_male_135207a7:
    harmony.say "Не отдыхать, а волонтёром, понимаешь? От какой-нибудь благотворительной организации."

# ch/harmony/talk.rpy:116
translate russian harmony_talk_travels_male_4f40a444:
    harmony.say "Какая разница, куда летит самолёт?"

# ch/harmony/talk.rpy:118
translate russian harmony_talk_travels_male_e1c97ade:
    harmony.say "Лишь бы полёт был достаточно долгим, чтобы меня успели трахнуть в туалете!"

# ch/harmony/talk.rpy:123
translate russian harmony_talk_tv_male_a00ca336:
    mike.say "Ты вообще следишь за телевидением, Хармони, или только за новыми сериалами?"

# ch/harmony/talk.rpy:125
translate russian harmony_talk_tv_male_2ab21e7f:
    harmony.say "Обычное телевидение я почти не смотрю: там практически всегда грех."

# ch/harmony/talk.rpy:126
translate russian harmony_talk_tv_male_db7d852d:
    harmony.say "Но есть один телепроповедник, и я просто не могу пропустить его передачу."

# ch/harmony/talk.rpy:128
translate russian harmony_talk_tv_male_246d8423:
    harmony.say "Может, как-нибудь посмотрим вместе?"

# ch/harmony/talk.rpy:131
translate russian harmony_talk_tv_male_9fce33b9:
    harmony.say "Раньше я часто смотрела эти передачи с проповедями."

# ch/harmony/talk.rpy:132
translate russian harmony_talk_tv_male_4c06f22a:
    harmony.say "Но в последнее время они меня, ну... скорее отталкивают."

# ch/harmony/talk.rpy:134
translate russian harmony_talk_tv_male_e94d1d45:
    harmony.say "Почему-то всё время кажется, что они сплошные лицемеры!"

# ch/harmony/talk.rpy:138
translate russian harmony_talk_tv_male_7dc7ebda:
    harmony.say "Ох, порно — это ТАК ХОРОШО!"

# ch/harmony/talk.rpy:139
translate russian harmony_talk_tv_male_ab13c911:
    harmony.say "Не верится, что я только недавно начала его смотреть!"

# ch/harmony/talk.rpy:140
translate russian harmony_talk_tv_male_d5ca8b22:
    harmony.say "Хочется смотреть ПОСТОЯННО!"

# ch/harmony/talk.rpy:143
translate russian harmony_talk_tv_male_78909717:
    harmony.say "Раньше мне нравились непристойные сцены в том сериале с драконами. Они так возбуждали!"

# ch/harmony/talk.rpy:144
translate russian harmony_talk_tv_male_4b96d7d3:
    harmony.say "А недавно я даже начала понемногу смотреть порно!"

# ch/harmony/talk.rpy:146
translate russian harmony_talk_tv_male_04ee5621:
    harmony.say "Представляешь?!"

# ch/harmony/talk.rpy:149
translate russian harmony_talk_tv_male_96a7ecbe:
    harmony.say "В последнее время нахожу по телевизору всё больше того, что мне нравится."

