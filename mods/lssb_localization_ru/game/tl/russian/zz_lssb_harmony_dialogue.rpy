    harmony.say "С Днём святого Валентина, [lssb_harmony.hero_name()]..."

# ch/harmony/gift.rpy:70
translate russian harmony_give_valentine_male_21a59d64:
    "Хармони бросает мне коробку шоколадных конфет."

# ch/harmony/gift.rpy:71
translate russian harmony_give_valentine_male_d94c862c:
    mike.say "Спасибо, Хармони."

# ch/harmony/gift.rpy:74
translate russian harmony_give_valentine_male_bada8ce7:
    harmony.say "Знаю, День святого Валентина бывает довольно мирским праздником, поэтому сначала я попросила Господа благословить эти конфеты."

# ch/harmony/gift.rpy:75
translate russian harmony_give_valentine_male_404d4acf:
    harmony.say "Пусть они подсластят тебе жизнь и сохранят чистоту твоих помыслов. Да благословит тебя Бог, [lssb_harmony.hero_name()]."

# ch/harmony/gift.rpy:78
translate russian harmony_give_valentine_male_38b34888:
    harmony.say "Я сделала их своими руками и всё это время думала о тебе."

# ch/harmony/gift.rpy:79
translate russian harmony_give_valentine_male_b8277784:
    harmony.say "Это ведь чего-нибудь да стоит, правда, [lssb_harmony.hero_name()]?"

# ch/harmony/gift.rpy:82
translate russian harmony_give_valentine_male_9af99ee9:
    harmony.say "Конфеты — только начало, [lssb_harmony.hero_name()]..."

# ch/harmony/gift.rpy:83
translate russian harmony_give_valentine_male_4b302a09:
    harmony.say "Если после них всё ещё будешь голоден, я позволю тебе развернуть кое-что гораздо слаще."

# ch/harmony/gift.rpy:89
translate russian harmony_give_birthday_male_6ca5bb05:
    "Хармони подходит ко мне."

# ch/harmony/gift.rpy:92
translate russian harmony_give_birthday_male_de8d6f7e:
    harmony.say "С днём рождения, [lssb_harmony.hero_name()]!"

# ch/harmony/gift.rpy:94
translate russian harmony_give_birthday_male_099f8ed9:
    harmony.say "Ещё год Господь хранил тебя в здравии и безопасности. Сегодня утром я поблагодарила Его в молитве."

# ch/harmony/gift.rpy:96
translate russian harmony_give_birthday_male_ee346525:
    harmony.say "Мне хотелось сделать этот день для тебя по-настоящему особенным. Ты заслуживаешь этого и гораздо большего."

# ch/harmony/gift.rpy:98
translate russian harmony_give_birthday_male_fc99f237:
    harmony.say "Твой подарок у меня с собой, [lssb_harmony.hero_name()]... А другой, гораздо более личный, прибережён на вечер."

# ch/harmony/gift.rpy:104
translate russian harmony_give_christmas_male_6ca5bb05:
    "Хармони подходит ко мне."

# ch/harmony/gift.rpy:107
translate russian harmony_give_christmas_male_d1e5c6d9:
    harmony.say "С Рождеством, [lssb_harmony.hero_name()]."

# ch/harmony/gift.rpy:109
translate russian harmony_give_christmas_male_40486f53:
    harmony.say "Это и Его день рождения, так что не будем забывать истинный смысл праздника."

# ch/harmony/gift.rpy:110
translate russian harmony_give_christmas_male_36e2abd4:
    harmony.say "Да благословит и сохранит тебя Бог, особенно в этот день."

# ch/harmony/gift.rpy:113
translate russian harmony_give_christmas_male_cf8c3058:
    harmony.say "Я так люблю это время года и так рада, что могу разделить его с тобой."

# ch/harmony/gift.rpy:115
translate russian harmony_give_christmas_male_1b4da362:
    harmony.say "Я весь год была такой хорошей девочкой, [lssb_harmony.hero_name()]. Или такой восхитительно плохой..."

# ch/harmony/gift.rpy:116
translate russian harmony_give_christmas_male_e46d1c2e:
    harmony.say "В любом случае, думаю, я заслужила право распаковать тебя сегодня вечером."

# ch/harmony/gift.rpy:124
translate russian harmony_birthday_gift_male_b816ec05:
    mike.say "С днём рождения, Хармони."

# ch/harmony/gift.rpy:126
translate russian harmony_birthday_gift_male_163c160c:
    harmony.say "Как мило, ты помнишь мой день рождения!"

# ch/harmony/gift.rpy:129
translate russian harmony_birthday_gift_male_b95340f3:
    harmony.say "Откуда ты знаешь, когда у меня день рождения?"

# ch/harmony/gift.rpy:131
translate russian harmony_birthday_gift_male_25353872:
    mike.say "Не знал. Просто повезло."

# ch/harmony/gift.rpy:135
translate russian harmony_birthday_gift_male_330bc88d:
    harmony.say "Ты настоящее благословение, [lssb_harmony.hero_name()]. Да благословит тебя Бог за то, что ты подумал обо мне."

# ch/harmony/gift.rpy:137
translate russian harmony_birthday_gift_male_2b3f1c20:
    harmony.say "Ты всегда знаешь, как дать мне почувствовать себя особенной. Спасибо, [lssb_harmony.hero_name()]."

# ch/harmony/gift.rpy:139
translate russian harmony_birthday_gift_male_abc21e9d:
    harmony.say "Так скажи, [lssb_harmony.hero_name()]... Позже я буду распаковывать подарок или тебя?"

# ch/harmony/gift.rpy:145
translate russian harmony_gift_swimsuit_male_e42761c7:
    harmony.say "Ой, [lssb_harmony.hero_name()], это мне?"

# ch/harmony/gift.rpy:147
translate russian harmony_gift_swimsuit_male_f5d21c63:
    "Она разворачивает сексуальный купальник."

# ch/harmony/gift.rpy:151
translate russian harmony_gift_swimsuit_male_b8141d7c:
    harmony.say "О-о... Тут почти ничего нет. Именно поэтому я и надену его для тебя."

# ch/harmony/gift.rpy:152
translate russian harmony_gift_swimsuit_male_a8bf330f:
    harmony.say "Отведи меня на пляж: пусть все видят, чья я. Спасибо, [lssb_harmony.hero_name()]."

# ch/harmony/gift.rpy:154
translate russian harmony_gift_swimsuit_male_80d2d159:
    harmony.say "Какой смелый, но мне нравится. Спасибо, [lssb_harmony.hero_name()]."

# ch/harmony/gift.rpy:160
translate russian harmony_gift_swimsuit_male_b106dd0f:
    harmony.say "[lssb_harmony.hero_name()]! Я ни за что! Именно такое искушение и привело к первородному греху!"

# ch/harmony/gift.rpy:161
translate russian harmony_gift_swimsuit_male_ea10f645:
    harmony.say "Немедленно забери обратно. Это хуже, чем предстать перед Господом нагой..."

# ch/harmony/gift.rpy:163
translate russian harmony_gift_swimsuit_male_a162b4b3:
    harmony.say "Спасибо, но я не могу такое носить, [lssb_harmony.hero_name()]. Это безбожно..."

# ch/harmony/gift.rpy:164
translate russian harmony_gift_swimsuit_male_2e8232a1:
    harmony.say "Даже хуже, чем ходить голой..."

# ch/harmony/gift.rpy:169
translate russian harmony_gift_collar_male_487c7d43:
    "Хочется думать, что я не из тех парней, которые совсем не понимают женщин."

# ch/harmony/gift.rpy:170
translate russian harmony_gift_collar_male_f961677a:
    "Не из тех придурков, что считают, будто знают свою девушку, а на деле понятия о ней не имеют."

# ch/harmony/gift.rpy:171
translate russian harmony_gift_collar_male_7c973d75:
    "Поэтому я стараюсь прислушиваться ко всем этим маленьким намёкам, которые женщины постоянно делают."

# ch/harmony/gift.rpy:172
translate russian harmony_gift_collar_male_02bf7e30:
    "К тем, которые мужчина так легко принимает за обычную болтовню."

# ch/harmony/gift.rpy:173
translate russian harmony_gift_collar_male_aee11577:
    "Хотя для женщины это способ проверить, слышишь ли ты то, что она на самом деле говорит."

# ch/harmony/gift.rpy:174
translate russian harmony_gift_collar_male_a4941b85:
    "Иногда я понимаю правильно, иногда — нет."

# ch/harmony/gift.rpy:175
translate russian harmony_gift_collar_male_e67b60de:
    "Но сейчас, с Хармони, кажется, попал в точку."

# ch/harmony/gift.rpy:176
translate russian harmony_gift_collar_male_2d07a08c:
    "В последнее время я улавливаю от неё определённые намёки."

# ch/harmony/gift.rpy:177
translate russian harmony_gift_collar_male_e02497a5:
    "Чувствую, что её стали интересовать кое-какие вещи."

# ch/harmony/gift.rpy:178
translate russian harmony_gift_collar_male_3a5f22ec:
    "И если я прав, мой подарок — именно то, что нужно."

# ch/harmony/gift.rpy:179
translate russian harmony_gift_collar_male_34f1222a:
    "Ну... Надеюсь, что прав!"

# ch/harmony/gift.rpy:180
translate russian harmony_gift_collar_male_dd9d7782:
    "Но коробку она уже увидела."

# ch/harmony/gift.rpy:181
translate russian harmony_gift_collar_male_be46f3a9:
    "Так что пути назад нет..."

# ch/harmony/gift.rpy:183
translate russian harmony_gift_collar_male_f5d30ea5:
    harmony.say "Ой, [lssb_harmony.hero_name()]."

# ch/harmony/gift.rpy:184
translate russian harmony_gift_collar_male_170529d9:
    harmony.say "Это что-то для меня?"

# ch/harmony/gift.rpy:186
translate russian harmony_gift_collar_male_e2a67cad:
    mike.say "Ага, Хармони."

# ch/harmony/gift.rpy:187
translate russian harmony_gift_collar_male_97512740:
    mike.say "Я купил тебе кое-что."

# ch/harmony/gift.rpy:188
translate russian harmony_gift_collar_male_302d55d4:
    "Принимая коробку, она скромно улыбается."

# ch/harmony/gift.rpy:189
translate russian harmony_gift_collar_male_d61c9103:
    "Одной из тех улыбок, от которых со мной что-то происходит!"

# ch/harmony/gift.rpy:191
translate russian harmony_gift_collar_male_905191af:
    harmony.say "Ой, как мило с твоей стороны!"

# ch/harmony/gift.rpy:193
translate russian harmony_gift_collar_male_3836312e:
    harmony.say "Ты же знаешь, что до моего дня рождения ещё далеко?"

# ch/harmony/gift.rpy:195
translate russian harmony_gift_collar_male_e293c08c:
    mike.say "Знаю, Хармони."

# ch/harmony/gift.rpy:196
translate russian harmony_gift_collar_male_7af123dd:
    mike.say "Но покупать тебе подарки и так никто не запрещает."

# ch/harmony/gift.rpy:198
translate russian harmony_gift_collar_male_9484f83a:
    harmony.say "О, это..."

# ch/harmony/gift.rpy:199
translate russian harmony_gift_collar_male_c64c85ae:
    harmony.say "Ошейник!"

# ch/harmony/gift.rpy:201
translate russian harmony_gift_collar_male_0404d29d:
    "Хармони поднимает красный кожаный ошейник из коробки."

# ch/harmony/gift.rpy:202
translate russian harmony_gift_collar_male_0919ab09:
    "По нижнему краю идёт оборка, а крупными буквами написано «Грешница»."

# ch/harmony/gift.rpy:203
translate russian harmony_gift_collar_male_120ccce1:
    mike.say "Я-то уже знаю, в какую плохую девочку ты превращаешься, Хармони."

# ch/harmony/gift.rpy:204
translate russian harmony_gift_collar_male_1f06695e:
    mike.say "А теперь и все остальные узнают!"

# ch/harmony/gift.rpy:206
translate russian harmony_gift_collar_male_2e59a9a4:
    "Хармони молча смотрит на меня."

# ch/harmony/gift.rpy:207
translate russian harmony_gift_collar_male_94baa944:
    "Словно не знает, что сказать."

# ch/harmony/gift.rpy:208
translate russian harmony_gift_collar_male_a1daccfe:
    "С каждой секундой я тревожусь всё сильнее."

# ch/harmony/gift.rpy:209
translate russian harmony_gift_collar_male_2f1b0774:
    "И готов поклясться: в уголках её глаз уже собираются слёзы."

# ch/harmony/gift.rpy:211
translate russian harmony_gift_collar_male_ee2afcd2:
    harmony.say "Ты... ты ЧУДОВИЩЕ!"

# ch/harmony/gift.rpy:212
translate russian harmony_gift_collar_male_a94908f4:
    harmony.say "Вот что ты на самом деле обо мне думаешь?!"

# ch/harmony/gift.rpy:214
translate russian harmony_gift_collar_male_ab5b09bc:
    "Не успеваю я вымолвить ни слова, как она швыряет в меня ошейник вместе с коробкой."

# ch/harmony/gift.rpy:216
translate russian harmony_gift_collar_male_30cfd07d:
    "Они попадают прямо в лицо, и я вскрикиваю от боли."

# ch/harmony/gift.rpy:217
translate russian harmony_gift_collar_male_108ce93d:
    mike.say "Ай..."

# ch/harmony/gift.rpy:218
translate russian harmony_gift_collar_male_6813c675:
    mike.say "Эй, Хармони, какого чёрта?!"

# ch/harmony/gift.rpy:220
translate russian harmony_gift_collar_male_5a7fbf18:
    "Но когда я снова начинаю ясно видеть, уже поздно."

# ch/harmony/gift.rpy:221
translate russian harmony_gift_collar_male_b676a6f1:
    "Я вижу лишь спину Хармони, которая спешит прочь."

# ch/harmony/gift.rpy:222
translate russian harmony_gift_collar_male_145497d8:
    "И слышу лишь её всхлипы, затихающие вдали."

# ch/harmony/gift.rpy:223
translate russian harmony_gift_collar_male_83d63326:
    "Может, я не так хорошо умею слушать женщин, как думал..."

# ch/harmony/gift.rpy:229
translate russian harmony_gift_collar_male_fdafcb9c:
    "Глаза Хармони широко раскрываются от удивления."

# ch/harmony/gift.rpy:230
translate russian harmony_gift_collar_male_6e5134c9:
    "Но её улыбка убеждает меня, что она не в ужасе."

# ch/harmony/gift.rpy:231
translate russian harmony_gift_collar_male_48da7593:
    "Наоборот, кажется, она на седьмом небе от моего подарка."

# ch/harmony/gift.rpy:233
translate russian harmony_gift_collar_male_a783a661:
    harmony.say "О-о-о, собачий ошейник."

# ch/harmony/gift.rpy:234
translate russian harmony_gift_collar_male_9da436fa:
    harmony.say "Как НЕПРИСТОЙНО!"

# ch/harmony/gift.rpy:235
translate russian harmony_gift_collar_male_06c39981:
    harmony.say "Это значит, я теперь вроде как твоя зверушка?"

# ch/harmony/gift.rpy:237
translate russian harmony_gift_collar_male_fc0509b4:
    "То, как Хармони смотрит на меня, говоря это..."

# ch/harmony/gift.rpy:238
translate russian harmony_gift_collar_male_c963f9f0:
    "Скажем так: у меня подкашиваются колени!"

# ch/harmony/gift.rpy:239
translate russian harmony_gift_collar_male_06151d2b:
    mike.say "А... да, Хармони."

# ch/harmony/gift.rpy:240
translate russian harmony_gift_collar_male_6578dbb2:
    mike.say "Если... если ты этого хочешь?"

# ch/harmony/gift.rpy:243
translate russian harmony_gift_collar_male_8182abfa:
    harmony.say "Ура!"

# ch/harmony/gift.rpy:244
translate russian harmony_gift_collar_male_c7423b99:
    harmony.say "Надень его, [lssb_harmony.hero_name()], скорее!"

# ch/harmony/gift.rpy:245
translate russian harmony_gift_collar_male_5a7e2d29:
    harmony.say "Хочу, чтобы все знали, что я твоя зверушка!"

# ch/harmony/gift.rpy:248
translate russian harmony_gift_collar_male_f6ddb306:
    "Я спешу исполнить приказ Хармони, хотя главным вроде бы должен быть я!"

# ch/harmony/gift.rpy:251
translate russian harmony_gift_collar_male_5cdce9c8:
    harmony.say "М-м-м..."

# ch/harmony/gift.rpy:253
translate russian harmony_gift_collar_male_26060a12:
    harmony.say "Так приятно обтягивает шею — напоминает, кто мой хозяин!"

# ch/harmony/gift.rpy:254
translate russian harmony_gift_collar_male_906fc636:
    harmony.say "И что ради него я должна быть хорошей девочкой..."

# ch/harmony/gift.rpy:262
translate russian harmony_gift_sexy_dress_male_02977c89:
    "Я жду случая вручить Хармони подарок с той минуты, как вышел из магазина."

# ch/harmony/gift.rpy:263
translate russian harmony_gift_sexy_dress_male_fc2a2573:
    "Когда она приходит на встречу, я так взволнован, что едва не протягиваю его сразу же."

# ch/harmony/gift.rpy:264
translate russian harmony_gift_sexy_dress_male_35588c61:
    "Но благодаря какому-то неведомому запасу силы воли удерживаюсь и здороваюсь нормально."

# ch/harmony/gift.rpy:265
translate russian harmony_gift_sexy_dress_male_51514606:
    "Ну, насколько нормально у меня получается в таких обстоятельствах..."

# ch/harmony/gift.rpy:266
translate russian harmony_gift_sexy_dress_male_03d33913:
    mike.say "Привет, Хармони..."

# ch/harmony/gift.rpy:267
translate russian harmony_gift_sexy_dress_male_b191fbbd:
    mike.say "Как я рад, что ты смогла прийти!"

# ch/harmony/gift.rpy:268
translate russian harmony_gift_sexy_dress_male_f683e717:
    mike.say "Кстати, потрясающе выглядишь!"

# ch/harmony/gift.rpy:269
translate russian harmony_gift_sexy_dress_male_1ec80bc2:
    "Хармони отступает на шаг и смотрит на меня с явным подозрением."

# ch/harmony/gift.rpy:271
translate russian harmony_gift_sexy_dress_male_f82e9670:
    "Потом склоняет голову набок и приподнимает бровь."

# ch/harmony/gift.rpy:273
translate russian harmony_gift_sexy_dress_male_77b7bc11:
    harmony.say "Хм..."

# ch/harmony/gift.rpy:275
translate russian harmony_gift_sexy_dress_male_bed1292a:
    harmony.say "Что я говорила тебе о похотливых замечаниях на людях, [lssb_harmony.hero_name()]?"

# ch/harmony/gift.rpy:278
translate russian harmony_gift_sexy_dress_male_60416c49:
    harmony.say "Ага!"

# ch/harmony/gift.rpy:279
translate russian harmony_gift_sexy_dress_male_cd1b9180:
    harmony.say "Классический отвлекающий манёвр. Обычно это значит, что парню что-то нужно!"

# ch/harmony/gift.rpy:282
translate russian harmony_gift_sexy_dress_male_5fd503dd:
    harmony.say "О-о..."

# ch/harmony/gift.rpy:283
translate russian harmony_gift_sexy_dress_male_b30019f3:
    harmony.say "Сыплем комплиментами и подозрительно себя ведём?"

# ch/harmony/gift.rpy:284
translate russian harmony_gift_sexy_dress_male_595213c5:
    harmony.say "Ну же, [lssb_harmony.hero_name()]..."

# ch/harmony/gift.rpy:285
translate russian harmony_gift_sexy_dress_male_bf0b39b4:
    harmony.say "Что ты задумал?"

# ch/harmony/gift.rpy:287
translate russian harmony_gift_sexy_dress_male_0941cd89:
    "Я открываю рот, собираясь придумать оправдание и выкрутиться."

# ch/harmony/gift.rpy:288
