# ch/harems/home/events/home_harem_common.rpy:1423
translate russian lexi_minami_samantha_propose_male_1b8f05f3:
    minami.say "Я с вами, братик!"

# ch/harems/home/events/home_harem_common.rpy:1425
translate russian lexi_minami_samantha_propose_male_098d5419:
    samantha.say "Мой ответ — да."

# ch/harems/home/events/home_harem_common.rpy:1427
translate russian lexi_minami_samantha_propose_male_e9e61615:
    lexi.say "Ещё бы!"

# ch/harems/home/events/home_harem_common.rpy:1428
translate russian lexi_minami_samantha_propose_male_11666f8c:
    "Я невольно улыбаюсь, когда девушки подходят."

# ch/harems/home/events/home_harem_common.rpy:1429
translate russian lexi_minami_samantha_propose_male_6e81ac35:
    "Мы собираемся тесным кружком, обнимаемся и прижимаемся друг к другу."

# ch/harems/home/events/home_harem_common.rpy:1430
translate russian lexi_minami_samantha_propose_male_3f99fbdd:
    "Но тут я замечаю тех, кто сказал «нет»."

# ch/harems/home/events/home_harem_common.rpy:1431
translate russian lexi_minami_samantha_propose_male_e26aae2f:
    "Теперь они выглядят одинокими и отвергнутыми."

# ch/harems/home/events/home_harem_common.rpy:1432
translate russian lexi_minami_samantha_propose_male_f581a8fe:
    "В животе неприятно сжимается от тревоги."

# ch/harems/home/events/home_harem_common.rpy:1433
translate russian lexi_minami_samantha_propose_male_bcb879fe:
    "Потому что я понятия не имею, что всё это значит для них..."

# ch/harems/home/events/home_harem_common.rpy:1437
translate russian bree_lexi_samantha_propose_male_d12fa97f:
    "Я знаю, что постоянно твержу, как невероятно здорово встречаться со своими соседками."

# ch/harems/home/events/home_harem_common.rpy:1438
translate russian bree_lexi_samantha_propose_male_f4c7dc45:
    "Но вам придётся привыкнуть слышать от меня именно это."

# ch/harems/home/events/home_harem_common.rpy:1439
translate russian bree_lexi_samantha_propose_male_a4798f50:
    "Может, когда-нибудь я свыкнусь с мыслью, и всё перестанет казаться таким невероятным."

# ch/harems/home/events/home_harem_common.rpy:1440
translate russian bree_lexi_samantha_propose_male_c28f260d:
    "А может, никогда не перестану просыпаться с мыслью, что я самый везучий парень на свете!"

# ch/harems/home/events/home_harem_common.rpy:1441
translate russian bree_lexi_samantha_propose_male_ba5cba67:
    "Как бы то ни было, сейчас у нас всё, кажется, хорошо."

# ch/harems/home/events/home_harem_common.rpy:1442
translate russian bree_lexi_samantha_propose_male_fe83386f:
    "Все прекрасно ладят, и нам чертовски весело вместе."

# ch/harems/home/events/home_harem_common.rpy:1443
translate russian bree_lexi_samantha_propose_male_3ebd0417:
    "Наверное, вы думаете, что я просто оставлю всё как есть."

# ch/harems/home/events/home_harem_common.rpy:1444
translate russian bree_lexi_samantha_propose_male_50850d3f:
    "Ну зачем менять то, что и так прекрасно работает?"

# ch/harems/home/events/home_harem_common.rpy:1445
translate russian bree_lexi_samantha_propose_male_253819c0:
    "Может, мне хочется сделать наш союз чуть более... постоянным?"

# ch/harems/home/events/home_harem_common.rpy:1446
translate russian bree_lexi_samantha_propose_male_2926a04a:
    "Именно так: я собираюсь предложить девушкам выйти за меня."

# ch/harems/home/events/home_harem_common.rpy:1447
translate russian bree_lexi_samantha_propose_male_6830c77d:
    "Для меня вполне естественно официально оформить наши отношения и связать себя обязательствами друг перед другом."

# ch/harems/home/events/home_harem_common.rpy:1448
translate russian bree_lexi_samantha_propose_male_39bfd812:
    "И я рассчитываю, что девушки чувствуют то же самое."

# ch/harems/home/events/home_harem_common.rpy:1453
translate russian bree_lexi_samantha_propose_male_544dfb05:
    "Поэтому, едва мы собираемся вместе и возникает подходящий момент, я делаю предложение."

# ch/harems/home/events/home_harem_common.rpy:1454
translate russian bree_lexi_samantha_propose_male_b5e79ef7:
    mike.say "Эм, девушки..."

# ch/harems/home/events/home_harem_common.rpy:1455
translate russian bree_lexi_samantha_propose_male_6e2c40cc:
    mike.say "Я хотел кое-что у вас спросить..."

# ch/harems/home/events/home_harem_common.rpy:1459
translate russian bree_lexi_samantha_propose_male_037884f3:
    "Внезапно они разом поворачивают головы."

# ch/harems/home/events/home_harem_common.rpy:1460
translate russian bree_lexi_samantha_propose_male_d677a5fb:
    "И все взгляды устремляются на меня!"

# ch/harems/home/events/home_harem_common.rpy:1461
translate russian bree_lexi_samantha_propose_male_6b34c856:
