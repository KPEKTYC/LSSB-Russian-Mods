# ch/harems/home/events/home_harem_common.rpy:1595
translate russian lexi_samantha_sasha_propose_male_6b34c856:
    "Чёрт, я думал, это будет гораздо проще."

# ch/harems/home/events/home_harem_common.rpy:1596
translate russian lexi_samantha_sasha_propose_male_72ab6ec8:
    "Будто мне заглядывают прямо в душу!"

# ch/harems/home/events/home_harem_common.rpy:1597
translate russian lexi_samantha_sasha_propose_male_b2d42e7f:
    mike.say "Наверное, надо сделать всё как положено!"

# ch/harems/home/events/home_harem_common.rpy:1598
translate russian lexi_samantha_sasha_propose_male_489353ba:
    "Я опускаюсь на одно колено прямо перед девушками."

# ch/harems/home/events/home_harem_common.rpy:1599
translate russian lexi_samantha_sasha_propose_male_82444d9a:
    "Это вызывает у них целую бурю разных чувств."

# ch/harems/home/events/home_harem_common.rpy:1600
translate russian lexi_samantha_sasha_propose_male_bdc64184:
