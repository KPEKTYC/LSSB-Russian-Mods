# ch/harems/home/events/home_harem_common.rpy:1388
translate russian lexi_minami_samantha_propose_male_b654f57d:
    mike.say "Так вы согласились?"

# ch/harems/home/events/home_harem_common.rpy:1389
translate russian lexi_minami_samantha_propose_male_5002d2ca:
    mike.say "Вы правда сказали «да»?"

# ch/harems/home/events/home_harem_common.rpy:1390
translate russian lexi_minami_samantha_propose_male_bb5f3b86:
