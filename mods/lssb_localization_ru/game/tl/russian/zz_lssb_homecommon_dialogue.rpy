# ch/harems/home/events/home_harem_common.rpy:1658
translate russian lexi_samantha_sasha_propose_male_b654f57d:
    mike.say "Так вы согласились?"

# ch/harems/home/events/home_harem_common.rpy:1659
translate russian lexi_samantha_sasha_propose_male_5002d2ca:
    mike.say "Вы правда сказали «да»?"

# ch/harems/home/events/home_harem_common.rpy:1660
translate russian lexi_samantha_sasha_propose_male_bb5f3b86:
    "На этот раз мне отвечают кивками и улыбками."

# ch/harems/home/events/home_harem_common.rpy:1661
translate russian lexi_samantha_sasha_propose_male_2f44f8f9:
    "Наверное, так даже лучше."

# ch/harems/home/events/home_harem_common.rpy:1662
translate russian lexi_samantha_sasha_propose_male_883fc300:
    "Потому что я вряд ли способен связать хоть одно предложение."

# ch/harems/home/events/home_harem_common.rpy:1663
translate russian lexi_samantha_sasha_propose_male_c8a79701:
    "Слишком взволнован для этого!"

# ch/harems/home/events/home_harem_common.rpy:1665
translate russian lexi_samantha_sasha_propose_male_779ec8f7:
    "Будто меня ударили под дых."

# ch/harems/home/events/home_harem_common.rpy:1666
translate russian lexi_samantha_sasha_propose_male_9e749a81:
    "И ударили от всей души!"

# ch/harems/home/events/home_harem_common.rpy:1667
translate russian lexi_samantha_sasha_propose_male_10b9d28e:
    "Я что, только что превратился из самого везучего парня на свете в самого жалкого?"

# ch/harems/home/events/home_harem_common.rpy:1668
translate russian lexi_samantha_sasha_propose_male_f689953d:
    "Не могу поверить, что ВСЕ отказались!"

# ch/harems/home/events/home_harem_common.rpy:1669
translate russian lexi_samantha_sasha_propose_male_a563545f:
    mike.say "В... вы все сказали «нет»..."

# ch/harems/home/events/home_harem_common.rpy:1670
translate russian lexi_samantha_sasha_propose_male_146d6225:
    mike.say "Ни одна не хочет замуж?!?"

# ch/harems/home/events/home_harem_common.rpy:1671
translate russian lexi_samantha_sasha_propose_male_f861d3cc:
    "Девушки снова переглядываются."

# ch/harems/home/events/home_harem_common.rpy:1672
translate russian lexi_samantha_sasha_propose_male_bea9b5af:
    "Но на этот раз выглядят изрядно виноватыми."

# ch/harems/home/events/home_harem_common.rpy:1673
translate russian lexi_samantha_sasha_propose_male_0f1f5d7a:
    "Наверное, хоть это должно меня немного утешить!"

# ch/harems/home/events/home_harem_common.rpy:1674
translate russian lexi_samantha_sasha_propose_male_a7dac4dd:
    sasha.say "Я не создана для брака, [lssb_common.hero_name()]!"

# ch/harems/home/events/home_harem_common.rpy:1675
translate russian lexi_samantha_sasha_propose_male_8ce01c64:
    samantha.say "Я не хочу повторять ту же ошибку."

# ch/harems/home/events/home_harem_common.rpy:1676
translate russian lexi_samantha_sasha_propose_male_8586b455:
    lexi.say "Я — замуж? Ты серьёзно?"

# ch/harems/home/events/home_harem_common.rpy:1677
translate russian lexi_samantha_sasha_propose_male_f9bc4df9:
    "Мне остаётся лишь кивнуть и сделать бодрый вид."

# ch/harems/home/events/home_harem_common.rpy:1678
translate russian lexi_samantha_sasha_propose_male_817c1ad4:
