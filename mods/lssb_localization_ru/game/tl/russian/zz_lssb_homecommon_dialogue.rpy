# ch/harems/home/events/home_harem_common.rpy:1656
translate russian lexi_samantha_sasha_propose_male_863a8021:
    samantha.say "Как это на тебя похоже, [lssb_common.hero_name()], как похоже!"

# ch/harems/home/events/home_harem_common.rpy:1657
translate russian lexi_samantha_sasha_propose_male_729d3902:
