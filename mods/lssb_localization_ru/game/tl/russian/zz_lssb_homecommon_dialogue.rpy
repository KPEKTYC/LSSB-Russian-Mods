# ch/harems/home/events/home_harem_common.rpy:1743
translate russian bree_lexi_minami_propose_male_5b9cb14f:
    mike.say "Вы все выйдете за меня?"

# ch/harems/home/events/home_harem_common.rpy:1744
translate russian bree_lexi_minami_propose_male_2762a534:
