# ch/harems/home/events/home_harem_common.rpy:61
translate russian home_harem_girls_couch_fun_2f57373e:
    "День выдался из тех, когда кажется, что ни на минуту не останавливался."

# ch/harems/home/events/home_harem_common.rpy:62
translate russian home_harem_girls_couch_fun_9b12aa65:
    "С самого звонка будильника и до этого мгновения, когда я наконец возвращаюсь домой."

# ch/harems/home/events/home_harem_common.rpy:63
translate russian home_harem_girls_couch_fun_23b77ad8:
    "Всё слилось в круговорот дел, стресса и раздражения."

# ch/harems/home/events/home_harem_common.rpy:64
translate russian home_harem_girls_couch_fun_74820581:
    "Хочется просто дойти до комнаты и наконец рухнуть на кровать."

# ch/harems/home/events/home_harem_common.rpy:65
translate russian home_harem_girls_couch_fun_39631656:
    "Закрывая за собой дверь, я собираюсь крикнуть."

# ch/harems/home/events/home_harem_common.rpy:66
translate russian home_harem_girls_couch_fun_ac004264:
    "Просто чтобы девушки знали, что я вернулся."

# ch/harems/home/events/home_harem_common.rpy:67
translate russian home_harem_girls_couch_fun_32c4af44:
    "Сейчас я не хочу ни с кем разговаривать."

# ch/harems/home/events/home_harem_common.rpy:68
translate russian home_harem_girls_couch_fun_ef7e0bc2:
    "Но предупредить о возвращении было бы вежливо."

# ch/harems/home/events/home_harem_common.rpy:69
translate russian home_harem_girls_couch_fun_c94d4edb:
    "Я открываю рот, собираясь окликнуть тех, кто дома."

# ch/harems/home/events/home_harem_common.rpy:70
translate russian home_harem_girls_couch_fun_e468122d:
    "Но замираю, услышав что-то неподалёку."

# ch/harems/home/events/home_harem_common.rpy:71
translate russian home_harem_girls_couch_fun_21725b45:
    "Звуки доносятся со стороны гостиной."

# ch/harems/home/events/home_harem_common.rpy:72
translate russian home_harem_girls_couch_fun_f67e721c:
    "И, судя по ним, там всё довольно бурно."

# ch/harems/home/events/home_harem_common.rpy:73
translate russian home_harem_girls_couch_fun_f71d6d17:
    "Хм... может, девушки играют в твистер или что-то такое?"

# ch/harems/home/events/home_harem_common.rpy:74
translate russian home_harem_girls_couch_fun_1e5be544:
    "Кровать всё ещё зовёт меня."

# ch/harems/home/events/home_harem_common.rpy:75
translate russian home_harem_girls_couch_fun_72959bf0:
    "Но голова сама поворачивается к источнику звуков."

# ch/harems/home/events/home_harem_common.rpy:76
translate russian home_harem_girls_couch_fun_a68631b8:
    "В конце концов не могу удержаться и решаю одним глазком взглянуть."

# ch/harems/home/events/home_harem_common.rpy:77
translate russian home_harem_girls_couch_fun_65ab37bd:
    "Просто утолю любопытство, и всё."

# ch/harems/home/events/home_harem_common.rpy:78
translate russian home_harem_girls_couch_fun_3d0773dc:
    "А потом пойду в комнату и наконец высплюсь."

# ch/harems/home/events/home_harem_common.rpy:79
translate russian home_harem_girls_couch_fun_c2dea7e0:
    "Подходя к двери гостиной, я зеваю."

# ch/harems/home/events/home_harem_common.rpy:80
translate russian home_harem_girls_couch_fun_7fb44308:
    "И вполне рассчитываю просто заглянуть и поздороваться с девушками."

# ch/harems/home/events/home_harem_common.rpy:81
translate russian home_harem_girls_couch_fun_bbd3634a:
    "Но, увидев их, вместо зевка издаю сдавленный вздох."

# ch/harems/home/events/home_harem_common.rpy:82
translate russian home_harem_girls_couch_fun_1daff4fb:
    "Едва успеваю его подавить, прежде чем выдать себя."

# ch/harems/home/events/home_harem_common.rpy:83
translate russian home_harem_girls_couch_fun_56e682cc:
    "Потому что увиденное совершенно меня ошеломляет."

# ch/harems/home/events/home_harem_common.rpy:89
translate russian home_harem_girls_couch_fun_e7b78a52:
    "В одном я оказался прав: девушки сплелись в один огромный клубок рук и ног."

# ch/harems/home/events/home_harem_common.rpy:90
translate russian home_harem_girls_couch_fun_91547a5b:
    "Но все они голые, так что это явно не твистер!"

# ch/harems/home/events/home_harem_common.rpy:91
translate russian home_harem_girls_couch_fun_692328b6:
    "Они собрались у одного из диванов и не смотрят в мою сторону."

# ch/harems/home/events/home_harem_common.rpy:92
translate russian home_harem_girls_couch_fun_7c0e6b3f:
    "Я вижу Сэм, раскинувшуюся на одном его конце."

# ch/harems/home/events/home_harem_common.rpy:93
translate russian home_harem_girls_couch_fun_c59ee9d8:
    "Она откинулась назад и широко развела ноги."

# ch/harems/home/events/home_harem_common.rpy:94
translate russian home_harem_girls_couch_fun_f23953be:
    "[lssb_homecommon.bree_name()] стоит перед Сэм на четвереньках, зарывшись головой между её бёдер."

# ch/harems/home/events/home_harem_common.rpy:95
translate russian home_harem_girls_couch_fun_854130f2:
    "Минами стоит на коленях на диване рядом с Сэм, и их губы соединены в поцелуе."

# ch/harems/home/events/home_harem_common.rpy:96
translate russian home_harem_girls_couch_fun_9ae732f1:
    "Рядом Саша, которая лижет и покусывает обнажённую грудь Минами."

# ch/harems/home/events/home_harem_common.rpy:98
translate russian home_harem_girls_couch_fun_de577ade:
    "И наконец я замечаю Лекси: её язык исследует попку Саши!"

# ch/harems/home/events/home_harem_common.rpy:99
translate russian home_harem_girls_couch_fun_99a8ab92:
    "Я немного отступаю от двери."

# ch/harems/home/events/home_harem_common.rpy:100
translate russian home_harem_girls_couch_fun_ba9fb71f:
    "Ровно настолько, чтобы они точно меня не увидели."

# ch/harems/home/events/home_harem_common.rpy:101
translate russian home_harem_girls_couch_fun_bbc0dcb5:
    "Пытаюсь собраться с мыслями и решить, что делать дальше."

# ch/harems/home/events/home_harem_common.rpy:104
translate russian home_harem_girls_couch_fun_f570ac6e:
    "Господи..."

# ch/harems/home/events/home_harem_common.rpy:105
translate russian home_harem_girls_couch_fun_ded7e646:
    "О чём я, чёрт возьми, сейчас думаю?"

# ch/harems/home/events/home_harem_common.rpy:106
translate russian home_harem_girls_couch_fun_37c21d05:
    "Тут и раздумывать нечего!"

# ch/harems/home/events/home_harem_common.rpy:107
translate russian home_harem_girls_couch_fun_e13cdef1:
    "Я не могу стоять здесь и смотреть, как они развлекаются."

# ch/harems/home/events/home_harem_common.rpy:108
translate russian home_harem_girls_couch_fun_4eedb879:
    "Потому что я не какой-нибудь извращенец!"

# ch/harems/home/events/home_harem_common.rpy:109
translate russian home_harem_girls_couch_fun_fc1ef5de:
    "Покачав головой, отхожу от двери гостиной."

# ch/harems/home/events/home_harem_common.rpy:111
translate russian home_harem_girls_couch_fun_e7377944:
    "И быстро, тихо иду в свою спальню."

# ch/harems/home/events/home_harem_common.rpy:112
translate russian home_harem_girls_couch_fun_f2022f07:
    "Кажется, увиденное я уже никогда не забуду."

# ch/harems/home/events/home_harem_common.rpy:113
translate russian home_harem_girls_couch_fun_a2bb4c78:
    "Но по крайней мере могу сказать, что увидел это случайно."

# ch/harems/home/events/home_harem_common.rpy:115
translate russian home_harem_girls_couch_fun_39ec7631:
    "Кого я обманываю?"

# ch/harems/home/events/home_harem_common.rpy:116
translate russian home_harem_girls_couch_fun_8adfb098:
    "Сейчас я собираюсь сделать лишь одно."

# ch/harems/home/events/home_harem_common.rpy:117
translate russian home_harem_girls_couch_fun_9d1bea64:
    "Остаться у двери и смотреть, как они развлекаются!"

# ch/harems/home/events/home_harem_common.rpy:118
translate russian home_harem_girls_couch_fun_1bfd98fc:
    "Снова выглянув из-за двери, устраиваюсь в идеальном месте."

# ch/harems/home/events/home_harem_common.rpy:119
translate russian home_harem_girls_couch_fun_60b918b4:
    "Чёрт, надо было вернуться пораньше."

# ch/harems/home/events/home_harem_common.rpy:120
translate russian home_harem_girls_couch_fun_fb51513d:
    "Тогда увидел бы и то, с чего всё началось."

# ch/harems/home/events/home_harem_common.rpy:121
translate russian home_harem_girls_couch_fun_2aca4a6e:
    "Но, наверное, стоит радоваться уже тому, что вообще что-то вижу."

# ch/harems/home/events/home_harem_common.rpy:122
translate russian home_harem_girls_couch_fun_1ab51130:
    "Да и не сказать, что я пришёл слишком поздно."

# ch/harems/home/events/home_harem_common.rpy:123
translate russian home_harem_girls_couch_fun_1ae1d9c5:
    "Девушки там развлекаются как безумные."

# ch/harems/home/events/home_harem_common.rpy:124
translate russian home_harem_girls_couch_fun_4d73c129:
    "Я чувствую, как мой член с каждой секундой твердеет."

# ch/harems/home/events/home_harem_common.rpy:125
translate russian home_harem_girls_couch_fun_3be8ac3d:
    "Кажется, всё вращается вокруг Сэм."

# ch/harems/home/events/home_harem_common.rpy:126
translate russian home_harem_girls_couch_fun_ec585f7d:
    "Словно остальные наперебой пытаются добраться до неё."

# ch/harems/home/events/home_harem_common.rpy:127
translate russian home_harem_girls_couch_fun_3a8db7b1:
    "[lssb_homecommon.bree_name()] сейчас ближе всех к самому сокровенному."

# ch/harems/home/events/home_harem_common.rpy:128
translate russian home_harem_girls_couch_fun_f225a3ec:
    "Её голову почти скрывают бёдра Сэм."

# ch/harems/home/events/home_harem_common.rpy:129
translate russian home_harem_girls_couch_fun_4b2743ec:
    "Но затем ноги раздвигаются ещё шире, и мне становится лучше видно."

# ch/harems/home/events/home_harem_common.rpy:130
translate russian home_harem_girls_couch_fun_b7a09179:
    "[lssb_homecommon.bree_name()] непрерывно двигает языком и губами."

# ch/harems/home/events/home_harem_common.rpy:131
translate russian home_harem_girls_couch_fun_e4dd8590:
    "В один миг они скользят по краям киски Сэм."

# ch/harems/home/events/home_harem_common.rpy:132
translate russian home_harem_girls_couch_fun_fc7b62f2:
    "А в следующий ныряют в центр, проникая глубоко внутрь."

# ch/harems/home/events/home_harem_common.rpy:133
translate russian home_harem_girls_couch_fun_be6a9853:
    "Сэм стонет и вертит головой."

# ch/harems/home/events/home_harem_common.rpy:134
translate russian home_harem_girls_couch_fun_66ab416e:
    "Сначала мне кажется, что удовольствие ей дарит [lssb_homecommon.bree_name()]."

# ch/harems/home/events/home_harem_common.rpy:135
translate russian home_harem_girls_couch_fun_79aeb072:
    "Но затем понимаю: стонать она может лишь в те мгновения, когда Минами её не целует."

# ch/harems/home/events/home_harem_common.rpy:136
translate russian home_harem_girls_couch_fun_ea5036dd:
    "Словно уловив мои мысли, Минами удваивает старания."

# ch/harems/home/events/home_harem_common.rpy:137
translate russian home_harem_girls_couch_fun_265de1d3:
    "Её язык скользит между губами Сэм, исследуя рот."

# ch/harems/home/events/home_harem_common.rpy:138
translate russian home_harem_girls_couch_fun_68c50ee0:
    "И вдобавок я вижу, как их соски трутся друг о друга!"

# ch/harems/home/events/home_harem_common.rpy:139
translate russian home_harem_girls_couch_fun_4a96ddb7:
    "Большая грудь Сэм и маленькая грудь Минами покачиваются в такт."

# ch/harems/home/events/home_harem_common.rpy:140
translate russian home_harem_girls_couch_fun_8b55cd13:
    "Их соски твёрдые и торчащие — отсюда, где я стою, вид просто прекрасный."

# ch/harems/home/events/home_harem_common.rpy:141
translate russian home_harem_girls_couch_fun_bcda48ca:
    "Заметив, как Минами ласкает Сэм, я вижу и то, что Саша делает с самой Минами."

# ch/harems/home/events/home_harem_common.rpy:142
translate russian home_harem_girls_couch_fun_e1312add:
    "Её руки скользят по всему телу миниатюрной девушки."

# ch/harems/home/events/home_harem_common.rpy:143
translate russian home_harem_girls_couch_fun_bd705aa4:
    "Но ещё сильнее возбуждает то, как она покусывает соски Минами!"

# ch/harems/home/events/home_harem_common.rpy:144
translate russian home_harem_girls_couch_fun_b0644a5e:
    "Я сглатываю, и не только потому, что зрелище такое горячее."

# ch/harems/home/events/home_harem_common.rpy:145
translate russian home_harem_girls_couch_fun_3bb957ec:
    "Ещё и потому, что Саша при этом выглядит такой кроткой."

# ch/harems/home/events/home_harem_common.rpy:146
translate russian home_harem_girls_couch_fun_5a5d6828:
    "Я ожидал, что темп будет задавать именно она."

# ch/harems/home/events/home_harem_common.rpy:147
translate russian home_harem_girls_couch_fun_c6f96a0d:
    "А она смотрит на Минами снизу вверх почти покорно."

# ch/harems/home/events/home_harem_common.rpy:149
translate russian home_harem_girls_couch_fun_86714b4e:
    "Мой взгляд следует изгибам тела Саши."

# ch/harems/home/events/home_harem_common.rpy:150
translate russian home_harem_girls_couch_fun_3fc5610d:
    "И доходит до округлости её попки."

# ch/harems/home/events/home_harem_common.rpy:151
translate russian home_harem_girls_couch_fun_7aa2ca62:
    "Там я и вижу причину её настроения."

# ch/harems/home/events/home_harem_common.rpy:152
translate russian home_harem_girls_couch_fun_b15802db:
    "Язык Лекси как раз там, снуёт туда-сюда."

# ch/harems/home/events/home_harem_common.rpy:153
translate russian home_harem_girls_couch_fun_556f6c11:
    "Он то и дело проникает между ягодицами Саши."

# ch/harems/home/events/home_harem_common.rpy:154
translate russian home_harem_girls_couch_fun_ea38efa6:
    "И каждый раз Саша стонет и запрокидывает голову."

# ch/harems/home/events/home_harem_common.rpy:155
translate russian home_harem_girls_couch_fun_e08f22ce:
    "На миг я невольно заглядываю за Лекси."

# ch/harems/home/events/home_harem_common.rpy:156
translate russian home_harem_girls_couch_fun_6bc23f63:
    "Интересно, не ласкает ли кто-нибудь и её!"

# ch/harems/home/events/home_harem_common.rpy:157
translate russian home_harem_girls_couch_fun_44c78765:
    "Но, к моему разочарованию, Лекси оказывается последним звеном цепочки."

# ch/harems/home/events/home_harem_common.rpy:160
translate russian home_harem_girls_couch_fun_a2ee1e21:
    "Не то чтобы я сознательно решаю засунуть руку в брюки."

# ch/harems/home/events/home_harem_common.rpy:161
translate russian home_harem_girls_couch_fun_2b67b783:
    "Просто ловлю себя на том, что уже делаю это не задумываясь."

# ch/harems/home/events/home_harem_common.rpy:162
translate russian home_harem_girls_couch_fun_dd1c9f1f:
    "Всё происходит совершенно естественно."

# ch/harems/home/events/home_harem_common.rpy:163
translate russian home_harem_girls_couch_fun_4749163e:
    "Не успеваю опомниться, как уже дрочу, глядя на происходящее."

# ch/harems/home/events/home_harem_common.rpy:164
translate russian home_harem_girls_couch_fun_b9f86598:
    "Все эти тела, двигающиеся вместе."

# ch/harems/home/events/home_harem_common.rpy:165
translate russian home_harem_girls_couch_fun_64d28156:
    "Столько женской плоти сразу."

# ch/harems/home/events/home_harem_common.rpy:166
translate russian home_harem_girls_couch_fun_235410ab:
    "Я едва знаю, куда смотреть, и двигаюсь всё быстрее."

# ch/harems/home/events/home_harem_common.rpy:167
translate russian home_harem_girls_couch_fun_b3a1f92c:
    "И чувствую, как извергаюсь, пока в гостиной что-то происходит."

# ch/harems/home/events/home_harem_common.rpy:171
translate russian home_harem_girls_couch_fun_e78a43ed:
    "Сердце колотится в груди."

# ch/harems/home/events/home_harem_common.rpy:172
translate russian home_harem_girls_couch_fun_54d3e8ec:
    "Дыхание тоже становится рваным и тяжёлым."

# ch/harems/home/events/home_harem_common.rpy:173
translate russian home_harem_girls_couch_fun_304e3a9d:
    "Чёрт, кажется, будто я там, в самой гуще, вместе с ними!"

# ch/harems/home/events/home_harem_common.rpy:174
translate russian home_harem_girls_couch_fun_bf58bab5:
    "И это чувство лишь усиливается, пока я наблюдаю, как всё приближается к развязке."

# ch/harems/home/events/home_harem_common.rpy:175
translate russian home_harem_girls_couch_fun_760ca77f:
    "Одна за другой девушки начинают кончать."

# ch/harems/home/events/home_harem_common.rpy:176
translate russian home_harem_girls_couch_fun_fe9723c3:
    "Волна проходит через них, словно каскад."

# ch/harems/home/events/home_harem_common.rpy:177
translate russian home_harem_girls_couch_fun_bff68dc1:
    "И вскоре всех охватывают судороги оргазма."

# ch/harems/home/events/home_harem_common.rpy:178
translate russian home_harem_girls_couch_fun_de1d4eb5:
    "Я замираю, наблюдая и гадая, как часто такое происходит."

# ch/harems/home/events/home_harem_common.rpy:179
translate russian home_harem_girls_couch_fun_08062ede:
    "Наверняка ведь довольно редко, правда?"

# ch/harems/home/events/home_harem_common.rpy:180
translate russian home_harem_girls_couch_fun_78f3a8ca:
    "Но пока девушки ещё извиваются от удовольствия, я возвращаюсь к реальности."

# ch/harems/home/events/home_harem_common.rpy:181
translate russian home_harem_girls_couch_fun_82a90448:
    "Сейчас самое время поспешно отступить."

# ch/harems/home/events/home_harem_common.rpy:183
translate russian home_harem_girls_couch_fun_9f931613:
    "Я отворачиваюсь от двери и иду к себе в спальню."

# ch/harems/home/events/home_harem_common.rpy:184
translate russian home_harem_girls_couch_fun_d56e57c4:
    "Надеюсь только удержать увиденное в памяти."

# ch/harems/home/events/home_harem_common.rpy:185
translate russian home_harem_girls_couch_fun_46de0b9f:
    "Потому что вряд ли скоро снова увижу нечто подобное!"

# ch/harems/home/events/home_harem_common.rpy:195
translate russian home_harem_compare_bellies_46d60261:
    "Лучшее в фантазии, пока она остаётся фантазией, — не нужно слишком уж всё продумывать."

# ch/harems/home/events/home_harem_common.rpy:196
translate russian home_harem_compare_bellies_b5e63b51:
    "То есть можно долго дорисовывать в голове подробности."

# ch/harems/home/events/home_harem_common.rpy:197
translate russian home_harem_compare_bellies_39b135dd:
    "Но почти наверняка думаешь лишь о приятном, а не о практической стороне."

# ch/harems/home/events/home_harem_common.rpy:198
translate russian home_harem_compare_bellies_cf4b2710:
    "И только когда фантазия становится реальностью, начинают проявляться менее очевидные детали."

# ch/harems/home/events/home_harem_common.rpy:199
translate russian home_harem_compare_bellies_34aa4110:
    "Конечно, развлекаться с целой компанией девушек вместо одной — огромное удовольствие."

# ch/harems/home/events/home_harem_common.rpy:200
translate russian home_harem_compare_bellies_e479c1e3:
    "Но и сопутствующих подводных камней становится во столько же раз больше."

# ch/harems/home/events/home_harem_common.rpy:201
translate russian home_harem_compare_bellies_2cc1d21a:
    "Даже в самых смелых мечтах я не представлял, что буду смотреть, как девушки сравнивают размеры своих животов."

# ch/harems/home/events/home_harem_common.rpy:202
translate russian home_harem_compare_bellies_2cf06a42:
    "Я всегда боялся, что от меня забеременеет хотя бы одна девушка, — не то что сразу целая компания!"

# ch/harems/home/events/home_harem_common.rpy:223
translate russian home_harem_compare_bellies_68cf3e82:
    bree.say "По-моему, сейчас ты чуть больше меня."

# ch/harems/home/events/home_harem_common.rpy:226
translate russian home_harem_compare_bellies_af65b782:
    sasha.say "Знаю, знаю... Чувствую себя китом!"

# ch/harems/home/events/home_harem_common.rpy:229
translate russian home_harem_compare_bellies_9a41ab45:
    lexi.say "Уф... Никогда не думала, что стану такой толстой!"

# ch/harems/home/events/home_harem_common.rpy:232
translate russian home_harem_compare_bellies_f66e966c:
    minami.say "А я всегда представляла себе аккуратный маленький животик."

# ch/harems/home/events/home_harem_common.rpy:235
translate russian home_harem_compare_bellies_fc238d18:
    samantha.say "Ага, я чувствую себя борцом сумо!"

# ch/harems/home/events/home_harem_common.rpy:238
translate russian home_harem_compare_bellies_4e5247b8:
    bree.say "Да нет же, не глупи! Ты прямо светишься!"

# ch/harems/home/events/home_harem_common.rpy:241
translate russian home_harem_compare_bellies_1b3ad0b0:
    sasha.say "Ага-ага... Это я потом обливаюсь, понимаешь?"

# ch/harems/home/events/home_harem_common.rpy:244
translate russian home_harem_compare_bellies_eade41c9:
    bree.say "Не говори! А ещё утренняя тошнота и опухшие лодыжки..."

# ch/harems/home/events/home_harem_common.rpy:247
translate russian home_harem_compare_bellies_23b606a2:
    lexi.say "Меня каждое утро тошнит, как только просыпаюсь!"

# ch/harems/home/events/home_harem_common.rpy:250
translate russian home_harem_compare_bellies_a6b5a905:
    minami.say "Вот бы мне тех бумажных пакетов, которые дают в самолёте!"

# ch/harems/home/events/home_harem_common.rpy:253
translate russian home_harem_compare_bellies_18a8a528:
    samantha.say "Скорее уж ведро!"

# ch/harems/home/events/home_harem_common.rpy:256
translate russian home_harem_compare_bellies_b18d8853:
    sasha.say "Не говоря уже о груди!"

# ch/harems/home/events/home_harem_common.rpy:259
translate russian home_harem_compare_bellies_25d9e60f:
    bree.say "О боже!"

# ch/harems/home/events/home_harem_common.rpy:262
translate russian home_harem_compare_bellies_c800afd4:
    lexi.say "Мои чёртовы сиськи!"

# ch/harems/home/events/home_harem_common.rpy:265
translate russian home_harem_compare_bellies_dae9a027:
    minami.say "Да, я хотела грудь побольше, но не так же!"

# ch/harems/home/events/home_harem_common.rpy:268
translate russian home_harem_compare_bellies_c673f566:
    samantha.say "Ага, ни один лифчик больше не подходит!"

# ch/harems/home/events/home_harem_common.rpy:269
translate russian home_harem_compare_bellies_1f78ae3a:
    "При такой теме я невольно навостряю уши."

# ch/harems/home/events/home_harem_common.rpy:271
translate russian home_harem_compare_bellies_70383d18:
    bree.say "Уф... Кажется, они растут каждый день."

# ch/harems/home/events/home_harem_common.rpy:272
translate russian home_harem_compare_bellies_be879bb9:
    bree.say "Будто у меня скоро вырастет вымя и я превращусь в корову!"

# ch/harems/home/events/home_harem_common.rpy:274
translate russian home_harem_compare_bellies_c1e5631a:
    lexi.say "Мне каждый день хочется, чтобы меня подоили!"

# ch/harems/home/events/home_harem_common.rpy:276
translate russian home_harem_compare_bellies_aa0d5ec5:
    minami.say "Хоть начинай мычать «МУ-У!», до того всё плохо!"

# ch/harems/home/events/home_harem_common.rpy:278
translate russian home_harem_compare_bellies_329c6746:
    sasha.say "А соски у меня такие..."

# ch/harems/home/events/home_harem_common.rpy:279
translate russian home_harem_compare_bellies_57acab44:
    "Разговор обрывается: девушки замечают, что я пытаюсь незаметно подслушивать."

# ch/harems/home/events/home_harem_common.rpy:280
translate russian home_harem_compare_bellies_cc47bdcb:
    "Я нервно улыбаюсь им и невинно пожимаю плечами."

# ch/harems/home/events/home_harem_common.rpy:281
translate russian home_harem_compare_bellies_d2c15782:
    mike.say "Я... эм... случайно услышал!"

# ch/harems/home/events/home_harem_common.rpy:282
translate russian home_harem_compare_bellies_063bb2a5:
    "Честно говоря, жду, что меня отчитают за подслушивание."

# ch/harems/home/events/home_harem_common.rpy:283
translate russian home_harem_compare_bellies_5d8c6cf3:
    "Или хотя бы велят не лезть в их личный, довольно интимный разговор."

# ch/harems/home/events/home_harem_common.rpy:284
translate russian home_harem_compare_bellies_b69d63fa:
    "Но вместо этого все как одна улыбаются мне."

# ch/harems/home/events/home_harem_common.rpy:285
translate russian home_harem_compare_bellies_f5bada10:
    "И внезапно ко мне разворачиваются сразу несколько округлившихся животов."

# ch/harems/home/events/home_harem_common.rpy:287
translate russian home_harem_compare_bellies_4bf0d093:
    bree.say "Всё хорошо, [lssb_common.hero_name()]. В конце концов, ты ведь дважды станешь папой!"

# ch/harems/home/events/home_harem_common.rpy:288
translate russian home_harem_compare_bellies_d6d2da82:
    "Я отчётливо чувствую, что мне полагается их потрогать."

# ch/harems/home/events/home_harem_common.rpy:289
translate russian home_harem_compare_bellies_a055c95c:
    "Но всё так внезапно — и даже немного жутко!"

# ch/harems/home/events/home_harem_common.rpy:291
translate russian home_harem_compare_bellies_c1fdbf48:
    sasha.say "[lssb_common.hero_name()], тебя тоже надо включать во все эти разговоры."

# ch/harems/home/events/home_harem_common.rpy:293
translate russian home_harem_compare_bellies_2ce2016a:
    sasha.say "Когда малыши появятся, на твои плечи столько всего свалится!"

# ch/harems/home/events/home_harem_common.rpy:296
translate russian home_harem_compare_bellies_343ee681:
    bree.say "Подгузники менять, бутылочки готовить, коляску катать!"

# ch/harems/home/events/home_harem_common.rpy:299
translate russian home_harem_compare_bellies_e4686dba:
    lexi.say "Одежду покупать и кроватки собирать!"

# ch/harems/home/events/home_harem_common.rpy:302
translate russian home_harem_compare_bellies_ce089659:
    minami.say "Колыбельные учить и сказки на ночь читать!"

# ch/harems/home/events/home_harem_common.rpy:305
translate russian home_harem_compare_bellies_16974e14:
    samantha.say "Даже садики и школы выбирать!"

# ch/harems/home/events/home_harem_common.rpy:306
translate russian home_harem_compare_bellies_939b91e4:
    "Я уже чувствую, как от страха волосы на затылке встают дыбом."

# ch/harems/home/events/home_harem_common.rpy:307
translate russian home_harem_compare_bellies_ddb42fac:
    "Почему мне ничего из этого не приходило в голову раньше?"

# ch/harems/home/events/home_harem_common.rpy:308
translate russian home_harem_compare_bellies_a3edfff4:
    "Почему-то я решил, что раз в отношениях нас больше двух, то и хлопот будет меньше."

# ch/harems/home/events/home_harem_common.rpy:309
translate russian home_harem_compare_bellies_51a42d1f:
    "Но если все девушки родят примерно одновременно, всё, конечно, будет ровно наоборот."

# ch/harems/home/events/home_harem_common.rpy:310
translate russian home_harem_compare_bellies_de5f8b47:
    "О боже, ведь бегать мне придётся не только вокруг младенцев."

# ch/harems/home/events/home_harem_common.rpy:311
translate russian home_harem_compare_bellies_ba34ba2b:
    "Я, по сути, ещё и стану рабом прихотей целого гарема, измученного гормонами!"

# ch/harems/home/events/home_harem_common.rpy:312
translate russian home_harem_compare_bellies_ede708ba:
    "От мысли о том, что меня ждёт, глаза расширяются от ужаса..."

# ch/harems/home/events/home_harem_common.rpy:314
translate russian home_harem_compare_bellies_d6834b54:
    bree.say "Ой, смотрите, у него уже глаза на мокром месте от мысли, что он станет папой!"

# ch/harems/home/events/home_harem_common.rpy:316
translate russian home_harem_compare_bellies_2d867d1e:
    lexi.say "Ах ты наш сентиментальный!"

# ch/harems/home/events/home_harem_common.rpy:318
translate russian home_harem_compare_bellies_aebaba01:
    minami.say "Не терпится с ними познакомиться, да, братик?"

# ch/harems/home/events/home_harem_common.rpy:320
translate russian home_harem_compare_bellies_b3617652:
    samantha.say "Ты уже представляешь себя родителем, правда, [lssb_common.hero_name()]?"

# ch/harems/home/events/home_harem_common.rpy:321
translate russian home_harem_compare_bellies_c28f9e48:
    "Я поднимаю глаза, удивлённый тем, как неверно девушки истолковали мою реакцию."

# ch/harems/home/events/home_harem_common.rpy:322
translate russian home_harem_compare_bellies_fb94080f:
    "Но прежде чем успеваю что-то сказать, они снова меня поражают — внезапно разражаются слезами."

# ch/harems/home/events/home_harem_common.rpy:323
translate russian home_harem_compare_bellies_8914b414:
    mike.say "Чт... что... что случилось?"

# ch/harems/home/events/home_harem_common.rpy:324
translate russian home_harem_compare_bellies_ac50c79a:
    mike.say "Что я сказал?!?"

# ch/harems/home/events/home_harem_common.rpy:325
translate russian home_harem_compare_bellies_f9fd4a85:
    "Вместо ответа они мотают головами и обнимают друг друга."

# ch/harems/home/events/home_harem_common.rpy:328
translate russian home_harem_compare_bellies_dc4e8d5b:
    sasha.say "Ты не виноват, [lssb_common.hero_name()]."

# ch/harems/home/events/home_harem_common.rpy:329
translate russian home_harem_compare_bellies_f55917f2:
    sasha.say "Всё эти чёртовы перепады настроения."

# ch/harems/home/events/home_harem_common.rpy:330
translate russian home_harem_compare_bellies_15227c8d:
    sasha.say "КАК ЖЕ Я ИХ НЕНАВИЖУ!"

# ch/harems/home/events/home_harem_common.rpy:333
translate russian home_harem_compare_bellies_dc204e86:
    bree.say "От гормонов эмоции просто сходят с ума!"

# ch/harems/home/events/home_harem_common.rpy:336
translate russian home_harem_compare_bellies_10a9ee9d:
    lexi.say "Словно эмоциональные американские горки."

# ch/harems/home/events/home_harem_common.rpy:337
translate russian home_harem_compare_bellies_1c7deb21:
    lexi.say "И я не могу сойти!"

# ch/harems/home/events/home_harem_common.rpy:340
translate russian home_harem_compare_bellies_1d16153e:
    minami.say "Это... это ГОРАЗДО хуже полового созревания!"

# ch/harems/home/events/home_harem_common.rpy:343
translate russian home_harem_compare_bellies_2fcf15c8:
    samantha.say "Я совсем не могу управлять своими чувствами!"

# ch/harems/home/events/home_harem_common.rpy:344
translate russian home_harem_compare_bellies_94b4cdc0:
    "С видимым усилием они на мгновение берут себя в руки."

# ch/harems/home/events/home_harem_common.rpy:345
translate russian home_harem_compare_bellies_bf0f7ad4:
    "И вот на меня смотрят сразу несколько пар покрасневших, опухших глаз!"

# ch/harems/home/events/home_harem_common.rpy:347
translate russian home_harem_compare_bellies_c569d0af:
    bree.say "Я не расстроена."

# ch/harems/home/events/home_harem_common.rpy:348
translate russian home_harem_compare_bellies_828e442a:
    bree.say "Я... хлюп... просто так... хлюп... счастлива!"

# ch/harems/home/events/home_harem_common.rpy:350
translate russian home_harem_compare_bellies_64e1306c:
    sasha.say "Это такое... такое счастливое время!"

# ch/harems/home/events/home_harem_common.rpy:352
translate russian home_harem_compare_bellies_283a873c:
    lexi.say "Я так счастлива, что меня сейчас вырвет!"

# ch/harems/home/events/home_harem_common.rpy:353
translate russian home_harem_compare_bellies_7e1eef98:
    lexi.say "И скорее всего, правда вырвет!"

# ch/harems/home/events/home_harem_common.rpy:355
translate russian home_harem_compare_bellies_e3e8c954:
    minami.say "Я ещё никогда не была такой счастливой, не чувствовала такой полноты жизни!"

# ch/harems/home/events/home_harem_common.rpy:357
translate russian home_harem_compare_bellies_f717d2d9:
    samantha.say "Знаю, звучит безумно..."

# ch/harems/home/events/home_harem_common.rpy:358
translate russian home_harem_compare_bellies_7496dad5:
    samantha.say "Но я бы ничего не стала менять!"

# ch/harems/home/events/home_harem_common.rpy:359
translate russian home_harem_compare_bellies_42fee2af:
    "И с этими словами они снова заливаются слезами, уткнувшись друг другу в плечи."

# ch/harems/home/events/home_harem_common.rpy:360
translate russian home_harem_compare_bellies_c2a14bd5:
    "Всё, что я могу придумать, — похлопать каждую по плечу и сказать несколько банальных утешений."

# ch/harems/home/events/home_harem_common.rpy:361
translate russian home_harem_compare_bellies_b2daabe6:
    "Я чувствую себя бесполезным и совершенно не понимаю, чем лучше помочь хоть одной из них."

# ch/harems/home/events/home_harem_common.rpy:362
translate russian home_harem_compare_bellies_6990070c:
    "И я почти уверен, что до рождения малышей останусь единственным здравомыслящим человеком в доме!"

# ch/harems/home/events/home_harem_common.rpy:363
translate russian home_harem_compare_bellies_2af8c9e2:
    "Хотя потом, уверен, начнётся уже совсем другое безумие..."

# ch/harems/home/events/home_harem_common.rpy:374
translate russian bree_lexi_minami_samantha_sasha_propose_male_d12fa97f:
    "Я знаю, что постоянно твержу, как невероятно здорово встречаться со своими соседками."

# ch/harems/home/events/home_harem_common.rpy:375
translate russian bree_lexi_minami_samantha_sasha_propose_male_f4c7dc45:
    "Но вам придётся привыкнуть слышать от меня именно это."

# ch/harems/home/events/home_harem_common.rpy:376
translate russian bree_lexi_minami_samantha_sasha_propose_male_a4798f50:
    "Может, когда-нибудь я свыкнусь с мыслью, и всё перестанет казаться таким невероятным."

# ch/harems/home/events/home_harem_common.rpy:377
translate russian bree_lexi_minami_samantha_sasha_propose_male_c28f260d:
    "А может, никогда не перестану просыпаться с мыслью, что я самый везучий парень на свете!"

# ch/harems/home/events/home_harem_common.rpy:378
translate russian bree_lexi_minami_samantha_sasha_propose_male_ba5cba67:
