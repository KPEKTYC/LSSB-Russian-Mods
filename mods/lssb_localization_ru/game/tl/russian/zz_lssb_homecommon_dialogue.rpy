# ch/harems/home/events/home_harem_common.rpy:2978
translate russian bree_lexi_propose_male_11666f8c:
    "Я невольно улыбаюсь, когда девушки подходят."

# ch/harems/home/events/home_harem_common.rpy:2979
translate russian bree_lexi_propose_male_6e81ac35:
    "Мы собираемся тесным кружком, обнимаемся и прижимаемся друг к другу."

# ch/harems/home/events/home_harem_common.rpy:2980
translate russian bree_lexi_propose_male_3f99fbdd:
    "Но тут я замечаю тех, кто сказал «нет»."

# ch/harems/home/events/home_harem_common.rpy:2981
translate russian bree_lexi_propose_male_e26aae2f:
    "Теперь они выглядят одинокими и отвергнутыми."

# ch/harems/home/events/home_harem_common.rpy:2982
translate russian bree_lexi_propose_male_f581a8fe:
    "В животе неприятно сжимается от тревоги."

# ch/harems/home/events/home_harem_common.rpy:2983
translate russian bree_lexi_propose_male_bcb879fe:
    "Потому что я понятия не имею, что всё это значит для них..."

# ch/harems/home/events/home_harem_common.rpy:2987
translate russian lexi_sasha_propose_male_d12fa97f:
    "Я знаю, что постоянно твержу, как невероятно здорово встречаться со своими соседками."

# ch/harems/home/events/home_harem_common.rpy:2988
translate russian lexi_sasha_propose_male_f4c7dc45:
    "Но вам придётся привыкнуть слышать от меня именно это."

# ch/harems/home/events/home_harem_common.rpy:2989
translate russian lexi_sasha_propose_male_a4798f50:
    "Может, когда-нибудь я свыкнусь с мыслью, и всё перестанет казаться таким невероятным."

# ch/harems/home/events/home_harem_common.rpy:2990
translate russian lexi_sasha_propose_male_c28f260d:
    "А может, никогда не перестану просыпаться с мыслью, что я самый везучий парень на свете!"

# ch/harems/home/events/home_harem_common.rpy:2991
translate russian lexi_sasha_propose_male_ba5cba67:
    "Как бы то ни было, сейчас у нас всё, кажется, хорошо."

# ch/harems/home/events/home_harem_common.rpy:2992
translate russian lexi_sasha_propose_male_fe83386f:
    "Все прекрасно ладят, и нам чертовски весело вместе."

# ch/harems/home/events/home_harem_common.rpy:2993
translate russian lexi_sasha_propose_male_3ebd0417:
    "Наверное, вы думаете, что я просто оставлю всё как есть."

# ch/harems/home/events/home_harem_common.rpy:2994
translate russian lexi_sasha_propose_male_50850d3f:
    "Ну зачем менять то, что и так прекрасно работает?"

# ch/harems/home/events/home_harem_common.rpy:2995
translate russian lexi_sasha_propose_male_253819c0:
    "Может, мне хочется сделать наш союз чуть более... постоянным?"

# ch/harems/home/events/home_harem_common.rpy:2996
translate russian lexi_sasha_propose_male_2926a04a:
    "Именно так: я собираюсь предложить девушкам выйти за меня."

# ch/harems/home/events/home_harem_common.rpy:2997
translate russian lexi_sasha_propose_male_6830c77d:
    "Для меня вполне естественно официально оформить наши отношения и связать себя обязательствами друг перед другом."

# ch/harems/home/events/home_harem_common.rpy:2998
translate russian lexi_sasha_propose_male_39bfd812:
    "И я рассчитываю, что девушки чувствуют то же самое."

# ch/harems/home/events/home_harem_common.rpy:3002
translate russian lexi_sasha_propose_male_544dfb05:
    "Поэтому, едва мы собираемся вместе и возникает подходящий момент, я делаю предложение."

# ch/harems/home/events/home_harem_common.rpy:3003
translate russian lexi_sasha_propose_male_b5e79ef7:
    mike.say "Эм, девушки..."

# ch/harems/home/events/home_harem_common.rpy:3004
translate russian lexi_sasha_propose_male_6e2c40cc:
    mike.say "Я хотел кое-что у вас спросить..."

# ch/harems/home/events/home_harem_common.rpy:3007
translate russian lexi_sasha_propose_male_037884f3:
    "Внезапно они разом поворачивают головы."

# ch/harems/home/events/home_harem_common.rpy:3008
translate russian lexi_sasha_propose_male_d677a5fb:
    "И все взгляды устремляются на меня!"

# ch/harems/home/events/home_harem_common.rpy:3009
translate russian lexi_sasha_propose_male_6b34c856:
    "Чёрт, я думал, это будет гораздо проще."

# ch/harems/home/events/home_harem_common.rpy:3010
translate russian lexi_sasha_propose_male_72ab6ec8:
    "Будто мне заглядывают прямо в душу!"

# ch/harems/home/events/home_harem_common.rpy:3011
translate russian lexi_sasha_propose_male_b2d42e7f:
    mike.say "Наверное, надо сделать всё как положено!"

# ch/harems/home/events/home_harem_common.rpy:3012
translate russian lexi_sasha_propose_male_489353ba:
    "Я опускаюсь на одно колено прямо перед девушками."

# ch/harems/home/events/home_harem_common.rpy:3013
translate russian lexi_sasha_propose_male_82444d9a:
    "Это вызывает у них целую бурю разных чувств."

# ch/harems/home/events/home_harem_common.rpy:3014
translate russian lexi_sasha_propose_male_bdc64184:
    "Только что они были растеряны, а теперь поражены."

# ch/harems/home/events/home_harem_common.rpy:3015
translate russian lexi_sasha_propose_male_65be5ac1:
    "Может, так и должно быть?"

# ch/harems/home/events/home_harem_common.rpy:3016
translate russian lexi_sasha_propose_male_20bfe615:
    mike.say "Вы..."

# ch/harems/home/events/home_harem_common.rpy:3020
translate russian lexi_sasha_propose_male_5b9cb14f:
    mike.say "Вы все выйдете за меня?"

# ch/harems/home/events/home_harem_common.rpy:3021
translate russian lexi_sasha_propose_male_2762a534:
    mike.say "И, наверное, друг за друга тоже?"

# ch/harems/home/events/home_harem_common.rpy:3022
translate russian lexi_sasha_propose_male_05917d0c:
    "Ответ не заставляет себя ждать..."

# ch/harems/home/events/home_harem_common.rpy:3025
translate russian lexi_sasha_propose_male_1d0ac3f1:
    sasha.say "Ты с ума сошёл?!?"

# ch/harems/home/events/home_harem_common.rpy:3026
translate russian lexi_sasha_propose_male_50345858:
    sasha.say "Я ввязалась в это не ради замужества!"

# ch/harems/home/events/home_harem_common.rpy:3030
translate russian lexi_sasha_propose_male_929380d1:
    sasha.say "Ого, вот это неожиданность!"

# ch/harems/home/events/home_harem_common.rpy:3032
translate russian lexi_sasha_propose_male_0ea27362:
    sasha.say "Но да, я согласна!"

# ch/harems/home/events/home_harem_common.rpy:3036
translate russian lexi_sasha_propose_male_f1818e52:
    lexi.say "Ты не можешь жениться на нас всех."

# ch/harems/home/events/home_harem_common.rpy:3037
translate russian lexi_sasha_propose_male_7d6eb3a3:
    lexi.say "Это слишком дико даже для меня!"

# ch/harems/home/events/home_harem_common.rpy:3041
translate russian lexi_sasha_propose_male_d92387ba:
    lexi.say "Мы все поженимся?!?"

# ch/harems/home/events/home_harem_common.rpy:3043
translate russian lexi_sasha_propose_male_1a2a740c:
    lexi.say "Безумие! Я за!"

# ch/harems/home/events/home_harem_common.rpy:3045
translate russian lexi_sasha_propose_male_d486019f:
    "Наверное, отвечать на такой вопрос было для девушек потрясением."

# ch/harems/home/events/home_harem_common.rpy:3046
translate russian lexi_sasha_propose_male_125efa08:
    "Потому что слушать их ответы для меня точно было именно им."

# ch/harems/home/events/home_harem_common.rpy:3047
translate russian lexi_sasha_propose_male_425a8e8a:
    "Мне даже требуется время, чтобы осознать сказанное."

# ch/harems/home/events/home_harem_common.rpy:3049
translate russian lexi_sasha_propose_male_227f57cb:
    mike.say "В... вы все сказали «да»?"

# ch/harems/home/events/home_harem_common.rpy:3050
translate russian lexi_sasha_propose_male_eb2f3acc:
    mike.say "Вы правда все хотите выйти за меня?!?"

# ch/harems/home/events/home_harem_common.rpy:3051
translate russian lexi_sasha_propose_male_34836f21:
    "Второй вопрос вызывает уже смесь веселья и раздражения."

# ch/harems/home/events/home_harem_common.rpy:3052
translate russian lexi_sasha_propose_male_bb695139:
    "Девушки качают головами и закатывают глаза."

# ch/harems/home/events/home_harem_common.rpy:3053
translate russian lexi_sasha_propose_male_718fc05f:
    sasha.say "Серьёзно, ты оглох, что ли?"

# ch/harems/home/events/home_harem_common.rpy:3054
translate russian lexi_sasha_propose_male_729d3902:
    lexi.say "Господи, тебе бы уши прочистить!"

# ch/harems/home/events/home_harem_common.rpy:3055
translate russian lexi_sasha_propose_male_b654f57d:
    mike.say "Так вы согласились?"

# ch/harems/home/events/home_harem_common.rpy:3056
translate russian lexi_sasha_propose_male_5002d2ca:
    mike.say "Вы правда сказали «да»?"

# ch/harems/home/events/home_harem_common.rpy:3057
translate russian lexi_sasha_propose_male_bb5f3b86:
    "На этот раз мне отвечают кивками и улыбками."

# ch/harems/home/events/home_harem_common.rpy:3058
translate russian lexi_sasha_propose_male_2f44f8f9:
    "Наверное, так даже лучше."

# ch/harems/home/events/home_harem_common.rpy:3059
translate russian lexi_sasha_propose_male_883fc300:
    "Потому что я вряд ли способен связать хоть одно предложение."

# ch/harems/home/events/home_harem_common.rpy:3060
translate russian lexi_sasha_propose_male_c8a79701:
    "Слишком взволнован для этого!"

# ch/harems/home/events/home_harem_common.rpy:3062
translate russian lexi_sasha_propose_male_779ec8f7:
    "Будто меня ударили под дых."

# ch/harems/home/events/home_harem_common.rpy:3063
translate russian lexi_sasha_propose_male_9e749a81:
    "И ударили от всей души!"

# ch/harems/home/events/home_harem_common.rpy:3064
translate russian lexi_sasha_propose_male_10b9d28e:
    "Я что, только что превратился из самого везучего парня на свете в самого жалкого?"

# ch/harems/home/events/home_harem_common.rpy:3065
translate russian lexi_sasha_propose_male_f689953d:
    "Не могу поверить, что ВСЕ отказались!"

# ch/harems/home/events/home_harem_common.rpy:3066
translate russian lexi_sasha_propose_male_a563545f:
    mike.say "В... вы все сказали «нет»..."

# ch/harems/home/events/home_harem_common.rpy:3067
translate russian lexi_sasha_propose_male_146d6225:
    mike.say "Ни одна не хочет замуж?!?"

# ch/harems/home/events/home_harem_common.rpy:3068
translate russian lexi_sasha_propose_male_f861d3cc:
    "Девушки снова переглядываются."

# ch/harems/home/events/home_harem_common.rpy:3069
translate russian lexi_sasha_propose_male_bea9b5af:
    "Но на этот раз выглядят изрядно виноватыми."

# ch/harems/home/events/home_harem_common.rpy:3070
translate russian lexi_sasha_propose_male_0f1f5d7a:
    "Наверное, хоть это должно меня немного утешить!"

# ch/harems/home/events/home_harem_common.rpy:3071
translate russian lexi_sasha_propose_male_a7dac4dd:
    sasha.say "Я не создана для брака, [lssb_common.hero_name()]!"

# ch/harems/home/events/home_harem_common.rpy:3072
translate russian lexi_sasha_propose_male_8586b455:
    lexi.say "Я — замуж? Ты серьёзно?"

# ch/harems/home/events/home_harem_common.rpy:3073
translate russian lexi_sasha_propose_male_f9bc4df9:
    "Мне остаётся лишь кивнуть и сделать бодрый вид."

# ch/harems/home/events/home_harem_common.rpy:3074
translate russian lexi_sasha_propose_male_817c1ad4:
    "Но, думаю, они всё равно видят, какая у меня вымученная улыбка."

# ch/harems/home/events/home_harem_common.rpy:3075
translate russian lexi_sasha_propose_male_2bab2ee4:
    "Девушки окружают меня, пытаясь утешить."

# ch/harems/home/events/home_harem_common.rpy:3076
translate russian lexi_sasha_propose_male_7e318ae2:
    "Конечно, это не значит, что нашим отношениям конец."

# ch/harems/home/events/home_harem_common.rpy:3077
translate russian lexi_sasha_propose_male_5a4285b7:
    "Хотя я невольно задумываюсь, надолго ли их хватит..."

# ch/harems/home/events/home_harem_common.rpy:3079
translate russian lexi_sasha_propose_male_6b2ddf73:
    "Я перевожу взгляд с одной на другую."

# ch/harems/home/events/home_harem_common.rpy:3080
translate russian lexi_sasha_propose_male_206cd91d:
    "Некоторые девушки сияют при мысли о браке."

# ch/harems/home/events/home_harem_common.rpy:3081
translate russian lexi_sasha_propose_male_703aed18:
    "Но остальные выглядят скорее удивлёнными, даже встревоженными."

# ch/harems/home/events/home_harem_common.rpy:3083
translate russian lexi_sasha_propose_male_ec6df227:
    mike.say "Некоторые из вас не хотят за меня замуж."

# ch/harems/home/events/home_harem_common.rpy:3084
translate russian lexi_sasha_propose_male_81ac129a:
    mike.say "А некоторые хотят..."

# ch/harems/home/events/home_harem_common.rpy:3085
translate russian lexi_sasha_propose_male_c51f0ec0:
    "Внезапно те, кто сказал «да», делают шаг вперёд."

# ch/harems/home/events/home_harem_common.rpy:3086
translate russian lexi_sasha_propose_male_742e811c:
    "Может, пытаются меня поддержать."

# ch/harems/home/events/home_harem_common.rpy:3087
translate russian lexi_sasha_propose_male_78cf2006:
    "А может, хотят отделиться от тех, кто отказался."

# ch/harems/home/events/home_harem_common.rpy:3089
translate russian lexi_sasha_propose_male_455b671a:
    sasha.say "Я хочу выйти за тебя!"

# ch/harems/home/events/home_harem_common.rpy:3091
translate russian lexi_sasha_propose_male_e9e61615:
    lexi.say "Ещё бы!"

# ch/harems/home/events/home_harem_common.rpy:3092
