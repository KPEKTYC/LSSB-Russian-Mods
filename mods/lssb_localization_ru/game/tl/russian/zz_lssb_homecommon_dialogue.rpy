# ch/harems/home/events/home_harem_common.rpy:1770
translate russian bree_lexi_minami_propose_male_f1818e52:
    lexi.say "Ты не можешь жениться на нас всех."

# ch/harems/home/events/home_harem_common.rpy:1771
translate russian bree_lexi_minami_propose_male_7d6eb3a3:
    lexi.say "Это слишком дико даже для меня!"

# ch/harems/home/events/home_harem_common.rpy:1775
translate russian bree_lexi_minami_propose_male_d92387ba:
    lexi.say "Мы все поженимся?!?"

# ch/harems/home/events/home_harem_common.rpy:1777
translate russian bree_lexi_minami_propose_male_1a2a740c:
    lexi.say "Безумие! Я за!"

# ch/harems/home/events/home_harem_common.rpy:1779
translate russian bree_lexi_minami_propose_male_d486019f:
    "Наверное, отвечать на такой вопрос было для девушек потрясением."

# ch/harems/home/events/home_harem_common.rpy:1780
translate russian bree_lexi_minami_propose_male_125efa08:
    "Потому что слушать их ответы для меня точно было именно им."

# ch/harems/home/events/home_harem_common.rpy:1781
translate russian bree_lexi_minami_propose_male_425a8e8a:
    "Мне даже требуется время, чтобы осознать сказанное."

# ch/harems/home/events/home_harem_common.rpy:1783
translate russian bree_lexi_minami_propose_male_227f57cb:
    mike.say "В... вы все сказали «да»?"

# ch/harems/home/events/home_harem_common.rpy:1784
translate russian bree_lexi_minami_propose_male_eb2f3acc:
    mike.say "Вы правда все хотите выйти за меня?!?"

# ch/harems/home/events/home_harem_common.rpy:1785
translate russian bree_lexi_minami_propose_male_34836f21:
    "Второй вопрос вызывает уже смесь веселья и раздражения."

# ch/harems/home/events/home_harem_common.rpy:1786
translate russian bree_lexi_minami_propose_male_bb695139:
    "Девушки качают головами и закатывают глаза."

# ch/harems/home/events/home_harem_common.rpy:1787
translate russian bree_lexi_minami_propose_male_8ee84750:
    bree.say "Ох, [lssb_common.hero_name()]!"

# ch/harems/home/events/home_harem_common.rpy:1788
translate russian bree_lexi_minami_propose_male_5645b33c:
    minami.say "Братик!"

# ch/harems/home/events/home_harem_common.rpy:1789
translate russian bree_lexi_minami_propose_male_729d3902:
    lexi.say "Господи, тебе бы уши прочистить!"

# ch/harems/home/events/home_harem_common.rpy:1790
translate russian bree_lexi_minami_propose_male_b654f57d:
    mike.say "Так вы согласились?"

# ch/harems/home/events/home_harem_common.rpy:1791
translate russian bree_lexi_minami_propose_male_5002d2ca:
    mike.say "Вы правда сказали «да»?"

# ch/harems/home/events/home_harem_common.rpy:1792
translate russian bree_lexi_minami_propose_male_bb5f3b86:
    "На этот раз мне отвечают кивками и улыбками."

# ch/harems/home/events/home_harem_common.rpy:1793
translate russian bree_lexi_minami_propose_male_2f44f8f9:
    "Наверное, так даже лучше."

# ch/harems/home/events/home_harem_common.rpy:1794
translate russian bree_lexi_minami_propose_male_883fc300:
    "Потому что я вряд ли способен связать хоть одно предложение."

# ch/harems/home/events/home_harem_common.rpy:1795
translate russian bree_lexi_minami_propose_male_c8a79701:
    "Слишком взволнован для этого!"

# ch/harems/home/events/home_harem_common.rpy:1797
translate russian bree_lexi_minami_propose_male_779ec8f7:
    "Будто меня ударили под дых."

# ch/harems/home/events/home_harem_common.rpy:1798
translate russian bree_lexi_minami_propose_male_9e749a81:
    "И ударили от всей души!"

# ch/harems/home/events/home_harem_common.rpy:1799
translate russian bree_lexi_minami_propose_male_10b9d28e:
    "Я что, только что превратился из самого везучего парня на свете в самого жалкого?"

# ch/harems/home/events/home_harem_common.rpy:1800
translate russian bree_lexi_minami_propose_male_f689953d:
    "Не могу поверить, что ВСЕ отказались!"

# ch/harems/home/events/home_harem_common.rpy:1801
translate russian bree_lexi_minami_propose_male_a563545f:
    mike.say "В... вы все сказали «нет»..."

# ch/harems/home/events/home_harem_common.rpy:1802
translate russian bree_lexi_minami_propose_male_146d6225:
    mike.say "Ни одна не хочет замуж?!?"

# ch/harems/home/events/home_harem_common.rpy:1803
translate russian bree_lexi_minami_propose_male_f861d3cc:
    "Девушки снова переглядываются."

# ch/harems/home/events/home_harem_common.rpy:1804
translate russian bree_lexi_minami_propose_male_bea9b5af:
    "Но на этот раз выглядят изрядно виноватыми."

# ch/harems/home/events/home_harem_common.rpy:1805
translate russian bree_lexi_minami_propose_male_0f1f5d7a:
    "Наверное, хоть это должно меня немного утешить!"

# ch/harems/home/events/home_harem_common.rpy:1806
translate russian bree_lexi_minami_propose_male_09cb3f79:
    bree.say "Прости, [lssb_common.hero_name()], я просто не могу."

# ch/harems/home/events/home_harem_common.rpy:1807
translate russian bree_lexi_minami_propose_male_f959fe9b:
    minami.say "Мне ещё рано замуж, братик!"

# ch/harems/home/events/home_harem_common.rpy:1808
translate russian bree_lexi_minami_propose_male_8586b455:
    lexi.say "Я — замуж? Ты серьёзно?"

# ch/harems/home/events/home_harem_common.rpy:1809
translate russian bree_lexi_minami_propose_male_f9bc4df9:
    "Мне остаётся лишь кивнуть и сделать бодрый вид."

# ch/harems/home/events/home_harem_common.rpy:1810
translate russian bree_lexi_minami_propose_male_817c1ad4:
    "Но, думаю, они всё равно видят, какая у меня вымученная улыбка."

# ch/harems/home/events/home_harem_common.rpy:1811
translate russian bree_lexi_minami_propose_male_2bab2ee4:
    "Девушки окружают меня, пытаясь утешить."

# ch/harems/home/events/home_harem_common.rpy:1812
translate russian bree_lexi_minami_propose_male_7e318ae2:
    "Конечно, это не значит, что нашим отношениям конец."

# ch/harems/home/events/home_harem_common.rpy:1813
translate russian bree_lexi_minami_propose_male_5a4285b7:
    "Хотя я невольно задумываюсь, надолго ли их хватит..."

# ch/harems/home/events/home_harem_common.rpy:1815
translate russian bree_lexi_minami_propose_male_6b2ddf73:
    "Я перевожу взгляд с одной на другую."

# ch/harems/home/events/home_harem_common.rpy:1816
translate russian bree_lexi_minami_propose_male_206cd91d:
    "Некоторые девушки сияют при мысли о браке."

# ch/harems/home/events/home_harem_common.rpy:1817
translate russian bree_lexi_minami_propose_male_703aed18:
    "Но остальные выглядят скорее удивлёнными, даже встревоженными."

# ch/harems/home/events/home_harem_common.rpy:1819
translate russian bree_lexi_minami_propose_male_ec6df227:
    mike.say "Некоторые из вас не хотят за меня замуж."

# ch/harems/home/events/home_harem_common.rpy:1820
translate russian bree_lexi_minami_propose_male_81ac129a:
    mike.say "А некоторые хотят..."

# ch/harems/home/events/home_harem_common.rpy:1821
translate russian bree_lexi_minami_propose_male_c51f0ec0:
    "Внезапно те, кто сказал «да», делают шаг вперёд."

# ch/harems/home/events/home_harem_common.rpy:1822
translate russian bree_lexi_minami_propose_male_742e811c:
    "Может, пытаются меня поддержать."

# ch/harems/home/events/home_harem_common.rpy:1823
translate russian bree_lexi_minami_propose_male_78cf2006:
    "А может, хотят отделиться от тех, кто отказался."

# ch/harems/home/events/home_harem_common.rpy:1825
translate russian bree_lexi_minami_propose_male_eb23d63f:
    bree.say "Я хочу, [lssb_common.hero_name()]."

# ch/harems/home/events/home_harem_common.rpy:1827
translate russian bree_lexi_minami_propose_male_1b8f05f3:
    minami.say "Я с вами, братик!"

# ch/harems/home/events/home_harem_common.rpy:1829
translate russian bree_lexi_minami_propose_male_e9e61615:
    lexi.say "Ещё бы!"

# ch/harems/home/events/home_harem_common.rpy:1830
translate russian bree_lexi_minami_propose_male_11666f8c:
    "Я невольно улыбаюсь, когда девушки подходят."

# ch/harems/home/events/home_harem_common.rpy:1831
translate russian bree_lexi_minami_propose_male_6e81ac35:
    "Мы собираемся тесным кружком, обнимаемся и прижимаемся друг к другу."

# ch/harems/home/events/home_harem_common.rpy:1832
translate russian bree_lexi_minami_propose_male_3f99fbdd:
    "Но тут я замечаю тех, кто сказал «нет»."

# ch/harems/home/events/home_harem_common.rpy:1833
translate russian bree_lexi_minami_propose_male_e26aae2f:
    "Теперь они выглядят одинокими и отвергнутыми."

# ch/harems/home/events/home_harem_common.rpy:1834
translate russian bree_lexi_minami_propose_male_f581a8fe:
    "В животе неприятно сжимается от тревоги."

# ch/harems/home/events/home_harem_common.rpy:1835
translate russian bree_lexi_minami_propose_male_bcb879fe:
    "Потому что я понятия не имею, что всё это значит для них..."

# ch/harems/home/events/home_harem_common.rpy:1839
translate russian lexi_minami_sasha_propose_male_d12fa97f:
    "Я знаю, что постоянно твержу, как невероятно здорово встречаться со своими соседками."

# ch/harems/home/events/home_harem_common.rpy:1840
translate russian lexi_minami_sasha_propose_male_f4c7dc45:
    "Но вам придётся привыкнуть слышать от меня именно это."

# ch/harems/home/events/home_harem_common.rpy:1841
translate russian lexi_minami_sasha_propose_male_a4798f50:
    "Может, когда-нибудь я свыкнусь с мыслью, и всё перестанет казаться таким невероятным."

# ch/harems/home/events/home_harem_common.rpy:1842
translate russian lexi_minami_sasha_propose_male_c28f260d:
    "А может, никогда не перестану просыпаться с мыслью, что я самый везучий парень на свете!"

# ch/harems/home/events/home_harem_common.rpy:1843
translate russian lexi_minami_sasha_propose_male_ba5cba67:
    "Как бы то ни было, сейчас у нас всё, кажется, хорошо."

# ch/harems/home/events/home_harem_common.rpy:1844
translate russian lexi_minami_sasha_propose_male_fe83386f:
    "Все прекрасно ладят, и нам чертовски весело вместе."

# ch/harems/home/events/home_harem_common.rpy:1845
translate russian lexi_minami_sasha_propose_male_3ebd0417:
    "Наверное, вы думаете, что я просто оставлю всё как есть."

# ch/harems/home/events/home_harem_common.rpy:1846
translate russian lexi_minami_sasha_propose_male_50850d3f:
    "Ну зачем менять то, что и так прекрасно работает?"

# ch/harems/home/events/home_harem_common.rpy:1847
translate russian lexi_minami_sasha_propose_male_253819c0:
    "Может, мне хочется сделать наш союз чуть более... постоянным?"

# ch/harems/home/events/home_harem_common.rpy:1848
translate russian lexi_minami_sasha_propose_male_2926a04a:
    "Именно так: я собираюсь предложить девушкам выйти за меня."

# ch/harems/home/events/home_harem_common.rpy:1849
translate russian lexi_minami_sasha_propose_male_6830c77d:
    "Для меня вполне естественно официально оформить наши отношения и связать себя обязательствами друг перед другом."

# ch/harems/home/events/home_harem_common.rpy:1850
translate russian lexi_minami_sasha_propose_male_39bfd812:
    "И я рассчитываю, что девушки чувствуют то же самое."

# ch/harems/home/events/home_harem_common.rpy:1855
translate russian lexi_minami_sasha_propose_male_544dfb05:
    "Поэтому, едва мы собираемся вместе и возникает подходящий момент, я делаю предложение."

# ch/harems/home/events/home_harem_common.rpy:1856
translate russian lexi_minami_sasha_propose_male_b5e79ef7:
    mike.say "Эм, девушки..."

# ch/harems/home/events/home_harem_common.rpy:1857
translate russian lexi_minami_sasha_propose_male_6e2c40cc:
    mike.say "Я хотел кое-что у вас спросить..."

# ch/harems/home/events/home_harem_common.rpy:1861
translate russian lexi_minami_sasha_propose_male_037884f3:
    "Внезапно они разом поворачивают головы."

# ch/harems/home/events/home_harem_common.rpy:1862
translate russian lexi_minami_sasha_propose_male_d677a5fb:
    "И все взгляды устремляются на меня!"

# ch/harems/home/events/home_harem_common.rpy:1863
translate russian lexi_minami_sasha_propose_male_6b34c856:
    "Чёрт, я думал, это будет гораздо проще."

# ch/harems/home/events/home_harem_common.rpy:1864
translate russian lexi_minami_sasha_propose_male_72ab6ec8:
    "Будто мне заглядывают прямо в душу!"

# ch/harems/home/events/home_harem_common.rpy:1865
translate russian lexi_minami_sasha_propose_male_b2d42e7f:
    mike.say "Наверное, надо сделать всё как положено!"

# ch/harems/home/events/home_harem_common.rpy:1866
translate russian lexi_minami_sasha_propose_male_489353ba:
    "Я опускаюсь на одно колено прямо перед девушками."

# ch/harems/home/events/home_harem_common.rpy:1867
translate russian lexi_minami_sasha_propose_male_82444d9a:
    "Это вызывает у них целую бурю разных чувств."

# ch/harems/home/events/home_harem_common.rpy:1868
translate russian lexi_minami_sasha_propose_male_bdc64184:
    "Только что они были растеряны, а теперь поражены."

# ch/harems/home/events/home_harem_common.rpy:1869
translate russian lexi_minami_sasha_propose_male_65be5ac1:
    "Может, так и должно быть?"

# ch/harems/home/events/home_harem_common.rpy:1870
translate russian lexi_minami_sasha_propose_male_20bfe615:
    mike.say "Вы..."

# ch/harems/home/events/home_harem_common.rpy:1875
translate russian lexi_minami_sasha_propose_male_5b9cb14f:
    mike.say "Вы все выйдете за меня?"

# ch/harems/home/events/home_harem_common.rpy:1876
translate russian lexi_minami_sasha_propose_male_2762a534:
    mike.say "И, наверное, друг за друга тоже?"

# ch/harems/home/events/home_harem_common.rpy:1877
translate russian lexi_minami_sasha_propose_male_05917d0c:
    "Ответ не заставляет себя ждать..."

# ch/harems/home/events/home_harem_common.rpy:1881
translate russian lexi_minami_sasha_propose_male_1d0ac3f1:
    sasha.say "Ты с ума сошёл?!?"

# ch/harems/home/events/home_harem_common.rpy:1882
translate russian lexi_minami_sasha_propose_male_50345858:
    sasha.say "Я ввязалась в это не ради замужества!"

# ch/harems/home/events/home_harem_common.rpy:1886
translate russian lexi_minami_sasha_propose_male_929380d1:
    sasha.say "Ого, вот это неожиданность!"

# ch/harems/home/events/home_harem_common.rpy:1888
translate russian lexi_minami_sasha_propose_male_0ea27362:
    sasha.say "Но да, я согласна!"

# ch/harems/home/events/home_harem_common.rpy:1892
translate russian lexi_minami_sasha_propose_male_e0013cb0:
    minami.say "Братик, ты что, спятил?"

# ch/harems/home/events/home_harem_common.rpy:1893
translate russian lexi_minami_sasha_propose_male_0d916f0d:
    minami.say "Я не могу выйти замуж за всех!"

# ch/harems/home/events/home_harem_common.rpy:1897
translate russian lexi_minami_sasha_propose_male_96febd99:
    minami.say "Братик, ты лучший!"

# ch/harems/home/events/home_harem_common.rpy:1899
translate russian lexi_minami_sasha_propose_male_c062a39d:
    minami.say "Да... да... да!"

# ch/harems/home/events/home_harem_common.rpy:1903
translate russian lexi_minami_sasha_propose_male_f1818e52:
    lexi.say "Ты не можешь жениться на нас всех."

# ch/harems/home/events/home_harem_common.rpy:1904
translate russian lexi_minami_sasha_propose_male_7d6eb3a3:
    lexi.say "Это слишком дико даже для меня!"

# ch/harems/home/events/home_harem_common.rpy:1908
translate russian lexi_minami_sasha_propose_male_d92387ba:
    lexi.say "Мы все поженимся?!?"

# ch/harems/home/events/home_harem_common.rpy:1910
translate russian lexi_minami_sasha_propose_male_1a2a740c:
    lexi.say "Безумие! Я за!"

# ch/harems/home/events/home_harem_common.rpy:1912
translate russian lexi_minami_sasha_propose_male_d486019f:
    "Наверное, отвечать на такой вопрос было для девушек потрясением."

# ch/harems/home/events/home_harem_common.rpy:1913
translate russian lexi_minami_sasha_propose_male_125efa08:
    "Потому что слушать их ответы для меня точно было именно им."

# ch/harems/home/events/home_harem_common.rpy:1914
translate russian lexi_minami_sasha_propose_male_425a8e8a:
    "Мне даже требуется время, чтобы осознать сказанное."

# ch/harems/home/events/home_harem_common.rpy:1916
translate russian lexi_minami_sasha_propose_male_227f57cb:
    mike.say "В... вы все сказали «да»?"

# ch/harems/home/events/home_harem_common.rpy:1917
translate russian lexi_minami_sasha_propose_male_eb2f3acc:
    mike.say "Вы правда все хотите выйти за меня?!?"

# ch/harems/home/events/home_harem_common.rpy:1918
translate russian lexi_minami_sasha_propose_male_34836f21:
    "Второй вопрос вызывает уже смесь веселья и раздражения."

# ch/harems/home/events/home_harem_common.rpy:1919
translate russian lexi_minami_sasha_propose_male_bb695139:
    "Девушки качают головами и закатывают глаза."

# ch/harems/home/events/home_harem_common.rpy:1920
translate russian lexi_minami_sasha_propose_male_718fc05f:
    sasha.say "Серьёзно, ты оглох, что ли?"

# ch/harems/home/events/home_harem_common.rpy:1921
translate russian lexi_minami_sasha_propose_male_5645b33c:
    minami.say "Братик!"

# ch/harems/home/events/home_harem_common.rpy:1922
translate russian lexi_minami_sasha_propose_male_729d3902:
    lexi.say "Господи, тебе бы уши прочистить!"

# ch/harems/home/events/home_harem_common.rpy:1923
translate russian lexi_minami_sasha_propose_male_b654f57d:
    mike.say "Так вы согласились?"

# ch/harems/home/events/home_harem_common.rpy:1924
translate russian lexi_minami_sasha_propose_male_5002d2ca:
    mike.say "Вы правда сказали «да»?"

# ch/harems/home/events/home_harem_common.rpy:1925
translate russian lexi_minami_sasha_propose_male_bb5f3b86:
    "На этот раз мне отвечают кивками и улыбками."

# ch/harems/home/events/home_harem_common.rpy:1926
translate russian lexi_minami_sasha_propose_male_2f44f8f9:
    "Наверное, так даже лучше."

# ch/harems/home/events/home_harem_common.rpy:1927
translate russian lexi_minami_sasha_propose_male_883fc300:
    "Потому что я вряд ли способен связать хоть одно предложение."

# ch/harems/home/events/home_harem_common.rpy:1928
translate russian lexi_minami_sasha_propose_male_c8a79701:
    "Слишком взволнован для этого!"

# ch/harems/home/events/home_harem_common.rpy:1930
translate russian lexi_minami_sasha_propose_male_779ec8f7:
