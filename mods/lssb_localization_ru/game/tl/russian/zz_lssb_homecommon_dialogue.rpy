# ch/harems/home/events/home_harem_common.rpy:2147
translate russian bree_minami_samantha_propose_male_ad792691:
    bree.say "Как это вообще возможно?"

# ch/harems/home/events/home_harem_common.rpy:2151
translate russian bree_minami_samantha_propose_male_98a82c66:
    bree.say "[lssb_common.hero_name()], ты серьёзно?!?"

# ch/harems/home/events/home_harem_common.rpy:2153
translate russian bree_minami_samantha_propose_male_544c560d:
    bree.say "Конечно выйду!"

# ch/harems/home/events/home_harem_common.rpy:2157
translate russian bree_minami_samantha_propose_male_e0013cb0:
