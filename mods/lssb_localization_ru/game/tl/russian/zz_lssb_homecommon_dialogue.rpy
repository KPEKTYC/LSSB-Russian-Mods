# ch/harems/home/events/home_harem_common.rpy:1310
translate russian lexi_minami_samantha_propose_male_50850d3f:
    "Ну зачем менять то, что и так прекрасно работает?"

# ch/harems/home/events/home_harem_common.rpy:1311
translate russian lexi_minami_samantha_propose_male_253819c0:
    "Может, мне хочется сделать наш союз чуть более... постоянным?"

# ch/harems/home/events/home_harem_common.rpy:1312
translate russian lexi_minami_samantha_propose_male_2926a04a:
    "Именно так: я собираюсь предложить девушкам выйти за меня."

# ch/harems/home/events/home_harem_common.rpy:1313
translate russian lexi_minami_samantha_propose_male_6830c77d:
    "Для меня вполне естественно официально оформить наши отношения и связать себя обязательствами друг перед другом."

# ch/harems/home/events/home_harem_common.rpy:1314
translate russian lexi_minami_samantha_propose_male_39bfd812:
    "И я рассчитываю, что девушки чувствуют то же самое."

# ch/harems/home/events/home_harem_common.rpy:1315
translate russian lexi_minami_samantha_propose_male_544dfb05:
    "Поэтому, едва мы собираемся вместе и возникает подходящий момент, я делаю предложение."

# ch/harems/home/events/home_harem_common.rpy:1320
translate russian lexi_minami_samantha_propose_male_b5e79ef7:
    mike.say "Эм, девушки..."

# ch/harems/home/events/home_harem_common.rpy:1321
translate russian lexi_minami_samantha_propose_male_6e2c40cc:
    mike.say "Я хотел кое-что у вас спросить..."

# ch/harems/home/events/home_harem_common.rpy:1325
translate russian lexi_minami_samantha_propose_male_037884f3:
    "Внезапно они разом поворачивают головы."

# ch/harems/home/events/home_harem_common.rpy:1326
translate russian lexi_minami_samantha_propose_male_d677a5fb:
    "И все взгляды устремляются на меня!"

# ch/harems/home/events/home_harem_common.rpy:1327
translate russian lexi_minami_samantha_propose_male_6b34c856:
    "Чёрт, я думал, это будет гораздо проще."

# ch/harems/home/events/home_harem_common.rpy:1328
translate russian lexi_minami_samantha_propose_male_72ab6ec8:
    "Будто мне заглядывают прямо в душу!"

# ch/harems/home/events/home_harem_common.rpy:1329
translate russian lexi_minami_samantha_propose_male_b2d42e7f:
    mike.say "Наверное, надо сделать всё как положено!"

# ch/harems/home/events/home_harem_common.rpy:1330
translate russian lexi_minami_samantha_propose_male_489353ba:
    "Я опускаюсь на одно колено прямо перед девушками."

# ch/harems/home/events/home_harem_common.rpy:1331
translate russian lexi_minami_samantha_propose_male_82444d9a:
    "Это вызывает у них целую бурю разных чувств."

# ch/harems/home/events/home_harem_common.rpy:1332
translate russian lexi_minami_samantha_propose_male_bdc64184:
    "Только что они были растеряны, а теперь поражены."

# ch/harems/home/events/home_harem_common.rpy:1333
translate russian lexi_minami_samantha_propose_male_65be5ac1:
    "Может, так и должно быть?"

# ch/harems/home/events/home_harem_common.rpy:1334
translate russian lexi_minami_samantha_propose_male_20bfe615:
    mike.say "Вы..."

# ch/harems/home/events/home_harem_common.rpy:1339
translate russian lexi_minami_samantha_propose_male_5b9cb14f:
    mike.say "Вы все выйдете за меня?"

# ch/harems/home/events/home_harem_common.rpy:1340
translate russian lexi_minami_samantha_propose_male_2762a534:
    mike.say "И, наверное, друг за друга тоже?"

# ch/harems/home/events/home_harem_common.rpy:1341
translate russian lexi_minami_samantha_propose_male_05917d0c:
    "Ответ не заставляет себя ждать..."

# ch/harems/home/events/home_harem_common.rpy:1344
translate russian lexi_minami_samantha_propose_male_f1818e52:
    lexi.say "Ты не можешь жениться на нас всех."

# ch/harems/home/events/home_harem_common.rpy:1345
translate russian lexi_minami_samantha_propose_male_7d6eb3a3:
    lexi.say "Это слишком дико даже для меня!"

# ch/harems/home/events/home_harem_common.rpy:1349
translate russian lexi_minami_samantha_propose_male_d92387ba:
    lexi.say "Мы все поженимся?!?"

# ch/harems/home/events/home_harem_common.rpy:1351
translate russian lexi_minami_samantha_propose_male_1a2a740c:
    lexi.say "Безумие! Я за!"

# ch/harems/home/events/home_harem_common.rpy:1355
translate russian lexi_minami_samantha_propose_male_e0013cb0:
    minami.say "Братик, ты что, спятил?"

# ch/harems/home/events/home_harem_common.rpy:1356
translate russian lexi_minami_samantha_propose_male_0d916f0d:
    minami.say "Я не могу выйти замуж за всех!"

# ch/harems/home/events/home_harem_common.rpy:1360
translate russian lexi_minami_samantha_propose_male_96febd99:
    minami.say "Братик, ты лучший!"

# ch/harems/home/events/home_harem_common.rpy:1362
translate russian lexi_minami_samantha_propose_male_c062a39d:
    minami.say "Да... да... да!"

# ch/harems/home/events/home_harem_common.rpy:1366
translate russian lexi_minami_samantha_propose_male_aae81039:
    samantha.say "Ого, [lssb_common.hero_name()], я уже один раз обожглась."

# ch/harems/home/events/home_harem_common.rpy:1367
translate russian lexi_minami_samantha_propose_male_5522daba:
    samantha.say "И это всего с одним супругом!"

# ch/harems/home/events/home_harem_common.rpy:1368
translate russian lexi_minami_samantha_propose_male_7509a9b6:
    samantha.say "Без меня."

# ch/harems/home/events/home_harem_common.rpy:1372
translate russian lexi_minami_samantha_propose_male_e2b5ab24:
    samantha.say "Ну, в первый раз я обожглась."

# ch/harems/home/events/home_harem_common.rpy:1373
translate russian lexi_minami_samantha_propose_male_9bb3104c:
    samantha.say "Но то было тогда, а это сейчас."

# ch/harems/home/events/home_harem_common.rpy:1375
translate russian lexi_minami_samantha_propose_male_5692bf05:
    samantha.say "Так что да, я согласна!"

# ch/harems/home/events/home_harem_common.rpy:1377
translate russian lexi_minami_samantha_propose_male_d486019f:
    "Наверное, отвечать на такой вопрос было для девушек потрясением."

# ch/harems/home/events/home_harem_common.rpy:1378
translate russian lexi_minami_samantha_propose_male_125efa08:
    "Потому что слушать их ответы для меня точно было именно им."

# ch/harems/home/events/home_harem_common.rpy:1379
translate russian lexi_minami_samantha_propose_male_425a8e8a:
    "Мне даже требуется время, чтобы осознать сказанное."

# ch/harems/home/events/home_harem_common.rpy:1381
translate russian lexi_minami_samantha_propose_male_227f57cb:
    mike.say "В... вы все сказали «да»?"

# ch/harems/home/events/home_harem_common.rpy:1382
translate russian lexi_minami_samantha_propose_male_eb2f3acc:
    mike.say "Вы правда все хотите выйти за меня?!?"

# ch/harems/home/events/home_harem_common.rpy:1383
translate russian lexi_minami_samantha_propose_male_34836f21:
    "Второй вопрос вызывает уже смесь веселья и раздражения."

# ch/harems/home/events/home_harem_common.rpy:1384
translate russian lexi_minami_samantha_propose_male_bb695139:
    "Девушки качают головами и закатывают глаза."

# ch/harems/home/events/home_harem_common.rpy:1385
translate russian lexi_minami_samantha_propose_male_5645b33c:
    minami.say "Братик!"

# ch/harems/home/events/home_harem_common.rpy:1386
translate russian lexi_minami_samantha_propose_male_863a8021:
