translate russian bree_lexi_samantha_propose_male_d486019f:
    "Наверное, отвечать на такой вопрос было для девушек потрясением."

# ch/harems/home/events/home_harem_common.rpy:1512
translate russian bree_lexi_samantha_propose_male_125efa08:
    "Потому что слушать их ответы для меня точно было именно им."

# ch/harems/home/events/home_harem_common.rpy:1513
translate russian bree_lexi_samantha_propose_male_425a8e8a:
