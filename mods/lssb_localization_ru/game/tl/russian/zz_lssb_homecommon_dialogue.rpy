    mike.say "Вы..."

# ch/harems/home/events/home_harem_common.rpy:2791
translate russian lexi_minami_propose_male_5b9cb14f:
    mike.say "Вы все выйдете за меня?"

# ch/harems/home/events/home_harem_common.rpy:2792
translate russian lexi_minami_propose_male_2762a534:
    mike.say "И, наверное, друг за друга тоже?"

# ch/harems/home/events/home_harem_common.rpy:2793
translate russian lexi_minami_propose_male_05917d0c:
    "Ответ не заставляет себя ждать..."

