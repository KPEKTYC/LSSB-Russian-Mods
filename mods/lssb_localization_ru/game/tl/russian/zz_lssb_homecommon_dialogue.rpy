# ch/harems/home/events/home_harem_common.rpy:2584
translate russian bree_minami_sasha_propose_male_227f57cb:
    mike.say "В... вы все сказали «да»?"

# ch/harems/home/events/home_harem_common.rpy:2585
translate russian bree_minami_sasha_propose_male_eb2f3acc:
    mike.say "Вы правда все хотите выйти за меня?!?"

# ch/harems/home/events/home_harem_common.rpy:2586
translate russian bree_minami_sasha_propose_male_34836f21:
    "Второй вопрос вызывает уже смесь веселья и раздражения."

# ch/harems/home/events/home_harem_common.rpy:2587
translate russian bree_minami_sasha_propose_male_bb695139:
