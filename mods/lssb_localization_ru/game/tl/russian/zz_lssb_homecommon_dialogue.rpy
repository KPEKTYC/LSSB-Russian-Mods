# ch/harems/home/events/home_harem_common.rpy:1544
translate russian bree_lexi_samantha_propose_male_7e318ae2:
    "Конечно, это не значит, что нашим отношениям конец."

# ch/harems/home/events/home_harem_common.rpy:1545
translate russian bree_lexi_samantha_propose_male_5a4285b7:
    "Хотя я невольно задумываюсь, надолго ли их хватит..."

# ch/harems/home/events/home_harem_common.rpy:1547
translate russian bree_lexi_samantha_propose_male_6b2ddf73:
    "Я перевожу взгляд с одной на другую."

# ch/harems/home/events/home_harem_common.rpy:1548
translate russian bree_lexi_samantha_propose_male_206cd91d:
    "Некоторые девушки сияют при мысли о браке."

# ch/harems/home/events/home_harem_common.rpy:1549
translate russian bree_lexi_samantha_propose_male_703aed18:
    "Но остальные выглядят скорее удивлёнными, даже встревоженными."

# ch/harems/home/events/home_harem_common.rpy:1551
translate russian bree_lexi_samantha_propose_male_ec6df227:
    mike.say "Некоторые из вас не хотят за меня замуж."

# ch/harems/home/events/home_harem_common.rpy:1552
translate russian bree_lexi_samantha_propose_male_81ac129a:
