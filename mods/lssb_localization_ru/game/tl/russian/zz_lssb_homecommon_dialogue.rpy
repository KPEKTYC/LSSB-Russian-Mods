# ch/harems/home/events/home_harem_common.rpy:1602
translate russian lexi_samantha_sasha_propose_male_20bfe615:
    mike.say "Вы..."

# ch/harems/home/events/home_harem_common.rpy:1607
translate russian lexi_samantha_sasha_propose_male_5b9cb14f:
    mike.say "Вы все выйдете за меня?"

# ch/harems/home/events/home_harem_common.rpy:1608
translate russian lexi_samantha_sasha_propose_male_2762a534:
    mike.say "И, наверное, друг за друга тоже?"

# ch/harems/home/events/home_harem_common.rpy:1609
translate russian lexi_samantha_sasha_propose_male_05917d0c:
