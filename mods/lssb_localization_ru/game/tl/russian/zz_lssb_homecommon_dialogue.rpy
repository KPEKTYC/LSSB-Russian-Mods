# ch/harems/home/events/home_harem_common.rpy:2681
translate russian lexi_samantha_propose_male_7509a9b6:
    samantha.say "Без меня."

# ch/harems/home/events/home_harem_common.rpy:2685
translate russian lexi_samantha_propose_male_e2b5ab24:
    samantha.say "Ну, в первый раз я обожглась."

# ch/harems/home/events/home_harem_common.rpy:2686
translate russian lexi_samantha_propose_male_9bb3104c:
    samantha.say "Но то было тогда, а это сейчас."

# ch/harems/home/events/home_harem_common.rpy:2688
translate russian lexi_samantha_propose_male_5692bf05:
    samantha.say "Так что да, я согласна!"

# ch/harems/home/events/home_harem_common.rpy:2692
translate russian lexi_samantha_propose_male_f1818e52:
    lexi.say "Ты не можешь жениться на нас всех."

# ch/harems/home/events/home_harem_common.rpy:2693
translate russian lexi_samantha_propose_male_7d6eb3a3:
    lexi.say "Это слишком дико даже для меня!"

# ch/harems/home/events/home_harem_common.rpy:2697
translate russian lexi_samantha_propose_male_d92387ba:
    lexi.say "Мы все поженимся?!?"

# ch/harems/home/events/home_harem_common.rpy:2699
translate russian lexi_samantha_propose_male_1a2a740c:
    lexi.say "Безумие! Я за!"

# ch/harems/home/events/home_harem_common.rpy:2701
translate russian lexi_samantha_propose_male_d486019f:
    "Наверное, отвечать на такой вопрос было для девушек потрясением."

# ch/harems/home/events/home_harem_common.rpy:2702
translate russian lexi_samantha_propose_male_125efa08:
    "Потому что слушать их ответы для меня точно было именно им."

# ch/harems/home/events/home_harem_common.rpy:2703
translate russian lexi_samantha_propose_male_425a8e8a:
    "Мне даже требуется время, чтобы осознать сказанное."

# ch/harems/home/events/home_harem_common.rpy:2705
translate russian lexi_samantha_propose_male_227f57cb:
    mike.say "В... вы все сказали «да»?"

# ch/harems/home/events/home_harem_common.rpy:2706
translate russian lexi_samantha_propose_male_eb2f3acc:
    mike.say "Вы правда все хотите выйти за меня?!?"

# ch/harems/home/events/home_harem_common.rpy:2707
translate russian lexi_samantha_propose_male_34836f21:
    "Второй вопрос вызывает уже смесь веселья и раздражения."

# ch/harems/home/events/home_harem_common.rpy:2708
translate russian lexi_samantha_propose_male_bb695139:
    "Девушки качают головами и закатывают глаза."

# ch/harems/home/events/home_harem_common.rpy:2709
translate russian lexi_samantha_propose_male_863a8021:
    samantha.say "Как это на тебя похоже, [lssb_common.hero_name()], как похоже!"

# ch/harems/home/events/home_harem_common.rpy:2710
translate russian lexi_samantha_propose_male_729d3902:
    lexi.say "Господи, тебе бы уши прочистить!"

# ch/harems/home/events/home_harem_common.rpy:2711
translate russian lexi_samantha_propose_male_b654f57d:
    mike.say "Так вы согласились?"

# ch/harems/home/events/home_harem_common.rpy:2712
translate russian lexi_samantha_propose_male_5002d2ca:
    mike.say "Вы правда сказали «да»?"

# ch/harems/home/events/home_harem_common.rpy:2713
translate russian lexi_samantha_propose_male_bb5f3b86:
    "На этот раз мне отвечают кивками и улыбками."

# ch/harems/home/events/home_harem_common.rpy:2714
translate russian lexi_samantha_propose_male_2f44f8f9:
    "Наверное, так даже лучше."

# ch/harems/home/events/home_harem_common.rpy:2715
translate russian lexi_samantha_propose_male_883fc300:
    "Потому что я вряд ли способен связать хоть одно предложение."

# ch/harems/home/events/home_harem_common.rpy:2716
translate russian lexi_samantha_propose_male_c8a79701:
    "Слишком взволнован для этого!"

# ch/harems/home/events/home_harem_common.rpy:2718
translate russian lexi_samantha_propose_male_779ec8f7:
    "Будто меня ударили под дых."

# ch/harems/home/events/home_harem_common.rpy:2719
translate russian lexi_samantha_propose_male_9e749a81:
    "И ударили от всей души!"

# ch/harems/home/events/home_harem_common.rpy:2720
translate russian lexi_samantha_propose_male_10b9d28e:
    "Я что, только что превратился из самого везучего парня на свете в самого жалкого?"

# ch/harems/home/events/home_harem_common.rpy:2721
translate russian lexi_samantha_propose_male_f689953d:
    "Не могу поверить, что ВСЕ отказались!"

# ch/harems/home/events/home_harem_common.rpy:2722
translate russian lexi_samantha_propose_male_a563545f:
    mike.say "В... вы все сказали «нет»..."

# ch/harems/home/events/home_harem_common.rpy:2723
translate russian lexi_samantha_propose_male_146d6225:
    mike.say "Ни одна не хочет замуж?!?"

# ch/harems/home/events/home_harem_common.rpy:2724
translate russian lexi_samantha_propose_male_f861d3cc:
    "Девушки снова переглядываются."

# ch/harems/home/events/home_harem_common.rpy:2725
translate russian lexi_samantha_propose_male_bea9b5af:
    "Но на этот раз выглядят изрядно виноватыми."

# ch/harems/home/events/home_harem_common.rpy:2726
translate russian lexi_samantha_propose_male_0f1f5d7a:
    "Наверное, хоть это должно меня немного утешить!"

# ch/harems/home/events/home_harem_common.rpy:2728
translate russian lexi_samantha_propose_male_8ce01c64:
    samantha.say "Я не хочу повторять ту же ошибку."

# ch/harems/home/events/home_harem_common.rpy:2729
translate russian lexi_samantha_propose_male_8586b455:
    lexi.say "Я — замуж? Ты серьёзно?"

# ch/harems/home/events/home_harem_common.rpy:2730
translate russian lexi_samantha_propose_male_f9bc4df9:
    "Мне остаётся лишь кивнуть и сделать бодрый вид."

# ch/harems/home/events/home_harem_common.rpy:2731
translate russian lexi_samantha_propose_male_817c1ad4:
    "Но, думаю, они всё равно видят, какая у меня вымученная улыбка."

# ch/harems/home/events/home_harem_common.rpy:2732
translate russian lexi_samantha_propose_male_2bab2ee4:
    "Девушки окружают меня, пытаясь утешить."

# ch/harems/home/events/home_harem_common.rpy:2733
translate russian lexi_samantha_propose_male_7e318ae2:
    "Конечно, это не значит, что нашим отношениям конец."

# ch/harems/home/events/home_harem_common.rpy:2734
translate russian lexi_samantha_propose_male_5a4285b7:
    "Хотя я невольно задумываюсь, надолго ли их хватит..."

# ch/harems/home/events/home_harem_common.rpy:2736
translate russian lexi_samantha_propose_male_6b2ddf73:
    "Я перевожу взгляд с одной на другую."

# ch/harems/home/events/home_harem_common.rpy:2737
translate russian lexi_samantha_propose_male_206cd91d:
    "Некоторые девушки сияют при мысли о браке."

# ch/harems/home/events/home_harem_common.rpy:2738
translate russian lexi_samantha_propose_male_703aed18:
    "Но остальные выглядят скорее удивлёнными, даже встревоженными."

# ch/harems/home/events/home_harem_common.rpy:2740
translate russian lexi_samantha_propose_male_ec6df227:
    mike.say "Некоторые из вас не хотят за меня замуж."

# ch/harems/home/events/home_harem_common.rpy:2741
translate russian lexi_samantha_propose_male_81ac129a:
    mike.say "А некоторые хотят..."

# ch/harems/home/events/home_harem_common.rpy:2742
translate russian lexi_samantha_propose_male_c51f0ec0:
    "Внезапно те, кто сказал «да», делают шаг вперёд."

# ch/harems/home/events/home_harem_common.rpy:2743
translate russian lexi_samantha_propose_male_742e811c:
    "Может, пытаются меня поддержать."

# ch/harems/home/events/home_harem_common.rpy:2744
translate russian lexi_samantha_propose_male_78cf2006:
    "А может, хотят отделиться от тех, кто отказался."

# ch/harems/home/events/home_harem_common.rpy:2746
translate russian lexi_samantha_propose_male_098d5419:
    samantha.say "Мой ответ — да."

# ch/harems/home/events/home_harem_common.rpy:2748
translate russian lexi_samantha_propose_male_e9e61615:
    lexi.say "Ещё бы!"

# ch/harems/home/events/home_harem_common.rpy:2749
translate russian lexi_samantha_propose_male_11666f8c:
    "Я невольно улыбаюсь, когда девушки подходят."

# ch/harems/home/events/home_harem_common.rpy:2750
translate russian lexi_samantha_propose_male_6e81ac35:
    "Мы собираемся тесным кружком, обнимаемся и прижимаемся друг к другу."

# ch/harems/home/events/home_harem_common.rpy:2751
translate russian lexi_samantha_propose_male_3f99fbdd:
    "Но тут я замечаю тех, кто сказал «нет»."

# ch/harems/home/events/home_harem_common.rpy:2752
translate russian lexi_samantha_propose_male_e26aae2f:
    "Теперь они выглядят одинокими и отвергнутыми."

# ch/harems/home/events/home_harem_common.rpy:2753
translate russian lexi_samantha_propose_male_f581a8fe:
    "В животе неприятно сжимается от тревоги."

# ch/harems/home/events/home_harem_common.rpy:2754
translate russian lexi_samantha_propose_male_bcb879fe:
    "Потому что я понятия не имею, что всё это значит для них..."

# ch/harems/home/events/home_harem_common.rpy:2758
translate russian lexi_minami_propose_male_d12fa97f:
    "Я знаю, что постоянно твержу, как невероятно здорово встречаться со своими соседками."

# ch/harems/home/events/home_harem_common.rpy:2759
translate russian lexi_minami_propose_male_f4c7dc45:
    "Но вам придётся привыкнуть слышать от меня именно это."

# ch/harems/home/events/home_harem_common.rpy:2760
translate russian lexi_minami_propose_male_a4798f50:
    "Может, когда-нибудь я свыкнусь с мыслью, и всё перестанет казаться таким невероятным."

# ch/harems/home/events/home_harem_common.rpy:2761
translate russian lexi_minami_propose_male_c28f260d:
    "А может, никогда не перестану просыпаться с мыслью, что я самый везучий парень на свете!"

# ch/harems/home/events/home_harem_common.rpy:2762
translate russian lexi_minami_propose_male_ba5cba67:
    "Как бы то ни было, сейчас у нас всё, кажется, хорошо."

# ch/harems/home/events/home_harem_common.rpy:2763
translate russian lexi_minami_propose_male_fe83386f:
    "Все прекрасно ладят, и нам чертовски весело вместе."

# ch/harems/home/events/home_harem_common.rpy:2764
translate russian lexi_minami_propose_male_3ebd0417:
    "Наверное, вы думаете, что я просто оставлю всё как есть."

# ch/harems/home/events/home_harem_common.rpy:2765
translate russian lexi_minami_propose_male_50850d3f:
    "Ну зачем менять то, что и так прекрасно работает?"

# ch/harems/home/events/home_harem_common.rpy:2766
translate russian lexi_minami_propose_male_253819c0:
    "Может, мне хочется сделать наш союз чуть более... постоянным?"

# ch/harems/home/events/home_harem_common.rpy:2767
translate russian lexi_minami_propose_male_2926a04a:
    "Именно так: я собираюсь предложить девушкам выйти за меня."

# ch/harems/home/events/home_harem_common.rpy:2768
translate russian lexi_minami_propose_male_6830c77d:
    "Для меня вполне естественно официально оформить наши отношения и связать себя обязательствами друг перед другом."

# ch/harems/home/events/home_harem_common.rpy:2769
translate russian lexi_minami_propose_male_39bfd812:
    "И я рассчитываю, что девушки чувствуют то же самое."

# ch/harems/home/events/home_harem_common.rpy:2773
translate russian lexi_minami_propose_male_544dfb05:
    "Поэтому, едва мы собираемся вместе и возникает подходящий момент, я делаю предложение."

# ch/harems/home/events/home_harem_common.rpy:2774
translate russian lexi_minami_propose_male_b5e79ef7:
    mike.say "Эм, девушки..."

