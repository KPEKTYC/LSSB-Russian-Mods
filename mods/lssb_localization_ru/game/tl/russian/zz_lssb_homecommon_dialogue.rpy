# ch/harems/home/events/home_harem_common.rpy:3570
translate russian minami_sasha_propose_male_d12fa97f:
    "Я знаю, что постоянно твержу, как невероятно здорово встречаться со своими соседками."

# ch/harems/home/events/home_harem_common.rpy:3571
translate russian minami_sasha_propose_male_f4c7dc45:
    "Но вам придётся привыкнуть слышать от меня именно это."

# ch/harems/home/events/home_harem_common.rpy:3572
translate russian minami_sasha_propose_male_a4798f50:
    "Может, когда-нибудь я свыкнусь с мыслью, и всё перестанет казаться таким невероятным."

# ch/harems/home/events/home_harem_common.rpy:3573
translate russian minami_sasha_propose_male_c28f260d:
    "А может, никогда не перестану просыпаться с мыслью, что я самый везучий парень на свете!"

# ch/harems/home/events/home_harem_common.rpy:3574
translate russian minami_sasha_propose_male_ba5cba67:
    "Как бы то ни было, сейчас у нас всё, кажется, хорошо."

# ch/harems/home/events/home_harem_common.rpy:3575
translate russian minami_sasha_propose_male_fe83386f:
    "Все прекрасно ладят, и нам чертовски весело вместе."

# ch/harems/home/events/home_harem_common.rpy:3576
translate russian minami_sasha_propose_male_3ebd0417:
    "Наверное, вы думаете, что я просто оставлю всё как есть."

# ch/harems/home/events/home_harem_common.rpy:3577
translate russian minami_sasha_propose_male_50850d3f:
    "Ну зачем менять то, что и так прекрасно работает?"

# ch/harems/home/events/home_harem_common.rpy:3578
translate russian minami_sasha_propose_male_253819c0:
    "Может, мне хочется сделать наш союз чуть более... постоянным?"

# ch/harems/home/events/home_harem_common.rpy:3579
translate russian minami_sasha_propose_male_2926a04a:
    "Именно так: я собираюсь предложить девушкам выйти за меня."

# ch/harems/home/events/home_harem_common.rpy:3580
translate russian minami_sasha_propose_male_6830c77d:
    "Для меня вполне естественно официально оформить наши отношения и связать себя обязательствами друг перед другом."

# ch/harems/home/events/home_harem_common.rpy:3581
translate russian minami_sasha_propose_male_39bfd812:
    "И я рассчитываю, что девушки чувствуют то же самое."

# ch/harems/home/events/home_harem_common.rpy:3585
translate russian minami_sasha_propose_male_544dfb05:
    "Поэтому, едва мы собираемся вместе и возникает подходящий момент, я делаю предложение."

# ch/harems/home/events/home_harem_common.rpy:3586
translate russian minami_sasha_propose_male_b5e79ef7:
    mike.say "Эм, девушки..."

# ch/harems/home/events/home_harem_common.rpy:3587
translate russian minami_sasha_propose_male_6e2c40cc:
    mike.say "Я хотел кое-что у вас спросить..."

# ch/harems/home/events/home_harem_common.rpy:3590
translate russian minami_sasha_propose_male_037884f3:
    "Внезапно они разом поворачивают головы."

# ch/harems/home/events/home_harem_common.rpy:3591
translate russian minami_sasha_propose_male_d677a5fb:
    "И все взгляды устремляются на меня!"

# ch/harems/home/events/home_harem_common.rpy:3592
translate russian minami_sasha_propose_male_6b34c856:
    "Чёрт, я думал, это будет гораздо проще."

# ch/harems/home/events/home_harem_common.rpy:3593
translate russian minami_sasha_propose_male_72ab6ec8:
    "Будто мне заглядывают прямо в душу!"

# ch/harems/home/events/home_harem_common.rpy:3594
translate russian minami_sasha_propose_male_b2d42e7f:
    mike.say "Наверное, надо сделать всё как положено!"

# ch/harems/home/events/home_harem_common.rpy:3595
translate russian minami_sasha_propose_male_489353ba:
    "Я опускаюсь на одно колено прямо перед девушками."

# ch/harems/home/events/home_harem_common.rpy:3596
translate russian minami_sasha_propose_male_82444d9a:
    "Это вызывает у них целую бурю разных чувств."

# ch/harems/home/events/home_harem_common.rpy:3597
translate russian minami_sasha_propose_male_bdc64184:
    "Только что они были растеряны, а теперь поражены."

# ch/harems/home/events/home_harem_common.rpy:3598
translate russian minami_sasha_propose_male_65be5ac1:
    "Может, так и должно быть?"

# ch/harems/home/events/home_harem_common.rpy:3599
translate russian minami_sasha_propose_male_20bfe615:
    mike.say "Вы..."

# ch/harems/home/events/home_harem_common.rpy:3603
translate russian minami_sasha_propose_male_5b9cb14f:
    mike.say "Вы все выйдете за меня?"

# ch/harems/home/events/home_harem_common.rpy:3604
translate russian minami_sasha_propose_male_2762a534:
    mike.say "И, наверное, друг за друга тоже?"

# ch/harems/home/events/home_harem_common.rpy:3605
translate russian minami_sasha_propose_male_05917d0c:
    "Ответ не заставляет себя ждать..."

# ch/harems/home/events/home_harem_common.rpy:3609
translate russian minami_sasha_propose_male_1d0ac3f1:
    sasha.say "Ты с ума сошёл?!?"

# ch/harems/home/events/home_harem_common.rpy:3610
translate russian minami_sasha_propose_male_50345858:
    sasha.say "Я ввязалась в это не ради замужества!"

# ch/harems/home/events/home_harem_common.rpy:3614
translate russian minami_sasha_propose_male_929380d1:
    sasha.say "Ого, вот это неожиданность!"

# ch/harems/home/events/home_harem_common.rpy:3616
translate russian minami_sasha_propose_male_0ea27362:
    sasha.say "Но да, я согласна!"

# ch/harems/home/events/home_harem_common.rpy:3620
translate russian minami_sasha_propose_male_e0013cb0:
    minami.say "Братик, ты что, спятил?"

# ch/harems/home/events/home_harem_common.rpy:3621
translate russian minami_sasha_propose_male_0d916f0d:
    minami.say "Я не могу выйти замуж за всех!"

# ch/harems/home/events/home_harem_common.rpy:3625
translate russian minami_sasha_propose_male_96febd99:
    minami.say "Братик, ты лучший!"

# ch/harems/home/events/home_harem_common.rpy:3627
translate russian minami_sasha_propose_male_c062a39d:
    minami.say "Да... да... да!"

# ch/harems/home/events/home_harem_common.rpy:3629
translate russian minami_sasha_propose_male_d486019f:
    "Наверное, отвечать на такой вопрос было для девушек потрясением."

# ch/harems/home/events/home_harem_common.rpy:3630
translate russian minami_sasha_propose_male_125efa08:
    "Потому что слушать их ответы для меня точно было именно им."

# ch/harems/home/events/home_harem_common.rpy:3631
translate russian minami_sasha_propose_male_425a8e8a:
    "Мне даже требуется время, чтобы осознать сказанное."

# ch/harems/home/events/home_harem_common.rpy:3633
translate russian minami_sasha_propose_male_227f57cb:
    mike.say "В... вы все сказали «да»?"

# ch/harems/home/events/home_harem_common.rpy:3634
translate russian minami_sasha_propose_male_eb2f3acc:
    mike.say "Вы правда все хотите выйти за меня?!?"

# ch/harems/home/events/home_harem_common.rpy:3635
translate russian minami_sasha_propose_male_34836f21:
    "Второй вопрос вызывает уже смесь веселья и раздражения."

# ch/harems/home/events/home_harem_common.rpy:3636
translate russian minami_sasha_propose_male_bb695139:
    "Девушки качают головами и закатывают глаза."

# ch/harems/home/events/home_harem_common.rpy:3638
translate russian minami_sasha_propose_male_718fc05f:
    sasha.say "Серьёзно, ты оглох, что ли?"

# ch/harems/home/events/home_harem_common.rpy:3639
translate russian minami_sasha_propose_male_5645b33c:
    minami.say "Братик!"

# ch/harems/home/events/home_harem_common.rpy:3640
translate russian minami_sasha_propose_male_b654f57d:
    mike.say "Так вы согласились?"

# ch/harems/home/events/home_harem_common.rpy:3641
translate russian minami_sasha_propose_male_5002d2ca:
    mike.say "Вы правда сказали «да»?"

# ch/harems/home/events/home_harem_common.rpy:3642
translate russian minami_sasha_propose_male_bb5f3b86:
    "На этот раз мне отвечают кивками и улыбками."

# ch/harems/home/events/home_harem_common.rpy:3643
translate russian minami_sasha_propose_male_2f44f8f9:
    "Наверное, так даже лучше."

# ch/harems/home/events/home_harem_common.rpy:3644
translate russian minami_sasha_propose_male_883fc300:
    "Потому что я вряд ли способен связать хоть одно предложение."

# ch/harems/home/events/home_harem_common.rpy:3645
translate russian minami_sasha_propose_male_c8a79701:
    "Слишком взволнован для этого!"

# ch/harems/home/events/home_harem_common.rpy:3647
translate russian minami_sasha_propose_male_779ec8f7:
    "Будто меня ударили под дых."

# ch/harems/home/events/home_harem_common.rpy:3648
translate russian minami_sasha_propose_male_9e749a81:
    "И ударили от всей души!"

# ch/harems/home/events/home_harem_common.rpy:3649
translate russian minami_sasha_propose_male_10b9d28e:
    "Я что, только что превратился из самого везучего парня на свете в самого жалкого?"

# ch/harems/home/events/home_harem_common.rpy:3650
translate russian minami_sasha_propose_male_f689953d:
    "Не могу поверить, что ВСЕ отказались!"

# ch/harems/home/events/home_harem_common.rpy:3651
translate russian minami_sasha_propose_male_a563545f:
    mike.say "В... вы все сказали «нет»..."

# ch/harems/home/events/home_harem_common.rpy:3652
translate russian minami_sasha_propose_male_146d6225:
    mike.say "Ни одна не хочет замуж?!?"

# ch/harems/home/events/home_harem_common.rpy:3653
translate russian minami_sasha_propose_male_f861d3cc:
    "Девушки снова переглядываются."

# ch/harems/home/events/home_harem_common.rpy:3654
translate russian minami_sasha_propose_male_bea9b5af:
    "Но на этот раз выглядят изрядно виноватыми."

# ch/harems/home/events/home_harem_common.rpy:3655
translate russian minami_sasha_propose_male_0f1f5d7a:
    "Наверное, хоть это должно меня немного утешить!"

# ch/harems/home/events/home_harem_common.rpy:3657
translate russian minami_sasha_propose_male_a7dac4dd:
    sasha.say "Я не создана для брака, [lssb_common.hero_name()]!"

# ch/harems/home/events/home_harem_common.rpy:3658
translate russian minami_sasha_propose_male_f959fe9b:
    minami.say "Мне ещё рано замуж, братик!"

# ch/harems/home/events/home_harem_common.rpy:3659
translate russian minami_sasha_propose_male_f9bc4df9:
    "Мне остаётся лишь кивнуть и сделать бодрый вид."

# ch/harems/home/events/home_harem_common.rpy:3660
translate russian minami_sasha_propose_male_817c1ad4:
    "Но, думаю, они всё равно видят, какая у меня вымученная улыбка."

# ch/harems/home/events/home_harem_common.rpy:3661
translate russian minami_sasha_propose_male_2bab2ee4:
    "Девушки окружают меня, пытаясь утешить."

# ch/harems/home/events/home_harem_common.rpy:3662
translate russian minami_sasha_propose_male_7e318ae2:
    "Конечно, это не значит, что нашим отношениям конец."

# ch/harems/home/events/home_harem_common.rpy:3663
translate russian minami_sasha_propose_male_5a4285b7:
    "Хотя я невольно задумываюсь, надолго ли их хватит..."

# ch/harems/home/events/home_harem_common.rpy:3665
translate russian minami_sasha_propose_male_6b2ddf73:
    "Я перевожу взгляд с одной на другую."

# ch/harems/home/events/home_harem_common.rpy:3666
translate russian minami_sasha_propose_male_206cd91d:
    "Некоторые девушки сияют при мысли о браке."

# ch/harems/home/events/home_harem_common.rpy:3667
translate russian minami_sasha_propose_male_703aed18:
    "Но остальные выглядят скорее удивлёнными, даже встревоженными."

# ch/harems/home/events/home_harem_common.rpy:3669
translate russian minami_sasha_propose_male_ec6df227:
    mike.say "Некоторые из вас не хотят за меня замуж."

# ch/harems/home/events/home_harem_common.rpy:3670
translate russian minami_sasha_propose_male_81ac129a:
    mike.say "А некоторые хотят..."

# ch/harems/home/events/home_harem_common.rpy:3671
translate russian minami_sasha_propose_male_c51f0ec0:
    "Внезапно те, кто сказал «да», делают шаг вперёд."

# ch/harems/home/events/home_harem_common.rpy:3672
translate russian minami_sasha_propose_male_742e811c:
    "Может, пытаются меня поддержать."

# ch/harems/home/events/home_harem_common.rpy:3673
translate russian minami_sasha_propose_male_78cf2006:
    "А может, хотят отделиться от тех, кто отказался."

# ch/harems/home/events/home_harem_common.rpy:3676
translate russian minami_sasha_propose_male_455b671a:
    sasha.say "Я хочу выйти за тебя!"

# ch/harems/home/events/home_harem_common.rpy:3678
translate russian minami_sasha_propose_male_1b8f05f3:
    minami.say "Я с вами, братик!"

# ch/harems/home/events/home_harem_common.rpy:3680
translate russian minami_sasha_propose_male_11666f8c:
    "Я невольно улыбаюсь, когда девушки подходят."

# ch/harems/home/events/home_harem_common.rpy:3681
translate russian minami_sasha_propose_male_6e81ac35:
    "Мы собираемся тесным кружком, обнимаемся и прижимаемся друг к другу."

# ch/harems/home/events/home_harem_common.rpy:3682
translate russian minami_sasha_propose_male_3f99fbdd:
    "Но тут я замечаю тех, кто сказал «нет»."

# ch/harems/home/events/home_harem_common.rpy:3683
translate russian minami_sasha_propose_male_e26aae2f:
    "Теперь они выглядят одинокими и отвергнутыми."

# ch/harems/home/events/home_harem_common.rpy:3684
translate russian minami_sasha_propose_male_f581a8fe:
    "В животе неприятно сжимается от тревоги."

# ch/harems/home/events/home_harem_common.rpy:3685
translate russian minami_sasha_propose_male_bcb879fe:
    "Потому что я понятия не имею, что всё это значит для них..."

# ch/harems/home/events/home_harem_common.rpy:3692
translate russian bree_sasha_propose_male_3dfba538:
    "Я здесь на совершенно неизведанной территории: прежде я не делал предложения даже одной девушке, не говоря уже о двух сразу."

# ch/harems/home/events/home_harem_common.rpy:3693
translate russian bree_sasha_propose_male_fe27ca4a:
    "Но после недавних изменений законов о многобрачии, учитывая, что [lssb_homecommon.bree_name()], Саша и я счастливы в серьёзных отношениях, это кажется верным шагом."

# ch/harems/home/events/home_harem_common.rpy:3694
translate russian bree_sasha_propose_male_4de7282d:
    "Опыта у меня нет, а книг и фильмов, где парень делает предложение двум девушкам сразу, не так уж много. Поэтому решаю обратиться к старой доброй классике."

# ch/harems/home/events/home_harem_common.rpy:3695
translate russian bree_sasha_propose_male_6b211915:
    "Правда, с небольшими поправками..."

# ch/harems/home/events/home_harem_common.rpy:3696
translate russian bree_sasha_propose_male_a222f94a:
    "Выбрав момент, опускаюсь перед обеими на одно колено и достаю по кольцу в каждой руке."

# ch/harems/home/events/home_harem_common.rpy:3697
translate russian bree_sasha_propose_male_338c7ae7:
    mike.say "[lssb_homecommon.bree_name()]... Саша... вы выйдете за меня?"

# ch/harems/home/events/home_harem_common.rpy:3698
translate russian bree_sasha_propose_male_7b6dd854:
    mike.say "И, наверное, друг за друга?"

# ch/harems/home/events/home_harem_common.rpy:3702
translate russian bree_sasha_propose_male_a2e8ec3b:
    "[lssb_homecommon.bree_name()] и Саша на миг смотрят друг на друга с неподдельным удивлением."

# ch/harems/home/events/home_harem_common.rpy:3705
translate russian bree_sasha_propose_male_29d3674f:
    "А затем [lssb_homecommon.bree_name()] заливается смехом, и через несколько секунд Саша подхватывает."

# ch/harems/home/events/home_harem_common.rpy:3706
translate russian bree_sasha_propose_male_ac99d2f7:
    bree.say "Ой, [lssb_common.hero_name()], как мило!"

# ch/harems/home/events/home_harem_common.rpy:3708
translate russian bree_sasha_propose_male_1e3e6601:
    sasha.say "Серьёзно, это шутка? Тебя кто-то подговорил?"

# ch/harems/home/events/home_harem_common.rpy:3709
translate russian bree_sasha_propose_male_5e7e878d:
    mike.say "Я... эм... я..."

# ch/harems/home/events/home_harem_common.rpy:3711
translate russian bree_sasha_propose_male_70c59f90:
    bree.say "Ведь вся эта полигамия — просто модное увлечение, правда?"

# ch/harems/home/events/home_harem_common.rpy:3712
translate russian bree_sasha_propose_male_262feddf:
    sasha.say "Конечно! Попомни мои слова: через год уже выйдет из моды!"

# ch/harems/home/events/home_harem_common.rpy:3713
translate russian bree_sasha_propose_male_0c66922b:
    mike.say "А... да... конечно. Но на миг вы почти поверили, правда?"

# ch/harems/home/events/home_harem_common.rpy:3714
translate russian bree_sasha_propose_male_589fe347:
    "Я выдавливаю нервный смешок, немного умирая внутри."

# ch/harems/home/events/home_harem_common.rpy:3721
translate russian bree_sasha_propose_male_54309c5a:
    bree.say "Да, конечно!"

# ch/harems/home/events/home_harem_common.rpy:3723
translate russian bree_sasha_propose_male_3aa5d4f2:
    sasha.say "О нет, ни за что!"

# ch/harems/home/events/home_harem_common.rpy:3724
translate russian bree_sasha_propose_male_30c7c3b8:
    "Я ещё не успеваю осмыслить противоречивые ответы, как [lssb_homecommon.bree_name()] и Саша поворачиваются друг к другу."

# ch/harems/home/events/home_harem_common.rpy:3727
translate russian bree_sasha_propose_male_94072210:
    "Обе потрясены и удивлены, услышав честный ответ другой."

# ch/harems/home/events/home_harem_common.rpy:3728
translate russian bree_sasha_propose_male_449f6aa2:
