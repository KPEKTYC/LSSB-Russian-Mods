    samantha.say "И это всего с одним супругом!"

# ch/harems/home/events/home_harem_common.rpy:1627
translate russian lexi_samantha_sasha_propose_male_7509a9b6:
    samantha.say "Без меня."

# ch/harems/home/events/home_harem_common.rpy:1631
translate russian lexi_samantha_sasha_propose_male_e2b5ab24:
    samantha.say "Ну, в первый раз я обожглась."

# ch/harems/home/events/home_harem_common.rpy:1632
translate russian lexi_samantha_sasha_propose_male_9bb3104c:
    samantha.say "Но то было тогда, а это сейчас."

# ch/harems/home/events/home_harem_common.rpy:1634
translate russian lexi_samantha_sasha_propose_male_5692bf05:
    samantha.say "Так что да, я согласна!"

# ch/harems/home/events/home_harem_common.rpy:1638
translate russian lexi_samantha_sasha_propose_male_f1818e52:
    lexi.say "Ты не можешь жениться на нас всех."

# ch/harems/home/events/home_harem_common.rpy:1639
translate russian lexi_samantha_sasha_propose_male_7d6eb3a3:
    lexi.say "Это слишком дико даже для меня!"

# ch/harems/home/events/home_harem_common.rpy:1643
translate russian lexi_samantha_sasha_propose_male_d92387ba:
    lexi.say "Мы все поженимся?!?"

# ch/harems/home/events/home_harem_common.rpy:1645
translate russian lexi_samantha_sasha_propose_male_1a2a740c:
    lexi.say "Безумие! Я за!"

# ch/harems/home/events/home_harem_common.rpy:1647
translate russian lexi_samantha_sasha_propose_male_d486019f:
    "Наверное, отвечать на такой вопрос было для девушек потрясением."

# ch/harems/home/events/home_harem_common.rpy:1648
translate russian lexi_samantha_sasha_propose_male_125efa08:
    "Потому что слушать их ответы для меня точно было именно им."

# ch/harems/home/events/home_harem_common.rpy:1649
translate russian lexi_samantha_sasha_propose_male_425a8e8a:
    "Мне даже требуется время, чтобы осознать сказанное."

# ch/harems/home/events/home_harem_common.rpy:1651
translate russian lexi_samantha_sasha_propose_male_227f57cb:
    mike.say "В... вы все сказали «да»?"

# ch/harems/home/events/home_harem_common.rpy:1652
translate russian lexi_samantha_sasha_propose_male_eb2f3acc:
    mike.say "Вы правда все хотите выйти за меня?!?"

# ch/harems/home/events/home_harem_common.rpy:1653
translate russian lexi_samantha_sasha_propose_male_34836f21:
    "Второй вопрос вызывает уже смесь веселья и раздражения."

# ch/harems/home/events/home_harem_common.rpy:1654
translate russian lexi_samantha_sasha_propose_male_bb695139:
    "Девушки качают головами и закатывают глаза."

# ch/harems/home/events/home_harem_common.rpy:1655
translate russian lexi_samantha_sasha_propose_male_718fc05f:
