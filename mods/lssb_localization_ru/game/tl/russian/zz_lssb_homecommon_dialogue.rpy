# ch/harems/home/events/home_harem_common.rpy:1693
translate russian lexi_samantha_sasha_propose_male_455b671a:
    sasha.say "Я хочу выйти за тебя!"

# ch/harems/home/events/home_harem_common.rpy:1695
translate russian lexi_samantha_sasha_propose_male_098d5419:
    samantha.say "Мой ответ — да."

# ch/harems/home/events/home_harem_common.rpy:1697
translate russian lexi_samantha_sasha_propose_male_e9e61615:
    lexi.say "Ещё бы!"

# ch/harems/home/events/home_harem_common.rpy:1698
translate russian lexi_samantha_sasha_propose_male_11666f8c:
    "Я невольно улыбаюсь, когда девушки подходят."

# ch/harems/home/events/home_harem_common.rpy:1699
translate russian lexi_samantha_sasha_propose_male_6e81ac35:
    "Мы собираемся тесным кружком, обнимаемся и прижимаемся друг к другу."

# ch/harems/home/events/home_harem_common.rpy:1700
translate russian lexi_samantha_sasha_propose_male_3f99fbdd:
    "Но тут я замечаю тех, кто сказал «нет»."

# ch/harems/home/events/home_harem_common.rpy:1701
translate russian lexi_samantha_sasha_propose_male_e26aae2f:
    "Теперь они выглядят одинокими и отвергнутыми."

# ch/harems/home/events/home_harem_common.rpy:1702
translate russian lexi_samantha_sasha_propose_male_f581a8fe:
    "В животе неприятно сжимается от тревоги."

# ch/harems/home/events/home_harem_common.rpy:1703
translate russian lexi_samantha_sasha_propose_male_bcb879fe:
    "Потому что я понятия не имею, что всё это значит для них..."

# ch/harems/home/events/home_harem_common.rpy:1707
translate russian bree_lexi_minami_propose_male_d12fa97f:
    "Я знаю, что постоянно твержу, как невероятно здорово встречаться со своими соседками."

# ch/harems/home/events/home_harem_common.rpy:1708
translate russian bree_lexi_minami_propose_male_f4c7dc45:
    "Но вам придётся привыкнуть слышать от меня именно это."

# ch/harems/home/events/home_harem_common.rpy:1709
translate russian bree_lexi_minami_propose_male_a4798f50:
    "Может, когда-нибудь я свыкнусь с мыслью, и всё перестанет казаться таким невероятным."

# ch/harems/home/events/home_harem_common.rpy:1710
translate russian bree_lexi_minami_propose_male_c28f260d:
    "А может, никогда не перестану просыпаться с мыслью, что я самый везучий парень на свете!"

# ch/harems/home/events/home_harem_common.rpy:1711
translate russian bree_lexi_minami_propose_male_ba5cba67:
    "Как бы то ни было, сейчас у нас всё, кажется, хорошо."

# ch/harems/home/events/home_harem_common.rpy:1712
translate russian bree_lexi_minami_propose_male_fe83386f:
    "Все прекрасно ладят, и нам чертовски весело вместе."

# ch/harems/home/events/home_harem_common.rpy:1713
translate russian bree_lexi_minami_propose_male_3ebd0417:
    "Наверное, вы думаете, что я просто оставлю всё как есть."

# ch/harems/home/events/home_harem_common.rpy:1714
translate russian bree_lexi_minami_propose_male_50850d3f:
    "Ну зачем менять то, что и так прекрасно работает?"

# ch/harems/home/events/home_harem_common.rpy:1715
translate russian bree_lexi_minami_propose_male_253819c0:
    "Может, мне хочется сделать наш союз чуть более... постоянным?"

# ch/harems/home/events/home_harem_common.rpy:1716
translate russian bree_lexi_minami_propose_male_2926a04a:
    "Именно так: я собираюсь предложить девушкам выйти за меня."

# ch/harems/home/events/home_harem_common.rpy:1717
translate russian bree_lexi_minami_propose_male_6830c77d:
    "Для меня вполне естественно официально оформить наши отношения и связать себя обязательствами друг перед другом."

# ch/harems/home/events/home_harem_common.rpy:1718
translate russian bree_lexi_minami_propose_male_39bfd812:
    "И я рассчитываю, что девушки чувствуют то же самое."

# ch/harems/home/events/home_harem_common.rpy:1723
translate russian bree_lexi_minami_propose_male_544dfb05:
    "Поэтому, едва мы собираемся вместе и возникает подходящий момент, я делаю предложение."

# ch/harems/home/events/home_harem_common.rpy:1724
translate russian bree_lexi_minami_propose_male_b5e79ef7:
