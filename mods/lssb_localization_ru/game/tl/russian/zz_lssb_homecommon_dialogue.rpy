# ch/harems/home/events/home_harem_common.rpy:1540
translate russian bree_lexi_samantha_propose_male_8586b455:
    lexi.say "Я — замуж? Ты серьёзно?"

# ch/harems/home/events/home_harem_common.rpy:1541
translate russian bree_lexi_samantha_propose_male_f9bc4df9:
    "Мне остаётся лишь кивнуть и сделать бодрый вид."

# ch/harems/home/events/home_harem_common.rpy:1542
translate russian bree_lexi_samantha_propose_male_817c1ad4:
    "Но, думаю, они всё равно видят, какая у меня вымученная улыбка."

# ch/harems/home/events/home_harem_common.rpy:1543
translate russian bree_lexi_samantha_propose_male_2bab2ee4:
