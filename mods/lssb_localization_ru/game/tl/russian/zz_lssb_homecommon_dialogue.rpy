# ch/harems/home/events/home_harem_common.rpy:2078
translate russian bree_lexi_sasha_propose_male_2bab2ee4:
    "Девушки окружают меня, пытаясь утешить."

# ch/harems/home/events/home_harem_common.rpy:2079
translate russian bree_lexi_sasha_propose_male_7e318ae2:
    "Конечно, это не значит, что нашим отношениям конец."

# ch/harems/home/events/home_harem_common.rpy:2080
translate russian bree_lexi_sasha_propose_male_5a4285b7:
    "Хотя я невольно задумываюсь, надолго ли их хватит..."

# ch/harems/home/events/home_harem_common.rpy:2082
translate russian bree_lexi_sasha_propose_male_6b2ddf73:
    "Я перевожу взгляд с одной на другую."

# ch/harems/home/events/home_harem_common.rpy:2083
translate russian bree_lexi_sasha_propose_male_206cd91d:
    "Некоторые девушки сияют при мысли о браке."

# ch/harems/home/events/home_harem_common.rpy:2084
translate russian bree_lexi_sasha_propose_male_703aed18:
    "Но остальные выглядят скорее удивлёнными, даже встревоженными."

# ch/harems/home/events/home_harem_common.rpy:2086
translate russian bree_lexi_sasha_propose_male_ec6df227:
    mike.say "Некоторые из вас не хотят за меня замуж."

# ch/harems/home/events/home_harem_common.rpy:2087
translate russian bree_lexi_sasha_propose_male_81ac129a:
    mike.say "А некоторые хотят..."

# ch/harems/home/events/home_harem_common.rpy:2088
translate russian bree_lexi_sasha_propose_male_c51f0ec0:
    "Внезапно те, кто сказал «да», делают шаг вперёд."

# ch/harems/home/events/home_harem_common.rpy:2089
translate russian bree_lexi_sasha_propose_male_742e811c:
    "Может, пытаются меня поддержать."

# ch/harems/home/events/home_harem_common.rpy:2090
translate russian bree_lexi_sasha_propose_male_78cf2006:
    "А может, хотят отделиться от тех, кто отказался."

# ch/harems/home/events/home_harem_common.rpy:2092
translate russian bree_lexi_sasha_propose_male_eb23d63f:
    bree.say "Я хочу, [lssb_common.hero_name()]."

# ch/harems/home/events/home_harem_common.rpy:2094
translate russian bree_lexi_sasha_propose_male_455b671a:
    sasha.say "Я хочу выйти за тебя!"

# ch/harems/home/events/home_harem_common.rpy:2096
translate russian bree_lexi_sasha_propose_male_e9e61615:
    lexi.say "Ещё бы!"

# ch/harems/home/events/home_harem_common.rpy:2097
translate russian bree_lexi_sasha_propose_male_11666f8c:
    "Я невольно улыбаюсь, когда девушки подходят."

# ch/harems/home/events/home_harem_common.rpy:2098
translate russian bree_lexi_sasha_propose_male_6e81ac35:
    "Мы собираемся тесным кружком, обнимаемся и прижимаемся друг к другу."

# ch/harems/home/events/home_harem_common.rpy:2099
translate russian bree_lexi_sasha_propose_male_3f99fbdd:
    "Но тут я замечаю тех, кто сказал «нет»."

# ch/harems/home/events/home_harem_common.rpy:2100
translate russian bree_lexi_sasha_propose_male_e26aae2f:
    "Теперь они выглядят одинокими и отвергнутыми."

# ch/harems/home/events/home_harem_common.rpy:2101
translate russian bree_lexi_sasha_propose_male_f581a8fe:
    "В животе неприятно сжимается от тревоги."

# ch/harems/home/events/home_harem_common.rpy:2102
translate russian bree_lexi_sasha_propose_male_bcb879fe:
    "Потому что я понятия не имею, что всё это значит для них..."

# ch/harems/home/events/home_harem_common.rpy:2106
translate russian bree_minami_samantha_propose_male_d12fa97f:
    "Я знаю, что постоянно твержу, как невероятно здорово встречаться со своими соседками."

# ch/harems/home/events/home_harem_common.rpy:2107
translate russian bree_minami_samantha_propose_male_f4c7dc45:
    "Но вам придётся привыкнуть слышать от меня именно это."

# ch/harems/home/events/home_harem_common.rpy:2108
translate russian bree_minami_samantha_propose_male_a4798f50:
    "Может, когда-нибудь я свыкнусь с мыслью, и всё перестанет казаться таким невероятным."

# ch/harems/home/events/home_harem_common.rpy:2109
translate russian bree_minami_samantha_propose_male_c28f260d:
    "А может, никогда не перестану просыпаться с мыслью, что я самый везучий парень на свете!"

# ch/harems/home/events/home_harem_common.rpy:2110
translate russian bree_minami_samantha_propose_male_ba5cba67:
    "Как бы то ни было, сейчас у нас всё, кажется, хорошо."

# ch/harems/home/events/home_harem_common.rpy:2111
translate russian bree_minami_samantha_propose_male_fe83386f:
    "Все прекрасно ладят, и нам чертовски весело вместе."

# ch/harems/home/events/home_harem_common.rpy:2112
translate russian bree_minami_samantha_propose_male_3ebd0417:
    "Наверное, вы думаете, что я просто оставлю всё как есть."

# ch/harems/home/events/home_harem_common.rpy:2113
translate russian bree_minami_samantha_propose_male_50850d3f:
    "Ну зачем менять то, что и так прекрасно работает?"

# ch/harems/home/events/home_harem_common.rpy:2114
translate russian bree_minami_samantha_propose_male_253819c0:
    "Может, мне хочется сделать наш союз чуть более... постоянным?"

# ch/harems/home/events/home_harem_common.rpy:2115
translate russian bree_minami_samantha_propose_male_2926a04a:
    "Именно так: я собираюсь предложить девушкам выйти за меня."

# ch/harems/home/events/home_harem_common.rpy:2116
translate russian bree_minami_samantha_propose_male_6830c77d:
    "Для меня вполне естественно официально оформить наши отношения и связать себя обязательствами друг перед другом."

# ch/harems/home/events/home_harem_common.rpy:2117
translate russian bree_minami_samantha_propose_male_39bfd812:
    "И я рассчитываю, что девушки чувствуют то же самое."

# ch/harems/home/events/home_harem_common.rpy:2122
translate russian bree_minami_samantha_propose_male_544dfb05:
    "Поэтому, едва мы собираемся вместе и возникает подходящий момент, я делаю предложение."

# ch/harems/home/events/home_harem_common.rpy:2123
translate russian bree_minami_samantha_propose_male_b5e79ef7:
    mike.say "Эм, девушки..."

# ch/harems/home/events/home_harem_common.rpy:2124
translate russian bree_minami_samantha_propose_male_6e2c40cc:
    mike.say "Я хотел кое-что у вас спросить..."

# ch/harems/home/events/home_harem_common.rpy:2128
translate russian bree_minami_samantha_propose_male_037884f3:
    "Внезапно они разом поворачивают головы."

# ch/harems/home/events/home_harem_common.rpy:2129
translate russian bree_minami_samantha_propose_male_d677a5fb:
    "И все взгляды устремляются на меня!"

# ch/harems/home/events/home_harem_common.rpy:2130
translate russian bree_minami_samantha_propose_male_6b34c856:
    "Чёрт, я думал, это будет гораздо проще."

# ch/harems/home/events/home_harem_common.rpy:2131
translate russian bree_minami_samantha_propose_male_72ab6ec8:
    "Будто мне заглядывают прямо в душу!"

# ch/harems/home/events/home_harem_common.rpy:2132
translate russian bree_minami_samantha_propose_male_b2d42e7f:
    mike.say "Наверное, надо сделать всё как положено!"

# ch/harems/home/events/home_harem_common.rpy:2133
translate russian bree_minami_samantha_propose_male_489353ba:
    "Я опускаюсь на одно колено прямо перед девушками."

# ch/harems/home/events/home_harem_common.rpy:2134
translate russian bree_minami_samantha_propose_male_82444d9a:
