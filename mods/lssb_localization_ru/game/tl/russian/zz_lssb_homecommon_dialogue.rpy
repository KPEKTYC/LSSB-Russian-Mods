# ch/harems/home/events/home_harem_common.rpy:1681
translate russian lexi_samantha_sasha_propose_male_5a4285b7:
    "Хотя я невольно задумываюсь, надолго ли их хватит..."

# ch/harems/home/events/home_harem_common.rpy:1683
translate russian lexi_samantha_sasha_propose_male_6b2ddf73:
