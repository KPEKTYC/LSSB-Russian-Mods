# ch/harems/home/events/home_harem_common.rpy:2170
translate russian bree_minami_samantha_propose_male_7509a9b6:
    samantha.say "Без меня."

# ch/harems/home/events/home_harem_common.rpy:2174
translate russian bree_minami_samantha_propose_male_e2b5ab24:
    samantha.say "Ну, в первый раз я обожглась."

# ch/harems/home/events/home_harem_common.rpy:2175
translate russian bree_minami_samantha_propose_male_9bb3104c:
    samantha.say "Но то было тогда, а это сейчас."

# ch/harems/home/events/home_harem_common.rpy:2177
translate russian bree_minami_samantha_propose_male_5692bf05:
    samantha.say "Так что да, я согласна!"

# ch/harems/home/events/home_harem_common.rpy:2179
translate russian bree_minami_samantha_propose_male_d486019f:
