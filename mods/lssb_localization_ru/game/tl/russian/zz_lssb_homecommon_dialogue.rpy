# ch/harems/home/events/home_harem_common.rpy:1515
translate russian bree_lexi_samantha_propose_male_227f57cb:
    mike.say "В... вы все сказали «да»?"

# ch/harems/home/events/home_harem_common.rpy:1516
translate russian bree_lexi_samantha_propose_male_eb2f3acc:
    mike.say "Вы правда все хотите выйти за меня?!?"

# ch/harems/home/events/home_harem_common.rpy:1517
translate russian bree_lexi_samantha_propose_male_34836f21:
    "Второй вопрос вызывает уже смесь веселья и раздражения."

# ch/harems/home/events/home_harem_common.rpy:1518
translate russian bree_lexi_samantha_propose_male_bb695139:
    "Девушки качают головами и закатывают глаза."

# ch/harems/home/events/home_harem_common.rpy:1519
translate russian bree_lexi_samantha_propose_male_8ee84750:
    bree.say "Ох, [lssb_common.hero_name()]!"

# ch/harems/home/events/home_harem_common.rpy:1520
translate russian bree_lexi_samantha_propose_male_863a8021:
    samantha.say "Как это на тебя похоже, [lssb_common.hero_name()], как похоже!"

# ch/harems/home/events/home_harem_common.rpy:1521
translate russian bree_lexi_samantha_propose_male_729d3902:
    lexi.say "Господи, тебе бы уши прочистить!"

# ch/harems/home/events/home_harem_common.rpy:1522
translate russian bree_lexi_samantha_propose_male_b654f57d:
