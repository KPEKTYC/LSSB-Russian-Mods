# ch/harems/home/events/home_harem_common.rpy:2836
translate russian lexi_minami_propose_male_10b9d28e:
    "Я что, только что превратился из самого везучего парня на свете в самого жалкого?"

# ch/harems/home/events/home_harem_common.rpy:2837
translate russian lexi_minami_propose_male_f689953d:
    "Не могу поверить, что ВСЕ отказались!"

# ch/harems/home/events/home_harem_common.rpy:2838
translate russian lexi_minami_propose_male_a563545f:
    mike.say "В... вы все сказали «нет»..."

# ch/harems/home/events/home_harem_common.rpy:2839
translate russian lexi_minami_propose_male_146d6225:
    mike.say "Ни одна не хочет замуж?!?"

# ch/harems/home/events/home_harem_common.rpy:2840
translate russian lexi_minami_propose_male_f861d3cc:
    "Девушки снова переглядываются."

# ch/harems/home/events/home_harem_common.rpy:2841
translate russian lexi_minami_propose_male_bea9b5af:
    "Но на этот раз выглядят изрядно виноватыми."

# ch/harems/home/events/home_harem_common.rpy:2842
translate russian lexi_minami_propose_male_0f1f5d7a:
    "Наверное, хоть это должно меня немного утешить!"

# ch/harems/home/events/home_harem_common.rpy:2843
translate russian lexi_minami_propose_male_f959fe9b:
    minami.say "Мне ещё рано замуж, братик!"

# ch/harems/home/events/home_harem_common.rpy:2844
translate russian lexi_minami_propose_male_8586b455:
    lexi.say "Я — замуж? Ты серьёзно?"

# ch/harems/home/events/home_harem_common.rpy:2845
translate russian lexi_minami_propose_male_f9bc4df9:
    "Мне остаётся лишь кивнуть и сделать бодрый вид."

# ch/harems/home/events/home_harem_common.rpy:2846
translate russian lexi_minami_propose_male_817c1ad4:
    "Но, думаю, они всё равно видят, какая у меня вымученная улыбка."

# ch/harems/home/events/home_harem_common.rpy:2847
translate russian lexi_minami_propose_male_2bab2ee4:
    "Девушки окружают меня, пытаясь утешить."

# ch/harems/home/events/home_harem_common.rpy:2848
translate russian lexi_minami_propose_male_7e318ae2:
    "Конечно, это не значит, что нашим отношениям конец."

# ch/harems/home/events/home_harem_common.rpy:2849
translate russian lexi_minami_propose_male_5a4285b7:
    "Хотя я невольно задумываюсь, надолго ли их хватит..."

# ch/harems/home/events/home_harem_common.rpy:2851
translate russian lexi_minami_propose_male_6b2ddf73:
    "Я перевожу взгляд с одной на другую."

# ch/harems/home/events/home_harem_common.rpy:2852
translate russian lexi_minami_propose_male_206cd91d:
    "Некоторые девушки сияют при мысли о браке."

# ch/harems/home/events/home_harem_common.rpy:2853
translate russian lexi_minami_propose_male_703aed18:
    "Но остальные выглядят скорее удивлёнными, даже встревоженными."

# ch/harems/home/events/home_harem_common.rpy:2855
translate russian lexi_minami_propose_male_ec6df227:
    mike.say "Некоторые из вас не хотят за меня замуж."

# ch/harems/home/events/home_harem_common.rpy:2856
translate russian lexi_minami_propose_male_81ac129a:
    mike.say "А некоторые хотят..."

# ch/harems/home/events/home_harem_common.rpy:2857
translate russian lexi_minami_propose_male_c51f0ec0:
    "Внезапно те, кто сказал «да», делают шаг вперёд."

# ch/harems/home/events/home_harem_common.rpy:2858
translate russian lexi_minami_propose_male_742e811c:
    "Может, пытаются меня поддержать."

# ch/harems/home/events/home_harem_common.rpy:2859
translate russian lexi_minami_propose_male_78cf2006:
    "А может, хотят отделиться от тех, кто отказался."

# ch/harems/home/events/home_harem_common.rpy:2861
translate russian lexi_minami_propose_male_1b8f05f3:
    minami.say "Я с вами, братик!"

# ch/harems/home/events/home_harem_common.rpy:2863
translate russian lexi_minami_propose_male_e9e61615:
    lexi.say "Ещё бы!"

# ch/harems/home/events/home_harem_common.rpy:2864
translate russian lexi_minami_propose_male_11666f8c:
    "Я невольно улыбаюсь, когда девушки подходят."

# ch/harems/home/events/home_harem_common.rpy:2865
translate russian lexi_minami_propose_male_6e81ac35:
    "Мы собираемся тесным кружком, обнимаемся и прижимаемся друг к другу."

# ch/harems/home/events/home_harem_common.rpy:2866
translate russian lexi_minami_propose_male_3f99fbdd:
    "Но тут я замечаю тех, кто сказал «нет»."

# ch/harems/home/events/home_harem_common.rpy:2867
translate russian lexi_minami_propose_male_e26aae2f:
    "Теперь они выглядят одинокими и отвергнутыми."

# ch/harems/home/events/home_harem_common.rpy:2868
translate russian lexi_minami_propose_male_f581a8fe:
    "В животе неприятно сжимается от тревоги."

# ch/harems/home/events/home_harem_common.rpy:2869
translate russian lexi_minami_propose_male_bcb879fe:
    "Потому что я понятия не имею, что всё это значит для них..."

# ch/harems/home/events/home_harem_common.rpy:2873
translate russian bree_lexi_propose_male_d12fa97f:
    "Я знаю, что постоянно твержу, как невероятно здорово встречаться со своими соседками."

# ch/harems/home/events/home_harem_common.rpy:2874
translate russian bree_lexi_propose_male_f4c7dc45:
    "Но вам придётся привыкнуть слышать от меня именно это."

# ch/harems/home/events/home_harem_common.rpy:2875
translate russian bree_lexi_propose_male_a4798f50:
    "Может, когда-нибудь я свыкнусь с мыслью, и всё перестанет казаться таким невероятным."

# ch/harems/home/events/home_harem_common.rpy:2876
translate russian bree_lexi_propose_male_c28f260d:
    "А может, никогда не перестану просыпаться с мыслью, что я самый везучий парень на свете!"

# ch/harems/home/events/home_harem_common.rpy:2877
translate russian bree_lexi_propose_male_ba5cba67:
    "Как бы то ни было, сейчас у нас всё, кажется, хорошо."

# ch/harems/home/events/home_harem_common.rpy:2878
translate russian bree_lexi_propose_male_fe83386f:
    "Все прекрасно ладят, и нам чертовски весело вместе."

# ch/harems/home/events/home_harem_common.rpy:2879
translate russian bree_lexi_propose_male_3ebd0417:
    "Наверное, вы думаете, что я просто оставлю всё как есть."

# ch/harems/home/events/home_harem_common.rpy:2880
translate russian bree_lexi_propose_male_50850d3f:
    "Ну зачем менять то, что и так прекрасно работает?"

# ch/harems/home/events/home_harem_common.rpy:2881
translate russian bree_lexi_propose_male_253819c0:
    "Может, мне хочется сделать наш союз чуть более... постоянным?"

# ch/harems/home/events/home_harem_common.rpy:2882
translate russian bree_lexi_propose_male_2926a04a:
    "Именно так: я собираюсь предложить девушкам выйти за меня."

# ch/harems/home/events/home_harem_common.rpy:2883
translate russian bree_lexi_propose_male_6830c77d:
    "Для меня вполне естественно официально оформить наши отношения и связать себя обязательствами друг перед другом."

# ch/harems/home/events/home_harem_common.rpy:2884
translate russian bree_lexi_propose_male_39bfd812:
    "И я рассчитываю, что девушки чувствуют то же самое."

# ch/harems/home/events/home_harem_common.rpy:2888
translate russian bree_lexi_propose_male_544dfb05:
    "Поэтому, едва мы собираемся вместе и возникает подходящий момент, я делаю предложение."

# ch/harems/home/events/home_harem_common.rpy:2889
translate russian bree_lexi_propose_male_b5e79ef7:
    mike.say "Эм, девушки..."

# ch/harems/home/events/home_harem_common.rpy:2890
translate russian bree_lexi_propose_male_6e2c40cc:
    mike.say "Я хотел кое-что у вас спросить..."

# ch/harems/home/events/home_harem_common.rpy:2893
translate russian bree_lexi_propose_male_037884f3:
    "Внезапно они разом поворачивают головы."

# ch/harems/home/events/home_harem_common.rpy:2894
translate russian bree_lexi_propose_male_d677a5fb:
    "И все взгляды устремляются на меня!"

# ch/harems/home/events/home_harem_common.rpy:2895
translate russian bree_lexi_propose_male_6b34c856:
    "Чёрт, я думал, это будет гораздо проще."

# ch/harems/home/events/home_harem_common.rpy:2896
translate russian bree_lexi_propose_male_72ab6ec8:
    "Будто мне заглядывают прямо в душу!"

# ch/harems/home/events/home_harem_common.rpy:2897
translate russian bree_lexi_propose_male_b2d42e7f:
    mike.say "Наверное, надо сделать всё как положено!"

# ch/harems/home/events/home_harem_common.rpy:2898
translate russian bree_lexi_propose_male_489353ba:
    "Я опускаюсь на одно колено прямо перед девушками."

# ch/harems/home/events/home_harem_common.rpy:2899
translate russian bree_lexi_propose_male_82444d9a:
    "Это вызывает у них целую бурю разных чувств."

# ch/harems/home/events/home_harem_common.rpy:2900
translate russian bree_lexi_propose_male_bdc64184:
    "Только что они были растеряны, а теперь поражены."

# ch/harems/home/events/home_harem_common.rpy:2901
translate russian bree_lexi_propose_male_65be5ac1:
    "Может, так и должно быть?"

# ch/harems/home/events/home_harem_common.rpy:2902
translate russian bree_lexi_propose_male_20bfe615:
    mike.say "Вы..."

# ch/harems/home/events/home_harem_common.rpy:2906
translate russian bree_lexi_propose_male_5b9cb14f:
    mike.say "Вы все выйдете за меня?"

# ch/harems/home/events/home_harem_common.rpy:2907
translate russian bree_lexi_propose_male_2762a534:
    mike.say "И, наверное, друг за друга тоже?"

# ch/harems/home/events/home_harem_common.rpy:2908
translate russian bree_lexi_propose_male_05917d0c:
    "Ответ не заставляет себя ждать..."

# ch/harems/home/events/home_harem_common.rpy:2911
translate russian bree_lexi_propose_male_803197e9:
    bree.say "[lssb_common.hero_name()], ты же не серьёзно?!?"

# ch/harems/home/events/home_harem_common.rpy:2912
translate russian bree_lexi_propose_male_ad792691:
    bree.say "Как это вообще возможно?"

# ch/harems/home/events/home_harem_common.rpy:2916
translate russian bree_lexi_propose_male_98a82c66:
    bree.say "[lssb_common.hero_name()], ты серьёзно?!?"

# ch/harems/home/events/home_harem_common.rpy:2918
translate russian bree_lexi_propose_male_544c560d:
    bree.say "Конечно выйду!"

# ch/harems/home/events/home_harem_common.rpy:2922
translate russian bree_lexi_propose_male_f1818e52:
    lexi.say "Ты не можешь жениться на нас всех."

# ch/harems/home/events/home_harem_common.rpy:2923
translate russian bree_lexi_propose_male_7d6eb3a3:
    lexi.say "Это слишком дико даже для меня!"

# ch/harems/home/events/home_harem_common.rpy:2927
translate russian bree_lexi_propose_male_d92387ba:
    lexi.say "Мы все поженимся?!?"

# ch/harems/home/events/home_harem_common.rpy:2929
translate russian bree_lexi_propose_male_1a2a740c:
    lexi.say "Безумие! Я за!"

# ch/harems/home/events/home_harem_common.rpy:2931
translate russian bree_lexi_propose_male_d486019f:
    "Наверное, отвечать на такой вопрос было для девушек потрясением."

# ch/harems/home/events/home_harem_common.rpy:2932
translate russian bree_lexi_propose_male_125efa08:
    "Потому что слушать их ответы для меня точно было именно им."

# ch/harems/home/events/home_harem_common.rpy:2933
translate russian bree_lexi_propose_male_425a8e8a:
    "Мне даже требуется время, чтобы осознать сказанное."

# ch/harems/home/events/home_harem_common.rpy:2935
translate russian bree_lexi_propose_male_227f57cb:
    mike.say "В... вы все сказали «да»?"

# ch/harems/home/events/home_harem_common.rpy:2936
translate russian bree_lexi_propose_male_eb2f3acc:
    mike.say "Вы правда все хотите выйти за меня?!?"

# ch/harems/home/events/home_harem_common.rpy:2937
translate russian bree_lexi_propose_male_34836f21:
    "Второй вопрос вызывает уже смесь веселья и раздражения."

# ch/harems/home/events/home_harem_common.rpy:2938
translate russian bree_lexi_propose_male_bb695139:
    "Девушки качают головами и закатывают глаза."

# ch/harems/home/events/home_harem_common.rpy:2939
