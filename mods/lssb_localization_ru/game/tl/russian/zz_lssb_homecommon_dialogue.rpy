# ch/harems/home/events/home_harem_common.rpy:2135
translate russian bree_minami_samantha_propose_male_bdc64184:
    "Только что они были растеряны, а теперь поражены."

# ch/harems/home/events/home_harem_common.rpy:2136
translate russian bree_minami_samantha_propose_male_65be5ac1:
