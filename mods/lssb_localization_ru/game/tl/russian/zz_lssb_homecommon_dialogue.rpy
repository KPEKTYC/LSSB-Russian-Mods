# ch/harems/home/events/home_harem_common.rpy:2168
translate russian bree_minami_samantha_propose_male_aae81039:
    samantha.say "Ого, [lssb_common.hero_name()], я уже один раз обожглась."

# ch/harems/home/events/home_harem_common.rpy:2169
translate russian bree_minami_samantha_propose_male_5522daba:
