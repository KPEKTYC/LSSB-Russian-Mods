# ch/harems/home/events/home_harem_common.rpy:1748
translate russian bree_lexi_minami_propose_male_803197e9:
    bree.say "[lssb_common.hero_name()], ты же не серьёзно?!?"

# ch/harems/home/events/home_harem_common.rpy:1749
translate russian bree_lexi_minami_propose_male_ad792691:
    bree.say "Как это вообще возможно?"

# ch/harems/home/events/home_harem_common.rpy:1753
translate russian bree_lexi_minami_propose_male_98a82c66:
    bree.say "[lssb_common.hero_name()], ты серьёзно?!?"

# ch/harems/home/events/home_harem_common.rpy:1755
translate russian bree_lexi_minami_propose_male_544c560d:
    bree.say "Конечно выйду!"

# ch/harems/home/events/home_harem_common.rpy:1759
translate russian bree_lexi_minami_propose_male_e0013cb0:
