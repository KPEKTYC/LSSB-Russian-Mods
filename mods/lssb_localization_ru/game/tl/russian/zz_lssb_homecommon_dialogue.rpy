# ch/harems/home/events/home_harem_common.rpy:1684
translate russian lexi_samantha_sasha_propose_male_206cd91d:
    "Некоторые девушки сияют при мысли о браке."

# ch/harems/home/events/home_harem_common.rpy:1685
translate russian lexi_samantha_sasha_propose_male_703aed18:
