# ch/harems/home/events/home_harem_common.rpy:1524
translate russian bree_lexi_samantha_propose_male_bb5f3b86:
    "На этот раз мне отвечают кивками и улыбками."

# ch/harems/home/events/home_harem_common.rpy:1525
translate russian bree_lexi_samantha_propose_male_2f44f8f9:
