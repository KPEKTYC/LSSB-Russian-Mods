# ch/harems/home/events/home_harem_common.rpy:1464
translate russian bree_lexi_samantha_propose_male_489353ba:
    "Я опускаюсь на одно колено прямо перед девушками."

# ch/harems/home/events/home_harem_common.rpy:1465
translate russian bree_lexi_samantha_propose_male_82444d9a:
