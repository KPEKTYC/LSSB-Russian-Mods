# Native Homefive identifiers, current source catalog. Translation only.

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:24
translate russian home_harem_sixsome_intro_d6ab9bc1:
    "Вот оно: мечта сбылась! Кажется, спустя годы о моих подвигах и приключениях будут писать книги!"

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:25
translate russian home_harem_sixsome_intro_e2e6ee49:
    "Я заглядываю в гостиную, и поначалу кажется, что это обычный день выходного."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:26
translate russian home_harem_sixsome_intro_6f2f9022:
    "Но там я застаю сразу пятерых девушек, и все они как раз раздеваются."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:30
translate russian home_harem_sixsome_intro_afc60997:
    "Мои соседки, Саша и [lssb_homefive.bree_name()], уже в нижнем белье, улыбаются и обмениваются понимающими взглядами."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:32
translate russian home_harem_sixsome_intro_9c881a53:
    "Минами, моя приёмная сестра, хихикает в предвкушении того, что будет дальше, и снимает топ."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:34
translate russian home_harem_sixsome_intro_373970c9:
    "Лекси уже голая и жуёт жвачку, словно занимается этим регулярно."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:36
translate russian home_harem_sixsome_intro_3cbbcd6a:
    "А Сэм — та, которую, как я был уверен, я упустил, — не торопится, зная, что я смотрю на неё."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:37
translate russian home_harem_sixsome_intro_4958fada:
    mike.say "А... я..."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:38
translate russian home_harem_sixsome_intro_01335a89:
    mike.say "Что здесь происходит?"

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:39
translate russian home_harem_sixsome_intro_eb2871a7:
    sasha.say "А, привет, [lssb_common.hero_name()]."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:41
translate russian home_harem_sixsome_intro_1eb766a0:
    sasha.say "Я позвала Сэм и Лекси немного повеселиться."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:42
translate russian home_harem_sixsome_intro_6cb07b9e:
    mike.say "Я... я вижу!"

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:44
translate russian home_harem_sixsome_intro_b57f6826:
    sasha.say "Я собиралась тебе всё рассказать."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:46
translate russian home_harem_sixsome_intro_ddbbed39:
    sasha.say "Но потом решила устроить приятный сюрприз."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:48
translate russian home_harem_sixsome_intro_e96ca9ee:
    mike.say "Я тоже приглашён?!"

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:51
translate russian home_harem_sixsome_intro_d5651fde:
    bree.say "Конечно!"

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:54
translate russian home_harem_sixsome_intro_ee39721f:
    lexi.say "Ты же обеспечиваешь нас членом!"

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:57
translate russian home_harem_sixsome_intro_02884289:
    minami.say "Без тебя было бы не то, братишка!"

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:60
translate russian home_harem_sixsome_intro_561104c1:
    samantha.say "В конце концов, это ты свёл нас всех вместе!"

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:61
translate russian home_harem_sixsome_intro_8e1719d8:
    "Я никак не могу осознать, что всё это значит."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:62
translate russian home_harem_sixsome_intro_3c7f1c1e:
    "Я и пять девушек?"

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:63
translate russian home_harem_sixsome_intro_61bf9643:
    "Пять девушек... я уже это говорил?"

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:64
translate russian home_harem_sixsome_intro_40383e69:
    "А, какая разница!"

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:65
translate russian home_harem_sixsome_intro_a91ee45b:
    "Я сейчас буду развлекаться с пятью девушками, чёрт возьми!!!"

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:66
translate russian home_harem_sixsome_intro_8a3ad96c:
    "Кажется, я попал в какое-то безумное реалити-шоу."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:67
translate russian home_harem_sixsome_intro_e065f2e7:
    "Или стал персонажем игры, где нужно трахнуть девушку своей мечты."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:68
translate russian home_harem_sixsome_intro_515d3f50:
    "Но главное — кажется, в игре под названием «жизнь» я наконец побеждаю!"

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:69
translate russian home_harem_sixsome_intro_c2070621:
    "Похоже, все мои чувства легко прочитать, словно они написаны у меня на лице."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:70
translate russian home_harem_sixsome_intro_56380736:
    "Потому что сейчас каждая из девушек смотрит прямо на меня."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:71
translate russian home_harem_sixsome_intro_e9d7e09d:
    "Они перешёптываются и заговорщически хихикают."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:77
translate russian home_harem_sixsome_intro_ebf27ad7:
    "Затем они разом подходят, окружают меня и отрезают все пути к отступлению."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:78
translate russian home_harem_sixsome_intro_d6011d02:
    "Ага, как будто я вообще думаю о побеге!"

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:79
translate russian home_harem_sixsome_intro_fd2c954a:
    "Не успеваю я опомниться, как их руки оказываются повсюду на моём теле."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:80
translate russian home_harem_sixsome_intro_dee1340f:
    "Только совсем не в том приятном смысле, о котором можно подумать."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:81
translate russian home_harem_sixsome_intro_36c3bd4f:
    "Они меня раздевают!"

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:82
translate russian home_harem_sixsome_intro_98189289:
    "Я едва успеваю уследить, чьи руки где, пока они стягивают с меня одежду."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:83
translate russian home_harem_sixsome_intro_3ea0e4ed:
    "И времени на это уходит немного: на мне и так не слишком много всего."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:84
translate russian home_harem_sixsome_intro_da90eb77:
    "Футболка, брюки, носки и трусы — всё исчезает за считаные секунды."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:91
translate russian home_harem_sixsome_intro_dd6efcda:
    "И вот я стою перед ними такой же голый, как и они сами."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:94
translate russian home_harem_sixsome_intro_ca0ba7a8:
    "Девушки продолжают смеяться и отпускать лукавые замечания, довольные своей работой."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:95
translate russian home_harem_sixsome_intro_83f4085a:
    "Я уже чувствую, как мой член начинает твердеть."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:96
translate russian home_harem_sixsome_intro_45700aab:
    "Он начал ещё до того, как меня раздели, а теперь встаёт окончательно."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:97
translate russian home_harem_sixsome_intro_378e6d09:
    "Конечно, это вызывает новый взрыв радостного хихиканья и аплодисменты."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:99
translate russian home_harem_sixsome_intro_e9c503ae:
    sasha.say "Так, девчонки."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:100
translate russian home_harem_sixsome_intro_8bd29dbc:
    sasha.say "На колени, как договаривались!"

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:107
translate russian home_harem_sixsome_intro_5c2af0cf:
    "Я смотрю, как все пятеро опускаются передо мной на колени, поднимая на меня глаза."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:109
translate russian home_harem_sixsome_intro_53fa24c4:
    "Они улыбаются и терпеливо ждут того, что должно произойти дальше."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:111
translate russian home_harem_sixsome_intro_f3484a38:
    sasha.say "Теперь твоя очередь, [lssb_common.hero_name()]."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:112
translate russian home_harem_sixsome_intro_9e1a2e63:
    sasha.say "Пять ротиков, и у всех слюнки текут от желания попробовать твой член."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:113
translate russian home_harem_sixsome_intro_8cf7d669:
    sasha.say "Кого из нас выберешь?"

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:167
translate russian home_harem_sixsome_bj_bree_a4ae0fef:
    "Не знаю почему, но стоит мне поймать карий взгляд, и я понимаю: только [lssb_homefive.bree_name()]."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:168
translate russian home_harem_sixsome_bj_bree_103741bc:
    "Может, я просто не могу устоять перед милой блондинкой."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:170
translate russian home_harem_sixsome_bj_bree_5663699a:
    mike.say "[lssb_homefive.bree_name()]."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:171
translate russian home_harem_sixsome_bj_bree_153fe225:
    "[lssb_homefive.bree_name()] выглядит почти удивлённой тем, что из всех девушек перед собой я выбрал её."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:172
translate russian home_harem_sixsome_bj_bree_1be8d7f5:
    "А счастье, озаряющее её лицо, заставляет меня хотеть её ещё сильнее."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:173
translate russian home_harem_sixsome_bj_bree_b50c4f17:
    "Пока она подползает ко мне, мой член подрагивает от предвкушения."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:175
translate russian home_harem_sixsome_bj_bree_fc728ba8:
    "[lssb_homefive.bree_name()] протягивает обе руки и нежно направляет мой член к своему рту."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:176
translate russian home_harem_sixsome_bj_bree_4629986d:
    "Она медленно размыкает губы и немного впускает его."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:179
translate russian home_harem_sixsome_bj_bree_f92c6b90:
    "И когда её губы смыкаются вокруг него, ощущения просто райские."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:180
translate russian home_harem_sixsome_bj_bree_4227cd29:
    "[lssb_homefive.bree_name()] и правда так сосредоточена — на том, чтобы доставить мне удовольствие!"

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:181
translate russian home_harem_sixsome_bj_bree_fdaba4e8:
    "Её голова начинает двигаться вперёд-назад, медленно проходя по всей длине моего члена."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:182
translate russian home_harem_sixsome_bj_bree_d74f85f5:
    "Каждое мгновение тянется долго-долго."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:183
translate russian home_harem_sixsome_bj_bree_f9cb846b:
    "Мне кажется, [lssb_homefive.bree_name()] увлекает меня в путешествие, вознося куда-то за пределы этого мира."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:184
translate russian home_harem_sixsome_bj_bree_4b4bf4e2:
    "Я словно уплываю в трансе."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:185
translate russian home_harem_sixsome_bj_bree_4f3ba10f:
    "Но сначала я позволю ей лизать и сосать меня, пока не потеряю контроль!"

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:186
translate russian home_harem_sixsome_bj_bree_246bed66:
    "Поэтому мне приходится едва ли не бороться с собой, чтобы оставаться здесь и сейчас."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:187
translate russian home_harem_sixsome_bj_bree_84eaa632:
    "[lssb_homefive.bree_name()] так хороша, что я уже начал забывать, где нахожусь!"

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:188
translate russian home_harem_sixsome_bj_bree_10deeecd:
    "Я трясу головой, пытаясь стряхнуть охватившее меня почти гипнотическое состояние."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:189
translate russian home_harem_sixsome_bj_bree_3dbdb996:
    "[lssb_homefive.bree_name()], кажется, тоже замечает это и удваивает старания."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:190
translate russian home_harem_sixsome_bj_bree_b0293e33:
    "Резкой смены темпа с лихвой хватает, чтобы вернуть меня в реальность."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:191
translate russian home_harem_sixsome_bj_bree_1309eb4a:
    "Но её хватает и на то, чтобы заставить меня кончить!"

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:194
translate russian home_harem_sixsome_bj_bree_3cb6a983:
    "Теперь это уже никак не остановить, вообще никак."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:196
translate russian home_harem_sixsome_bj_bree_9373e011:
    "Так что я кончаю, пока [lssb_homefive.bree_name()] всё ещё держит мой член во рту."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:198
translate russian home_harem_sixsome_bj_bree_51643d41:
    "Это почти сразу развеивает чары: [lssb_homefive.bree_name()] в удивлении распахивает глаза!"

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:200
translate russian home_harem_sixsome_bj_bree_c6e95915:
    "Она давится спермой, которой я только что наполнил её рот, и рефлекторно сглатывает."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:201
translate russian home_harem_sixsome_bj_bree_3bad699e:
    "[lssb_homefive.bree_name()] улыбается мне, пока я вынимаю член у неё изо рта."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:202
translate russian home_harem_sixsome_bj_bree_275cff00:
    "Но я всё равно вижу, что у неё слезятся глаза."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:204
translate russian home_harem_sixsome_bj_bree_36d79201:
    "Я резко вынимаю член, и [lssb_homefive.bree_name()] явно этого не ожидала."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:208
translate russian home_harem_sixsome_bj_bree_8a8c120e:
    "Она распахивает глаза как раз вовремя, чтобы увидеть, как я кончаю ей на лицо."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:210
translate russian home_harem_sixsome_bj_bree_12408b2b:
    "Вид спермы, забрызгивающей её щёки и нос, немного рассеивает чары."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:211
translate russian home_harem_sixsome_bj_bree_f1a12d43:
    "Но её вскрики, пока сперма льётся на неё, с лихвой это возмещают."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:216
translate russian home_harem_sixsome_bj_lexi_5346b1ad:
    "Как говорится, хочешь, чтобы дело сделали хорошо, — зови профессионала!"

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:217
translate russian home_harem_sixsome_bj_lexi_cd0d8409:
    mike.say "Лекси."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:219
translate russian home_harem_sixsome_bj_lexi_c2d0c7f2:
    "В ответ она приподнимает бровь, глядя на член, покачивающийся перед её лицом."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:220
translate russian home_harem_sixsome_bj_lexi_79f3f1ed:
    "И почему-то её невозмутимость возбуждает меня сильнее любых проявлений энтузиазма!"

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:221
translate russian home_harem_sixsome_bj_lexi_30be256f:
    "Прежде чем приступить к делу, Лекси демонстративно вынимает жвачку изо рта."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:223
translate russian home_harem_sixsome_bj_lexi_fd5233f0:
    "Затем она наконец наклоняется к моему члену, ничуть не торопясь."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:224
translate russian home_harem_sixsome_bj_lexi_0e2258c1:
    "Когда её губы смыкаются вокруг него, я понимаю, что меня ждёт нечто особенное."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:225
translate russian home_harem_sixsome_bj_lexi_492c60f3:
    "Лекси начинает медленно, показывая, на что способна даже в таком неторопливом темпе."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:227
translate russian home_harem_sixsome_bj_lexi_e6a92ccb:
    "От этих ощущений я почти сразу начинаю тяжело дышать, предвкушая то, что ещё впереди."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:228
translate russian home_harem_sixsome_bj_lexi_e274d193:
    "Серьёзно, её язык во рту словно змея."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:229
translate russian home_harem_sixsome_bj_lexi_2893e0da:
    "Я чувствую каждое его движение и готов поклясться, что половину из них он просто не должен уметь делать!"

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:230
translate russian home_harem_sixsome_bj_lexi_10eb236f:
    "Лекси начинает двигать головой вперёд-назад и набирает скорость."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:231
translate russian home_harem_sixsome_bj_lexi_a5d082c4:
    "Постепенно темп минета растёт, а вместе с ним усиливаются и ощущения."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:232
translate russian home_harem_sixsome_bj_lexi_62f1f305:
    "Вскоре она уже работает как отбойный молоток."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:233
translate russian home_harem_sixsome_bj_lexi_d61f547c:
    "И звуки, которые я издаю в ответ, тоже становятся громче."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:234
translate russian home_harem_sixsome_bj_lexi_bd8e9ecd:
    "Не знаю, о чём думают остальные девушки, наблюдая за Лекси."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:235
translate russian home_harem_sixsome_bj_lexi_bf56ccd3:
    "Но надеюсь, они понимают, что им придётся подтянуть своё мастерство до её уровня!"

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:236
translate russian home_harem_sixsome_bj_lexi_0e022ebe:
    "Неудивительно, что вскоре меня охватывает желание кончить."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:237
translate russian home_harem_sixsome_bj_lexi_58f822c9:
    "И я почти уверен, что Лекси это тоже понимает."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:238
translate russian home_harem_sixsome_bj_lexi_d014f34e:
    "Ведь в тот же миг она словно удваивает старания."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:241
translate russian home_harem_sixsome_bj_lexi_bdaf7e80:
    "Это накатывает быстрее, чем я сам ожидал."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:243
translate russian home_harem_sixsome_bj_lexi_d5b96eae:
    "И всего несколько секунд спустя я изливаюсь Лекси в рот."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:245
translate russian home_harem_sixsome_bj_lexi_7418ea07:
    "Но она, кажется, ни на мгновение не сбавляет темп."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:247
translate russian home_harem_sixsome_bj_lexi_a7da3c60:
    "Наоборот, принимает всё, что я могу дать, и проглатывает."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:248
translate russian home_harem_sixsome_bj_lexi_7ea9ee79:
    "Лекси сглатывает каждую каплю спермы, ни разу не кашлянув."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:250
translate russian home_harem_sixsome_bj_lexi_0f479f0f:
    "Когда я вынимаю член у Лекси изо рта, она рефлекторно вздыхает."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:252
translate russian home_harem_sixsome_bj_lexi_67e36635:
    "Но мои действия её ничуть не удивляют."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:254
translate russian home_harem_sixsome_bj_lexi_79f77153:
    "Она закрывает глаза и открывает рот как можно шире."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:256
translate russian home_harem_sixsome_bj_lexi_ab607204:
    "Поэтому немалая часть спермы попадает прямо на её подставленный язык."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:257
translate russian home_harem_sixsome_bj_lexi_f207bb6d:
    "Лекси словно нежится под этим душем, наслаждаясь каждым мгновением."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:258
translate russian home_harem_sixsome_bj_lexi_46de7a60:
    "Будто считает его наградой за своё выступление."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:263
translate russian home_harem_sixsome_bj_minami_7881a4f7:
    "Даже переводя взгляд с одной девушки на другую, я чувствую на себе взгляд Минами."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:264
translate russian home_harem_sixsome_bj_minami_f48fda94:
    "И стоит мне наконец посмотреть в её сторону, как она чуть не вскакивает!"

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:265
translate russian home_harem_sixsome_bj_minami_06aa47a5:
    "Словно ей хочется встать и помахать мне рукой: так сильно она хочет, чтобы я выбрал именно её."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:266
translate russian home_harem_sixsome_bj_minami_d043f68a:
    "Не знаю, её ли рвение помогает мне решиться."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:267
translate russian home_harem_sixsome_bj_minami_e032f8a4:
    "Или мне просто нравится мысль выбрать самую молодую и неопытную из девушек."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:270
translate russian home_harem_sixsome_bj_minami_1b7e21b2:
    "Она наклоняется навстречу моему члену и даже хлопает в ладоши от радости, что выбрали её."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:271
translate russian home_harem_sixsome_bj_minami_34ee02ff:
    "Её взгляд прикован к головке, и по мере её приближения глаза чуть ли не сходятся к переносице."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:272
translate russian home_harem_sixsome_bj_minami_3e320465:
    "Минами ещё раз облизывает губы, а затем размыкает их, чтобы обхватить головку."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:274
translate russian home_harem_sixsome_bj_minami_0e748431:
    "Едва её губы смыкаются, она начинает сосать."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:275
translate russian home_harem_sixsome_bj_minami_c43ffa6b:
    "Недостаток опыта она с лихвой восполняет энтузиазмом."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:276
translate russian home_harem_sixsome_bj_minami_e1fcbb20:
    "Её голова движется вперёд-назад, и короткое каре подпрыгивает в такт."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:277
translate russian home_harem_sixsome_bj_minami_829527de:
    "Я вижу, как от усердия впадают её щёки."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:278
translate russian home_harem_sixsome_bj_minami_e46af54c:
    "И это напоминает мне, как она пьёт молочный коктейль через трубочку!"

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:279
translate russian home_harem_sixsome_bj_minami_20039104:
    "Но, шутки в сторону, ощущения совсем другого порядка."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:280
translate russian home_harem_sixsome_bj_minami_9f26de17:
    "Из-за её рвения я уже тяжело дышу."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:281
translate russian home_harem_sixsome_bj_minami_e7e715eb:
    "Понятия не имею, тренировалась ли Минами тайком или это природный талант."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:282
translate russian home_harem_sixsome_bj_minami_e17e26bb:
    "В любом случае нужно просить её делать это почаще!"

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:283
translate russian home_harem_sixsome_bj_minami_24fd9597:
    "Может, в следующий раз я буду лучше подготовлен и продержусь дольше."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:284
translate russian home_harem_sixsome_bj_minami_7a389ce6:
    "Потому что сейчас я вот-вот кончу!"

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:288
translate russian home_harem_sixsome_bj_minami_c9a7a931:
    "Минами удивлённо распахивает глаза, когда я изливаюсь ей прямо в горло."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:290
translate russian home_harem_sixsome_bj_minami_92286b7e:
    "Она чуть не выпускает мой член изо рта, пытаясь всё проглотить и не подавиться."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:292
translate russian home_harem_sixsome_bj_minami_095babff:
    "Когда ей наконец удаётся прийти в себя, с губ всё ещё капает сперма."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:293
translate russian home_harem_sixsome_bj_minami_13e3e35e:
    "Но всё это время она улыбается мне, явно радуясь тому, что я первым делом выбрал её."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:295
translate russian home_harem_sixsome_bj_minami_5acdf797:
    "Мой член с отчётливым чмоканьем выскальзывает у Минами изо рта."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:299
translate russian home_harem_sixsome_bj_minami_578c0fc9:
    "Она удивлённо открывает глаза в тот миг, когда сперма попадает ей на лицо."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:301
translate russian home_harem_sixsome_bj_minami_0ef3754b:
    "Минами вскрикивает, когда струйки ложатся на её щёки и губы."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:302
translate russian home_harem_sixsome_bj_minami_bac8b9f9:
    "Она отчаянно машет руками и подпрыгивает на месте."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:303
translate russian home_harem_sixsome_bj_minami_1a5b4a1f:
    "От этого происходящее доставляет ещё больше удовольствия!"

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:308
translate russian home_harem_sixsome_bj_samantha_b0cf08d3:
    "Передо мной столько женской красоты, но выбрать я могу лишь одну."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:309
translate russian home_harem_sixsome_bj_samantha_c533e5a6:
    "Это Сэм: я понимаю это, как только смотрю в глаза своему Кексику."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:310
translate russian home_harem_sixsome_bj_samantha_7b78ef42:
    "Она улыбается мне и чуть хлопает ресницами — ровно настолько, чтобы я безнадёжно попался в её сети."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:311
translate russian home_harem_sixsome_bj_samantha_69fea756:
    "И, думаю, в этот миг она тоже понимает, что победила."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:312
translate russian home_harem_sixsome_bj_samantha_6312013d:
    "Ведь ещё до того, как я поворачиваюсь к ней, её губы складываются в понимающую улыбку."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:314
translate russian home_harem_sixsome_bj_samantha_dcdebb63:
    "Протягивая руку к моему члену, Сэм ведёт себя скромно и сдержанно."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:315
translate russian home_harem_sixsome_bj_samantha_9b6d8d31:
    "Но от этого я лишь начинаю дышать ещё тяжелее."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:316
translate russian home_harem_sixsome_bj_samantha_a13884d4:
    "Почему-то мысль о том, что она сейчас разрушит иллюзию собственной невинности, невероятно возбуждает!"

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:317
translate russian home_harem_sixsome_bj_samantha_1cdfdb16:
    "Она слегка вытягивает губы, затем высовывает язык."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:318
translate russian home_harem_sixsome_bj_samantha_f8df2202:
    "Его кончик ласкает головку моего члена, и я содрогаюсь от этого ощущения."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:319
translate russian home_harem_sixsome_bj_samantha_2cd98812:
    "Услышав меня, Сэм поднимает глаза и радостно хихикает."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:320
translate russian home_harem_sixsome_bj_samantha_a4dc1966:
    "Так что я уже тяжело дышу от предвкушения, ещё до того, как она берёт его в рот."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:322
translate russian home_harem_sixsome_bj_samantha_32401935:
    "А когда берёт, я почти стону от ощущений."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:323
translate russian home_harem_sixsome_bj_samantha_99cc56fc:
    "Сэм усердно работает, энергично лижет и сосёт."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:324
translate russian home_harem_sixsome_bj_samantha_b4d305a6:
    "Каждый раз, когда её голова движется вверх-вниз, мне кажется, что я сейчас не выдержу."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:325
translate russian home_harem_sixsome_bj_samantha_b9f3d5dc:
    "Каждая волна наслаждения заставляет меня думать, что я вот-вот кончу."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:326
translate russian home_harem_sixsome_bj_samantha_daa63b24:
    "И поэтому, когда этот миг действительно наступает, он застаёт меня врасплох."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:327
translate russian home_harem_sixsome_bj_samantha_e152c665:
    "Не знаю, чувствует ли Сэм, что сейчас произойдёт."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:328
translate russian home_harem_sixsome_bj_samantha_82f8d0be:
    "Но если нет, скоро узнает!"

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:332
translate russian home_harem_sixsome_bj_samantha_9daeb4d9:
    "Едва я изливаюсь ей в рот, Сэм в потрясении распахивает глаза."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:334
translate russian home_harem_sixsome_bj_samantha_9ea311f0:
    "Она кашляет и захлёбывается, когда сперма попадает ей в горло."

# ch/harems/home/events/home_harem_bree_lexi_minami_samantha_sasha.rpy:336
translate russian home_harem_sixsome_bj_samantha_1059f4ed:
