# ch/harems/home/events/home_harem_lexi.rpy:691
translate russian lexi_moving_in_8677e44b:
    lexi.say "По крайней мере, теперь я знаю, где буду спать сегодня ночью!"

# ch/harems/home/events/home_harem_lexi.rpy:692
translate russian lexi_moving_in_f4f3c8d7:
    "Я радостно киваю с облегчением, стараясь не чувствовать вину."

# ch/harems/home/events/home_harem_lexi.rpy:693
translate russian lexi_moving_in_2db4d683:
    "Мне кажется, я слишком увлёкся уговорами соседок."

# ch/harems/home/events/home_harem_lexi.rpy:694
translate russian lexi_moving_in_c5f83695:
    "И за этим чуть не забыл, ради чего вообще всё затеял."

# ch/harems/home/events/home_harem_lexi.rpy:695
translate russian lexi_moving_in_3c92e167:
    mike.say "Ну, может, пока не совсем точно где."

# ch/harems/home/events/home_harem_lexi.rpy:696
translate russian lexi_moving_in_c575b156:
    mike.say "Когда переедешь, разберёмся, на диване ты будешь спать или где-нибудь ещё!"

# ch/harems/home/events/home_harem_lexi.rpy:697
translate russian lexi_moving_in_c1366510:
    "Теперь уже Лекси с готовностью кивает."

# ch/harems/home/events/home_harem_lexi.rpy:698
translate russian lexi_moving_in_18c8668c:
    lexi.say "Ладно, так чего мы ждём?"

# ch/harems/home/events/home_harem_lexi.rpy:700
translate russian lexi_moving_in_08a22b42:
    mike.say "О чём ты, Лекси?"

# ch/harems/home/events/home_harem_lexi.rpy:702
translate russian lexi_moving_in_d96bf920:
    "Она оглядывается и пожимает плечами."

# ch/harems/home/events/home_harem_lexi.rpy:703
translate russian lexi_moving_in_8c6b5f41:
    lexi.say "Не вижу, что нас ещё здесь держит!"

# ch/harems/home/events/home_harem_lexi.rpy:705
translate russian lexi_moving_in_92b8c87f:
    lexi.say "Так что пойдём к тебе прямо сейчас."

# ch/harems/home/events/home_harem_lexi.rpy:706
translate russian lexi_moving_in_444484c0:
    mike.say "Прямо сейчас — это вот прямо сейчас?!"

# ch/harems/home/events/home_harem_lexi.rpy:707
translate russian lexi_moving_in_29d5da54:
    mike.say "Я ещё ничего не успел подготовить!"

# ch/harems/home/events/home_harem_lexi.rpy:708
translate russian lexi_moving_in_7cbb827b:
    lexi.say "Ничего страшного, [lssb_common.hero_name()]."

# ch/harems/home/events/home_harem_lexi.rpy:709
translate russian lexi_moving_in_39518b5b:
    lexi.say "Мне ведь, похоже, всего лишь на диване спать!"

# ch/harems/home/events/home_harem_lexi.rpy:710
translate russian lexi_moving_in_4958fada:
    mike.say "А... я..."

# ch/harems/home/events/home_harem_lexi.rpy:711
translate russian lexi_moving_in_fd9b0acf:
    mike.say "Разве тебе не нужно забрать вещи?"

# ch/harems/home/events/home_harem_lexi.rpy:713
translate russian lexi_moving_in_8a81bfe4:
    lexi.say "Эй... приём?"

# ch/harems/home/events/home_harem_lexi.rpy:714
translate russian lexi_moving_in_232cd70b:
    lexi.say "Они все сгорели дотла, забыл?"

# ch/harems/home/events/home_harem_lexi.rpy:715
translate russian lexi_moving_in_ff206910:
    lexi.say "Осталась только одежда, которая на мне!"

# ch/harems/home/events/home_harem_lexi.rpy:718
translate russian lexi_moving_in_fe5d7541:
    "Мне остаётся лишь хлопнуть себя по лбу и закатить глаза."

# ch/harems/home/events/home_harem_lexi.rpy:719
translate russian lexi_moving_in_978e25f6:
    "Зачем я вообще пытаюсь спорить с Лекси?"

# ch/harems/home/events/home_harem_lexi.rpy:720
translate russian lexi_moving_in_b366e29b:
    "В конце концов, какая разница, переедет она сейчас или через неделю?"

# ch/harems/home/events/home_harem_lexi.rpy:721
translate russian lexi_moving_in_2714d608:
    "По крайней мере, для меня и моих соседок."

# ch/harems/home/events/home_harem_lexi.rpy:722
translate russian lexi_moving_in_a6ab7643:
    "Но каждая минута промедления — ещё одна минута, которую Лекси приходится оставаться бездомной."

# ch/harems/home/events/home_harem_lexi.rpy:723
translate russian lexi_moving_in_afffe40c:
    mike.say "Конечно, Лекси, конечно."

# ch/harems/home/events/home_harem_lexi.rpy:725
translate russian lexi_moving_in_ab669a30:
    mike.say "Пойдём."

# ch/harems/home/events/home_harem_lexi.rpy:727
translate russian lexi_moving_in_565317d8:
    "Лекси улыбается и берёт меня под руку, когда мы отправляемся в путь."

# ch/harems/home/events/home_harem_lexi.rpy:728
translate russian lexi_moving_in_8adf00bf:
    lexi.say "Это будет ТАК здорово."

# ch/harems/home/events/home_harem_lexi.rpy:729
translate russian lexi_moving_in_4abc8beb:
    lexi.say "Дом без колёс."

# ch/harems/home/events/home_harem_lexi.rpy:730
translate russian lexi_moving_in_14860736:
    lexi.say "Целая компания подружек под одной крышей."

# ch/harems/home/events/home_harem_lexi.rpy:731
translate russian lexi_moving_in_46ec0d42:
    lexi.say "А главное — ты всегда под рукой!"

# ch/harems/home/events/home_harem_lexi.rpy:732
translate russian lexi_moving_in_6fcaeabe:
    "Говоря это, Лекси счастливо улыбается и прижимается ко мне."

# ch/harems/home/events/home_harem_lexi.rpy:733
translate russian lexi_moving_in_3109735b:
    "Я тоже улыбаюсь, вновь ощущая, как приятно её тело совсем рядом."

# ch/harems/home/events/home_harem_lexi.rpy:734
translate russian lexi_moving_in_1289899a:
    "И думаю о том, что теперь она ещё долго будет так близко!"

# ch/harems/home/events/home_harem_lexi.rpy:736
translate russian lexi_moving_in_2eda6ff8:
    "Честно говоря, я не знаю, чего ожидал, когда привёл Лекси жить к нам."

# ch/harems/home/events/home_harem_lexi.rpy:737
translate russian lexi_moving_in_d928195a:
    "Раньше я устраивал будущим соседям экскурсию по дому."

# ch/harems/home/events/home_harem_lexi.rpy:738
translate russian lexi_moving_in_1aac4e8d:
    "Об этом и думаю, открывая входную дверь и собираясь провести её в прихожую."

# ch/harems/home/events/home_harem_lexi.rpy:739
translate russian lexi_moving_in_118be67f:
    "Но Лекси застаёт меня врасплох: протискивается мимо, чуть не толкнув локтем под рёбра."

# ch/harems/home/events/home_harem_lexi.rpy:740
translate russian lexi_moving_in_a5113097:
    "Она так быстро оказывается внутри и отправляется бродить по дому, что я едва успеваю захлопнуть дверь и догнать её!"

# ch/harems/home/events/home_harem_lexi.rpy:745
translate russian lexi_moving_in_5f5dee29:
    lexi.say "О-о..."

# ch/harems/home/events/home_harem_lexi.rpy:746
translate russian lexi_moving_in_e21a8c55:
    lexi.say "Здесь здорово, [lssb_common.hero_name()]!"

# ch/harems/home/events/home_harem_lexi.rpy:747
translate russian lexi_moving_in_339a2836:
    lexi.say "Всё такое шикарное и изысканное, совсем не как в трейлерном парке!"

# ch/harems/home/events/home_harem_lexi.rpy:749
translate russian lexi_moving_in_9cd792f6:
    "Я иду по пятам за Лекси, пока она переходит из комнаты в комнату."

# ch/harems/home/events/home_harem_lexi.rpy:750
translate russian lexi_moving_in_ad1773b1:
    "Она заглядывает в двери, заходит и осматривает всё, что ей вздумается."

# ch/harems/home/events/home_harem_lexi.rpy:751
translate russian lexi_moving_in_9e8fda58:
    "Мне остаётся лишь следовать за ней, делая вид, будто я хоть как-то управляю происходящим."

# ch/harems/home/events/home_harem_lexi.rpy:752
translate russian lexi_moving_in_81a477f7:
    "Хотя я понятия не имею, слышит ли Лекси хоть слово из того, что я говорю!"

# ch/harems/home/events/home_harem_lexi.rpy:753
translate russian lexi_moving_in_a8b05613:
    "Наверное, всё не так уж плохо: похоже, остальные сейчас не дома."

# ch/harems/home/events/home_harem_lexi.rpy:754
translate russian lexi_moving_in_ec6009bd:
    "Так что, возможно, привести Лекси без предупреждения посреди дня оказалось удачной идеей!"

# ch/harems/home/events/home_harem_lexi.rpy:759
translate russian lexi_moving_in_9ebee746:
    lexi.say "Какая огромная ванна!"

# ch/harems/home/events/home_harem_lexi.rpy:761
translate russian lexi_moving_in_4406ac59:
    lexi.say "В ней можно славно повеселиться..."

# ch/harems/home/events/home_harem_lexi.rpy:766
translate russian lexi_moving_in_ddd09acd:
    lexi.say "У тебя большой бассейн, и вокруг него стена."

# ch/harems/home/events/home_harem_lexi.rpy:768
translate russian lexi_moving_in_746c8460:
    lexi.say "Смогу загорать топлес сколько захочу!"

# ch/harems/home/events/home_harem_lexi.rpy:769
translate russian lexi_moving_in_6bb28dcd:
    mike.say "Что ты сможешь?!"

# ch/harems/home/events/home_harem_lexi.rpy:773
translate russian lexi_moving_in_0ac3b3d7:
    lexi.say "Какая пружинистая кровать, [lssb_common.hero_name()]."

# ch/harems/home/events/home_harem_lexi.rpy:775
translate russian lexi_moving_in_32c1078d:
    lexi.say "Смотри, на ней можно прыгать как на батуте!"

# ch/harems/home/events/home_harem_lexi.rpy:776
translate russian lexi_moving_in_1dbc21e4:
    mike.say "Лекси, прекрати."

# ch/harems/home/events/home_harem_lexi.rpy:777
translate russian lexi_moving_in_cf74ce07:
    mike.say "Кажется, я сейчас ослепну!"

# ch/harems/home/events/home_harem_lexi.rpy:779
translate russian lexi_moving_in_c34bc436:
    "В конце концов мы заходим в гостиную."

# ch/harems/home/events/home_harem_lexi.rpy:780
translate russian lexi_moving_in_69b61a9f:
    "Ну, если честно, я захожу следом за Лекси."

# ch/harems/home/events/home_harem_lexi.rpy:781
translate russian lexi_moving_in_38aa78cc:
    "И тут понимаю, что мы уже не одни."

# ch/harems/home/events/home_harem_lexi.rpy:782
translate russian lexi_moving_in_3e686961:
    "С диванов на нас вдруг смотрят четыре пары глаз."

# ch/harems/home/events/home_harem_lexi.rpy:783
translate russian lexi_moving_in_f138070a:
    "Потому что все мои соседки сидят прямо здесь!"

# ch/harems/home/events/home_harem_lexi.rpy:785
translate russian lexi_moving_in_1290fb96:
    mike.say "А... это..."

# ch/harems/home/events/home_harem_lexi.rpy:786
translate russian lexi_moving_in_e6ff1d5b:
    mike.say "Это остальные соседки, Лекси!"

# ch/harems/home/events/home_harem_lexi.rpy:787
translate russian lexi_moving_in_11013f23:
    "Это всё, что я могу выдать с ходу."

# ch/harems/home/events/home_harem_lexi.rpy:788
translate russian lexi_moving_in_a584f651:
    "Но уже вижу, что кое-кого задел."

# ch/harems/home/events/home_harem_lexi.rpy:790
translate russian lexi_moving_in_6058448b:
    bree.say "Эй, [lssb_common.hero_name()]!"

# ch/harems/home/events/home_harem_lexi.rpy:791
translate russian lexi_moving_in_3d024cb6:
    bree.say "Мог бы представить нас получше!"

# ch/harems/home/events/home_harem_lexi.rpy:793
translate russian lexi_moving_in_da49a4c2:
    sasha.say "Ага, мы же не часть обстановки!"

# ch/harems/home/events/home_harem_lexi.rpy:794
translate russian lexi_moving_in_c05d1764:
    sasha.say "Ты показал нас так, будто мы джакузи!"

# ch/harems/home/events/home_harem_lexi.rpy:796
translate russian lexi_moving_in_ded9f5bb:
    "Но пока [lssb_homelexi.bree_name()] и Саша возмущаются, Минами и Сэм ведут себя тише."

# ch/harems/home/events/home_harem_lexi.rpy:797
translate russian lexi_moving_in_78cc7e5a:
    "И я прекрасно вижу, что они с неподдельным интересом изучают Лекси."

# ch/harems/home/events/home_harem_lexi.rpy:799
translate russian lexi_moving_in_c72a1cf1:
    "Но пока [lssb_homelexi.bree_name()] и Саша возмущаются, Сэм ведёт себя тише."

# ch/harems/home/events/home_harem_lexi.rpy:800
translate russian lexi_moving_in_8d2bfa67:
    "И я прекрасно вижу, что она с неподдельным интересом изучает Лекси."

# ch/harems/home/events/home_harem_lexi.rpy:802
translate russian lexi_moving_in_3b4d219a:
    "Но пока [lssb_homelexi.bree_name()] и Саша возмущаются, Минами ведёт себя тише."

# ch/harems/home/events/home_harem_lexi.rpy:803
translate russian lexi_moving_in_8d2bfa67_1:
    "И я прекрасно вижу, что она с неподдельным интересом изучает Лекси."

# ch/harems/home/events/home_harem_lexi.rpy:806
translate russian lexi_moving_in_e9056972:
    mike.say "Лекси, это [lssb_homelexi.bree_name()] и Саша."

# ch/harems/home/events/home_harem_lexi.rpy:808
translate russian lexi_moving_in_d9b20be0:
    lexi.say "Привет, Саша, рада снова тебя видеть."

# ch/harems/home/events/home_harem_lexi.rpy:809
translate russian lexi_moving_in_2b06c2a3:
    lexi.say "[lssb_homelexi.bree_name()], я Лекси, как он и сказал!"

# ch/harems/home/events/home_harem_lexi.rpy:817
translate russian lexi_moving_in_6649e3b8:
    mike.say "А здесь Минами и Кексик."

# ch/harems/home/events/home_harem_lexi.rpy:819
translate russian lexi_moving_in_a7fff59e:
    mike.say "А здесь Минами и Сэм."

# ch/harems/home/events/home_harem_lexi.rpy:821
translate russian lexi_moving_in_25ec0695:
    lexi.say "Очень приятно!"

# ch/harems/home/events/home_harem_lexi.rpy:822
translate russian lexi_moving_in_8ed54ef2:
    minami.say "Я его младшая сестра."

# ch/harems/home/events/home_harem_lexi.rpy:823
translate russian lexi_moving_in_3a510a57:
    mike.say "ПРИЁМНАЯ младшая сестра!"

# ch/harems/home/events/home_harem_lexi.rpy:825
translate russian lexi_moving_in_2b99f74d:
    mike.say "Вообще-то Кексик, формально говоря, живёт здесь дольше всех."

# ch/harems/home/events/home_harem_lexi.rpy:827
translate russian lexi_moving_in_6f98e2bd:
    mike.say "Вообще-то Сэм, формально говоря, живёт здесь дольше всех."

# ch/harems/home/events/home_harem_lexi.rpy:828
translate russian lexi_moving_in_2c67dbd9:
    mike.say "Она жила тут ещё до того, как въехали [lssb_homelexi.bree_name()] и Саша."

# ch/harems/home/events/home_harem_lexi.rpy:829
translate russian lexi_moving_in_231be3f1:
    mike.say "А потом снова сюда вернулась."

# ch/harems/home/events/home_harem_lexi.rpy:830
translate russian lexi_moving_in_6472510b:
    samantha.say "Всё немного сложнее."

# ch/harems/home/events/home_harem_lexi.rpy:831
translate russian lexi_moving_in_cebf9f3d:
    samantha.say "Но в общих чертах да."

# ch/harems/home/events/home_harem_lexi.rpy:836
translate russian lexi_moving_in_83fef5cf:
    mike.say "А здесь Кексик."

# ch/harems/home/events/home_harem_lexi.rpy:838
translate russian lexi_moving_in_40ba6299:
    mike.say "А здесь Сэм."

# ch/harems/home/events/home_harem_lexi.rpy:840
translate russian lexi_moving_in_25ec0695_1:
    lexi.say "Очень приятно!"

# ch/harems/home/events/home_harem_lexi.rpy:842
translate russian lexi_moving_in_2b99f74d_1:
    mike.say "Вообще-то Кексик, формально говоря, живёт здесь дольше всех."

# ch/harems/home/events/home_harem_lexi.rpy:844
translate russian lexi_moving_in_6f98e2bd_1:
    mike.say "Вообще-то Сэм, формально говоря, живёт здесь дольше всех."

# ch/harems/home/events/home_harem_lexi.rpy:845
translate russian lexi_moving_in_2c67dbd9_1:
    mike.say "Она жила тут ещё до того, как въехали [lssb_homelexi.bree_name()] и Саша."

# ch/harems/home/events/home_harem_lexi.rpy:846
translate russian lexi_moving_in_231be3f1_1:
    mike.say "А потом снова сюда вернулась."

# ch/harems/home/events/home_harem_lexi.rpy:847
translate russian lexi_moving_in_6472510b_1:
    samantha.say "Всё немного сложнее."

# ch/harems/home/events/home_harem_lexi.rpy:848
translate russian lexi_moving_in_cebf9f3d_1:
    samantha.say "Но в общих чертах да."

# ch/harems/home/events/home_harem_lexi.rpy:852
translate russian lexi_moving_in_1d61c44e:
    mike.say "А здесь Минами."

# ch/harems/home/events/home_harem_lexi.rpy:854
translate russian lexi_moving_in_25ec0695_2:
    lexi.say "Очень приятно!"

# ch/harems/home/events/home_harem_lexi.rpy:855
translate russian lexi_moving_in_8ed54ef2_1:
    minami.say "Я его младшая сестра."

# ch/harems/home/events/home_harem_lexi.rpy:856
translate russian lexi_moving_in_3a510a57_1:
    mike.say "ПРИЁМНАЯ младшая сестра!"

# ch/harems/home/events/home_harem_lexi.rpy:860
translate russian lexi_moving_in_78cf11b8:
    "Лекси мило улыбается собравшимся девушкам и плюхается на свободный диван."

# ch/harems/home/events/home_harem_lexi.rpy:861
translate russian lexi_moving_in_5ef3d7cf:
    "Пару раз подпрыгивает на нём, будто примеряясь."

# ch/harems/home/events/home_harem_lexi.rpy:862
translate russian lexi_moving_in_4401aace:
    "А потом наклоняется вперёд, упираясь локтями в колени и подпирая подбородок ладонями."

# ch/harems/home/events/home_harem_lexi.rpy:863
translate russian lexi_moving_in_e14fc64b:
    lexi.say "[lssb_common.hero_name()] сказал, что я могу спать на одном из диванов."

# ch/harems/home/events/home_harem_lexi.rpy:864
translate russian lexi_moving_in_6e5a0756:
    lexi.say "Но, кажется, порядки у вас тут куда свободнее."

# ch/harems/home/events/home_harem_lexi.rpy:865
translate russian lexi_moving_in_6a43b226:
    lexi.say "Я права или я права?"

# ch/harems/home/events/home_harem_lexi.rpy:866
translate russian lexi_moving_in_440920f2:
    "Я с нарастающим ужасом наблюдаю, как Лекси переводит взгляд с одной девушки на другую."

# ch/harems/home/events/home_harem_lexi.rpy:867
translate russian lexi_moving_in_544e453f:
    "[lssb_homelexi.bree_name()], Саша, Сэм и Минами, кажется, дружно прикидываются дурочками."

# ch/harems/home/events/home_harem_lexi.rpy:868
translate russian lexi_moving_in_f5cb7652:
    "Они качают головами и растерянно переглядываются, делая вид, будто не понимают вопроса."

# ch/harems/home/events/home_harem_lexi.rpy:870
translate russian lexi_moving_in_92891c3a:
    lexi.say "Да бросьте вы!"

# ch/harems/home/events/home_harem_lexi.rpy:871
translate russian lexi_moving_in_e21a1db8:
    lexi.say "Четыре девушки и один парень под одной крышей?"

# ch/harems/home/events/home_harem_lexi.rpy:874
translate russian lexi_moving_in_09b959dc:
    lexi.say "Вы ведь трахаетесь друг с другом?"

# ch/harems/home/events/home_harem_lexi.rpy:876
translate russian lexi_moving_in_8325e2bf:
    lexi.say "Вы все пятеро в этом участвуете, иначе я схожу с ума!"

# ch/harems/home/events/home_harem_lexi.rpy:883
translate russian lexi_moving_in_daeb258f:
    "Все девушки" "Ты же не думаешь, что...\nНа что ты намекаешь...\nБратик, она что...\nПогоди-ка..."

# ch/harems/home/events/home_harem_lexi.rpy:885
translate russian lexi_moving_in_933c376a:
    lexi.say "Вы все четверо в этом участвуете, иначе я схожу с ума!"

# ch/harems/home/events/home_harem_lexi.rpy:891
translate russian lexi_moving_in_156a288a:
    "Все девушки" "Ты же не думаешь, что...\nНа что ты намекаешь...\nПогоди-ка..."

# ch/harems/home/events/home_harem_lexi.rpy:893
translate russian lexi_moving_in_933c376a_1:
    lexi.say "Вы все четверо в этом участвуете, иначе я схожу с ума!"

# ch/harems/home/events/home_harem_lexi.rpy:899
translate russian lexi_moving_in_c07ab8da:
    "Все девушки" "Ты же не думаешь, что...\nНа что ты намекаешь...\nБратик, она что..."

# ch/harems/home/events/home_harem_lexi.rpy:901
translate russian lexi_moving_in_621b6d47:
    lexi.say "Вы все трое в этом участвуете, иначе я схожу с ума!"

# ch/harems/home/events/home_harem_lexi.rpy:906
translate russian lexi_moving_in_de81185a:
    "Все девушки" "Ты же не думаешь, что...\nНа что ты намекаешь..."

# ch/harems/home/events/home_harem_lexi.rpy:907
translate russian lexi_moving_in_231b3803:
    "На мгновение все заговаривают одновременно, перебивая друг друга."

# ch/harems/home/events/home_harem_lexi.rpy:908
translate russian lexi_moving_in_1c6abdf9:
    "Кто-то прикидывается, будто ничего не понимает, а кто-то возмущается намёками Лекси."

# ch/harems/home/events/home_harem_lexi.rpy:909
translate russian lexi_moving_in_b05d778f:
    "Но в конце концов я решаю, что уже давно пора вмешаться и сказать своё слово."

# ch/harems/home/events/home_harem_lexi.rpy:910
translate russian lexi_moving_in_31e82fb7:
    mike.say "Да бросьте, девчонки."

# ch/harems/home/events/home_harem_lexi.rpy:911
translate russian lexi_moving_in_5bdd1227:
    mike.say "У Лекси опыта больше, чем у вас всех вместе взятых."

# ch/harems/home/events/home_harem_lexi.rpy:918
translate russian lexi_moving_in_0eccd4c3:
    lexi.say "Эй!"

# ch/harems/home/events/home_harem_lexi.rpy:920
translate russian lexi_moving_in_8b845943:
    mike.say "Прости, Лекси, но это правда!"

# ch/harems/home/events/home_harem_lexi.rpy:921
translate russian lexi_moving_in_d7ec2536:
    mike.say "Она нас раскусила, так что давайте перестанем отрицать, ладно?"

# ch/harems/home/events/home_harem_lexi.rpy:923
translate russian lexi_moving_in_8e9306b8:
    "Остальные девушки переглядываются, краснеют и опускают глаза."

# ch/harems/home/events/home_harem_lexi.rpy:925
translate russian lexi_moving_in_68296c1e:
    bree.say "Я... думаю, надо быть честными с нашей новой соседкой."

# ch/harems/home/events/home_harem_lexi.rpy:927
translate russian lexi_moving_in_81ba0d07:
    sasha.say "Ага, не можем же мы всё время прятаться у неё за спиной!"

# ch/harems/home/events/home_harem_lexi.rpy:932
translate russian lexi_moving_in_4d10b480:
    samantha.say "К тому же она наверняка могла бы всех нас кое-чему научить!"

# ch/harems/home/events/home_harem_lexi.rpy:937
translate russian lexi_moving_in_001958a9:
    minami.say "О-о, я бы поучилась у настоящей профи!"

# ch/harems/home/events/home_harem_lexi.rpy:939
translate russian lexi_moving_in_4cce9301:
    "Лекси откидывается на спинку дивана с самодовольным видом победительницы."

# ch/harems/home/events/home_harem_lexi.rpy:940
translate russian lexi_moving_in_1e6ed83b:
    lexi.say "Знаете что? Кажется, мне понравится здесь жить!"

# ch/harems/home/events/home_harem_lexi.rpy:941
translate russian lexi_moving_in_57f89678:
    "Все остальные девушки улыбаются и негромко смеются."

# ch/harems/home/events/home_harem_lexi.rpy:942
translate russian lexi_moving_in_551dc600:
    "И я не знаю, радует ли их присутствие Лекси и то, что оно сулит, или немного пугает."

# ch/harems/home/events/home_harem_lexi.rpy:943
translate russian lexi_moving_in_4f0585d0:
    "Скорее всего, и то и другое."

# ch/harems/home/events/home_harem_lexi.rpy:944
translate russian lexi_moving_in_3e5a3aa3:
    "Потому что сам я сейчас чувствую именно это!"

# ch/harems/home/events/home_harem_lexi.rpy:955
translate russian bree_lexi_threesome_intro_6e1a2b4f:
    "Всё начинается, когда я просто лежу на кровати и никого не трогаю."

# ch/harems/home/events/home_harem_lexi.rpy:956
translate russian bree_lexi_threesome_intro_c73076e5:
    "Дверь моей комнаты распахивается, внутрь влетает Лекси, а следом — [lssb_homelexi.bree_name()]."

# ch/harems/home/events/home_harem_lexi.rpy:960
translate russian bree_lexi_threesome_intro_ef9f9943:
    lexi.say "Вот он, [lssb_homelexi.bree_name()]!"

# ch/harems/home/events/home_harem_lexi.rpy:961
translate russian bree_lexi_threesome_intro_cf7fec65:
    lexi.say "Я же говорила!"

# ch/harems/home/events/home_harem_lexi.rpy:963
translate russian bree_lexi_threesome_intro_55296140:
    bree.say "Спорим, он только что дрочил!"

# ch/harems/home/events/home_harem_lexi.rpy:966
translate russian bree_lexi_threesome_intro_0d75e279:
    lexi.say "ФУ-У!"

# ch/harems/home/events/home_harem_lexi.rpy:967
translate russian bree_lexi_threesome_intro_4cc85701:
    bree.say "ФУ-У!"

# ch/harems/home/events/home_harem_lexi.rpy:970
translate russian bree_lexi_threesome_intro_b6453c2f:
    "Я сажусь на кровати и отбрасываю журнал, который только что читал."

# ch/harems/home/events/home_harem_lexi.rpy:971
translate russian bree_lexi_threesome_intro_9b76ac38:
    "Не потому, что не хочу им его показывать, ясно?"

# ch/harems/home/events/home_harem_lexi.rpy:972
translate russian bree_lexi_threesome_intro_2fcccc58:
    "А потому, что злюсь: чего это они так врываются в мою комнату!"

# ch/harems/home/events/home_harem_lexi.rpy:974
translate russian bree_lexi_threesome_intro_04c3b79b:
    mike.say "Я не дрочил!"

# ch/harems/home/events/home_harem_lexi.rpy:975
translate russian bree_lexi_threesome_intro_7fdce1a0:
    mike.say "То есть мог бы, если бы захотел, но дело не в этом!"

# ch/harems/home/events/home_harem_lexi.rpy:976
translate russian bree_lexi_threesome_intro_8381cccf:
    mike.say "Вы двое вообще что здесь делаете?!"

# ch/harems/home/events/home_harem_lexi.rpy:980
translate russian bree_lexi_threesome_intro_e68c691c:
    "[lssb_homelexi.bree_name()] и Лекси решительно подходят к моей кровати."

# ch/harems/home/events/home_harem_lexi.rpy:981
translate russian bree_lexi_threesome_intro_01a56d54:
    "Остановившись рядом, они скрещивают руки на груди."

# ch/harems/home/events/home_harem_lexi.rpy:982
translate russian bree_lexi_threesome_intro_7d94b6e6:
    "Обе смотрят на меня сверху вниз с серьёзными лицами."

# ch/harems/home/events/home_harem_lexi.rpy:983
translate russian bree_lexi_threesome_intro_7529fb7a:
    "Раздражение вдруг сменяется немалым беспокойством."

# ch/harems/home/events/home_harem_lexi.rpy:985
translate russian bree_lexi_threesome_intro_27e934d0:
    mike.say "Девчонки, мне уже не нравится, к чему всё идёт!"

# ch/harems/home/events/home_harem_lexi.rpy:986
translate russian bree_lexi_threesome_intro_c305fb97:
    mike.say "Почему вы так на меня смотрите?"

# ch/harems/home/events/home_harem_lexi.rpy:987
translate russian bree_lexi_threesome_intro_c98e4813:
    "[lssb_homelexi.bree_name()] и Лекси быстро переглядываются и кивают."

# ch/harems/home/events/home_harem_lexi.rpy:989
translate russian bree_lexi_threesome_intro_78e10c19:
    lexi.say "[lssb_homelexi.bree_name()] и я тут поговорили, [lssb_common.hero_name()]."

# ch/harems/home/events/home_harem_lexi.rpy:991
translate russian bree_lexi_threesome_intro_8bee245f:
    lexi.say "И пришли к выводу, что нам хочется секса."

# ch/harems/home/events/home_harem_lexi.rpy:992
translate russian bree_lexi_threesome_intro_72e4c73f:
    "Я пару раз моргаю, не уверенный, что правильно расслышал."

# ch/harems/home/events/home_harem_lexi.rpy:993
translate russian bree_lexi_threesome_intro_dae29c1b:
    mike.say "Прости..."

# ch/harems/home/events/home_harem_lexi.rpy:994
translate russian bree_lexi_threesome_intro_88a109a8:
    mike.say "Ты сейчас сказала, что вам хочется... секса?!"

# ch/harems/home/events/home_harem_lexi.rpy:996
translate russian bree_lexi_threesome_intro_77d2fc4b:
    "Теперь, похоже, вступает [lssb_homelexi.bree_name()]."

# ch/harems/home/events/home_harem_lexi.rpy:997
translate russian bree_lexi_threesome_intro_4a80a3a9:
    "И добавляет этому безумию новый поворот."

# ch/harems/home/events/home_harem_lexi.rpy:999
translate russian bree_lexi_threesome_intro_c1c96df1:
    bree.say "Всё верно, [lssb_common.hero_name()], нам хочется секса."

# ch/harems/home/events/home_harem_lexi.rpy:1000
translate russian bree_lexi_threesome_intro_02b47f9d:
    bree.say "А ты мужчина в доме."

# ch/harems/home/events/home_harem_lexi.rpy:1001
translate russian bree_lexi_threesome_intro_e4bce37c:
    bree.say "Так что твоя обязанность — что-нибудь с этим сделать!"

# ch/harems/home/events/home_harem_lexi.rpy:1002
translate russian bree_lexi_threesome_intro_cce37e10:
    "Несколько секунд я изумлённо смотрю на них снизу вверх."

# ch/harems/home/events/home_harem_lexi.rpy:1005
translate russian bree_lexi_threesome_intro_3016b3cf:
    "Но потом не выдерживаю и заливаюсь смехом."

# ch/harems/home/events/home_harem_lexi.rpy:1007
translate russian bree_lexi_threesome_intro_9c332cc7:
    "Такая реакция, кажется, им совсем не нравится."

# ch/harems/home/events/home_harem_lexi.rpy:1009
translate russian bree_lexi_threesome_intro_05e9538a:
    lexi.say "Эй, что такое?!"

# ch/harems/home/events/home_harem_lexi.rpy:1010
translate russian bree_lexi_threesome_intro_d95c0edb:
    lexi.say "Почему ты над нами смеёшься?"

# ch/harems/home/events/home_harem_lexi.rpy:1011
translate russian bree_lexi_threesome_intro_bd78c8ab:
    bree.say "Да, [lssb_common.hero_name()]!"

# ch/harems/home/events/home_harem_lexi.rpy:1013
translate russian bree_lexi_threesome_intro_277b6408:
    bree.say "Мы серьёзно!"

# ch/harems/home/events/home_harem_lexi.rpy:1014
translate russian bree_lexi_threesome_intro_6f6eeb74:
    "Я сажусь на кровати и опускаю ноги на пол."

# ch/harems/home/events/home_harem_lexi.rpy:1015
translate russian bree_lexi_threesome_intro_d7d86718:
    "Одновременно поднимаю руку, чтобы их остановить."

# ch/harems/home/events/home_harem_lexi.rpy:1016
translate russian bree_lexi_threesome_intro_fbd9bb1d:
    mike.say "Простите, девчонки!"

# ch/harems/home/events/home_harem_lexi.rpy:1017
translate russian bree_lexi_threesome_intro_a0cfddd7:
    mike.say "Просто это так смешно."

# ch/harems/home/events/home_harem_lexi.rpy:1018
translate russian bree_lexi_threesome_intro_61b39988:
    mike.say "Вы заявились сюда словно две участницы пикета!"

# ch/harems/home/events/home_harem_lexi.rpy:1019
translate russian bree_lexi_threesome_intro_d5920690:
    mike.say "Ну... может, озабоченные участницы пикета..."

# ch/harems/home/events/home_harem_lexi.rpy:1021
translate russian bree_lexi_threesome_intro_30555bc9:
    lexi.say "И что в этом плохого?"

# ch/harems/home/events/home_harem_lexi.rpy:1023
translate russian bree_lexi_threesome_intro_78b8f54a:
    bree.say "А что нам делать, гений?"

# ch/harems/home/events/home_harem_lexi.rpy:1024
translate russian bree_lexi_threesome_intro_4f6ccea5:
    "Я пожимаю плечами и качаю головой, всё ещё сдерживая смех."

# ch/harems/home/events/home_harem_lexi.rpy:1026
translate russian bree_lexi_threesome_intro_4a055428:
    mike.say "Может, просто спросить, не хочу ли я?"

# ch/harems/home/events/home_harem_lexi.rpy:1029
translate russian bree_lexi_threesome_intro_719723e6:
    "[lssb_homelexi.bree_name()] и Лекси переглядываются."

# ch/harems/home/events/home_harem_lexi.rpy:1031
translate russian bree_lexi_threesome_intro_3a109166:
    "И я вижу, как их щёки начинают краснеть."

# ch/harems/home/events/home_harem_lexi.rpy:1032
translate russian bree_lexi_threesome_intro_22874f59:
    bree.say "Ну... а ты хочешь?"

# ch/harems/home/events/home_harem_lexi.rpy:1034
translate russian bree_lexi_threesome_intro_f0a8cf0f:
    bree.say "Ты не против?"

# ch/harems/home/events/home_harem_lexi.rpy:1035
translate russian bree_lexi_threesome_intro_64f9350d:
    lexi.say "Да, ты не против?"

# ch/harems/home/events/home_harem_lexi.rpy:1037
translate russian bree_lexi_threesome_intro_78a8e8cf:
    lexi.say "Трахнешь нас, [lssb_common.hero_name()]?"

# ch/harems/home/events/home_harem_lexi.rpy:1039
translate russian bree_lexi_threesome_intro_b6d347c5:
    "Я начинаю понимать, что перевернул всю ситуацию с ног на голову."

# ch/harems/home/events/home_harem_lexi.rpy:1040
translate russian bree_lexi_threesome_intro_61828cf7:
    "Из-за того, как они сюда вломились, я забыл, чего они вообще хотят."

# ch/harems/home/events/home_harem_lexi.rpy:1041
translate russian bree_lexi_threesome_intro_448c3238:
    "Передо мной [lssb_homelexi.bree_name()] и Лекси. Я перевожу взгляд с одной на другую и хочу дать себе пощёчину."

# ch/harems/home/events/home_harem_lexi.rpy:1042
translate russian bree_lexi_threesome_intro_e3aa0004:
    "Какая разница, как они попросили и чем я занимался до их прихода?"

# ch/harems/home/events/home_harem_lexi.rpy:1043
translate russian bree_lexi_threesome_intro_dc3060af:
    "Прямо передо мной стоят две горячие возбуждённые блондинки."

# ch/harems/home/events/home_harem_lexi.rpy:1044
translate russian bree_lexi_threesome_intro_869db1a2:
    "И умоляют заняться с ними любовью!"

# ch/harems/home/events/home_harem_lexi.rpy:1045
translate russian bree_lexi_threesome_intro_32827f57:
    "Даже я не настолько дурак!"

# ch/harems/home/events/home_harem_lexi.rpy:1047
translate russian bree_lexi_threesome_intro_83c4af67:
    mike.say "Думаю, вы правы."

# ch/harems/home/events/home_harem_lexi.rpy:1048
translate russian bree_lexi_threesome_intro_1a63ccfe:
    mike.say "Удовлетворять всех под этой крышей — моя обязанность!"

# ch/harems/home/events/home_harem_lexi.rpy:1051
translate russian bree_lexi_threesome_intro_fe8c146a:
    "Услышав это, [lssb_homelexi.bree_name()] и Лекси приходят в восторг."

# ch/harems/home/events/home_harem_lexi.rpy:1052
translate russian bree_lexi_threesome_intro_1871e05b:
    "Они хлопают в ладоши и подпрыгивают на месте."

# ch/harems/home/events/home_harem_lexi.rpy:1053
translate russian bree_lexi_threesome_intro_72f315fd:
