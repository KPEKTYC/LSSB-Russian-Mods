# ch/harems/home/events/home_harem_lexi.rpy:1752
translate russian lexi_sasha_threesome_intro_0f9a774f:
    "Пора немного взять дело в свои руки."

# ch/harems/home/events/home_harem_lexi.rpy:1753
translate russian lexi_sasha_threesome_intro_2096ade7:
    "Я чуть меняю угол своего члена."

# ch/harems/home/events/home_harem_lexi.rpy:1754
translate russian lexi_sasha_threesome_intro_894142fe:
    sasha.say "Что ты..."

# ch/harems/home/events/home_harem_lexi.rpy:1756
translate russian lexi_sasha_threesome_intro_9198105e:
    sasha.say "О-о..."

# ch/harems/home/events/home_harem_lexi.rpy:1757
translate russian lexi_sasha_threesome_intro_d0f7babb:
    sasha.say "Это моя задница!"

# ch/harems/home/events/home_harem_lexi.rpy:1759
translate russian lexi_sasha_threesome_intro_41fdd6a9:
    "Я невольно улыбаюсь, продолжая проникать в неё."

# ch/harems/home/events/home_harem_lexi.rpy:1760
translate russian lexi_sasha_threesome_intro_d10af4f2_1:
    "Потом я чувствую, как что-то поддаётся."

# ch/harems/home/events/home_harem_lexi.rpy:1761
translate russian lexi_sasha_threesome_intro_60455735:
    "И через мгновение её попка перестаёт сопротивляться."

# ch/harems/home/events/home_harem_lexi.rpy:1763
translate russian lexi_sasha_threesome_intro_734e0124_1:
    "Я чувствую, как погружаюсь в Сашу."

# ch/harems/home/events/home_harem_lexi.rpy:1764
translate russian lexi_sasha_threesome_intro_672e7c8d_1:
    "Стараюсь не спешить, чтобы насладиться моментом."

# ch/harems/home/events/home_harem_lexi.rpy:1765
translate russian lexi_sasha_threesome_intro_5a23d70a_1:
    "Но её тело, кажется, жаждет этого."

# ch/harems/home/events/home_harem_lexi.rpy:1766
translate russian lexi_sasha_threesome_intro_65cfbaf0_1:
    "И прежде чем я успеваю остановиться, оказываюсь в ней до самого конца!"

# ch/harems/home/events/home_harem_lexi.rpy:1767
translate russian lexi_sasha_threesome_intro_a0f60288_1:
    sasha.say "Ох, [lssb_common.hero_name()]..."

# ch/harems/home/events/home_harem_lexi.rpy:1769
translate russian lexi_sasha_threesome_intro_0db9fd31_1:
    sasha.say "Он... он такой большой!"

# ch/harems/home/events/home_harem_lexi.rpy:1770
translate russian lexi_sasha_threesome_intro_cdd72406_1:
    sasha.say "Не останавливайся..."

# ch/harems/home/events/home_harem_lexi.rpy:1772
translate russian lexi_sasha_threesome_intro_c1329c54_1:
    sasha.say "Трахни меня, пожалуйста!"

# ch/harems/home/events/home_harem_lexi.rpy:1773
translate russian lexi_sasha_threesome_intro_12c8fd81_1:
    "Подстёгнутый мольбами Саши, я начинаю действовать."

# ch/harems/home/events/home_harem_lexi.rpy:1774
translate russian lexi_sasha_threesome_intro_5de17efa_1:
    "Мысли о том, чтобы настоять на своём, мгновенно исчезают."

# ch/harems/home/events/home_harem_lexi.rpy:1775
translate russian lexi_sasha_threesome_intro_634a6d52_1:
    "Теперь я хочу лишь доставить ей удовольствие, исполнить её желания."

# ch/harems/home/events/home_harem_lexi.rpy:1776
translate russian lexi_sasha_threesome_intro_484b7252_1:
    "Ведь всё, что я для этого делаю, приносит удовольствие и мне."

# ch/harems/home/events/home_harem_lexi.rpy:1777
translate russian lexi_sasha_threesome_intro_959ca010_1:
    "Саша кажется беспомощной, пока я вхожу в неё и выхожу."

# ch/harems/home/events/home_harem_lexi.rpy:1778
translate russian lexi_sasha_threesome_intro_bb7f97be_1:
    "Ощущение моего члена внутри переполняет её."

# ch/harems/home/events/home_harem_lexi.rpy:1779
translate russian lexi_sasha_threesome_intro_5b4f2145_1:
    "Но Лекси ничего такого не достаётся."

# ch/harems/home/events/home_harem_lexi.rpy:1780
translate russian lexi_sasha_threesome_intro_12eb75ff_1:
    "Поэтому она ищет удовольствие другими способами."

# ch/harems/home/events/home_harem_lexi.rpy:1781
translate russian lexi_sasha_threesome_intro_d38138e3_1:
    "Она порхает между мной и Сашей словно похотливая мошка."

# ch/harems/home/events/home_harem_lexi.rpy:1783
translate russian lexi_sasha_threesome_intro_8df7bc5d_1:
    "То играет с грудью Саши."

# ch/harems/home/events/home_harem_lexi.rpy:1784
translate russian lexi_sasha_threesome_intro_8e812528_1:
    "То тычет своей грудью мне в лицо."

# ch/harems/home/events/home_harem_lexi.rpy:1785
translate russian lexi_sasha_threesome_intro_bce66c68_1:
    "От этого мы оба только сильнее возбуждаемся."

# ch/harems/home/events/home_harem_lexi.rpy:1786
translate russian lexi_sasha_threesome_intro_79ea0392_1:
    "Мои пальцы впиваются в мягкие бёдра Саши."

# ch/harems/home/events/home_harem_lexi.rpy:1787
translate russian lexi_sasha_threesome_intro_8e282979_1:
    "Так сильно, что я боюсь оставить синяки."

# ch/harems/home/events/home_harem_lexi.rpy:1788
translate russian lexi_sasha_threesome_intro_6cfa9fbf_1:
    "Но её пыл от этого ничуть не ослабевает."

# ch/harems/home/events/home_harem_lexi.rpy:1789
translate russian lexi_sasha_threesome_intro_cb852d57_1:
    "Теперь Саша практически вбивается в меня задницей."

# ch/harems/home/events/home_harem_lexi.rpy:1790
translate russian lexi_sasha_threesome_intro_22e267c9_1:
    "Её ягодицы шлёпают по моим бёдрам!"

# ch/harems/home/events/home_harem_lexi.rpy:1792
translate russian lexi_sasha_threesome_intro_601ee3c6_1:
    sasha.say "Ох..."

# ch/harems/home/events/home_harem_lexi.rpy:1793
translate russian lexi_sasha_threesome_intro_8d214992_1:
    sasha.say "Ох, блядь..."

# ch/harems/home/events/home_harem_lexi.rpy:1794
translate russian lexi_sasha_threesome_intro_48c82545_1:
    sasha.say "Сейчас... сейчас кончу!"

# ch/harems/home/events/home_harem_lexi.rpy:1795
translate russian lexi_sasha_threesome_intro_33136790_1:
    "Отчаянный, прерывающийся голос Саши становится последней каплей."

# ch/harems/home/events/home_harem_lexi.rpy:1796
translate russian lexi_sasha_threesome_intro_f999364a_1:
    "И я чувствую, как она увлекает меня за собой!"

# ch/harems/home/events/home_harem_lexi.rpy:1799
translate russian lexi_sasha_threesome_intro_573354d2_1:
    "Я сейчас трахаю её так сильно и быстро."

# ch/harems/home/events/home_harem_lexi.rpy:1800
translate russian lexi_sasha_threesome_intro_21523c8f_1:
    "Что не остановлюсь даже на мгновение!"

# ch/harems/home/events/home_harem_lexi.rpy:1801
translate russian lexi_sasha_threesome_intro_139c8cfe_1:
    "Поэтому продолжаю вколачиваться в Сашу."

# ch/harems/home/events/home_harem_lexi.rpy:1802
translate russian lexi_sasha_threesome_intro_95e14e64_1:
    "Пока наконец не срываюсь."

# ch/harems/home/events/home_harem_lexi.rpy:1805
translate russian lexi_sasha_threesome_intro_c15a9c8f_1:
    "И изливаюсь в неё как можно глубже."

# ch/harems/home/events/home_harem_lexi.rpy:1807
translate russian lexi_sasha_threesome_intro_a5aedd32_1:
    "Саша выгибает спину, принимая всё."

# ch/harems/home/events/home_harem_lexi.rpy:1809
translate russian lexi_sasha_threesome_intro_714c34a5:
    "Я чувствую сокращения мышц её попки: она тоже кончает."

# ch/harems/home/events/home_harem_lexi.rpy:1811
translate russian lexi_sasha_threesome_intro_0993a530_1:
    "В последний раз проявляя упрямство, я вынимаю член из Саши."

# ch/harems/home/events/home_harem_lexi.rpy:1813
translate russian lexi_sasha_threesome_intro_0ea2c644_1:
    "За миг до того, как кончить."

# ch/harems/home/events/home_harem_lexi.rpy:1815
translate russian lexi_sasha_threesome_intro_798649ea_1:
    "Стоит члену оказаться снаружи, из него брызжет сперма."

# ch/harems/home/events/home_harem_lexi.rpy:1818
translate russian lexi_sasha_threesome_intro_1a5352f7_1:
    "Но вместо спины Саши она оказывается во рту Лекси."

# ch/harems/home/events/home_harem_lexi.rpy:1819
translate russian lexi_sasha_threesome_intro_43800eda:
    "Я и не заметил: едва мой член вышел из попки Саши, как рот Лекси уже обхватил его."

# ch/harems/home/events/home_harem_lexi.rpy:1820
translate russian lexi_sasha_threesome_intro_fbb7c94c_1:
    "Так что в итоге я наполнил рот Лекси."

# ch/harems/home/events/home_harem_lexi.rpy:1821
translate russian lexi_sasha_threesome_intro_ea5a9e5a_1:
    "Что её, кажется, ничуть не беспокоит."

# ch/harems/home/events/home_harem_lexi.rpy:1823
translate russian lexi_sasha_threesome_intro_947b89a4_1:
    "Оставлять Лекси в стороне кажется несправедливым."

# ch/harems/home/events/home_harem_lexi.rpy:1824
translate russian lexi_sasha_threesome_intro_8b6f51ba_1:
    "Поэтому решаю вовлечь её, пока не поздно."

# ch/harems/home/events/home_harem_lexi.rpy:1828
translate russian lexi_sasha_threesome_intro_c5c5c74b_1:
    "Вынимаю член из Саши и разворачиваю её."

# ch/harems/home/events/home_harem_lexi.rpy:1829
translate russian lexi_sasha_threesome_intro_9a7beaf3_1:
    "Одновременно ставлю Лекси на колени рядом с ней."

# ch/harems/home/events/home_harem_lexi.rpy:1830
translate russian lexi_sasha_threesome_intro_7ec034a4_2:
    "И очень вовремя: через мгновение я кончаю."

# ch/harems/home/events/home_harem_lexi.rpy:1834
translate russian lexi_sasha_threesome_intro_fedfd6d2_2:
    "Лекси и Саша терпеливо ждут, пока я изольюсь."

# ch/harems/home/events/home_harem_lexi.rpy:1836
translate russian lexi_sasha_threesome_intro_0e353a8c_2:
    "А потом закрывают глаза, когда на них обрушиваются брызги."

# ch/harems/home/events/home_harem_lexi.rpy:1838
translate russian lexi_sasha_threesome_intro_e947afec_2:
    "Сперма попадает на щёки и начинает стекать с подбородков."

# ch/harems/home/events/home_harem_lexi.rpy:1839
translate russian lexi_sasha_threesome_intro_31e270a6_2:
    "Они хихикают, слизывая её с губ."

# ch/harems/home/events/home_harem_lexi.rpy:1842
translate russian lexi_sasha_threesome_intro_0eccd4c3:
    lexi.say "Эй!"

# ch/harems/home/events/home_harem_lexi.rpy:1843
translate russian lexi_sasha_threesome_intro_4d1cab09:
    lexi.say "А как же я?!"

# ch/harems/home/events/home_harem_lexi.rpy:1844
translate russian lexi_sasha_threesome_intro_f26fd543:
    "Лекси почти запрыгивает Саше на спину."

# ch/harems/home/events/home_harem_lexi.rpy:1845
translate russian lexi_sasha_threesome_intro_1cdb429b_1:
    "Приземляется лицом ко мне и обеими руками хватает мой член."

# ch/harems/home/events/home_harem_lexi.rpy:1846
translate russian lexi_sasha_threesome_intro_6fc3ab09_1:
    "А потом бросается вперёд и берёт его в рот!"

# ch/harems/home/events/home_harem_lexi.rpy:1848
translate russian lexi_sasha_threesome_intro_a41717e9:
    sasha.say "Что..."

# ch/harems/home/events/home_harem_lexi.rpy:1849
translate russian lexi_sasha_threesome_intro_210d3488:
    sasha.say "Что происходит?!"

# ch/harems/home/events/home_harem_lexi.rpy:1850
translate russian lexi_sasha_threesome_intro_28eea78e:
    mike.say "Лекси..."

# ch/harems/home/events/home_harem_lexi.rpy:1851
translate russian lexi_sasha_threesome_intro_7b33dbe6:
    mike.say "Я уже на последних силах!"

# ch/harems/home/events/home_harem_lexi.rpy:1852
translate russian lexi_sasha_threesome_intro_a309ad3c_1:
    mike.say "Ох, блядь!"

# ch/harems/home/events/home_harem_lexi.rpy:1853
translate russian lexi_sasha_threesome_intro_dc770920_1:
    mike.say "М-м-м..."

# ch/harems/home/events/home_harem_lexi.rpy:1854
translate russian lexi_sasha_threesome_intro_15ea5f70_1:
    "Саша протестует слишком поздно."

# ch/harems/home/events/home_harem_lexi.rpy:1855
translate russian lexi_sasha_threesome_intro_4a5c72a0_1:
    "Потому что Лекси уже вовсю занята делом."

# ch/harems/home/events/home_harem_lexi.rpy:1856
translate russian lexi_sasha_threesome_intro_4f34bdeb_1:
    "А я не собираюсь останавливать её, пока она сосёт мой член!"

# ch/harems/home/events/home_harem_lexi.rpy:1857
translate russian lexi_sasha_threesome_intro_cc2e5691_1:
    "Лекси тоже не теряет времени."

# ch/harems/home/events/home_harem_lexi.rpy:1858
translate russian lexi_sasha_threesome_intro_adf20849:
    "Наверное, опасаясь, что Саша рухнет под ней, она сразу берётся за дело."

# ch/harems/home/events/home_harem_lexi.rpy:1859
translate russian lexi_sasha_threesome_intro_71d6adc5_1:
    "Её голова движется вверх-вниз с почти пугающей скоростью."

# ch/harems/home/events/home_harem_lexi.rpy:1860
translate russian lexi_sasha_threesome_intro_4c15a371_1:
    "Но на качестве это, похоже, никак не сказывается."

# ch/harems/home/events/home_harem_lexi.rpy:1861
translate russian lexi_sasha_threesome_intro_6fce9b57_1:
    "Вскоре от её стараний я уже задыхаюсь и тяжело дышу."

# ch/harems/home/events/home_harem_lexi.rpy:1862
translate russian lexi_sasha_threesome_intro_c94cacf5_1:
    "Лекси мастерски пускает в ход губы, язык и зубы."

# ch/harems/home/events/home_harem_lexi.rpy:1863
translate russian lexi_sasha_threesome_intro_846caeeb_1:
    "А я могу лишь всё это время крепко держаться за Сашу."

# ch/harems/home/events/home_harem_lexi.rpy:1864
translate russian lexi_sasha_threesome_intro_bc71b10e_1:
    sasha.say "Лекси!"

# ch/harems/home/events/home_harem_lexi.rpy:1865
translate russian lexi_sasha_threesome_intro_1855b7c6:
    sasha.say "Лекси, ты мне спину сломаешь!"

# ch/harems/home/events/home_harem_lexi.rpy:1866
translate russian lexi_sasha_threesome_intro_56108914_1:
    mike.say "А-а..."

# ch/harems/home/events/home_harem_lexi.rpy:1867
translate russian lexi_sasha_threesome_intro_28eea78e_1:
    mike.say "Лекси..."

# ch/harems/home/events/home_harem_lexi.rpy:1868
translate russian lexi_sasha_threesome_intro_ffc99438:
    mike.say "Какого хрена?"

# ch/harems/home/events/home_harem_lexi.rpy:1869
translate russian lexi_sasha_threesome_intro_4440e254:
    mike.say "Я сейчас опять кончу!"

# ch/harems/home/events/home_harem_lexi.rpy:1870
translate russian lexi_sasha_threesome_intro_c3661650_1:
    "Словно боясь, что её сбросят, Лекси удваивает усилия."

# ch/harems/home/events/home_harem_lexi.rpy:1871
translate russian lexi_sasha_threesome_intro_49457dcc_1:
    "Я чувствую, как она безжалостно сжимает мои яйца."

# ch/harems/home/events/home_harem_lexi.rpy:1872
translate russian lexi_sasha_threesome_intro_cc0cc5bc_1:
    mike.say "БЛЯДЬ!"

# ch/harems/home/events/home_harem_lexi.rpy:1873
translate russian lexi_sasha_threesome_intro_8ed7de59_1:
    mike.say "ЛЕКСИ!"

# ch/harems/home/events/home_harem_lexi.rpy:1876
translate russian lexi_sasha_threesome_intro_00484597_1:
    "Никогда в жизни я так не хотел иметь два члена, как сейчас!"

# ch/harems/home/events/home_harem_lexi.rpy:1877
translate russian lexi_sasha_threesome_intro_e7ee30a2_1:
    "Если я кончу в рот или в киску, кто-то останется обделённым."

# ch/harems/home/events/home_harem_lexi.rpy:1878
translate russian lexi_sasha_threesome_intro_af2993f9_1:
    "Поэтому решаю, что лучше слегка разочаровать обеих, чем по-настоящему разозлить одну."

# ch/harems/home/events/home_harem_lexi.rpy:1879
translate russian lexi_sasha_threesome_intro_ba53d5d2_1:
    "Лекси удивлённо смотрит на меня, когда я вынимаю член из её рта."

# ch/harems/home/events/home_harem_lexi.rpy:1880
translate russian lexi_sasha_threesome_intro_a2b415e5_1:
    "В тот же момент Саша оглядывается через плечо."

# ch/harems/home/events/home_harem_lexi.rpy:1884
translate russian lexi_sasha_threesome_intro_c98c24fb_1:
    "Я едва успеваю устроить обеих на полу перед собой."

# ch/harems/home/events/home_harem_lexi.rpy:1885
translate russian lexi_sasha_threesome_intro_7ec034a4_3:
    "И очень вовремя: через мгновение я кончаю."

# ch/harems/home/events/home_harem_lexi.rpy:1887
translate russian lexi_sasha_threesome_intro_fedfd6d2_3:
    "Лекси и Саша терпеливо ждут, пока я изольюсь."

# ch/harems/home/events/home_harem_lexi.rpy:1889
translate russian lexi_sasha_threesome_intro_0e353a8c_3:
    "А потом закрывают глаза, когда на них обрушиваются брызги."

# ch/harems/home/events/home_harem_lexi.rpy:1893
translate russian lexi_sasha_threesome_intro_e947afec_3:
    "Сперма попадает на щёки и начинает стекать с подбородков."

# ch/harems/home/events/home_harem_lexi.rpy:1894
translate russian lexi_sasha_threesome_intro_31e270a6_3:
    "Они хихикают, слизывая её с губ."

# ch/harems/home/events/home_harem_lexi.rpy:1896
translate russian lexi_sasha_threesome_intro_ded80c83_1:
    "Лекси, кажется, не слышит ни слова."

# ch/harems/home/events/home_harem_lexi.rpy:1897
translate russian lexi_sasha_threesome_intro_14dcaf84_1:
    "Но потом я понимаю: она чего-то ждёт."

# ch/harems/home/events/home_harem_lexi.rpy:1898
translate russian lexi_sasha_threesome_intro_22ec684b_1:
    "Через мгновение я изливаюсь ей в рот."

# ch/harems/home/events/home_harem_lexi.rpy:1901
translate russian lexi_sasha_threesome_intro_43fa07e9_1:
    "Лекси глотает без видимых усилий, принимая всё разом."

# ch/harems/home/events/home_harem_lexi.rpy:1903
translate russian lexi_sasha_threesome_intro_e6cacf68_1:
    "Она жадно проглатывает всё, что я могу дать."

# ch/harems/home/events/home_harem_lexi.rpy:1905
translate russian lexi_sasha_threesome_intro_894cc3a0_1:
    "И не отпускает меня, пока не получит последнюю каплю."

# ch/harems/home/events/home_harem_lexi.rpy:1909
translate russian lexi_sasha_threesome_intro_281d8b0f:
    "После этого все трое остаются без сил."

# ch/harems/home/events/home_harem_lexi.rpy:1910
translate russian lexi_sasha_threesome_intro_52073729:
    "Можем лишь лежать на кровати, переплетаясь руками и ногами."

# ch/harems/home/events/home_harem_lexi.rpy:1911
translate russian lexi_sasha_threesome_intro_b1c2bd18:
    "Говорить ничего не нужно."

# ch/harems/home/events/home_harem_lexi.rpy:1912
translate russian lexi_sasha_threesome_intro_3c3635df:
    "Да и сомневаюсь, что у кого-то получилось бы."

# ch/harems/home/events/home_harem_lexi.rpy:1913
translate russian lexi_sasha_threesome_intro_00ec16bc:
    "Так и лежим, наслаждаясь общим блаженством после секса."

# ch/harems/home/events/home_harem_lexi.rpy:1922
translate russian lexi_sasha_alternative_nightclub_e3c7d6d7:
    "Не помню, кто из нас предложил сегодня пойти в клуб."

# ch/harems/home/events/home_harem_lexi.rpy:1923
translate russian lexi_sasha_alternative_nightclub_9b826a7b:
    "Да и какой именно клуб мы выбрали, я представляю довольно смутно."

# ch/harems/home/events/home_harem_lexi.rpy:1924
translate russian lexi_sasha_alternative_nightclub_c1bace45:
    "Даже не улавливаю, что за музыка играет, хотя уже стою на танцполе."

# ch/harems/home/events/home_harem_lexi.rpy:1926
translate russian lexi_sasha_alternative_nightclub_6ba51794:
    "Всё потому, что я полностью сосредоточен на Саше."

# ch/harems/home/events/home_harem_lexi.rpy:1927
translate russian lexi_sasha_alternative_nightclub_4a77ceb9:
    "Она завладела всем моим вниманием на целый вечер."

# ch/harems/home/events/home_harem_lexi.rpy:1928
translate russian lexi_sasha_alternative_nightclub_42d2a7be:
    "А теперь, когда она двигается в такт музыке, я словно загипнотизирован."

# ch/harems/home/events/home_harem_lexi.rpy:1929
translate russian lexi_sasha_alternative_nightclub_3f42882b:
    "Мы танцуем молча: слова нам не нужны."

# ch/harems/home/events/home_harem_lexi.rpy:1931
translate russian lexi_sasha_alternative_nightclub_a46b237f:
    "Саша ведёт, я следую за ней, и меня это вполне устраивает."

# ch/harems/home/events/home_harem_lexi.rpy:1932
translate russian lexi_sasha_alternative_nightclub_56a2dc59:
    "Я уже изрядно навеселе и с удовольствием позволяю вести себя."

# ch/harems/home/events/home_harem_lexi.rpy:1933
translate russian lexi_sasha_alternative_nightclub_16ec4667:
    "А Саше, кажется, нравится заставлять меня плясать под её дудку."

# ch/harems/home/events/home_harem_lexi.rpy:1934
translate russian lexi_sasha_alternative_nightclub_e0fa7947:
    "Каждое её движение заставляет меня поспешно следовать за ней."

# ch/harems/home/events/home_harem_lexi.rpy:1936
translate russian lexi_sasha_alternative_nightclub_9db95655:
    "Но каким-то образом она всё время остаётся чуть вне досягаемости."

# ch/harems/home/events/home_harem_lexi.rpy:1937
translate russian lexi_sasha_alternative_nightclub_ec4a399e:
    "Вскоре танец превращается в непрерывное поддразнивание."

# ch/harems/home/events/home_harem_lexi.rpy:1938
translate russian lexi_sasha_alternative_nightclub_70a582d8:
    "Саша манит меня своим телом, и я охотно клюю."

# ch/harems/home/events/home_harem_lexi.rpy:1939
translate russian lexi_sasha_alternative_nightclub_faa3edd3:
    "А потом ловко изгибается и поворачивается, ускользая от моих рук."

# ch/harems/home/events/home_harem_lexi.rpy:1940
translate russian lexi_sasha_alternative_nightclub_87cf64cd:
    "Кажется, это длится вечность: для моего затуманенного сознания время ничего не значит."

# ch/harems/home/events/home_harem_lexi.rpy:1941
translate russian lexi_sasha_alternative_nightclub_02788bf4:
    "Но потом я чувствую, как в наш общий мир вторгается кто-то ещё."

# ch/harems/home/events/home_harem_lexi.rpy:1942
translate russian lexi_sasha_alternative_nightclub_0bb4093c:
    "Мой затуманенный мозг уже начал представлять Сашу какой-то сексуальной богиней."

# ch/harems/home/events/home_harem_lexi.rpy:1943
translate russian lexi_sasha_alternative_nightclub_73b2141c:
    "Мрачной, чувственной и всегда слегка недосягаемой."

# ch/harems/home/events/home_harem_lexi.rpy:1945
translate russian lexi_sasha_alternative_nightclub_8e0ccfd0:
    "Теперь на танцполе к нам присоединяется нечто больше похожее на божество разврата."

# ch/harems/home/events/home_harem_lexi.rpy:1946
translate russian lexi_sasha_alternative_nightclub_63f024cf:
    "Богиня чистой похоти, без стыда источающая феромоны."

# ch/harems/home/events/home_harem_lexi.rpy:1953
translate russian lexi_sasha_alternative_nightclub_8a1822af:
    "Конечно, это Лекси. Кто же ещё?"

# ch/harems/home/events/home_harem_lexi.rpy:1954
translate russian lexi_sasha_alternative_nightclub_1184f848:
    "Кстати, простите за все эти цветистые описания."

# ch/harems/home/events/home_harem_lexi.rpy:1955
translate russian lexi_sasha_alternative_nightclub_b52ee604:
    "Я уже изрядно поплыл, и это моё единственное оправдание..."

# ch/harems/home/events/home_harem_lexi.rpy:1956
translate russian lexi_sasha_alternative_nightclub_5b00fcca:
    "Если Саше нравилось водить меня за нос, то Лекси вовсе не так застенчива."

# ch/harems/home/events/home_harem_lexi.rpy:1958
translate russian lexi_sasha_alternative_nightclub_dffacd2d:
    "Даже не поздоровавшись, она прижимается ко мне как можно теснее."

# ch/harems/home/events/home_harem_lexi.rpy:1959
translate russian lexi_sasha_alternative_nightclub_26026673:
    "Чёрт, она даже оседлала моё бедро и бесстыдно трётся о него!"

# ch/harems/home/events/home_harem_lexi.rpy:1960
translate russian lexi_sasha_alternative_nightclub_02425091:
    "В таком состоянии я невольно тянусь к ней, отвлекаясь от Саши."

# ch/harems/home/events/home_harem_lexi.rpy:1961
translate russian lexi_sasha_alternative_nightclub_6029fdee:
    "Как парень, которого запах жирного бургера заставляет забыть об ужине со стейком..."

# ch/harems/home/events/home_harem_lexi.rpy:1963
translate russian lexi_sasha_alternative_nightclub_007aa065:
    "Но прежде чем я успеваю совсем забыть о Саше, она встаёт между мной и Лекси."

# ch/harems/home/events/home_harem_lexi.rpy:1964
translate russian lexi_sasha_alternative_nightclub_a621067e:
    "Она не настолько груба, чтобы просто оттолкнуть Лекси."

# ch/harems/home/events/home_harem_lexi.rpy:1965
translate russian lexi_sasha_alternative_nightclub_487cbd29:
    "Вместо этого начинает играть по её правилам."

# ch/harems/home/events/home_harem_lexi.rpy:1966
translate russian lexi_sasha_alternative_nightclub_4aee15af:
    "Так на каждой из моих ног оказывается по девушке."

# ch/harems/home/events/home_harem_lexi.rpy:1967
translate russian lexi_sasha_alternative_nightclub_5130a8ab:
    "Я кручу головой, пытаясь смотреть на обеих сразу."

# ch/harems/home/events/home_harem_lexi.rpy:1968
translate russian lexi_sasha_alternative_nightclub_54649f0c:
    "Выбрать между ними невозможно, как и сказать, что одна сексуальнее другой."

# ch/harems/home/events/home_harem_lexi.rpy:1969
translate russian lexi_sasha_alternative_nightclub_b26e04cc:
    "Лекси просто сочится бесстыдной похотью, и я безумно её хочу."

# ch/harems/home/events/home_harem_lexi.rpy:1970
translate russian lexi_sasha_alternative_nightclub_6c063749:
    "Но теперь и Саша взялась за дело, доводя мой член до болезненной твёрдости."

# ch/harems/home/events/home_harem_lexi.rpy:1971
translate russian lexi_sasha_alternative_nightclub_9995c2c5:
    "Если так продолжится, я ведь кончу прямо в трусы!"

# ch/harems/home/events/home_harem_lexi.rpy:1974
translate russian lexi_sasha_alternative_nightclub_25d29b7f:
    "Тут я замечаю, как Лекси и Саша переглядываются."

# ch/harems/home/events/home_harem_lexi.rpy:1975
translate russian lexi_sasha_alternative_nightclub_99549aab:
    "Ни слова, но, кажется, они прекрасно понимают друг друга."

# ch/harems/home/events/home_harem_lexi.rpy:1978
translate russian lexi_sasha_alternative_nightclub_2b651714:
    "И вот они уже объединяют усилия."

# ch/harems/home/events/home_harem_lexi.rpy:1979
translate russian lexi_sasha_alternative_nightclub_256f1817:
    "Словно две похотливые змеи, они начинают обвиваться вокруг меня."

# ch/harems/home/events/home_harem_lexi.rpy:1998
translate russian lexi_sasha_alternative_nightclub_ab5aa7bb:
    "Лекси и Саша кружат вокруг, прижимаясь как можно теснее."

# ch/harems/home/events/home_harem_lexi.rpy:1999
translate russian lexi_sasha_alternative_nightclub_cfde6cdc:
    "Их руки всё время ласкают, гладят и сжимают."

# ch/harems/home/events/home_harem_lexi.rpy:2001
translate russian lexi_sasha_alternative_nightclub_5e8bacd2:
    "И очень скоро я теряю контроль."

# ch/harems/home/events/home_harem_lexi.rpy:2002
translate russian lexi_sasha_alternative_nightclub_e3605209:
    "Стою на танцполе, хватая ртом воздух, и радуюсь, что надел тёмные брюки."

# ch/harems/home/events/home_harem_lexi.rpy:2003
translate russian lexi_sasha_alternative_nightclub_e47b1e41:
    "Даже сквозь грохот музыки слышу, как Лекси и Саша смеются над моим положением..."

# ch/harems/home/events/home_harem_lexi.rpy:2044
translate russian bree_lexi_pregnant_showdown_30789051:
    "[lssb_homelexi.bree_name()] и я болтаем обо всём и ни о чём, когда мимо проходит Лекси."

# ch/harems/home/events/home_harem_lexi.rpy:2048
translate russian bree_lexi_pregnant_showdown_07ce4b75:
    "[lssb_homelexi.bree_name()] на мгновение замолкает и сверлит девушку суровым взглядом."

# ch/harems/home/events/home_harem_lexi.rpy:2050
translate russian bree_lexi_pregnant_showdown_2d41ce63:
    "Я тут же чувствую, как от страха сжимаются ягодицы."

# ch/harems/home/events/home_harem_lexi.rpy:2052
translate russian bree_lexi_pregnant_showdown_b36285c1:
    "Ведь до сих пор мне удавалось скрывать, что я трахаюсь с обеими."

# ch/harems/home/events/home_harem_lexi.rpy:2054
translate russian bree_lexi_pregnant_showdown_6b09b8f4:
    "И для этого очень важно держать их подальше друг от друга."

# ch/harems/home/events/home_harem_lexi.rpy:2055
translate russian bree_lexi_pregnant_showdown_f9118b25:
    "Так что сейчас, когда [lssb_homelexi.bree_name()] прожигает Лекси взглядом, всё идёт совсем не по плану!"

# ch/harems/home/events/home_harem_lexi.rpy:2060
translate russian bree_lexi_pregnant_showdown_e5ef42e1:
    bree.say "Какая же она помойная девка!"

# ch/harems/home/events/home_harem_lexi.rpy:2061
translate russian bree_lexi_pregnant_showdown_6387b773:
    bree.say "Похоже, беременна."

# ch/harems/home/events/home_harem_lexi.rpy:2063
translate russian bree_lexi_pregnant_showdown_55c6f4a2:
    bree.say "И спорим, даже не знает, кто отец!"

# ch/harems/home/events/home_harem_lexi.rpy:2065
translate russian bree_lexi_pregnant_showdown_76d50394:
    mike.say "Тебе бы говорить потише, [lssb_homelexi.bree_name()]!"

# ch/harems/home/events/home_harem_lexi.rpy:2067
translate russian bree_lexi_pregnant_showdown_ca184174:
    "Бри поворачивается ко мне с нескрываемым удивлением."

# ch/harems/home/events/home_harem_lexi.rpy:2068
translate russian bree_lexi_pregnant_showdown_d1fbba3f:
    bree.say "И почему меня должно волновать, услышит ли эта потаскуха?"

# ch/harems/home/events/home_harem_lexi.rpy:2069
translate russian bree_lexi_pregnant_showdown_94ed5adb:
    lexi.say "А должно бы волновать, [lssb_homelexi.bree_name()]!"

# ch/harems/home/events/home_harem_lexi.rpy:2070
translate russian bree_lexi_pregnant_showdown_0be78876:
    lexi.say "Потому что эта потаскуха тебя, блядь, СЛЫШИТ!"

# ch/harems/home/events/home_harem_lexi.rpy:2074
translate russian bree_lexi_pregnant_showdown_2d0c346b:
    "Я оборачиваюсь и вижу Лекси рядом с нами."

# ch/harems/home/events/home_harem_lexi.rpy:2075
translate russian bree_lexi_pregnant_showdown_a54a5c94:
    "Она хмурится и держит руки скрещёнными на груди."

# ch/harems/home/events/home_harem_lexi.rpy:2076
translate russian bree_lexi_pregnant_showdown_882324c4:
    "Всё указывает на то, что сейчас начнётся скандал!"

# ch/harems/home/events/home_harem_lexi.rpy:2077
translate russian bree_lexi_pregnant_showdown_39005a02:
    mike.say "Девушки, девушки..."

# ch/harems/home/events/home_harem_lexi.rpy:2078
translate russian bree_lexi_pregnant_showdown_e3e6d28a:
    mike.say "Незачем так!"

# ch/harems/home/events/home_harem_lexi.rpy:2079
translate russian bree_lexi_pregnant_showdown_4e3d7891:
    mike.say "Ведь правда?"

# ch/harems/home/events/home_harem_lexi.rpy:2080
translate russian bree_lexi_pregnant_showdown_666a9761:
    "[lssb_homelexi.bree_name()] и Лекси обе фыркают."

# ch/harems/home/events/home_harem_lexi.rpy:2081
translate russian bree_lexi_pregnant_showdown_98054e9c:
    "Но первой вступает [lssb_homelexi.bree_name()]."

# ch/harems/home/events/home_harem_lexi.rpy:2082
translate russian bree_lexi_pregnant_showdown_9739c8a7:
    bree.say "Чего она злится, [lssb_common.hero_name()]?"

# ch/harems/home/events/home_harem_lexi.rpy:2084
translate russian bree_lexi_pregnant_showdown_d78438e7:
    bree.say "Я всего лишь сказала очевидное."

# ch/harems/home/events/home_harem_lexi.rpy:2085
translate russian bree_lexi_pregnant_showdown_a2aa47ce:
    bree.say "Она беременна и она шлюха!"

# ch/harems/home/events/home_harem_lexi.rpy:2086
translate russian bree_lexi_pregnant_showdown_fcd081e7:
    bree.say "С этим не поспоришь!"

# ch/harems/home/events/home_harem_lexi.rpy:2087
translate russian bree_lexi_pregnant_showdown_6a15c488:
    "Не успеваю я сказать хоть слово, как Лекси отвечает."

# ch/harems/home/events/home_harem_lexi.rpy:2089
translate russian bree_lexi_pregnant_showdown_64288615:
    lexi.say "Ты правда позволишь ей так со мной разговаривать?"

# ch/harems/home/events/home_harem_lexi.rpy:2090
translate russian bree_lexi_pregnant_showdown_a37f5f07:
    lexi.say "Ты не собираешься меня защитить?"

# ch/harems/home/events/home_harem_lexi.rpy:2091
translate russian bree_lexi_pregnant_showdown_4301518a:
    lexi.say "И ребёнка тоже?!"

# ch/harems/home/events/home_harem_lexi.rpy:2094
translate russian bree_lexi_pregnant_showdown_d9cc89a8:
    bree.say "С чего бы ему?"

# ch/harems/home/events/home_harem_lexi.rpy:2095
translate russian bree_lexi_pregnant_showdown_1d2ad792:
    bree.say "Сомневаюсь, что ты сама знаешь, чей это ребёнок."

# ch/harems/home/events/home_harem_lexi.rpy:2096
translate russian bree_lexi_pregnant_showdown_717979c5:
    bree.say "А уж он тем более не знает!"

# ch/harems/home/events/home_harem_lexi.rpy:2098
translate russian bree_lexi_pregnant_showdown_4982d383:
    "С этого момента всё словно происходит в замедленной съёмке."

# ch/harems/home/events/home_harem_lexi.rpy:2099
translate russian bree_lexi_pregnant_showdown_a9c42cc5:
    "И я ничего не могу сделать, чтобы это остановить!"

# ch/harems/home/events/home_harem_lexi.rpy:2101
translate russian bree_lexi_pregnant_showdown_4b9f2a19:
    lexi.say "Конечно, я знаю, кто отец!"

# ch/harems/home/events/home_harem_lexi.rpy:2102
translate russian bree_lexi_pregnant_showdown_821301b0:
    lexi.say "И [lssb_common.hero_name()] тоже знает, потому что это он!"

# ch/harems/home/events/home_harem_lexi.rpy:2105
translate russian bree_lexi_pregnant_showdown_ec5300c0:
    "Бри открывает рот от изумления и поворачивается ко мне."

# ch/harems/home/events/home_harem_lexi.rpy:2106
translate russian bree_lexi_pregnant_showdown_80911cac:
    bree.say "Она ведь несёт чушь, правда?"

# ch/harems/home/events/home_harem_lexi.rpy:2107
translate russian bree_lexi_pregnant_showdown_cffddc4d:
    bree.say "[lssb_common.hero_name()], скажи, что она врёт!"

# ch/harems/home/events/home_harem_lexi.rpy:2108
translate russian bree_lexi_pregnant_showdown_4fb0a5cd:
    bree.say "Ты же не мог трахаться с ней, когда у нас серьёзные отношения!"

# ch/harems/home/events/home_harem_lexi.rpy:2109
translate russian bree_lexi_pregnant_showdown_71cb9a8c:
    "Теперь приходит очередь Лекси злиться."

# ch/harems/home/events/home_harem_lexi.rpy:2111
translate russian bree_lexi_pregnant_showdown_f7ce3bf3:
    lexi.say "Стоп, стоп, стоп..."

# ch/harems/home/events/home_harem_lexi.rpy:2112
translate russian bree_lexi_pregnant_showdown_f0b7bc10:
    lexi.say "Это МЫ с ним встречаемся!"

# ch/harems/home/events/home_harem_lexi.rpy:2113
translate russian bree_lexi_pregnant_showdown_a185350f:
    lexi.say "А с тобой он, значит, трахался на стороне!"

# ch/harems/home/events/home_harem_lexi.rpy:2115
translate russian bree_lexi_pregnant_showdown_f7dbc583:
    "Теперь обе смотрят на меня, требуя объяснений одним лишь взглядом."

# ch/harems/home/events/home_harem_lexi.rpy:2117
translate russian bree_lexi_pregnant_showdown_f75a85b5:
    mike.say "Вы меня поймали..."

# ch/harems/home/events/home_harem_lexi.rpy:2118
translate russian bree_lexi_pregnant_showdown_0ab4418e:
    mike.say "Я встречался с вами обеими одновременно."

# ch/harems/home/events/home_harem_lexi.rpy:2119
translate russian bree_lexi_pregnant_showdown_1edee430:
    mike.say "А теперь вы узнали, так что, видимо, всё кончено!"

# ch/harems/home/events/home_harem_lexi.rpy:2120
translate russian bree_lexi_pregnant_showdown_c2a386b9:
    "[lssb_homelexi.bree_name()] и Лекси по очереди оказываются под моим взглядом: жду, что они подтвердят мои слова."

# ch/harems/home/events/home_harem_lexi.rpy:2121
translate russian bree_lexi_pregnant_showdown_27fcb0e4:
    "Но, к моему удивлению, в их глазах словно появляется сомнение!"

# ch/harems/home/events/home_harem_lexi.rpy:2124
translate russian bree_lexi_pregnant_showdown_da39073f:
    bree.say "Я... понимаю, что это странно."

# ch/harems/home/events/home_harem_lexi.rpy:2125
translate russian bree_lexi_pregnant_showdown_de2b93ae:
    bree.say "Но я прощаю тебя, [lssb_common.hero_name()]."

# ch/harems/home/events/home_harem_lexi.rpy:2127
translate russian bree_lexi_pregnant_showdown_bfdf40eb:
    bree.say "Ты тоже человек, а все мы ошибаемся."

# ch/harems/home/events/home_harem_lexi.rpy:2129
translate russian bree_lexi_pregnant_showdown_1c1cf5e9:
    lexi.say "Знаешь что, [lssb_homelexi.bree_name()]..."

# ch/harems/home/events/home_harem_lexi.rpy:2131
translate russian bree_lexi_pregnant_showdown_6a01607e:
    lexi.say "Ты права!"

# ch/harems/home/events/home_harem_lexi.rpy:2132
translate russian bree_lexi_pregnant_showdown_23d7ca3d:
    lexi.say "Может, мы сможем во всём разобраться."

# ch/harems/home/events/home_harem_lexi.rpy:2133
translate russian bree_lexi_pregnant_showdown_baba17e6:
    "Ответы девушек ошеломляют меня."

# ch/harems/home/events/home_harem_lexi.rpy:2134
translate russian bree_lexi_pregnant_showdown_b8c40594:
    "Я был уверен, что обе немедленно меня бросят."

# ch/harems/home/events/home_harem_lexi.rpy:2135
translate russian bree_lexi_pregnant_showdown_19b70f05:
    "А они, кажется, находят выход прямо у меня на глазах!"

# ch/harems/home/events/home_harem_lexi.rpy:2136
translate russian bree_lexi_pregnant_showdown_ff830329:
    mike.say "Ну... конечно..."

# ch/harems/home/events/home_harem_lexi.rpy:2137
translate russian bree_lexi_pregnant_showdown_7433e3ea:
    mike.say "Конечно, мы разберёмся!"

# ch/harems/home/events/home_harem_lexi.rpy:2138
translate russian bree_lexi_pregnant_showdown_dc1efc71:
    mike.say "Я люблю вас обеих, правда!"

# ch/harems/home/events/home_harem_lexi.rpy:2142
translate russian bree_lexi_pregnant_showdown_d2f3910c:
    "Пока я всё это говорю, Бри и Лекси поглядывают друг на друга."

# ch/harems/home/events/home_harem_lexi.rpy:2143
translate russian bree_lexi_pregnant_showdown_fab858d5:
    "Словно ещё и оценивают друг друга!"

# ch/harems/home/events/home_harem_lexi.rpy:2144
translate russian bree_lexi_pregnant_showdown_1b59df79:
    bree.say "Ну..."

# ch/harems/home/events/home_harem_lexi.rpy:2145
translate russian bree_lexi_pregnant_showdown_70ed5751:
    bree.say "Я готова попробовать, если ты тоже, Лекси?"

# ch/harems/home/events/home_harem_lexi.rpy:2146
translate russian bree_lexi_pregnant_showdown_d33be89a:
    lexi.say "Я тоже, [lssb_homelexi.bree_name()]."

# ch/harems/home/events/home_harem_lexi.rpy:2147
translate russian bree_lexi_pregnant_showdown_b338c0af:
    "Я всё время киваю и улыбаюсь."

# ch/harems/home/events/home_harem_lexi.rpy:2148
translate russian bree_lexi_pregnant_showdown_452e6e12:
    "Отчасти потому, что очень хочу избежать ссоры."

# ch/harems/home/events/home_harem_lexi.rpy:2149
translate russian bree_lexi_pregnant_showdown_d0a2a41d:
    "Отчасти потому, что не верю своей удаче."

# ch/harems/home/events/home_harem_lexi.rpy:2150
translate russian bree_lexi_pregnant_showdown_79f5b81d:
    "Две девушки сразу!"

# ch/harems/home/events/home_harem_lexi.rpy:2151
translate russian bree_lexi_pregnant_showdown_cf46e99c:
    "И обе не против!"

# ch/harems/home/events/home_harem_lexi.rpy:2155
translate russian bree_lexi_pregnant_showdown_2c59b594:
    lexi.say "Да брось, [lssb_homelexi.bree_name()]..."

# ch/harems/home/events/home_harem_lexi.rpy:2157
translate russian bree_lexi_pregnant_showdown_b04c188f:
    lexi.say "Все мы люди!"

# ch/harems/home/events/home_harem_lexi.rpy:2158
translate russian bree_lexi_pregnant_showdown_1187c164:
    lexi.say "[lssb_common.hero_name()] просто ошибся, вот и всё."

# ch/harems/home/events/home_harem_lexi.rpy:2159
translate russian bree_lexi_pregnant_showdown_fb27ff5a:
    "От ответа Лекси я теряю дар речи."

# ch/harems/home/events/home_harem_lexi.rpy:2160
translate russian bree_lexi_pregnant_showdown_83acdbeb:
    "Я был уверен, что именно она бросит меня первой!"

# ch/harems/home/events/home_harem_lexi.rpy:2161
translate russian bree_lexi_pregnant_showdown_67b503f8:
    "Но [lssb_homelexi.bree_name()] от этих слов, кажется, злится ещё сильнее."

# ch/harems/home/events/home_harem_lexi.rpy:2163
translate russian bree_lexi_pregnant_showdown_58496605:
    bree.say "Ошибка — это ты, Лекси!"

# ch/harems/home/events/home_harem_lexi.rpy:2164
translate russian bree_lexi_pregnant_showdown_91af0377:
    bree.say "Одна большая ходячая ошибка!"

# ch/harems/home/events/home_harem_lexi.rpy:2165
translate russian bree_lexi_pregnant_showdown_422eed58:
    bree.say "Вы друг друга стоите!"

# ch/harems/home/events/home_harem_lexi.rpy:2166
translate russian bree_lexi_pregnant_showdown_1bfe2600:
    mike.say "Бри, пожалуйста..."

# ch/harems/home/events/home_harem_lexi.rpy:2167
translate russian bree_lexi_pregnant_showdown_eef56e84:
    mike.say "Давай поговорим, ладно?"

# ch/harems/home/events/home_harem_lexi.rpy:2168
translate russian bree_lexi_pregnant_showdown_f9b629b6:
    mike.say "Я уверен, мы сможем разобраться!"

# ch/harems/home/events/home_harem_lexi.rpy:2170
translate russian bree_lexi_pregnant_showdown_f2af4b67:
    "Бри резко разворачивается и уходит."

# ch/harems/home/events/home_harem_lexi.rpy:2171
translate russian bree_lexi_pregnant_showdown_0c5c065f:
    "Не обращая внимания на мои просьбы поговорить."

# ch/harems/home/events/home_harem_lexi.rpy:2176
translate russian bree_lexi_pregnant_showdown_da39073f_1:
    bree.say "Я... понимаю, что это странно."

# ch/harems/home/events/home_harem_lexi.rpy:2177
translate russian bree_lexi_pregnant_showdown_de2b93ae_1:
    bree.say "Но я прощаю тебя, [lssb_common.hero_name()]."

# ch/harems/home/events/home_harem_lexi.rpy:2179
translate russian bree_lexi_pregnant_showdown_bfdf40eb_1:
    bree.say "Ты тоже человек, а все мы ошибаемся."

# ch/harems/home/events/home_harem_lexi.rpy:2180
translate russian bree_lexi_pregnant_showdown_6e72ac85:
    "От ответа Бри я теряю дар речи."

# ch/harems/home/events/home_harem_lexi.rpy:2181
translate russian bree_lexi_pregnant_showdown_83acdbeb_1:
    "Я был уверен, что именно она бросит меня первой!"

# ch/harems/home/events/home_harem_lexi.rpy:2182
translate russian bree_lexi_pregnant_showdown_0da8fe87:
    "Но Лекси от этих слов, кажется, злится ещё сильнее."

# ch/harems/home/events/home_harem_lexi.rpy:2184
translate russian bree_lexi_pregnant_showdown_aaea249e:
    lexi.say "Ага, он уже ошибся, когда обрюхатил меня!"

# ch/harems/home/events/home_harem_lexi.rpy:2185
translate russian bree_lexi_pregnant_showdown_222bd82c:
    lexi.say "И совершит ещё одну ошибку, если не пошлёт тебя подальше!"

# ch/harems/home/events/home_harem_lexi.rpy:2187
translate russian bree_lexi_pregnant_showdown_5ee45102:
    mike.say "Лекси, пожалуйста..."

# ch/harems/home/events/home_harem_lexi.rpy:2188
translate russian bree_lexi_pregnant_showdown_eef56e84_1:
    mike.say "Давай поговорим, ладно?"

# ch/harems/home/events/home_harem_lexi.rpy:2189
translate russian bree_lexi_pregnant_showdown_f9b629b6_1:
    mike.say "Я уверен, мы сможем разобраться!"

# ch/harems/home/events/home_harem_lexi.rpy:2191
translate russian bree_lexi_pregnant_showdown_4599b9e1:
    "Лекси резко разворачивается и уходит."

# ch/harems/home/events/home_harem_lexi.rpy:2192
translate russian bree_lexi_pregnant_showdown_7e79b772:
    lexi.say "Нет, пожалуй, обойдусь!"

# ch/harems/home/events/home_harem_lexi.rpy:2193
translate russian bree_lexi_pregnant_showdown_08ca43a1:
    lexi.say "Вы друг друга стоите!"

# ch/harems/home/events/home_harem_lexi.rpy:2198
translate russian bree_lexi_pregnant_showdown_13c44c73:
    bree.say "Да пошли вы оба!"

# ch/harems/home/events/home_harem_lexi.rpy:2199
translate russian bree_lexi_pregnant_showdown_925e10b8:
    bree.say "Больше никогда не хочу вас видеть!"

# ch/harems/home/events/home_harem_lexi.rpy:2205
translate russian bree_lexi_pregnant_showdown_3daf8dc3:
    "В подтверждение своих слов Бри отвешивает мне сильную пощёчину."

# ch/harems/home/events/home_harem_lexi.rpy:2207
translate russian bree_lexi_pregnant_showdown_4abc355a:
    "Потом уносится прочь, а я пошатываюсь от удара."

# ch/harems/home/events/home_harem_lexi.rpy:2208
translate russian bree_lexi_pregnant_showdown_9485b8d6:
    "Но едва я начинаю приходить в себя, всё повторяется!"

# ch/harems/home/events/home_harem_lexi.rpy:2214
translate russian bree_lexi_pregnant_showdown_f4a39c65:
    "Лекси бьёт меня по другой щеке."

# ch/harems/home/events/home_harem_lexi.rpy:2216
translate russian bree_lexi_pregnant_showdown_41d2cac2:
    lexi.say "Ты ошибся, когда обрюхатил меня."

# ch/harems/home/events/home_harem_lexi.rpy:2217
translate russian bree_lexi_pregnant_showdown_637baea3:
    lexi.say "Но по-настоящему всё испортил, когда стал изменять за моей спиной!"

# ch/harems/home/events/home_harem_lexi.rpy:2218
translate russian bree_lexi_pregnant_showdown_d5dafacb:
    "[lssb_homelexi.bree_name()] подала пример, и Лекси следует ему."

# ch/harems/home/events/home_harem_lexi.rpy:2220
translate russian bree_lexi_pregnant_showdown_d276ec63:
    "Только уходит в противоположную сторону."

# ch/harems/home/events/home_harem_lexi.rpy:2221
translate russian bree_lexi_pregnant_showdown_a9d2f345:
    "А я остаюсь стоять один."

# ch/harems/home/events/home_harem_lexi.rpy:2222
translate russian bree_lexi_pregnant_showdown_d106af73:
    "Щёки горят от пощёчин."

# ch/harems/home/events/home_harem_lexi.rpy:2223
translate russian bree_lexi_pregnant_showdown_03207152:
    "А голова кружится оттого, что я потерял обеих."

# ch/harems/home/events/home_harem_lexi.rpy:2233
translate russian bree_lexi_minami_sasha_male_ending_54ddb2c0:
    "Трудно сопоставить моё первое впечатление о Лекси с тем, к чему мы пришли."

# ch/harems/home/events/home_harem_lexi.rpy:2234
translate russian bree_lexi_minami_sasha_male_ending_3a6742e6:
    "Ещё труднее поверить, что именно на ней я теперь собираюсь жениться!"

# ch/harems/home/events/home_harem_lexi.rpy:2235
translate russian bree_lexi_minami_sasha_male_ending_a59e8726:
    "Мне и так было непросто поверить, что [lssb_homelexi.bree_name()] или Саша согласилась встречаться со мной."

# ch/harems/home/events/home_harem_lexi.rpy:2236
translate russian bree_lexi_minami_sasha_male_ending_5bba9444:
    "А уж отношения с обеими одновременно казались безумием."

# ch/harems/home/events/home_harem_lexi.rpy:2237
translate russian bree_lexi_minami_sasha_male_ending_eb981212:
    "Но кто бы мог подумать, что я ещё и женюсь на своей бывшей приёмной сестре!"

# ch/harems/home/events/home_harem_lexi.rpy:2238
translate russian bree_lexi_minami_sasha_male_ending_9c12d21c:
    "Но в итоге она тоже к нам присоединилась, чего никто из нас не ожидал."

# ch/harems/home/events/home_harem_lexi.rpy:2239
translate russian bree_lexi_minami_sasha_male_ending_32ba74b4:
    "Я оглядываюсь через плечо на часовню, полную гостей."

# ch/harems/home/events/home_harem_lexi.rpy:2240
translate russian bree_lexi_minami_sasha_male_ending_156224f6:
    "Интересная компания, что и говорить: люди из самых разных слоёв общества."

# ch/harems/home/events/home_harem_lexi.rpy:2241
translate russian bree_lexi_minami_sasha_male_ending_22ef0d05:
    "Но то, что часовня практически полна, успокаивает меня."

# ch/harems/home/events/home_harem_lexi.rpy:2242
translate russian bree_lexi_minami_sasha_male_ending_0227bc14:
    "Как и то, что вокруг я вижу лишь улыбающиеся лица."

# ch/harems/home/events/home_harem_lexi.rpy:2243
translate russian bree_lexi_minami_sasha_male_ending_21099a95:
    "В этот момент звучит музыка, наполняя часовню."

# ch/harems/home/events/home_harem_lexi.rpy:2244
translate russian bree_lexi_minami_sasha_male_ending_0dafd144:
    "Словно по сигналу, все гости разом встают."

# ch/harems/home/events/home_harem_lexi.rpy:2245
translate russian bree_lexi_minami_sasha_male_ending_12c02527:
    "Я всё ещё смотрю назад, когда в проходе появляется свадебная процессия..."

# ch/harems/home/events/home_harem_lexi.rpy:2247
translate russian bree_lexi_minami_sasha_male_ending_4a54a48c:
    "Лекси — девушка, которую я всегда считал принцессой трейлерного парка."

# ch/harems/home/events/home_harem_lexi.rpy:2248
translate russian bree_lexi_minami_sasha_male_ending_0f4fcbdf:
    "Скажем так: сейчас она больше похожа на принцессу, чем когда-либо."

# ch/harems/home/events/home_harem_lexi.rpy:2249
translate russian bree_lexi_minami_sasha_male_ending_6f758de3:
    "Она навсегда останется оторвой из трущоб."

# ch/harems/home/events/home_harem_lexi.rpy:2250
translate russian bree_lexi_minami_sasha_male_ending_a7c0c352:
    "Но кто знал, что такая оторва может выглядеть настолько прекрасно?"

# ch/harems/home/events/home_harem_lexi.rpy:2252
translate russian bree_lexi_minami_sasha_male_ending_c331106b:
    "[lssb_homelexi.bree_name()] выбрала, пожалуй, самое традиционное платье: белое и воздушное."

# ch/harems/home/events/home_harem_lexi.rpy:2253
translate russian bree_lexi_minami_sasha_male_ending_2bca9ed8:
    "Но тепло её улыбки каким-то образом словно оживляет его."

# ch/harems/home/events/home_harem_lexi.rpy:2255
translate russian bree_lexi_minami_sasha_male_ending_3be013dd:
    "Саша — почти полная противоположность: чёрный наряд подчёркивает бледность её кожи."

# ch/harems/home/events/home_harem_lexi.rpy:2256
translate russian bree_lexi_minami_sasha_male_ending_a8521945:
    "Она столь же загадочна и интригующа, сколь [lssb_homelexi.bree_name()] открыта и искренна."

# ch/harems/home/events/home_harem_lexi.rpy:2258
translate russian bree_lexi_minami_sasha_male_ending_8827df17:
    "Следом идёт Минами, самая маленькая из четырёх, но самая жизнерадостная."

# ch/harems/home/events/home_harem_lexi.rpy:2259
translate russian bree_lexi_minami_sasha_male_ending_db67ac9c:
    "Её платье сшито из традиционного узорчатого шёлка."

# ch/harems/home/events/home_harem_lexi.rpy:2260
translate russian bree_lexi_minami_sasha_male_ending_47b2143c:
    "А вот крой современный и необычный, как она сама."

# ch/harems/home/events/home_harem_lexi.rpy:2262
translate russian bree_lexi_minami_sasha_male_ending_a9e8b716:
    "Наверное, при виде четырёх больших беременных животиков мне стоило бы нервничать и обливаться потом."

# ch/harems/home/events/home_harem_lexi.rpy:2263
translate russian bree_lexi_minami_sasha_male_ending_e51ee425:
    "И я понятия не имею, что думают сидящие на скамьях гости о том, что все девушки беременны одновременно."

# ch/harems/home/events/home_harem_lexi.rpy:2264
translate russian bree_lexi_minami_sasha_male_ending_19aaa830:
    "Но, честно говоря, мне всё равно: мы уже большая семья и скоро станем ещё больше!"

# ch/harems/home/events/home_harem_lexi.rpy:2266
translate russian bree_lexi_minami_sasha_male_ending_6f58d745:
    "[lssb_homelexi.bree_name()], Саша, Минами и Лекси стоят рядом со мной у алтаря, и я не могу оторвать от них глаз."

# ch/harems/home/events/home_harem_lexi.rpy:2267
translate russian bree_lexi_minami_sasha_male_ending_842ba36f:
    "Четыре мои невесты, которые скоро станут четырьмя моими жёнами!"

# ch/harems/home/events/home_harem_lexi.rpy:2270
translate russian bree_lexi_minami_sasha_male_ending_5fef35ec:
    "Платье, которое выбрала [lssb_homelexi.bree_name()], словно совершает маленькое чудо."

# ch/harems/home/events/home_harem_lexi.rpy:2271
translate russian bree_lexi_minami_sasha_male_ending_177f5e04:
    "Её живот уже огромный, но сейчас почти не виден!"

# ch/harems/home/events/home_harem_lexi.rpy:2272
translate russian bree_lexi_minami_sasha_male_ending_62fef82d:
    "Не то чтобы кто-то из нас хотел скрывать её беременность."

# ch/harems/home/events/home_harem_lexi.rpy:2274
translate russian bree_lexi_minami_sasha_male_ending_95facf6b:
    "Да, сегодня на Саше много макияжа, но даже под ним она выглядит бледной."

# ch/harems/home/events/home_harem_lexi.rpy:2275
translate russian bree_lexi_minami_sasha_male_ending_ffe176ba:
    "Взглянув на её округлившийся живот, я на миг беспокоюсь, не плохо ли ей."

# ch/harems/home/events/home_harem_lexi.rpy:2276
translate russian bree_lexi_minami_sasha_male_ending_5ebcd836:
    "Она словно замечает моё беспокойство и с улыбкой кивает, давая понять, что всё хорошо."

# ch/harems/home/events/home_harem_lexi.rpy:2278
translate russian bree_lexi_minami_sasha_male_ending_af935309:
    "Платье Минами никак не может скрыть её беременность."

# ch/harems/home/events/home_harem_lexi.rpy:2279
translate russian bree_lexi_minami_sasha_male_ending_b32a5c15:
    "Думаю, потому, что она с гордостью показывает её всем."

# ch/harems/home/events/home_harem_lexi.rpy:2280
translate russian bree_lexi_minami_sasha_male_ending_cc31697e:
    "Она безумно счастлива носить моего ребёнка, и я чувствую то же самое!"

# ch/harems/home/events/home_harem_lexi.rpy:2282
translate russian bree_lexi_minami_sasha_male_ending_56040797:
    "Девушка из трейлерного парка с беременным животом — настоящее клише."

# ch/harems/home/events/home_harem_lexi.rpy:2283
translate russian bree_lexi_minami_sasha_male_ending_4d942ad6:
    "Но почему-то Лекси от этого лишь желаннее, по крайней мере в моих глазах."

# ch/harems/home/events/home_harem_lexi.rpy:2284
translate russian bree_lexi_minami_sasha_male_ending_50f6e0f5:
    "Беременность ей так идёт, что я уверен: она станет замечательной матерью."

# ch/harems/home/events/home_harem_lexi.rpy:2285
translate russian bree_lexi_minami_sasha_male_ending_a7c8bf50:
    "Мы впятером едва успеваем обменяться взглядами и нервными улыбками."

# ch/harems/home/events/home_harem_lexi.rpy:2286
translate russian bree_lexi_minami_sasha_male_ending_742ce926:
    "Ведь священник начинает церемонию почти сразу, как смолкает музыка."

# ch/harems/home/events/home_harem_lexi.rpy:2288
translate russian bree_lexi_minami_sasha_male_ending_d601e095:
    "Священник" "Мы собрались здесь сегодня..."

# ch/harems/home/events/home_harem_lexi.rpy:2289
translate russian bree_lexi_minami_sasha_male_ending_c6369b62:
    "Священник" "Чтобы соединить этих ПЯТЕРЫХ узами священного брака!"

# ch/harems/home/events/home_harem_lexi.rpy:2290
translate russian bree_lexi_minami_sasha_male_ending_a63b4838:
    "В голосе священника слышится лёгкое раздражение, но прежде всего — веселье."

# ch/harems/home/events/home_harem_lexi.rpy:2291
translate russian bree_lexi_minami_sasha_male_ending_05a86f48:
    "Среди собравшихся гостей прокатывается одобрительный смешок."

# ch/harems/home/events/home_harem_lexi.rpy:2294
translate russian bree_lexi_minami_sasha_male_ending_96eeea33:
    "Даже мы впятером хихикаем и смеёмся, а кое-кто ещё и краснеет."

# ch/harems/home/events/home_harem_lexi.rpy:2295
translate russian bree_lexi_minami_sasha_male_ending_16055160:
    "Да, теперь это законно, но для всех участников всё ещё в новинку."

# ch/harems/home/events/home_harem_lexi.rpy:2296
translate russian bree_lexi_minami_sasha_male_ending_eb6fbdc0:
    "Полагаю, это лишь часть пути к тому, чтобы подобные браки стали привычными."

# ch/harems/home/events/home_harem_lexi.rpy:2297
translate russian bree_lexi_minami_sasha_male_ending_4435e419:
    "Священник погружается в церемонию, изо всех сил стараясь не запутаться."

# ch/harems/home/events/home_harem_lexi.rpy:2298
translate russian bree_lexi_minami_sasha_male_ending_eea83ee2:
    "И вскоре уже наступает время наших клятв!"

# ch/harems/home/events/home_harem_lexi.rpy:2299
translate russian bree_lexi_minami_sasha_male_ending_4d171257:
    "Священник" "Согласна ли ты, [lssb_homelexi.bree_name()], чтобы твоими законными супругами стали Саша, Минами, Лекси и [lssb_common.hero_name()]?"

# ch/harems/home/events/home_harem_lexi.rpy:2301
translate russian bree_lexi_minami_sasha_male_ending_9aa356a7:
    bree.say "О да, согласна!"

# ch/harems/home/events/home_harem_lexi.rpy:2302
translate russian bree_lexi_minami_sasha_male_ending_580970f0:
    "Священник" "Согласна ли ты, Саша, чтобы твоими законными супругами стали [lssb_homelexi.bree_name()], Минами, Лекси и [lssb_common.hero_name()]?"

# ch/harems/home/events/home_harem_lexi.rpy:2304
translate russian bree_lexi_minami_sasha_male_ending_4396f585:
    sasha.say "Ага, согласна."

# ch/harems/home/events/home_harem_lexi.rpy:2305
translate russian bree_lexi_minami_sasha_male_ending_5aa1567f:
    "Священник" "Согласна ли ты, Минами, чтобы твоими законными супругами стали [lssb_homelexi.bree_name()], Саша, Лекси и [lssb_common.hero_name()]?"

# ch/harems/home/events/home_harem_lexi.rpy:2307
translate russian bree_lexi_minami_sasha_male_ending_9619a9e8:
    minami.say "Конечно согласна!"

# ch/harems/home/events/home_harem_lexi.rpy:2308
translate russian bree_lexi_minami_sasha_male_ending_b21ac8ec:
    "Священник" "Согласна ли ты, Лекси, чтобы твоими законными супругами стали [lssb_homelexi.bree_name()], Саша, Минами и [lssb_common.hero_name()]?"

# ch/harems/home/events/home_harem_lexi.rpy:2310
translate russian bree_lexi_minami_sasha_male_ending_10053ed7:
    lexi.say "Чёрт возьми, да!"

# ch/harems/home/events/home_harem_lexi.rpy:2311
translate russian bree_lexi_minami_sasha_male_ending_2c9cd608:
    "Священник делает торжественную паузу и набирает в грудь воздух для последнего рывка."

# ch/harems/home/events/home_harem_lexi.rpy:2312
translate russian bree_lexi_minami_sasha_male_ending_d9b62570:
    "Священник" "А согласен ли ты, [lssb_common.hero_name()], чтобы твоими законными супругами стали [lssb_homelexi.bree_name()], Саша, Минами и Лекси?"

# ch/harems/home/events/home_harem_lexi.rpy:2313
translate russian bree_lexi_minami_sasha_male_ending_b3ea1ce2:
    "Теперь моя очередь так же глубоко вдохнуть перед ответом."

# ch/harems/home/events/home_harem_lexi.rpy:2314
translate russian bree_lexi_minami_sasha_male_ending_cc481164:
    mike.say "Согласен."

# ch/harems/home/events/home_harem_lexi.rpy:2315
translate russian bree_lexi_minami_sasha_male_ending_4ea8666d:
    "Священник кивает, явно радуясь, что церемония подходит к концу."

# ch/harems/home/events/home_harem_lexi.rpy:2316
translate russian bree_lexi_minami_sasha_male_ending_23a67ea2:
    "Священник" "Если кому-то из присутствующих известна законная причина, по которой эти пятеро не могут вступить в священный брак..."

# ch/harems/home/events/home_harem_lexi.rpy:2317
translate russian bree_lexi_minami_sasha_male_ending_fcd1be26:
    "Священник" "Пусть скажет сейчас или молчит вечно!"

# ch/harems/home/events/home_harem_lexi.rpy:2318
translate russian bree_lexi_minami_sasha_male_ending_307475a5:
    "Он окидывает взглядом гостей; наступает обычная пауза, слышатся нервные смешки."

# ch/harems/home/events/home_harem_lexi.rpy:2319
translate russian bree_lexi_minami_sasha_male_ending_94ce3ee4:
    "Секунды словно растягиваются, и я невольно начинаю нервничать."

# ch/harems/home/events/home_harem_lexi.rpy:2320
translate russian bree_lexi_minami_sasha_male_ending_e0d2268a:
    "[lssb_homelexi.bree_name()] стоит рядом, а я всё жду, что двери распахнутся и появятся её отец, Скотти, Дэнни или мои родители."

# ch/harems/home/events/home_harem_lexi.rpy:2321
translate russian bree_lexi_minami_sasha_male_ending_85899890:
    "Даже могу представить зловещий союз всех пятерых, объединившихся ради срыва нашей свадьбы!"

# ch/harems/home/events/home_harem_lexi.rpy:2322
translate russian bree_lexi_minami_sasha_male_ending_5360af04:
    "Но никто не вскакивает, чтобы остановить церемонию."

# ch/harems/home/events/home_harem_lexi.rpy:2323
translate russian bree_lexi_minami_sasha_male_ending_73e4c1d4:
    "Священник" "Объявляю вас мужем и жёнами."

# ch/harems/home/events/home_harem_lexi.rpy:2324
translate russian bree_lexi_minami_sasha_male_ending_5759a61b:
    "Священник" "Можете поцеловать невест."

# ch/harems/home/events/home_harem_lexi.rpy:2325
translate russian bree_lexi_minami_sasha_male_ending_a8d858b4:
    "Священник" "Или друг друга..."

# ch/harems/home/events/home_harem_lexi.rpy:2326
translate russian bree_lexi_minami_sasha_male_ending_354cecbd:
    "Священник" "Не уверен, как именно это должно происходить!"

# ch/harems/home/events/home_harem_lexi.rpy:2331
translate russian bree_lexi_minami_sasha_male_ending_1c36ca8f:
    "Мы тоже, поэтому просто сходимся в общих объятиях."

# ch/harems/home/events/home_harem_lexi.rpy:2332
translate russian bree_lexi_minami_sasha_male_ending_2cac46eb:
    "Мы целуем друг друга, и каждый поцелуй так же страстен, как предыдущий."

# ch/harems/home/events/home_harem_lexi.rpy:2333
translate russian bree_lexi_minami_sasha_male_ending_660c71ea:
    "И у нас получилось: мы пятеро действительно связали себя узами брака!"

# ch/harems/home/events/home_harem_lexi.rpy:2334
translate russian bree_lexi_minami_sasha_male_ending_55240a6e:
    "Теперь мы не прячемся за закрытыми дверями: наш союз пятерых признан законом!"

# ch/harems/home/events/home_harem_lexi.rpy:2339
translate russian bree_lexi_minami_sasha_male_ending_bcd115c8:
    sasha.say "Не волнуйтесь, девчонки."

# ch/harems/home/events/home_harem_lexi.rpy:2340
translate russian bree_lexi_minami_sasha_male_ending_6428325a:
    sasha.say "Это я беру на себя."

# ch/harems/home/events/home_harem_lexi.rpy:2342
translate russian bree_lexi_minami_sasha_male_ending_e84a1695:
    bree.say "Что? Что это значит?"

# ch/harems/home/events/home_harem_lexi.rpy:2343
translate russian bree_lexi_minami_sasha_male_ending_9dc71453:
    sasha.say "Ну, мы с [lssb_common.hero_name()] первыми стали жить вместе."

# ch/harems/home/events/home_harem_lexi.rpy:2344
translate russian bree_lexi_minami_sasha_male_ending_c896f494:
    sasha.say "Значит, я знаю его дольше всех."

# ch/harems/home/events/home_harem_lexi.rpy:2345
translate russian bree_lexi_minami_sasha_male_ending_33ac1836:
    bree.say "Эй, нет уж, Саша!"

# ch/harems/home/events/home_harem_lexi.rpy:2346
translate russian bree_lexi_minami_sasha_male_ending_68381a3d:
    bree.say "Разница от силы в пару дней."

# ch/harems/home/events/home_harem_lexi.rpy:2347
translate russian bree_lexi_minami_sasha_male_ending_27e4aa9b:
    bree.say "И [lssb_common.hero_name()] нашёл общий язык со мной раньше, чем с тобой!"

# ch/harems/home/events/home_harem_lexi.rpy:2349
translate russian bree_lexi_minami_sasha_male_ending_31392505:
    minami.say "Эм, вообще-то, тут есть очаровательная, бойкая и милая младшая сестрёнка!"

# ch/harems/home/events/home_harem_lexi.rpy:2350
translate russian bree_lexi_minami_sasha_male_ending_1e61a775:
    minami.say "Ни одна из вас не знает братишку так давно, как я."

# ch/harems/home/events/home_harem_lexi.rpy:2352
translate russian bree_lexi_minami_sasha_male_ending_aa5350be:
    lexi.say "Это мило, Минами."

# ch/harems/home/events/home_harem_lexi.rpy:2353
translate russian bree_lexi_minami_sasha_male_ending_d57d81e0:
    lexi.say "Но тебя он спасал из лап плохого парня?"

# ch/harems/home/events/home_harem_lexi.rpy:2354
translate russian bree_lexi_minami_sasha_male_ending_49915419:
    lexi.say "[lssb_common.hero_name()] надрал этому куску дерьма задницу."

# ch/harems/home/events/home_harem_lexi.rpy:2355
translate russian bree_lexi_minami_sasha_male_ending_c4c413df:
    lexi.say "И всё ради меня!"

# ch/harems/home/events/home_harem_lexi.rpy:2357
translate russian bree_lexi_minami_sasha_male_ending_d34a098d:
    minami.say "Я эту историю уже раз сто слышала!"

# ch/harems/home/events/home_harem_lexi.rpy:2358
translate russian bree_lexi_minami_sasha_male_ending_02c6c2be:
    lexi.say "Ладно, ладно. Но моя история всё равно потрясающая."

# ch/harems/home/events/home_harem_lexi.rpy:2359
translate russian bree_lexi_minami_sasha_male_ending_3bfe2203:
    sasha.say "Да, тут ты меня подловила, Лекси."

# ch/harems/home/events/home_harem_lexi.rpy:2360
translate russian bree_lexi_minami_sasha_male_ending_5fcac526:
    sasha.say "Мириться куда веселее, когда помимо тебя есть ещё четверо!"

# ch/harems/home/events/home_harem_lexi.rpy:2361
translate russian bree_lexi_minami_sasha_male_ending_6bef43bb:
    bree.say "О да!"

# ch/harems/home/events/home_harem_lexi.rpy:2362
translate russian bree_lexi_minami_sasha_male_ending_99d64a99:
    minami.say "Ещё как!"

# ch/harems/home/events/home_harem_lexi.rpy:2363
translate russian bree_lexi_minami_sasha_male_ending_1c87a942:
    lexi.say "Только четверо?"

# ch/harems/home/events/home_harem_lexi.rpy:2365
translate russian bree_lexi_minami_sasha_male_ending_cedfba81:
    bree.say "А нас, формально говоря, всё ещё пятеро?"

# ch/harems/home/events/home_harem_lexi.rpy:2366
translate russian bree_lexi_minami_sasha_male_ending_f21b4e54:
    sasha.say "Да, по пути мы, возможно, нечаянно превратились в целое племя!"

# ch/harems/home/events/home_harem_lexi.rpy:2367
translate russian bree_lexi_minami_sasha_male_ending_e5aa71d0:
    sasha.say "[lssb_common.hero_name()] мог бы стать основателем целого народа."

# ch/harems/home/events/home_harem_lexi.rpy:2368
translate russian bree_lexi_minami_sasha_male_ending_689bc470:
    lexi.say "Эм... странно!"

# ch/harems/home/events/home_harem_lexi.rpy:2369
translate russian bree_lexi_minami_sasha_male_ending_b06756a1:
    minami.say "Нет, это мило."

# ch/harems/home/events/home_harem_lexi.rpy:2370
translate russian bree_lexi_minami_sasha_male_ending_92b631e1:
    minami.say "Только братишке об этом, пожалуйста, не говорите."

# ch/harems/home/events/home_harem_lexi.rpy:2371
translate russian bree_lexi_minami_sasha_male_ending_2e05a821:
    lexi.say "Согласна, он и так о себе слишком высокого мнения!"

# ch/harems/home/events/home_harem_lexi.rpy:2373
translate russian bree_lexi_minami_sasha_male_ending_abb60c53:
    bree.say "Да, место для новых всегда найдётся!"

# ch/harems/home/events/home_harem_lexi.rpy:2374
translate russian bree_lexi_minami_sasha_male_ending_538f70f3:
    lexi.say "Парочку ещё втиснем, а?"

# ch/harems/home/events/home_harem_lexi.rpy:2375
translate russian bree_lexi_minami_sasha_male_ending_96074712:
    minami.say "Эм... к нам кто-то ещё переезжает?"

# ch/harems/home/events/home_harem_lexi.rpy:2376
translate russian bree_lexi_minami_sasha_male_ending_7df8c80f:
    sasha.say "Она о топоте маленьких ножек, Минами!"

# ch/harems/home/events/home_harem_lexi.rpy:2377
translate russian bree_lexi_minami_sasha_male_ending_29bd8a6e:
    bree.say "Ну, дети?"

# ch/harems/home/events/home_harem_lexi.rpy:2378
translate russian bree_lexi_minami_sasha_male_ending_f3137a95:
    minami.say "А-а..."

# ch/harems/home/events/home_harem_lexi.rpy:2381
translate russian bree_lexi_minami_sasha_male_ending_cc1cc395:
    bree.say "Да, не забывайте про Поппи."

# ch/harems/home/events/home_harem_lexi.rpy:2382
translate russian bree_lexi_minami_sasha_male_ending_3efb2b2d:
    bree.say "Она шумит за двоих!"

# ch/harems/home/events/home_harem_lexi.rpy:2384
translate russian bree_lexi_minami_sasha_male_ending_b6ac7e20:
    minami.say "Иногда я забываю, что Мэй — только моя дочь."

# ch/harems/home/events/home_harem_lexi.rpy:2385
translate russian bree_lexi_minami_sasha_male_ending_1ef5f78e:
    minami.say "Вы так хорошо с ней ладите, а она так сильно вас всех любит!"

# ch/harems/home/events/home_harem_lexi.rpy:2387
translate russian bree_lexi_minami_sasha_male_ending_1449b88d:
    sasha.say "Да, Далия у нас оторва."

# ch/harems/home/events/home_harem_lexi.rpy:2388
translate russian bree_lexi_minami_sasha_male_ending_baf2acfc:
    sasha.say "Но чего ещё ждать от ребёнка, у которого пять мам!"

# ch/harems/home/events/home_harem_lexi.rpy:2390
translate russian bree_lexi_minami_sasha_male_ending_1e9d576d:
    lexi.say "С Шантель и Тайроном такое чувство, будто их четверо, а не двое!"

# ch/harems/home/events/home_harem_lexi.rpy:2391
translate russian bree_lexi_minami_sasha_male_ending_3f1981c0:
    lexi.say "Хорошо, что у нас столько помощников."

# ch/harems/home/events/home_harem_lexi.rpy:2393
translate russian bree_lexi_minami_sasha_male_ending_4c887474:
    bree.say "Жаль, что мы не смогли остаться в старом доме."

# ch/harems/home/events/home_harem_lexi.rpy:2394
translate russian bree_lexi_minami_sasha_male_ending_78f3c08c:
    bree.say "Ну, там, где всё началось."

# ch/harems/home/events/home_harem_lexi.rpy:2395
translate russian bree_lexi_minami_sasha_male_ending_a622dc28:
    sasha.say "Да ну, там стало тесно ещё тогда, когда нас было только трое!"

# ch/harems/home/events/home_harem_lexi.rpy:2396
translate russian bree_lexi_minami_sasha_male_ending_f44578b5:
    sasha.say "Поэтому мы и сложились на новое жильё."

# ch/harems/home/events/home_harem_lexi.rpy:2397
translate russian bree_lexi_minami_sasha_male_ending_ef1ce951:
    minami.say "А я ОБОЖАЮ наш дом в пригороде — там всё есть!"

# ch/harems/home/events/home_harem_lexi.rpy:2398
translate russian bree_lexi_minami_sasha_male_ending_951fe4ac:
    lexi.say "А я всё ещё считаю, что надо было купить пару трейлеров."

# ch/harems/home/events/home_harem_lexi.rpy:2399
translate russian bree_lexi_minami_sasha_male_ending_1f34d526:
    lexi.say "Мы могли бы занять почти весь парк, где я жила..."

# ch/harems/home/events/home_harem_lexi.rpy:2400
translate russian bree_lexi_minami_sasha_male_ending_13a1a711:
    minami.say "Ох, Лекси, только не начинай опять!"

# ch/harems/home/events/home_harem_lexi.rpy:2401
translate russian bree_lexi_minami_sasha_male_ending_1ce2c7ac:
    bree.say "Впрочем, неважно, где мы живём."

# ch/harems/home/events/home_harem_lexi.rpy:2402
translate russian bree_lexi_minami_sasha_male_ending_a91b350b:
    bree.say "Главное, что мы все вместе."

# ch/harems/home/events/home_harem_lexi.rpy:2403
translate russian bree_lexi_minami_sasha_male_ending_cf606819:
    lexi.say "Да, и что нас четверо, а [lssb_common.hero_name()] один!"

# ch/harems/home/events/home_harem_lexi.rpy:2404
translate russian bree_lexi_minami_sasha_male_ending_df622dab:
    sasha.say "Бедняга, мне его почти жалко!"

# ch/harems/home/events/home_harem_lexi.rpy:2405
translate russian bree_lexi_minami_sasha_male_ending_84046577:
    minami.say "Ой, не говори глупостей."

# ch/harems/home/events/home_harem_lexi.rpy:2406
translate russian bree_lexi_minami_sasha_male_ending_8498f7bf:
    minami.say "На самом деле братишке всё это нравится!"

# ch/harems/home/events/home_harem_lexi.rpy:2416
translate russian bree_lexi_samantha_sasha_male_ending_b6dd4ca0:
    "Знаете, иногда жениться на четырёх девушках кажется мне самым нормальным и естественным делом на свете."

# ch/harems/home/events/home_harem_lexi.rpy:2417
translate russian bree_lexi_samantha_sasha_male_ending_c56a7d52:
    "Это законно, все мы более-менее вменяемые взрослые, всё по обоюдному согласию, и никого не шантажируют."

# ch/harems/home/events/home_harem_lexi.rpy:2418
translate russian bree_lexi_samantha_sasha_male_ending_790e88ea:
    "А с другой стороны, иногда я чувствую себя главой какой-то безумной секс-секты!"

# ch/harems/home/events/home_harem_lexi.rpy:2419
translate russian bree_lexi_samantha_sasha_male_ending_a59e8726:
    "Мне и так было непросто поверить, что [lssb_homelexi.bree_name()] или Саша согласилась встречаться со мной."

# ch/harems/home/events/home_harem_lexi.rpy:2420
translate russian bree_lexi_samantha_sasha_male_ending_5bba9444:
    "А уж отношения с обеими одновременно казались безумием."

# ch/harems/home/events/home_harem_lexi.rpy:2421
translate russian bree_lexi_samantha_sasha_male_ending_cd92cbae:
    "Сэм я тоже уже считал упущенной любовью."

# ch/harems/home/events/home_harem_lexi.rpy:2422
translate russian bree_lexi_samantha_sasha_male_ending_886f04a2:
    "В конце концов, она была замужем, а я уже состоял в трёх отношениях."

# ch/harems/home/events/home_harem_lexi.rpy:2423
translate russian bree_lexi_samantha_sasha_male_ending_e82ae9ee:
    "Но каким-то образом она не только узнала о нашем союзе втроём, но и присоединилась к нему!"

# ch/harems/home/events/home_harem_lexi.rpy:2424
translate russian bree_lexi_samantha_sasha_male_ending_d5b2c9a7:
    "А потом появилась Лекси..."

# ch/harems/home/events/home_harem_lexi.rpy:2425
translate russian bree_lexi_samantha_sasha_male_ending_3ba5b28b:
    "Ничего себе..."

# ch/harems/home/events/home_harem_lexi.rpy:2426
translate russian bree_lexi_samantha_sasha_male_ending_1541d91b:
    "Как вообще вписать такую, как Лекси, в какую-либо картину?"

# ch/harems/home/events/home_harem_lexi.rpy:2427
translate russian bree_lexi_samantha_sasha_male_ending_2a6e0736:
    "И уж тем более в то, что происходило между мной и четырьмя другими девушками?"

# ch/harems/home/events/home_harem_lexi.rpy:2428
translate russian bree_lexi_samantha_sasha_male_ending_89b5b050:
    "Но она каким-то образом просто вписалась, словно так и было задумано!"

# ch/harems/home/events/home_harem_lexi.rpy:2429
translate russian bree_lexi_samantha_sasha_male_ending_c83e54a3:
    "И приукрашивать для неё ничего не пришлось."

# ch/harems/home/events/home_harem_lexi.rpy:2430
translate russian bree_lexi_samantha_sasha_male_ending_c7556d3c:
    "Лекси сразу окунулась во всё это и чувствовала себя как рыба в воде!"

# ch/harems/home/events/home_harem_lexi.rpy:2431
translate russian bree_lexi_samantha_sasha_male_ending_c8e012fc:
    "В итоге всё получилось хорошо."

# ch/harems/home/events/home_harem_lexi.rpy:2432
translate russian bree_lexi_samantha_sasha_male_ending_c73b09f7:
    "Так хорошо, что мы решили оформить отношения официально."

# ch/harems/home/events/home_harem_lexi.rpy:2433
translate russian bree_lexi_samantha_sasha_male_ending_88d421ca:
    "Вот так я и оказался здесь."

# ch/harems/home/events/home_harem_lexi.rpy:2434
translate russian bree_lexi_samantha_sasha_male_ending_13910a5f:
    "У алтаря, в ожидании четырёх невест, идущих по проходу!"

# ch/harems/home/events/home_harem_lexi.rpy:2435
translate russian bree_lexi_samantha_sasha_male_ending_b6772f0f:
    "Даже когда начинает играть музыка, всё ещё не совсем верится в происходящее."

# ch/harems/home/events/home_harem_lexi.rpy:2436
translate russian bree_lexi_samantha_sasha_male_ending_6038f618:
    "Я даже подумываю ущипнуть себя, чтобы убедиться, что это не сон."

# ch/harems/home/events/home_harem_lexi.rpy:2437
translate russian bree_lexi_samantha_sasha_male_ending_6e24c6a2:
    "Но в итоге меня возвращает в реальность вид девушек, идущих ко мне."

# ch/harems/home/events/home_harem_lexi.rpy:2443
translate russian bree_lexi_samantha_sasha_male_ending_dd3a54a7:
    "[lssb_homelexi.bree_name()], Саша, Сэм и Лекси вместе идут по проходу."

# ch/harems/home/events/home_harem_lexi.rpy:2444
translate russian bree_lexi_samantha_sasha_male_ending_7b3381ed:
    "Они идут свободной группой, не превращая это в торжественную процессию."

# ch/harems/home/events/home_harem_lexi.rpy:2445
translate russian bree_lexi_samantha_sasha_male_ending_dc594502:
    "Так они выглядят как подруги, равные друг другу, и это меня радует."

# ch/harems/home/events/home_harem_lexi.rpy:2446
translate russian bree_lexi_samantha_sasha_male_ending_89768bc8:
    "Потому что шествие одной за другой сделало бы всё происходящее слишком уж странным!"

# ch/harems/home/events/home_harem_lexi.rpy:2447
translate russian bree_lexi_samantha_sasha_male_ending_5e6dfcb9:
    "Пока мы готовились к свадьбе, они решили держать свои платья в тайне."

# ch/harems/home/events/home_harem_lexi.rpy:2448
translate russian bree_lexi_samantha_sasha_male_ending_464070df:
    "И теперь, когда девушки идут ко мне, я впервые вижу их наряды."

# ch/harems/home/events/home_harem_lexi.rpy:2449
translate russian bree_lexi_samantha_sasha_male_ending_833bf424:
    "Все они разные, и каждый выбор идеально отражает характер своей хозяйки."

# ch/harems/home/events/home_harem_lexi.rpy:2451
translate russian bree_lexi_samantha_sasha_male_ending_c331106b:
    "[lssb_homelexi.bree_name()] выбрала, пожалуй, самое традиционное платье: белое и воздушное."

# ch/harems/home/events/home_harem_lexi.rpy:2452
translate russian bree_lexi_samantha_sasha_male_ending_2bca9ed8:
    "Но тепло её улыбки каким-то образом словно оживляет его."

# ch/harems/home/events/home_harem_lexi.rpy:2454
translate russian bree_lexi_samantha_sasha_male_ending_3be013dd:
    "Саша — почти полная противоположность: чёрный наряд подчёркивает бледность её кожи."

# ch/harems/home/events/home_harem_lexi.rpy:2455
translate russian bree_lexi_samantha_sasha_male_ending_a8521945:
    "Она столь же загадочна и интригующа, сколь [lssb_homelexi.bree_name()] открыта и искренна."

# ch/harems/home/events/home_harem_lexi.rpy:2457
translate russian bree_lexi_samantha_sasha_male_ending_72b86fa1:
    "Конечно, я уже видел Сэм в свадебном платье."

# ch/harems/home/events/home_harem_lexi.rpy:2458
translate russian bree_lexi_samantha_sasha_male_ending_fcf94b15:
    "Но стоит мне увидеть её в этом, как прежний образ сразу забывается."

# ch/harems/home/events/home_harem_lexi.rpy:2459
translate russian bree_lexi_samantha_sasha_male_ending_dcacadd4:
    "Почему-то у алтаря она выглядит в миллион раз прекраснее, чем из гостевых рядов!"

# ch/harems/home/events/home_harem_lexi.rpy:2461
translate russian bree_lexi_samantha_sasha_male_ending_014eb582:
    "А ещё Лекси, которую я всегда считал принцессой трейлерного парка."

# ch/harems/home/events/home_harem_lexi.rpy:2462
translate russian bree_lexi_samantha_sasha_male_ending_0f4fcbdf:
    "Скажем так: сейчас она больше похожа на принцессу, чем когда-либо."

# ch/harems/home/events/home_harem_lexi.rpy:2463
translate russian bree_lexi_samantha_sasha_male_ending_6f758de3:
    "Она навсегда останется оторвой из трущоб."

# ch/harems/home/events/home_harem_lexi.rpy:2464
translate russian bree_lexi_samantha_sasha_male_ending_a7c0c352:
    "Но кто знал, что такая оторва может выглядеть настолько прекрасно?"

# ch/harems/home/events/home_harem_lexi.rpy:2466
translate russian bree_lexi_samantha_sasha_male_ending_a9e8b716:
    "Наверное, при виде четырёх больших беременных животиков мне стоило бы нервничать и обливаться потом."

# ch/harems/home/events/home_harem_lexi.rpy:2467
translate russian bree_lexi_samantha_sasha_male_ending_e51ee425:
    "И я понятия не имею, что думают сидящие на скамьях гости о том, что все девушки беременны одновременно."

# ch/harems/home/events/home_harem_lexi.rpy:2468
translate russian bree_lexi_samantha_sasha_male_ending_19aaa830:
    "Но, честно говоря, мне всё равно: мы уже большая семья и скоро станем ещё больше!"

# ch/harems/home/events/home_harem_lexi.rpy:2470
translate russian bree_lexi_samantha_sasha_male_ending_65e598ff:
    "[lssb_homelexi.bree_name()], Саша, Сэм и Лекси стоят рядом со мной у алтаря, и я не могу оторвать от них глаз."

# ch/harems/home/events/home_harem_lexi.rpy:2471
translate russian bree_lexi_samantha_sasha_male_ending_842ba36f:
    "Четыре мои невесты, которые скоро станут четырьмя моими жёнами!"

# ch/harems/home/events/home_harem_lexi.rpy:2474
translate russian bree_lexi_samantha_sasha_male_ending_5fef35ec:
    "Платье, которое выбрала [lssb_homelexi.bree_name()], словно совершает маленькое чудо."

# ch/harems/home/events/home_harem_lexi.rpy:2475
translate russian bree_lexi_samantha_sasha_male_ending_177f5e04:
    "Её живот уже огромный, но сейчас почти не виден!"

# ch/harems/home/events/home_harem_lexi.rpy:2476
translate russian bree_lexi_samantha_sasha_male_ending_62fef82d:
    "Не то чтобы кто-то из нас хотел скрывать её беременность."

# ch/harems/home/events/home_harem_lexi.rpy:2478
translate russian bree_lexi_samantha_sasha_male_ending_95facf6b:
    "Да, сегодня на Саше много макияжа, но даже под ним она выглядит бледной."

# ch/harems/home/events/home_harem_lexi.rpy:2479
translate russian bree_lexi_samantha_sasha_male_ending_ffe176ba:
    "Взглянув на её округлившийся живот, я на миг беспокоюсь, не плохо ли ей."

# ch/harems/home/events/home_harem_lexi.rpy:2480
translate russian bree_lexi_samantha_sasha_male_ending_5ebcd836:
    "Она словно замечает моё беспокойство и с улыбкой кивает, давая понять, что всё хорошо."

# ch/harems/home/events/home_harem_lexi.rpy:2482
translate russian bree_lexi_samantha_sasha_male_ending_2e1b4ae8:
    "Кое-что сильно отличается от прошлого раза, когда я видел Сэм в свадебном платье."

# ch/harems/home/events/home_harem_lexi.rpy:2483
translate russian bree_lexi_samantha_sasha_male_ending_5e181f74:
    "А именно — её заметная беременность."

# ch/harems/home/events/home_harem_lexi.rpy:2484
translate russian bree_lexi_samantha_sasha_male_ending_4c136f0c:
    "Но, учитывая, чем закончился прошлый брак, думаю, это отличие только к лучшему!"

# ch/harems/home/events/home_harem_lexi.rpy:2486
translate russian bree_lexi_samantha_sasha_male_ending_56040797:
    "Девушка из трейлерного парка с беременным животом — настоящее клише."

# ch/harems/home/events/home_harem_lexi.rpy:2487
translate russian bree_lexi_samantha_sasha_male_ending_4d942ad6:
    "Но почему-то Лекси от этого лишь желаннее, по крайней мере в моих глазах."

# ch/harems/home/events/home_harem_lexi.rpy:2488
translate russian bree_lexi_samantha_sasha_male_ending_50f6e0f5:
    "Беременность ей так идёт, что я уверен: она станет замечательной матерью."

# ch/harems/home/events/home_harem_lexi.rpy:2489
translate russian bree_lexi_samantha_sasha_male_ending_a7c8bf50:
    "Мы впятером едва успеваем обменяться взглядами и нервными улыбками."

# ch/harems/home/events/home_harem_lexi.rpy:2490
translate russian bree_lexi_samantha_sasha_male_ending_742ce926:
    "Ведь священник начинает церемонию почти сразу, как смолкает музыка."

# ch/harems/home/events/home_harem_lexi.rpy:2496
translate russian bree_lexi_samantha_sasha_male_ending_d601e095:
    "Священник" "Мы собрались здесь сегодня..."

# ch/harems/home/events/home_harem_lexi.rpy:2497
translate russian bree_lexi_samantha_sasha_male_ending_c6369b62:
    "Священник" "Чтобы соединить этих ПЯТЕРЫХ узами священного брака!"

# ch/harems/home/events/home_harem_lexi.rpy:2498
translate russian bree_lexi_samantha_sasha_male_ending_a63b4838:
    "В голосе священника слышится лёгкое раздражение, но прежде всего — веселье."

# ch/harems/home/events/home_harem_lexi.rpy:2499
translate russian bree_lexi_samantha_sasha_male_ending_05a86f48:
    "Среди собравшихся гостей прокатывается одобрительный смешок."

# ch/harems/home/events/home_harem_lexi.rpy:2502
translate russian bree_lexi_samantha_sasha_male_ending_96eeea33:
    "Даже мы впятером хихикаем и смеёмся, а кое-кто ещё и краснеет."

# ch/harems/home/events/home_harem_lexi.rpy:2503
translate russian bree_lexi_samantha_sasha_male_ending_16055160:
    "Да, теперь это законно, но для всех участников всё ещё в новинку."

# ch/harems/home/events/home_harem_lexi.rpy:2504
translate russian bree_lexi_samantha_sasha_male_ending_eb6fbdc0:
    "Полагаю, это лишь часть пути к тому, чтобы подобные браки стали привычными."

# ch/harems/home/events/home_harem_lexi.rpy:2505
translate russian bree_lexi_samantha_sasha_male_ending_4435e419:
    "Священник погружается в церемонию, изо всех сил стараясь не запутаться."

# ch/harems/home/events/home_harem_lexi.rpy:2506
translate russian bree_lexi_samantha_sasha_male_ending_eea83ee2:
    "И вскоре уже наступает время наших клятв!"

# ch/harems/home/events/home_harem_lexi.rpy:2507
translate russian bree_lexi_samantha_sasha_male_ending_780daa22:
    "Священник" "Согласна ли ты, [lssb_homelexi.bree_name()], чтобы твоими законными супругами стали Саша, Сэм, Лекси и [lssb_common.hero_name()]?"

# ch/harems/home/events/home_harem_lexi.rpy:2509
translate russian bree_lexi_samantha_sasha_male_ending_9aa356a7:
    bree.say "О да, согласна!"

# ch/harems/home/events/home_harem_lexi.rpy:2510
translate russian bree_lexi_samantha_sasha_male_ending_46398e61:
    "Священник" "Согласна ли ты, Саша, чтобы твоими законными супругами стали [lssb_homelexi.bree_name()], Сэм, Лекси и [lssb_common.hero_name()]?"

# ch/harems/home/events/home_harem_lexi.rpy:2512
translate russian bree_lexi_samantha_sasha_male_ending_4396f585:
    sasha.say "Ага, согласна."

# ch/harems/home/events/home_harem_lexi.rpy:2513
translate russian bree_lexi_samantha_sasha_male_ending_d5014123:
    "Священник" "Согласна ли ты, Сэм, чтобы твоими законными супругами стали [lssb_homelexi.bree_name()], Саша, Лекси и [lssb_common.hero_name()]?"

# ch/harems/home/events/home_harem_lexi.rpy:2515
translate russian bree_lexi_samantha_sasha_male_ending_ea89efa9:
    samantha.say "Согласна."

# ch/harems/home/events/home_harem_lexi.rpy:2516
translate russian bree_lexi_samantha_sasha_male_ending_104caac1:
    "Священник" "Согласна ли ты, Лекси, чтобы твоими законными супругами стали [lssb_homelexi.bree_name()], Саша, Сэм и [lssb_common.hero_name()]?"

# ch/harems/home/events/home_harem_lexi.rpy:2518
translate russian bree_lexi_samantha_sasha_male_ending_10053ed7:
    lexi.say "Чёрт возьми, да!"

# ch/harems/home/events/home_harem_lexi.rpy:2519
translate russian bree_lexi_samantha_sasha_male_ending_2c9cd608:
    "Священник делает торжественную паузу и набирает в грудь воздух для последнего рывка."

# ch/harems/home/events/home_harem_lexi.rpy:2520
translate russian bree_lexi_samantha_sasha_male_ending_265568d8:
    "Священник" "А согласен ли ты, [lssb_common.hero_name()], чтобы твоими законными супругами стали [lssb_homelexi.bree_name()], Саша, Сэм и Лекси?"

# ch/harems/home/events/home_harem_lexi.rpy:2521
translate russian bree_lexi_samantha_sasha_male_ending_b3ea1ce2:
    "Теперь моя очередь так же глубоко вдохнуть перед ответом."

# ch/harems/home/events/home_harem_lexi.rpy:2522
translate russian bree_lexi_samantha_sasha_male_ending_cc481164:
    mike.say "Согласен."

# ch/harems/home/events/home_harem_lexi.rpy:2523
translate russian bree_lexi_samantha_sasha_male_ending_4ea8666d:
    "Священник кивает, явно радуясь, что церемония подходит к концу."

# ch/harems/home/events/home_harem_lexi.rpy:2524
translate russian bree_lexi_samantha_sasha_male_ending_23a67ea2:
    "Священник" "Если кому-то из присутствующих известна законная причина, по которой эти пятеро не могут вступить в священный брак..."

# ch/harems/home/events/home_harem_lexi.rpy:2525
translate russian bree_lexi_samantha_sasha_male_ending_fcd1be26:
    "Священник" "Пусть скажет сейчас или молчит вечно!"

# ch/harems/home/events/home_harem_lexi.rpy:2526
translate russian bree_lexi_samantha_sasha_male_ending_307475a5:
    "Он окидывает взглядом гостей; наступает обычная пауза, слышатся нервные смешки."

# ch/harems/home/events/home_harem_lexi.rpy:2527
translate russian bree_lexi_samantha_sasha_male_ending_94ce3ee4:
    "Секунды словно растягиваются, и я невольно начинаю нервничать."

# ch/harems/home/events/home_harem_lexi.rpy:2528
translate russian bree_lexi_samantha_sasha_male_ending_15842a10:
    "[lssb_homelexi.bree_name()] стоит рядом, а я всё жду, что двери распахнутся и появятся её отец, Скотти, Дэнни или Райан."

# ch/harems/home/events/home_harem_lexi.rpy:2529
translate russian bree_lexi_samantha_sasha_male_ending_8def1917:
    "Даже могу представить зловещий союз всех четверых, объединившихся ради срыва нашей свадьбы!"

# ch/harems/home/events/home_harem_lexi.rpy:2530
translate russian bree_lexi_samantha_sasha_male_ending_5360af04:
    "Но никто не вскакивает, чтобы остановить церемонию."

# ch/harems/home/events/home_harem_lexi.rpy:2531
translate russian bree_lexi_samantha_sasha_male_ending_73e4c1d4:
    "Священник" "Объявляю вас мужем и жёнами."

# ch/harems/home/events/home_harem_lexi.rpy:2532
translate russian bree_lexi_samantha_sasha_male_ending_5759a61b:
    "Священник" "Можете поцеловать невест."

# ch/harems/home/events/home_harem_lexi.rpy:2533
translate russian bree_lexi_samantha_sasha_male_ending_a8d858b4:
    "Священник" "Или друг друга..."

# ch/harems/home/events/home_harem_lexi.rpy:2534
translate russian bree_lexi_samantha_sasha_male_ending_354cecbd:
    "Священник" "Не уверен, как именно это должно происходить!"

# ch/harems/home/events/home_harem_lexi.rpy:2539
translate russian bree_lexi_samantha_sasha_male_ending_1c36ca8f:
    "Мы тоже, поэтому просто сходимся в общих объятиях."

# ch/harems/home/events/home_harem_lexi.rpy:2540
translate russian bree_lexi_samantha_sasha_male_ending_2cac46eb:
    "Мы целуем друг друга, и каждый поцелуй так же страстен, как предыдущий."

# ch/harems/home/events/home_harem_lexi.rpy:2541
translate russian bree_lexi_samantha_sasha_male_ending_660c71ea:
    "И у нас получилось: мы пятеро действительно связали себя узами брака!"

# ch/harems/home/events/home_harem_lexi.rpy:2542
translate russian bree_lexi_samantha_sasha_male_ending_55240a6e:
    "Теперь мы не прячемся за закрытыми дверями: наш союз пятерых признан законом!"

# ch/harems/home/events/home_harem_lexi.rpy:2547
translate russian bree_lexi_samantha_sasha_male_ending_bcd115c8:
    sasha.say "Не волнуйтесь, девчонки."

# ch/harems/home/events/home_harem_lexi.rpy:2548
translate russian bree_lexi_samantha_sasha_male_ending_6428325a:
    sasha.say "Это я беру на себя."

# ch/harems/home/events/home_harem_lexi.rpy:2550
translate russian bree_lexi_samantha_sasha_male_ending_e84a1695:
    bree.say "Что? Что это значит?"

# ch/harems/home/events/home_harem_lexi.rpy:2551
translate russian bree_lexi_samantha_sasha_male_ending_9dc71453:
    sasha.say "Ну, мы с [lssb_common.hero_name()] первыми стали жить вместе."

# ch/harems/home/events/home_harem_lexi.rpy:2552
translate russian bree_lexi_samantha_sasha_male_ending_c896f494:
    sasha.say "Значит, я знаю его дольше всех."

# ch/harems/home/events/home_harem_lexi.rpy:2553
translate russian bree_lexi_samantha_sasha_male_ending_33ac1836:
    bree.say "Эй, нет уж, Саша!"

# ch/harems/home/events/home_harem_lexi.rpy:2554
translate russian bree_lexi_samantha_sasha_male_ending_68381a3d:
    bree.say "Разница от силы в пару дней."

# ch/harems/home/events/home_harem_lexi.rpy:2555
translate russian bree_lexi_samantha_sasha_male_ending_27e4aa9b:
    bree.say "И [lssb_common.hero_name()] нашёл общий язык со мной раньше, чем с тобой!"

# ch/harems/home/events/home_harem_lexi.rpy:2557
translate russian bree_lexi_samantha_sasha_male_ending_69f20a0a:
    samantha.say "Вы двое серьёзно?"

# ch/harems/home/events/home_harem_lexi.rpy:2558
translate russian bree_lexi_samantha_sasha_male_ending_2dc74ec2:
    samantha.say "Мы с [lssb_common.hero_name()] жили вместе ещё до того, как вы появились на горизонте!"

# ch/harems/home/events/home_harem_lexi.rpy:2559
translate russian bree_lexi_samantha_sasha_male_ending_ef3c0601:
    samantha.say "И после моего переезда он всё время по мне сох."

# ch/harems/home/events/home_harem_lexi.rpy:2561
translate russian bree_lexi_samantha_sasha_male_ending_17c3c161:
    lexi.say "Это мило, Сэм."

# ch/harems/home/events/home_harem_lexi.rpy:2562
translate russian bree_lexi_samantha_sasha_male_ending_d57d81e0:
    lexi.say "Но тебя он спасал из лап плохого парня?"

# ch/harems/home/events/home_harem_lexi.rpy:2563
translate russian bree_lexi_samantha_sasha_male_ending_49915419:
    lexi.say "[lssb_common.hero_name()] надрал этому куску дерьма задницу."

# ch/harems/home/events/home_harem_lexi.rpy:2564
translate russian bree_lexi_samantha_sasha_male_ending_c4c413df:
    lexi.say "И всё ради меня!"

# ch/harems/home/events/home_harem_lexi.rpy:2565
translate russian bree_lexi_samantha_sasha_male_ending_79158450:
    samantha.say "Так мы ни к чему не придём."

# ch/harems/home/events/home_harem_lexi.rpy:2566
translate russian bree_lexi_samantha_sasha_male_ending_0d7e3263:
    samantha.say "Мы ведь должны рассказывать эту историю со своей стороны."

# ch/harems/home/events/home_harem_lexi.rpy:2567
translate russian bree_lexi_samantha_sasha_male_ending_0cd4f01b:
    samantha.say "О том, как мы все живём долго и счастливо, да?"

# ch/harems/home/events/home_harem_lexi.rpy:2568
translate russian bree_lexi_samantha_sasha_male_ending_548eed4d:
    sasha.say "Ты права, Сэм."

# ch/harems/home/events/home_harem_lexi.rpy:2569
translate russian bree_lexi_samantha_sasha_male_ending_e27ccfd4:
    bree.say "Да, пожалуй."

# ch/harems/home/events/home_harem_lexi.rpy:2570
translate russian bree_lexi_samantha_sasha_male_ending_02c6c2be:
    lexi.say "Ладно, ладно. Но моя история всё равно потрясающая."

# ch/harems/home/events/home_harem_lexi.rpy:2571
translate russian bree_lexi_samantha_sasha_male_ending_c9717c5f:
    samantha.say "Да ничего страшного."

# ch/harems/home/events/home_harem_lexi.rpy:2572
translate russian bree_lexi_samantha_sasha_male_ending_a05509d2:
    samantha.say "Наверное, иногда мы будем расходиться во мнениях."

# ch/harems/home/events/home_harem_lexi.rpy:2573
translate russian bree_lexi_samantha_sasha_male_ending_8251fc83:
    samantha.say "В конце концов, нас в этих отношениях пятеро!"

# ch/harems/home/events/home_harem_lexi.rpy:2574
translate russian bree_lexi_samantha_sasha_male_ending_e0ae8a60:
    lexi.say "Пока пятеро!"

# ch/harems/home/events/home_harem_lexi.rpy:2576
translate russian bree_lexi_samantha_sasha_male_ending_cedfba81:
    bree.say "А нас, формально говоря, всё ещё пятеро?"

# ch/harems/home/events/home_harem_lexi.rpy:2577
translate russian bree_lexi_samantha_sasha_male_ending_f21b4e54:
    sasha.say "Да, по пути мы, возможно, нечаянно превратились в целое племя!"

# ch/harems/home/events/home_harem_lexi.rpy:2578
translate russian bree_lexi_samantha_sasha_male_ending_e5aa71d0:
    sasha.say "[lssb_common.hero_name()] мог бы стать основателем целого народа."

# ch/harems/home/events/home_harem_lexi.rpy:2579
translate russian bree_lexi_samantha_sasha_male_ending_689bc470:
    lexi.say "Эм... странно!"

# ch/harems/home/events/home_harem_lexi.rpy:2580
translate russian bree_lexi_samantha_sasha_male_ending_9ec815af:
    samantha.say "Не говорите об этом: [lssb_common.hero_name()] и так о себе слишком высокого мнения!"

# ch/harems/home/events/home_harem_lexi.rpy:2582
translate russian bree_lexi_samantha_sasha_male_ending_abb60c53:
    bree.say "Да, место для новых всегда найдётся!"

# ch/harems/home/events/home_harem_lexi.rpy:2583
translate russian bree_lexi_samantha_sasha_male_ending_538f70f3:
    lexi.say "Парочку ещё втиснем, а?"

# ch/harems/home/events/home_harem_lexi.rpy:2586
translate russian bree_lexi_samantha_sasha_male_ending_cc1cc395:
    bree.say "Да, не забывайте про Поппи."

# ch/harems/home/events/home_harem_lexi.rpy:2587
translate russian bree_lexi_samantha_sasha_male_ending_3efb2b2d:
    bree.say "Она шумит за двоих!"

# ch/harems/home/events/home_harem_lexi.rpy:2589
translate russian bree_lexi_samantha_sasha_male_ending_1449b88d:
    sasha.say "Да, Далия у нас оторва."

# ch/harems/home/events/home_harem_lexi.rpy:2590
translate russian bree_lexi_samantha_sasha_male_ending_baf2acfc:
    sasha.say "Но чего ещё ждать от ребёнка, у которого пять мам!"

# ch/harems/home/events/home_harem_lexi.rpy:2592
translate russian bree_lexi_samantha_sasha_male_ending_421c41b0:
    samantha.say "Ха... Джемайма уже вьёт из нас верёвки."

# ch/harems/home/events/home_harem_lexi.rpy:2593
translate russian bree_lexi_samantha_sasha_male_ending_f5eeb2da:
    samantha.say "Боюсь даже представить, что будет, когда она подрастёт!"

# ch/harems/home/events/home_harem_lexi.rpy:2595
translate russian bree_lexi_samantha_sasha_male_ending_1e9d576d:
    lexi.say "С Шантель и Тайроном такое чувство, будто их четверо, а не двое!"

# ch/harems/home/events/home_harem_lexi.rpy:2596
translate russian bree_lexi_samantha_sasha_male_ending_3f1981c0:
    lexi.say "Хорошо, что у нас столько помощников."

# ch/harems/home/events/home_harem_lexi.rpy:2597
translate russian bree_lexi_samantha_sasha_male_ending_4c887474:
    bree.say "Жаль, что мы не смогли остаться в старом доме."

# ch/harems/home/events/home_harem_lexi.rpy:2598
translate russian bree_lexi_samantha_sasha_male_ending_78f3c08c:
    bree.say "Ну, там, где всё началось."

# ch/harems/home/events/home_harem_lexi.rpy:2599
translate russian bree_lexi_samantha_sasha_male_ending_a622dc28:
    sasha.say "Да ну, там стало тесно ещё тогда, когда нас было только трое!"

# ch/harems/home/events/home_harem_lexi.rpy:2600
translate russian bree_lexi_samantha_sasha_male_ending_e628b8eb:
    samantha.say "Вот поэтому мы в итоге и сложились на новое жильё."

# ch/harems/home/events/home_harem_lexi.rpy:2601
translate russian bree_lexi_samantha_sasha_male_ending_951fe4ac:
    lexi.say "А я всё ещё считаю, что надо было купить пару трейлеров."

# ch/harems/home/events/home_harem_lexi.rpy:2602
translate russian bree_lexi_samantha_sasha_male_ending_1f34d526:
    lexi.say "Мы могли бы занять почти весь парк, где я жила..."

# ch/harems/home/events/home_harem_lexi.rpy:2603
translate russian bree_lexi_samantha_sasha_male_ending_f37e0b5d:
    samantha.say "В общем, неважно, где мы живём."

# ch/harems/home/events/home_harem_lexi.rpy:2604
translate russian bree_lexi_samantha_sasha_male_ending_905bf3d5:
    samantha.say "Главное, что мы все вместе."

# ch/harems/home/events/home_harem_lexi.rpy:2605
translate russian bree_lexi_samantha_sasha_male_ending_510e1eab:
    bree.say "Да, и что нас четверо, а [lssb_common.hero_name()] один!"

# ch/harems/home/events/home_harem_lexi.rpy:2606
translate russian bree_lexi_samantha_sasha_male_ending_df622dab:
    sasha.say "Бедняга, мне его почти жалко!"

# ch/harems/home/events/home_harem_lexi.rpy:2616
translate russian bree_lexi_sasha_male_ending_54ddb2c0:
    "Трудно сопоставить моё первое впечатление о Лекси с тем, к чему мы пришли."

# ch/harems/home/events/home_harem_lexi.rpy:2617
translate russian bree_lexi_sasha_male_ending_3a6742e6:
    "Ещё труднее поверить, что именно на ней я теперь собираюсь жениться!"

# ch/harems/home/events/home_harem_lexi.rpy:2618
translate russian bree_lexi_sasha_male_ending_a59e8726:
    "Мне и так было непросто поверить, что [lssb_homelexi.bree_name()] или Саша согласилась встречаться со мной."

# ch/harems/home/events/home_harem_lexi.rpy:2619
translate russian bree_lexi_sasha_male_ending_27ec250e:
    "А уж отношения с тремя девушками одновременно казались безумием."

# ch/harems/home/events/home_harem_lexi.rpy:2620
translate russian bree_lexi_sasha_male_ending_32ba74b4:
    "Я оглядываюсь через плечо на часовню, полную гостей."

# ch/harems/home/events/home_harem_lexi.rpy:2621
translate russian bree_lexi_sasha_male_ending_156224f6:
    "Интересная компания, что и говорить: люди из самых разных слоёв общества."

# ch/harems/home/events/home_harem_lexi.rpy:2622
translate russian bree_lexi_sasha_male_ending_22ef0d05:
    "Но то, что часовня практически полна, успокаивает меня."

# ch/harems/home/events/home_harem_lexi.rpy:2623
translate russian bree_lexi_sasha_male_ending_0227bc14:
    "Как и то, что вокруг я вижу лишь улыбающиеся лица."

# ch/harems/home/events/home_harem_lexi.rpy:2624
translate russian bree_lexi_sasha_male_ending_21099a95:
    "В этот момент звучит музыка, наполняя часовню."

# ch/harems/home/events/home_harem_lexi.rpy:2625
translate russian bree_lexi_sasha_male_ending_0dafd144:
    "Словно по сигналу, все гости разом встают."

# ch/harems/home/events/home_harem_lexi.rpy:2626
translate russian bree_lexi_sasha_male_ending_12c02527:
    "Я всё ещё смотрю назад, когда в проходе появляется свадебная процессия..."

# ch/harems/home/events/home_harem_lexi.rpy:2628
translate russian bree_lexi_sasha_male_ending_4a54a48c:
    "Лекси — девушка, которую я всегда считал принцессой трейлерного парка."

# ch/harems/home/events/home_harem_lexi.rpy:2629
translate russian bree_lexi_sasha_male_ending_0f4fcbdf:
    "Скажем так: сейчас она больше похожа на принцессу, чем когда-либо."

# ch/harems/home/events/home_harem_lexi.rpy:2630
translate russian bree_lexi_sasha_male_ending_6f758de3:
    "Она навсегда останется оторвой из трущоб."

# ch/harems/home/events/home_harem_lexi.rpy:2631
translate russian bree_lexi_sasha_male_ending_a7c0c352:
    "Но кто знал, что такая оторва может выглядеть настолько прекрасно?"

# ch/harems/home/events/home_harem_lexi.rpy:2634
translate russian bree_lexi_sasha_male_ending_6622844f:
    "Следом идёт [lssb_homelexi.bree_name()]: её белое воздушное платье, пожалуй, ближе всего к традиционному."

# ch/harems/home/events/home_harem_lexi.rpy:2635
translate russian bree_lexi_sasha_male_ending_c395aef7:
    "Поразительнее её платья разве что улыбка на лице."

# ch/harems/home/events/home_harem_lexi.rpy:2638
translate russian bree_lexi_sasha_male_ending_3be013dd:
    "Саша — почти полная противоположность: чёрный наряд подчёркивает бледность её кожи."

# ch/harems/home/events/home_harem_lexi.rpy:2639
translate russian bree_lexi_sasha_male_ending_a8521945:
    "Она столь же загадочна и интригующа, сколь [lssb_homelexi.bree_name()] открыта и искренна."

# ch/harems/home/events/home_harem_lexi.rpy:2641
translate russian bree_lexi_sasha_male_ending_dcabda11:
    "Наверное, при виде трёх больших беременных животиков мне стоило бы нервничать и обливаться потом."

# ch/harems/home/events/home_harem_lexi.rpy:2642
translate russian bree_lexi_sasha_male_ending_e51ee425:
    "И я понятия не имею, что думают сидящие на скамьях гости о том, что все девушки беременны одновременно."

# ch/harems/home/events/home_harem_lexi.rpy:2643
translate russian bree_lexi_sasha_male_ending_19aaa830:
    "Но, честно говоря, мне всё равно: мы уже большая семья и скоро станем ещё больше!"

# ch/harems/home/events/home_harem_lexi.rpy:2645
translate russian bree_lexi_sasha_male_ending_d5a18646:
    "[lssb_homelexi.bree_name()], Саша и Лекси стоят рядом со мной у алтаря, и я не могу оторвать от них глаз."

# ch/harems/home/events/home_harem_lexi.rpy:2646
translate russian bree_lexi_sasha_male_ending_f7698691:
    "Три мои невесты, которые скоро станут тремя моими жёнами!"

# ch/harems/home/events/home_harem_lexi.rpy:2649
translate russian bree_lexi_sasha_male_ending_fdecaed9:
    "Я почти забываю, что [lssb_homelexi.bree_name()] уже на таком большом сроке."

# ch/harems/home/events/home_harem_lexi.rpy:2650
translate russian bree_lexi_sasha_male_ending_2f543a0f:
    "Платье так хорошо скрывает живот, да ещё и букет она держит перед ним!"

# ch/harems/home/events/home_harem_lexi.rpy:2651
translate russian bree_lexi_sasha_male_ending_6a61efb9:
    "Но беременность, кажется, ничуть ей не мешает."

# ch/harems/home/events/home_harem_lexi.rpy:2653
translate russian bree_lexi_sasha_male_ending_4ca94f19:
    "Не сразу замечаю, что Саша выглядит немного бледнее обычного."

# ch/harems/home/events/home_harem_lexi.rpy:2654
translate russian bree_lexi_sasha_male_ending_d660b649:
    "Скорее всего, из-за беременности."

# ch/harems/home/events/home_harem_lexi.rpy:2655
translate russian bree_lexi_sasha_male_ending_00e625a1:
    "Поэтому решаю следить, не станет ли она ещё бледнее!"

# ch/harems/home/events/home_harem_lexi.rpy:2657
translate russian bree_lexi_sasha_male_ending_56040797:
    "Девушка из трейлерного парка с беременным животом — настоящее клише."

# ch/harems/home/events/home_harem_lexi.rpy:2658
translate russian bree_lexi_sasha_male_ending_4d942ad6:
    "Но почему-то Лекси от этого лишь желаннее, по крайней мере в моих глазах."

# ch/harems/home/events/home_harem_lexi.rpy:2659
translate russian bree_lexi_sasha_male_ending_50f6e0f5:
    "Беременность ей так идёт, что я уверен: она станет замечательной матерью."

# ch/harems/home/events/home_harem_lexi.rpy:2660
translate russian bree_lexi_sasha_male_ending_29d5cdd1:
    "Когда все занимают свои места, мы успеваем лишь обменяться улыбками."

# ch/harems/home/events/home_harem_lexi.rpy:2661
translate russian bree_lexi_sasha_male_ending_a8cf5aa8:
    "Потому что через мгновение священник откашливается и начинает церемонию."

# ch/harems/home/events/home_harem_lexi.rpy:2662
translate russian bree_lexi_sasha_male_ending_a7f312e2:
    "Вот и всё, это действительно происходит!"

# ch/harems/home/events/home_harem_lexi.rpy:2667
translate russian bree_lexi_sasha_male_ending_8f5c089c:
    "Священник" "Мы собрались здесь сегодня, чтобы соединить этих людей узами священного брака."

# ch/harems/home/events/home_harem_lexi.rpy:2668
translate russian bree_lexi_sasha_male_ending_d1a8284c:
    "Мы уже репетировали, так что все знают, что делать."

# ch/harems/home/events/home_harem_lexi.rpy:2669
translate russian bree_lexi_sasha_male_ending_42e6ee69:
    "А уж свадьбы по телевизору и в кино я наверняка видел тысячу раз."

# ch/harems/home/events/home_harem_lexi.rpy:2670
translate russian bree_lexi_sasha_male_ending_506a0fbe:
    "Может, поэтому всё и проходит так быстро."

# ch/harems/home/events/home_harem_lexi.rpy:2671
translate russian bree_lexi_sasha_male_ending_73c1db8a:
    "Кажется, мы дошли до клятв в мгновение ока!"

# ch/harems/home/events/home_harem_lexi.rpy:2672
translate russian bree_lexi_sasha_male_ending_5bc59b34:
    "Священник" "Согласен ли ты, [lssb_common.hero_name()], чтобы Лекси стала твоей законной женой?"

# ch/harems/home/events/home_harem_lexi.rpy:2673
translate russian bree_lexi_sasha_male_ending_2674a4bb:
    "Священник" "О, и Саша!"

# ch/harems/home/events/home_harem_lexi.rpy:2674
translate russian bree_lexi_sasha_male_ending_94c4e327:
    "Священник" "И [lssb_homelexi.bree_name()] тоже!"

# ch/harems/home/events/home_harem_lexi.rpy:2675
translate russian bree_lexi_sasha_male_ending_cc481164:
    mike.say "Согласен."

# ch/harems/home/events/home_harem_lexi.rpy:2676
translate russian bree_lexi_sasha_male_ending_67352dc9:
    "Священник" "А согласна ли ты, Лекси, чтобы [lssb_common.hero_name()] стал твоим законным мужем?"

# ch/harems/home/events/home_harem_lexi.rpy:2677
translate russian bree_lexi_sasha_male_ending_a5e33487:
    "Священник" "И Саша."

# ch/harems/home/events/home_harem_lexi.rpy:2678
translate russian bree_lexi_sasha_male_ending_ec6a6af4:
    "Священник" "И [lssb_homelexi.bree_name()]."

# ch/harems/home/events/home_harem_lexi.rpy:2680
translate russian bree_lexi_sasha_male_ending_76bd9090:
    lexi.say "Да, пожалуй, согласна!"

# ch/harems/home/events/home_harem_lexi.rpy:2681
translate russian bree_lexi_sasha_male_ending_6bb3a971:
    "Священник" "[lssb_homelexi.bree_name()], согласна ли ты, чтобы твоими законными супругами стали Лекси, Саша и [lssb_common.hero_name()]?"

# ch/harems/home/events/home_harem_lexi.rpy:2683
translate russian bree_lexi_sasha_male_ending_c4814f54:
    bree.say "Согласна!"

# ch/harems/home/events/home_harem_lexi.rpy:2684
translate russian bree_lexi_sasha_male_ending_79aabe3b:
    "Священник" "Согласна ли ты, Саша, чтобы эти люди стали твоими законными супругами?"

# ch/harems/home/events/home_harem_lexi.rpy:2686
translate russian bree_lexi_sasha_male_ending_90318f71:
    sasha.say "Да, согласна."

# ch/harems/home/events/home_harem_lexi.rpy:2687
translate russian bree_lexi_sasha_male_ending_7636ae67:
    "Священник кивает, довольный тем, что пока всё идёт без происшествий."

# ch/harems/home/events/home_harem_lexi.rpy:2688
translate russian bree_lexi_sasha_male_ending_b3ba36ba:
    "Священник" "Теперь я обращаюсь ко всем присутствующим."

# ch/harems/home/events/home_harem_lexi.rpy:2689
translate russian bree_lexi_sasha_male_ending_7976e013:
    "Священник" "Если кому-либо известна законная причина, по которой эти люди не могут вступить в брак..."

# ch/harems/home/events/home_harem_lexi.rpy:2690
translate russian bree_lexi_sasha_male_ending_713d080b:
    "Священник" "Говорите сейчас или молчите вечно!"

# ch/harems/home/events/home_harem_lexi.rpy:2691
translate russian bree_lexi_sasha_male_ending_7a53a836:
    "Наступает обычная пауза, все оглядываются, затаив дыхание."

# ch/harems/home/events/home_harem_lexi.rpy:2692
translate russian bree_lexi_sasha_male_ending_f47eb3b5:
    "Но мне кажется, если мы четверо сумели дойти так далеко, то, наверное, уже можно не опасаться."

# ch/harems/home/events/home_harem_lexi.rpy:2693
translate russian bree_lexi_sasha_male_ending_20eced0b:
    "И это подтверждается, когда священник с явным облегчением кивает."

# ch/harems/home/events/home_harem_lexi.rpy:2694
translate russian bree_lexi_sasha_male_ending_e328f6cd:
    "Мгновение проходит, и все облегчённо вздыхают."

# ch/harems/home/events/home_harem_lexi.rpy:2695
translate russian bree_lexi_sasha_male_ending_45ea9877:
    "Священник" "Хорошо..."

# ch/harems/home/events/home_harem_lexi.rpy:2696
translate russian bree_lexi_sasha_male_ending_973eec05:
    "Священник" "Тогда с великой радостью объявляю вас супругами."

# ch/harems/home/events/home_harem_lexi.rpy:2697
translate russian bree_lexi_sasha_male_ending_ce25c61c:
    "Священник" "По традиции сейчас можно поцеловаться, если хотите..."

# ch/harems/home/events/home_harem_lexi.rpy:2701
translate russian bree_lexi_sasha_male_ending_fbf7ead5:
    "Мы так и делаем, и это приятнее, чем когда-либо."

# ch/harems/home/events/home_harem_lexi.rpy:2702
translate russian bree_lexi_sasha_male_ending_3501e1e0:
    "Этот поцелуй нужен не только для завершения церемонии."

# ch/harems/home/events/home_harem_lexi.rpy:2703
translate russian bree_lexi_sasha_male_ending_7afa16ad:
    "Он словно освобождает нас от всего, за что мы цеплялись раньше."

# ch/harems/home/events/home_harem_lexi.rpy:2704
translate russian bree_lexi_sasha_male_ending_5a192d64:
    "Словно для всех нас начинается совершенно новая глава!"

# ch/harems/home/events/home_harem_lexi.rpy:2709
translate russian bree_lexi_sasha_male_ending_d3f12b1c:
    lexi.say "Похоже, они хотят послушать меня."

# ch/harems/home/events/home_harem_lexi.rpy:2710
translate russian bree_lexi_sasha_male_ending_ee5cdd02:
    lexi.say "И правильно, ведь в наших отношениях главная я!"

# ch/harems/home/events/home_harem_lexi.rpy:2712
translate russian bree_lexi_sasha_male_ending_27ece9f2:
    sasha.say "Эй, Лекси!"

# ch/harems/home/events/home_harem_lexi.rpy:2713
translate russian bree_lexi_sasha_male_ending_648ffdf5:
    sasha.say "Это что ещё такое?!"

# ch/harems/home/events/home_harem_lexi.rpy:2715
translate russian bree_lexi_sasha_male_ending_e0b0ef4d:
    bree.say "Погоди, погоди!"

# ch/harems/home/events/home_harem_lexi.rpy:2716
translate russian bree_lexi_sasha_male_ending_4f28603e:
    lexi.say "А, привет, девчонки..."

# ch/harems/home/events/home_harem_lexi.rpy:2717
translate russian bree_lexi_sasha_male_ending_d3d5b1d2:
    lexi.say "Не заметила вас."

# ch/harems/home/events/home_harem_lexi.rpy:2718
translate russian bree_lexi_sasha_male_ending_95ce23f7:
    lexi.say "Я же просто пошутила, понимаете?"

# ch/harems/home/events/home_harem_lexi.rpy:2719
translate russian bree_lexi_sasha_male_ending_aeb8948f:
    lexi.say "Чтобы разрядить обстановку и задать тон!"

# ch/harems/home/events/home_harem_lexi.rpy:2720
translate russian bree_lexi_sasha_male_ending_972ac55f:
    sasha.say "Ага, конечно, Лекси."

# ch/harems/home/events/home_harem_lexi.rpy:2721
translate russian bree_lexi_sasha_male_ending_2cbe5acb:
    bree.say "По-моему, не очень смешно."

# ch/harems/home/events/home_harem_lexi.rpy:2722
translate russian bree_lexi_sasha_male_ending_4b51c505:
    lexi.say "Как скажете..."

# ch/harems/home/events/home_harem_lexi.rpy:2723
translate russian bree_lexi_sasha_male_ending_5ab75232:
    lexi.say "Вообще-то тема нашего разговора — [lssb_common.hero_name()]."

# ch/harems/home/events/home_harem_lexi.rpy:2724
translate russian bree_lexi_sasha_male_ending_743ed98a:
    bree.say "Ты права."

# ch/harems/home/events/home_harem_lexi.rpy:2725
translate russian bree_lexi_sasha_male_ending_0683c346:
    sasha.say "Да, пожалуй."

# ch/harems/home/events/home_harem_lexi.rpy:2726
translate russian bree_lexi_sasha_male_ending_4226ec35:
    lexi.say "Признайте, всё это довольно случайно и безумно."

# ch/harems/home/events/home_harem_lexi.rpy:2727
translate russian bree_lexi_sasha_male_ending_9b45d682:
    lexi.say "То, что мы в итоге все оказались вместе."

# ch/harems/home/events/home_harem_lexi.rpy:2728
translate russian bree_lexi_sasha_male_ending_eef07dc6:
    lexi.say "Почти как в одной из тех безумных игр."

# ch/harems/home/events/home_harem_lexi.rpy:2729
translate russian bree_lexi_sasha_male_ending_ab7778e2:
    lexi.say "Где [lssb_common.hero_name()] принимает все решения!"

# ch/harems/home/events/home_harem_lexi.rpy:2730
translate russian bree_lexi_sasha_male_ending_20c93c51:
    bree.say "Даже страшновато думать, что он всем управлял!"

# ch/harems/home/events/home_harem_lexi.rpy:2731
translate russian bree_lexi_sasha_male_ending_fb6e2768:
    sasha.say "Ага, он ведь тот ещё растяпа!"

# ch/harems/home/events/home_harem_lexi.rpy:2732
translate russian bree_lexi_sasha_male_ending_31aeb112:
    lexi.say "А теперь мы начинаем общую жизнь."

# ch/harems/home/events/home_harem_lexi.rpy:2733
translate russian bree_lexi_sasha_male_ending_9c221ee2:
    lexi.say "Ну и безумная же у нас семейка!"

# ch/harems/home/events/home_harem_lexi.rpy:2735
translate russian bree_lexi_sasha_male_ending_266a9d65:
    lexi.say "Я пока не знаю, в кого пошли Тайрон и Шантель."

# ch/harems/home/events/home_harem_lexi.rpy:2736
translate russian bree_lexi_sasha_male_ending_a3c9439e:
    lexi.say "Но знаю, что папа их любит."

# ch/harems/home/events/home_harem_lexi.rpy:2738
translate russian bree_lexi_sasha_male_ending_1ac5a1a6:
    sasha.say "Кажется, [lssb_common.hero_name()] рад, что он тут больше не единственный мужчина."

# ch/harems/home/events/home_harem_lexi.rpy:2739
translate russian bree_lexi_sasha_male_ending_dbd2fdcf:
    sasha.say "Поэтому и балует Далию при каждом удобном случае!"

# ch/harems/home/events/home_harem_lexi.rpy:2741
translate russian bree_lexi_sasha_male_ending_cc1cc395:
    bree.say "Да, не забывайте про Поппи."

# ch/harems/home/events/home_harem_lexi.rpy:2742
translate russian bree_lexi_sasha_male_ending_3efb2b2d:
    bree.say "Она шумит за двоих!"

# ch/harems/home/events/home_harem_lexi.rpy:2743
translate russian bree_lexi_sasha_male_ending_8bff8086:
    lexi.say "Как я и говорила, безумная семейка."

# ch/harems/home/events/home_harem_lexi.rpy:2744
translate russian bree_lexi_sasha_male_ending_f77115e8:
    lexi.say "Но, по-моему, получается очень даже неплохо."

# ch/harems/home/events/home_harem_lexi.rpy:2745
translate russian bree_lexi_sasha_male_ending_e94a4a16:
    bree.say "Тут ты права, Лекси."

# ch/harems/home/events/home_harem_lexi.rpy:2746
translate russian bree_lexi_sasha_male_ending_e798ba0b:
    bree.say "Меня всё устраивает!"

# ch/harems/home/events/home_harem_lexi.rpy:2747
translate russian bree_lexi_sasha_male_ending_ad1889f6:
    sasha.say "В теории кажется, что такая штука ну никак не должна работать!"

# ch/harems/home/events/home_harem_lexi.rpy:2748
translate russian bree_lexi_sasha_male_ending_9ca702bc:
    sasha.say "Но на деле всё получается."

# ch/harems/home/events/home_harem_lexi.rpy:2749
translate russian bree_lexi_sasha_male_ending_493c12a4:
    lexi.say "Да, согласна."

# ch/harems/home/events/home_harem_lexi.rpy:2750
translate russian bree_lexi_sasha_male_ending_e4c714ee:
    lexi.say "Только [lssb_common.hero_name()] вовсе не обязан знать, что мы так думаем!"
