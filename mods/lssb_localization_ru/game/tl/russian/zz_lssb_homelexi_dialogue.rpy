# ch/harems/home/events/home_harem_lexi.rpy:235
translate russian ask_bree_about_lexi_38ea9c28:
    "Из всех девушек, с которыми я живу, [lssb_homelexi.bree_name()] меньше всего пугает меня предстоящим разговором."

# ch/harems/home/events/home_harem_lexi.rpy:236
translate russian ask_bree_about_lexi_27851748:
    "Конечно, она тоже человек и может не захотеть, чтобы Лекси на время поселилась у нас."

# ch/harems/home/events/home_harem_lexi.rpy:237
translate russian ask_bree_about_lexi_15e79312:
    "Но я знаю, что она ещё и самая открытая и заботливая из моих соседок."

# ch/harems/home/events/home_harem_lexi.rpy:238
translate russian ask_bree_about_lexi_3820943f:
    "Не подумайте, будто остальные — кучка бессердечных стерв."

# ch/harems/home/events/home_harem_lexi.rpy:239
translate russian ask_bree_about_lexi_0c9f3230:
    "Просто [lssb_homelexi.bree_name()] обычно не скрывает своих чувств."

# ch/harems/home/events/home_harem_lexi.rpy:240
translate russian ask_bree_about_lexi_b57eb115:
    "И я знаю, что она старается помочь везде, где может."

# ch/harems/home/events/home_harem_lexi.rpy:241
translate russian ask_bree_about_lexi_1a0829b9:
    mike.say "Эй, [lssb_homelexi.bree_name()]!"

# ch/harems/home/events/home_harem_lexi.rpy:242
translate russian ask_bree_about_lexi_9e3c01f5:
    mike.say "Есть свободная минутка?"

# ch/harems/home/events/home_harem_lexi.rpy:244
translate russian ask_bree_about_lexi_c37874ec:
    "[lssb_homelexi.bree_name()] улыбается и кивает, сразу уделяя мне всё своё внимание."

# ch/harems/home/events/home_harem_lexi.rpy:245
translate russian ask_bree_about_lexi_9d6129b9:
    "Её лицо так мило и так сияет, что я чуть не забываю, что собирался сказать."

# ch/harems/home/events/home_harem_lexi.rpy:246
translate russian ask_bree_about_lexi_b186db43:
    bree.say "Конечно, [lssb_common.hero_name()]."

# ch/harems/home/events/home_harem_lexi.rpy:248
translate russian ask_bree_about_lexi_b576b98f:
    bree.say "Что случилось?"

# ch/harems/home/events/home_harem_lexi.rpy:249
translate russian ask_bree_about_lexi_24620634:
    mike.say "Эм... я..."

# ch/harems/home/events/home_harem_lexi.rpy:250
translate russian ask_bree_about_lexi_c366eedc:
    mike.say "А, да! Я хотел попросить об одолжении."

# ch/harems/home/events/home_harem_lexi.rpy:251
translate russian ask_bree_about_lexi_ddf22249:
    "[lssb_homelexi.bree_name()] снова кивает, побуждая меня продолжать."

# ch/harems/home/events/home_harem_lexi.rpy:252
translate russian ask_bree_about_lexi_b61230f9:
    bree.say "Хорошо, [lssb_common.hero_name()], спрашивай!"

# ch/harems/home/events/home_harem_lexi.rpy:253
translate russian ask_bree_about_lexi_3f788ea3:
    mike.say "Ну, понимаешь..."

# ch/harems/home/events/home_harem_lexi.rpy:254
translate russian ask_bree_about_lexi_373d6f58:
    mike.say "У кое-кого из моих друзей случилась неприятность."

# ch/harems/home/events/home_harem_lexi.rpy:255
translate russian ask_bree_about_lexi_93f14ab6:
    mike.say "Вообще-то большая неприятность — дом сгорел."

# ch/harems/home/events/home_harem_lexi.rpy:257
translate russian ask_bree_about_lexi_afb53c8f:
    "[lssb_homelexi.bree_name()] вдруг выглядит встревоженной."

# ch/harems/home/events/home_harem_lexi.rpy:258
translate russian ask_bree_about_lexi_0aa6d27b:
    "Она в ужасе ахает, осознав смысл моих слов."

# ch/harems/home/events/home_harem_lexi.rpy:260
translate russian ask_bree_about_lexi_8cc3e5f3:
    bree.say "О нет!"

# ch/harems/home/events/home_harem_lexi.rpy:262
translate russian ask_bree_about_lexi_cd0f1ccf:
    bree.say "Какой ужас!"

# ch/harems/home/events/home_harem_lexi.rpy:263
translate russian ask_bree_about_lexi_64642b1b:
    bree.say "То есть теперь... даже жить негде?!"

# ch/harems/home/events/home_harem_lexi.rpy:264
translate russian ask_bree_about_lexi_8b3f3f25:
    "Я поспешно киваю, не ожидая, что [lssb_homelexi.bree_name()] сама так быстро всё поймёт."

# ch/harems/home/events/home_harem_lexi.rpy:265
translate russian ask_bree_about_lexi_73a9420e:
    "Я-то думал, придётся объяснять всё от начала до конца."

# ch/harems/home/events/home_harem_lexi.rpy:266
translate russian ask_bree_about_lexi_62b3cf7a:
    "А она уже заполняет пробелы быстрее, чем я успеваю говорить!"

# ch/harems/home/events/home_harem_lexi.rpy:267
translate russian ask_bree_about_lexi_61c549bd:
    mike.say "Да, [lssb_homelexi.bree_name()], именно так."

# ch/harems/home/events/home_harem_lexi.rpy:268
translate russian ask_bree_about_lexi_d8699dfe:
    mike.say "И всё имущество тоже сгорело!"

# ch/harems/home/events/home_harem_lexi.rpy:270
translate russian ask_bree_about_lexi_f40014c1:
    "[lssb_homelexi.bree_name()] качает головой, явно сочувствуя беде Лекси."

# ch/harems/home/events/home_harem_lexi.rpy:271
translate russian ask_bree_about_lexi_f54520d5:
    bree.say "И где теперь жить, [lssb_common.hero_name()]?"

# ch/harems/home/events/home_harem_lexi.rpy:272
translate russian ask_bree_about_lexi_dea45c54:
    bree.say "Только не говори, что придётся ночевать на улице!"

# ch/harems/home/events/home_harem_lexi.rpy:273
translate russian ask_bree_about_lexi_102b10a9:
    "Вряд ли мне представится случай лучше того, который только что предоставила [lssb_homelexi.bree_name()]."

# ch/harems/home/events/home_harem_lexi.rpy:274
translate russian ask_bree_about_lexi_2a24396e:
    "Поэтому я глубоко вдыхаю, готовясь перейти к сути."

# ch/harems/home/events/home_harem_lexi.rpy:275
translate russian ask_bree_about_lexi_873cde24:
    mike.say "Вот к этому я и подводил, [lssb_homelexi.bree_name()]."

# ch/harems/home/events/home_harem_lexi.rpy:276
translate russian ask_bree_about_lexi_d3d160af:
    mike.say "Я хотел спросить, можно ли пожить у нас на диване?"

# ch/harems/home/events/home_harem_lexi.rpy:277
translate russian ask_bree_about_lexi_aec428e6:
    mike.say "Ну, пока всё не наладится?"

# ch/harems/home/events/home_harem_lexi.rpy:279
translate russian ask_bree_about_lexi_9fdd3a7a:
    "Теперь [lssb_homelexi.bree_name()] кивает ещё энергичнее."

# ch/harems/home/events/home_harem_lexi.rpy:280
translate russian ask_bree_about_lexi_accea524:
    "Так энергично, что я боюсь, как бы у неё голова не отвалилась."

# ch/harems/home/events/home_harem_lexi.rpy:281
translate russian ask_bree_about_lexi_6d419240:
    bree.say "Конечно, [lssb_common.hero_name()]."

# ch/harems/home/events/home_harem_lexi.rpy:282
translate russian ask_bree_about_lexi_67c1686a:
    bree.say "По-моему, отличная идея!"

# ch/harems/home/events/home_harem_lexi.rpy:284
translate russian ask_bree_about_lexi_dfa88060:
    mike.say "Это очень поможет Лекси!"

# ch/harems/home/events/home_harem_lexi.rpy:285
translate russian ask_bree_about_lexi_f13265b3:
    "[lssb_homelexi.bree_name()] замирает и смотрит мне прямо в глаза."

# ch/harems/home/events/home_harem_lexi.rpy:287
translate russian ask_bree_about_lexi_aee17499:
    "Словно до неё только сейчас что-то дошло."

# ch/harems/home/events/home_harem_lexi.rpy:290
translate russian ask_bree_about_lexi_6a96d5e6:
    bree.say "Погоди, ты говоришь о ДЕВУШКЕ?!"

# ch/harems/home/events/home_harem_lexi.rpy:291
translate russian ask_bree_about_lexi_7396c5d4:
    "Чёрт, сейчас всё может очень быстро пойти наперекосяк!"

# ch/harems/home/events/home_harem_lexi.rpy:292
translate russian ask_bree_about_lexi_7e24fe75:
    "Может, удастся представить её опасения как беспочвенную подозрительность?"

# ch/harems/home/events/home_harem_lexi.rpy:293
translate russian ask_bree_about_lexi_763021a9:
    mike.say "Эм, да..."

# ch/harems/home/events/home_harem_lexi.rpy:294
translate russian ask_bree_about_lexi_e6466705:
    mike.say "А какая разница?"

# ch/harems/home/events/home_harem_lexi.rpy:296
translate russian ask_bree_about_lexi_8a1c4863:
    bree.say "Я... понимаю, что разницы быть не должно..."

# ch/harems/home/events/home_harem_lexi.rpy:297
translate russian ask_bree_about_lexi_c20d3d0d:
    bree.say "Но..."

# ch/harems/home/events/home_harem_lexi.rpy:299
translate russian ask_bree_about_lexi_457fd059:
    mike.say "Я уже поговорил с остальными."

# ch/harems/home/events/home_harem_lexi.rpy:300
translate russian ask_bree_about_lexi_212d9738:
    mike.say "И все согласились."

# ch/harems/home/events/home_harem_lexi.rpy:302
translate russian ask_bree_about_lexi_837dbbc9:
    mike.say "Я уже поговорил с Минами и Сэм."

# ch/harems/home/events/home_harem_lexi.rpy:303
translate russian ask_bree_about_lexi_f8d453e1:
    mike.say "И обе согласились."

# ch/harems/home/events/home_harem_lexi.rpy:305
translate russian ask_bree_about_lexi_18fbd851:
    mike.say "Я уже поговорил с Сэм и Сашей."

# ch/harems/home/events/home_harem_lexi.rpy:306
translate russian ask_bree_about_lexi_f8d453e1_1:
    mike.say "И обе согласились."

# ch/harems/home/events/home_harem_lexi.rpy:308
translate russian ask_bree_about_lexi_2a25644e:
    mike.say "Я уже поговорил с Минами и Сашей."

# ch/harems/home/events/home_harem_lexi.rpy:309
translate russian ask_bree_about_lexi_f8d453e1_2:
    mike.say "И обе согласились."

# ch/harems/home/events/home_harem_lexi.rpy:311
translate russian ask_bree_about_lexi_32894fc3:
    mike.say "Я уже поговорил с Минами."

# ch/harems/home/events/home_harem_lexi.rpy:312
translate russian ask_bree_about_lexi_c2ab01f5:
    mike.say "И она согласилась."

# ch/harems/home/events/home_harem_lexi.rpy:314
translate russian ask_bree_about_lexi_33f429cc:
    mike.say "Я уже поговорил с Сэм."

# ch/harems/home/events/home_harem_lexi.rpy:315
translate russian ask_bree_about_lexi_c2ab01f5_1:
    mike.say "И она согласилась."

# ch/harems/home/events/home_harem_lexi.rpy:317
translate russian ask_bree_about_lexi_81ac6660:
    mike.say "Я уже поговорил с Сашей."

# ch/harems/home/events/home_harem_lexi.rpy:318
translate russian ask_bree_about_lexi_c2ab01f5_2:
    mike.say "И она согласилась."

# ch/harems/home/events/home_harem_lexi.rpy:320
translate russian ask_bree_about_lexi_9ccc543a:
    mike.say "С остальными я ещё не говорил."

# ch/harems/home/events/home_harem_lexi.rpy:321
translate russian ask_bree_about_lexi_9ea7ead9:
    mike.say "Но если ты согласна, уверен, мы убедим и их."

# ch/harems/home/events/home_harem_lexi.rpy:323
translate russian ask_bree_about_lexi_7f635acc:
    "После этих слов [lssb_homelexi.bree_name()], кажется, заметно успокаивается."

# ch/harems/home/events/home_harem_lexi.rpy:324
translate russian ask_bree_about_lexi_7e9b503a:
    "И кивает, словно окончательно приняв решение."

# ch/harems/home/events/home_harem_lexi.rpy:325
translate russian ask_bree_about_lexi_1b86b7bd:
    bree.say "Ты прав, [lssb_common.hero_name()]."

# ch/harems/home/events/home_harem_lexi.rpy:326
translate russian ask_bree_about_lexi_d7e000bb:
    bree.say "Не должно иметь значения, парень это или девушка."

# ch/harems/home/events/home_harem_lexi.rpy:327
translate russian ask_bree_about_lexi_68ba6770:
    bree.say "Человеку нужна помощь, и помочь будет правильно!"

# ch/harems/home/events/home_harem_lexi.rpy:328
translate russian ask_bree_about_lexi_55313cd8:
    "Я киваю и улыбаюсь, радуясь, что [lssb_homelexi.bree_name()] всё-таки удалось убедить."

# ch/harems/home/events/home_harem_lexi.rpy:334
translate russian ask_minami_about_lexi_d7b4d939:
    "Я решаю, что лучше всего прямо спросить Минами о переезде Лекси."

# ch/harems/home/events/home_harem_lexi.rpy:335
translate russian ask_minami_about_lexi_cc7780c5:
    "Не знаю, не обманываю ли я себя, но мне кажется, её будет проще всего уговорить."

# ch/harems/home/events/home_harem_lexi.rpy:336
translate russian ask_minami_about_lexi_fb375543:
    "В конце концов, она самая младшая в доме, к тому же моя младшая сестра."

# ch/harems/home/events/home_harem_lexi.rpy:337
translate russian ask_minami_about_lexi_6c913794:
    "Может, получится показать себя старше и мудрее, чтобы она согласилась с любимым старшим братом?"

# ch/harems/home/events/home_harem_lexi.rpy:338
translate russian ask_minami_about_lexi_246e60ce:
    "А может, она сразу меня раскусит и решит, что я хочу поселить Лекси в своей спальне!"

# ch/harems/home/events/home_harem_lexi.rpy:339
translate russian ask_minami_about_lexi_64db8658:
    "Как бы то ни было, пока не спрошу, не узнаю."

# ch/harems/home/events/home_harem_lexi.rpy:341
translate russian ask_minami_about_lexi_7a57b759:
    "Так что выбираю момент и окликаю Минами, когда она проносится мимо."

# ch/harems/home/events/home_harem_lexi.rpy:343
translate russian ask_minami_about_lexi_9a3e8f95:
    "Надеясь заодно застать её немного врасплох..."

# ch/harems/home/events/home_harem_lexi.rpy:344
translate russian ask_minami_about_lexi_0c1852b0:
    mike.say "Эй, Минами!"

# ch/harems/home/events/home_harem_lexi.rpy:346
translate russian ask_minami_about_lexi_837d2743:
    "Она останавливается и разворачивается на пятке, улыбаясь при звуке моего голоса."

# ch/harems/home/events/home_harem_lexi.rpy:347
translate russian ask_minami_about_lexi_800dbcce:
    "Минами прячет руки за спину и склоняет голову набок."

# ch/harems/home/events/home_harem_lexi.rpy:349
translate russian ask_minami_about_lexi_91f806e8:
    minami.say "О, привет, братик!"

# ch/harems/home/events/home_harem_lexi.rpy:350
translate russian ask_minami_about_lexi_d4211843:
    minami.say "Что такое?"

# ch/harems/home/events/home_harem_lexi.rpy:351
translate russian ask_minami_about_lexi_c316a484:
    minami.say "Или просто так рад меня видеть?"

# ch/harems/home/events/home_harem_lexi.rpy:352
translate russian ask_minami_about_lexi_d9bfc261:
    "Я улыбаюсь в ответ, стараясь выглядеть невинно."

# ch/harems/home/events/home_harem_lexi.rpy:353
translate russian ask_minami_about_lexi_cb5aa121:
    "Меньше всего мне хочется испортить ей настроение."

# ch/harems/home/events/home_harem_lexi.rpy:354
translate russian ask_minami_about_lexi_34c2c33b:
    "Тогда спросить о Лекси станет ещё труднее."

# ch/harems/home/events/home_harem_lexi.rpy:355
translate russian ask_minami_about_lexi_4d4a44bf:
    mike.say "Я всегда рад тебя видеть, Минами, ты же знаешь."

# ch/harems/home/events/home_harem_lexi.rpy:356
translate russian ask_minami_about_lexi_2688404e:
    mike.say "Ты такая жизнерадостная, с тобой так весело."

# ch/harems/home/events/home_harem_lexi.rpy:357
translate russian ask_minami_about_lexi_b13c256b:
    mike.say "Ты ведь с кем угодно найдёшь общий язык?"

# ch/harems/home/events/home_harem_lexi.rpy:358
translate russian ask_minami_about_lexi_038013e4:
    "Мне казалось, я удачно вставил этот вопрос под конец."

# ch/harems/home/events/home_harem_lexi.rpy:359
translate russian ask_minami_about_lexi_a9fb3b16:
    "Ну, достаточно тонко направил разговор в нужную сторону?"

# ch/harems/home/events/home_harem_lexi.rpy:360
translate russian ask_minami_about_lexi_5ac3031e:
    "Но Минами морщит нос, словно учуяла что-то подозрительное."

# ch/harems/home/events/home_harem_lexi.rpy:362
translate russian ask_minami_about_lexi_ef6c93d7:
    minami.say "Слушай, братик..."

# ch/harems/home/events/home_harem_lexi.rpy:363
translate russian ask_minami_about_lexi_27a04364:
    minami.say "Почему ты вдруг такой ласковый со мной?"

# ch/harems/home/events/home_harem_lexi.rpy:364
translate russian ask_minami_about_lexi_1060cb4c:
    "Я пожимаю плечами и качаю головой, пытаясь сбить её с толку."

# ch/harems/home/events/home_harem_lexi.rpy:365
translate russian ask_minami_about_lexi_849dbe16:
    "Возможно, зря: от этого я, кажется, выгляжу ещё более подозрительно и уклончиво."

# ch/harems/home/events/home_harem_lexi.rpy:367
translate russian ask_minami_about_lexi_670f892f:
    mike.say "Вовсе нет, Минами."

# ch/harems/home/events/home_harem_lexi.rpy:368
translate russian ask_minami_about_lexi_634edcf8:
    mike.say "Что за глупости!"

# ch/harems/home/events/home_harem_lexi.rpy:369
translate russian ask_minami_about_lexi_a73d04b0:
    minami.say "Никакие не глупости, братик."

# ch/harems/home/events/home_harem_lexi.rpy:370
translate russian ask_minami_about_lexi_8ac3e31f:
    minami.say "Ты всегда такой, когда тебе что-то нужно."

# ch/harems/home/events/home_harem_lexi.rpy:371
translate russian ask_minami_about_lexi_fff394ab:
    minami.say "Так что лучше выкладывай — и побыстрее!"

# ch/harems/home/events/home_harem_lexi.rpy:372
translate russian ask_minami_about_lexi_064206fb:
    "Я вздыхаю, сдаваясь."

# ch/harems/home/events/home_harem_lexi.rpy:373
translate russian ask_minami_about_lexi_1af4e65b:
    "Это всё равно что признаться: она меня раскусила."

# ch/harems/home/events/home_harem_lexi.rpy:374
translate russian ask_minami_about_lexi_a83a4f36:
    mike.say "Ладно, Минами, ладно."

# ch/harems/home/events/home_harem_lexi.rpy:375
translate russian ask_minami_about_lexi_7ff24b5e:
    mike.say "Поймала."

# ch/harems/home/events/home_harem_lexi.rpy:376
translate russian ask_minami_about_lexi_2a678f25:
    mike.say "Мне нужна услуга."

# ch/harems/home/events/home_harem_lexi.rpy:377
translate russian ask_minami_about_lexi_36db0e21:
    "Брови Минами взлетают вверх: ей вдруг становится интересно."

# ch/harems/home/events/home_harem_lexi.rpy:378
translate russian ask_minami_about_lexi_ef5992c4:
    "Наверное, она почуяла возможность сделать меня своим должником."

# ch/harems/home/events/home_harem_lexi.rpy:380
translate russian ask_minami_about_lexi_135f1043:
    minami.say "Слушаю, братик."

# ch/harems/home/events/home_harem_lexi.rpy:381
translate russian ask_minami_about_lexi_c34f60c9:
    minami.say "Что ещё за услуга, а?"

# ch/harems/home/events/home_harem_lexi.rpy:383
translate russian ask_minami_about_lexi_57eb170a:
    mike.say "У кое-кого из моих друзей больше нет дома."

# ch/harems/home/events/home_harem_lexi.rpy:384
translate russian ask_minami_about_lexi_c25ab8c3:
    mike.say "И сейчас совершенно некуда идти."

# ch/harems/home/events/home_harem_lexi.rpy:385
translate russian ask_minami_about_lexi_074dad05:
    mike.say "Я обещал спросить тебя и остальных, можно ли временно пожить здесь."

# ch/harems/home/events/home_harem_lexi.rpy:386
translate russian ask_minami_about_lexi_f1b05bdd:
    "Минами выглядит ещё более заинтригованной и всё время кивает."

# ch/harems/home/events/home_harem_lexi.rpy:388
translate russian ask_minami_about_lexi_5a3640d8:
    minami.say "Ох, вот не повезло, братик!"

# ch/harems/home/events/home_harem_lexi.rpy:389
translate russian ask_minami_about_lexi_b75acfcb:
    minami.say "Обязательно надо помочь."

# ch/harems/home/events/home_harem_lexi.rpy:390
translate russian ask_minami_about_lexi_41046a93:
    "Но потом выражение её лица меняется: она обдумывает возможные варианты."

# ch/harems/home/events/home_harem_lexi.rpy:393
translate russian ask_minami_about_lexi_48c9d274:
    minami.say "А кто это?"

# ch/harems/home/events/home_harem_lexi.rpy:394
translate russian ask_minami_about_lexi_7d7860b4:
    minami.say "Какой-нибудь симпатичный парень из колледжа?"

# ch/harems/home/events/home_harem_lexi.rpy:396
translate russian ask_minami_about_lexi_1a25ceb4:
    "Я выдавливаю улыбку, снова стараясь не выглядеть подозрительно."

# ch/harems/home/events/home_harem_lexi.rpy:397
translate russian ask_minami_about_lexi_dcb28f46:
    mike.say "Эм, нет..."

# ch/harems/home/events/home_harem_lexi.rpy:398
translate russian ask_minami_about_lexi_1988ef19:
    mike.say "Не совсем, Минами..."

# ch/harems/home/events/home_harem_lexi.rpy:399
translate russian ask_minami_about_lexi_2523cbdd:
    mike.say "Это девушка, её зовут Лекси!"

# ch/harems/home/events/home_harem_lexi.rpy:400
translate russian ask_minami_about_lexi_6067424a:
    "Я вполне ожидаю, что Минами тут же передумает."

# ch/harems/home/events/home_harem_lexi.rpy:401
translate russian ask_minami_about_lexi_cab95ee5:
    "Она бывает до безумия ревнивой и считает меня своей собственностью."

# ch/harems/home/events/home_harem_lexi.rpy:402
translate russian ask_minami_about_lexi_449f773a:
    "Так что неудивительно, если мысль о Лекси под одной крышей с нами ей совсем не понравится."

# ch/harems/home/events/home_harem_lexi.rpy:404
translate russian ask_minami_about_lexi_bddf791f:
    minami.say "Фу-у..."

# ch/harems/home/events/home_harem_lexi.rpy:405
translate russian ask_minami_about_lexi_514560e1:
    minami.say "Это не та потаскушка из трейлерного парка?"

# ch/harems/home/events/home_harem_lexi.rpy:406
translate russian ask_minami_about_lexi_fdcce377:
    mike.say "Ну, после того как её трейлер сгорел, она там уже не живёт!"

# ch/harems/home/events/home_harem_lexi.rpy:407
translate russian ask_minami_about_lexi_994ae284:
    mike.say "Но у неё беда, Минами."

# ch/harems/home/events/home_harem_lexi.rpy:408
translate russian ask_minami_about_lexi_bb4868a3:
    mike.say "Ты же только что говорила, что мы должны помочь?"

# ch/harems/home/events/home_harem_lexi.rpy:409
translate russian ask_minami_about_lexi_025afe0f:
    "Минами на мгновение замолкает, и я понимаю: она обдумывает мои слова."

# ch/harems/home/events/home_harem_lexi.rpy:410
translate russian ask_minami_about_lexi_32f4b9bd:
    "Очевидно, она видит в Лекси возможную соперницу."

# ch/harems/home/events/home_harem_lexi.rpy:411
translate russian ask_minami_about_lexi_1a2c7197:
    "Но если откажет, то выставит себя в плохом свете передо мной."

# ch/harems/home/events/home_harem_lexi.rpy:413
translate russian ask_minami_about_lexi_457fd059:
    mike.say "Я уже поговорил с остальными."

# ch/harems/home/events/home_harem_lexi.rpy:414
translate russian ask_minami_about_lexi_212d9738:
    mike.say "И все согласились."

# ch/harems/home/events/home_harem_lexi.rpy:416
translate russian ask_minami_about_lexi_51cb1c99:
    mike.say "[lssb_homelexi.bree_name()] и Саша уже обсудили это со мной."

# ch/harems/home/events/home_harem_lexi.rpy:417
translate russian ask_minami_about_lexi_f8d453e1:
    mike.say "И обе согласились."

# ch/harems/home/events/home_harem_lexi.rpy:419
translate russian ask_minami_about_lexi_257a516b:
    mike.say "[lssb_homelexi.bree_name()] и Сэм уже обсудили это со мной."

# ch/harems/home/events/home_harem_lexi.rpy:420
translate russian ask_minami_about_lexi_f8d453e1_1:
    mike.say "И обе согласились."

# ch/harems/home/events/home_harem_lexi.rpy:422
translate russian ask_minami_about_lexi_18fbd851:
    mike.say "Я уже поговорил с Сэм и Сашей."

# ch/harems/home/events/home_harem_lexi.rpy:423
translate russian ask_minami_about_lexi_f8d453e1_2:
    mike.say "И обе согласились."

# ch/harems/home/events/home_harem_lexi.rpy:425
translate russian ask_minami_about_lexi_a945d52e:
    mike.say "[lssb_homelexi.bree_name()] уже обсудила это со мной."

# ch/harems/home/events/home_harem_lexi.rpy:426
translate russian ask_minami_about_lexi_c2ab01f5:
    mike.say "И она согласилась."

# ch/harems/home/events/home_harem_lexi.rpy:428
translate russian ask_minami_about_lexi_81ac6660:
    mike.say "Я уже поговорил с Сашей."

# ch/harems/home/events/home_harem_lexi.rpy:429
translate russian ask_minami_about_lexi_c2ab01f5_1:
    mike.say "И она согласилась."

# ch/harems/home/events/home_harem_lexi.rpy:431
translate russian ask_minami_about_lexi_33f429cc:
    mike.say "Я уже поговорил с Сэм."

# ch/harems/home/events/home_harem_lexi.rpy:432
translate russian ask_minami_about_lexi_c2ab01f5_2:
    mike.say "И она согласилась."

# ch/harems/home/events/home_harem_lexi.rpy:434
translate russian ask_minami_about_lexi_9ccc543a:
    mike.say "С остальными я ещё не говорил."

# ch/harems/home/events/home_harem_lexi.rpy:435
translate russian ask_minami_about_lexi_9ea7ead9:
    mike.say "Но если ты согласна, уверен, мы убедим и их."

# ch/harems/home/events/home_harem_lexi.rpy:436
translate russian ask_minami_about_lexi_8b9c993e:
    "При упоминании остальных соседок Минами заметно меняется."

# ch/harems/home/events/home_harem_lexi.rpy:438
translate russian ask_minami_about_lexi_bbb89edf:
    "Конечно, ей не нравится делить меня с другими девушками."

# ch/harems/home/events/home_harem_lexi.rpy:439
translate russian ask_minami_about_lexi_4abfae53:
    "Но в этом она им уже уступила."

# ch/harems/home/events/home_harem_lexi.rpy:440
translate russian ask_minami_about_lexi_9a69e778:
    "К тому же она считает их почти старшими сёстрами и хочет заслужить их одобрение."

# ch/harems/home/events/home_harem_lexi.rpy:441
translate russian ask_minami_about_lexi_b50e5a77:
    minami.say "Ладно, братик."

# ch/harems/home/events/home_harem_lexi.rpy:442
translate russian ask_minami_about_lexi_27a9a509:
    minami.say "Если остальные не против, то я тоже."

# ch/harems/home/events/home_harem_lexi.rpy:443
translate russian ask_minami_about_lexi_8a1b228a:
    mike.say "Спасибо, Минами."

# ch/harems/home/events/home_harem_lexi.rpy:444
translate russian ask_minami_about_lexi_1450511c:
    mike.say "Ты ведь знаешь, что так будет правильно!"

# ch/harems/home/events/home_harem_lexi.rpy:445
translate russian ask_minami_about_lexi_8cdbe1cc:
    "Минами кивает и слегка улыбается."

# ch/harems/home/events/home_harem_lexi.rpy:446
translate russian ask_minami_about_lexi_b51cafdf:
    "Но по её глазам я вижу, что она ждёт исполнения этого обещания."

# ch/harems/home/events/home_harem_lexi.rpy:453
translate russian ask_sam_about_lexi_d8969d48:
    "Сэм ведь должно быть легко уговорить приютить Лекси, правда?"

# ch/harems/home/events/home_harem_lexi.rpy:454
translate russian ask_sam_about_lexi_b50bd6d6:
    "Она добрая девушка и любит помогать тем, кто в беде."

# ch/harems/home/events/home_harem_lexi.rpy:455
translate russian ask_sam_about_lexi_a93058d6:
    "К тому же после расставания с Райаном она, кажется, всё охотнее пробует новое."

# ch/harems/home/events/home_harem_lexi.rpy:456
translate russian ask_sam_about_lexi_07a18cef:
    "Если кто и не будет против соседства с такой девушкой, как Лекси, то это Сэм."

# ch/harems/home/events/home_harem_lexi.rpy:457
translate russian ask_sam_about_lexi_a45440cf:
    "Всё это крутится у меня в голове, пока я выбираю момент, чтобы спросить её мнение."

# ch/harems/home/events/home_harem_lexi.rpy:458
translate russian ask_sam_about_lexi_2ce632b9:
    "И хотя я уже убедил себя, что она согласится, в последний момент всё равно нервничаю."

# ch/harems/home/events/home_harem_lexi.rpy:460
translate russian ask_sam_about_lexi_7295c41f:
    mike.say "Сэм..."

# ch/harems/home/events/home_harem_lexi.rpy:462
translate russian ask_sam_about_lexi_3909ba22:
    mike.say "Кексик..."

# ch/harems/home/events/home_harem_lexi.rpy:463
translate russian ask_sam_about_lexi_d335862f:
    mike.say "Можно тебя кое о чём спросить?"

# ch/harems/home/events/home_harem_lexi.rpy:465
translate russian ask_sam_about_lexi_41dd73ce:
    "Сэм отрывается от своего занятия, только теперь заметив меня."

# ch/harems/home/events/home_harem_lexi.rpy:467
translate russian ask_sam_about_lexi_3de49792:
    "Она широко улыбается, явно рада меня видеть, и я убеждаюсь, что у неё хорошее настроение."

# ch/harems/home/events/home_harem_lexi.rpy:468
translate russian ask_sam_about_lexi_7a6533e2:
    "Надеюсь, и к новым идеям она сейчас открыта..."

# ch/harems/home/events/home_harem_lexi.rpy:469
translate russian ask_sam_about_lexi_d930dbce:
    samantha.say "О, привет, [lssb_common.hero_name()]."

# ch/harems/home/events/home_harem_lexi.rpy:471
translate russian ask_sam_about_lexi_0a1fa938:
    samantha.say "Конечно можно."

# ch/harems/home/events/home_harem_lexi.rpy:472
translate russian ask_sam_about_lexi_956e9bdc:
    samantha.say "Спрашивай!"

# ch/harems/home/events/home_harem_lexi.rpy:473
translate russian ask_sam_about_lexi_ede14a0c:
    mike.say "Ну, если бы ты узнала, что кто-то попал в беду."

# ch/harems/home/events/home_harem_lexi.rpy:475
translate russian ask_sam_about_lexi_6a56184f:
    mike.say "Ты ведь захотела бы помочь, правда, Кексик?"

# ch/harems/home/events/home_harem_lexi.rpy:477
translate russian ask_sam_about_lexi_7dbd141f:
    mike.say "Ты ведь захотела бы помочь, правда, Сэм?"

# ch/harems/home/events/home_harem_lexi.rpy:478
translate russian ask_sam_about_lexi_06b7a182:
    "Сэм смотрит на меня, слегка склонив голову набок."

# ch/harems/home/events/home_harem_lexi.rpy:479
translate russian ask_sam_about_lexi_911ff675:
    "Я вижу, что она пытается догадаться, к чему я клоню."

# ch/harems/home/events/home_harem_lexi.rpy:480
translate russian ask_sam_about_lexi_363ac04e:
    samantha.say "Наверное, [lssb_common.hero_name()]."

# ch/harems/home/events/home_harem_lexi.rpy:482
translate russian ask_sam_about_lexi_931bdb0e:
    samantha.say "По крайней мере, в теории."

# ch/harems/home/events/home_harem_lexi.rpy:483
translate russian ask_sam_about_lexi_30ba3bcd:
    mike.say "В теории?"

# ch/harems/home/events/home_harem_lexi.rpy:484
translate russian ask_sam_about_lexi_6ba2e185:
    samantha.say "Да, [lssb_common.hero_name()]."

# ch/harems/home/events/home_harem_lexi.rpy:485
translate russian ask_sam_about_lexi_b51d774b:
    samantha.say "Мне нужно знать, в чём проблема."

# ch/harems/home/events/home_harem_lexi.rpy:486
translate russian ask_sam_about_lexi_6d4b9257:
    samantha.say "Как я могу согласиться помочь, если даже этого не знаю?"

# ch/harems/home/events/home_harem_lexi.rpy:487
translate russian ask_sam_about_lexi_4578e59b:
    mike.say "Я... пожалуй, ты права."

# ch/harems/home/events/home_harem_lexi.rpy:489
translate russian ask_sam_about_lexi_f9414e2e:
    samantha.say "И раз уж речь о догадках, дай-ка я кое-что предположу."

# ch/harems/home/events/home_harem_lexi.rpy:490
translate russian ask_sam_about_lexi_5da62e3a:
    samantha.say "Ты хочешь кому-то помочь."

# ch/harems/home/events/home_harem_lexi.rpy:492
translate russian ask_sam_about_lexi_810f6959:
    samantha.say "Но для этого тебе нужна моя помощь, верно?"

# ch/harems/home/events/home_harem_lexi.rpy:493
translate russian ask_sam_about_lexi_ffac87b1:
    "Похоже, Сэм знает меня гораздо лучше, чем я думал!"

# ch/harems/home/events/home_harem_lexi.rpy:494
translate russian ask_sam_about_lexi_37bb305a:
    "Кажется, отрицать уже бессмысленно."

# ch/harems/home/events/home_harem_lexi.rpy:496
translate russian ask_sam_about_lexi_44b372ce:
    mike.say "А... да, Кексик, ты меня раскусила!"

# ch/harems/home/events/home_harem_lexi.rpy:498
translate russian ask_sam_about_lexi_f4f9891f:
    mike.say "А... да, Сэм, ты меня раскусила!"

# ch/harems/home/events/home_harem_lexi.rpy:499
translate russian ask_sam_about_lexi_d316ea7f:
    samantha.say "И этот кто-то — девушка, я полагаю?"

# ch/harems/home/events/home_harem_lexi.rpy:500
translate russian ask_sam_about_lexi_4636752f:
    "На этот раз она и правда застаёт меня врасплох."

# ch/harems/home/events/home_harem_lexi.rpy:501
translate russian ask_sam_about_lexi_bff1cec2:
    "И я чувствую, что начинаю краснеть."

# ch/harems/home/events/home_harem_lexi.rpy:502
translate russian ask_sam_about_lexi_ba7f7e02:
    mike.say "Ничего себе..."

# ch/harems/home/events/home_harem_lexi.rpy:503
translate russian ask_sam_about_lexi_f1006ef2:
    mike.say "Меня правда так легко раскусить?"

# ch/harems/home/events/home_harem_lexi.rpy:505
translate russian ask_sam_about_lexi_c24c1560:
    "Сэм смеётся и качает головой."

# ch/harems/home/events/home_harem_lexi.rpy:507
translate russian ask_sam_about_lexi_6d0732c1:
    samantha.say "Я тебя практически насквозь вижу!"

# ch/harems/home/events/home_harem_lexi.rpy:508
translate russian ask_sam_about_lexi_930485fb:
    samantha.say "Но если твоей подруге нужна помощь, почему просто не сказать?"

# ch/harems/home/events/home_harem_lexi.rpy:510
translate russian ask_sam_about_lexi_3d8ec679:
    mike.say "Эту подругу, кстати, зовут Лекси."

# ch/harems/home/events/home_harem_lexi.rpy:511
translate russian ask_sam_about_lexi_ac20f929:
    mike.say "Её трейлер сгорел, и сейчас она фактически бездомная."

# ch/harems/home/events/home_harem_lexi.rpy:512
translate russian ask_sam_about_lexi_85ec09ed:
    mike.say "Она спросила, можно ли поселиться здесь."

# ch/harems/home/events/home_harem_lexi.rpy:513
translate russian ask_sam_about_lexi_290ec39d:
    mike.say "Только пока не встанет на ноги."

# ch/harems/home/events/home_harem_lexi.rpy:514
translate russian ask_sam_about_lexi_4297418e:
    "Сэм кивает, наконец поняв всю картину."

# ch/harems/home/events/home_harem_lexi.rpy:515
translate russian ask_sam_about_lexi_22169d0d:
    samantha.say "И ты думал, что я могу отказать?"

# ch/harems/home/events/home_harem_lexi.rpy:516
