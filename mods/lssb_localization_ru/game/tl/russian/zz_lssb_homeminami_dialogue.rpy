# ch/harems/home/events/home_harem_minami.rpy:2647
translate russian minami_sasha_threesome_intro_6a578d84:
    sasha.say "О нет..."

# ch/harems/home/events/home_harem_minami.rpy:2648
translate russian minami_sasha_threesome_intro_b872dd4d:
    sasha.say "Только не это!"

# ch/harems/home/events/home_harem_minami.rpy:2649
translate russian minami_sasha_threesome_intro_b3315564:
    sasha.say "Вы двое что, застеснялись?"

# ch/harems/home/events/home_harem_minami.rpy:2650
translate russian minami_sasha_threesome_intro_8f0cf908:
    "От этого обвинения у меня сразу вспыхивают щёки."

# ch/harems/home/events/home_harem_minami.rpy:2651
translate russian minami_sasha_threesome_intro_f526be0b:
    "Вопрос Саши задевает моё мужское самолюбие и сильно меня смущает."

# ch/harems/home/events/home_harem_minami.rpy:2653
translate russian minami_sasha_threesome_intro_d942f92d:
    "Я бросаю быстрый взгляд на Минами и вижу, что она тоже покраснела."

# ch/harems/home/events/home_harem_minami.rpy:2654
translate russian minami_sasha_threesome_intro_15af66fd:
    mike.say "Н... нет, Саша!"

# ch/harems/home/events/home_harem_minami.rpy:2656
translate russian minami_sasha_threesome_intro_184aec4d:
    mike.say "Я просто беспокоился о Минами, вот и всё!"

# ch/harems/home/events/home_harem_minami.rpy:2658
translate russian minami_sasha_threesome_intro_1ee85a7c:
    minami.say "О, спасибо, братик!"

# ch/harems/home/events/home_harem_minami.rpy:2659
translate russian minami_sasha_threesome_intro_d054e07b:
    minami.say "Вот так взял и подставил меня!"

# ch/harems/home/events/home_harem_minami.rpy:2661
translate russian minami_sasha_threesome_intro_3364caa7:
    "Саша заливается смехом и качает головой."

# ch/harems/home/events/home_harem_minami.rpy:2662
translate russian minami_sasha_threesome_intro_8c3db393:
    "Но я понимаю, что в её смехе нет злобы."

# ch/harems/home/events/home_harem_minami.rpy:2663
translate russian minami_sasha_threesome_intro_c93d417f:
    "Наоборот, он очень тёплый и ласковый."

# ch/harems/home/events/home_harem_minami.rpy:2665
translate russian minami_sasha_threesome_intro_0e2742d6:
    sasha.say "Ну же, ребята!"

# ch/harems/home/events/home_harem_minami.rpy:2666
translate russian minami_sasha_threesome_intro_7ba38fee:
    sasha.say "Мы ведь собирались получить удовольствие."

# ch/harems/home/events/home_harem_minami.rpy:2667
translate russian minami_sasha_threesome_intro_19c12161:
    sasha.say "И мы его ПОЛУЧИМ!"

# ch/harems/home/events/home_harem_minami.rpy:2669
translate russian minami_sasha_threesome_intro_ebd1738a:
    "Не дав нам сказать больше ни слова, Саша переходит к делу."

# ch/harems/home/events/home_harem_minami.rpy:2673
translate russian minami_sasha_threesome_intro_85cf5593:
    "Она хватает нас с Минами за руки и тянет к кровати."

# ch/harems/home/events/home_harem_minami.rpy:2674
translate russian minami_sasha_threesome_intro_c4344237:
    "Мы идём следом скорее от неожиданности, чем от нетерпения."

# ch/harems/home/events/home_harem_minami.rpy:2675
translate russian minami_sasha_threesome_intro_7e9d2bbc:
    "И как только мы добираемся до места, Саша нас отпускает."

# ch/harems/home/events/home_harem_minami.rpy:2676
translate russian minami_sasha_threesome_intro_c3e0acec:
    sasha.say "Обычно на этом месте мы снимаем одежду, ясно?"

# ch/harems/home/events/home_harem_minami.rpy:2677
translate russian minami_sasha_threesome_intro_6047717f:
    sasha.say "Так что я сейчас этим и займусь, а вы можете присоединиться!"

# ch/harems/home/events/home_harem_minami.rpy:2679
translate russian minami_sasha_threesome_intro_e697fd34:
    "Саша держит слово и раздевается перед нами."

# ch/harems/home/events/home_harem_minami.rpy:2681
translate russian minami_sasha_threesome_intro_010670b9:
    "И от этого зрелища словно разряд проходит через всё моё тело и разум."

# ch/harems/home/events/home_harem_minami.rpy:2682
translate russian minami_sasha_threesome_intro_db43beb8:
    "Она права, я слишком много думаю."

# ch/harems/home/events/home_harem_minami.rpy:2683
translate russian minami_sasha_threesome_intro_2905aaa3:
    "Нужно просто отдаться происходящему."

# ch/harems/home/events/home_harem_minami.rpy:2684
translate russian minami_sasha_threesome_intro_764ab395:
    "Саша кивает, заметив, что я следую её примеру."

# ch/harems/home/events/home_harem_minami.rpy:2686
translate russian minami_sasha_threesome_intro_bb225411:
    "Мгновение спустя к нам присоединяется и Минами."

# ch/harems/home/events/home_harem_minami.rpy:2688
translate russian minami_sasha_threesome_intro_ac88e1ef:
    "Вскоре одежда уже разбросана по всему полу."

# ch/harems/home/events/home_harem_minami.rpy:2689
translate russian minami_sasha_threesome_intro_9e7ed070:
    "Когда мы заканчиваем, на нас наконец ничего не остаётся."

# ch/harems/home/events/home_harem_minami.rpy:2690
translate russian minami_sasha_threesome_intro_60613d61:
    minami.say "У... ух ты!"

# ch/harems/home/events/home_harem_minami.rpy:2692
translate russian minami_sasha_threesome_intro_51da6c0b:
    minami.say "Ты очень красивая без одежды, Саша!"

# ch/harems/home/events/home_harem_minami.rpy:2693
translate russian minami_sasha_threesome_intro_8df40d42:
    sasha.say "Ты давно в зеркало смотрела, Минами?"

# ch/harems/home/events/home_harem_minami.rpy:2694
translate russian minami_sasha_threesome_intro_a18187ff:
    sasha.say "Потому что, когда я смотрю на тебя..."

# ch/harems/home/events/home_harem_minami.rpy:2696
translate russian minami_sasha_threesome_intro_71f3943e:
    sasha.say "Мне тоже хочется сказать «ух ты»!"

# ch/harems/home/events/home_harem_minami.rpy:2697
translate russian minami_sasha_threesome_intro_163c5fe9:
    "Я знаю, что лучше бы промолчать."

# ch/harems/home/events/home_harem_minami.rpy:2698
translate russian minami_sasha_threesome_intro_5bcc4b43:
    "Но какая-то часть меня не может удержаться."

# ch/harems/home/events/home_harem_minami.rpy:2699
translate russian minami_sasha_threesome_intro_c6c245b3:
    "И, клянусь, я не контролирую то, что срывается с языка!"

# ch/harems/home/events/home_harem_minami.rpy:2701
translate russian minami_sasha_threesome_intro_d163724d:
    mike.say "А я что?"

# ch/harems/home/events/home_harem_minami.rpy:2702
translate russian minami_sasha_threesome_intro_a5cbfc2e:
    mike.say "Невидимка, что ли?!"

# ch/harems/home/events/home_harem_minami.rpy:2705
translate russian minami_sasha_threesome_intro_1d842164:
    "Минами и Саша поворачиваются ко мне."

# ch/harems/home/events/home_harem_minami.rpy:2706
translate russian minami_sasha_threesome_intro_5f524884:
    "И я тут же жалею, что подал голос."

# ch/harems/home/events/home_harem_minami.rpy:2708
translate russian minami_sasha_threesome_intro_72da2dd5:
    sasha.say "О нет, кто-то ревнует!"

# ch/harems/home/events/home_harem_minami.rpy:2709
translate russian minami_sasha_threesome_intro_cfac8c03:
    minami.say "Ты тоже отлично выглядишь, братик!"

# ch/harems/home/events/home_harem_minami.rpy:2711
translate russian minami_sasha_threesome_intro_ca908ed6:
    minami.say "Ну конечно!"

# ch/harems/home/events/home_harem_minami.rpy:2712
translate russian minami_sasha_threesome_intro_15b52d07:
    "Я киваю и закатываю глаза, отчаянно желая сменить тему."

# ch/harems/home/events/home_harem_minami.rpy:2713
translate russian minami_sasha_threesome_intro_7b2af650:
    mike.say "Да, да, да..."

# ch/harems/home/events/home_harem_minami.rpy:2714
translate russian minami_sasha_threesome_intro_79512679:
    mike.say "Меньше слов, больше дела, верно?"

# ch/harems/home/events/home_harem_minami.rpy:2715
translate russian minami_sasha_threesome_intro_e072f1a6:
    "Услышав это, Минами и Саша многозначительно переглядываются."

# ch/harems/home/events/home_harem_minami.rpy:2716
translate russian minami_sasha_threesome_intro_b766c9d0:
    "Затем обе встают передо мной, ожидая моего следующего шага..."

# ch/harems/home/events/home_harem_minami.rpy:2724
translate russian minami_sasha_threesome_intro_89b3bf39:
    "Когда всё заканчивается, ни у кого, кажется, нет ни сил, ни желания говорить."

# ch/harems/home/events/home_harem_minami.rpy:2725
translate russian minami_sasha_threesome_intro_d12a9036:
    "Мы просто лежим на кровати, переплетя руки и ноги и остывая после жарких ласк."

# ch/harems/home/events/home_harem_minami.rpy:2726
translate russian minami_sasha_threesome_intro_c3c4196a:
    "Но по улыбкам на лицах Саши и Минами я понимаю, что все довольны."

# ch/harems/home/events/home_harem_minami.rpy:2727
translate russian minami_sasha_threesome_intro_3e9559c1:
    "Я-то уж точно!"

# ch/harems/home/events/home_harem_minami.rpy:2734
translate russian minami_sasha_threesome_030296ef:
    "Первым делом я инстинктивно тянусь к Минами, желая её успокоить."

# ch/harems/home/events/home_harem_minami.rpy:2735
translate russian minami_sasha_threesome_41e441d4:
    "Она подпрыгивает и удивлённо вскрикивает, как только мои руки обхватывают её талию."

# ch/harems/home/events/home_harem_minami.rpy:2737
translate russian minami_sasha_threesome_f3137a95:
    minami.say "Ох..."

# ch/harems/home/events/home_harem_minami.rpy:2739
translate russian minami_sasha_threesome_47ae15e6:
    minami.say "Что ты..."

# ch/harems/home/events/home_harem_minami.rpy:2740
translate russian minami_sasha_threesome_ab32b1e2:
    "Но тут она видит намерение в моих глазах."

# ch/harems/home/events/home_harem_minami.rpy:2741
translate russian minami_sasha_threesome_c0a53401:
    "И вопрос замирает у неё на губах."

# ch/harems/home/events/home_harem_minami.rpy:2742
translate russian minami_sasha_threesome_2e4baacb:
    "Пользуясь моментом, я направляю Минами на кровать."

# ch/harems/home/events/home_harem_minami.rpy:2744
translate russian minami_sasha_threesome_2579ef39:
    "Даю ей встать на четвереньки."

# ch/harems/home/events/home_harem_minami.rpy:2745
translate russian minami_sasha_threesome_9f08dd98:
    "Но не позволяю лечь."

# ch/harems/home/events/home_harem_minami.rpy:2746
translate russian minami_sasha_threesome_0e072aba:
    "Всё это время Саша наблюдает за моими действиями."

# ch/harems/home/events/home_harem_minami.rpy:2747
translate russian minami_sasha_threesome_cc436065:
    "И именно сейчас решает сделать свой ход."

# ch/harems/home/events/home_harem_minami.rpy:2748
translate russian minami_sasha_threesome_1282ec0a:
    "Она молниеносно проскальзывает между мной и Минами."

# ch/harems/home/events/home_harem_minami.rpy:2749
translate russian minami_sasha_threesome_b9b20900:
    "Думаю, сначала Минами кажется, что сзади неё всё ещё я."

# ch/harems/home/events/home_harem_minami.rpy:2750
translate russian minami_sasha_threesome_2e56f2a6:
    "Но, оглянувшись через плечо, она видит лицо Саши!"

# ch/harems/home/events/home_harem_minami.rpy:2752
translate russian minami_sasha_threesome_01586caa:
    minami.say "А?!"

# ch/harems/home/events/home_harem_minami.rpy:2753
translate russian minami_sasha_threesome_51457fa1:
    minami.say "Саша?"

# ch/harems/home/events/home_harem_minami.rpy:2754
translate russian minami_sasha_threesome_c3876327:
    minami.say "Ты откуда взялась?"

# ch/harems/home/events/home_harem_minami.rpy:2755
translate russian minami_sasha_threesome_96ebd208:
    sasha.say "Тсс!"

# ch/harems/home/events/home_harem_minami.rpy:2756
translate russian minami_sasha_threesome_cff32db2:
    sasha.say "Сейчас будет потрясающе!"

# ch/harems/home/events/home_harem_minami.rpy:2757
translate russian minami_sasha_threesome_419d60c4:
    "Я закатываю глаза: Саша задала мне очень высокую планку."

# ch/harems/home/events/home_harem_minami.rpy:2758
translate russian minami_sasha_threesome_a08d2278:
    "Но, к счастью, ни она, ни Минами этого не замечают."

# ch/harems/home/events/home_harem_minami.rpy:2759
translate russian minami_sasha_threesome_9328e546:
    "Теперь мне остаётся лишь оправдать их ожидания!"

# ch/harems/home/events/home_harem_minami.rpy:2763
translate russian minami_sasha_threesome_6e5dacb8:
    "Может, это и прозвучит плохо, но сейчас до Минами проще добраться."

# ch/harems/home/events/home_harem_minami.rpy:2764
translate russian minami_sasha_threesome_c0118b73:
    "В такой позе трахнуть её гораздо легче, чем Сашу."

# ch/harems/home/events/home_harem_minami.rpy:2765
translate russian minami_sasha_threesome_1f3766e6:
    "К тому же так у меня останутся другие варианты на потом!"

# ch/harems/home/events/home_harem_minami.rpy:2766
translate russian minami_sasha_threesome_7dd0367e:
    "Я крепче сжимаю бёдра Минами и тяну её назад."

# ch/harems/home/events/home_harem_minami.rpy:2767
translate russian minami_sasha_threesome_2d203395:
    "Она снова удивлённо вскрикивает — или на этот раз от предвкушения?"

# ch/harems/home/events/home_harem_minami.rpy:2768
translate russian minami_sasha_threesome_d32695bd:
    "Но я не обращаю на это внимания и уверенно направляю член между её бёдер."

# ch/harems/home/events/home_harem_minami.rpy:2772
translate russian minami_sasha_threesome_8c411ec1:
    "Не хочу терять время, чтобы Минами снова не начала нервничать."

# ch/harems/home/events/home_harem_minami.rpy:2773
translate russian minami_sasha_threesome_1f7b7eef:
    "Но и делать что-нибудь настолько безумное, что она испугается, мне тоже не хочется."

# ch/harems/home/events/home_harem_minami.rpy:2774
translate russian minami_sasha_threesome_2a25a923:
    "Поэтому я без затей направляюсь прямо к её киске."

# ch/harems/home/events/home_harem_minami.rpy:2775
translate russian minami_sasha_threesome_0bd0c4a3:
    "И в тот же миг невольно улыбаюсь своим ощущениям."

# ch/harems/home/events/home_harem_minami.rpy:2782
translate russian minami_sasha_threesome_2a142214:
    "Губки Минами уже скользкие и мягкие, когда касаются головки моего члена."

# ch/harems/home/events/home_harem_minami.rpy:2783
translate russian minami_sasha_threesome_b73c0200:
    "Значит, несмотря на всё волнение, она невероятно возбуждена!"

# ch/harems/home/events/home_harem_minami.rpy:2784
translate russian minami_sasha_threesome_767702e7:
    "Понимая это, я и сам воодушевляюсь."

# ch/harems/home/events/home_harem_minami.rpy:2785
translate russian minami_sasha_threesome_faa39260:
    "Нужен всего один быстрый толчок..."

# ch/harems/home/events/home_harem_minami.rpy:2786
translate russian minami_sasha_threesome_415d46a2:
    "И я чувствую, как головка моего члена погружается в неё!"

# ch/harems/home/events/home_harem_minami.rpy:2789
translate russian minami_sasha_threesome_c3ddfb71:
    "Нужно действовать быстро, если я хочу осуществить задуманное."

# ch/harems/home/events/home_harem_minami.rpy:2790
translate russian minami_sasha_threesome_39f39177:
    "Поэтому, не теряя времени, я направляю член выше и приступаю."

# ch/harems/home/events/home_harem_minami.rpy:2792
translate russian minami_sasha_threesome_d0d0be77:
    "Минами вскрикивает в третий раз, когда я вхожу в её попку."

# ch/harems/home/events/home_harem_minami.rpy:2793
translate russian minami_sasha_threesome_ff193c6c:
    "Но я ни на миг не останавливаюсь, не обращая внимания на её реакцию."

# ch/harems/home/events/home_harem_minami.rpy:2794
translate russian minami_sasha_threesome_2ae54e8b:
    "Она извивается и ёрзает, но этим лишь играет мне на руку."

# ch/harems/home/events/home_harem_minami.rpy:2795
translate russian minami_sasha_threesome_6d69778a:
    "Ведь так Минами только глубже насаживается на мой член!"

# ch/harems/home/events/home_harem_minami.rpy:2796
translate russian minami_sasha_threesome_a1fb95b2:
    "Вдруг я чувствую, как меняются ощущения вокруг головки."

# ch/harems/home/events/home_harem_minami.rpy:2797
translate russian minami_sasha_threesome_bb80c36c:
    "И сам ахаю, одним плавным движением погружаясь в её попку."

# ch/harems/home/events/home_harem_minami.rpy:2798
translate russian minami_sasha_threesome_6e7a6a79:
    "Словно тело Минами разом сдаётся, а сопротивление тает."

# ch/harems/home/events/home_harem_minami.rpy:2799
translate russian minami_sasha_threesome_f3137a95_1:
    minami.say "Ох..."

# ch/harems/home/events/home_harem_minami.rpy:2800
translate russian minami_sasha_threesome_9e680d55:
    minami.say "Ох, братик..."

# ch/harems/home/events/home_harem_minami.rpy:2802
translate russian minami_sasha_threesome_cdbe5377:
    minami.say "Ты такой... такой БОЛЬШОЙ!"

# ch/harems/home/events/home_harem_minami.rpy:2803
translate russian minami_sasha_threesome_5178bbb9:
    "Сейчас быть внутри Минами невероятно приятно."

# ch/harems/home/events/home_harem_minami.rpy:2804
translate russian minami_sasha_threesome_a9e833df:
    "А от её комплиментов я ещё и раздуваюсь от гордости!"

# ch/harems/home/events/home_harem_minami.rpy:2805
translate russian minami_sasha_threesome_fe803a4d:
    "Наверное, поэтому я не замечаю, чем в это время занимается Саша."

# ch/harems/home/events/home_harem_minami.rpy:2806
translate russian minami_sasha_threesome_def3442e:
    sasha.say "Конечно, он большой, Минами..."

# ch/harems/home/events/home_harem_minami.rpy:2807
translate russian minami_sasha_threesome_af101102:
    sasha.say "Такой большой, что хватит на двоих!"

# ch/harems/home/events/home_harem_minami.rpy:2808
translate russian minami_sasha_threesome_56771225:
    "Именно в этот момент я открываю глаза и вижу попку Саши."

# ch/harems/home/events/home_harem_minami.rpy:2809
translate russian minami_sasha_threesome_4efbacdd:
    "И мне даже не приходится опускать взгляд — она прямо передо мной!"

# ch/harems/home/events/home_harem_minami.rpy:2810
translate russian minami_sasha_threesome_29bf07ff:
    "Саша вытягивает ноги так, чтобы её попка оказалась у моего лица!"

# ch/harems/home/events/home_harem_minami.rpy:2811
translate russian minami_sasha_threesome_74b715a6:
    "Похоже, она не собирается упускать свою долю удовольствия."

# ch/harems/home/events/home_harem_minami.rpy:2812
translate russian minami_sasha_threesome_be8335f6:
    "Но это не значит, что я не могу выбрать, куда она его получит!"

# ch/harems/home/events/home_harem_minami.rpy:2815
translate russian minami_sasha_threesome_eb074d95:
    "Я уже вижу киску Саши между её бёдер."

# ch/harems/home/events/home_harem_minami.rpy:2816
translate russian minami_sasha_threesome_6d87c1ac:
    "А уловив ещё и её запах, окончательно решаюсь."

# ch/harems/home/events/home_harem_minami.rpy:2817
translate russian minami_sasha_threesome_616d1ac1:
    "Наклоняюсь вперёд и высовываю язык, изо всех сил стараясь дотянуться..."

# ch/harems/home/events/home_harem_minami.rpy:2819
translate russian minami_sasha_threesome_ebd197b1:
    sasha.say "М-м-м..."

# ch/harems/home/events/home_harem_minami.rpy:2820
translate russian minami_sasha_threesome_0d708c41:
    sasha.say "Ох, чёрт..."

# ch/harems/home/events/home_harem_minami.rpy:2821
translate russian minami_sasha_threesome_283c9af9:
    "Я чувствую трепет кончиком языка, когда Саша стонет."

# ch/harems/home/events/home_harem_minami.rpy:2822
translate russian minami_sasha_threesome_9ebc3a92:
    "И после этого меня уже ничто не остановит."

# ch/harems/home/events/home_harem_minami.rpy:2823
translate russian minami_sasha_threesome_f128c380:
    "Я погружаю язык ещё глубже, прощупывая и исследуя всё на своём пути."

# ch/harems/home/events/home_harem_minami.rpy:2824
translate russian minami_sasha_threesome_c4fd6e6d:
    "Награда мне — возможность чувствовать и слышать, как это действует на Сашу."

# ch/harems/home/events/home_harem_minami.rpy:2826
translate russian minami_sasha_threesome_c0faeb9f:
    "Я уже вижу маленький тугой анус Саши между её ягодиц."

# ch/harems/home/events/home_harem_minami.rpy:2827
translate russian minami_sasha_threesome_3861b05b:
    "Он выглядит так аккуратно, идеально и соблазнительно, что я не могу удержаться."

# ch/harems/home/events/home_harem_minami.rpy:2828
translate russian minami_sasha_threesome_616d1ac1_1:
    "Наклоняюсь вперёд и высовываю язык, изо всех сил стараясь дотянуться..."

# ch/harems/home/events/home_harem_minami.rpy:2830
translate russian minami_sasha_threesome_ebd197b1_1:
    sasha.say "М-м-м..."

# ch/harems/home/events/home_harem_minami.rpy:2831
translate russian minami_sasha_threesome_0d708c41_1:
    sasha.say "Ох, чёрт..."

# ch/harems/home/events/home_harem_minami.rpy:2832
translate russian minami_sasha_threesome_5b206688:
    "Кончиком языка я чувствую дрожь мышц Саши, пока она стонет."

# ch/harems/home/events/home_harem_minami.rpy:2833
translate russian minami_sasha_threesome_9ebc3a92_1:
    "И после этого меня уже ничто не остановит."

# ch/harems/home/events/home_harem_minami.rpy:2834
translate russian minami_sasha_threesome_f128c380_1:
    "Я погружаю язык ещё глубже, прощупывая и исследуя всё на своём пути."

# ch/harems/home/events/home_harem_minami.rpy:2835
translate russian minami_sasha_threesome_c4fd6e6d_1:
    "Награда мне — возможность чувствовать и слышать, как это действует на Сашу."

# ch/harems/home/events/home_harem_minami.rpy:2837
translate russian minami_sasha_threesome_eb282445:
    minami.say "А как же я, братик?"

# ch/harems/home/events/home_harem_minami.rpy:2838
translate russian minami_sasha_threesome_f537a354:
    minami.say "Не забывай обо мне!"

# ch/harems/home/events/home_harem_minami.rpy:2839
translate russian minami_sasha_threesome_135f33ae:
    "Я понимаю, что стал двигаться в Минами медленнее, отвлёкшись на Сашу."

# ch/harems/home/events/home_harem_minami.rpy:2840
translate russian minami_sasha_threesome_564330b7:
    "И удваиваю усилия, всё ещё стараясь удовлетворить обеих девушек."

# ch/harems/home/events/home_harem_minami.rpy:2841
translate russian minami_sasha_threesome_61cfcca1:
    "Тело Минами поглощает всё, что я могу ему дать."

# ch/harems/home/events/home_harem_minami.rpy:2842
translate russian minami_sasha_threesome_f0260073:
    "Но требует ещё, как бы сильно я её ни трахал."

# ch/harems/home/events/home_harem_minami.rpy:2844
translate russian minami_sasha_threesome_cc6e417f:
    "А Саша в это же время требует того же от моего языка."

# ch/harems/home/events/home_harem_minami.rpy:2845
translate russian minami_sasha_threesome_2c684516:
    "Обе тяжело дышат, покрытые скользким потом."

# ch/harems/home/events/home_harem_minami.rpy:2846
translate russian minami_sasha_threesome_0183e2cd:
    "Так что удерживать их тоже становится всё труднее!"

# ch/harems/home/events/home_harem_minami.rpy:2848
translate russian minami_sasha_threesome_ccb41e35:
    minami.say "Не останавливайся, братик!"

# ch/harems/home/events/home_harem_minami.rpy:2849
translate russian minami_sasha_threesome_bdb5a7a8:
    minami.say "Я... я сейчас кончу!"

# ch/harems/home/events/home_harem_minami.rpy:2850
translate russian minami_sasha_threesome_d02f99ce:
    sasha.say "Ах... я..."

# ch/harems/home/events/home_harem_minami.rpy:2851
translate russian minami_sasha_threesome_d67c1869:
    sasha.say "Я тоже!"

# ch/harems/home/events/home_harem_minami.rpy:2852
translate russian minami_sasha_threesome_edfae4a7:
    "Эти слова приносят благословенное облегчение, почти помилование."

# ch/harems/home/events/home_harem_minami.rpy:2853
translate russian minami_sasha_threesome_209de354:
    "И я уже чувствую, как внутри меня рушится преграда."

# ch/harems/home/events/home_harem_minami.rpy:2854
translate russian minami_sasha_threesome_132d5ee8:
    "Без предупреждения я отрываюсь губами от Саши."

# ch/harems/home/events/home_harem_minami.rpy:2855
translate russian minami_sasha_threesome_07da6d91:
    "И вцепляюсь в Минами так, словно от этого зависит моя жизнь!"

# ch/harems/home/events/home_harem_minami.rpy:2859
translate russian minami_sasha_threesome_3eb3a318:
    "Я двигаюсь в ней уже так сильно, что не успеваю остановиться!"

# ch/harems/home/events/home_harem_minami.rpy:2861
translate russian minami_sasha_threesome_1836bedd:
    "И в тот миг, когда я начинаю кончать в Минами, Саша теряет равновесие."

# ch/harems/home/events/home_harem_minami.rpy:2865
translate russian minami_sasha_threesome_307b4676:
    "Она заваливается вперёд, едва не сделав колесо на кровати."

# ch/harems/home/events/home_harem_minami.rpy:2866
translate russian minami_sasha_threesome_cb07469c:
    sasha.say "У... ух!"

# ch/harems/home/events/home_harem_minami.rpy:2867
translate russian minami_sasha_threesome_eb10f8e2:
    "Всё это происходит, пока я наполняю Минами всем, что у меня есть."

# ch/harems/home/events/home_harem_minami.rpy:2868
translate russian minami_sasha_threesome_3ae0fe29:
    minami.say "Ах... ах..."

# ch/harems/home/events/home_harem_minami.rpy:2870
translate russian minami_sasha_threesome_5ffa20f8:
    minami.say "Ох... ох, братик!"

# ch/harems/home/events/home_harem_minami.rpy:2871
translate russian minami_sasha_threesome_5e9a46b9:
    minami.say "Обожаю, когда ты кончаешь в меня!"

# ch/harems/home/events/home_harem_minami.rpy:2873
translate russian minami_sasha_threesome_bc935859:
    "Нужно вытащить прямо сейчас, иначе будет поздно!"

# ch/harems/home/events/home_harem_minami.rpy:2874
translate russian minami_sasha_threesome_199491af:
    "Но стоит мне это сделать, как Саша теряет равновесие."

# ch/harems/home/events/home_harem_minami.rpy:2875
translate russian minami_sasha_threesome_307b4676_1:
    "Она заваливается вперёд, едва не сделав колесо на кровати."

# ch/harems/home/events/home_harem_minami.rpy:2876
translate russian minami_sasha_threesome_cb07469c_1:
    sasha.say "У... ух!"

# ch/harems/home/events/home_harem_minami.rpy:2878
translate russian minami_sasha_threesome_b8393a31:
    "Всё это происходит, пока я кончаю на попку Минами."

# ch/harems/home/events/home_harem_minami.rpy:2880
translate russian minami_sasha_threesome_6b990722:
    "Она ахает, когда горячая сперма рисует липкие белые полосы на её ягодицах."

# ch/harems/home/events/home_harem_minami.rpy:2882
translate russian minami_sasha_threesome_89f7a72f:
    "Но затем оглядывается на меня через плечо и лукаво хихикает."

# ch/harems/home/events/home_harem_minami.rpy:2883
translate russian minami_sasha_threesome_f1785d84:
    minami.say "Ох, братик!"

# ch/harems/home/events/home_harem_minami.rpy:2884
translate russian minami_sasha_threesome_64a402f2:
    minami.say "Посмотри, как ты меня испачкал!"

# ch/harems/home/events/home_harem_minami.rpy:2888
translate russian minami_sasha_threesome_de9fb166:
    "Часть меня считает, что стоит поставить Сашу на место, выбрав для секса Минами."

# ch/harems/home/events/home_harem_minami.rpy:2889
translate russian minami_sasha_threesome_7c7c9ff9:
    "Ведь у Минами меньше всего опыта в таких делах."

# ch/harems/home/events/home_harem_minami.rpy:2890
translate russian minami_sasha_threesome_4eedac42:
    "Но, может, ей как раз и нужно, чтобы Саша взяла инициативу на себя?"

# ch/harems/home/events/home_harem_minami.rpy:2891
translate russian minami_sasha_threesome_43af6791:
    "Ну, чтобы более уверенная девушка показала ей, что делать."

# ch/harems/home/events/home_harem_minami.rpy:2892
translate russian minami_sasha_threesome_f8d29ed3:
    "Я убираю руки с Минами и вместо неё хватаю Сашу."

# ch/harems/home/events/home_harem_minami.rpy:2894
translate russian minami_sasha_threesome_a021a606:
    "Первая издаёт удивлённый, а может, даже разочарованный вздох."

# ch/harems/home/events/home_harem_minami.rpy:2895
translate russian minami_sasha_threesome_68b62f19:
    "Зато вторая охотно кивает, прижимая попку к моему паху."

# ch/harems/home/events/home_harem_minami.rpy:2896
translate russian minami_sasha_threesome_6c53d943:
    "Я без промедления устраиваю Сашу именно так, как мне нужно."

# ch/harems/home/events/home_harem_minami.rpy:2897
translate russian minami_sasha_threesome_6338370a:
    "А затем направляю член прямо между её бёдер..."

# ch/harems/home/events/home_harem_minami.rpy:2901
translate russian minami_sasha_threesome_f80f3ac1:
    "Саша так сильно прижимается ко мне, что попасть куда хочется непросто."

# ch/harems/home/events/home_harem_minami.rpy:2902
translate russian minami_sasha_threesome_6903697c:
    "В итоге мой член оказывается у её киски почти случайно."

# ch/harems/home/events/home_harem_minami.rpy:2909
translate russian minami_sasha_threesome_e589fd16:
    "Она уже полностью готова, её губки влажные и скользкие."

# ch/harems/home/events/home_harem_minami.rpy:2910
translate russian minami_sasha_threesome_d800194d:
    "Так что я не успеваю опомниться, как головка уже внутри."

# ch/harems/home/events/home_harem_minami.rpy:2911
translate russian minami_sasha_threesome_707f386f:
    "Саша стонет и, клянусь, даже мурлычет, когда он входит в неё."

# ch/harems/home/events/home_harem_minami.rpy:2912
translate russian minami_sasha_threesome_d471ff55:
    "Да и с моей стороны ощущения просто потрясающие!"

# ch/harems/home/events/home_harem_minami.rpy:2913
translate russian minami_sasha_threesome_6d077837:
    "Я продолжаю входить, пока глубже уже некуда."

# ch/harems/home/events/home_harem_minami.rpy:2914
translate russian minami_sasha_threesome_64089aff:
    "Киска Саши поглощает меня без малейшего колебания."

# ch/harems/home/events/home_harem_minami.rpy:2917
translate russian minami_sasha_threesome_67a7e383:
    "Саша так сильно прижимается ко мне, что нужно проследить, чтобы я попал куда хочу."

# ch/harems/home/events/home_harem_minami.rpy:2918
translate russian minami_sasha_threesome_7548119f:
    "Поэтому я мгновенно решаю выбрать ближайшую и самую доступную цель."

# ch/harems/home/events/home_harem_minami.rpy:2919
translate russian minami_sasha_threesome_404c93d8:
    "Направляюсь выше обычного — прямо к заветному местечку между её ягодиц."

# ch/harems/home/events/home_harem_minami.rpy:2921
translate russian minami_sasha_threesome_a41717e9:
    sasha.say "Чт..."

# ch/harems/home/events/home_harem_minami.rpy:2922
translate russian minami_sasha_threesome_a9cf6213:
    sasha.say "Куда ты..."

# ch/harems/home/events/home_harem_minami.rpy:2923
translate russian minami_sasha_threesome_6fec547e:
    sasha.say "Ох, блядь!"

# ch/harems/home/events/home_harem_minami.rpy:2924
translate russian minami_sasha_threesome_9f30e46e:
    "Мышцы попки Саши изо всех сил пытаются мне сопротивляться."

# ch/harems/home/events/home_harem_minami.rpy:2925
translate russian minami_sasha_threesome_7c5a2da2:
    "Но сила тяжести на моей стороне."

# ch/harems/home/events/home_harem_minami.rpy:2926
translate russian minami_sasha_threesome_3205c653:
    "Ну и то, что Саша та ещё развратная сучка!"

# ch/harems/home/events/home_harem_minami.rpy:2927
translate russian minami_sasha_threesome_acf77c26:
    "Вскоре её мышцы прекращают борьбу, и она медленно опускается на мой член."

# ch/harems/home/events/home_harem_minami.rpy:2928
translate russian minami_sasha_threesome_ebd197b1_2:
    sasha.say "М-м-м..."

# ch/harems/home/events/home_harem_minami.rpy:2929
translate russian minami_sasha_threesome_79e4afdb:
    sasha.say "КАК же хорошо!"

# ch/harems/home/events/home_harem_minami.rpy:2930
translate russian minami_sasha_threesome_11b02d65:
    sasha.say "Не останавливайся, [lssb_common.hero_name()]!"

# ch/harems/home/events/home_harem_minami.rpy:2932
translate russian minami_sasha_threesome_9b786ee0:
    "Можно подумать, меня нужно подбадривать!"

# ch/harems/home/events/home_harem_minami.rpy:2933
translate russian minami_sasha_threesome_be51dc13:
    "Я уже начинаю двигаться в Саше с полной решимостью."

# ch/harems/home/events/home_harem_minami.rpy:2934
translate russian minami_sasha_threesome_01ea4bd8:
    "Так что её слова лишь усиливают моё желание трахать её как никогда сильно!"

# ch/harems/home/events/home_harem_minami.rpy:2935
translate russian minami_sasha_threesome_25e96899:
    "Быть внутри Саши настолько приятно, что я забываю обо всём остальном."

# ch/harems/home/events/home_harem_minami.rpy:2936
translate russian minami_sasha_threesome_c5befb2b:
    "Важны лишь ощущения в члене, когда он движется взад-вперёд."

# ch/harems/home/events/home_harem_minami.rpy:2937
translate russian minami_sasha_threesome_4dc3890c:
    "И то, как она двигается подо мной, отвечая телом на мои толчки."

# ch/harems/home/events/home_harem_minami.rpy:2938
translate russian minami_sasha_threesome_ce719c13:
    "Лишь открыв наконец глаза, я кое-что вспоминаю."

# ch/harems/home/events/home_harem_minami.rpy:2939
translate russian minami_sasha_threesome_53edd2d3:
    "Мы с Сашей здесь не одни."

# ch/harems/home/events/home_harem_minami.rpy:2940
translate russian minami_sasha_threesome_16c0a18f:
    "Минами смотрит на меня снизу вверх, широко раскрыв глаза от изумления!"

# ch/harems/home/events/home_harem_minami.rpy:2941
translate russian minami_sasha_threesome_fa5d9e62:
    "На мгновение удовольствие сменяется чувством вины."

# ch/harems/home/events/home_harem_minami.rpy:2942
translate russian minami_sasha_threesome_749adc4b:
    "Вообще-то у нас должен быть секс втроём."

# ch/harems/home/events/home_harem_minami.rpy:2943
translate russian minami_sasha_threesome_88d757a0:
    "А я просто развлекаюсь с Сашей."

# ch/harems/home/events/home_harem_minami.rpy:2944
translate russian minami_sasha_threesome_608d8dad:
    "Конечно, нам двоим хорошо, но как же Минами?"

# ch/harems/home/events/home_harem_minami.rpy:2946
translate russian minami_sasha_threesome_c2bbc2e2:
    mike.say "Минами, я..."

# ch/harems/home/events/home_harem_minami.rpy:2947
translate russian minami_sasha_threesome_f3137a95_2:
    minami.say "Ох..."

# ch/harems/home/events/home_harem_minami.rpy:2948
translate russian minami_sasha_threesome_9e680d55_1:
    minami.say "Ох, братик..."

# ch/harems/home/events/home_harem_minami.rpy:2949
translate russian minami_sasha_threesome_cdbe5377_1:
    minami.say "Ты такой... такой БОЛЬШОЙ!"

# ch/harems/home/events/home_harem_minami.rpy:2950
translate russian minami_sasha_threesome_0dd79e6e:
    "Я моргаю и качаю головой, не вполне веря своим ушам."

# ch/harems/home/events/home_harem_minami.rpy:2951
translate russian minami_sasha_threesome_9fae5d74:
    "Но взгляд Минами совершенно искренний."

# ch/harems/home/events/home_harem_minami.rpy:2952
translate russian minami_sasha_threesome_785f4088:
    "Она смотрит, как я трахаю Сашу, и ей это тоже нравится!"

# ch/harems/home/events/home_harem_minami.rpy:2953
translate russian minami_sasha_threesome_ad7c18b8:
    "Наверное, Минами прочла удивление на моём лице."

# ch/harems/home/events/home_harem_minami.rpy:2954
translate russian minami_sasha_threesome_6738f2b8:
    "Потому что мгновение спустя, кажется, решает помочь всем, чем может."

# ch/harems/home/events/home_harem_minami.rpy:2955
translate russian minami_sasha_threesome_3a4dca3a:
    "Без всяких просьб она начинает тереться головой о грудь Саши."

# ch/harems/home/events/home_harem_minami.rpy:2956
translate russian minami_sasha_threesome_a73b7a3f:
    "Это нетрудно: грудь другой девушки находится прямо над её головой!"

# ch/harems/home/events/home_harem_minami.rpy:2957
translate russian minami_sasha_threesome_87610ff5:
    "Почти устроившись головой между грудей Саши, Минами открывает рот и облизывает губы."

# ch/harems/home/events/home_harem_minami.rpy:2958
translate russian minami_sasha_threesome_e9e1f78f:
    "А затем лижет один из её сосков, исследуя его языком."

# ch/harems/home/events/home_harem_minami.rpy:2959
translate russian minami_sasha_threesome_8e265e5c:
    "Эффект мгновенный и настолько сильный, что я тоже его ощущаю."

# ch/harems/home/events/home_harem_minami.rpy:2960
translate russian minami_sasha_threesome_1c49d931:
    "Мышцы Саши сжимают мой член в ответ на ласки Минами."

# ch/harems/home/events/home_harem_minami.rpy:2961
translate russian minami_sasha_threesome_6c8596b5:
    "Я невольно ахаю и тяжело дышу от охвативших меня ощущений."

# ch/harems/home/events/home_harem_minami.rpy:2962
translate russian minami_sasha_threesome_5c520b7a:
    "И от этого мои движения становятся ещё интенсивнее."

# ch/harems/home/events/home_harem_minami.rpy:2963
translate russian minami_sasha_threesome_61fec5fc:
    "Я и сам не замечаю, как начинаю вколачиваться в Сашу, будто от этого зависит моя жизнь."

# ch/harems/home/events/home_harem_minami.rpy:2964
translate russian minami_sasha_threesome_d59a3546:
    sasha.say "Ах..."

# ch/harems/home/events/home_harem_minami.rpy:2965
translate russian minami_sasha_threesome_e63f3d04:
    sasha.say "Я..."

# ch/harems/home/events/home_harem_minami.rpy:2966
translate russian minami_sasha_threesome_d24b15d8:
    sasha.say "Я сейчас кончу!"

# ch/harems/home/events/home_harem_minami.rpy:2967
translate russian minami_sasha_threesome_02136bb8:
    "Если бы я ещё мог говорить, то сказал бы: «Я тоже»."

# ch/harems/home/events/home_harem_minami.rpy:2968
translate russian minami_sasha_threesome_1cf8bf90:
    "Но не могу, так что предупредить Сашу о том, что сейчас произойдёт, не выйдет..."

# ch/harems/home/events/home_harem_minami.rpy:2971
translate russian minami_sasha_threesome_1e8ab5f4:
    "Нечего и надеяться вытащить, прежде чем я потеряю контроль."

# ch/harems/home/events/home_harem_minami.rpy:2973
translate russian minami_sasha_threesome_d1a21919:
    "Поэтому я просто держусь за Сашу, чувствуя, как кончаю."

# ch/harems/home/events/home_harem_minami.rpy:2977
translate russian minami_sasha_threesome_4fb51e4d:
    "Её оргазм, кажется, наступает почти в тот же миг."

# ch/harems/home/events/home_harem_minami.rpy:2979
translate russian minami_sasha_threesome_04b90a06:
    "И на секунду мы словно замираем во времени."

# ch/harems/home/events/home_harem_minami.rpy:2980
translate russian minami_sasha_threesome_245ba28f:
    "Но затем я чувствую, как она обмякает в моих руках."

# ch/harems/home/events/home_harem_minami.rpy:2981
translate russian minami_sasha_threesome_1a6301c3:
    "Саша падает на кровать, и я — вместе с ней."

# ch/harems/home/events/home_harem_minami.rpy:2982
translate russian minami_sasha_threesome_b1dccf99:
    "Так что мы оба приземляемся прямо на Минами!"

# ch/harems/home/events/home_harem_minami.rpy:2984
translate russian minami_sasha_threesome_09e05c84:
    "Каким-то образом я всё же нахожу последние силы, чтобы вытащить."

# ch/harems/home/events/home_harem_minami.rpy:2986
translate russian minami_sasha_threesome_02c07069:
    "Похоже, это ощущение становится для Саши последней каплей."

# ch/harems/home/events/home_harem_minami.rpy:2988
translate russian minami_sasha_threesome_da7482ed:
    "Она кончает, пока я изливаюсь на её влажную скользкую попку."

# ch/harems/home/events/home_harem_minami.rpy:2990
translate russian minami_sasha_threesome_04b90a06_1:
    "И на секунду мы словно замираем во времени."

# ch/harems/home/events/home_harem_minami.rpy:2991
translate russian minami_sasha_threesome_245ba28f_1:
    "Но затем я чувствую, как она обмякает в моих руках."

# ch/harems/home/events/home_harem_minami.rpy:2992
translate russian minami_sasha_threesome_1a6301c3_1:
    "Саша падает на кровать, и я — вместе с ней."

# ch/harems/home/events/home_harem_minami.rpy:2993
translate russian minami_sasha_threesome_b1dccf99_1:
    "Так что мы оба приземляемся прямо на Минами!"

# ch/harems/home/events/home_harem_minami.rpy:2999
translate russian minami_sasha_sandwich_cb00c330:
    "Мне казалось, я замешкался совсем ненадолго — лишь чтобы перевести дух."

# ch/harems/home/events/home_harem_minami.rpy:3000
translate russian minami_sasha_sandwich_2d8f7b6f:
    "Но Саша, похоже, не собирается ждать, что я придумаю."

# ch/harems/home/events/home_harem_minami.rpy:3001
translate russian minami_sasha_sandwich_673627d8:
    "Вместо этого она берёт всё в свои руки и укладывает Минами на кровать."

# ch/harems/home/events/home_harem_minami.rpy:3002
translate russian minami_sasha_sandwich_b3386d66:
    "Минами на мгновение смотрит на меня, будто ожидая вмешательства."

# ch/harems/home/events/home_harem_minami.rpy:3003
translate russian minami_sasha_sandwich_47252357:
    "Но в ответ я лишь пожимаю плечами и улыбаюсь."

# ch/harems/home/events/home_harem_minami.rpy:3004
translate russian minami_sasha_sandwich_db7f2f8f:
    "Если Саша хочет взять инициативу, я с радостью ей уступлю!"

# ch/harems/home/events/home_harem_minami.rpy:3005
translate russian minami_sasha_sandwich_5a00cf0b:
    "Саша, похоже, тоже это понимает и бросает на меня косой взгляд."

# ch/harems/home/events/home_harem_minami.rpy:3006
translate russian minami_sasha_sandwich_08759995:
    "На её лице явственно читаются веселье и озорной восторг."

# ch/harems/home/events/home_harem_minami.rpy:3007
translate russian minami_sasha_sandwich_a3d48d85:
    "От этого мне ещё интереснее, к чему всё идёт!"

# ch/harems/home/events/home_harem_minami.rpy:3009
translate russian minami_sasha_sandwich_e7f982da:
    "Вскоре Минами уже лежит на спине, а Саша — поверх неё."

# ch/harems/home/events/home_harem_minami.rpy:3010
translate russian minami_sasha_sandwich_d02d4b0d:
    "Контраст между неопытностью первой и уверенностью второй очевиден."

# ch/harems/home/events/home_harem_minami.rpy:3011
translate russian minami_sasha_sandwich_7313b4a3:
    "И пока я наблюдаю за ними, мой член твердеет до боли!"

# ch/harems/home/events/home_harem_minami.rpy:3012
translate russian minami_sasha_sandwich_011131ce:
    minami.say "О-о-ох..."

# ch/harems/home/events/home_harem_minami.rpy:3013
translate russian minami_sasha_sandwich_7eb91645:
    minami.say "Саша..."

# ch/harems/home/events/home_harem_minami.rpy:3014
translate russian minami_sasha_sandwich_4614349b:
    minami.say "Что ты собираешься со мной делать?"

# ch/harems/home/events/home_harem_minami.rpy:3015
translate russian minami_sasha_sandwich_bfd1e52c:
    "Саша прерывает вопросы Минами своими губами."

# ch/harems/home/events/home_harem_minami.rpy:3016
translate russian minami_sasha_sandwich_e6d13d03:
    "Она страстно и безудержно целует девушку."

# ch/harems/home/events/home_harem_minami.rpy:3017
translate russian minami_sasha_sandwich_d4110952:
    "Но при этом не забывает удерживать мой взгляд."

# ch/harems/home/events/home_harem_minami.rpy:3018
translate russian minami_sasha_sandwich_1343ab72:
    "И я понимаю, что это открытое приглашение присоединиться!"

# ch/harems/home/events/home_harem_minami.rpy:3019
translate russian minami_sasha_sandwich_9c9bef73:
    "Вопрос лишь в том, с какой стороны это сделать."

# ch/harems/home/events/home_harem_minami.rpy:3020
translate russian minami_sasha_sandwich_c02eb27e:
    "Минами беспомощна под напором Саши."

# ch/harems/home/events/home_harem_minami.rpy:3021
translate russian minami_sasha_sandwich_264c3b4a:
    "Но и сама Саша полностью открыта для любых моих затей."

# ch/harems/home/events/home_harem_minami.rpy:3022
translate russian minami_sasha_sandwich_a05f153b:
    "Мне остаётся лишь решить, куда направиться и что сделать..."

# ch/harems/home/events/home_harem_minami.rpy:3035
translate russian minami_sasha_sandwich_b3ef1fd1:
    "Саша так открыто подставляется, что наверняка хочет, чтобы я этим воспользовался."

# ch/harems/home/events/home_harem_minami.rpy:3036
translate russian minami_sasha_sandwich_49519e87:
    "Она практически машет попкой в воздухе прямо передо мной!"

# ch/harems/home/events/home_harem_minami.rpy:3037
translate russian minami_sasha_sandwich_a5099a93:
    "Мне хватает пары секунд, чтобы устроиться как надо."

# ch/harems/home/events/home_harem_minami.rpy:3038
translate russian minami_sasha_sandwich_6b5fec1a:
    "Затем я хватаю Сашу за бёдра и одновременно наклоняюсь вперёд."

# ch/harems/home/events/home_harem_minami.rpy:3039
translate russian minami_sasha_sandwich_9a54ce59:
    "Она успевает лишь удивлённо вскрикнуть."

# ch/harems/home/events/home_harem_minami.rpy:3041
translate russian minami_sasha_sandwich_825553c3:
    "А мой язык уже скользит между её ягодиц."

# ch/harems/home/events/home_harem_minami.rpy:3042
translate russian minami_sasha_sandwich_78040787:
    "Её анус тугой, аккуратный и так и просит, чтобы его облизали."

# ch/harems/home/events/home_harem_minami.rpy:3043
translate russian minami_sasha_sandwich_2c0fe622:
    "Я исследую его кончиком языка, затем проникаю ещё глубже."

# ch/harems/home/events/home_harem_minami.rpy:3045
translate russian minami_sasha_sandwich_98679e5e:
    "Саша стонет, пока я пытаюсь забраться в неё как можно глубже."

# ch/harems/home/events/home_harem_minami.rpy:3046
translate russian minami_sasha_sandwich_62905e7a:
    "Звук приглушён: она продолжает целовать Минами."

# ch/harems/home/events/home_harem_minami.rpy:3047
translate russian minami_sasha_sandwich_dc394ddb:
    "И теперь меня уже ничто не остановит!"

# ch/harems/home/events/home_harem_minami.rpy:3048
translate russian minami_sasha_sandwich_5315a603:
