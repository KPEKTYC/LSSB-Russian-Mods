# Native Homeminami identifiers, current source catalog. Translation only.

# ch/harems/home/events/home_harem_minami.rpy:325
translate russian minami_request_5a1fa470:
    "Недавно я признался Минами, что [lssb_homeminami.bree_name()], Саша и я встречаемся втроём."

# ch/harems/home/events/home_harem_minami.rpy:326
translate russian minami_request_947c1662:
    "Но уже чувствую по её поведению, что она к чему-то готовится."

# ch/harems/home/events/home_harem_minami.rpy:327
translate russian minami_request_e018864a:
    "Во-первых, дома Минами всеми силами избегает меня."

# ch/harems/home/events/home_harem_minami.rpy:328
translate russian minami_request_e745aad3:
    "А если всё-таки встречает, молча торопится уйти без всяких объяснений."

# ch/harems/home/events/home_harem_minami.rpy:329
translate russian minami_request_b528238b:
    "Поверьте, это на неё не похоже: обычно младшая сестра постоянно ко мне пристаёт."

# ch/harems/home/events/home_harem_minami.rpy:330
translate russian minami_request_38f4854d:
    "И рта закрыть больше чем на пару секунд не может!"

# ch/harems/home/events/home_harem_minami.rpy:331
translate russian minami_request_3ee7432c:
    "Обычно я решил бы, что её что-то тревожит или она дуется."

# ch/harems/home/events/home_harem_minami.rpy:332
translate russian minami_request_6c8dfd29:
    "Но ситуация и без новости о наших отношениях втроём довольно сложная."

# ch/harems/home/events/home_harem_minami.rpy:333
translate russian minami_request_78d1aa8d:
    "Ведь совсем недавно мы наконец решились и переспали."

# ch/harems/home/events/home_harem_minami.rpy:334
translate russian minami_request_0fd00473:
    "Так что ещё разбираемся, как теперь всё устроено, когда мы гораздо больше, чем приёмные брат и сестра."

# ch/harems/home/events/home_harem_minami.rpy:335
translate russian minami_request_6bb42a3d:
    "Не раз я собираюсь прямо спросить её об этом и открываю рот, увидев её."

# ch/harems/home/events/home_harem_minami.rpy:336
translate russian minami_request_909c2b8f:
    "Но либо сам замолкаю, либо она ускользает раньше, чем я успеваю попросить её выслушать меня."

# ch/harems/home/events/home_harem_minami.rpy:337
translate russian minami_request_e993db76:
    "В итоге решаю ждать, пока Минами сама заговорит."

# ch/harems/home/events/home_harem_minami.rpy:338
translate russian minami_request_736d3af2:
    "И всё же, когда она наконец это делает, я оказываюсь немного застигнут врасплох."

# ch/harems/home/events/home_harem_minami.rpy:340
translate russian minami_request_b53bbbee:
    minami.say "Эм... привет, братик."

# ch/harems/home/events/home_harem_minami.rpy:341
translate russian minami_request_adbc8689:
    mike.say "Привет, Минами..."

# ch/harems/home/events/home_harem_minami.rpy:342
translate russian minami_request_4733db22:
    mike.say "Как-то... всё... неловко!"

# ch/harems/home/events/home_harem_minami.rpy:344
translate russian minami_request_28448421:
    "Минами кивает и устало вздыхает."

# ch/harems/home/events/home_harem_minami.rpy:345
translate russian minami_request_52aab625:
    minami.say "Ага, ещё бы."

# ch/harems/home/events/home_harem_minami.rpy:346
translate russian minami_request_0be7a9da:
    minami.say "Я хотела поговорить, но..."

# ch/harems/home/events/home_harem_minami.rpy:347
translate russian minami_request_4039147f:
    mike.say "Всё хорошо, Минами, я понимаю."

# ch/harems/home/events/home_harem_minami.rpy:348
translate russian minami_request_db25f15c:
    mike.say "Наверное, стоило сказать, что [lssb_homeminami.bree_name()], Саша и я вместе, до того как мы..."

# ch/harems/home/events/home_harem_minami.rpy:349
translate russian minami_request_06bca3fd:
    mike.say "Ну, до того как мы так сблизились, понимаешь?"

# ch/harems/home/events/home_harem_minami.rpy:351
translate russian minami_request_d1f586b2:
    "Минами сдержанно улыбается, глядя на меня снизу вверх и хлопая ресницами."

# ch/harems/home/events/home_harem_minami.rpy:352
translate russian minami_request_0dacb1d2:
    "В её глазах невинность сочетается с обещанием чего-то куда более развратного."

# ch/harems/home/events/home_harem_minami.rpy:353
translate russian minami_request_e99952dc:
    "Знаете, тот взгляд, перед которым я почти не могу устоять?"

# ch/harems/home/events/home_harem_minami.rpy:354
translate russian minami_request_7288f801:
    minami.say "Нет-нет, братик."

# ch/harems/home/events/home_harem_minami.rpy:355
translate russian minami_request_e2068b75:
    minami.say "Извиняться должен не ты."

# ch/harems/home/events/home_harem_minami.rpy:356
translate russian minami_request_211b4f5d:
    minami.say "Просто я заревновала, когда ты рассказал, вот и всё."

# ch/harems/home/events/home_harem_minami.rpy:357
translate russian minami_request_0a43b409:
    mike.say "Т... ты ревновала?"

# ch/harems/home/events/home_harem_minami.rpy:358
translate russian minami_request_d0e4362a:
    mike.say "А теперь... нет?"

# ch/harems/home/events/home_harem_minami.rpy:359
translate russian minami_request_0b291110:
    mike.say "Не ревнуешь, то есть?"

# ch/harems/home/events/home_harem_minami.rpy:361
translate russian minami_request_a928b0ff:
    "Минами подходит ближе, и с каждым шагом её улыбка становится всё менее невинной."

# ch/harems/home/events/home_harem_minami.rpy:362
translate russian minami_request_8b4325dd:
    minami.say "О нет, братик."

# ch/harems/home/events/home_harem_minami.rpy:363
translate russian minami_request_6ab14761:
    minami.say "Я подумала, и знаешь, это очень ЗАВОДИТ!"

# ch/harems/home/events/home_harem_minami.rpy:364
translate russian minami_request_8383fcec:
    mike.say "П... правда?!"

# ch/harems/home/events/home_harem_minami.rpy:366
translate russian minami_request_e739ab3e:
    "Минами звонко смеётся, словно её забавляет моя непонятливость."

# ch/harems/home/events/home_harem_minami.rpy:368
translate russian minami_request_84b61d4c:
    minami.say "Конечно!"

# ch/harems/home/events/home_harem_minami.rpy:369
translate russian minami_request_e41fcf53:
    minami.say "Подумай: я приезжаю в большой город, чтобы быть с красавцем старшим братом."

# ch/harems/home/events/home_harem_minami.rpy:370
translate russian minami_request_d2b7cb3c:
    minami.say "И не только получаю его, причём он оказывается именно таким, как я мечтала."

# ch/harems/home/events/home_harem_minami.rpy:371
translate russian minami_request_53209098:
    minami.say "У него ещё и целый гарем девушек, которые едят у него с ладони!"

# ch/harems/home/events/home_harem_minami.rpy:372
translate russian minami_request_06e0dc9e:
    minami.say "Они словно не могут перед тобой устоять, братик."

# ch/harems/home/events/home_harem_minami.rpy:374
translate russian minami_request_1d6787c7:
    minami.say "Как и я..."

# ch/harems/home/events/home_harem_minami.rpy:375
translate russian minami_request_9217a8be:
    "Я знаю, что к её словам следует отнестись с изрядной долей сомнения."

# ch/harems/home/events/home_harem_minami.rpy:376
translate russian minami_request_570275bd:
    "Уж чего-чего, а умения манипулировать ради своего Минами не занимать."

# ch/harems/home/events/home_harem_minami.rpy:377
translate russian minami_request_3b65e962:
    "Но всё-таки сколько парень может выдержать, когда его так расхваливают?"

# ch/harems/home/events/home_harem_minami.rpy:378
translate russian minami_request_00ba1470:
    "Бог знает, Минами ещё в детстве вертела мной как хотела."

# ch/harems/home/events/home_harem_minami.rpy:379
translate russian minami_request_ee9182be:
    "А теперь, когда она добилась секса со мной, получается раз в десять лучше!"

# ch/harems/home/events/home_harem_minami.rpy:380
translate russian minami_request_2f20ec8e:
    mike.say "Рад это слышать, Минами, правда!"

# ch/harems/home/events/home_harem_minami.rpy:381
translate russian minami_request_e52f2c19:
    mike.say "То есть... ты не против, что [lssb_homeminami.bree_name()] и Саша тоже со мной встречаются?"

# ch/harems/home/events/home_harem_minami.rpy:382
translate russian minami_request_ae088d13:
    "Минами склоняет голову набок, всё так же улыбаясь."

# ch/harems/home/events/home_harem_minami.rpy:383
translate russian minami_request_3a12070f:
    minami.say "Конечно, братик, конечно."

# ch/harems/home/events/home_harem_minami.rpy:385
translate russian minami_request_8b01de01:
    minami.say "Если и мне позволишь участвовать во всём веселье..."

# ch/harems/home/events/home_harem_minami.rpy:388
translate russian minami_request_c4efbaf2:
    mike.say "Нет, такого не будет, Минами."

# ch/harems/home/events/home_harem_minami.rpy:389
translate russian minami_request_2d589c8a:
    mike.say "Надо было сразу отказать, как только ты начала меня подмазывать!"

# ch/harems/home/events/home_harem_minami.rpy:391
translate russian minami_request_3a992c5a:
    "Улыбка Минами тут же сменяется хмурым взглядом, и она скрещивает руки на груди."

# ch/harems/home/events/home_harem_minami.rpy:392
translate russian minami_request_884f7b27:
    minami.say "Что?"

# ch/harems/home/events/home_harem_minami.rpy:394
translate russian minami_request_c173547e:
    minami.say "Почему, чёрт возьми?!"

# ch/harems/home/events/home_harem_minami.rpy:396
translate russian minami_request_bb8a2c60:
    mike.say "Минами, пожалуйста!"

# ch/harems/home/events/home_harem_minami.rpy:397
translate russian minami_request_bffeb7a0:
    mike.say "[lssb_homeminami.bree_name()], Саша и я... у нас всё непросто."

# ch/harems/home/events/home_harem_minami.rpy:398
translate russian minami_request_59699990:
    mike.say "Я не могу просто подойти и попросить принять кого-то ещё."

# ch/harems/home/events/home_harem_minami.rpy:400
translate russian minami_request_591b28e8:
    minami.say "Но попробовать можешь, братик! Вдруг они согласятся?"

# ch/harems/home/events/home_harem_minami.rpy:401
translate russian minami_request_c9c637e6:
    mike.say "Правда так думаешь, Минами?"

# ch/harems/home/events/home_harem_minami.rpy:402
translate russian minami_request_f212bb1b:
    mike.say "И как это должно выглядеть, а?"

# ch/harems/home/events/home_harem_minami.rpy:403
translate russian minami_request_8674df14:
    mike.say "«Эй, [lssb_homeminami.bree_name()], Саша, не хотите, чтобы моя младшая сестра присоединилась, когда мы трахаемся?»"

# ch/harems/home/events/home_harem_minami.rpy:404
translate russian minami_request_1d0bf188:
    mike.say "«А, кстати, я уже трахаю её на стороне»."

# ch/harems/home/events/home_harem_minami.rpy:405
translate russian minami_request_3085e583:
    mike.say "«Всё остаётся в семье!»"

# ch/harems/home/events/home_harem_minami.rpy:407
translate russian minami_request_88f9076d:
    "По лицу Минами понимаю, что, наверное, не стоило этого говорить."

# ch/harems/home/events/home_harem_minami.rpy:408
translate russian minami_request_1d3e2a27:
    "Пока темой разговора были [lssb_homeminami.bree_name()] и Саша, мои доводы звучали убедительно."

# ch/harems/home/events/home_harem_minami.rpy:409
translate russian minami_request_b5e4086d:
    "Но теперь я свёл всё к тому, что мы приёмные брат и сестра, и переложил вину на неё."

# ch/harems/home/events/home_harem_minami.rpy:410
translate russian minami_request_007f53d1:
    minami.say "И что, братик?"

# ch/harems/home/events/home_harem_minami.rpy:411
translate russian minami_request_b5dc4f59:
    minami.say "Тебе стыдно за то, что у нас было?"

# ch/harems/home/events/home_harem_minami.rpy:412
translate russian minami_request_12edfb09:
    mike.say "Нет, Минами, я не это имел в виду!"

# ch/harems/home/events/home_harem_minami.rpy:415
translate russian minami_request_85211c21:
    minami.say "А прозвучало именно так, придурок!"

# ch/harems/home/events/home_harem_minami.rpy:417
translate russian minami_request_93eec334:
    "С этими словами она поворачивается ко мне спиной и уносится прочь."

# ch/harems/home/events/home_harem_minami.rpy:418
translate russian minami_request_4766481b:
    "Оставляя меня одного тревожиться, что она скажет или сделает дальше."

# ch/harems/home/events/home_harem_minami.rpy:421
translate russian minami_request_e8bfa562:
    "Я думаю отказать, но понимаю, что это скорее инстинктивная реакция."

# ch/harems/home/events/home_harem_minami.rpy:423
translate russian minami_request_1079e93d:
    "Конечно, завести отношения с тремя девушками сразу было серьёзным шагом."

# ch/harems/home/events/home_harem_minami.rpy:425
translate russian minami_request_c074cc5a:
    "Конечно, завести отношения с двумя девушками сразу было серьёзным шагом."

# ch/harems/home/events/home_harem_minami.rpy:426
translate russian minami_request_040d11a1:
    "Но если первый барьер уже преодолён, зачем теперь строить из себя ханжу?"

# ch/harems/home/events/home_harem_minami.rpy:427
translate russian minami_request_f9a23b86:
    "Мне ничуть не стыдно ни за Минами, ни за то, что у нас было."

# ch/harems/home/events/home_harem_minami.rpy:429
translate russian minami_request_d3d05b2e:
    "Точно так же я не считаю, что [lssb_homeminami.bree_name()], Саша, Саманта и я делаем что-то плохое."

# ch/harems/home/events/home_harem_minami.rpy:431
translate russian minami_request_8da830d1:
    "Точно так же я не считаю, что [lssb_homeminami.bree_name()], Саша и я делаем что-то плохое."

# ch/harems/home/events/home_harem_minami.rpy:432
translate russian minami_request_b20895d4:
    "Так зачем скрывать одни отношения от других и рисковать всё разрушить?"

# ch/harems/home/events/home_harem_minami.rpy:434
translate russian minami_request_54c6c42d:
    "[lssb_homeminami.bree_name()], Сэм и Саша мне очень дороги, но Минами гораздо дольше была частью моей жизни."

# ch/harems/home/events/home_harem_minami.rpy:436
translate russian minami_request_5b075a91:
    "[lssb_homeminami.bree_name()] и Саша мне очень дороги, но Минами гораздо дольше была частью моей жизни."

# ch/harems/home/events/home_harem_minami.rpy:437
translate russian minami_request_0b05ccfc:
    "Я не хочу потерять её ради отношений с горячими соседками."

# ch/harems/home/events/home_harem_minami.rpy:438
translate russian minami_request_276bb235:
    mike.say "Конечно, Минами."

# ch/harems/home/events/home_harem_minami.rpy:439
translate russian minami_request_4b630c81:
    mike.say "Поговорю с ними при первой возможности."

# ch/harems/home/events/home_harem_minami.rpy:441
translate russian minami_request_31939857:
    minami.say "Правда поговоришь?!"

# ch/harems/home/events/home_harem_minami.rpy:443
translate russian minami_request_eefe805c:
    minami.say "Ох, братик, ты лучший!"

# ch/harems/home/events/home_harem_minami.rpy:444
translate russian minami_request_df7965f1:
    "Она обнимает меня за шею, из-за маленького роста почти подпрыгнув."

# ch/harems/home/events/home_harem_minami.rpy:445
translate russian minami_request_e5a76087:
    "Теперь она практически висит на мне, и приходится поддерживать её за попку."

# ch/harems/home/events/home_harem_minami.rpy:450
translate russian minami_request_63a434aa:
    "Ощущение невероятное, а когда она начинает целовать меня в губы..."

# ch/harems/home/events/home_harem_minami.rpy:451
translate russian minami_request_fb7ff559:
    "Ну, вы понимаете."

# ch/harems/home/events/home_harem_minami.rpy:452
translate russian minami_request_56291a12:
    "Я знаю, что рискую."

# ch/harems/home/events/home_harem_minami.rpy:453
translate russian minami_request_ced5bb4f:
    "Но искренне верю, что поступаю правильно."

# ch/harems/home/events/home_harem_minami.rpy:455
translate russian minami_request_bc97177f:
    "Надеюсь, [lssb_homeminami.bree_name()], Сэм и Саша тоже так решат."

# ch/harems/home/events/home_harem_minami.rpy:457
translate russian minami_request_9b8b14f5:
    "Надеюсь, [lssb_homeminami.bree_name()] и Саша тоже так решат."

# ch/harems/home/events/home_harem_minami.rpy:458
translate russian minami_request_97f1ede0:
    "Иначе я, возможно, только что согласился поджечь фитиль пороховой бочки."

# ch/harems/home/events/home_harem_minami.rpy:459
translate russian minami_request_2da3c11e:
    "Которая может разнести наш домашний покой в клочья!"

# ch/harems/home/events/home_harem_minami.rpy:463
translate russian bree_sasha_request_f5ec7f43:
    "Скажем так, мне нужно время, чтобы набраться смелости и обсудить желание Минами: [lssb_homeminami.bree_name()] и Саша должны об этом услышать."

# ch/harems/home/events/home_harem_minami.rpy:464
translate russian bree_sasha_request_6b9bc9c9:
    "Кто вообще может подойти к двум девушкам, с которыми встречается, и как ни в чём не бывало попросить принять его младшую сестру?"

# ch/harems/home/events/home_harem_minami.rpy:465
translate russian bree_sasha_request_8f5a5832:
    "Не знаю, кто может, зато точно знаю, кто не может: я вижу его в зеркале каждое утро!"

# ch/harems/home/events/home_harem_minami.rpy:466
translate russian bree_sasha_request_53083101:
    "Поэтому не спешу и выбираю момент, когда они, как мне кажется, будут наиболее восприимчивы к моим словам."

# ch/harems/home/events/home_harem_minami.rpy:467
translate russian bree_sasha_request_0e4b580e:
    "Но даже когда такой момент вроде бы наступает, я начинаю разговор весь на нервах."

# ch/harems/home/events/home_harem_minami.rpy:468
translate russian bree_sasha_request_e35ca177:
    mike.say "Эм, [lssb_homeminami.bree_name()]... Саша..."

# ch/harems/home/events/home_harem_minami.rpy:471
translate russian bree_sasha_request_dccc6b53:
    "Они разом поворачиваются ко мне с тёплыми, открытыми лицами."

# ch/harems/home/events/home_harem_minami.rpy:472
translate russian bree_sasha_request_2f65e1fd:
    bree.say "Да, [lssb_common.hero_name()]?"

# ch/harems/home/events/home_harem_minami.rpy:474
translate russian bree_sasha_request_c13e83a1:
    sasha.say "Да, [lssb_common.hero_name()]?"

# ch/harems/home/events/home_harem_minami.rpy:476
translate russian bree_sasha_request_60982d37:
    sasha.say "Что такое?"

# ch/harems/home/events/home_harem_minami.rpy:477
translate russian bree_sasha_request_b998ceb9:
    "Я отвечаю неуверенной улыбкой."

# ch/harems/home/events/home_harem_minami.rpy:478
translate russian bree_sasha_request_02606cf7:
    "И стараюсь не выглядеть так, словно иду на электрический стул."

# ch/harems/home/events/home_harem_minami.rpy:480
translate russian bree_sasha_request_3cf5c62a:
    mike.say "Вы ведь знаете, что мы все... хорошо ладим?"

# ch/harems/home/events/home_harem_minami.rpy:482
translate russian bree_sasha_request_c2ccaef2:
    "[lssb_homeminami.bree_name()] хмурится, явно не понимая, о чём я."

# ch/harems/home/events/home_harem_minami.rpy:483
translate russian bree_sasha_request_3c4af087:
    bree.say "Э-э, мы всегда хорошо ладили, [lssb_common.hero_name()]."

# ch/harems/home/events/home_harem_minami.rpy:485
translate russian bree_sasha_request_82fc66e0:
    bree.say "Поэтому здесь и живётся так здорово!"

# ch/harems/home/events/home_harem_minami.rpy:486
translate russian bree_sasha_request_3df947b3:
    "Саша смеётся и качает головой в ответ на такую наивность."

# ch/harems/home/events/home_harem_minami.rpy:489
translate russian bree_sasha_request_22c7c7c5:
    sasha.say "Не тупи, [lssb_homeminami.bree_name()]!"

# ch/harems/home/events/home_harem_minami.rpy:490
translate russian bree_sasha_request_95bf5e81:
    sasha.say "Он о том, что мы трахаемся втроём!"

# ch/harems/home/events/home_harem_minami.rpy:491
translate russian bree_sasha_request_b2f36485:
    sasha.say "Но почему-то ссыт сказать прямо, да, [lssb_common.hero_name()]?"

# ch/harems/home/events/home_harem_minami.rpy:493
translate russian bree_sasha_request_846232b2:
    "[lssb_homeminami.bree_name()] снова смотрит на меня с недоумением."

# ch/harems/home/events/home_harem_minami.rpy:494
translate russian bree_sasha_request_38853dba:
    bree.say "Это правда, [lssb_common.hero_name()]?"

# ch/harems/home/events/home_harem_minami.rpy:495
translate russian bree_sasha_request_2b209282:
    bree.say "Тебя что-то беспокоит?"

# ch/harems/home/events/home_harem_minami.rpy:496
translate russian bree_sasha_request_5d24506b:
    "Я пожимаю плечами и качаю головой, пытаясь, скорее всего безуспешно, преуменьшить проблему."

# ch/harems/home/events/home_harem_minami.rpy:497
translate russian bree_sasha_request_e50e1510:
    mike.say "Это... это насчёт Минами."

# ch/harems/home/events/home_harem_minami.rpy:498
translate russian bree_sasha_request_093a19c8:
    mike.say "Она живёт здесь с нами, пока мы..."

# ch/harems/home/events/home_harem_minami.rpy:499
translate russian bree_sasha_request_96a3ffab:
    mike.say "Пока у нас отношения, понимаете?"

# ch/harems/home/events/home_harem_minami.rpy:500
translate russian bree_sasha_request_49748f17:
    "Я ожидаю, что мои слова встретят в штыки."

# ch/harems/home/events/home_harem_minami.rpy:501
translate russian bree_sasha_request_5bdfd1df:
    "Но вместо этого [lssb_homeminami.bree_name()] и Саша улыбаются и посмеиваются."

# ch/harems/home/events/home_harem_minami.rpy:503
translate russian bree_sasha_request_c619f662:
    bree.say "О-о, понимаю тебя, [lssb_common.hero_name()]."

# ch/harems/home/events/home_harem_minami.rpy:504
translate russian bree_sasha_request_d71e8a15:
    bree.say "Я чувствовала себя ТАКОЙ проказницей, прячась у неё за спиной!"

# ch/harems/home/events/home_harem_minami.rpy:505
translate russian bree_sasha_request_e0647a2a:
    bree.say "Может, даже немного виноватой."

# ch/harems/home/events/home_harem_minami.rpy:507
translate russian bree_sasha_request_1c3d5494:
    sasha.say "Не волнуйся, [lssb_common.hero_name()]."

# ch/harems/home/events/home_harem_minami.rpy:508
translate russian bree_sasha_request_4496af7f:
    sasha.say "Мы умеем вести себя осторожно."

# ch/harems/home/events/home_harem_minami.rpy:509
translate russian bree_sasha_request_0e810408:
    sasha.say "Минами незачем о нас узнавать."

# ch/harems/home/events/home_harem_minami.rpy:510
translate russian bree_sasha_request_7cfa6578:
    "Говоря это, Саша смотрит мне в глаза, и я начинаю потеть."

# ch/harems/home/events/home_harem_minami.rpy:511
translate russian bree_sasha_request_cfa71b31:
    "Она не отводит взгляда, а её беззаботное выражение за считаные мгновения становится серьёзным."

# ch/harems/home/events/home_harem_minami.rpy:513
translate russian bree_sasha_request_dc683192:
    "Похоже, моё молчание и белое как простыня лицо заставили её усомниться."

# ch/harems/home/events/home_harem_minami.rpy:514
translate russian bree_sasha_request_d011ab67:
    sasha.say "Если только..."

# ch/harems/home/events/home_harem_minami.rpy:515
translate russian bree_sasha_request_a4682626:
    sasha.say "Если только она уже не знает."

# ch/harems/home/events/home_harem_minami.rpy:519
translate russian bree_sasha_request_d74cab74:
    bree.say "Ч... что это значит, Саша?"

# ch/harems/home/events/home_harem_minami.rpy:520
translate russian bree_sasha_request_3856729f:
    bree.say "Как Минами могла узнать?"

# ch/harems/home/events/home_harem_minami.rpy:522
translate russian bree_sasha_request_1b79ebfe:
    sasha.say "Ну, никто из НАС ничего бы не сказал."

# ch/harems/home/events/home_harem_minami.rpy:523
translate russian bree_sasha_request_69af4bf6:
    sasha.say "Значит, остаётся..."

# ch/harems/home/events/home_harem_minami.rpy:525
translate russian bree_sasha_request_d5fba71b:
    "Саша криво усмехается и указывает прямо на меня."

# ch/harems/home/events/home_harem_minami.rpy:526
translate russian bree_sasha_request_fd6ddb73:
    "[lssb_homeminami.bree_name()] секунду молча смотрит на меня в потрясении."

# ch/harems/home/events/home_harem_minami.rpy:527
translate russian bree_sasha_request_ead3c148:
    "Но быстро обретает дар речи."

# ch/harems/home/events/home_harem_minami.rpy:529
translate russian bree_sasha_request_2cbcb332:
    bree.say "[lssb_common.hero_name()], как ты мог?!"

# ch/harems/home/events/home_harem_minami.rpy:530
translate russian bree_sasha_request_386a1a4b:
    "Я вскидываю руки, защищаясь."

# ch/harems/home/events/home_harem_minami.rpy:531
translate russian bree_sasha_request_52f140c0:
    "И уже отступаю подальше, чтобы до меня не дотянулись."

# ch/harems/home/events/home_harem_minami.rpy:532
translate russian bree_sasha_request_0b2d3619:
    mike.say "Ради бога, я же не просто взял и рассказал!"

# ch/harems/home/events/home_harem_minami.rpy:533
translate russian bree_sasha_request_e5c321b7:
    mike.say "Она давно всё вынюхивала и подозревала, что мы что-то затеваем."

# ch/harems/home/events/home_harem_minami.rpy:534
translate russian bree_sasha_request_c5a12c34:
    mike.say "Я думал, если расскажу, она, может, просто примет это и отстанет!"

# ch/harems/home/events/home_harem_minami.rpy:535
translate russian bree_sasha_request_8dc200fd:
    sasha.say "Из чего я делаю вывод: ты рассказал, а она не отстала."

# ch/harems/home/events/home_harem_minami.rpy:536
translate russian bree_sasha_request_f5c7157e:
    sasha.say "Верно?"

# ch/harems/home/events/home_harem_minami.rpy:537
translate russian bree_sasha_request_10368130:
    bree.say "О-о, это ТАК нечестно!"

# ch/harems/home/events/home_harem_minami.rpy:538
translate russian bree_sasha_request_f09f91ef:
    bree.say "Почему всегда находится кто-то, кому хочется испортить мне удовольствие?"

# ch/harems/home/events/home_harem_minami.rpy:539
translate russian bree_sasha_request_7c70ac96:
    "Ладно, сейчас начнётся."

# ch/harems/home/events/home_harem_minami.rpy:540
translate russian bree_sasha_request_ab1e594a:
    "Надеюсь, от меня останется достаточно, чтобы потом опознали тело..."

# ch/harems/home/events/home_harem_minami.rpy:541
translate russian bree_sasha_request_e0977cab:
    mike.say "Эм, вот в чём дело."

# ch/harems/home/events/home_harem_minami.rpy:542
translate russian bree_sasha_request_149c7f6d:
    mike.say "Минами не хочет нас останавливать."

# ch/harems/home/events/home_harem_minami.rpy:543
translate russian bree_sasha_request_461521ab:
    mike.say "Она хочет превратить наше трио в... ну, квартет!"

# ch/harems/home/events/home_harem_minami.rpy:546
translate russian bree_sasha_request_ab88384c:
    "Услышав это, [lssb_homeminami.bree_name()] и Саша застывают."

# ch/harems/home/events/home_harem_minami.rpy:547
translate russian bree_sasha_request_202205ae:
    "Рты раскрыты от потрясения и удивления."

# ch/harems/home/events/home_harem_minami.rpy:548
translate russian bree_sasha_request_b76f31b2:
    "Я могу лишь гадать, что сейчас творится у них в головах."

# ch/harems/home/events/home_harem_minami.rpy:549
translate russian bree_sasha_request_ba718dd4:
    "Думаю что-нибудь сказать, чтобы нарушить тяжёлое молчание."

# ch/harems/home/events/home_harem_minami.rpy:550
translate russian bree_sasha_request_309747f6:
    "Но Саша опережает меня, стряхнув оцепенение и задав вопрос."

# ch/harems/home/events/home_harem_minami.rpy:552
translate russian bree_sasha_request_4b5f775f:
    sasha.say "Погоди, [lssb_common.hero_name()]."

# ch/harems/home/events/home_harem_minami.rpy:553
translate russian bree_sasha_request_6778cf13:
    sasha.say "Ты не просто хочешь принять в наши отношения кого-то ещё."

# ch/harems/home/events/home_harem_minami.rpy:556
translate russian bree_sasha_request_8ebab348:
    sasha.say "Ты хочешь, чтобы это была твоя СЕСТРА!"

# ch/harems/home/events/home_harem_minami.rpy:557
translate russian bree_sasha_request_db315614:
    "[lssb_homeminami.bree_name()], кажется, тоже приходит в себя от звука Сашиного голоса."

# ch/harems/home/events/home_harem_minami.rpy:559
translate russian bree_sasha_request_896d48d2:
    "Она встряхивает головой, словно разгоняя туман в мыслях."

# ch/harems/home/events/home_harem_minami.rpy:561
translate russian bree_sasha_request_ae7f1f3e:
    bree.say "Да, [lssb_common.hero_name()], почему ты хочешь трахаться с собственной сестрой?"

# ch/harems/home/events/home_harem_minami.rpy:562
translate russian bree_sasha_request_bbb69958:
    bree.say "Если только... если..."

# ch/harems/home/events/home_harem_minami.rpy:565
translate russian bree_sasha_request_02d451c8:
    sasha.say "Если только уже не трахаешься!"

# ch/harems/home/events/home_harem_minami.rpy:566
translate russian bree_sasha_request_51b7e51a:
    "Должно быть, мои щёки краснеют ровно в тот момент, когда Саша это произносит."

# ch/harems/home/events/home_harem_minami.rpy:567
translate russian bree_sasha_request_60bd0f53:
    "Или я выгляжу настолько подозрительно, что другой вывод просто невозможен."

# ch/harems/home/events/home_harem_minami.rpy:568
translate russian bree_sasha_request_be87b399:
    "Обе девушки изумлённо ахают, и я не понимаю, противно им или они впечатлены."

# ch/harems/home/events/home_harem_minami.rpy:569
translate russian bree_sasha_request_4cd667be:
    mike.say "Она моя приёмная сестра, помните?!"

# ch/harems/home/events/home_harem_minami.rpy:571
translate russian bree_sasha_request_c61faf43:
    mike.say "ПРИЁМНАЯ!"

# ch/harems/home/events/home_harem_minami.rpy:573
translate russian bree_sasha_request_23884ea3:
    "Саша скрещивает руки на груди и пристально меня изучает."

# ch/harems/home/events/home_harem_minami.rpy:575
translate russian bree_sasha_request_3108ef97:
    "Но затем [lssb_homeminami.bree_name()] встречает её уже гораздо более мягкий взгляд."

# ch/harems/home/events/home_harem_minami.rpy:576
translate russian bree_sasha_request_359311ed:
    sasha.say "Он прав, [lssb_homeminami.bree_name()]."

# ch/harems/home/events/home_harem_minami.rpy:577
translate russian bree_sasha_request_aeaf7d52:
    sasha.say "На самом деле они не кровные родственники."

# ch/harems/home/events/home_harem_minami.rpy:579
translate russian bree_sasha_request_afe68580:
    bree.say "Понимаю, Саша."

# ch/harems/home/events/home_harem_minami.rpy:580
translate russian bree_sasha_request_7648c60c:
    bree.say "И раз уж мы смогли принять отношения втроём..."

# ch/harems/home/events/home_harem_minami.rpy:581
translate russian bree_sasha_request_c572701e:
    bree.say "Может, это не настолько страннее?"

# ch/harems/home/events/home_harem_minami.rpy:582
translate russian bree_sasha_request_71c40360:
    mike.say "Эм... так... что скажете?"

# ch/harems/home/events/home_harem_minami.rpy:583
translate russian bree_sasha_request_07ac6af3:
    mike.say "Минами с нами или нет?"

# ch/harems/home/events/home_harem_minami.rpy:586
translate russian bree_sasha_request_2d98e075:
    "Вдруг чувствую, что обе снова смотрят на меня."

# ch/harems/home/events/home_harem_minami.rpy:587
translate russian bree_sasha_request_3e3b8717:
    "И невольно ощущаю себя зверем под дулом охотничьего ружья..."

# ch/harems/home/events/home_harem_minami.rpy:590
translate russian bree_sasha_request_cbfc7bf0:
    sasha.say "Не знаю, как ты, [lssb_homeminami.bree_name()]."

# ch/harems/home/events/home_harem_minami.rpy:591
translate russian bree_sasha_request_3629cb82:
    sasha.say "А я не хочу трахаться с какой-то сопливой мелкой нахалкой!"

# ch/harems/home/events/home_harem_minami.rpy:592
translate russian bree_sasha_request_2038f29d:
    "Я машинально открываю рот, чтобы защитить Минами."

# ch/harems/home/events/home_harem_minami.rpy:593
translate russian bree_sasha_request_058892aa:
    "Но Саша бросает на меня такой взгляд, что я замолкаю, не успев ляпнуть лишнего."

# ch/harems/home/events/home_harem_minami.rpy:595
translate russian bree_sasha_request_a3e4aa3a:
    bree.say "О-о, так нечестно!"

# ch/harems/home/events/home_harem_minami.rpy:596
translate russian bree_sasha_request_73c65c95:
    bree.say "По-моему, Минами милая девчонка."

# ch/harems/home/events/home_harem_minami.rpy:598
translate russian bree_sasha_request_67430636:
    bree.say "Точнее... я так думала, пока не узнала, что она за всеми нами шпионит!"

# ch/harems/home/events/home_harem_minami.rpy:600
translate russian bree_sasha_request_d216a4d5:
    "Саша кивает и поворачивается ко мне."

# ch/harems/home/events/home_harem_minami.rpy:601
translate russian bree_sasha_request_1946eefb:
    sasha.say "Вот что я думаю, [lssb_common.hero_name()]."

# ch/harems/home/events/home_harem_minami.rpy:602
translate russian bree_sasha_request_85f6d80d:
    sasha.say "Можешь и дальше делать с Минами всё, что делаешь."

# ch/harems/home/events/home_harem_minami.rpy:603
translate russian bree_sasha_request_58658290:
    sasha.say "И мы втроём тоже можем продолжать то, что делаем друг с другом."

# ch/harems/home/events/home_harem_minami.rpy:604
translate russian bree_sasha_request_c70fbc0a:
    sasha.say "Но пересекаться эти отношения будут только через тебя."

# ch/harems/home/events/home_harem_minami.rpy:605
translate russian bree_sasha_request_b6ddd8a6:
    "Я медленно киваю, понимая, что могу довольно удачно из этого выкрутиться."

# ch/harems/home/events/home_harem_minami.rpy:606
translate russian bree_sasha_request_26440be9:
    "Если [lssb_homeminami.bree_name()] согласится, Минами удастся успокоить, а я не найду способ всё испортить."

# ch/harems/home/events/home_harem_minami.rpy:608
translate russian bree_sasha_request_b80dd366:
    bree.say "Эм... думаю, меня это устраивает, Саша."

# ch/harems/home/events/home_harem_minami.rpy:610
translate russian bree_sasha_request_9886fc7d:
    bree.say "Я не хочу прекращать: нам СЛИШКОМ хорошо вместе!"

# ch/harems/home/events/home_harem_minami.rpy:611
translate russian bree_sasha_request_9f21d30d:
    "[lssb_homeminami.bree_name()] говорит это с озорной ухмылкой, и мне становится гораздо спокойнее."

# ch/harems/home/events/home_harem_minami.rpy:612
translate russian bree_sasha_request_7e47a1bd:
    "Кажется, всё будет хорошо."

# ch/harems/home/events/home_harem_minami.rpy:613
translate russian bree_sasha_request_f81b1e5e:
    mike.say "Огромное спасибо, вы лучшие!"

# ch/harems/home/events/home_harem_minami.rpy:615
translate russian bree_sasha_request_cdf94723:
    bree.say "Да, наверное, так и есть!"

# ch/harems/home/events/home_harem_minami.rpy:619
translate russian bree_sasha_request_4c99b02f:
    sasha.say "Лучше не забывай об этом, [lssb_common.hero_name()]."

# ch/harems/home/events/home_harem_minami.rpy:620
translate russian bree_sasha_request_b48f47cc:
    sasha.say "И удачи с отказом Минами!"

# ch/harems/home/events/home_harem_minami.rpy:621
translate russian bree_sasha_request_c65b5e90:
    "Я могу лишь кивать, улыбаться и нервно смеяться."

# ch/harems/home/events/home_harem_minami.rpy:622
translate russian bree_sasha_request_13e79003:
    "Но уже боюсь последствий того, что Минами не получит желаемого..."

# ch/harems/home/events/home_harem_minami.rpy:625
translate russian bree_sasha_request_cbfc7bf0_1:
    sasha.say "Не знаю, как ты, [lssb_homeminami.bree_name()]."

# ch/harems/home/events/home_harem_minami.rpy:627
translate russian bree_sasha_request_c0328c60:
    sasha.say "А мне нравится идея обкатать новенькую!"

# ch/harems/home/events/home_harem_minami.rpy:628
translate russian bree_sasha_request_555f2d3c:
    "Я машинально открываю рот, чтобы возразить против такого обращения с Минами."

# ch/harems/home/events/home_harem_minami.rpy:630
translate russian bree_sasha_request_c399cf8a:
    "Но [lssb_homeminami.bree_name()] и Саша смотрят так, что я тут же замираю."

# ch/harems/home/events/home_harem_minami.rpy:631
translate russian bree_sasha_request_46353e60:
    "Кажется, я ещё не видел их настолько возбуждёнными и коварными."

# ch/harems/home/events/home_harem_minami.rpy:632
translate russian bree_sasha_request_6ad2974b:
    "По крайней мере, вне спальни!"

# ch/harems/home/events/home_harem_minami.rpy:633
translate russian bree_sasha_request_72e66cb7:
    bree.say "Да, понимаю тебя, Саша."

# ch/harems/home/events/home_harem_minami.rpy:635
translate russian bree_sasha_request_f67053ab:
    bree.say "Она милая, а вся эта история с младшей сестрой — словно запретный плод!"

# ch/harems/home/events/home_harem_minami.rpy:637
translate russian bree_sasha_request_af6739dc:
    "[lssb_homeminami.bree_name()] смотрит на меня и слегка прикусывает губу."

# ch/harems/home/events/home_harem_minami.rpy:638
translate russian bree_sasha_request_fc47536c:
    bree.say "А то, что [lssb_common.hero_name()] уже с ней трахается..."

# ch/harems/home/events/home_harem_minami.rpy:639
translate russian bree_sasha_request_e609e1ed:
    sasha.say "Знаю, о чём ты: это ещё больше заводит!"

# ch/harems/home/events/home_harem_minami.rpy:640
translate russian bree_sasha_request_78952b5d:
    sasha.say "Будто он специально соблазнил её для нас..."

# ch/harems/home/events/home_harem_minami.rpy:641
translate russian bree_sasha_request_936569e1:
    "Я нервно сглатываю, изрядно тревожась из-за того, как они обсуждают Минами."

# ch/harems/home/events/home_harem_minami.rpy:642
translate russian bree_sasha_request_53e2815a:
    "Мне бы возмутиться: они говорят о ней словно о куске мяса."

# ch/harems/home/events/home_harem_minami.rpy:643
translate russian bree_sasha_request_cf59d7b7:
    "Наверное, я бы и возразил, если бы они не возбуждали меня так сильно!"

# ch/harems/home/events/home_harem_minami.rpy:644
translate russian bree_sasha_request_fea1eb84:
    mike.say "Т... то есть вы за, да?"

# ch/harems/home/events/home_harem_minami.rpy:645
translate russian bree_sasha_request_4a238a73:
    mike.say "Сказать Минами, что она с нами?"

# ch/harems/home/events/home_harem_minami.rpy:647
translate russian bree_sasha_request_872cf442:
    "Саша смотрит на меня так, что сразу напоминает голодную львицу."

# ch/harems/home/events/home_harem_minami.rpy:648
translate russian bree_sasha_request_8b2c03a2:
    "А [lssb_homeminami.bree_name()] кивает почти столь же хищно."

# ch/harems/home/events/home_harem_minami.rpy:649
translate russian bree_sasha_request_7772b25a:
    sasha.say "Похоже на то."

# ch/harems/home/events/home_harem_minami.rpy:650
translate russian bree_sasha_request_77cdf97a:
    bree.say "Да, скажи ей, что она с нами, [lssb_common.hero_name()]."

# ch/harems/home/events/home_harem_minami.rpy:651
translate russian bree_sasha_request_5e0d1121:
    sasha.say "Будем надеяться, она хорошо подумала, прежде чем загадывать желания."

# ch/harems/home/events/home_harem_minami.rpy:652
translate russian bree_sasha_request_59c6adab:
    sasha.say "Потому что уж их исполнение мы ей обеспечим!"

# ch/harems/home/events/home_harem_minami.rpy:653
translate russian bree_sasha_request_c65b5e90_1:
    "Я могу лишь кивать, улыбаться и нервно смеяться."

# ch/harems/home/events/home_harem_minami.rpy:654
translate russian bree_sasha_request_3d0ff755:
    "А воображение уже рисует все возможности, которые нас ждут..."

# ch/harems/home/events/home_harem_minami.rpy:664
translate russian bree_sasha_request_a056a93a:
    "Осталось спросить Саманту."

# ch/harems/home/events/home_harem_minami.rpy:673
translate russian bree_request_2c3095ff:
    "Я мог бы откладывать бесконечно, убеждая себя, что момент для такого вопроса ещё не настал."

# ch/harems/home/events/home_harem_minami.rpy:674
translate russian bree_request_cbd9255b:
    "Но тогда подходящий момент, скорее всего, вообще никогда не наступит."

# ch/harems/home/events/home_harem_minami.rpy:675
translate russian bree_request_c5bcca79:
    "Поэтому собираюсь с духом: как только [lssb_homeminami.bree_name()] останется со мной, спрошу её о желании Минами."

# ch/harems/home/events/home_harem_minami.rpy:676
translate russian bree_request_b9da2b1f:
    "Едва мы остаёмся наедине, я сразу поднимаю эту тему."

# ch/harems/home/events/home_harem_minami.rpy:677
translate russian bree_request_268920e5:
    "Думаю, если [lssb_homeminami.bree_name()] будет немного застигнута врасплох, то скорее задумается, прежде чем отказать."

# ch/harems/home/events/home_harem_minami.rpy:678
translate russian bree_request_e7452d8c:
    "К тому же рядом нет Саши, которая вмешалась бы и настояла на своём, так что [lssb_homeminami.bree_name()] решит сама."

# ch/harems/home/events/home_harem_minami.rpy:679
translate russian bree_request_11d4aa91:
    "Ну, была не была..."

# ch/harems/home/events/home_harem_minami.rpy:681
translate russian bree_request_3dc7f442:
    mike.say "[lssb_homeminami.bree_name()]..."

# ch/harems/home/events/home_harem_minami.rpy:682
translate russian bree_request_becbb3bf:
    bree.say "Эм, да, [lssb_common.hero_name()]?"

# ch/harems/home/events/home_harem_minami.rpy:683
translate russian bree_request_6cadf39b:
    mike.say "Я... хотел кое о чём тебя спросить."

# ch/harems/home/events/home_harem_minami.rpy:684
translate russian bree_request_a34e0fd7:
    "[lssb_homeminami.bree_name()] улыбается мне с недоумением в глазах."

# ch/harems/home/events/home_harem_minami.rpy:685
translate russian bree_request_7c6703b8:
    bree.say "Ладно, [lssb_common.hero_name()], звучит довольно странно."

# ch/harems/home/events/home_harem_minami.rpy:686
translate russian bree_request_7e857d99:
    bree.say "Но ничего, спрашивай!"

# ch/harems/home/events/home_harem_minami.rpy:687
translate russian bree_request_5b7ac942:
    mike.say "Ну... вообще-то Минами хочет, чтобы я тебя спросил."

# ch/harems/home/events/home_harem_minami.rpy:688
translate russian bree_request_7ae6b754:
    mike.say "И меня это тоже касается."

# ch/harems/home/events/home_harem_minami.rpy:689
translate russian bree_request_9c6ccf20:
    mike.say "И тебя... и Саши..."

# ch/harems/home/events/home_harem_minami.rpy:691
translate russian bree_request_5481ec84:
    "[lssb_homeminami.bree_name()] начинает понимать и тут же ярко краснеет."

# ch/harems/home/events/home_harem_minami.rpy:692
translate russian bree_request_2e6b952c:
    bree.say "О нет, нет, нет!"

# ch/harems/home/events/home_harem_minami.rpy:694
translate russian bree_request_3dab851b:
    bree.say "Она нас видела, да?!"

# ch/harems/home/events/home_harem_minami.rpy:696
translate russian bree_request_94155428:
    bree.say "Ох, [lssb_common.hero_name()], мне так жаль, что твоей бедной младшей сестре пришлось узнать об этом таким образом!"

# ch/harems/home/events/home_harem_minami.rpy:698
translate russian bree_request_f49a75bd:
    bree.say "Бедная Минами, наверное, совсем потрясена, малышка."

# ch/harems/home/events/home_harem_minami.rpy:699
translate russian bree_request_948b1bfc:
    "Я натянуто улыбаюсь, пока [lssb_homeminami.bree_name()] изливает неуместное сочувствие."

# ch/harems/home/events/home_harem_minami.rpy:700
translate russian bree_request_fe9b1b76:
    "Особенно потому, что, будь дело действительно в этом, выкрутиться было бы очень легко."

# ch/harems/home/events/home_harem_minami.rpy:701
translate russian bree_request_3a2c1b43:
    "Но теперь придётся поправить её и объяснить, зачем я на самом деле пришёл от имени Минами."

# ch/harems/home/events/home_harem_minami.rpy:702
translate russian bree_request_2abaedd8:
    mike.say "Да, ну..."

# ch/harems/home/events/home_harem_minami.rpy:703
translate russian bree_request_9cefb1f8:
    mike.say "Видишь ли, всё не совсем так, [lssb_homeminami.bree_name()]."

# ch/harems/home/events/home_harem_minami.rpy:707
translate russian bree_request_6570f659:
    mike.say "Она знает про тебя, меня и Сашу."

# ch/harems/home/events/home_harem_minami.rpy:708
translate russian bree_request_521d419b:
    mike.say "Но её это не то чтобы травмировало."

# ch/harems/home/events/home_harem_minami.rpy:710
translate russian bree_request_869347db:
    bree.say "Нет?"

# ch/harems/home/events/home_harem_minami.rpy:711
translate russian bree_request_609cdd93:
    "Ладно, была не была."

# ch/harems/home/events/home_harem_minami.rpy:712
translate russian bree_request_b50e7457:
    mike.say "Нет, [lssb_homeminami.bree_name()]."

# ch/harems/home/events/home_harem_minami.rpy:713
translate russian bree_request_39a718aa:
    mike.say "Наоборот: она хочет присоединиться."

# ch/harems/home/events/home_harem_minami.rpy:715
translate russian bree_request_90053718:
    "[lssb_homeminami.bree_name()] молча смотрит на меня, ещё не до конца осознав смысл моих слов."

# ch/harems/home/events/home_harem_minami.rpy:716
translate russian bree_request_ede8f100:
    "Проходит несколько долгих мгновений, прежде чем в её глазах появляется понимание."

# ch/harems/home/events/home_harem_minami.rpy:718
translate russian bree_request_4786023a:
    "А потом она краснеет ещё сильнее."

# ch/harems/home/events/home_harem_minami.rpy:719
translate russian bree_request_a033068f:
    bree.say "О... боже... мой!"

# ch/harems/home/events/home_harem_minami.rpy:721
translate russian bree_request_aa5cfd31:
    bree.say "Не может быть, [lssb_common.hero_name()]!"

# ch/harems/home/events/home_harem_minami.rpy:722
translate russian bree_request_b319fa8d:
    bree.say "Тогда ей пришлось бы заняться сексом... с тобой!"

# ch/harems/home/events/home_harem_minami.rpy:723
translate russian bree_request_90b7fd7d:
    mike.say "Эм, да, [lssb_homeminami.bree_name()]."

# ch/harems/home/events/home_harem_minami.rpy:724
translate russian bree_request_76dc18aa:
    mike.say "Думаю, она это понимает."

# ch/harems/home/events/home_harem_minami.rpy:727
translate russian bree_request_0a945cf8:
    bree.say "Но... но она твоя СЕСТРА!"

# ch/harems/home/events/home_harem_minami.rpy:728
translate russian bree_request_8fbbbb55:
    mike.say "Приёмная сестра, [lssb_homeminami.bree_name()]. По-моему, это ОЧЕНЬ важно помнить!"

# ch/harems/home/events/home_harem_minami.rpy:729
translate russian bree_request_0675e402:
    "[lssb_homeminami.bree_name()] качает головой, ошеломлённая не только самой новостью, но и моей сравнительно спокойной реакцией."

# ch/harems/home/events/home_harem_minami.rpy:730
translate russian bree_request_4052fffa:
    "Но я почти вижу, как у неё в голове крутятся шестерёнки."

# ch/harems/home/events/home_harem_minami.rpy:732
translate russian bree_request_95041118:
    "А потом её глаза расширяются от ужаса."

# ch/harems/home/events/home_harem_minami.rpy:733
translate russian bree_request_538a2767:
    bree.say "Ты говоришь так... будто вы двое уже..."

# ch/harems/home/events/home_harem_minami.rpy:734
translate russian bree_request_78399416:
    "Я продолжаю смотреть ей прямо в глаза."

# ch/harems/home/events/home_harem_minami.rpy:735
translate russian bree_request_7dfc2476:
    "Ничего не говорю, но и ничего не отрицаю."

# ch/harems/home/events/home_harem_minami.rpy:736
translate russian bree_request_a256c46a:
    "И она довольно быстро приходит к единственному логичному выводу."

# ch/harems/home/events/home_harem_minami.rpy:739
translate russian bree_request_bf8893e3:
    bree.say "Ты... ты и... Минами?!"

# ch/harems/home/events/home_harem_minami.rpy:740
translate russian bree_request_f66cb98b:
    mike.say "Да, [lssb_homeminami.bree_name()], примерно так."

# ch/harems/home/events/home_harem_minami.rpy:741
translate russian bree_request_90654d24:
    mike.say "Слушай, я пойму, если ты злишься."

# ch/harems/home/events/home_harem_minami.rpy:742
translate russian bree_request_78a9fe60:
    mike.say "Или тебе противно."

# ch/harems/home/events/home_harem_minami.rpy:743
translate russian bree_request_0882719c:
    mike.say "Или и то и другое."

# ch/harems/home/events/home_harem_minami.rpy:744
translate russian bree_request_0b92eaeb:
    "Я думал, шире уже некуда, но [lssb_homeminami.bree_name()] распахивает глаза ещё сильнее."

# ch/harems/home/events/home_harem_minami.rpy:747
translate russian bree_request_5757e430:
    bree.say "Просто не ожидала услышать от тебя такое, [lssb_common.hero_name()]."

# ch/harems/home/events/home_harem_minami.rpy:749
translate russian bree_request_4295f99d:
    "Она тяжело вздыхает, словно сильно во мне разочарована."

# ch/harems/home/events/home_harem_minami.rpy:750
translate russian bree_request_7f95aa08:
    bree.say "Мне было непросто принять то, что мы встречаемся втроём."

# ch/harems/home/events/home_harem_minami.rpy:751
translate russian bree_request_d776a6ee:
    bree.say "Я знаю, вы с Сашей КУДА смелее меня."

# ch/harems/home/events/home_harem_minami.rpy:752
translate russian bree_request_3dedb937:
    bree.say "Но я очень старалась принять всё это."

# ch/harems/home/events/home_harem_minami.rpy:753
translate russian bree_request_45c5d505:
    bree.say "И... по-моему, между нами что-то особенное."

# ch/harems/home/events/home_harem_minami.rpy:754
translate russian bree_request_36453b68:
    "Я могу лишь кивнуть: [lssb_homeminami.bree_name()], должно быть, очень тяжело."

# ch/harems/home/events/home_harem_minami.rpy:755
translate russian bree_request_17106ce7:
    "Конечно, она не ханжа и прекрасно умеет веселиться."

# ch/harems/home/events/home_harem_minami.rpy:756
translate russian bree_request_5899666a:
    "Но, может, это всё-таки для неё слишком."

# ch/harems/home/events/home_harem_minami.rpy:757
translate russian bree_request_93d1021f:
    mike.say "Ладно, [lssb_homeminami.bree_name()], я тебя понимаю."

# ch/harems/home/events/home_harem_minami.rpy:758
translate russian bree_request_8c8c5df9:
    mike.say "Спасибо, что выслушала."

# ch/harems/home/events/home_harem_minami.rpy:760
translate russian bree_request_9fca80f0:
    "[lssb_homeminami.bree_name()] улыбается мне гораздо шире, чем я ожидал."

# ch/harems/home/events/home_harem_minami.rpy:761
translate russian bree_request_4b4d2332:
    bree.say "Ничего, [lssb_common.hero_name()]."

# ch/harems/home/events/home_harem_minami.rpy:762
translate russian bree_request_2dacdc60:
    bree.say "Не пойми неправильно, Минами мне нравится, она милая девчонка."

# ch/harems/home/events/home_harem_minami.rpy:763
translate russian bree_request_1fc34329:
    bree.say "Просто ты и Саша, наверное, нравитесь мне больше!"

# ch/harems/home/events/home_harem_minami.rpy:768
translate russian bree_request_4fac2d3d:
    bree.say "О, нет..."

# ch/harems/home/events/home_harem_minami.rpy:769
translate russian bree_request_dbd4e0da:
    bree.say "Дело не в этом..."

# ch/harems/home/events/home_harem_minami.rpy:771
translate russian bree_request_bc170e2e:
    bree.say "Меня... вообще-то... эта мысль немного возбуждает!"

# ch/harems/home/events/home_harem_minami.rpy:772
translate russian bree_request_65d61b2e:
    "Не сразу до меня доходит, что говорит [lssb_homeminami.bree_name()]."

# ch/harems/home/events/home_harem_minami.rpy:773
translate russian bree_request_a47cdc8e:
    mike.say "Тебя... ПРАВДА?!"

# ch/harems/home/events/home_harem_minami.rpy:775
translate russian bree_request_3756bceb:
    "[lssb_homeminami.bree_name()] от этого ничуть не перестаёт краснеть."

# ch/harems/home/events/home_harem_minami.rpy:776
translate russian bree_request_8414ba08:
    "Теперь она краснее прежнего."

# ch/harems/home/events/home_harem_minami.rpy:777
translate russian bree_request_1ef92dc7:
    bree.say "Ну да, [lssb_common.hero_name()]."

# ch/harems/home/events/home_harem_minami.rpy:778
translate russian bree_request_5c5298a3:
    bree.say "Я поселяюсь с горячим парнем, и он меня соблазняет."

# ch/harems/home/events/home_harem_minami.rpy:779
translate russian bree_request_e53a4e16:
    bree.say "Потом втягивает в это милую готку, которая живёт с нами."

# ch/harems/home/events/home_harem_minami.rpy:780
translate russian bree_request_b4296ccc:
    bree.say "А теперь его бойкая младшая сестра тоже хочет присоединиться."

# ch/harems/home/events/home_harem_minami.rpy:781
translate russian bree_request_7503ecfb:
    bree.say "Словно сюжет какого-то безумного фильма."

# ch/harems/home/events/home_harem_minami.rpy:782
translate russian bree_request_db5fae9d:
    bree.say "В котором я играю главную роль!"

# ch/harems/home/events/home_harem_minami.rpy:783
translate russian bree_request_e8af75ba:
    "Мне остаётся лишь изумлённо покачать головой."

# ch/harems/home/events/home_harem_minami.rpy:784
translate russian bree_request_0895c62a:
    mike.say "То есть... ты согласна?"

# ch/harems/home/events/home_harem_minami.rpy:785
translate russian bree_request_e5fdb301:
    "[lssb_homeminami.bree_name()] кивает с таким энтузиазмом, что я едва могу поверить."

# ch/harems/home/events/home_harem_minami.rpy:798
translate russian bree_convince_sasha_156b3dc9:
    "Теперь [lssb_homeminami.bree_name()] поддерживает идею принять Минами и превратить наше трио в квартет."

# ch/harems/home/events/home_harem_minami.rpy:799
translate russian bree_convince_sasha_7f2fc050:
    "Значит, две трети голосов за нужное мне решение."

# ch/harems/home/events/home_harem_minami.rpy:800
translate russian bree_convince_sasha_1f686425:
    "И хотя Саша, возможно, отказала, вопрос ещё не закрыт: [lssb_homeminami.bree_name()] тоже должна с ней поговорить."

# ch/harems/home/events/home_harem_minami.rpy:801
translate russian bree_convince_sasha_507ca39b:
    "К счастью, [lssb_homeminami.bree_name()] легко соглашается обсудить это с Сашей."

# ch/harems/home/events/home_harem_minami.rpy:802
translate russian bree_convince_sasha_10f1618e:
    "Теперь, когда она поддержала идею, все прежние сомнения словно растаяли."

# ch/harems/home/events/home_harem_minami.rpy:806
translate russian bree_convince_sasha_411969ff:
    "И именно [lssb_homeminami.bree_name()] берёт инициативу в свои руки, едва замечает Сашу одну."

# ch/harems/home/events/home_harem_minami.rpy:808
translate russian bree_convince_sasha_81fd3f73:
    bree.say "Эй, Саша!"

# ch/harems/home/events/home_harem_minami.rpy:811
translate russian bree_convince_sasha_a7d311bd:
    "[lssb_homeminami.bree_name()] окликает её, и Саша поднимает глаза с открытым, заинтересованным выражением."

# ch/harems/home/events/home_harem_minami.rpy:813
translate russian bree_convince_sasha_a189de70:
    "Но, увидев меня позади, закатывает глаза и раздражённо стонет."

# ch/harems/home/events/home_harem_minami.rpy:814
translate russian bree_convince_sasha_526a82dc:
    sasha.say "У-у!"

# ch/harems/home/events/home_harem_minami.rpy:815
translate russian bree_convince_sasha_32580f2e:
    sasha.say "Только не говорите, что опять насчёт Минами!"

# ch/harems/home/events/home_harem_minami.rpy:817
translate russian bree_convince_sasha_657a9518:
    "[lssb_homeminami.bree_name()] останавливается в паре шагов от Саши, уперев руки в бока."

# ch/harems/home/events/home_harem_minami.rpy:818
translate russian bree_convince_sasha_de199454:
    "Похоже, её застало врасплох, что та сразу перешла к делу."

# ch/harems/home/events/home_harem_minami.rpy:819
translate russian bree_convince_sasha_32773911:
    bree.say "Ну... да, насчёт неё."

# ch/harems/home/events/home_harem_minami.rpy:821
translate russian bree_convince_sasha_ad014a54:
    bree.say "Наверное, нет смысла скрывать, если ты применяешь ко мне свои экстрасенсорные способности!"

# ch/harems/home/events/home_harem_minami.rpy:822
translate russian bree_convince_sasha_d448efe1:
    bree.say "[lssb_common.hero_name()] сказал, что ты категорически отказалась, да?"

# ch/harems/home/events/home_harem_minami.rpy:823
translate russian bree_convince_sasha_9f24bbff:
    "Саша скрещивает руки на груди, принимая защитную позу."

# ch/harems/home/events/home_harem_minami.rpy:824
translate russian bree_convince_sasha_7dac3765:
    "Кажется, не может решить, на кого из нас направить злость."

# ch/harems/home/events/home_harem_minami.rpy:825
translate russian bree_convince_sasha_bcf69902:
    "На меня она явно сердится за то, что я не отступил после её отказа."

# ch/harems/home/events/home_harem_minami.rpy:826
translate russian bree_convince_sasha_4dc03b6d:
    "Но [lssb_homeminami.bree_name()] тоже её сильно раздражает, наверное, потому что не встала на её сторону сразу."

# ch/harems/home/events/home_harem_minami.rpy:827
translate russian bree_convince_sasha_d1038528:
    sasha.say "И по твоему тону я так понимаю, ты не отказалась."

# ch/harems/home/events/home_harem_minami.rpy:828
translate russian bree_convince_sasha_f5c7157e:
    sasha.say "Верно?"

# ch/harems/home/events/home_harem_minami.rpy:829
translate russian bree_convince_sasha_e936b319:
    "[lssb_homeminami.bree_name()] кивает, не позволяя Саше заставить её стыдиться своего решения."

# ch/harems/home/events/home_harem_minami.rpy:830
translate russian bree_convince_sasha_ed387012:
    bree.say "Дело не в том, что сказала я, Саша."

# ch/harems/home/events/home_harem_minami.rpy:831
translate russian bree_convince_sasha_a17cd587:
    bree.say "И не совсем в том, что сказала ты."

# ch/harems/home/events/home_harem_minami.rpy:832
translate russian bree_convince_sasha_6d312a97:
    "Саша хмурится: [lssb_homeminami.bree_name()] явно озадачила её таким загадочным ответом."

# ch/harems/home/events/home_harem_minami.rpy:833
translate russian bree_convince_sasha_9ebb784e:
    "Признаюсь, это совсем не похоже на её обычную беззаботную болтовню."

# ch/harems/home/events/home_harem_minami.rpy:835
translate russian bree_convince_sasha_d93a0874:
    sasha.say "Что... что это должно значить?"

# ch/harems/home/events/home_harem_minami.rpy:837
translate russian bree_convince_sasha_89cfae7d:
    bree.say "Когда я услышала, что ты отказалась принять Минами, я..."

# ch/harems/home/events/home_harem_minami.rpy:838
translate russian bree_convince_sasha_3919f302:
    bree.say "Я за тебя забеспокоилась, Саша."

# ch/harems/home/events/home_harem_minami.rpy:841
translate russian bree_convince_sasha_eb35c172:
    sasha.say "А?"

# ch/harems/home/events/home_harem_minami.rpy:842
translate russian bree_convince_sasha_7efd31cd:
    sasha.say "С чего это тебе обо мне беспокоиться?!"

# ch/harems/home/events/home_harem_minami.rpy:844
translate russian bree_convince_sasha_09cb4737:
    bree.say "Ну, на тебя ведь совсем не похоже?"

# ch/harems/home/events/home_harem_minami.rpy:845
translate russian bree_convince_sasha_43edcf04:
    bree.say "Ты всегда была такой яркой, даже немного опасной, Саша."

# ch/harems/home/events/home_harem_minami.rpy:846
translate russian bree_convince_sasha_246ddfbb:
    bree.say "Играешь на гитаре в рок-группе, всё время носишь чёрное и ТАКАЯ затейница в постели!"

# ch/harems/home/events/home_harem_minami.rpy:847
translate russian bree_convince_sasha_e3741bc6:
    bree.say "И... я бы не набралась смелости признать, что [lssb_common.hero_name()] И ты — мои партнёры."

# ch/harems/home/events/home_harem_minami.rpy:848
translate russian bree_convince_sasha_aea3dbcf:
    bree.say "Если бы ты не показала, что можно выходить за привычные рамки."

# ch/harems/home/events/home_harem_minami.rpy:849
translate russian bree_convince_sasha_35c400c5:
    "[lssb_homeminami.bree_name()] печально вздыхает."

# ch/harems/home/events/home_harem_minami.rpy:850
translate russian bree_convince_sasha_2a1d9191:
    "Словно разочарована в Саше, но не решается сказать об этом прямо."

# ch/harems/home/events/home_harem_minami.rpy:852
translate russian bree_convince_sasha_4798caa7:
    bree.say "Но, наверное, у всех есть свои пределы, правда?"

# ch/harems/home/events/home_harem_minami.rpy:853
translate russian bree_convince_sasha_c39cd368:
    bree.say "Просто я не думала, что ты достигнешь своего раньше, чем я своего."

# ch/harems/home/events/home_harem_minami.rpy:855
translate russian bree_convince_sasha_a6a20bb8:
    "[lssb_homeminami.bree_name()] стоит под молчаливым взглядом Саши, и это длится словно вечность."

# ch/harems/home/events/home_harem_minami.rpy:856
translate russian bree_convince_sasha_6f22c7cc:
    "По Сашиным глазам вижу: ответить ей нечего."

# ch/harems/home/events/home_harem_minami.rpy:857
translate russian bree_convince_sasha_191d9779:
    "Ей приходится переваривать всё, что на неё только что вывалили."

# ch/harems/home/events/home_harem_minami.rpy:858
translate russian bree_convince_sasha_aa7ec357:
    sasha.say "Д... дело не в этом, [lssb_homeminami.bree_name()]."

# ch/harems/home/events/home_harem_minami.rpy:859
translate russian bree_convince_sasha_b66b5f3c:
    sasha.say "Это вопрос принципа, понимаешь?"

# ch/harems/home/events/home_harem_minami.rpy:860
translate russian bree_convince_sasha_9ab3666f:
    bree.say "А... чего?"

# ch/harems/home/events/home_harem_minami.rpy:861
translate russian bree_convince_sasha_e98270ee:
    sasha.say "Принципа, ясно?"

# ch/harems/home/events/home_harem_minami.rpy:862
translate russian bree_convince_sasha_95694e94:
    sasha.say "У нас было что-то особенное, а [lssb_common.hero_name()] всё испортил!"

# ch/harems/home/events/home_harem_minami.rpy:863
translate russian bree_convince_sasha_c6ebe88c:
    "Саша прерывается, чтобы обвиняюще ткнуть пальцем в мою сторону."

# ch/harems/home/events/home_harem_minami.rpy:864
translate russian bree_convince_sasha_0b4233db:
    bree.say "Ох, Саша, ну ты и ханжа!"

# ch/harems/home/events/home_harem_minami.rpy:867
translate russian bree_convince_sasha_f04e1dca:
    sasha.say "ЧТО?"

# ch/harems/home/events/home_harem_minami.rpy:868
translate russian bree_convince_sasha_9dd842be:
    sasha.say "Ничего подобного! Как ты вообще можешь такое говорить?!"

# ch/harems/home/events/home_harem_minami.rpy:869
translate russian bree_convince_sasha_7a8fd682:
    bree.say "Серьёзно, тебе надо расслабиться."

# ch/harems/home/events/home_harem_minami.rpy:870
translate russian bree_convince_sasha_4e3a8ce4:
    bree.say "Ты смогла принять нас троих, почему не четверых?"

# ch/harems/home/events/home_harem_minami.rpy:872
translate russian bree_convince_sasha_d8046c7d:
    bree.say "Потому что, знаешь, Саша, мы ведь можем создать другое трио, без тебя..."

# ch/harems/home/events/home_harem_minami.rpy:873
translate russian bree_convince_sasha_932ed343:
    "[lssb_homeminami.bree_name()]... она сейчас действительно ей угрожает?"

# ch/harems/home/events/home_harem_minami.rpy:874
translate russian bree_convince_sasha_cef4b62b:
    "Намекает, что просто заменит Сашу на Минами, если та не согласится?"

# ch/harems/home/events/home_harem_minami.rpy:876
translate russian bree_convince_sasha_a13cab25:
    sasha.say "Это... это шантаж, [lssb_homeminami.bree_name()]!"

# ch/harems/home/events/home_harem_minami.rpy:877
translate russian bree_convince_sasha_64b34ff7:
    bree.say "О, правда?"

# ch/harems/home/events/home_harem_minami.rpy:878
translate russian bree_convince_sasha_a2e74db5:
    bree.say "Может, тебе так кажется, Саша."

# ch/harems/home/events/home_harem_minami.rpy:879
translate russian bree_convince_sasha_16b30bbc:
    bree.say "А я просто вошла во вкус этой полигамии."

# ch/harems/home/events/home_harem_minami.rpy:880
translate russian bree_convince_sasha_f9d904ba:
    bree.say "И не позволю ни тебе, ни кому другому отнять её у меня."

# ch/harems/home/events/home_harem_minami.rpy:882
translate russian bree_convince_sasha_012e0513:
    "[lssb_homeminami.bree_name()] высказалась предельно откровенно, и Саша выглядит потрясённой."

# ch/harems/home/events/home_harem_minami.rpy:883
translate russian bree_convince_sasha_43a9b3f1:
    "Как и тем, что ей недвусмысленно сказали: её могут заменить Минами."

# ch/harems/home/events/home_harem_minami.rpy:884
translate russian bree_convince_sasha_0aef12b3:
    sasha.say "Н... нет... нет... не надо!"

# ch/harems/home/events/home_harem_minami.rpy:886
translate russian bree_convince_sasha_3b770d02:
    sasha.say "Слушай... может, я поспешила, да?"

# ch/harems/home/events/home_harem_minami.rpy:888
translate russian bree_convince_sasha_abab5f8b:
    bree.say "Так что ты хочешь сказать, Саша?"

# ch/harems/home/events/home_harem_minami.rpy:889
translate russian bree_convince_sasha_bb5c6900:
    bree.say "Попробуешь?"

# ch/harems/home/events/home_harem_minami.rpy:891
translate russian bree_convince_sasha_6feadf9f:
    sasha.say "Ладно, [lssb_homeminami.bree_name()], ладно."

# ch/harems/home/events/home_harem_minami.rpy:892
translate russian bree_convince_sasha_05729493:
    "Едва Саша сдаётся и соглашается принять Минами, [lssb_homeminami.bree_name()] полностью меняется."

# ch/harems/home/events/home_harem_minami.rpy:893
translate russian bree_convince_sasha_cc68da38:
    "Снова становится той жизнерадостной, энергичной девушкой, которую я хорошо знаю: улыбки и позитив."

# ch/harems/home/events/home_harem_minami.rpy:895
translate russian bree_convince_sasha_3938bdbb:
    bree.say "Отлично, Саша!"

# ch/harems/home/events/home_harem_minami.rpy:896
translate russian bree_convince_sasha_9d096e8d:
    bree.say "Видишь, не так уж трудно, правда?"

# ch/harems/home/events/home_harem_minami.rpy:897
translate russian bree_convince_sasha_11bd3566:
    "Саша медленно кивает, всё ещё изрядно озадаченная случившимся."

# ch/harems/home/events/home_harem_minami.rpy:898
translate russian bree_convince_sasha_d2941dab:
    "Но прежде чем она успевает всё обдумать, я тоже начинаю её поздравлять."

# ch/harems/home/events/home_harem_minami.rpy:899
translate russian bree_convince_sasha_9bf282b2:
    "И вместе [lssb_homeminami.bree_name()] и я увлекаем её к тому, чего с самого начала хотели."

# ch/harems/home/events/home_harem_minami.rpy:908
translate russian bree_convince_sasha_318c5a17:
    "Мне ещё нужно спросить обо всём этом Сэм."

# ch/harems/home/events/home_harem_minami.rpy:916
translate russian sasha_request_6b888e57:
    "[lssb_homeminami.bree_name()], Саша, Саманта и Лекси — вот с кем мне нужно обсудить вступление Минами в наш союз пятерых. Я всё думаю, как лучше это сделать."

# ch/harems/home/events/home_harem_minami.rpy:917
translate russian sasha_request_bc1e57d9:
    "Тогда нас, очевидно, станет шестеро. Наверное: в точной терминологии я не силён."

# ch/harems/home/events/home_harem_minami.rpy:919
translate russian sasha_request_d15c8fdc:
    "[lssb_homeminami.bree_name()], Саша и Саманта — вот с кем мне нужно обсудить вступление Минами в наш союз четверых. Я всё думаю, как лучше это сделать."

# ch/harems/home/events/home_harem_minami.rpy:920
translate russian sasha_request_540b0593:
    "Тогда нас, очевидно, станет пятеро. Наверное: в точной терминологии я не силён."

# ch/harems/home/events/home_harem_minami.rpy:922
translate russian sasha_request_ae0d59c2:
    "[lssb_homeminami.bree_name()], Саша и Лекси — вот с кем мне нужно обсудить вступление Минами в наш союз четверых. Я всё думаю, как лучше это сделать."

# ch/harems/home/events/home_harem_minami.rpy:923
translate russian sasha_request_540b0593_1:
    "Тогда нас, очевидно, станет пятеро. Наверное: в точной терминологии я не силён."

# ch/harems/home/events/home_harem_minami.rpy:925
translate russian sasha_request_abd4d801:
    "[lssb_homeminami.bree_name()] и Саша — вот с кем мне нужно обсудить вступление Минами в наше трио. Я всё думаю, как лучше это сделать."

# ch/harems/home/events/home_harem_minami.rpy:926
translate russian sasha_request_d8481411:
    "Тогда нас, очевидно, станет четверо. Наверное: в точной терминологии я не силён."

# ch/harems/home/events/home_harem_minami.rpy:927
translate russian sasha_request_80f1ebfc:
    "Но в отличие от секса, это, кажется, лучше делать с глазу на глаз, а не со всеми сразу."

# ch/harems/home/events/home_harem_minami.rpy:928
translate russian sasha_request_94c65785:
    "Не назвал бы это «разделяй и властвуй»: чувствую, что скоро нападать будут как раз на меня!"

# ch/harems/home/events/home_harem_minami.rpy:929
translate russian sasha_request_a53d6c9a:
    "Всё же собираюсь с духом, чтобы сделать это при первой возможности."

# ch/harems/home/events/home_harem_minami.rpy:930
translate russian sasha_request_6dc52f84:
    "И едва остаюсь наедине с Сашей, решаюсь..."

# ch/harems/home/events/home_harem_minami.rpy:932
translate russian sasha_request_fb020eb5:
    mike.say "Эм, Саша..."

# ch/harems/home/events/home_harem_minami.rpy:933
translate russian sasha_request_0a146ac7:
    mike.say "Есть минутка?"

# ch/harems/home/events/home_harem_minami.rpy:934
translate russian sasha_request_da6058ed:
    sasha.say "А... да."

# ch/harems/home/events/home_harem_minami.rpy:936
translate russian sasha_request_f5a08a56:
    sasha.say "Конечно, [lssb_common.hero_name()], что такое?"

# ch/harems/home/events/home_harem_minami.rpy:937
translate russian sasha_request_3cacf2e1:
    "Ну, была не была..."

# ch/harems/home/events/home_harem_minami.rpy:938
translate russian sasha_request_8b105a93:
    mike.say "Я... просто хотел с тобой кое о чём поговорить."

# ch/harems/home/events/home_harem_minami.rpy:939
translate russian sasha_request_a314c39a:
    sasha.say "О-о, должно быть интересно!"

# ch/harems/home/events/home_harem_minami.rpy:940
translate russian sasha_request_201b0899:
    sasha.say "Ты никогда не хочешь «кое о чём поговорить»."

# ch/harems/home/events/home_harem_minami.rpy:942
translate russian sasha_request_9f4f6625:
    sasha.say "Если только дело не серьёзное!"

# ch/harems/home/events/home_harem_minami.rpy:943
translate russian sasha_request_1d3e27a4:
    "Конечно, сейчас она подшучивает надо мной."

# ch/harems/home/events/home_harem_minami.rpy:944
translate russian sasha_request_e7efd389:
    "Но при этом говорит правду."

# ch/harems/home/events/home_harem_minami.rpy:945
translate russian sasha_request_ca4f408c:
    "Я из тех парней, кто становится таким серьёзным лишь из-за серьёзных мыслей."

# ch/harems/home/events/home_harem_minami.rpy:946
translate russian sasha_request_d329157d:
    mike.say "Да, Саша, слишком хорошо ты меня знаешь!"

# ch/harems/home/events/home_harem_minami.rpy:947
translate russian sasha_request_bb6ff099:
    mike.say "Мне действительно нужно кое-что обсудить."

# ch/harems/home/events/home_harem_minami.rpy:948
translate russian sasha_request_b4218308:
    mike.say "Это насчёт Минами..."

# ch/harems/home/events/home_harem_minami.rpy:950
translate russian sasha_request_9dbaf574:
    "Саша поднимает бровь, явно заинтересованная продолжением."

# ch/harems/home/events/home_harem_minami.rpy:951
translate russian sasha_request_cf7a5598:
    "С самого переезда она дружелюбно относится к моей младшей сестре."

# ch/harems/home/events/home_harem_minami.rpy:952
translate russian sasha_request_5add3084:
    "Но не знаю, смирилась ли с её присутствием так же, как, похоже, [lssb_homeminami.bree_name()]."

# ch/harems/home/events/home_harem_minami.rpy:953
translate russian sasha_request_a84f106a:
    sasha.say "Да неужели!"

# ch/harems/home/events/home_harem_minami.rpy:954
translate russian sasha_request_2abaedd8:
    mike.say "Да, ну..."

# ch/harems/home/events/home_harem_minami.rpy:955
translate russian sasha_request_e1a205f7:
    mike.say "Скажем так, возможно, она кое-что о нас поняла."

# ch/harems/home/events/home_harem_minami.rpy:957
translate russian sasha_request_0de58747:
    sasha.say "Полагаю, ты имеешь в виду нашу компанию: ты, я, [lssb_homeminami.bree_name()], Сэм и Лекси?"

# ch/harems/home/events/home_harem_minami.rpy:959
translate russian sasha_request_79b4ac00:
    sasha.say "Полагаю, ты имеешь в виду нашу компанию: ты, я, [lssb_homeminami.bree_name()] и Сэм?"

# ch/harems/home/events/home_harem_minami.rpy:961
translate russian sasha_request_203b3b3c:
    sasha.say "Полагаю, ты имеешь в виду нашу компанию: ты, я, [lssb_homeminami.bree_name()] и Лекси?"

# ch/harems/home/events/home_harem_minami.rpy:963
translate russian sasha_request_3b1bbcef:
    sasha.say "Полагаю, ты имеешь в виду нашу компанию: ты, я и [lssb_homeminami.bree_name()]?"

# ch/harems/home/events/home_harem_minami.rpy:964
translate russian sasha_request_3e5628d8:
    "Я быстро киваю, всё ещё пытаясь поскорее выговориться."

# ch/harems/home/events/home_harem_minami.rpy:965
translate russian sasha_request_020011b9:
    mike.say "И, возможно, кое-кого об этом спросила."

# ch/harems/home/events/home_harem_minami.rpy:967
translate russian sasha_request_4026fbc5:
    sasha.say "У-у..."

# ch/harems/home/events/home_harem_minami.rpy:968
translate russian sasha_request_c98b0995:
    sasha.say "И этим кое-кем был ты?"

# ch/harems/home/events/home_harem_minami.rpy:970
translate russian sasha_request_6b66ef64:
    sasha.say "И этот кое-кто ничего не отрицал, верно?"

# ch/harems/home/events/home_harem_minami.rpy:971
translate russian sasha_request_bd08045a:
    mike.say "Нет, не отрицал."

# ch/harems/home/events/home_harem_minami.rpy:972
translate russian sasha_request_14382305:
    mike.say "Потому что, возможно, уже чувствовал себя виноватым, ведь..."

# ch/harems/home/events/home_harem_minami.rpy:973
translate russian sasha_request_ad587b6f:
    mike.say "Ведь он с ней переспал..."

# ch/harems/home/events/home_harem_minami.rpy:975
translate russian sasha_request_d1e66cba:
    "Саша потрясённо смотрит на меня, раскрыв рот и глаза."

# ch/harems/home/events/home_harem_minami.rpy:976
translate russian sasha_request_540bd040:
    "Ей даже не нужно качать головой, чтобы я понял, насколько она озадачена."

# ch/harems/home/events/home_harem_minami.rpy:977
translate russian sasha_request_d8691e7c:
    sasha.say "Давай уточним, [lssb_common.hero_name()]."

# ch/harems/home/events/home_harem_minami.rpy:978
translate russian sasha_request_bbad460b:
    sasha.say "Ты рассказал младшей сестре, с которой тоже спишь, что мы все трахаемся друг с другом?"

# ch/harems/home/events/home_harem_minami.rpy:979
translate russian sasha_request_57fcc72d:
    sasha.say "Зачем ты сейчас всё это мне рассказываешь?"

# ch/harems/home/events/home_harem_minami.rpy:981
translate russian sasha_request_10a86c4f:
    sasha.say "Надеешься, что я тебя убью?"

# ch/harems/home/events/home_harem_minami.rpy:982
translate russian sasha_request_d2a5ab42:
    sasha.say "Убью, чтобы тебе не пришлось разгребать всё это дерьмо?!"

# ch/harems/home/events/home_harem_minami.rpy:983
translate russian sasha_request_34ac80bc:
    "Я слабо улыбаюсь, пытаясь принять её слова за шутку."

# ch/harems/home/events/home_harem_minami.rpy:984
translate russian sasha_request_13c1c511:
    "По крайней мере, надеюсь, что это шутка и она не замышляет убийство!"

# ch/harems/home/events/home_harem_minami.rpy:985
translate russian sasha_request_913d1768:
    mike.say "Если это тебя позабавило, то от следующих слов ты будешь в восторге."

# ch/harems/home/events/home_harem_minami.rpy:986
translate russian sasha_request_779ce8b8:
    mike.say "Минами тоже хочет к нам присоединиться!"

# ch/harems/home/events/home_harem_minami.rpy:990
translate russian sasha_request_9b6fd6c3:
    sasha.say "О нет, ни за что!"

# ch/harems/home/events/home_harem_minami.rpy:992
translate russian sasha_request_45cf92fc:
    sasha.say "Я могу смириться с тем, что она знает о нашем союзе пятерых."

# ch/harems/home/events/home_harem_minami.rpy:994
translate russian sasha_request_836631ea:
    sasha.say "Я могу смириться с тем, что она знает о нашем союзе четверых."

# ch/harems/home/events/home_harem_minami.rpy:996
translate russian sasha_request_0cd8e65c:
    sasha.say "Я могу смириться с тем, что она знает о нашем трио."

# ch/harems/home/events/home_harem_minami.rpy:997
translate russian sasha_request_aa76fbb9:
    sasha.say "Могу даже осмыслить, что ты трахаешь её на стороне."

# ch/harems/home/events/home_harem_minami.rpy:998
translate russian sasha_request_dce8d8db:
    sasha.say "Но между нами нечто особенное, [lssb_common.hero_name()]."

# ch/harems/home/events/home_harem_minami.rpy:999
translate russian sasha_request_c660ab1c:
    sasha.say "Нельзя принимать кого-то просто по прихоти."

# ch/harems/home/events/home_harem_minami.rpy:1000
translate russian sasha_request_5c222ba0:
    "Я открываю рот, чтобы возразить, но так и не произношу ни слова."

# ch/harems/home/events/home_harem_minami.rpy:1001
translate russian sasha_request_08d6d4a8:
    "Уже одним этим признанием я потребовал от Саши очень многого."

# ch/harems/home/events/home_harem_minami.rpy:1003
translate russian sasha_request_db4dff57:
    "Она могла бросить меня за то, что я рассказал Минами о нашем союзе пятерых."

# ch/harems/home/events/home_harem_minami.rpy:1005
translate russian sasha_request_4e4e460e:
    "Она могла бросить меня за то, что я рассказал Минами о нашем союзе четверых."

# ch/harems/home/events/home_harem_minami.rpy:1007
translate russian sasha_request_0dacffe2:
    "Она могла бросить меня за то, что я рассказал Минами о нашем трио."

# ch/harems/home/events/home_harem_minami.rpy:1008
translate russian sasha_request_a2da88e8:
    "Или разорвать отношения, узнав, что я ещё и с сестрой сплю."

# ch/harems/home/events/home_harem_minami.rpy:1009
translate russian sasha_request_a9eb03b4:
    "И имела бы на это полное право."

# ch/harems/home/events/home_harem_minami.rpy:1010
translate russian sasha_request_06b8f790:
    "Какое право я имею после этого продолжать давить?"

# ch/harems/home/events/home_harem_minami.rpy:1011
translate russian sasha_request_61b2674f:
    "Поэтому вместо спора просто киваю."

# ch/harems/home/events/home_harem_minami.rpy:1012
translate russian sasha_request_25810455:
    mike.say "Ладно, Саша, ладно."

# ch/harems/home/events/home_harem_minami.rpy:1013
translate russian sasha_request_f47d07b6:
    mike.say "Я тебя услышал."

# ch/harems/home/events/home_harem_minami.rpy:1014
translate russian sasha_request_8c8c5df9:
    mike.say "Спасибо, что выслушала."

# ch/harems/home/events/home_harem_minami.rpy:1016
translate russian sasha_request_adc71d0a:
    "Саша улыбается слабо, но, как мне кажется, искренне."

# ch/harems/home/events/home_harem_minami.rpy:1018
translate russian sasha_request_2a617089:
    sasha.say "Слушай, я знаю, что мы безумный квинтет: я, ты, [lssb_homeminami.bree_name()], Сэм и Лекси."

# ch/harems/home/events/home_harem_minami.rpy:1020
translate russian sasha_request_59eedae3:
    sasha.say "Слушай, я знаю, что мы безумный квартет: я, ты, [lssb_homeminami.bree_name()] и Сэм."

# ch/harems/home/events/home_harem_minami.rpy:1022
translate russian sasha_request_81701e2a:
    sasha.say "Слушай, я знаю, что мы безумное трио: я, ты, [lssb_homeminami.bree_name()] и Лекси."

# ch/harems/home/events/home_harem_minami.rpy:1024
translate russian sasha_request_d86b024c:
    sasha.say "Слушай, я знаю, что мы безумное трио: я, ты и [lssb_homeminami.bree_name()]."

# ch/harems/home/events/home_harem_minami.rpy:1025
translate russian sasha_request_128a4264:
    sasha.say "Но между нами ведь что-то особенное, правда?"

# ch/harems/home/events/home_harem_minami.rpy:1026
translate russian sasha_request_36e8fa22:
    "Я улыбаюсь в ответ и киваю, поворачиваясь, чтобы уйти."

# ch/harems/home/events/home_harem_minami.rpy:1032
translate russian sasha_request_17097fd0:
    "Саша открывает рот."

# ch/harems/home/events/home_harem_minami.rpy:1033
translate russian sasha_request_96d3074f:
    "И я почти слышу отказ ещё до первого слова."

# ch/harems/home/events/home_harem_minami.rpy:1034
translate russian sasha_request_d61c2b7d:
    "Но потом она замирает, словно ей пришла в голову новая мысль."

# ch/harems/home/events/home_harem_minami.rpy:1035
translate russian sasha_request_dee0b4f9:
    "На её лице появляется странная улыбка, от которой мне становится не по себе."

# ch/harems/home/events/home_harem_minami.rpy:1036
translate russian sasha_request_0e39cbb5:
    sasha.say "Итак, [lssb_common.hero_name()]..."

# ch/harems/home/events/home_harem_minami.rpy:1038
translate russian sasha_request_5237d202:
    sasha.say "Ты соблазнил младшую сестрёнку, да?"

# ch/harems/home/events/home_harem_minami.rpy:1039
translate russian sasha_request_b43a5402:
    "От её взгляда я уже начинаю краснеть."

# ch/harems/home/events/home_harem_minami.rpy:1040
translate russian sasha_request_1aa45c4f:
    "Она ведь права: я переспал со своей приёмной младшей сестрой."

# ch/harems/home/events/home_harem_minami.rpy:1041
translate russian sasha_request_49995f8b:
    "Но как-то умудряется представить всё настолько пошло!"

# ch/harems/home/events/home_harem_minami.rpy:1042
translate russian sasha_request_b562c543:
    mike.say "Я... наверное, можно и так сказать, Саша."

# ch/harems/home/events/home_harem_minami.rpy:1043
translate russian sasha_request_55f5959e:
    mike.say "Не уверен, кто кого соблазнил."

# ch/harems/home/events/home_harem_minami.rpy:1044
translate russian sasha_request_8ad3b4b7:
    mike.say "Это было взаимно, понимаешь?"

# ch/harems/home/events/home_harem_minami.rpy:1045
translate russian sasha_request_f6a06749:
    "Саша качает головой, всё так же странно улыбаясь."

# ch/harems/home/events/home_harem_minami.rpy:1046
translate russian sasha_request_e874baf1:
    sasha.say "Нет, [lssb_common.hero_name()], не понимаю."

# ch/harems/home/events/home_harem_minami.rpy:1047
translate russian sasha_request_66b50a62:
    sasha.say "Видишь ли, я никогда не трахалась с братом, приёмным или каким-то ещё."

# ch/harems/home/events/home_harem_minami.rpy:1049
translate russian sasha_request_74c8a8f4:
    sasha.say "Но если подумать, это довольно горячо..."

# ch/harems/home/events/home_harem_minami.rpy:1050
translate russian sasha_request_99b02eb3:
    mike.say "П... правда?"

# ch/harems/home/events/home_harem_minami.rpy:1051
translate russian sasha_request_1f0294f2:
    mike.say "То есть да... конечно!"

# ch/harems/home/events/home_harem_minami.rpy:1052
translate russian sasha_request_e639b356:
    sasha.say "Но не так горячо, как смотреть, как ты трахаешь её при мне."

# ch/harems/home/events/home_harem_minami.rpy:1053
translate russian sasha_request_9217c413:
    sasha.say "Так что с моей стороны она принята."

# ch/harems/home/events/home_harem_minami.rpy:1054
translate russian sasha_request_af4ea654:
    sasha.say "Иди и передай этой любопытной маленькой стерве, что я так сказала."

# ch/harems/home/events/home_harem_minami.rpy:1055
translate russian sasha_request_5d306eff:
    "Я улыбаюсь в ответ и с энтузиазмом киваю, поворачиваясь, чтобы уйти."

# ch/harems/home/events/home_harem_minami.rpy:1068
translate russian sasha_convince_bree_1b4ee954:
    "Едва Саша соглашается принять Минами в наши отношения, я чувствую, как дело сдвигается."

# ch/harems/home/events/home_harem_minami.rpy:1069
translate russian sasha_convince_bree_eab6839a:
    "С её поддержкой всё словно снежный ком, катящийся с горы и становящийся всё больше."

# ch/harems/home/events/home_harem_minami.rpy:1070
translate russian sasha_convince_bree_571d9fc5:
    "Мне даже почти не приходится намекать: [lssb_homeminami.bree_name()] ещё нужно склонить на нашу сторону."

# ch/harems/home/events/home_harem_minami.rpy:1071
translate russian sasha_convince_bree_7336673b:
    "Стоит намекнуть, и Саша практически марширует к единственной несогласной участнице нашего трио."

# ch/harems/home/events/home_harem_minami.rpy:1072
translate russian sasha_convince_bree_107a3fba:
    "Я следую за ней, словно меня тянет в её потоке."

# ch/harems/home/events/home_harem_minami.rpy:1075
translate russian sasha_convince_bree_90554260:
    sasha.say "[lssb_homeminami.bree_name()], нам нужно поговорить."

# ch/harems/home/events/home_harem_minami.rpy:1077
translate russian sasha_convince_bree_cff3d309:
    "[lssb_homeminami.bree_name()] отрывается от своего занятия, явно удивлённая тоном Саши."

# ch/harems/home/events/home_harem_minami.rpy:1078
translate russian sasha_convince_bree_5b3ebc38:
    "Пару раз моргает и, стряхнув замешательство, наконец отвечает."

# ch/harems/home/events/home_harem_minami.rpy:1080
translate russian sasha_convince_bree_27cbe496:
    bree.say "О, привет, Саша."

# ch/harems/home/events/home_harem_minami.rpy:1081
translate russian sasha_convince_bree_b4c9390e:
    bree.say "Привет, [lssb_common.hero_name()]! Не заметила тебя за Сашей!"

# ch/harems/home/events/home_harem_minami.rpy:1082
translate russian sasha_convince_bree_84452b02:
    "Лишь произнеся всё это и не получив приветствия в ответ, она заметно мрачнеет."

# ch/harems/home/events/home_harem_minami.rpy:1084
translate russian sasha_convince_bree_c44754f8:
    bree.say "Эм... что случилось, Саша?"

# ch/harems/home/events/home_harem_minami.rpy:1085
translate russian sasha_convince_bree_92856bd0:
    bree.say "Почему вы двое так на меня смотрите?"

# ch/harems/home/events/home_harem_minami.rpy:1087
translate russian sasha_convince_bree_95fc1062:
    sasha.say "Не прикидывайся невинной, [lssb_homeminami.bree_name()]."

# ch/harems/home/events/home_harem_minami.rpy:1088
translate russian sasha_convince_bree_0c959dfd:
    sasha.say "Ты прекрасно знаешь, о чём речь."

# ch/harems/home/events/home_harem_minami.rpy:1090
translate russian sasha_convince_bree_8e57dbfb:
    bree.say "Я... знаю?"

# ch/harems/home/events/home_harem_minami.rpy:1092
translate russian sasha_convince_bree_a80f3c68:
    "Саша раздражённо закатывает глаза."

# ch/harems/home/events/home_harem_minami.rpy:1094
translate russian sasha_convince_bree_38dad658:
    "Потом тычет пальцем прямо перед её лицом, и [lssb_homeminami.bree_name()] вскрикивает и отскакивает."

# ch/harems/home/events/home_harem_minami.rpy:1096
translate russian sasha_convince_bree_9c659dcc:
    sasha.say "Не строй из себя тупую блондинку, со мной не пройдёт!"

# ch/harems/home/events/home_harem_minami.rpy:1097
translate russian sasha_convince_bree_7f1128fa:
    sasha.say "К нам в постель могла бы прыгнуть невинная младшая сестрёнка-японка, [lssb_homeminami.bree_name()]."

# ch/harems/home/events/home_harem_minami.rpy:1098
translate russian sasha_convince_bree_a1ce3577:
    sasha.say "Невинная... японка... младшая сестрёнка!"

# ch/harems/home/events/home_harem_minami.rpy:1099
translate russian sasha_convince_bree_a03f71b1:
    sasha.say "Просто вдумайся на секунду."

# ch/harems/home/events/home_harem_minami.rpy:1101
translate russian sasha_convince_bree_a704b055:
    "[lssb_homeminami.bree_name()] качает головой, всё ещё явно оглушённая этим словесным натиском."

# ch/harems/home/events/home_harem_minami.rpy:1102
translate russian sasha_convince_bree_61ed0a03:
    "Мне невольно жаль её: вот так застали врасплох."

# ch/harems/home/events/home_harem_minami.rpy:1103
translate russian sasha_convince_bree_15058efd:
    "Но вмешиваться и спасать её я тоже не собираюсь."

# ch/harems/home/events/home_harem_minami.rpy:1104
translate russian sasha_convince_bree_464c8889:
    "Не тогда, когда хочу, по сути, того же, что и Саша."

# ch/harems/home/events/home_harem_minami.rpy:1105
translate russian sasha_convince_bree_84565379:
    "Даже если вступлюсь, получу благодарность лишь одной девушки."

# ch/harems/home/events/home_harem_minami.rpy:1106
translate russian sasha_convince_bree_4254824c:
    "А молчанием завоёвываю расположение двух третей женщин, живущих со мной под одной крышей."

# ch/harems/home/events/home_harem_minami.rpy:1108
translate russian sasha_convince_bree_999e0053:
    bree.say "Но, Саша, мы говорим о Минами!"

# ch/harems/home/events/home_harem_minami.rpy:1109
translate russian sasha_convince_bree_af957340:
    bree.say "Я думала, мы должны быть ей как старшие сёстры."

# ch/harems/home/events/home_harem_minami.rpy:1110
translate russian sasha_convince_bree_3c0534dc:
    bree.say "А не заманивать в нашу паутину греха!"

# ch/harems/home/events/home_harem_minami.rpy:1112
translate russian sasha_convince_bree_2e820012:
    sasha.say "Ха, ты так думаешь?!"

# ch/harems/home/events/home_harem_minami.rpy:1113
translate russian sasha_convince_bree_c72496cc:
    sasha.say "Насколько я слышала, [lssb_common.hero_name()] сам чуть ли не поддался её нажиму!"

# ch/harems/home/events/home_harem_minami.rpy:1116
translate russian sasha_convince_bree_a82c4248:
    "Вдруг [lssb_homeminami.bree_name()] и Саша обе смотрят прямо на меня."

# ch/harems/home/events/home_harem_minami.rpy:1117
translate russian sasha_convince_bree_178304a2:
    "Одна ждёт объяснений, другая — поддержки."

# ch/harems/home/events/home_harem_minami.rpy:1118
translate russian sasha_convince_bree_73a4982c:
    "Я беспомощно улыбаюсь, киваю и чешу затылок."

# ch/harems/home/events/home_harem_minami.rpy:1119
translate russian sasha_convince_bree_94c85480:
    mike.say "А, ну..."

# ch/harems/home/events/home_harem_minami.rpy:1120
translate russian sasha_convince_bree_b4aca5fe:
    mike.say "Раз уж спрашиваете, примерно так всё и было."

# ch/harems/home/events/home_harem_minami.rpy:1122
translate russian sasha_convince_bree_08cab640:
    "Саша кивает, довольная, что я сделал как велено."

# ch/harems/home/events/home_harem_minami.rpy:1123
translate russian sasha_convince_bree_4d279bc8:
    sasha.say "Видишь, [lssb_homeminami.bree_name()]?"

# ch/harems/home/events/home_harem_minami.rpy:1125
translate russian sasha_convince_bree_b4212f37:
    sasha.say "Минами вполне взрослая и понимает, на что идёт."

# ch/harems/home/events/home_harem_minami.rpy:1126
translate russian sasha_convince_bree_7a8b7dca:
    sasha.say "Ты могла отказать только из страха, что на её фоне будешь выглядеть хуже."

# ch/harems/home/events/home_harem_minami.rpy:1127
translate russian sasha_convince_bree_264bfadd:
    sasha.say "Или ты не такая смелая, как заявляешь."

# ch/harems/home/events/home_harem_minami.rpy:1128
translate russian sasha_convince_bree_a0aad87a:
    sasha.say "Так что именно?"

# ch/harems/home/events/home_harem_minami.rpy:1129
translate russian sasha_convince_bree_2490b795:
    sasha.say "Потому что и то и другое — неплохой повод заменить тебя на Минами."

# ch/harems/home/events/home_harem_minami.rpy:1130
translate russian sasha_convince_bree_2f34379c:
    sasha.say "Верно, [lssb_common.hero_name()]?"

# ch/harems/home/events/home_harem_minami.rpy:1131
translate russian sasha_convince_bree_48faddad:
    "У меня буквально отвисает челюсть: Саша подставила меня по полной."

# ch/harems/home/events/home_harem_minami.rpy:1132
translate russian sasha_convince_bree_c552dae4:
    "Похоже, чтобы получить желаемое, придётся поддерживать её до конца."

# ch/harems/home/events/home_harem_minami.rpy:1133
translate russian sasha_convince_bree_6605d8e0:
    mike.say "Эм... ну..."

# ch/harems/home/events/home_harem_minami.rpy:1134
translate russian sasha_convince_bree_ea196138:
    mike.say "После этого будет трудно вернуться к прежнему."

# ch/harems/home/events/home_harem_minami.rpy:1135
translate russian sasha_convince_bree_f3fa6879:
    mike.say "Слово «неловко» тут даже близко не передаёт сути..."

# ch/harems/home/events/home_harem_minami.rpy:1136
translate russian sasha_convince_bree_f47b99eb:
    mike.say "И без тебя всё было бы совсем не то, [lssb_homeminami.bree_name()]!"

# ch/harems/home/events/home_harem_minami.rpy:1137
translate russian sasha_convince_bree_53ebe50a:
    "Мои слова, кажется, почти не действуют."

# ch/harems/home/events/home_harem_minami.rpy:1138
translate russian sasha_convince_bree_cdc63167:
    "Пока я не добавляю последнюю фразу."

# ch/harems/home/events/home_harem_minami.rpy:1140
translate russian sasha_convince_bree_b27f1b96:
    "И тут [lssb_homeminami.bree_name()] оживляется и смотрит мне прямо в глаза."

# ch/harems/home/events/home_harem_minami.rpy:1141
translate russian sasha_convince_bree_59cba14e:
    bree.say "Ты правда так думаешь, [lssb_common.hero_name()]?"

# ch/harems/home/events/home_harem_minami.rpy:1143
translate russian sasha_convince_bree_14efdb5f:
    bree.say "Не променяешь меня на модель помоложе?"

# ch/harems/home/events/home_harem_minami.rpy:1144
translate russian sasha_convince_bree_957a84b3:
    "Я открываю рот, чтобы сказать: она не так уж старше Минами."

# ch/harems/home/events/home_harem_minami.rpy:1145
translate russian sasha_convince_bree_e58ecd96:
    "Но Саша тычет меня под рёбра, словно предугадав ответ."

# ch/harems/home/events/home_harem_minami.rpy:1146
translate russian sasha_convince_bree_e32f6983:
    mike.say "Нет... ни за что, [lssb_homeminami.bree_name()]."

# ch/harems/home/events/home_harem_minami.rpy:1147
translate russian sasha_convince_bree_8b40557b:
    mike.say "Неважно, сколько нас."

# ch/harems/home/events/home_harem_minami.rpy:1148
translate russian sasha_convince_bree_5d4d8c82:
    mike.say "Ты всё равно была с самого начала, как я и Саша."

# ch/harems/home/events/home_harem_minami.rpy:1150
translate russian sasha_convince_bree_f1496b08:
    "[lssb_homeminami.bree_name()] кивает, и улыбка медленно возвращается."

# ch/harems/home/events/home_harem_minami.rpy:1151
translate russian sasha_convince_bree_8b5f0e4e:
    bree.say "Х... хорошо, [lssb_common.hero_name()]."

# ch/harems/home/events/home_harem_minami.rpy:1152
translate russian sasha_convince_bree_94fb8bde:
    bree.say "Постараюсь, чтобы у нас всё получилось."

# ch/harems/home/events/home_harem_minami.rpy:1153
translate russian sasha_convince_bree_bf2efb52:
    bree.say "Скажи Минами, что я не против её присоединения."

# ch/harems/home/events/home_harem_minami.rpy:1154
translate russian sasha_convince_bree_5c382721:
    "Саша косится на меня с ухмылкой, предназначенной лишь мне."

# ch/harems/home/events/home_harem_minami.rpy:1155
translate russian sasha_convince_bree_4abf16a2:
    "А я просто благодарен, что [lssb_homeminami.bree_name()] удалось склонить на нашу сторону."

# ch/harems/home/events/home_harem_minami.rpy:1164
translate russian sasha_convince_bree_318c5a17:
    "Мне ещё нужно спросить обо всём этом Сэм."

# ch/harems/home/events/home_harem_minami.rpy:1171
translate russian samantha_request_0174f2dd:
    "Я набираюсь смелости, чтобы задать Сэм вопрос, который не выходит из головы уже несколько дней."

# ch/harems/home/events/home_harem_minami.rpy:1172
translate russian samantha_request_ed9e0b64:
    "Но даже когда наконец решаюсь подойти, всё ещё думаю: не сошёл ли я с ума?"

# ch/harems/home/events/home_harem_minami.rpy:1173
translate russian samantha_request_010936f9:
    "Ведь я уже живу под одной крышей с тремя невероятно горячими девушками."

# ch/harems/home/events/home_harem_minami.rpy:1174
translate russian samantha_request_b4353e5d:
    "И то, что происходит между нами четверыми, — самое горячее событие в моей жизни!"

# ch/harems/home/events/home_harem_minami.rpy:1175
translate russian samantha_request_0c29c40a:
    "Надо быть безумцем, чтобы даже думать о том, что может всё разрушить."

# ch/harems/home/events/home_harem_minami.rpy:1176
translate russian samantha_request_75036123:
    "Разве стоит рисковать только ради того, чтобы Минами тоже присоединилась?"

# ch/harems/home/events/home_harem_minami.rpy:1177
translate russian samantha_request_7af18f36:
    "Но я всё это знаю и всё равно продолжаю."

# ch/harems/home/events/home_harem_minami.rpy:1178
translate russian samantha_request_41865e24:
    "Может, я и правда сумасшедший."

# ch/harems/home/events/home_harem_minami.rpy:1179
translate russian samantha_request_f031b620:
    "А может, просто умею мечтать!"

# ch/harems/home/events/home_harem_minami.rpy:1183
translate russian samantha_request_10661c91:
    mike.say "Привет, Кексик..."

# ch/harems/home/events/home_harem_minami.rpy:1185
translate russian samantha_request_96e964b9:
    mike.say "Привет, Сэм..."

# ch/harems/home/events/home_harem_minami.rpy:1187
translate russian samantha_request_bdd2fc67:
    "Услышав мой голос, Сэм поворачивается и улыбается."

# ch/harems/home/events/home_harem_minami.rpy:1188
translate russian samantha_request_62ff8e80:
    "От таких улыбок у меня всё переворачивается внутри."

# ch/harems/home/events/home_harem_minami.rpy:1189
translate russian samantha_request_130eef30:
    "Будто я таю от того, какая она сексуальная и прекрасная!"

# ch/harems/home/events/home_harem_minami.rpy:1190
translate russian samantha_request_f07c91b5:
    samantha.say "Привет, [lssb_common.hero_name()]."

# ch/harems/home/events/home_harem_minami.rpy:1192
translate russian samantha_request_c6772395:
    samantha.say "О чём задумался?"

# ch/harems/home/events/home_harem_minami.rpy:1193
translate russian samantha_request_92c097e8:
    "Мне вдруг становится жарко и неловко, щёки краснеют."

# ch/harems/home/events/home_harem_minami.rpy:1194
translate russian samantha_request_7e9c55e7:
    "Я же просто подошёл и поздоровался."

# ch/harems/home/events/home_harem_minami.rpy:1195
translate russian samantha_request_97ecdd5c:
    "Как она поняла, что у меня что-то на уме?"

# ch/harems/home/events/home_harem_minami.rpy:1196
translate russian samantha_request_58b480d5:
    "Она что, экстрасенс?!"

# ch/harems/home/events/home_harem_minami.rpy:1198
translate russian samantha_request_869dc127:
    mike.say "Ч... что ты имеешь в виду, Кексик?"

# ch/harems/home/events/home_harem_minami.rpy:1200
translate russian samantha_request_adde6a30:
    mike.say "Ч... что ты имеешь в виду, Сэм?"

# ch/harems/home/events/home_harem_minami.rpy:1201
translate russian samantha_request_01239f24:
    mike.say "У меня нет мыслей."

# ch/harems/home/events/home_harem_minami.rpy:1202
translate russian samantha_request_54385de3:
    mike.say "То есть... у меня нет ничего такого на уме!"

# ch/harems/home/events/home_harem_minami.rpy:1203
translate russian samantha_request_abdc8333:
    "Сэм хихикает над моей растерянностью и качает головой."

# ch/harems/home/events/home_harem_minami.rpy:1204
translate russian samantha_request_b17d1830:
    samantha.say "Ох, [lssb_common.hero_name()]!"

# ch/harems/home/events/home_harem_minami.rpy:1205
translate russian samantha_request_5f26a0f3:
    samantha.say "Я всегда слышу это по твоему голосу."

# ch/harems/home/events/home_harem_minami.rpy:1206
translate russian samantha_request_a5d75344:
    samantha.say "Лучше бы написал сообщение."

# ch/harems/home/events/home_harem_minami.rpy:1207
translate russian samantha_request_f6de6bf5:
    samantha.say "Тогда я не услышала бы то, что ты выдаёшь невольно!"

# ch/harems/home/events/home_harem_minami.rpy:1208
translate russian samantha_request_12ea634f:
    "Потираю шею и пытаюсь отшутиться."

# ch/harems/home/events/home_harem_minami.rpy:1210
translate russian samantha_request_27f32c96:
    mike.say "Ничего себе, Кексик."

# ch/harems/home/events/home_harem_minami.rpy:1212
translate russian samantha_request_44e22e87:
    mike.say "Ничего себе, Сэм."

# ch/harems/home/events/home_harem_minami.rpy:1213
translate russian samantha_request_3b6a8fa9:
    mike.say "Неужели ты так хорошо меня знаешь?"

# ch/harems/home/events/home_harem_minami.rpy:1214
translate russian samantha_request_1fe94733:
    "Она кивает, а потом склоняет голову набок."

# ch/harems/home/events/home_harem_minami.rpy:1215
translate russian samantha_request_38dfb3ca:
    "По её лицу вижу: на этом не закончилось."

# ch/harems/home/events/home_harem_minami.rpy:1217
translate russian samantha_request_77c21e58:
    samantha.say "И достаточно хорошо знаю, чтобы понять, что ты сейчас делаешь."

# ch/harems/home/events/home_harem_minami.rpy:1218
translate russian samantha_request_d0959672:
    samantha.say "Не пытайся сбить меня с толку, [lssb_common.hero_name()]."

# ch/harems/home/events/home_harem_minami.rpy:1219
translate russian samantha_request_9c2dab6b:
    samantha.say "Давай уже к сути, ладно?"

# ch/harems/home/events/home_harem_minami.rpy:1220
translate russian samantha_request_f786d6d1:
    "Я киваю, наконец признав, что придётся сделать, как она говорит."

# ch/harems/home/events/home_harem_minami.rpy:1221
translate russian samantha_request_75b622f7:
    "Сэм явно знает меня лучше, чем я сам."

# ch/harems/home/events/home_harem_minami.rpy:1222
translate russian samantha_request_d57e7db0:
    "И подкрасться к теме незаметно не получится."

# ch/harems/home/events/home_harem_minami.rpy:1223
translate russian samantha_request_5e99e90f:
    mike.say "А, ладно, ладно."

# ch/harems/home/events/home_harem_minami.rpy:1224
translate russian samantha_request_14ebc76e:
    mike.say "Это насчёт Минами."

# ch/harems/home/events/home_harem_minami.rpy:1225
translate russian samantha_request_bc814773:
    samantha.say "Твоей младшей сестры?"

# ch/harems/home/events/home_harem_minami.rpy:1228
translate russian samantha_request_03895528:
    samantha.say "Что с ней?"

# ch/harems/home/events/home_harem_minami.rpy:1229
translate russian samantha_request_6258047e:
    "Я уже собираюсь открыть рот и всё выложить."

# ch/harems/home/events/home_harem_minami.rpy:1230
translate russian samantha_request_2a1c6965:
    "Но замечаю, как меняется лицо Сэм."

# ch/harems/home/events/home_harem_minami.rpy:1231
translate russian samantha_request_cdad3d1d:
    "Веселье вдруг сменяется тревогой."

# ch/harems/home/events/home_harem_minami.rpy:1233
translate russian samantha_request_025d0a78:
    samantha.say "О нет..."

# ch/harems/home/events/home_harem_minami.rpy:1234
translate russian samantha_request_234a82b7:
