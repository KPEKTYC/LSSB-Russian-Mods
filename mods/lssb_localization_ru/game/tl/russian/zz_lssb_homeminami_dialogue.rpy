# ch/harems/home/events/home_harem_minami.rpy:1280
translate russian samantha_request_a513ae14:
    samantha.say "Да какая разница..."

# ch/harems/home/events/home_harem_minami.rpy:1282
translate russian samantha_request_47e3c504:
    mike.say "Так вот, я хотел спросить, Кексик..."

# ch/harems/home/events/home_harem_minami.rpy:1284
translate russian samantha_request_027cec8d:
