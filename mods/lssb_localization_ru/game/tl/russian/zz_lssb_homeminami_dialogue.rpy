    bree.say "Ты..."

# ch/harems/home/events/home_harem_minami.rpy:2130
translate russian bree_minami_threesome_755a4db2:
    bree.say "Ты собираешься трахнуть меня в попку?"

# ch/harems/home/events/home_harem_minami.rpy:2133
translate russian bree_minami_threesome_13685872:
    "Именно в этот момент я загоняю член внутрь."

# ch/harems/home/events/home_harem_minami.rpy:2134
