# ch/harems/home/events/home_harem_minami.rpy:1285
translate russian samantha_request_e5da1992:
    mike.say "Ты не против, если Минами присоединится к нашим отношениям, где уже есть ты, я, [lssb_homeminami.bree_name()] и Саша?"

# ch/harems/home/events/home_harem_minami.rpy:1287
translate russian samantha_request_51cb1c99:
