# ch/harems/home/events/home_harem_minami.rpy:1301
translate russian samantha_request_58efa411:
    samantha.say "Мне нужно время подумать."

# ch/harems/home/events/home_harem_minami.rpy:1304
translate russian samantha_request_781e9e8b:
