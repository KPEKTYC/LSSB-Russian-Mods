# Native Homepair identifiers, current source catalog. Translation only.

# ch/harems/home/events/home_harem_bree_sasha.rpy:303
translate russian bree_sasha_convenient_store_99b59c55:
    "Я щёлкаю пальцами, вспомнив то, что не давало мне покоя почти весь день."

# ch/harems/home/events/home_harem_bree_sasha.rpy:304
translate russian bree_sasha_convenient_store_5d55a906:
    "Что-то, что нужно было сделать и что я никак не мог вспомнить, наконец всплыло в памяти."

# ch/harems/home/events/home_harem_bree_sasha.rpy:305
translate russian bree_sasha_convenient_store_41d30469:
    mike.say "Эй, девчонки."

# ch/harems/home/events/home_harem_bree_sasha.rpy:306
translate russian bree_sasha_convenient_store_d4acff7c:
    mike.say "Не дайте мне забыть сегодня купить продукты, ладно?"

# ch/harems/home/events/home_harem_bree_sasha.rpy:308
translate russian bree_sasha_convenient_store_46a1dff9:
    "При упоминании продуктов [lssb_homepair.bree_name()] с улыбкой наклоняется к Саше."

# ch/harems/home/events/home_harem_bree_sasha.rpy:310
translate russian bree_sasha_convenient_store_a80b757e:
    "Саша закатывает глаза ещё до того, как та открывает рот."

# ch/harems/home/events/home_harem_bree_sasha.rpy:311
translate russian bree_sasha_convenient_store_3a21e9d1:
    "Словно уже знает, что сейчас скажет [lssb_homepair.bree_name()]."

# ch/harems/home/events/home_harem_bree_sasha.rpy:313
translate russian bree_sasha_convenient_store_87cde776:
    sasha.say "Не надо, [lssb_homepair.bree_name()]!"

# ch/harems/home/events/home_harem_bree_sasha.rpy:315
translate russian bree_sasha_convenient_store_b0facef8:
    bree.say "Ну же, Саша!"

# ch/harems/home/events/home_harem_bree_sasha.rpy:318
translate russian bree_sasha_convenient_store_dabf4cfb:
    sasha.say "Я серьёзно, не смей!"

# ch/harems/home/events/home_harem_bree_sasha.rpy:321
translate russian bree_sasha_convenient_store_dbe13097:
    bree.say "А я всё равно..."

# ch/harems/home/events/home_harem_bree_sasha.rpy:323
translate russian bree_sasha_convenient_store_caff9487:
    sasha.say "Не надо!"

# ch/harems/home/events/home_harem_bree_sasha.rpy:325
translate russian bree_sasha_convenient_store_e58bba91:
    "Я с интересом наблюдаю за этой странной сценой."

# ch/harems/home/events/home_harem_bree_sasha.rpy:327
translate russian bree_sasha_convenient_store_192588c1:
    "И тут [lssb_homepair.bree_name()] поражает меня, начав петь!"

# ch/harems/home/events/home_harem_bree_sasha.rpy:328
translate russian bree_sasha_convenient_store_0d4b997e:
    bree.say "Так удобен он один — Convenient Store, наш магазин!"

# ch/harems/home/events/home_harem_bree_sasha.rpy:330
translate russian bree_sasha_convenient_store_0cfaa68d:
    sasha.say "Больше нечего желать — в Convenient Store идём опять!"

# ch/harems/home/events/home_harem_bree_sasha.rpy:333
translate russian bree_sasha_convenient_store_61087853:
    "Я недоверчиво качаю головой: Саша тоже подпевает."

# ch/harems/home/events/home_harem_bree_sasha.rpy:338
translate russian bree_sasha_convenient_store_ba7f7e02:
    mike.say "Ничего себе..."

# ch/harems/home/events/home_harem_bree_sasha.rpy:339
translate russian bree_sasha_convenient_store_815c94c7:
    mike.say "Я и не знал, что у них есть рекламная песенка!"

# ch/harems/home/events/home_harem_bree_sasha.rpy:341
translate russian bree_sasha_convenient_store_a2937bd6:
    bree.say "Она довольно старая."

# ch/harems/home/events/home_harem_bree_sasha.rpy:342
translate russian bree_sasha_convenient_store_28740c46:
    bree.say "Саша нашла её в интернете."

# ch/harems/home/events/home_harem_bree_sasha.rpy:345
translate russian bree_sasha_convenient_store_98fbe6c4:
    sasha.say "И теперь я об этом жалею."

# ch/harems/home/events/home_harem_bree_sasha.rpy:346
translate russian bree_sasha_convenient_store_c37f6fc5:
    sasha.say "Ужасно назойливая, из головы не выкинешь!"

# ch/harems/home/events/home_harem_bree_sasha.rpy:348
translate russian bree_sasha_convenient_store_8a5ab964:
    mike.say "Здорово, что такой магазин прямо за углом."

# ch/harems/home/events/home_harem_bree_sasha.rpy:349
translate russian bree_sasha_convenient_store_fa0641f6:
    mike.say "Но, знаете, нигде за пределами этого города я их не видел."

# ch/harems/home/events/home_harem_bree_sasha.rpy:351
translate russian bree_sasha_convenient_store_7dbc56cd:
    bree.say "Да, у нас дома таких не было."

# ch/harems/home/events/home_harem_bree_sasha.rpy:354
translate russian bree_sasha_convenient_store_2b03d579:
    sasha.say "У нас тоже."

# ch/harems/home/events/home_harem_bree_sasha.rpy:356
translate russian bree_sasha_convenient_store_6040f1cf:
    mike.say "И сначала я подумал, что кто-то напутал с вывеской!"

# ch/harems/home/events/home_harem_bree_sasha.rpy:358
translate russian bree_sasha_convenient_store_7b73c7a8:
    sasha.say "Вот именно!"

# ch/harems/home/events/home_harem_bree_sasha.rpy:359
translate russian bree_sasha_convenient_store_b047f91a:
    sasha.say "А местные просто считают, что так и надо."

# ch/harems/home/events/home_harem_bree_sasha.rpy:360
translate russian bree_sasha_convenient_store_0f90a8a6:
    sasha.say "Обращаешь их внимание, а они даже не понимают, о чём ты!"

# ch/harems/home/events/home_harem_bree_sasha.rpy:363
translate russian bree_sasha_convenient_store_21c083a5:
    bree.say "Словно им мозги промыли!"

# ch/harems/home/events/home_harem_bree_sasha.rpy:365
translate russian bree_sasha_convenient_store_debeb194:
    sasha.say "Как в секте!"

# ch/harems/home/events/home_harem_bree_sasha.rpy:368
translate russian bree_sasha_convenient_store_927cd272:
    "Девушки смеются, и я не могу не присоединиться."

# ch/harems/home/events/home_harem_bree_sasha.rpy:369
translate russian bree_sasha_convenient_store_dfc30da7:
    mike.say "Но если без шуток, я люблю это место."

# ch/harems/home/events/home_harem_bree_sasha.rpy:370
translate russian bree_sasha_convenient_store_81d30e2c:
    mike.say "Не знаю, что бы я без него делал."

# ch/harems/home/events/home_harem_bree_sasha.rpy:371
translate russian bree_sasha_convenient_store_e701f402:
    bree.say "Мы ВСЕ его любим!"

# ch/harems/home/events/home_harem_bree_sasha.rpy:372
translate russian bree_sasha_convenient_store_2d014720:
    sasha.say "Да здравствует Convenient Store!"

# ch/harems/home/events/home_harem_bree_sasha.rpy:378
translate russian home_harem_preg_talk_4d36e307:
    "В наше время с детства буквально вдалбливают, как важны безопасный секс и разумные меры предосторожности."

# ch/harems/home/events/home_harem_bree_sasha.rpy:379
translate russian home_harem_preg_talk_faed53cd:
    "Но когда нарушаешь привычные общественные нормы и заходишь туда, где большинство людей ещё не бывало, всё меняется."

# ch/harems/home/events/home_harem_bree_sasha.rpy:380
translate russian home_harem_preg_talk_6bf0df00:
    "Отбросив целую кучу общепринятых правил, начинаешь расслабляться и в других вопросах."

# ch/harems/home/events/home_harem_bree_sasha.rpy:381
translate russian home_harem_preg_talk_be4595c7:
    "Например, если ты, ну, скажем, живёшь под одной крышей с двумя преданными секс-рабынями."

# ch/harems/home/events/home_harem_bree_sasha.rpy:382
translate russian home_harem_preg_talk_532abab8:
    "Тогда тебе ведь можно простить то, что иногда ты забываешь о презервативе, правда?"

# ch/harems/home/events/home_harem_bree_sasha.rpy:386
translate russian home_harem_preg_talk_5a6d3ab6:
    "В смысле, когда у тебя есть такие девушки, как [lssb_homepair.bree_name()] и Саша, буквально на поводках..."

# ch/harems/home/events/home_harem_bree_sasha.rpy:387
translate russian home_harem_preg_talk_8b86212a:
    "Наверное, мне стоило заметить первые тревожные признаки."

# ch/harems/home/events/home_harem_bree_sasha.rpy:388
translate russian home_harem_preg_talk_ce17e682:
    "Например, утреннее недомогание или странные прихоти в еде."

# ch/harems/home/events/home_harem_bree_sasha.rpy:389
translate russian home_harem_preg_talk_114447a0:
    "Но пропустить одинаковые явные признаки, которые проявляли и [lssb_homepair.bree_name()], и Саша..."

# ch/harems/home/events/home_harem_bree_sasha.rpy:390
translate russian home_harem_preg_talk_4fdb9058:
    "Может, я их и видел, но из неосознанного страха игнорировал их смысл?"

# ch/harems/home/events/home_harem_bree_sasha.rpy:391
translate russian home_harem_preg_talk_865cd393:
    "Так или иначе, мне выпадает сомнительное удовольствие застать момент, когда [lssb_homepair.bree_name()] и Саша сравнивают животы."

# ch/harems/home/events/home_harem_bree_sasha.rpy:392
translate russian home_harem_preg_talk_7e0d2c07:
    "Думая, что они совсем одни, девушки с любопытством ощупывают и сжимают друг другу животики."

# ch/harems/home/events/home_harem_bree_sasha.rpy:393
translate russian home_harem_preg_talk_a78cc71f:
    "Выглядит немного странно, но, честно говоря, это зрелище меня весьма возбуждает!"

# ch/harems/home/events/home_harem_bree_sasha.rpy:394
translate russian home_harem_preg_talk_c75aed15:
    "Пока они не замечают меня, их разговор тихий, почти заговорщический."

# ch/harems/home/events/home_harem_bree_sasha.rpy:395
translate russian home_harem_preg_talk_03955821:
    "Но стоит им меня увидеть, как они начинают улыбаться и хлопать ресницами."

# ch/harems/home/events/home_harem_bree_sasha.rpy:396
translate russian home_harem_preg_talk_7eb6efdf:
    "Именно так, что я вспоминаю, насколько приятно быть их хозяином."

# ch/harems/home/events/home_harem_bree_sasha.rpy:398
translate russian home_harem_preg_talk_71d4847a:
    bree.say "Привет, [lssb_common.hero_name()]."

# ch/harems/home/events/home_harem_bree_sasha.rpy:401
translate russian home_harem_preg_talk_0c1a4b88:
    sasha.say "Прости, мы не слышали, как ты вошёл."

# ch/harems/home/events/home_harem_bree_sasha.rpy:403
translate russian home_harem_preg_talk_06313de1:
    "Обе девушки задрали верх одежды, обнажив животы."

# ch/harems/home/events/home_harem_bree_sasha.rpy:404
translate russian home_harem_preg_talk_c511815a:
    "Улыбаясь в ответ, я замечаю, что ни одна не пытается снова прикрыться."

# ch/harems/home/events/home_harem_bree_sasha.rpy:405
translate russian home_harem_preg_talk_2e87d988:
    mike.say "Ничего страшного."

# ch/harems/home/events/home_harem_bree_sasha.rpy:406
translate russian home_harem_preg_talk_6c23d232:
    mike.say "Только расскажите, о чём вы тут говорили."

# ch/harems/home/events/home_harem_bree_sasha.rpy:407
translate russian home_harem_preg_talk_a19568e6:
    "[lssb_homepair.bree_name()] и Саша переглядываются и словно делают глубокий вдох, прежде чем ответить."

# ch/harems/home/events/home_harem_bree_sasha.rpy:409
translate russian home_harem_preg_talk_b6e7e8c0:
    sasha.say "Просто сравнивали животики, вот и всё."

# ch/harems/home/events/home_harem_bree_sasha.rpy:412
translate russian home_harem_preg_talk_65faf200:
    bree.say "Саша считает, что у меня чуть больше."

# ch/harems/home/events/home_harem_bree_sasha.rpy:413
translate russian home_harem_preg_talk_e6ba7b29:
    bree.say "Но, по-моему, разница небольшая."

# ch/harems/home/events/home_harem_bree_sasha.rpy:415
translate russian home_harem_preg_talk_07bc007d:
    "Я слегка хмурюсь, не понимая, с чего вдруг их так заинтересовали собственные животы."

# ch/harems/home/events/home_harem_bree_sasha.rpy:416
translate russian home_harem_preg_talk_11bb0e9f:
    "У обеих они и так не особенно большие."

# ch/harems/home/events/home_harem_bree_sasha.rpy:417
translate russian home_harem_preg_talk_4a6cf182:
    "А если бы меня беспокоило, что они чуть поправились в талии, я бы уже сказал."

# ch/harems/home/events/home_harem_bree_sasha.rpy:418
translate russian home_harem_preg_talk_8e94cc86:
    "В конце концов, это одно из преимуществ пары секс-рабынь: они не злятся, когда говоришь им похудеть!"

# ch/harems/home/events/home_harem_bree_sasha.rpy:419
translate russian home_harem_preg_talk_be5decc7:
    "Но когда [lssb_homepair.bree_name()] показывает на их животы, я и правда замечаю, что обе немного округлились."

# ch/harems/home/events/home_harem_bree_sasha.rpy:420
translate russian home_harem_preg_talk_326c2993:
    "Не то чтобы это хоть сколько-нибудь меня отталкивало."

# ch/harems/home/events/home_harem_bree_sasha.rpy:421
translate russian home_harem_preg_talk_00e3c6ce:
    "Наоборот, им идёт. Они выглядят так мило, что хочется положить голову на эти животики, как на подушки..."

# ch/harems/home/events/home_harem_bree_sasha.rpy:422
translate russian home_harem_preg_talk_c8bd6b20:
    mike.say "Знаете, не стоит спорить о таких вещах."

# ch/harems/home/events/home_harem_bree_sasha.rpy:423
translate russian home_harem_preg_talk_1ef4672e:
    mike.say "Ни одна из вас не толстая, ни капельки."

# ch/harems/home/events/home_harem_bree_sasha.rpy:424
translate russian home_harem_preg_talk_70ee12d5:
    mike.say "Вообще-то, по-моему, вы обе стали очень сексуальными!"

# ch/harems/home/events/home_harem_bree_sasha.rpy:427
translate russian home_harem_preg_talk_f02bee2f:
    "Саша смотрит на меня с неожиданным раздражением, а [lssb_homepair.bree_name()] поворачивается к ней, пытаясь сдержать хихиканье."

# ch/harems/home/events/home_harem_bree_sasha.rpy:428
translate russian home_harem_preg_talk_da105f10:
    "Озадаченный этой реакцией, я перевожу взгляд с одной на другую и обратно."

# ch/harems/home/events/home_harem_bree_sasha.rpy:429
translate russian home_harem_preg_talk_9aa60064:
    "Правда не понимаю, что такого странного я сказал."

# ch/harems/home/events/home_harem_bree_sasha.rpy:430
translate russian home_harem_preg_talk_91f85d53:
    "А я-то думал, что вполне современно и спокойно отношусь к их округлившимся животикам!"

# ch/harems/home/events/home_harem_bree_sasha.rpy:431
translate russian home_harem_preg_talk_80b22f14:
    mike.say "Что я сказал?"

# ch/harems/home/events/home_harem_bree_sasha.rpy:432
translate russian home_harem_preg_talk_8554f0dc:
    mike.say "Что смешного?"

# ch/harems/home/events/home_harem_bree_sasha.rpy:434
translate russian home_harem_preg_talk_25c6c768:
    bree.say "Ох, [lssb_common.hero_name()], ты правда не понимаешь, да?"

# ch/harems/home/events/home_harem_bree_sasha.rpy:436
translate russian home_harem_preg_talk_fe1ffd12:
    "[lssb_homepair.bree_name()] снова хихикает."

# ch/harems/home/events/home_harem_bree_sasha.rpy:437
translate russian home_harem_preg_talk_183f3c6a:
    mike.say "Не понимаю чего?"

# ch/harems/home/events/home_harem_bree_sasha.rpy:440
translate russian home_harem_preg_talk_28bf8037:
    sasha.say "Я и [lssb_homepair.bree_name()], мы обе беременны, [lssb_common.hero_name()]."

# ch/harems/home/events/home_harem_bree_sasha.rpy:442
translate russian home_harem_preg_talk_da012390:
    "Не знаю, говорит ли Саша так прямо из послушания или от раздражения моей тугодумностью."

# ch/harems/home/events/home_harem_bree_sasha.rpy:443
translate russian home_harem_preg_talk_7284bfdc:
    "Но этих нескольких слов хватает, чтобы рассеять путаницу и добраться до сути."

# ch/harems/home/events/home_harem_bree_sasha.rpy:444
translate russian home_harem_preg_talk_4845fa02:
    mike.say "Вы беременны... ОБЕ?!"

# ch/harems/home/events/home_harem_bree_sasha.rpy:446
translate russian home_harem_preg_talk_2cf919af:
    sasha.say "Именно это я и сказала, [lssb_common.hero_name()]."

# ch/harems/home/events/home_harem_bree_sasha.rpy:448
translate russian home_harem_preg_talk_dbeaa24a:
    mike.say "Я... я понял..."

# ch/harems/home/events/home_harem_bree_sasha.rpy:449
translate russian home_harem_preg_talk_5eac1a41:
    mike.say "Просто... сразу столько всего нужно осмыслить!"

# ch/harems/home/events/home_harem_bree_sasha.rpy:450
translate russian home_harem_preg_talk_62e2e9e3:
    "Я знаю, что сейчас должен изображать уверенного и непоколебимого Господина."

# ch/harems/home/events/home_harem_bree_sasha.rpy:451
translate russian home_harem_preg_talk_15ff55d4:
    "Но эта новость действительно застала меня совершенно врасплох."

# ch/harems/home/events/home_harem_bree_sasha.rpy:452
translate russian home_harem_preg_talk_15c313cd:
    "Да и совсем не так я представлял себе ситуацию, в которой от меня одновременно забеременеют две девушки."

# ch/harems/home/events/home_harem_bree_sasha.rpy:453
translate russian home_harem_preg_talk_b325c493:
    mike.say "Подождите, вы обе не против?"

# ch/harems/home/events/home_harem_bree_sasha.rpy:454
translate russian home_harem_preg_talk_3a9b3b38:
    mike.say "Совсем не злитесь?"

# ch/harems/home/events/home_harem_bree_sasha.rpy:455
translate russian home_harem_preg_talk_615accea:
    "[lssb_homepair.bree_name()] и Саша снова переглядываются, а затем возвращают взгляды ко мне."

# ch/harems/home/events/home_harem_bree_sasha.rpy:456
translate russian home_harem_preg_talk_35f9f67e:
    "Они обмениваются многозначительным взглядом: ясно, что серьёзный разговор между ними уже состоялся."

# ch/harems/home/events/home_harem_bree_sasha.rpy:457
translate russian home_harem_preg_talk_c2db97b0:
    "Сначала кивает Саша, а через несколько секунд — [lssb_homepair.bree_name()]."

# ch/harems/home/events/home_harem_bree_sasha.rpy:459
translate russian home_harem_preg_talk_e155f31f:
    bree.say "Нам не положено злиться или судить твои поступки, [lssb_common.hero_name()]."

# ch/harems/home/events/home_harem_bree_sasha.rpy:462
translate russian home_harem_preg_talk_d2c037be:
    sasha.say "Мы обе ждём от тебя детей, планировал ты это или нет."

# ch/harems/home/events/home_harem_bree_sasha.rpy:465
translate russian home_harem_preg_talk_bd235395:
    bree.say "Мы твои рабыни, поэтому в таких вопросах подчиняемся твоей воле."

# ch/harems/home/events/home_harem_bree_sasha.rpy:467
translate russian home_harem_preg_talk_89e9980b:
    "Я киваю, поначалу думая, что это избавляет меня от неприятностей в обоих случаях."

# ch/harems/home/events/home_harem_bree_sasha.rpy:470
translate russian home_harem_preg_talk_d97c449c:
    "Но затем понимаю: пусть мне и не собираются надрать задницу, с ответственностью всё как раз наоборот."

# ch/harems/home/events/home_harem_bree_sasha.rpy:471
translate russian home_harem_preg_talk_18111a16:
    "Как мои секс-рабыни, [lssb_homepair.bree_name()] и Саша вполне довольны тем, что я буду принимать все решения за нас троих."

# ch/harems/home/events/home_harem_bree_sasha.rpy:472
translate russian home_harem_preg_talk_23b91f52:
    "Нет, подождите, за всех ПЯТЕРЫХ!"

# ch/harems/home/events/home_harem_bree_sasha.rpy:473
translate russian home_harem_preg_talk_2fc0fa4e:
    "Похоже, быть бесспорным Господином — это не только развлечения..."

# ch/harems/home/events/home_harem_bree_sasha.rpy:475
translate russian home_harem_preg_talk_24279150:
    "Вы когда-нибудь смотрели документальные фильмы о дикой природе?"

# ch/harems/home/events/home_harem_bree_sasha.rpy:476
translate russian home_harem_preg_talk_ffa5c829:
    "Те, где львицы приглядываются к растерянной антилопе гну?"

# ch/harems/home/events/home_harem_bree_sasha.rpy:477
translate russian home_harem_preg_talk_d1b2a146:
    "Вот именно так я сейчас себя и чувствую."

# ch/harems/home/events/home_harem_bree_sasha.rpy:481
translate russian home_harem_preg_talk_2cea1bae:
    "Я только что вошёл туда, где были [lssb_homepair.bree_name()] и Саша, и всё словно замерло."

# ch/harems/home/events/home_harem_bree_sasha.rpy:482
translate russian home_harem_preg_talk_a7e7ef93:
    "Ещё мгновение назад они увлечённо болтали, пока не заметили меня."

# ch/harems/home/events/home_harem_bree_sasha.rpy:485
translate russian home_harem_preg_talk_8b4d3f64:
    "Но разговор резко оборвался, и теперь обе смотрят прямо на меня."

# ch/harems/home/events/home_harem_bree_sasha.rpy:486
translate russian home_harem_preg_talk_b1eff90a:
    "А я — тот самый бедный глупый зверь, который не знает, замереть ему или развернуться и бежать!"

# ch/harems/home/events/home_harem_bree_sasha.rpy:487
translate russian home_harem_preg_talk_f4207b3a:
    "Разница лишь в том, что львицы в таких фильмах обычно не улыбаются столь многозначительно..."

# ch/harems/home/events/home_harem_bree_sasha.rpy:489
translate russian home_harem_preg_talk_6058448b:
    bree.say "Привет, [lssb_common.hero_name()]!"

# ch/harems/home/events/home_harem_bree_sasha.rpy:492
translate russian home_harem_preg_talk_144b1e59:
    sasha.say "Какое совпадение!"

# ch/harems/home/events/home_harem_bree_sasha.rpy:495
translate russian home_harem_preg_talk_53142b04:
    bree.say "Да, мы как раз о тебе говорили..."

# ch/harems/home/events/home_harem_bree_sasha.rpy:497
translate russian home_harem_preg_talk_9d6785a8:
    "Надеюсь, моя улыбка не выглядит слишком нервной и натянутой."

# ch/harems/home/events/home_harem_bree_sasha.rpy:498
translate russian home_harem_preg_talk_00d18d93:
    "Но я уже уверен: они понимают, насколько я напуган."

# ch/harems/home/events/home_harem_bree_sasha.rpy:499
translate russian home_harem_preg_talk_ff6b8a35:
    mike.say "Эм... правда?"

# ch/harems/home/events/home_harem_bree_sasha.rpy:500
translate russian home_harem_preg_talk_8edefa6c:
    "Девушки кивают, а их улыбки становятся ещё самодовольнее."

# ch/harems/home/events/home_harem_bree_sasha.rpy:502
translate russian home_harem_preg_talk_038a35c4:
    sasha.say "Да, мы как раз обсуждали, что ты за человек."

# ch/harems/home/events/home_harem_bree_sasha.rpy:504
translate russian home_harem_preg_talk_8e74a1aa:
    mike.say "Что я за... человек?"

# ch/harems/home/events/home_harem_bree_sasha.rpy:506
translate russian home_harem_preg_talk_bd74197a:
    sasha.say "Именно."

# ch/harems/home/events/home_harem_bree_sasha.rpy:507
translate russian home_harem_preg_talk_0801f780:
    sasha.say "Вот, например, [lssb_homepair.bree_name()]."

# ch/harems/home/events/home_harem_bree_sasha.rpy:509
translate russian home_harem_preg_talk_6781e531:
    "Саша указывает в её сторону, а [lssb_homepair.bree_name()] хлопает ресницами и мило смотрит на меня."

# ch/harems/home/events/home_harem_bree_sasha.rpy:511
translate russian home_harem_preg_talk_e6c71b7a:
    sasha.say "Она считает, что с тобой нужно обращаться бережно, как с хрупкой вещью."

# ch/harems/home/events/home_harem_bree_sasha.rpy:514
translate russian home_harem_preg_talk_4be9aaff:
    "[lssb_homepair.bree_name()] радостно кивает в подтверждение."

# ch/harems/home/events/home_harem_bree_sasha.rpy:516
translate russian home_harem_preg_talk_c6d1dce0:
    sasha.say "Что горькую правду нужно подсластить, чтобы ты смог её проглотить."

# ch/harems/home/events/home_harem_bree_sasha.rpy:519
translate russian home_harem_preg_talk_6a85184d:
    bree.say "А вот Саша..."

# ch/harems/home/events/home_harem_bree_sasha.rpy:521
translate russian home_harem_preg_talk_f3b83bef:
    "[lssb_homepair.bree_name()] наклоняется вперёд и подхватывает разговор."

# ch/harems/home/events/home_harem_bree_sasha.rpy:522
translate russian home_harem_preg_talk_0c8d9133:
    bree.say "Она придерживается мнения, что ты ценишь прямоту."

# ch/harems/home/events/home_harem_bree_sasha.rpy:524
translate russian home_harem_preg_talk_8a0b8479:
    "Теперь [lssb_homepair.bree_name()] смотрит на Сашу, а та пожимает плечами и кивает."

# ch/harems/home/events/home_harem_bree_sasha.rpy:526
translate russian home_harem_preg_talk_faa40f94:
    bree.say "Саша думает, что ты предпочитаешь простую правду без прикрас."

# ch/harems/home/events/home_harem_bree_sasha.rpy:528
translate russian home_harem_preg_talk_f23e5ae8:
    "Я перевожу взгляд с одной девушки на другую: [lssb_homepair.bree_name()], Саша... Всё ещё не понимаю, что здесь происходит."

# ch/harems/home/events/home_harem_bree_sasha.rpy:530
translate russian home_harem_preg_talk_7d7d58fa:
    sasha.say "Так что, [lssb_common.hero_name()], кто прав?"

# ch/harems/home/events/home_harem_bree_sasha.rpy:533
translate russian home_harem_preg_talk_5454c616:
    bree.say "Да, кто из нас тебя разгадал?"

# ch/harems/home/events/home_harem_bree_sasha.rpy:535
translate russian home_harem_preg_talk_278dec5b:
    mike.say "Подождите... дайте разобраться."

# ch/harems/home/events/home_harem_bree_sasha.rpy:536
translate russian home_harem_preg_talk_76585948:
    mike.say "Вы сидели здесь и обсуждали, как я предпочитаю узнавать новости?"

# ch/harems/home/events/home_harem_bree_sasha.rpy:537
translate russian home_harem_preg_talk_8fe27b5a:
    mike.say "А теперь хотите, чтобы я разрешил ваш спор?"

# ch/harems/home/events/home_harem_bree_sasha.rpy:538
translate russian home_harem_preg_talk_763bfddd:
    "[lssb_homepair.bree_name()] и Саша быстро переглядываются, а затем дружно кивают."

# ch/harems/home/events/home_harem_bree_sasha.rpy:539
translate russian home_harem_preg_talk_1d97f309:
    mike.say "Можно и мне кое-что спросить?"

# ch/harems/home/events/home_harem_bree_sasha.rpy:540
translate russian home_harem_preg_talk_1b38597c:
    mike.say "Что в этом такого важного?"

# ch/harems/home/events/home_harem_bree_sasha.rpy:541
translate russian home_harem_preg_talk_8b27e95e:
    "[lssb_homepair.bree_name()] снова улыбается, как никогда невинно и безобидно."

# ch/harems/home/events/home_harem_bree_sasha.rpy:543
translate russian home_harem_preg_talk_b12ed7fc:
    bree.say "Ой, [lssb_common.hero_name()], не глупи!"

# ch/harems/home/events/home_harem_bree_sasha.rpy:544
translate russian home_harem_preg_talk_bbd8ec6b:
    bree.say "Ничего особо важного."

# ch/harems/home/events/home_harem_bree_sasha.rpy:546
translate russian home_harem_preg_talk_53223f29:
    mike.say "Тогда зачем вы..."

# ch/harems/home/events/home_harem_bree_sasha.rpy:547
translate russian home_harem_preg_talk_39011b71:
    mike.say "К чему все эти вопросы?!"

# ch/harems/home/events/home_harem_bree_sasha.rpy:550
translate russian home_harem_preg_talk_7b93e845:
    "Саша смеётся над раздражением в моём голосе, и я резко поворачиваюсь к ней."

# ch/harems/home/events/home_harem_bree_sasha.rpy:553
translate russian home_harem_preg_talk_3984f492:
    sasha.say "Да расслабься, [lssb_common.hero_name()]!"

# ch/harems/home/events/home_harem_bree_sasha.rpy:554
translate russian home_harem_preg_talk_7c1538d0:
    sasha.say "Мы просто решили, что лучше сначала немного тебя отвлечь."

# ch/harems/home/events/home_harem_bree_sasha.rpy:555
translate russian home_harem_preg_talk_838f5b9c:
    sasha.say "А не сразу объявлять, что мы обе беременны!"

# ch/harems/home/events/home_harem_bree_sasha.rpy:557
translate russian home_harem_preg_talk_32bfd1c2:
    "Из-за всей путаницы, которую девушки старательно устроили, я не сразу понимаю услышанное."

# ch/harems/home/events/home_harem_bree_sasha.rpy:558
translate russian home_harem_preg_talk_34c8096b:
    "Я продолжаю смотреть туда, где стоят Саша и [lssb_homepair.bree_name()], словно жду продолжения."

# ch/harems/home/events/home_harem_bree_sasha.rpy:560
translate russian home_harem_preg_talk_6815a611:
    bree.say "[lssb_common.hero_name()]..."

# ch/harems/home/events/home_harem_bree_sasha.rpy:561
translate russian home_harem_preg_talk_63091e5d:
    bree.say "Ты не слышал, что сказала Саша?"

# ch/harems/home/events/home_harem_bree_sasha.rpy:564
translate russian home_harem_preg_talk_cd79d28a:
    sasha.say "[lssb_common.hero_name()], приём! Обе твои девушки залетели!"

# ch/harems/home/events/home_harem_bree_sasha.rpy:566
translate russian home_harem_preg_talk_19cfde50:
    "Вот ведь милая: сразу понятно, почему песни из них двоих пишет Саша..."

# ch/harems/home/events/home_harem_bree_sasha.rpy:568
translate russian home_harem_preg_talk_297f62db:
    mike.say "Что..."

# ch/harems/home/events/home_harem_bree_sasha.rpy:569
translate russian home_harem_preg_talk_7ffcb4fe:
    mike.say "То есть вы..."

# ch/harems/home/events/home_harem_bree_sasha.rpy:571
translate russian home_harem_preg_talk_21d5a0b8:
    sasha.say "Да и да."

# ch/harems/home/events/home_harem_bree_sasha.rpy:574
translate russian home_harem_preg_talk_7ca19e6d:
    bree.say "Мы серьёзно, [lssb_common.hero_name()]."

# ch/harems/home/events/home_harem_bree_sasha.rpy:575
translate russian home_harem_preg_talk_2e496867:
    bree.say "Ты станешь папой — дважды!"

# ch/harems/home/events/home_harem_bree_sasha.rpy:577
translate russian home_harem_preg_talk_7670a97d:
    "Я не знаю, что сказать, поэтому для разнообразия молчу."

# ch/harems/home/events/home_harem_bree_sasha.rpy:578
translate russian home_harem_preg_talk_40585788:
    "В голове стремительно проносится всё, что означает услышанное и как оно изменит жизнь нас троих."

# ch/harems/home/events/home_harem_bree_sasha.rpy:579
translate russian home_harem_preg_talk_008feadb:
    "И я ещё сильнее чувствую себя той антилопой гну — загнанной в угол и беспомощной перед неизбежной судьбой!"

# ch/harems/home/events/home_harem_bree_sasha.rpy:581
translate russian home_harem_preg_talk_90325a72:
    bree.say "[lssb_common.hero_name()], ты нормально себя чувствуешь?"

# ch/harems/home/events/home_harem_bree_sasha.rpy:584
translate russian home_harem_preg_talk_9f2abbc5:
    sasha.say "Да, вид у тебя неважный!"

# ch/harems/home/events/home_harem_bree_sasha.rpy:586
translate russian home_harem_preg_talk_f5608628:
    mike.say "Я... со мной всё будет хорошо."

# ch/harems/home/events/home_harem_bree_sasha.rpy:587
translate russian home_harem_preg_talk_15aa6fb9:
    mike.say "Просто нужно столько всего осмыслить, понимаете?"

# ch/harems/home/events/home_harem_bree_sasha.rpy:590
translate russian home_harem_preg_talk_690fedbe:
    "[lssb_homepair.bree_name()] и Саша кивают, подходят ближе и обнимают меня, стараясь поддержать."

# ch/harems/home/events/home_harem_bree_sasha.rpy:591
translate russian home_harem_preg_talk_538fda76:
    "И знаете что?"

# ch/harems/home/events/home_harem_bree_sasha.rpy:592
translate russian home_harem_preg_talk_9837e77c:
    "Как только они это делают, я почти уверен, что так и будет. Всё будет хорошо."

# ch/harems/home/events/home_harem_bree_sasha.rpy:593
translate russian home_harem_preg_talk_e489ca2c:
    "Нас трое."

# ch/harems/home/events/home_harem_bree_sasha.rpy:594
translate russian home_harem_preg_talk_da593ded:
    "Их двое."

# ch/harems/home/events/home_harem_bree_sasha.rpy:595
translate russian home_harem_preg_talk_73f96ae8:
    "А любви хватит с избытком на всех."

# ch/harems/home/events/home_harem_bree_sasha.rpy:596
translate russian home_harem_preg_talk_18f37a0d:
    "Простите, если звучит слишком сентиментально, но я только что узнал, что стану отцом."

# ch/harems/home/events/home_harem_bree_sasha.rpy:597
translate russian home_harem_preg_talk_40ab71ec:
    "А такая новость может пробрать мужчину до глубины души!"

# ch/harems/home/events/home_harem_bree_sasha.rpy:604
translate russian bree_sasha_showdown_c91e5064:
    "В очередной ленивый день я бездельничаю в гостиной: развалился на диване и бездумно смотрю в телевизор."

# ch/harems/home/events/home_harem_bree_sasha.rpy:605
translate russian bree_sasha_showdown_7f2718ee:
    "Девушки чем-то заняты. В последний раз я видел, как [lssb_homepair.bree_name()] заходила к Саше в комнату, а они о чём-то перешёптывались."

# ch/harems/home/events/home_harem_bree_sasha.rpy:606
translate russian bree_sasha_showdown_623f35c6:
    "Я рад, что они ладят: такие разные, но, похоже, вполне нравятся друг другу."

# ch/harems/home/events/home_harem_bree_sasha.rpy:607
translate russian bree_sasha_showdown_17fc2836:
    "Я уже снова начинаю рассеянно смотреть в телевизор, когда слышу, как открывается дверь и приближаются две пары шагов."

# ch/harems/home/events/home_harem_bree_sasha.rpy:611
translate russian bree_sasha_showdown_0220f88d:
    "Радуясь компании, я поворачиваюсь: в комнату входят Саша и [lssb_homepair.bree_name()]. Но сразу понимаю, что здесь что-то очень, очень не так."

# ch/harems/home/events/home_harem_bree_sasha.rpy:612
translate russian bree_sasha_showdown_24b50f78:
    "Саша в ярости: её явно что-то или кто-то сильно расстроил. А [lssb_homepair.bree_name()] совершенно разбита, глаза красные — сразу видно, что только перестала плакать."

# ch/harems/home/events/home_harem_bree_sasha.rpy:613
translate russian bree_sasha_showdown_25110210:
    "Я мгновенно напрягаюсь, встаю и перевожу взгляд с одной на другую, гадая, что за разговор мог их так потрясти."

# ch/harems/home/events/home_harem_bree_sasha.rpy:614
translate russian bree_sasha_showdown_3285dae3:
    mike.say "Что? Что случилось?"

# ch/harems/home/events/home_harem_bree_sasha.rpy:616
translate russian bree_sasha_showdown_5a7a5d2c:
    "Сашин взгляд пугает, и ещё до того, как она открывает рот, я понимаю, почему они пришли выяснять отношения."

# ch/harems/home/events/home_harem_bree_sasha.rpy:618
translate russian bree_sasha_showdown_d92a20b2:
    sasha.say "Какого чёрта ты решил, что это сойдёт тебе с рук?"

# ch/harems/home/events/home_harem_bree_sasha.rpy:620
translate russian bree_sasha_showdown_e05fd6e2:
    mike.say "Что? Что сойдёт с рук?"

# ch/harems/home/events/home_harem_bree_sasha.rpy:621
translate russian bree_sasha_showdown_69ba1978:
    "Я притворяюсь, что ничего не понимаю, отчаянно надеясь, что ошибся."

# ch/harems/home/events/home_harem_bree_sasha.rpy:623
translate russian bree_sasha_showdown_5e71f6c8:
    bree.say "Пожалуйста, не ври. Хватит врать."

# ch/harems/home/events/home_harem_bree_sasha.rpy:625
translate russian bree_sasha_showdown_a1bb2504:
    "По голосу слышно, что она снова вот-вот расплачется, и она почти прикусывает губу, чтобы сдержаться."

# ch/harems/home/events/home_harem_bree_sasha.rpy:627
translate russian bree_sasha_showdown_15797c40:
    sasha.say "Ты спишь с нами ОБЕИМИ?"

# ch/harems/home/events/home_harem_bree_sasha.rpy:628
translate russian bree_sasha_showdown_ff242ffa:
    sasha.say "Мы живём вместе, гений! Или ты забыл?"

# ch/harems/home/events/home_harem_bree_sasha.rpy:629
translate russian bree_sasha_showdown_32645272:
    sasha.say "Конечно, мы бы всё поняли."

# ch/harems/home/events/home_harem_bree_sasha.rpy:631
translate russian bree_sasha_showdown_88af71bf:
    mike.say "А. Это."

# ch/harems/home/events/home_harem_bree_sasha.rpy:633
translate russian bree_sasha_showdown_274c53da:
    sasha.say "Да, «ЭТО»! Ты вообще о чём, блядь, думал?"

# ch/harems/home/events/home_harem_bree_sasha.rpy:638
translate russian bree_sasha_showdown_8c8fa374:
    sasha.say "Ты ещё и нас обеих обрюхатил, придурок!"

# ch/harems/home/events/home_harem_bree_sasha.rpy:641
translate russian bree_sasha_showdown_1017be27:
    "[lssb_homepair.bree_name()] смотрит на меня, и её глаза наполняются слезами."

# ch/harems/home/events/home_harem_bree_sasha.rpy:644
translate russian bree_sasha_showdown_cb83ff3c:
    sasha.say "Ты ещё и меня обрюхатил, придурок!"

# ch/harems/home/events/home_harem_bree_sasha.rpy:647
translate russian bree_sasha_showdown_1017be27_1:
    "[lssb_homepair.bree_name()] смотрит на меня, и её глаза наполняются слезами."

# ch/harems/home/events/home_harem_bree_sasha.rpy:650
translate russian bree_sasha_showdown_bc552fd7:
    sasha.say "Ты ещё и сделал так, что [lssb_homepair.bree_name()] беременна, придурок!"

# ch/harems/home/events/home_harem_bree_sasha.rpy:653
translate russian bree_sasha_showdown_1017be27_2:
    "[lssb_homepair.bree_name()] смотрит на меня, и её глаза наполняются слезами."

# ch/harems/home/events/home_harem_bree_sasha.rpy:656
translate russian bree_sasha_showdown_16053943:
    "Я замечаю, как Саша перебирает пальцами ошейник на шее, и на её лице появляется задумчивое выражение."

# ch/harems/home/events/home_harem_bree_sasha.rpy:658
translate russian bree_sasha_showdown_a36d4b9c:
    sasha.say "Знаешь, [lssb_homepair.bree_name()], если подумать, весь этот спор довольно глупый!"

# ch/harems/home/events/home_harem_bree_sasha.rpy:661
translate russian bree_sasha_showdown_4d971c45:
    "[lssb_homepair.bree_name()] морщит нос, словно не понимая, что та имеет в виду."

# ch/harems/home/events/home_harem_bree_sasha.rpy:663
translate russian bree_sasha_showdown_50d3b1d5:
    bree.say "А?.. В смысле?"

# ch/harems/home/events/home_harem_bree_sasha.rpy:666
translate russian bree_sasha_showdown_76c249ca:
    sasha.say "Ну а почему мы вообще обсуждаем, с кем [lssb_common.hero_name()] решает заниматься сексом?"

# ch/harems/home/events/home_harem_bree_sasha.rpy:667
translate russian bree_sasha_showdown_6d430b5c:
    sasha.say "Разве мы обе не согласились носить эти ошейники в знак того, что он наш Господин?"

# ch/harems/home/events/home_harem_bree_sasha.rpy:670
translate russian bree_sasha_showdown_d23651a1:
    "Теперь [lssb_homepair.bree_name()] тоже задумчиво опускает взгляд на собственный ошейник."

# ch/harems/home/events/home_harem_bree_sasha.rpy:672
translate russian bree_sasha_showdown_97b6f633:
    bree.say "Наверное... да..."

# ch/harems/home/events/home_harem_bree_sasha.rpy:675
translate russian bree_sasha_showdown_0fe9b387:
    sasha.say "Значит, мы не можем сами выбирать, когда он Господин, а когда нет, верно?"

# ch/harems/home/events/home_harem_bree_sasha.rpy:676
translate russian bree_sasha_showdown_e428de06:
    sasha.say "Он либо наш Господин, либо нет."

# ch/harems/home/events/home_harem_bree_sasha.rpy:679
translate russian bree_sasha_showdown_f68732f2:
    "[lssb_homepair.bree_name()] медленно кивает, начиная понимать логику Саши."

# ch/harems/home/events/home_harem_bree_sasha.rpy:681
translate russian bree_sasha_showdown_5406b4cd:
    bree.say "Ты права, Саша."

# ch/harems/home/events/home_harem_bree_sasha.rpy:682
translate russian bree_sasha_showdown_07a0fda8:
    bree.say "Нам не стоит злиться из-за того, как поступает [lssb_common.hero_name()]."

# ch/harems/home/events/home_harem_bree_sasha.rpy:684
translate russian bree_sasha_showdown_25ffb82b:
    bree.say "Надо радоваться, что он вообще по-прежнему держит нас своими рабынями!"

# ch/harems/home/events/home_harem_bree_sasha.rpy:686
translate russian bree_sasha_showdown_efe1d015:
    "Часть меня просто не может поверить услышанному."

# ch/harems/home/events/home_harem_bree_sasha.rpy:687
translate russian bree_sasha_showdown_ff1ec913:
    "Мне не пришлось произнести ни слова: [lssb_homepair.bree_name()] и Саша сами во всём разобрались прямо передо мной."

# ch/harems/home/events/home_harem_bree_sasha.rpy:688
translate russian bree_sasha_showdown_cd41ba06:
    "И не только разобрались, но и пришли именно к тому выводу, на который я мог надеяться!"

# ch/harems/home/events/home_harem_bree_sasha.rpy:689
translate russian bree_sasha_showdown_db88017a:
    "Я не успеваю ничего сказать, а они уже поворачиваются ко мне с широкими улыбками."

# ch/harems/home/events/home_harem_bree_sasha.rpy:692
translate russian bree_sasha_showdown_c57c1405:
    sasha.say "Прости, что тебе пришлось всё это выслушать, [lssb_common.hero_name()]."

# ch/harems/home/events/home_harem_bree_sasha.rpy:693
translate russian bree_sasha_showdown_773ffd30:
    bree.say "Правда, ПРОСТИ!"

# ch/harems/home/events/home_harem_bree_sasha.rpy:694
translate russian bree_sasha_showdown_9d5fa960:
    sasha.say "Конечно, у тебя может быть столько девушек, сколько захочешь."

# ch/harems/home/events/home_harem_bree_sasha.rpy:695
translate russian bree_sasha_showdown_3c5be766:
    bree.say "Да, сколько угодно."

# ch/harems/home/events/home_harem_bree_sasha.rpy:696
translate russian bree_sasha_showdown_b3920610:
    bree.say "Только, пожалуйста, не забывай о нас, когда будешь развлекаться!"

# ch/harems/home/events/home_harem_bree_sasha.rpy:700
translate russian bree_sasha_showdown_c6479d84:
    sasha.say "Я понимаю, как странно это прозвучит, учитывая наши отношения со всей группой."

# ch/harems/home/events/home_harem_bree_sasha.rpy:701
translate russian bree_sasha_showdown_7151c936:
    sasha.say "Но я больше не могу впускать новых людей в свою личную жизнь!"

# ch/harems/home/events/home_harem_bree_sasha.rpy:703
translate russian bree_sasha_showdown_ddbfc9d5:
    "Саша качает головой, удивляясь странному повороту разговора."

# ch/harems/home/events/home_harem_bree_sasha.rpy:705
translate russian bree_sasha_showdown_e42229eb:
    sasha.say "Ты и так знаешь, как тяжело мне было смириться с тем, что я делю тебя с ещё двумя девушками."

# ch/harems/home/events/home_harem_bree_sasha.rpy:706
translate russian bree_sasha_showdown_e3fd6390:
    sasha.say "Если их станет трое, я не выдержу."

# ch/harems/home/events/home_harem_bree_sasha.rpy:708
translate russian bree_sasha_showdown_0057c616:
    "Я киваю: мне не нравится услышанное, но я всё же могу понять Сашу."

# ch/harems/home/events/home_harem_bree_sasha.rpy:710
translate russian bree_sasha_showdown_ffa2d27b:
    bree.say "Подожди. Значит, ты против того, чтобы [lssb_common.hero_name()] был ещё и со мной."

# ch/harems/home/events/home_harem_bree_sasha.rpy:711
translate russian bree_sasha_showdown_b90265e1:
    bree.say "А вот чтобы его по очереди трахали твои замызганные подружки из группы — это нормально?!"

# ch/harems/home/events/home_harem_bree_sasha.rpy:713
translate russian bree_sasha_showdown_6f083e82:
    mike.say "[lssb_homepair.bree_name()], уверен, она совсем не это имеет в виду."

# ch/harems/home/events/home_harem_bree_sasha.rpy:714
translate russian bree_sasha_showdown_90735e5d:
    mike.say "Правда, Саша?"

# ch/harems/home/events/home_harem_bree_sasha.rpy:716
translate russian bree_sasha_showdown_28a977f4:
    "От слов об Анне и Клео Саша ощетинивается. [lssb_homepair.bree_name()] встречает её испепеляющий взгляд."

# ch/harems/home/events/home_harem_bree_sasha.rpy:718
translate russian bree_sasha_showdown_ffda7bb3:
    sasha.say "Она знает, что я имела в виду, [lssb_common.hero_name()]."

# ch/harems/home/events/home_harem_bree_sasha.rpy:719
translate russian bree_sasha_showdown_a44a1078:
    sasha.say "Девушки из группы мне как сёстры."

# ch/harems/home/events/home_harem_bree_sasha.rpy:720
translate russian bree_sasha_showdown_ba1ada58:
    sasha.say "Когда мы приняли тебя в группу, ты стал нам как... ну, наверное, тоже как брат."

# ch/harems/home/events/home_harem_bree_sasha.rpy:723
translate russian bree_sasha_showdown_650d1b77:
    "[lssb_homepair.bree_name()] скрещивает руки и бросает на Сашу исключительно злой взгляд."

# ch/harems/home/events/home_harem_bree_sasha.rpy:725
translate russian bree_sasha_showdown_907fb7f2:
    bree.say "То есть ваша маленькая связь — что-то вроде инцеста?"

# ch/harems/home/events/home_harem_bree_sasha.rpy:728
translate russian bree_sasha_showdown_40a5df18:
    "На миг кажется, что Саша сейчас ответит в том же духе."

# ch/harems/home/events/home_harem_bree_sasha.rpy:729
translate russian bree_sasha_showdown_87689e9a:
    "Но вместо этого она отмахивается и саркастически усмехается. [lssb_homepair.bree_name()] прекрасно видит эту ухмылку."

# ch/harems/home/events/home_harem_bree_sasha.rpy:731
translate russian bree_sasha_showdown_682ba9b4:
    sasha.say "Знаешь что? Я не обязана это выслушивать."

# ch/harems/home/events/home_harem_bree_sasha.rpy:732
translate russian bree_sasha_showdown_1a6e65c8:
    sasha.say "Да кто ты вообще такая, [lssb_homepair.bree_name()]?"

# ch/harems/home/events/home_harem_bree_sasha.rpy:733
translate russian bree_sasha_showdown_2ef78d8e:
    sasha.say "Просто какая-то белобрысая сучка, которой случилось жить со мной под одной крышей."

# ch/harems/home/events/home_harem_bree_sasha.rpy:736
translate russian bree_sasha_showdown_79e13483:
    "[lssb_homepair.bree_name()] явно взбешена оскорблением, но Саша обрывает её прежде, чем та успевает ответить тем же."

# ch/harems/home/events/home_harem_bree_sasha.rpy:738
translate russian bree_sasha_showdown_7c7e42b4:
    sasha.say "Я объясню предельно просто, [lssb_common.hero_name()]."

# ch/harems/home/events/home_harem_bree_sasha.rpy:739
translate russian bree_sasha_showdown_99fd691a:
    sasha.say "Либо я и девушки из группы, либо она."

# ch/harems/home/events/home_harem_bree_sasha.rpy:741
translate russian bree_sasha_showdown_996af3fc:
    "Она кивает туда, где стоит [lssb_homepair.bree_name()]."

# ch/harems/home/events/home_harem_bree_sasha.rpy:743
translate russian bree_sasha_showdown_d24b1e4a:
    sasha.say "Так что выбирай. В любом случае кому-то придётся уйти!"

# ch/harems/home/events/home_harem_bree_sasha.rpy:747
translate russian bree_sasha_showdown_99924163:
    mike.say "Прости, Саша."

# ch/harems/home/events/home_harem_bree_sasha.rpy:748
translate russian bree_sasha_showdown_b9c6acb3:
    mike.say "Наверное, это звучит безумно, но если нужно выбирать, мой выбор — [lssb_homepair.bree_name()]."

# ch/harems/home/events/home_harem_bree_sasha.rpy:751
translate russian bree_sasha_showdown_4d5da318:
    "У Саши буквально отвисает челюсть, словно она не верит своим ушам."

# ch/harems/home/events/home_harem_bree_sasha.rpy:752
translate russian bree_sasha_showdown_46ef16d0:
    "А [lssb_homepair.bree_name()], вполне предсказуемо, откровенно торжествует."

# ch/harems/home/events/home_harem_bree_sasha.rpy:753
translate russian bree_sasha_showdown_9bdf634e:
    "Пожалуй, всё уже стало слишком личным, чтобы кто-то сохранял вежливость."

# ch/harems/home/events/home_harem_bree_sasha.rpy:756
translate russian bree_sasha_showdown_5d7e9f5c:
    bree.say "Ну вот, Саша, ты получила ответ!"

# ch/harems/home/events/home_harem_bree_sasha.rpy:757
translate russian bree_sasha_showdown_e48a906e:
    bree.say "Видимо, [lssb_common.hero_name()] любит меня втрое сильнее, чем тебя!"

# ch/harems/home/events/home_harem_bree_sasha.rpy:760
translate russian bree_sasha_showdown_4c10f82a:
    sasha.say "Но... как же всё, что мы пережили с группой?"

# ch/harems/home/events/home_harem_bree_sasha.rpy:761
translate russian bree_sasha_showdown_25510014:
    sasha.say "Как же наша близость с Анной и Клео?"

# ch/harems/home/events/home_harem_bree_sasha.rpy:763
translate russian bree_sasha_showdown_5e099741:
    "Она на миг замолкает, выглядит по-настоящему убитой горем и добавляет последнее."

# ch/harems/home/events/home_harem_bree_sasha.rpy:765
translate russian bree_sasha_showdown_aea394d9:
    sasha.say "А как же... как же всё, что было только между нами?"

# ch/harems/home/events/home_harem_bree_sasha.rpy:767
translate russian bree_sasha_showdown_342d4bb9:
    "Я открываю рот, пытаясь подобрать слова, которые хоть немного смягчат происходящее."

# ch/harems/home/events/home_harem_bree_sasha.rpy:768
translate russian bree_sasha_showdown_24b4eaab:
    "Но [lssb_homepair.bree_name()] перебивает меня раньше, чем я успеваю произнести хоть слово."

# ch/harems/home/events/home_harem_bree_sasha.rpy:770
translate russian bree_sasha_showdown_0f320981:
    bree.say "Ой, ну хватит, Саша!"

# ch/harems/home/events/home_harem_bree_sasha.rpy:771
translate russian bree_sasha_showdown_7ded5de9:
    bree.say "[lssb_common.hero_name()] уже сказал, с кем хочет быть."

# ch/harems/home/events/home_harem_bree_sasha.rpy:772
translate russian bree_sasha_showdown_4c6066cb:
    bree.say "Хватит пускать слёзы и строить из себя жертву!"

# ch/harems/home/events/home_harem_bree_sasha.rpy:775
translate russian bree_sasha_showdown_543b6d5a:
    "Кажется, Саша вот-вот ответит такой же ядовитой тирадой, и [lssb_homepair.bree_name()] её получит сполна."

# ch/harems/home/events/home_harem_bree_sasha.rpy:777
translate russian bree_sasha_showdown_74dace41:
    "Но затем внутри неё словно что-то ломается, и щёки вспыхивают от нахлынувших чувств."

# ch/harems/home/events/home_harem_bree_sasha.rpy:779
translate russian bree_sasha_showdown_308d9f41:
    "Она прикрывает рот рукой, возможно сдерживая настоящий всхлип, и убегает."

# ch/harems/home/events/home_harem_bree_sasha.rpy:781
translate russian bree_sasha_showdown_1842c937:
    "[lssb_homepair.bree_name()] обхватывает мою руку и улыбается вслед уходящей сопернице."

# ch/harems/home/events/home_harem_bree_sasha.rpy:782
translate russian bree_sasha_showdown_45f4fdd4:
    "Я могу лишь смотреть ей вслед и гадать, правильно ли поступил."

# ch/harems/home/events/home_harem_bree_sasha.rpy:789
translate russian bree_sasha_showdown_457cf6b4:
    mike.say "Прости, [lssb_homepair.bree_name()]."

# ch/harems/home/events/home_harem_bree_sasha.rpy:790
translate russian bree_sasha_showdown_52a0b22a:
    mike.say "Но если нужно выбирать, я выбираю группу."

# ch/harems/home/events/home_harem_bree_sasha.rpy:792
translate russian bree_sasha_showdown_ef2ccba0:
    "[lssb_homepair.bree_name()] издаёт звук полного отвращения и качает головой."

# ch/harems/home/events/home_harem_bree_sasha.rpy:794
translate russian bree_sasha_showdown_3b0b4518:
    bree.say "Господи, [lssb_common.hero_name()], лучше бы я узнала, какой ты извращенец, ДО того, как мы начали встречаться!"

# ch/harems/home/events/home_harem_bree_sasha.rpy:795
translate russian bree_sasha_showdown_26753f7d:
    bree.say "Тебе бы футболку с такой надписью."

# ch/harems/home/events/home_harem_bree_sasha.rpy:796
translate russian bree_sasha_showdown_040f1be3:
    bree.say "Или табличку на шею повесить. Тебе тоже, Саша!"

# ch/harems/home/events/home_harem_bree_sasha.rpy:800
translate russian bree_sasha_showdown_35467189:
    "Я чувствую, как Саша берёт меня под руку и прижимается ко мне."

# ch/harems/home/events/home_harem_bree_sasha.rpy:801
translate russian bree_sasha_showdown_2aec2f60:
    "Я понимаю, что этим она хочет показать, что [lssb_homepair.bree_name()] её не запугает, но ощущать её поддержку всё равно приятно."

# ch/harems/home/events/home_harem_bree_sasha.rpy:802
translate russian bree_sasha_showdown_f8ef17cd:
    mike.say "Дело не только в сексе, [lssb_homepair.bree_name()]."

# ch/harems/home/events/home_harem_bree_sasha.rpy:803
translate russian bree_sasha_showdown_9edbba35:
    mike.say "Но, наверное, чтобы это понять, нужно быть творческим человеком."

# ch/harems/home/events/home_harem_bree_sasha.rpy:804
translate russian bree_sasha_showdown_d5d1b190:
    "[lssb_homepair.bree_name()] насмешливо фыркает; на лице смешались раздражение и веселье."

# ch/harems/home/events/home_harem_bree_sasha.rpy:806
translate russian bree_sasha_showdown_bbee4f5a:
    sasha.say "Он прав, [lssb_homepair.bree_name()]."

# ch/harems/home/events/home_harem_bree_sasha.rpy:807
translate russian bree_sasha_showdown_32db9c7b:
    sasha.say "Но поверь, секс у нас тоже просто крышесносный!"

# ch/harems/home/events/home_harem_bree_sasha.rpy:808
translate russian bree_sasha_showdown_f931c304:
    sasha.say "Наверное, нужно быть достаточно зрелой, чтобы уметь делиться..."

# ch/harems/home/events/home_harem_bree_sasha.rpy:811
translate russian bree_sasha_showdown_95d55bae:
    bree.say "Фу, можешь приукрашивать как угодно, Саша."

# ch/harems/home/events/home_harem_bree_sasha.rpy:812
translate russian bree_sasha_showdown_99c9c35e:
    bree.say "Но правда в том, что вы просто кучка грязных вырожденцев."

# ch/harems/home/events/home_harem_bree_sasha.rpy:813
translate russian bree_sasha_showdown_862e1d83:
    bree.say "И я не собираюсь дышать с вами одним воздухом!"

# ch/harems/home/events/home_harem_bree_sasha.rpy:815
translate russian bree_sasha_showdown_e4d27399:
    "С этими словами она поворачивается к нам спиной и в ярости уходит."

# ch/harems/home/events/home_harem_bree_sasha.rpy:817
translate russian bree_sasha_showdown_b89d485c:
    "Пока [lssb_homepair.bree_name()] уходит, я чувствую, как Саша крепче сжимает мою руку."

# ch/harems/home/events/home_harem_bree_sasha.rpy:819
translate russian bree_sasha_showdown_07be452e:
    sasha.say "Не переживай из-за неё, [lssb_common.hero_name()]."

# ch/harems/home/events/home_harem_bree_sasha.rpy:820
translate russian bree_sasha_showdown_20c44c6c:
    sasha.say "И не слушай ни слова из того, что она сказала."

# ch/harems/home/events/home_harem_bree_sasha.rpy:821
translate russian bree_sasha_showdown_68993896:
    sasha.say "Между нами есть то, чего такие, как она, никогда не поймут."

# ch/harems/home/events/home_harem_bree_sasha.rpy:822
translate russian bree_sasha_showdown_f20e036c:
    sasha.say "Если уж на то пошло, её стоит пожалеть!"

# ch/harems/home/events/home_harem_bree_sasha.rpy:824
translate russian bree_sasha_showdown_0bf91f81:
    "Я киваю, глядя, как [lssb_homepair.bree_name()] уходит, и надеюсь, что на этот раз сделал правильный выбор."

# ch/harems/home/events/home_harem_bree_sasha.rpy:828
translate russian bree_sasha_showdown_044b3aa5:
    mike.say "Простите. Мне стоило сказать."

# ch/harems/home/events/home_harem_bree_sasha.rpy:829
translate russian bree_sasha_showdown_1fc3646a:
    mike.say "Просто вы мне обе нравитесь."

# ch/harems/home/events/home_harem_bree_sasha.rpy:830
translate russian bree_sasha_showdown_f5bbc0a4:
    mike.say "Я думал, что со временем смогу определиться, но чем больше времени проводил с вами обеими, тем труднее было порвать с одной и..."

# ch/harems/home/events/home_harem_bree_sasha.rpy:832
translate russian bree_sasha_showdown_2720dc4a:
    bree.say "Надо было просто сказать."

# ch/harems/home/events/home_harem_bree_sasha.rpy:833
translate russian bree_sasha_showdown_18756b6c:
    bree.say "У тебя только мы?"

# ch/harems/home/events/home_harem_bree_sasha.rpy:837
translate russian bree_sasha_showdown_b1adced4:
    mike.say "Да! Конечно, только вы."

# ch/harems/home/events/home_harem_bree_sasha.rpy:838
translate russian bree_sasha_showdown_245408c6:
    mike.say "Я же не трахаю всё, что вижу."

# ch/harems/home/events/home_harem_bree_sasha.rpy:841
translate russian bree_sasha_showdown_4ad4d1be:
    sasha.say "А как же группа?"

# ch/harems/home/events/home_harem_bree_sasha.rpy:846
translate russian bree_sasha_showdown_83466078:
    sasha.say "Ну же..."

# ch/harems/home/events/home_harem_bree_sasha.rpy:848
translate russian bree_sasha_showdown_36736a70:
    sasha.say "О да, им было что о тебе рассказать."

# ch/harems/home/events/home_harem_bree_sasha.rpy:850
translate russian bree_sasha_showdown_307a29b7:
    mike.say "Я... точно, ещё группа."

# ch/harems/home/events/home_harem_bree_sasha.rpy:852
translate russian bree_sasha_showdown_01474be0:
    bree.say "Нельзя продолжать врать о таких вещах."

# ch/harems/home/events/home_harem_bree_sasha.rpy:854
translate russian bree_sasha_showdown_844b847c:
    mike.say "Я знаю, просто..."

# ch/harems/home/events/home_harem_bree_sasha.rpy:858
translate russian bree_sasha_showdown_0cc8d7f3:
    sasha.say "А как же [g]?"

# ch/harems/home/events/home_harem_bree_sasha.rpy:861
translate russian bree_sasha_showdown_4d5b045a:
    mike.say "Я... точно, [g]."

# ch/harems/home/events/home_harem_bree_sasha.rpy:863
translate russian bree_sasha_showdown_01474be0_1:
    bree.say "Нельзя продолжать врать о таких вещах."

# ch/harems/home/events/home_harem_bree_sasha.rpy:865
translate russian bree_sasha_showdown_844b847c_1:
    mike.say "Я знаю, просто..."

# ch/harems/home/events/home_harem_bree_sasha.rpy:869
translate russian bree_sasha_showdown_2364fa92:
    bree.say "А как же [g]?"

# ch/harems/home/events/home_harem_bree_sasha.rpy:873
translate russian bree_sasha_showdown_4d5b045a_1:
    mike.say "Я... точно, [g]."

# ch/harems/home/events/home_harem_bree_sasha.rpy:875
translate russian bree_sasha_showdown_9eb4485a:
    sasha.say "Чёртов шлюхан..."

# ch/harems/home/events/home_harem_bree_sasha.rpy:876
translate russian bree_sasha_showdown_844b847c_2:
    mike.say "Я знаю, просто..."

# ch/harems/home/events/home_harem_bree_sasha.rpy:879
translate russian bree_sasha_showdown_54854d3b:
    sasha.say "По тебе и не скажешь, козёл!"

# ch/harems/home/events/home_harem_bree_sasha.rpy:880
translate russian bree_sasha_showdown_e7a743ef:
    sasha.say "Как нам вообще верить хоть одному твоему слову?"

# ch/harems/home/events/home_harem_bree_sasha.rpy:882
translate russian bree_sasha_showdown_19c1acfc:
    mike.say "Не знаю. Правда не знаю."

# ch/harems/home/events/home_harem_bree_sasha.rpy:884
translate russian bree_sasha_showdown_62c822c8:
    mike.say "Вы... нет, не только вы."

# ch/harems/home/events/home_harem_bree_sasha.rpy:888
translate russian bree_sasha_showdown_26ffb562:
    sasha.say "Со сколькими людьми ты вообще трахаешься?"

# ch/harems/home/events/home_harem_bree_sasha.rpy:890
translate russian bree_sasha_showdown_4ef4f8cb:
    mike.say "Я..."

# ch/harems/home/events/home_harem_bree_sasha.rpy:892
translate russian bree_sasha_showdown_2d91bbeb:
    sasha.say "Не надо. Вообще-то, я не хочу знать."

# ch/harems/home/events/home_harem_bree_sasha.rpy:893
translate russian bree_sasha_showdown_2bcd54db:
    sasha.say "Если скажешь, меня, кажется, стошнит прямо на тебя."

# ch/harems/home/events/home_harem_bree_sasha.rpy:895
translate russian bree_sasha_showdown_a2fe887e:
    mike.say "Я облажался, знаю. Но я сделаю всё, чтобы загладить вину перед вами обеими."

# ch/harems/home/events/home_harem_bree_sasha.rpy:897
translate russian bree_sasha_showdown_9c7f1265:
    bree.say "Разбитое доверие нелегко восстановить."

# ch/harems/home/events/home_harem_bree_sasha.rpy:899
translate russian bree_sasha_showdown_24084416:
    mike.say "Знаю, но я постараюсь."

# ch/harems/home/events/home_harem_bree_sasha.rpy:900
translate russian bree_sasha_showdown_dc244588:
    mike.say "Я не жду, что вы меня простите. Даже не знаю, смогу ли сам себя простить. Только знайте: меньше всего я хотел причинить боль хоть одной из вас."

# ch/harems/home/events/home_harem_bree_sasha.rpy:902
translate russian bree_sasha_showdown_c25722f1:
    sasha.say "И ты с этим *прекрасно* справился, молодец."

# ch/harems/home/events/home_harem_bree_sasha.rpy:903
translate russian bree_sasha_showdown_0c9a6ca8:
    sasha.say "Правда, только посмотри, какие мы обе счастливые."

# ch/harems/home/events/home_harem_bree_sasha.rpy:905
translate russian bree_sasha_showdown_cab783da:
    "Она всё ещё явно в ярости, но, если я не выдаю желаемое за действительное, её слова стали чуть менее резкими."

# ch/harems/home/events/home_harem_bree_sasha.rpy:906
translate russian bree_sasha_showdown_a2c97fce:
    "В комнате повисает неловкая тишина. Я высказался и сделал всё, что мог. Теперь девушкам решать мою условную судьбу."

# ch/harems/home/events/home_harem_bree_sasha.rpy:908
translate russian bree_sasha_showdown_18d389b4:
    "Они некоторое время смотрят на меня. Взгляд Саши пугает, а [lssb_homepair.bree_name()] смотрит так жалобно, по-щенячьи, что почти больно."

# ch/harems/home/events/home_harem_bree_sasha.rpy:909
translate russian bree_sasha_showdown_ab5c3740:
    "Наконец тишина становится невыносимой, и я вынужден её нарушить."

# ch/harems/home/events/home_harem_bree_sasha.rpy:910
translate russian bree_sasha_showdown_e141901d:
    mike.say "И что теперь?"

# ch/harems/home/events/home_harem_bree_sasha.rpy:912
translate russian bree_sasha_showdown_521f6d64:
    sasha.say "Не знаю."

# ch/harems/home/events/home_harem_bree_sasha.rpy:915
translate russian bree_sasha_showdown_5aa06cec:
    bree.say "Я тоже."

# ch/harems/home/events/home_harem_bree_sasha.rpy:918
translate russian bree_sasha_showdown_304959d8:
    sasha.say "За такое мне стоит надрать тебе задницу."

# ch/harems/home/events/home_harem_bree_sasha.rpy:921
translate russian bree_sasha_showdown_dc7af905:
    bree.say "А мне — просто уйти."

# ch/harems/home/events/home_harem_bree_sasha.rpy:923
translate russian bree_sasha_showdown_68a82eee:
    mike.say "Да, и то и другое было бы справедливо."

# ch/harems/home/events/home_harem_bree_sasha.rpy:925
translate russian bree_sasha_showdown_72c7b092:
    sasha.say "Но..."

# ch/harems/home/events/home_harem_bree_sasha.rpy:926
translate russian bree_sasha_showdown_181c2c9b:
    sasha.say "Я не *хочу* никуда уходить."

# ch/harems/home/events/home_harem_bree_sasha.rpy:929
translate russian bree_sasha_showdown_c61739cf:
    bree.say "Ты сделал мне очень больно, [lssb_common.hero_name()]."

# ch/harems/home/events/home_harem_bree_sasha.rpy:930
translate russian bree_sasha_showdown_62986393:
    bree.say "Ты предал моё доверие, и на его восстановление уйдёт много времени."

# ch/harems/home/events/home_harem_bree_sasha.rpy:931
translate russian bree_sasha_showdown_dc36eee0:
    "Я серьёзно киваю, слушая их."

# ch/harems/home/events/home_harem_bree_sasha.rpy:932
translate russian bree_sasha_showdown_d5aebb79:
    bree.say "Но и уходить от тебя я не хочу."

# ch/harems/home/events/home_harem_bree_sasha.rpy:934
translate russian bree_sasha_showdown_a0791ea4:
    mike.say "Значит?.."

# ch/harems/home/events/home_harem_bree_sasha.rpy:936
translate russian bree_sasha_showdown_37991094:
    sasha.say "Похоже, тебе повезло, [lssb_common.hero_name()]."

# ch/harems/home/events/home_harem_bree_sasha.rpy:937
translate russian bree_sasha_showdown_e369c4ce:
    sasha.say "Ни одна из нас никуда не уйдёт. У тебя будет достаточно времени загладить вину."

# ch/harems/home/events/home_harem_bree_sasha.rpy:939
translate russian bree_sasha_showdown_157d80ba:
    bree.say "То есть мы просто будем его делить?"

# ch/harems/home/events/home_harem_bree_sasha.rpy:942
translate russian bree_sasha_showdown_71d44820:
    sasha.say "Почему нет? Похоже, мы и так уже это делали и были вполне счастливы."

# ch/harems/home/events/home_harem_bree_sasha.rpy:945
translate russian bree_sasha_showdown_4c22d323:
    bree.say "Ну да, конечно, но это же немного странно?"

# ch/harems/home/events/home_harem_bree_sasha.rpy:948
translate russian bree_sasha_showdown_4da844b3:
    sasha.say "Изменилось только то, что теперь мы честнее друг с другом."

# ch/harems/home/events/home_harem_bree_sasha.rpy:951
translate russian bree_sasha_showdown_bc8cf1f2:
    bree.say "Да-да! Ты права."

# ch/harems/home/events/home_harem_bree_sasha.rpy:953
translate russian bree_sasha_showdown_b10a57c4:
    "Кажется, от меня уже ничего не зависит: Саша легко убеждает её, и [lssb_homepair.bree_name()] принимает её сторону."

# ch/harems/home/events/home_harem_bree_sasha.rpy:954
translate russian bree_sasha_showdown_c5901648:
    "Впрочем, исход для меня неплохой, так что я просто держу рот на замке."

# ch/harems/home/events/home_harem_bree_sasha.rpy:956
translate russian bree_sasha_showdown_ac3111c1:
    sasha.say "Конечно, я права."

# ch/harems/home/events/home_harem_bree_sasha.rpy:957
translate russian bree_sasha_showdown_5c10150f:
    sasha.say "Итак, [lssb_common.hero_name()], похоже, ты получаешь второй шанс."

# ch/harems/home/events/home_harem_bree_sasha.rpy:960
translate russian bree_sasha_showdown_69d91e8e:
    bree.say "От нас обеих."

# ch/harems/home/events/home_harem_bree_sasha.rpy:963
translate russian bree_sasha_showdown_1e24c5a4:
    sasha.say "Если ещё раз посмеешь изменить хоть одной из нас, всё кончено навсегда. Тебе повезло, что ты такой обаятельный."

# ch/harems/home/events/home_harem_bree_sasha.rpy:965
translate russian bree_sasha_showdown_93839edc:
    mike.say "Хех, похоже на то."

# ch/harems/home/events/home_harem_bree_sasha.rpy:966
translate russian bree_sasha_showdown_b133be16:
    mike.say "Больше никогда, клянусь."

# ch/harems/home/events/home_harem_bree_sasha.rpy:968
translate russian bree_sasha_showdown_a7bb2c3a:
    bree.say "Хорошо! Но до того, как всё станет по-прежнему, тебе ещё многое предстоит сделать."

# ch/harems/home/events/home_harem_bree_sasha.rpy:971
translate russian bree_sasha_showdown_d16382f7:
    sasha.say "Ещё бы. Даже не знаю, как сильнее подчеркнуть, насколько тебе нужно загладить вину перед нами."

# ch/harems/home/events/home_harem_bree_sasha.rpy:973
translate russian bree_sasha_showdown_f1351df2:
    mike.say "Сделаю всё, что смогу."

# ch/harems/home/events/home_harem_bree_sasha.rpy:975
translate russian bree_sasha_showdown_b3b81ba1:
    sasha.say "Мы что-нибудь придумаем."

# ch/harems/home/events/home_harem_bree_sasha.rpy:976
translate russian bree_sasha_showdown_49eacee2:
    sasha.say "Вообще-то, прямо сейчас. [lssb_homepair.bree_name()], пойдём."

# ch/harems/home/events/home_harem_bree_sasha.rpy:979
translate russian bree_sasha_showdown_53b51d7e:
    bree.say "Сейчас? Ну, ладно!"

# ch/harems/home/events/home_harem_bree_sasha.rpy:981
translate russian bree_sasha_showdown_6c92f843:
    bree.say "Эм, я рада, что мы попробуем всё наладить, [lssb_common.hero_name()]."

# ch/harems/home/events/home_harem_bree_sasha.rpy:982
translate russian bree_sasha_showdown_947f117f:
    bree.say "Будет нелегко, но ты мне правда очень нравишься. Только, пожалуйста, больше так не делай."

# ch/harems/home/events/home_harem_bree_sasha.rpy:984
translate russian bree_sasha_showdown_4adb20ff:
    mike.say "Конечно, не буду."

# ch/harems/home/events/home_harem_bree_sasha.rpy:986
translate russian bree_sasha_showdown_d33c04d3:
    bree.say "Тогда мне остаётся попробовать тебе поверить! Увидимся!"

# ch/harems/home/events/home_harem_bree_sasha.rpy:988
translate russian bree_sasha_showdown_0127972d:
    "Помахав рукой, [lssb_homepair.bree_name()] спешит по коридору вслед за Сашей. Они скрываются в одной из спален, и вскоре в коридор доносятся приглушённые голоса."

# ch/harems/home/events/home_harem_bree_sasha.rpy:989
translate russian bree_sasha_showdown_90c23deb:
    "Как я ни стараюсь, не могу разобрать, о чём они говорят, и в конце концов решаю, что, наверное, так лучше."

# ch/harems/home/events/home_harem_bree_sasha.rpy:990
translate russian bree_sasha_showdown_a6d1574b:
    "Я ненадолго замираю с колотящимся сердцем. Как мне удалось не только изменять двум девушкам друг с другом, но и после разоблачения добиться того, чтобы обе остались?"

# ch/harems/home/events/home_harem_bree_sasha.rpy:991
translate russian bree_sasha_showdown_23abcd63:
    "С облегчением и любопытством к тому, что теперь ждёт наши отношения, я возвращаюсь к своим делам, стараясь не замечать непрерывный шёпот за закрытой дверью."

# ch/harems/home/events/home_harem_bree_sasha.rpy:995
translate russian bree_sasha_showdown_114ea94d:
    mike.say "Мне нет оправданий. Я облажался. Я заслужил всё, что вы захотите со мной сделать."

# ch/harems/home/events/home_harem_bree_sasha.rpy:997
translate russian bree_sasha_showdown_6ae5de9f:
    sasha.say "Ещё как заслужил!"

# ch/harems/home/events/home_harem_bree_sasha.rpy:998
translate russian bree_sasha_showdown_5bd7a6fb:
    sasha.say "У тебя только мы?"

# ch/harems/home/events/home_harem_bree_sasha.rpy:1000
translate russian bree_sasha_showdown_eb38446e:
    mike.say "Да, конечно, только вы."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1003
translate russian bree_sasha_showdown_83f81b08:
    bree.say "Мы-то этого не знаем, [lssb_common.hero_name()]."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1004
translate russian bree_sasha_showdown_46be8a56:
    bree.say "Как нам тебе верить?"

# ch/harems/home/events/home_harem_bree_sasha.rpy:1006
translate russian bree_sasha_showdown_b3a35d92:
    mike.say "Не знаю."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1008
translate russian bree_sasha_showdown_186c6dd2:
    bree.say "Неужели я так много от тебя просила, [lssb_common.hero_name()]?"

# ch/harems/home/events/home_harem_bree_sasha.rpy:1009
translate russian bree_sasha_showdown_4d8314be:
    bree.say "Я просто... просто хотела быть с тобой."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1010
translate russian bree_sasha_showdown_4c618cc9:
    bree.say "Если меня было недостаточно, нужно было сказать. Я бы просто..."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1012
translate russian bree_sasha_showdown_8046cfec:
    "Она снова плачет. Слёзы свободно текут по лицу, и сквозь срывающийся голос едва пробиваются слова."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1013
translate russian bree_sasha_showdown_adcff1e5:
    mike.say "Дело не в том, что тебя недостаточно, [lssb_homepair.bree_name()]."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1015
translate russian bree_sasha_showdown_960ccd39:
    bree.say "Тогда почему? Зачем ты так поступил? *Как* ты мог?"

# ch/harems/home/events/home_harem_bree_sasha.rpy:1017
translate russian bree_sasha_showdown_99bbac2c:
    "Я несколько раз запинаюсь и замолкаю. Объяснения у меня нет. [lssb_homepair.bree_name()] ждёт ответа, но я не могу заставить себя соврать ей в лицо. Только не сейчас."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1019
translate russian bree_sasha_showdown_c248fdfc:
    bree.say "Кажется, мне нужно уйти."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1021
translate russian bree_sasha_showdown_b39e098c:
    sasha.say "Да, иди успокойся, [lssb_homepair.bree_name()]."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1023
translate russian bree_sasha_showdown_9b408dff:
    bree.say "Я не об этом."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1025
translate russian bree_sasha_showdown_3c1fde32:
    mike.say "Постой, ты не можешь..."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1027
translate russian bree_sasha_showdown_66cb758b:
    bree.say "Я вернусь домой. Я, эм... уеду завтра утром."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1030
translate russian bree_sasha_showdown_3eb7e03c:
    sasha.say "Ты съезжаешь?"

# ch/harems/home/events/home_harem_bree_sasha.rpy:1032
translate russian bree_sasha_showdown_f9aa40da:
    "Саша выглядела так же потрясённо, как и я. [lssb_homepair.bree_name()] не могла встретиться взглядом ни с кем из нас и смотрела на пятно на ковре, куда непрерывно капали её слёзы."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1034
translate russian bree_sasha_showdown_86515460:
    bree.say "Да. Я больше не могу здесь оставаться."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1037
translate russian bree_sasha_showdown_54f03322:
    sasha.say "Слушай, [lssb_common.hero_name()] облажался, я согласна. Но тебе не обязательно уезжать."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1039
translate russian bree_sasha_showdown_ae520f1c:
    bree.say "Нет, обязательно, Саша!"

# ch/harems/home/events/home_harem_bree_sasha.rpy:1041
translate russian bree_sasha_showdown_8de9a49f:
    "Этот взрыв был внезапным, почти яростным."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1043
translate russian bree_sasha_showdown_358af3d9:
    bree.say "Ты не понимаешь! Это должен был быть чистый лист, начало новой жизни."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1044
translate russian bree_sasha_showdown_8aece0fd:
    bree.say "[lssb_common.hero_name()] всё испортил."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1045
translate russian bree_sasha_showdown_07ae38fa:
    bree.say "Я не могу просто притвориться, что ничего не было, и жить дальше. У меня голова устроена иначе, Саша!"

# ch/harems/home/events/home_harem_bree_sasha.rpy:1046
translate russian bree_sasha_showdown_a38be1fd:
    bree.say "Пока я остаюсь в этом городе, не могу."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1047
translate russian bree_sasha_showdown_4c7e8b44:
    bree.say "Чтобы двигаться дальше, мне нужно уехать."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1049
translate russian bree_sasha_showdown_12ee2551:
    mike.say "Не слишком ли ты рубишь с плеча? Просто переспи с этой мыслью, ладно?"

# ch/harems/home/events/home_harem_bree_sasha.rpy:1051
translate russian bree_sasha_showdown_5b3d8181:
    bree.say "Я не рублю с плеча!"

# ch/harems/home/events/home_harem_bree_sasha.rpy:1052
translate russian bree_sasha_showdown_4201111c:
    bree.say "Я просто..."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1054
translate russian bree_sasha_showdown_9f98ecd1:
    bree.say "Пойду вызову такси."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1056
translate russian bree_sasha_showdown_d0c90ebb:
    "Я снова пытаюсь её остановить, умоляю остаться, но она не слушает и решительно уходит к себе. Можно даже не дёргать ручку: дверь наверняка заперта."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1057
translate russian bree_sasha_showdown_e989b618:
    "Не всё из сказанного мне понятно, но ясно одно: сейчас она сама не знает, что думать."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1058
translate russian bree_sasha_showdown_fcf6c6ba:
    "Я тоже. Не могу понять, ошибается она или поступает правильно."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1060
translate russian bree_sasha_showdown_792b2c3a:
    sasha.say "Я не думала, что она правда уедет."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1062
translate russian bree_sasha_showdown_690f0d65:
    mike.say "Я тоже."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1063
translate russian bree_sasha_showdown_6cfb8b90:
    mike.say "Ты ведь тоже не уйдёшь?"

# ch/harems/home/events/home_harem_bree_sasha.rpy:1065
translate russian bree_sasha_showdown_a904755f:
    sasha.say "Может быть. Ещё не решила."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1067
translate russian bree_sasha_showdown_ff68b3cb:
    mike.say "...Пожалуйста, не уходи."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1069
translate russian bree_sasha_showdown_ef31f3f5:
    sasha.say "А почему я должна остаться, [lssb_common.hero_name()]? Чем ты вообще можешь меня убедить?"

# ch/harems/home/events/home_harem_bree_sasha.rpy:1071
translate russian bree_sasha_showdown_3d2e49b8:
    mike.say "Понятия не имею, но я на всё готов."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1072
translate russian bree_sasha_showdown_93f6ffc1:
    mike.say "Я не могу потерять вас обеих."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1073
translate russian bree_sasha_showdown_959a3d8c:
    "Повисает короткое молчание. Видно, что Саша напряжённо думает, но на её лице такая смесь чувств, что я не понимаю, к какому решению она склоняется."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1075
translate russian bree_sasha_showdown_e7b9a501:
    "Наконец она со вздохом плюхается на диван и жестом предлагает мне сесть рядом."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1077
translate russian bree_sasha_showdown_4c4d43ad:
    sasha.say "Ты жалок."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1079
translate russian bree_sasha_showdown_71a15bfd:
    "Эти слова могли бы больно меня задеть, если бы меня не захлестнуло облегчение. Я тут же сажусь рядом."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1081
translate russian bree_sasha_showdown_785ca42e:
    sasha.say "Если ты ещё когда-нибудь, слышишь, *когда-нибудь*, выкинешь что-то подобное, ты пожалеешь."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1083
translate russian bree_sasha_showdown_b5b60149:
    mike.say "Больше никогда. Обещаю."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1085
translate russian bree_sasha_showdown_37971103:
    sasha.say "Тебе придётся очень постараться, прежде чем слово «обещаю» снова будет хоть что-то для меня значить."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1086
translate russian bree_sasha_showdown_67599dbf:
    sasha.say "А теперь просто помолчи. Я всё ещё на тебя злюсь."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1088
translate russian bree_sasha_showdown_26b213aa:
    "Я открываю рот, чтобы пообещать молчать, но понимаю, как глупо это прозвучит, и не говорю ни слова."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1089
translate russian bree_sasha_showdown_e7d87bb9:
    "Мы сидим так какое-то время, и напряжение понемногу спадает."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1091
translate russian bree_sasha_showdown_3e7e10af:
    "В конце концов Саша уходит помогать со сборами: [lssb_homepair.bree_name()] пакует вещи. Потом Саша возвращается и выводит меня из комнаты, чтобы [lssb_homepair.bree_name()] смогла спокойно пройти к такси."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1092
translate russian bree_sasha_showdown_afd46a60:
    "Не знаю, откуда [lssb_homepair.bree_name()] взяла деньги на такой скорый вылет, но попрощаться я даже не успеваю."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1093
translate russian bree_sasha_showdown_009e1996:
    "Мне остаётся лишь смотреть вслед её такси, пока оно не скрывается вдали."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1094
translate russian bree_sasha_showdown_d5c4174e:
    "Вряд ли [lssb_homepair.bree_name()] ещё когда-нибудь появится в моей жизни."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1095
translate russian bree_sasha_showdown_3b228f4b:
    "По крайней мере, у нас с Сашей ещё есть надежда. Нужно лишь доказать ей, что я могу хранить верность."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1096
translate russian bree_sasha_showdown_1841c711:
    "Будет нелегко, но она того стоит."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1100
translate russian bree_sasha_showdown_b3a35d92_1:
    mike.say "Не знаю."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1101
translate russian bree_sasha_showdown_8c124243:
    mike.say "Я не хочу оправдываться и врать, придумывая причины, которых на самом деле не было."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1102
translate russian bree_sasha_showdown_498bd10a:
    mike.say "Я просто не могу объяснить, почему так поступил."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1104
translate russian bree_sasha_showdown_44905b8c:
    sasha.say "Ну и брехло же ты."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1106
translate russian bree_sasha_showdown_4ef4f8cb_1:
    mike.say "Я..."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1108
translate russian bree_sasha_showdown_8c24b365:
    sasha.say "Оставь это. С меня хватит."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1110
translate russian bree_sasha_showdown_825c4b85:
    mike.say "Саша, пост..."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1112
translate russian bree_sasha_showdown_29fb98e1:
    sasha.say "Я же сказала: оставь это, [lssb_common.hero_name()]."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1113
translate russian bree_sasha_showdown_3e2bc211:
    sasha.say "На что ты, блядь, рассчитываешь? Что мы продолжим как ни в чём не бывало?"

# ch/harems/home/events/home_harem_bree_sasha.rpy:1114
translate russian bree_sasha_showdown_093a4f5b:
    sasha.say "Что через пару недель мы втроём будем вспоминать эту историю и весело над ней смеяться?"

# ch/harems/home/events/home_harem_bree_sasha.rpy:1115
translate russian bree_sasha_showdown_bcabc37d:
    sasha.say "Ты кусок дерьма. Чем скорее я буду от тебя подальше, тем лучше."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1117
translate russian bree_sasha_showdown_dd255b05:
    mike.say "Подальше?"

# ch/harems/home/events/home_harem_bree_sasha.rpy:1119
translate russian bree_sasha_showdown_28665e89:
    sasha.say "Завтра заберу вещи."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1122
translate russian bree_sasha_showdown_7b0c5b40:
    bree.say "П-погоди, ты съезжаешь?"

# ch/harems/home/events/home_harem_bree_sasha.rpy:1125
translate russian bree_sasha_showdown_cb102a78:
    sasha.say "Да, съезжаю."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1126
translate russian bree_sasha_showdown_2d827600:
    sasha.say "А что, мне жить с {b}ним{/b}?"

# ch/harems/home/events/home_harem_bree_sasha.rpy:1127
translate russian bree_sasha_showdown_c8fa2e76:
    sasha.say "Мне уже тошно находиться рядом с ним, не говоря о том, чтобы спать под одной крышей."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1130
translate russian bree_sasha_showdown_6668b984:
    bree.say "Но куда ты пойдёшь?"

# ch/harems/home/events/home_harem_bree_sasha.rpy:1133
translate russian bree_sasha_showdown_c54eb022:
    sasha.say "Пока перекантуюсь у кого-нибудь на диване. Думаю, своё жильё найду довольно быстро."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1135
translate russian bree_sasha_showdown_d9f6db02:
    mike.say "Но..."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1137
translate russian bree_sasha_showdown_7300487f:
    sasha.say "Заткнись. Радуйся, что я ограничиваюсь переездом."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1138
translate russian bree_sasha_showdown_9c35f7a5:
    sasha.say "Поймаю такси. Пока."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1140
translate russian bree_sasha_showdown_82e9c59f:
    "Она прощается так резко, что я едва успеваю попытаться возразить."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1142
translate russian bree_sasha_showdown_9c53a9a7:
    "Я уже давно не могу толком вставить ни слова, и Саша уходит прежде, чем мне удаётся её остановить."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1143
translate russian bree_sasha_showdown_b860794b:
    "Я медленно оседаю на диван, проклиная себя за то, как сильно её обидел."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1145
translate russian bree_sasha_showdown_232cabaa:
    "Я почти не замечаю, как рядом садится [lssb_homepair.bree_name()], пока её ладонь не касается моей спины. Она медленно гладит меня, пытаясь утешить."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1147
translate russian bree_sasha_showdown_669cf439:
    bree.say "Эм, она тебе правда нравилась, да?"

# ch/harems/home/events/home_harem_bree_sasha.rpy:1149
translate russian bree_sasha_showdown_b167d839:
    mike.say "...Да, думаю, да."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1150
translate russian bree_sasha_showdown_6ed5d05e:
    "Теперь я не вижу смысла врать, даже учитывая, с кем говорю."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1151
translate russian bree_sasha_showdown_5400311e:
    "Повисает тишина. Я понимаю, что [lssb_homepair.bree_name()] пытается решить, как на это реагировать."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1152
translate russian bree_sasha_showdown_94b43e69:
    "Я не решаюсь нарушить молчание. Ладонь на спине на удивление хорошо меня успокаивает. Наконец [lssb_homepair.bree_name()] почти шёпотом говорит:"

# ch/harems/home/events/home_harem_bree_sasha.rpy:1154
translate russian bree_sasha_showdown_1ce33665:
    bree.say "Я тоже собиралась уйти."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1156
translate russian bree_sasha_showdown_339502f0:
    mike.say "Правда?"

# ch/harems/home/events/home_harem_bree_sasha.rpy:1158
translate russian bree_sasha_showdown_cb78a19e:
    bree.say "Да, я, эм..."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1160
translate russian bree_sasha_showdown_40120949:
    bree.say "Помнишь, я говорила, как много для меня значит доверие?"

# ch/harems/home/events/home_harem_bree_sasha.rpy:1162
translate russian bree_sasha_showdown_41a3313c:
    mike.say "Конечно помню."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1164
translate russian bree_sasha_showdown_ea35f86c:
    bree.say "Когда я всё поняла, мне было так больно... Будто сбылись мои худшие страхи. Но..."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1165
translate russian bree_sasha_showdown_72451a36:
    bree.say "Думаю, я останусь."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1167
translate russian bree_sasha_showdown_afb8f3e6:
    "Похоже, она и сама не слишком верит своим словам, но мне хватает и этого, чтобы почувствовать огромное облегчение."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1168
translate russian bree_sasha_showdown_6885f03f:
    mike.say "Правда?"

# ch/harems/home/events/home_harem_bree_sasha.rpy:1170
translate russian bree_sasha_showdown_26023a32:
    bree.say "Эм, да. Но... ты больше никогда не должен так поступать."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1172
translate russian bree_sasha_showdown_f625e27b:
    bree.say "Пожалуйста, прошу тебя, не делай так больше."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1173
translate russian bree_sasha_showdown_9434e86d:
    bree.say "Я хочу верить тебе, верить, что ты изменишься. Но сейчас это очень трудно."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1174
translate russian bree_sasha_showdown_c754941a:
    bree.say "Думаю, ещё одну твою измену я не вынесу."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1176
translate russian bree_sasha_showdown_4a17b875:
    mike.say "[lssb_homepair.bree_name()], обещаю, я больше никогда так не поступлю."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1177
translate russian bree_sasha_showdown_fa6ae954:
    mike.say "Клянусь, урок я усвоил."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1178
translate russian bree_sasha_showdown_fa47b44f:
    mike.say "Если я могу хоть что-то сделать, чтобы всё стало как раньше, я сделаю."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1180
translate russian bree_sasha_showdown_68bc82d5:
    bree.say "Не знаю, сможет ли всё когда-нибудь стать как раньше, [lssb_common.hero_name()]."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1182
translate russian bree_sasha_showdown_11383f54:
    bree.say "Но, эм... хотя бы попробуем."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1184
translate russian bree_sasha_showdown_47d3c258:
    "Я киваю, благодарный за то, что [lssb_homepair.bree_name()] хотя бы пытается меня понять. Руки сами обнимают её и прижимают ко мне."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1186
translate russian bree_sasha_showdown_c774a66e:
    "Видимо, этого хватило, чтобы прорвать плотину: слёзы, которые она так долго сдерживала, начинают течь мне на плечо."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1187
translate russian bree_sasha_showdown_a51f3637:
    "Мы остаёмся так какое-то время, пока наконец [lssb_homepair.bree_name()] не успокаивается."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1188
translate russian bree_sasha_showdown_a4499acf:
    "Посидев ещё немного молча, она говорит, что этот вечер её вымотал и она идёт спать. Я остаюсь один, с мыслями об обеих девушках."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1192
translate russian bree_sasha_showdown_9e49e185:
    "Я замолкаю."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1194
translate russian bree_sasha_showdown_3c7c4505:
    "Не знаю, что сказать, чтобы всё исправить. Вдруг неудачной попыткой я сделаю только хуже? Я лишь стыдливо опускаю голову."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1196
translate russian bree_sasha_showdown_4c4d43ad_1:
    sasha.say "Ты жалок."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1199
translate russian bree_sasha_showdown_396d7baf:
    bree.say "Ты даже не попробуешь объясниться?"

# ch/harems/home/events/home_harem_bree_sasha.rpy:1201
translate russian bree_sasha_showdown_e77c4d13:
    mike.say "Что я могу сказать, чтобы стало лучше?"

# ch/harems/home/events/home_harem_bree_sasha.rpy:1203
translate russian bree_sasha_showdown_880e8e53:
    sasha.say "Для слов уже поздно, придурок."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1205
translate russian bree_sasha_showdown_922a96f8:
    mike.say "Тогда чего вы от меня хотите?"

# ch/harems/home/events/home_harem_bree_sasha.rpy:1206
translate russian bree_sasha_showdown_2ac2e1e6:
    mike.say "Простите. Мне правда жаль."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1208
translate russian bree_sasha_showdown_2a49ae4f:
    sasha.say "Ни слову не верю. Ты жалеешь только о том, что мы тебя поймали."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1211
translate russian bree_sasha_showdown_4ccfe636:
    bree.say "Как ты мог так поступить, [lssb_common.hero_name()]?"

# ch/harems/home/events/home_harem_bree_sasha.rpy:1213
translate russian bree_sasha_showdown_5918f157:
    mike.say "Я не знаю, ясно?"

# ch/harems/home/events/home_harem_bree_sasha.rpy:1214
translate russian bree_sasha_showdown_f9e43212:
    mike.say "Не знаю, почему изменял вам обеим."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1216
translate russian bree_sasha_showdown_1eb6ba5f:
    sasha.say "Ну тогда всё сразу стало прекрасно, да?"

# ch/harems/home/events/home_harem_bree_sasha.rpy:1218
translate russian bree_sasha_showdown_c4771e4e:
    mike.say "Конечно нет."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1220
translate russian bree_sasha_showdown_5e639910:
    sasha.say "Тогда постарайся. Хоть как-то покажи, что тебе действительно жаль."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1222
translate russian bree_sasha_showdown_aac4679f:
    mike.say "Я просто..."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1223
translate russian bree_sasha_showdown_79eac0ea:
    mike.say "Не знаю, что вам сказать."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1225
translate russian bree_sasha_showdown_d8048505:
    "[lssb_homepair.bree_name()] снова плачет. Её слёзы капают на пол, пока я тщетно пытаюсь выкрутиться."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1227
translate russian bree_sasha_showdown_08981725:
    sasha.say "А я знаю, что тебе сказать."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1228
translate russian bree_sasha_showdown_184ce3af:
    sasha.say "Мы съезжаем."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1230
translate russian bree_sasha_showdown_3a4f5397:
    mike.say "Погодите, что?"

# ch/harems/home/events/home_harem_bree_sasha.rpy:1232
translate russian bree_sasha_showdown_cc620268:
    bree.say "Мы съезжаем, [lssb_common.hero_name()]."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1235
translate russian bree_sasha_showdown_c2da32e0:
    sasha.say "Мы уже обо всём договорились. Уезжаем сегодня вечером."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1237
translate russian bree_sasha_showdown_134ff260:
    mike.say "Куда?"

# ch/harems/home/events/home_harem_bree_sasha.rpy:1239
translate russian bree_sasha_showdown_b4c09b9a:
    sasha.say "Я переночую у друзей на диване, а [lssb_homepair.bree_name()] займёт гостевую комнату."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1241
translate russian bree_sasha_showdown_0cdf48f5:
    bree.say "А завтра я, эм... наверное, поеду домой."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1243
translate russian bree_sasha_showdown_24b2180d:
    mike.say "Домой? То есть уедешь из города?"

# ch/harems/home/events/home_harem_bree_sasha.rpy:1245
translate russian bree_sasha_showdown_dcd5a2bf:
    sasha.say "Мы больше не можем жить с тобой, [lssb_common.hero_name()]."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1246
translate russian bree_sasha_showdown_05e3d1c8:
    sasha.say "Мне даже разговаривать с тобой сейчас противно."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1249
translate russian bree_sasha_showdown_41b67220:
    bree.say "Ты предал моё доверие, хотя я говорила тебе, как много оно для меня значит."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1250
translate russian bree_sasha_showdown_4f4f35dd:
    bree.say "Я больше не могу здесь оставаться. Ты всё здесь для меня испортил."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1252
translate russian bree_sasha_showdown_3f43e50e:
    mike.say "Но вам же не обязательно съезжать!"

# ch/harems/home/events/home_harem_bree_sasha.rpy:1254
translate russian bree_sasha_showdown_70fcdf04:
    sasha.say "Нет, обязательно. Радуйся, что мы предупредили."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1255
translate russian bree_sasha_showdown_9ada736e:
    sasha.say "Вообще-то мы собирались просто оставить записку."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1257
translate russian bree_sasha_showdown_9b80d527:
    mike.say "Я... Спасибо?"

# ch/harems/home/events/home_harem_bree_sasha.rpy:1258
translate russian bree_sasha_showdown_c5b5d99e:
    "Разговор прерывает звук подъехавшей машины, а следом — гудок."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1260
translate russian bree_sasha_showdown_3d6c7e1c:
    bree.say "Кажется, это за нами."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1263
translate russian bree_sasha_showdown_ee8398e0:
    sasha.say "Он немного рано, ну да ладно."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1264
translate russian bree_sasha_showdown_ef842724:
    sasha.say "Пойдём за сумками, [lssb_homepair.bree_name()]. Пусть [lssb_common.hero_name()] остаётся здесь."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1267
translate russian bree_sasha_showdown_3d0a99da:
    bree.say "Да, эм... пойдём."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1271
translate russian bree_sasha_showdown_eaa244b8:
    "Я не ожидал, что всё произойдёт так быстро, и на мгновение цепенею."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1272
translate russian bree_sasha_showdown_042c4efc:
    mike.say "Подожди!"

# ch/harems/home/events/home_harem_bree_sasha.rpy:1274
translate russian bree_sasha_showdown_4a4cc619:
    bree.say "Зачем?"

# ch/harems/home/events/home_harem_bree_sasha.rpy:1275
translate russian bree_sasha_showdown_f39fd752:
    bree.say "Какой смысл, [lssb_common.hero_name()]?"

# ch/harems/home/events/home_harem_bree_sasha.rpy:1276
translate russian bree_sasha_showdown_be9dbc56:
    bree.say "Ты опять начнёшь мне врать."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1278
translate russian bree_sasha_showdown_9ddc05dd:
    mike.say "[lssb_homepair.bree_name()], нет, я..."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1279
translate russian bree_sasha_showdown_16b18bb5:
    bree.say "[lssb_common.hero_name()], пожалуйста, прекрати."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1281
translate russian bree_sasha_showdown_e0c08d1c:
    bree.say "Я устала от вранья. Если тебе не жаль, так и скажи."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1282
translate russian bree_sasha_showdown_87d92f1f:
    bree.say "Я знаю, что никогда тебе не нравилась. Тебе нужен был только секс."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1284
translate russian bree_sasha_showdown_785b1dfd:
    mike.say "[lssb_homepair.bree_name()], это неправда."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1286
translate russian bree_sasha_showdown_81d8d2e2:
    bree.say "...А ощущение именно такое."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1288
translate russian bree_sasha_showdown_c6b24454:
    sasha.say "[lssb_homepair.bree_name()]! Он не будет ждать вечно!"

# ch/harems/home/events/home_harem_bree_sasha.rpy:1290
translate russian bree_sasha_showdown_32583d1b:
    bree.say "Я, эм... мне пора."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1292
translate russian bree_sasha_showdown_11057cfd:
    mike.say "Ты даже вещи не взяла. Останься хоть на одну ночь. Давай поговорим, [lssb_homepair.bree_name()]."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1294
translate russian bree_sasha_showdown_cd7dc679:
    "Мои слова заставляют её замереть. Она отворачивается от двери своей комнаты, и на миг во мне вспыхивает надежда. Но она проходит мимо меня прямо к выходу."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1296
translate russian bree_sasha_showdown_fc3cabb9:
    bree.say "Я, эм... завтра попрошу кого-нибудь забрать вещи."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1298
translate russian bree_sasha_showdown_ec1f9ffb:
    "И вот я остался один."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1300
translate russian bree_sasha_showdown_583989e2:
    "За Сашей захлопнулась дверь, а через несколько секунд машина уехала. Прежде чем я добрался до выхода, она уже скрылась за поворотом."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1301
translate russian bree_sasha_showdown_93ae18d7:
    "У меня появилось мерзкое чувство, что я больше никогда не увижу ни одну из них."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1310
translate russian bree_sasha_showdown_2_669b0579:
    "В доме уже пару дней висит ощутимое напряжение, и находиться здесь неловко."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1311
translate russian bree_sasha_showdown_2_294028b9:
    "Наверное, я сам во всём виноват: захотел и рыбку съесть, и на ёлку влезть."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1312
translate russian bree_sasha_showdown_2_967e173b:
    "Точнее, чтобы [lssb_homepair.bree_name()] была моей, а я при этом ещё и лакомился Сашей..."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1313
translate russian bree_sasha_showdown_2_007745c4:
    "Честно говоря, тогда идея казалась хорошей. Я был уверен, что справлюсь, — лишь бы никто не забеременел."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1314
translate russian bree_sasha_showdown_2_1c47ab1b:
    "Конечно, стоило этой мысли прийти мне в голову, как уже можно было догадаться: хотя бы одна точно забеременеет."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1315
translate russian bree_sasha_showdown_2_32da2a1b:
    "Но даже в самом страшном сне я не представлял, что беременными окажутся обе!"

# ch/harems/home/events/home_harem_bree_sasha.rpy:1316
translate russian bree_sasha_showdown_2_8cff70c0:
    "И без того было непросто тайком спать с обеими соседками под одной крышей."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1317
translate russian bree_sasha_showdown_2_d8b767a8:
    "А с двумя беременностями вся эта паутина лжи и обмана стала ещё запутаннее!"

# ch/harems/home/events/home_harem_bree_sasha.rpy:1318
translate russian bree_sasha_showdown_2_07448cbe:
    "Они просто не могли не заметить, что обе беременны."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1319
translate russian bree_sasha_showdown_2_348e740e:
    "Особенно когда начали расти животы и появились остальные признаки."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1320
translate russian bree_sasha_showdown_2_f5d75829:
    "Если я всё правильно разыгрываю, [lssb_homepair.bree_name()] и Саша думают, что я сплю только с одной из них, а вторую обрюхатил какой-то тупой мудак."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1321
translate russian bree_sasha_showdown_2_5adb389b:
    "(Что, пожалуй, в обоих случаях не так уж далеко от истины...)"

# ch/harems/home/events/home_harem_bree_sasha.rpy:1322
translate russian bree_sasha_showdown_2_66f58a5e:
    "У меня остался один козырь: я настоял, чтобы каждая скрывала наши отношения от другой."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1323
translate russian bree_sasha_showdown_2_c06cbc70:
    "Тогда я объяснял это тем, что не хочу вызывать ревность остальных соседок и делать совместную жизнь неловкой."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1324
translate russian bree_sasha_showdown_2_007496ce:
    "Но сейчас, наверное, только это и мешает им вдвоём содрать с меня шкуру."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1325
translate russian bree_sasha_showdown_2_9fceeae6:
    "Я бы спрятался в своей комнате, лишь бы не оказаться между ними."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1326
translate russian bree_sasha_showdown_2_b6c14cde:
    "Но так у них будет гораздо больше возможностей разговориться."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1327
translate russian bree_sasha_showdown_2_fe756c58:
    "А если они разговорятся, долго ли удастся избежать опасной оговорки?"

# ch/harems/home/events/home_harem_bree_sasha.rpy:1329
translate russian bree_sasha_showdown_2_64a7f35b:
    "Поэтому, когда [lssb_homepair.bree_name()] вразвалку входит в гостиную, я сижу на диване и смотрю телевизор."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1331
translate russian bree_sasha_showdown_2_4c2e77bd:
    "Она почти падает рядом со мной, стонет и растирает поясницу костяшками пальцев."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1333
translate russian bree_sasha_showdown_2_bdb6b283:
    bree.say "[lssb_common.hero_name()], у меня спина болит!"

# ch/harems/home/events/home_harem_bree_sasha.rpy:1335
translate russian bree_sasha_showdown_2_cebf22f9:
    bree.say "Помассируешь?"

# ch/harems/home/events/home_harem_bree_sasha.rpy:1337
translate russian bree_sasha_showdown_2_ea22fc2f:
    "Как тут отказаться и не вызвать диких подозрений?"

# ch/harems/home/events/home_harem_bree_sasha.rpy:1338
translate russian bree_sasha_showdown_2_d0723cb4:
    "Я киваю и выполняю её просьбу, всё время молясь, чтобы успеть закончить, прежде чем..."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1340
translate russian bree_sasha_showdown_2_464b38fe:
    sasha.say "Привет, [lssb_common.hero_name()], привет, [lssb_homepair.bree_name()]!"

# ch/harems/home/events/home_harem_bree_sasha.rpy:1341
translate russian bree_sasha_showdown_2_bad40042:
    sasha.say "КЛЯНУСЬ, из-за наших малышей у нас тела как будто синхронизируются!"

# ch/harems/home/events/home_harem_bree_sasha.rpy:1342
translate russian bree_sasha_showdown_2_c17075a1:
    sasha.say "Мне сейчас как раз этого не хватает!"

# ch/harems/home/events/home_harem_bree_sasha.rpy:1344
translate russian bree_sasha_showdown_2_e59d3eca:
    "Я киваю, пытаясь угодить обеим."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1346
translate russian bree_sasha_showdown_2_1cfbb9d5:
    "Но уже замечаю недоумение на лице Саши: отец её ребёнка делает массаж другой женщине."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1348
translate russian bree_sasha_showdown_2_a8cbea98:
    "И точно так же чувствую, что [lssb_homepair.bree_name()] не сводит с меня глаз."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1349
translate russian bree_sasha_showdown_2_0e73090b:
    "Она хмурится, пытаясь понять, почему Саша считает, что может требовать к себе такого же отношения, как к моей беременной девушке."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1350
translate russian bree_sasha_showdown_2_d2d0a9cb:
    mike.say "Эм... может, чуть позже?"

# ch/harems/home/events/home_harem_bree_sasha.rpy:1351
translate russian bree_sasha_showdown_2_33128a07:
    mike.say "Когда я... снова начну чувствовать руки?"

# ch/harems/home/events/home_harem_bree_sasha.rpy:1354
translate russian bree_sasha_showdown_2_ba793807:
    "Саша недовольно фыркает и садится по другую сторону от меня. Теперь [lssb_homepair.bree_name()] и она сидят по обе стороны."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1356
translate russian bree_sasha_showdown_2_674e596f:
    bree.say "А что такое, Саша? Твой мужчина не хочет сделать тебе массаж?"

# ch/harems/home/events/home_harem_bree_sasha.rpy:1359
translate russian bree_sasha_showdown_2_1ce76db1:
    "Я тут же вижу, как в глазах Саши вспыхивает злость."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1360
translate russian bree_sasha_showdown_2_ee37a93f:
    "[lssb_homepair.bree_name()] наверняка считает свой вопрос совершенно невинным при таких обстоятельствах."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1361
translate russian bree_sasha_showdown_2_d3696fd2:
    "Но для Саши это наверняка звучит как насмешка: [lssb_homepair.bree_name()] получает внимание, которое я должен уделять ей."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1363
translate russian bree_sasha_showdown_2_1907f23d:
    sasha.say "Нет, [lssb_homepair.bree_name()], он слишком занят тем, что лапает белобрысых шлюшек, которых обрюхатил какой-то козёл!"

# ch/harems/home/events/home_harem_bree_sasha.rpy:1365
translate russian bree_sasha_showdown_2_47621840:
    bree.say "Ох, как грубо!"

# ch/harems/home/events/home_harem_bree_sasha.rpy:1366
translate russian bree_sasha_showdown_2_f2db5599:
    bree.say "Эй... подожди-ка!"

# ch/harems/home/events/home_harem_bree_sasha.rpy:1368
translate russian bree_sasha_showdown_2_0098c477:
    "Пока ссора вокруг меня разгорается, я инстинктивно съёживаюсь."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1369
translate russian bree_sasha_showdown_2_ba2823c0:
    "Можно попытаться вмешаться или рвануть к двери."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1370
translate russian bree_sasha_showdown_2_44f5edf7:
    "Наверное, благороднее всего было бы признаться обеим, наплевав на последствия."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1371
translate russian bree_sasha_showdown_2_5c37543c:
    "Вот только начинать говорить правду, кажется, уже поздновато."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1373
translate russian bree_sasha_showdown_2_5f28d0ed:
    bree.say "Ты только что назвала меня ШЛЮХОЙ?!?"

# ch/harems/home/events/home_harem_bree_sasha.rpy:1376
translate russian bree_sasha_showdown_2_4772a4ab:
    sasha.say "А как ещё тебя назвать, а?"

# ch/harems/home/events/home_harem_bree_sasha.rpy:1377
translate russian bree_sasha_showdown_2_1263e978:
    sasha.say "Я захожу, а отец моего ребёнка делает тебе массаж."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1378
translate russian bree_sasha_showdown_2_fc66dd39:
    sasha.say "И ты ещё смеешь тыкать меня в это носом!"

# ch/harems/home/events/home_harem_bree_sasha.rpy:1380
translate russian bree_sasha_showdown_2_02b51779:
    "Вот и всё. Эти слова решат мою судьбу..."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1382
translate russian bree_sasha_showdown_2_7a5acf37:
    bree.say "Что... погоди..."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1383
translate russian bree_sasha_showdown_2_303fa0b8:
    bree.say "В смысле — отец ТВОЕГО ребёнка?"

# ch/harems/home/events/home_harem_bree_sasha.rpy:1386
translate russian bree_sasha_showdown_2_0097b301:
    sasha.say "В прямом: [lssb_common.hero_name()] — отец моего ребёнка."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1387
translate russian bree_sasha_showdown_2_24034bc5:
    sasha.say "Я думала, ты знаешь?!?"

# ch/harems/home/events/home_harem_bree_sasha.rpy:1390
translate russian bree_sasha_showdown_2_6cff4e4b:
    bree.say "Нет, он отец МОЕГО ребёнка!"

# ch/harems/home/events/home_harem_bree_sasha.rpy:1391
translate russian bree_sasha_showdown_2_d3470fcb:
    bree.say "Я думала, ты знаешь?!?"

# ch/harems/home/events/home_harem_bree_sasha.rpy:1394
translate russian bree_sasha_showdown_2_f6247aa0:
    sasha.say "Но он сказал, что тебя обрюхатил какой-то никчёмный мудак!"

# ch/harems/home/events/home_harem_bree_sasha.rpy:1395
translate russian bree_sasha_showdown_2_0dbb05c7:
    bree.say "Мне он сказал то же самое — про тебя!"

# ch/harems/home/events/home_harem_bree_sasha.rpy:1398
translate russian bree_sasha_showdown_2_534c4762:
    "Они одновременно смотрят на меня сверху вниз."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1402
translate russian bree_sasha_showdown_2_6696030f:
    "Кажется, теперь я наконец понимаю выражение «убить взглядом»."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1403
translate russian bree_sasha_showdown_2_f566c726:
    "Честно говоря, я не разбираю всего, что кричат [lssb_homepair.bree_name()] и Саша, осыпая меня пощёчинами и ударами."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1404
translate russian bree_sasha_showdown_2_63e394cd:
    "Но рискну предположить, что ничего особо приятного там нет."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1408
translate russian bree_sasha_showdown_2_1805a2d1:
    "Зато я отлично слышу, как они обе топают наверх, в свои комнаты."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1409
translate russian bree_sasha_showdown_2_8716b7e2:
    "А затем — как распахиваются шкафы и выдвигаются ящики: девушки торопливо набивают сумки одеждой."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1410
translate russian bree_sasha_showdown_2_9e224cf0:
    "Мне не нужна презентация с картинками, чтобы понять, что происходит."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1414
translate russian bree_sasha_showdown_2_c357405d:
    "Когда они снова появляются с сумками в руках и слезами на глазах, я предпочитаю молчать."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1415
translate russian bree_sasha_showdown_2_f5859241:
    "Просто стою в коридоре, уставившись себе под ноги, как отчитанный ребёнок."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1417
translate russian bree_sasha_showdown_2_3ebd9968:
    bree.say "Не смей заходить в мою комнату, слышишь?"

# ch/harems/home/events/home_harem_bree_sasha.rpy:1418
translate russian bree_sasha_showdown_2_bf148da5:
    bree.say "Я пришлю кого-нибудь за остальными вещами!"

# ch/harems/home/events/home_harem_bree_sasha.rpy:1423
translate russian bree_sasha_showdown_2_8c2598ff:
    "В довершение она бьёт меня кулаком в челюсть. Этого я не ожидал."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1427
translate russian bree_sasha_showdown_2_a554b404:
    "Держась за лицо, я лишь в последний момент слышу шаги Саши."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1429
translate russian bree_sasha_showdown_2_e65c62ca:
    sasha.say "К моей комнате это тоже относится."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1430
translate russian bree_sasha_showdown_2_a4088902:
    sasha.say "А если ещё раз тебя увижу, отрежу тебе нахрен яйца!"

# ch/harems/home/events/home_harem_bree_sasha.rpy:1436
translate russian bree_sasha_showdown_2_038a1788:
    "На прощание она резко бьёт коленом именно туда, куда только что пригрозила."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1439
translate russian bree_sasha_showdown_2_d839b187:
    "Я падаю на пол и корчусь от боли."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1441
translate russian bree_sasha_showdown_2_479b965c:
    "Хлопок захлопнувшейся двери доносится словно издалека."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1442
translate russian bree_sasha_showdown_2_3097367d:
    "А потом наступает тишина. Похоже, теперь мне придётся к ней привыкать."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1453
translate russian bj_birthday_b8097ecf:
    "Я вхожу в гостиную."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1454
translate russian bj_birthday_d9137326:
    "Уж здесь-то ничего безумного случиться не может, правда?"

# ch/harems/home/events/home_harem_bree_sasha.rpy:1455
translate russian bj_birthday_9bd0cdfc:
    bree_sasha "Привет, [lssb_common.hero_name()]."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1458
translate russian bj_birthday_bb39be1f:
    "Внезапно передо мной предстают обе соседки — в одном нижнем белье."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1459
translate russian bj_birthday_acf3a032:
    mike.say "Ого! [lssb_homepair.bree_name()]!? Саша!? Это ещё что такое?"

# ch/harems/home/events/home_harem_bree_sasha.rpy:1461
translate russian bj_birthday_5237516f:
    sasha.say "Привет, [lssb_common.hero_name()]."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1462
translate russian bj_birthday_f2bfd06f:
    sasha.say "Ты же знаешь, какой сегодня день."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1465
translate russian bj_birthday_e6e29964:
    bree.say "Ну, я как бы не думаю, что он мог забыть... правда?"

# ch/harems/home/events/home_harem_bree_sasha.rpy:1467
translate russian bj_birthday_581f9506:
    mike.say "Сегодня?"

# ch/harems/home/events/home_harem_bree_sasha.rpy:1469
translate russian bj_birthday_226240f2:
    mike.say "Погодите... вы что... вспомнили про мой день рождения?"

# ch/harems/home/events/home_harem_bree_sasha.rpy:1471
translate russian bj_birthday_fc594621:
    sasha.say "Вспомнили?"

# ch/harems/home/events/home_harem_bree_sasha.rpy:1473
translate russian bj_birthday_3e2fc0da:
    "Саша фыркает и упирает руки в бока."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1475
translate russian bj_birthday_f4aac56b:
    sasha.say "По-моему, мы сделали гораздо больше!"

# ch/harems/home/events/home_harem_bree_sasha.rpy:1478
translate russian bj_birthday_a384ecd3:
    bree.say "Ну... то есть, строго говоря..."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1481
translate russian bj_birthday_3888725a:
    sasha.say "Мы СОБИРАЕМСЯ сделать гораздо больше."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1483
translate russian bj_birthday_f154175a:
    sasha.say "Ну же, [lssb_common.hero_name()], раздевайся."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1485
translate russian bj_birthday_1bf36d4b:
    bree.say "Эм, можешь не торопиться, если хочешь... То есть это твой день, делай что хочешь... да?"

# ch/harems/home/events/home_harem_bree_sasha.rpy:1487
translate russian bj_birthday_3b542f32:
    "Они как инь и ян: Саша стоит уверенно и явно довольна собой, а [lssb_homepair.bree_name()], похоже, смущается."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1488
translate russian bj_birthday_46ce8fe0:
    "Впрочем, я не задаю вопросов и просто делаю, что велено. Вскоре я уже стою перед ними голый, заинтригованный и возбуждённый."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1490
translate russian bj_birthday_5a939a60:
    sasha.say "А теперь садись на диван."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1492
translate russian bj_birthday_ad3f5cb9:
    "Саша цепляет пальцами бретельки лифчика и спускает их с плеч."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1494
translate russian bj_birthday_9a770425:
    bree.say "Да, просто, эм... расслабься."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1496
translate russian bj_birthday_6b2cb1bd:
    "[lssb_homepair.bree_name()] запинаясь произносит свою реплику, словно заученную, и стягивает трусики, покачивая бёдрами."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1501
translate russian bj_birthday_f56433eb:
    "Обе соседки уже разделись и улыбаются мне сверху вниз, полные желания и решимости."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1503
translate russian bj_birthday_d8c510d0:
    bree.say "Надеюсь, тебе понравится, [lssb_common.hero_name()]..."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1506
translate russian bj_birthday_5f7aefd7:
    sasha.say "Ну что ж!"

# ch/harems/home/events/home_harem_bree_sasha.rpy:1512
translate russian bj_birthday_38fd793c:
    "Они наверняка это репетировали или хотя бы всё спланировали."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1513
translate russian bj_birthday_e6a4e58e:
    "На миг я представляю их вдвоём, совершенно голых. Если бы мой член уже не стоял по стойке смирно, одной этой мысли хватило бы для эрекции."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1519
translate russian bj_birthday_0f0d7264:
    "Они забираются на диван — [lssb_homepair.bree_name()] слева, Саша справа — и нежно шепчут мне на ухо."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1521
translate russian bj_birthday_566c58fd:
    bree_sasha "С днём рождения тебя..."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1523
translate russian bj_birthday_f6a40bf2:
    "Песня продолжается, а их пальцы синхронно скользят вниз по моему телу."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1524
translate russian bj_birthday_34a6f188:
    "Вскоре обе лежат, прижавшись ко мне тёплыми телами и обхватив мои разведённые ноги."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1530
translate russian bj_birthday_0c0dd202:
    "Вместе они обхватывают пальцами мой член и одновременно высовывают языки, проводя ими снизу вверх."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1533
translate russian bj_birthday_4eacefae:
    mike.say "Вы двое... отлично работаете в команде."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1534
translate russian bj_birthday_288c027f:
    sasha.say "Имениннику — только лучшее..."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1536
translate russian bj_birthday_2425a8cb:
    bree.say "Я просто хотела отблагодарить вас обоих. С вами так хорошо жить вместе."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1546
translate russian bj_birthday_66336823:
    "Сперма брызжет им на лица, щедро покрывая их моим праздничным подарком."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1549
translate russian bj_birthday_6ddfff5a:
    sasha.say "Наслаждайся видом, именинник."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1554
translate russian bj_birthday_bd470c56:
    "Я смотрю, как [lssb_homepair.bree_name()] и Саша обнимаются и тянутся друг к другу для поцелуя."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1555
translate russian bj_birthday_25f960ad:
    "Их приоткрытые губы соприкасаются, языки ныряют друг другу в рот."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1556
translate russian bj_birthday_3fddccb4:
    "И всё это время моя сперма продолжает стекать по их лицам!"

# ch/harems/home/events/home_harem_bree_sasha.rpy:1557
translate russian bj_birthday_4245e516:
    "Она капает с одной на другую, а они словно даже не замечают."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1558
translate russian bj_birthday_4099c8a3:
    "Капли попадают им на губы и языки, и девушки их тоже слизывают и глотают!"

# ch/harems/home/events/home_harem_bree_sasha.rpy:1562
translate russian bj_birthday_d620b71d:
    "Она передаёт эстафету, и [lssb_homepair.bree_name()] обхватывает мой член губами, тихо постанывая от удовольствия, наслаждаясь вкусом."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1568
translate russian bj_birthday_1f5d235f:
    bree.say "Ну вот, [lssb_common.hero_name()], эм... у меня для тебя ещё один сюрприз."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1570
translate russian bj_birthday_d7152f00:
    mike.say "Ещё что-то?"

# ch/harems/home/events/home_harem_bree_sasha.rpy:1572
translate russian bj_birthday_dfbbde0a:
    bree.say "Ага..."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1573
translate russian bj_birthday_ab456b87:
    bree.say "Торт!"

# ch/harems/home/events/home_harem_bree_sasha.rpy:1587
translate russian bree_sasha_threesome_056420a8:
    "Мне всё ещё странно сознавать, что я живу с двумя такими разными, но одинаково желанными женщинами."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1588
translate russian bree_sasha_threesome_3e87dd99:
    "Ещё удивительнее, что удача повернулась ко мне настолько, что я сплю не с одной, а с обеими."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1592
translate russian bree_sasha_threesome_df8e2620:
    "Я то и дело перевожу взгляд с одной на другую: [lssb_homepair.bree_name()] и Саша голыми лежат на кровати и ждут, когда я к ним присоединюсь."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1593
translate russian bree_sasha_threesome_04d94039:
    "Заметив мою нерешительность, они лукаво хихикают и заговорщически переглядываются."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1595
translate russian bree_sasha_threesome_07daf3f6:
    bree.say "Чего ты ждёшь?"

# ch/harems/home/events/home_harem_bree_sasha.rpy:1597
translate russian bree_sasha_threesome_dd045734:
    sasha.say "Да уж, обещаю: мы кусаемся!"

# ch/harems/home/events/home_harem_bree_sasha.rpy:1601
translate russian bree_sasha_threesome_1203d5ab:
    "Я забираюсь на кровать между ними и всё ещё не знаю, куда смотреть: каждая так притягательна."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1602
translate russian bree_sasha_threesome_09e14c1f:
    "Не успеваю я решить, с чего начать, как [lssb_homepair.bree_name()] и Саша поднимаются на колени."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1605
translate russian bree_sasha_threesome_72f3c412:
    "[lssb_homepair.bree_name()] приближается слева, а Саша справа. Они наклоняются и целуют меня в уголки губ."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1606
translate russian bree_sasha_threesome_f2808b75:
    "Ни одна не целует меня прямо в губы: они дразнят языками, а затем начинают спускаться ниже."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1607
translate russian bree_sasha_threesome_ba572435:
    "Их груди трутся о мою грудь, и я протягиваю руки, обхватывая по одной у каждой."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1608
translate russian bree_sasha_threesome_ba3785c5:
    "Я щиплю и сжимаю соски, наслаждаясь едва заметными различиями на ощупь, пока массирую обе груди."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1611
translate russian bree_sasha_threesome_69961646:
    "[lssb_homepair.bree_name()] довольно стонет, когда я кручу её сосок пальцами, а Саша восторженно рычит."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1613
translate russian bree_sasha_threesome_e605d31a:
    "На миг мы втроём замираем, просто наслаждаясь прикосновениями друг друга."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1614
translate russian bree_sasha_threesome_ae4d0524:
    "Но мой член уже твердеет, а жар девушек почти ощущается в воздухе."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1615
translate russian bree_sasha_threesome_4e03690a:
    "Одними поцелуями и ласками груди дело не ограничится, и все это понимают."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1616
translate russian bree_sasha_threesome_0f4e6377:
    "Внезапно повсюду оказываются руки, губы и тела."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1617
translate russian bree_sasha_threesome_60ae8c86:
    "Никто не берёт инициативу, и я решаю сразу перейти к тому, чего хочу."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1621
translate russian bree_sasha_threesome_4cfff33f:
    "Будто мы с Сашей общаемся мысленно: я нажимаю на плечи, чтобы [lssb_homepair.bree_name()] легла, а Саша одновременно опускает её ноги."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1622
translate russian bree_sasha_threesome_c6fb095c:
    "[lssb_homepair.bree_name()] не сопротивляется. Её взгляд прикован к моему члену, нависшему над её лицом."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1627
translate russian bree_sasha_threesome_ae6b067d:
    "Я беру её за голову и мягко направляю, пока она обхватывает губами головку."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1629
translate russian bree_sasha_threesome_4114fa5c:
    "Её язык обвивает головку, вызывая невероятное ощущение. В этот момент Саша наклоняется к нижним губам девушки: [lssb_homepair.bree_name()] лежит между нами."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1630
translate russian bree_sasha_threesome_f95e63d0:
    "Я смотрю, как Саша дразнит её языком. [lssb_homepair.bree_name()] получает всё более настойчивые ласки: язык умело скользит и проникает глубже."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1632
translate russian bree_sasha_threesome_0a066ace:
    "Не видя, что с ней делают, [lssb_homepair.bree_name()] вздрагивает от удовольствия. Я чувствую дрожь её тела, а её ласки становятся ещё горячее и непредсказуемее."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1633
translate russian bree_sasha_threesome_fb15a339:
    "Стыдно признаться, но отчасти мне кажется, будто это Саша ласкает меня ртом, а [lssb_homepair.bree_name()] стала всего лишь живой игрушкой для нашего удовольствия."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1635
translate russian bree_sasha_threesome_7e966eec:
    "Одна эта мысль постыдно возбуждает меня, и я не удерживаюсь, кончая раньше, чем хотел."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1642
translate russian bree_sasha_threesome_a27ba5c5:
    "Я направляю её вниз, и [lssb_homepair.bree_name()] встаёт на четвереньки без сопротивления. Её глаза прикованы к моему члену перед её лицом."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1643
translate russian bree_sasha_threesome_c5b3adab:
    "Прежде чем она успевает потянуться к нему руками или губами, Саша подходит сзади и хватает её за руки."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1644
translate russian bree_sasha_threesome_23476945:
    "[lssb_homepair.bree_name()] краснеет, внезапно осознав, что ей отводят подчинённую роль, но мы продолжаем, не обращая внимания на её реакцию."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1646
translate russian bree_sasha_threesome_d1a9fbf8:
    "Саша подаёт её вперёд, и она принимает мой член в открытый рот. Только тогда я замечаю, что Саша успела пристегнуть что-то вокруг талии и паха."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1648
translate russian bree_sasha_threesome_3fdda9e1:
    "[lssb_homepair.bree_name()] стоит между нами. Саша лукаво улыбается мне поверх её спины, опускает свой внушительный страпон и толкается с другой стороны."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1649
translate russian bree_sasha_threesome_6cf76869:
    "[lssb_homepair.bree_name()] изумлённо всхлипывает и стонет с моим членом во рту, даря мне непредсказуемые, но возбуждающие ощущения."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1650
translate russian bree_sasha_threesome_4b6829fb:
    "Саша с энтузиазмом орудует страпоном, пока сама не покрывается испариной. [lssb_homepair.bree_name()] принимает её толчки."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1652
translate russian bree_sasha_threesome_944b1794:
    "Наши взгляды встречаются. Нас обоих невероятно возбуждает, что [lssb_homepair.bree_name()] служит орудием нашего удовольствия."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1654
translate russian bree_sasha_threesome_0fd47e4a:
    "Собрав последние силы, я глубже проталкиваю член ей в горло, так что [lssb_homepair.bree_name()] остаётся лишь принять его."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1656
translate russian bree_sasha_threesome_7e944227:
    "Через несколько мгновений я теряю контроль и выпускаю всё разом."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1660
translate russian bree_sasha_threesome_24a7a2c9:
    "Никто не говорит ни слова. Мы лежим сплетением влажных тел и конечностей, быстро остывая, но ещё чувствуя отголоски оргазма."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1661
translate russian bree_sasha_threesome_f2194d8c:
    "Говорят, люди жалуются только тогда, когда недовольны обслуживанием."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1662
translate russian bree_sasha_threesome_3cdb6324:
    "Поэтому мне приятно считать, что тишина в спальне означает одно: [lssb_homepair.bree_name()] и Саша молча наслаждаются удовлетворением."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1663
translate russian bree_sasha_threesome_6cfba1fd:
    "Самому мне точно не на что жаловаться."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1678
translate russian bree_sasha_threesome_2_0e6059e5:
    "Как бы ни волновал и ни возбуждал секс втроём, над ним всегда висит лёгкое невысказанное напряжение."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1679
translate russian bree_sasha_threesome_2_a32ba656:
    "И как иначе, особенно когда из-за состава участников чего-то у нас двое, а чего-то — всего один на всех?"

# ch/harems/home/events/home_harem_bree_sasha.rpy:1680
translate russian bree_sasha_threesome_2_ed0bf37b:
    "Никто не обсуждает это заранее. Наверное, даже при возможности не стал бы — побоялся бы показаться тем, кто тянет одеяло на себя."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1681
translate russian bree_sasha_threesome_2_0129e166:
    "Но я всегда чувствую лёгкое соперничество, когда [lssb_homepair.bree_name()] и Саша собираются развлечься со мной втроём."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1684
translate russian bree_sasha_threesome_2_78284772:
    "Ни одна не признается, но обе думают, кому же достанется оседлать мой член."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1685
translate russian bree_sasha_threesome_2_cc793705:
    "Я понимаю, что должен позаботиться о гармонии, чтобы никто не чувствовал себя лишним."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1686
translate russian bree_sasha_threesome_2_4a5698ac:
    "Но я всего лишь человек — как тут притворяться, зная, что две такие горячие девушки пытаются перещеголять друг друга ради одного и того же?"

# ch/harems/home/events/home_harem_bree_sasha.rpy:1690
translate russian bree_sasha_threesome_2_e6153523:
    "Вот и сейчас я чувствую это: дверь моей комнаты плотно закрыта, а девушки раздеваются передо мной."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1691
translate russian bree_sasha_threesome_2_188f7f55:
    "Снимая одежду, я невольно чувствую себя призовым жеребцом, перед которым проводят племенных кобыл."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1692
translate russian bree_sasha_threesome_2_3c0e0863:
    "От каждой по отдельности я готов потерять голову, а когда они вместе, выбрать почти невозможно."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1696
translate russian bree_sasha_threesome_2_0a567ae2:
    "Но в конце концов придётся решиться и сделать выбор, к добру или к худу."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1698
translate russian bree_sasha_threesome_2_54e11bd4:
    "И тут я замечаю искорку в глазах Саши."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1700
translate russian bree_sasha_threesome_2_807e8f9b:
    "Может, это лишь моё воображение отчаянно ищет повод предпочесть одну другой."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1701
translate russian bree_sasha_threesome_2_fe4283dd:
    "Но во взгляде Саши есть что-то более тёмное и томное: она — пряность, а [lssb_homepair.bree_name()] — восхитительная сладость."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1702
translate russian bree_sasha_threesome_2_7aedbee0:
    "Прав я или нет, на том и остановлюсь."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1703
translate russian bree_sasha_threesome_2_2d354deb:
    "Если ещё тянуть и раздумывать, боюсь, момент уйдёт и настроение совсем пропадёт."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1705
translate russian bree_sasha_threesome_2_c07fa24d:
    "Конечно, Саше и до беременности было нетрудно меня возбудить — в конце концов, одно как раз и привело к другому!"

# ch/harems/home/events/home_harem_bree_sasha.rpy:1706
translate russian bree_sasha_threesome_2_68e5efe9:
    "Но вид её большого круглого живота вызывает во мне желание повторить всё заново."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1707
translate russian bree_sasha_threesome_2_d0332f15:
    "Я беру её за руку и показываю, что хочу поставить её перед собой, спиной к моему животу. Она покачивается, словно прекрасный спелый плод."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1708
translate russian bree_sasha_threesome_2_98a26a95:
    "Когда она встаёт передо мной, кажется, будто я сейчас займусь сексом с древним идолом плодородия, волшебным образом ожившим."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1710
translate russian bree_sasha_threesome_2_d652fb54:
    "Не поймите неправильно: [lssb_homepair.bree_name()] от природы обладает грудью прекрасного размера и формы, и мне она очень нравится."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1711
translate russian bree_sasha_threesome_2_ad6b5287:
    "Но в имплантах, увеличивших грудь Саши до сопоставимого размера, есть что-то восхитительно искусственное и порочное."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1712
translate russian bree_sasha_threesome_2_6706f2bf:
    "Я беру её за руку и показываю, что хочу поставить её перед собой, спиной к моему животу. Её груди прыгают и покачиваются, как резиновые мячи."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1713
translate russian bree_sasha_threesome_2_d6b9f7c8:
    "Даже когда она стоит ко мне спиной, я всё равно вижу, как они выступают вперёд!"

# ch/harems/home/events/home_harem_bree_sasha.rpy:1715
translate russian bree_sasha_threesome_2_6fc8734d:
    "Я протягиваю руку, беру Сашу за ладонь, ставлю перед собой и разворачиваю спиной."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1716
translate russian bree_sasha_threesome_2_7155f6ef:
    "Её попка всего в нескольких сантиметрах от моего твердеющего члена, и вблизи хорошо видны чёрные корни её светлых волос."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1717
translate russian bree_sasha_threesome_2_ee23fc2a:
    "Не знаю почему, но этот переход от чёрного к светлому всегда меня заводит."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1718
translate russian bree_sasha_threesome_2_0414a181:
    "Может, потому что так она выглядит восхитительно вульгарной и дешёвой..."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1720
translate russian bree_sasha_threesome_2_d63367c7:
    "[lssb_homepair.bree_name()] и Саша послушно стоят передо мной в ошейниках. Казалось бы, это должно всё упростить."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1721
translate russian bree_sasha_threesome_2_e10a2c3e:
    "И всё же решиться трудно. Я беру поводок Саши и даю понять, что сегодня трахать собираюсь именно её."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1722
translate russian bree_sasha_threesome_2_6c3727fd:
    "Саша тут же радуется, что выбрали её. А [lssb_homepair.bree_name()], как я вижу, старается скрыть разочарование, чтобы не испортить момент."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1723
translate russian bree_sasha_threesome_2_45965d32:
    "Может, поэтому я действую чуть жёстче, чем обычно: дёргаю поводок Саши, заставляя её быстро обойти меня и встать впереди."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1728
translate russian bree_sasha_threesome_2_f5bab666:
    "Саше не терпится начать. Она торопливо забирается на кровать передо мной и оглядывается через плечо, проверяя, иду ли я следом."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1729
translate russian bree_sasha_threesome_2_20d12aef:
    "Она могла бы не волноваться: при этих движениях её бёдер мне открывается прекрасный вид на самое сокровенное между ними."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1730
translate russian bree_sasha_threesome_2_57622757:
    "Мы едва начали, но я уже вижу, как её губы всё сильнее увлажняются от предвкушения."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1731
translate russian bree_sasha_threesome_2_91c1d90d:
    "Клянусь, мне даже кажется, что я слышу влажный звук, когда она двигается."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1732
translate russian bree_sasha_threesome_2_8e0c25fd:
    "И сейчас нигде мне не хочется оказаться сильнее, чем именно там."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1733
translate russian bree_sasha_threesome_2_bb2bb196:
    "Саша едва успевает отползти по кровати на полметра, а я уже забираюсь следом."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1735
translate russian bree_sasha_threesome_2_2344a4ce:
    "Я довольно грубо хватаю её за талию, крепкой хваткой ясно давая понять, что дальше она не уйдёт."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1736
translate russian bree_sasha_threesome_2_2ec7c7da:
    "Она вскрикивает от неподдельного удивления, когда я хватаю её и полностью беру всё в свои руки."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1738
translate russian bree_sasha_threesome_2_03db6ebd:
    "Но я с зарождающейся улыбкой отмечаю, что она не возражает и не пытается вырваться."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1739
translate russian bree_sasha_threesome_2_cfb50971:
    "Не меняя положения рук на её талии, я тяну Сашу назад, к себе."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1741
translate russian bree_sasha_threesome_2_be4fc6e0:
    "Одновременно я подаюсь ей навстречу, доверяя природе направить меня точно в цель."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1745
translate russian bree_sasha_threesome_2_69df29f6:
    "На секунду-другую мне кажется, что мой член войдёт прямо ей в задницу."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1746
translate russian bree_sasha_threesome_2_0432f7e7:
    "Но затем я чувствую скользкую влажность её киски, и это заставляет меня толкаться ещё нетерпеливее."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1748
translate russian bree_sasha_threesome_2_35dc14b5:
    "Я вхожу в Сашу не самым плавным и нежным движением, но сейчас не время для деликатности."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1749
translate russian bree_sasha_threesome_2_015f9d8d:
    "Хоть она уже изрядно намокла от предвкушения, мне всё равно приходится сильно надавить, чтобы войти одним движением."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1750
translate russian bree_sasha_threesome_2_12f995cd:
    "Саша издаёт глубокий протяжный стон, пока я продолжаю, погружая член до самого предела."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1753
translate russian bree_sasha_threesome_2_7f5c2aeb:
    "Я вроде бы целился в киску Саши, уже предвкушая влажное прикосновение её губ к моему члену."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1755
translate russian bree_sasha_threesome_2_42e1c537:
    "Но почему-то промахиваюсь, и он оказывается зажат между ягодицами."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1756
translate russian bree_sasha_threesome_2_5f5412b7:
    "Едва головка входит ей в задницу, Саша вскрикивает от неожиданности."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1757
translate russian bree_sasha_threesome_2_8067192a:
    sasha.say "О боже..."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1758
translate russian bree_sasha_threesome_2_928002f0:
    sasha.say "Моя задница..."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1759
translate russian bree_sasha_threesome_2_d0f7babb:
    sasha.say "Это моя задница!"

# ch/harems/home/events/home_harem_bree_sasha.rpy:1760
translate russian bree_sasha_threesome_2_1005e7d6:
    "Я не останавливаюсь ни на секунду, не давая Саше возможности возразить."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1761
translate russian bree_sasha_threesome_2_cedfd92e:
    "Вместо этого делаю один мощный толчок, разом входя в её задницу."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1762
translate russian bree_sasha_threesome_2_e9ec8d0d:
    "Вскоре её мышцы начинают поддаваться, а вскрики сменяются стонами удовольствия."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1763
translate russian bree_sasha_threesome_2_5d93a4d8:
    "Не проявляя к Саше ни капли жалости, я успокаиваю себя очевидными признаками того, что ей нравится такое обращение."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1764
translate russian bree_sasha_threesome_2_618d5acb:
    "Всё это время она ахает и стонет от грубого удовольствия, от которого перехватывает дыхание."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1765
translate russian bree_sasha_threesome_2_97045c62:
    "И такого обращения будет ещё много: резкий толчок, которым я вошёл в неё, только разжёг желание продолжать в том же духе."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1766
translate russian bree_sasha_threesome_2_c154ad00:
    "С каждым толчком я словно пытаюсь заполнить Сашу целиком, проникнуть как можно глубже."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1767
translate russian bree_sasha_threesome_2_6af7b3f8:
    "Каждое моё движение будто потрясает её до глубины, вызывая дрожь и спазмы в мышцах."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1768
translate russian bree_sasha_threesome_2_0ef0835b:
    "Её стоны уже переходят в крики, точно совпадающие с ритмом моих движений внутрь и наружу."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1770
translate russian bree_sasha_threesome_2_37650201:
    "[lssb_homepair.bree_name()] начинает ласкать меня в надежде тоже привлечь внимание."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1771
translate russian bree_sasha_threesome_2_227b609e:
    "Мне сразу становится стыдно: я почти забыл, что она вообще здесь, хотя она тоже должна участвовать в наших любовных утехах."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1772
translate russian bree_sasha_threesome_2_8b087476:
    "Я не могу да и не очень хочу отвлекаться от Саши, поэтому отпускаю её талию одной рукой и протягиваю её туда, где стоит [lssb_homepair.bree_name()]."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1776
translate russian bree_sasha_threesome_2_c9a9feb7:
    "Больше полагаясь на инстинкт, я нащупываю место между её бёдер."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1777
translate russian bree_sasha_threesome_2_46c3e250:
    "К счастью, мою руку крепко хватают и ведут прямо туда, куда я и стремился."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1778
translate russian bree_sasha_threesome_2_e08287ac:
    "Могу сказать лишь одно: наблюдая за нами с Сашей, она, должно быть, сильно возбудилась."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1779
translate russian bree_sasha_threesome_2_657b6d02:
    "[lssb_homepair.bree_name()] почти отчаянно прижимает мои пальцы к своим половым губам. Её промежность тёплая и мокрая на ощупь."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1782
translate russian bree_sasha_threesome_2_f0992ec3:
    "Не успеваю я опомниться, как мои пальцы уже проникают всё глубже в её киску."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1783
translate russian bree_sasha_threesome_2_a5d3fc50:
    "Не умея полностью разделить внимание, я толкаюсь в Сашу и двигаю пальцами в том же ритме. [lssb_homepair.bree_name()] получает свои ласки одновременно."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1784
translate russian bree_sasha_threesome_2_ceeea96d:
    "Не знаю, замечает ли Саша перемену ритма из-за того, что [lssb_homepair.bree_name()] тоже требует внимания, или просто слышит её стоны удовольствия."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1786
translate russian bree_sasha_threesome_2_5e7bc8b6:
    "Так или иначе, она двигается подо мной, и мой член выскальзывает из неё."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1787
translate russian bree_sasha_threesome_2_8d87a887:
    "Сначала я думаю, что она злится, лишившись большей части моего внимания."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1788
translate russian bree_sasha_threesome_2_fbe56165:
    "Но затем она почти отчаянно кивает, призывая продолжать и доставлять удовольствие им обеим сразу!"

# ch/harems/home/events/home_harem_bree_sasha.rpy:1791
translate russian bree_sasha_threesome_2_ed9f68b3:
    "Больше полагаясь на инстинкт, я нащупываю место между её ягодицами."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1792
translate russian bree_sasha_threesome_2_46c3e250_1:
    "К счастью, мою руку крепко хватают и ведут прямо туда, куда я и стремился."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1793
translate russian bree_sasha_threesome_2_e08287ac_1:
    "Могу сказать лишь одно: наблюдая за нами с Сашей, она, должно быть, сильно возбудилась."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1794
translate russian bree_sasha_threesome_2_5c413f0a:
    "[lssb_homepair.bree_name()] почти отчаянно прижимает мои пальцы к своему анусу. Её попка тёплая и скользкая от пота."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1797
translate russian bree_sasha_threesome_2_62e61ad6:
    "Не успеваю я опомниться, как мои пальцы уже проникают всё глубже в её задницу."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1798
translate russian bree_sasha_threesome_2_a5d3fc50_1:
    "Не умея полностью разделить внимание, я толкаюсь в Сашу и двигаю пальцами в том же ритме. [lssb_homepair.bree_name()] получает свои ласки одновременно."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1799
translate russian bree_sasha_threesome_2_ceeea96d_1:
    "Не знаю, замечает ли Саша перемену ритма из-за того, что [lssb_homepair.bree_name()] тоже требует внимания, или просто слышит её стоны удовольствия."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1801
translate russian bree_sasha_threesome_2_5e7bc8b6_1:
    "Так или иначе, она двигается подо мной, и мой член выскальзывает из неё."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1802
translate russian bree_sasha_threesome_2_8d87a887_1:
    "Сначала я думаю, что она злится, лишившись большей части моего внимания."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1803
translate russian bree_sasha_threesome_2_fbe56165_1:
    "Но затем она почти отчаянно кивает, призывая продолжать и доставлять удовольствие им обеим сразу!"

# ch/harems/home/events/home_harem_bree_sasha.rpy:1805
translate russian bree_sasha_threesome_2_52dee4e7:
    "Больше полагаясь на инстинкт, я нащупываю фаллоимитатор, который всегда держу у кровати."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1808
translate russian bree_sasha_threesome_2_e144126f:
    "Прежде чем кто-то успевает возразить, [lssb_homepair.bree_name()] уже чувствует игрушку между бёдер."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1809
translate russian bree_sasha_threesome_2_46c3e250_2:
    "К счастью, мою руку крепко хватают и ведут прямо туда, куда я и стремился."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1810
translate russian bree_sasha_threesome_2_e08287ac_2:
    "Могу сказать лишь одно: наблюдая за нами с Сашей, она, должно быть, сильно возбудилась."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1811
translate russian bree_sasha_threesome_2_dab4f60c:
