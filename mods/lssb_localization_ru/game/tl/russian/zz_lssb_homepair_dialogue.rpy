# ch/harems/home/events/home_harem_bree_sasha.rpy:1812
translate russian bree_sasha_threesome_2_61a2a642:
    "Не успеваю я опомниться, как игрушка уже проникает всё глубже в её киску."

# ch/harems/home/events/home_harem_bree_sasha.rpy:1813
