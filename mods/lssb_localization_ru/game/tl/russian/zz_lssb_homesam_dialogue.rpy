# ch/harems/home/events/home_harem_samantha.rpy:1309
translate russian lesbian_sex_bree_sam_86861a27:
    "И [lssb_homesam.bree_name()], похоже, получает от этого огромное удовольствие!"

# ch/harems/home/events/home_harem_samantha.rpy:1310
translate russian lesbian_sex_bree_sam_ec4f9c86:
