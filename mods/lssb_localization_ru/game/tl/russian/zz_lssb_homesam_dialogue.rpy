# ch/harems/home/events/home_harem_samantha.rpy:1624
translate russian sexual_tension_sam_sasha_b872dd4d:
    sasha.say "Совсем нет!"

# ch/harems/home/events/home_harem_samantha.rpy:1625
translate russian sexual_tension_sam_sasha_4840e7f8:
    sasha.say "Просто никогда бы не подумала, что ты увлекаешься роком!"

# ch/harems/home/events/home_harem_samantha.rpy:1627
translate russian sexual_tension_sam_sasha_c5367922:
