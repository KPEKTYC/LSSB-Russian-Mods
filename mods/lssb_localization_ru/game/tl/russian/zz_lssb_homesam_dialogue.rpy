# ch/harems/home/events/home_harem_samantha.rpy:1718
translate russian lesbian_sex_sam_sasha_06196cff:
    "Я оглядываюсь, убеждаясь, что рядом никого нет."

# ch/harems/home/events/home_harem_samantha.rpy:1719
translate russian lesbian_sex_sam_sasha_ff2c60d1:
