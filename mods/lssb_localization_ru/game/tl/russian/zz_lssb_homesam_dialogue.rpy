# ch/harems/home/events/home_harem_samantha.rpy:1276
translate russian lesbian_sex_bree_sam_a44ba19c:
    "[lssb_homesam.bree_name()] встречает её взгляд снизу, а Сэм смотрит на неё с уверенной улыбкой."

# ch/harems/home/events/home_harem_samantha.rpy:1277
translate russian lesbian_sex_bree_sam_3204df09:
