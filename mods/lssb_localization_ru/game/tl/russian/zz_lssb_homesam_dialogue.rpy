# ch/harems/home/events/home_harem_samantha.rpy:1677
translate russian sexual_tension_sam_sasha_c371312e:
    sasha.say "Сэм как раз собиралась показать мне свои татуировки!"

# ch/harems/home/events/home_harem_samantha.rpy:1678
translate russian sexual_tension_sam_sasha_3adc8304:
    "Мне нужно несколько секунд, чтобы отреагировать на слова Саши."

# ch/harems/home/events/home_harem_samantha.rpy:1679
translate russian sexual_tension_sam_sasha_6d1bef59:
    "Наверное, я ожидал, что она продолжит всё отрицать даже после ухода Сэм."

# ch/harems/home/events/home_harem_samantha.rpy:1680
translate russian sexual_tension_sam_sasha_c35d45ff:
    mike.say "Правда, Саша?"

# ch/harems/home/events/home_harem_samantha.rpy:1681
translate russian sexual_tension_sam_sasha_875d9d10:
    mike.say "А я думал, вы просто болтали."

# ch/harems/home/events/home_harem_samantha.rpy:1683
translate russian sexual_tension_sam_sasha_3625d79f:
