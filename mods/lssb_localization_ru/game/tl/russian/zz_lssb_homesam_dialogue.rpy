# ch/harems/home/events/home_harem_samantha.rpy:970
translate russian introduce_sam_to_girls_4ea39c33:
    "А он стремительно превращается в прелюдию к оргии!"

# ch/harems/home/events/home_harem_samantha.rpy:972
translate russian introduce_sam_to_girls_ca80bdf6:
    mike.say "Всё не так, как они представляют, Кексик. Правда!"

# ch/harems/home/events/home_harem_samantha.rpy:974
translate russian introduce_sam_to_girls_abefe7db:
    mike.say "Всё не так, как они представляют, Сэм. Правда!"

# ch/harems/home/events/home_harem_samantha.rpy:975
translate russian introduce_sam_to_girls_85f5c4bf:
    mike.say "Я хочу сказать, задний двор довольно уединённый."

# ch/harems/home/events/home_harem_samantha.rpy:976
translate russian introduce_sam_to_girls_22c76f97:
