# ch/harems/home/events/home_harem_samantha.rpy:1736
translate russian lesbian_sex_sam_sasha_969efb99:
    "Наверное, это заслуженное наказание за мысль, что подглядывать за соседками нормально!"

# ch/harems/home/events/home_harem_samantha.rpy:1737
translate russian lesbian_sex_sam_sasha_4602b030:
    "Не поймите неправильно: я вовсе не осуждаю то, чем там занимаются Сэм и Саша."

# ch/harems/home/events/home_harem_samantha.rpy:1738
translate russian lesbian_sex_sam_sasha_8efe63be:
    "Просто я не был готов узнать об этом вот так."

# ch/harems/home/events/home_harem_samantha.rpy:1739
translate russian lesbian_sex_sam_sasha_a0ab986e:
    "И, ну... Пожалуй, я ещё и изрядно ревную!"

# ch/harems/home/events/home_harem_samantha.rpy:1740
translate russian lesbian_sex_sam_sasha_69620834:
    "Я всегда был неравнодушен к Сэм, ещё когда она была замужем за Райаном."

# ch/harems/home/events/home_harem_samantha.rpy:1741
translate russian lesbian_sex_sam_sasha_0fc86011:
    "Теперь, когда она снова свободна, я подумал, что у меня появился шанс."

# ch/harems/home/events/home_harem_samantha.rpy:1742
translate russian lesbian_sex_sam_sasha_8529287d:
    "Но, похоже, Саша меня опередила!"

# ch/harems/home/events/home_harem_samantha.rpy:1743
translate russian lesbian_sex_sam_sasha_05253fd2:
    "Я отхожу от двери её спальни так быстро и тихо, как только могу."

# ch/harems/home/events/home_harem_samantha.rpy:1744
translate russian lesbian_sex_sam_sasha_98ba8f34:
    "Хотя вряд ли скоро смогу выбросить эту картину из головы."

# ch/harems/home/events/home_harem_samantha.rpy:1747
translate russian lesbian_sex_sam_sasha_c0b5fa5e:
    "Я прижимаю глаз ближе к скважине, стараясь лучше разглядеть происходящее."

# ch/harems/home/events/home_harem_samantha.rpy:1748
translate russian lesbian_sex_sam_sasha_231a1a13:
    "Пока я смотрю, все мысли о том, что это неуместно, мгновенно исчезают."

# ch/harems/home/events/home_harem_samantha.rpy:1749
translate russian lesbian_sex_sam_sasha_60d05c8d:
    "Как вообще можно упустить такую возможность?"

# ch/harems/home/events/home_harem_samantha.rpy:1750
translate russian lesbian_sex_sam_sasha_8bb9e09e:
    "Две горячие девушки, живущие со мной под одной крышей, занимаются там сексом!"

# ch/harems/home/events/home_harem_samantha.rpy:1751
translate russian lesbian_sex_sam_sasha_d77e2bbb:
    "Я бы себе не простил, если бы не сделал всё возможное, чтобы посмотреть!"

# ch/harems/home/events/home_harem_samantha.rpy:1752
translate russian lesbian_sex_sam_sasha_886efd44:
    "Совершенно очевидно, что здесь ведёт Саша."

# ch/harems/home/events/home_harem_samantha.rpy:1753
translate russian lesbian_sex_sam_sasha_c5d8dfa3:
    "Не только из-за страпона: похоже, она ещё и всем распоряжается."

# ch/harems/home/events/home_harem_samantha.rpy:1754
translate russian lesbian_sex_sam_sasha_ea7d3fb3:
    "А Сэм, напротив, вполне довольна тем, что лежит и принимает ласки."

# ch/harems/home/events/home_harem_samantha.rpy:1755
translate russian lesbian_sex_sam_sasha_3e2a385b:
    sasha.say "Ты готова, Сэм?"

# ch/harems/home/events/home_harem_samantha.rpy:1756
translate russian lesbian_sex_sam_sasha_0b695bbe:
    sasha.say "Готова расплатиться за ночлег в моей комнате?"

# ch/harems/home/events/home_harem_samantha.rpy:1757
translate russian lesbian_sex_sam_sasha_b4822eef:
    "Говоря это, Саша подаёт фаллоимитатор вперёд."

# ch/harems/home/events/home_harem_samantha.rpy:1758
translate russian lesbian_sex_sam_sasha_40cc6b1f:
    "Он нависает над Сэм и покачивается с неким угрожающим видом."

# ch/harems/home/events/home_harem_samantha.rpy:1759
translate russian lesbian_sex_sam_sasha_3e984e49:
    "Она кивает, широко раскрыв глаза от возбуждения, к которому, кажется, примешивается лёгкий страх."

# ch/harems/home/events/home_harem_samantha.rpy:1760
translate russian lesbian_sex_sam_sasha_3877c05d:
    "Сэм тянется вверх и начинает гладить его обеими руками."

# ch/harems/home/events/home_harem_samantha.rpy:1761
translate russian lesbian_sex_sam_sasha_5df0fdcd:
    samantha.say "Д... да, Саша..."

# ch/harems/home/events/home_harem_samantha.rpy:1762
translate russian lesbian_sex_sam_sasha_3ef26426:
    samantha.say "Я готова расплатиться!"

# ch/harems/home/events/home_harem_samantha.rpy:1763
translate russian lesbian_sex_sam_sasha_712759db:
    samantha.say "Но... пожалуйста, будь нежной?"

# ch/harems/home/events/home_harem_samantha.rpy:1764
translate russian lesbian_sex_sam_sasha_1798a595:
    "Саша усмехается и качает головой."

# ch/harems/home/events/home_harem_samantha.rpy:1765
translate russian lesbian_sex_sam_sasha_2b1297f3:
    "Очевидно, ей нравится покорная роль Сэм в происходящем."

# ch/harems/home/events/home_harem_samantha.rpy:1767
translate russian lesbian_sex_sam_sasha_7d1429d6:
    "И её улыбка лишь расширяется, когда она опускает фаллоимитатор к цели."

# ch/harems/home/events/home_harem_samantha.rpy:1768
translate russian lesbian_sex_sam_sasha_1ce9b8ed:
    "Сэм тоже не убирает рук, направляя его между своих бёдер."

# ch/harems/home/events/home_harem_samantha.rpy:1769
translate russian lesbian_sex_sam_sasha_553bdbfb:
    "Ну, по крайней мере, почти всё время держит его одной рукой."

# ch/harems/home/events/home_harem_samantha.rpy:1770
translate russian lesbian_sex_sam_sasha_b7c3bb1b:
    "Другая то и дело скользит к киске, поглаживая и лаская её складки."

# ch/harems/home/events/home_harem_samantha.rpy:1771
translate russian lesbian_sex_sam_sasha_bd307af9:
    "Поэтому, когда Саша устраивается как нужно, Сэм уже более чем готова."

# ch/harems/home/events/home_harem_samantha.rpy:1772
translate russian lesbian_sex_sam_sasha_52395826:
    samantha.say "М-м-м..."

# ch/harems/home/events/home_harem_samantha.rpy:1773
translate russian lesbian_sex_sam_sasha_93338de3:
    samantha.say "Ох, Саша..."

# ch/harems/home/events/home_harem_samantha.rpy:1774
translate russian lesbian_sex_sam_sasha_acd3ae82:
    samantha.say "Не останавливайся..."

# ch/harems/home/events/home_harem_samantha.rpy:1775
translate russian lesbian_sex_sam_sasha_41d00229:
    "Саша расплывается в улыбке, вводя фаллоимитатор в Сэм."

# ch/harems/home/events/home_harem_samantha.rpy:1776
translate russian lesbian_sex_sam_sasha_d7da4ebe:
    "Она движется плавно и медленно, давая девушке прочувствовать каждое мгновение."

# ch/harems/home/events/home_harem_samantha.rpy:1778
translate russian lesbian_sex_sam_sasha_74ef1398:
    "А войдя до конца, остаётся на месте и начинает вращать бёдрами."

# ch/harems/home/events/home_harem_samantha.rpy:1779
translate russian lesbian_sex_sam_sasha_7a3b9ead:
    "Поначалу Саша не двигается взад-вперёд, а совершает круговые движения тазом."

# ch/harems/home/events/home_harem_samantha.rpy:1780
translate russian lesbian_sex_sam_sasha_4f5025e3:
    "Сэм реагирует мгновенно, запрокидывая голову на кровать."

# ch/harems/home/events/home_harem_samantha.rpy:1781
translate russian lesbian_sex_sam_sasha_489df347:
    "С места, где я стою на коленях, видно, как у неё закатываются глаза."

# ch/harems/home/events/home_harem_samantha.rpy:1782
translate russian lesbian_sex_sam_sasha_93be4008:
    "После этого она уже не способна произнести ни слова."

# ch/harems/home/events/home_harem_samantha.rpy:1783
translate russian lesbian_sex_sam_sasha_8d8efd02:
    "Кажется, единственные доступные ей звуки — безумные стоны."

# ch/harems/home/events/home_harem_samantha.rpy:1784
translate russian lesbian_sex_sam_sasha_3654b78f:
    "Я перевожу взгляд выше, чтобы понять, что именно делает с ней Саша."

# ch/harems/home/events/home_harem_samantha.rpy:1786
translate russian lesbian_sex_sam_sasha_5205fc33:
    "И сразу становится ясно, почему Сэм в таком исступлении."

# ch/harems/home/events/home_harem_samantha.rpy:1787
translate russian lesbian_sex_sam_sasha_75b3641f:
    "Саша широко раздвинула ноги и почти присела над ней."

# ch/harems/home/events/home_harem_samantha.rpy:1788
translate russian lesbian_sex_sam_sasha_fd1040a1:
    "И использует получившиеся высоту и угол с максимальной отдачей!"

# ch/harems/home/events/home_harem_samantha.rpy:1789
translate russian lesbian_sex_sam_sasha_7a38dfbc:
    "Теперь Саша почти что вколачивается в Сэм изо всех сил."

# ch/harems/home/events/home_harem_samantha.rpy:1790
translate russian lesbian_sex_sam_sasha_873bccc7:
    "А той остаётся лишь лежать и принимать это!"

# ch/harems/home/events/home_harem_samantha.rpy:1793
translate russian lesbian_sex_sam_sasha_ccf433da:
    "Сам не думая, я расстёгиваю ширинку и запускаю руку в штаны."

# ch/harems/home/events/home_harem_samantha.rpy:1794
translate russian lesbian_sex_sam_sasha_13dea40b:
    "Мой член твёрдый как камень почти с того мига, когда я начал за ними наблюдать."

# ch/harems/home/events/home_harem_samantha.rpy:1795
translate russian lesbian_sex_sam_sasha_fce69d36:
    "Но теперь я чувствую, что нужно как-то сбросить и собственное напряжение."

# ch/harems/home/events/home_harem_samantha.rpy:1796
translate russian lesbian_sex_sam_sasha_b443f470:
    "И каждый раз, когда фаллоимитатор входит в Сэм, я в такт поглаживаю свой член."

# ch/harems/home/events/home_harem_samantha.rpy:1797
translate russian lesbian_sex_sam_sasha_dc56f0d4:
    "Вскоре я тоже тяжело дышу и ахаю вместе с ней, чувствуя каждое движение Саши!"

# ch/harems/home/events/home_harem_samantha.rpy:1798
translate russian lesbian_sex_sam_sasha_47f6cc0d:
    "Поэтому, когда Сэм, кажется, вот-вот кончит, я чувствую, что тоже изливаюсь."

# ch/harems/home/events/home_harem_samantha.rpy:1800
translate russian lesbian_sex_sam_sasha_221ecb67:
    "Я думаю о том, чтобы запустить руку в штаны и ласкать себя в такт им."

# ch/harems/home/events/home_harem_samantha.rpy:1801
translate russian lesbian_sex_sam_sasha_7061d844:
    "Но боюсь, что меня поймают за этим у двери Саши, и отказываюсь от затеи."

# ch/harems/home/events/home_harem_samantha.rpy:1802
translate russian lesbian_sex_sam_sasha_7803042c:
    "Вместо этого говорю себе, что успею позже, когда останусь один."

# ch/harems/home/events/home_harem_samantha.rpy:1803
translate russian lesbian_sex_sam_sasha_4b60c903:
    "Потому что забыть увиденное там я точно не смогу!"

# ch/harems/home/events/home_harem_samantha.rpy:1804
translate russian lesbian_sex_sam_sasha_54bd57e7:
    "Вскоре Сэм и так, похоже, уже близка к оргазму."

# ch/harems/home/events/home_harem_samantha.rpy:1805
translate russian lesbian_sex_sam_sasha_e71bfe57:
    sasha.say "Нравится, да?"

# ch/harems/home/events/home_harem_samantha.rpy:1806
translate russian lesbian_sex_sam_sasha_2607cd5e:
    sasha.say "Нравится то, что я могу тебе дать?"

# ch/harems/home/events/home_harem_samantha.rpy:1807
translate russian lesbian_sex_sam_sasha_15ae2e99:
    "Сэм может лишь кивать, пока Саша доводит её до оргазма."

# ch/harems/home/events/home_harem_samantha.rpy:1808
translate russian lesbian_sex_sam_sasha_907a27de:
    "Я вижу, как она вцепляется в постельное бельё, словно от этого зависит её жизнь."

# ch/harems/home/events/home_harem_samantha.rpy:1810
translate russian lesbian_sex_sam_sasha_290c2534:
    "Одновременно Сэм ахает, охваченная оргазмом."

# ch/harems/home/events/home_harem_samantha.rpy:1811
translate russian lesbian_sex_sam_sasha_9e130f17:
    "Я принимаю это за сигнал убраться отсюда."

# ch/harems/home/events/home_harem_samantha.rpy:1812
translate russian lesbian_sex_sam_sasha_e4b69d42:
    "Последнее, что я вижу в замочную скважину, — клубок переплетённых потных тел."

# ch/harems/home/events/home_harem_samantha.rpy:1813
translate russian lesbian_sex_sam_sasha_7ff54a55:
    "Затем добираюсь до своей комнаты и закрываю за собой дверь."

# ch/harems/home/events/home_harem_samantha.rpy:1816
translate russian lesbian_sex_sam_sasha_307df1da:
    "Честно говоря, не знаю, радоваться ли тому, как хорошо Сэм вписывается."

# ch/harems/home/events/home_harem_samantha.rpy:1817
translate russian lesbian_sex_sam_sasha_2d7b3e31:
    "И тому, как много Саша делает, чтобы помочь ей освоиться."

# ch/harems/home/events/home_harem_samantha.rpy:1818
translate russian lesbian_sex_sam_sasha_0284cc81:
    "Или ревновать, что мне ничего из этих развлечений не достаётся!"

# ch/harems/home/events/home_harem_samantha.rpy:1822
translate russian sexual_tension_sam_minami_eb17a0e7:
    "Я переживал, насколько странно Сэм будет возвращаться в этот дом."

# ch/harems/home/events/home_harem_samantha.rpy:1823
translate russian sexual_tension_sam_minami_c3908ba0:
    "Она возвращается сюда вместе со всеми воспоминаниями, которые здесь наверняка остались."

# ch/harems/home/events/home_harem_samantha.rpy:1824
translate russian sexual_tension_sam_minami_f431140f:
    "Вдобавок ей приходится справляться с последствиями развода с Райаном."

# ch/harems/home/events/home_harem_samantha.rpy:1825
translate russian sexual_tension_sam_minami_b2d582ee:
    "Я хочу помочь, как только могу, и быть хорошим другом."

# ch/harems/home/events/home_harem_samantha.rpy:1826
translate russian sexual_tension_sam_minami_bc28ecb8:
    "Даже если ради этого придётся отложить собственные чувства на сколько потребуется."

# ch/harems/home/events/home_harem_samantha.rpy:1831
translate russian sexual_tension_sam_minami_207e9882:
    "Но, застав Минами и Сэм вместе, я приятно удивляюсь."

# ch/harems/home/events/home_harem_samantha.rpy:1832
translate russian sexual_tension_sam_minami_fcaa8907:
    "Они болтают, словно старые подруги."

# ch/harems/home/events/home_harem_samantha.rpy:1833
translate russian sexual_tension_sam_minami_383e017e:
    "И это вселяет надежду, что они поладят."

# ch/harems/home/events/home_harem_samantha.rpy:1834
translate russian sexual_tension_sam_minami_c3af6b95:
    minami.say "О да, Сэм..."

# ch/harems/home/events/home_harem_samantha.rpy:1835
translate russian sexual_tension_sam_minami_0e7ceaab:
    minami.say "Я сама делаю ВСЕ костюмы."

# ch/harems/home/events/home_harem_samantha.rpy:1837
translate russian sexual_tension_sam_minami_0ec5973c:
    minami.say "Именно поэтому косплей приносит столько удовольствия."

# ch/harems/home/events/home_harem_samantha.rpy:1838
translate russian sexual_tension_sam_minami_435c9fd3:
    "Сэм слушает Минами с искренним интересом."

# ch/harems/home/events/home_harem_samantha.rpy:1839
translate russian sexual_tension_sam_minami_357e97a1:
    "А моей младшей сестре явно нравится такое внимание!"

# ch/harems/home/events/home_harem_samantha.rpy:1840
translate russian sexual_tension_sam_minami_6b75924c:
    samantha.say "Ах..."

# ch/harems/home/events/home_harem_samantha.rpy:1841
translate russian sexual_tension_sam_minami_338f4d6c:
    samantha.say "У меня никогда не получалось ничего подобного, Минами!"

# ch/harems/home/events/home_harem_samantha.rpy:1844
translate russian sexual_tension_sam_minami_47146275:
    samantha.say "Всё, что я умела делать иголкой с ниткой, — превращать большой палец в подушечку для булавок!"

# ch/harems/home/events/home_harem_samantha.rpy:1845
translate russian sexual_tension_sam_minami_130a1060:
    "Минами хихикает и качает головой."

# ch/harems/home/events/home_harem_samantha.rpy:1846
translate russian sexual_tension_sam_minami_67f98d0c:
    "Её улыбка тёплая и совершенно искренняя."

# ch/harems/home/events/home_harem_samantha.rpy:1847
translate russian sexual_tension_sam_minami_b3638b3a:
    minami.say "Не глупи, Сэм!"

# ch/harems/home/events/home_harem_samantha.rpy:1848
translate russian sexual_tension_sam_minami_3486bc4c:
    minami.say "Ты бы моментально освоила основы."

# ch/harems/home/events/home_harem_samantha.rpy:1850
translate russian sexual_tension_sam_minami_d47f483a:
    minami.say "Потому что я довольно хорошая учительница."

# ch/harems/home/events/home_harem_samantha.rpy:1852
translate russian sexual_tension_sam_minami_6c95e5c5:
    "Я смотрю, как Минами слегка откидывается назад и щурится на Сэм."

# ch/harems/home/events/home_harem_samantha.rpy:1854
translate russian sexual_tension_sam_minami_b4cf8e9f:
    "Сэм, кажется, замечает это и смотрит с любопытством."

# ch/harems/home/events/home_harem_samantha.rpy:1855
translate russian sexual_tension_sam_minami_9f1f5fc4:
    "Но Минами продолжает оценивать её фигуру."

# ch/harems/home/events/home_harem_samantha.rpy:1856
translate russian sexual_tension_sam_minami_6025430e:
    samantha.say "Чт..."

# ch/harems/home/events/home_harem_samantha.rpy:1857
translate russian sexual_tension_sam_minami_14e45e5f:
    samantha.say "На что ты смотришь, Минами?"

# ch/harems/home/events/home_harem_samantha.rpy:1859
translate russian sexual_tension_sam_minami_7ce6d5ec:
