translate russian home_harem_confession_to_sam_c3920c45:
    samantha.say "У тебя оргии со всеми этими девушками?"

# ch/harems/home/events/home_harem_samantha.rpy:2268
translate russian home_harem_confession_to_sam_0540332c:
    mike.say "Послушай, Кексик..."

# ch/harems/home/events/home_harem_samantha.rpy:2270
translate russian home_harem_confession_to_sam_6da8c0d3:
    mike.say "Послушай, Сэм..."

# ch/harems/home/events/home_harem_samantha.rpy:2271
translate russian home_harem_confession_to_sam_7c895a5b:
    mike.say "Я понимаю, если ты злишься..."

# ch/harems/home/events/home_harem_samantha.rpy:2273
translate russian home_harem_confession_to_sam_80a8f244:
    samantha.say "Скорее потрясена, [lssb_common.hero_name()]."

# ch/harems/home/events/home_harem_samantha.rpy:2274
translate russian home_harem_confession_to_sam_70f105ba:
    samantha.say "Никогда бы не подумала, что ты на такое способен!"

# ch/harems/home/events/home_harem_samantha.rpy:2275
translate russian home_harem_confession_to_sam_bc5eb483:
    "Честно говоря, не знаю, гордиться этим или обижаться."

# ch/harems/home/events/home_harem_samantha.rpy:2276
translate russian home_harem_confession_to_sam_47c235b8:
    "Поэтому решаю пропустить это мимо ушей и продолжить."

# ch/harems/home/events/home_harem_samantha.rpy:2277
translate russian home_harem_confession_to_sam_c65834a1:
    mike.say "Просто подумал, что лучше тебе узнать от меня."

# ch/harems/home/events/home_harem_samantha.rpy:2278
translate russian home_harem_confession_to_sam_66f9942e:
    mike.say "Чем случайно наткнуться на это, понимаешь?"

# ch/harems/home/events/home_harem_samantha.rpy:2279
translate russian home_harem_confession_to_sam_900ee36d:
    "Сэм кивает, но затем становится серьёзной."

# ch/harems/home/events/home_harem_samantha.rpy:2280
translate russian home_harem_confession_to_sam_d94437ff:
    samantha.say "И что теперь, когда я знаю?"

# ch/harems/home/events/home_harem_samantha.rpy:2281
translate russian home_harem_confession_to_sam_b4d425ab:
    mike.say "Ну, дело вот в чём..."

# ch/harems/home/events/home_harem_samantha.rpy:2282
translate russian home_harem_confession_to_sam_a792ab00:
    mike.say "Я хотел спросить, не хочешь ли ты тоже?"

# ch/harems/home/events/home_harem_samantha.rpy:2283
translate russian home_harem_confession_to_sam_281e20fa:
    mike.say "Не хочешь ли присоединиться к нам?"

# ch/harems/home/events/home_harem_samantha.rpy:2286
translate russian home_harem_confession_to_sam_f407402b:
    "Сэм некоторое время смотрит на меня, снова удивлённая."

# ch/harems/home/events/home_harem_samantha.rpy:2287
translate russian home_harem_confession_to_sam_75942dc7:
    "Но затем её выражение становится более определённым."

# ch/harems/home/events/home_harem_samantha.rpy:2288
translate russian home_harem_confession_to_sam_68bad044:
    "Предложение её заинтриговало."

# ch/harems/home/events/home_harem_samantha.rpy:2290
translate russian home_harem_confession_to_sam_2fecee22:
    "Более того, с каждой секундой она, кажется, всё больше воодушевляется!"

# ch/harems/home/events/home_harem_samantha.rpy:2291
translate russian home_harem_confession_to_sam_95e6cdbf:
    samantha.say "Ты..."

# ch/harems/home/events/home_harem_samantha.rpy:2292
translate russian home_harem_confession_to_sam_43f1b315:
    samantha.say "Ты бы согласился?"

# ch/harems/home/events/home_harem_samantha.rpy:2293
translate russian home_harem_confession_to_sam_03d2da5e:
    samantha.say "Ты и остальные девушки приняли бы меня?"

# ch/harems/home/events/home_harem_samantha.rpy:2294
translate russian home_harem_confession_to_sam_d1fd1eb0:
    "Я киваю, стараясь выглядеть совершенно искренним."

# ch/harems/home/events/home_harem_samantha.rpy:2295
translate russian home_harem_confession_to_sam_75458457:
    "Потому что теперь хочу видеть Сэм среди нас сильнее прежнего."

# ch/harems/home/events/home_harem_samantha.rpy:2297
translate russian home_harem_confession_to_sam_61cba11e:
    mike.say "Конечно, Кексик!"

# ch/harems/home/events/home_harem_samantha.rpy:2299
translate russian home_harem_confession_to_sam_dc23f74e:
    mike.say "Конечно, Сэм!"

# ch/harems/home/events/home_harem_samantha.rpy:2300
translate russian home_harem_confession_to_sam_bf239a77:
    mike.say "Все девушки за то, чтобы ты присоединилась."

# ch/harems/home/events/home_harem_samantha.rpy:2301
translate russian home_harem_confession_to_sam_274ca272:
    mike.say "А для меня..."

# ch/harems/home/events/home_harem_samantha.rpy:2302
translate russian home_harem_confession_to_sam_49a7efde:
    mike.say "Ну... Это было бы исполнением мечты!"

# ch/harems/home/events/home_harem_samantha.rpy:2303
translate russian home_harem_confession_to_sam_2c54a631:
    "Сэм странно смотрит на меня."

# ch/harems/home/events/home_harem_samantha.rpy:2305
translate russian home_harem_confession_to_sam_3084c665:
    "Словно последние слова удивили её сильнее самого предложения."

# ch/harems/home/events/home_harem_samantha.rpy:2306
translate russian home_harem_confession_to_sam_15eae6a3:
    samantha.say "Признаюсь, звучит заманчиво!"

# ch/harems/home/events/home_harem_samantha.rpy:2307
translate russian home_harem_confession_to_sam_ea74b20d:
    samantha.say "Будто станешь причастна к какой-то чудесной тайне."

# ch/harems/home/events/home_harem_samantha.rpy:2308
translate russian home_harem_confession_to_sam_458dfa58:
    samantha.say "Мне... мне всегда было немного любопытно, понимаешь?"

# ch/harems/home/events/home_harem_samantha.rpy:2310
translate russian home_harem_confession_to_sam_05caf0d8:
    samantha.say "Все эти пикантные штучки."

# ch/harems/home/events/home_harem_samantha.rpy:2311
translate russian home_harem_confession_to_sam_fb00e580:
    "Я всё ещё киваю в ответ на её слова."

# ch/harems/home/events/home_harem_samantha.rpy:2312
translate russian home_harem_confession_to_sam_2df97cc4:
    "Но тут понимаю, что ответа Сэм пока так и не дала."

# ch/harems/home/events/home_harem_samantha.rpy:2314
translate russian home_harem_confession_to_sam_dd04979e:
    mike.say "Так что скажешь, Кексик?"

# ch/harems/home/events/home_harem_samantha.rpy:2316
translate russian home_harem_confession_to_sam_77e16de6:
    mike.say "Так что скажешь, Сэм?"

# ch/harems/home/events/home_harem_samantha.rpy:2317
translate russian home_harem_confession_to_sam_62255179:
    mike.say "Ты с нами?"

# ch/harems/home/events/home_harem_samantha.rpy:2318
translate russian home_harem_confession_to_sam_2744e56c:
    samantha.say "Я... ну..."

# ch/harems/home/events/home_harem_samantha.rpy:2320
translate russian home_harem_confession_to_sam_8b01c456:
    samantha.say "Да... да, я с вами!"

# ch/harems/home/events/home_harem_samantha.rpy:2321
translate russian home_harem_confession_to_sam_75077589:
    "Услышав это, я невольно расплываюсь в глупой улыбке."

# ch/harems/home/events/home_harem_samantha.rpy:2322
translate russian home_harem_confession_to_sam_8ef8b1c7:
    "И мне не терпится рассказать остальным."

# ch/harems/home/events/home_harem_samantha.rpy:2323
translate russian home_harem_confession_to_sam_be8e6aed:
    "В нашем маленьком гареме стало на одну участницу больше!"

# ch/harems/home/events/home_harem_samantha.rpy:2324
translate russian home_harem_confession_to_sam_e2519533:
    mike.say "Может, пойдём расскажем девушкам?"

# ch/harems/home/events/home_harem_samantha.rpy:2337
translate russian home_harem_confession_to_sam_f407402b_1:
    "Сэм некоторое время смотрит на меня, снова удивлённая."

# ch/harems/home/events/home_harem_samantha.rpy:2338
translate russian home_harem_confession_to_sam_75942dc7_1:
    "Но затем её выражение становится более определённым."

# ch/harems/home/events/home_harem_samantha.rpy:2340
translate russian home_harem_confession_to_sam_2bca5639:
    "Она глубоко вдыхает и тяжело выдыхает."

# ch/harems/home/events/home_harem_samantha.rpy:2341
translate russian home_harem_confession_to_sam_66c3ca4e:
    "Затем качает головой."

# ch/harems/home/events/home_harem_samantha.rpy:2342
translate russian home_harem_confession_to_sam_76fa888a:
    samantha.say "Нет, [lssb_common.hero_name()]."

# ch/harems/home/events/home_harem_samantha.rpy:2344
translate russian home_harem_confession_to_sam_eb763931:
    samantha.say "Думаю, я не хочу."

# ch/harems/home/events/home_harem_samantha.rpy:2346
translate russian home_harem_confession_to_sam_b4b208f5:
    mike.say "Ты уверена, Кексик?"

# ch/harems/home/events/home_harem_samantha.rpy:2348
translate russian home_harem_confession_to_sam_27846993:
    mike.say "Ты уверена, Сэм?"

# ch/harems/home/events/home_harem_samantha.rpy:2349
translate russian home_harem_confession_to_sam_c5fd5092:
    mike.say "Это важное решение."

# ch/harems/home/events/home_harem_samantha.rpy:2350
translate russian home_harem_confession_to_sam_9130e674:
    mike.say "Может, хочешь немного подумать?"

# ch/harems/home/events/home_harem_samantha.rpy:2351
translate russian home_harem_confession_to_sam_866163f4:
    "Сэм снова качает головой."

# ch/harems/home/events/home_harem_samantha.rpy:2352
translate russian home_harem_confession_to_sam_f36fe746:
    "Но на этот раз решительнее."

# ch/harems/home/events/home_harem_samantha.rpy:2353
translate russian home_harem_confession_to_sam_45d7766e:
    samantha.say "Нет, не хочу."

# ch/harems/home/events/home_harem_samantha.rpy:2354
translate russian home_harem_confession_to_sam_2bf83dfc:
    samantha.say "Я благодарна, что ты рассказал мне об этом."

# ch/harems/home/events/home_harem_samantha.rpy:2356
translate russian home_harem_confession_to_sam_16e4cce9:
    samantha.say "Но мне некомфортно от того, что вы делаете."

# ch/harems/home/events/home_harem_samantha.rpy:2357
translate russian home_harem_confession_to_sam_a71d6e89:
    samantha.say "Более того, я не хочу жить с этим под одной крышей."

# ch/harems/home/events/home_harem_samantha.rpy:2358
translate russian home_harem_confession_to_sam_e605ba05:
    mike.say "Т... ты съезжаешь?"

# ch/harems/home/events/home_harem_samantha.rpy:2359
translate russian home_harem_confession_to_sam_dc230247:
    samantha.say "Пока да."

# ch/harems/home/events/home_harem_samantha.rpy:2360
translate russian home_harem_confession_to_sam_bc3a7fab:
    samantha.say "По крайней мере, пока всё это продолжается."

# ch/harems/home/events/home_harem_samantha.rpy:2362
translate russian home_harem_confession_to_sam_544e77f0:
    "Но взгляд Сэм заставляет меня замереть."

# ch/harems/home/events/home_harem_samantha.rpy:2363
translate russian home_harem_confession_to_sam_447377dc:
    "Он говорит, что в этом вопросе её не переубедить."

# ch/harems/home/events/home_harem_samantha.rpy:2364
translate russian home_harem_confession_to_sam_b7c253eb:
    "Поэтому я лишь киваю, давая понять, что понимаю её решение."

# ch/harems/home/events/home_harem_samantha.rpy:2365
translate russian home_harem_confession_to_sam_87ec4ec9:
    "И больше не поднимаю эту тему."

# ch/harems/home/events/home_harem_samantha.rpy:2366
translate russian home_harem_confession_to_sam_bc718cf3:
    "Похоже, выбирать пришлось между Сэм и остальными девушками."

# ch/harems/home/events/home_harem_samantha.rpy:2367
translate russian home_harem_confession_to_sam_bee2454b:
    "Остаётся надеяться, что я решил правильно."

# ch/harems/home/events/home_harem_samantha.rpy:2374
translate russian foursome_breesamsasha_f51be5ca:
    "Наверное, такие вещи просто набирают ход сами по себе."

# ch/harems/home/events/home_harem_samantha.rpy:2375
translate russian foursome_breesamsasha_0304905b:
    "Словно сдвинешь что-то огромное, казавшееся неподвижным."

# ch/harems/home/events/home_harem_samantha.rpy:2376
translate russian foursome_breesamsasha_1a78ff8b:
    "Не успеешь оглянуться, а оно уже катится с горы всё быстрее."

# ch/harems/home/events/home_harem_samantha.rpy:2377
translate russian foursome_breesamsasha_6e4dd7a2:
    "И тогда его не остановить, даже если очень захочешь!"

# ch/harems/home/events/home_harem_samantha.rpy:2378
translate russian foursome_breesamsasha_bdef6beb:
    "Ведь Сэм пришла всего час назад."

# ch/harems/home/events/home_harem_samantha.rpy:2379
translate russian foursome_breesamsasha_40f9cc8c:
    "Тогда казалось, что главное — ввести её в курс дела."

# ch/harems/home/events/home_harem_samantha.rpy:2380
translate russian foursome_breesamsasha_92cf798d:
    "Ну, объяснить, что [lssb_homesam.bree_name()], Саша и я вместе."

# ch/harems/home/events/home_harem_samantha.rpy:2381
translate russian foursome_breesamsasha_25c860d2:
    "А именно — что мы спали друг с другом у неё за спиной."

# ch/harems/home/events/home_harem_samantha.rpy:2382
translate russian foursome_breesamsasha_1527bd72:
    "Но стоило выясниться, что она не против, как всё изменилось."

# ch/harems/home/events/home_harem_samantha.rpy:2383
translate russian foursome_breesamsasha_35b9d945:
    "Более того, Сэм сразу ухватилась за возможность тоже присоединиться!"

# ch/harems/home/events/home_harem_samantha.rpy:2384
translate russian foursome_breesamsasha_4711888f:
    "А потом одно потянуло за собой другое, понимаете?"

# ch/harems/home/events/home_harem_samantha.rpy:2389
translate russian foursome_breesamsasha_61192ef1:
    "Вот так мы и оказались здесь, в моей спальне."

# ch/harems/home/events/home_harem_samantha.rpy:2390
translate russian foursome_breesamsasha_dfdc062f:
    "Все четверо раздеваемся и поглядываем друг на друга."

# ch/harems/home/events/home_harem_samantha.rpy:2391
translate russian foursome_breesamsasha_8e967651:
    "Похоже, приняв условия, Сэм хочет опробовать товар..."

# ch/harems/home/events/home_harem_samantha.rpy:2392
translate russian foursome_breesamsasha_76e8109f:
    "Сейчас она точно оценивает ассортимент!"

# ch/harems/home/events/home_harem_samantha.rpy:2393
translate russian foursome_breesamsasha_b68905b5:
    "И я невольно немного ревную, когда она оглядывает остальных девушек."

# ch/harems/home/events/home_harem_samantha.rpy:2394
translate russian foursome_breesamsasha_2689aa92:
    "Конечно, меня голым она уже видела, а они по-настоящему великолепны."

# ch/harems/home/events/home_harem_samantha.rpy:2395
translate russian foursome_breesamsasha_ac40240b:
    "Но я что, залежалый товар?!"

# ch/harems/home/events/home_harem_samantha.rpy:2396
translate russian foursome_breesamsasha_0d448417:
    "К несчастью для меня, мои чувства, кажется, легко прочитать."

# ch/harems/home/events/home_harem_samantha.rpy:2398
translate russian foursome_breesamsasha_321acd3a:
    bree.say "Ну-у..."

# ch/harems/home/events/home_harem_samantha.rpy:2399
translate russian foursome_breesamsasha_4b485cdf:
    bree.say "Что такое, [lssb_common.hero_name()]?"

# ch/harems/home/events/home_harem_samantha.rpy:2401
translate russian foursome_breesamsasha_39b93bba:
    sasha.say "А, не обращай внимания."

# ch/harems/home/events/home_harem_samantha.rpy:2402
translate russian foursome_breesamsasha_1e532b11:
    sasha.say "Просто ревнует, что всё внимание достаётся нам!"

# ch/harems/home/events/home_harem_samantha.rpy:2406
translate russian foursome_breesamsasha_bd18cd3d:
    "От слов Саши Сэм резко поворачивает голову."

# ch/harems/home/events/home_harem_samantha.rpy:2407
translate russian foursome_breesamsasha_4359b8f6:
    "Наверное, она и не замечала, насколько откровенно разглядывала девушек."

# ch/harems/home/events/home_harem_samantha.rpy:2408
translate russian foursome_breesamsasha_9b561808:
    "На мгновение мне кажется, что смущение сейчас возьмёт над ней верх."

# ch/harems/home/events/home_harem_samantha.rpy:2409
translate russian foursome_breesamsasha_33383b35:
    mike.say "А... нет... я..."

# ch/harems/home/events/home_harem_samantha.rpy:2411
translate russian foursome_breesamsasha_0c443017:
    mike.say "Есть на что посмотреть, правда, Кексик?"

# ch/harems/home/events/home_harem_samantha.rpy:2413
translate russian foursome_breesamsasha_baf1dd5b:
    mike.say "Есть на что посмотреть, правда, Сэм?"

# ch/harems/home/events/home_harem_samantha.rpy:2414
translate russian foursome_breesamsasha_621fd762:
    mike.say "В хорошем смысле!"

# ch/harems/home/events/home_harem_samantha.rpy:2415
translate russian foursome_breesamsasha_96540c70:
    "Похоже, звук моего голоса помогает Сэм."

# ch/harems/home/events/home_harem_samantha.rpy:2416
translate russian foursome_breesamsasha_39e57fff:
    "Словно моё знакомое присутствие придаёт ей уверенности."

# ch/harems/home/events/home_harem_samantha.rpy:2418
translate russian foursome_breesamsasha_a0d8a2c6:
    samantha.say "И не говори, [lssb_common.hero_name()]!"

# ch/harems/home/events/home_harem_samantha.rpy:2419
translate russian foursome_breesamsasha_f9d27103:
    samantha.say "Но здесь только ты особенный."

# ch/harems/home/events/home_harem_samantha.rpy:2420
translate russian foursome_breesamsasha_b7c7dc00:
    samantha.say "У тебя есть то, чего нет ни у одной из нас!"

# ch/harems/home/events/home_harem_samantha.rpy:2422
translate russian foursome_breesamsasha_e17db9e3:
    "С этими словами она сокращает расстояние между нами."

# ch/harems/home/events/home_harem_samantha.rpy:2423
translate russian foursome_breesamsasha_196cd6af:
    "Сэм прижимается ко мне и гладит рукой мой член."

# ch/harems/home/events/home_harem_samantha.rpy:2426
translate russian foursome_breesamsasha_3ac9e810:
    "Остальные подходят, согласно кивая."

# ch/harems/home/events/home_harem_samantha.rpy:2427
translate russian foursome_breesamsasha_3e6c6e8e:
    sasha.say "Ага, этого на всех всегда не хватает!"

# ch/harems/home/events/home_harem_samantha.rpy:2428
translate russian foursome_breesamsasha_868f70c7:
    bree.say "Поэтому приходится делиться, как и положено хорошим девочкам!"

# ch/harems/home/events/home_harem_samantha.rpy:2429
translate russian foursome_breesamsasha_c0940ac8:
    sasha.say "Но ты новенькая, Сэм, так что сегодня он твой!"

# ch/harems/home/events/home_harem_samantha.rpy:2430
translate russian foursome_breesamsasha_f789fc57:
    bree.say "М-м, угу..."

# ch/harems/home/events/home_harem_samantha.rpy:2431
translate russian foursome_breesamsasha_2a63bd89:
    bree.say "Сегодня ты долетишь на этой членоракете до самой Луны!"

# ch/harems/home/events/home_harem_samantha.rpy:2432
translate russian foursome_breesamsasha_0b30f481:
    mike.say "Ха..."

# ch/harems/home/events/home_harem_samantha.rpy:2433
translate russian foursome_breesamsasha_a28dc3ec:
    mike.say "У тебя я звучу как аттракцион, [lssb_homesam.bree_name()]!"

# ch/harems/home/events/home_harem_samantha.rpy:2434
translate russian foursome_breesamsasha_aa8f0aca:
    bree.say "А почему бы и нет?"

# ch/harems/home/events/home_harem_samantha.rpy:2435
translate russian foursome_breesamsasha_29b363f7:
    bree.say "На тебе прокатиться уже очередь стоит!"

# ch/harems/home/events/home_harem_samantha.rpy:2436
translate russian foursome_breesamsasha_a81f8b46:
    sasha.say "И сегодня ты в ней первая, Сэм!"

# ch/harems/home/events/home_harem_samantha.rpy:2437
translate russian foursome_breesamsasha_b6a0652e:
    "Сэм бросает на меня косой взгляд и кивает в сторону кровати."

# ch/harems/home/events/home_harem_samantha.rpy:2438
translate russian foursome_breesamsasha_ec3925bc:
    "Мне не нужно повторять дважды: я сразу забираюсь на матрас."

# ch/harems/home/events/home_harem_samantha.rpy:2439
translate russian foursome_breesamsasha_b9faa888:
    "Она следует за мной, заползает сверху и прижимает меня к кровати."

# ch/harems/home/events/home_harem_samantha.rpy:2443
translate russian foursome_breesamsasha_0ffb84f8:
    "Её руки уже на моём члене, и она трёт его о свою киску."

# ch/harems/home/events/home_harem_samantha.rpy:2444
translate russian foursome_breesamsasha_f0642a98:
    "Ощущение потрясающее: я чувствую, какая она влажная и готовая."

# ch/harems/home/events/home_harem_samantha.rpy:2445
translate russian foursome_breesamsasha_eb4c21f2:
    "Затем она направляет головку между губками и опускается на неё."

# ch/harems/home/events/home_harem_samantha.rpy:2447
translate russian foursome_breesamsasha_8a0afb1c:
    samantha.say "Ох..."

# ch/harems/home/events/home_harem_samantha.rpy:2448
translate russian foursome_breesamsasha_a18d6d05:
    samantha.say "Ох, как приятно..."

# ch/harems/home/events/home_harem_samantha.rpy:2449
translate russian foursome_breesamsasha_7451e8cd:
    "С моей стороны тоже очень даже приятно!"

# ch/harems/home/events/home_harem_samantha.rpy:2450
translate russian foursome_breesamsasha_5201541e:
    "Я чувствую каждый сантиметр члена, погружающегося в Сэм всё глубже."

# ch/harems/home/events/home_harem_samantha.rpy:2451
translate russian foursome_breesamsasha_0bfe4282:
    "От веса её тела и давления мышц я ахаю."

# ch/harems/home/events/home_harem_samantha.rpy:2452
translate russian foursome_breesamsasha_fbc4ef90:
    "А когда глубже уже некуда, она начинает скакать на мне всерьёз."

# ch/harems/home/events/home_harem_samantha.rpy:2453
translate russian foursome_breesamsasha_44b4d5b1:
    "Я смотрю на Сэм снизу вверх: она двигается словно из моего сна."

# ch/harems/home/events/home_harem_samantha.rpy:2454
translate russian foursome_breesamsasha_800e7b34:
    "Волосы падают ей на плечи, а груди медленно покачиваются."

# ch/harems/home/events/home_harem_samantha.rpy:2455
translate russian foursome_breesamsasha_850f883c:
    "Я уже собираюсь протянуть руки и обхватить их."

# ch/harems/home/events/home_harem_samantha.rpy:2456
translate russian foursome_breesamsasha_f28abdfa:
    "Но тут слышу шёпот у своих ушей."

# ch/harems/home/events/home_harem_samantha.rpy:2457
translate russian foursome_breesamsasha_bb1574d8:
    bree.say "Эй, приём?"

# ch/harems/home/events/home_harem_samantha.rpy:2458
translate russian foursome_breesamsasha_42e47716:
    bree.say "[lssb_common.hero_name()]?"

# ch/harems/home/events/home_harem_samantha.rpy:2459
translate russian foursome_breesamsasha_d7bcb4dc:
    sasha.say "Ты о нас забыл?"

# ch/harems/home/events/home_harem_samantha.rpy:2460
translate russian foursome_breesamsasha_a12c43df:
    "Я смотрю влево, затем вправо: [lssb_homesam.bree_name()] и Саша устроились по обе стороны от меня."

# ch/harems/home/events/home_harem_samantha.rpy:2461
translate russian foursome_breesamsasha_0c08f199:
    "Они стоят на четвереньках, почти подставляя мне свои попки!"

# ch/harems/home/events/home_harem_samantha.rpy:2462
translate russian foursome_breesamsasha_9994e5a7:
    bree.say "Не уделишь внимание?"

# ch/harems/home/events/home_harem_samantha.rpy:2463
translate russian foursome_breesamsasha_9b6a3d1b:
    sasha.say "Две свободные руки и две скучающие девушки!"

# ch/harems/home/events/home_harem_samantha.rpy:2464
translate russian foursome_breesamsasha_e9a71c15:
    "Словно подчёркивая это, через секунду они раздвигают ягодицы."

# ch/harems/home/events/home_harem_samantha.rpy:2465
translate russian foursome_breesamsasha_96ac7de8:
    "Мои глаза мечутся из стороны в сторону, разглядывая открывшиеся киски."

# ch/harems/home/events/home_harem_samantha.rpy:2466
translate russian foursome_breesamsasha_a569770a:
    "Смотреть в обе стороны одновременно я не могу."

# ch/harems/home/events/home_harem_samantha.rpy:2467
translate russian foursome_breesamsasha_e2c65398:
    "Поэтому решаю действовать на ощупь, а взгляд оставить на Сэм."

# ch/harems/home/events/home_harem_samantha.rpy:2469
translate russian foursome_breesamsasha_ffeb1251:
    "[lssb_homesam.bree_name()] первой ощущает мои пальцы на губках — на секунду раньше Саши."

# ch/harems/home/events/home_harem_samantha.rpy:2470
translate russian foursome_breesamsasha_d3dacc88:
    "Я слышу её радостное хихиканье от этого прикосновения."

# ch/harems/home/events/home_harem_samantha.rpy:2471
translate russian foursome_breesamsasha_be1a38b0:
    "Затем нахожу то же место у Саши."

# ch/harems/home/events/home_harem_samantha.rpy:2472
translate russian foursome_breesamsasha_cf4c5a5d:
    "Но её смех, напротив, почти порочный, полный тёмных обещаний."

# ch/harems/home/events/home_harem_samantha.rpy:2473
translate russian foursome_breesamsasha_67fc2a66:
    "Обе более чем готовы к продолжению."

# ch/harems/home/events/home_harem_samantha.rpy:2474
translate russian foursome_breesamsasha_7272a3d0:
    "Их киски почти текут от предвкушения."

# ch/harems/home/events/home_harem_samantha.rpy:2475
translate russian foursome_breesamsasha_4d01a33e:
    "Так что ввести в них один палец за другим совсем несложно."

# ch/harems/home/events/home_harem_samantha.rpy:2476
translate russian foursome_breesamsasha_e2737800:
    "Когда я это делаю, смех и хихиканье сменяются долгими низкими стонами удовольствия."

# ch/harems/home/events/home_harem_samantha.rpy:2477
translate russian foursome_breesamsasha_2491b5c6:
    "И на короткое время все трое оказываются в моей власти."

# ch/harems/home/events/home_harem_samantha.rpy:2479
translate russian foursome_breesamsasha_1aadbfb5:
    "Сэм продолжает изо всех сил скакать на моём члене."

# ch/harems/home/events/home_harem_samantha.rpy:2480
translate russian foursome_breesamsasha_dabd8c52:
    "Своими руками она сжимает груди и щиплет соски."

# ch/harems/home/events/home_harem_samantha.rpy:2481
translate russian foursome_breesamsasha_60f0c45e:
    "Но, кажется, лишь разжигает желание, а не утоляет его."

# ch/harems/home/events/home_harem_samantha.rpy:2483
translate russian foursome_breesamsasha_0dc3fd41:
    "Одновременно [lssb_homesam.bree_name()] и Саша тяжело дышат, словно течные сучки."

# ch/harems/home/events/home_harem_samantha.rpy:2484
translate russian foursome_breesamsasha_5ecace2d:
    "Их тела извиваются, пока я безжалостно ласкаю их киски."

# ch/harems/home/events/home_harem_samantha.rpy:2485
translate russian foursome_breesamsasha_7ff0a843:
    "Я словно в другом измерении, будто достиг сексуальной нирваны!"

# ch/harems/home/events/home_harem_samantha.rpy:2486
translate russian foursome_breesamsasha_6b3061e7:
    "Поэтому слышу собственный голос ещё до того, как понимаю, что говорю..."

# ch/harems/home/events/home_harem_samantha.rpy:2488
translate russian foursome_breesamsasha_ddf52070:
    mike.say "Сейчас кончу..."

# ch/harems/home/events/home_harem_samantha.rpy:2489
translate russian foursome_breesamsasha_7c173b9b:
    "[lssb_homesam.bree_name()] и Саша молниеносно приподнимаются и снимают Сэм с моего члена."

# ch/harems/home/events/home_harem_samantha.rpy:2490
translate russian foursome_breesamsasha_415c119b:
    "Она на миг протестует, но затем видит, как девушки указывают на свои рты."

# ch/harems/home/events/home_harem_samantha.rpy:2491
translate russian foursome_breesamsasha_c07d1a11:
    "Клянусь, она облизывает губы и кивает, поняв их замысел."

# ch/harems/home/events/home_harem_samantha.rpy:2495
translate russian foursome_breesamsasha_e05e2e00:
    "Я ещё не успеваю сделать то же самое, как Сэм берёт мой член в рот."

# ch/harems/home/events/home_harem_samantha.rpy:2496
translate russian foursome_breesamsasha_401ebce8:
    "Она работает словно отбойный молоток — никакого постепенного разгона."

# ch/harems/home/events/home_harem_samantha.rpy:2498
translate russian foursome_breesamsasha_3c6f036d:
    "Её голова ходит вверх-вниз, пока [lssb_homesam.bree_name()] и Саша заняты по обе стороны."

# ch/harems/home/events/home_harem_samantha.rpy:2499
translate russian foursome_breesamsasha_2b61bb2e:
    "Они целуют и ласкают все части моего тела, которые Сэм ещё не присвоила."

# ch/harems/home/events/home_harem_samantha.rpy:2500
translate russian foursome_breesamsasha_752f11a4:
    "И всё это время улыбаются мне снизу, словно две особенно порочные сирены!"

# ch/harems/home/events/home_harem_samantha.rpy:2507
translate russian foursome_breesamsasha_d9736ecc:
    "Вскоре я понимаю, что больше не выдержу."

# ch/harems/home/events/home_harem_samantha.rpy:2508
translate russian foursome_breesamsasha_a2ecef36:
    mike.say "Я... я больше не могу!"

# ch/harems/home/events/home_harem_samantha.rpy:2510
translate russian foursome_breesamsasha_a58e0937:
    "Сэм выпускает мой член изо рта, и по её приглашению [lssb_homesam.bree_name()] и Саша придвигаются к нему."

# ch/harems/home/events/home_harem_samantha.rpy:2512
translate russian foursome_breesamsasha_cf7809d8:
    "Через секунду нарастающее напряжение в члене исчезает в мощных брызгах спермы."

# ch/harems/home/events/home_harem_samantha.rpy:2514
translate russian foursome_breesamsasha_50643a1c:
    "Обессиленный и тяжело дышащий, я смотрю на три прекрасных лица, покрытых моей спермой."

# ch/harems/home/events/home_harem_samantha.rpy:2516
translate russian foursome_breesamsasha_ce30d1f3:
    "После этого Сэм невольно качает головой, осмысляя то, что мы только что сделали."

# ch/harems/home/events/home_harem_samantha.rpy:2518
translate russian foursome_breesamsasha_2c6406d7:
    mike.say "Кексик?"

# ch/harems/home/events/home_harem_samantha.rpy:2520
translate russian foursome_breesamsasha_13a94265:
    mike.say "Сэм?"

# ch/harems/home/events/home_harem_samantha.rpy:2522
translate russian foursome_breesamsasha_aee1e8c5:
    samantha.say "Что?!"

# ch/harems/home/events/home_harem_samantha.rpy:2523
translate russian foursome_breesamsasha_7a536c14:
    samantha.say "А, да... Я более чем в порядке."

# ch/harems/home/events/home_harem_samantha.rpy:2524
translate russian foursome_breesamsasha_7e2b392f:
    bree.say "Значит, тебе так нравится?"

# ch/harems/home/events/home_harem_samantha.rpy:2525
translate russian foursome_breesamsasha_e6e49fc1:
    sasha.say "Открывает глаза на многое, правда?"

# ch/harems/home/events/home_harem_samantha.rpy:2526
translate russian foursome_breesamsasha_8e873018:
    samantha.say "Я... я всегда думала, что буду ревновать, понимаете?"

# ch/harems/home/events/home_harem_samantha.rpy:2527
translate russian foursome_breesamsasha_6700453f:
    samantha.say "Но это совсем не так."

# ch/harems/home/events/home_harem_samantha.rpy:2528
translate russian foursome_breesamsasha_841f4b92:
    samantha.say "Наоборот, будто всего стало гораздо больше и хватит каждому!"

# ch/harems/home/events/home_harem_samantha.rpy:2529
translate russian foursome_breesamsasha_0659c74d:
    "К этому нечего добавить."

# ch/harems/home/events/home_harem_samantha.rpy:2530
translate russian foursome_breesamsasha_515cf637:
    "Поэтому в ответ все лишь кивают Сэм."

# ch/harems/home/events/home_harem_samantha.rpy:2531
translate russian foursome_breesamsasha_afe018b2:
    "Ведь иногда молчание говорит гораздо больше слов."

# ch/harems/home/events/home_harem_samantha.rpy:2537
translate russian fivesome_breeminamisamsasha_82326abf:
    "Я никогда не увлекался веществами, меняющими сознание, или галлюциногенами."

# ch/harems/home/events/home_harem_samantha.rpy:2538
translate russian fivesome_breeminamisamsasha_6776c4ab:
    "Но нынешнее состояние очень похоже на то, как я представляю их действие."

# ch/harems/home/events/home_harem_samantha.rpy:2539
translate russian fivesome_breeminamisamsasha_e121f1fb:
    "После сюрприза, который девушки устроили Сэм, всё стало каким-то странным и похожим на сон."

# ch/harems/home/events/home_harem_samantha.rpy:2540
translate russian fivesome_breeminamisamsasha_855696ed:
    "А когда она с радостью согласилась тоже присоединиться, стало ещё необычнее!"

# ch/harems/home/events/home_harem_samantha.rpy:2541
translate russian fivesome_breeminamisamsasha_f89e3f00:
    "Ну, как говорится, одно тянет за собой другое."

# ch/harems/home/events/home_harem_samantha.rpy:2547
translate russian fivesome_breeminamisamsasha_cdf38c6a:
    "И вот мы здесь, в моей спальне, — все пятеро!"

# ch/harems/home/events/home_harem_samantha.rpy:2548
translate russian fivesome_breeminamisamsasha_2c4e186d:
    "Как только было решено, что Сэм станет частью нашего..."

# ch/harems/home/events/home_harem_samantha.rpy:2549
translate russian fivesome_breeminamisamsasha_4b4d8c4f:
    "Эх, как вообще такое назвать?"

# ch/harems/home/events/home_harem_samantha.rpy:2550
translate russian fivesome_breeminamisamsasha_84e8a3ec:
    "Полигамными отношениями?"

# ch/harems/home/events/home_harem_samantha.rpy:2551
translate russian fivesome_breeminamisamsasha_ee816462:
    "Гаремом?"

# ch/harems/home/events/home_harem_samantha.rpy:2552
translate russian fivesome_breeminamisamsasha_d059f3c2:
    "Оргией?"

# ch/harems/home/events/home_harem_samantha.rpy:2553
translate russian fivesome_breeminamisamsasha_55e81e05:
    "В общем, что бы это ни было, после согласия Сэм нашёлся лишь один способ как следует отметить событие."

# ch/harems/home/events/home_harem_samantha.rpy:2554
translate russian fivesome_breeminamisamsasha_5e73ff51:
    "Все ещё на взводе от восторга, и нечего ждать, пока он пройдёт."

# ch/harems/home/events/home_harem_samantha.rpy:2555
translate russian fivesome_breeminamisamsasha_a6ab64c2:
    "И всё же участников столько, что никто, кажется, не понимает, кто здесь главный!"

# ch/harems/home/events/home_harem_samantha.rpy:2561
translate russian fivesome_breeminamisamsasha_90457caf:
    "Все начинают раздеваться, но затем останавливаются и смотрят друг на друга."

# ch/harems/home/events/home_harem_samantha.rpy:2562
translate russian fivesome_breeminamisamsasha_87bad59e:
    "Никто не может разобраться, кому куда и что делать."

# ch/harems/home/events/home_harem_samantha.rpy:2563
translate russian fivesome_breeminamisamsasha_534669e8:
    "А когда мы наконец заговариваем, все говорят одновременно."

# ch/harems/home/events/home_harem_samantha.rpy:2564
translate russian fivesome_breeminamisamsasha_c0d65dfe:
    mike.say "Эм, наверное, я мог бы..."

# ch/harems/home/events/home_harem_samantha.rpy:2566
translate russian fivesome_breeminamisamsasha_f469a5d5:
    bree.say "Я была бы не против немного..."

# ch/harems/home/events/home_harem_samantha.rpy:2568
translate russian fivesome_breeminamisamsasha_10895651:
    minami.say "Наверное, мне стоит быть сверху..."

# ch/harems/home/events/home_harem_samantha.rpy:2570
translate russian fivesome_breeminamisamsasha_5e269049:
    samantha.say "Я не хочу никому мешать..."

# ch/harems/home/events/home_harem_samantha.rpy:2572
translate russian fivesome_breeminamisamsasha_6998f267:
    sasha.say "ЗАТКНИТЕСЬ!" with vpunch

# ch/harems/home/events/home_harem_samantha.rpy:2577
translate russian fivesome_breeminamisamsasha_55e58279:
    "От властного тона Саши все замолкают."

# ch/harems/home/events/home_harem_samantha.rpy:2578
translate russian fivesome_breeminamisamsasha_6176fadc:
    sasha.say "Сегодня движением руковожу я, ясно?"

# ch/harems/home/events/home_harem_samantha.rpy:2579
translate russian fivesome_breeminamisamsasha_6077cc1d:
    "В ответ все поспешно переглядываются."

# ch/harems/home/events/home_harem_samantha.rpy:2580
translate russian fivesome_breeminamisamsasha_3aa72397:
    "Затем каждый, включая меня, согласно кивает."

# ch/harems/home/events/home_harem_samantha.rpy:2581
translate russian fivesome_breeminamisamsasha_0aa57953:
    sasha.say "Так, приступаем!"

# ch/harems/home/events/home_harem_samantha.rpy:2582
translate russian fivesome_breeminamisamsasha_1cb38995:
    sasha.say "Сэм у нас новичок, так что член достаётся ей."

# ch/harems/home/events/home_harem_samantha.rpy:2583
translate russian fivesome_breeminamisamsasha_05b61664:
    "Саша обводит взглядом лица собравшихся, ожидая возражений."

# ch/harems/home/events/home_harem_samantha.rpy:2584
translate russian fivesome_breeminamisamsasha_f9c87d5b:
    "Но в ответ снова получает лишь кивки."

# ch/harems/home/events/home_harem_samantha.rpy:2585
translate russian fivesome_breeminamisamsasha_df10bdfe:
    "Ну и, может быть, лёгкий румянец на щеках у меня и Сэм!"

# ch/harems/home/events/home_harem_samantha.rpy:2587
translate russian fivesome_breeminamisamsasha_95fb3224:
    sasha.say "Чего ждёте?"

# ch/harems/home/events/home_harem_samantha.rpy:2589
translate russian fivesome_breeminamisamsasha_c8258b2f:
    sasha.say "Начинаем представление!"

# ch/harems/home/events/home_harem_samantha.rpy:2591
translate russian fivesome_breeminamisamsasha_c2c5f151:
    "Саша подаёт пример и раздевается перед остальными."

# ch/harems/home/events/home_harem_samantha.rpy:2595
translate russian fivesome_breeminamisamsasha_a9aa5651:
    "Вскоре другие девушки следуют её примеру."

# ch/harems/home/events/home_harem_samantha.rpy:2596
translate russian fivesome_breeminamisamsasha_586912e6:
    "Поначалу немного странно, почти как раздеваться в спортзале."

# ch/harems/home/events/home_harem_samantha.rpy:2597
translate russian fivesome_breeminamisamsasha_726805c6:
    "Но лукавые взгляды и хихиканье напоминают, что здесь происходит на самом деле."

# ch/harems/home/events/home_harem_samantha.rpy:2598
translate russian fivesome_breeminamisamsasha_2979e67b:
    "А когда начинают мелькать груди и ягодицы, мои мысли инстинктивно переключаются."

# ch/harems/home/events/home_harem_samantha.rpy:2599
translate russian fivesome_breeminamisamsasha_1ec7cc89:
    "Это совсем не похоже на раздевалку спортзала!"

# ch/harems/home/events/home_harem_samantha.rpy:2600
translate russian fivesome_breeminamisamsasha_a67cdecb:
    "Здесь не нужно показывать своё тело украдкой."

# ch/harems/home/events/home_harem_samantha.rpy:2601
translate russian fivesome_breeminamisamsasha_581a0634:
    "И весь смысл как раз в том, чтобы трогать!"

# ch/harems/home/events/home_harem_samantha.rpy:2602
translate russian fivesome_breeminamisamsasha_16b14c12:
    "Когда все раздеты, Саша протягивает руку Сэм."

# ch/harems/home/events/home_harem_samantha.rpy:2603
translate russian fivesome_breeminamisamsasha_ef316154:
    sasha.say "Иди сюда, Сэм."

# ch/harems/home/events/home_harem_samantha.rpy:2604
translate russian fivesome_breeminamisamsasha_29b0a758:
    sasha.say "Вот так, просто следуй за мной..."

# ch/harems/home/events/home_harem_samantha.rpy:2605
translate russian fivesome_breeminamisamsasha_dca66a60:
    "Сэм вполне понятно нервничает, но всё же берёт Сашу за руку."

# ch/harems/home/events/home_harem_samantha.rpy:2606
translate russian fivesome_breeminamisamsasha_ba8d670a:
    "Она позволяет отвести себя к кровати и уложить."

# ch/harems/home/events/home_harem_samantha.rpy:2607
translate russian fivesome_breeminamisamsasha_aa062a45:
    "Саша устраивается позади Сэм и кладёт её голову себе на колени."

# ch/harems/home/events/home_harem_samantha.rpy:2608
translate russian fivesome_breeminamisamsasha_d54ce4d0:
    "Оттуда жестами обращается к остальным."

# ch/harems/home/events/home_harem_samantha.rpy:2609
translate russian fivesome_breeminamisamsasha_4772d18e:
    "[lssb_homesam.bree_name()] должна быть слева от неё, Минами — справа."

# ch/harems/home/events/home_harem_samantha.rpy:2613
translate russian fivesome_breeminamisamsasha_9a4fbb04:
    "И наконец она подзывает меня на очевидное место."

# ch/harems/home/events/home_harem_samantha.rpy:2614
translate russian fivesome_breeminamisamsasha_14f06a12:
    "Мне хочется на мгновение задержаться, чтобы запечатлеть эту картину в памяти."

# ch/harems/home/events/home_harem_samantha.rpy:2615
translate russian fivesome_breeminamisamsasha_71ecb013:
    "Вот Сэм — одна из самых красивых девушек, которых я когда-либо встречал."

# ch/harems/home/events/home_harem_samantha.rpy:2616
translate russian fivesome_breeminamisamsasha_638a755b:
    "А её голова лежит между великолепных грудей Саши."

# ch/harems/home/events/home_harem_samantha.rpy:2618
translate russian fivesome_breeminamisamsasha_22c784b2:
    "С одной стороны присела [lssb_homesam.bree_name()] и гладит её плоский живот."

# ch/harems/home/events/home_harem_samantha.rpy:2620
translate russian fivesome_breeminamisamsasha_d0abcaf6:
    "С одной стороны присела [lssb_homesam.bree_name()] и гладит её округлый живот."

# ch/harems/home/events/home_harem_samantha.rpy:2621
translate russian fivesome_breeminamisamsasha_9ab7018d:
    "А с другой Минами ещё и сжимает её груди!"

# ch/harems/home/events/home_harem_samantha.rpy:2622
translate russian fivesome_breeminamisamsasha_39199bc6:
    "Сама Сэм выглядит почти ошеломлённой."

# ch/harems/home/events/home_harem_samantha.rpy:2623
translate russian fivesome_breeminamisamsasha_d2a700da:
    "От внимания остальных девушек она уже начинает тяжело дышать."

# ch/harems/home/events/home_harem_samantha.rpy:2624
translate russian fivesome_breeminamisamsasha_50277307:
    "Но не отводит от меня взгляда, когда я опускаюсь на неё, и предвкушающе прикусывает губу."

# ch/harems/home/events/home_harem_samantha.rpy:2625
translate russian fivesome_breeminamisamsasha_f6b448b3:
    "Теперь я достаточно близко, чтобы чувствовать, как мой член трётся между её ног."

# ch/harems/home/events/home_harem_samantha.rpy:2626
translate russian fivesome_breeminamisamsasha_e21b95d4:
    "И вижу, что она уже становится влажной внизу."

# ch/harems/home/events/home_harem_samantha.rpy:2627
translate russian fivesome_breeminamisamsasha_23d2b12a:
    "И всё же что-то заставляет меня медлить."

# ch/harems/home/events/home_harem_samantha.rpy:2628
translate russian fivesome_breeminamisamsasha_6d9a5b4a:
    "Я не могу понять что — до того мига, когда Сэм с готовностью кивает."

# ch/harems/home/events/home_harem_samantha.rpy:2629
translate russian fivesome_breeminamisamsasha_46b739f6:
    "Вот оно: я ждал её разрешения."

# ch/harems/home/events/home_harem_samantha.rpy:2630
translate russian fivesome_breeminamisamsasha_278ef2fe:
    "И теперь, получив его, я уже ни за что не остановлюсь!"

# ch/harems/home/events/home_harem_samantha.rpy:2631
translate russian fivesome_breeminamisamsasha_b4a60332:
    "Почти одним движением я раздвигаю бёдра Сэм и подаюсь внутрь."

# ch/harems/home/events/home_harem_samantha.rpy:2632
translate russian fivesome_breeminamisamsasha_4fe25da9:
    "Моему члену не нужно указывать путь: он легко находит её губки."

# ch/harems/home/events/home_harem_samantha.rpy:2633
translate russian fivesome_breeminamisamsasha_d63028ee:
    "Я слышу, как Сэм поскуливает от предвкушения, когда головка трётся о влажные складки."

# ch/harems/home/events/home_harem_samantha.rpy:2635
translate russian fivesome_breeminamisamsasha_71bdbcc0:
    "А затем я уже внутри, преодолев остатки сопротивления так, будто их и не было."

# ch/harems/home/events/home_harem_samantha.rpy:2636
translate russian fivesome_breeminamisamsasha_d821affc:
    "Я не останавливаюсь, пока не вхожу в Сэм так глубоко, как только могу."

# ch/harems/home/events/home_harem_samantha.rpy:2637
translate russian fivesome_breeminamisamsasha_59820db5:
    "Затем на миг замираю, просто наслаждаясь ощущением."

# ch/harems/home/events/home_harem_samantha.rpy:2639
translate russian fivesome_breeminamisamsasha_2838e838:
    "Сэм ахает от того, как полно я её заполнил."

# ch/harems/home/events/home_harem_samantha.rpy:2640
translate russian fivesome_breeminamisamsasha_f1e8d42f:
    "А затем стонет, выпуская вместе со стоном все свои чувства."

# ch/harems/home/events/home_harem_samantha.rpy:2641
translate russian fivesome_breeminamisamsasha_8b2606ea:
    "Пока всё это происходит, [lssb_homesam.bree_name()] и Минами не сидят без дела."

# ch/harems/home/events/home_harem_samantha.rpy:2642
translate russian fivesome_breeminamisamsasha_066021f6:
    "Наоборот, удваивают старания, водя руками по беспомощному телу Сэм."

# ch/harems/home/events/home_harem_samantha.rpy:2643
translate russian fivesome_breeminamisamsasha_94f65264:
    "Они целуют её соски, играя с грудью."

# ch/harems/home/events/home_harem_samantha.rpy:2645
translate russian fivesome_breeminamisamsasha_f7e86a08:
    "А свободными руками гладят её округлый живот."

# ch/harems/home/events/home_harem_samantha.rpy:2647
translate russian fivesome_breeminamisamsasha_cc9f1753:
    "А свободными руками гладят её плоский живот."

# ch/harems/home/events/home_harem_samantha.rpy:2648
translate russian fivesome_breeminamisamsasha_5e230dad:
    "Всё время дразня обещанием спуститься ещё ниже..."

# ch/harems/home/events/home_harem_samantha.rpy:2649
translate russian fivesome_breeminamisamsasha_6c5089c6:
    "Чтобы [lssb_homesam.bree_name()] и Минами не делали всю работу сами, я начинаю двигаться внутри Сэм."

# ch/harems/home/events/home_harem_samantha.rpy:2650
translate russian fivesome_breeminamisamsasha_f969e857:
    "Поначалу стараюсь двигаться медленно."

# ch/harems/home/events/home_harem_samantha.rpy:2651
translate russian fivesome_breeminamisamsasha_95a786fc:
    "Но очень скоро чувствую, как темп растёт, когда я отдаюсь моменту."

# ch/harems/home/events/home_harem_samantha.rpy:2652
translate russian fivesome_breeminamisamsasha_8a0afb1c:
    samantha.say "Ох..."

# ch/harems/home/events/home_harem_samantha.rpy:2653
translate russian fivesome_breeminamisamsasha_fc86215f:
    samantha.say "Ох, блядь..."

# ch/harems/home/events/home_harem_samantha.rpy:2655
translate russian fivesome_breeminamisamsasha_9ada12e8:
    bree.say "Хм..."

# ch/harems/home/events/home_harem_samantha.rpy:2656
translate russian fivesome_breeminamisamsasha_69a1be95:
    bree.say "Судя по звукам, кому-то очень хорошо!"

# ch/harems/home/events/home_harem_samantha.rpy:2658
translate russian fivesome_breeminamisamsasha_511b5e58:
    minami.say "Ещё бы! Похоже, она сейчас кончит!"

# ch/harems/home/events/home_harem_samantha.rpy:2659
translate russian fivesome_breeminamisamsasha_f1e1b596:
    sasha.say "Пусть кончает сколько хочет."

# ch/harems/home/events/home_harem_samantha.rpy:2661
translate russian fivesome_breeminamisamsasha_0b928ad0:
    sasha.say "А вот ему нельзя, пока мы с ним не закончим!"

# ch/harems/home/events/home_harem_samantha.rpy:2662
translate russian fivesome_breeminamisamsasha_fa340add:
    "Саша подчёркивает свои слова кивком в мою сторону."

# ch/harems/home/events/home_harem_samantha.rpy:2663
translate russian fivesome_breeminamisamsasha_7e89ba14:
    "Она делает знак, и [lssb_homesam.bree_name()] с Минами поспешно оттаскивают меня от Сэм."

# ch/harems/home/events/home_harem_samantha.rpy:2665
translate russian fivesome_breeminamisamsasha_1ca9d3d7:
    mike.say "Какого чёрта?!"

# ch/harems/home/events/home_harem_samantha.rpy:2667
translate russian fivesome_breeminamisamsasha_036c6e4c:
    samantha.say "Боже!"

# ch/harems/home/events/home_harem_samantha.rpy:2668
translate russian fivesome_breeminamisamsasha_92e1196b:
    samantha.say "Я кончаю... прямо сейчас!"

# ch/harems/home/events/home_harem_samantha.rpy:2669
translate russian fivesome_breeminamisamsasha_fd94f937:
    "Я смотрю, как Сэм сворачивается клубочком на кровати, охваченная оргазмом."

# ch/harems/home/events/home_harem_samantha.rpy:2670
translate russian fivesome_breeminamisamsasha_3536460d:
    "Она стонет и подёргивается, а я невольно чувствую себя немного обделённым."

# ch/harems/home/events/home_harem_samantha.rpy:2671
translate russian fivesome_breeminamisamsasha_5b2cc0fc:
    "Словно понимая мои чувства, Саша хватает меня за руку и поднимает на ноги."

# ch/harems/home/events/home_harem_samantha.rpy:2672
translate russian fivesome_breeminamisamsasha_eede015c:
    sasha.say "Не вешай нос, [lssb_common.hero_name()]."

# ch/harems/home/events/home_harem_samantha.rpy:2673
translate russian fivesome_breeminamisamsasha_96d4528a:
    sasha.say "Следующая часть — удовольствие специально для тебя!"

# ch/harems/home/events/home_harem_samantha.rpy:2677
translate russian fivesome_breeminamisamsasha_3043d9b2:
    "Саша опускается передо мной на колени и целует кончик моего члена."

# ch/harems/home/events/home_harem_samantha.rpy:2678
translate russian fivesome_breeminamisamsasha_42abdc6e:
    "[lssb_homesam.bree_name()] и Минами спешат последовать её примеру."

# ch/harems/home/events/home_harem_samantha.rpy:2679
translate russian fivesome_breeminamisamsasha_df71c9f8:
    "Они тесно придвигаются, чтобы тоже поучаствовать."

# ch/harems/home/events/home_harem_samantha.rpy:2680
translate russian fivesome_breeminamisamsasha_9e6a7c25:
    "Даже Сэм хочет присоединиться и соскальзывает с кровати, как только может."

# ch/harems/home/events/home_harem_samantha.rpy:2681
translate russian fivesome_breeminamisamsasha_34246c2f:
    "Вскоре я почти забываю, что меня оттащили от Сэм."

# ch/harems/home/events/home_harem_samantha.rpy:2682
translate russian fivesome_breeminamisamsasha_d4b174c9:
    "Признаю: минет от всех четверых — более чем достойная компенсация!"

# ch/harems/home/events/home_harem_samantha.rpy:2684
translate russian fivesome_breeminamisamsasha_ad90d79d:
    "Саша, [lssb_homesam.bree_name()], Минами и Сэм передают мой член изо рта в рот."

# ch/harems/home/events/home_harem_samantha.rpy:2686
translate russian fivesome_breeminamisamsasha_8480e395:
    "Переход от одной к другой почти так же приятен, как само пребывание внутри."

# ch/harems/home/events/home_harem_samantha.rpy:2688
translate russian fivesome_breeminamisamsasha_72151d5a:
    "И пока одна сосёт и ласкает его губами, остальные тоже не бездельничают."

# ch/harems/home/events/home_harem_samantha.rpy:2690
translate russian fivesome_breeminamisamsasha_4a1b9354:
    "Почти невозможно понять, кто сейчас сосёт мои яйца, а кто гладит ствол."

# ch/harems/home/events/home_harem_samantha.rpy:2692
translate russian fivesome_breeminamisamsasha_401d178a:
    "Каким-то образом все знают, что и когда делать, и работают словно в идеальной гармонии."

# ch/harems/home/events/home_harem_samantha.rpy:2694
translate russian fivesome_breeminamisamsasha_6ae358ba:
    "Их улыбки радуют меня, а хихиканье звучит музыкой: каждая с нетерпением ждёт своей очереди пососать."

# ch/harems/home/events/home_harem_samantha.rpy:2696
translate russian fivesome_breeminamisamsasha_b3535dc3:
    "Я совсем не хочу, чтобы это заканчивалось, но чувствую, что уже готов кончить!"

# ch/harems/home/events/home_harem_samantha.rpy:2698
translate russian fivesome_breeminamisamsasha_a2ecef36:
    mike.say "Я... я больше не могу!"

# ch/harems/home/events/home_harem_samantha.rpy:2699
translate russian fivesome_breeminamisamsasha_800064b9:
    mike.say "Я сейчас..."

# ch/harems/home/events/home_harem_samantha.rpy:2701
translate russian fivesome_breeminamisamsasha_82f9c15d:
    "Словно по сигналу мой член отпускают, и он покачивается перед ними."

# ch/harems/home/events/home_harem_samantha.rpy:2703
translate russian fivesome_breeminamisamsasha_b1fc9025:
    "Через секунду я кончаю, и движения члена разбрасывают сперму в разные стороны."

# ch/harems/home/events/home_harem_samantha.rpy:2705
translate russian fivesome_breeminamisamsasha_23b15953:
    "Саша, [lssb_homesam.bree_name()], Минами и Сэм получают липкие белые полосы спермы на щёки."

# ch/harems/home/events/home_harem_samantha.rpy:2707
translate russian fivesome_breeminamisamsasha_b65f15bb:
    "Они визжат, вскрикивают и хихикают под этим дождём, наслаждаясь каждым мгновением."

# ch/harems/home/events/home_harem_samantha.rpy:2708
translate russian fivesome_breeminamisamsasha_27a53de8:
    "Я могу лишь стоять и тяжело дышать, пытаясь отдышаться."

# ch/harems/home/events/home_harem_samantha.rpy:2709
translate russian fivesome_breeminamisamsasha_07071360:
    "Первой заговаривает Сэм, слизнув с губ каплю спермы."

# ch/harems/home/events/home_harem_samantha.rpy:2713
translate russian fivesome_breeminamisamsasha_3aeaeb22:
    samantha.say "Ну что, теперь всё официально?"

# ch/harems/home/events/home_harem_samantha.rpy:2714
translate russian fivesome_breeminamisamsasha_d95ce2f8:
    samantha.say "Мы теперь скрепили наш союз?"

# ch/harems/home/events/home_harem_samantha.rpy:2716
translate russian fivesome_breeminamisamsasha_9e4947ff:
    bree.say "Знаю только одно: если не отмоюсь, намертво скреплюсь с этим ковром!"

# ch/harems/home/events/home_harem_samantha.rpy:2718
translate russian fivesome_breeminamisamsasha_ca41667f:
    minami.say "Ага, в следующий раз принесу зонтик!"

# ch/harems/home/events/home_harem_samantha.rpy:2720
translate russian fivesome_breeminamisamsasha_86067c51:
    sasha.say "Не обращай внимания, Сэм. Они думают, что смешно шутят."

# ch/harems/home/events/home_harem_samantha.rpy:2722
translate russian fivesome_breeminamisamsasha_8937c360:
    sasha.say "Но да, теперь ты официально одна из нас."

# ch/harems/home/events/home_harem_samantha.rpy:2723
translate russian fivesome_breeminamisamsasha_f7a9f804:
    "Сэм улыбается, но при этом выразительно смотрит на меня."

# ch/harems/home/events/home_harem_samantha.rpy:2725
translate russian fivesome_breeminamisamsasha_d8b8b4e0:
    samantha.say "Правда, [lssb_common.hero_name()]?"

# ch/harems/home/events/home_harem_samantha.rpy:2727
translate russian fivesome_breeminamisamsasha_50f22529:
    bree.say "О, его не спрашивай, Сэм."

# ch/harems/home/events/home_harem_samantha.rpy:2729
translate russian fivesome_breeminamisamsasha_2b528e47:
    minami.say "Ага, он тут просто мясо!"

# ch/harems/home/events/home_harem_samantha.rpy:2730
translate russian fivesome_breeminamisamsasha_692e7797:
    mike.say "Саша права: вы совсем не смешные!"

# ch/harems/home/events/home_harem_samantha.rpy:2732
translate russian fivesome_breeminamisamsasha_73020cbc:
    mike.say "Ты с нами, Кексик! Конечно!"

# ch/harems/home/events/home_harem_samantha.rpy:2734
translate russian fivesome_breeminamisamsasha_9f4b039e:
    mike.say "Ты с нами, Сэм! Конечно!"

# ch/harems/home/events/home_harem_samantha.rpy:2740
translate russian samantha_sharing_bed_c2094e30:
    "День был долгим и тяжёлым, по крайней мере по моим меркам."

# ch/harems/home/events/home_harem_samantha.rpy:2741
translate russian samantha_sharing_bed_a56f2e86:
    "И думаю я только о том, чтобы лечь и наконец как следует выспаться."

# ch/harems/home/events/home_harem_samantha.rpy:2742
translate russian samantha_sharing_bed_e3de6829:
    "Уверен, перед сном я хотел кое-что выяснить."

# ch/harems/home/events/home_harem_samantha.rpy:2743
translate russian samantha_sharing_bed_c1f1e7ce:
    "Но теперь уже поздно, а что именно — совершенно вылетело из головы."

# ch/harems/home/events/home_harem_samantha.rpy:2745
translate russian samantha_sharing_bed_3370ab3e:
    "Так что можете представить моё раздражение, когда в дверь стучат."

# ch/harems/home/events/home_harem_samantha.rpy:2747
translate russian samantha_sharing_bed_cec1b30b:
    mike.say "Что ещё?!"

# ch/harems/home/events/home_harem_samantha.rpy:2748
translate russian samantha_sharing_bed_88b33e0d:
    "Я продолжаю бормотать себе под нос, шагая через комнату."

# ch/harems/home/events/home_harem_samantha.rpy:2754
translate russian samantha_sharing_bed_e3e33203:
    "Но стоит открыть дверь и заглянуть в коридор, как настроение меняется."

# ch/harems/home/events/home_harem_samantha.rpy:2756
translate russian samantha_sharing_bed_28aa2f3b:
    samantha.say "Привет, [lssb_common.hero_name()]..."

# ch/harems/home/events/home_harem_samantha.rpy:2758
translate russian samantha_sharing_bed_f9e63026:
    samantha.say "Надеюсь, не подняла тебя с постели!"

# ch/harems/home/events/home_harem_samantha.rpy:2760
translate russian samantha_sharing_bed_289e3bf6:
    "Я моргаю, глядя на улыбающуюся Сэм."

# ch/harems/home/events/home_harem_samantha.rpy:2761
translate russian samantha_sharing_bed_6bf9b880:
    "Больше всего меня смущает, что она одета так, будто тоже собирается спать."

# ch/harems/home/events/home_harem_samantha.rpy:2764
translate russian samantha_sharing_bed_bf9bd93e:
    mike.say "Нет, Кексик..."

# ch/harems/home/events/home_harem_samantha.rpy:2766
translate russian samantha_sharing_bed_7d490eab:
    mike.say "Нет, Сэм..."

# ch/harems/home/events/home_harem_samantha.rpy:2767
translate russian samantha_sharing_bed_fc308673:
    mike.say "Я ещё не успел лечь!"

# ch/harems/home/events/home_harem_samantha.rpy:2769
translate russian samantha_sharing_bed_8bcad4ca:
    samantha.say "О, хорошо."

# ch/harems/home/events/home_harem_samantha.rpy:2770
translate russian samantha_sharing_bed_3c42576f:
    samantha.say "Думала, придётся тебя будить!"

# ch/harems/home/events/home_harem_samantha.rpy:2772
translate russian samantha_sharing_bed_cb493e8d:
    samantha.say "Ну, ты меня впустишь или как?"

# ch/harems/home/events/home_harem_samantha.rpy:2774
translate russian samantha_sharing_bed_cdf3ad0e:
    "Сэм пытается протиснуться мимо."

# ch/harems/home/events/home_harem_samantha.rpy:2775
translate russian samantha_sharing_bed_07953db2:
    "А я остаюсь на месте лишь потому, что это совершенно сбивает меня с толку."

# ch/harems/home/events/home_harem_samantha.rpy:2776
translate russian samantha_sharing_bed_73e4233f:
    "Я ведь всегда мечтал, как Сэм ночью прокрадывается в мою комнату."

# ch/harems/home/events/home_harem_samantha.rpy:2777
translate russian samantha_sharing_bed_adb3bad1:
    "Но в моих фантазиях она действовала тоньше и гораздо соблазнительнее!"

# ch/harems/home/events/home_harem_samantha.rpy:2780
translate russian samantha_sharing_bed_9f3cb77e:
    mike.say "Подожди, Кексик!"

# ch/harems/home/events/home_harem_samantha.rpy:2782
translate russian samantha_sharing_bed_262e0870:
    mike.say "Подожди, Сэм!"

# ch/harems/home/events/home_harem_samantha.rpy:2783
translate russian samantha_sharing_bed_19986628:
    mike.say "Что происходит?"

# ch/harems/home/events/home_harem_samantha.rpy:2784
translate russian samantha_sharing_bed_a26bfffb:
    mike.say "Почему ты сейчас хочешь зайти ко мне в спальню?"

# ch/harems/home/events/home_harem_samantha.rpy:2786
translate russian samantha_sharing_bed_f0956aff:
    "Сэм отступает на шаг и выглядит весьма растерянной."

# ch/harems/home/events/home_harem_samantha.rpy:2788
translate russian samantha_sharing_bed_6f3dcfbd:
    samantha.say "Я..."

# ch/harems/home/events/home_harem_samantha.rpy:2789
translate russian samantha_sharing_bed_7e8a498b:
    samantha.say "Я думала, мы так договорились?"

# ch/harems/home/events/home_harem_samantha.rpy:2791
translate russian samantha_sharing_bed_b7ddf166:
    mike.say "Когда мы договаривались, что ты будешь спать со мной?!"

# ch/harems/home/events/home_harem_samantha.rpy:2793
translate russian samantha_sharing_bed_d6d19f01:
    samantha.say "Разве мы не решили, что я буду ночевать с каждым из вас по очереди?"

# ch/harems/home/events/home_harem_samantha.rpy:2797
translate russian samantha_sharing_bed_6e7568df:
    "Как только Сэм объясняется, я хлопаю себя по лбу."

# ch/harems/home/events/home_harem_samantha.rpy:2798
translate russian samantha_sharing_bed_36b09360:
    "Вот оно — то, что я собирался спросить у остальных."

# ch/harems/home/events/home_harem_samantha.rpy:2799
translate russian samantha_sharing_bed_10541f3f:
    "Сэм уже ночевала со всеми девушками."

# ch/harems/home/events/home_harem_samantha.rpy:2800
translate russian samantha_sharing_bed_3cf6ecc1:
    "Где ей спать после этого?"

# ch/harems/home/events/home_harem_samantha.rpy:2801
translate russian samantha_sharing_bed_d39de9e6:
    "Я ожидал, что они просто начнут круг заново."

# ch/harems/home/events/home_harem_samantha.rpy:2802
translate russian samantha_sharing_bed_02a11243:
    "Но, похоже, у Сэм совсем другое представление."

# ch/harems/home/events/home_harem_samantha.rpy:2803
translate russian samantha_sharing_bed_a39f33cb:
    mike.say "Я... я думал, ты будешь ночевать только с девушками?"

# ch/harems/home/events/home_harem_samantha.rpy:2804
translate russian samantha_sharing_bed_05f1867a:
    mike.say "То есть... Я предполагал, что ты не захочешь спать со мной в одной комнате!"

# ch/harems/home/events/home_harem_samantha.rpy:2805
translate russian samantha_sharing_bed_f21f13d9:
    mike.say "Ну, с парнем!"

# ch/harems/home/events/home_harem_samantha.rpy:2807
translate russian samantha_sharing_bed_c16a68aa:
    "Сэм качает головой, немного озадаченная."

# ch/harems/home/events/home_harem_samantha.rpy:2808
translate russian samantha_sharing_bed_8c01b238:
    samantha.say "Почему, [lssb_common.hero_name()]?"

# ch/harems/home/events/home_harem_samantha.rpy:2810
translate russian samantha_sharing_bed_d8860974:
    samantha.say "Мы ведь друзья?"

# ch/harems/home/events/home_harem_samantha.rpy:2811
translate russian samantha_sharing_bed_6ec447f2:
    samantha.say "И тебя я знаю дольше всех, кто здесь живёт, верно?"

# ch/harems/home/events/home_harem_samantha.rpy:2813
translate russian samantha_sharing_bed_a3b090cf:
    samantha.say "Я доверяю тебе заботиться обо мне."

# ch/harems/home/events/home_harem_samantha.rpy:2815
translate russian samantha_sharing_bed_ac9bb698:
    "Улыбка, с которой Сэм всё это говорит, — нечестный приём."

# ch/harems/home/events/home_harem_samantha.rpy:2816
translate russian samantha_sharing_bed_5bd9c05c:
    "Она озаряет всё её лицо, и я мгновенно таю внутри."

# ch/harems/home/events/home_harem_samantha.rpy:2817
translate russian samantha_sharing_bed_2025ee72:
    "Но решение нужно принять быстро."

# ch/harems/home/events/home_harem_samantha.rpy:2818
translate russian samantha_sharing_bed_627b36c1:
    "Не могу же я оставить её в коридоре на всю ночь."

# ch/harems/home/events/home_harem_samantha.rpy:2822
translate russian samantha_sharing_bed_d5f90c62:
    mike.say "Просто не думаю, что это хорошая идея, Сэм. Вот и всё."

# ch/harems/home/events/home_harem_samantha.rpy:2823
translate russian samantha_sharing_bed_fdf86b9c:
    "Сэм хмурится и склоняет голову набок."

# ch/harems/home/events/home_harem_samantha.rpy:2825
translate russian samantha_sharing_bed_179fb444:
    samantha.say "Что ты имеешь в виду, [lssb_common.hero_name()]?"

# ch/harems/home/events/home_harem_samantha.rpy:2826
translate russian samantha_sharing_bed_4be207f9:
    samantha.say "Почему плохая?"

# ch/harems/home/events/home_harem_samantha.rpy:2827
translate russian samantha_sharing_bed_af38faf9:
    "Я вздыхаю и качаю головой."

# ch/harems/home/events/home_harem_samantha.rpy:2829
translate russian samantha_sharing_bed_0540332c:
    mike.say "Послушай, Кексик..."

# ch/harems/home/events/home_harem_samantha.rpy:2831
translate russian samantha_sharing_bed_6da8c0d3:
    mike.say "Послушай, Сэм..."

# ch/harems/home/events/home_harem_samantha.rpy:2832
translate russian samantha_sharing_bed_e1d29b84:
    mike.say "В последнее время ты многое пережила."

# ch/harems/home/events/home_harem_samantha.rpy:2833
translate russian samantha_sharing_bed_add1043e:
    mike.say "Весь твой мир перевернулся."

# ch/harems/home/events/home_harem_samantha.rpy:2834
translate russian samantha_sharing_bed_44548294:
    mike.say "И от такого люди порой делают то, чего обычно никогда бы не сделали."

# ch/harems/home/events/home_harem_samantha.rpy:2835
translate russian samantha_sharing_bed_6f0d6d67:
    mike.say "Могут воспринимать вещи иначе, чем в другое время."

# ch/harems/home/events/home_harem_samantha.rpy:2836
translate russian samantha_sharing_bed_bfc4ebee:
    "Сэм немного расслабляет нахмуренные брови, обдумывая мои слова."

# ch/harems/home/events/home_harem_samantha.rpy:2837
translate russian samantha_sharing_bed_c67da2d2:
    "Затем кивает, словно начиная понимать."

# ch/harems/home/events/home_harem_samantha.rpy:2839
translate russian samantha_sharing_bed_3c173129:
    samantha.say "Я... кажется, понимаю, [lssb_common.hero_name()]."

# ch/harems/home/events/home_harem_samantha.rpy:2840
translate russian samantha_sharing_bed_36a4e11d:
    samantha.say "Наверное, все мы немного не в себе, да?"

# ch/harems/home/events/home_harem_samantha.rpy:2841
translate russian samantha_sharing_bed_18a0d614:
    samantha.say "Это как напиться и сделать то, о чём потом пожалеешь, верно?"

# ch/harems/home/events/home_harem_samantha.rpy:2844
translate russian samantha_sharing_bed_3998d201:
    mike.say "Да, Кексик..."

# ch/harems/home/events/home_harem_samantha.rpy:2846
translate russian samantha_sharing_bed_7a91cf6a:
    mike.say "Да, Сэм..."

# ch/harems/home/events/home_harem_samantha.rpy:2847
translate russian samantha_sharing_bed_f553052d:
    mike.say "Что-то вроде того."

# ch/harems/home/events/home_harem_samantha.rpy:2849
translate russian samantha_sharing_bed_d5f1f381:
    "Она снова кивает и отступает от двери."

# ch/harems/home/events/home_harem_samantha.rpy:2851
translate russian samantha_sharing_bed_5da770cc:
    samantha.say "Может, постучусь к кому-нибудь ещё."

# ch/harems/home/events/home_harem_samantha.rpy:2852
translate russian samantha_sharing_bed_452e8108:
    samantha.say "Найду тихое место, чтобы обдумать твои слова."

# ch/harems/home/events/home_harem_samantha.rpy:2857
translate russian samantha_sharing_bed_8ab985b2:
    "С этими словами она разворачивается и уходит."

# ch/harems/home/events/home_harem_samantha.rpy:2858
translate russian samantha_sharing_bed_d2252d5d:
    "А мне остаётся закрыть дверь и лечь."

# ch/harems/home/events/home_harem_samantha.rpy:2860
translate russian samantha_sharing_bed_79d8969f:
    "Всё это время я надеюсь, что принял правильное решение."

# ch/harems/home/events/home_harem_samantha.rpy:2861
translate russian samantha_sharing_bed_b9e35d94:
    "Потому что сейчас от него паршиво."

# ch/harems/home/events/home_harem_samantha.rpy:2862
translate russian samantha_sharing_bed_706ed354:
    "Надеюсь, в будущем оно себя оправдает!"

# ch/harems/home/events/home_harem_samantha.rpy:2866
translate russian samantha_sharing_bed_931c99a9:
    mike.say "Ладно, Кексик..."

# ch/harems/home/events/home_harem_samantha.rpy:2868
translate russian samantha_sharing_bed_649609fc:
    mike.say "Ладно, Сэм..."

# ch/harems/home/events/home_harem_samantha.rpy:2869
translate russian samantha_sharing_bed_c1c5922d:
    mike.say "Ты победила. Сегодня можешь спать в моей кровати."

# ch/harems/home/events/home_harem_samantha.rpy:2871
translate russian samantha_sharing_bed_010f97c6:
    mike.say "Но!"

# ch/harems/home/events/home_harem_samantha.rpy:2872
translate russian samantha_sharing_bed_7e84032d:
    "Я поднимаю руку, останавливая Сэм, когда она с улыбкой пытается пройти мимо."

# ch/harems/home/events/home_harem_samantha.rpy:2873
translate russian samantha_sharing_bed_ca45550b:
    mike.say "Но только при условии, что я сплю на полу, хорошо?"

# ch/harems/home/events/home_harem_samantha.rpy:2875
translate russian samantha_sharing_bed_5c02e2e5:
    "Я изучаю выражение её лица в ответ на свой ультиматум."

# ch/harems/home/events/home_harem_samantha.rpy:2876
translate russian samantha_sharing_bed_f98c0414:
    "Она выглядит удивлённой и, может, даже немного разочарованной."

# ch/harems/home/events/home_harem_samantha.rpy:2877
translate russian samantha_sharing_bed_e5dffd9b:
    "Но всё же кивает, соглашаясь на мои условия."

# ch/harems/home/events/home_harem_samantha.rpy:2879
translate russian samantha_sharing_bed_487aba9f:
    samantha.say "Конечно, [lssb_common.hero_name()]..."

# ch/harems/home/events/home_harem_samantha.rpy:2880
translate russian samantha_sharing_bed_a40763a6:
    samantha.say "Если ты этого хочешь."

# ch/harems/home/events/home_harem_samantha.rpy:2882
translate russian samantha_sharing_bed_808be816:
    "Я киваю и отступаю, наконец впуская Сэм в комнату."

# ch/harems/home/events/home_harem_samantha.rpy:2886
translate russian samantha_sharing_bed_92717af8:
    "Она спешит к кровати, пока я закрываю за ней дверь."

# ch/harems/home/events/home_harem_samantha.rpy:2887
translate russian samantha_sharing_bed_4b44c0f1:
    "А когда оборачиваюсь, она уже под одеялом."

# ch/harems/home/events/home_harem_samantha.rpy:2888
translate russian samantha_sharing_bed_b8297bf0:
    "Я изо всех сил стараюсь держаться непринуждённо, будто её вид ничего для меня не значит."

# ch/harems/home/events/home_harem_samantha.rpy:2889
translate russian samantha_sharing_bed_6ec5a085:
    "Но на самом деле это одно из самых трудных испытаний в моей жизни."

# ch/harems/home/events/home_harem_samantha.rpy:2890
translate russian samantha_sharing_bed_a50976ed:
    "Не сосчитать, сколько раз я представлял Сэм в своей постели."

# ch/harems/home/events/home_harem_samantha.rpy:2891
