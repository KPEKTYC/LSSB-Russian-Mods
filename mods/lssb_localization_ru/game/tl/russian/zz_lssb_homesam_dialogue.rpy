# ch/harems/home/events/home_harem_samantha.rpy:3373
translate russian samantha_sasha_pregnant_showdown_bd328ab8:
    sasha.say "У тебя вообще есть хоть капля самоуважения?!"

# ch/harems/home/events/home_harem_samantha.rpy:3374
translate russian samantha_sasha_pregnant_showdown_85e76235:
