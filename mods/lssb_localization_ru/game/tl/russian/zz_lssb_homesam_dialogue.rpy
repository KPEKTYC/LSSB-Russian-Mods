# ch/harems/home/events/home_harem_samantha.rpy:3398
translate russian samantha_sasha_pregnant_showdown_526bdfb2_1:
    samantha.say "После всех этих слов ты оказался точно таким же!"

# ch/harems/home/events/home_harem_samantha.rpy:3400
translate russian samantha_sasha_pregnant_showdown_eb7e28f8:
    "Я смотрю, как Сэм тоже разворачивается и уходит."

# ch/harems/home/events/home_harem_samantha.rpy:3401
translate russian samantha_sasha_pregnant_showdown_a9d2f345:
    "И я остаюсь стоять один."

# ch/harems/home/events/home_harem_samantha.rpy:3402
translate russian samantha_sasha_pregnant_showdown_40e64bdf:
    "Похоже, я так и не узнаю, кого из них любил сильнее."

# ch/harems/home/events/home_harem_samantha.rpy:3403
translate russian samantha_sasha_pregnant_showdown_6b469f3b:
    "Потому что я всё испортил."

# ch/harems/home/events/home_harem_samantha.rpy:3404
translate russian samantha_sasha_pregnant_showdown_3dea4bfa:
    "Окончательно. И с обеими."

# ch/harems/home/events/home_harem_samantha.rpy:3415
translate russian bree_minami_samantha_sasha_male_ending_d95e14ab:
    "Кажется, я должен уметь без запинки рассказать долгую и увлекательную историю о том, как оказался здесь."

# ch/harems/home/events/home_harem_samantha.rpy:3416
translate russian bree_minami_samantha_sasha_male_ending_536f6b04:
    "Ведь кто способен забыть события, благодаря которым женился сразу на четырёх девушках?"

# ch/harems/home/events/home_harem_samantha.rpy:3417
translate russian bree_minami_samantha_sasha_male_ending_1c58ed6f:
    "Нет, позвольте уточнить: на четырёх самых горячих девушках, которых я встречал за всю жизнь!"

# ch/harems/home/events/home_harem_samantha.rpy:3418
translate russian bree_minami_samantha_sasha_male_ending_d4f0cbba:
    "Но сейчас всё как в тумане — всё-таки сегодня тот самый большой день..."

# ch/harems/home/events/home_harem_samantha.rpy:3419
translate russian bree_minami_samantha_sasha_male_ending_40b2e856:
    "Уверен, я всё вспомню, когда церемония закончится и волнение уляжется."

# ch/harems/home/events/home_harem_samantha.rpy:3420
translate russian bree_minami_samantha_sasha_male_ending_3ffcf385:
    "А пока придётся смириться с тем, что голова кружится от волнения и предвкушения."

# ch/harems/home/events/home_harem_samantha.rpy:3421
translate russian bree_minami_samantha_sasha_male_ending_f5f6a6e2:
    "Есть такое клише: женщины всю жизнь планируют свою свадьбу до мельчайших подробностей."

# ch/harems/home/events/home_harem_samantha.rpy:3422
translate russian bree_minami_samantha_sasha_male_ending_4fd20ffa:
    "А среднестатистический парень, скорее всего, даже не задумывается, как она пройдёт."

# ch/harems/home/events/home_harem_samantha.rpy:3423
translate russian bree_minami_samantha_sasha_male_ending_937ac623:
    "Но в моём случае можно с полным правом сказать: строить догадки было бы пустой тратой времени."

# ch/harems/home/events/home_harem_samantha.rpy:3424
translate russian bree_minami_samantha_sasha_male_ending_0d356cc4:
    "Ну как я мог предвидеть, что на моей свадьбе будут четверо вступающих в брак?"

# ch/harems/home/events/home_harem_samantha.rpy:3425
translate russian bree_minami_samantha_sasha_male_ending_553cf789:
    "Точнее, пятеро, если считать и меня!"

# ch/harems/home/events/home_harem_samantha.rpy:3426
translate russian bree_minami_samantha_sasha_male_ending_ed1f56d3:
    "Я был бы счастлив с любой из двух симпатичных соседок, которые ко мне въехали."

# ch/harems/home/events/home_harem_samantha.rpy:3427
translate russian bree_minami_samantha_sasha_male_ending_6869a24f:
    "Но когда мы начали встречаться втроём — я, [lssb_homesam.bree_name()] и Саша, — я едва мог в это поверить."

# ch/harems/home/events/home_harem_samantha.rpy:3428
translate russian bree_minami_samantha_sasha_male_ending_63a7430c:
    "Переезд Минами мог всё разрушить."

# ch/harems/home/events/home_harem_samantha.rpy:3429
translate russian bree_minami_samantha_sasha_male_ending_2554e5d0:
    "Особенно когда выяснилось, что у неё тоже есть на меня виды!"

# ch/harems/home/events/home_harem_samantha.rpy:3430
translate russian bree_minami_samantha_sasha_male_ending_469b9bfc:
    "И всё же вскоре она тоже стала частью наших отношений."

# ch/harems/home/events/home_harem_samantha.rpy:3431
translate russian bree_minami_samantha_sasha_male_ending_b8833bc8:
    "Наверное, я ещё не успел от этого оправиться, когда к нам добавилась Сэм."

# ch/harems/home/events/home_harem_samantha.rpy:3432
translate russian bree_minami_samantha_sasha_male_ending_59fe18ba:
    "Та, которую, как я думал, я потерял навсегда."

# ch/harems/home/events/home_harem_samantha.rpy:3433
translate russian bree_minami_samantha_sasha_male_ending_c874040a:
    "Девушка, с которой я уже смирился попрощаться."

# ch/harems/home/events/home_harem_samantha.rpy:3434
translate russian bree_minami_samantha_sasha_male_ending_be615b7a:
    "Вдруг она снова оказалась рядом."

# ch/harems/home/events/home_harem_samantha.rpy:3435
translate russian bree_minami_samantha_sasha_male_ending_86e17379:
    "И даже то, что я уже встречался с тремя другими девушками, её, похоже, не смущало!"

# ch/harems/home/events/home_harem_samantha.rpy:3436
translate russian bree_minami_samantha_sasha_male_ending_087ccde3:
    "Я и опомниться не успел, как мы уже были вместе со всеми четырьмя."

# ch/harems/home/events/home_harem_samantha.rpy:3437
translate russian bree_minami_samantha_sasha_male_ending_df93d969:
    "Причём это оказалось не просто безумной интрижкой."

# ch/harems/home/events/home_harem_samantha.rpy:3438
translate russian bree_minami_samantha_sasha_male_ending_e06324a4:
    "На четыре предложения руки и сердца я получил четыре ответа «да»."

# ch/harems/home/events/home_harem_samantha.rpy:3439
translate russian bree_minami_samantha_sasha_male_ending_39423769:
    "Так мы и пришли к этому моменту — здесь и сейчас."

# ch/harems/home/events/home_harem_samantha.rpy:3440
translate russian bree_minami_samantha_sasha_male_ending_c8bac623:
    "Я так глубоко погрузился в мысли, что едва замечаю музыку, наполняющую часовню."

# ch/harems/home/events/home_harem_samantha.rpy:3446
translate russian bree_minami_samantha_sasha_male_ending_e368f0b4:
    "Я прихожу в себя, только когда все четверо появляются в другом конце прохода."

# ch/harems/home/events/home_harem_samantha.rpy:3447
translate russian bree_minami_samantha_sasha_male_ending_402d250a:
    "Проход слишком узкий, чтобы они могли идти рядом."

# ch/harems/home/events/home_harem_samantha.rpy:3448
translate russian bree_minami_samantha_sasha_male_ending_9427a6b6:
    "Но, похоже, никто не захотел оказаться позади."

# ch/harems/home/events/home_harem_samantha.rpy:3449
translate russian bree_minami_samantha_sasha_male_ending_4150ecf9:
    "Или же все слишком стеснялись идти первыми."

# ch/harems/home/events/home_harem_samantha.rpy:3454
translate russian bree_minami_samantha_sasha_male_ending_f8b3ba5b:
    "Поэтому они идут по проходу вместе, тесной группкой."

# ch/harems/home/events/home_harem_samantha.rpy:3455
translate russian bree_minami_samantha_sasha_male_ending_e40370a7:
    "Что вполне уместно, ведь мы все вступаем в брак друг с другом."

# ch/harems/home/events/home_harem_samantha.rpy:3456
translate russian bree_minami_samantha_sasha_male_ending_38e73780:
    "После обмена клятвами мы будем равны в этих отношениях."

# ch/harems/home/events/home_harem_samantha.rpy:3457
translate russian bree_minami_samantha_sasha_male_ending_9c2e2ddd:
    "В своих платьях они выглядят потрясающе — прекраснее невест и представить нельзя."

# ch/harems/home/events/home_harem_samantha.rpy:3458
translate russian bree_minami_samantha_sasha_male_ending_53206b4a:
    "Но все они разные, и в нарядах виден характер каждой."

# ch/harems/home/events/home_harem_samantha.rpy:3460
translate russian bree_minami_samantha_sasha_male_ending_b5582968:
    "[lssb_homesam.bree_name()] вся в розовом, её светлые волосы подпрыгивают при каждом шаге ко мне."

# ch/harems/home/events/home_harem_samantha.rpy:3461
translate russian bree_minami_samantha_sasha_male_ending_26e85e82:
    "Её улыбка ещё прекраснее платья."

# ch/harems/home/events/home_harem_samantha.rpy:3463
translate russian bree_minami_samantha_sasha_male_ending_fd4e4b79:
    "Саша, как всегда, в чёрном, оттеняющем бледность её кожи."

# ch/harems/home/events/home_harem_samantha.rpy:3464
translate russian bree_minami_samantha_sasha_male_ending_56d6cc69:
    "Она выглядит мрачной и задумчивой, но вместе с тем чувственной и чарующей."

# ch/harems/home/events/home_harem_samantha.rpy:3466
translate russian bree_minami_samantha_sasha_male_ending_55900e85:
    "А вот Минами — миниатюрная и буквально переполненная жизнью."

# ch/harems/home/events/home_harem_samantha.rpy:3467
translate russian bree_minami_samantha_sasha_male_ending_3d5c5f4d:
    "На ней шёлковое платье, покрытое затейливыми узорами."

# ch/harems/home/events/home_harem_samantha.rpy:3468
translate russian bree_minami_samantha_sasha_male_ending_1a520ad5:
    "При этом у него современный крой, который ей очень идёт."

# ch/harems/home/events/home_harem_samantha.rpy:3470
translate russian bree_minami_samantha_sasha_male_ending_1dc3030d:
    "И наконец Сэм — единственная, кого я уже видел в свадебном платье."

# ch/harems/home/events/home_harem_samantha.rpy:3471
translate russian bree_minami_samantha_sasha_male_ending_9f7c838b:
    "Но почему-то в этом она выглядит гораздо лучше, чем в предыдущем!"

# ch/harems/home/events/home_harem_samantha.rpy:3473
translate russian bree_minami_samantha_sasha_male_ending_a9e8b716:
    "Наверное, при виде четырёх больших беременных животиков мне следовало бы вспотеть от волнения."

# ch/harems/home/events/home_harem_samantha.rpy:3474
translate russian bree_minami_samantha_sasha_male_ending_e51ee425:
    "И я не представляю, что думают гости на скамьях о том, что все девушки беременны одновременно."

# ch/harems/home/events/home_harem_samantha.rpy:3475
translate russian bree_minami_samantha_sasha_male_ending_19aaa830:
    "Но мне, честно говоря, всё равно: мы уже большая семья, а скоро станем ещё больше!"

# ch/harems/home/events/home_harem_samantha.rpy:3477
translate russian bree_minami_samantha_sasha_male_ending_763c78f2:
    "У алтаря рядом со мной стоят [lssb_homesam.bree_name()], Саша, Минами и Сэм, и я не могу отвести от них глаз."

# ch/harems/home/events/home_harem_samantha.rpy:3478
translate russian bree_minami_samantha_sasha_male_ending_842ba36f:
    "Четыре мои невесты — скоро четыре мои жены!"

# ch/harems/home/events/home_harem_samantha.rpy:3481
translate russian bree_minami_samantha_sasha_male_ending_01c7eeb4:
    "Мастер, которому [lssb_homesam.bree_name()] заказала платье, сотворил настоящее чудо."

# ch/harems/home/events/home_harem_samantha.rpy:3482
translate russian bree_minami_samantha_sasha_male_ending_6617f14a:
    "Когда она держит букет, её уже огромного живота почти не видно!"

# ch/harems/home/events/home_harem_samantha.rpy:3483
translate russian bree_minami_samantha_sasha_male_ending_ed3742ab:
    "Не то чтобы я хотел забыть, что она носит моего ребёнка."

# ch/harems/home/events/home_harem_samantha.rpy:3485
translate russian bree_minami_samantha_sasha_male_ending_430579b3:
    "Когда Саша подходит ближе, я замечаю, что бледна она не только из-за макияжа."

# ch/harems/home/events/home_harem_samantha.rpy:3486
translate russian bree_minami_samantha_sasha_male_ending_7e9b46ea:
    "У неё уже довольно большой срок, и беременность даётся ей нелегко."

# ch/harems/home/events/home_harem_samantha.rpy:3487
translate russian bree_minami_samantha_sasha_male_ending_8fa2a51b:
