# ch/harems/home/events/home_harem_samantha.rpy:977
translate russian introduce_sam_to_girls_e622e30b:
    mike.say "Не то чтобы я говорил, что кто-то будет раздеваться!"

# ch/harems/home/events/home_harem_samantha.rpy:982
translate russian introduce_sam_to_girls_d8bfde56:
    "Остальные уже открыто смеются, забавляясь моим смущением."

# ch/harems/home/events/home_harem_samantha.rpy:983
translate russian introduce_sam_to_girls_d9a5119b:
    "Сэм, кажется, скорее растеряна, чем что-либо ещё."

# ch/harems/home/events/home_harem_samantha.rpy:984
translate russian introduce_sam_to_girls_69ac1ba2:
