# ch/harems/home/events/home_harem_samantha.rpy:497
translate russian ask_bree_about_sam_b1e47f34:
    "Пожалуй, сейчас мне стоит считать себя везунчиком. Если честно, ОЧЕНЬ большим везунчиком!"

# ch/harems/home/events/home_harem_samantha.rpy:498
translate russian ask_bree_about_sam_cb5dad18:
    "Ведь с Сэм я получил девушку, которую всегда хотел и которую, как мне казалось, упустил."

# ch/harems/home/events/home_harem_samantha.rpy:499
translate russian ask_bree_about_sam_e4be32f4:
    "Но одновременно я живу так, как большинство парней лишь мечтает."

# ch/harems/home/events/home_harem_samantha.rpy:500
translate russian ask_bree_about_sam_8826f511:
    "У меня отношения со всеми девушками, которые въехали после её переезда!"

# ch/harems/home/events/home_harem_samantha.rpy:501
translate russian ask_bree_about_sam_6ac16e94:
    "Мало того: когда Сэм об этом узнала, она отнеслась совершенно спокойно."

# ch/harems/home/events/home_harem_samantha.rpy:502
translate russian ask_bree_about_sam_8e1e39a5:
    "Она попросила лишь полной откровенности — рассказывать ей, с кем и когда я трахаюсь."

# ch/harems/home/events/home_harem_samantha.rpy:503
translate russian ask_bree_about_sam_2297da9f:
    "Большинство парней захотело бы оставить всё как есть, сочтя это идеалом."

# ch/harems/home/events/home_harem_samantha.rpy:504
translate russian ask_bree_about_sam_2577458c:
    "Что ж, можете назвать меня дураком."

# ch/harems/home/events/home_harem_samantha.rpy:505
translate russian ask_bree_about_sam_8ec6dcb8:
    "Но я вижу способ сделать всё ещё чуточку лучше."

# ch/harems/home/events/home_harem_samantha.rpy:506
translate russian ask_bree_about_sam_bfe7e23d:
    "Что, если Сэм присоединится к нашим отношениям с девушками, живущими со мной?"

# ch/harems/home/events/home_harem_samantha.rpy:507
translate russian ask_bree_about_sam_28ee8d80:
    "Нужно лишь убедить их, что это отличная идея."

# ch/harems/home/events/home_harem_samantha.rpy:508
translate russian ask_bree_about_sam_2a5a14ff:
    "И насколько это может быть трудно?"

# ch/harems/home/events/home_harem_samantha.rpy:510
translate russian ask_bree_about_sam_6e3e27f6:
    "Вскоре [lssb_homesam.bree_name()] оказывается рядом, и у меня появляется возможность затронуть эту тему..."

# ch/harems/home/events/home_harem_samantha.rpy:511
translate russian ask_bree_about_sam_dcd0ec43:
    mike.say "А, привет, [lssb_homesam.bree_name()]!"

# ch/harems/home/events/home_harem_samantha.rpy:513
translate russian ask_bree_about_sam_bf853ecd:
    bree.say "О, привет, [lssb_common.hero_name()]."

# ch/harems/home/events/home_harem_samantha.rpy:516
translate russian ask_bree_about_sam_075123f1:
    bree.say "Что-то случилось?"

# ch/harems/home/events/home_harem_samantha.rpy:517
translate russian ask_bree_about_sam_bae14da0:
    mike.say "А... что?"

# ch/harems/home/events/home_harem_samantha.rpy:518
translate russian ask_bree_about_sam_f4559d2d:
    mike.say "Нет... а почему... должно было?"

# ch/harems/home/events/home_harem_samantha.rpy:520
translate russian ask_bree_about_sam_369e1ed9:
    "[lssb_homesam.bree_name()] не выдерживает и заливается хихиканьем."

# ch/harems/home/events/home_harem_samantha.rpy:521
translate russian ask_bree_about_sam_f67d3627:
    "Её явно очень забавляет, как легко меня смутить."

# ch/harems/home/events/home_harem_samantha.rpy:522
translate russian ask_bree_about_sam_1649135f:
    bree.say "Честно, [lssb_common.hero_name()], тебя так легко раскусить."

# ch/harems/home/events/home_harem_samantha.rpy:523
translate russian ask_bree_about_sam_9f7b10f3:
    bree.say "Можешь с тем же успехом повесить табличку себе на шею!"

# ch/harems/home/events/home_harem_samantha.rpy:524
translate russian ask_bree_about_sam_4390800e:
    mike.say "А... ладно, [lssb_homesam.bree_name()], ты меня поймала."

# ch/harems/home/events/home_harem_samantha.rpy:525
translate russian ask_bree_about_sam_09579481:
    mike.say "Признаю: кое-что всё-таки случилось."

# ch/harems/home/events/home_harem_samantha.rpy:526
translate russian ask_bree_about_sam_497c543d:
    "Услышав это, [lssb_homesam.bree_name()] заметно меняется."

# ch/harems/home/events/home_harem_samantha.rpy:528
translate russian ask_bree_about_sam_662d7d41:
    "Она становится серьёзнее, даже немного встревоженной."

# ch/harems/home/events/home_harem_samantha.rpy:529
translate russian ask_bree_about_sam_69d510c6:
    "И полностью сосредоточивается на мне, ожидая, что я скажу."

# ch/harems/home/events/home_harem_samantha.rpy:530
translate russian ask_bree_about_sam_9b30bc7b:
    "Вот это девушка."

# ch/harems/home/events/home_harem_samantha.rpy:531
translate russian ask_bree_about_sam_f9c914a3:
    "Мне повезло уже просто жить с ней, не говоря об отношениях!"

# ch/harems/home/events/home_harem_samantha.rpy:532
translate russian ask_bree_about_sam_1dd08205:
    bree.say "Я слушаю, [lssb_common.hero_name()]."

# ch/harems/home/events/home_harem_samantha.rpy:533
translate russian ask_bree_about_sam_6732c0ea:
    bree.say "Что случилось?"

# ch/harems/home/events/home_harem_samantha.rpy:534
translate russian ask_bree_about_sam_e0cab858:
    mike.say "Ну, помнишь Сэм?"

# ch/harems/home/events/home_harem_samantha.rpy:535
translate russian ask_bree_about_sam_7a7ddc8d:
    mike.say "Она жила здесь до твоего переезда."

# ch/harems/home/events/home_harem_samantha.rpy:537
translate russian ask_bree_about_sam_0109ea69:
    "[lssb_homesam.bree_name()] на мгновение задумывается."

# ch/harems/home/events/home_harem_samantha.rpy:539
translate russian ask_bree_about_sam_c1d69314:
    "Но затем кивает."

# ch/harems/home/events/home_harem_samantha.rpy:540
translate russian ask_bree_about_sam_00692c15:
    bree.say "Помню, ты рассказывал мне о ней и Райане."

# ch/harems/home/events/home_harem_samantha.rpy:541
translate russian ask_bree_about_sam_f984e688:
    bree.say "И, кажется, однажды нас познакомил."

# ch/harems/home/events/home_harem_samantha.rpy:542
translate russian ask_bree_about_sam_62c92e76:
    bree.say "Хотя теперь я думаю: может, это была одна из твоих коллег!"

# ch/harems/home/events/home_harem_samantha.rpy:543
translate russian ask_bree_about_sam_1513c14c:
    mike.say "Да, [lssb_homesam.bree_name()], неважно."

# ch/harems/home/events/home_harem_samantha.rpy:544
translate russian ask_bree_about_sam_9c4ccbc0:
    mike.say "Дело в том, что я всегда был к ней немного неравнодушен."

# ch/harems/home/events/home_harem_samantha.rpy:545
translate russian ask_bree_about_sam_63cff4fb:
    mike.say "И недавно она рассталась с Райаном."

# ch/harems/home/events/home_harem_samantha.rpy:547
translate russian ask_bree_about_sam_79fd3c64:
    bree.say "Ох, как жаль."

# ch/harems/home/events/home_harem_samantha.rpy:548
translate russian ask_bree_about_sam_04338547:
    mike.say "Да, наверное, можно и так сказать..."

# ch/harems/home/events/home_harem_samantha.rpy:549
translate russian ask_bree_about_sam_fd617e5d:
    mike.say "Ей нужен был друг, и, ну..."

# ch/harems/home/events/home_harem_samantha.rpy:550
translate russian ask_bree_about_sam_fe0448a7:
    mike.say "В итоге я стал для неё кое-кем побольше!"

# ch/harems/home/events/home_harem_samantha.rpy:553
translate russian ask_bree_about_sam_6f69266b:
    "[lssb_homesam.bree_name()] смотрит на меня с потрясённым видом."

# ch/harems/home/events/home_harem_samantha.rpy:554
translate russian ask_bree_about_sam_20d786d6:
    bree.say "Боже мой!"

# ch/harems/home/events/home_harem_samantha.rpy:556
translate russian ask_bree_about_sam_08321d27:
    bree.say "Она трахнулась с тобой назло бывшему?!"

# ch/harems/home/events/home_harem_samantha.rpy:557
translate russian ask_bree_about_sam_208923ac:
    mike.say "Можно и так сказать, да!"

# ch/harems/home/events/home_harem_samantha.rpy:561
translate russian ask_bree_about_sam_05e1e6a0:
    bree.say "Ты с ней спал?"

# ch/harems/home/events/home_harem_samantha.rpy:562
translate russian ask_bree_about_sam_ccde8487:
    mike.say "Прости, что рассказываю об этом вот так..."

# ch/harems/home/events/home_harem_samantha.rpy:564
translate russian ask_bree_about_sam_2b990338:
    bree.say "О, ничего страшного."

# ch/harems/home/events/home_harem_samantha.rpy:565
translate russian ask_bree_about_sam_762da7d2:
    mike.say "Т... ты серьёзно?!"

# ch/harems/home/events/home_harem_samantha.rpy:566
translate russian ask_bree_about_sam_08e795b1:
    "[lssb_homesam.bree_name()] закатывает глаза, будто я только что сказал настоящую глупость."

# ch/harems/home/events/home_harem_samantha.rpy:567
translate russian ask_bree_about_sam_e891bdee:
    bree.say "Раньше я, возможно, разозлилась бы."

# ch/harems/home/events/home_harem_samantha.rpy:568
translate russian ask_bree_about_sam_1b1a1cef:
    bree.say "Но скажем так: то, чем мы занимаемся вместе, немного расширило мои взгляды!"

# ch/harems/home/events/home_harem_samantha.rpy:569
translate russian ask_bree_about_sam_24e264d9:
    "Я уже собираюсь выразить своё огромное облегчение."

# ch/harems/home/events/home_harem_samantha.rpy:571
translate russian ask_bree_about_sam_1fca2d8e:
    "Но замечаю, как [lssb_homesam.bree_name()] вдруг меняется в лице."

# ch/harems/home/events/home_harem_samantha.rpy:573
translate russian ask_bree_about_sam_2521c274:
    "Она заговорщически наклоняется ко мне, будто боится, что нас подслушают."

# ch/harems/home/events/home_harem_samantha.rpy:574
translate russian ask_bree_about_sam_7f4cbb57:
    bree.say "Погоди, это не её ты всё время зовёшь Кексиком?"

# ch/harems/home/events/home_harem_samantha.rpy:575
translate russian ask_bree_about_sam_ce58fc94:
    mike.say "Э-э, да, я её так прозвал."

# ch/harems/home/events/home_harem_samantha.rpy:576
translate russian ask_bree_about_sam_d4a31fb8:
    mike.say "Потому что она такая сладкая и вкусная..."

# ch/harems/home/events/home_harem_samantha.rpy:577
translate russian ask_bree_about_sam_78426369:
    "Мне кажется или [lssb_homesam.bree_name()] начинает вести себя как-то... скрытно?"

# ch/harems/home/events/home_harem_samantha.rpy:579
translate russian ask_bree_about_sam_0a5009a0:
    "Она всё поглядывает по сторонам, словно смущена."

# ch/harems/home/events/home_harem_samantha.rpy:580
translate russian ask_bree_about_sam_1d6a777b:
    "И, могу поклясться, её руки тоже тянутся к тому, что между бёдер!"

# ch/harems/home/events/home_harem_samantha.rpy:581
translate russian ask_bree_about_sam_6815a611:
    bree.say "[lssb_common.hero_name()]..."

# ch/harems/home/events/home_harem_samantha.rpy:582
translate russian ask_bree_about_sam_0cdf8983:
    bree.say "Какая... какая она?"

# ch/harems/home/events/home_harem_samantha.rpy:584
translate russian ask_bree_about_sam_17b85339:
    bree.say "Ну, какая она в постели?"

# ch/harems/home/events/home_harem_samantha.rpy:586
translate russian ask_bree_about_sam_31f1d4fc:
    "[lssb_homesam.bree_name()] и правда выспрашивает подробности моих любовных побед."

# ch/harems/home/events/home_harem_samantha.rpy:587
translate russian ask_bree_about_sam_2e99ead0:
    "Причём тех, которые происходили за её спиной!"

# ch/harems/home/events/home_harem_samantha.rpy:588
translate russian ask_bree_about_sam_0d9e750c:
    "Почти неосознанно я хватаюсь за эту возможность."

# ch/harems/home/events/home_harem_samantha.rpy:589
translate russian ask_bree_about_sam_df639c47:
    mike.say "А что, если я не просто расскажу?"

# ch/harems/home/events/home_harem_samantha.rpy:590
translate russian ask_bree_about_sam_07f91148:
    mike.say "А покажу?"

# ch/harems/home/events/home_harem_samantha.rpy:592
translate russian ask_bree_about_sam_1a8c24cd:
    bree.say "Покажешь?"

# ch/harems/home/events/home_harem_samantha.rpy:594
translate russian ask_bree_about_sam_3d71da9b:
    bree.say "Но как?"

# ch/harems/home/events/home_harem_samantha.rpy:595
translate russian ask_bree_about_sam_79cc5fc9:
    mike.say "Может, позволим Сэм присоединиться к тому, что у нас происходит дома?"

# ch/harems/home/events/home_harem_samantha.rpy:596
translate russian ask_bree_about_sam_967440cc:
    mike.say "Тогда все смогут как следует повеселиться, верно?"

# ch/harems/home/events/home_harem_samantha.rpy:598
translate russian ask_bree_about_sam_6319d01e:
    bree.say "Д... думаешь, мы сможем?"

# ch/harems/home/events/home_harem_samantha.rpy:599
translate russian ask_bree_about_sam_8007aa12:
    "Вот и всё, она заглотила наживку."

# ch/harems/home/events/home_harem_samantha.rpy:600
translate russian ask_bree_about_sam_2708817a:
    "Остаётся лишь подсечь!"

# ch/harems/home/events/home_harem_samantha.rpy:601
translate russian ask_bree_about_sam_d2375fc8:
    mike.say "Ну, я был бы не против, и уверен, что Сэм можно убедить."

# ch/harems/home/events/home_harem_samantha.rpy:602
translate russian ask_bree_about_sam_6eb7da92:
    mike.say "Нужно лишь сначала поговорить со всеми и заручиться их согласием."

# ch/harems/home/events/home_harem_samantha.rpy:603
translate russian ask_bree_about_sam_aa7eeb10:
    mike.say "Но не волнуйся, это я беру на себя."

# ch/harems/home/events/home_harem_samantha.rpy:604
translate russian ask_bree_about_sam_14e18397:
    "[lssb_homesam.bree_name()] радостно кивает и даже целует меня в щёку."

# ch/harems/home/events/home_harem_samantha.rpy:605
translate russian ask_bree_about_sam_0f65bfb8:
    "Приятно знать, что она поддерживает эту идею."

# ch/harems/home/events/home_harem_samantha.rpy:606
translate russian ask_bree_about_sam_d0ce4bb0:
    "И что для этого понадобилось лишь немного подтолкнуть её в нужную сторону..."

# ch/harems/home/events/home_harem_samantha.rpy:611
translate russian ask_sasha_about_sam_64cffe18:
    "Можно подумать, парень в моём довольно необычном положении уже готов остановиться на достигнутом."

# ch/harems/home/events/home_harem_samantha.rpy:612
translate russian ask_sasha_about_sam_dbcf3a14:
    "Ведь сейчас у меня отношения с очень горячими соседками."

# ch/harems/home/events/home_harem_samantha.rpy:613
translate russian ask_sasha_about_sam_7ed3bcf1:
    "Как будто этого мало, я ещё и сумел завоевать сердце Сэм."

# ch/harems/home/events/home_harem_samantha.rpy:614
translate russian ask_sasha_about_sam_41aef65e:
    "А она особенная — та, которую я считал упущенной."

# ch/harems/home/events/home_harem_samantha.rpy:615
translate russian ask_sasha_about_sam_47d169bd:
    "Даже когда она узнала о других девушках и мне показалось, что я всё испортил, отношения не закончились."

# ch/harems/home/events/home_harem_samantha.rpy:616
translate russian ask_sasha_about_sam_d01d72c0:
    "Вы вообще можете в это поверить?"

# ch/harems/home/events/home_harem_samantha.rpy:617
translate russian ask_sasha_about_sam_a4b287f9:
    "Я признался, что сплю с другими женщинами, а она сказала, что её это устраивает!"

# ch/harems/home/events/home_harem_samantha.rpy:618
translate russian ask_sasha_about_sam_b79a9230:
    "Но, может, я просто перфекционист. Или какой-нибудь мазохист."

# ch/harems/home/events/home_harem_samantha.rpy:619
translate russian ask_sasha_about_sam_ab4c8bb5:
    "Потому что придумал, как сделать всё ещё лучше."

# ch/harems/home/events/home_harem_samantha.rpy:620
translate russian ask_sasha_about_sam_ae863975:
    "Что, если Сэм присоединится к нашим домашним развлечениям?"

# ch/harems/home/events/home_harem_samantha.rpy:621
translate russian ask_sasha_about_sam_c9f4b041:
    "Что, если она станет частью моих отношений с соседками?"

# ch/harems/home/events/home_harem_samantha.rpy:622
translate russian ask_sasha_about_sam_46071816:
    "Поверьте, я понимаю, что это будет нелегко."

# ch/harems/home/events/home_harem_samantha.rpy:623
translate russian ask_sasha_about_sam_66e21d5a:
    "В моём плане участвует немало своеобразных личностей."

# ch/harems/home/events/home_harem_samantha.rpy:624
translate russian ask_sasha_about_sam_ecb67b67:
    "И самая своеобразная из них, пожалуй, Саша."

# ch/harems/home/events/home_harem_samantha.rpy:626
translate russian ask_sasha_about_sam_8b9e9439:
    "Поэтому я порядком нервничаю, когда удаётся застать её наедине и заговорить об этом."

# ch/harems/home/events/home_harem_samantha.rpy:627
translate russian ask_sasha_about_sam_bd692dd8:
    "Я знаю, что среди моих соседок Саша самая прямолинейная и убеждённая феминистка."

# ch/harems/home/events/home_harem_samantha.rpy:628
translate russian ask_sasha_about_sam_e650f1f3:
    "Поэтому она может возразить, что я эксплуатирую женщин."

# ch/harems/home/events/home_harem_samantha.rpy:629
translate russian ask_sasha_about_sam_063bdd2d:
    "Не говоря уже о ярости от новости, что я трахался с другими!"

# ch/harems/home/events/home_harem_samantha.rpy:630
translate russian ask_sasha_about_sam_6d535e7e:
    mike.say "Привет, Саша."

# ch/harems/home/events/home_harem_samantha.rpy:631
translate russian ask_sasha_about_sam_80926fb7:
    mike.say "Как дела?"

# ch/harems/home/events/home_harem_samantha.rpy:632
translate russian ask_sasha_about_sam_624d42be:
    "Саша дарит мне одну из своих знакомых улыбок."

# ch/harems/home/events/home_harem_samantha.rpy:633
translate russian ask_sasha_about_sam_51a85026:
    "В них поровну искреннего тепла и затаённого озорства."

# ch/harems/home/events/home_harem_samantha.rpy:634
translate russian ask_sasha_about_sam_b676abaf:
    sasha.say "Привет, жеребец!"

# ch/harems/home/events/home_harem_samantha.rpy:635
translate russian ask_sasha_about_sam_4eb3be58:
    sasha.say "Не жалуюсь."

# ch/harems/home/events/home_harem_samantha.rpy:636
translate russian ask_sasha_about_sam_842b7238:
    sasha.say "А ты?"

# ch/harems/home/events/home_harem_samantha.rpy:638
translate russian ask_sasha_about_sam_03391c87:
    sasha.say "Как справляешься в роли единственного члена в нашей компании?"

# ch/harems/home/events/home_harem_samantha.rpy:639
translate russian ask_sasha_about_sam_9be745be:
    "Я старательно смеюсь над её шуткой."

# ch/harems/home/events/home_harem_samantha.rpy:640
translate russian ask_sasha_about_sam_765d7e34:
    "Но всё равно боюсь, что смех звучит слишком натянуто."

# ch/harems/home/events/home_harem_samantha.rpy:641
translate russian ask_sasha_about_sam_53254f4f:
    mike.say "Ха... да..."

# ch/harems/home/events/home_harem_samantha.rpy:642
translate russian ask_sasha_about_sam_accc0aec:
    mike.say "Что сказать? Тяжело, но приятно!"

# ch/harems/home/events/home_harem_samantha.rpy:643
translate russian ask_sasha_about_sam_79628015:
    mike.say "Вообще-то, Саша... Я как раз хотел об этом поговорить."

# ch/harems/home/events/home_harem_samantha.rpy:645
translate russian ask_sasha_about_sam_e276a1df:
    "Саша слегка хмурится и склоняет голову набок."

# ch/harems/home/events/home_harem_samantha.rpy:646
translate russian ask_sasha_about_sam_9910cc73:
    sasha.say "Серьёзно, [lssb_common.hero_name()]?"

# ch/harems/home/events/home_harem_samantha.rpy:647
translate russian ask_sasha_about_sam_16c4f16c:
    sasha.say "Тогда разве не стоит позвать всех?"

# ch/harems/home/events/home_harem_samantha.rpy:648
translate russian ask_sasha_about_sam_fc7ad817:
    mike.say "Нет, не думаю, Саша."

# ch/harems/home/events/home_harem_samantha.rpy:649
translate russian ask_sasha_about_sam_1860d8c3:
    mike.say "Такое я хочу обсуждать с каждой наедине, понимаешь?"

# ch/harems/home/events/home_harem_samantha.rpy:650
translate russian ask_sasha_about_sam_55f9f71a:
    sasha.say "Хорошо, [lssb_common.hero_name()]."

# ch/harems/home/events/home_harem_samantha.rpy:651
translate russian ask_sasha_about_sam_eb07bbf1:
    sasha.say "Но должна сказать: ты начинаешь меня пугать!"

# ch/harems/home/events/home_harem_samantha.rpy:652
translate russian ask_sasha_about_sam_ca1504df:
    "Я вижу, что она говорит правду."

# ch/harems/home/events/home_harem_samantha.rpy:653
translate russian ask_sasha_about_sam_e1a148f3:
    "И понимаю, что сейчас могу всё испортить."

# ch/harems/home/events/home_harem_samantha.rpy:654
translate russian ask_sasha_about_sam_9b6e2672:
    "Но я уже решился, отступать некуда."

# ch/harems/home/events/home_harem_samantha.rpy:655
translate russian ask_sasha_about_sam_64805e73:
    mike.say "Дело в том, Саша..."

# ch/harems/home/events/home_harem_samantha.rpy:656
translate russian ask_sasha_about_sam_018658a2:
    mike.say "Ты помнишь Сэм?"

# ch/harems/home/events/home_harem_samantha.rpy:657
translate russian ask_sasha_about_sam_cf05f9bd:
    sasha.say "Да, помню. Она жила здесь до того, как въехали я и [lssb_homesam.bree_name()]."

# ch/harems/home/events/home_harem_samantha.rpy:658
translate russian ask_sasha_about_sam_2019e408:
    mike.say "Верно."

# ch/harems/home/events/home_harem_samantha.rpy:659
translate russian ask_sasha_about_sam_7f1fa0b6:
    mike.say "Ну, после этого мы поддерживали связь, просто как друзья."

# ch/harems/home/events/home_harem_samantha.rpy:661
translate russian ask_sasha_about_sam_31d9ee3d:
    sasha.say "Но дай угадаю: тебе хотелось большего?"

# ch/harems/home/events/home_harem_samantha.rpy:663
translate russian ask_sasha_about_sam_231e5e33:
    mike.say "Как ты узнала?"

# ch/harems/home/events/home_harem_samantha.rpy:665
translate russian ask_sasha_about_sam_b0aaa3be:
    sasha.say "Это довольно банальная история, [lssb_common.hero_name()]."

# ch/harems/home/events/home_harem_samantha.rpy:666
translate russian ask_sasha_about_sam_563755dc:
    sasha.say "Почти любая девушка может заметить такое в парне."

# ch/harems/home/events/home_harem_samantha.rpy:667
translate russian ask_sasha_about_sam_8bbbdd34:
    sasha.say "Ирония в том, что обычно не замечает лишь та, в которую он влюблён!"

# ch/harems/home/events/home_harem_samantha.rpy:668
translate russian ask_sasha_about_sam_791f13e5:
    mike.say "Неважно..."

# ch/harems/home/events/home_harem_samantha.rpy:669
translate russian ask_sasha_about_sam_530c6c6d:
    mike.say "В общем, она рассталась с мужем."

# ch/harems/home/events/home_harem_samantha.rpy:670
translate russian ask_sasha_about_sam_7081f377:
    mike.say "Он изменял ей, и ей нужен был друг, на которого можно опереться."

# ch/harems/home/events/home_harem_samantha.rpy:671
translate russian ask_sasha_about_sam_77d0f8c1:
    "Услышав это, Саша слегка откидывается назад и прищуривается."

# ch/harems/home/events/home_harem_samantha.rpy:672
translate russian ask_sasha_about_sam_a54ac8c7:
    "Несколько мгновений она изучает меня."

# ch/harems/home/events/home_harem_samantha.rpy:673
translate russian ask_sasha_about_sam_0ed1b15f:
    "Словно взвешивает и то, что я сказал, и то, о чём умолчал."

# ch/harems/home/events/home_harem_samantha.rpy:674
translate russian ask_sasha_about_sam_4e3d53b2:
    sasha.say "Да, но это ведь ещё не всё?"

# ch/harems/home/events/home_harem_samantha.rpy:676
translate russian ask_sasha_about_sam_5750ff63:
    sasha.say "Дай угадаю: она хотела отомстить этому типу?"

# ch/harems/home/events/home_harem_samantha.rpy:678
translate russian ask_sasha_about_sam_72836020:
    sasha.say "А ты как раз оказался рядом, всё ещё питая к ней нежные чувства?"

# ch/harems/home/events/home_harem_samantha.rpy:679
translate russian ask_sasha_about_sam_01b4ae54:
    "Я чувствую, как краснеют щёки: Саша загнала меня в угол."

# ch/harems/home/events/home_harem_samantha.rpy:680
translate russian ask_sasha_about_sam_1fef855a:
    "Как ей удаётся так легко меня раскусить?"

# ch/harems/home/events/home_harem_samantha.rpy:681
translate russian ask_sasha_about_sam_f65ccaea:
    "Неужели меня и правда так просто прочитать?"

# ch/harems/home/events/home_harem_samantha.rpy:682
translate russian ask_sasha_about_sam_cbfe4dd3:
    mike.say "Я... я спал с ней, Саша."

# ch/harems/home/events/home_harem_samantha.rpy:683
translate russian ask_sasha_about_sam_0247eaf2:
    mike.say "Прости."

# ch/harems/home/events/home_harem_samantha.rpy:685
translate russian ask_sasha_about_sam_1d7ae025:
    "И тут Саша удивляет меня: её улыбка становится прямо-таки хищной."

# ch/harems/home/events/home_harem_samantha.rpy:686
translate russian ask_sasha_about_sam_8a92c274:
    sasha.say "Ого!"

# ch/harems/home/events/home_harem_samantha.rpy:688
translate russian ask_sasha_about_sam_9c10aac2:
    sasha.say "Ах ты кобель!"

# ch/harems/home/events/home_harem_samantha.rpy:689
translate russian ask_sasha_about_sam_082da6be:
    mike.say "Т... ты не выглядишь особенно расстроенной, Саша."

# ch/harems/home/events/home_harem_samantha.rpy:690
translate russian ask_sasha_about_sam_15bf65ef:
    mike.say "Разве ты не злишься, что я сплю с другими?"

# ch/harems/home/events/home_harem_samantha.rpy:692
translate russian ask_sasha_about_sam_16d65901:
    sasha.say "Раньше, возможно, и разозлилась бы."

# ch/harems/home/events/home_harem_samantha.rpy:693
translate russian ask_sasha_about_sam_5933f9bf:
    sasha.say "Ну, до того, как мы стали вовлекать других людей в нашу личную жизнь."

# ch/harems/home/events/home_harem_samantha.rpy:694
translate russian ask_sasha_about_sam_438369ea:
    sasha.say "Но теперь я воспринимаю секс совсем не так, как раньше."

# ch/harems/home/events/home_harem_samantha.rpy:695
translate russian ask_sasha_about_sam_3fd113d3:
    sasha.say "Наверное, это научило меня отделять любовь от самого секса."

# ch/harems/home/events/home_harem_samantha.rpy:697
translate russian ask_sasha_about_sam_d6e545f4:
    sasha.say "То, что ты трахаешься с кем-то ещё, не значит, что любишь меня меньше."

# ch/harems/home/events/home_harem_samantha.rpy:698
translate russian ask_sasha_about_sam_3037461f:
    sasha.say "И вообще, ты ведь не принуждал эту Сэм?"

# ch/harems/home/events/home_harem_samantha.rpy:699
translate russian ask_sasha_about_sam_4b470ec9:
    mike.say "Нет... конечно нет!"

# ch/harems/home/events/home_harem_samantha.rpy:702
translate russian ask_sasha_about_sam_0d4c51a8:
    sasha.say "И ты ещё помог ей насолить её паршивому мужу."

# ch/harems/home/events/home_harem_samantha.rpy:703
translate russian ask_sasha_about_sam_8cb002a7:
    sasha.say "Вообще-то она кажется вполне здравомыслящей девушкой!"

# ch/harems/home/events/home_harem_samantha.rpy:704
translate russian ask_sasha_about_sam_c61eef1e:
    "Как бы ни удивила меня реакция Саши, удачную возможность я всё же распознаю."

# ch/harems/home/events/home_harem_samantha.rpy:706
translate russian ask_sasha_about_sam_c1a9ff47:
    sasha.say "Честно говоря, она в моём вкусе."

# ch/harems/home/events/home_harem_samantha.rpy:707
translate russian ask_sasha_about_sam_d5bd7cd4:
    mike.say "Правда?"

# ch/harems/home/events/home_harem_samantha.rpy:708
translate russian ask_sasha_about_sam_4f586231:
    mike.say "Думаешь, Сэм в твоём вкусе?"

# ch/harems/home/events/home_harem_samantha.rpy:709
translate russian ask_sasha_about_sam_65c40c5d:
    "Саша кивает, начиная понимать, что я к чему-то веду."

# ch/harems/home/events/home_harem_samantha.rpy:710
translate russian ask_sasha_about_sam_2779d206:
    mike.say "Тогда как насчёт того, чтобы её пригласить?"

# ch/harems/home/events/home_harem_samantha.rpy:711
translate russian ask_sasha_about_sam_00a5bd2b:
    mike.say "Я подумал: она могла бы вписаться в то, что происходит у нас дома."

# ch/harems/home/events/home_harem_samantha.rpy:712
translate russian ask_sasha_about_sam_5b9e9a0e:
    "Кажется, Саша вот-вот согласится."

# ch/harems/home/events/home_harem_samantha.rpy:713
translate russian ask_sasha_about_sam_78ef54cd:
    "Но затем задумывается."

# ch/harems/home/events/home_harem_samantha.rpy:715
translate russian ask_sasha_about_sam_104ff019:
    sasha.say "Мы не можем решать это вдвоём."

# ch/harems/home/events/home_harem_samantha.rpy:716
translate russian ask_sasha_about_sam_0f818458:
    sasha.say "Каждая должна высказаться."

# ch/harems/home/events/home_harem_samantha.rpy:717
translate russian ask_sasha_about_sam_68faded7:
    "Я киваю, уже отмечая для себя, что Саша условно согласна."

# ch/harems/home/events/home_harem_samantha.rpy:718
translate russian ask_sasha_about_sam_1d662c3f:
    mike.say "Конечно, Саша."

# ch/harems/home/events/home_harem_samantha.rpy:719
translate russian ask_sasha_about_sam_7070e552:
    mike.say "Но, думаю, мы друг друга понимаем, да?"

# ch/harems/home/events/home_harem_samantha.rpy:721
translate russian ask_sasha_about_sam_b747a860:
    "Саша кивает, и у меня словно гора с плеч."

# ch/harems/home/events/home_harem_samantha.rpy:722
translate russian ask_sasha_about_sam_457c2297:
    "Ещё на шаг ближе к тому, чтобы Сэм вошла в наш дом!"

# ch/harems/home/events/home_harem_samantha.rpy:727
translate russian ask_minami_about_sam_877487d6:
    "Пусть Сэм и не против моих встреч с другими девушками, это решает лишь половину проблемы."

# ch/harems/home/events/home_harem_samantha.rpy:728
translate russian ask_minami_about_sam_30e2d683:
    "Нужно ещё, чтобы [lssb_homesam.bree_name()], Саша и Минами согласились, что мои встречи с Сэм — это нормально!"

# ch/harems/home/events/home_harem_samantha.rpy:729
translate russian ask_minami_about_sam_9c9bfa61:
    "Поэтому мне и нужно включить её в отношения, которые сейчас сложились под нашей крышей."

# ch/harems/home/events/home_harem_samantha.rpy:730
translate russian ask_minami_about_sam_e410b235:
    "Ведь для ещё одной наверняка найдётся место?"

# ch/harems/home/events/home_harem_samantha.rpy:731
translate russian ask_minami_about_sam_096b6ead:
    "Кажется, лучше разделять и властвовать, чем браться за всех сразу."

# ch/harems/home/events/home_harem_samantha.rpy:732
translate russian ask_minami_about_sam_a7a62301:
    "Так я смогу сосредоточиться на каждой по отдельности и не дам им объединиться против меня."

# ch/harems/home/events/home_harem_samantha.rpy:733
translate russian ask_minami_about_sam_0f844235:
    "И Минами кажется одной из тех, с кем проще всего договориться."

# ch/harems/home/events/home_harem_samantha.rpy:734
translate russian ask_minami_about_sam_b2ff0dd4:
    "Ведь она самая младшая и бунтарская из троих."

# ch/harems/home/events/home_harem_samantha.rpy:735
translate russian ask_minami_about_sam_bef8ecaf:
    "Разве после переезда сюда она уже не показала, что любит всякое безумие?"

# ch/harems/home/events/home_harem_samantha.rpy:736
translate russian ask_minami_about_sam_458a2cd5:
    "Во-первых, она встречается со мной, своим приёмным братом."

# ch/harems/home/events/home_harem_samantha.rpy:737
translate russian ask_minami_about_sam_13a49ff8:
    "А во-вторых, захотела лечь в постель со мной и двумя моими соседками!"

# ch/harems/home/events/home_harem_samantha.rpy:738
translate russian ask_minami_about_sam_15925654:
    "Так что изменит ещё один человек?"

# ch/harems/home/events/home_harem_samantha.rpy:740
translate russian ask_minami_about_sam_9643b924:
    "Но, найдя Минами и затронув эту тему, я изо всех сил надеюсь, что прав!"

# ch/harems/home/events/home_harem_samantha.rpy:741
translate russian ask_minami_about_sam_fd30b6a4:
    mike.say "Привет, Минами."

# ch/harems/home/events/home_harem_samantha.rpy:743
translate russian ask_minami_about_sam_01f73928:
    minami.say "Привет, братик."

# ch/harems/home/events/home_harem_samantha.rpy:745
translate russian ask_minami_about_sam_06f628c4:
    minami.say "Что с тобой?"

# ch/harems/home/events/home_harem_samantha.rpy:746
translate russian ask_minami_about_sam_d43070d1:
    mike.say "Э-э... н... ничего, Минами..."

# ch/harems/home/events/home_harem_samantha.rpy:747
translate russian ask_minami_about_sam_3965f71b:
    mike.say "Ничего особенного, просто хотел поговорить!"

# ch/harems/home/events/home_harem_samantha.rpy:749
translate russian ask_minami_about_sam_627aff62:
    minami.say "Ага, ага, как скажешь!"

# ch/harems/home/events/home_harem_samantha.rpy:750
translate russian ask_minami_about_sam_7f12a386:
    minami.say "Я знаю, когда тебе что-то нужно, братик."

# ch/harems/home/events/home_harem_samantha.rpy:751
translate russian ask_minami_about_sam_ed9a1478:
    minami.say "Ты сразу начинаешь хитрить."

# ch/harems/home/events/home_harem_samantha.rpy:752
translate russian ask_minami_about_sam_1931dc86:
    minami.say "И ещё пытаешься скрыть это за невинным видом!"

# ch/harems/home/events/home_harem_samantha.rpy:753
translate russian ask_minami_about_sam_52127118:
    "Понимая, что меня раскусили, я поднимаю руки в знак капитуляции."

# ch/harems/home/events/home_harem_samantha.rpy:754
translate russian ask_minami_about_sam_a83a4f36:
    mike.say "Ладно, Минами, ладно."

# ch/harems/home/events/home_harem_samantha.rpy:755
translate russian ask_minami_about_sam_7ff24b5e:
    mike.say "Ты меня поймала."

# ch/harems/home/events/home_harem_samantha.rpy:756
translate russian ask_minami_about_sam_81952218:
    mike.say "Мне и правда кое-что нужно."

# ch/harems/home/events/home_harem_samantha.rpy:758
translate russian ask_minami_about_sam_78816949:
    "Минами улыбается, словно довольная кошка."

# ch/harems/home/events/home_harem_samantha.rpy:759
translate russian ask_minami_about_sam_718432b0:
    "И её улыбка напоминает мне, как она сексуальна, когда торжествует."

# ch/harems/home/events/home_harem_samantha.rpy:760
translate russian ask_minami_about_sam_8657abef:
    minami.say "Да! Я так и ЗНАЛА!"

# ch/harems/home/events/home_harem_samantha.rpy:761
translate russian ask_minami_about_sam_412816b0:
    minami.say "И что на этот раз?"

# ch/harems/home/events/home_harem_samantha.rpy:763
translate russian ask_minami_about_sam_23c6575f:
    minami.say "Надеюсь, что-нибудь очень непристойное!"

# ch/harems/home/events/home_harem_samantha.rpy:764
translate russian ask_minami_about_sam_c8607fba:
    "Я киваю и глубоко вдыхаю, готовясь выложить всё начистоту."

# ch/harems/home/events/home_harem_samantha.rpy:765
translate russian ask_minami_about_sam_098ca1e1:
    mike.say "Я когда-нибудь рассказывал тебе о Сэм?"

# ch/harems/home/events/home_harem_samantha.rpy:766
translate russian ask_minami_about_sam_db82c9c3:
    mike.say "Она жила здесь до того, как въехали [lssb_homesam.bree_name()] и Саша."

# ch/harems/home/events/home_harem_samantha.rpy:768
translate russian ask_minami_about_sam_5ee8dcf9:
    "Минами морщит нос, пытаясь вспомнить лицо по имени."

# ch/harems/home/events/home_harem_samantha.rpy:769
translate russian ask_minami_about_sam_a062a356:
    "Но затем качает головой и пожимает плечами."

# ch/harems/home/events/home_harem_samantha.rpy:770
translate russian ask_minami_about_sam_89235c1c:
    minami.say "Кажется, пару раз ты упоминал её имя."

# ch/harems/home/events/home_harem_samantha.rpy:771
translate russian ask_minami_about_sam_62655d10:
    minami.say "Но я, наверное, тогда не слушала."

# ch/harems/home/events/home_harem_samantha.rpy:772
translate russian ask_minami_about_sam_bc47418b:
    mike.say "Ну, дело в том, что я уже некоторое время с ней встречаюсь."

# ch/harems/home/events/home_harem_samantha.rpy:773
translate russian ask_minami_about_sam_a82b17a1:
    "Проходит несколько секунд, прежде чем до неё доходит смысл моих слов."

# ch/harems/home/events/home_harem_samantha.rpy:774
translate russian ask_minami_about_sam_f6831c10:
    "Затем глаза Минами расширяются, и она потрясённо ахает."

# ch/harems/home/events/home_harem_samantha.rpy:775
translate russian ask_minami_about_sam_9e680d55:
    minami.say "Ох, братик..."

# ch/harems/home/events/home_harem_samantha.rpy:776
translate russian ask_minami_about_sam_a8f55d0e:
    "Я невольно морщусь, ожидая, что она расплачется и начнёт колотить меня кулаками."

# ch/harems/home/events/home_harem_samantha.rpy:779
translate russian ask_minami_about_sam_5b84d888:
    minami.say "Ну ты и ЖЕРЕБЕЦ!"

# ch/harems/home/events/home_harem_samantha.rpy:780
translate russian ask_minami_about_sam_a435055d:
    minami.say "Есть вообще девушка, которую ты не можешь заполучить?!"

# ch/harems/home/events/home_harem_samantha.rpy:781
translate russian ask_minami_about_sam_157e3f42:
    "При виде выражения её глаз мне хочется выдохнуть с облегчением."

# ch/harems/home/events/home_harem_samantha.rpy:782
translate russian ask_minami_about_sam_d9fdff50:
    "Как я и надеялся, мысль о моих связях на стороне, кажется, её радует."

# ch/harems/home/events/home_harem_samantha.rpy:783
translate russian ask_minami_about_sam_e4db705d:
    "И по её движениям я понимаю, что это даже начинает её возбуждать!"

# ch/harems/home/events/home_harem_samantha.rpy:785
translate russian ask_minami_about_sam_c6bfb3a2:
    mike.say "Ох... ну..."

# ch/harems/home/events/home_harem_samantha.rpy:786
translate russian ask_minami_about_sam_f19b325a:
    mike.say "На самом деле всё не совсем так..."

# ch/harems/home/events/home_harem_samantha.rpy:787
translate russian ask_minami_about_sam_f1bf2e09:
    mike.say "Она была замужем за придурком по имени Райан, а я поддержал её!"

# ch/harems/home/events/home_harem_samantha.rpy:790
translate russian ask_minami_about_sam_5b8e1d23:
    minami.say "Ты переспал с замужней женщиной?!"

# ch/harems/home/events/home_harem_samantha.rpy:791
translate russian ask_minami_about_sam_b9ac7dc3:
    minami.say "О-о... Так это ещё круче!"

# ch/harems/home/events/home_harem_samantha.rpy:794
translate russian ask_minami_about_sam_9a72d647:
    mike.say "Дело в том, Минами..."

# ch/harems/home/events/home_harem_samantha.rpy:795
translate russian ask_minami_about_sam_5f1295bb:
    mike.say "Я хочу, чтобы Сэм присоединилась к нам, понимаешь?"

# ch/harems/home/events/home_harem_samantha.rpy:796
translate russian ask_minami_about_sam_70bfcc6b:
    mike.say "Чтобы [lssb_homesam.bree_name()] и Саша тоже приняли её в наши отношения."

# ch/harems/home/events/home_harem_samantha.rpy:798
translate russian ask_minami_about_sam_06711b4e:
    minami.say "Это было бы здорово, братик!"

# ch/harems/home/events/home_harem_samantha.rpy:799
translate russian ask_minami_about_sam_1c3d70b5:
    minami.say "Словно ты поймал её и принёс к нам домой."

# ch/harems/home/events/home_harem_samantha.rpy:800
translate russian ask_minami_about_sam_988f3301:
    minami.say "Будто она твой трофей или что-то такое!"

# ch/harems/home/events/home_harem_samantha.rpy:801
translate russian ask_minami_about_sam_e3a2c2b5:
    "Я киваю, с облегчением слыша, как Минами рада перспективе принять Сэм в нашу четвёрку."

# ch/harems/home/events/home_harem_samantha.rpy:802
translate russian ask_minami_about_sam_69460d3c:
    mike.say "Хорошо, мне осталось поговорить с остальными."

# ch/harems/home/events/home_harem_samantha.rpy:803
translate russian ask_minami_about_sam_4f80a20e:
    mike.say "Надеюсь, они тоже будут не против."

# ch/harems/home/events/home_harem_samantha.rpy:804
translate russian ask_minami_about_sam_c64a6d67:
    "Теперь кивает Минами, словно согласие остальных — простая формальность."

# ch/harems/home/events/home_harem_samantha.rpy:805
translate russian ask_minami_about_sam_9091ab40:
    "А мне бы её уверенность, что всё именно так и будет..."

# ch/harems/home/events/home_harem_samantha.rpy:810
translate russian introduce_sam_to_girls_f78c949a:
    "Итак, все мои соседки знают о ситуации с Сэм и хотят, чтобы она к нам присоединилась."

# ch/harems/home/events/home_harem_samantha.rpy:811
translate russian introduce_sam_to_girls_d05058b9:
    "Значит, можно переходить к следующему этапу операции."

# ch/harems/home/events/home_harem_samantha.rpy:812
translate russian introduce_sam_to_girls_66e9dcad:
    "Но как сказать Сэм, что я сплю со всеми ними?"

# ch/harems/home/events/home_harem_samantha.rpy:813
translate russian introduce_sam_to_girls_055e75c3:
    "И, что ещё сложнее, как предложить ей тоже присоединиться?"

# ch/harems/home/events/home_harem_samantha.rpy:814
translate russian introduce_sam_to_girls_710f54df:
    "Можете назвать меня человеком без воображения, но лучшее, что я придумал, — просто всё ей рассказать."

# ch/harems/home/events/home_harem_samantha.rpy:816
translate russian introduce_sam_to_girls_25ba6b8c:
    "Поэтому я звоню ей, изображаю невинность и надеюсь на лучшее..."

# ch/harems/home/events/home_harem_samantha.rpy:818
translate russian introduce_sam_to_girls_e3d69131:
    samantha.say "Привет, [lssb_common.hero_name()]!"

# ch/harems/home/events/home_harem_samantha.rpy:820
translate russian introduce_sam_to_girls_5e76750a:
    mike.say "Привет, Кексик."

# ch/harems/home/events/home_harem_samantha.rpy:822
translate russian introduce_sam_to_girls_0ed80da9:
    mike.say "Привет, Сэм."

# ch/harems/home/events/home_harem_samantha.rpy:823
translate russian introduce_sam_to_girls_82c4929b:
    mike.say "Ты сегодня днём свободна?"

# ch/harems/home/events/home_harem_samantha.rpy:824
translate russian introduce_sam_to_girls_4ce7b60f:
    samantha.say "Э-э, да, вроде бы."

# ch/harems/home/events/home_harem_samantha.rpy:825
translate russian introduce_sam_to_girls_cfcf5d9e:
    samantha.say "Ради тебя я могу отменить любые планы!"

# ch/harems/home/events/home_harem_samantha.rpy:826
translate russian introduce_sam_to_girls_cbdfe6d3:
    samantha.say "Что такое?"

# ch/harems/home/events/home_harem_samantha.rpy:827
translate russian introduce_sam_to_girls_75acbeb5:
    samantha.say "Готовишь мне свидание-сюрприз или что?"

# ch/harems/home/events/home_harem_samantha.rpy:828
translate russian introduce_sam_to_girls_b0a675d7:
    mike.say "А... Только если прийти ко мне и провести время вместе считается свиданием!"

# ch/harems/home/events/home_harem_samantha.rpy:829
translate russian introduce_sam_to_girls_19f72fab:
    samantha.say "О, конечно, [lssb_common.hero_name()]."

# ch/harems/home/events/home_harem_samantha.rpy:830
translate russian introduce_sam_to_girls_b8b8df27:
    samantha.say "Скоро увидимся, ладно?"

# ch/harems/home/events/home_harem_samantha.rpy:832
translate russian introduce_sam_to_girls_8dc30b0f:
    mike.say "Хорошо, Кексик, до встречи."

# ch/harems/home/events/home_harem_samantha.rpy:834
translate russian introduce_sam_to_girls_f4eb6152:
    mike.say "Хорошо, Сэм, до встречи."

# ch/harems/home/events/home_harem_samantha.rpy:835
translate russian introduce_sam_to_girls_c2e90a6e:
    "Лишь закончив разговор, я поднимаю голову и замечаю, что у меня есть зрители."

# ch/harems/home/events/home_harem_samantha.rpy:836
translate russian introduce_sam_to_girls_89731298:
    "Девушки пристально смотрят на меня, выглядывая из-за ближайшего дверного проёма."

# ch/harems/home/events/home_harem_samantha.rpy:838
translate russian introduce_sam_to_girls_041096b4:
    bree.say "Эй, почему ты не рассказал ей о нас?"

# ch/harems/home/events/home_harem_samantha.rpy:841
translate russian introduce_sam_to_girls_53cd47b9:
    minami.say "Ага, братик, в чём дело?"

# ch/harems/home/events/home_harem_samantha.rpy:843
translate russian introduce_sam_to_girls_7f7c122e:
    sasha.say "Ну ты и струсил!"

# ch/harems/home/events/home_harem_samantha.rpy:844
translate russian introduce_sam_to_girls_23bf64cd:
    mike.say "Что... погодите..."

# ch/harems/home/events/home_harem_samantha.rpy:845
translate russian introduce_sam_to_girls_6abe4e68:
    mike.say "Вы давно подслушиваете?!"

# ch/harems/home/events/home_harem_samantha.rpy:847
translate russian introduce_sam_to_girls_126ebd6a:
    bree.say "Достаточно, чтобы понять: тебе нужна наша помощь."

# ch/harems/home/events/home_harem_samantha.rpy:850
translate russian introduce_sam_to_girls_90e60be4:
    minami.say "Поверь, ОЧЕНЬ нужна!"

# ch/harems/home/events/home_harem_samantha.rpy:852
translate russian introduce_sam_to_girls_8da4391f:
    sasha.say "Ни о чём не беспокойся, [lssb_common.hero_name()]."

# ch/harems/home/events/home_harem_samantha.rpy:853
translate russian introduce_sam_to_girls_cc9655d4:
    sasha.say "Мы всё берём на себя!"

# ch/harems/home/events/home_harem_samantha.rpy:858
translate russian introduce_sam_to_girls_487d9abe:
    "С этими словами они исчезают из виду."

# ch/harems/home/events/home_harem_samantha.rpy:859
translate russian introduce_sam_to_girls_5ff15a9a:
    "А я остаюсь стоять, всё ещё сжимая телефон."

# ch/harems/home/events/home_harem_samantha.rpy:860
translate russian introduce_sam_to_girls_67c80c59:
    mike.say "Подождите-ка..."

# ch/harems/home/events/home_harem_samantha.rpy:861
translate russian introduce_sam_to_girls_6b691be8:
    mike.say "И что это, чёрт возьми, вообще значит?!"

# ch/harems/home/events/home_harem_samantha.rpy:862
translate russian introduce_sam_to_girls_fcfa2861:
    "Девушки ничего не отвечают, упорно храня молчание."

# ch/harems/home/events/home_harem_samantha.rpy:863
translate russian introduce_sam_to_girls_f18477a7:
    "Но одно я знаю точно: теперь у меня появился ещё один повод нервничать."

# ch/harems/home/events/home_harem_samantha.rpy:867
translate russian introduce_sam_to_girls_3820145c:
    "Поэтому, когда приходит время открывать дверь Сэм, я уже весь на нервах."

# ch/harems/home/events/home_harem_samantha.rpy:868
translate russian introduce_sam_to_girls_5c516d28:
    "Мало того, что нужно рассказать ей о моих отношениях с несколькими девушками."

# ch/harems/home/events/home_harem_samantha.rpy:869
translate russian introduce_sam_to_girls_54475e2e:
    "Я ещё и понятия не имею, как остальные собираются сообщить ей то же самое!"

# ch/harems/home/events/home_harem_samantha.rpy:870
translate russian introduce_sam_to_girls_b8594f0c:
    "И всё же, открывая входную дверь, я заставляю себя улыбнуться."

# ch/harems/home/events/home_harem_samantha.rpy:876
translate russian introduce_sam_to_girls_f07c91b5:
    samantha.say "Привет, [lssb_common.hero_name()]."

# ch/harems/home/events/home_harem_samantha.rpy:877
translate russian introduce_sam_to_girls_086ea687:
    samantha.say "Я бы приехала раньше, но..."

# ch/harems/home/events/home_harem_samantha.rpy:878
translate russian introduce_sam_to_girls_dde0020f:
    samantha.say "Ну, ты ведь позвал в последний момент и всё такое!"

# ch/harems/home/events/home_harem_samantha.rpy:880
translate russian introduce_sam_to_girls_0fdb6652:
    mike.say "Ничего страшного, Кексик."

# ch/harems/home/events/home_harem_samantha.rpy:882
translate russian introduce_sam_to_girls_d35e110b:
    mike.say "Ничего страшного, Сэм."

# ch/harems/home/events/home_harem_samantha.rpy:884
translate russian introduce_sam_to_girls_ee463250:
    "Впуская Сэм, я изо всех сил стараюсь не выглядеть параноиком."

# ch/harems/home/events/home_harem_samantha.rpy:885
translate russian introduce_sam_to_girls_358e5586:
    "Остальных пока не видно, но бдительности я не теряю."

# ch/harems/home/events/home_harem_samantha.rpy:886
translate russian introduce_sam_to_girls_0298bf2a:
    "Они могут прятаться где угодно и замышлять что угодно!"

# ch/harems/home/events/home_harem_samantha.rpy:890
translate russian introduce_sam_to_girls_0c1ff568:
    "Поэтому я даже удивляюсь, когда захожу в гостиную и нахожу их там."

# ch/harems/home/events/home_harem_samantha.rpy:891
translate russian introduce_sam_to_girls_28785e75:
    "Но самое странное — они ведут себя так, словно ничего не происходит."

# ch/harems/home/events/home_harem_samantha.rpy:892
translate russian introduce_sam_to_girls_f95f7220:
    "[lssb_homesam.bree_name()] играет на Zbox, будто не замечая ничего вокруг."

# ch/harems/home/events/home_harem_samantha.rpy:893
translate russian introduce_sam_to_girls_abaa788f:
    "Саша сидит на диване, погрузившись в книгу у себя на коленях."

# ch/harems/home/events/home_harem_samantha.rpy:895
translate russian introduce_sam_to_girls_909b428f:
    "А Минами тихо, как мышка, листает соцсети в телефоне."

# ch/harems/home/events/home_harem_samantha.rpy:896
translate russian introduce_sam_to_girls_8a0afb1c:
    samantha.say "Ох..."

# ch/harems/home/events/home_harem_samantha.rpy:898
translate russian introduce_sam_to_girls_87c41342:
    samantha.say "Я не знала, что твои соседки тоже будут дома!"

# ch/harems/home/events/home_harem_samantha.rpy:899
translate russian introduce_sam_to_girls_fcea70d9:
    samantha.say "Я думала, мы побудем здесь вдвоём."

# ch/harems/home/events/home_harem_samantha.rpy:900
translate russian introduce_sam_to_girls_2ccce9ec:
    "Услышав голос Сэм, остальные бросают свои занятия."

# ch/harems/home/events/home_harem_samantha.rpy:901
translate russian introduce_sam_to_girls_5e9af71a:
    "Они поднимают головы с приветливыми улыбками и лёгким интересом на лицах."

# ch/harems/home/events/home_harem_samantha.rpy:902
translate russian introduce_sam_to_girls_07dd3e4a:
    "От этого я настороженно щурюсь."

# ch/harems/home/events/home_harem_samantha.rpy:903
translate russian introduce_sam_to_girls_921db9b9:
    "Ведь я прекрасно знаю, что они лишь притворяются."

# ch/harems/home/events/home_harem_samantha.rpy:905
translate russian introduce_sam_to_girls_222ff70d:
    mike.say "Всё нормально, Кексик."

# ch/harems/home/events/home_harem_samantha.rpy:907
translate russian introduce_sam_to_girls_24c3dec5:
    mike.say "Всё нормально, Сэм."

# ch/harems/home/events/home_harem_samantha.rpy:909
translate russian introduce_sam_to_girls_3f51212f:
    mike.say "Можем пойти в мою комнату."

# ch/harems/home/events/home_harem_samantha.rpy:910
translate russian introduce_sam_to_girls_0656e587:
    mike.say "Там хотя бы побудем наедине!"

# ch/harems/home/events/home_harem_samantha.rpy:911
translate russian introduce_sam_to_girls_940c27e6:
    "Говоря это, я выразительно смотрю на остальных."

# ch/harems/home/events/home_harem_samantha.rpy:912
translate russian introduce_sam_to_girls_edd5b86b:
    "Но в ответ получаю лишь до раздражения невинные улыбки."

# ch/harems/home/events/home_harem_samantha.rpy:915
translate russian introduce_sam_to_girls_7bf418ce:
    sasha.say "Ха! Удачи!"

# ch/harems/home/events/home_harem_samantha.rpy:919
translate russian introduce_sam_to_girls_e3f4185a:
    minami.say "Ага, стены здесь тонкие, как бумага."

# ch/harems/home/events/home_harem_samantha.rpy:921
translate russian introduce_sam_to_girls_9565d1e8:
    bree.say "Поверь, мы слышим ВСЁ, что [lssb_common.hero_name()] делает в этой комнате!"

# ch/harems/home/events/home_harem_samantha.rpy:922
translate russian introduce_sam_to_girls_311a6617:
    "Сэм весьма удивлена услышанным."

# ch/harems/home/events/home_harem_samantha.rpy:923
