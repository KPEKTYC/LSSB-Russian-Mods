# ch/harems/home/events/home_harem_samantha.rpy:1861
translate russian sexual_tension_sam_minami_5f992c12:
    "Она поднимает глаза на Сэм и улыбается, слегка покраснев."

# ch/harems/home/events/home_harem_samantha.rpy:1863
translate russian sexual_tension_sam_minami_f3137a95:
