# ch/harems/home/events/home_harem_samantha.rpy:1011
translate russian introduce_sam_to_girls_57640ceb:
    samantha.say "Вы те девушки, с которыми [lssb_common.hero_name()] встречается на стороне?"

# ch/harems/home/events/home_harem_samantha.rpy:1013
translate russian introduce_sam_to_girls_f8f54774:
    sasha.say "Ну, это с твоей точки зрения, да?"

# ch/harems/home/events/home_harem_samantha.rpy:1015
translate russian introduce_sam_to_girls_8304b5cd:
    bree.say "С нашей — всё скорее наоборот!"

# ch/harems/home/events/home_harem_samantha.rpy:1018
translate russian introduce_sam_to_girls_e12ff400:
    minami.say "Ага, подруга, это с тобой он встречается на стороне!"

# ch/harems/home/events/home_harem_samantha.rpy:1020
translate russian introduce_sam_to_girls_06eb9397:
    mike.say "Прости, Кексик."

# ch/harems/home/events/home_harem_samantha.rpy:1022
translate russian introduce_sam_to_girls_11ab428b:
    mike.say "Прости, Сэм."

# ch/harems/home/events/home_harem_samantha.rpy:1023
translate russian introduce_sam_to_girls_728ad98c:
    mike.say "Я пытался выбрать момент, чтобы рассказать тебе."

# ch/harems/home/events/home_harem_samantha.rpy:1024
translate russian introduce_sam_to_girls_950f9b02:
    mike.say "Честное слово!"

# ch/harems/home/events/home_harem_samantha.rpy:1025
translate russian introduce_sam_to_girls_cba1c642:
