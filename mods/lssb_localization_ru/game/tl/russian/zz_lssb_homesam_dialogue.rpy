# ch/harems/home/events/home_harem_samantha.rpy:3389
translate russian samantha_sasha_pregnant_showdown_0f7beca6_1:
    sasha.say "Я ни с кем не собираюсь делить мужчину!"

# ch/harems/home/events/home_harem_samantha.rpy:3390
translate russian samantha_sasha_pregnant_showdown_47b33c95_1:
    sasha.say "Держитесь от меня подальше, чёрт вас побери."

# ch/harems/home/events/home_harem_samantha.rpy:3391
translate russian samantha_sasha_pregnant_showdown_e0b93db1_1:
    sasha.say "А лучше вообще больше не попадайтесь мне на глаза!"

# ch/harems/home/events/home_harem_samantha.rpy:3393
translate russian samantha_sasha_pregnant_showdown_6d7a1ad9_1:
    "Я смотрю, как Саша разворачивается и уходит."

# ch/harems/home/events/home_harem_samantha.rpy:3394
