# ch/harems/home/events/home_harem_samantha.rpy:1687
translate russian sexual_tension_sam_sasha_2190667f:
    sasha.say "Ты ведь не настолько наивный?"

# ch/harems/home/events/home_harem_samantha.rpy:1688
translate russian sexual_tension_sam_sasha_0586a534:
    sasha.say "Думаю, мне понравится, что Сэм живёт с нами!"

# ch/harems/home/events/home_harem_samantha.rpy:1690
translate russian sexual_tension_sam_sasha_50d1ef0e:
    "Не успеваю я сказать ещё хоть слово, как Саша разворачивается и тоже уходит."

# ch/harems/home/events/home_harem_samantha.rpy:1691
translate russian sexual_tension_sam_sasha_f2b11a12:
