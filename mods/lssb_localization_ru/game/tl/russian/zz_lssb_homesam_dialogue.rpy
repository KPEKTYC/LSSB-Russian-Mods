# ch/harems/home/events/home_harem_samantha.rpy:1267
translate russian lesbian_sex_bree_sam_cb708170:
    "Знаю, что должен отвести глаз от замочной скважины."

# ch/harems/home/events/home_harem_samantha.rpy:1268
translate russian lesbian_sex_bree_sam_209bacaf:
