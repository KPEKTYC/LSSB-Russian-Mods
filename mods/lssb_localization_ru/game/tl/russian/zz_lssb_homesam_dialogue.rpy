translate russian bree_minami_samantha_sasha_male_ending_1ac5a1a6:
    sasha.say "Думаю, [lssb_common.hero_name()] рад, что он теперь не единственный парень в доме."

# ch/harems/home/events/home_harem_samantha.rpy:3609
translate russian bree_minami_samantha_sasha_male_ending_dbd2fdcf:
    sasha.say "Поэтому он балует Далию при каждом удобном случае!"

# ch/harems/home/events/home_harem_samantha.rpy:3611
translate russian bree_minami_samantha_sasha_male_ending_6b596fbd:
    samantha.say "И про маленькую Джемайму не забывайте!"

# ch/harems/home/events/home_harem_samantha.rpy:3612
translate russian bree_minami_samantha_sasha_male_ending_524e40c0:
    samantha.say "Она хоть и маленькая, но, кажется, изо всех сил это компенсирует!"

# ch/harems/home/events/home_harem_samantha.rpy:3613
translate russian bree_minami_samantha_sasha_male_ending_51a9496d:
    samantha.say "Но в основном у нас всё прекрасно, правда, девчонки?"

# ch/harems/home/events/home_harem_samantha.rpy:3614
translate russian bree_minami_samantha_sasha_male_ending_6a8b8627:
    bree.say "О да, семейная жизнь мне очень нравится."

# ch/harems/home/events/home_harem_samantha.rpy:3615
translate russian bree_minami_samantha_sasha_male_ending_ba6df2f4:
    sasha.say "Порой она как американские горки."

# ch/harems/home/events/home_harem_samantha.rpy:3616
translate russian bree_minami_samantha_sasha_male_ending_08aabbe0:
    sasha.say "Но я люблю американские горки — так что всё отлично!"

# ch/harems/home/events/home_harem_samantha.rpy:3617
translate russian bree_minami_samantha_sasha_male_ending_41959a6b:
    minami.say "Всё замечательно."

# ch/harems/home/events/home_harem_samantha.rpy:3618
translate russian bree_minami_samantha_sasha_male_ending_b54190ec:
    minami.say "Братик со мной, как я всегда и хотела."

# ch/harems/home/events/home_harem_samantha.rpy:3619
translate russian bree_minami_samantha_sasha_male_ending_ff1df8bc:
    minami.say "И все вы тоже!"

# ch/harems/home/events/home_harem_samantha.rpy:3620
translate russian bree_minami_samantha_sasha_male_ending_3bd81a59:
    minami.say "Но без одной вещи я бы обошлась..."

# ch/harems/home/events/home_harem_samantha.rpy:3622
translate russian bree_minami_samantha_sasha_male_ending_c6cc296c:
    sasha.say "Без какой?"

# ch/harems/home/events/home_harem_samantha.rpy:3623
translate russian bree_minami_samantha_sasha_male_ending_a15e7f6c:
    samantha.say "Всё хорошо, Минами, можешь нам сказать."

# ch/harems/home/events/home_harem_samantha.rpy:3624
translate russian bree_minami_samantha_sasha_male_ending_415cba41:
    minami.say "Без вонючих носков братика!"

# ch/harems/home/events/home_harem_samantha.rpy:3625
translate russian bree_minami_samantha_sasha_male_ending_887a5648:
    bree.say "О да, воняют они знатно."

# ch/harems/home/events/home_harem_samantha.rpy:3626
translate russian bree_minami_samantha_sasha_male_ending_6d09991a:
    sasha.say "Иногда он такой неряха!"

# ch/harems/home/events/home_harem_samantha.rpy:3627
translate russian bree_minami_samantha_sasha_male_ending_dd8309c4:
    samantha.say "Не волнуйтесь, девчонки, у нас ещё вся его жизнь впереди, чтобы его перевоспитать."

# ch/harems/home/events/home_harem_samantha.rpy:3628
translate russian bree_minami_samantha_sasha_male_ending_98bebc99:
    samantha.say "И главное — нас четверо, а он один!"

# ch/harems/home/events/home_harem_samantha.rpy:3638
translate russian bree_samantha_sasha_male_ending_d95e14ab:
    "Кажется, я должен уметь без запинки рассказать долгую и увлекательную историю о том, как оказался здесь."

# ch/harems/home/events/home_harem_samantha.rpy:3639
translate russian bree_samantha_sasha_male_ending_a448448e:
    "Ведь кто способен забыть события, благодаря которым женился сразу на трёх девушках?"

# ch/harems/home/events/home_harem_samantha.rpy:3640
translate russian bree_samantha_sasha_male_ending_ac63d923:
    "Нет, позвольте уточнить: на трёх самых горячих девушках, которых я встречал за всю жизнь!"

# ch/harems/home/events/home_harem_samantha.rpy:3641
translate russian bree_samantha_sasha_male_ending_d4f0cbba:
    "Но сейчас всё как в тумане — всё-таки сегодня тот самый большой день..."

# ch/harems/home/events/home_harem_samantha.rpy:3642
translate russian bree_samantha_sasha_male_ending_40b2e856:
    "Уверен, я всё вспомню, когда церемония закончится и волнение уляжется."

# ch/harems/home/events/home_harem_samantha.rpy:3643
translate russian bree_samantha_sasha_male_ending_3ffcf385:
    "А пока придётся смириться с тем, что голова кружится от волнения и предвкушения."

# ch/harems/home/events/home_harem_samantha.rpy:3644
translate russian bree_samantha_sasha_male_ending_f5f6a6e2:
    "Есть такое клише: женщины всю жизнь планируют свою свадьбу до мельчайших подробностей."

# ch/harems/home/events/home_harem_samantha.rpy:3645
translate russian bree_samantha_sasha_male_ending_4fd20ffa:
    "А среднестатистический парень, скорее всего, даже не задумывается, как она пройдёт."

# ch/harems/home/events/home_harem_samantha.rpy:3646
translate russian bree_samantha_sasha_male_ending_937ac623:
    "Но в моём случае можно с полным правом сказать: строить догадки было бы пустой тратой времени."

# ch/harems/home/events/home_harem_samantha.rpy:3647
translate russian bree_samantha_sasha_male_ending_b97d2a64:
    "Ну как я мог предвидеть, что на моей свадьбе будут трое вступающих в брак?"

# ch/harems/home/events/home_harem_samantha.rpy:3648
translate russian bree_samantha_sasha_male_ending_5de6b92f:
    "Точнее, четверо, если считать и меня!"

# ch/harems/home/events/home_harem_samantha.rpy:3649
translate russian bree_samantha_sasha_male_ending_ed1f56d3:
    "Я был бы счастлив с любой из двух симпатичных соседок, которые ко мне въехали."

# ch/harems/home/events/home_harem_samantha.rpy:3650
translate russian bree_samantha_sasha_male_ending_6869a24f:
    "Но когда мы начали встречаться втроём — я, [lssb_homesam.bree_name()] и Саша, — я едва мог в это поверить."

# ch/harems/home/events/home_harem_samantha.rpy:3651
translate russian bree_samantha_sasha_male_ending_b8833bc8:
    "Наверное, я ещё не успел от этого оправиться, когда к нам добавилась Сэм."

# ch/harems/home/events/home_harem_samantha.rpy:3652
translate russian bree_samantha_sasha_male_ending_59fe18ba:
    "Та, которую, как я думал, я потерял навсегда."

# ch/harems/home/events/home_harem_samantha.rpy:3653
translate russian bree_samantha_sasha_male_ending_c874040a:
    "Девушка, с которой я уже смирился попрощаться."

# ch/harems/home/events/home_harem_samantha.rpy:3654
translate russian bree_samantha_sasha_male_ending_be615b7a:
    "Вдруг она снова оказалась рядом."

# ch/harems/home/events/home_harem_samantha.rpy:3655
translate russian bree_samantha_sasha_male_ending_c0185537:
    "Я и опомниться не успел, как мы уже были вместе со всеми тремя."

# ch/harems/home/events/home_harem_samantha.rpy:3656
translate russian bree_samantha_sasha_male_ending_df93d969:
    "Причём это оказалось не просто безумной интрижкой."

# ch/harems/home/events/home_harem_samantha.rpy:3657
translate russian bree_samantha_sasha_male_ending_e97e8fd9:
    "На три предложения руки и сердца я получил три ответа «да»."

# ch/harems/home/events/home_harem_samantha.rpy:3658
translate russian bree_samantha_sasha_male_ending_39423769:
    "Так мы и пришли к этому моменту — здесь и сейчас."

# ch/harems/home/events/home_harem_samantha.rpy:3659
translate russian bree_samantha_sasha_male_ending_32ba74b4:
    "Я оглядываюсь через плечо на часовню, полную наших гостей."

# ch/harems/home/events/home_harem_samantha.rpy:3660
translate russian bree_samantha_sasha_male_ending_156224f6:
    "Надо сказать, компания интересная: люди из самых разных слоёв общества."

# ch/harems/home/events/home_harem_samantha.rpy:3661
translate russian bree_samantha_sasha_male_ending_22ef0d05:
    "Но меня успокаивает то, что почти все места заняты."

# ch/harems/home/events/home_harem_samantha.rpy:3662
translate russian bree_samantha_sasha_male_ending_0227bc14:
    "И ещё то, что вокруг сплошь улыбающиеся лица."

# ch/harems/home/events/home_harem_samantha.rpy:3663
translate russian bree_samantha_sasha_male_ending_21099a95:
    "В этот момент начинает звучать музыка, наполняя часовню."

# ch/harems/home/events/home_harem_samantha.rpy:3664
translate russian bree_samantha_sasha_male_ending_0dafd144:
    "И словно по команде все гости разом встают."

# ch/harems/home/events/home_harem_samantha.rpy:3665
translate russian bree_samantha_sasha_male_ending_12c02527:
    "Я всё ещё смотрю назад, когда в проходе появляются невесты..."

# ch/harems/home/events/home_harem_samantha.rpy:3667
translate russian bree_samantha_sasha_male_ending_b5582968:
    "[lssb_homesam.bree_name()] вся в розовом, её светлые волосы подпрыгивают при каждом шаге ко мне."

# ch/harems/home/events/home_harem_samantha.rpy:3668
translate russian bree_samantha_sasha_male_ending_26e85e82:
    "Её улыбка ещё прекраснее платья."

# ch/harems/home/events/home_harem_samantha.rpy:3671
translate russian bree_samantha_sasha_male_ending_fd4e4b79:
    "Саша, как всегда, в чёрном, оттеняющем бледность её кожи."

# ch/harems/home/events/home_harem_samantha.rpy:3672
translate russian bree_samantha_sasha_male_ending_56d6cc69:
    "Она выглядит мрачной и задумчивой, но вместе с тем чувственной и чарующей."

# ch/harems/home/events/home_harem_samantha.rpy:3675
translate russian bree_samantha_sasha_male_ending_1dc3030d:
    "И наконец Сэм — единственная, кого я уже видел в свадебном платье."

# ch/harems/home/events/home_harem_samantha.rpy:3676
translate russian bree_samantha_sasha_male_ending_9f7c838b:
    "Но почему-то в этом она выглядит гораздо лучше, чем в предыдущем!"

# ch/harems/home/events/home_harem_samantha.rpy:3679
translate russian bree_samantha_sasha_male_ending_dcabda11:
    "Наверное, при виде трёх больших беременных животиков мне следовало бы вспотеть от волнения."

# ch/harems/home/events/home_harem_samantha.rpy:3680
translate russian bree_samantha_sasha_male_ending_e51ee425:
    "И я не представляю, что думают гости на скамьях о том, что все девушки беременны одновременно."

# ch/harems/home/events/home_harem_samantha.rpy:3681
translate russian bree_samantha_sasha_male_ending_19aaa830:
    "Но мне, честно говоря, всё равно: мы уже большая семья, а скоро станем ещё больше!"

# ch/harems/home/events/home_harem_samantha.rpy:3683
translate russian bree_samantha_sasha_male_ending_e48b6648:
    "У алтаря рядом со мной стоят [lssb_homesam.bree_name()], Саша и Сэм, и я не могу отвести от них глаз."

# ch/harems/home/events/home_harem_samantha.rpy:3684
translate russian bree_samantha_sasha_male_ending_f7698691:
    "Три мои невесты — скоро три мои жены!"

# ch/harems/home/events/home_harem_samantha.rpy:3687
translate russian bree_samantha_sasha_male_ending_01c7eeb4:
    "Мастер, которому [lssb_homesam.bree_name()] заказала платье, сотворил настоящее чудо."

# ch/harems/home/events/home_harem_samantha.rpy:3688
translate russian bree_samantha_sasha_male_ending_6617f14a:
    "Когда она держит букет, её уже огромного живота почти не видно!"

# ch/harems/home/events/home_harem_samantha.rpy:3689
translate russian bree_samantha_sasha_male_ending_ed3742ab:
    "Не то чтобы я хотел забыть, что она носит моего ребёнка."

# ch/harems/home/events/home_harem_samantha.rpy:3691
translate russian bree_samantha_sasha_male_ending_430579b3:
    "Когда Саша подходит ближе, я замечаю, что бледна она не только из-за макияжа."

# ch/harems/home/events/home_harem_samantha.rpy:3692
translate russian bree_samantha_sasha_male_ending_7e9b46ea:
    "У неё уже довольно большой срок, и беременность даётся ей нелегко."

# ch/harems/home/events/home_harem_samantha.rpy:3693
translate russian bree_samantha_sasha_male_ending_8fa2a51b:
    "Но она улыбается и кивает, давая понять, что всё хорошо."

# ch/harems/home/events/home_harem_samantha.rpy:3695
translate russian bree_samantha_sasha_male_ending_3dd27aa4:
    "Хотя я уже видел Сэм в свадебном платье, на этот раз есть одно существенное отличие."

# ch/harems/home/events/home_harem_samantha.rpy:3696
translate russian bree_samantha_sasha_male_ending_b1450f2e:
    "В прошлый раз у неё не рос живот, в котором находится мой ребёнок!"

# ch/harems/home/events/home_harem_samantha.rpy:3697
translate russian bree_samantha_sasha_male_ending_28b91960:
    "Пожалуй, это лучше всего показывает, как теперь всё изменилось!"

# ch/harems/home/events/home_harem_samantha.rpy:3698
translate russian bree_samantha_sasha_male_ending_949872b0:
    "Мы вчетвером едва успеваем обменяться взглядами и нервными улыбками."

# ch/harems/home/events/home_harem_samantha.rpy:3699
translate russian bree_samantha_sasha_male_ending_742ce926:
    "Потому что священник начинает церемонию почти сразу, как смолкает музыка."

# ch/harems/home/events/home_harem_samantha.rpy:3701
translate russian bree_samantha_sasha_male_ending_d601e095:
    "Священник" "Сегодня мы собрались здесь..."

# ch/harems/home/events/home_harem_samantha.rpy:3702
translate russian bree_samantha_sasha_male_ending_4517b673:
    "Священник" "Чтобы соединить этих ЧЕТВЕРЫХ людей священными узами брака!"

# ch/harems/home/events/home_harem_samantha.rpy:3703
translate russian bree_samantha_sasha_male_ending_a63b4838:
    "В голосе священника слышится лёгкое замешательство, но главным образом веселье."

# ch/harems/home/events/home_harem_samantha.rpy:3704
translate russian bree_samantha_sasha_male_ending_05a86f48:
    "Собравшиеся гости тоже отзываются понимающим смехом."

# ch/harems/home/events/home_harem_samantha.rpy:3705
translate russian bree_samantha_sasha_male_ending_3876f564:
    "Даже мы вчетвером начинаем хихикать и смеяться, а некоторые ещё и краснеют."

# ch/harems/home/events/home_harem_samantha.rpy:3706
translate russian bree_samantha_sasha_male_ending_16055160:
    "Да, теперь всё это законно, но для каждого из присутствующих пока в новинку."

# ch/harems/home/events/home_harem_samantha.rpy:3707
translate russian bree_samantha_sasha_male_ending_eb6fbdc0:
    "Наверное, через это нужно пройти, прежде чем такое станет привычным."

# ch/harems/home/events/home_harem_samantha.rpy:3708
translate russian bree_samantha_sasha_male_ending_4435e419:
    "Священник берётся за дело, изо всех сил стараясь ничего не упустить."

# ch/harems/home/events/home_harem_samantha.rpy:3709
translate russian bree_samantha_sasha_male_ending_eea83ee2:
    "И вскоре наступает момент обмена клятвами!"

# ch/harems/home/events/home_harem_samantha.rpy:3710
translate russian bree_samantha_sasha_male_ending_8469d766:
    "Священник" "Согласна ли ты, [lssb_homesam.bree_name()], чтобы твоими законными супругами стали Саша, Сэм и [lssb_common.hero_name()]?"

# ch/harems/home/events/home_harem_samantha.rpy:3712
translate russian bree_samantha_sasha_male_ending_9aa356a7:
    bree.say "О да, согласна!"

# ch/harems/home/events/home_harem_samantha.rpy:3713
translate russian bree_samantha_sasha_male_ending_be5df995:
    "Священник" "Согласна ли ты, Саша, чтобы твоими законными супругами стали [lssb_homesam.bree_name()], Сэм и [lssb_common.hero_name()]?"

# ch/harems/home/events/home_harem_samantha.rpy:3715
translate russian bree_samantha_sasha_male_ending_4396f585:
    sasha.say "Да, согласна."

# ch/harems/home/events/home_harem_samantha.rpy:3716
translate russian bree_samantha_sasha_male_ending_51dc21f0:
    "Священник" "Согласна ли ты, Сэм, чтобы твоими законными супругами стали [lssb_homesam.bree_name()], Саша и [lssb_common.hero_name()]?"

# ch/harems/home/events/home_harem_samantha.rpy:3718
translate russian bree_samantha_sasha_male_ending_ea89efa9:
    samantha.say "Согласна."

# ch/harems/home/events/home_harem_samantha.rpy:3719
translate russian bree_samantha_sasha_male_ending_2c9cd608:
    "Священник делает театральную паузу и набирает воздуха перед последним рывком."

# ch/harems/home/events/home_harem_samantha.rpy:3720
translate russian bree_samantha_sasha_male_ending_a7d37de2:
    "Священник" "А согласен ли ты, [lssb_common.hero_name()], чтобы твоими законными супругами стали [lssb_homesam.bree_name()], Саша и Сэм?"

# ch/harems/home/events/home_harem_samantha.rpy:3721
translate russian bree_samantha_sasha_male_ending_b3ea1ce2:
    "Теперь моя очередь глубоко вдохнуть перед ответом."

# ch/harems/home/events/home_harem_samantha.rpy:3722
translate russian bree_samantha_sasha_male_ending_cc481164:
    mike.say "Согласен."

# ch/harems/home/events/home_harem_samantha.rpy:3723
translate russian bree_samantha_sasha_male_ending_4ea8666d:
    "Священник кивает, явно радуясь тому, что церемония подходит к концу."

# ch/harems/home/events/home_harem_samantha.rpy:3724
translate russian bree_samantha_sasha_male_ending_4470e5f7:
    "Священник" "Если кто-либо из присутствующих знает законную причину, по которой эти четверо не могут вступить в брак..."

# ch/harems/home/events/home_harem_samantha.rpy:3725
translate russian bree_samantha_sasha_male_ending_fcd1be26:
    "Священник" "Пусть скажет сейчас или хранит молчание вечно!"

# ch/harems/home/events/home_harem_samantha.rpy:3726
translate russian bree_samantha_sasha_male_ending_307475a5:
    "Он обводит взглядом гостей; наступает привычная пауза, слышны нервные смешки."

# ch/harems/home/events/home_harem_samantha.rpy:3727
translate russian bree_samantha_sasha_male_ending_5360af04:
    "Но никто не вскакивает, чтобы остановить церемонию."

# ch/harems/home/events/home_harem_samantha.rpy:3728
translate russian bree_samantha_sasha_male_ending_73e4c1d4:
    "Священник" "Объявляю вас мужем и жёнами."

# ch/harems/home/events/home_harem_samantha.rpy:3729
translate russian bree_samantha_sasha_male_ending_5759a61b:
    "Священник" "Можете поцеловать невест."

# ch/harems/home/events/home_harem_samantha.rpy:3730
translate russian bree_samantha_sasha_male_ending_a8d858b4:
    "Священник" "Или друг друга..."

# ch/harems/home/events/home_harem_samantha.rpy:3731
translate russian bree_samantha_sasha_male_ending_354cecbd:
    "Священник" "Я не уверен, как это должно происходить в вашем случае!"

# ch/harems/home/events/home_harem_samantha.rpy:3735
translate russian bree_samantha_sasha_male_ending_1c36ca8f:
    "Мы тоже, поэтому просто заключаем друг друга в общие объятия."

# ch/harems/home/events/home_harem_samantha.rpy:3736
translate russian bree_samantha_sasha_male_ending_2cac46eb:
    "Мы обмениваемся поцелуями, и каждый не менее страстный, чем предыдущий."

# ch/harems/home/events/home_harem_samantha.rpy:3737
translate russian bree_samantha_sasha_male_ending_9814d2de:
    "У нас получилось — мы вчетвером действительно связали себя узами брака!"

# ch/harems/home/events/home_harem_samantha.rpy:3738
translate russian bree_samantha_sasha_male_ending_91631677:
    "Теперь мы вместе не только за закрытыми дверями: закон тоже признаёт наш союз четверых!"

# ch/harems/home/events/home_harem_samantha.rpy:3743
translate russian bree_samantha_sasha_male_ending_138f24c3:
    sasha.say "Что ж, думаю, начать следует мне."

# ch/harems/home/events/home_harem_samantha.rpy:3745
translate russian bree_samantha_sasha_male_ending_e0b0ef4d:
    bree.say "Постой, постой, постой!"

# ch/harems/home/events/home_harem_samantha.rpy:3746
translate russian bree_samantha_sasha_male_ending_146d2150:
    bree.say "Это почему?!"

# ch/harems/home/events/home_harem_samantha.rpy:3747
translate russian bree_samantha_sasha_male_ending_508f4a1a:
    sasha.say "Эм, кажется, я первой въехала в дом."

# ch/harems/home/events/home_harem_samantha.rpy:3748
translate russian bree_samantha_sasha_male_ending_27f67a50:
    sasha.say "А значит, мы с [lssb_common.hero_name()] познакомились первыми!"

# ch/harems/home/events/home_harem_samantha.rpy:3749
translate russian bree_samantha_sasha_male_ending_b9b71439:
    bree.say "Что?"

# ch/harems/home/events/home_harem_samantha.rpy:3750
translate russian bree_samantha_sasha_male_ending_f035e899:
    bree.say "Ты въехала всего на пару дней раньше меня, только и всего!"

# ch/harems/home/events/home_harem_samantha.rpy:3752
translate russian bree_samantha_sasha_male_ending_e9d7b922:
    samantha.say "Эй, я правильно всё слышу?"

# ch/harems/home/events/home_harem_samantha.rpy:3753
translate russian bree_samantha_sasha_male_ending_0ccb8523:
    samantha.say "Мы с [lssb_common.hero_name()] жили вместе ещё до того, как появились вы обе."

# ch/harems/home/events/home_harem_samantha.rpy:3754
translate russian bree_samantha_sasha_male_ending_ba3127d2:
    samantha.say "Вы смогли въехать только потому, что я съехала!"

# ch/harems/home/events/home_harem_samantha.rpy:3755
translate russian bree_samantha_sasha_male_ending_60bad94f:
    samantha.say "И всё же."

# ch/harems/home/events/home_harem_samantha.rpy:3756
translate russian bree_samantha_sasha_male_ending_0df9e1cb:
    samantha.say "Это уже глупо."

# ch/harems/home/events/home_harem_samantha.rpy:3757
translate russian bree_samantha_sasha_male_ending_9816fbeb:
    samantha.say "Мы же женаты, ради всего святого."

# ch/harems/home/events/home_harem_samantha.rpy:3758
translate russian bree_samantha_sasha_male_ending_4967a400:
    samantha.say "Не стоит препираться, как школьницы из-за очередной влюблённости!"

# ch/harems/home/events/home_harem_samantha.rpy:3759
translate russian bree_samantha_sasha_male_ending_0458b022:
    bree.say "Ты права, Сэм."

# ch/harems/home/events/home_harem_samantha.rpy:3760
translate russian bree_samantha_sasha_male_ending_2dff27e6:
    sasha.say "Нам не стоит спорить, правда?"

# ch/harems/home/events/home_harem_samantha.rpy:3761
translate russian bree_samantha_sasha_male_ending_126e1aa8:
    samantha.say "Да, не стоит."

# ch/harems/home/events/home_harem_samantha.rpy:3762
translate russian bree_samantha_sasha_male_ending_3ffa1bde:
    samantha.say "Сейчас мы можем высказаться сами."

# ch/harems/home/events/home_harem_samantha.rpy:3763
translate russian bree_samantha_sasha_male_ending_36d095fc:
    samantha.say "Рассказать всем, как выглядит наша жизнь с нашей точки зрения."

# ch/harems/home/events/home_harem_samantha.rpy:3764
translate russian bree_samantha_sasha_male_ending_8bd42904:
    samantha.say "Конечно, иногда мы ссоримся."

# ch/harems/home/events/home_harem_samantha.rpy:3765
translate russian bree_samantha_sasha_male_ending_ddd443b8:
    samantha.say "Это часть любых отношений."

# ch/harems/home/events/home_harem_samantha.rpy:3766
translate russian bree_samantha_sasha_male_ending_ced92296:
    samantha.say "Зато мириться — самое приятное."

# ch/harems/home/events/home_harem_samantha.rpy:3767
translate russian bree_samantha_sasha_male_ending_308752af:
    sasha.say "Да, с этим не поспоришь, Сэм."

# ch/harems/home/events/home_harem_samantha.rpy:3768
translate russian bree_samantha_sasha_male_ending_b2e6492f:
    sasha.say "Мириться с двумя сразу куда веселее!"

# ch/harems/home/events/home_harem_samantha.rpy:3769
translate russian bree_samantha_sasha_male_ending_6bef43bb:
    bree.say "О да!"

# ch/harems/home/events/home_harem_samantha.rpy:3770
translate russian bree_samantha_sasha_male_ending_bd72c759:
    samantha.say "Всего с двумя?"

# ch/harems/home/events/home_harem_samantha.rpy:3772
translate russian bree_samantha_sasha_male_ending_6a8d620b:
    bree.say "Да-да... знаю."

# ch/harems/home/events/home_harem_samantha.rpy:3773
translate russian bree_samantha_sasha_male_ending_1e4117fb:
    bree.say "У Поппи столько энергии, что за ней не угнаться!"

# ch/harems/home/events/home_harem_samantha.rpy:3775
translate russian bree_samantha_sasha_male_ending_1ac5a1a6:
    sasha.say "Думаю, [lssb_common.hero_name()] рад, что он теперь не единственный парень в доме."

# ch/harems/home/events/home_harem_samantha.rpy:3776
translate russian bree_samantha_sasha_male_ending_dbd2fdcf:
    sasha.say "Поэтому он балует Далию при каждом удобном случае!"

# ch/harems/home/events/home_harem_samantha.rpy:3778
translate russian bree_samantha_sasha_male_ending_6b596fbd:
    samantha.say "И про маленькую Джемайму не забывайте!"

# ch/harems/home/events/home_harem_samantha.rpy:3779
translate russian bree_samantha_sasha_male_ending_524e40c0:
    samantha.say "Она хоть и маленькая, но, кажется, изо всех сил это компенсирует!"

# ch/harems/home/events/home_harem_samantha.rpy:3780
translate russian bree_samantha_sasha_male_ending_51a9496d:
    samantha.say "Но в основном у нас всё прекрасно, правда, девчонки?"

# ch/harems/home/events/home_harem_samantha.rpy:3781
translate russian bree_samantha_sasha_male_ending_6a8b8627:
    bree.say "О да, семейная жизнь мне очень нравится."

# ch/harems/home/events/home_harem_samantha.rpy:3782
translate russian bree_samantha_sasha_male_ending_ba6df2f4:
    sasha.say "Порой она как американские горки."

# ch/harems/home/events/home_harem_samantha.rpy:3783
translate russian bree_samantha_sasha_male_ending_5e2b88a8:
    sasha.say "Особенно когда [lssb_common.hero_name()] снимает свои вонючие ботинки."

# ch/harems/home/events/home_harem_samantha.rpy:3784
translate russian bree_samantha_sasha_male_ending_2eb9a023:
    bree.say "...от них И ПРАВДА несёт!"

# ch/harems/home/events/home_harem_samantha.rpy:3785
translate russian bree_samantha_sasha_male_ending_dd8309c4:
    samantha.say "Не волнуйтесь, девчонки, у нас ещё вся его жизнь впереди, чтобы его перевоспитать."

# ch/harems/home/events/home_harem_samantha.rpy:3786
translate russian bree_samantha_sasha_male_ending_981c9fb7:
    samantha.say "И главное — нас трое, а он один!"

# ch/harems/home/events/home_harem_samantha.rpy:3794
translate russian tv_bj_bree_samantha_sasha_79fc42cc:
    "Подходит к концу довольно долгий и тяжёлый день."

# ch/harems/home/events/home_harem_samantha.rpy:3795
translate russian tv_bj_bree_samantha_sasha_ba7e7bd6:
    "Но теперь он позади, и до завтра я никому ничего не должен."

# ch/harems/home/events/home_harem_samantha.rpy:3796
translate russian tv_bj_bree_samantha_sasha_5d80e537:
    "Наконец-то можно расслабиться и отдохнуть так, как мне хочется."

# ch/harems/home/events/home_harem_samantha.rpy:3798
translate russian tv_bj_bree_samantha_sasha_a3fa767b:
    "А сейчас мне хочется просто сидеть перед телевизором и ни о чём не думать!"

# ch/harems/home/events/home_harem_samantha.rpy:3799
translate russian tv_bj_bree_samantha_sasha_02ba6d86:
    "Честно говоря, мне даже не особенно важно, что смотреть."

# ch/harems/home/events/home_harem_samantha.rpy:3800
translate russian tv_bj_bree_samantha_sasha_cd4ff642:
    "Я перебираю всё подряд, пока не нахожу что-то подходящее."

# ch/harems/home/events/home_harem_samantha.rpy:3801
translate russian tv_bj_bree_samantha_sasha_5f203536:
    "Затем включаю, собираясь смотреть без остановки, пока не усну."

# ch/harems/home/events/home_harem_samantha.rpy:3802
translate russian tv_bj_bree_samantha_sasha_815d22af:
    samantha.say "Вот ты где, [lssb_common.hero_name()]!"

# ch/harems/home/events/home_harem_samantha.rpy:3803
translate russian tv_bj_bree_samantha_sasha_7878d34d:
    "Я поднимаю взгляд и вижу Сэм в дверях."

# ch/harems/home/events/home_harem_samantha.rpy:3806
translate russian tv_bj_bree_samantha_sasha_0e149dce:
    mike.say "Привет, Сэм..."

# ch/harems/home/events/home_harem_samantha.rpy:3811
translate russian tv_bj_bree_samantha_sasha_7f8b566f:
    "Прежде чем я успеваю договорить, Сэм входит в гостиную."

# ch/harems/home/events/home_harem_samantha.rpy:3812
translate russian tv_bj_bree_samantha_sasha_6c441fd0:
    "И усаживается рядом со мной на диван."

# ch/harems/home/events/home_harem_samantha.rpy:3813
translate russian tv_bj_bree_samantha_sasha_e34d430b:
    "Я открываю рот, собираясь возразить и сказать, что хочу побыть один."

# ch/harems/home/events/home_harem_samantha.rpy:3814
translate russian tv_bj_bree_samantha_sasha_a9926141:
    "Но тут она прижимается ко мне и кладёт голову мне на плечо!"

# ch/harems/home/events/home_harem_samantha.rpy:3815
translate russian tv_bj_bree_samantha_sasha_03a3e6f4:
    samantha.say "Ну..."

# ch/harems/home/events/home_harem_samantha.rpy:3816
translate russian tv_bj_bree_samantha_sasha_85c61cd7:
    samantha.say "Что смотрим?"

# ch/harems/home/events/home_harem_samantha.rpy:3818
translate russian tv_bj_bree_samantha_sasha_625c9815:
    mike.say "Не знаю, Сэм."

# ch/harems/home/events/home_harem_samantha.rpy:3819
translate russian tv_bj_bree_samantha_sasha_b1c19c98:
    mike.say "Просто отдыхаю, понимаешь?"

# ch/harems/home/events/home_harem_samantha.rpy:3820
translate russian tv_bj_bree_samantha_sasha_68af0efd:
    "Сэм кивает и прижимается ко мне ещё теснее."

# ch/harems/home/events/home_harem_samantha.rpy:3821
translate russian tv_bj_bree_samantha_sasha_52395826:
    samantha.say "М-м-м..."

# ch/harems/home/events/home_harem_samantha.rpy:3822
translate russian tv_bj_bree_samantha_sasha_7e969114:
    samantha.say "Звучит приятно."

# ch/harems/home/events/home_harem_samantha.rpy:3823
translate russian tv_bj_bree_samantha_sasha_c8932eae:
    samantha.say "Только ты и я, вместе отдыхаем на диване."

# ch/harems/home/events/home_harem_samantha.rpy:3824
translate russian tv_bj_bree_samantha_sasha_c350538a:
    samantha.say "Правда ведь?"

# ch/harems/home/events/home_harem_samantha.rpy:3825
translate russian tv_bj_bree_samantha_sasha_d32b7ac2:
    mike.say "Д... да, Сэм..."

# ch/harems/home/events/home_harem_samantha.rpy:3826
translate russian tv_bj_bree_samantha_sasha_be08dd0c:
    mike.say "Звучит отлично!"

# ch/harems/home/events/home_harem_samantha.rpy:3827
translate russian tv_bj_bree_samantha_sasha_f858ca30:
    "Кому-то другому покажется безумием так радоваться такой простой вещи."

# ch/harems/home/events/home_harem_samantha.rpy:3828
translate russian tv_bj_bree_samantha_sasha_9439c4f7:
    "Но для меня это сбывшаяся мечта."

# ch/harems/home/events/home_harem_samantha.rpy:3829
translate russian tv_bj_bree_samantha_sasha_dcab7dca:
    "Не сосчитать, сколько раз я проходил мимо этой двери."

# ch/harems/home/events/home_harem_samantha.rpy:3830
translate russian tv_bj_bree_samantha_sasha_0ce858c4:
    "И видел, как Сэм точно так же уютно устроилась рядом с Райаном."

# ch/harems/home/events/home_harem_samantha.rpy:3831
translate russian tv_bj_bree_samantha_sasha_c495e6fd:
    "Я всегда ужасно им завидовал."

# ch/harems/home/events/home_harem_samantha.rpy:3832
translate russian tv_bj_bree_samantha_sasha_d232bcd1:
    "Я бы всё отдал за возможность вот так посидеть с Сэм."

# ch/harems/home/events/home_harem_samantha.rpy:3833
translate russian tv_bj_bree_samantha_sasha_0ba4c0c6:
    "И вот теперь у меня есть именно то, о чём я всегда мечтал!"

# ch/harems/home/events/home_harem_samantha.rpy:3834
translate russian tv_bj_bree_samantha_sasha_6b463eb9:
    "Поэтому я без колебаний обнимаю Сэм и притягиваю ещё ближе."

# ch/harems/home/events/home_harem_samantha.rpy:3838
translate russian tv_bj_bree_samantha_sasha_6058448b:
    bree.say "Эй, [lssb_common.hero_name()]!"

# ch/harems/home/events/home_harem_samantha.rpy:3839
translate russian tv_bj_bree_samantha_sasha_98adfe90:
    bree.say "Не против, если я присоединюсь?"

# ch/harems/home/events/home_harem_samantha.rpy:3841
translate russian tv_bj_bree_samantha_sasha_495e6fcc:
    "Я только-только устроился поудобнее с Сэм."

# ch/harems/home/events/home_harem_samantha.rpy:3842
translate russian tv_bj_bree_samantha_sasha_c8ea86f1:
    "А в дверях уже стоит и [lssb_homesam.bree_name()]!"

# ch/harems/home/events/home_harem_samantha.rpy:3843
translate russian tv_bj_bree_samantha_sasha_de589814:
    "Но, как и Сэм до неё, она не ждёт ни секунды."

# ch/harems/home/events/home_harem_samantha.rpy:3847
translate russian tv_bj_bree_samantha_sasha_2913551d:
    "[lssb_homesam.bree_name()] легко впархивает в комнату и садится рядом со мной на диван."

# ch/harems/home/events/home_harem_samantha.rpy:3848
translate russian tv_bj_bree_samantha_sasha_b9e8394c:
    "Разумеется, с другой стороны от меня."

# ch/harems/home/events/home_harem_samantha.rpy:3849
translate russian tv_bj_bree_samantha_sasha_308738e7:
    "Поэтому, входя, она и не заметила Сэм."

# ch/harems/home/events/home_harem_samantha.rpy:3850
translate russian tv_bj_bree_samantha_sasha_85e022ec:
    "И только придвинувшись ко мне, обнаруживает, что мы не одни."

# ch/harems/home/events/home_harem_samantha.rpy:3851
translate russian tv_bj_bree_samantha_sasha_a1f0e512:
    bree.say "А-а!"

# ch/harems/home/events/home_harem_samantha.rpy:3852
translate russian tv_bj_bree_samantha_sasha_9e908734:
    bree.say "А... это всего лишь ты, Сэм!"

# ch/harems/home/events/home_harem_samantha.rpy:3853
translate russian tv_bj_bree_samantha_sasha_d746ffea:
    bree.say "Но погоди, что ты тут делаешь?"

# ch/harems/home/events/home_harem_samantha.rpy:3854
translate russian tv_bj_bree_samantha_sasha_003f6b75:
    samantha.say "Забавно, [lssb_homesam.bree_name()]..."

# ch/harems/home/events/home_harem_samantha.rpy:3855
translate russian tv_bj_bree_samantha_sasha_53a3cfc7:
    samantha.say "Я как раз хотела спросить тебя о том же!"

# ch/harems/home/events/home_harem_samantha.rpy:3856
translate russian tv_bj_bree_samantha_sasha_db8ee65f:
    "В этот момент я решаю вмешаться в разговор."

# ch/harems/home/events/home_harem_samantha.rpy:3857
translate russian tv_bj_bree_samantha_sasha_4c15ccc6:
    "Потому что, кажется, понимаю, к чему всё идёт."

# ch/harems/home/events/home_harem_samantha.rpy:3858
translate russian tv_bj_bree_samantha_sasha_ff03e43d:
    "Мне, конечно, льстит, что две горячие девушки хотят уютно устроиться со мной на диване."

# ch/harems/home/events/home_harem_samantha.rpy:3859
translate russian tv_bj_bree_samantha_sasha_d705ff7b:
    "Но мысль о том, что они подерутся за это место, уже не так привлекательна."

# ch/harems/home/events/home_harem_samantha.rpy:3860
translate russian tv_bj_bree_samantha_sasha_8b7757d5:
    mike.say "Я просто смотрел телевизор, [lssb_homesam.bree_name()]."

# ch/harems/home/events/home_harem_samantha.rpy:3861
translate russian tv_bj_bree_samantha_sasha_5649ada0:
    mike.say "Потом пришла Сэм и присоединилась."

# ch/harems/home/events/home_harem_samantha.rpy:3862
translate russian tv_bj_bree_samantha_sasha_178878a1:
    mike.say "Но и для тебя места полно."

# ch/harems/home/events/home_harem_samantha.rpy:3863
translate russian tv_bj_bree_samantha_sasha_e225879b:
    mike.say "Правда, Сэм?"

# ch/harems/home/events/home_harem_samantha.rpy:3864
translate russian tv_bj_bree_samantha_sasha_6348b737:
    "Сэм явно не в восторге от того, что [lssb_homesam.bree_name()] присоединится к нам."

# ch/harems/home/events/home_harem_samantha.rpy:3865
translate russian tv_bj_bree_samantha_sasha_2e392cb8:
    "Но потом, похоже, понимает, что нельзя просто выгнать соседку из гостиной."

# ch/harems/home/events/home_harem_samantha.rpy:3866
translate russian tv_bj_bree_samantha_sasha_3953fa1c:
    "Как бы она объяснила причину такого поступка?"

# ch/harems/home/events/home_harem_samantha.rpy:3867
translate russian tv_bj_bree_samantha_sasha_2e0cf220:
    "Разве что призналась бы, что хочет побыть со мной наедине и поближе!"

# ch/harems/home/events/home_harem_samantha.rpy:3868
translate russian tv_bj_bree_samantha_sasha_a40e30ea:
    samantha.say "Наверное."

# ch/harems/home/events/home_harem_samantha.rpy:3869
translate russian tv_bj_bree_samantha_sasha_fc01fa38:
    samantha.say "Только оставайся на своей половине дивана."

# ch/harems/home/events/home_harem_samantha.rpy:3870
translate russian tv_bj_bree_samantha_sasha_7932ecf6:
    "[lssb_homesam.bree_name()] и Сэм отодвигаются каждая к своему краю дивана."

# ch/harems/home/events/home_harem_samantha.rpy:3871
translate russian tv_bj_bree_samantha_sasha_71e67a66:
    "Но я молча ликую, когда через мгновение они начинают придвигаться обратно."

# ch/harems/home/events/home_harem_samantha.rpy:3872
translate russian tv_bj_bree_samantha_sasha_7b2e5e21:
    "Честно говоря, каждая, похоже, уверена, что другая не делает того же самого."

# ch/harems/home/events/home_harem_samantha.rpy:3873
translate russian tv_bj_bree_samantha_sasha_a09a8232:
    "Так что, пока я сижу спокойно, могу наслаждаться их объятиями с двух сторон!"

# ch/harems/home/events/home_harem_samantha.rpy:3877
translate russian tv_bj_bree_samantha_sasha_456ac6c2:
    sasha.say "Я тебя слышу, [lssb_common.hero_name()]!"

# ch/harems/home/events/home_harem_samantha.rpy:3878
translate russian tv_bj_bree_samantha_sasha_3830ea66:
    sasha.say "Думаешь, тебе это сойдёт с рук?"

# ch/harems/home/events/home_harem_samantha.rpy:3879
translate russian tv_bj_bree_samantha_sasha_2aff5b93:
    sasha.say "Смотришь всякую дрянь по телевизору без меня?"

# ch/harems/home/events/home_harem_samantha.rpy:3880
translate russian tv_bj_bree_samantha_sasha_7f257293:
    "Саша даже не задерживается в дверях, как это сделали [lssb_homesam.bree_name()] и Сэм."

# ch/harems/home/events/home_harem_samantha.rpy:3881
translate russian tv_bj_bree_samantha_sasha_06876b82:
    "Она сразу влетает в гостиную."

# ch/harems/home/events/home_harem_samantha.rpy:3882
translate russian tv_bj_bree_samantha_sasha_d4f6bd63:
    "И, похоже, собиралась запрыгнуть прямо на меня!"

# ch/harems/home/events/home_harem_samantha.rpy:3883
translate russian tv_bj_bree_samantha_sasha_bc5ad73e:
    "Жаль, что тут она замечает двух других девушек по обе стороны от меня."

# ch/harems/home/events/home_harem_samantha.rpy:3887
translate russian tv_bj_bree_samantha_sasha_b63b830b:
    sasha.say "Какого хрена?"

# ch/harems/home/events/home_harem_samantha.rpy:3888
translate russian tv_bj_bree_samantha_sasha_0dce80b6:
    bree.say "В каком, нахрен, смысле — «какого хрена»?"

# ch/harems/home/events/home_harem_samantha.rpy:3889
translate russian tv_bj_bree_samantha_sasha_38f50f9b:
    samantha.say "А вы обе что, нахрен, имеете в виду своим «какого хрена»?"

# ch/harems/home/events/home_harem_samantha.rpy:3891
translate russian tv_bj_bree_samantha_sasha_a714b04c:
    mike.say "Не понимаю, в чём проблема, девчонки."

# ch/harems/home/events/home_harem_samantha.rpy:3892
translate russian tv_bj_bree_samantha_sasha_2f86e111:
    mike.say "Разве нельзя просто сесть и вместе посмотреть телевизор?"

# ch/harems/home/events/home_harem_samantha.rpy:3893
translate russian tv_bj_bree_samantha_sasha_3e7f8ad4:
    mike.say "Мы же живём в одном доме, правда?"

# ch/harems/home/events/home_harem_samantha.rpy:3894
translate russian tv_bj_bree_samantha_sasha_3209de17:
    "Все трое обмениваются неприязненными взглядами."

# ch/harems/home/events/home_harem_samantha.rpy:3895
translate russian tv_bj_bree_samantha_sasha_5ceb98ec:
    "Но возразить против присутствия друг друга им нечего."

# ch/harems/home/events/home_harem_samantha.rpy:3896
translate russian tv_bj_bree_samantha_sasha_d7474404:
    "Если только не признаться, что каждая хочет заполучить меня целиком."

# ch/harems/home/events/home_harem_samantha.rpy:3897
translate russian tv_bj_bree_samantha_sasha_aa0e4d71:
    bree.say "Ладно, Саша, ладно..."

# ch/harems/home/events/home_harem_samantha.rpy:3898
translate russian tv_bj_bree_samantha_sasha_1106b703:
    bree.say "Но на этом диване уже нет места!"

# ch/harems/home/events/home_harem_samantha.rpy:3899
translate russian tv_bj_bree_samantha_sasha_730a28ea:
    samantha.say "[lssb_homesam.bree_name()] права, Саша..."

# ch/harems/home/events/home_harem_samantha.rpy:3900
translate russian tv_bj_bree_samantha_sasha_bb3510fc:
    samantha.say "Тебе придётся сесть на другой диван, вон туда!"

# ch/harems/home/events/home_harem_samantha.rpy:3901
translate russian tv_bj_bree_samantha_sasha_5e8b875b:
    "Саша на миг ощетинивается, и кажется, что она сейчас возразит."

# ch/harems/home/events/home_harem_samantha.rpy:3902
translate russian tv_bj_bree_samantha_sasha_f02bde49:
    "Но затем на её лице появляется улыбка."

# ch/harems/home/events/home_harem_samantha.rpy:3903
translate russian tv_bj_bree_samantha_sasha_08d3daa1:
    "Та самая хитрая улыбка, по которой я понимаю: она что-то придумала."

# ch/harems/home/events/home_harem_samantha.rpy:3904
translate russian tv_bj_bree_samantha_sasha_ea8d2159:
    sasha.say "Не-а..."

# ch/harems/home/events/home_harem_samantha.rpy:3905
translate russian tv_bj_bree_samantha_sasha_bad94cde:
    sasha.say "Незачем..."

# ch/harems/home/events/home_harem_samantha.rpy:3906
translate russian tv_bj_bree_samantha_sasha_08aa2869:
    sasha.say "Я просто сяду здесь, на полу!"

# ch/harems/home/events/home_harem_samantha.rpy:3907
translate russian tv_bj_bree_samantha_sasha_260711c6:
    "С этими словами Саша усаживается на пол прямо передо мной."

# ch/harems/home/events/home_harem_samantha.rpy:3908
translate russian tv_bj_bree_samantha_sasha_fcf97ddb:
    "Она устраивается между моих коленей, прислоняясь спиной к дивану и ко мне."

# ch/harems/home/events/home_harem_samantha.rpy:3909
translate russian tv_bj_bree_samantha_sasha_922de227:
    "Я чувствую, как [lssb_homesam.bree_name()] и Сэм сверлят её взглядами."

# ch/harems/home/events/home_harem_samantha.rpy:3910
translate russian tv_bj_bree_samantha_sasha_c922f202:
    "Но она молча смотрит прямо перед собой."

# ch/harems/home/events/home_harem_samantha.rpy:3911
translate russian tv_bj_bree_samantha_sasha_ca15bf7b:
    "Хотя я почти уверен, что сейчас она улыбается."

# ch/harems/home/events/home_harem_samantha.rpy:3912
translate russian tv_bj_bree_samantha_sasha_72b517c5:
    "Пару минут мне кажется, что на этом вечерние приключения закончились."

# ch/harems/home/events/home_harem_samantha.rpy:3913
translate russian tv_bj_bree_samantha_sasha_53282b03:
    "Будь в комнате одна из девушек, я бы с радостью позволил себе немного пошалить."

# ch/harems/home/events/home_harem_samantha.rpy:3914
translate russian tv_bj_bree_samantha_sasha_3a30fb4e:
    "Даже при двух я мог бы позволить себе редкие прикосновения и ласки."

# ch/harems/home/events/home_harem_samantha.rpy:3915
translate russian tv_bj_bree_samantha_sasha_0f63ef89:
    "Но теперь здесь все трое."

# ch/harems/home/events/home_harem_samantha.rpy:3916
translate russian tv_bj_bree_samantha_sasha_5b5eaa3a:
    "И что-нибудь предпринять — всё равно что напроситься, чтобы меня застукали."

# ch/harems/home/events/home_harem_samantha.rpy:3917
translate russian tv_bj_bree_samantha_sasha_a23f0b87:
    "Поэтому через мгновение я так удивляюсь, почувствовав прикосновения."

# ch/harems/home/events/home_harem_samantha.rpy:3918
translate russian tv_bj_bree_samantha_sasha_9da35f25:
    "Причём не одной руки, а сразу трёх!"

# ch/harems/home/events/home_harem_samantha.rpy:3919
translate russian tv_bj_bree_samantha_sasha_12367b13:
    "Похоже, девушки не так осторожны, как я."

# ch/harems/home/events/home_harem_samantha.rpy:3920
translate russian tv_bj_bree_samantha_sasha_caef309d:
    "Кажется, рука Сэм проскользнула под одну из моих рук."

# ch/harems/home/events/home_harem_samantha.rpy:3921
translate russian tv_bj_bree_samantha_sasha_711e9d02:
    "И теперь медленно движется к моей талии."

# ch/harems/home/events/home_harem_samantha.rpy:3922
translate russian tv_bj_bree_samantha_sasha_6bbf13bd:
    "[lssb_homesam.bree_name()] движется рукой в обратном направлении."

# ch/harems/home/events/home_harem_samantha.rpy:3923
translate russian tv_bj_bree_samantha_sasha_904dc52a:
    "Я чувствую, как она ведёт ею вверх по моему бедру."

# ch/harems/home/events/home_harem_samantha.rpy:3924
translate russian tv_bj_bree_samantha_sasha_c59418d8:
    "Не желая отставать, Саша крадётся рукой вверх по другой ноге."

# ch/harems/home/events/home_harem_samantha.rpy:3925
translate russian tv_bj_bree_samantha_sasha_d81e1961:
    "Уверенно приближаясь к колену."

# ch/harems/home/events/home_harem_samantha.rpy:3926
translate russian tv_bj_bree_samantha_sasha_d87d7c0d:
    "И всё это ставит меня в ещё более неловкое положение."

# ch/harems/home/events/home_harem_samantha.rpy:3927
translate russian tv_bj_bree_samantha_sasha_9f0062d7:
    "Конечно, мне приятно, когда меня одновременно ласкают тремя разными способами."

# ch/harems/home/events/home_harem_samantha.rpy:3928
translate russian tv_bj_bree_samantha_sasha_51c95df5:
    "Но что случится, когда их руки встретятся посередине?"

# ch/harems/home/events/home_harem_samantha.rpy:3929
translate russian tv_bj_bree_samantha_sasha_2728e92f:
    "Особенно учитывая, что посередине как раз мой пах!"

# ch/harems/home/events/home_harem_samantha.rpy:3930
translate russian tv_bj_bree_samantha_sasha_e237ded9:
    "Если я их одёрну, скорее всего, тут же начнётся скандал."

# ch/harems/home/events/home_harem_samantha.rpy:3931
translate russian tv_bj_bree_samantha_sasha_3b563027:
    "Ссора троих, в самом центре которой окажусь я!"

# ch/harems/home/events/home_harem_samantha.rpy:3932
translate russian tv_bj_bree_samantha_sasha_430d47ff:
    "Вдруг я слышу шёпот у самого уха."

# ch/harems/home/events/home_harem_samantha.rpy:3933
translate russian tv_bj_bree_samantha_sasha_cb768272:
    samantha.say "О, [lssb_common.hero_name()]..."

# ch/harems/home/events/home_harem_samantha.rpy:3934
translate russian tv_bj_bree_samantha_sasha_f5801e4b:
    samantha.say "С каких пор у тебя такие нежные женские руки?"

# ch/harems/home/events/home_harem_samantha.rpy:3935
translate russian tv_bj_bree_samantha_sasha_18c08444:
    bree.say "Как странно..."

# ch/harems/home/events/home_harem_samantha.rpy:3936
translate russian tv_bj_bree_samantha_sasha_73708f2e:
    bree.say "Я как раз хотела спросить то же самое!"

# ch/harems/home/events/home_harem_samantha.rpy:3937
translate russian tv_bj_bree_samantha_sasha_940b6c92:
    sasha.say "Вы о чём вообще?"

# ch/harems/home/events/home_harem_samantha.rpy:3938
translate russian tv_bj_bree_samantha_sasha_0b1f3a87:
    sasha.say "Я собиралась спросить его первой!"

# ch/harems/home/events/home_harem_samantha.rpy:3939
translate russian tv_bj_bree_samantha_sasha_9b8e3830:
    "С нарастающим ужасом я опускаю взгляд."

# ch/harems/home/events/home_harem_samantha.rpy:3940
translate russian tv_bj_bree_samantha_sasha_438cf633:
    "И вижу, что [lssb_homesam.bree_name()], Сэм и Саша положили руки мне на пах."

# ch/harems/home/events/home_harem_samantha.rpy:3941
translate russian tv_bj_bree_samantha_sasha_40bafbf5:
    "И теперь ласкают там руки друг друга."

# ch/harems/home/events/home_harem_samantha.rpy:3942
translate russian tv_bj_bree_samantha_sasha_2a76ac49:
    "Пока все трое не понимают, что происходит."

# ch/harems/home/events/home_harem_samantha.rpy:3943
translate russian tv_bj_bree_samantha_sasha_c3f17a6f:
    "Тогда они отдёргивают руки, одновременно шлёпая друг друга."

# ch/harems/home/events/home_harem_samantha.rpy:3947
translate russian tv_bj_bree_samantha_sasha_e975d508:
    bree.say "Вы двое что, совсем на сексе помешались?"

# ch/harems/home/events/home_harem_samantha.rpy:3949
translate russian tv_bj_bree_samantha_sasha_d5d1eddd:
    samantha.say "Кто бы говорил, похотливая шлюха!"

# ch/harems/home/events/home_harem_samantha.rpy:3951
translate russian tv_bj_bree_samantha_sasha_0b9b4a51:
    sasha.say "Я хотя бы не пускаю на него слюни, как течная сука!"

# ch/harems/home/events/home_harem_samantha.rpy:3953
translate russian tv_bj_bree_samantha_sasha_ef9c9b7c:
    mike.say "Девчонки, только не поймите меня неправильно..."

# ch/harems/home/events/home_harem_samantha.rpy:3954
translate russian tv_bj_bree_samantha_sasha_97e46550:
    mike.say "Но я правда просто пытался посмотреть телевизор и отдохнуть!"

# ch/harems/home/events/home_harem_samantha.rpy:3955
translate russian tv_bj_bree_samantha_sasha_b8d78af6:
    mike.say "Мне, конечно, лестно и всё такое, но нельзя ли жить дружно?"

# ch/harems/home/events/home_harem_samantha.rpy:3959
translate russian tv_bj_bree_samantha_sasha_d1a02509:
    "На лицах девушек гнев один за другим сменяется смущением."

# ch/harems/home/events/home_harem_samantha.rpy:3960
translate russian tv_bj_bree_samantha_sasha_5ebafd32:
    "Осознав, как всё выглядит со стороны, они обмениваются виноватыми взглядами."

# ch/harems/home/events/home_harem_samantha.rpy:3961
translate russian tv_bj_bree_samantha_sasha_ce7ccc29:
    bree.say "Он прав."

# ch/harems/home/events/home_harem_samantha.rpy:3963
translate russian tv_bj_bree_samantha_sasha_35883f21:
    bree.say "Мы должны уметь ладить."

# ch/harems/home/events/home_harem_samantha.rpy:3964
translate russian tv_bj_bree_samantha_sasha_be7246e1:
    samantha.say "Конечно, должны."

# ch/harems/home/events/home_harem_samantha.rpy:3966
translate russian tv_bj_bree_samantha_sasha_36bb5588:
    samantha.say "Мы же все взрослые, правда?"

# ch/harems/home/events/home_harem_samantha.rpy:3967
translate russian tv_bj_bree_samantha_sasha_a55282ca:
    sasha.say "Более того, мы должны действовать сообща."

# ch/harems/home/events/home_harem_samantha.rpy:3969
translate russian tv_bj_bree_samantha_sasha_985e8c7a:
    sasha.say "Чтобы в нашем доме царила гармония!"

# ch/harems/home/events/home_harem_samantha.rpy:3970
translate russian tv_bj_bree_samantha_sasha_3b326de0:
    "Я наблюдаю, как они начинают кивать и обмениваться многозначительными взглядами."

# ch/harems/home/events/home_harem_samantha.rpy:3971
translate russian tv_bj_bree_samantha_sasha_ed1b7a6f:
    "И думаю, пойму ли я когда-нибудь, как это устроено."

# ch/harems/home/events/home_harem_samantha.rpy:3972
translate russian tv_bj_bree_samantha_sasha_9570b9a4:
    "Ну, эту странную способность женщин словно читать мысли друг друга."

# ch/harems/home/events/home_harem_samantha.rpy:3973
translate russian tv_bj_bree_samantha_sasha_602bfff8:
    "Потому что уже через несколько секунд все трое принимаются за дело."

# ch/harems/home/events/home_harem_samantha.rpy:3974
translate russian tv_bj_bree_samantha_sasha_6db2175a:
    "[lssb_homesam.bree_name()] и Сэм встают с дивана, а Саша опускается на колени на полу."

# ch/harems/home/events/home_harem_samantha.rpy:3975
translate russian tv_bj_bree_samantha_sasha_9178b399:
    "И без единого слова они начинают раздеваться!"

# ch/harems/home/events/home_harem_samantha.rpy:3980
translate russian tv_bj_bree_samantha_sasha_514833bc:
    "Я могу только сидеть и смотреть, не в силах что-либо сказать или сделать."

# ch/harems/home/events/home_harem_samantha.rpy:3981
translate russian tv_bj_bree_samantha_sasha_b714ee98:
    "Отчасти потому, что ошеломлён происходящим."

# ch/harems/home/events/home_harem_samantha.rpy:3982
translate russian tv_bj_bree_samantha_sasha_8ef3be16:
    "А отчасти потому, что не врал, когда говорил об ужасной усталости."

# ch/harems/home/events/home_harem_samantha.rpy:3983
translate russian tv_bj_bree_samantha_sasha_4ce52f8e:
    "Вместе этого достаточно, чтобы я совсем обессилел."

# ch/harems/home/events/home_harem_samantha.rpy:3984
translate russian tv_bj_bree_samantha_sasha_1ede9164:
    "Я всё ещё не могу пошевелиться, когда обнажённые девушки обращают внимание на меня."

# ch/harems/home/events/home_harem_samantha.rpy:3986
translate russian tv_bj_bree_samantha_sasha_87981654:
    "И это состояние не проходит, когда они начинают снимать с меня одежду."

# ch/harems/home/events/home_harem_samantha.rpy:3987
translate russian tv_bj_bree_samantha_sasha_c39db987:
    "Я просто откидываюсь назад и смотрю, как все трое раздевают меня догола на диване."

# ch/harems/home/events/home_harem_samantha.rpy:3988
translate russian tv_bj_bree_samantha_sasha_7d86a8ef:
    "Затем они становятся передо мной на колени: слева [lssb_homesam.bree_name()], справа Саша, а посередине Сэм."

# ch/harems/home/events/home_harem_samantha.rpy:3989
translate russian tv_bj_bree_samantha_sasha_89133a43:
    "Не буду врать: им ничего не нужно делать, чтобы меня возбудить."

# ch/harems/home/events/home_harem_samantha.rpy:3990
translate russian tv_bj_bree_samantha_sasha_9ba6f68d:
    "Мой член уже поднимается от одного их вида!"

# ch/harems/home/events/home_harem_samantha.rpy:3991
translate russian tv_bj_bree_samantha_sasha_a90a6528:
    "Сердце тоже колотится, всё быстрее гоняя кровь по телу."

# ch/harems/home/events/home_harem_samantha.rpy:3992
translate russian tv_bj_bree_samantha_sasha_37690b43:
    "Они пока не касаются меня, словно понимают, что это и не требуется."

# ch/harems/home/events/home_harem_samantha.rpy:3993
translate russian tv_bj_bree_samantha_sasha_f98eba95:
    "И лишь когда я понимаю, что сильнее он уже не встанет, они начинают двигаться."

# ch/harems/home/events/home_harem_samantha.rpy:3994
translate russian tv_bj_bree_samantha_sasha_67a39cdd:
    "Все разом наклоняются как можно ближе."

# ch/harems/home/events/home_harem_samantha.rpy:3995
translate russian tv_bj_bree_samantha_sasha_a89ba18e:
    "Их губы раздвигаются, из приоткрытых ртов показываются языки."

# ch/harems/home/events/home_harem_samantha.rpy:3996
translate russian tv_bj_bree_samantha_sasha_a0fd7056:
    "Но стоит кончикам этих языков коснуться меня..."

# ch/harems/home/events/home_harem_samantha.rpy:3997
translate russian tv_bj_bree_samantha_sasha_076cdd11:
    "По всему телу пробегает дрожь возбуждения."

# ch/harems/home/events/home_harem_samantha.rpy:3998
translate russian tv_bj_bree_samantha_sasha_2c142cb1:
    "И всё же двигаться мне не хочется."

# ch/harems/home/events/home_harem_samantha.rpy:3999
translate russian tv_bj_bree_samantha_sasha_f21b17ff:
    "Наоборот, я словно прикован к месту — неподвижный и беспомощный."

# ch/harems/home/events/home_harem_samantha.rpy:4000
translate russian tv_bj_bree_samantha_sasha_b6e7d789:
    "Мне остаётся лишь смотреть, как их губы, языки и зубы принимаются за меня."

# ch/harems/home/events/home_harem_samantha.rpy:4001
translate russian tv_bj_bree_samantha_sasha_3e88d1e8:
    "Поначалу я ещё могу уследить, кто что делает."

# ch/harems/home/events/home_harem_samantha.rpy:4002
translate russian tv_bj_bree_samantha_sasha_5f23aa97:
    "Сэм целует головку, [lssb_homesam.bree_name()] ласкает ствол, а Саша играет с моими яйцами."

# ch/harems/home/events/home_harem_samantha.rpy:4003
translate russian tv_bj_bree_samantha_sasha_2e93bdd8:
    "Но очень скоро удовольствие затуманивает восприятие."

# ch/harems/home/events/home_harem_samantha.rpy:4004
translate russian tv_bj_bree_samantha_sasha_54443a30:
    "Стоит моргнуть — и кажется, что девушки уже поменялись местами."

# ch/harems/home/events/home_harem_samantha.rpy:4006
translate russian tv_bj_bree_samantha_sasha_9ddc4290:
    "Теперь [lssb_homesam.bree_name()] глубоко взяла головку моего члена в рот."

# ch/harems/home/events/home_harem_samantha.rpy:4007
translate russian tv_bj_bree_samantha_sasha_8581524f:
    "Саша ласкает ствол языком."

# ch/harems/home/events/home_harem_samantha.rpy:4008
translate russian tv_bj_bree_samantha_sasha_15ce0f4c:
    "А на яйцах я чувствую губы — должно быть, Сэм."

# ch/harems/home/events/home_harem_samantha.rpy:4010
translate russian tv_bj_bree_samantha_sasha_565d0d07:
    "От того, что они делают, у меня почти кружится голова."

# ch/harems/home/events/home_harem_samantha.rpy:4011
translate russian tv_bj_bree_samantha_sasha_a5041a97:
    "Ведь ни одна словно бы не мешает остальным."

# ch/harems/home/events/home_harem_samantha.rpy:4013
translate russian tv_bj_bree_samantha_sasha_f4f6335b:
    "Даже когда они меняются местами, удовольствие не прерывается ни на миг."

# ch/harems/home/events/home_harem_samantha.rpy:4014
translate russian tv_bj_bree_samantha_sasha_95925c4f:
    "Каждая подхватывает там, где закончила другая."

# ch/harems/home/events/home_harem_samantha.rpy:4016
translate russian tv_bj_bree_samantha_sasha_eb3cf3ff:
    "Так что меня непрерывно ласкают сразу тремя способами."

# ch/harems/home/events/home_harem_samantha.rpy:4017
translate russian tv_bj_bree_samantha_sasha_19c667d8:
    "А их взгляды лишь усиливают ощущения."

# ch/harems/home/events/home_harem_samantha.rpy:4019
translate russian tv_bj_bree_samantha_sasha_006b39a6:
    "Каждый раз, встречаясь с одной из них понимающим взглядом, я думаю: сейчас всё."

# ch/harems/home/events/home_harem_samantha.rpy:4020
translate russian tv_bj_bree_samantha_sasha_d3064242:
    "В этих взглядах ясно читается понимание того, что происходит и что они со мной делают."

# ch/harems/home/events/home_harem_samantha.rpy:4022
translate russian tv_bj_bree_samantha_sasha_22a26061:
    "И я сразу вижу, что все трое увлечены этим не меньше меня."

# ch/harems/home/events/home_harem_samantha.rpy:4023
translate russian tv_bj_bree_samantha_sasha_e977b987:
    "Другие звуки, помимо звуков их ласк, это подтверждают."

# ch/harems/home/events/home_harem_samantha.rpy:4025
translate russian tv_bj_bree_samantha_sasha_6e8f249d:
    "Комната наполнена моим тяжёлым дыханием."

# ch/harems/home/events/home_harem_samantha.rpy:4026
translate russian tv_bj_bree_samantha_sasha_9a254df4:
    "А вместе с ним слышатся вздохи и стоны."

# ch/harems/home/events/home_harem_samantha.rpy:4028
translate russian tv_bj_bree_samantha_sasha_94bcf9ce:
    "Стоит им убрать губы с моего члена, как они едва сдерживают чувства."

# ch/harems/home/events/home_harem_samantha.rpy:4029
translate russian tv_bj_bree_samantha_sasha_a58eb952:
    "С любой из этих девушек я рано или поздно не выдержал бы."

# ch/harems/home/events/home_harem_samantha.rpy:4031
translate russian tv_bj_bree_samantha_sasha_3048c5ba:
    "С двумя уж точно не продержался бы долго."

# ch/harems/home/events/home_harem_samantha.rpy:4032
translate russian tv_bj_bree_samantha_sasha_1e2aa2d4:
    "А со всеми тремя удивительно, что я продержался хотя бы столько."

# ch/harems/home/events/home_harem_samantha.rpy:4034
translate russian tv_bj_bree_samantha_sasha_492e6e25:
    "Я сжимаю в кулаках диванные подушки."

# ch/harems/home/events/home_harem_samantha.rpy:4035
translate russian tv_bj_bree_samantha_sasha_93ba06ca:
    "Зубы стиснуты, челюсти напряжены."

# ch/harems/home/events/home_harem_samantha.rpy:4036
translate russian tv_bj_bree_samantha_sasha_bcf56db7:
    "Всё потому, что я пытаюсь продержаться ещё чуть-чуть."

# ch/harems/home/events/home_harem_samantha.rpy:4038
translate russian tv_bj_bree_samantha_sasha_bba88415:
    "К счастью, [lssb_homesam.bree_name()], Сэм и Саша, похоже, это замечают."

# ch/harems/home/events/home_harem_samantha.rpy:4039
translate russian tv_bj_bree_samantha_sasha_4b1d7539:
    "И меняют свои действия, чтобы подготовиться."

# ch/harems/home/events/home_harem_samantha.rpy:4040
translate russian tv_bj_bree_samantha_sasha_79dfb97a:
    "Когда начинает происходить неизбежное, они стоят передо мной на коленях."

# ch/harems/home/events/home_harem_samantha.rpy:4041
translate russian tv_bj_bree_samantha_sasha_affa010b:
    "Все трое терпеливо ждут, что я сделаю дальше."

# ch/harems/home/events/home_harem_samantha.rpy:4044
translate russian tv_bj_bree_samantha_sasha_4eca340c:
    "Не знаю, что в итоге определяет мой выбор."

# ch/harems/home/events/home_harem_samantha.rpy:4045
translate russian tv_bj_bree_samantha_sasha_df13fd13:
    "Меня просто неудержимо притягивает [lssb_homesam.bree_name()]."

# ch/harems/home/events/home_harem_samantha.rpy:4046
translate russian tv_bj_bree_samantha_sasha_f0b6746c:
    "И в последние секунды я притягиваю её голову к себе."

# ch/harems/home/events/home_harem_samantha.rpy:4047
translate russian tv_bj_bree_samantha_sasha_129c2103:
    "Она удивлена и открывает рот, собираясь что-то спросить."

# ch/harems/home/events/home_harem_samantha.rpy:4049
translate russian tv_bj_bree_samantha_sasha_31167fb1:
    "Но мой член тут же проскальзывает ей в рот."

# ch/harems/home/events/home_harem_samantha.rpy:4050
translate russian tv_bj_bree_samantha_sasha_4b8d6fb5:
    "[lssb_homesam.bree_name()] закрывает глаза, когда я начинаю терять над собой контроль."

# ch/harems/home/events/home_harem_samantha.rpy:4051
translate russian tv_bj_bree_samantha_sasha_a68d8bba:
    "И когда я кончаю, она уже, похоже, снова владеет ситуацией."

# ch/harems/home/events/home_harem_samantha.rpy:4053
translate russian tv_bj_bree_samantha_sasha_dad66c84:
    "Потому что справляется как настоящая профессионалка, без труда всё проглатывая."

# ch/harems/home/events/home_harem_samantha.rpy:4054
translate russian tv_bj_bree_samantha_sasha_7d825231:
    "Сэм и Саша наблюдают за происходящим."

# ch/harems/home/events/home_harem_samantha.rpy:4055
translate russian tv_bj_bree_samantha_sasha_6c5a8a65:
    "И я уверен, что вижу в их глазах разочарование и ревность."

# ch/harems/home/events/home_harem_samantha.rpy:4056
translate russian tv_bj_bree_samantha_sasha_383a5eea:
    "Я этого не хотел, но благодарен, что они предпочитают не подавать виду."

# ch/harems/home/events/home_harem_samantha.rpy:4058
translate russian tv_bj_bree_samantha_sasha_4eca340c_1:
    "Не знаю, что в итоге определяет мой выбор."

# ch/harems/home/events/home_harem_samantha.rpy:4059
translate russian tv_bj_bree_samantha_sasha_2654fa45:
    "Меня просто неудержимо тянет к Сэм."

# ch/harems/home/events/home_harem_samantha.rpy:4060
translate russian tv_bj_bree_samantha_sasha_f0b6746c_1:
    "И в последние секунды я притягиваю её голову к себе."

# ch/harems/home/events/home_harem_samantha.rpy:4061
translate russian tv_bj_bree_samantha_sasha_129c2103_1:
    "Она удивлена и открывает рот, собираясь что-то спросить."

# ch/harems/home/events/home_harem_samantha.rpy:4063
translate russian tv_bj_bree_samantha_sasha_31167fb1_1:
