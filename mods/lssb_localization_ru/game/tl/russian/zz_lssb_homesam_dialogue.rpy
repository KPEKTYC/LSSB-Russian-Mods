# ch/harems/home/events/home_harem_samantha.rpy:1047
translate russian introduce_sam_to_girls_eabb2c6c:
    sasha.say "Чем больше, тем веселее, Сэм."

# ch/harems/home/events/home_harem_samantha.rpy:1049
translate russian introduce_sam_to_girls_1775b8b4:
