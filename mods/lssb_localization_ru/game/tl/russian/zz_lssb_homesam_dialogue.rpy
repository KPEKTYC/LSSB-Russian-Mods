# ch/harems/home/events/home_harem_samantha.rpy:1311
translate russian lesbian_sex_bree_sam_8a464a9e:
    bree.say "Ох... о да..."

# ch/harems/home/events/home_harem_samantha.rpy:1312
translate russian lesbian_sex_bree_sam_71367e20:
