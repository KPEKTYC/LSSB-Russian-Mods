# ch/harems/home/events/home_harem_samantha.rpy:1313
translate russian lesbian_sex_bree_sam_42eb65f7:
    "Услышав, как [lssb_homesam.bree_name()] признаётся в этом, Саманта лукаво смеётся."

# ch/harems/home/events/home_harem_samantha.rpy:1314
translate russian lesbian_sex_bree_sam_6356eeab:
