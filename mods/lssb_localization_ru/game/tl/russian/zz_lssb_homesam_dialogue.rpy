# ch/harems/home/events/home_harem_samantha.rpy:1232
translate russian lesbian_sex_bree_sam_744d8354:
    "Зрению нужна секунда, чтобы приспособиться."

# ch/harems/home/events/home_harem_samantha.rpy:1233
translate russian lesbian_sex_bree_sam_7fa78f96:
    "Затем я различаю знакомую обстановку спальни, в которой живёт [lssb_homesam.bree_name()]."

# ch/harems/home/events/home_harem_samantha.rpy:1235
translate russian lesbian_sex_bree_sam_1b6db62c:
    "О... ого!"

# ch/harems/home/events/home_harem_samantha.rpy:1236
translate russian lesbian_sex_bree_sam_d0b6caaa:
    "Беру слова назад: сейчас там творится кое-что совсем непривычное!"

# ch/harems/home/events/home_harem_samantha.rpy:1237
translate russian lesbian_sex_bree_sam_353577d7:
    "Сэм действительно там."

# ch/harems/home/events/home_harem_samantha.rpy:1238
translate russian lesbian_sex_bree_sam_08f08fe0:
    "Более того, её я вижу первой."

# ch/harems/home/events/home_harem_samantha.rpy:1239
translate russian lesbian_sex_bree_sam_e412828b:
    "Смущает меня лишь то, как много я могу разглядеть."

# ch/harems/home/events/home_harem_samantha.rpy:1240
translate russian lesbian_sex_bree_sam_9afc450c:
    "Потому что она совершенно голая!"

# ch/harems/home/events/home_harem_samantha.rpy:1241
translate russian lesbian_sex_bree_sam_5b847c8c:
    "Ничего странного, говорю я себе."

# ch/harems/home/events/home_harem_samantha.rpy:1242
translate russian lesbian_sex_bree_sam_94c5fd79:
