# ch/harems/home/events/home_harem_samantha.rpy:1038
translate russian introduce_sam_to_girls_b62d4b3d:
    "И я невольно начинаю чувствовать себя куском мяса!"

# ch/harems/home/events/home_harem_samantha.rpy:1041
translate russian introduce_sam_to_girls_b50ac598:
    mike.say "Мы не просто не против, Кексик."

# ch/harems/home/events/home_harem_samantha.rpy:1043
translate russian introduce_sam_to_girls_f6b45e2d:
    mike.say "Мы не просто не против, Сэм."

# ch/harems/home/events/home_harem_samantha.rpy:1044
translate russian introduce_sam_to_girls_8216fd49:
    mike.say "Видишь ли, мы всё обсудили."

# ch/harems/home/events/home_harem_samantha.rpy:1045
translate russian introduce_sam_to_girls_54c1612b:
