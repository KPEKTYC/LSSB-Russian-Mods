# ch/harems/home/events/home_harem_samantha.rpy:933
translate russian introduce_sam_to_girls_be6d6b74:
    mike.say "О, и Минами, конечно!"

# ch/harems/home/events/home_harem_samantha.rpy:935
translate russian introduce_sam_to_girls_8d846f78:
    sasha.say "Не волнуйся, Сэм."

# ch/harems/home/events/home_harem_samantha.rpy:936
translate russian introduce_sam_to_girls_a1dfe24e:
