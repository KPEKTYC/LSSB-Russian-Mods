# ch/harems/home/events/home_harem_samantha.rpy:1620
translate russian sexual_tension_sam_sasha_e4476ebc:
    samantha.say "Скучной?"

# ch/harems/home/events/home_harem_samantha.rpy:1622
translate russian sexual_tension_sam_sasha_06e8adca:
