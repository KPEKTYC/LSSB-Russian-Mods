# ch/harems/home/events/home_harem_samantha.rpy:3382
translate russian samantha_sasha_pregnant_showdown_abcdcedc_1:
    "Похоже, я только что понял, кого из них на самом деле люблю сильнее."

# ch/harems/home/events/home_harem_samantha.rpy:3386
translate russian samantha_sasha_pregnant_showdown_1dce1639_1:
    "Сэм и Саша всё ещё смотрят на меня так, словно хотят убить."

# ch/harems/home/events/home_harem_samantha.rpy:3387
translate russian samantha_sasha_pregnant_showdown_1d776bfd:
