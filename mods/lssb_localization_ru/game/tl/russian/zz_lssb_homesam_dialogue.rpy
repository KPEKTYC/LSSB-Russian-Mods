# ch/harems/home/events/home_harem_samantha.rpy:1631
translate russian sexual_tension_sam_sasha_e00845ba:
    samantha.say "Крашеные волосы, кожаная куртка — всё как положено!"

# ch/harems/home/events/home_harem_samantha.rpy:1633
