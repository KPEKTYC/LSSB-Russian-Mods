# ch/harems/home/events/home_harem_samantha.rpy:968
translate russian introduce_sam_to_girls_8007ae3e:
    "Теперь Сэм уже откровенно таращится на меня, пытаясь понять, во что ввязалась."

# ch/harems/home/events/home_harem_samantha.rpy:969
translate russian introduce_sam_to_girls_bb492c04:
