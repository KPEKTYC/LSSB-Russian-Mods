# ch/harems/home/events/home_harem_samantha.rpy:1243
translate russian lesbian_sex_bree_sam_f77170e8:
    "Но тут на кровати что-то шевелится, и я перевожу взгляд туда."

# ch/harems/home/events/home_harem_samantha.rpy:1244
translate russian lesbian_sex_bree_sam_122c454e:
    "Это [lssb_homesam.bree_name()]... и она тоже голая!"

# ch/harems/home/events/home_harem_samantha.rpy:1245
translate russian lesbian_sex_bree_sam_fa6df7f4:
    "[lssb_homesam.bree_name()] просто лежит на кровати и смотрит, как Сэм подходит к ней."

# ch/harems/home/events/home_harem_samantha.rpy:1246
translate russian lesbian_sex_bree_sam_1d27d90d:
    "Я сглатываю и начинаю потеть, поняв, за чем наблюдаю."

# ch/harems/home/events/home_harem_samantha.rpy:1247
translate russian lesbian_sex_bree_sam_e45b1517:
