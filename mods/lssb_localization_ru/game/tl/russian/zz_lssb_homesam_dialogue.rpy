# ch/harems/home/events/home_harem_samantha.rpy:946
translate russian introduce_sam_to_girls_2b428996:
    samantha.say "Будто вы знаете обо мне гораздо больше, чем я о вас!"

# ch/harems/home/events/home_harem_samantha.rpy:947
translate russian introduce_sam_to_girls_56111dad:
    sasha.say "Ну, так бывает, когда живёшь под одной крышей."

# ch/harems/home/events/home_harem_samantha.rpy:948
