# ch/harems/home/events/home_harem_samantha.rpy:1274
translate russian lesbian_sex_bree_sam_745ab989:
    "Она смотрит на Сэм снизу вверх, словно поровну испытывает страх и возбуждение."

# ch/harems/home/events/home_harem_samantha.rpy:1275
translate russian lesbian_sex_bree_sam_8b472a4e:
