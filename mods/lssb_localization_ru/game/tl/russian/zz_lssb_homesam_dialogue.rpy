# ch/harems/home/events/home_harem_samantha.rpy:1864
translate russian sexual_tension_sam_minami_e3563493:
    minami.say "Прости, Сэм."

# ch/harems/home/events/home_harem_samantha.rpy:1865
translate russian sexual_tension_sam_minami_04ff7134:
