# ch/harems/home/events/home_harem_samantha.rpy:1063
translate russian introduce_sam_to_girls_608c1c3f:
    "Сэм смотрит мне в глаза и улыбается, словно ответ очевиден."

# ch/harems/home/events/home_harem_samantha.rpy:1064
translate russian introduce_sam_to_girls_1228b0df:
    samantha.say "Ну, разве я злюсь, швыряюсь вещами или выбегаю отсюда в ярости?"

# ch/harems/home/events/home_harem_samantha.rpy:1066
translate russian introduce_sam_to_girls_b5e4a8aa:
