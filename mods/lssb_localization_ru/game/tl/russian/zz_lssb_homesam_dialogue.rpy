# ch/harems/home/events/home_harem_samantha.rpy:1656
translate russian sexual_tension_sam_sasha_26122ec3:
    "Кажется, моё появление немного разрядило обстановку."

# ch/harems/home/events/home_harem_samantha.rpy:1657
translate russian sexual_tension_sam_sasha_ccd97cc5:
    "Поэтому я решаю подыграть их оправданиям."

# ch/harems/home/events/home_harem_samantha.rpy:1658
translate russian sexual_tension_sam_sasha_e2ae3523:
    mike.say "Я слышал что-то про крашеные волосы и кожаные куртки?"

# ch/harems/home/events/home_harem_samantha.rpy:1660
translate russian sexual_tension_sam_sasha_01c0d955:
    mike.say "И что раньше ты увлекалась роком, Кексик?"

# ch/harems/home/events/home_harem_samantha.rpy:1662
translate russian sexual_tension_sam_sasha_bcef0f9d:
    mike.say "И что раньше ты увлекалась роком, Сэм?"

# ch/harems/home/events/home_harem_samantha.rpy:1663
translate russian sexual_tension_sam_sasha_8aa8d395:
