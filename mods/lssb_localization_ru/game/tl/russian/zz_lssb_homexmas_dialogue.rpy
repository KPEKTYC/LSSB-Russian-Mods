# ch/harems/home/events/home_harem_xmas_party.rpy:757
translate russian xmas_party_presents_b4283596:
    sasha.say "С ней ведь будет гораздо легче их находить?"

# ch/harems/home/events/home_harem_xmas_party.rpy:758
translate russian xmas_party_presents_99deabc4:
    mike.say "Да, Саша, наверное!"

# ch/harems/home/events/home_harem_xmas_party.rpy:759
translate russian xmas_party_presents_14471f5d:
    "Я тут же беру свой подарок для Саши."

# ch/harems/home/events/home_harem_xmas_party.rpy:760
translate russian xmas_party_presents_081f7231:
    "С улыбкой протягиваю его ей."

# ch/harems/home/events/home_harem_xmas_party.rpy:762
translate russian xmas_party_presents_ddba348e:
    "И кивком предлагаю взять и разорвать упаковку."

# ch/harems/home/events/home_harem_xmas_party.rpy:766
translate russian xmas_party_presents_592a782c:
    sasha.say "О да..."

# ch/harems/home/events/home_harem_xmas_party.rpy:767
translate russian xmas_party_presents_faa71165:
    sasha.say "Не терпится узнать, что там!"

# ch/harems/home/events/home_harem_xmas_party.rpy:768
translate russian xmas_party_presents_d574882e:
    "Саша срывает обёртку и поднимает подарок."

# ch/harems/home/events/home_harem_xmas_party.rpy:769
translate russian xmas_party_presents_5f0a5345:
    "Я надеялся, что она улыбнётся, а может, даже засмеётся."

# ch/harems/home/events/home_harem_xmas_party.rpy:771
translate russian xmas_party_presents_a600aec1:
    "Но она лишь недоумевает."

# ch/harems/home/events/home_harem_xmas_party.rpy:772
translate russian xmas_party_presents_1e577b2a:
    sasha.say "А?!"

# ch/harems/home/events/home_harem_xmas_party.rpy:773
translate russian xmas_party_presents_328713b7:
    sasha.say "Зачем ты купил мне кучу берушей?"

# ch/harems/home/events/home_harem_xmas_party.rpy:774
translate russian xmas_party_presents_3c22c6b8:
    mike.say "На время твоей игры на гитаре, Саша."

# ch/harems/home/events/home_harem_xmas_party.rpy:777
translate russian xmas_party_presents_f505d567:
    sasha.say "Но мне же нужно слышать, как я играю!"

# ch/harems/home/events/home_harem_xmas_party.rpy:778
translate russian xmas_party_presents_4c938691:
    mike.say "Знаю, но остальным-то незачем!"

# ch/harems/home/events/home_harem_xmas_party.rpy:779
translate russian xmas_party_presents_e91ff9d4:
    mike.say "Ты должна раздать их нам!"

# ch/harems/home/events/home_harem_xmas_party.rpy:781
translate russian xmas_party_presents_23d61cba:
    "Саша сверлит меня взглядом и недоверчиво качает головой."

# ch/harems/home/events/home_harem_xmas_party.rpy:782
translate russian xmas_party_presents_6dfff96f:
    "А я могу только виновато улыбнуться, съёживаясь под её взглядом."

# ch/harems/home/events/home_harem_xmas_party.rpy:785
translate russian xmas_party_presents_592a782c_1:
    sasha.say "О да..."

# ch/harems/home/events/home_harem_xmas_party.rpy:786
translate russian xmas_party_presents_faa71165_1:
    sasha.say "Не терпится узнать, что там!"

# ch/harems/home/events/home_harem_xmas_party.rpy:787
translate russian xmas_party_presents_d574882e_1:
    "Саша срывает обёртку и поднимает подарок."

# ch/harems/home/events/home_harem_xmas_party.rpy:788
translate russian xmas_party_presents_03f5b5b2:
    "За ручку она держит точную миниатюрную копию усилителя."

# ch/harems/home/events/home_harem_xmas_party.rpy:791
translate russian xmas_party_presents_1da8e856:
    sasha.say "Ого..."

# ch/harems/home/events/home_harem_xmas_party.rpy:792
translate russian xmas_party_presents_997967c2:
    sasha.say "Что это такое?"

# ch/harems/home/events/home_harem_xmas_party.rpy:793
translate russian xmas_party_presents_b7c4fd8b:
    sasha.say "Макет или что-то вроде?"

# ch/harems/home/events/home_harem_xmas_party.rpy:794
translate russian xmas_party_presents_1e017a00:
    mike.say "Нет, Саша, это настоящий усилитель."

# ch/harems/home/events/home_harem_xmas_party.rpy:795
translate russian xmas_party_presents_2ac2c40b:
    mike.say "Только маленький, чтобы можно было брать куда угодно!"

# ch/harems/home/events/home_harem_xmas_party.rpy:799
translate russian xmas_party_presents_36c8510e:
    sasha.say "Значит, я и репетировать смогу где угодно!"

# ch/harems/home/events/home_harem_xmas_party.rpy:800
translate russian xmas_party_presents_5e0586c6:
    mike.say "Именно!"

# ch/harems/home/events/home_harem_xmas_party.rpy:802
translate russian xmas_party_presents_24a95ecb:
    "Сейчас мы с Сашей оба сияем."

# ch/harems/home/events/home_harem_xmas_party.rpy:803
translate russian xmas_party_presents_08adb433:
    "Но я вижу, что не все в комнате разделяют нашу радость."

# ch/harems/home/events/home_harem_xmas_party.rpy:804
translate russian xmas_party_presents_5252aa08:
    "Их можно понять: всем известно, как громко Саша репетирует."

# ch/harems/home/events/home_harem_xmas_party.rpy:805
translate russian xmas_party_presents_67cf2241:
    "Но мне так приятно её одобрение, что на остальное плевать!"

# ch/harems/home/events/home_harem_xmas_party.rpy:810
translate russian xmas_party_presents_c1be5994:
    lexi.say "Держи, [lssb_common.hero_name()]."

# ch/harems/home/events/home_harem_xmas_party.rpy:811
translate russian xmas_party_presents_488257a3:
    lexi.say "Надеюсь, тебе понравится!"

# ch/harems/home/events/home_harem_xmas_party.rpy:812
translate russian xmas_party_presents_b5319029:
    "Лекси вручает мне на удивление аккуратно завёрнутый подарок."

# ch/harems/home/events/home_harem_xmas_party.rpy:813
translate russian xmas_party_presents_08f3d034:
    "И пристально наблюдает, как я беру его и начинаю рвать бумагу."

# ch/harems/home/events/home_harem_xmas_party.rpy:814
translate russian xmas_party_presents_aac030a9:
    "Кажется, ей очень хочется увидеть мою реакцию."

# ch/harems/home/events/home_harem_xmas_party.rpy:815
translate russian xmas_party_presents_ecd2863c:
    "Поэтому я старательно улыбаюсь и показываю, как мне интересно, что внутри."

# ch/harems/home/events/home_harem_xmas_party.rpy:816
translate russian xmas_party_presents_da28d76e:
    mike.say "Спасибо, Лекси."

# ch/harems/home/events/home_harem_xmas_party.rpy:817
translate russian xmas_party_presents_8ca6167e:
    mike.say "Очень мило с твоей стороны!"

# ch/harems/home/events/home_harem_xmas_party.rpy:819
translate russian xmas_party_presents_b52d14f6:
    "Лекси кивает и улыбается в ответ, побуждая поскорее открыть подарок."

# ch/harems/home/events/home_harem_xmas_party.rpy:822
translate russian xmas_party_presents_2488d296:
    "То, что оказывается под обёрткой, меня немало озадачивает."

# ch/harems/home/events/home_harem_xmas_party.rpy:823
translate russian xmas_party_presents_47fa5c9e:
    "Похоже на стопку бумажек или тонких картонок."

# ch/harems/home/events/home_harem_xmas_party.rpy:824
translate russian xmas_party_presents_e27f2ab9:
    "Каждая примерно с кредитную карту."

# ch/harems/home/events/home_harem_xmas_party.rpy:825
translate russian xmas_party_presents_68f2bef7:
    "В полном недоумении я поднимаю взгляд на Лекси."

# ch/harems/home/events/home_harem_xmas_party.rpy:827
translate russian xmas_party_presents_3ed0215f:
    lexi.say "Прочитай, дурень!"

# ch/harems/home/events/home_harem_xmas_party.rpy:828
translate russian xmas_party_presents_10a85229:
    lexi.say "Прочитай, что там написано!"

# ch/harems/home/events/home_harem_xmas_party.rpy:829
translate russian xmas_party_presents_61ecbe2b:
    "Я слушаюсь и вижу, что на всех одно и то же."

# ch/harems/home/events/home_harem_xmas_party.rpy:830
translate russian xmas_party_presents_2247c9cb:
    "Надпись сделана чёрными чернилами, и я узнаю характерный почерк Лекси."

# ch/harems/home/events/home_harem_xmas_party.rpy:831
translate russian xmas_party_presents_389945d6:
    mike.say "«Можно обменять на любые сексуальные услуги»!"

# ch/harems/home/events/home_harem_xmas_party.rpy:833
translate russian xmas_party_presents_dbf3bfba:
    lexi.say "Тс-с!"

# ch/harems/home/events/home_harem_xmas_party.rpy:834
translate russian xmas_party_presents_28a976e3:
    lexi.say "Не кричи на весь дом!"

# ch/harems/home/events/home_harem_xmas_party.rpy:836
translate russian xmas_party_presents_f76091c4:
    lexi.say "Это купоны на секс. Со мной, понял?"

# ch/harems/home/events/home_harem_xmas_party.rpy:837
translate russian xmas_party_presents_b0b7a752:
    lexi.say "Предъявляешь такую штуку — и я делаю всё, что захочешь!"

# ch/harems/home/events/home_harem_xmas_party.rpy:839
translate russian xmas_party_presents_b8c04997:
    "Я киваю и торопливо прячу купоны в карман."

# ch/harems/home/events/home_harem_xmas_party.rpy:840
translate russian xmas_party_presents_72645f70:
    "Но уже думаю, о чём смогу попросить Лекси."

# ch/harems/home/events/home_harem_xmas_party.rpy:842
translate russian xmas_party_presents_c90ea74b:
    "Я быстро понимаю, что внутри что-то твёрдое."

# ch/harems/home/events/home_harem_xmas_party.rpy:843
translate russian xmas_party_presents_93efbdd7:
    "А когда переворачиваю подарок в руках, чувствую, как меняется распределение веса."

# ch/harems/home/events/home_harem_xmas_party.rpy:844
translate russian xmas_party_presents_32452fc0:
    "Значит, это может быть только бутылка с жидкостью."

# ch/harems/home/events/home_harem_xmas_party.rpy:845
translate russian xmas_party_presents_3318a14d:
    "И действительно, сняв обёртку, я нахожу бутылку текилы."

# ch/harems/home/events/home_harem_xmas_party.rpy:846
translate russian xmas_party_presents_043db8ab:
    mike.say "Ещё раз спасибо, Лекси."

# ch/harems/home/events/home_harem_xmas_party.rpy:847
translate russian xmas_party_presents_dfe380df:
    mike.say "Эту марку текилы я ещё не пробовал!"

# ch/harems/home/events/home_harem_xmas_party.rpy:848
translate russian xmas_party_presents_5ee9546c:
    "Вообще-то я никогда не был большим любителем текилы."

# ch/harems/home/events/home_harem_xmas_party.rpy:849
translate russian xmas_party_presents_de348356:
    "Но сказать это Лекси было бы неблагодарно, поэтому я молчу."

# ch/harems/home/events/home_harem_xmas_party.rpy:851
translate russian xmas_party_presents_b5b246a4:
    lexi.say "Она довольно хорошая."

# ch/harems/home/events/home_harem_xmas_party.rpy:852
translate russian xmas_party_presents_8ec04b71:
    lexi.say "Дэнни постоянно её пил..."

# ch/harems/home/events/home_harem_xmas_party.rpy:854
translate russian xmas_party_presents_1e896170:
    "Упомянув своего жестокого бывшего, Лекси замолкает."

# ch/harems/home/events/home_harem_xmas_party.rpy:855
translate russian xmas_party_presents_95e9cd15:
    "Похоже, нахлынули неприятные воспоминания."

# ch/harems/home/events/home_harem_xmas_party.rpy:856
translate russian xmas_party_presents_b1954371:
    mike.say "Мы можем выпить её вместе, Лекси."

# ch/harems/home/events/home_harem_xmas_party.rpy:857
translate russian xmas_party_presents_5b58e222:
    mike.say "Только ты и я."

# ch/harems/home/events/home_harem_xmas_party.rpy:858
translate russian xmas_party_presents_3b51fb6b:
    mike.say "Как тебе идея?"

# ch/harems/home/events/home_harem_xmas_party.rpy:860
translate russian xmas_party_presents_8d4550cb:
    "Лекси, кажется, немного оживляется."

# ch/harems/home/events/home_harem_xmas_party.rpy:861
translate russian xmas_party_presents_8772ba11:
    "Она кивает и улыбается, словно уже ждёт этого момента."

# ch/harems/home/events/home_harem_xmas_party.rpy:862
translate russian xmas_party_presents_ea18f45f:
    "Теперь моя очередь взять подарок из-под ёлки и вручить его Лекси."

# ch/harems/home/events/home_harem_xmas_party.rpy:864
translate russian xmas_party_presents_a6e2792d:
    "Она нетерпеливо принимает его и сразу начинает рвать бумагу."

# ch/harems/home/events/home_harem_xmas_party.rpy:865
translate russian xmas_party_presents_7906d7ad:
    "Я улыбаюсь и киваю, надеясь, что мой подарок ей понравится."

# ch/harems/home/events/home_harem_xmas_party.rpy:868
translate russian xmas_party_presents_64337a4d:
    "Лекси набрасывается на обёртку так, будто от этого зависит её жизнь."

# ch/harems/home/events/home_harem_xmas_party.rpy:869
translate russian xmas_party_presents_bc614a9b:
    "И через пару секунд добирается до содержимого."

# ch/harems/home/events/home_harem_xmas_party.rpy:870
translate russian xmas_party_presents_1a96f8b3:
    "Но тут останавливается и хмурится, глядя на него."

# ch/harems/home/events/home_harem_xmas_party.rpy:872
translate russian xmas_party_presents_43309faa:
    lexi.say "А?!"

# ch/harems/home/events/home_harem_xmas_party.rpy:873
translate russian xmas_party_presents_e1b8caeb:
    lexi.say "Это... это вязаная одежда?"

# ch/harems/home/events/home_harem_xmas_party.rpy:874
translate russian xmas_party_presents_8037b235:
    "Я выдавливаю слабую улыбку."

# ch/harems/home/events/home_harem_xmas_party.rpy:875
translate russian xmas_party_presents_beee01bb:
    "Похоже, я облажался."

# ch/harems/home/events/home_harem_xmas_party.rpy:876
translate russian xmas_party_presents_5e4b0bd9:
    "Но, может быть, ещё удастся спасти положение."

# ch/harems/home/events/home_harem_xmas_party.rpy:877
translate russian xmas_party_presents_8e309fb7:
    mike.say "Это кардиган, Лекси."

# ch/harems/home/events/home_harem_xmas_party.rpy:878
translate russian xmas_party_presents_a7acc068:
    mike.say "Чтобы зимой тебе было тепло и уютно."

# ch/harems/home/events/home_harem_xmas_party.rpy:879
translate russian xmas_party_presents_b52548c2:
    mike.say "Большая часть твоей одежды довольно открытая!"

# ch/harems/home/events/home_harem_xmas_party.rpy:881
translate russian xmas_party_presents_280a2ef9:
    "Лекси смотрит на меня, прищурившись."

# ch/harems/home/events/home_harem_xmas_party.rpy:882
translate russian xmas_party_presents_84802bd9:
    "А я изо всех сил стараюсь смотреть в другую сторону."

# ch/harems/home/events/home_harem_xmas_party.rpy:884
translate russian xmas_party_presents_64337a4d_1:
    "Лекси набрасывается на обёртку так, будто от этого зависит её жизнь."

# ch/harems/home/events/home_harem_xmas_party.rpy:885
translate russian xmas_party_presents_bc614a9b_1:
    "И через пару секунд добирается до содержимого."

# ch/harems/home/events/home_harem_xmas_party.rpy:886
translate russian xmas_party_presents_253e2405:
    "Но тут останавливается и улыбается, глядя на него."

# ch/harems/home/events/home_harem_xmas_party.rpy:888
translate russian xmas_party_presents_41df6083:
    lexi.say "Это то, о чём я думаю?"

# ch/harems/home/events/home_harem_xmas_party.rpy:889
translate russian xmas_party_presents_eab06f16:
    lexi.say "Рождественские чулки?"

# ch/harems/home/events/home_harem_xmas_party.rpy:890
translate russian xmas_party_presents_18172540:
    "Лекси поднимает эти самые чулки."

# ch/harems/home/events/home_harem_xmas_party.rpy:891
translate russian xmas_party_presents_cb0075ad:
    "Они на резинках, в красно-белую полоску, как леденцы-трости."

# ch/harems/home/events/home_harem_xmas_party.rpy:892
translate russian xmas_party_presents_ba33d261:
    mike.say "Ну, я собирался подарить тебе что-нибудь тёплое."

# ch/harems/home/events/home_harem_xmas_party.rpy:893
translate russian xmas_party_presents_477a17da:
    mike.say "Но подумал, что тебе такое вряд ли понравится!"

# ch/harems/home/events/home_harem_xmas_party.rpy:896
translate russian xmas_party_presents_00914e6c:
    lexi.say "Правильно подумал!"

# ch/harems/home/events/home_harem_xmas_party.rpy:897
translate russian xmas_party_presents_01ea51db:
    "Лекси усмехается, наклоняется вперёд и целует меня в щёку."

# ch/harems/home/events/home_harem_xmas_party.rpy:898
translate russian xmas_party_presents_b4778f11:
    "Конечно, я мог бы подарить ей что-нибудь поскромнее и попрактичнее."

# ch/harems/home/events/home_harem_xmas_party.rpy:899
translate russian xmas_party_presents_a04e722b:
    "Но в это время года главное — радовать людей."

# ch/harems/home/events/home_harem_xmas_party.rpy:900
translate russian xmas_party_presents_a8a83235:
    "Так что к чёрту практичность."

# ch/harems/home/events/home_harem_xmas_party.rpy:905
translate russian xmas_party_presents_30c69f03:
    minami.say "С Рождеством, братик!"

# ch/harems/home/events/home_harem_xmas_party.rpy:906
translate russian xmas_party_presents_8d7dc49d:
    minami.say "Теперь открывай мой подарок, ладно?"

# ch/harems/home/events/home_harem_xmas_party.rpy:907
translate russian xmas_party_presents_13f36d29:
    minami.say "Давай, разворачивай!"

# ch/harems/home/events/home_harem_xmas_party.rpy:908
translate russian xmas_party_presents_b0c63c6d:
    "Я киваю и улыбаюсь, принимая подарок от Минами."

# ch/harems/home/events/home_harem_xmas_party.rpy:909
translate russian xmas_party_presents_8645f168:
    "В детстве по утрам на Рождество она всегда была такой же возбуждённой."

# ch/harems/home/events/home_harem_xmas_party.rpy:910
translate russian xmas_party_presents_04eae3cf:
    "И успокоить её можно только одним способом — сделать то, что она просит."

# ch/harems/home/events/home_harem_xmas_party.rpy:911
translate russian xmas_party_presents_89c5f82c:
    "Впрочем, мне и самому интересно, что она подарила!"

# ch/harems/home/events/home_harem_xmas_party.rpy:912
translate russian xmas_party_presents_34fc065d:
    mike.say "Ладно, Минами!"

# ch/harems/home/events/home_harem_xmas_party.rpy:913
translate russian xmas_party_presents_3b8e16ad:
    mike.say "Уже открываю!"

# ch/harems/home/events/home_harem_xmas_party.rpy:916
translate russian xmas_party_presents_041ca3cb:
    "Минами пристально смотрит, как я разрываю упаковку."

# ch/harems/home/events/home_harem_xmas_party.rpy:918
translate russian xmas_party_presents_0bcd06a7:
    "Я понятия не имею, что окажется под бумагой."

# ch/harems/home/events/home_harem_xmas_party.rpy:919
translate russian xmas_party_presents_d06de1b7:
    "Дома Минами никогда особо не покупала мне рождественских подарков."

# ch/harems/home/events/home_harem_xmas_party.rpy:920
translate russian xmas_party_presents_4a1f5de4:
    "Она была младше, и от неё этого не ждали."

# ch/harems/home/events/home_harem_xmas_party.rpy:922
translate russian xmas_party_presents_4771d224:
    mike.say "Ого..."

# ch/harems/home/events/home_harem_xmas_party.rpy:923
translate russian xmas_party_presents_3d0e1ba5:
    "Я поднимаю трусики и с интересом их разглядываю."

# ch/harems/home/events/home_harem_xmas_party.rpy:924
translate russian xmas_party_presents_c278903e:
    "Но Минами опускает мою руку, пока никто не заметил."

# ch/harems/home/events/home_harem_xmas_party.rpy:925
translate russian xmas_party_presents_f7ddd870:
    mike.say "А... а?!"

# ch/harems/home/events/home_harem_xmas_party.rpy:926
translate russian xmas_party_presents_3508ecc3:
    mike.say "Что такое, Минами?"

# ch/harems/home/events/home_harem_xmas_party.rpy:927
translate russian xmas_party_presents_8e6e0cf5:
    mike.say "Почему ты не хочешь, чтобы кто-то увидел трусики?"

# ch/harems/home/events/home_harem_xmas_party.rpy:929
translate russian xmas_party_presents_15cf18df:
    minami.say "Потому что это мои!"

# ch/harems/home/events/home_harem_xmas_party.rpy:930
translate russian xmas_party_presents_8cdd4cb7:
    minami.say "И я их носила!"

# ch/harems/home/events/home_harem_xmas_party.rpy:931
translate russian xmas_party_presents_cf730dc7:
    "Мне требуется мгновение, чтобы осознать услышанное."

# ch/harems/home/events/home_harem_xmas_party.rpy:932
translate russian xmas_party_presents_7c3c7536:
    "А осознав, я с трудом сдерживаю порыв немедленно их понюхать!"

# ch/harems/home/events/home_harem_xmas_party.rpy:933
translate russian xmas_party_presents_0c8766c8:
    mike.say "Н... но зачем..."

# ch/harems/home/events/home_harem_xmas_party.rpy:934
translate russian xmas_party_presents_4de8b045:
    minami.say "Чтобы ты всегда мог вспомнить, как пахнет моя киска!"

# ch/harems/home/events/home_harem_xmas_party.rpy:935
translate russian xmas_party_presents_dd7224ce:
    minami.say "Даже когда мы не вместе!"

# ch/harems/home/events/home_harem_xmas_party.rpy:936
translate russian xmas_party_presents_540c6c04:
    "Я улыбаюсь Минами в ответ и торопливо прячу подарок в карман."

# ch/harems/home/events/home_harem_xmas_party.rpy:938
translate russian xmas_party_presents_0bcd06a7_1:
    "Я понятия не имею, что окажется под бумагой."

# ch/harems/home/events/home_harem_xmas_party.rpy:939
translate russian xmas_party_presents_d06de1b7_1:
    "Дома Минами никогда особо не покупала мне рождественских подарков."

# ch/harems/home/events/home_harem_xmas_party.rpy:940
translate russian xmas_party_presents_4a1f5de4_1:
    "Она была младше, и от неё этого не ждали."

# ch/harems/home/events/home_harem_xmas_party.rpy:942
translate russian xmas_party_presents_4771d224_1:
    mike.say "Ого..."

# ch/harems/home/events/home_harem_xmas_party.rpy:943
translate russian xmas_party_presents_011eb893:
    "Я поднимаю за ручку большую кружку."

# ch/harems/home/events/home_harem_xmas_party.rpy:944
translate russian xmas_party_presents_4628fafa:
    "Обычная кружка, если не считать надписи «Лучшему братику»."

# ch/harems/home/events/home_harem_xmas_party.rpy:945
translate russian xmas_party_presents_5d04f8e6:
    minami.say "Тебе нравится, да?"

# ch/harems/home/events/home_harem_xmas_party.rpy:946
translate russian xmas_party_presents_8e232f34:
    minami.say "Ты пьёшь кофе и ты мой братик!"

# ch/harems/home/events/home_harem_xmas_party.rpy:947
translate russian xmas_party_presents_c922f379:
    minami.say "Значит, идеальный подарок, правда?"

# ch/harems/home/events/home_harem_xmas_party.rpy:948
translate russian xmas_party_presents_50242952:
    mike.say "Конечно, Минами, конечно."

# ch/harems/home/events/home_harem_xmas_party.rpy:949
translate russian xmas_party_presents_9b64ac31:
    mike.say "Лучший подарок на свете..."

# ch/harems/home/events/home_harem_xmas_party.rpy:950
translate russian xmas_party_presents_273391ee:
    "Я улыбаюсь и стараюсь звучать убедительно."

# ch/harems/home/events/home_harem_xmas_party.rpy:951
translate russian xmas_party_presents_e48a4029:
    "Похоже, получается: Минами счастливо сияет в ответ."

# ch/harems/home/events/home_harem_xmas_party.rpy:952
translate russian xmas_party_presents_e173cbf3:
    mike.say "Теперь моя очередь, Минами."

# ch/harems/home/events/home_harem_xmas_party.rpy:953
translate russian xmas_party_presents_f4ce4839:
    mike.say "Вот тебе подарок от меня!"

# ch/harems/home/events/home_harem_xmas_party.rpy:954
translate russian xmas_party_presents_8327b141:
    "Я достаю нужный свёрток из-под ёлки."

# ch/harems/home/events/home_harem_xmas_party.rpy:955
translate russian xmas_party_presents_4f3126a6:
    "И передаю его в нетерпеливые руки Минами."

# ch/harems/home/events/home_harem_xmas_party.rpy:959
translate russian xmas_party_presents_b1d89688:
    "Минами срывает упаковочную бумагу всего за пару секунд."

# ch/harems/home/events/home_harem_xmas_party.rpy:960
translate russian xmas_party_presents_88ced7e0:
    "Затем поднимает содержимое и внимательно его рассматривает."

# ch/harems/home/events/home_harem_xmas_party.rpy:962
translate russian xmas_party_presents_2490f0bc:
    "А потом смотрит мне прямо в глаза."

# ch/harems/home/events/home_harem_xmas_party.rpy:963
translate russian xmas_party_presents_f1785d84:
    minami.say "О, братик!"

# ch/harems/home/events/home_harem_xmas_party.rpy:964
translate russian xmas_party_presents_72f5639c:
    minami.say "Как ты догадался?!"

# ch/harems/home/events/home_harem_xmas_party.rpy:965
translate russian xmas_party_presents_a40e64c6:
    "Минами держит в руках изящные маленькие белые трусики."

# ch/harems/home/events/home_harem_xmas_party.rpy:966
translate russian xmas_party_presents_30ba89aa:
    "Для кого-то другого они, уверен, ничем не отличаются от любых белых трусиков."

# ch/harems/home/events/home_harem_xmas_party.rpy:967
translate russian xmas_party_presents_e9a3a0ce:
    "Но мы оба знаем: точно такие носит одна из любимых аниме-героинь Минами."

# ch/harems/home/events/home_harem_xmas_party.rpy:968
translate russian xmas_party_presents_ac51b393:
    mike.say "Я видел, как ты работаешь над этим костюмом, Минами."

# ch/harems/home/events/home_harem_xmas_party.rpy:969
translate russian xmas_party_presents_27523be7:
    mike.say "И помню, ты говорила, что никак не найдёшь подходящие трусики."

# ch/harems/home/events/home_harem_xmas_party.rpy:972
translate russian xmas_party_presents_e14a771a:
    minami.say "Они идеальны, братик!"

# ch/harems/home/events/home_harem_xmas_party.rpy:973
translate russian xmas_party_presents_756196fa:
    minami.say "Теперь я успею закончить костюм к Новому году."

# ch/harems/home/events/home_harem_xmas_party.rpy:974
translate russian xmas_party_presents_cd589531:
    minami.say "Думаю, ты заслужил награду."

# ch/harems/home/events/home_harem_xmas_party.rpy:976
translate russian xmas_party_presents_bd1d4d54:
    minami.say "Хочешь первым увидеть меня в нём?"

# ch/harems/home/events/home_harem_xmas_party.rpy:977
translate russian xmas_party_presents_9a115489:
    "Я киваю и улыбаюсь, уже представляя эту картину."

# ch/harems/home/events/home_harem_xmas_party.rpy:980
translate russian xmas_party_presents_b1d89688_1:
    "Минами срывает упаковочную бумагу всего за пару секунд."

# ch/harems/home/events/home_harem_xmas_party.rpy:981
translate russian xmas_party_presents_88ced7e0_1:
    "Затем поднимает содержимое и внимательно его рассматривает."

# ch/harems/home/events/home_harem_xmas_party.rpy:983
translate russian xmas_party_presents_2490f0bc_1:
    "А потом смотрит мне прямо в глаза."

# ch/harems/home/events/home_harem_xmas_party.rpy:984
translate russian xmas_party_presents_0a699be1:
    minami.say "Я... я не понимаю, братик."

# ch/harems/home/events/home_harem_xmas_party.rpy:985
translate russian xmas_party_presents_d9b57906:
    minami.say "Зачем ты купил мне такие уродливые трусы?"

# ch/harems/home/events/home_harem_xmas_party.rpy:986
translate russian xmas_party_presents_14748635:
    "Я смотрю на большие тёмно-синие трусы у неё в руках."

# ch/harems/home/events/home_harem_xmas_party.rpy:987
translate russian xmas_party_presents_2cd89bcc:
    "Затем пожимаю плечами и смотрю Минами прямо в глаза."

# ch/harems/home/events/home_harem_xmas_party.rpy:988
translate russian xmas_party_presents_1ef303b2:
    mike.say "Ты же всё время наряжаешься японской школьницей, Минами."

# ch/harems/home/events/home_harem_xmas_party.rpy:989
translate russian xmas_party_presents_2eb6d09e:
    mike.say "К этой форме полагается такое бельё."

# ch/harems/home/events/home_harem_xmas_party.rpy:990
translate russian xmas_party_presents_23483cfa:
    mike.say "Кажется, у тебя его нет, я никогда не видел тебя в таком."

# ch/harems/home/events/home_harem_xmas_party.rpy:993
translate russian xmas_party_presents_a197aa67:
    minami.say "Уф... не в этом дело, братик!"

# ch/harems/home/events/home_harem_xmas_party.rpy:994
translate russian xmas_party_presents_70fe2103:
    minami.say "Я не пытаюсь убедить людей, что я настоящая школьница!"

# ch/harems/home/events/home_harem_xmas_party.rpy:995
translate russian xmas_party_presents_570123f2:
    mike.say "Разве?"

# ch/harems/home/events/home_harem_xmas_party.rpy:996
translate russian xmas_party_presents_fe60ff08:
    "Минами что-то бормочет себе под нос."

# ch/harems/home/events/home_harem_xmas_party.rpy:997
translate russian xmas_party_presents_1287c983:
    "И с негодованием отворачивается от меня."

# ch/harems/home/events/home_harem_xmas_party.rpy:1002
translate russian xmas_party_presents_9cb1fe9a:
    samantha.say "С Рождеством, [lssb_common.hero_name()]!"

# ch/harems/home/events/home_harem_xmas_party.rpy:1003
translate russian xmas_party_presents_5f5a2a14:
    samantha.say "Надеюсь, тебе понравится мой подарок."

# ch/harems/home/events/home_harem_xmas_party.rpy:1004
translate russian xmas_party_presents_df451266:
    "Я едва не пропускаю момент, когда Сэм протягивает мне подарок."

# ch/harems/home/events/home_harem_xmas_party.rpy:1005
translate russian xmas_party_presents_dec60568:
    "Её улыбка такая милая и нежная, что почти гипнотизирует меня!"

# ch/harems/home/events/home_harem_xmas_party.rpy:1006
translate russian xmas_party_presents_3e78a25a:
    "Но я стараюсь прийти в себя и принять свёрток."

# ch/harems/home/events/home_harem_xmas_party.rpy:1008
translate russian xmas_party_presents_845ec4ef:
    mike.say "Ой, спасибо, Кексик!"

# ch/harems/home/events/home_harem_xmas_party.rpy:1010
translate russian xmas_party_presents_11ad088b:
    mike.say "Ой, спасибо, Сэм!"

# ch/harems/home/events/home_harem_xmas_party.rpy:1011
translate russian xmas_party_presents_f2da21dd:
    mike.say "Уверен, мне понравится."

# ch/harems/home/events/home_harem_xmas_party.rpy:1012
translate russian xmas_party_presents_cf7b129f:
    "Пока я разворачиваю подарок, улыбка Сэм становится ещё шире."

# ch/harems/home/events/home_harem_xmas_party.rpy:1013
translate russian xmas_party_presents_cc08a2c2:
    "А я всё гадаю, что же она мне подарила."

# ch/harems/home/events/home_harem_xmas_party.rpy:1016
translate russian xmas_party_presents_35a7fa75:
    "Сорвав остатки бумаги, я смотрю на содержимое."

# ch/harems/home/events/home_harem_xmas_party.rpy:1017
translate russian xmas_party_presents_62293b19:
    "Честно говоря, я не знал, чего ждать, но всё равно удивлён."

# ch/harems/home/events/home_harem_xmas_party.rpy:1019
translate russian xmas_party_presents_d0f3f08f:
    mike.say "Это твоя фотография..."

# ch/harems/home/events/home_harem_xmas_party.rpy:1020
translate russian xmas_party_presents_b620b764:
    mike.say "И ты на ней голая!"

# ch/harems/home/events/home_harem_xmas_party.rpy:1022
translate russian xmas_party_presents_d92698d6:
    "Сэм наклоняется и зажимает мне рот ладонью."

# ch/harems/home/events/home_harem_xmas_party.rpy:1023
translate russian xmas_party_presents_c44b9510:
    samantha.say "Тс-с!"

# ch/harems/home/events/home_harem_xmas_party.rpy:1024
translate russian xmas_party_presents_f7043a3a:
    samantha.say "Не объявляй на весь дом!"

# ch/harems/home/events/home_harem_xmas_party.rpy:1025
translate russian xmas_party_presents_92d41885:
    "Сэм ждёт, пока не убедится, что я взял себя в руки."

# ch/harems/home/events/home_harem_xmas_party.rpy:1027
translate russian xmas_party_presents_7762be57:
    "И лишь тогда убирает ладонь с моего рта."

# ch/harems/home/events/home_harem_xmas_party.rpy:1029
translate russian xmas_party_presents_47f6473f:
    mike.say "Ух ты, Кексик... потрясающе!"

# ch/harems/home/events/home_harem_xmas_party.rpy:1031
translate russian xmas_party_presents_c299e971:
    mike.say "Ух ты, Сэм... потрясающе!"

# ch/harems/home/events/home_harem_xmas_party.rpy:1032
translate russian xmas_party_presents_48dc2de2:
    samantha.say "Ну, я подумала, что у тебя нет моей фотографии."

# ch/harems/home/events/home_harem_xmas_party.rpy:1033
translate russian xmas_party_presents_530a4a25:
    samantha.say "А так сможешь смотреть на меня, когда захочешь."

# ch/harems/home/events/home_harem_xmas_party.rpy:1034
translate russian xmas_party_presents_25c70467:
    samantha.say "И заодно вспоминать, что мы значим друг для друга."

# ch/harems/home/events/home_harem_xmas_party.rpy:1038
translate russian xmas_party_presents_6cdf6093:
    "Сэм наклоняется и целует меня прямо в губы."

# ch/harems/home/events/home_harem_xmas_party.rpy:1039
translate russian xmas_party_presents_5ca75b56:
    "Я отвечаю на поцелуй, наслаждаясь каждым мгновением."

# ch/harems/home/events/home_harem_xmas_party.rpy:1043
translate russian xmas_party_presents_35a7fa75_1:
    "Сорвав остатки бумаги, я смотрю на содержимое."

# ch/harems/home/events/home_harem_xmas_party.rpy:1044
translate russian xmas_party_presents_62293b19_1:
    "Честно говоря, я не знал, чего ждать, но всё равно удивлён."

# ch/harems/home/events/home_harem_xmas_party.rpy:1046
translate russian xmas_party_presents_aa8f0616:
    mike.say "Это плюшевый мишка?!"

# ch/harems/home/events/home_harem_xmas_party.rpy:1048
translate russian xmas_party_presents_ac66915d:
    samantha.say "Ты всегда казался таким одиноким у себя в комнате."

# ch/harems/home/events/home_harem_xmas_party.rpy:1049
translate russian xmas_party_presents_4cad2009:
    samantha.say "Вот я и подумала: тебе не помешает компания в постели!"

# ch/harems/home/events/home_harem_xmas_party.rpy:1050
translate russian xmas_party_presents_9bd7ad59:
    "Я смотрю на Сэм, пытаясь кое-что понять."

# ch/harems/home/events/home_harem_xmas_party.rpy:1051
translate russian xmas_party_presents_01531e60:
    "Знает ли она, как сильно я в неё влюблён?"

# ch/harems/home/events/home_harem_xmas_party.rpy:1052
translate russian xmas_party_presents_49df6daf:
    "Или просто хочет сделать приятное человеку, которого считает другом?"

# ch/harems/home/events/home_harem_xmas_party.rpy:1053
translate russian xmas_party_presents_e0d359df:
    "В конце концов выбираю второй вариант."

# ch/harems/home/events/home_harem_xmas_party.rpy:1055
translate russian xmas_party_presents_9d17ed03:
