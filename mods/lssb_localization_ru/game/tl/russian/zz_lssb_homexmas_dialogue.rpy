# ch/harems/home/events/home_harem_xmas_party.rpy:63
translate russian home_xmas_party_missed_d554ffed:
    "Чёрт, я пропустил домашнюю рождественскую вечеринку. Девушки будут злиться."

# ch/harems/home/events/home_harem_xmas_party.rpy:70
translate russian home_xmas_party_cancelled_b4cd6b1f:
    "[lssb_homexmas.bree_name()] и Саша не смогут прийти на это Рождество."

# ch/harems/home/events/home_harem_xmas_party.rpy:72
translate russian home_xmas_party_cancelled_6cc1d057:
    "[lssb_homexmas.bree_name()] не сможет прийти на это Рождество."

# ch/harems/home/events/home_harem_xmas_party.rpy:74
translate russian home_xmas_party_cancelled_7c321cde:
    "Саша не сможет прийти на это Рождество."

# ch/harems/home/events/home_harem_xmas_party.rpy:75
translate russian home_xmas_party_cancelled_62fad47c:
    "Придётся отменить вечеринку."

# ch/harems/home/events/home_harem_xmas_party.rpy:93
translate russian xmas_party_snacks_0c500b89:
    "Обычно на праздники все разъезжаются к родственникам."

# ch/harems/home/events/home_harem_xmas_party.rpy:94
translate russian xmas_party_snacks_9c1da63f:
    "Поэтому дом либо пустует, либо кто-то встречает Рождество здесь в одиночестве."

# ch/harems/home/events/home_harem_xmas_party.rpy:95
translate russian xmas_party_snacks_01f98042:
    "Знаю, последнее звучит уныло, но со мной такое уже бывало, и это довольно приятно!"

# ch/harems/home/events/home_harem_xmas_party.rpy:96
translate russian xmas_party_snacks_ce172259:
    "Но в этом году так получилось, что все остаются дома, и мы решили устроить общую вечеринку."

# ch/harems/home/events/home_harem_xmas_party.rpy:97
translate russian xmas_party_snacks_2eaccdab:
    "Хотя я говорю «мы решили», никаких собраний жильцов или голосований я не припоминаю."

# ch/harems/home/events/home_harem_xmas_party.rpy:98
translate russian xmas_party_snacks_c412f0c1:
    "Кто-то просто заговорил об этом, и дальше всё покатилось как снежный ком."

# ch/harems/home/events/home_harem_xmas_party.rpy:99
translate russian xmas_party_snacks_068608a7:
    "Одна вызвалась приготовить одно блюдо к ужину, другая — следующее."

# ch/harems/home/events/home_harem_xmas_party.rpy:116
translate russian xmas_party_snacks_11913658:
    "И вот мы собираемся за столом, чтобы узнать, что нам приготовили!"

# ch/harems/home/events/home_harem_xmas_party.rpy:117
translate russian xmas_party_snacks_c9124a21:
    "Все по очереди спускаются из своих комнат, привлечённые запахом еды."

# ch/harems/home/events/home_harem_xmas_party.rpy:119
translate russian xmas_party_snacks_86494bac:
    bree.say "О-о, интересно, с чего мы начнём?"

# ch/harems/home/events/home_harem_xmas_party.rpy:121
translate russian xmas_party_snacks_193010f5:
    lexi.say "А где тарелки?"

# ch/harems/home/events/home_harem_xmas_party.rpy:122
translate russian xmas_party_snacks_c6f140ff:
    lexi.say "Я жрать хочу до смерти!"

# ch/harems/home/events/home_harem_xmas_party.rpy:124
translate russian xmas_party_snacks_ced5f98c:
    minami.say "Здесь НАМНОГО лучше, чем дома, братик."

# ch/harems/home/events/home_harem_xmas_party.rpy:125
translate russian xmas_party_snacks_f8c92292:
    minami.say "Мамы с папой нет, никто не заставит нас молиться перед едой!"

# ch/harems/home/events/home_harem_xmas_party.rpy:127
translate russian xmas_party_snacks_a743cb44:
    samantha.say "Хм... выглядит... интересно!"

# ch/harems/home/events/home_harem_xmas_party.rpy:129
translate russian xmas_party_snacks_ec0827ce:
    sasha.say "Хм... всё это выглядит очень... полезно!"

# ch/harems/home/events/home_harem_xmas_party.rpy:131
translate russian xmas_party_snacks_1714bd9a:
    "Я не знал, чего ждать, но расставленная передо мной еда выглядит потрясающе."

# ch/harems/home/events/home_harem_xmas_party.rpy:132
translate russian xmas_party_snacks_c17a6f14:
    "Сэм настояла на том, чтобы готовить закуски, и превзошла саму себя!"

# ch/harems/home/events/home_harem_xmas_party.rpy:133
translate russian xmas_party_snacks_872267e9:
    "Кажется, всё приготовлено вручную из натуральных продуктов, с вниманием к каждой мелочи."

# ch/harems/home/events/home_harem_xmas_party.rpy:134
translate russian xmas_party_snacks_e8ac15c9:
    "Честно говоря, я уже не помню, когда в последний раз видел такую полезную на вид еду."

# ch/harems/home/events/home_harem_xmas_party.rpy:135
translate russian xmas_party_snacks_363f718b:
    "И я не имею в виду, что она похожа на какие-нибудь странные диетические блюда."

# ch/harems/home/events/home_harem_xmas_party.rpy:136
translate russian xmas_party_snacks_0d7e3d92:
    "По виду и запаху всё должно быть невероятно вкусным!"

# ch/harems/home/events/home_harem_xmas_party.rpy:138
translate russian xmas_party_snacks_ef868577:
    mike.say "Ух ты, Кексик!"

# ch/harems/home/events/home_harem_xmas_party.rpy:140
translate russian xmas_party_snacks_798a9175:
    mike.say "Ух ты, Сэм!"

# ch/harems/home/events/home_harem_xmas_party.rpy:141
translate russian xmas_party_snacks_3e97adbb:
    mike.say "Выглядит потрясающе!"

# ch/harems/home/events/home_harem_xmas_party.rpy:142
translate russian xmas_party_snacks_abf11f77:
    mike.say "Где ты научилась так готовить?"

# ch/harems/home/events/home_harem_xmas_party.rpy:143
translate russian xmas_party_snacks_8c44a86d:
    "Сэм сияет, наслаждаясь похвалами, которыми я её осыпаю."

# ch/harems/home/events/home_harem_xmas_party.rpy:144
translate russian xmas_party_snacks_825a99e7:
    "Подавая плоды своих трудов, она выглядит настоящей богиней домашнего очага."

# ch/harems/home/events/home_harem_xmas_party.rpy:145
translate russian xmas_party_snacks_7f681f61:
    samantha.say "Ой, да ничего особенного!"

# ch/harems/home/events/home_harem_xmas_party.rpy:146
translate russian xmas_party_snacks_62e765c7:
    samantha.say "Просто несколько бабушкиных рецептов."

# ch/harems/home/events/home_harem_xmas_party.rpy:147
translate russian xmas_party_snacks_eaf16ed9:
    samantha.say "И для полноты картины ещё кое-что моего собственного изобретения."

# ch/harems/home/events/home_harem_xmas_party.rpy:148
translate russian xmas_party_snacks_ae1f9038:
    samantha.say "С натуральными продуктами это совсем несложно!"

# ch/harems/home/events/home_harem_xmas_party.rpy:149
translate russian xmas_party_snacks_ace251dc:
    "Я обвожу стол взглядом: тарелки есть у всех."

# ch/harems/home/events/home_harem_xmas_party.rpy:150
translate russian xmas_party_snacks_56a498cc:
    "Набивая рот едой, не все, похоже, слушают Сэм."

# ch/harems/home/events/home_harem_xmas_party.rpy:151
translate russian xmas_party_snacks_d83af6b2:
    "Но я старательно киваю на каждое её слово."

# ch/harems/home/events/home_harem_xmas_party.rpy:153
translate russian xmas_party_snacks_72ab6ee7:
    bree.say "Осторожно, эти штуки острые!"

# ch/harems/home/events/home_harem_xmas_party.rpy:155
translate russian xmas_party_snacks_db3b754e:
    lexi.say "А какие именно?"

# ch/harems/home/events/home_harem_xmas_party.rpy:156
translate russian xmas_party_snacks_c5580e5b:
    lexi.say "Дайте мне их побольше!"

# ch/harems/home/events/home_harem_xmas_party.rpy:158
translate russian xmas_party_snacks_3b34df61:
    minami.say "М-м-м... очень вкусно, Сэм!"

# ch/harems/home/events/home_harem_xmas_party.rpy:159
translate russian xmas_party_snacks_3b47864e:
    minami.say "Можно мне ещё добавки, пожалуйста?"

# ch/harems/home/events/home_harem_xmas_party.rpy:161
translate russian xmas_party_snacks_429d9fa2:
    sasha.say "Кажется, у меня аллергия процентов на девяносто всего этого!"

# ch/harems/home/events/home_harem_xmas_party.rpy:163
translate russian xmas_party_snacks_3038d307:
    "Когда Саша взялась готовить закуски, обещаний от неё было немало."

# ch/harems/home/events/home_harem_xmas_party.rpy:164
translate russian xmas_party_snacks_40ae2d9f:
    "Она сказала, что не просто справится, а ещё и в рекордные сроки."

# ch/harems/home/events/home_harem_xmas_party.rpy:165
translate russian xmas_party_snacks_88884562:
    "И стоит мне взглянуть на угощения, как я понимаю причину такой уверенности."

# ch/harems/home/events/home_harem_xmas_party.rpy:166
translate russian xmas_party_snacks_4e390f6f:
    "Да, еды на столе много, и выглядит она вполне съедобно."

# ch/harems/home/events/home_harem_xmas_party.rpy:167
translate russian xmas_party_snacks_e11aa293:
    "Но я не вижу ни одного продукта, который был бы не из банки или пакета!"

# ch/harems/home/events/home_harem_xmas_party.rpy:168
translate russian xmas_party_snacks_4515606d:
    "Мясные полуфабрикаты, плавленый сыр и все известные человечеству виды жира!"

# ch/harems/home/events/home_harem_xmas_party.rpy:169
translate russian xmas_party_snacks_3a0eab8d:
    "Она что, просто сгребла всё с полки супермаркета в тележку?!"

# ch/harems/home/events/home_harem_xmas_party.rpy:171
translate russian xmas_party_snacks_7315b0b4:
    mike.say "Ого, Саша..."

# ch/harems/home/events/home_harem_xmas_party.rpy:172
translate russian xmas_party_snacks_5816a7ba:
    mike.say "Даже не знаю, что сказать!"

# ch/harems/home/events/home_harem_xmas_party.rpy:173
translate russian xmas_party_snacks_86f94835:
    "Саша, похоже, принимает моё удивление за восхищение."

# ch/harems/home/events/home_harem_xmas_party.rpy:174
translate russian xmas_party_snacks_7bc99205:
    "Она ухмыляется и толкает меня локтем под рёбра."

# ch/harems/home/events/home_harem_xmas_party.rpy:175
translate russian xmas_party_snacks_13e26e18:
    sasha.say "Вот видишь, я тоже умею быть богиней домашнего очага!"

# ch/harems/home/events/home_harem_xmas_party.rpy:176
translate russian xmas_party_snacks_34146655:
    sasha.say "Главное — не слишком заморачиваться."

# ch/harems/home/events/home_harem_xmas_party.rpy:177
translate russian xmas_party_snacks_c37adfa4:
    sasha.say "Это всё ГОРАЗДО дешевле органической дряни."

# ch/harems/home/events/home_harem_xmas_party.rpy:178
translate russian xmas_party_snacks_0486118a:
    sasha.say "А большая часть ещё и ядерный взрыв переживёт!"

# ch/harems/home/events/home_harem_xmas_party.rpy:179
translate russian xmas_party_snacks_af5b271b:
    "Кстати о ядерных взрывах."

# ch/harems/home/events/home_harem_xmas_party.rpy:180
translate russian xmas_party_snacks_a06b0669:
    "После всей этой дряни мне стоит постараться первым занять туалет!"

# ch/harems/home/events/home_harem_xmas_party.rpy:181
translate russian xmas_party_snacks_ace251dc_1:
    "Я обвожу стол взглядом: тарелки есть у всех."

# ch/harems/home/events/home_harem_xmas_party.rpy:182
translate russian xmas_party_snacks_a8dfcafb:
    "Набивая рот едой, не все, похоже, слушают Сашу."

# ch/harems/home/events/home_harem_xmas_party.rpy:184
translate russian xmas_party_snacks_2212ca87:
    bree.say "Ух... вот это острота!"

# ch/harems/home/events/home_harem_xmas_party.rpy:185
translate russian xmas_party_snacks_bba71bc2:
    bree.say "Обычно я ем такое только во время игровых марафонов на Zbox!"

# ch/harems/home/events/home_harem_xmas_party.rpy:187
translate russian xmas_party_snacks_fc19ada4:
    lexi.say "Вот, это уже по-нашему!"

# ch/harems/home/events/home_harem_xmas_party.rpy:188
translate russian xmas_party_snacks_bd6496c7:
    lexi.say "В трейлерном парке я только этим и питалась!"

# ch/harems/home/events/home_harem_xmas_party.rpy:190
translate russian xmas_party_snacks_7a4ee174:
    minami.say "Ого, братик!"

# ch/harems/home/events/home_harem_xmas_party.rpy:191
translate russian xmas_party_snacks_d5641857:
    minami.say "Мама с папой с ума бы сошли, если бы увидели всё это!"

# ch/harems/home/events/home_harem_xmas_party.rpy:193
translate russian xmas_party_snacks_3304657f:
    samantha.say "Ох... господи, господи!"

# ch/harems/home/events/home_harem_xmas_party.rpy:194
translate russian xmas_party_snacks_58e32597:
    samantha.say "Сколько же тут всяких добавок?"

# ch/harems/home/events/home_harem_xmas_party.rpy:196
translate russian xmas_party_snacks_7a64f062:
    "Так странно, что Саши сегодня с нами нет."

# ch/harems/home/events/home_harem_xmas_party.rpy:197
translate russian xmas_party_snacks_b2548a92:
    "Мне всё кажется, что она вот-вот войдёт."

# ch/harems/home/events/home_harem_xmas_party.rpy:198
translate russian xmas_party_snacks_6412a838:
    "Я почти слышу её саркастические шутки обо всём этом."

# ch/harems/home/events/home_harem_xmas_party.rpy:199
translate russian xmas_party_snacks_7b7b9960:
    "Ну, как она поддразнивает нас за то, что мы с [lssb_homexmas.bree_name()] так увлеклись праздником."

# ch/harems/home/events/home_harem_xmas_party.rpy:200
translate russian xmas_party_snacks_1f633766:
    "Наверное, остаётся только поднять бокал в её память."

# ch/harems/home/events/home_harem_xmas_party.rpy:219
translate russian xmas_party_turkey_2fe263f1:
    "Когда с первым блюдом покончено и все закуски съедены, пора переходить к главному!"

# ch/harems/home/events/home_harem_xmas_party.rpy:220
translate russian xmas_party_turkey_a223be93:
    "То есть, разумеется, к главному блюду нашего домашнего праздничного ужина — индейке!"

# ch/harems/home/events/home_harem_xmas_party.rpy:221
translate russian xmas_party_turkey_ef478573:
    "На закуски все налегали от души, но до сытости, кажется, ещё далеко."

# ch/harems/home/events/home_harem_xmas_party.rpy:222
translate russian xmas_party_turkey_8c598040:
    "Наоборот, все словно затаили дыхание в ожидании индейки!"

# ch/harems/home/events/home_harem_xmas_party.rpy:223
translate russian xmas_party_turkey_2c222423:
    "Ну, по крайней мере, образно: мои соседки никогда не молчат."

# ch/harems/home/events/home_harem_xmas_party.rpy:226
translate russian xmas_party_turkey_931e7eb7:
    bree.say "Хм... пахнет очень неплохо, Лекси!"

# ch/harems/home/events/home_harem_xmas_party.rpy:227
translate russian xmas_party_turkey_f2b22620:
    bree.say "Но, как говорится, чтобы оценить пудинг, нужно его съесть."

# ch/harems/home/events/home_harem_xmas_party.rpy:229
translate russian xmas_party_turkey_abf1ffda:
    bree.say "Ну... индейку... ты понимаешь, о чём я!"

# ch/harems/home/events/home_harem_xmas_party.rpy:232
translate russian xmas_party_turkey_43606b7b:
    lexi.say "Ух ты... пахнет... эм..."

# ch/harems/home/events/home_harem_xmas_party.rpy:233
translate russian xmas_party_turkey_410ec612:
    lexi.say "Ну... запах точно есть, [lssb_homexmas.bree_name()]!"

# ch/harems/home/events/home_harem_xmas_party.rpy:234
translate russian xmas_party_turkey_254c2a4c:
    lexi.say "Интересно, как она на вкус?"

# ch/harems/home/events/home_harem_xmas_party.rpy:236
translate russian xmas_party_turkey_ced138f3:
    minami.say "Никогда не понимала, как вообще можно приготовить индейку."

# ch/harems/home/events/home_harem_xmas_party.rpy:237
translate russian xmas_party_turkey_f074f835:
    minami.say "Из неё же вроде надо вытащить кишки или что-то такое?!"

# ch/harems/home/events/home_harem_xmas_party.rpy:239
translate russian xmas_party_turkey_41eea14e:
    samantha.say "Я бы ни за что не справилась с такой огромной птицей!"

# ch/harems/home/events/home_harem_xmas_party.rpy:240
translate russian xmas_party_turkey_e8d63a83:
    samantha.say "Ты смелее меня, раз за это взялась."

# ch/harems/home/events/home_harem_xmas_party.rpy:243
translate russian xmas_party_turkey_e1de401c:
    sasha.say "Клюквенный соус не забыли, да?"

# ch/harems/home/events/home_harem_xmas_party.rpy:244
translate russian xmas_party_turkey_ea361376:
    sasha.say "Пожалуйста, скажите, что хоть кто-нибудь не забыл клюквенный соус!"

# ch/harems/home/events/home_harem_xmas_party.rpy:245
translate russian xmas_party_turkey_4fa39925:
    "Когда индейка занимает почётное место на столе, наступает неловкая пауза."

# ch/harems/home/events/home_harem_xmas_party.rpy:246
translate russian xmas_party_turkey_2d331f0d:
    "И тут я замечаю, что почему-то все смотрят на меня!"

# ch/harems/home/events/home_harem_xmas_party.rpy:249
translate russian xmas_party_turkey_c5eeabf5:
    mike.say "Почему вы все так на меня уставились?"

# ch/harems/home/events/home_harem_xmas_party.rpy:252
translate russian xmas_party_turkey_b8d8f667:
    bree.say "Ждём, пока ты разрежешь индейку, конечно!"

# ch/harems/home/events/home_harem_xmas_party.rpy:255
translate russian xmas_party_turkey_e1877880:
    sasha.say "Не потому, что ты мужчина или что-то такое, — просто ты здесь дольше всех живёшь!"

# ch/harems/home/events/home_harem_xmas_party.rpy:258
translate russian xmas_party_turkey_7db12813:
    lexi.say "Да разрежь уже эту птицу!"

# ch/harems/home/events/home_harem_xmas_party.rpy:261
translate russian xmas_party_turkey_69a6aa18:
    minami.say "Я её не разрежу, братик, она ОГРОМНАЯ!"

# ch/harems/home/events/home_harem_xmas_party.rpy:263
translate russian xmas_party_turkey_07f66622:
    samantha.say "Может, ты её разделаешь, если не против?"

# ch/harems/home/events/home_harem_xmas_party.rpy:264
translate russian xmas_party_turkey_a0f6f684:
    "Мне остаётся лишь пожать плечами и взять нож с вилкой."

# ch/harems/home/events/home_harem_xmas_party.rpy:265
translate russian xmas_party_turkey_0c7bc83d:
    "Если они хотят, чтобы я проявил себя мужчиной и разрезал индейку, пусть будет так."

# ch/harems/home/events/home_harem_xmas_party.rpy:266
translate russian xmas_party_turkey_e24b634a:
    "Хотя за всю жизнь я ни разу этого не делал."

# ch/harems/home/events/home_harem_xmas_party.rpy:268
translate russian xmas_party_turkey_d1cf100a:
    "Нужно просто срезать мясо с тушки мёртвой птицы, верно?"

# ch/harems/home/events/home_harem_xmas_party.rpy:269
translate russian xmas_party_turkey_c2f8e2c6:
    "После нескольких неудачных попыток я вхожу в ритм."

# ch/harems/home/events/home_harem_xmas_party.rpy:284
translate russian xmas_party_turkey_49a4247f:
    "И вскоре уже раскладываю соседкам кусочки свежеприготовленной индейки."

# ch/harems/home/events/home_harem_xmas_party.rpy:286
translate russian xmas_party_turkey_785573ec:
    "[lssb_homexmas.bree_name()] с нетерпением наблюдает, как все принимаются за еду."

# ch/harems/home/events/home_harem_xmas_party.rpy:287
translate russian xmas_party_turkey_f1617f14:
    "Она старается делать вид, что ей всё равно."

# ch/harems/home/events/home_harem_xmas_party.rpy:288
translate russian xmas_party_turkey_e0f95f0e:
    "Но ясно видно, как она надеется, что всем понравится."

# ch/harems/home/events/home_harem_xmas_party.rpy:289
translate russian xmas_party_turkey_1fdbdaef:
    "Я улыбаюсь, отправляя в рот кусочек индейки."

# ch/harems/home/events/home_harem_xmas_party.rpy:290
translate russian xmas_party_turkey_508083ea:
    "Но стоит начать жевать, как сохранить улыбку уже невозможно."

# ch/harems/home/events/home_harem_xmas_party.rpy:291
translate russian xmas_party_turkey_1e69da70:
    bree.say "Что случилось, [lssb_common.hero_name()]?"

# ch/harems/home/events/home_harem_xmas_party.rpy:292
translate russian xmas_party_turkey_80abe5bc:
    bree.say "Это послевкусие от закусок, да?"

# ch/harems/home/events/home_harem_xmas_party.rpy:293
translate russian xmas_party_turkey_65fef042:
    bree.say "Может, тебе нужно ещё немного подливки, чтобы легче проглотить?"

# ch/harems/home/events/home_harem_xmas_party.rpy:294
translate russian xmas_party_turkey_0a22cf3c:
    "Я заставляю себя проглотить, и от усилия на глазах выступают слёзы."

# ch/harems/home/events/home_harem_xmas_party.rpy:295
translate russian xmas_party_turkey_a2bcb140:
    "Затем судорожно вдыхаю и качаю головой."

# ch/harems/home/events/home_harem_xmas_party.rpy:296
translate russian xmas_party_turkey_4771d224:
    mike.say "Ого..."

# ch/harems/home/events/home_harem_xmas_party.rpy:297
translate russian xmas_party_turkey_f2399b92:
    mike.say "Это было... это..."

# ch/harems/home/events/home_harem_xmas_party.rpy:299
translate russian xmas_party_turkey_ef98d314:
    sasha.say "МЕРЗОСТЬ!"

# ch/harems/home/events/home_harem_xmas_party.rpy:300
translate russian xmas_party_turkey_ddbb0ed2:
    sasha.say "Это такая мерзость, [lssb_homexmas.bree_name()]!"

# ch/harems/home/events/home_harem_xmas_party.rpy:302
translate russian xmas_party_turkey_7f0be86f:
    "Лекси выплёвывает недожёванную индейку на тарелку."

# ch/harems/home/events/home_harem_xmas_party.rpy:303
translate russian xmas_party_turkey_645d7bec:
    lexi.say "Кх... фу..."

# ch/harems/home/events/home_harem_xmas_party.rpy:304
translate russian xmas_party_turkey_d754fecc:
    lexi.say "Ты меня отравить пытаешься?!"

# ch/harems/home/events/home_harem_xmas_party.rpy:306
translate russian xmas_party_turkey_0852fc42:
    minami.say "Фу... у этой индейки странный вкус!"

# ch/harems/home/events/home_harem_xmas_party.rpy:307
translate russian xmas_party_turkey_b94fe107:
    minami.say "Я это есть не буду, братик!"

# ch/harems/home/events/home_harem_xmas_party.rpy:309
translate russian xmas_party_turkey_1fa9df0d:
    samantha.say "Ох..."

# ch/harems/home/events/home_harem_xmas_party.rpy:310
translate russian xmas_party_turkey_93098a3a:
    samantha.say "Не думаю, что у неё должен быть такой вкус!"

# ch/harems/home/events/home_harem_xmas_party.rpy:311
translate russian xmas_party_turkey_cfffa863:
    "[lssb_homexmas.bree_name()] качает головой и оглядывает стол."

# ch/harems/home/events/home_harem_xmas_party.rpy:312
translate russian xmas_party_turkey_a157d318:
    "Но везде видит лишь недовольство своей стряпнёй."

# ch/harems/home/events/home_harem_xmas_party.rpy:313
translate russian xmas_party_turkey_9fbfbc86:
    bree.say "Я... я не понимаю!"

# ch/harems/home/events/home_harem_xmas_party.rpy:314
translate russian xmas_party_turkey_3ae80ab6:
    bree.say "Я искала в интернете, как приготовить индейку!"

# ch/harems/home/events/home_harem_xmas_party.rpy:315
translate russian xmas_party_turkey_f2cb24c1:
    bree.say "Я, наверное, тысячу видеоуроков посмотрела!"

# ch/harems/home/events/home_harem_xmas_party.rpy:316
translate russian xmas_party_turkey_df2d22e4:
    mike.say "Всё нормально, [lssb_homexmas.bree_name()], правда."

# ch/harems/home/events/home_harem_xmas_party.rpy:317
translate russian xmas_party_turkey_255f185f:
    mike.say "Главное, что ты старалась."

# ch/harems/home/events/home_harem_xmas_party.rpy:318
translate russian xmas_party_turkey_b7932a5e:
    "[lssb_homexmas.bree_name()] кивает в ответ на мои попытки её успокоить."

# ch/harems/home/events/home_harem_xmas_party.rpy:319
translate russian xmas_party_turkey_c68ff595:
    "Но я вижу, что она очень расстроена."

# ch/harems/home/events/home_harem_xmas_party.rpy:320
translate russian xmas_party_turkey_573a7b82:
    "Наверное, придётся придумать, как её подбодрить."

# ch/harems/home/events/home_harem_xmas_party.rpy:322
translate russian xmas_party_turkey_84adf449:
    "Когда все принимаются за еду, Лекси выглядит почти равнодушной."

# ch/harems/home/events/home_harem_xmas_party.rpy:323
translate russian xmas_party_turkey_7e83ea73:
    "Словно ей совершенно не важно, понравится ли нам."

# ch/harems/home/events/home_harem_xmas_party.rpy:324
translate russian xmas_party_turkey_371ca452:
    "Я улыбаюсь и качаю головой, про себя думая, что это правильный подход."

# ch/harems/home/events/home_harem_xmas_party.rpy:325
translate russian xmas_party_turkey_91f660be:
    "Всё-таки Лекси жила в трейлерном парке."

# ch/harems/home/events/home_harem_xmas_party.rpy:326
translate russian xmas_party_turkey_f6de66fd:
    "Каковы шансы, что она хорошо готовит?"

# ch/harems/home/events/home_harem_xmas_party.rpy:327
translate russian xmas_party_turkey_186e5a86:
    "Но стоит мне положить индейку в рот и начать жевать, как происходит кое-что странное."

# ch/harems/home/events/home_harem_xmas_party.rpy:328
translate russian xmas_party_turkey_2be1baa3:
    "Это невероятно вкусно — как у мамы, только гораздо лучше!"

# ch/harems/home/events/home_harem_xmas_party.rpy:329
translate russian xmas_party_turkey_44a34194:
    "Я не могу удержаться и говорю с набитым ртом!"

# ch/harems/home/events/home_harem_xmas_party.rpy:330
translate russian xmas_party_turkey_28eea78e:
    mike.say "Лекси..."

# ch/harems/home/events/home_harem_xmas_party.rpy:331
translate russian xmas_party_turkey_99e0e7fe:
    mike.say "Потрясающе!"

# ch/harems/home/events/home_harem_xmas_party.rpy:333
translate russian xmas_party_turkey_b5f83c5d:
    bree.say "О... он прав, Лекси!"

# ch/harems/home/events/home_harem_xmas_party.rpy:334
translate russian xmas_party_turkey_961f4548:
    bree.say "Лучшей индейки я ещё не ела!"

# ch/harems/home/events/home_harem_xmas_party.rpy:336
translate russian xmas_party_turkey_811291ca:
    sasha.say "Вот чёрт, Лекси!"

# ch/harems/home/events/home_harem_xmas_party.rpy:337
translate russian xmas_party_turkey_183abc8b:
    sasha.say "Где ты научилась так готовить?!"

# ch/harems/home/events/home_harem_xmas_party.rpy:339
translate russian xmas_party_turkey_7df764da:
    minami.say "М-м-м..."

# ch/harems/home/events/home_harem_xmas_party.rpy:340
translate russian xmas_party_turkey_e3372cad:
    minami.say "Это ТАК вкусно, Лекси!"

# ch/harems/home/events/home_harem_xmas_party.rpy:341
translate russian xmas_party_turkey_ef1e20df:
    minami.say "Лучший рождественский ужин всех времён!"

# ch/harems/home/events/home_harem_xmas_party.rpy:343
translate russian xmas_party_turkey_6375cd3b:
    samantha.say "Надо же..."

# ch/harems/home/events/home_harem_xmas_party.rpy:344
translate russian xmas_party_turkey_3d5ccf06:
    samantha.say "Это нечто особенное, Лекси!"

# ch/harems/home/events/home_harem_xmas_party.rpy:345
translate russian xmas_party_turkey_d3048496:
    samantha.say "Очень вкусно!"

# ch/harems/home/events/home_harem_xmas_party.rpy:346
translate russian xmas_party_turkey_7191fac3:
    "Внезапный хор похвал заметно смущает Лекси."

# ch/harems/home/events/home_harem_xmas_party.rpy:347
translate russian xmas_party_turkey_dc10c375:
    "Она даже краснеет, чуть ёрзает на стуле и качает головой."

# ch/harems/home/events/home_harem_xmas_party.rpy:348
translate russian xmas_party_turkey_3d003a61:
    lexi.say "Что?!"

# ch/harems/home/events/home_harem_xmas_party.rpy:349
translate russian xmas_party_turkey_a09eb628:
    lexi.say "Да ничего особенного, правда!"

# ch/harems/home/events/home_harem_xmas_party.rpy:350
translate russian xmas_party_turkey_11562672:
    lexi.say "Просто бабушкин рецепт!"

# ch/harems/home/events/home_harem_xmas_party.rpy:351
translate russian xmas_party_turkey_3704b0ce:
    "Я тоже невольно качаю головой."

# ch/harems/home/events/home_harem_xmas_party.rpy:352
translate russian xmas_party_turkey_345247e6:
    "Возможно, в Лекси скрыто гораздо больше, чем кажется."

# ch/harems/home/events/home_harem_xmas_party.rpy:353
translate russian xmas_party_turkey_c1a3cc0f:
    "То, о чём я никогда бы не догадался."

# ch/harems/home/events/home_harem_xmas_party.rpy:354
translate russian xmas_party_turkey_d0e0c366:
    mike.say "Они правы, Лекси."

# ch/harems/home/events/home_harem_xmas_party.rpy:355
translate russian xmas_party_turkey_e6fe0e3f:
    mike.say "Ужин действительно замечательный."

# ch/harems/home/events/home_harem_xmas_party.rpy:356
translate russian xmas_party_turkey_c9198a5c:
    mike.say "Может, тебе стоит почаще готовить?"

# ch/harems/home/events/home_harem_xmas_party.rpy:357
translate russian xmas_party_turkey_eb0f8dfc:
    mike.say "У тебя отлично получается."

# ch/harems/home/events/home_harem_xmas_party.rpy:358
translate russian xmas_party_turkey_16aa7fa0:
    "Лекси улыбается и снова принимается за еду."

# ch/harems/home/events/home_harem_xmas_party.rpy:359
translate russian xmas_party_turkey_676892fc:
    "Но я вижу, что её щёки всё ещё горят."

# ch/harems/home/events/home_harem_xmas_party.rpy:361
translate russian xmas_party_turkey_29a8937c:
    "Странно, что [lssb_homexmas.bree_name()] сегодня не с нами."

# ch/harems/home/events/home_harem_xmas_party.rpy:362
translate russian xmas_party_turkey_b2548a92:
    "Мне всё кажется, что она вот-вот войдёт."

# ch/harems/home/events/home_harem_xmas_party.rpy:363
translate russian xmas_party_turkey_b847b275:
    "Я почти слышу, как она отчитывает Сашу за отсутствие праздничного настроения."

# ch/harems/home/events/home_harem_xmas_party.rpy:364
translate russian xmas_party_turkey_d8955b6f:
    "А потом представляю, как Саша парирует, подшучивая над тем, что она сама как большой ребёнок!"

# ch/harems/home/events/home_harem_xmas_party.rpy:365
translate russian xmas_party_turkey_1f633766:
    "Наверное, остаётся только поднять бокал в её память."

# ch/harems/home/events/home_harem_xmas_party.rpy:378
translate russian xmas_party_singing_818e406f:
    "К концу рождественского ужина я чувствую себя выброшенным на берег китом!"

# ch/harems/home/events/home_harem_xmas_party.rpy:379
translate russian xmas_party_singing_056804c4:
    "Остатки индейки мы будем доедать ещё долго после Нового года, и эта мысль меня пугает."

# ch/harems/home/events/home_harem_xmas_party.rpy:380
translate russian xmas_party_singing_361a4db7:
    "Но сейчас я готовлюсь к неизбежному спору о том, кому мыть посуду."

# ch/harems/home/events/home_harem_xmas_party.rpy:381
translate russian xmas_party_singing_f3e0efc3:
    "Дома из-за этого всегда были скандалы, пока мама шантажом не заставила папу купить посудомойку."

# ch/harems/home/events/home_harem_xmas_party.rpy:382
translate russian xmas_party_singing_fb3071dd:
    "И я выучил целый список отговорок, надеясь, что их хватит..."

# ch/harems/home/events/home_harem_xmas_party.rpy:385
translate russian xmas_party_singing_fd1955cf:
    bree.say "Так, ребята, пора петь рождественские песни!"

# ch/harems/home/events/home_harem_xmas_party.rpy:388
translate russian xmas_party_singing_2744bb33:
    sasha.say "Собирайтесь, споём все вместе!"

# ch/harems/home/events/home_harem_xmas_party.rpy:389
translate russian xmas_party_singing_3877b53f:
    sasha.say "[lssb_common.hero_name()], какая твоя любимая рождественская песня?"

# ch/harems/home/events/home_harem_xmas_party.rpy:390
translate russian xmas_party_singing_19d32c7e:
    "При одном упоминании рождественских песен меня охватывает ужас."

# ch/harems/home/events/home_harem_xmas_party.rpy:391
translate russian xmas_party_singing_ac93d6c6:
    "Какого чёрта здесь происходит?!"

# ch/harems/home/events/home_harem_xmas_party.rpy:392
translate russian xmas_party_singing_17c0e8e7:
    "Мы же не в церкви, чёрт побери!"

# ch/harems/home/events/home_harem_xmas_party.rpy:395
translate russian xmas_party_singing_01cbf6dc:
    lexi.say "О да!"

# ch/harems/home/events/home_harem_xmas_party.rpy:396
translate russian xmas_party_singing_b02ac0e3:
    lexi.say "Кажется, я помню несколько."

# ch/harems/home/events/home_harem_xmas_party.rpy:397
translate russian xmas_party_singing_f6929fcd:
    lexi.say "Ну... по крайней мере, их неприличные версии!"

# ch/harems/home/events/home_harem_xmas_party.rpy:400
translate russian xmas_party_singing_516bac97:
    minami.say "О, отличная идея!"

# ch/harems/home/events/home_harem_xmas_party.rpy:401
translate russian xmas_party_singing_d2d8981d:
    minami.say "Будет прямо как в рождественском фильме!"

# ch/harems/home/events/home_harem_xmas_party.rpy:404
translate russian xmas_party_singing_c3fa4694:
    samantha.say "Звучит очень мило."

# ch/harems/home/events/home_harem_xmas_party.rpy:405
translate russian xmas_party_singing_66137467:
    samantha.say "Так уютно и по традиции!"

# ch/harems/home/events/home_harem_xmas_party.rpy:406
translate russian xmas_party_singing_d68ebf67:
    "Я оглядываюсь по сторонам, не веря своим ушам."

# ch/harems/home/events/home_harem_xmas_party.rpy:407
translate russian xmas_party_singing_da758c70:
    "Мы только что съели огромный рождественский ужин."

# ch/harems/home/events/home_harem_xmas_party.rpy:408
translate russian xmas_party_singing_416e1009:
    "Единственная знакомая мне традиция — усесться на задницу и всё это проспать!"

# ch/harems/home/events/home_harem_xmas_party.rpy:409
translate russian xmas_party_singing_9560d3d9:
    "Но все остальные, похоже, внезапно одержимы идеей попеть."

# ch/harems/home/events/home_harem_xmas_party.rpy:411
translate russian xmas_party_singing_1ba28c06:
    mike.say "Ну, можно спеть пару коротких рождественских песен."

# ch/harems/home/events/home_harem_xmas_party.rpy:412
translate russian xmas_party_singing_7efe9cf7:
    mike.say "Так кто начнёт?"

# ch/harems/home/events/home_harem_xmas_party.rpy:414
translate russian xmas_party_singing_1320f503:
    "Вдруг настроение в комнате меняется."

# ch/harems/home/events/home_harem_xmas_party.rpy:415
translate russian xmas_party_singing_71af57a5:
    "Секунду назад все рвались петь."

# ch/harems/home/events/home_harem_xmas_party.rpy:416
translate russian xmas_party_singing_c936254b:
    "А теперь никто не хочет начинать!"

# ch/harems/home/events/home_harem_xmas_party.rpy:418
translate russian xmas_party_singing_c071674c:
    "Я досадливо вздыхаю и поднимаюсь на ноги."

# ch/harems/home/events/home_harem_xmas_party.rpy:419
translate russian xmas_party_singing_15005acf:
    mike.say "Ладно... ладно..."

# ch/harems/home/events/home_harem_xmas_party.rpy:420
translate russian xmas_party_singing_99d73814:
    mike.say "Понятно, к чему всё идёт!"

# ch/harems/home/events/home_harem_xmas_party.rpy:421
translate russian xmas_party_singing_ab64583b:
    mike.say "Первую песню спою я."

# ch/harems/home/events/home_harem_xmas_party.rpy:422
translate russian xmas_party_singing_3e4aa1ca:
    mike.say "Но после этого до следующего года от меня отстаньте!"

# ch/harems/home/events/home_harem_xmas_party.rpy:423
translate russian xmas_party_singing_69b625d9:
    "Я ломаю голову, пытаясь вспомнить рождественскую песню, которую знаю наизусть."

# ch/harems/home/events/home_harem_xmas_party.rpy:424
translate russian xmas_party_singing_f6ee20bd:
    "В конце концов выбираю ту, где король смотрит в окно."

# ch/harems/home/events/home_harem_xmas_party.rpy:437
translate russian xmas_party_singing_c8c580e8:
    "Прокашлявшись, я начинаю петь, выкладываясь на полную."

# ch/harems/home/events/home_harem_xmas_party.rpy:438
translate russian xmas_party_singing_e072a4f8:
    "Реакция не заставляет себя ждать."

# ch/harems/home/events/home_harem_xmas_party.rpy:440
translate russian xmas_party_singing_a12eb850:
    bree.say "О нет, кажется, у меня из ушей кровь!"

# ch/harems/home/events/home_harem_xmas_party.rpy:442
translate russian xmas_party_singing_0ef0f57d:
    sasha.say "Ого... вот это ты расправился с классикой!"

# ch/harems/home/events/home_harem_xmas_party.rpy:444
translate russian xmas_party_singing_4f70bbfb:
    lexi.say "Чувак, звучишь как трахающиеся коты!"

# ch/harems/home/events/home_harem_xmas_party.rpy:446
translate russian xmas_party_singing_35da1496:
    minami.say "Ой, братик, звучит не очень!"

# ch/harems/home/events/home_harem_xmas_party.rpy:448
translate russian xmas_party_singing_f9670603:
    samantha.say "Эм... думаю, уже можно остановиться!"

# ch/harems/home/events/home_harem_xmas_party.rpy:449
translate russian xmas_party_singing_29748ea5:
    "Допев, я сердито смотрю на всех."

# ch/harems/home/events/home_harem_xmas_party.rpy:450
translate russian xmas_party_singing_ce874baf:
    "Сначала заставляют меня петь эту чёртову песню, а потом жалуются!"

# ch/harems/home/events/home_harem_xmas_party.rpy:451
translate russian xmas_party_singing_f1a1d725:
    "Некоторым просто невозможно угодить!"

# ch/harems/home/events/home_harem_xmas_party.rpy:452
translate russian xmas_party_singing_cd83e08f:
    "Но хотя бы до следующего Рождества с этим покончено."

# ch/harems/home/events/home_harem_xmas_party.rpy:454
translate russian xmas_party_singing_0d8c93c3:
    "Тут подаёт голос Минами."

# ch/harems/home/events/home_harem_xmas_party.rpy:456
translate russian xmas_party_singing_8d935cb6:
    minami.say "Я что-нибудь спою!"

# ch/harems/home/events/home_harem_xmas_party.rpy:457
translate russian xmas_party_singing_2b568f58:
    minami.say "И, кажется, знаю что..."

# ch/harems/home/events/home_harem_xmas_party.rpy:468
translate russian xmas_party_singing_12aa4130:
    "Минами без промедления начинает петь."

# ch/harems/home/events/home_harem_xmas_party.rpy:469
translate russian xmas_party_singing_60480df1:
    "Песня старая, названия я не помню."

# ch/harems/home/events/home_harem_xmas_party.rpy:470
translate russian xmas_party_singing_4184a791:
    "Но она идеально подходит к её голосу и звучит божественно."

# ch/harems/home/events/home_harem_xmas_party.rpy:471
translate russian xmas_party_singing_cae2672a:
    "Вскоре Минами завораживает всех в комнате."

# ch/harems/home/events/home_harem_xmas_party.rpy:472
translate russian xmas_party_singing_27ede9ea:
    "А закончив, кажется, смущается всеобщего внимания."

# ch/harems/home/events/home_harem_xmas_party.rpy:474
translate russian xmas_party_singing_679af091:
    bree.say "Это было потрясающе, Минами!"

# ch/harems/home/events/home_harem_xmas_party.rpy:476
translate russian xmas_party_singing_f1dc9885:
    sasha.say "Ух ты, кто научил тебя так петь?!"

# ch/harems/home/events/home_harem_xmas_party.rpy:478
translate russian xmas_party_singing_b43f85d0:
    lexi.say "Тебе бы в хоре выступать или где-нибудь ещё!"

# ch/harems/home/events/home_harem_xmas_party.rpy:480
translate russian xmas_party_singing_83042806:
    samantha.say "Прекрасно, Минами, у тебя чудесный голос!"

# ch/harems/home/events/home_harem_xmas_party.rpy:481
translate russian xmas_party_singing_f964fe30:
    "Минами краснеет и отводит взгляд."

# ch/harems/home/events/home_harem_xmas_party.rpy:482
translate russian xmas_party_singing_4ef2c0f2:
    "Но всё это время улыбается, и я считаю это хорошим знаком."

# ch/harems/home/events/home_harem_xmas_party.rpy:483
translate russian xmas_party_singing_0c62555b:
    mike.say "Они правы, Минами."

# ch/harems/home/events/home_harem_xmas_party.rpy:484
translate russian xmas_party_singing_1f0f889d:
    mike.say "Ты спела очень красиво."

# ch/harems/home/events/home_harem_xmas_party.rpy:485
translate russian xmas_party_singing_7508f456:
    mike.say "У тебя потрясающий голос!"

# ch/harems/home/events/home_harem_xmas_party.rpy:486
translate russian xmas_party_singing_5f5875ec:
    minami.say "Спасибо, братик!"

# ch/harems/home/events/home_harem_xmas_party.rpy:487
translate russian xmas_party_singing_c238a62f:
    minami.say "Услышать это от тебя особенно приятно!"

# ch/harems/home/events/home_harem_xmas_party.rpy:496
translate russian xmas_party_pudding_b2d1574c:
    "Как только пытка пением заканчивается, меня охватывает жуткое ощущение, что за мной наблюдают."

# ch/harems/home/events/home_harem_xmas_party.rpy:497
translate russian xmas_party_pudding_4153be6a:
    "Достаточно бегло оглядеть комнату, чтобы убедиться: подозрения верны."

# ch/harems/home/events/home_harem_xmas_party.rpy:498
translate russian xmas_party_pudding_860e016f:
    "Все смотрят на меня с ожиданием на лицах, будто чего-то ждут."

# ch/harems/home/events/home_harem_xmas_party.rpy:500
translate russian xmas_party_pudding_712df6a6:
    mike.say "Девчонки... что такое?"

# ch/harems/home/events/home_harem_xmas_party.rpy:501
translate russian xmas_party_pudding_99a5144a:
    mike.say "Вы меня уже пугаете!"

# ch/harems/home/events/home_harem_xmas_party.rpy:502
translate russian xmas_party_pudding_a7cca368:
    "В ответ раздаётся дружный ах, и девушки обмениваются удивлёнными взглядами."

# ch/harems/home/events/home_harem_xmas_party.rpy:505
translate russian xmas_party_pudding_a64c41b7:
    bree.say "Пудинг!"

# ch/harems/home/events/home_harem_xmas_party.rpy:506
translate russian xmas_party_pudding_84c00ae2:
    bree.say "Только не говори, что забыл?!"

# ch/harems/home/events/home_harem_xmas_party.rpy:508
translate russian xmas_party_pudding_95605bca:
    sasha.say "Никаких оправданий!"

# ch/harems/home/events/home_harem_xmas_party.rpy:509
translate russian xmas_party_pudding_c65017e9:
    sasha.say "Я хочу свой рождественский пудинг!"

# ch/harems/home/events/home_harem_xmas_party.rpy:512
translate russian xmas_party_pudding_c7c09b6c:
    lexi.say "У тебя дырявая голова!"

# ch/harems/home/events/home_harem_xmas_party.rpy:513
translate russian xmas_party_pudding_abe678b2:
    lexi.say "Тащи уже пудинг!"

# ch/harems/home/events/home_harem_xmas_party.rpy:515
translate russian xmas_party_pudding_8d5b240e:
    minami.say "Ох, братик, какой же ты забывчивый!"

# ch/harems/home/events/home_harem_xmas_party.rpy:516
translate russian xmas_party_pudding_9d1a5461:
    minami.say "Ты обещал приготовить пудинг, помнишь?"

# ch/harems/home/events/home_harem_xmas_party.rpy:519
translate russian xmas_party_pudding_c9add6cd:
    samantha.say "Кажется, от пения у тебя голова закружилась!"

# ch/harems/home/events/home_harem_xmas_party.rpy:520
translate russian xmas_party_pudding_1a29e589:
    samantha.say "А у нас разыгрался аппетит к пудингу!"

# ch/harems/home/events/home_harem_xmas_party.rpy:521
translate russian xmas_party_pudding_1355f38a:
    "Точно, я же согласился взять на себя последнее блюдо — пудинг!"

# ch/harems/home/events/home_harem_xmas_party.rpy:523
translate russian xmas_party_pudding_bb7a089a:
    "Без лишних слов я мчусь на кухню исполнять свои обязанности."

# ch/harems/home/events/home_harem_xmas_party.rpy:527
translate russian xmas_party_pudding_b63050ca:
    "Остальные очень скоро начинают интересоваться моими успехами."

# ch/harems/home/events/home_harem_xmas_party.rpy:530
translate russian xmas_party_pudding_7b3de454:
    bree.say "О-о... как вкусно пахнет!"

# ch/harems/home/events/home_harem_xmas_party.rpy:532
translate russian xmas_party_pudding_04034766:
    sasha.say "Надеюсь, ожидание того стоит!"

# ch/harems/home/events/home_harem_xmas_party.rpy:534
translate russian xmas_party_pudding_0a96ced7:
    lexi.say "Оценим пудинг, когда попробуем!"

# ch/harems/home/events/home_harem_xmas_party.rpy:537
translate russian xmas_party_pudding_eef9e23a:
    minami.say "Мне порцию побольше!"

# ch/harems/home/events/home_harem_xmas_party.rpy:539
translate russian xmas_party_pudding_0a6358e3:
    samantha.say "Уверена, будет замечательно!"

# ch/harems/home/events/home_harem_xmas_party.rpy:540
translate russian xmas_party_pudding_4620187b:
    "Улыбаясь, я раскладываю всем по порции пудинга."

# ch/harems/home/events/home_harem_xmas_party.rpy:541
translate russian xmas_party_pudding_98a02d45:
    "Остаётся только раздать их и ждать."

# ch/harems/home/events/home_harem_xmas_party.rpy:542
translate russian xmas_party_pudding_7d5758da:
    "Они жадно съедают первые ложки, и вскоре я вижу реакцию."

# ch/harems/home/events/home_harem_xmas_party.rpy:545
translate russian xmas_party_pudding_93067693:
    "Их глаза округляются."

# ch/harems/home/events/home_harem_xmas_party.rpy:546
translate russian xmas_party_pudding_1912d84f:
    "Я пытаюсь объяснить это тем, что пудинг горячий."

# ch/harems/home/events/home_harem_xmas_party.rpy:547
translate russian xmas_party_pudding_212f1fdd:
    "Да что с ними со всеми?"

# ch/harems/home/events/home_harem_xmas_party.rpy:548
translate russian xmas_party_pudding_cba94ea2:
    "Неужели настолько невкусно?"

# ch/harems/home/events/home_harem_xmas_party.rpy:549
translate russian xmas_party_pudding_f55f7c60:
    "Вдруг ответ становится очевиден: ложки начинают мелькать всё быстрее."

# ch/harems/home/events/home_harem_xmas_party.rpy:550
translate russian xmas_party_pudding_6f7391c6:
    "Я изумлённо оглядываю стол: все словно забыли о приличиях."

# ch/harems/home/events/home_harem_xmas_party.rpy:551
translate russian xmas_party_pudding_dcc066bb:
    "Они набивают рты пудингом так быстро, как только могут!"

# ch/harems/home/events/home_harem_xmas_party.rpy:552
translate russian xmas_party_pudding_2d700917:
    "А доев свою порцию, начинают коситься на остатки у соседки."

# ch/harems/home/events/home_harem_xmas_party.rpy:553
translate russian xmas_party_pudding_f56f3c72:
    "Но в ответ получают лишь ревнивый взгляд искоса — словно собака рычит над своей миской!"

# ch/harems/home/events/home_harem_xmas_party.rpy:554
translate russian xmas_party_pudding_e0fc08b5:
    "Я могу лишь молча и изумлённо наблюдать, как исчезают последние кусочки пудинга."

# ch/harems/home/events/home_harem_xmas_party.rpy:557
translate russian xmas_party_pudding_d1ed6af8:
    bree.say "Это было ТАК вкусно!"

# ch/harems/home/events/home_harem_xmas_party.rpy:558
translate russian xmas_party_pudding_c8c28cdd:
    bree.say "Эм... а ещё не осталось?"

# ch/harems/home/events/home_harem_xmas_party.rpy:561
translate russian xmas_party_pudding_76422288:
    sasha.say "Я такого пудинга ещё не пробовала!"

# ch/harems/home/events/home_harem_xmas_party.rpy:562
translate russian xmas_party_pudding_34bd9935:
    sasha.say "Добавка ведь будет, правда?"

# ch/harems/home/events/home_harem_xmas_party.rpy:565
translate russian xmas_party_pudding_db95b895:
    lexi.say "Охренеть как вкусно!"

# ch/harems/home/events/home_harem_xmas_party.rpy:566
translate russian xmas_party_pudding_8a82ce4e:
    lexi.say "Что мне сделать, чтобы получить ещё тарелочку?"

# ch/harems/home/events/home_harem_xmas_party.rpy:568
translate russian xmas_party_pudding_de11a0ef:
    minami.say "Мне очень понравилось, братик!"

# ch/harems/home/events/home_harem_xmas_party.rpy:569
translate russian xmas_party_pudding_ba9200dc:
    minami.say "Ты ведь оставил для меня ещё?"

# ch/harems/home/events/home_harem_xmas_party.rpy:572
translate russian xmas_party_pudding_c9ebdfba:
    samantha.say "Очень вкусно!"

# ch/harems/home/events/home_harem_xmas_party.rpy:573
translate russian xmas_party_pudding_5f57c6f3:
    samantha.say "Я бы с удовольствием взяла добавку, если что-нибудь осталось."

# ch/harems/home/events/home_harem_xmas_party.rpy:574
translate russian xmas_party_pudding_84378332:
    "С трудом веря этому хору похвал, я слушаю."

# ch/harems/home/events/home_harem_xmas_party.rpy:575
translate russian xmas_party_pudding_9b38e6ed:
    "И молча иду за остатками пудинга."

# ch/harems/home/events/home_harem_xmas_party.rpy:576
translate russian xmas_party_pudding_819824da:
    "Но едва возвращаюсь к столу, его выхватывают у меня из рук!"

# ch/harems/home/events/home_harem_xmas_party.rpy:577
translate russian xmas_party_pudding_5ae17a3c:
    "Я смотрю, как все буквально дерутся за остатки."

# ch/harems/home/events/home_harem_xmas_party.rpy:578
translate russian xmas_party_pudding_fed69022:
    "Мне остаётся лишь отступить и изумлённо покачать головой."

# ch/harems/home/events/home_harem_xmas_party.rpy:580
translate russian xmas_party_pudding_93067693_1:
    "Их глаза округляются."

# ch/harems/home/events/home_harem_xmas_party.rpy:581
translate russian xmas_party_pudding_1912d84f_1:
    "Я пытаюсь объяснить это тем, что пудинг горячий."

# ch/harems/home/events/home_harem_xmas_party.rpy:582
translate russian xmas_party_pudding_b036a8b8:
    "Но первые кусочки они проглатывают с трудом."

# ch/harems/home/events/home_harem_xmas_party.rpy:583
translate russian xmas_party_pudding_e2762611:
    "И когда рты освобождаются, я начинаю получать отзывы."

# ch/harems/home/events/home_harem_xmas_party.rpy:586
translate russian xmas_party_pudding_cafc29ba:
    bree.say "Ох... господи..."

# ch/harems/home/events/home_harem_xmas_party.rpy:587
translate russian xmas_party_pudding_ec2f6a69:
    bree.say "Такое чувство, будто я проглотила шар для боулинга!"

# ch/harems/home/events/home_harem_xmas_party.rpy:590
translate russian xmas_party_pudding_3add8bbb:
    sasha.say "Ого... ну и гадость!"

# ch/harems/home/events/home_harem_xmas_party.rpy:591
translate russian xmas_party_pudding_98255de7:
    sasha.say "Прямо совсем гадость!"

# ch/harems/home/events/home_harem_xmas_party.rpy:594
translate russian xmas_party_pudding_89c9b041:
    lexi.say "Фу..."

# ch/harems/home/events/home_harem_xmas_party.rpy:595
translate russian xmas_party_pudding_aa3567c9:
    lexi.say "Добавки, пожалуй, не надо!"

# ch/harems/home/events/home_harem_xmas_party.rpy:598
translate russian xmas_party_pudding_28256556:
    minami.say "Бе!"

# ch/harems/home/events/home_harem_xmas_party.rpy:599
translate russian xmas_party_pudding_c5a49aa2:
    minami.say "Это было ОЧЕНЬ невкусно, братик!"

# ch/harems/home/events/home_harem_xmas_party.rpy:602
translate russian xmas_party_pudding_1fa9df0d:
    samantha.say "Ох..."

# ch/harems/home/events/home_harem_xmas_party.rpy:603
translate russian xmas_party_pudding_8098481b:
    samantha.say "Кажется, желудку это не очень понравилось..."

# ch/harems/home/events/home_harem_xmas_party.rpy:604
translate russian xmas_party_pudding_148f39da:
    "Я поднимаю взгляд от своей миски с полным недоумением на лице."

# ch/harems/home/events/home_harem_xmas_party.rpy:605
translate russian xmas_party_pudding_fe6bff35:
    "Я ведь изо всех сил старался приготовить этот пудинг!"

# ch/harems/home/events/home_harem_xmas_party.rpy:606
translate russian xmas_party_pudding_772bc7cb:
    "Могли бы хотя бы сделать вид, что им понравилось!"

# ch/harems/home/events/home_harem_xmas_party.rpy:608
translate russian xmas_party_pudding_fbb1d173:
    mike.say "Я целую вечность его готовил!"

# ch/harems/home/events/home_harem_xmas_party.rpy:609
translate russian xmas_party_pudding_66125ccf:
    mike.say "И вообще делал это впервые!"

# ch/harems/home/events/home_harem_xmas_party.rpy:610
translate russian xmas_party_pudding_a0d9b8a5:
    "Но, несмотря на все мои возражения, уверен: и в последний раз."

