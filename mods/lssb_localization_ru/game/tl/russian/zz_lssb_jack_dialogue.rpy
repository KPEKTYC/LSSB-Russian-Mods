# ch/jack/events.rpy:338
translate russian jack_event_01_5ac94ca8:
    "И ни одна из девушек не предупреждала, что к ней кто-то придёт."

# ch/jack/events.rpy:339
translate russian jack_event_01_7b17b31e:
    "Когда неизвестный стучит во второй раз, я уже встаю и иду к двери."

# ch/jack/events.rpy:343
translate russian jack_event_01_341d0451:
    "Открываю — и вижу улыбающееся лицо Джека."

# ch/jack/events.rpy:344
translate russian jack_event_01_6b841179:
    "Конечно, приятно увидеть старого друга."

# ch/jack/events.rpy:345
translate russian jack_event_01_3bfa42a2:
    "Но чего он хочет?"

# ch/jack/events.rpy:347
translate russian jack_event_01_e3e53688:
    jack.say "Привет, [hero.name]!"

# ch/jack/events.rpy:348
translate russian jack_event_01_510293a0:
    jack.say "Как жизнь?"

# ch/jack/events.rpy:349
translate russian jack_event_01_d84b775e:
    mike.say "А... Привет, Джек."

# ch/jack/events.rpy:350
translate russian jack_event_01_13c9177b:
    jack.say "Ну что, не пригласишь войти?"

# ch/jack/events.rpy:351
translate russian jack_event_01_86d07102:
    mike.say "А..."

# ch/jack/events.rpy:352
translate russian jack_event_01_658b6935:
    mike.say "Конечно-конечно, заходи."

# ch/jack/events.rpy:354
translate russian jack_event_01_fed5fb6c:
    "Когда мы входим в гостиную, Джек присвистывает."

# ch/jack/events.rpy:355
translate russian jack_event_01_3c210359:
    jack.say "Классно ты устроился, чувак."

# ch/jack/events.rpy:356
translate russian jack_event_01_05a2d28a:
    jack.say "Да это же идеальное место!"

# ch/jack/events.rpy:357
translate russian jack_event_01_7bce731e:
    mike.say "И... идеальное?"

# ch/jack/events.rpy:358
translate russian jack_event_01_b8bfebf5:
    mike.say "Для чего?"

# ch/jack/events.rpy:360
translate russian jack_event_01_ee670f05:
    jack.say "Для игры в «Демонов и полубогов», конечно!"

# ch/jack/events.rpy:361
translate russian jack_event_01_e0c162c7:
    jack.say "Помнишь? Та ролёвка, «ДД»!"

# ch/jack/events.rpy:362
translate russian jack_event_01_d8ee5457:
    "Я невольно кривлюсь, словно в комнате чем-то завоняло."

# ch/jack/events.rpy:363
translate russian jack_event_01_16b0f56a:
    mike.say "Серьёзно, Джек?"

# ch/jack/events.rpy:364
translate russian jack_event_01_d280141a:
    mike.say "Четвёртая редакция была полным отстоем..."

# ch/jack/events.rpy:365
translate russian jack_event_01_25cff791:
    jack.say "У меня теперь пятая — куда лучше!"

# ch/jack/events.rpy:366
translate russian jack_event_01_f388d549:
    jack.say "Можно даже поиграть у бассейна."

# ch/jack/events.rpy:367
translate russian jack_event_01_d7ba6b2a:
    jack.say "Кидать кубики прямо на бортике!"

# ch/jack/events.rpy:368
translate russian jack_event_01_7b2d0cf0:
    mike.say "Ну да... пожалуй."

# ch/jack/events.rpy:369
translate russian jack_event_01_1c623275:
    mike.say "Но с чего это вдруг?"

# ch/jack/events.rpy:370
translate russian jack_event_01_2b9cef97:
    jack.say "А-а, точно... Ты разве не слышал про Спенсера?"

# ch/jack/events.rpy:371
translate russian jack_event_01_3ffac45e:
    mike.say "Того, что играл в магазине настолок?"

# ch/jack/events.rpy:372
translate russian jack_event_01_92619d8f:
    mike.say "В спортивных штанах и не в ладах с гигиеной?"

# ch/jack/events.rpy:373
translate russian jack_event_01_b63f6faa:
    jack.say "Того самого."

# ch/jack/events.rpy:374
translate russian jack_event_01_e15b3ce9:
    jack.say "Так вот, посреди игры у него съехала крыша."

# ch/jack/events.rpy:375
translate russian jack_event_01_5cc885e2:
    mike.say "Он что, кучу народу поубивал?!"

# ch/jack/events.rpy:376
translate russian jack_event_01_7a2e8913:
    jack.say "Что?"

# ch/jack/events.rpy:377
translate russian jack_event_01_a871c7f1:
    jack.say "Нет, просто совсем охренел."

# ch/jack/events.rpy:378
translate russian jack_event_01_fc14dcda:
    jack.say "Таблетки свои не принимал, что ли."

# ch/jack/events.rpy:379
translate russian jack_event_01_9eeee77a:
    jack.say "Короче, после этого нас с игрой из магазина выперли."

# ch/jack/events.rpy:380
translate russian jack_event_01_004ab7e0:
    jack.say "С тех пор я и ищу, где бы собираться..."

# ch/jack/events.rpy:381
translate russian jack_event_01_d9329833:
    "Я начинаю понимать, к чему он клонит."

# ch/jack/events.rpy:382
translate russian jack_event_01_b66d18e0:
    "Но не успеваю ответить, как открывается дверь."

# ch/jack/events.rpy:383
translate russian jack_event_01_15f52065:
    "*дверь открывается*"

# ch/jack/events.rpy:384
translate russian jack_event_01_6df60ba9:
    "В дверях стоит [bree.name]."

# ch/jack/events.rpy:385
translate russian jack_event_01_2d7a7503:
    "Она в пижаме и выглядит совсем сонной."

# ch/jack/events.rpy:388
translate russian jack_event_01_9984578e:
    bree.say "У вас тут всё нормально?"

# ch/jack/events.rpy:389
translate russian jack_event_01_ba566e93:
    bree.say "Ваш разговор даже наверху слышно!"

# ch/jack/events.rpy:390
translate russian jack_event_01_dee88e04:
    mike.say "Всё хорошо, [bree.name], не волнуйся."

# ch/jack/events.rpy:391
translate russian jack_event_01_83002f22:
    mike.say "Это Джек."

# ch/jack/events.rpy:392
translate russian jack_event_01_c81ef054:
    mike.say "Мой старый школьный друг..."

# ch/jack/events.rpy:396
translate russian jack_event_01_31fc051a:
    "У Джека глаза чуть не вылезают из орбит."

# ch/jack/events.rpy:397
translate russian jack_event_01_18f53c5c:
    jack.say "Охренеть, чувак! Это твоя соседка?!"

# ch/jack/events.rpy:398
translate russian jack_event_01_4583608f:
    mike.say "Э-э... да, Джек."

# ch/jack/events.rpy:399
translate russian jack_event_01_6e9ace5a:
    mike.say "Это [bree.name]."

# ch/jack/events.rpy:400
translate russian jack_event_01_0b90c125:
    jack.say "О, классная футболка с Радугой Смэш!"

# ch/jack/events.rpy:401
translate russian jack_event_01_24278a5b:
    bree.say "А?"

# ch/jack/events.rpy:402
translate russian jack_event_01_ab63d869:
    bree.say "Спасибо, Джек! Глазастый!"

# ch/jack/events.rpy:403
translate russian jack_event_01_6f2923d7:
    bree.say "Вы сейчас про ролевые игры говорили?"

# ch/jack/events.rpy:404
translate russian jack_event_01_7b2b1d0d:
    jack.say "Ещё бы, [bree.name]! Я опытный Мастер игры!"

# ch/jack/events.rpy:405
translate russian jack_event_01_a6dc2cb0:
    jack.say "Вот как раз... Мы с [hero.name] собираемся начать новую игру."

# ch/jack/events.rpy:406
translate russian jack_event_01_b50e22fc:
    jack.say "Хочешь с нами?"

# ch/jack/events.rpy:407
translate russian jack_event_01_1e9a8017:
    bree.say "В кооперативе?"

# ch/jack/events.rpy:408
translate russian jack_event_01_c07dc4c2:
    bree.say "На какой платформе?"

# ch/jack/events.rpy:409
translate russian jack_event_01_dba59240:
    mike.say "Он про настольную ролевую игру, [bree.name]."

# ch/jack/events.rpy:410
translate russian jack_event_01_4c273b97:
    mike.say "Ну, ручки, бумага, кубики..."

# ch/jack/events.rpy:412
translate russian jack_event_01_da5fae4f:
    bree.say "О-о! Настоящее ретро!"

# ch/jack/events.rpy:413
translate russian jack_event_01_31a225f6:
    bree.say "Всегда хотела попробовать."

# ch/jack/events.rpy:414
translate russian jack_event_01_895b2516:
    jack.say "Отлично! Будет ТАК круто!"

# ch/jack/events.rpy:415
translate russian jack_event_01_27a16bf3:
    "Его чуть не трясёт от восторга."

# ch/jack/events.rpy:416
translate russian jack_event_01_c9836779:
    "И я его понимаю."

# ch/jack/events.rpy:417
translate russian jack_event_01_d90eaf12:
    "Мы ещё никогда не играли с девушкой, тем более с такой красоткой, как [bree.name]!"

# ch/jack/events.rpy:420
translate russian jack_event_01_225fe03d:
    "Но вдруг Джек сникает, словно из него выпустили воздух."

# ch/jack/events.rpy:421
translate russian jack_event_01_c0007eb1:
    jack.say "Блин!"

# ch/jack/events.rpy:422
translate russian jack_event_01_db906f35:
    jack.say "Для моего приключения нужны ТРИ игрока."

# ch/jack/events.rpy:423
translate russian jack_event_01_369a06f2:
    jack.say "Вдвоём не получится..."

# ch/jack/events.rpy:426
translate russian jack_event_01_b5301d91:
    sasha.say "Какого хрена вы тут орёте, а?"

# ch/jack/events.rpy:427
translate russian jack_event_01_c4a65b26:
    "Мы все трое оборачиваемся: в дверях стоит Саша."

# ch/jack/events.rpy:428
translate russian jack_event_01_96ca475d:
    "Она скрестила руки на груди."

# ch/jack/events.rpy:429
translate russian jack_event_01_70270cf4:
    "Только непонятно, от злости или чтобы придержать полотенце, в которое завернулась."

# ch/jack/events.rpy:430
translate russian jack_event_01_17f42f28:
    sasha.say "Я вообще-то пыталась расслабиться в ванной!"

# ch/jack/events.rpy:431
translate russian jack_event_01_a275c675:
    "Джек поворачивается ко мне с ошеломлённым видом."

# ch/jack/events.rpy:432
translate russian jack_event_01_917d026c:
    jack.say "У тебя есть ЕЩЁ ОДНА соседка?!"

# ch/jack/events.rpy:433
translate russian jack_event_01_20515b1d:
    jack.say "Обалдеть! Она прямо богиня!"

# ch/jack/events.rpy:435
translate russian jack_event_01_20924830:
    "Саша приподнимает бровь."

# ch/jack/events.rpy:436
translate russian jack_event_01_11a90617:
    "Словно не знает, возмутиться ей или посмеяться."

# ch/jack/events.rpy:437
translate russian jack_event_01_a29ee519:
    sasha.say "Поклонников у меня всегда хватало."

# ch/jack/events.rpy:441
translate russian jack_event_01_cf7b94b4:
    "[bree.name] вдруг восторженно взвизгивает и хлопает в ладоши."

# ch/jack/events.rpy:442
translate russian jack_event_01_b9df5846:
    bree.say "Саша, представляешь? Мы будем играть в ролевую игру!"

# ch/jack/events.rpy:443
translate russian jack_event_01_5e20493e:
    bree.say "Прямо здесь, дома! И ты тоже можешь!"

# ch/jack/events.rpy:444
translate russian jack_event_01_4c3f07d1:
    sasha.say "Да ну? Правда?"

# ch/jack/events.rpy:445
translate russian jack_event_01_0d207d02:
    sasha.say "Пожалуй, можно попробовать."

# ch/jack/events.rpy:446
translate russian jack_event_01_09bf717e:
    sasha.say "Только чтобы без всяких единорогов и радуг."

# ch/jack/events.rpy:447
translate russian jack_event_01_cc0667cc:
    sasha.say "Бр-р... Меня от этой хрени тошнит!"

# ch/jack/events.rpy:451
translate russian jack_event_01_f282d8a2:
    "Джек радостно хихикает."

# ch/jack/events.rpy:452
translate russian jack_event_01_a1fa865e:
    jack.say "Она называется «Демоны и полубоги»."

# ch/jack/events.rpy:453
translate russian jack_event_01_b5c3cbfd:
    sasha.say "Ну... Это уже интереснее."

# ch/jack/events.rpy:454
translate russian jack_event_01_3912f570:
    jack.say "Не волнуйся, игра будет для взрослых."

# ch/jack/events.rpy:455
translate russian jack_event_01_981acc31:
    jack.say "Очень даже для взрослых..."

# ch/jack/events.rpy:456
translate russian jack_event_01_dd7659f3:
    "Вижу, что Джека всё больше занимает содержимое Сашиного полотенца."

# ch/jack/events.rpy:457
translate russian jack_event_01_0d742a35:
    "Приходится ткнуть его локтем в бок."

# ch/jack/events.rpy:458
translate russian jack_event_01_eb1730a8:
    jack.say "Ой... я... я тебе позвоню!"

# ch/jack/events.rpy:461
translate russian jack_event_01_c97c3eba:
    "Джек торопливо уходит. За ним хлопает дверь."

# ch/jack/events.rpy:462
translate russian jack_event_01_1398139c:
    "Я вздыхаю, мысленно освобождая вечера под его игру."

# ch/jack/events.rpy:463
translate russian jack_event_01_5a0854e0:
    "Пожалуй, лучше мне всё время быть рядом и за ним приглядывать."

# ch/jack/events.rpy:464
translate russian jack_event_01_216080cc:
    "Оставлять его наедине с [bree.name] и Сашей — плохая идея."

# ch/jack/events.rpy:465
translate russian jack_event_01_e937b9ad:
    "Особенно если он собирается сделать игру настолько взрослой, как обещает..."

# ch/jack/events.rpy:470
translate russian jack_event_02_6f47fb6c:
    "Когда звонит телефон, я даже не смотрю, кто это."

# ch/jack/events.rpy:471
translate russian jack_event_02_0970347b:
    "Просто подношу трубку к уху: звонящий сам представится."

# ch/jack/events.rpy:472
translate russian jack_event_02_6798e490:
    mike.say "Привет."

# ch/jack/events.rpy:473
translate russian jack_event_02_47366b2a:
    mike.say "Как дела?"

# ch/jack/events.rpy:474
translate russian jack_event_02_1d3b7549:
    jack.say "Здорово, чувак!"

# ch/jack/events.rpy:475
translate russian jack_event_02_b9e01bb7:
    jack.say "Прости, что так долго не звонил."

# ch/jack/events.rpy:476
translate russian jack_event_02_584cd0be:
    mike.say "Долго?"

# ch/jack/events.rpy:477
translate russian jack_event_02_34210195:
    mike.say "То есть... да, конечно."

# ch/jack/events.rpy:478
translate russian jack_event_02_17abb6ee:
    mike.say "Э-э... Напомни, о чём мы говорили?"

# ch/jack/events.rpy:479
translate russian jack_event_02_33551a01:
    jack.say "О ролёвке, чувак!"

# ch/jack/events.rpy:480
translate russian jack_event_02_fa7730c9:
    jack.say "Будем играть в «Демонов и полубогов»."

# ch/jack/events.rpy:481
translate russian jack_event_02_dca9ea73:
    jack.say "Помнишь? Я ещё обещал провести игру для твоих горячих соседок."

# ch/jack/events.rpy:482
translate russian jack_event_02_bc49679e:
    mike.say "А... да, конечно."

# ch/jack/events.rpy:483
translate russian jack_event_02_afccd053:
    mike.say "И для меня, да?"

# ch/jack/events.rpy:484
translate russian jack_event_02_860a3ddf:
    jack.say "А?"

# ch/jack/events.rpy:485
translate russian jack_event_02_b4852b77:
    mike.say "И для меня. Ты же говорил, нужны трое?"

# ch/jack/events.rpy:486
translate russian jack_event_02_9a1230f6:
    jack.say "Да-да... конечно!"

# ch/jack/events.rpy:487
translate russian jack_event_02_e19983ee:
    jack.say "В общем..."

# ch/jack/events.rpy:488
translate russian jack_event_02_4826486b:
    jack.say "У меня всё готово."

# ch/jack/events.rpy:489
translate russian jack_event_02_a0cdc749:
    jack.say "Я дописал приключение и уже создал персонажей."

# ch/jack/events.rpy:490
translate russian jack_event_02_1ccab2e1:
    mike.say "Хм..."

# ch/jack/events.rpy:491
translate russian jack_event_02_848a1629:
    mike.say "А я надеялся сам себе персонажа сделать."

# ch/jack/events.rpy:492
translate russian jack_event_02_c15eb647:
    mike.say "В этот раз хочется сыграть бардом или следопытом."

# ch/jack/events.rpy:493
translate russian jack_event_02_cc9da216:
    jack.say "Э-э... А я уже сделал тебе паладина, чувак."

# ch/jack/events.rpy:494
translate russian jack_event_02_0b5676b5:
    jack.say "Да и по сюжету очень нужно, чтобы ты играл именно им."

# ch/jack/events.rpy:495
translate russian jack_event_02_4f48235f:
    mike.say "А... ну ладно, тебе виднее."

# ch/jack/events.rpy:496
translate russian jack_event_02_8717ed8c:
    jack.say "Это всё ради [bree.name] и Саши, понимаешь?"

# ch/jack/events.rpy:497
translate russian jack_event_02_f0335cee:
    jack.say "Чтобы им было проще втянуться и разобраться в правилах."

# ch/jack/events.rpy:498
translate russian jack_event_02_87fa8780:
    jack.say "К тому же после четвёртой редакции кое-что изменилось. Ты тоже можешь запутаться."

# ch/jack/events.rpy:499
translate russian jack_event_02_785ae614:
    mike.say "Ну, пожалуй, логично."

# ch/jack/events.rpy:500
translate russian jack_event_02_572fa37a:
    jack.say "Отлично! Просто отлично, [hero.name]."

# ch/jack/events.rpy:501
translate russian jack_event_02_9da27ef3:
    jack.say "Как насчёт этих выходных, после обеда?"

# ch/jack/events.rpy:502
translate russian jack_event_02_c06ad69c:
    mike.say "Думаю, подойдёт."

# ch/jack/events.rpy:503
translate russian jack_event_02_45238ae4:
    mike.say "Я-то точно свободен."

# ch/jack/events.rpy:504
translate russian jack_event_02_f42c0f2c:
    mike.say "Но ещё спрошу у [bree.name] и Саши."

# ch/jack/events.rpy:505
translate russian jack_event_02_6c112787:
    mike.say "Если не перезвоню, значит, всё в силе, ладно?"

# ch/jack/events.rpy:506
translate russian jack_event_02_440dc69a:
    jack.say "Договорились, приятель."

# ch/jack/events.rpy:507
translate russian jack_event_02_86ec6955:
    jack.say "Будет ТАК круто!"

# ch/jack/events.rpy:508
translate russian jack_event_02_9637c1a2:
    "Он вешает трубку, а мне остаётся сообщить хорошие новости [bree.name] и Саше."

# ch/jack/events.rpy:518
translate russian jack_event_03_3fe289e7:
    "В назначенный день Джек приходит пораньше, и я помогаю ему подготовить всё для игры."

# ch/jack/events.rpy:519
translate russian jack_event_03_603bb607:
    "Весь обеденный стол оказывается занят книгами, кубиками и бумагами."

# ch/jack/events.rpy:520
translate russian jack_event_03_68f4fc2e:
    "Ещё приходится отгонять [bree.name] и Сашу, пока Джек не решит, что всё готово."

# ch/jack/events.rpy:521
translate russian jack_event_03_8ce24cd0:
    "Это сложнее, чем кажется: обеим очень любопытно, чем мы занимаемся."

# ch/jack/events.rpy:522
translate russian jack_event_03_7d10276b:
    jack.say "[hero.name], останови её! Это мои заметки Мастера!"

# ch/jack/events.rpy:523
translate russian jack_event_03_b4fca934:
    mike.say "Эй, [bree.name], не подглядывай!"

# ch/jack/events.rpy:525
translate russian jack_event_03_b5b2747a:
    bree.say "Ну-у, так нечестно!"

# ch/jack/events.rpy:526
translate russian jack_event_03_cd57899e:
    bree.say "Всё равно я не могу разобрать почерк Джека..."

# ch/jack/events.rpy:528
translate russian jack_event_03_5f1a56d7:
    jack.say "[hero.name], другая! Теперь другая!"

# ch/jack/events.rpy:529
translate russian jack_event_03_9751e2b2:
    mike.say "Саша, это руководство Мастера! Его можно читать только Джеку!"

# ch/jack/events.rpy:531
translate russian jack_event_03_d611f62f:
    sasha.say "Я просто хотела посмотреть картинки."

# ch/jack/events.rpy:533
translate russian jack_event_03_a2e4e1c5:
    sasha.say "Тут классные рисунки чудовищ и демонов!"

# ch/jack/events.rpy:537
translate russian jack_event_03_88604288:
    "Вскоре всё наконец готово к игре."

# ch/jack/events.rpy:538
translate russian jack_event_03_7c080dbd:
    "Джек смотрит на нас поверх ширмы Мастера."

# ch/jack/events.rpy:539
translate russian jack_event_03_0e06b428:
    jack.say "Так, вот ваши листы персонажей."

# ch/jack/events.rpy:540
translate russian jack_event_03_ff73abdd:
    bree.say "Спасибо, Джек!"

# ch/jack/events.rpy:541
translate russian jack_event_03_d276b028:
    "Джек грозит пальцем в сторону [bree.name] и качает головой."

# ch/jack/events.rpy:542
translate russian jack_event_03_cbb73ac8:
    bree.say "Ой..."

# ch/jack/events.rpy:543
translate russian jack_event_03_c0153605:
    bree.say "Что такое? Я что-то не так сделала?"

# ch/jack/events.rpy:544
translate russian jack_event_03_fac25e5c:
    mike.say "Э-э... Во время игры Джек любит, чтобы его называли Мастером..."

# ch/jack/events.rpy:545
translate russian jack_event_03_5e3b6bfc:
    bree.say "Хорошо! Спасибо, Мастер!"

# ch/jack/events.rpy:546
translate russian jack_event_03_403dfe23:
    "Джек кивает и улыбается, довольный тоном [bree.name]."

# ch/jack/events.rpy:547
translate russian jack_event_03_a3b95b19:
    "А вот Саша, как я замечаю, закатывает глаза."

# ch/jack/events.rpy:548
translate russian jack_event_03_69f8472d:
    jack.say "[bree.name], ты играешь эльфийской жрицей бога любви."

# ch/jack/events.rpy:549
translate russian jack_event_03_f9f67cdb:
    bree.say "О-о!"

# ch/jack/events.rpy:550
translate russian jack_event_03_385c91b2:
    bree.say "Обещаю нести истинную любовь и счастье повсюду, куда ступит моя нога!"

# ch/jack/events.rpy:551
translate russian jack_event_03_4026fbc5:
    sasha.say "У-у..."

# ch/jack/events.rpy:552
translate russian jack_event_03_eab9017f:
    sasha.say "Подайте мне ведро, добрые люди, ибо меня сейчас стошнит!"

# ch/jack/events.rpy:553
translate russian jack_event_03_3fd8a706:
    jack.say "Саша, ты колдунья-полудемон."

# ch/jack/events.rpy:554
translate russian jack_event_03_1d5101d4:
    sasha.say "То есть я вроде ведьмы из ада?"

# ch/jack/events.rpy:555
translate russian jack_event_03_e7182b3e:
    jack.say "В общем, да."

# ch/jack/events.rpy:556
translate russian jack_event_03_10549101:
    sasha.say "Класс!"

# ch/jack/events.rpy:557
translate russian jack_event_03_aec924dc:
    sasha.say "А можно превратить [bree.name] в лягушку?"

# ch/jack/events.rpy:558
translate russian jack_event_03_47163223:
    bree.say "Эй, Саша!"

# ch/jack/events.rpy:559
translate russian jack_event_03_22b40bc6:
    mike.say "Может, сначала с основами разберёмся?"

# ch/jack/events.rpy:560
translate russian jack_event_03_d855b21c:
    mike.say "А превращать друг друга во что-нибудь будем потом."

# ch/jack/events.rpy:561
translate russian jack_event_03_5da01c53:
    bree.say "Ой, а [hero.name]?"

# ch/jack/events.rpy:562
translate russian jack_event_03_de51d74a:
    sasha.say "Да, он-то кто?"

# ch/jack/events.rpy:563
translate russian jack_event_03_715e1135:
    bree.say "Спорим, какой-нибудь лихой пират!"

# ch/jack/events.rpy:564
translate russian jack_event_03_4a171a98:
    sasha.say "Не-а, он наверняка варвар с огромными мускулами и здоровенным тесаком!"

# ch/jack/events.rpy:565
translate russian jack_event_03_024f4d0e:
    jack.say "Обе не угадали. Он паладин."

# ch/jack/events.rpy:566
translate russian jack_event_03_7168773a:
    bree.say "Кто?!"

# ch/jack/events.rpy:567
translate russian jack_event_03_4a0e7987:
    jack.say "Священный воин, посвятивший себя защите всего доброго и чистого."

# ch/jack/events.rpy:568
translate russian jack_event_03_37c02808:
    sasha.say "Ох... Не повезло тебе, [hero.name]!"

# ch/jack/events.rpy:569
translate russian jack_event_03_bebf0efd:
    mike.say "Спасибо, Саша!"

# ch/jack/events.rpy:570
translate russian jack_event_03_9ebeff84:
    mike.say "Так, уточню, Джек: мы ОБЯЗАНЫ играть именно этими персонажами?"

# ch/jack/events.rpy:571
translate russian jack_event_03_31f41f9d:
    jack.say "Да, это необходимо для сюжета приключения."

# ch/jack/events.rpy:572
translate russian jack_event_03_08a6629e:
    mike.say "Ладно, как скажешь..."

# ch/jack/events.rpy:576
translate russian jack_event_03_257277ac:
    jack.say "Итак, жажда приключений привела вас в сонную деревушку Малые Храпки."

# ch/jack/events.rpy:577
translate russian jack_event_03_19d12289:
    jack.say "Гоблины разоряют окрестные фермы."

# ch/jack/events.rpy:578
translate russian jack_event_03_5b332a53:
    jack.say "И теперь здесь ищут отважных искателей приключений, способных положить конец набегам."

# ch/jack/events.rpy:579
translate russian jack_event_03_eba9b40b:
    jack.say "Вы втроём оказываетесь в общем зале местной таверны."

# ch/jack/events.rpy:580
translate russian jack_event_03_e0758d85:
    bree.say "Эм... А что такое таверна?"

# ch/jack/events.rpy:581
translate russian jack_event_03_a3ecff3e:
    sasha.say "Старинный бар."

# ch/jack/events.rpy:582
translate russian jack_event_03_b0521ecb:
    bree.say "А, понятно!"

# ch/jack/events.rpy:583
translate russian jack_event_03_6037365d:
    jack.say "Что вы делаете?"

# ch/jack/events.rpy:584
translate russian jack_event_03_42782e32:
    sasha.say "Подхожу к стойке и требую эля!"

# ch/jack/events.rpy:585
translate russian jack_event_03_a74c9f4d:
    bree.say "О, звучит весело! Я тоже!"

# ch/jack/events.rpy:586
translate russian jack_event_03_f7545f7b:
    mike.say "Иду за ними."

# ch/jack/events.rpy:587
translate russian jack_event_03_f34f8b7e:
    jack.say "Девица за стойкой подозрительно оглядывает [bree.name] и Сашу."

# ch/jack/events.rpy:588
translate russian jack_event_03_19e54134:
    jack.say "«Таких, как они, мы не обслуживаем!» — заявляет она, переводя взгляд с одной на другую."

# ch/jack/events.rpy:589
translate russian jack_event_03_0bb7c758:
    sasha.say "Какого чёрта?"

# ch/jack/events.rpy:590
translate russian jack_event_03_3ce38a42:
    bree.say "Эм... Это разве не расизм?!"

# ch/jack/events.rpy:593
translate russian jack_event_03_765c06cd:
    mike.say "Выступаю вперёд и осаживаю девицу."

# ch/jack/events.rpy:594
translate russian jack_event_03_31185984:
    mike.say "«Радуйся, что эльфийка вообще соизволила ступить в этот свинарник!»"

# ch/jack/events.rpy:595
translate russian jack_event_03_13e0bdcf:
    mike.say "«Изволь проявить почтение, девица!»"

# ch/jack/events.rpy:596
translate russian jack_event_03_6914da7c:
    bree.say "Ого! Мой рыцарь в сияющих доспехах!"

# ch/jack/events.rpy:597
translate russian jack_event_03_01e6b6d6:
    jack.say "Девица смущённо потупляется, получив заслуженный выговор от паладина."

# ch/jack/events.rpy:598
translate russian jack_event_03_1f69d291:
    jack.say "«Хорошо, — говорит она, — эльфийку я обслужу»."

# ch/jack/events.rpy:599
translate russian jack_event_03_49da8cac:
    jack.say "«Но не эту адскую суку рядом с ней!»"

# ch/jack/events.rpy:601
translate russian jack_event_03_5ace3312:
    sasha.say "Эй!"

# ch/jack/events.rpy:604
translate russian jack_event_03_765c06cd_1:
    mike.say "Выступаю вперёд и осаживаю девицу."

# ch/jack/events.rpy:605
translate russian jack_event_03_965d02f5:
    mike.say "«Я паладин священного ордена и ручаюсь за эту деву»."

# ch/jack/events.rpy:606
translate russian jack_event_03_bb59445d:
    mike.say "«Ты смеешь сомневаться в моих суждениях, девица?!»"

# ch/jack/events.rpy:607
translate russian jack_event_03_3f8e95c8:
    sasha.say "Да, [hero.name], покажи этой суке!"

# ch/jack/events.rpy:608
translate russian jack_event_03_01e6b6d6_1:
    jack.say "Девица смущённо потупляется, получив заслуженный выговор от паладина."

# ch/jack/events.rpy:609
translate russian jack_event_03_02eff03e:
    jack.say "«Хорошо, — говорит она, — отродье ада я обслужу»."

# ch/jack/events.rpy:610
translate russian jack_event_03_e66c16b5:
    jack.say "«Но не эту остроухую суку рядом с ней!»"

# ch/jack/events.rpy:612
translate russian jack_event_03_94966ff5:
    bree.say "Эй!"

# ch/jack/events.rpy:615
translate russian jack_event_03_7b3c97b1:
    jack.say "Получив напитки, вы занимаете свободный стол."

# ch/jack/events.rpy:616
translate russian jack_event_03_cd3ed820:
    jack.say "И тут замечаете маленького старичка, который подходит к вам."

# ch/jack/events.rpy:617
translate russian jack_event_03_5d572f26:
    jack.say "«Приветствую, — говорит он. — Вижу, вы могучие искатели приключений»."

# ch/jack/events.rpy:618
translate russian jack_event_03_151835a5:
    jack.say "«Меня зовут старейшина Перкинс. Я хотел бы попросить вас помочь с гоблинами в холмах»."

# ch/jack/events.rpy:620
translate russian jack_event_03_3f3e206a:
    sasha.say "Наклоняюсь вперёд и смотрю ему прямо в глаза."

# ch/jack/events.rpy:621
translate russian jack_event_03_27e01fa3:
    sasha.say "«Эй, старик! Мы бесплатно не работаем!»"

# ch/jack/events.rpy:622
translate russian jack_event_03_df6304eb:
    bree.say "Саша, это жестоко!"

# ch/jack/events.rpy:623
translate russian jack_event_03_f6fc6211:
    bree.say "«Не беспокойтесь, старейшина Перкинс, моя спутница ошибается»."

# ch/jack/events.rpy:624
translate russian jack_event_03_f243a21e:
    bree.say "«Мы сделаем это по доброте душевной»."

# ch/jack/events.rpy:627
translate russian jack_event_03_67ad3c5c:
    mike.say "[bree.name] права, Саша."

# ch/jack/events.rpy:628
translate russian jack_event_03_fa7de609:
    mike.say "К тому же у гоблинов может найтись какая-нибудь добыча."

# ch/jack/events.rpy:629
translate russian jack_event_03_8d9ef695:
    mike.say "«Да, старейшина. Мы совершим это деяние, ибо так велит нам долг»."

# ch/jack/events.rpy:630
translate russian jack_event_03_60da5344:
    bree.say "Видишь, Саша?"

# ch/jack/events.rpy:631
translate russian jack_event_03_3ddea859:
    bree.say "Быть хорошей приятно!"

# ch/jack/events.rpy:633
translate russian jack_event_03_e6543c08:
    sasha.say "С вами двумя никакого веселья!"

# ch/jack/events.rpy:636
translate russian jack_event_03_f2298aa9:
    mike.say "Саша права, [bree.name]."

# ch/jack/events.rpy:637
translate russian jack_event_03_fe8207f0:
    mike.say "Нам нужны деньги на снаряжение и всё такое."

# ch/jack/events.rpy:638
translate russian jack_event_03_8e1cbeda:
    mike.say "«Нет, старейшина. Мы вынуждены настаивать на денежном вознаграждении»."

# ch/jack/events.rpy:639
translate russian jack_event_03_c9d5b813:
    mike.say "«Хотя бы ради того, чтобы у нас были средства выполнить ваше поручение»."

# ch/jack/events.rpy:640
translate russian jack_event_03_33008842:
    sasha.say "Видишь, [bree.name]?"

# ch/jack/events.rpy:641
translate russian jack_event_03_4908d8ba:
    sasha.say "Надо знать себе цену!"

# ch/jack/events.rpy:643
translate russian jack_event_03_5439ffea:
    bree.say "Какие же вы оба злые!"

# ch/jack/events.rpy:646
translate russian jack_event_03_0c984083:
    jack.say "Старейшина Перкинс согласно кивает."

# ch/jack/events.rpy:647
translate russian jack_event_03_4014ff56:
    jack.say "«Договорились», — говорит он."

# ch/jack/events.rpy:648
translate russian jack_event_03_aee231a4:
    jack.say "«Чтобы помочь вам в пути, могу предложить на выбор одну из этих двух вещей»."

# ch/jack/events.rpy:649
translate russian jack_event_03_967e665e:
    jack.say "Он извлекает из складок одежды два пузырька с жидкостью."

# ch/jack/events.rpy:650
translate russian jack_event_03_7e652d90:
    jack.say "Синей и красной."

# ch/jack/events.rpy:652
translate russian jack_event_03_8123e45d:
    sasha.say "Это что, блядь, «Матрица», только по уши в грязи?"

# ch/jack/events.rpy:653
translate russian jack_event_03_bce16e7b:
    bree.say "Саша!"

# ch/jack/events.rpy:654
translate russian jack_event_03_fc15c4e2:
    jack.say "«Зелье исцеления или зелье огненных шаров»."

# ch/jack/events.rpy:655
translate russian jack_event_03_e96ff7f5:
    jack.say "«Выбрать можно лишь одно. Выбирайте с умом!»"

# ch/jack/events.rpy:656
translate russian jack_event_03_ce27439a:
    bree.say "Может, возьмём исцеляющее?"

# ch/jack/events.rpy:657
translate russian jack_event_03_289e4d42:
    bree.say "На случай, если кого-то ранят?"

# ch/jack/events.rpy:658
translate russian jack_event_03_08c11d03:
    sasha.say "Да ну его! Я хочу зелье огненных шаров!"

# ch/jack/events.rpy:659
translate russian jack_event_03_e04f597d:
    mike.say "Ну, [bree.name] — жрица."

# ch/jack/events.rpy:660
translate russian jack_event_03_fe27d12e:
    mike.say "У неё уже есть исцеляющие заклинания."

# ch/jack/events.rpy:661
translate russian jack_event_03_7c9044c5:
    sasha.say "Тогда решено: берём зелье огненных шаров."

# ch/jack/events.rpy:662
translate russian jack_event_03_f9f67cdb_1:
    bree.say "Ну-у!"

# ch/jack/events.rpy:665
translate russian jack_event_03_a33f5211:
    mike.say "Погоди, Саша."

# ch/jack/events.rpy:666
translate russian jack_event_03_02dc2ef2:
    mike.say "Если [bree.name] будет слишком сильно ранена, чтобы колдовать, нам пригодится запасной вариант."

# ch/jack/events.rpy:667
translate russian jack_event_03_3a7f4ed1:
    mike.say "Так что лучше взять зелье исцеления."

# ch/jack/events.rpy:668
translate russian jack_event_03_7ce3348f:
    bree.say "Вот! Я же говорила, что права!"

# ch/jack/events.rpy:670
translate russian jack_event_03_428af437:
    sasha.say "СКУКОТА!"

# ch/jack/events.rpy:673
translate russian jack_event_03_55d12f57:
    mike.say "Надо взять зелье огненных шаров, [bree.name]."

# ch/jack/events.rpy:674
translate russian jack_event_03_6e0931f7:
    mike.say "Лечить должна жрица. Она вроде нашего медика."

# ch/jack/events.rpy:675
translate russian jack_event_03_f45a85dd:
    mike.say "Тебе стоит разобраться, для чего нужен твой персонаж."

# ch/jack/events.rpy:676
translate russian jack_event_03_5d96a545:
    sasha.say "Ага, [bree.name], знай свою роль!"

# ch/jack/events.rpy:678
translate russian jack_event_03_dcee3f39:
    bree.say "Я... прости, [hero.name]."

# ch/jack/events.rpy:679
translate russian jack_event_03_231b82e2:
    bree.say "Я ведь раньше в такое не играла..."

# ch/jack/events.rpy:682
translate russian jack_event_03_d5bd6214:
    "Мы получили первое задание и выбранное зелье, и тут Джек решает, что на сегодня хватит."

# ch/jack/events.rpy:683
translate russian jack_event_03_1a90c0b8:
    jack.say "Думаю, пока на этом остановимся."

# ch/jack/events.rpy:684
translate russian jack_event_03_f6e6a4b8:
    jack.say "Ну что, девушки, как вам первая ролевая сессия?"

# ch/jack/events.rpy:686
translate russian jack_event_03_e4ee0299:
    bree.say "Только не сердись на меня, [hero.name]."

# ch/jack/events.rpy:688
translate russian jack_event_03_958ae672:
    bree.say "Но мне не понравилось."

# ch/jack/events.rpy:689
translate russian jack_event_03_860a3ddf:
    jack.say "А?"

# ch/jack/events.rpy:690
translate russian jack_event_03_17dab93c:
    mike.say "Почему, [bree.name]?"

# ch/jack/events.rpy:691
translate russian jack_event_03_1a2b51fa:
    "[bree.name] глубоко вздыхает, прежде чем ответить."

# ch/jack/events.rpy:692
translate russian jack_event_03_1b59df79:
    bree.say "Ну..."

# ch/jack/events.rpy:693
translate russian jack_event_03_e4880519:
    bree.say "Мне казалось, что вы с Сашей надо мной издеваетесь, понимаешь?"

# ch/jack/events.rpy:694
translate russian jack_event_03_86d07102:
    mike.say "А..."

# ch/jack/events.rpy:695
translate russian jack_event_03_457cf6b4:
    mike.say "Прости, [bree.name]."

# ch/jack/events.rpy:696
translate russian jack_event_03_4026fbc5_1:
    sasha.say "У-у..."

# ch/jack/events.rpy:697
translate russian jack_event_03_10991eb5:
    sasha.say "Это просто игра, [bree.name]."

# ch/jack/events.rpy:698
translate russian jack_event_03_2f86f74a:
    sasha.say "Зачем принимать всё на свой счёт?"

# ch/jack/events.rpy:699
translate russian jack_event_03_f1172221:
    bree.say "Но мне всё равно неприятно."

# ch/jack/events.rpy:700
translate russian jack_event_03_a062db01:
    bree.say "И больше я, пожалуй, играть не хочу."

# ch/jack/events.rpy:701
translate russian jack_event_03_ee2b96a2:
    sasha.say "А я хочу!"

# ch/jack/events.rpy:702
translate russian jack_event_03_53c76925:
    sasha.say "Сыграем в следующие выходные?"

# ch/jack/events.rpy:703
translate russian jack_event_03_63989b00:
    mike.say "Я за."

# ch/jack/events.rpy:704
translate russian jack_event_03_5ede9ab7:
    mike.say "Может, будем собираться регулярно?"

# ch/jack/events.rpy:707
translate russian jack_event_03_2afece47:
    sasha.say "По-моему, полный отстой!"

# ch/jack/events.rpy:708
translate russian jack_event_03_860a3ddf_1:
    jack.say "А?"

# ch/jack/events.rpy:709
translate russian jack_event_03_3da959e7:
    mike.say "Почему, Саша?"

# ch/jack/events.rpy:710
translate russian jack_event_03_fb600190:
    "Саша раздражённо качает головой."

# ch/jack/events.rpy:711
translate russian jack_event_03_a0edc6a9:
    sasha.say "Да скукота же!"

# ch/jack/events.rpy:712
translate russian jack_event_03_09e2fb75:
    sasha.say "Я хочу быть злой, ведь я играю демоном."

# ch/jack/events.rpy:713
translate russian jack_event_03_b1fc005e:
    sasha.say "А вы оба такие праведники!"

# ch/jack/events.rpy:714
translate russian jack_event_03_86d07102_1:
    mike.say "А..."

# ch/jack/events.rpy:715
translate russian jack_event_03_fdec6848:
    mike.say "Прости, Саша."

# ch/jack/events.rpy:716
translate russian jack_event_03_277f81ae:
    bree.say "Ну, Саша."

# ch/jack/events.rpy:717
translate russian jack_event_03_03bdeb0c:
    bree.say "Это же просто игра!"

# ch/jack/events.rpy:718
translate russian jack_event_03_2f4fad37:
    sasha.say "Именно, [bree.name]."

# ch/jack/events.rpy:719
translate russian jack_event_03_6d17e9fe:
    sasha.say "Просто дурацкая детская игра, вот и всё."

# ch/jack/events.rpy:720
translate russian jack_event_03_48cfab5b:
    sasha.say "У меня есть занятия поинтереснее!"

# ch/jack/events.rpy:721
translate russian jack_event_03_3baace99:
    bree.say "А я хочу продолжить."

# ch/jack/events.rpy:722
translate russian jack_event_03_012a35d5:
    bree.say "Сыграем в следующие выходные?"

# ch/jack/events.rpy:723
translate russian jack_event_03_63989b00_1:
    mike.say "Я за."

# ch/jack/events.rpy:724
translate russian jack_event_03_5ede9ab7_1:
    mike.say "Может, будем собираться регулярно?"

# ch/jack/events.rpy:726
translate russian jack_event_03_8b6acf02:
    bree.say "А мне очень понравилось."

# ch/jack/events.rpy:727
translate russian jack_event_03_316c8da2:
    mike.say "Правда?!"

# ch/jack/events.rpy:728
translate russian jack_event_03_bef91a50:
    mike.say "Здорово, [bree.name]!"

# ch/jack/events.rpy:729
translate russian jack_event_03_41bf32ed:
    sasha.say "Да, было прикольно."

# ch/jack/events.rpy:730
translate russian jack_event_03_f5b363d9:
    sasha.say "Хочу узнать, что делают мои заклинания!"

# ch/jack/events.rpy:731
translate russian jack_event_03_3daa704a:
    bree.say "О-о, я тоже!"

# ch/jack/events.rpy:732
translate russian jack_event_03_249eddfa:
    jack.say "Значит, хотите ещё сыграть?"

# ch/jack/events.rpy:733
translate russian jack_event_03_7db5f3dc:
    bree.say "Ещё бы!"

# ch/jack/events.rpy:734
translate russian jack_event_03_53c76925_1:
    sasha.say "Сыграем в следующие выходные?"

# ch/jack/events.rpy:735
translate russian jack_event_03_63989b00_2:
    mike.say "Я за."

# ch/jack/events.rpy:736
translate russian jack_event_03_5ede9ab7_2:
    mike.say "Может, будем собираться регулярно?"

# ch/jack/events.rpy:737
translate russian jack_event_03_29dfeb4f:
    sasha.say "Только чтобы в следующий раз дали порубить гоблинов!"

# ch/jack/events.rpy:738
translate russian jack_event_03_e010ab56:
    bree.say "Мне тоже оставь, Саша!"

# ch/jack/events.rpy:745
translate russian jack_event_03_7c68b9e9:
    "Когда [bree.name] и Саша выходят, я помогаю Джеку собрать вещи."

# ch/jack/events.rpy:746
translate russian jack_event_03_9a54c0e5:
    jack.say "По-моему, всё прошло неплохо."

# ch/jack/events.rpy:747
translate russian jack_event_03_ff74e279:
    mike.say "Для новичков вполне хорошо."

# ch/jack/events.rpy:748
translate russian jack_event_03_ec4598fc:
    jack.say "Значит, увидимся в следующие выходные, в то же время?"

# ch/jack/events.rpy:749
translate russian jack_event_03_b6953082:
    mike.say "Конечно, Мастер!"

# ch/jack/events.rpy:760
translate russian jack_event_04_793da272:
    "Снова наступает [lssb_jack.day_text(today)], и после обеда [bree.name] и Саша уже не находят себе места."

# ch/jack/events.rpy:761
translate russian jack_event_04_38746ab4:
    "Признаться, меня удивляет, как сильно они ждут прихода Джека."

# ch/jack/events.rpy:762
translate russian jack_event_04_edfd090e:
    "Никогда бы не подумал, что двух таких красоток так увлечёт игра в «ДД»!"

# ch/jack/events.rpy:764
translate russian jack_event_04_46959dfc:
    bree.say "Который час, [hero.name]?"

# ch/jack/events.rpy:765
translate russian jack_event_04_4b693c09:
    mike.say "Эм... Минут на пять позже, чем когда ты спрашивала в прошлый раз, [bree.name]!"

# ch/jack/events.rpy:768
translate russian jack_event_04_4026fbc5:
    sasha.say "У-у..."

# ch/jack/events.rpy:769
translate russian jack_event_04_2d291e26:
    sasha.say "Кажется, мы уже целую вечность ждём!"

# ch/jack/events.rpy:770
translate russian jack_event_04_c35d45ff:
    mike.say "Правда, Саша?"

# ch/jack/events.rpy:771
translate russian jack_event_04_e33e5750:
    mike.say "Джек ведь даже ещё не опоздал..."

# ch/jack/events.rpy:775
translate russian jack_event_04_ef40abbd:
    "Мы уже сидим за обеденным столом, и я всё подготовил."

# ch/jack/events.rpy:776
translate russian jack_event_04_bb4173c4:
    "Я решил, что быстрее достать мои принадлежности для игры, чем ждать, пока Джек разложит свои."

# ch/jack/events.rpy:777
translate russian jack_event_04_be90766c:
    "Но от этого [bree.name] и Саше, кажется, лишь ещё сильнее не терпится начать."

# ch/jack/events.rpy:778
translate russian jack_event_04_3406f294:
    "Саша откидывается на спинку стула и закатывает глаза."

# ch/jack/events.rpy:779
translate russian jack_event_04_1822e5ad:
    "А [bree.name] наваливается на стол и кладёт голову на руки поверх листа персонажа."

# ch/jack/events.rpy:780
translate russian jack_event_04_674f82f0:
    mike.say "Эй, не кисните!"

# ch/jack/events.rpy:781
translate russian jack_event_04_5d025681:
    mike.say "Уверен, он придёт вовремя."

# ch/jack/events.rpy:782
translate russian jack_event_04_a87eb2c1:
    "Я отчаянно ищу, чем бы отвлечь девушек."

# ch/jack/events.rpy:783
translate russian jack_event_04_6916050e:
    "И тут замечаю, что у каждой новый набор кубиков."

# ch/jack/events.rpy:784
translate russian jack_event_04_94d30163:
    mike.say "Ого! Вы купили себе кубики?"

# ch/jack/events.rpy:785
translate russian jack_event_04_4f73aa26:
    mike.say "Теперь вы настоящие ролевики!"

# ch/jack/events.rpy:786
translate russian jack_event_04_47d7e832:
    "Обе сразу оживляются."

# ch/jack/events.rpy:787
translate russian jack_event_04_ca574c97:
    "Я вспоминаю, как они любят хвастаться обновками после похода по магазинам."

# ch/jack/events.rpy:788
translate russian jack_event_04_7dfa4521:
    "Похоже, с покупками для игры всё точно так же!"

# ch/jack/events.rpy:789
translate russian jack_event_04_5af940e0:
    bree.say "Посмотри на мои кубики, [hero.name]."

# ch/jack/events.rpy:790
translate russian jack_event_04_3d16e1b6:
    bree.say "Они такие милые!"

# ch/jack/events.rpy:792
translate russian jack_event_04_630c0e98:
    sasha.say "Да-да, [bree.name]..."

# ch/jack/events.rpy:794
translate russian jack_event_04_66b67068:
    sasha.say "На самом деле ему интересны мои. Они офигенно крутые!"

# ch/jack/events.rpy:795
translate russian jack_event_04_b7bf2c5a:
    "Обе тут же начинают размахивать кубиками у меня перед носом!"

# ch/jack/events.rpy:796
translate russian jack_event_04_cf61ad9a:
    "У [bree.name] они ярко-розовые, да ещё и с блёстками."

# ch/jack/events.rpy:797
translate russian jack_event_04_5ebea1f6:
    "У Саши — глянцево-чёрные, с прожилками цвета крови."

# ch/jack/events.rpy:800
translate russian jack_event_04_e8056f87:
    mike.say "Ха!"

# ch/jack/events.rpy:801
translate russian jack_event_04_eda887f1:
    mike.say "Так и знал, что ты выберешь розовые, [bree.name]!"

# ch/jack/events.rpy:802
translate russian jack_event_04_24278a5b:
    bree.say "А?"

# ch/jack/events.rpy:803
translate russian jack_event_04_5d61641d:
    bree.say "Это почему?"

# ch/jack/events.rpy:804
translate russian jack_event_04_1c0d45e8:
    mike.say "Ну..."

# ch/jack/events.rpy:805
translate russian jack_event_04_6a542bc1:
    mike.say "Ты же жрица богини любви."

# ch/jack/events.rpy:806
translate russian jack_event_04_fbd9b268:
    mike.say "Розовый — цвет заботы и исцеления, понимаешь?"

# ch/jack/events.rpy:807
translate russian jack_event_04_8d03209e:
    bree.say "Понимаю, о чём ты."

# ch/jack/events.rpy:808
translate russian jack_event_04_27849dda:
    bree.say "Моя миссия — нести любовь и гармонию повсюду!"

# ch/jack/events.rpy:810
translate russian jack_event_04_ab16bf8e:
    sasha.say "Фу-у..."

# ch/jack/events.rpy:811
translate russian jack_event_04_1adf3f44:
    sasha.say "Дайте ведро, меня сейчас вырвет!"

# ch/jack/events.rpy:812
translate russian jack_event_04_6e30afb5:
    bree.say "САША!"

# ch/jack/events.rpy:815
translate russian jack_event_04_edd4ce45:
    mike.say "О-о..."

# ch/jack/events.rpy:816
translate russian jack_event_04_95a5af7f:
    mike.say "Какие мрачные, Саша."

# ch/jack/events.rpy:817
translate russian jack_event_04_eccdc04d:
    mike.say "Мне нравится!"

# ch/jack/events.rpy:818
translate russian jack_event_04_ff188b8a:
    sasha.say "Да ну?"

# ch/jack/events.rpy:819
translate russian jack_event_04_58b7d645:
    sasha.say "И что именно тебе нравится?"

# ch/jack/events.rpy:820
translate russian jack_event_04_0895a8c4:
    mike.say "Они подходят к твоему образу."

# ch/jack/events.rpy:821
translate russian jack_event_04_7e8d7875:
    mike.say "Мрачная колдунья с душевными терзаниями и загадочным прошлым."

# ch/jack/events.rpy:822
translate russian jack_event_04_7868d659:
    sasha.say "Да... Да, мне нравится!"

# ch/jack/events.rpy:823
translate russian jack_event_04_a3e64d43:
    sasha.say "Я вроде злая, но за этим кроется глубокая личность."

# ch/jack/events.rpy:825
translate russian jack_event_04_c0675a21:
    bree.say "Или просто готичная потаскушка!"

# ch/jack/events.rpy:826
translate russian jack_event_04_3abb2fbe:
    sasha.say "БРИ!"

# ch/jack/events.rpy:830
translate russian jack_event_04_3704c0c4:
    "И тут раздаётся звонок в дверь."

# ch/jack/events.rpy:831
translate russian jack_event_04_445ca966:
    "Вот уж спасительный звонок!"

# ch/jack/events.rpy:832
translate russian jack_event_04_f618d66b:
    "Хоть я и был уверен, что он придёт, всё равно с облегчением вижу за дверью Джека!"

# ch/jack/events.rpy:836
translate russian jack_event_04_d448b5d4:
    jack.say "Привет, чувак."

# ch/jack/events.rpy:837
translate russian jack_event_04_8b860de2:
    mike.say "Привет, Джек! Как же я рад тебя видеть!"

# ch/jack/events.rpy:838
translate russian jack_event_04_88083bbb:
    "Тащу Джека через дом, даже не давая ему отдышаться."

# ch/jack/events.rpy:839
translate russian jack_event_04_05a641cf:
    jack.say "Чт... Что случилось?!"

# ch/jack/events.rpy:840
translate russian jack_event_04_ad0fd35d:
    mike.say "Местное население бунтует!"

# ch/jack/events.rpy:841
translate russian jack_event_04_ab03ad06:
    "Джек ожидаемо смотрит на меня с недоумением."

# ch/jack/events.rpy:842
translate russian jack_event_04_cd3d0c8d:
    "Но тут я вталкиваю его в столовую, и он видит [bree.name] и Сашу."

# ch/jack/events.rpy:847
translate russian jack_event_04_53058d64:
    jack.say "ПРИВЕТ, ДАМЫ!"

# ch/jack/events.rpy:848
translate russian jack_event_04_c8513d09:
    jack.say "Кто готов к горячим и бурным ролевым играм?!"

# ch/jack/events.rpy:850
translate russian jack_event_04_ddc92f7a:
    bree.say "О-о, я! Я готова!"

# ch/jack/events.rpy:852
translate russian jack_event_04_59a26c85:
    sasha.say "Я в деле, Мастер!"

# ch/jack/events.rpy:854
translate russian jack_event_04_2a683dc3:
    "Садясь, Джек улыбается мне, счастливый, что всё их внимание приковано к нему."

# ch/jack/events.rpy:855
translate russian jack_event_04_af2f1219:
    "Спорим, у него сейчас так стоит, что можно стекло резать!"

# ch/jack/events.rpy:856
translate russian jack_event_04_8bed154e:
    "Я занимаю своё место, а Джек раскладывает вещи и входит в привычную колею."

# ch/jack/events.rpy:857
translate russian jack_event_04_afed67c6:
    jack.say "Так, вкратце напомню."

# ch/jack/events.rpy:858
translate russian jack_event_04_165cef01:
    jack.say "Прекрасная жрица [bree.name] и знойная чародейка Саша откликнулись на призыв сразиться с гоблинами!"

# ch/jack/events.rpy:859
translate russian jack_event_04_11211a87:
    bree.say "Точно!"

# ch/jack/events.rpy:860
translate russian jack_event_04_0d087b5c:
    sasha.say "Надерём задницы этим гоблинским ублюдкам!"

# ch/jack/events.rpy:861
translate russian jack_event_04_e6371bd6:
    mike.say "Эм... А как же я?"

# ch/jack/events.rpy:862
translate russian jack_event_04_f3d79c3d:
    jack.say "Что?!"

# ch/jack/events.rpy:863
translate russian jack_event_04_c9bf02eb:
    jack.say "А, да... И паладин [hero.name] тоже увязался с ними."

# ch/jack/events.rpy:864
translate russian jack_event_04_f0260af0:
    "Стараюсь не показать, что Джек меня раздражает."

# ch/jack/events.rpy:865
translate russian jack_event_04_2bec5836:
    "Наверное, стоит его простить."

# ch/jack/events.rpy:866
translate russian jack_event_04_8de00fd0:
    "Всё-таки нечасто девушки ловят каждое его слово."

# ch/jack/events.rpy:868
translate russian jack_event_04_408c4fc6:
    minami.say "О-о!"

# ch/jack/events.rpy:869
translate russian jack_event_04_2bcbc7e5:
    "Мы все одновременно поднимаем головы: в комнату влетает Минами."

# ch/jack/events.rpy:870
translate russian jack_event_04_0cf1df41:
    minami.say "Кубики... карандаши и бумага... потный задрот..."

# ch/jack/events.rpy:871
translate russian jack_event_04_103a42c9:
    jack.say "Эй!"

# ch/jack/events.rpy:872
translate russian jack_event_04_fdf99d44:
    minami.say "Вы что, в ролёвку играете?!"

# ch/jack/events.rpy:873
translate russian jack_event_04_d1bd9c06:
    mike.say "Э-э, да, Минами."

# ch/jack/events.rpy:874
translate russian jack_event_04_2d2b901a:
    mike.say "А тебе что?"

# ch/jack/events.rpy:875
translate russian jack_event_04_c4793f82:
    minami.say "Я тоже хочу!"

# ch/jack/events.rpy:876
translate russian jack_event_04_8f7c01c8:
    "Мы с [bree.name] и Сашей тревожно переглядываемся."

# ch/jack/events.rpy:877
translate russian jack_event_04_62f73b87:
    mike.say "Не знаю, Минами..."

# ch/jack/events.rpy:878
translate russian jack_event_04_b71a398d:
    bree.say "У нас уже есть персонажи..."

# ch/jack/events.rpy:879
translate russian jack_event_04_72eeefc5:
    sasha.say "Мы уже начали задание..."

# ch/jack/events.rpy:880
translate russian jack_event_04_d56e27ff:
    jack.say "Конечно, Минами, присоединяйся!"

# ch/jack/events.rpy:881
translate russian jack_event_04_82b0cbdc:
    "Мы все смотрим на Джека, разинув рты."

# ch/jack/events.rpy:882
translate russian jack_event_04_2404f912:
    jack.say "Я Мастер игры, и я разрешаю ей играть."

# ch/jack/events.rpy:884
translate russian jack_event_04_ab3aec6c:
    minami.say "УРА!"

# ch/jack/events.rpy:885
translate russian jack_event_04_22a63ccc:
    jack.say "Кстати, так уж вышло, что я создал персонажа и для Минами."

# ch/jack/events.rpy:886
translate russian jack_event_04_9282d111:
    jack.say "На случай, если она захочет присоединиться."

# ch/jack/events.rpy:887
translate russian jack_event_04_365d0ee5:
    "Минами сияет, получая от Джека лист персонажа."

# ch/jack/events.rpy:888
translate russian jack_event_04_501e6f4c:
    "И я вспоминаю, как очевидно он был в неё влюблён, хоть и всегда это отрицал."

# ch/jack/events.rpy:889
translate russian jack_event_04_53839469:
    minami.say "Это что? Тут написано, что я полурослик!"

# ch/jack/events.rpy:890
translate russian jack_event_04_863f7dae:
    jack.say "Верно! Ловкая и хитрая воровка-полурослик!"

# ch/jack/events.rpy:892
translate russian jack_event_04_b48984ea:
    minami.say "Ну-у, я не хочу быть полуросликом."

# ch/jack/events.rpy:893
translate russian jack_event_04_60248c60:
    "Минами дуется и канючит, глядя исключительно на Джека."

# ch/jack/events.rpy:894
translate russian jack_event_04_26466760:
    minami.say "Я хочу быть девушкой-кошкой! Можно, Джек?"

# ch/jack/events.rpy:895
translate russian jack_event_04_c84bb64e:
    jack.say "Конечно, Минами."

# ch/jack/events.rpy:896
translate russian jack_event_04_396252cb:
    "Джек хватает её лист персонажа и торопливо стирает часть карандашных записей."

# ch/jack/events.rpy:897
translate russian jack_event_04_1e0f8f3c:
    "Внеся нужные исправления, тут же возвращает его."

# ch/jack/events.rpy:899
translate russian jack_event_04_d8855420:
    jack.say "За ночь вы знакомитесь с Минами, воровкой-девушкой-кошкой."

# ch/jack/events.rpy:900
translate russian jack_event_04_9e94ec82:
    jack.say "И понимаете, что она станет ценным пополнением вашего отряда."

# ch/jack/events.rpy:902
translate russian jack_event_04_63217764:
    "[bree.name] и Саша закатывают глаза, а я лишь раздражённо вздыхаю."

# ch/jack/events.rpy:903
translate russian jack_event_04_8df5e793:
    "Всем троим очевидно, что Джек позволит Минами абсолютно всё."

# ch/jack/events.rpy:905
translate russian jack_event_04_ea941eb6:
    jack.say "Для начала — очки опыта!"

# ch/jack/events.rpy:906
translate russian jack_event_04_d60d2c0f:
    sasha.say "А это ещё что?"

# ch/jack/events.rpy:907
translate russian jack_event_04_bb583963:
    mike.say "Награда за героические поступки, Саша."

# ch/jack/events.rpy:908
translate russian jack_event_04_19819f61:
    bree.say "Ага, как когда прокачиваешь персонажа в видеоигре."

# ch/jack/events.rpy:911
translate russian jack_event_04_822a9e33:
    jack.say "Итак..."

# ch/jack/events.rpy:912
translate russian jack_event_04_e419d18a:
    jack.say "Саша и [hero.name], вы получаете по девятьсот очков."

# ch/jack/events.rpy:913
translate russian jack_event_04_49799a10:
    jack.say "Запишите в листы персонажей."

# ch/jack/events.rpy:914
translate russian jack_event_04_1e55683d:
    jack.say "А ты, [bree.name], получаешь тысячу."

# ch/jack/events.rpy:915
translate russian jack_event_04_a432ef60:
    jack.say "И переходишь на следующий уровень!"

# ch/jack/events.rpy:916
translate russian jack_event_04_19fbc8e9:
    bree.say "УРА!"

# ch/jack/events.rpy:918
translate russian jack_event_04_35234f44:
    sasha.say "Эй, погоди! Почему ей больше, чем нам?"

# ch/jack/events.rpy:919
translate russian jack_event_04_2710b0bf:
    jack.say "Э-э... ну..."

# ch/jack/events.rpy:920
translate russian jack_event_04_bd9ab961:
    jack.say "За... за отыгрыш персонажа! Вот!"

# ch/jack/events.rpy:921
translate russian jack_event_04_5a2b478f:
    jack.say "[bree.name] была очень добра ко всем, как и положено жрице бога любви."

# ch/jack/events.rpy:922
translate russian jack_event_04_f65caf31:
    "[bree.name] продолжает купаться в похвале Джека."

# ch/jack/events.rpy:923
translate russian jack_event_04_abb46f40:
    "А вот как Саша на него хмурится, я почти чувствую, даже не глядя!"

# ch/jack/events.rpy:926
translate russian jack_event_04_822a9e33_1:
    jack.say "Итак..."

# ch/jack/events.rpy:927
translate russian jack_event_04_8c730071:
    jack.say "[bree.name] и [hero.name], вы получаете по девятьсот очков."

# ch/jack/events.rpy:928
translate russian jack_event_04_49799a10_1:
    jack.say "Запишите в листы персонажей."

# ch/jack/events.rpy:929
translate russian jack_event_04_57b2d2b2:
    jack.say "А ты, Саша, получаешь тысячу."

# ch/jack/events.rpy:930
translate russian jack_event_04_a432ef60_1:
    jack.say "И переходишь на следующий уровень!"

# ch/jack/events.rpy:931
translate russian jack_event_04_be031dbc:
    sasha.say "Отлично!"

# ch/jack/events.rpy:933
translate russian jack_event_04_e2fe0902:
    bree.say "Нечестно! Почему ей больше, чем нам?"

# ch/jack/events.rpy:934
translate russian jack_event_04_2710b0bf_1:
    jack.say "Э-э... ну..."

# ch/jack/events.rpy:935
translate russian jack_event_04_bd9ab961_1:
    jack.say "За... за отыгрыш персонажа! Вот!"

# ch/jack/events.rpy:936
translate russian jack_event_04_36bf8fdc:
    jack.say "Саша была злая и дерзкая, как и положено чародейке-полудемону."

# ch/jack/events.rpy:937
translate russian jack_event_04_bda494d2:
    "Саша продолжает купаться в похвале Джека."

# ch/jack/events.rpy:938
translate russian jack_event_04_8d764aad:
    "А [bree.name] скрещивает руки на груди и недовольно хмыкает."

# ch/jack/events.rpy:943
translate russian jack_event_04_d16dbd5f:
    jack.say "Так, идём дальше..."

# ch/jack/events.rpy:944
translate russian jack_event_04_8d9b6a70:
    jack.say "На следующее утро вы покидаете деревню и отправляетесь к логову гоблинов."

# ch/jack/events.rpy:950
translate russian jack_event_04_0ecc541c:
    "Джек заставляет нас отыгрывать почти весь путь."

# ch/jack/events.rpy:951
translate russian jack_event_04_3a4020a1:
    "Приходится бросать кубики на случайные встречи и всё такое."

# ch/jack/events.rpy:952
translate russian jack_event_04_a34f7b3b:
    "Мне скучновато, но, наверное, он хочет научить девушек играть."

# ch/jack/events.rpy:953
translate russian jack_event_04_d8a11883:
    "Вообще-то он пока ведёт себя прилично, без всяких пошлостей."

# ch/jack/events.rpy:954
translate russian jack_event_04_39f7c0f1:
    "До тех пор, пока нам не приходит пора разбить лагерь на ночь..."

# ch/jack/events.rpy:956
translate russian jack_event_04_623e44d8:
    jack.say "Итак, вы находите подходящее место и собираете дрова для костра."

# ch/jack/events.rpy:957
translate russian jack_event_04_6b72e826:
    jack.say "Но когда достаёте спальные мешки, тебя, [hero.name], ждёт неприятный сюрприз."

# ch/jack/events.rpy:958
translate russian jack_event_04_5bfb8d6b:
    jack.say "На твоём рюкзаке порвался ремень, и спальный мешок куда-то пропал!"

# ch/jack/events.rpy:959
translate russian jack_event_04_6fca0d88:
    sasha.say "Упс! Не повезло тебе, [hero.name]!"

# ch/jack/events.rpy:960
translate russian jack_event_04_851270d9:
    bree.say "О нет! Ты же всю ночь будешь дрожать от холода!"

# ch/jack/events.rpy:961
translate russian jack_event_04_d8e873bd:
    "Я смотрю на Джека, словно требуя объяснений."

# ch/jack/events.rpy:962
translate russian jack_event_04_3508dc04:
    "А он многозначительно приподнимает брови."

# ch/jack/events.rpy:963
translate russian jack_event_04_fc43633b:
    jack.say "Всегда можно РАЗДЕЛИТЬ с кем-нибудь спальный мешок..."

# ch/jack/events.rpy:964
translate russian jack_event_04_5f136d92:
    "А, вот к чему он клонит!"

# ch/jack/events.rpy:969
translate russian jack_event_04_243b8063:
    mike.say "Э-э, [bree.name]..."

# ch/jack/events.rpy:970
translate russian jack_event_04_9c62ca79:
    mike.say "Можно мне эту ночь поспать с тобой?"

# ch/jack/events.rpy:971
translate russian jack_event_04_39487378:
    "[bree.name] так и сияет от моего вопроса."

# ch/jack/events.rpy:972
translate russian jack_event_04_4b86a0c9:
    bree.say "Конечно, благородный паладин."

# ch/jack/events.rpy:973
translate russian jack_event_04_82516686:
    bree.say "Разве моя божественная покровительница не велит делиться теплом её любви?"

# ch/jack/events.rpy:974
translate russian jack_event_04_0f2340be:
    "Я нервно улыбаюсь в ответ на улыбку [bree.name]."

# ch/jack/events.rpy:975
translate russian jack_event_04_df9798dc:
    "Но вижу, что Саша чувствует себя обделённой."

# ch/jack/events.rpy:980
translate russian jack_event_04_fb020eb5:
    mike.say "Э-э, Саша..."

# ch/jack/events.rpy:981
translate russian jack_event_04_9c62ca79_1:
    mike.say "Можно мне эту ночь поспать с тобой?"

# ch/jack/events.rpy:982
translate russian jack_event_04_c61523da:
    "Саша улыбается мне почти похотливо."

# ch/jack/events.rpy:983
translate russian jack_event_04_4468d164:
    sasha.say "Иди сюда, святоша."

# ch/jack/events.rpy:984
translate russian jack_event_04_b61ce508:
    sasha.say "Посмотрим, сумеешь ли ты сохранить чистоту, проведя всю ночь так близко ко мне!"

# ch/jack/events.rpy:985
translate russian jack_event_04_ff4605d7:
    "Я нервно улыбаюсь Саше в ответ."

# ch/jack/events.rpy:986
translate russian jack_event_04_39549870:
    "Но вижу, что [bree.name] чувствует себя обделённой."

# ch/jack/events.rpy:991
translate russian jack_event_04_37bd79a7:
    mike.say "Э-э, Минами..."

# ch/jack/events.rpy:992
translate russian jack_event_04_9c62ca79_2:
    mike.say "Можно мне эту ночь поспать с тобой?"

# ch/jack/events.rpy:993
translate russian jack_event_04_3153398a:
    "Минами так и сияет от моего вопроса."

# ch/jack/events.rpy:994
translate russian jack_event_04_9b5ef10b:
    minami.say "Мур-р... Конечно, братик..."

# ch/jack/events.rpy:995
translate russian jack_event_04_9530ca30:
    minami.say "Ой! То есть конечно, господин паладин!"

# ch/jack/events.rpy:996
translate russian jack_event_04_6642c905:
    minami.say "Мур-р... Коготки у меня острые, зато шёрстка мягкая и тёплая!"

# ch/jack/events.rpy:997
translate russian jack_event_04_6a5f8bf7:
    minami.say "Мур-р... И если захочешь поиграть с моим хвостиком, я никому не скажу..."

# ch/jack/events.rpy:998
translate russian jack_event_04_c38ece2c:
    "Я нервно улыбаюсь Минами в ответ."

# ch/jack/events.rpy:999
translate russian jack_event_04_76513f22:
    "Но вижу, что [bree.name] и Саша чувствуют себя обделёнными."

# ch/jack/events.rpy:1002
translate russian jack_event_04_b5fa2070:
    "Я знаю, что Джек нарочно ставит меня в неловкое положение."

# ch/jack/events.rpy:1003
translate russian jack_event_04_6fbe6dda:
    "Но это не значит, что я обязан ему подыгрывать."

# ch/jack/events.rpy:1005
translate russian jack_event_04_65dc18b5:
    mike.say "Ладно, оставьте спальные мешки себе."

# ch/jack/events.rpy:1006
translate russian jack_event_04_6e2c3a98:
    mike.say "Я просто завернусь в шерстяной плащ."

# ch/jack/events.rpy:1008
translate russian jack_event_04_8ee84750:
    bree.say "Ох, [hero.name]!"

# ch/jack/events.rpy:1010
translate russian jack_event_04_ccd5a6a0:
    sasha.say "Ты уверен?"

# ch/jack/events.rpy:1011
translate russian jack_event_04_a026b005:
    "Я почти чувствую, как Джек начинает паниковать."

# ch/jack/events.rpy:1012
translate russian jack_event_04_f6251cb2:
    "Он не ожидал, что его тщательно продуманный план так легко сорвётся!"

# ch/jack/events.rpy:1013
translate russian jack_event_04_86dc3b93:
    jack.say "Э-э... Будет ОЧЕНЬ холодно, чувак!"

# ch/jack/events.rpy:1014
translate russian jack_event_04_0862ab0d:
    jack.say "Ну, ниже нуля или вроде того!"

# ch/jack/events.rpy:1015
translate russian jack_event_04_6fe3616f:
    mike.say "Не беспокойся обо мне."

# ch/jack/events.rpy:1016
translate russian jack_event_04_9b3738d5:
    mike.say "Я стойкий паладин! Телесные страдания мне не страшны!"

# ch/jack/events.rpy:1017
translate russian jack_event_04_f8f879d6:
    "И тут замечаю, что [bree.name] о чём-то задумалась."

# ch/jack/events.rpy:1018
translate russian jack_event_04_6621fefb:
    bree.say "Саша, а давай мы ляжем в один спальный мешок?"

# ch/jack/events.rpy:1019
translate russian jack_event_04_eb3f2d5b:
    sasha.say "Точно! Тогда второй можно отдать [hero.name]!"

# ch/jack/events.rpy:1020
translate russian jack_event_04_97075b79:
    "Выражение лица Джека бесценно."

# ch/jack/events.rpy:1021
translate russian jack_event_04_01d847a9:
    "Его первоначальный план сорвался, но всё оборачивается ещё лучше!"

# ch/jack/events.rpy:1022
translate russian jack_event_04_1a521387:
    mike.say "Да не надо..."

# ch/jack/events.rpy:1023
translate russian jack_event_04_050ffe1d:
    jack.say "Нет, если хотят, пусть так и делают!"

# ch/jack/events.rpy:1027
translate russian jack_event_04_139a5f72:
    minami.say "Эй, а как же я?"

# ch/jack/events.rpy:1028
translate russian jack_event_04_1e1f000c:
    bree.say "А что ты?"

# ch/jack/events.rpy:1029
translate russian jack_event_04_2d4a0c71:
    sasha.say "Да у тебя целый спальный мешок!"

# ch/jack/events.rpy:1030
translate russian jack_event_04_c93ae848:
    minami.say "Ну-у... Но я же буду совсем одна!"

# ch/jack/events.rpy:1031
translate russian jack_event_04_c5ea7374:
    sasha.say "Иди кошачьей мяты понюхай!"

# ch/jack/events.rpy:1035
translate russian jack_event_04_7a4197bc:
    jack.say "Вам хочется устроиться поуютнее и прижаться друг к другу, да?"

# ch/jack/events.rpy:1036
translate russian jack_event_04_b366a3c2:
    jack.say "Согреться теплом ваших тел!"

# ch/jack/events.rpy:1037
translate russian jack_event_04_c0d6c192:
    "Представляя эту картину, Джек, кажется, уже начинает потеть."

# ch/jack/events.rpy:1038
translate russian jack_event_04_5b249d78:
    "И мне от этого становится совсем не по себе!"

# ch/jack/events.rpy:1042
translate russian jack_event_04_1a817d1c:
    mike.say "Э-э... Может, на сегодня закончим?"

# ch/jack/events.rpy:1043
translate russian jack_event_04_afa5a4da:
    mike.say "Я только что вспомнил: мне мама должна позвонить!"

# ch/jack/events.rpy:1046
translate russian jack_event_04_f2aefe7e:
    minami.say "А?.. Мне она ничего об этом не..."

# ch/jack/events.rpy:1047
translate russian jack_event_04_c44ae8bf:
    minami.say "М-м-м... м-м... м-м..."

# ch/jack/events.rpy:1048
translate russian jack_event_04_0a3c711f:
    "Я зажимаю Минами рот ладонью, прежде чем она успевает испортить мою наскоро придуманную отговорку."

# ch/jack/events.rpy:1050
translate russian jack_event_04_5d401688:
    jack.say "Ну, чувак! Как раз на самом интересном!"

# ch/jack/events.rpy:1051
translate russian jack_event_04_b39aedf2:
    jack.say "Ладно, как скажешь."

# ch/jack/events.rpy:1052
translate russian jack_event_04_34a5e280:
    "Он поворачивается к [bree.name] и Саше."

# ch/jack/events.rpy:1054
translate russian jack_event_04_5d96cdb0:
    "Потом кивает и Минами."

# ch/jack/events.rpy:1055
translate russian jack_event_04_c8eb8be1:
    jack.say "В то же время на следующей неделе, дамы?"

# ch/jack/events.rpy:1058
translate russian jack_event_04_0827f26a:
    bree.say "Ох, не знаю..."

# ch/jack/events.rpy:1059
translate russian jack_event_04_860a3ddf:
    jack.say "А?"

# ch/jack/events.rpy:1060
translate russian jack_event_04_96cad989:
    mike.say "Что такое, [bree.name]?"

# ch/jack/events.rpy:1061
translate russian jack_event_04_8b92af85:
    bree.say "Не знаю. Сегодня было не так весело, как в прошлый раз."

# ch/jack/events.rpy:1062
translate russian jack_event_04_48a25082:
    bree.say "На следующей неделе без меня."

# ch/jack/events.rpy:1065
translate russian jack_event_04_ce6efdca:
    sasha.say "Не-а, я, пожалуй, пас."

# ch/jack/events.rpy:1066
translate russian jack_event_04_860a3ddf_1:
    jack.say "А?"

# ch/jack/events.rpy:1067
translate russian jack_event_04_320d8cbf:
    mike.say "Что такое, Саша?"

# ch/jack/events.rpy:1068
translate russian jack_event_04_53215037:
    sasha.say "Кажется, играть в воображаемые приключения с потными задротами мне уже надоело!"

# ch/jack/events.rpy:1069
translate russian jack_event_04_4d1309bb:
    sasha.say "На следующей неделе без меня."

# ch/jack/events.rpy:1072
translate russian jack_event_04_fabedd1f:
    minami.say "Так себе..."

# ch/jack/events.rpy:1073
translate russian jack_event_04_860a3ddf_2:
    jack.say "А?"

# ch/jack/events.rpy:1074
translate russian jack_event_04_3508ecc3:
    mike.say "Что такое, Минами?"

# ch/jack/events.rpy:1075
translate russian jack_event_04_b17f33c9:
    minami.say "Это ТАК скучно!"

# ch/jack/events.rpy:1076
translate russian jack_event_04_bbab6c9c:
    minami.say "Я же вообще НИКОГО не убила!"

# ch/jack/events.rpy:1077
translate russian jack_event_04_b7f94dae:
    minami.say "Я пас. Больше не играю."

# ch/jack/events.rpy:1079
translate russian jack_event_04_567ef3ff:
    bree.say "О да!"

# ch/jack/events.rpy:1080
translate russian jack_event_04_9aaeb543:
    bree.say "Не терпится добраться до этих злых гоблинов!"

# ch/jack/events.rpy:1081
translate russian jack_event_04_601f37f6:
    sasha.say "И я хочу узнать, на что способны мои заклинания!"

# ch/jack/events.rpy:1083
translate russian jack_event_04_bd1e80ed:
    minami.say "Мур-р... И про милую девушку-кошку не забывайте!"

# ch/jack/events.rpy:1084
translate russian jack_event_04_a0bac9a9:
    jack.say "Отлично, договорились!"

# ch/jack/events.rpy:1090
translate russian jack_event_04_1b52af7d:
    "Джек собирает вещи, и я провожаю его до двери."

# ch/jack/events.rpy:1091
translate russian jack_event_04_d4d04582:
    "Возвращаясь в столовую, я уже зову [bree.name] и Сашу."

# ch/jack/events.rpy:1093
translate russian jack_event_04_8b97c6e3:
    "Вчетвером, вместе с Минами, мы быстро всё уберём!"

# ch/jack/events.rpy:1094
translate russian jack_event_04_0198b45a:
    mike.say "Поможете мне тут прибраться?"

# ch/jack/events.rpy:1095
translate russian jack_event_04_229eba9b:
    mike.say "Девушки?"

# ch/jack/events.rpy:1098
translate russian jack_event_04_93e5cec3:
    "Оглядываюсь: там, где должны сидеть девушки, только пустые стулья."

# ch/jack/events.rpy:1099
translate russian jack_event_04_6a816a21:
    "Качаю головой и начинаю собирать игровые принадлежности."

# ch/jack/events.rpy:1100
translate russian jack_event_04_2f9fafbc:
    "Хорошо хоть некому спросить, почему мама так и не позвонила!"

# ch/jack/events.rpy:1107
translate russian jack_event_05_fedf2f83:
    "Почти весь день я ревностно охраняю Zbox в гостиной."

# ch/jack/events.rpy:1108
translate russian jack_event_05_90b2433b:
    "Стоит [bree.name] хоть взглянуть на приставку, как я её отгоняю."

# ch/jack/events.rpy:1109
translate russian jack_event_05_a771a67b:
    "Ведь она уже согласилась, что до завтрашнего рассвета приставка моя."

# ch/jack/events.rpy:1110
translate russian jack_event_05_fec6de1b:
    "Знаю, всё это звучит безумно."

# ch/jack/events.rpy:1111
translate russian jack_event_05_6dc95829:
    "Но поверьте: у меня есть веская причина вести себя как такой жадный придурок."

# ch/jack/events.rpy:1112
translate russian jack_event_05_e41aa093:
    "Я жду стука в дверь."

# ch/jack/events.rpy:1114
translate russian jack_event_05_03b8763f:
    "Как только он раздаётся, я бросаюсь в прихожую и распахиваю дверь."

# ch/jack/events.rpy:1115
translate russian jack_event_05_a1eaea56:
    "И вижу нечто, похожее на ходячую гору закусок!"

# ch/jack/events.rpy:1121
translate russian jack_event_05_32d94a8f:
    jack.say "П... привет, приятель!"

# ch/jack/events.rpy:1122
translate russian jack_event_05_27019004:
    jack.say "Не мог бы ты..."

# ch/jack/events.rpy:1123
translate russian jack_event_05_e5f90afa:
    jack.say "Взять у меня часть всего этого?"

# ch/jack/events.rpy:1125
translate russian jack_event_05_eb620f7c:
    "Я подскакиваю и подхватываю всё, до чего могу дотянуться."

# ch/jack/events.rpy:1126
translate russian jack_event_05_78de682b:
    "Едва успеваю предотвратить лавину вредной еды в прихожей."

# ch/jack/events.rpy:1127
translate russian jack_event_05_f05177ac:
    "Теперь над оставшейся грудой закусок видно сияющее лицо Джека."

# ch/jack/events.rpy:1129
translate russian jack_event_05_264becab:
    jack.say "Ну что, пригласишь меня войти или как?!"

# ch/jack/events.rpy:1130
translate russian jack_event_05_95b3c266:
    jack.say "В последний раз твоя Zbox стояла в доме!"

# ch/jack/events.rpy:1132
translate russian jack_event_05_6af77890:
    mike.say "А, да..."

# ch/jack/events.rpy:1133
translate russian jack_event_05_593d4ac1:
    mike.say "Конечно, конечно..."

# ch/jack/events.rpy:1134
translate russian jack_event_05_a30e5b91:
    mike.say "Заходи!"

# ch/jack/events.rpy:1135
translate russian jack_event_05_97b28de0:
    "Я отступаю, пропуская Джека, который переваливается через порог со своей ношей."

# ch/jack/events.rpy:1137
translate russian jack_event_05_34ee72a8:
    "Показывать дорогу не нужно: он сразу направляется в гостиную."

# ch/jack/events.rpy:1138
translate russian jack_event_05_26428083:
    "Закрыв дверь, иду следом, всё ещё прижимая к себе остальные закуски."

# ch/jack/events.rpy:1139
translate russian jack_event_05_d59ff8c4:
    "Оказавшись перед телевизором, Джек вскидывает руки над головой."

# ch/jack/events.rpy:1140
translate russian jack_event_05_c9cf6a27:
    "И вся еда, которую он нёс, сыплется на пол."

# ch/jack/events.rpy:1144
translate russian jack_event_05_6e14f3ef:
    jack.say "Наш час настал!"

# ch/jack/events.rpy:1145
translate russian jack_event_05_bb6b0e60:
    jack.say "Да начнутся игры!"

# ch/jack/events.rpy:1147
translate russian jack_event_05_4f6f5fce:
    "Я повторяю его жест, тоже роняя свою ношу."

# ch/jack/events.rpy:1148
translate russian jack_event_05_0ebc337d:
    mike.say "На этой священной арене мужчины пройдут испытание!"

# ch/jack/events.rpy:1149
translate russian jack_event_05_7cfccb8b:
    mike.say "И лишь сильнейший одержит победу!"

# ch/jack/events.rpy:1150
translate russian jack_event_05_d309a67b:
    bree.say "Господи!"

# ch/jack/events.rpy:1151
translate russian jack_event_05_38f79d73:
    bree.say "Я думала, вы просто в видеоигры собрались поиграть?"

# ch/jack/events.rpy:1153
translate russian jack_event_05_1deaeaa8:
    "Мы с Джеком одновременно оборачиваемся: [bree.name] стоит, прислонившись к дверному косяку."

# ch/jack/events.rpy:1154
translate russian jack_event_05_d2bb0aa2:
    "Мы оба тут же опускаем руки, не в силах скрыть смущение."

# ch/jack/events.rpy:1155
translate russian jack_event_05_bd5265aa:
    mike.say "Именно это мы и делаем, [bree.name]!"

# ch/jack/events.rpy:1157
translate russian jack_event_05_bd6c3d0e:
    jack.say "Д... да!"

# ch/jack/events.rpy:1158
translate russian jack_event_05_988fded2:
    jack.say "Просто настраиваемся, вот и всё!"

# ch/jack/events.rpy:1160
translate russian jack_event_05_511d2c48:
    "[bree.name] фыркает от смеха и качает головой."

# ch/jack/events.rpy:1162
translate russian jack_event_05_5cd4576f:
    bree.say "Настраиваетесь?"

# ch/jack/events.rpy:1163
translate russian jack_event_05_415edeeb:
    bree.say "Да ладно вам!"

# ch/jack/events.rpy:1164
translate russian jack_event_05_87c85660:
    bree.say "Ну вы и задроты."

# ch/jack/events.rpy:1166
translate russian jack_event_05_e360c83e:
    "Не успеваю придумать остроумный ответ, как [bree.name] разворачивается и уходит."

# ch/jack/events.rpy:1167
translate russian jack_event_05_3a83dcd1:
    "Джек смотрит на дверь, словно ждёт, когда опасность окончательно минует."

# ch/jack/events.rpy:1168
translate russian jack_event_05_3ad7e519:
    "Затем смотрит мне в глаза и присвистывает."

# ch/jack/events.rpy:1170
translate russian jack_event_05_e1e80cb8:
    jack.say "Чувак, серьёзно..."

# ch/jack/events.rpy:1171
translate russian jack_event_05_60df672c:
    jack.say "Не знаю, как ты здесь вообще способен трезво мыслить."

# ch/jack/events.rpy:1173
translate russian jack_event_05_6d0132cf:
    jack.say "Одна только мысль, что под одной крышей с тобой живёт такая красотка, как [bree.name]!"

# ch/jack/events.rpy:1175
translate russian jack_event_05_b6d58af1:
    "Я отмахиваюсь, стараясь показать, что это пустяки."

# ch/jack/events.rpy:1176
translate russian jack_event_05_a5a8bcd1:
    "В конце концов, хочется сосредоточиться на играх, а не пускать слюни по соседкам."

# ch/jack/events.rpy:1177
translate russian jack_event_05_f1d8a63c:
    mike.say "Эм..."

# ch/jack/events.rpy:1178
translate russian jack_event_05_9f16c92b:
    mike.say "Не всё так здорово, как кажется, Джек."

# ch/jack/events.rpy:1179
translate russian jack_event_05_3486e5e5:
    mike.say "Конечно, соседки симпатичнее соседей."

# ch/jack/events.rpy:1180
translate russian jack_event_05_3b127269:
    mike.say "Но они тоже оставляют посуду, чтобы ты за них помыл."

# ch/jack/events.rpy:1181
translate russian jack_event_05_c7b06d3f:
    mike.say "И грязное бельё по дому разбрасывают!"

# ch/jack/events.rpy:1183
translate russian jack_event_05_3b771f9d:
    "От одного этого слова у Джека загораются глаза."

# ch/jack/events.rpy:1185
translate russian jack_event_05_07fbcc05:
    jack.say "В смысле трусики и лифчики?!"

# ch/jack/events.rpy:1186
translate russian jack_event_05_48af136a:
    mike.say "Да... нет... то есть..."

# ch/jack/events.rpy:1187
translate russian jack_event_05_cb21bc51:
    mike.say "Слушай, давай просто поиграем в видеоигры?"

# ch/jack/events.rpy:1188
translate russian jack_event_05_75a348cf:
    "Кажется, это действует на Джека как надо."

# ch/jack/events.rpy:1190
translate russian jack_event_05_7fc5bd67:
    "Он трясёт головой, словно перезагружая мозг."

# ch/jack/events.rpy:1191
translate russian jack_event_05_9afa7a4b:
    "Затем берёт геймпад и садится перед телевизором."

# ch/jack/events.rpy:1193
translate russian jack_event_05_c634d5c2:
    jack.say "Ладно, чувак, ладно..."

# ch/jack/events.rpy:1194
translate russian jack_event_05_86a5a2a3:
    jack.say "Во что сначала играем?"

# ch/jack/events.rpy:1196
translate russian jack_event_05_1147785c:
    "Я беру второй геймпад и включаю Zbox."

# ch/jack/events.rpy:1197
translate russian jack_event_05_ad22e612:
    mike.say "Хочется чего-нибудь из старой доброй классики."

# ch/jack/events.rpy:1198
translate russian jack_event_05_cd9cbe80:
    mike.say "В «Братьев-гиперсантехников»?"

# ch/jack/events.rpy:1199
translate russian jack_event_05_2129e50b:
    mike.say "Будешь за Марию?"

# ch/jack/events.rpy:1201
translate russian jack_event_05_1ba0f078:
    jack.say "По рукам!"

# ch/jack/events.rpy:1202
translate russian jack_event_05_19da33a6:
    "Вскоре мы с Джеком забываем обо всём, погрузившись в игру."

# ch/jack/events.rpy:1203
translate russian jack_event_05_39ab8b61:
    "Прыгаем на грибы-убийцы и черепах, хватаем усиления и отлично проводим время."

# ch/jack/events.rpy:1204
translate russian jack_event_05_7c7b7731:
    "Увидев, что набрал больше очков, чем Джек, я победно вскидываю кулак."

# ch/jack/events.rpy:1205
translate russian jack_event_05_2f7a2304:
    mike.say "О да!"

# ch/jack/events.rpy:1206
translate russian jack_event_05_7442e27b:
    mike.say "Слава королю, детка!"

# ch/jack/events.rpy:1207
translate russian jack_event_05_6631aebe:
    bree.say "Вот именно, слава королю!"

# ch/jack/events.rpy:1209
translate russian jack_event_05_b9976cfc:
    "От голоса [bree.name] мы с Джеком подскакиваем."

# ch/jack/events.rpy:1210
translate russian jack_event_05_aeaff127:
    "Никто из нас не заметил, что она стоит позади."

# ch/jack/events.rpy:1211
translate russian jack_event_05_65469830:
    "Наверное, прокралась обратно, пока мы были увлечены игрой."

# ch/jack/events.rpy:1213
translate russian jack_event_05_64ab0fb4:
    bree.say "Такая победа заслуживает награды..."

# ch/jack/events.rpy:1217
translate russian jack_event_05_4756e434:
    "Не успеваю и слова сказать, как [bree.name] наклоняется и целует меня."

# ch/jack/events.rpy:1218
translate russian jack_event_05_f8194245:
    "Поцелуй долгий и неторопливый. У меня перехватывает дыхание."

# ch/jack/events.rpy:1223
translate russian jack_event_05_6ffb8c67:
    "Когда она отстраняется и садится на диван, я замечаю ошеломлённый взгляд Джека."

# ch/jack/events.rpy:1225
translate russian jack_event_05_45eee0dc:
    jack.say "Чт..."

# ch/jack/events.rpy:1226
translate russian jack_event_05_bfec3310:
    jack.say "Она что..."

# ch/jack/events.rpy:1227
translate russian jack_event_05_0abe0bd3:
    jack.say "Что я только что увидел?!"

# ch/jack/events.rpy:1229
translate russian jack_event_05_30e74fc5:
    mike.say "Эм..."

# ch/jack/events.rpy:1230
translate russian jack_event_05_b070e7d5:
    mike.say "Да ничего, Джек..."

# ch/jack/events.rpy:1231
translate russian jack_event_05_88295fb2:
    mike.say "Мы с [bree.name] просто так шутим, понимаешь?"

# ch/jack/events.rpy:1232
translate russian jack_event_05_35e549fe:
    "По лицу Джека видно, что он совершенно не понимает."

# ch/jack/events.rpy:1233
translate russian jack_event_05_63cba3c7:
    "Но всё равно кивает."

# ch/jack/events.rpy:1234
translate russian jack_event_05_0389827d:
    mike.say "В общем..."

# ch/jack/events.rpy:1235
translate russian jack_event_05_2ea292d0:
    mike.say "Во что теперь поиграем?"

# ch/jack/events.rpy:1237
translate russian jack_event_05_7e9850b8:
    jack.say "Ох... Дай подумать..."

# ch/jack/events.rpy:1238
translate russian jack_event_05_72f90375:
    jack.say "Как насчёт «Героини гитары»?"

# ch/jack/events.rpy:1239
translate russian jack_event_05_8bd12811:
    "Выбор немного неожиданный."

# ch/jack/events.rpy:1240
translate russian jack_event_05_d775f14d:
    "Но я киваю и начинаю искать контроллеры в форме гитар."

# ch/jack/events.rpy:1241
translate russian jack_event_05_675c665e:
    "Что угодно, лишь бы Джек перестал думать о том, как [bree.name] поцеловала меня у него на глазах!"

# ch/jack/events.rpy:1243
translate russian jack_event_05_aede45a0:
    bree.say "О-о!"

# ch/jack/events.rpy:1245
translate russian jack_event_05_9b68b01e:
    bree.say "Саша обожает эту игру!"

# ch/jack/events.rpy:1247
translate russian jack_event_05_7f786711:
    bree.say "САША! САША!"

# ch/jack/events.rpy:1249
translate russian jack_event_05_f63a05a9:
    "Мы с Джеком смотрим, как [bree.name] зовёт Сашу в гостиную."

# ch/jack/events.rpy:1251
translate russian jack_event_05_eb35c172:
    sasha.say "А?"

# ch/jack/events.rpy:1252
translate russian jack_event_05_2e056c81:
    sasha.say "Чего вам?"

# ch/jack/events.rpy:1253
translate russian jack_event_05_f1ff5a3a:
    "Саша выглядит слегка раздражённой: её явно от чего-то оторвали."

# ch/jack/events.rpy:1254
translate russian jack_event_05_353c4c86:
    "Но стоит ей увидеть гитары-контроллеры у нас в руках, настроение сразу улучшается."

# ch/jack/events.rpy:1256
translate russian jack_event_05_5429ad98:
    sasha.say "О, круто!"

# ch/jack/events.rpy:1258
translate russian jack_event_05_dbcdd608:
    sasha.say "Давно мы их не доставали."

# ch/jack/events.rpy:1259
translate russian jack_event_05_3deb64ff:
    "Она усаживается на диван рядом с [bree.name]."

# ch/jack/events.rpy:1260
translate russian jack_event_05_8672c0ca:
    "Кажется, у нас появились зрители."

# ch/jack/events.rpy:1262
translate russian jack_event_05_e9e6c9c3:
    "И тут я замечаю ухмылку Джека."

# ch/jack/events.rpy:1263
translate russian jack_event_05_12c2fa18:
    "Начинаю понимать, почему он выбрал именно эту игру."

# ch/jack/events.rpy:1264
translate russian jack_event_05_ceb55957:
    "Он знает, что Саша играет в группе, так что ей такое должно нравиться."

# ch/jack/events.rpy:1265
translate russian jack_event_05_4aea1594:
    "Джек хочет впечатлить её своим игровым мастерством!"

# ch/jack/events.rpy:1266
translate russian jack_event_05_fb777b6f:
    "Ну, поддаваться ему из-за этого я не собираюсь."

# ch/jack/events.rpy:1267
translate russian jack_event_05_b577c1b1:
    "Игра начинается, и на какое-то время мы с Джеком превращаемся в богов рока!"

# ch/jack/events.rpy:1268
translate russian jack_event_05_6908730d:
    "Мы сражаемся на гитарах-контроллерах, выдавая риффы и соло так, словно от этого зависит наша жизнь."

# ch/jack/events.rpy:1269
translate russian jack_event_05_91df6e4a:
    "Несколько раз мне кажется, что на этот раз Джек меня обошёл."

# ch/jack/events.rpy:1270
translate russian jack_event_05_67dcf526:
    "Но вот всё заканчивается, и на экране появляются результаты."

# ch/jack/events.rpy:1272
translate russian jack_event_05_d2995be1:
    jack.say "ЧТО?!"

# ch/jack/events.rpy:1273
translate russian jack_event_05_e1f4bb7f:
    jack.say "Ты опять меня обыграл?!"

# ch/jack/events.rpy:1274
translate russian jack_event_05_9ce42410:
    mike.say "Наверное, сегодня я просто в ударе, чувак!"

# ch/jack/events.rpy:1275
translate russian jack_event_05_81a4db9e:
    sasha.say "В ударе?"

# ch/jack/events.rpy:1277
translate russian jack_event_05_b3bcfe70:
    sasha.say "Да ты, блядь, бог гитары!"

# ch/jack/events.rpy:1281
translate russian jack_event_05_0edde5db:
    "Не успеваю понять, что происходит, как Саша уже обнимает меня."

# ch/jack/events.rpy:1282
translate russian jack_event_05_7e21c5f2:
    "И целует взасос!"

# ch/jack/events.rpy:1283
translate russian jack_event_05_a84bc428:
    "Джек таращится на нас."

# ch/jack/events.rpy:1284
translate russian jack_event_05_a02b8398:
    "Глаза выпучены, рот открыт."

# ch/jack/events.rpy:1290
translate russian jack_event_05_e79987c1:
    jack.say "Она только что..."

# ch/jack/events.rpy:1291
translate russian jack_event_05_f2c710d8:
    jack.say "Как та, другая..."

# ch/jack/events.rpy:1292
translate russian jack_event_05_f1d8a63c_1:
    mike.say "Эм..."

# ch/jack/events.rpy:1293
translate russian jack_event_05_86ab55da:
    mike.say "Саша тоже шутит, Джек!"

# ch/jack/events.rpy:1294
translate russian jack_event_05_2ca47df0:
    mike.say "Уверен, если бы ты выиграл, она бы и тебя поцеловала..."

# ch/jack/events.rpy:1295
translate russian jack_event_05_3ba0eb4a:
    "Джек провожает взглядом Сашу, возвращающуюся к дивану."

# ch/jack/events.rpy:1296
translate russian jack_event_05_172d34d6:
    "Она явно слышала моё поспешное объяснение её поступка."

# ch/jack/events.rpy:1297
translate russian jack_event_05_bbf25616:
    "И я вижу, как старательно она не даёт Джеку понять, правда это или нет."

# ch/jack/events.rpy:1305
translate russian jack_event_05_cc0cb61c:
    minami.say "О-о..."

# ch/jack/events.rpy:1306
translate russian jack_event_05_88f90dec:
    minami.say "Видеоигры! Круто!"

# ch/jack/events.rpy:1307
translate russian jack_event_05_c99cfe40:
    "Услышав голос Минами, Джек сразу переключается на неё."

# ch/jack/events.rpy:1308
translate russian jack_event_05_721f03c1:
    "Я тоже смотрю в её сторону, радуясь, что она вошла и отвлекла его."

# ch/jack/events.rpy:1309
translate russian jack_event_05_0774d41f:
    "Да, я знаю: он пялится на неё так же, как на остальных девушек."

# ch/jack/events.rpy:1310
translate russian jack_event_05_28694f3f:
    "Но она словно специально создана, чтобы такие парни, как он, превращались в беспомощную лужицу!"

# ch/jack/events.rpy:1312
translate russian jack_event_05_f5666be6:
    jack.say "П... привет, Минами!"

# ch/jack/events.rpy:1313
translate russian jack_event_05_fddc7092:
    minami.say "О... Привет, Джек!"

# ch/jack/events.rpy:1315
translate russian jack_event_05_b139222e:
    minami.say "Не против, если посмотрю, как вы играете?"

# ch/jack/events.rpy:1316
translate russian jack_event_05_43f145a8:
    "Джек мотает головой, из кожи вон лезет, лишь бы угодить Минами."

# ch/jack/events.rpy:1317
translate russian jack_event_05_82de793e:
    jack.say "Конечно, Минами!"

# ch/jack/events.rpy:1318
translate russian jack_event_05_66bc617e:
    jack.say "Для тебя всё что угодно..."

# ch/jack/events.rpy:1319
translate russian jack_event_05_5ad30e35:
    jack.say "Я... то есть да, без проблем!"

# ch/jack/events.rpy:1320
translate russian jack_event_05_6757cf6b:
    mike.say "Ну..."

# ch/jack/events.rpy:1321
translate russian jack_event_05_a513fd50:
    mike.say "Во что дальше играем?"

# ch/jack/events.rpy:1322
translate russian jack_event_05_860a3ddf:
    jack.say "А?"

# ch/jack/events.rpy:1323
translate russian jack_event_05_03aafcac:
    jack.say "Ах... да..."

# ch/jack/events.rpy:1324
translate russian jack_event_05_59f87f80:
    jack.say "Знаю! Давай в «Лунную морячку»!"

# ch/jack/events.rpy:1326
translate russian jack_event_05_de569545:
    "От выбора Джека я невольно усмехаюсь."

# ch/jack/events.rpy:1327
translate russian jack_event_05_95bdb873:
    "Игра с японками в коротких юбках."

# ch/jack/events.rpy:1328
translate russian jack_event_05_f07aa91b:
    "Можно ли намекнуть ещё прозрачнее?"

# ch/jack/events.rpy:1329
translate russian jack_event_05_46f9f8ff:
    "Но я ничего не говорю и просто запускаю игру."

# ch/jack/events.rpy:1330
translate russian jack_event_05_c32577aa:
    minami.say "Ух ты!"

# ch/jack/events.rpy:1332
translate russian jack_event_05_55bb5c4c:
    minami.say "Обожаю это аниме!"

# ch/jack/events.rpy:1333
translate russian jack_event_05_f5dacc64:
    minami.say "Я косплеила почти всех персонажей!"

# ch/jack/events.rpy:1335
translate russian jack_event_05_6290c52b:
    "Пока Джек переваривает эту новость, у него чуть не вылезают глаза."

# ch/jack/events.rpy:1336
translate russian jack_event_05_1895f2f2:
    "И даже с началом игры он явно продолжает об этом думать."

# ch/jack/events.rpy:1337
translate russian jack_event_05_6a8eb510:
    "Он совершенно не сосредоточен, и я легко разношу его в пух и прах."

# ch/jack/events.rpy:1339
translate russian jack_event_05_98057f92:
    jack.say "Какого хрена?!"

# ch/jack/events.rpy:1340
translate russian jack_event_05_2e41148b:
    jack.say "Ты издеваешься?"

# ch/jack/events.rpy:1341
translate russian jack_event_05_5981ca62:
    mike.say "Прости, Джек! Кто зевает, тот проигрывает!"

# ch/jack/events.rpy:1343
translate russian jack_event_05_74a5f26a:
    minami.say "А победителю полагается приз!"

# ch/jack/events.rpy:1344
translate russian jack_event_05_e2cc62bd:
    "Минами подскакивает ко мне и наклоняется поближе."

# ch/jack/events.rpy:1348
translate russian jack_event_05_b047a0e1:
    "А затем дарит мне долгий, неторопливый поцелуй!"

# ch/jack/events.rpy:1349
translate russian jack_event_05_76fc982d:
    "Когда всё заканчивается, Джек выглядит ещё более потрясённым."

# ch/jack/events.rpy:1353
translate russian jack_event_05_0f3728b3:
    mike.say "Эм... да..."

# ch/jack/events.rpy:1354
translate russian jack_event_05_7d34d23d:
    mike.say "У нас дома так поздравляют с победой!"

# ch/jack/events.rpy:1362
translate russian jack_event_05_0caf7a3a:
    lexi.say "О, вы опять в видеоигры играете?"

# ch/jack/events.rpy:1363
translate russian jack_event_05_82a294ad:
    lexi.say "Можно посмотреть?"

# ch/jack/events.rpy:1364
translate russian jack_event_05_71c0b2e6:
    "Услышав Лекси, я невольно смотрю на Джека."

# ch/jack/events.rpy:1365
translate russian jack_event_05_618ff79a:
    "И точно: он уже пялится на неё, чуть ли не высунув язык!"

# ch/jack/events.rpy:1366
translate russian jack_event_05_0f5b28f7:
    "Да и можно ли его винить?"

# ch/jack/events.rpy:1367
translate russian jack_event_05_b0dffe3b:
    "Лекси чертовски горяча — идеальная плохая девчонка."

# ch/jack/events.rpy:1368
translate russian jack_event_05_f68213ee:
    mike.say "Конечно, Лекси."

# ch/jack/events.rpy:1369
translate russian jack_event_05_0bccc1ae:
    mike.say "То есть если ты не против, Джек?"

# ch/jack/events.rpy:1371
translate russian jack_event_05_6cd80968:
    jack.say "Конечно не против!"

# ch/jack/events.rpy:1372
translate russian jack_event_05_57c180cb:
    jack.say "Эй, давай в «Бесполезную драку»!"

# ch/jack/events.rpy:1374
translate russian jack_event_05_e1401763:
    mike.say "Я за..."

# ch/jack/events.rpy:1375
translate russian jack_event_05_69bb58db:
    "Наверное, при виде Лекси Джек вспомнил о суровых улицах."

# ch/jack/events.rpy:1376
translate russian jack_event_05_d9fd1db6:
    "В той игре даже есть персонажи, которые напоминают мне Лекси!"

# ch/jack/events.rpy:1377
translate russian jack_event_05_bc51927d:
    "Выбор ей тоже нравится: она кивает, когда мы начинаем играть."

# ch/jack/events.rpy:1378
translate russian jack_event_05_faae48c0:
    lexi.say "О да... Я выросла в таком районе!"

# ch/jack/events.rpy:1379
translate russian jack_event_05_eb93b87b:
    lexi.say "А этот похож на одного типа, который кинул меня на деньги!"

# ch/jack/events.rpy:1380
translate russian jack_event_05_2cb65533:
    lexi.say "Отделайте его за меня как следует!"

# ch/jack/events.rpy:1381
translate russian jack_event_05_ac069758:
    "К возбуждённому голосу Лекси я уже привык."

# ch/jack/events.rpy:1382
translate russian jack_event_05_57a95231:
    "Он жутко заводит, но теперь я умею держать себя в руках."

# ch/jack/events.rpy:1383
translate russian jack_event_05_c3e86d78:
    "В отличие от Джека, которому явно становится жарко."

# ch/jack/events.rpy:1384
translate russian jack_event_05_a35da8b6:
    "Лекси всё время подскакивает и бьёт кулаками воздух."

# ch/jack/events.rpy:1385
translate russian jack_event_05_38522bce:
    "И каждый раз её пышные формы весьма энергично приходят в движение."

# ch/jack/events.rpy:1386
translate russian jack_event_05_efcb774c:
    "Джек то и дело тянется их разглядеть вместо того, чтобы следить за игрой."

# ch/jack/events.rpy:1387
translate russian jack_event_05_a8253f38:
    "Вскоре я оставляю его далеко позади."

# ch/jack/events.rpy:1389
translate russian jack_event_05_2e69324a:
    jack.say "А, чёрт!"

# ch/jack/events.rpy:1390
translate russian jack_event_05_20816f6d:
    jack.say "Не могу поверить! Ты опять меня обыграл!"

# ch/jack/events.rpy:1391
translate russian jack_event_05_8d610ae1:
    mike.say "Я не виноват, Джек."

# ch/jack/events.rpy:1392
translate russian jack_event_05_4ee5810f:
    mike.say "У тебя мысли совсем не об игре!"

# ch/jack/events.rpy:1393
translate russian jack_event_05_12e633c8:
    lexi.say "О да..."

# ch/jack/events.rpy:1395
translate russian jack_event_05_fd410dde:
    lexi.say "Мой герой!"

# ch/jack/events.rpy:1399
translate russian jack_event_05_a2c0ebf6:
    "Покачивая бёдрами, Лекси подходит и целует меня, сразу же просовывая язык мне в рот."

# ch/jack/events.rpy:1400
translate russian jack_event_05_f469bd6e:
    "И при этом демонстративно сжимает мой член!"

# ch/jack/events.rpy:1401
translate russian jack_event_05_17c62ec8:
    "Она едва ли не взбирается на меня, а Джеку остаётся лишь ошарашенно молчать."

# ch/jack/events.rpy:1412
translate russian jack_event_05_8a0afb1c:
    samantha.say "О..."

# ch/jack/events.rpy:1413
translate russian jack_event_05_2c98a438:
    samantha.say "Не знала, что вы играете в видеоигры!"

# ch/jack/events.rpy:1414
translate russian jack_event_05_8f7299a3:
    samantha.say "Пойду займусь чем-нибудь в другой комнате, ладно?"

# ch/jack/events.rpy:1415
translate russian jack_event_05_ae7e3458:
    "Услышав голос Сэм, мы с Джеком оборачиваемся."

# ch/jack/events.rpy:1416
translate russian jack_event_05_550cd998:
    "Увидев её в дверях, я уже собираюсь согласно кивнуть."

# ch/jack/events.rpy:1417
translate russian jack_event_05_5a5a190f:
    "Но Джек меня опережает, отчаянно мотая головой."

# ch/jack/events.rpy:1418
translate russian jack_event_05_eb991b1e:
    jack.say "О нет..."

# ch/jack/events.rpy:1419
translate russian jack_event_05_e78d4166:
    jack.say "Ни в коем случае, Саманта!"

# ch/jack/events.rpy:1421
translate russian jack_event_05_9d8edf31:
    jack.say "Можешь остаться и посмотреть, как мы играем. Если хочешь?"

# ch/jack/events.rpy:1422
translate russian jack_event_05_604c4b71:
    "Сэм улыбается той самой милой улыбкой, которой славится."

# ch/jack/events.rpy:1423
translate russian jack_event_05_645add29:
    "От неё у меня до сих пор тает сердце, хоть я и знаю Сэм столько лет."

# ch/jack/events.rpy:1424
translate russian jack_event_05_8b25b36f:
    "Неудивительно, что на Джека она действует так сильно!"

# ch/jack/events.rpy:1425
translate russian jack_event_05_0e119651:
    "Сэм вопросительно приподнимает брови, глядя на меня."

# ch/jack/events.rpy:1426
translate russian jack_event_05_b939f9a5:
    mike.say "Я не против, Сэм."

# ch/jack/events.rpy:1427
translate russian jack_event_05_6d73475b:
    mike.say "Оставайся, посмотри, как мы играем друг с другом..."

# ch/jack/events.rpy:1428
translate russian jack_event_05_952e8d10:
    mike.say "Я... то есть в видеоигры!"

# ch/jack/events.rpy:1430
translate russian jack_event_05_0e42a2cf:
    "Сэм садится, посмеиваясь и качая головой."

# ch/jack/events.rpy:1431
translate russian jack_event_05_26813aa3:
    samantha.say "Не волнуйся, я поняла!"

# ch/jack/events.rpy:1434
translate russian jack_event_05_bbb3b6e9:
    "Решаю, что сыграем в «Блюз барменши»."

# ch/jack/events.rpy:1435
translate russian jack_event_05_e987fc0e:
    "Игра очень старая, зато Сэм с ней знакома."

# ch/jack/events.rpy:1436
translate russian jack_event_05_dac04bce:
    "Вскоре мы с Джеком уже увлечённо соревнуемся."

# ch/jack/events.rpy:1437
translate russian jack_event_05_e57fbfd9:
    "Сэм радостно хлопает в ладоши и даёт советы, когда считает нужным."

# ch/jack/events.rpy:1438
translate russian jack_event_05_c929041c:
    "Я лишь киваю, по большей части пропуская её слова мимо ушей и сосредоточившись на игре."

# ch/jack/events.rpy:1439
translate russian jack_event_05_642c66c2:
    "А вот Джек, кажется, ловит каждое её слово."

# ch/jack/events.rpy:1440
translate russian jack_event_05_9c79e2f0:
    "И играет из-за этого совсем плохо!"

# ch/jack/events.rpy:1441
translate russian jack_event_05_00528470:
    "К концу игры я разбиваю Джека в пух и прах."

# ch/jack/events.rpy:1442
translate russian jack_event_05_1436ce07:
    jack.say "Ну, чувак!"

# ch/jack/events.rpy:1443
translate russian jack_event_05_bd278a4e:
    jack.say "Я думал, тут-то точно выиграю!"

# ch/jack/events.rpy:1444
translate russian jack_event_05_366ad5dc:
    mike.say "Кажется, ты просто отвлёкся, Джек."

# ch/jack/events.rpy:1446
translate russian jack_event_05_91ad9d81:
    samantha.say "Молодец!"

# ch/jack/events.rpy:1447
translate russian jack_event_05_611fd0ff:
    "Поворачиваю голову и вижу лицо Сэм совсем рядом."

# ch/jack/events.rpy:1451
translate russian jack_event_05_ca96a8e6:
    "Она целует меня, не дожидаясь разрешения."

# ch/jack/events.rpy:1452
translate russian jack_event_05_f08b514c:
    "Джек продолжает изумлённо смотреть даже после того, как поцелуй заканчивается."

# ch/jack/events.rpy:1460
translate russian jack_event_05_4918350a:
    "Когда мы заканчиваем играть, я замечаю, как Джек на меня смотрит."

# ch/jack/events.rpy:1461
translate russian jack_event_05_c258d17b:
    "Щурится, бросает косые взгляды, словно хочет о чём-то спросить."

# ch/jack/events.rpy:1462
translate russian jack_event_05_0224aaa6:
    "Наконец он набирается храбрости."

# ch/jack/events.rpy:1464
translate russian jack_event_05_104488a2:
    jack.say "Ты же мне лапшу на уши вешаешь, да?"

# ch/jack/events.rpy:1465
translate russian jack_event_05_e84ffc6f:
    mike.say "Что?"

# ch/jack/events.rpy:1466
translate russian jack_event_05_eaca306b:
    mike.say "Ты о чём?"

# ch/jack/events.rpy:1467
translate russian jack_event_05_5f948aa6:
    jack.say "О твоих соседках! О том, как они все тебя целуют!"

# ch/jack/events.rpy:1468
translate russian jack_event_05_5739d71b:
    jack.say "Это ведь не какой-то ваш странный способ праздновать победу?"

# ch/jack/events.rpy:1469
translate russian jack_event_05_75d4332c:
    "Я открываю рот, собираясь всё отрицать."

# ch/jack/events.rpy:1470
translate russian jack_event_05_580195e6:
    "Но Джек меня опережает."

# ch/jack/events.rpy:1471
translate russian jack_event_05_3e7e5e4c:
    jack.say "Если не скажешь правду..."

# ch/jack/events.rpy:1472
translate russian jack_event_05_88dc8b06:
    jack.say "Тогда... тогда я сам у них спрошу!"

# ch/jack/events.rpy:1473
translate russian jack_event_05_196976af:
    "Вот чёрт! Этого мне только не хватало!"

# ch/jack/events.rpy:1474
translate russian jack_event_05_a4982b7a:
    "Кажется, выбора нет."

# ch/jack/events.rpy:1475
translate russian jack_event_05_08e6e4e5:
    mike.say "Да, Джек..."

# ch/jack/events.rpy:1476
translate russian jack_event_05_0f47a354:
    mike.say "Признаю: мы со всеми ними спим, ясно?"

# ch/jack/events.rpy:1477
translate russian jack_event_05_308112bd:
    mike.say "Теперь доволен?"

# ch/jack/events.rpy:1479
translate russian jack_event_05_8da67174:
    "От моего признания глаза Джека чуть не выскакивают из орбит."

# ch/jack/events.rpy:1480
translate russian jack_event_05_c42c9bdf:
    "Мне всерьёз кажется, что он сейчас взорвётся или выкинет что-нибудь столь же бурное."

# ch/jack/events.rpy:1482
translate russian jack_event_05_7ddcfcb6:
    jack.say "Конечно, я не доволен!"

# ch/jack/events.rpy:1483
translate russian jack_event_05_70bbd946:
    jack.say "Это ты трахаешь всех своих соседок!"

# ch/jack/events.rpy:1484
translate russian jack_event_05_24c499d5:
    jack.say "С чего мне радоваться?!"

# ch/jack/events.rpy:1485
translate russian jack_event_05_dd182484:
    mike.say "Эй, чувак!"

# ch/jack/events.rpy:1486
translate russian jack_event_05_8fbc953b:
    mike.say "Ну не надо так..."

# ch/jack/events.rpy:1487
translate russian jack_event_05_cd46372e:
    mike.say "Я же не собирался этим перед тобой хвастаться!"

# ch/jack/events.rpy:1488
translate russian jack_event_05_41cf69b6:
    jack.say "А получилось именно так!"

# ch/jack/events.rpy:1489
translate russian jack_event_05_5cf1b464:
    jack.say "Думаю, мне пора домой."

# ch/jack/events.rpy:1491
translate russian jack_event_05_23c7ba53:
    "С этими словами Джек встаёт и идёт к двери."

# ch/jack/events.rpy:1492
translate russian jack_event_05_bc1fa93a:
    "Мне остаётся только следовать за ним и пытаться извиниться."

# ch/jack/events.rpy:1496
translate russian jack_event_05_17ca409b:
    "Но стоит мне открыть рот, он поднимает ладонь, обрывая меня."

# ch/jack/events.rpy:1497
translate russian jack_event_05_fa19df29:
    "Затем выходит и быстрым шагом удаляется по улице."

# ch/jack/events.rpy:1499
translate russian jack_event_05_e809e857:
    "А я качаю головой, не представляя, как решить эту проблему."

# ch/jack/events.rpy:1500
translate russian jack_event_05_82a6d7fc:
    "Не хочу терять такого старого друга, как Джек."

# ch/jack/events.rpy:1501
translate russian jack_event_05_0d669b3f:
    "Но и отказываться от отношений с соседками тоже не хочу."

# ch/jack/events.rpy:1502
translate russian jack_event_05_5984a93b:
    "Ох... Придётся как следует подумать."

# ch/jack/events.rpy:1507
translate russian jack_nude_beach_82f991bb:
    "Едва увидев Джека, понимаю: ему не терпится что-то мне рассказать."

# ch/jack/events.rpy:1508
translate russian jack_nude_beach_56a02b75:
    "Он явно пытается выбрать момент, чтобы как следует меня впечатлить."

# ch/jack/events.rpy:1509
translate russian jack_nude_beach_9e26e82b:
    "Из-за этого почти не слушает, о чём ещё мы говорим."

# ch/jack/events.rpy:1510
translate russian jack_nude_beach_b0a2fbb9:
    "И, честно говоря, это уже изрядно раздражает!"

# ch/jack/events.rpy:1511
translate russian jack_nude_beach_d92e9f72:
    "Решаю разрушить его замысел и заставить наконец поделиться новостью."

# ch/jack/events.rpy:1512
translate russian jack_nude_beach_62d73a39:
    mike.say "Джек, да выкладывай уже!"

# ch/jack/events.rpy:1513
translate russian jack_nude_beach_860a3ddf:
    jack.say "А?"

# ch/jack/events.rpy:1514
translate russian jack_nude_beach_fc1b2ae1:
    jack.say "Ты о чём?"

# ch/jack/events.rpy:1515
translate russian jack_nude_beach_1d603c5e:
    "Я закатываю глаза и качаю головой."

# ch/jack/events.rpy:1516
translate russian jack_nude_beach_2bc98267:
    mike.say "Ну, Джек!"

# ch/jack/events.rpy:1517
translate russian jack_nude_beach_dc47f9d1:
    mike.say "Ты чуть ли не приплясываешь на месте!"

# ch/jack/events.rpy:1518
translate russian jack_nude_beach_1d65730f:
    mike.say "Значит, тебе есть что рассказать."

# ch/jack/events.rpy:1519
translate russian jack_nude_beach_1bbacb0e:
    mike.say "Что-то настолько крутое, что мне, по-твоему, крышу снесёт!"

# ch/jack/events.rpy:1520
translate russian jack_nude_beach_33da0064:
    "На миг кажется, что Джек продолжит прикидываться."

# ch/jack/events.rpy:1521
translate russian jack_nude_beach_f790eff9:
    "Но он чуть сникает и вздыхает, признавая поражение."

# ch/jack/events.rpy:1522
translate russian jack_nude_beach_32674286:
    jack.say "Ладно, ладно..."

# ch/jack/events.rpy:1523
translate russian jack_nude_beach_e8ed0789:
    jack.say "Раскусил."

# ch/jack/events.rpy:1524
translate russian jack_nude_beach_2ac3a942:
    jack.say "Но это правда нечто очень крутое!"

# ch/jack/events.rpy:1525
translate russian jack_nude_beach_63aa0051:
    "И настроение у него тут же снова меняется."

# ch/jack/events.rpy:1526
translate russian jack_nude_beach_d970fbaf:
    "Досада от того, что его раскусили, исчезает."

# ch/jack/events.rpy:1528
translate russian jack_nude_beach_48f38b4d:
    "Джек опять оживляется и загорается энтузиазмом."

# ch/jack/events.rpy:1529
translate russian jack_nude_beach_f9871c0e:
    jack.say "Не поверишь, что скоро откроется неподалёку, чувак!"

# ch/jack/events.rpy:1530
translate russian jack_nude_beach_85651550:
    jack.say "Поверь, как только скажу — ты обалдеешь!"

# ch/jack/events.rpy:1531
translate russian jack_nude_beach_0d2763d2:
    mike.say "Ничего не будет, пока ты наконец не скажешь, Джек!"

# ch/jack/events.rpy:1532
translate russian jack_nude_beach_bbe5befb:
    mike.say "Хватит ходить вокруг да около, выкладывай!"

# ch/jack/events.rpy:1533
translate russian jack_nude_beach_b3ef613a:
    "Джек поднимает ладонь, показывая, что понял."

# ch/jack/events.rpy:1534
translate russian jack_nude_beach_9880f68a:
    jack.say "Ладно, да, ладно..."

# ch/jack/events.rpy:1535
translate russian jack_nude_beach_e25113bd:
    jack.say "Слушай..."

# ch/jack/events.rpy:1536
translate russian jack_nude_beach_25dc3ab7:
    jack.say "Открывают пляж!"

# ch/jack/events.rpy:1537
translate russian jack_nude_beach_37dc7125:
    "Я морщусь и недоумённо смотрю на него."

# ch/jack/events.rpy:1538
translate russian jack_nude_beach_abce239e:
    mike.say "И что?!"

# ch/jack/events.rpy:1539
translate russian jack_nude_beach_1120dcd7:
    mike.say "Тут пляжей на много километров!"

# ch/jack/events.rpy:1540
translate russian jack_nude_beach_764d7966:
    "Джек секунду смотрит на меня так, словно я заговорил на иностранном языке."

# ch/jack/events.rpy:1541
translate russian jack_nude_beach_2341c712:
    "Потом качает головой, поняв, что кое-что забыл."

# ch/jack/events.rpy:1542
translate russian jack_nude_beach_eb2cb7e1:
    jack.say "Прости, чувак!"

# ch/jack/events.rpy:1543
translate russian jack_nude_beach_b025067a:
    jack.say "У меня от этой новости голова кругом."

# ch/jack/events.rpy:1545
translate russian jack_nude_beach_9efa5162:
    jack.say "Я хотел сказать: НУДИСТСКИЙ пляж!"

# ch/jack/events.rpy:1546
translate russian jack_nude_beach_1cb5446a:
    "Даже после этих слов новость не сразу до меня доходит."

# ch/jack/events.rpy:1547
translate russian jack_nude_beach_67016172:
    "Вроде все слова понятны, а смысл никак не складывается."

# ch/jack/events.rpy:1548
translate russian jack_nude_beach_f3738d1d:
    "Я только глупо моргаю, пока Джек лыбится во весь рот."

# ch/jack/events.rpy:1549
translate russian jack_nude_beach_8a38776a:
    mike.say "Ты хочешь сказать..."

# ch/jack/events.rpy:1550
translate russian jack_nude_beach_150f5366:
    jack.say "Именно!"

# ch/jack/events.rpy:1551
translate russian jack_nude_beach_4e1150ea:
    mike.say "Нудистский, то есть..."

# ch/jack/events.rpy:1552
translate russian jack_nude_beach_6771a9ad:
    jack.say "Совершенно верно!"

# ch/jack/events.rpy:1553
translate russian jack_nude_beach_31d6237c:
    mike.say "Совсем без одежды..."

# ch/jack/events.rpy:1554
translate russian jack_nude_beach_ed95b328:
    jack.say "Теперь понимаешь, почему я так рад?!"

# ch/jack/events.rpy:1555
translate russian jack_nude_beach_73f7791f:
    "Вдруг всё встаёт на свои места."

# ch/jack/events.rpy:1556
translate russian jack_nude_beach_8957a2ee:
    "Словно просыпаешься и видишь прекрасный рассвет."

# ch/jack/events.rpy:1557
translate russian jack_nude_beach_50b1bb4f:
    mike.say "У нас будет нудистский пляж!"

# ch/jack/events.rpy:1558
translate russian jack_nude_beach_50cc26fc:
    jack.say "Ещё как будет!"

# ch/jack/events.rpy:1559
translate russian jack_nude_beach_30da86aa:
    mike.say "Вау... Просто вау!"

# ch/jack/events.rpy:1560
translate russian jack_nude_beach_e17cd036:
    jack.say "Вот именно, чувак! Надо прямо сейчас начать готовиться!"

# ch/jack/events.rpy:1561
translate russian jack_nude_beach_532272c8:
    jack.say "Разведать местность, выбрать лучшие места!"

# ch/jack/events.rpy:1562
translate russian jack_nude_beach_9dc979db:
    "Пока Джек тараторит, я начинаю всерьёз задумываться о нудистском пляже."

# ch/jack/events.rpy:1563
translate russian jack_nude_beach_faf7be06:
    "Часть меня искренне радуется возможности полюбоваться открывающимися видами."

# ch/jack/events.rpy:1564
translate russian jack_nude_beach_d4d7185e:
    "Но другая, меньшая часть немного волнуется: ведь и на меня будут смотреть!"

# ch/jack/events.rpy:1565
translate russian jack_nude_beach_5a7a9dc3:
    "Стараюсь отогнать эту мысль и настроиться на хорошее."

# ch/jack/events.rpy:1566
translate russian jack_nude_beach_26d1b04c:
    "Возможно, это начало совершенно нового приключения!"

# ch/jack/events.rpy:1571
translate russian jack_react_kylie_sentence_103a42c9:
    jack.say "Эй!"

# ch/jack/events.rpy:1573
translate russian jack_react_kylie_sentence_09f27c8b:
    jack.say "Эй, [hero.name]…"

# ch/jack/events.rpy:1575
translate russian jack_react_kylie_sentence_3207ab73:
    jack.say "Это правда?!"

# ch/jack/events.rpy:1576
translate russian jack_react_kylie_sentence_42b9d9e0:
    "Услышав знакомый голос Джека, я поднимаю голову."

# ch/jack/events.rpy:1577
translate russian jack_react_kylie_sentence_60926da4:
    "Он спешит ко мне, размахивая руками."

# ch/jack/events.rpy:1578
translate russian jack_react_kylie_sentence_bdbc7ea5:
    "Быстро оглядываюсь: ни спрятаться, ни сбежать некуда."

# ch/jack/events.rpy:1579
translate russian jack_react_kylie_sentence_f74af116:
    "Похоже, остаётся только стоять и ждать, пока он подойдёт."

# ch/jack/events.rpy:1580
translate russian jack_react_kylie_sentence_c1b606f7:
    "Наверное, стоило этого ожидать."

# ch/jack/events.rpy:1581
translate russian jack_react_kylie_sentence_21f532fe:
    "С тех пор как Кайли вынесли приговор, люди то и дело меня разыскивают."

# ch/jack/events.rpy:1582
translate russian jack_react_kylie_sentence_37f6a828:
    "Кто-то — чтобы спросить, как я держусь."

# ch/jack/events.rpy:1583
translate russian jack_react_kylie_sentence_07a15c9d:
    "Но большинство — чтобы рассказать, что они сами об этом думают."

# ch/jack/events.rpy:1587
translate russian jack_react_kylie_sentence_768d8316:
    "А Джек никогда не отличался тактичностью."

# ch/jack/events.rpy:1588
translate russian jack_react_kylie_sentence_c8eb51ff:
    "Рано или поздно он бы меня нашёл."

# ch/jack/events.rpy:1590
translate russian jack_react_kylie_sentence_2e6d3b27:
    mike.say "Привет, Джек..."

# ch/jack/events.rpy:1591
translate russian jack_react_kylie_sentence_83000b47:
    mike.say "Спросить, как я, времени нет?"

# ch/jack/events.rpy:1592
translate russian jack_react_kylie_sentence_f6a312ab:
    mike.say "Не хочешь узнать, что у меня сейчас на душе?"

# ch/jack/events.rpy:1593
translate russian jack_react_kylie_sentence_f8426565:
    mike.say "Сразу к смертному приговору, да?"

# ch/jack/events.rpy:1594
translate russian jack_react_kylie_sentence_5d23d96c:
    "Надо отдать ему должное: мои слова сразу действуют."

# ch/jack/events.rpy:1595
translate russian jack_react_kylie_sentence_f7708a42:
    "На лице Джека тут же появляется неловкое смущение."

# ch/jack/events.rpy:1597
translate russian jack_react_kylie_sentence_b9885110:
    jack.say "Да..."

# ch/jack/events.rpy:1598
translate russian jack_react_kylie_sentence_a38e9d11:
    jack.say "Нет..."

# ch/jack/events.rpy:1599
translate russian jack_react_kylie_sentence_89123acd:
    jack.say "То есть..."

# ch/jack/events.rpy:1600
translate russian jack_react_kylie_sentence_9081a91c:
    "Удовольствие от того, что я застал Джека врасплох, быстро проходит."

# ch/jack/events.rpy:1601
translate russian jack_react_kylie_sentence_5483b466:
    "Вскоре мне уже хочется избавить его от неловкости."

# ch/jack/events.rpy:1602
translate russian jack_react_kylie_sentence_5e721146:
    "Я качаю головой и говорю мягче."

# ch/jack/events.rpy:1604
translate russian jack_react_kylie_sentence_3a8e7029:
    mike.say "Всё нормально, Джек..."

# ch/jack/events.rpy:1605
translate russian jack_react_kylie_sentence_eec8d7c1:
    mike.say "Об этом в любом случае нелегко говорить."

# ch/jack/events.rpy:1606
translate russian jack_react_kylie_sentence_a1892043:
    mike.say "Может, лучше и правда сразу начистоту."

# ch/jack/events.rpy:1608
translate russian jack_react_kylie_sentence_fd2ae6b6:
    "Джек кивает и выглядит уже чуть спокойнее."

# ch/jack/events.rpy:1609
translate russian jack_react_kylie_sentence_fd649bd7:
    "Но, заговорив, явно старается быть осторожнее."

# ch/jack/events.rpy:1610
translate russian jack_react_kylie_sentence_44854130:
    jack.say "Я правда хотел спросить, [hero.name]…"

# ch/jack/events.rpy:1611
translate russian jack_react_kylie_sentence_1a3e5868:
    jack.say "Правда ли это."

# ch/jack/events.rpy:1612
translate russian jack_react_kylie_sentence_5fb77bb3:
    jack.say "Все говорят, но сам я ни в новостях, ни где-то ещё не видел."

# ch/jack/events.rpy:1613
translate russian jack_react_kylie_sentence_fa469e7f:
    "Я пожимаю плечами и вздыхаю."

# ch/jack/events.rpy:1614
translate russian jack_react_kylie_sentence_12e22c11:
    "Потом киваю."

# ch/jack/events.rpy:1615
translate russian jack_react_kylie_sentence_08e6e4e5:
    mike.say "Да, Джек..."

# ch/jack/events.rpy:1616
translate russian jack_react_kylie_sentence_3aed7472:
    mike.say "Всё правда."

# ch/jack/events.rpy:1617
translate russian jack_react_kylie_sentence_cbf694dc:
    mike.say "Кайли признали виновной. Без всяких сомнений."

# ch/jack/events.rpy:1618
translate russian jack_react_kylie_sentence_680dc78b:
    mike.say "И приговорили к смерти!"

# ch/jack/events.rpy:1620
translate russian jack_react_kylie_sentence_044c1ed0:
    "Джек медленно кивает, словно только сейчас начинает осознавать произошедшее."

# ch/jack/events.rpy:1622
translate russian jack_react_kylie_sentence_99aff687:
    "Несколько секунд он молчит с открытым ртом."

# ch/jack/events.rpy:1623
translate russian jack_react_kylie_sentence_e933e28f:
    "Я уже думаю, что он и вправду лишился дара речи."

# ch/jack/events.rpy:1624
translate russian jack_react_kylie_sentence_bfbb8abd:
    "Но он моргает и трясёт головой, словно мозг перезагружается."

# ch/jack/events.rpy:1626
translate russian jack_react_kylie_sentence_0812f35c:
    jack.say "Охренеть..."

# ch/jack/events.rpy:1627
translate russian jack_react_kylie_sentence_c1aeed37:
    jack.say "Это же какое-то безумие, чувак!"

# ch/jack/events.rpy:1628
translate russian jack_react_kylie_sentence_59be8539:
    jack.say "Словно мы живём в кино."

# ch/jack/events.rpy:1629
translate russian jack_react_kylie_sentence_bd2f4ec7:
    mike.say "Ага, в фильме ужасов!"

# ch/jack/events.rpy:1630
translate russian jack_react_kylie_sentence_0ef45922:
    mike.say "Который к тому же никак не закончится."

# ch/jack/events.rpy:1631
translate russian jack_react_kylie_sentence_d502c795:
    "Теперь Джек качает головой, и до него, кажется, доходит вся серьёзность."

# ch/jack/events.rpy:1632
translate russian jack_react_kylie_sentence_f7894f98:
    "Кто знает, может, он наконец осмыслил всё случившееся."

# ch/jack/events.rpy:1633
translate russian jack_react_kylie_sentence_b0fb3965:
    "Может, сейчас этот блаженный дурак выдаст неожиданную мудрость, которая поможет и мне."

# ch/jack/events.rpy:1634
translate russian jack_react_kylie_sentence_b9885110_1:
    jack.say "Да..."

# ch/jack/events.rpy:1636
translate russian jack_react_kylie_sentence_f6262159:
    jack.say "Паршивая история, чувак."

# ch/jack/events.rpy:1637
translate russian jack_react_kylie_sentence_70892ca0:
    jack.say "И самое обидное, Кайли ведь такая горячая!"

# ch/jack/events.rpy:1638
translate russian jack_react_kylie_sentence_e84ffc6f:
    mike.say "Что?"

# ch/jack/events.rpy:1640
translate russian jack_react_kylie_sentence_2621a53e:
    jack.say "Ты же сам знаешь!"

# ch/jack/events.rpy:1642
translate russian jack_react_kylie_sentence_39f18ea6:
    jack.say "Я бы хоть разок с удовольствием присунул такой психопатке."

# ch/jack/events.rpy:1643
translate russian jack_react_kylie_sentence_58345fa2:
    jack.say "А она была сумасшедшей высшего сорта, со знаком качества!"

# ch/jack/events.rpy:1644
translate russian jack_react_kylie_sentence_337cac9e:
    "Закатываю глаза и качаю головой, поражённый тем, что слышу."

# ch/jack/events.rpy:1645
translate russian jack_react_kylie_sentence_96fdbb50:
    mike.say "Ты серьёзно, Джек?"

# ch/jack/events.rpy:1648
translate russian jack_react_kylie_sentence_7a2e8913:
    jack.say "Что?"

# ch/jack/events.rpy:1649
translate russian jack_react_kylie_sentence_845a1a04:
    mike.say "Совсем не смешно. Серьёзно, совсем!"
