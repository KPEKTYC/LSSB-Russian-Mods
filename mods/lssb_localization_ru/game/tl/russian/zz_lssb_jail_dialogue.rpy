# Native Jail identifiers, current source catalog. Translation only.

# ch/harems_full/jail/events.rpy:35
translate russian camila_kylie_propose_male_94361e7d:
    "Странно, что тюремные свидания стали такой привычной частью моей повседневной жизни."

# ch/harems_full/jail/events.rpy:36
translate russian camila_kylie_propose_male_a1602066:
    "Когда Кайли осудили и посадили, часть меня решила, что на этом всё закончится."

# ch/harems_full/jail/events.rpy:38
translate russian camila_kylie_propose_male_bc1e361c:
    "И я был почти уверен, что Камила окончательно отвернётся от неё."

# ch/harems_full/jail/events.rpy:39
translate russian camila_kylie_propose_male_398afe92:
    "Но, как ни странно, всё вышло наоборот: связь между нами троими лишь окрепла."

# ch/harems_full/jail/events.rpy:40
translate russian camila_kylie_propose_male_56f9aea2:
    "После того как всё это безумие вышло наружу, мы каким-то образом увидели настоящую Кайли."

# ch/harems_full/jail/events.rpy:41
translate russian camila_kylie_propose_male_ab0d1118:
    "И поняли, что безумно любим девушку, оказавшуюся в центре всего этого."

# ch/harems_full/jail/events.rpy:42
translate russian camila_kylie_propose_male_fbf634e3:
    "К тому же за решёткой Кайли вовсе не превратилась в кровожадное чудовище."

# ch/harems_full/jail/events.rpy:43
translate russian camila_kylie_propose_male_6d7c338d:
    "Похоже, она действительно сожалеет о содеянном и готова загладить вину."

# ch/harems_full/jail/events.rpy:44
translate russian camila_kylie_propose_male_e82619d3:
    "А я не могу перестать думать о том, что мы могли бы сделать иначе."

# ch/harems_full/jail/events.rpy:45
translate russian camila_kylie_propose_male_b2876d2c:
    "Может, стоило быть внимательнее к ней, чаще её слушать."

# ch/harems_full/jail/events.rpy:46
translate russian camila_kylie_propose_male_65bbed9a:
    "Тогда, возможно, мы бы заметили тревожные признаки и уберегли её от того, что она совершила."

# ch/harems_full/jail/events.rpy:47
translate russian camila_kylie_propose_male_5badf649:
    "Поэтому теперь мы решились сделать для неё всё, что в наших силах."

# ch/harems_full/jail/events.rpy:48
translate russian camila_kylie_propose_male_4c65d918:
    "Мы хотим, чтобы у нас с Кайли было совместное будущее."

# ch/harems_full/jail/events.rpy:49
translate russian camila_kylie_propose_male_d2cbbeb0:
    "Хотим доказать ей, что всегда будем рядом."

# ch/harems_full/jail/events.rpy:50
translate russian camila_kylie_propose_male_b44b0d1e:
    "Поэтому, когда мы в следующий раз приходим на свидание в тюрьму, мы с Камилой действуем заодно."

# ch/harems_full/jail/events.rpy:51
translate russian camila_kylie_propose_male_54efab15:
    "При входе обмениваемся кивками, а затем ждём подходящего момента."

# ch/harems_full/jail/events.rpy:52
translate russian camila_kylie_propose_male_fc7c0eb3:
    "И когда он наступает, я достаю кольцо, которое всё это время сжимал в кармане."

# ch/harems_full/jail/events.rpy:53
translate russian camila_kylie_propose_male_5472b90c:
    "Затем мы опускаемся на одно колено перед дверью камеры Кайли."

# ch/harems_full/jail/events.rpy:55
translate russian camila_kylie_propose_male_c2875b87:
    kylie.say "Ч... что происходит?"

# ch/harems_full/jail/events.rpy:56
translate russian camila_kylie_propose_male_6921aa09:
    kylie.say "[lssb_common.hero_name()], Камила..."

# ch/harems_full/jail/events.rpy:58
translate russian camila_kylie_propose_male_b565f101:
    kylie.say "Что вы делаете?"

# ch/harems_full/jail/events.rpy:59
translate russian camila_kylie_propose_male_20cc26f8:
    mike.say "Я давно хотел это сделать, Кайли."

# ch/harems_full/jail/events.rpy:60
translate russian camila_kylie_propose_male_0e9974ac:
    camila.say "Я тоже. Мы оба давно хотели."

# ch/harems_full/jail/events.rpy:61
translate russian camila_kylie_propose_male_bbb51b8a:
    mike.say "Я хочу сказать, что люблю тебя."

# ch/harems_full/jail/events.rpy:62
translate russian camila_kylie_propose_male_9db91d4d:
    camila.say "И я, Кайли! Я от тебя без ума!"

# ch/harems_full/jail/events.rpy:63
translate russian camila_kylie_propose_male_e5c24384:
    mike.say "И что мы всегда будем рядом."

# ch/harems_full/jail/events.rpy:64
translate russian camila_kylie_propose_male_07958371:
    mike.say "Так... ты выйдешь за нас?"

# ch/harems_full/jail/events.rpy:65
translate russian camila_kylie_propose_male_a23dfa7f:
    camila.say "Скажи «да», Кайли, пожалуйста!"

# ch/harems_full/jail/events.rpy:67
translate russian camila_kylie_propose_male_d868cc93:
    "Кайли выглядит потрясённой, словно не верит в происходящее."

# ch/harems_full/jail/events.rpy:68
translate russian camila_kylie_propose_male_49275fb7:
    "Поэтому я совершенно не могу разобрать выражение её лица."

# ch/harems_full/jail/events.rpy:69
translate russian camila_kylie_propose_male_90b29eef:
    "Но, к счастью, она быстро приходит в себя."

# ch/harems_full/jail/events.rpy:71
translate russian camila_kylie_propose_male_98444425:
    "Кайли с готовностью кивает и протягивает руку."

# ch/harems_full/jail/events.rpy:72
translate russian camila_kylie_propose_male_41be3069:
    "Я не упускаю свой шанс."

# ch/harems_full/jail/events.rpy:73
translate russian camila_kylie_propose_male_351d3c43:
    "И без колебаний надеваю кольцо ей на палец."

# ch/harems_full/jail/events.rpy:75
translate russian camila_kylie_propose_male_0f6a3942:
    kylie.say "Ох, [lssb_common.hero_name()], Камила!"

# ch/harems_full/jail/events.rpy:76
translate russian camila_kylie_propose_male_a695c100:
    kylie.say "Я думала, вы никогда не предложите мне пожениться."

# ch/harems_full/jail/events.rpy:77
translate russian camila_kylie_propose_male_4fa85960:
    kylie.say "После всего, что я натворила."

# ch/harems_full/jail/events.rpy:78
translate russian camila_kylie_propose_male_ebf78201:
    "Пока Кайли кивает, мы качаем головами."

# ch/harems_full/jail/events.rpy:79
translate russian camila_kylie_propose_male_278f6597:
    mike.say "Боже, нет, Кайли!"

# ch/harems_full/jail/events.rpy:81
translate russian camila_kylie_propose_male_7b992756:
    camila.say "Ни за что!"

# ch/harems_full/jail/events.rpy:82
translate russian camila_kylie_propose_male_3c102bde:
    mike.say "Всё это..."

# ch/harems_full/jail/events.rpy:83
translate russian camila_kylie_propose_male_d26862bd:
    mike.say "Лишь помогло мне понять, как сильно я тебя люблю."

# ch/harems_full/jail/events.rpy:84
translate russian camila_kylie_propose_male_5a83df55:
    camila.say "Это не твоя вина, Кайли."

# ch/harems_full/jail/events.rpy:85
translate russian camila_kylie_propose_male_2fd943f2:
    camila.say "Это был крик о помощи."

# ch/harems_full/jail/events.rpy:86
translate russian camila_kylie_propose_male_1468c8d9:
    mike.say "После этого я ещё сильнее захотел быть с тобой."

# ch/harems_full/jail/events.rpy:87
translate russian camila_kylie_propose_male_28ffdf84:
    camila.say "А я и представить не могла, что так влюблюсь в преступницу!"

# ch/harems_full/jail/events.rpy:88
translate russian camila_kylie_propose_male_ad1f1133:
    mike.say "Я хочу построить жизнь для нас троих."

# ch/harems_full/jail/events.rpy:89
translate russian camila_kylie_propose_male_6f2b458e:
    camila.say "Ну же, Кайли, скажи, что ты согласна!"

# ch/harems_full/jail/events.rpy:90
translate russian camila_kylie_propose_male_c2a3fe0b:
    "К тому, что происходит дальше, я совершенно не готов."

# ch/harems_full/jail/events.rpy:91
translate russian camila_kylie_propose_male_fdd866cd:
    "Кайли просовывает руки сквозь решётку и хватает одной меня, а другой — Камилу."

# ch/harems_full/jail/events.rpy:92
translate russian camila_kylie_propose_male_cce784da:
    "Она резко притягивает нас к двери камеры, едва не выбивая из меня дух."

# ch/harems_full/jail/events.rpy:93
translate russian camila_kylie_propose_male_343bd523:
    "Но я не успеваю даже охнуть от боли, как она прижимается губами к моим."

# ch/harems_full/jail/events.rpy:94
translate russian camila_kylie_propose_male_1408ecb7:
    "Я почти уверен, что сейчас нам не стоит этого делать."

# ch/harems_full/jail/events.rpy:95
translate russian camila_kylie_propose_male_96ba20eb:
    "Но не могу заставить себя отстраниться."

# ch/harems_full/jail/events.rpy:96
translate russian camila_kylie_propose_male_ea230430:
    "Вместо этого отвечаю на поцелуй, надеюсь, с не меньшей страстью."

# ch/harems_full/jail/events.rpy:97
translate russian camila_kylie_propose_male_5e8f2184:
    "Камила тоже присоединяется, и мы втроём целуемся по очереди."

# ch/harems_full/jail/events.rpy:98
translate russian camila_kylie_propose_male_67d28414:
    "Мгновение спустя я слышу, как за спиной открывается дверь."

# ch/harems_full/jail/events.rpy:99
translate russian camila_kylie_propose_male_473afcd4:
    "Я понимаю: это кто-то из охранников идёт нас разнять."

# ch/harems_full/jail/events.rpy:100
translate russian camila_kylie_propose_male_de4b5734:
    "Поэтому отстраняюсь и прерываю поцелуй."

# ch/harems_full/jail/events.rpy:101
translate russian camila_kylie_propose_male_ec41f5fe:
    "Камила делает то же самое."

# ch/harems_full/jail/events.rpy:102
translate russian camila_kylie_propose_male_48f3264b:
    "Мы едва успеваем попрощаться с Кайли."

# ch/harems_full/jail/events.rpy:103
translate russian camila_kylie_propose_male_d93a5d65:
    "И нас уже провожают к выходу."

# ch/harems_full/jail/events.rpy:104
translate russian camila_kylie_propose_male_3fbce5b9:
    "От произошедшего у меня кружится голова."

# ch/harems_full/jail/events.rpy:105
translate russian camila_kylie_propose_male_9edd0de6:
    "Мне нужно время, чтобы собраться с мыслями."

# ch/harems_full/jail/events.rpy:106
translate russian camila_kylie_propose_male_8da9a729:
    "Но время следующего свидания наступит достаточно скоро."

# ch/harems_full/jail/events.rpy:107
translate russian camila_kylie_propose_male_9b7dc656:
    "И тогда мы с Кайли и Камилой сможем по-настоящему начать планировать наше будущее."

# ch/harems_full/jail/events.rpy:111
translate russian camila_kylie_propose_male_5477745a:
    "Кайли качает головой и начинает пятиться от нас."

# ch/harems_full/jail/events.rpy:113
translate russian camila_kylie_propose_male_a81f7ec7:
    "И останавливается, лишь упершись спиной в дальнюю стену."

# ch/harems_full/jail/events.rpy:114
translate russian camila_kylie_propose_male_66fe8d05:
    "Мы остаёмся у двери камеры, вцепившись в прутья и пытаясь понять, что происходит."

# ch/harems_full/jail/events.rpy:115
translate russian camila_kylie_propose_male_62e89066:
    camila.say "Кайли!"

# ch/harems_full/jail/events.rpy:117
translate russian camila_kylie_propose_male_036f869f:
    mike.say "Что случилось?"

# ch/harems_full/jail/events.rpy:118
translate russian camila_kylie_propose_male_4eee76b0:
    mike.say "Мы слишком торопимся?"

# ch/harems_full/jail/events.rpy:119
translate russian camila_kylie_propose_male_ff6487ab:
    camila.say "Да, Кайли, это ведь надо переварить."

# ch/harems_full/jail/events.rpy:120
translate russian camila_kylie_propose_male_0edd34e1:
    mike.say "Тебе не обязательно отвечать прямо сейчас."

# ch/harems_full/jail/events.rpy:121
translate russian camila_kylie_propose_male_cbdbbecd:
    mike.say "Если нужно время, мы подождём."

# ch/harems_full/jail/events.rpy:122
translate russian camila_kylie_propose_male_00713ad1:
    camila.say "Конечно. Мы можем подождать."

# ch/harems_full/jail/events.rpy:123
translate russian camila_kylie_propose_male_17769d66:
    kylie.say "Нет, нет, нет!"

# ch/harems_full/jail/events.rpy:126
translate russian camila_kylie_propose_male_b978e296:
    kylie.say "Ты не можешь просить меня об этом, [lssb_common.hero_name()]!"

# ch/harems_full/jail/events.rpy:128
translate russian camila_kylie_propose_male_7b9bd5a0:
    kylie.say "Я должна быть наказана! Неужели ты не понимаешь?!"

# ch/harems_full/jail/events.rpy:129
translate russian camila_kylie_propose_male_d1207f66:
    mike.say "О чём ты говоришь, Кайли?"

# ch/harems_full/jail/events.rpy:130
translate russian camila_kylie_propose_male_9f91e13a:
    mike.say "Ты сидишь в тюрьме за то, что случилось."

# ch/harems_full/jail/events.rpy:131
translate russian camila_kylie_propose_male_56f8fe07:
    mike.say "Разве это не наказание?"

# ch/harems_full/jail/events.rpy:132
translate russian camila_kylie_propose_male_b45cd7c2:
    camila.say "Поверь, я знаю, как это работает."

# ch/harems_full/jail/events.rpy:133
translate russian camila_kylie_propose_male_a01e6262:
    camila.say "Почти любой человек может исправиться!"

# ch/harems_full/jail/events.rpy:134
translate russian camila_kylie_propose_male_4e7e6958:
    mike.say "Камила права, Кайли."

# ch/harems_full/jail/events.rpy:135
translate russian camila_kylie_propose_male_b956a657:
    mike.say "Я хочу, чтобы мы начали планировать нашу совместную жизнь!"

# ch/harems_full/jail/events.rpy:136
translate russian camila_kylie_propose_male_df62a7a0:
    kylie.say "Нет, ничего не выйдет!"

# ch/harems_full/jail/events.rpy:138
translate russian camila_kylie_propose_male_f44393f3:
    kylie.say "Я пыталась всё наладить, [lssb_common.hero_name()]."

# ch/harems_full/jail/events.rpy:139
translate russian camila_kylie_propose_male_255b0336:
    kylie.say "Но всё закончилось катастрофой."

# ch/harems_full/jail/events.rpy:140
translate russian camila_kylie_propose_male_aeb8c001:
    kylie.say "Мы не можем спасти то, что уже разрушено."

# ch/harems_full/jail/events.rpy:141
translate russian camila_kylie_propose_male_feec546c:
    "Я открываю рот, чтобы возразить, попытаться уговорить Кайли."

# ch/harems_full/jail/events.rpy:142
translate russian camila_kylie_propose_male_1cc0df1d:
    "Но она перебивает меня криком, глядя мне за спину."

# ch/harems_full/jail/events.rpy:143
translate russian camila_kylie_propose_male_d26307f4:
    kylie.say "ОХРАНА!.. ОХРАНА!"

# ch/harems_full/jail/events.rpy:144
translate russian camila_kylie_propose_male_8d1319a6:
    kylie.say "Я хочу побыть одна!"

# ch/harems_full/jail/events.rpy:145
translate russian camila_kylie_propose_male_67a933e9:
    kylie.say "Пусть они уйдут!"

# ch/harems_full/jail/events.rpy:146
translate russian camila_kylie_propose_male_5c42948c:
    "Когда входят охранники, я встаю и убираю кольцо."

# ch/harems_full/jail/events.rpy:147
translate russian camila_kylie_propose_male_7a69231e:
    "Камила тоже поднимается — ей подобные ситуации давно привычны."

# ch/harems_full/jail/events.rpy:148
translate russian camila_kylie_propose_male_78b2e3d6:
    "И никто из нас не спорит, когда нас вежливо, но твёрдо просят уйти."

# ch/harems_full/jail/events.rpy:150
translate russian camila_kylie_propose_male_3fbce5b9_1:
    "От произошедшего у меня кружится голова."

# ch/harems_full/jail/events.rpy:151
translate russian camila_kylie_propose_male_9edd0de6_1:
    "Мне нужно время, чтобы собраться с мыслями."

# ch/harems_full/jail/events.rpy:152
translate russian camila_kylie_propose_male_cc5f45b8:
    "А тюрьма — не лучшее место для этого."

# ch/harems_full/jail/events.rpy:153
translate russian camila_kylie_propose_male_b7bfd267:
    "Камила, со своей стороны, вроде бы держится."

# ch/harems_full/jail/events.rpy:154
translate russian camila_kylie_propose_male_0f1dcd48:
    "Но я знаю, как хорошо она умеет скрывать чувства."

# ch/harems_full/jail/events.rpy:155
translate russian camila_kylie_propose_male_f8005d15:
    "Так что придётся подождать, чтобы понять, что она на самом деле испытывает."

# ch/harems_full/jail/events.rpy:163
translate russian camila_kylie_male_ending_e5a1d957:
    "С тех пор как в моей жизни появились Камила и Кайли, она превратилась в нескончаемые американские горки."

# ch/harems_full/jail/events.rpy:164
translate russian camila_kylie_male_ending_18731441:
    "Сначала я встречаюсь с милой, пусть и немного чересчур увлечённой девушкой, а заодно кручу роман с суровой полицейской."

# ch/harems_full/jail/events.rpy:165
translate russian camila_kylie_male_ending_16caa6b4:
    "А потом милая девушка оказывается совсем не в себе, и полицейская помогает её арестовать!"

# ch/harems_full/jail/events.rpy:166
translate russian camila_kylie_male_ending_1b1cd325:
    "Но безумнее всего то, чем это в итоге закончилось."

# ch/harems_full/jail/events.rpy:167
translate russian camila_kylie_male_ending_d890c95d:
    "Я рассчитывал разве что на то, что Кайли окажется в психиатрической больнице."

# ch/harems_full/jail/events.rpy:168
translate russian camila_kylie_male_ending_005b3fb5:
    "Камила получит повышение и забудет обо мне, неудачнике."

# ch/harems_full/jail/events.rpy:169
translate russian camila_kylie_male_ending_eb40b384:
    "А я останусь один, залечивая физические и душевные раны после всего случившегося."

# ch/harems_full/jail/events.rpy:170
translate russian camila_kylie_male_ending_8b353c32:
    "Но вот мы здесь, втроём, и признаёмся друг другу в любви."

# ch/harems_full/jail/events.rpy:171
translate russian camila_kylie_male_ending_3910ae4c:
    "И всерьёз обещаем провести остаток жизни вместе!"

# ch/harems_full/jail/events.rpy:172
translate russian camila_kylie_male_ending_70f99548:
    "До сих пор не могу поверить, что сейчас стою у алтаря."

# ch/harems_full/jail/events.rpy:173
translate russian camila_kylie_male_ending_af95ec6f:
    "И жду, когда по проходу ко мне подойдут Камила и Кайли!"

# ch/harems_full/jail/events.rpy:174
translate russian camila_kylie_male_ending_8dd595a7:
    "Я украдкой оглядываюсь через плечо, окидывая взглядом гостей."

# ch/harems_full/jail/events.rpy:175
translate russian camila_kylie_male_ending_b08e169a:
    "Нетрудно понять, кто к кому пришёл."

# ch/harems_full/jail/events.rpy:176
translate russian camila_kylie_male_ending_2f70b4fa:
    "За нами с Кайли наблюдают наши родные и друзья."

# ch/harems_full/jail/events.rpy:177
translate russian camila_kylie_male_ending_1c931f28:
    "Здесь даже сестра Кайли, моя бывшая Алексис."

# ch/harems_full/jail/events.rpy:178
translate russian camila_kylie_male_ending_838915a5:
    "А вот почти все гости Камилы — явно полицейские."

# ch/harems_full/jail/events.rpy:179
translate russian camila_kylie_male_ending_26689061:
    "Конечно, на церемонию они пришли без формы."

# ch/harems_full/jail/events.rpy:180
translate russian camila_kylie_male_ending_0c93a971:
    "Но этот безошибочно узнаваемый полицейский вид никуда не делся."

# ch/harems_full/jail/events.rpy:181
translate russian camila_kylie_male_ending_06c682b3:
    "Внезапно начинает играть музыка, и все оборачиваются."

# ch/harems_full/jail/events.rpy:182
translate russian camila_kylie_male_ending_770f2a6f:
    "Я тоже поворачиваюсь, стараясь разглядеть Камилу и Кайли, входящих в часовню."

# ch/harems_full/jail/events.rpy:186
translate russian camila_kylie_male_ending_ed39da68:
    "Когда они появляются, я почти перестаю слышать музыку."

# ch/harems_full/jail/events.rpy:187
translate russian camila_kylie_male_ending_d965ba5b:
    "Потому что от их вида у меня перехватывает дыхание."

# ch/harems_full/jail/events.rpy:188
translate russian camila_kylie_male_ending_1a16d195:
    "Обычно Камила выглядит суровой и бескомпромиссной."

# ch/harems_full/jail/events.rpy:189
translate russian camila_kylie_male_ending_cf0d51f7:
    "Но это платье словно раскрывает её истинную красоту."

# ch/harems_full/jail/events.rpy:190
translate russian camila_kylie_male_ending_d17a506b:
    "Кажется, я ещё никогда не видел её такой прекрасной."

# ch/harems_full/jail/events.rpy:192
translate russian camila_kylie_male_ending_45136346:
    "Она буквально сияет."

# ch/harems_full/jail/events.rpy:193
translate russian camila_kylie_male_ending_572c2eb7:
    "С гордостью придерживая округлившийся живот."

# ch/harems_full/jail/events.rpy:194
translate russian camila_kylie_male_ending_45e481f5:
    "Словно бросает вызов каждому, кто посмеет возразить."

# ch/harems_full/jail/events.rpy:195
translate russian camila_kylie_male_ending_24ffad4a:
    "От Кайли тоже глаз не отвести."

# ch/harems_full/jail/events.rpy:196
translate russian camila_kylie_male_ending_7c5f64dd:
    "Эти длинные светлые волосы, потрясающая фигура!"

# ch/harems_full/jail/events.rpy:197
translate russian camila_kylie_male_ending_60949991:
    "А в свадебном платье она просто ослепительна."

# ch/harems_full/jail/events.rpy:198
translate russian camila_kylie_male_ending_0b883949:
    "К счастью, оно достаточно длинное, чтобы скрыть электронный браслет на её лодыжке."

# ch/harems_full/jail/events.rpy:199
translate russian camila_kylie_male_ending_108b60c9:
    "Постоянное напоминание о том, что она всё ещё отбывает тюремный срок."

# ch/harems_full/jail/events.rpy:200
translate russian camila_kylie_male_ending_af1ff243:
    "И почти сразу после церемонии ей придётся вернуться за решётку."

# ch/harems_full/jail/events.rpy:202
translate russian camila_kylie_male_ending_ca469209:
    "Но Кайли, похоже, куда важнее показать свой животик."

# ch/harems_full/jail/events.rpy:203
translate russian camila_kylie_male_ending_94e6e88e:
    "Я вижу, как она гордится тем, что её беременность уже заметна."

# ch/harems_full/jail/events.rpy:204
translate russian camila_kylie_male_ending_f477d020:
    "Ведь это зримое воплощение связи между всеми нами."

# ch/harems_full/jail/events.rpy:208
translate russian camila_kylie_male_ending_da34598e:
    "Камила и Кайли подходят ко мне к алтарю."

# ch/harems_full/jail/events.rpy:209
translate russian camila_kylie_male_ending_854c870b:
    "Мы не успеваем произнести ни слова — священник начинает первым."

# ch/harems_full/jail/events.rpy:213
translate russian camila_kylie_male_ending_d601e095:
    "Священник" "Сегодня мы собрались здесь..."

# ch/harems_full/jail/events.rpy:214
translate russian camila_kylie_male_ending_c8700efd:
    "Священник" "Чтобы соединить этих троих людей священными узами брака."

# ch/harems_full/jail/events.rpy:215
translate russian camila_kylie_male_ending_51910124:
    "Честно говоря, дальше я почти не слышу слов священника."

# ch/harems_full/jail/events.rpy:216
translate russian camila_kylie_male_ending_9b399ae4:
    "Мы столько раз репетировали церемонию."

# ch/harems_full/jail/events.rpy:217
translate russian camila_kylie_male_ending_371c20ec:
    "Я могу лишь переводить взгляд с одной своей невесты на другую."

# ch/harems_full/jail/events.rpy:218
translate russian camila_kylie_male_ending_b055f9c0:
    "И думать, как же мне повезло!"

# ch/harems_full/jail/events.rpy:219
translate russian camila_kylie_male_ending_8834fa51:
    "Священник" "Согласна ли ты, Камила..."

# ch/harems_full/jail/events.rpy:220
translate russian camila_kylie_male_ending_6365fa05:
    "Священник" "Взять этого мужчину и эту женщину..."

# ch/harems_full/jail/events.rpy:221
translate russian camila_kylie_male_ending_082693c9:
    "Священник" "В законные супруги?"

# ch/harems_full/jail/events.rpy:223
translate russian camila_kylie_male_ending_6520c6d6:
    camila.say "Согласна."

# ch/harems_full/jail/events.rpy:224
translate russian camila_kylie_male_ending_9228b281:
    "Священник" "А ты, Кайли, согласна ли..."

# ch/harems_full/jail/events.rpy:225
translate russian camila_kylie_male_ending_284fa0d5:
    "Священник" "Также взять этого мужчину и эту женщину..."

# ch/harems_full/jail/events.rpy:226
translate russian camila_kylie_male_ending_082693c9_1:
    "Священник" "В законные супруги?"

# ch/harems_full/jail/events.rpy:228
translate russian camila_kylie_male_ending_829b63ac:
    kylie.say "Согласна, согласна!"

# ch/harems_full/jail/events.rpy:229
translate russian camila_kylie_male_ending_f5ee2c35:
    "Священник" "И наконец, согласен ли ты, [lssb_common.hero_name()]..."

# ch/harems_full/jail/events.rpy:230
translate russian camila_kylie_male_ending_cd57821b:
    "Священник" "Взять этих женщин..."

# ch/harems_full/jail/events.rpy:231
translate russian camila_kylie_male_ending_082693c9_2:
    "Священник" "В законные супруги?"

# ch/harems_full/jail/events.rpy:232
translate russian camila_kylie_male_ending_4885d70e:
    mike.say "Ещё бы!"

# ch/harems_full/jail/events.rpy:233
translate russian camila_kylie_male_ending_0f6d6f6a:
    "Священник" "Прекрасно..."

# ch/harems_full/jail/events.rpy:234
translate russian camila_kylie_male_ending_58c83231:
    "Священник" "Обращаюсь ко всем присутствующим..."

# ch/harems_full/jail/events.rpy:235
translate russian camila_kylie_male_ending_1a5edfc4:
    "Священник" "Если кто-либо знает причину, по которой этот брак невозможен..."

# ch/harems_full/jail/events.rpy:236
translate russian camila_kylie_male_ending_713d080b:
    "Священник" "Говорите сейчас или молчите вечно!"

# ch/harems_full/jail/events.rpy:237
translate russian camila_kylie_male_ending_7cf61036:
    "Наступает положенная пауза, сопровождаемая неловкими улыбками."

# ch/harems_full/jail/events.rpy:238
translate russian camila_kylie_male_ending_90db4521:
    "Но пока мы ждём, часть меня действительно тревожится."

# ch/harems_full/jail/events.rpy:239
translate russian camila_kylie_male_ending_0caeac41:
    "Я представляю, как врываются бандиты, чтобы отомстить Камиле, и начинается перестрелка."

# ch/harems_full/jail/events.rpy:240
translate russian camila_kylie_male_ending_4d7cd885:
    "Или как в двери вбегает толпа санитаров с сачком, чтобы поймать Кайли."

# ch/harems_full/jail/events.rpy:241
translate russian camila_kylie_male_ending_500ff1ec:
    "Но, к счастью, ничего такого не происходит."

# ch/harems_full/jail/events.rpy:242
translate russian camila_kylie_male_ending_a6581fb6:
    "Священник" "Тогда с огромной радостью объявляю вас супругами."

# ch/harems_full/jail/events.rpy:243
translate russian camila_kylie_male_ending_bfff607d:
    "Священник" "Можете поцеловать невест!"

# ch/harems_full/jail/events.rpy:247
translate russian camila_kylie_male_ending_db545c16:
    "Мы с Камилой и Кайли заключаем друг друга в объятия."

# ch/harems_full/jail/events.rpy:248
translate russian camila_kylie_male_ending_9fced725:
    "И обмениваемся поцелуями, которые с каждой секундой становятся всё страстнее."

# ch/harems_full/jail/events.rpy:249
translate russian camila_kylie_male_ending_f133d0cc:
    "Я знаю, что скоро всё это закончится."

# ch/harems_full/jail/events.rpy:250
translate russian camila_kylie_male_ending_640e10f3:
    "Что Кайли придётся вернуться в тюрьму."

# ch/harems_full/jail/events.rpy:251
translate russian camila_kylie_male_ending_c90991e7:
    "Но сейчас всё идеально."

# ch/harems_full/jail/events.rpy:252
translate russian camila_kylie_male_ending_daf96345:
    "И что бы ни ждало нас впереди, я знаю: вместе мы справимся."

# ch/harems_full/jail/events.rpy:257
translate russian camila_kylie_male_ending_a19527b9:
    camila.say "Прежде чем мы начнём, прошу занести в протокол..."

# ch/harems_full/jail/events.rpy:259
translate russian camila_kylie_male_ending_dd371697:
    kylie.say "О боже, Камила!"

# ch/harems_full/jail/events.rpy:260
translate russian camila_kylie_male_ending_b5b742f0:
    kylie.say "Ты же не даёшь показания под присягой."

# ch/harems_full/jail/events.rpy:261
translate russian camila_kylie_male_ending_e09de44e:
    kylie.say "Да вытащи ты хоть раз дубинку из задницы!"

# ch/harems_full/jail/events.rpy:263
translate russian camila_kylie_male_ending_dd537149:
    camila.say "ЭЙ!"

# ch/harems_full/jail/events.rpy:264
translate russian camila_kylie_male_ending_c6125970:
    camila.say "Никакой дубинки у меня в заднице нет!"

# ch/harems_full/jail/events.rpy:266
translate russian camila_kylie_male_ending_9fb62a60:
    camila.say "А вот ты, помнится, не раз разрешала, чтобы [lssb_common.hero_name()] засунул её в одну определённую дырочку!"

# ch/harems_full/jail/events.rpy:268
translate russian camila_kylie_male_ending_d17b69f2:
    kylie.say "Так-так-так!"

# ch/harems_full/jail/events.rpy:270
translate russian camila_kylie_male_ending_f9a3e8eb:
    kylie.say "Всё, что происходит на супружеских свиданиях, остаётся на супружеских свиданиях."

# ch/harems_full/jail/events.rpy:271
translate russian camila_kylie_male_ending_c4a689a0:
    kylie.say "Ты знаешь правила не хуже меня!"

# ch/harems_full/jail/events.rpy:274
translate russian camila_kylie_male_ending_bdf97c93:
    camila.say "Ладно, Кайли, ладно..."

# ch/harems_full/jail/events.rpy:275
translate russian camila_kylie_male_ending_a0d23402:
    camila.say "Мы вроде собирались рассказать, как нам живётся: я, ты и [lssb_common.hero_name()]?"

# ch/harems_full/jail/events.rpy:276
translate russian camila_kylie_male_ending_c6cd599a:
    camila.say "Ну, как всё замечательно."

# ch/harems_full/jail/events.rpy:277
translate russian camila_kylie_male_ending_7c096360:
    camila.say "И умолчать обо всех неприятных моментах?"

# ch/harems_full/jail/events.rpy:278
translate russian camila_kylie_male_ending_9e47cef9:
    kylie.say "О серьёзных вещах не умолчишь, Камила."

# ch/harems_full/jail/events.rpy:279
translate russian camila_kylie_male_ending_62db7a66:
    kylie.say "Например, о том, что я всё ещё в тюрьме."

# ch/harems_full/jail/events.rpy:280
translate russian camila_kylie_male_ending_5f0243d0:
    kylie.say "Так что, наверное, лучше просто говорить честно, да?"

# ch/harems_full/jail/events.rpy:282
translate russian camila_kylie_male_ending_5fe868f8:
    camila.say "Эх..."

# ch/harems_full/jail/events.rpy:283
translate russian camila_kylie_male_ending_537fea54:
    camila.say "Ты права, Кайли."

# ch/harems_full/jail/events.rpy:285
translate russian camila_kylie_male_ending_69c97788:
    kylie.say "О-о..."

# ch/harems_full/jail/events.rpy:287
translate russian camila_kylie_male_ending_2139034e:
    kylie.say "Не говори так грустно, Камила!"

# ch/harems_full/jail/events.rpy:289
translate russian camila_kylie_male_ending_36843867:
    kylie.say "Я бы и правда ничего не стала менять."

# ch/harems_full/jail/events.rpy:290
translate russian camila_kylie_male_ending_d82d99ee:
    kylie.say "Я никогда не думала, что смогу быть настолько счастлива."

# ch/harems_full/jail/events.rpy:292
translate russian camila_kylie_male_ending_fc1a319a:
    camila.say "Да... наверное, ты права."

# ch/harems_full/jail/events.rpy:293
translate russian camila_kylie_male_ending_ca0b06d2:
    camila.say "Брак с гражданским и заключённой на бумаге выглядит так себе."

# ch/harems_full/jail/events.rpy:295
translate russian camila_kylie_male_ending_3d351335:
    camila.say "Но я не представляю жизни без вас: ты и [lssb_common.hero_name()] мне слишком дороги."

# ch/harems_full/jail/events.rpy:297
translate russian camila_kylie_male_ending_cc7a1d2b:
    kylie.say "Я тоже, Камила."

# ch/harems_full/jail/events.rpy:298
translate russian camila_kylie_male_ending_6da4c6b7:
    kylie.say "Может, я всё ещё сумасшедшая."

# ch/harems_full/jail/events.rpy:299
translate russian camila_kylie_male_ending_1eeb7024:
    kylie.say "Но хотя бы знаю об этом!"

# ch/harems_full/jail/events.rpy:301
translate russian camila_kylie_male_ending_21aeb5eb:
    camila.say "Да-да..."

# ch/harems_full/jail/events.rpy:302
translate russian camila_kylie_male_ending_67e1a5e4:
    camila.say "Отношения с вами и меня заставили как следует взглянуть на себя со стороны."

# ch/harems_full/jail/events.rpy:305
translate russian camila_kylie_male_ending_534eeef2:
    camila.say "И я так рада, что вы поддержали моё решение остаться в полиции."

# ch/harems_full/jail/events.rpy:306
translate russian camila_kylie_male_ending_92481764:
    camila.say "Теперь я чувствую, что патрулирую улицы не просто так."

# ch/harems_full/jail/events.rpy:307
translate russian camila_kylie_male_ending_2b581b4e:
    camila.say "Я делаю это, чтобы [lssb_common.hero_name()] был в безопасности."

# ch/harems_full/jail/events.rpy:308
translate russian camila_kylie_male_ending_65521704:
    camila.say "И чтобы на улицах был порядок, когда ты выйдешь!"

# ch/harems_full/jail/events.rpy:314
translate russian camila_kylie_male_ending_f12be5da:
    kylie.say "В этом и смысл семьи, Камила."

# ch/harems_full/jail/events.rpy:316
translate russian camila_kylie_male_ending_9d876c2f:
    kylie.say "Все поддерживают друг друга."

# ch/harems_full/jail/events.rpy:318
translate russian camila_kylie_male_ending_9e075661:
    camila.say "Знаешь, раньше я этого не понимала."

# ch/harems_full/jail/events.rpy:319
translate russian camila_kylie_male_ending_e627953e:
    camila.say "Пока не появились Нова, Серен и Алексис."

# ch/harems_full/jail/events.rpy:321
translate russian camila_kylie_male_ending_dd817927:
    kylie.say "О-ох!"

# ch/harems_full/jail/events.rpy:322
translate russian camila_kylie_male_ending_3e8648ee:
    kylie.say "Эти маленькие чертята!"

# ch/harems_full/jail/events.rpy:323
