# ch/harems_full/jealous/events.rpy:1580
translate russian audrey_sasha_male_ending_d51b7ed7:
    audrey.say "Но за попытку не осуждают!"

# ch/harems_full/jealous/events.rpy:1581
translate russian audrey_sasha_male_ending_e73ba80f:
    sasha.say "Да уж... ты любишь испытывать терпение, Одри!"

# ch/harems_full/jealous/events.rpy:1582
translate russian audrey_sasha_male_ending_2902a7f8:
    audrey.say "Ай!"

# ch/harems_full/jealous/events.rpy:1584
translate russian audrey_sasha_male_ending_128f595b:
    audrey.say "Уела, Саша! У тебя всё лучше получается!"

# ch/harems_full/jealous/events.rpy:1585
translate russian audrey_sasha_male_ending_8575aa12:
    sasha.say "У меня хорошая учительница, Одри!"

# ch/harems_full/jealous/events.rpy:1587
translate russian audrey_sasha_male_ending_eb35c172:
    sasha.say "А?"

# ch/harems_full/jealous/events.rpy:1589
translate russian audrey_sasha_male_ending_a0ae402b:
