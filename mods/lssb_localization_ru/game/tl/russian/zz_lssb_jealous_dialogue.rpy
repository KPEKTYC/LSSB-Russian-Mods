# ch/harems_full/jealous/events.rpy:1596
translate russian audrey_sasha_male_ending_112fed10:
    sasha.say "Мирил бы нас и пытался заставить вести себя прилично!"

# ch/harems_full/jealous/events.rpy:1597
translate russian audrey_sasha_male_ending_10f1e2d9:
    audrey.say "О-о..."

# ch/harems_full/jealous/events.rpy:1599
translate russian audrey_sasha_male_ending_f29ab5ae:
    audrey.say "Хотела бы я, чтобы он сейчас был здесь."

# ch/harems_full/jealous/events.rpy:1601
translate russian audrey_sasha_male_ending_d9f15406:
