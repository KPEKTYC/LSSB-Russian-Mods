# ch/harems_full/jealous/events.rpy:1553
translate russian audrey_sasha_male_ending_bb79df60:
    "Священник" "Можете отметить это так, как считаете уместным."

# ch/harems_full/jealous/events.rpy:1554
translate russian audrey_sasha_male_ending_c76884a9:
