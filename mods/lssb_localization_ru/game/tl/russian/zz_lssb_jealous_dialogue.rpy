# ch/harems_full/jealous/events.rpy:1566
translate russian audrey_sasha_male_ending_60405a5f:
    "И пока всё это происходит, я совершенно забываю, где нахожусь."

# ch/harems_full/jealous/events.rpy:1567
translate russian audrey_sasha_male_ending_5c904906:
    "Так что, когда всё заканчивается, я искренне удивляюсь наблюдающим за нами гостям."

# ch/harems_full/jealous/events.rpy:1572
translate russian audrey_sasha_male_ending_88f1554e:
    audrey.say "Не волнуйся, Саша..."

# ch/harems_full/jealous/events.rpy:1573
translate russian audrey_sasha_male_ending_f505d7d3:
