# ch/harems_full/jealous/events.rpy:1574
translate russian audrey_sasha_male_ending_8a92c274:
    sasha.say "Эй!"

# ch/harems_full/jealous/events.rpy:1576
translate russian audrey_sasha_male_ending_e71e73ed:
