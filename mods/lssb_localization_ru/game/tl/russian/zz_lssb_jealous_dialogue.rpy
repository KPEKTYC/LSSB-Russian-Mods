# ch/harems_full/jealous/events.rpy:1590
translate russian audrey_sasha_male_ending_6df613c5:
    sasha.say "У тебя был такой вид, будто ты чего-то ждёшь!"

# ch/harems_full/jealous/events.rpy:1591
translate russian audrey_sasha_male_ending_fee8ceca:
    audrey.say "А, да..."

# ch/harems_full/jealous/events.rpy:1592
translate russian audrey_sasha_male_ending_070235d5:
    audrey.say "Я просто ждала, когда вмешается [lssb_common.hero_name()], понимаешь?"

# ch/harems_full/jealous/events.rpy:1594
translate russian audrey_sasha_male_ending_cde7da5a:
