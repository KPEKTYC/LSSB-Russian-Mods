# ch/harems_full/jealous/events.rpy:1564
translate russian audrey_sasha_male_ending_f32c20d6:
    "Одри и Саша обвивают меня руками, крепко прижимаясь."

# ch/harems_full/jealous/events.rpy:1565
translate russian audrey_sasha_male_ending_f818e944:
