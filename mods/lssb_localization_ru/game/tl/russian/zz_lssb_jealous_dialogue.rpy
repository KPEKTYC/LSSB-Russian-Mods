# ch/harems_full/jealous/events.rpy:1619
translate russian audrey_sasha_male_ending_490f3b86:
    audrey.say "Да, но [lssb_common.hero_name()] ведь не из таких."

# ch/harems_full/jealous/events.rpy:1620
translate russian audrey_sasha_male_ending_33bb522e:
    audrey.say "Думаю, он бы не возражал, если бы мы продолжили работать."

# ch/harems_full/jealous/events.rpy:1621
translate russian audrey_sasha_male_ending_9e411e9c:
    audrey.say "Или даже нашли новую работу, если подвернётся подходящая."

# ch/harems_full/jealous/events.rpy:1623
translate russian audrey_sasha_male_ending_a0b1253d:
    audrey.say "Надо признать, здорово, что он позволил мне уволиться."

# ch/harems_full/jealous/events.rpy:1625
translate russian audrey_sasha_male_ending_41f55dde:
    audrey.say "Мне там никогда особо не нравилось, а под конец совсем достало."

# ch/harems_full/jealous/events.rpy:1626
translate russian audrey_sasha_male_ending_d4ebef24:
    audrey.say "Хотя не знаю, хочу ли я навсегда остаться домохозяйкой."

# ch/harems_full/jealous/events.rpy:1627
translate russian audrey_sasha_male_ending_d3828363:
    audrey.say "Может, только пока не найду подходящую работу?"

# ch/harems_full/jealous/events.rpy:1628
translate russian audrey_sasha_male_ending_8a31d66f:
    sasha.say "Если бы он захотел, чтобы я ушла из группы, я бы упёрлась."

# ch/harems_full/jealous/events.rpy:1629
translate russian audrey_sasha_male_ending_a438cd43:
    sasha.say "Но он так меня поддерживает: ходит на концерты и всё такое."

# ch/harems_full/jealous/events.rpy:1630
translate russian audrey_sasha_male_ending_883d2f9a:
    sasha.say "Мой муж словно ещё и мой самый преданный поклонник!"

# ch/harems_full/jealous/events.rpy:1632
translate russian audrey_sasha_male_ending_5d6223b5:
    audrey.say "Конечно."

# ch/harems_full/jealous/events.rpy:1634
translate russian audrey_sasha_male_ending_de843725:
    audrey.say "Он совершенно спокойно отнёсся к тому, что я продолжаю карьеру."

# ch/harems_full/jealous/events.rpy:1635
translate russian audrey_sasha_male_ending_1e1f185a:
    audrey.say "Знаю немало парней, которые заставили бы меня уволиться."

# ch/harems_full/jealous/events.rpy:1636
translate russian audrey_sasha_male_ending_9a38c8f6:
    audrey.say "Будто работающая жена делает их менее мужественными!"

# ch/harems_full/jealous/events.rpy:1637
translate russian audrey_sasha_male_ending_6be92d04:
    sasha.say "Я ожидала, что он начнёт спорить, когда сказала, что хочу сделать перерыв."

# ch/harems_full/jealous/events.rpy:1638
translate russian audrey_sasha_male_ending_ffb1b63c:
    sasha.say "Ты же знаешь, [lssb_common.hero_name()] — самый большой фанат моей группы."

# ch/harems_full/jealous/events.rpy:1639
translate russian audrey_sasha_male_ending_3fcf694a:
    sasha.say "Но он спокойно это принял."

# ch/harems_full/jealous/events.rpy:1640
translate russian audrey_sasha_male_ending_64886517:
    sasha.say "Просто сказал отдыхать столько, сколько нужно."

# ch/harems_full/jealous/events.rpy:1643
translate russian audrey_sasha_male_ending_25862f24:
    audrey.say "Фу-у..."

# ch/harems_full/jealous/events.rpy:1644
translate russian audrey_sasha_male_ending_c5ca40d2:
    audrey.say "Мы столько хорошего о нём говорим."

# ch/harems_full/jealous/events.rpy:1645
translate russian audrey_sasha_male_ending_9dfd16a7:
    audrey.say "Как-то это неправильно!"

# ch/harems_full/jealous/events.rpy:1647
translate russian audrey_sasha_male_ending_4bfcaded:
    sasha.say "Тогда тебе не понравится то, что я сейчас скажу!"

# ch/harems_full/jealous/events.rpy:1648
translate russian audrey_sasha_male_ending_f9c59192:
    sasha.say "[lssb_common.hero_name()] помог нам по-настоящему почувствовать себя семьёй."

# ch/harems_full/jealous/events.rpy:1649
translate russian audrey_sasha_male_ending_25597ff6:
    sasha.say "Не просто троицей, оформившей отношения, а настоящей семьёй."

# ch/harems_full/jealous/events.rpy:1650
translate russian audrey_sasha_male_ending_1ea92f72:
    audrey.say "А-а!"

# ch/harems_full/jealous/events.rpy:1651
translate russian audrey_sasha_male_ending_2743c05d:
    audrey.say "Прекрати, Саша!"

# ch/harems_full/jealous/events.rpy:1653
translate russian audrey_sasha_male_ending_5925b83e:
    audrey.say "Хватит говорить вещи, с которыми мне приходится соглашаться!"

# ch/harems_full/jealous/events.rpy:1656
translate russian audrey_sasha_male_ending_e9aba89e:
    audrey.say "Ну, полагаю, [lssb_common.hero_name()] — хороший отец."

# ch/harems_full/jealous/events.rpy:1657
translate russian audrey_sasha_male_ending_368413a6:
    audrey.say "А маленький Томми обожает своего папу."

# ch/harems_full/jealous/events.rpy:1659
translate russian audrey_sasha_male_ending_40bffdf5:
    sasha.say "Раньше я думала, что мальчиков растить легче, чем девочек."

# ch/harems_full/jealous/events.rpy:1661
translate russian audrey_sasha_male_ending_2d7e5cf9:
    sasha.say "Но Билли очень быстро меня разубедил!"

# ch/harems_full/jealous/events.rpy:1663
translate russian audrey_sasha_male_ending_2e1a911c:
    audrey.say "Саша..."

# ch/harems_full/jealous/events.rpy:1664
translate russian audrey_sasha_male_ending_37c5da2e:
    audrey.say "Ты..."

# ch/harems_full/jealous/events.rpy:1666
translate russian audrey_sasha_male_ending_870adc19:
    sasha.say "Что я, Одри?"

# ch/harems_full/jealous/events.rpy:1667
translate russian audrey_sasha_male_ending_e7638100:
    audrey.say "Ты задумываешься о том, чтобы родить от него детей?"

# ch/harems_full/jealous/events.rpy:1668
translate russian audrey_sasha_male_ending_7970069e:
    sasha.say "Ты-то, очевидно, задумываешься!"

# ch/harems_full/jealous/events.rpy:1669
translate russian audrey_sasha_male_ending_4504bab7:
    sasha.say "Но да, я думаю об этом постоянно."

# ch/harems_full/jealous/events.rpy:1670
translate russian audrey_sasha_male_ending_6e84a52b:
