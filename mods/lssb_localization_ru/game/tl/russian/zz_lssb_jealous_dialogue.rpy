# ch/harems_full/jealous/events.rpy:1560
translate russian audrey_sasha_male_ending_5fef67e8:
    "Но Одри и Саша буквально набрасываются на меня!"

# ch/harems_full/jealous/events.rpy:1561
translate russian audrey_sasha_male_ending_fc249885:
    "Должно быть, они заранее всё спланировали."

# ch/harems_full/jealous/events.rpy:1562
translate russian audrey_sasha_male_ending_e7417258:
    "Потому что действуют почти одновременно, заставая меня врасплох."

# ch/harems_full/jealous/events.rpy:1563
translate russian audrey_sasha_male_ending_690d6a5f:
