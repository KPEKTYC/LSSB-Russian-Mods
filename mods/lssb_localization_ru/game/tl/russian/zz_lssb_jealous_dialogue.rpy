# ch/harems_full/jealous/events.rpy:1608
translate russian audrey_sasha_male_ending_b70e521d:
    sasha.say "Но [lssb_common.hero_name()] каким-то образом всё налаживает."

# ch/harems_full/jealous/events.rpy:1609
translate russian audrey_sasha_male_ending_91da2a79:
