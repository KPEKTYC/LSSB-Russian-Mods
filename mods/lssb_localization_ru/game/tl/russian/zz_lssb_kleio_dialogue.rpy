# ch/kleio/reactions.rpy:375
translate russian kleio_belly_listen_male_e0c18c44:
    mike.say "Что случилось, Клео?"

# ch/kleio/reactions.rpy:376
translate russian kleio_belly_listen_male_cf0b83ba:
