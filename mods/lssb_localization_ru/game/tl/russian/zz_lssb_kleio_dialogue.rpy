# ch/kleio/reactions.rpy:345
translate russian kleio_belly_caress_male_1f3dec94:
    kleio.say "Развлекайся, пока ещё можешь."

# ch/kleio/reactions.rpy:347
translate russian kleio_belly_caress_male_ff8961bb:
    "Я встаю, отодвигая живот Клео от лица."

# ch/kleio/reactions.rpy:348
translate russian kleio_belly_caress_male_c7d95da2:
    "Но заодно обдумываю её слова."

# ch/kleio/reactions.rpy:349
translate russian kleio_belly_caress_male_21730488:
