# ch/kleio/reactions.rpy:385
translate russian kleio_belly_listen_male_353198dc:
    kleio.say "Хочу, чтобы ты послушал, что там происходит."

# ch/kleio/reactions.rpy:387
translate russian kleio_belly_listen_male_5871c566:
    kleio.say "Клянусь, маленький засранец пукает!"

# ch/kleio/reactions.rpy:389
translate russian kleio_belly_listen_male_c29e1bb8:
    "Теперь уже я смотрю на Клео так, словно она несёт чушь."

# ch/kleio/reactions.rpy:390
translate russian kleio_belly_listen_male_5ec626ad:
    mike.say "Думаешь, малыш пускает газы?"

# ch/kleio/reactions.rpy:391
translate russian kleio_belly_listen_male_f1bcdb87:
