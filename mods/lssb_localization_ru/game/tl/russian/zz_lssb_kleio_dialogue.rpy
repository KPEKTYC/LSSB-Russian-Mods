# ch/kleio/reactions.rpy:379
translate russian kleio_belly_listen_male_06ebc7b1:
    "Клео смотрит на меня так, будто у меня изо рта свисают дымящиеся какашки."

# ch/kleio/reactions.rpy:380
translate russian kleio_belly_listen_male_46b095b9:
    "И качает головой, словно я полный идиот."

# ch/kleio/reactions.rpy:382
translate russian kleio_belly_listen_male_2743a9a6:
    kleio.say "Что?"

# ch/kleio/reactions.rpy:384
translate russian kleio_belly_listen_male_a2fba1f9:
