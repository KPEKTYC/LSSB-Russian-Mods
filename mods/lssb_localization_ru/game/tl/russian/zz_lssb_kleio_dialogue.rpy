# ch/kleio/reactions.rpy:369
translate russian kleio_belly_listen_male_3bc25c9a:
    kleio.say "Эй, сердцеед..."

# ch/kleio/reactions.rpy:370
translate russian kleio_belly_listen_male_7246c175:
    kleio.say "Иди сюда, помоги мне с твоим ребёнком!"

# ch/kleio/reactions.rpy:372
translate russian kleio_belly_listen_male_c97a8571:
    "Естественно, при упоминании малыша я сразу настораживаюсь."

# ch/kleio/reactions.rpy:374
translate russian kleio_belly_listen_male_0a9911fa:
