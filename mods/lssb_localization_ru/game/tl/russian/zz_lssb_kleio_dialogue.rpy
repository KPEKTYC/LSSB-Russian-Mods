# ch/kleio/reactions.rpy:336
translate russian kleio_belly_caress_male_f5c6ba5a:
    "Разумеется, огромная розовая штука — это живот Клео."

# ch/kleio/reactions.rpy:337
translate russian kleio_belly_caress_male_4decc739:
