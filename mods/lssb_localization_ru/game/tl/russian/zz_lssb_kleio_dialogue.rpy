# ch/kleio/reactions.rpy:350
translate russian kleio_belly_caress_male_259633e6:
    mike.say "Знаешь что, Клео..."

# ch/kleio/reactions.rpy:351
translate russian kleio_belly_caress_male_06602c4c:
