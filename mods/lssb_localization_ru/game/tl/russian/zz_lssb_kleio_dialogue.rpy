# ch/kleio/reactions.rpy:392
translate russian kleio_belly_listen_male_175fae95:
    "Клео качает головой и указывает на живот."

# ch/kleio/reactions.rpy:394
translate russian kleio_belly_listen_male_580a3318:
    kleio.say "Я похожа на врача?"

# ch/kleio/reactions.rpy:395
translate russian kleio_belly_listen_male_28c3b666:
    kleio.say "Откуда мне, блядь, знать?!"

# ch/kleio/reactions.rpy:397
translate russian kleio_belly_listen_male_c2a1fc5c:
