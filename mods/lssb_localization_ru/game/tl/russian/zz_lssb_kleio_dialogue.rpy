# Native Kleio identifiers, current source catalog. Translation only.

# ch/kleio/base.rpy:28
translate russian kleio_bye_c984dd52:
    kleio.say "Пожалуй, пора спать."

# ch/kleio/base.rpy:30
translate russian kleio_bye_67d308c9:
    kleio.say "Пойду в ванную. Только попробуй подсмотреть!"

# ch/kleio/base.rpy:32
translate russian kleio_bye_cfc6f1dd:
    kleio.say "У меня сейчас занятия, пора идти."

# ch/kleio/base.rpy:34
translate russian kleio_bye_14980a6f:
    kleio.say "Как же я хочу есть..."

# ch/kleio/base.rpy:36
translate russian kleio_bye_984350f4:
    kleio.say "Не знаешь, что сейчас по телеку?"

# ch/kleio/base.rpy:38
translate russian kleio_bye_6e1c8af7:
    kleio.say "Пойду выпью в баре. Увидимся."

# ch/kleio/base.rpy:40
translate russian kleio_bye_d3350ec5:
    kleio.say "Сегодня солнечно. Пожалуй, пойду позагораю."

# ch/kleio/base.rpy:42
translate russian kleio_bye_2e29521b:
    kleio.say "Хочется пройтись по магазинам."

# ch/kleio/base.rpy:44
translate russian kleio_bye_a92a50a5:
    kleio.say "Пойду почитаю. Начала одну классную книгу."

# ch/kleio/base.rpy:46
translate russian kleio_bye_e154b026:
    kleio.say "Пойду в клуб, хочется потусить."

# ch/kleio/base.rpy:48
translate russian kleio_bye_01a2d9e1:
    kleio.say "Надо бы потренироваться до пота. Увидимся."

# ch/kleio/base.rpy:50
translate russian kleio_bye_b3bf03c1:
    kleio.say "Пойду оденусь."

# ch/kleio/base.rpy:62
translate russian kleio_cheated_ac7c338e:
    kleio.say "Я тоже хочу!"

# ch/kleio/base.rpy:65
translate russian kleio_cheated_558d73a0:
    "И Клео без предупреждения целует меня."

# ch/kleio/base.rpy:76
translate russian kleio_cheated_77dabf91:
    "Замечаю сердитый взгляд Клео: она видит, как я [lssb_kleio.action_text(action)] другую..."

# ch/kleio/base.rpy:88
translate russian kleio_greet_fccbbf01:
    kleio.say "Привет, [lssb_kleio.hero_name()]. Мы с пузиком уже гадали, куда ты запропастился."

# ch/kleio/base.rpy:90
translate russian kleio_greet_726829cb:
    kleio.say "Осторожнее, [lssb_kleio.hero_name()]. Я теперь перевожу ценный груз."

# ch/kleio/base.rpy:91
translate russian kleio_greet_eb33ac71:
    kleio.say "Так что без шалостей. Ну, хотя бы без лишних."

# ch/kleio/base.rpy:95
translate russian kleio_greet_90ff9fc3:
    kleio.say "Ты пришёл, [lssb_kleio.hero_name()]. Я тебя ждала."

# ch/kleio/base.rpy:97
translate russian kleio_greet_3fe57fb5:
    kleio.say "Привет, [lssb_kleio.hero_name()]."

# ch/kleio/base.rpy:98
translate russian kleio_greet_7e6a28c0:
    kleio.say "Что бы тебе сегодня ни понадобилось, я твоя."

# ch/kleio/base.rpy:100
translate russian kleio_greet_fea3c79d:
    kleio.say "Только скажи, [lssb_kleio.hero_name()]."

# ch/kleio/base.rpy:104
translate russian kleio_greet_ed679c60:
    kleio.say "Привет, [lssb_kleio.hero_name()]. Надеялась, что ты появишься."

# ch/kleio/base.rpy:106
translate russian kleio_greet_3fe57fb5_1:
    kleio.say "Привет, [lssb_kleio.hero_name()]."

# ch/kleio/base.rpy:107
translate russian kleio_greet_d9a812ad:
    kleio.say "Ну, какой план? Сегодня ты рулишь."

# ch/kleio/base.rpy:111
translate russian kleio_greet_ead3e19c:
    kleio.say "Вот ты где, [lssb_kleio.hero_name()]. Я уже собиралась сама тебя сюда притащить."

# ch/kleio/base.rpy:113
translate russian kleio_greet_9bf7ccbe:
    kleio.say "Здорово, [lssb_kleio.hero_name()]."

# ch/kleio/base.rpy:114
translate russian kleio_greet_a535b4f9:
    kleio.say "Только не зазнавайся, но я правда рада, что ты пришёл."

# ch/kleio/base.rpy:116
translate russian kleio_greet_98b67b14:
    kleio.say "Скучала по тебе. Всё, сказала, [lssb_kleio.hero_name()]. Доволен?"

# ch/kleio/base.rpy:120
translate russian kleio_greet_b81f458d:
    kleio.say "О, кто явился. Привет, [lssb_kleio.hero_name()]."

# ch/kleio/base.rpy:122
translate russian kleio_greet_903b2d82:
    kleio.say "Как оно, [lssb_kleio.hero_name()]?"

# ch/kleio/base.rpy:124
translate russian kleio_greet_c3bf8244:
    kleio.say "Постарайся не так бурно радоваться встрече со мной, [lssb_kleio.hero_name()]."

# ch/kleio/base.rpy:127
translate russian kleio_greet_a9a5e8be:
    kleio.say "С добрым утром, [lssb_kleio.hero_name()]. Кофе сам себя не выпьет."

# ch/kleio/base.rpy:129
translate russian kleio_greet_c2224aad:
    kleio.say "Добрый день, [lssb_kleio.hero_name()]."

# ch/kleio/base.rpy:131
translate russian kleio_greet_50f7b01e:
    kleio.say "Добрый вечер, [lssb_kleio.hero_name()]. Похоже, денёк у тебя выдался тот ещё."

# ch/kleio/base.rpy:135
translate russian kleio_greet_70cf17d5:
    kleio.say "Бесит, что ты заставил меня это сказать, сердцеед, но мне ДО ЗАРЕЗУ нужен твой член внутри!"

# ch/kleio/base.rpy:137
translate russian kleio_greet_77f4ff38:
    kleio.say "Знаешь, чего я хочу, [lssb_kleio.hero_name()]?"

# ch/kleio/base.rpy:138
translate russian kleio_greet_f4e61855:
    kleio.say "Хочу чувствовать тебя в себе... Глубоко внутри!"

# ch/kleio/base.rpy:145
translate russian kleio_greet_dialogues_male_3d6fbedd:
    mike.say "Привет, Клео."

# ch/kleio/base.rpy:147
translate russian kleio_greet_dialogues_male_6810e1f5:
    mike.say "Привет."

# ch/kleio/base.rpy:150
translate russian kleio_greet_dialogues_male_ffe16a2f:
    mike.say "Привет, Клео."

# ch/kleio/base.rpy:152
translate russian kleio_greet_dialogues_male_795851d6:
    mike.say "Доброе утро, Клео."

# ch/kleio/base.rpy:154
translate russian kleio_greet_dialogues_male_a9f8a312:
    mike.say "Добрый день, Клео."

# ch/kleio/base.rpy:156
translate russian kleio_greet_dialogues_male_8ac468f5:
    mike.say "Добрый вечер, Клео."

# ch/kleio/base.rpy:163
translate russian kleio_kiss_6a2262e0:
    "Всё происходит так быстро, что я едва успеваю понять, что к чему."

# ch/kleio/base.rpy:164
translate russian kleio_kiss_84396ac1:
    "Только что мы с Клео хохотали до упаду над какой-то дурацкой хренью."

# ch/kleio/base.rpy:165
translate russian kleio_kiss_840648be:
    "А в следующий миг я поддаюсь безумному порыву, решив наплевать на последствия."

# ch/kleio/base.rpy:166
translate russian kleio_kiss_0d48aa6d:
    "Пытаюсь поцеловать Клео в губы: уж очень они хороши, когда она смеётся."

# ch/kleio/base.rpy:167
translate russian kleio_kiss_fd74bb53:
    "Но даже не успеваю приблизиться."

# ch/kleio/base.rpy:169
translate russian kleio_kiss_1021c298:
    "Клео твёрдо упирается ладонью мне в грудь и останавливает меня. Её губы теперь кривятся от явного недовольства."

# ch/kleio/base.rpy:178
translate russian kleio_kiss_621a761b:
    "Сделаю я это или нет — пожалеть могу в любом случае."

# ch/kleio/base.rpy:179
translate russian kleio_kiss_ba13aa5f:
    "Если сделаю, возможно, пожалею уже через пару минут."

# ch/kleio/base.rpy:180
translate russian kleio_kiss_65b1a3fc:
    "А если нет, могу жалеть ещё много лет."

# ch/kleio/base.rpy:181
translate russian kleio_kiss_e593fd20:
    "И я знаю, какой из этих вариантов хуже."

# ch/kleio/base.rpy:182
translate russian kleio_kiss_1a3d1209:
    "Поэтому доверяюсь чутью и целую Клео прямо в губы."

# ch/kleio/base.rpy:183
translate russian kleio_kiss_02d10d84:
    "Она чуть вздрагивает и хихикает, не отрывая губ от моих."

# ch/kleio/base.rpy:184
translate russian kleio_kiss_ba11ac30:
    "А затем отдаётся поцелую. Кажется, риск оправдался."

# ch/kleio/base.rpy:193
translate russian kleio_kiss_424f8ecd:
    "В том, как Клео любит целоваться, нет ничего покорного или женственного."

# ch/kleio/base.rpy:194
translate russian kleio_kiss_d5bed384:
    "На первый план сразу выходит её непреклонное нежелание подчиняться."

# ch/kleio/base.rpy:195
translate russian kleio_kiss_8bd5187c:
    "Но если вас никогда не обнимала и не целовала настолько страстная девушка, вы многое потеряли."

# ch/kleio/base.rpy:196
translate russian kleio_kiss_ad717266:
    "Я не могу отделаться от мысли: эта женщина способна мужику яйца оторвать."

# ch/kleio/base.rpy:197
translate russian kleio_kiss_4d219df8:
    "И всё же сейчас она обвивает меня руками, позволяя обнимать и целовать себя без всяких возражений."

# ch/kleio/base.rpy:198
translate russian kleio_kiss_47ea1be4:
    "От одной мысли, что мы снова это повторим, я уже завожусь."

# ch/kleio/base.rpy:205
translate russian kleio_propose_male_2a3c0397:
    "Если бы при нашем знакомстве мне сказали, что однажды я окажусь с Клео в такой ситуации..."

# ch/kleio/base.rpy:206
translate russian kleio_propose_male_f8cbed8c:
    "Скажем так: самое меньшее, что я бы сделал, — рассмеялся в лицо тому, кто это предположил."

# ch/kleio/base.rpy:207
translate russian kleio_propose_male_9741a3a7:
    "Но вот я здесь, и кольцо кажется самой тяжёлой вещью на свете."

# ch/kleio/base.rpy:208
translate russian kleio_propose_male_e2b86c64:
    "В голове мешанина из тревог и худших возможных исходов. Мозг словно перегорел."

# ch/kleio/base.rpy:209
translate russian kleio_propose_male_dcca8919:
    "И всё потому, что я убедил себя: наконец настало время сделать Клео предложение."

# ch/kleio/base.rpy:210
translate russian kleio_propose_male_6fc2bc37:
    "Нет, стоп... Беру последнее назад."

# ch/kleio/base.rpy:211
translate russian kleio_propose_male_9f2f5b67:
    "Честно говоря, не знаю, бывает ли подходящий момент для предложения такой девушке."

# ch/kleio/base.rpy:212
translate russian kleio_propose_male_060bb49b:
    "Хотя бы потому, что других таких девушек, как Клео, просто НЕТ!"

# ch/kleio/base.rpy:213
translate russian kleio_propose_male_61bb3add:
    "Часть меня боится, что она рассмеётся мне в лицо или швырнёт кольцо прямо в канализацию."

# ch/kleio/base.rpy:214
translate russian kleio_propose_male_9cd4cfb8:
    "Но бо́льшая часть знает: я без ума от неё, со всеми её причудами и колючками."

# ch/kleio/base.rpy:215
translate russian kleio_propose_male_701ac221:
    "И если не спрошу, останется лишь гадать, что могло бы быть."

# ch/kleio/base.rpy:216
translate russian kleio_propose_male_66011e47:
    "С любой другой девушкой я бы всё распланировал до секунды."

# ch/kleio/base.rpy:217
translate russian kleio_propose_male_f9d5e975:
    "Но с Клео остаётся только пытаться уловить достаточно хорошее настроение."

# ch/kleio/base.rpy:218
translate russian kleio_propose_male_db0b418e:
    "А уловив — отбросить осторожность и действовать..."

# ch/kleio/base.rpy:219
translate russian kleio_propose_male_20578764:
    "Так что, когда Клео поворачивает голову в сторону, я ловлю момент."

# ch/kleio/base.rpy:220
translate russian kleio_propose_male_03cfc266:
    "Через пару секунд она смотрит обратно, а меня на прежнем месте уже нет."

# ch/kleio/base.rpy:223
translate russian kleio_propose_male_bc36dfe8:
    kleio.say "А?.. Какого хрена?"

# ch/kleio/base.rpy:224
translate russian kleio_propose_male_afb34799:
    kleio.say "Ты куда делся, сердцеед?"

# ch/kleio/base.rpy:225
translate russian kleio_propose_male_d442dabf:
    "Признаюсь, я представлял себе это немного иначе."

# ch/kleio/base.rpy:226
translate russian kleio_propose_male_1586064c:
    "Но чёрт с ним, продолжаем."

# ch/kleio/base.rpy:227
translate russian kleio_propose_male_f1d8a63c:
    mike.say "Эм..."

# ch/kleio/base.rpy:228
translate russian kleio_propose_male_13e31930:
    mike.say "Я здесь, внизу, Клео."

# ch/kleio/base.rpy:229
translate russian kleio_propose_male_324a71fa:
    "Она опускает взгляд и округляет глаза, увидев меня на одном колене."

# ch/kleio/base.rpy:230
translate russian kleio_propose_male_f5968f8e:
    "Наверняка понимает, к чему всё идёт."

# ch/kleio/base.rpy:231
translate russian kleio_propose_male_72198410:
    "Но, судя по всему, облегчать мне задачу Клео не собирается."

# ch/kleio/base.rpy:233
translate russian kleio_propose_male_d980f676:
    kleio.say "Ты что, чёрт возьми, делаешь?"

# ch/kleio/base.rpy:234
translate russian kleio_propose_male_5c9359d2:
    kleio.say "Уронил что-то?"

# ch/kleio/base.rpy:235
translate russian kleio_propose_male_da94ee78:
    kleio.say "Или нашёл особо интересную кучу собачьего дерьма?"

# ch/kleio/base.rpy:236
translate russian kleio_propose_male_ff02fc59:
    "Решаю, что сейчас самое время достать кольцо и протянуть его Клео."

# ch/kleio/base.rpy:237
translate russian kleio_propose_male_86af793b:
    "От ответной колкости толку не будет."

# ch/kleio/base.rpy:238
translate russian kleio_propose_male_4e7ced5f:
    "Поэтому просто следую заготовленному в голове тексту."

# ch/kleio/base.rpy:239
translate russian kleio_propose_male_4858ce03:
    mike.say "Э-э... нет, Клео."

# ch/kleio/base.rpy:240
translate russian kleio_propose_male_5bf917d3:
    mike.say "Я... я хотел спросить..."

# ch/kleio/base.rpy:241
translate russian kleio_propose_male_d7ec7244:
    mike.say "Ты выйдешь за меня?"

# ch/kleio/base.rpy:243
translate russian kleio_propose_male_58f8682b:
    "Впервые на моей памяти Клео словно лишилась дара речи."

# ch/kleio/base.rpy:244
translate russian kleio_propose_male_c7ec06dd:
    "Она молча смотрит на меня широко раскрытыми глазами."

# ch/kleio/base.rpy:245
translate russian kleio_propose_male_071a3a06:
    "От этого моя тревога ничуть не уменьшается."

# ch/kleio/base.rpy:246
translate russian kleio_propose_male_4cb7306e:
    "И тошнотворный комок в животе тоже никуда не девается."

# ch/kleio/base.rpy:249
translate russian kleio_propose_male_d5e1127d:
    kleio.say "О нет..."

# ch/kleio/base.rpy:250
translate russian kleio_propose_male_162afe92:
    kleio.say "Ох, [lssb_kleio.hero_name()], нет..."

# ch/kleio/base.rpy:251
translate russian kleio_propose_male_2b20c3bf:
    kleio.say "Я думала, ты знаешь меня лучше!"

# ch/kleio/base.rpy:252
translate russian kleio_propose_male_e0d6f5f9:
    "Уже вижу, что всё идёт наперекосяк."

# ch/kleio/base.rpy:253
translate russian kleio_propose_male_f63b2d87:
    "И отчаянно пытаюсь хоть что-то спасти."

# ch/kleio/base.rpy:254
translate russian kleio_propose_male_60e0a6b3:
    mike.say "Я... понимаю, что это неожиданно, Клео."

# ch/kleio/base.rpy:255
translate russian kleio_propose_male_f772fea2:
    mike.say "Но можешь подумать, если хочешь."

# ch/kleio/base.rpy:256
translate russian kleio_propose_male_27900de0:
    mike.say "Никто не запрещает взять время, прежде чем сказать «да»!"

# ch/kleio/base.rpy:257
translate russian kleio_propose_male_ba6963b3:
    "Клео качает головой и смущённо оглядывается."

# ch/kleio/base.rpy:258
translate russian kleio_propose_male_deb6f3ba:
    "Затем хватает меня за запястья и поднимает на ноги."

# ch/kleio/base.rpy:260
translate russian kleio_propose_male_c5fb12ce:
    kleio.say "Хватит! Ты нас обоих позоришь!"

# ch/kleio/base.rpy:261
translate russian kleio_propose_male_4d78a2e1:
    kleio.say "И эту чёртову штуку тоже убери!"

# ch/kleio/base.rpy:262
translate russian kleio_propose_male_bde14e61:
    "От её слов я невольно смотрю на неё с недоумением, разинув рот."

# ch/kleio/base.rpy:263
translate russian kleio_propose_male_86736f15:
    "Но затем прихожу в себя после отказа и начинаю прятать кольцо в карман."

# ch/kleio/base.rpy:264
translate russian kleio_propose_male_08e2d09f:
    mike.say "Да... конечно..."

# ch/kleio/base.rpy:265
translate russian kleio_propose_male_7929b46e:
    mike.say "Я... сам не знаю, о чём думал, Клео."

# ch/kleio/base.rpy:266
translate russian kleio_propose_male_f165227d:
    mike.say "Прости меня..."

# ch/kleio/base.rpy:268
translate russian kleio_propose_male_0a53f52c:
    "Снова посмотрев ей в глаза, замечаю странное, непривычное чувство."

# ch/kleio/base.rpy:269
translate russian kleio_propose_male_caeff33c:
    "Словно Клео и впрямь жалеет о своём поступке."

# ch/kleio/base.rpy:270
translate russian kleio_propose_male_2e93fa9a:
    "Словно понимает, как больно ранила меня резкими словами."

# ch/kleio/base.rpy:271
translate russian kleio_propose_male_677a3474:
    kleio.say "Слушай, [lssb_kleio.hero_name()]... Я... прости, ладно?"

# ch/kleio/base.rpy:272
translate russian kleio_propose_male_96203f63:
    kleio.say "Можно было сказать помягче."

# ch/kleio/base.rpy:273
translate russian kleio_propose_male_bac9d4f0:
    "Я медленно киваю, всё ещё чувствуя боль от отказа."

# ch/kleio/base.rpy:274
translate russian kleio_propose_male_59f14e6c:
    "Но знаю, как трудно Клео признать свою неправоту."

# ch/kleio/base.rpy:275
translate russian kleio_propose_male_91f6e27e:
    mike.say "Всё нормально, Клео."

# ch/kleio/base.rpy:276
translate russian kleio_propose_male_f7fe280a:
    mike.say "Я не первый парень, которому отказали."

# ch/kleio/base.rpy:277
translate russian kleio_propose_male_ef5e3439:
    mike.say "И не последний."

# ch/kleio/base.rpy:279
translate russian kleio_propose_male_2a8eda73:
    kleio.say "Эй, это не значит, что я тебя бросаю, сердцеед!"

# ch/kleio/base.rpy:280
translate russian kleio_propose_male_245e2a1b:
    kleio.say "По крайней мере, не обязательно..."

# ch/kleio/base.rpy:281
translate russian kleio_propose_male_4b6b492b:
    kleio.say "То есть... я не хочу!"

# ch/kleio/base.rpy:282
translate russian kleio_propose_male_c05eac76:
    "Снова киваю, совершенно не готовый к такому повороту."

# ch/kleio/base.rpy:283
translate russian kleio_propose_male_6762acbe:
    mike.say "Я понял, Клео."

# ch/kleio/base.rpy:284
translate russian kleio_propose_male_e509ba3b:
    mike.say "Просто нужно немного времени, чтобы боль прошла, вот и всё."

# ch/kleio/base.rpy:285
translate russian kleio_propose_male_6d483459:
    "Клео улыбается, но в её глазах видны боль и тревога."

# ch/kleio/base.rpy:286
translate russian kleio_propose_male_a7d40957:
    "А я ничем не могу её утешить: мои слова были искренними."

# ch/kleio/base.rpy:290
translate russian kleio_propose_male_9ce3ac34:
    "Клео застаёт меня врасплох, потянувшись за кольцом."

# ch/kleio/base.rpy:291
translate russian kleio_propose_male_521e9513:
    "Почти выхватывает его из коробочки и натягивает на палец."

# ch/kleio/base.rpy:292
translate russian kleio_propose_male_44c2ed11:
    "Затем поднимает руку, размахивая кольцом, словно трофеем."

# ch/kleio/base.rpy:294
translate russian kleio_propose_male_c84cee10:
    kleio.say "ХА! ДА! ДА!"

# ch/kleio/base.rpy:295
translate russian kleio_propose_male_2a362338:
    kleio.say "Нашёлся-таки тот, кто хочет на мне жениться!"

# ch/kleio/base.rpy:296
translate russian kleio_propose_male_007f3df3:
    kleio.say "Съела, мама? Утрись, папа..."

# ch/kleio/base.rpy:297
translate russian kleio_propose_male_29a12a9f:
    "Она замирает, заметив, что я потрясённо на неё смотрю."

# ch/kleio/base.rpy:298
translate russian kleio_propose_male_16a0e841:
    "Клео медленно опускает руку."

# ch/kleio/base.rpy:299
translate russian kleio_propose_male_6321d773:
    "Но руку с кольцом по-прежнему прижимает к груди."

# ch/kleio/base.rpy:300
translate russian kleio_propose_male_2b2299fa:
    "Словно боится, что его отнимут."

# ch/kleio/base.rpy:301
translate russian kleio_propose_male_8dc5de36:
    kleio.say "Что?!"

# ch/kleio/base.rpy:302
translate russian kleio_propose_male_f3f6b189:
    kleio.say "Девушке уже и порадоваться нельзя, что на ней хотят жениться?!"

# ch/kleio/base.rpy:303
translate russian kleio_propose_male_3db53ded:
    mike.say "Д... да, Клео, конечно можно."

# ch/kleio/base.rpy:304
translate russian kleio_propose_male_c42ad591:
    mike.say "Просто я думал, тебе это может не понравиться."

# ch/kleio/base.rpy:305
translate russian kleio_propose_male_84ec1ea9:
    mike.say "Ты ведь не особо придерживаешься традиций, правда?"

# ch/kleio/base.rpy:307
translate russian kleio_propose_male_744172eb:
    "Клео смотрит на меня широко раскрытыми глазами, а её щёки и впрямь краснеют."

# ch/kleio/base.rpy:308
translate russian kleio_propose_male_9a472183:
    "Неужели она смущена? Эта жёсткая, непреклонная девушка, которую я так полюбил?"

# ch/kleio/base.rpy:309
translate russian kleio_propose_male_c2aed3de:
    kleio.say "Ну..."

# ch/kleio/base.rpy:310
translate russian kleio_propose_male_b5f75ce0:
    kleio.say "Может, я просто встретила того, ради кого стоит сделать исключение..."

# ch/kleio/base.rpy:311
translate russian kleio_propose_male_b3120abd:
    "Я приподнимаю бровь, заинтригованный её намёком."

# ch/kleio/base.rpy:312
translate russian kleio_propose_male_89b6f25d:
    mike.say "Клео, это значит то, что я думаю?"

# ch/kleio/base.rpy:313
translate russian kleio_propose_male_cfbcda61:
    mike.say "Ты согласна?"

# ch/kleio/base.rpy:314
translate russian kleio_propose_male_68f38b39:
    "Щёки Клео уже пылают, и она лишь быстро кивает."

# ch/kleio/base.rpy:315
translate russian kleio_propose_male_a134e43c:
    "Странно: даже сейчас она не может заставить себя произнести это вслух."

# ch/kleio/base.rpy:316
translate russian kleio_propose_male_45de9523:
    "Но какая мне, к чёрту, разница, скажет она это слово или нет?"

# ch/kleio/base.rpy:317
translate russian kleio_propose_male_92ec6cdf:
    "Я хочу, чтобы она была в моей жизни, со всеми её странностями и заморочками."

# ch/kleio/base.rpy:318
translate russian kleio_propose_male_cfb7f22c:
    "Я уже понял: хорошего в ней гораздо больше, чем плохого."

# ch/kleio/base.rpy:319
translate russian kleio_propose_male_472a2e85:
    mike.say "Клео, ты сделала меня самым счастливым мужчиной на свете!"

# ch/kleio/base.rpy:321
translate russian kleio_propose_male_a2576227:
    "От моей откровенно сентиментальной фразы румянец на щеках Клео немного бледнеет."

# ch/kleio/base.rpy:322
translate russian kleio_propose_male_81e20bd6:
    "И к ней возвращается привычное самообладание."

# ch/kleio/base.rpy:323
translate russian kleio_propose_male_b3bfa445:
    kleio.say "Заливаешь, сердцеед!"

# ch/kleio/base.rpy:324
translate russian kleio_propose_male_a087eece:
    kleio.say "Но я могу сделать тебя настолько счастливым, насколько смогу."

# ch/kleio/base.rpy:325
translate russian kleio_propose_male_2971f7d4:
    kleio.say "И это, блядь, обещание!"

# ch/kleio/base.rpy:328
translate russian kleio_propose_male_deb6f3ba_1:
    "Затем хватает меня за запястья и поднимает на ноги."

# ch/kleio/base.rpy:329
translate russian kleio_propose_male_247fb1f4:
    "Клео обнимает меня за талию и притягивает к себе."

# ch/kleio/base.rpy:330
translate russian kleio_propose_male_b773aaea:
    "Я обнимаю её в ответ, испытывая облегчение и волнение при мысли о нашем будущем..."

# ch/kleio/base.rpy:341
translate russian kleio_ask_date_male_2f759126:
    mike.say "Хочешь встретиться с Анной и повеселиться?"

# ch/kleio/base.rpy:342
translate russian kleio_ask_date_male_c0c3e439:
    kleio.say "С удовольствием."

# ch/kleio/base.rpy:354
translate russian kleio_ask_date_male_5c2531c2:
    mike.say "Хочешь встретиться с Анной и Сашей и повеселиться?"

# ch/kleio/base.rpy:355
translate russian kleio_ask_date_male_c0c3e439_1:
    kleio.say "С удовольствием."

# ch/kleio/base.rpy:386
translate russian kleio_ask_date_amy_kleio_1ce904ad:
    mike.say "Как насчёт ещё одной безумной ночи с тобой и Эми?"

# ch/kleio/base.rpy:387
translate russian kleio_ask_date_amy_kleio_9b87dd0e:
    kleio.say "Эми, я и бар? Кто-то утром пожалеет. И это буду не я."

# ch/kleio/base.rpy:404
translate russian kleio_ask_date_band_fivesome_126b2f1f:
    mike.say "Не хочешь снова собрать всю группу в студии и повторить выступление?"

# ch/kleio/base.rpy:405
translate russian kleio_ask_date_band_fivesome_379f924d:
    kleio.say "Ещё бы, блядь! Только в этот раз запасись выносливостью, сердцеед."

# ch/kleio/base.rpy:418
translate russian kleio_ask_date_alone_male_b8c449a2:
    mike.say "Клео, сходишь со мной на свидание?"

# ch/kleio/base.rpy:420
translate russian kleio_ask_date_alone_male_fffb9723:
    kleio.say "Прости, [lssb_kleio.hero_name()], но я не вижу в тебе парня."

# ch/kleio/base.rpy:423
translate russian kleio_ask_date_alone_male_51b4f54b:
    kleio.say "Конечно, может быть весело. Когда пойдём?"

# ch/kleio/chat.rpy:4
translate russian kleio_desire_0_male_44c99e68:
    kleio.say "Чего тебе, [lssb_kleio.hero_name()]?"

# ch/kleio/chat.rpy:6
translate russian kleio_desire_0_male_e9fe4f39:
    kleio.say "Как дела, [lssb_kleio.hero_name()]?"

# ch/kleio/chat.rpy:8
translate russian kleio_desire_0_male_23b26a9e:
    kleio.say "Что-то нужно? Только скажи, сердцеед, я разберусь."

# ch/kleio/chat.rpy:11
translate russian kleio_desire_0_male_9522fd9d:
    mike.say "А нужен повод? Я просто хотел тебя увидеть, Клео."

# ch/kleio/chat.rpy:12
translate russian kleio_desire_0_male_1242f517:
    kleio.say "Фу. Сопли. Но, пожалуй, разрешаю."

# ch/kleio/chat.rpy:15
translate russian kleio_desire_0_male_beeaab60:
    mike.say "Знаешь что? Забудь."

# ch/kleio/chat.rpy:16
translate russian kleio_desire_0_male_78880149:
    kleio.say "Ого, какой душка. Дверь там, [lssb_kleio.hero_name()]."

# ch/kleio/chat.rpy:23
translate russian kleio_desire_1_male_fb080074:
    kleio.say "Думаешь, раз ты не совсем урод, тебе полагается что-то особенное?"

# ch/kleio/chat.rpy:25
translate russian kleio_desire_1_male_80dedd5c:
    kleio.say "Знаешь, а ты вполне симпатичный..."

# ch/kleio/chat.rpy:28
translate russian kleio_desire_1_male_db404006:
    mike.say "Я и не говорил, что мне что-то полагается, Клео. Когда заслужу, ты сама скажешь."

# ch/kleio/chat.rpy:29
translate russian kleio_desire_1_male_5dc542e8:
    kleio.say "Хех. Умный ответ. Продолжай в том же духе, может, и добьёшься чего-нибудь."

# ch/kleio/chat.rpy:32
translate russian kleio_desire_1_male_d48b591e:
    mike.say "Хватит меня испытывать, Клео. Веди себя нормально."

# ch/kleio/chat.rpy:33
translate russian kleio_desire_1_male_b8bd3519:
    kleio.say "...Ладно. Только командовать не надо, [lssb_kleio.hero_name()]."

# ch/kleio/chat.rpy:40
translate russian kleio_desire_2_male_765a928a:
    kleio.say "Не думай, что я в тебя влюблюсь только потому, что ты умеешь улыбаться."

# ch/kleio/chat.rpy:42
translate russian kleio_desire_2_male_25fb79d0:
    kleio.say "Хватит так улыбаться, ты меня смущаешь."

# ch/kleio/chat.rpy:45
translate russian kleio_desire_2_male_43c0121f:
    mike.say "Поздно останавливаться, Клео."

# ch/kleio/chat.rpy:46
translate russian kleio_desire_2_male_58ec15ad:
    kleio.say "Господи, ты невыносим. ...Но всё равно продолжай."

# ch/kleio/chat.rpy:49
translate russian kleio_desire_2_male_6ce8ef73:
    mike.say "Расслабься, я не пытаюсь тебя очаровать."

# ch/kleio/chat.rpy:50
translate russian kleio_desire_2_male_6f22fd72:
    kleio.say "Вот и хорошо. Всё равно бы не вышло, сердцеед."

# ch/kleio/chat.rpy:57
translate russian kleio_desire_3_male_8ca2f4ab:
    kleio.say "Обожаю Disrupted, отличная группа..."

# ch/kleio/chat.rpy:59
translate russian kleio_desire_3_male_cce6a5f7:
    kleio.say "Как-нибудь своди меня на концерт Disrupted."

# ch/kleio/chat.rpy:62
translate russian kleio_desire_3_male_a2431ec8:
    mike.say "Только скажи когда, Клео, и я достану билеты."

# ch/kleio/chat.rpy:63
translate russian kleio_desire_3_male_285003d4:
    kleio.say "Вот теперь ты говоришь на моём языке, [lssb_kleio.hero_name()]."

# ch/kleio/chat.rpy:66
translate russian kleio_desire_3_male_5094707c:
    mike.say "Disrupted? Это, по-твоему, отличная группа?"

# ch/kleio/chat.rpy:68
translate russian kleio_desire_3_male_051b6e28:
    kleio.say "Громкие слова от того, кто ни одной песни со второй стороны сингла не назовёт. Садись, [lssb_kleio.hero_name()], буду просвещать."

# ch/kleio/chat.rpy:75
translate russian kleio_desire_4_male_fed3ed31:
    kleio.say "Иногда я рядом с тобой нервничаю."

# ch/kleio/chat.rpy:78
translate russian kleio_desire_4_male_15ad91eb:
    mike.say "Тебе не надо нервничать, Клео. Со мной — не надо."

# ch/kleio/chat.rpy:79
translate russian kleio_desire_4_male_ecc20af4:
    kleio.say "...Да. Да, знаю. Заткнись, пока я не передумала."

# ch/kleio/chat.rpy:82
translate russian kleio_desire_4_male_18c1d813:
    mike.say "Ты? Нервничаешь? Не поверю, пока не увижу."

# ch/kleio/chat.rpy:83
translate russian kleio_desire_4_male_3e5f54d2:
    kleio.say "Тогда забудь, что я сказала. Козёл."

# ch/kleio/chat.rpy:86
translate russian kleio_desire_4_male_0d9a69d5:
    kleio.say "Почему твой член до сих пор не в моей киске?"

# ch/kleio/chat.rpy:93
translate russian kleio_desire_5_male_d42d7e06:
    kleio.say "Может, найдём местечко потише?"

# ch/kleio/chat.rpy:95
translate russian kleio_desire_5_male_1f84a71c:
    kleio.say "Соскучилась по тому, как ты меня трахаешь."

# ch/kleio/chat.rpy:97
translate russian kleio_desire_5_male_7c4f4372:
    kleio.say "Мне всё равно, куда ты меня поведёшь. Доверяю твоему выбору, [lssb_kleio.hero_name()]."

# ch/kleio/chat.rpy:100
translate russian kleio_desire_5_male_8b7507b8:
    mike.say "Знаю одно место. Пойдём со мной."

# ch/kleio/chat.rpy:101
translate russian kleio_desire_5_male_d28be4c7:
    kleio.say "Командир нашёлся. ...Хотя мне нравится. Веди."

# ch/kleio/chat.rpy:104
translate russian kleio_desire_5_male_17316e25:
    mike.say "Может, позже, Клео. Сейчас не время."

# ch/kleio/chat.rpy:105
translate russian kleio_desire_5_male_dac8a012:
    kleio.say "Как хочешь. Сам себя обделяешь, сердцеед."

# ch/kleio/chat.rpy:112
translate russian kleio_love_0_male_a7985f7c:
    kleio.say "Пошёл от меня к чёрту."

# ch/kleio/chat.rpy:114
translate russian kleio_love_0_male_3ea9ef59:
    kleio.say "Что сейчас слушаешь?"

# ch/kleio/chat.rpy:117
translate russian kleio_love_0_male_f3ced904:
    mike.say "Вообще-то увлёкся старыми панк-пластинками. Думал, ты одобришь."

# ch/kleio/chat.rpy:118
translate russian kleio_love_0_male_ae236dbf:
    kleio.say "Хм. Может, ты ещё не безнадёжен, [lssb_kleio.hero_name()]."

# ch/kleio/chat.rpy:121
translate russian kleio_love_0_male_38f9550e:
    mike.say "Тебе бы не понравилось."

# ch/kleio/chat.rpy:122
translate russian kleio_love_0_male_203166b1:
    kleio.say "А ты попробуй. ...Или не пробуй. Как хочешь, [lssb_kleio.hero_name()]."

# ch/kleio/chat.rpy:129
translate russian kleio_love_1_male_969ee3a0:
    kleio.say "Отъебись."

# ch/kleio/chat.rpy:131
translate russian kleio_love_1_male_ace6e393:
    kleio.say "Рада, что встретила тебя. Для придурка ты вполне хороший парень."

# ch/kleio/chat.rpy:134
translate russian kleio_love_1_male_f25cd01b:
    mike.say "Хороший парень? Из твоих уст, Клео, приму как комплимент."

# ch/kleio/chat.rpy:135
translate russian kleio_love_1_male_d615c8a2:
    kleio.say "Только не зазнавайся, сердцеед."

# ch/kleio/chat.rpy:138
translate russian kleio_love_1_male_ff5db230:
    mike.say "Осторожнее, Клео. Кто-нибудь решит, что я тебе правда нравлюсь."

# ch/kleio/chat.rpy:139
translate russian kleio_love_1_male_d72d3918:
    kleio.say "Фу. Забудь. Момент испорчен."

# ch/kleio/chat.rpy:146
translate russian kleio_love_2_male_e4e6b9c0:
    kleio.say "Ты что, в World of Warcraft играешь?"

# ch/kleio/chat.rpy:148
translate russian kleio_love_2_male_62c059b4:
    kleio.say "Блядь, как скучно."

# ch/kleio/chat.rpy:151
translate russian kleio_love_2_male_7387f169:
    mike.say "Тогда пойдём отсюда. В гараж, в магазин пластинок — куда хочешь. Выбирай, Клео."

# ch/kleio/chat.rpy:152
translate russian kleio_love_2_male_c670338c:
    kleio.say "Вот, уже лучше мыслишь. Хватай куртку, [lssb_kleio.hero_name()]."

# ch/kleio/chat.rpy:155
translate russian kleio_love_2_male_e733b3b2:
    mike.say "Это тебе скучно. Вот и решай, что будем делать."

# ch/kleio/chat.rpy:157
translate russian kleio_love_2_male_25f30099:
    kleio.say "Наконец-то кто-то знает своё место. Вставай. Поедем кататься, за рулём я."

# ch/kleio/chat.rpy:164
translate russian kleio_love_3_male_6c8139d0:
    kleio.say "Для таких, как ты, есть школа общения с такими девушками, как я?"

# ch/kleio/chat.rpy:166
translate russian kleio_love_3_male_ad6f6705:
    kleio.say "Знаю, я для тебя слишком хороша, но, может, сделаю исключение."

# ch/kleio/chat.rpy:167
translate russian kleio_love_3_male_8a970132:
    kleio.say "А та басистка, что вчера была у нас на разогреве? Знала своё дело. Такие пальцы надо запретить законом."

# ch/kleio/chat.rpy:170
translate russian kleio_love_3_male_d8c9d82c:
    mike.say "Хорошо играла. У тебя намётанный глаз, Клео."

# ch/kleio/chat.rpy:171
translate russian kleio_love_3_male_2f145e0e:
    kleio.say "У меня на многое намётанный глаз, [lssb_kleio.hero_name()]. На музыкантов в том числе."

# ch/kleio/chat.rpy:174
translate russian kleio_love_3_male_44dddcd6:
    mike.say "Похоже, она зацепила тебя не только музыкой, Клео."

# ch/kleio/chat.rpy:176
translate russian kleio_love_3_male_ac15630a:
    kleio.say "Может, и так. Я би, [lssb_kleio.hero_name()], это не государственная тайна. Девушка так играет? Конечно, я замечу."

# ch/kleio/chat.rpy:179
translate russian kleio_love_3_male_9332bb6d:
    mike.say "Мне стоит бояться конкуренции?"

# ch/kleio/chat.rpy:180
translate russian kleio_love_3_male_3a3063da:
    kleio.say "Расслабься, сердцеед. Я не собираюсь бегать за незнакомкой. Своим не делюсь и сама общей быть не хочу. Ясно?"

# ch/kleio/chat.rpy:183
translate russian kleio_love_3_male_2400e8f1:
    mike.say "Как скажешь, Клео."

# ch/kleio/chat.rpy:184
translate russian kleio_love_3_male_abc23aa2:
    kleio.say "Вау. Захватывающе. Рада, что поговорили, [lssb_kleio.hero_name()]."

# ch/kleio/chat.rpy:191
translate russian kleio_love_4_male_265676d2:
    kleio.say "Так мы пара?"

# ch/kleio/chat.rpy:194
translate russian kleio_love_4_male_09118230:
    mike.say "Да, Клео. По-моему, пара."

# ch/kleio/chat.rpy:196
translate russian kleio_love_4_male_b2b86df6:
    kleio.say "...Ладно. Круто. Только не жди от меня соплей."

# ch/kleio/chat.rpy:199
translate russian kleio_love_4_male_ad313e03:
    mike.say "Нам обязательно это как-то называть?"

# ch/kleio/chat.rpy:200
translate russian kleio_love_4_male_5eaa018f:
    kleio.say "Наверное, нет. Забудь, сердцеед."

# ch/kleio/chat.rpy:203
translate russian kleio_love_4_male_9c008599:
    kleio.say "Кажется, я в тебя влюбляюсь..."

# ch/kleio/chat.rpy:206
translate russian kleio_love_4_male_8be941e7:
    kleio.say "Только не устраивай из этого неловкость, [lssb_kleio.hero_name()]."

# ch/kleio/chat.rpy:212
translate russian kleio_love_5_male_7c377d18:
    kleio.say "Да-да, я влюблена. И что?"

# ch/kleio/chat.rpy:214
translate russian kleio_love_5_male_3934a6c4:
    kleio.say "Пожалуйста, трахни меня, как только останемся одни..."

# ch/kleio/chat.rpy:216
translate russian kleio_love_5_male_3b0210e0:
    kleio.say "Я согласна на всё, что ты хочешь со мной сделать. Только скажи, [lssb_kleio.hero_name()]."

# ch/kleio/chat.rpy:219
translate russian kleio_love_5_male_7cb1a3d6:
    mike.say "Я тоже тебя люблю, Клео. Даже с твоим сквернословием."

# ch/kleio/chat.rpy:221
translate russian kleio_love_5_male_4946d8a7:
    kleio.say "Сентиментальный дурачок. ...Но за это я тебя и люблю."

# ch/kleio/chat.rpy:224
translate russian kleio_love_5_male_5b28e1f4:
    mike.say "Великая циничная Клео влюбилась? Не думал, что доживу до такого."

# ch/kleio/chat.rpy:225
translate russian kleio_love_5_male_644496ec:
    kleio.say "Фу, ладно, твоя взяла. Я твоя, ясно? Хватит злорадствовать, веди меня туда, где побудем одни."

# ch/kleio/chat.rpy:232
translate russian kleio_good_sweet_talk_male_fde41948:
    mike.say "Я уже говорил, что ты чертовски дерзкая, Клео?"

# ch/kleio/chat.rpy:233
translate russian kleio_good_sweet_talk_male_37ae6be8:
    mike.say "Потому что это так... И мне нравится!"

# ch/kleio/chat.rpy:235
translate russian kleio_good_sweet_talk_male_63756072:
    kleio.say "О-о... Спасибо, сердцеед!"

# ch/kleio/chat.rpy:236
translate russian kleio_good_sweet_talk_male_0ea7b50a:
    kleio.say "Обожаю, что тебе нравятся мои колючки!"

# ch/kleio/chat.rpy:238
translate russian kleio_good_sweet_talk_male_4fa1cc76:
    mike.say "Не думала набить ещё татуировок, Клео?"

# ch/kleio/chat.rpy:239
translate russian kleio_good_sweet_talk_male_fcd09552:
    mike.say "Те, что уже есть, тебе очень идут!"

# ch/kleio/chat.rpy:241
translate russian kleio_good_sweet_talk_male_6c7faa29:
    kleio.say "Спасибо, сердцеед!"

# ch/kleio/chat.rpy:242
translate russian kleio_good_sweet_talk_male_ec0e1c76:
    kleio.say "Зови меня расписной женщиной!"

# ch/kleio/chat.rpy:244
translate russian kleio_good_sweet_talk_male_874dff06:
    mike.say "Ух, Клео, ну и яйца у тебя!"

# ch/kleio/chat.rpy:245
translate russian kleio_good_sweet_talk_male_bd58a13d:
    mike.say "В хорошем смысле, понимаешь?"

# ch/kleio/chat.rpy:247
translate russian kleio_good_sweet_talk_male_f83f8b08:
    kleio.say "Ха-ха..."

# ch/kleio/chat.rpy:248
translate russian kleio_good_sweet_talk_male_b0383f15:
    kleio.say "Спасибо за комплимент!"

# ch/kleio/chat.rpy:251
translate russian kleio_good_sweet_talk_male_c5e2c193:
    kleio.say "За такие слова я почти на всё соглашусь, [lssb_kleio.hero_name()]."

# ch/kleio/chat.rpy:254
translate russian kleio_good_sweet_talk_male_4eed31d4:
    kleio.say "Осторожнее, [lssb_kleio.hero_name()]. Так я к тебе ещё и привыкну."

# ch/kleio/chat.rpy:260
translate russian kleio_bad_sweet_talk_male_9d04b76d:
    mike.say "Кому-то может показаться, что ты слишком много ругаешься, Клео."

# ch/kleio/chat.rpy:261
translate russian kleio_bad_sweet_talk_male_cdcc9f22:
    mike.say "Но не мне... По-моему, это мило!"

# ch/kleio/chat.rpy:263
translate russian kleio_bad_sweet_talk_male_ccbc378a:
    kleio.say "И что это, блядь, должно значить, сердцеед?"

# ch/kleio/chat.rpy:264
translate russian kleio_bad_sweet_talk_male_cbbc5d9d:
    kleio.say "С какого хрена ты называешь меня милой?!"

# ch/kleio/chat.rpy:265
translate russian kleio_bad_sweet_talk_male_3698850e:
    mike.say "Эм... Прости, Клео..."

# ch/kleio/condom.rpy:4
translate russian kleio_use_condom_b2bdae2d:
    "На миг прерываюсь и беру презерватив с прикроватной тумбочки."

# ch/kleio/condom.rpy:5
translate russian kleio_use_condom_7019a83e:
    "Клео недовольно хнычет из-за паузы, но, увидев, как я его надеваю, начинает одобрительно мурлыкать."

# ch/kleio/condom.rpy:7
translate russian kleio_use_condom_9edc9347:
    "Но я останавливаюсь, прежде чем войти в неё."

# ch/kleio/condom.rpy:8
translate russian kleio_use_condom_4d9d26fc:
    kleio.say "Чт..."

# ch/kleio/condom.rpy:9
translate russian kleio_use_condom_cd20995c:
    kleio.say "Что ты делаешь?"

# ch/kleio/condom.rpy:10
translate russian kleio_use_condom_41f97aa9:
    "Вместо объяснений беру презерватив с тумбочки."

# ch/kleio/condom.rpy:11
translate russian kleio_use_condom_120f676c:
    "Клео охотно кивает и подбадривает меня, пока я вскрываю упаковку и надеваю его."

# ch/kleio/condom.rpy:13
translate russian kleio_use_condom_edde971f:
    "Но это не значит, что я собираюсь лишний раз рисковать."

# ch/kleio/condom.rpy:14
translate russian kleio_use_condom_9dad1a31:
    mike.say "Секунду, Клео."

# ch/kleio/condom.rpy:15
translate russian kleio_use_condom_4dda9fe5:
    mike.say "Лучше воспользоваться презервативом."

# ch/kleio/condom.rpy:16
translate russian kleio_use_condom_0684c89f:
    kleio.say "А?.. Чт..."

# ch/kleio/condom.rpy:17
translate russian kleio_use_condom_3d81380e:
    kleio.say "А, да... Ты прав!"

# ch/kleio/condom.rpy:18
translate russian kleio_use_condom_66313ad1:
    "Клео терпеливо ждёт, пока я достаю презерватив из кармана."

# ch/kleio/condom.rpy:19
translate russian kleio_use_condom_c250db6c:
    "Надеть его — дело пары секунд."

# ch/kleio/condom.rpy:20
translate russian kleio_use_condom_ea370c0a:
    "И можно продолжать!"

# ch/kleio/condom.rpy:26
translate russian kleio_intro_condom_83e471bc:
    "Клео так близко, что я могу думать лишь о том, как немедленно ею овладеть."

# ch/kleio/condom.rpy:28
translate russian kleio_intro_condom_f60bf8a2:
    mike.say "Да забудь, Клео."

# ch/kleio/condom.rpy:29
translate russian kleio_intro_condom_c065b2c7:
    mike.say "Это весь настрой собьёт."

# ch/kleio/condom.rpy:30
translate russian kleio_intro_condom_3ff118b6:
    mike.say "Давай рискнём!"

# ch/kleio/condom.rpy:32
translate russian kleio_intro_condom_40249050:
    "Клео не может так меня дразнить и не получить желаемого."

# ch/kleio/condom.rpy:33
translate russian kleio_intro_condom_7929260c:
    "Ведь стоит ей начать, как я и сам больше всего на свете хочу того же!"

# ch/kleio/condom.rpy:34
translate russian kleio_intro_condom_7928cd35:
    "Поэтому резко притягиваю её вниз, чувствуя, как мой член всей длиной скользит по её половым губам."

# ch/kleio/condom.rpy:35
translate russian kleio_intro_condom_be733326:
    "Клео округляет глаза и ахает от приятной неожиданности."

# ch/kleio/condom.rpy:40
translate russian kleio_warn_condom_d23a3685:
    kleio.say "Погоди... Сначала наденешь презерватив, [lssb_kleio.hero_name()]?"

# ch/kleio/condom.rpy:41
translate russian kleio_warn_condom_7e217181:
    kleio.say "Я серьёзно. Не могу так рисковать, даже с тобой."

# ch/kleio/condom.rpy:45
translate russian kleio_warn_condom_72c83ce1:
    kleio.say "Сначала что-нибудь на него надень, прежде чем подносить к рабочему входу!"

# ch/kleio/condom.rpy:47
translate russian kleio_warn_condom_1a3490ae:
    kleio.say "Лучше натяни резинку, чувак, иначе игра окончена!"

# ch/kleio/condom.rpy:49
translate russian kleio_warn_condom_f91ef269:
    kleio.say "Вот чёрт..."

# ch/kleio/condom.rpy:50
translate russian kleio_warn_condom_803faca2:
    kleio.say "Погоди!"

# ch/kleio/condom.rpy:51
translate russian kleio_warn_condom_cddeea7e:
    kleio.say "Нужен презерватив!"

# ch/kleio/condom.rpy:52
translate russian kleio_warn_condom_e84ffc6f:
    mike.say "Что?"

# ch/kleio/condom.rpy:54
translate russian kleio_warn_condom_31baf605:
    "Клео останавливает меня, прежде чем я успеваю войти в неё."

# ch/kleio/condom.rpy:55
translate russian kleio_warn_condom_e84ffc6f_1:
    mike.say "Что?"

# ch/kleio/condom.rpy:56
translate russian kleio_warn_condom_1da41795:
    mike.say "Что ты делаешь?"

# ch/kleio/condom.rpy:65
translate russian kleio_force_condom_19e9142c:
    kleio.say "Секунду..."

# ch/kleio/condom.rpy:66
translate russian kleio_force_condom_038d0bb4:
    kleio.say "У меня где-то здесь был..."

# ch/kleio/condom.rpy:67
translate russian kleio_force_condom_37a558a7:
    "Я терпеливо жду, пока Клео достаёт презерватив."

# ch/kleio/condom.rpy:68
translate russian kleio_force_condom_c250db6c:
    "Надеть его — дело пары секунд."

# ch/kleio/condom.rpy:69
translate russian kleio_force_condom_ea370c0a:
    "И можно продолжать!"

# ch/kleio/condom.rpy:73
translate russian kleio_pregnant_condom_4d22da19:
    kleio.say "Хватит тянуть! Никакого риска, дважды залететь я не могу!"

# ch/kleio/condom.rpy:77
translate russian kleio_pill_condom_b138b2ea:
    kleio.say "Хватит тянуть! Никакого риска, я на таблетках!"

# ch/kleio/condom.rpy:82
translate russian kleio_no_condom_17606054:
    kleio.say "Мне дважды повторять не надо, [lssb_kleio.hero_name()]."

# ch/kleio/condom.rpy:83
translate russian kleio_no_condom_b99cb336:
    kleio.say "Входи прямо так. Хочу чувствовать тебя целиком, без всяких преград."

# ch/kleio/condom.rpy:86
translate russian kleio_no_condom_5ec8e3da:
    kleio.say "Хватит тянуть! Я разрешаю войти так!"

# ch/kleio/condom.rpy:88
translate russian kleio_no_condom_29a2c7c8:
    "На миг кажется, что Клео начнёт спорить."

# ch/kleio/condom.rpy:89
translate russian kleio_no_condom_eea706a1:
    "Но она кивает и начинает меня подгонять."

# ch/kleio/condom.rpy:90
translate russian kleio_no_condom_438dcda0:
    kleio.say "Конечно, сердцеед, конечно!"

# ch/kleio/condom.rpy:91
translate russian kleio_no_condom_69f89833:
    kleio.say "Просто накрутила себя!"

# ch/kleio/condom.rpy:97
translate russian kleio_mad_condom_261b29ab:
    "Шарю по прикроватной тумбочке в поисках презерватива, но ничего нет."

# ch/kleio/condom.rpy:98
translate russian kleio_mad_condom_479879e4:
    mike.say "Чёрт... Закончились!"

# ch/kleio/condom.rpy:99
translate russian kleio_mad_condom_bee8f54f:
    "Клео криво улыбается, качает головой и пожимает плечами, слезая с кровати."

# ch/kleio/condom.rpy:100
translate russian kleio_mad_condom_e4dbaa05:
    kleio.say "Прости, сердцеед. Похоже, на сегодня с тебя хватит!"

# ch/kleio/condom.rpy:102
translate russian kleio_mad_condom_f5301f52:
    kleio.say "Нет уж, спасибо, сердцеед!"

# ch/kleio/condom.rpy:103
translate russian kleio_mad_condom_7ff39db3:
    kleio.say "Когда вожу, пристёгиваю ремень."

# ch/kleio/condom.rpy:104
translate russian kleio_mad_condom_d7f5198c:
    kleio.say "А когда трахаюсь — на нём должна быть резинка!"

# ch/kleio/condom.rpy:105
translate russian kleio_mad_condom_cda5ad7f:
    "Клео резко отталкивает меня от себя."

# ch/kleio/condom.rpy:106
translate russian kleio_mad_condom_d5f8300a:
    "Затем выскальзывает из-под моей руки и начинает одеваться."

# ch/kleio/condom.rpy:107
translate russian kleio_mad_condom_1dbf986a:
    "Кажется, на этот раз я всё испортил!"

# ch/kleio/condom.rpy:109
translate russian kleio_mad_condom_ab1513b3:
    kleio.say "Нам нужен презерватив, придурок!"

# ch/kleio/condom.rpy:110
translate russian kleio_mad_condom_0be41c7c:
    mike.say "Ну, Клео!"

# ch/kleio/condom.rpy:111
translate russian kleio_mad_condom_c1e8a0b9:
    mike.say "Может, хоть раз обойдёмся без него?"

# ch/kleio/condom.rpy:112
translate russian kleio_mad_condom_18cab056:
    "Клео смотрит на меня с отвращением и качает головой."

# ch/kleio/condom.rpy:113
translate russian kleio_mad_condom_11b31e9a:
    kleio.say "Нет, блядь, не обойдёмся!"

# ch/kleio/condom.rpy:114
translate russian kleio_mad_condom_2c377f55:
    kleio.say "Нет презерватива — нет члена!"

# ch/kleio/condom.rpy:115
translate russian kleio_mad_condom_a2aa12d2:
    "Она слезает с меня и начинает одеваться."

# ch/kleio/condom.rpy:116
translate russian kleio_mad_condom_f7590dbd:
    "И ничем её, похоже, не переубедить."

# ch/kleio/date.rpy:3
translate russian kleio_date_intro_valentine_male_04ee46e3:
    mike.say "С Днём святого Валентина, Клео."

# ch/kleio/date.rpy:4
translate russian kleio_date_intro_valentine_male_0ec4d51e:
    "Клео поглаживает округлившийся живот и иронично смотрит на меня."

# ch/kleio/date.rpy:5
translate russian kleio_date_intro_valentine_male_60453e32:
    kleio.say "Да-да. Ты уже подарил мне единственную валентинку, которая надолго останется со мной, сердцеед."

# ch/kleio/date.rpy:6
translate russian kleio_date_intro_valentine_male_6a731561:
    "Говорит будто в шутку, но руку с живота не убирает."

# ch/kleio/date.rpy:7
translate russian kleio_date_intro_valentine_male_b61c940d:
    mike.say "Ни с кем другим я не хотел бы провести этот день, Клео."

# ch/kleio/date.rpy:8
translate russian kleio_date_intro_valentine_male_e2f99181:
    kleio.say "Осторожнее. Так я тебе ещё и поверю."

# ch/kleio/date.rpy:10
translate russian kleio_date_intro_valentine_male_defe354d:
    kleio.say "С Днём святого Валентина, [lssb_kleio.hero_name()]."

# ch/kleio/date.rpy:12
translate russian kleio_date_intro_valentine_male_2d406870:
    kleio.say "С Днём святого Валентина, балбес."

# ch/kleio/date.rpy:14
translate russian kleio_date_intro_valentine_male_04ee46e3_1:
    mike.say "С Днём святого Валентина, Клео."

# ch/kleio/date.rpy:15
translate russian kleio_date_intro_valentine_male_4fe09740:
    mike.say "Сегодня я не хотел бы видеть своей валентинкой никого, кроме тебя."

# ch/kleio/date.rpy:16
translate russian kleio_date_intro_valentine_male_e6346055:
    "Клео разражается смехом."

# ch/kleio/date.rpy:17
translate russian kleio_date_intro_valentine_male_38d59328:
    kleio.say "Ты уверен, сердцеед?"

# ch/kleio/date.rpy:18
translate russian kleio_date_intro_valentine_male_a056451c:
    kleio.say "Со мной День святого Валентина может быть с перчинкой!"

# ch/kleio/date.rpy:19
translate russian kleio_date_intro_valentine_male_7544b338:
    mike.say "Конечно уверен, Клео."

# ch/kleio/date.rpy:20
translate russian kleio_date_intro_valentine_male_7b981ff0:
    mike.say "Ты же знаешь, я люблю твою перчинку!"

# ch/kleio/date.rpy:21
translate russian kleio_date_intro_valentine_male_989e178f:
    kleio.say "Ох, ну ты и балбес, сердцеед!"

# ch/kleio/date.rpy:22
translate russian kleio_date_intro_valentine_male_cf13e9ca:
    kleio.say "Но я всё равно тебя люблю!"

# ch/kleio/date.rpy:24
translate russian kleio_date_intro_valentine_male_defe354d_1:
    kleio.say "С Днём святого Валентина, [lssb_kleio.hero_name()]."

# ch/kleio/date.rpy:26
translate russian kleio_date_intro_valentine_male_04ee46e3_2:
    mike.say "С Днём святого Валентина, Клео."

# ch/kleio/date.rpy:27
translate russian kleio_date_intro_valentine_male_4fe09740_1:
    mike.say "Сегодня я не хотел бы видеть своей валентинкой никого, кроме тебя."

# ch/kleio/date.rpy:28
translate russian kleio_date_intro_valentine_male_488534b0:
    "Клео фыркает и закатывает глаза, но не уходит."

# ch/kleio/date.rpy:29
translate russian kleio_date_intro_valentine_male_24bc8507:
    kleio.say "День святого Валентина, да? День, когда лохам впаривают розы втридорога."

# ch/kleio/date.rpy:30
translate russian kleio_date_intro_valentine_male_665dce1e:
    kleio.say "Ты же не спустил деньги на эту хрень, сердцеед?"

# ch/kleio/date.rpy:31
translate russian kleio_date_intro_valentine_male_80737b53:
    mike.say "Э-э... Нет, Клео."

# ch/kleio/date.rpy:32
translate russian kleio_date_intro_valentine_male_cad928b0:
    kleio.say "Хорошо."

# ch/kleio/date.rpy:33
translate russian kleio_date_intro_valentine_male_f3ef0aa8:
    "Уголок её рта невольно дёргается в кривой улыбке."

# ch/kleio/date.rpy:34
translate russian kleio_date_intro_valentine_male_2ccc7af3:
    kleio.say "Значит, может, ты ещё не совсем безнадёжен."

# ch/kleio/date.rpy:35
translate russian kleio_date_intro_valentine_male_31a1e0ed:
    kleio.say "Пойдём лучше поищем приключений."

# ch/kleio/date.rpy:39
translate russian kleio_date_intro_halloween_male_50313aa1:
    mike.say "Слушай, Клео, я и забыл, что сегодня Хэллоуин."

# ch/kleio/date.rpy:40
translate russian kleio_date_intro_halloween_male_77c70511:
    mike.say "Надо было нарядиться в костюмы, да?"

# ch/kleio/date.rpy:41
translate russian kleio_date_intro_halloween_male_e82065a6:
    "Клео посмеивается и качает головой."

# ch/kleio/date.rpy:42
translate russian kleio_date_intro_halloween_male_3f4e576c:
    kleio.say "Хочешь, чтобы я надела миленький костюмчик и дефилировала перед тобой?"

# ch/kleio/date.rpy:43
translate russian kleio_date_intro_halloween_male_6a2aac6b:
    kleio.say "Ты это пытаешься сказать, сердцеед?"

# ch/kleio/date.rpy:44
translate russian kleio_date_intro_halloween_male_c7537c16:
    "От её прямого вопроса я чувствую, как начинаю краснеть."

# ch/kleio/date.rpy:45
translate russian kleio_date_intro_halloween_male_1206ee51:
    mike.say "Нет... то есть да... В смысле только если ты сама хочешь, Клео!"

# ch/kleio/date.rpy:46
translate russian kleio_date_intro_halloween_male_9bf11487:
    "Клео снова смеётся, явно наслаждаясь происходящим."

# ch/kleio/date.rpy:47
translate russian kleio_date_intro_halloween_male_f37caf02:
    kleio.say "Можно и так. А можно и тебе подефилировать передо мной!"

# ch/kleio/date.rpy:52
translate russian kleio_date_intro_christmas_male_a4423479:
    kleio.say "Привет, сердцеед. Полон праздничного духа и прочей хрени?"

# ch/kleio/date.rpy:53
translate russian kleio_date_intro_christmas_male_3e05371f:
    "Клео поддерживает ладонью живот и лениво улыбается."

# ch/kleio/date.rpy:54
translate russian kleio_date_intro_christmas_male_4df3ad63:
    mike.say "Может, немного, мисс Гринч."

# ch/kleio/date.rpy:55
translate russian kleio_date_intro_christmas_male_4d0d005d:
    kleio.say "Только без акробатики под омелой в этом году."

# ch/kleio/date.rpy:56
translate russian kleio_date_intro_christmas_male_598c3e75:
    "Она поглаживает живот и ухмыляется."

# ch/kleio/date.rpy:57
translate russian kleio_date_intro_christmas_male_b344e15f:
    kleio.say "Твой подарок уже прижился, сердцеед. А теперь подай эгг-ног и помассируй мне ноги."

# ch/kleio/date.rpy:59
translate russian kleio_date_intro_christmas_male_5fb0b15b:
    kleio.say "Ну же, [lssb_kleio.hero_name()]. Рождество всё-таки."

# ch/kleio/date.rpy:61
translate russian kleio_date_intro_christmas_male_c6b31c7b:
    kleio.say "Эй, сердцеед, полон праздничного духа и прочей хрени?"

# ch/kleio/date.rpy:62
translate russian kleio_date_intro_christmas_male_4ddd11cd:
    "Её едкость и озорной блеск в глазах вызывают у меня улыбку."

# ch/kleio/date.rpy:63
translate russian kleio_date_intro_christmas_male_a8100da6:
    mike.say "А если и так, мисс Гринч?"

# ch/kleio/date.rpy:64
translate russian kleio_date_intro_christmas_male_bb5ac8c3:
    mike.say "Что сделаешь, высосешь его из меня?"

# ch/kleio/date.rpy:65
translate russian kleio_date_intro_christmas_male_2f60dbba:
    "Клео похабно смеётся: ей нравится, что я не остаюсь в долгу."

# ch/kleio/date.rpy:66
translate russian kleio_date_intro_christmas_male_f7634902:
    kleio.say "Вот окажемся под омелой — узнаешь, сердцеед."

# ch/kleio/date.rpy:67
translate russian kleio_date_intro_christmas_male_ac508bd9:
    kleio.say "Я из тебя, блядь, все соки высосу!"

# ch/kleio/date.rpy:72
translate russian kleio_date_intro_birthday_male_828fd3f2:
    mike.say "С днём рождения, Клео!"

# ch/kleio/date.rpy:73
translate russian kleio_date_intro_birthday_male_a395e16b:
    kleio.say "На год старше и уже размером с дом."

# ch/kleio/date.rpy:74
translate russian kleio_date_intro_birthday_male_08bf1191:
    "Она медленно поглаживает живот. На лице попеременно недовольство и что-то более нежное."

# ch/kleio/date.rpy:75
translate russian kleio_date_intro_birthday_male_822deef6:
    kleio.say "Вот такой день рождения, сердцеед."

# ch/kleio/date.rpy:76
translate russian kleio_date_intro_birthday_male_1ae1a802:
    mike.say "Ты потрясающе выглядишь, Клео."

# ch/kleio/date.rpy:77
translate russian kleio_date_intro_birthday_male_71fa5ed3:
    kleio.say "Фу. Ну ты и сентиментальный."

# ch/kleio/date.rpy:78
translate russian kleio_date_intro_birthday_male_f9c3a471:
    "Но она не отстраняется, когда я кладу ладонь на её живот рядом с её рукой."

# ch/kleio/date.rpy:80
translate russian kleio_date_intro_birthday_male_fc0b3f9a:
    kleio.say "...Спасибо, [lssb_kleio.hero_name()]."

# ch/kleio/date.rpy:82
translate russian kleio_date_intro_birthday_male_fce56eeb:
    kleio.say "...Спасибо, балбес."

# ch/kleio/date.rpy:84
translate russian kleio_date_intro_birthday_male_828fd3f2_1:
    mike.say "С днём рождения, Клео!"

# ch/kleio/date.rpy:85
translate russian kleio_date_intro_birthday_male_44977a65:
    kleio.say "А-а..."

# ch/kleio/date.rpy:86
translate russian kleio_date_intro_birthday_male_f2d368d4:
    kleio.say "С чем тут поздравлять, сердцеед?"

# ch/kleio/date.rpy:87
translate russian kleio_date_intro_birthday_male_b597aecd:
    kleio.say "Я всего лишь стала на год старше!"

# ch/kleio/date.rpy:88
translate russian kleio_date_intro_birthday_male_4a0ac48b:
    mike.say "Эм... Да, Клео... Понимаю, о чём ты..."

# ch/kleio/date.rpy:89
translate russian kleio_date_intro_birthday_male_cc523acb:
    mike.say "Но это хотя бы повод повеселиться, правда?"

# ch/kleio/date.rpy:90
translate russian kleio_date_intro_birthday_male_a019cf3e:
    kleio.say "Вот теперь ты говоришь на моём языке!"

# ch/kleio/date.rpy:94
translate russian kleio_date_intro_mc_birthday_male_7b3bea90:
    kleio.say "С днём рождения, сердцеед!"

# ch/kleio/date.rpy:95
translate russian kleio_date_intro_mc_birthday_male_b4e3d12b:
    kleio.say "Ну что, сегодня оторвёмся?"

# ch/kleio/date.rpy:96
translate russian kleio_date_intro_mc_birthday_male_203b8c8b:
    kleio.say "Как следует отметим твой день?"

# ch/kleio/date.rpy:97
translate russian kleio_date_intro_mc_birthday_male_e51aded4:
    mike.say "Д... да, Клео!"

# ch/kleio/date.rpy:98
translate russian kleio_date_intro_mc_birthday_male_e55d7d05:
    mike.say "Звучит потрясающе!"

# ch/kleio/date.rpy:99
translate russian kleio_date_intro_mc_birthday_male_c4b6fd59:
    mike.say "А что ты задумала?"

# ch/kleio/date.rpy:100
translate russian kleio_date_intro_mc_birthday_male_32b509da:
    kleio.say "Вот увидишь!"

# ch/kleio/date.rpy:101
translate russian kleio_date_intro_mc_birthday_male_64115e22:
    kleio.say "Тебе понравится, обещаю."

# ch/kleio/date.rpy:106
translate russian kleio_date_eat_a_burger_860e3aa5:
    "Клео набрасывается на бургер, едва его приносят. Ест за двоих и ничуть не стесняется."

# ch/kleio/date.rpy:107
translate russian kleio_date_eat_a_burger_9ae63d91:
    "Заметив мой взгляд, она тычет в мою сторону картофелиной, не успев прожевать."

# ch/kleio/date.rpy:108
translate russian kleio_date_eat_a_burger_ff4387d3:
    "Почему-то то, с каким удовольствием она уплетает еду, — лучшее, что я видел за всю неделю."

# ch/kleio/date.rpy:110
translate russian kleio_date_eat_a_burger_b59d94ab:
    "Клео, кажется, затаила дыхание в ожидании бургера."

# ch/kleio/date.rpy:111
translate russian kleio_date_eat_a_burger_ba760bd3:
    "Когда его приносят, она откидывается на спинку и ест медленно, смакуя каждый кусочек."

# ch/kleio/date.rpy:112
translate russian kleio_date_eat_a_burger_69a518b6:
    "Почему-то я тоже получаю удовольствие, хотя лишь смотрю на неё!"

# ch/kleio/date.rpy:119
translate russian kleio_date_buy_drink_9765da70:
    kleio.say "Ты меня уже обрюхатил, придурок!"

# ch/kleio/date.rpy:120
translate russian kleio_date_buy_drink_46a84233:
    kleio.say "Теперь ещё и ребёнка угробить хочешь?!"

# ch/kleio/date.rpy:124
translate russian kleio_date_buy_drink_08e58d73:
    "Клео делает огромный глоток из бокала, почти не останавливаясь."

# ch/kleio/date.rpy:125
translate russian kleio_date_buy_drink_ecae6276:
    "Клянусь, таким количеством выпитого гордился бы мужчина вдвое крупнее неё."

# ch/kleio/date.rpy:126
translate russian kleio_date_buy_drink_4725c6ef:
    "А она лишь вытирает рот тыльной стороной ладони и улыбается."

# ch/kleio/date.rpy:130
translate russian kleio_date_play_darts_f43fdedf:
    "Клео подходит к линии броска с дротиками в руке. Пока ничего странного."

# ch/kleio/date.rpy:131
translate russian kleio_date_play_darts_e13f5c10:
    "Но затем закрывает глаза одной ладонью и швыряет дротики наугад другой."

# ch/kleio/date.rpy:132
translate russian kleio_date_play_darts_81ecd56c:
    "В начавшемся хаосе я уже не знаю, пугаться или смеяться!"

# ch/kleio/date.rpy:136
translate russian kleio_date_pub_play_pool_9ce95437:
    "Мы начинаем играть в бильярд, и Клео держится с наглостью бывалого каталы."

# ch/kleio/date.rpy:137
translate russian kleio_date_pub_play_pool_8c45583d:
    "Пока не запрыгивает на край стола и не начинает бить, стоя спиной к шарам."

# ch/kleio/date.rpy:138
translate russian kleio_date_pub_play_pool_be041ee1:
    "Она всё время показывает мне язык, словно предлагает попробовать на неё разозлиться."

# ch/kleio/date.rpy:145
translate russian kleio_date_buy_a_round_9765da70:
    kleio.say "Ты меня уже обрюхатил, придурок!"

# ch/kleio/date.rpy:146
translate russian kleio_date_buy_a_round_46a84233:
    kleio.say "Теперь ещё и ребёнка угробить хочешь?!"

# ch/kleio/date.rpy:151
translate russian kleio_date_buy_a_round_c8dbab52:
    "Стоит мне сказать, что иду к барной стойке, как Клео издаёт радостный возглас."

# ch/kleio/date.rpy:152
translate russian kleio_date_buy_a_round_e44755d5:
    "Но затем узнаёт, что я собираюсь угостить всех, а не только взять себе."

# ch/kleio/date.rpy:153
translate russian kleio_date_buy_a_round_03a5bfc6:
    "И буквально воет от восторга."

# ch/kleio/date.rpy:160
translate russian kleio_date_buy_a_round_fb20fd2c:
    "Я хочу угостить пивом весь паб."

# ch/kleio/date.rpy:161
translate russian kleio_date_buy_a_round_6a39600d:
    "Но Клео, кажется, не хочет пить, и я тоже воздерживаюсь."

# ch/kleio/date.rpy:167
translate russian kleio_dance_with_6510639c:
    "На танцполе Клео сразу заводит мои руки себе за спину, заставляя обнять её сзади."

# ch/kleio/date.rpy:168
translate russian kleio_dance_with_e5671916:
    "Она медленно покачивается вместе со мной, и я чувствую ладонями тёплую округлость её живота."

# ch/kleio/date.rpy:169
translate russian kleio_dance_with_a165d00f:
    "В кои-то веки она не задаёт изнурительный темп, и мы оба, кажется, не против."

# ch/kleio/date.rpy:171
translate russian kleio_dance_with_007ec969:
    "На танцполе Клео тут же разворачивается и льнёт ко мне спиной."

# ch/kleio/date.rpy:172
translate russian kleio_dance_with_ad3335b2:
    "Она направляет мои руки по своему телу и оставляет их там, на этот раз следуя за мной."

# ch/kleio/date.rpy:173
translate russian kleio_dance_with_2826c29e:
    "Её дыхание сбивается, когда она откидывается на меня и ждёт, чтобы я повёл её."

# ch/kleio/date.rpy:175
translate russian kleio_dance_with_85f8a699:
    "Едва мы оказываемся на танцполе, Клео поворачивается спиной и прижимается ко мне."

# ch/kleio/date.rpy:176
translate russian kleio_dance_with_614e38b1:
    "Хватает обе мои руки и буквально заставляет ласкать её тело."

# ch/kleio/date.rpy:177
translate russian kleio_dance_with_8f069aba:
    "Я нервно сглатываю, чувствуя, как она трётся об меня своим стройным упругим телом."

# ch/kleio/date.rpy:181
translate russian kleio_date_play_arcade_intro_male_d5296788:
    kleio.say "Тут попахивает, сердцеед!"

# ch/kleio/date.rpy:182
translate russian kleio_date_play_arcade_intro_male_8b74c200:
    kleio.say "Тебе правда нравится здесь торчать?"

# ch/kleio/date.rpy:183
translate russian kleio_date_play_arcade_intro_male_d18b3b36:
    "Я поворачиваюсь и замечаю улыбку Клео."

# ch/kleio/date.rpy:184
translate russian kleio_date_play_arcade_intro_male_71fbef11:
    "Насмешливую, ироничную, словно она смотрит на меня свысока."

# ch/kleio/date.rpy:185
translate russian kleio_date_play_arcade_intro_male_31e07dc3:
    mike.say "Постарайся быть повежливее, Клео."

# ch/kleio/date.rpy:186
translate russian kleio_date_play_arcade_intro_male_6635c5d4:
    mike.say "Я же не обсираю то, что нравится ТЕБЕ!"

# ch/kleio/date.rpy:187
translate russian kleio_date_play_arcade_intro_male_4ee7d01c:
    kleio.say "Конечно не обсираешь."

# ch/kleio/date.rpy:188
translate russian kleio_date_play_arcade_intro_male_41d8e2d6:
    kleio.say "Потому что я не заставляю нас заниматься отстойной фигнёй!"

# ch/kleio/date.rpy:189
translate russian kleio_date_play_arcade_intro_male_161b5711:
    "Часть меня начинает думать, что это плохая идея."

# ch/kleio/date.rpy:190
translate russian kleio_date_play_arcade_intro_male_f7678ba9:
    "Не стоило звать Клео в зал игровых автоматов."

# ch/kleio/date.rpy:191
translate russian kleio_date_play_arcade_intro_male_1a106239:
    "Но другая часть хочет дать ей отпор."

# ch/kleio/date.rpy:192
translate russian kleio_date_play_arcade_intro_male_773ce6a4:
    "Та, которой на самом деле нравятся наши словесные перепалки."

# ch/kleio/date.rpy:193
translate russian kleio_date_play_arcade_intro_male_9cefc87a:
    "Да и доказать её неправоту было бы приятно."

# ch/kleio/date.rpy:194
translate russian kleio_date_play_arcade_intro_male_6aab5463:
    mike.say "Это не отстой, Клео."

# ch/kleio/date.rpy:195
translate russian kleio_date_play_arcade_intro_male_1bb1ec75:
    mike.say "Вокруг нас классические игры."

# ch/kleio/date.rpy:196
translate russian kleio_date_play_arcade_intro_male_a452f292:
    mike.say "На любой вкус."

# ch/kleio/date.rpy:197
translate russian kleio_date_play_arcade_intro_male_8fb53dcb:
    mike.say "Нужно просто попробовать!"

# ch/kleio/date.rpy:198
translate russian kleio_date_play_arcade_intro_male_7d94159e:
    "Клео фыркает и закатывает глаза."

# ch/kleio/date.rpy:199
translate russian kleio_date_play_arcade_intro_male_e9f13a28:
    "А я уже присмотрел подходящий вариант."

# ch/kleio/date.rpy:200
translate russian kleio_date_play_arcade_intro_male_b19b39cf:
    mike.say "Ты же любишь тачки, Клео?"

# ch/kleio/date.rpy:201
translate russian kleio_date_play_arcade_intro_male_2c9877c8:
    mike.say "Как насчёт «Первого места»?"

# ch/kleio/date.rpy:202
translate russian kleio_date_play_arcade_intro_male_ed9e9910:
    mike.say "Настоящая гоночная классика!"

# ch/kleio/date.rpy:203
translate russian kleio_date_play_arcade_intro_male_e861cf47:
    "Клео хмурится, но всё же кивает."

# ch/kleio/date.rpy:204
translate russian kleio_date_play_arcade_intro_male_ee47ef25:
    "Я тут же пользуюсь шансом и закидываю монеты в автомат."

# ch/kleio/date.rpy:208
translate russian kleio_date_play_arcade_win_male_c5314088:
    "Не сомневаюсь, что Клео разбирается в машинах лучше меня."

# ch/kleio/date.rpy:209
translate russian kleio_date_play_arcade_win_male_b89b5bf1:
    "И водит она, наверное, тоже лучше."

# ch/kleio/date.rpy:210
translate russian kleio_date_play_arcade_win_male_203c515e:
    "Только в игре это ей не помогает."

# ch/kleio/date.rpy:211
translate russian kleio_date_play_arcade_win_male_9562dec8:
    kleio.say "У-у..."

# ch/kleio/date.rpy:212
translate russian kleio_date_play_arcade_win_male_f89d5b54:
    kleio.say "У этой хрени дерьмовое управление!"

# ch/kleio/date.rpy:213
translate russian kleio_date_play_arcade_win_male_5915930c:
    kleio.say "Тачка выглядит на миллион баксов."

# ch/kleio/date.rpy:214
translate russian kleio_date_play_arcade_win_male_59d34575:
    kleio.say "А едет как кусок говна!"

# ch/kleio/date.rpy:215
translate russian kleio_date_play_arcade_win_male_e4df486c:
    mike.say "Э-э... Ты сильно отстаёшь, Клео."

# ch/kleio/date.rpy:216
translate russian kleio_date_play_arcade_win_male_adad3e16:
    mike.say "И вообще-то врезаться как раз НЕ НАДО, да?"

# ch/kleio/date.rpy:217
translate russian kleio_date_play_arcade_win_male_188cc32c:
    "Всю игру Клео ворчит и ругается."

# ch/kleio/date.rpy:218
translate russian kleio_date_play_arcade_win_male_13b03b83:
    "К концу она выглядит совершенно измотанной."

# ch/kleio/date.rpy:219
translate russian kleio_date_play_arcade_win_male_a8b6628d:
    "Тяжело дышит, глаза широко раскрыты."

# ch/kleio/date.rpy:220
translate russian kleio_date_play_arcade_win_male_c42fb658:
    "Клянусь, она уже чуть не протёрла дыры в кнопках!"

# ch/kleio/date.rpy:221
translate russian kleio_date_play_arcade_win_male_b630cc53:
    kleio.say "Ну вот, сердцеед."

# ch/kleio/date.rpy:222
translate russian kleio_date_play_arcade_win_male_962713ce:
    kleio.say "Ты выиграл. Ура тебе!"

# ch/kleio/date.rpy:223
translate russian kleio_date_play_arcade_win_male_acb2d359:
    kleio.say "Теперь можно уже уйти?!"

# ch/kleio/date.rpy:224
translate russian kleio_date_play_arcade_win_male_906bac50:
    mike.say "Ладно, Клео..."

# ch/kleio/date.rpy:225
translate russian kleio_date_play_arcade_win_male_9ca133ca:
    mike.say "Займёмся чем-нибудь другим."

# ch/kleio/date.rpy:226
translate russian kleio_date_play_arcade_win_male_4dcae91e:
    mike.say "Может, чем-то, что понизит тебе давление?"

# ch/kleio/date.rpy:230
translate russian kleio_date_play_arcade_lose_male_4322d094:
    "В машинах Клео определённо разбирается лучше меня."

# ch/kleio/date.rpy:231
translate russian kleio_date_play_arcade_lose_male_7ac90f48:
    "Да и за рулём она весьма лиха."

# ch/kleio/date.rpy:232
translate russian kleio_date_play_arcade_lose_male_1970012e:
    "Так что, наверное, не стоит удивляться, как быстро она освоила эту игру."

# ch/kleio/date.rpy:233
translate russian kleio_date_play_arcade_lose_male_cc27b26e:
    "Почти с самого старта я глотаю пыль позади неё."

# ch/kleio/date.rpy:234
translate russian kleio_date_play_arcade_lose_male_7606dc25:
    kleio.say "Ю-ху!"

# ch/kleio/date.rpy:235
translate russian kleio_date_play_arcade_lose_male_3d7e0d31:
    kleio.say "Пока-пока, сердцеед!"

# ch/kleio/date.rpy:236
translate russian kleio_date_play_arcade_lose_male_599b2ace:
    kleio.say "Вот это я жгу резину!"

# ch/kleio/date.rpy:237
translate russian kleio_date_play_arcade_lose_male_61b8c4ce:
    mike.say "Эй... Я... никак не могу..."

# ch/kleio/date.rpy:238
translate russian kleio_date_play_arcade_lose_male_3984ae0a:
    mike.say "Моя машина... Что с ней не так?!"

# ch/kleio/date.rpy:239
translate russian kleio_date_play_arcade_lose_male_8580993d:
    "Всю игру я ворчу и ругаюсь."

# ch/kleio/date.rpy:240
translate russian kleio_date_play_arcade_lose_male_f13dc57f:
    "К концу я совершенно вымотан."

# ch/kleio/date.rpy:241
translate russian kleio_date_play_arcade_lose_male_6add43d6:
    "Сердце колотится, дыхание прерывистое."

# ch/kleio/date.rpy:242
translate russian kleio_date_play_arcade_lose_male_6d9a01f1:
    "Руки приходится буквально отрывать от автомата!"

# ch/kleio/date.rpy:243
translate russian kleio_date_play_arcade_lose_male_b630cc53:
    kleio.say "Ну вот, сердцеед."

# ch/kleio/date.rpy:244
translate russian kleio_date_play_arcade_lose_male_b2937e1c:
    kleio.say "Я обыграла тебя на твоём же поле!"

# ch/kleio/date.rpy:245
translate russian kleio_date_play_arcade_lose_male_9444bd21:
    mike.say "Это точно, Клео."

# ch/kleio/date.rpy:246
translate russian kleio_date_play_arcade_lose_male_fa808db8:
    mike.say "Ну что, теперь пойдём куда-нибудь ещё?"

# ch/kleio/date.rpy:247
translate russian kleio_date_play_arcade_lose_male_57d4d376:
    kleio.say "Ни хрена!"

# ch/kleio/date.rpy:248
translate russian kleio_date_play_arcade_lose_male_9a445900:
    kleio.say "Хочу ещё раунд!"

# ch/kleio/date.rpy:249
translate russian kleio_date_play_arcade_lose_male_282e6e32:
    mike.say "Погоди, Клео..."

# ch/kleio/date.rpy:250
translate russian kleio_date_play_arcade_lose_male_9ce80906:
    mike.say "Не знаю, выдержит ли моё сердце!"

# ch/kleio/date.rpy:258
translate russian kleio_dick_reactions_426c1b98:
    kleio.say "А-ха!"

# ch/kleio/date.rpy:259
translate russian kleio_dick_reactions_883bdcc0:
    kleio.say "Всегда говорила, что ты большой хер!"

# ch/kleio/date.rpy:260
translate russian kleio_dick_reactions_21c8a8ed:
    mike.say "Ну спасибо, Клео!"

# ch/kleio/date.rpy:261
translate russian kleio_dick_reactions_673e8cf8:
    kleio.say "Да ладно, сердцеед, не дуйся."

# ch/kleio/date.rpy:263
translate russian kleio_dick_reactions_e8ba6b82:
    kleio.say "Иди лучше поблагодари меня этой штукой!"

# ch/kleio/date.rpy:267
translate russian kleio_dick_reactions_dad8a31a:
    kleio.say "Беру свои слова назад, сердцеед."

# ch/kleio/date.rpy:268
translate russian kleio_dick_reactions_e5455161:
    kleio.say "Ты маленький хер, а не большой!"

# ch/kleio/date.rpy:269
translate russian kleio_dick_reactions_200eb25b:
    mike.say "Эй!"

# ch/kleio/date.rpy:270
translate russian kleio_dick_reactions_8a9f0130:
    kleio.say "Что, не нравится?"

# ch/kleio/date.rpy:272
translate russian kleio_dick_reactions_70bca235:
    kleio.say "Тогда покажи, на что эта штука способна!"

# ch/kleio/date.rpy:279
translate russian kleio_halloween_invitation_89648308:
    "Как только мы решили устроить вечеринку на Хэллоуин у меня дома, я уже знал, кого позову."

# ch/kleio/date.rpy:280
translate russian kleio_halloween_invitation_da18809d:
    "Есть только одна девушка, которую я хочу пригласить как свою спутницу."

# ch/kleio/date.rpy:281
translate russian kleio_halloween_invitation_81f0c8b0:
    "И это Клео."

# ch/kleio/date.rpy:282
translate russian kleio_halloween_invitation_e4cee930:
    "С её колючим юмором вечер точно будет весёлым."

# ch/kleio/date.rpy:283
translate russian kleio_halloween_invitation_932c8058:
    "И я уверен: в милом хэллоуинском костюме она будет чертовски горяча!"

# ch/kleio/date.rpy:284
translate russian kleio_halloween_invitation_bf633ceb:
    "Нужно лишь осторожно подать ей эту идею."

# ch/kleio/date.rpy:285
translate russian kleio_halloween_invitation_f715e891:
    "Меньше всего хочется, чтобы она решила, будто я выставляю её напоказ."

# ch/kleio/date.rpy:286
translate russian kleio_halloween_invitation_814b9933:
    "Конечно, Клео никогда не стеснялась зрителей."

# ch/kleio/date.rpy:287
translate russian kleio_halloween_invitation_e4592c6c:
    "Но я знаю, что она любит сама диктовать условия."

# ch/kleio/date.rpy:288
translate russian kleio_halloween_invitation_7db6571e:
    "Если решит, что я ею пользуюсь, придёт в ярость!"

# ch/kleio/date.rpy:289
translate russian kleio_halloween_invitation_4920aa65:
    "Надо представить всё как возможность просто повеселиться."

# ch/kleio/date.rpy:290
translate russian kleio_halloween_invitation_647913e6:
    mike.say "Привет, Клео..."

# ch/kleio/date.rpy:291
translate russian kleio_halloween_invitation_b220245e:
    mike.say "Мы с [bree.name] и Сашей устраиваем вечеринку на Хэллоуин."

# ch/kleio/date.rpy:293
translate russian kleio_halloween_invitation_afbe9423:
    kleio.say "Хм..."

# ch/kleio/date.rpy:294
translate russian kleio_halloween_invitation_4c70030d:
    kleio.say "Правда?"

# ch/kleio/date.rpy:295
translate russian kleio_halloween_invitation_f5fc2251:
    "Чёрт, не на такой ответ я рассчитывал!"

# ch/kleio/date.rpy:296
translate russian kleio_halloween_invitation_7d963bd7:
    "Ожидал большего энтузиазма."

# ch/kleio/date.rpy:297
translate russian kleio_halloween_invitation_847fad60:
    mike.say "Да, точно."

# ch/kleio/date.rpy:298
translate russian kleio_halloween_invitation_75ec9ed5:
    mike.say "И я подумал: может, ты хочешь прийти?"

# ch/kleio/date.rpy:299
translate russian kleio_halloween_invitation_f38d0c55:
    mike.say "Ну... Со мной, вроде как на свидание?"

# ch/kleio/date.rpy:300
translate russian kleio_halloween_invitation_de4b74ef:
    "Клео склоняет голову набок."

# ch/kleio/date.rpy:301
translate russian kleio_halloween_invitation_4698e9cd:
    "По её лицу расползается кривая улыбка."

# ch/kleio/date.rpy:303
translate russian kleio_halloween_invitation_34bf5163:
    kleio.say "А, понятно."

# ch/kleio/date.rpy:304
translate russian kleio_halloween_invitation_8388d190:
    kleio.say "И это случайно не костюмированная вечеринка?"

# ch/kleio/date.rpy:305
translate russian kleio_halloween_invitation_30e74fc5:
    mike.say "Эм..."

# ch/kleio/date.rpy:306
translate russian kleio_halloween_invitation_3a453ef2:
    mike.say "Кажется, про костюмы что-то говорили... Да."

# ch/kleio/date.rpy:307
translate russian kleio_halloween_invitation_9861bd59:
    kleio.say "И у тебя уже нарисовалась картинка в голове, да, сердцеед?"

# ch/kleio/date.rpy:308
translate russian kleio_halloween_invitation_1bc5f5f7:
    kleio.say "Может, представляешь меня в каком-нибудь особенном костюмчике, а?"

# ch/kleio/date.rpy:309
translate russian kleio_halloween_invitation_506c89b8:
    mike.say "Я... я..."

# ch/kleio/date.rpy:313
translate russian kleio_halloween_invitation_197ca6dd:
    "Клео качает головой и заливисто смеётся."

# ch/kleio/date.rpy:314
translate russian kleio_halloween_invitation_1c5bfd7e:
    kleio.say "Ладно, сердцеед."

# ch/kleio/date.rpy:315
translate russian kleio_halloween_invitation_d1d58fae:
    kleio.say "Раз ты так хочешь, приду на вечеринку."

# ch/kleio/date.rpy:316
translate russian kleio_halloween_invitation_315b8ba7:
    mike.say "Правда?"

# ch/kleio/date.rpy:317
translate russian kleio_halloween_invitation_65225424:
    mike.say "Отличная новость, Клео."

# ch/kleio/date.rpy:318
translate russian kleio_halloween_invitation_e4cec0dc:
    mike.say "Обещаю, тебе будет весело!"

# ch/kleio/date.rpy:320
translate russian kleio_halloween_invitation_5f6cd3eb:
    "Клео тут же меня останавливает."

# ch/kleio/date.rpy:321
translate russian kleio_halloween_invitation_5440730f:
    "Поднимает ладонь и снова качает головой."

# ch/kleio/date.rpy:322
translate russian kleio_halloween_invitation_4e493689:
    kleio.say "Эй!"

# ch/kleio/date.rpy:323
translate russian kleio_halloween_invitation_68285e7b:
    kleio.say "Притормози, сердцеед."

# ch/kleio/date.rpy:324
translate russian kleio_halloween_invitation_5463ce70:
    kleio.say "Есть одно условие."

# ch/kleio/date.rpy:325
translate russian kleio_halloween_invitation_0abba6a2:
    "Мой восторг сразу немного угасает."

# ch/kleio/date.rpy:326
translate russian kleio_halloween_invitation_a3d8f470:
    "О чём она, чёрт возьми?"

# ch/kleio/date.rpy:327
translate russian kleio_halloween_invitation_c579e323:
    kleio.say "Хочешь увидеть меня в милом костюмчике, да?"

# ch/kleio/date.rpy:328
translate russian kleio_halloween_invitation_e4cab34a:
    mike.say "Эм... Да, Клео."

# ch/kleio/date.rpy:329
translate russian kleio_halloween_invitation_999c68ba:
    mike.say "То есть... если ты сама захочешь его надеть."

# ch/kleio/date.rpy:330
translate russian kleio_halloween_invitation_a471a091:
    kleio.say "Ладно, тогда уговор такой."

# ch/kleio/date.rpy:331
translate russian kleio_halloween_invitation_989f7a60:
    kleio.say "Ты тоже должен нарядиться."

# ch/kleio/date.rpy:332
translate russian kleio_halloween_invitation_3b1d86d0:
    kleio.say "И я не про дурацкую маску или раскрашенную рожу."

# ch/kleio/date.rpy:333
translate russian kleio_halloween_invitation_59bc409a:
    kleio.say "Постарайся как следует."

# ch/kleio/date.rpy:335
translate russian kleio_halloween_invitation_96458d86:
    kleio.say "Иначе я просто развернусь и уйду!"

# ch/kleio/date.rpy:336
translate russian kleio_halloween_invitation_a77b71a0:
    mike.say "Конечно, Клео."

# ch/kleio/date.rpy:337
translate russian kleio_halloween_invitation_1ebe68e2:
    mike.say "Как скажешь!"

# ch/kleio/date.rpy:339
translate russian kleio_halloween_invitation_42e2aa5b:
    "Господи, во что я ввязался?"

# ch/kleio/date.rpy:342
translate russian kleio_halloween_invitation_5fb63261:
    "Клео заливисто смеётся и качает головой."

# ch/kleio/date.rpy:343
translate russian kleio_halloween_invitation_7f8e19dd:
    kleio.say "Ну блядь, сердцеед!"

# ch/kleio/date.rpy:344
translate russian kleio_halloween_invitation_6da8a5d4:
    kleio.say "Ты бы ещё очевиднее намекнул!"

# ch/kleio/date.rpy:345
translate russian kleio_halloween_invitation_cb9fc657:
    kleio.say "Знаешь же, мне нравится, когда ты на меня смотришь."

# ch/kleio/date.rpy:347
translate russian kleio_halloween_invitation_cbd8ab81:
    kleio.say "Но рядиться шлюхой ради дома, набитого похотливыми мудаками, я не буду!"

# ch/kleio/date.rpy:348
translate russian kleio_halloween_invitation_75a39e1a:
    "Я киваю, стараясь скрыть разочарование."

# ch/kleio/date.rpy:349
translate russian kleio_halloween_invitation_77aafbf9:
    "И смущение от того, как легко меня раскусили."

# ch/kleio/date.rpy:350
translate russian kleio_halloween_invitation_063b2305:
    mike.say "Прости, Клео."

# ch/kleio/date.rpy:351
translate russian kleio_halloween_invitation_52817abf:
    mike.say "Наверное, я просто не подумал..."

# ch/kleio/date.rpy:353
translate russian kleio_halloween_invitation_e48a54ef:
    kleio.say "Ну не кисни, сердцеед."

# ch/kleio/date.rpy:354
translate russian kleio_halloween_invitation_4fac2e73:
    kleio.say "Я на тебя не злюсь."

# ch/kleio/date.rpy:355
translate russian kleio_halloween_invitation_803b3352:
    kleio.say "Просто думаю, что в клубе нам было бы веселее."

# ch/kleio/date.rpy:356
translate russian kleio_halloween_invitation_33e4d6d2:
    kleio.say "Только тебе и мне, понимаешь?"

# ch/kleio/date.rpy:357
translate russian kleio_halloween_invitation_240ecfd2:
    mike.say "Предлагаешь бросить вечеринку?"

# ch/kleio/date.rpy:358
translate russian kleio_halloween_invitation_021de14c:
    kleio.say "Да, сердцеед."

# ch/kleio/date.rpy:360
translate russian kleio_halloween_invitation_b444f447:
    kleio.say "Будем всю ночь танцевать, тесно прижавшись друг к другу."

# ch/kleio/date.rpy:361
translate russian kleio_halloween_invitation_621d07a2:
    kleio.say "А потом заставим друг друга кричать."

# ch/kleio/date.rpy:362
translate russian kleio_halloween_invitation_2786b990:
    kleio.say "Если понимаешь, о чём я."

# ch/kleio/date.rpy:363
translate russian kleio_halloween_invitation_131eac07:
    "Я киваю: звучит это весьма заманчиво."

# ch/kleio/date.rpy:364
translate russian kleio_halloween_invitation_f26a6575:
    mike.say "Я... подумаю, Клео."

# ch/kleio/date.rpy:366
translate russian kleio_halloween_invitation_44129972:
    kleio.say "Только не думай слишком долго, сердцеед."

# ch/kleio/date.rpy:367
translate russian kleio_halloween_invitation_74746c93:
    kleio.say "А то я ещё передумаю!"

# ch/kleio/date.rpy:372
translate russian kleio_halloween_arrival_26a0215a:
    "Открывая дверь, мне, пожалуй, следовало быть осторожнее."

# ch/kleio/date.rpy:373
translate russian kleio_halloween_arrival_6bb9ae1f:
    "Особенно после происшествий с мечом Джека и трезубцем Скотти."

# ch/kleio/date.rpy:374
translate russian kleio_halloween_arrival_2b6f4443:
    "Но меня снова застают врасплох: прямо на меня летит огромная колотушка."

# ch/kleio/date.rpy:375
translate russian kleio_halloween_arrival_cc0cc5bc:
    mike.say "БЛЯДЬ!"

# ch/kleio/date.rpy:376
translate russian kleio_halloween_arrival_160ab969:
    mike.say "Это ещё какого хрена?!"

# ch/kleio/date.rpy:377
translate russian kleio_halloween_arrival_e370bcff:
    "Я отшатываюсь и чуть не вваливаюсь обратно в дверной проём."

# ch/kleio/date.rpy:378
translate russian kleio_halloween_arrival_86e9227c:
    "И всё-таки плюхаюсь на задницу."

# ch/kleio/date.rpy:380
translate russian kleio_halloween_arrival_ae797ed1:
    "Тут и замечаю стоящую надо мной Клео."

# ch/kleio/date.rpy:381
translate russian kleio_halloween_arrival_e0136f06:
    "Колотушка закинута на плечо, на лице безумная ухмылка."

# ch/kleio/date.rpy:382
translate russian kleio_halloween_arrival_b3367716:
    "Всё становится понятно, когда я узнаю её костюм."

# ch/kleio/date.rpy:383
translate russian kleio_halloween_arrival_b0592cc2:
    mike.say "Ч... Чарли Куин?!"

# ch/kleio/date.rpy:385
translate russian kleio_halloween_arrival_a0af7717:
    kleio.say "Ага, это я!"

# ch/kleio/date.rpy:386
translate russian kleio_halloween_arrival_37ed10c1:
    kleio.say "Ну как тебе, пупсик?"

# ch/kleio/date.rpy:389
translate russian kleio_halloween_arrival_bcee6a08:
    "Наверное, стоило бы сильнее злиться на то, что я сижу на заднице."

# ch/kleio/date.rpy:390
translate russian kleio_halloween_arrival_12e7c82f:
    "Но я могу думать лишь о том, как потрясающе Клео выглядит в костюме."

# ch/kleio/date.rpy:391
translate russian kleio_halloween_arrival_de8823c8:
    "Идеальная Чарли Куин, вплоть до безумной улыбки!"

# ch/kleio/date.rpy:392
translate russian kleio_halloween_arrival_0b85c0fb:
    mike.say "Е... если безумие выглядит так..."

# ch/kleio/date.rpy:393
translate russian kleio_halloween_arrival_b6eda92e:
    mike.say "Хочу в одну мягкую палату с ним!"

# ch/kleio/date.rpy:396
translate russian kleio_halloween_arrival_a565c46c:
    "Клео пытается не выходить из образа."

# ch/kleio/date.rpy:397
translate russian kleio_halloween_arrival_c1beae3d:
    "Но её улыбка вдруг становится искренней и почти застенчивой."

# ch/kleio/date.rpy:398
translate russian kleio_halloween_arrival_e79b35aa:
    kleio.say "Ты..."

# ch/kleio/date.rpy:399
translate russian kleio_halloween_arrival_6f645d78:
    kleio.say "Ты правда так думаешь, пупсик?"

# ch/kleio/date.rpy:400
translate russian kleio_halloween_arrival_d0f1407c:
    kleio.say "То есть... сердцеед?"

# ch/kleio/date.rpy:401
translate russian kleio_halloween_arrival_813e5ccc:
    "Я киваю с нескрываемым восторгом."

# ch/kleio/date.rpy:402
translate russian kleio_halloween_arrival_7949c811:
    mike.say "Ты выглядишь горячо, Клео."

# ch/kleio/date.rpy:403
translate russian kleio_halloween_arrival_582f2add:
    mike.say "Безумно тоже, но безумно горячо!"

# ch/kleio/date.rpy:404
translate russian kleio_halloween_arrival_7eae06d9:
    kleio.say "Приму это за комплимент."

# ch/kleio/date.rpy:406
translate russian kleio_halloween_arrival_c2b3eddb:
    "Она снова закидывает колотушку на плечо."

# ch/kleio/date.rpy:407
translate russian kleio_halloween_arrival_a545436c:
    kleio.say "Пойдём, пупсик."

# ch/kleio/date.rpy:409
translate russian kleio_halloween_arrival_6a1b9c19:
    kleio.say "Пусть вечеринка пройдёт с огоньком!"

# ch/kleio/date.rpy:411
translate russian kleio_halloween_arrival_e114c968:
    mike.say "Очень мило, Клео."

# ch/kleio/date.rpy:412
translate russian kleio_halloween_arrival_2ce71b3d:
    mike.say "По крайней мере, было бы мило, не сиди я сейчас на заднице!"

# ch/kleio/date.rpy:414
translate russian kleio_halloween_arrival_be8c3e39:
    "Клео хмурится, глядя на меня сверху вниз."

# ch/kleio/date.rpy:415
translate russian kleio_halloween_arrival_09e6dace:
    kleio.say "Эй, не будь таким трусишкой!"

# ch/kleio/date.rpy:417
translate russian kleio_halloween_arrival_310bc803:
    kleio.say "Хэллоуин всё-таки."

# ch/kleio/date.rpy:418
translate russian kleio_halloween_arrival_68ec4185:
    kleio.say "На Хэллоуин положено пугать людей!"

# ch/kleio/date.rpy:419
translate russian kleio_halloween_arrival_c6ac62f3:
    "Я поднимаюсь, качая головой."

# ch/kleio/date.rpy:420
translate russian kleio_halloween_arrival_796c8234:
    "Конечно, для вечеринки стоило бы быть в настроении получше."

# ch/kleio/date.rpy:421
translate russian kleio_halloween_arrival_12d4a292:
    "Но три человека подряд?"

# ch/kleio/date.rpy:422
translate russian kleio_halloween_arrival_89543e29:
    "И все размахивают оружием у меня перед лицом?"

# ch/kleio/date.rpy:423
translate russian kleio_halloween_arrival_84dec06c:
    "Пусть последняя и моя спутница, это всё равно бесит."

# ch/kleio/date.rpy:424
translate russian kleio_halloween_arrival_f1d8a63c:
    mike.say "Эм..."

# ch/kleio/date.rpy:425
translate russian kleio_halloween_arrival_18bda3c3:
    mike.say "Может, оставим биту в прихожей, Клео?"

# ch/kleio/date.rpy:426
translate russian kleio_halloween_arrival_ada494cd:
    mike.say "Тогда больше никто не пострадает!"

# ch/kleio/date.rpy:429
translate russian kleio_halloween_arrival_2c0d0b79:
    "Клео показывает мне язык."

# ch/kleio/date.rpy:430
translate russian kleio_halloween_arrival_57b073d1:
    "Но всё же делает, как я прошу."

# ch/kleio/date.rpy:431
translate russian kleio_halloween_arrival_f9314902:
    kleio.say "Ну-у..."

# ch/kleio/date.rpy:432
translate russian kleio_halloween_arrival_3489bed6:
    kleio.say "Зануда!"

# ch/kleio/date.rpy:441
translate russian kleio_halloween_party_3038b871:
    kleio.say "Ха..."

# ch/kleio/date.rpy:442
translate russian kleio_halloween_party_4384df2e:
    kleio.say "Как мило!"

# ch/kleio/date.rpy:443
translate russian kleio_halloween_party_89bc9b1d:
    "Я поворачиваюсь посмотреть, о чём говорит Клео."

# ch/kleio/date.rpy:446
translate russian kleio_halloween_party_a6486487:
    "Она указывает на костюм [bree.name]."

# ch/kleio/date.rpy:448
translate russian kleio_halloween_party_078d485a:
    bree.say "А?.."

# ch/kleio/date.rpy:449
translate russian kleio_halloween_party_075123f1:
    bree.say "Что-то не так?"

# ch/kleio/date.rpy:450
translate russian kleio_halloween_party_9bf935fe:
    kleio.say "Милый костюмчик, блондиночка."

# ch/kleio/date.rpy:451
translate russian kleio_halloween_party_f533e161:
    kleio.say "Кого изображаешь?"

# ch/kleio/date.rpy:452
translate russian kleio_halloween_party_9a8fa456:
    kleio.say "Барби-автомеханика?"

# ch/kleio/date.rpy:454
translate russian kleio_halloween_party_d79e1e50:
    "Щёки [bree.name] вспыхивают."

# ch/kleio/date.rpy:455
translate russian kleio_halloween_party_1dd31c83:
    "Но я замечаю и то, как она сжимает кулаки."

# ch/kleio/date.rpy:456
translate russian kleio_halloween_party_8b28519f:
    "Надо вмешаться. Быстро."

# ch/kleio/date.rpy:457
translate russian kleio_halloween_party_6f3382b3:
    "Пока всё не вышло из-под контроля!"

# ch/kleio/date.rpy:460
translate russian kleio_halloween_party_f1d8a63c:
    mike.say "Эм..."

# ch/kleio/date.rpy:461
translate russian kleio_halloween_party_31f4f2f6:
    mike.say "Клео просто шутит, [bree.name]!"

# ch/kleio/date.rpy:463
translate russian kleio_halloween_party_abf32d1f:
    kleio.say "Да ну? Правда, что ли?!"

# ch/kleio/date.rpy:464
translate russian kleio_halloween_party_dd3ff199:
    mike.say "Да, Клео, конечно шутит!"

# ch/kleio/date.rpy:465
translate russian kleio_halloween_party_30b6729f:
    bree.say "Не очень-то смешно!"

# ch/kleio/date.rpy:467
translate russian kleio_halloween_party_607a1ae9:
    mike.say "Слушай, [bree.name], Клео работает автомехаником."

# ch/kleio/date.rpy:468
translate russian kleio_halloween_party_2734c698:
    mike.say "Уверен, её просто позабавил твой костюм."

# ch/kleio/date.rpy:469
translate russian kleio_halloween_party_c58cfb7e:
    "[bree.name] подозрительно щурится."

# ch/kleio/date.rpy:471
translate russian kleio_halloween_party_c39fdc87:
    "Но затем кивает."

# ch/kleio/date.rpy:472
translate russian kleio_halloween_party_07b36fb7:
    bree.say "Ладно, [lssb_kleio.hero_name()], я тебе верю."

# ch/kleio/date.rpy:476
translate russian kleio_halloween_party_eb72730a:
    "Она поворачивается к нам спиной и уходит."

# ch/kleio/date.rpy:477
translate russian kleio_halloween_party_a72e0c27:
    "Наконец-то можно выдохнуть."

# ch/kleio/date.rpy:480
translate russian kleio_halloween_party_fbcfd0cb:
    kleio.say "Ловко выкрутился, сердцеед!"

# ch/kleio/date.rpy:482
translate russian kleio_halloween_party_f805e4ea:
    mike.say "Клео, да отстань уже!"

# ch/kleio/date.rpy:483
translate russian kleio_halloween_party_61cf83eb:
    mike.say "Это просто костюм."

# ch/kleio/date.rpy:484
translate russian kleio_halloween_party_9954ebef:
    mike.say "Да, [bree.name] одета так, как ты на работе."

# ch/kleio/date.rpy:485
translate russian kleio_halloween_party_325cdcd2:
    mike.say "Но ты автомеханик, а не спецназовец!"

# ch/kleio/date.rpy:490
translate russian kleio_halloween_party_506d724b:
    "[bree.name] улыбается, довольная тем, что я за неё заступился."

# ch/kleio/date.rpy:491
translate russian kleio_halloween_party_4517965e:
    "А Клео фыркает и качает головой."

# ch/kleio/date.rpy:492
translate russian kleio_halloween_party_b2e55bb5:
    kleio.say "Господи, сердцеед."

# ch/kleio/date.rpy:493
translate russian kleio_halloween_party_99c4b9a7:
    kleio.say "Какой рыцарь в сияющих доспехах для блондиночки!"

# ch/kleio/date.rpy:494
translate russian kleio_halloween_party_1d5deadc:
    kleio.say "Ты вообще-то со МНОЙ сюда пришёл, не забыл?"

# ch/kleio/date.rpy:496
translate russian kleio_halloween_party_f4dd2406:
    mike.say "Конечно с тобой, Клео."

# ch/kleio/date.rpy:497
translate russian kleio_halloween_party_6e7ad7b9:
    mike.say "Но ты сейчас вела себя по-свински!"

# ch/kleio/date.rpy:498
translate russian kleio_halloween_party_c2989c7a:
    "Клео снова фыркает и закатывает глаза."

# ch/kleio/date.rpy:499
translate russian kleio_halloween_party_39ea5e1e:
    "Ей явно не нравится, что я защищаю [bree.name]."

# ch/kleio/date.rpy:508
translate russian kleio_halloween_dance_4b7e8df1:
    "Вообще-то ничего особенного."

# ch/kleio/date.rpy:509
translate russian kleio_halloween_dance_748d1647:
    "Мы на вечеринке, играет музыка."

# ch/kleio/date.rpy:510
translate russian kleio_halloween_dance_7ebfe540:
    "Рано или поздно кто-то предложит потанцевать."

# ch/kleio/date.rpy:511
translate russian kleio_halloween_dance_29081aba:
    "Но я всё равно немного нервничаю, собираясь пригласить Клео!"

# ch/kleio/date.rpy:512
translate russian kleio_halloween_dance_9cb7345a:
    "Она такая колючая и независимая."

# ch/kleio/date.rpy:513
translate russian kleio_halloween_dance_cd8ce8e7:
    "Боюсь, вдруг сочтёт это сексизмом или ещё чем-нибудь."

# ch/kleio/date.rpy:515
translate russian kleio_halloween_dance_4014166a:
    kleio.say "Эй, сердцеед!"

# ch/kleio/date.rpy:516
translate russian kleio_halloween_dance_91e95b3a:
    mike.say "Эм..."

# ch/kleio/date.rpy:517
translate russian kleio_halloween_dance_f6c3c5e0:
    mike.say "Да, Клео?"

# ch/kleio/date.rpy:518
translate russian kleio_halloween_dance_4ef98979:
    kleio.say "Пойдём уже танцевать!"

# ch/kleio/date.rpy:521
translate russian kleio_halloween_dance_91f6e4d6:
    "Я чуть не говорю ей что-то."

# ch/kleio/date.rpy:522
translate russian kleio_halloween_dance_508b7d30:
    "Словно собираюсь пожаловаться, что хотел пригласить её сам."

# ch/kleio/date.rpy:523
translate russian kleio_halloween_dance_2697ecf6:
    "Но затем понимаю, какая это глупость."

# ch/kleio/date.rpy:524
translate russian kleio_halloween_dance_65ea6a6c:
    "Зачем я, чёрт возьми, всё усложняю?"

# ch/kleio/date.rpy:525
translate russian kleio_halloween_dance_4062250e:
    "Какая разница, кто кого пригласил?"

# ch/kleio/date.rpy:527
translate russian kleio_halloween_dance_2f76bc50:
    mike.say "П... погоди, Клео."

# ch/kleio/date.rpy:529
translate russian kleio_halloween_dance_82dca905:
    mike.say "Я иду!"

# ch/kleio/date.rpy:531
translate russian kleio_halloween_dance_b7f4fab8:
    "Клео выбрала классический панк-гимн."

# ch/kleio/date.rpy:532
translate russian kleio_halloween_dance_1f3e3964:
    "Так что о медленном танце и речи нет."

# ch/kleio/date.rpy:533
translate russian kleio_halloween_dance_03cadca7:
    "Но её энергии достаточно, чтобы меня загипнотизировать."

# ch/kleio/date.rpy:534
translate russian kleio_halloween_dance_2d45273c:
    "Мне остаётся лишь следовать за ней, стараясь не отставать."

# ch/kleio/date.rpy:535
translate russian kleio_halloween_dance_826906f4:
    "И я не знаю, от чего сильнее задыхаюсь."

# ch/kleio/date.rpy:536
translate russian kleio_halloween_dance_31376125:
    "От её темпа или от вида её движущегося тела!"

# ch/kleio/date.rpy:537
translate russian kleio_halloween_dance_7c204910:
    "Касается меня она только после танца."

# ch/kleio/date.rpy:538
translate russian kleio_halloween_dance_67545e2d:
    "Когда буквально падает мне в объятия."

# ch/kleio/date.rpy:539
translate russian kleio_halloween_dance_c315c458:
    "Тяжело дышит, совершенно вымотанная."

# ch/kleio/date.rpy:540
translate russian kleio_halloween_dance_104980ce:
    "Я чувствую её мокрую от пота кожу."

# ch/kleio/date.rpy:541
translate russian kleio_halloween_dance_84f981a3:
    "Её грудь вздымается и прижимается ко мне."

# ch/kleio/date.rpy:542
translate russian kleio_halloween_dance_eb153adb:
    "Кажется, никогда ещё я не хотел её так сильно."

# ch/kleio/date.rpy:544
translate russian kleio_halloween_dance_59d389e5:
    mike.say "Ну, Клео!"

# ch/kleio/date.rpy:545
translate russian kleio_halloween_dance_568e0393:
    mike.say "Я ведь собирался сам пригласить тебя на танец!"

# ch/kleio/date.rpy:547
translate russian kleio_halloween_dance_7062e4e4:
    "Клео качает головой."

# ch/kleio/date.rpy:549
translate russian kleio_halloween_dance_b99977cc:
    "Вижу, что ей весело."

# ch/kleio/date.rpy:550
translate russian kleio_halloween_dance_d3c72122:
    kleio.say "Упс!"

# ch/kleio/date.rpy:551
translate russian kleio_halloween_dance_f77eebd7:
    kleio.say "Задела твоё мужское самолюбие?"

# ch/kleio/date.rpy:552
translate russian kleio_halloween_dance_b535c037:
    mike.say "Эй, это не смешно!"

# ch/kleio/date.rpy:555
translate russian kleio_halloween_dance_4662505c:
    "Клео закатывает глаза и усмехается."

# ch/kleio/date.rpy:556
translate russian kleio_halloween_dance_6fb543f1:
    kleio.say "Знаешь что, сердцеед? Давай как-нибудь в другой раз."

# ch/kleio/date.rpy:557
translate russian kleio_halloween_dance_7e76b451:
    kleio.say "Не хочу окончательно тебя покалечить!"

# ch/kleio/date.rpy:559
translate russian kleio_halloween_dance_6dd59a5f:
    "Не знаю, что хуже."

# ch/kleio/date.rpy:560
translate russian kleio_halloween_dance_f3dae5b7:
    "Понимать, что упустил возможность потанцевать с Клео."

# ch/kleio/date.rpy:561
translate russian kleio_halloween_dance_9dad6199:
    "Или терпеть колкости, которые заодно получил."

# ch/kleio/date.rpy:570
translate russian kleio_halloween_sex_79bd2ca5:
    "Вечеринка понемногу затихает, в доме стало гораздо тише."

# ch/kleio/date.rpy:571
translate russian kleio_halloween_sex_a34ba328:
    "Почти все устали, опьянели или и то и другое. Хочется просто расслабиться."

# ch/kleio/date.rpy:572
translate russian kleio_halloween_sex_fda010b1:
    "Но по лицу Клео видно, что она настроена иначе."

# ch/kleio/date.rpy:576
translate russian kleio_halloween_sex_e766f29f:
    "Мы наверху, и она ведёт меня к моей спальне."

# ch/kleio/date.rpy:577
translate russian kleio_halloween_sex_ec3dd71e:
    kleio.say "Пойдём, пупсик."

# ch/kleio/date.rpy:579
translate russian kleio_halloween_sex_9a66f8c7:
    kleio.say "Повеселимся наедине!"

# ch/kleio/date.rpy:580
translate russian kleio_halloween_sex_a77b71a0:
    mike.say "Конечно, Клео."

# ch/kleio/date.rpy:581
translate russian kleio_halloween_sex_f916dbad:
    mike.say "Отличная идея!"

# ch/kleio/date.rpy:583
translate russian kleio_halloween_sex_36a74b9e:
    "Клео ухмыляется мне, и грим делает ухмылку ещё выразительнее."

# ch/kleio/date.rpy:584
translate russian kleio_halloween_sex_9ee9effb:
    "Странно, конечно, но в этом безумии есть своя сексуальность."

# ch/kleio/date.rpy:585
translate russian kleio_halloween_sex_7725c4e8:
    "Я так засматриваюсь на Клео."

# ch/kleio/date.rpy:586
translate russian kleio_halloween_sex_2f1009e2:
    "Что едва замечаю, какую дверь она открывает."

# ch/kleio/date.rpy:587
translate russian kleio_halloween_sex_25c89d6d:
    mike.say "Эм, Клео..."

# ch/kleio/date.rpy:588
translate russian kleio_halloween_sex_003eb1f5:
    mike.say "Ты ведь понимаешь, что это Сашина спальня?"

# ch/kleio/date.rpy:590
translate russian kleio_halloween_sex_406c50e0:
    "Клео лишь ухмыляется ещё шире и смеётся."

# ch/kleio/date.rpy:591
translate russian kleio_halloween_sex_ab0bc61e:
    "Надеюсь, она просто дурачится."

# ch/kleio/date.rpy:592
translate russian kleio_halloween_sex_361893f6:
    "Ну, вживается в образ."

# ch/kleio/date.rpy:593
translate russian kleio_halloween_sex_b4dbd073:
    kleio.say "Конечно понимаю, пупсик."

# ch/kleio/date.rpy:595
translate russian kleio_halloween_sex_b943fef9:
    kleio.say "Но сегодня я Чарли Куин."

# ch/kleio/date.rpy:596
translate russian kleio_halloween_sex_dd892e71:
    kleio.say "Так что буду безумствовать и рисковать!"

# ch/kleio/date.rpy:597
translate russian kleio_halloween_sex_8ee2e187:
    "Клео всё ещё держит меня за запястье."

# ch/kleio/date.rpy:598
translate russian kleio_halloween_sex_f7fd3c35:
    "И теперь тащит в Сашину спальню."

# ch/kleio/date.rpy:599
translate russian kleio_halloween_sex_38057474:
    "Пытаюсь сопротивляться, но она пугающе сильная."

# ch/kleio/date.rpy:600
translate russian kleio_halloween_sex_2e532194:
    mike.say "А... а если Саша нас застукает?"

# ch/kleio/date.rpy:601
translate russian kleio_halloween_sex_9ee66f36:
    mike.say "Клео, ты же знаешь, она взбесится!"

# ch/kleio/date.rpy:602
translate russian kleio_halloween_sex_65322ec3:
    kleio.say "Если войдёт, я разберусь, пупсик."

# ch/kleio/date.rpy:604
translate russian kleio_halloween_sex_6b720d93:
    kleio.say "Пусть либо присоединяется, либо валит к чёрту!"

# ch/kleio/date.rpy:605
translate russian kleio_halloween_sex_7fe040b3:
    kleio.say "Ей решать..."

# ch/kleio/date.rpy:607
translate russian kleio_halloween_sex_54f62a51:
    "Клео продолжает тянуть меня через порог."

# ch/kleio/date.rpy:608
translate russian kleio_halloween_sex_912e1b0f:
    "Поняв, что уговорами её не остановить, меняю тактику."

# ch/kleio/date.rpy:609
translate russian kleio_halloween_sex_26ac9e3b:
    "Резко перестаю сопротивляться, но это выходит мне боком."

# ch/kleio/date.rpy:610
translate russian kleio_halloween_sex_0be90acc:
    "Теперь ничто не мешает Клео добиться своего."

# ch/kleio/date.rpy:615
translate russian kleio_halloween_sex_2da8e322:
    "Мы оба вваливаемся в Сашину комнату, и дверь захлопывается за нами."

# ch/kleio/date.rpy:616
translate russian kleio_halloween_sex_80ad2ca6:
    "Каким-то образом мы оказываемся на кровати, перепутавшись руками и ногами."

# ch/kleio/date.rpy:619
translate russian kleio_halloween_sex_1a631160:
    "Она цепляется за меня и просовывает язык мне в рот."

# ch/kleio/date.rpy:620
translate russian kleio_halloween_sex_68fee20f:
    "Да, я боялся, что Саша нас застукает."

# ch/kleio/date.rpy:621
translate russian kleio_halloween_sex_949d8cf4:
    "Но я всего лишь человек."

# ch/kleio/date.rpy:622
translate russian kleio_halloween_sex_489233a3:
    "А одна мысль о Клео способна чертовски меня завести!"

# ch/kleio/date.rpy:623
translate russian kleio_halloween_sex_5609de44:
    "Не успеваю опомниться, как уже страстно целую Клео."

# ch/kleio/date.rpy:624
translate russian kleio_halloween_sex_e0f30340:
    "И тяну её костюм, пытаясь раздеть догола."

# ch/kleio/date.rpy:625
translate russian kleio_halloween_sex_bbbe3794:
    kleio.say "Ах..."

# ch/kleio/date.rpy:626
translate russian kleio_halloween_sex_08fc9ff8:
    kleio.say "Вот это уже лучше, пупсик."

# ch/kleio/date.rpy:627
translate russian kleio_halloween_sex_cbefa456:
    kleio.say "М-м-м..."

# ch/kleio/date.rpy:628
translate russian kleio_halloween_sex_42bc6bcc:
    kleio.say "Чарли хочет, чтобы ты вошёл в неё!"

# ch/kleio/date.rpy:629
translate russian kleio_halloween_sex_281949bd:
    "Руки и ноги переплетаются, пока мы возимся с пуговицами и молниями."

# ch/kleio/date.rpy:631
translate russian kleio_halloween_sex_4dcc651c:
    "Так что, когда это происходит, мы оба, кажется, не готовы."

# ch/kleio/date.rpy:632
translate russian kleio_halloween_sex_21874c42:
    "Чувствую, как головка члена скользит по чему-то тёплому и влажному."

# ch/kleio/date.rpy:634
translate russian kleio_halloween_sex_ec9e1886:
    "В тот же миг Клео стонет от нетерпеливого желания."

# ch/kleio/date.rpy:635
translate russian kleio_halloween_sex_bbbe3794_1:
    kleio.say "Ах..."

# ch/kleio/date.rpy:637
translate russian kleio_halloween_sex_1f9a232f:
    kleio.say "Пожалуйста..."

# ch/kleio/date.rpy:638
translate russian kleio_halloween_sex_63d173f0:
    "Достаточно одного толчка..."

# ch/kleio/date.rpy:640
translate russian kleio_halloween_sex_6a15d8e0:
    "И я внутри неё."

# ch/kleio/date.rpy:641
translate russian kleio_halloween_sex_d01705dd:
    "Клео обхватывает меня ногами, притягивая на себя."

# ch/kleio/date.rpy:642
translate russian kleio_halloween_sex_7e4d38a3:
    "Не уверен, это я вхожу в неё."

# ch/kleio/date.rpy:643
translate russian kleio_halloween_sex_776b1e57:
    "Или она сама насаживается на меня!"

# ch/kleio/date.rpy:644
translate russian kleio_halloween_sex_511110ad:
    "Как бы то ни было, мы сплелись и отдались страсти."

# ch/kleio/date.rpy:645
translate russian kleio_halloween_sex_9aa822a1:
    "Каким-то образом Клео оказывается почти вверх ногами, прижатая моим весом."

# ch/kleio/date.rpy:646
translate russian kleio_halloween_sex_35a08a5e:
    "На предварительные ласки и неторопливое начало времени нет."

# ch/kleio/date.rpy:648
translate russian kleio_halloween_sex_d933a051:
    "Я двигаюсь в Клео изо всех сил."

# ch/kleio/date.rpy:649
translate russian kleio_halloween_sex_0142583a:
    "А она жадно принимает всё, что я могу ей дать."

# ch/kleio/date.rpy:650
translate russian kleio_halloween_sex_232b373f:
    kleio.say "Да..."

# ch/kleio/date.rpy:651
translate russian kleio_halloween_sex_f91ef269:
    kleio.say "Вот чёрт..."

# ch/kleio/date.rpy:652
translate russian kleio_halloween_sex_942521a9:
    kleio.say "Трахай меня сильнее!"

# ch/kleio/date.rpy:653
translate russian kleio_halloween_sex_8c31e384:
    "Её просьбы едва до меня доходят."

# ch/kleio/date.rpy:654
translate russian kleio_halloween_sex_980c3402:
    "Даже если бы я разобрал слова, сильнее уже не смог бы."

# ch/kleio/date.rpy:655
translate russian kleio_halloween_sex_d3158e91:
    "Сашина кровать и так ходит ходуном и скрипит под нами."

# ch/kleio/date.rpy:656
translate russian kleio_halloween_sex_539af282:
    "Да, я, возможно, смирился с тем, что она может войти в любой момент."

# ch/kleio/date.rpy:657
translate russian kleio_halloween_sex_5088d9bd:
    "Но это не значит, что я сломаю ей кровать ради оргазма Клео!"

# ch/kleio/date.rpy:659
translate russian kleio_halloween_sex_b6470f92:
    "Впрочем, неважно: я уже чувствую, что кончаю."

# ch/kleio/date.rpy:661
translate russian kleio_halloween_sex_7e71171d:
    "Клео цепляется за меня, пока я изливаюсь в неё."

# ch/kleio/date.rpy:663
translate russian kleio_halloween_sex_07dcbaf2:
    "Она тоже кончает, вскрикивая и постанывая."

# ch/kleio/date.rpy:665
translate russian kleio_halloween_sex_45d68de1:
    "Если бы Саша сейчас вошла..."

# ch/kleio/date.rpy:666
translate russian kleio_halloween_sex_0f2f85c9:
    "Что бы она ни сказала, разве это что-то изменило бы?"

# ch/kleio/date.rpy:667
translate russian kleio_halloween_sex_8ac494d9:
    "Ну и пусть бы разозлилась на меня."

# ch/kleio/date.rpy:668
translate russian kleio_halloween_sex_ebbdb66c:
    "Секс с Клео того стоил!"

# ch/kleio/date.rpy:670
translate russian kleio_halloween_sex_cbefa456_1:
    kleio.say "М-м-м..."

# ch/kleio/date.rpy:671
translate russian kleio_halloween_sex_2afea241:
    kleio.say "Люблю тебя, пупсик!"

# ch/kleio/date.rpy:672
translate russian kleio_halloween_sex_66d497bd:
    mike.say "Я тоже тебя люблю, Клео!"

# ch/kleio/events.rpy:677
translate russian kleio_event_01_7bc80586:
    mike.say "Алло?"

# ch/kleio/events.rpy:678
translate russian kleio_event_01_f4c98107:
    kleio.say "Привет. Это Клео."

# ch/kleio/events.rpy:681
translate russian kleio_event_01_baca9c38:
    mike.say "О, привет, Клео. Как дела?"

# ch/kleio/events.rpy:682
translate russian kleio_event_01_f3589644:
    kleio.say "Да ничего. Решила позвонить и узнать, не хочешь ли сходить в торговый центр."

# ch/kleio/events.rpy:683
translate russian kleio_event_01_fe1ea443:
    mike.say "С тобой?"

# ch/kleio/events.rpy:684
translate russian kleio_event_01_91241530:
    kleio.say "Нет, с моей собакой. Конечно со мной."

# ch/kleio/events.rpy:686
translate russian kleio_event_01_8e7c7b7b:
    kleio.say "Когда ты играл для нас, оказалось, что вкус у тебя лучше, чем я думала. А мне нужна компания в магазин пластинок."

# ch/kleio/events.rpy:687
translate russian kleio_event_01_86a53735:
    kleio.say "Идёшь или нет?"

# ch/kleio/events.rpy:689
translate russian kleio_event_01_4bd978ab:
    kleio.say "Судя по всему, музыкальный вкус у тебя лучше, чем можно подумать по виду. А мне нужна компания в магазин пластинок."

# ch/kleio/events.rpy:690
translate russian kleio_event_01_86a53735_1:
    kleio.say "Идёшь или нет?"

# ch/kleio/events.rpy:691
translate russian kleio_event_01_450389e7:
    mike.say "О! Э-э, да. Конечно иду. Где встретимся, или..."

# ch/kleio/events.rpy:694
translate russian kleio_event_01_76d06121:
    mike.say "Клео? Откуда у тебя мой номер?"

# ch/kleio/events.rpy:695
translate russian kleio_event_01_a1b9ed75:
    kleio.say "Это так важно? Господи, чего ты сразу напрягся?"

# ch/kleio/events.rpy:696
translate russian kleio_event_01_746eda96:
    "Кто бы говорил."

# ch/kleio/events.rpy:697
translate russian kleio_event_01_5e642bda:
    mike.say "Неважно, извини. Что ты хотела?"

# ch/kleio/events.rpy:698
translate russian kleio_event_01_f55640e9:
    kleio.say "Мне скучно, Саша на работе, Анна занята. Ты пойдёшь со мной по магазинам или нет?"

# ch/kleio/events.rpy:699
translate russian kleio_event_01_953d02e1:
    "Я колеблюсь. Походы по магазинам — не моё, но упускать шанс пробиться сквозь ледяную оболочку Клео не стоит."

# ch/kleio/events.rpy:700
translate russian kleio_event_01_2f0268f2:
    mike.say "Эм... Ну ладно. Что будем покупать?"

# ch/kleio/events.rpy:701
translate russian kleio_event_01_ad4e1b14:
    kleio.say "Музыку."

# ch/kleio/events.rpy:702
translate russian kleio_event_01_a670f34c:
    mike.say "А. Э-э, тогда ладно."

# ch/kleio/events.rpy:703
translate russian kleio_event_01_4b967fa6:
    kleio.say "Встретимся в торговом центре."

# ch/kleio/events.rpy:704
translate russian kleio_event_01_6bbcf69f:
    mike.say "Я буду."

# ch/kleio/events.rpy:705
translate russian kleio_event_01_c72f3e1d:
    kleio.say "До скорого."

# ch/kleio/events.rpy:706
translate russian kleio_event_01_1116c7d8:
    "Не успеваю опомниться, как Клео уже кладёт трубку."

# ch/kleio/events.rpy:710
translate russian kleio_event_01_3e5c685c:
    "Когда я приезжаю, она ждёт у входа в торговый центр."

# ch/kleio/events.rpy:711
translate russian kleio_event_01_56f1937b:
    kleio.say "Давай, пошли. Музыкальный магазин закрывается в восемь, хочу успеть, пока не опустел."

# ch/kleio/events.rpy:712
translate russian kleio_event_01_76719bad:
    "Пожимаю плечами и иду следом, решив пока не выяснять причину её недовольства."

# ch/kleio/events.rpy:714
translate russian kleio_event_01_b1e922f5:
    "Идём почти молча, обмениваясь лишь короткими фразами. Клео время от времени что-то набирает в телефоне."

# ch/kleio/events.rpy:715
translate russian kleio_event_01_e80d0e41:
    "Набравшись уверенности, решаю спросить."

# ch/kleio/events.rpy:717
translate russian kleio_event_01_47db0eda:
    mike.say "С кем переписываешься?"

# ch/kleio/events.rpy:719
translate russian kleio_event_01_3ea0651c:
    "Она сверлит меня пылающим взглядом, и я тут же понимаю: зря спросил."

# ch/kleio/events.rpy:721
translate russian kleio_event_01_3437f5ae:
    kleio.say "Не твоё дело, мудак. Я позвала тебя по магазинам, а не на допрос о моей личной жизни."

# ch/kleio/events.rpy:722
translate russian kleio_event_01_2334c771:
    "Прежде чем я успеваю ещё раз взглянуть, она прячет телефон в карман."

# ch/kleio/events.rpy:725
translate russian kleio_event_01_5276db88:
    mike.say "В игру играешь?"

# ch/kleio/events.rpy:726
translate russian kleio_event_01_de96ce98:
    "Клео фыркает и прячет телефон, сдерживая смех."

# ch/kleio/events.rpy:727
translate russian kleio_event_01_17762297:
    kleio.say "Мне что, двенадцать? Нет, просто переписываюсь."

# ch/kleio/events.rpy:728
translate russian kleio_event_01_c853cc7d:
    mike.say "С кем? Я этого человека знаю?"

# ch/kleio/events.rpy:730
translate russian kleio_event_01_b5dd89d5:
    kleio.say "Уф. Нет. Не лезь не в своё дело, ладно?"

# ch/kleio/events.rpy:731
translate russian kleio_event_01_436ed395:
    mike.say "А. Ну, я очень советую скачать одну игру. Называется..."

# ch/kleio/events.rpy:732
translate russian kleio_event_01_bf5c5cba:
    kleio.say "Без обид, но мне неинтересно."

# ch/kleio/events.rpy:734
translate russian kleio_event_01_aa7960d7:
    "Несмотря на резкие слова, вижу, что она прячет усмешку."

# ch/kleio/events.rpy:737
translate russian kleio_event_01_f1b62e67:
    mike.say "Что делаешь?"

# ch/kleio/events.rpy:738
translate russian kleio_event_01_64fdfa33:
    "Клео раздражённо поднимает на меня взгляд."

# ch/kleio/events.rpy:740
translate russian kleio_event_01_d53f73de:
    kleio.say "Ничего. Какая разница?"

# ch/kleio/events.rpy:741
translate russian kleio_event_01_fd0e3525:
    mike.say "Просто любопытно, ничего такого. По тому, как ты печатала, показалось, что что-то важное."

# ch/kleio/events.rpy:742
translate russian kleio_event_01_b54edd34:
    kleio.say "Ничего важного, ясно? Хватит совать нос."

# ch/kleio/events.rpy:743
translate russian kleio_event_01_2334c771_1:
    "Прежде чем я успеваю ещё раз взглянуть, она прячет телефон в карман."

# ch/kleio/events.rpy:745
translate russian kleio_event_01_6fefcc90:
    "Хоть я за неё и переживаю, решаю не спрашивать: это лишь разозлит её."

# ch/kleio/events.rpy:746
translate russian kleio_event_01_26b350e1:
    "Она целеустремлённо ведёт меня за музыкой, лавируя среди покупателей и отделов."

# ch/kleio/events.rpy:748
translate russian kleio_event_01_7b665e50:
    "Я несколько раз чуть не теряю её и догоняю лишь у входа в магазин."

# ch/kleio/events.rpy:749
translate russian kleio_event_01_41eee082:
    kleio.say "Шевелись, тормоз. Мы пришли."

# ch/kleio/events.rpy:750
translate russian kleio_event_01_d885de7a:
    "Сглатываю и иду следом, надеясь, что всё пройдёт хорошо."

# ch/kleio/events.rpy:751
translate russian kleio_event_01_5b0159b2:
    "Не успеваем пробыть в магазине и десяти секунд, как она засыпает меня вопросами."

# ch/kleio/events.rpy:752
translate russian kleio_event_01_4c0042f9:
    kleio.say "Ну что, [lssb_kleio.hero_name()], как думаешь? Эту пластинку или эту?"

# ch/kleio/events.rpy:753
translate russian kleio_event_01_0dcd034c:
    "Она поднимает две пластинки, а я сглатываю. Вот мой шанс проявить себя, но я понятия не имею, угадаю ли."

# ch/kleio/events.rpy:757
translate russian kleio_event_01_ae63f3f6:
    mike.say "Я бы точно взял альбом Майкла Джонсона. С королём поп-музыки ведь не прогадаешь!"

# ch/kleio/events.rpy:758
translate russian kleio_event_01_d8713532:
    "Клео выглядит неуверенно."

# ch/kleio/events.rpy:759
translate russian kleio_event_01_8777d791:
    kleio.say "Ну, наверное. Он крутой и всё такое, не пойми неправильно. Но мне больше нравится гитара."

# ch/kleio/events.rpy:760
translate russian kleio_event_01_b4d10e88:
    "Морщусь. Ну конечно, должен был догадаться. Выбираю-то для Клео, а не для себя. Чёрт."

# ch/kleio/events.rpy:761
translate russian kleio_event_01_c83e5147:
    mike.say "Ты права. Может, тогда другую?"

# ch/kleio/events.rpy:762
translate russian kleio_event_01_18e4af35:
    kleio.say "Да, пожалуй. Пока поверю тебе на слово."

# ch/kleio/events.rpy:763
translate russian kleio_event_01_9a7c0be9:
    "Немного помедлив, она зажимает альбом под мышкой."

# ch/kleio/events.rpy:765
translate russian kleio_event_01_5dd9befe:
    mike.say "Однозначно Metallikea. Тут вообще есть о чём спорить?"

# ch/kleio/events.rpy:766
translate russian kleio_event_01_60643f11:
    "Клео ухмыляется и без колебаний зажимает альбом под мышкой."

# ch/kleio/events.rpy:768
translate russian kleio_event_01_8e2cf742:
    kleio.say "Ещё бы, чувак! Тут даже моя любимая песня — «Повелитель маппетов»."

# ch/kleio/events.rpy:769
translate russian kleio_event_01_b163cc60:
    mike.say "О да, отличная песня. Гитара там просто нереальная."

# ch/kleio/events.rpy:770
translate russian kleio_event_01_05524715:
    kleio.say "Правда же?!"

# ch/kleio/events.rpy:774
translate russian kleio_event_01_9c2faf84:
    kleio.say "Пойдём ещё посмотрим."

# ch/kleio/events.rpy:775
translate russian kleio_event_01_dab3b21c:
    "Бродим по магазину. Клео молча берёт альбомы и изучает их почти как коллекционер."

# ch/kleio/events.rpy:776
translate russian kleio_event_01_bff08143:
    "Несмотря на почти неизменно хмурое лицо, она так красива, когда перебирает пластинки."

# ch/kleio/events.rpy:777
translate russian kleio_event_01_2c740ad6:
    "Любоваться её фигурой настолько приятно, что я совсем не против здесь находиться."

# ch/kleio/events.rpy:778
translate russian kleio_event_01_9b66f3e7:
    "Но вскоре она прерывает мои мечтания, снова спрашивая совета."

# ch/kleio/events.rpy:779
translate russian kleio_event_01_abae253c:
    kleio.say "А из этих двух? Какой тебе больше нравится?"

# ch/kleio/events.rpy:782
translate russian kleio_event_01_7a6e9ff8:
    mike.say "Э-э, наверное, Элвис. Он великолепен."

# ch/kleio/events.rpy:783
translate russian kleio_event_01_2386c3a1:
    "Клео хмурится и снова смотрит на альбомы."

# ch/kleio/events.rpy:784
translate russian kleio_event_01_629acb77:
    kleio.say "Ты прав, но не уверена, что это мой стиль."

# ch/kleio/events.rpy:785
translate russian kleio_event_01_bf69c3f0:
    mike.say "Он же рок играет! Без него рока вообще бы не было."

# ch/kleio/events.rpy:786
translate russian kleio_event_01_2ba9aeb8:
    kleio.say "Да. Ты прав."

# ch/kleio/events.rpy:787
translate russian kleio_event_01_f19fa67a:
    "Она зажимает альбом под мышкой, но особой радости не видно."

# ch/kleio/events.rpy:789
translate russian kleio_event_01_f96a7a49:
    mike.say "Disrupted — реально офигенная группа. По крайней мере, на мой вкус."

# ch/kleio/events.rpy:790
translate russian kleio_event_01_d0eb0e52:
    "Клео ухмыляется и переворачивает альбом, чтобы прочитать обложку."

# ch/kleio/events.rpy:792
translate russian kleio_event_01_f8f32be5:
    kleio.say "А вкус у тебя получше, чем я думала, парень. Пожалуй, придётся взять."

# ch/kleio/events.rpy:793
translate russian kleio_event_01_ac5469c0:
    "Не могу сдержать улыбку."

# ch/kleio/events.rpy:794
translate russian kleio_event_01_b6ed4f18:
    mike.say "Думаю, стоит. Тебе понравится."

# ch/kleio/events.rpy:795
translate russian kleio_event_01_87cd044b:
    "Широко улыбаясь, она зажимает пластинку под мышкой и идёт дальше."

# ch/kleio/events.rpy:799
translate russian kleio_event_01_486e29f4:
    "Вскоре руки у неё забиты альбомами, и она едва их удерживает."

# ch/kleio/events.rpy:800
translate russian kleio_event_01_06ffed79:
    "Она пытается скрыть, как ей тяжело, но плохо получается."

# ch/kleio/events.rpy:801
translate russian kleio_event_01_3c594993:
    "Наконец решаю вмешаться."

# ch/kleio/events.rpy:802
translate russian kleio_event_01_e96c2a4f:
    mike.say "Давай помогу. Хотя бы до кассы."

# ch/kleio/events.rpy:805
translate russian kleio_event_01_40a595c9:
    "Клео пытается выглядеть гордо, но румянец на щеках всё портит. Я протягиваю руки, и она охотно отдаёт мне пластинки."

# ch/kleio/events.rpy:806
translate russian kleio_event_01_37159ef5:
    kleio.say "Спасибо. Очень кстати. Ты сегодня здорово помог."

# ch/kleio/events.rpy:807
translate russian kleio_event_01_c89fb009:
    mike.say "Всегда пожалуйста, Клео. Мне было приятно помочь."

# ch/kleio/events.rpy:810
translate russian kleio_event_01_3db256f2:
    "Клео поднимает на меня взгляд, почти испуганная предложением."

# ch/kleio/events.rpy:811
translate russian kleio_event_01_6a2e871b:
    kleio.say "А. Э-э, ладно. Возьми половину, остальное понесу я."

# ch/kleio/events.rpy:812
translate russian kleio_event_01_3a460fef:
    "Пожимаю плечами и соглашаюсь: наверное, гордость не позволяет ей отдать мне всё."

# ch/kleio/events.rpy:813
translate russian kleio_event_01_d67436d5:
    "Она осторожно перекладывает половину альбомов мне в руки."

# ch/kleio/events.rpy:816
translate russian kleio_event_01_d4283603:
    "Клео закатывает глаза и отворачивается."

# ch/kleio/events.rpy:817
translate russian kleio_event_01_cae076d2:
    kleio.say "О, теперь решил помочь?"

# ch/kleio/events.rpy:818
translate russian kleio_event_01_5acf3cca:
    "Ответ немного сбивает меня с толку, но я стараюсь снова."

# ch/kleio/events.rpy:819
translate russian kleio_event_01_c8e01db3:
    mike.say "Я просто хотел помочь, Клео."

# ch/kleio/events.rpy:820
translate russian kleio_event_01_bbbe6cf9:
    kleio.say "Да уж. Сама справлюсь."

# ch/kleio/events.rpy:824
translate russian kleio_event_01_d69b0ec9:
    "Клео поворачивается ко мне."

# ch/kleio/events.rpy:825
translate russian kleio_event_01_86e9c244:
    kleio.say "Всё, можно оплачивать. Пойдём, касса там."

# ch/kleio/events.rpy:826
translate russian kleio_event_01_7599708f:
    "Киваю и иду следом. Она молча расплачивается, продавец наполняет два пакета, и Клео поворачивается ко мне."

# ch/kleio/events.rpy:827
translate russian kleio_event_01_ac870b70:
    kleio.say "Готов идти?"

# ch/kleio/events.rpy:828
translate russian kleio_event_01_ded270fb:
    "Я согласно киваю."

# ch/kleio/events.rpy:829
translate russian kleio_event_01_4750a98a:
    mike.say "Да, конечно. Пойдём."

# ch/kleio/events.rpy:831
translate russian kleio_event_01_b266250f:
    "Снова молча проходим через почти пустой торговый центр и выходим той же дверью. Наконец Клео заговаривает."

# ch/kleio/events.rpy:833
translate russian kleio_event_01_c8c8e58a:
    kleio.say "Прости, что сегодня была такой отстранённой. У меня... кое-что происходит. Хотелось отвлечься."

# ch/kleio/events.rpy:834
translate russian kleio_event_01_34a57b26:
    "Её признание меня удивляет, но я стараюсь этого не показывать."

# ch/kleio/events.rpy:835
translate russian kleio_event_01_152ee35d:
    mike.say "Понимаю. Ничего страшного. Хочешь поговорить? Может, я помогу."

# ch/kleio/events.rpy:836
translate russian kleio_event_01_2da4560e:
    "Клео вздыхает и идёт в сторону моего дома. Немного помолчав, решается заговорить."

# ch/kleio/events.rpy:838
translate russian kleio_event_01_f1020c6a:
    kleio.say "Мы с девушкой сегодня расстались."

# ch/kleio/events.rpy:840
translate russian kleio_event_01_e67a0f81:
    mike.say "О, так ты лесбиянка?"

# ch/kleio/events.rpy:842
translate russian kleio_event_01_a0a494f7:
    "Клео закатывает глаза и раздражённо фыркает."

# ch/kleio/events.rpy:843
translate russian kleio_event_01_9d07da50:
    kleio.say "Серьёзно? Только это тебя волнует? К твоему сведению, нет. Ну, не совсем. Я би. Но это неважно."

# ch/kleio/events.rpy:844
translate russian kleio_event_01_f9fe8a40:
    "Я теряюсь, понимая, что явно её обидел."

# ch/kleio/events.rpy:845
translate russian kleio_event_01_d899871c:
    mike.say "Прости, Клео. Не хотел тебя расстраивать. Просто не знал."

# ch/kleio/events.rpy:847
translate russian kleio_event_01_1fc74461:
    kleio.say "Ну, теперь знаешь. Хотя какая уже разница. Её больше нет в моей жизни, и так даже лучше."

# ch/kleio/events.rpy:848
translate russian kleio_event_01_62a1fa72:
    mike.say "Надеюсь."

# ch/kleio/events.rpy:850
translate russian kleio_event_01_b1c94c39:
    "Молча доходим до входа в её дом. Немного неловко стоим, прежде чем она нарушает тишину."

# ch/kleio/events.rpy:851
translate russian kleio_event_01_31d2aa54:
    kleio.say "Ну, хорошего вечера, [lssb_kleio.hero_name()]. Спасибо, что пришёл."

# ch/kleio/events.rpy:852
translate russian kleio_event_01_6f63adde:
    mike.say "Не за что. И тебе, Клео. Мне жаль, что так вышло с твоей девушкой. Если понадоблюсь, просто позвони, ладно?"

# ch/kleio/events.rpy:853
translate russian kleio_event_01_4b4534cd:
    "Она кивает, слегка улыбается и уходит, растворяясь в вечернем сумраке. Мне остаётся подняться наверх одному."

# ch/kleio/events.rpy:856
translate russian kleio_event_01_72dacd37:
    mike.say "Господи, мне очень жаль. Ты как?"

# ch/kleio/events.rpy:857
translate russian kleio_event_01_d34d3392:
    "Она пожимает плечами и отвечает с некоторой обречённостью."

# ch/kleio/events.rpy:859
translate russian kleio_event_01_5da1e78f:
    kleio.say "Нормально. Насколько вообще можно после расставания."

# ch/kleio/events.rpy:860
translate russian kleio_event_01_afcea663:
    kleio.say "Я уже какое-то время чувствовала, к чему идёт. Если это что-то меняет. Как пластырь сорвать: больно, но надо."

# ch/kleio/events.rpy:861
translate russian kleio_event_01_74233d23:
    mike.say "Прекрасно понимаю."

# ch/kleio/events.rpy:863
translate russian kleio_event_01_43d97bd4:
    kleio.say "Просто паршиво, понимаешь? Любое расставание паршивое. Но она сделала это так, словно я вообще ничего для неё не значила."

# ch/kleio/events.rpy:864
translate russian kleio_event_01_ff291236:
    mike.say "Что ты имеешь в виду?"

# ch/kleio/events.rpy:866
translate russian kleio_event_01_dbc80b31:
    kleio.say "Она написала сообщение. Поэтому я всю дорогу в торговый центр сидела в телефоне."

# ch/kleio/events.rpy:867
translate russian kleio_event_01_fbda5ed1:
    kleio.say "Пыталась всё уладить, снова наладить отношения. Просто не понимала, что на этот раз уже ничего не исправить."

# ch/kleio/events.rpy:868
translate russian kleio_event_01_075e20ff:
    mike.say "Иногда и не нужно ничего исправлять. Может, без неё тебе будет лучше."

# ch/kleio/events.rpy:870
translate russian kleio_event_01_daacf9de:
    kleio.say "Думаешь?"

# ch/kleio/events.rpy:871
translate russian kleio_event_01_21a1dc67:
    mike.say "Ты же хороший человек. Тот, кто причиняет тебе боль и так с тобой поступает, не заслуживает места в твоей жизни."

# ch/kleio/events.rpy:872
translate russian kleio_event_01_d3bb7e50:
    kleio.say "Знаю. Ты прав. Просто... больно. Прости, что втянула тебя."

# ch/kleio/events.rpy:873
translate russian kleio_event_01_ccf9005b:
    kleio.say "Сегодня мне просто нужен был кто-то рядом."

# ch/kleio/events.rpy:874
translate russian kleio_event_01_7e3fa58b:
    mike.say "Не переживай. Рад, что хоть немного помог."

# ch/kleio/events.rpy:875
translate russian kleio_event_01_febd51cf:
    "Ей грустно, но она слегка улыбается. И у меня теплеет на душе от того, что я сумел её порадовать."

# ch/kleio/events.rpy:876
translate russian kleio_event_01_891a574f:
    kleio.say "Да. Я тоже."

# ch/kleio/events.rpy:878
translate russian kleio_event_01_e396f33f:
    "Некоторое время идём молча, и я почти неосознанно беру её за руку."

# ch/kleio/events.rpy:879
translate russian kleio_event_01_119d76ba:
    "Сейчас это кажется правильным, и она не возражает."

# ch/kleio/events.rpy:880
translate russian kleio_event_01_bbd24d7a:
    "Наконец доходим до её дома, и она высвобождает ладонь."

# ch/kleio/events.rpy:881
translate russian kleio_event_01_2787fe1c:
    "Неловко стоим, не зная, что делать."

# ch/kleio/events.rpy:882
translate russian kleio_event_01_7eef4561:
    kleio.say "Ну, спокойной ночи, [lssb_kleio.hero_name()]. Спасибо, что сегодня пришёл. Для меня это правда много значит."

# ch/kleio/events.rpy:883
translate russian kleio_event_01_d4a0cc86:
    "Улыбаясь, я заправляю прядь ей за ухо и подхожу ближе."

# ch/kleio/events.rpy:884
translate russian kleio_event_01_567ee649:
    "Мы прижимаемся друг к другу, и я чувствую, как колотится её сердце рядом с моим."

# ch/kleio/events.rpy:885
translate russian kleio_event_01_6417dac7:
    mike.say "Всегда пожалуйста. Серьёзно."

# ch/kleio/events.rpy:889
translate russian kleio_event_01_f7aa2224:
    "Она улыбается, глядя на меня снизу вверх. Не успев засомневаться, я наклоняюсь и целую её."

# ch/kleio/events.rpy:890
translate russian kleio_event_01_473ab5ea:
    "На миг она замирает от неожиданности, а потом отвечает на поцелуй, обвивает руками мою шею и уютно прижимается ко мне."

# ch/kleio/events.rpy:891
translate russian kleio_event_01_e852f91f:
    "Её губы мягкие и тёплые. Когда она наконец отстраняется, мне кажется, что слишком рано."

# ch/kleio/events.rpy:892
translate russian kleio_event_01_37305419:
    "Больше всего хочется снова поцеловать её, почувствовать её тело и грудь, прижатые ко мне. Едва сдерживаюсь, чтобы опять её не обнять."

# ch/kleio/events.rpy:893
translate russian kleio_event_01_cb2fb08c:
    "Она краснеет, и по её взгляду понятно: чувствует то же самое."

# ch/kleio/events.rpy:894
translate russian kleio_event_01_031510a4:
    "Но прежде чем желание берёт верх, она отступает, всё ещё улыбаясь."

# ch/kleio/events.rpy:896
translate russian kleio_event_01_18a41086:
    kleio.say "Спокойной ночи, [lssb_kleio.hero_name()]."

# ch/kleio/events.rpy:898
translate russian kleio_event_01_9b357ffe:
    kleio.say "Пока, [lssb_kleio.hero_name()]."

# ch/kleio/events.rpy:899
translate russian kleio_event_01_3d199b7c:
    "Я улыбаюсь и провожаю её взглядом, пока она не теряется в толпе."

# ch/kleio/events.rpy:901
translate russian kleio_event_01_722ddeef:
    "Всё ещё улыбаясь и вспоминая поцелуй, иду к своему дому. Пора спать. Уже знаю, кто сегодня будет мне сниться."

# ch/kleio/events.rpy:903
translate russian kleio_event_01_6d09089b:
    kleio.say "Сам до дома доберёшься? Мне кое-куда надо."

# ch/kleio/events.rpy:904
translate russian kleio_event_01_12c9af61:
    "Вопрос немного задевает и удивляет меня, но я стараюсь не подать виду."

# ch/kleio/events.rpy:905
translate russian kleio_event_01_1e5fcb1a:
    mike.say "А, э-э, конечно. Без проблем. Точно не хочешь, чтобы я тебя проводил? Мне совсем не трудно."

# ch/kleio/events.rpy:906
translate russian kleio_event_01_2429b0e8:
    kleio.say "Я сама справлюсь. Но спасибо."

# ch/kleio/events.rpy:907
translate russian kleio_event_01_ab618900:
    "Клео кивает, уже явно собираясь уйти. Придётся её отпустить."

# ch/kleio/events.rpy:908
translate russian kleio_event_01_5b96946a:
    mike.say "Ладно. Не за что. Хорошего вечера, Клео. Спасибо за компанию."

# ch/kleio/events.rpy:909
translate russian kleio_event_01_8e0e0566:
    kleio.say "Да. Увидимся на репетиции, [lssb_kleio.hero_name()]."

# ch/kleio/events.rpy:911
translate russian kleio_event_01_de0d310b:
    "Смотрю, как она уходит быстрым, резким шагом, и мне становится почти грустно."

# ch/kleio/events.rpy:913
translate russian kleio_event_01_f03e1392:
    "Надеясь ещё исправить впечатление, разворачиваюсь. Впереди долгая дорога домой, которую я не рассчитывал проделать один."

# ch/kleio/events.rpy:914
translate russian kleio_event_01_606e2ecc:
    "Отвожу взгляд от заката и Клео к быстро сгущающейся ночи и отправляюсь домой в одиночестве."

# ch/kleio/events.rpy:930
translate russian kleio_event_02_1931ed65:
    mike.say "Привет, Клео. Что нового?"

# ch/kleio/events.rpy:931
translate russian kleio_event_02_d8687dde:
    kleio.say "Да ничего особенного."

# ch/kleio/events.rpy:932
translate russian kleio_event_02_1e8af38d:
    kleio.say "В общем, ты сейчас занят?"

# ch/kleio/events.rpy:933
translate russian kleio_event_02_a0c28035:
    mike.say "Нет, не особо. А что?"

# ch/kleio/events.rpy:934
translate russian kleio_event_02_80f2c952:
    kleio.say "Как относишься к татуировкам?"

# ch/kleio/events.rpy:935
translate russian kleio_event_02_6438c905:
    "На миг у меня сердце уходит в пятки."

# ch/kleio/events.rpy:936
translate russian kleio_event_02_8e5ec88f:
    "Да, мы с Клео сблизились, но если она предлагает парные татуировки, это поезд в безумие, на который я садиться не хочу."

# ch/kleio/events.rpy:937
translate russian kleio_event_02_596f110d:
    mike.say "Э-э, Клео, я рад, что мы друзья, но..."

# ch/kleio/events.rpy:938
translate russian kleio_event_02_1fa69ae6:
    kleio.say "Блядь, ты решил, что я предлагаю парные татуировки? Господи..."

# ch/kleio/events.rpy:939
translate russian kleio_event_02_0c2b7307:
    mike.say "Упс. Ну а что мне было думать, Клео?"

# ch/kleio/events.rpy:940
translate russian kleio_event_02_f6fd765f:
    kleio.say "Не тупи. Пойдёшь со мной, пока мне будут бить татуировку, или нет?"

# ch/kleio/events.rpy:941
translate russian kleio_event_02_2ce18e0d:
    mike.say "Э-э, ну ладно."

# ch/kleio/events.rpy:942
translate russian kleio_event_02_c0ce5c5a:
    kleio.say "Отлично. Я у дома. Шевелись, у меня запись через десять минут."

# ch/kleio/events.rpy:943
translate russian kleio_event_02_fd706ad1:
    mike.say "Что? Клео..."

# ch/kleio/events.rpy:944
translate russian kleio_event_02_b7501a51:
    "Не даёт мне договорить и резко кладёт трубку."

# ch/kleio/events.rpy:945
translate russian kleio_event_02_4707e815:
    "Дурацкая привычка, как и приезжать без предупреждения. Но с ней лучше к такому привыкнуть."

# ch/kleio/events.rpy:949
translate russian kleio_event_02_ddb905c3:
    "Быстро одеваюсь и спускаюсь к её машине. Клео расслабленно стоит рядом, докуривая сигарету, и замечает меня."

# ch/kleio/events.rpy:951
translate russian kleio_event_02_ceaac117:
    "Вместо приветствия сразу садится в машину и жестом зовёт за собой, а затем мчится к салону."

# ch/kleio/events.rpy:959
translate russian kleio_event_02_f69bc632:
    "Она несётся, лавируя в потоке. Музыка орёт так, что приходится кричать, чтобы поговорить. Её это ничуть не смущает."

# ch/kleio/events.rpy:960
translate russian kleio_event_02_c676d25b:
    mike.say "Что будешь делать?"

# ch/kleio/events.rpy:961
translate russian kleio_event_02_7a829de4:
    kleio.say "В смысле какую татуировку?"

# ch/kleio/events.rpy:962
translate russian kleio_event_02_f8db339c:
    mike.say "Да."

# ch/kleio/events.rpy:963
translate russian kleio_event_02_7f54217b:
    kleio.say "Пока не решила. Выбираю между двумя: волк, идущий вдоль ключицы, или ангельские крылья на спине. Как думаешь?"

# ch/kleio/events.rpy:966
translate russian kleio_event_02_fa289e71:
    mike.say "Волка, конечно! Это же охрененно круто."

# ch/kleio/events.rpy:967
translate russian kleio_event_02_b7cee5da:
    kleio.say "Думаешь? Боялась, что слишком уж получится «альфа-сука»."

# ch/kleio/events.rpy:968
translate russian kleio_event_02_730e6fc1:
    mike.say "Нет, совсем нет. Мне нравится, обязательно делай. Ну, если сама хочешь."

# ch/kleio/events.rpy:970
translate russian kleio_event_02_d5bfaaeb:
    kleio.say "Знаешь что? Да, блядь, сделаю, [lssb_kleio.hero_name()]!"

# ch/kleio/events.rpy:973
translate russian kleio_event_02_5f640449:
    kleio.say "Прости, [lssb_kleio.hero_name()], думаю, всё-таки выберу крылья."

# ch/kleio/events.rpy:976
translate russian kleio_event_02_a3c0e79d:
    mike.say "Делай ангельские крылья! Чёрт, будет офигенно."

# ch/kleio/events.rpy:977
translate russian kleio_event_02_6d483c4f:
    kleio.say "Правда? Я с детства об этом думала. Просто раньше всё никак не получалось сделать."

# ch/kleio/events.rpy:978
translate russian kleio_event_02_bdaaf76f:
    mike.say "Тогда лови, блядь, момент, Клео! Обзаводись ангельскими крыльями."

# ch/kleio/events.rpy:979
translate russian kleio_event_02_ae080066:
    kleio.say "А знаешь, так и сделаю. Спасибо, [lssb_kleio.hero_name()]."

# ch/kleio/events.rpy:983
translate russian kleio_event_02_5f2fce25:
    mike.say "Не знаю, я не большой любитель татуировок."

# ch/kleio/events.rpy:984
translate russian kleio_event_02_c0f230e7:
    "Клео закатывает глаза, явно раздражённая."

# ch/kleio/events.rpy:985
translate russian kleio_event_02_e967db6b:
    kleio.say "Зануда."

# ch/kleio/events.rpy:986
translate russian kleio_event_02_200eb25b:
    mike.say "Эй!"

# ch/kleio/events.rpy:987
translate russian kleio_event_02_e7eab7e9:
    kleio.say "Ладно. Сама решу."

# ch/kleio/events.rpy:993
translate russian kleio_event_02_6717145c:
    "Не успеваю опомниться, как мы уже у тату-салона."

# ch/kleio/events.rpy:994
translate russian kleio_event_02_8b2c406f:
    "Неоновая вывеска слепит, а искусные рисунки до ужаса вычурны. Меня пробирает дрожь, когда она затаскивает меня внутрь, явно чувствуя себя в своей стихии."

# ch/kleio/events.rpy:998
translate russian kleio_event_02_73a5922a:
    "Здесь её знают: она улыбается почти каждому встречному."

# ch/kleio/events.rpy:999
translate russian kleio_event_02_98cbf4e4:
    "Пока она идёт к кабинету, меня разглядывают с головы до ног как чужака. Мне совсем не по себе."

# ch/kleio/events.rpy:1000
translate russian kleio_event_02_e82c9951:
    "Мастер уже готов и явно ждёт её. Они обмениваются любезностями, а я стою в стороне почти без внимания."

# ch/kleio/events.rpy:1001
translate russian kleio_event_02_b8779b26:
    "Наконец мастер молча указывает мне на складной стул в углу, предназначенный для сопровождающих."

# ch/kleio/events.rpy:1002
translate russian kleio_event_02_26cd5e35:
    "Сажусь, уже жалея, что вообще пришёл. Надеюсь, хоть что-нибудь здесь будет интересно."

# ch/kleio/events.rpy:1003
translate russian kleio_event_02_46da3ee9:
    "К счастью, интересное происходит довольно скоро."

# ch/kleio/events.rpy:1004
translate russian kleio_event_02_a9368541:
    "Клео как ни в чём не бывало скрещивает руки на талии и непринуждённо снимает футболку."

# ch/kleio/events.rpy:1008
translate russian kleio_event_02_8b5157bb:
    "Чувствую её взгляд, но не могу не любоваться. У неё великолепная грудь. Представляю, каково было бы накрыть её ладонями..."

# ch/kleio/events.rpy:1009
translate russian kleio_event_02_6cc97bde:
    "Мои мечтания прерывает резкий смех Клео."

# ch/kleio/events.rpy:1010
translate russian kleio_event_02_f6f9fb46:
    kleio.say "Наслаждайся видом, сердцеед. В ближайшее время больше тебе ничего не светит."

# ch/kleio/events.rpy:1015
translate russian kleio_event_02_4c5c877c:
    "Она тут же ложится грудью вниз, скрываясь от моего взгляда и подставляя спину под иглу."

# ch/kleio/events.rpy:1016
translate russian kleio_event_02_bd27f99b:
    "Я пытаюсь привести мысли в порядок, пока комнату наполняет жужжание машинки."

# ch/kleio/events.rpy:1017
translate russian kleio_event_02_394f1b96:
    "Некоторое время сидим молча, и в комнате повисает неловкость."

# ch/kleio/events.rpy:1018
translate russian kleio_event_02_8f53bcfa:
    "Из-за машинки плохо слышно, а мастеру надо сосредоточиться. Кричать здесь тоже не стоит."

# ch/kleio/events.rpy:1019
translate russian kleio_event_02_56db2ee0:
    "Мы с Клео лишь неловко переглядываемся каждые несколько минут, пока игла погружается в её кожу и выходит обратно."

# ch/kleio/events.rpy:1024
translate russian kleio_event_02_e7d0b4d3:
    "Примерно через час мастер наконец выходит ненадолго попить воды."

# ch/kleio/events.rpy:1025
translate russian kleio_event_02_d2159c8f:
    "Клео облегчённо вздыхает, радуясь передышке от боли, и поворачивается ко мне."

# ch/kleio/events.rpy:1026
translate russian kleio_event_02_f07a44b0:
    kleio.say "Ты когда-нибудь думал о татуировке или пирсинге?"

# ch/kleio/events.rpy:1029
translate russian kleio_event_02_0439f0e7:
    mike.say "Ни за что."

# ch/kleio/events.rpy:1030
translate russian kleio_event_02_2b8c46f5:
    "Клео закатывает глаза и продолжает."

# ch/kleio/events.rpy:1031
translate russian kleio_event_02_46ce3665:
    kleio.say "Почему? Боишься?"

# ch/kleio/events.rpy:1034
translate russian kleio_event_02_abb31cb7:
    mike.say "Да... Я, наверное, просто плохо переношу боль."

# ch/kleio/events.rpy:1035
translate russian kleio_event_02_e93f8dd1:
    kleio.say "Господи, не будь таким ссыклом. Это правда не настолько страшно. Особенно когда привыкнешь."

# ch/kleio/events.rpy:1036
translate russian kleio_event_02_f2da9b00:
    mike.say "Не знаю, Клео. Просто не хочется."

# ch/kleio/events.rpy:1037
translate russian kleio_event_02_2fb5aa89:
    "Она раздражённо фыркает. В комнату возвращается отдохнувший мастер."

# ch/kleio/events.rpy:1038
translate russian kleio_event_02_8b44a968:
    kleio.say "Как хочешь."

# ch/kleio/events.rpy:1042
translate russian kleio_event_02_7dfeb79c:
    mike.say "Нет."

# ch/kleio/events.rpy:1043
translate russian kleio_event_02_02a8a29b:
    kleio.say "Тогда в чём дело?"

# ch/kleio/events.rpy:1044
translate russian kleio_event_02_326e9785:
    "Я неловко ёрзаю, понимая, что моё мнение здесь не оценят. Тем более в тату-салоне."

# ch/kleio/events.rpy:1045
translate russian kleio_event_02_2e62e516:
    mike.say "Ничего против тебя или кого-то здесь. Просто, на мой взгляд, естественное человеческое тело прекраснее всего на свете, а любые дополнения лишь портят его."

# ch/kleio/events.rpy:1046
translate russian kleio_event_02_54b3d490:
    mike.say "Как наклейка на бампере «Феррари»."

# ch/kleio/events.rpy:1047
translate russian kleio_event_02_5dbccee9:
    "Клео раздражена, но неожиданно сдерживается. Когда мастер возвращается, её голос звучит почти сухо."

# ch/kleio/events.rpy:1048
translate russian kleio_event_02_da3ec098:
    kleio.say "Прямо по Библии живёшь."

# ch/kleio/events.rpy:1049
translate russian kleio_event_02_41440e07:
    "Закатываю глаза и скучаю, пока мастер заканчивает работу. Не успеваю опомниться, как нас уже выпроваживают из салона."

# ch/kleio/events.rpy:1052
translate russian kleio_event_02_31ee6430:
    mike.say "Ещё бы!"

# ch/kleio/events.rpy:1053
translate russian kleio_event_02_b6cb8d50:
    "Глаза Клео радостно вспыхивают."

# ch/kleio/events.rpy:1054
translate russian kleio_event_02_4c8ab4df:
    kleio.say "Так почему не сделаешь? У тебя ведь ещё ничего нет?"

# ch/kleio/events.rpy:1055
translate russian kleio_event_02_10abffa9:
    mike.say "Не знаю. То времени не было, то денег, понимаешь?"

# ch/kleio/events.rpy:1056
translate russian kleio_event_02_071cb677:
    kleio.say "Сейчас время есть. И деньги тоже, да? Дерзай, чувак."

# ch/kleio/events.rpy:1059
translate russian kleio_event_02_99a47b51:
    mike.say "Э-э, может, в другой раз. Хочется ещё обдумать."

# ch/kleio/events.rpy:1060
translate russian kleio_event_02_796dc0be:
    kleio.say "Как хочешь, сердцеед. Ты бы стал раз в десять горячее."

# ch/kleio/events.rpy:1061
translate russian kleio_event_02_ea879f35:
    "Пока мастер возвращается к работе, мысли несутся вскачь. Что значит, если Клео считает меня горячим?"

# ch/kleio/events.rpy:1062
translate russian kleio_event_02_a6f9c16e:
    "Я скучаю, наблюдая, как мастер заканчивает работу. Не успеваю опомниться, как нас уже выпроваживают из салона."

# ch/kleio/events.rpy:1066
translate russian kleio_event_02_79840d4a:
    mike.say "А знаешь, может, и сделаю."

# ch/kleio/events.rpy:1067
translate russian kleio_event_02_77215c22:
    "Как раз возвращается мастер и слышит конец разговора. От моего замечания у него в глазах загораются значки доллара."

# ch/kleio/events.rpy:1068
translate russian kleio_event_02_39b24503:
    "Мастер тату" "Что хочешь сделать? У меня есть приятель, он может тебя принять."

# ch/kleio/events.rpy:1070
translate russian kleio_event_02_291f9060:
    mike.say "Да я просто размечтался. Сейчас денег особо ни на что нет."

# ch/kleio/events.rpy:1071
translate russian kleio_event_02_88082b02:
    "Мастер тату" "Ладно, как хочешь, парень. Надеюсь, ещё увидимся. А пока дай мне закончить с твоей подругой."

# ch/kleio/events.rpy:1072
translate russian kleio_event_02_33770b5d:
    "Вздыхаю и откидываюсь на спинку, дожидаясь, пока мастер наносит последние штрихи."

# ch/kleio/events.rpy:1078
translate russian kleio_event_02_5f3dcc56:
    mike.say "Татуировку."

# ch/kleio/events.rpy:1079
translate russian kleio_event_02_480f9a9c:
    "Мастер тату" "Отлично. Мой приятель в соседнем кабинете тебе поможет, как только я закончу с Клео."

# ch/kleio/events.rpy:1080
translate russian kleio_event_02_d30da062:
    "Мастер тату" "Тут осталось немного."

# ch/kleio/events.rpy:1081
translate russian kleio_event_02_c2958cae:
    "Мастер тату" "Пока можешь полистать каталог."

# ch/kleio/events.rpy:1084
translate russian kleio_event_02_3f65fa01:
    mike.say "Пирсинг."

# ch/kleio/events.rpy:1085
translate russian kleio_event_02_52c9560d:
    "Мастер тату" "Хорошо. Это тоже недолго. Закончу с Клео, и пройдём вместе."

# ch/kleio/events.rpy:1086
translate russian kleio_event_02_92586f65:
    "Мастер улыбается и ещё несколько минут заканчивает работу, пока я с тревогой жду своей участи."

# ch/kleio/events.rpy:1087
translate russian kleio_event_02_326bb286:
    "Он заканчивает быстрее, чем я ожидал, убирает инструменты и непринуждённо объясняет Клео, как ухаживать за татуировкой."

# ch/kleio/events.rpy:1090
translate russian kleio_event_02_3ecbcc19:
    "Она с улыбкой подходит, берёт меня под руку и тащит в дальний кабинет."

# ch/kleio/events.rpy:1092
translate russian kleio_event_02_84707aee:
    "Мастер тату" "Ну что, определился?"

# ch/kleio/events.rpy:1093
translate russian kleio_event_02_1ca4262e:
    "Подбодрённый Клео, указываю на выбранный рисунок. Для первого раза ничего слишком вычурного."

# ch/kleio/events.rpy:1094
translate russian kleio_event_02_3b4bd079:
    "Мастер одобрительно кивает. Словно во сне я оказываюсь в кресле и слушаю жужжание машинки."

# ch/kleio/events.rpy:1096
translate russian kleio_event_02_e5e7ce7c:
    "Клео держит меня за руку и сияет от восторга, склонившись грудью почти к моему лицу. Сердце трепещет, а в голове вихрь непристойных мыслей."

# ch/kleio/events.rpy:1097
translate russian kleio_event_02_ef58db9e:
    kleio.say "Отлично выглядит."

# ch/kleio/events.rpy:1098
translate russian kleio_event_02_9a6cefcb:
    "Какое-то время мы остаёмся так. Рядом с Клео о тупой ноющей боли легко забыть."

# ch/kleio/events.rpy:1099
translate russian kleio_event_02_3a49b9bb:
    "Не успеваю заметить, как татуировка готова. Мастер откидывается назад и довольно любуется своей работой."

# ch/kleio/events.rpy:1100
translate russian kleio_event_02_8e16405a:
    "Он привычно объясняет, как за ней ухаживать. Я с трудом слушаю: тёплое тело Клео прижимается ко мне всё теснее."

# ch/kleio/events.rpy:1101
translate russian kleio_event_02_289d4c42:
    "Надеюсь, я всё сделал правильно. Мы выходим из салона почти опьянённые радостью и любуемся новыми татуировками."

# ch/kleio/events.rpy:1103
translate russian kleio_event_02_f5c268f2:
    "Мастер тату" "Хороший выбор. Только не двигайся, это недолго."

# ch/kleio/events.rpy:1105
translate russian kleio_event_02_5e59007c:
    "Клео берёт меня за руку и ласково сжимает её, пока мастер готовится к проколу."

# ch/kleio/events.rpy:1106
translate russian kleio_event_02_aa7bd0eb:
    "Я затаил дыхание, любуясь ею, чувствуя тепло кожи и прижатую ко мне грудь. Даже прокол почти не заметил."

# ch/kleio/events.rpy:1107
translate russian kleio_event_02_d39b3b65:
    "Не успеваю опомниться, как всё заканчивается. Мы выходим из салона, сияя и сжимая в руках средства для ухода."

# ch/kleio/events.rpy:1110
translate russian kleio_event_02_c09528c9:
    kleio.say "Мне сегодня было очень весело, [lssb_kleio.hero_name()]. Тебе, похоже, тоже. Спасибо, что пошёл со мной."

# ch/kleio/events.rpy:1111
translate russian kleio_event_02_29f73ee0:
    mike.say "Всегда пожалуйста. Для тебя что угодно, Клео."

# ch/kleio/events.rpy:1112
translate russian kleio_event_02_7998835e:
    "Она улыбается, тянется ко мне и легко целует в щёку."

# ch/kleio/events.rpy:1113
translate russian kleio_event_02_4b252818:
    "Всю дорогу домой голова идёт кругом, улыбка не сходит с лица, и я едва могу дышать."

# ch/kleio/events.rpy:1119
translate russian kleio_event_02_fbe99a4b:
    kleio.say "Ну, спасибо, что пришёл."

# ch/kleio/events.rpy:1120
translate russian kleio_event_02_ce65d598:
    "Я не дурак, чувствую неловкость между нами. Что бы ни случилось, задерживаться и выяснять причину не хочется."

# ch/kleio/events.rpy:1121
translate russian kleio_event_02_b3a96149:
    mike.say "Да. Всегда пожалуйста, наверное."

# ch/kleio/events.rpy:1123
translate russian kleio_event_02_b2902610:
    "Она слабо улыбается и кивает на машину. Хотя бы хватает приличия отвезти меня домой."

# ch/kleio/events.rpy:1124
translate russian kleio_event_02_0c704878:
    "Всю дорогу я растерянно гадаю, что вообще происходит между мной и Клео."

# ch/kleio/events.rpy:1139
translate russian kleio_event_03_7bc80586:
    mike.say "Алло?"

# ch/kleio/events.rpy:1140
translate russian kleio_event_03_dc4f97eb:
    "В трубке её голос звучит прерывисто и далеко, но я узнал бы его где угодно."

# ch/kleio/events.rpy:1141
translate russian kleio_event_03_d1084472:
    "На заднем плане едва слышен шум едущей машины."

# ch/kleio/events.rpy:1142
translate russian kleio_event_03_76f9f99b:
    kleio.say "Не спишь?"

# ch/kleio/events.rpy:1143
translate russian kleio_event_03_11a34497:
    "Я моргаю, удивлённый её взволнованным тоном и временем звонка."

# ch/kleio/events.rpy:1144
translate russian kleio_event_03_d878afdd:
    mike.say "Теперь уже нет. Что случилось? Ты в порядке?"

# ch/kleio/events.rpy:1145
translate russian kleio_event_03_88d6fbdb:
    kleio.say "Прости. Ты сейчас чем-то занят?"

# ch/kleio/events.rpy:1146
translate russian kleio_event_03_8c6acc71:
    mike.say "Вообще-то спал. А что?"

# ch/kleio/events.rpy:1147
translate russian kleio_event_03_3593c3d8:
    kleio.say "Хочу кое-что показать. Буду у тебя через десять минут."

# ch/kleio/events.rpy:1148
translate russian kleio_event_03_7143eaee:
    mike.say "Погоди, Клео! Подожди, я..."

# ch/kleio/events.rpy:1149
translate russian kleio_event_03_ada7d0e3:
    "Не успеваю вставить слово, как она уже кладёт трубку."

# ch/kleio/events.rpy:1150
translate russian kleio_event_03_652452a5:
    "Вздохнув и окончательно проснувшись, решаю, что лучше приготовиться к её приезду."

# ch/kleio/events.rpy:1152
translate russian kleio_event_03_b46a340f:
    "Зная Клео, она не отстанет, пока не получит желаемого. Что бы это ни было."

# ch/kleio/events.rpy:1154
translate russian kleio_event_03_15639d1f:
    "Нарочно не смотрю на часы: знаю, что сейчас гораздо раньше моего обычного подъёма. Заканчиваю одеваться как раз к тихому стуку в дверь."

# ch/kleio/events.rpy:1158
translate russian kleio_event_03_fc3131bf:
    "Медленно открываю. Невысокая Клео выжидающе смотрит на меня снизу вверх."

# ch/kleio/events.rpy:1159
translate russian kleio_event_03_6fe3e32c:
    mike.say "Клео, что..."

# ch/kleio/events.rpy:1162
translate russian kleio_event_03_0151b70a:
    "Она снова перебивает, приложив палец к моим губам."

# ch/kleio/events.rpy:1163
translate russian kleio_event_03_26c47108:
    kleio.say "Тс-с. Без вопросов."

# ch/kleio/events.rpy:1167
translate russian kleio_event_03_b55ffdb8:
    mike.say "Э-э, нет, Клео, вопросы точно будут. Какого чёрта происходит?"

# ch/kleio/events.rpy:1169
translate russian kleio_event_03_daabb50a:
    "Она раздражённо закатывает глаза, но всё же отвечает."

# ch/kleio/events.rpy:1170
translate russian kleio_event_03_b4158536:
    kleio.say "Я же сказала, хочу кое-что показать."

# ch/kleio/events.rpy:1171
translate russian kleio_event_03_ff301ef3:
    mike.say "Что именно?"

# ch/kleio/events.rpy:1173
translate russian kleio_event_03_a67a9507:
    kleio.say "Сюрприз, [lssb_kleio.hero_name()]. Ты идёшь или как?"

# ch/kleio/events.rpy:1174
translate russian kleio_event_03_19a706cc:
    "Ворча и понимая, что больше уже не усну, соглашаюсь и позволяю ей увести меня вниз к машине."

# ch/kleio/events.rpy:1178
translate russian kleio_event_03_68f4db5d:
    "Вопреки здравому смыслу, но с лёгким волнением молчу и позволяю ей вывести меня из дома к машине."

# ch/kleio/events.rpy:1181
translate russian kleio_event_03_d6bd1036:
    "С безумным блеском в глазах Клео быстро усаживает нас в машину и мчится к окраине."

# ch/kleio/events.rpy:1189
translate russian kleio_event_03_cf87a010:
    "Она несётся по пустым улицам. Фонари вспыхивают в салоне, словно фары полицейских машин."

# ch/kleio/events.rpy:1192
translate russian kleio_event_03_6dcddcdc:
    mike.say "Клео, какого хрена? Помедленнее!"

# ch/kleio/events.rpy:1193
translate russian kleio_event_03_36f08080:
    "Она закатывает глаза и игнорирует просьбу. Я судорожно ищу ремень и за что ухватиться, молясь, чтобы на дороге никого не было."

# ch/kleio/events.rpy:1197
translate russian kleio_event_03_db8773dd:
    "Не могу сдержать восторженный крик, пока мы мчимся по улицам. Вокруг всё ещё темно и пусто, а центр города остаётся всё дальше."

# ch/kleio/events.rpy:1198
translate russian kleio_event_03_e3616581:
    "Мысли о том, куда едем, исчезают. Сердце колотится всё быстрее, когда я понимаю, насколько прекрасна девушка рядом."

# ch/kleio/events.rpy:1199
translate russian kleio_event_03_6198d40c:
    "Наконец мы замедляемся у заброшенного склада на самой окраине."

# ch/kleio/events.rpy:1200
translate russian kleio_event_03_cb97e868:
    "Она ругается, заметив, что небо светлеет: тёмно-синий цвет постепенно сменяется бледной голубизной."

# ch/kleio/events.rpy:1205
translate russian kleio_event_03_3a4403b6:
    kleio.say "Чёрт, надо спешить, [lssb_kleio.hero_name()]. Пойдём."

# ch/kleio/events.rpy:1207
translate russian kleio_event_03_65aa89e7:
    "Почти неосознанно она берёт меня за руку и тащит через грунтовую стоянку к входу в разваливающееся здание. Под ногами взлетает пыль."

# ch/kleio/events.rpy:1209
translate russian kleio_event_03_7c73a9bc:
    "Она срывается с места, даже не оглянувшись. Я бегу следом изо всех сил, и мы поднимаем тучи пыли на пути к входу."

# ch/kleio/events.rpy:1213
translate russian kleio_event_03_ca1747f0:
    "Наконец стоим у огромного ветхого здания, глядя на осыпающуюся кирпичную кладку в первых проблесках рассвета."

# ch/kleio/events.rpy:1215
translate russian kleio_event_03_dc0fde3e:
    "Клео смотрит на меня с озорным блеском в глазах."

# ch/kleio/events.rpy:1216
translate russian kleio_event_03_f80c8ccf:
    kleio.say "Готов?"

# ch/kleio/events.rpy:1219
translate russian kleio_event_03_8be07b0d:
    mike.say "Ещё бы готов!"

# ch/kleio/events.rpy:1221
translate russian kleio_event_03_6ec117a1:
    "Широко улыбаясь, она рывком открывает тяжёлую бетонную дверь и тащит меня к шаткой металлической лестнице у дальней стены."

# ch/kleio/events.rpy:1223
translate russian kleio_event_03_62ea9213:
    mike.say "Нет! Клео, стой. Хватит. Я не против спонтанности, но не такой. Ты обкурилась, что ли?"

# ch/kleio/events.rpy:1225
translate russian kleio_event_03_68f3105e:
    kleio.say "Что? Нет! Господи, [lssb_kleio.hero_name()], нет."

# ch/kleio/events.rpy:1226
translate russian kleio_event_03_a1d37e66:
    mike.say "Всё равно я не полезу с тобой в жуткое заброшенное здание, не понимая, что происходит."

# ch/kleio/events.rpy:1228
translate russian kleio_event_03_a481db41:
    "Мои резкие слова наконец до неё доходят. Она вздыхает и поворачивается ко мне с непроницаемым лицом."

# ch/kleio/events.rpy:1229
translate russian kleio_event_03_caed6459:
    kleio.say "Там красивый вид. Очень, очень красивый. Не знаю, наверное, глупо... Просто захотелось с кем-то поделиться. Ясно?"

# ch/kleio/events.rpy:1230
translate russian kleio_event_03_8594e357:
    "Не могу скрыть удивления. Вся поездка — ради рассвета?"

# ch/kleio/events.rpy:1231
translate russian kleio_event_03_9bcdb6b0:
    "Хочется отказаться, вернуться домой, залезть в кровать и забыть обо всём. Но вижу её лицо — и не могу."

# ch/kleio/events.rpy:1232
translate russian kleio_event_03_17442c4b:
    "Клео хочет казаться жёсткой и неуязвимой, но под этой маской есть то, чего вечно не спрячешь. Её боль мне непонятна, но она пытается впустить меня в свой мир."

# ch/kleio/events.rpy:1233
translate russian kleio_event_03_b5d7ebee:
    "И единственный путь туда — на эту чёртову крышу."

# ch/kleio/events.rpy:1234
translate russian kleio_event_03_f3c313a0:
    "Вздыхаю, наклоняюсь и помогаю ей открыть тяжёлую дверь."

# ch/kleio/events.rpy:1237
translate russian kleio_event_03_b5959939:
    "Несмотря на ветхость здания, до лестницы добираемся быстро. Клео почти лихорадочно стремится наверх."

# ch/kleio/events.rpy:1238
translate russian kleio_event_03_ef66d9bf:
    "Металл оглушительно лязгает. Пытаюсь подавить страх, но всё кажется, что лестница вот-вот рухнет подо мной."

# ch/kleio/events.rpy:1239
translate russian kleio_event_03_097dc8a7:
    "Что на этой дурацкой лестнице мне придёт конец. Придётся объяснять Богу, какого хрена я тут забыл, хотя сам понятия не имею."

# ch/kleio/events.rpy:1240
translate russian kleio_event_03_082147d0:
    "Клео замечает мой страх, ухмыляется и нарочно лезет ещё быстрее."

# ch/kleio/events.rpy:1243
translate russian kleio_event_03_baf97a04:
    "Несмотря на тревогу, мы благополучно вылезаем на широкую бетонную крышу — как раз вовремя, чтобы в глаза ударило яркое солнце."

# ch/kleio/events.rpy:1244
translate russian kleio_event_03_1504b3f5:
    "На миг забываю о Клео и медленно иду навстречу рассвету, впитывая открывшийся вид."

# ch/kleio/events.rpy:1245
translate russian kleio_event_03_7c9754c0:
    "Смотрю вперёд: золотистый свет в свежем небе прекрасен и неземен."

# ch/kleio/events.rpy:1247
translate russian kleio_event_03_ec22e779:
    "С трудом отрываю взгляд и замечаю Клео, похожую в этом свете на богиню. Она почти машинально садится на крышу, скрестив ноги, смотреть рассвет."

# ch/kleio/events.rpy:1251
translate russian kleio_event_03_ebb71ced:
    "Не задумываясь, сажусь рядом."

# ch/kleio/events.rpy:1252
translate russian kleio_event_03_ae233934:
    "Мы молча любуемся видом, забыв о времени и друг о друге. Вокруг лишь потрескивает старое здание, вдали шумит шоссе и слышится наше дыхание."

# ch/kleio/events.rpy:1253
translate russian kleio_event_03_a9d985f2:
    "Наконец Клео нарушает тишину одним словом."

# ch/kleio/events.rpy:1254
translate russian kleio_event_03_e67d6280:
    kleio.say "Видишь?"

# ch/kleio/events.rpy:1255
translate russian kleio_event_03_d34c9617:
    "Я киваю, слишком заворожённый, чтобы говорить."

# ch/kleio/events.rpy:1258
translate russian kleio_event_03_c8a83187:
    "Она улыбается мне и опускает голову, пряча лёгкий румянец."

# ch/kleio/events.rpy:1259
translate russian kleio_event_03_a0f38904:
    "Именно эта неземная картина — её улыбка и порозовевшее лицо на фоне рассвета — наконец возвращает меня к реальности."

# ch/kleio/events.rpy:1260
translate russian kleio_event_03_6b019231:
    mike.say "Почему ты показала мне это, Клео?"

# ch/kleio/events.rpy:1262
translate russian kleio_event_03_9ebd316a:
    "Личный вопрос её удивляет, но не злит."

# ch/kleio/events.rpy:1263
translate russian kleio_event_03_8421a2f3:
    "Она набирает воздух, ненадолго задерживает дыхание и тяжело вздыхает. В этом вздохе есть что-то мне непонятное."

# ch/kleio/events.rpy:1264
translate russian kleio_event_03_14e33715:
    kleio.say "Не знаю, [lssb_kleio.hero_name()]. Мы ведь не так уж хорошо друг друга знаем. Если честно, познакомились совсем недавно."

# ch/kleio/events.rpy:1265
translate russian kleio_event_03_52cd78ee:
    kleio.say "Но кажется, что в чём-то понимаем друг друга лучше, чем сами думаем. Понимаешь?"

# ch/kleio/events.rpy:1266
translate russian kleio_event_03_76f6611f:
    "Эти слова застают меня врасплох. В них уязвимость и ни капли привычного сарказма."

# ch/kleio/events.rpy:1267
translate russian kleio_event_03_7c8276b2:
    "Такой момент с ней — редкость, и я пока не готов его упустить."

# ch/kleio/events.rpy:1268
translate russian kleio_event_03_e6b84220:
    mike.say "Согласен, Клео. Правда."

# ch/kleio/events.rpy:1270
translate russian kleio_event_03_ff45c874:
    "Она улыбается, и на миг мне кажется, что красотой она не уступает рассвету. А если осмелеть — даже превосходит его."

# ch/kleio/events.rpy:1272
translate russian kleio_event_03_0bc4bcb3:
    kleio.say "Знаю, глупо. Просто рассвет. Их сотни, можно и на фотографиях посмотреть. Ничего особенного. И всё-таки для меня это место особенное, пусть и по-дурацки."

# ch/kleio/events.rpy:1273
translate russian kleio_event_03_a9e23b36:
    "Это моё место, мой дом, мой уголок вселенной. Никого сюда не приводила. Но надоело каждый день быть одной. Захотелось поделиться. И по какой-то глупой причине я привела тебя."

# ch/kleio/events.rpy:1274
translate russian kleio_event_03_a48164c5:
    mike.say "Это не глупо, Клео. Я очень рад, что ты так сделала."

# ch/kleio/events.rpy:1275
translate russian kleio_event_03_024c4860:
    "Беру её за руку, не желая лишними словами разрушать момент."

# ch/kleio/events.rpy:1276
translate russian kleio_event_03_4156f483:
    kleio.say "Правда?"

# ch/kleio/events.rpy:1277
translate russian kleio_event_03_9977d793:
    mike.say "Правда. Ни с кем другим я не хотел бы разделить этот момент."

# ch/kleio/events.rpy:1279
translate russian kleio_event_03_7eedce96:
    "Сидим в уютной тишине. Она примерно в полуметре от меня, погружена в мысли."

# ch/kleio/events.rpy:1280
translate russian kleio_event_03_a77c04e8:
    "Её лицо омрачено чем-то непонятным. Рассвет прекрасен, но она занимает меня сильнее."

# ch/kleio/events.rpy:1281
translate russian kleio_event_03_5293343d:
    "Наконец нарушаю молчание."

# ch/kleio/events.rpy:1282
translate russian kleio_event_03_c096c3af:
    mike.say "Клео, зачем ты привезла меня сюда?"

# ch/kleio/events.rpy:1283
translate russian kleio_event_03_583232f8:
    kleio.say "Не знаю. Разве недостаточно того, что я хотела с кем-то встретить рассвет?"

# ch/kleio/events.rpy:1284
translate russian kleio_event_03_80fadec9:
    "Ответ справедливый, но задевает. Я чувствую, что она недоговаривает."

# ch/kleio/events.rpy:1285
translate russian kleio_event_03_732f4dd8:
    mike.say "И правда только ради этого?"

# ch/kleio/events.rpy:1286
translate russian kleio_event_03_e33aabc9:
    kleio.say "Не знаю, [lssb_kleio.hero_name()]."

# ch/kleio/events.rpy:1288
translate russian kleio_event_03_335f8bfc:
    kleio.say "За каждым моим поступком обязательно должен скрываться глубокий, блядь, метафорический смысл?"

# ch/kleio/events.rpy:1289
translate russian kleio_event_03_82ddbeb7:
    kleio.say "Нельзя просто полюбоваться рассветом?"

# ch/kleio/events.rpy:1290
translate russian kleio_event_03_746be895:
    mike.say "Успокойся, Клео. Да, конечно можно."

# ch/kleio/events.rpy:1291
translate russian kleio_event_03_d77f3640:
    mike.say "Если заранее договориться. Но внезапный звонок, гонка по улицам... Сделай я так с тобой, ты бы тоже решила, что у меня особый повод."

# ch/kleio/events.rpy:1293
translate russian kleio_event_03_92d04b02:
    "Клео игнорирует меня. Чувствую, она снова закрылась."

# ch/kleio/events.rpy:1294
translate russian kleio_event_03_a6158563:
    kleio.say "Нет. Иногда людям просто хочется посмотреть на грёбаный рассвет, [lssb_kleio.hero_name()]."

# ch/kleio/events.rpy:1295
translate russian kleio_event_03_2a60589c:
    "Вздыхаю и наконец отвожу взгляд. Небо меняется почти так же быстро, как её настроение."

# ch/kleio/events.rpy:1296
translate russian kleio_event_03_d7124071:
    mike.say "Наверное, Клео. Наверное."

# ch/kleio/events.rpy:1297
translate russian kleio_event_03_289eb30d:
    "Мы сидим молча, а свет заполняет всё растущее расстояние между нами."

# ch/kleio/events.rpy:1301
translate russian kleio_event_03_4eb85284:
    "Наконец солнце поднимается слишком высоко, небо становится совсем голубым. Рассвет давно позади, и Клео встаёт."

# ch/kleio/events.rpy:1302
translate russian kleio_event_03_39935a33:
    kleio.say "Готов идти? Смотреть уже особо не на что."

# ch/kleio/events.rpy:1303
translate russian kleio_event_03_30fef57b:
    mike.say "Пожалуй, ты права. Пойдём."

# ch/kleio/events.rpy:1304
translate russian kleio_event_03_5a1f2f52:
    "Спускаемся молча, каждый по-своему запоминая увиденное."

# ch/kleio/events.rpy:1306
translate russian kleio_event_03_cbe93b20:
    kleio.say "Ну... Может, выпьем кофе или ещё чего? Поговорим о том, что увидели?"

# ch/kleio/events.rpy:1307
translate russian kleio_event_03_6885f03f:
    mike.say "Правда?"

# ch/kleio/events.rpy:1308
translate russian kleio_event_03_dcffa23b:
    kleio.say "Да. Только если хочешь. Выглядишь усталым, поэтому и предлагаю кофе."

# ch/kleio/events.rpy:1309
translate russian kleio_event_03_9cdd9d5e:
    mike.say "Да. Да! С удовольствием, Клео. С большим удовольствием."

# ch/kleio/events.rpy:1311
translate russian kleio_event_03_cc11f7f6:
    kleio.say "Отлично. Тогда поехали. Поехали."

# ch/kleio/events.rpy:1312
translate russian kleio_event_03_f9b84476:
    "Улыбаюсь ей и протягиваю руку через консоль, беря её за ладонь, прежде чем мы едем навстречу утреннему солнцу."

# ch/kleio/events.rpy:1316
translate russian kleio_event_03_a9b3c5fa:
    kleio.say "Ну... Наверное, всё. Могу отвезти тебя домой."

# ch/kleio/events.rpy:1317
translate russian kleio_event_03_b4425dbe:
    mike.say "Ты правда только это хотела показать?"

# ch/kleio/events.rpy:1318
translate russian kleio_event_03_2327476f:
    kleio.say "Да, [lssb_kleio.hero_name()]. Только это."

# ch/kleio/events.rpy:1319
translate russian kleio_event_03_8dd9cce0:
    "В её голосе слышится неловкость. Любопытство велико, но усталость сильнее, и я решаю оставить всё как есть."

# ch/kleio/events.rpy:1320
translate russian kleio_event_03_d32386d3:
    mike.say "Как скажешь, Клео. Поехали домой."

# ch/kleio/events.rpy:1321
translate russian kleio_event_03_923887a3:
    kleio.say "Ладно. Доспишь то, что я тебе не дала."

# ch/kleio/events.rpy:1322
translate russian kleio_event_03_d204b0f8:
    mike.say "Да... да. Хорошо."

# ch/kleio/events.rpy:1323
translate russian kleio_event_03_8ec7cc77:
    "Клео кивает и молча ведёт машину навстречу утреннему солнцу. А я растерянно гадаю, что же между нами происходит."

# ch/kleio/events.rpy:1334
translate russian kleio_just_friends_7bc80586:
    mike.say "Алло?"

# ch/kleio/events.rpy:1335
translate russian kleio_just_friends_4353569c:
    kleio.say "Это я. Занят?"

# ch/kleio/events.rpy:1336
translate russian kleio_just_friends_e6f8102c:
    mike.say "Не особо. Что такое?"

# ch/kleio/events.rpy:1337
translate russian kleio_just_friends_aa2c89d3:
    kleio.say "Магазин пластинок. Через двадцать минут. Не заставляй ждать."

# ch/kleio/events.rpy:1338
translate russian kleio_just_friends_2b85c23a:
    "Она кладёт трубку, не дав ответить."

# ch/kleio/events.rpy:1339
translate russian kleio_just_friends_dea10b7a:
    "Кое-что никогда не меняется."

# ch/kleio/events.rpy:1343
translate russian kleio_just_friends_e6c75b55:
    "Клео стоит у стены перед магазином, в наушниках, отбивая ботинком ритм, который слышит только она."

# ch/kleio/events.rpy:1344
translate russian kleio_just_friends_03ef9267:
    "Увидев меня, вынимает один наушник, но не улыбается."

# ch/kleio/events.rpy:1346
translate russian kleio_just_friends_fa10f3fe:
    kleio.say "Так. Скажу один раз. А ты дашь мне закончить."

# ch/kleio/events.rpy:1347
translate russian kleio_just_friends_5d78cccf:
    mike.say "Звучит зловеще."

# ch/kleio/events.rpy:1349
translate russian kleio_just_friends_b48927c1:
    kleio.say "Заткнись. Я сказала, дай закончить."

# ch/kleio/events.rpy:1351
translate russian kleio_just_friends_a7b001cb:
    kleio.say "То утро, поездка, рассвет... Было здорово."

# ch/kleio/events.rpy:1352
translate russian kleio_just_friends_e930a5b5:
    kleio.say "С тобой весело, [lssb_kleio.hero_name()]. Веселее, чем я думала, когда ты пришёл на наш концерт."

# ch/kleio/events.rpy:1354
translate russian kleio_just_friends_352063f5:
    kleio.say "Но я не встречаюсь с обычными людьми."

# ch/kleio/events.rpy:1355
translate russian kleio_just_friends_3f98dc66:
    mike.say "Обычными?"

# ch/kleio/events.rpy:1356
translate russian kleio_just_friends_5515a54c:
    kleio.say "Которые работают с девяти до пяти, а плейлист собирают из песен по радио."

# ch/kleio/events.rpy:1357
translate russian kleio_just_friends_84bd56de:
    kleio.say "Которые приходят на концерт, хлопают и уходят домой."

# ch/kleio/events.rpy:1358
translate russian kleio_just_friends_48c86abc:
    kleio.say "Я встречаюсь с теми, кто этим живёт. Кто тащит усилитель на третий этаж в два ночи, потому что ещё не доиграли."

# ch/kleio/events.rpy:1362
translate russian kleio_just_friends_398b39e9:
    kleio.say "И потом, ты парень. Обычно это уже первый минус."

# ch/kleio/events.rpy:1364
translate russian kleio_just_friends_f14c2241:
    kleio.say "Да и влюблялась я в основном в девушек."

# ch/kleio/events.rpy:1365
translate russian kleio_just_friends_12f22d5f:
    kleio.say "Парень должен быть совсем особенным."

# ch/kleio/events.rpy:1367
translate russian kleio_just_friends_788d107f:
    kleio.say "Ты не такой. И это нормально, не преступление."

# ch/kleio/events.rpy:1368
translate russian kleio_just_friends_eb7ba5f2:
    kleio.say "Просто мы друзья. Хорошие друзья, если ты не начнёшь чудить."

# ch/kleio/events.rpy:1371
translate russian kleio_just_friends_765d1b7c:
    mike.say "Меня дружба устраивает, Клео."

# ch/kleio/events.rpy:1373
translate russian kleio_just_friends_2e401958:
    kleio.say "Хорошо. Знала, что ты не полный придурок."

# ch/kleio/events.rpy:1376
translate russian kleio_just_friends_ffc2e439:
    mike.say "Значит, если бы я вступил в группу..."

# ch/kleio/events.rpy:1378
translate russian kleio_just_friends_9847bf98:
    kleio.say "Не надо. Не вступил — и всё. И сейчас за гитару ради моих трусов хвататься не будешь."

# ch/kleio/events.rpy:1379
translate russian kleio_just_friends_955a6404:
    kleio.say "Я такое за километр чую."

# ch/kleio/events.rpy:1382
translate russian kleio_just_friends_2578f7ed:
    mike.say "Ну, сама теряешь."

# ch/kleio/events.rpy:1384
translate russian kleio_just_friends_c5302691:
    kleio.say "Ха! Вот он, настоящий ты."

# ch/kleio/events.rpy:1385
translate russian kleio_just_friends_7f037756:
    kleio.say "Может быть. Уже не узнаем, да?"

# ch/kleio/events.rpy:1386
translate russian kleio_just_friends_2905baaa:
    kleio.say "А теперь пойдём. В дальней корзине есть бутлег, который я хочу. Платишь ты."

# ch/kleio/events.rpy:1388
translate russian kleio_just_friends_053deedb:
    "Она толкает дверь и скрывается между стеллажами, не оглядываясь."

# ch/kleio/events.rpy:1389
translate russian kleio_just_friends_d8002448:
    "Друзья так друзья."

# ch/kleio/events.rpy:1397
translate russian kleio_event_04_67df6845:
    "Обычно, когда машина барахлит, а я понятия не имею почему, везу её к дилеру или хотя бы в проверенный сервис."

# ch/kleio/events.rpy:1398
translate russian kleio_event_04_4b34c67f:
    "Так меньше хлопот: заберут, починят, а мне остаётся сидеть с кофе и журналом до готовности."

# ch/kleio/events.rpy:1399
translate russian kleio_event_04_f144d568:
    "Проблема только в цене. В этом месяце с деньгами было туже обычного, и я совершил ошибку — прислушался к совету."

# ch/kleio/events.rpy:1400
translate russian kleio_event_04_371d0891:
    "Надо было сразу заподозрить подвох, когда Саша оживилась при упоминании проблем с машиной. Сама-то она в них не специалист."

# ch/kleio/events.rpy:1401
translate russian kleio_event_04_eea40a1e:
    "Но она настойчиво расхваливала знакомого механика из местной мастерской, описывая его чуть ли не техническим чудотворцем."

# ch/kleio/events.rpy:1402
translate russian kleio_event_04_bd213854:
    "Не знаю, почему в итоге согласился: поверил или просто хотел, чтобы Саша перестала восторгаться этим «Кей», которого мне предстояло найти."

# ch/kleio/events.rpy:1403
translate russian kleio_event_04_5e6f84b7:
    "Решил, что загадочный Кей — какой-нибудь помешанный на тачках неандерталец, с которым она раньше встречалась. Узнал адрес и собрался заехать при случае."

# ch/kleio/events.rpy:1405
translate russian kleio_event_04_e2591cb7:
    "Подъезжаю к мастерской. Выглядит как место съёмок автомобильного реалити-шоу."

# ch/kleio/events.rpy:1406
translate russian kleio_event_04_722c6f60:
    "Ну, где бородатые обезьяны скупают дешёвый хлам, восстанавливают и продают идиотам, у которых денег больше, чем мозгов."

# ch/kleio/events.rpy:1407
translate russian kleio_event_04_c70701c6:
    "Ни одной такой особи поблизости не видно. Рискую посигналить, чтобы привлечь внимание."

# ch/kleio/events.rpy:1408
translate russian kleio_event_04_d2c50ca6:
    "Примерно через минуту появляется мужик в кепке дальнобойщика и клетчатой рубашке без рукавов, щурясь от дневного света."

# ch/kleio/events.rpy:1409
translate russian kleio_event_04_d29ba8a1:
    "Похож на недостающее звено эволюции, если бы гранж существовал на заре человечества. Сразу решаю: вот и загадочный Кей."

# ch/kleio/events.rpy:1410
translate russian kleio_event_04_37681a42:
    "Выхожу из машины и пытаюсь наладить контакт с современным первобытным человеком."

# ch/kleio/events.rpy:1411
translate russian kleio_event_04_e1deb31d:
    mike.say "Привет, ты Кей?"

# ch/kleio/events.rpy:1412
translate russian kleio_event_04_0f40b40c:
    "Мужик смотрит так, словно я сморозил невероятную глупость, и медленно качает головой."

# ch/kleio/events.rpy:1413
translate russian kleio_event_04_6b1bc64a:
    mike.say "Эм... Ладно. А Кей внутри?"

# ch/kleio/events.rpy:1414
translate russian kleio_event_04_babb9c13:
    mike.say "Просто подруга посоветовала показать ему мою машину."

# ch/kleio/events.rpy:1415
translate russian kleio_event_04_ec3f9dd0:
    "Он слегка качает головой и посмеивается. Начинаю думать, что Саша меня разыграла или я ошибся адресом."

# ch/kleio/events.rpy:1416
translate russian kleio_event_04_e4969271:
    "Но тут он кивает и указывает за плечо. Понимаю это как предложение поискать Кея внутри."

# ch/kleio/events.rpy:1417
translate russian kleio_event_04_d2aaa871:
    "Благодарно киваю и вхожу. Надеюсь, Кей окажется разговорчивее, хотя о дружелюбии, наверное, и мечтать не стоит."

# ch/kleio/events.rpy:1418
translate russian kleio_event_04_57c429cb:
    "Глаза привыкают к освещению. Передо мной обычная небольшая автомастерская."

# ch/kleio/events.rpy:1419
translate russian kleio_event_04_2ffd4290:
    "Вдоль стен стойки с инструментами, машины на подъёмниках, чтобы можно было работать снизу."

# ch/kleio/events.rpy:1420
translate russian kleio_event_04_22304083:
    "На стенах старые вывески, воздух пропитан запахом моторного масла."

# ch/kleio/events.rpy:1421
translate russian kleio_event_04_e1ef187b:
    "Сначала никого не видно, но треск и вспышки света ведут меня в глубину помещения."

# ch/kleio/events.rpy:1422
translate russian kleio_event_04_312d2265:
    "Я уже готовлюсь перекрикивать работающий сварочный аппарат, но, завернув за угол, замираю."

# ch/kleio/events.rpy:1423
translate russian kleio_event_04_862d644f:
    "Летящие искры подтверждают одну мою догадку. А то, что освещают их яркие вспышки, показывает, насколько я ошибался в другом."

# ch/kleio/events.rpy:1424
translate russian kleio_event_04_27bb65d7:
    "Лицо сварщика полностью скрыто маской."

# ch/kleio/events.rpy:1425
translate russian kleio_event_04_6a7de4ef:
    "Но комбинезон спущен до пояса, рукава завязаны вокруг талии, чтобы не мешали."

# ch/kleio/events.rpy:1426
translate russian kleio_event_04_cd290fc1:
    "Помимо него и тяжёлых сварочных перчаток, на человеке лишь облегающая маечка."

# ch/kleio/events.rpy:1427
translate russian kleio_event_04_af24297c:
    "Она подчёркивает маленькую упругую грудь, явно не стеснённую бюстгальтером."

# ch/kleio/events.rpy:1428
translate russian kleio_event_04_6ab3a7ae:
    "Ниже — подтянутый женственный живот с татуировками и мазками масла на бледной коже."

# ch/kleio/events.rpy:1429
translate russian kleio_event_04_815d69c9:
    "Никогда прежде вид сварки не заставлял мои трусы так тесно натягиваться..."

# ch/kleio/events.rpy:1430
translate russian kleio_event_04_ab4fdb7f:
    "Не глядя под ноги, задеваю что-то тяжёлое. Грохот выдаёт моё присутствие."

# ch/kleio/events.rpy:1431
translate russian kleio_event_04_1b4678fd:
    "Она сразу выключает сварку и поворачивается ко мне, стягивая и бросая перчатки."

# ch/kleio/events.rpy:1432
translate russian kleio_event_04_9db2ab08:
    "Мне кажется или она и правда медлит, прежде чем поднять маску?"

# ch/kleio/events.rpy:1433
translate russian kleio_event_04_67daa283:
    "Каковы бы ни были её намерения, эти несколько секунд позволяют мне в полной мере оценить всё, что вижу."

# ch/kleio/events.rpy:1434
translate russian kleio_event_04_fc439d94:
    "Теперь понятно: следы масла на животе оставлены её пальцами. Видимо, вытирала о себя руки."

# ch/kleio/events.rpy:1435
translate russian kleio_event_04_1332728e:
    "На открытой коже тонкий слой пота. Он пропитал майку, и ткань облепляет соски."

# ch/kleio/events.rpy:1436
translate russian kleio_event_04_7b94b0cd:
    "Когда она наконец поднимает щиток маски, я почти задерживаю дыхание в ожидании."

# ch/kleio/events.rpy:1438
translate russian kleio_event_04_c9804037:
    kleio.say "Привет, сердцеед. Нравится зрелище?"

# ch/kleio/events.rpy:1439
translate russian kleio_event_04_b68ab575:
    mike.say "А?.. Клео... Это правда ты?!"

# ch/kleio/events.rpy:1440
translate russian kleio_event_04_6ea2df9c:
    kleio.say "Не-а, я только делаю вид, что тут работаю."

# ch/kleio/events.rpy:1441
translate russian kleio_event_04_ab48e043:
    kleio.say "Вдруг знакомый балбес зайдёт, а я его заставлю рот разинуть!"

# ch/kleio/events.rpy:1442
translate russian kleio_event_04_ae2a7263:
    "Под привычный град колкостей Клео мой мозг наконец снова начинает работать."

# ch/kleio/events.rpy:1443
translate russian kleio_event_04_6fd4e8d9:
    "Конечно! Я подумал, Саша имела в виду имя Кей. А она говорила «Кей» — английское название первой буквы имени Клео."

# ch/kleio/events.rpy:1444
translate russian kleio_event_04_fbb22db5:
    "И не припомню, чтобы Саша вообще прямо сказала, что механик — мужчина."

# ch/kleio/events.rpy:1445
translate russian kleio_event_04_e1941dd3:
    "Теперь многое становится понятнее."

# ch/kleio/events.rpy:1446
translate russian kleio_event_04_c3e0bb5b:
    kleio.say "Дай угадаю: Саша прислала?"

# ch/kleio/events.rpy:1447
translate russian kleio_event_04_d05fe519:
    "Беспомощно киваю, к большому удовольствию Клео."

# ch/kleio/events.rpy:1448
translate russian kleio_event_04_f4139532:
    kleio.say "Да не расстраивайся. Она постоянно так делает. Ты не первый попался."

# ch/kleio/events.rpy:1449
translate russian kleio_event_04_2a541045:
    "Клео снимает сварочную маску. Волосы убраны под мокрую от пота бандану."

# ch/kleio/events.rpy:1450
translate russian kleio_event_04_c2b55f7e:
    "Она вытирает лоб тыльной стороной ладони. От неё пахнет маслом и смазкой, и это странно на меня действует."

# ch/kleio/events.rpy:1451
translate russian kleio_event_04_474dbd42:
    "Ведь она грязная, потная, в замасленном комбинезоне."

# ch/kleio/events.rpy:1452
translate russian kleio_event_04_3b9df119:
    "Но я всё равно ни на секунду не могу отвести взгляд."

# ch/kleio/events.rpy:1453
translate russian kleio_event_04_327aac1b:
    "В её виде и запахе есть что-то такое, отчего хочется изваляться и стать таким же грязным."

# ch/kleio/events.rpy:1454
translate russian kleio_event_04_a16b6a50:
    "Главное, чтобы валялись мы вместе..."

# ch/kleio/events.rpy:1455
translate russian kleio_event_04_3e3f51ce:
    kleio.say "Ну что, есть что-нибудь, на что мне надо взглянуть?"

# ch/kleio/events.rpy:1456
translate russian kleio_event_04_07f4f96d:
    kleio.say "Может, сумею тебе с этим помочь?"

# ch/kleio/events.rpy:1457
translate russian kleio_event_04_0c8807e1:
    "Не знаю, нарочно ли она говорит двусмысленно, поэтому решаю не обращать внимания и продолжать."

# ch/kleio/events.rpy:1458
translate russian kleio_event_04_92b61aa3:
    mike.say "Да... да... Хотел попросить тебя посмотреть машину."

# ch/kleio/events.rpy:1459
translate russian kleio_event_04_1fe0de1c:
    mike.say "Она снаружи. Хоть убей, не понимаю, что с ней не так!"

# ch/kleio/events.rpy:1461
translate russian kleio_event_04_0e7daae0:
    "Клео улыбается явно снисходительно, но всё же очень мило."

# ch/kleio/events.rpy:1462
translate russian kleio_event_04_699e7e27:
    kleio.say "Пойдём, [lssb_kleio.hero_name()]. Показывай, что у тебя!"

# ch/kleio/events.rpy:1464
translate russian kleio_event_04_06e31042:
    "Выходим на площадку. Я показываю Клео машину и подхожу к ней."

# ch/kleio/events.rpy:1470
translate russian kleio_event_04_3b914eb1:
    "Когда Клео впервые видит мою машину, чувствую, что равновесие между нами немного восстанавливается."

# ch/kleio/events.rpy:1471
translate russian kleio_event_04_e880cbaf:
    "Нет, глаза у неё из орбит не лезут. Она не из тех, кто так открыто показывает впечатления."

# ch/kleio/events.rpy:1472
translate russian kleio_event_04_8516ba20:
    "Но машину она всё же осматривает неспешно и внимательно."

# ch/kleio/events.rpy:1473
translate russian kleio_event_04_0a50ff7c:
    "А когда наконец снова обращает внимание на меня, на лице появляется невольное уважение."

# ch/kleio/events.rpy:1474
translate russian kleio_event_04_723b17a1:
    kleio.say "Ладно, признаю: не ожидала, что ты ездишь на такой впечатляющей машине!"

# ch/kleio/events.rpy:1475
translate russian kleio_event_04_f3183381:
    "Хочется позлорадствовать: от такой суровой особы, как Клео, трудно дождаться даже подобия комплимента."

# ch/kleio/events.rpy:1476
translate russian kleio_event_04_b057eddd:
    "Но её хорошее настроение так приятно, что я стараюсь его не портить."

# ch/kleio/events.rpy:1477
translate russian kleio_event_04_4626a3b8:
    mike.say "Ну, ты тоже не говорила, что работаешь механиком."

# ch/kleio/events.rpy:1478
translate russian kleio_event_04_5de30a2c:
    mike.say "Считай, мы квиты, да?"

# ch/kleio/events.rpy:1479
translate russian kleio_event_04_c738ad3b:
    "Клео легонько стукает меня по руке."

# ch/kleio/events.rpy:1480
translate russian kleio_event_04_4be773ee:
    "А через миг сама берёт меня под эту же руку."

# ch/kleio/events.rpy:1482
translate russian kleio_event_04_a6a2c679:
    "Прислоняется ко мне, продолжая почти мечтательно смотреть на машину."

# ch/kleio/events.rpy:1483
translate russian kleio_event_04_0ee8fffc:
    kleio.say "В этой тачке я с удовольствием покопаюсь."

# ch/kleio/events.rpy:1485
translate russian kleio_event_04_6491d782:
    kleio.say "Как закончу, сразу позвоню. Приедешь и проверишь мою работу, ладно?"

# ch/kleio/events.rpy:1486
translate russian kleio_event_04_d3d6b3bc:
    "Согласно киваю. Не уверен, стоит ли признаваться, что я так возбуждён, что слышу в каждом её слове двусмысленность."

# ch/kleio/events.rpy:1487
translate russian kleio_event_04_611197bd:
    "Оставляю ей ключи и вызываю такси домой."

# ch/kleio/events.rpy:1491
translate russian kleio_event_04_a268ce11:
    mike.say "Обычно я просто везу её к дилеру: пусть сами разбираются."

# ch/kleio/events.rpy:1492
translate russian kleio_event_04_3d7888a0:
    mike.say "Но раз уж я знаком с настоящим специалистом..."

# ch/kleio/events.rpy:1493
translate russian kleio_event_04_a1de1e14:
    "Когда я показываю свою машину, Клео заметно ухмыляется."

# ch/kleio/events.rpy:1494
translate russian kleio_event_04_53871e25:
    "В выборе автомобилей я всегда был консервативен и практичен."

# ch/kleio/events.rpy:1495
translate russian kleio_event_04_09ea788d:
    "Так что перед ней обычная безопасная японская модель с экономичным расходом топлива и..."

# ch/kleio/events.rpy:1496
translate russian kleio_event_04_769d8032:
    "Ладно, признаю: с кучей других достоинств, на которые ей, наверное, совершенно плевать!"

# ch/kleio/events.rpy:1497
translate russian kleio_event_04_a2d39447:
    kleio.say "Без проблем. С такими легко справиться, очень предсказуемые, понимаешь?"

# ch/kleio/events.rpy:1498
translate russian kleio_event_04_40ae7036:
    mike.say "Да... наверное."

# ch/kleio/events.rpy:1499
translate russian kleio_event_04_6bb32ee6:
    "Она косится на меня, явно понимая, насколько я здесь не в своей тарелке."

# ch/kleio/events.rpy:1500
translate russian kleio_event_04_4dd0560e:
    "И понимает, что я тоже вижу: моя машина — лишь удобный повод поддеть меня."

# ch/kleio/events.rpy:1501
translate russian kleio_event_04_0bf0d75f:
    kleio.say "Не забивай свою милую головку, [lssb_kleio.hero_name()]. Я всё улажу."

# ch/kleio/events.rpy:1502
translate russian kleio_event_04_24d38441:
    "Благодарю её и вызываю такси. Под взглядом Клео всё время чувствую себя неловким и никчёмным."

# ch/kleio/events.rpy:1504
translate russian kleio_event_04_5e280da3:
    "Когда такси трогается, Клео коротко машет мне с площадки."

# ch/kleio/events.rpy:1505
translate russian kleio_event_04_67e0f72b:
    "В комбинезоне она выглядит непривычно и при этом неоспоримо сексуально."

# ch/kleio/events.rpy:1506
translate russian kleio_event_04_188e9254:
    "Невольно гадаю, какие ещё её скрытые таланты мне предстоит открыть."

# ch/kleio/events.rpy:1513
translate russian kleio_event_05_6bc12ee3:
    "Каждую ноту моей гитары почти заглушает дождь снаружи."

# ch/kleio/events.rpy:1514
translate russian kleio_event_05_1dff7b4a:
    "Сочинять музыку в таких условиях утомительно. Уже думаю предложить закончить на сегодня."

# ch/kleio/events.rpy:1516
translate russian kleio_event_05_bf363dbd:
    "Но Клео отвлекает: лежит головой у меня на коленях, тихо напевает, а я машинально глажу её волосы. Как бы ни устал, не хочу, чтобы этот вечер заканчивался."

# ch/kleio/events.rpy:1518
translate russian kleio_event_05_11d7ab61:
    "Только собираюсь спросить, что дальше, как Саша раздражённо бросает ноты и вскакивает."

# ch/kleio/events.rpy:1520
translate russian kleio_event_05_00bcd95a:
    sasha.say "Больше не могу. Я вымоталась, а мы ничего не сделали."

# ch/kleio/events.rpy:1521
translate russian kleio_event_05_4967255e:
    "Клео растерянно поднимает голову с моих колен."

# ch/kleio/events.rpy:1522
translate russian kleio_event_05_4b46bd0e:
    kleio.say "Но, Саша, там же жуткий ливень! Точно хочешь уйти?"

# ch/kleio/events.rpy:1524
translate russian kleio_event_05_95b773b8:
    "Саша молчит, лишь сердито смотрит на Клео сонными глазами и собирает вещи."

# ch/kleio/events.rpy:1527
translate russian kleio_event_05_495dd56f:
    mike.say "Давай хотя бы провожу тебя, Саша."

# ch/kleio/events.rpy:1529
translate russian kleio_event_05_dcddb3eb:
    "Она раздражена, но соглашается. Я беру её вещи и придерживаю дверь по пути к выходу из маленькой студии."

# ch/kleio/events.rpy:1530
translate russian kleio_event_05_96d64092:
    "Едва мы отходим достаточно далеко, она разворачивается и быстро забирает вещи у меня из рук."

# ch/kleio/events.rpy:1532
translate russian kleio_event_05_afa3867b:
    sasha.say "Ты чего со мной увязался?"

# ch/kleio/events.rpy:1533
translate russian kleio_event_05_23987aa9:
    "Растерявшись, пытаюсь выдавить ответ."

# ch/kleio/events.rpy:1534
translate russian kleio_event_05_ff291236:
    mike.say "Что ты имеешь в виду?"

# ch/kleio/events.rpy:1535
translate russian kleio_event_05_2c14a7eb:
    sasha.say "Клео уже две недели от тебя не отлипает, а ты вместо того, чтобы воспользоваться шансом, который я вам дала, идёшь меня провожать! Вернись, она наверняка ждёт."

# ch/kleio/events.rpy:1536
translate russian kleio_event_05_eaca306b:
    mike.say "Ты о чём?"

# ch/kleio/events.rpy:1537
translate russian kleio_event_05_9a2599f6:
    mike.say "Я Клео не нравлюсь. Мы просто... друзья, наверное."

# ch/kleio/events.rpy:1538
translate russian kleio_event_05_3080b7f1:
    "Саша закатывает глаза."

# ch/kleio/events.rpy:1539
translate russian kleio_event_05_36c97647:
    sasha.say "Ты издеваешься? Знала, что ты идиот, но не думала, что ещё и слепой. Вернись. Хоть раз мне поверь, ладно?"

# ch/kleio/events.rpy:1540
translate russian kleio_event_05_20ffd39f:
    "Её слова смущают, но я киваю. Я вижу, как Клео на меня смотрит, и определённо хочу большего. Может, этот надоедливый ливень подарил мне шанс."

# ch/kleio/events.rpy:1542
translate russian kleio_event_05_66bf5147:
    "Слегка улыбнувшись Саше, прощаюсь и возвращаюсь в студию."

# ch/kleio/events.rpy:1544
translate russian kleio_event_05_ff175f50:
    "Ничего не говорю, но стараюсь помочь, несмотря на раздражение от её поведения."

# ch/kleio/events.rpy:1545
translate russian kleio_event_05_b9a0d9ea:
    "Быстро собираю вещи, вручаю ей стопку нот и пододвигаю рюкзак."

# ch/kleio/events.rpy:1547
translate russian kleio_event_05_55bc42bb:
    sasha.say "Спасибо."

# ch/kleio/events.rpy:1548
translate russian kleio_event_05_0242225c:
    "Я улыбаюсь."

# ch/kleio/events.rpy:1549
translate russian kleio_event_05_355c5dcd:
    mike.say "Не за что, Саша. Спокойной ночи."

# ch/kleio/events.rpy:1550
translate russian kleio_event_05_63d1352a:
    "Клео тоже прощается."

# ch/kleio/events.rpy:1551
translate russian kleio_event_05_37d67055:
    kleio.say "Спокойной ночи!"

# ch/kleio/events.rpy:1553
translate russian kleio_event_05_1a01171b:
    "В ответ лишь грохот захлопнувшейся двери, сопровождаемый раскатом грома."

# ch/kleio/events.rpy:1555
translate russian kleio_event_05_07531ccc:
    mike.say "Саша, по-моему, это плохая идея. На улице опасно."

# ch/kleio/events.rpy:1556
translate russian kleio_event_05_a36e0986:
    "Она прожигает меня злым взглядом, резко собирая вещи."

# ch/kleio/events.rpy:1558
translate russian kleio_event_05_f3bb5efd:
    sasha.say "А ты кто такой, чтобы меня останавливать?"

# ch/kleio/events.rpy:1559
translate russian kleio_event_05_02a59dd2:
    "Я колеблюсь, но ливень не стихает. Очень не хочется, чтобы Саша наделала глупостей от усталости и раздражения."

# ch/kleio/events.rpy:1560
translate russian kleio_event_05_021ffe8a:
    "Встаю и подхожу к ней."

# ch/kleio/events.rpy:1561
translate russian kleio_event_05_d713cfd7:
    mike.say "Саша..."

# ch/kleio/events.rpy:1563
translate russian kleio_event_05_f2bbfa6e:
    sasha.say "Заткнись, [lssb_kleio.hero_name()]!"

# ch/kleio/events.rpy:1566
translate russian kleio_event_05_26aafff5:
    "Огрызнувшись, она отворачивается и хлопает дверью у меня перед носом."

# ch/kleio/events.rpy:1567
translate russian kleio_event_05_6d09158d:
    "За спиной Клео втягивает воздух и тихо присвистывает."

# ch/kleio/events.rpy:1568
translate russian kleio_event_05_1435b4d1:
    kleio.say "Жесть."

# ch/kleio/events.rpy:1571
translate russian kleio_event_05_5c6d96a1:
    "Неуверенно возвращаюсь к Клео. Она сидит по-турецки, опершись локтями на колени, и наклонилась так, что вырез широко раскрыт. Невольно смотрю на её прекрасную грудь."

# ch/kleio/events.rpy:1572
translate russian kleio_event_05_b1bb25a5:
    "Она замечает взгляд, но не прикрывается. С лёгкой улыбкой невинно наклоняется ещё чуть ниже — ровно настолько, чтобы удержать мой интерес."

# ch/kleio/events.rpy:1573
translate russian kleio_event_05_5dd3b2da:
    "Мысли путаются, я пытаюсь что-то выговорить."

# ch/kleio/events.rpy:1574
translate russian kleio_event_05_b8d4ae15:
    mike.say "Ну, э-э... Чем займёмся до конца вечера?"

# ch/kleio/events.rpy:1576
translate russian kleio_event_05_392b35b8:
    "Клео улыбается и пожимает плечами. Её грудь покачивается."

# ch/kleio/events.rpy:1577
translate russian kleio_event_05_4b757db0:
    kleio.say "Не знаю."

# ch/kleio/events.rpy:1579
translate russian kleio_event_05_cbeaa930:
    "Вдалеке гремит гром, и она слегка вздрагивает."

# ch/kleio/events.rpy:1580
translate russian kleio_event_05_2f7488bb:
    kleio.say "Туда я точно не пойду."

# ch/kleio/events.rpy:1581
translate russian kleio_event_05_fe0f364f:
    "Отрываю взгляд от её груди и снова сажусь рядом."

# ch/kleio/events.rpy:1582
translate russian kleio_event_05_857a5f3b:
    mike.say "Ты сегодня очень хорошо выглядишь, Клео."

# ch/kleio/events.rpy:1584
translate russian kleio_event_05_1cfc8aaa:
    "Она краснеет, но не отворачивается. Пока я подхожу, смотрит прямо мне в глаза, почти соблазняюще."

# ch/kleio/events.rpy:1585
translate russian kleio_event_05_fbe48ef9:
    "С колотящимся сердцем медленно сажусь рядом."

# ch/kleio/events.rpy:1586
translate russian kleio_event_05_c3d264e9:
    "Выдавливаю лишь невнятный звук. Покраснев, пересекаю комнату."

# ch/kleio/events.rpy:1587
translate russian kleio_event_05_5369e2a0:
    "Клео замечает моё волнение и ухмыляется, внимательно следя, как я сажусь."

# ch/kleio/events.rpy:1588
translate russian kleio_event_05_4a9caab5:
    "Она тут же опускает голову мне на плечо и смотрит снизу вверх, медленно моргая."

# ch/kleio/events.rpy:1589
translate russian kleio_event_05_e0a685d9:
    "Её взгляд смущает и возбуждает. Кожа словно горит."

# ch/kleio/events.rpy:1590
translate russian kleio_event_05_61f4021c:
    "Я чуть меняю позу, пытаясь скрыть растущий стояк."

# ch/kleio/events.rpy:1592
translate russian kleio_event_05_8be7e850:
    "Бесполезно. Клео выпрямляется и перебирается передо мной, встав на колени и усевшись на пятки."

# ch/kleio/events.rpy:1593
translate russian kleio_event_05_d0c11d56:
    "Она скользит взглядом по моей груди к растущей выпуклости. Заговорив, держит лицо в нескольких сантиметрах от моего."

# ch/kleio/events.rpy:1595
translate russian kleio_event_05_bc054f5c:
    kleio.say "Возбудился?"

# ch/kleio/events.rpy:1596
translate russian kleio_event_05_7142f9c1:
    "Стараюсь не уступать ей и наклоняюсь так близко, что наши носы соприкасаются."

# ch/kleio/events.rpy:1597
translate russian kleio_event_05_afd6a420:
    "Слегка ухмыляюсь, смотрю ей в глаза и лишь на миг перевожу взгляд на губы."

# ch/kleio/events.rpy:1598
translate russian kleio_event_05_4b6f745e:
    mike.say "А как тут устоять?"

# ch/kleio/events.rpy:1599
translate russian kleio_event_05_aca4ac0a:
    "Едва сдерживаюсь, глядя, как она медленно приближается."

# ch/kleio/events.rpy:1600
translate russian kleio_event_05_3c44c32c:
    "Краснею до ушей и снова ёрзаю, пытаясь спрятать стояк."

# ch/kleio/events.rpy:1601
translate russian kleio_event_05_d8c122eb:
    mike.say "Эм, прости."

# ch/kleio/events.rpy:1602
translate russian kleio_event_05_91235231:
    "Она протягивает руку, берёт меня за колено и не даёт сдвинуться."

# ch/kleio/events.rpy:1603
translate russian kleio_event_05_1a2b8944:
    kleio.say "Нет, не двигайся. Я не против."

# ch/kleio/events.rpy:1608
translate russian kleio_event_05_83894de9:
    "Через пару секунд её губы уже на моих."

# ch/kleio/events.rpy:1609
translate russian kleio_event_05_1eb89a99:
    "Она яростно целует меня, раздвигает мои ноги и забирается на колени, обхватив талию своими длинными красивыми ногами."

# ch/kleio/events.rpy:1610
translate russian kleio_event_05_b1e0b265:
    "Я запускаю пальцы в её короткие волосы, а она обнимает меня и впивается ногтями в спину."

# ch/kleio/events.rpy:1611
translate russian kleio_event_05_7bb0a0aa:
    "От её коготков я ахаю и чувствую улыбку у своих раскрытых губ."

# ch/kleio/events.rpy:1612
translate russian kleio_event_05_27ccd5f9:
    "Она этого и добивалась: просовывает язык мне в рот, жадно целует и начинает двигать бёдрами, прижимаясь ко мне."

# ch/kleio/events.rpy:1613
translate russian kleio_event_05_58727c79:
    "Член теперь твёрдый как камень, и я больше не пытаюсь его прятать."

# ch/kleio/events.rpy:1614
translate russian kleio_event_05_c91ac6c9:
    "Она трётся об меня, а я без всякого стеснения стону ей в губы, отвечая на поцелуи."

# ch/kleio/events.rpy:1615
translate russian kleio_event_05_0047d2b8:
    "Не сдержавшись, спускаюсь поцелуями к шее, обвожу губами татуировку и ловлю каждый её стон."

# ch/kleio/events.rpy:1616
translate russian kleio_event_05_803abd7b:
    "Двигаю бёдрами ей навстречу в том же ритме, показывая, как сильно её хочу."

# ch/kleio/events.rpy:1617
translate russian kleio_event_05_6a269ce4:
    "Её руки скользят по моей спине и порой впиваются в неё, когда я слегка прикусываю кожу."

# ch/kleio/events.rpy:1618
translate russian kleio_event_05_e975f313:
    "Наконец она добирается до пояса моих джинсов и, не отводя взгляда от моих глаз, начинает их расстёгивать."

# ch/kleio/events.rpy:1659
translate russian kleio_event_05_25f3f032:
    "Я не отстаю: руки уже у её пояса, расстёгивают застёжку."

# ch/kleio/events.rpy:1660
translate russian kleio_event_05_45a1bc1c:
    "Клео без промедления стягивает с меня джинсы, словно голодный зверь, целуя каждый открывшийся участок кожи."

# ch/kleio/events.rpy:1661
translate russian kleio_event_05_0b006b04:
    "Отвечаю тем же: снимаю с неё верх, расстёгиваю лифчик и наклоняюсь целовать грудь, пока она помогает мне окончательно сбросить джинсы."

# ch/kleio/events.rpy:1662
translate russian kleio_event_05_cfff100c:
    "Её кожа горяча. Медленно укладываю Клео на ближайший стол, прижимаясь к ней и чувствуя её стоны."

# ch/kleio/events.rpy:1663
translate russian kleio_event_05_bef201da:
    "Она судорожно дышит, а я продолжаю целовать, не в силах оторваться от прекрасных изгибов её тела."

# ch/kleio/events.rpy:1667
translate russian kleio_event_05_3f464c0a:
    "Наконец она отстраняет меня и поднимает моё лицо к своему."

# ch/kleio/events.rpy:1668
translate russian kleio_event_05_eef953ab:
    "Мы снова сплетаемся, словно фигуры на выставке современного искусства, торопясь получить друг от друга как можно больше."

# ch/kleio/events.rpy:1669
translate russian kleio_event_05_8d360e7c:
    "Задыхаясь, она на миг отстраняется и смотрит мне прямо в глаза. Я знаю, чего она хочет, но хочу услышать."

# ch/kleio/events.rpy:1670
translate russian kleio_event_05_e9cb6ffa:
    mike.say "Чего ты хочешь, Клео?"

# ch/kleio/events.rpy:1671
translate russian kleio_event_05_63d0152e:
    "Она приподнимается, обхватывает ногами мою талию и притягивает мои бёдра к себе."

# ch/kleio/events.rpy:1672
translate russian kleio_event_05_83823265:
    kleio.say "Заткнись и трахни меня!"

# ch/kleio/events.rpy:1685
translate russian kleio_event_05_9082cca7:
    "Больше указаний не нужно. Толкаюсь вперёд, быстро наполняя её и заставляя ахнуть от удовольствия."

# ch/kleio/events.rpy:1686
translate russian kleio_event_05_3228554b:
    "На миг замираю, ошеломлённый ощущениями, затем медленно начинаю двигаться, набирая ритм."

# ch/kleio/events.rpy:1687
translate russian kleio_event_05_9ae692e3:
    "Она ахает и стонет при каждом толчке, когда мои бёдра грубо ударяются о её ягодицы."

# ch/kleio/events.rpy:1688
translate russian kleio_event_05_9e1eada5:
    "Обхватывает свою попку и разводит ягодицы, помогая мне войти глубже."

# ch/kleio/events.rpy:1689
translate russian kleio_event_05_33c0c099:
    "Я продолжаю, настолько поглощённый удовольствием от её тела, что почти ни о чём другом не могу думать."

# ch/kleio/events.rpy:1690
translate russian kleio_event_05_8737ea1d:
    "Но вскоре замечаю, как беспокойно она извивается подо мной."

# ch/kleio/events.rpy:1691
translate russian kleio_event_05_a4b6ace2:
    "Мы оба пылаем. Я отчаянно хочу ещё больше: овладеть ею как можно быстрее и сильнее."

# ch/kleio/events.rpy:1692
translate russian kleio_event_05_0bb5a0a5:
    "Хочу Клео больше всего на свете и делаю всё, чтобы получить её."

# ch/kleio/events.rpy:1694
translate russian kleio_event_05_c09f81d3:
    "Её стоны становятся резче и громче, дыхание сбивается. Понимаю, она уже близко."

# ch/kleio/events.rpy:1695
translate russian kleio_event_05_cf157860:
    "Удерживаю ритм, отчаянно желая довести до края нас обоих."

# ch/kleio/events.rpy:1696
translate russian kleio_event_05_2e1243c8:
    "Она стонет, вскрикивает, почти кричит от наслаждения. Мои стоны сливаются с её голосом: я бормочу её имя вперемежку с возгласами удовольствия."

# ch/kleio/events.rpy:1697
translate russian kleio_event_05_33c1b0a6:
    "Её тело — огонь, и я загорелся от него."

# ch/kleio/events.rpy:1698
translate russian kleio_event_05_d63ec1ed:
    "Во мне нарастает напряжение. Трахаю её изо всех сил, словно взведённый пистолет за мгновение до выстрела."

# ch/kleio/events.rpy:1700
translate russian kleio_event_05_f6bb99ac:
    "Будто по уговору, она запрокидывает голову, дрожа и стеная. Пульсация её оргазма запускает мой."

# ch/kleio/events.rpy:1706
translate russian kleio_event_05_1f18daa6:
    "Я кончаю, громко выкрикивая её имя. Всё накопившееся напряжение разряжается в миг чистого наслаждения."

# ch/kleio/events.rpy:1708
translate russian kleio_event_05_e7ebe7e8:
    "На мгновение остаётся лишь сладчайший экстаз. Затем осторожно выхожу из неё и опускаюсь на пол. Она тут же садится рядом."

# ch/kleio/events.rpy:1712
translate russian kleio_event_05_717f08d5:
    "Мы молча переводим дыхание и прижимаемся друг к другу."

# ch/kleio/events.rpy:1713
translate russian kleio_event_05_9275e767:
    "Обнимаю её тёплое тело и притягиваю ближе, пока она прячет лёгкую улыбку."

# ch/kleio/events.rpy:1714
translate russian kleio_event_05_e3b60d16:
    "Свою я и не думаю скрывать: улыбаюсь во весь рот."

# ch/kleio/events.rpy:1715
translate russian kleio_event_05_7a934eee:
    "Наконец она приподнимается, прислушивается и нарушает тишину."

# ch/kleio/events.rpy:1716
translate russian kleio_event_05_ec6a87e4:
    kleio.say "Знаешь, кажется, дождь кончился."

# ch/kleio/events.rpy:1717
translate russian kleio_event_05_6547605e:
    "Затем с явной ухмылкой падает обратно мне в объятия. Я не могу не рассмеяться."

# ch/kleio/events.rpy:1718
translate russian kleio_event_05_0abf6dba:
    mike.say "А знаешь, Клео, ты совершенно права."

# ch/kleio/events.rpy:1720
translate russian kleio_event_05_b7377014:
    "Она улыбается и смотрит на меня из моих объятий."

# ch/kleio/events.rpy:1722
translate russian kleio_event_05_a944851c:
    kleio.say "Хочешь остаться здесь?"

# ch/kleio/events.rpy:1723
translate russian kleio_event_05_96210302:
    mike.say "А может, пойдём ко мне?"

# ch/kleio/events.rpy:1724
translate russian kleio_event_05_55c8f441:
    "Подмигиваю, мягко отстраняю её и помогаю собрать одежду."

# ch/kleio/events.rpy:1725
translate russian kleio_event_05_752a9488:
    mike.say "Уверен, там мы сможем ещё... повеселиться?"

# ch/kleio/events.rpy:1731
translate russian kleio_event_05_c8b835c5:
    "Она с энтузиазмом соглашается. Быстро одеваемся и выбегаем из тёмной студии в ночь — двое влюблённых, на миг ослеплённых друг другом."

# ch/kleio/events.rpy:1732
translate russian kleio_event_05_e6bbe3f9:
    "Прижимаю её как можно ближе, наслаждаясь трепетным стуком её сердца."

# ch/kleio/events.rpy:1733
translate russian kleio_event_05_cbe1abab:
    mike.say "Клео, кажется, я вообще никогда не хочу уходить."

# ch/kleio/events.rpy:1743
translate russian kleio_event_05b_745dce88:
    "С тех пор как я оставил машину у Клео, прошло слишком мало времени, чтобы забыть её горячий, перепачканный вид."

# ch/kleio/events.rpy:1744
translate russian kleio_event_05b_6e0df1fa:
    "Но и для того, чтобы найти неисправность, не говоря уже о ремонте, времени тоже явно было мало."

# ch/kleio/events.rpy:1751
translate russian kleio_event_05b_cec8ef39:
    "Так что можете представить моё удивление, когда вскоре после этого звонит телефон и на экране появляется имя Клео."

# ch/kleio/events.rpy:1756
translate russian kleio_event_05b_3bd01618:
    mike.say "Привет, Клео. Насчёт машины, да?"

# ch/kleio/events.rpy:1757
translate russian kleio_event_05b_6624ecfa:
    kleio.say "Да, [lssb_kleio.hero_name()], всё верно..."

# ch/kleio/events.rpy:1758
translate russian kleio_event_05b_0a5c223d:
    "Она замолкает, и я невольно издаю раздражённый вздох. Повисает неловкая тишина."

# ch/kleio/events.rpy:1759
translate russian kleio_event_05b_da0847c3:
    mike.say "Ремонт влетит в копеечку, да?"

# ch/kleio/events.rpy:1760
translate russian kleio_event_05b_51080231:
    mike.say "Ладно, ладно... Просто скажи, сколько. Давай уже покончим с этим!"

# ch/kleio/events.rpy:1761
translate russian kleio_event_05b_267d22cb:
    "Жду ответа со страхом. А ведь я и привёз машину к ней в надежде избежать огромного счёта."

# ch/kleio/events.rpy:1762
translate russian kleio_event_05b_7e09b25a:
    "Но напряжённое молчание продолжается, и я волнуюсь ещё сильнее."

# ch/kleio/events.rpy:1763
translate russian kleio_event_05b_a549c047:
    mike.say "Ну, Клео, неужели всё так плохо?!"

# ch/kleio/events.rpy:1764
translate russian kleio_event_05b_a731a749:
    kleio.say "Нет... нет... Ты не так понял."

# ch/kleio/events.rpy:1765
translate russian kleio_event_05b_2f461b0e:
    kleio.say "С машиной всё хорошо. Даже лучше прежнего."

# ch/kleio/events.rpy:1766
translate russian kleio_event_05b_6ae43d73:
    "С трудом верю своим ушам."

# ch/kleio/events.rpy:1767
translate russian kleio_event_05b_0105b06e:
    mike.say "Что с ней, Клео?"

# ch/kleio/events.rpy:1768
translate russian kleio_event_05b_09273645:
    kleio.say "Починила. Когда разобралась, оказалось, проблема простая."

# ch/kleio/events.rpy:1769
translate russian kleio_event_05b_497e8fa1:
    "Смотрю на часы и недоумённо хмурюсь."

# ch/kleio/events.rpy:1770
translate russian kleio_event_05b_7785a812:
    mike.say "Ну... А до утра это не могло подождать?"

# ch/kleio/events.rpy:1771
translate russian kleio_event_05b_6c912d01:
    mike.say "В прежнем сервисе всегда днём звонили, чтобы я забрал машину."

# ch/kleio/events.rpy:1772
translate russian kleio_event_05b_cf0edc6d:
    "Снова напряжённая тишина. Мысленно умоляю Клео прямо сказать, чего она хочет."

# ch/kleio/events.rpy:1773
translate russian kleio_event_05b_4fb7e966:
    kleio.say "Могло, конечно... Просто я занялась ею после работы. Ты ведь друг."

# ch/kleio/events.rpy:1774
translate russian kleio_event_05b_905f5597:
    kleio.say "Подумала, вдруг захочешь сейчас заехать, забрать её? Заодно объясню, что было не так."

# ch/kleio/events.rpy:1775
translate russian kleio_event_05b_2f8c9ea0:
    "Теперь за свою резкость чувствую себя худшим человеком на свете."

# ch/kleio/events.rpy:1776
translate russian kleio_event_05b_5f08e1aa:
    mike.say "А, понятно..."

# ch/kleio/events.rpy:1777
translate russian kleio_event_05b_4dda90d6:
    mike.say "Слушай, прости, Клео. Я повёл себя неблагодарно."

# ch/kleio/events.rpy:1778
translate russian kleio_event_05b_51e20bb1:
    mike.say "Может, забудем это и начнём разговор заново?"

# ch/kleio/events.rpy:1779
translate russian kleio_event_05b_f0e0eb7f:
    "На другом конце линии слышится тихий смешок."

# ch/kleio/events.rpy:1780
translate russian kleio_event_05b_f2012d94:
    kleio.say "Ладно. Только обещай больше не вести себя как козёл."

# ch/kleio/events.rpy:1781
translate russian kleio_event_05b_ce54f785:
    mike.say "Хорошо, Клео. Обещаю."

# ch/kleio/events.rpy:1782
translate russian kleio_event_05b_8edca91b:
    mike.say "С удовольствием приеду и посмотрю на твою работу."

# ch/kleio/events.rpy:1783
translate russian kleio_event_05b_d836dca8:
    mike.say "Сейчас возьму такси и буду."

# ch/kleio/events.rpy:1785
translate russian kleio_event_05b_ddcdffcd:
    "Вскоре приезжаю в мастерскую. Выхожу из такси: фасад и площадка перед ним погружены во тьму."

# ch/kleio/events.rpy:1786
translate russian kleio_event_05b_251b66ec:
    "Из щелей вокруг дверей пробивается свет, но здание всё равно выглядит пустым."

# ch/kleio/events.rpy:1787
translate russian kleio_event_05b_0f187e67:
    kleio.say "Эй, [lssb_kleio.hero_name()], сюда!"

# ch/kleio/events.rpy:1789
translate russian kleio_event_05b_e9fec2f5:
    "Иду на голос. Клео стоит в полосе света из открытой боковой двери."

# ch/kleio/events.rpy:1790
translate russian kleio_event_05b_3df0f4d4:
    "Она подзывает меня с неожиданным нетерпением, а затем закрывает за мной дверь."

# ch/kleio/events.rpy:1791
translate russian kleio_event_05b_96d9c6b7:
    "Не придаю значения тому, что она ещё и запирает её: район тут не лучший."

# ch/kleio/events.rpy:1792
translate russian kleio_event_05b_b6072b84:
    "На ней почти те же комбинезон, майка и бандана, что и в день, когда я пригнал машину."

# ch/kleio/events.rpy:1793
translate russian kleio_event_05b_b0b2671c:
    "Но мазки масла на животе, руках и даже щеке, конечно, свежие."

# ch/kleio/events.rpy:1794
translate russian kleio_event_05b_0f8cb992:
    "Пока Клео ведёт меня к машине в глубине мастерской, я почти не слышу её слов."

# ch/kleio/events.rpy:1795
translate russian kleio_event_05b_297c7106:
    "Меня занимает только исходящий от неё запах пота и моторного масла."

# ch/kleio/events.rpy:1796
translate russian kleio_event_05b_36f23e8c:
    "И то, как покачивается её попка под тяжестью комбинезона, спущенного до пояса и завязанного вокруг талии."

# ch/kleio/events.rpy:1797
translate russian kleio_event_05b_05047c6d:
    "У машины честно пытаюсь слушать объяснения, но сейчас они для меня — просто белый шум."

# ch/kleio/events.rpy:1798
translate russian kleio_event_05b_3e6a9eef:
    "Остаётся только кивать, пока она не предлагает сесть за руль."

# ch/kleio/events.rpy:1800
translate russian kleio_event_05b_6881a8bb:
    "Не зная, чего она ждёт, просто поворачиваю ключ и пару раз поддаю газу."

# ch/kleio/events.rpy:1802
translate russian kleio_event_05b_ee47a9ae:
    "Каждый раз Клео словно вздрагивает, и на лице у неё странное выражение."

# ch/kleio/events.rpy:1803
translate russian kleio_event_05b_5d804c86:
    mike.say "Звучит отлично!"

# ch/kleio/events.rpy:1804
translate russian kleio_event_05b_f1cd481c:
    kleio.say "Да, ещё как..."

# ch/kleio/events.rpy:1806
translate russian kleio_event_05b_9441650e:
    kleio.say "Хотела бы я, чтобы ты и меня так завёл..."

# ch/kleio/events.rpy:1807
translate russian kleio_event_05b_fc63e792:
    "Я так отвлечён починенной машиной и желанием к Клео, что почти пропускаю её слова."

# ch/kleio/events.rpy:1808
translate russian kleio_event_05b_297f62db:
    mike.say "Что?.."

# ch/kleio/events.rpy:1810
translate russian kleio_event_05b_31a31d81:
    "Повторяя, она выглядит почти застенчивой. Это удивляет едва ли не сильнее самих слов."

# ch/kleio/events.rpy:1811
translate russian kleio_event_05b_03085875:
    kleio.say "Я сказала... Хочу, чтобы ты и меня так завёл..."

# ch/kleio/events.rpy:1812
translate russian kleio_event_05b_b74657f6:
    "Поднимаю взгляд и только теперь замечаю, что она подошла вплотную, встав в проёме открытой двери."

# ch/kleio/events.rpy:1813
translate russian kleio_event_05b_599cf3c5:
    "Перед глазами её голый живот. Достаточно протянуть руку, чтобы коснуться."

# ch/kleio/events.rpy:1814
translate russian kleio_event_05b_3ae07f91:
    "Теперь понимаю странное выражение её лица, когда я газовал."

# ch/kleio/events.rpy:1815
translate russian kleio_event_05b_15ccaef0:
    "Невероятно, но Клео, похоже, возбудилась от этого звука!"

# ch/kleio/events.rpy:1816
translate russian kleio_event_05b_9ea85d6a:
    "Она ревнует к тому, как я обращаюсь с машиной!"

# ch/kleio/events.rpy:1817
translate russian kleio_event_05b_e04ab910:
    "Всё начинает складываться: её восхищение моей тачкой, ремонт после работы."

# ch/kleio/events.rpy:1818
translate russian kleio_event_05b_b0028b23:
    "И приглашение приехать поздно вечером якобы проверить результат."

# ch/kleio/events.rpy:1819
translate russian kleio_event_05b_618a67ed:
    "Неужели она настолько помешана на машинах, что, сочтя меня таким же, сразу иначе на меня взглянула?"

# ch/kleio/events.rpy:1820
translate russian kleio_event_05b_d947d70a:
    kleio.say "Ну же, [lssb_kleio.hero_name()]... Не заставляй меня так стоять!"

# ch/kleio/events.rpy:1822
translate russian kleio_event_05b_baf94db6:
    "Она стягивает майку и бросает в сторону, обнажая гордо выступающую грудь."

# ch/kleio/events.rpy:1823
translate russian kleio_event_05b_bd69402a:
    "До этого я не замечал, как прохладно в мастерской."

# ch/kleio/events.rpy:1824
translate russian kleio_event_05b_629e7e63:
    "Теперь замечаю: её маленькие соски твердеют от холода, возбуждения или всего сразу."

# ch/kleio/events.rpy:1825
translate russian kleio_event_05b_01ea8ce2:
    kleio.say "Пожалуйста, обращайся со мной так же, как с этой машиной."

# ch/kleio/events.rpy:1826
translate russian kleio_event_05b_b6b2666d:
    kleio.say "Обещаю, прокатиться на мне будет не менее приятно..."

# ch/kleio/events.rpy:1827
translate russian kleio_event_05b_60984592:
    "Меня и так не надо уговаривать. За последние сутки образ Клео в грязном комбинезоне ни на минуту не выходил из головы."

# ch/kleio/events.rpy:1828
translate russian kleio_event_05b_b5739111:
    "Ничего не отвечая, поднимаю руки и зажимаю её соски между большими и указательными пальцами."

# ch/kleio/events.rpy:1829
translate russian kleio_event_05b_e24afadb:
    "Я не собираюсь обращаться с Клео как с машиной, но, сжимая соски, словно нажимаю кнопку зажигания."

# ch/kleio/events.rpy:1830
translate russian kleio_event_05b_1dccee0a:
    "Лишь когда она почти всхлипывает от облегчения, понимаю, как сильно ей этого хотелось."

# ch/kleio/events.rpy:1831
translate russian kleio_event_05b_0d526092:
    "Мысль о том, что такая жёсткая и угрюмая с виду девушка сейчас возбуждена и уязвима, мгновенно вызывает у меня стояк."

# ch/kleio/events.rpy:1832
translate russian kleio_event_05b_7cfc0b6e:
    "Выхожу из машины, продолжая пощипывать соски и ласкать грудь, и нахожу губами её рот."

# ch/kleio/events.rpy:1837
translate russian kleio_event_05b_37f1adaa:
    "Сначала пытаюсь поцеловать нежно, но её язык почти сразу настойчиво проникает мне в рот."

# ch/kleio/events.rpy:1838
translate russian kleio_event_05b_8b67608f:
    "Мы так близко, что я чувствую лишь запах смазки и пота на её стройном упругом теле."

# ch/kleio/events.rpy:1839
translate russian kleio_event_05b_c9766a45:
    "Теперь, в объятиях, этот запах дурманит ещё сильнее. До встречи с ней я бы не поверил, что такое меня возбудит."

# ch/kleio/events.rpy:1840
translate russian kleio_event_05b_2a65d8c1:
    "Уже знаю: сейчас будет не до глубокой романтики."

# ch/kleio/events.rpy:1841
translate russian kleio_event_05b_4262ccce:
    "Если романтический секс — спокойная поездка за город, то это будет бешеный заезд по гоночной прямой."

# ch/kleio/events.rpy:1842
translate russian kleio_event_05b_52f4f183:
    "Тесню Клео назад, не встречая сопротивления, и почти лихорадочно оглядываюсь в поисках подходящего места."

# ch/kleio/events.rpy:1843
translate russian kleio_event_05b_dae303dd:
    "Кроме холодного металла, есть только капот: он ещё тёплый после того, как я погазовал."

# ch/kleio/events.rpy:1844
translate russian kleio_event_05b_db796c91:
    "Упершись в передний бампер, Клео торопливо развязывает рукава комбинезона и стягивает его вниз."

# ch/kleio/events.rpy:1848
translate russian kleio_event_05b_fe273c3a:
    "Он собирается у щиколоток. Она снимает и трусики, забираясь на капот."

# ch/kleio/events.rpy:1849
translate russian kleio_event_05b_edd7e330:
    "Её ягодицы забавно поскрипывают по поверхности, когда она отодвигается и разводит ноги в ожидании."

# ch/kleio/events.rpy:1851
translate russian kleio_event_05b_ae6cc4aa:
    "Достаю член и направляю его к ней, уже более чем готовый."

# ch/kleio/events.rpy:1852
translate russian kleio_event_05b_598d1de4:
    "Клео тяжело дышит, ожидая меня. Грудь поднимается и опускается, сердце бьётся всё быстрее."

# ch/kleio/events.rpy:1853
translate russian kleio_event_05b_4e670818:
    kleio.say "Смазка не нужна. Я уже вся смазана и жду тебя..."

# ch/kleio/events.rpy:1855
translate russian kleio_event_05b_0c316076:
    kleio.say "Прокатись на мне, пожалуйста..."

# ch/kleio/events.rpy:1856
translate russian kleio_event_05b_b7987f07:
    "Она жутко меня заводит, но признаю: хочется начать, прежде чем Клео сама станет рычать как мотор!"

# ch/kleio/events.rpy:1857
translate russian kleio_event_05b_88cb542b:
    "Впрочем, говоря о готовности, она совсем не шутила."

# ch/kleio/events.rpy:1859
translate russian kleio_event_05b_7403926f:
    "Головка почти без сопротивления скользит между губами её киски."

# ch/kleio/events.rpy:1860
translate russian kleio_event_05b_022c7a72:
    "Одним плавным движением вхожу в Клео, и она довольно стонет."

# ch/kleio/events.rpy:1862
translate russian kleio_event_05b_78fced1d:
    "Ещё никогда ей не было так легко угодить, никогда она не была так готова принять меня."

# ch/kleio/events.rpy:1863
translate russian kleio_event_05b_0b0d28f4:
    "Словно смесь смазки, масла и пота оказалась алхимической формулой, растопившей её изнутри."

# ch/kleio/events.rpy:1865
translate russian kleio_event_05b_5948395c:
    "Мне и раньше казалось, что за высокомерной колючей оболочкой Клео я вижу другую её сторону."

# ch/kleio/events.rpy:1866
translate russian kleio_event_05b_fb7a802f:
    "Но если за всеми масками и защитой скрывается именно такая Клео, она намного больше, чем я представлял!"

# ch/kleio/events.rpy:1868
translate russian kleio_event_05b_c630a5b6:
    "Двигаясь в ней, не могу не прижаться лицом к её груди и не целовать соски. Её запах почти лишает меня рассудка."

# ch/kleio/events.rpy:1869
translate russian kleio_event_05b_99370187:
    "Вскоре толчки становятся всё резче и отчаяннее. Понимаю, что вот-вот кончу."

# ch/kleio/events.rpy:1870
translate russian kleio_event_05b_56ee4edd:
    "Не знаю, кончит ли Клео. Уже ничего не могу сделать: чувствую, как теряю контроль."

# ch/kleio/events.rpy:1872
translate russian kleio_event_05b_d55b4f16:
    "Она откидывается на капот, а я взбираюсь сверху и вхожу как можно глубже, пока длится оргазм."

# ch/kleio/events.rpy:1874
translate russian kleio_event_05b_1a79baa4:
    "Так и замираем: она распластана на капоте, я лежу сверху, такой же скользкий от пота."

# ch/kleio/events.rpy:1876
translate russian kleio_event_05b_92e2de13:
    "Клео довольно посмеивается, обнимая меня. Последние отголоски оргазма всё ещё заставляют меня вздрагивать и двигаться в ней."

# ch/kleio/events.rpy:1877
translate russian kleio_event_05b_400fb8f2:
    kleio.say "Основы обслуживания мотора: чтобы двигатель был здоров, его надо регулярно гонять и давать ему полную нагрузку!"

# ch/kleio/events.rpy:1878
translate russian kleio_event_05b_dffa6cf1:
    "У меня же нет сил сказать ни слова."

# ch/kleio/events.rpy:1879
translate russian kleio_event_05b_f928b5bc:
    "Но теперь думаю, что нашёл кое-что, на чём кататься приятнее, чем на своей машине."

# ch/kleio/events.rpy:1889
translate russian kleio_event_05c_495d83eb:
    "Занимаюсь дома всякой мелочью без определённого плана."

# ch/kleio/events.rpy:1890
translate russian kleio_event_05c_b8422eb8:
    "Честно говоря, без машины скучно и досадно. Пока её не починят, я словно заперт дома."

# ch/kleio/events.rpy:1891
translate russian kleio_event_05c_3c1070b8:
    "Нет причин сомневаться, что Клео справится."

# ch/kleio/events.rpy:1892
translate russian kleio_event_05c_f2b4105b:
    "Просто она обещала позвонить, когда закончит, но не сказала, когда именно."

# ch/kleio/events.rpy:1893
translate russian kleio_event_05c_a9b8d3b0:
    "Пожалуй, это неопровержимо доказывает, что она настоящий автомеханик!"

# ch/kleio/events.rpy:1894
translate russian kleio_event_05c_aa2d4920:
    "Я уже потерял счёт времени, когда с улицы доносится громкий гудок."

# ch/kleio/events.rpy:1895
translate russian kleio_event_05c_760e0892:
    "Бегу к окну скорее из любопытства, чем от раздражения."

# ch/kleio/events.rpy:1896
translate russian kleio_event_05c_a2ba5e1c:
    "И сразу узнаю свою машину у дома. За рулём Клео."

# ch/kleio/events.rpy:1897
translate russian kleio_event_05c_8e386fc4:
    "Не знаю, видит ли она меня в окне, но всё равно снова давит на сигнал."

# ch/kleio/events.rpy:1898
translate russian kleio_event_05c_79b68eae:
    "Боясь стать врагом номер один для соседей, спешу к выходу."

# ch/kleio/events.rpy:1900
translate russian kleio_event_05c_3ffe89de:
    "Уверен, Клео понимает, зачем я так отчаянно машу руками."

# ch/kleio/events.rpy:1901
translate russian kleio_event_05c_dedbb831:
    "Но прежде чем я успеваю добежать, она сигналит ещё раз."

# ch/kleio/events.rpy:1902
translate russian kleio_event_05c_40671a27:
    "Теперь ещё дольше, выжимая из гудка всё возможное."

# ch/kleio/events.rpy:1904
translate russian kleio_event_05c_a47b56e5:
    mike.say "Клео, какого чёрта ты творишь?!"

# ch/kleio/events.rpy:1905
translate russian kleio_event_05c_f80fd26a:
    mike.say "Хватит этого проклятого шума!"

# ch/kleio/events.rpy:1906
translate russian kleio_event_05c_22e0f7b1:
    "Водительское окно опущено, из него свешивается её рука."

# ch/kleio/events.rpy:1907
translate russian kleio_event_05c_525e6f10:
    "Когда наконец подхожу, она высовывает и голову."

# ch/kleio/events.rpy:1908
translate russian kleio_event_05c_19291045:
    kleio.say "Привет, сердцеед."

# ch/kleio/events.rpy:1909
translate russian kleio_event_05c_a7b33f33:
    kleio.say "Вернула твою трахомобильку, как и обещала!"

# ch/kleio/events.rpy:1910
translate russian kleio_event_05c_5047a485:
    kleio.say "Починила, теперь лучше прежнего."

# ch/kleio/events.rpy:1911
translate russian kleio_event_05c_822870d8:
    kleio.say "Ну, насколько это ведро вообще может быть хорошим..."

# ch/kleio/events.rpy:1912
translate russian kleio_event_05c_e0e23ebe:
    "Не спрашивая разрешения, просовываю руку в салон и вынимаю ключ из замка."

# ch/kleio/events.rpy:1913
translate russian kleio_event_05c_0902c2be:
    mike.say "Не помню, чтобы сигнал был сломан, Клео."

# ch/kleio/events.rpy:1914
translate russian kleio_event_05c_dfd32c4d:
    mike.say "Почему было просто не постучать в дверь?"

# ch/kleio/events.rpy:1915
translate russian kleio_event_05c_1354e4d3:
    "Клео одаривает меня убийственной улыбкой и вылезает из машины."

# ch/kleio/events.rpy:1916
translate russian kleio_event_05c_c3c1188f:
    kleio.say "Знаешь, [lssb_kleio.hero_name()], я удивилась, когда ты приехал в мастерскую на этом."

# ch/kleio/events.rpy:1917
translate russian kleio_event_05c_568e86c0:
    kleio.say "А теперь начинаю понимать, что ты в ней нашёл."

# ch/kleio/events.rpy:1918
translate russian kleio_event_05c_535e9169:
    "Закатываю глаза, стараясь скрыть, как меня задевает её замечание."

# ch/kleio/events.rpy:1919
translate russian kleio_event_05c_84288a52:
    mike.say "Ха-ха, Клео. Очень смешно."

# ch/kleio/events.rpy:1920
translate russian kleio_event_05c_7a102595:
    mike.say "Слушай, я правда благодарен за ремонт."

# ch/kleio/events.rpy:1921
translate russian kleio_event_05c_44aca55f:
    mike.say "Сколько я тебе должен?"

# ch/kleio/events.rpy:1922
translate russian kleio_event_05c_ffd1afc5:
    "Клео пинает шину и пренебрежительно качает головой."

# ch/kleio/events.rpy:1923
translate russian kleio_event_05c_fb2e0468:
    kleio.say "Бесплатно, сердцеед."

# ch/kleio/events.rpy:1924
translate russian kleio_event_05c_3a415c98:
    kleio.say "С такими машинами работать даже слишком легко."

# ch/kleio/events.rpy:1925
translate russian kleio_event_05c_c4e56099:
    kleio.say "Сочтём это дружеской услугой, ладно?"

# ch/kleio/events.rpy:1926
translate russian kleio_event_05c_1344be6c:
    "Киваю, немало удивлённый бесплатным ремонтом."

# ch/kleio/events.rpy:1927
translate russian kleio_event_05c_4a853ed7:
    mike.say "Конечно, Клео. Как скажешь."

# ch/kleio/events.rpy:1929
translate russian kleio_event_05c_7b5394e7:
    "Она улыбается и крепко хлопает меня по спине."

# ch/kleio/events.rpy:1930
translate russian kleio_event_05c_ab8ebbb3:
    kleio.say "Не за что, [lssb_kleio.hero_name()]."

# ch/kleio/events.rpy:1932
translate russian kleio_event_05c_b1c3bd4b:
    kleio.say "Люблю иногда спасти девицу в беде!"

# ch/kleio/events.rpy:1933
translate russian kleio_event_05c_0c73a643:
    kleio.say "А теперь мне надо прокатиться на чём-то помужественнее фена."

# ch/kleio/events.rpy:1934
translate russian kleio_event_05c_4490f650:
    kleio.say "От твоей машины так и веет словом «ссыкло»!"

# ch/kleio/events.rpy:1936
translate russian kleio_event_05c_bd02c920:
    "С этими словами она уходит, оставив меня у моей до боли практичной машины."

# ch/kleio/events.rpy:1937
translate russian kleio_event_05c_fb1cacd5:
    "Часть меня знает: надо оскорбиться и срочно доказывать свою мужественность."

# ch/kleio/events.rpy:1938
translate russian kleio_event_05c_c6c919d9:
    "Но другая часть так возбуждена её отвратительным характером, что ни о чём другом думать не может..."

# ch/kleio/events.rpy:1952
translate russian kleio_event_06_54a787ff:
    "Невозможно побыть рядом с Клео и не заметить, насколько яростно она отстаивает своё мнение."

# ch/kleio/events.rpy:1953
translate russian kleio_event_06_70c07154:
    "По любому вопросу, большому или маленькому, у неё есть позиция. И если ты не с ней — значит, против неё!"

# ch/kleio/events.rpy:1954
translate russian kleio_event_06_df92a298:
    "Мне нравится считать себя довольно прогрессивным, современным парнем, понимаете?"

# ch/kleio/events.rpy:1955
translate russian kleio_event_06_3bd005ec:
    "«Социально осознанный» — пожалуй, слишком громко. Но в целом я за всё хорошее и против всего плохого."

# ch/kleio/events.rpy:1956
translate russian kleio_event_06_6d4a2468:
    "И всё же разговор с Клео почти на любую тему нередко напоминает прогулку по минному полю."

# ch/kleio/events.rpy:1957
translate russian kleio_event_06_f7c5f09c:
    "Так что признаюсь: обычно я просто киваю и улыбаюсь, когда она высказывает своё мнение."

# ch/kleio/events.rpy:1958
translate russian kleio_event_06_fc39fb81:
    "Чаще всего это помогает избежать неприятностей и жить относительно спокойно."

# ch/kleio/events.rpy:1959
translate russian kleio_event_06_0859758b:
    "До сегодняшнего дня, когда Клео совершенно неожиданно звонит мне."

# ch/kleio/events.rpy:1960
translate russian kleio_event_06_8d59d5ef:
    mike.say "Привет, Клео. Как дела?"

# ch/kleio/events.rpy:1961
translate russian kleio_event_06_96d61278:
    kleio.say "Не начинай эту хрень, [lssb_kleio.hero_name()]."

# ch/kleio/events.rpy:1962
translate russian kleio_event_06_cbc16bb8:
    kleio.say "Где ты, ЧЁРТ ВОЗЬМИ?!"

# ch/kleio/events.rpy:1963
translate russian kleio_event_06_e398a85d:
    "На миг я даже не понимаю вопроса."

# ch/kleio/events.rpy:1964
translate russian kleio_event_06_a2a36708:
    mike.say "Э-э... Видимо, не там, где должен быть?"

# ch/kleio/events.rpy:1965
translate russian kleio_event_06_1fb0606f:
    kleio.say "Вот именно, блядь!"

# ch/kleio/events.rpy:1966
translate russian kleio_event_06_472bdfcd:
    kleio.say "Протест уже час идёт."

# ch/kleio/events.rpy:1967
translate russian kleio_event_06_dcf48e03:
    kleio.say "А тебя нет, чтобы поддержать меня!"

# ch/kleio/events.rpy:1968
translate russian kleio_event_06_3f0aac79:
    mike.say "Протест? Какой протест?"

# ch/kleio/events.rpy:1969
translate russian kleio_event_06_75d80996:
    "На другом конце линии Клео раздражённо выдыхает."

# ch/kleio/events.rpy:1970
translate russian kleio_event_06_5e50ad7a:
    "Сразу понимаю: хуже ответа придумать было нельзя."

# ch/kleio/events.rpy:1971
translate russian kleio_event_06_ce4300a4:
    kleio.say "Что значит «какой протест»?"

# ch/kleio/events.rpy:1972
translate russian kleio_event_06_066f8c67:
    kleio.say "Тот самый, куда ты согласился прийти на прошлой неделе, [lssb_kleio.hero_name()]!"

# ch/kleio/events.rpy:1973
translate russian kleio_event_06_608ed793:
    "Вот чёрт. Наверное, согласился, даже не заметив!"

# ch/kleio/events.rpy:1974
translate russian kleio_event_06_b99acd1d:
    "Вот чем опасно кивать и улыбаться на каждый её вопрос."

# ch/kleio/events.rpy:1975
translate russian kleio_event_06_50925ca5:
    mike.say "Это сегодня?!"

# ch/kleio/events.rpy:1976
translate russian kleio_event_06_3bee320e:
    mike.say "Прости, Клео! Я думал, на следующей неделе!"

# ch/kleio/events.rpy:1977
translate russian kleio_event_06_b932700a:
    "Клео низко рычит. Для меня это ничего хорошего не сулит."

# ch/kleio/events.rpy:1978
translate russian kleio_event_06_56da1ef2:
    kleio.say "Как хочешь, [lssb_kleio.hero_name()]."

# ch/kleio/events.rpy:1979
translate russian kleio_event_06_fe813af5:
    kleio.say "Либо приходи, либо нет."

# ch/kleio/events.rpy:1980
translate russian kleio_event_06_750b0a0a:
    kleio.say "Только избавь меня от жалких оправданий, ладно?"

# ch/kleio/events.rpy:1982
translate russian kleio_event_06_93ff4d84:
    "Она ещё не закончила звонок, а я уже хватаю куртку и мчусь к двери."

# ch/kleio/events.rpy:1983
translate russian kleio_event_06_fe0a7519:
    "В центре города протест найти нетрудно."

# ch/kleio/events.rpy:1984
translate russian kleio_event_06_5c7ba615:
    "Достаточно идти на скандирование и крики, пока не увижу толпу."

# ch/kleio/events.rpy:1985
translate russian kleio_event_06_e61f07cd:
    "Сотни людей снуют вокруг с плакатами, вскидывая кулаки."

# ch/kleio/events.rpy:1986
translate russian kleio_event_06_eb20783c:
    "Кажется, никогда не видел столько татуировок, пирсинга и крашеных волос в одном месте."

# ch/kleio/events.rpy:1987
translate russian kleio_event_06_c18d7307:
    "Словно меня окружило целое стадо Клео!"

# ch/kleio/events.rpy:1988
translate russian kleio_event_06_e29e23bf:
    "Оглядываюсь в поисках той единственной, ради которой вообще сюда пришёл."

# ch/kleio/events.rpy:1990
translate russian kleio_event_06_7d904ffb:
    "И вижу её у края толпы. Явно ждёт меня."

# ch/kleio/events.rpy:1991
translate russian kleio_event_06_085aa8c7:
    "Клео скрестила руки на груди и нетерпеливо постукивает ногой."

# ch/kleio/events.rpy:1995
translate russian kleio_event_06_eb07610f:
    "Но при виде моего красного лица и сбитого дыхания её выражение немного смягчается."

# ch/kleio/events.rpy:1996
translate russian kleio_event_06_749e6fbd:
    "Сгибаюсь пополам, упираюсь ладонями в колени и сразу начинаю извиняться."

# ch/kleio/events.rpy:1997
translate russian kleio_event_06_d5384aa2:
    mike.say "Прости... Клео..."

# ch/kleio/events.rpy:1998
translate russian kleio_event_06_a1b609cb:
    mike.say "Совсем... забыл..."

# ch/kleio/events.rpy:1999
translate russian kleio_event_06_72b4c875:
    kleio.say "Ладно, ладно!"

# ch/kleio/events.rpy:2000
translate russian kleio_event_06_985f28fd:
    kleio.say "Не надрывайся, [lssb_kleio.hero_name()]."

# ch/kleio/events.rpy:2001
translate russian kleio_event_06_cece26bc:
    kleio.say "Хорошо хоть теперь пришёл..."

# ch/kleio/events.rpy:2002
translate russian kleio_event_06_a9c3ab92:
    "Она суёт мне в руки самодельный плакат."

# ch/kleio/events.rpy:2003
translate russian kleio_event_06_76d8ae9a:
    kleio.say "Пойдём, а то всё закончится, пока доберёмся!"

# ch/kleio/events.rpy:2004
translate russian kleio_event_06_d92ec7f0:
    "Не успеваю прочесть надпись, как Клео железной хваткой берёт меня за руку."

# ch/kleio/events.rpy:2006
translate russian kleio_event_06_6c14539b:
    "Тащит в бурлящую толпу, без особых церемоний расталкивая людей локтями."

# ch/kleio/events.rpy:2007
translate russian kleio_event_06_1e87065e:
    "Вскоре мы в самой гуще протестующих. Шум оглушительный."

# ch/kleio/events.rpy:2008
translate russian kleio_event_06_accd1419:
    "Я ожидал почувствовать себя зажатым в толпе, даже боялся, что задавят."

# ch/kleio/events.rpy:2009
translate russian kleio_event_06_e1466a17:
    "Но это скорее напоминает концерты, на которых я бывал."

# ch/kleio/events.rpy:2010
translate russian kleio_event_06_a2b12425:
    "Только вокруг потрёпанные протестующие с лозунгами, а не потрёпанные рокеры с тяжёлым металлом."

# ch/kleio/events.rpy:2011
translate russian kleio_event_06_9d556681:
    "Клео то и дело оборачивается и что-то говорит."

# ch/kleio/events.rpy:2012
translate russian kleio_event_06_cd2a29e2:
    "Но за рёвом толпы невозможно ни услышать, ни быть услышанным."

# ch/kleio/events.rpy:2013
translate russian kleio_event_06_7cec1e83:
    "Каждый раз, когда приходится снова кивать или качать головой, у меня тревожно сводит живот."

# ch/kleio/events.rpy:2014
translate russian kleio_event_06_3e02d923:
    "Сначала это срабатывает, но с каждой попыткой шансы на удачу, кажется, уменьшаются."

# ch/kleio/events.rpy:2015
translate russian kleio_event_06_8bc65315:
    "Наконец Клео начинает о чём-то горячо говорить с окружающими."

# ch/kleio/events.rpy:2016
translate russian kleio_event_06_ad02d67f:
    "Не знаю, знакома ли она с ними или они просто на одной волне."

# ch/kleio/events.rpy:2017
translate russian kleio_event_06_18041767:
    "В любом случае отвечают ей с энтузиазмом."

# ch/kleio/events.rpy:2018
translate russian kleio_event_06_9ec0eab4:
    "Проблема лишь в том, что согласных и несогласных, судя по движениям голов, примерно поровну."

# ch/kleio/events.rpy:2019
translate russian kleio_event_06_defb73a4:
    "И вот она неизбежно поворачивается ко мне, широко раскрыв глаза и ожидая ответа."

# ch/kleio/events.rpy:2020
translate russian kleio_event_06_26bb7353:
    "Всё, больше не отвертеться."

# ch/kleio/events.rpy:2021
translate russian kleio_event_06_a69e7cb2:
    "Она требует определённого ответа!"

# ch/kleio/events.rpy:2024
translate russian kleio_event_06_7d395454:
    "Шансы пятьдесят на пятьдесят, да?"

# ch/kleio/events.rpy:2025
translate russian kleio_event_06_e1952cb8:
    "Так что логики в выборе никакой."

# ch/kleio/events.rpy:2026
translate russian kleio_event_06_055b841a:
    "Набираю полные лёгкие воздуха и реву..."

# ch/kleio/events.rpy:2027
translate russian kleio_event_06_1f0f1b90:
    mike.say "НИ ХРЕНА!!!"

# ch/kleio/events.rpy:2029
translate russian kleio_event_06_680ff78e:
    "И надо же толпе затихнуть именно в этот момент!"

# ch/kleio/events.rpy:2030
translate russian kleio_event_06_8bf89c2e:
    "Так что меня прекрасно слышит не только Клео, но и все вокруг."

# ch/kleio/events.rpy:2031
translate russian kleio_event_06_ab0a15f3:
    "На её лице сначала потрясение, затем возмущение."

# ch/kleio/events.rpy:2032
translate russian kleio_event_06_ff314baa:
    "В тот же миг понимаю: выбор был неправильный."

# ch/kleio/events.rpy:2034
translate russian kleio_event_06_e1886808:
    kleio.say "Что ты сейчас сказал?!"

# ch/kleio/events.rpy:2035
translate russian kleio_event_06_5474d660:
    kleio.say "Как ты вообще мог такое подумать, [lssb_kleio.hero_name()]?!"

# ch/kleio/events.rpy:2039
translate russian kleio_event_06_f2508d4e:
    "Стоит начать объясняться, как Клео бьёт меня в живот."

# ch/kleio/events.rpy:2040
translate russian kleio_event_06_6cf74b69:
    "От неожиданности сгибаюсь и падаю на колени."

# ch/kleio/events.rpy:2042
translate russian kleio_event_06_3155f99b:
    "Сквозь слёзы вижу её спину: она расталкивает толпу и уходит."

# ch/kleio/events.rpy:2044
translate russian kleio_event_06_f7a8703c:
    "Большинство быстро теряет ко мне интерес."

# ch/kleio/events.rpy:2045
translate russian kleio_event_06_28e67544:
    "Но, пока я позорно уползаю, всё ещё слышу неодобрительные замечания."

# ch/kleio/events.rpy:2046
translate russian kleio_event_06_27f1ff0a:
    "Всю дорогу домой клянусь себе впредь слушать внимательнее..."

# ch/kleio/events.rpy:2048
translate russian kleio_event_06_7d395454_1:
    "Шансы пятьдесят на пятьдесят, да?"

# ch/kleio/events.rpy:2049
translate russian kleio_event_06_e1952cb8_1:
    "Так что логики в выборе никакой."

# ch/kleio/events.rpy:2050
translate russian kleio_event_06_055b841a_1:
    "Набираю полные лёгкие воздуха и реву..."

# ch/kleio/events.rpy:2051
translate russian kleio_event_06_550b5725:
    mike.say "ДА, БЛЯДЬ!!!"

# ch/kleio/events.rpy:2052
translate russian kleio_event_06_680ff78e_1:
    "И надо же толпе затихнуть именно в этот момент!"

# ch/kleio/events.rpy:2053
translate russian kleio_event_06_8bf89c2e_1:
    "Так что меня прекрасно слышит не только Клео, но и все вокруг."

# ch/kleio/events.rpy:2054
translate russian kleio_event_06_cd3d245a:
    "На её лице появляется недоверие."

# ch/kleio/events.rpy:2055
translate russian kleio_event_06_7f76a663:
    "Но тут же сменяется искренней радостью."

# ch/kleio/events.rpy:2056
translate russian kleio_event_06_8554d221:
    "В тот же миг понимаю: я угадал."

# ch/kleio/events.rpy:2058
translate russian kleio_event_06_350a8772:
    kleio.say "Вот именно, [lssb_kleio.hero_name()]! ДА, БЛЯДЬ!!!"

# ch/kleio/events.rpy:2059
translate russian kleio_event_06_6e22a7cb:
    "Сначала один человек, потом другой, а вскоре уже почти все вокруг подхватывают крик."

# ch/kleio/events.rpy:2060
translate russian kleio_event_06_d05839e2:
    "Новый лозунг разлетается так быстро, что вскоре за нами повторяет вся толпа."

# ch/kleio/events.rpy:2061
translate russian kleio_event_06_14a611b5:
    "Пара здоровяков бесцеремонно поднимает нас с Клео к себе на плечи."

# ch/kleio/events.rpy:2062
translate russian kleio_event_06_cdf59147:
    "Пахнут они скверно, но я невольно заражаюсь общим настроением."

# ch/kleio/events.rpy:2065
translate russian kleio_event_06_a9f4ee91:
    "Клео наклоняется ближе и бьёт меня в плечо."

# ch/kleio/events.rpy:2066
translate russian kleio_event_06_b21cad8e:
    "От неожиданности вскрикиваю: и страшно, и довольно больно."

# ch/kleio/events.rpy:2067
translate russian kleio_event_06_81561ff5:
    "Но вижу её сияющее от счастья лицо и тоже улыбаюсь."

# ch/kleio/events.rpy:2068
translate russian kleio_event_06_8750621d:
    "Клео крепко берёт меня за руку, словно не хочет со мной расставаться."

# ch/kleio/events.rpy:2069
translate russian kleio_event_06_8f586d2c:
    "И я счастливо смотрю на неё с огромной глупой улыбкой."

# ch/kleio/events.rpy:2075
translate russian kleio_event_06b_1063e142:
    "Один из тех дней, когда мы с Клео просто проводим время вместе без особых занятий."

# ch/kleio/events.rpy:2076
translate russian kleio_event_06b_950ee0f7:
    "Не совсем свидание, но определённо больше, чем встреча двух друзей."

# ch/kleio/events.rpy:2077
translate russian kleio_event_06b_3e4ece14:
    "Честно говоря, такие моменты — одни из лучших с тех пор, как мы официально стали парой."

# ch/kleio/events.rpy:2078
translate russian kleio_event_06b_b66651a2:
    "Никто ничего не требует, можно быть собой и расслабиться."

# ch/kleio/events.rpy:2079
translate russian kleio_event_06b_152e4468:
    "Но, конечно, Клео при этом остаётся Клео..."

# ch/kleio/events.rpy:2080
translate russian kleio_event_06b_dc770920:
    mike.say "М-м-м..."

# ch/kleio/events.rpy:2081
translate russian kleio_event_06b_9e08a518:
    mike.say "Пойду перекушу, Клео."

# ch/kleio/events.rpy:2082
translate russian kleio_event_06b_6540aef2:
    mike.say "Тебе тоже что-нибудь взять?"

# ch/kleio/events.rpy:2084
translate russian kleio_event_06b_b03f5139:
    "Клео фыркает и качает головой."

# ch/kleio/events.rpy:2085
translate russian kleio_event_06b_812e7345:
    kleio.say "Господи помилуй, сердцеед!"

# ch/kleio/events.rpy:2086
translate russian kleio_event_06b_d71380f5:
    kleio.say "Ты же полчаса назад ел."

# ch/kleio/events.rpy:2087
translate russian kleio_event_06b_4cc3f229:
    kleio.say "У тебя что, глисты?"

# ch/kleio/events.rpy:2088
translate russian kleio_event_06b_bc4aec8c:
    kleio.say "Или ты НАРОЧНО решил разжиреть?"

# ch/kleio/events.rpy:2089
translate russian kleio_event_06b_876342de:
    "Её замечание останавливает меня на месте."

# ch/kleio/events.rpy:2090
translate russian kleio_event_06b_248d091d:
    "Я даже не задумывался, когда ел в последний раз."

# ch/kleio/events.rpy:2091
translate russian kleio_event_06b_50907246:
    "Просто захотел перекусить и решил пойти."

# ch/kleio/events.rpy:2092
translate russian kleio_event_06b_d6425de3:
    "А теперь из-за Клео чувствую себя обжорой, который не может остановиться!"

# ch/kleio/events.rpy:2093
translate russian kleio_event_06b_3f3077db:
    "Моргаю, глядя на неё, не зная, что ответить."

# ch/kleio/events.rpy:2094
translate russian kleio_event_06b_8044c43e:
    "И лишь затем вспоминаю, с кем разговариваю."

# ch/kleio/events.rpy:2095
translate russian kleio_event_06b_c32d55aa:
    "И разражаюсь смехом."

# ch/kleio/events.rpy:2096
translate russian kleio_event_06b_fc13c4de:
    mike.say "Да, Клео..."

# ch/kleio/events.rpy:2097
translate russian kleio_event_06b_3f9b398c:
    mike.say "Наверное, ты права!"

# ch/kleio/events.rpy:2098
translate russian kleio_event_06b_756a84a5:
    mike.say "Забудем про перекус."

# ch/kleio/events.rpy:2099
translate russian kleio_event_06b_ad6bec9e:
    "Ожидаю, что она начнёт злорадствовать, добившись моего согласия."

# ch/kleio/events.rpy:2100
translate russian kleio_event_06b_9800824c:
    "Или хотя бы бросит ещё пару оскорблений."

# ch/kleio/events.rpy:2102
translate russian kleio_event_06b_e8bd5b0f:
    "Но вместо этого она неожиданно хмурится."

# ch/kleio/events.rpy:2103
translate russian kleio_event_06b_13b4aded:
    kleio.say "Как у тебя это ПОЛУЧАЕТСЯ, [lssb_kleio.hero_name()]?"

# ch/kleio/events.rpy:2104
translate russian kleio_event_06b_30e38186:
    mike.say "Что получается, Клео?"

# ch/kleio/events.rpy:2105
translate russian kleio_event_06b_489bb125:
    kleio.say "Ну, я на тебя нападаю."

# ch/kleio/events.rpy:2106
translate russian kleio_event_06b_8baba405:
    kleio.say "А ты просто отмахиваешься, словно ничего не случилось!"

# ch/kleio/events.rpy:2107
translate russian kleio_event_06b_2c6f4d14:
    "На миг смотрю на неё с недоумением, не зная, что сказать."

# ch/kleio/events.rpy:2108
translate russian kleio_event_06b_f01612a9:
    "Ответ ведь настолько простой и очевидный."

# ch/kleio/events.rpy:2109
translate russian kleio_event_06b_d3481dfe:
    "Приходится даже постараться, чтобы облечь его в слова."

# ch/kleio/events.rpy:2110
translate russian kleio_event_06b_3371712b:
    mike.say "Потому что ты такая, Клео."

# ch/kleio/events.rpy:2111
translate russian kleio_event_06b_efeec92a:
    mike.say "И я люблю тебя всю. Даже твои оскорбления."

# ch/kleio/events.rpy:2112
translate russian kleio_event_06b_327b6842:
    mike.say "Знаю, это просто твоя манера общаться."

# ch/kleio/events.rpy:2113
translate russian kleio_event_06b_13f0124a:
    mike.say "Так что меня они уже почти не задевают."

# ch/kleio/events.rpy:2114
translate russian kleio_event_06b_0f2957df:
    "Клео шумно выдыхает."

# ch/kleio/events.rpy:2115
translate russian kleio_event_06b_a7d5aa6d:
    "Качает головой и вздыхает."

# ch/kleio/events.rpy:2116
translate russian kleio_event_06b_161067a7:
    kleio.say "Так весь смысл пропадает, понимаешь?"

# ch/kleio/events.rpy:2117
translate russian kleio_event_06b_ad93d33d:
    kleio.say "Уф... А я ведь..."

# ch/kleio/events.rpy:2118
translate russian kleio_event_06b_e4215b96:
    kleio.say "Всегда боялась связаться с кем-то вроде моего папаши!"

# ch/kleio/events.rpy:2119
translate russian kleio_event_06b_2c8cc857:
    "Я сразу настораживаюсь."

# ch/kleio/events.rpy:2121
translate russian kleio_event_06b_f2310932:
    "Ведь о родителях Клео почти никогда не говорит."

# ch/kleio/events.rpy:2122
translate russian kleio_event_06b_0ba76a82:
    "Да и о прошлом вообще рассказывает мало."

# ch/kleio/events.rpy:2123
translate russian kleio_event_06b_3fd6a7ec:
    "О том, что было до знакомства с Сашей и создания группы."

# ch/kleio/events.rpy:2124
translate russian kleio_event_06b_6757cf6b:
    mike.say "Ну..."

# ch/kleio/events.rpy:2125
translate russian kleio_event_06b_c0150bf9:
    mike.say "Я НЕ похож на твоего отца."

# ch/kleio/events.rpy:2126
translate russian kleio_event_06b_6bbf6d00:
    mike.say "И это... хорошо?"

# ch/kleio/events.rpy:2127
translate russian kleio_event_06b_253dcd51:
    kleio.say "Ещё как хорошо, блядь, сердцеед!"

# ch/kleio/events.rpy:2129
translate russian kleio_event_06b_ad7f8a0a:
    kleio.say "Мой папаша был самым большим мудаком на планете!"

# ch/kleio/events.rpy:2130
translate russian kleio_event_06b_3f9bbd25:
    kleio.say "Избивал маму до синяков."

# ch/kleio/events.rpy:2131
translate russian kleio_event_06b_d55f8c29:
    kleio.say "А когда она ушла, начал так же бить меня..."

# ch/kleio/events.rpy:2133
translate russian kleio_event_06b_20523f80:
    "Клео замолкает, осознав, в чём признаётся."

# ch/kleio/events.rpy:2134
translate russian kleio_event_06b_c25429a7:
    "Чувства заставили её открыться, и она сама этого не заметила."

# ch/kleio/events.rpy:2136
translate russian kleio_event_06b_fc5cbb26:
    kleio.say "А, блядь..."

# ch/kleio/events.rpy:2137
translate russian kleio_event_06b_88764531:
    kleio.say "Нарушила своё главное правило!"

# ch/kleio/events.rpy:2138
translate russian kleio_event_06b_b1395fb8:
    kleio.say "Рассказала тебе свою жалкую слезливую историю!"

# ch/kleio/events.rpy:2139
translate russian kleio_event_06b_32ca5f18:
    "Я качаю головой."

# ch/kleio/events.rpy:2140
translate russian kleio_event_06b_1db8dce9:
    "Не могу поверить, что Клео так говорит."

# ch/kleio/events.rpy:2141
translate russian kleio_event_06b_507366b0:
    mike.say "Не говори так, Клео!"

# ch/kleio/events.rpy:2142
translate russian kleio_event_06b_ad037c72:
    mike.say "Никто не имеет права так с тобой обращаться."

# ch/kleio/events.rpy:2143
translate russian kleio_event_06b_450a1fa4:
    mike.say "И от меня это скрывать не нужно."

# ch/kleio/events.rpy:2144
translate russian kleio_event_06b_36d93ff9:
    mike.say "Я... не представляю, каково это."

# ch/kleio/events.rpy:2145
translate russian kleio_event_06b_e57c7dfe:
    mike.say "Не стану говорить, что понимаю. Потому что не понимаю."

# ch/kleio/events.rpy:2146
translate russian kleio_event_06b_79711b2a:
    mike.say "Но буду рядом, захочешь ты поговорить или нет. Хорошо?"

# ch/kleio/events.rpy:2148
translate russian kleio_event_06b_887aaf1e:
    "Клео шутливо бьёт меня по плечу."

# ch/kleio/events.rpy:2150
translate russian kleio_event_06b_ff3a5944:
    "Совсем без силы, а затем прижимается ко мне."

# ch/kleio/events.rpy:2151
translate russian kleio_event_06b_4b4c3ce9:
    kleio.say "Ну охренеть, сердцеед."

# ch/kleio/events.rpy:2152
translate russian kleio_event_06b_6f04a20a:
    kleio.say "Я тебя не заслуживаю!"

# ch/kleio/events.rpy:2153
translate russian kleio_event_06b_87af35dc:
    "Обнимаю Клео и притягиваю ближе."

# ch/kleio/events.rpy:2154
translate russian kleio_event_06b_74cb10e1:
    mike.say "Заслуживаешь, Клео."

# ch/kleio/events.rpy:2155
translate russian kleio_event_06b_4a9d2fd0:
    mike.say "И вообще..."

# ch/kleio/events.rpy:2156
translate russian kleio_event_06b_1c0c8547:
    mike.say "Я думал, твоё главное правило — не прожить десяти секунд, не сказав «блядь»?"

# ch/kleio/events.rpy:2158
translate russian kleio_event_06b_94212238:
    "Клео хихикает, уткнувшись мне в плечо."

# ch/kleio/events.rpy:2159
translate russian kleio_event_06b_4865073b:
    "А затем тоже обнимает меня."

# ch/kleio/events.rpy:2165
translate russian kleio_getting_serious_01_e997cfcf:
    "Едва мы выходим и начинаем идти по улице, Клео оглядывается на меня через плечо."

# ch/kleio/events.rpy:2166
translate russian kleio_getting_serious_01_1304ced6:
    "Она на пару шагов впереди, и на лице у неё чистое, безудержное озорство."

# ch/kleio/events.rpy:2167
translate russian kleio_getting_serious_01_f380caff:
    "Меня это ничуть не тревожит: свидание прошло хорошо. Очень хорошо."

# ch/kleio/events.rpy:2168
translate russian kleio_getting_serious_01_520703f3:
    "А её любовь к эпатажу и умение меня поддеть сейчас лишь сильнее притягивают."

# ch/kleio/events.rpy:2169
translate russian kleio_getting_serious_01_1d7a4284:
    mike.say "И что, чёрт возьми, означает этот взгляд, а?"

# ch/kleio/events.rpy:2171
translate russian kleio_getting_serious_01_6b1d54e7:
    "Клео поднимает брови и открывает рот в притворном возмущении."

# ch/kleio/events.rpy:2172
translate russian kleio_getting_serious_01_0d0cc91e:
    kleio.say "Правда хочешь знать, сердцеед?"

# ch/kleio/events.rpy:2173
translate russian kleio_getting_serious_01_50f719b5:
    mike.say "Да, Клео, правда хочу!"

# ch/kleio/events.rpy:2174
translate russian kleio_getting_serious_01_51257f66:
    kleio.say "Ладно, раз настаиваешь..."

# ch/kleio/events.rpy:2176
translate russian kleio_getting_serious_01_c7b44b2a:
    kleio.say "Я думала, что ты вдвое меньшее унылое говно, чем кажешься!"

# ch/kleio/events.rpy:2177
translate russian kleio_getting_serious_01_daf2b527:
    "Теперь мой черёд изображать возмущение."

# ch/kleio/events.rpy:2178
translate russian kleio_getting_serious_01_c957d2fb:
    "Я достаточно знаю Клео, чтобы понять, когда её яд всерьёз."

# ch/kleio/events.rpy:2179
translate russian kleio_getting_serious_01_b229a5bc:
    "И когда она просто пытается вызвать реакцию."

# ch/kleio/events.rpy:2180
translate russian kleio_getting_serious_01_e4b05357:
    "Наверное, это её особенный способ флиртовать."

# ch/kleio/events.rpy:2181
translate russian kleio_getting_serious_01_bf0da9b3:
    "Хуже всего в такой ситуации отступить хоть на мгновение."

# ch/kleio/events.rpy:2182
translate russian kleio_getting_serious_01_17a3be72:
    mike.say "Ну вот, Клео."

# ch/kleio/events.rpy:2183
translate russian kleio_getting_serious_01_d719d245:
    mike.say "Это лишь доказывает, как плохо ты разбираешься в людях!"

# ch/kleio/events.rpy:2185
translate russian kleio_getting_serious_01_9f7c5aa2:
    "От моего ответа она округляет глаза, но я замечаю знакомую кривую улыбку."

# ch/kleio/events.rpy:2186
translate russian kleio_getting_serious_01_2160de4b:
    "По её взгляду ясно: она получает огромное удовольствие."

# ch/kleio/events.rpy:2187
translate russian kleio_getting_serious_01_96aca17f:
    kleio.say "Не моя вина, что приходится работать с таким плохим материалом, сердцеед!"

# ch/kleio/events.rpy:2189
translate russian kleio_getting_serious_01_5d7d3b12:
    kleio.say "В общем, было весело."

# ch/kleio/events.rpy:2190
translate russian kleio_getting_serious_01_9f1e7961:
    kleio.say "Думаю, шанс повторить как-нибудь ты почти заслужил."

# ch/kleio/events.rpy:2191
translate russian kleio_getting_serious_01_48ccf834:
    "Клео разворачивается, собираясь уйти."

# ch/kleio/events.rpy:2195
translate russian kleio_getting_serious_01_850685db:
    "Но не успевает сделать и шага."

# ch/kleio/events.rpy:2197
translate russian kleio_getting_serious_01_581bef01:
    "Она оглядывается и смотрит вниз: я держу её за запястье, не давая уйти."

# ch/kleio/events.rpy:2199
translate russian kleio_getting_serious_01_cc2c71b1:
    "Её взгляд поднимается, пока не встречается с моим."

# ch/kleio/events.rpy:2200
translate russian kleio_getting_serious_01_4bf3980f:
    "Затем она склоняет голову набок. Я узнаю вызов."

# ch/kleio/events.rpy:2201
translate russian kleio_getting_serious_01_20ddb72d:
    "Даёт понять: что бы я ни задумал, пусть это будет что-то стоящее."

# ch/kleio/events.rpy:2202
translate russian kleio_getting_serious_01_55065d9e:
    mike.say "Видишь ли, Клео..."

# ch/kleio/events.rpy:2203
translate russian kleio_getting_serious_01_4aa1551a:
    mike.say "Думаю, я справился лучше, чем ты признаёшь."

# ch/kleio/events.rpy:2204
translate russian kleio_getting_serious_01_5467c29b:
    mike.say "По-моему, вечер удался настолько, что я заслужил большего."

# ch/kleio/events.rpy:2206
translate russian kleio_getting_serious_01_7ac9c8e9:
    kleio.say "Да ну?"

# ch/kleio/events.rpy:2207
translate russian kleio_getting_serious_01_fb25357c:
    kleio.say "Так считаешь, сердцеед?!"

# ch/kleio/events.rpy:2208
translate russian kleio_getting_serious_01_f9a9889e:
    mike.say "Да, Клео."

# ch/kleio/events.rpy:2209
translate russian kleio_getting_serious_01_fada33e6:
    mike.say "Так что у тебя два варианта."

# ch/kleio/events.rpy:2210
translate russian kleio_getting_serious_01_122ec8aa:
    mike.say "Либо поцеловать меня, либо дать пощёчину."

# ch/kleio/events.rpy:2211
translate russian kleio_getting_serious_01_4e04f352:
    mike.say "Пока не выберешь, не отпущу."

# ch/kleio/events.rpy:2214
translate russian kleio_getting_serious_01_97ad36e9:
    "Притягиваю Клео к себе. Она почти не сопротивляется."

# ch/kleio/events.rpy:2215
translate russian kleio_getting_serious_01_1008f7af:
    "Расстояние сокращается, и я отчасти жду, что вот-вот получу ладонью по щеке."

# ch/kleio/events.rpy:2216
translate russian kleio_getting_serious_01_e43b018e:
    "Но когда она оказывается достаточно близко для объятия, понимаю: удара не будет."

# ch/kleio/events.rpy:2217
translate russian kleio_getting_serious_01_75f98fe3:
    kleio.say "Ну и яйца у тебя, сердцеед!"

# ch/kleio/events.rpy:2218
translate russian kleio_getting_serious_01_97f1b624:
    mike.say "Не больше, чем у тебя, Клео!"

# ch/kleio/events.rpy:2219
translate russian kleio_getting_serious_01_f0e2fdfd:
    kleio.say "Да заткнись и поцелуй меня, придурок!"

# ch/kleio/events.rpy:2224
translate russian kleio_getting_serious_01_61febf26:
    "Так и делаю: наклоняюсь и прижимаюсь губами к её губам."

# ch/kleio/events.rpy:2225
translate russian kleio_getting_serious_01_97cc6e28:
    "Несмотря на всю браваду, Клео целует чувственно и нежно."

# ch/kleio/events.rpy:2226
translate russian kleio_getting_serious_01_8e418381:
    "Её язык дразнит меня, а дыхание выдаёт, насколько она открывается в этот миг."

# ch/kleio/events.rpy:2227
translate russian kleio_getting_serious_01_e37f31a2:
    "Что сейчас происходит?"

# ch/kleio/events.rpy:2228
translate russian kleio_getting_serious_01_8b059697:
    "Мы становимся чем-то большим, чем два язвительных придурка, которые одинаково любят друг друга оскорблять и заводить?"

# ch/kleio/events.rpy:2229
translate russian kleio_getting_serious_01_b37e5d99:
    "Что бы это ни было, мне нравится."

# ch/kleio/events.rpy:2230
translate russian kleio_getting_serious_01_4ba95e8c:
    "И Клео, кажется, тоже..."

# ch/kleio/events.rpy:2240
translate russian kleio_event_07_e31133e9:
    "Только недавно начал замечать, но с Клео определённо что-то странное."

# ch/kleio/events.rpy:2241
translate russian kleio_event_07_e8487648:
    "Да, она и так не самая обычная девушка, со всеми своими колючками."

# ch/kleio/events.rpy:2242
translate russian kleio_event_07_03711acc:
    "Но последние пару дней явно что-то происходит."

# ch/kleio/events.rpy:2243
translate russian kleio_event_07_c5171959:
    "Обычно любое время с Клео означает порцию её фирменных оскорблений."

# ch/kleio/events.rpy:2244
translate russian kleio_event_07_7762bf99:
    "Честно говоря, я к ним уже привык."

# ch/kleio/events.rpy:2245
translate russian kleio_event_07_7d47a715:
    "Более того, эта её причуда начинает мне по-настоящему нравиться."

# ch/kleio/events.rpy:2246
translate russian kleio_event_07_1074d522:
    "Поэтому, когда она вдруг перестаёт сыпать колкостями, я начинаю волноваться."

# ch/kleio/events.rpy:2247
translate russian kleio_event_07_351244f4:
    "Словно видит возможность уколоть, но в последний момент отступает."

# ch/kleio/events.rpy:2248
translate russian kleio_event_07_92a02f7e:
    "Не понимаю почему и с каждым разом всё больше за неё тревожусь."

# ch/kleio/events.rpy:2249
translate russian kleio_event_07_9307b003:
    "В итоге решаю, что придётся заговорить об этом."

# ch/kleio/events.rpy:2250
translate russian kleio_event_07_efb77356:
    mike.say "Клео..."

# ch/kleio/events.rpy:2251
translate russian kleio_event_07_141e5efd:
    kleio.say "М-м?"

# ch/kleio/events.rpy:2252
translate russian kleio_event_07_3fe1a38a:
    mike.say "Тебя что-то беспокоит?"

# ch/kleio/events.rpy:2253
translate russian kleio_event_07_2d985a5e:
    kleio.say "Ты о чём, сердцеед?"

# ch/kleio/events.rpy:2254
translate russian kleio_event_07_28589fe0:
    mike.say "Я серьёзно, Клео. Что с тобой?"

# ch/kleio/events.rpy:2256
translate russian kleio_event_07_e33aabc9:
    kleio.say "Не знаю, [lssb_kleio.hero_name()]."

# ch/kleio/events.rpy:2258
translate russian kleio_event_07_59b8214e:
    kleio.say "Может, бесит, что меня допрашивает какой-то..."

# ch/kleio/events.rpy:2259
translate russian kleio_event_07_1bc31d27:
    kleio.say "Какой-то..."

# ch/kleio/events.rpy:2260
translate russian kleio_event_07_c1ed4fbc:
    kleio.say "У-у!"

# ch/kleio/events.rpy:2262
translate russian kleio_event_07_cd5dae4c:
    "Вот опять: начинает оскорбление и не может закончить."

# ch/kleio/events.rpy:2264
translate russian kleio_event_07_96d18679:
    mike.say "Об этом я и говорю, Клео."

# ch/kleio/events.rpy:2265
translate russian kleio_event_07_c69310d3:
    mike.say "У тебя рядом со мной всё время язык заплетается."

# ch/kleio/events.rpy:2266
translate russian kleio_event_07_63b9b318:
    "Глубоко вздыхаю, прежде чем высказать свою тревогу."

# ch/kleio/events.rpy:2267
translate russian kleio_event_07_ded165d7:
    mike.say "Дело во мне, Клео?"

# ch/kleio/events.rpy:2268
translate russian kleio_event_07_1e06e869:
    mike.say "Я чем-то тебя разозлил?"

# ch/kleio/events.rpy:2269
translate russian kleio_event_07_00ce2bb1:
    "Конечно, боюсь услышать уверенное «да»."

# ch/kleio/events.rpy:2270
translate russian kleio_event_07_87803807:
    "И боюсь того, что последует, если я прав."

# ch/kleio/events.rpy:2272
translate russian kleio_event_07_7d1fcef6:
    "Клео отворачивается, избегая моего взгляда."

# ch/kleio/events.rpy:2273
translate russian kleio_event_07_2e20b3ca:
    "Начинаю думать, что угадал: она собирается меня бросить или что-то в этом роде."

# ch/kleio/events.rpy:2274
translate russian kleio_event_07_d569ec72:
    mike.say "Если дело во мне, просто скажи."

# ch/kleio/events.rpy:2275
translate russian kleio_event_07_83f0035c:
    mike.say "Я могу измениться, Клео."

# ch/kleio/events.rpy:2276
translate russian kleio_event_07_be151e91:
    mike.say "Обещаю!"

# ch/kleio/events.rpy:2278
translate russian kleio_event_07_8e271fa1:
    kleio.say "Нет, [lssb_kleio.hero_name()], никогда так не делай!"

# ch/kleio/events.rpy:2280
translate russian kleio_event_07_a96a2b30:
    "Едва произнеся это, Клео замолкает."

# ch/kleio/events.rpy:2281
translate russian kleio_event_07_f87f061c:
    "Словно её саму потряс этот внезапный порыв."

# ch/kleio/events.rpy:2282
translate russian kleio_event_07_c15d20fc:
    mike.say "Что... Что ты имеешь в виду, Клео?"

# ch/kleio/events.rpy:2283
translate russian kleio_event_07_cf247e26:
    mike.say "Если я изменюсь, разве не станет лучше?"

# ch/kleio/events.rpy:2285
translate russian kleio_event_07_473c8416:
    "Она заставляет себя повернуться ко мне."

# ch/kleio/events.rpy:2286
translate russian kleio_event_07_7d4d2224:
    "Вижу, каких усилий ей это стоит."

# ch/kleio/events.rpy:2287
translate russian kleio_event_07_64fe8c41:
    kleio.say "Нет, нет..."

# ch/kleio/events.rpy:2288
translate russian kleio_event_07_a0aaf17f:
    kleio.say "Я... не хочу, чтобы ты менялся, [lssb_kleio.hero_name()]."

# ch/kleio/events.rpy:2289
translate russian kleio_event_07_1f2463bb:
    kleio.say "Ты... нравишься мне таким, какой есть!"

# ch/kleio/events.rpy:2291
translate russian kleio_event_07_9c242585:
    kleio.say "Всё, сказала! Доволен?!"

# ch/kleio/events.rpy:2293
translate russian kleio_event_07_dc394957:
    "На миг я потрясён не меньше неё."

# ch/kleio/events.rpy:2294
translate russian kleio_event_07_cc5be88f:
    "Так непривычно слышать от неё подобное, что не знаю, как реагировать."

# ch/kleio/events.rpy:2295
translate russian kleio_event_07_10be61a5:
    "Но затем понимаю, как трудно ей далось это признание."

# ch/kleio/events.rpy:2296
translate russian kleio_event_07_343c0ca6:
    "Жёсткая оболочка так срослась с Клео, что признать свои чувства ей нелегко."

# ch/kleio/events.rpy:2297
translate russian kleio_event_07_ac4b8589:
    mike.say "Ты... тоже мне нравишься, Клео."

# ch/kleio/events.rpy:2298
translate russian kleio_event_07_193c93dc:
    mike.say "И то, как ты меня подкалываешь, тоже..."

# ch/kleio/events.rpy:2300
translate russian kleio_event_07_3276a15f:
    kleio.say "П... правда?!"

# ch/kleio/events.rpy:2301
translate russian kleio_event_07_dfd5e5cf:
    "Киваю и улыбаюсь. Как необычно и приятно видеть Клео настолько честной и открытой."

# ch/kleio/events.rpy:2302
translate russian kleio_event_07_dd0d5255:
    mike.say "Да, правда."

# ch/kleio/events.rpy:2303
translate russian kleio_event_07_80c87e76:
    mike.say "Мне всегда казалось, что это значит, я тебе нравлюсь!"

# ch/kleio/events.rpy:2305
translate russian kleio_event_07_d99eaee7:
    kleio.say "Потому и стало трудно, [lssb_kleio.hero_name()]."

# ch/kleio/events.rpy:2307
translate russian kleio_event_07_d94e46d5:
    kleio.say "Всё сложнее придумать, за что тебя ненавидеть!"

# ch/kleio/events.rpy:2308
translate russian kleio_event_07_8efabb23:
    mike.say "Не волнуйся, я наверняка найду новый способ тебя достать!"

# ch/kleio/events.rpy:2310
translate russian kleio_event_07_49444dff:
    "На её лице весёлое возмущение. Она легонько бьёт меня по руке."

# ch/kleio/events.rpy:2312
translate russian kleio_event_07_d266a689:
    "А затем придвигается и кладёт голову на то же плечо."

# ch/kleio/events.rpy:2313
translate russian kleio_event_07_6fd4b631:
    "Обнимаю её и думаю о том, какая она для меня особенная и неповторимая..."

# ch/kleio/events.rpy:2319
translate russian kleio_getting_serious_02_5f6a91dc:
    "Помню, кто-то советовал судить об отношениях по последнему свиданию."

# ch/kleio/events.rpy:2320
translate russian kleio_getting_serious_02_ec73c559:
    "Если так, то у нас с Клео всё довольно хорошо."

# ch/kleio/events.rpy:2321
translate russian kleio_getting_serious_02_3f169696:
    "Это было одно из тех свиданий, где всё складывается само собой."

# ch/kleio/events.rpy:2322
translate russian kleio_getting_serious_02_60ee109d:
    "Вы просто понимаете друг друга, и кажется, что так и должно быть."

# ch/kleio/events.rpy:2323
translate russian kleio_getting_serious_02_d394e563:
    "Да, я помню, что говорю о Клео, королеве причуд."

# ch/kleio/events.rpy:2324
translate russian kleio_getting_serious_02_811f4dd0:
    "Но в последнее время мы проводим вместе всё больше времени."

# ch/kleio/events.rpy:2325
translate russian kleio_getting_serious_02_7586274a:
    "И отношения становятся серьёзнее."

# ch/kleio/events.rpy:2326
translate russian kleio_getting_serious_02_248b856b:
    "Раньше её резкость и едкий язык меня задевали. Теперь словно и меня посвятили в шутку."

# ch/kleio/events.rpy:2327
translate russian kleio_getting_serious_02_c8b72813:
    "То, что когда-то раздражало, быстро становится тем, что я в ней обожаю."

# ch/kleio/events.rpy:2328
translate russian kleio_getting_serious_02_5d7640e9:
    "Сначала в отношениях хочется такие черты в человеке изменить."

# ch/kleio/events.rpy:2329
translate russian kleio_getting_serious_02_80e82c5d:
    "Но со временем уже ни за что не согласился бы без них обойтись."

# ch/kleio/events.rpy:2330
translate russian kleio_getting_serious_02_c3b72db1:
    "Да, знаю, трудно поверить. Но это правда."

# ch/kleio/events.rpy:2331
translate russian kleio_getting_serious_02_63703739:
    "Обо всём этом думаю, пока мы идём домой после свидания."

# ch/kleio/events.rpy:2332
translate russian kleio_getting_serious_02_3c1cd6d8:
    "Клео держит меня за руку. Чувствую, пытается замедлить мой шаг."

# ch/kleio/events.rpy:2333
translate russian kleio_getting_serious_02_212272f4:
    "Наверное, хочет, чтобы я остановился. И тут меня охватывает дежавю."

# ch/kleio/events.rpy:2334
translate russian kleio_getting_serious_02_73f1b36a:
    "Разве однажды не было так же, только я удерживал Клео по дороге со свидания?"

# ch/kleio/events.rpy:2335
translate russian kleio_getting_serious_02_12296a76:
    "От того, что мы поменялись ролями, становится озорно весело."

# ch/kleio/events.rpy:2336
translate russian kleio_getting_serious_02_309f0f0c:
    "Кто бы подумал, что дойдёт до того, что Клео будет добиваться моего внимания?"

# ch/kleio/events.rpy:2337
translate russian kleio_getting_serious_02_210aac36:
    "Разве не забавно отплатить ей тем же?"

# ch/kleio/events.rpy:2338
translate russian kleio_getting_serious_02_91149468:
    "Продолжаю идти, делая вид, что не замечаю её попыток меня остановить."

# ch/kleio/events.rpy:2339
translate russian kleio_getting_serious_02_1e7647d4:
    kleio.say "Эй... эй, сердцеед!"

# ch/kleio/events.rpy:2340
translate russian kleio_getting_serious_02_1cee54c2:
    kleio.say "Да притормози ты!"

# ch/kleio/events.rpy:2341
translate russian kleio_getting_serious_02_d1751254:
    mike.say "Ой, прости, Клео."

# ch/kleio/events.rpy:2342
translate russian kleio_getting_serious_02_b72179df:
    mike.say "Видимо, я слишком тормозной, чтобы услышать с первого раза, да?"

# ch/kleio/events.rpy:2344
translate russian kleio_getting_serious_02_84beccce:
    "Глаза Клео расширяются, а рот открывается в притворном возмущении."

# ch/kleio/events.rpy:2345
translate russian kleio_getting_serious_02_44c71d5e:
    kleio.say "Браво, [lssb_kleio.hero_name()]."

# ch/kleio/events.rpy:2346
translate russian kleio_getting_serious_02_98f4cb0c:
    kleio.say "Ловко ты меня моими же словами приложил!"

# ch/kleio/events.rpy:2348
translate russian kleio_getting_serious_02_d0f4b071:
    "Теперь, когда я заставил её признать, что в прошлый раз она обошлась со мной довольно жестоко, можно и уступить."

# ch/kleio/events.rpy:2350
translate russian kleio_getting_serious_02_6435a6d9:
    "Я поворачиваюсь и позволяю Клео крепко обнять меня, наслаждаясь прикосновением её тела."

# ch/kleio/events.rpy:2351
translate russian kleio_getting_serious_02_46135264:
    mike.say "Ты почти всё время язвишь, Клео."

# ch/kleio/events.rpy:2352
translate russian kleio_getting_serious_02_27dffe60:
    mike.say "Как мне понять, когда ты говоришь серьёзно?"

# ch/kleio/events.rpy:2354
translate russian kleio_getting_serious_02_57431999:
    kleio.say "Сейчас я говорю серьёзно, [lssb_kleio.hero_name()]."

# ch/kleio/events.rpy:2355
translate russian kleio_getting_serious_02_1adec246:
    kleio.say "Сегодня было здорово... правда здорово."

# ch/kleio/events.rpy:2357
translate russian kleio_getting_serious_02_9a8b317d:
    kleio.say "Просто хочу обняться, чтобы это ощущение ещё немного продлилось, понимаешь?"

# ch/kleio/events.rpy:2358
translate russian kleio_getting_serious_02_0b712fbc:
    "Мне не послышалось?"

# ch/kleio/events.rpy:2359
translate russian kleio_getting_serious_02_8b5e9b0e:
    "Клео только что проявила сентиментальность?"

# ch/kleio/events.rpy:2360
translate russian kleio_getting_serious_02_ef20e9cf:
    "Да она, кажется, становится белой и пушистой!"

# ch/kleio/events.rpy:2361
translate russian kleio_getting_serious_02_9bef18e5:
    "Можно отпустить сколько угодно колкостей и отыграться на ней."

# ch/kleio/events.rpy:2362
translate russian kleio_getting_serious_02_bb26186e:
    "Но сейчас это сделало бы меня последним мудаком на планете."

# ch/kleio/events.rpy:2363
translate russian kleio_getting_serious_02_040d3ef1:
    mike.say "Я тоже, Клео."

# ch/kleio/events.rpy:2364
translate russian kleio_getting_serious_02_f68b90d2:
    mike.say "Я тоже."

# ch/kleio/events.rpy:2365
translate russian kleio_getting_serious_02_4d08ce0f:
    "Поэтому я просто обнимаю её."

# ch/kleio/events.rpy:2366
translate russian kleio_getting_serious_02_0b9e947c:
    "И странное дело: пока мы стоим так, я чувствую себя невероятно счастливым."

# ch/kleio/events.rpy:2367
translate russian kleio_getting_serious_02_e36f571a:
    "Не нужны ни слова, ни шутки, ни попытки подколоть друг друга."

# ch/kleio/events.rpy:2368
translate russian kleio_getting_serious_02_ca188c38:
    "Есть только мы с Клео и этот миг на двоих."

# ch/kleio/events.rpy:2369
translate russian kleio_getting_serious_02_dccb4471:
    "И ни один из нас не хочет, чтобы он заканчивался..."

# ch/kleio/events.rpy:2378
translate russian kleio_event_07_1_72c18959:
    "На улице довольно приятно: ясное небо и даже немного солнца в придачу."

# ch/kleio/events.rpy:2379
translate russian kleio_event_07_1_63e7a71f:
    "В такие дни я часто выбираюсь из дома, чтобы прогуляться где-нибудь в спокойном месте."

# ch/kleio/events.rpy:2380
translate russian kleio_event_07_1_8d36a9c4:
    "Но Клео я обычно с собой не беру."

# ch/kleio/events.rpy:2381
translate russian kleio_event_07_1_449ed8ce:
    "Скажем так, долгие романтические прогулки на природе — не её стихия!"

# ch/kleio/events.rpy:2382
translate russian kleio_event_07_1_0b167523:
    "Однако каким-то чудом мне удалось уговорить её немного пройтись по парку."

# ch/kleio/events.rpy:2383
translate russian kleio_event_07_1_b3878718:
    "Наверное, потому что я обещал сразу после этого отвести её в паб!"

# ch/kleio/events.rpy:2384
translate russian kleio_event_07_1_6f3abfc2:
    "Там хотя бы можно будет сесть за столик на улице."

# ch/kleio/events.rpy:2385
translate russian kleio_event_07_1_e7131ae1:
    "Так мы ещё немного насладимся хорошей погодой."

# ch/kleio/events.rpy:2386
translate russian kleio_event_07_1_09648615:
    "Правда, большую часть сил приходится тратить на то, чтобы развлекать Клео."

# ch/kleio/events.rpy:2387
translate russian kleio_event_07_1_ec99babd:
    "Она не из тех девушек, которым достаточно любоваться пейзажем!"

# ch/kleio/events.rpy:2389
translate russian kleio_event_07_1_c1668f7b:
    kleio.say "Это не тот парк, где повязали толпу героинщиков?"

# ch/kleio/events.rpy:2391
translate russian kleio_event_07_1_b1c4f188:
    kleio.say "Слушай, точно он."

# ch/kleio/events.rpy:2393
translate russian kleio_event_07_1_592534be:
    kleio.say "Я его в новостях видела!"

# ch/kleio/events.rpy:2395
translate russian kleio_event_07_1_f1d8a63c:
    mike.say "Эм..."

# ch/kleio/events.rpy:2396
translate russian kleio_event_07_1_8997a8e8:
    mike.say "Понятия не имею, Клео!"

# ch/kleio/events.rpy:2397
translate russian kleio_event_07_1_62914fb5:
    mike.say "Я сюда просто прихожу размяться, понимаешь?"

# ch/kleio/events.rpy:2398
translate russian kleio_event_07_1_40c5cb50:
    mike.say "Ну и уток иногда покормить."

# ch/kleio/events.rpy:2399
translate russian kleio_event_07_1_1c8d1b56:
    "Клео словно не замечает моих намёков сменить тему."

# ch/kleio/events.rpy:2400
translate russian kleio_event_07_1_6ef4ab71:
    "Как и того, что можно просто наслаждаться природой."

# ch/kleio/events.rpy:2401
translate russian kleio_event_07_1_df33e686:
    "Вместо этого её больше интересует всё плохое, что есть в парке."

# ch/kleio/events.rpy:2402
translate russian kleio_event_07_1_565fe3c7:
    kleio.say "А эти штуки, похожие на урны..."

# ch/kleio/events.rpy:2403
translate russian kleio_event_07_1_d7c3316c:
    kleio.say "Вон та, например. Они для чего?"

# ch/kleio/events.rpy:2404
translate russian kleio_event_07_1_30e74fc5:
    mike.say "Эм..."

# ch/kleio/events.rpy:2405
translate russian kleio_event_07_1_b5041089:
    mike.say "Туда выбрасывают собачьи... отходы."

# ch/kleio/events.rpy:2407
translate russian kleio_event_07_1_ccc6e06b:
    kleio.say "Фу... собачье говно, что ли?!"

# ch/kleio/events.rpy:2409
translate russian kleio_event_07_1_f9a267e7:
    mike.say "Да, Клео."

# ch/kleio/events.rpy:2410
translate russian kleio_event_07_1_f112741b:
    mike.say "Но сначала его кладут в пакет!"

# ch/kleio/events.rpy:2411
translate russian kleio_event_07_1_54d996a5:
    kleio.say "В такие, как те, что висят вон на дереве?"

# ch/kleio/events.rpy:2412
translate russian kleio_event_07_1_b3610baa:
    mike.say "Да, наверное..."

# ch/kleio/events.rpy:2413
translate russian kleio_event_07_1_ebecf1c6:
    mike.say "Это, кстати, дикая яблоня."

# ch/kleio/events.rpy:2414
translate russian kleio_event_07_1_6d0fe8e5:
    kleio.say "Ха... скорее дерьмовая яблоня!"

# ch/kleio/events.rpy:2416
translate russian kleio_event_07_1_9d093a47:
    "Я невольно фыркаю от её ехидного замечания."

# ch/kleio/events.rpy:2417
translate russian kleio_event_07_1_14f287b1:
    "Но за это я её и люблю!"

# ch/kleio/events.rpy:2418
translate russian kleio_event_07_1_aa22bd83:
    "Мы идём дальше: я твёрдо намерен сделать хотя бы один круг по парку."

# ch/kleio/events.rpy:2419
translate russian kleio_event_07_1_cc647c7d:
    "Клео продолжает придираться ко всему, что я ей показываю."

# ch/kleio/events.rpy:2420
translate russian kleio_event_07_1_d122d5d7:
    "Я уже почти смирился, что так и будет до конца прогулки."

# ch/kleio/events.rpy:2421
translate russian kleio_event_07_1_9fe41f8a:
    "Но тут замечаю знакомую фигуру, идущую нам навстречу."

# ch/kleio/events.rpy:2422
translate russian kleio_event_07_1_10ebe3ea:
    mike.say "Вот дерьмо!"

# ch/kleio/events.rpy:2424
translate russian kleio_event_07_1_c62700d1:
    kleio.say "Что такое, сердцеед?"

# ch/kleio/events.rpy:2426
translate russian kleio_event_07_1_ce7a52f7:
    kleio.say "Во что-то наступил?"

# ch/kleio/events.rpy:2428
translate russian kleio_event_07_1_b250b96f:
    mike.say "Нет, Клео..."

# ch/kleio/events.rpy:2429
translate russian kleio_event_07_1_08bc7976:
    mike.say "Видишь вон ту женщину?"

# ch/kleio/events.rpy:2430
translate russian kleio_event_07_1_f7b333da:
    kleio.say "А?"

# ch/kleio/events.rpy:2431
translate russian kleio_event_07_1_77479191:
    kleio.say "Ту тётку с огромными сиськами?"

# ch/kleio/events.rpy:2432
translate russian kleio_event_07_1_817c72a8:
    kleio.say "Господи, только не говори, что ты с ней трахался!"

# ch/kleio/events.rpy:2433
translate russian kleio_event_07_1_17ac92a9:
    mike.say "Нет, Клео!"

# ch/kleio/events.rpy:2434
translate russian kleio_event_07_1_18668951:
    mike.say "Это моя мама!"

# ch/kleio/events.rpy:2436
translate russian kleio_event_07_1_ec1fd674:
    "Клео от неожиданности даже присматривается к ней ещё раз."

# ch/kleio/events.rpy:2437
translate russian kleio_event_07_1_f8406850:
    kleio.say "Да ЛАДНО, сердцеед!"

# ch/kleio/events.rpy:2438
translate russian kleio_event_07_1_c2afe1c6:
    kleio.say "Ты из неё вылез?!"

# ch/kleio/events.rpy:2441
translate russian kleio_event_07_1_fc07e503:
    "Но я уже разворачиваюсь в другую сторону."

# ch/kleio/events.rpy:2442
translate russian kleio_event_07_1_3eb12bbb:
    kleio.say "Эй, подожди!"

# ch/kleio/events.rpy:2443
translate russian kleio_event_07_1_af30e648:
    kleio.say "Ты куда?"

# ch/kleio/events.rpy:2444
translate russian kleio_event_07_1_34a870e0:
    mike.say "А ты как думаешь, Клео?"

# ch/kleio/events.rpy:2445
translate russian kleio_event_07_1_a9df1862:
    mike.say "Туда, где она нас не увидит!"

# ch/kleio/events.rpy:2447
translate russian kleio_event_07_1_8bda1457:
    kleio.say "Не, хрен там."

# ch/kleio/events.rpy:2448
translate russian kleio_event_07_1_fb9fcbe7:
    kleio.say "Хочу с ней познакомиться."

# ch/kleio/events.rpy:2450
translate russian kleio_event_07_1_8322320d:
    kleio.say "ЭЙ, ЗДРАВСТВУЙТЕ!"

# ch/kleio/events.rpy:2451
translate russian kleio_event_07_1_f79eb009:
    kleio.say "ЭЙ... МАМА [lssb_kleio.hero_name()]!"

# ch/kleio/events.rpy:2453
translate russian kleio_event_07_1_8f26f405:
    "Не успеваю я её остановить, как Клео уже идёт к маме и кричит."

# ch/kleio/events.rpy:2454
translate russian kleio_event_07_1_341ebe23:
    "Разумеется, мама быстро слышит её и направляется к нам."

# ch/kleio/events.rpy:2455
translate russian kleio_event_07_1_75060314:
    "Ещё бы: глотка у Клео будь здоров!"

# ch/kleio/events.rpy:2458
translate russian kleio_event_07_1_7e112910:
    angela.say "О..."

# ch/kleio/events.rpy:2459
translate russian kleio_event_07_1_0ff6b0f1:
    angela.say "Здравствуй!"

# ch/kleio/events.rpy:2460
translate russian kleio_event_07_1_8472e00c:
    angela.say "И кто же ты такая?"

# ch/kleio/events.rpy:2461
translate russian kleio_event_07_1_0c59734c:
    kleio.say "Может, Клео."

# ch/kleio/events.rpy:2462
translate russian kleio_event_07_1_6cc09f78:
    kleio.say "А может, подруга вашего сына по перепихону!"

# ch/kleio/events.rpy:2464
translate russian kleio_event_07_1_62ba6558:
    "Я слышу, как эти слова слетают с губ Клео, словно в замедленной съёмке."

# ch/kleio/events.rpy:2465
translate russian kleio_event_07_1_e721cd22:
    "Как в кино, когда показывают выстрел."

# ch/kleio/events.rpy:2466
translate russian kleio_event_07_1_ac132624:
    "Потому что у мамы такое лицо, будто в неё попала пуля."

# ch/kleio/events.rpy:2467
translate russian kleio_event_07_1_4a311122:
    angela.say "Т... ты ведь хотела сказать... его девушка?"

# ch/kleio/events.rpy:2468
translate russian kleio_event_07_1_5dd182b2:
    kleio.say "Можно и так назвать, да."

# ch/kleio/events.rpy:2469
translate russian kleio_event_07_1_2d276a96:
    kleio.say "Но мы ещё и друзья, которые много трахаются."

# ch/kleio/events.rpy:2470
translate russian kleio_event_07_1_3d8c22df:
    kleio.say "Так что подруга по перепихону — вполне подходящее название."

# ch/kleio/events.rpy:2471
translate russian kleio_event_07_1_0fa31e98:
    mike.say "П... привет, мам!"

# ch/kleio/events.rpy:2472
translate russian kleio_event_07_1_3b5b8e99:
    mike.say "Вижу, Клео уже представилась!"

# ch/kleio/events.rpy:2474
translate russian kleio_event_07_1_8e2286f9:
    angela.say "Вот и ты, дорогой!"

# ch/kleio/events.rpy:2475
translate russian kleio_event_07_1_76b1a528:
    angela.say "Да... ещё как представилась!"

# ch/kleio/events.rpy:2476
translate russian kleio_event_07_1_60710368:
    "Клео приторно улыбается мне."

# ch/kleio/events.rpy:2477
translate russian kleio_event_07_1_ed9c4a97:
    "Ей явно нравится возможность устроить скандальчик."

# ch/kleio/events.rpy:2479
translate russian kleio_event_07_1_1dc84eaf:
    angela.say "Она говорит, что вы... вместе?"

# ch/kleio/events.rpy:2480
translate russian kleio_event_07_1_45f554d9:
    mike.say "Да, мам."

# ch/kleio/events.rpy:2481
translate russian kleio_event_07_1_0add1b8f:
    mike.say "Мы с Клео уже какое-то время встречаемся."

# ch/kleio/events.rpy:2483
translate russian kleio_event_07_1_8e1ed0d9:
    angela.say "Хм..."

# ch/kleio/events.rpy:2484
translate russian kleio_event_07_1_48c51d90:
    angela.say "Странно, что ты раньше ни разу о ней не упоминал!"

# ch/kleio/events.rpy:2485
translate russian kleio_event_07_1_55525944:
    "Вот дерьмо, кажется, мама готова к бою!"

# ch/kleio/events.rpy:2486
translate russian kleio_event_07_1_4817d6d7:
    "Поверьте, это не к добру."

# ch/kleio/events.rpy:2487
translate russian kleio_event_07_1_37687580:
    "Я знаю, что Клео умеет быть той ещё стервой."

# ch/kleio/events.rpy:2488
translate russian kleio_event_07_1_75ef9b13:
    "Но моя мама ей ничуть не уступит."

# ch/kleio/events.rpy:2489
translate russian kleio_event_07_1_1830b0e7:
    "И опыта у неё куда больше!"

# ch/kleio/events.rpy:2490
translate russian kleio_event_07_1_fd2873a0:
    kleio.say "Ну да..."

# ch/kleio/events.rpy:2491
translate russian kleio_event_07_1_184cd278:
    kleio.say "Просто его язык у меня обычно занят вот здесь!"

# ch/kleio/events.rpy:2492
translate russian kleio_event_07_1_b064425f:
    "Клео обеими руками указывает себе на промежность."

# ch/kleio/events.rpy:2494
translate russian kleio_event_07_1_f86b637e:
    "И ухмыляется моей маме."

# ch/kleio/events.rpy:2496
translate russian kleio_event_07_1_ccdd9871:
    angela.say "Ой, какие милые рисунки у тебя на животике, дорогая."

# ch/kleio/events.rpy:2497
translate russian kleio_event_07_1_f7b3d287:
    angela.say "Ты сама их фломастером нарисовала?"

# ch/kleio/events.rpy:2499
translate russian kleio_event_07_1_0e0d4cd9:
    kleio.say "ЧЕГО?!"

# ch/kleio/events.rpy:2500
translate russian kleio_event_07_1_92cdc4c2:
    kleio.say "Зато мне грудь ножным насосом не накачивали!"

# ch/kleio/events.rpy:2502
translate russian kleio_event_07_1_07d37aea:
    "Мама смеётся и отмахивается от слов Клео, словно от пустяка."

# ch/kleio/events.rpy:2503
translate russian kleio_event_07_1_907b40f2:
    angela.say "Для начала там должно хоть что-нибудь быть."

# ch/kleio/events.rpy:2505
translate russian kleio_event_07_1_86526574:
    angela.say "Скажи, Клео, тебя часто принимают за мальчика?"

# ch/kleio/events.rpy:2509
translate russian kleio_event_07_1_011506e9:
    kleio.say "Чт... да... что ты сказала?!"

# ch/kleio/events.rpy:2511
translate russian kleio_event_07_1_05740488:
    "Я едва успеваю схватить Клео, прежде чем она бросается на маму."

# ch/kleio/events.rpy:2513
translate russian kleio_event_07_1_ac921656:
    "С безумной улыбкой на лице я утаскиваю её по дорожке."

# ch/kleio/events.rpy:2514
translate russian kleio_event_07_1_3a3f3ccf:
    mike.say "А... ладно, мам!"

# ch/kleio/events.rpy:2515
translate russian kleio_event_07_1_6344d284:
    mike.say "Рад был увидеться!"

# ch/kleio/events.rpy:2516
translate russian kleio_event_07_1_836c0fa4:
    mike.say "Пойдём, Клео, пора в паб!"

# ch/kleio/events.rpy:2518
translate russian kleio_event_07_1_1ba9ee18:
    "Мама посмеивается, глядя на то, как мне приходится удерживать Клео."

# ch/kleio/events.rpy:2519
translate russian kleio_event_07_1_2495c2f1:
    angela.say "До встречи, дорогой."

# ch/kleio/events.rpy:2521
translate russian kleio_event_07_1_db8c005f:
    angela.say "И не волнуйся, Клео: [lssb_kleio.hero_name()] с детства чем только не увлекался."

# ch/kleio/events.rpy:2523
translate russian kleio_event_07_1_67ff27ed:
    angela.say "Скорее всего, и ты — очередное временное увлечение!"

# ch/kleio/events.rpy:2524
translate russian kleio_event_07_1_7997fa8d:
    "Клео издаёт яростное рычание."

# ch/kleio/events.rpy:2526
translate russian kleio_event_07_1_d0c02ddd:
    "И показывает маме средний палец."

# ch/kleio/events.rpy:2527
translate russian kleio_event_07_1_e3b23601:
    kleio.say "Пошла ты, старая карга!"

# ch/kleio/events.rpy:2528
translate russian kleio_event_07_1_ea9b9251:
    kleio.say "Я тебе ещё устрою, вот увидишь!"

# ch/kleio/events.rpy:2529
translate russian kleio_event_07_1_159cf856:
    kleio.say "А если я выйду за твоего драгоценного сыночка, а?"

# ch/kleio/events.rpy:2530
translate russian kleio_event_07_1_c0ab4ade:
    kleio.say "И мы будем жить долго и счастливо и нарожаем кучу спиногрызов?"

# ch/kleio/events.rpy:2531
translate russian kleio_event_07_1_98f64a51:
    kleio.say "Тебе придётся проводить со мной все праздники до самой смерти!"

# ch/kleio/events.rpy:2538
translate russian kleio_event_08_0768050b:
    "Как ни стараюсь, сегодня я так взбудоражен, что не могу согнать с лица дурацкую улыбку."

# ch/kleio/events.rpy:2539
translate russian kleio_event_08_cc07db0a:
    "Она не сходит с меня, пока мы стоим в очереди и показываем билеты на входе."

# ch/kleio/events.rpy:2541
translate russian kleio_event_08_b341504b:
    "А Клео всякий раз, покосившись на меня, качает головой, закатывает глаза и презрительно фыркает."

# ch/kleio/events.rpy:2543
translate russian kleio_event_08_9b332da4:
    "Но всё же я вижу: её это больше забавляет, чем раздражает."

# ch/kleio/events.rpy:2544
translate russian kleio_event_08_196155db:
    "И сама она тоже в предвкушении."

# ch/kleio/events.rpy:2545
translate russian kleio_event_08_fe103996:
    "Просто лучше это скрывает."

# ch/kleio/events.rpy:2547
translate russian kleio_event_08_734e06d4:
    kleio.say "Боже, сердцеед!"

# ch/kleio/events.rpy:2549
translate russian kleio_event_08_2d2f65c5:
    kleio.say "Ты весь вечер будешь улыбаться как идиот?"

# ch/kleio/events.rpy:2550
translate russian kleio_event_08_fbf06d78:
    mike.say "А я так делаю, Клео?"

# ch/kleio/events.rpy:2551
translate russian kleio_event_08_478e2a70:
    mike.say "Прости, до сих пор не верится, что я достал нам билеты."

# ch/kleio/events.rpy:2552
translate russian kleio_event_08_fc610f00:
    mike.say "И не куда-нибудь, а на Metallikea!"

# ch/kleio/events.rpy:2554
translate russian kleio_event_08_5e30a8d9:
    kleio.say "Ладно, ладно, я поняла!"

# ch/kleio/events.rpy:2555
translate russian kleio_event_08_e7f20b9a:
    kleio.say "И я тебе благодарна, правда."

# ch/kleio/events.rpy:2556
translate russian kleio_event_08_fb33acb7:
    kleio.say "Только хватит уже напрашиваться на похвалу, а?"

# ch/kleio/events.rpy:2557
translate russian kleio_event_08_fa564d48:
    "Я поспешно киваю, не желая портить настроение."

# ch/kleio/events.rpy:2558
translate russian kleio_event_08_35aa6dd0:
    "К тому же пусть лучше Клео и дальше думает, что мне просто повезло с билетами."

# ch/kleio/events.rpy:2559
translate russian kleio_event_08_e3dccca7:
    "Незачем ей знать, чего мне стоило их достать."

# ch/kleio/events.rpy:2560
translate russian kleio_event_08_8870c46b:
    "За часы ожидания на билетной горячей линии мне уже пришёл огромный счёт за телефон."

# ch/kleio/events.rpy:2561
translate russian kleio_event_08_514baa9c:
    "А перекупщик, у которого я в итоге их купил, содрал с меня столько, что в бюджете зияет дыра!"

# ch/kleio/events.rpy:2562
translate russian kleio_event_08_d6e7b6d5:
    "Но всё это стоило того: Клео благодарна мне и хорошо проводит время."

# ch/kleio/events.rpy:2563
translate russian kleio_event_08_f33e4800:
    "Через мгновение она выдёргивает меня из задумчивости, крепко схватив за запястье."

# ch/kleio/events.rpy:2564
translate russian kleio_event_08_c879c47d:
    mike.say "Эй, Клео!"

# ch/kleio/events.rpy:2565
translate russian kleio_event_08_5c770f84:
    mike.say "Что происходит?!"

# ch/kleio/events.rpy:2566
translate russian kleio_event_08_2c0bc66d:
    kleio.say "Давай, сердцеед."

# ch/kleio/events.rpy:2568
translate russian kleio_event_08_db2a7691:
    kleio.say "Начинается!"

# ch/kleio/events.rpy:2572
translate russian kleio_event_08_d8193148:
    "И вот меня уже тащат в самую гущу собравшейся толпы."

# ch/kleio/events.rpy:2573
translate russian kleio_event_08_1d1c5c5f:
    "Но Клео на этом не останавливается."

# ch/kleio/events.rpy:2574
translate russian kleio_event_08_81323ec5:
    "Она протискивается всё глубже в людское месиво."

# ch/kleio/events.rpy:2576
translate russian kleio_event_08_695177cc:
    "Не успеваю я опомниться, как меня начинают пихать со всех сторон."

# ch/kleio/events.rpy:2577
translate russian kleio_event_08_c9c0d2b7:
    "Мне прилетает локтями по животу и паху."

# ch/kleio/events.rpy:2579
translate russian kleio_event_08_0a67937e:
    "Кто-то наступает мне на ноги, и я спотыкаюсь, чуть не падая."

# ch/kleio/events.rpy:2580
translate russian kleio_event_08_dd183dec:
    "Несколько раз меня даже умудряются боднуть головой!"

# ch/kleio/events.rpy:2581
translate russian kleio_event_08_e0f017be:
    "Но сквозь всё это я каким-то чудом продолжаю держать Клео за руку."

# ch/kleio/events.rpy:2582
translate russian kleio_event_08_04f55d6b:
    "Наконец она, видимо, находит подходящее место и перестаёт тащить меня за собой."

# ch/kleio/events.rpy:2583
translate russian kleio_event_08_82b10f61:
    "Когда зрение приходит в норму, остаётся признать: я впечатлён."

# ch/kleio/events.rpy:2584
translate russian kleio_event_08_35ff7c83:
    "Она пробилась туда, откуда открывается отличный вид на сцену."

# ch/kleio/events.rpy:2585
translate russian kleio_event_08_2d9ac592:
    "Ещё и подальше от уже вовсю бушующего слэма — какое облегчение!"

# ch/kleio/events.rpy:2586
translate russian kleio_event_08_9bfdc4e1:
    "Дальше всё сливается в вихрь визжащего вокала, скрежещущих аккордов и грохочущих ритмов."

# ch/kleio/events.rpy:2587
translate russian kleio_event_08_e378ddd3:
    "Отдельных моментов не вспомнить, а песни сливаются в одну."

# ch/kleio/events.rpy:2588
translate russian kleio_event_08_230620f8:
    "Но этот концерт я не забуду никогда."

# ch/kleio/events.rpy:2589
translate russian kleio_event_08_626501e6:
    "Благодаря тому восторгу, который он во мне вызывает."

# ch/kleio/events.rpy:2590
translate russian kleio_event_08_42915516:
    "И тому кайфу, который остаётся после."

# ch/kleio/events.rpy:2591
translate russian kleio_event_08_a030f378:
    "Когда заканчивается последний выход на бис, Клео снова хватает меня за запястье."

# ch/kleio/events.rpy:2596
translate russian kleio_event_08_ad5aa097:
    kleio.say "[lssb_kleio.hero_name()]..."

# ch/kleio/events.rpy:2597
translate russian kleio_event_08_1db75a37:
    kleio.say "Это было ОФИГЕННО!"

# ch/kleio/events.rpy:2598
translate russian kleio_event_08_11638cc9:
    mike.say "Можешь не рассказывать, Клео."

# ch/kleio/events.rpy:2599
translate russian kleio_event_08_98ea9924:
    mike.say "Я тоже здесь был!"

# ch/kleio/events.rpy:2601
translate russian kleio_event_08_90ad2983:
    kleio.say "Не думала, что они когда-нибудь смогут заменить Клинта Томпсона."

# ch/kleio/events.rpy:2602
translate russian kleio_event_08_b3148ba6:
    mike.say "Понимаю, о чём ты."

# ch/kleio/events.rpy:2603
translate russian kleio_event_08_1229f32a:
    mike.say "Но новая басистка чертовски хороша."

# ch/kleio/events.rpy:2605
translate russian kleio_event_08_8938e7b8:
    kleio.say "И чертовски сексуальна!"

# ch/kleio/events.rpy:2608
translate russian kleio_event_08_9a7aa285:
    mike.say "Эм, да, Клео, у меня тоже глаза есть!"

# ch/kleio/events.rpy:2609
translate russian kleio_event_08_5ae1280b:
    mike.say "Как можно не заметить такую красотку?!"

# ch/kleio/events.rpy:2610
translate russian kleio_event_08_20e36729:
    mike.say "Уверен, все парни и девушки здесь подумали то же самое."

# ch/kleio/events.rpy:2612
translate russian kleio_event_08_11b1eed6:
    "Клео косится на меня со странным выражением лица."

# ch/kleio/events.rpy:2614
translate russian kleio_event_08_2cf465e2:
    kleio.say "Правда, [lssb_kleio.hero_name()]?"

# ch/kleio/events.rpy:2616
translate russian kleio_event_08_41d596df:
    kleio.say "И тебя... тебя это не напрягает?"

# ch/kleio/events.rpy:2617
translate russian kleio_event_08_9e32e60f:
    "Я недоумённо хмурюсь."

# ch/kleio/events.rpy:2618
translate russian kleio_event_08_18e4a9d6:
    mike.say "С чего бы, Клео?"

# ch/kleio/events.rpy:2619
translate russian kleio_event_08_a1f284e6:
    mike.say "Мы оба взрослые. Можем ведь признать, что нам нравятся и другие люди?"

# ch/kleio/events.rpy:2620
translate russian kleio_event_08_1d0e1a9a:
    kleio.say "Знаю, знаю..."

# ch/kleio/events.rpy:2622
translate russian kleio_event_08_5621d6fc:
    kleio.say "Просто... ну..."

# ch/kleio/events.rpy:2623
translate russian kleio_event_08_85a37494:
    kleio.say "Некоторых мужиков очень напрягает, что мне нравятся и парни, и девушки, понимаешь?"

# ch/kleio/events.rpy:2624
translate russian kleio_event_08_eff49339:
    "Я пожимаю плечами, не зная, что сказать, кроме правды."

# ch/kleio/events.rpy:2625
translate russian kleio_event_08_c2daedba:
    mike.say "Я не из таких, Клео."

# ch/kleio/events.rpy:2627
translate russian kleio_event_08_7aede297:
    mike.say "Знаю, что до меня ты встречалась с девушками."

# ch/kleio/events.rpy:2628
translate russian kleio_event_08_e8f02a51:
    mike.say "И меня это вполне устраивает."

# ch/kleio/events.rpy:2629
translate russian kleio_event_08_2ecf7ac1:
    mike.say "Главное, чтобы я тебе не разонравился!"

# ch/kleio/events.rpy:2630
translate russian kleio_event_08_0db01652:
    "Клео долго молчит, не отводя от меня взгляда."

# ch/kleio/events.rpy:2633
translate russian kleio_event_08_46ecb3fc:
    "А потом вдруг притягивает меня к себе и целует в губы."

# ch/kleio/events.rpy:2634
translate russian kleio_event_08_84a87977:
    "Оправившись от неожиданности, я с жаром отвечаю на поцелуй."

# ch/kleio/events.rpy:2636
translate russian kleio_event_08_44067755:
    "Потом качаю головой, глядя на неё."

# ch/kleio/events.rpy:2637
translate russian kleio_event_08_c38957ff:
    mike.say "Эх, Клео..."

# ch/kleio/events.rpy:2639
translate russian kleio_event_08_0bcae31c:
    mike.say "Это за что?"

# ch/kleio/events.rpy:2640
translate russian kleio_event_08_77684253:
    kleio.say "За то, что ты такой, [lssb_kleio.hero_name()]."

# ch/kleio/events.rpy:2642
translate russian kleio_event_08_467f6f6b:
    kleio.say "Просто за то, что ты — это ты."

# ch/kleio/events.rpy:2643
translate russian kleio_event_08_92d383ff:
    "Я снова качаю головой."

# ch/kleio/events.rpy:2644
translate russian kleio_event_08_7f41ad17:
    "Не до конца понимаю, что она имеет в виду, но рад, что ей хорошо."

# ch/kleio/events.rpy:2648
translate russian kleio_event_08_684c63c1:
    mike.say "Т... ты правда так думаешь?"

# ch/kleio/events.rpy:2649
translate russian kleio_event_08_4dd46d1b:
    mike.say "Я и не заметил..."

# ch/kleio/events.rpy:2650
translate russian kleio_event_08_e8d1923a:
    "Клео косится на меня с явным недоверием."

# ch/kleio/events.rpy:2652
translate russian kleio_event_08_834cc3c4:
    kleio.say "Да ладно тебе, [lssb_kleio.hero_name()]!"

# ch/kleio/events.rpy:2653
translate russian kleio_event_08_6fa7861b:
    kleio.say "Кого ты пытаешься обмануть?"

# ch/kleio/events.rpy:2654
translate russian kleio_event_08_502ec7ae:
    "Я уже открываю рот, чтобы снова всё отрицать."

# ch/kleio/events.rpy:2655
translate russian kleio_event_08_8319ab3a:
    "Но выражение лица Клео едва заметно меняется."

# ch/kleio/events.rpy:2656
translate russian kleio_event_08_1db5e877:
    "Она кивает, словно только что что-то поняла."

# ch/kleio/events.rpy:2657
translate russian kleio_event_08_db93b6d7:
    kleio.say "Ты ревнуешь?"

# ch/kleio/events.rpy:2658
translate russian kleio_event_08_52c65242:
    mike.say "Что?!"

# ch/kleio/events.rpy:2659
translate russian kleio_event_08_029affd4:
    mike.say "Нет... не говори глупостей."

# ch/kleio/events.rpy:2661
translate russian kleio_event_08_68e1aada:
    kleio.say "О боже, ты и правда РЕВНУЕШЬ!"

# ch/kleio/events.rpy:2664
translate russian kleio_event_08_3c0d2483:
    kleio.say "Потому что она женщина?"

# ch/kleio/events.rpy:2666
translate russian kleio_event_08_0becfe47:
    kleio.say "Или просто в себе не уверен, а?"

# ch/kleio/events.rpy:2667
translate russian kleio_event_08_11bb1ce9:
    kleio.say "Первое, конечно, так себе."

# ch/kleio/events.rpy:2668
translate russian kleio_event_08_04b813a7:
    kleio.say "Но второе — вообще никуда не годится!"

# ch/kleio/events.rpy:2669
translate russian kleio_event_08_614f8a8e:
    mike.say "Ни то ни другое, потому что я не ревную!"

# ch/kleio/events.rpy:2670
translate russian kleio_event_08_27ba8621:
    kleio.say "А голос повышаешь, будто ревнуешь."

# ch/kleio/events.rpy:2671
translate russian kleio_event_08_eb54d8a1:
    mike.say "Клео, ну пожалуйста."

# ch/kleio/events.rpy:2672
translate russian kleio_event_08_a575416e:
    mike.say "Если я и повышаю голос, то потому, что меня обвиняют в том, чего нет!"

# ch/kleio/events.rpy:2673
translate russian kleio_event_08_65479a50:
    "Клео щурится: мои заверения в невиновности её явно не убедили."

# ch/kleio/events.rpy:2675
translate russian kleio_event_08_56da1ef2:
    kleio.say "Как скажешь, [lssb_kleio.hero_name()]."

# ch/kleio/events.rpy:2676
translate russian kleio_event_08_93803958:
    kleio.say "Но когда остынешь, мы об этом серьёзно поговорим."

# ch/kleio/events.rpy:2677
translate russian kleio_event_08_b246b2d7:
    "Я воспринимаю это как предупреждение: разговор окончен, пора заткнуться."

# ch/kleio/events.rpy:2678
translate russian kleio_event_08_2d68cd50:
    "Но до конца вечера не могу перестать дуться."

# ch/kleio/events.rpy:2679
translate russian kleio_event_08_0ddb394f:
    "И неприятный осадок отравляет всё, как бы я ни пытался от него избавиться."

# ch/kleio/events.rpy:2692
translate russian kleio_event_09_7adfa87b:
    "Бывало у вас такое: всё идёт своим чередом, ничто не предвещает беды..."

# ch/kleio/events.rpy:2693
translate russian kleio_event_09_ad0327dc:
    "И вдруг случается что-то, к чему вы совершенно не готовы?"

# ch/kleio/events.rpy:2694
translate russian kleio_event_09_1b205e3f:
    "Вот и со мной сейчас так: звонит телефон, и я, ничего не подозревая, беру трубку."

# ch/kleio/events.rpy:2695
translate russian kleio_event_09_4422dec8:
    "Имя звонящего не определяется, номер мне незнаком."

# ch/kleio/events.rpy:2696
translate russian kleio_event_09_a34082c7:
    "Правда, замечаю, что это городской телефон с местным кодом."

# ch/kleio/events.rpy:2697
translate russian kleio_event_09_d9299693:
    "Это немного необычно, и я едва не сбрасываю звонок."

# ch/kleio/events.rpy:2698
translate russian kleio_event_09_6d6df7d6:
    "Думаю: кому надо — оставит сообщение, а на остальных незачем тратить время."

# ch/kleio/events.rpy:2699
translate russian kleio_event_09_779ee9fd:
    "Но что-то заставляет меня передумать и всё-таки ответить."

# ch/kleio/events.rpy:2700
translate russian kleio_event_09_cb18f14d:
    "Не могу объяснить: просто внутреннее чутьё подсказывает взять трубку."

# ch/kleio/events.rpy:2701
translate russian kleio_event_09_7bc80586:
    mike.say "Алло?"

# ch/kleio/events.rpy:2702
translate russian kleio_event_09_b1bbf424:
    mike.say "Кто это?"

# ch/kleio/events.rpy:2703
translate russian kleio_event_09_2d5f6576:
    kleio.say "[lssb_kleio.hero_name()], как же я рада тебя слышать!"

# ch/kleio/events.rpy:2704
translate russian kleio_event_09_374c73ec:
    kleio.say "Только не клади трубку!"

# ch/kleio/events.rpy:2705
translate russian kleio_event_09_97caf24d:
    "Не знаю, что удивляет меня больше."

# ch/kleio/events.rpy:2706
translate russian kleio_event_09_0d432a35:
    "То, что звонит Клео."

# ch/kleio/events.rpy:2707
translate russian kleio_event_09_95800a0e:
    "Или едва сдерживаемая паника в её голосе."

# ch/kleio/events.rpy:2708
translate russian kleio_event_09_1bdf9402:
    mike.say "Господи, Клео, что случилось?"

# ch/kleio/events.rpy:2709
translate russian kleio_event_09_c633af0c:
    mike.say "Ты в порядке?"

# ch/kleio/events.rpy:2710
translate russian kleio_event_09_7c643bd2:
    "Я почти слышу, как на другом конце провода Клео пытается взять себя в руки."

# ch/kleio/events.rpy:2711
translate russian kleio_event_09_e2acad36:
    "Будто одного моего голоса достаточно, чтобы придать ей сил."

# ch/kleio/events.rpy:2712
translate russian kleio_event_09_12111b64:
    kleio.say "Я... я в порядке, [lssb_kleio.hero_name()]."

# ch/kleio/events.rpy:2713
translate russian kleio_event_09_c3b21948:
    kleio.say "Мне просто нужна помощь, вот и всё."

# ch/kleio/events.rpy:2714
translate russian kleio_event_09_80188e0f:
    kleio.say "Я тут... немного влипла, понимаешь?"

# ch/kleio/events.rpy:2715
translate russian kleio_event_09_17122b98:
    "Я глубоко вдыхаю, готовясь к тому, что услышу дальше."

# ch/kleio/events.rpy:2716
translate russian kleio_event_09_6b7dbdb6:
    mike.say "Где ты, Клео?"

# ch/kleio/events.rpy:2717
translate russian kleio_event_09_57852bb7:
    kleio.say "Ладно, только обещай не психовать, хорошо?"

# ch/kleio/events.rpy:2718
translate russian kleio_event_09_500d7a68:
    mike.say "Чёрт, Клео, где ты?!"

# ch/kleio/events.rpy:2719
translate russian kleio_event_09_0d824b84:
    kleio.say "В полицейском участке, ясно?!"

# ch/kleio/events.rpy:2721
translate russian kleio_event_09_21c51504:
    mike.say "В ПОЛИЦЕЙСКОМ УЧАСТКЕ?!"

# ch/kleio/events.rpy:2722
translate russian kleio_event_09_741351c2:
    mike.say "Клео, на тебя напали или что?!"

# ch/kleio/events.rpy:2723
translate russian kleio_event_09_5d4ddf6b:
    kleio.say "Нет... нет..."

# ch/kleio/events.rpy:2724
translate russian kleio_event_09_0ac58434:
    kleio.say "Ничего такого!"

# ch/kleio/events.rpy:2725
translate russian kleio_event_09_62219ccc:
    mike.say "Тогда что..."

# ch/kleio/events.rpy:2726
translate russian kleio_event_09_1855b30f:
    kleio.say "Меня арестовали..."

# ch/kleio/events.rpy:2727
translate russian kleio_event_09_40bdda4d:
    kleio.say "На митинге..."

# ch/kleio/events.rpy:2728
translate russian kleio_event_09_bb79f92c:
    "Теперь всё начинает проясняться."

# ch/kleio/events.rpy:2729
translate russian kleio_event_09_f4aa65c7:
    "Помню, Клео говорила, что сегодня идёт на какую-то демонстрацию."

# ch/kleio/events.rpy:2730
translate russian kleio_event_09_e3ccbe07:
    "Но она вечно ходит на всякие протесты, так что я не придал этому значения."

# ch/kleio/events.rpy:2731
translate russian kleio_event_09_76187eed:
    mike.say "Как ты вообще умудрилась?"

# ch/kleio/events.rpy:2732
translate russian kleio_event_09_ce76b406:
    kleio.say "Это чистый полицейский произвол!"

# ch/kleio/events.rpy:2733
translate russian kleio_event_09_5ed79af3:
    kleio.say "Они начали нас пихать и толкать!"

# ch/kleio/events.rpy:2734
translate russian kleio_event_09_d4355bf9:
    mike.say "Ладно, Клео, избавь меня от жутких подробностей."

# ch/kleio/events.rpy:2735
translate russian kleio_event_09_bcde116c:
    mike.say "Полагаю, это твой единственный звонок?"

# ch/kleio/events.rpy:2736
translate russian kleio_event_09_a57824d9:
    kleio.say "Да, [lssb_kleio.hero_name()], я не знала, к кому ещё обратиться!"

# ch/kleio/events.rpy:2737
translate russian kleio_event_09_d48cdde2:
    kleio.say "Говорят, нужно внести залог."

# ch/kleio/events.rpy:2738
translate russian kleio_event_09_1011b9d4:
    kleio.say "Иначе придётся провести ночь в камере!"

# ch/kleio/events.rpy:2739
translate russian kleio_event_09_08a9b882:
    "Я не могу поверить своим ушам."

# ch/kleio/events.rpy:2740
translate russian kleio_event_09_a42ee6c1:
    "Будто в каком-то шаблонном кино!"

# ch/kleio/events.rpy:2743
translate russian kleio_event_09_d353debc:
    mike.say "Никуда не уходи, Клео."

# ch/kleio/events.rpy:2744
translate russian kleio_event_09_00f1c5ab:
    mike.say "Я уже еду!"

# ch/kleio/events.rpy:2745
translate russian kleio_event_09_0dad78e2:
    "Не дав Клео ответить, я выбегаю за дверь."

# ch/kleio/events.rpy:2748
translate russian kleio_event_09_01630ece:
    "Добравшись до полицейского участка, я спешу внутрь."

# ch/kleio/events.rpy:2749
translate russian kleio_event_09_67431588:
    "Ещё до первого слова дежурному у меня в руке уже кредитка."

# ch/kleio/events.rpy:2751
translate russian kleio_event_09_d5b34e10:
    "Как только Клео отпускают, я бросаюсь к ней."

# ch/kleio/events.rpy:2753
translate russian kleio_event_09_d49c216f:
    kleio.say "Привет, сердцеед!"

# ch/kleio/events.rpy:2754
translate russian kleio_event_09_362f45dd:
    kleio.say "Сколько я тебе должна за спасение?"

# ch/kleio/events.rpy:2755
translate russian kleio_event_09_3099eb25:
    mike.say "Не думай об этом, Клео. Это всего лишь деньги."

# ch/kleio/events.rpy:2756
translate russian kleio_event_09_be4cd7e2:
    mike.say "Ты точно в порядке?"

# ch/kleio/events.rpy:2757
translate russian kleio_event_09_8c0fe893:
    mike.say "Кто-нибудь из них тебя трогал?"

# ch/kleio/events.rpy:2758
translate russian kleio_event_09_1db9fe2f:
    mike.say "Если они хоть пальцем тебя тронули..."

# ch/kleio/events.rpy:2759
translate russian kleio_event_09_e72cb9f2:
    "Моя тирада явно смущает Клео, и она кладёт ладони мне на грудь."

# ch/kleio/events.rpy:2760
translate russian kleio_event_09_0c541b00:
    "Она качает головой, пытаясь отвлечь меня от злобных взглядов в сторону проходящих мимо полицейских."

# ch/kleio/events.rpy:2761
translate russian kleio_event_09_6fc44831:
    kleio.say "Тише, сердцеед, тише!"

# ch/kleio/events.rpy:2762
translate russian kleio_event_09_fe536d89:
    kleio.say "Никто ничего не сделал. Я в порядке, ясно?"

# ch/kleio/events.rpy:2763
translate russian kleio_event_09_b473498c:
    "Я киваю, хотя её заверения не до конца меня убедили."

# ch/kleio/events.rpy:2764
translate russian kleio_event_09_403b7348:
    mike.say "Ладно, Клео, раз ты так говоришь."

# ch/kleio/events.rpy:2765
translate russian kleio_event_09_2f2946cd:
    mike.say "Но больше ты на эти протесты одна не пойдёшь!"

# ch/kleio/events.rpy:2766
translate russian kleio_event_09_d546b3b5:
    "Услышав это, Клео немного отстраняется."

# ch/kleio/events.rpy:2767
translate russian kleio_event_09_61edcf3a:
    "На её лице появляется недоумение."

# ch/kleio/events.rpy:2769
translate russian kleio_event_09_183fffde:
    kleio.say "Ты... ты запрещаешь мне ходить на протесты?!"

# ch/kleio/events.rpy:2770
translate russian kleio_event_09_5d1d8c8c:
    "Я энергично мотаю головой."

# ch/kleio/events.rpy:2771
translate russian kleio_event_09_40c2dab8:
    mike.say "Да ни хрена, Клео."

# ch/kleio/events.rpy:2772
translate russian kleio_event_09_3eab4d28:
    mike.say "Просто теперь я буду ходить с тобой!"

# ch/kleio/events.rpy:2773
translate russian kleio_event_09_ad726e48:
    mike.say "Когда там протест против полицейского произвола?!"

# ch/kleio/events.rpy:2775
translate russian kleio_event_09_d050a4cd:
    "Клео склоняет голову набок и странно смотрит на меня."

# ch/kleio/events.rpy:2776
translate russian kleio_event_09_e2006288:
    kleio.say "Серьёзно, [lssb_kleio.hero_name()]."

# ch/kleio/events.rpy:2777
translate russian kleio_event_09_d5a52674:
    kleio.say "Спасибо, что приехал меня спасать."

# ch/kleio/events.rpy:2778
translate russian kleio_event_09_17ea0efd:
    kleio.say "Мне очень важно знать, что ты на моей стороне."

# ch/kleio/events.rpy:2779
translate russian kleio_event_09_ece17634:
    mike.say "Всегда пожалуйста, Клео."

# ch/kleio/events.rpy:2781
translate russian kleio_event_09_7298e55a:
    "В непривычном порыве нежности Клео берёт меня под руку и кладёт голову мне на плечо."

# ch/kleio/events.rpy:2782
translate russian kleio_event_09_0e7bca59:
    "И мы вместе выходим из участка, не оглядываясь."

# ch/kleio/events.rpy:2785
translate russian kleio_event_09_82db05bc:
    mike.say "Во сколько мне это обойдётся, Клео?"

# ch/kleio/events.rpy:2786
translate russian kleio_event_09_1116852e:
    "На другом конце линии повисает пауза."

# ch/kleio/events.rpy:2787
translate russian kleio_event_09_f8a5dba8:
    "Клео словно не ожидала такого вопроса."

# ch/kleio/events.rpy:2788
translate russian kleio_event_09_a54bc3eb:
    mike.say "Сколько, Клео?!"

# ch/kleio/events.rpy:2789
translate russian kleio_event_09_bbbe3794:
    kleio.say "Эм..."

# ch/kleio/events.rpy:2790
translate russian kleio_event_09_9d042421:
    kleio.say "Ну... пару сотен баксов..."

# ch/kleio/events.rpy:2791
translate russian kleio_event_09_486ff41d:
    mike.say "Это большие деньги, Клео!"

# ch/kleio/events.rpy:2792
translate russian kleio_event_09_6e1a087a:
    mike.say "Я что тебе, блядь, банкомат?"

# ch/kleio/events.rpy:2793
translate russian kleio_event_09_6985e8e1:
    kleio.say "К... конечно нет!"

# ch/kleio/events.rpy:2794
translate russian kleio_event_09_2239f9c0:
    kleio.say "Я просто подумала..."

# ch/kleio/events.rpy:2795
translate russian kleio_event_09_f7d587f8:
    "Я перебиваю Клео, не дав ей договорить."

# ch/kleio/events.rpy:2796
translate russian kleio_event_09_f184f7a1:
    mike.say "Знаешь что, Клео."

# ch/kleio/events.rpy:2797
translate russian kleio_event_09_fe455f54:
    mike.say "Может, ночь в камере пойдёт тебе на пользу."

# ch/kleio/events.rpy:2798
translate russian kleio_event_09_2da81dfc:
    mike.say "Будет время подумать, как ты там оказалась!"

# ch/kleio/events.rpy:2799
translate russian kleio_event_09_8dc5de36:
    kleio.say "Что?!"

# ch/kleio/events.rpy:2800
translate russian kleio_event_09_4c7ec16d:
    kleio.say "[lssb_kleio.hero_name()], почему ты так со мной?!"

# ch/kleio/events.rpy:2801
translate russian kleio_event_09_a3175b68:
    mike.say "Потому что ты уже взрослая, Клео."

# ch/kleio/events.rpy:2802
translate russian kleio_event_09_294f20df:
    mike.say "И пора отвечать за свои ошибки!"

# ch/kleio/events.rpy:2803
translate russian kleio_event_09_93a4f1bd:
    kleio.say "[lssb_kleio.hero_name()], пожалуйста..."

# ch/kleio/events.rpy:2804
translate russian kleio_event_09_cf953036:
    "Я кладу трубку, пока она не заставила меня передумать."

# ch/kleio/events.rpy:2805
translate russian kleio_event_09_f152e17c:
    "Да, это жестоко, и какое-то время она будет меня ненавидеть."

# ch/kleio/events.rpy:2806
translate russian kleio_event_09_1043ae8a:
    "Но я правда считаю, что Клео нужно извлечь из этого урок."

# ch/kleio/events.rpy:2818
translate russian kleio_event_10_bc8bfb50:
    "Звонит телефон, и я машинально отвечаю, едва заметив, что это Клео."

# ch/kleio/events.rpy:2819
translate russian kleio_event_10_05e94cbb:
    kleio.say "Привет, сердцеед. Чем сейчас занимаешься?"

# ch/kleio/events.rpy:2820
translate russian kleio_event_10_c38957ff:
    mike.say "А, Клео..."

# ch/kleio/events.rpy:2821
translate russian kleio_event_10_1a4a87f8:
    mike.say "Да вроде ничем!"

# ch/kleio/events.rpy:2822
translate russian kleio_event_10_5546fa5e:
    kleio.say "Отлично. Тогда приезжай ко мне в одно особенное место."

# ch/kleio/events.rpy:2823
translate russian kleio_event_10_73ac135b:
    mike.say "Это куда?"

# ch/kleio/events.rpy:2824
translate russian kleio_event_10_97b97af6:
    kleio.say "Туда, где было наше первое свидание."

# ch/kleio/events.rpy:2825
translate russian kleio_event_10_3cf84c93:
    kleio.say "Ты ведь помнишь, где это было?"

# ch/kleio/events.rpy:2826
translate russian kleio_event_10_7dd3e30e:
    mike.say "Конечно помню, Клео."

# ch/kleio/events.rpy:2827
translate russian kleio_event_10_16f223ab:
    mike.say "Но почему туда?"

# ch/kleio/events.rpy:2828
translate russian kleio_event_10_3b50aefe:
    kleio.say "Эм... просто так."

# ch/kleio/events.rpy:2829
translate russian kleio_event_10_899c06d3:
    kleio.say "Приезжай как можно скорее, ладно?"

# ch/kleio/events.rpy:2830
translate russian kleio_event_10_6e154b71:
    mike.say "Ладно, ладно..."

# ch/kleio/events.rpy:2831
translate russian kleio_event_10_d05804e8:
    "На этом она заканчивает разговор."

# ch/kleio/events.rpy:2832
translate russian kleio_event_10_01aa9d1b:
    "Я остаюсь в недоумении, но всё равно спешу выполнить её просьбу!"

# ch/kleio/events.rpy:2838
translate russian kleio_event_11_a9fc8666:
    "Думаю, я достаточно давно знаю Клео, чтобы изучить её причуды, и провёл с ней достаточно времени, чтобы запомнить привычки."

# ch/kleio/events.rpy:2839
translate russian kleio_event_11_77e76b40:
    "Поэтому легко замечаю, когда с ней что-то не так и настроение у неё странное."

# ch/kleio/events.rpy:2840
translate russian kleio_event_11_ced7a87a:
    "Сейчас как раз такой случай: она изо всех сил старается вести себя обычно, но сама на себя не похожа."

# ch/kleio/events.rpy:2841
translate russian kleio_event_11_3a42352c:
    "Да, она смеётся над моими шутками и соглашается почти со всем, что я говорю."

# ch/kleio/events.rpy:2842
translate russian kleio_event_11_d0c41023:
    "Но именно это и подсказывает мне, что что-то не так."

# ch/kleio/events.rpy:2843
translate russian kleio_event_11_e89bb773:
    "Знакомая мне Клео никогда не бывает такой покладистой и не спешит соглашаться со мной во всём."

# ch/kleio/events.rpy:2844
translate russian kleio_event_11_ebfbf8b2:
    "Обычно она бы уже успела вставить в разговор с полдюжины колкостей!"

# ch/kleio/events.rpy:2845
translate russian kleio_event_11_06e4e2bd:
    "Почти любую другую девушку я бы прямо спросил, что случилось."

# ch/kleio/events.rpy:2846
translate russian kleio_event_11_e68aee71:
    "Но это Клео, а с ней всё... сложнее."

# ch/kleio/events.rpy:2847
translate russian kleio_event_11_c60561ec:
    "Так что, похоже, придётся зайти с другой стороны."

# ch/kleio/events.rpy:2848
translate russian kleio_event_11_2796a3f1:
    mike.say "Знаешь, что я думаю, Клео?"

# ch/kleio/events.rpy:2850
translate russian kleio_event_11_c2d6fbc7:
    kleio.say "Что, [lssb_kleio.hero_name()]?"

# ch/kleio/events.rpy:2851
translate russian kleio_event_11_f540d0e5:
    mike.say "По-моему, в старых порядках был свой смысл."

# ch/kleio/events.rpy:2852
translate russian kleio_event_11_0c69c849:
    mike.say "Когда мужчины всем заправляли, а женщины сидели дома и вели хозяйство."

# ch/kleio/events.rpy:2853
translate russian kleio_event_11_0e11de99:
    kleio.say "Да, да..."

# ch/kleio/events.rpy:2854
translate russian kleio_event_11_31c5fc5d:
    kleio.say "Понимаю..."

# ch/kleio/events.rpy:2857
translate russian kleio_event_11_0dadb265:
    kleio.say "Погоди... ЧТО?!"

# ch/kleio/events.rpy:2858
translate russian kleio_event_11_c675ca4b:
    "Убедившись, что полностью завладел вниманием Клео, я поднимаю руки в знак капитуляции."

# ch/kleio/events.rpy:2859
translate russian kleio_event_11_d9555b5a:
    mike.say "ШУЧУ!"

# ch/kleio/events.rpy:2860
translate russian kleio_event_11_b1aa0828:
    mike.say "Клео, я просто пошутил, ясно?"

# ch/kleio/events.rpy:2861
translate russian kleio_event_11_c1bc0f70:
    mike.say "Ты витала где-то далеко, вот я и хотел вернуть тебя на землю."

# ch/kleio/events.rpy:2862
translate russian kleio_event_11_8c02992a:
    "Клео сначала недоумевает, потом растерянно смотрит на меня и наконец качает головой."

# ch/kleio/events.rpy:2864
translate russian kleio_event_11_3d612871:
    kleio.say "Да, я знаю..."

# ch/kleio/events.rpy:2865
translate russian kleio_event_11_2694a7c4:
    kleio.say "Прости, [lssb_kleio.hero_name()]."

# ch/kleio/events.rpy:2866
translate russian kleio_event_11_4627dc18:
    kleio.say "Просто давно думаю об одной вещи."

# ch/kleio/events.rpy:2867
translate russian kleio_event_11_5f81a1f7:
    mike.say "Это заметно!"

# ch/kleio/events.rpy:2868
translate russian kleio_event_11_939d2e8e:
    "Клео тяжело, взволнованно вздыхает."

# ch/kleio/events.rpy:2869
translate russian kleio_event_11_08eacfe9:
    kleio.say "Нужно сделать это сейчас."

# ch/kleio/events.rpy:2870
translate russian kleio_event_11_9720bd01:
    kleio.say "Иначе я струшу..."

# ch/kleio/events.rpy:2871
translate russian kleio_event_11_4c2239f5:
    "Теперь уже на моём лице появляется недоумение."

# ch/kleio/events.rpy:2872
translate russian kleio_event_11_7a88c749:
    "Понятия не имею, о чём она."

# ch/kleio/events.rpy:2873
translate russian kleio_event_11_8e4d7a5f:
    "Но тут замечаю, что Клео держит что-то между пальцами."

# ch/kleio/events.rpy:2874
translate russian kleio_event_11_49f700e8:
    "Наверное, достала это, пока я смотрел ей в глаза."

# ch/kleio/events.rpy:2876
translate russian kleio_event_11_051771cd:
    kleio.say "Я... знаю, обычно всё происходит иначе."

# ch/kleio/events.rpy:2877
translate russian kleio_event_11_ac91a4f5:
    kleio.say "И на одно колено я вставать НЕ собираюсь!"

# ch/kleio/events.rpy:2878
translate russian kleio_event_11_d37ec5e5:
    kleio.say "Но, [lssb_kleio.hero_name()]... ты на мне женишься?"

# ch/kleio/events.rpy:2879
translate russian kleio_event_11_60006f57:
    "Только теперь мой взгляд фокусируется на кольце, которое Клео протягивает мне."

# ch/kleio/events.rpy:2880
translate russian kleio_event_11_01b381b7:
    "Я буквально ошеломлён: моргаю и не могу подобрать слов."

# ch/kleio/events.rpy:2883
translate russian kleio_event_11_432285cf:
    "Но когда наконец прихожу в себя, первым делом разражаюсь смехом."

# ch/kleio/events.rpy:2885
translate russian kleio_event_11_0adf508b:
    "Лицо Клео тут же искажается от досады."

# ch/kleio/events.rpy:2888
translate russian kleio_event_11_ebcffbf9:
    kleio.say "Эй, придурок!"

# ch/kleio/events.rpy:2890
translate russian kleio_event_11_d1b24cfe:
    kleio.say "Что смешного?!"

# ch/kleio/events.rpy:2891
translate russian kleio_event_11_47229aee:
    kleio.say "Я тут душу тебе открываю!"

# ch/kleio/events.rpy:2892
translate russian kleio_event_11_c8dd0626:
    "Я качаю головой, кое-как справившись со смехом."

# ch/kleio/events.rpy:2893
translate russian kleio_event_11_2fc319fb:
    mike.say "Нет, Клео, нет..."

# ch/kleio/events.rpy:2894
translate russian kleio_event_11_4e2ec987:
    mike.say "Я не над тобой смеюсь."

# ch/kleio/events.rpy:2895
translate russian kleio_event_11_d84bc89a:
    mike.say "Просто мне это ужасно нравится!"

# ch/kleio/events.rpy:2897
translate russian kleio_event_11_63de83c2:
    "Теперь Клео смотрит на меня озадаченно."

# ch/kleio/events.rpy:2898
translate russian kleio_event_11_23b92ce7:
    kleio.say "П... правда?"

# ch/kleio/events.rpy:2900
translate russian kleio_event_11_c49fb50c:
    mike.say "Это так похоже на тебя, Клео."

# ch/kleio/events.rpy:2901
translate russian kleio_event_11_7966c3f1:
    mike.say "В этом вся ты."

# ch/kleio/events.rpy:2902
translate russian kleio_event_11_0c4c7cb6:
    mike.say "Никто другой не смог бы сделать ничего подобного."

# ch/kleio/events.rpy:2903
translate russian kleio_event_11_c8a12fa1:
    mike.say "За это я и люблю такие моменты. И тебя."

# ch/kleio/events.rpy:2905
translate russian kleio_event_11_769fb583:
    "Клео краснеет и оглядывается, опасаясь, что меня услышат."

# ch/kleio/events.rpy:2906
translate russian kleio_event_11_fe060c1e:
    kleio.say "Замолчи, [lssb_kleio.hero_name()], ты меня смущаешь!"

# ch/kleio/events.rpy:2907
translate russian kleio_event_11_20a9c549:
    "Теперь уже поздновато."

# ch/kleio/events.rpy:2908
translate russian kleio_event_11_d844d1a6:
    "И если Клео не хочет вставать на одно колено, то встану я."

# ch/kleio/events.rpy:2909
translate russian kleio_event_11_5959e611:
    "Я опускаюсь перед ней на колено и беру её за руку, сжимающую кольцо."

# ch/kleio/events.rpy:2910
translate russian kleio_event_11_4c498ec7:
    mike.say "Да, Клео."

# ch/kleio/events.rpy:2911
translate russian kleio_event_11_b439138d:
    mike.say "Я женюсь на тебе."

# ch/kleio/events.rpy:2912
translate russian kleio_event_11_3f2e9e49:
    mike.say "Только обещай всегда оставаться собой, ладно?"

# ch/kleio/events.rpy:2914
translate russian kleio_event_11_81e84f04:
    "Клео едва ли не силой поднимает меня на ноги, отчаянно стараясь не привлекать внимания."

# ch/kleio/events.rpy:2915
translate russian kleio_event_11_f4747fd2:
    "Но в этой возне я крепко обнимаю её."

# ch/kleio/events.rpy:2916
translate russian kleio_event_11_9953c1c3:
    "Она обнимает меня в ответ, и я чувствую, как кольцо скользит мне на палец."

# ch/kleio/events.rpy:2917
translate russian kleio_event_11_f1481f39:
    kleio.say "Всё, сердцеед, ты попался."

# ch/kleio/events.rpy:2918
translate russian kleio_event_11_38ad8fad:
    kleio.say "Теперь от меня не отделаешься!"

# ch/kleio/events.rpy:2919
translate russian kleio_event_11_91558cf0:
    mike.say "И не собираюсь..."

# ch/kleio/events.rpy:2923
translate russian kleio_event_11_7fcc58f0:
    "Через мгновение мы сливаемся в долгом, глубоком и страстном поцелуе."

# ch/kleio/events.rpy:2924
translate russian kleio_event_11_ec6aa61f:
    "Я знаю, что впереди у нас целая жизнь."

# ch/kleio/events.rpy:2925
translate russian kleio_event_11_7a7c6644:
    "Но всё равно не хочу, чтобы этот поцелуй заканчивался."

# ch/kleio/events.rpy:2928
translate russian kleio_event_11_ba7f7e02:
    mike.say "Ух ты..."

# ch/kleio/events.rpy:2929
translate russian kleio_event_11_83ec80eb:
    mike.say "Чего только я себе не представлял, Клео!"

# ch/kleio/events.rpy:2930
translate russian kleio_event_11_b21ab8ee:
    mike.say "Но что ты сделаешь мне предложение — никогда."

# ch/kleio/events.rpy:2932
translate russian kleio_event_11_add96604:
    "В глазах Клео тут же мелькает сомнение."

# ch/kleio/events.rpy:2933
translate russian kleio_event_11_b494cef6:
    "Она торопливо прячет кольцо в карман и качает головой."

# ch/kleio/events.rpy:2935
translate russian kleio_event_11_c08059e6:
    kleio.say "Не похоже, что ты собираешься сказать «да»..."

# ch/kleio/events.rpy:2936
translate russian kleio_event_11_c16bdb0a:
    "Я качаю головой и грустно улыбаюсь."

# ch/kleio/events.rpy:2937
translate russian kleio_event_11_a713a6e8:
    mike.say "Это очень современно с твоей стороны, Клео."

# ch/kleio/events.rpy:2938
translate russian kleio_event_11_7dd73bbf:
    mike.say "Но сейчас я просто к этому не готов."

# ch/kleio/events.rpy:2939
translate russian kleio_event_11_a3261fca:
    mike.say "Может быть, когда-нибудь, но не сейчас."

# ch/kleio/events.rpy:2941
translate russian kleio_event_11_455c549b:
    kleio.say "А... ладно... ладно..."

# ch/kleio/events.rpy:2942
translate russian kleio_event_11_d9f0d3a8:
    kleio.say "Наверное, это с самого начала было глупой идеей."

# ch/kleio/events.rpy:2943
translate russian kleio_event_11_6d753969:
    "Я думаю, не сказать ли ещё что-нибудь, чтобы её успокоить."

# ch/kleio/events.rpy:2944
translate russian kleio_event_11_7ad9a9d5:
    "Но вижу, что она уже старается выбросить всё это из головы."

# ch/kleio/events.rpy:2945
translate russian kleio_event_11_e297f408:
    "Разговор сейчас приведёт только к ссоре."

# ch/kleio/events.rpy:2946
translate russian kleio_event_11_d43a84aa:
    "Поэтому я больше не поднимаю эту тему."

# ch/kleio/events.rpy:2947
translate russian kleio_event_11_d14ce785:
    "Остаётся надеяться, что я не слишком сильно ранил Клео."

# ch/kleio/events.rpy:2966
translate russian kleio_male_ending_221b3eaa:
    "Не знаю, задумывался ли я когда-нибудь всерьёз о том, как будет выглядеть день моей свадьбы."

# ch/kleio/events.rpy:2967
translate russian kleio_male_ending_ae73f7e4:
    "Знаю, это старый затёртый стереотип, но я мужчина и никогда особенно об этом не думал."

# ch/kleio/events.rpy:2968
translate russian kleio_male_ending_1062325e:
    "Однако, даже если бы и думал, вряд ли представил бы себе что-то хоть отдалённо похожее."

# ch/kleio/events.rpy:2969
translate russian kleio_male_ending_5bbd06b1:
    "Сейчас я стою на асфальте посреди пустыря на окраине города."

# ch/kleio/events.rpy:2970
translate russian kleio_male_ending_eab85623:
    "И понятия, блядь, не имею, можно ли нам вообще здесь находиться."

# ch/kleio/events.rpy:2971
translate russian kleio_male_ending_2e8edd0f:
    "Так что, возможно, мы сейчас нарушаем закон."

# ch/kleio/events.rpy:2972
translate russian kleio_male_ending_90e4e7a2:
    "Но, к счастью, я не один."

# ch/kleio/events.rpy:2973
translate russian kleio_male_ending_be92a634:
    "Вокруг меня десятки машин и больше сотни людей."

# ch/kleio/events.rpy:2974
translate russian kleio_male_ending_dd5156e7:
    "В воздухе висит выхлопной дым, а моторы нетерпеливо ревут."

# ch/kleio/events.rpy:2975
translate russian kleio_male_ending_de97523e:
    "И все собравшиеся — панки, байкеры, рокабилли или кто-то на стыке этих компаний."

# ch/kleio/events.rpy:2976
translate russian kleio_male_ending_00772542:
    "Событие, безусловно, совершенно особенное."

# ch/kleio/events.rpy:2977
translate russian kleio_male_ending_7430d28e:
    "Но и женюсь я на не менее особенной девушке."

# ch/kleio/events.rpy:2978
translate russian kleio_male_ending_2d90976d:
    "С этой мыслью я поворачиваюсь к стоящей рядом Клео."

# ch/kleio/events.rpy:2980
translate russian kleio_male_ending_cb21abbd:
    "А она уже смотрит на меня снизу вверх со знакомой лукавой улыбкой."

# ch/kleio/events.rpy:2981
translate russian kleio_male_ending_7623f190:
    "Когда-то её чертовская дерзость, возможно, ужасно меня раздражала."

# ch/kleio/events.rpy:2982
translate russian kleio_male_ending_230b6610:
    "Но за недели и месяцы, пока мы узнавали друг друга, это чувство исчезло без следа."

# ch/kleio/events.rpy:2983
translate russian kleio_male_ending_3753e54f:
    "Теперь эта улыбка означает лишь, что любимая девушка сейчас скажет что-нибудь остроумное и рассмешит меня."

# ch/kleio/events.rpy:2984
translate russian kleio_male_ending_8b346d95:
    "Как ни трудно поверить, я по-настоящему обожаю острый язычок Клео."

# ch/kleio/events.rpy:2985
translate russian kleio_male_ending_f75218c2:
    "Раньше я видел колючесть и высокомерие, а теперь вижу только её страсть и ум."

# ch/kleio/events.rpy:2986
translate russian kleio_male_ending_e1d7f17c:
    "И то, что сейчас она выглядит чертовски сексуально, тоже не мешает!"

# ch/kleio/events.rpy:2987
translate russian kleio_male_ending_17c09431:
    "Отвергнув всё хоть сколько-нибудь традиционное, Клео надела лишь шорты и крохотный топ."

# ch/kleio/events.rpy:2988
translate russian kleio_male_ending_8c4c5eef:
    "Но вместо привычного чёрного или других тёмных цветов сегодня выбрала белый."

# ch/kleio/events.rpy:2990
translate russian kleio_male_ending_76de4332:
    "Он отлично подчёркивает татуировки и пирсинг на её стройном подтянутом теле."

# ch/kleio/events.rpy:2991
translate russian kleio_male_ending_67a7cd51:
    "И я помню, как не раз целовал каждую из этих татуировок и каждый прокол."

# ch/kleio/events.rpy:2993
translate russian kleio_male_ending_5a78dd30:
    "Он отлично подчёркивает её всё более округляющийся живот."

# ch/kleio/events.rpy:2994
translate russian kleio_male_ending_92e87e30:
    "Мы оба только гордимся тем, что скоро станем родителями."

# ch/kleio/events.rpy:2995
translate russian kleio_male_ending_8aaba7dc:
    "По сути, всё это — отличный повод показать средний палец тем, кто нас терпеть не может."

# ch/kleio/events.rpy:2996
translate russian kleio_male_ending_57536d71:
    "Свадьба посреди автомобильного хаоса — тоже её идея."

# ch/kleio/events.rpy:2997
translate russian kleio_male_ending_5bd2fc41:
    "Вокруг друзья и знакомые, которых она приобрела за время работы механиком."

# ch/kleio/events.rpy:2998
translate russian kleio_male_ending_094662a0:
    "С ними всё больше похоже на шумную гулянку, чем на свадьбу."

# ch/kleio/events.rpy:2999
translate russian kleio_male_ending_371207be:
    "Лично мне плевать, как это выглядит со стороны."

# ch/kleio/events.rpy:3001
translate russian kleio_male_ending_4b0ebea6:
    "Клео счастлива."

# ch/kleio/events.rpy:3002
translate russian kleio_male_ending_d676a804:
    "А если счастлива она, счастлив и я."

# ch/kleio/events.rpy:3003
translate russian kleio_male_ending_f04abd3d:
    "Байкер" "Возлюбленные братья и сёстры..."

# ch/kleio/events.rpy:3004
translate russian kleio_male_ending_0385cfbe:
    "Байкер" "Я СКАЗАЛ: ВОЗЛЮБЛЕННЫЕ БРАТЬЯ И СЁСТРЫ!!!"

# ch/kleio/events.rpy:3005
translate russian kleio_male_ending_3f4d9f8b:
    "Шум не стихает полностью, но становится заметно тише."

# ch/kleio/events.rpy:3006
translate russian kleio_male_ending_f98571f6:
    "Все взгляды обращаются к источнику этого рёва в ожидании продолжения."

# ch/kleio/events.rpy:3007
translate russian kleio_male_ending_e558c008:
    "Нам с Клео досталось больше всех: крикнувший мужчина стоит прямо перед нами."

# ch/kleio/events.rpy:3008
translate russian kleio_male_ending_cbae7937:
    "Огромный байкер с длинной седой бородой и волосами, скрывающий глаза за тёмными очками."

# ch/kleio/events.rpy:3009
translate russian kleio_male_ending_f8e6726e:
    "Помимо внушительного вида, его выделяет из толпы Библия, зажатая в одной из громадных лап."

# ch/kleio/events.rpy:3010
translate russian kleio_male_ending_f9b475f5:
    "Имя его вылетело у меня из головы: сегодня меня познакомили уже с уймой байкеров."

# ch/kleio/events.rpy:3012
translate russian kleio_male_ending_a112ec9e:
    "Но Клео выбрала его потому, что когда-то он был священником."

# ch/kleio/events.rpy:3013
translate russian kleio_male_ending_fd68a854:
    "Пока после какого-то загадочного происшествия не оставил церковь."

# ch/kleio/events.rpy:3014
translate russian kleio_male_ending_82e74501:
    "Я не решился спросить, что случилось: если честно, он меня пугает."

# ch/kleio/events.rpy:3015
translate russian kleio_male_ending_42d9ab53:
    "А его почти отеческая забота о благополучии Клео только усиливает это чувство."

# ch/kleio/events.rpy:3016
translate russian kleio_male_ending_1c830a84:
    "Байкер" "Благодарю..."

# ch/kleio/events.rpy:3017
translate russian kleio_male_ending_8363489f:
    "Байкер" "Так, на чём я остановился..."

# ch/kleio/events.rpy:3018
translate russian kleio_male_ending_1f8e9375:
    "Байкер" "Мы собрались здесь сегодня, чтобы соединить нашу дорогую малышку Клео..."

# ch/kleio/events.rpy:3019
translate russian kleio_male_ending_427cfef7:
    "Байкер" "И... так-так... [lssb_kleio.hero_name()]..."

# ch/kleio/events.rpy:3020
translate russian kleio_male_ending_2fa3555a:
    "Байкер" "Соединить их священными узами брака."

# ch/kleio/events.rpy:3021
translate russian kleio_male_ending_3debb36e:
    "Все свадьбы, на которых я бывал, были довольно долгими: чтения, стихи и, конечно, обмен клятвами."

# ch/kleio/events.rpy:3022
translate russian kleio_male_ending_8e19a7e2:
    "Поэтому то, что следует за этими короткими вступительными словами, совершенно застаёт меня врасплох."

# ch/kleio/events.rpy:3023
translate russian kleio_male_ending_8c685c5c:
    "Байкер" "Итак, Клео, согласна ли ты вступить в законный брак с [lssb_kleio.hero_name()]?"

# ch/kleio/events.rpy:3024
translate russian kleio_male_ending_8cb55cb5:
    "Если Клео и удивлена такой сокращённой церемонией, то не подаёт виду."

# ch/kleio/events.rpy:3025
translate russian kleio_male_ending_bd927cc6:
    "Она радостно кивает и отвечает без малейшего колебания."

# ch/kleio/events.rpy:3027
translate russian kleio_male_ending_28c5c964:
    kleio.say "Ещё бы, чёрт возьми!"

# ch/kleio/events.rpy:3028
translate russian kleio_male_ending_6c88ab10:
    "Мгновение байкер смотрит на неё так, словно надеялся на совсем другой ответ."

# ch/kleio/events.rpy:3030
translate russian kleio_male_ending_ecf9c212:
    "Но затем будто стряхивает с себя это чувство и вспоминает, чем занят."

# ch/kleio/events.rpy:3031
translate russian kleio_male_ending_ba71624b:
    "Байкер" "А ты что скажешь, приятель?"

# ch/kleio/events.rpy:3032
translate russian kleio_male_ending_10b433d9:
    "Байкер" "Берёшь ли ты Клео в законные жёны?"

# ch/kleio/events.rpy:3033
translate russian kleio_male_ending_4925f4f9:
    "Я открываю рот, чтобы согласиться, но он не даёт вставить слово и продолжает грохотать."

# ch/kleio/events.rpy:3034
translate russian kleio_male_ending_acd455a4:
    "Байкер" "Обещаешь любить, почитать и слушаться её?"

# ch/kleio/events.rpy:3035
translate russian kleio_male_ending_8f7a55b7:
    "Байкер" "И, отказавшись от всех остальных, хранить ей верность, пока твоя задница жива?"

# ch/kleio/events.rpy:3036
translate russian kleio_male_ending_6c286eee:
    "Минутку, Клео-то нужно было всего лишь сказать «да»."

# ch/kleio/events.rpy:3037
translate russian kleio_male_ending_59e3aeb6:
    "А я тут словно на допросе у испанской инквизиции!"

# ch/kleio/events.rpy:3038
translate russian kleio_male_ending_9d105c21:
    mike.say "Да..."

# ch/kleio/events.rpy:3039
translate russian kleio_male_ending_dbc3b4a9:
    mike.say "Обещаю..."

# ch/kleio/events.rpy:3040
translate russian kleio_male_ending_a4462a25:
    mike.say "Ну всё, теперь вы довольны?!"

# ch/kleio/events.rpy:3042
translate russian kleio_male_ending_f5608af7:
    "Байкер кивает, хотя по лицу видно: всё ещё не вполне мне доверяет."

# ch/kleio/events.rpy:3043
translate russian kleio_male_ending_ee5ba096:
    "Байкер" "Тогда объявляю вас женой и мужем."

# ch/kleio/events.rpy:3044
translate russian kleio_male_ending_1a7230a1:
    "Байкер" "Полагаю, можешь поцеловать эту прекрасную женщину!"

# ch/kleio/events.rpy:3045
translate russian kleio_male_ending_178488f0:
    "Кажется, допрос наконец окончен, и всё моё тело наполняется облегчением."

# ch/kleio/events.rpy:3046
translate russian kleio_male_ending_64ce3997:
    "А когда Клео обвивает руками мою шею и притягивает меня к себе, чтобы заглянуть в глаза, становится ещё лучше."

# ch/kleio/events.rpy:3051
translate russian kleio_male_ending_e8585936:
    "Она не спрашивает разрешения, а просто прижимается губами к моим."

# ch/kleio/events.rpy:3052
translate russian kleio_male_ending_6ee5fb4b:
    "Я отвечаю с такой же страстью, забыв обо всех вокруг."

# ch/kleio/events.rpy:3053
translate russian kleio_male_ending_53b9403d:
    "И это совсем не традиционный целомудренный свадебный поцелуй."

# ch/kleio/events.rpy:3054
translate russian kleio_male_ending_7a0675d5:
    "С языками, вполне слышными звуковыми эффектами и гораздо дольше, чем позволяют приличия."

# ch/kleio/events.rpy:3055
translate russian kleio_male_ending_4c77e034:
    "Но толпа, кажется, всё это одобряет."

# ch/kleio/events.rpy:3056
translate russian kleio_male_ending_a28fa98f:
    "Люди кричат, газуют и сигналят так, что мёртвого поднимут."

# ch/kleio/events.rpy:3058
translate russian kleio_male_ending_78a81a3f:
    "Клео прерывает поцелуй, морщится от этой какофонии, но всё равно улыбается."

# ch/kleio/events.rpy:3059
translate russian kleio_male_ending_11b0793c:
    kleio.say "Поздно теперь убегать, сердцеед."

# ch/kleio/events.rpy:3061
translate russian kleio_male_ending_f8dd1f4a:
    kleio.say "Ты мой, и все эти ребята — свидетели."

# ch/kleio/events.rpy:3062
translate russian kleio_male_ending_e34ba22e:
    kleio.say "Так что будь со мной поласковее, иначе они тебя из-под земли достанут!"

# ch/kleio/events.rpy:3064
translate russian kleio_male_ending_40fa4493:
    mike.say "Не волнуйся об этом, Клео."

# ch/kleio/events.rpy:3065
translate russian kleio_male_ending_336ee54c:
    mike.say "Ни один из них и мечтать не может быть хотя бы вполовину таким страшным, как ты!"

# ch/kleio/events.rpy:3068
translate russian kleio_male_ending_a38ef411:
    kleio.say "Ой, как мило сказано!"

# ch/kleio/events.rpy:3069
translate russian kleio_male_ending_7f0474e4:
    kleio.say "Люблю тебя, сердцеед."

# ch/kleio/events.rpy:3070
translate russian kleio_male_ending_b55b3dfb:
    mike.say "И я тебя люблю, Клео."

# ch/kleio/events.rpy:3074
translate russian kleio_male_ending_7a6c9191:
    kleio.say "Ладно, хватит уже этому здоровому недотёпе говорить за меня!"

# ch/kleio/events.rpy:3076
translate russian kleio_male_ending_ccaf315d:
    kleio.say "Не могла же я позволить ему поставить последнюю точку в нашей истории."

# ch/kleio/events.rpy:3077
translate russian kleio_male_ending_25ebdf43:
    kleio.say "И наверняка он ещё и рассказал всё до ужаса уныло!"

# ch/kleio/events.rpy:3078
translate russian kleio_male_ending_7c0b4a3a:
    kleio.say "Ну не способен он толком объяснить, насколько я сексуальная и дерзкая."

# ch/kleio/events.rpy:3080
translate russian kleio_male_ending_5e7ea389:
    kleio.say "Бедный мой сердцеед!"

# ch/kleio/events.rpy:3082
translate russian kleio_male_ending_b620d339:
    kleio.say "Вообще-то я его люблю."

# ch/kleio/events.rpy:3084
translate russian kleio_male_ending_94250f90:
    kleio.say "Наверное, теперь вы ждёте рассказа о том, как поначалу [lssb_kleio.hero_name()] был мне ненавистен?"

# ch/kleio/events.rpy:3085
translate russian kleio_male_ending_98ace87e:
    kleio.say "Но потом стал нравиться всё больше, и я поняла, что на самом деле влюблена, да?"

# ch/kleio/events.rpy:3087
translate russian kleio_male_ending_91133f48:
    kleio.say "А вот забудьте!"

# ch/kleio/events.rpy:3088
translate russian kleio_male_ending_0c20567a:
    kleio.say "За кого вы меня принимаете?"

# ch/kleio/events.rpy:3089
translate russian kleio_male_ending_ba07b863:
    kleio.say "За какую-то предсказуемую цундэрэ из манги, над которой вы пускаете слюни?"

# ch/kleio/events.rpy:3091
translate russian kleio_male_ending_e648b172:
    kleio.say "Во мне ГОРАЗДО больше всего!"

# ch/kleio/events.rpy:3092
translate russian kleio_male_ending_8b041e08:
    kleio.say "Хотя да, возможно, поначалу [lssb_kleio.hero_name()] казался мне довольно жалким."

# ch/kleio/events.rpy:3093
translate russian kleio_male_ending_36a3dbe5:
    kleio.say "Но разве меня можно винить?"

# ch/kleio/events.rpy:3094
translate russian kleio_male_ending_b3771bfa:
    kleio.say "С виду — очередной тупой хрен, которого Саша навязала группе."

# ch/kleio/events.rpy:3095
translate russian kleio_male_ending_f75d6960:
    kleio.say "Обычно такие очень быстро понимали, что на меня впечатления не произвели."

# ch/kleio/events.rpy:3096
translate russian kleio_male_ending_7d4eaf3b:
    kleio.say "Но только не сердцеед. Нет уж."

# ch/kleio/events.rpy:3097
translate russian kleio_male_ending_7ab7a885:
    kleio.say "Чем злее я с ним обходилась, тем упорнее он держался рядом."

# ch/kleio/events.rpy:3099
translate russian kleio_male_ending_88788466:
    kleio.say "Сначала я решила, что он обычный, самый заурядный парень."

# ch/kleio/events.rpy:3100
translate russian kleio_male_ending_e8eb5524:
    kleio.say "Ну, то есть дебил."

# ch/kleio/events.rpy:3102
translate russian kleio_male_ending_2ea90cc1:
    kleio.say "Но потом он вдруг делал или говорил что-нибудь довольно умное."

# ch/kleio/events.rpy:3103
translate russian kleio_male_ending_26e8b5b1:
    kleio.say "Конечно, не по-женски умное, понимаете?"

# ch/kleio/events.rpy:3104
translate russian kleio_male_ending_f6ea8383:
    kleio.say "А по-мужски. Ну, как собака, которая выучила классный трюк."

# ch/kleio/events.rpy:3105
translate russian kleio_male_ending_6ea80dbf:
    kleio.say "В общем, он как-то начал мне нравиться."

# ch/kleio/events.rpy:3106
translate russian kleio_male_ending_5599b6f9:
    kleio.say "Тоже вроде собаки..."

# ch/kleio/events.rpy:3107
translate russian kleio_male_ending_420249a4:
    kleio.say "Но если серьёзно, мне трудно говорить о таких вещах."

# ch/kleio/events.rpy:3108
translate russian kleio_male_ending_dd87b840:
    kleio.say "И вот за это я тоже ценю [lssb_kleio.hero_name()]."

# ch/kleio/events.rpy:3109
translate russian kleio_male_ending_2f2dc1aa:
    kleio.say "Он ни разу не ругал меня за то, какая я есть, и не просил измениться."

# ch/kleio/events.rpy:3110
translate russian kleio_male_ending_7721799c:
    kleio.say "Будто... будто все хотят видеть во мне кого-то другого."

# ch/kleio/events.rpy:3111
translate russian kleio_male_ending_7e83d962:
    kleio.say "А ему я нравлюсь именно такой, какая есть, понимаете?"

# ch/kleio/events.rpy:3112
translate russian kleio_male_ending_27e5419b:
    kleio.say "Фу, развела тут сопли и сантименты, как Анна с Сашей!"

# ch/kleio/events.rpy:3113
translate russian kleio_male_ending_67c41bdc:
    kleio.say "Но когда говорю о сердцееде, со мной так и случается."

# ch/kleio/events.rpy:3116
translate russian kleio_male_ending_f18b1987:
    kleio.say "Кажется, я и правда его люблю..."

# ch/kleio/events.rpy:3117
translate russian kleio_male_ending_de58cb1f:
    kleio.say "Ладно..."

# ch/kleio/events.rpy:3122
translate russian kleio_male_ending_20e0902c:
    kleio.say "После свадьбы у нас не было времени ни думать, ни планировать, ни на что вообще."

# ch/kleio/events.rpy:3123
translate russian kleio_male_ending_850e8985:
    kleio.say "Мы, Deathless Harpies, сейчас в самом разгаре первого тура, где выступаем главной группой."

# ch/kleio/events.rpy:3124
translate russian kleio_male_ending_e4b01026:
    kleio.say "Да, пока только клубы и всякая хрень, но это наш тур, и мы там, блядь, зажигаем."

# ch/kleio/events.rpy:3125
translate russian kleio_male_ending_c65d45b4:
    kleio.say "И пока он отвлекает от мыслей о том, что ждёт нас по возвращении в реальность."

# ch/kleio/events.rpy:3127
translate russian kleio_male_ending_9f5f3549:
    kleio.say "С каждым вечером мне всё труднее играть на гитаре."

# ch/kleio/events.rpy:3128
translate russian kleio_male_ending_74e2ffc1:
    kleio.say "И домой мы, возможно, вернёмся уже с новой участницей группы."

# ch/kleio/events.rpy:3129
translate russian kleio_male_ending_52e50c0c:
    kleio.say "Это будет девочка. Мы решили назвать её Кортни."

# ch/kleio/events.rpy:3130
translate russian kleio_male_ending_dfac6749:
    kleio.say "Каждый раз, когда заходит речь, сердцеед чуть не обсирается."

# ch/kleio/events.rpy:3131
translate russian kleio_male_ending_8c27ad41:
    kleio.say "Но мы договорились, что после возвращения съедемся."

# ch/kleio/events.rpy:3133
translate russian kleio_male_ending_52210c71:
    kleio.say "Может, он переедет ко мне, а может, наоборот."

# ch/kleio/events.rpy:3134
translate russian kleio_male_ending_01f2a45a:
    kleio.say "Хотя ПОНЯТИЯ НЕ ИМЕЮ, как Саша отнесётся к такой соседке, как я!"

# ch/kleio/events.rpy:3135
translate russian kleio_male_ending_3bac892f:
    kleio.say "Так что, возможно, найдём своё жильё."

# ch/kleio/events.rpy:3136
translate russian kleio_male_ending_1060dfe5:
    kleio.say "Да хрен с ним, может, станем звёздами и въедем в грёбаный особняк!"

# ch/kleio/events.rpy:3137
translate russian kleio_male_ending_e019907f:
    kleio.say "В любом случае знаю одно: хочу, чтобы [lssb_kleio.hero_name()] был как можно ближе..."

# ch/kleio/events.rpy:3138
translate russian kleio_male_ending_0e0d4cd9:
    kleio.say "ЧТО?!"

# ch/kleio/events.rpy:3139
translate russian kleio_male_ending_e0d286f0:
    kleio.say "Нет, я не становлюсь мягкотелой!"

# ch/kleio/events.rpy:3140
translate russian kleio_male_ending_85f32075:
    kleio.say "Господи..."

# ch/kleio/events.rpy:3141
translate russian kleio_male_ending_29b1c3dd:
    kleio.say "Вот что бывает, когда пытаешься открыться и честно рассказать о чувствах."

# ch/kleio/events.rpy:3142
translate russian kleio_male_ending_4af4efb6:
    kleio.say "Каждый встречный со своей грёбаной бабушкой заявляет, что в душе ты нежная размазня!"

# ch/kleio/events.rpy:3143
translate russian kleio_male_ending_3d51fd60:
    kleio.say "Ничего подобного..."

# ch/kleio/events.rpy:3144
translate russian kleio_male_ending_2aa74f6b:
    kleio.say "Хотя... может быть, с сердцеедом!"

# ch/kleio/events.rpy:3145
translate russian kleio_male_ending_ba0b6cee:
    kleio.say "Вот и всё."

# ch/kleio/events.rpy:3146
translate russian kleio_male_ending_3c2bf423:
    kleio.say "Я люблю его, он любит меня, и сейчас мы до отвращения счастливы."

# ch/kleio/events.rpy:3147
translate russian kleio_male_ending_5c1ad1d2:
    kleio.say "Чего вам ещё от меня надо, крови?"

# ch/kleio/events.rpy:3148
translate russian kleio_male_ending_a75c7dea:
    kleio.say "По крайней мере, я знаю, чего хочу: [lssb_kleio.hero_name()]."

# ch/kleio/events.rpy:3149
translate russian kleio_male_ending_ad26eb1c:
    kleio.say "Не знаю, что принесёт завтра и где мы будем через десять лет."

# ch/kleio/events.rpy:3150
translate russian kleio_male_ending_181a0b91:
    kleio.say "По мне, надо хватать жизнь обеими руками и крепче держаться на виражах."

# ch/kleio/events.rpy:3151
translate russian kleio_male_ending_5eee11ea:
    kleio.say "Именно это я и собираюсь делать."

# ch/kleio/events.rpy:3152
translate russian kleio_male_ending_82fe2b82:
    kleio.say "Теперь [lssb_kleio.hero_name()] от меня не отделается, хочет он того или нет!"

# ch/kleio/events.rpy:3153
translate russian kleio_male_ending_7746f19d:
    kleio.say "Потому что я люблю этого здорового придурка. И точка."

# ch/kleio/events.rpy:3154
translate russian kleio_male_ending_f0ab62a1:
    kleio.say "Пока, неудачники!"

# ch/kleio/events.rpy:3155
translate russian kleio_male_ending_cf8bcad4:
    kleio.say "Может, будете видеть нас каждый день, а может, больше никогда."

# ch/kleio/events.rpy:3156
translate russian kleio_male_ending_fc2c5c20:
    kleio.say "Но забыть нас у вас вряд ли получится!"

# ch/kleio/events.rpy:3168
translate russian kleio_event_talk_murder_e96daeb0:
    "Клео неожиданно обвивает руками мою шею и крепко обнимает."

# ch/kleio/events.rpy:3169
translate russian kleio_event_talk_murder_5e61a456:
    "Мне нужна секунда, чтобы опомниться и обнять её в ответ."

# ch/kleio/events.rpy:3170
translate russian kleio_event_talk_murder_6e3ad8e0:
    "И я чувствую, как напряжение и тревога отступают."

# ch/kleio/events.rpy:3171
translate russian kleio_event_talk_murder_cd89b6e4:
    "Но вина упрямо остаётся."

# ch/kleio/events.rpy:3172
translate russian kleio_event_talk_murder_08b0678a:
    "Наконец Клео размыкает объятия и смотрит на меня снизу вверх."

# ch/kleio/events.rpy:3173
translate russian kleio_event_talk_murder_2931d8c3:
    "Я вижу слёзы у неё в глазах."

# ch/kleio/events.rpy:3174
translate russian kleio_event_talk_murder_a9e95a00:
    kleio.say "Блядь, чувак, хуже этого вообще ничего не придумаешь!"

# ch/kleio/events.rpy:3175
translate russian kleio_event_talk_murder_d60bef3e:
    mike.say "Я... знаю, да..."

# ch/kleio/events.rpy:3176
translate russian kleio_event_talk_murder_552b6b69:
    mike.say "Слушай, Клео..."

# ch/kleio/events.rpy:3177
translate russian kleio_event_talk_murder_8fd55efc:
    mike.say "Я пойму, если ты на меня злишься..."

# ch/kleio/events.rpy:3178
translate russian kleio_event_talk_murder_77e9b8ad:
    "Клео смотрит так, словно не понимает."

# ch/kleio/events.rpy:3179
translate russian kleio_event_talk_murder_960f9506:
    "Потом до неё доходит, и она качает головой."

# ch/kleio/events.rpy:3180
translate russian kleio_event_talk_murder_8a25b6fa:
    kleio.say "Да ни хрена!"

# ch/kleio/events.rpy:3181
translate russian kleio_event_talk_murder_8d51dc59:
    kleio.say "Не вини себя, чувак!"

# ch/kleio/events.rpy:3182
translate russian kleio_event_talk_murder_c8e891af:
    kleio.say "Ты никак не мог знать!"

# ch/kleio/events.rpy:3184
translate russian kleio_event_talk_murder_c91e0534:
    kleio.say "И на тебя она тоже напала."

# ch/kleio/events.rpy:3185
translate russian kleio_event_talk_murder_03b0f279:
    kleio.say "Это недопустимо, даже если она женщина, а ты мужчина."

# ch/kleio/events.rpy:3186
translate russian kleio_event_talk_murder_8a21c109:
    kleio.say "Ты не должен чувствовать себя виноватым."

# ch/kleio/events.rpy:3188
translate russian kleio_event_talk_murder_36b6fce3:
    kleio.say "Слушай, мы все через такое проходили."

# ch/kleio/events.rpy:3189
translate russian kleio_event_talk_murder_7ebac52c:
    kleio.say "Все совали свой метафорический член в какую-нибудь психопатку!"

# ch/kleio/events.rpy:3190
translate russian kleio_event_talk_murder_52efa327:
    kleio.say "Когда кто-то тебе нравится, тревожных звоночков не замечаешь."

# ch/kleio/events.rpy:3191
translate russian kleio_event_talk_murder_2ba4d41c:
    "От кого-кого, а от Клео я не ожидал такого услышать."

# ch/kleio/events.rpy:3192
translate russian kleio_event_talk_murder_7f080be8:
    "Да, подано это в её обычной резкой манере."

# ch/kleio/events.rpy:3193
translate russian kleio_event_talk_murder_f2b0f1e0:
    "Но в её голосе звучит неподдельное чувство."

# ch/kleio/events.rpy:3194
translate russian kleio_event_talk_murder_82d71d91:
    "И взгляд совершенно искренний."

# ch/kleio/events.rpy:3195
translate russian kleio_event_talk_murder_454b0b67:
    mike.say "Всё думаю, что должен был что-нибудь сделать, Клео!"

# ch/kleio/events.rpy:3196
translate russian kleio_event_talk_murder_0d20eae3:
    mike.say "Быть умнее или сильнее сопротивляться."

# ch/kleio/events.rpy:3198
translate russian kleio_event_talk_murder_0a874ba6:
    kleio.say "Нет, не мог."

# ch/kleio/events.rpy:3199
translate russian kleio_event_talk_murder_a198ea5a:
    kleio.say "И хорошим человеком ты от этого быть не перестал."

# ch/kleio/events.rpy:3200
translate russian kleio_event_talk_murder_e254e7ea:
    kleio.say "Иначе Саша не бросилась бы тебе на помощь."

# ch/kleio/events.rpy:3201
translate russian kleio_event_talk_murder_ae884b45:
    kleio.say "Уж она-то мудака за километр чуяла!"

# ch/kleio/events.rpy:3202
translate russian kleio_event_talk_murder_454c836b:
    "От такого описания Саши я невольно смеюсь."

# ch/kleio/events.rpy:3204
translate russian kleio_event_talk_murder_dfe72ccb:
    "Через мгновение Клео присоединяется, и мы смеёмся вместе."

# ch/kleio/events.rpy:3206
translate russian kleio_event_talk_murder_a85d6823:
    "Но вдруг она разражается рыданиями, и я тоже не выдерживаю."

# ch/kleio/events.rpy:3208
translate russian kleio_event_talk_murder_f7da9353:
    "Она прижимается ко мне, а я обнимаю её."

# ch/kleio/events.rpy:3209
translate russian kleio_event_talk_murder_a9d0b2e4:
    "Это утешает, но ничего сексуального в этом нет."

# ch/kleio/events.rpy:3210
translate russian kleio_event_talk_murder_977481b2:
    "Просто двое друзей пытаются поддержать друг друга в тяжёлую минуту."

# ch/kleio/events.rpy:3211
translate russian kleio_event_talk_murder_d1b8a584:
    kleio.say "Пойдём, чувак, выпьем пива."

# ch/kleio/events.rpy:3212
translate russian kleio_event_talk_murder_fe5ea609:
    kleio.say "Напьёмся и повспоминаем Сашу, а?"

# ch/kleio/events.rpy:3213
translate russian kleio_event_talk_murder_fb09c2e7:
    mike.say "Хорошая мысль, Клео."

# ch/kleio/events.rpy:3214
translate russian kleio_event_talk_murder_29bbe8c1:
    mike.say "Пойдём!"

# ch/kleio/events.rpy:3215
translate russian kleio_event_talk_murder_cc3746e9:
    "Всё ещё прижимаясь друг к другу, мы идём в любимый паб Саши."

# ch/kleio/events.rpy:3216
translate russian kleio_event_talk_murder_1e842eb6:
    "А остаток ночи растворяется в пьяном тумане."

# ch/kleio/events.rpy:3226
translate russian kleio_birthday_date_male_85a3c183:
    "Обещая Клео свидание на день рождения, я особо не задумывался."

# ch/kleio/events.rpy:3227
translate russian kleio_birthday_date_male_9c9485aa:
    "Но стоило как следует подумать, и я понял, что серьёзно влип."

# ch/kleio/events.rpy:3228
translate russian kleio_birthday_date_male_23c4a130:
    "Потому что как, чёрт возьми, такая девушка захочет отпраздновать свой день рождения?"

# ch/kleio/events.rpy:3229
translate russian kleio_birthday_date_male_5d16d3c6:
    "Вы вообще можете представить Клео за ужином в шикарном ресторане?"

# ch/kleio/events.rpy:3230
translate russian kleio_birthday_date_male_24946b04:
    "Или на романтической прогулке по пляжу на закате?"

# ch/kleio/events.rpy:3231
translate russian kleio_birthday_date_male_ca04b190:
    "Гораздо легче представить, как она выпивает столько пива, сколько сама весит."

# ch/kleio/events.rpy:3232
translate russian kleio_birthday_date_male_017fb70c:
    "А потом вызывает банду байкеров на соревнование по армрестлингу!"

# ch/kleio/events.rpy:3233
translate russian kleio_birthday_date_male_173a33ed:
    "Но тут меня осенило: Клео ведь механик!"

# ch/kleio/events.rpy:3234
translate russian kleio_birthday_date_male_30462dcb:
    "Значит, надо отвести её туда, где это пригодится."

# ch/kleio/events.rpy:3235
translate russian kleio_birthday_date_male_a13fd1b4:
    "И где мы заодно сможем повеселиться."

# ch/kleio/events.rpy:3236
translate russian kleio_birthday_date_male_104ab9b0:
    "Так мы и оказались здесь..."

# ch/kleio/events.rpy:3241
translate russian kleio_birthday_date_male_22c09e71:
    mike.say "Та-дам!"

# ch/kleio/events.rpy:3242
translate russian kleio_birthday_date_male_e87b84dd:
    mike.say "Добро пожаловать на картодром, Клео!"

# ch/kleio/events.rpy:3243
translate russian kleio_birthday_date_male_b5a8afe3:
    mike.say "И с днём рождения!"

# ch/kleio/events.rpy:3244
translate russian kleio_birthday_date_male_56495980:
    "Клео некоторое время смотрит перед собой, потом переводит взгляд на меня."

# ch/kleio/events.rpy:3246
translate russian kleio_birthday_date_male_5d6303dd:
    "Одна бровь у неё приподнята, а на лице весёлое удивление."

# ch/kleio/events.rpy:3247
translate russian kleio_birthday_date_male_7b90a213:
    kleio.say "Ты серьёзно, сердцеед?"

# ch/kleio/events.rpy:3248
translate russian kleio_birthday_date_male_7c5be2ed:
    kleio.say "Картинг разве не для детей?"

# ch/kleio/events.rpy:3251
translate russian kleio_birthday_date_male_edf033fa:
    mike.say "Да брось, Клео, расслабься хоть ненадолго."

# ch/kleio/events.rpy:3252
translate russian kleio_birthday_date_male_19b13d94:
    mike.say "У тебя день рождения, тебе положено веселиться."

# ch/kleio/events.rpy:3254
translate russian kleio_birthday_date_male_43de96de:
    "Клео закатывает глаза."

# ch/kleio/events.rpy:3255
translate russian kleio_birthday_date_male_768f1a23:
    "Но потом всё же слегка кивает."

# ch/kleio/events.rpy:3256
translate russian kleio_birthday_date_male_9c8177ea:
    kleio.say "А, какого чёрта..."

# ch/kleio/events.rpy:3258
translate russian kleio_birthday_date_male_a6803cb2:
    kleio.say "Думаю, хуже не будет."

# ch/kleio/events.rpy:3260
translate russian kleio_birthday_date_male_ffaf772c:
    kleio.say "Знаешь, что большинство автогонщиков начинали с картинга?"

# ch/kleio/events.rpy:3261
translate russian kleio_birthday_date_male_6885f03f:
    mike.say "Правда?"

# ch/kleio/events.rpy:3262
translate russian kleio_birthday_date_male_5b35dff2:
    mike.say "Нет, Клео, не знал!"

# ch/kleio/events.rpy:3264
translate russian kleio_birthday_date_male_226f09c5:
    mike.say "Да ладно, Клео, не слишком ли это неблагодарно?"

# ch/kleio/events.rpy:3265
translate russian kleio_birthday_date_male_a06cd57d:
    mike.say "Я ведь старался, бронировал всё к твоему дню рождения!"

# ch/kleio/events.rpy:3267
translate russian kleio_birthday_date_male_f34e3ee1:
    "Клео закатывает глаза и недовольно ворчит."

# ch/kleio/events.rpy:3268
translate russian kleio_birthday_date_male_76b1c96a:
    "А потом бросает на меня довольно злой взгляд."

# ch/kleio/events.rpy:3270
translate russian kleio_birthday_date_male_0b508da4:
    kleio.say "Ладно, ладно..."

# ch/kleio/events.rpy:3271
translate russian kleio_birthday_date_male_1a00457c:
    kleio.say "Но только потому, что ты надавил мне на совесть."

# ch/kleio/events.rpy:3274
translate russian kleio_birthday_date_male_76d7d35e:
    kleio.say "Разнылся, как последняя сучка, и заставил!"

# ch/kleio/events.rpy:3275
translate russian kleio_birthday_date_male_7f234139:
    mike.say "Как скажешь, Клео."

# ch/kleio/events.rpy:3276
translate russian kleio_birthday_date_male_847a193e:
    mike.say "Давай просто покончим с этим, ладно?"

# ch/kleio/events.rpy:3277
translate russian kleio_birthday_date_male_fbc8e79d:
    "Внутри мне нужно забрать наши билеты."

# ch/kleio/events.rpy:3278
translate russian kleio_birthday_date_male_f96937f6:
    "Я уже забронировал всё через интернет, так что мы с Клео встаём в очередь."

# ch/kleio/events.rpy:3279
translate russian kleio_birthday_date_male_a3d366f4:
    "Проблема в том, что народу здесь больше, чем я ожидал."

# ch/kleio/events.rpy:3280
translate russian kleio_birthday_date_male_1ccab2e1:
    mike.say "Хм..."

# ch/kleio/events.rpy:3281
translate russian kleio_birthday_date_male_e091a62a:
    mike.say "Сегодня очередь немаленькая!"

# ch/kleio/events.rpy:3283
translate russian kleio_birthday_date_male_9562dec8:
    kleio.say "Фу..."

# ch/kleio/events.rpy:3284
translate russian kleio_birthday_date_male_75608ffd:
    kleio.say "Ещё бы, [lssb_kleio.hero_name()]!"

# ch/kleio/events.rpy:3285
translate russian kleio_birthday_date_male_3dc4b836:
    kleio.say "Сейчас разгар школьных каникул."

# ch/kleio/events.rpy:3286
translate russian kleio_birthday_date_male_90fc1e73:
    kleio.say "В таких местах кишат мелкие спиногрызы!"

# ch/kleio/events.rpy:3290
translate russian kleio_birthday_date_male_e8c7c130:
    "Женщина, стоящая перед нами в очереди, похоже, слышит наш разговор."

# ch/kleio/events.rpy:3291
translate russian kleio_birthday_date_male_3d18ce42:
    "И с улыбкой оборачивается."

# ch/kleio/events.rpy:3293
translate russian kleio_birthday_date_male_12fca2ea:
    "Женщина" "Вы тоже с детьми?"

# ch/kleio/events.rpy:3294
translate russian kleio_birthday_date_male_47dfac8c:
    "Женщина" "Наши так любят это место."

# ch/kleio/events.rpy:3295
translate russian kleio_birthday_date_male_7d88b116:
    "Женщина" "Иногда кажется, что мы проводим здесь все каникулы!"

# ch/kleio/events.rpy:3299
translate russian kleio_birthday_date_male_b4f80f0a:
    mike.say "Да нет, что вы!"

# ch/kleio/events.rpy:3300
translate russian kleio_birthday_date_male_e0761a4e:
    mike.say "Мы с Клео сами пришли погонять на картах."

# ch/kleio/events.rpy:3301
translate russian kleio_birthday_date_male_a49a74bb:
    "Женщина удивлённо смотрит на меня."

# ch/kleio/events.rpy:3302
translate russian kleio_birthday_date_male_39ea416f:
    "Женщина" "Но..."

# ch/kleio/events.rpy:3303
translate russian kleio_birthday_date_male_edc6df82:
    "Женщина" "Вы не слишком... ну, взрослые для этого?"

# ch/kleio/events.rpy:3304
translate russian kleio_birthday_date_male_4c72744e:
    "Я пожимаю плечами и качаю головой."

# ch/kleio/events.rpy:3305
translate russian kleio_birthday_date_male_ea0eb7a6:
    mike.say "Я не вижу табличек с ограничением по возрасту. А вы?"

# ch/kleio/events.rpy:3306
translate russian kleio_birthday_date_male_cdb50737:
    mike.say "Так что просто скажите детям не путаться у меня под колёсами, ладно?"

# ch/kleio/events.rpy:3307
translate russian kleio_birthday_date_male_0011d3f2:
    "Женщина явно собирается что-то ответить."

# ch/kleio/events.rpy:3308
translate russian kleio_birthday_date_male_994330c5:
    "Если присмотреться, по ней и видно: того и гляди начнёт требовать администратора!"

# ch/kleio/events.rpy:3309
translate russian kleio_birthday_date_male_aaca1ec3:
    "Но тут Клео выглядывает из-за меня и тоже вступает в разговор."

# ch/kleio/events.rpy:3311
translate russian kleio_birthday_date_male_7e1207ea:
    kleio.say "Он прав, чертовски прав!"

# ch/kleio/events.rpy:3312
translate russian kleio_birthday_date_male_750f82ab:
    kleio.say "Пусть ваши детишки глотают пыль за нами!"

# ch/kleio/events.rpy:3314
translate russian kleio_birthday_date_male_32f0479c:
    "Женщина хмурится и отворачивается."

# ch/kleio/events.rpy:3315
translate russian kleio_birthday_date_male_8f198b90:
    "Полагаю, разговор окончен."

# ch/kleio/events.rpy:3318
translate russian kleio_birthday_date_male_1675b7bc:
    "Тут Клео толкает меня локтем в бок."

# ch/kleio/events.rpy:3319
translate russian kleio_birthday_date_male_a5dcc328:
    mike.say "Ай!"

# ch/kleio/events.rpy:3321
translate russian kleio_birthday_date_male_60598966:
    kleio.say "Так держать, сердцеед."

# ch/kleio/events.rpy:3322
translate russian kleio_birthday_date_male_808d3a1a:
    kleio.say "Поставил её на место."

# ch/kleio/events.rpy:3324
translate russian kleio_birthday_date_male_7e8c2132:
    kleio.say "Вот теперь будет по-настоящему весело!"

# ch/kleio/events.rpy:3326
translate russian kleio_birthday_date_male_30e74fc5:
    mike.say "Эм..."

# ch/kleio/events.rpy:3328
translate russian kleio_birthday_date_male_46fc465b:
    mike.say "Да, мы тоже с детьми."

# ch/kleio/events.rpy:3329
translate russian kleio_birthday_date_male_d53d3be5:
    "Женщина кивает и улыбается."

# ch/kleio/events.rpy:3330
translate russian kleio_birthday_date_male_a0e552e5:
    "Затем указывает на пару ребятишек."

# ch/kleio/events.rpy:3331
translate russian kleio_birthday_date_male_012a1dc5:
    "Самых примерных и ангельских на вид детей, каких только можно представить."

# ch/kleio/events.rpy:3332
translate russian kleio_birthday_date_male_92d85df9:
    "Женщина" "Вон мои сокровища."

# ch/kleio/events.rpy:3333
translate russian kleio_birthday_date_male_385ed111:
    "Женщина" "А ваши где?"

# ch/kleio/events.rpy:3334
translate russian kleio_birthday_date_male_b5a9b15a:
    "Отчаянно озираясь, я выискиваю подходящих кандидатов."

# ch/kleio/events.rpy:3335
translate russian kleio_birthday_date_male_edb647df:
    "И указываю на ближайшую группу детей."

# ch/kleio/events.rpy:3336
translate russian kleio_birthday_date_male_9f4a2f43:
    mike.say "Вон те — наши."

# ch/kleio/events.rpy:3337
translate russian kleio_birthday_date_male_36fcd50f:
    "Женщина" "Те, что пытаются накормить червями младших?!"

# ch/kleio/events.rpy:3339
translate russian kleio_birthday_date_male_45431fca:
    mike.say "А... да!"

# ch/kleio/events.rpy:3341
translate russian kleio_birthday_date_male_32f0479c_1:
    "Женщина хмурится и отворачивается."

# ch/kleio/events.rpy:3342
translate russian kleio_birthday_date_male_8f198b90_1:
    "Полагаю, разговор окончен."

# ch/kleio/events.rpy:3345
translate russian kleio_birthday_date_male_1675b7bc_1:
    "Тут Клео толкает меня локтем в бок."

# ch/kleio/events.rpy:3346
translate russian kleio_birthday_date_male_a5dcc328_1:
    mike.say "Ай!"

# ch/kleio/events.rpy:3348
translate russian kleio_birthday_date_male_60598966_1:
    kleio.say "Молодец, сердцеед."

# ch/kleio/events.rpy:3349
translate russian kleio_birthday_date_male_568b1363:
    kleio.say "Теперь она думает, что мы растим банду малолетних преступников!"

# ch/kleio/events.rpy:3350
translate russian kleio_birthday_date_male_6a896383:
    "Наконец подходит наша очередь, и я подтверждаю бронь."

# ch/kleio/events.rpy:3351
translate russian kleio_birthday_date_male_76157324:
    "Работник в будке выдаёт нам шлемы — можно отправляться."

# ch/kleio/events.rpy:3352
translate russian kleio_birthday_date_male_128abae6:
    "Мы с Клео идём к припаркованным картам."

# ch/kleio/events.rpy:3354
translate russian kleio_birthday_date_male_50a2318f:
    "Я замечаю, что она долго и внимательно их разглядывает."

# ch/kleio/events.rpy:3356
translate russian kleio_birthday_date_male_259633e6:
    mike.say "Знаешь, Клео..."

# ch/kleio/events.rpy:3357
translate russian kleio_birthday_date_male_c2c374ad:
    mike.say "Напоминает Plumber Kart!"

# ch/kleio/events.rpy:3358
translate russian kleio_birthday_date_male_3a06068c:
    "Клео отрывается от изучения карта."

# ch/kleio/events.rpy:3360
translate russian kleio_birthday_date_male_620fbff0:
    "И недоумённо морщится."

# ch/kleio/events.rpy:3361
translate russian kleio_birthday_date_male_788a1960:
    kleio.say "Ты вообще о чём?"

# ch/kleio/events.rpy:3362
translate russian kleio_birthday_date_male_d02dcd88:
    kleio.say "О той дурацкой видеоигре?"

# ch/kleio/events.rpy:3363
translate russian kleio_birthday_date_male_f815840a:
    mike.say "Эм... да, Клео."

# ch/kleio/events.rpy:3365
translate russian kleio_birthday_date_male_ddc6d324:
    kleio.say "Ничего ты не понимаешь, сердцеед!"

# ch/kleio/events.rpy:3366
translate russian kleio_birthday_date_male_3f3eaaa2:
    kleio.say "Это не дурацкая игрушка."

# ch/kleio/events.rpy:3368
translate russian kleio_birthday_date_male_f9a5f2f6:
    kleio.say "Здесь всё по-настоящему!"

# ch/kleio/events.rpy:3371
translate russian kleio_birthday_date_male_d874221b:
    "Я качаю головой и усмехаюсь."

# ch/kleio/events.rpy:3372
translate russian kleio_birthday_date_male_fea7052c:
    "И Клео, кажется, это страшно бесит."

# ch/kleio/events.rpy:3374
translate russian kleio_birthday_date_male_9b18c132:
    kleio.say "Что смешного, а?"

# ch/kleio/events.rpy:3375
translate russian kleio_birthday_date_male_43efddb2:
    mike.say "Может, я не такой фанат моторов, как ты, Клео."

# ch/kleio/events.rpy:3376
translate russian kleio_birthday_date_male_e75df850:
    mike.say "Зато в видеоиграх, по-моему, разбираюсь чуть лучше."

# ch/kleio/events.rpy:3377
translate russian kleio_birthday_date_male_c3869769:
    mike.say "Знаешь, эту игру создавали вместе с настоящими гонщиками и на настоящих картах?"

# ch/kleio/events.rpy:3378
translate russian kleio_birthday_date_male_559f8881:
    "Клео выглядит заметно озадаченной."

# ch/kleio/events.rpy:3379
translate russian kleio_birthday_date_male_bbbe3794:
    kleio.say "Эм..."

# ch/kleio/events.rpy:3381
translate russian kleio_birthday_date_male_431132b7:
    kleio.say "Правда?"

# ch/kleio/events.rpy:3382
translate russian kleio_birthday_date_male_f88af3d9:
    mike.say "Да, именно так."

# ch/kleio/events.rpy:3383
translate russian kleio_birthday_date_male_36f194bf:
    mike.say "И всю физику смоделировали на основе собранных данных."

# ch/kleio/events.rpy:3384
translate russian kleio_birthday_date_male_5de96c82:
    kleio.say "Эм..."

# ch/kleio/events.rpy:3385
translate russian kleio_birthday_date_male_f49e1500:
    kleio.say "И что это значит?"

# ch/kleio/events.rpy:3386
translate russian kleio_birthday_date_male_7bef2ebe:
    mike.say "Что в игре всё работает как в жизни!"

# ch/kleio/events.rpy:3389
translate russian kleio_birthday_date_male_53ad4fae:
    "Клео кивает, начиная немного смущаться."

# ch/kleio/events.rpy:3390
translate russian kleio_birthday_date_male_db638bef:
    "А я чувствую прилив уверенности: удалось-таки кое-чему её научить."

# ch/kleio/events.rpy:3392
translate russian kleio_birthday_date_male_7977b504:
    "Я опускаю глаза, чувствуя себя изрядно задетым."

# ch/kleio/events.rpy:3393
translate russian kleio_birthday_date_male_b4f21d42:
    mike.say "Ладно, Клео, ладно."

# ch/kleio/events.rpy:3394
translate russian kleio_birthday_date_male_a3490c2f:
    mike.say "Знаю, ты в таких вещах разбираешься лучше меня."

# ch/kleio/events.rpy:3395
translate russian kleio_birthday_date_male_99f0cc60:
    mike.say "Но зачем так грубить?"

# ch/kleio/events.rpy:3397
translate russian kleio_birthday_date_male_3e3fbec4:
    "Клео смеётся и качает головой."

# ch/kleio/events.rpy:3398
translate russian kleio_birthday_date_male_e8a64f2f:
    kleio.say "Ох, чувак..."

# ch/kleio/events.rpy:3401
translate russian kleio_birthday_date_male_5e36fe4a:
    kleio.say "Ну и неженкой ты бываешь!"

# ch/kleio/events.rpy:3404
translate russian kleio_birthday_date_male_e38059a5:
    "Думаю, Клео без труда определит лучший из доступных картов."

# ch/kleio/events.rpy:3405
translate russian kleio_birthday_date_male_4a24c6e3:
    "Нужно как-нибудь обратить это себе на пользу."

# ch/kleio/events.rpy:3406
translate russian kleio_birthday_date_male_87027359:
    "Хм... интересно, можно ли заставить её рассказать, на что смотреть?"

# ch/kleio/events.rpy:3407
translate russian kleio_birthday_date_male_643c1a94:
    "Да ещё так, чтобы она ничего не заподозрила."

# ch/kleio/events.rpy:3408
translate russian kleio_birthday_date_male_5bc46e45:
    "Я быстро оглядываюсь."

# ch/kleio/events.rpy:3409
translate russian kleio_birthday_date_male_d6ddd548:
    "И выбираю самый потрёпанный на вид карт."

# ch/kleio/events.rpy:3410
translate russian kleio_birthday_date_male_db43a4ee:
    "По крайней мере, на мой дилетантский взгляд."

# ch/kleio/events.rpy:3411
translate russian kleio_birthday_date_male_647913e6:
    mike.say "Эй, Клео..."

# ch/kleio/events.rpy:3412
translate russian kleio_birthday_date_male_3952d7d0:
    mike.say "А как тебе этот карт?"

# ch/kleio/events.rpy:3413
translate russian kleio_birthday_date_male_020a8406:
    mike.say "Вроде неплохой."

# ch/kleio/events.rpy:3415
translate russian kleio_birthday_date_male_9fe82661:
    "Услышав мой голос, Клео подходит."

# ch/kleio/events.rpy:3417
translate russian kleio_birthday_date_male_1a6cfae4:
    "Едва взглянув на карт, она качает головой."

# ch/kleio/events.rpy:3418
translate russian kleio_birthday_date_male_400eb236:
    kleio.say "Не, это хлам!"

# ch/kleio/events.rpy:3420
translate russian kleio_birthday_date_male_4b2d2f94:
    kleio.say "И вот почему..."

# ch/kleio/events.rpy:3421
translate russian kleio_birthday_date_male_992c731c:
    "Дальше следует ускоренный курс устройства картов."

# ch/kleio/events.rpy:3422
translate russian kleio_birthday_date_male_adaf6448:
    "Я всё время киваю и внимательно слушаю."

# ch/kleio/events.rpy:3423
translate russian kleio_birthday_date_male_81bc335b:
    "К концу объяснений мне кажется, что я узнал достаточно."

# ch/kleio/events.rpy:3426
translate russian kleio_birthday_date_male_c1171201:
    kleio.say "Теперь пойду выберу себе карт, ладно?"

# ch/kleio/events.rpy:3427
translate russian kleio_birthday_date_male_906bac50:
    mike.say "Ладно, Клео..."

# ch/kleio/events.rpy:3428
translate russian kleio_birthday_date_male_802ae2cb:
    mike.say "Увидимся на трассе."

# ch/kleio/events.rpy:3430
translate russian kleio_birthday_date_male_fe520a4f:
    "Оставшись один, я применяю только что полученные знания."

# ch/kleio/events.rpy:3431
translate russian kleio_birthday_date_male_0da0a8f4:
    "И вполне уверен, что благодаря им выбрал один из лучших картов."

# ch/kleio/events.rpy:3433
translate russian kleio_birthday_date_male_1a6cfae4_1:
    "Едва взглянув на карт, она качает головой."

# ch/kleio/events.rpy:3434
translate russian kleio_birthday_date_male_400eb236_1:
    kleio.say "Не, это хлам!"

# ch/kleio/events.rpy:3436
translate russian kleio_birthday_date_male_f87d757e:
    kleio.say "Эй, погоди-ка..."

# ch/kleio/events.rpy:3437
translate russian kleio_birthday_date_male_e1b0638c:
    kleio.say "Ты что задумал?"

# ch/kleio/events.rpy:3438
translate russian kleio_birthday_date_male_41c53a29:
    "Я отступаю на шаг и поднимаю руки."

# ch/kleio/events.rpy:3439
translate russian kleio_birthday_date_male_c9f9f65a:
    mike.say "Никаких хитростей, Клео, клянусь!"

# ch/kleio/events.rpy:3442
translate russian kleio_birthday_date_male_72ecfbcd:
    kleio.say "Врёшь!"

# ch/kleio/events.rpy:3443
translate russian kleio_birthday_date_male_bdf032bc:
    kleio.say "Ты же ни хрена в этом не смыслишь."

# ch/kleio/events.rpy:3444
translate russian kleio_birthday_date_male_58d538f3:
    kleio.say "Хотел, чтобы я выбрала тебе карт!"

# ch/kleio/events.rpy:3446
translate russian kleio_birthday_date_male_f26ab009:
    "Клео качает головой и уходит выбирать себе карт."

# ch/kleio/events.rpy:3447
translate russian kleio_birthday_date_male_28129fc9:
    "А мне, похоже, остаётся взять наугад и надеяться на лучшее."

# ch/kleio/events.rpy:3449
translate russian kleio_birthday_date_male_f3fcb7a4:
    "Надо признать, я понятия не имею, что искать."

# ch/kleio/events.rpy:3450
translate russian kleio_birthday_date_male_a6a133c0:
    "Остаётся бродить между картами и выбирать наугад."

# ch/kleio/events.rpy:3452
translate russian kleio_birthday_date_male_da55f46c:
    "Замечаю, что Клео наблюдает за мной с лукавой улыбкой."

# ch/kleio/events.rpy:3453
translate russian kleio_birthday_date_male_d5552114:
    "Поймав мой взгляд, она подходит."

# ch/kleio/events.rpy:3455
translate russian kleio_birthday_date_male_4c8f832d:
    kleio.say "Не знаешь, какой выбрать, а?"

# ch/kleio/events.rpy:3456
translate russian kleio_birthday_date_male_981aa435:
    kleio.say "Надо было подтянуть матчасть, сердцеед!"

# ch/kleio/events.rpy:3457
translate russian kleio_birthday_date_male_010df176:
    kleio.say "И помощи у меня не проси."

# ch/kleio/events.rpy:3458
translate russian kleio_birthday_date_male_eb66d3db:
    kleio.say "Это была твоя идея, вот и посмотрим, как ты справишься!"

# ch/kleio/events.rpy:3459
translate russian kleio_birthday_date_male_f59b3897:
    "Я бросаю на Клео последний умоляющий взгляд."

# ch/kleio/events.rpy:3460
translate russian kleio_birthday_date_male_a4fb8047:
    "Но она лишь кивает в сторону картов."

# ch/kleio/events.rpy:3461
translate russian kleio_birthday_date_male_a114cdda:
    "Ясно: помощи ждать неоткуда."

# ch/kleio/events.rpy:3462
translate russian kleio_birthday_date_male_80dc461a:
    "Похоже, придётся выбирать наугад."

# ch/kleio/events.rpy:3463
translate russian kleio_birthday_date_male_92141f01:
    "И надеяться на удачу..."

# ch/kleio/events.rpy:3465
translate russian kleio_birthday_date_male_30e74fc5_1:
    mike.say "Эм..."

# ch/kleio/events.rpy:3466
translate russian kleio_birthday_date_male_63d2c42c:
    mike.say "А как насчёт этих?"

# ch/kleio/events.rpy:3467
translate russian kleio_birthday_date_male_8b72e045:
    mike.say "Цвет очень красивый."

# ch/kleio/events.rpy:3468
translate russian kleio_birthday_date_male_72a9edce:
    mike.say "Может, поэтому они быстрее едут?"

# ch/kleio/events.rpy:3469
translate russian kleio_birthday_date_male_4130b934:
    "Клео смотрит на меня так, будто вот-вот рассмеётся."

# ch/kleio/events.rpy:3471
translate russian kleio_birthday_date_male_da3335c9:
    "Но что-то в этих картах вдруг привлекает её внимание."

# ch/kleio/events.rpy:3472
translate russian kleio_birthday_date_male_fd94db2e:
    "Она наклоняется и принимается осматривать двигатели."

# ch/kleio/events.rpy:3473
translate russian kleio_birthday_date_male_cbf02273:
    "Потом выпрямляется, качая головой."

# ch/kleio/events.rpy:3474
translate russian kleio_birthday_date_male_5385c5e3:
    kleio.say "Ну охренеть теперь..."

# ch/kleio/events.rpy:3476
translate russian kleio_birthday_date_male_93074cdd:
    kleio.say "Может, это чистое везение."

# ch/kleio/events.rpy:3477
translate russian kleio_birthday_date_male_0e1659e4:
    kleio.say "Но, похоже, это лучшие карты из всех!"

# ch/kleio/events.rpy:3480
translate russian kleio_birthday_date_male_da9c4eb1:
    kleio.say "В следующий раз, когда буду покупать машину, возьму тебя на осмотр!"

# ch/kleio/events.rpy:3483
translate russian kleio_birthday_date_male_30e74fc5_2:
    mike.say "Эм..."

# ch/kleio/events.rpy:3484
translate russian kleio_birthday_date_male_63d2c42c_1:
    mike.say "А как насчёт этих?"

# ch/kleio/events.rpy:3485
translate russian kleio_birthday_date_male_8b72e045_1:
    mike.say "Цвет очень красивый."

# ch/kleio/events.rpy:3486
translate russian kleio_birthday_date_male_72a9edce_1:
    mike.say "Может, поэтому они быстрее едут?"

# ch/kleio/events.rpy:3488
translate russian kleio_birthday_date_male_629ec1b5:
    "Клео смотрит на меня с полнейшим изумлением."

# ch/kleio/events.rpy:3490
translate russian kleio_birthday_date_male_ba7f281a:
    "А потом разражается смехом."

# ch/kleio/events.rpy:3491
translate russian kleio_birthday_date_male_eef197cb:
    kleio.say "Быстрее едут, потому что цвет красивый?"

# ch/kleio/events.rpy:3492
translate russian kleio_birthday_date_male_12536193:
    kleio.say "Ты, блядь, дебил или как?!"

# ch/kleio/events.rpy:3493
translate russian kleio_birthday_date_male_95d20241:
    kleio.say "Нет... не отвечай."

# ch/kleio/events.rpy:3496
translate russian kleio_birthday_date_male_f5e29ba7:
    kleio.say "Просто оставь выбор машин мне."

# ch/kleio/events.rpy:3504
translate russian kleio_birthday_date_male_063e27e9:
    "Теперь, когда карты выбраны, можно выезжать на трассу."

# ch/kleio/events.rpy:3505
translate russian kleio_birthday_date_male_b3d8e828:
    "Я поспешно запрыгиваю в свой и пристёгиваюсь."

# ch/kleio/events.rpy:3506
translate russian kleio_birthday_date_male_904e16c9:
    "Но пока пытаюсь завестись, Клео уже проносится мимо на своём карте!"

# ch/kleio/events.rpy:3508
translate russian kleio_birthday_date_male_de203132:
    kleio.say "Ха-ха!"

# ch/kleio/events.rpy:3509
translate russian kleio_birthday_date_male_0b8c46dd:
    kleio.say "Глотай пыль, неудачник!"

# ch/kleio/events.rpy:3510
translate russian kleio_birthday_date_male_1f0bd214:
    "Обычно за рулём я довольно спокоен."

# ch/kleio/events.rpy:3511
translate russian kleio_birthday_date_male_93af0830:
    "Но насмешка Клео действует как красная тряпка на быка."

# ch/kleio/events.rpy:3514
translate russian kleio_birthday_date_male_f16e5f9b:
    "Я с визгом срываюсь за ней, оглушённый скрипом истязаемых шин."

# ch/kleio/events.rpy:3515
translate russian kleio_birthday_date_male_09584e31:
    "Выехав на трассу, вижу её впереди."

# ch/kleio/events.rpy:3516
translate russian kleio_birthday_date_male_925bb7c0:
    "Вот теперь гонка начинается по-настоящему!"

# ch/kleio/events.rpy:3518
translate russian kleio_birthday_date_male_b70adba3:
    "Возможно, я намеренно забыл сообщить Клео одну вещь."

# ch/kleio/events.rpy:3519
translate russian kleio_birthday_date_male_c00430fb:
    "Картинг — моя страсть с самого детства."

# ch/kleio/events.rpy:3520
translate russian kleio_birthday_date_male_f3a3a11c:
    "Не сосчитать, сколько часов я провёл, рассекая по таким трассам."

# ch/kleio/events.rpy:3521
translate russian kleio_birthday_date_male_650add90:
    "Так что в кресле карта я чувствую себя как дома."

# ch/kleio/events.rpy:3522
translate russian kleio_birthday_date_male_1ecced54:
    "Я догоняю Клео, сокращая разрыв в рекордное время."

# ch/kleio/events.rpy:3523
translate russian kleio_birthday_date_male_d212af7e:
    "И чутьё меня не подводит."

# ch/kleio/events.rpy:3524
translate russian kleio_birthday_date_male_dac730d9:
    "Впереди замечаю идеальное место для обгона."

# ch/kleio/events.rpy:3525
translate russian kleio_birthday_date_male_6f8c017a:
    "Но затем мне в голову приходит одна мысль."

# ch/kleio/events.rpy:3526
translate russian kleio_birthday_date_male_e73d40fd:
    "Точно ли я хочу обыграть Клео в её день рождения?"

# ch/kleio/events.rpy:3529
translate russian kleio_birthday_date_male_cdf7c6e7:
    "К чёрту любезности!"

# ch/kleio/events.rpy:3530
translate russian kleio_birthday_date_male_b4a55ce9:
    "За поддавки Клео уважать меня не станет."

# ch/kleio/events.rpy:3531
translate russian kleio_birthday_date_male_55d39bb7:
    "Перед поворотом я выхожу на обгон, едва не встав на два колеса."

# ch/kleio/events.rpy:3534
translate russian kleio_birthday_date_male_b5a47c38:
    "Потом с визгом проношусь мимо неё и вырываюсь вперёд."

# ch/kleio/events.rpy:3535
translate russian kleio_birthday_date_male_cd83c46e:
    "После этого мы меняемся ролями."

# ch/kleio/events.rpy:3536
translate russian kleio_birthday_date_male_2cf95b51:
    "До конца заезда Клео остаётся в моём зеркале заднего вида."

# ch/kleio/events.rpy:3537
translate russian kleio_birthday_date_male_75d3c805:
    "И ни за что меня не догонит!"

# ch/kleio/events.rpy:3538
translate russian kleio_birthday_date_male_96f653a7:
    "Я пролетаю финишную черту и с визгом останавливаюсь."

# ch/kleio/events.rpy:3543
translate russian kleio_birthday_date_male_fd1009ab:
    "Затем вижу, как ко мне идёт Клео."

# ch/kleio/events.rpy:3544
translate russian kleio_birthday_date_male_88799acc:
    kleio.say "Где ты, блядь, научился так водить?!"

# ch/kleio/events.rpy:3545
translate russian kleio_birthday_date_male_6095950f:
    mike.say "Не знаю, Клео, наверное, само получилось!"

# ch/kleio/events.rpy:3547
translate russian kleio_birthday_date_male_bfe765c3:
    "Клео фыркает и кивает."

# ch/kleio/events.rpy:3550
translate russian kleio_birthday_date_male_1571f149:
    "Но я замечаю в её глазах новое уважение."

# ch/kleio/events.rpy:3552
translate russian kleio_birthday_date_male_14770e2c:
    "Решаю, что лучше дать Клео победить."

# ch/kleio/events.rpy:3553
translate russian kleio_birthday_date_male_a0928bcb:
    "Но это не значит, что победа должна достаться ей легко."

# ch/kleio/events.rpy:3557
translate russian kleio_birthday_date_male_f29e1514:
    "Весь заезд я висну у неё на хвосте."

# ch/kleio/events.rpy:3558
translate russian kleio_birthday_date_male_445deb57:
    "При каждой её ошибке и любой возможности бросаюсь вперёд."

# ch/kleio/events.rpy:3559
translate russian kleio_birthday_date_male_cf69edc1:
    "Но в последний момент осторожно отступаю."

# ch/kleio/events.rpy:3560
translate russian kleio_birthday_date_male_4afe657a:
    "Так кажется, что Клео едва удаётся удерживать преимущество."

# ch/kleio/events.rpy:3561
translate russian kleio_birthday_date_male_17020ff0:
    "И на последнем круге я делаю вид, что вот-вот её догоню."

# ch/kleio/events.rpy:3562
translate russian kleio_birthday_date_male_c5dd3108:
    "Держусь у самого хвоста, когда она пересекает клетчатую черту."

# ch/kleio/events.rpy:3563
translate russian kleio_birthday_date_male_37136dda:
    "Я финиширую вторым и останавливаю карт в безопасном месте."

# ch/kleio/events.rpy:3568
translate russian kleio_birthday_date_male_fd1009ab_1:
    "Затем вижу, как ко мне идёт Клео."

# ch/kleio/events.rpy:3570
translate russian kleio_birthday_date_male_fb238d00:
    kleio.say "Ты меня чуть не обогнал!"

# ch/kleio/events.rpy:3571
translate russian kleio_birthday_date_male_88799acc_1:
    kleio.say "Где ты, блядь, научился так водить?!"

# ch/kleio/events.rpy:3572
translate russian kleio_birthday_date_male_6095950f_1:
    mike.say "Не знаю, Клео, наверное, само получилось!"

# ch/kleio/events.rpy:3574
translate russian kleio_birthday_date_male_bfe765c3_1:
    "Клео фыркает и кивает."

# ch/kleio/events.rpy:3576
translate russian kleio_birthday_date_male_1571f149_1:
    "Но я замечаю в её глазах новое уважение."

# ch/kleio/events.rpy:3579
translate russian kleio_birthday_date_male_985ee273:
    "Не знаю, что, чёрт возьми, на меня находит."

# ch/kleio/events.rpy:3580
translate russian kleio_birthday_date_male_a8349d77:
    "Я не просто хочу догнать Клео — я ещё и в ударе."

# ch/kleio/events.rpy:3581
translate russian kleio_birthday_date_male_b6660028:
    "Пока несусь за ней по трассе, всё будто само собой складывается."

# ch/kleio/events.rpy:3582
translate russian kleio_birthday_date_male_3c20646f:
    "Она и опомниться не успевает, а я уже у неё на хвосте!"

# ch/kleio/events.rpy:3583
translate russian kleio_birthday_date_male_2a22634d:
    "Да, Клео очень неплохо водит."

# ch/kleio/events.rpy:3584
translate russian kleio_birthday_date_male_9131ff90:
    "Но я словно вышел на новый уровень."

# ch/kleio/events.rpy:3585
translate russian kleio_birthday_date_male_66e629d3:
    "Будто у меня внезапно открылся гениальный талант!"

# ch/kleio/events.rpy:3586
translate russian kleio_birthday_date_male_55d39bb7_1:
    "Перед поворотом я выхожу на обгон, едва не встав на два колеса."

# ch/kleio/events.rpy:3589
translate russian kleio_birthday_date_male_b5a47c38_1:
    "Потом с визгом проношусь мимо неё и вырываюсь вперёд."

# ch/kleio/events.rpy:3590
translate russian kleio_birthday_date_male_cd83c46e_1:
    "После этого мы меняемся ролями."

# ch/kleio/events.rpy:3591
translate russian kleio_birthday_date_male_2cf95b51_1:
    "До конца заезда Клео остаётся в моём зеркале заднего вида."

# ch/kleio/events.rpy:3592
translate russian kleio_birthday_date_male_75d3c805_1:
    "И ни за что меня не догонит!"

# ch/kleio/events.rpy:3593
translate russian kleio_birthday_date_male_96f653a7_1:
    "Я пролетаю финишную черту и с визгом останавливаюсь."

# ch/kleio/events.rpy:3598
translate russian kleio_birthday_date_male_fd1009ab_2:
    "Затем вижу, как ко мне идёт Клео."

# ch/kleio/events.rpy:3599
translate russian kleio_birthday_date_male_88799acc_2:
    kleio.say "Где ты, блядь, научился так водить?!"

# ch/kleio/events.rpy:3600
translate russian kleio_birthday_date_male_6095950f_2:
    mike.say "Не знаю, Клео, наверное, само получилось!"

# ch/kleio/events.rpy:3601
translate russian kleio_birthday_date_male_bfe765c3_2:
    "Клео фыркает и кивает."

# ch/kleio/events.rpy:3604
translate russian kleio_birthday_date_male_1571f149_2:
    "Но я замечаю в её глазах новое уважение."

# ch/kleio/events.rpy:3606
translate russian kleio_birthday_date_male_6ab4714b:
    "Я бросаюсь в погоню за Клео, твёрдо намеренный её догнать."

# ch/kleio/events.rpy:3607
translate russian kleio_birthday_date_male_9671a7b3:
    "Но сколько ни давлю на газ, толку никакого."

# ch/kleio/events.rpy:3609
translate russian kleio_birthday_date_male_41b6eaf6:
    "Она всё время впереди, далеко оторвавшись от меня."

# ch/kleio/events.rpy:3610
translate russian kleio_birthday_date_male_1c8e7a78:
    "Я так зациклен на погоне, что не замечаю ничего вокруг."

# ch/kleio/events.rpy:3612
translate russian kleio_birthday_date_male_85d4d1cd:
    "Поэтому под конец гонки теряю управление."

# ch/kleio/events.rpy:3615
translate russian kleio_birthday_date_male_58fd769f:
    "Неверно рассчитав поворот, я ухожу в занос."

# ch/kleio/events.rpy:3620
translate russian kleio_birthday_date_male_d0df7239:
    "И врезаюсь в покрышки у края трассы."

# ch/kleio/events.rpy:3626
translate russian kleio_birthday_date_male_61aa2827:
    "Когда перед глазами проясняется, вижу, как ко мне идёт Клео."

# ch/kleio/events.rpy:3627
translate russian kleio_birthday_date_male_501e4127:
    kleio.say "Ого..."

# ch/kleio/events.rpy:3628
translate russian kleio_birthday_date_male_3f071dd1:
    kleio.say "Да ты и правда полный ноль!"

# ch/kleio/events.rpy:3629
translate russian kleio_birthday_date_male_b94e22b6:
    mike.say "Спасибо, Клео..."

# ch/kleio/events.rpy:3630
translate russian kleio_birthday_date_male_3f13dde1:
    mike.say "Полагаю, ты выиграла?"

# ch/kleio/events.rpy:3633
translate russian kleio_birthday_date_male_cc69eab3:
    "Клео кивает и улыбается."

# ch/kleio/events.rpy:3634
translate russian kleio_birthday_date_male_f16a736b:
    "Утешаю себя тем, что хотя бы сумел её порадовать."

# ch/kleio/events.rpy:3636
translate russian kleio_birthday_date_male_1aeb6953:
    "После гонки мы с Клео находим тихое место подальше от трассы."

# ch/kleio/events.rpy:3637
translate russian kleio_birthday_date_male_d62cc264:
    "Мы не говорим об этом, но, кажется, обоим нужно немного перевести дух."

# ch/kleio/events.rpy:3638
translate russian kleio_birthday_date_male_3e3663d5:
    "Правда, Клео пока не собирается оставлять меня в покое."

# ch/kleio/events.rpy:3639
translate russian kleio_birthday_date_male_ad327d33:
    kleio.say "Итак..."

# ch/kleio/events.rpy:3641
translate russian kleio_birthday_date_male_1866c054:
    kleio.say "Ты пригласил меня на свидание?"

# ch/kleio/events.rpy:3642
translate russian kleio_birthday_date_male_f8db339c:
    mike.say "Ага."

# ch/kleio/events.rpy:3643
translate russian kleio_birthday_date_male_5e7b8ae5:
    kleio.say "И у меня день рождения, да?"

# ch/kleio/events.rpy:3644
translate russian kleio_birthday_date_male_7e220eed:
    mike.say "Всё верно, Клео."

# ch/kleio/events.rpy:3646
translate russian kleio_birthday_date_male_c9a6c2df:
    kleio.say "А ещё что-нибудь у тебя для меня есть?"

# ch/kleio/events.rpy:3648
translate russian kleio_birthday_date_male_6573b07f:
    "Вот дерьмо!"

# ch/kleio/events.rpy:3649
translate russian kleio_birthday_date_male_c57ae684:
    "Я думал, что ничего не забыл."

# ch/kleio/events.rpy:3650
translate russian kleio_birthday_date_male_9dce8faa:
    "А про подарок Клео на день рождения всё-таки забыл!"

# ch/kleio/events.rpy:3651
translate russian kleio_birthday_date_male_a3f7172e:
    "Деваться некуда."

# ch/kleio/events.rpy:3652
translate russian kleio_birthday_date_male_ab3119db:
    "Придётся как-нибудь выкручиваться с помощью вранья."

# ch/kleio/events.rpy:3653
translate russian kleio_birthday_date_male_fa149973:
    mike.say "Ну, дурацкий подарок я тебе покупать не стал, Клео!"

# ch/kleio/events.rpy:3654
translate russian kleio_birthday_date_male_26d7fc4d:
    mike.say "Это было бы слишком предсказуемо, правда?"

# ch/kleio/events.rpy:3655
translate russian kleio_birthday_date_male_dc62c1df:
    mike.say "И знаю, ты не из тех девушек, которым нравится такая ерунда!"

# ch/kleio/events.rpy:3657
translate russian kleio_birthday_date_male_0d81959e:
    "Клео смотрит на меня так, будто сейчас отчитает."

# ch/kleio/events.rpy:3658
translate russian kleio_birthday_date_male_b95f66c3:
    "Но потом в её глазах появляется понимание, на которое я и рассчитывал."

# ch/kleio/events.rpy:3659
translate russian kleio_birthday_date_male_29201723:
    "По этому взгляду ясно: сработало."

# ch/kleio/events.rpy:3663
translate russian kleio_birthday_date_male_c3ff15a6:
    kleio.say "Ну... да!"

# ch/kleio/events.rpy:3665
translate russian kleio_birthday_date_male_904b6fc8:
    kleio.say "Тут ты меня раскусил, сердцеед!"

# ch/kleio/events.rpy:3666
translate russian kleio_birthday_date_male_e39d1d74:
    "Я вижу, что на самом деле она разочарована."

# ch/kleio/events.rpy:3667
translate russian kleio_birthday_date_male_ac76b62a:
    "Но ложь хотя бы на время избавила меня от неприятностей."

# ch/kleio/events.rpy:3672
translate russian kleio_birthday_date_male_c970cde2:
    "Я поднимаю одну руку, а другой тянусь за подарком."

# ch/kleio/events.rpy:3673
translate russian kleio_birthday_date_male_e97277e9:
    mike.say "Только не сердись, Клео."

# ch/kleio/events.rpy:3674
translate russian kleio_birthday_date_male_6383416a:
    mike.say "Знаю, обычные традиции дня рождения тебе не по душе."

# ch/kleio/events.rpy:3675
translate russian kleio_birthday_date_male_d986f4ed:
    mike.say "Но я всё равно приготовил подарок."

# ch/kleio/events.rpy:3676
translate russian kleio_birthday_date_male_d4c9e02e:
    "Клео с готовностью забирает подарок из моих рук."

# ch/kleio/events.rpy:3677
translate russian kleio_birthday_date_male_1de83183:
    "Изо всех сил изображая, будто делает мне одолжение."

# ch/kleio/events.rpy:3678
translate russian kleio_birthday_date_male_efa3b33d:
    kleio.say "Ой, ну зачем было утруждаться."

# ch/kleio/events.rpy:3679
translate russian kleio_birthday_date_male_29c14f11:
    kleio.say "Но в этот раз я тебя прощу!"

# ch/kleio/events.rpy:3683
translate russian kleio_birthday_date_male_59978027:
    "Клео срывает бумагу и отбрасывает её."

# ch/kleio/events.rpy:3684
translate russian kleio_birthday_date_male_fffe0dce:
    "Увидев, что внутри, она тут же расцветает."

# ch/kleio/events.rpy:3686
translate russian kleio_birthday_date_male_875f5bdb:
    kleio.say "ДА НУ НА ХРЕН!"

# ch/kleio/events.rpy:3687
translate russian kleio_birthday_date_male_513ea0d0:
    kleio.say "Ты, должно быть, издеваешься!"

# ch/kleio/events.rpy:3688
translate russian kleio_birthday_date_male_e0c18c44:
    mike.say "Что такое, Клео?"

# ch/kleio/events.rpy:3689
translate russian kleio_birthday_date_male_73dfd47c:
    mike.say "Всё нормально?"

# ch/kleio/events.rpy:3690
translate russian kleio_birthday_date_male_dbf5bfb6:
    "Клео смотрит мне в глаза."

# ch/kleio/events.rpy:3693
translate russian kleio_birthday_date_male_36773dee:
    "На её лице — чистое изумление."

# ch/kleio/events.rpy:3694
translate russian kleio_birthday_date_male_89bde2d8:
    kleio.say "Где ты, блядь, это нашёл?!"

# ch/kleio/events.rpy:3695
translate russian kleio_birthday_date_male_adedcd12:
    kleio.say "Ты хоть знаешь, какая это редкость?"

# ch/kleio/events.rpy:3696
translate russian kleio_birthday_date_male_1528dd84:
    kleio.say "Я сто лет такое ищу!"

# ch/kleio/events.rpy:3697
translate russian kleio_birthday_date_male_6dbe51bb:
    mike.say "А... да, Клео."

# ch/kleio/events.rpy:3698
translate russian kleio_birthday_date_male_4cc53768:
    mike.say "Помню, ты пару раз упоминала."

# ch/kleio/events.rpy:3699
translate russian kleio_birthday_date_male_01f63f77:
    mike.say "Найти было непросто, но мне повезло!"

# ch/kleio/events.rpy:3704
translate russian kleio_birthday_date_male_99a6986a:
    "Через мгновение Клео неожиданно страстно целует меня."

# ch/kleio/events.rpy:3705
translate russian kleio_birthday_date_male_1c79270f:
    "А то, что она ещё и довольно сильно сжимает мой член, только добавляет ощущений!"

# ch/kleio/events.rpy:3706
translate russian kleio_birthday_date_male_647cabbe:
    "Буду считать, что подарок ей понравился."

# ch/kleio/events.rpy:3709
translate russian kleio_birthday_date_male_59978027_1:
    "Клео срывает бумагу и отбрасывает её."

# ch/kleio/events.rpy:3710
translate russian kleio_birthday_date_male_4e883d5f:
    "Но, увидев содержимое, сразу мрачнеет."

# ch/kleio/events.rpy:3712
translate russian kleio_birthday_date_male_ff7c34a5:
    kleio.say "О..."

# ch/kleio/events.rpy:3713
translate russian kleio_birthday_date_male_e0c18c44_1:
    mike.say "Что такое, Клео?"

# ch/kleio/events.rpy:3714
translate russian kleio_birthday_date_male_73dfd47c_1:
    mike.say "Всё нормально?"

# ch/kleio/events.rpy:3716
translate russian kleio_birthday_date_male_81132150:
    "Клео хмыкает и пожимает плечами."

# ch/kleio/events.rpy:3717
translate russian kleio_birthday_date_male_bbbe3794_1:
    kleio.say "Эм..."

# ch/kleio/events.rpy:3719
translate russian kleio_birthday_date_male_3a1837a3:
    kleio.say "Ну, не совсем уж кусок дерьма."

# ch/kleio/events.rpy:3720
translate russian kleio_birthday_date_male_890ffbc6:
    kleio.say "Но мог бы и получше!"

# ch/kleio/events.rpy:3721
translate russian kleio_birthday_date_male_1ce1bb25:
    "Её прямолинейность меня порядком ошеломляет."

# ch/kleio/events.rpy:3722
translate russian kleio_birthday_date_male_95c8b414:
    "Остаётся только медленно кивнуть."

# ch/kleio/events.rpy:3723
translate russian kleio_birthday_date_male_906bac50_1:
    mike.say "Ладно, Клео..."

# ch/kleio/events.rpy:3724
translate russian kleio_birthday_date_male_b374972d:
    mike.say "В следующий раз постараюсь больше."

# ch/kleio/events.rpy:3726
translate russian kleio_birthday_date_male_6573b07f_1:
    "Вот дерьмо!"

# ch/kleio/events.rpy:3727
translate russian kleio_birthday_date_male_c57ae684_1:
    "Я думал, что ничего не забыл."

# ch/kleio/events.rpy:3728
translate russian kleio_birthday_date_male_9dce8faa_1:
    "А про подарок Клео на день рождения всё-таки забыл!"

# ch/kleio/events.rpy:3729
translate russian kleio_birthday_date_male_a3f7172e_1:
    "Деваться некуда."

# ch/kleio/events.rpy:3730
translate russian kleio_birthday_date_male_ab3119db_1:
    "Придётся как-нибудь выкручиваться с помощью вранья."

# ch/kleio/events.rpy:3731
translate russian kleio_birthday_date_male_fa149973_1:
    mike.say "Ну, дурацкий подарок я тебе покупать не стал, Клео!"

# ch/kleio/events.rpy:3732
translate russian kleio_birthday_date_male_26d7fc4d_1:
    mike.say "Это было бы слишком предсказуемо, правда?"

# ch/kleio/events.rpy:3733
translate russian kleio_birthday_date_male_dc62c1df_1:
    mike.say "И знаю, ты не из тех девушек, которым нравится такая ерунда!"

# ch/kleio/events.rpy:3735
translate russian kleio_birthday_date_male_0d81959e_1:
    "Клео смотрит на меня так, будто сейчас отчитает."

# ch/kleio/events.rpy:3736
translate russian kleio_birthday_date_male_b95f66c3_1:
    "Но потом в её глазах появляется понимание, на которое я и рассчитывал."

# ch/kleio/events.rpy:3737
translate russian kleio_birthday_date_male_29201723_1:
    "По этому взгляду ясно: сработало."

# ch/kleio/events.rpy:3741
translate russian kleio_birthday_date_male_c3ff15a6_1:
    kleio.say "Ну... да!"

# ch/kleio/events.rpy:3743
translate russian kleio_birthday_date_male_904b6fc8_1:
    kleio.say "Тут ты меня раскусил, сердцеед!"

# ch/kleio/events.rpy:3744
translate russian kleio_birthday_date_male_e39d1d74_1:
    "Я вижу, что на самом деле она разочарована."

# ch/kleio/events.rpy:3745
translate russian kleio_birthday_date_male_ac76b62a_1:
    "Но ложь хотя бы на время избавила меня от неприятностей."

# ch/kleio/events.rpy:3749
translate russian kleio_birthday_date_male_b093fbdc:
    "К этому моменту я уже вроде бы отдохнул после первой гонки с Клео."

# ch/kleio/events.rpy:3750
translate russian kleio_birthday_date_male_40ba55d2:
    "И она, похоже, тоже: вдруг вскакивает на ноги."

# ch/kleio/events.rpy:3751
translate russian kleio_birthday_date_male_34ccd6f9:
    kleio.say "Знаешь что, сердцеед?"

# ch/kleio/events.rpy:3752
translate russian kleio_birthday_date_male_08aa3d04:
    kleio.say "Я начинаю всерьёз втягиваться в эту хрень!"

# ch/kleio/events.rpy:3754
translate russian kleio_birthday_date_male_3de3bcc1:
    kleio.say "Может, ещё один заезд?"

# ch/kleio/events.rpy:3755
translate russian kleio_birthday_date_male_68e697e1:
    "Я смотрю на трассу через плечо Клео."

# ch/kleio/events.rpy:3756
translate russian kleio_birthday_date_male_b922a4a8:
    "И прикидываю, хватит ли меня ещё на одну гонку."

# ch/kleio/events.rpy:3757
translate russian kleio_birthday_date_male_b049915a:
    "Конечно, можно поднапрячься и сделать, как она хочет."

# ch/kleio/events.rpy:3758
translate russian kleio_birthday_date_male_9617aa40:
    "Всё-таки у неё день рождения."

# ch/kleio/events.rpy:3759
translate russian kleio_birthday_date_male_764f11f4:
    "Но, с другой стороны, я уже изрядно вымотан."

# ch/kleio/events.rpy:3760
translate russian kleio_birthday_date_male_04635a96:
    "Ещё одна гонка меня, пожалуй, доконает!"

# ch/kleio/events.rpy:3763
translate russian kleio_birthday_date_male_2190fd2e:
    mike.say "Ладно, Клео, вызов принят."

# ch/kleio/events.rpy:3764
translate russian kleio_birthday_date_male_c6b22b98:
    mike.say "А то придётся тебе соревноваться с детьми."

# ch/kleio/events.rpy:3765
translate russian kleio_birthday_date_male_6a6e284b:
    mike.say "Будет неловко смотреть, как они тебя уделают!"

# ch/kleio/events.rpy:3767
translate russian kleio_birthday_date_male_42850ec9:
    "Когда я встаю, глаза Клео расширяются."

# ch/kleio/events.rpy:3768
translate russian kleio_birthday_date_male_815bae65:
    "Но моя наглость всё же её смешит."

# ch/kleio/events.rpy:3771
translate russian kleio_birthday_date_male_276fecdf:
    kleio.say "Громкие слова, неудачник!"

# ch/kleio/events.rpy:3772
translate russian kleio_birthday_date_male_5d73e419:
    kleio.say "Посмотрим, подтвердишь ли их на трассе!"

# ch/kleio/events.rpy:3773
translate russian kleio_birthday_date_male_dd150e05:
    "Мы вместе спешим к припаркованным картам."

# ch/kleio/events.rpy:3774
translate russian kleio_birthday_date_male_c4365c71:
    "И вскоре снова мчимся по трассе."

# ch/kleio/events.rpy:3776
translate russian kleio_birthday_date_male_87c58b3a:
    mike.say "Не, Клео..."

# ch/kleio/events.rpy:3777
translate russian kleio_birthday_date_male_7feee97d:
    mike.say "Пожалуй, в этот раз я пас."

# ch/kleio/events.rpy:3780
translate russian kleio_birthday_date_male_b31b00f4:
    "Клео хмурится: мой ответ её явно разочаровал."

# ch/kleio/events.rpy:3781
translate russian kleio_birthday_date_male_098fb3c9:
    "Но всё равно встаёт и направляется к трассе."

# ch/kleio/events.rpy:3782
translate russian kleio_birthday_date_male_74cf2396:
    kleio.say "Ну и хрен с тобой, скучный засранец!"

# ch/kleio/events.rpy:3783
translate russian kleio_birthday_date_male_2ddb10ee:
    kleio.say "Я бы лучше погоняла со взрослыми."

# ch/kleio/events.rpy:3784
translate russian kleio_birthday_date_male_5249a506:
    kleio.say "Но раз ты вынуждаешь меня соревноваться с детьми..."

# ch/kleio/events.rpy:3786
translate russian kleio_birthday_date_male_3189df0d:
    kleio.say "Я им башки поотшибаю и ещё поржу!"

# ch/kleio/events.rpy:3787
translate russian kleio_birthday_date_male_01465623:
    "Невольно думаю: наверное, согласиться было бы безопаснее."

# ch/kleio/events.rpy:3788
translate russian kleio_birthday_date_male_f62f9293:
    "Но решение принято, надо его придерживаться."

# ch/kleio/events.rpy:3789
translate russian kleio_birthday_date_male_ca21e973:
    "Не думаю, что Клео станет уважать меня за переменчивость."

# ch/kleio/events.rpy:3791
translate russian kleio_birthday_date_male_e280d3ed:
    "День уже подходит к тому моменту, когда картинга нам, пожалуй, хватит."

# ch/kleio/events.rpy:3792
translate russian kleio_birthday_date_male_b471de5e:
    "Если честно, мне кажется, что я накатался на всю оставшуюся жизнь!"

# ch/kleio/events.rpy:3793
translate russian kleio_birthday_date_male_d6c0f5d1:
    "На всякий случай я бросаю взгляд на Клео."

# ch/kleio/events.rpy:3794
translate russian kleio_birthday_date_male_756c405f:
    "Она тоже устала, хоть и пытается скрыть это за привычной бравадой."

# ch/kleio/events.rpy:3795
translate russian kleio_birthday_date_male_731065b0:
    mike.say "Может, пора двигаться дальше, Клео?"

# ch/kleio/events.rpy:3796
translate russian kleio_birthday_date_male_7c996e22:
    mike.say "Я уже совсем вымотался!"

# ch/kleio/events.rpy:3798
translate russian kleio_birthday_date_male_794bacfd:
    kleio.say "Ха!"

# ch/kleio/events.rpy:3799
translate russian kleio_birthday_date_male_3fea6d4e:
    kleio.say "Слабак!"

# ch/kleio/events.rpy:3800
translate russian kleio_birthday_date_male_63c1c823:
    "Я вижу, как Клео изо всех сил подавляет зевок."

# ch/kleio/events.rpy:3802
translate russian kleio_birthday_date_male_f395d1a7:
    kleio.say "Но да..."

# ch/kleio/events.rpy:3803
translate russian kleio_birthday_date_male_80328d46:
    kleio.say "Наверное, стоит дать шанс и другим."

# ch/kleio/events.rpy:3805
translate russian kleio_birthday_date_male_d59051be:
    kleio.say "Я устала, ага. Устала тебя уделывать!"

# ch/kleio/events.rpy:3809
translate russian kleio_birthday_date_male_d221f831:
    "Выходя с картодрома, Клео останавливается и оглядывается."

# ch/kleio/events.rpy:3811
translate russian kleio_birthday_date_male_1eaf91ca:
    kleio.say "Знаешь что..."

# ch/kleio/events.rpy:3812
translate russian kleio_birthday_date_male_b9b7d610:
    mike.say "Что, Клео?"

# ch/kleio/events.rpy:3813
translate russian kleio_birthday_date_male_993f04bd:
    kleio.say "Надо бы скоро попробовать настоящие гонки."

# ch/kleio/events.rpy:3814
translate russian kleio_birthday_date_male_0bebed12:
    mike.say "В смысле... на настоящих машинах?"

# ch/kleio/events.rpy:3816
translate russian kleio_birthday_date_male_4aa5ce62:
    kleio.say "Ага, именно!"

# ch/kleio/events.rpy:3817
translate russian kleio_birthday_date_male_77ab2820:
    kleio.say "Может быть очень весело."

# ch/kleio/events.rpy:3820
translate russian kleio_birthday_date_male_4a30d63e:
    "Я на миг задумываюсь, стараясь отнестись к идее серьёзно."

# ch/kleio/events.rpy:3821
translate russian kleio_birthday_date_male_29628ea2:
    "Вообще-то Клео в полноценной гоночной машине — мысль пугающая!"

# ch/kleio/events.rpy:3822
translate russian kleio_birthday_date_male_42ffab99:
    "Но люди ведь постоянно участвуют в автогонках."

# ch/kleio/events.rpy:3823
translate russian kleio_birthday_date_male_d1934d0c:
    "И какие-то меры безопасности там должны быть, верно?"

# ch/kleio/events.rpy:3824
translate russian kleio_birthday_date_male_fc13c4de:
    mike.say "Да, Клео..."

# ch/kleio/events.rpy:3825
translate russian kleio_birthday_date_male_2ca27863:
    mike.say "Думаю, это может быть весело."

# ch/kleio/events.rpy:3826
translate russian kleio_birthday_date_male_96e295ee:
    mike.say "Если только ты не предлагаешь гонки на выживание!"

# ch/kleio/events.rpy:3830
translate russian kleio_birthday_date_male_206f670b:
    "Клео фыркает и качает головой."

# ch/kleio/events.rpy:3831
translate russian kleio_birthday_date_male_4c992059:
    "Но мой ответ ей явно понравился."

# ch/kleio/events.rpy:3832
translate russian kleio_birthday_date_male_794bacfd_1:
    kleio.say "Ха!"

# ch/kleio/events.rpy:3833
translate russian kleio_birthday_date_male_66dd19a6:
    kleio.say "Я была уверена, что ты откажешься."

# ch/kleio/events.rpy:3835
translate russian kleio_birthday_date_male_36611200:
    kleio.say "Может, ты не такая уж тряпка, сердцеед!"

# ch/kleio/events.rpy:3837
translate russian kleio_birthday_date_male_a82d0b98:
    "Одна мысль о полноценной гоночной машине приводит меня в ужас."

# ch/kleio/events.rpy:3838
translate russian kleio_birthday_date_male_277f3abe:
    "Одно дело — покататься на карте."

# ch/kleio/events.rpy:3839
translate russian kleio_birthday_date_male_e4dd8f76:
    "Но на настоящей машине это же безумно опасно!"

# ch/kleio/events.rpy:3840
translate russian kleio_birthday_date_male_2956f60c:
    mike.say "О нет!"

# ch/kleio/events.rpy:3841
translate russian kleio_birthday_date_male_cf219903:
    mike.say "Ни за что, Клео!"

# ch/kleio/events.rpy:3842
translate russian kleio_birthday_date_male_f46d49bc:
    mike.say "Ты специально придумываешь, как меня угробить?!"

# ch/kleio/events.rpy:3845
translate russian kleio_birthday_date_male_3245567e:
    "Клео закатывает глаза и качает головой."

# ch/kleio/events.rpy:3846
translate russian kleio_birthday_date_male_9562dec8_1:
    kleio.say "Уф..."

# ch/kleio/events.rpy:3847
translate russian kleio_birthday_date_male_2747cd43:
    kleio.say "Забудь, что я сказала, сердцеед."

# ch/kleio/events.rpy:3848
translate russian kleio_birthday_date_male_00f4d34a:
    kleio.say "И не истери!"

# ch/kleio/events.rpy:3849
translate russian kleio_birthday_date_male_0389827d:
    mike.say "В общем..."

# ch/kleio/events.rpy:3850
translate russian kleio_birthday_date_male_ea79ae29:
    mike.say "Думаю, наше свидание официально подошло к концу, Клео."

# ch/kleio/events.rpy:3851
translate russian kleio_birthday_date_male_72bbd7df:
    mike.say "Я отлично провёл день. А ты?"

# ch/kleio/events.rpy:3853
translate russian kleio_birthday_date_male_43edcafc:
    "Клео некоторое время молча смотрит на меня."

# ch/kleio/events.rpy:3854
translate russian kleio_birthday_date_male_d9dba59a:
    "Кажется, она мысленно подводит итоги."

# ch/kleio/events.rpy:3857
translate russian kleio_birthday_date_male_98e2661c:
    kleio.say "Знаешь что, сердцеед..."

# ch/kleio/events.rpy:3858
translate russian kleio_birthday_date_male_b38c0c50:
    kleio.say "Сегодня было чертовски круто!"

# ch/kleio/events.rpy:3859
translate russian kleio_birthday_date_male_86fd3a51:
    kleio.say "Ты реально справился."

# ch/kleio/events.rpy:3860
translate russian kleio_birthday_date_male_d36048d9:
    "От её реакции я невольно улыбаюсь."

# ch/kleio/events.rpy:3861
translate russian kleio_birthday_date_male_3f528afe:
    "Такую похвалу от неё услышишь нечасто."

# ch/kleio/events.rpy:3862
translate russian kleio_birthday_date_male_30e74fc5_3:
    mike.say "Эм..."

# ch/kleio/events.rpy:3863
translate russian kleio_birthday_date_male_6757cf6b:
    mike.say "Ну..."

# ch/kleio/events.rpy:3864
translate russian kleio_birthday_date_male_1630aecc:
    mike.say "Повторим?"

# ch/kleio/events.rpy:3865
translate russian kleio_birthday_date_male_5fb04d92:
    mike.say "Может, в ближайшее время?"

# ch/kleio/events.rpy:3866
translate russian kleio_birthday_date_male_bdf7e91e:
    "Клео качает головой."

# ch/kleio/events.rpy:3868
translate russian kleio_birthday_date_male_d5e1127d:
    kleio.say "О нет..."

# ch/kleio/events.rpy:3869
translate russian kleio_birthday_date_male_a427682f:
    kleio.say "Мы ещё не закончили."

# ch/kleio/events.rpy:3870
translate russian kleio_birthday_date_male_b1377f0b:
    kleio.say "Даже близко!"

# ch/kleio/events.rpy:3871
translate russian kleio_birthday_date_male_2610ebed:
    "В следующий миг Клео хватает меня за запястье."

# ch/kleio/events.rpy:3872
translate russian kleio_birthday_date_male_4a87e0ac:
    "И куда-то тащит, даже не спросив разрешения!"

# ch/kleio/events.rpy:3875
translate russian kleio_birthday_date_male_bbbe3794_2:
    kleio.say "А..."

# ch/kleio/events.rpy:3877
translate russian kleio_birthday_date_male_92995a88:
    kleio.say "Вроде неплохо провела время."

# ch/kleio/events.rpy:3878
translate russian kleio_birthday_date_male_a3269302:
    "Не на такой ответ я надеялся."

# ch/kleio/events.rpy:3879
translate russian kleio_birthday_date_male_e7e9284c:
    "Но, похоже, большего от Клео не добиться."

# ch/kleio/events.rpy:3880
translate russian kleio_birthday_date_male_30e74fc5_4:
    mike.say "Эм..."

# ch/kleio/events.rpy:3881
translate russian kleio_birthday_date_male_6757cf6b_1:
    mike.say "Ну..."

# ch/kleio/events.rpy:3882
translate russian kleio_birthday_date_male_1630aecc_1:
    mike.say "Повторим?"

# ch/kleio/events.rpy:3883
translate russian kleio_birthday_date_male_5fb04d92_1:
    mike.say "Может, в ближайшее время?"

# ch/kleio/events.rpy:3884
translate russian kleio_birthday_date_male_c705ddc1:
    "Клео пожимает плечами и начинает уходить."

# ch/kleio/events.rpy:3886
translate russian kleio_birthday_date_male_e02f07f0:
    kleio.say "Ага, может быть..."

# ch/kleio/events.rpy:3887
translate russian kleio_birthday_date_male_a6385897:
    kleio.say "Я позвоню, ладно?"

# ch/kleio/events.rpy:3889
translate russian kleio_birthday_date_male_0a19b05b:
    "С этими словами она разворачивается и идёт дальше по улице."

# ch/kleio/events.rpy:3890
translate russian kleio_birthday_date_male_a95a5c05:
    "А я отправляюсь домой в противоположную сторону. Один."

# ch/kleio/events.rpy:3897
translate russian kleio_birthday_sex_fef05e06:
    "Я быстро узнаю район, по которому Клео меня тащит."

# ch/kleio/events.rpy:3898
translate russian kleio_birthday_sex_d2f9e1b6:
    "Он несколько суровее тех мест, где я обычно бываю."

# ch/kleio/events.rpy:3899
translate russian kleio_birthday_sex_09779013:
    "Здесь в основном гаражи и автосвалки."

# ch/kleio/events.rpy:3900
translate russian kleio_birthday_sex_33a22633:
    "Поэтому и автомастерская, где работает Клео, находится неподалёку."

# ch/kleio/events.rpy:3901
translate russian kleio_birthday_sex_cdf2cd2c:
    "Не думаю, что она собирается показывать мне местные свалки."

# ch/kleio/events.rpy:3902
translate russian kleio_birthday_sex_1446cb76:
    "Значит, скорее всего, идём именно туда."

# ch/kleio/events.rpy:3906
translate russian kleio_birthday_sex_1e252b1c:
    "И правда, Клео приводит меня прямо к мастерской."

# ch/kleio/events.rpy:3907
translate russian kleio_birthday_sex_9528cdb9:
    "Мы сворачиваем в переулок, и она открывает боковую дверь."

# ch/kleio/events.rpy:3908
translate russian kleio_birthday_sex_fb5efaa2:
    "Когда Клео включает свет, я оглядываюсь."

# ch/kleio/events.rpy:3909
translate russian kleio_birthday_sex_43652d5e:
    "В нос ударяет запах масла и других автомобильных жидкостей."

# ch/kleio/events.rpy:3910
translate russian kleio_birthday_sex_f73b6104:
    mike.say "Мы пришли, чтобы ты доделала работу, Клео?"

# ch/kleio/events.rpy:3911
translate russian kleio_birthday_sex_4c6f4384:
    mike.say "Или у тебя что-то другое на уме?"

# ch/kleio/events.rpy:3913
translate russian kleio_birthday_sex_05a4f992:
    "Клео ухмыляется, как дикая кошка."

# ch/kleio/events.rpy:3914
translate russian kleio_birthday_sex_755afa1a:
    "Вместо ответа она крадётся к машине посреди помещения."

# ch/kleio/events.rpy:3915
translate russian kleio_birthday_sex_ad5b2bd3:
    "По крайней мере, я думаю, что это машина."

# ch/kleio/events.rpy:3916
translate russian kleio_birthday_sex_ffeb05fa:
    "Очертания автомобильные, но всё скрыто под брезентом."

# ch/kleio/events.rpy:3917
translate russian kleio_birthday_sex_cba4f9a5:
    "Если там что-то другое, совпадение просто невероятное!"

# ch/kleio/events.rpy:3919
translate russian kleio_birthday_sex_14e94576:
    kleio.say "Сюда."

# ch/kleio/events.rpy:3920
translate russian kleio_birthday_sex_cfb88435:
    "Клео подзывает меня."

# ch/kleio/events.rpy:3921
translate russian kleio_birthday_sex_e3a34bc3:
    kleio.say "Иди посмотри!"

# ch/kleio/events.rpy:3922
translate russian kleio_birthday_sex_b3a5b6e6:
    "Я послушно подхожу к ней."

# ch/kleio/events.rpy:3923
translate russian kleio_birthday_sex_2d805208:
    "И тогда она театральным жестом сдёргивает брезент."

# ch/kleio/events.rpy:3925
translate russian kleio_birthday_sex_02474538:
    "Пару секунд я не могу поверить своим глазам."

# ch/kleio/events.rpy:3926
translate russian kleio_birthday_sex_5eda83a2:
    "Моргаю, тру глаза, но машина никуда не исчезает."

# ch/kleio/events.rpy:3927
translate russian kleio_birthday_sex_efb77356:
    mike.say "Клео..."

# ch/kleio/events.rpy:3928
translate russian kleio_birthday_sex_488856c4:
    mike.say "Это то, о чём я думаю?"

# ch/kleio/events.rpy:3929
translate russian kleio_birthday_sex_38c945d2:
    mike.say "Это Buccaneer Banzai?!"

# ch/kleio/events.rpy:3932
translate russian kleio_birthday_sex_ebc137f8:
    "Стоит мне назвать машину, как лицо Клео озаряется."

# ch/kleio/events.rpy:3933
translate russian kleio_birthday_sex_b0d2bd6f:
    "Она кивает, буквально сияя от восторга."

# ch/kleio/events.rpy:3934
translate russian kleio_birthday_sex_b3f33e9b:
    kleio.say "Вот, блядь, именно!"

# ch/kleio/events.rpy:3935
translate russian kleio_birthday_sex_46108f9a:
    kleio.say "Я и не думала, что когда-нибудь увижу такую."

# ch/kleio/events.rpy:3936
translate russian kleio_birthday_sex_a211ecfd:
    kleio.say "А теперь сама с ней работаю!"

# ch/kleio/events.rpy:3938
translate russian kleio_birthday_sex_b8ba714f:
    "Я смотрю на машину, скрывавшуюся под брезентом."

# ch/kleio/events.rpy:3939
translate russian kleio_birthday_sex_c6705a1f:
    "Безусловно, очень красивая."

# ch/kleio/events.rpy:3940
translate russian kleio_birthday_sex_a8aec084:
    "И очень старая, так что, наверное, дорогая."

# ch/kleio/events.rpy:3941
translate russian kleio_birthday_sex_7d022fb4:
    "Но что это за машина, я понятия не имею!"

# ch/kleio/events.rpy:3942
translate russian kleio_birthday_sex_30e74fc5:
    mike.say "Эм..."

# ch/kleio/events.rpy:3943
translate russian kleio_birthday_sex_2ed2eb68:
    mike.say "Очень красивая машина, Клео."

# ch/kleio/events.rpy:3944
translate russian kleio_birthday_sex_41bd588c:
    mike.say "Что за модель?"

# ch/kleio/events.rpy:3946
translate russian kleio_birthday_sex_39bd5d52:
    "Клео усмехается и качает головой."

# ch/kleio/events.rpy:3947
translate russian kleio_birthday_sex_323c3375:
    kleio.say "Можно было догадаться, что ты её не узнаешь, сердцеед!"

# ch/kleio/events.rpy:3949
translate russian kleio_birthday_sex_955e2694:
    kleio.say "К твоему сведению, это Buccaneer Banzai."

# ch/kleio/events.rpy:3950
translate russian kleio_birthday_sex_46108f9a_1:
    kleio.say "Я и не думала, что когда-нибудь увижу такую."

# ch/kleio/events.rpy:3952
translate russian kleio_birthday_sex_a211ecfd_1:
    kleio.say "А теперь сама с ней работаю!"

# ch/kleio/events.rpy:3953
translate russian kleio_birthday_sex_ae260c4e:
    "Я подхожу и кладу руку на капот."

# ch/kleio/events.rpy:3954
translate russian kleio_birthday_sex_eb0143e8:
    "Вблизи начинаю понимать, чем она так особенна."

# ch/kleio/events.rpy:3955
translate russian kleio_birthday_sex_f76b34cd:
    "Клео становится рядом и накрывает мою руку своей."

# ch/kleio/events.rpy:3957
translate russian kleio_birthday_sex_2e932a92:
    kleio.say "Понимаешь, сердцеед..."

# ch/kleio/events.rpy:3958
translate russian kleio_birthday_sex_47bcd623:
    kleio.say "Хозяин ни за что не даст мне на ней прокатиться."

# ch/kleio/events.rpy:3959
translate russian kleio_birthday_sex_aac20190:
    kleio.say "Поэтому, пока она здесь, хочу попробовать кое-что почти такое же приятное."

# ch/kleio/events.rpy:3960
translate russian kleio_birthday_sex_753da3a2:
    mike.say "И что же, Клео?"

# ch/kleio/events.rpy:3961
translate russian kleio_birthday_sex_08b02fa3:
    "Клео запрыгивает на капот, садится и раздвигает ноги."

# ch/kleio/events.rpy:3963
translate russian kleio_birthday_sex_9fa1f26e:
    kleio.say "Хочу, чтобы меня трахнули на капоте!"

# ch/kleio/events.rpy:3964
translate russian kleio_birthday_sex_7e693721:
    kleio.say "И хочу, чтобы это сделал ты!"

# ch/kleio/events.rpy:3965
translate russian kleio_birthday_sex_8b2d485f:
    mike.say "Конечно, Клео..."

# ch/kleio/events.rpy:3966
translate russian kleio_birthday_sex_8fb73da4:
    mike.say "Я..."

# ch/kleio/events.rpy:3967
translate russian kleio_birthday_sex_67d5b96e:
    mike.say "Угх..."

# ch/kleio/events.rpy:3969
translate russian kleio_birthday_sex_72bf43ee:
    "Она не даёт мне договорить и хватает за воротник."

# ch/kleio/events.rpy:3970
translate russian kleio_birthday_sex_4d087dad:
    "Затем рывком притягивает ближе, глядя прямо в глаза."

# ch/kleio/events.rpy:3971
translate russian kleio_birthday_sex_f158aef7:
    kleio.say "Прости, сердцеед..."

# ch/kleio/events.rpy:3972
translate russian kleio_birthday_sex_27b09f72:
    kleio.say "Я, кажется, не совсем ясно выразилась."

# ch/kleio/events.rpy:3974
translate russian kleio_birthday_sex_d1107e2a:
    kleio.say "Это была не просьба, а приказ!"

# ch/kleio/events.rpy:3979
translate russian kleio_birthday_sex_2e4f53c1:
    "Клео впивается в мои губы."

# ch/kleio/events.rpy:3980
translate russian kleio_birthday_sex_f3d17997:
    "Её язык проникает мне в рот, и она жадно целует меня."

# ch/kleio/events.rpy:3981
translate russian kleio_birthday_sex_04a1deab:
    "Одновременно тянет меня на себя, обхватив ногами за талию."

# ch/kleio/events.rpy:3982
translate russian kleio_birthday_sex_2223fb5c:
    "Я чувствую, как она сжимает мой член и возится с ширинкой."

# ch/kleio/events.rpy:3983
translate russian kleio_birthday_sex_613b8da5:
    "Но давайте кое-что проясним, ладно?"

# ch/kleio/events.rpy:3984
translate russian kleio_birthday_sex_16a81b1b:
    "Да, Клео застала меня врасплох."

# ch/kleio/events.rpy:3985
translate russian kleio_birthday_sex_60bda018:
    "Но я полностью разделяю её желание."

# ch/kleio/events.rpy:3986
translate russian kleio_birthday_sex_96b22933:
    "Как только проходит удивление, я тоже начинаю действовать."

# ch/kleio/events.rpy:3987
translate russian kleio_birthday_sex_2931e4fd:
    "Мои руки скользят по всему её телу."

# ch/kleio/events.rpy:3989
translate russian kleio_birthday_sex_08e32a42:
    "Поднимаются по бёдрам к тёплой округлости её беременного живота."

# ch/kleio/events.rpy:3991
translate russian kleio_birthday_sex_439d148e:
    "Поднимаются по бёдрам к плоскому животу."

# ch/kleio/events.rpy:3992
translate russian kleio_birthday_sex_67376552:
    "А в следующую секунду уже сжимают грудь сквозь топ."

# ch/kleio/events.rpy:3993
translate russian kleio_birthday_sex_06794088:
    "Я чувствую, как от моих прикосновений твердеют её соски."

# ch/kleio/events.rpy:3994
translate russian kleio_birthday_sex_40f24fa5:
    "От этого мой член тоже встаёт ещё быстрее."

# ch/kleio/events.rpy:3995
translate russian kleio_birthday_sex_728319ae:
    "Как и от стонов удовольствия Клео."

# ch/kleio/events.rpy:3996
translate russian kleio_birthday_sex_cbefa456:
    kleio.say "М-м-м..."

# ch/kleio/events.rpy:3997
translate russian kleio_birthday_sex_519f8c62:
    kleio.say "О да..."

# ch/kleio/events.rpy:3998
translate russian kleio_birthday_sex_d08924d7:
    kleio.say "Вот так... именно так!"

# ch/kleio/events.rpy:4001
translate russian kleio_birthday_sex_916779f4:
    "Ободрённый её словами, я начинаю стягивать с неё топ."

# ch/kleio/events.rpy:4002
translate russian kleio_birthday_sex_ee6a490c:
    "Она не сопротивляется, а помогает как может."

# ch/kleio/events.rpy:4003
translate russian kleio_birthday_sex_ce38dc52:
    "Правда, не слишком успешно: одновременно пытается вытащить мой член!"

# ch/kleio/events.rpy:4004
translate russian kleio_birthday_sex_264782c6:
    "Каким-то образом в этом переплетении рук, ног и возбуждения всё получается."

# ch/kleio/events.rpy:4006
translate russian kleio_birthday_sex_124ba35d:
    "Мы постепенно снимаем друг с друга одежду."

# ch/kleio/events.rpy:4007
translate russian kleio_birthday_sex_9428b029:
    "Почувствовав её обнажённую кожу своей, я понимаю: мы готовы."

# ch/kleio/events.rpy:4009
translate russian kleio_birthday_sex_ff90849d:
    kleio.say "Давай!"

# ch/kleio/events.rpy:4010
translate russian kleio_birthday_sex_6f1b190a:
    kleio.say "Вставь его мне в киску..."

# ch/kleio/events.rpy:4011
translate russian kleio_birthday_sex_b41c0f4b:
    kleio.say "И трахни как следует!"

# ch/kleio/events.rpy:4013
translate russian kleio_birthday_sex_2419db74:
    "Я нетерпеливо киваю, пока Клео прижимает головку моего члена к своей киске."

# ch/kleio/events.rpy:4014
translate russian kleio_birthday_sex_33dabeb0:
    "Подавшись вперёд, чувствую, какая она мокрая."

# ch/kleio/events.rpy:4015
translate russian kleio_birthday_sex_4f190183:
    "Эти ощущения и запах захватывают меня целиком."

# ch/kleio/events.rpy:4016
translate russian kleio_birthday_sex_6df8f556:
    "С этого момента подбадривать меня больше не нужно."

# ch/kleio/events.rpy:4017
translate russian kleio_birthday_sex_a21cdea4:
    "Я хватаю Клео за бёдра, впиваясь в них пальцами."

# ch/kleio/events.rpy:4019
translate russian kleio_birthday_sex_3396b7a1:
    "Затем толкаюсь вперёд и чувствую, как вхожу в неё."

# ch/kleio/events.rpy:4020
translate russian kleio_birthday_sex_8a6c22cf:
    "Киска Клео тугая, а мышцы сжимают меня так яростно, будто унаследовали её характер."

# ch/kleio/events.rpy:4021
translate russian kleio_birthday_sex_bc7c1f45:
    "Но пока она цепляется за меня, всё это чертовски приятно."

# ch/kleio/events.rpy:4022
translate russian kleio_birthday_sex_fcc26c50:
    "Проникая как можно глубже, я невольно рычу, словно зверь."

# ch/kleio/events.rpy:4023
translate russian kleio_birthday_sex_ef6e2658:
    "Голова Клео всё это время лежит у меня на плече."

# ch/kleio/events.rpy:4024
translate russian kleio_birthday_sex_45ecb595:
    "Она прерывисто дышит в такт моим толчкам."

# ch/kleio/events.rpy:4025
translate russian kleio_birthday_sex_e89e49c3:
    "И, несмотря на всю свою дерзость, становится совершенно беспомощной."

# ch/kleio/events.rpy:4027
translate russian kleio_birthday_sex_956e29f1:
    kleio.say "Д... да..."

# ch/kleio/events.rpy:4028
translate russian kleio_birthday_sex_5622a524:
    kleio.say "Вот этого я и хочу..."

# ch/kleio/events.rpy:4029
translate russian kleio_birthday_sex_f62cceca:
    kleio.say "Вот так..."

# ch/kleio/events.rpy:4030
translate russian kleio_birthday_sex_3808585c:
    "Эта сторона Клео сводит меня с ума."

# ch/kleio/events.rpy:4031
translate russian kleio_birthday_sex_fa8b258f:
    "Та, которую никто больше не видит."

# ch/kleio/events.rpy:4032
translate russian kleio_birthday_sex_9e5d6b85:
    "Внутри свирепой уличной кошки скрывается ласковая кошечка."

# ch/kleio/events.rpy:4033
translate russian kleio_birthday_sex_e807db70:
    "И я обожаю, как она мурлычет, пока я её трахаю!"

# ch/kleio/events.rpy:4034
translate russian kleio_birthday_sex_0c2d0820:
    "Наклонив голову, я прижимаюсь лицом к груди Клео."

# ch/kleio/events.rpy:4036
translate russian kleio_birthday_sex_cca26d75:
    "Дразню и покусываю соски, заставляя её вскрикивать от удовольствия."

# ch/kleio/events.rpy:4037
translate russian kleio_birthday_sex_5b6f80a1:
    "Её ягодицы всё чаще поскрипывают о капот."

# ch/kleio/events.rpy:4038
translate russian kleio_birthday_sex_5d31a462:
    "Я чувствую, как мышцы её киски начинают подрагивать и напрягаться."

# ch/kleio/events.rpy:4039
translate russian kleio_birthday_sex_ff7c34a5:
    kleio.say "Ох..."

# ch/kleio/events.rpy:4040
translate russian kleio_birthday_sex_669c5856:
    kleio.say "Ох, блядь..."

# ch/kleio/events.rpy:4041
translate russian kleio_birthday_sex_26acc6e8:
    kleio.say "Я... я сейчас кончу!"

# ch/kleio/events.rpy:4043
translate russian kleio_birthday_sex_91a0ac0f:
    "Не одна она: я изливаюсь как раз в тот момент, когда её накрывает оргазм."

# ch/kleio/events.rpy:4045
translate russian kleio_birthday_sex_be0549ea:
    "Она обвивает руками мою шею и скрещивает ноги у меня за поясницей."

# ch/kleio/events.rpy:4047
translate russian kleio_birthday_sex_a4fd27f7:
    "И всё это время цепляется за меня изо всех сил."

# ch/kleio/events.rpy:4048
translate russian kleio_birthday_sex_c02d0a82:
    "Но когда всё заканчивается, она отпускает меня и откидывается на капот."

# ch/kleio/events.rpy:4050
translate russian kleio_birthday_sex_c2cd1626:
    "Я отступаю и качаю головой."

# ch/kleio/events.rpy:4051
translate russian kleio_birthday_sex_f6967e55:
    mike.say "Вот это да..."

# ch/kleio/events.rpy:4052
translate russian kleio_birthday_sex_78820f82:
    mike.say "Фух..."

# ch/kleio/events.rpy:4053
translate russian kleio_birthday_sex_56efb026:
    mike.say "Ух, Клео..."

# ch/kleio/events.rpy:4054
translate russian kleio_birthday_sex_51457a69:
    mike.say "Кажется, мы уделали машину!"

# ch/kleio/events.rpy:4056
translate russian kleio_birthday_sex_5f011712:
    "Клео смотрит на меня, поглаживая одной рукой свою мокрую киску."

# ch/kleio/events.rpy:4057
translate russian kleio_birthday_sex_aa6d1cbd:
    "Она раскраснелась и тяжело дышит, но выглядит совершенно довольной."

# ch/kleio/events.rpy:4059
translate russian kleio_birthday_sex_0dcc9004:
    kleio.say "Да хрен с машиной, сердцеед."

# ch/kleio/events.rpy:4060
translate russian kleio_birthday_sex_487129b5:
    kleio.say "Оно того стоило."

# ch/kleio/events.rpy:4061
translate russian kleio_birthday_sex_d6c2290b:
    kleio.say "А в понедельник утром всё заполирую!"

# ch/kleio/events.rpy:4069
translate russian kleio_kiss_me_600523b5:
    "По ехидной усмешке на губах Клео кажется, что она вот-вот выплюнет очередное оскорбление."

# ch/kleio/events.rpy:4070
translate russian kleio_kiss_me_58c50aef:
    "Но она хватает меня за воротник и притягивает моё лицо к своему, отчего я удивлённо открываю рот."

# ch/kleio/events.rpy:4075
translate russian kleio_kiss_me_37d4f067:
    "Она тут же пользуется этим и без предупреждения просовывает язык между моих губ."

# ch/kleio/events.rpy:4076
translate russian kleio_kiss_me_6a57fa8b:
    "Мне нужно несколько секунд, чтобы осознать: Клео меня целует."

# ch/kleio/events.rpy:4077
translate russian kleio_kiss_me_c2a58c0d:
    "Но то, что это очень приятно, я понимаю с самого начала."

# ch/kleio/events.rpy:4078
translate russian kleio_kiss_me_9d4ec7d3:
    "И теперь меня беспокоит лишь одно: когда же это закончится..."

# ch/kleio/events.rpy:4084
translate russian kleio_say_preg_72a10a38:
    "Клео подбирает меня на углу неподалёку от дома, по своему обыкновению останавливаясь с визгом тормозов."

# ch/kleio/events.rpy:4085
translate russian kleio_say_preg_7993954e:
    "Я уже чувствую неладное: обычно она подъезжает прямо к дому, а сейчас будто не хочет, чтобы её кто-нибудь видел."

# ch/kleio/events.rpy:4086
translate russian kleio_say_preg_56ece0d4:
    "Открывая дверь, я замечаю, что меня не встречает привычный оглушительный грохот панка или метала."

# ch/kleio/events.rpy:4091
translate russian kleio_say_preg_50c73420:
    "Я едва успеваю пристегнуться, не говоря уже о том, чтобы произнести хоть слово, а Клео уже включает передачу и срывается с места."

# ch/kleio/events.rpy:4092
translate russian kleio_say_preg_c33f7d2c:
    mike.say "И тебе доброе утро!"

# ch/kleio/events.rpy:4093
translate russian kleio_say_preg_f215c9e9:
    kleio.say "Что... ты мне что-то сказал?"

# ch/kleio/events.rpy:4094
translate russian kleio_say_preg_5ab29e93:
    "Она явно отвлечена, и без того резкая езда становится ещё хуже."

# ch/kleio/events.rpy:4095
translate russian kleio_say_preg_a7c478c8:
    mike.say "Я просто пожелал доброго утра."

# ch/kleio/events.rpy:4096
translate russian kleio_say_preg_565bd323:
    kleio.say "А... ладно... как скажешь."

# ch/kleio/events.rpy:4097
translate russian kleio_say_preg_114b46d0:
    "Рассеянная, дёрганая, и ни капли привычного ядовитого сарказма."

# ch/kleio/events.rpy:4098
translate russian kleio_say_preg_ee05ad3e:
    "Даже я понимаю: сегодня утром её гложет что-то серьёзное."

# ch/kleio/events.rpy:4099
translate russian kleio_say_preg_018de506:
    mike.say "Клео, что с тобой, чёрт возьми?"

# ch/kleio/events.rpy:4100
translate russian kleio_say_preg_9f2df6e7:
    kleio.say "Да... я вроде в порядке. Просто нам нужно поговорить, вот и всё."

# ch/kleio/events.rpy:4101
translate russian kleio_say_preg_2fac9628:
    "Эти три слова, которых боится любой здравомыслящий мужчина: «Нам нужно поговорить»!"

# ch/kleio/events.rpy:4103
translate russian kleio_say_preg_186eceff:
    "Я молчу, пока Клео не находит достаточно безлюдный переулок и не паркуется."

# ch/kleio/events.rpy:4105
translate russian kleio_say_preg_f5ec0eae:
    "Сделав такой глубокий вдох, что я его слышу, она поворачивается ко мне и смотрит прямо в глаза."

# ch/kleio/events.rpy:4106
translate russian kleio_say_preg_9bde89d6:
    kleio.say "Не знаю, как это сказать, поэтому скажу прямо: я беременна."

# ch/kleio/events.rpy:4107
translate russian kleio_say_preg_57f311e4:
    "На секунду я словно перестаю понимать смысл её слов."

# ch/kleio/events.rpy:4108
translate russian kleio_say_preg_8d2ddddf:
    "Потом до меня доходит весь их вес, и я чувствую себя так, будто получил в живот и из лёгких выбило воздух."

# ch/kleio/events.rpy:4111
translate russian kleio_say_preg_30c1d3b2:
    kleio.say "Ага, примерно такой реакции я и ожидала."

# ch/kleio/events.rpy:4112
translate russian kleio_say_preg_78a807c8:
    "Пока она говорит, печаль в её глазах сменяется обидой."

# ch/kleio/events.rpy:4113
translate russian kleio_say_preg_191e2a46:
    kleio.say "Не волнуйся, я не собираюсь просить тебя остепениться и играть со мной в счастливую семью."

# ch/kleio/events.rpy:4114
translate russian kleio_say_preg_5be2bb01:
    kleio.say "Я уже позвонила кое-куда и обо всём договорилась."

# ch/kleio/events.rpy:4117
translate russian kleio_say_preg_f38530ee:
    mike.say "Ты права, так будет лучше."

# ch/kleio/events.rpy:4121
translate russian kleio_say_preg_c37d851c:
    mike.say "Не делай вид, что знаешь мои чувства. Я бы поддерживал нашего ребёнка во всём."

# ch/kleio/events.rpy:4123
translate russian kleio_say_preg_dc619d10:
    kleio.say "Ну да, конечно..."

# ch/kleio/events.rpy:4128
translate russian kleio_say_preg_22dad2f5:
    kleio.say "Блин, прости, что вот так всё на тебя вывалила."

# ch/kleio/events.rpy:4129
translate russian kleio_say_preg_c875ece6:
    "Она открывается мне, и я вижу в её глазах страх и немного надежды."

# ch/kleio/events.rpy:4130
translate russian kleio_say_preg_b70b190e:
    kleio.say "Я всегда говорила себе: если забеременею, сделаю аборт."

# ch/kleio/events.rpy:4132
translate russian kleio_say_preg_44af153f:
    kleio.say "Но это было до знакомства с тобой. А... ну, время вместе как-то изменило моё мнение."

# ch/kleio/events.rpy:4133
translate russian kleio_say_preg_2c328895:
    kleio.say "Я хочу оставить ребёнка. Но хочу, чтобы ты тоже участвовал."

# ch/kleio/events.rpy:4134
translate russian kleio_say_preg_d6563f26:
    "Я беззвучно открываю рот, как рыба на суше: всё ещё ошеломлён и не могу отдышаться."

# ch/kleio/events.rpy:4135
translate russian kleio_say_preg_51fd1e0f:
    "Клео продолжает смотреть на меня, словно не успокоится, пока не услышит нужный ответ."

# ch/kleio/events.rpy:4138
translate russian kleio_say_preg_dde25b0a:
    mike.say "Господи, Клео... нельзя вывалить на меня такое и ждать, что я сразу справлюсь!"

# ch/kleio/events.rpy:4139
translate russian kleio_say_preg_990fc2fb:
    mike.say "Я совершенно не готов быть родителем. И ты тоже!"

# ch/kleio/events.rpy:4141
translate russian kleio_say_preg_897d0283:
    "От моих слов Клео морщится, её надежды явно рушатся, но затем лицо становится жёстким."

# ch/kleio/events.rpy:4143
translate russian kleio_say_preg_47c64c02:
    kleio.say "Что ты хочешь сказать, [lssb_kleio.hero_name()]? Что я буду хреновой матерью или что у тебя на это кишка тонка?!"

# ch/kleio/events.rpy:4144
translate russian kleio_say_preg_fe4ebbee:
    mike.say "Да... нет... и то и другое... ничего из этого... я сам не знаю, что хочу сказать, чёрт!"

# ch/kleio/events.rpy:4145
translate russian kleio_say_preg_b09a0af3:
    kleio.say "Ага, может быть... но теперь я знаю, что недостаточно тебе дорога..."

# ch/kleio/events.rpy:4148
translate russian kleio_say_preg_4da4b647:
    mike.say "Да... конечно... если ты этого хочешь... ты ведь этого хочешь?!"

# ch/kleio/events.rpy:4150
translate russian kleio_say_preg_03795128:
    "Лицо Клео озаряется смесью облегчения и настоящей, неподдельной радости."

# ch/kleio/events.rpy:4151
translate russian kleio_say_preg_8a536625:
    kleio.say "Конечно хочу, придурок! Иначе разве стала бы просить?"

# ch/kleio/events.rpy:4152
translate russian kleio_say_preg_44a55a7a:
    mike.say "Прости... просто раньше я не представлял тебя в роли матери, вот и всё."

# ch/kleio/events.rpy:4154
translate russian kleio_say_preg_a1c9bc85:
    "Клео косится на меня и лукаво улыбается, уловив в моих словах невольную колкость."

# ch/kleio/events.rpy:4155
translate russian kleio_say_preg_328f0fa6:
    mike.say "Ещё раз прости... я и сам об этом никогда не думал. Но с тобой это почему-то кажется правильным."

# ch/kleio/events.rpy:4159
translate russian kleio_say_preg_42998bd5:
    "Обратно мы едем молча, каждый погрузившись в свои мысли."

# ch/kleio/events.rpy:4160
translate russian kleio_say_preg_a9fd1df8:
    "Чувствую, что за очень короткое время случилось очень многое — и скоро это сильно изменит нашу жизнь."

# ch/kleio/events.rpy:4165
translate russian kleio_practice_01_63f6813c:
    "«Битва групп» уже близко, и почти всё свободное время уходит на репетиции."

# ch/kleio/events.rpy:4166
translate russian kleio_practice_01_32c42d2a:
    "Кроме работы, еды и сна, я только и делаю, что играю, пытаюсь играть и спорю об игре."

# ch/kleio/events.rpy:4167
translate russian kleio_practice_01_1521d597:
    "Обычно оказаться запертым в комнате с тремя бойкими девушками было бы мечтой."

# ch/kleio/events.rpy:4168
translate russian kleio_practice_01_c25122b1:
    "Но в попытках довести всё до идеала наши нервы начинают сдавать."

# ch/kleio/events.rpy:4169
translate russian kleio_practice_01_46fedbe5:
    "Когда я замечаю настроение остальных, Саша кажется мрачнее обычного, а Анна, похоже, даже немного дуется за барабанами."

# ch/kleio/events.rpy:4170
translate russian kleio_practice_01_cb14e627:
    "Зато недавние встречи с Клео подогрели мой интерес к ней."

# ch/kleio/events.rpy:4171
translate russian kleio_practice_01_35b925b7:
    "В её злости я теперь вижу скорее страсть, а колючие манеры лишь сильнее притягивают меня к её порывистой натуре."

# ch/kleio/events.rpy:4173
translate russian kleio_practice_01_b0c4ee43:
    sasha.say "Эй, [lssb_kleio.hero_name()], что думаешь?"

# ch/kleio/events.rpy:4175
translate russian kleio_practice_01_a81cc301:
    "Я смотрю на Сашу, не понимая, о чём она."

# ch/kleio/events.rpy:4176
translate russian kleio_practice_01_fcbde162:
    "Я слишком увлёкся движениями Клео у микрофонной стойки, чтобы слушать."

# ch/kleio/events.rpy:4177
translate russian kleio_practice_01_e84ffc6f:
    mike.say "Что?"

# ch/kleio/events.rpy:4179
translate russian kleio_practice_01_462806c1:
    sasha.say "Господи, [lssb_kleio.hero_name()], проснись! Это важно!"

# ch/kleio/events.rpy:4181
translate russian kleio_practice_01_95829daa:
    kleio.say "Отстань от него, Саша. Мы все уже сгорели на этих репетициях."

# ch/kleio/events.rpy:4182
translate russian kleio_practice_01_40958882:
    "Я коротко улыбаюсь Клео в знак благодарности, и она отвечает лукавой, понимающей усмешкой."

# ch/kleio/events.rpy:4183
translate russian kleio_practice_01_442b0f68:
    sasha.say "Ладно, только на этот раз слушай, хорошо?"

# ch/kleio/events.rpy:4186
translate russian kleio_practice_01_d67eca8c:
    "Я киваю, предлагая повторить вопрос."

# ch/kleio/events.rpy:4187
translate russian kleio_practice_01_159dff6a:
    sasha.say "Последний проигрыш, перед финальным припевом. Думаю, нужно снова играть его как раньше."

# ch/kleio/events.rpy:4188
translate russian kleio_practice_01_9bc4513b:
    kleio.say "Ага, конечно. Раньше он был отстойным. Надо изменить и играть, как я сейчас."

# ch/kleio/events.rpy:4189
translate russian kleio_practice_01_b3cd5d2d:
    sasha.say "Ты соло-гитарист, [lssb_kleio.hero_name()]. Что думаешь?"

# ch/kleio/events.rpy:4193
translate russian kleio_practice_01_931a8db4:
    mike.say "Если вы всегда играли по варианту Саши, может, уже поздно что-то менять?"

# ch/kleio/events.rpy:4195
translate russian kleio_practice_01_72ecfbcd:
    kleio.say "Херня!"

# ch/kleio/events.rpy:4197
translate russian kleio_practice_01_7ad5c32f:
    sasha.say "Два против одного, Клео. Я победила!"

# ch/kleio/events.rpy:4198
translate russian kleio_practice_01_c350549c:
    kleio.say "Раньше было дерьмо и сейчас дерьмо! Пока не признаем это и не станем лучше, нам ничего не выиграть!"

# ch/kleio/events.rpy:4199
translate russian kleio_practice_01_5898b010:
    "Клео бросает гитару, опрокидывая стойку, и в ярости выходит на пожарную лестницу покурить."

# ch/kleio/events.rpy:4203
translate russian kleio_practice_01_69ac2bea:
    mike.say "Вариант Клео меняет настроение всей песни, делает её резче. Нам нужно выделяться."

# ch/kleio/events.rpy:4205
translate russian kleio_practice_01_43795cad:
    kleio.say "ДА!"

# ch/kleio/events.rpy:4207
translate russian kleio_practice_01_ecc57ff1:
    sasha.say "Мы всегда играли по-старому... Сейчас нет времени разучивать новый проигрыш."

# ch/kleio/events.rpy:4209
translate russian kleio_practice_01_bb2d2c57:
    kleio.say "Решает большинство, Саша. Я победила!"

# ch/kleio/events.rpy:4210
translate russian kleio_practice_01_628dca0f:
    "Клео откладывает гитару и вприпрыжку отправляется на пожарную лестницу за победной сигаретой."

# ch/kleio/events.rpy:4214
translate russian kleio_practice_01_3fa081b2:
    mike.say "Мне нравятся оба варианта... А ты что думаешь, Анна?"

# ch/kleio/events.rpy:4216
translate russian kleio_practice_01_192eb81e:
    "Анна искренне удивлена вопросом: похоже, она уже привыкла, что Саша с Клео решают подобное без неё."

# ch/kleio/events.rpy:4218
translate russian kleio_practice_01_0a9e1a3e:
    anna.say "Мне тоже оба нравятся. Может, взять что-то из одного, что-то из другого?"

# ch/kleio/events.rpy:4219
translate russian kleio_practice_01_8dc668a1:
    "Клео стонет, словно её пытают, и топает на пожарную лестницу покурить."

# ch/kleio/events.rpy:4221
translate russian kleio_practice_01_c86fd12d:
    sasha.say "Ладно, Анна... попробуем найти компромисс."

# ch/kleio/events.rpy:4225
translate russian kleio_practice_01_9fdaeb8c:
    "Я иду за Клео: переживаю, что она злится, но и сам боюсь попасть под горячую руку."

# ch/kleio/events.rpy:4227
translate russian kleio_practice_01_a9f7f602:
    "Услышав мои шаги, она оборачивается."

# ch/kleio/events.rpy:4228
translate russian kleio_practice_01_12b68e3d:
    "Стоит, прислонившись к перилам, с сигаретой в руке и выпускает облако дыма."

# ch/kleio/events.rpy:4230
translate russian kleio_practice_01_203227ce:
    mike.say "Прости, если задел тебя. Просто мне показалось, так этот проигрыш звучит лучше."

# ch/kleio/events.rpy:4232
translate russian kleio_practice_01_b566b3f4:
    "Лицо Клео привычно хмурое и пренебрежительное, но она слегка шмыгает носом. Неужели я случайно нашёл брешь в её броне?"

# ch/kleio/events.rpy:4233
translate russian kleio_practice_01_b69af6f4:
    kleio.say "Да не извиняйся, я взрослая, переживу... Просто думала, что после..."

# ch/kleio/events.rpy:4234
translate russian kleio_practice_01_37d2f28e:
    "Слова растворяются в воздухе, как сигаретный дым. Она явно надеется, что я подхвачу."

# ch/kleio/events.rpy:4235
translate russian kleio_practice_01_9ca93cc9:
    mike.say "После чего, Клео?"

# ch/kleio/events.rpy:4237
translate russian kleio_practice_01_7ef8c0c6:
    kleio.say "Ничего... забудь... просто на секунду сморозила глупость."

# ch/kleio/events.rpy:4239
translate russian kleio_practice_01_556e3e9e:
    kleio.say "Спасибо, что поддержал меня."

# ch/kleio/events.rpy:4240
translate russian kleio_practice_01_1dfe6471:
    kleio.say "Не пойми неправильно: Саша отличная басистка, но гитарный гений из неё никакой, это факт."

# ch/kleio/events.rpy:4241
translate russian kleio_practice_01_f850a101:
    mike.say "Не за что. Твой вариант был явно гораздо лучше."

# ch/kleio/events.rpy:4243
translate russian kleio_practice_01_c20604b9:
    "Клео хрипло смеётся сквозь сигаретный дым и сокращает расстояние между нами."

# ch/kleio/events.rpy:4245
translate russian kleio_practice_01_4a511cbb:
    "Обвивает руками мою шею и тесно прижимается."

# ch/kleio/events.rpy:4246
translate russian kleio_practice_01_c228da45:
    kleio.say "Кажется, при первой встрече я в тебе ошиблась. Очень жду дальнейшего сотрудничества... Если понимаешь, о чём я?"

# ch/kleio/events.rpy:4247
translate russian kleio_practice_01_6a28f986:
    "При всей её показной бунтарской натуре Клео удивительно предсказуема, когда получает желаемое и её самолюбие приятно поглаживают."

# ch/kleio/events.rpy:4251
translate russian kleio_practice_01_ce8e976e:
    mike.say "Просто хотел убедиться, что ты в порядке."

# ch/kleio/events.rpy:4253
translate russian kleio_practice_01_a3b545a7:
    "Клео немного шмыгает носом, а края век у неё покраснели."

# ch/kleio/events.rpy:4254
translate russian kleio_practice_01_e370bc5a:
    "Неужели случившееся на репетиции так задело эту с виду жёсткую девушку?"

# ch/kleio/events.rpy:4256
translate russian kleio_practice_01_7e159074:
    kleio.say "Я в порядке... правда."

# ch/kleio/events.rpy:4257
translate russian kleio_practice_01_6c3cf6e2:
    kleio.say "И то, что нам с Сашей придётся искать компромисс, тоже нормально."

# ch/kleio/events.rpy:4258
translate russian kleio_practice_01_82707675:
    mike.say "Прости, что втянул Анну в спор. Мне показалось, не мне решать всё одним голосом."

# ch/kleio/events.rpy:4259
translate russian kleio_practice_01_9cd381a4:
    kleio.say "Нет, ты прав... мы вроде как группа, значит, право голоса есть у всех."

# ch/kleio/events.rpy:4260
translate russian kleio_practice_01_6c7cce55:
    kleio.say "Просто чувствую себя немного глупо: надо же, именно тебе пришлось мне об этом напомнить!"

# ch/kleio/events.rpy:4261
translate russian kleio_practice_01_4e671c94:
    "Клео неожиданно крепко обнимает меня за талию, напоминая, как приятно ощущать её тело так близко."

# ch/kleio/events.rpy:4264
translate russian kleio_practice_01_e9a651d8:
    "Мы молча ждём, пока она докурит, и возвращаемся внутрь."

# ch/kleio/events.rpy:4265
translate russian kleio_practice_01_f9944016:
    "Переступая порог, я думаю лишь о том, сколько Клео скрывает и как мне хочется узнать её глубже."

# ch/kleio/events.rpy:4270
translate russian kleio_preg_talk_f2dbd321:
    "Я быстро замечаю, что Клео сама не своя."

# ch/kleio/events.rpy:4271
translate russian kleio_preg_talk_2fb276e4:
    "Другая девушка, возможно, стала бы язвительной или колючей."

# ch/kleio/events.rpy:4272
translate russian kleio_preg_talk_36e0ddb7:
    "Но Клео бывает такой и в хорошем настроении."

# ch/kleio/events.rpy:4273
translate russian kleio_preg_talk_de209aee:
    "Поэтому меня настораживает её непривычная молчаливость."

# ch/kleio/events.rpy:4274
translate russian kleio_preg_talk_0f6f5a7a:
    "Мне совсем не хочется, чтобы она справлялась с чем-то в одиночку."

# ch/kleio/events.rpy:4275
translate russian kleio_preg_talk_c5cb11db:
    "И я стараюсь заговорить об этом, как только выдаётся подходящий момент."

# ch/kleio/events.rpy:4276
translate russian kleio_preg_talk_647913e6:
    mike.say "Эй, Клео..."

# ch/kleio/events.rpy:4277
translate russian kleio_preg_talk_1ed3104a:
    mike.say "Что тебя гложет, а?"

# ch/kleio/events.rpy:4279
translate russian kleio_preg_talk_afbe9423:
    kleio.say "А?.."

# ch/kleio/events.rpy:4280
translate russian kleio_preg_talk_6f3bba07:
    kleio.say "О чём ты, сердцеед?"

# ch/kleio/events.rpy:4281
translate russian kleio_preg_talk_ff20472e:
    kleio.say "У меня всё нормально, как всегда."

# ch/kleio/events.rpy:4282
translate russian kleio_preg_talk_5cc1d6ff:
    "Я слегка хмурюсь."

# ch/kleio/events.rpy:4283
translate russian kleio_preg_talk_5b80765a:
    "Этого достаточно, чтобы она поняла: я не поверил."

# ch/kleio/events.rpy:4284
translate russian kleio_preg_talk_ad75e1ba:
    mike.say "Ну, Клео."

# ch/kleio/events.rpy:4285
translate russian kleio_preg_talk_2d0fd837:
    mike.say "Ты даже ни одного «блядь» не вставила!"

# ch/kleio/events.rpy:4286
translate russian kleio_preg_talk_a63624ea:
    mike.say "Будто и не пытаешься меня обмануть."

# ch/kleio/events.rpy:4287
translate russian kleio_preg_talk_3ecdc032:
    "Клео открывает рот, чтобы возразить."

# ch/kleio/events.rpy:4288
translate russian kleio_preg_talk_4bf5440e:
    "Но потом, кажется, передумывает."

# ch/kleio/events.rpy:4289
translate russian kleio_preg_talk_268d70d5:
    "Вздыхает и пожимает плечами."

# ch/kleio/events.rpy:4291
translate russian kleio_preg_talk_9f5c7dff:
    kleio.say "Наверное, ты уже слишком хорошо меня знаешь."

# ch/kleio/events.rpy:4292
translate russian kleio_preg_talk_95e9a1d9:
    kleio.say "Так просто не проведёшь."

# ch/kleio/events.rpy:4293
translate russian kleio_preg_talk_b3c78bb8:
    kleio.say "Не знаю, хорошо это или плохо!"

# ch/kleio/events.rpy:4294
translate russian kleio_preg_talk_efb77356:
    mike.say "Клео..."

# ch/kleio/events.rpy:4295
translate russian kleio_preg_talk_caebfc43:
    mike.say "Ты пытаешься сменить тему!"

# ch/kleio/events.rpy:4296
translate russian kleio_preg_talk_0eb6e1ef:
    "Клео снова вздыхает."

# ch/kleio/events.rpy:4298
translate russian kleio_preg_talk_0b508da4:
    kleio.say "Ладно, ладно..."

# ch/kleio/events.rpy:4299
translate russian kleio_preg_talk_903b9ca7:
    kleio.say "Только разговор будет невесёлый."

# ch/kleio/events.rpy:4300
translate russian kleio_preg_talk_b12bef04:
    kleio.say "Мне нужно кое-что тебе сказать..."

# ch/kleio/events.rpy:4301
translate russian kleio_preg_talk_ef930f96:
    kleio.say "Нужно сказать, что я беременна."

# ch/kleio/events.rpy:4302
translate russian kleio_preg_talk_96511db6:
    "Клео произносит это с таким трудом и напряжением..."

# ch/kleio/events.rpy:4303
translate russian kleio_preg_talk_24026703:
    "Что я ни на секунду не думаю усомниться."

# ch/kleio/events.rpy:4304
translate russian kleio_preg_talk_ba7f7e02:
    mike.say "Ого..."

# ch/kleio/events.rpy:4305
translate russian kleio_preg_talk_6e5e4549:
    mike.say "Вот этого я не ожидал..."

# ch/kleio/events.rpy:4306
translate russian kleio_preg_talk_e52fa231:
    "Клео цокает языком."

# ch/kleio/events.rpy:4307
translate russian kleio_preg_talk_44c7a282:
    "Потом кивает и невесело усмехается."

# ch/kleio/events.rpy:4309
translate russian kleio_preg_talk_86d218f7:
    kleio.say "Вот так."

# ch/kleio/events.rpy:4310
translate russian kleio_preg_talk_41fed874:
    kleio.say "Теперь ты знаешь."

# ch/kleio/events.rpy:4311
translate russian kleio_preg_talk_a9e382f1:
    kleio.say "Как и говорила: радости мало!"

# ch/kleio/events.rpy:4314
translate russian kleio_preg_talk_6619a37d:
    "Клео ошибается. Совершенно ошибается."

# ch/kleio/events.rpy:4315
translate russian kleio_preg_talk_9af34e62:
    "Просто пока этого не понимает."

# ch/kleio/events.rpy:4316
translate russian kleio_preg_talk_912f40ad:
    mike.say "Не обязательно, Клео."

# ch/kleio/events.rpy:4317
translate russian kleio_preg_talk_5bd1d043:
    mike.say "Не обязательно это плохо."

# ch/kleio/events.rpy:4319
translate russian kleio_preg_talk_1a68bd3c:
    "Клео смотрит на меня с недоумением."

# ch/kleio/events.rpy:4320
translate russian kleio_preg_talk_fc0b3512:
    "И качает головой."

# ch/kleio/events.rpy:4321
translate russian kleio_preg_talk_8eb227bd:
    kleio.say "Ч... что ты хочешь сказать?"

# ch/kleio/events.rpy:4322
translate russian kleio_preg_talk_e6bdec6b:
    kleio.say "Что нам стоит оставить ребёнка?"

# ch/kleio/events.rpy:4323
translate russian kleio_preg_talk_2bdcf378:
    mike.say "А почему нет, Клео?"

# ch/kleio/events.rpy:4324
translate russian kleio_preg_talk_9bcc7463:
    mike.say "Да, я понимаю все практические доводы против."

# ch/kleio/events.rpy:4325
translate russian kleio_preg_talk_cefd8544:
    mike.say "Но с каких пор ты живёшь, руководствуясь только ими?"

# ch/kleio/events.rpy:4327
translate russian kleio_preg_talk_54540d52:
    kleio.say "Ты вообще слышал, что я сказала, сердцеед?"

# ch/kleio/events.rpy:4328
translate russian kleio_preg_talk_dc020baa:
    kleio.say "Это не сорваться на концерт."

# ch/kleio/events.rpy:4329
translate russian kleio_preg_talk_3b288f34:
    kleio.say "Это немного серьёзнее!"

# ch/kleio/events.rpy:4330
translate russian kleio_preg_talk_4b43d789:
    mike.say "Конечно слышал, Клео."

# ch/kleio/events.rpy:4331
translate russian kleio_preg_talk_9381a783:
    mike.say "Но думаю, мы справимся."

# ch/kleio/events.rpy:4332
translate russian kleio_preg_talk_484e979e:
    mike.say "Вместе, по-моему, нам вообще всё по плечу!"

# ch/kleio/events.rpy:4334
translate russian kleio_preg_talk_3da7a8ec:
    "Клео, похоже, нечего на это возразить."

# ch/kleio/events.rpy:4335
translate russian kleio_preg_talk_5c773268:
    "Она просто молча смотрит на меня, кажется, целую вечность."

# ch/kleio/events.rpy:4336
translate russian kleio_preg_talk_fe2f4c99:
    "А когда наконец заговаривает, голос у неё тихий и серьёзный."

# ch/kleio/events.rpy:4337
translate russian kleio_preg_talk_df750465:
    kleio.say "Ты правда так думаешь?"

# ch/kleio/events.rpy:4338
translate russian kleio_preg_talk_8948e164:
    kleio.say "Ты... правда хочешь ребёнка... от МЕНЯ?!"

# ch/kleio/events.rpy:4339
translate russian kleio_preg_talk_ac9da59f:
    "Теперь уже я недоумённо качаю головой."

# ch/kleio/events.rpy:4340
translate russian kleio_preg_talk_efb77356_1:
    mike.say "Клео..."

# ch/kleio/events.rpy:4341
translate russian kleio_preg_talk_eaca306b:
    mike.say "О чём ты вообще?"

# ch/kleio/events.rpy:4342
translate russian kleio_preg_talk_e23ff751:
    mike.say "Конечно хочу."

# ch/kleio/events.rpy:4343
translate russian kleio_preg_talk_4a275c6e:
    mike.say "Я ведь люблю тебя, господи!"

# ch/kleio/events.rpy:4345
translate russian kleio_preg_talk_7d77c357:
    "Клео кивает и кладёт голову мне на плечо."

# ch/kleio/events.rpy:4346
translate russian kleio_preg_talk_a9721423:
    "Мне не нужно говорить, чтобы я её обнял."

# ch/kleio/events.rpy:4348
translate russian kleio_preg_talk_4fe848cc:
    kleio.say "Ох, сердцеед..."

# ch/kleio/events.rpy:4349
translate russian kleio_preg_talk_a5ce4969:
    kleio.say "Я не заслуживаю такого парня, как ты!"

# ch/kleio/events.rpy:4350
translate russian kleio_preg_talk_89924b1d:
    mike.say "Заслуживаешь, Клео."

# ch/kleio/events.rpy:4351
translate russian kleio_preg_talk_3514bdf3:
    mike.say "Ещё как заслуживаешь..."

# ch/kleio/events.rpy:4355
translate russian kleio_preg_talk_791c3bfd:
    "Клео права: это может омрачить нам всё."

# ch/kleio/events.rpy:4356
translate russian kleio_preg_talk_38c8dcb7:
    "Мы ведь даже с грёбаным презервативом не разобрались."

# ch/kleio/events.rpy:4357
translate russian kleio_preg_talk_b1579c45:
    "Как же мы вдвоём вырастим ребёнка?"

# ch/kleio/events.rpy:4358
translate russian kleio_preg_talk_080bb09c:
    mike.say "Да, невесело, Клео."

# ch/kleio/events.rpy:4359
translate russian kleio_preg_talk_1ccb53f7:
    mike.say "Мы не можем стать родителями."

# ch/kleio/events.rpy:4360
translate russian kleio_preg_talk_ccaaac9b:
    mike.say "Мы за собой-то едва умеем ухаживать!"

# ch/kleio/events.rpy:4361
translate russian kleio_preg_talk_3b81fe60:
    "Клео кивает."

# ch/kleio/events.rpy:4362
translate russian kleio_preg_talk_2ee27367:
    "Но мой ответ всё же её огорчает."

# ch/kleio/events.rpy:4364
translate russian kleio_preg_talk_eeda48e3:
    kleio.say "Ты прав."

# ch/kleio/events.rpy:4365
translate russian kleio_preg_talk_fa0bf0b1:
    kleio.say "Я и сама так думала."

# ch/kleio/events.rpy:4366
translate russian kleio_preg_talk_90b6c0b6:
    kleio.say "Просто..."

# ch/kleio/events.rpy:4367
translate russian kleio_preg_talk_1ca2bd3d:
    kleio.say "Просто хотела услышать это от тебя, вот и всё."

# ch/kleio/events.rpy:4368
translate russian kleio_preg_talk_3d9c6b4d:
    "Похоже, Клео была не так уверена, как пыталась показать."

# ch/kleio/events.rpy:4369
translate russian kleio_preg_talk_fa0e908c:
    "Но это не меняет того, что сейчас мы не можем создать семью."

# ch/kleio/events.rpy:4370
translate russian kleio_preg_talk_ddff0bbf:
    mike.say "Думаю, так правильно, Клео."

# ch/kleio/events.rpy:4371
translate russian kleio_preg_talk_4efd298b:
    mike.say "Может, в будущем мы будем готовы к детям."

# ch/kleio/events.rpy:4372
translate russian kleio_preg_talk_d162215f:
    mike.say "Но сейчас мы на это не готовы."

# ch/kleio/events.rpy:4374
translate russian kleio_preg_talk_7d77c357_1:
    "Клео кивает и кладёт голову мне на плечо."

# ch/kleio/events.rpy:4375
translate russian kleio_preg_talk_a9721423_1:
    "Мне не нужно говорить, чтобы я её обнял."

# ch/kleio/events.rpy:4376
translate russian kleio_preg_talk_fc214327:
    "Сейчас ей нужна вся поддержка, которую я могу дать."

# ch/kleio/events.rpy:4382
translate russian kleio_meet_bree_28ae639b:
    "День выдался тяжёлый: разом навалились и работа, и учёба."

# ch/kleio/events.rpy:4383
translate russian kleio_meet_bree_8df70b60:
    "Мне нужно отдохнуть, поэтому я направляюсь прямиком в паб."

# ch/kleio/events.rpy:4384
translate russian kleio_meet_bree_ac6b11bc:
    "Едва оказавшись внутри, чувствую, как напряжение начинает отпускать."

# ch/kleio/events.rpy:4385
translate russian kleio_meet_bree_e72b6360:
    "Из музыкального автомата доносится неплохая музыка, в воздухе гудят негромкие разговоры."

# ch/kleio/events.rpy:4386
translate russian kleio_meet_bree_fdb71a4e:
    "Беру выпивку и оглядываюсь в поисках места, куда пристроить задницу."

# ch/kleio/events.rpy:4387
translate russian kleio_meet_bree_6058448b:
    bree.say "Эй, [lssb_kleio.hero_name()]!"

# ch/kleio/events.rpy:4388
translate russian kleio_meet_bree_676c9127:
    bree.say "Составь мне компанию!"

# ch/kleio/events.rpy:4389
translate russian kleio_meet_bree_67f6b9a4:
    "Я сразу узнаю голос: [bree.name]."

# ch/kleio/events.rpy:4391
translate russian kleio_meet_bree_64064a1e:
    "И вижу, как она идёт ко мне."

# ch/kleio/events.rpy:4393
translate russian kleio_meet_bree_e3e15182:
    kleio.say "Эй, сердцеед!"

# ch/kleio/events.rpy:4394
translate russian kleio_meet_bree_f0d5c960:
    kleio.say "Ты что здесь делаешь?"

# ch/kleio/events.rpy:4395
translate russian kleio_meet_bree_48eaec8f:
    "Через секунду я резко поворачиваю голову в другую сторону."

# ch/kleio/events.rpy:4397
translate russian kleio_meet_bree_74739a1c:
    "И вижу Клео, которая тоже пробивается ко мне локтями."

# ch/kleio/events.rpy:4399
translate russian kleio_meet_bree_b8d35d85:
    "Понятия не имею, как быть."

# ch/kleio/events.rpy:4400
translate russian kleio_meet_bree_ceb3405f:
    "С двух сторон ко мне подходят две девушки."

# ch/kleio/events.rpy:4401
translate russian kleio_meet_bree_5ec7be87:
    "И, похоже, ни одна не заметила другую."

# ch/kleio/events.rpy:4402
translate russian kleio_meet_bree_ea1cafcb:
    bree.say "Ты почему меня игнорируешь?!"

# ch/kleio/events.rpy:4403
translate russian kleio_meet_bree_a5c90656:
    kleio.say "Эй, тупица, я к тебе обращаюсь!"

# ch/kleio/events.rpy:4404
translate russian kleio_meet_bree_7362e296:
    "Я отступаю на шаг."

# ch/kleio/events.rpy:4408
translate russian kleio_meet_bree_800c0794:
    "И они наконец видят друг друга."

# ch/kleio/events.rpy:4412
translate russian kleio_meet_bree_cd456f95:
    bree.say "О!"

# ch/kleio/events.rpy:4413
translate russian kleio_meet_bree_38ae7f9d:
    kleio.say "А?!"

# ch/kleio/events.rpy:4414
translate russian kleio_meet_bree_7e93febc:
    mike.say "[bree.name], познакомься: Клео."

# ch/kleio/events.rpy:4415
translate russian kleio_meet_bree_455d496c:
    mike.say "Клео, это [bree.name]."

# ch/kleio/events.rpy:4416
translate russian kleio_meet_bree_a4dd6ab6:
    "Обе, разумеется, удивлены."

# ch/kleio/events.rpy:4417
translate russian kleio_meet_bree_f07cca1d:
    "Но быстро понимают, что происходит."

# ch/kleio/events.rpy:4418
translate russian kleio_meet_bree_6dccdb4e:
    "Не подумайте, я себе не льщу."

# ch/kleio/events.rpy:4419
translate russian kleio_meet_bree_cdcc68ee:
    "Просто каждая рассчитывала заполучить меня целиком."

# ch/kleio/events.rpy:4420
translate russian kleio_meet_bree_a89f069d:
    "Даже если лишь ради дружеской выпивки."

# ch/kleio/events.rpy:4423
translate russian kleio_meet_bree_3b8532e9:
    "[bree.name] и Клео оценивают друг друга, словно кошки, делящие территорию."

# ch/kleio/events.rpy:4424
translate russian kleio_meet_bree_7f47f7e6:
    "Первой молчание нарушает [bree.name]."

# ch/kleio/events.rpy:4426
translate russian kleio_meet_bree_3df7065f:
    bree.say "Клео..."

# ch/kleio/events.rpy:4427
translate russian kleio_meet_bree_63950b00:
    bree.say "Ты ведь одна из девушек в группе Саши?"

# ch/kleio/events.rpy:4428
translate russian kleio_meet_bree_a8b4c563:
    "Я вижу, как Клео ощетинивается."

# ch/kleio/events.rpy:4430
translate russian kleio_meet_bree_1deedd88:
    kleio.say "Ты хотела сказать, мы играем в одной группе."

# ch/kleio/events.rpy:4433
translate russian kleio_meet_bree_f947f10e:
    kleio.say "Это не группа Саши!"

# ch/kleio/events.rpy:4435
translate russian kleio_meet_bree_152e36e7:
    kleio.say "Значит, ты её соседка, да?"

# ch/kleio/events.rpy:4437
translate russian kleio_meet_bree_dec00a96:
    bree.say "Я... да, наверное!"

# ch/kleio/events.rpy:4438
translate russian kleio_meet_bree_16c80ec3:
    bree.say "Полагаю, Саша тебе уже всё обо мне рассказала!"

# ch/kleio/events.rpy:4439
translate russian kleio_meet_bree_e44926b8:
    kleio.say "А... пару раз твоё имя упоминала."

# ch/kleio/events.rpy:4440
translate russian kleio_meet_bree_4a4cbdc1:
    "[bree.name] удивлённо моргает от резкости Клео."

# ch/kleio/events.rpy:4441
translate russian kleio_meet_bree_7354397e:
    "Я понимаю: она к этому не привыкла, в отличие от меня."

# ch/kleio/events.rpy:4442
translate russian kleio_meet_bree_c137d5f5:
    "Надо вмешаться, пока Клео не сказала что-нибудь, о чём мы все пожалеем!"

# ch/kleio/events.rpy:4445
translate russian kleio_meet_bree_79690f78:
    mike.say "А у меня идея..."

# ch/kleio/events.rpy:4446
translate russian kleio_meet_bree_e44960da:
    mike.say "Давайте вместе займём столик."

# ch/kleio/events.rpy:4447
translate russian kleio_meet_bree_e48d8111:
    mike.say "Поболтаем, а?"

# ch/kleio/events.rpy:4448
translate russian kleio_meet_bree_4f722734:
    mike.say "Познакомимся поближе?"

# ch/kleio/events.rpy:4449
translate russian kleio_meet_bree_5a15aeb7:
    "Смотрю по очереди на [bree.name] и Клео в надежде на согласие."

# ch/kleio/events.rpy:4452
translate russian kleio_meet_bree_0d042705:
    "Но по лицам обеих видно: идея их не убедила."

# ch/kleio/events.rpy:4454
translate russian kleio_meet_bree_ec4f9c86:
    bree.say "Эм..."

# ch/kleio/events.rpy:4455
translate russian kleio_meet_bree_f13852fc:
    bree.say "Я вообще хотела спросить, не поиграешь ли ты со мной в автоматы."

# ch/kleio/events.rpy:4456
translate russian kleio_meet_bree_33a860c0:
    bree.say "Вон там есть Bronze Chopper!"

# ch/kleio/events.rpy:4457
translate russian kleio_meet_bree_b790fcb2:
    "Я смотрю туда, куда указывает [bree.name]."

# ch/kleio/events.rpy:4458
translate russian kleio_meet_bree_aac5cd75:
    "Звучит очень заманчиво!"

# ch/kleio/events.rpy:4460
translate russian kleio_meet_bree_9562dec8:
    kleio.say "Фу..."

# ch/kleio/events.rpy:4462
translate russian kleio_meet_bree_22c34e24:
    kleio.say "Скукотища!"

# ch/kleio/events.rpy:4464
translate russian kleio_meet_bree_1f1f6ead:
    kleio.say "Я хочу в бильярд, сердцеед!"

# ch/kleio/events.rpy:4465
translate russian kleio_meet_bree_39947744:
    "Клео указывает большим пальцем через плечо на свободный бильярдный стол."

# ch/kleio/events.rpy:4466
translate russian kleio_meet_bree_e95a5492:
    "Теперь я разрываюсь: это тоже звучит весело."

# ch/kleio/events.rpy:4467
translate russian kleio_meet_bree_513f084a:
    "Особенно возможность посмотреть, как Клео наклоняется над столом!"

# ch/kleio/events.rpy:4470
translate russian kleio_meet_bree_9b644fb2:
    bree.say "Ты ведь хочешь поиграть со мной?"

# ch/kleio/events.rpy:4471
translate russian kleio_meet_bree_64397140:
    kleio.say "Не, ты же хочешь со мной, правда?"

# ch/kleio/events.rpy:4472
translate russian kleio_meet_bree_83e05a06:
    "Чёрт, похоже, придётся выбрать одну из них!"

# ch/kleio/events.rpy:4475
translate russian kleio_meet_bree_9327738e:
    "Бильярд с Клео меня очень привлекает."

# ch/kleio/events.rpy:4476
translate russian kleio_meet_bree_44da8551:
    "И да, в игры можно поиграть дома на Zbox."

# ch/kleio/events.rpy:4477
translate russian kleio_meet_bree_458e27cd:
    "Но настоящий старый аркадный автомат — совсем другое дело!"

# ch/kleio/events.rpy:4478
translate russian kleio_meet_bree_304852c5:
    "Да ещё и [bree.name] будет играть рядом."

# ch/kleio/events.rpy:4479
translate russian kleio_meet_bree_8ce4d8fa:
    mike.say "Может, чуть позже успеем в бильярд, Клео?"

# ch/kleio/events.rpy:4481
translate russian kleio_meet_bree_744fbe74:
    mike.say "Но сначала мне нужно скормить этому автомату немного монет!"

# ch/kleio/events.rpy:4483
translate russian kleio_meet_bree_56228382:
    "Мой выбор сразу раздражает Клео."

# ch/kleio/events.rpy:4484
translate russian kleio_meet_bree_58ca9198:
    "Она хмурится и скрещивает руки на груди."

# ch/kleio/events.rpy:4487
translate russian kleio_meet_bree_8dc5de36:
    kleio.say "Что?!"

# ch/kleio/events.rpy:4488
translate russian kleio_meet_bree_84c2b11d:
    kleio.say "Ты издеваешься?"

# ch/kleio/events.rpy:4490
translate russian kleio_meet_bree_3fd1259b:
    "[bree.name] реагирует куда сдержаннее."

# ch/kleio/events.rpy:4491
translate russian kleio_meet_bree_7de844bb:
    "Но я всё равно вижу самодовольство в её улыбке."

# ch/kleio/events.rpy:4492
translate russian kleio_meet_bree_32e96994:
    "Она встряхивает головой, и волосы переливаются на свету."

# ch/kleio/events.rpy:4493
translate russian kleio_meet_bree_bc38b264:
    "Клянусь, Клео замечает, как я любуюсь длинными золотистыми волосами, которыми тряхнула [bree.name]!"

# ch/kleio/events.rpy:4494
translate russian kleio_meet_bree_be1e8972:
    "Она... она правда ревнует?"

# ch/kleio/events.rpy:4495
translate russian kleio_meet_bree_4e3e00c9:
    "Нет... не может быть."

# ch/kleio/events.rpy:4496
translate russian kleio_meet_bree_7e53d5fe:
    "Мы ведь о Клео говорим!"

# ch/kleio/events.rpy:4498
translate russian kleio_meet_bree_b51bf36d:
    bree.say "Пойдём, [lssb_kleio.hero_name()]!"

# ch/kleio/events.rpy:4499
translate russian kleio_meet_bree_a8f232ab:
    bree.say "Хочу играть, пока руки не заболят!"

# ch/kleio/events.rpy:4501
translate russian kleio_meet_bree_033396dc:
    kleio.say "Ну и ладно, ну и ладно..."

# ch/kleio/events.rpy:4502
translate russian kleio_meet_bree_7d6b125f:
    kleio.say "Да пошли вы, неудачники!"

# ch/kleio/events.rpy:4503
translate russian kleio_meet_bree_2a2b99b9:
    "Мне кажется, нужно что-то сказать Клео."

# ch/kleio/events.rpy:4505
translate russian kleio_meet_bree_10b8c1cb:
    "Но она уже уходит в другой конец паба."

# ch/kleio/events.rpy:4506
translate russian kleio_meet_bree_8a3aa727:
    "Оборачиваюсь — а [bree.name] уже кормит автомат монетами."

# ch/kleio/events.rpy:4507
translate russian kleio_meet_bree_620b618c:
    "Я спешу к ней и вскоре совсем забываю о Клео."

# ch/kleio/events.rpy:4510
translate russian kleio_meet_bree_7c4564dd:
    "Мне очень нравится мысль поиграть с [bree.name] в ретроигры."

# ch/kleio/events.rpy:4511
translate russian kleio_meet_bree_87de0bf5:
    "Но на домашней Zbox я могу играть сколько угодно."

# ch/kleio/events.rpy:4512
translate russian kleio_meet_bree_c67f8b14:
    "А вот бильярдного стола дома нет."

# ch/kleio/events.rpy:4513
translate russian kleio_meet_bree_483ef6f6:
    "Как и задницы Клео!"

# ch/kleio/events.rpy:4514
translate russian kleio_meet_bree_d838491b:
    mike.say "На Zbox мы и дома поиграем, [bree.name]."

# ch/kleio/events.rpy:4515
translate russian kleio_meet_bree_3921382f:
    mike.say "Давай уж здесь сыграем в бильярд с Клео?"

# ch/kleio/events.rpy:4516
translate russian kleio_meet_bree_45114ac3:
    "[bree.name] сразу же выглядит разочарованной моим выбором."

# ch/kleio/events.rpy:4517
translate russian kleio_meet_bree_6c62b7cf:
    "Зато Клео победно вскидывает кулак."

# ch/kleio/events.rpy:4518
translate russian kleio_meet_bree_e1a194e8:
    "Она никогда не умела достойно ни выигрывать, ни проигрывать!"

# ch/kleio/events.rpy:4521
translate russian kleio_meet_bree_43795cad:
    kleio.say "ДА!"

# ch/kleio/events.rpy:4522
translate russian kleio_meet_bree_ac65627c:
    kleio.say "Вот это разумный выбор!"

# ch/kleio/events.rpy:4523
translate russian kleio_meet_bree_e7520345:
    kleio.say "Пойдёмте, сыграю против вас обоих!"

# ch/kleio/events.rpy:4526
translate russian kleio_meet_bree_af00e3c7:
    bree.say "Не, пожалуй, я пас."

# ch/kleio/events.rpy:4527
translate russian kleio_meet_bree_bd1937bb:
    bree.say "А вы повеселитесь."

# ch/kleio/events.rpy:4528
translate russian kleio_meet_bree_1c1f5be9:
    bree.say "Увидимся потом дома, [lssb_kleio.hero_name()]."

# ch/kleio/events.rpy:4529
translate russian kleio_meet_bree_d244afa2:
    "Мне кажется, нужно что-то сказать, пока [bree.name] ещё здесь."

# ch/kleio/events.rpy:4531
translate russian kleio_meet_bree_10b8c1cb_1:
    "Но она уже уходит в другой конец паба."

# ch/kleio/events.rpy:4532
translate russian kleio_meet_bree_125d5f51:
    "А когда я оборачиваюсь, Клео как раз наклоняется над столом, расставляя шары."

# ch/kleio/events.rpy:4533
translate russian kleio_meet_bree_b58eae4a:
    "После такого зрелища [bree.name] быстро вылетает у меня из головы."

# ch/kleio/events.rpy:4538
translate russian kleio_twintails_01_470001bc:
    "Я уже довольно хорошо знаю Клео и знаком со всеми её маленькими причудами и привычками."

# ch/kleio/events.rpy:4539
translate russian kleio_twintails_01_01ba642c:
    "Но сегодня едва увидев её, сразу понимаю: что-то случилось, что-то её тревожит."

# ch/kleio/events.rpy:4540
translate russian kleio_twintails_01_99c749ea:
    "Большинство людей, когда мысли заняты другим, становятся раздражительными или уклончивыми."

# ch/kleio/events.rpy:4541
translate russian kleio_twintails_01_759f6080:
    "Проблема в том, что Клео и без того вечно язвит и колется!"

# ch/kleio/events.rpy:4542
translate russian kleio_twintails_01_5adb24d1:
    "Так что, когда она замолкает и непрерывный поток оскорблений иссякает, это верный признак."

# ch/kleio/events.rpy:4543
translate russian kleio_twintails_01_c38957ff:
    mike.say "Эм, Клео..."

# ch/kleio/events.rpy:4544
translate russian kleio_twintails_01_3d5fad7c:
    mike.say "У тебя сейчас всё нормально?"

# ch/kleio/events.rpy:4545
translate russian kleio_twintails_01_a789907c:
    mike.say "Ну, в целом?"

# ch/kleio/events.rpy:4548
translate russian kleio_twintails_01_0e0d4cd9:
    kleio.say "ЧТО?!"

# ch/kleio/events.rpy:4549
translate russian kleio_twintails_01_19848538:
    kleio.say "Это что ещё значит?"

# ch/kleio/events.rpy:4551
translate russian kleio_twintails_01_8aa8bd8e:
    mike.say "Может, ты хочешь о чём-нибудь поговорить?"

# ch/kleio/events.rpy:4552
translate russian kleio_twintails_01_2b8f9bf2:
    mike.say "О чём угодно?"

# ch/kleio/events.rpy:4553
translate russian kleio_twintails_01_206f670b:
    "Клео фыркает и качает головой."

# ch/kleio/events.rpy:4555
translate russian kleio_twintails_01_fe0fb152:
    kleio.say "Конечно нет!"

# ch/kleio/events.rpy:4556
translate russian kleio_twintails_01_f3704c13:
    kleio.say "Что за дурацкий вопрос!"

# ch/kleio/events.rpy:4557
translate russian kleio_twintails_01_670999b1:
    "Я поднимаю руки и киваю, закрывая тему."

# ch/kleio/events.rpy:4559
translate russian kleio_twintails_01_8821563c:
    "Но вижу, что сама Клео её отпускать не собирается."

# ch/kleio/events.rpy:4560
translate russian kleio_twintails_01_456f3b4f:
    "Она отводит глаза и хмурится, словно собирается что-то сказать."

# ch/kleio/events.rpy:4561
translate russian kleio_twintails_01_ad5aa097:
    kleio.say "[lssb_kleio.hero_name()]..."

# ch/kleio/events.rpy:4562
translate russian kleio_twintails_01_127e542c:
    "Так, началось."

# ch/kleio/events.rpy:4563
translate russian kleio_twintails_01_0e730e57:
    "Если Клео зовёт меня настоящим именем, дело серьёзное!"

# ch/kleio/events.rpy:4564
translate russian kleio_twintails_01_fc13c4de:
    mike.say "Да, Клео..."

# ch/kleio/events.rpy:4565
translate russian kleio_twintails_01_6fb1d89d:
    kleio.say "Я... вообще-то хотела кое о чём поговорить."

# ch/kleio/events.rpy:4566
translate russian kleio_twintails_01_8a7f06d5:
    kleio.say "Хотела кое-что спросить."

# ch/kleio/events.rpy:4567
translate russian kleio_twintails_01_b0441445:
    kleio.say "Но это прозвучит глупо, я точно знаю!"

# ch/kleio/events.rpy:4568
translate russian kleio_twintails_01_8f4c346c:
    "Клео крайне редко вот так мне открывается."

# ch/kleio/events.rpy:4569
translate russian kleio_twintails_01_37db5a75:
    "Нужно быть осторожным и помочь ей решиться."

# ch/kleio/events.rpy:4570
translate russian kleio_twintails_01_906bac50:
    mike.say "Ладно, Клео..."

# ch/kleio/events.rpy:4571
translate russian kleio_twintails_01_93f7861a:
    mike.say "Давай договоримся."

# ch/kleio/events.rpy:4572
translate russian kleio_twintails_01_64e61bbb:
    mike.say "Ты задашь вопрос."

# ch/kleio/events.rpy:4573
translate russian kleio_twintails_01_0c448169:
    mike.say "А если он глупый, забудем, что ты его задавала, хорошо?"

# ch/kleio/events.rpy:4574
translate russian kleio_twintails_01_acfaaaa3:
    mike.say "Обещаю больше никогда об этом не вспоминать."

# ch/kleio/events.rpy:4576
translate russian kleio_twintails_01_f78014f5:
    "Клео смотрит искоса, всё ещё немного хмурясь."

# ch/kleio/events.rpy:4577
translate russian kleio_twintails_01_5df48b3f:
    "Но я вижу: предложение уже начинает ей нравиться."

# ch/kleio/events.rpy:4579
translate russian kleio_twintails_01_d4f311d2:
    "Через мгновение она согласно кивает."

# ch/kleio/events.rpy:4580
translate russian kleio_twintails_01_0b508da4:
    kleio.say "Ладно, ладно..."

# ch/kleio/events.rpy:4582
translate russian kleio_twintails_01_dbaefec9:
    kleio.say "Только не говори, что это не глупо, если глупо, ясно?"

# ch/kleio/events.rpy:4583
translate russian kleio_twintails_01_d7d8ebe9:
    kleio.say "Я пойму, что ты врёшь!"

# ch/kleio/events.rpy:4584
translate russian kleio_twintails_01_c4a3b258:
    mike.say "Буду честен, Клео."

# ch/kleio/events.rpy:4585
translate russian kleio_twintails_01_ad1e36ec:
    mike.say "Беспощадно честен, обещаю!"

# ch/kleio/events.rpy:4587
translate russian kleio_twintails_01_0cbcaf41:
    "Она всё ещё не выглядит полностью убеждённой."

# ch/kleio/events.rpy:4588
translate russian kleio_twintails_01_0a4839f5:
    "Но всё же глубоко вдыхает и задаёт вопрос."

# ch/kleio/events.rpy:4590
translate russian kleio_twintails_01_1d9184bf:
    kleio.say "Тебе..."

# ch/kleio/events.rpy:4591
translate russian kleio_twintails_01_418fc156:
    kleio.say "Тебе нравятся длинные волосы?"

# ch/kleio/events.rpy:4592
translate russian kleio_twintails_01_2d7148cd:
    "Теперь уже я хмурюсь: такого вопроса я не ожидал."

# ch/kleio/events.rpy:4593
translate russian kleio_twintails_01_b3881ddd:
    "Качаю головой и пожимаю плечами, подбирая ответ."

# ch/kleio/events.rpy:4594
translate russian kleio_twintails_01_6037b9fd:
    "И ответ должен быть честным, иначе мне не поздоровится!"

# ch/kleio/events.rpy:4595
translate russian kleio_twintails_01_723068bc:
    mike.say "Наверное, да, Клео."

# ch/kleio/events.rpy:4596
translate russian kleio_twintails_01_875f6818:
    mike.say "Выглядят вроде круто."

# ch/kleio/events.rpy:4597
translate russian kleio_twintails_01_b611f46f:
    mike.say "Думаешь, мне стоит отрастить?"

# ch/kleio/events.rpy:4598
translate russian kleio_twintails_01_88d50903:
    mike.say "Ты об этом?"

# ch/kleio/events.rpy:4600
translate russian kleio_twintails_01_516c210f:
    kleio.say "Нет, безнадёжный придурок!"

# ch/kleio/events.rpy:4601
translate russian kleio_twintails_01_207ac0c0:
    kleio.say "Я о девушках!"

# ch/kleio/events.rpy:4602
translate russian kleio_twintails_01_1afa5aa1:
    kleio.say "Тебе нравятся длинные волосы у девушек?!"

# ch/kleio/events.rpy:4604
translate russian kleio_twintails_01_0795e1d5:
    "Я смотрю на Клео, удивлённо моргая."

# ch/kleio/events.rpy:4605
translate russian kleio_twintails_01_cba859ef:
    "А она смотрит на меня из-под короткой рваной чёлки."

# ch/kleio/events.rpy:4606
translate russian kleio_twintails_01_a8eae8f6:
    "Трудно объяснить, насколько странно для меня звучит этот вопрос."

# ch/kleio/events.rpy:4607
translate russian kleio_twintails_01_f0105feb:
    "Ведь обычно Клео так уверена в себе."

# ch/kleio/events.rpy:4608
translate russian kleio_twintails_01_ba66da15:
    "Я бы никогда не осмелился указывать ей, что в себе менять."

# ch/kleio/events.rpy:4610
translate russian kleio_twintails_01_f4e43ba9:
    kleio.say "Ну?!"

# ch/kleio/events.rpy:4611
translate russian kleio_twintails_01_8ead9abe:
    kleio.say "Нравятся или нет?!"

# ch/kleio/events.rpy:4612
translate russian kleio_twintails_01_79acbb21:
    mike.say "Не пойми неправильно, Клео..."

# ch/kleio/events.rpy:4613
translate russian kleio_twintails_01_3013fa8f:
    mike.say "Короткие волосы отлично смотрятся на девушках."

# ch/kleio/events.rpy:4614
translate russian kleio_twintails_01_6b7ca174:
    mike.say "Но в длинных есть какое-то классическое очарование, понимаешь?"

# ch/kleio/events.rpy:4615
translate russian kleio_twintails_01_c057ccda:
    mike.say "Может, они выглядят чуть изысканнее?"

# ch/kleio/events.rpy:4617
translate russian kleio_twintails_01_ac4377c2:
    "Я жду, что Клео взорвётся от злости."

# ch/kleio/events.rpy:4618
translate russian kleio_twintails_01_db670fd2:
    "Но вместо этого она задумчиво обдумывает мой ответ."

# ch/kleio/events.rpy:4619
translate russian kleio_twintails_01_c07772d7:
    kleio.say "Хм..."

# ch/kleio/events.rpy:4620
translate russian kleio_twintails_01_e2863f85:
    kleio.say "Изысканнее, значит?"

# ch/kleio/events.rpy:4621
translate russian kleio_twintails_01_b561565b:
    kleio.say "Интересно... очень интересно."

# ch/kleio/events.rpy:4622
translate russian kleio_twintails_01_1ee44c7f:
    "Пока она говорит, я продолжаю смотреть на неё."

# ch/kleio/events.rpy:4623
translate russian kleio_twintails_01_40d3d845:
    "Потому что жду ещё одного вопроса."

# ch/kleio/events.rpy:4624
translate russian kleio_twintails_01_7c53c69c:
    "Или хотя бы просьбы объяснить подробнее."

# ch/kleio/events.rpy:4625
translate russian kleio_twintails_01_60699c55:
    "Но Клео, кажется, погружается в свои мысли."

# ch/kleio/events.rpy:4626
translate russian kleio_twintails_01_3a7bc0c3:
    "И я стараюсь забыть об этом разговоре."

# ch/kleio/events.rpy:4627
translate russian kleio_twintails_01_53bdc4e4:
    "Что бы ни было у неё на уме, расскажет, когда будет готова."

# ch/kleio/events.rpy:4628
translate russian kleio_twintails_01_fd46061f:
    "Или вообще не расскажет."

# ch/kleio/events.rpy:4629
translate russian kleio_twintails_01_178865ad:
    "В любом случае дразнить зверя я не собираюсь!"

# ch/kleio/events.rpy:4635
translate russian kleio_twintails_02_294cc446:
    "Знаю, девушки постоянно злятся на парней, которые не замечают их новую причёску."

# ch/kleio/events.rpy:4636
translate russian kleio_twintails_02_41e34cdf:
    "Но иногда перемена во внешности настолько огромна, что поначалу её просто не видишь."

# ch/kleio/events.rpy:4637
translate russian kleio_twintails_02_36d7ff41:
    "Словно мозг не может её переварить и на время вычёркивает из восприятия."

# ch/kleio/events.rpy:4639
translate russian kleio_twintails_02_3180385a:
    "Вот почему при первом взгляде на Клео я совершенно не замечаю, что изменилось."

# ch/kleio/events.rpy:4640
translate russian kleio_twintails_02_7fce9ada:
    "Да, мы какое-то время не виделись."

# ch/kleio/events.rpy:4641
translate russian kleio_twintails_02_04391b10:
    "И она явно старается привлечь моё внимание к перемене, хотя, конечно, делает вид, что нет!"

# ch/kleio/events.rpy:4642
translate russian kleio_twintails_02_b0dce918:
    "Но как ни стараюсь, мозг отказывается это осмыслить."

# ch/kleio/events.rpy:4644
translate russian kleio_twintails_02_d49c216f:
    kleio.say "Привет, сердцеед!"

# ch/kleio/events.rpy:4645
translate russian kleio_twintails_02_65b3cc0b:
    kleio.say "Давно не виделись, а?"

# ch/kleio/events.rpy:4646
translate russian kleio_twintails_02_f9885890:
    "Клео улыбается мне настолько многозначительно, насколько возможно."

# ch/kleio/events.rpy:4648
translate russian kleio_twintails_02_2bd0691c:
    "И приподнимает брови, будто ждёт, что я вот-вот замечу."

# ch/kleio/events.rpy:4649
translate russian kleio_twintails_02_12bb1063:
    mike.say "Привет, Клео!"

# ch/kleio/events.rpy:4650
translate russian kleio_twintails_02_ca8951dc:
    mike.say "Да, давно, правда?"

# ch/kleio/events.rpy:4651
translate russian kleio_twintails_02_dccdd404:
    mike.say "Ты... эм... отлично выглядишь!"

# ch/kleio/events.rpy:4652
translate russian kleio_twintails_02_e5fa1fc5:
    "Она кивает, продолжая улыбаться."

# ch/kleio/events.rpy:4653
translate russian kleio_twintails_02_86e5a5ef:
    "Но по глазам видно: ждёт, чтобы я сказал что-то ещё."

# ch/kleio/events.rpy:4654
translate russian kleio_twintails_02_682b74d5:
    "Да что же это, чёрт возьми?"

# ch/kleio/events.rpy:4655
translate russian kleio_twintails_02_98e977b4:
    "Что изменилось с нашей последней встречи?"

# ch/kleio/events.rpy:4656
translate russian kleio_twintails_02_22eb7d2a:
    "Стараюсь незаметно оглядеть Клео с головы до ног."

# ch/kleio/events.rpy:4657
translate russian kleio_twintails_02_0f60aaa5:
    "Но вроде всё как я помню и на своих местах."

# ch/kleio/events.rpy:4659
translate russian kleio_twintails_02_d950bdc0:
    "Только когда она начинает раздражаться и мотает головой, я наконец замечаю."

# ch/kleio/events.rpy:4660
translate russian kleio_twintails_02_a5c7fad5:
    "Наверху что-то движется — раньше этого не было!"

# ch/kleio/events.rpy:4661
translate russian kleio_twintails_02_06a8f66a:
    "Два высоких хвостика над ушами, раскачивающихся при каждом движении головы!"

# ch/kleio/events.rpy:4662
translate russian kleio_twintails_02_ba7f7e02:
    mike.say "Ого..."

# ch/kleio/events.rpy:4663
translate russian kleio_twintails_02_efb77356:
    mike.say "Клео..."

# ch/kleio/events.rpy:4664
translate russian kleio_twintails_02_ca3d80a5:
    mike.say "Твои волосы!"

# ch/kleio/events.rpy:4666
translate russian kleio_twintails_02_23bc9e8e:
    "От моих слов в её глазах вспыхивает торжество."

# ch/kleio/events.rpy:4667
translate russian kleio_twintails_02_ac2498a7:
    "Но она снова изо всех сил прячет настоящие чувства."

# ch/kleio/events.rpy:4668
translate russian kleio_twintails_02_40b987c2:
    "И отвечает с отработанной небрежностью."

# ch/kleio/events.rpy:4669
translate russian kleio_twintails_02_b3d85586:
    kleio.say "А, это?"

# ch/kleio/events.rpy:4670
translate russian kleio_twintails_02_ac15fef0:
    kleio.say "Заметил всё-таки?"

# ch/kleio/events.rpy:4671
translate russian kleio_twintails_02_3924e44c:
    kleio.say "Я не собиралась ничего говорить, но теперь-то ты знаешь..."

# ch/kleio/events.rpy:4672
translate russian kleio_twintails_02_3b430341:
    "Клео нарочно ещё немного встряхивает головой."

# ch/kleio/events.rpy:4673
translate russian kleio_twintails_02_b1d8bd1c:
    "Волосы качаются, переливаясь на свету золотистым каскадом."

# ch/kleio/events.rpy:4674
translate russian kleio_twintails_02_a990a0b1:
    "Мне даже не скрыть, насколько я впечатлён."

# ch/kleio/events.rpy:4675
translate russian kleio_twintails_02_71c14c4b:
    "Конечно, и с короткой стрижкой я считал её сексуальной."

# ch/kleio/events.rpy:4676
translate russian kleio_twintails_02_7253b1f3:
    "Но эта перемена делает её для меня ещё привлекательнее!"

# ch/kleio/events.rpy:4677
translate russian kleio_twintails_02_bd8da8c8:
    mike.say "Ух ты, Клео... просто ух ты!"

# ch/kleio/events.rpy:4678
translate russian kleio_twintails_02_324b6ff6:
    kleio.say "Нравится, да?"

# ch/kleio/events.rpy:4679
translate russian kleio_twintails_02_769f0a63:
    kleio.say "Не знаю, оставлю ли."

# ch/kleio/events.rpy:4680
translate russian kleio_twintails_02_b1b20f9b:
    kleio.say "Может, да, а может, нет..."

# ch/kleio/events.rpy:4681
translate russian kleio_twintails_02_2c64e7cc:
    mike.say "Ты ОБЯЗАНА оставить, Клео!"

# ch/kleio/events.rpy:4683
translate russian kleio_twintails_02_3ae9674d:
    "Она улыбается моей настойчивости: ей явно нравится моя реакция."

# ch/kleio/events.rpy:4684
translate russian kleio_twintails_02_49f86c1f:
    mike.say "Но как ты это сделала, Клео?"

# ch/kleio/events.rpy:4685
translate russian kleio_twintails_02_b7c5ab22:
    mike.say "Мы же не так давно виделись!"

# ch/kleio/events.rpy:4686
translate russian kleio_twintails_02_29ff3772:
    mike.say "Это не парик и не наращивание?"

# ch/kleio/events.rpy:4689
translate russian kleio_twintails_02_66ea117e:
    "Клео тут же обижается на само предположение."

# ch/kleio/events.rpy:4690
translate russian kleio_twintails_02_a9a8caea:
    "Она хмурится и качает головой."

# ch/kleio/events.rpy:4691
translate russian kleio_twintails_02_33f41893:
    kleio.say "Ещё чего!"

# ch/kleio/events.rpy:4692
translate russian kleio_twintails_02_b548e923:
    kleio.say "Всё моё, сто процентов натуральное!"

# ch/kleio/events.rpy:4693
translate russian kleio_twintails_02_8e05416e:
    mike.say "У тебя правда так быстро растут волосы?!"

# ch/kleio/events.rpy:4697
translate russian kleio_twintails_02_a8921e8e:
    "Теперь Клео начинает выглядеть немного неуверенно."

# ch/kleio/events.rpy:4698
translate russian kleio_twintails_02_ded63b86:
    kleio.say "Н... ну да!"

# ch/kleio/events.rpy:4699
translate russian kleio_twintails_02_e03c9983:
    kleio.say "А разве не у всех так?"

# ch/kleio/events.rpy:4700
translate russian kleio_twintails_02_cf219903:
    mike.say "Нет, Клео!"

# ch/kleio/events.rpy:4701
translate russian kleio_twintails_02_54819d17:
    mike.say "У меня бы на такую длину ушли месяцы!"

# ch/kleio/events.rpy:4702
translate russian kleio_twintails_02_ac9814d9:
    mike.say "Ого... тебе что, приходится стричься каждую неделю?"

# ch/kleio/events.rpy:4704
translate russian kleio_twintails_02_688c0a61:
    kleio.say "А если и так?!"

# ch/kleio/events.rpy:4705
translate russian kleio_twintails_02_f82a0749:
    kleio.say "Говоришь так, будто я какое-то чудовище!"

# ch/kleio/events.rpy:4706
translate russian kleio_twintails_02_dd888799:
    "Почувствовав опасность, я решаю оставить эту тему."

# ch/kleio/events.rpy:4707
translate russian kleio_twintails_02_9b38b30b:
    "Тут вспоминаю, как в пабе Клео разглядывала [bree.name], особенно её волосы."

# ch/kleio/events.rpy:4708
translate russian kleio_twintails_02_fc3bc8c7:
    "И как странно потом спрашивала, нравятся ли мне длинноволосые девушки."

# ch/kleio/events.rpy:4709
translate russian kleio_twintails_02_efb77356_1:
    mike.say "Клео..."

# ch/kleio/events.rpy:4710
translate russian kleio_twintails_02_f9afadea:
    mike.say "Ты ведь не ради сходства с [bree.name] отрастила волосы?"

# ch/kleio/events.rpy:4712
translate russian kleio_twintails_02_ff62ef1c:
    "Клео кривит губы в презрительной усмешке и качает головой."

# ch/kleio/events.rpy:4713
translate russian kleio_twintails_02_f7b333da:
    kleio.say "А?"

# ch/kleio/events.rpy:4714
translate russian kleio_twintails_02_534b1359:
    kleio.say "Какая ещё [bree.name]?"

# ch/kleio/events.rpy:4716
translate russian kleio_twintails_02_9f37e1f9:
    kleio.say "А... та белобрысая пустышка?"

# ch/kleio/events.rpy:4717
translate russian kleio_twintails_02_bc90fb87:
    kleio.say "Конечно нет! Я уже забыла, что она вообще существует!"

# ch/kleio/events.rpy:4718
translate russian kleio_twintails_02_403b7348:
    mike.say "Ладно, Клео, раз ты так говоришь."

# ch/kleio/events.rpy:4719
translate russian kleio_twintails_02_4031d70f:
    mike.say "Просто, если бы и так, ничего плохого."

# ch/kleio/events.rpy:4721
translate russian kleio_twintails_02_a3da8dc8:
    kleio.say "Но это не так!"

# ch/kleio/events.rpy:4722
translate russian kleio_twintails_02_0fb37b79:
    mike.say "И это тоже нормально."

# ch/kleio/events.rpy:4724
translate russian kleio_twintails_02_4d533985:
    kleio.say "Ещё бы нормально."

# ch/kleio/events.rpy:4725
translate russian kleio_twintails_02_726515b7:
    "Я стараюсь не рассмеяться от её реакции."

# ch/kleio/events.rpy:4726
translate russian kleio_twintails_02_daa16c2c:
    "Она скрывает чувства далеко не так хорошо, как ей кажется!"

# ch/kleio/events.rpy:4727
translate russian kleio_twintails_02_ea7bd9cd:
    mike.say "Просто чтобы ты знала, Клео."

# ch/kleio/events.rpy:4728
translate russian kleio_twintails_02_49d337e4:
    kleio.say "Да?"

# ch/kleio/events.rpy:4729
translate russian kleio_twintails_02_188b1717:
    mike.say "Какой бы ни была причина, по которой ты отрастила волосы..."

# ch/kleio/events.rpy:4730
translate russian kleio_twintails_02_f98aec55:
    kleio.say "Угу?"

# ch/kleio/events.rpy:4731
translate russian kleio_twintails_02_e9545fef:
    mike.say "Мне очень нравится."

# ch/kleio/events.rpy:4732
translate russian kleio_twintails_02_ed5cd437:
    mike.say "Выглядит потрясающе."

# ch/kleio/events.rpy:4734
translate russian kleio_twintails_02_70aa68d9:
    "Клео не может сдержать ни румянца, ни улыбки."

# ch/kleio/events.rpy:4735
translate russian kleio_twintails_02_34bb160e:
    "И сейчас она красивее, чем когда-либо."

# ch/kleio/events.rpy:4742
translate russian kleio_call_me_master_29a2c583:
    "При первой встрече с Клео я и представить не мог, что всё так обернётся."

# ch/kleio/events.rpy:4743
translate russian kleio_call_me_master_1e6354e3:
    "Она была такой яростной, боевой стервочкой, что рядом становилось не по себе."

# ch/kleio/events.rpy:4744
translate russian kleio_call_me_master_7d357bdc:
    "Но тогда я ещё не знал настоящую Клео, скрывающуюся за всей этой бравадой."

# ch/kleio/events.rpy:4745
translate russian kleio_call_me_master_c05803de:
    "Оказалось, она просто прятала себя настоящую. Вот это было открытие."

# ch/kleio/events.rpy:4746
translate russian kleio_call_me_master_efe20219:
    "С тех пор как мы оба признались, чего хотим от отношений, она выглядит намного счастливее."

# ch/kleio/events.rpy:4747
translate russian kleio_call_me_master_50ef96ff:
    "Словно наконец может перестать притворяться рядом со мной и быть той, кем хочет."

# ch/kleio/events.rpy:4748
translate russian kleio_call_me_master_72ba948a:
    "Я думал, что этот путь мы уже прошли до конца."

# ch/kleio/events.rpy:4749
translate russian kleio_call_me_master_454d261d:
    "Что нашли то, что полностью устраивает нас обоих."

# ch/kleio/events.rpy:4750
translate russian kleio_call_me_master_1e13d0de:
    "Пока Клео вдруг не заговаривает об этом..."

# ch/kleio/events.rpy:4752
translate russian kleio_call_me_master_ad5aa097:
    kleio.say "[lssb_kleio.hero_name()]..."

# ch/kleio/events.rpy:4753
translate russian kleio_call_me_master_2157d07a:
    kleio.say "Я хочу кое-что тебе сказать."

# ch/kleio/events.rpy:4754
translate russian kleio_call_me_master_d5439299:
    "Услышав это, я тут же поднимаю взгляд."

# ch/kleio/events.rpy:4755
translate russian kleio_call_me_master_ffcb5463:
    "А какой нормальный парень поступил бы иначе?"

# ch/kleio/events.rpy:4756
translate russian kleio_call_me_master_65144f33:
    "Будто мы запрограммированы улавливать малейший намёк на недовольство партнёрши!"

# ch/kleio/events.rpy:4757
translate russian kleio_call_me_master_b9546e9a:
    mike.say "Что такое, Клео?"

# ch/kleio/events.rpy:4758
translate russian kleio_call_me_master_d2e34eed:
    mike.say "Что ты хотела сказать?"

# ch/kleio/events.rpy:4760
translate russian kleio_call_me_master_cc9817d3:
    "Клео улыбается и качает головой."

# ch/kleio/events.rpy:4761
translate russian kleio_call_me_master_2dbe525e:
    "Она явно заметила панику в моём голосе."

# ch/kleio/events.rpy:4763
translate russian kleio_call_me_master_87dd8baa:
    kleio.say "Не обосрись, [lssb_kleio.hero_name()]!"

# ch/kleio/events.rpy:4764
translate russian kleio_call_me_master_4ccd5c50:
    kleio.say "Я не собираюсь тебя бросать!"

# ch/kleio/events.rpy:4765
translate russian kleio_call_me_master_b395d48f:
    kleio.say "Этого и через миллион грёбаных лет не случится!"

# ch/kleio/events.rpy:4766
translate russian kleio_call_me_master_a7befe2a:
    "Я киваю."

# ch/kleio/events.rpy:4767
translate russian kleio_call_me_master_3eecacbf:
    "И уже чувствую, как по телу разливается облегчение."

# ch/kleio/events.rpy:4768
translate russian kleio_call_me_master_86d07102:
    mike.say "А..."

# ch/kleio/events.rpy:4769
translate russian kleio_call_me_master_0924eeba:
    mike.say "Слава богу, Клео!"

# ch/kleio/events.rpy:4771
translate russian kleio_call_me_master_37bd6261:
    kleio.say "Я никогда тебя не брошу, [lssb_kleio.hero_name()]."

# ch/kleio/events.rpy:4772
translate russian kleio_call_me_master_98ef0163:
    kleio.say "Вот что я хотела сказать."

# ch/kleio/events.rpy:4773
translate russian kleio_call_me_master_438f2662:
    kleio.say "Я так счастлива с тех пор, как призналась, что хочу видеть тебя своим господином."

# ch/kleio/events.rpy:4774
translate russian kleio_call_me_master_cff6aad9:
    kleio.say "Больше словно не нужно переживать, какой меня видят другие."

# ch/kleio/events.rpy:4776
translate russian kleio_call_me_master_fcf895c0:
    kleio.say "Всё это неважно: мне нужно заботиться только о том, чтобы радовать тебя!"

# ch/kleio/events.rpy:4777
translate russian kleio_call_me_master_b8aa1c57:
    "Ох, господи..."

# ch/kleio/events.rpy:4778
translate russian kleio_call_me_master_82eba16b:
    "В такие моменты я всегда стараюсь играть невозмутимого и отстранённого господина."

# ch/kleio/events.rpy:4779
translate russian kleio_call_me_master_f058d0a7:
    "Но часть меня хочет отбросить эту роль и сказать Клео, как сильно я тоже её люблю."

# ch/kleio/events.rpy:4780
translate russian kleio_call_me_master_67269c59:
    "Вы только посмотрите: она почти во всём совершенна."

# ch/kleio/events.rpy:4781
translate russian kleio_call_me_master_9d585000:
    "И хочет лишь посвятить себя мне!"

# ch/kleio/events.rpy:4782
translate russian kleio_call_me_master_6e746c04:
    mike.say "Мне приятно это слышать, Клео."

# ch/kleio/events.rpy:4783
translate russian kleio_call_me_master_6f718cef:
    mike.say "И я очень горжусь тем, что я твой господин."

# ch/kleio/events.rpy:4784
translate russian kleio_call_me_master_9d43e7eb:
    "Клео кивает, спеша показать свою преданность."

# ch/kleio/events.rpy:4785
translate russian kleio_call_me_master_0f86b238:
    kleio.say "О да... господин!"

# ch/kleio/events.rpy:4786
translate russian kleio_call_me_master_a7dba2dc:
    kleio.say "Хочу преклоняться только перед тобой."

# ch/kleio/events.rpy:4787
translate russian kleio_call_me_master_f375b883:
    kleio.say "Другого господина у меня никогда не будет!"

# ch/kleio/events.rpy:4789
translate russian kleio_call_me_master_70735ad2:
    "Я киваю, улыбаюсь и глажу Клео по голове."

# ch/kleio/events.rpy:4790
translate russian kleio_call_me_master_1dbeeb6d:
    "От моего прикосновения она едва не дрожит, счастливая как никогда."

# ch/kleio/events.rpy:4791
translate russian kleio_call_me_master_503b6c73:
    "Я бы даже не удивился, замурлычь она как довольная кошка."

# ch/kleio/events.rpy:4793
translate russian kleio_call_me_master_48c4a9ae:
    "Часто ли бывает, чтобы двое были так безупречно счастливы вместе?"

# ch/kleio/events.rpy:4794
translate russian kleio_call_me_master_8f286e3d:
    "Чтобы каждый нашёл в другом именно то, чего не хватало для полноты жизни?"

# ch/kleio/events.rpy:4795
translate russian kleio_call_me_master_4538599a:
    "Разве это не настоящая сказочная любовь?"

# ch/kleio/events.rpy:4801
translate russian kleio_sub_event_1_7eaf0b08:
    "С тех пор как Клео всерьёз увлеклась подчинением мне, многое стало меняться."

# ch/kleio/events.rpy:4802
translate russian kleio_sub_event_1_92b3d835:
    "Например, больше нет долгих обсуждений, куда пойти и чем заняться, которые неизменно переходили в ссоры."

# ch/kleio/events.rpy:4803
translate russian kleio_sub_event_1_5f7ed471:
    "Теперь мне достаточно решить, чего я хочу, когда мы вместе, а она просто соглашается."

# ch/kleio/events.rpy:4804
translate russian kleio_sub_event_1_b6982eea:
    "Мне стало НАСТОЛЬКО проще и приятнее проводить с ней время."

# ch/kleio/events.rpy:4805
translate russian kleio_sub_event_1_6e8d0181:
    "Вот и сегодня хочется выбраться из дома, но придумывать занятие лень."

# ch/kleio/events.rpy:4806
translate russian kleio_sub_event_1_100d3d56:
    "Раньше я бы что-нибудь предложил, а Клео упёрлась бы, найдя любой глупый повод возразить."

# ch/kleio/events.rpy:4807
translate russian kleio_sub_event_1_aaa9fc39:
    "Теперь всё быстро, просто и безболезненно!"

# ch/kleio/events.rpy:4808
translate russian kleio_sub_event_1_efb77356:
    mike.say "Клео..."

# ch/kleio/events.rpy:4809
translate russian kleio_sub_event_1_e7ec9730:
    mike.say "Хватай свои вещи!"

# ch/kleio/events.rpy:4810
translate russian kleio_sub_event_1_4817f3d1:
    mike.say "Поедем прокатимся, ладно?"

# ch/kleio/events.rpy:4812
translate russian kleio_sub_event_1_669c5856:
    kleio.say "Ох, блядь..."

# ch/kleio/events.rpy:4813
translate russian kleio_sub_event_1_c33487d6:
    kleio.say "Подожди меня!"

# ch/kleio/events.rpy:4814
translate russian kleio_sub_event_1_d1fe1dd6:
    kleio.say "Иду, иду, не уезжай без меня!"

# ch/kleio/events.rpy:4816
translate russian kleio_sub_event_1_01b59a0a:
    "Понимаете, о чём я?"

# ch/kleio/events.rpy:4826
translate russian kleio_sub_event_1_0fb5646b:
    "Не проходит и пары минут после моих слов, а мы уже в машине."

# ch/kleio/events.rpy:4827
translate russian kleio_sub_event_1_c1e45b57:
    "И вскоре выезжаем из моего района."

# ch/kleio/events.rpy:4828
translate russian kleio_sub_event_1_ce37baa7:
    "Понятия не имею, куда и надолго ли."

# ch/kleio/events.rpy:4829
translate russian kleio_sub_event_1_2c9771e8:
    "Но эта тишина — просто музыка для моих ушей!"

# ch/kleio/events.rpy:4830
translate russian kleio_sub_event_1_89c26b02:
    "Клео довольно сидит на пассажирском месте и смотрит в окно."

# ch/kleio/events.rpy:4831
translate russian kleio_sub_event_1_ff542c20:
    "Я стараюсь следить за дорогой и сосредоточиться на вождении."

# ch/kleio/events.rpy:4832
translate russian kleio_sub_event_1_55be6ed4:
    "Но каждый украдкой брошенный взгляд на Клео делает это труднее."

# ch/kleio/events.rpy:4833
translate russian kleio_sub_event_1_637c4388:
    "Она не пытается меня отвлечь, по крайней мере поначалу."

# ch/kleio/events.rpy:4834
translate russian kleio_sub_event_1_564e48bc:
    "Просто сидит и выглядит чертовски сексуально!"

# ch/kleio/events.rpy:4835
translate russian kleio_sub_event_1_65000523:
    "Вскоре она замечает, как трудно мне отвести от неё глаза."

# ch/kleio/events.rpy:4837
translate russian kleio_sub_event_1_a89cda2d:
    "И, как умелая соблазнительница, начинает пользоваться моим вниманием."

# ch/kleio/events.rpy:4838
translate russian kleio_sub_event_1_4d545134:
    "Клео вздыхает и водит руками по своему телу."

# ch/kleio/events.rpy:4840
translate russian kleio_sub_event_1_2cd07edc:
    "Сначала по ногам, напоминая мне об их прекрасной форме."

# ch/kleio/events.rpy:4841
translate russian kleio_sub_event_1_183025f7:
    "Потом поднимается выше и обеими руками гладит плоский живот."

# ch/kleio/events.rpy:4843
translate russian kleio_sub_event_1_57227843:
    "Но когда она сжимает груди и томно складывает губы, я не выдерживаю."

# ch/kleio/events.rpy:4847
translate russian kleio_sub_event_1_3aa63114:
    "Чуть не теряю управление, и машину бросает поперёк дороги."

# ch/kleio/events.rpy:4849
translate russian kleio_sub_event_1_d59d53ee:
    "Клео испуганно ахает, пока я отчаянно пытаюсь удержать нас на асфальте."

# ch/kleio/events.rpy:4851
translate russian kleio_sub_event_1_8486a960:
    "Через мгновение всё позади: машина снова под контролем, мы в безопасности."

# ch/kleio/events.rpy:4852
translate russian kleio_sub_event_1_f2c4fb2d:
    "Но сердце всё ещё колотится в груди."

# ch/kleio/events.rpy:4853
translate russian kleio_sub_event_1_558ecbf7:
    "Короткий взгляд в сторону показывает: Клео по-прежнему белая как мел."

# ch/kleio/events.rpy:4854
translate russian kleio_sub_event_1_83632d79:
    "Сейчас поездка, похоже, не радует никого из нас."

# ch/kleio/events.rpy:4855
translate russian kleio_sub_event_1_432550df:
    "Решаю остановиться при первой возможности."

# ch/kleio/events.rpy:4856
translate russian kleio_sub_event_1_1dac75fb:
    "Заметив укромное место для парковки, сворачиваю с дороги."

# ch/kleio/events.rpy:4857
translate russian kleio_sub_event_1_7b418293:
    "Думаю, после такой близости к смерти нам обоим нужно немного успокоиться."

# ch/kleio/events.rpy:4859
translate russian kleio_sub_event_1_1b580204:
    "Глушу двигатель и виновато поворачиваюсь к Клео."

# ch/kleio/events.rpy:4860
translate russian kleio_sub_event_1_30e74fc5:
    mike.say "Эм..."

# ch/kleio/events.rpy:4861
translate russian kleio_sub_event_1_8b4ef1bb:
    mike.say "Прости за это, Клео."

# ch/kleio/events.rpy:4862
translate russian kleio_sub_event_1_495102ff:
    mike.say "Кажется, я немного отвлёкся!"

# ch/kleio/events.rpy:4865
translate russian kleio_sub_event_1_059680c9:
    "Она сразу качает головой, отвергая мои извинения."

# ch/kleio/events.rpy:4866
translate russian kleio_sub_event_1_8a25b6fa:
    kleio.say "Да ни за что!"

# ch/kleio/events.rpy:4867
translate russian kleio_sub_event_1_d828dab1:
    kleio.say "Это целиком моя вина."

# ch/kleio/events.rpy:4868
translate russian kleio_sub_event_1_b9b9f8d3:
    kleio.say "Как ты должен вести, если я тебя всё время отвлекаю?"

# ch/kleio/events.rpy:4869
translate russian kleio_sub_event_1_9520af5e:
    "Я пожимаю плечами, пытаясь взглянуть на случившееся её глазами."

# ch/kleio/events.rpy:4870
translate russian kleio_sub_event_1_fe72fcdd:
    "Она действительно меня отвлекала."

# ch/kleio/events.rpy:4871
translate russian kleio_sub_event_1_21dac42e:
    "Может, в её словах есть смысл?"

# ch/kleio/events.rpy:4872
translate russian kleio_sub_event_1_f1d8a63c:
    mike.say "Эм..."

# ch/kleio/events.rpy:4873
translate russian kleio_sub_event_1_906bac50:
    mike.say "Ладно, Клео..."

# ch/kleio/events.rpy:4874
translate russian kleio_sub_event_1_df27c630:
    mike.say "В следующий раз не будь настолько сексуальной, чтобы я разбил машину, хорошо?"

# ch/kleio/events.rpy:4876
translate russian kleio_sub_event_1_2906857a:
    "Клео хихикает и хлопает ресницами."

# ch/kleio/events.rpy:4878
translate russian kleio_sub_event_1_1da5648e:
    kleio.say "Но сейчас ты не ведёшь."

# ch/kleio/events.rpy:4879
translate russian kleio_sub_event_1_d6fafc5c:
    kleio.say "Значит, быть сексуальной уже можно, да?"

# ch/kleio/events.rpy:4880
translate russian kleio_sub_event_1_b099c4c6:
    "В подтверждение она снова сжимает груди."

# ch/kleio/events.rpy:4881
translate russian kleio_sub_event_1_ca6f8ac8:
    "И как только она это делает, я чувствую, как уходят паника и напряжение."

# ch/kleio/events.rpy:4882
translate russian kleio_sub_event_1_442baed6:
    "На их место возвращается то самое желание, из-за которого мы чуть не вылетели с дороги."

# ch/kleio/events.rpy:4883
translate russian kleio_sub_event_1_41c3cb2d:
    "Только теперь машина стоит, и меня ничто не отвлекает."

# ch/kleio/events.rpy:4884
translate russian kleio_sub_event_1_640e5983:
    mike.say "Пожалуй, теперь можно, Клео."

# ch/kleio/events.rpy:4885
translate russian kleio_sub_event_1_400a42c5:
    mike.say "И лучшего способа извиниться я не придумаю!"

# ch/kleio/events.rpy:4886
translate russian kleio_sub_event_1_e1fa10c0:
    "Приподнимаю бровь и хлопаю себя по бёдрам."

# ch/kleio/events.rpy:4887
translate russian kleio_sub_event_1_bd38ec34:
    "А чтобы намёк был ясен, киваю себе на колени."

# ch/kleio/events.rpy:4889
translate russian kleio_sub_event_1_caf4e7df:
    "Клео снова хихикает и радостно хлопает в ладоши."

# ch/kleio/events.rpy:4893
translate russian kleio_sub_event_1_4988ecfd:
    "Не теряя времени, перебирается со своего сиденья ко мне."

# ch/kleio/events.rpy:4895
translate russian kleio_sub_event_1_55b9300a:
    "Усаживается верхом и поспешно стягивает топ."

# ch/kleio/events.rpy:4896
translate russian kleio_sub_event_1_01771e85:
    "Я ахаю: те самые груди едва не ударяют меня по лицу."

# ch/kleio/events.rpy:4897
translate russian kleio_sub_event_1_405807a2:
    "Да, с пассажирского сиденья они смотрелись хорошо."

# ch/kleio/events.rpy:4898
translate russian kleio_sub_event_1_774aead8:
    "Но в паре сантиметров от моего носа выглядят куда лучше!"

# ch/kleio/events.rpy:4899
translate russian kleio_sub_event_1_040b6d55:
    "Не колеблясь, я наклоняюсь вперёд."

# ch/kleio/events.rpy:4900
translate russian kleio_sub_event_1_0efc87ac:
    "И зарываюсь лицом между ними."

# ch/kleio/events.rpy:4901
translate russian kleio_sub_event_1_3446ecd3:
    "У некоторых девушек грудь гораздо больше, чем у Клео."

# ch/kleio/events.rpy:4902
translate russian kleio_sub_event_1_61291e6b:
    "Но мне такие не нужны."

# ch/kleio/events.rpy:4903
translate russian kleio_sub_event_1_697288fe:
    "Эти как раз подходят, чтобы прижиматься к ним лицом."

# ch/kleio/events.rpy:4904
translate russian kleio_sub_event_1_2a04a534:
    "Достаточно повернуть голову, чтобы перейти от одного соска к другому."

# ch/kleio/events.rpy:4905
translate russian kleio_sub_event_1_3df16eef:
    "И задохнуться между ними мне тоже не грозит!"

# ch/kleio/events.rpy:4907
translate russian kleio_sub_event_1_494ee09b:
    "Клео радостно смеётся, пока я играю с её грудью."

# ch/kleio/events.rpy:4909
translate russian kleio_sub_event_1_3fdc39de:
    "Но я чувствую и то, чем заняты её руки."

# ch/kleio/events.rpy:4911
translate russian kleio_sub_event_1_0369dd0b:
    "Она трёт мне пах, массируя член сквозь брюки."

# ch/kleio/events.rpy:4912
translate russian kleio_sub_event_1_6ae7c8ff:
    "Это очень приятно, и с каждым мгновением я твердею всё сильнее."

# ch/kleio/events.rpy:4913
translate russian kleio_sub_event_1_c53e5c4d:
    "Подняв голову от груди Клео, я киваю ей."

# ch/kleio/events.rpy:4914
translate russian kleio_sub_event_1_906bac50_1:
    mike.say "Ладно, Клео..."

# ch/kleio/events.rpy:4915
translate russian kleio_sub_event_1_b6d4643d:
    mike.say "Давай, угощайся."

# ch/kleio/events.rpy:4916
translate russian kleio_sub_event_1_a611577d:
    "Клео нетерпеливо кивает, уже выполняя сказанное."

# ch/kleio/events.rpy:4918
translate russian kleio_sub_event_1_07796952:
    "Она быстро вытаскивает мой член из брюк."

# ch/kleio/events.rpy:4919
translate russian kleio_sub_event_1_9f52ba64:
    "Освободив его, сразу принимается за дело."

# ch/kleio/events.rpy:4920
translate russian kleio_sub_event_1_3edfb9cc:
    "Одной рукой водит вверх-вниз по стволу."

# ch/kleio/events.rpy:4921
translate russian kleio_sub_event_1_58559d7c:
    "Другой сжимает яйца — ровно настолько, чтобы было приятно."

# ch/kleio/events.rpy:4922
translate russian kleio_sub_event_1_6af77890:
    mike.say "О да..."

# ch/kleio/events.rpy:4923
translate russian kleio_sub_event_1_cc67b438:
    mike.say "Потрясающе, Клео!"

# ch/kleio/events.rpy:4924
translate russian kleio_sub_event_1_ff7c34a5:
    kleio.say "Ох..."

# ch/kleio/events.rpy:4925
translate russian kleio_sub_event_1_50a2ab43:
    kleio.say "Ты это заслужил... господин!"

# ch/kleio/events.rpy:4926
translate russian kleio_sub_event_1_fb1bc026:
    kleio.say "Но, пожалуйста... можно мне его?"

# ch/kleio/events.rpy:4927
translate russian kleio_sub_event_1_a301a029:
    kleio.say "Вставишь его в меня?"

# ch/kleio/events.rpy:4928
translate russian kleio_sub_event_1_0355cb05:
    "Её отчаянная просьба вызывает у меня смех."

# ch/kleio/events.rpy:4929
translate russian kleio_sub_event_1_d2e716d7:
    "Приятно знать, как сильно она этого хочет."

# ch/kleio/events.rpy:4930
translate russian kleio_sub_event_1_9af9713a:
    "И оттягивать исполнение желания от этого ещё приятнее!"

# ch/kleio/events.rpy:4931
translate russian kleio_sub_event_1_f672e9b4:
    mike.say "Покажи, как сильно хочешь, Клео."

# ch/kleio/events.rpy:4932
translate russian kleio_sub_event_1_d4dffd81:
    mike.say "Убеди меня, что это твоё самое заветное желание!"

# ch/kleio/events.rpy:4933
translate russian kleio_sub_event_1_9fd633fb:
    "Клео ахает и надувает губы, не получив желаемого."

# ch/kleio/events.rpy:4934
translate russian kleio_sub_event_1_80cb6812:
    "Потом прикусывает губу и начинает тяжело дышать от нетерпения."

# ch/kleio/events.rpy:4936
translate russian kleio_sub_event_1_a6e33347:
    kleio.say "О-о-ох..."

# ch/kleio/events.rpy:4937
translate russian kleio_sub_event_1_69ce8102:
    kleio.say "Я ТАК его хочу!"

# ch/kleio/events.rpy:4939
translate russian kleio_sub_event_1_fa1130d9:
    kleio.say "Его приятно держать в руке."

# ch/kleio/events.rpy:4940
translate russian kleio_sub_event_1_874be2b4:
    kleio.say "Но внутри меня было бы куда приятнее!"

# ch/kleio/events.rpy:4941
translate russian kleio_sub_event_1_4643c8d9:
    kleio.say "Я почти чувствую, как он входит и заполняет меня!"

# ch/kleio/events.rpy:4943
translate russian kleio_sub_event_1_03ae0292:
    "Без предупреждения я просовываю руку Клео в шорты."

# ch/kleio/events.rpy:4944
translate russian kleio_sub_event_1_27efc5d3:
    "Провожу вдоль половых губ, касаясь складок между ними."

# ch/kleio/events.rpy:4945
translate russian kleio_sub_event_1_f16c5551:
    "Она удивлённо ахает и извивается у меня на коленях."

# ch/kleio/events.rpy:4946
translate russian kleio_sub_event_1_6b644069:
    "У Клео там уже горячо и мокро."

# ch/kleio/events.rpy:4947
translate russian kleio_sub_event_1_66bd612b:
    "Через мгновение мои пальцы легко скользят в её киску."

# ch/kleio/events.rpy:4948
translate russian kleio_sub_event_1_0db6b4c6:
    "Смотрю, как она закрывает глаза и закусывает губу."

# ch/kleio/events.rpy:4949
translate russian kleio_sub_event_1_7c4831c0:
    "И точно знаю: она представляет, как я вхожу в неё!"

