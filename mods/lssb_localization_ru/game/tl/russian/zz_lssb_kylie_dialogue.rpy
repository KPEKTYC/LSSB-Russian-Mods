# ch/kylie/events.rpy:860
translate russian kylie_breakup_2_47bfb811:
    alexis.say "Тебе незачем знать все эти страшные подробности."

# ch/kylie/events.rpy:861
translate russian kylie_breakup_2_dcab7fb9:
