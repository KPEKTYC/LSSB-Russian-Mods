translate russian kylie_investigation_2_32441f73:
    "Детектив Фольо" "И это та девушка, которую убили?"

# ch/kylie/events.rpy:2143
translate russian kylie_investigation_2_3ad97b39_4:
    mike.say "Нет, ты меня вообще слушаешь?"

# ch/kylie/events.rpy:2144
translate russian kylie_investigation_2_5db1581a_1:
    mike.say "Убили мою соседку!"

# ch/kylie/events.rpy:2145
translate russian kylie_investigation_2_9dea418c_1:
    mike.say "А убийца — Кайли!"

# ch/kylie/events.rpy:2147
translate russian kylie_investigation_2_f78e8c4f_2:
    "Полицейская хмурится."

# ch/kylie/events.rpy:2149
