translate russian kylie_belly_kiss_male_f2c5197f:
    "Но затем качает головой."

# ch/kylie/reactions.rpy:379
translate russian kylie_belly_kiss_male_cbeb658b:
    kylie.say "Нет, [lssb_kylie.hero_name()]..."

# ch/kylie/reactions.rpy:380
translate russian kylie_belly_kiss_male_112a0895:
    kylie.say "Это было очень мило."

# ch/kylie/reactions.rpy:381
translate russian kylie_belly_kiss_male_8a6c665f:
    kylie.say "Мне очень понравилось!"

# ch/kylie/reactions.rpy:383
translate russian kylie_belly_kiss_male_3aacf05b:
    "С облегчением кивнув, я снова наклоняюсь."

# ch/kylie/reactions.rpy:384
translate russian kylie_belly_kiss_male_2552c790:
    "И на этот раз целую живот Кайли уже гораздо увереннее."

# ch/kylie/reactions.rpy:389
translate russian kylie_belly_caress_male_76712ee6:
    "Не могу отвести глаз от Кайли, сидящей с руками на животе."

# ch/kylie/reactions.rpy:390
translate russian kylie_belly_caress_male_326822c9:
    "Кажется, она полностью им поглощена, и больше её ничто не интересует."

# ch/kylie/reactions.rpy:391
translate russian kylie_belly_caress_male_fe1696d2:
    "Руки непрерывно скользят по нему, гладят и ласкают."

# ch/kylie/reactions.rpy:392
translate russian kylie_belly_caress_male_06c7e9eb:
    "Порой я даже готов поклясться, что она что-то ему шепчет!"

# ch/kylie/reactions.rpy:393
translate russian kylie_belly_caress_male_30e74fc5:
    mike.say "Эм..."

# ch/kylie/reactions.rpy:394
translate russian kylie_belly_caress_male_e69bb63a:
    mike.say "Кайли..."

# ch/kylie/reactions.rpy:396
translate russian kylie_belly_caress_male_0c398bca:
    "Кайли замирает и смотрит на меня."

# ch/kylie/reactions.rpy:397
translate russian kylie_belly_caress_male_459facc2:
    "Не припомню, чтобы когда-нибудь видел её такой счастливой."

# ch/kylie/reactions.rpy:399
translate russian kylie_belly_caress_male_1e261835:
    kylie.say "Да, [lssb_kylie.hero_name()]..."

# ch/kylie/reactions.rpy:401
translate russian kylie_belly_caress_male_70805194:
    kylie.say "Что такое?"

# ch/kylie/reactions.rpy:403
translate russian kylie_belly_caress_male_da21c155:
    "Мой взгляд устремляется к её округлившемуся животу."

# ch/kylie/reactions.rpy:404
translate russian kylie_belly_caress_male_16fd1d31:
    "Потом я снова смотрю ей в глаза."

# ch/kylie/reactions.rpy:405
translate russian kylie_belly_caress_male_04ae9b36:
    mike.say "Как думаешь, можно мне..."

# ch/kylie/reactions.rpy:406
translate russian kylie_belly_caress_male_443a6470:
    mike.say "Может, немного..."

# ch/kylie/reactions.rpy:408
translate russian kylie_belly_caress_male_54208258:
    "Пока говорю, почти не замечаю, что уже протягиваю руку."

# ch/kylie/reactions.rpy:409
translate russian kylie_belly_caress_male_2be13ac7:
    "Движение наверняка бессознательное, чисто инстинктивное."

# ch/kylie/reactions.rpy:411
translate russian kylie_belly_caress_male_aa59a2f6:
    "Потому что я даже слегка вздрагиваю, когда Кайли берёт меня за руку."

# ch/kylie/reactions.rpy:412
translate russian kylie_belly_caress_male_dbe274a0:
    "Не говоря ни слова, она кладёт её себе на живот и удерживает там."

# ch/kylie/reactions.rpy:413
translate russian kylie_belly_caress_male_b6396f1b:
    "Вскоре я чувствую внезапное движение внутри."

# ch/kylie/reactions.rpy:414
translate russian kylie_belly_caress_male_1d576a9b:
    "И на этот раз поднимаю взгляд с улыбкой почти такой же широкой, как у Кайли."

# ch/kylie/reactions.rpy:419
translate russian kylie_belly_listen_male_e69bb63a:
    mike.say "Кайли..."

# ch/kylie/reactions.rpy:420
translate russian kylie_belly_listen_male_e59ca6f8:
    mike.say "Не против, если я кое-что попробую?"

# ch/kylie/reactions.rpy:421
translate russian kylie_belly_listen_male_b513e601:
    mike.say "Ну, с твоим животиком."

# ch/kylie/reactions.rpy:423
translate russian kylie_belly_listen_male_c8203954:
    "Слушая меня, Кайли склоняет голову набок."

# ch/kylie/reactions.rpy:424
translate russian kylie_belly_listen_male_75546766:
    "Ей явно любопытно, что я задумал."

# ch/kylie/reactions.rpy:426
translate russian kylie_belly_listen_male_61183d90:
    kylie.say "Давай, [lssb_kylie.hero_name()]..."

# ch/kylie/reactions.rpy:427
translate russian kylie_belly_listen_male_ba63a852:
    kylie.say "Уверена, всё будет хорошо."

# ch/kylie/reactions.rpy:429
translate russian kylie_belly_listen_male_904a190a:
    kylie.say "Если только ты не задумал что-то совсем странное!"

# ch/kylie/reactions.rpy:431
translate russian kylie_belly_listen_male_206285f3:
    "Я хмурю брови и отмахиваюсь от её опасений."

# ch/kylie/reactions.rpy:432
translate russian kylie_belly_listen_male_162fd66a:
    mike.say "Эй, это же я..."

# ch/kylie/reactions.rpy:433
translate russian kylie_belly_listen_male_3e9ab861:
    mike.say "Насколько странным это может быть?"

# ch/kylie/reactions.rpy:435
translate russian kylie_belly_listen_male_c94e1d0f:
    "Но по лицу Кайли понимаю, что, возможно, зря это сказал."

# ch/kylie/reactions.rpy:436
translate russian kylie_belly_listen_male_af640083:
    mike.say "Не отвечай!"

# ch/kylie/reactions.rpy:438
translate russian kylie_belly_listen_male_3d7ee604:
    mike.say "Ладно, раскрою карты..."

# ch/kylie/reactions.rpy:439
translate russian kylie_belly_listen_male_66aa8d02:
    mike.say "Нам ведь делали УЗИ в больнице, да?"

# ch/kylie/reactions.rpy:440
translate russian kylie_belly_listen_male_2593703d:
    mike.say "Так вот, я хочу послушать сам."

# ch/kylie/reactions.rpy:442
translate russian kylie_belly_listen_male_0afa0b56:
    "Кайли пожимает плечами и поднимает верх одежды."

# ch/kylie/reactions.rpy:443
translate russian kylie_belly_listen_male_afdb9455:
    "Её огромный живот тут же оказывается на виду."

# ch/kylie/reactions.rpy:445
translate russian kylie_belly_listen_male_17746b11:
    kylie.say "Весь в твоём распоряжении."

# ch/kylie/reactions.rpy:447
translate russian kylie_belly_listen_male_901d4150:
    "Кайли указывает на живот, пока я наклоняюсь ближе."

# ch/kylie/reactions.rpy:448
translate russian kylie_belly_listen_male_a0d16dee:
    "Прижав к нему ухо, я поднимаю руку, призывая к тишине."

# ch/kylie/reactions.rpy:449
translate russian kylie_belly_listen_male_24b63c9b:
    "Сначала ничего не слышу, но затем улавливаю тихий звук."

# ch/kylie/reactions.rpy:450
translate russian kylie_belly_listen_male_064f98d3:
    mike.say "Вот оно, прямо здесь..."

# ch/kylie/reactions.rpy:451
translate russian kylie_belly_listen_male_ff044d7e:
    mike.say "Я слышу, Кайли..."

# ch/kylie/reactions.rpy:452
translate russian kylie_belly_listen_male_47c7a983:
    mike.say "Я слышу малыша!"

# ch/kylie/reactions.rpy:454
translate russian kylie_belly_listen_male_9f487b6a:
    "Слышу, как Кайли посмеивается над моим восторгом."

# ch/kylie/reactions.rpy:455
translate russian kylie_belly_listen_male_fade71bf:
    "Но меня это ничуть не смущает."

# ch/kylie/reactions.rpy:456
translate russian kylie_belly_listen_male_934e9143:
    "Ведь это куда важнее попыток выглядеть невозмутимым и крутым."

# ch/kylie/talk.rpy:22
translate russian kylie_talk_stalking_male_72710674:
    "Едва увидев Кайли, я с трудом удерживаюсь от того, чтобы броситься к ней и сразу потребовать объяснений."

# ch/kylie/talk.rpy:23
translate russian kylie_talk_stalking_male_4bf1b8fc:
    "Но кое-как сдерживаю злость и подхожу, делая вид, будто ничего не подозреваю."

# ch/kylie/talk.rpy:24
translate russian kylie_talk_stalking_male_15d9c462:
    "Всё это время скрежещу зубами за плотно сжатыми губами и впиваюсь ногтями в ладони."

# ch/kylie/talk.rpy:25
translate russian kylie_talk_stalking_male_78e36c48:
    "Кайли же выглядит как обычно: приторно милой."

# ch/kylie/talk.rpy:27
translate russian kylie_talk_stalking_male_eaa7074c:
    "Она сладко улыбается и машет рукой — в иной ситуации я счёл бы это дружеским приветствием."

# ch/kylie/talk.rpy:28
translate russian kylie_talk_stalking_male_388eb283:
    kylie.say "[lssb_kylie.hero_name()]."

# ch/kylie/talk.rpy:30
translate russian kylie_talk_stalking_male_5ac29981:
    kylie.say "Я ТАК рада тебя видеть!"

# ch/kylie/talk.rpy:31
translate russian kylie_talk_stalking_male_3349ff50:
    mike.say "Прибереги эту чушь для другого простака, Кайли."

# ch/kylie/talk.rpy:32
translate russian kylie_talk_stalking_male_d89ea4f0:
    mike.say "Со мной это больше не пройдёт!"

# ch/kylie/talk.rpy:34
translate russian kylie_talk_stalking_male_6202f0a9:
    "Кайли слегка отшатывается."

# ch/kylie/talk.rpy:35
translate russian kylie_talk_stalking_male_8761d044:
    "Очевидно, моя внезапная вспышка застала её врасплох."

# ch/kylie/talk.rpy:36
translate russian kylie_talk_stalking_male_2951369a:
    "Но она не настолько неопытна, чтобы сразу сбросить маску невинности."

# ch/kylie/talk.rpy:37
translate russian kylie_talk_stalking_male_7248cf76:
    kylie.say "Я... я не понимаю, [lssb_kylie.hero_name()]."

# ch/kylie/talk.rpy:39
translate russian kylie_talk_stalking_male_332bd556:
    kylie.say "Ты в чём-то меня обвиняешь?"

# ch/kylie/talk.rpy:40
translate russian kylie_talk_stalking_male_6b605a53:
    kylie.say "Ведь я бы никогда..."

# ch/kylie/talk.rpy:41
translate russian kylie_talk_stalking_male_d31410e7:
    "Не желая слушать очередную выдуманную чушь, я качаю головой."

# ch/kylie/talk.rpy:42
translate russian kylie_talk_stalking_male_14b24264:
    "Потом поднимаю телефон и включаю компрометирующую запись."

# ch/kylie/talk.rpy:44
translate russian kylie_talk_stalking_male_b7977e30:
    "Через миг глаза Кайли расширяются. Я понимаю: она узнала, что это."

# ch/kylie/talk.rpy:45
translate russian kylie_talk_stalking_male_393ab088:
    "И она тоже понимает, что я это понял!"

# ch/kylie/talk.rpy:46
translate russian kylie_talk_stalking_male_36818f63:
    "Молча жду, с интересом гадая, что она скажет теперь."

# ch/kylie/talk.rpy:47
translate russian kylie_talk_stalking_male_795151c5:
    "Судя по затянувшейся паузе, ответ обещает быть занятным..."

# ch/kylie/talk.rpy:49
translate russian kylie_talk_stalking_male_20c30267:
    kylie.say "Ох, [lssb_kylie.hero_name()]..."

# ch/kylie/talk.rpy:50
translate russian kylie_talk_stalking_male_ea0ab1b7:
    kylie.say "Мне ТАК, ТАК жаль!"

# ch/kylie/talk.rpy:51
translate russian kylie_talk_stalking_male_2fa0df97:
    kylie.say "Ты наверняка меня НЕНАВИДИШЬ!"

# ch/kylie/talk.rpy:52
translate russian kylie_talk_stalking_male_4cb3d82c:
    "Скорость, с которой Кайли заливается слезами, просто поражает."

# ch/kylie/talk.rpy:53
translate russian kylie_talk_stalking_male_fb840092:
    "Буквально в мгновение ока она превращается в рыдающий комок."

# ch/kylie/talk.rpy:54
translate russian kylie_talk_stalking_male_12bcf1e3:
    "Возможно, такая быстрота должна была меня насторожить."

# ch/kylie/talk.rpy:55
translate russian kylie_talk_stalking_male_796484e5:
    "Но я просто теряюсь под напором её внезапных чувств."

# ch/kylie/talk.rpy:56
translate russian kylie_talk_stalking_male_52c65242:
    mike.say "Что?!"

# ch/kylie/talk.rpy:57
translate russian kylie_talk_stalking_male_675e3354:
    mike.say "Да... то есть нет..."

# ch/kylie/talk.rpy:58
translate russian kylie_talk_stalking_male_5f367f76:
    mike.say "Я просто хочу знать, что происходит, Кайли!"

# ch/kylie/talk.rpy:59
translate russian kylie_talk_stalking_male_b94c0f6f:
    "Говоря это, оглядываюсь и начинаю беспокоиться, что подумают возможные свидетели."

# ch/kylie/talk.rpy:60
translate russian kylie_talk_stalking_male_2d653de7:
    "Похоже, страх самому оказаться в чём-то обвинённым, пока я обвиняю Кайли, изрядно затуманивает мне рассудок!"

# ch/kylie/talk.rpy:62
translate russian kylie_talk_stalking_male_c5b04369:
    kylie.say "Я не хотела, [lssb_kylie.hero_name()], поверь мне!"

# ch/kylie/talk.rpy:64
translate russian kylie_talk_stalking_male_3f6f97d5:
    kylie.say "Просто однажды ночью проходила мимо, вот и всё."

# ch/kylie/talk.rpy:65
translate russian kylie_talk_stalking_male_d05e5b19:
    kylie.say "Случайно оказалась возле твоего дома и подумала проверить, не спишь ли ты."

# ch/kylie/talk.rpy:66
translate russian kylie_talk_stalking_male_75203ec6:
    mike.say "В три часа ночи?!"

# ch/kylie/talk.rpy:68
translate russian kylie_talk_stalking_male_8edb8480:
    kylie.say "Я понимаю, как это звучит, [lssb_kylie.hero_name()], правда понимаю!"

# ch/kylie/talk.rpy:69
translate russian kylie_talk_stalking_male_3312d32b:
    kylie.say "Сначала хотела постучать или позвонить в дверь."

# ch/kylie/talk.rpy:70
translate russian kylie_talk_stalking_male_28df81db:
    kylie.say "Но потом испугалась, что ты рассердишься, если я тебя разбужу."

# ch/kylie/talk.rpy:72
translate russian kylie_talk_stalking_male_a132909f:
    kylie.say "Поэтому... поэтому просто стояла и надеялась, что ты всё-таки выйдешь."

# ch/kylie/talk.rpy:73
translate russian kylie_talk_stalking_male_3f308a74:
    kylie.say "А потом я стала гулять почти каждую ночь..."

# ch/kylie/talk.rpy:74
translate russian kylie_talk_stalking_male_95857ca6:
    "Кайли смотрит себе под ноги и заламывает руки, пока по щекам текут слёзы."

# ch/kylie/talk.rpy:75
translate russian kylie_talk_stalking_male_82e650b4:
    kylie.say "Я перестану, [lssb_kylie.hero_name()]."

# ch/kylie/talk.rpy:76
translate russian kylie_talk_stalking_male_9cce33e3:
    kylie.say "Обещаю тебе!"

# ch/kylie/talk.rpy:77
translate russian kylie_talk_stalking_male_7dec191f:
    "Я понимаю, что должен сказать: одного обещания недостаточно. Но медлю."

# ch/kylie/talk.rpy:78
translate russian kylie_talk_stalking_male_2a70bba2:
    "Да, объяснение Кайли звучит как бред сумасшедшей."

# ch/kylie/talk.rpy:79
translate russian kylie_talk_stalking_male_0dd8ddff:
    "Но она ведь никогда не была самой обычной девушкой."

# ch/kylie/talk.rpy:80
translate russian kylie_talk_stalking_male_2156aaf8:
    "Может, просто слишком увлеклась и дошла до того, что уже не могла остановиться?"

# ch/kylie/talk.rpy:81
translate russian kylie_talk_stalking_male_f72e8461:
    "По крайней мере, она признала, что поступила неправильно."

# ch/kylie/talk.rpy:82
translate russian kylie_talk_stalking_male_3eab2f2b:
    "Это ведь должно что-то значить?"

# ch/kylie/talk.rpy:83
translate russian kylie_talk_stalking_male_67d5b96e:
    mike.say "Угх..."

# ch/kylie/talk.rpy:84
translate russian kylie_talk_stalking_male_9b815972:
    mike.say "Ладно, Кайли, не заставляй меня об этом пожалеть."

# ch/kylie/talk.rpy:85
translate russian kylie_talk_stalking_male_c567e8ee:
    mike.say "Если ты правда это обещаешь, пожалуй, мы можем оставить всё в прошлом."

# ch/kylie/talk.rpy:87
translate russian kylie_talk_stalking_male_c4f3e3e2:
    "Кайли едва не бросается на меня, улыбаясь и хлопая ресницами."

# ch/kylie/talk.rpy:89
translate russian kylie_talk_stalking_male_b92e0390:
    kylie.say "О, спасибо, [lssb_kylie.hero_name()]!"

# ch/kylie/talk.rpy:90
translate russian kylie_talk_stalking_male_cc87b648:
    kylie.say "Я буду хорошей, вот увидишь."

# ch/kylie/talk.rpy:91
translate russian kylie_talk_stalking_male_c93cb220:
    kylie.say "Я обязательно покажу, как сильно тебя люблю."

# ch/kylie/talk.rpy:92
translate russian kylie_talk_stalking_male_ece92dbe:
    kylie.say "Обещаю тебе..."

# ch/kylie/talk.rpy:94
translate russian kylie_talk_stalking_male_ecd32bff:
    "Пока она прижимается ко мне, я могу лишь кивать и улыбаться в ответ."

# ch/kylie/talk.rpy:95
translate russian kylie_talk_stalking_male_452ded3b:
    "Господи, помоги: эта девушка пугает и возбуждает меня в равной мере."

# ch/kylie/talk.rpy:96
translate russian kylie_talk_stalking_male_ebb95587:
    "Надеюсь, я поступил правильно..."

# ch/kylie/talk.rpy:104
translate russian kylie_talk_love_male_6010366e:
    kylie.say "Любовь — это глубокое чувство, когда другой человек нужен тебе больше воздуха."

# ch/kylie/talk.rpy:112
translate russian kylie_talk_sex_male_57a17456:
    kylie.say "Секс..."

