# ch/kylie/date.rpy:130
translate russian kylie_date_play_arcade_intro_male_507da80f:
    "В глазах у неё изумление, взгляд почти стеклянный!"

# ch/kylie/date.rpy:131
translate russian kylie_date_play_arcade_intro_male_aeb838e1:
    "Наверное, видеоигры нравятся ей больше, чем она показывала."

# ch/kylie/date.rpy:132
translate russian kylie_date_play_arcade_intro_male_202916b2:
    mike.say "Ну что, Кайли..."

# ch/kylie/date.rpy:133
translate russian kylie_date_play_arcade_intro_male_940c7b39:
    mike.say "Нравится?"

# ch/kylie/date.rpy:134
translate russian kylie_date_play_arcade_intro_male_a16350b7:
    "Кайли оглядывается и останавливает взгляд на мне."

# ch/kylie/date.rpy:135
translate russian kylie_date_play_arcade_intro_male_d181e72b:
    "Но ей приходится встряхнуть головой, чтобы меня заметить."

# ch/kylie/date.rpy:136
translate russian kylie_date_play_arcade_intro_male_862efd7a:
    "Словно мигающие огни и постоянный шум унесли её в другой мир."

# ch/kylie/date.rpy:137
translate russian kylie_date_play_arcade_intro_male_45cb81a2:
    kylie.say "О... да, [lssb_kylie.hero_name()]..."

# ch/kylie/date.rpy:138
translate russian kylie_date_play_arcade_intro_male_62b02b21:
    kylie.say "Прости, я замечталась!"

# ch/kylie/date.rpy:139
translate russian kylie_date_play_arcade_intro_male_4b1f02b6:
    kylie.say "Здесь здорово! Но во что будем играть?"

# ch/kylie/date.rpy:140
translate russian kylie_date_play_arcade_intro_male_51cd4ed9:
    "Мы с Кайли некоторое время оглядываемся."

# ch/kylie/date.rpy:141
translate russian kylie_date_play_arcade_intro_male_91d82b6a:
    "Затем её внимание привлекает старый игровой автомат."

# ch/kylie/date.rpy:142
translate russian kylie_date_play_arcade_intro_male_642a01f7:
    kylie.say "О чём эта игра?"

# ch/kylie/date.rpy:143
translate russian kylie_date_play_arcade_intro_male_4eee36cf:
    kylie.say "Та, где парень в хоккейной маске?"

# ch/kylie/date.rpy:144
translate russian kylie_date_play_arcade_intro_male_70b904d1:
    mike.say "О, она называется «Бойня», Кайли."

# ch/kylie/date.rpy:145
translate russian kylie_date_play_arcade_intro_male_31639ae9:
    mike.say "А это главный герой. Его зовут Мейсон."

# ch/kylie/date.rpy:146
translate russian kylie_date_play_arcade_intro_male_53515f80:
    kylie.say "Погоди... Этот безумный тип в маске — главный герой?!"

# ch/kylie/date.rpy:147
translate russian kylie_date_play_arcade_intro_male_eaf9ba5e:
    mike.say "Да, Кайли. Маска даёт ему особые силы."

# ch/kylie/date.rpy:148
translate russian kylie_date_play_arcade_intro_male_75e23752:
    mike.say "С их помощью он спасает свою девушку."

# ch/kylie/date.rpy:149
translate russian kylie_date_play_arcade_intro_male_d1a5ebe3:
    kylie.say "Как КРУТО!"

# ch/kylie/date.rpy:150
translate russian kylie_date_play_arcade_intro_male_bc7172f1:
    kylie.say "Хочу в неё поиграть, [lssb_kylie.hero_name()]!"

# ch/kylie/date.rpy:151
translate russian kylie_date_play_arcade_intro_male_d07daad3:
    mike.say "Уверена, Кайли?"

# ch/kylie/date.rpy:152
translate russian kylie_date_play_arcade_intro_male_1d9f070a:
    mike.say "Она очень жестокая и кровавая!"

# ch/kylie/date.rpy:153
translate russian kylie_date_play_arcade_intro_male_597211a5:
    kylie.say "О-о... звучит идеально!"

# ch/kylie/date.rpy:154
translate russian kylie_date_play_arcade_intro_male_a4728ad5:
    "Я подумываю поспорить и предложить что-нибудь другое."

# ch/kylie/date.rpy:155
translate russian kylie_date_play_arcade_intro_male_2d5b6391:
    "Но зачем дарёному коню в зубы смотреть?"

# ch/kylie/date.rpy:156
translate russian kylie_date_play_arcade_intro_male_fada08b8:
    "Девушка, которую я привёл к автоматам, сама просит поиграть."

# ch/kylie/date.rpy:157
translate russian kylie_date_play_arcade_intro_male_5b2f29f9:
    "Какая разница, что игра кровавая?"

# ch/kylie/date.rpy:158
translate russian kylie_date_play_arcade_intro_male_83845184:
    "Я бросаю монеты в щель, и мы начинаем играть по очереди."

# ch/kylie/date.rpy:162
translate russian kylie_date_play_arcade_win_male_273278c6:
    kylie.say "О-о... тесак!"

# ch/kylie/date.rpy:163
translate russian kylie_date_play_arcade_win_male_6244233a:
    kylie.say "О нет, зомби!"

# ch/kylie/date.rpy:164
translate russian kylie_date_play_arcade_win_male_58de82a3:
    kylie.say "Осторожно, [lssb_kylie.hero_name()]!"

# ch/kylie/date.rpy:165
translate russian kylie_date_play_arcade_win_male_9798a1d9:
    "Кайли недолго продержалась за автоматом."

# ch/kylie/date.rpy:166
translate russian kylie_date_play_arcade_win_male_19c69f57:
    "Энтузиазм не заменяет опыт."

# ch/kylie/date.rpy:167
translate russian kylie_date_play_arcade_win_male_ad3d828c:
    "И вскоре ей остаётся лишь смотреть мне через плечо, пока я крошу врагов."

# ch/kylie/date.rpy:168
translate russian kylie_date_play_arcade_win_male_6a4fd3ff:
    "Для меня тем лучше: в этой игре я ветеран."

# ch/kylie/date.rpy:169
translate russian kylie_date_play_arcade_win_male_7332ec6f:
    "Чем больше зомби и упырей превращаю в фарш, тем сильнее нравится Кайли!"

# ch/kylie/date.rpy:170
translate russian kylie_date_play_arcade_win_male_5f17e612:
    kylie.say "О-о... о!"

# ch/kylie/date.rpy:171
translate russian kylie_date_play_arcade_win_male_9b9ccdca:
    kylie.say "Прикончи вон того, [lssb_kylie.hero_name()]!"

# ch/kylie/date.rpy:172
translate russian kylie_date_play_arcade_win_male_88462629:
    kylie.say "Распили его бензопилой!"

# ch/kylie/date.rpy:173
translate russian kylie_date_play_arcade_win_male_99890a41:
    kylie.say "Да... да... ДА!"

# ch/kylie/date.rpy:174
translate russian kylie_date_play_arcade_win_male_b5db4bc0:
    "Теперь Кайли почти висит у меня на спине."

# ch/kylie/date.rpy:175
translate russian kylie_date_play_arcade_win_male_73a5d4e9:
    "Она крепко обхватила меня за талию."

# ch/kylie/date.rpy:176
translate russian kylie_date_play_arcade_win_male_a84c2ede:
    "И я чувствую, как ко мне прижимается её грудь!"

# ch/kylie/date.rpy:177
translate russian kylie_date_play_arcade_win_male_a2a7860a:
    mike.say "Да ничего особенного, Кайли!"

# ch/kylie/date.rpy:178
translate russian kylie_date_play_arcade_win_male_923649ef:
    mike.say "Игра довольно старая."

# ch/kylie/date.rpy:179
translate russian kylie_date_play_arcade_win_male_7c663378:
    mike.say "Нужно просто войти в ритм, вот и всё."

# ch/kylie/date.rpy:180
translate russian kylie_date_play_arcade_win_male_bc7f6098:
    "Кайли обнимает меня сильнее, и я чувствую её губы на своей шее."

# ch/kylie/date.rpy:181
translate russian kylie_date_play_arcade_win_male_71dafb44:
    "Признаюсь, сейчас она меня здорово заводит!"

# ch/kylie/date.rpy:182
translate russian kylie_date_play_arcade_win_male_7c288144:
    kylie.say "Ну нет, [lssb_kylie.hero_name()]..."

# ch/kylie/date.rpy:183
translate russian kylie_date_play_arcade_win_male_9a9211d6:
    kylie.say "Ты отлично умеешь орудовать своим оружием!"

# ch/kylie/date.rpy:184
translate russian kylie_date_play_arcade_win_male_e0849c91:
    kylie.say "А я люблю это в мужчинах..."

# ch/kylie/date.rpy:188
translate russian kylie_date_play_arcade_lose_male_39605da3:
    mike.say "О... о... хватай тесак!"

# ch/kylie/date.rpy:189
translate russian kylie_date_play_arcade_lose_male_fed917be:
    mike.say "Берегись зомби!"

# ch/kylie/date.rpy:190
translate russian kylie_date_play_arcade_lose_male_99c6f05f:
    mike.say "Кайли, сзади!"

# ch/kylie/date.rpy:191
translate russian kylie_date_play_arcade_lose_male_54ed9b83:
    "Мой черёд за автоматом длится недолго."

# ch/kylie/date.rpy:192
translate russian kylie_date_play_arcade_lose_male_957d73c3:
    "Я просто редко играл в эту игру."

# ch/kylie/date.rpy:193
translate russian kylie_date_play_arcade_lose_male_f90fc082:
    "Зато энтузиазм Кайли, похоже, превращается в природный талант!"

# ch/kylie/date.rpy:194
translate russian kylie_date_play_arcade_lose_male_d1f1bcb3:
    "Я смотрю, как она профессионально крошит упырей и зомби."

# ch/kylie/date.rpy:195
translate russian kylie_date_play_arcade_lose_male_0a74823d:
    kylie.say "Ха!"

# ch/kylie/date.rpy:196
translate russian kylie_date_play_arcade_lose_male_28110243:
    kylie.say "Видел, [lssb_kylie.hero_name()]?"

# ch/kylie/date.rpy:197
translate russian kylie_date_play_arcade_lose_male_d43751ef:
    kylie.say "Этот взорвался, когда я в него выстрелила!"

# ch/kylie/date.rpy:198
translate russian kylie_date_play_arcade_lose_male_61356e01:
    kylie.say "Это ПОТРЯСАЮЩЕ!"

# ch/kylie/date.rpy:199
translate russian kylie_date_play_arcade_lose_male_611b718b:
    "Теперь я заглядываю Кайли через плечо."

# ch/kylie/date.rpy:200
translate russian kylie_date_play_arcade_lose_male_014ed167:
    "И в конце концов тоже прижимаюсь к ней."

# ch/kylie/date.rpy:201
translate russian kylie_date_play_arcade_lose_male_161852b8:
    "Пока она рубит и режет, я чувствую её движения."

# ch/kylie/date.rpy:202
translate russian kylie_date_play_arcade_lose_male_aedd769b:
    "Кайли подаётся назад, ко мне."

# ch/kylie/date.rpy:203
translate russian kylie_date_play_arcade_lose_male_bf9a19a2:
    "Трётся задницей о мой пах!"

# ch/kylie/date.rpy:204
translate russian kylie_date_play_arcade_lose_male_aecdd3b7:
    kylie.say "М-м-м..."

# ch/kylie/date.rpy:205
translate russian kylie_date_play_arcade_lose_male_c90047b9:
    kylie.say "Меня это ТАК заводит, [lssb_kylie.hero_name()]."

# ch/kylie/date.rpy:206
translate russian kylie_date_play_arcade_lose_male_aa507eed:
    kylie.say "Люблю большое, мощное оружие!"

# ch/kylie/date.rpy:207
translate russian kylie_date_play_arcade_lose_male_f3d25de3:
    kylie.say "Как то, которое сейчас чувствую..."

# ch/kylie/date.rpy:208
translate russian kylie_date_play_arcade_lose_male_998a7b3f:
    "Я с трудом сглатываю и тяжело дышу."

# ch/kylie/date.rpy:209
translate russian kylie_date_play_arcade_lose_male_0cb5c265:
    "От Кайли у меня уже каменный стояк!"

# ch/kylie/date.rpy:210
translate russian kylie_date_play_arcade_lose_male_b773b9d5:
    kylie.say "Может, покажешь, как орудуешь своим оружием, [lssb_kylie.hero_name()]?"

# ch/kylie/date.rpy:211
translate russian kylie_date_play_arcade_lose_male_205506e3:
    kylie.say "На ощупь оно сейчас очень большое!"

# ch/kylie/date.rpy:219
translate russian kylie_dick_reactions_923bc003:
    kylie.say "Вот он, вот он."

# ch/kylie/date.rpy:220
translate russian kylie_dick_reactions_1b0b56a0:
    kylie.say "Точно такой, каким я его представляла!"

# ch/kylie/date.rpy:221
translate russian kylie_dick_reactions_4337c7ea:
    mike.say "Это хорошо?"

# ch/kylie/date.rpy:222
translate russian kylie_dick_reactions_855a0182:
    kylie.say "Ещё как."

# ch/kylie/date.rpy:224
translate russian kylie_dick_reactions_bf80ed74:
    kylie.say "И я уже знаю: с ним будет так же хорошо, как я воображала!"

# ch/kylie/date.rpy:228
translate russian kylie_dick_reactions_33a25e38:
    kylie.say "Вот ты где, малыш."

# ch/kylie/date.rpy:229
translate russian kylie_dick_reactions_42afac47:
    mike.say "«Малыш»?!"

# ch/kylie/date.rpy:230
translate russian kylie_dick_reactions_1a805381:
    kylie.say "Не волнуйся. Он точно такой, каким я его представляла."

# ch/kylie/date.rpy:232
translate russian kylie_dick_reactions_e14512c4:
    kylie.say "И я уже знаю: с ним будет так же хорошо, как я воображала!"

# ch/kylie/date.rpy:239
translate russian kylie_halloween_invitation_345113ea:
    "Кого ещё приглашать на Хэллоуин, как не Кайли?"

# ch/kylie/date.rpy:240
translate russian kylie_halloween_invitation_b5738ff6:
    "Она весёлая, любит меня до смерти и будет чертовски хороша в костюме."

# ch/kylie/date.rpy:241
translate russian kylie_halloween_invitation_abdef067:
    "К тому же от неё всегда веет чем-то чудаковатым, почти жутковатым."

# ch/kylie/date.rpy:242
translate russian kylie_halloween_invitation_fffbc628:
    "Так что Хэллоуин должен быть ей по душе."

# ch/kylie/date.rpy:243
translate russian kylie_halloween_invitation_c61f2789:
    "Поэтому при следующей встрече я сразу завожу об этом речь."

# ch/kylie/date.rpy:244
translate russian kylie_halloween_invitation_e69bb63a:
    mike.say "Кайли..."

# ch/kylie/date.rpy:245
translate russian kylie_halloween_invitation_9a74b3f2:
    mike.say "Есть планы на Хэллоуин?"

# ch/kylie/date.rpy:246
translate russian kylie_halloween_invitation_7af62ac1:
    kylie.say "Да так, всё как обычно."

# ch/kylie/date.rpy:247
translate russian kylie_halloween_invitation_f022db7d:
    kylie.say "Бродить по улицам, пугать людей..."

# ch/kylie/date.rpy:248
translate russian kylie_halloween_invitation_86d07102:
    mike.say "А..."

# ch/kylie/date.rpy:249
translate russian kylie_halloween_invitation_6a95db90:
    mike.say "Значит, всё ещё ходишь за конфетами?"

# ch/kylie/date.rpy:250
translate russian kylie_halloween_invitation_9af282e8:
    mike.say "В твоём возрасте это не странновато?"

# ch/kylie/date.rpy:251
translate russian kylie_halloween_invitation_ec5965cb:
    "На мгновение Кайли озадаченно смотрит на меня."

# ch/kylie/date.rpy:253
translate russian kylie_halloween_invitation_f52dd000:
    "Затем словно приходит в себя и смеётся."

# ch/kylie/date.rpy:254
translate russian kylie_halloween_invitation_ae384b75:
    kylie.say "За конфетами..."

# ch/kylie/date.rpy:257
translate russian kylie_halloween_invitation_b576c72a:
    kylie.say "Ага... именно это я имела в виду."

# ch/kylie/date.rpy:259
translate russian kylie_halloween_invitation_0f8d12fd:
    kylie.say "Конечно же это!"

# ch/kylie/date.rpy:260
translate russian kylie_halloween_invitation_4fbb4ad6:
    kylie.say "Наверное, в душе я всё ещё большой ребёнок!"

# ch/kylie/date.rpy:261
translate russian kylie_halloween_invitation_ae4001dd:
    "Ладно, это было немного странно."

# ch/kylie/date.rpy:262
translate russian kylie_halloween_invitation_6de3d119:
    "Но уверен, волноваться не о чем."

# ch/kylie/date.rpy:263
translate russian kylie_halloween_invitation_fa648c16:
    "Вернёмся к более насущному вопросу: вечеринке и приглашению Кайли пойти со мной."

# ch/kylie/date.rpy:264
translate russian kylie_halloween_invitation_d87d05ca:
    mike.say "Ладно, Кайли."

# ch/kylie/date.rpy:265
translate russian kylie_halloween_invitation_bb5971c2:
    mike.say "Просто у нас дома будет вечеринка на Хэллоуин."

# ch/kylie/date.rpy:266
translate russian kylie_halloween_invitation_10707f09:
    mike.say "И я хотел пригласить тебя пойти со мной."

# ch/kylie/date.rpy:269
translate russian kylie_halloween_invitation_0403b921:
    "Кайли прищуривается."

# ch/kylie/date.rpy:270
translate russian kylie_halloween_invitation_441d82c8:
    "На миг я уверен, что она откажет."

# ch/kylie/date.rpy:271
translate russian kylie_halloween_invitation_1b53d18a:
    kylie.say "Да, [lssb_kylie.hero_name()]."

# ch/kylie/date.rpy:273
translate russian kylie_halloween_invitation_580ae407:
    kylie.say "Я пойду с тобой на вечеринку."

# ch/kylie/date.rpy:274
translate russian kylie_halloween_invitation_6b847365:
    mike.say "Отлично, Кайли!"

# ch/kylie/date.rpy:275
translate russian kylie_halloween_invitation_0cff93d3:
    mike.say "Здорово проведём время!"

# ch/kylie/date.rpy:276
translate russian kylie_halloween_invitation_c26d105d:
    "Кайли улыбается мне."

# ch/kylie/date.rpy:277
translate russian kylie_halloween_invitation_ff12447f:
    "Но затем склоняет голову набок."

# ch/kylie/date.rpy:278
translate russian kylie_halloween_invitation_54124de8:
    kylie.say "Скажи, [lssb_kylie.hero_name()]."

# ch/kylie/date.rpy:279
translate russian kylie_halloween_invitation_67a86856:
    kylie.say "На вечеринке будут другие девушки?"

# ch/kylie/date.rpy:280
translate russian kylie_halloween_invitation_2969c966:
    "Вопрос такой странный и неожиданный."

# ch/kylie/date.rpy:281
translate russian kylie_halloween_invitation_2de79bb6:
    "Конечно, там будут другие девушки."

# ch/kylie/date.rpy:282
translate russian kylie_halloween_invitation_600613b3:
    "Но при чём тут её приглашение?"

# ch/kylie/date.rpy:283
translate russian kylie_halloween_invitation_72822a28:
    mike.say "Эм... да, Кайли."

# ch/kylie/date.rpy:284
translate russian kylie_halloween_invitation_d24e2faf:
    mike.say "Мои соседки точно будут."

# ch/kylie/date.rpy:285
translate russian kylie_halloween_invitation_485e5476:
    mike.say "И, наверное, пригласят ещё девушек."

# ch/kylie/date.rpy:286
translate russian kylie_halloween_invitation_01c007eb:
    mike.say "Это проблема?"

# ch/kylie/date.rpy:287
translate russian kylie_halloween_invitation_db5c8b8e:
    kylie.say "Просто хочу знать, с чем придётся иметь дело."

# ch/kylie/date.rpy:288
translate russian kylie_halloween_invitation_96170615:
    kylie.say "Другие девушки весь вечер будут на тебя смотреть."

# ch/kylie/date.rpy:290
translate russian kylie_halloween_invitation_62b22300:
    kylie.say "Поэтому мне нужно показать им, что ты только мой!"

# ch/kylie/date.rpy:291
translate russian kylie_halloween_invitation_21be2ad4:
    "Я невольно нервно смеюсь."

# ch/kylie/date.rpy:292
translate russian kylie_halloween_invitation_871b7d9c:
    "Кайли произнесла это с таким напором."

# ch/kylie/date.rpy:293
translate russian kylie_halloween_invitation_1d986b40:
    "Не знай я её лучше, мог бы и испугаться!"

# ch/kylie/date.rpy:294
translate russian kylie_halloween_invitation_94e301d0:
    "Но, наверное, мне должно быть лестно."

# ch/kylie/date.rpy:295
translate russian kylie_halloween_invitation_f3f26014:
    "Она правда считает меня настолько привлекательным!"

# ch/kylie/date.rpy:296
translate russian kylie_halloween_invitation_240b8ea1:
