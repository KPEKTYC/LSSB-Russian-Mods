translate russian kylie_halloween_arrival_d37c3be3:
    "От потрясения всё ещё немного кружится голова."

# ch/kylie/date.rpy:448
translate russian kylie_halloween_arrival_b3367784:
    "Но вид лица Кайли мгновенно приводит меня в чувство."

# ch/kylie/date.rpy:449
translate russian kylie_halloween_arrival_9a72d8d1:
    mike.say "Я... я... Костюм потрясающий, Кайли!"

# ch/kylie/date.rpy:450
translate russian kylie_halloween_arrival_b00f89a1:
    mike.say "Ты меня до смерти напугала!"

# ch/kylie/date.rpy:452
translate russian kylie_halloween_arrival_46a90d47:
    "Кайли радостно хихикает."

# ch/kylie/date.rpy:453
translate russian kylie_halloween_arrival_240b57c7:
    "В глазах странный огонёк, почти безумие."

# ch/kylie/date.rpy:454
translate russian kylie_halloween_arrival_75246bb5:
    "Но я списываю это на предвкушение вечеринки."

# ch/kylie/date.rpy:456
translate russian kylie_halloween_arrival_831440f8:
    kylie.say "Видишь, [lssb_kylie.hero_name()]? Я знала, что тебе понравится."

# ch/kylie/date.rpy:457
translate russian kylie_halloween_arrival_f63d5af4:
    kylie.say "Даже топор настоящий взяла — для правдоподобия!"

# ch/kylie/date.rpy:458
translate russian kylie_halloween_arrival_23a035bc:
    "Словно в доказательство, Кайли снова протягивает топор."

# ch/kylie/date.rpy:459
translate russian kylie_halloween_arrival_0257d8e8:
    "Так близко, что чуть не срезает мне нос."

# ch/kylie/date.rpy:460
translate russian kylie_halloween_arrival_48919cb3:
    "И я вижу: она не шутит."

# ch/kylie/date.rpy:461
translate russian kylie_halloween_arrival_f1d8a63c:
    mike.say "Эм..."

# ch/kylie/date.rpy:462
translate russian kylie_halloween_arrival_3219d747:
    mike.say "Может, оставим его в прихожей, Кайли?"

# ch/kylie/date.rpy:463
translate russian kylie_halloween_arrival_0fa5b7e0:
    mike.say "Мы же не хотим случайно кого-нибудь порубить."

# ch/kylie/date.rpy:464
translate russian kylie_halloween_arrival_1ad1bb76:
    mike.say "Правда?"

# ch/kylie/date.rpy:466
translate russian kylie_halloween_arrival_599635fa:
    "Кайли вздыхает, но выполняет просьбу."

# ch/kylie/date.rpy:467
translate russian kylie_halloween_arrival_714f04c2:
    kylie.say "Может, ты и не хочешь..."

# ch/kylie/date.rpy:469
translate russian kylie_halloween_arrival_ca57f9d8:
    mike.say "Господи, Кайли."

# ch/kylie/date.rpy:470
translate russian kylie_halloween_arrival_b00f89a1_1:
    mike.say "Ты меня до смерти напугала!"

# ch/kylie/date.rpy:472
translate russian kylie_halloween_arrival_6aa8d3d3:
    "Мой ответ сразу её огорчает."

# ch/kylie/date.rpy:473
translate russian kylie_halloween_arrival_cb18225e:
    "Ведь очевидно, что я не в восторге."

# ch/kylie/date.rpy:474
translate russian kylie_halloween_arrival_803bb24a:
    kylie.say "Что не так, [lssb_kylie.hero_name()]?"

# ch/kylie/date.rpy:475
translate russian kylie_halloween_arrival_079b8c06:
    kylie.say "Тебе не нравится мой костюм?"

# ch/kylie/date.rpy:476
translate russian kylie_halloween_arrival_1ae5bcf5:
    mike.say "Нет, Кайли, дело не в костюме."

# ch/kylie/date.rpy:477
translate russian kylie_halloween_arrival_64a09242:
    mike.say "А в том, что ты нападаешь на меня с топором!"

# ch/kylie/date.rpy:478
translate russian kylie_halloween_arrival_53c15831:
    mike.say "Хорошо хоть топор поролоновый..."

# ch/kylie/date.rpy:480
translate russian kylie_halloween_arrival_62eded3f:
    "Произнося это, я смотрю Кайли прямо в глаза."

# ch/kylie/date.rpy:481
translate russian kylie_halloween_arrival_f081c6f0:
    "И жду, что она подтвердит."

# ch/kylie/date.rpy:482
translate russian kylie_halloween_arrival_87d4329f:
    mike.say "Он ведь не поролоновый, да?"

# ch/kylie/date.rpy:483
translate russian kylie_halloween_arrival_960f8ad9:
    "Кайли качает головой."

# ch/kylie/date.rpy:484
translate russian kylie_halloween_arrival_3ff1fbd0:
    kylie.say "Я... я хотела, чтобы костюм был как можно правдоподобнее!"

# ch/kylie/date.rpy:485
translate russian kylie_halloween_arrival_f6b7e7cb:
    mike.say "Слушай, просто оставь топор в прихожей, ладно?"

# ch/kylie/date.rpy:486
translate russian kylie_halloween_arrival_83725568:
    mike.say "Может, тогда повеселимся без настоящих жертв?"

# ch/kylie/date.rpy:489
translate russian kylie_halloween_arrival_8b871221:
    kylie.say "А, ладно... ладно..."

# ch/kylie/date.rpy:490
translate russian kylie_halloween_arrival_1091484b:
    kylie.say "Зануда..."

# ch/kylie/date.rpy:500
translate russian kylie_halloween_party_2001d72e:
    kylie.say "[lssb_kylie.hero_name()]..."

# ch/kylie/date.rpy:501
translate russian kylie_halloween_party_120923cc:
    kylie.say "Мне ужасно надо пописать!"

# ch/kylie/date.rpy:502
translate russian kylie_halloween_party_d754ef43:
    "Я собираюсь объяснить Кайли, где ванная."

# ch/kylie/date.rpy:506
translate russian kylie_halloween_party_7910499a:
    "Но тут [bree.name] наклоняется к нам и опережает меня."

# ch/kylie/date.rpy:507
translate russian kylie_halloween_party_8d8cf86b:
    "Наверное, услышала наш разговор."

# ch/kylie/date.rpy:508
translate russian kylie_halloween_party_e7ff2f13:
    bree.say "По коридору и налево!"

# ch/kylie/date.rpy:510
translate russian kylie_halloween_party_010a0b80:
    "К моему удивлению, Кайли никуда не идёт."

# ch/kylie/date.rpy:511
translate russian kylie_halloween_party_9d87ea37:
    "Вместо этого она зло смотрит туда, где стоит [bree.name]."

# ch/kylie/date.rpy:512
translate russian kylie_halloween_party_f0f413d7:
    kylie.say "Я знаю, где она."

# ch/kylie/date.rpy:513
translate russian kylie_halloween_party_aaa853bf:
    kylie.say "Не нужна мне твоя помощь, блондиночка!"

# ch/kylie/date.rpy:515
translate russian kylie_halloween_party_7770d5bc:
    "[bree.name] разевает рот от выпада Кайли."

# ch/kylie/date.rpy:516
translate russian kylie_halloween_party_94966ff5:
    bree.say "Эй!"

# ch/kylie/date.rpy:518
translate russian kylie_halloween_party_804e2620:
    bree.say "[lssb_kylie.hero_name()], ты позволишь ей так со мной разговаривать?!"

# ch/kylie/date.rpy:521
translate russian kylie_halloween_party_f1d8a63c:
    mike.say "Эм..."

# ch/kylie/date.rpy:522
translate russian kylie_halloween_party_69fea848:
    mike.say "Ей не нужна экскурсия, [bree.name]."

# ch/kylie/date.rpy:523
translate russian kylie_halloween_party_21350807:
    mike.say "Ей просто нужно в туалет!"

# ch/kylie/date.rpy:527
translate russian kylie_halloween_party_e77cc989:
    "По лицу Кайли расплывается торжествующая улыбка."

# ch/kylie/date.rpy:528
translate russian kylie_halloween_party_e0c42ed8:
    "Но [bree.name] хмурится и качает головой, глядя на меня."

# ch/kylie/date.rpy:530
translate russian kylie_halloween_party_36782c78:
    bree.say "Господи, [lssb_kylie.hero_name()], полегче!"

# ch/kylie/date.rpy:531
translate russian kylie_halloween_party_176addb8:
    bree.say "Я просто хотела помочь."

# ch/kylie/date.rpy:532
translate russian kylie_halloween_party_b870c685:
    "Кайли усмехается."

# ch/kylie/date.rpy:533
translate russian kylie_halloween_party_ca80f402:
    "Затем качает головой, глядя туда, где стоит [bree.name]."

# ch/kylie/date.rpy:534
translate russian kylie_halloween_party_f6affe87:
    kylie.say "Ха..."

# ch/kylie/date.rpy:535
translate russian kylie_halloween_party_dae0ca75:
    kylie.say "Я вижу тебя насквозь, [bree.name]."

# ch/kylie/date.rpy:536
translate russian kylie_halloween_party_74f30c77:
    kylie.say "Думаешь, [lssb_kylie.hero_name()] впечатлится?"

# ch/kylie/date.rpy:538
translate russian kylie_halloween_party_b437cdcc:
    bree.say "Ч... что ты вообще несёшь?!"

# ch/kylie/date.rpy:539
translate russian kylie_halloween_party_9de0a9b1:
    "Я собираюсь что-то сказать."

# ch/kylie/date.rpy:540
translate russian kylie_halloween_party_e9192d88:
    "Но Кайли уводит меня, прежде чем я успеваю открыть рот."

# ch/kylie/date.rpy:542
translate russian kylie_halloween_party_4ec8b671:
    mike.say "Эй, Кайли!"

# ch/kylie/date.rpy:543
translate russian kylie_halloween_party_ce6dd307:
    mike.say "Это было лишнее."

# ch/kylie/date.rpy:544
translate russian kylie_halloween_party_0a13252c:
    mike.say "[bree.name] просто хотела помочь!"

# ch/kylie/date.rpy:550
translate russian kylie_halloween_party_02c73814:
    "От моих слов [bree.name] сразу успокаивается."

# ch/kylie/date.rpy:551
translate russian kylie_halloween_party_2780b796:
    "А вот на Кайли они действуют прямо противоположно."

# ch/kylie/date.rpy:552
translate russian kylie_halloween_party_b77a4223:
    "Она чуть ли не рычит на другую девушку."

# ch/kylie/date.rpy:553
translate russian kylie_halloween_party_cb912690:
    kylie.say "Да, [bree.name]."

# ch/kylie/date.rpy:554
translate russian kylie_halloween_party_b64267a7:
    kylie.say "Ты бы хотела, чтобы все так думали."

# ch/kylie/date.rpy:555
translate russian kylie_halloween_party_7091f8a0:
    kylie.say "Но я знаю твою игру."

# ch/kylie/date.rpy:556
translate russian kylie_halloween_party_b889937f:
    kylie.say "И слежу за тобой!"

# ch/kylie/date.rpy:557
translate russian kylie_halloween_party_d79ce210:
    "Я изо всех сил пытаюсь сменить тему."

# ch/kylie/date.rpy:558
translate russian kylie_halloween_party_c613f342:
    mike.say "Эм, Кайли..."

# ch/kylie/date.rpy:559
translate russian kylie_halloween_party_be5a73e1:
    mike.say "Разве тебе не нужно в туалет?"

# ch/kylie/date.rpy:561
translate russian kylie_halloween_party_93fb4c97:
    kylie.say "Лучше в трусики написаю, чем оставлю тебя с ней!"

# ch/kylie/date.rpy:564
translate russian kylie_halloween_party_94606fbf:
    "Мне остаётся лишь взять Кайли под руку и увести."

# ch/kylie/date.rpy:575
translate russian kylie_halloween_dance_5237516f:
    sasha.say "Эй, [lssb_kylie.hero_name()]."

# ch/kylie/date.rpy:576
translate russian kylie_halloween_dance_056595fd:
    sasha.say "Под эту песню надо потанцевать!"

# ch/kylie/date.rpy:577
translate russian kylie_halloween_dance_f1f96714:
    "Я оборачиваюсь: Саша зовёт меня на импровизированный танцпол."

# ch/kylie/date.rpy:578
translate russian kylie_halloween_dance_ae1b759e:
    "Играет классическая песня Metallikea, которую мы оба любим."

# ch/kylie/date.rpy:579
translate russian kylie_halloween_dance_8a65baf0:
    "Очень хочется принять приглашение."

# ch/kylie/date.rpy:580
translate russian kylie_halloween_dance_b1632ca0:
    "Проблема лишь в том, что Кайли ещё в ванной."

# ch/kylie/date.rpy:581
translate russian kylie_halloween_dance_2402c92a:
    "Если пойду танцевать с Сашей, оставлю свою спутницу одну."

# ch/kylie/date.rpy:584
translate russian kylie_halloween_dance_27f3774c:
    mike.say "С удовольствием бы, Саша."

# ch/kylie/date.rpy:585
translate russian kylie_halloween_dance_a3bbdb16:
    mike.say "Но я сейчас жду Кайли."

# ch/kylie/date.rpy:587
translate russian kylie_halloween_dance_b3b91c5e:
    "Саша выглядит разочарованной отказом."

# ch/kylie/date.rpy:588
translate russian kylie_halloween_dance_56ddd1e2:
    "Но всё же понимающе кивает."

# ch/kylie/date.rpy:590
translate russian kylie_halloween_dance_519ead00:
    sasha.say "Ладно, как хочешь."

# ch/kylie/date.rpy:592
translate russian kylie_halloween_dance_198b510b:
    "И отправляется танцевать одна."

# ch/kylie/date.rpy:594
translate russian kylie_halloween_dance_971dfa93:
    "Миг спустя рядом снова появляется Кайли."

# ch/kylie/date.rpy:595
translate russian kylie_halloween_dance_03ec4eb3:
    kylie.say "Почему ты разговаривал с этой рокершей?"

# ch/kylie/date.rpy:596
translate russian kylie_halloween_dance_b69545df:
    kylie.say "Чего она хотела?"

# ch/kylie/date.rpy:597
translate russian kylie_halloween_dance_fe46ccc4:
    mike.say "Саша просто пригласила меня потанцевать, вот и всё."

# ch/kylie/date.rpy:598
translate russian kylie_halloween_dance_df1fd6ed:
    kylie.say "Ах вот как!"

# ch/kylie/date.rpy:599
translate russian kylie_halloween_dance_c4dee1ec:
    mike.say "Да, но я сказал, что жду тебя."

# ch/kylie/date.rpy:604
translate russian kylie_halloween_dance_75acac3c:
    "После этих слов тон Кайли полностью меняется."

# ch/kylie/date.rpy:605
translate russian kylie_halloween_dance_b94b78d7:
    "Только что она будто злилась на меня."

# ch/kylie/date.rpy:606
translate russian kylie_halloween_dance_a8479b28:
    "А теперь вдруг пришла в восторг."

# ch/kylie/date.rpy:608
translate russian kylie_halloween_dance_9d741e28:
    kylie.say "Ну и чего мы ждём?"

# ch/kylie/date.rpy:609
translate russian kylie_halloween_dance_0cc6151d:
    kylie.say "Пойдём танцевать!"

# ch/kylie/date.rpy:612
translate russian kylie_halloween_dance_24ed6e0b:
    "Кайли почти волоком тащит меня на танцпол."

# ch/kylie/date.rpy:613
translate russian kylie_halloween_dance_b5d514f5:
    "И с самого начала прилипает ко мне намертво."

# ch/kylie/date.rpy:614
translate russian kylie_halloween_dance_5134b584:
    "Всё время сверля взглядом каждого, кто приближается."

# ch/kylie/date.rpy:615
translate russian kylie_halloween_dance_71bf181d:
    "Напоминает львицу, отпугивающую соперниц."

# ch/kylie/date.rpy:616
translate russian kylie_halloween_dance_b125c56c:
    "Возможно, это звучит странно."

# ch/kylie/date.rpy:617
translate russian kylie_halloween_dance_164705e7:
    "Но меня такое немного заводит."

# ch/kylie/date.rpy:618
translate russian kylie_halloween_dance_7c5730e3:
    "Словно она так сильно хочет меня, что готова за меня драться!"

# ch/kylie/date.rpy:619
translate russian kylie_halloween_dance_05c5ca09:
    "К концу танца я совсем теряю голову."

# ch/kylie/date.rpy:621
translate russian kylie_halloween_dance_07505afa:
    mike.say "Отличная идея, Саша."

# ch/kylie/date.rpy:622
translate russian kylie_halloween_dance_cf70f273:
    mike.say "Кайли присоединится, когда вернётся."

# ch/kylie/date.rpy:626
translate russian kylie_halloween_dance_ab6d520e:
    "Мы с Сашей спешим на танцпол."

# ch/kylie/date.rpy:627
translate russian kylie_halloween_dance_05ba8764:
    "На пару минут я забываю обо всём."

# ch/kylie/date.rpy:628
translate russian kylie_halloween_dance_436cd63a:
    "Ничего особенного не происходит."

# ch/kylie/date.rpy:629
translate russian kylie_halloween_dance_c1122bfc:
    "Просто танцуем как друзья."

# ch/kylie/date.rpy:631
translate russian kylie_halloween_dance_ca921f0b:
    "Но, когда песня заканчивается, замечаю взгляд Кайли."

# ch/kylie/date.rpy:632
translate russian kylie_halloween_dance_915fa88a:
    "И, боже, как же она зла!"

# ch/kylie/date.rpy:634
translate russian kylie_halloween_dance_bf22ec13:
    "Я тороплюсь к Кайли."

# ch/kylie/date.rpy:635
translate russian kylie_halloween_dance_470767ca:
    "А Саша тем временем уходит в другую сторону."

# ch/kylie/date.rpy:636
translate russian kylie_halloween_dance_c251b179:
    mike.say "Кайли, вот ты где!"

# ch/kylie/date.rpy:637
translate russian kylie_halloween_dance_a5e99cca:
    mike.say "Почему не присоединилась?"

# ch/kylie/date.rpy:640
translate russian kylie_halloween_dance_40960e85:
    kylie.say "Хм!"

# ch/kylie/date.rpy:641
translate russian kylie_halloween_dance_44589c7c:
    kylie.say "Вам, похоже, и без меня было весело."

# ch/kylie/date.rpy:642
translate russian kylie_halloween_dance_f6b611ee:
    mike.say "Ну не надо, Кайли."

# ch/kylie/date.rpy:643
translate russian kylie_halloween_dance_63ded4e2:
    mike.say "Саша просто подруга, вот и всё."

# ch/kylie/date.rpy:644
translate russian kylie_halloween_dance_d3bf96fd:
    kylie.say "Да, [lssb_kylie.hero_name()], она хочет, чтобы ты так думал!"

# ch/kylie/date.rpy:645
translate russian kylie_halloween_dance_bffd83c6:
    kylie.say "Но я за ней слежу."

# ch/kylie/date.rpy:646
translate russian kylie_halloween_dance_b01fc60f:
    "Я стараюсь пропустить слова Кайли мимо ушей."

# ch/kylie/date.rpy:647
translate russian kylie_halloween_dance_31446b92:
    "Она явно преувеличивает, вот и всё."

# ch/kylie/date.rpy:648
