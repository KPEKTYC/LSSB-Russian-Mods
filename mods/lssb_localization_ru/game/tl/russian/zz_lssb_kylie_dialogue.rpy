# ch/kylie/date.rpy:313
translate russian kylie_halloween_invitation_392ba754:
    kylie.say "Мне нравится проводить время с ТОБОЙ."

# ch/kylie/date.rpy:315
translate russian kylie_halloween_invitation_3b0308b9:
    kylie.say "Но делиться тобой я не люблю."

# ch/kylie/date.rpy:316
translate russian kylie_halloween_invitation_ff98fb22:
    kylie.say "Там ведь будут другие девушки?"

# ch/kylie/date.rpy:317
translate russian kylie_halloween_invitation_77a84f82:
    mike.say "Эм... да, наверное."

# ch/kylie/date.rpy:319
translate russian kylie_halloween_invitation_177845dd:
    "Кайли начинает дуться."

# ch/kylie/date.rpy:320
translate russian kylie_halloween_invitation_f600a434:
    kylie.say "И будут смотреть на тебя весь вечер!"

# ch/kylie/date.rpy:322
translate russian kylie_halloween_invitation_c5dd8fe3:
