# ch/kylie/events.rpy:892
translate russian kylie_breakup_2_8816a892:
    alexis.say "Всё хорошо, [lssb_kylie.hero_name()], я понимаю."

# ch/kylie/events.rpy:893
translate russian kylie_breakup_2_07938128:
