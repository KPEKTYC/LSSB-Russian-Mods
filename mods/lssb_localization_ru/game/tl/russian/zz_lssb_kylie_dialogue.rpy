# ch/kylie/date.rpy:340
translate russian kylie_halloween_crash_83802dd3:
    "Кто бы это мог быть?"

# ch/kylie/date.rpy:341
translate russian kylie_halloween_crash_93c19799:
    "Разве все приглашённые уже не здесь?"

# ch/kylie/date.rpy:343
translate russian kylie_halloween_crash_26a0215a:
