# ch/kylie/date.rpy:306
translate russian kylie_halloween_invitation_24c2a0a7:
    kylie.say "Нет, [lssb_kylie.hero_name()]."

# ch/kylie/date.rpy:307
translate russian kylie_halloween_invitation_9647fb01:
    kylie.say "Я не хочу на твою вечеринку."

# ch/kylie/date.rpy:308
translate russian kylie_halloween_invitation_63568193:
    "На миг я теряю дар речи."

# ch/kylie/date.rpy:309
translate russian kylie_halloween_invitation_571d57dd:
    "Но затем достаточно прихожу в себя, чтобы ответить."

# ch/kylie/date.rpy:310
translate russian kylie_halloween_invitation_93ef1cbf:
    mike.say "Но почему, Кайли?"

# ch/kylie/date.rpy:311
translate russian kylie_halloween_invitation_8c151daa:
    mike.say "Я думал, тебе нравится проводить время со мной."

# ch/kylie/date.rpy:312
translate russian kylie_halloween_invitation_e9dc80fe:
