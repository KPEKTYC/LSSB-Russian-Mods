# ch/kylie/date.rpy:323
translate russian kylie_halloween_invitation_e273d3fd:
    kylie.say "Даже не знаю, что могу сделать!"

# ch/kylie/date.rpy:324
translate russian kylie_halloween_invitation_cc1474f7:
    mike.say "Ну... если так рассуждать..."

# ch/kylie/date.rpy:326
translate russian kylie_halloween_invitation_a7dd7b7c:
    kylie.say "Эй, придумала!"

# ch/kylie/date.rpy:327
translate russian kylie_halloween_invitation_dc476d06:
    kylie.say "Давай устроим свою вечеринку. Только ты и я."

# ch/kylie/date.rpy:328
translate russian kylie_halloween_invitation_d430c3ac:
    kylie.say "Подумай, [lssb_kylie.hero_name()]."

# ch/kylie/date.rpy:330
translate russian kylie_halloween_invitation_8f3cc283:
    kylie.say "Обещаю, будет убийственно!"

# ch/kylie/date.rpy:331
translate russian kylie_halloween_invitation_8e453e48:
    "Я киваю, и мы пока оставляем тему."

# ch/kylie/date.rpy:332
translate russian kylie_halloween_invitation_b2bb5938:
