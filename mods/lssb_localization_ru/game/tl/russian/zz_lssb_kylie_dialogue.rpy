# ch/kylie/events.rpy:840
translate russian kylie_breakup_2_b6ffe139:
    "Я откидываюсь на спинку стула и неверяще качаю головой."

# ch/kylie/events.rpy:841
translate russian kylie_breakup_2_97cbb51f:
