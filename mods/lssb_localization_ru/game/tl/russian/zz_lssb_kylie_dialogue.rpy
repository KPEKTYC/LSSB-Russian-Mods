# ch/kylie/events.rpy:899
translate russian kylie_breakup_2_4b1f812d:
    "Алексис снова улыбается."

# ch/kylie/events.rpy:900
translate russian kylie_breakup_2_6c4f231b:
    "Но тут раздаётся звук её телефона, и она слегка хмурится."

# ch/kylie/events.rpy:901
translate russian kylie_breakup_2_b1e3b8d0:
