# ch/lavish/events.rpy:3125
translate russian lavish_spanking_2_4bea8a09:
    lavish.say "О, прости, [lssb_lavish.hero_name()]!"

# ch/lavish/events.rpy:3127
translate russian lavish_spanking_2_e8ddeb72:
    lavish.say "Я думала, что справлюсь. Правда думала."

# ch/lavish/events.rpy:3128
translate russian lavish_spanking_2_16e3345e:
