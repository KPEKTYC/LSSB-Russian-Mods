# ch/lavish/gift.rpy:176
translate russian lavish_birthday_gift_male_b3f90c91:
    mike.say "С днём рождения, Лавиш."

# ch/lavish/gift.rpy:177
translate russian lavish_birthday_gift_male_2a962666:
