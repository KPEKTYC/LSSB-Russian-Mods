# ch/lavish/gift.rpy:198
translate russian lavish_gift_swimsuit_male_897e6866:
    lavish.say "Это вульгарно."

# ch/lavish/gift.rpy:206
translate russian lavish_gift_sexy_dress_male_6a63a0d4:
