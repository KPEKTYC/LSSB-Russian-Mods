translate russian lavish_date_play_arcade_lose_male_f507adf2:
    mike.say "Только не говори, кого тебе напоминает извращенец."

# ch/lavish/date.rpy:185
translate russian lavish_date_play_arcade_lose_male_9693989e:
    mike.say "Хочу сам угадать!"

# ch/lavish/date.rpy:186
translate russian lavish_date_play_arcade_lose_male_3bf2f0bf:
    lavish.say "Ладно, [lssb_lavish.hero_name()], как скажешь..."

# ch/lavish/date.rpy:194
translate russian lavish_dick_reactions_45e45df6:
    lavish.say "А у тебя там и правда большой!"

# ch/lavish/date.rpy:195
translate russian lavish_dick_reactions_fed892f4:
    mike.say "Это ведь не проблема?"

# ch/lavish/date.rpy:196
translate russian lavish_dick_reactions_016ec923:
    lavish.say "О нет... совсем нет."

# ch/lavish/date.rpy:198
translate russian lavish_dick_reactions_1a26754b:
    lavish.say "Просто надеюсь, он в меня поместится!"

# ch/lavish/date.rpy:202
translate russian lavish_dick_reactions_44f1c79e:
    lavish.say "Он уже больше не станет?"

# ch/lavish/date.rpy:203
translate russian lavish_dick_reactions_ba0807d8:
    mike.say "Эм... да, это всё."

# ch/lavish/date.rpy:204
translate russian lavish_dick_reactions_fed892f4_1:
    mike.say "Это ведь не проблема?"

# ch/lavish/date.rpy:206
translate russian lavish_dick_reactions_016ec923_1:
    lavish.say "О нет... совсем нет."

# ch/lavish/date.rpy:207
translate russian lavish_dick_reactions_6520615a:
    lavish.say "Места для него предостаточно!"

# ch/lavish/date.rpy:214
translate russian lavish_halloween_invitation_76626b8c:
    "Едва мы решаем устроить вечеринку на Хэллоуин, я уже думаю о другом."

# ch/lavish/date.rpy:215
translate russian lavish_halloween_invitation_02888ad1:
    "А именно — кого пригласить, чтобы провести этот вечер вместе."

# ch/lavish/date.rpy:216
translate russian lavish_halloween_invitation_3c9452fc:
    "И довольно быстро понимаю: хочу, чтобы рядом со мной была Лавиш."

# ch/lavish/date.rpy:217
translate russian lavish_halloween_invitation_958c4a34:
    "Поэтому при первой же возможности спрашиваю её."

# ch/lavish/date.rpy:218
translate russian lavish_halloween_invitation_f04f9a80:
    mike.say "Слушай, Лавиш..."

# ch/lavish/date.rpy:219
translate russian lavish_halloween_invitation_e8a47adc:
    mike.say "Ты случайно не занята на Хэллоуин?"

# ch/lavish/date.rpy:220
translate russian lavish_halloween_invitation_a149550b:
    "Лавиш смотрит на меня с интересом."

# ch/lavish/date.rpy:221
translate russian lavish_halloween_invitation_a142519d:
    "При этом она склоняет голову набок."

# ch/lavish/date.rpy:222
translate russian lavish_halloween_invitation_e5ca786e:
    lavish.say "О..."

# ch/lavish/date.rpy:223
translate russian lavish_halloween_invitation_20b9f754:
    lavish.say "Эм, нет... я пока ничего точно не планировала."

# ch/lavish/date.rpy:224
translate russian lavish_halloween_invitation_504fb3c8:
    lavish.say "А что? У тебя есть идеи?"

# ch/lavish/date.rpy:225
translate russian lavish_halloween_invitation_cbad4704:
    "Ещё какие, Лавиш!"

# ch/lavish/date.rpy:226
translate russian lavish_halloween_invitation_c686fe06:
    "По крайней мере, именно это я думаю, услышав вопрос."

# ch/lavish/date.rpy:227
translate russian lavish_halloween_invitation_1e61f78c:
    "Но вслух мне каким-то образом удаётся ответить сдержаннее."

# ch/lavish/date.rpy:228
translate russian lavish_halloween_invitation_1c0d45e8:
    mike.say "Ну..."

# ch/lavish/date.rpy:229
translate russian lavish_halloween_invitation_a141f622:
    mike.say "Мы с соседками устраиваем вечеринку на Хэллоуин."

# ch/lavish/date.rpy:230
translate russian lavish_halloween_invitation_98cba4e9:
    mike.say "Ничего грандиозного, просто домашняя вечеринка, понимаешь?"

# ch/lavish/date.rpy:232
translate russian lavish_halloween_invitation_d52729a3:
    "Лавиш приподнимает брови, явно заинтересовавшись."

# ch/lavish/date.rpy:233
translate russian lavish_halloween_invitation_f8251f9c:
    lavish.say "И ты хотел меня пригласить?"

# ch/lavish/date.rpy:234
translate russian lavish_halloween_invitation_c3d74e3f:
    mike.say "Д-да, Лавиш!"

# ch/lavish/date.rpy:235
translate russian lavish_halloween_invitation_b2a0f682:
    mike.say "Конечно хотел!"

# ch/lavish/date.rpy:236
translate russian lavish_halloween_invitation_c9e0f742:
    mike.say "Если ты сама хочешь прийти?"

# ch/lavish/date.rpy:237
translate russian lavish_halloween_invitation_e90cda17:
    mike.say "Хочешь прийти?"

# ch/lavish/date.rpy:238
translate russian lavish_halloween_invitation_b8fdd100:
    "Лавиш тихонько смеётся над моей реакцией."

# ch/lavish/date.rpy:239
translate russian lavish_halloween_invitation_c524825b:
    "От этого я смущаюсь ещё сильнее."

# ch/lavish/date.rpy:242
translate russian lavish_halloween_invitation_49ae709b:
    "И лишь тогда замечаю улыбку на её лице."

# ch/lavish/date.rpy:243
translate russian lavish_halloween_invitation_e648ed38:
    "Озорную и весьма лукавую."

# ch/lavish/date.rpy:244
translate russian lavish_halloween_invitation_5bb5ca7c:
    lavish.say "Ты уже сказал, что вечеринка на Хэллоуин."

# ch/lavish/date.rpy:245
translate russian lavish_halloween_invitation_ef854312:
    lavish.say "А костюмы будут?"

# ch/lavish/date.rpy:246
translate russian lavish_halloween_invitation_066d375f:
    "Не могу поверить, как мне повезло."

# ch/lavish/date.rpy:247
translate russian lavish_halloween_invitation_24917c66:
    "Вот он, идеальный шанс повернуть всё в нужную мне сторону!"

# ch/lavish/date.rpy:248
translate russian lavish_halloween_invitation_7c942643:
    mike.say "Да, Лавиш!"

# ch/lavish/date.rpy:249
translate russian lavish_halloween_invitation_72366a3d:
    mike.say "Разве я не сказал?"

# ch/lavish/date.rpy:250
translate russian lavish_halloween_invitation_780436fa:
    mike.say "Без костюма в тот вечер не пустим!"

# ch/lavish/date.rpy:252
translate russian lavish_halloween_invitation_a768eb62:
    "Мне нравится выражение лица Лавиш, когда она это слышит."

# ch/lavish/date.rpy:253
translate russian lavish_halloween_invitation_5525554a:
    "Пока я говорю, она словно на глазах проникается этой идеей."

# ch/lavish/date.rpy:254
translate russian lavish_halloween_invitation_918f60c4:
    "Вот если бы я сразу начал с костюмов."

# ch/lavish/date.rpy:255
translate russian lavish_halloween_invitation_5e71e996:
    "Всё было бы гораздо проще!"

# ch/lavish/date.rpy:256
translate russian lavish_halloween_invitation_2cc8911d:
    lavish.say "О, звучит так весело!"

# ch/lavish/date.rpy:257
translate russian lavish_halloween_invitation_0fd82f7c:
    lavish.say "Мне почти никогда не удаётся куда-нибудь нарядиться."

# ch/lavish/date.rpy:259
translate russian lavish_halloween_invitation_14e958d9:
    lavish.say "И я уже знаю, какой костюм надену."

# ch/lavish/date.rpy:260
translate russian lavish_halloween_invitation_11c9f960:
    mike.say "Так это да?"

# ch/lavish/date.rpy:261
translate russian lavish_halloween_invitation_bb4310cd:
    mike.say "Придёшь на вечеринку?"

# ch/lavish/date.rpy:264
translate russian lavish_halloween_invitation_5e5eadfa:
    "Лавиш с готовностью кивает."

# ch/lavish/date.rpy:265
translate russian lavish_halloween_invitation_4ed955f6:
    "И мне стоит больших усилий не вскинуть кулак от радости."

# ch/lavish/date.rpy:268
translate russian lavish_halloween_invitation_49ae709b_1:
    "И лишь тогда замечаю улыбку на её лице."

# ch/lavish/date.rpy:269
translate russian lavish_halloween_invitation_3f6a653d:
    "Грустную и очень снисходительную. Так что я уже знаю, что услышу."

# ch/lavish/date.rpy:270
translate russian lavish_halloween_invitation_4555b0e4:
    lavish.say "Прости, [lssb_lavish.hero_name()]."

# ch/lavish/date.rpy:271
translate russian lavish_halloween_invitation_5a8e3445:
    lavish.say "Но, кажется, это не совсем моё."

# ch/lavish/date.rpy:272
translate russian lavish_halloween_invitation_d507f350:
    "Я начинаю качать головой ещё до того, как Лавиш заканчивает говорить."

# ch/lavish/date.rpy:273
translate russian lavish_halloween_invitation_d3f6c7b8:
    mike.say "Как это — не твоё, Лавиш?"

# ch/lavish/date.rpy:274
translate russian lavish_halloween_invitation_f7320f09:
    mike.say "Это же вечеринка!"

# ch/lavish/date.rpy:275
translate russian lavish_halloween_invitation_3a7e2a28:
    mike.say "Все любят вечеринки, разве нет?"

# ch/lavish/date.rpy:276
translate russian lavish_halloween_invitation_423a729c:
    "Лавиш всё ещё убивает меня своей улыбкой."

# ch/lavish/date.rpy:277
translate russian lavish_halloween_invitation_4cacee4a:
    "Такой доброжелательной и рассудительной."

# ch/lavish/date.rpy:278
translate russian lavish_halloween_invitation_4a1a815a:
    "И ведь с этой лучезарной улыбкой она такая милая!"

# ch/lavish/date.rpy:279
translate russian lavish_halloween_invitation_66295883:
    lavish.say "Конечно, я люблю вечеринки, [lssb_lavish.hero_name()]."

# ch/lavish/date.rpy:281
translate russian lavish_halloween_invitation_d953b6a3:
    lavish.say "Но там будут все твои друзья."

# ch/lavish/date.rpy:282
translate russian lavish_halloween_invitation_fa851c58:
    lavish.say "И, по-моему, у нас с ними мало общего."

# ch/lavish/date.rpy:283
translate russian lavish_halloween_invitation_f0536531:
    lavish.say "Я только помешаю, когда вам захочется обсудить те подземелья, в которые вы играете!"

# ch/lavish/date.rpy:284
translate russian lavish_halloween_invitation_fed2bc75:
    "Будь прокляты мои гиковские увлечения!"

# ch/lavish/date.rpy:285
translate russian lavish_halloween_invitation_85585e43:
    "Из-за них я упустил шанс прийти на вечеринку с красоткой!"

# ch/lavish/date.rpy:286
translate russian lavish_halloween_invitation_825c669c:
    "Но ничего с этим не поделаешь."

# ch/lavish/date.rpy:287
translate russian lavish_halloween_invitation_661ef531:
    "Если, конечно, я не хочу выглядеть совсем уж жалким и отчаявшимся."

# ch/lavish/date.rpy:292
translate russian lavish_halloween_arrival_6ef5b900:
    "Я на автомате открываю дверь, всё ещё думая о вечеринке."

# ch/lavish/date.rpy:293
translate russian lavish_halloween_arrival_ce4e7bfa:
    "И потому совершенно не готов к тому, что ждёт меня за ней."

# ch/lavish/date.rpy:295
translate russian lavish_halloween_arrival_748c9d62:
    "Ко мне молниеносно тянутся когти."

# ch/lavish/date.rpy:297
translate russian lavish_halloween_arrival_c66dd704:
    "Я отпрыгиваю, стараясь от них увернуться."

# ch/lavish/date.rpy:298
translate russian lavish_halloween_arrival_53657a5c:
    mike.say "А-а!"

# ch/lavish/date.rpy:299
translate russian lavish_halloween_arrival_1ca9d3d7:
    mike.say "Какого чёрта?!"

# ch/lavish/date.rpy:301
translate russian lavish_halloween_arrival_c9ec05e7:
    lavish.say "Мяу..."

# ch/lavish/date.rpy:302
translate russian lavish_halloween_arrival_331b1e4a:
    lavish.say "Ш-ш-ш!"

# ch/lavish/date.rpy:303
translate russian lavish_halloween_arrival_4cb54744:
    "Мне удаётся взять себя в руки."

# ch/lavish/date.rpy:304
translate russian lavish_halloween_arrival_6ae40a99:
    "И наконец разобраться, что происходит."

# ch/lavish/date.rpy:305
translate russian lavish_halloween_arrival_a46952d1:
    "Сначала я вижу Лавиш, стоящую на пороге."

# ch/lavish/date.rpy:306
translate russian lavish_halloween_arrival_a58bb38f:
    "Но потом понимаю, что всё куда интереснее."

# ch/lavish/date.rpy:307
translate russian lavish_halloween_arrival_83fc622d:
    "Ведь обычно Лавиш не ходит в блестящем облегающем латексе!"

# ch/lavish/date.rpy:308
translate russian lavish_halloween_arrival_22c2698f:
    mike.say "Т-ты..."

# ch/lavish/date.rpy:309
translate russian lavish_halloween_arrival_c9033930:
    mike.say "Леди-Кошка..."

# ch/lavish/date.rpy:310
translate russian lavish_halloween_arrival_589a90e5:
    mike.say "С когтями, плёткой и в резине..."

# ch/lavish/date.rpy:312
translate russian lavish_halloween_arrival_f5f2376d:
    "Лавиш улыбается во весь рот: моя реакция ей явно нравится."

# ch/lavish/date.rpy:313
translate russian lavish_halloween_arrival_3dae16e9:
    lavish.say "Ну что, [lssb_lavish.hero_name()]?"

# ch/lavish/date.rpy:315
translate russian lavish_halloween_arrival_ccdfb721:
    lavish.say "Пригласишь меня на блюдечко молока?"

# ch/lavish/date.rpy:316
translate russian lavish_halloween_arrival_c28151d5:
    "Она прислоняется к дверному косяку и делает вид, что облизывает руки."

# ch/lavish/date.rpy:317
translate russian lavish_halloween_arrival_6cafc56e:
    "А затем трёт ими щёки, словно умывающаяся кошка."

# ch/lavish/date.rpy:320
translate russian lavish_halloween_arrival_f0b3d1de:
    "Да какая разница, что она напугала меня, когда я открыл дверь?"

# ch/lavish/date.rpy:321
translate russian lavish_halloween_arrival_a404bfdf:
    "Нужно быть сумасшедшим, чтобы обижаться из-за такой мелочи."

# ch/lavish/date.rpy:322
translate russian lavish_halloween_arrival_b85ca9d2:
    "Особенно когда моя спутница упакована в такую резину!"

# ch/lavish/date.rpy:323
translate russian lavish_halloween_arrival_85fffdf6:
    mike.say "Ого, Лавиш! Передай кошачью мяту!"

# ch/lavish/date.rpy:324
translate russian lavish_halloween_arrival_25ed1a0b:
    mike.say "А если серьёзно, ты потрясающе выглядишь!"

# ch/lavish/date.rpy:327
translate russian lavish_halloween_arrival_4e7d8267:
    "Лавиш одобрительно улыбается."

# ch/lavish/date.rpy:328
translate russian lavish_halloween_arrival_5ea4c190:
    "Затем отталкивается от косяка и шагает ко мне."

# ch/lavish/date.rpy:329
translate russian lavish_halloween_arrival_fc72258a:
    "Она трётся о меня, прижимаясь как можно теснее."

# ch/lavish/date.rpy:330
translate russian lavish_halloween_arrival_c6b38111:
    "И всё это время ещё и мурлычет, как кошка!"

# ch/lavish/date.rpy:331
translate russian lavish_halloween_arrival_98182c69:
    lavish.say "Мур... мур... мур..."

# ch/lavish/date.rpy:332
translate russian lavish_halloween_arrival_a5089ca3:
    lavish.say "За это я позволю тебе себя погладить!"

# ch/lavish/date.rpy:334
translate russian lavish_halloween_arrival_05e4fe2f:
    lavish.say "Если ты, конечно, хочешь?"

# ch/lavish/date.rpy:335
translate russian lavish_halloween_arrival_ccd52433:
    "Я уже краснею."

# ch/lavish/date.rpy:336
translate russian lavish_halloween_arrival_4a3d0c09:
    "И в шортах тоже чувствую, какое впечатление произвела на меня Лавиш!"

# ch/lavish/date.rpy:337
translate russian lavish_halloween_arrival_7ef1cccc:
    "Я без промедления провожаю её внутрь и закрываю за нами дверь."

# ch/lavish/date.rpy:339
translate russian lavish_halloween_arrival_79744be1:
    "Хочется рассыпаться в комплиментах её костюму."

# ch/lavish/date.rpy:340
translate russian lavish_halloween_arrival_fcc5cace:
    "Хотя, если честно, хочется гораздо большего!"

# ch/lavish/date.rpy:341
translate russian lavish_halloween_arrival_55806651:
    "Но она ведь только что чуть на меня не набросилась."

# ch/lavish/date.rpy:342
translate russian lavish_halloween_arrival_4324ad6c:
    "И это немного подпортило сюрприз."

# ch/lavish/date.rpy:343
translate russian lavish_halloween_arrival_d52bcf5a:
    mike.say "Не стоит вот так на людей выскакивать, Лавиш."

# ch/lavish/date.rpy:344
translate russian lavish_halloween_arrival_43e93fdb:
    mike.say "Кошке за такое могут и коготки обстричь!"

# ch/lavish/date.rpy:347
translate russian lavish_halloween_arrival_72db6913:
    "Лавиш качает головой и закатывает глаза."

# ch/lavish/date.rpy:348
translate russian lavish_halloween_arrival_157baaa0:
    "И издаёт недовольный стон."

# ch/lavish/date.rpy:349
translate russian lavish_halloween_arrival_beb36d7e:
    lavish.say "У-уф..."

# ch/lavish/date.rpy:350
translate russian lavish_halloween_arrival_dd9425c4:
    lavish.say "Ты точно знаешь, как испортить девушке настроение, [lssb_lavish.hero_name()]!"

# ch/lavish/date.rpy:352
translate russian lavish_halloween_arrival_573e7b25:
    lavish.say "Представляешь, как трудно было в это влезть?!"

# ch/lavish/date.rpy:353
translate russian lavish_halloween_arrival_d332a946:
    "Я поднимаю руки, признавая поражение."

# ch/lavish/date.rpy:354
translate russian lavish_halloween_arrival_bf35f0bc:
    "Меньше всего мне хочется, чтобы Лавиш развернулась и ушла."

# ch/lavish/date.rpy:355
translate russian lavish_halloween_arrival_c145b45c:
    mike.say "Ладно, Лавиш."

# ch/lavish/date.rpy:356
translate russian lavish_halloween_arrival_0247eaf2:
    mike.say "Прости."

# ch/lavish/date.rpy:357
translate russian lavish_halloween_arrival_7c0ed0f4:
    mike.say "Костюм очень сексуальный."

# ch/lavish/date.rpy:359
translate russian lavish_halloween_arrival_5fe99ca5:
    "Заходя в дом, Лавиш косится на меня."

# ch/lavish/date.rpy:360
translate russian lavish_halloween_arrival_74f58fa8:
    "И я сразу понимаю: так просто мне это ещё не сойдёт с рук."

# ch/lavish/date.rpy:369
translate russian lavish_halloween_party_934163bc:
    sasha.say "Боже, ну и убогий костюм."

# ch/lavish/date.rpy:370
translate russian lavish_halloween_party_09a690eb:
    sasha.say "Фантазии вообще ноль."

# ch/lavish/date.rpy:374
translate russian lavish_halloween_party_5387273e:
    "Я оборачиваюсь как раз вовремя, чтобы заметить, как меняется лицо Лавиш."

# ch/lavish/date.rpy:375
translate russian lavish_halloween_party_9c8a1477:
    "Она перестаёт улыбаться и хмурится, глядя на Сашу."

# ch/lavish/date.rpy:376
translate russian lavish_halloween_party_827d3932:
    lavish.say "Прошу прощения?"

# ch/lavish/date.rpy:377
translate russian lavish_halloween_party_e26fff0a:
    lavish.say "Это ещё что, чёрт возьми, значит?!"

# ch/lavish/date.rpy:378
translate russian lavish_halloween_party_7a760658:
    "В ответ Саша многозначительно улыбается."

# ch/lavish/date.rpy:379
translate russian lavish_halloween_party_8835552d:
    "А по её позе я сразу вижу: она нарывается на ссору!"

# ch/lavish/date.rpy:380
translate russian lavish_halloween_party_2a5da9f6:
    sasha.say "Все знают, что Леди-Кошка — извращение быстрого приготовления!"

# ch/lavish/date.rpy:381
translate russian lavish_halloween_party_4f7f99d8:
    sasha.say "Такое, которое скучные люди считают верхом непристойности."

# ch/lavish/date.rpy:382
translate russian lavish_halloween_party_eba644f2:
    lavish.say "Давай уточним."

# ch/lavish/date.rpy:383
translate russian lavish_halloween_party_1f86209c:
    lavish.say "Ты говоришь, что я ненастоящая извращенка?"

# ch/lavish/date.rpy:384
translate russian lavish_halloween_party_0586dca0:
    lavish.say "А значит, ТЫ настоящая, да?"

# ch/lavish/date.rpy:386
translate russian lavish_halloween_party_5184bcf1:
    "Ох, как быстро всё накалилось!"

# ch/lavish/date.rpy:387
translate russian lavish_halloween_party_c0139702:
    "Надо вмешаться, пока не стало хуже..."

# ch/lavish/date.rpy:390
translate russian lavish_halloween_party_9d3a185c:
    mike.say "Тебе обязательно всё сводить к сексу, Саша?"

# ch/lavish/date.rpy:391
translate russian lavish_halloween_party_bc0bcbfe:
    mike.say "Да для психоаналитика ты просто находка!"

# ch/lavish/date.rpy:396
translate russian lavish_halloween_party_afde6ccf:
    "Обе девушки одновременно поворачиваются ко мне."

# ch/lavish/date.rpy:397
translate russian lavish_halloween_party_5c434fb9:
    "Поняв, к чему я клоню, Лавиш обретает уверенный и самодовольный вид."

# ch/lavish/date.rpy:398
translate russian lavish_halloween_party_f70c1fbf:
    "А вот Саша выглядит удивлённой и всё больше теряется."

# ch/lavish/date.rpy:399
translate russian lavish_halloween_party_d59a3546:
    sasha.say "Эм..."

# ch/lavish/date.rpy:400
translate russian lavish_halloween_party_8ea19f38:
    sasha.say "Ты знаешь, что я имею в виду, [lssb_lavish.hero_name()]!"

# ch/lavish/date.rpy:401
translate russian lavish_halloween_party_bfb468a8:
    mike.say "Нет, кажется, не знаю, Саша!"

# ch/lavish/date.rpy:402
translate russian lavish_halloween_party_d3f4b16f:
    mike.say "Даже сам Фрейд говорил: «Иногда сигара — это просто сигара»!"

# ch/lavish/date.rpy:403
translate russian lavish_halloween_party_2accfa2d:
    sasha.say "Я... мне пора..."

# ch/lavish/date.rpy:404
translate russian lavish_halloween_party_a923cb45:
    sasha.say "Надо проверить член..."

# ch/lavish/date.rpy:406
translate russian lavish_halloween_party_3f5fa9ce:
    sasha.say "То есть пунш... надо проверить пунш!"

# ch/lavish/date.rpy:410
translate russian lavish_halloween_party_2be7ce52:
    "Саша торопливо уходит, оставляя нас с Лавиш наедине."

# ch/lavish/date.rpy:411
translate russian lavish_halloween_party_55fd813b:
    lavish.say "Спасибо, что выручил, [lssb_lavish.hero_name()]."

# ch/lavish/date.rpy:413
translate russian lavish_halloween_party_454450a1:
    lavish.say "Но признаюсь: я и правда считаю этот костюм развратным!"

# ch/lavish/date.rpy:414
translate russian lavish_halloween_party_e6b2d186:
    mike.say "Я тоже, Лавиш, я тоже!"

# ch/lavish/date.rpy:416
translate russian lavish_halloween_party_7f3bf06c:
    mike.say "Да ладно, Лавиш."

# ch/lavish/date.rpy:417
translate russian lavish_halloween_party_c787e196:
    mike.say "Признай, в словах Саши что-то есть!"

# ch/lavish/date.rpy:422
translate russian lavish_halloween_party_afde6ccf_1:
    "Обе девушки одновременно поворачиваются ко мне."

# ch/lavish/date.rpy:423
translate russian lavish_halloween_party_1375eba2:
    "После моего вмешательства Саша выглядит уверенной и самодовольной."

# ch/lavish/date.rpy:424
translate russian lavish_halloween_party_55461869:
    "А Лавиш, напротив, удивлена и явно растеряна."

# ch/lavish/date.rpy:425
translate russian lavish_halloween_party_beee267b:
    lavish.say "Ч-что ты имеешь в виду, [lssb_lavish.hero_name()]?"

# ch/lavish/date.rpy:426
translate russian lavish_halloween_party_b3debb23:
    lavish.say "Я думала, тебе нравится мой костюм?"

# ch/lavish/date.rpy:427
translate russian lavish_halloween_party_cc304388:
    mike.say "Нравится, Лавиш, нравится."

# ch/lavish/date.rpy:428
translate russian lavish_halloween_party_0aea1623:
    mike.say "Но при слове «бондаж» большинство людей И ПРАВДА представляет Леди-Кошку."

# ch/lavish/date.rpy:429
translate russian lavish_halloween_party_6cee554e:
    mike.say "Она своего рода общественно приемлемое лицо сексуальных извращений!"

# ch/lavish/date.rpy:431
translate russian lavish_halloween_party_1b2bc153:
    "Саша тут же подхватывает мои слова, стремясь выиграть спор."

# ch/lavish/date.rpy:432
translate russian lavish_halloween_party_a7b0e561:
    sasha.say "Именно, [lssb_lavish.hero_name()]!"

# ch/lavish/date.rpy:433
translate russian lavish_halloween_party_917388ff:
    sasha.say "Вот ты понимаешь!"

# ch/lavish/date.rpy:437
translate russian lavish_halloween_party_dbc625f6:
    "Уходя, Саша бросает на Лавиш победный взгляд."

# ch/lavish/date.rpy:438
translate russian lavish_halloween_party_4df51ffd:
    "Сама же Лавиш, кажется, совсем притихла."

# ch/lavish/date.rpy:439
translate russian lavish_halloween_party_afa81985:
    "А я остаюсь гадать, правильно ли только что поступил..."

# ch/lavish/date.rpy:449
translate russian lavish_halloween_dance_4c740cdd:
    "Мы с Лавиш уже какое-то время болтаем о пустяках."

# ch/lavish/date.rpy:450
translate russian lavish_halloween_dance_ddf24d22:
    "Но я всё поглядываю на импровизированный танцпол."

# ch/lavish/date.rpy:451
translate russian lavish_halloween_dance_b8c6bd06:
    lavish.say "Всё хорошо, [lssb_lavish.hero_name()]?"

# ch/lavish/date.rpy:452
translate russian lavish_halloween_dance_4c430dbe:
    lavish.say "Ты будто чем-то отвлечён!"

# ch/lavish/date.rpy:453
translate russian lavish_halloween_dance_e84ffc6f:
    mike.say "Что?"

# ch/lavish/date.rpy:454
translate russian lavish_halloween_dance_1fd3a29e:
    mike.say "О... прости, Лавиш."

# ch/lavish/date.rpy:455
translate russian lavish_halloween_dance_44d55fac:
    mike.say "Я хотел спросить, не хочешь ли ты потанцевать?"

# ch/lavish/date.rpy:456
translate russian lavish_halloween_dance_3e587b3f:
    "Лавиш не соглашается сразу."

# ch/lavish/date.rpy:457
translate russian lavish_halloween_dance_c5c00937:
    "Но и не отказывается."

# ch/lavish/date.rpy:458
translate russian lavish_halloween_dance_84f715cb:
    lavish.say "Я... может быть!"

# ch/lavish/date.rpy:461
translate russian lavish_halloween_dance_9e420202:
    "Пусть Лавиш и не сказала «да»."

# ch/lavish/date.rpy:462
translate russian lavish_halloween_dance_4271a726:
    "Но и «нет» не сказала."

# ch/lavish/date.rpy:463
translate russian lavish_halloween_dance_06745333:
    "Мне и этого достаточно!"

# ch/lavish/date.rpy:467
translate russian lavish_halloween_dance_118d01b7:
    "Схватив её за руку, я направляюсь на танцпол."

# ch/lavish/date.rpy:468
translate russian lavish_halloween_dance_39f263ed:
    "На секунду Лавиш упирается."

# ch/lavish/date.rpy:469
translate russian lavish_halloween_dance_3d5da342:
    "А затем уступает и идёт следом."

# ch/lavish/date.rpy:470
translate russian lavish_halloween_dance_5a16b4f5:
    "На танцполе она, кажется, расслабляется."

# ch/lavish/date.rpy:471
translate russian lavish_halloween_dance_36868a7d:
    "В её поведении что-то едва заметно меняется."

# ch/lavish/date.rpy:474
translate russian lavish_halloween_dance_bb169701:
    "И она позволяет мне вести."

# ch/lavish/date.rpy:475
translate russian lavish_halloween_dance_1d1385cc:
    "Мы танцуем медленно, и этот танец запомнится надолго."

# ch/lavish/date.rpy:476
translate russian lavish_halloween_dance_05ff9f70:
    "Всё это время мы молчим."

# ch/lavish/date.rpy:477
translate russian lavish_halloween_dance_2ba61734:
    "Я наслаждаюсь тем, что держу Лавиш так близко."

# ch/lavish/date.rpy:478
translate russian lavish_halloween_dance_2e3aa695:
    "Её тело прижато к моему."

# ch/lavish/date.rpy:479
translate russian lavish_halloween_dance_d815d8d3:
    "И, клянусь, я чувствую биение её сердца."

# ch/lavish/date.rpy:480
translate russian lavish_halloween_dance_27bee58d:
    "Даже сквозь музыку."

# ch/lavish/date.rpy:481
translate russian lavish_halloween_dance_354d3e30:
    "Словно между нами возникает совершенно новая близость."

# ch/lavish/date.rpy:483
translate russian lavish_halloween_dance_5071b1a6:
    "Я киваю и пожимаю плечами."

# ch/lavish/date.rpy:484
translate russian lavish_halloween_dance_d5b85821:
    "Если бы она хотела танцевать, то сказала бы."

# ch/lavish/date.rpy:485
translate russian lavish_halloween_dance_968ec5c9:
    "Не хочу заставлять её делать то, к чему у неё не лежит душа."

# ch/lavish/date.rpy:486
translate russian lavish_halloween_dance_a9530d06:
    "Так что больше не настаиваю."

# ch/lavish/date.rpy:487
translate russian lavish_halloween_dance_44799545:
    mike.say "Если не хочешь, можем не танцевать, Лавиш."

# ch/lavish/date.rpy:488
translate russian lavish_halloween_dance_af24c982:
    mike.say "Я не против."

# ch/lavish/date.rpy:491
translate russian lavish_halloween_dance_e7f88b75:
    "Услышав это, Лавиш прищуривается."

# ch/lavish/date.rpy:492
translate russian lavish_halloween_dance_42fdada3:
    "На миг мне кажется, что сейчас она скажет: я всё неправильно понял."

# ch/lavish/date.rpy:494
translate russian lavish_halloween_dance_01ca1a57:
    "Но она лишь улыбается и качает головой."

# ch/lavish/date.rpy:495
translate russian lavish_halloween_dance_98057d6b:
    lavish.say "Ладно, [lssb_lavish.hero_name()]."

# ch/lavish/date.rpy:496
translate russian lavish_halloween_dance_90749262:
    "И, кажется, тоже рада оставить эту тему."

# ch/lavish/date.rpy:505
translate russian lavish_halloween_sex_87496eda:
    "Весь вечер Лавиш подчёркивает, насколько сексуален её костюм."

# ch/lavish/date.rpy:506
translate russian lavish_halloween_sex_aa49189f:
    "При любой возможности мурлычет и потягивается по-кошачьи."

# ch/lavish/date.rpy:507
translate russian lavish_halloween_sex_cfc8c6e2:
    "А я с огромным удовольствием ей подыгрываю!"

# ch/lavish/date.rpy:508
translate russian lavish_halloween_sex_001a6a47:
    "Да кто бы отказался?"

# ch/lavish/date.rpy:509
translate russian lavish_halloween_sex_1e7d0ac2:
    "Но вечер продолжается, и пунш начинает действовать на Лавиш."

# ch/lavish/date.rpy:510
translate russian lavish_halloween_sex_0920bc6c:
    "Её игра становится заметно откровеннее."

# ch/lavish/date.rpy:511
translate russian lavish_halloween_sex_2c1b6d88:
    "Она уже не столько изображает кокетливую Леди-Кошку."

# ch/lavish/date.rpy:512
translate russian lavish_halloween_sex_e46542d5:
    "Скорее на глазах превращается в настоящую кошку в течке!"

# ch/lavish/date.rpy:513
translate russian lavish_halloween_sex_db4a4a12:
    "Поэтому при первой возможности я уводжу её в свою спальню."

# ch/lavish/date.rpy:517
translate russian lavish_halloween_sex_b5633c08:
    "Лавиш ничуть не возражает."

# ch/lavish/date.rpy:518
translate russian lavish_halloween_sex_0c5d3def:
    "Она вальяжно проходит в комнату, пока я закрываю за нами дверь."

# ch/lavish/date.rpy:519
translate russian lavish_halloween_sex_3dcc47d4:
    lavish.say "М-м-м..."

# ch/lavish/date.rpy:521
translate russian lavish_halloween_sex_5a48ef0d:
    lavish.say "Наконец-то одни!"

# ch/lavish/date.rpy:523
translate russian lavish_halloween_sex_bcd7cc04:
    "Я оборачиваюсь как раз вовремя, чтобы увидеть, как Лавиш подходит к кровати."

# ch/lavish/date.rpy:524
translate russian lavish_halloween_sex_ba95282c:
    "Хотя словом «подходит» её движения сейчас вряд ли опишешь."

# ch/lavish/date.rpy:526
translate russian lavish_halloween_sex_1ee808ec:
    "Ей каким-то образом удаётся сделать каждый жест откровенно чувственным и сексуальным."

# ch/lavish/date.rpy:527
translate russian lavish_halloween_sex_e2cb43e4:
    "Я неотрывно смотрю на её ноги, округлые ягодицы и покачивающиеся плечи."

# ch/lavish/date.rpy:528
translate russian lavish_halloween_sex_3810e55b:
    "А она ещё и гладит себя по бокам, всё время улыбаясь."

# ch/lavish/date.rpy:530
translate russian lavish_halloween_sex_cfd19513:
    lavish.say "Не представляешь, как мне сегодня было тяжело, [lssb_lavish.hero_name()]."

# ch/lavish/date.rpy:531
translate russian lavish_halloween_sex_4fffc3bd:
    lavish.say "Вокруг столько людей."

# ch/lavish/date.rpy:532
translate russian lavish_halloween_sex_dc9ef157:
    lavish.say "А мне всё время хотелось, чтобы ты меня трогал!"

# ch/lavish/date.rpy:534
translate russian lavish_halloween_sex_cab94fab:
    "Эти слова ударяют мне в голову не хуже самого пунша."

# ch/lavish/date.rpy:537
translate russian lavish_halloween_sex_bdb8e74d:
    "Я оказываюсь рядом с ней раньше, чем успеваю решить, что пора двигаться."

# ch/lavish/date.rpy:538
translate russian lavish_halloween_sex_79249c2c:
    "И кладу ладони на изгибы её бёдер."

# ch/lavish/date.rpy:539
translate russian lavish_halloween_sex_5af50749:
    "Резина костюма под ладонями тёплая, почти горячая."

# ch/lavish/date.rpy:540
translate russian lavish_halloween_sex_35455479:
    "Я веду руками вверх по её бокам, повторяя все изгибы тела."

# ch/lavish/date.rpy:542
translate russian lavish_halloween_sex_78baae5d:
    lavish.say "М-м-м, да..."

# ch/lavish/date.rpy:543
translate russian lavish_halloween_sex_b5aa111c:
    lavish.say "Вот здесь, [lssb_lavish.hero_name()]."

# ch/lavish/date.rpy:545
translate russian lavish_halloween_sex_88e1c69b:
    "Она выгибается навстречу прикосновениям, словно кошка под ласкающей рукой."

# ch/lavish/date.rpy:546
translate russian lavish_halloween_sex_3da88a53:
    "По её телу пробегает лёгкая дрожь, дыхание замирает."

# ch/lavish/date.rpy:548
translate russian lavish_halloween_sex_4649f3ae:
    lavish.say "Я весь вечер твердила себе, что надо держаться профессионально."

# ch/lavish/date.rpy:549
translate russian lavish_halloween_sex_1247df5e:
    lavish.say "Но с тобой это так трудно."

# ch/lavish/date.rpy:550
translate russian lavish_halloween_sex_d608a098:
    "В её голосе всё ещё слышится привычная безупречная выдержка."

# ch/lavish/date.rpy:551
translate russian lavish_halloween_sex_bcdd3cd8:
    "Та самая собранная стажёрка, у которой даже волосок не выбивается из причёски."

# ch/lavish/date.rpy:552
translate russian lavish_halloween_sex_bcf511e7:
    "Но под ней я слышу, как раскрывается что-то новое."

# ch/lavish/date.rpy:553
translate russian lavish_halloween_sex_93c9fe2b:
    "Жадное желание, которое пунш наконец выпустил на волю."

# ch/lavish/date.rpy:555
translate russian lavish_halloween_sex_cfcc82f8:
    "Словно в подтверждение своих слов, Лавиш опускается на колени."

# ch/lavish/date.rpy:557
translate russian lavish_halloween_sex_d661c249:
    "Она ставит локти на кровать и подпирает голову ладонями."

# ch/lavish/date.rpy:558
translate russian lavish_halloween_sex_5428340a:
    lavish.say "Я еле сдерживалась, чтобы не начать себя трогать."

# ch/lavish/date.rpy:559
translate russian lavish_halloween_sex_742c9627:
    lavish.say "Столько раз хотелось погладить свою киску."

# ch/lavish/date.rpy:560
translate russian lavish_halloween_sex_453514f3:
    lavish.say "Или сжать соски — они были такими твёрдыми!"

# ch/lavish/date.rpy:561
translate russian lavish_halloween_sex_96cacadf:
    "Теперь я слышу собственное дыхание — тяжёлое и прерывистое."

# ch/lavish/date.rpy:562
translate russian lavish_halloween_sex_3bf5334a:
    "Но вижу лишь руку Лавиш у неё между бёдер."

