# ch/lavish/events.rpy:3252
translate russian lavish_sub_03_67ab4e4f:
    "К минету Лавиш подходит как к любой задаче."

# ch/lavish/events.rpy:3253
translate russian lavish_sub_03_5acb90ec:
    "То есть тщательно и с полной отдачей."

# ch/lavish/events.rpy:3254
translate russian lavish_sub_03_6caa0de4:
    "Она ласкает мой член, двигаясь от основания вверх."

# ch/lavish/events.rpy:3256
translate russian lavish_sub_03_043de94e:
    "И каждый следующий сантиметр приносит больше удовольствия."

# ch/lavish/events.rpy:3257
translate russian lavish_sub_03_adc97f41:
    "Твёрже я уже не стану, даже под ласками её языка и губ."

# ch/lavish/events.rpy:3258
translate russian lavish_sub_03_7c90a835:
    "Она так хороша, что я не поднимаю глаз, пока она не добирается до головки."

# ch/lavish/events.rpy:3259
translate russian lavish_sub_03_d36ee1e6:
    "И тут вдруг вспоминаю, что мы не одни."

# ch/lavish/events.rpy:3261
translate russian lavish_sub_03_be26d8b0:
    "Когда Лавиш принимает головку в рот, я смотрю на Одри и Шиори."

# ch/lavish/events.rpy:3262
translate russian lavish_sub_03_7906d6e4:
    "Вижу их поверх её двигающейся головы."

# ch/lavish/events.rpy:3263
translate russian lavish_sub_03_cfa91473:
    "Обе молча, заворожённо наблюдают."

# ch/lavish/events.rpy:3264
translate russian lavish_sub_03_10310d89:
    "Шиори из них двоих, кажется, потрясена сильнее."

# ch/lavish/events.rpy:3267
translate russian lavish_sub_03_d7c329f8:
    "Но в её глазах всё равно заметно возбуждение."

# ch/lavish/events.rpy:3268
translate russian lavish_sub_03_99d26b2e:
    "И я знаю, что она представляет себя на месте Лавиш."

# ch/lavish/events.rpy:3269
translate russian lavish_sub_03_8ae73d08:
    "Одри же открыто улыбается и одобрительно кивает."

# ch/lavish/events.rpy:3270
translate russian lavish_sub_03_023e8cda:
    "Наверное, она считает, что Лавиш смотрит на остальных девушек в офисе свысока."

# ch/lavish/events.rpy:3272
translate russian lavish_sub_03_f359a6c0:
    "И потому вид Лавиш на коленях с членом во рту должен её радовать."

# ch/lavish/events.rpy:3273
translate russian lavish_sub_03_fc0642b8:
    "А мне их присутствие делает ощущения ещё слаще."

# ch/lavish/events.rpy:3274
translate russian lavish_sub_03_22192b94:
    "Приятно контролировать ситуацию."

# ch/lavish/events.rpy:3276
translate russian lavish_sub_03_726894fa:
    "Внутри нарастает опьяняющее чувство власти."

# ch/lavish/events.rpy:3277
translate russian lavish_sub_03_c9cf36a7:
    "Ведь если я могу сделать это без возражений с их стороны, на что ещё способен?"

# ch/lavish/events.rpy:3278
translate russian lavish_sub_03_86774baf:
    "Но мысли обрываются, когда я чувствую приближение оргазма."

# ch/lavish/events.rpy:3280
translate russian lavish_sub_03_60887315:
    "Быстро принимаю решение и действую."

# ch/lavish/events.rpy:3283
translate russian lavish_sub_03_d7431b95:
    "Хочется поставить точку в том, что я заставил Лавиш сделать."

# ch/lavish/events.rpy:3285
translate russian lavish_sub_03_0c1f6f00:
    "И заставить её проглотить — идеальное завершение."

# ch/lavish/events.rpy:3287
translate russian lavish_sub_03_11ecbd59:
    "Я удерживаю её голову, не позволяя вырваться."

# ch/lavish/events.rpy:3291
translate russian lavish_sub_03_b5e199fb:
    "Когда я кончаю, глаза Лавиш едва не вылезают из орбит."

# ch/lavish/events.rpy:3293
translate russian lavish_sub_03_3e193634:
    "Она кашляет и чуть не давится, но справляется."

# ch/lavish/events.rpy:3295
translate russian lavish_sub_03_014d60a9:
    "Ей остаётся лишь глотать всё, что я изливаю ей в рот."

# ch/lavish/events.rpy:3298
translate russian lavish_sub_03_d7f81b5a:
    "Когда я наконец вынимаю член, она жадно хватает воздух."

# ch/lavish/events.rpy:3300
translate russian lavish_sub_03_f9f499eb:
    "А с подбородка всё это время тянутся капли спермы."

# ch/lavish/events.rpy:3302
translate russian lavish_sub_03_d7431b95_1:
    "Хочется поставить точку в том, что я заставил Лавиш сделать."

# ch/lavish/events.rpy:3303
translate russian lavish_sub_03_772b2620:
    "И покрыть её лицо спермой — идеальное завершение."

# ch/lavish/events.rpy:3306
translate russian lavish_sub_03_f5916be1:
    "Я вынимаю член изо рта Лавиш прямо перед оргазмом."

# ch/lavish/events.rpy:3307
translate russian lavish_sub_03_4c1b16be:
    "Но слишком поздно, чтобы она поняла, что происходит."

# ch/lavish/events.rpy:3308
translate russian lavish_sub_03_08639b91:
    "Она смотрит на меня широко раскрытыми глазами, с открытым ртом."

# ch/lavish/events.rpy:3310
translate russian lavish_sub_03_98f010d1:
    "А через секунду я кончаю прямо ей в лицо."

# ch/lavish/events.rpy:3312
translate russian lavish_sub_03_978b1cb0:
    "Липкая белая сперма ложится полосами на щёки и нос."

# ch/lavish/events.rpy:3314
translate russian lavish_sub_03_e2bdb5ff:
    "Часть попадает в рот, и ей приходится проглотить."

# ch/lavish/events.rpy:3316
translate russian lavish_sub_03_9113933f:
    "Я оставляю Лавиш на коленях приводить себя в порядок, пока поправляю одежду."

# ch/lavish/events.rpy:3321
translate russian lavish_sub_03_721997c8:
    "Вставая, многозначительно улыбаюсь Одри и Шиори."

# ch/lavish/events.rpy:3322
translate russian lavish_sub_03_6b508e87:
    mike.say "Думаю, на этом пока закончим."

# ch/lavish/events.rpy:3323
translate russian lavish_sub_03_2ba14736:
    mike.say "Если что-нибудь ещё возникнет, сообщите. Хорошо?"

# ch/lavish/events.rpy:3324
translate russian lavish_sub_03_c102a48f:
    shiori.say "О..."

# ch/lavish/events.rpy:3326
translate russian lavish_sub_03_2a392c32:
    shiori.say "Конечно, [lssb_lavish.hero_name()]!"

# ch/lavish/events.rpy:3328
translate russian lavish_sub_03_495ee239:
    audrey.say "Без проблем, [lssb_lavish.hero_name()]."

# ch/lavish/events.rpy:3329
translate russian lavish_sub_03_19325b3a:
    audrey.say "Договорились!"

# ch/lavish/events.rpy:3330
translate russian lavish_sub_03_fad3f884:
    "Выходя, позволяю себе последнюю ухмылку."

# ch/lavish/events.rpy:3332
translate russian lavish_sub_03_93954121:
    "Части меня хотелось бы услышать разговор, который сейчас начнётся."

# ch/lavish/events.rpy:3333
translate russian lavish_sub_03_d938ff07:
    "Но я всё ещё наслаждаюсь тем, как всё обернулось."

# ch/lavish/events.rpy:3334
translate russian lavish_sub_03_376d4345:
    "И этого мне более чем достаточно."

# ch/lavish/events.rpy:3345
translate russian lavish_birthday_date_male_9622c996:
    "В условленное время я подъезжаю к дому Лавиш и сигналю."

# ch/lavish/events.rpy:3346
translate russian lavish_birthday_date_male_a136a46b:
    "Через минуту она уже торопится мне навстречу."

# ch/lavish/events.rpy:3347
translate russian lavish_birthday_date_male_83724789:
    "На лице улыбка: ей явно не терпится отправиться в путь."

# ch/lavish/events.rpy:3348
translate russian lavish_birthday_date_male_0afcc6c1:
    "Но её одежда внушает мне меньше уверенности."

# ch/lavish/events.rpy:3349
translate russian lavish_birthday_date_male_a0d1d0ba:
    "Я уговорил Лавиш пойти со мной в лес с палаткой."

# ch/lavish/events.rpy:3350
translate russian lavish_birthday_date_male_61a81e35:
    "И, главное, так отпраздновать её день рождения."

# ch/lavish/events.rpy:3352
translate russian lavish_birthday_date_male_a75c4137:
    "А выглядит она так, будто собралась прогуляться по парку!"

# ch/lavish/events.rpy:3354
translate russian lavish_birthday_date_male_a2918bbb:
    lavish.say "Привет, [lssb_lavish.hero_name()]..."

# ch/lavish/events.rpy:3356
translate russian lavish_birthday_date_male_e058f587:
    lavish.say "Я взяла всё, что ты говорил."

# ch/lavish/events.rpy:3357
translate russian lavish_birthday_date_male_8c869efa:
    lavish.say "Вот, в этой сумке..."

# ch/lavish/events.rpy:3360
translate russian lavish_birthday_date_male_d85d61bb:
    lavish.say "Эм... почему ты так на меня смотришь?"

# ch/lavish/events.rpy:3361
translate russian lavish_birthday_date_male_349943b9:
    lavish.say "Я что-то сделала не так?"

# ch/lavish/events.rpy:3365
translate russian lavish_birthday_date_male_eeff8156:
    "По-моему, Лавиш не послушалась совета."

# ch/lavish/events.rpy:3366
translate russian lavish_birthday_date_male_f370f51b:
    "Я сказал купить снаряжение в магазине армейских излишков."

# ch/lavish/events.rpy:3367
translate russian lavish_birthday_date_male_4406827e:
    "Но готов поспорить, она отправилась прямиком в торговый центр."

# ch/lavish/events.rpy:3368
translate russian lavish_birthday_date_male_1a14d95c:
    "В модный бутик, где ей продали дорогую ерунду!"

# ch/lavish/events.rpy:3369
translate russian lavish_birthday_date_male_a81cbdcc:
    "Конечно, сказать ей это я не могу."

# ch/lavish/events.rpy:3370
translate russian lavish_birthday_date_male_ed02dab9:
    "Ведь хочу, чтобы поездка состоялась."

# ch/lavish/events.rpy:3371
translate russian lavish_birthday_date_male_7c5440c2:
    mike.say "Нет, Лавиш..."

# ch/lavish/events.rpy:3372
translate russian lavish_birthday_date_male_bad28582:
    mike.say "Кажется, большую часть ты взяла."

# ch/lavish/events.rpy:3373
translate russian lavish_birthday_date_male_572eddc1:
    mike.say "Но кое-чего не хватает."

# ch/lavish/events.rpy:3374
translate russian lavish_birthday_date_male_fc70b070:
    mike.say "Наверное, я забыл об этом сказать."

# ch/lavish/events.rpy:3377
translate russian lavish_birthday_date_male_3de55c3e:
    "Мои слова действуют как надо."

# ch/lavish/events.rpy:3378
translate russian lavish_birthday_date_male_1be3a2e8:
    "Лавиш облегчённо кивает."

# ch/lavish/events.rpy:3379
translate russian lavish_birthday_date_male_010706ef:
    "Явно принимая версию, что ошибка, скорее всего, моя."

# ch/lavish/events.rpy:3381
translate russian lavish_birthday_date_male_672a2a8e:
    lavish.say "А как же то, чего у меня нет?"

# ch/lavish/events.rpy:3383
translate russian lavish_birthday_date_male_3e89fa25:
    lavish.say "Придётся отменить поездку?"

# ch/lavish/events.rpy:3384
translate russian lavish_birthday_date_male_8b42dc55:
    mike.say "Нет, Лавиш."

# ch/lavish/events.rpy:3385
translate russian lavish_birthday_date_male_fffc9e1e:
    mike.say "Просто поделюсь своим снаряжением."

# ch/lavish/events.rpy:3386
translate russian lavish_birthday_date_male_07f3f575:
    mike.say "Одну ночь мы точно переживём."

# ch/lavish/events.rpy:3389
translate russian lavish_birthday_date_male_f75c00f6:
    "К счастью, на этом вопрос, кажется, решён."

# ch/lavish/events.rpy:3392
translate russian lavish_birthday_date_male_02abfd71:
    mike.say "Где ты всё это купила, Лавиш?"

# ch/lavish/events.rpy:3393
translate russian lavish_birthday_date_male_51e8d6ff:
    mike.say "Не похоже на вещи из магазина армейских излишков."

# ch/lavish/events.rpy:3394
translate russian lavish_birthday_date_male_bb7946d0:
    mike.say "А ведь я, кажется, советовал именно его?"

# ch/lavish/events.rpy:3396
translate russian lavish_birthday_date_male_d7f47af3:
    "Лавиш заметно смущается."

# ch/lavish/events.rpy:3397
translate russian lavish_birthday_date_male_5d00b63f:
    "Смотрит себе под ноги, словно ребёнок, которого отчитывают."

# ch/lavish/events.rpy:3398
translate russian lavish_birthday_date_male_646d9203:
    lavish.say "Ну..."

# ch/lavish/events.rpy:3399
translate russian lavish_birthday_date_male_71bbed3d:
    lavish.say "Вещи в том армейском магазине показались мне..."

# ch/lavish/events.rpy:3400
translate russian lavish_birthday_date_male_0706a93f:
    lavish.say "Дешёвыми и непривлекательными, понимаешь?"

# ch/lavish/events.rpy:3402
translate russian lavish_birthday_date_male_b8192da3:
    lavish.say "Поэтому я пошла в один из модных бутиков в торговом центре."

# ch/lavish/events.rpy:3403
translate russian lavish_birthday_date_male_e52db34e:
    lavish.say "Консультант сказал, что лучше этого ничего нет."

# ch/lavish/events.rpy:3404
translate russian lavish_birthday_date_male_08e50b5f:
    lavish.say "И потому оно так дорого стоит."

# ch/lavish/events.rpy:3405
translate russian lavish_birthday_date_male_2cc3052f:
    "Лавиш поднимает на меня глаза с беспомощной улыбкой."

# ch/lavish/events.rpy:3406
translate russian lavish_birthday_date_male_85ba222d:
    "И я невольно жалею её."

# ch/lavish/events.rpy:3407
translate russian lavish_birthday_date_male_c00eba98:
    mike.say "Эм... вообще-то всё наоборот, Лавиш."

# ch/lavish/events.rpy:3408
translate russian lavish_birthday_date_male_4d4b88d7:
    mike.say "Дизайнерские вещи быстро изнашиваются."

# ch/lavish/events.rpy:3409
translate russian lavish_birthday_date_male_66fe0763:
    mike.say "А армейские служат всю жизнь."

# ch/lavish/events.rpy:3412
translate russian lavish_birthday_date_male_2d61e4ca:
    lavish.say "Ох..."

# ch/lavish/events.rpy:3413
translate russian lavish_birthday_date_male_28dcf4ed:
    lavish.say "Я впервые иду с палаткой."

# ch/lavish/events.rpy:3414
translate russian lavish_birthday_date_male_22d4cec3:
    lavish.say "И уже всё испортила!"

# ch/lavish/events.rpy:3415
translate russian lavish_birthday_date_male_7e70b1a4:
    mike.say "Нет, Лавиш!"

# ch/lavish/events.rpy:3416
translate russian lavish_birthday_date_male_938c5522:
    mike.say "Не волнуйся."

# ch/lavish/events.rpy:3417
translate russian lavish_birthday_date_male_282febb3:
    mike.say "Я помогу тебе освоиться."

# ch/lavish/events.rpy:3424
translate russian lavish_birthday_date_male_7901123a:
    "Лавиш открывает пассажирскую дверь и садится рядом."

# ch/lavish/events.rpy:3426
translate russian lavish_birthday_date_male_3f463e47:
    "Через несколько минут мы уже едем из города."

# ch/lavish/events.rpy:3427
translate russian lavish_birthday_date_male_cb0903c8:
    "Эти дороги я хорошо знаю по походам с родителями."

# ch/lavish/events.rpy:3428
translate russian lavish_birthday_date_male_075b3ed6:
    "А вот для Лавиш отдых на природе — почти новое занятие."

# ch/lavish/events.rpy:3429
translate russian lavish_birthday_date_male_d400f644:
    "Да, это не дикая глушь."

# ch/lavish/events.rpy:3430
translate russian lavish_birthday_date_male_e14d6e38:
    "Но я всё напоминаю себе, как страшно бывает в лесу непривычному человеку."

# ch/lavish/events.rpy:3431
translate russian lavish_birthday_date_male_3fd2f147:
    "По дороге я показываю Лавиш самые красивые виды."

# ch/lavish/events.rpy:3432
translate russian lavish_birthday_date_male_3a834eb6:
    "Хотя мне кажется, для неё всё вокруг — одна зелёная масса."

# ch/lavish/events.rpy:3433
translate russian lavish_birthday_date_male_9ba9ac1f:
    "Вскоре подъезжаем к парковке у начала тропы."

# ch/lavish/events.rpy:3435
translate russian lavish_birthday_date_male_980a4e8e:
    mike.say "Вот и приехали, Лавиш..."

# ch/lavish/events.rpy:3436
translate russian lavish_birthday_date_male_4f66c684:
    mike.say "Здесь начинается наше приключение!"

# ch/lavish/events.rpy:3437
translate russian lavish_birthday_date_male_8f87061f:
    lavish.say "Как скажешь, [lssb_lavish.hero_name()]."

# ch/lavish/events.rpy:3438
translate russian lavish_birthday_date_male_32953fd7:
    lavish.say "Но я всё ещё не уверена, что это лучше ночи в четырёхзвёздочном отеле!"

# ch/lavish/events.rpy:3439
translate russian lavish_birthday_date_male_671d1cf4:
    mike.say "Поверь мне, Лавиш."

# ch/lavish/events.rpy:3440
translate russian lavish_birthday_date_male_05c705a5:
    mike.say "Когда сядет солнце и взойдёт луна, звёзд увидишь куда больше четырёх!"

# ch/lavish/events.rpy:3441
translate russian lavish_birthday_date_male_95272353:
    "Лавиш по-прежнему не выглядит убеждённой."

# ch/lavish/events.rpy:3445
translate russian lavish_birthday_date_male_fead0a22:
    "Но храбро выходит из машины и надевает рюкзак."

# ch/lavish/events.rpy:3446
translate russian lavish_birthday_date_male_52e66124:
    lavish.say "Ладно..."

# ch/lavish/events.rpy:3448
translate russian lavish_birthday_date_male_b11d5bc1:
    lavish.say "И что теперь?"

# ch/lavish/events.rpy:3449
translate russian lavish_birthday_date_male_8860dd4a:
    lavish.say "Введём пункт назначения в навигатор?"

# ch/lavish/events.rpy:3450
translate russian lavish_birthday_date_male_ef595628:
    "От такого предложения я невольно смеюсь."

# ch/lavish/events.rpy:3451
translate russian lavish_birthday_date_male_0692c789:
    mike.say "Не нужно."

# ch/lavish/events.rpy:3452
translate russian lavish_birthday_date_male_31aa8925:
    mike.say "Я знаю эту тропу как свои пять пальцев."

# ch/lavish/events.rpy:3453
translate russian lavish_birthday_date_male_a65a4a4c:
    "Для убедительности поднимаю руку."

# ch/lavish/events.rpy:3454
translate russian lavish_birthday_date_male_4dd318c0:
    "Но затем удивлённо смотрю на неё."

# ch/lavish/events.rpy:3455
translate russian lavish_birthday_date_male_40a53724:
    mike.say "Ты только посмотри!"

# ch/lavish/events.rpy:3456
translate russian lavish_birthday_date_male_6884cbb6:
    mike.say "Раньше я этой родинки не замечал!"

# ch/lavish/events.rpy:3458
translate russian lavish_birthday_date_male_cbdcb76f:
    "В глазах Лавиш появляется паника."

# ch/lavish/events.rpy:3459
translate russian lavish_birthday_date_male_0cfbe3a4:
    "И я как можно быстрее качаю головой."

# ch/lavish/events.rpy:3460
translate russian lavish_birthday_date_male_2597aa03:
    mike.say "Шучу!"

# ch/lavish/events.rpy:3461
translate russian lavish_birthday_date_male_877f846c:
    mike.say "Я просто пошутил!"

# ch/lavish/events.rpy:3462
translate russian lavish_birthday_date_male_c00f1f60:
    mike.say "Я действительно знаю дорогу."

# ch/lavish/events.rpy:3463
translate russian lavish_birthday_date_male_f11746d6:
    mike.say "Но кое-что выбрать всё же нужно."

# ch/lavish/events.rpy:3465
translate russian lavish_birthday_date_male_82b211b8:
    mike.say "По этой тропе можно дойти до двух стоянок."

# ch/lavish/events.rpy:3466
translate russian lavish_birthday_date_male_b9cd35bf:
    mike.say "До одной идти долго, зато виды потрясающие."

# ch/lavish/events.rpy:3467
translate russian lavish_birthday_date_male_66442a49:
    mike.say "Другая гораздо ближе, но пейзажи там... так себе."

# ch/lavish/events.rpy:3468
translate russian lavish_birthday_date_male_960a08d0:
    lavish.say "Но если выберем ближнюю, то на месте останется больше времени."

# ch/lavish/events.rpy:3469
translate russian lavish_birthday_date_male_fff64ca6:
    lavish.say "Сможем обустроиться и устроиться поудобнее, правда?"

# ch/lavish/events.rpy:3472
translate russian lavish_birthday_date_male_2478ce16:
    "Я качаю головой, отмахиваясь от опасений Лавиш."

# ch/lavish/events.rpy:3473
translate russian lavish_birthday_date_male_e414573b:
    mike.say "Ну, я говорю «долго»..."

# ch/lavish/events.rpy:3474
translate russian lavish_birthday_date_male_d2895f45:
    mike.say "Но на самом деле не так уж и далеко."

# ch/lavish/events.rpy:3475
translate russian lavish_birthday_date_male_df51b894:
    mike.say "Пойдём, Лавиш..."

# ch/lavish/events.rpy:3476
translate russian lavish_birthday_date_male_167a7d6a:
    mike.say "Чем раньше выйдем, тем раньше дойдём."

# ch/lavish/events.rpy:3478
translate russian lavish_birthday_date_male_8dc18825:
    "Я трогаюсь с места прежде, чем Лавиш успевает возразить."

# ch/lavish/events.rpy:3479
translate russian lavish_birthday_date_male_ff22b3ae:
    "Так что ей остаётся лишь идти за мной."

# ch/lavish/events.rpy:3480
translate russian lavish_birthday_date_male_88b230dd:
    "И темп я задаю бодрый."

# ch/lavish/events.rpy:3481
translate russian lavish_birthday_date_male_60a5f5cc:
    "Ведь надо подтвердить свои слова, что идти недалеко."

# ch/lavish/events.rpy:3485
translate russian lavish_birthday_date_male_20b437e6:
    "По пути я даже не забываю показывать лучшие виды."

# ch/lavish/events.rpy:3486
translate russian lavish_birthday_date_male_4e18bff8:
    "Но к стоянке Лавиш добирается совершенно измотанной."

# ch/lavish/events.rpy:3487
translate russian lavish_birthday_date_male_aa4a243a:
    "Едва я объявляю, что пришли, она чуть не валится с ног."

# ch/lavish/events.rpy:3490
translate russian lavish_birthday_date_male_e7bcd7e0:
    "И я чувствую её раздражённый взгляд."

# ch/lavish/events.rpy:3491
translate russian lavish_birthday_date_male_0dbe173d:
    "Который остаётся лишь старательно не замечать."

# ch/lavish/events.rpy:3493
translate russian lavish_birthday_date_male_ddb454f1:
    "Я немного обдумываю это."

# ch/lavish/events.rpy:3494
translate russian lavish_birthday_date_male_42994221:
    "Затем пожимаю плечами."

# ch/lavish/events.rpy:3495
translate russian lavish_birthday_date_male_8e93ddad:
    mike.say "Пожалуй, можно выбрать путь полегче."

# ch/lavish/events.rpy:3496
translate russian lavish_birthday_date_male_a8688166:
    mike.say "Не будем слишком нагружать новичка!"

# ch/lavish/events.rpy:3497
translate russian lavish_birthday_date_male_779d7e0a:
    mike.say "Готова?"

# ch/lavish/events.rpy:3500
translate russian lavish_birthday_date_male_5e5eadfa:
    "Лавиш с готовностью кивает."

# ch/lavish/events.rpy:3501
translate russian lavish_birthday_date_male_95a968a8:
    "На её лице читается облегчение."

# ch/lavish/events.rpy:3502
translate russian lavish_birthday_date_male_500446cf:
    "Мы отправляемся по тропе."

# ch/lavish/events.rpy:3503
translate russian lavish_birthday_date_male_769c4322:
    "И на первой развилке сворачиваем на более лёгкий путь."

# ch/lavish/events.rpy:3507
translate russian lavish_birthday_date_male_f6586ac6:
    "Да, прогулка короче, а виды не такие впечатляющие."

# ch/lavish/events.rpy:3508
translate russian lavish_birthday_date_male_8cef3821:
    "Зато до стоянки добираемся в рекордное время."

# ch/lavish/events.rpy:3511
translate russian lavish_birthday_date_male_a378a392:
    "И оба ещё полны сил."

# ch/lavish/events.rpy:3512
translate russian lavish_birthday_date_male_b175f214:
    "Будем считать это успехом."

# ch/lavish/events.rpy:3514
translate russian lavish_birthday_date_male_0e323438:
    "Сначала нужно поставить палатку. Я занимаюсь этим, пока Лавиш смотрит."

# ch/lavish/events.rpy:3516
translate russian lavish_birthday_date_male_c8e865d7:
    "Затем выкладываю камнями круг для костра."

# ch/lavish/events.rpy:3518
translate russian lavish_birthday_date_male_62a193a8:
    "Это интересует Лавиш больше, и она подходит поближе."

# ch/lavish/events.rpy:3519
translate russian lavish_birthday_date_male_e55a429d:
    "Тут я понимаю: хороший шанс привлечь её к делу."

# ch/lavish/events.rpy:3520
translate russian lavish_birthday_date_male_1f97c6a9:
    "Научить настоящим походным навыкам."

# ch/lavish/events.rpy:3524
translate russian lavish_birthday_date_male_f04f9a80:
    mike.say "Слушай, Лавиш..."

# ch/lavish/events.rpy:3525
translate russian lavish_birthday_date_male_a227da59:
    mike.say "Тебе стоит посмотреть."

# ch/lavish/events.rpy:3526
translate russian lavish_birthday_date_male_f66f1d56:
    mike.say "Заодно узнаешь кое-что о разведении костра."

# ch/lavish/events.rpy:3528
translate russian lavish_birthday_date_male_8f94c142:
    "Лавиш кивает и наклоняется ближе."

# ch/lavish/events.rpy:3529
translate russian lavish_birthday_date_male_1bc51ffe:
    "С этого момента она внимательно наблюдает."

# ch/lavish/events.rpy:3530
translate russian lavish_birthday_date_male_834d8952:
    "Порой я останавливаюсь и что-нибудь объясняю."

# ch/lavish/events.rpy:3531
translate russian lavish_birthday_date_male_c8cf7527:
    "Не раз она сама перебивает меня вопросом."

# ch/lavish/events.rpy:3532
translate russian lavish_birthday_date_male_894a4c1d:
    "Вскоре костёр сложен и готов к розжигу."

# ch/lavish/events.rpy:3533
translate russian lavish_birthday_date_male_26bf3514:
    "Приятно чувствовать, что сделал что-то полезное."

# ch/lavish/events.rpy:3535
translate russian lavish_birthday_date_male_ff15e9e3:
    "И передал Лавиш новые знания тоже."

# ch/lavish/events.rpy:3538
translate russian lavish_birthday_date_male_f04f9a80_1:
    mike.say "Слушай, Лавиш..."

# ch/lavish/events.rpy:3539
translate russian lavish_birthday_date_male_96ab0136:
    mike.say "Помоги мне сложить костёр."

# ch/lavish/events.rpy:3541
translate russian lavish_birthday_date_male_a9364d72:
    "Лавиш качает головой."

# ch/lavish/events.rpy:3542
translate russian lavish_birthday_date_male_26944e04:
    lavish.say "О нет..."

# ch/lavish/events.rpy:3543
translate russian lavish_birthday_date_male_747af71f:
    lavish.say "Я даже не знаю, с чего начать!"

# ch/lavish/events.rpy:3544
translate russian lavish_birthday_date_male_43464599:
    mike.say "Пока кто-нибудь не покажет!"

# ch/lavish/events.rpy:3546
translate russian lavish_birthday_date_male_bd1b15cf:
    "Сначала кажется, что Лавиш не уступит."

# ch/lavish/events.rpy:3547
translate russian lavish_birthday_date_male_72cd5c55:
    "Но затем она кивает и торопится ко мне."

# ch/lavish/events.rpy:3548
translate russian lavish_birthday_date_male_53b946a1:
    "Я не спешу и подробно объясняю каждый шаг."

# ch/lavish/events.rpy:3550
translate russian lavish_birthday_date_male_2f323147:
    "Мы вместе собираем дрова."

# ch/lavish/events.rpy:3551
translate russian lavish_birthday_date_male_a742c2af:
    "Затем складываем их внутри каменного круга."

# ch/lavish/events.rpy:3552
translate russian lavish_birthday_date_male_d4088ae5:
    "Наконец я позволяю Лавиш зажечь костёр."

# ch/lavish/events.rpy:3555
translate russian lavish_birthday_date_male_918f9260:
    "Вспыхнувшее пламя освещает её лицо."

# ch/lavish/events.rpy:3556
translate russian lavish_birthday_date_male_9c3d8eac:
    "На нём сияет настоящая гордость за сделанное."

# ch/lavish/events.rpy:3560
translate russian lavish_birthday_date_male_24125d33:
    "Костёр горит, и можно немного отдохнуть."

# ch/lavish/events.rpy:3562
translate russian lavish_birthday_date_male_4b3645d1:
    "Но стоит усесться, как у меня начинает урчать живот."

# ch/lavish/events.rpy:3563
translate russian lavish_birthday_date_male_0f9e32e0:
    "Так громко, что слышит и Лавиш!"

# ch/lavish/events.rpy:3564
translate russian lavish_birthday_date_male_45e2de61:
    lavish.say "Ого!"

# ch/lavish/events.rpy:3566
translate russian lavish_birthday_date_male_89b3abb8:
    lavish.say "А я-то думала, что голодна!"

# ch/lavish/events.rpy:3567
translate russian lavish_birthday_date_male_700f54ac:
    mike.say "Да..."

# ch/lavish/events.rpy:3568
translate russian lavish_birthday_date_male_81840a0a:
    mike.say "Прошу прощения!"

# ch/lavish/events.rpy:3569
translate russian lavish_birthday_date_male_c885bfc8:
    mike.say "Пожалуй, пора достать еду."

# ch/lavish/events.rpy:3570
translate russian lavish_birthday_date_male_ee723704:
    "Я лезу в рюкзак за припасами."

# ch/lavish/events.rpy:3571
translate russian lavish_birthday_date_male_76e6d19c:
    "Одного взгляда на костёр хватает, чтобы понять, как их готовить."

# ch/lavish/events.rpy:3572
translate russian lavish_birthday_date_male_07aab315:
    mike.say "Пора приобщиться к обязательной части похода, Лавиш!"

# ch/lavish/events.rpy:3573
translate russian lavish_birthday_date_male_fe8b771d:
    mike.say "Сосиски и маршмеллоу!"

# ch/lavish/events.rpy:3574
translate russian lavish_birthday_date_male_210679ea:
    mike.say "На открытом огне — самое то."

# ch/lavish/events.rpy:3575
translate russian lavish_birthday_date_male_e4a8c51c:
    lavish.say "О-о!"

# ch/lavish/events.rpy:3576
translate russian lavish_birthday_date_male_d707dfb3:
    lavish.say "С чего начнём?"

# ch/lavish/events.rpy:3579
translate russian lavish_birthday_date_male_511a4e9d:
    mike.say "С сосисок, Лавиш..."

# ch/lavish/events.rpy:3580
translate russian lavish_birthday_date_male_aecdf2ca:
    mike.say "Всегда сначала сосиски!"

# ch/lavish/events.rpy:3581
translate russian lavish_birthday_date_male_39aee3a7:
    "Я начинаю нанизывать сосиски на палочки."

# ch/lavish/events.rpy:3582
translate russian lavish_birthday_date_male_9d169100:
    "Затем протягиваю одну Лавиш."

# ch/lavish/events.rpy:3584
translate russian lavish_birthday_date_male_3a5a2682:
    "И замечаю, что она ухмыляется."

# ch/lavish/events.rpy:3585
translate russian lavish_birthday_date_male_91ea2203:
    "Она принимает палочку, кивая и улыбаясь."

# ch/lavish/events.rpy:3586
translate russian lavish_birthday_date_male_3b282d8f:
    lavish.say "Я так и думала, [lssb_lavish.hero_name()]."

# ch/lavish/events.rpy:3587
translate russian lavish_birthday_date_male_e7f06df2:
    lavish.say "Ты всегда казался мне любителем сосисок!"

# ch/lavish/events.rpy:3588
translate russian lavish_birthday_date_male_d41780f3:
    lavish.say "Таким, которому не терпится подержать одну в руках!"

# ch/lavish/events.rpy:3589
translate russian lavish_birthday_date_male_06f49b8a:
    "Я хмурюсь и подношу свою палочку к огню."

# ch/lavish/events.rpy:3590
translate russian lavish_birthday_date_male_13d0fac4:
    mike.say "Ладно, Лавиш, очень смешно."

# ch/lavish/events.rpy:3591
translate russian lavish_birthday_date_male_25dc4213:
    mike.say "Дешевле шутки и не придумать."

# ch/lavish/events.rpy:3592
translate russian lavish_birthday_date_male_379069b6:
    mike.say "А теперь хотя бы попробуем вести себя как взрослые?"

# ch/lavish/events.rpy:3595
translate russian lavish_birthday_date_male_1b0ab928:
    "Лавиш кивает и тоже начинает жарить сосиску."

# ch/lavish/events.rpy:3596
translate russian lavish_birthday_date_male_590eaae5:
    "Но я всё это время слышу её тихое хихиканье."

# ch/lavish/events.rpy:3598
translate russian lavish_birthday_date_male_20f07f60:
    mike.say "С маршмеллоу, Лавиш..."

# ch/lavish/events.rpy:3599
translate russian lavish_birthday_date_male_73b1266e:
    mike.say "Всегда сначала маршмеллоу!"

# ch/lavish/events.rpy:3600
translate russian lavish_birthday_date_male_a635eaea:
    "Я начинаю нанизывать маршмеллоу на палочки."

# ch/lavish/events.rpy:3601
translate russian lavish_birthday_date_male_9d169100_1:
    "Затем протягиваю одну Лавиш."

# ch/lavish/events.rpy:3602
translate russian lavish_birthday_date_male_a55386a1:
    "Она разглядывает её с неподдельным интересом."

# ch/lavish/events.rpy:3604
translate russian lavish_birthday_date_male_7aabaa3a:
    "Потом поднимает на меня глаза и улыбается."

# ch/lavish/events.rpy:3605
translate russian lavish_birthday_date_male_6aadeaa8:
    lavish.say "Я ещё ни разу не жарила маршмеллоу."

# ch/lavish/events.rpy:3606
translate russian lavish_birthday_date_male_256e497d:
    lavish.say "Видела, как это делают в кино и по телевизору."

# ch/lavish/events.rpy:3607
translate russian lavish_birthday_date_male_18d29ef5:
    lavish.say "Наверное, миллион раз видела."

# ch/lavish/events.rpy:3608
translate russian lavish_birthday_date_male_78ae3785:
    lavish.say "Но так и не знаю, каково оно на вкус."

# ch/lavish/events.rpy:3609
translate russian lavish_birthday_date_male_29ce6980:
    mike.say "Сейчас самое время узнать."

# ch/lavish/events.rpy:3611
translate russian lavish_birthday_date_male_87411ccb:
    "Лавиш кивает и смотрит, как я начинаю поджаривать своё маршмеллоу."

# ch/lavish/events.rpy:3612
translate russian lavish_birthday_date_male_fb653d37:
    "Затем повторяет за мной."

# ch/lavish/events.rpy:3613
translate russian lavish_birthday_date_male_0de2d585:
    "Когда моё готово, я дую на него и откусываю."

# ch/lavish/events.rpy:3614
translate russian lavish_birthday_date_male_5e109fa1:
    "Поднимаю глаза и вижу: Лавиш повторяет каждое движение."

# ch/lavish/events.rpy:3615
translate russian lavish_birthday_date_male_a86dacab:
    "По крайней мере, пока не пробует маршмеллоу."

# ch/lavish/events.rpy:3619
translate russian lavish_birthday_date_male_7f7c92e6:
    "И тут её глаза расширяются от чистого восторга."

# ch/lavish/events.rpy:3620
translate russian lavish_birthday_date_male_ab250521:
    lavish.say "М-м-м!"

# ch/lavish/events.rpy:3621
translate russian lavish_birthday_date_male_c76aa4de:
    lavish.say "Как вкусно!"

# ch/lavish/events.rpy:3622
translate russian lavish_birthday_date_male_dd89b1da:
    mike.say "Что я говорил, Лавиш?"

# ch/lavish/events.rpy:3623
translate russian lavish_birthday_date_male_0b0d2f2f:
    mike.say "У походов определённо есть свои плюсы!"

# ch/lavish/events.rpy:3625
translate russian lavish_birthday_date_male_63ccc989:
    lavish.say "Так этот поход и есть мой подарок на день рождения?"

# ch/lavish/events.rpy:3626
translate russian lavish_birthday_date_male_8c44e0ed:
    lavish.say "Или ты приготовил ещё какой-нибудь сюрприз?"

# ch/lavish/events.rpy:3627
translate russian lavish_birthday_date_male_514d16de:
    lavish.say "Конечно, если подарок — сама поездка, я не против!"

# ch/lavish/events.rpy:3629
translate russian lavish_birthday_date_male_c4f78509:
    "Услышав это, я готов дать себе пощёчину."

# ch/lavish/events.rpy:3630
translate russian lavish_birthday_date_male_6d46c374:
    "Ведь собирался купить ей что-нибудь перед поездкой."

# ch/lavish/events.rpy:3631
translate russian lavish_birthday_date_male_8ac2c8be:
    "Но за всеми приготовлениями, видимо, забыл!"

# ch/lavish/events.rpy:3632
translate russian lavish_birthday_date_male_e93f8b70:
    "К счастью, она сама дала мне возможность выкрутиться."

# ch/lavish/events.rpy:3633
translate russian lavish_birthday_date_male_b6edaadd:
    "Неловко ею пользоваться, но какой ещё есть выход?"

# ch/lavish/events.rpy:3634
translate russian lavish_birthday_date_male_26de4949:
    mike.say "О да, Лавиш..."

# ch/lavish/events.rpy:3635
translate russian lavish_birthday_date_male_dbbfff34:
    mike.say "Поход и есть подарок!"

# ch/lavish/events.rpy:3638
translate russian lavish_birthday_date_male_e5ca786e:
    lavish.say "О..."

# ch/lavish/events.rpy:3639
translate russian lavish_birthday_date_male_a23b916b:
    lavish.say "Понятно..."

# ch/lavish/events.rpy:3641
translate russian lavish_birthday_date_male_dbb5b29e:
    lavish.say "Тогда всё хорошо."

# ch/lavish/events.rpy:3646
translate russian lavish_birthday_date_male_6af77890:
    mike.say "Ах да..."

# ch/lavish/events.rpy:3647
translate russian lavish_birthday_date_male_eddfb34b:
    mike.say "Спасибо, что напомнила, Лавиш."

# ch/lavish/events.rpy:3648
translate russian lavish_birthday_date_male_fb8a9d88:
    mike.say "Из-за всех приготовлений к поездке..."

# ch/lavish/events.rpy:3649
translate russian lavish_birthday_date_male_e8262030:
    mike.say "Чуть не забыл!"

# ch/lavish/events.rpy:3650
translate russian lavish_birthday_date_male_bd30be06:
    "Всё это я говорю, роясь в рюкзаке."

# ch/lavish/events.rpy:3651
translate russian lavish_birthday_date_male_febe8926:
    "Наконец нахожу подарок и протягиваю Лавиш."

# ch/lavish/events.rpy:3655
translate russian lavish_birthday_date_male_0e23973d:
    "Она с улыбкой принимает его и аккуратно снимает упаковку."

# ch/lavish/events.rpy:3658
translate russian lavish_birthday_date_male_63c25855:
    "Но при виде содержимого её лицо озаряется изумлением."

# ch/lavish/events.rpy:3659
translate russian lavish_birthday_date_male_e5ca786e_1:
    lavish.say "О..."

# ch/lavish/events.rpy:3661
translate russian lavish_birthday_date_male_fbab9673:
    lavish.say "Боже мой!"

# ch/lavish/events.rpy:3662
translate russian lavish_birthday_date_male_fca4d01a:
    mike.say "Что такое, Лавиш?"

# ch/lavish/events.rpy:3663
translate russian lavish_birthday_date_male_4a7e62f3:
    mike.say "Что-то не так?"

# ch/lavish/events.rpy:3665
translate russian lavish_birthday_date_male_e5ca786e_2:
    lavish.say "О..."

# ch/lavish/events.rpy:3666
translate russian lavish_birthday_date_male_26944e04_1:
    lavish.say "Нет-нет..."

# ch/lavish/events.rpy:3669
translate russian lavish_birthday_date_male_7b5506c8:
    lavish.say "Он идеальный, просто идеальный!"

# ch/lavish/events.rpy:3670
translate russian lavish_birthday_date_male_bcdde4cc:
    "Реакция Лавиш наполняет меня гордостью."

# ch/lavish/events.rpy:3671
translate russian lavish_birthday_date_male_07a45983:
    "Значит, я знаю её лучше, чем думал."

# ch/lavish/events.rpy:3674
translate russian lavish_birthday_date_male_bf0b7c1f:
    "Но при виде содержимого Лавиш выглядит разочарованной."

# ch/lavish/events.rpy:3675
translate russian lavish_birthday_date_male_fca4d01a_1:
    mike.say "Что такое, Лавиш?"

# ch/lavish/events.rpy:3676
translate russian lavish_birthday_date_male_4a7e62f3_1:
    mike.say "Что-то не так?"

# ch/lavish/events.rpy:3678
translate russian lavish_birthday_date_male_e5ca786e_3:
    lavish.say "О..."

# ch/lavish/events.rpy:3679
translate russian lavish_birthday_date_male_26944e04_2:
    lavish.say "Нет-нет..."

# ch/lavish/events.rpy:3680
translate russian lavish_birthday_date_male_8604bc58:
    lavish.say "Очень мило."

# ch/lavish/events.rpy:3681
translate russian lavish_birthday_date_male_cae05634:
    "Лавиш изо всех сил пытается это скрыть."

# ch/lavish/events.rpy:3682
translate russian lavish_birthday_date_male_61e6b4cc:
    "Но я всё равно понимаю: она хотела другой подарок."

# ch/lavish/events.rpy:3684
translate russian lavish_birthday_date_male_c4f78509_1:
    "Услышав это, я готов дать себе пощёчину."

# ch/lavish/events.rpy:3685
translate russian lavish_birthday_date_male_6d46c374_1:
    "Ведь собирался купить ей что-нибудь перед поездкой."

# ch/lavish/events.rpy:3686
translate russian lavish_birthday_date_male_8ac2c8be_1:
    "Но за всеми приготовлениями, видимо, забыл!"

# ch/lavish/events.rpy:3687
translate russian lavish_birthday_date_male_e93f8b70_1:
    "К счастью, она сама дала мне возможность выкрутиться."

# ch/lavish/events.rpy:3688
translate russian lavish_birthday_date_male_b6edaadd_1:
    "Неловко ею пользоваться, но какой ещё есть выход?"

# ch/lavish/events.rpy:3689
translate russian lavish_birthday_date_male_26de4949_1:
    mike.say "О да, Лавиш..."

# ch/lavish/events.rpy:3690
translate russian lavish_birthday_date_male_dbbfff34_1:
    mike.say "Поход и есть подарок!"

# ch/lavish/events.rpy:3693
translate russian lavish_birthday_date_male_e5ca786e_4:
    lavish.say "О..."

# ch/lavish/events.rpy:3694
translate russian lavish_birthday_date_male_a23b916b_1:
    lavish.say "Понятно..."

# ch/lavish/events.rpy:3696
translate russian lavish_birthday_date_male_dbb5b29e_1:
    lavish.say "Тогда всё хорошо."

# ch/lavish/events.rpy:3698
translate russian lavish_birthday_date_male_b646d1c2:
    "Солнце уже клонится к горизонту."

# ch/lavish/events.rpy:3699
translate russian lavish_birthday_date_male_93d20260:
    "Ночь близко, и быстро холодает."

# ch/lavish/events.rpy:3701
translate russian lavish_birthday_date_male_5eca0577:
    "Скоро даже костёр не сможет нас согреть."

# ch/lavish/events.rpy:3705
translate russian lavish_birthday_date_male_86e82027:
    mike.say "Пора в палатку, Лавиш."

# ch/lavish/events.rpy:3706
translate russian lavish_birthday_date_male_aefb2580:
    mike.say "В спальниках будет теплее."

# ch/lavish/events.rpy:3707
translate russian lavish_birthday_date_male_35e9098d:
    "Лавиш кивает, и мы начинаем устраиваться на ночлег."

# ch/lavish/events.rpy:3708
translate russian lavish_birthday_date_male_144fe0b0:
    "Но ведь мы не уснём, едва залезем в спальники."

# ch/lavish/events.rpy:3709
translate russian lavish_birthday_date_male_1efc2b4a:
    "До этого ещё можно кое-что успеть."

# ch/lavish/events.rpy:3711
translate russian lavish_birthday_date_male_79fb62a3:
    mike.say "Может, споём походную песню, Лавиш?"

# ch/lavish/events.rpy:3712
translate russian lavish_birthday_date_male_31519934:
    mike.say "Ещё одна традиция, которую стоит соблюсти."

# ch/lavish/events.rpy:3714
translate russian lavish_birthday_date_male_dcc46069:
    lavish.say "Просто споём вдвоём?"

# ch/lavish/events.rpy:3715
translate russian lavish_birthday_date_male_bb53953b:
    mike.say "Не совсем..."

# ch/lavish/events.rpy:3716
translate russian lavish_birthday_date_male_0cef00b3:
    mike.say "Я ведь не забыл взять вот это!"

# ch/lavish/events.rpy:3717
translate russian lavish_birthday_date_male_ca7915e2:
    "Я достаю гитару и перебираю струны."

# ch/lavish/events.rpy:3718
translate russian lavish_birthday_date_male_83e4c58a:
    "Затем готовлюсь спеть первое, что приходит в голову."

# ch/lavish/events.rpy:3721
translate russian lavish_birthday_date_male_da485776:
    "Сначала я немного запинаюсь: отвык."

# ch/lavish/events.rpy:3722
translate russian lavish_birthday_date_male_e654a896:
    "Но быстро вспоминаю, что к чему."

# ch/lavish/events.rpy:3723
translate russian lavish_birthday_date_male_8fbda949:
    "И вскоре во весь голос пою все песни, какие помню."

# ch/lavish/events.rpy:3725
translate russian lavish_birthday_date_male_72c008f3:
    "Лавиш внимательно слушает и теперь подпевает."

# ch/lavish/events.rpy:3726
translate russian lavish_birthday_date_male_7fcb350b:
    "До этого мне долго казалось, что она так и не решится."

# ch/lavish/events.rpy:3727
translate russian lavish_birthday_date_male_43ebd752:
    "Но когда наконец решается, её голос меня поражает."

# ch/lavish/events.rpy:3728
translate russian lavish_birthday_date_male_efd7a22e:
    "Когда песни заканчиваются, я не могу об этом промолчать."

# ch/lavish/events.rpy:3730
translate russian lavish_birthday_date_male_c752aab4:
    mike.say "Лавиш..."

# ch/lavish/events.rpy:3731
translate russian lavish_birthday_date_male_362b4bca:
    mike.say "Раньше я не слышал, как ты поёшь."

# ch/lavish/events.rpy:3732
translate russian lavish_birthday_date_male_fd95a39a:
    mike.say "Но голос у тебя... прекрасный!"

# ch/lavish/events.rpy:3734
translate russian lavish_birthday_date_male_da36f6c0:
    "Лавиш тут же краснеет и отмахивается от комплимента."

# ch/lavish/events.rpy:3735
translate russian lavish_birthday_date_male_14403b4f:
    "Хотя видно, что он её тронул."

# ch/lavish/events.rpy:3738
translate russian lavish_birthday_date_male_fdac23d3:
    lavish.say "Ничего особенного."

# ch/lavish/events.rpy:3739
translate russian lavish_birthday_date_male_46d0413d:
    lavish.say "Но если тебе правда нравится..."

# ch/lavish/events.rpy:3742
translate russian lavish_birthday_date_male_f46ab5df:
    lavish.say "Может, буду петь для тебя чаще."

# ch/lavish/events.rpy:3744
translate russian lavish_birthday_date_male_5da4dacf:
    "Уже поздно, и дневная нагрузка начинает сказываться."

# ch/lavish/events.rpy:3745
translate russian lavish_birthday_date_male_61b5c2f7:
    "Меньше всего хочется рано уснуть и упустить время с Лавиш."

# ch/lavish/events.rpy:3746
translate russian lavish_birthday_date_male_9ba219bf:
    "Но не закрывать глаза всё труднее."

# ch/lavish/events.rpy:3747
translate russian lavish_birthday_date_male_2ed8d112:
    "Разве что найду где-нибудь глубоко внутри запас сил."

# ch/lavish/events.rpy:3749
translate russian lavish_birthday_date_male_9781435f:
    mike.say "Лавиш?"

# ch/lavish/events.rpy:3750
translate russian lavish_birthday_date_male_ee42e4e5:
    mike.say "Ты ещё не спишь?"

# ch/lavish/events.rpy:3751
translate russian lavish_birthday_date_male_d8f6c761:
    lavish.say "А?.."

# ch/lavish/events.rpy:3753
translate russian lavish_birthday_date_male_753dfc45:
    lavish.say "Что?"

# ch/lavish/events.rpy:3754
translate russian lavish_birthday_date_male_672bec11:
    "Я посмеиваюсь, когда Лавиш приподнимается."

# ch/lavish/events.rpy:3755
translate russian lavish_birthday_date_male_6cec1655:
    mike.say "Кажется, ты почти уснула."

# ch/lavish/events.rpy:3757
translate russian lavish_birthday_date_male_4a6c227f:
    lavish.say "Нет... я не спала."

# ch/lavish/events.rpy:3758
translate russian lavish_birthday_date_male_9819a44f:
    lavish.say "Была вполне бодра!"

# ch/lavish/events.rpy:3759
translate russian lavish_birthday_date_male_3430bbf0:
    mike.say "То есть теперь ты храпишь наяву?"

# ch/lavish/events.rpy:3761
translate russian lavish_birthday_date_male_19e847a4:
    "Лавиш на миг смущается."

# ch/lavish/events.rpy:3764
translate russian lavish_birthday_date_male_a195ea04:
    "Но затем отшучивается."

# ch/lavish/events.rpy:3765
translate russian lavish_birthday_date_male_f8f134d1:
    "Мы ещё немного не спим."

# ch/lavish/events.rpy:3767
translate russian lavish_birthday_date_male_a37bbf33:
    "Просто болтаем обо всём понемногу."

# ch/lavish/events.rpy:3768
translate russian lavish_birthday_date_male_5b3c032b:
    "Пока сон не приходит сам собой."

# ch/lavish/events.rpy:3771
translate russian lavish_birthday_date_male_e958dfdd:
    lavish.say "[lssb_lavish.hero_name()]?"

# ch/lavish/events.rpy:3772
translate russian lavish_birthday_date_male_b0713f6f:
    lavish.say "Ты ещё не спишь?"

# ch/lavish/events.rpy:3773
translate russian lavish_birthday_date_male_1ccab2e1:
    mike.say "Хм..."

# ch/lavish/events.rpy:3774
translate russian lavish_birthday_date_male_4dda1c6b:
    mike.say "Что..."

# ch/lavish/events.rpy:3775
translate russian lavish_birthday_date_male_d6a746eb:
    mike.say "Я не сплю, мам!"

# ch/lavish/events.rpy:3777
translate russian lavish_birthday_date_male_85122e33:
    "С другой стороны палатки доносится хихиканье Лавиш."

# ch/lavish/events.rpy:3778
translate russian lavish_birthday_date_male_c155a10d:
    mike.say "Эй..."

# ch/lavish/events.rpy:3779
translate russian lavish_birthday_date_male_a7dbe9bc:
    mike.say "Я не сплю!"

# ch/lavish/events.rpy:3780
translate russian lavish_birthday_date_male_027019be:
    mike.say "Я сейчас не спал."

# ch/lavish/events.rpy:3782
translate russian lavish_birthday_date_male_265cc164:
    lavish.say "То есть ты храпишь наяву?"

# ch/lavish/events.rpy:3783
translate russian lavish_birthday_date_male_f6c4535e:
    lavish.say "Не переживай."

# ch/lavish/events.rpy:3785
translate russian lavish_birthday_date_male_d7400e6d:
    lavish.say "Если устал, спи."

# ch/lavish/events.rpy:3787
translate russian lavish_birthday_date_male_e0767a55:
    lavish.say "Со мной всё будет хорошо..."

# ch/lavish/events.rpy:3790
translate russian lavish_birthday_date_male_859ea0b4:
    lavish.say "[lssb_lavish.hero_name()], ты меня слышал?"

# ch/lavish/events.rpy:3791
translate russian lavish_birthday_date_male_9bd52ee2:
    mike.say "Хр-р-р..."

# ch/lavish/events.rpy:3794
translate russian lavish_birthday_date_male_8b1aa3e1:
    "Наверное, я ненадолго задремал."

# ch/lavish/events.rpy:3795
translate russian lavish_birthday_date_male_bdd0c234:
    "Прихожу в себя и вижу, что Лавиш нет в спальнике."

# ch/lavish/events.rpy:3797
translate russian lavish_birthday_date_male_172a76ca:
    "Она сидит у входа в палатку."

# ch/lavish/events.rpy:3798
translate russian lavish_birthday_date_male_5f0dfe37:
    "Молния расстёгнута, а она, кажется, смотрит в небо."

# ch/lavish/events.rpy:3799
translate russian lavish_birthday_date_male_150dd168:
    "Я подползаю к ней и сажусь рядом, наблюдая, как искры от костра кружатся в воздухе."

# ch/lavish/events.rpy:3801
translate russian lavish_birthday_date_male_e5ca786e_5:
    lavish.say "О..."

# ch/lavish/events.rpy:3803
translate russian lavish_birthday_date_male_ccba4088:
    lavish.say "Привет, [lssb_lavish.hero_name()]."

# ch/lavish/events.rpy:3804
translate russian lavish_birthday_date_male_57172997:
    lavish.say "Я смотрела на звёзды."

# ch/lavish/events.rpy:3805
translate russian lavish_birthday_date_male_2bb2fe7f:
    lavish.say "Никогда не видела их так ясно."

# ch/lavish/events.rpy:3806
translate russian lavish_birthday_date_male_5e4bcea9:
    lavish.say "И их так много."

# ch/lavish/events.rpy:3808
translate russian lavish_birthday_date_male_d85fa7ee:
    mike.say "Всё из-за городских огней, Лавиш."

# ch/lavish/events.rpy:3809
translate russian lavish_birthday_date_male_35cec157:
    mike.say "Здесь засветки меньше, поэтому небо виднее!"

# ch/lavish/events.rpy:3810
translate russian lavish_birthday_date_male_9681ff29:
    mike.say "Таким оно было тысячи лет назад."

# ch/lavish/events.rpy:3812
translate russian lavish_birthday_date_male_4fb392e0:
    "Лавиш охотно кивает, ловя каждое слово."

# ch/lavish/events.rpy:3813
translate russian lavish_birthday_date_male_08de7e83:
    "И придвигается ко мне."

# ch/lavish/events.rpy:3814
translate russian lavish_birthday_date_male_7715f365:
    "Очень приятно прислоняясь."

# ch/lavish/events.rpy:3815
translate russian lavish_birthday_date_male_f6beeb9d:
    lavish.say "Ты столько об этом знаешь, [lssb_lavish.hero_name()]."

# ch/lavish/events.rpy:3816
translate russian lavish_birthday_date_male_a39970ec:
    lavish.say "И названия звёзд тоже?"

# ch/lavish/events.rpy:3817
translate russian lavish_birthday_date_male_4d407a84:
    mike.say "Большинство созвездий знаю."

# ch/lavish/events.rpy:3818
translate russian lavish_birthday_date_male_75325f08:
    mike.say "Вот, например..."

# ch/lavish/events.rpy:3819
translate russian lavish_birthday_date_male_3ff7cfdb:
    mike.say "Это пояс Ориона."

# ch/lavish/events.rpy:3820
translate russian lavish_birthday_date_male_753273d0:
    mike.say "А вон там — ковш Большой Медведицы."

# ch/lavish/events.rpy:3823
translate russian lavish_birthday_date_male_0e1584dc:
    "Лавиш придвигается ещё ближе и смотрит, куда я показываю."

# ch/lavish/events.rpy:3824
translate russian lavish_birthday_date_male_48be1152:
    "Мне всё труднее сосредоточиться."

# ch/lavish/events.rpy:3825
translate russian lavish_birthday_date_male_8e2f2bc3:
    "Ведь к моему телу прижимается её тёплое тело."

# ch/lavish/events.rpy:3827
translate russian lavish_birthday_date_male_018d281c:
    "Мне кажется, Лавиш чего-то от меня ждёт."

# ch/lavish/events.rpy:3828
translate russian lavish_birthday_date_male_be077f12:
    "Например, глубокомысленной фразы и названий всех звёзд на небе."

# ch/lavish/events.rpy:3829
translate russian lavish_birthday_date_male_6c4bad9b:
    "Но стоит поднять голову, как мозг словно говорит: «Нет, спасибо»."

# ch/lavish/events.rpy:3830
translate russian lavish_birthday_date_male_780cd131:
    "И я начинаю нести чепуху, лишь бы заполнить паузу."

# ch/lavish/events.rpy:3831
translate russian lavish_birthday_date_male_30e74fc5:
    mike.say "Эм..."

# ch/lavish/events.rpy:3832
translate russian lavish_birthday_date_male_700f54ac_1:
    mike.say "Да..."

# ch/lavish/events.rpy:3833
translate russian lavish_birthday_date_male_5cebe018:
    mike.say "Не знаю, Лавиш."

# ch/lavish/events.rpy:3834
translate russian lavish_birthday_date_male_9e959c09:
    mike.say "Может, здесь мы просто ближе к небу?"

# ch/lavish/events.rpy:3836
translate russian lavish_birthday_date_male_2e8eef0e:
    "Лавиш косится на меня."

# ch/lavish/events.rpy:3837
translate russian lavish_birthday_date_male_bb3d10e2:
    "Будто у меня изо рта свисают дымящиеся какашки."

# ch/lavish/events.rpy:3838
translate russian lavish_birthday_date_male_90350b0d:
    "И качает головой."

# ch/lavish/events.rpy:3839
translate russian lavish_birthday_date_male_50da4ddd:
    lavish.say "Да уж..."

# ch/lavish/events.rpy:3842
translate russian lavish_birthday_date_male_bc19a2dc:
    lavish.say "Наверное, мне пора спать."

# ch/lavish/events.rpy:3843
translate russian lavish_birthday_date_male_003c4e86:
    "Она заползает обратно в палатку."

# ch/lavish/events.rpy:3844
translate russian lavish_birthday_date_male_9d710eb6:
    "Оставляя меня одного проклинать свой длинный глупый язык."

# ch/lavish/events.rpy:3846
translate russian lavish_birthday_date_male_daf949f4:
    "В какой-то момент мы оба, должно быть, уснули."

# ch/lavish/events.rpy:3847
translate russian lavish_birthday_date_male_e1735993:
    "Потому что просыпаюсь я от утренней прохлады."

# ch/lavish/events.rpy:3849
translate russian lavish_birthday_date_male_137e9985:
    "И первых лучей рассвета, заглядывающих в палатку."

# ch/lavish/events.rpy:3850
translate russian lavish_birthday_date_male_f34d1f0b:
    "Едва Лавиш открывает глаза, я заговариваю."

# ch/lavish/events.rpy:3851
translate russian lavish_birthday_date_male_c8647bd2:
    mike.say "Доброе утро, Лавиш..."

# ch/lavish/events.rpy:3852
translate russian lavish_birthday_date_male_f923beaa:
    mike.say "Хорошо спала?"

# ch/lavish/events.rpy:3854
translate russian lavish_birthday_date_male_e40f52f8:
    lavish.say "О-о..."

# ch/lavish/events.rpy:3855
translate russian lavish_birthday_date_male_66bb563c:
    lavish.say "Кажется, да."

# ch/lavish/events.rpy:3856
translate russian lavish_birthday_date_male_1c0d45e8:
    mike.say "Ну..."

# ch/lavish/events.rpy:3857
translate russian lavish_birthday_date_male_325816de:
