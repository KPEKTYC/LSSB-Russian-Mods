    "Лавиш гневно уходит, даже не обернувшись."

# ch/lavish/gift.rpy:168
translate russian lavish_gift_collar_male_8daaaa42:
    "И я остаюсь один."

# ch/lavish/gift.rpy:169
translate russian lavish_gift_collar_male_4ed5a75b:
