# ch/lavish/events.rpy:3203
translate russian lavish_sub_03_24c5b039:
    "А Одри как раз из тех, кому это понравится."

# ch/lavish/events.rpy:3204
translate russian lavish_sub_03_46e10276:
    "Так что какого чёрта — была не была..."

# ch/lavish/events.rpy:3205
translate russian lavish_sub_03_acd1bdad:
    mike.say "Ладно, Лавиш..."

# ch/lavish/events.rpy:3206
translate russian lavish_sub_03_79cb664c:
    mike.say "Придётся напомнить тебе, кто здесь старше по должности."

# ch/lavish/events.rpy:3208
