# ch/lavish/gift.rpy:128
translate russian lavish_gift_collar_male_86f6d860:
    lavish.say "Что я хорошая девочка!"

# ch/lavish/gift.rpy:129
translate russian lavish_gift_collar_male_7703214f:
    "Я киваю, подхожу ближе и забираю у неё ошейник."

# ch/lavish/gift.rpy:130
translate russian lavish_gift_collar_male_df66e753:
