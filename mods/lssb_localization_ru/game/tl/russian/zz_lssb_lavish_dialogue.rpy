    lavish.say "О..."

# ch/lavish/gift.rpy:213
translate russian lavish_gift_sexy_dress_male_cb576387:
    lavish.say "Что это у тебя, [lssb_lavish.hero_name()]?"

# ch/lavish/gift.rpy:215
translate russian lavish_gift_sexy_dress_male_f1d8a63c:
    mike.say "Эм..."

# ch/lavish/gift.rpy:216
translate russian lavish_gift_sexy_dress_male_adf7762f:
    mike.say "Да ничего особенного, Лавиш."

# ch/lavish/gift.rpy:217
translate russian lavish_gift_sexy_dress_male_ba911779:
    mike.say "Просто кое-что купил на днях, вот и всё..."

# ch/lavish/gift.rpy:218
translate russian lavish_gift_sexy_dress_male_c4cee282:
    "Лавиш перестаёт пытаться заглянуть мне за спину."

# ch/lavish/gift.rpy:220
translate russian lavish_gift_sexy_dress_male_203e75b1:
