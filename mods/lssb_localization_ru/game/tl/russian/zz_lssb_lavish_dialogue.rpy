# ch/lavish/gift.rpy:132
translate russian lavish_gift_collar_male_d77eab85:
    "Словно от возбуждения ей не хватает воздуха."

# ch/lavish/gift.rpy:137
translate russian lavish_gift_collar_male_bc338630:
    mike.say "Вот так, Лавиш."

# ch/lavish/gift.rpy:138
