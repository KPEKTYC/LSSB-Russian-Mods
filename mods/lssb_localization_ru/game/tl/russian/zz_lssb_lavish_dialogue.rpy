# ch/lavish/date.rpy:606
translate russian lavish_halloween_sex_9e6a1780:
    "С каждым толчком от знакомой мне сдержанной девушки словно спадает ещё один слой."

# ch/lavish/date.rpy:607
translate russian lavish_halloween_sex_b4d2f900:
