    lavish.say "Ох..."

# ch/lavish/events.rpy:3102
translate russian lavish_spanking_2_f2f9ccdd:
    lavish.say "Дело совсем не в этом!"

# ch/lavish/events.rpy:3104
translate russian lavish_spanking_2_2a4f6b99:
