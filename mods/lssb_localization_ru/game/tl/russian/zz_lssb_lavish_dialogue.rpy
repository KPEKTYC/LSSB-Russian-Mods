# ch/lavish/events.rpy:3187
translate russian lavish_sub_03_b4673b29:
    shiori.say "И [lssb_lavish.hero_name()], по-моему, не заслуживает такого тона!"

# ch/lavish/events.rpy:3189
translate russian lavish_sub_03_55805590:
