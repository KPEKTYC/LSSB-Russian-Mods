# ch/lavish/gift.rpy:100
translate russian lavish_gift_collar_male_ce374a5a:
    lavish.say "А эта подвеска..."

# ch/lavish/gift.rpy:101
translate russian lavish_gift_collar_male_79cc5bcc:
