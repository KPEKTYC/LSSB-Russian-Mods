# ch/lavish/events.rpy:3119
translate russian lavish_spanking_2_803cf858:
    lavish.say "Я... кажется, я пристрастилась к порке!"

# ch/lavish/events.rpy:3120
translate russian lavish_spanking_2_15e479e1:
    lavish.say "С каждым днём хочется всё сильнее."

# ch/lavish/events.rpy:3121
translate russian lavish_spanking_2_b9b5f77e:
