# ch/lavish/events.rpy:3177
translate russian lavish_sub_03_1ccab2e1:
    mike.say "Хм..."

# ch/lavish/events.rpy:3178
translate russian lavish_sub_03_8ccd1ed1:
    mike.say "Что такое, Лавиш?"

# ch/lavish/events.rpy:3180
translate russian lavish_sub_03_833f3954:
    "Лавиш скрещивает руки на груди и качает головой."

# ch/lavish/events.rpy:3181
translate russian lavish_sub_03_c4bccb04:
