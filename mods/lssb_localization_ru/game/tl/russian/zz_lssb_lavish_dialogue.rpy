# ch/lavish/gift.rpy:102
translate russian lavish_gift_collar_male_9f03b5de:
    lavish.say "Ну... на собачий ошейник!"

# ch/lavish/gift.rpy:103
translate russian lavish_gift_collar_male_139f9432:
    "Я киваю и широко улыбаюсь."

# ch/lavish/gift.rpy:104
translate russian lavish_gift_collar_male_cb3794b1:
    mike.say "В этом и смысл, Лавиш."

# ch/lavish/gift.rpy:105
translate russian lavish_gift_collar_male_3f873654:
    mike.say "Чтобы все знали, что ты моя."

# ch/lavish/gift.rpy:106
translate russian lavish_gift_collar_male_58afd250:
