# ch/lavish/date.rpy:603
translate russian lavish_halloween_sex_78a48ec9:
    "Я нахожу ровный ритм и вхожу до конца, а она отвечает на каждый толчок."

# ch/lavish/date.rpy:604
translate russian lavish_halloween_sex_b84eea36:
    lavish.say "Да! Да, вот так!"

# ch/lavish/date.rpy:605
translate russian lavish_halloween_sex_744f0fe2:
