# ch/lavish/events.rpy:3131
translate russian lavish_spanking_2_c64f65a9:
    lavish.say "Мои упругие круглые ягодицы..."

# ch/lavish/events.rpy:3132
translate russian lavish_spanking_2_c034817e:
    mike.say "ЛАДНО..."

# ch/lavish/events.rpy:3133
translate russian lavish_spanking_2_acd1bdad:
    mike.say "Ладно, Лавиш..."

# ch/lavish/events.rpy:3134
translate russian lavish_spanking_2_0b83dab1:
    mike.say "Картину я понял!"

# ch/lavish/events.rpy:3135
translate russian lavish_spanking_2_8d28885b:
    "Я глубоко вдыхаю и стараюсь тщательно подобрать слова."

# ch/lavish/events.rpy:3136
translate russian lavish_spanking_2_cbe149a6:
