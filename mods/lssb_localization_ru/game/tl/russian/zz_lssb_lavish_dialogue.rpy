# ch/lavish/gift.rpy:81
translate russian lavish_gift_collar_male_59bc5e02:
    "И чем сильнее человека тянет в одну сторону..."

# ch/lavish/gift.rpy:82
translate russian lavish_gift_collar_male_1b34c3fa:
