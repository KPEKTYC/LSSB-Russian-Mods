# ch/lexi/gift.rpy:306
translate russian lexi_gift_butt_plug_male_1a19f559:
    "Она разворачивает анальную пробку."

# ch/lexi/gift.rpy:309
translate russian lexi_gift_butt_plug_male_b3931d2c:
    lexi.say "..."

# ch/lexi/gift.rpy:310
translate russian lexi_gift_butt_plug_male_35f9f472:
    lexi.say "Оставь себе... Мне не надо, так что оставь."

# ch/lexi/gift.rpy:311
translate russian lexi_gift_butt_plug_male_ba0f7472:
    lexi.say "Уверена, тебе она пригодится больше, чем мне."

# ch/lexi/gift.rpy:315
translate russian lexi_gift_butt_plug_male_3a85a8b6:
    lexi.say "Идеально!"

# ch/lexi/gift.rpy:317
translate russian lexi_gift_butt_plug_male_4dbb6dd3:
    lexi.say "Спасибо, [lssb_lexi.hero_name()], я найду ей хорошее применение."

# ch/lexi/reactions.rpy:2
translate russian lexi_ice_cream_reaction_male_dda917a5:
    mike.say "Боже, сегодня чертовски жарко. Надо взять мороженое!"

# ch/lexi/reactions.rpy:3
translate russian lexi_ice_cream_reaction_male_d5f7a015:
    lexi.say "Вот это дело! Пойдём прямо сейчас!"

# ch/lexi/reactions.rpy:4
translate russian lexi_ice_cream_reaction_male_73a4ddd7:
    "У киоска с мороженым я покупаю рожок с парой разных шариков."

# ch/lexi/reactions.rpy:5
translate russian lexi_ice_cream_reaction_male_98812f18:
    "Лекси выбирает разноцветный фруктовый лёд на палочке, полосатый и блестящий на солнце."

# ch/lexi/reactions.rpy:6
translate russian lexi_ice_cream_reaction_male_e156dc4c:
    mike.say "Я такое есть не могу, Лекси: от него мозги замерзают!"

# ch/lexi/reactions.rpy:7
translate russian lexi_ice_cream_reaction_male_d5a965a7:
    lexi.say "А у меня нет. Я его, блин, обожаю!"

# ch/lexi/reactions.rpy:8
translate russian lexi_ice_cream_reaction_male_8cc5cffe:
    "Я собираюсь добавить что-то ещё, но замечаю, как Лекси его лижет."

# ch/lexi/reactions.rpy:9
translate russian lexi_ice_cream_reaction_male_a4aa76d9:
    "И слова застревают в горле: я молча наблюдаю."

# ch/lexi/reactions.rpy:10
translate russian lexi_ice_cream_reaction_male_047f0ac5:
    "Лекси принимается за фруктовый лёд так, словно от этого зависит её жизнь."

# ch/lexi/reactions.rpy:11
translate russian lexi_ice_cream_reaction_male_0af8dcd6:
    "Я точно знаю: она делает это нарочно и наслаждается тем, что я смотрю!"

# ch/lexi/reactions.rpy:15
translate russian lexi_ask_phone_male_9b676e05:
    mike.say "Дашь мне свой номер, Лекси?"

# ch/lexi/reactions.rpy:16
translate russian lexi_ask_phone_male_999ac0ae:
    mike.say "Я бы очень хотел как-нибудь тебе позвонить!"

# ch/lexi/reactions.rpy:20
translate russian lexi_ask_phone_male_a6679541:
    lexi.say "Конечно, [lssb_lexi.hero_name()]!"

# ch/lexi/reactions.rpy:21
translate russian lexi_ask_phone_male_09ba2fc4:
    lexi.say "Будет у тебя личная горячая линия Лекси!"

# ch/lexi/reactions.rpy:22
translate russian lexi_ask_phone_male_d7d5d357:
    lexi.say "А у меня — смачные фотки члена..."

# ch/lexi/reactions.rpy:27
translate russian lexi_ask_phone_male_400ab564:
    lexi.say "Нет, личный номер не дам, [lssb_lexi.hero_name()]."

# ch/lexi/reactions.rpy:28
translate russian lexi_ask_phone_male_593b621d:
    lexi.say "Он нужен мне для бизнеса!"

# ch/lexi/reactions.rpy:32
translate russian lexi_ask_birthday_male_cb9cb447:
    mike.say "Твой день рождения, Лекси."

# ch/lexi/reactions.rpy:33
translate russian lexi_ask_birthday_male_e95a4c00:
    mike.say "Ты так и не сказала, когда он!"

# ch/lexi/reactions.rpy:37
translate russian lexi_ask_birthday_male_33cda0d6:
