# ch/lexi/gift.rpy:297
translate russian lexi_gift_collar_male_b8c056d8:
    mike.say "Как мне?"

# ch/lexi/gift.rpy:298
translate russian lexi_gift_collar_male_e6bd4539:
    mike.say "Думаю, лучше я покажу, что чувствую, Лекси!"

# ch/lexi/gift.rpy:299
translate russian lexi_gift_collar_male_e739497f:
    "Каким-то образом от этих слов улыбка Лекси становится ещё шире."

# ch/lexi/gift.rpy:300
translate russian lexi_gift_collar_male_519f1a88:
