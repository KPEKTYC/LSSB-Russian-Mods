# ch/lexi/reactions.rpy:38
translate russian lexi_ask_birthday_male_58eb34af:
    lexi.say "Но, если что, он в пятый день лета."

# ch/lexi/reactions.rpy:43
translate russian lexi_ask_birthday_male_e25c13a4:
    lexi.say "Эй?!"

# ch/lexi/reactions.rpy:44
translate russian lexi_ask_birthday_male_f9308510:
    lexi.say "На что ты намекаешь?"

# ch/lexi/reactions.rpy:45
translate russian lexi_ask_birthday_male_2410732d:
    lexi.say "Я и живу на износ, и отрываюсь по полной."

# ch/lexi/reactions.rpy:46
translate russian lexi_ask_birthday_male_09970b48:
    lexi.say "Такое на девушке сказывается!"

# ch/lexi/reactions.rpy:50
translate russian lexi_offer_a_drink_male_200eb25b:
    mike.say "Эй!"

# ch/lexi/reactions.rpy:51
translate russian lexi_offer_a_drink_male_8d337540:
    mike.say "Лекси!"

# ch/lexi/reactions.rpy:52
translate russian lexi_offer_a_drink_male_201b2952:
    mike.say "Пива?"

# ch/lexi/reactions.rpy:53
translate russian lexi_offer_a_drink_male_3db21aca:
    "Едва я успеваю произнести эти слова, Лекси поворачивается ко мне."

# ch/lexi/reactions.rpy:57
translate russian lexi_offer_a_drink_male_0c101f2b:
    lexi.say "Эй, моя мать пила, пока была мной беременна."

# ch/lexi/reactions.rpy:58
translate russian lexi_offer_a_drink_male_498860f7:
    lexi.say "И некоторые говорили, что именно поэтому я такая непутёвая!"

# ch/lexi/reactions.rpy:59
translate russian lexi_offer_a_drink_male_06b8ca05:
    lexi.say "Хочу, чтобы у нашего ребёнка было иначе."

# ch/lexi/reactions.rpy:64
translate russian lexi_offer_a_drink_male_2ac3b1fa:
    lexi.say "Ты знаешь, как обращаться с дамой, [lssb_lexi.hero_name()]!"

# ch/lexi/reactions.rpy:65
translate russian lexi_offer_a_drink_male_8cc360f4:
    lexi.say "Кинь мне одно, ладно?"

# ch/lexi/reactions.rpy:77
translate russian lexi_offer_a_drink_male_d99b1f82:
    lexi.say "О нет, ни за что!"

# ch/lexi/reactions.rpy:78
translate russian lexi_offer_a_drink_male_e4e17eef:
    lexi.say "Мне СЛИШКОМ часто подмешивали всякое в выпивку, чтобы я на это купилась!"

# ch/lexi/reactions.rpy:84
translate russian lexi_slap_ass_intro_male_fa58d45b:
    "Дело не только в том, что у Лекси невероятно сексуальное тело."

# ch/lexi/reactions.rpy:85
translate russian lexi_slap_ass_intro_male_0cd9d815:
    "Она ещё и ходит так, чтобы выставить его во всей красе."

# ch/lexi/reactions.rpy:86
translate russian lexi_slap_ass_intro_male_9e4a526a:
    "Каждая часть её тела движется так, что притягивает мой взгляд."

# ch/lexi/reactions.rpy:87
translate russian lexi_slap_ass_intro_male_70ae6662:
    "Но особенно попка — она меня завораживает."

# ch/lexi/reactions.rpy:88
translate russian lexi_slap_ass_intro_male_4e879df2:
    "Я просто не могу удержаться от желания её шлёпнуть..."

# ch/lexi/reactions.rpy:92
translate russian lexi_slap_ass_happy_male_0fc7c99f:
    lexi.say "Ого..."

# ch/lexi/reactions.rpy:93
translate russian lexi_slap_ass_happy_male_9cfd2fda:
    lexi.say "Кто тут трогает товар?!"

# ch/lexi/reactions.rpy:94
translate russian lexi_slap_ass_happy_male_4b6be747:
    lexi.say "[lssb_lexi.hero_name()], это ты?"

# ch/lexi/reactions.rpy:95
translate russian lexi_slap_ass_happy_male_4e521c41:
    "Отпираться нет смысла."

# ch/lexi/reactions.rpy:96
translate russian lexi_slap_ass_happy_male_56563fa0:
    "Поэтому я лишь пожимаю плечами и киваю."

# ch/lexi/reactions.rpy:97
translate russian lexi_slap_ass_happy_male_8265b459:
    lexi.say "Ну, не могу сказать, что тебя виню."

# ch/lexi/reactions.rpy:98
translate russian lexi_slap_ass_happy_male_03608e68:
    lexi.say "Только в следующий раз чуть сильнее, ладно?"

# ch/lexi/reactions.rpy:99
translate russian lexi_slap_ass_happy_male_e1e1adf6:
    lexi.say "Девушке нравится, когда пожёстче..."

# ch/lexi/reactions.rpy:103
translate russian lexi_slap_ass_angry_male_0fc7c99f:
    lexi.say "Ого..."

# ch/lexi/reactions.rpy:104
translate russian lexi_slap_ass_angry_male_9cfd2fda:
    lexi.say "Кто тут трогает товар?!"

# ch/lexi/reactions.rpy:105
translate russian lexi_slap_ass_angry_male_4b6be747:
    lexi.say "[lssb_lexi.hero_name()], это ты?"

# ch/lexi/reactions.rpy:106
translate russian lexi_slap_ass_angry_male_4e521c41:
    "Отпираться нет смысла."

# ch/lexi/reactions.rpy:107
translate russian lexi_slap_ass_angry_male_56563fa0:
    "Поэтому я лишь пожимаю плечами и киваю."

# ch/lexi/reactions.rpy:108
translate russian lexi_slap_ass_angry_male_f0884f4a:
    lexi.say "Больше так не делай, ладно?"

# ch/lexi/reactions.rpy:109
translate russian lexi_slap_ass_angry_male_42f0ff4a:
    lexi.say "Не хочу, чтобы люди думали, будто я занята."

# ch/lexi/reactions.rpy:110
translate russian lexi_slap_ass_angry_male_baa73050:
    lexi.say "Девушке нужно зарабатывать на жизнь..."

# ch/lexi/reactions.rpy:115
translate russian lexi_breakup_male_51cb0c21:
    "Это ведь должно быть просто, да?"

# ch/lexi/reactions.rpy:116
translate russian lexi_breakup_male_c656551a:
    "Лекси не из тех девушек, что чего-то стесняются."

# ch/lexi/reactions.rpy:117
translate russian lexi_breakup_male_1262766d:
    "И на жизнь она зарабатывала, свободно распоряжаясь своим телом."

# ch/lexi/reactions.rpy:118
translate russian lexi_breakup_male_66110fc7:
    "Так что моё желание расстаться не должно слишком её выбить из колеи."

# ch/lexi/reactions.rpy:119
translate russian lexi_breakup_male_2aa8efd7:
    "Наверняка она спокойно это воспримет..."

# ch/lexi/reactions.rpy:120
translate russian lexi_breakup_male_f987b341:
    mike.say "Эй, Лекси..."

# ch/lexi/reactions.rpy:121
translate russian lexi_breakup_male_7a3a31b5:
    mike.say "Я тут подумал..."

# ch/lexi/reactions.rpy:122
translate russian lexi_breakup_male_40998782:
    mike.say "Может, нам пора всё закончить, понимаешь?"

# ch/lexi/reactions.rpy:123
translate russian lexi_breakup_male_932663a0:
    "Лекси резко замирает."

# ch/lexi/reactions.rpy:124
translate russian lexi_breakup_male_eebb0cee:
    "У неё отвисает челюсть."

# ch/lexi/reactions.rpy:125
translate russian lexi_breakup_male_c0656c4c:
    "И она смотрит на меня с потрясением."

# ch/lexi/reactions.rpy:127
translate russian lexi_breakup_male_12fa20cb:
    lexi.say "Т... ты вот так сейчас на меня это вываливаешь, [lssb_lexi.hero_name()]?"

# ch/lexi/reactions.rpy:128
translate russian lexi_breakup_male_58ac93ba:
    lexi.say "Говоришь такое без всякого предупреждения?"

# ch/lexi/reactions.rpy:129
translate russian lexi_breakup_male_4a978dde:
    lexi.say "И так буднично, будто ничего особенного!"

# ch/lexi/reactions.rpy:130
translate russian lexi_breakup_male_7f5661ae:
    "Реакция Лекси меня по-настоящему ошеломляет."

# ch/lexi/reactions.rpy:131
translate russian lexi_breakup_male_3f790b70:
    "Она явно расстроена, даже оскорблена!"

# ch/lexi/reactions.rpy:132
translate russian lexi_breakup_male_702ff46f:
    mike.say "Я... не понимаю, Лекси."

# ch/lexi/reactions.rpy:133
translate russian lexi_breakup_male_57f07d6c:
    mike.say "Думал, ты отнесёшься спокойно."

# ch/lexi/reactions.rpy:134
translate russian lexi_breakup_male_de138849:
    mike.say "Ну... учитывая твою работу..."

# ch/lexi/reactions.rpy:135
translate russian lexi_breakup_male_f6834796:
    "Я вижу, как в глазах Лекси внезапно вспыхивает гнев."

# ch/lexi/reactions.rpy:136
translate russian lexi_breakup_male_86e7531d:
    "И понимаю, что сильно ошибся в оценке ситуации."

# ch/lexi/reactions.rpy:137
translate russian lexi_breakup_male_342218e9:
    "Лекси упирает руки в бока, чуть ли не готовясь броситься на меня."

# ch/lexi/reactions.rpy:139
translate russian lexi_breakup_male_f2fa0ff4:
    lexi.say "Почему бы не сказать прямо, [lssb_lexi.hero_name()]?"

# ch/lexi/reactions.rpy:140
translate russian lexi_breakup_male_0228d972:
    lexi.say "Ты считаешь меня просто дешёвой шлюхой, да?"

# ch/lexi/reactions.rpy:141
translate russian lexi_breakup_male_d426fcfe:
    lexi.say "И, значит, можешь трахать меня, пока приятно."

# ch/lexi/reactions.rpy:142
translate russian lexi_breakup_male_50e87b23:
    lexi.say "А потом выбросить, когда надоест!"

# ch/lexi/reactions.rpy:143
translate russian lexi_breakup_male_ec039e7e:
    mike.say "Нет, Лекси!"

# ch/lexi/reactions.rpy:144
translate russian lexi_breakup_male_b011933b:
    mike.say "Всё не так!"

