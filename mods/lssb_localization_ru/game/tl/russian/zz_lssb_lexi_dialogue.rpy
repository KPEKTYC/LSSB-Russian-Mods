# ch/lexi/date.rpy:724
translate russian lexi_halloween_invitation_7f963565:
    "Мало того что Лекси придёт на вечеринку."

# ch/lexi/date.rpy:725
translate russian lexi_halloween_invitation_88a91025:
    "Она ещё и обещает сразить меня своим костюмом!"

# ch/lexi/date.rpy:726
translate russian lexi_halloween_invitation_c1333595:
    "Лучше не бывает."

# ch/lexi/date.rpy:730
translate russian lexi_halloween_invitation_c76e7c19:
    "Лекси удивляет меня: морщит нос и качает головой."

# ch/lexi/date.rpy:732
translate russian lexi_halloween_invitation_abc476a2:
    lexi.say "Не, пожалуй, откажусь."

# ch/lexi/date.rpy:733
translate russian lexi_halloween_invitation_21b52759:
    lexi.say "Звучит как-то уныло, [lssb_lexi.hero_name()]."

# ch/lexi/date.rpy:735
translate russian lexi_halloween_invitation_1b158738:
    lexi.say "Обычно на Хэллоуин я отрываюсь по полной."

# ch/lexi/date.rpy:736
translate russian lexi_halloween_invitation_3de321a9:
    "На мгновение я теряюсь и не знаю, что сказать."

# ch/lexi/date.rpy:737
translate russian lexi_halloween_invitation_40d6c968:
    "Я был уверен, что Лекси согласится."

# ch/lexi/date.rpy:738
translate russian lexi_halloween_invitation_42a68746:
    "Но, наверное, так мне и надо."

# ch/lexi/date.rpy:739
translate russian lexi_halloween_invitation_52d93454:
    "Не стоило принимать её согласие как должное!"

# ch/lexi/date.rpy:740
translate russian lexi_halloween_invitation_86d07102:
    mike.say "А..."

# ch/lexi/date.rpy:741
translate russian lexi_halloween_invitation_e5f42698:
    mike.say "Ладно, Лекси."

# ch/lexi/date.rpy:742
translate russian lexi_halloween_invitation_2e516b84:
    mike.say "Если у тебя уже есть планы..."

# ch/lexi/date.rpy:743
translate russian lexi_halloween_invitation_89339dab:
    "Лекси радостно кивает."

# ch/lexi/date.rpy:744
translate russian lexi_halloween_invitation_8329271f:
    "Словно совсем не переживает, что меня разочаровала."

# ch/lexi/date.rpy:745
translate russian lexi_halloween_invitation_00d8d28e:
    lexi.say "Да, я вроде как человек привычки."

# ch/lexi/date.rpy:746
translate russian lexi_halloween_invitation_a7f4d8f0:
    lexi.say "Слушай, а почему бы тебе тоже не забить на вечеринку?"

# ch/lexi/date.rpy:747
translate russian lexi_halloween_invitation_3563abf6:
    lexi.say "Можем вместе что-нибудь устроить на Хэллоуин."

# ch/lexi/date.rpy:749
translate russian lexi_halloween_invitation_9a002fcf:
    lexi.say "Обещаю, со мной тебе будет веселее!"

# ch/lexi/date.rpy:750
translate russian lexi_halloween_invitation_f1d8a63c:
    mike.say "Эм..."

# ch/lexi/date.rpy:751
translate russian lexi_halloween_invitation_79e72cda:
    mike.say "Дай подумать, ладно?"

# ch/lexi/date.rpy:757
translate russian lexi_halloween_arrival_15df0e97:
    "Я ещё мгновение смотрю на дверь, а потом хлопаю себя по лбу."

# ch/lexi/date.rpy:758
translate russian lexi_halloween_arrival_ce66dc14:
    "Ну конечно, Лекси ведь тоже здесь живёт."

# ch/lexi/date.rpy:759
translate russian lexi_halloween_arrival_bfb57e07:
    "Значит, моя спутница уже дома!"

# ch/lexi/date.rpy:760
translate russian lexi_halloween_arrival_f05a3393:
    "Господи, я, наверное, совсем выжил из ума, пока готовился к вечеринке."

# ch/lexi/date.rpy:764
translate russian lexi_halloween_arrival_2a77933e:
    "А вот с Лекси всё в порядке: она выжидающе на меня смотрит."

# ch/lexi/date.rpy:765
translate russian lexi_halloween_arrival_8a09a27e:
    lexi.say "Ну, [lssb_lexi.hero_name()], я жду."

# ch/lexi/date.rpy:766
translate russian lexi_halloween_arrival_c1089473:
    lexi.say "Что скажешь о моём костюме?"

# ch/lexi/date.rpy:767
translate russian lexi_halloween_arrival_d883eef3:
    "Я ещё раз оглядываю Лекси с головы до ног."

# ch/lexi/date.rpy:768
translate russian lexi_halloween_arrival_d7b96df3:
    "Затем делаю глубокий вдох."

# ch/lexi/date.rpy:769
translate russian lexi_halloween_arrival_7155e040:
    "Готовясь высказать всё, что думаю."

# ch/lexi/date.rpy:772
translate russian lexi_halloween_arrival_958feac5:
    mike.say "Ого, Лекси... просто ого!"

# ch/lexi/date.rpy:773
translate russian lexi_halloween_arrival_547c3fa5:
    mike.say "Не хотел говорить это при остальных."

# ch/lexi/date.rpy:774
translate russian lexi_halloween_arrival_91f4b3a9:
    mike.say "Но ты выглядишь ТАК сексуально!"

# ch/lexi/date.rpy:778
translate russian lexi_halloween_arrival_efd6a100:
    "От комплимента Лекси почти мурлычет."

# ch/lexi/date.rpy:779
translate russian lexi_halloween_arrival_6d6a7d63:
    "И я вижу, что именно этого ответа она ждала."

# ch/lexi/date.rpy:780
translate russian lexi_halloween_arrival_f8a69134:
    lexi.say "Ага, так и знала, что тебе крышу снесёт."

# ch/lexi/date.rpy:781
translate russian lexi_halloween_arrival_20d099c5:
    lexi.say "Ты же у нас помешан на играх и всё такое!"

# ch/lexi/date.rpy:782
translate russian lexi_halloween_arrival_ccfe3459:
    mike.say "Я знаю, сегодня мы должны быть хорошими хозяевами."

# ch/lexi/date.rpy:783
translate russian lexi_halloween_arrival_b2a6d8ac:
    mike.say "Но мне ужасно хочется побыть с тобой наедине."

# ch/lexi/date.rpy:784
translate russian lexi_halloween_arrival_12486ddc:
    mike.say "Если понимаешь, о чём я?"

# ch/lexi/date.rpy:786
translate russian lexi_halloween_arrival_73f993f4:
    "Лекси издаёт самый похабный смешок, какой я когда-либо слышал."

# ch/lexi/date.rpy:787
translate russian lexi_halloween_arrival_2bc47450:
    "Но при этом заговорщицки кивает."

# ch/lexi/date.rpy:788
translate russian lexi_halloween_arrival_9ecd37df:
    lexi.say "О, не волнуйся, [lssb_lexi.hero_name()]."

# ch/lexi/date.rpy:789
translate russian lexi_halloween_arrival_b99e1a32:
    lexi.say "Юбка у меня совсем короткая, а трусики высоко подтянуты."

# ch/lexi/date.rpy:790
translate russian lexi_halloween_arrival_f6e8ebfa:
    lexi.say "Можешь войти в меня так, что никто и не заметит!"

# ch/lexi/date.rpy:791
translate russian lexi_halloween_arrival_c4d09e90:
    "С этими словами она разворачивается и уходит."

# ch/lexi/date.rpy:792
translate russian lexi_halloween_arrival_7132ce74:
    "Мне остаётся следовать за ней, неловко пытаясь скрыть внезапный стояк."

# ch/lexi/date.rpy:794
translate russian lexi_halloween_arrival_f1d8a63c:
    mike.say "Эм..."

# ch/lexi/date.rpy:795
translate russian lexi_halloween_arrival_75e4bd5a:
    mike.say "Отлично, Лекси."

# ch/lexi/date.rpy:796
translate russian lexi_halloween_arrival_b2c72528:
    mike.say "Очень хороший костюм."

# ch/lexi/date.rpy:798
translate russian lexi_halloween_arrival_62e45bd4:
    "Лекси прищуривается и почти кривится."

# ch/lexi/date.rpy:799
translate russian lexi_halloween_arrival_65efd1af:
    "Очевидно, она ждала другого ответа."

# ch/lexi/date.rpy:800
translate russian lexi_halloween_arrival_ca417c11:
    lexi.say "А?"

# ch/lexi/date.rpy:801
translate russian lexi_halloween_arrival_3a017b38:
    lexi.say "Хороший — и всё?"

# ch/lexi/date.rpy:802
translate russian lexi_halloween_arrival_58b5f4dc:
    lexi.say "Я думала, ты помешан на играх?!"

# ch/lexi/date.rpy:803
translate russian lexi_halloween_arrival_49ec00b1:
    mike.say "Т... так и есть, Лекси."

# ch/lexi/date.rpy:804
translate russian lexi_halloween_arrival_e3b00f80:
    mike.say "Просто... эта игра уже старовата!"

# ch/lexi/date.rpy:807
translate russian lexi_halloween_arrival_c36e93eb:
    "Глаза Лекси расширяются, а рот открывается."

# ch/lexi/date.rpy:808
translate russian lexi_halloween_arrival_1eb1ce87:
    "Затем она упирает сжатые кулаки в бока."

# ch/lexi/date.rpy:809
translate russian lexi_halloween_arrival_bc8ed80c:
    lexi.say "Вот как?"

# ch/lexi/date.rpy:810
translate russian lexi_halloween_arrival_3b3ffc12:
    lexi.say "А знаешь, что никогда не устаревает, [lssb_lexi.hero_name()]?"

# ch/lexi/date.rpy:811
translate russian lexi_halloween_arrival_0b9d5c40:
    lexi.say "Сиськи и задница, вот что!"

# ch/lexi/date.rpy:812
translate russian lexi_halloween_arrival_d64a9254:
    lexi.say "Посмотрим, что скажут о моём костюме другие парни на вечеринке!"

# ch/lexi/date.rpy:814
translate russian lexi_halloween_arrival_aed41207:
    "Лекси сердито проносится мимо меня."

# ch/lexi/date.rpy:815
translate russian lexi_halloween_arrival_861b43f4:
    "Я спешу за ней, без конца ругая себя."

# ch/lexi/date.rpy:817
translate russian lexi_halloween_arrival_26a0215a:
    "Открывая дверь, мне, пожалуй, следовало быть осторожнее."

# ch/lexi/date.rpy:818
translate russian lexi_halloween_arrival_6bb9ae1f:
    "Особенно после происшествий с мечом Джека и трезубцем Скотти."

# ch/lexi/date.rpy:819
translate russian lexi_halloween_arrival_22da52d2:
    "Но на этот раз меня заставляет отшатнуться самая настоящая бензопила."

# ch/lexi/date.rpy:821
translate russian lexi_halloween_arrival_5e430825:
    lexi.say "С ХЭЛЛОУИНОМ!"

# ch/lexi/date.rpy:822
translate russian lexi_halloween_arrival_de698b49:
    "Только теперь я замечаю, что бензопилу держит Лекси."

# ch/lexi/date.rpy:823
translate russian lexi_halloween_arrival_d14e222b:
    "Она одета в подобие безумной формы чирлидерши."

# ch/lexi/date.rpy:824
translate russian lexi_halloween_arrival_14ca6a52:
    "И тут я её узнаю."

# ch/lexi/date.rpy:825
translate russian lexi_halloween_arrival_bf4855b6:
    mike.say "Lollipop Chainsaw!"

# ch/lexi/date.rpy:826
translate russian lexi_halloween_arrival_7160908a:
    lexi.say "Угадал!"

# ch/lexi/date.rpy:828
translate russian lexi_halloween_arrival_8a09a27e_1:
    lexi.say "Ну, [lssb_lexi.hero_name()], я жду."

