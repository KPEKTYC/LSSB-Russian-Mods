# ch/lexi/base.rpy:50
translate russian lexi_bye_3e54568b:
    lexi.say "Пожалуй, мне пора спать."

# ch/lexi/base.rpy:52
translate russian lexi_bye_6fca63d0:
    lexi.say "Пойду в ванную. Не вздумай подглядывать!"

# ch/lexi/base.rpy:54
translate russian lexi_bye_264104ea:
    lexi.say "У меня сейчас занятия, так что пора идти."

# ch/lexi/base.rpy:56
translate russian lexi_bye_f6512812:
    lexi.say "Я такая голодная..."

# ch/lexi/base.rpy:58
translate russian lexi_bye_98cf5ba2:
    lexi.say "Не знаешь, что сейчас по телеку?"

# ch/lexi/base.rpy:60
translate russian lexi_bye_7a854290:
    lexi.say "Пойду выпью в пабе. Увидимся."

# ch/lexi/base.rpy:62
translate russian lexi_bye_9c12ca51:
    lexi.say "Сегодня солнечно. Думаю, пойду позагораю."

# ch/lexi/base.rpy:64
translate russian lexi_bye_7818931a:
    lexi.say "Хочется пройтись по магазинам."

# ch/lexi/base.rpy:66
translate russian lexi_bye_154c12f5:
    lexi.say "Пойду почитаю. Начала очень классную книгу."

# ch/lexi/base.rpy:68
translate russian lexi_bye_a2b87a8f:
    lexi.say "Я в клуб. Хочется потусить."

# ch/lexi/base.rpy:70
translate russian lexi_bye_8c8076f9:
    lexi.say "Надо бы немного попотеть. Увидимся позже."

# ch/lexi/base.rpy:72
translate russian lexi_bye_316ab2ed:
    lexi.say "Пойду оденусь."

# ch/lexi/base.rpy:78
translate russian lexi_cheated_a8a8226d:
    "Я замечаю, как Лекси с завистью и похотью в глазах смотрит на то, как я [lssb_lexi.action_text(action)] другую."

# ch/lexi/base.rpy:90
translate russian lexi_greet_f0c2c55a:
    lexi.say "Привет, [lssb_lexi.hero_name()]."

# ch/lexi/base.rpy:92
translate russian lexi_greet_f18a2500:
    lexi.say "Привет, [lssb_lexi.hero_name()]."

# ch/lexi/base.rpy:94
translate russian lexi_greet_9ff95a46:
    lexi.say "Рада тебя видеть, [lssb_lexi.hero_name()]."

# ch/lexi/base.rpy:97
translate russian lexi_greet_8712f34c:
    lexi.say "Доброе утро, [lssb_lexi.hero_name()]."

# ch/lexi/base.rpy:99
translate russian lexi_greet_29120e01:
    lexi.say "Добрый день, [lssb_lexi.hero_name()]."

# ch/lexi/base.rpy:101
translate russian lexi_greet_693a49af:
    lexi.say "Добрый вечер, [lssb_lexi.hero_name()]."

# ch/lexi/base.rpy:105
translate russian lexi_greet_b05b6776:
    lexi.say "Эй, [lssb_lexi.hero_name()], не хочешь отхватить кусочек?"

# ch/lexi/base.rpy:106
translate russian lexi_greet_e82fff2e:
    "Лекси звонко шлёпает себя по ягодице."

# ch/lexi/base.rpy:108
translate russian lexi_greet_d762374f:
    lexi.say "Какой кусочек, [lssb_lexi.hero_name()]?"

# ch/lexi/base.rpy:109
translate russian lexi_greet_e84ffc6f:
    mike.say "Что?"

# ch/lexi/base.rpy:110
translate russian lexi_greet_187e91dc:
    lexi.say "Какой кусочек тебе больше нравится, балда! Попка, сиськи или киска?"

# ch/lexi/base.rpy:117
translate russian lexi_greet_dialogues_male_ff5ba3fb:
    mike.say "Привет, Лекси."

# ch/lexi/base.rpy:119
translate russian lexi_greet_dialogues_male_6810e1f5:
    mike.say "Привет."

# ch/lexi/base.rpy:122
translate russian lexi_greet_dialogues_male_4d8af6d4:
    mike.say "Привет, Лекси."

# ch/lexi/base.rpy:124
translate russian lexi_greet_dialogues_male_2ee749ae:
    mike.say "Доброе утро, Лекси."

# ch/lexi/base.rpy:126
translate russian lexi_greet_dialogues_male_53a0b635:
    mike.say "Добрый день, Лекси."

# ch/lexi/base.rpy:128
translate russian lexi_greet_dialogues_male_8391e4e9:
    mike.say "Добрый вечер, Лекси."

# ch/lexi/base.rpy:140
translate russian lexi_kiss_male_5fe931db:
    "Мне и раньше случалось ошибиться, потянувшись поцеловать девушку, и получить отказ."

# ch/lexi/base.rpy:141
translate russian lexi_kiss_male_c01344c7:
    "Но обычно это сопровождалось неодобрительным взглядом, удивлённым вскриком или, в крайнем случае, пощёчиной."

# ch/lexi/base.rpy:142
translate russian lexi_kiss_male_c159a268:
    "Однако Лекси отстраняется совсем иначе."

# ch/lexi/base.rpy:143
translate russian lexi_kiss_male_b20e5ca5:
    "Вместо этого она смотрит на меня с насмешливой улыбкой, словно мои неуклюжие попытки её забавляют."

# ch/lexi/base.rpy:144
translate russian lexi_kiss_male_c030fde0:
    "Она качает головой и грозит мне пальцем, журя за попытку сблизиться."

# ch/lexi/base.rpy:145
translate russian lexi_kiss_male_87906c76:
    "Всё это наводит меня на мысль, что я просто выбрал неудачный момент, а сам поцелуй ей не противен."

# ch/lexi/base.rpy:152
translate russian lexi_kiss_male_42ed7563:
    "С Лекси ничто не напоминает привычные сцены романтики и соблазнения. Она просто не такая девушка."

# ch/lexi/base.rpy:153
translate russian lexi_kiss_male_f2cd53bd:
    "Поэтому меня совсем не удивляет, что наш первый поцелуй случается посреди неловкой возни, а не в порыве поэтического вдохновения."

# ch/lexi/base.rpy:154
translate russian lexi_kiss_male_32dbc6b1:
    "Руки оказываются где попало, тела трутся друг о друга, и всё это какой-то сплошной сумбур."

# ch/lexi/base.rpy:155
translate russian lexi_kiss_male_96865036:
    "Среди этой суматохи я чувствую, как мои губы касаются губ Лекси, и просто решаю действовать."

# ch/lexi/base.rpy:156
translate russian lexi_kiss_male_5204f63b:
    "Она отвечает почти мгновенно, упираясь языком в мои губы, словно отчаянно просит впустить её."

# ch/lexi/base.rpy:157
translate russian lexi_kiss_male_f792c498:
    "Как я и говорил, романтики здесь нет, зато страсти хоть отбавляй."

# ch/lexi/base.rpy:158
translate russian lexi_kiss_male_c075d785:
    "А похоти, возможно, ещё больше..."

# ch/lexi/base.rpy:166
translate russian lexi_kiss_male_e32298b5:
    "Лекси никогда не отличалась застенчивостью и любит превращать каждый наш поцелуй в представление, особенно на публике."

# ch/lexi/base.rpy:167
translate russian lexi_kiss_male_a1b56b2e:
    "Она мило улыбается, продолжая сосать леденец, а затем многозначительно вытаскивает его изо рта."

# ch/lexi/base.rpy:168
translate russian lexi_kiss_male_8933e250:
    "И её поцелуй всегда отдаёт тем леденцом, который она только что сосала."

# ch/lexi/base.rpy:169
translate russian lexi_kiss_male_d321651c:
    "Иногда мне кажется, что чужие взгляды ей нравятся больше, чем сам поцелуй."

# ch/lexi/base.rpy:170
translate russian lexi_kiss_male_2f05a3cf:
    "Но я стараюсь не слишком об этом задумываться."

# ch/lexi/base.rpy:171
translate russian lexi_kiss_male_15bbe5a1:
    "И каждый раз пытаюсь угадать вкус, оставшийся на её губах."

# ch/lexi/base.rpy:178
translate russian lexi_propose_male_f1ebd117:
    "Сама мысль о том, чтобы предложить девушке выйти за меня, довольно пугающая."

# ch/lexi/base.rpy:180
translate russian lexi_propose_male_465ab492:
    "Но если добавить к этому то, что эта девушка — Лекси..."

# ch/lexi/base.rpy:181
translate russian lexi_propose_male_efc28945:
    "Тогда всё выходит на совершенно иной уровень и становится почти страшно."

# ch/lexi/base.rpy:182
translate russian lexi_propose_male_2db5d872:
    "Не поймите неправильно: я не хочу сказать, что Лекси не такая, как другие девушки."

# ch/lexi/base.rpy:183
translate russian lexi_propose_male_ea8ce954:
    "И такая, и не такая, если вы понимаете, о чём я."

# ch/lexi/base.rpy:184
translate russian lexi_propose_male_4562d06d:
    "Уф..."

# ch/lexi/base.rpy:185
translate russian lexi_propose_male_c3241cc2:
    "Я ведь несу какую-то бессмыслицу?"

# ch/lexi/base.rpy:186
translate russian lexi_propose_male_ed3c5ec9:
    "Ладно, попробую ещё раз..."

# ch/lexi/base.rpy:187
translate russian lexi_propose_male_8ecef806:
    "Прошлое Лекси можно назвать весьма неоднозначным, да и познакомились мы при непростых обстоятельствах."

# ch/lexi/base.rpy:188
translate russian lexi_propose_male_0485b01e:
    "Тогда она участвовала во множестве сомнительных дел и водилась с ещё более сомнительными типами."

# ch/lexi/base.rpy:189
translate russian lexi_propose_male_aada6e34:
    "Но вместе мы со многим справились, и мне кажется, она начинает оставлять это позади."

# ch/lexi/base.rpy:190
translate russian lexi_propose_male_9e03355f:
    "Да, она живёт в трейлерном парке и выросла в неблагополучном районе."

# ch/lexi/base.rpy:191
translate russian lexi_propose_male_4cccb444:
    "Но это не меняет того, что она весёлая, лёгкая на подъём и с ней никогда не скучно."

# ch/lexi/base.rpy:192
translate russian lexi_propose_male_37157ac5:
    "Всё пережитое научило Лекси жить на полную."

# ch/lexi/base.rpy:193
translate russian lexi_propose_male_cd73a9c1:
    "Она будто хватается за любую возможность и проживает каждый день как последний."

# ch/lexi/base.rpy:194
translate russian lexi_propose_male_8cca26b6:
    "Чёрт..."

# ch/lexi/base.rpy:195
translate russian lexi_propose_male_0ccd912b:
    "Теперь я описал её как какую-то безумную любительницу адреналина!"

# ch/lexi/base.rpy:196
translate russian lexi_propose_male_1486f8fc:
    "Короче, я влюблён в Лекси."

# ch/lexi/base.rpy:197
translate russian lexi_propose_male_6b1ebbb4:
    "Вот. Я это сказал."

# ch/lexi/base.rpy:198
translate russian lexi_propose_male_c9b1b919:
    "Но я боюсь, как она отреагирует, когда я достану кольцо и сделаю предложение."

# ch/lexi/base.rpy:199
translate russian lexi_propose_male_c7bdce7b:
    "Увидит ли она во мне прекрасного принца?"

# ch/lexi/base.rpy:200
translate russian lexi_propose_male_20b6a11e:
    "Того, кто приехал, чтобы увезти её на своём коне?"

# ch/lexi/base.rpy:201
translate russian lexi_propose_male_baa83fc0:
    "Или она уже разучилась ждать счастливой развязки?"

# ch/lexi/base.rpy:202
translate russian lexi_propose_male_8eaac4b5:
    "Увидит во мне лишь ещё одного парня, который хочет лишить её свободы?"

# ch/lexi/base.rpy:203
translate russian lexi_propose_male_68d60df1:
    "Что ж, узнать можно только одним способом."

# ch/lexi/base.rpy:204
translate russian lexi_propose_male_57f0a6f9:
    "Я достаю кольцо из кармана и опускаюсь на одно колено."

# ch/lexi/base.rpy:205
translate russian lexi_propose_male_bf4ba5cd:
    mike.say "Эм, Лекси..."

# ch/lexi/base.rpy:206
translate russian lexi_propose_male_6fc38660:
    lexi.say "А?.."

# ch/lexi/base.rpy:207
translate russian lexi_propose_male_2423c214:
    "Лекси смотрит на меня, явно недоумевая, почему я стою перед ней на колене."

# ch/lexi/base.rpy:209
translate russian lexi_propose_male_86eefa2e:
    "Она надувает большой пузырь из жвачки. Он лопается с хлопком, который в тишине звучит особенно громко."

# ch/lexi/base.rpy:210
translate russian lexi_propose_male_723524d9:
    "Затем она втягивает жвачку обратно в рот с ещё одним совсем не женственным звуком."

# ch/lexi/base.rpy:212
translate russian lexi_propose_male_d626722e:
    lexi.say "Ты чего там делаешь?"

# ch/lexi/base.rpy:213
translate russian lexi_propose_male_28eea78e:
    mike.say "Лекси..."

# ch/lexi/base.rpy:214
translate russian lexi_propose_male_8069cfae:
    mike.say "Ты выйдешь за меня?"

# ch/lexi/base.rpy:215
translate russian lexi_propose_male_9702ebf7:
    "Я вижу, как в следующие несколько секунд до неё постепенно доходит."

# ch/lexi/base.rpy:217
translate russian lexi_propose_male_18484fce:
    "Глаза Лекси расширяются, а рот открывается от явного удивления."

# ch/lexi/base.rpy:218
translate russian lexi_propose_male_5f1ecc9f:
    "Я понятия не имею, что сейчас происходит у неё в голове."

# ch/lexi/base.rpy:219
translate russian lexi_propose_male_7a112cd4:
    "Так что мне остаётся лишь ждать ответа..."

# ch/lexi/base.rpy:220
translate russian lexi_propose_male_c89888b5:
    lexi.say "Т... ты же шутишь... правда?"

# ch/lexi/base.rpy:221
translate russian lexi_propose_male_4923e868:
    lexi.say "Ты ведь не хочешь жениться на мне по-настоящему!"

# ch/lexi/base.rpy:222
translate russian lexi_propose_male_20da75e1:
    "Теперь уже я широко раскрываю глаза и теряю дар речи."

# ch/lexi/base.rpy:223
translate russian lexi_propose_male_0139a7b3:
    "Сначала я могу лишь беспомощно пожать плечами, чувствуя себя полным идиотом."

# ch/lexi/base.rpy:224
translate russian lexi_propose_male_03f8f6da:
    mike.say "Н... ну да, Лекси..."

# ch/lexi/base.rpy:225
translate russian lexi_propose_male_9b09f2ae:
    mike.say "Я... я... вообще-то хочу!"

# ch/lexi/base.rpy:227
translate russian lexi_propose_male_683d0e04:
    "Лекси снова замолкает."

# ch/lexi/base.rpy:228
translate russian lexi_propose_male_a85e7a49:
    "Но теперь кажется, будто она стоит на пороге чего-то."

# ch/lexi/base.rpy:229
translate russian lexi_propose_male_98203c42:
    "Могу лишь предположить, что до неё наконец доходит: я серьёзно."

# ch/lexi/base.rpy:231
translate russian lexi_propose_male_e87d4a02:
    "И тут она неожиданно разражается звонким смехом."

# ch/lexi/base.rpy:233
translate russian lexi_propose_male_9f74b7fd:
    lexi.say "Ох, чёрт..."

# ch/lexi/base.rpy:234
translate russian lexi_propose_male_4e6976de:
    lexi.say "Хорошая шутка, [lssb_lexi.hero_name()]!"

# ch/lexi/base.rpy:235
translate russian lexi_propose_male_599a58ef:
    lexi.say "Я даже на секунду поверила!"

# ch/lexi/base.rpy:236
translate russian lexi_propose_male_a40f566d:
    "Я нервно смеюсь, не зная, что ещё делать."

# ch/lexi/base.rpy:237
translate russian lexi_propose_male_cd8dd98d:
    mike.say "А, да, Лекси..."

# ch/lexi/base.rpy:238
translate russian lexi_propose_male_ab187fde:
    mike.say "Я тот ещё шутник!"

# ch/lexi/base.rpy:240
translate russian lexi_propose_male_d949d004:
    lexi.say "В смысле, как МЫ вообще можем пожениться?"

# ch/lexi/base.rpy:241
translate russian lexi_propose_male_42fcc8a6:
    lexi.say "И что мы будем делать?"

# ch/lexi/base.rpy:242
translate russian lexi_propose_male_7e397836:
    lexi.say "Купим дом за городом?"

# ch/lexi/base.rpy:243
translate russian lexi_propose_male_66aa114c:
    lexi.say "Будем жить долго и счастливо?"

# ch/lexi/base.rpy:244
translate russian lexi_propose_male_d03f2faf:
    lexi.say "Ха... ну и умора!"

# ch/lexi/base.rpy:245
translate russian lexi_propose_male_fe9b3b16:
    "Я продолжаю слабо посмеиваться, пряча кольцо обратно в карман."

# ch/lexi/base.rpy:246
translate russian lexi_propose_male_5e1032f3:
    "Но смех звучит глухо и пусто."

# ch/lexi/base.rpy:247
translate russian lexi_propose_male_a8f73606:
    "Так же пусто, как у меня сейчас на душе."

# ch/lexi/base.rpy:248
translate russian lexi_propose_male_3c45db1f:
    "И всё же я заставляю себя улыбнуться."

# ch/lexi/base.rpy:249
translate russian lexi_propose_male_d333de4c:
    "В надежде, что со временем это чувство пройдёт."

# ch/lexi/base.rpy:253
translate russian lexi_propose_male_be0ab4c5:
    "Пока Лекси говорит, я замечаю в уголках её глаз первые слёзы."

# ch/lexi/base.rpy:255
translate russian lexi_propose_male_e7b69d66:
    lexi.say "О, [lssb_lexi.hero_name()]..."

# ch/lexi/base.rpy:256
translate russian lexi_propose_male_058c3168:
    lexi.say "Ты ведь не всерьёз?"

# ch/lexi/base.rpy:257
translate russian lexi_propose_male_8fb73da4:
    mike.say "Я..."

# ch/lexi/base.rpy:258
translate russian lexi_propose_male_0bc3c0e3:
    mike.say "Конечно всерьёз, Лекси!"

# ch/lexi/base.rpy:259
translate russian lexi_propose_male_0d20b8c5:
    mike.say "Я люблю тебя и хочу на тебе жениться!"

# ch/lexi/base.rpy:260
translate russian lexi_propose_male_2796ad12:
    "Лекси снова и снова качает головой."

# ch/lexi/base.rpy:261
translate russian lexi_propose_male_0b7e3d65:
    "Будто не может понять, что с ней происходит."

# ch/lexi/base.rpy:262
translate russian lexi_propose_male_e62d31d3:
    lexi.say "Но... но..."

# ch/lexi/base.rpy:263
translate russian lexi_propose_male_6b574c34:
    lexi.say "Я же порченый товар, [lssb_lexi.hero_name()]."

# ch/lexi/base.rpy:264
translate russian lexi_propose_male_4a230022:
    lexi.say "Зачем тебе такое?!"

# ch/lexi/base.rpy:265
translate russian lexi_propose_male_d9ab1c04:
    "На мгновение я теряю дар речи."

# ch/lexi/base.rpy:266
