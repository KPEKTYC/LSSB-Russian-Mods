# ch/lexi/date.rpy:885
translate russian lexi_halloween_party_2c3a1df9:
    lexi.say "Эй, [lssb_lexi.hero_name()]!"

# ch/lexi/date.rpy:886
translate russian lexi_halloween_party_74c7df5c:
    lexi.say "Хочешь ещё такого?!"

# ch/lexi/date.rpy:888
translate russian lexi_halloween_party_b4940dfe:
    "Я оборачиваюсь как раз вовремя, чтобы подхватить налетевшую на меня Лекси."

# ch/lexi/date.rpy:889
translate russian lexi_halloween_party_c262e430:
    "Она размахивает пустым стаканчиком и указывает на чашу с пуншем."

# ch/lexi/date.rpy:890
translate russian lexi_halloween_party_ec739a26:
    "Сколько она уже выпила?"

# ch/lexi/date.rpy:891
translate russian lexi_halloween_party_f3acc1e5:
    "Такое чувство, что она вот-вот рухнет лицом на пол!"

# ch/lexi/date.rpy:892
translate russian lexi_halloween_party_fea7260e:
    mike.say "Ты в порядке, Лекси?"

# ch/lexi/date.rpy:893
translate russian lexi_halloween_party_e9d6064d:
    mike.say "Что-то тебя шатает!"

# ch/lexi/date.rpy:894
translate russian lexi_halloween_party_093e9160:
    "Лекси с видимым усилием выпрямляется."

# ch/lexi/date.rpy:895
translate russian lexi_halloween_party_a8322f14:
    "Но всё равно продолжает покачиваться."

# ch/lexi/date.rpy:896
translate russian lexi_halloween_party_f8b0cd6b:
    lexi.say "Я в порядке..."

# ch/lexi/date.rpy:897
translate russian lexi_halloween_party_9745dfd4:
    lexi.say "Даже лучше!"

# ch/lexi/date.rpy:900
translate russian lexi_halloween_party_b7e39d6b:
    "Да о чём я, чёрт возьми, волнуюсь?"

# ch/lexi/date.rpy:901
translate russian lexi_halloween_party_d74b48db:
    "Это же вечеринка."

# ch/lexi/date.rpy:902
translate russian lexi_halloween_party_befe7c40:
    "Пусть Лекси оторвётся, если хочет."

# ch/lexi/date.rpy:903
translate russian lexi_halloween_party_44f6472b:
    mike.say "Держи, Лекси."

# ch/lexi/date.rpy:904
translate russian lexi_halloween_party_937ab905:
    mike.say "Я налью тебе ещё."

# ch/lexi/date.rpy:907
translate russian lexi_halloween_party_8bafd894:
    "Лекси сияет, пока я наливаю ей пунш."

# ch/lexi/date.rpy:908
translate russian lexi_halloween_party_6ebdb958:
    "А затем сразу выпивает больше половины."

# ch/lexi/date.rpy:909
translate russian lexi_halloween_party_11671a2b:
    lexi.say "Ага..."

# ch/lexi/date.rpy:910
translate russian lexi_halloween_party_2054c048:
    lexi.say "Вот это я понимаю!"

# ch/lexi/date.rpy:911
translate russian lexi_halloween_party_56a9bb48:
    "Она покачивается и снова заваливается на меня."

# ch/lexi/date.rpy:912
translate russian lexi_halloween_party_6d84d5ec:
    "Фыркает и хихикает, пока мне приходится её поддерживать."

# ch/lexi/date.rpy:914
translate russian lexi_halloween_party_230346d9:
    "Господи, она же едва на ногах стоит!"

# ch/lexi/date.rpy:915
translate russian lexi_halloween_party_cb1d64e0:
    "Ещё немного, и Лекси отключится."

# ch/lexi/date.rpy:916
translate russian lexi_halloween_party_73d7034b:
    "Я забираю у неё пустой стакан."

# ch/lexi/date.rpy:919
translate russian lexi_halloween_party_0eccd4c3:
    lexi.say "Эй!"

# ch/lexi/date.rpy:920
translate russian lexi_halloween_party_fbfa34ba:
    lexi.say "Какого чёрта?!"

# ch/lexi/date.rpy:921
translate russian lexi_halloween_party_cd4f3abe:
    mike.say "Думаю, тебе хватит, Лекси."

# ch/lexi/date.rpy:922
translate russian lexi_halloween_party_517cd674:
    mike.say "Хотя бы пока немного не протрезвеешь."

# ch/lexi/date.rpy:924
translate russian lexi_halloween_party_b447d5bc:
    "Лекси возмущается и пытается отнять стакан."

# ch/lexi/date.rpy:925
translate russian lexi_halloween_party_62bc2ee3:
    "Но лишь теряет равновесие."

# ch/lexi/date.rpy:926
translate russian lexi_halloween_party_56a9bb48_1:
    "Она покачивается и снова заваливается на меня."

# ch/lexi/date.rpy:927
translate russian lexi_halloween_party_6d84d5ec_1:
    "Фыркает и хихикает, пока мне приходится её поддерживать."

# ch/lexi/date.rpy:937
translate russian lexi_halloween_dance_5458c32d:
    "Стоит заиграть музыке, как Лекси начинает притоптывать."

# ch/lexi/date.rpy:938
translate russian lexi_halloween_dance_eee08443:
    "Мы вроде бы разговариваем, но мыслями она где-то далеко."

# ch/lexi/date.rpy:939
translate russian lexi_halloween_dance_b92d00d1:
    "Я вижу, что ей не терпится выйти на наш импровизированный танцпол."

# ch/lexi/date.rpy:940
translate russian lexi_halloween_dance_f1d8a63c:
    mike.say "Эм..."

# ch/lexi/date.rpy:941
translate russian lexi_halloween_dance_0cb25e23:
    mike.say "Я тебя утомил, Лекси?"

# ch/lexi/date.rpy:942
translate russian lexi_halloween_dance_1d557ad3:
    lexi.say "А... что?"

# ch/lexi/date.rpy:943
translate russian lexi_halloween_dance_510b2946:
    lexi.say "Ну... да, пожалуй!"

# ch/lexi/date.rpy:944
translate russian lexi_halloween_dance_048e6da2:
    lexi.say "К чёрту болтовню, [lssb_lexi.hero_name()]."

# ch/lexi/date.rpy:946
translate russian lexi_halloween_dance_8496eb13:
    lexi.say "Я хочу танцевать!"

# ch/lexi/date.rpy:947
translate russian lexi_halloween_dance_92e24406:
    "Что ж, по крайней мере, она честна."

# ch/lexi/date.rpy:950
translate russian lexi_halloween_dance_4c4b6a70:
    mike.say "Ты права, Лекси."

# ch/lexi/date.rpy:951
translate russian lexi_halloween_dance_e16d3bda:
    mike.say "Это же вечеринка."

# ch/lexi/date.rpy:953
translate russian lexi_halloween_dance_9796f332:
    "От моего ответа лицо Лекси озаряется улыбкой."

# ch/lexi/date.rpy:954
translate russian lexi_halloween_dance_a5ca01c0:
    "Но ответить она не успевает."

# ch/lexi/date.rpy:956
translate russian lexi_halloween_dance_18363027:
    "Потому что я уже беру её за руку."

# ch/lexi/date.rpy:957
translate russian lexi_halloween_dance_a3f57883:
    "И веду на танцпол."

# ch/lexi/date.rpy:960
translate russian lexi_halloween_dance_56783c50:
    lexi.say "О да."

# ch/lexi/date.rpy:961
translate russian lexi_halloween_dance_2054c048:
    lexi.say "Вот это я понимаю!"

# ch/lexi/date.rpy:962
translate russian lexi_halloween_dance_a0a6310f:
    "Конечно, это будет не медленный танец."

# ch/lexi/date.rpy:963
translate russian lexi_halloween_dance_7db84c22:
    "Лекси даёт это понять с самого начала."

# ch/lexi/date.rpy:964
translate russian lexi_halloween_dance_3375ad6e:
    "Кажется, нет ни секунды, когда она не трётся об меня!"

# ch/lexi/date.rpy:965
translate russian lexi_halloween_dance_18a54e0e:
    "Лекси непрерывно извивается и прижимается ко мне."

# ch/lexi/date.rpy:966
translate russian lexi_halloween_dance_9f20f5f7:
    "Я едва сдерживаюсь, чтобы не покраснеть."

# ch/lexi/date.rpy:967
translate russian lexi_halloween_dance_fd9440a8:
    "Но это не значит, что я хочу её остановить."

# ch/lexi/date.rpy:968
translate russian lexi_halloween_dance_a703b0ce:
    "Я почти физически чувствую взгляды остальных гостей."

# ch/lexi/date.rpy:969
translate russian lexi_halloween_dance_6828f17d:
    "Ведь Лекси танцует как стриптизёрша в клубе для джентльменов."

# ch/lexi/date.rpy:970
translate russian lexi_halloween_dance_20e0939c:
    "К концу песни я вымотан и тяжело дышу."

# ch/lexi/date.rpy:971
translate russian lexi_halloween_dance_dda841cd:
    "А член в штанах твёрдый как камень."

# ch/lexi/date.rpy:973
translate russian lexi_halloween_dance_dd099d0c:
    mike.say "Не сейчас, Лекси."

# ch/lexi/date.rpy:974
translate russian lexi_halloween_dance_e9c6edf0:
    mike.say "Потом ещё будет время."

# ch/lexi/date.rpy:976
translate russian lexi_halloween_dance_13839d8c:
    "Мой ответ сразу разочаровывает Лекси."

# ch/lexi/date.rpy:977
translate russian lexi_halloween_dance_6b1afc78:
    lexi.say "Ну давай!"

# ch/lexi/date.rpy:978
translate russian lexi_halloween_dance_9cebf533:
    lexi.say "Не будь занудным мудаком!"

# ch/lexi/date.rpy:979
translate russian lexi_halloween_dance_608e686c:
    mike.say "Я уже сказал нет, Лекси!"

# ch/lexi/date.rpy:982
translate russian lexi_halloween_dance_a31d76d3:
    "Лекси пожимает плечами и качает головой."

# ch/lexi/date.rpy:983
translate russian lexi_halloween_dance_6cb46ba7:
    lexi.say "Ладно, как хочешь."

# ch/lexi/date.rpy:984
translate russian lexi_halloween_dance_bac3b2da:
    lexi.say "Если надо, буду танцевать одна!"

# ch/lexi/date.rpy:986
translate russian lexi_halloween_dance_6de2c50e:
    "Я не успеваю возразить, как Лекси уходит."

# ch/lexi/date.rpy:987
translate russian lexi_halloween_dance_60c823ab:
    "Я смотрю, как она выходит на танцпол одна."

# ch/lexi/date.rpy:988
translate russian lexi_halloween_dance_40e2deb2:
    "Но ненадолго."

# ch/lexi/date.rpy:989
translate russian lexi_halloween_dance_a180fad1:
    "Мне остаётся наблюдать, как к ней присоединяются Джек и Скотти."

# ch/lexi/date.rpy:990
translate russian lexi_halloween_dance_d4b9f5fc:
    "Их обоих словно притягивает к ней."

# ch/lexi/date.rpy:991
translate russian lexi_halloween_dance_e3023b28:
    "А Лекси без колебаний начинает красоваться перед ними."

# ch/lexi/date.rpy:992
translate russian lexi_halloween_dance_ffec7ef6:
    "Она наверняка понимает, что я тоже всё это вижу."

# ch/lexi/date.rpy:993
translate russian lexi_halloween_dance_532ce725:
    "Но я могу лишь стоять как беспомощный придурок."

# ch/lexi/date.rpy:1000
translate russian lexi_halloween_sex_665d0660:
    "Уже поздно, и вечеринка, похоже, подходит к концу."

# ch/lexi/date.rpy:1001
translate russian lexi_halloween_sex_8d316b3b:
    "Большинство гостей устали и изрядно выпили."

# ch/lexi/date.rpy:1002
translate russian lexi_halloween_sex_c7384351:
    "Теперь им хочется скорее расслабиться, чем буйствовать."

# ch/lexi/date.rpy:1003
translate russian lexi_halloween_sex_e97bd89e:
    "Ну, всем, кроме одной."

# ch/lexi/date.rpy:1005
translate russian lexi_halloween_sex_eba01d29:
    "Лекси пока и не думает выдыхаться."

# ch/lexi/date.rpy:1006
translate russian lexi_halloween_sex_282c6f88:
    "Наоборот, она словно настроена немного размяться."

# ch/lexi/date.rpy:1008
translate russian lexi_halloween_sex_3c22ce71:
    lexi.say "Давай, [lssb_lexi.hero_name()]."

# ch/lexi/date.rpy:1009
translate russian lexi_halloween_sex_68236ada:
    lexi.say "Шевели задницей!"

# ch/lexi/date.rpy:1011
translate russian lexi_halloween_sex_c58887fa:
    mike.say "Л... ладно, Лекси..."

# ch/lexi/date.rpy:1012
translate russian lexi_halloween_sex_82dca905:
    mike.say "Я иду!"

# ch/lexi/date.rpy:1013
translate russian lexi_halloween_sex_38a2ef43:
    "Лекси крепко держит меня за запястье и тащит за собой."

# ch/lexi/date.rpy:1017
translate russian lexi_halloween_sex_c3bd74a7:
    "Она направляется в ванную наверху."

# ch/lexi/date.rpy:1018
translate russian lexi_halloween_sex_04ea5181:
    "Которая, к счастью, свободна."

# ch/lexi/date.rpy:1019
translate russian lexi_halloween_sex_22cadc31:
    "Вообще, страшно подумать, что было бы, окажись там кто-нибудь!"

# ch/lexi/date.rpy:1020
translate russian lexi_halloween_sex_1a07a1b2:
    "Проявив немного пугающую силу, Лекси практически зашвыривает меня внутрь."

# ch/lexi/date.rpy:1021
translate russian lexi_halloween_sex_f6ad0c27:
    mike.say "Эй, Лекси!"

# ch/lexi/date.rpy:1022
translate russian lexi_halloween_sex_d6f0e0ca:
    mike.say "Тебе настолько приспичило?!"

# ch/lexi/date.rpy:1025
translate russian lexi_halloween_sex_7a4b1dbf:
    "Лекси со смехом захлопывает за нами дверь."

# ch/lexi/date.rpy:1026
translate russian lexi_halloween_sex_4c2742b1:
    "Затем почти крутится на месте, разворачиваясь ко мне."

# ch/lexi/date.rpy:1027
translate russian lexi_halloween_sex_bdea485d:
    "Я невольно сглатываю и немного отступаю."

# ch/lexi/date.rpy:1029
translate russian lexi_halloween_sex_6c6a254d:
    "Всё дело в её позе и выражении лица."

# ch/lexi/date.rpy:1030
translate russian lexi_halloween_sex_94cb7cd8:
    "Мне сразу вспоминается что-то из документального фильма о дикой природе."

# ch/lexi/date.rpy:1031
translate russian lexi_halloween_sex_21513b4f:
    "Так хищник смотрит на свою добычу."

# ch/lexi/date.rpy:1033
translate russian lexi_halloween_sex_039a8283:
    lexi.say "О, мне действительно кое-что нужно."

# ch/lexi/date.rpy:1034
translate russian lexi_halloween_sex_940eea04:
    lexi.say "Только не это."

# ch/lexi/date.rpy:1036
translate russian lexi_halloween_sex_30e74fc5:
    mike.say "Эм..."

# ch/lexi/date.rpy:1037
translate russian lexi_halloween_sex_55eddbad:
    mike.say "Тогда что, Лекси?"

# ch/lexi/date.rpy:1038
translate russian lexi_halloween_sex_fd9804b6:
    "Будто я сам не знаю!"

# ch/lexi/date.rpy:1040
translate russian lexi_halloween_sex_e40de43f:
    lexi.say "Твой член, [lssb_lexi.hero_name()]."

# ch/lexi/date.rpy:1041
translate russian lexi_halloween_sex_8a109998:
    lexi.say "Хочу его в себя!"

# ch/lexi/date.rpy:1043
translate russian lexi_halloween_sex_60d3ac6a:
    mike.say "Т... ты могла просто попросить, Лекси!"

# ch/lexi/date.rpy:1044
translate russian lexi_halloween_sex_a615b54d:
    mike.say "Необязательно было отводить меня в сторону."

# ch/lexi/date.rpy:1045
translate russian lexi_halloween_sex_1c8b4d67:
    mike.say "Пойдём ко мне в комнату."

# ch/lexi/date.rpy:1047
translate russian lexi_halloween_sex_a68b19fe:
    "Моя рука уже лежит на двери ванной, и я приоткрываю её на пару сантиметров."

# ch/lexi/date.rpy:1049
translate russian lexi_halloween_sex_63e5a65a:
    "Но Лекси ударяет по двери ладонью, снова захлопывая её."

# ch/lexi/date.rpy:1050
translate russian lexi_halloween_sex_fef0be3b:
    "Я вздрагиваю и недоумённо смотрю на неё широко раскрытыми глазами."

# ch/lexi/date.rpy:1052
translate russian lexi_halloween_sex_ce9e3dad:
    lexi.say "Ни за что!"

# ch/lexi/date.rpy:1053
translate russian lexi_halloween_sex_d54a5c3b:
    lexi.say "Я хочу СЕЙЧАС!"

# ch/lexi/date.rpy:1055
translate russian lexi_halloween_sex_7728e143:
    "Не дав мне сказать ни слова, Лекси прыгает на меня."

# ch/lexi/date.rpy:1056
translate russian lexi_halloween_sex_1ec03db0:
    "И это не метафора."

# ch/lexi/date.rpy:1057
translate russian lexi_halloween_sex_70a4240a:
    "Она буквально отрывается от пола и бросается мне на шею!"

# ch/lexi/date.rpy:1058
translate russian lexi_halloween_sex_61a44e67:
    "Я изо всех сил стараюсь удержаться на ногах."

# ch/lexi/date.rpy:1059
translate russian lexi_halloween_sex_c03d56db:
    "При этом разворачиваюсь и налетаю на дверь."

# ch/lexi/date.rpy:1060
translate russian lexi_halloween_sex_ca1a2a16:
    "Только не поймите неправильно: я не пытаюсь сбросить с себя Лекси!"

# ch/lexi/date.rpy:1061
translate russian lexi_halloween_sex_0ce2cb9c:
    "Я что, по-вашему, ненормальный?!"

# ch/lexi/date.rpy:1062
translate russian lexi_halloween_sex_dfb057c2:
    "Нет, я пытаюсь удержать её на весу и одновременно разобраться со своим костюмом!"

# ch/lexi/date.rpy:1063
translate russian lexi_halloween_sex_79c6c9e7:
    "Не представляю, как ей это удаётся."

# ch/lexi/date.rpy:1064
translate russian lexi_halloween_sex_280ae5fd:
    "Но через мгновение я уже чувствую руку Лекси на своём члене."

# ch/lexi/date.rpy:1066
translate russian lexi_halloween_sex_f24c773b:
    lexi.say "Ах!"

# ch/lexi/date.rpy:1067
translate russian lexi_halloween_sex_7ff01fa3:
    lexi.say "Вот он..."

# ch/lexi/date.rpy:1071
translate russian lexi_halloween_sex_55804c61:
    "И в следующий миг она уже направляет его в себя."

# ch/lexi/date.rpy:1072
translate russian lexi_halloween_sex_1f44e7f9:
    "Лекси весьма умело использует собственный вес и силу тяжести."

# ch/lexi/date.rpy:1076
translate russian lexi_halloween_sex_2b5f20c7:
    "Она стонет и вскрикивает, опускаясь на мой член."

# ch/lexi/date.rpy:1077
translate russian lexi_halloween_sex_96edab1c:
    lexi.say "Ох..."

# ch/lexi/date.rpy:1078
translate russian lexi_halloween_sex_b32f8161:
    lexi.say "М-м-м... да... да..."

# ch/lexi/date.rpy:1080
translate russian lexi_halloween_sex_91ea56a8:
    lexi.say "Вот так... вот чего я хочу!"

# ch/lexi/date.rpy:1081
translate russian lexi_halloween_sex_2dc2fbe5:
    "Рад это слышать, потому что я хочу того же!"

# ch/lexi/date.rpy:1082
translate russian lexi_halloween_sex_6959e6ad:
    "Внезапно от усталости не остаётся и следа."

# ch/lexi/date.rpy:1083
translate russian lexi_halloween_sex_1f5e4bee:
    "И мне совершенно плевать, что мы заняли ванную."

# ch/lexi/date.rpy:1084
translate russian lexi_halloween_sex_43b04692:
    "Всё, чего я хочу, — трахать Лекси так сильно, как только смогу."

# ch/lexi/date.rpy:1085
translate russian lexi_halloween_sex_74cdeb17:
    "И именно этим я занимаюсь."

# ch/lexi/date.rpy:1087
translate russian lexi_halloween_sex_a440a56e:
    "Я вколачиваюсь в неё со всей оставшейся энергией."

# ch/lexi/date.rpy:1088
translate russian lexi_halloween_sex_580c1a05:
    "Каждый толчок припечатывает её к двери, заставляя ту грохотать."

# ch/lexi/date.rpy:1089
translate russian lexi_halloween_sex_916322d9:
    "В ответ Лекси каждый раз кивает и требует ещё."

# ch/lexi/date.rpy:1090
translate russian lexi_halloween_sex_b95c7fa6:
    "От сильных толчков она, кажется, только больше возбуждается."

# ch/lexi/date.rpy:1093
translate russian lexi_halloween_sex_8b81bc69:
    lexi.say "Да... используй меня, [lssb_lexi.hero_name()], я вся твоя!"

# ch/lexi/date.rpy:1094
translate russian lexi_halloween_sex_42324807:
    lexi.say "Делай со мной что хочешь, мне плевать, кто услышит!"

# ch/lexi/date.rpy:1095
translate russian lexi_halloween_sex_f16ee275:
    "Вскоре снаружи доносятся приглушённые голоса."

# ch/lexi/date.rpy:1097
translate russian lexi_halloween_sex_2e5165d6:
    "Неудивительно: мы ведь так шумно трахаемся!"

# ch/lexi/date.rpy:1098
translate russian lexi_halloween_sex_a7b36964:
    "А затем кто-то начинает колотить кулаком в дверь."

# ch/lexi/date.rpy:1099
translate russian lexi_halloween_sex_e97b4e66:
    "В любой другой момент я бы сгорел со стыда."

# ch/lexi/date.rpy:1100
translate russian lexi_halloween_sex_75271bff:
    "Но сейчас я по самые яйца в Лекси."

# ch/lexi/date.rpy:1101
translate russian lexi_halloween_sex_672becfc:
    "И чёрта с два вытащу, пока не кончу!"

# ch/lexi/date.rpy:1102
translate russian lexi_halloween_sex_145ef47a:
    "Звуки за дверью только сильнее меня возбуждают."

# ch/lexi/date.rpy:1103
translate russian lexi_halloween_sex_6ff9a0f5:
    "Сквозь стоны удовольствия я слышу её смех."

# ch/lexi/date.rpy:1104
translate russian lexi_halloween_sex_b1d1aab7:
    "Ей это нравится, маленькой развратной сучке!"

# ch/lexi/date.rpy:1106
translate russian lexi_halloween_sex_6fca9850:
    "Именно эта мысль и доводит меня до предела."

# ch/lexi/date.rpy:1108
translate russian lexi_halloween_sex_858817cd:
    "Я кончаю в Лекси, и она вскрикивает, тоже испытывая оргазм."

# ch/lexi/date.rpy:1110
translate russian lexi_halloween_sex_1058cee2:
    "Когда я опускаю Лекси на пол, у меня дрожат ноги."

# ch/lexi/date.rpy:1114
translate russian lexi_halloween_sex_ce2fba88:
    "А вот она, кажется, в куда лучшей форме."

# ch/lexi/date.rpy:1115
translate russian lexi_halloween_sex_07e5f559:
    "Поэтому, едва мы приводим себя в более-менее приличный вид, я не успеваю помешать ей открыть дверь."

# ch/lexi/date.rpy:1121
translate russian lexi_halloween_sex_2c1da737:
    "За дверью оказывается Скотти, стоящий со скрещёнными ногами."

# ch/lexi/date.rpy:1122
translate russian lexi_halloween_sex_33b0f919:
    scottie.say "Нехорошо, ребята."

# ch/lexi/date.rpy:1123
translate russian lexi_halloween_sex_f1936de2:
    scottie.say "Совсем нехорошо."

# ch/lexi/date.rpy:1124
translate russian lexi_halloween_sex_b9da9011:
    scottie.say "Если я обоссусь в этом костюме, мне не вернут залог!"

# ch/lexi/date.rpy:1126
translate russian lexi_halloween_sex_1b56ad9a:
    lexi.say "В чём дело, рыбный мальчик?"

# ch/lexi/date.rpy:1127
translate russian lexi_halloween_sex_e37d4355:
    lexi.say "Разве Аквамен не должен быть мокрым?"

# ch/lexi/date.rpy:1135
translate russian lexi_date_home_weed_intro_5ad0918d:
    "Сегодняшний вечер у нас с Лекси уже отмечен в календаре как вечер свидания."

# ch/lexi/date.rpy:1136
translate russian lexi_date_home_weed_intro_2de858b3:
    "Но есть проблема, и дело вовсе не в том, что я не хочу её видеть."

# ch/lexi/date.rpy:1137
translate russian lexi_date_home_weed_intro_c17297db:
    "Просто к возвращению домой я совсем вымотался на работе."

# ch/lexi/date.rpy:1138
translate russian lexi_date_home_weed_intro_1fe0bae8:
    "Мы намеренно не строили точных планов, потому что оба не знали, чем хотим заняться."

# ch/lexi/date.rpy:1139
translate russian lexi_date_home_weed_intro_85356252:
    "Решили только встретиться у меня, а дальше разберёмся."

# ch/lexi/date.rpy:1140
translate russian lexi_date_home_weed_intro_2ed5f9a0:
    "Я надеялся, что весь выпитый кофе поможет."

# ch/lexi/date.rpy:1141
translate russian lexi_date_home_weed_intro_62d832b4:
    "Может, даже подскажет что-нибудь весёлое, чем мы сможем заняться вместе."

# ch/lexi/date.rpy:1143
translate russian lexi_date_home_weed_intro_f3f4444f:
    "Но к тому времени, как в дом влетает Лекси, я чувствую себя ещё более уставшим!"

# ch/lexi/date.rpy:1145
translate russian lexi_date_home_weed_intro_2c3a1df9:
    lexi.say "Привет, [lssb_lexi.hero_name()]!"

# ch/lexi/date.rpy:1146
translate russian lexi_date_home_weed_intro_9f1d5499:
    lexi.say "Надеюсь, ты готов сегодня как следует оторваться!"

# ch/lexi/date.rpy:1147
translate russian lexi_date_home_weed_intro_52f9ffd4:
    lexi.say "Потому что я вся на взводе и готова тусить!"

# ch/lexi/date.rpy:1148
translate russian lexi_date_home_weed_intro_f1d8a63c:
    mike.say "Эм..."

# ch/lexi/date.rpy:1149
translate russian lexi_date_home_weed_intro_ac0f39c5:
    mike.say "Да, Лекси..."

# ch/lexi/date.rpy:1150
translate russian lexi_date_home_weed_intro_a3d04617:
    mike.say "Конечно..."

# ch/lexi/date.rpy:1151
translate russian lexi_date_home_weed_intro_4a1a1ecd:
    "Я едва успеваю произнести слова, прежде чем они превращаются в огромный зевок."

# ch/lexi/date.rpy:1153
translate russian lexi_date_home_weed_intro_deeccf95:
    "Ничего не могу поделать: стоит открыть рот, и зевота берёт верх."

# ch/lexi/date.rpy:1155
translate russian lexi_date_home_weed_intro_0fc7c99f:
    lexi.say "Ого..."

# ch/lexi/date.rpy:1157
translate russian lexi_date_home_weed_intro_70f37a81:
    lexi.say "Ты что, совсем не спишь?"

# ch/lexi/date.rpy:1158
translate russian lexi_date_home_weed_intro_c53cb5e8:
    lexi.say "Блин, из-за тебя мне тоже зевать хочется!"

# ch/lexi/date.rpy:1160
translate russian lexi_date_home_weed_intro_f000d78b:
    "И Лекси не шутит."

# ch/lexi/date.rpy:1161
translate russian lexi_date_home_weed_intro_aaef2846:
    "Я вижу, как она пытается сдержаться."

# ch/lexi/date.rpy:1163
translate russian lexi_date_home_weed_intro_ca08da39:
    "Но потом тоже начинает зевать!"

# ch/lexi/date.rpy:1165
translate russian lexi_date_home_weed_intro_87a69c4f:
    lexi.say "Да чтоб тебя!"

# ch/lexi/date.rpy:1167
translate russian lexi_date_home_weed_intro_34b7183a:
    lexi.say "Я уже настроилась на безумный вечер."

# ch/lexi/date.rpy:1168
translate russian lexi_date_home_weed_intro_a5407536:
    lexi.say "А теперь хочу только развалиться перед телеком!"

# ch/lexi/date.rpy:1169
translate russian lexi_date_home_weed_intro_031f0510:
    "Эти слова — музыка для моих ужасно уставших ушей."

# ch/lexi/date.rpy:1170
translate russian lexi_date_home_weed_intro_b8b3e0c3:
    "Но, отвечая, я стараюсь скрыть радость."

# ch/lexi/date.rpy:1171
translate russian lexi_date_home_weed_intro_700f54ac:
    mike.say "Да..."

# ch/lexi/date.rpy:1172
translate russian lexi_date_home_weed_intro_b73a6513:
    mike.say "Я тоже, Лекси!"

# ch/lexi/date.rpy:1173
translate russian lexi_date_home_weed_intro_50345829:
    mike.say "Я уже всё продумал."

# ch/lexi/date.rpy:1174
translate russian lexi_date_home_weed_intro_979ff52d:
    mike.say "Куда пойдём и чем займёмся."

# ch/lexi/date.rpy:1175
translate russian lexi_date_home_weed_intro_aea6e5e6:
    mike.say "Но будто кто-то высосал из меня все силы!"

# ch/lexi/date.rpy:1177
translate russian lexi_date_home_weed_intro_35443e3a:
    "Лекси фыркает и качает головой."

# ch/lexi/date.rpy:1178
translate russian lexi_date_home_weed_intro_123978a7:
    "И это не так плохо, как звучит."

# ch/lexi/date.rpy:1179
translate russian lexi_date_home_weed_intro_033e656a:
    "Поверьте, когда она дуется, это очень мило!"

# ch/lexi/date.rpy:1180
translate russian lexi_date_home_weed_intro_275b9bd9:
    lexi.say "И что, чёрт возьми, нам тогда делать?"

# ch/lexi/date.rpy:1182
translate russian lexi_date_home_weed_intro_3e9eb70c:
    lexi.say "Я слишком устала, чтобы куда-то ещё идти!"

# ch/lexi/date.rpy:1183
translate russian lexi_date_home_weed_intro_a5706f95:
    "Я пожимаю плечами и оглядываюсь."

# ch/lexi/date.rpy:1184
translate russian lexi_date_home_weed_intro_5a193b97:
    "Может, идеальное решение прямо перед носом?"

# ch/lexi/date.rpy:1185
translate russian lexi_date_home_weed_intro_354708dd:
    mike.say "Можем сделать то, чего тебе хочется, Лекси."

# ch/lexi/date.rpy:1186
translate russian lexi_date_home_weed_intro_f7991b88:
    mike.say "Остаться здесь и развалиться перед телевизором."

# ch/lexi/date.rpy:1187
translate russian lexi_date_home_weed_intro_5503c2fe:
    mike.say "Все ушли, так что дом в нашем распоряжении."

# ch/lexi/date.rpy:1188
translate russian lexi_date_home_weed_intro_f89fff5d:
    mike.say "А на ласки на диване много сил не нужно..."

# ch/lexi/date.rpy:1190
translate russian lexi_date_home_weed_intro_977bad34:
    "Я вижу, как на лице Лекси появляется улыбка."

# ch/lexi/date.rpy:1191
translate russian lexi_date_home_weed_intro_b2760799:
    "К счастью, ей, похоже, нравится эта мысль."

# ch/lexi/date.rpy:1193
translate russian lexi_date_home_weed_intro_c5a63a80:
    "Она поднимает брови и берёт меня за руку."

# ch/lexi/date.rpy:1195
translate russian lexi_date_home_weed_intro_a052c93e:
    lexi.say "Ну пойдём, [lssb_lexi.hero_name()]."

# ch/lexi/date.rpy:1196
translate russian lexi_date_home_weed_intro_fb3f1ab2:
    lexi.say "Устроимся поудобнее."

# ch/lexi/date.rpy:1197
translate russian lexi_date_home_weed_intro_2b9b1890:
    lexi.say "А там посмотрим, насколько ты на самом деле устал!"

# ch/lexi/date.rpy:1198
translate russian lexi_date_home_weed_intro_43848a5b:
    "Свет уже приглушён, так что атмосфера идеальная."

# ch/lexi/date.rpy:1199
translate russian lexi_date_home_weed_intro_8091ca9f:
    "Я едва успеваю сесть на диван, как она набрасывается на меня."

# ch/lexi/date.rpy:1204
translate russian lexi_date_home_weed_intro_214e92b5:
    "Приземлившись рядом, Лекси почти обвивается вокруг меня и крепко обнимает."

# ch/lexi/date.rpy:1205
translate russian lexi_date_home_weed_intro_addc6d17:
    "Дальше происходит именно то, на что я надеялся, когда это предлагал."

# ch/lexi/date.rpy:1206
translate russian lexi_date_home_weed_intro_f08cb032:
    "По телевизору что-то идёт, но я понятия не имею что."

# ch/lexi/date.rpy:1207
translate russian lexi_date_home_weed_intro_051f4e16:
    "Потому что всё моё внимание достаётся Лекси."

# ch/lexi/date.rpy:1208
translate russian lexi_date_home_weed_intro_8cd5f014:
    "Сейчас она напоминает сонную, но чувственную змею."

# ch/lexi/date.rpy:1209
translate russian lexi_date_home_weed_intro_03667937:
    "Наши руки и ноги переплетены."

# ch/lexi/date.rpy:1210
translate russian lexi_date_home_weed_intro_c1b30dc6:
    "Её губы то прижимаются к моим, то блуждают где-то ещё."

# ch/lexi/date.rpy:1211
translate russian lexi_date_home_weed_intro_4a08c7b7:
    "Этого с лихвой хватает, чтобы забыть о планах куда-нибудь сходить."

# ch/lexi/date.rpy:1212
translate russian lexi_date_home_weed_intro_5017547e:
    "Чёрт, я почти готов больше вообще не выходить из дома!"

# ch/lexi/date.rpy:1213
translate russian lexi_date_home_weed_intro_3760784c:
    "Я бы с радостью провёл так почти весь вечер."

# ch/lexi/date.rpy:1214
translate russian lexi_date_home_weed_intro_7edffde2:
    "Но спустя некоторое время Лекси решает перевести дух."

# ch/lexi/date.rpy:1219
translate russian lexi_date_home_weed_intro_e8381a96:
    "Она садится и с улыбкой смотрит на меня сверху вниз."

# ch/lexi/date.rpy:1220
translate russian lexi_date_home_weed_intro_3b641f09:
    lexi.say "М-м-м..."

# ch/lexi/date.rpy:1221
translate russian lexi_date_home_weed_intro_9ace1e12:
    lexi.say "Вот так лучше."

# ch/lexi/date.rpy:1222
translate russian lexi_date_home_weed_intro_493cc2b7:
    lexi.say "Теперь я куда больше расслабилась!"

# ch/lexi/date.rpy:1223
translate russian lexi_date_home_weed_intro_1351918a:
    lexi.say "Но я знаю кое-что, что поможет расслабиться окончательно..."

# ch/lexi/date.rpy:1224
translate russian lexi_date_home_weed_intro_b2b3c989:
    "Я с готовностью киваю, думая, что Лекси имеет в виду что-то очень непристойное."

# ch/lexi/date.rpy:1225
translate russian lexi_date_home_weed_intro_361c45cc:
    "Мысль о том, чтобы она уделила внимание тому, что ниже пояса, сейчас особенно приятна!"

# ch/lexi/date.rpy:1226
translate russian lexi_date_home_weed_intro_39889bce:
    "Но тут я вижу, как она достаёт маленький пластиковый пакетик."

# ch/lexi/date.rpy:1227
translate russian lexi_date_home_weed_intro_24bc1224:
    "Кажется, я могу угадать содержимое по одному виду."

# ch/lexi/date.rpy:1228
translate russian lexi_date_home_weed_intro_0d898960:
    "А когда она его открывает, резкий запах подтверждает мои подозрения."

# ch/lexi/date.rpy:1229
translate russian lexi_date_home_weed_intro_28eea78e:
    mike.say "Лекси..."

# ch/lexi/date.rpy:1230
translate russian lexi_date_home_weed_intro_488856c4:
    mike.say "Это то, о чём я думаю?"

# ch/lexi/date.rpy:1231
translate russian lexi_date_home_weed_intro_80d0c926:
    mike.say "Это марихуана?"

# ch/lexi/date.rpy:1232
translate russian lexi_date_home_weed_intro_c06f5f89:
    "Лекси посмеивается и закатывает глаза."

# ch/lexi/date.rpy:1236
translate russian lexi_date_home_weed_intro_676d35d1:
    lexi.say "Что такое, [lssb_lexi.hero_name()]?"

# ch/lexi/date.rpy:1237
translate russian lexi_date_home_weed_intro_8fa1ebd8:
    lexi.say "Ты же не такой зануда?"

# ch/lexi/date.rpy:1239
translate russian lexi_date_home_weed_intro_03629476:
    lexi.say "Не боишься немного травки?"

# ch/lexi/date.rpy:1242
translate russian lexi_date_home_weed_intro_bd2c58dd:
    "Да почему, чёрт возьми, нет?"

# ch/lexi/date.rpy:1243
translate russian lexi_date_home_weed_intro_b3ab49bc:
    "Я уже сто лет как следует не курил."

# ch/lexi/date.rpy:1244
translate russian lexi_date_home_weed_intro_04a08308:
    "И уверен, что Лекси отличает хорошую траву от плохой."

# ch/lexi/date.rpy:1245
translate russian lexi_date_home_weed_intro_37f732f7:
    mike.say "Конечно, Лекси..."

# ch/lexi/date.rpy:1246
translate russian lexi_date_home_weed_intro_37236f4d:
    mike.say "Мне бы не помешало успокоить нервы."

# ch/lexi/date.rpy:1248
translate russian lexi_date_home_weed_intro_82fe0e33:
    "Лекси кивает и прикуривает косяк."

# ch/lexi/date.rpy:1249
translate russian lexi_date_home_weed_intro_72e16b6f:
    "Делает пару долгих затяжек, задерживая дым в лёгких."

# ch/lexi/date.rpy:1251
translate russian lexi_date_home_weed_intro_57076cbe:
    "Затем выдыхает в воздух ароматные облака."

# ch/lexi/date.rpy:1253
translate russian lexi_date_home_weed_intro_9d6b6721:
    lexi.say "Бля..."

# ch/lexi/date.rpy:1254
translate russian lexi_date_home_weed_intro_95111e21:
    lexi.say "Как же ХОРОШО!"

# ch/lexi/date.rpy:1256
translate russian lexi_date_home_weed_intro_bfbe2fd3:
    "Она передаёт косяк мне, и я следую её примеру."

# ch/lexi/date.rpy:1258
translate russian lexi_date_home_weed_intro_40bb21cf:
    "Лекси права: травка и правда отличная!"

# ch/lexi/date.rpy:1259
translate russian lexi_date_home_weed_intro_0480446b:
    "Стоит выдохнуть, и я чувствую, как меня накрывает."

# ch/lexi/date.rpy:1261
translate russian lexi_date_home_weed_intro_15ab5c54:
    "Словно макушка сейчас взлетит!"

# ch/lexi/date.rpy:1263
translate russian lexi_date_home_weed_intro_52fbb9af:
    "Через пару секунд Лекси начинает хихикать."

# ch/lexi/date.rpy:1264
translate russian lexi_date_home_weed_intro_34921c13:
    "А затем я слышу, как сам к ней присоединяюсь."

# ch/lexi/date.rpy:1266
translate russian lexi_date_home_weed_intro_b39d3a69:
    "И дальше мы ведём себя как пара стереотипных укурков."

# ch/lexi/date.rpy:1267
translate russian lexi_date_home_weed_intro_527f2481:
    "То всё кажется смешным, то вдруг наполняется глубоким духовным смыслом."

# ch/lexi/date.rpy:1268
translate russian lexi_date_home_weed_intro_88d786f7:
    "Но лучше всего то, что весь оставшийся вечер она не отлипает от меня."

# ch/lexi/date.rpy:1269
translate russian lexi_date_home_weed_intro_634f12e2:
    "Если эта травка действует на неё именно так, я только за."

# ch/lexi/date.rpy:1270
translate russian lexi_date_home_weed_intro_7d324eab:
    "Меня устраивает всё, от чего Лекси хочет лишь одного — лежать в моих объятиях!"

# ch/lexi/date.rpy:1277
translate russian lexi_date_home_weed_intro_343641fe:
    "Мне самому не слишком хочется это курить."

# ch/lexi/date.rpy:1278
translate russian lexi_date_home_weed_intro_89f5eab3:
    "Но и пуританином меня не назовёшь."

# ch/lexi/date.rpy:1279
translate russian lexi_date_home_weed_intro_af45b122:
    mike.say "Я откажусь, Лекси."

# ch/lexi/date.rpy:1280
translate russian lexi_date_home_weed_intro_c830450a:
    mike.say "Но ты, если хочешь, кури."

# ch/lexi/date.rpy:1282
translate russian lexi_date_home_weed_intro_7906e700:
    lexi.say "Точно, [lssb_lexi.hero_name()]?"

# ch/lexi/date.rpy:1284
translate russian lexi_date_home_weed_intro_7f17af77:
    lexi.say "Это очень хорошая трава!"

# ch/lexi/date.rpy:1285
translate russian lexi_date_home_weed_intro_37a2b46b:
    mike.say "Не, мне и так нормально."

# ch/lexi/date.rpy:1287
translate russian lexi_date_home_weed_intro_dc5c3d76:
    "Лекси пожимает плечами и прикуривает косяк."

# ch/lexi/date.rpy:1288
translate russian lexi_date_home_weed_intro_72e16b6f_1:
    "Делает пару долгих затяжек, задерживая дым в лёгких."

# ch/lexi/date.rpy:1290
translate russian lexi_date_home_weed_intro_57076cbe_1:
    "Затем выдыхает в воздух ароматные облака."

# ch/lexi/date.rpy:1292
translate russian lexi_date_home_weed_intro_9d6b6721_1:
    lexi.say "Бля..."

# ch/lexi/date.rpy:1293
translate russian lexi_date_home_weed_intro_95111e21_1:
    lexi.say "Как же ХОРОШО!"

# ch/lexi/date.rpy:1295
translate russian lexi_date_home_weed_intro_2e4cf376:
    "Через пару секунд она начинает хихикать."

# ch/lexi/date.rpy:1297
translate russian lexi_date_home_weed_intro_2cc917b4:
    "И дальше Лекси ведёт себя как стереотипная укуренная."

# ch/lexi/date.rpy:1298
translate russian lexi_date_home_weed_intro_527f2481_1:
    "То всё кажется смешным, то вдруг наполняется глубоким духовным смыслом."

# ch/lexi/date.rpy:1299
translate russian lexi_date_home_weed_intro_88d786f7_1:
    "Но лучше всего то, что весь оставшийся вечер она не отлипает от меня."

# ch/lexi/date.rpy:1300
translate russian lexi_date_home_weed_intro_634f12e2_1:
    "Если эта травка действует на неё именно так, я только за."

# ch/lexi/date.rpy:1301
translate russian lexi_date_home_weed_intro_7d324eab_1:
    "Меня устраивает всё, от чего Лекси хочет лишь одного — лежать в моих объятиях!"

# ch/lexi/date.rpy:1305
translate russian lexi_date_home_weed_intro_8a12f9af:
    "Она за что это место принимает? За наркопритон?"

# ch/lexi/date.rpy:1306
translate russian lexi_date_home_weed_intro_8fcebdfd:
    "Я не собираюсь смотреть, как Лекси превращает мой дом в притон для курения крэка!"

# ch/lexi/date.rpy:1307
translate russian lexi_date_home_weed_intro_69a035ed:
    mike.say "Ни за что ты не будешь курить эту дрянь здесь, Лекси!"

# ch/lexi/date.rpy:1308
translate russian lexi_date_home_weed_intro_b7d3537a:
    mike.say "Один запах нас с головой выдаст."

# ch/lexi/date.rpy:1310
translate russian lexi_date_home_weed_intro_2561b981:
    lexi.say "Ты серьёзно?!"

# ch/lexi/date.rpy:1311
translate russian lexi_date_home_weed_intro_cfd08905:
    lexi.say "Это всего лишь косяк, [lssb_lexi.hero_name()]!"

# ch/lexi/date.rpy:1313
translate russian lexi_date_home_weed_intro_a0d6995e:
    lexi.say "Я же не предлагаю курить крэк или колоть героин!"

# ch/lexi/date.rpy:1314
translate russian lexi_date_home_weed_intro_0f021195:
    mike.say "Нет, Лекси. Просто нет, ясно?"

# ch/lexi/date.rpy:1316
translate russian lexi_date_home_weed_intro_d8c90077:
    "Лекси недовольно бурчит и запихивает пакетик обратно в карман."

# ch/lexi/date.rpy:1320
translate russian lexi_date_home_weed_intro_e8440675:
    "Затем разваливается на диване, что-то бормоча себе под нос."

# ch/lexi/date.rpy:1321
translate russian lexi_date_home_weed_intro_2ad0949f:
    "И, как я замечаю, теперь садится чуть подальше от меня."

# ch/lexi/date.rpy:1327
translate russian lexi_date_mall_weed_b0cce293:
    "Иногда я прихожу в торговый центр один, просто чтобы немного подумать."

# ch/lexi/date.rpy:1328
translate russian lexi_date_mall_weed_56caa0dc:
    "Мне это бывает куда полезнее, чем сидеть где-нибудь в одиночестве, понимаете?"

# ch/lexi/date.rpy:1329
translate russian lexi_date_mall_weed_e697bd66:
    "Почему-то людская суета и фоновый шум помогают отключиться от реальности."

# ch/lexi/date.rpy:1331
translate russian lexi_date_mall_weed_2633ba1e:
    "Но всё совсем иначе, когда зовёшь с собой кого-то вроде Лекси..."

# ch/lexi/date.rpy:1335
translate russian lexi_date_mall_weed_f38add70:
    lexi.say "О-о-о..."

# ch/lexi/date.rpy:1336
translate russian lexi_date_mall_weed_27183eb3:
    lexi.say "Посмотри на эти шорты! Какие обтягивающие!"

# ch/lexi/date.rpy:1338
translate russian lexi_date_mall_weed_7fa9a083:
    lexi.say "А эти кроссовки — такие дорогие!"

# ch/lexi/date.rpy:1339
translate russian lexi_date_mall_weed_d5fd9cd9:
    lexi.say "Как думаешь, получится примерить их и незаметно уйти из магазина?"

# ch/lexi/date.rpy:1341
translate russian lexi_date_mall_weed_fc0437e4:
    lexi.say "О... иди глянь сюда!"

# ch/lexi/date.rpy:1342
translate russian lexi_date_mall_weed_8979eade:
    lexi.say "Как думаешь, мне пойдёт это бикини со стрингами, [lssb_lexi.hero_name()]?"

# ch/lexi/date.rpy:1344
translate russian lexi_date_mall_weed_7e7495ef:
    lexi.say "Сексуально, да?"

# ch/lexi/date.rpy:1346
translate russian lexi_date_mall_weed_88edaa9e:
    "Не успевает она заметить одну вещь, как уже порхает к другой."

# ch/lexi/date.rpy:1347
translate russian lexi_date_mall_weed_baf2fb0d:
    "Словно у неё память и способность сосредоточиться как у золотой рыбки!"

# ch/lexi/date.rpy:1348
translate russian lexi_date_mall_weed_38e9886a:
    "Но не поймите неправильно: я не жалуюсь."

# ch/lexi/date.rpy:1352
translate russian lexi_date_mall_weed_29acb14e:
    "Мне даже нравится сейчас следовать за ней."

# ch/lexi/date.rpy:1353
translate russian lexi_date_mall_weed_16872de4:
    "В такой Лекси есть что-то трогательное."

# ch/lexi/date.rpy:1354
translate russian lexi_date_mall_weed_7a73257b:
    "Будто она становится невиннее и почти по-детски игривой."

# ch/lexi/date.rpy:1355
translate russian lexi_date_mall_weed_7ff606d9:
    "Совсем не похожей на суровую, деловую уличную девчонку, какой обычно кажется."

# ch/lexi/date.rpy:1356
translate russian lexi_date_mall_weed_3f8382ca:
    mike.say "Ого..."

# ch/lexi/date.rpy:1357
translate russian lexi_date_mall_weed_412abd0f:
    mike.say "Помедленнее, Лекси!"

# ch/lexi/date.rpy:1358
translate russian lexi_date_mall_weed_6a61cdb7:
    mike.say "У меня от тебя голова кругом!"

# ch/lexi/date.rpy:1360
translate russian lexi_date_mall_weed_e818e9a6:
    "Лекси резко останавливается и смотрит на меня через плечо."

# ch/lexi/date.rpy:1362
translate russian lexi_date_mall_weed_a1a486f1:
    "На губах у неё кривая улыбка, а в глазах озорной блеск."

# ch/lexi/date.rpy:1364
translate russian lexi_date_mall_weed_098f32bd:
    lexi.say "О-о..."

# ch/lexi/date.rpy:1366
translate russian lexi_date_mall_weed_7ed0b71d:
    lexi.say "Я тебе не по зубам, [lssb_lexi.hero_name()]?"

# ch/lexi/date.rpy:1368
translate russian lexi_date_mall_weed_ab1bb466:
    lexi.say "Не поспеваешь?"

# ch/lexi/date.rpy:1370
translate russian lexi_date_mall_weed_886c615e:
    mike.say "Поспеваю, Лекси!"

# ch/lexi/date.rpy:1371
translate russian lexi_date_mall_weed_b0a674aa:
    mike.say "Но хочу немного сбавить темп."

# ch/lexi/date.rpy:1372
translate russian lexi_date_mall_weed_a393c22b:
    mike.say "Так мы всё обойдём в два счёта."

# ch/lexi/date.rpy:1373
translate russian lexi_date_mall_weed_18198aca:
    mike.say "И что потом?"

# ch/lexi/date.rpy:1374
translate russian lexi_date_mall_weed_ed618af1:
    mike.say "Как глазеть на витрины, если все витрины уже закончились?"

# ch/lexi/date.rpy:1375
translate russian lexi_date_mall_weed_97855324:
    "Лекси качает головой и грозит мне пальцем."

# ch/lexi/date.rpy:1377
translate russian lexi_date_mall_weed_3fc140f9:
    lexi.say "Знаешь, что тебе нужно, [lssb_lexi.hero_name()]?"

# ch/lexi/date.rpy:1378
translate russian lexi_date_mall_weed_260f7db8:
    lexi.say "Тебе нужно расслабиться."

# ch/lexi/date.rpy:1379
translate russian lexi_date_mall_weed_b182f561:
    lexi.say "Отпустить напряжение."

# ch/lexi/date.rpy:1381
translate russian lexi_date_mall_weed_bd52afef:
    lexi.say "И у меня есть кое-что подходящее!"

# ch/lexi/date.rpy:1383
translate russian lexi_date_mall_weed_71bbd978:
    "Лекси достаёт нечто похожее на самокрутку."

# ch/lexi/date.rpy:1384
translate russian lexi_date_mall_weed_76365963:
    "Но когда она машет ею у меня под носом, я улавливаю безошибочно знакомый запах."

# ch/lexi/date.rpy:1385
translate russian lexi_date_mall_weed_c6544d2e:
    "Это не сигарета, это косяк!"

# ch/lexi/date.rpy:1386
translate russian lexi_date_mall_weed_12212fc4:
    "Лекси, похоже, принимает моё удивление за восторг."

# ch/lexi/date.rpy:1388
translate russian lexi_date_mall_weed_f9490f07:
    "Она похотливо подмигивает и ухмыляется."

# ch/lexi/date.rpy:1390
translate russian lexi_date_mall_weed_09c60d7a:
    lexi.say "Ну, [lssb_lexi.hero_name()]..."

# ch/lexi/date.rpy:1391
translate russian lexi_date_mall_weed_8dc2eac4:
    lexi.say "Что скажешь?"

# ch/lexi/date.rpy:1395
translate russian lexi_date_mall_weed_f2e5be1b:
    "Я прикрываю косяк ладонью, чтобы никто не увидел."

# ch/lexi/date.rpy:1396
translate russian lexi_date_mall_weed_59b19db3:
    "Но при этом киваю Лекси и улыбаюсь."

# ch/lexi/date.rpy:1397
translate russian lexi_date_mall_weed_69d9db70:
    mike.say "Почему, чёрт возьми, нет?"

# ch/lexi/date.rpy:1398
translate russian lexi_date_mall_weed_1ccd6f5a:
    mike.say "Мне бы не помешало расслабиться."

# ch/lexi/date.rpy:1400
translate russian lexi_date_mall_weed_9dae1de8:
    "Лекси хихикает и хватает меня за запястье."

# ch/lexi/date.rpy:1401
translate russian lexi_date_mall_weed_55a2642b:
    "Не успеваю опомниться, как она уже уводит меня из оживлённой части торгового центра."

# ch/lexi/date.rpy:1403
translate russian lexi_date_mall_weed_d8657995:
    "Вскоре я оказываюсь в дальнем углу парковки, вдали от любопытных глаз."

# ch/lexi/date.rpy:1404
translate russian lexi_date_mall_weed_02b8b326:
    "Лекси тут же достаёт косяк и зажигалку."

# ch/lexi/date.rpy:1406
translate russian lexi_date_mall_weed_01a8d1ab:
    "Прикуривает и делает долгую глубокую затяжку."

# ch/lexi/date.rpy:1408
translate russian lexi_date_mall_weed_5b9e739a:
    "Затем выдыхает длинное облако резко пахнущего дыма."

# ch/lexi/date.rpy:1409
translate russian lexi_date_mall_weed_12e633c8:
    lexi.say "О да..."

# ch/lexi/date.rpy:1411
translate russian lexi_date_mall_weed_2b51f68b:
    lexi.say "Вот что надо!"

# ch/lexi/date.rpy:1413
translate russian lexi_date_mall_weed_f62e0d23:
    "Лекси передаёт косяк мне, и я тоже затягиваюсь."

# ch/lexi/date.rpy:1415
translate russian lexi_date_mall_weed_153fef9d:
    "Трава чертовски крепкая, гораздо крепче, чем я ожидал."

# ch/lexi/date.rpy:1416
translate russian lexi_date_mall_weed_df4bbf84:
    "Но если знать меру, то ничего такого, с чем я бы не справился."

# ch/lexi/date.rpy:1418
translate russian lexi_date_mall_weed_cd55de2c:
    "Я ненадолго задерживаю дым, затем выдыхаю."

# ch/lexi/date.rpy:1419
translate russian lexi_date_mall_weed_95dc16e3:
    "Наслаждаясь тем, как с каждой секундой в голове становится всё легче."

# ch/lexi/date.rpy:1420
translate russian lexi_date_mall_weed_e39a6791:
    lexi.say "Хорошая травка, а?"

# ch/lexi/date.rpy:1421
translate russian lexi_date_mall_weed_ac0f39c5:
    mike.say "Да, Лекси..."

# ch/lexi/date.rpy:1422
translate russian lexi_date_mall_weed_91450a8e:
    mike.say "Очень даже!"

# ch/lexi/date.rpy:1424
translate russian lexi_date_mall_weed_426f1191:
    "Мы передаём косяк друг другу."

# ch/lexi/date.rpy:1425
translate russian lexi_date_mall_weed_ffa97853:
    "И вскоре я понимаю, что меня накрыло уже опасно сильно."

# ch/lexi/date.rpy:1426
translate russian lexi_date_mall_weed_50a4ec61:
    "Но ещё не настолько, чтобы не заметить того же у Лекси."

# ch/lexi/date.rpy:1427
translate russian lexi_date_mall_weed_617435b0:
    mike.say "Чёрт, Лекси..."

# ch/lexi/date.rpy:1428
translate russian lexi_date_mall_weed_bd30105f:
    mike.say "У меня будто голова гелием наполнена!"

# ch/lexi/date.rpy:1429
translate russian lexi_date_mall_weed_f46f0be5:
    "Лекси разражается смехом, подтверждая, что она под кайфом."

# ch/lexi/date.rpy:1430
translate russian lexi_date_mall_weed_2d647767:
    "Иначе такая реплика точно не вызвала бы подобной реакции."

# ch/lexi/date.rpy:1432
translate russian lexi_date_mall_weed_f881a04b:
    lexi.say "У меня тоже!"

# ch/lexi/date.rpy:1433
translate russian lexi_date_mall_weed_fed58789:
    lexi.say "А знаешь, от чего всегда становится ещё лучше?"

# ch/lexi/date.rpy:1434
translate russian lexi_date_mall_weed_7b4c145e:
    "Я качаю головой, ожидая чего-нибудь очевидного."

# ch/lexi/date.rpy:1435
translate russian lexi_date_mall_weed_17d6e064:
    "Ну, вроде пиццы или похода за пивом."

# ch/lexi/date.rpy:1439
translate russian lexi_date_mall_weed_17bb209e:
    "Но вместо этого Лекси опускается на колени, не сводя с меня глаз."

# ch/lexi/date.rpy:1440
translate russian lexi_date_mall_weed_df5730ff:
    "Я молча и заворожённо смотрю, как она расстёгивает мне ширинку."

# ch/lexi/date.rpy:1444
translate russian lexi_date_mall_weed_207e52ae:
    "А когда она достаёт мой член, тоже начинаю смеяться."

# ch/lexi/date.rpy:1445
translate russian lexi_date_mall_weed_1ca27891:
    mike.say "Т... ты же прикалываешься?"

# ch/lexi/date.rpy:1446
translate russian lexi_date_mall_weed_7f8b160a:
    mike.say "Да, Лекси?"

# ch/lexi/date.rpy:1447
translate russian lexi_date_mall_weed_fddcec79:
    "Вместо ответа Лекси приподнимает брови."

# ch/lexi/date.rpy:1450
translate russian lexi_date_mall_weed_b10f17ae:
    "И одновременно берёт мой член в рот."

# ch/lexi/date.rpy:1451
translate russian lexi_date_mall_weed_c77d4930:
    "Мне остаётся лишь изумлённо вздохнуть, когда она принимается работать губами и языком."

# ch/lexi/date.rpy:1452
translate russian lexi_date_mall_weed_3dcac2df:
    "Под кайфом от косяка её ласки кажутся невероятными."

# ch/lexi/date.rpy:1454
translate russian lexi_date_mall_weed_ae9f6bbc:
    "Так хорошо, что голова кружится сильнее, чем от травки!"

# ch/lexi/date.rpy:1455
translate russian lexi_date_mall_weed_76c4e5b2:
    "В другое время я бы волновался, что нас заметят."

# ch/lexi/date.rpy:1456
translate russian lexi_date_mall_weed_4931a77b:
    "Но сейчас думаю лишь о том, чтобы позволить Лекси делать своё дело."

# ch/lexi/date.rpy:1465
translate russian lexi_date_mall_weed_8b2b3201:
    "Даже накурившись, Лекси ничуть не теряет мастерства в искусстве минета."

# ch/lexi/date.rpy:1466
translate russian lexi_date_mall_weed_0010a297:
    "Руки, голова, губы и язык работают в идеальной гармонии."

# ch/lexi/date.rpy:1474
translate russian lexi_date_mall_weed_f4572978:
    "И всякий раз, когда она слегка меняет движения, я прерывисто вздыхаю."

# ch/lexi/date.rpy:1475
translate russian lexi_date_mall_weed_27e00679:
    "Я настолько поглощён её ласками, что совсем забываю, где мы."

# ch/lexi/date.rpy:1483
translate russian lexi_date_mall_weed_aeba1de4:
    "Пока не слышу, как поблизости заводится машина!"

# ch/lexi/date.rpy:1491
translate russian lexi_date_mall_weed_f16654d8:
    "Я вздрагиваю от шума, и Лекси давится."

# ch/lexi/date.rpy:1492
translate russian lexi_date_mall_weed_8bda11b8:
    "Вдобавок от неожиданности я кончаю слишком рано!"

# ch/lexi/date.rpy:1496
translate russian lexi_date_mall_weed_3637c51c:
    "Лекси просто не успевает отреагировать."

# ch/lexi/date.rpy:1501
translate russian lexi_date_mall_weed_39c8379a:
    "А я ещё и почти заталкиваю ей член в горло!"

# ch/lexi/date.rpy:1504
translate russian lexi_date_mall_weed_a3148e46:
    "Она давится и ловит воздух, пока я изливаюсь."

# ch/lexi/date.rpy:1510
translate russian lexi_date_mall_weed_1c79ec1b:
    "Но каким-то образом всё же умудряется проглотить всё."

# ch/lexi/date.rpy:1514
translate russian lexi_date_mall_weed_5514fdde:
    "Прежде чем Лекси успевает отреагировать, я вынимаю член у неё изо рта."

# ch/lexi/date.rpy:1515
translate russian lexi_date_mall_weed_8d37e807:
    "Она задыхается и давится от полной неожиданности."

# ch/lexi/date.rpy:1518
translate russian lexi_date_mall_weed_16c761b4:
    "А мгновение спустя я ещё и кончаю ей в лицо!"

# ch/lexi/date.rpy:1520
translate russian lexi_date_mall_weed_045b5945:
    "Сперма забрызгивает её, оставляя на лице липкие белые полосы."

# ch/lexi/date.rpy:1523
translate russian lexi_date_mall_weed_75d3e306:
    "К счастью, машина оказывается на другом конце парковки."

# ch/lexi/date.rpy:1524
translate russian lexi_date_mall_weed_b1177baa:
    "Она уезжает, и сидящие в ней так и не узнают, чем мы занимались."

# ch/lexi/date.rpy:1527
translate russian lexi_date_mall_weed_78820f82:
    mike.say "Фух..."

# ch/lexi/date.rpy:1528
translate russian lexi_date_mall_weed_07044910:
    mike.say "Вот это повезло!"

# ch/lexi/date.rpy:1533
translate russian lexi_date_mall_weed_f3426689:
    lexi.say "За себя говори!"

# ch/lexi/date.rpy:1534
translate russian lexi_date_mall_weed_41ee4fc2:
    lexi.say "Ты меня всю заляпал, придурок!"

# ch/lexi/date.rpy:1536
translate russian lexi_date_mall_weed_06a04c44:
    "Я оборачиваюсь к Лекси, которая всё ещё пытается привести себя в порядок."

# ch/lexi/date.rpy:1537
translate russian lexi_date_mall_weed_00f7d3e9:
    "И не могу удержаться от смешка, пряча член обратно в штаны."

# ch/lexi/date.rpy:1539
translate russian lexi_date_mall_weed_3a4fd161:
    "Конечно, потом она наверняка заставит меня за это расплатиться."

# ch/lexi/date.rpy:1540
translate russian lexi_date_mall_weed_1fe87a2e:
    "Но сейчас, пока я под кайфом, это чертовски смешно!"

# ch/lexi/date.rpy:1543
translate russian lexi_date_mall_weed_5b7052d4:
    "Почти сразу после затяжки я понимаю, что что-то не так."

# ch/lexi/date.rpy:1544
translate russian lexi_date_mall_weed_eeb9b607:
    "Голова начинает кружиться, а перед глазами всё расплывается."

# ch/lexi/date.rpy:1549
translate russian lexi_date_mall_weed_2a2a3afc:
    "Лекси тут же выглядит встревоженной."

# ch/lexi/date.rpy:1551
translate russian lexi_date_mall_weed_c07ac898:
    lexi.say "Блядь!"

# ch/lexi/date.rpy:1552
translate russian lexi_date_mall_weed_9276e36f:
    lexi.say "Ты в порядке?!"

# ch/lexi/date.rpy:1554
translate russian lexi_date_mall_weed_8fb73da4:
    mike.say "Я..."

# ch/lexi/date.rpy:1555
translate russian lexi_date_mall_weed_270801d8:
    mike.say "Ещё чего!"

# ch/lexi/date.rpy:1556
translate russian lexi_date_mall_weed_16f066c1:
    mike.say "Вообще-то... мне как-то..."

# ch/lexi/date.rpy:1557
translate russian lexi_date_mall_weed_36b7aa7b:
    "Я не успеваю договорить и сгибаюсь пополам."

# ch/lexi/date.rpy:1559
translate russian lexi_date_mall_weed_30f64238:
    "Лекси едва успевает отскочить, когда меня рвёт."

# ch/lexi/date.rpy:1561
translate russian lexi_date_mall_weed_6437200f:
    lexi.say "Фу!"

# ch/lexi/date.rpy:1562
translate russian lexi_date_mall_weed_aff8bc97:
    lexi.say "Мерзость!"

# ch/lexi/date.rpy:1564
translate russian lexi_date_mall_weed_67d5b96e:
    mike.say "Угх..."

# ch/lexi/date.rpy:1565
translate russian lexi_date_mall_weed_4358cfe3:
    mike.say "П... прости, Лекси..."

# ch/lexi/date.rpy:1566
translate russian lexi_date_mall_weed_505a1518:
    mike.say "Не знаю, что случилось!"

# ch/lexi/date.rpy:1567
translate russian lexi_date_mall_weed_b51118a6:
    "Лекси осторожно переступает через лужу рвоты у моих ног."

# ch/lexi/date.rpy:1568
translate russian lexi_date_mall_weed_c7ccf1fc:
    "Затем мягко берёт меня под руку."

# ch/lexi/date.rpy:1570
translate russian lexi_date_mall_weed_1823ebfb:
    lexi.say "Господи..."

# ch/lexi/date.rpy:1571
translate russian lexi_date_mall_weed_d87b8f56:
    lexi.say "Давай приведём тебя в порядок, ладно?"

# ch/lexi/date.rpy:1572
translate russian lexi_date_mall_weed_11c7bd85:
    "Я слабо киваю и позволяю Лекси увести меня."

# ch/lexi/date.rpy:1573
translate russian lexi_date_mall_weed_8c0902f7:
    "Так бесславно заканчивается наша прогулка по торговому центру."

# ch/lexi/date.rpy:1576
translate russian lexi_date_mall_weed_e39434d2:
    "Я опасливо оглядываюсь в поисках охранников."

# ch/lexi/date.rpy:1577
translate russian lexi_date_mall_weed_7af0d417:
    "Внезапно я уверен, что кто-нибудь обязательно заметил, как Лекси размахивает косяком."

# ch/lexi/date.rpy:1578
translate russian lexi_date_mall_weed_26ca37b4:
    mike.say "Может, уберёшь эту штуку?!"

# ch/lexi/date.rpy:1579
translate russian lexi_date_mall_weed_ca94b5fe:
    mike.say "Здесь нельзя это курить!"

# ch/lexi/date.rpy:1581
translate russian lexi_date_mall_weed_fdcacd27:
    "Лекси хмурится и качает головой."

# ch/lexi/date.rpy:1582
translate russian lexi_date_mall_weed_f4e6d00f:
    "Но хотя бы прячет косяк обратно."

# ch/lexi/date.rpy:1584
translate russian lexi_date_mall_weed_ca417c11:
    lexi.say "А?"

# ch/lexi/date.rpy:1585
translate russian lexi_date_mall_weed_ab8394b7:
    lexi.say "Почему, чёрт возьми, нет?"

# ch/lexi/date.rpy:1587
translate russian lexi_date_mall_weed_332275df:
    lexi.say "Здесь наверняка сотня мест, где нас никто не увидит!"

# ch/lexi/date.rpy:1588
translate russian lexi_date_mall_weed_b9f3ddff:
    lexi.say "В любом из них можно раскурить эту прелесть!"

# ch/lexi/date.rpy:1590
translate russian lexi_date_mall_weed_11c94cc1:
    "Я отмахиваюсь, отвергая предложение."

# ch/lexi/date.rpy:1591
translate russian lexi_date_mall_weed_066812c7:
    mike.say "Ни за что, Лекси!"

# ch/lexi/date.rpy:1592
translate russian lexi_date_mall_weed_cbe440ff:
    mike.say "Дождись, пока вернёмся к тебе или ко мне, ладно?"

# ch/lexi/date.rpy:1593
translate russian lexi_date_mall_weed_a3271ca8:
    "Лекси закатывает глаза и недовольно бурчит."

# ch/lexi/date.rpy:1595
translate russian lexi_date_mall_weed_9671adb0:
    lexi.say "Ладно, ладно..."

# ch/lexi/date.rpy:1596
translate russian lexi_date_mall_weed_368ccfe1:
    lexi.say "Зануда!"

# ch/lexi/date.rpy:1598
translate russian lexi_date_mall_weed_bea611c8:
    "К счастью, Лекси довольно быстро об этом забывает."

# ch/lexi/date.rpy:1599
translate russian lexi_date_mall_weed_b98e2ecb:
    "Она не дуется и вскоре снова становится собой."

# ch/lexi/date.rpy:1600
translate russian lexi_date_mall_weed_711bc3c9:
    "Мы заканчиваем прогулку по торговому центру без дальнейших происшествий."

# ch/lexi/events.rpy:825
translate russian lexi_start_43b37f6c:
    "С ночными клубами никогда не угадаешь."

# ch/lexi/events.rpy:826
translate russian lexi_start_9c92db14:
    "Одни роскошные и стоят усилий, потраченных на вход. Можно даже пересечься с какой-нибудь знаменитостью."

# ch/lexi/events.rpy:827
translate russian lexi_start_93e59d49:
    "Другие — безвкусица на безвкусице. И обычно воняют блевотиной."

# ch/lexi/events.rpy:828
translate russian lexi_start_85bb6813:
    "К счастью, этот клуб очень даже хорош. И бываю я здесь не впервые."

# ch/lexi/events.rpy:829
translate russian lexi_start_1016cc4b:
    "В этот раз решил прийти один: друзья заняты."

# ch/lexi/events.rpy:830
translate russian lexi_start_91984f9a:
    "Обычно они охотно составляют компанию, но, наверное, у каждого свои дела."

# ch/lexi/events.rpy:831
translate russian lexi_start_4d31bef9:
    "А пока... моё единственное дело — хорошо провести время и забыть, как на меня недавно чуть не напали."

# ch/lexi/events.rpy:832
translate russian lexi_start_b8f4f34b:
    "Хотя вообще-то напали. Вот тебе и опасности..."

# ch/lexi/events.rpy:833
translate russian lexi_start_5c33f035:
    "Облокотившись на барную стойку, я непринуждённо заказываю выпивку и оглядываю зал."

# ch/lexi/events.rpy:834
translate russian lexi_start_f237ff40:
    "Я элегантно одет и потягиваю свой напиток. Думаю, выгляжу достаточно привлекательно."

# ch/lexi/events.rpy:835
translate russian lexi_start_1b022956:
    "Разумеется, высматриваю симпатичных девушек, которые тоже могли прийти одни."

# ch/lexi/events.rpy:836
translate russian lexi_start_63f4d6fb:
    "Чего я точно не ожидаю, так это встретить знакомое лицо."

# ch/lexi/events.rpy:837
translate russian lexi_start_ce9fb3e6:
    mike.say "Да... ну... нахрен..."

# ch/lexi/events.rpy:839
translate russian lexi_start_a2f3d94e:
    "Мы встречались всего раз, но тот случай так врезался в память, что я узнаю её мгновенно."

# ch/lexi/events.rpy:840
translate russian lexi_start_22f0c88a:
    "Светлые волосы. Большая грудь. Чёрт, на ней короткий топ с надписью «ШЛЮХА»."

# ch/lexi/events.rpy:841
translate russian lexi_start_90457336:
    "Да, это может быть только она. Я знаю, что не стоит, но всё равно иду к тому тёмному уголку в глубине зала."

# ch/lexi/events.rpy:842
translate russian lexi_start_c6cfd737:
    "Подойдя ближе и не сводя с неё глаз, я замечаю ловкие движения рук под столом, за которым она сидит."

# ch/lexi/events.rpy:843
translate russian lexi_start_819709cf:
    "Значит... она не только участвует в ограблениях, но и балуется наркотиками?"

# ch/lexi/events.rpy:844
translate russian lexi_start_43cb2bf3:
    "Я и сам не священник, но смотреть на такое мне неприятно."

# ch/lexi/events.rpy:845
translate russian lexi_start_b2cb46c8:
    "Мысль о том, что она на этом зарабатывает, меня злит."

# ch/lexi/events.rpy:846
translate russian lexi_start_c7323c05:
    "Она этого не заслуживает! Вообще ничего не заслуживает..."

# ch/lexi/events.rpy:847
translate russian lexi_start_d1b96210:
    lexi.say "Увидимся."

# ch/lexi/events.rpy:848
translate russian lexi_start_62b4a693:
    "Я едва различаю её прощание с сидящим рядом парнем. Тот осторожно встаёт и непринуждённо уходит, спрятав товар в карман."

# ch/lexi/events.rpy:849
translate russian lexi_start_0abbb6e8:
    "Место напротив неё теперь свободно. Предполагаю, его может занять любой потенциальный покупатель."

# ch/lexi/events.rpy:850
translate russian lexi_start_1d474937:
    "Что ж, когда хочу, я умею неплохо притворяться. Может, стоит сыграть эту роль."

# ch/lexi/events.rpy:851
translate russian lexi_start_c553247f:
    "А можно... просто наябедничать одному из вышибал. Не особо круто, зато она не втянет меня ни во что."

# ch/lexi/events.rpy:854
translate russian lexi_start_7cc76ac4:
    "Не хочу терять время. Лучше разберусь с этим прямо сейчас."

# ch/lexi/events.rpy:855
translate russian lexi_start_d5f4f33f:
    "Я не из тех, кто любит ждать и надеяться. По-моему, лучше действовать прямо."

# ch/lexi/events.rpy:857
translate russian lexi_start_e60c26e5:
    "Поэтому я просто подхожу к её столу и сажусь напротив."

# ch/lexi/events.rpy:858
translate russian lexi_start_e7726d57:
    "Поначалу она меня не замечает, слишком увлечена телефоном. Я, конечно, не особо выделяюсь, но всё же..."

# ch/lexi/events.rpy:859
translate russian lexi_start_bc614851:
    "Не терпится увидеть её реакцию, когда она поймёт, кто перед ней..."

# ch/lexi/events.rpy:860
translate russian lexi_start_65ee4a7b:
    "Спустя ещё несколько минут Лекси наконец закатывает глаза, цокает языком и откладывает телефон."

# ch/lexi/events.rpy:861
translate russian lexi_start_e71888d2:
    "Только тогда она поднимает взгляд, и её глаза мгновенно становятся круглыми как блюдца."

# ch/lexi/events.rpy:862
translate russian lexi_start_797895c5:
    mike.say "Снова привет."

# ch/lexi/events.rpy:863
translate russian lexi_start_083804b1:
    "О, как приятно. Увидеть на её лице вспышку тревоги, пусть мимолётную, невероятно приятно."

# ch/lexi/events.rpy:865
translate russian lexi_start_00627404:
    lexi.say "...Вот дерьмо..."

# ch/lexi/events.rpy:866
translate russian lexi_start_2fbbf891:
    mike.say "Именно что «вот дерьмо». Не думай, что я забыл о случившемся."

# ch/lexi/events.rpy:868
translate russian lexi_start_92fdfe0e:
    lexi.say "Успокойся, ничего личного."

# ch/lexi/events.rpy:869
translate russian lexi_start_fb8a0677:
    mike.say "Да? Ничего личного? Ну да, возможно. Это как раз понятно."

# ch/lexi/events.rpy:870
translate russian lexi_start_d7c4fbc7:
    mike.say "А вот чего я не понимаю, так это с чего ты вообще взяла, что можешь велеть мне успокоиться."

# ch/lexi/events.rpy:871
translate russian lexi_start_2e08ce37:
    mike.say "Напомню: вы оставили меня избитым и без денег. Блокировать все карты было не очень весело."

# ch/lexi/events.rpy:874
translate russian lexi_start_788d9597:
    mike.say "К счастью, я успел помешать вам зайти дальше, но приятного всё равно мало."

# ch/lexi/events.rpy:875
translate russian lexi_start_9e2a488d:
    "Лекси немного откидывается назад и вздыхает."

# ch/lexi/events.rpy:876
translate russian lexi_start_6dfe4ee7:
    lexi.say "Ну да... Дэнни тогда понял, что лучше отступить."

# ch/lexi/events.rpy:877
translate russian lexi_start_2ea7dc04:
    mike.say "Не сомневаюсь. Мудрое решение."

# ch/lexi/events.rpy:878
translate russian lexi_start_949e522a:
    "Приятно наконец почувствовать себя здесь главным."

# ch/lexi/events.rpy:880
translate russian lexi_start_5c6fa2f5:
    mike.say "Самое смешное, что после этого ты ещё пыталась мне позвонить."

# ch/lexi/events.rpy:881
translate russian lexi_start_942742cc:
    mike.say "Думала, я тебя прощу?"

# ch/lexi/events.rpy:883
translate russian lexi_start_71481d92:
    lexi.say "Слушай, понимаю, ты злишься из-за того случая, но всем ведь надо на что-то жить?"

# ch/lexi/events.rpy:884
translate russian lexi_start_9d791951:
    mike.say "Или можно, знаешь ли, найти работу."

# ch/lexi/events.rpy:885
translate russian lexi_start_de3a395e:
    lexi.say "У меня есть работа."

# ch/lexi/events.rpy:886
translate russian lexi_start_3d115132:
    mike.say "Какая же? Наркотой торговать?"

# ch/lexi/events.rpy:887
translate russian lexi_start_d8140e45:
    "Она резко наклоняется над столом и зло шипит сквозь зубы. Между ними поблёскивает пирсинг в языке."

# ch/lexi/events.rpy:889
translate russian lexi_start_5e3f49e7:
    lexi.say "Ты спятил?! Какого чёрта ты творишь?!"

# ch/lexi/events.rpy:890
translate russian lexi_start_0281b06e:
    mike.say "Может, собираюсь тебя сдать? По-моему, вполне заслуженно, учитывая всё, через что я из-за тебя прошёл."

# ch/lexi/events.rpy:891
translate russian lexi_start_5e9e2b61:
    lexi.say "Ладно, ладно, слушай!"

# ch/lexi/events.rpy:894
translate russian lexi_start_f78663e1:
    "Она наклоняется ближе, будто ей всё равно, что грудь почти вываливается из короткого топа."

# ch/lexi/events.rpy:895
translate russian lexi_start_807dfd8a:
    lexi.say "Либо это, либо грабежи. Выбор у меня небольшой, а так хоть меньше людей пострадает, верно?"

# ch/lexi/events.rpy:896
translate russian lexi_start_154fcc66:
    mike.say "В ближайшей перспективе, может быть..."

# ch/lexi/events.rpy:897
translate russian lexi_start_58341707:
    lexi.say "Именно. Так что будь помягче."

# ch/lexi/events.rpy:898
translate russian lexi_start_d9ff2cf9:
    "Я не тороплюсь, барабаню пальцами по столу и наблюдаю за её тревожным лицом."

# ch/lexi/events.rpy:899
translate russian lexi_start_4e1c0ca8:
    "Приятно держать все козыри в руках. В переулке преимущество было у неё, но теперь оно у меня."

# ch/lexi/events.rpy:900
translate russian lexi_start_890cab14:
    lexi.say "Ну? Пожалуйста, отпусти меня хотя бы на этот раз."

# ch/lexi/events.rpy:901
translate russian lexi_start_76a50fc8:
    mike.say "...С чего бы? Что мне с этого?"

# ch/lexi/events.rpy:902
translate russian lexi_start_aeb8034a:
    "Она колеблется, а уголки моих губ складываются в самодовольную улыбку."

# ch/lexi/events.rpy:903
translate russian lexi_start_7db706d7:
    mike.say "Ну же? Мне не терпится узнать, чем вознаградят все мои усилия."

# ch/lexi/events.rpy:905
translate russian lexi_start_deddc8c1:
    lexi.say "Это... ладно, хорошо. Я тебе отсосу."

# ch/lexi/events.rpy:906
translate russian lexi_start_c63179de:
    "Теперь удивляться моя очередь. От такого будничного предложения я чуть не падаю со стула."

# ch/lexi/events.rpy:907
translate russian lexi_start_d4f57ce9:
    mike.say "...Прости... что?"

# ch/lexi/events.rpy:908
translate russian lexi_start_e7fd68ac:
    lexi.say "Ты слышал. Пойдём в туалет, я тебе отсосу. Без проблем."

# ch/lexi/events.rpy:909
translate russian lexi_start_5d56f4ee:
    mike.say "Эм..."

# ch/lexi/events.rpy:910
translate russian lexi_start_0261db31:
    "Я теряю дар речи. Не знаю, что на это ответить."

# ch/lexi/events.rpy:911
translate russian lexi_start_5ee51cd4:
    "Можно согласиться, но... вдруг она опять мной воспользуется?"

# ch/lexi/events.rpy:912
translate russian lexi_start_8366a4c9:
    "Например, мне бы не хотелось, чтобы она что-нибудь у меня украла."

# ch/lexi/events.rpy:913
translate russian lexi_start_4f714633:
    "Но, наверное, если не терять бдительности, всё будет нормально."

# ch/lexi/events.rpy:914
translate russian lexi_start_7e55387f:
    "Я всего лишь хочу получить хоть какую-то компенсацию за то, что со мной случилось."

# ch/lexi/events.rpy:915
translate russian lexi_start_4e42cfb1:
    "Честно говоря... думаю, я это определённо заслужил..."

# ch/lexi/events.rpy:916
translate russian lexi_start_89073d0c:
    lexi.say "Ну? Ты согласен?"

# ch/lexi/events.rpy:919
translate russian lexi_start_03a51892:
    mike.say "...Ладно. Хорошо, пойдём."

# ch/lexi/events.rpy:920
translate russian lexi_start_566bf652:
    "Я встаю вместе с ней. Она крепко берёт меня за руку, и вот уже тащит за собой."

# ch/lexi/events.rpy:923
translate russian lexi_start_bd31ce37:
    mike.say "Отъебись!"

# ch/lexi/events.rpy:924
translate russian lexi_start_77d3baa3:
    "С отвращением я ухожу, оставив её здесь..."

# ch/lexi/events.rpy:928
translate russian lexi_start_b2c520d4:
    "Вообще-то подходить к ней напрямую — совершенно идиотская затея."

# ch/lexi/events.rpy:929
translate russian lexi_start_00b3886a:
    "Я не знаю, на что способна сама Лекси. А если опять откуда-нибудь вылезет Дэнни, мне конец."

# ch/lexi/events.rpy:930
translate russian lexi_start_bcf05320:
    "Гораздо лучше перестраховаться и сообщить кому-нибудь из персонала."

# ch/lexi/events.rpy:931
translate russian lexi_start_e67c3f6f:
    "Да, из двух вариантов этот менее крутой, но лучше так, чем снова нарваться на побои."

# ch/lexi/events.rpy:933
translate russian lexi_start_4b87e773:
    "Я смотрю на вход в клуб, выбирая, кому сообщить."

# ch/lexi/events.rpy:934
translate russian lexi_start_13479e8a:
    "Там стоит здоровенный вышибала. Думаю, даже такой бугай, как Дэнни, не стал бы с ним связываться."

# ch/lexi/events.rpy:935
translate russian lexi_start_1aa0a1b1:
    "Решившись, я уверенно направляюсь к нему. Если потом придётся отвечать за последствия, пусть так."

# ch/lexi/events.rpy:936
translate russian lexi_start_a9ff1cd0:
    "Главное, чтобы Лекси не могла так со мной поступить и уйти безнаказанной."

# ch/lexi/events.rpy:938
translate russian lexi_start_f3ed0f89:
    mike.say "Простите, сэр..."

# ch/lexi/events.rpy:940
translate russian lexi_start_5150e5cb:
    "Девушка" "Ой! Простите, простите!"

# ch/lexi/events.rpy:941
translate russian lexi_start_afc2eed3:
    "Я собираюсь заговорить с вышибалой, и он уже поворачивается ко мне, но тут раздаётся девичий голос."

# ch/lexi/events.rpy:944
translate russian lexi_start_c01e7e19:
    "Девушка" "Не обращайте на него внимания, ха-ха!"

# ch/lexi/events.rpy:945
translate russian lexi_start_855cc70a:
    "Вышибала" "Эм... вам чем-то помочь?"

# ch/lexi/events.rpy:951
translate russian lexi_start_293e8157:
    "Кто-то обхватывает мою руку. Я смотрю вниз: это Лекси, вцепившаяся в меня словно обкуренная коала."

# ch/lexi/events.rpy:952
translate russian lexi_start_9bd71dec:
    "Она приторно улыбается, и впервые я больше смотрю на её лицо, чем на грудь."

# ch/lexi/events.rpy:953
translate russian lexi_start_5e5a7f69:
    "Значит... это часть её плана?"

# ch/lexi/events.rpy:954
translate russian lexi_start_45f22904:
    "В голове складывается вполне правдоподобная картина. Она заметила меня из глубины зала и примчалась, чтобы не дать заговорить."

# ch/lexi/events.rpy:955
translate russian lexi_start_cba4c5df:
    "Похоже, она всё-таки оказалась на шаг впереди."

# ch/lexi/events.rpy:956
translate russian lexi_start_cb284d7e:
    mike.say "Привет... Лекси..."

# ch/lexi/events.rpy:957
translate russian lexi_start_b38dab0d:
    lexi.say "Привет, милый! Как я рада, что ты пришёл!"

# ch/lexi/events.rpy:958
translate russian lexi_start_40df7859:
    "Она ухмыляется, а я тяжело вздыхаю. Не знаю, что обиднее: то, что она изображает мою девушку..."

# ch/lexi/events.rpy:959
translate russian lexi_start_b19d287d:
    "Или то, что я просто это позволяю..."

# ch/lexi/events.rpy:960
translate russian lexi_start_cc85a8f3:
    "Вышибала" "Слушайте, у меня работа. Вы скажете, что хотели, или уйдёте?"

# ch/lexi/events.rpy:961
translate russian lexi_start_5ccf5f57:
    "Я медлю, чувствуя, как она ещё сильнее сжимает мою руку."

# ch/lexi/events.rpy:962
translate russian lexi_start_5845f36c:
    "Полагаю, это предупреждение."

# ch/lexi/events.rpy:963
translate russian lexi_start_0dd74973:
    mike.say "Эм... нет, это... ничего. Простите, что побеспокоил."

# ch/lexi/events.rpy:964
translate russian lexi_start_8e8f83d1:
    "Вышибала" "Как скажете."

# ch/lexi/events.rpy:968
translate russian lexi_start_577edd08:
    "Мы с Лекси отходим и не останавливаемся, пока не оказываемся в тихом углу клуба, где нас почти никто не видит."

# ch/lexi/events.rpy:971
translate russian lexi_start_74f96ea3:
    "Только тогда она отпускает меня и упирает руки в бока. В её глазах убийственный взгляд..."

# ch/lexi/events.rpy:972
translate russian lexi_start_4c9dedd6:
    lexi.say "Какого ЧЁРТА?"

# ch/lexi/events.rpy:973
translate russian lexi_start_dfd09dea:
    mike.say "Похоже, ты меня раскусила. Как и я тебя."

# ch/lexi/events.rpy:974
translate russian lexi_start_053e2d0e:
    lexi.say "Да отъебись... не твоё дело ко мне лезть!"

# ch/lexi/events.rpy:975
translate russian lexi_start_44913cdb:
    mike.say "Примерно как не ваше было дело лезть ко мне в тот вечер?"

# ch/lexi/events.rpy:976
translate russian lexi_start_edadec01:
    "Приятно наконец сказать ей это прямо. Ткнуть носом в то, что она натворила."

# ch/lexi/events.rpy:978
translate russian lexi_start_a671ecd0:
    mike.say "Помнишь, как твой парень избил меня, а потом вы бросили меня без денег?"

# ch/lexi/events.rpy:979
translate russian lexi_start_c56438dc:
    mike.say "Спорим, вы бы и одежду сняли, будь она чего-нибудь стоящей."

# ch/lexi/events.rpy:981
translate russian lexi_start_f2083c24:
    "Она вздыхает, опускает глаза и притоптывает ногой."

# ch/lexi/events.rpy:982
translate russian lexi_start_041e63ce:
    lexi.say "Да не злись ты так. Каждый крутится как умеет. Вот и я так кручусь."

# ch/lexi/events.rpy:983
translate russian lexi_start_37073d73:
    mike.say "Ясно."

# ch/lexi/events.rpy:984
translate russian lexi_start_81025479:
    "Ну и паршивый же способ она выбрала."

# ch/lexi/events.rpy:985
translate russian lexi_start_24014aaa:
    lexi.say "К тому же ты пытался пнуть его по яйцам. Думаешь, он бы это спустил?"

# ch/lexi/events.rpy:986
translate russian lexi_start_56ff7d6c:
    mike.say "Ну да, сам виноват, что защищался, верно?"

# ch/lexi/events.rpy:988
translate russian lexi_start_d3b81a78:
    lexi.say "...Просто отдал бы нам деньги, и тебя бы не тронули."

# ch/lexi/events.rpy:989
translate russian lexi_start_7433cce8:
    "Ну конечно. Железный аргумент."

# ch/lexi/events.rpy:990
translate russian lexi_start_8defe4fd:
    mike.say "Но тогда я бы не застукал тебя за торговлей наркотиками, правда, Лекси?"

# ch/lexi/events.rpy:992
translate russian lexi_start_f27b4c7e:
    mike.say "Просто чудо, что мне удалось выбраться из той передряги."

# ch/lexi/events.rpy:993
translate russian lexi_start_c539280b:
    lexi.say "Ага. Спасибо тебе, конечно, что отделал моего парня."

# ch/lexi/events.rpy:994
translate russian lexi_start_373a933e:
    "Она злобно хмурится. Я лишь цокаю языком."

# ch/lexi/events.rpy:995
translate russian lexi_start_a0b7915c:
    mike.say "У меня была веская причина. Он угрожал меня убить!"

# ch/lexi/events.rpy:996
translate russian lexi_start_d31ef408:
    lexi.say "Да он бы не стал! Чёрт, за кого ты нас принимаешь?"

# ch/lexi/events.rpy:997
translate russian lexi_start_15dfcb59:
    "Я бесстрастно смотрю на неё."

# ch/lexi/events.rpy:998
translate russian lexi_start_4b4bffe4:
    mike.say "За мразей."

# ch/lexi/events.rpy:1000
translate russian lexi_start_57affcd5:
    "Какой там Дэнни: за эти слова она сама готова меня убить."

# ch/lexi/events.rpy:1001
translate russian lexi_start_4d4c0738:
    lexi.say "Ты бы лучше заткнулся!"

# ch/lexi/events.rpy:1002
translate russian lexi_start_aedfaff5:
    mike.say "А ты бы лучше перестала продавать людям наркотики."

# ch/lexi/events.rpy:1003
translate russian lexi_start_5a63fe80:
    lexi.say "—!"

# ch/lexi/events.rpy:1005
translate russian lexi_start_f44fc4ed:
    "Она замолкает. Что бы ни собиралась сказать дальше, теперь передумала."

# ch/lexi/events.rpy:1006
translate russian lexi_start_46e88674:
    "Приятно видеть, как она наконец молчит."

# ch/lexi/events.rpy:1007
translate russian lexi_start_53c7a517:
    "Любопытный расклад. Я отчётливо вижу, насколько ей не по себе."

# ch/lexi/events.rpy:1008
translate russian lexi_start_59e6da51:
    "В тот вечер в ужасно невыгодном положении был я. Теперь всё перевернулось, и я этому только рад."

# ch/lexi/events.rpy:1009
translate russian lexi_start_dcdcbeb1:
    mike.say "Вот именно. Хорошенько обдумай следующий шаг, потому что я не побоюсь кому-нибудь рассказать."

# ch/lexi/events.rpy:1011
translate russian lexi_start_d3a39870:
    lexi.say "Ладно! Ладно-ладно, давай просто... не будем торопиться..."

# ch/lexi/events.rpy:1012
translate russian lexi_start_c3ae43ac:
    mike.say "Не торопиться? Зачем?"

# ch/lexi/events.rpy:1013
translate russian lexi_start_6503a840:
    mike.say "Я могу закончить начатое и сказать вышибале то, что собирался."

# ch/lexi/events.rpy:1014
translate russian lexi_start_b7e7d842:
    "В её глазах вспыхивает злость, но она, кажется, уговаривает себя сохранять спокойствие."

# ch/lexi/events.rpy:1016
translate russian lexi_start_4a6da74e:
    "Наверное, ей самой выгоднее держать себя в руках."

# ch/lexi/events.rpy:1017
translate russian lexi_start_8e486b8a:
    lexi.say "...Ты меня погубишь. У меня и так выбор небольшой, ну хватит!"

# ch/lexi/events.rpy:1018
translate russian lexi_start_a3e863d5:
    mike.say "Что ты имеешь в виду?"

# ch/lexi/events.rpy:1020
translate russian lexi_start_04074e53:
    lexi.say "Я... ну... ты на меня посмотри..."

# ch/lexi/events.rpy:1022
translate russian lexi_start_3b6d034e:
    "Глядя на меня, она проводит руками от груди к невероятно короткой юбке, ещё сильнее подчёркивая свои формы."

# ch/lexi/events.rpy:1023
translate russian lexi_start_77e84a1c:
    lexi.say "На собеседовании на меня разок глянут и сразу вышвырнут за дверь."

# ch/lexi/events.rpy:1024
translate russian lexi_start_b7a19808:
    lexi.say "Даже если захочу устроиться на работу, меня всё равно не возьмут."

# ch/lexi/events.rpy:1025
translate russian lexi_start_cdd0848d:
    "Признаю, я отчасти понимаю её довод. Хотя, наверное, смотря куда."

# ch/lexi/events.rpy:1027
translate russian lexi_start_fc9b1ec2:
    lexi.say "Зато своим телом я могу приманивать таких лохов, как ты, и быстро зарабатывать с помощью Дэнни."

# ch/lexi/events.rpy:1028
translate russian lexi_start_5ef90666:
    mike.say "Да. Теперь я это прекрасно знаю."

# ch/lexi/events.rpy:1029
translate russian lexi_start_34009366:
    "Пусть тогда я был слегка пьян, всё равно чувствую себя идиотом, что повёлся."

# ch/lexi/events.rpy:1030
translate russian lexi_start_32e2ba8f:
    lexi.say "А если... не хочу обманывать людей, приходится заниматься чем-то таким. Не отсвечивать."

# ch/lexi/events.rpy:1031
translate russian lexi_start_2160fdcc:
    mike.say "Если ты пытаешься вызвать у меня жалость..."

# ch/lexi/events.rpy:1033
translate russian lexi_start_ba1e191c:
    lexi.say "Не пытаюсь! Но ты разве не понимаешь? Приходится так жить."

# ch/lexi/events.rpy:1034
translate russian lexi_start_5f0c0e78:
    "Приходится так жить?"

# ch/lexi/events.rpy:1035
translate russian lexi_start_84881140:
    "Если бы она не одевалась буквально как шлюха, то, может, и нашла бы приличную работу."

# ch/lexi/events.rpy:1036
translate russian lexi_start_17ccd694:
    "Я понимаю, что одежда девушки не должна ничего решать, но... не могу представить Лекси за офисной перегородкой."

# ch/lexi/events.rpy:1037
translate russian lexi_start_1b7b0217:
    "Мне кажется, в таком месте она бы всё равно сошла с ума."

# ch/lexi/events.rpy:1038
translate russian lexi_start_d2e6eb49:
    mike.say "Ты правда настолько хочешь сохранить это в тайне?"

# ch/lexi/events.rpy:1039
translate russian lexi_start_cad1d920:
    lexi.say "Конечно! Иначе сяду в тюрьму."

# ch/lexi/events.rpy:1040
translate russian lexi_start_e47538b1:
    "А вот там я вполне могу её представить."

# ch/lexi/events.rpy:1041
translate russian lexi_start_827bff3f:
    lexi.say "Пожалуйста... я дам тебе кое-что взамен, если ты никому не расскажешь."

# ch/lexi/events.rpy:1042
translate russian lexi_start_b9f45aba:
    "От этого предложения я немного оживляюсь."

# ch/lexi/events.rpy:1043
translate russian lexi_start_430c14cd:
    mike.say "И когда ты говоришь «кое-что»... то имеешь в виду... что именно?"

# ch/lexi/events.rpy:1045
translate russian lexi_start_d9682d1b:
    "Её взгляд тут же становится томным."

# ch/lexi/events.rpy:1046
translate russian lexi_start_1bb691ba:
    lexi.say "Как насчёт того, чтобы я тебе отсосала здесь, в туалете? Тебе понравится, поверь. Я в этом хороша."

# ch/lexi/events.rpy:1047
translate russian lexi_start_99c5aed8:
    "Слышать от неё «поверь» просто смешно, но предложение всё равно меня привлекает..."

# ch/lexi/events.rpy:1050
translate russian lexi_start_2c65f5e6:
    "И вот я уже киваю. Соглашаюсь."

# ch/lexi/events.rpy:1051
translate russian lexi_start_a6a08ac1:
    "Может, мне и правда этого хочется."

# ch/lexi/events.rpy:1054
translate russian lexi_start_bd31ce37_1:
    mike.say "Отъебись!"

# ch/lexi/events.rpy:1055
translate russian lexi_start_77d3baa3_1:
    "С отвращением я ухожу, оставив её здесь..."

# ch/lexi/events.rpy:1059
translate russian lexi_start_56fa3b69:
    "Мы незаметно уходим в один из туалетов, и она сразу затаскивает меня в дальнюю кабинку."

# ch/lexi/events.rpy:1060
translate russian lexi_start_02be2d71:
    "Не слишком изысканно, но хотя бы чисто. И на том спасибо."

# ch/lexi/events.rpy:1062
translate russian lexi_start_999ac4a8:
    lexi.say "Ладно, прежде чем начнём, пообещай. Мы должны договориться."

# ch/lexi/events.rpy:1063
translate russian lexi_start_3ac3ff1d:
    "Я колеблюсь и насторожённо смотрю на неё, пока она не продолжает."

# ch/lexi/events.rpy:1064
translate russian lexi_start_60eb484b:
    lexi.say "Ты никому не расскажешь, ясно? Ни единой душе, иначе, клянусь, я взбешусь!"

# ch/lexi/events.rpy:1065
translate russian lexi_start_b9789940:
    "Я несколько раз моргаю, потом просто киваю."

# ch/lexi/events.rpy:1066
translate russian lexi_start_9c384e07:
    mike.say "Хорошо, ладно, без проблем."

# ch/lexi/events.rpy:1067
translate russian lexi_start_c612dd36:
    "Она, конечно, многого просит, но... за молчание я всё-таки кое-что получаю."

# ch/lexi/events.rpy:1069
translate russian lexi_start_adc684a1:
    lexi.say "Тогда по рукам."

# ch/lexi/events.rpy:1070
translate russian lexi_start_efacdc7b:
    "Она протягивает руку, и я пожимаю её. Впервые мы по-настоящему касаемся друг друга."

# ch/lexi/events.rpy:1071
translate russian lexi_start_58ec2a17:
    "Надо признать, приятно. Но мы здесь не ради этого."

# ch/lexi/events.rpy:1073
translate russian lexi_start_8fc3fdb6:
    "Едва я отпускаю её руку, она опускается на колени и тянется к моему ремню."

# ch/lexi/events.rpy:1074
translate russian lexi_start_9f73f228:
    "Её пальцы ловко расстёгивают его, и вскоре она уже достаёт мой член из боксёров."

# ch/lexi/events.rpy:1075
translate russian lexi_start_5d1c2462:
    "Я прислоняюсь к стенке кабинки и задерживаю дыхание, словно готовясь к чему-то."

# ch/lexi/events.rpy:1076
translate russian lexi_start_b9d68e7d:
    "Мне не терпится, но я и немного боюсь."

# ch/lexi/events.rpy:1077
translate russian lexi_start_3e18a8df:
    "Может, потому, что это впервые... да и раньше она меня изрядно подставила..."

# ch/lexi/events.rpy:1080
translate russian lexi_start_ee1dab3b:
    "Но стоит её губам обхватить головку, как по телу пробегает удовольствие."

# ch/lexi/events.rpy:1081
translate russian lexi_start_5a047299:
    "Очень приятно. Всё только началось, а я уже втягиваюсь."

# ch/lexi/events.rpy:1082
translate russian lexi_start_753ed921:
    lexi.say "М-м..."

# ch/lexi/events.rpy:1083
translate russian lexi_start_e39fca73:
    "Она стонет, и я тоже, запрокидывая голову и закрывая глаза."

# ch/lexi/events.rpy:1085
translate russian lexi_start_876ef9ce:
    "Её рот скользит ближе к основанию члена. Честно говоря, я удивлён, как глубоко она может его взять."

# ch/lexi/events.rpy:1086
translate russian lexi_start_280bb335:
    "Хотя я только рад."

# ch/lexi/events.rpy:1087
translate russian lexi_start_e4fb1f2d:
    mike.say "Блядь..."

# ch/lexi/events.rpy:1089
translate russian lexi_start_b0b94b98:
    "Слово вырывается само собой. Она сосёт ещё сильнее."

# ch/lexi/events.rpy:1090
translate russian lexi_start_10a58394:
    "Ощущения безумно приятные. Ноги дрожат, я прикусываю губу, а она ускоряет темп."

# ch/lexi/events.rpy:1091
translate russian lexi_start_d533e254:
    "Лекси сосёт всё быстрее и наконец отстраняется от члена как раз перед тем, как я кончаю."

# ch/lexi/events.rpy:1097
translate russian lexi_start_b54e6ad1:
    "Поддавшись порыву, я хватаю её за волосы и не даю поймать сперму ртом, покрывая ею лицо."

# ch/lexi/events.rpy:1099
translate russian lexi_start_2c3cd929:
    lexi.say "Эй!!!"

# ch/lexi/events.rpy:1101
translate russian lexi_start_9cb21294:
    lexi.say "Блядь, ты мне макияж испортил, придурок!"

# ch/lexi/events.rpy:1102
translate russian lexi_start_3ef5eccd:
    mike.say "Так тебе и надо."

# ch/lexi/events.rpy:1104
translate russian lexi_start_1200ce33:
    "Мы какое-то время смотрим друг на друга, но я слишком вымотан, чтобы испытывать неловкость."

# ch/lexi/events.rpy:1105
translate russian lexi_start_f84945a7:
    "Затем Лекси встаёт и вытирает лицо тыльной стороной ладони."

# ch/lexi/events.rpy:1113
translate russian lexi_start_2b1fb4a0:
    "Она ловко ловит всё языком..."

# ch/lexi/events.rpy:1115
translate russian lexi_start_11075f2d:
    "Потом, словно хвастаясь, показывает мне рот, полный моей спермы..."

# ch/lexi/events.rpy:1117
translate russian lexi_start_818d66c0:
    "...и всё проглатывает..."

# ch/lexi/events.rpy:1120
translate russian lexi_start_7ff76383:
    mike.say "Блядь, ни одна девушка ещё не делала со мной ничего настолько развратного."

# ch/lexi/events.rpy:1121
translate russian lexi_start_fd9ed7e8:
    lexi.say "Спасибо."

# ch/lexi/events.rpy:1122
translate russian lexi_start_1200ce33_1:
    "Мы какое-то время смотрим друг на друга, но я слишком вымотан, чтобы испытывать неловкость."

# ch/lexi/events.rpy:1123
translate russian lexi_start_e48e17ba:
    "Затем Лекси встаёт и вытирает рот тыльной стороной ладони."

# ch/lexi/events.rpy:1128
translate russian lexi_start_28b2d389:
    "Я решаю пойти до конца и хватаю её за волосы."

# ch/lexi/events.rpy:1130
translate russian lexi_start_e09754b7:
    "Притягиваю её голову, насильно погружая член ей в горло..."

# ch/lexi/events.rpy:1134
translate russian lexi_start_23956ea0:
    "И кончаю глубоко ей в рот."

# ch/lexi/events.rpy:1136
translate russian lexi_start_0d20a6ef:
    "Она поднимает на меня полные слёз глаза."

# ch/lexi/events.rpy:1138
translate russian lexi_start_1200ce33_2:
    "Мы какое-то время смотрим друг на друга, но я слишком вымотан, чтобы испытывать неловкость."

# ch/lexi/events.rpy:1139
translate russian lexi_start_e48e17ba_1:
    "Затем Лекси встаёт и вытирает рот тыльной стороной ладони."

# ch/lexi/events.rpy:1144
translate russian lexi_start_db9e60a9:
    lexi.say "Ну что, закончили?"

# ch/lexi/events.rpy:1145
translate russian lexi_start_ac0a0054:
    "Я вытираю лоб рукавом, затем киваю и подтягиваю штаны."

# ch/lexi/events.rpy:1146
translate russian lexi_start_ac99cf0c:
    mike.say "Похоже на то."

# ch/lexi/events.rpy:1148
translate russian lexi_start_2b35515d:
    lexi.say "Отлично! Рада, что разобрались."

# ch/lexi/events.rpy:1149
translate russian lexi_start_767e4f3e:
    "Честно говоря, во мне смешалась целая куча чувств."

# ch/lexi/events.rpy:1150
translate russian lexi_start_36f799f8:
    "С одной стороны, было чертовски хорошо, и этого не отрицать. Она явно знает своё дело."

# ch/lexi/events.rpy:1151
translate russian lexi_start_dac57513:
    "С другой... кажется, она всё-таки слишком легко отделалась."

# ch/lexi/events.rpy:1152
translate russian lexi_start_0932c6e0:
    "Но мы ведь ударили по рукам, и нарушить обещание было бы свинством."

# ch/lexi/events.rpy:1153
translate russian lexi_start_0b3675ab:
    mike.say "Да, ладно."

# ch/lexi/events.rpy:1155
translate russian lexi_start_02989b9f:
    lexi.say "Эй, не грусти, милый. Я дала тебе то, что ты хотел."

# ch/lexi/events.rpy:1156
translate russian lexi_start_b1a6f610:
    mike.say "Да, верно."

# ch/lexi/events.rpy:1158
translate russian lexi_start_5338103d:
    "Она ухмыляется, будто ничего не случилось. Определённо ей всё далось слишком легко."

# ch/lexi/events.rpy:1159
translate russian lexi_start_e005480b:
    lexi.say "Ага. Этот вечер ты запомнишь."

# ch/lexi/events.rpy:1163
translate russian lexi_start_111ef6fb:
    "Она оставляет меня одного, и я вздыхаю."

# ch/lexi/events.rpy:1164
translate russian lexi_start_6bbfebba:
    "Рука словно сама тянется к карману. И, как я и подозревал... она его забрала."

# ch/lexi/events.rpy:1165
translate russian lexi_start_8deda643:
    "Мой бумажник."

# ch/lexi/events.rpy:1166
translate russian lexi_start_26feabee:
    mike.say "...Чёрт."

# ch/lexi/events.rpy:1171
translate russian lexi_event_02_47c96839:
    "Когда телефон вибрирует и на экране появляется «Неизвестный номер», я почему-то сразу знаю, кто звонит. Лекси. Без сомнений."

# ch/lexi/events.rpy:1184
translate russian lexi_event_02_33c449e6:
    "И оказываюсь прав."

# ch/lexi/events.rpy:1185
translate russian lexi_event_02_7a4f1fb4:
    mike.say "Ну и наглость — звонить мне после того, как ты меня обокрала."

# ch/lexi/events.rpy:1186
translate russian lexi_event_02_e95854e2:
    lexi.say "Ой, бедняжка. Я хотя бы позвонила, да?"

# ch/lexi/events.rpy:1187
translate russian lexi_event_02_62dae232:
    mike.say "Ага, а я как раз занимаюсь блокировкой своих кредиток..."

# ch/lexi/events.rpy:1188
translate russian lexi_event_02_59a8518e:
    mike.say "...Так что развлекайся."

# ch/lexi/events.rpy:1189
translate russian lexi_event_02_76eb7076:
    lexi.say "Слушай, будешь ты их блокировать или нет — без разницы. Я ими не пользовалась."

# ch/lexi/events.rpy:1190
translate russian lexi_event_02_371b8676:
    mike.say "..."

# ch/lexi/events.rpy:1191
translate russian lexi_event_02_e7640ad3:
    "От этих слов я замолкаю. Ничего не понимаю: зачем красть бумажник, если она не собирается опустошить мой счёт?"

# ch/lexi/events.rpy:1192
translate russian lexi_event_02_d33d9491:
    mike.say "...Что такое, испугалась попасться?"

# ch/lexi/events.rpy:1193
translate russian lexi_event_02_c2496c63:
    lexi.say "Я ничего не боюсь! Просто... передумала."

# ch/lexi/events.rpy:1194
translate russian lexi_event_02_c0704285:
    mike.say "Как благородно. Внезапно проснулась совесть."

# ch/lexi/events.rpy:1195
translate russian lexi_event_02_e8a7b3fa:
    lexi.say "Я не плохой человек."

# ch/lexi/events.rpy:1196
translate russian lexi_event_02_ba6be8dd:
    mike.say "Ага. Просто распутная наркоторго..."

# ch/lexi/events.rpy:1197
translate russian lexi_event_02_a6732b15:
    lexi.say "ЭЙ."

# ch/lexi/events.rpy:1198
translate russian lexi_event_02_e9cb6bcc:
    "По её тону понятно, что она вдруг стала совершенно серьёзной. Я даже немного вздрагиваю."

# ch/lexi/events.rpy:1199
translate russian lexi_event_02_b7efc4b0:
    mike.say "...Что?"

# ch/lexi/events.rpy:1200
translate russian lexi_event_02_fd84f31d:
    lexi.say "Не. Называй. Меня. Шлюхой."

# ch/lexi/events.rpy:1201
translate russian lexi_event_02_47124955:
    mike.say "Ладно, ладно."

# ch/lexi/events.rpy:1202
translate russian lexi_event_02_b9074b72:
    lexi.say "И про наркоту мы договорились забыть, когда я тебе отсосала."

# ch/lexi/events.rpy:1203
translate russian lexi_event_02_69a42019:
    mike.say "Это было до того, как ты украла мой бумажник."

# ch/lexi/events.rpy:1204
translate russian lexi_event_02_d6777f60:
    lexi.say "И что, теперь затаил обиду?"

# ch/lexi/events.rpy:1205
translate russian lexi_event_02_cce1edf9:
    mike.say "Да, и вполне заслуженно, не находишь?"

# ch/lexi/events.rpy:1206
translate russian lexi_event_02_b3931d2c:
    lexi.say "..."

# ch/lexi/events.rpy:1207
translate russian lexi_event_02_4fb245af:
    "На том конце повисает долгая пауза. Похоже, тут ей нечего возразить."

# ch/lexi/events.rpy:1208
translate russian lexi_event_02_5bcd5176:
    lexi.say "...Можешь хотя бы... разрешить мне зайти?"

# ch/lexi/events.rpy:1209
translate russian lexi_event_02_fef58e7c:
    mike.say "Прости?"

# ch/lexi/events.rpy:1210
translate russian lexi_event_02_90e81aeb:
    lexi.say "Я теперь знаю твой адрес. Он есть у тебя в бумажнике."

# ch/lexi/events.rpy:1211
translate russian lexi_event_02_ee8bff8a:
    "Блядь! Теперь она, похоже, знает обо мне слишком много."

# ch/lexi/events.rpy:1212
translate russian lexi_event_02_c08c5692:
    mike.say "С чего бы мне... пускать тебя к себе домой?"

# ch/lexi/events.rpy:1213
translate russian lexi_event_02_ceae62bf:
    lexi.say "Ну... чтобы я вернула бумажник."

# ch/lexi/events.rpy:1214
translate russian lexi_event_02_49f9bbd2:
    mike.say "Какого чёрта? Ты серьёзно?"

# ch/lexi/events.rpy:1215
translate russian lexi_event_02_5c29e221:
    lexi.say "Серьёзно. И отказать мне не можешь."

# ch/lexi/events.rpy:1216
translate russian lexi_event_02_8bbccd33:
    mike.say "...Это ещё почему?"

# ch/lexi/events.rpy:1217
translate russian lexi_event_02_06a6dff7:
    lexi.say "Ха! Потому что я уже здесь!"

# ch/lexi/events.rpy:1218
translate russian lexi_event_02_8e808ae5:
    "Сначала я не понимаю. Потом складываю два и два."

# ch/lexi/events.rpy:1219
translate russian lexi_event_02_fb68bd86:
    mike.say "...Ты ведь шутишь?"

# ch/lexi/events.rpy:1220
translate russian lexi_event_02_3bc2dee1:
    lexi.say "Тупиковая улица для богачей... дурацкий коврик с надписью «УХОДИ»? Ничего не напоминает, придурок?"

# ch/lexi/events.rpy:1221
translate russian lexi_event_02_fd1739c3:
    lexi.say "Выгляни в чёртово окно."

# ch/lexi/events.rpy:1222
translate russian lexi_event_02_817741e2:
    mike.say "Очаровательно. Ладно..."

# ch/lexi/events.rpy:1223
translate russian lexi_event_02_897e5bc9:
    "Я так и делаю: смотрю в окно и вижу её на улице."

# ch/lexi/events.rpy:1224
translate russian lexi_event_02_60148f35:
    "Топ, который сойдёт за лифчик, до смешного короткие шорты и выглядывающие по бокам стринги."

# ch/lexi/events.rpy:1225
translate russian lexi_event_02_845f35d9:
    "Да. Определённо Лекси."

# ch/lexi/events.rpy:1226
translate russian lexi_event_02_c9ffb868:
    "Она замечает меня, машет телефоном и расплывается в нахальной ухмылке."

# ch/lexi/events.rpy:1227
translate russian lexi_event_02_e6852be9:
    mike.say "...Сейчас выйду."

# ch/lexi/events.rpy:1233
translate russian lexi_event_02_1f260247:
    "С досадой я иду к входной двери и впускаю её."

# ch/lexi/events.rpy:1235
translate russian lexi_event_02_9b5ac5c0:
    "Я хмуро веду её на кухню и прислоняюсь к островку, мысленно готовясь к тому, что она опять начнёт спорить."

# ch/lexi/events.rpy:1237
translate russian lexi_event_02_f2417b46:
    lexi.say "О-о, значит, ты достаточно богат, чтобы позволить себе дом? Может, всё-таки стоило воспользоваться твоими карточками..."

# ch/lexi/events.rpy:1239
translate russian lexi_event_02_38c7bcab:
    mike.say "Кхм."

# ch/lexi/events.rpy:1240
translate russian lexi_event_02_c351db5d:
    mike.say "Отдавай."

# ch/lexi/events.rpy:1242
translate russian lexi_event_02_a0822f8e:
    lexi.say "Ха. Ладно, расслабься..."

# ch/lexi/events.rpy:1244
translate russian lexi_event_02_56dbfdbb:
    "Она действительно отдаёт бумажник, и я с облегчением забираю его. Хотя бы одной проблемой меньше."

# ch/lexi/events.rpy:1246
translate russian lexi_event_02_800e45e4:
    mike.say "Вроде всё на месте."

# ch/lexi/events.rpy:1248
translate russian lexi_event_02_fb3fa314:
    lexi.say "Разве я бы тебе соврала?"

# ch/lexi/events.rpy:1250
translate russian lexi_event_02_ac9abf0c:
    mike.say "Да. На все 100%% — да."

# ch/lexi/events.rpy:1252
translate russian lexi_event_02_12fb2488:
    lexi.say "Ну, ты всё равно его получил. Значит... теперь между нами без обид?"

# ch/lexi/events.rpy:1254
translate russian lexi_event_02_9867d56c:
    "Я тяжело вздыхаю. Она что, живёт в своём мире? Почему думает, что теперь всё вдруг станет хорошо?"

# ch/lexi/events.rpy:1255
translate russian lexi_event_02_028dd95e:
    mike.say "...Ты пришла ещё зачем-то?"

# ch/lexi/events.rpy:1257
translate russian lexi_event_02_d961107c:
    "Я уже готов стукнуться лбом о столешницу, но её искренний взгляд сбивает меня с толку. Она выглядит... грустной? Лишь мгновение, но я это замечаю."

# ch/lexi/events.rpy:1259
translate russian lexi_event_02_8d837b73:
    lexi.say "Ну, я... хотела кое-что объяснить. Понимаешь, я не хочу творить такую хрень. Просто приходится."

# ch/lexi/events.rpy:1261
translate russian lexi_event_02_1b13ce1f:
    mike.say "Под «хренью» ты, полагаю, имеешь в виду ограбления?"

# ch/lexi/events.rpy:1263
translate russian lexi_event_02_7d2cfaf6:
    lexi.say "И наркотики тоже..."

# ch/lexi/events.rpy:1265
translate russian lexi_event_02_177441b3:
    mike.say "Я думал, мы об этом не говорим."

# ch/lexi/events.rpy:1267
translate russian lexi_event_02_45a3d601:
    lexi.say "И не говорим! Но..."

# ch/lexi/events.rpy:1269
translate russian lexi_event_02_56c2f84f:
    "Краткая вспышка возмущения снова гаснет, и она словно ещё сильнее съёживается."

# ch/lexi/events.rpy:1270
translate russian lexi_event_02_ae20009a:
    mike.say "...Просто сядь. Хочешь чего-нибудь выпить?"

# ch/lexi/events.rpy:1272
translate russian lexi_event_02_68fbd48d:
    lexi.say "Ага. Есть что покрепче?"

# ch/lexi/events.rpy:1274
translate russian lexi_event_02_d04b4b51:
    "Она тут же разваливается на диване, забравшись на него прямо в сапогах, и я гадаю, не совершил ли огромную ошибку."

# ch/lexi/events.rpy:1275
translate russian lexi_event_02_b43abca3:
    mike.say "Сейчас посмотрю."

# ch/lexi/events.rpy:1277
translate russian lexi_event_02_4c2a7615:
    "Вскоре я наливаю нам вина. Она смеётся, берёт бокал и разглядывает его."

# ch/lexi/events.rpy:1279
translate russian lexi_event_02_79c123d5:
    lexi.say "Ого. Ты и правда мажор."

# ch/lexi/events.rpy:1281
translate russian lexi_event_02_c82d1ac9:
    mike.say "Почему? Потому что у меня хороший дом, на который я заработал, и я пью вино?"

# ch/lexi/events.rpy:1283
translate russian lexi_event_02_676b1564:
    lexi.say "Да забей. В общем... откуда у тебя деньги на такую жизнь?"

# ch/lexi/events.rpy:1285
translate russian lexi_event_02_9db32ff0:
    mike.say "Ну... я заработал, как и все. Кроме тебя, видимо. Ты ведь любишь лёгкие пути?"

# ch/lexi/events.rpy:1287
translate russian lexi_event_02_ee661368:
    "Она морщится."

# ch/lexi/events.rpy:1289
translate russian lexi_event_02_c17326fd:
    lexi.say "Я же сказала, у меня нет выбора. Так что..."

# ch/lexi/events.rpy:1291
translate russian lexi_event_02_69e09123:
    "Она снова замолкает и сосредотачивается на выпивке. Между нами повисает неловкость."

# ch/lexi/events.rpy:1293
translate russian lexi_event_02_3229b9da:
    lexi.say "...Просто... у меня нет выбора."

# ch/lexi/events.rpy:1295
translate russian lexi_event_02_7d0ecafe:
    mike.say "У людей ведь есть свобода воли? Почему ты не можешь решать за себя?"

# ch/lexi/events.rpy:1299
translate russian lexi_event_02_d53d27b0:
    lexi.say "Потому что!"

# ch/lexi/events.rpy:1300
translate russian lexi_event_02_50944d53:
    "Она резко поворачивает ко мне голову."

# ch/lexi/events.rpy:1302
translate russian lexi_event_02_29a7b4a9:
    lexi.say "Я кое-кому должна, так что всё не так просто!"

# ch/lexi/events.rpy:1304
translate russian lexi_event_02_78190b7f:
    mike.say "Кому?"

# ch/lexi/events.rpy:1306
translate russian lexi_event_02_81ba95c3:
    lexi.say "...Помнишь того здоровяка, который чуть не убил тебя в переулке? Дэнни? Моего парня?"

# ch/lexi/events.rpy:1308
translate russian lexi_event_02_98e6f778:
    mike.say "Да, такого трудно забыть."

# ch/lexi/events.rpy:1310
translate russian lexi_event_02_b6313643:
    lexi.say "Ну, он бандит. Я должна ему, вернее, всей его банде, так что приходится... слушаться, иначе..."

# ch/lexi/events.rpy:1312
translate russian lexi_event_02_68b54004:
    "По тому, как она обрывает фразу, я решаю не расспрашивать дальше."

# ch/lexi/events.rpy:1313
translate russian lexi_event_02_ad8d1d4f:
    mike.say "Ясно... и поэтому ты всё это делаешь?"

# ch/lexi/events.rpy:1315
translate russian lexi_event_02_d6ed37d6:
    lexi.say "...В общем, да. Я уже заебалась."

# ch/lexi/events.rpy:1317
translate russian lexi_event_02_6ef2957d:
    "Она залпом допивает вино и с силой ставит бокал. Я морщусь."

# ch/lexi/events.rpy:1318
translate russian lexi_event_02_6e1be806:
    mike.say "Это не стопка, Лекси. Мне жаль, что ты в такой ситуации, но..."

# ch/lexi/events.rpy:1319
translate russian lexi_event_02_900f2ad6:
    mike.say "...Это не меняет того, что ты уже сделала."

# ch/lexi/events.rpy:1321
translate russian lexi_event_02_b1becf12:
    lexi.say "Да, я поняла, я дрянь. Расслабься."

# ch/lexi/events.rpy:1322
translate russian lexi_event_02_faef390f:
    lexi.say "Зато теперь ты знаешь, почему я этим занимаюсь."

# ch/lexi/events.rpy:1324
translate russian lexi_event_02_371b8676_1:
    mike.say "..."

# ch/lexi/events.rpy:1325
translate russian lexi_event_02_b62d80e9:
    "Обдумав всё, я не могу по-настоящему на неё злиться. Легко просто во всём её обвинить, но... у неё, видимо, были причины."

# ch/lexi/events.rpy:1326
translate russian lexi_event_02_1b4833f5:
    mike.say "Хорошо... ладно."

# ch/lexi/events.rpy:1328
translate russian lexi_event_02_22e3bca9:
    "Она с надеждой поднимает глаза, и я окончательно сдаюсь."

# ch/lexi/events.rpy:1329
translate russian lexi_event_02_309c2d48:
    mike.say "Можем оставить прошлое в прошлом и... двигаться дальше."

# ch/lexi/events.rpy:1331
translate russian lexi_event_02_fe8f8d44:
    lexi.say "Правда?!"

# ch/lexi/events.rpy:1333
translate russian lexi_event_02_4b55ae24:
    mike.say "Да, правда. Только... больше ничего такого не выкидывай, пожалуйста."

# ch/lexi/events.rpy:1335
translate russian lexi_event_02_4788e558:
    lexi.say "Договорились. Спасибо, что выслушал."

# ch/lexi/events.rpy:1337
translate russian lexi_event_02_cf12b22a:
    "Меня удивляет её доброта и открытость. Конечно, это может быть обманом, но я всё равно ей верю. К тому же, когда она не стервозничает, она очень привлекательна."

# ch/lexi/events.rpy:1340
translate russian lexi_event_02_da2b9ed0:
    lexi.say "Хм... эй, ого!"

# ch/lexi/events.rpy:1342
translate russian lexi_event_02_6a72b8a3:
    "Когда она поворачивается к раздвижным стеклянным дверям, что-то привлекает её внимание."

# ch/lexi/events.rpy:1344
translate russian lexi_event_02_de138dad:
    "Думаю, она заметила бассейн. Несколько минут назад там включилась подсветка."

# ch/lexi/events.rpy:1347
translate russian lexi_event_02_f3811a2e:
    lexi.say "У тебя есть бассейн?!"

# ch/lexi/events.rpy:1349
translate russian lexi_event_02_41665fe9:
    mike.say "Да, эм... был вместе с домом. Может, его надо почистить, давно не пользовался."

# ch/lexi/events.rpy:1351
translate russian lexi_event_02_61225b3d:
    "Эта ложь её не смущает. Она бросается к дверям и раздвигает их с грохотом. Я морщусь. Она вообще умеет обращаться с чужими вещами?"

# ch/lexi/events.rpy:1352
translate russian lexi_event_02_e68e5130:
    mike.say "Лекси, постой!"

# ch/lexi/events.rpy:1356
translate russian lexi_event_02_cfd705db:
    "Я спешу за ней через открытую дверь. Она уже стоит у бассейна и с восторгом смотрит в воду."

# ch/lexi/events.rpy:1358
translate russian lexi_event_02_47ab0c78:
    "И... снимает одежду. Её и так немного, так что скоро по моему саду будет разгуливать голая девица."

# ch/lexi/events.rpy:1359
translate russian lexi_event_02_c2f589d2:
    mike.say "Лекси, можешь хоть минутку подождать?!"

# ch/lexi/events.rpy:1361
translate russian lexi_event_02_4e56109c:
    "Она по-прежнему меня не слушает: снимает лифчик и трусики и не слишком грациозно ныряет в воду."

# ch/lexi/events.rpy:1364
translate russian lexi_event_02_ea2aa77b:
    "За то, что я подбежал и попытался её остановить, мне достаются брызги."

# ch/lexi/events.rpy:1365
translate russian lexi_event_02_371b8676_2:
    mike.say "..."

# ch/lexi/events.rpy:1369
translate russian lexi_event_02_994e2add:
    "Вынырнув, Лекси поворачивается ко мне с дьявольской улыбкой и плещет водой прямо в лицо, прежде чем я успеваю прикрыться. Я стону и протираю глаза."

# ch/lexi/events.rpy:1370
translate russian lexi_event_02_ac37c107:
    mike.say "...Серьёзно?"

# ch/lexi/events.rpy:1371
translate russian lexi_event_02_ac0482db:
    lexi.say "Расслабься и залезай! Со всей тяжёлой хренью ведь уже разобрались, да?"

# ch/lexi/events.rpy:1374
translate russian lexi_event_02_22522e1e:
    "Её тело... великолепно. Этого не отрицать."

# ch/lexi/events.rpy:1375
translate russian lexi_event_02_2639fa0b:
    "Пышная грудь, стройная талия и округлые бёдра. Она стройная, с изгибами во всех нужных местах."

# ch/lexi/events.rpy:1377
translate russian lexi_event_02_a48052e7:
    "Увидеть всё это целиком... особое удовольствие."

# ch/lexi/events.rpy:1379
translate russian lexi_event_02_5ef33111:
    lexi.say "Эй, язык обратно в рот засунь, извращенец."

# ch/lexi/events.rpy:1380
translate russian lexi_event_02_fef58e7c_1:
    mike.say "Прости?"

# ch/lexi/events.rpy:1381
translate russian lexi_event_02_a9e176c9:
    "Она смеётся, подплывает к бортику и опирается на него сложенными руками и грудью. Груди сжимаются, с них стекает хлорированная вода. Зрелище, прямо скажем, заманчивое."

# ch/lexi/events.rpy:1382
translate russian lexi_event_02_17125782:
    lexi.say "Заинтересовался? Почему бы не присоединиться?"

# ch/lexi/events.rpy:1383
translate russian lexi_event_02_945e017b:
    lexi.say "В этот раз тебе ведь нечего бояться. Бумажник в бассейн не возьмёшь."

# ch/lexi/events.rpy:1384
translate russian lexi_event_02_79055163:
    "Верно. Что ж... может, стоит. Или... нет?"

# ch/lexi/events.rpy:1387
translate russian lexi_event_02_1856f37a:
    "Искупаться вечером с горячей девушкой?"

# ch/lexi/events.rpy:1388
translate russian lexi_event_02_ad2095ba:
    "Думаю, любой здравомыслящий человек сказал бы «да»."

# ch/lexi/events.rpy:1389
translate russian lexi_event_02_2bc7d022:
    "Поэтому, не оставляя себе времени на сомнения, я снимаю одежду и спускаюсь к ней в воду."

# ch/lexi/events.rpy:1390
translate russian lexi_event_02_66e6b60b:
    "Да... совершенно голый."

# ch/lexi/events.rpy:1391
translate russian lexi_event_02_06c9feb4:
    "А она просто смотрит на меня."

# ch/lexi/events.rpy:1392
translate russian lexi_event_02_308cd0fa:
    "Смотрит и смотрит..."

# ch/lexi/events.rpy:1393
translate russian lexi_event_02_aced90b4:
    lexi.say "Ого... ты и правда это сделал."

# ch/lexi/events.rpy:1394
translate russian lexi_event_02_a5d47bed:
    mike.say "Ну... решил, это лучше, чем неловко стоять и ждать, пока ты вылезешь."

# ch/lexi/events.rpy:1395
translate russian lexi_event_02_58155010:
    mike.say "И оденешься."

# ch/lexi/events.rpy:1396
translate russian lexi_event_02_07dafaf6:
    lexi.say "Что ж, я впечатлена. Итак..."

# ch/lexi/events.rpy:1402
translate russian lexi_event_02_4186fb4a:
    "...Я не идиот. Лекси, конечно, вернула бумажник, но сейчас будто снова играет со мной. На эту наживку я не клюну."

# ch/lexi/events.rpy:1404
translate russian lexi_event_02_8512437c:
    lexi.say "Эй, ты не залезешь?"

# ch/lexi/events.rpy:1405
translate russian lexi_event_02_c71b6599:
    mike.say "Нет уж, спасибо..."

# ch/lexi/events.rpy:1407
translate russian lexi_event_02_efd9e913:
    "Я прохожу вдоль бассейна, собираясь вернуться в дом и допить бутылку. Не учитываю только, насколько близко она находится."

# ch/lexi/events.rpy:1408
translate russian lexi_event_02_692ab4bb:
    "Из воды выскальзывает её мокрая рука, хватает меня за лодыжку и резко дёргает, опрокидывая."

# ch/lexi/events.rpy:1410
translate russian lexi_event_02_04b7215b:
    mike.say "А-А!"

# ch/lexi/events.rpy:1413
translate russian lexi_event_02_287f4eec:
    "Ей повезло, что я падаю в воду, а не ударяюсь головой о бетон."

# ch/lexi/events.rpy:1414
translate russian lexi_event_02_b4d05c0c:
    mike.say "Блядь! Какого чёрта?!"

# ch/lexi/events.rpy:1417
translate russian lexi_event_02_f24fa79b:
    "Едва вынырнув, я огрызаюсь на неё. Она смотрит с самодовольной ухмылкой."

# ch/lexi/events.rpy:1418
translate russian lexi_event_02_af0f496b:
    lexi.say "Поверь, сегодня тебе захочется говорить мне «да»."

# ch/lexi/events.rpy:1420
translate russian lexi_event_02_04c271ca:
    "Лекси не теряет времени. Когда она прижимается ко мне спереди своей великолепной грудью, я словно снова оказываюсь в клубном туалете."

# ch/lexi/events.rpy:1421
translate russian lexi_event_02_2d6d1a96:
    "Мои руки опускаются на её бока и нежно сжимают. Под водой её кожа кажется ещё теплее."

# ch/lexi/events.rpy:1423
translate russian lexi_event_02_502512fe:
    lexi.say "Хе..."

# ch/lexi/events.rpy:1424
translate russian lexi_event_02_667f7883:
    "Её руки тоже начинают исследовать моё тело, скользя по каждому сантиметру кожи. Вскоре они обхватывают несколько особенно важных сантиметров и начинают двигаться даже под водой."

# ch/lexi/events.rpy:1425
translate russian lexi_event_02_da10ea5b:
    "Но... готов ли я зайти дальше? Что ж... похоже, теперь пути назад нет."

# ch/lexi/events.rpy:1427
translate russian lexi_event_02_a00ede1c:
    lexi.say "Посмотри на себя... у тебя уже встаёт."

# ch/lexi/events.rpy:1429
translate russian lexi_event_02_e02909f3:
    "Она ухмыляется и убирает руку, затем прислоняется к бортику рядом, выставив фигуру напоказ и слегка раздвинув ноги. Будто ждёт, что я подниму их и притяну её к себе."

# ch/lexi/events.rpy:1430
translate russian lexi_event_02_371b8676_3:
    mike.say "..."

# ch/lexi/events.rpy:1431
translate russian lexi_event_02_ea46eacc:
    "Я делаю к ней пару шагов по воде, скольжу ладонями к ягодицам и крепко сжимаю их. Затем приподнимаю её и чуть шире развожу ноги."

# ch/lexi/events.rpy:1438
translate russian lexi_event_02_74ae8141:
    "Наполовину оставаясь в воде, я успеваю снять одежду, прежде чем войти членом в её ждущую киску."

# ch/lexi/events.rpy:1440
translate russian lexi_event_02_64439248:
    "Наполовину оставаясь с ней в воде, я вхожу членом в её ждущую киску."

# ch/lexi/events.rpy:1441
translate russian lexi_event_02_2c632cd7:
    lexi.say "А-а!"

# ch/lexi/events.rpy:1442
translate russian lexi_event_02_d1d6ec4e:
    "Она тут же вскрикивает. Мой член уже каменно-твёрдый."

# ch/lexi/events.rpy:1443
translate russian lexi_event_02_2819c7cc:
    "Это лишь подстёгивает меня войти глубже и напористее. По её реакции видно, что ей нравится."

# ch/lexi/events.rpy:1444
translate russian lexi_event_02_2566e258:
    "Я начинаю ритмично двигаться внутри неё, и вскоре мы двигаемся в унисон, расплёскивая тёплую воду вокруг обнажённых тел."

# ch/lexi/events.rpy:1445
translate russian lexi_event_02_95ba4c7b:
    lexi.say "Ах... сильнее!"

# ch/lexi/events.rpy:1446
translate russian lexi_event_02_e75f1a7c:
    mike.say "М-м..."

# ch/lexi/events.rpy:1447
translate russian lexi_event_02_71e04e3b:
    "Я рычу и подчиняюсь, ускоряясь и больше не сдерживаясь. Её тело всё горячее, а внутренние стенки сжимаются вокруг моего члена."

# ch/lexi/events.rpy:1452
translate russian lexi_event_02_f81ca969:
    "Наконец мы оба, кажется, достигаем пика, и с последней дрожью я кончаю в неё."

# ch/lexi/events.rpy:1454
translate russian lexi_event_02_9c866db8:
    "Моя горячая сперма словно вызывает и у неё вспышку наслаждения, и она резко вздыхает."

# ch/lexi/events.rpy:1455
translate russian lexi_event_02_1eda3520:
    lexi.say "А-а-ах~!"

# ch/lexi/events.rpy:1456
translate russian lexi_event_02_1311283e:
    "Вот так. Я выхожу и успокаиваюсь, чувствуя, как её соки смешиваются в воде с моей спермой."

# ch/lexi/events.rpy:1459
translate russian lexi_event_02_71d41a1e:
    "Я с трудом вытаскиваю член за мгновение до того, как кончить."

# ch/lexi/events.rpy:1460
translate russian lexi_event_02_1eda3520_1:
    lexi.say "А-а-ах~!"

# ch/lexi/events.rpy:1462
translate russian lexi_event_02_e80e258e:
    lexi.say "Т... ты слишком быстро вытащил..."

# ch/lexi/events.rpy:1464
translate russian lexi_event_02_d21a4cb1:
    mike.say "Виноват."

# ch/lexi/events.rpy:1465
translate russian lexi_event_02_6d3a182e:
    "Честно говоря, я ещё не был с такой женщиной. Никогда прежде я не кончал настолько быстро."

# ch/lexi/events.rpy:1466
translate russian lexi_event_02_5f18bf74:
    "Может, потому, что всё было так неожиданно. Трахнуть такую девушку, как Лекси, да ещё здесь... разве я мог это предвидеть?"

# ch/lexi/events.rpy:1468
translate russian lexi_event_02_55ea568f:
    "Даже когда она уходит, я, самодовольно гордясь собой, чувствую что-то странное. Будто не хочу её отпускать."

# ch/lexi/events.rpy:1475
translate russian lexi_event_02b_abcde97c:
    "Я проталкиваюсь сквозь толпу покупателей в торговом центре, когда чувствую вибрацию телефона."

# ch/lexi/events.rpy:1476
translate russian lexi_event_02b_067bc4c2:
    "Будто мне мало хлопот с покупками перед праздниками!"

# ch/lexi/events.rpy:1477
translate russian lexi_event_02b_58bae561:
    "Я с трудом достаю телефон и отступаю в сторону от живой реки людей, чтобы ответить."

# ch/lexi/events.rpy:1478
translate russian lexi_event_02b_e6d63aa5:
    "На экране неизвестный номер, но, уже принимая звонок, я смутно догадываюсь, кто это."

# ch/lexi/events.rpy:1490
translate russian lexi_event_02b_ae1fb932:
    mike.say "Лекси?!"

# ch/lexi/events.rpy:1491
translate russian lexi_event_02b_3885ec17:
    mike.say "Надеюсь, это не ты!"

# ch/lexi/events.rpy:1492
translate russian lexi_event_02b_e423c6a8:
    "На другом конце раздаётся похабный смешок."

# ch/lexi/events.rpy:1493
translate russian lexi_event_02b_afedc973:
    "И этого достаточно, чтобы подтвердить мои подозрения ещё до первого слова."

# ch/lexi/events.rpy:1494
translate russian lexi_event_02b_71173e0e:
    lexi.say "А если я?"

# ch/lexi/events.rpy:1495
translate russian lexi_event_02b_0c366139:
    lexi.say "И что ты мне сделаешь?"

# ch/lexi/events.rpy:1496
translate russian lexi_event_02b_fa9d66b0:
    "Я замечаю, что несколько проходящих покупателей косятся на меня."

# ch/lexi/events.rpy:1497
translate russian lexi_event_02b_e80c5fb6:
    "Наверное, в праведном гневе на Лекси я орал в трубку."

# ch/lexi/events.rpy:1498
translate russian lexi_event_02b_681e9b6f:
    "Я отворачиваюсь от них и титаническим усилием подавляю ярость."

# ch/lexi/events.rpy:1499
translate russian lexi_event_02b_1538f158:
    mike.say "Ну и наглость — звонить мне, Лекси!"

# ch/lexi/events.rpy:1500
translate russian lexi_event_02b_7336519c:
    mike.say "После того, что ты сделала, мне стоит обратиться в полицию!"

# ch/lexi/events.rpy:1501
translate russian lexi_event_02b_7bb3c172:
    lexi.say "Бла-бла-бла!"

# ch/lexi/events.rpy:1502
translate russian lexi_event_02b_2a5be047:
    lexi.say "Уа-уа-уа!"

# ch/lexi/events.rpy:1503
translate russian lexi_event_02b_457e2269:
    lexi.say "Только время на этих импотентов потратишь."

# ch/lexi/events.rpy:1504
translate russian lexi_event_02b_8a7ae6db:
    lexi.say "Они для тебя ничего делать не будут!"

# ch/lexi/events.rpy:1505
translate russian lexi_event_02b_318bbb18:
    "Я морщусь от насмешливого тона Лекси."

# ch/lexi/events.rpy:1506
translate russian lexi_event_02b_cafdef5e:
    "Да ещё и последняя её фраза звучит как-то криво."

# ch/lexi/events.rpy:1507
translate russian lexi_event_02b_6b04bbf9:
    mike.say "Слушай, ты просто позвонила позлорадствовать или что?!"

# ch/lexi/events.rpy:1508
translate russian lexi_event_02b_bf204c8e:
    mike.say "Я вообще-то занят делами нормальных людей, которые не нарушают закон!"

# ch/lexi/events.rpy:1509
translate russian lexi_event_02b_b3d1f9b2:
    mike.say "Я уже потратил из-за тебя несколько часов жизни на блокировку кредиток!"

# ch/lexi/events.rpy:1510
translate russian lexi_event_02b_0eccd4c3:
    lexi.say "Эй!"

# ch/lexi/events.rpy:1511
translate russian lexi_event_02b_a7df349c:
    lexi.say "Я не пользовалась твоими чёртовыми кредитками!"

# ch/lexi/events.rpy:1512
translate russian lexi_event_02b_be519e6e:
    "Не знаю почему, но эти слова особенно меня задевают."

# ch/lexi/events.rpy:1513
translate russian lexi_event_02b_1f3d693d:
    "Будто Лекси считает меня достаточно тупым, чтобы поверить."

# ch/lexi/events.rpy:1514
translate russian lexi_event_02b_37e1686e:
    mike.say "Да, Лекси, конечно не пользовалась!"

# ch/lexi/events.rpy:1515
translate russian lexi_event_02b_7cd6309d:
    mike.say "Ты украла бумажник со всем содержимым."

# ch/lexi/events.rpy:1516
translate russian lexi_event_02b_5f6e9990:
    mike.say "Но пользоваться моими вещами тебе бы и в голову не пришло!"

# ch/lexi/events.rpy:1517
translate russian lexi_event_02b_2c99037b:
    mike.say "За какого идиота ты меня принимаешь?!"

# ch/lexi/events.rpy:1518
translate russian lexi_event_02b_5f4af957:
    "Лекси замолкает и отвечает лишь через несколько секунд."

# ch/lexi/events.rpy:1519
translate russian lexi_event_02b_4e253577:
    "И когда она заговаривает снова, я слышу перемену в голосе."

# ch/lexi/events.rpy:1520
translate russian lexi_event_02b_9ba8d037:
    "Едва заметную, но в нём словно меньше наглости и больше уязвимости."

# ch/lexi/events.rpy:1521
translate russian lexi_event_02b_b379ec29:
    lexi.say "Я... я не вру, ясно?"

# ch/lexi/events.rpy:1522
translate russian lexi_event_02b_249bd814:
    lexi.say "Не знаю, почему не воспользовалась ими..."

# ch/lexi/events.rpy:1523
translate russian lexi_event_02b_9b9ee68b:
    lexi.say "Казалось, что это неправильно... вот и всё!"

# ch/lexi/events.rpy:1524
translate russian lexi_event_02b_8fe4eca4:
    lexi.say "Слушай, можем встретиться?"

# ch/lexi/events.rpy:1525
translate russian lexi_event_02b_d21ff14f:
    lexi.say "Ну, поговорить лично?"

# ch/lexi/events.rpy:1526
translate russian lexi_event_02b_b3724f0e:
    mike.say "И что это даст?"

# ch/lexi/events.rpy:1527
translate russian lexi_event_02b_60107946:
    lexi.say "Не знаю... просто хочу, и всё!"

# ch/lexi/events.rpy:1528
translate russian lexi_event_02b_bd8ef563:
    mike.say "Хочешь сделать шаг к примирению, Лекси? Так?"

# ch/lexi/events.rpy:1529
translate russian lexi_event_02b_ece31a80:
    lexi.say "Да-да... я не умею так красиво говорить, как ты!"

# ch/lexi/events.rpy:1530
translate russian lexi_event_02b_643c0084:
    lexi.say "Может, зайду к тебе?"

# ch/lexi/events.rpy:1531
translate russian lexi_event_02b_58a725da:
    lexi.say "Я нашла твой адрес в бумажнике..."

# ch/lexi/events.rpy:1532
translate russian lexi_event_02b_0866885f:
    "Ну уж нет!"

# ch/lexi/events.rpy:1533
translate russian lexi_event_02b_443dac83:
    "Откуда мне знать, не задумала ли она вынести из дома всё моё имущество!"

# ch/lexi/events.rpy:1534
translate russian lexi_event_02b_b199b4a5:
    mike.say "Нет..."

# ch/lexi/events.rpy:1535
translate russian lexi_event_02b_a607e075:
    mike.say "Лучше на нейтральной территории..."

# ch/lexi/events.rpy:1536
translate russian lexi_event_02b_96adc9d4:
    mike.say "Я сейчас в торговом центре. Сможешь подъехать?"

# ch/lexi/events.rpy:1537
translate russian lexi_event_02b_9ab401b7:
    lexi.say "Конечно. Оглянуться не успеешь, как буду там!"

# ch/lexi/events.rpy:1539
translate russian lexi_event_02b_a0a6004e:
    "Едва Лекси завершает звонок, я невольно оглядываюсь."

# ch/lexi/events.rpy:1540
translate russian lexi_event_02b_761398e0:
    "Она так меня взвинтила, что я почти жду её появления из ниоткуда."

# ch/lexi/events.rpy:1541
translate russian lexi_event_02b_434f5fad:
    "Но на самом деле проходит какое-то время, прежде чем она приезжает."

# ch/lexi/events.rpy:1542
translate russian lexi_event_02b_842cd651:
    "Я иду ко входу в торговый центр, поэтому замечаю её сразу."

# ch/lexi/events.rpy:1547
translate russian lexi_event_02b_aa177c77:
    lexi.say "Вот ты где!"

# ch/lexi/events.rpy:1549
translate russian lexi_event_02b_ef95bfb2:
    mike.say "Да, Лекси, я здесь."

# ch/lexi/events.rpy:1550
translate russian lexi_event_02b_9cd89729:
    mike.say "И у тебя для меня кое-что есть, верно?"

# ch/lexi/events.rpy:1552
translate russian lexi_event_02b_21ecb1f4:
    "Лекси недоверчиво закатывает глаза."

# ch/lexi/events.rpy:1553
translate russian lexi_event_02b_9e217345:
    "Но всё-таки достаёт мой бумажник и протягивает его."

# ch/lexi/events.rpy:1555
translate russian lexi_event_02b_eae3b5f6:
    lexi.say "Господи, у тебя одно на уме!"

# ch/lexi/events.rpy:1557
translate russian lexi_event_02b_761a2f7f:
    "Я не отвечаю, слишком занят проверкой содержимого."

# ch/lexi/events.rpy:1559
translate russian lexi_event_02b_a176a7f2:
    lexi.say "Всё на месте, обещаю."

# ch/lexi/events.rpy:1561
translate russian lexi_event_02b_c1f6003e:
    "Убедившись, что она говорит правду, я киваю."

# ch/lexi/events.rpy:1563
translate russian lexi_event_02b_be48ace9:
    mike.say "Да, Лекси."

# ch/lexi/events.rpy:1565
translate russian lexi_event_02b_adff5b1e:
    mike.say "Спасибо, что была со мной честна."

# ch/lexi/events.rpy:1567
translate russian lexi_event_02b_518b6678:
    "От этих слов Лекси странным образом меняется."

# ch/lexi/events.rpy:1568
translate russian lexi_event_02b_e879a783:
    "Только что она грубила и дулась, а теперь смягчается и улыбается."

# ch/lexi/events.rpy:1569
translate russian lexi_event_02b_00c5c7aa:
    "И я вдруг замечаю, что она действительно очень красивая."

# ch/lexi/events.rpy:1570
translate russian lexi_event_02b_ea544293:
    "То есть под всем этим макияжем и развратными нарядами!"

# ch/lexi/events.rpy:1571
translate russian lexi_event_02b_c120bbd1:
    mike.say "Что такое, Лекси?"

# ch/lexi/events.rpy:1572
translate russian lexi_event_02b_43408103:
    mike.say "Я что-то сказал?"

# ch/lexi/events.rpy:1574
translate russian lexi_event_02b_ce3781cd:
    lexi.say "Нет... то есть да..."

# ch/lexi/events.rpy:1576
translate russian lexi_event_02b_1f45fb3f:
    lexi.say "Просто... мне нравится, когда ты ко мне хорошо относишься!"

# ch/lexi/events.rpy:1578
translate russian lexi_event_02b_ffaf7b8e:
    "Внезапно выражение её лица снова меняется."

# ch/lexi/events.rpy:1579
translate russian lexi_event_02b_384fc5e7:
    "На этот раз она выглядит грустной."

# ch/lexi/events.rpy:1581
translate russian lexi_event_02b_edc5124d:
    lexi.say "Я не привыкла, чтобы парни хорошо ко мне относились..."

# ch/lexi/events.rpy:1582
translate russian lexi_event_02b_a67b187a:
    "Я знаю, с Лекси нужно быть настороже: всё это может оказаться уловкой."

# ch/lexi/events.rpy:1583
translate russian lexi_event_02b_1588a92b:
    "Но почему-то не могу удержаться от желания поддержать и утешить её."

# ch/lexi/events.rpy:1584
translate russian lexi_event_02b_1e181899:
    "Может, я просто ведусь на красивое лицо и жалостливую историю."

# ch/lexi/events.rpy:1585
translate russian lexi_event_02b_d508a216:
    mike.say "Я... я как раз покупал подарки к Рождеству."

# ch/lexi/events.rpy:1586
translate russian lexi_event_02b_d6ad96db:
    mike.say "Хочешь остаться и составить мне компанию?"

# ch/lexi/events.rpy:1587
translate russian lexi_event_02b_73adc3d6:
    mike.say "Можем ещё поболтать... если тебе больше никуда не нужно?"

# ch/lexi/events.rpy:1589
translate russian lexi_event_02b_4c1cc566:
    "Настроение Лекси снова меняется в одно мгновение."

# ch/lexi/events.rpy:1591
translate russian lexi_event_02b_9b271aff:
    "Она берёт меня под руку и прижимается."

# ch/lexi/events.rpy:1592
translate russian lexi_event_02b_a6679541:
    lexi.say "Конечно, [lssb_lexi.hero_name()]!"

# ch/lexi/events.rpy:1594
translate russian lexi_event_02b_9215541d:
    lexi.say "Если кто спросит, могу прикинуться твоей шикарной девушкой!"

# ch/lexi/events.rpy:1596
translate russian lexi_event_02b_822f163e:
    "Я невольно усмехаюсь, представив Лекси в образе «шикарной» девушки."

# ch/lexi/events.rpy:1597
translate russian lexi_event_02b_a3322b25:
    "Но в то же время её прикосновение приятно волнует."

# ch/lexi/events.rpy:1598
translate russian lexi_event_02b_34178822:
    "Какая-то часть меня даже рада, что она из неблагополучного района."

# ch/lexi/events.rpy:1599
translate russian lexi_event_02b_a1914a3b:
    "Она вульгарная и дешёвая, но при этом волнующая и откровенно сексуальная."

# ch/lexi/events.rpy:1603
translate russian lexi_event_02b_66fee720:
    "Поначалу мы болтаем ни о чём."

# ch/lexi/events.rpy:1604
translate russian lexi_event_02b_cd252e11:
    "Потом останавливаемся у магазина с витриной, полной байкерских курток."

# ch/lexi/events.rpy:1605
translate russian lexi_event_02b_a006a573:
    "И это, кажется, напоминает нам обоим о прошлой встрече."

# ch/lexi/events.rpy:1606
translate russian lexi_event_02b_28eea78e:
    mike.say "Лекси..."

# ch/lexi/events.rpy:1607
translate russian lexi_event_02b_304bfca3:
    mike.say "Кто был тот байкер, с которым ты тогда была?"

# ch/lexi/events.rpy:1609
translate russian lexi_event_02b_93e2d49a:
    lexi.say "А... он..."

# ch/lexi/events.rpy:1610
translate russian lexi_event_02b_95c037a7:
    lexi.say "Это Дэнни, мой..."

# ch/lexi/events.rpy:1613
translate russian lexi_event_02b_d9153f04:
    lexi.say "Ну, я и сама толком не знаю, кто он мне."

# ch/lexi/events.rpy:1614
translate russian lexi_event_02b_04ae33ae:
    lexi.say "Иногда ведёт себя как мой парень."

# ch/lexi/events.rpy:1617
translate russian lexi_event_02b_bc6c331d:
    lexi.say "А иногда — как мой чёртов сутенёр!"

# ch/lexi/events.rpy:1619
translate russian lexi_event_02b_07f482a7:
    mike.say "Не похож он на хорошего человека."

# ch/lexi/events.rpy:1620
translate russian lexi_event_02b_cc8d161a:
    mike.say "Так почему ты остаёшься с ним?"

# ch/lexi/events.rpy:1622
translate russian lexi_event_02b_4e69ddd6:
    "Лекси вздыхает, словно то, что ей предстоит сказать, тяжело на неё давит."

# ch/lexi/events.rpy:1623
translate russian lexi_event_02b_8675b0b2:
    "Но всё-таки говорит, будто ей нужно выговориться."

# ch/lexi/events.rpy:1624
translate russian lexi_event_02b_4c48148c:
    lexi.say "Я должна ему и его дружкам."

# ch/lexi/events.rpy:1625
translate russian lexi_event_02b_fa114a2d:
    lexi.say "Вот и приходится отрабатывать долг."

# ch/lexi/events.rpy:1626
translate russian lexi_event_02b_c000e3a8:
    lexi.say "А Дэнни любит, чтобы я обрабатывала таких парней, как ты..."

# ch/lexi/events.rpy:1627
translate russian lexi_event_02b_180c15a7:
    "И в один миг я начинаю видеть всю ситуацию иначе."

# ch/lexi/events.rpy:1628
translate russian lexi_event_02b_c8ea04c7:
    "Раньше я злился на Лекси за обман и кражу бумажника."

# ch/lexi/events.rpy:1629
translate russian lexi_event_02b_29987a05:
    "А теперь чувствую себя полным мудаком."

# ch/lexi/events.rpy:1630
translate russian lexi_event_02b_231bedc4:
    "Потому что, оказывается, она здесь тоже жертва."

# ch/lexi/events.rpy:1631
translate russian lexi_event_02b_2a5e7242:
    "И, вероятно, пострадала куда сильнее меня."

# ch/lexi/events.rpy:1632
translate russian lexi_event_02b_db0fc2a3:
    mike.say "Я понимаю, Лекси, это не моё дело."

# ch/lexi/events.rpy:1633
translate russian lexi_event_02b_015b53ea:
    mike.say "И я не указываю тебе, что делать."

# ch/lexi/events.rpy:1634
translate russian lexi_event_02b_c67c3489:
    mike.say "Но разве нельзя обратиться в полицию или ещё куда-нибудь?"

# ch/lexi/events.rpy:1635
translate russian lexi_event_02b_c6e4d1c5:
    lexi.say "Не, бесполезно."

# ch/lexi/events.rpy:1636
translate russian lexi_event_02b_17bd4df1:
    lexi.say "Меня просто посадят за всё, что я натворила."

# ch/lexi/events.rpy:1637
translate russian lexi_event_02b_c544d46d:
    lexi.say "А когда выйду, Дэнни всё равно будет меня ждать."

# ch/lexi/events.rpy:1638
translate russian lexi_event_02b_65ec8d89:
    "В голосе Лекси слышится беспомощность."

# ch/lexi/events.rpy:1639
translate russian lexi_event_02b_2b9b41d1:
    "И у меня нет простого решения её проблемы с Дэнни."

# ch/lexi/events.rpy:1640
translate russian lexi_event_02b_b838af3a:
    "Поэтому я просто оставляю эту тему."

# ch/lexi/events.rpy:1642
translate russian lexi_event_02b_ec9b92b6:
    "К счастью, вскоре Лекси снова веселее."

# ch/lexi/events.rpy:1643
translate russian lexi_event_02b_20fc6ef4:
    "Похоже, она намерена как можно лучше провести время вдали от Дэнни."

# ch/lexi/events.rpy:1644
translate russian lexi_event_02b_f1fbf383:
    "И потому целиком отдаётся нашей прогулке."

# ch/lexi/events.rpy:1645
translate russian lexi_event_02b_a0e29b2d:
    "Слишком скоро покупки закончены, и мне пора домой."

# ch/lexi/events.rpy:1649
translate russian lexi_event_02b_59282269:
    "Но на выходе из торгового центра Лекси берёт меня за руку."

# ch/lexi/events.rpy:1650
translate russian lexi_event_02b_82c523b7:
    "И начинает тянуть к ближайшему туалету."

# ch/lexi/events.rpy:1651
translate russian lexi_event_02b_8d337540:
    mike.say "Лекси!"

# ch/lexi/events.rpy:1652
translate russian lexi_event_02b_f809254b:
    mike.say "Что ты делаешь?!"

# ch/lexi/events.rpy:1654
translate russian lexi_event_02b_5e5107cc:
    lexi.say "Ты был добр ко мне, теперь моя очередь!"

# ch/lexi/events.rpy:1655
translate russian lexi_event_02b_a17f6bef:
    lexi.say "В этот раз без подвоха, обещаю!"

# ch/lexi/events.rpy:1656
translate russian lexi_event_02b_de76e844:
    "В голове наконец всё складывается, и я понимаю, что происходит."

# ch/lexi/events.rpy:1657
translate russian lexi_event_02b_75ae4937:
    "Лекси тащит меня в туалет по той же причине, что и в прошлый раз!"

# ch/lexi/events.rpy:1660
translate russian lexi_event_02b_37e0b29a:
    "Я пожимаю плечами и позволяю ей настоять на своём."

# ch/lexi/events.rpy:1661
translate russian lexi_event_02b_fa4184e2:
    "В конце концов, почему бы и нет?"

# ch/lexi/events.rpy:1662
translate russian lexi_event_02b_a855a165:
    "Она ведь вроде как должна мне за украденный бумажник."

# ch/lexi/events.rpy:1663
translate russian lexi_event_02b_078c367a:
    "После этого, пожалуй, будем в расчёте."

# ch/lexi/events.rpy:1667
translate russian lexi_event_02b_b32c3e9e:
    "Лекси затаскивает меня в одну из кабинок."

# ch/lexi/events.rpy:1668
translate russian lexi_event_02b_9aa98953:
    "И тут же расстёгивает мне штаны."

# ch/lexi/events.rpy:1669
translate russian lexi_event_02b_52a42470:
    "Затем спускает их до щиколоток и опускается на колени."

# ch/lexi/events.rpy:1670
translate russian lexi_event_02b_5867c26a:
    "Никакого дразнения или нежных предварительных ласк."

# ch/lexi/events.rpy:1672
translate russian lexi_event_02b_db67f418:
    "Лекси сразу переходит к делу."

# ch/lexi/events.rpy:1673
translate russian lexi_event_02b_caa0e9e1:
    "И не могу сказать, что это не действует."

# ch/lexi/events.rpy:1674
translate russian lexi_event_02b_3997b239:
    "Мой член уже твёрдый ещё до её прикосновения."

# ch/lexi/events.rpy:1675
translate russian lexi_event_02b_1505f361:
    "А когда она обхватывает его, клянусь, он вырастает ещё на пару сантиметров!"

# ch/lexi/events.rpy:1676
translate russian lexi_event_02b_1701e20f:
    "Лекси улыбается мне снизу вверх и для верности подмигивает."

# ch/lexi/events.rpy:1679
translate russian lexi_event_02b_df3ea09e:
    "Затем обхватывает губами головку."

# ch/lexi/events.rpy:1680
translate russian lexi_event_02b_abcc6947:
    "Техника у неё тоже простая: без пауз и колебаний."

# ch/lexi/events.rpy:1681
translate russian lexi_event_02b_0ad9ac67:
    "Она просто с удовольствием начинает лизать и сосать."

# ch/lexi/events.rpy:1683
translate russian lexi_event_02b_0c6056bd:
    "И это работает: с первых же движений у меня перехватывает дыхание."

# ch/lexi/events.rpy:1684
translate russian lexi_event_02b_15e6098f:
    "Вскоре мне даже приходится упереться в стенки кабинки!"

# ch/lexi/events.rpy:1685
translate russian lexi_event_02b_49bf0c1e:
    "Мне ещё никогда не делали такой минет — ничего лишнего, только самое главное."

# ch/lexi/events.rpy:1686
translate russian lexi_event_02b_75847155:
    "И всё же ощущения невероятные: просто Лекси доставляет мне удовольствие ртом."

# ch/lexi/events.rpy:1688
translate russian lexi_event_02b_ad046b67:
    "Её голова движется вверх-вниз, вперёд-назад."

# ch/lexi/events.rpy:1689
translate russian lexi_event_02b_d60eb95f:
    "И всё это время она смотрит на меня."

# ch/lexi/events.rpy:1690
translate russian lexi_event_02b_4e6f2b24:
    "В её глазах настоящий голод."

# ch/lexi/events.rpy:1692
translate russian lexi_event_02b_fedce5e4:
    "Сначала мне кажется, ей просто нравится чувствовать член во рту."

# ch/lexi/events.rpy:1693
translate russian lexi_event_02b_5ebc6c28:
    "Но затем я замечаю, что её взгляд не затуманен и не устремлён сквозь меня."

# ch/lexi/events.rpy:1694
translate russian lexi_event_02b_017889c6:
    "Лекси смотрит мне в глаза и следит, как я реагирую на её ласки."

# ch/lexi/events.rpy:1696
translate russian lexi_event_02b_91b8a443:
    "Словно пытается понять, достаточно ли мне приятно."

# ch/lexi/events.rpy:1697
translate russian lexi_event_02b_351c7f65:
    "Будто моё удовольствие для неё важнее, чем поскорее закончить."

# ch/lexi/events.rpy:1699
translate russian lexi_event_02b_45407fa6:
    "И это совсем не похоже на первый раз, когда она мне отсосала."

# ch/lexi/events.rpy:1700
translate russian lexi_event_02b_125f6645:
    "Тогда всё напоминало скорее деловую сделку, чем близость."

# ch/lexi/events.rpy:1702
translate russian lexi_event_02b_8e8f9216:
    "Теперь Лекси действует грубее и быстрее, но почему-то ещё и искреннее."

# ch/lexi/events.rpy:1703
translate russian lexi_event_02b_f653618c:
    "Всё это возбуждает меня ещё сильнее."

# ch/lexi/events.rpy:1707
translate russian lexi_event_02b_60adbc0f:
    "Наверное, поэтому через мгновение я уже чувствую, что кончаю!"

# ch/lexi/events.rpy:1709
translate russian lexi_event_02b_ed10495d:
    "Лекси к этому готова и справляется без труда."

# ch/lexi/events.rpy:1711
translate russian lexi_event_02b_14d6eca0:
    "Она проглатывает всё до последней капли, словно не желая ничего упустить."

# ch/lexi/events.rpy:1714
translate russian lexi_event_02b_5d4d2874:
    "И, закончив, выглядит чрезвычайно довольной собой."

# ch/lexi/events.rpy:1716
translate russian lexi_event_02b_3b641f09:
    lexi.say "М-м-м..."

# ch/lexi/events.rpy:1717
translate russian lexi_event_02b_c767bacf:
    lexi.say "Ну как тебе?"

# ch/lexi/events.rpy:1718
translate russian lexi_event_02b_89e3e84a:
    mike.say "Это было..."

# ch/lexi/events.rpy:1719
translate russian lexi_event_02b_765b5ef3:
    mike.say "Это было... ОГО..."

# ch/lexi/events.rpy:1720
translate russian lexi_event_02b_2948a9ca:
    mike.say "Это было потрясающе, Лекси!"

# ch/lexi/events.rpy:1724
translate russian lexi_event_02b_a3833368:
    "Лекси хихикает и помогает мне подтянуть штаны."

# ch/lexi/events.rpy:1725
translate russian lexi_event_02b_bbadf294:
    "Затем целует в губы."

# ch/lexi/events.rpy:1726
translate russian lexi_event_02b_ba7d9546:
    lexi.say "Будь я твоей, делала бы это для тебя каждый день!"

# ch/lexi/events.rpy:1728
translate russian lexi_event_02b_6017df65:
    lexi.say "Каждый... божий... день!"

# ch/lexi/events.rpy:1732
translate russian lexi_event_02b_184b7241:
    "Когда я привожу себя в порядок, мы незаметно выходим из туалета."

# ch/lexi/events.rpy:1733
translate russian lexi_event_02b_ce59804d:
    "Я улыбаюсь, стараясь показать Лекси, что больше на неё не злюсь."

# ch/lexi/events.rpy:1734
translate russian lexi_event_02b_3c258f65:
    "Она, кажется, понимает и слабо улыбается в ответ."

# ch/lexi/events.rpy:1735
translate russian lexi_event_02b_9fa4096c:
    mike.say "Если тебе важно это знать, Лекси, я прощаю тебя за бумажник."

# ch/lexi/events.rpy:1736
translate russian lexi_event_02b_d2a644cb:
    mike.say "И сегодня мне было с тобой здорово!"

# ch/lexi/events.rpy:1737
translate russian lexi_event_02b_8c9ba473:
    lexi.say "Правда?"

# ch/lexi/events.rpy:1738
translate russian lexi_event_02b_de6e9d6e:
    lexi.say "Ну... можем ещё потусить вместе, да?"

# ch/lexi/events.rpy:1739
translate russian lexi_event_02b_02362df0:
    mike.say "Конечно, Лекси."

# ch/lexi/events.rpy:1740
translate russian lexi_event_02b_c4395abe:
    mike.say "Мой номер у тебя есть, так что звони!"

# ch/lexi/events.rpy:1742
translate russian lexi_event_02b_cd9a6c90:
    mike.say "Подожди минутку, Лекси."

# ch/lexi/events.rpy:1743
translate russian lexi_event_02b_2502019c:
    mike.say "Ты не обязана этого делать!"

# ch/lexi/events.rpy:1745
translate russian lexi_event_02b_35bc8267:
    "Лекси останавливается и хмурится, словно не понимая."

# ch/lexi/events.rpy:1746
translate russian lexi_event_02b_07a206da:
    "Наверное, она не привыкла, чтобы парни отказывались от такого предложения."

# ch/lexi/events.rpy:1748
translate russian lexi_event_02b_06c513c3:
    lexi.say "Какого чёрта, [lssb_lexi.hero_name()]?"

# ch/lexi/events.rpy:1749
translate russian lexi_event_02b_ef10bc11:
    lexi.say "В прошлый раз тебе нравилось!"

# ch/lexi/events.rpy:1750
translate russian lexi_event_02b_de8e4213:
    "Я качаю головой, пытаясь объясниться."

# ch/lexi/events.rpy:1751
translate russian lexi_event_02b_47a50c61:
    mike.say "Дело не в этом, Лекси."

# ch/lexi/events.rpy:1752
translate russian lexi_event_02b_7251624f:
    mike.say "Послушай, ты мне очень нравишься. Правда."

# ch/lexi/events.rpy:1753
translate russian lexi_event_02b_09883fbd:
    mike.say "Но ты не обязана сосать мне член только потому, что я хорошо к тебе отнёсся!"

# ch/lexi/events.rpy:1754
translate russian lexi_event_02b_83cfebe3:
    mike.say "Это не значит, что ты должна дать мне что-то взамен."

# ch/lexi/events.rpy:1755
translate russian lexi_event_02b_5aecfff4:
    mike.say "Иногда достаточно просто быть благодарной и сказать об этом."

# ch/lexi/events.rpy:1757
translate russian lexi_event_02b_a02f0d76:
    "Поначалу Лекси выглядит изрядно задетой."

# ch/lexi/events.rpy:1758
translate russian lexi_event_02b_21adc391:
    "Но я вижу, что она обдумывает мои слова."

# ch/lexi/events.rpy:1759
translate russian lexi_event_02b_ede8bd4b:
    lexi.say "Я... я просто подумала..."

# ch/lexi/events.rpy:1761
translate russian lexi_event_02b_280e4188:
    lexi.say "Прости..."

# ch/lexi/events.rpy:1762
translate russian lexi_event_02b_b9a1fe44:
    lexi.say "Я не привыкла, чтобы люди были ко мне добры."

# ch/lexi/events.rpy:1763
translate russian lexi_event_02b_be9a7aa9:
    lexi.say "И ничего за это не хотели."

# ch/lexi/events.rpy:1764
translate russian lexi_event_02b_229d13da:
    "Я улыбаюсь, стараясь показать Лекси, что не сержусь."

# ch/lexi/events.rpy:1766
translate russian lexi_event_02b_3c258f65_1:
    "Она, кажется, понимает и слабо улыбается в ответ."

# ch/lexi/events.rpy:1767
translate russian lexi_event_02b_9fa4096c_1:
    mike.say "Если тебе важно это знать, Лекси, я прощаю тебя за бумажник."

# ch/lexi/events.rpy:1768
translate russian lexi_event_02b_d2a644cb_1:
    mike.say "И сегодня мне было с тобой здорово!"

# ch/lexi/events.rpy:1770
translate russian lexi_event_02b_8c9ba473_1:
    lexi.say "Правда?"

# ch/lexi/events.rpy:1772
translate russian lexi_event_02b_de6e9d6e_1:
    lexi.say "Ну... можем ещё потусить вместе, да?"

# ch/lexi/events.rpy:1773
translate russian lexi_event_02b_02362df0_1:
    mike.say "Конечно, Лекси."

# ch/lexi/events.rpy:1774
translate russian lexi_event_02b_c4395abe_1:
    mike.say "Мой номер у тебя есть, так что звони!"

# ch/lexi/events.rpy:1776
translate russian lexi_event_02b_1e96fc93:
    "Я ухожу, оставив Лекси у входа в торговый центр."

# ch/lexi/events.rpy:1778
translate russian lexi_event_02b_0282e507:
    "Обернувшись, вижу, что она всё ещё стоит там и смотрит мне вслед."

# ch/lexi/events.rpy:1779
translate russian lexi_event_02b_85c009c5:
    "За наше недолгое знакомство я ещё не видел её такой."

# ch/lexi/events.rpy:1780
translate russian lexi_event_02b_d8801eea:
    "Лекси выглядит задумчивой, словно ей о многом предстоит поразмыслить."

# ch/lexi/events.rpy:1790
translate russian lexi_event_03_look_b4dee748:
    "Неделя на работе выдалась адская, ни на что другое мыслей не оставалось."

# ch/lexi/events.rpy:1791
translate russian lexi_event_03_look_6447e5fc:
    "Но стоило перевести дух, как мой помешанный на сексе мозг напомнил о Лекси."

# ch/lexi/events.rpy:1792
translate russian lexi_event_03_look_d5578a01:
    "Точнее, о её телесных прелестях и о том, что они делали со мной вблизи."

# ch/lexi/events.rpy:1793
translate russian lexi_event_03_look_c5ccc3a1:
    "Назовите меня романтиком, но фигура этой девицы из трейлерного парка вдруг стала интересовать меня куда больше цифр в таблицах."

# ch/lexi/events.rpy:1794
translate russian lexi_event_03_look_cbab76f9:
    "Однако, когда я взял телефон и позвонил ей, никто не ответил."

# ch/lexi/events.rpy:1795
translate russian lexi_event_03_look_2f9337fd:
    "Каждый раз гудки сменялись голосовой почтой. На сообщения ответа тоже не было."

# ch/lexi/events.rpy:1796
translate russian lexi_event_03_look_97497c46:
    "Странно: насколько я знал Лекси, телефон у неё словно прирос к руке."

# ch/lexi/events.rpy:1797
translate russian lexi_event_03_look_2449b890:
    "И если её рот не высказывал своё мнение и не обхватывал чей-то член, то обычно болтал по телефону."

# ch/lexi/events.rpy:1798
translate russian lexi_event_03_look_7e25206e:
    "Может, стоит её поискать..."

# ch/lexi/events.rpy:1803
translate russian look_for_lexi_park_c7be06d3:
    "Я обхожу весь парк в поисках Лекси, но ничего."

# ch/lexi/events.rpy:1808
translate russian look_for_lexi_mall_e609a965:
    "Я обхожу весь торговый центр в поисках Лекси, но ничего."

# ch/lexi/events.rpy:1813
translate russian look_for_lexi_alley_a2ceaeb6:
    "Я осматриваю весь переулок в поисках Лекси, но ничего."

# ch/lexi/events.rpy:1818
translate russian look_for_lexi_club_4ae5d3c1:
    "Я обхожу весь ночной клуб в поисках Лекси, но ничего."

# ch/lexi/events.rpy:1824
translate russian lexi_event_04_66b4e730:
    "Потратив время на поиски Лекси «по старинке», я решил попробовать более современный способ."

# ch/lexi/events.rpy:1825
translate russian lexi_event_04_89ff4a77:
    "При всей своей хитрости в технике Лекси разбиралась не очень."

# ch/lexi/events.rpy:1826
translate russian lexi_event_04_5bd1fbad:
    "Поэтому я быстро нашёл её телефон через приложение на своём."

# ch/lexi/events.rpy:1827
translate russian lexi_event_04_bd9829b8:
    "Увидев адрес, я покачал головой и невесело усмехнулся."

# ch/lexi/events.rpy:1828
translate russian lexi_event_04_cec0d20e:
    "Очевиднее было бы только объявление о почасовой аренде развратных грудастых девиц в крошечных джинсовых шортах."

# ch/lexi/events.rpy:1829
translate russian lexi_event_04_b303a61a:
    "Сейчас был мой обеденный перерыв, но я решил: какого чёрта."

# ch/lexi/events.rpy:1830
translate russian lexi_event_04_36cf9f38:
    "Прыгнул в машину и уже через пару минут был на месте."

# ch/lexi/events.rpy:1832
translate russian lexi_event_04_159d06b0:
    "Трейлерный парк оказался примерно таким, как я ожидал."

# ch/lexi/events.rpy:1833
translate russian lexi_event_04_b33e3203:
    "Обшарпанные трейлеры с угрюмыми, неприветливыми обитателями тянулись до самого горизонта."

# ch/lexi/events.rpy:1834
translate russian lexi_event_04_77abd5f5:
    "Мне вдруг стало неуютно под подозрительными взглядами людей в кепках MAGA и майках-алкоголичках, сидящих на складных стульях."

# ch/lexi/events.rpy:1835
translate russian lexi_event_04_7cbbf25d:
    "Я остановился у особенно убогого трейлера, заметив Лекси, сидящую на корточках наверху ступенек перед открытой дверью."

# ch/lexi/events.rpy:1836
translate russian lexi_event_04_caad210e:
    "Она курила и словно изо всех сил старалась не смотреть на проходящих мимо."

# ch/lexi/events.rpy:1837
translate russian lexi_event_04_fef55b56:
    mike.say "Лекси... эй, Лекси, как дела?"

# ch/lexi/events.rpy:1838
translate russian lexi_event_04_4e92a89f:
    "Узнав мой голос, Лекси невольно оживляется и поднимает голову, не успев себя остановить."

# ch/lexi/events.rpy:1840
translate russian lexi_event_04_fba49cbf:
    "Прежде чем она резко отворачивается, я замечаю фиолетовые пятна, похожие на синяки, и красноту крови."

# ch/lexi/events.rpy:1841
translate russian lexi_event_04_43f05cf2:
    mike.say "Чёрт, Лекси! Что с тобой случилось?"

# ch/lexi/events.rpy:1842
translate russian lexi_event_04_15285212:
    lexi.say "Ничего... ничего... я просто... упала в душе, вот и всё."

# ch/lexi/events.rpy:1843
translate russian lexi_event_04_d744104c:
    "Мне сразу стыдно: первым делом я усомнился в её словах, потому что не верю, что в этом трейлере вообще есть душ."

# ch/lexi/events.rpy:1844
translate russian lexi_event_04_ecf4e6b9:
    mike.say "Нет... не упала. Иначе ты бы отшутилась, сказала, что была пьяная, обкуренная или ещё что."

# ch/lexi/events.rpy:1846
translate russian lexi_event_04_1f0284b7:
    "Лекси наконец поднимает глаза и впервые показывает ссадины и синяки."

# ch/lexi/events.rpy:1847
translate russian lexi_event_04_7fd204cd:
    mike.say "Это Дэнни с тобой сделал, да?"

# ch/lexi/events.rpy:1848
translate russian lexi_event_04_bb5a8b47:
    "Она не возражает, и это подтверждает мою правоту."

# ch/lexi/events.rpy:1849
translate russian lexi_event_04_592eb388:
    mike.say "Сутенёрская мразь!"

# ch/lexi/events.rpy:1850
translate russian lexi_event_04_84e16a4c:
    lexi.say "Он не только сутенёр. Он ещё наркотой торгует и во всяком другом замешан."

# ch/lexi/events.rpy:1851
translate russian lexi_event_04_14f3a1f2:
    mike.say "Это-то тут при чём?"

# ch/lexi/events.rpy:1852
translate russian lexi_event_04_51cc5305:
    lexi.say "Он просто очень злится, когда его загоняют в какие-то рамки, вот и всё."

# ch/lexi/events.rpy:1853
translate russian lexi_event_04_f2cb48e4:
    mike.say "Да плевать мне, что его злит! Ненавижу, что эта подлая горилла поднимает на тебя руки!"

# ch/lexi/events.rpy:1854
translate russian lexi_event_04_b8c6a54d:
    lexi.say "Ну да... может, тебе стоит задуматься о том, что его злит."

# ch/lexi/events.rpy:1855
translate russian lexi_event_04_e03316ea:
    "Внезапно она звучит совершенно серьёзно, и у меня холодеет внутри."

# ch/lexi/events.rpy:1856
translate russian lexi_event_04_8b3f49d8:
    mike.say "Что это значит?"

# ch/lexi/events.rpy:1857
translate russian lexi_event_04_2a172424:
    lexi.say "Он сказал, что убьёт тебя, если я продолжу встречаться с тобой за его спиной."

# ch/lexi/events.rpy:1858
translate russian lexi_event_04_461b623d:
    lexi.say "Поэтому я не перезванивала... хотела тебя от него уберечь."

# ch/lexi/events.rpy:1859
translate russian lexi_event_04_2f9534ea:
    "До меня постепенно доходит весь смысл её слов."

# ch/lexi/events.rpy:1860
translate russian lexi_event_04_cb174f16:
    "Это не пустая угроза какого-то жалкого панка, а серьёзное обещание по-настоящему жестокого ублюдка."

# ch/lexi/events.rpy:1863
translate russian lexi_event_04_840d702e:
    "Я вспоминаю последнюю стычку с Дэнни."

# ch/lexi/events.rpy:1864
translate russian lexi_event_04_d7895417:
    "Особенно то, как близок был к тому, чтобы больше никогда не бегать и даже не ходить."

# ch/lexi/events.rpy:1865
translate russian lexi_event_04_cb39cec8:
    mike.say "Может, мне стоит отступить... уйти с территории Дэнни?"

# ch/lexi/events.rpy:1866
translate russian lexi_event_04_2ad35e67:
    lexi.say "Да, наверное, хотя бы ты будешь в безопасности..."

# ch/lexi/events.rpy:1867
translate russian lexi_event_04_7dc21927:
    "Я вижу, что Лекси оставляет фразу незаконченной, ожидая продолжения от меня."

# ch/lexi/events.rpy:1868
translate russian lexi_event_04_098c5719:
    mike.say "То есть, если я останусь рядом... он ведь так и будет тебя бить?"

# ch/lexi/events.rpy:1870
translate russian lexi_event_04_9b62081d:
    "Лекси отводит взгляд. Теперь в её глазах видны настоящая грусть и разочарование."

# ch/lexi/events.rpy:1871
translate russian lexi_event_04_19cf3b58:
    lexi.say "Ну... думаю, у него станет на один повод меньше... и это хоть что-то."

# ch/lexi/events.rpy:1879
translate russian lexi_event_04_0d176e56:
    "Глядя на то, во что он превратил Лекси, я вдруг перестаю думать о том, насколько Дэнни здоровый или опасный."

# ch/lexi/events.rpy:1880
translate russian lexi_event_04_ca8ef36b:
    "Я просто не выношу видеть её избитой и напуганной. Меня это бесит."

# ch/lexi/events.rpy:1881
translate russian lexi_event_04_d3cdd09a:
    "Неужели я так сильно в неё влюбляюсь?"

# ch/lexi/events.rpy:1882
translate russian lexi_event_04_d61f50eb:
    mike.say "Да уж, охрененный мужик — срывает злость на тебе!"

# ch/lexi/events.rpy:1883
translate russian lexi_event_04_99c736f3:
    mike.say "Посмотрим, на что способна эта тупая обезьяна против другого мужчины."

# ch/lexi/events.rpy:1885
translate russian lexi_event_04_75bc71fd:
    "Лекси поднимает на меня покрасневшие глаза, полные удивления и даже изумления."

# ch/lexi/events.rpy:1886
translate russian lexi_event_04_bfc0f0df:
    "Неужели никто прежде за неё не заступался, не боролся вот так?"

# ch/lexi/events.rpy:1888
translate russian lexi_event_04_2df5cbc2:
    "На мгновение образ девицы из трейлерного парка исчезает, и передо мной оказывается настоящая дева в беде."

# ch/lexi/events.rpy:1889
translate russian lexi_event_04_5743bc4b:
    lexi.say "[lssb_lexi.hero_name()], осторожнее. Он правда тебя убьёт!"

# ch/lexi/events.rpy:1890
translate russian lexi_event_04_bbfbe7d4:
    mike.say "Если я не убью его первым!"

# ch/lexi/events.rpy:1891
translate russian lexi_event_04_dfa45e5e:
    "На прощание я целую Лекси в лоб, не желая задеть и без того болезненные синяки."

# ch/lexi/events.rpy:1893
translate russian lexi_event_04_1a61b317:
    "Садясь обратно в машину, я уже начинаю взвешивать последствия своего решения."

# ch/lexi/events.rpy:1894
translate russian lexi_event_04_56b84c7b:
    "Но отступать теперь поздно. Я завожу мотор, надеясь, что ради Лекси поступил правильно."

# ch/lexi/events.rpy:1900
translate russian lexi_event_05_e640f296:
    "Звонок в дверь заставляет меня оторваться от ноутбука и потерять нить мысли."

# ch/lexi/events.rpy:1901
translate russian lexi_event_05_fe660e1e:
    "Всё ещё действуя на автомате, я встаю и иду к входной двери."

# ch/lexi/events.rpy:1902
translate russian lexi_event_05_c1ab4f3f:
    "Даже не смотрю в камеру своего дорогого навороченного звонка с доступом через интернет."

# ch/lexi/events.rpy:1905
translate russian lexi_event_05_82327c8b:
    "Несмотря на цепочку, в щель внезапно просовывается огромная татуированная рука и хватает меня за горло."

# ch/lexi/events.rpy:1906
translate russian lexi_event_05_c531bd46:
    "Я издаю сдавленный звук, когда меня отбрасывают назад, а кто-то бьёт ногой в дверь."

# ch/lexi/events.rpy:1913
translate russian lexi_event_05_5784e4f3:
    "Цепочка быстро лопается, и Дэнни беспрепятственно входит в прихожую."

# ch/lexi/events.rpy:1914
translate russian lexi_event_05_9f34c55c:
    "Явиться ко мне домой и распустить руки — кто бы это ещё мог быть?"

# ch/lexi/events.rpy:1915
translate russian lexi_event_05_db3ca7fb:
    "Наверное, стоит удивиться, что слюнявой обезьяне хватило ума позвонить, а не колотить в дверь и орать угрозы с улицы."

# ch/lexi/events.rpy:1916
translate russian lexi_event_05_845be087:
    thug_say "Поросёнок, поросёнок, впусти меня!"

# ch/lexi/events.rpy:1917
translate russian lexi_event_05_578700b7:
    "В ответ раздаётся грубый смех."

# ch/lexi/events.rpy:1918
translate russian lexi_event_05_c4e5dd77:
    "Поднявшись и всё ещё растирая горло, я замечаю за Дэнни в дверях ещё троих или четверых."

# ch/lexi/events.rpy:1919
translate russian lexi_event_05_a36ef819:
    "Похоже, он привёл друзей на подмогу."

# ch/lexi/events.rpy:1920
translate russian lexi_event_05_7aa3b541:
    thug_say "Ты знаешь, зачем я здесь, мудак."

# ch/lexi/events.rpy:1921
translate russian lexi_event_05_d337c653:
    mike.say "Дай угадаю: ты обрёл бога и стал особенно агрессивным свидетелем Иеговы?"

# ch/lexi/events.rpy:1922
translate russian lexi_event_05_c7155270:
    "Как минимум двое его дружков усмехаются, но угрожающий взгляд Дэнни сразу их затыкает."

# ch/lexi/events.rpy:1923
translate russian lexi_event_05_0d8ebbb9:
    thug_say "Не строй из себя шута. Я велел той тупой шлюхе держаться от тебя подальше."

# ch/lexi/events.rpy:1924
translate russian lexi_event_05_6fb043e0:
    thug_say "Она не послушалась, так что теперь расплачиваться тебе."

# ch/lexi/events.rpy:1927
translate russian lexi_event_05_503872fd:
    mike.say "Эй, Дэнни, минутку... что значит, ты велел ей оставить меня в покое?"

# ch/lexi/events.rpy:1928
translate russian lexi_event_05_7bccec12:
    "Дэнни хмурится, сбитый с толку и пытаясь учуять подвох."

# ch/lexi/events.rpy:1929
translate russian lexi_event_05_7c862ec5:
    mike.say "Серьёзно, мужик. Она ничего такого мне не говорила."

# ch/lexi/events.rpy:1930
translate russian lexi_event_05_047e40cc:
    mike.say "Вообще-то она сказала, что ты просто её сутенёр!"

# ch/lexi/events.rpy:1931
translate russian lexi_event_05_c68b7d8f:
    thug_say "Ну... я и есть её чёртов сутенёр!"

# ch/lexi/events.rpy:1932
translate russian lexi_event_05_3974f572:
    "Я лихорадочно ищу бумажник, возможно, нащупав способ избежать побоев, которые задумал Дэнни."

# ch/lexi/events.rpy:1933
translate russian lexi_event_05_1e97bc9c:
    mike.say "Сколько за час?"

# ch/lexi/events.rpy:1934
translate russian lexi_event_05_9894b7ab:
    mike.say "Знай я, что у вас такая договорённость, давно бы сам тебе заплатил!"

# ch/lexi/events.rpy:1935
translate russian lexi_event_05_4fd46cc8:
    "Я протягиваю несколько купюр. Всё ещё озадаченный Дэнни забирает их без малейших колебаний."

# ch/lexi/events.rpy:1936
translate russian lexi_event_05_9c422eb5:
    thug_say "Да, как скажешь. Только заруби на носу: для тебя Лекси больше не работает!"

# ch/lexi/events.rpy:1937
translate russian lexi_event_05_bca4fe6e:
    "Он уходит вместе с хохочущими дружками, наверняка потешаясь над слабаком, которого только что обобрали в собственном доме."

# ch/lexi/events.rpy:1945
translate russian lexi_event_05_29a473d8:
    thug_say "Я обещал Лекси, что не стану выбивать из тебя дерьмо."

# ch/lexi/events.rpy:1946
translate russian lexi_event_05_166748b9:
    "Дэнни смеётся, заметив вспышку надежды в моих глазах."

# ch/lexi/events.rpy:1947
translate russian lexi_event_05_c3eb252e:
    thug_say "А вот они не обещали."

# ch/lexi/events.rpy:1948
translate russian lexi_event_05_55721901:
    "Он указывает на дружков в дверях."

# ch/lexi/events.rpy:1953
translate russian lexi_event_05_192a0720:
    "Я не знаю, откуда прилетает первый удар, только чувствую, как от него шатает."

# ch/lexi/events.rpy:1958
translate russian lexi_event_05_29d72a75:
    "Не успеваю даже прикрыть голову: удары сыплются со всех сторон."

# ch/lexi/events.rpy:1959
translate russian lexi_event_05_d8db28a6:
    "Единственная милость в том, что из-за множества ударов и невозможности защититься я быстро оказываюсь на полу."

# ch/lexi/events.rpy:1960
translate russian lexi_event_05_f8139e7c:
    "Когда я лежу в прихожей, они быстро теряют интерес."

# ch/lexi/events.rpy:1961
translate russian lexi_event_05_f2dd6b82:
    "Я чувствую лишь несколько пинков в живот и пах, прежде чем меня оставляют в покое."

# ch/lexi/events.rpy:1963
translate russian lexi_event_05_95945a35:
    "Последнее, что ощущаю: кто-то шарит по карманам, забирая бумажник и телефон."

# ch/lexi/events.rpy:1964
translate russian lexi_event_05_d5d05d1d:
    "Уверен, что это Дэнни, только потому, что он задерживается и шипит мне на ухо какую-то угрозу."

# ch/lexi/events.rpy:1965
translate russian lexi_event_05_6f5ca545:
    "В моём оглушённом состоянии слова не складываются в смысл, но главную мысль я всё равно понимаю."

# ch/lexi/events.rpy:1976
translate russian lexi_event_05_d7014e4f:
    mike.say "Господи, Дэнни, насколько же ты, блядь, тупой?"

# ch/lexi/events.rpy:1977
translate russian lexi_event_05_fa5c87b1:
    thug_say "Как ты меня только что назвал?!"

# ch/lexi/events.rpy:1978
translate russian lexi_event_05_af271453:
    mike.say "Попробуй слушать, мужик. Я тебя никак не называл, я задал вопрос."

# ch/lexi/events.rpy:1979
translate russian lexi_event_05_5ef42602:
    mike.say "Такие приёмы, может, и работают в подворотне или захудалом клубе."

# ch/lexi/events.rpy:1980
translate russian lexi_event_05_840bdbe3:
    mike.say "Но оглянись: это пригород. Пока вы шли к моей двери, вас заснял десяток камер!"

# ch/lexi/events.rpy:1981
translate russian lexi_event_05_bbc2199c:
    "Дружки Дэнни начинают нервно оглядываться, переговариваться и пятиться."

# ch/lexi/events.rpy:1983
translate russian lexi_event_05_d980e6b6:
    "Сам Дэнни тоже уже менее уверен и пытается вернуть былую грозность."

# ch/lexi/events.rpy:1984
translate russian lexi_event_05_4a7e19ce:
    mike.say "Давай так, Дэнни."

# ch/lexi/events.rpy:1985
translate russian lexi_event_05_db58a80a:
    mike.say "С Лекси ты уже своё содрал."

# ch/lexi/events.rpy:1987
translate russian lexi_event_05_a46cdf13:
    mike.say "Но теперь она беременна от меня. Пора тебе искать другую беззащитную девушку, чтобы ею пользоваться."

# ch/lexi/events.rpy:1989
translate russian lexi_event_05_51f8bd8a:
    mike.say "Но теперь она моя. Пора тебе искать другую беззащитную девушку, чтобы ею пользоваться."

# ch/lexi/events.rpy:1990
translate russian lexi_event_05_f8a2048a:
    mike.say "Уходи и оставь нас в покое. Тогда я не вызову полицию и не передам ей записи с камер."

# ch/lexi/events.rpy:1991
translate russian lexi_event_05_a3881cdf:
    "Дэнни собирается с силами для последней попытки, но один из дружков кладёт ему руку на плечо и качает головой."

# ch/lexi/events.rpy:1992
translate russian lexi_event_05_efbe11dd:
    "Уходя, Дэнни бормочет что-то похожее на угрозу, но звучит это вяло и жалко."

# ch/lexi/events.rpy:1997
translate russian lexi_event_05_a4a15bc1:
    thug_say "Я обещал Лекси тебя не трогать. Но эти парни ничего не обещали!"

# ch/lexi/events.rpy:2000
translate russian lexi_event_05_4ec0f680:
    "Дэнни машет дружкам вперёд. Теперь я вижу, что их трое."

# ch/lexi/events.rpy:2001
translate russian lexi_event_05_f0482077:
    "К счастью, оружия у них нет, и навалиться всем разом они не догадываются."

# ch/lexi/events.rpy:2002
translate russian lexi_event_05_549504b4:
    "Первый, крысолицый тип в джинсовом жилете, неуклюже замахивается и получает за это кулаком в пах."

# ch/lexi/events.rpy:2007
translate russian lexi_event_05_05322604:
    "Второй, бритоголовый жирдяй, подставляется под удар ногой в живот, ещё не заметив, что приятель уже упал."

# ch/lexi/events.rpy:2012
translate russian lexi_event_05_4bc6777d:
    "Третий и последний, здоровый бородатый байкер, почти сам налетает на кулак, который размазывает его нос по левой щеке."

# ch/lexi/events.rpy:2016
translate russian lexi_event_05_e74b04ce:
    "Все трое его прихвостней валяются на земле, и теперь все взгляды обращаются к Дэнни."

# ch/lexi/events.rpy:2017
translate russian lexi_event_05_b00ddbbf:
    "Я смотрю на него, гадая, станет ли он четвёртым, а его поверженные дружки ждут, заставит ли он меня поплатиться."

# ch/lexi/events.rpy:2019
translate russian lexi_event_05_dcc422bc:
    "Дэнни смотрит на меня, потом на них, а затем снова на меня."

# ch/lexi/events.rpy:2022
translate russian lexi_event_05_15809827:
    "Может, он и правда наложил в штаны, а может, вспоминает, как я надрал ему задницу в прошлый раз."

# ch/lexi/events.rpy:2025
translate russian lexi_event_05_7018f610:
    "Не говоря ни слова, Дэнни разворачивается и выбегает за дверь."

# ch/lexi/events.rpy:2027
translate russian lexi_event_05_dd7b5e8d:
    "Его дружки на мгновение замирают от удивления, но секунд через десять поднимаются и бегут следом."

# ch/lexi/events.rpy:2030
translate russian lexi_event_05_a2b18c08:
    "Наконец закрыв входную дверь на оба засова, я только теперь замечаю, что меня трясёт как осиновый лист."

# ch/lexi/events.rpy:2031
translate russian lexi_event_05_08c60575:
    "В эту секунду я не думаю ни о последствиях случившегося, ни о том, кто вышел победителем."

# ch/lexi/events.rpy:2032
translate russian lexi_event_05_231334d2:
    "Я лишь судорожно перевожу дух и надеюсь, что больше никогда не увижу Дэнни."

# ch/lexi/events.rpy:2033
translate russian lexi_event_05_5242be45:
    "Ни у себя на пороге, ни где-либо ещё."

# ch/lexi/events.rpy:2039
translate russian lexi_event_06_e48e1c5c:
    "Не могу вспомнить, было ли во сне что-нибудь приятное: телефон бесцеремонно будит меня, и сон тут же вылетает из головы."

# ch/lexi/events.rpy:2040
translate russian lexi_event_06_e9e0abd8:
    "Спросонья я сначала замечаю, что для звонков ещё слишком рано, а затем — что звонит Лекси."

# ch/lexi/events.rpy:2048
translate russian lexi_event_06_81a44b64:
    "Не знаю, что сейчас раздражает меня сильнее, но всё-таки решаю ответить."

# ch/lexi/events.rpy:2049
translate russian lexi_event_06_bf69e6de:
    mike.say "Я бы спросил, знаешь ли ты, который час, Лекси."

# ch/lexi/events.rpy:2050
translate russian lexi_event_06_abe9b387:
    mike.say "Но что мне это даст..."

# ch/lexi/events.rpy:2051
translate russian lexi_event_06_230bee1f:
    thug_say "Хрен да ни хрена, мудак! Причём хрен уже свалил из города!"

# ch/lexi/events.rpy:2052
translate russian lexi_event_06_4f390ad4:
    "Услышав издевательский голос Дэнни, я от неожиданности едва не роняю телефон."

# ch/lexi/events.rpy:2053
translate russian lexi_event_06_146d9263:
    mike.say "Дэнни... какого хрена?!"

# ch/lexi/events.rpy:2054
translate russian lexi_event_06_29567372:
    thug_say "Угадал, урод."

# ch/lexi/events.rpy:2055
translate russian lexi_event_06_3d56c352:
    mike.say "Где Лекси?.. Что ты с ней сделал?"

# ch/lexi/events.rpy:2056
translate russian lexi_event_06_d429e25f:
    thug_say "Успокойся, чувак. Я ничего ей не сделал... пока!"

# ch/lexi/events.rpy:2057
translate russian lexi_event_06_ac696254:
    mike.say "Сволочь! Отпусти её, или я вызову полицию!"

# ch/lexi/events.rpy:2058
translate russian lexi_event_06_00f57a36:
    thug_say "А вот этого не надо. Это между нами."

# ch/lexi/events.rpy:2060
translate russian lexi_event_06_645adf44:
    thug_say "Позвонишь копам — они найдут от неё только куски. От ребёнка тоже."

# ch/lexi/events.rpy:2062
translate russian lexi_event_06_1dec2d3c:
    thug_say "Позвонишь копам — они найдут от неё только куски."

# ch/lexi/events.rpy:2063
translate russian lexi_event_06_705036c4:
    mike.say "Сволочь!"

# ch/lexi/events.rpy:2064
translate russian lexi_event_06_5fdedecf:
    thug_say "Ага, это ты уже говорил."

# ch/lexi/events.rpy:2065
translate russian lexi_event_06_e8065569:
    thug_say "Слушай, если она тебе так дорога, приезжай по адресу, который я скину, когда закончим разговор."

# ch/lexi/events.rpy:2066
translate russian lexi_event_06_3388f6c5:
    thug_say "Хочешь снова её увидеть, причём живой, — приезжай быстро и один."

# ch/lexi/events.rpy:2068
translate russian lexi_event_06_1d6ba1e4:
    "После того как он кладёт трубку, меня мутит при мысли о том, что он может сделать с Лекси и ребёнком."

# ch/lexi/events.rpy:2070
translate russian lexi_event_06_954bab8f:
    "После того как он кладёт трубку, меня мутит при мысли о том, что он может сделать с Лекси."

# ch/lexi/events.rpy:2073
translate russian lexi_event_06_86ed0cf8:
    "Я в ужасе от мысли о том, что Дэнни сделает с Лекси, если я всё же вызову полицию."

# ch/lexi/events.rpy:2074
translate russian lexi_event_06_545ff89c:
    "Но в то же время внутри всё кричит: я знаю одну полицейскую, которая покруче остальных."

# ch/lexi/events.rpy:2075
translate russian lexi_event_06_c7306abe:
    "Из тех, кто таких ублюдков, как он, на завтрак ест!"

# ch/lexi/events.rpy:2076
translate russian lexi_event_06_77caecbc:
    "Больше не раздумывая, я набираю номер Камилы и нетерпеливо жду ответа."

# ch/lexi/events.rpy:2077
translate russian lexi_event_06_2412e0b9:
    camila.say "[lssb_lexi.hero_name()]..."

# ch/lexi/events.rpy:2078
translate russian lexi_event_06_3cdfc184:
    camila.say "Что случилось?"

# ch/lexi/events.rpy:2079
translate russian lexi_event_06_8f73a0bc:
    mike.say "Камила... Камила..."

# ch/lexi/events.rpy:2080
translate russian lexi_event_06_72395d94:
    mike.say "Мне нужна твоя помощь!"

# ch/lexi/events.rpy:2081
translate russian lexi_event_06_5940a423:
    mike.say "Прямо сейчас!"

# ch/lexi/events.rpy:2082
translate russian lexi_event_06_1016b792:
    "Я уже почти в истерике и чуть ли не кричу в трубку."

# ch/lexi/events.rpy:2083
translate russian lexi_event_06_152e1591:
    camila.say "Эй!"

# ch/lexi/events.rpy:2084
translate russian lexi_event_06_48567857:
    camila.say "Притормози..."

# ch/lexi/events.rpy:2085
translate russian lexi_event_06_0a41be0c:
    camila.say "Расскажи, что случилось, хорошо?"

# ch/lexi/events.rpy:2086
translate russian lexi_event_06_e3b14c88:
    "Мне удаётся немного взять себя в руки."

# ch/lexi/events.rpy:2087
translate russian lexi_event_06_ec22c457:
    "И тогда я стараюсь объяснить всё толком."

# ch/lexi/events.rpy:2088
translate russian lexi_event_06_55973e69:
    mike.say "Это Лекси..."

# ch/lexi/events.rpy:2089
translate russian lexi_event_06_40b463d1:
    mike.say "Её похитили!"

# ch/lexi/events.rpy:2091
translate russian lexi_event_06_1102608b:
    camila.say "ЧТО?!"

# ch/lexi/events.rpy:2092
translate russian lexi_event_06_07a918b1:
    camila.say "Кто её похитил, [lssb_lexi.hero_name()]?"

# ch/lexi/events.rpy:2093
translate russian lexi_event_06_2d66018f:
    camila.say "Пусть готовятся ответить передо мной!"

# ch/lexi/events.rpy:2095
translate russian lexi_event_06_9e80b01c:
    camila.say "Это та самая Лекси, которую я знаю по уличным делам?"

# ch/lexi/events.rpy:2096
translate russian lexi_event_06_6e36a9dc:
    camila.say "Та, которую я уже раз сто задерживала?"

# ch/lexi/events.rpy:2097
translate russian lexi_event_06_9bcfdb67:
    mike.say "Э-э... да..."

# ch/lexi/events.rpy:2098
translate russian lexi_event_06_0b1401fe:
    mike.say "Это что-то меняет?"

# ch/lexi/events.rpy:2099
translate russian lexi_event_06_e3f61bc7:
    camila.say "Вообще-то нет. На моей территории женщин похищать не позволю!"

# ch/lexi/events.rpy:2100
translate russian lexi_event_06_4a8c335c:
    camila.say "Даже если они последние шлюхи..."

# ch/lexi/events.rpy:2101
translate russian lexi_event_06_8747c08a:
    mike.say "Парня, который это сделал, зовут Дэнни."

# ch/lexi/events.rpy:2102
translate russian lexi_event_06_b2c8be61:
    mike.say "Он сказал, где с ним встретиться."

# ch/lexi/events.rpy:2103
translate russian lexi_event_06_7d9eb25f:
    mike.say "Но ещё запретил звонить в полицию!"

# ch/lexi/events.rpy:2104
translate russian lexi_event_06_8770608b:
    "На другом конце провода Камила усмехается."

# ch/lexi/events.rpy:2105
translate russian lexi_event_06_7391612e:
    camila.say "А ты и не звонил в полицию, [lssb_lexi.hero_name()]."

# ch/lexi/events.rpy:2106
translate russian lexi_event_06_10c5383c:
    camila.say "Ты просто позвонил подруге!"

# ch/lexi/events.rpy:2107
translate russian lexi_event_06_d7a3bab6:
    camila.say "А теперь оставайся на месте. Я уже еду!"

# ch/lexi/events.rpy:2109
translate russian lexi_event_06_bd11a03b:
    "Я с нетерпением жду Камилу."

# ch/lexi/events.rpy:2110
translate russian lexi_event_06_f3ceb22f:
    "И когда её патрульная машина с визгом тормозит у дома, спешу к ней."

# ch/lexi/events.rpy:2112
translate russian lexi_event_06_feaadcf6:
    "Она толкает дверцу и жестом велит мне садиться."

# ch/lexi/events.rpy:2114
translate russian lexi_event_06_c31df2fc:
    "Затем мы мчимся туда, где Дэнни назначил встречу."

# ch/lexi/events.rpy:2115
translate russian lexi_event_06_d22128f1:
    "На месте я вижу очередной переулок, словно специально созданный для тёмных делишек."

# ch/lexi/events.rpy:2116
translate russian lexi_event_06_f8625163:
    "Что у него за страсть к переулкам?"

# ch/lexi/events.rpy:2117
translate russian lexi_event_06_5aec235f:
    "У него что, аллергия на чистоту и открытые пространства?"

# ch/lexi/events.rpy:2124
translate russian lexi_event_06_7ace5f2d:
    "Мы выходим из машины, и Камила кивает на вход в переулок."

# ch/lexi/events.rpy:2125
translate russian lexi_event_06_325e8a92:
    camila.say "Иди туда первым."

# ch/lexi/events.rpy:2126
translate russian lexi_event_06_f528b8d9:
    camila.say "Веди себя так, будто меня здесь нет."

# ch/lexi/events.rpy:2127
translate russian lexi_event_06_19e94e7c:
    "Я невольно сглатываю от страха и волнения."

# ch/lexi/events.rpy:2128
translate russian lexi_event_06_af5d813f:
    mike.say "Уверена, что это хорошая идея?"

# ch/lexi/events.rpy:2129
translate russian lexi_event_06_57d84e5e:
    mike.say "А если он на меня набросится?"

# ch/lexi/events.rpy:2131
translate russian lexi_event_06_88ae4f4d:
    "Камила криво улыбается и достаёт пистолет."

# ch/lexi/events.rpy:2132
translate russian lexi_event_06_03a9a743:
    camila.say "Ни о чём не волнуйся."

# ch/lexi/events.rpy:2133
translate russian lexi_event_06_10482580:
    camila.say "Я всё время буду тебя прикрывать."

# ch/lexi/events.rpy:2134
translate russian lexi_event_06_ad852fe4:
    "Я киваю и поворачиваюсь ко входу в переулок."

# ch/lexi/events.rpy:2135
translate russian lexi_event_06_b30ce139:
    "Изо всех сил стараясь не показывать, как мне страшно."

# ch/lexi/events.rpy:2137
translate russian lexi_event_06_3a126305:
    mike.say "Лекси... ты здесь?"

# ch/lexi/events.rpy:2138
translate russian lexi_event_06_3c5b9d83:
    mike.say "Это я, [lssb_lexi.hero_name()]."

# ch/lexi/events.rpy:2142
translate russian lexi_event_06_59335764:
    "Вдруг я замечаю Лекси: она лежит на боку, руки связаны за спиной, а во рту — шарик-кляп."

# ch/lexi/events.rpy:2143
translate russian lexi_event_06_d4f6caba:
    "Я устремляюсь к ней, но тут вижу, как её глаза расширяются: она смотрит мне за плечо."

# ch/lexi/events.rpy:2145
translate russian lexi_event_06_ecba7ffa:
    "Я ещё не успеваю обернуться и посмотреть, на что уставилась Лекси, как раздаётся оглушительный грохот."

# ch/lexi/events.rpy:2148
translate russian lexi_event_06_8c38c106:
    "За ним следуют звон металла и крик боли."

# ch/lexi/events.rpy:2151
translate russian lexi_event_06_32ad1d8b:
    "Я резко оборачиваюсь и вижу Дэнни, которого застигли в момент прыжка из тени."

# ch/lexi/events.rpy:2152
translate russian lexi_event_06_8069ee7a:
    "Он держится за запястье, из глубокой раны уже хлещет кровь."

# ch/lexi/events.rpy:2153
translate russian lexi_event_06_2958344a:
    "Бросив взгляд вниз, я замечаю у его ног пару устрашающих мачете."

# ch/lexi/events.rpy:2155
translate russian lexi_event_06_f7fe68b4:
    camila.say "Не двигайся, урод!"

# ch/lexi/events.rpy:2157
translate russian lexi_event_06_fd8c3d1a:
    camila.say "Первый выстрел был предупредительным."

# ch/lexi/events.rpy:2158
translate russian lexi_event_06_de709696:
    camila.say "Следующий будет прямо между глаз!"

# ch/lexi/events.rpy:2159
translate russian lexi_event_06_bcbdc8a4:
    danny.say "Вот блядь..."

# ch/lexi/events.rpy:2160
translate russian lexi_event_06_bcbdc8a4_1:
    danny.say "Вот блядь..."

# ch/lexi/events.rpy:2162
translate russian lexi_event_06_95d2e9ca:
    danny.say "Ты в меня выстрелила, сука!"

# ch/lexi/events.rpy:2169
translate russian lexi_event_06_e72f6347:
    "Камила подходит к Дэнни, не обращая внимания на его ошалелые вопли."

# ch/lexi/events.rpy:2170
translate russian lexi_event_06_f0a4ece7:
    "Затем грубо прижимает его к стене и, надевая наручники, нарочно дёргает за раненую руку."

# ch/lexi/events.rpy:2178
translate russian lexi_event_06_cfaf723e:
    "Пока она запихивает Дэнни на заднее сиденье патрульной машины, я спешу к Лекси."

# ch/lexi/events.rpy:2182
translate russian lexi_event_06_5e904a76:
    lexi.say "Блядь... блядь... Как же я рада, что ты цел!"

# ch/lexi/events.rpy:2183
translate russian lexi_event_06_da48299b:
    mike.say "Да чёрт со мной! Ты-то как?"

# ch/lexi/events.rpy:2188
translate russian lexi_event_06_d0c9ae6a:
    "Вместо ответа Лекси обвивает меня руками и с такой внезапной яростью впивается в мои губы, что я теряюсь."

# ch/lexi/events.rpy:2190
translate russian lexi_event_06_f01a427e:
    camila.say "Эй!"

# ch/lexi/events.rpy:2192
translate russian lexi_event_06_bb550b9a:
    camila.say "А как же я, Лекси?"

# ch/lexi/events.rpy:2194
translate russian lexi_event_06_b84079f9:
    camila.say "Это я подстрелила этого мудака!"

# ch/lexi/events.rpy:2197
translate russian lexi_event_06_e1e94c57:
    camila.say "Кхм..."

# ch/lexi/events.rpy:2202
translate russian lexi_event_06_1b73e49f:
    "Лекси прерывает поцелуй, когда к нам подходит Камила."

# ch/lexi/events.rpy:2203
translate russian lexi_event_06_ec087833:
    lexi.say "Ну..."

# ch/lexi/events.rpy:2204
translate russian lexi_event_06_586da4d2:
    lexi.say "Что теперь будет с Дэнни?"

# ch/lexi/events.rpy:2206
translate russian lexi_event_06_28b809c9:
    camila.say "Отвезу его в участок и предъявлю обвинение. Вот что!"

# ch/lexi/events.rpy:2208
translate russian lexi_event_06_eadb58ab:
    camila.say "Вооружённое похищение вдобавок ко всему, что он уже успел натворить?"

# ch/lexi/events.rpy:2210
translate russian lexi_event_06_0bb35d03:
    camila.say "Думаю, он сядет ОЧЕНЬ надолго!"

# ch/lexi/events.rpy:2211
translate russian lexi_event_06_dbf500bf:
    "Мы с Лекси и Камилой ещё немного разговариваем."

# ch/lexi/events.rpy:2212
translate russian lexi_event_06_6bc9a7ea:
    "В основном убеждаемся, что с Лекси всё в порядке."

# ch/lexi/events.rpy:2214
translate russian lexi_event_06_193fd330:
    "Потом Камила прощается: ей пора везти Дэнни в участок."

# ch/lexi/events.rpy:2215
translate russian lexi_event_06_de2c88df:
    "А мне остаётся проводить Лекси домой."

# ch/lexi/events.rpy:2216
translate russian lexi_event_06_2589ebf5:
    "Ну и надеяться, что больше мы Дэнни не увидим."

# ch/lexi/events.rpy:2223
translate russian lexi_event_06_dff04ef2:
    "Я вскакиваю с постели, кое-как натягиваю одежду и выбегаю из дома."

# ch/lexi/events.rpy:2224
translate russian lexi_event_06_6d99b02d:
    "Я сижу в панике, кажется, целую вечность, прежде чем с телефона Лекси приходит обещанное сообщение."

# ch/lexi/events.rpy:2225
translate russian lexi_event_06_e4c5c439:
    "Вбив адрес в навигатор, я вижу очередной переулок, словно специально созданный для тёмных делишек."

# ch/lexi/events.rpy:2226
translate russian lexi_event_06_f8625163_1:
    "Что у него за страсть к переулкам?"

# ch/lexi/events.rpy:2227
translate russian lexi_event_06_5aec235f_1:
    "У него что, аллергия на чистоту и открытые пространства?"

# ch/lexi/events.rpy:2229
translate russian lexi_event_06_56d54a94:
    "Всю дорогу я то гоню во весь опор, то отчаянно пытаюсь сбавить скорость, чтобы не вызвать подозрений."

# ch/lexi/events.rpy:2231
translate russian lexi_event_06_652c0194:
    "Я добираюсь за двадцать минут и, увидев вход в переулок, тут же жалею, что не взял пистолет."

# ch/lexi/events.rpy:2232
translate russian lexi_event_06_c8cefabc:
    "Глубоко вздохнув, я вхожу в совсем не приветливую темноту."

# ch/lexi/events.rpy:2233
translate russian lexi_event_06_3a126305_1:
    mike.say "Лекси... ты здесь?"

# ch/lexi/events.rpy:2234
translate russian lexi_event_06_3c5b9d83_1:
    mike.say "Это я, [lssb_lexi.hero_name()]."

# ch/lexi/events.rpy:2236
translate russian lexi_event_06_59335764_1:
    "Вдруг я замечаю Лекси: она лежит на боку, руки связаны за спиной, а во рту — шарик-кляп."

# ch/lexi/events.rpy:2237
translate russian lexi_event_06_d4f6caba_1:
    "Я устремляюсь к ней, но тут вижу, как её глаза расширяются: она смотрит мне за плечо."

# ch/lexi/events.rpy:2239
translate russian lexi_event_06_74df3949:
    "На долю секунды позже, чем нужно, я понимаю, что она что-то увидела у меня за спиной."

# ch/lexi/events.rpy:2247
translate russian lexi_event_06_9d84881a:
    "Ещё через мгновение что-то тяжёлое и острое с силой врезается мне в живот."

# ch/lexi/events.rpy:2251
translate russian lexi_event_06_32f69787:
    "Я не успеваю ни среагировать, ни даже вскрикнуть и оседаю на землю."

# ch/lexi/events.rpy:2256
translate russian lexi_event_06_b7cf8571:
    "Я едва слышу крики Лекси сквозь кляп, пока Дэнни перешагивает через меня, чтобы поглумиться."

# ch/lexi/events.rpy:2257
translate russian lexi_event_06_1b29e0a9:
    "Он что-то говорит, размахивая передо мной парой мачете."

# ch/lexi/events.rpy:2258
translate russian lexi_event_06_0ba0ed5f:
    "Кровь с одного из них капает на землю и брызгает на Лекси, заставляя её вздрагивать и отшатываться."

# ch/lexi/events.rpy:2259
translate russian lexi_event_06_07a2b1a5:
    "Боли нет, лишь слабость, из-за которой я не могу пошевелиться... даже поднять голову."

# ch/lexi/events.rpy:2260
translate russian lexi_event_06_06113d63:
    "Всё кажется всё менее реальным, пока я смотрю, как Дэнни заставляет Лекси подняться на ноги."

# ch/lexi/events.rpy:2261
translate russian lexi_event_06_e8f95b5d:
    "Будто смотрю немое кино: он бесцеремонно стягивает с неё шорты и расстёгивает ширинку."

# ch/lexi/events.rpy:2262
translate russian lexi_event_06_b79f23e8:
    "Наверное, это должно стать последним унижением: он трахает её у меня на глазах, пока я умираю."

# ch/lexi/events.rpy:2267
translate russian lexi_event_06_f544c97a:
    "Но сейчас всё это кажется таким далёким, что я даже не..."

# ch/lexi/events.rpy:2268
translate russian lexi_event_06_b6f24799:
    "Я даже не помню, почему я здесь."

# ch/lexi/events.rpy:2269
translate russian lexi_event_06_7664ff2d:
    "А потом всё погружается во тьму."

# ch/lexi/events.rpy:2270
translate russian lexi_event_06_fad13a59:
    "И меня больше нигде нет."

# ch/lexi/events.rpy:2278
translate russian lexi_event_06_c792910e:
    "Поняв, что Лекси увидела опасность у меня за спиной, я инстинктивно отступаю в сторону."

# ch/lexi/events.rpy:2284
translate russian lexi_event_06_83b9a533:
    "Что-то со свистом проносится над моей головой, а затем тяжёлое лезвие со звоном врезается в мусорный контейнер рядом."

# ch/lexi/events.rpy:2287
translate russian lexi_event_06_177502b0:
    "Я разворачиваюсь, вставая между Лекси и нападающим, и ничуть не удивляюсь, увидев выходящего из тени Дэнни."

# ch/lexi/events.rpy:2288
translate russian lexi_event_06_6ac41294:
    "Он ругается себе под нос и трясёт рукой, пытаясь вернуть чувствительность после удара. Мачете, который он держал, теперь лежит на земле."

# ch/lexi/events.rpy:2289
translate russian lexi_event_06_d04b63fa:
    "Мне было бы куда спокойнее, если бы во второй руке у него не было точно такого же."

# ch/lexi/events.rpy:2293
translate russian lexi_event_06_b84b7e8d:
    "Он молча встаёт напротив меня, давая понять: всё закончится лишь тогда, когда один из нас истечёт кровью или умрёт."

# ch/lexi/events.rpy:2294
translate russian lexi_event_06_035b3210:
    "Мы оба косимся на упавший мачете, понимая, что любая попытка схватить его оставит нас без защиты."

# ch/lexi/events.rpy:2295
translate russian lexi_event_06_2b2a2547:
    "Проблема лишь в том, что преимущество, которое он дал бы мне, у Дэнни уже есть."

# ch/lexi/events.rpy:2300
translate russian lexi_event_06_c22ee0c7:
    "В конце концов я действую первым: подступаю вплотную и обеими руками хватаю его за запястье."

# ch/lexi/events.rpy:2301
translate russian lexi_event_06_756fa858:
    "Дэнни наверняка привык, что его размеры и сила заставляют людей отступать."

# ch/lexi/events.rpy:2302
translate russian lexi_event_06_8fe55c6f:
    "Поэтому я пытаюсь сыграть на этом и застать его врасплох."

# ch/lexi/events.rpy:2308
translate russian lexi_event_06_6568a3cc:
    "Он, вполне ожидаемо, начинает бить меня прямо в лицо, но не учитывает, как отчаянно мне сейчас хочется жить."

# ch/lexi/events.rpy:2313
translate russian lexi_event_06_d1acfa9a:
    "Между его ударами я отвожу голову назад и со всей силы бью лбом ему в нос, повторяя это при любой возможности."

# ch/lexi/events.rpy:2316
translate russian lexi_event_06_65c74a86:
    "Дэнни хотел освободить руку и устроить целое представление, убивая меня оставшимся мачете."

# ch/lexi/events.rpy:2317
translate russian lexi_event_06_70ca2f61:
    "А я хочу только вырубить его, и в итоге моя более простая цель берёт верх."

# ch/lexi/events.rpy:2325
translate russian lexi_event_06_7bb562eb:
    "Оглушённый, едва стоящий на ногах, он спотыкается и падает, а мачете при падении вспарывает его от живота до грудины."

# ch/lexi/events.rpy:2326
translate russian lexi_event_06_e606936e:
    "Разобравшись с Дэнни, я бросаюсь к Лекси, вытаскиваю кляп и начинаю её развязывать."

# ch/lexi/events.rpy:2331
translate russian lexi_event_06_5e904a76_1:
    lexi.say "Блядь... блядь... Как же я рада, что ты цел!"

# ch/lexi/events.rpy:2332
translate russian lexi_event_06_da48299b_1:
    mike.say "Да чёрт со мной! Ты-то как?"

# ch/lexi/events.rpy:2336
translate russian lexi_event_06_d0c9ae6a_1:
    "Вместо ответа Лекси обвивает меня руками и с такой внезапной яростью впивается в мои губы, что я теряюсь."

# ch/lexi/events.rpy:2337
translate russian lexi_event_06_da913194:
    "Все мои порезы и синяки вдруг перестают иметь значение. Пожалуй, меня можно было бы уговорить трахнуть её прямо здесь и сейчас."

# ch/lexi/events.rpy:2340
translate russian lexi_event_06_c90f7202:
    "Когда этот порыв проходит, Лекси смотрит на неподвижное тело Дэнни."

# ch/lexi/events.rpy:2341
translate russian lexi_event_06_0df1a6cc:
    lexi.say "Он... значит, умер?"

# ch/lexi/events.rpy:2342
translate russian lexi_event_06_748b458d:
    mike.say "Если только не знает, как выжить, истекая кровью с собственными кишками в руках."

# ch/lexi/events.rpy:2343
translate russian lexi_event_06_b4ab7920:
    lexi.say "Хм... Он всегда был как таракан в человеческом обличье... Наверное, я в глубине души думала, что он никогда не сдохнет."

# ch/lexi/events.rpy:2344
translate russian lexi_event_06_0938d61f:
    lexi.say "Я всегда думала, что буду плясать на его трупе и распевать какую-нибудь грёбаную песню."

# ch/lexi/events.rpy:2345
translate russian lexi_event_06_f621976c:
    lexi.say "А сейчас ничего не чувствую... Просто рада, что ты жив, а он — нет."

# ch/lexi/events.rpy:2346
translate russian lexi_event_06_be346ad9:
    "Я пожимаю плечами и на всякий случай пинаю труп."

# ch/lexi/events.rpy:2347
translate russian lexi_event_06_64a9a262:
    mike.say "По крайней мере, он больше не сможет угрожать ни тебе, ни мне."

# ch/lexi/events.rpy:2348
translate russian lexi_event_06_18723c82:
    mike.say "Только вот что нам теперь делать?"

# ch/lexi/events.rpy:2349
translate russian lexi_event_06_9fa8d94b:
    lexi.say "Сначала отрежем ему кисти и выбьем зубы, чтобы его не опознали."

# ch/lexi/events.rpy:2350
translate russian lexi_event_06_f5e821db:
    lexi.say "А потом привяжем к телу камни и сбросим в реку. Будем надеяться, рыбы всё сожрут раньше, чем кто-нибудь его вытащит."

# ch/lexi/events.rpy:2351
translate russian lexi_event_06_de278d13:
    "Я смотрю на Лекси, совершенно ошарашенный планом, который она только что изложила во всех жутких подробностях."

# ch/lexi/events.rpy:2352
translate russian lexi_event_06_8a4311ab:
    lexi.say "Что такое?"

# ch/lexi/events.rpy:2354
translate russian lexi_event_06_bec325f0:
    lexi.say "Думаешь, я по ночам не лежала без сна, придумывая, как избавиться от улик, если мне удастся самой прикончить этого ублюдка?"

# ch/lexi/events.rpy:2355
translate russian lexi_event_06_b5ed65ea:
    "Я изумлённо качаю головой, гадая, какие ещё сюрпризы таятся в неизведанных уголках разума Лекси."

# ch/lexi/events.rpy:2356
translate russian lexi_event_06_0eed71c6:
    "Но не могу отрицать: её план по крайней мере практичен, да и всё необходимое у нас под рукой."

# ch/lexi/events.rpy:2357
translate russian lexi_event_06_e6a2cdbd:
    "Я киваю и наклоняюсь за тем мачете, который не торчит в быстро остывающих кишках Дэнни."

# ch/lexi/events.rpy:2358
translate russian lexi_event_06_047a7c55:
    mike.say "Ладно, Лекси. Этот труп сам себя не изуродует."

# ch/lexi/events.rpy:2359
translate russian lexi_event_06_d47af531:
    mike.say "Давай приступим."

# ch/lexi/events.rpy:2369
translate russian lexi_event_07a_59c91302:
    "Я пыхчу и стону, с трудом затаскивая тело Дэнни в маленькую лодку."

# ch/lexi/events.rpy:2370
translate russian lexi_event_07a_61ce1a10:
    "И радуюсь, что завернул его в плёнку, прежде чем тащиться сюда."

# ch/lexi/events.rpy:2371
translate russian lexi_event_07a_b085df1b:
    "Хотя бы не придётся при этом смотреть в лицо этому подонку."

# ch/lexi/events.rpy:2372
translate russian lexi_event_07a_65c4ad34:
    "Отплывая всё дальше в море, я слышу лишь шум волн."

# ch/lexi/events.rpy:2373
translate russian lexi_event_07a_1be8aab5:
    "Но паранойя не отпускает, и я постоянно прислушиваюсь, не выдаст ли какой-нибудь звук чужое присутствие."

# ch/lexi/events.rpy:2374
translate russian lexi_event_07a_89463463:
    "В жизни я, без сомнения, попадал в немало дурацких передряг."

# ch/lexi/events.rpy:2375
translate russian lexi_event_07a_7d35f02c:
    "Но никогда не думал, что окажусь в подобной ситуации."

# ch/lexi/events.rpy:2376
translate russian lexi_event_07a_d7d39fa4:
    "Как, чёрт возьми, вышло, что я таскаю среди ночи труп?!"

# ch/lexi/events.rpy:2377
translate russian lexi_event_07a_987284eb:
    "Лекси. Вот как."

# ch/lexi/events.rpy:2378
translate russian lexi_event_07a_1847ea87:
    "Всё это из-за Лекси!"

# ch/lexi/events.rpy:2379
translate russian lexi_event_07a_237dc8af:
    "Я лишь пытался защитить её от этого урода Дэнни."

# ch/lexi/events.rpy:2380
translate russian lexi_event_07a_338ba6cd:
    "И ведь думал, что поступаю правильно."

# ch/lexi/events.rpy:2381
translate russian lexi_event_07a_42557068:
    "Рано или поздно он бы зашёл с Лекси слишком далеко."

# ch/lexi/events.rpy:2382
translate russian lexi_event_07a_7aad318d:
    "Но вместо того, чтобы он убил её, я убил его!"

# ch/lexi/events.rpy:2383
translate russian lexi_event_07a_c355ca44:
    "Надеюсь, она стоит всех этих усилий."

# ch/lexi/events.rpy:2384
translate russian lexi_event_07a_5672570b:
    "Ведь из-за неё я стал убийцей!"

# ch/lexi/events.rpy:2385
translate russian lexi_event_07a_00534e85:
    "Решив, что отплыл достаточно далеко, я стараюсь выбросить эти мысли из головы."

# ch/lexi/events.rpy:2386
translate russian lexi_event_07a_5f15ad30:
    "Потом ещё будет полно времени для мук совести."

# ch/lexi/events.rpy:2388
translate russian lexi_event_07a_ae211c8f:
    "Я подтаскиваю труп Дэнни к борту настолько близко, насколько решаюсь."

# ch/lexi/events.rpy:2389
translate russian lexi_event_07a_51f55d97:
    "Меньше всего мне хочется самому свалиться за борт, когда буду его сталкивать."

# ch/lexi/events.rpy:2390
translate russian lexi_event_07a_ccd677a1:
    "Или, ещё хуже, упасть в воду, оставив тело в арендованной мной лодке, где его кто-нибудь найдёт!"

# ch/lexi/events.rpy:2391
translate russian lexi_event_07a_fffd84d8:
    "Я на мгновение замираю, раздумывая, не сказать ли напоследок пару слов."

# ch/lexi/events.rpy:2392
translate russian lexi_event_07a_7d7e7c9c:
    "Но затем качаю головой, ругая себя за глупость."

# ch/lexi/events.rpy:2393
translate russian lexi_event_07a_34b86e96:
    "Я ведь не собрался провожать Дэнни какой-нибудь чёртовой хвалебной речью."

# ch/lexi/events.rpy:2394
translate russian lexi_event_07a_9d89af6b:
    "Он был редкостным куском дерьма и получил по заслугам!"

# ch/lexi/events.rpy:2395
translate russian lexi_event_07a_f365ee13:
    "Да и убил его я сам. Так чего жду?"

# ch/lexi/events.rpy:2396
translate russian lexi_event_07a_309648f4:
    "Воодушевлённый этой мыслью, я пробую пнуть тело."

# ch/lexi/events.rpy:2397
translate russian lexi_event_07a_cb1646a4:
    "Оно почти не сдвигается, и я понимаю: легко не будет."

# ch/lexi/events.rpy:2398
translate russian lexi_event_07a_78174299:
    "Я-то втайне надеялся просто столкнуть его ногой."

# ch/lexi/events.rpy:2399
translate russian lexi_event_07a_5bb67496:
    "Но и поднимать труп, чтобы швырнуть его в воду, тоже не собираюсь."

# ch/lexi/events.rpy:2400
translate russian lexi_event_07a_d21f50a4:
    "Иначе наверняка потеряю равновесие и полечу следом."

# ch/lexi/events.rpy:2401
translate russian lexi_event_07a_60098f80:
    "Поэтому я опускаюсь на колени и пытаюсь перекатить Дэнни через борт."

# ch/lexi/events.rpy:2402
translate russian lexi_event_07a_d91de039:
    "Как ни стараюсь, перевернуть его не удаётся."

# ch/lexi/events.rpy:2403
translate russian lexi_event_07a_f7399ed2:
    "Тогда я начинаю поочерёдно подталкивать то голову, то ноги."

# ch/lexi/events.rpy:2404
translate russian lexi_event_07a_062089b5:
    "Понемногу всё большая часть тела свешивается за край."

# ch/lexi/events.rpy:2405
translate russian lexi_event_07a_a159b6a4:
    "И вдруг сила тяжести берёт своё, и оно переваливается через борт."

# ch/lexi/events.rpy:2407
translate russian lexi_event_07a_3b923b6b:
    "Я отскакиваю, всё ещё боясь упасть следом."

# ch/lexi/events.rpy:2408
translate russian lexi_event_07a_3557ee34:
    "Но затем слышу, как тело плюхается в воду."

# ch/lexi/events.rpy:2409
translate russian lexi_event_07a_cea431f4:
    "В голове тут же проносятся самые ужасные варианты развития событий."

# ch/lexi/events.rpy:2410
translate russian lexi_event_07a_bf7b86c0:
    "А вдруг завтра утром тело выбросит на пляж?"

# ch/lexi/events.rpy:2411
translate russian lexi_event_07a_97c53d5c:
    "Может, надо было привязать груз, прежде чем его сбрасывать?"

# ch/lexi/events.rpy:2412
translate russian lexi_event_07a_00fe6f86:
    "Ну, говорят же, дерьмо не тонет."

# ch/lexi/events.rpy:2413
translate russian lexi_event_07a_82521ef1:
    "А Дэнни был одним из самых больших говнюков, что мне доводилось встречать!"

# ch/lexi/events.rpy:2414
translate russian lexi_event_07a_3b9d0c97:
    "Все эти мысли крутятся у меня в голове, пока я заглядываю за борт."

# ch/lexi/events.rpy:2415
translate russian lexi_event_07a_2e683f78:
    "Но затем я разворачиваюсь и почти на автопилоте спешу обратно тем же путём."

# ch/lexi/events.rpy:2416
translate russian lexi_event_07a_3b6e2317:
    "Может, всё обойдётся."

# ch/lexi/events.rpy:2417
translate russian lexi_event_07a_3f070c85:
    "Может, тело Дэнни опустится прямо на морское дно."

# ch/lexi/events.rpy:2418
translate russian lexi_event_07a_8cb00d02:
    "А может, его унесёт в океан и сожрёт акула."

# ch/lexi/events.rpy:2419
translate russian lexi_event_07a_a582e1f3:
    "Что бы ни случилось, нужно помнить, зачем я вообще это делаю."

# ch/lexi/events.rpy:2420
translate russian lexi_event_07a_99c33057:
    "Я хотел вмешаться и спасти Лекси от этого мерзавца."

# ch/lexi/events.rpy:2421
translate russian lexi_event_07a_41c8da8a:
    "А то, что теперь она будет только моей, — конечно же, просто приятное дополнение!"

# ch/lexi/events.rpy:2422
translate russian lexi_event_07a_47ef4248:
    "С этой мыслью я спешу прочь в темноту."

# ch/lexi/events.rpy:2423
translate russian lexi_event_07a_6aa3676b:
    "Из-за Лекси я стал убийцей."

# ch/lexi/events.rpy:2424
translate russian lexi_event_07a_24b5106c:
    "Надеюсь, она того стоит!"

# ch/lexi/events.rpy:2431
translate russian lexi_event_07b_703bb50d:
    "Одной рукой я волоку тело за собой, а другой пытаюсь удержать лопату на плече."

# ch/lexi/events.rpy:2432
translate russian lexi_event_07b_ad195279:
    "Тащить такую тяжёлую и неудобную ношу по неровной земле нелегко."

# ch/lexi/events.rpy:2433
translate russian lexi_event_07b_4f9b521d:
    "Но я продолжаю идти, пыхтя и постанывая на каждом шагу, в поисках подходящего места."

# ch/lexi/events.rpy:2434
translate russian lexi_event_07b_01851ee1:
    "Я оборачиваюсь на каждый звук, до ужаса боясь, что меня обнаружат."

# ch/lexi/events.rpy:2435
translate russian lexi_event_07b_6d04c7c4:
    "Хоть какое-то утешение в том, что я заранее завернул труп Дэнни в плёнку."

# ch/lexi/events.rpy:2436
translate russian lexi_event_07b_77c92b60:
    "По крайней мере, не приходится всё это время смотреть на его мерзкую рожу."

# ch/lexi/events.rpy:2437
translate russian lexi_event_07b_89463463:
    "В жизни я, без сомнения, попадал в немало дурацких передряг."

# ch/lexi/events.rpy:2438
translate russian lexi_event_07b_7d35f02c:
    "Но никогда не думал, что окажусь в подобной ситуации."

# ch/lexi/events.rpy:2439
translate russian lexi_event_07b_d7d39fa4:
    "Как, чёрт возьми, вышло, что я таскаю среди ночи труп?!"

# ch/lexi/events.rpy:2440
translate russian lexi_event_07b_987284eb:
    "Лекси. Вот как."

# ch/lexi/events.rpy:2441
translate russian lexi_event_07b_1847ea87:
    "Всё это из-за Лекси!"

# ch/lexi/events.rpy:2442
translate russian lexi_event_07b_237dc8af:
    "Я лишь пытался защитить её от этого урода Дэнни."

# ch/lexi/events.rpy:2443
translate russian lexi_event_07b_338ba6cd:
    "И ведь думал, что поступаю правильно."

# ch/lexi/events.rpy:2444
translate russian lexi_event_07b_42557068:
    "Рано или поздно он бы зашёл с Лекси слишком далеко."

# ch/lexi/events.rpy:2445
translate russian lexi_event_07b_7aad318d:
    "Но вместо того, чтобы он убил её, я убил его!"

# ch/lexi/events.rpy:2446
translate russian lexi_event_07b_c355ca44:
    "Надеюсь, она стоит всех этих усилий."

# ch/lexi/events.rpy:2447
translate russian lexi_event_07b_5672570b:
    "Ведь из-за неё я стал убийцей!"

# ch/lexi/events.rpy:2448
translate russian lexi_event_07b_b9a26a7a:
    "Я изо всех сил отгоняю эту мысль, понимая, что она ничем не поможет."

# ch/lexi/events.rpy:2449
translate russian lexi_event_07b_2f92eeac:
    "И почти в тот же миг замечаю, что стою на поляне."

# ch/lexi/events.rpy:2450
translate russian lexi_event_07b_0b0f0ccf:
    "Я снова оглядываюсь, ища хоть какой-нибудь признак чужого присутствия."

# ch/lexi/events.rpy:2451
translate russian lexi_event_07b_a838abca:
    "Никого не видно и не слышно, и я решаю, что здесь самое место закопать Дэнни."

# ch/lexi/events.rpy:2453
translate russian lexi_event_07b_27ee88ce:
    "Бросив труп, я сразу берусь за лопату."

# ch/lexi/events.rpy:2454
translate russian lexi_event_07b_cc97e1bc:
    "Земля твёрдая, вся в камнях и корнях."

# ch/lexi/events.rpy:2455
translate russian lexi_event_07b_71aa19b2:
    "Но я продолжаю копать, без конца бормоча себе под нос."

# ch/lexi/events.rpy:2456
translate russian lexi_event_07b_bda0b080:
    "Не знаю, сколько времени уходит на яму глубиной в несколько футов."

# ch/lexi/events.rpy:2457
translate russian lexi_event_07b_9ce57a4a:
    "Знаю лишь, что это слишком долго. Кажется, целую вечность."

# ch/lexi/events.rpy:2458
translate russian lexi_event_07b_4413e18c:
    "Мне всё время мерещится, что вот-вот забрезжит рассвет."

# ch/lexi/events.rpy:2459
translate russian lexi_event_07b_08c3b7f0:
    "И тогда меня наверняка тут же заметят."

# ch/lexi/events.rpy:2460
translate russian lexi_event_07b_f00eac58:
    "Но каким-то образом темнота держится всё время, пока я копаю."

# ch/lexi/events.rpy:2461
translate russian lexi_event_07b_f10a3a51:
    "Я выбираюсь из ямы ещё под покровом ночи и бросаю лопату."

# ch/lexi/events.rpy:2462
translate russian lexi_event_07b_1aa194b3:
    "К этому моменту я слишком вымотан, чтобы даже думать о том, чтобы поднять труп."

# ch/lexi/events.rpy:2463
translate russian lexi_event_07b_ee8ddcd7:
    "Вместо этого я опускаюсь на колени и начинаю толкать его к яме."

# ch/lexi/events.rpy:2464
translate russian lexi_event_07b_d91de039:
    "Как ни стараюсь, перевернуть его не удаётся."

# ch/lexi/events.rpy:2465
translate russian lexi_event_07b_f7399ed2:
    "Тогда я начинаю поочерёдно подталкивать то голову, то ноги."

# ch/lexi/events.rpy:2466
translate russian lexi_event_07b_062089b5:
    "Понемногу всё большая часть тела свешивается за край."

# ch/lexi/events.rpy:2467
translate russian lexi_event_07b_457952ec:
    "И вдруг сила тяжести берёт своё, и оно валится в яму."

# ch/lexi/events.rpy:2468
translate russian lexi_event_07b_74937e68:
    "С трудом поднявшись, я беру лопату и глубоко вдыхаю."

# ch/lexi/events.rpy:2469
translate russian lexi_event_07b_fffd84d8:
    "Я на мгновение замираю, раздумывая, не сказать ли напоследок пару слов."

# ch/lexi/events.rpy:2470
translate russian lexi_event_07b_450bac0b:
    "Затем качаю головой, ругая себя за глупость."

# ch/lexi/events.rpy:2471
translate russian lexi_event_07b_34b86e96:
    "Я ведь не собрался провожать Дэнни какой-нибудь чёртовой хвалебной речью."

# ch/lexi/events.rpy:2472
translate russian lexi_event_07b_9d89af6b:
    "Он был редкостным куском дерьма и получил по заслугам!"

# ch/lexi/events.rpy:2473
translate russian lexi_event_07b_f365ee13:
    "Да и убил его я сам. Так чего жду?"

# ch/lexi/events.rpy:2474
translate russian lexi_event_07b_21229e6c:
    "Я начинаю забрасывать и сгребать землю в яму."

# ch/lexi/events.rpy:2475
translate russian lexi_event_07b_d968f80f:
    "А в голове тем временем всё больше вопросов."

# ch/lexi/events.rpy:2476
translate russian lexi_event_07b_6f3e5b0c:
    "А вдруг я забрался недостаточно далеко в лес?"

# ch/lexi/events.rpy:2477
translate russian lexi_event_07b_5508b222:
    "А вдруг закопал его недостаточно глубоко?"

# ch/lexi/events.rpy:2478
translate russian lexi_event_07b_1aed91b8:
    "Сможет ли тело разложиться, завёрнутое во всю эту плёнку?"

# ch/lexi/events.rpy:2479
translate russian lexi_event_07b_2f6afed7:
    "Дэнни ведь, наверное, самый большой кусок дерьма, которого я когда-либо встречал."

# ch/lexi/events.rpy:2480
translate russian lexi_event_07b_a3c72dba:
    "А если дерьмо закопать, оно превращается в удобрение, верно?"

# ch/lexi/events.rpy:2481
translate russian lexi_event_07b_98ac54fa:
    "Всё это мечется у меня в голове, пока я утрамбовываю землю."

# ch/lexi/events.rpy:2483
translate russian lexi_event_07b_3b20334c:
    "Затем я резко разворачиваюсь и почти на автопилоте спешу обратно тем же путём."

# ch/lexi/events.rpy:2484
translate russian lexi_event_07b_ef705115:
    "А если кто-нибудь заметит подозрительную свежевскопанную землю?"

# ch/lexi/events.rpy:2485
translate russian lexi_event_07b_466c0953:
    "А если чья-нибудь собака учует его и выкопает?"

# ch/lexi/events.rpy:2486
translate russian lexi_event_07b_81d5b372:
    "Может, всё обойдётся."

# ch/lexi/events.rpy:2487
translate russian lexi_event_07b_6cdcff7c:
    "Может, никто не забирается так далеко ни погулять, ни выгулять собаку."

# ch/lexi/events.rpy:2488
translate russian lexi_event_07b_a09a64ff:
    "А может, медведь выкопает тело Дэнни и съест."

# ch/lexi/events.rpy:2489
translate russian lexi_event_07b_6bad4352:
    "Медведи ведь едят людей, да?"

# ch/lexi/events.rpy:2490
translate russian lexi_event_07b_a582e1f3:
    "Что бы ни случилось, нужно помнить, зачем я вообще это делаю."

# ch/lexi/events.rpy:2491
translate russian lexi_event_07b_99c33057:
    "Я хотел вмешаться и спасти Лекси от этого мерзавца."

# ch/lexi/events.rpy:2492
translate russian lexi_event_07b_41c8da8a:
    "А то, что теперь она будет только моей, — конечно же, просто приятное дополнение!"

# ch/lexi/events.rpy:2493
translate russian lexi_event_07b_47ef4248:
    "С этой мыслью я спешу прочь в темноту."

# ch/lexi/events.rpy:2494
translate russian lexi_event_07b_6aa3676b:
    "Из-за Лекси я стал убийцей."

# ch/lexi/events.rpy:2495
translate russian lexi_event_07b_24b5106c:
    "Надеюсь, она того стоит!"

# ch/lexi/events.rpy:2505
translate russian lexi_event_08_55103d3c:
    "Едва увидев Лекси, я замечаю тревогу, вину и какую-то нервную пугливость."

# ch/lexi/events.rpy:2506
translate russian lexi_event_08_5d9c50b7:
    "Впрочем, после всего, через что мы недавно прошли, это совершенно естественно."

# ch/lexi/events.rpy:2507
translate russian lexi_event_08_1970dcc3:
    "После всего дерьма, которое ей пришлось терпеть от Дэнни, она должна бы ликовать."

# ch/lexi/events.rpy:2508
translate russian lexi_event_08_3bbbc97e:
    "Но она так долго была в его власти, что, наверное, трудно поверить: он и правда исчез."

# ch/lexi/events.rpy:2509
translate russian lexi_event_08_22bcb459:
    "Кто знает, может, Лекси уверена, что этот мерзавец ещё восстанет из мёртвых!"

# ch/lexi/events.rpy:2510
translate russian lexi_event_08_fb34a9c7:
    "Бр-р... Если подумать, Дэнни-зомби был бы ещё хуже живого Дэнни!"

# ch/lexi/events.rpy:2511
translate russian lexi_event_08_3d8d8abc:
    "Я изо всех сил выдавливаю улыбку, надеясь подбодрить Лекси."

# ch/lexi/events.rpy:2512
translate russian lexi_event_08_d47a5fbd:
    lexi.say "Всё?.."

# ch/lexi/events.rpy:2513
translate russian lexi_event_08_8ea2622e:
    lexi.say "Ты?.."

# ch/lexi/events.rpy:2514
translate russian lexi_event_08_b044e08c:
    "Лекси держит руки у подбородка и нервно заламывает пальцы."

# ch/lexi/events.rpy:2515
translate russian lexi_event_08_f4afca1e:
    "Её так переполняют чувства, что она даже не может выговорить слова!"

# ch/lexi/events.rpy:2516
translate russian lexi_event_08_f78baa37:
    mike.say "Да, Лекси."

# ch/lexi/events.rpy:2517
translate russian lexi_event_08_c9c273b0:
    mike.say "Я всё сделал. С этим покончено!"

# ch/lexi/events.rpy:2518
translate russian lexi_event_08_2e5b4571:
    mike.say "Я спрятал тело Дэнни там, где его никто никогда не найдёт."

# ch/lexi/events.rpy:2520
translate russian lexi_event_08_f247f0a1:
    "Ну, по крайней мере, надеюсь, что не найдёт!"

# ch/lexi/events.rpy:2521
translate russian lexi_event_08_c538c6e0:
    "Но сейчас не время тревожить Лекси такими мелочами."

# ch/lexi/events.rpy:2522
translate russian lexi_event_08_d6d4563c:
    "Мы наконец избавились от этого подонка и должны радоваться свободе."

# ch/lexi/events.rpy:2523
translate russian lexi_event_08_99a0443b:
    "Мне приятно видеть, как меняется лицо Лекси, пока я всё это говорю."

# ch/lexi/events.rpy:2524
translate russian lexi_event_08_b9c79323:
    "Тревогу сменяет восторг, и она улыбается, как Чеширский Кот."

# ch/lexi/events.rpy:2525
translate russian lexi_event_08_4e7774e6:
    lexi.say "Ох, [lssb_lexi.hero_name()]!"

# ch/lexi/events.rpy:2526
translate russian lexi_event_08_8ea181e1:
    lexi.say "Чем же я заслужила такого парня, как ты?"

# ch/lexi/events.rpy:2527
translate russian lexi_event_08_2333d7b1:
    lexi.say "Ты ТАК не похож на Дэнни."

# ch/lexi/events.rpy:2528
translate russian lexi_event_08_3d8dd58a:
    lexi.say "Просто полная противоположность этому уроду."

# ch/lexi/events.rpy:2529
translate russian lexi_event_08_9903ffbb:
    lexi.say "Ты Анти-Дэнни!"

# ch/lexi/events.rpy:2530
translate russian lexi_event_08_e0530406:
    mike.say "А... да, Лекси."

# ch/lexi/events.rpy:2531
translate russian lexi_event_08_05f1febc:
    mike.say "Как скажешь!"

# ch/lexi/events.rpy:2532
translate russian lexi_event_08_97ab0fed:
    "Кажется, уже неважно, что я говорю."

# ch/lexi/events.rpy:2533
translate russian lexi_event_08_1a7d82af:
    "Лекси уже довела себя до эйфории."

# ch/lexi/events.rpy:2534
translate russian lexi_event_08_97f28ae2:
    "А меня всё ещё трясёт после того, как пришлось избавляться от тела."

# ch/lexi/events.rpy:2535
translate russian lexi_event_08_f43d7881:
    "Мне хочется разделить её радость от того, что Дэнни больше нет."

# ch/lexi/events.rpy:2536
translate russian lexi_event_08_c187f839:
    "Но осознание содеянного не перестаёт грызть меня изнутри."

# ch/lexi/events.rpy:2538
translate russian lexi_event_08_03406e10:
    lexi.say "Вот и всё, [lssb_lexi.hero_name()]!"

# ch/lexi/events.rpy:2539
translate russian lexi_event_08_5a72df95:
    lexi.say "Это начало нашей новой совместной жизни."

# ch/lexi/events.rpy:2540
translate russian lexi_event_08_5f97af60:
    lexi.say "Ты прямо мой рыцарь в сияющих доспехах."

# ch/lexi/events.rpy:2541
translate russian lexi_event_08_d6346a04:
    lexi.say "То, что ты сделал, — ТАК романтично!"

# ch/lexi/events.rpy:2542
translate russian lexi_event_08_9eac5ce7:
    "Погоди-ка..."

# ch/lexi/events.rpy:2543
translate russian lexi_event_08_cdc98c2c:
    "То, что я сделал?!"

# ch/lexi/events.rpy:2544
translate russian lexi_event_08_a08166eb:
    "Лекси говорит так, будто убить Дэнни было целиком моей идеей!"

# ch/lexi/events.rpy:2545
translate russian lexi_event_08_65f20282:
    "Я открываю рот, чтобы возразить, хотя бы напомнить, что мы в этом вместе."

# ch/lexi/events.rpy:2547
translate russian lexi_event_08_6209254a:
    "Но она обхватывает меня за талию и крепко обнимает."

# ch/lexi/events.rpy:2548
translate russian lexi_event_08_107e8a8d:
    "Лекси прижимается ко мне и вздыхает с глубоким, неподдельным удовлетворением."

# ch/lexi/events.rpy:2549
translate russian lexi_event_08_86dd4ad7:
    "Я чувствую, как таю, ещё до того, как она начинает говорить."

# ch/lexi/events.rpy:2550
translate russian lexi_event_08_3b641f09:
    lexi.say "М-м-м..."

# ch/lexi/events.rpy:2551
translate russian lexi_event_08_e6c5df6f:
    lexi.say "Я ещё никогда не чувствовала себя в такой безопасности, [lssb_lexi.hero_name()]."

# ch/lexi/events.rpy:2552
translate russian lexi_event_08_34461811:
    lexi.say "И такой счастливой тоже."

# ch/lexi/events.rpy:2553
translate russian lexi_event_08_b18d53ee:
    lexi.say "И всё потому, что я тебя люблю!"

# ch/lexi/events.rpy:2554
translate russian lexi_event_08_f73a7064:
    "Вот и всё."

# ch/lexi/events.rpy:2559
translate russian lexi_event_08_fdee438f:
    "Стоит Лекси произнести эти слова, и я уже в её власти."

# ch/lexi/events.rpy:2560
translate russian lexi_event_08_fd74d085:
    "Мне остаётся лишь обнять её в ответ."

# ch/lexi/events.rpy:2561
translate russian lexi_event_08_c6e8d793:
    "Я сделаю что угодно, лишь бы слышать от неё такие слова о себе."

# ch/lexi/events.rpy:2562
translate russian lexi_event_08_5df56fff:
    "И действительно что угодно: ведь я уже убил ради неё человека!"

# ch/lexi/events.rpy:2581
translate russian lexi_male_ending_22df889b:
    "Знаю, это безумие, но я до сих пор не могу до конца поверить, что этот день настал."

# ch/lexi/events.rpy:2582
translate russian lexi_male_ending_77220667:
    "Это правда происходит: мы с Лекси сейчас встанем перед священником и поженимся!"

# ch/lexi/events.rpy:2583
translate russian lexi_male_ending_35c4b075:
    "Я... ну, мне немного неловко это говорить..."

# ch/lexi/events.rpy:2584
translate russian lexi_male_ending_87179544:
    "Но когда мы познакомились, Лекси была последней девушкой на свете, с которой я мог представить себе свадьбу."

# ch/lexi/events.rpy:2585
translate russian lexi_male_ending_a19eb5fc:
    "Она была безбашенной, порочной, и водиться с ней было опасно: она участвовала во всевозможных тёмных делишках."

# ch/lexi/events.rpy:2586
translate russian lexi_male_ending_369f34a6:
    "И всё же в ней всегда было что-то, что меня притягивало."

# ch/lexi/events.rpy:2587
translate russian lexi_male_ending_c07f57ab:
    "Будто подо всем этим скрывалась просто замечательная девушка, живущая на полную катушку."

# ch/lexi/events.rpy:2588
translate russian lexi_male_ending_f94ee0e0:
    "Наверное, мне повезло узнать: когда всё плохое осталось позади, именно такой она и оказалась."

# ch/lexi/events.rpy:2589
translate russian lexi_male_ending_72055767:
    "Лекси, которую я узнал и полюбил, замечательна во многих отношениях."

# ch/lexi/events.rpy:2590
translate russian lexi_male_ending_5a5344d0:
    "Конечно, она по-прежнему та ещё чертовка, готовая нарушить любые правила."

# ch/lexi/events.rpy:2591
translate russian lexi_male_ending_51a17392:
    "Но обычно в хорошем смысле, если вы понимаете, о чём я."

# ch/lexi/events.rpy:2592
translate russian lexi_male_ending_fa2f29a1:
    "Или хотя бы так, чтобы нам обоим было хорошо!"

# ch/lexi/events.rpy:2593
translate russian lexi_male_ending_7c01ef82:
    "Ладно, хватит лирических отступлений о Лекси и её причудах."

# ch/lexi/events.rpy:2594
translate russian lexi_male_ending_68daa2f4:
    "Заиграла музыка, и, кажется, я уже вижу, как она идёт к алтарю."

# ch/lexi/events.rpy:2596
translate russian lexi_male_ending_ace9f2fb:
    "Когда мне наконец удаётся разглядеть её как следует, я невольно улыбаюсь."

# ch/lexi/events.rpy:2597
translate russian lexi_male_ending_b4ee5ddd:
    "В выбранном платье Лекси выглядит потрясающе."

# ch/lexi/events.rpy:2598
translate russian lexi_male_ending_9f51e764:
    "Оно ей очень идёт и при этом отражает её своеобразный характер."

# ch/lexi/events.rpy:2600
translate russian lexi_male_ending_f3c3a0f0:
    "И каким-то чудом вмещает ещё и растущий живот!"

# ch/lexi/events.rpy:2602
translate russian lexi_male_ending_44e1b5a9:
    "Известие о том, что Лекси ждёт двойню, меня ничуть не удивило."

# ch/lexi/events.rpy:2603
translate russian lexi_male_ending_a96bde41:
    "До родов ещё есть время, но уже кажется, что она вот-вот лопнет."

# ch/lexi/events.rpy:2604
translate russian lexi_male_ending_9f721938:
    "Впрочем, для меня это неважно: я вижу лишь будущее, которое мы строим вместе."

# ch/lexi/events.rpy:2606
translate russian lexi_male_ending_2b1ffe65:
    "Вот наглядный пример: я замечаю, что Лекси прямо сейчас жуёт жвачку."

# ch/lexi/events.rpy:2607
translate russian lexi_male_ending_f8fb96e3:
    "И в подтверждение она надувает огромный розовый пузырь, шагая ко мне."

# ch/lexi/events.rpy:2608
translate russian lexi_male_ending_f4a70b75:
    "Пузырь лопается, и Лекси с громким щелчком втягивает жвачку обратно в рот."

# ch/lexi/events.rpy:2609
translate russian lexi_male_ending_4e853be1:
    "Затем улыбается мне, как всегда ничуть не смущаясь."

# ch/lexi/events.rpy:2611
translate russian lexi_male_ending_373c75ad:
    "Лекси встаёт рядом, уделяя мне больше внимания, чем священнику."

# ch/lexi/events.rpy:2612
translate russian lexi_male_ending_33221b31:
    "Даже сейчас я вижу, как ей нравится, что я скольжу по ней взглядом."

# ch/lexi/events.rpy:2613
translate russian lexi_male_ending_950a91e6:
    "И, ну... она чертовски сексуальна!"

# ch/lexi/events.rpy:2615
translate russian lexi_male_ending_92cd0ee7:
    "В эту минуту я могу думать лишь о том, что на ней под платьем."

# ch/lexi/events.rpy:2616
translate russian lexi_male_ending_22d0a383:
    "Ну и о том, когда смогу его с неё снять..."

# ch/lexi/events.rpy:2617
translate russian lexi_male_ending_b6b86ea1:
    "Священник" "Кхм..."

# ch/lexi/events.rpy:2619
translate russian lexi_male_ending_22b25561:
    "Услышав негромкое напоминание священника, я тут же собираюсь."

# ch/lexi/events.rpy:2620
translate russian lexi_male_ending_1eb6b328:
    "Но если замечание относилось и к Лекси, то она не обращает на него внимания."

# ch/lexi/events.rpy:2621
translate russian lexi_male_ending_146fbb62:
    "Она лишь похабно смеётся и поворачивается к священнику."

# ch/lexi/events.rpy:2622
translate russian lexi_male_ending_835ce570:
    "Её явно забавляет, что меня отчитали за разглядывание её в такой торжественный момент!"

# ch/lexi/events.rpy:2623
translate russian lexi_male_ending_81a70b3a:
    "Священник" "Дорогие собравшиеся..."

# ch/lexi/events.rpy:2624
translate russian lexi_male_ending_1df36a1d:
    "Священник" "Мы собрались здесь сегодня, чтобы стать свидетелями союза этих двух людей..."

# ch/lexi/events.rpy:2625
translate russian lexi_male_ending_53aaae83:
    "Я слышу, как священник продолжает монотонно вести церемонию."

# ch/lexi/events.rpy:2626
translate russian lexi_male_ending_f4a6fa95:
    "Мы столько раз всё репетировали, что я спокойно позволяю себе отвлечься."

# ch/lexi/events.rpy:2627
translate russian lexi_male_ending_f281e6c5:
    "Вместо этого представляю, чем мы с Лекси займёмся потом."

# ch/lexi/events.rpy:2628
translate russian lexi_male_ending_685a08a4:
    "Поэтому момент, когда требуется моё участие, подкрадывается совершенно незаметно!"

# ch/lexi/events.rpy:2629
translate russian lexi_male_ending_200f7f62:
    "Священник" "Согласны ли вы, [lssb_lexi.hero_name()], взять Лекси в законные жёны?"

# ch/lexi/events.rpy:2630
translate russian lexi_male_ending_0c3eae31:
    mike.say "Да... да, согласен!"

# ch/lexi/events.rpy:2631
translate russian lexi_male_ending_67352dc9:
    "Священник" "А вы, Лекси, согласны взять [lssb_lexi.hero_name()] в законные мужья?"

# ch/lexi/events.rpy:2632
translate russian lexi_male_ending_97c8abfb:
    lexi.say "Ага, согласна!"

# ch/lexi/events.rpy:2633
translate russian lexi_male_ending_66f9c71a:
    "Священник кивает, не в силах сдержать улыбку при виде энтузиазма Лекси."

# ch/lexi/events.rpy:2634
translate russian lexi_male_ending_ff1bcbca:
    "Священник" "Я призываю всех присутствующих..."

# ch/lexi/events.rpy:2635
translate russian lexi_male_ending_2bd0edc2:
    "Священник" "Если кому-либо известна законная или нравственная причина, по которой эти двое не могут вступить в брак..."

# ch/lexi/events.rpy:2636
translate russian lexi_male_ending_c5c5976a:
    "Священник" "Пусть скажет сейчас или хранит молчание вечно!"

# ch/lexi/events.rpy:2637
translate russian lexi_male_ending_b46d2b07:
    "Тишина в часовне должна быть лишь данью традиции."

# ch/lexi/events.rpy:2638
translate russian lexi_male_ending_8ffd758f:
    "Но втайне я всё это время боялся именно этого момента."

# ch/lexi/events.rpy:2639
translate russian lexi_male_ending_164662ea:
    "Я невольно гадаю, не настигнет ли нас сейчас прошлое Лекси."

# ch/lexi/events.rpy:2640
translate russian lexi_male_ending_891c2147:
    "Не заявится ли призрак этого ублюдка Дэнни, чтобы испортить праздник?"

# ch/lexi/events.rpy:2641
translate russian lexi_male_ending_1e320837:
    "Или полиция ворвётся и уведёт Лекси в наручниках?!"

# ch/lexi/events.rpy:2642
translate russian lexi_male_ending_13a2bb91:
    "Наконец священник удовлетворённо кивает и продолжает церемонию."

# ch/lexi/events.rpy:2643
translate russian lexi_male_ending_07b58f79:
    "И только тогда я понимаю, что всё это время задерживал дыхание!"

# ch/lexi/events.rpy:2644
translate russian lexi_male_ending_bf116684:
    "Священник" "Тогда объявляю вас мужем и женой."

# ch/lexi/events.rpy:2645
translate russian lexi_male_ending_5afd38c2:
    "Священник" "Можете поцеловать невесту!"

# ch/lexi/events.rpy:2650
translate russian lexi_male_ending_20545001:
    "Я наклоняюсь к ней, ожидая одного из тех нежных поцелуев, которыми пары обмениваются в такой момент."

# ch/lexi/events.rpy:2651
translate russian lexi_male_ending_382cd414:
    "Но Лекси удивляет меня: вцепляется в меня и чуть ли не засовывает язык мне в горло!"

# ch/lexi/events.rpy:2652
translate russian lexi_male_ending_8ba20fa2:
    "На мгновение опешив, я сдаюсь и отвечаю тем же."

# ch/lexi/events.rpy:2653
translate russian lexi_male_ending_20fddddd:
    "Я ведь полюбил Лекси вовсе не за целомудрие и скромность."

# ch/lexi/events.rpy:2654
translate russian lexi_male_ending_f1d9f4b2:
    "Так почему бы сейчас не подыграть ей!"

# ch/lexi/events.rpy:2663
translate russian lexi_male_ending_c90eed76:
    lexi.say "Ну и что?"

# ch/lexi/events.rpy:2664
translate russian lexi_male_ending_bc55754c:
    lexi.say "Просто рассказать о нас с [lssb_lexi.hero_name()]?"

# ch/lexi/events.rpy:2665
translate russian lexi_male_ending_c2f7c677:
    lexi.say "И всё?!"

# ch/lexi/events.rpy:2666
translate russian lexi_male_ending_c06aeb9a:
    lexi.say "Хм... Ладно, если вам этого хочется."

# ch/lexi/events.rpy:2667
translate russian lexi_male_ending_108c5a21:
    lexi.say "Для начала признаюсь: при первой встрече [lssb_lexi.hero_name()] казался мне очередным лохом."

# ch/lexi/events.rpy:2668
translate russian lexi_male_ending_29a72f63:
    lexi.say "Просто ещё одним глупым парнем, которого можно развести на деньги так же легко, как и всех остальных."

# ch/lexi/events.rpy:2669
translate russian lexi_male_ending_8fac024c:
    lexi.say "Конечно, я сразу заметила, что он симпатичный, да ещё и добрый."

# ch/lexi/events.rpy:2670
translate russian lexi_male_ending_6cbf8934:
    lexi.say "Но тогда я была такой: не видела в людях людей."

# ch/lexi/events.rpy:2671
translate russian lexi_male_ending_51d3c308:
    lexi.say "Наверное, видела лишь то, что могу с них получить и как ими воспользоваться."

# ch/lexi/events.rpy:2672
translate russian lexi_male_ending_45333785:
    lexi.say "Но [lssb_lexi.hero_name()] оказался из тех дурачков, которые снова и снова возвращаются за новой порцией."

# ch/lexi/events.rpy:2673
translate russian lexi_male_ending_85d64050:
    lexi.say "По крайней мере, поначалу мне так казалось."

# ch/lexi/events.rpy:2674
translate russian lexi_male_ending_98fee4d2:
    lexi.say "Не сразу до меня дошло, что возвращался он на самом деле ради меня."

# ch/lexi/events.rpy:2675
translate russian lexi_male_ending_869754bc:
    lexi.say "Потому что... потому что я ему так нравилась..."

# ch/lexi/events.rpy:2676
translate russian lexi_male_ending_98008a66:
    lexi.say "Слушайте, понимаю, что из-за этого кажусь бессердечной стервой."

# ch/lexi/events.rpy:2677
translate russian lexi_male_ending_e8613428:
    lexi.say "Но тогда жизнь у меня была тяжёлая. Я была в паршивом положении и связалась с плохими людьми."

# ch/lexi/events.rpy:2678
translate russian lexi_male_ending_4109d9b3:
    lexi.say "А [lssb_lexi.hero_name()] был другим. Казалось, я нравлюсь ему сама по себе."

# ch/lexi/events.rpy:2679
translate russian lexi_male_ending_e73acdc4:
    lexi.say "Его интересовало не только то, как мной воспользоваться."

# ch/lexi/events.rpy:2680
translate russian lexi_male_ending_20ff6287:
    lexi.say "В отличие от этого куска дерьма Дэнни!"

# ch/lexi/events.rpy:2681
translate russian lexi_male_ending_4b612955:
    lexi.say "Ох, тот день, когда он надрал ему задницу в переулке!"

# ch/lexi/events.rpy:2682
translate russian lexi_male_ending_92527186:
    lexi.say "Будто у меня появился рыцарь в сияющих доспехах!"

# ch/lexi/events.rpy:2683
translate russian lexi_male_ending_277d8e10:
    lexi.say "Думаю, тогда до меня наконец начало доходить."

# ch/lexi/events.rpy:2684
translate russian lexi_male_ending_f13a53b5:
    lexi.say "Тогда я поняла, что [lssb_lexi.hero_name()] действительно меня любит."

# ch/lexi/events.rpy:2685
translate russian lexi_male_ending_fa02831b:
    lexi.say "Но дело ведь не только в этом, понимаете?"

# ch/lexi/events.rpy:2686
translate russian lexi_male_ending_ad509063:
    lexi.say "Мы с ним как будто из разных миров."

# ch/lexi/events.rpy:2687
translate russian lexi_male_ending_7b11aa63:
    lexi.say "Но [lssb_lexi.hero_name()] никогда не пытался изменить меня, сделать похожей на других девушек."

# ch/lexi/events.rpy:2688
translate russian lexi_male_ending_8ba0619e:
    lexi.say "Он никогда не насмехался ни над моим трейлером, ни над тем, как я одеваюсь."

# ch/lexi/events.rpy:2689
translate russian lexi_male_ending_a5d596d7:
    lexi.say "А когда тебя так же часто, как меня, называют отребьем..."

# ch/lexi/events.rpy:2690
translate russian lexi_male_ending_c2450b9a:
    lexi.say "Поверьте, это многое значит."

# ch/lexi/events.rpy:2691
translate russian lexi_male_ending_95135b3d:
    lexi.say "Вот откуда я знаю, что всё по-настоящему, что он не просто развлекается с девушкой из низов."

# ch/lexi/events.rpy:2692
translate russian lexi_male_ending_a45b907a:
    lexi.say "Иначе ему бы давно надоело. Я точно знаю."

# ch/lexi/events.rpy:2694
translate russian lexi_male_ending_5ec660a9:
    lexi.say "И уж точно он не стал бы так охотно заводить со мной семью."

# ch/lexi/events.rpy:2695
translate russian lexi_male_ending_1e06bc9f:
    lexi.say "С самого рождения Шантель у неё идеальный папа — [lssb_lexi.hero_name()]."

# ch/lexi/events.rpy:2696
translate russian lexi_male_ending_36f0448a:
    lexi.say "Он обожает эту маленькую проказницу. Это видно в его глазах каждый раз, когда он смотрит на неё."

# ch/lexi/events.rpy:2698
translate russian lexi_male_ending_5ec660a9_1:
    lexi.say "И уж точно он не стал бы так охотно заводить со мной семью."

# ch/lexi/events.rpy:2699
translate russian lexi_male_ending_26fe42a6:
    lexi.say "С самого рождения Шантель и Тайрона у них идеальный папа — [lssb_lexi.hero_name()]."

# ch/lexi/events.rpy:2700
translate russian lexi_male_ending_13f25f91:
    lexi.say "Он обожает этих двух маленьких проказников. Это видно в его глазах каждый раз, когда он смотрит на них."

# ch/lexi/events.rpy:2702
translate russian lexi_male_ending_ce4e8c9b:
    lexi.say "И уж точно он не стал бы так охотно обустраивать со мной общий дом."

# ch/lexi/events.rpy:2703
translate russian lexi_male_ending_e0f98b06:
    lexi.say "Ага, именно так! Я съехала из трейлерного парка, и теперь у нас с [lssb_lexi.hero_name()] настоящий дом!"

# ch/lexi/events.rpy:2704
translate russian lexi_male_ending_02516483:
    lexi.say "Правда, некоторым соседям, похоже, не нравится то, что они видят, когда я отдыхаю у бассейна."

# ch/lexi/events.rpy:2705
translate russian lexi_male_ending_1edd8a80:
    lexi.say "Но пошли они! Кому какое дело, что они думают?"

# ch/lexi/events.rpy:2706
translate russian lexi_male_ending_39c9651d:
    lexi.say "Иногда мне всё ещё трудно в это поверить, и хочется себя ущипнуть."

# ch/lexi/events.rpy:2707
translate russian lexi_male_ending_443d7032:
    lexi.say "У меня есть муж и настоящий дом. Выходит, я теперь домохозяйка!"

# ch/lexi/events.rpy:2708
translate russian lexi_male_ending_586b70c7:
    lexi.say "[lssb_lexi.hero_name()] всё намекает, что мне стоит чем-нибудь занять появившееся свободное время."

# ch/lexi/events.rpy:2709
translate russian lexi_male_ending_282c8936:
    lexi.say "Может, пойти на курсы в местный колледж или даже открыть своё дело."

# ch/lexi/events.rpy:2710
translate russian lexi_male_ending_850af0d4:
    lexi.say "Но пока мне слишком нравится быть ленивой жёнушкой!"

# ch/lexi/events.rpy:2711
translate russian lexi_male_ending_d00aefcf:
    lexi.say "К чему об этом беспокоиться, когда вся жизнь впереди?"

# ch/lexi/events.rpy:2712
translate russian lexi_male_ending_c031feac:
    lexi.say "Я бы даже пережила, если бы снова всё потеряла и вернулась в трейлерный парк."

# ch/lexi/events.rpy:2713
translate russian lexi_male_ending_cf5f4417:
    lexi.say "Лишь бы [lssb_lexi.hero_name()] был рядом."

# ch/lexi/events.rpy:2714
translate russian lexi_male_ending_572dd5cf:
    lexi.say "С ним мне кажется, что я могу всё."

# ch/lexi/events.rpy:2715
translate russian lexi_male_ending_fe7e7344:
    lexi.say "Наверное, вот что значит быть влюблённой."

# ch/lexi/events.rpy:2719
translate russian lexi_male_ending_60941e43:
    lexi.say "Хотите, чтобы я это сделала?"

# ch/lexi/events.rpy:2720
translate russian lexi_male_ending_fa950b04:
    lexi.say "Я правда смогу поговорить с людьми?!"

# ch/lexi/events.rpy:2721
translate russian lexi_male_ending_f4d7f4d5:
    lexi.say "Отлично! Наконец-то они услышат настоящую меня!"

# ch/lexi/events.rpy:2722
translate russian lexi_male_ending_bab81726:
    lexi.say "Давно, блядь, пора!"

# ch/lexi/events.rpy:2723
translate russian lexi_male_ending_a5fa43db:
    lexi.say "Ой... простите. Мне нельзя ругаться?"

# ch/lexi/events.rpy:2724
translate russian lexi_male_ending_4b51c505:
    lexi.say "Да пофиг..."

# ch/lexi/events.rpy:2725
translate russian lexi_male_ending_01fa1594:
    lexi.say "Это вам не сказка, и я уж точно не грёбаная принцесса!"

# ch/lexi/events.rpy:2726
translate russian lexi_male_ending_a764f629:
    lexi.say "Ага, странно всё в итоге складывается."

# ch/lexi/events.rpy:2727
translate russian lexi_male_ending_b7f8a508:
    lexi.say "Конечно, [lssb_lexi.hero_name()] понравился мне ещё при первой встрече."

# ch/lexi/events.rpy:2728
translate russian lexi_male_ending_9f3bd23a:
    lexi.say "Но тогда он был просто очередным лохом, которого надо обработать."

# ch/lexi/events.rpy:2729
translate russian lexi_male_ending_a6056902:
    lexi.say "Я должна была просто развлечь его, как и всех остальных."

# ch/lexi/events.rpy:2730
translate russian lexi_male_ending_da6dff2d:
    lexi.say "Потом отдать его бумажник Дэнни и забыть."

# ch/lexi/events.rpy:2731
translate russian lexi_male_ending_fad867ec:
    lexi.say "Но в нём было... ну, что-то другое."

# ch/lexi/events.rpy:2732
translate russian lexi_male_ending_b0bc29d1:
    lexi.say "Да-да-да, знаю, о чём вы подумали!"

# ch/lexi/events.rpy:2733
translate russian lexi_male_ending_73278e06:
    lexi.say "Конечно, член у него немаленький, и пользоваться им он умеет."

# ch/lexi/events.rpy:2734
translate russian lexi_male_ending_4bceaa19:
    lexi.say "Но это встречается чаще, чем вы думаете."

# ch/lexi/events.rpy:2735
translate russian lexi_male_ending_1eada11e:
    lexi.say "И да, все бесятся, когда их так обдирают."

# ch/lexi/events.rpy:2736
translate russian lexi_male_ending_d9941ed5:
    lexi.say "Но с [lssb_lexi.hero_name()] всё было иначе."

# ch/lexi/events.rpy:2737
translate russian lexi_male_ending_76685d82:
    lexi.say "То есть, конечно, он злился."

# ch/lexi/events.rpy:2738
translate russian lexi_male_ending_fb96fa8f:
    lexi.say "Но злился на меня за то, что я не стала лучше, понимаете?"

# ch/lexi/events.rpy:2739
translate russian lexi_male_ending_01445a65:
    lexi.say "Он ни разу не сдал меня копам."

# ch/lexi/events.rpy:2740
translate russian lexi_male_ending_376a64b1:
    lexi.say "И при следующей встрече мог смотреть мне в глаза."

# ch/lexi/events.rpy:2741
translate russian lexi_male_ending_b8ace251:
    lexi.say "Тогда я... тогда он начал мне по-настоящему нравиться!"

# ch/lexi/events.rpy:2742
translate russian lexi_male_ending_9ebc4f80:
    lexi.say "Между нами стоял только Дэнни..."

# ch/lexi/events.rpy:2743
translate russian lexi_male_ending_2c7fdd7c:
    lexi.say "Я боялась, что [lssb_lexi.hero_name()] от него пострадает."

# ch/lexi/events.rpy:2744
translate russian lexi_male_ending_7a635178:
    lexi.say "Но в итоге всё вышло наоборот!"

# ch/lexi/events.rpy:2745
translate russian lexi_male_ending_34a55256:
    lexi.say "[lssb_lexi.hero_name()] надрал Дэнни задницу и избавился от него навсегда!"

# ch/lexi/events.rpy:2746
translate russian lexi_male_ending_0f3c5478:
    lexi.say "Я даже думала, не запретит ли он мне дальше заниматься такими делами."

# ch/lexi/events.rpy:2747
translate russian lexi_male_ending_dd328572:
    lexi.say "Не знаю..."

# ch/lexi/events.rpy:2748
translate russian lexi_male_ending_c4b268b1:
    lexi.say "Может, начать честную жизнь было бы неплохо..."

# ch/lexi/events.rpy:2749
translate russian lexi_male_ending_a0282bce:
    lexi.say "Но когда он стал моим сутенёром, я быстро обо всём этом забыла."

# ch/lexi/events.rpy:2750
translate russian lexi_male_ending_f79b86a1:
    lexi.say "Потому что [lssb_lexi.hero_name()] оказался лучшим сутенёром, о каком девушка только может мечтать!"

# ch/lexi/events.rpy:2751
translate russian lexi_male_ending_d28fc902:
    lexi.say "Конечно, Дэнни был сильным и не дураком."

# ch/lexi/events.rpy:2752
translate russian lexi_male_ending_f57db766:
    lexi.say "Но [lssb_lexi.hero_name()] — просто гений какой-то!"

# ch/lexi/events.rpy:2753
translate russian lexi_male_ending_06f74f40:
    lexi.say "И, что ещё лучше, он никогда не станет обращаться со мной так скверно, как тот подонок."

# ch/lexi/events.rpy:2754
translate russian lexi_male_ending_727e635b:
    lexi.say "А ещё у [lssb_lexi.hero_name()] полно новых идей."

# ch/lexi/events.rpy:2755
translate russian lexi_male_ending_8d6fcb87:
    lexi.say "Таких, до которых Дэнни и за миллион лет не додумался бы!"

# ch/lexi/events.rpy:2756
translate russian lexi_male_ending_190a7fe6:
    lexi.say "Мы теперь столько зарабатываем вместе, что он шутит: скоро понадобится бухгалтер!"

# ch/lexi/events.rpy:2757
translate russian lexi_male_ending_1b66645c:
    lexi.say "Не знаю, чем именно занимается бухгалтер."

# ch/lexi/events.rpy:2758
translate russian lexi_male_ending_cff3a259:
    lexi.say "Но если он тебе нужен — значит, у тебя солидное дело!"

# ch/lexi/events.rpy:2759
translate russian lexi_male_ending_0d2e570f:
    lexi.say "И нас связывает не только бизнес. Хрен там!"

# ch/lexi/events.rpy:2760
translate russian lexi_male_ending_a0345c4c:
    lexi.say "Мы с [lssb_lexi.hero_name()] любим друг друга. По-настоящему."

# ch/lexi/events.rpy:2761
translate russian lexi_male_ending_35f94c4a:
    lexi.say "Да, он отдаёт меня тому, кто больше заплатит, и живёт на выручку."

# ch/lexi/events.rpy:2762
translate russian lexi_male_ending_c4773532:
    lexi.say "Но я знаю, что он делает это только ради дела."

# ch/lexi/events.rpy:2763
translate russian lexi_male_ending_88d59b6d:
    lexi.say "Поэтому я была бы дурой, если бы отказала, когда он предложил мне выйти за него."

# ch/lexi/events.rpy:2764
translate russian lexi_male_ending_8c033cdf:
    lexi.say "Теперь он мне и сутенёр, и муж, и лучший друг — всё в одном!"

# ch/lexi/events.rpy:2766
translate russian lexi_male_ending_36735ffa:
    lexi.say "И если бы он меня не любил, то никогда не завёл бы со мной семью."

# ch/lexi/events.rpy:2767
translate russian lexi_male_ending_26fe42a6_1:
    lexi.say "С самого рождения Шантель и Тайрона у них идеальный папа — [lssb_lexi.hero_name()]."

# ch/lexi/events.rpy:2768
translate russian lexi_male_ending_13f25f91_1:
    lexi.say "Он обожает этих двух маленьких проказников. Это видно в его глазах каждый раз, когда он смотрит на них."

# ch/lexi/events.rpy:2770
translate russian lexi_male_ending_d973164c:
    lexi.say "И если бы он меня не любил, то никогда не стал бы жить со мной в одном доме."

# ch/lexi/events.rpy:2771
translate russian lexi_male_ending_e0f98b06_1:
    lexi.say "Ага, именно так! Я съехала из трейлерного парка, и теперь у нас с [lssb_lexi.hero_name()] настоящий дом!"

# ch/lexi/events.rpy:2772
translate russian lexi_male_ending_02516483_1:
    lexi.say "Правда, некоторым соседям, похоже, не нравится то, что они видят, когда я отдыхаю у бассейна."

# ch/lexi/events.rpy:2773
translate russian lexi_male_ending_1edd8a80_1:
    lexi.say "Но пошли они! Кому какое дело, что они думают?"

# ch/lexi/events.rpy:2774
translate russian lexi_male_ending_bb50a69e:
    lexi.say "Хм... А знаете что?"

# ch/lexi/events.rpy:2775
translate russian lexi_male_ending_cceb48a0:
    lexi.say "Если подумать..."

# ch/lexi/events.rpy:2776
translate russian lexi_male_ending_84eae7aa:
    lexi.say "Всё это и правда немного похоже на сказку."

# ch/lexi/events.rpy:2777
translate russian lexi_male_ending_028186a8:
    lexi.say "Так, может, я всё-таки в каком-то смысле принцесса?"

# ch/lexi/events.rpy:2778
translate russian lexi_male_ending_04e9173b:
    lexi.say "Только сексуальная."

# ch/lexi/events.rpy:2779
translate russian lexi_male_ending_66f71f05:
    lexi.say "Такая, чью задницу можно арендовать с почасовой оплатой!"

# ch/lexi/events.rpy:2800
translate russian lexi_sasha_dance_aee96729:
    "Признаюсь, я больше всего люблю прийти с Лекси в клуб и выйти с ней на танцпол."

# ch/lexi/events.rpy:2801
translate russian lexi_sasha_dance_5b0b6cd9:
    "Можно заплатить хорошие деньги, чтобы посмотреть на девушку у пилона или получить вполне неплохой приватный танец."

# ch/lexi/events.rpy:2802
translate russian lexi_sasha_dance_ed8c6063:
    "Но танцевать с Лекси — это как получить лучшее от обоих удовольствий сразу. И бесплатно."

# ch/lexi/events.rpy:2803
translate russian lexi_sasha_dance_2780d45b:
    "А самое приятное: эта девушка ещё и не разозлится, если ты будешь её трогать."

# ch/lexi/events.rpy:2804
translate russian lexi_sasha_dance_241df367:
    "Скорее наоборот: ей не понравится, если ты этого делать не станешь!"

# ch/lexi/events.rpy:2805
translate russian lexi_sasha_dance_b289007e:
    "Едва мы входим в клуб, Лекси сразу направляется на танцпол."

# ch/lexi/events.rpy:2810
translate russian lexi_sasha_dance_9f9446f7:
    "А поскольку она сжимает мою руку мёртвой хваткой, я отправляюсь туда же."

# ch/lexi/events.rpy:2811
translate russian lexi_sasha_dance_0779e9e2:
    "Я даже не успеваю оглядеться или понять, знакома ли мне играющая песня."

# ch/lexi/events.rpy:2812
translate russian lexi_sasha_dance_6e790242:
    "Что бы это ни было, Лекси уже двигается в такт."

# ch/lexi/events.rpy:2813
translate russian lexi_sasha_dance_d84ab692:
    "И одновременно трётся об меня!"

# ch/lexi/events.rpy:2814
translate russian lexi_sasha_dance_def2c631:
    "Обвив руками мою шею, Лекси начинает прижиматься ко мне и двигать бёдрами в такт музыке."

# ch/lexi/events.rpy:2815
translate russian lexi_sasha_dance_425a4526:
    "Как ни странно, именно благодаря этому я узнаю песню, которую хорошо знаю."

# ch/lexi/events.rpy:2816
translate russian lexi_sasha_dance_17c10520:
    "Это тяжёлая композиция в стиле индастриал-метал с самым похабным текстом, какой только можно представить."

# ch/lexi/events.rpy:2817
translate russian lexi_sasha_dance_42d1d3ba:
    "Всё это так подходит Лекси и тому, что она сейчас со мной делает."

# ch/lexi/events.rpy:2818
translate russian lexi_sasha_dance_b629af5c:
    "Не говоря уже об эффекте её стараний!"

# ch/lexi/events.rpy:2819
translate russian lexi_sasha_dance_95c7f2fe:
    "Под стать музыке здесь темно и шумно: в клубе играют метал и другую тяжёлую музыку."

# ch/lexi/events.rpy:2820
translate russian lexi_sasha_dance_a037c915:
    "Так что на танцполе я почти ничего не вижу, кроме Лекси."

# ch/lexi/events.rpy:2821
translate russian lexi_sasha_dance_777916b3:
    "И меня это вполне устраивает: я опускаю взгляд на прижавшуюся ко мне девушку."

# ch/lexi/events.rpy:2826
translate russian lexi_sasha_dance_d23387d3:
    "Она тянется губами к моим губам, высовывая язык для поцелуя."

# ch/lexi/events.rpy:2827
translate russian lexi_sasha_dance_f929240e:
    "Топ так сильно приподнимает её грудь, что та может выскочить в любую минуту."

# ch/lexi/events.rpy:2828
translate russian lexi_sasha_dance_4029f344:
    "Я наклоняю голову, уже представляя, как язык Лекси скользнёт между моих губ..."

# ch/lexi/events.rpy:2829
translate russian lexi_sasha_dance_2646e7cc:
    "И именно в этот момент между нами что-то вклинивается, оставляя меня стоять с открытым ртом от изумления."

# ch/lexi/events.rpy:2830
translate russian lexi_sasha_dance_a1f59b2b:
    "Сначала я вижу лишь мелькание бледной кожи и тёмной одежды."

# ch/lexi/events.rpy:2831
translate russian lexi_sasha_dance_8d63d76a:
    "Но чувствую тепло другого тела, которое прижимается ко мне, оттесняя Лекси."

# ch/lexi/events.rpy:2850
translate russian lexi_sasha_dance_a2f886f4:
    "Лишь заметив сверкающие глаза и улыбающиеся губы, я узнаю Сашу."

# ch/lexi/events.rpy:2851
translate russian lexi_sasha_dance_dc03289a:
    "Ну конечно, это один из клубов, куда она любит ходить."

# ch/lexi/events.rpy:2852
translate russian lexi_sasha_dance_8d1c49fa:
    "Кажется, мы уже бывали здесь вместе, но это почему-то вылетело у меня из головы."

# ch/lexi/events.rpy:2853
translate russian lexi_sasha_dance_d622f8f8:
    "А может, я подсознательно привёл сюда Лекси, зная, что мы можем встретить Сашу..."

# ch/lexi/events.rpy:2854
translate russian lexi_sasha_dance_3f9b24b4:
    "Как бы то ни было, Саша явно решила помериться с Лекси силами."

# ch/lexi/events.rpy:2855
translate russian lexi_sasha_dance_7d297dd6:
    "При этом она даже не пытается подражать её откровенной манере себя подавать."

# ch/lexi/events.rpy:2856
translate russian lexi_sasha_dance_f918ab3f:
    "Вместо этого Саша будто превращается на танцполе в какую-то зловещую банши."

# ch/lexi/events.rpy:2857
translate russian lexi_sasha_dance_8c341c2b:
    "Одной рукой она обхватывает меня за шею и всем весом повисает на мне."

# ch/lexi/events.rpy:2858
translate russian lexi_sasha_dance_fc31ad86:
    "Другой в это время гладит мою щёку."

# ch/lexi/events.rpy:2859
translate russian lexi_sasha_dance_185c4071:
    "А затем медленно ведёт руку вниз, пока та не оказывается ниже пояса."

# ch/lexi/events.rpy:2860
translate russian lexi_sasha_dance_9fb16d8e:
    "Я чувствую, как Саша обхватывает и сжимает мой член, растягивая губы в улыбке."

# ch/lexi/events.rpy:2861
translate russian lexi_sasha_dance_ef312780:
    "Мигающие вспышки стробоскопов над нами придают её коже неземное сияние."

# ch/lexi/events.rpy:2862
translate russian lexi_sasha_dance_cd496e68:
    "А обнажённые зубы делают её похожей на вампиршу, готовую впиться в очередную добровольную жертву."

# ch/lexi/events.rpy:2863
translate russian lexi_sasha_dance_09fc7fc2:
    "Тут Лекси решительно пытается снова завладеть моим вниманием."

# ch/lexi/events.rpy:2864
translate russian lexi_sasha_dance_53ffe41e:
    "Ей удаётся лишь немного оттеснить Сашу, зато внимание самой Саши теперь полностью обращено на неё."

# ch/lexi/events.rpy:2865
translate russian lexi_sasha_dance_917d890d:
    "Взгляд, которым Саша одаривает Лекси, делает её ещё больше похожей на готическую суккубу."

# ch/lexi/events.rpy:2866
translate russian lexi_sasha_dance_07ee37c5:
    "Я вижу, что Лекси тоже это чувствует: она робеет и немного отступает."

# ch/lexi/events.rpy:2867
translate russian lexi_sasha_dance_a151d209:
    "Но затем Саша, похоже, окидывает её таким же оценивающим взглядом и протягивает руку, притягивая ещё ближе."

# ch/lexi/events.rpy:2868
translate russian lexi_sasha_dance_0f0af779:
    "Я узнаю румянец и дрожь Лекси."

# ch/lexi/events.rpy:2869
translate russian lexi_sasha_dance_91fc7a4d:
    "Всего несколько мгновений назад Саша проделала со мной то же самое."

# ch/lexi/events.rpy:2870
translate russian lexi_sasha_dance_605068d2:
    "Вот так мы и оказываемся танцующими втроём, обнявшись."

# ch/lexi/events.rpy:2871
translate russian lexi_sasha_dance_d44466a6:
    "Не в силах выбрать между двумя девушками, я просто решаю не выбирать."

# ch/lexi/events.rpy:2877
translate russian lexi_sasha_fuck_fbb0ebc8:
    "Сегодня вечером мне во всём везёт, будто началась полоса сплошных удач."

# ch/lexi/events.rpy:2878
translate russian lexi_sasha_fuck_c994d1dc:
    "В этом ночном клубе лучшая атмосфера из всех, какие мне встречались за долгое время."

# ch/lexi/events.rpy:2879
translate russian lexi_sasha_fuck_1cb7c6ee:
    "Диджей ставит только знакомые мне песни, под которые я люблю танцевать."

# ch/lexi/events.rpy:2881
translate russian lexi_sasha_fuck_d17333bb:
    "И вдобавок Саше хочется танцевать, очень тесно прижимаясь ко мне."

# ch/lexi/events.rpy:2882
translate russian lexi_sasha_fuck_2647a72e:
    "И я имею в виду ОЧЕНЬ тесно!"

# ch/lexi/events.rpy:2883
translate russian lexi_sasha_fuck_8d77b650:
    "Она прижимается ко мне и трётся так, что между нами, кажется, нет ни сантиметра."

# ch/lexi/events.rpy:2884
translate russian lexi_sasha_fuck_75fed88b:
    "От этого то, что происходит дальше, впечатляет ещё сильнее."

# ch/lexi/events.rpy:2886
translate russian lexi_sasha_fuck_e6bbc2e5:
    "Потому что, снова опустив взгляд в ожидании увидеть Сашу, я обнаруживаю перед собой Лекси!"

# ch/lexi/events.rpy:2887
translate russian lexi_sasha_fuck_bc0eb00a:
    "Я и не подозревал, что она вообще на танцполе, не говоря уже о том, что рядом с нами."

# ch/lexi/events.rpy:2888
translate russian lexi_sasha_fuck_20935662:
    "Но каким-то образом она вклинилась между нами, будто пытаясь оттеснить соперницу."

# ch/lexi/events.rpy:2889
translate russian lexi_sasha_fuck_e052ef3d:
    "Может, правильнее было бы сразу вернуться к танцу вдвоём с Сашей."

# ch/lexi/events.rpy:2890
translate russian lexi_sasha_fuck_e1531a61:
    "Или даже демонстративно отчитать Лекси за то, что так бесцеремонно влезла."

# ch/lexi/events.rpy:2891
translate russian lexi_sasha_fuck_a44e545c:
    "Но одного взгляда на лицо Саши хватает, чтобы понять: ни того ни другого от меня не требуется."

# ch/lexi/events.rpy:2892
translate russian lexi_sasha_fuck_bf1ea73f:
    "Вместо раздражения из-за соперницы она лишь улыбается своим мыслям."

# ch/lexi/events.rpy:2896
translate russian lexi_sasha_fuck_75dd3c76:
    "А затем удваивает усилия и снова вступает в борьбу."

