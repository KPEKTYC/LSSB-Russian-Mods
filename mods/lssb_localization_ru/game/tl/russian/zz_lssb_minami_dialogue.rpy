# ch/minami/condom.rpy:4
translate russian minami_use_condom_822fc530:
    "Я ненадолго останавливаюсь, чтобы дотянуться до прикроватного столика и взять презерватив."

# ch/minami/condom.rpy:5
translate russian minami_use_condom_fd460580:
    "Минами с явным интересом смотрит, как я разрываю упаковку и надеваю его."

# ch/minami/condom.rpy:6
translate russian minami_use_condom_bf509e28:
    "Наверное, стоит порадоваться, что она пользуется этой паузой, чтобы предвкушающе разглядывать мой член."

# ch/minami/condom.rpy:7
translate russian minami_use_condom_02901dc9:
    "Особенно учитывая, что некоторые девушки разозлились бы из-за задержки."

# ch/minami/condom.rpy:9
translate russian minami_use_condom_e821f467:
    "Но это не значит, что я собираюсь пренебрегать защитой."

# ch/minami/condom.rpy:10
translate russian minami_use_condom_20155d11:
    "Поэтому я останавливаюсь и тянусь за презервативом на прикроватном столике."

# ch/minami/condom.rpy:11
translate russian minami_use_condom_b9a4471a:
    minami.say "Поторопись, братик!"

# ch/minami/condom.rpy:12
translate russian minami_use_condom_41ef0227:
    minami.say "Угх..."

# ch/minami/condom.rpy:13
translate russian minami_use_condom_fad2812c:
    minami.say "Ну что так долго?"

# ch/minami/condom.rpy:14
translate russian minami_use_condom_217b87f0:
    "Минами оглядывается через плечо."

# ch/minami/condom.rpy:15
translate russian minami_use_condom_9b961d01:
    "Я поднимаю презерватив, чтобы она его увидела."

# ch/minami/condom.rpy:16
translate russian minami_use_condom_ab6d63da:
    "Поняв причину задержки, она тут же меняется в лице."

# ch/minami/condom.rpy:17
translate russian minami_use_condom_1f5f03ab:
    "И всё же нетерпеливо кивает, поторапливая меня, пока я его надеваю."

# ch/minami/condom.rpy:18
translate russian minami_use_condom_d0a062e8:
    "Теперь всё готово."

# ch/minami/condom.rpy:20
translate russian minami_use_condom_f1fe1d17:
    "В любом случае мы оба можем подождать ещё пару секунд, чтобы избежать неприятных случайностей."

# ch/minami/condom.rpy:21
translate russian minami_use_condom_3d172d68:
    "Не сдвигая Минами с места, я беру презерватив с прикроватного столика и протягиваю ей."

# ch/minami/condom.rpy:22
translate russian minami_use_condom_15bf32dc:
    "Она берёт его без лишних объяснений и разрывает упаковку зубами."

# ch/minami/condom.rpy:23
translate russian minami_use_condom_7b5c8b07:
    "Клянусь, она едва не облизывается, раскатывая его по моему члену."

# ch/minami/condom.rpy:25
translate russian minami_use_condom_62a47b98:
    "Но нужно позаботиться о безопасности."

# ch/minami/condom.rpy:26
translate russian minami_use_condom_314dd9b1:
    "Поэтому я поднимаю руку, останавливая Минами."

# ch/minami/condom.rpy:27
translate russian minami_use_condom_4de5c705:
    mike.say "Погоди минутку, Минами."

# ch/minami/condom.rpy:28
translate russian minami_use_condom_5932d637:
    mike.say "Нам следует воспользоваться защитой."

# ch/minami/condom.rpy:29
translate russian minami_use_condom_eeb70bea:
    "Минами смотрит на меня и моргает, словно совсем об этом забыла."

# ch/minami/condom.rpy:30
translate russian minami_use_condom_6a350c34:
    "Затем кивает, призывая меня поскорее всё уладить."

# ch/minami/condom.rpy:31
translate russian minami_use_condom_5c938a8c:
    "Я понимаю намёк, хватаю презерватив и надеваю его с рекордной скоростью."

# ch/minami/condom.rpy:32
translate russian minami_use_condom_d0a062e8_1:
    "Теперь всё готово."

# ch/minami/condom.rpy:44
translate russian minami_warn_condom_1af7f405:
    minami.say "Братик..."

# ch/minami/condom.rpy:45
translate russian minami_warn_condom_62a44b79:
    minami.say "Тебе не пора бы..."

# ch/minami/condom.rpy:46
translate russian minami_warn_condom_fd37f5f4:
    minami.say "Ну... кое-что надеть?"

# ch/minami/condom.rpy:48
translate russian minami_warn_condom_4871a086:
    minami.say "Ой... подожди, братик!"

# ch/minami/condom.rpy:49
translate russian minami_warn_condom_a432e15f:
    minami.say "Нам нужен презерватив!"

# ch/minami/condom.rpy:50
translate russian minami_warn_condom_c038110e:
    "Я замираю на месте."

# ch/minami/condom.rpy:51
translate russian minami_warn_condom_20bb6588:
    "Мой член всего в паре миллиметров от киски Минами!"

# ch/minami/condom.rpy:53
translate russian minami_warn_condom_7df764da:
    minami.say "М-м-м..."

# ch/minami/condom.rpy:54
translate russian minami_warn_condom_d6d7067a:
    minami.say "Как же ХОРОШО будет чувствовать его в себе!"

# ch/minami/condom.rpy:55
translate russian minami_warn_condom_c1b6677d:
    minami.say "Если ты наденешь презерватив, конечно..."

# ch/minami/condom.rpy:61
translate russian minami_force_condom_c35d9010:
    "Я ненадолго останавливаюсь, чтобы взять презерватив, который Минами достаёт из кучи сброшенной одежды."

# ch/minami/condom.rpy:62
translate russian minami_force_condom_3bfc4257:
    "Она с явным интересом смотрит, как я разрываю упаковку и надеваю его."

# ch/minami/condom.rpy:63
translate russian minami_force_condom_beee0c4a:
    "Наверное, стоит порадоваться, что она обо всём подумала заранее."

# ch/minami/condom.rpy:64
translate russian minami_force_condom_4ae6d43d:
    "Особенно учитывая, что некоторые девушки целиком оставляют это на совести парня."

# ch/minami/condom.rpy:66
translate russian minami_force_condom_495527b1:
    minami.say "Не волнуйся, братик."

# ch/minami/condom.rpy:67
translate russian minami_force_condom_767cc904:
    minami.say "У меня есть один в сумочке!"

# ch/minami/condom.rpy:68
translate russian minami_force_condom_90796992:
    "Минами соскакивает с кровати и начинает рыться в своих вещах."

# ch/minami/condom.rpy:69
translate russian minami_force_condom_66715568:
    "Быстро найдя презерватив, она снова забирается на кровать передо мной."

# ch/minami/condom.rpy:70
translate russian minami_force_condom_fdc97e64:
    "Минами нетерпеливо кивает, поторапливая меня, пока я его надеваю."

# ch/minami/condom.rpy:71
translate russian minami_force_condom_d0a062e8:
    "Теперь всё готово."

# ch/minami/condom.rpy:73
translate russian minami_force_condom_cd6a20d3:
    minami.say "Тебе повезло, что я всё предусмотрела!"

# ch/minami/condom.rpy:74
translate russian minami_force_condom_01acb6a5:
    "Минами откуда-то достаёт презерватив, оставляя меня гадать, где она его прятала."

# ch/minami/condom.rpy:75
translate russian minami_force_condom_c7440996:
    "Затем она берёт дело в свои руки и разрывает упаковку зубами."

# ch/minami/condom.rpy:76
translate russian minami_force_condom_7b5c8b07:
    "Клянусь, она едва не облизывается, раскатывая его по моему члену."

# ch/minami/condom.rpy:83
translate russian minami_mad_condom_e84ffc6f:
    mike.say "Что?"

# ch/minami/condom.rpy:84
translate russian minami_mad_condom_d6e6f0f5:
    mike.say "Минами, ты же не серьёзно?!"

# ch/minami/condom.rpy:85
translate russian minami_mad_condom_6c6ff154:
    minami.say "А почему бы и нет, братик?"

# ch/minami/condom.rpy:86
translate russian minami_mad_condom_8f247fa0:
    mike.say "Мы приёмные брат и сестра, нарушаем все правила и трахаемся."

# ch/minami/condom.rpy:87
translate russian minami_mad_condom_110de460:
    mike.say "Я думал, мы слишком безбашенные, чтобы заморачиваться с презервативами!"

# ch/minami/condom.rpy:88
translate russian minami_mad_condom_6dc678b1:
    minami.say "Ну, раз так, сегодня ночью будешь безумствовать со своей рукой!"

# ch/minami/condom.rpy:89
translate russian minami_mad_condom_80ba3390:
    "С этими словами Минами выскальзывает из-под меня и начинает одеваться."

# ch/minami/condom.rpy:91
translate russian minami_mad_condom_fb8993dd:
    mike.say "Ох..."

# ch/minami/condom.rpy:92
translate russian minami_mad_condom_846b1dd8:
    mike.say "Это обязательно, Минами?"

# ch/minami/condom.rpy:93
translate russian minami_mad_condom_5d2d8b8d:
    mike.say "Я ведь могу просто вынуть в конце, да?"

# ch/minami/condom.rpy:94
translate russian minami_mad_condom_91d2bd51:
    minami.say "Ни за что, братик!"

# ch/minami/condom.rpy:95
translate russian minami_mad_condom_9b9e12b6:
    minami.say "Нет защиты — нет киски!"

# ch/minami/condom.rpy:96
translate russian minami_mad_condom_099d8290:
    minami.say "Хмпф!"

# ch/minami/condom.rpy:97
translate russian minami_mad_condom_a6cf28c7:
    "Минами соскакивает с кровати и начинает одеваться."

# ch/minami/condom.rpy:98
translate russian minami_mad_condom_d2431754:
    "Я знаю, что спорить с ней бесполезно."

# ch/minami/condom.rpy:99
translate russian minami_mad_condom_efb14fa0:
    "Она всё решила, и точка."

# ch/minami/condom.rpy:100
translate russian minami_mad_condom_6b91dac8:
    "Похоже, я только что упустил свой шанс и обеспечил себе ночь в одиночестве!"

# ch/minami/condom.rpy:102
translate russian minami_mad_condom_91b0a8c7:
    mike.say "Да ладно тебе, Минами!"

# ch/minami/condom.rpy:103
translate russian minami_mad_condom_e082c952:
    mike.say "Я думал, ты любишь отрываться и безумствовать!"

# ch/minami/condom.rpy:104
translate russian minami_mad_condom_418a25e8:
    minami.say "Да, но..."

# ch/minami/condom.rpy:105
translate russian minami_mad_condom_bdd2a591:
    minami.say "С ребёнком на руках это будет довольно трудно!"

# ch/minami/condom.rpy:106
translate russian minami_mad_condom_cb5ac61d:
    "С этими словами она слезает с меня и снова начинает одеваться."

# ch/minami/condom.rpy:107
translate russian minami_mad_condom_df8568ea:
    minami.say "Нет презерватива на тебе — нет члена во мне."

# ch/minami/condom.rpy:108
translate russian minami_mad_condom_8214c754:
    minami.say "Дай знать, когда это дойдёт до твоей тугой головы, братик."

# ch/minami/date.rpy:3
translate russian minami_date_intro_valentine_male_ef6c93d7:
    minami.say "Эй, братик..."

# ch/minami/date.rpy:4
translate russian minami_date_intro_valentine_male_5639f752:
    minami.say "Ну что, мой Валентин готов к нашему грандиозному свиданию?"

# ch/minami/date.rpy:7
translate russian minami_date_intro_valentine_male_d647dc73:
    "Я не могу оторвать от неё глаз и не хочу."

# ch/minami/date.rpy:8
translate russian minami_date_intro_valentine_male_bcf16d4e:
    "Сегодня она моя девушка на свидании, и я больше не собираюсь относиться к ней иначе."

# ch/minami/date.rpy:9
translate russian minami_date_intro_valentine_male_ffa648bb:
    "Младшая сестра, которая переехала ко мне, стала той, от кого я не могу отвести глаз, и мысленно я уже снимаю с неё этот наряд."

# ch/minami/date.rpy:11
translate russian minami_date_intro_valentine_male_247f739b:
    "Я не могу оторвать от неё глаз."

# ch/minami/date.rpy:12
translate russian minami_date_intro_valentine_male_a933dc29:
    "Она такая горячая, что у меня пересыхает во рту, пока я просто стою рядом."

# ch/minami/date.rpy:13
translate russian minami_date_intro_valentine_male_cc874a0a:
    "Я уже думаю о том, как позже сниму с неё этот наряд."

# ch/minami/date.rpy:15
translate russian minami_date_intro_valentine_male_58907490:
    "Я не могу оторвать от неё глаз, и именно в этом проблема."

# ch/minami/date.rpy:16
translate russian minami_date_intro_valentine_male_0a4eb1f9:
    "Она моя младшая сестра, приёмная или нет, и мне не следует так на неё смотреть."

# ch/minami/date.rpy:17
translate russian minami_date_intro_valentine_male_442773cc:
    "Но сегодня она так хороша, что чувства вины просто недостаточно, чтобы меня остановить."

# ch/minami/date.rpy:19
translate russian minami_date_intro_valentine_male_3c464432:
    "Я киваю и замечаю, что засмотрелся на неё чуть дольше, чем стоило."

# ch/minami/date.rpy:20
translate russian minami_date_intro_valentine_male_661b5496:
    "В том, как она нарядилась, есть что-то, что застаёт меня врасплох."

# ch/minami/date.rpy:21
translate russian minami_date_intro_valentine_male_54763c4b:
    "Я отгоняю эту мысль, прежде чем она успевает оформиться."

# ch/minami/date.rpy:23
translate russian minami_date_intro_valentine_male_79a489a7:
    "Я киваю, радуясь тому, с каким восторгом младшая сестрёнка ждёт нашего свидания."

# ch/minami/date.rpy:24
translate russian minami_date_intro_valentine_male_c7cecd1a:
    "Она мило нарядилась и суетится от нетерпения, совсем как в детстве."

# ch/minami/date.rpy:25
translate russian minami_date_intro_valentine_male_b3d45eb4:
    "Приятно видеть её такой счастливой."

# ch/minami/date.rpy:26
translate russian minami_date_intro_valentine_male_d9407c27:
    mike.say "О да, Минами!"

# ch/minami/date.rpy:27
translate russian minami_date_intro_valentine_male_362d4f2d:
    mike.say "Я ещё никогда ни к чему не был так готов!"

# ch/minami/date.rpy:29
translate russian minami_date_intro_valentine_male_1cce741c:
    "Минами хихикает и радостно хлопает в ладоши."

# ch/minami/date.rpy:33
translate russian minami_date_intro_halloween_male_b4ef5aa0:
    mike.say "Эй, Минами, почему в этом году без костюма?"

# ch/minami/date.rpy:34
translate russian minami_date_intro_halloween_male_1712aa73:
    mike.say "У тебя же ими вся спальня забита?"

# ch/minami/date.rpy:36
translate russian minami_date_intro_halloween_male_aa948fd3:
    "Минами недоумённо морщит нос."

# ch/minami/date.rpy:38
translate russian minami_date_intro_halloween_male_90386081:
    minami.say "Зачем мне костюм, братик?"

# ch/minami/date.rpy:39
translate russian minami_date_intro_halloween_male_71f7a876:
    minami.say "Мы же идём на свидание!"

# ch/minami/date.rpy:41
translate russian minami_date_intro_halloween_male_de9ee5ce:
    mike.say "Ну... сегодня Хэллоуин."

# ch/minami/date.rpy:43
translate russian minami_date_intro_halloween_male_0e141f46:
    minami.say "Правда?!"

# ch/minami/date.rpy:45
translate russian minami_date_intro_halloween_male_9291da58:
    minami.say "Ой... я так усердно училась, что совсем забыла!"

# ch/minami/date.rpy:48
translate russian minami_date_intro_halloween_male_99c668c4:
    "Даже когда она дуется, я представляю, как сидел бы на ней этот наряд."

# ch/minami/date.rpy:49
translate russian minami_date_intro_halloween_male_3a96aa11:
    "В костюме или без, я не могу отвести от неё глаз и уже перестал с этим бороться."

# ch/minami/date.rpy:51
translate russian minami_date_intro_halloween_male_2b799f6a:
    "Даже надув губки, она притягивает меня так, что по спине пробегает дрожь."

# ch/minami/date.rpy:52
translate russian minami_date_intro_halloween_male_1c5aca4f:
    "Мой взгляд всё время скользит по ней, задерживаясь там, где не следует."

# ch/minami/date.rpy:54
translate russian minami_date_intro_halloween_male_d0f52c8b:
    "Она дуется, а я ловлю себя на мысли о том, какая она милая."

# ch/minami/date.rpy:55
translate russian minami_date_intro_halloween_male_6f8a1a15:
    "Она моя приёмная сестра, и мне совсем не следует обращать на это такое внимание."

# ch/minami/date.rpy:57
translate russian minami_date_intro_halloween_male_b8343aae:
    "От её надутых губок во мне поднимается тепло — чуть более сильное, чем следовало бы."

# ch/minami/date.rpy:58
translate russian minami_date_intro_halloween_male_6b699c6a:
    "Я отмахиваюсь от этой мысли, не давая ей укорениться."

# ch/minami/date.rpy:60
translate russian minami_date_intro_halloween_male_c27257f3:
    "Она дуется точно так же, как в детстве, когда путалась в своих планах."

# ch/minami/date.rpy:61
translate russian minami_date_intro_halloween_male_64695f0c:
    "Всё та же забывчивая Минами."

# ch/minami/date.rpy:62
translate russian minami_date_intro_halloween_male_6904d97d:
    mike.say "Не переживай, Минами."

# ch/minami/date.rpy:64
translate russian minami_date_intro_halloween_male_2d84f9d1:
    mike.say "Мы всё равно отлично проведём время на свидании."

# ch/minami/date.rpy:69
translate russian minami_date_intro_christmas_male_30c69f03:
    minami.say "С Рождеством, братик!"

# ch/minami/date.rpy:70
translate russian minami_date_intro_christmas_male_47266755:
    minami.say "Пойдём, у нас сегодня свидание!"

# ch/minami/date.rpy:72
translate russian minami_date_intro_christmas_male_957df3a8:
    "Минами хватает меня за руку и тянет за собой."

# ch/minami/date.rpy:73
translate russian minami_date_intro_christmas_male_e9f43394:
    "В такие моменты устоять перед её энтузиазмом невозможно."

# ch/minami/date.rpy:75
translate russian minami_date_intro_christmas_male_4ebac297:
    "Когда она тянет меня за руку, мой взгляд тут же скользит вниз по её телу."

# ch/minami/date.rpy:76
translate russian minami_date_intro_christmas_male_42c53a84:
    "Она моя приёмная сестра, и я всё равно её хочу."

# ch/minami/date.rpy:78
translate russian minami_date_intro_christmas_male_70c8a9e1:
    "Тепло её пальцев посылает по руке дрожь, которая отзывается где-то ниже."

# ch/minami/date.rpy:79
translate russian minami_date_intro_christmas_male_bd861c6b:
    "Мне приходится изо всех сил стараться смотреть ей в лицо."

# ch/minami/date.rpy:81
translate russian minami_date_intro_christmas_male_c33732c7:
    "Её маленькая ладонь слишком хорошо лежит в моей, и я слишком остро это замечаю."

# ch/minami/date.rpy:82
translate russian minami_date_intro_christmas_male_8ff1f0bf:
    "Оттого, что я держу её за руку, пульс не должен так подскакивать."

# ch/minami/date.rpy:84
translate russian minami_date_intro_christmas_male_d1a34917:
    "Её рука в моей вызывает больше тепла, чем прежде."

# ch/minami/date.rpy:85
translate russian minami_date_intro_christmas_male_c1b71ef9:
    "Я списываю это на холод и позволяю ей тащить меня за собой."

# ch/minami/date.rpy:87
translate russian minami_date_intro_christmas_male_c1ede8c5:
    "Она так же крепко цепляется своей ладошкой, как в детстве."

# ch/minami/date.rpy:88
translate russian minami_date_intro_christmas_male_67ce38c6:
    "Как и каждый год, она ещё с ноября считает дни до праздников."

# ch/minami/date.rpy:90
translate russian minami_date_intro_christmas_male_b38de0f5:
    mike.say "Эй... не так быстро, Минами!"

# ch/minami/date.rpy:91
translate russian minami_date_intro_christmas_male_9fcec9e2:
    mike.say "Я и так еле поспеваю!"

# ch/minami/date.rpy:95
translate russian minami_date_intro_birthday_male_e0d2dfc9:
    mike.say "С днём рождения, Минами!"

# ch/minami/date.rpy:96
translate russian minami_date_intro_birthday_male_8522fa13:
    mike.say "Думала, я забуду, да?"

# ch/minami/date.rpy:98
translate russian minami_date_intro_birthday_male_dc35049c:
    minami.say "Спасибо, братик."

# ch/minami/date.rpy:100
translate russian minami_date_intro_birthday_male_c81811f4:
    minami.say "Вообще-то я знала, что ты вспомнишь."

# ch/minami/date.rpy:101
translate russian minami_date_intro_birthday_male_1a33fd5a:
    minami.say "Мы же в детстве всегда отмечали дни рождения друг друга!"

# ch/minami/date.rpy:104
translate russian minami_date_intro_birthday_male_667ce45c:
    "Мы столько дней рождения провели вместе, а теперь я не могу смотреть на неё, не желая её."

# ch/minami/date.rpy:105
translate russian minami_date_intro_birthday_male_9e07bc85:
    "Она стала женщиной у меня на глазах, и мой взгляд не даёт об этом забыть."

# ch/minami/date.rpy:107
translate russian minami_date_intro_birthday_male_758dc0ea:
    "Я смотрю на неё и замечаю, что разглядываю её куда дольше, чем следовало бы."

# ch/minami/date.rpy:108
translate russian minami_date_intro_birthday_male_797cc5dd:
    "Мысль о том, чтобы сегодня остаться с ней наедине, вытесняет всё остальное."

# ch/minami/date.rpy:110
translate russian minami_date_intro_birthday_male_7addcd88:
    "Я улыбаюсь в ответ, но за улыбкой скрывается жар, который приходится постоянно унимать."

# ch/minami/date.rpy:111
translate russian minami_date_intro_birthday_male_adfa94cb:
    "Она моя приёмная сестра, и я не должен так её оценивать."

# ch/minami/date.rpy:113
translate russian minami_date_intro_birthday_male_71c4e09f:
    "Это воспоминание вызывает неожиданное тепло, и я не понимаю почему."

# ch/minami/date.rpy:114
translate russian minami_date_intro_birthday_male_dac653c5:
    "Я отгоняю эти мысли и просто радуюсь её счастью."

# ch/minami/date.rpy:116
translate russian minami_date_intro_birthday_male_13c2c269:
    "В памяти всплывают все те детские дни рождения: торт, свечи и её улыбка."

# ch/minami/date.rpy:117
translate russian minami_date_intro_birthday_male_d8a9eeb5:
    "Она моя младшая сестрёнка, и сегодня я, как всегда, буду баловать её без меры."

# ch/minami/date.rpy:118
translate russian minami_date_intro_birthday_male_dcd72508:
    mike.say "А, да, точно."

# ch/minami/date.rpy:123
translate russian minami_date_intro_mc_birthday_male_015e0bb9:
    minami.say "С днём рождения, братик!"

# ch/minami/date.rpy:125
translate russian minami_date_intro_mc_birthday_male_8b1807e2:
    minami.say "А в подарок тебя ждёт суперпотрясающее свидание со мной!"

# ch/minami/date.rpy:127
translate russian minami_date_intro_mc_birthday_male_d235c32d:
    "Целый день она будет передо мной, и я уже знаю, куда буду смотреть."

# ch/minami/date.rpy:128
translate russian minami_date_intro_mc_birthday_male_1c686d17:
    "Она моя приёмная сестра, и всё равно я хочу её как женщину."

# ch/minami/date.rpy:130
translate russian minami_date_intro_mc_birthday_male_84d8371b:
    "Целый день Минами будет только со мной, и мои мысли уходят куда-то не туда."

# ch/minami/date.rpy:131
translate russian minami_date_intro_mc_birthday_male_8c9830bd:
    "Я уже представляю, чем хотел бы закончить этот вечер, и ничего невинного в этом нет."

# ch/minami/date.rpy:133
translate russian minami_date_intro_mc_birthday_male_a1b8d4d7:
    "День наедине с ней кажется куда заманчивее, чем следовало бы."

# ch/minami/date.rpy:134
translate russian minami_date_intro_mc_birthday_male_dbc952a0:
    "Она моя приёмная сестра, а мне то и дело приходится отрывать мысли от её тела."

# ch/minami/date.rpy:136
translate russian minami_date_intro_mc_birthday_male_7f709376:
    "Мысль о целом дне вместе с ней вызывает в груди неожиданно сильное тепло."

# ch/minami/date.rpy:137
translate russian minami_date_intro_mc_birthday_male_1d33ccdb:
    "Я списываю это на праздничное настроение и больше не думаю об этом."

# ch/minami/date.rpy:139
translate russian minami_date_intro_mc_birthday_male_5f18db1e:
    "Только Минами могла объявить себя подарком — как и в нашем детстве."

# ch/minami/date.rpy:140
translate russian minami_date_intro_mc_birthday_male_9d12deb3:
    "Моя младшая сестрёнка безмерно балует меня в день рождения."

# ch/minami/date.rpy:141
translate russian minami_date_intro_mc_birthday_male_8a1b228a:
    mike.say "Спасибо, Минами."

# ch/minami/date.rpy:142
translate russian minami_date_intro_mc_birthday_male_998bfc0c:
    mike.say "Кажется, о лучшем подарке я и мечтать не мог!"

# ch/minami/date.rpy:143
translate russian minami_date_intro_mc_birthday_male_60dacb8e:
    mike.say "Стоило догадаться, что ты ни за что не забудешь мой день рождения."

# ch/minami/date.rpy:145
translate russian minami_date_intro_mc_birthday_male_ac46d242:
    minami.say "В смысле, братик? Как ты забываешь мой?"

# ch/minami/date.rpy:151
translate russian minami_date_pub_male_41ef0227:
    minami.say "Угх..."

# ch/minami/date.rpy:152
translate russian minami_date_pub_male_20b82363:
    minami.say "Тебе не кажется, что здесь, ну... скучновато?"

# ch/minami/date.rpy:158
translate russian minami_date_cinema_male_5a53f159:
    minami.say "Я хотела посмотреть этот фильм с самого выхода."

# ch/minami/date.rpy:159
translate russian minami_date_cinema_male_a828e543:
    minami.say "Так что не болтай и уж точно НИКАКИХ СПОЙЛЕРОВ!"

# ch/minami/date.rpy:165
translate russian minami_date_familyrestaurant_male_37cd36d0:
    minami.say "Хм..."

# ch/minami/date.rpy:167
translate russian minami_date_familyrestaurant_male_07794ede:
    minami.say "Здесь вроде неплохо, но очень уж похоже на места, куда нас водили мама с папой."

# ch/minami/date.rpy:173
translate russian minami_date_restaurant_male_96fee5c4:
    minami.say "О-о, как здесь шикарно!"

# ch/minami/date.rpy:175
translate russian minami_date_restaurant_male_d6d375c5:
    minami.say "Давай закажем самое дорогое блюдо, а потом сбежим!"

# ch/minami/date.rpy:181
translate russian minami_date_amusmentpark_male_70a2d460:
    minami.say "О-о, я просто ОБОЖАЮ парки аттракционов."

# ch/minami/date.rpy:183
translate russian minami_date_amusmentpark_male_dd8669ec:
    minami.say "Хочу покататься на том, и на том... И НА ВОТ ЭТОМ ПРЯМО СЕЙЧАС!"

# ch/minami/date.rpy:189
translate russian minami_date_ride_the_ferris_wheel_2de5c4ce:
    minami.say "Да, крутится оно медленно."

# ch/minami/date.rpy:190
translate russian minami_date_ride_the_ferris_wheel_d2b7427f:
    minami.say "Зато этим видом можем любоваться только мы вдвоём..."

# ch/minami/date.rpy:194
translate russian minami_date_ride_the_ferris_wheel_991cb411:
    "Только мы вдвоём, запертые высоко над парком, и мне некуда прятать взгляд."

# ch/minami/date.rpy:195
translate russian minami_date_ride_the_ferris_wheel_8870fb4c:
    "Она моя приёмная сестра, но здесь, наверху, я позволяю себе смотреть на неё так, как на самом деле хочу."

# ch/minami/date.rpy:197
translate russian minami_date_ride_the_ferris_wheel_f1c030c3:
    "Мы наедине в маленькой кабинке, покачивающейся над огнями, и мой пульс никак не успокоится."

# ch/minami/date.rpy:198
translate russian minami_date_ride_the_ferris_wheel_981250c5:
    "Это уединение опасно расширяет границы мыслей, которые я себе позволяю."

# ch/minami/date.rpy:200
translate russian minami_date_ride_the_ferris_wheel_6e53cdc0:
    "Оказавшись с ней наедине в замкнутом пространстве, я начинаю думать о том, о чём не следует."

# ch/minami/date.rpy:201
translate russian minami_date_ride_the_ferris_wheel_a806e9fd:
    "Она моя приёмная сестра, и находиться с ней так близко, наедине, нелегко."

# ch/minami/date.rpy:203
translate russian minami_date_ride_the_ferris_wheel_7947bcef:
    "Здесь, наверху, наедине с ней, меня накрывает неожиданное тепло."

# ch/minami/date.rpy:204
translate russian minami_date_ride_the_ferris_wheel_813394c5:
    "Я сосредотачиваюсь на виде и позволяю этому чувству пройти."

# ch/minami/date.rpy:206
translate russian minami_date_ride_the_ferris_wheel_cd42473e:
    "Она всегда больше всего любила неспешные аттракционы, с которых можно любоваться огнями парка."

# ch/minami/date.rpy:207
translate russian minami_date_ride_the_ferris_wheel_ab3a0756:
    "Только мы вдвоём и этот вид — как тогда, когда она ещё помещалась у меня на плечах."

# ch/minami/date.rpy:213
translate russian minami_date_waterpark_male_47d35685:
    minami.say "Ура! Аквапарк!"

# ch/minami/date.rpy:214
translate russian minami_date_waterpark_male_3e8048bb:
    minami.say "Готовься: я тебя обрызгаю!"

# ch/minami/date.rpy:220
translate russian minami_date_park_male_73972a4c:
    minami.say "Просто прогулка в парке... серьёзно?"

# ch/minami/date.rpy:221
translate russian minami_date_park_male_7741b38a:
    minami.say "Эм... наверное, тоже неплохо..."

# ch/minami/date.rpy:226
translate russian minami_date_eat_a_burger_f8adfd9b:
    "При виде бургера Минами улыбается до ушей."

# ch/minami/date.rpy:227
translate russian minami_date_eat_a_burger_0bb6d98c:
    "И куски от него она откусывает будь здоров!"

# ch/minami/date.rpy:228
translate russian minami_date_eat_a_burger_15d724c7:
    "Я почти забыл, какой отменный аппетит у этой миниатюрной девушки."

# ch/minami/date.rpy:235
translate russian minami_date_buy_drink_33b341ec:
    minami.say "Мне нельзя пиво, братик!"

# ch/minami/date.rpy:236
translate russian minami_date_buy_drink_32e9d13f:
    minami.say "Это вредно для малыша."

# ch/minami/date.rpy:237
translate russian minami_date_buy_drink_86eb6250:
    minami.say "Мы скоро станем родителями — тебе нужно быть ответственнее!"

# ch/minami/date.rpy:241
translate russian minami_date_buy_drink_36b1da2f:
    "Минами и глазом не моргает, когда я протягиваю ей напиток, который она попросила."

# ch/minami/date.rpy:242
translate russian minami_date_buy_drink_805e51b3:
    "Просто берёт его и с удовольствием начинает потягивать."

# ch/minami/date.rpy:243
translate russian minami_date_buy_drink_3b99768a:
    "Похоже, она привыкла получать всё, что хочет!"

# ch/minami/date.rpy:247
translate russian minami_date_play_darts_9fc8f4c8:
    "Идея поиграть в дартс не вызывает у Минами особого восторга."

# ch/minami/date.rpy:248
translate russian minami_date_play_darts_e4e2de18:
    "Но она всё равно кивает и выдавливает улыбку."

# ch/minami/date.rpy:249
translate russian minami_date_play_darts_6efcbadb:
    "В итоге я чувствую себя виноватым, когда легко её обыгрываю."

# ch/minami/date.rpy:253
translate russian minami_date_pub_play_pool_f0b77ed6:
    "Минами берёт кий, который почти с неё ростом."

# ch/minami/date.rpy:254
translate russian minami_date_pub_play_pool_8c1b48fb:
    "Она правда изо всех сил старается играть как следует."

# ch/minami/date.rpy:256
translate russian minami_date_pub_play_pool_f7b7cde6:
    "Но каждый раз, когда она наклоняется для удара, её короткая юбка задирается."

# ch/minami/date.rpy:257
translate russian minami_date_pub_play_pool_36fdf757:
    "Я больше даже не притворяюсь, что отвожу взгляд, — не с таким видом из-под юбки."

# ch/minami/date.rpy:259
translate russian minami_date_pub_play_pool_60d6ea95:
    "Но каждый раз, когда она наклоняется над столом, её короткая юбка задирается."

# ch/minami/date.rpy:260
translate russian minami_date_pub_play_pool_12d91092:
    "Я не могу отвести от неё глаз и уже считаю минуты до возвращения домой."

# ch/minami/date.rpy:262
translate russian minami_date_pub_play_pool_5b19f193:
    "Но каждый раз, когда она нагибается над столом, её короткая юбка задирается."

# ch/minami/date.rpy:263
translate russian minami_date_pub_play_pool_ccb179d4:
    "Я знаю, что не должен так пялиться на приёмную сестру, но всё равно смотрю."

# ch/minami/date.rpy:265
translate russian minami_date_pub_play_pool_b6845001:
    "Но каждый раз, когда она наклоняется для удара, её короткая юбка немного задирается."

# ch/minami/date.rpy:266
translate russian minami_date_pub_play_pool_26740500:
    "Поймав себя на том, что засмотрелся, я поспешно нахожу что-нибудь другое для разглядывания."

# ch/minami/date.rpy:268
translate russian minami_date_pub_play_pool_9b650080:
    "Но всякий раз, когда короткая юбка задирается, она одёргивает её."

# ch/minami/date.rpy:269
translate russian minami_date_pub_play_pool_35e5984e:
    "Я натираю кий мелом и даю ей прицелиться, радуясь, что мы просто проводим время вместе."

# ch/minami/date.rpy:276
translate russian minami_date_buy_a_round_33b341ec:
    minami.say "Мне нельзя пиво, братик!"

# ch/minami/date.rpy:277
translate russian minami_date_buy_a_round_32e9d13f:
    minami.say "Это вредно для малыша."

# ch/minami/date.rpy:278
translate russian minami_date_buy_a_round_86eb6250:
    minami.say "Мы скоро станем родителями — тебе нужно быть ответственнее!"

# ch/minami/date.rpy:282
translate russian minami_date_buy_a_round_13514bc6:
    "Я встаю и предлагаю принести ещё по бокалу."

# ch/minami/date.rpy:283
translate russian minami_date_buy_a_round_8a6ec4fc:
    "Но по привычке замолкаю: мои друзья обычно хотя бы для вида возражают."

# ch/minami/date.rpy:284
translate russian minami_date_buy_a_round_171edb98:
    "Однако Минами лишь молча улыбается и кивает, напоминая, какой избалованной она порой бывает..."

# ch/minami/date.rpy:291
translate russian minami_date_buy_a_round_fb20fd2c:
    "Я хочу угостить пивом весь паб."

# ch/minami/date.rpy:292
translate russian minami_date_buy_a_round_6e49b542:
    "Но Минами, похоже, не хочет пить, поэтому я отказываюсь от этой затеи."

# ch/minami/date.rpy:297
translate russian minami_dance_with_ec4f0276:
    "Минами чуть ли не подпрыгивает от радости, когда появляется возможность потанцевать со мной."

# ch/minami/date.rpy:298
translate russian minami_dance_with_37aad0fd:
    "Она хватает меня за руку и буквально тащит следом."

# ch/minami/date.rpy:299
translate russian minami_dance_with_f069142a:
    "А затем танцует так близко, что почти всё время висит на мне!"

# ch/minami/date.rpy:301
translate russian minami_dance_with_464917e3:
    "Когда её тело движется вплотную к моему, удержать руки в приличных местах почти невозможно."

# ch/minami/date.rpy:302
translate russian minami_dance_with_40c34a10:
    "Она моя приёмная сестра, а я всем существом ощущаю в ней женщину, которую хочу."

# ch/minami/date.rpy:304
translate russian minami_dance_with_bec5733b:
    "Каждое соприкосновение наших тел словно пропускает через меня ток."

# ch/minami/date.rpy:305
translate russian minami_dance_with_e5e937bb:
    "Приходится собраться с силами, чтобы не утащить её с танцпола куда-нибудь потише."

# ch/minami/date.rpy:307
translate russian minami_dance_with_8833ef2c:
    "Она тёплая и совсем близко, и я слишком остро ощущаю, как она прижимается ко мне."

# ch/minami/date.rpy:308
translate russian minami_dance_with_860dc809:
    "Объятия приёмной сестры не должны быть настолько приятными, но вот она, рядом."

# ch/minami/date.rpy:310
translate russian minami_dance_with_f9ebe31a:
    "Эта близость вызывает смущение и тепло, с которыми я не знаю, что делать."

# ch/minami/date.rpy:311
translate russian minami_dance_with_83154f53:
    "Я говорю себе, что всё дело в музыке, и продолжаю двигаться."

# ch/minami/date.rpy:313
translate russian minami_dance_with_8352d2aa:
    "Она цепляется за меня точно так же, как в детстве, когда нас вытаскивали танцевать."

# ch/minami/date.rpy:314
translate russian minami_dance_with_eec41576:
    "Всё так же ко мне липнет. Некоторые вещи не меняются."

# ch/minami/date.rpy:318
translate russian minami_date_play_arcade_intro_male_526e1381:
    minami.say "О... МОЙ... БОГ!"

# ch/minami/date.rpy:319
translate russian minami_date_play_arcade_intro_male_84040c29:
    minami.say "Братик, здесь потрясающе!"

# ch/minami/date.rpy:320
translate russian minami_date_play_arcade_intro_male_ac4c60e9:
    minami.say "И сколько ты ещё собирался скрывать от меня это место?!"

# ch/minami/date.rpy:321
translate russian minami_date_play_arcade_intro_male_52de32a6:
    "Я невольно улыбаюсь, когда Минами обгоняет меня и влетает в зал игровых автоматов."

# ch/minami/date.rpy:322
translate russian minami_date_play_arcade_intro_male_dfd95f5d:
    "Она словно ребёнок в кондитерской: мечется от одного автомата к другому."

# ch/minami/date.rpy:323
translate russian minami_date_play_arcade_intro_male_177b40b4:
    mike.say "Я ничего от тебя не скрывал, Минами."

# ch/minami/date.rpy:324
translate russian minami_date_play_arcade_intro_male_f1ed3aa8:
    mike.say "Просто сейчас выдался отличный повод привести тебя сюда."

# ch/minami/date.rpy:325
translate russian minami_date_play_arcade_intro_male_f2cd28cc:
    mike.say "Это место напоминает мне игровые залы, в которые мы ходили дома."

# ch/minami/date.rpy:326
translate russian minami_date_play_arcade_intro_male_8e7d6c4f:
    "Минами берёт меня за руку и тянет за собой."

# ch/minami/date.rpy:327
translate russian minami_date_play_arcade_intro_male_6d5a4cde:
    "Куда бы она ни повернула, мы оказываемся перед знакомым автоматом."

# ch/minami/date.rpy:328
translate russian minami_date_play_arcade_intro_male_d62e5d7d:
    minami.say "Мы же раньше во ВСЁ это играли!"

# ch/minami/date.rpy:329
translate russian minami_date_play_arcade_intro_male_a765fbe2:
    minami.say "Ох, чёрт, братик..."

# ch/minami/date.rpy:330
translate russian minami_date_play_arcade_intro_male_5f7892d0:
    minami.say "И как нам теперь выбрать?"

# ch/minami/date.rpy:331
translate russian minami_date_play_arcade_intro_male_4c72744e:
    "Я пожимаю плечами и качаю головой."

# ch/minami/date.rpy:332
translate russian minami_date_play_arcade_intro_male_b0325548:
    "Но тут замечаю один особенный автомат."

# ch/minami/date.rpy:333
translate russian minami_date_play_arcade_intro_male_adbc8689:
    mike.say "Эй, Минами..."

# ch/minami/date.rpy:334
translate russian minami_date_play_arcade_intro_male_3a99efef:
    mike.say "Это же «Луна Маринер»?"

# ch/minami/date.rpy:335
translate russian minami_date_play_arcade_intro_male_c5a6cf41:
    mike.say "Та самая игра с матросками?"

# ch/minami/date.rpy:336
translate russian minami_date_play_arcade_intro_male_cb4e866c:
    minami.say "Да, братик!"

# ch/minami/date.rpy:337
translate russian minami_date_play_arcade_intro_male_b5906526:
    minami.say "Помнишь такой автомат у нас в игровом зале?"

# ch/minami/date.rpy:338
translate russian minami_date_play_arcade_intro_male_ab505723:
    minami.say "По-моему, мы его до дыр затёрли!"

# ch/minami/date.rpy:339
translate russian minami_date_play_arcade_intro_male_cc38f80b:
    "Никому из нас больше ничего не нужно говорить."

# ch/minami/date.rpy:340
translate russian minami_date_play_arcade_intro_male_b882f8f9:
    "Мы просто обмениваемся понимающим взглядом."

# ch/minami/date.rpy:342
translate russian minami_date_play_arcade_intro_male_70415965:
    "Этот взгляд притягивает меня, и я невольно скольжу глазами по её телу."

# ch/minami/date.rpy:343
translate russian minami_date_play_arcade_intro_male_c76e1514:
    "Она моя приёмная сестра, но я хочу её как женщину, стоящую рядом."

# ch/minami/date.rpy:345
translate russian minami_date_play_arcade_intro_male_e5acc333:
    "Этот взгляд пронзает меня так, как умеет только она."

# ch/minami/date.rpy:346
translate russian minami_date_play_arcade_intro_male_2a258373:
    "Даже в погоне за рекордом я по-настоящему замечаю лишь её тело рядом с моим."

# ch/minami/date.rpy:348
translate russian minami_date_play_arcade_intro_male_57f7e234:
    "В нашем обмене взглядами есть искра, которой я всё пытаюсь найти другое объяснение."

# ch/minami/date.rpy:349
translate russian minami_date_play_arcade_intro_male_191198b7:
    "Она моя приёмная сестра, и именно в том моя проблема: я вижу слишком многое в одном взгляде."

# ch/minami/date.rpy:351
translate russian minami_date_play_arcade_intro_male_e802eb6b:
    "От этого взгляда становится теплее, чем должно бы от старого воспоминания."

# ch/minami/date.rpy:352
translate russian minami_date_play_arcade_intro_male_af91de10:
    "Я отмахиваюсь от этого чувства и ищу ещё одну монету."

# ch/minami/date.rpy:354
translate russian minami_date_play_arcade_intro_male_052663a7:
    "Мы обмениваемся тем же заговорщическим взглядом, что и в детстве у игровых автоматов."

# ch/minami/date.rpy:355
translate russian minami_date_play_arcade_intro_male_46ce80f9:
    "Просто мы с младшей сестрёнкой возвращаемся к старым привычкам."

# ch/minami/date.rpy:356
translate russian minami_date_play_arcade_intro_male_3caf2b27:
    "Потом мы бросаемся к автомату."

# ch/minami/date.rpy:357
translate russian minami_date_play_arcade_intro_male_7363b266:
    "Я закидываю монеты в прорезь."

# ch/minami/date.rpy:358
translate russian minami_date_play_arcade_intro_male_3743bfba:
    "А Минами нетерпеливо разминает пальцы."

# ch/minami/date.rpy:362
translate russian minami_date_play_arcade_win_male_856338d2:
    "Едва мы начинаем управлять нашими героинями в коротких юбках, я понимаю, что всё будет отлично."

# ch/minami/date.rpy:363
translate russian minami_date_play_arcade_win_male_ae639e67:
    "Я ходил в этот игровой зал задолго до переезда Минами."

# ch/minami/date.rpy:364
translate russian minami_date_play_arcade_win_male_14d77ad8:
    "И это одна из тех игр, к которым меня так и тянет возвращаться."

# ch/minami/date.rpy:365
translate russian minami_date_play_arcade_win_male_309fcd6b:
    minami.say "Эй, братик!"

# ch/minami/date.rpy:366
translate russian minami_date_play_arcade_win_male_8fab75d5:
    minami.say "Этот бонус был мой!"

# ch/minami/date.rpy:367
translate russian minami_date_play_arcade_win_male_df1fd364:
    mike.say "Не успела, Минами!"

# ch/minami/date.rpy:368
translate russian minami_date_play_arcade_win_male_4385a7d7:
    "Минами старается изо всех сил, но ей за мной не угнаться."

# ch/minami/date.rpy:369
translate russian minami_date_play_arcade_win_male_afca7a0c:
    "Интересно, она вообще играла в эту игру после того, как я уехал из дома?"

# ch/minami/date.rpy:370
translate russian minami_date_play_arcade_win_male_b21f7a76:
    "Вскоре она начинает сопеть и дуться, пока я вырываюсь вперёд."

# ch/minami/date.rpy:371
translate russian minami_date_play_arcade_win_male_576ac1e1:
    minami.say "Что за дела, братик?"

# ch/minami/date.rpy:372
translate russian minami_date_play_arcade_win_male_401b1a88:
    minami.say "Раньше ты так хорошо не играл!"

# ch/minami/date.rpy:373
translate russian minami_date_play_arcade_win_male_54bd5213:
    minami.say "Эй... поддайся хоть немного!"

# ch/minami/date.rpy:374
translate russian minami_date_play_arcade_win_male_f63e2267:
    "Когда заканчиваются попытки и монеты для новых, игра подходит к концу."

# ch/minami/date.rpy:375
translate russian minami_date_play_arcade_win_male_d18cb86d:
    "Я вижу, что Минами уже начинает дуться."

# ch/minami/date.rpy:376
translate russian minami_date_play_arcade_win_male_07f9dae0:
    "Ведь мой счёт куда выше её."

# ch/minami/date.rpy:377
translate russian minami_date_play_arcade_win_male_3bd96ae4:
    mike.say "Ну же, Минами."

# ch/minami/date.rpy:378
translate russian minami_date_play_arcade_win_male_6ca30ab2:
    mike.say "Умей проигрывать, ладно?"

# ch/minami/date.rpy:379
translate russian minami_date_play_arcade_win_male_e091e169:
    "Минами хмурится, а затем показывает мне язык."

# ch/minami/date.rpy:380
translate russian minami_date_play_arcade_win_male_cc8cbe72:
    minami.say "Хмпф..."

# ch/minami/date.rpy:381
translate russian minami_date_play_arcade_win_male_1dedc93d:
    minami.say "А я ведь СОБИРАЛАСЬ показаться тебе в новом костюме Луны Маринер, братик."

# ch/minami/date.rpy:382
translate russian minami_date_play_arcade_win_male_f153995e:
    minami.say "Но теперь не покажусь, раз ты такой вредный противный придурок!"

# ch/minami/date.rpy:383
translate russian minami_date_play_arcade_win_male_e558ff4f:
    mike.say "Подожди... что?!"

# ch/minami/date.rpy:384
translate russian minami_date_play_arcade_win_male_37f57b56:
    mike.say "У тебя есть костюм Луны Маринер?!"

# ch/minami/date.rpy:385
translate russian minami_date_play_arcade_win_male_8b72dd56:
    "Минами улыбается, прекрасно понимая, что я заглотил наживку целиком."

# ch/minami/date.rpy:386
translate russian minami_date_play_arcade_win_male_126c4c32:
    minami.say "Да, братик."

# ch/minami/date.rpy:387
translate russian minami_date_play_arcade_win_male_fb5048e3:
    minami.say "И если ты всё-таки ХОЧЕШЬ увидеть меня в нём..."

# ch/minami/date.rpy:388
translate russian minami_date_play_arcade_win_male_21ee0b8d:
    minami.say "Что ж... в следующий раз тебе лучше дать мне выиграть!"

# ch/minami/date.rpy:390
translate russian minami_date_play_arcade_win_male_53e7b020:
    "Образ Минами в этой короткой юбочке захватывает меня, и мысленно я уже раздеваю её взглядом."

# ch/minami/date.rpy:391
translate russian minami_date_play_arcade_win_male_e446ba58:
    "Она моя приёмная сестра, и я хочу увидеть её тело в этом костюме сильнее, чем готов признать."

# ch/minami/date.rpy:393
translate russian minami_date_play_arcade_win_male_33d5c6a0:
    "Образ Минами в маленькой матроске засел у меня в голове и не желает уходить."

# ch/minami/date.rpy:394
translate russian minami_date_play_arcade_win_male_245f4083:
    "Я уже планирую проиграть следующую партию, лишь бы увидеть её в этом костюме."

# ch/minami/date.rpy:396
translate russian minami_date_play_arcade_win_male_921a24be:
    "Картина, которую она рисует, волнует меня сильнее, чем хочется признавать."

# ch/minami/date.rpy:397
translate russian minami_date_play_arcade_win_male_8ce3dfa5:
    "Она моя приёмная сестра, и мне не следовало бы так жаждать увидеть её в этом наряде."

# ch/minami/date.rpy:399
translate russian minami_date_play_arcade_win_male_0a19b90d:
    "Мысль о костюме вызывает странный прилив тепла."

# ch/minami/date.rpy:400
translate russian minami_date_play_arcade_win_male_d9fa0d6c:
    "Я отшучиваюсь и говорю себе, что она просто вредничает."

# ch/minami/date.rpy:402
translate russian minami_date_play_arcade_win_male_63c2a30e:
    "Она всегда умела выторговать желаемое, пообещав показать свой косплей, — ещё с детства."

# ch/minami/date.rpy:403
translate russian minami_date_play_arcade_win_male_ab5b392e:
    "Она проделывает со мной этот фокус с восьми лет."

# ch/minami/date.rpy:407
translate russian minami_date_play_arcade_lose_male_d6aa251c:
    "Едва мы начинаем управлять нашими героинями в коротких юбках, я понимаю, что дело плохо."

# ch/minami/date.rpy:408
translate russian minami_date_play_arcade_lose_male_598ab08a:
    "Я уже не так часто хожу в игровые залы, как раньше дома."

# ch/minami/date.rpy:409
translate russian minami_date_play_arcade_lose_male_39e07a58:
    "Так что в этой игре я заметно потерял сноровку."

# ch/minami/date.rpy:410
translate russian minami_date_play_arcade_lose_male_0c1852b0:
    mike.say "Эй, Минами!"

# ch/minami/date.rpy:411
translate russian minami_date_play_arcade_lose_male_121e9def:
    mike.say "Этот бонус был мой!"

# ch/minami/date.rpy:412
translate russian minami_date_play_arcade_lose_male_a1f2e077:
    minami.say "Ха-ха... не успел, братик!"

# ch/minami/date.rpy:413
translate russian minami_date_play_arcade_lose_male_66caad5c:
    "Хотя я стараюсь изо всех сил, до Минами мне далеко."

# ch/minami/date.rpy:414
translate russian minami_date_play_arcade_lose_male_77f447ba:
    "Должно быть, после моего отъезда она много тренировалась."

# ch/minami/date.rpy:415
translate russian minami_date_play_arcade_lose_male_ac27567f:
    "Вскоре я уже ругаюсь себе под нос, пока она оставляет меня далеко позади."

# ch/minami/date.rpy:416
translate russian minami_date_play_arcade_lose_male_f7258a83:
    mike.say "Какого чёрта, Минами?"

# ch/minami/date.rpy:417
translate russian minami_date_play_arcade_lose_male_bfdf63a6:
    mike.say "Когда ты научилась так играть?!"

# ch/minami/date.rpy:418
translate russian minami_date_play_arcade_lose_male_7d0ce5d6:
    mike.say "Погоди... пожалей меня!"

# ch/minami/date.rpy:419
translate russian minami_date_play_arcade_lose_male_6df0fbc5:
    minami.say "Не знаю, братик."

# ch/minami/date.rpy:420
translate russian minami_date_play_arcade_lose_male_0560a65c:
    minami.say "Я сейчас ТАК увлеклась Луной Маринер."

# ch/minami/date.rpy:421
translate russian minami_date_play_arcade_lose_male_5bc7b272:
    minami.say "Даже купила новый костюм Луны Маринер..."

# ch/minami/date.rpy:422
translate russian minami_date_play_arcade_lose_male_7da69e61:
    "Смысл её слов доходит до меня как раз в тот момент, когда на экране из-под короткой юбки мелькают трусики."

# ch/minami/date.rpy:423
translate russian minami_date_play_arcade_lose_male_46c256dd:
    "И вдруг я уже не могу думать ни о чём, кроме Минами в таком же наряде!"

# ch/minami/date.rpy:425
translate russian minami_date_play_arcade_lose_male_a0fca19b:
    "Теперь представить её такой легко: мысленно я уже снимаю с неё костюм взглядом."

# ch/minami/date.rpy:426
translate russian minami_date_play_arcade_lose_male_22e95c3f:
    "Моя приёмная сестра в короткой матросской юбочке — и от желания у меня пересыхает во рту."

# ch/minami/date.rpy:428
translate russian minami_date_play_arcade_lose_male_08265fe5:
    "Этот образ захватывает меня и разогревает изнутри."

# ch/minami/date.rpy:429
translate russian minami_date_play_arcade_lose_male_c421b4ad:
    "Я так хочу увидеть её в костюме, что с трудом смотрю на экран."

# ch/minami/date.rpy:431
translate russian minami_date_play_arcade_lose_male_6f6034b7:
    "Картина возникает раньше, чем я успеваю её прогнать, и действует слишком сильно."

# ch/minami/date.rpy:432
translate russian minami_date_play_arcade_lose_male_ba9a0a23:
    "Она моя приёмная сестра, и именно этого мне делать нельзя — представлять её такой."

# ch/minami/date.rpy:434
translate russian minami_date_play_arcade_lose_male_b2bc1abf:
    "Эта мысль вызывает больше тепла, чем я намеревался себе позволить."

# ch/minami/date.rpy:435
translate russian minami_date_play_arcade_lose_male_8ae1c87e:
    "Я моргаю, прогоняя её, и пытаюсь сосредоточиться на игре."

# ch/minami/date.rpy:437
translate russian minami_date_play_arcade_lose_male_7a82a716:
    "Я вспоминаю все костюмы, в которых она с гордостью щеголяла в нашем детстве."

# ch/minami/date.rpy:438
translate russian minami_date_play_arcade_lose_male_3663476a:
    "Моя младшая сестрёнка и её бесконечный косплей. Я уже сбился со счёта её костюмов."

# ch/minami/date.rpy:439
translate russian minami_date_play_arcade_lose_male_e558ff4f:
    mike.say "Подожди... что?!"

# ch/minami/date.rpy:440
translate russian minami_date_play_arcade_lose_male_37f57b56:
    mike.say "У тебя есть костюм Луны Маринер?!"

# ch/minami/date.rpy:441
translate russian minami_date_play_arcade_lose_male_8b72dd56:
    "Минами улыбается, прекрасно понимая, что я заглотил наживку целиком."

# ch/minami/date.rpy:442
translate russian minami_date_play_arcade_lose_male_126c4c32:
    minami.say "Да, братик."

# ch/minami/date.rpy:443
translate russian minami_date_play_arcade_lose_male_fb5048e3:
    minami.say "И если ты всё-таки ХОЧЕШЬ увидеть меня в нём..."

# ch/minami/date.rpy:444
translate russian minami_date_play_arcade_lose_male_e07f14c4:
    minami.say "Тогда тебе лучше быть со мной очень милым!"

# ch/minami/date.rpy:445
translate russian minami_date_play_arcade_lose_male_f63e2267:
    "Когда заканчиваются попытки и монеты для новых, игра подходит к концу."

# ch/minami/date.rpy:446
