# ch/minami/events.rpy:2152
translate russian minami_meet_alexis_3890c918:
    minami.say "ОГРОМНОЕ спасибо, что привёл меня сюда, братик!"

# ch/minami/events.rpy:2153
translate russian minami_meet_alexis_2ad3c2d0:
    minami.say "Такое весёлое свидание!"

# ch/minami/events.rpy:2155
translate russian minami_meet_alexis_ee6e5891:
    "Что... постойте!"

# ch/minami/events.rpy:2156
translate russian minami_meet_alexis_cbbb4ddc:
    "Она только что назвала нашу прогулку свиданием?"

# ch/minami/events.rpy:2157
translate russian minami_meet_alexis_37bd79a7:
    mike.say "Эм, Минами..."

# ch/minami/events.rpy:2158
translate russian minami_meet_alexis_7f154077:
    mike.say "Я не знаю, как именно назвать то, что мы сейчас делаем."

# ch/minami/events.rpy:2159
translate russian minami_meet_alexis_18215003:
    mike.say "Но это точно не свидание!"

# ch/minami/events.rpy:2160
translate russian minami_meet_alexis_69ae7477:
    "Минами улыбается и закатывает глаза, забавляясь моей реакцией."

# ch/minami/events.rpy:2162
translate russian minami_meet_alexis_8de9564c:
    minami.say "Ой, расслабься, братик!"

# ch/minami/events.rpy:2163
translate russian minami_meet_alexis_0947dafe:
    minami.say "Здесь никто не знает, что я твоя сестра."

# ch/minami/events.rpy:2164
translate russian minami_meet_alexis_ae6971b7:
    minami.say "Со стороны это просто красивая девушка и симпатичный парень, которые весело проводят время вместе."

# ch/minami/events.rpy:2165
translate russian minami_meet_alexis_6b8bccb2:
    minami.say "И как ещё это назвать, если не свиданием?"

# ch/minami/events.rpy:2166
translate russian minami_meet_alexis_3fa2df9d:
    "Должен признать, в её словах есть смысл!"

# ch/minami/events.rpy:2168
translate russian minami_meet_alexis_eaf1db41:
    alexis.say "Как минимум один человек здесь знает, что ты его сестра, Минами!"

# ch/minami/events.rpy:2169
translate russian minami_meet_alexis_e5589a6f:
    "Я оборачиваюсь на голос, искренне удивлённый его услышать."

# ch/minami/events.rpy:2171
translate russian minami_meet_alexis_5e352c42:
    "А Минами чуть ли не подскакивает, вскрикнув от неожиданности."

# ch/minami/events.rpy:2172
translate russian minami_meet_alexis_cb61b60f:
    "Будто её застали за какой-то шалостью и теперь она боится наказания."

# ch/minami/events.rpy:2176
translate russian minami_meet_alexis_23a3a5a7:
    "Я знаю, что не стоит, но смеюсь, как только вижу, что загадочный голос принадлежит Алексис."

# ch/minami/events.rpy:2177
translate russian minami_meet_alexis_8389aa02:
    mike.say "Привет, Алексис."

# ch/minami/events.rpy:2178
translate russian minami_meet_alexis_a9d09bab:
    alexis.say "Привет, [lssb_minami.hero_name()]."

# ch/minami/events.rpy:2179
translate russian minami_meet_alexis_39d978a1:
    alexis.say "Привет, Минами! Давно не виделись, да?"

# ch/minami/events.rpy:2180
translate russian minami_meet_alexis_f67bc67c:
    "Похоже, Минами быстро оправляется от первого потрясения."

# ch/minami/events.rpy:2182
translate russian minami_meet_alexis_5a7a825c:
    "Она скрещивает руки на груди и хмуро смотрит на Алексис."

# ch/minami/events.rpy:2183
translate russian minami_meet_alexis_53d44ac2:
    minami.say "По мне, так недостаточно давно!"

# ch/minami/events.rpy:2184
translate russian minami_meet_alexis_15eb6fcd:
    minami.say "Не понимаю, как у тебя хватает совести разговаривать с моим бедным братиком."

# ch/minami/events.rpy:2185
translate russian minami_meet_alexis_226f62cf:
    minami.say "После того, как ты с ним поступила!"

# ch/minami/events.rpy:2186
translate russian minami_meet_alexis_3bd96ae4:
    mike.say "Ну же, Минами."

# ch/minami/events.rpy:2187
translate russian minami_meet_alexis_1cb327f6:
    mike.say "Это было много лет назад."

# ch/minami/events.rpy:2188
translate russian minami_meet_alexis_edec208f:
    mike.say "Мы с Алексис тогда сами были детьми."

# ch/minami/events.rpy:2190
translate russian minami_meet_alexis_86cad8d0:
    alexis.say "Да, и кое-кто с тех пор повзрослел!"

# ch/minami/events.rpy:2191
translate russian minami_meet_alexis_19ba3840:
    "От тона Алексис Минами ощетинивается."

# ch/minami/events.rpy:2193
translate russian minami_meet_alexis_dfc4b508:
    minami.say "И что это должно значить?!"

# ch/minami/events.rpy:2194
translate russian minami_meet_alexis_61aac383:
    minami.say "Ты мерзкая, неверная су..."

# ch/minami/events.rpy:2195
translate russian minami_meet_alexis_1819e224:
    "Я поспешно закрываю Минами рот ладонью, не давая договорить оскорбление."

# ch/minami/events.rpy:2196
translate russian minami_meet_alexis_0cb17130:
    "Её глаза вспыхивают гневом, она пытается вырваться, чтобы продолжить ссору."

# ch/minami/events.rpy:2197
translate russian minami_meet_alexis_d9c05ad1:
    mike.say "Нам уже пора, Алексис."

# ch/minami/events.rpy:2198
translate russian minami_meet_alexis_d4f56ccd:
    mike.say "Но было здорово встретиться."

# ch/minami/events.rpy:2199
translate russian minami_meet_alexis_5d90632c:
    mike.say "Правда, Минами?"

# ch/minami/events.rpy:2200
translate russian minami_meet_alexis_f92bdc9c:
    minami.say "М-м-мф..."

# ch/minami/events.rpy:2201
translate russian minami_meet_alexis_067491db:
    minami.say "Хрёнофа шука..."

# ch/minami/events.rpy:2202
translate russian minami_meet_alexis_187044cc:
    "Продолжая нервно улыбаться Алексис, я как можно быстрее утаскиваю Минами."

# ch/minami/events.rpy:2206
translate russian minami_meet_alexis_472c4b59:
    "Она довольно лёгкая, так что это не составляет особого труда."

# ch/minami/events.rpy:2207
translate russian minami_meet_alexis_b2c53786:
    "На самом деле меня тревожит момент, когда придётся убрать ладонь с её рта и отпустить..."

# ch/minami/events.rpy:2215
translate russian minami_meet_jack_748ba5d0:
    "Большую часть дня я показывал Минами свой район, чтобы она могла здесь ориентироваться."

# ch/minami/events.rpy:2216
translate russian minami_meet_jack_dadc4cde:
    "По сути, объяснял, где находятся магазины и прочие нужные места относительно дома."

# ch/minami/events.rpy:2217
translate russian minami_meet_jack_a4c3cb53:
    "Это необходимо, если я хочу, чтобы она стала самостоятельной и не полагалась на меня во всём."

# ch/minami/events.rpy:2218
translate russian minami_meet_jack_487b5bd2:
    "Но таскаться от одного места к другому утомительно, и вскоре мы оба ужасно скучаем."

# ch/minami/events.rpy:2219
translate russian minami_meet_jack_e886ec22:
    "Тут я вспоминаю, что среди важных местных заведений есть кое-что поприятнее."

# ch/minami/events.rpy:2220
translate russian minami_meet_jack_e0ff5bb4:
    mike.say "А следующим... следующим пунктом нашей программы будет..."

# ch/minami/events.rpy:2222
translate russian minami_meet_jack_41ef0227:
    minami.say "Угх..."

# ch/minami/events.rpy:2223
translate russian minami_meet_jack_67e7fe61:
    minami.say "Надеюсь, это что-то хорошее, братик!"

# ch/minami/events.rpy:2224
translate russian minami_meet_jack_42ff6463:
    mike.say "«Винчестер Армс», в просторечии — просто «Винчестер»!"

# ch/minami/events.rpy:2225
translate russian minami_meet_jack_895d0cf7:
    "Я широким жестом указываю на фасад паба."

# ch/minami/events.rpy:2227
translate russian minami_meet_jack_b4e81fb6:
    "При виде чего-то повеселее прачечной или продуктового магазина настроение Минами тут же улучшается."

# ch/minami/events.rpy:2228
translate russian minami_meet_jack_844b93f2:
    "Она радостно хлопает в ладоши и дарит мне одну из своих самых милых улыбок."

# ch/minami/events.rpy:2230
translate russian minami_meet_jack_483940bb:
    minami.say "О-о-о..."

# ch/minami/events.rpy:2231
translate russian minami_meet_jack_3c9ac30f:
    minami.say "Так вот где ты проводишь время, братик?"

# ch/minami/events.rpy:2232
translate russian minami_meet_jack_b6eeff8c:
    minami.say "И меня теперь тоже возьмёшь!"

# ch/minami/events.rpy:2234
translate russian minami_meet_jack_a1e36a50:
    "Я придерживаю для Минами дверь, качая головой в ответ на её восторг."

# ch/minami/events.rpy:2235
translate russian minami_meet_jack_c5041239:
    mike.say "Это просто местный паб, Минами."

# ch/minami/events.rpy:2236
translate russian minami_meet_jack_e25c205b:
    mike.say "Я не открываю тебе доступ в какой-то тайный клуб!"

# ch/minami/events.rpy:2238
translate russian minami_meet_jack_f1785d84:
    minami.say "Ох, братик!"

# ch/minami/events.rpy:2239
translate russian minami_meet_jack_a280252b:
    minami.say "Ты не знаешь, как долго я ждала, когда смогу делать что-нибудь такое."

# ch/minami/events.rpy:2240
translate russian minami_meet_jack_0280fbd3:
    minami.say "После твоего отъезда из дома я всё время тебе завидовала."

# ch/minami/events.rpy:2241
translate russian minami_meet_jack_e48b599b:
    minami.say "Хотела быть там же, где ты, и делать то же, что и ты..."

# ch/minami/events.rpy:2242
translate russian minami_meet_jack_105b4305:
    mike.say "Эм... да."

# ch/minami/events.rpy:2243
translate russian minami_meet_jack_004c3600:
    mike.say "Ладно, Минами... как скажешь!"

# ch/minami/events.rpy:2245
translate russian minami_meet_jack_becee8bc:
    "Я пропускаю Минами в паб и вместе с ней направляюсь к стойке."

# ch/minami/events.rpy:2246
translate russian minami_meet_jack_2d2d76d3:
    "Она показывает бармену удостоверение, мы берём по напитку и ищем место, где сесть."

# ch/minami/events.rpy:2247
translate russian minami_meet_jack_f0d9c88b:
    jack.say "Эй, [lssb_minami.hero_name()], сюда!"

# ch/minami/events.rpy:2250
translate russian minami_meet_jack_2ffdd84e:
    minami.say "О... мой... бог!"

# ch/minami/events.rpy:2251
translate russian minami_meet_jack_89bbd9c1:
    minami.say "Я его знаю! Это Джек!"

# ch/minami/events.rpy:2256
translate russian minami_meet_jack_dfa7dc06:
    "Не успеваю я сказать ни слова, как Минами уже подскакивает к столику Джека."

# ch/minami/events.rpy:2257
translate russian minami_meet_jack_3cb871f5:
    minami.say "Привет, Джек!"

# ch/minami/events.rpy:2258
translate russian minami_meet_jack_ee85df2c:
    minami.say "Это я, Минами!"

# ch/minami/events.rpy:2259
translate russian minami_meet_jack_7de779a1:
    minami.say "Ты же меня помнишь?"

# ch/minami/events.rpy:2260
translate russian minami_meet_jack_4cc6d6f7:
    "Я подхожу на пару секунд позже и успеваю увидеть ошеломлённое лицо Джека."

# ch/minami/events.rpy:2261
translate russian minami_meet_jack_44602c03:
    "Должно быть, вид такой задорной девушки, как Минами, скачущей к нему через полный паб, производит впечатление!"

# ch/minami/events.rpy:2262
translate russian minami_meet_jack_ed911f50:
    "Из вежливости я машу другу, но сомневаюсь, что он вообще замечает моё присутствие."

# ch/minami/events.rpy:2263
translate russian minami_meet_jack_7c2664a6:
    jack.say "Т... ты не можешь быть Минами."

# ch/minami/events.rpy:2264
translate russian minami_meet_jack_08681e11:
    jack.say "Минами — маленькая девочка."

# ch/minami/events.rpy:2265
translate russian minami_meet_jack_e8d8f89a:
    jack.say "А ты... ты..."

# ch/minami/events.rpy:2267
translate russian minami_meet_jack_b1102896:
    "Минами упирает сжатые кулаки в бока и кривит губы."

# ch/minami/events.rpy:2268
translate russian minami_meet_jack_a83a3808:
    minami.say "Я что, позволь спросить?!"

# ch/minami/events.rpy:2270
translate russian minami_meet_jack_8227527d:
    jack.say "Ты потрясающая красотка, вот кто!"

# ch/minami/events.rpy:2272
translate russian minami_meet_jack_4a48a582:
    "Едва услышав комплимент, Минами мгновенно забывает о раздражении и злости."

# ch/minami/events.rpy:2273
translate russian minami_meet_jack_6dc1e888:
    "Вместо сжатых кулаков — сложенные под подбородком ладони, а новому поклоннику достаётся сияющая улыбка."

# ch/minami/events.rpy:2274
translate russian minami_meet_jack_58f03389:
    minami.say "О, Джек."

# ch/minami/events.rpy:2275
translate russian minami_meet_jack_b8409136:
    minami.say "Ты правда так думаешь?"

# ch/minami/events.rpy:2276
translate russian minami_meet_jack_120668cd:
    "Джек начинает кивать и, похоже, собирается добавить что-то ещё."

# ch/minami/events.rpy:2277
translate russian minami_meet_jack_18a3f227:
    "Но я пользуюсь случаем и вмешиваюсь прежде, чем он успевает заговорить."

# ch/minami/events.rpy:2278
translate russian minami_meet_jack_0ce8fa5f:
    mike.say "Хватит льстить, Джек."

# ch/minami/events.rpy:2279
translate russian minami_meet_jack_03647dec:
    mike.say "У моей МЛАДШЕЙ СЕСТРЫ и так самомнение выше крыши!"

# ch/minami/events.rpy:2280
translate russian minami_meet_jack_b77a289e:
    "Похоже, подчёркнутое напоминание о нашем с Минами родстве срабатывает."

# ch/minami/events.rpy:2282
translate russian minami_meet_jack_efcc1ba3:
    "Джек выходит из транса и впервые поворачивается ко мне."

# ch/minami/events.rpy:2283
translate russian minami_meet_jack_3a41ed87:
    jack.say "А, привет, [lssb_minami.hero_name()]."

# ch/minami/events.rpy:2284
translate russian minami_meet_jack_1de3b91f:
    jack.say "Не заметил, как ты подошёл!"

# ch/minami/events.rpy:2285
translate russian minami_meet_jack_96435ede:
    "Ну конечно, он же был занят тем, что пускал слюни на мою сестру!"

# ch/minami/events.rpy:2286
translate russian minami_meet_jack_29d9f900:
    mike.say "Думаю, ты был занят другими мыслями, да?"

# ch/minami/events.rpy:2287
translate russian minami_meet_jack_94fb2618:
    jack.say "А... ну да... наверное..."

# ch/minami/events.rpy:2288
translate russian minami_meet_jack_4424b063:
    minami.say "Мне нужно в дамскую комнату."

# ch/minami/events.rpy:2289
translate russian minami_meet_jack_3845afaf:
    minami.say "Никуда не уходите, я скоро вернусь!"

# ch/minami/events.rpy:2290
translate russian minami_meet_jack_ea633e69:
    jack.say "Уж я-то точно не уйду!"

# ch/minami/events.rpy:2294
translate russian minami_meet_jack_4eff1f09:
    "Как только Минами отходит достаточно далеко, я сердито смотрю на Джека."

# ch/minami/events.rpy:2295
translate russian minami_meet_jack_0b2cd2dd:
    mike.say "Джек, можешь хоть на секунду перестать её пожирать глазами?"

# ch/minami/events.rpy:2296
translate russian minami_meet_jack_7f84b9b8:
    mike.say "Это моя младшая сестра, ради бога!"

# ch/minami/events.rpy:2297
translate russian minami_meet_jack_20502c3c:
    "В ответ на мою вспышку Джек пожимает плечами и разводит руками, словно ничего не может поделать."

# ch/minami/events.rpy:2298
translate russian minami_meet_jack_aa3d3bf3:
    jack.say "В прошлую нашу встречу она БЫЛА твоей младшей сестрёнкой."

# ch/minami/events.rpy:2299
translate russian minami_meet_jack_c29d7059:
    jack.say "А сейчас я вижу только горячую красотку!"

# ch/minami/events.rpy:2300
translate russian minami_meet_jack_cec5f53c:
    jack.say "Не понимаю, как ты рядом с ней себя сдерживаешь. Я бы не смог!"

# ch/minami/events.rpy:2301
translate russian minami_meet_jack_59259a63:
    mike.say "Я же сказал, она моя СЕСТРА!"

# ch/minami/events.rpy:2302
translate russian minami_meet_jack_7dd97e03:
    jack.say "Приёмная сестра, чувак."

# ch/minami/events.rpy:2303
translate russian minami_meet_jack_5d6e168f:
    jack.say "Это ведь что-то меняет, правда?"

# ch/minami/events.rpy:2304
translate russian minami_meet_jack_24f2baac:
    mike.say "Для меня что-то изменится, только если мы закроем эту тему. Прямо сейчас!"

# ch/minami/events.rpy:2305
translate russian minami_meet_jack_40941b0e:
    jack.say "Ладно, ладно."

# ch/minami/events.rpy:2306
translate russian minami_meet_jack_8615e5d3:
    jack.say "Но сегодня ночью перед сном я всё равно буду думать о ней!"

# ch/minami/events.rpy:2307
translate russian minami_meet_jack_ffca7bd3:
    "Я изо всех сил пытаюсь не представлять себе эту картину, но уже поздно."

# ch/minami/events.rpy:2308
translate russian minami_meet_jack_669940bb:
    "Это надолго останется в памяти и обойдётся в целое состояние на психотерапию..."

# ch/minami/events.rpy:2314
translate russian minami_meet_kylie_cbb94742:
    "Я вполне мог бы оставить Минами самостоятельно разбираться в кампусе колледжа, не особо мучаясь совестью."

# ch/minami/events.rpy:2315
translate russian minami_meet_kylie_032bea97:
    "В конце концов, он не такой уж большой, а если у неё хватает ума здесь учиться, то и с этим она справится."

# ch/minami/events.rpy:2316
translate russian minami_meet_kylie_93716e5e:
    "Но мне так нравится роль старшего брата, что я решаю сам провести экскурсию."

# ch/minami/events.rpy:2318
translate russian minami_meet_kylie_099402a7:
    "И, честно говоря, ужасно льстит, когда Минами ходит за мной, словно преданный щенок."

# ch/minami/events.rpy:2319
translate russian minami_meet_kylie_523dc168:
    "Вдруг все мои обыденные знания об этом месте превращаются в увлекательные крупицы мудрости."

# ch/minami/events.rpy:2320
translate russian minami_meet_kylie_dbee5e9c:
    "Я щедро вставляю их в разговор по пути, а Минами держит меня под руку и всё время кивает."

# ch/minami/events.rpy:2321
translate russian minami_meet_kylie_edd9d938:
    "Сначала я стараюсь быть полезным: показываю аудитории, где у неё будут лекции, и всё в этом духе."

# ch/minami/events.rpy:2322
translate russian minami_meet_kylie_5ee9e889:
    "Но вскоре всё сводится к маленьким хитростям и советам, которые накопились за мою собственную учёбу здесь."

# ch/minami/events.rpy:2323
translate russian minami_meet_kylie_5904bf8e:
    "Например, как срезать путь между аудиториями и где можно поспать, чтобы никто не заметил."

# ch/minami/events.rpy:2324
translate russian minami_meet_kylie_3cf9c69d:
    "Каждый новый совет, кажется, всё сильнее впечатляет Минами, упивающуюся моей якобы мудростью."

# ch/minami/events.rpy:2325
translate russian minami_meet_kylie_15018380:
    minami.say "Ох, братик."

# ch/minami/events.rpy:2326
translate russian minami_meet_kylie_170760d0:
    minami.say "Не знаю, что бы я без тебя делала!"

# ch/minami/events.rpy:2327
translate russian minami_meet_kylie_505f3544:
    mike.say "А?"

# ch/minami/events.rpy:2328
translate russian minami_meet_kylie_451e1a66:
    mike.say "Ты о чём, Минами?"

# ch/minami/events.rpy:2329
translate russian minami_meet_kylie_d78f6c77:
    minami.say "О том, что совсем бы потерялась, если бы бродила здесь одна."

# ch/minami/events.rpy:2331
translate russian minami_meet_kylie_d72df3b6:
    minami.say "А с тобой мне кажется, будто я уже всё тут знаю!"

# ch/minami/events.rpy:2332
translate russian minami_meet_kylie_cdeb230c:
    "Я смотрю вниз и вижу её сияющую улыбку и широко раскрытые невинные глаза, устремлённые на меня."

# ch/minami/events.rpy:2333
translate russian minami_meet_kylie_b6ee54b4:
    "Минами словно ловит каждое моё слово, и этого хватает, чтобы я покраснел."

# ch/minami/events.rpy:2334
translate russian minami_meet_kylie_13639c72:
    mike.say "Да ну, не глупи, Минами!"

# ch/minami/events.rpy:2336
translate russian minami_meet_kylie_790ddbf2:
    minami.say "Я серьёзно, братик."

# ch/minami/events.rpy:2337
translate russian minami_meet_kylie_d42cbeaa:
    minami.say "Если бы не ты, мне было бы так страшно и одиноко..."

# ch/minami/events.rpy:2338
translate russian minami_meet_kylie_bb072fec:
    kylie.say "Минами?!"

# ch/minami/events.rpy:2339
translate russian minami_meet_kylie_8d1ced63:
    kylie.say "Это правда ты?!"

# ch/minami/events.rpy:2340
translate russian minami_meet_kylie_d419b100:
    "На мгновение мне показалось, что между нами с Минами вот-вот что-то изменится."

# ch/minami/events.rpy:2341
translate russian minami_meet_kylie_dd72e9c0:
    "Будто она на грани признания в чём-то, что долго прятала глубоко внутри."

# ch/minami/events.rpy:2342
translate russian minami_meet_kylie_ba7eb8bf:
    "Но тут вмешивается кто-то другой, и ощущение мгновенно исчезает."

# ch/minami/events.rpy:2343
translate russian minami_meet_kylie_0b74b9f1:
    "Мы одновременно оборачиваемся на голос."

# ch/minami/events.rpy:2344
translate russian minami_meet_kylie_48a8f62a:
    "Клянусь, ещё секунду назад там никого не было — даже прохожего, который мог бы нас заметить."

# ch/minami/events.rpy:2348
translate russian minami_meet_kylie_ddcad84a:
    "И всё же там стоит Кайли, широко раскрыв глаза почти как Минами, и пристально смотрит на нас."

# ch/minami/events.rpy:2349
translate russian minami_meet_kylie_71a1975c:
    minami.say "Привет, Кайли!"

# ch/minami/events.rpy:2350
translate russian minami_meet_kylie_e0695900:
    minami.say "Только не говори, что ты тоже здесь учишься!"

# ch/minami/events.rpy:2352
translate russian minami_meet_kylie_74592a49:
    "Когда Минами обращается к ней, я, кажется, замечаю едва уловимую перемену в поведении Кайли."

# ch/minami/events.rpy:2353
translate russian minami_meet_kylie_0288702b:
    "Сначала при виде моей младшей сестры она казалась удивлённой, даже потрясённой."

# ch/minami/events.rpy:2355
translate russian minami_meet_kylie_f7e906f8:
    "Но теперь её лицо озаряется улыбкой, и она заметно теплеет."

# ch/minami/events.rpy:2356
translate russian minami_meet_kylie_92a94761:
    kylie.say "Эм, да. Разве [lssb_minami.hero_name()] тебе не говорил?"

# ch/minami/events.rpy:2358
translate russian minami_meet_kylie_a21eb5f5:
    minami.say "Нет, не говорил!"

# ch/minami/events.rpy:2360
translate russian minami_meet_kylie_ecff711a:
    "Когда Кайли подходит, Минами поворачивается ко мне и шутливо грозит пальцем."

# ch/minami/events.rpy:2361
translate russian minami_meet_kylie_ab98b45f:
    minami.say "Плохой братик, очень-очень плохой!"

# ch/minami/events.rpy:2362
translate russian minami_meet_kylie_be4dbb6f:
    minami.say "Ты должен был сказать, что моя лучшая подруга тоже здесь учится!"

# ch/minami/events.rpy:2363
translate russian minami_meet_kylie_e309b735:
    "Ну конечно, Кайли почти ровесница Минами, разница всего в пару месяцев."

# ch/minami/events.rpy:2364
translate russian minami_meet_kylie_c1733b6d:
    "Когда-то я наверняка знал, что в старших классах они дружили."

# ch/minami/events.rpy:2365
translate russian minami_meet_kylie_71966c3b:
    "Но, видимо, тогда мне хватало собственных драм."

# ch/minami/events.rpy:2366
translate russian minami_meet_kylie_cdc27a79:
    "Так что неудивительно, что со временем подробности стёрлись и забылись."

# ch/minami/events.rpy:2368
translate russian minami_meet_kylie_7849919a:
    mike.say "Ладно, ладно, виноват."

# ch/minami/events.rpy:2369
translate russian minami_meet_kylie_3247fd1c:
    mike.say "Наверное, я так замотался, что это вылетело из головы."

# ch/minami/events.rpy:2371
translate russian minami_meet_kylie_029684a7:
    "Кайли медленно кивает, но я вижу, что она по-прежнему смотрит на меня с заметным подозрением."

# ch/minami/events.rpy:2372
translate russian minami_meet_kylie_a4e050de:
    minami.say "А, да какая теперь разница."

# ch/minami/events.rpy:2373
translate russian minami_meet_kylie_75c3aaec:
    minami.say "Главное, что сейчас мы все здесь."

# ch/minami/events.rpy:2374
translate russian minami_meet_kylie_17295191:
    minami.say "Моя самая лучшая школьная подруга."

# ch/minami/events.rpy:2375
translate russian minami_meet_kylie_3688cabd:
    minami.say "И братик, которого я ЛЮБЛЮ!"

# ch/minami/events.rpy:2377
translate russian minami_meet_kylie_f30a75c7:
    "Вдруг взгляд Кайли впивается в Минами, словно лазерный прицел."

# ch/minami/events.rpy:2378
translate russian minami_meet_kylie_ccac6df5:
    kylie.say "Что ты сказала?"

# ch/minami/events.rpy:2380
translate russian minami_meet_kylie_4e030a32:
    minami.say "Что я люблю своего братика БОЛЬШЕ ВСЕГО на свете!"

# ch/minami/events.rpy:2382
translate russian minami_meet_kylie_e23a219e:
    "Словно желая подчеркнуть свои слова, Минами обнимает меня изо всех сил."

# ch/minami/events.rpy:2383
translate russian minami_meet_kylie_56a0cb79:
    "Она утыкается лицом мне в грудь и издаёт довольный звук, напоминающий кошачье мурлыканье."

# ch/minami/events.rpy:2385
translate russian minami_meet_kylie_192bfac0:
    "Я вижу, как глаза Кайли сужаются, и её взгляд на Минами почти пугает."

# ch/minami/events.rpy:2387
translate russian minami_meet_kylie_3b9a6090:
    "Но хищный блеск исчезает так же быстро, как появился."

# ch/minami/events.rpy:2388
translate russian minami_meet_kylie_a7a2aede:
    kylie.say "Конечно, Минами."

# ch/minami/events.rpy:2389
translate russian minami_meet_kylie_a87e45b2:
    kylie.say "Он ведь твой «братик»!"

# ch/minami/events.rpy:2391
translate russian minami_meet_kylie_e8265f2b:
    "Минами улыбается в ответ, словно совсем не заметила бури, только что пронёсшейся по лицу Кайли."

# ch/minami/events.rpy:2392
translate russian minami_meet_kylie_745fc7c6:
    minami.say "Ещё бы!"

# ch/minami/events.rpy:2393
translate russian minami_meet_kylie_0979e5d5:
    minami.say "Ох, как же будет весело, раз вы оба здесь!"

# ch/minami/events.rpy:2395
translate russian minami_meet_kylie_ceaca2c5:
    "Кайли медленно кивает, не переставая улыбаться."

# ch/minami/events.rpy:2396
translate russian minami_meet_kylie_417000c2:
    kylie.say "О да, Минами."

# ch/minami/events.rpy:2397
translate russian minami_meet_kylie_36d7c420:
    kylie.say "Так весело, что закричишь..."

# ch/minami/events.rpy:2398
translate russian minami_meet_kylie_5628a952:
    mike.say "Ну, нам уже пора идти."

# ch/minami/events.rpy:2399
translate russian minami_meet_kylie_b19d0035:
    mike.say "Экскурсия сама себя не закончит!"

# ch/minami/events.rpy:2403
translate russian minami_meet_kylie_6afb0012:
    "Я как можно быстрее увожу Минами, пока та всё время машет Кайли."

# ch/minami/events.rpy:2404
translate russian minami_meet_kylie_58e6a413:
    "Но как ни стараюсь, не могу забыть взгляд Кайли, устремлённый на мою младшую сестру."

# ch/minami/events.rpy:2412
translate russian minami_meet_morgan_41f25c63:
    "Теперь, когда Минами живёт со мной, с некоторыми людьми, как мне казалось, познакомить её будет непросто."

# ch/minami/events.rpy:2413
translate russian minami_meet_morgan_16b1d7ad:
    "Среди моих знакомых есть чудаковатые и даже колючие люди, особенно если застать их не вовремя или сказать что-то не то."

# ch/minami/events.rpy:2414
translate russian minami_meet_morgan_6ff50864:
    "А Минами росла в довольно тепличных условиях и потому порой бывает бестактной."

# ch/minami/events.rpy:2415
translate russian minami_meet_morgan_e4586041:
    "Я ломал голову над тем, с кем было бы проще начать, чтобы встреча хотя бы не грозила катастрофой."

# ch/minami/events.rpy:2416
translate russian minami_meet_morgan_f294b0a4:
    "И тут вспомнил, что Минами знала большинство моих друзей ещё в мои школьные годы."

# ch/minami/events.rpy:2417
translate russian minami_meet_morgan_5cececbf:
    "Значит, с несколькими людьми у неё уже должен быть общий язык, верно?"

# ch/minami/events.rpy:2418
translate russian minami_meet_morgan_8a1c98e8:
    "Поэтому, когда по пути за кофе навынос мы столкнулись с Морган, я не слишком волновался."

# ch/minami/events.rpy:2422
translate russian minami_meet_morgan_c7668128:
    morgan.say "[lssb_minami.hero_name()], привет!"

# ch/minami/events.rpy:2423
translate russian minami_meet_morgan_d983bfa7:
    mike.say "Морган, рад тебя видеть."

# ch/minami/events.rpy:2424
translate russian minami_meet_morgan_5e47587c:
    "Я открываю рот, чтобы продолжить."

# ch/minami/events.rpy:2425
translate russian minami_meet_morgan_db88453b:
    "Но покашливание сбоку заставляет замолчать."

# ch/minami/events.rpy:2427
translate russian minami_meet_morgan_e572bece:
    minami.say "Эм, привет?"

# ch/minami/events.rpy:2428
translate russian minami_meet_morgan_5eaa21d8:
    minami.say "А как же я?"

# ch/minami/events.rpy:2429
translate russian minami_meet_morgan_bd9d1629:
    minami.say "Я вообще-то ПРЯМО здесь стою!"

# ch/minami/events.rpy:2431
translate russian minami_meet_morgan_5f583109:
    "Морган смотрит на Минами, потом снова на меня."

# ch/minami/events.rpy:2432
translate russian minami_meet_morgan_8d6267e2:
    "На её лице ироничная улыбка, будто мы делимся шуткой для своих."

# ch/minami/events.rpy:2433
translate russian minami_meet_morgan_c701ff09:
    "Шуткой, о существовании которой Минами даже не подозревает."

# ch/minami/events.rpy:2434
translate russian minami_meet_morgan_ae8f6fe4:
    morgan.say "Да-да, ты, несомненно, ЗДЕСЬ!"

# ch/minami/events.rpy:2435
translate russian minami_meet_morgan_4c07377c:
    mike.say "А... Морган, ты ведь помнишь Минами?"

# ch/minami/events.rpy:2436
translate russian minami_meet_morgan_400dcec3:
    mike.say "Мою младшую сестру?"

# ch/minami/events.rpy:2438
translate russian minami_meet_morgan_3c9136df:
    "На лице Морган появляется узнавание, и через мгновение она кивает."

# ch/minami/events.rpy:2440
translate russian minami_meet_morgan_03017e7e:
    morgan.say "А, да, я тебя ПОМНЮ."

# ch/minami/events.rpy:2442
translate russian minami_meet_morgan_b9b42ba7:
    morgan.say "Ты всё время ходила следом, куда бы [lssb_minami.hero_name()] ни направлялся."

# ch/minami/events.rpy:2443
translate russian minami_meet_morgan_b7ea29b0:
    morgan.say "Похоже, кое-что никогда не меняется!"

# ch/minami/events.rpy:2445
translate russian minami_meet_morgan_d182e4fd:
    "Минами окидывает Морган надменным взглядом."

# ch/minami/events.rpy:2446
translate russian minami_meet_morgan_23de8da1:
    "Но если замечание Морган было вызовом, она на него не поддаётся."

# ch/minami/events.rpy:2447
translate russian minami_meet_morgan_063300eb:
    "Вместо этого прибегает к проверенной тактике пассивной агрессии."

# ch/minami/events.rpy:2449
translate russian minami_meet_morgan_b23341e3:
    minami.say "Ну, похоже, КОЕ-ЧТО всё-таки меняется."

# ch/minami/events.rpy:2451
translate russian minami_meet_morgan_7b8aaf8b:
    "Морган хмурится и скрещивает руки на груди, словно защищаясь."

# ch/minami/events.rpy:2452
translate russian minami_meet_morgan_69a40d3c:
    morgan.say "И что это должно значить?"

# ch/minami/events.rpy:2453
translate russian minami_meet_morgan_f7cdf418:
    minami.say "Ну, в прошлую встречу я была уверена, что ты парень!"

# ch/minami/events.rpy:2455
translate russian minami_meet_morgan_bf4d5226:
    "Едва Минами произносит эти слова, мои глаза расширяются, и я тут же вмешиваюсь."

# ch/minami/events.rpy:2456
translate russian minami_meet_morgan_bf16e30a:
    mike.say "Эй, погоди, Минами."

# ch/minami/events.rpy:2457
translate russian minami_meet_morgan_de081ba0:
    mike.say "Ты с ума сошла?"

# ch/minami/events.rpy:2458
translate russian minami_meet_morgan_d9b2f773:
    mike.say "Это только я считал Морган парнем — и был совершенно неправ!"

# ch/minami/events.rpy:2460
translate russian minami_meet_morgan_ba6d49d8:
    "За выражение растерянности, которое изображает Минами, ей вполне можно дать «Оскар»."

# ch/minami/events.rpy:2461
translate russian minami_meet_morgan_cf4d4ae0:
    minami.say "Ой, правда?!"

# ch/minami/events.rpy:2463
translate russian minami_meet_morgan_42d249ef:
    minami.say "Мне ТАК жаль, Морган! Я и понятия не имела!"

# ch/minami/events.rpy:2464
translate russian minami_meet_morgan_84b168c3:
    minami.say "Наверное, я настолько привыкла, что братик всегда прав, что просто поверила ему на слово."

# ch/minami/events.rpy:2465
translate russian minami_meet_morgan_bfc57c44:
    minami.say "Ты сможешь меня простить?"

# ch/minami/events.rpy:2466
translate russian minami_meet_morgan_4ad39b57:
    "Я уже видел этот приём Минами: вся мощь её кажущейся невинности сосредоточена в одной точке."

# ch/minami/events.rpy:2467
translate russian minami_meet_morgan_70ae1185:
    "Словно кто-то собирает солнечные лучи лупой, чтобы разжечь огонь."

# ch/minami/events.rpy:2468
translate russian minami_meet_morgan_8aa0bcd9:
    "И даже Морган не может устоять перед этим страшным оружием!"

# ch/minami/events.rpy:2470
translate russian minami_meet_morgan_9b9ed480:
    morgan.say "Я... ну... наверное..."

# ch/minami/events.rpy:2471
translate russian minami_meet_morgan_522c1c08:
    morgan.say "Всё нормально, Минами."

# ch/minami/events.rpy:2472
translate russian minami_meet_morgan_22f2fa4e:
    morgan.say "По крайней мере, теперь ты знаешь правду."

# ch/minami/events.rpy:2474
translate russian minami_meet_morgan_fb21e631:
    "Получив прощение Морган, Минами снова сияет, сама доброта и невинность."

# ch/minami/events.rpy:2475
translate russian minami_meet_morgan_eb1db07e:
    minami.say "О-о, спасибо, Морган."

# ch/minami/events.rpy:2476
translate russian minami_meet_morgan_814aff4f:
    minami.say "Девушкой ты мне в любом случае больше нравишься."

# ch/minami/events.rpy:2477
translate russian minami_meet_morgan_16d4a9ce:
    minami.say "Ты ведь ТАКАЯ красивая!"

# ch/minami/events.rpy:2479
translate russian minami_meet_morgan_781cb34d:
    "Морган совершенно не готова к этому, и я вижу, как она краснеет от комплимента."

# ch/minami/events.rpy:2480
translate russian minami_meet_morgan_598dd8a2:
    morgan.say "С... спасибо, Минами..."

# ch/minami/events.rpy:2481
translate russian minami_meet_morgan_d5e627de:
    morgan.say "Очень мило с твоей стороны!"

# ch/minami/events.rpy:2482
translate russian minami_meet_morgan_af7e69f6:
    "Мы прощаемся с Морган и встаём в очередь за кофе."

# ch/minami/events.rpy:2486
translate russian minami_meet_morgan_44aaabb5:
    "Всё это время я украдкой поглядываю на Минами, которая выглядит так, будто ничего и не произошло."

# ch/minami/events.rpy:2487
translate russian minami_meet_morgan_3a407a85:
    "Она научилась так манипулировать людьми, пока меня не было дома?"

# ch/minami/events.rpy:2488
translate russian minami_meet_morgan_aea6a3b1:
    "Или этот талант был у неё всегда, а я просто не замечал?"

# ch/minami/events.rpy:2493
translate russian minami_react_kylie_sentence_8051a8e0:
    "Стоит поднять глаза и увидеть лицо Минами, как я сразу понимаю, что случилось."

# ch/minami/events.rpy:2494
translate russian minami_react_kylie_sentence_1d567cac:
    "В конце концов, я знаю её с детства, мы выросли вместе."

# ch/minami/events.rpy:2495
translate russian minami_react_kylie_sentence_51843a30:
    "Так что обычно я читаю её лицо как открытую книгу."

# ch/minami/events.rpy:2496
translate russian minami_react_kylie_sentence_06443758:
    "Сейчас она выглядит почти обезумевшей от горя."

# ch/minami/events.rpy:2497
translate russian minami_react_kylie_sentence_fc43a691:
    "Но в глазах есть и растерянность, словно она не уверена, имеет ли право так чувствовать."

# ch/minami/events.rpy:2498
translate russian minami_react_kylie_sentence_9f7d8079:
    "Ясно одно: она пришла не обсуждать график домашних обязанностей!"

# ch/minami/events.rpy:2499
translate russian minami_react_kylie_sentence_421e2700:
    mike.say "Минами..."

# ch/minami/events.rpy:2500
translate russian minami_react_kylie_sentence_d9454fb9:
    mike.say "Тебе нужно о чём-то поговорить?"

# ch/minami/events.rpy:2501
translate russian minami_react_kylie_sentence_2473a039:
    mike.say "Ты выглядишь так, будто тебя многое тревожит."

# ch/minami/events.rpy:2502
translate russian minami_react_kylie_sentence_3f0c0cbd:
    "Минами мгновение смотрит на меня, словно ошеломлённая."

# ch/minami/events.rpy:2503
translate russian minami_react_kylie_sentence_297f1e5a:
    "Затем начинает кивать, и мне кажется, что она сейчас заплачет."

# ch/minami/events.rpy:2504
translate russian minami_react_kylie_sentence_b90c836a:
    minami.say "Да, братик..."

# ch/minami/events.rpy:2505
translate russian minami_react_kylie_sentence_bc40acda:
    minami.say "Но... но я кое-чего боюсь!"

# ch/minami/events.rpy:2506
translate russian minami_react_kylie_sentence_3310c6c6:
    "Кажется, я догадываюсь чего."

# ch/minami/events.rpy:2507
translate russian minami_react_kylie_sentence_37512644:
    "Но лучше услышать это от самой Минами."

# ch/minami/events.rpy:2508
translate russian minami_react_kylie_sentence_ec693fb2:
    "Чем строить предположения и совершенно ошибиться."

# ch/minami/events.rpy:2509
translate russian minami_react_kylie_sentence_f0dbe454:
    mike.say "Всё хорошо, Минами..."

# ch/minami/events.rpy:2510
translate russian minami_react_kylie_sentence_1a1cb330:
    mike.say "Я рядом."

# ch/minami/events.rpy:2511
translate russian minami_react_kylie_sentence_a56bb3aa:
    mike.say "Что бы это ни было, ты можешь мне рассказать."

# ch/minami/events.rpy:2512
translate russian minami_react_kylie_sentence_d3184590:
    "Минами смотрит мне в глаза."

# ch/minami/events.rpy:2513
translate russian minami_react_kylie_sentence_d0e3f429:
    "Но почти сразу снова отводит взгляд."

# ch/minami/events.rpy:2514
translate russian minami_react_kylie_sentence_e7a1c8ea:
    minami.say "Ты уверен?"

# ch/minami/events.rpy:2515
translate russian minami_react_kylie_sentence_6c03d2f2:
    minami.say "Я боюсь, что ты на меня разозлишься!"

# ch/minami/events.rpy:2516
translate russian minami_react_kylie_sentence_9d202763:
    "Теперь я и правда начинаю теряться."

# ch/minami/events.rpy:2517
translate russian minami_react_kylie_sentence_421e2700_1:
    mike.say "Минами..."

# ch/minami/events.rpy:2518
translate russian minami_react_kylie_sentence_cb24926c:
    mike.say "Я... я не понимаю."

# ch/minami/events.rpy:2519
translate russian minami_react_kylie_sentence_29654a4c:
    mike.say "Из-за чего я вообще мог бы на тебя разозлиться?!"

# ch/minami/events.rpy:2520
translate russian minami_react_kylie_sentence_18b66837:
    "Минами снова поворачивается ко мне."

# ch/minami/events.rpy:2521
translate russian minami_react_kylie_sentence_e3c9668e:
    "И я вижу, как она нервно сцепляет руки."

# ch/minami/events.rpy:2523
translate russian minami_react_kylie_sentence_2a907f36:
    minami.say "Это..."

# ch/minami/events.rpy:2524
translate russian minami_react_kylie_sentence_fcaf1816:
    minami.say "Это насчёт Кайли, братик..."

# ch/minami/events.rpy:2525
translate russian minami_react_kylie_sentence_e9164d7c:
    minami.say "И того, что с ней собираются сделать!"

# ch/minami/events.rpy:2526
translate russian minami_react_kylie_sentence_40aba315:
    "Теперь всё начинает обретать хоть какой-то смысл."

# ch/minami/events.rpy:2527
translate russian minami_react_kylie_sentence_aecd996b:
    "То, что Кайли сделала той ночью, ворвавшись сюда, само по себе было ужасно."

# ch/minami/events.rpy:2528
translate russian minami_react_kylie_sentence_55d0a960:
    "Когда она оказалась за решёткой, я думал, на этом всё закончится."

# ch/minami/events.rpy:2529
translate russian minami_react_kylie_sentence_3d2bf4c0:
    "Думал, у всех нас будет время, чтобы оправиться."

# ch/minami/events.rpy:2530
translate russian minami_react_kylie_sentence_e4f0b3eb:
    "Но всё изменилось, когда я узнал, что её приговорят к смерти."

# ch/minami/events.rpy:2531
translate russian minami_react_kylie_sentence_cf90bc1e:
    "Наверное, большинство людей были бы вне себя от радости, считая это торжеством справедливости."

# ch/minami/events.rpy:2532
translate russian minami_react_kylie_sentence_604968f5:
    "Но, честно говоря, я почувствовал лишь пустоту и растерянность."

# ch/minami/events.rpy:2533
translate russian minami_react_kylie_sentence_60846a73:
    "И уж точно мне не стало легче от всего, что случилось."

# ch/minami/events.rpy:2534
translate russian minami_react_kylie_sentence_980cad9e:
    "Пожалуй, я могу только выслушать, что тревожит Минами."

# ch/minami/events.rpy:2535
translate russian minami_react_kylie_sentence_aaef7a97:
    "И честно рассказать ей о собственных чувствах."

# ch/minami/events.rpy:2536
translate russian minami_react_kylie_sentence_8220c8e9:
    mike.say "Расскажи, что ты чувствуешь, Минами."

# ch/minami/events.rpy:2537
translate russian minami_react_kylie_sentence_06da3698:
    mike.say "Обещаю, я не буду злиться, что бы это ни было."

# ch/minami/events.rpy:2538
translate russian minami_react_kylie_sentence_34b1a217:
    "Минами какое-то время молча изучает меня."

# ch/minami/events.rpy:2539
translate russian minami_react_kylie_sentence_8a81c1a6:
    "Будто пытается по глазам определить, говорю ли я правду."

# ch/minami/events.rpy:2540
translate russian minami_react_kylie_sentence_fa3d1be9:
    "С облегчением я понимаю, что она, похоже, мне верит."

# ch/minami/events.rpy:2541
translate russian minami_react_kylie_sentence_87b214c6:
    "Потому что спустя несколько секунд Минами наконец начинает открываться."

# ch/minami/events.rpy:2542
translate russian minami_react_kylie_sentence_62fbdaf8:
    minami.say "Я знаю, что должна ненавидеть Кайли за то, что она сделала."

# ch/minami/events.rpy:2543
translate russian minami_react_kylie_sentence_4171f62c:
    minami.say "И... я правда ненавижу ТО, что она сделала, братик."

# ch/minami/events.rpy:2545
translate russian minami_react_kylie_sentence_3349059e:
    minami.say "Но так трудно забыть, какой она была раньше."

# ch/minami/events.rpy:2546
translate russian minami_react_kylie_sentence_bbb3476c:
    minami.say "Ну, когда мы были детьми."

# ch/minami/events.rpy:2547
translate russian minami_react_kylie_sentence_1463b109:
    "Я киваю, слушая Минами."

# ch/minami/events.rpy:2548
translate russian minami_react_kylie_sentence_5ef42646:
    "Но мысленно чуть ли не ругаю себя."

# ch/minami/events.rpy:2549
translate russian minami_react_kylie_sentence_c176d1bb:
    "Потому что почти забыл, что тогда они с Кайли дружили."

# ch/minami/events.rpy:2550
translate russian minami_react_kylie_sentence_32de8a0b:
    "Мы с Алексис, конечно, были близки, но наши младшие сёстры тоже."

# ch/minami/events.rpy:2551
translate russian minami_react_kylie_sentence_998aff6e:
    "Неудивительно, что Минами так трудно принять то, какой стала Кайли."

# ch/minami/events.rpy:2552
translate russian minami_react_kylie_sentence_cbd0b30d:
    mike.say "Я говорил обо всём этом с Алексис, Минами."

# ch/minami/events.rpy:2553
translate russian minami_react_kylie_sentence_ae8b8574:
    mike.say "Она понимает случившееся не больше тебя."

# ch/minami/events.rpy:2554
translate russian minami_react_kylie_sentence_82305f9d:
    mike.say "А ведь она родная сестра Кайли!"

# ch/minami/events.rpy:2556
translate russian minami_react_kylie_sentence_89a0b938:
    minami.say "Но дело ещё и в другом, братик..."

# ch/minami/events.rpy:2557
translate russian minami_react_kylie_sentence_1e80cd7b:
    minami.say "Я... я не знаю, правильно ли её убивать!"

# ch/minami/events.rpy:2558
translate russian minami_react_kylie_sentence_0ead9f01:
    minami.say "Разве люди не должны учиться на своих ошибках?"

# ch/minami/events.rpy:2560
translate russian minami_react_kylie_sentence_4b27b026:
    minami.say "Как Кайли сможет это сделать, если её лишат жизни?!"

# ch/minami/events.rpy:2561
translate russian minami_react_kylie_sentence_c76a575d:
    "Я надеялся, что смогу обсудить это с Минами."

# ch/minami/events.rpy:2562
translate russian minami_react_kylie_sentence_ad14d935:
    "Что мы оба сможем рассказать друг другу о своих чувствах."

# ch/minami/events.rpy:2563
translate russian minami_react_kylie_sentence_8acdefd6:
    "Но на такой вопрос я совершенно не способен ответить."

# ch/minami/events.rpy:2564
translate russian minami_react_kylie_sentence_64c9614d:
    "Так что, похоже, остаётся снова быть честным."

# ch/minami/events.rpy:2565
translate russian minami_react_kylie_sentence_46bf7951:
    mike.say "Я не могу на это ответить, Минами."

# ch/minami/events.rpy:2566
translate russian minami_react_kylie_sentence_1f092d42:
    mike.say "И не знаю, может ли кто-нибудь."

# ch/minami/events.rpy:2567
translate russian minami_react_kylie_sentence_1f6ab26b:
    mike.say "Если кто и должен радоваться смертному приговору Кайли, так это я."

# ch/minami/events.rpy:2568
translate russian minami_react_kylie_sentence_3695b559:
    mike.say "Но знаешь что?"

# ch/minami/events.rpy:2570
translate russian minami_react_kylie_sentence_02638dfa:
    mike.say "Мне от этого ничуть не легче!"

# ch/minami/events.rpy:2571
translate russian minami_react_kylie_sentence_04d97bf1:
    "Минами потрясена моими словами."

# ch/minami/events.rpy:2572
translate russian minami_react_kylie_sentence_3b0fd3b1:
    "Будто она ожидала услышать прямо противоположное."

# ch/minami/events.rpy:2573
translate russian minami_react_kylie_sentence_79ba8e08:
    minami.say "Правда, братик?"

# ch/minami/events.rpy:2575
translate russian minami_react_kylie_sentence_98e3f41b:
    minami.say "Даже после того, как она... так сильно тебя ранила?"

# ch/minami/events.rpy:2576
translate russian minami_react_kylie_sentence_4c72744e:
    "Я пожимаю плечами и качаю головой."

# ch/minami/events.rpy:2577
translate russian minami_react_kylie_sentence_a732fc85:
    mike.say "Когда это чужая боль помогала?"

# ch/minami/events.rpy:2578
translate russian minami_react_kylie_sentence_d7e679c1:
    mike.say "Ну, когда тебе самому больно?"

# ch/minami/events.rpy:2579
translate russian minami_react_kylie_sentence_0feb82c5:
    mike.say "От этого боль не становится меньше."

# ch/minami/events.rpy:2580
translate russian minami_react_kylie_sentence_54839844:
    minami.say "Так что ты хочешь сказать, братик?"

# ch/minami/events.rpy:2581
translate russian minami_react_kylie_sentence_0bd84883:
    minami.say "Что нет правильного или неправильного ответа?"

# ch/minami/events.rpy:2582
translate russian minami_react_kylie_sentence_62f73b87:
    mike.say "Я не знаю, Минами..."

# ch/minami/events.rpy:2583
translate russian minami_react_kylie_sentence_6d5e23d4:
    mike.say "Скорее, что тебе самой нужно найти ответ, который будет иметь для тебя смысл."

# ch/minami/events.rpy:2584
translate russian minami_react_kylie_sentence_fab89615:
    mike.say "Но ведь говорить об этом и о своих чувствах должно помогать, правда?"

# ch/minami/events.rpy:2586
translate russian minami_react_kylie_sentence_5a09cc6e:
    "Минами улыбается и кладёт голову мне на плечо."

# ch/minami/events.rpy:2587
translate russian minami_react_kylie_sentence_84ddf856:
    minami.say "Ладно, братик..."

# ch/minami/events.rpy:2588
translate russian minami_react_kylie_sentence_468d82e4:
    minami.say "Думаю, мы сможем!"

# ch/minami/events.rpy:2594
translate russian minami_siscon_cap_04_234b30c2:
    "К этому времени я уже начинаю привыкать к мысли, что помогаю Минами осваивать искусство свиданий."

# ch/minami/events.rpy:2595
translate russian minami_siscon_cap_04_4aaca506:
    "Конечно, это неловко, и я понятия не имею, не приношу ли больше вреда, чем пользы."

# ch/minami/events.rpy:2596
translate russian minami_siscon_cap_04_fb2b66d5:
    "Но приятно знать, что в трудную минуту младшая сестра решила обратиться за советом ко мне."

# ch/minami/events.rpy:2597
translate russian minami_siscon_cap_04_e7f3a5d0:
    "Оглядываясь назад, я понимаю, что даже неловкое воспоминание об уроке поцелуев уже не кажется таким ужасным."

# ch/minami/events.rpy:2598
translate russian minami_siscon_cap_04_99d8177d:
    "Это было просто недоразумение: способная ученица удивила учителя неожиданным усердием, не более того."

# ch/minami/events.rpy:2600
translate russian minami_siscon_cap_04_5cf257e8:
    "Поэтому, когда Минами снова подходит с тем же выражением лица, я настроен вполне бодро."

# ch/minami/events.rpy:2601
translate russian minami_siscon_cap_04_fd30b6a4:
    mike.say "Привет, Минами."

# ch/minami/events.rpy:2602
translate russian minami_siscon_cap_04_92f9e580:
    mike.say "Уже пора на следующий урок?"

# ch/minami/events.rpy:2604
translate russian minami_siscon_cap_04_aa67dcba:
    "Похоже, моя готовность застаёт Минами врасплох."

# ch/minami/events.rpy:2605
translate russian minami_siscon_cap_04_5024ce39:
    "Сначала она даже затрудняется с ответом."

# ch/minami/events.rpy:2607
translate russian minami_siscon_cap_04_bd6623ab:
    minami.say "А, да, братик."

# ch/minami/events.rpy:2608
translate russian minami_siscon_cap_04_4d97c568:
    minami.say "Ты будто мысли читаешь!"

# ch/minami/events.rpy:2609
translate russian minami_siscon_cap_04_63cdc0a8:
    mike.say "Ладно, что на этот раз?"

# ch/minami/events.rpy:2610
translate russian minami_siscon_cap_04_26be902c:
    mike.say "Советы по амурным делам?"

# ch/minami/events.rpy:2611
translate russian minami_siscon_cap_04_0f7dd2b5:
    mike.say "Повторение романтики?"

# ch/minami/events.rpy:2612
translate russian minami_siscon_cap_04_de868183:
    minami.say "Эм... нет."

# ch/minami/events.rpy:2613
translate russian minami_siscon_cap_04_b9bebf4b:
    minami.say "Кое-что поконкретнее..."

# ch/minami/events.rpy:2614
translate russian minami_siscon_cap_04_6885f03f:
    mike.say "Правда?"

# ch/minami/events.rpy:2615
translate russian minami_siscon_cap_04_9dc1d650:
    mike.say "И что именно?"

# ch/minami/events.rpy:2616
translate russian minami_siscon_cap_04_e8871c6e:
    "Минами делает паузу, глубоко вдыхает и выдыхает."

# ch/minami/events.rpy:2618
translate russian minami_siscon_cap_04_b4ace299:
    "Затем натягивает улыбку и отвечает."

# ch/minami/events.rpy:2619
translate russian minami_siscon_cap_04_a049ef56:
    minami.say "Ну..."

# ch/minami/events.rpy:2620
translate russian minami_siscon_cap_04_96475c73:
    minami.say "Я хочу всё узнать о... членах."

# ch/minami/events.rpy:2621
translate russian minami_siscon_cap_04_c398624a:
    "Какое-то время я беззвучно открываю и закрываю рот: слова никак не доходят от мозга до языка."

# ch/minami/events.rpy:2622
translate russian minami_siscon_cap_04_0fccf40d:
    "И всё ещё пытаюсь понять, действительно ли она сказала то, что я услышал."

# ch/minami/events.rpy:2623
translate russian minami_siscon_cap_04_286768bd:
    mike.say "Ты хочешь узнать о чём?!"

# ch/minami/events.rpy:2625
translate russian minami_siscon_cap_04_316f369a:
    "Минами качает головой, раздражённая моей явной незрелостью."

# ch/minami/events.rpy:2626
translate russian minami_siscon_cap_04_bf08fd4d:
    minami.say "О членах, братик!"

# ch/minami/events.rpy:2627
translate russian minami_siscon_cap_04_7cec695e:
    minami.say "Ну, о тех штуках, которыми вы, парни, якобы думаете вместо головы!"

# ch/minami/events.rpy:2628
translate russian minami_siscon_cap_04_4519584f:
    "Я машу руками, пытаясь заставить Минами говорить тише."

# ch/minami/events.rpy:2629
translate russian minami_siscon_cap_04_b6837821:
    mike.say "Да, спасибо, я вроде бы знаю, что такое член!"

# ch/minami/events.rpy:2630
translate russian minami_siscon_cap_04_9d9995d9:
    mike.say "И ты, между прочим, тоже!"

# ch/minami/events.rpy:2631
translate russian minami_siscon_cap_04_da716f59:
    mike.say "Сомневаюсь, что именно этот урок биологии ты проспала, Минами."

# ch/minami/events.rpy:2632
translate russian minami_siscon_cap_04_4e31c2f3:
    "Минами тоже вскидывает руки, раздражённая моей реакцией."

# ch/minami/events.rpy:2633
translate russian minami_siscon_cap_04_62e2bade:
    minami.say "Да при чём тут вообще настоящий секс, братик!"

# ch/minami/events.rpy:2634
translate russian minami_siscon_cap_04_0c6dda82:
    minami.say "Не скажешь же ты, что строишь свою технику по схеме влагалища?"

# ch/minami/events.rpy:2635
translate russian minami_siscon_cap_04_9f08cf4a:
    mike.say "Эй, погоди-ка, Минами."

# ch/minami/events.rpy:2636
translate russian minami_siscon_cap_04_be4eecd2:
    mike.say "Ты просила научить тебя ходить на свидания, а не заниматься сексом!"

# ch/minami/events.rpy:2638
translate russian minami_siscon_cap_04_15541e31:
    minami.say "Но это ведь тоже часть свиданий."

# ch/minami/events.rpy:2639
translate russian minami_siscon_cap_04_fa861300:
    minami.say "Ну же, нельзя оставлять меня на первой базе!"

# ch/minami/events.rpy:2640
translate russian minami_siscon_cap_04_1444be8f:
    mike.say "Да, Минами, тебе легко говорить."

# ch/minami/events.rpy:2641
translate russian minami_siscon_cap_04_259e4534:
    mike.say "Но во что мне обойдётся продвинуть тебя дальше второй базы?!"

# ch/minami/events.rpy:2643
translate russian minami_siscon_cap_04_835627c5:
    "Мгновение спустя её истинные намерения выдаёт взгляд, скользнувший ниже моей талии."

# ch/minami/events.rpy:2644
translate russian minami_siscon_cap_04_5a0f7f40:
    "Она тут же поднимает глаза и изо всех сил делает вид, что ничего не было."

# ch/minami/events.rpy:2645
translate russian minami_siscon_cap_04_35d00bfc:
    "Но поздно, я уже всё понял."

# ch/minami/events.rpy:2646
translate russian minami_siscon_cap_04_2956f60c:
    mike.say "О нет!"

# ch/minami/events.rpy:2647
translate russian minami_siscon_cap_04_095d0a22:
    mike.say "Ничего подобного, Минами!"

# ch/minami/events.rpy:2649
translate russian minami_siscon_cap_04_bcd22f22:
    minami.say "Пожалуйста, братик!"

# ch/minami/events.rpy:2650
translate russian minami_siscon_cap_04_ee613960:
    minami.say "Мне только одним глазком посмотреть!"

# ch/minami/events.rpy:2651
translate russian minami_siscon_cap_04_75f67b23:
    "Минами складывает ладони и умоляюще ноет, добиваясь своего."

# ch/minami/events.rpy:2652
translate russian minami_siscon_cap_04_d7c4b202:
    "Она уже собирается опуститься на колени прямо передо мной."

# ch/minami/events.rpy:2653
translate russian minami_siscon_cap_04_d4e76498:
    "Может, она просто излишне драматизирует и собирается просить на коленях."

# ch/minami/events.rpy:2654
translate russian minami_siscon_cap_04_03ddd387:
    "Но с тем же успехом может пытаться подобраться поближе к своей цели!"

# ch/minami/events.rpy:2657
translate russian minami_siscon_cap_04_4e875f33:
    mike.say "Сколько раз повторять, Минами?"

# ch/minami/events.rpy:2658
translate russian minami_siscon_cap_04_ca8c183c:
    mike.say "Нет, я не покажу тебе своё мужское достоинство!"

# ch/minami/events.rpy:2659
translate russian minami_siscon_cap_04_9d7ae7b1:
    "Я пячусь от неё, но она спешит следом."

# ch/minami/events.rpy:2661
translate russian minami_siscon_cap_04_7c60af6a:
    minami.say "Только мельком взглянуть, братик."

# ch/minami/events.rpy:2662
translate russian minami_siscon_cap_04_78ca337e:
    minami.say "Клянусь, мне больше ничего не надо!"

# ch/minami/events.rpy:2663
translate russian minami_siscon_cap_04_118b2d43:
    "Наконец немного оторвавшись, я поворачиваюсь к Минами спиной."

# ch/minami/events.rpy:2664
translate russian minami_siscon_cap_04_5891f7ac:
    mike.say "НЕТ!"

# ch/minami/events.rpy:2665
translate russian minami_siscon_cap_04_c12c7d95:
    mike.say "Иди посмотри порно, Минами."

# ch/minami/events.rpy:2666
translate russian minami_siscon_cap_04_afafbcd4:
    mike.say "Там сможешь разглядывать члены сколько угодно!"

# ch/minami/events.rpy:2668
translate russian minami_siscon_cap_04_5d76b5a2:
    "Минами сердито топает ногой и, больше не говоря ни слова, уходит."

# ch/minami/events.rpy:2670
translate russian minami_siscon_cap_04_559db364:
    "Я смотрю ей вслед, изо всех сил надеясь, что никто не слышал этот разговор."

# ch/minami/events.rpy:2674
translate russian minami_siscon_cap_04_343fde41:
    "Я уже собираюсь отогнать Минами от своего паха, но тут мне приходит в голову мысль."

# ch/minami/events.rpy:2675
translate russian minami_siscon_cap_04_1a3e4e01:
    "Многим ли девушкам везёт узнать обо всём этом до начала самостоятельной жизни?"

# ch/minami/events.rpy:2676
translate russian minami_siscon_cap_04_1eaa3ae2:
    "Большинство парней тоже мало что понимают, но хотя бы знают, что делать со своим членом."

# ch/minami/events.rpy:2677
translate russian minami_siscon_cap_04_6573e612:
    "Разве я буду хорошим старшим братом, если отпущу Минами, ничего ей не объяснив?"

# ch/minami/events.rpy:2678
translate russian minami_siscon_cap_04_d62ddf68:
    "Да-да-да, я знаю, как это выглядит."

# ch/minami/events.rpy:2679
translate russian minami_siscon_cap_04_880d967e:
    "Но наши отношения никогда не были самыми обычными отношениями брата и сестры."

# ch/minami/events.rpy:2680
translate russian minami_siscon_cap_04_79475527:
    mike.say "О боже..."

# ch/minami/events.rpy:2681
translate russian minami_siscon_cap_04_384c852a:
    mike.say "Я об этом пожалею, я точно знаю!"

# ch/minami/events.rpy:2684
translate russian minami_siscon_cap_04_7e1173ce:
    "В глазах Минами появляется надежда, и руки снова тянутся к заветной цели."

# ch/minami/events.rpy:2685
translate russian minami_siscon_cap_04_188ff22c:
    mike.say "Но не здесь!"

# ch/minami/events.rpy:2686
translate russian minami_siscon_cap_04_40d86ce4:
    mike.say "Сначала уйдём куда-нибудь подальше от чужих глаз..."

# ch/minami/events.rpy:2691
translate russian minami_siscon_cap_04_d8bd91bb:
    "Поспешно укрывшись в своей спальне, я закрываю дверь и глубоко вдыхаю."

# ch/minami/events.rpy:2692
translate russian minami_siscon_cap_04_209f8cf6:
    "Минами довольно сидит на кровати и просто ждёт начала представления."

# ch/minami/events.rpy:2693
translate russian minami_siscon_cap_04_e8de2389:
    "Я глубоко вдыхаю, но это ничуть не помогает подготовиться к тому, что предстоит сделать."

# ch/minami/events.rpy:2694
translate russian minami_siscon_cap_04_4decd79e:
    "Стоя в паре шагов от Минами, я расстёгиваю штаны и спускаю их."

# ch/minami/events.rpy:2695
translate russian minami_siscon_cap_04_b7c854e3:
    mike.say "Вот, Минами. Теперь довольна?"

# ch/minami/events.rpy:2696
translate russian minami_siscon_cap_04_cc0cb61c:
    minami.say "О-о..."

# ch/minami/events.rpy:2697
translate russian minami_siscon_cap_04_7df764da:
    minami.say "М-м-м..."

# ch/minami/events.rpy:2698
translate russian minami_siscon_cap_04_7e4b8754:
    mike.say "Ч... что это за звуки?"

# ch/minami/events.rpy:2699
translate russian minami_siscon_cap_04_ee865f82:
    "Минами неохотно отрывает взгляд от моего паха и смотрит мне в лицо."

# ch/minami/events.rpy:2700
translate russian minami_siscon_cap_04_d3f3e598:
    minami.say "А?"

# ch/minami/events.rpy:2701
translate russian minami_siscon_cap_04_3cf179d0:
    mike.say "Ты ничего не говоришь, Минами, только издаёшь странные звуки!"

# ch/minami/events.rpy:2702
translate russian minami_siscon_cap_04_e9b13dff:
    mike.say "Что-то не так?"

# ch/minami/events.rpy:2703
translate russian minami_siscon_cap_04_d0736f4d:
    minami.say "Ой, нет, братик."

# ch/minami/events.rpy:2704
translate russian minami_siscon_cap_04_a6b7ad19:
    minami.say "Он... очень симпатичный."

# ch/minami/events.rpy:2705
translate russian minami_siscon_cap_04_3c6a7fb0:
    mike.say "И всё?!"

# ch/minami/events.rpy:2706
translate russian minami_siscon_cap_04_0f5b0be6:
    minami.say "Эй, а что ещё ты хочешь услышать?"

# ch/minami/events.rpy:2707
translate russian minami_siscon_cap_04_e76eeefe:
    minami.say "Я старалась не делать ситуацию ещё неловче!"

# ch/minami/events.rpy:2708
translate russian minami_siscon_cap_04_89f3e0af:
    mike.say "Не получилось! Ты только заставила меня нервничать!"

# ch/minami/events.rpy:2710
translate russian minami_siscon_cap_04_3bab8c95:
    "Щёки Минами краснеют от смущения, и она тут же возражает."

# ch/minami/events.rpy:2711
translate russian minami_siscon_cap_04_d2a60a62:
    minami.say "Что ты хочешь, чтобы я сказала, братик?!"

# ch/minami/events.rpy:2712
translate russian minami_siscon_cap_04_18e79996:
    minami.say "Он такой симпатичный, что мне хочется его потрогать!"

# ch/minami/events.rpy:2713
translate russian minami_siscon_cap_04_eaf15a08:
    minami.say "Я... я не думала, что он будет таким... большим!"

# ch/minami/events.rpy:2714
translate russian minami_siscon_cap_04_b7df15c3:
    "Теперь уже мои щёки начинают гореть."

# ch/minami/events.rpy:2715
translate russian minami_siscon_cap_04_c840c381:
    mike.say "Это я сейчас сделал всё неловким, да?"

# ch/minami/events.rpy:2716
translate russian minami_siscon_cap_04_ab9663ee:
    minami.say "Да, братик, ты."

# ch/minami/events.rpy:2717
translate russian minami_siscon_cap_04_7a298d4a:
    mike.say "Я сейчас подтяну штаны, ладно?"

# ch/minami/events.rpy:2718
translate russian minami_siscon_cap_04_84ddf856:
    minami.say "Ладно, братик..."

# ch/minami/events.rpy:2719
translate russian minami_siscon_cap_04_30a7ce26:
    "И пока я это делаю, Минами больше не может сдерживаться."

# ch/minami/events.rpy:2721
translate russian minami_siscon_cap_04_ad58dd36:
    "Она разражается нервным смехом, а я сгораю от стыда за своё глупое тщеславие..."

# ch/minami/events.rpy:2730
translate russian minami_siscon_cap_03_c0df1cd6:
    "Знаете это странное чувство, когда каким-то образом понимаешь, что за тобой наблюдают?"

# ch/minami/events.rpy:2731
translate russian minami_siscon_cap_03_c1aa1c15:
    "Вот именно это я сейчас и ощущаю, причём так сильно, что невольно поднимаю глаза."

# ch/minami/events.rpy:2732
translate russian minami_siscon_cap_03_8d9387cc:
    "И на этот раз это не просто смутное подозрение, которое ничем не подтверждается."

# ch/minami/events.rpy:2734
translate russian minami_siscon_cap_03_f0ec63aa:
    "Потому что первым делом я вижу Минами: она смотрит прямо на меня с приторно-сладкой улыбкой."

# ch/minami/events.rpy:2735
translate russian minami_siscon_cap_03_908692b1:
    "Вдобавок она сцепила руки за спиной и чертит носком ноги линию на полу."

# ch/minami/events.rpy:2736
translate russian minami_siscon_cap_03_ba8a110e:
    "Хотя прямо она ничего не говорит, я сразу уверен: ей что-то нужно."

# ch/minami/events.rpy:2737
translate russian minami_siscon_cap_03_e9d4f4f9:
    "В конце концов, мы выросли вместе."

# ch/minami/events.rpy:2738
translate russian minami_siscon_cap_03_ac26cfae:
    "Я часто видел, как она принимала такую позу перед мамой с папой, а потом неизменно получала желаемое."

# ch/minami/events.rpy:2739
translate russian minami_siscon_cap_03_074a63b4:
    "Но она не знает, что я разгадал все её игры и так просто не сдамся."

# ch/minami/events.rpy:2740
translate russian minami_siscon_cap_03_f8e14102:
    mike.say "Ладно, Минами, выкладывай."

# ch/minami/events.rpy:2742
translate russian minami_siscon_cap_03_b03f449e:
    "Минами изо всех сил изображает потрясённое удивление."

# ch/minami/events.rpy:2743
translate russian minami_siscon_cap_03_f1785d84:
    minami.say "Ой, братик!"

# ch/minami/events.rpy:2744
translate russian minami_siscon_cap_03_03de389d:
    minami.say "О чём ты вообще?"

# ch/minami/events.rpy:2745
translate russian minami_siscon_cap_03_dcd24bef:
    mike.say "Не надо, Минами."

# ch/minami/events.rpy:2746
translate russian minami_siscon_cap_03_8614b221:
    mike.say "Тебе что-то нужно, я знаю."

# ch/minami/events.rpy:2747
translate russian minami_siscon_cap_03_4aed1beb:
    mike.say "Так что не ходи вокруг да около. Говори, сейчас же!"

# ch/minami/events.rpy:2749
translate russian minami_siscon_cap_03_184f307a:
    minami.say "Ладно, ладно, я уже поняла!"

# ch/minami/events.rpy:2750
translate russian minami_siscon_cap_03_b63e598a:
    "Я киваю, готовясь услышать то, что скажет Минами."

# ch/minami/events.rpy:2752
translate russian minami_siscon_cap_03_ba98083d:
    minami.say "Просто хотела узнать: ещё не пора на следующий урок?"

# ch/minami/events.rpy:2753
translate russian minami_siscon_cap_03_8b76d156:
    minami.say "Помнишь? Следующий урок свиданий."

# ch/minami/events.rpy:2754
translate russian minami_siscon_cap_03_3723934b:
    "Ну конечно, я ведь позволил Минами уговорить себя обучать её основам свиданий."

# ch/minami/events.rpy:2755
translate russian minami_siscon_cap_03_69c91f07:
    "Признаюсь, я старался забыть об этом в надежде, что и она забудет."

# ch/minami/events.rpy:2756
translate russian minami_siscon_cap_03_b9c1e0ff:
    "Но, похоже, надежда была совершенно напрасной."

# ch/minami/events.rpy:2757
translate russian minami_siscon_cap_03_3b4abbac:
    mike.say "А, да..."

# ch/minami/events.rpy:2758
translate russian minami_siscon_cap_03_c1ebd5df:
    mike.say "Конечно, Минами."

# ch/minami/events.rpy:2759
translate russian minami_siscon_cap_03_238cdc8f:
    mike.say "Я как раз собирался с тобой об этом поговорить."

# ch/minami/events.rpy:2761
translate russian minami_siscon_cap_03_884b5ec3:
    minami.say "Здорово, братик, потому что я уже полностью готова!"

# ch/minami/events.rpy:2762
translate russian minami_siscon_cap_03_0c2ab347:
    mike.say "Да, вот в чём дело."

# ch/minami/events.rpy:2763
translate russian minami_siscon_cap_03_df391dce:
    mike.say "Не уверен, что тебе нужны ещё..."

# ch/minami/events.rpy:2765
translate russian minami_siscon_cap_03_b0fcc036:
    "Но с тем же успехом я мог бы говорить в пустоту: Минами продолжает, не давая мне вставить слово."

# ch/minami/events.rpy:2766
translate russian minami_siscon_cap_03_33a54d37:
    minami.say "Следующий урок может быть только об одном."

# ch/minami/events.rpy:2767
translate russian minami_siscon_cap_03_b88131b7:
    minami.say "Ты просто ОБЯЗАН научить меня целоваться, правда?!"

# ch/minami/events.rpy:2768
translate russian minami_siscon_cap_03_7aa6cc7a:
    "Какого чёрта?!"

# ch/minami/events.rpy:2769
translate russian minami_siscon_cap_03_9dd93bbc:
    "Она это серьёзно?"

# ch/minami/events.rpy:2770
translate russian minami_siscon_cap_03_0872e1a8:
    mike.say "Минами, только не говори, что ты раньше ни с кем не целовалась."

# ch/minami/events.rpy:2772
translate russian minami_siscon_cap_03_4b689e42:
    "Минами вдруг смущается и отводит глаза."

# ch/minami/events.rpy:2773
translate russian minami_siscon_cap_03_4f386942:
    minami.say "Братик, не дразни меня!"

# ch/minami/events.rpy:2774
translate russian minami_siscon_cap_03_b9d3fa4e:
    minami.say "Ну и что, если не целовалась?"

# ch/minami/events.rpy:2775
translate russian minami_siscon_cap_03_3929a656:
    minami.say "Я... ждала подходящего парня, понимаешь?"

# ch/minami/events.rpy:2776
translate russian minami_siscon_cap_03_d570b910:
    mike.say "Разве это не ещё одна причина не учиться у меня?"

# ch/minami/events.rpy:2777
translate russian minami_siscon_cap_03_542e6e46:
    mike.say "Ты правда хочешь, чтобы первый поцелуй был с братом, а не с этим «подходящим парнем»?"

# ch/minami/events.rpy:2779
translate russian minami_siscon_cap_03_654d68d1:
    minami.say "А что, если подходящий парень — это..."

# ch/minami/events.rpy:2780
translate russian minami_siscon_cap_03_d10e50ba:
    "Минами останавливается, не договорив."

# ch/minami/events.rpy:2781
translate russian minami_siscon_cap_03_7274d088:
    "На мгновение мне кажется, что она собиралась сказать что-то важное."

# ch/minami/events.rpy:2783
translate russian minami_siscon_cap_03_b7dee6d9:
    "Но затем она будто отгоняет эту мысль и начинает заново."

# ch/minami/events.rpy:2784
translate russian minami_siscon_cap_03_b36ca1b5:
    minami.say "С тобой это ведь не будет считаться, братик."

# ch/minami/events.rpy:2785
translate russian minami_siscon_cap_03_5ee5d730:
    minami.say "И только один раз, обещаю. Пожалуйста?"

# ch/minami/events.rpy:2788
translate russian minami_siscon_cap_03_59c9ae94:
    mike.say "Нет уж, Минами."

# ch/minami/events.rpy:2789
translate russian minami_siscon_cap_03_be481f7e:
    mike.say "Это было бы слишком странно!"

# ch/minami/events.rpy:2791
translate russian minami_siscon_cap_03_5fc36310:
    minami.say "Ну-у, нечестно!"

# ch/minami/events.rpy:2792
translate russian minami_siscon_cap_03_f8ed180b:
    minami.say "И что мне тогда делать?"

# ch/minami/events.rpy:2793
translate russian minami_siscon_cap_03_1d1d11d1:
    "Мне остаётся только пожать плечами и покачать головой."

# ch/minami/events.rpy:2794
translate russian minami_siscon_cap_03_b39058cd:
    mike.say "Не знаю, Минами."

# ch/minami/events.rpy:2795
translate russian minami_siscon_cap_03_6a8b8539:
    mike.say "Может, потренируешься на своей руке или как-нибудь ещё?"

# ch/minami/events.rpy:2797
translate russian minami_siscon_cap_03_71820949:
    "Минами недовольно фыркает и едва не топает ногой."

# ch/minami/events.rpy:2798
translate russian minami_siscon_cap_03_62bdfef5:
    "Поворачиваясь, чтобы уйти, она что-то бормочет себе под нос."

# ch/minami/events.rpy:2799
translate russian minami_siscon_cap_03_cd3a4047:
    minami.say "Может, попрошу помощи у [bree.name] и Саши..."

# ch/minami/events.rpy:2804
translate russian minami_siscon_cap_03_b61b4bdf:
    "Неужели помочь ей было бы так уж плохо?"

# ch/minami/events.rpy:2805
translate russian minami_siscon_cap_03_39dd6059:
    "Ведь постоянно слышишь, как девчонки-подростки учатся целоваться друг с другом, правда?"

# ch/minami/events.rpy:2806
translate russian minami_siscon_cap_03_500527c2:
    "А я её брат, так что никто из нас не поймёт это неправильно."

# ch/minami/events.rpy:2807
translate russian minami_siscon_cap_03_1fb2f90b:
    mike.say "А, какого чёрта."

# ch/minami/events.rpy:2808
translate russian minami_siscon_cap_03_6ef96c3f:
    mike.say "Если ты уверена, что это поможет, Минами."

# ch/minami/events.rpy:2810
translate russian minami_siscon_cap_03_79d433d9:
    minami.say "О-о, как же это ВОЛНИТЕЛЬНО!"

# ch/minami/events.rpy:2811
translate russian minami_siscon_cap_03_df9e20bf:
    minami.say "Обещаешь быть нежным, братик?"

# ch/minami/events.rpy:2812
translate russian minami_siscon_cap_03_995e50b1:
    mike.say "Я... конечно, Минами!"

# ch/minami/events.rpy:2813
translate russian minami_siscon_cap_03_e5141ad4:
    mike.say "Ладно... начнём с простого: просто коснёмся губами."

# ch/minami/events.rpy:2815
translate russian minami_siscon_cap_03_33109bb6:
    "Минами тут же наклоняется вперёд, вытягивает губы и морщит всё остальное лицо."

# ch/minami/events.rpy:2816
translate russian minami_siscon_cap_03_1d50c11c:
    "Я едва удерживаюсь от смеха."

# ch/minami/events.rpy:2817
translate russian minami_siscon_cap_03_28bfcd6c:
    mike.say "Попробуй расслабиться, Минами."

# ch/minami/events.rpy:2818
translate russian minami_siscon_cap_03_dc3fb6fa:
    mike.say "Просто веди себя естественно."

# ch/minami/events.rpy:2819
translate russian minami_siscon_cap_03_f9ad01ba:
    "Она кивает и на этот раз слушается."

# ch/minami/events.rpy:2822
translate russian minami_siscon_cap_03_92393f48:
    "Я нежно прикасаюсь губами к её губам, почти не надавливая."

# ch/minami/events.rpy:2823
translate russian minami_siscon_cap_03_4d5975b8:
    "Это так приятно, что я невольно начинаю завидовать её воображаемому «подходящему парню»."

# ch/minami/events.rpy:2824
translate russian minami_siscon_cap_03_e53ae5b8:
    "Сначала она совсем не двигается, но затем я чувствую лёгкое движение её губ."

# ch/minami/events.rpy:2825
translate russian minami_siscon_cap_03_615c4b80:
    "Хорошо, она следует инстинктам."

# ch/minami/events.rpy:2826
translate russian minami_siscon_cap_03_5b9061b1:
    "Я подбадриваю её, отвечая тем же."

# ch/minami/events.rpy:2827
translate russian minami_siscon_cap_03_f3faf692:
    "Мгновение спустя её губы размыкаются, и язык скользит мне в рот."

# ch/minami/events.rpy:2828
translate russian minami_siscon_cap_03_0006743f:
    "Нужно тут же всё прекратить."

# ch/minami/events.rpy:2829
translate russian minami_siscon_cap_03_2621c2a6:
    "Но я этого не делаю, и хотелось бы списать это на потрясение."

# ch/minami/events.rpy:2830
translate russian minami_siscon_cap_03_7c69b1dd:
    "Правда в том, что язык Минами дарит невероятные ощущения, и я не могу не ответить на поцелуй."

# ch/minami/events.rpy:2831
translate russian minami_siscon_cap_03_6f964521:
    "За считаные мгновения целомудренный, нежный поцелуй становится страстным и жадным."

# ch/minami/events.rpy:2832
translate russian minami_siscon_cap_03_954979a5:
    "Я уже чувствую, как твердеет член, и слышу прерывистое дыхание Минами..."

# ch/minami/events.rpy:2834
translate russian minami_siscon_cap_03_e791aeb4:
    "Ужасная правда в том, что я не хочу останавливаться. В моих объятиях женщина, её тело прижато к моему, и всё во мне жаждет большего."

# ch/minami/events.rpy:2836
translate russian minami_siscon_cap_03_21f36b48:
    "Это так далеко зашло за рамки урока, что уже не смешно. Хуже того, я сам тянусь к ней. Она моя сестра, а я не могу заставить себя отстраниться."

# ch/minami/events.rpy:2837
translate russian minami_siscon_cap_03_d5e01c64:
    "Чёрт, нельзя этого допустить!"

# ch/minami/events.rpy:2838
translate russian minami_siscon_cap_03_e162ff43:
    "Собрав остатки воли, я отрываюсь от Минами."

# ch/minami/events.rpy:2839
translate russian minami_siscon_cap_03_79058802:
    mike.say "П... прости, Минами..."

# ch/minami/events.rpy:2840
translate russian minami_siscon_cap_03_df62a5da:
    mike.say "Не знаю, что на меня нашло!"

# ch/minami/events.rpy:2844
translate russian minami_siscon_cap_03_1489f055:
    "Минами держит руку на груди, тяжело дышит и смотрит на меня широко раскрытыми, почти голодными глазами."

# ch/minami/events.rpy:2845
translate russian minami_siscon_cap_03_f1c17850:
    minami.say "Я... я тоже, братик."

# ch/minami/events.rpy:2846
translate russian minami_siscon_cap_03_f907d306:
    minami.say "Но ты ОЧЕНЬ хорошо целуешься!"

# ch/minami/events.rpy:2847
translate russian minami_siscon_cap_03_1206ba86:
    minami.say "Только... я должна была это чувствовать... вот здесь?"

# ch/minami/events.rpy:2848
translate russian minami_siscon_cap_03_2433562d:
    "Я слежу за второй рукой Минами, когда она указывает себе между бёдер."

# ch/minami/events.rpy:2849
translate russian minami_siscon_cap_03_378678e0:
    mike.say "Да... нет... чёрт, я уже сам не знаю!"

# ch/minami/events.rpy:2850
translate russian minami_siscon_cap_03_2f38b06a:
    minami.say "Ой, по-моему, тебе нужно прилечь. Или принять холодный душ!"

# ch/minami/events.rpy:2863
translate russian minami_siscon_cap_02_101be607:
    "После жарких споров и бурных обсуждений мы с Минами выбираем океанариум для первого урока свиданий."

# ch/minami/events.rpy:2864
translate russian minami_siscon_cap_02_fb407902:
    "Сначала она предложила поесть в хорошем ресторане, но я отверг идею: это уже для второго, а то и третьего свидания."

# ch/minami/events.rpy:2865
translate russian minami_siscon_cap_02_f7ff7919:
    "Я предложил торговый центр, но Минами лишь закатила глаза и сказала, что это скучно и предсказуемо."

# ch/minami/events.rpy:2866
translate russian minami_siscon_cap_02_b4696b6f:
    "А вот против океанариума никто не возражал, и я ухватился за этот удачный компромисс."

# ch/minami/events.rpy:2868
translate russian minami_siscon_cap_02_a2549e66:
    "Едва я покупаю билеты и мы проходим внутрь, Минами берёт меня за руку."

# ch/minami/events.rpy:2869
translate russian minami_siscon_cap_02_80613e35:
    "Удивлённый, я смотрю на наши переплетённые пальцы, а затем на неё."

# ch/minami/events.rpy:2870
translate russian minami_siscon_cap_02_2e38a064:
    mike.say "Эм, Минами..."

# ch/minami/events.rpy:2872
translate russian minami_siscon_cap_02_3a6341d7:
    minami.say "Да, братик?"

# ch/minami/events.rpy:2874
translate russian minami_siscon_cap_02_492f8159:
    mike.say "Зачем ты держишь меня за руку?"

# ch/minami/events.rpy:2875
translate russian minami_siscon_cap_02_e2685519:
    mike.say "В буклете, который дали с билетами, есть карта."

# ch/minami/events.rpy:2876
translate russian minami_siscon_cap_02_3e4fdccc:
    mike.say "Да и я не особо боюсь, что ты потеряешься."

# ch/minami/events.rpy:2878
translate russian minami_siscon_cap_02_ce77273b:
    "Минами склоняет голову набок и смотрит на меня с предельной снисходительностью."

# ch/minami/events.rpy:2880
translate russian minami_siscon_cap_02_5a3c3fd7:
    minami.say "Не будь таким недотёпой, братик!"

# ch/minami/events.rpy:2881
translate russian minami_siscon_cap_02_b97cd7d0:
    minami.say "У нас вроде как свидание."

# ch/minami/events.rpy:2883
translate russian minami_siscon_cap_02_00354afe:
    minami.say "А на свидании девушку держат за руку!"

# ch/minami/events.rpy:2885
translate russian minami_siscon_cap_02_03ef204a:
    mike.say "Да, но это ведь не НАСТОЯЩЕЕ свидание, Минами."

# ch/minami/events.rpy:2886
translate russian minami_siscon_cap_02_495cd39a:
    mike.say "Я скорее показываю тебе, как это делается, понимаешь?"

# ch/minami/events.rpy:2887
translate russian minami_siscon_cap_02_7db64b8a:
    mike.say "Мы не пытаемся убедить окружающих, что всё взаправду."

# ch/minami/events.rpy:2889
translate russian minami_siscon_cap_02_c7b64e95:
    "Вдруг лицо Минами меняется: улыбка уступает место хмурому выражению."

# ch/minami/events.rpy:2891
translate russian minami_siscon_cap_02_8d3f4c9c:
    minami.say "Почему, братик?"

# ch/minami/events.rpy:2892
translate russian minami_siscon_cap_02_1085c7ff:
    minami.say "Считаешь, я недостаточно красивая, чтобы они поверили?"

# ch/minami/events.rpy:2893
translate russian minami_siscon_cap_02_94d8c6f6:
    minami.say "Хочешь сказать, никто не поверит, что меня могут пригласить на свидание?"

# ch/minami/events.rpy:2899
translate russian minami_siscon_cap_02_27b1075e:
    mike.say "Минами, прекрати, ты говоришь глупости."

# ch/minami/events.rpy:2900
translate russian minami_siscon_cap_02_eb27c92a:
    mike.say "Неважно, что думают остальные."

# ch/minami/events.rpy:2901
translate russian minami_siscon_cap_02_2cd9e8f7:
    mike.say "И это лишь твой первый урок."

# ch/minami/events.rpy:2902
translate russian minami_siscon_cap_02_dc9683fe:
    mike.say "Будешь переживать о том, чтобы всё сделать правильно, на настоящем свидании!"

# ch/minami/events.rpy:2903
translate russian minami_siscon_cap_02_2b5923e0:
    "Минами смотрит себе под ноги и неохотно высвобождает руку."

# ch/minami/events.rpy:2904
translate russian minami_siscon_cap_02_e53531fd:
    "Я прекрасно знаю, что теперь она дуется, но не позволяю этому меня задеть."

# ch/minami/events.rpy:2905
translate russian minami_siscon_cap_02_b2f7bad8:
    "Раз она оставила эту тему, значит, мои слова всё-таки дошли."

# ch/minami/events.rpy:2909
translate russian minami_siscon_cap_02_906fce50:
    "Я не хочу ранить чувства Минами."

# ch/minami/events.rpy:2910
translate russian minami_siscon_cap_02_41dbe049:
    "Так урок может закончиться ещё до начала!"

# ch/minami/events.rpy:2911
translate russian minami_siscon_cap_02_7c0d76ea:
    mike.say "Конечно нет, Минами. Не говори глупостей."

# ch/minami/events.rpy:2912
translate russian minami_siscon_cap_02_f8e74107:
    mike.say "Как такую милашку могут не пригласить на свидание?"

# ch/minami/events.rpy:2913
translate russian minami_siscon_cap_02_41d7ff79:
    "Я знаю, это откровенная лесть."

# ch/minami/events.rpy:2915
translate russian minami_siscon_cap_02_56a0cf89:
    "Но, как обычно, на неё действует."

# ch/minami/events.rpy:2917
translate russian minami_siscon_cap_02_79ba8e08:
    minami.say "Правда, братик?"

# ch/minami/events.rpy:2919
translate russian minami_siscon_cap_02_8b8c9227:
    mike.say "Правда, Минами."

# ch/minami/events.rpy:2920
translate russian minami_siscon_cap_02_23afcf00:
    mike.say "Слушай, если хочешь держать меня за руку — держи."

# ch/minami/events.rpy:2921
translate russian minami_siscon_cap_02_08cc53e6:
    "Минами улыбается и сжимает мою руку ещё крепче."

# ch/minami/events.rpy:2923
translate russian minami_siscon_cap_02_3bac5c12:
    "Мы неспешно идём по океанариуму, задерживаясь там, где что-нибудь привлекает внимание."

# ch/minami/events.rpy:2924
translate russian minami_siscon_cap_02_46a51cc2:
    "В разговоре вопросы Минами чередуются с моими советами."

# ch/minami/events.rpy:2925
translate russian minami_siscon_cap_02_20867ce7:
    "Но и сам океанариум показывает весьма впечатляющих обитателей."

# ch/minami/events.rpy:2926
translate russian minami_siscon_cap_02_dcd62fd6:
    "Не раз мы останавливаемся и с восхищением разглядываем то, что за стеклом."

# ch/minami/events.rpy:2928
translate russian minami_siscon_cap_02_77093469:
    minami.say "О-о, какие КРАСИВЫЕ рыбки!"

# ch/minami/events.rpy:2929
translate russian minami_siscon_cap_02_c9420ad1:
    minami.say "Разве не такие были в том мультике?"

# ch/minami/events.rpy:2930
translate russian minami_siscon_cap_02_73d7f43f:
    minami.say "Где другая рыба постоянно всё забывает?"

# ch/minami/events.rpy:2932
translate russian minami_siscon_cap_02_c51b7438:
    "Я невольно посмеиваюсь над тем, как Минами строчит вопросами."

# ch/minami/events.rpy:2934
translate russian minami_siscon_cap_02_6a958760:
    "Но от моего смеха она краснеет и смотрит с искренней тревогой."

# ch/minami/events.rpy:2936
translate russian minami_siscon_cap_02_2480e5c8:
    minami.say "Что такое, братик?"

# ch/minami/events.rpy:2937
translate russian minami_siscon_cap_02_00b12f7d:
    minami.say "Я что-то сделала не так?"

# ch/minami/events.rpy:2939
translate russian minami_siscon_cap_02_4612a82d:
    "Сначала я не знаю, как ответить."

# ch/minami/events.rpy:2940
translate russian minami_siscon_cap_02_2515f1ba:
    "Да, Минами может увлечься и слишком много болтать."

# ch/minami/events.rpy:2941
translate russian minami_siscon_cap_02_0b682b72:
    "Но это часть её характера, и я не хочу учить её подавлять себя."

# ch/minami/events.rpy:2942
translate russian minami_siscon_cap_02_116217d6:
    mike.say "Нет, Минами, всё нормально."

# ch/minami/events.rpy:2943
translate russian minami_siscon_cap_02_6c582fb3:
    mike.say "Но, может, высказывай одну мысль за раз, а не все сразу."

# ch/minami/events.rpy:2944
translate russian minami_siscon_cap_02_41f6fcb9:
    "Она серьёзно кивает, словно старается накрепко запомнить совет."

# ch/minami/events.rpy:2946
translate russian minami_siscon_cap_02_3fecb8a4:
    "Мы переходим к следующему аквариуму, гораздо большему, чем все предыдущие."

# ch/minami/events.rpy:2947
translate russian minami_siscon_cap_02_9a046516:
    "Буквально стоим перед стеклянной стеной и вглядываемся в чернильную глубину."

# ch/minami/events.rpy:2948
translate russian minami_siscon_cap_02_ecab2447:
    "Обитателей пока не видно, но водоросли и кораллы залиты таинственным, почти потусторонним светом."

# ch/minami/events.rpy:2950
translate russian minami_siscon_cap_02_73416f01:
    minami.say "Ух ты, там будто зачарованный подводный мир!"

# ch/minami/events.rpy:2952
translate russian minami_siscon_cap_02_a790fcd5:
    "Минами наклоняется ближе, почти прижимаясь носом к стеклу."

# ch/minami/events.rpy:2954
translate russian minami_siscon_cap_02_bbcd0a2f:
    minami.say "Знаешь, в детстве я всегда хотела быть русалкой."

# ch/minami/events.rpy:2955
translate russian minami_siscon_cap_02_253bb144:
    minami.say "И здесь мне снова этого захотелось."

# ch/minami/events.rpy:2956
translate russian minami_siscon_cap_02_04d4444f:
    minami.say "Можно сделать такой костюм для следующего косплея."

# ch/minami/events.rpy:2958
translate russian minami_siscon_cap_02_2f5b10da:
    "Она поворачивает голову и ловит мой взгляд."

# ch/minami/events.rpy:2960
translate russian minami_siscon_cap_02_e0cbc23b:
    minami.say "Как думаешь, братик?"

# ch/minami/events.rpy:2961
translate russian minami_siscon_cap_02_2256c9d8:
    minami.say "Мне пойдёт хвост?"

# ch/minami/events.rpy:2962
translate russian minami_siscon_cap_02_fcf44184:
    minami.say "Может, с подходящим лифчиком из ракушек?"

# ch/minami/events.rpy:2964
translate russian minami_siscon_cap_02_dd52b226:
    mike.say "Пожалуй, для первого свидания это слишком много подробностей, Минами!"

# ch/minami/events.rpy:2965
translate russian minami_siscon_cap_02_62653243:
    "В ответ на моё неодобрение Минами качает головой и снова поворачивается к аквариуму."

# ch/minami/events.rpy:2966
translate russian minami_siscon_cap_02_e746f136:
    "Но тут за стеклом что-то движется: из темноты выплывает тёмный силуэт."

# ch/minami/events.rpy:2967
translate russian minami_siscon_cap_02_83c014f2:
    "Я вижу акулу. Понятия не имею какого вида, но она чертовски огромная!"

# ch/minami/events.rpy:2968
translate russian minami_siscon_cap_02_e88c3993:
    "Даже я вздрагиваю, а Минами оказывается практически лицом к лицу с чудовищем."

# ch/minami/events.rpy:2970
translate russian minami_siscon_cap_02_af03ce5e:
    minami.say "А-А-А!"

# ch/minami/events.rpy:2971
translate russian minami_siscon_cap_02_08cda4a4:
    minami.say "БРАТИК, СПАСИ МЕНЯ!"

# ch/minami/events.rpy:2974
translate russian minami_siscon_cap_02_3e9e7805:
    "Минами отскакивает назад, отчаянно пытаясь оказаться как можно дальше от акулы."

# ch/minami/events.rpy:2975
translate russian minami_siscon_cap_02_e84ecde5:
    "В спешке она теряет равновесие."

# ch/minami/events.rpy:2980
translate russian minami_siscon_cap_02_018898f0:
    "И тяжело падает на задницу, снова испуганно вскрикнув."

# ch/minami/events.rpy:2981
translate russian minami_siscon_cap_02_692af8b1:
    "Я с усмешкой качаю головой и стучу костяшками по стеклу."

# ch/minami/events.rpy:2982
translate russian minami_siscon_cap_02_6b522023:
    mike.say "Думаю, стекло достаточно толстое, чтобы справиться вместо меня, Минами!"

# ch/minami/events.rpy:2983
translate russian minami_siscon_cap_02_b70580eb:
    minami.say "Не вредничай, братик."

# ch/minami/events.rpy:2984
translate russian minami_siscon_cap_02_4076772a:
    minami.say "Я правда испугалась, что она меня схватит!"

# ch/minami/events.rpy:2986
translate russian minami_siscon_cap_02_3a10cc95:
    "Я приседаю, чтобы помочь Минами подняться, всё ещё качая головой."

# ch/minami/events.rpy:2987
translate russian minami_siscon_cap_02_a0782e44:
    mike.say "Ну, не волнуйся, теперь ты в безопасности."

# ch/minami/events.rpy:2988
translate russian minami_siscon_cap_02_07d56f13:
    mike.say "И на заметку: на настоящем свидании так не делай!"

# ch/minami/events.rpy:2990
translate russian minami_siscon_cap_02_5645b33c:
    minami.say "Братик!"

# ch/minami/events.rpy:2991
translate russian minami_siscon_cap_02_8d9058e3:
    minami.say "Это НЕ смешно!"

# ch/minami/events.rpy:2993
translate russian minami_siscon_cap_02_2e73ba05:
    "Но, отряхиваясь, Минами неловко пожимает плечами."

# ch/minami/events.rpy:2994
translate russian minami_siscon_cap_02_facbae02:
    minami.say "Ладно, может, СОВСЕМ ЧУТЬ-ЧУТЬ смешно..."

# ch/minami/events.rpy:2995
translate russian minami_siscon_cap_02_35267b54:
    mike.say "Чувство юмора, Минами! Очень важное качество для будущего партнёра!"

# ch/minami/events.rpy:2996
translate russian minami_siscon_cap_02_c1fcada3:
    "Минами легонько бьёт меня по руке, и мы продолжаем прогулку по океанариуму."

# ch/minami/events.rpy:3001
translate russian minami_siscon_cap_02_3e9e7805_1:
    "Минами отскакивает назад, отчаянно пытаясь оказаться как можно дальше от акулы."

# ch/minami/events.rpy:3003
translate russian minami_siscon_cap_02_84d2d333:
    "Но поскольку она всё ещё держит меня за руку, то бросается прямо в мои объятия."

# ch/minami/events.rpy:3004
translate russian minami_siscon_cap_02_c61dbea7:
    "Минами отчаянно цепляется за меня, и я не успеваю опомниться, как реагирую на чистом инстинкте."

# ch/minami/events.rpy:3005
translate russian minami_siscon_cap_02_24f166b7:
    "Я крепко обнимаю её и прижимаю к груди."

# ch/minami/events.rpy:3006
translate russian minami_siscon_cap_02_9baee233:
    "Моя ладонь прижата к груди Минами, и я чувствую под ней изгиб небольшой груди."

# ch/minami/events.rpy:3007
translate russian minami_siscon_cap_02_8d2e48e9:
    "Её сердце буквально колотится в грудной клетке, как у испуганного зверька."

# ch/minami/events.rpy:3008
translate russian minami_siscon_cap_02_5505720d:
    mike.say "Тише, тише..."

# ch/minami/events.rpy:3009
translate russian minami_siscon_cap_02_13fa992f:
    mike.say "Всё хорошо, Минами, всё хорошо..."

# ch/minami/events.rpy:3010
translate russian minami_siscon_cap_02_85616330:
    "Она поднимает на меня глаза, всё ещё широко раскрытые от страха."

# ch/minami/events.rpy:3011
translate russian minami_siscon_cap_02_011a0a02:
    "Я не могу сдержать следующий порыв: желание защитить её слишком сильно."

# ch/minami/events.rpy:3012
translate russian minami_siscon_cap_02_79874e9e:
    "Поэтому притягиваю ещё ближе и чувствую, как её тело прижимается к моему."

# ch/minami/events.rpy:3014
translate russian minami_siscon_cap_02_e630fa77:
    "И, боже помоги, замечаю, насколько хорошо она ложится в мои объятия. Она моя младшая сестра — почему же мне так приятно её держать?"

# ch/minami/events.rpy:3016
translate russian minami_siscon_cap_02_c284c054:
    "На секунду моё нежелание отпускать её оказывается не совсем тем порывом, каким мне хотелось бы его считать. Но я говорю себе, что это просто инстинкт, и больше об этом не думаю."

# ch/minami/events.rpy:3018
translate russian minami_siscon_cap_02_d4ff2f19:
    minami.say "Эм, братик..."

# ch/minami/events.rpy:3020
translate russian minami_siscon_cap_02_110589ce:
    mike.say "Да, Минами?"

# ch/minami/events.rpy:3022
translate russian minami_siscon_cap_02_e6edb097:
    minami.say "Она ведь за стеклом, да?"

# ch/minami/events.rpy:3024
translate russian minami_siscon_cap_02_32267f1a:
    mike.say "Да, Минами, за стеклом."

# ch/minami/events.rpy:3027
translate russian minami_siscon_cap_02_ea23f012:
    "Минами отворачивается и на мгновение утыкается лицом мне в грудь."

# ch/minami/events.rpy:3029
translate russian minami_siscon_cap_02_4d2fa3f1:
    "Но затем неожиданно разражается смехом."

# ch/minami/events.rpy:3030
translate russian minami_siscon_cap_02_180ac692:
    minami.say "Ого, наверное, это выглядело очень глупо!"

# ch/minami/events.rpy:3031
translate russian minami_siscon_cap_02_323ebd0b:
    minami.say "Думаю, на настоящем свидании так делать не стоит?"

# ch/minami/events.rpy:3033
translate russian minami_siscon_cap_02_a30e0690:
    mike.say "Да, Минами, пожалуй, не стоит!"

# ch/minami/events.rpy:3034
translate russian minami_siscon_cap_02_fa5f3842:
    "Мы оба смеёмся, обмениваясь улыбками и смущёнными взглядами."

# ch/minami/events.rpy:3035
translate russian minami_siscon_cap_02_2b39f046:
    "Затем взгляд Минами останавливается на моей руке, всё ещё лежащей у неё на груди."

# ch/minami/events.rpy:3036
translate russian minami_siscon_cap_02_d138d613:
    mike.say "Ох, чёрт!"

# ch/minami/events.rpy:3037
translate russian minami_siscon_cap_02_9a4b068b:
    mike.say "Прости, Минами!"

# ch/minami/events.rpy:3039
translate russian minami_siscon_cap_02_3cf8e14c:
    minami.say "Всё нормально, братик. Ты просто хотел меня защитить..."

# ch/minami/events.rpy:3041
translate russian minami_siscon_cap_02_c9a1c27d:
    "Минами медленно берёт мою руку и снова сжимает её."

# ch/minami/events.rpy:3043
translate russian minami_siscon_cap_02_a396c1a1:
    minami.say "Пойдём дальше."

# ch/minami/events.rpy:3044
translate russian minami_siscon_cap_02_389fec78:
    minami.say "Уверена, тебе ещё много чего нужно мне рассказать."

# ch/minami/events.rpy:3046
translate russian minami_siscon_cap_02_6b9eac45:
    "Минами кладёт голову мне на плечо, и мы продолжаем гулять по океанариуму."

# ch/minami/events.rpy:3052
translate russian minami_siscon_cap_01_dad476a5:
    "Когда растёшь с человеком, узнаёшь его очень хорошо, вплоть до мелких причуд и привычек."

# ch/minami/events.rpy:3053
translate russian minami_siscon_cap_01_7fcce128:
    "Одни появляются и исчезают, а другие остаются и навсегда становятся частью характера."

# ch/minami/events.rpy:3054
translate russian minami_siscon_cap_01_8f047e38:
    "Минами не исключение: её причуд столько, что иногда мне кажется, я мог бы написать о них книгу."

# ch/minami/events.rpy:3055
translate russian minami_siscon_cap_01_5e3ec0a1:
    "Но одна из самых характерных — то, как она становится почти приторно-милой, когда ей что-нибудь нужно."

# ch/minami/events.rpy:3056
translate russian minami_siscon_cap_01_de47db57:
    "Поэтому, заметив, что большую часть дня Минами только любезничает и сыплет комплиментами, я начинаю настораживаться."

# ch/minami/events.rpy:3057
translate russian minami_siscon_cap_01_220d388d:
    "Понятия не имею, сколько это продлится, прежде чем она наконец прямо попросит желаемое."

# ch/minami/events.rpy:3058
translate russian minami_siscon_cap_01_8940b393:
    "Всё зависит от самой просьбы и от того, насколько бурную реакцию она ожидает."

# ch/minami/events.rpy:3059
translate russian minami_siscon_cap_01_14e87f14:
    "В такой ситуации у меня есть два варианта."

# ch/minami/events.rpy:3060
translate russian minami_siscon_cap_01_446d542c:
    "Первый — переждать и позволить Минами самой дойти до сути."

# ch/minami/events.rpy:3061
translate russian minami_siscon_cap_01_48e03ff9:
    "Второй — разоблачить её блеф и потребовать объяснений."

# ch/minami/events.rpy:3062
translate russian minami_siscon_cap_01_248c94e9:
    "Можете считать меня мазохистом, но я выбираю второй."

# ch/minami/events.rpy:3063
translate russian minami_siscon_cap_01_30a8a461:
    mike.say "Минами?"

# ch/minami/events.rpy:3065
translate russian minami_siscon_cap_01_01f73928:
    minami.say "Привет, братик."

# ch/minami/events.rpy:3067
translate russian minami_siscon_cap_01_0207579e:
    minami.say "Чем могу тебе помочь?"

# ch/minami/events.rpy:3069
translate russian minami_siscon_cap_01_b667017d:
    "Ого, от того, как она хлопает ресницами, у меня чуть ли не сахар в крови подскакивает!"

# ch/minami/events.rpy:3070
translate russian minami_siscon_cap_01_1f0578ca:
    mike.say "Хватит притворяться, Минами."

# ch/minami/events.rpy:3071
translate russian minami_siscon_cap_01_d0e961ef:
    mike.say "Я знаю, что ты делаешь."

# ch/minami/events.rpy:3072
translate russian minami_siscon_cap_01_3100bb47:
    mike.say "Чего тебе хочется?"

# ch/minami/events.rpy:3074
translate russian minami_siscon_cap_01_52fc347c:
    "Несколько секунд Минами изо всех сил изображает растерянность и лёгкую обиду."

# ch/minami/events.rpy:3075
translate russian minami_siscon_cap_01_74b6cf92:
    "Я не поддаюсь и продолжаю смотреть на неё с самым каменным выражением, на какое способен."

# ch/minami/events.rpy:3076
translate russian minami_siscon_cap_01_625dda74:
    "Вскоре она всё-таки сдаётся."

# ch/minami/events.rpy:3079
translate russian minami_siscon_cap_01_15d8efb2:
    "Минами издаёт обречённый стон."

# ch/minami/events.rpy:3081
translate russian minami_siscon_cap_01_991993cb:
    minami.say "У-у-у..."

# ch/minami/events.rpy:3082
translate russian minami_siscon_cap_01_9897c155:
    minami.say "Ладно, братик, ладно. Твоя взяла!"

# ch/minami/events.rpy:3084
translate russian minami_siscon_cap_01_72c3e973:
    minami.say "Я ДЕЙСТВИТЕЛЬНО хочу кое о чём тебя попросить."

# ch/minami/events.rpy:3085
translate russian minami_siscon_cap_01_51ae76f3:
    minami.say "Но милой я была только потому, что ты такой замечательный братик!"

# ch/minami/events.rpy:3087
translate russian minami_siscon_cap_01_c5fd4e68:
    mike.say "Как скажешь, Минами."

# ch/minami/events.rpy:3088
translate russian minami_siscon_cap_01_207b91cc:
    mike.say "Ну же, выкладывай."

# ch/minami/events.rpy:3089
translate russian minami_siscon_cap_01_6e92fddb:
    "Минами на мгновение собирается с мыслями, явно заряжая улыбку новой порцией обаяния."

# ch/minami/events.rpy:3090
translate russian minami_siscon_cap_01_b7736de7:
    "Я глубоко вдыхаю и жду, что она скажет."

# ch/minami/events.rpy:3091
translate russian minami_siscon_cap_01_e05cb23c:
    "Как ни пытаюсь, не могу представить, что это принесёт мне что-нибудь, кроме головной боли."

# ch/minami/events.rpy:3093
translate russian minami_siscon_cap_01_a880bc09:
    minami.say "Ну, братик."

# ch/minami/events.rpy:3094
translate russian minami_siscon_cap_01_817a75ad:
    minami.say "Ты, конечно, знаешь, что я приехала сюда учиться в колледже."

# ch/minami/events.rpy:3095
translate russian minami_siscon_cap_01_0b280d73:
    minami.say "Но колледж — это ведь не только учёба, правда?"

# ch/minami/events.rpy:3097
translate russian minami_siscon_cap_01_76ca4de4:
    "Я прищуриваюсь, пытаясь понять, к чему клонит Минами."

# ch/minami/events.rpy:3099
translate russian minami_siscon_cap_01_f612fdc2:
    minami.say "Это ведь ещё и университет жизни."

# ch/minami/events.rpy:3101
translate russian minami_siscon_cap_01_df60078e:
    mike.say "Университет жизни?"

# ch/minami/events.rpy:3103
translate russian minami_siscon_cap_01_2dab93d5:
    minami.say "Конечно, братик."

# ch/minami/events.rpy:3104
translate russian minami_siscon_cap_01_835398b5:
    minami.say "Ты же не только учишься?"

# ch/minami/events.rpy:3105
translate russian minami_siscon_cap_01_26ce916c:
    minami.say "Ещё ходишь в «Винчестер», в ночные клубы и всё такое."

# ch/minami/events.rpy:3107
translate russian minami_siscon_cap_01_f9d9529b:
    mike.say "Ну да..."

# ch/minami/events.rpy:3108
translate russian minami_siscon_cap_01_ba1f905a:
    mike.say "Нужно же как-то выпускать пар."

# ch/minami/events.rpy:3110
translate russian minami_siscon_cap_01_c8e37290:
    "Минами кивает, сразу ухватившись за это признание."

# ch/minami/events.rpy:3112
translate russian minami_siscon_cap_01_e8d4d704:
    minami.say "И у тебя бывают... девушки..."

# ch/minami/events.rpy:3114
translate russian minami_siscon_cap_01_dc9d4120:
    mike.say "Опять же, да..."

# ch/minami/events.rpy:3115
translate russian minami_siscon_cap_01_6560ab34:
    "Минами опускает взгляд на свои нервно сцепленные руки."

# ch/minami/events.rpy:3116
translate russian minami_siscon_cap_01_3607f501:
    "И впервые за весь разговор я не могу понять, играет она или нет."

# ch/minami/events.rpy:3118
translate russian minami_siscon_cap_01_ebfb277d:
    minami.say "Я... дома у меня ничего этого не было."

# ch/minami/events.rpy:3119
translate russian minami_siscon_cap_01_8dc354f0:
    minami.say "И мне страшно, потому что я не знаю, как..."

# ch/minami/events.rpy:3121
translate russian minami_siscon_cap_01_768fb914:
    "Вот и всё?"

# ch/minami/events.rpy:3122
translate russian minami_siscon_cap_01_5ed8bff2:
    "Она просто тревожится из-за того, что пора начинать ходить на свидания?"

# ch/minami/events.rpy:3123
translate russian minami_siscon_cap_01_86506d8d:
    mike.say "Этому нетрудно научиться, Минами."

# ch/minami/events.rpy:3124
translate russian minami_siscon_cap_01_e28176f4:
    mike.say "Уверен, ты быстро разберёшься."

# ch/minami/events.rpy:3126
translate russian minami_siscon_cap_01_2745741c:
    minami.say "А если нет?!"

# ch/minami/events.rpy:3127
translate russian minami_siscon_cap_01_4a7663d9:
    minami.say "Поэтому я и хотела спросить..."

# ch/minami/events.rpy:3129
translate russian minami_siscon_cap_01_4b868614:
    minami.say "Может, ты меня научишь?"

# ch/minami/events.rpy:3131
translate russian minami_siscon_cap_01_d71d9cc5:
    mike.say "И как именно мне это сделать, Минами?"

# ch/minami/events.rpy:3132
translate russian minami_siscon_cap_01_3ac3cd44:
    mike.say "Записать всё на бумаге, что ли?"

# ch/minami/events.rpy:3134
translate russian minami_siscon_cap_01_47b43a93:
    minami.say "Нет, не глупи, братик!"

# ch/minami/events.rpy:3135
translate russian minami_siscon_cap_01_af6f7858:
    minami.say "Я подумала, что ты мог бы ПОКАЗАТЬ."

# ch/minami/events.rpy:3136
translate russian minami_siscon_cap_01_ffa1f60a:
    minami.say "Будет как школа свиданий: я ученица, а ты учитель."

# ch/minami/events.rpy:3140
translate russian minami_siscon_cap_01_7f944a47:
    "До этого мне, возможно, казалось безумием так переживать из-за подобных вещей."

# ch/minami/events.rpy:3141
translate russian minami_siscon_cap_01_59e6bea4:
    "Но после этой идеи я почти уверен, что Минами рискует окончательно тронуться умом!"

# ch/minami/events.rpy:3142
translate russian minami_siscon_cap_01_0f68d053:
    mike.say "Минами, ради бога!"

# ch/minami/events.rpy:3143
translate russian minami_siscon_cap_01_9583fc51:
    mike.say "Ты СЛИШКОМ серьёзно к этому относишься."

# ch/minami/events.rpy:3144
translate russian minami_siscon_cap_01_2da4e19a:
    mike.say "В кино и по телевизору такого не говорят, но ты будешь ошибаться."

# ch/minami/events.rpy:3145
translate russian minami_siscon_cap_01_df95a96a:
    mike.say "Это просто часть свиданий, Минами."

# ch/minami/events.rpy:3146
translate russian minami_siscon_cap_01_46b7b26a:
    mike.say "Иногда получается, иногда нет."

# ch/minami/events.rpy:3149
translate russian minami_siscon_cap_01_c6707b25:
    minami.say "Но... если ты мне поможешь, братик..."

# ch/minami/events.rpy:3150
translate russian minami_siscon_cap_01_7697772c:
    minami.say "Тогда удач будет больше, правда?"

# ch/minami/events.rpy:3152
translate russian minami_siscon_cap_01_cd04c93f:
    "Я качаю головой, давая понять, что говорю серьёзно."

# ch/minami/events.rpy:3153
translate russian minami_siscon_cap_01_4d91ea97:
    mike.say "Поверь, Минами, я сам через это прошёл."

# ch/minami/events.rpy:3154
translate russian minami_siscon_cap_01_f5d631d9:
    mike.say "Именно воспоминания о неудачах делают победы такими сладкими."

# ch/minami/events.rpy:3156
translate russian minami_siscon_cap_01_430dfdf9:
    minami.say "Ну-у..."

# ch/minami/events.rpy:3157
translate russian minami_siscon_cap_01_da536a3b:
    minami.say "Нечестно, братик!"

# ch/minami/events.rpy:3159
translate russian minami_siscon_cap_01_97603071:
    "Минами скрещивает руки на груди."

# ch/minami/events.rpy:3160
translate russian minami_siscon_cap_01_d816d6e2:
    "По выражению её лица видно, что она собирается всерьёз надуться."

# ch/minami/events.rpy:3161
translate russian minami_siscon_cap_01_27cde098:
    mike.say "Прости, Минами."

# ch/minami/events.rpy:3162
translate russian minami_siscon_cap_01_bc6d9ab3:
    mike.say "Но никто не обещал, что жизнь справедлива."

# ch/minami/events.rpy:3163
translate russian minami_siscon_cap_01_d761272d:
    mike.say "А свиданий это касается вдвойне!"

# ch/minami/events.rpy:3167
translate russian minami_siscon_cap_01_721c428b:
    "Сначала идея кажется совершенно безумной, но потом я начинаю обдумывать её внимательнее."

# ch/minami/events.rpy:3168
translate russian minami_siscon_cap_01_3761a3eb:
    "Я бы и сам хотел заранее знать о ловушках, в которые попадал на первых настоящих свиданиях."

# ch/minami/events.rpy:3169
translate russian minami_siscon_cap_01_9dd99a9f:
    "Да и я ведь всего лишь покажу Минами, что к чему."

# ch/minami/events.rpy:3170
translate russian minami_siscon_cap_01_3c2c5a58:
    "Это может быть как забавная нарезка из фильма, где неуклюжую девушку учат стать королевой выпускного!"

# ch/minami/events.rpy:3171
translate russian minami_siscon_cap_01_3151836b:
    "Ну, может, не так грандиозно."

# ch/minami/events.rpy:3172
translate russian minami_siscon_cap_01_a727027b:
    "Скорее, научу Минами не жевать с открытым ртом и не вытираться скатертью вместо салфетки."

# ch/minami/events.rpy:3176
translate russian minami_siscon_cap_01_67065625:
    mike.say "Знаешь, Минами, это и правда звучит довольно весело."

# ch/minami/events.rpy:3177
translate russian minami_siscon_cap_01_68fbc286:
    mike.say "Но помни: я могу научить только тому, что знаю сам."

# ch/minami/events.rpy:3178
translate russian minami_siscon_cap_01_db93e5e4:
    mike.say "Я не какой-нибудь современный Казанова!"

# ch/minami/events.rpy:3180
translate russian minami_siscon_cap_01_56ea57e5:
    "Минами уже улыбается во весь рот, радуясь, что добилась своего."

# ch/minami/events.rpy:3182
translate russian minami_siscon_cap_01_bfd42005:
    minami.say "Да перестань, братик."

# ch/minami/events.rpy:3183
translate russian minami_siscon_cap_01_cf943845:
    minami.say "Вот теперь ты ТОЧНО говоришь глупости!"

# ch/minami/events.rpy:3184
translate russian minami_siscon_cap_01_3061604b:
    minami.say "Дома ты постоянно бегал на свидания."

# ch/minami/events.rpy:3186
translate russian minami_siscon_cap_01_ae350dfa:
    mike.say "Ну, я бы так не сказал..."

# ch/minami/events.rpy:3188
translate russian minami_siscon_cap_01_d3bf185e:
    minami.say "А я всегда смотрела на тебя со всеми этими девушками."

# ch/minami/events.rpy:3189
translate russian minami_siscon_cap_01_718415ea:
    minami.say "И ТАК завидовала."

# ch/minami/events.rpy:3190
translate russian minami_siscon_cap_01_9dc91036:
    minami.say "Думала, как им повезло с таким замечательным парнем, как ты!"

# ch/minami/events.rpy:3191
translate russian minami_siscon_cap_01_762f8e06:
    minami.say "Поэтому я и знаю, что ты будешь прекрасным учителем."

# ch/minami/events.rpy:3193
translate russian minami_siscon_cap_01_bea6d532:
    "Я пытаюсь остановить Минами, пока от похвал моя голова не раздулась настолько, что не пройдёт в дверь."

# ch/minami/events.rpy:3194
translate russian minami_siscon_cap_01_883cd3e4:
    mike.say "А, ладно... да..."

# ch/minami/events.rpy:3195
translate russian minami_siscon_cap_01_ced8c280:
    mike.say "Начнём с чего-нибудь простого. Например, с тренировочного свидания!"

# ch/minami/events.rpy:3200
translate russian minami_siscon_10_c339b7e3:
    "На вечер у меня не было особых планов: я просто устал слоняться по дому."

# ch/minami/events.rpy:3201
translate russian minami_siscon_10_91ee9860:
    "Так что выйти куда-нибудь казалось очевидным решением: сменить обстановку, взбодриться и поднять настроение."

# ch/minami/events.rpy:3202
translate russian minami_siscon_10_ff31c191:
    "Когда я собираюсь уходить, рядом никого нет, так что звать некого. Я просто хватаю куртку и выхожу."

# ch/minami/events.rpy:3203
translate russian minami_siscon_10_019ab44c:
    "Приятно действовать по внезапному желанию и смотреть, куда заведёт чутьё."

# ch/minami/events.rpy:3204
translate russian minami_siscon_10_cd363363:
    "Я иду к центру, минуя знакомые пабы, а затем и более дорогие бары."

# ch/minami/events.rpy:3205
translate russian minami_siscon_10_f36e0752:
    "В конце концов оказываюсь перед клубом, который всегда был одним из моих любимых мест для ночных походов."

# ch/minami/events.rpy:3206
translate russian minami_siscon_10_29b3cc3e:
    "Встаю в конец очереди, рассудив, что внутри вполне могу встретить знакомых."

# ch/minami/events.rpy:3207
translate russian minami_siscon_10_22e5cb02:
    "Миновав вышибал у входа и смешавшись с толпой, я убеждаюсь, что решение было верным."

# ch/minami/events.rpy:3208
translate russian minami_siscon_10_48e46921:
    "Здесь я чувствую полную свободу делать всё, что захочу: танцевать, пить или заниматься чем угодно ещё в рамках закона."

# ch/minami/events.rpy:3209
translate russian minami_siscon_10_361533e9:
    "Обычно я прихожу с кем-нибудь и стараюсь сначала угодить спутнику, а потом уже себе."

# ch/minami/events.rpy:3210
translate russian minami_siscon_10_60b09e8f:
    "Теперь же могу танцевать под любимую музыку и оставаться сколько вздумается."

# ch/minami/events.rpy:3211
translate russian minami_siscon_10_47504b3c:
    "Взяв напиток в баре, я какое-то время держусь у края танцпола."

# ch/minami/events.rpy:3212
translate russian minami_siscon_10_894416bd:
    "Не собираюсь с духом, а просто наслаждаюсь возможностью выбрать подходящий момент."

# ch/minami/events.rpy:3213
translate russian minami_siscon_10_c0bfa081:
    "Кажется, мне везёт: как раз когда я допиваю, ставят мою давнюю любимую песню."

# ch/minami/events.rpy:3214
translate russian minami_siscon_10_c00fa21a:
    "И на танцполе освобождается идеальное место — словно так и задумано."

# ch/minami/events.rpy:3215
translate russian minami_siscon_10_285db8b3:
    "Мгновение спустя я уже танцую, не заботясь ни о чём на свете."

# ch/minami/events.rpy:3216
translate russian minami_siscon_10_0162a4a3:
    "Хандра, из-за которой я ушёл из дома, теперь кажется далёким воспоминанием."

# ch/minami/events.rpy:3217
translate russian minami_siscon_10_29954ab4:
    "Вместо этого я чувствую, что могу покорить весь мир!"

# ch/minami/events.rpy:3218
translate russian minami_siscon_10_210edc3c:
    "И, должно быть, от меня действительно исходит такой же позитив."

# ch/minami/events.rpy:3219
translate russian minami_siscon_10_b107532c:
    "Потому что вскоре на танцполе у меня появляется компания!"

# ch/minami/events.rpy:3220
translate russian minami_siscon_10_cbf97475:
    "Опускаю глаза и вижу милую миниатюрную девушку в коротком топе и клетчатой юбке: она танцует совсем близко."

# ch/minami/events.rpy:3221
translate russian minami_siscon_10_1c61aaff:
    "Конечно, я не ищу ничего серьёзного."

# ch/minami/events.rpy:3222
translate russian minami_siscon_10_3e6d6245:
    "Но немного флирта на танцполе ещё никому не вредило..."

# ch/minami/events.rpy:3223
translate russian minami_siscon_10_2a5586ab:
    "Поэтому я придвигаюсь к таинственной девушке."

# ch/minami/events.rpy:3224
translate russian minami_siscon_10_29f11be6:
    "Она отвечает на мой интерес, прижимаясь так, что я чувствую её попку у своего паха!"

# ch/minami/events.rpy:3225
translate russian minami_siscon_10_144678d9:
    "Ого, я ей и правда нравлюсь!"

# ch/minami/events.rpy:3226
translate russian minami_siscon_10_0b2281b6:
    "Испытывая то же самое, я наклоняюсь вперёд."

# ch/minami/events.rpy:3227
translate russian minami_siscon_10_5e224a96:
    "Ведь её лицо я ещё толком не разглядел."

# ch/minami/events.rpy:3229
translate russian minami_siscon_10_6ce3839c:
    minami.say "Привет, братик."

# ch/minami/events.rpy:3230
translate russian minami_siscon_10_320e4536:
    minami.say "Ты танцуешь гораздо лучше, чем я ожидала!"

# ch/minami/events.rpy:3233
translate russian minami_siscon_10_6a660d71:
    mike.say "А... ЧТО... МИНАМИ?!"

# ch/minami/events.rpy:3238
translate russian minami_siscon_10_9b568973:
    "Несмотря на тесноту танцпола, я всё равно отскакиваю от Минами."

# ch/minami/events.rpy:3239
translate russian minami_siscon_10_f1ca85c4:
    "Все чувства, которые я испытывал мгновение назад, тут же испаряются."

# ch/minami/events.rpy:3240
translate russian minami_siscon_10_5b80a48b:
    "На их место приходят потрясение и подкрадывающийся ужас от случившегося."

# ch/minami/events.rpy:3242
translate russian minami_siscon_10_86d7b667:
    minami.say "Что такое, братик?"

# ch/minami/events.rpy:3243
translate russian minami_siscon_10_94c5b077:
    minami.say "Я задела что-нибудь больное?"

# ch/minami/events.rpy:3245
translate russian minami_siscon_10_7a73e009:
    "Даже после такой моей реакции Минами, кажется, всё ещё не понимает причины."

# ch/minami/events.rpy:3246
translate russian minami_siscon_10_b823fab7:
    "Я качаю головой и спешу прочь с танцпола, чувствуя тошноту от случившегося."

# ch/minami/events.rpy:3248
translate russian minami_siscon_10_c4f6f945:
    "Минами торопится следом, будто боится, что мне стало плохо."

# ch/minami/events.rpy:3250
translate russian minami_siscon_10_d2b99ad5:
    minami.say "Скажи, в чём дело, братик!"

# ch/minami/events.rpy:3251
translate russian minami_siscon_10_c6edc7ab:
    minami.say "Ты меня уже по-настоящему пугаешь!"

# ch/minami/events.rpy:3253
translate russian minami_siscon_10_6aff5d54:
    "Наконец я привожу мысли в порядок настолько, чтобы обернуться к ней."

# ch/minami/events.rpy:3254
translate russian minami_siscon_10_6c5620f3:
    mike.say "Минами, о чём ты там думала?"

# ch/minami/events.rpy:3255
translate russian minami_siscon_10_f131984d:
    mike.say "Я твой брат! Нельзя со мной... ТАК!"

# ch/minami/events.rpy:3257
translate russian minami_siscon_10_164e8a01:
    "Облегчение, появившееся на лице Минами, когда я заговорил, тут же исчезает."

# ch/minami/events.rpy:3258
translate russian minami_siscon_10_880cc510:
    "Вместо него — одна из её невинных и одновременно раздражающих улыбок."

# ch/minami/events.rpy:3260
translate russian minami_siscon_10_af344b06:
    minami.say "Ну, не будь таким ханжой, братик."

# ch/minami/events.rpy:3261
translate russian minami_siscon_10_74dd0cc8:
    minami.say "Разве в таких местах не принято так танцевать?"

# ch/minami/events.rpy:3263
translate russian minami_siscon_10_7663538b:
    mike.say "Ну... да, наверное."

# ch/minami/events.rpy:3264
translate russian minami_siscon_10_e9f4ad56:
    mike.say "Но не с младшими сёстрами!"

# ch/minami/events.rpy:3266
translate russian minami_siscon_10_b1c892ca:
    minami.say "Да ладно, мы оба знаем, что это просто развлечение."

# ch/minami/events.rpy:3267
translate russian minami_siscon_10_2d21e5c1:
    minami.say "И обещаю: если ты никому не скажешь, что я твоя сестра..."

# ch/minami/events.rpy:3268
translate russian minami_siscon_10_9b4dafb8:
    minami.say "То и я никому не скажу, что ты мой брат!"

# ch/minami/events.rpy:3270
translate russian minami_siscon_10_ccc88998:
    "С этими словами она вприпрыжку возвращается на танцпол."

# ch/minami/events.rpy:3271
translate russian minami_siscon_10_67fda611:
    "Мне остаётся лишь стоять и смотреть."

# ch/minami/events.rpy:3272
translate russian minami_siscon_10_9edb2c62:
    "И гадать, что случилось с моей невинной младшей сестрёнкой..."

# ch/minami/events.rpy:3276
translate russian minami_siscon_10_18b26a0e:
    "Как бы ни было тесно на танцполе, первым порывом становится желание отскочить от Минами."

# ch/minami/events.rpy:3277
translate russian minami_siscon_10_fd707584:
    "Но её улыбка и хихиканье в ответ на мою реакцию заставляют меня остановиться."

# ch/minami/events.rpy:3278
translate russian minami_siscon_10_a8249d12:
    "Когда я стал таким ханжой, что перестал видеть смешное?"

# ch/minami/events.rpy:3279
translate russian minami_siscon_10_76ddb53a:
    "Конечно, так разыгрывать меня с её стороны немного возмутительно."

# ch/minami/events.rpy:3280
translate russian minami_siscon_10_ba130db9:
    "Но разве это не отличный шанс показать, что я тоже ещё способен на дерзости?"

# ch/minami/events.rpy:3282
translate russian minami_siscon_10_86d7b667_1:
    minami.say "Что такое, братик?"

# ch/minami/events.rpy:3283
translate russian minami_siscon_10_94c5b077_1:
    minami.say "Я задела что-нибудь больное?"

# ch/minami/events.rpy:3286
translate russian minami_siscon_10_b653d976:
    "Я кладу руки Минами на талию и притягиваю чуть ближе."

# ch/minami/events.rpy:3287
translate russian minami_siscon_10_aa8fb04b:
    "Затем шепчу ей на ухо."

# ch/minami/events.rpy:3288
translate russian minami_siscon_10_abb0ec74:
    mike.say "Как тут не задеть?"

# ch/minami/events.rpy:3289
translate russian minami_siscon_10_562b2db8:
    mike.say "Когда у меня такой большой..."

# ch/minami/events.rpy:3291
translate russian minami_siscon_10_f8446ec3:
    "Потрясение на лице Минами — уже более чем достаточная расплата за её выходку."

# ch/minami/events.rpy:3292
translate russian minami_siscon_10_99809841:
    "А сменившее его скандально-довольное выражение ещё лучше."

# ch/minami/events.rpy:3294
translate russian minami_siscon_10_fc64357e:
    minami.say "Я знала, что не зря называю тебя БОЛЬШИМ братиком!"

# ch/minami/events.rpy:3296
translate russian minami_siscon_10_e7dd8aa9:
    "Я понимаю, что не стоит, но всё равно смеюсь над ужасной шуткой Минами."

# ch/minami/events.rpy:3297
translate russian minami_siscon_10_990c43c3:
    "Из-за этого я теряю бдительность, пока мы продолжаем танцевать вместе."

# ch/minami/events.rpy:3298
translate russian minami_siscon_10_7905bb6a:
    "И оказываюсь совершенно не готов к тому, что происходит дальше."

# ch/minami/events.rpy:3299
translate russian minami_siscon_10_a6e7a720:
    "Клянусь, я не знаю, случайно ли это."

# ch/minami/events.rpy:3300
translate russian minami_siscon_10_9b55b8f8:
    "Или Минами как-то намеренно приподнимает свою опасно короткую юбку."

# ch/minami/events.rpy:3301
translate russian minami_siscon_10_a1dfb4e1:
    "Но в любом случае результат один."

# ch/minami/events.rpy:3302
translate russian minami_siscon_10_3d5c2bd4:
    "Я снова чувствую, как упругие ягодицы прижимаются к моему паху."

# ch/minami/events.rpy:3303
translate russian minami_siscon_10_65eef44a:
    "На этот раз они трутся о мой уже до боли твёрдый член."

# ch/minami/events.rpy:3304
translate russian minami_siscon_10_6d3492fa:
    "Даже сквозь грохочущую музыку я слышу внезапный возглас Минами."

# ch/minami/events.rpy:3305
translate russian minami_siscon_10_cfaacf80:
    "Но он словно растворяется, переходя в более мягкий и чувственный звук."

# ch/minami/events.rpy:3307
translate russian minami_siscon_10_9e680d55:
    minami.say "Ох, братик..."

# ch/minami/events.rpy:3308
translate russian minami_siscon_10_318fc5d1:
    minami.say "Какой же ты большой..."

# ch/minami/events.rpy:3309
translate russian minami_siscon_10_89861436:
    minami.say "Это так..."

# ch/minami/events.rpy:3311
translate russian minami_siscon_10_f2060ed9:
    mike.say "А, что ты сказала, Минами?"

# ch/minami/events.rpy:3312
translate russian minami_siscon_10_d1d35add:
    mike.say "Не расслышал из-за музыки."

# ch/minami/events.rpy:3313
translate russian minami_siscon_10_aa9b44a4:
    "Говоря это, я поспешно стаскиваю Минами с танцпола в другую часть клуба."

# ch/minami/events.rpy:3314
translate russian minami_siscon_10_418dee2a:
    "Пусть отговорка и жалкая, я не хочу знать, куда всё шло!"

# ch/minami/events.rpy:3316
translate russian minami_siscon_10_cc87c97f:
    "Кого я обманываю? Я прекрасно знаю, куда всё шло, и часть меня хотела этого. Я так хочу чувствовать её тело рядом, что полный клуб едва меня остановил."

# ch/minami/events.rpy:3318
translate russian minami_siscon_10_3e65cc2d:
    "Я увожу её, потому что не доверяю себе. Всё просто. Это женщина, трущаяся о меня в темноте, и я хочу её слишком сильно для брата."

# ch/minami/events.rpy:3325
translate russian minami_siscon_09_b1187795:
    "Я совершенно невинно иду через коридор к своей комнате, когда слышу, что меня зовут."

# ch/minami/events.rpy:3326
translate russian minami_siscon_09_01f73928:
    minami.say "Привет, братик."

# ch/minami/events.rpy:3327
translate russian minami_siscon_09_2ebae239:
    minami.say "Иди сюда, я хочу тебе кое-что показать!"

# ch/minami/events.rpy:3329
translate russian minami_siscon_09_7532c46e:
    "Оборачиваюсь и вижу Минами: она почти подпрыгивает на месте, словно заводная игрушка."

# ch/minami/events.rpy:3330
translate russian minami_siscon_09_96dac77c:
    "Заинтригованный, я подхожу, готовый уделить младшей сестре минутку."

# ch/minami/events.rpy:3331
translate russian minami_siscon_09_b6d8bd6a:
    mike.say "Минами, что случилось?"

# ch/minami/events.rpy:3332
translate russian minami_siscon_09_4a7f58aa:
    mike.say "Ты будто сладкого объелась!"

# ch/minami/events.rpy:3333
translate russian minami_siscon_09_8dc7c0e4:
    "Минами дарит мне одну из своих фирменных милых улыбок."

# ch/minami/events.rpy:3334
translate russian minami_siscon_09_dee26342:
    "Склонив голову набок, она манит меня поближе."

# ch/minami/events.rpy:3335
translate russian minami_siscon_09_f1fdbf37:
    "Не понимаю, зачем такая секретность, но всё же решаю подыграть."

# ch/minami/events.rpy:3338
translate russian minami_siscon_09_fedc46a0:
    "Как только я подхожу достаточно близко, чтобы нас не услышали, Минами наклоняется ещё ближе."

# ch/minami/events.rpy:3340
translate russian minami_siscon_09_21b77a21:
    minami.say "Помнишь, как ты раньше увлекался косплеем, братик?"

# ch/minami/events.rpy:3342
translate russian minami_siscon_09_7fb018a3:
    "Она говорит так, будто я был заядлым косплеером, хотя на деле лишь немного пробовал."

# ch/minami/events.rpy:3343
translate russian minami_siscon_09_6ed05df3:
    "Большинство моих костюмов были простенькими, а на фестивалях я побывал всего пару раз."

# ch/minami/events.rpy:3344
translate russian minami_siscon_09_a2f7d0d3:
    mike.say "Ну да, было дело."

# ch/minami/events.rpy:3346
translate russian minami_siscon_09_659e62ca:
    minami.say "Так вот, после твоего отъезда я тоже увлеклась."

# ch/minami/events.rpy:3347
translate russian minami_siscon_09_2e38a607:
    minami.say "Можно сказать, ты вдохновил меня пойти по твоим стопам."

# ch/minami/events.rpy:3349
translate russian minami_siscon_09_c312d339:
    "Да, я понимаю, звучит как клише."

# ch/minami/events.rpy:3350
translate russian minami_siscon_09_b651314f:
    "Жизнерадостная миниатюрная азиатка, которая любит наряжаться героями любимой манги и аниме."

# ch/minami/events.rpy:3351
translate russian minami_siscon_09_979f0ab7:
    "Но Минами всегда была талантлива во всём, что касается творчества."

# ch/minami/events.rpy:3352
translate russian minami_siscon_09_5e1888a7:
    "И в свои увлечения она погружается с головой, ничего не делая без усердия и страсти."

# ch/minami/events.rpy:3353
translate russian minami_siscon_09_647148b3:
    "Так что, наверное, удивляться такому её хобби не стоит."

# ch/minami/events.rpy:3354
translate russian minami_siscon_09_e57e1e46:
    mike.say "Это очень здорово, Минами."

# ch/minami/events.rpy:3355
translate russian minami_siscon_09_6e67f47e:
    mike.say "Но я-то никогда особенно в этом не преуспевал!"

# ch/minami/events.rpy:3356
translate russian minami_siscon_09_69b2cebb:
    mike.say "Уверен, ты гораздо лучше меня."

# ch/minami/events.rpy:3359
translate russian minami_siscon_09_40fbd641:
    "Глаза Минами гордо блестят от комплимента, и улыбка становится ещё шире."

# ch/minami/events.rpy:3360
translate russian minami_siscon_09_5f55dedc:
    "Клянусь, пока я смотрю на неё, грудь у неё тоже поднимается от гордости."

# ch/minami/events.rpy:3361
translate russian minami_siscon_09_16be673a:
    "Вдруг она протягивает руки и обеими хватает меня за запястье."

# ch/minami/events.rpy:3363
translate russian minami_siscon_09_f22fd69d:
    minami.say "Ты ОБЯЗАН пойти со мной, братик."

# ch/minami/events.rpy:3364
translate russian minami_siscon_09_babb3120:
    minami.say "Я привезла несколько своих костюмов."

# ch/minami/events.rpy:3365
translate russian minami_siscon_09_c7a50c30:
    minami.say "Ты просто обалдеешь, когда увидишь меня в них!"

# ch/minami/events.rpy:3369
translate russian minami_siscon_09_cf656cef:
    "Всё началось с того, что Минами рассказала о своём хобби и получила комплименты."

# ch/minami/events.rpy:3370
translate russian minami_siscon_09_5e04276d:
    "Но вдруг она, кажется, ужасно возбуждается от этой темы и даже начинает суетиться."

# ch/minami/events.rpy:3371
translate russian minami_siscon_09_da6304eb:
    "Я знаю, какой взбудораженной бывает Минами, когда увлечена чем-то настолько сильно."

# ch/minami/events.rpy:3372
translate russian minami_siscon_09_2ee63c0c:
    "И не хочу поощрять занятия, из-за которых она будет сидеть взаперти."

# ch/minami/events.rpy:3373
translate russian minami_siscon_09_2d9e729b:
    "Лучше бы ей выходить, общаться в колледже и обзавестись собственной жизнью."

# ch/minami/events.rpy:3374
translate russian minami_siscon_09_b8064c1c:
    mike.say "Нет, спасибо, Минами."

# ch/minami/events.rpy:3375
translate russian minami_siscon_09_94386539:
    mike.say "Я бы с удовольствием посмотрел, что ты придумала. Правда."

# ch/minami/events.rpy:3376
translate russian minami_siscon_09_bcd14eb3:
    mike.say "Но мне ужасно нужно подтянуть учёбу."

# ch/minami/events.rpy:3378
translate russian minami_siscon_09_62c0a80e:
    "Минами тут же сникает и почти начинает дуться."

# ch/minami/events.rpy:3380
translate russian minami_siscon_09_e1d189c7:
    minami.say "Но... но..."

# ch/minami/events.rpy:3382
translate russian minami_siscon_09_0d5ee143:
    mike.say "Кстати, хотел спросить: как у тебя с учёбой?"

# ch/minami/events.rpy:3383
translate russian minami_siscon_09_7228f46f:
    mike.say "Помню, на первом курсе я был ужасно занят."

# ch/minami/events.rpy:3384
translate russian minami_siscon_09_aae595c0:
    mike.say "На увлечения почти не оставалось времени!"

# ch/minami/events.rpy:3385
translate russian minami_siscon_09_3b4596d3:
    mike.say "Да, неприятно. Но если хочешь хорошие оценки, придётся потрудиться."

# ch/minami/events.rpy:3386
translate russian minami_siscon_09_9f7a744e:
    "Теперь она смотрит себе под ноги, а я начинаю чувствовать, что раздавил её юношеский задор."

# ch/minami/events.rpy:3388
translate russian minami_siscon_09_50816b1c:
    minami.say "Н... наверное, ты прав, братик."

# ch/minami/events.rpy:3389
translate russian minami_siscon_09_016ec5f8:
    minami.say "Я всё откладывала учебники на потом."

# ch/minami/events.rpy:3390
translate russian minami_siscon_09_acadc174:
    minami.say "Может, сегодня стоит немного позаниматься?"

# ch/minami/events.rpy:3392
translate russian minami_siscon_09_59ba5495:
    "Моя ответная улыбка искреннее, чем можно подумать."

# ch/minami/events.rpy:3393
translate russian minami_siscon_09_fd9b7ec1:
    "Потому что, вопреки всем свидетельствам обратного, при необходимости я могу вести себя как настоящий взрослый."

# ch/minami/events.rpy:3394
translate russian minami_siscon_09_0acc66a5:
    mike.say "Удачи, Минами!"

# ch/minami/events.rpy:3395
translate russian minami_siscon_09_7700745c:
    "Я показываю ей поднятый большой палец, пока она уныло направляется по лестнице на чердак."

# ch/minami/events.rpy:3397
translate russian minami_siscon_09_6f07ea16:
    "И, глядя ей вслед, лишь немного чувствую, что превращаюсь в настоящего старика."

# ch/minami/events.rpy:3399
translate russian minami_siscon_09_879887c6:
    "Пожалуй, сейчас мне нужно быть для Минами кем-то большим, чем соседом и надзирателем."

# ch/minami/events.rpy:3400
translate russian minami_siscon_09_394a1840:
    "В конце концов, она не робот: творчество не менее важно, чем успехи в колледже."

# ch/minami/events.rpy:3401
translate russian minami_siscon_09_7f15ab0e:
    "К тому же ей явно очень нужно моё одобрение, а увлеклась она этим, глядя на меня."

# ch/minami/events.rpy:3402
translate russian minami_siscon_09_80164ce0:
    "Наверное, мне должно льстить, что она не считает мои старые увлечения отстоем."

# ch/minami/events.rpy:3403
translate russian minami_siscon_09_f8c65517:
    mike.say "Ладно, Минами."

# ch/minami/events.rpy:3404
translate russian minami_siscon_09_29d23292:
    mike.say "Я собирался сесть за учебники."

# ch/minami/events.rpy:3405
translate russian minami_siscon_09_15f65d36:
    mike.say "Но, думаю, пару минут для тебя найду."

# ch/minami/events.rpy:3406
translate russian minami_siscon_09_7060017a:
    "Минами пронзительно визжит от восторга и тут же начинает тащить меня по лестнице на чердак."

# ch/minami/events.rpy:3408
translate russian minami_siscon_09_8081a915:
    "Едва мы оказываемся в её комнате, Минами захлопывает дверь и запирает её."

# ch/minami/events.rpy:3410
translate russian minami_siscon_09_c284dca7:
    "Убедившись, что никто не помешает, она довольно грубо усаживает меня на кровать."

# ch/minami/events.rpy:3412
translate russian minami_siscon_09_7b773158:
    minami.say "Жди здесь, братик."

# ch/minami/events.rpy:3413
translate russian minami_siscon_09_971273b0:
    minami.say "Тебе ОЧЕНЬ понравится, обещаю!"

# ch/minami/events.rpy:3415
translate russian minami_siscon_09_0a2a8556:
    "Я могу лишь кивнуть и смотреть, как Минами спешит за ширму, отгораживающую угол комнаты."

# ch/minami/events.rpy:3416
translate russian minami_siscon_09_aaad839d:
    "Оттуда слышно, как она поспешно раздевается, а затем вокруг начинает летать одежда."

# ch/minami/events.rpy:3417
translate russian minami_siscon_09_2289e00c:
    "Каждая вещь, которая только что была на Минами, перелетает через ширму."

# ch/minami/events.rpy:3418
translate russian minami_siscon_09_a093b307:
    "Всё нормально, пока я не замечаю, что её лифчик и трусики приземлились рядом со мной на кровати."

# ch/minami/events.rpy:3419
translate russian minami_siscon_09_b3357290:
    "Первым порывом хочется отбросить их подальше."

# ch/minami/events.rpy:3420
translate russian minami_siscon_09_866c2285:
    "Но тут я понимаю: для этого придётся прикоснуться к белью младшей сестры!"

# ch/minami/events.rpy:3421
translate russian minami_siscon_09_1996f43b:
    "Прежде чем я решаю, что хуже, Минами снова окликает меня."

# ch/minami/events.rpy:3423
translate russian minami_siscon_09_437e7873:
    minami.say "Посмотри на меня, братик!"

# ch/minami/events.rpy:3424
translate russian minami_siscon_09_200d4e35:
    minami.say "Как тебе этот наряд?"

# ch/minami/events.rpy:3426
translate russian minami_siscon_09_bb85de83:
    "Я резко поднимаю голову, прекратив попытки отодвинуться от белья Минами."

# ch/minami/events.rpy:3428
translate russian minami_siscon_09_96b7953a:
    "Но стоит увидеть, во что она одета, как я забываю обо всём остальном."

# ch/minami/events.rpy:3430
translate russian minami_siscon_09_03920998:
    minami.say "Неплохо, да?"

# ch/minami/events.rpy:3432
translate russian minami_siscon_09_63161fed:
    "Минами кружится на месте, показывая надетую на неё японскую школьную форму."

# ch/minami/events.rpy:3433
translate russian minami_siscon_09_70b057ce:
    "В ней собраны все клише, какие только приходят мне в голову, и, наверное, ещё несколько десятков, неизвестных за пределами Японии!"

# ch/minami/events.rpy:3434
translate russian minami_siscon_09_276d6d8b:
    "К тому же от её вращения невероятно короткая юбка задирается."

# ch/minami/events.rpy:3435
translate russian minami_siscon_09_ffe526c2:
    "Так что мне видны и опасно крошечные трусики под ней."

# ch/minami/events.rpy:3436
translate russian minami_siscon_09_6ede61d4:
    "Минами перестаёт кружиться и наклоняется вперёд, опираясь рукой на колено."

# ch/minami/events.rpy:3438
translate russian minami_siscon_09_bc5772fc:
    minami.say "Знаю, с этого ракурса выглядит хорошо."

# ch/minami/events.rpy:3440
translate russian minami_siscon_09_4f24fc11:
    "Затем поворачивается ко мне спиной и начинает вилять попкой в паре сантиметров от моего лица."

# ch/minami/events.rpy:3442
translate russian minami_siscon_09_8574e4a9:
    minami.say "Но с этого ещё лучше!"

# ch/minami/events.rpy:3443
translate russian minami_siscon_09_536462b9:
    minami.say "Правда, братик?"

# ch/minami/events.rpy:3444
translate russian minami_siscon_09_58d3ca0b:
    "Я несколько раз моргаю, прежде чем ко мне возвращается дар речи."

# ch/minami/events.rpy:3445
translate russian minami_siscon_09_3c402a1a:
    mike.say "Честно, Минами... трудно подобрать достойные слова..."

# ch/minami/events.rpy:3447
translate russian minami_siscon_09_178b7e42:
    "Минами радостно подпрыгивает, устроив мне ещё одно впечатляющее представление с совсем близкого расстояния."

# ch/minami/events.rpy:3449
translate russian minami_siscon_09_3306b5e7:
    "Я даже не пытаюсь скрыть улыбку. Она выставляет своё тело напоказ, а я жадно разглядываю каждый сантиметр, уже представляя, что под короткой юбкой."

# ch/minami/events.rpy:3451
translate russian minami_siscon_09_750def3c:
    "Я перестал притворяться, что просто поддерживаю сестру. Передо мной женщина, устроившая представление, и с каждым прыжком я хочу её сильнее."

# ch/minami/events.rpy:3453
translate russian minami_siscon_09_92508db0:
    "И мне не нравится, насколько это приятно. Моя младшая сестра в школьной юбке, а я не должен так жадно хотеть смотреть дальше."

# ch/minami/events.rpy:3455
translate russian minami_siscon_09_743e86e2:
    "Что-то здесь ощущается неправильно. Или слишком правильно. Минами выросла, пока я не замечал, и тело осознало это раньше головы."

# ch/minami/events.rpy:3456
translate russian minami_siscon_09_d33c6992:
    "Потом я почти пошатываясь спускаюсь с чердака и иду в свою спальню."

# ch/minami/events.rpy:3457
translate russian minami_siscon_09_68d59760:
    "Но теперь — чтобы прилечь и прийти в себя, а не сесть за учебники..."

# ch/minami/events.rpy:3464
translate russian minami_siscon_08_07959b77:
    "Это один из тех тихих моментов, когда все одновременно оказываются в одной комнате."

# ch/minami/events.rpy:3468
translate russian minami_siscon_08_58afae6d:
    "Мы с [bree.name] и Сашей делим одно пространство и дышим одним воздухом."

# ch/minami/events.rpy:3469
translate russian minami_siscon_08_cf5dab47:
    "Но всем хорошо и молча: каждый погружён в свой маленький мир."

# ch/minami/events.rpy:3470
translate russian minami_siscon_08_0d84ba1a:
    "Пока эти миры не подвергаются враждебному вторжению Минами."

# ch/minami/events.rpy:3472
translate russian minami_siscon_08_33f1e887:
    minami.say "Эй, ребята."

# ch/minami/events.rpy:3473
translate russian minami_siscon_08_6e3adcfa:
    minami.say "Смотрите, что я нашла!"

# ch/minami/events.rpy:3475
translate russian minami_siscon_08_4e14a551:
    "Минами влетает в комнату, размахивая тем, что держит в руке."

# ch/minami/events.rpy:3477
translate russian minami_siscon_08_f8bc2d94:
    sasha.say "Дай угадаю: хорошие манеры?"

# ch/minami/events.rpy:3480
translate russian minami_siscon_08_587672aa:
    bree.say "Саша, будь помягче!"

# ch/minami/events.rpy:3482
translate russian minami_siscon_08_77b5bd80:
    bree.say "Что у тебя там, Минами?"

# ch/minami/events.rpy:3484
translate russian minami_siscon_08_7016cf01:
    "Минами явно довольна вниманием и доброжелательностью, которые проявляет [bree.name]."

# ch/minami/events.rpy:3489
translate russian minami_siscon_08_0a45f658:
    "Она спешит к старшей девушке, желая похвастаться находкой."

# ch/minami/events.rpy:3491
translate russian minami_siscon_08_b04136f5:
    sasha.say "А, это просто обычная колода карт."

# ch/minami/events.rpy:3492
translate russian minami_siscon_08_428af437:
    sasha.say "СКУКОТА!"

# ch/minami/events.rpy:3494
translate russian minami_siscon_08_a1773249:
    "Отсутствие восторга у Саши, похоже, совершенно не действует на Минами."

# ch/minami/events.rpy:3495
translate russian minami_siscon_08_a27029ad:
    "Она не унывает: открывает коробку и начинает тасовать карты."

# ch/minami/events.rpy:3497
translate russian minami_siscon_08_5367ce1c:
    bree.say "Эй, Минами, у тебя здорово получается!"

# ch/minami/events.rpy:3498
translate russian minami_siscon_08_0b026456:
    bree.say "Где ты научилась так обращаться с картами?"

# ch/minami/events.rpy:3500
translate russian minami_siscon_08_25fa3930:
    "Я замечаю, как [bree.name] косится на меня, словно предполагая, что Минами научилась у меня."

# ch/minami/events.rpy:3501
translate russian minami_siscon_08_e6277041:
    "Но в ответ получает лишь кривую улыбку и короткое покачивание головой."

# ch/minami/events.rpy:3502
translate russian minami_siscon_08_7174f230:
    mike.say "Простите, я тут ни при чём!"

# ch/minami/events.rpy:3503
translate russian minami_siscon_08_1077d568:
    mike.say "Всему этому её научил наш папа."

# ch/minami/events.rpy:3504
translate russian minami_siscon_08_42bfd893:
    mike.say "Он любит всякие фокусы и всё такое."

# ch/minami/events.rpy:3505
translate russian minami_siscon_08_1e36e64a:
    mike.say "Ну, ловкость рук, карточные трюки."

# ch/minami/events.rpy:3507
translate russian minami_siscon_08_967e73a2:
    "Саша с отвращением закатывает глаза, явно не впечатлённая."

# ch/minami/events.rpy:3509
translate russian minami_siscon_08_435d8573:
    sasha.say "Господи, наверное, на вечеринках он был душой компании!"

# ch/minami/events.rpy:3511
translate russian minami_siscon_08_9b9712e4:
    "Но сколько бы Саша ни язвила, [bree.name] и Минами будто не замечают."

# ch/minami/events.rpy:3513
translate russian minami_siscon_08_60196867:
    minami.say "Эй, братик, помнишь ту игру, в которую мы раньше играли?"

# ch/minami/events.rpy:3515
translate russian minami_siscon_08_b3b2a65a:
    mike.say "А, да, конечно."

# ch/minami/events.rpy:3516
translate russian minami_siscon_08_c9a3f28e:
    mike.say "Дома мы чаще всего играли в покер."

# ch/minami/events.rpy:3518
translate russian minami_siscon_08_adad476f:
    minami.say "Неважно, я название не помню."

# ch/minami/events.rpy:3519
translate russian minami_siscon_08_e89b64fc:
    minami.say "Но я слышала про классный вариант, где играют на кое-что очень весёлое."

# ch/minami/events.rpy:3520
translate russian minami_siscon_08_f8dc5e0d:
    minami.say "Проигрываешь раздачу — и снимаешь с себя что-нибудь из одежды!"

# ch/minami/events.rpy:3522
translate russian minami_siscon_08_818c1015:
    "Она только что сказала то, что я думаю?"

# ch/minami/events.rpy:3523
translate russian minami_siscon_08_c065959e:
    mike.say "Ты про покер на раздевание, Минами?!"

# ch/minami/events.rpy:3525
translate russian minami_siscon_08_4e7ec3b5:
    minami.say "Так он называется?"

# ch/minami/events.rpy:3526
translate russian minami_siscon_08_703e73f5:
    minami.say "Ух ты, я и НЕ ЗНАЛА, что он такой популярный!"

# ch/minami/events.rpy:3527
translate russian minami_siscon_08_2a19c63f:
    minami.say "В общем, думаю, нам стоит сыграть."

# ch/minami/events.rpy:3528
translate russian minami_siscon_08_45313935:
    minami.say "[bree.name], Саша, я и ТЫ!"

# ch/minami/events.rpy:3530
translate russian minami_siscon_08_b2384a25:
    sasha.say "О нет, ни за что! На меня не рассчитывайте!"

# ch/minami/events.rpy:3535
translate russian minami_siscon_08_7eafaee1:
    minami.say "Ну-у, Саша, ты всё веселье портишь!"

# ch/minami/events.rpy:3536
translate russian minami_siscon_08_c97ac0e2:
    minami.say "А ты, [bree.name]?"

# ch/minami/events.rpy:3538
translate russian minami_siscon_08_4411254b:
    bree.say "Я... ну... наверное, могла бы сыграть... может быть..."

# ch/minami/events.rpy:3539
translate russian minami_siscon_08_bda7048b:
    bree.say "Но я толком не знаю правил..."

# ch/minami/events.rpy:3541
translate russian minami_siscon_08_de5230cf:
    minami.say "Ура, [bree.name], ты лучшая!"

# ch/minami/events.rpy:3542
translate russian minami_siscon_08_782090bd:
    minami.say "Вот бы у меня была такая старшая сестра, как ты!"

# ch/minami/events.rpy:3544
translate russian minami_siscon_08_3c5d6373:
    "Не успеваю опомниться, как Минами переключается на меня."

# ch/minami/events.rpy:3546
translate russian minami_siscon_08_06ea5d59:
    minami.say "А ты, братик?"

# ch/minami/events.rpy:3547
translate russian minami_siscon_08_b64d4c5a:
    minami.say "Ты же не будешь таким скучным занудой, как Саша?"

# ch/minami/events.rpy:3551
translate russian minami_siscon_08_5043bcbf:
    "Ответ вырывается раньше, чем я успеваю подумать."

# ch/minami/events.rpy:3552
translate russian minami_siscon_08_eb9d59d9:
    "Я качаю головой и смеюсь."

# ch/minami/events.rpy:3553
translate russian minami_siscon_08_b356d047:
    mike.say "Минами, я НИ ЗА ЧТО не стану играть с тобой в покер на раздевание."

# ch/minami/events.rpy:3554
translate russian minami_siscon_08_38e7c1ea:
    mike.say "Это одна из худших идей, какие ты когда-либо придумывала!"

# ch/minami/events.rpy:3556
translate russian minami_siscon_08_a81db7ef:
    "Минами тут же поникает, широко раскрывает глаза, и губы у неё начинают дрожать."

# ch/minami/events.rpy:3557
translate russian minami_siscon_08_6d9ee1da:
    "[bree.name] сразу попадается на уловку: в её глазах появляется сочувствие."

# ch/minami/events.rpy:3558
translate russian minami_siscon_08_11f1843d:
    "Но я слишком хорошо знаю младшую сестру, чтобы купиться на один из её старейших трюков."

# ch/minami/events.rpy:3559
translate russian minami_siscon_08_dfbd6d73:
    mike.say "Эй, не изображай передо мной обиженного щенка, Минами!"

# ch/minami/events.rpy:3560
translate russian minami_siscon_08_01c04321:
    mike.say "Знаю, на маму с папой это всегда действовало."

# ch/minami/events.rpy:3561
translate russian minami_siscon_08_6dab538c:
    mike.say "Но на меня не подействует, ясно?"

# ch/minami/events.rpy:3562
translate russian minami_siscon_08_f02d6d15:
    mike.say "Если понадоблюсь, я у себя."

# ch/minami/events.rpy:3566
translate russian minami_siscon_08_420a72b0:
    "С этими словами я выхожу, оставляя [bree.name] наедине с выбранной ею судьбой."

# ch/minami/events.rpy:3567
translate russian minami_siscon_08_d8a00cbb:
    "Уходя, я всё ещё слышу разговор за спиной."

# ch/minami/events.rpy:3568
translate russian minami_siscon_08_1465e887:
    bree.say "Ты уверена, что всё ещё хочешь играть, Минами?"

# ch/minami/events.rpy:3569
translate russian minami_siscon_08_9ab0d77a:
    bree.say "Разве вдвоём будет не так весело?"

# ch/minami/events.rpy:3570
translate russian minami_siscon_08_3a635120:
    minami.say "Не волнуйся, [bree.name]."

# ch/minami/events.rpy:3571
translate russian minami_siscon_08_d46eabcc:
    minami.say "Теперь, когда все зануды ушли, я устрою нам ОСОБОЕ веселье!"

# ch/minami/events.rpy:3572
translate russian minami_siscon_08_074d738a:
    "Напоследок остаётся лишь надеяться, что [bree.name] понимает, во что ввязывается..."

# ch/minami/events.rpy:3574
translate russian minami_siscon_08_c7cdb432:
    "Не представляю, как избежать хотя бы одной партии с Минами."

# ch/minami/events.rpy:3575
translate russian minami_siscon_08_203b1772:
    "За всей этой напускной невинностью скрывается, я знаю, сильная покеристка."

# ch/minami/events.rpy:3576
translate russian minami_siscon_08_ff2f9a0e:
    "Скорее всего, [bree.name] не успеет опомниться, как останется в одном белье!"

# ch/minami/events.rpy:3577
translate russian minami_siscon_08_cb4bfd69:
    mike.say "Ладно, Минами, твоя взяла."

# ch/minami/events.rpy:3578
translate russian minami_siscon_08_6c10a761:
    mike.say "Давай побыстрее разыграем пару рук и покончим с этим."

# ch/minami/events.rpy:3580
translate russian minami_siscon_08_6c618726:
    "Услышав это, [bree.name] недоумевает ещё сильнее."

# ch/minami/events.rpy:3582
translate russian minami_siscon_08_7eb1c31f:
    bree.say "«Рук»?"

# ch/minami/events.rpy:3583
translate russian minami_siscon_08_e6cf106c:
    bree.say "Я думала, в покер играют картами?"

# ch/minami/events.rpy:3585
translate russian minami_siscon_08_d47dca4a:
    "О боже, во что она ввязывается?"

# ch/minami/events.rpy:3587
translate russian minami_siscon_08_4aee4607:
    "Но едва мы садимся и Минами раздаёт первые карты, я понимаю, что она задумала."

# ch/minami/events.rpy:3588
translate russian minami_siscon_08_5007ac1a:
    "Она легко могла бы воспользоваться неопытностью [bree.name], но не делает этого."

# ch/minami/events.rpy:3589
translate russian minami_siscon_08_0fd34b76:
    "Вместо этого будто намеренно допускает ошибки новичка, словно пытается проиграть."

# ch/minami/events.rpy:3590
translate russian minami_siscon_08_98244186:
    "Так она разденется ещё до того, как мы с [bree.name] снимем хотя бы по одной вещи."

# ch/minami/events.rpy:3591
translate russian minami_siscon_08_c614df7a:
    "Тут мне приходит в голову план, который обернётся для меня полным унижением."

# ch/minami/events.rpy:3592
translate russian minami_siscon_08_f295910c:
    "Но если повезёт, мне не придётся любоваться всеми округлостями младшей сестры!"

# ch/minami/events.rpy:3593
translate russian minami_siscon_08_7c1179e7:
    "Я начинаю копировать Минами, стараясь играть ещё хуже неё."

# ch/minami/events.rpy:3594
translate russian minami_siscon_08_050283d9:
    "Это срабатывает лишь потому, что, как бы хороша она ни была в покере, я лучше."

# ch/minami/events.rpy:3595
translate russian minami_siscon_08_6757eb9e:
    "Вскоре я уже сижу в одних трусах, покраснев самым подходящим для этого густым румянцем."

# ch/minami/events.rpy:3596
translate russian minami_siscon_08_b3d34c57:
    "[bree.name] почти полностью одета и выглядит озадаченной происходящим."

# ch/minami/events.rpy:3597
translate russian minami_siscon_08_358fc8f9:
    "А Минами улыбается, как кошка, дорвавшаяся до сливок."

# ch/minami/events.rpy:3599
translate russian minami_siscon_08_e8b45550:
    bree.say "Ух ты, [lssb_minami.hero_name()], ты ужасно играешь!"

# ch/minami/events.rpy:3602
translate russian minami_siscon_08_6fe395ad:
    minami.say "Да, [bree.name], ещё как!"

# ch/minami/events.rpy:3603
translate russian minami_siscon_08_c437ff73:
    minami.say "Зато себя показал во всей красе!"

# ch/minami/events.rpy:3605
translate russian minami_siscon_08_e1a2494e:
    "Она быстро подмигивает мне, разглядывая моё обнажённое тело."

# ch/minami/events.rpy:3606
translate russian minami_siscon_08_979b2031:
    "Тут я и понимаю, что маленькая хитрюга меня обвела вокруг пальца."

# ch/minami/events.rpy:3607
translate russian minami_siscon_08_96e5779e:
    "Она и не собиралась раздеваться сама — только заставить раздеться меня!"

# ch/minami/events.rpy:3609
translate russian minami_siscon_08_b505cad0:
    "И почему-то я даже не могу злиться. Она просто выманила из меня одежду, чтобы полюбоваться."

# ch/minami/events.rpy:3611
translate russian minami_siscon_08_110fe6a9:
    "Подмигивание действует сильнее проигрыша. Она хотела меня рассмотреть, по-настоящему, и от этого мне становится жарче, чем следовало бы."

# ch/minami/events.rpy:3613
translate russian minami_siscon_08_efc4515f:
    "Под смущением шевелится вина. Она моя младшая сестра, а какая-то часть меня рада, что ей хотелось на меня посмотреть."

# ch/minami/events.rpy:3615
translate russian minami_siscon_08_955f82f4:
    "За раздражением прячется странное тепло от мысли, что Минами хотела увидеть меня раздетым. Я поспешно отгоняю эту мысль."

# ch/minami/events.rpy:3616
translate russian minami_siscon_08_a3fccc9e:
    "Мне остаётся лишь молча кипеть от злости."

# ch/minami/events.rpy:3617
translate russian minami_siscon_08_a7d945d4:
    "И клясться, что больше ни разу не сяду с ней играть в покер, пока она здесь живёт..."

# ch/minami/events.rpy:3624
translate russian minami_siscon_07_9af1a22b:
    "Одна из самых странных сторон жизни с Минами под одной крышей — видеть, как она становится частью повседневности."

# ch/minami/events.rpy:3625
translate russian minami_siscon_07_9ad9116b:
    "Конечно, я ещё помню, как было, когда мы росли и жили дома."

# ch/minami/events.rpy:3626
translate russian minami_siscon_07_b827222f:
    "Но я так привык считать домом это место, что видеть здесь части прежней жизни довольно странно."

# ch/minami/events.rpy:3627
translate russian minami_siscon_07_507cd319:
    "Ещё страннее оттого, что Минами постоянно делает то же самое, что [bree.name] и Саша."

# ch/minami/events.rpy:3629
translate russian minami_siscon_07_0665489c:
    "Вот пример: я только что вошёл в гостиную и увидел, что [bree.name] сидит и играет в видеоигры в одном белье."

# ch/minami/events.rpy:3630
translate russian minami_siscon_07_d6eea500:
    "Не подумайте, что я пресытился: зрелище всё ещё впечатляющее!"

# ch/minami/events.rpy:3631
translate russian minami_siscon_07_55a50c4f:
    "Но со временем к нему привыкаешь, и оно уже не кажется таким событием."

# ch/minami/events.rpy:3633
translate russian minami_siscon_07_1f825956:
    "Гораздо больше меня занимает то, что рядом с ней играет Минами."

# ch/minami/events.rpy:3634
translate russian minami_siscon_07_cef84738:
    "Не знаю, делает ли она это по привычке или пытается проникнуться местной атмосферой."

# ch/minami/events.rpy:3635
translate russian minami_siscon_07_5fe296f1:
    "Но Минами тоже сидит здесь лишь в трусиках и короткой футболке!"

# ch/minami/events.rpy:3636
translate russian minami_siscon_07_c3c9256a:
    "Наверное, я простоял на месте дольше, чем казалось."

# ch/minami/events.rpy:3637
translate russian minami_siscon_07_7177ca17:
    "Потому что [bree.name] замечает меня, ставит игру на паузу и оглядывается через плечо."

# ch/minami/events.rpy:3639
translate russian minami_siscon_07_d9ec9285:
    bree.say "А, привет, [lssb_minami.hero_name()]."

# ch/minami/events.rpy:3640
translate russian minami_siscon_07_896b7dfc:
    bree.say "Ты бы хоть предупредил, что Минами так круто играет!"

# ch/minami/events.rpy:3643
translate russian minami_siscon_07_61b79d74:
    "Сначала Минами выглядит капризно-недовольной, будто её раздражает перерыв в игре."

# ch/minami/events.rpy:3644
translate russian minami_siscon_07_ccd5f0a9:
    "Но стоит прозвучать моему имени, как она тут же становится самим воплощением милоты."

# ch/minami/events.rpy:3646
translate russian minami_siscon_07_4f7fd71c:
    minami.say "Братик, ты бы видел, как здорово [bree.name] играет!"

# ch/minami/events.rpy:3647
translate russian minami_siscon_07_5d22cd04:
    minami.say "Серьёзно, она НАМНОГО лучше тебя!"

# ch/minami/events.rpy:3649
translate russian minami_siscon_07_4eb33ee5:
    "Я слабо улыбаюсь в ответ на этот явный укол."

# ch/minami/events.rpy:3650
translate russian minami_siscon_07_2927c363:
    mike.say "Ну, в последнее время я был занят работой и учёбой."

# ch/minami/events.rpy:3651
translate russian minami_siscon_07_4d0c331f:
    mike.say "На игры почти не было времени..."

# ch/minami/events.rpy:3653
translate russian minami_siscon_07_9b8c5cf5:
    "Минами заливается хихиканьем, прикрывая рот ладонью."

# ch/minami/events.rpy:3654
translate russian minami_siscon_07_6d3795c3:
    minami.say "Чего такой серьёзный, братик?"

# ch/minami/events.rpy:3655
translate russian minami_siscon_07_c41581e7:
    minami.say "С каждым днём всё больше похож на папу!"

# ch/minami/events.rpy:3657
translate russian minami_siscon_07_a63cdc17:
    "[bree.name] тоже не может сдержать смешок, явно наслаждаясь моим смущением."

# ch/minami/events.rpy:3658
translate russian minami_siscon_07_323735e4:
    bree.say "Почему бы не сесть и не посмотреть, как я надеру Минами задницу, [lssb_minami.hero_name()]?"

# ch/minami/events.rpy:3661
translate russian minami_siscon_07_3bf0f4df:
    minami.say "Да, братик, посмотри на нас, пожалуйста!"

# ch/minami/events.rpy:3662
translate russian minami_siscon_07_d0964ed5:
    minami.say "Или тебе пора на урок в школу зануд?"

# ch/minami/events.rpy:3666
translate russian minami_siscon_07_ca2bc0b3:
    "Признаюсь, раньше я много раз принимал от [bree.name] почти такое же предложение."

# ch/minami/events.rpy:3667
translate russian minami_siscon_07_e8e2a798:
    "И признаюсь ещё: соглашался я вовсе не ради игры."

# ch/minami/events.rpy:3668
translate russian minami_siscon_07_0865518d:
    "Как любой увлечённый игрок, она довольно бурно реагирует на происходящее."

# ch/minami/events.rpy:3669
translate russian minami_siscon_07_a8bac3ac:
    "Но, подозреваю, Минами относится к той же категории."

# ch/minami/events.rpy:3670
translate russian minami_siscon_07_2ecf14f8:
    "Так что меньше всего мне хочется сидеть и смотреть, как её полуголое тело подпрыгивает."

# ch/minami/events.rpy:3671
translate russian minami_siscon_07_cdf1fc77:
    mike.say "К твоему сведению, в школе зануд я первый в классе."

# ch/minami/events.rpy:3672
translate russian minami_siscon_07_fca3bd25:
    mike.say "Преподаватели говорят, если буду хорошо стараться, окаменею ещё до тридцати!"

# ch/minami/events.rpy:3675
translate russian minami_siscon_07_0e99c3fc:
    "Минами с явным отвращением закатывает глаза и сразу возвращается к игре."

# ch/minami/events.rpy:3677
translate russian minami_siscon_07_41ef0227:
    minami.say "Угх..."

# ch/minami/events.rpy:3678
translate russian minami_siscon_07_316587e0:
    minami.say "С тобой больше не весело!"

# ch/minami/events.rpy:3681
translate russian minami_siscon_07_e0345870:
    "[bree.name] ещё немного смотрит мне в глаза с кривоватой улыбкой в уголках рта."

# ch/minami/events.rpy:3682
translate russian minami_siscon_07_0dfed438:
    "Я вижу, что она понимает мои причины гораздо лучше, чем могла бы Минами."

# ch/minami/events.rpy:3683
translate russian minami_siscon_07_8f779163:
    "Даже когда она тоже возвращается к игре, это ощущение остаётся."

# ch/minami/events.rpy:3684
translate russian minami_siscon_07_9185e15e:
    "Я стараюсь помнить об этом, поворачиваясь к выходу."

# ch/minami/events.rpy:3685
translate russian minami_siscon_07_aa6e73c2:
    "Иногда роль ответственного взрослого просто не оставляет иного выбора, кроме как быть скучным."

# ch/minami/events.rpy:3687
translate russian minami_siscon_07_0898a3c8:
    "Я поспешно киваю, пытаясь прогнать нежелательный образ того, как [bree.name] что-то делает с попкой моей младшей сестры."

# ch/minami/events.rpy:3688
translate russian minami_siscon_07_baef5d2d:
    "Хотя я ни за что не признаюсь Минами, замечание о сходстве с папой действительно меня задело."

# ch/minami/events.rpy:3689
translate russian minami_siscon_07_f5e758ca:
    "Но, может, согласившись посмотреть на их игру, я смогу немного изменить её мнение?"

# ch/minami/events.rpy:3690
translate russian minami_siscon_07_673dbc09:
    "Поэтому я падаю на диван, подняв руки в знак капитуляции."

# ch/minami/events.rpy:3691
translate russian minami_siscon_07_8f6c4de5:
    mike.say "Ладно, ладно, ваша взяла."

# ch/minami/events.rpy:3692
translate russian minami_siscon_07_ee02f435:
    minami.say "Ура!"

# ch/minami/events.rpy:3694
translate russian minami_siscon_07_2f4bf325:
    minami.say "Ну что, [bree.name], поехали!"

# ch/minami/events.rpy:3695
translate russian minami_siscon_07_1b6e9d88:
    minami.say "Ты у меня ещё взмолишься о пощаде!"

# ch/minami/events.rpy:3698
translate russian minami_siscon_07_de802442:
    bree.say "О нет, ни за что."

# ch/minami/events.rpy:3699
translate russian minami_siscon_07_13b0dd9c:
    bree.say "Это тебе достанется по попе, Минами!"

# ch/minami/events.rpy:3701
translate russian minami_siscon_07_7d987ced:
    "Твою мать, они что, нарочно?!"

# ch/minami/events.rpy:3702
translate russian minami_siscon_07_8bf650aa:
    "Они ещё даже не начали, а моя голова уже полна ярких картин, от которых хочется покраснеть."

# ch/minami/events.rpy:3703
translate russian minami_siscon_07_49b58c91:
    "Вскоре обе так увлекаются, что неизбежные толчки и подпрыгивания начинаются вовсю."

# ch/minami/events.rpy:3704
translate russian minami_siscon_07_ab3e2a9f:
    "А что, вы думали, девушки-геймеры всё время сидят тихо и скромно?"

# ch/minami/events.rpy:3705
translate russian minami_siscon_07_2355e3b2:
    "О боже... вы вообще на Земле бывали?"

# ch/minami/events.rpy:3706
translate russian minami_siscon_07_19de8d47:
    "Они не усидели бы спокойно, даже если бы от этого зависела жизнь."

# ch/minami/events.rpy:3707
translate russian minami_siscon_07_5fb0d6dc:
    "Через считаные минуты [bree.name] и Минами уже подпрыгивают на попках прямо передо мной."

# ch/minami/events.rpy:3708
translate russian minami_siscon_07_ef0f21e0:
    "И почти сразу становится ясно, что лифчика нет ни на одной!"

# ch/minami/events.rpy:3709
translate russian minami_siscon_07_c9c76b8e:
    "Я не знаю, куда смотреть. Нет, это ложь."

# ch/minami/events.rpy:3710
translate russian minami_siscon_07_2d9bac50:
    "Я прекрасно знаю, куда нужно смотреть: прямо на экран телевизора."

# ch/minami/events.rpy:3711
translate russian minami_siscon_07_95e7d07e:
    "Проблема лишь в том, что и в нём видны их отражения."

# ch/minami/events.rpy:3712
translate russian minami_siscon_07_33ee1d49:
    "И, если позволите ужасную шутку на игровую тему..."

# ch/minami/events.rpy:3713
translate russian minami_siscon_07_0726ec27:
    "Я чувствую, что мой собственный джойстик тоже хочет поиграть."

# ch/minami/events.rpy:3714
translate russian minami_siscon_07_d108c0fd:
    "Как можно медленнее и незаметнее я тянусь за диванной подушкой."

# ch/minami/events.rpy:3715
translate russian minami_siscon_07_3b96493a:
    "Прижав её к паху, изо всех сил стараюсь выгнать такие мысли из головы."

# ch/minami/events.rpy:3717
translate russian minami_siscon_07_3142138c:
    "Правда в том, что я смотрю только на одну из них. Взгляд всё время цепляется за тело Минами, и я мог бы любоваться весь день — с подушкой или без."

# ch/minami/events.rpy:3719
translate russian minami_siscon_07_610acd91:
    "Я уже перестал притворяться, что смотрю на экран. Мой взгляд возвращается к ней, и я хочу её. Ясно и просто."

# ch/minami/events.rpy:3721
translate russian minami_siscon_07_8d0a3dc1:
    "Я украдкой смотрю именно на Минами, и в этом вся проблема. Она моя сестра, а подушка не скрывает того, что она со мной делает."

# ch/minami/events.rpy:3723
translate russian minami_siscon_07_4fdeb4f4:
    "Я всё велю себе смотреть на [bree.name], но взгляд каждый раз возвращается к Минами, и я не понимаю, почему это так выбивает меня из колеи."

# ch/minami/events.rpy:3725
translate russian minami_siscon_07_9a82e3bc:
    "Просто две соседки дурачатся, а тело, как всегда, реагирует глупо. По отношению к Минами это ничего не значит."

# ch/minami/events.rpy:3726
translate russian minami_siscon_07_7561ee8f:
    "Но тут [bree.name] и Минами начинают хлопать друг друга и легонько стукать кулаками."

# ch/minami/events.rpy:3727
translate russian minami_siscon_07_ba7afb31:
    "О чёрт, а если они ещё и бороться начнут?!"

# ch/minami/events.rpy:3728
translate russian minami_siscon_07_0f457f03:
    "Но тут относительная юность Минами бросает мне спасательный круг."

# ch/minami/events.rpy:3730
translate russian minami_siscon_07_949967d9:
    minami.say "А-а-ар!"

# ch/minami/events.rpy:3731
translate russian minami_siscon_07_ffe7f8d6:
    minami.say "НУ УЖ НЕТ! Это какая-то хрень!"

# ch/minami/events.rpy:3735
translate russian minami_siscon_07_edd2a680:
    "Я смотрю, как она вскакивает, бросает контроллер и сердито выходит из комнаты."

# ch/minami/events.rpy:3736
translate russian minami_siscon_07_3eb5737c:
    "Невероятно: меня спасли психи из-за проигрыша!"

# ch/minami/events.rpy:3737
translate russian minami_siscon_07_67f9fb82:
    "[bree.name] почти так же удивлена, как я, и оглядывается на меня через плечо."

# ch/minami/events.rpy:3739
translate russian minami_siscon_07_a1101282:
    bree.say "Ух ты, вот это у неё темперамент!"

# ch/minami/events.rpy:3740
translate russian minami_siscon_07_89dd9429:
    bree.say "Хочешь занять её место, [lssb_minami.hero_name()]?"

# ch/minami/events.rpy:3742
translate russian minami_siscon_07_ef29621d:
    "Болезненно остро осознавая, что происходит у меня в трусах, я могу лишь улыбнуться и покачать головой."

# ch/minami/events.rpy:3743
translate russian minami_siscon_07_9d50dd0e:
    mike.say "Нет, спасибо, мне и здесь хорошо..."

# ch/minami/events.rpy:3750
translate russian minami_siscon_06b_2d57b781:
    "Я не люблю ходить в торговый центр, когда нужно всерьёз закупаться."

# ch/minami/events.rpy:3751
translate russian minami_siscon_06b_48f385b6:
    "Знаю, звучит странно: торговые центры ведь для покупок и существуют."

# ch/minami/events.rpy:3752
translate russian minami_siscon_06b_8722a963:
    "Но сначала выслушайте, ладно?"

# ch/minami/events.rpy:3753
translate russian minami_siscon_06b_e0340c12:
    "Большинство покупок я делаю через интернет."

# ch/minami/events.rpy:3754
translate russian minami_siscon_06b_600b0423:
    "Это быстрее, проще и, как приятный бонус, не требует общения с живыми людьми."

# ch/minami/events.rpy:3755
translate russian minami_siscon_06b_1e01b41e:
    "Так что поход в торговый центр для меня скорее повод провести время вне дома."

# ch/minami/events.rpy:3756
translate russian minami_siscon_06b_075c36a6:
    "Мне нравится неспешно гулять, смотреть витрины и впитывать атмосферу."

# ch/minami/events.rpy:3757
translate russian minami_siscon_06b_d455b4ac:
    "А ещё лучше делать это на свидании!"

# ch/minami/events.rpy:3758
translate russian minami_siscon_06b_4f6ba334:
    "Поэтому можете представить, что рождественский шопинг с Минами — не совсем моё."

# ch/minami/events.rpy:3759
translate russian minami_siscon_06b_c98654b8:
    "Торговый центр битком набит грубыми покупателями, которые толкают меня и пихают локтями."

# ch/minami/events.rpy:3760
translate russian minami_siscon_06b_c439ce35:
    "Приходится спешить за Минами, которая легко просачивается сквозь толпу."

# ch/minami/events.rpy:3761
translate russian minami_siscon_06b_5f3e6c4d:
    "Честное слово, будто какая-то надоедливая фея шопинга!"

# ch/minami/events.rpy:3762
translate russian minami_siscon_06b_4594dc5a:
    "Она порхает от витрины к витрине, совершенно забыв, зачем мы пришли."

# ch/minami/events.rpy:3763
translate russian minami_siscon_06b_3ecc8934:
    mike.say "Э... эй!"

# ch/minami/events.rpy:3764
translate russian minami_siscon_06b_421e2700:
    mike.say "Минами..."

# ch/minami/events.rpy:3765
translate russian minami_siscon_06b_4ad0368d:
    mike.say "Помедленнее!"

# ch/minami/events.rpy:3766
translate russian minami_siscon_06b_46a44473:
    "Понятия не имею, слышит ли Минами мои слова."

# ch/minami/events.rpy:3767
translate russian minami_siscon_06b_1d22cc02:
    "Но, к счастью, она как раз останавливается и подзывает меня."

# ch/minami/events.rpy:3768
translate russian minami_siscon_06b_1af7f405:
    minami.say "Братик..."

# ch/minami/events.rpy:3769
translate russian minami_siscon_06b_e71f8140:
    minami.say "Сюда, скорее!"

# ch/minami/events.rpy:3770
translate russian minami_siscon_06b_07c98f1f:
    "Я изо всех сил стараюсь пробраться к Минами."

# ch/minami/events.rpy:3771
translate russian minami_siscon_06b_5a4b0fd6:
    "Но это требует немалых усилий."

# ch/minami/events.rpy:3772
translate russian minami_siscon_06b_e2f53ac6:
    "Наступаю кому-то на ноги и получаю несколько злых взглядов."

# ch/minami/events.rpy:3774
translate russian minami_siscon_06b_10cdd233:
    "Наконец оказываюсь позади Минами."

# ch/minami/events.rpy:3776
translate russian minami_siscon_06b_d690f3ae:
    minami.say "Что ты так долго, братик?"

# ch/minami/events.rpy:3778
translate russian minami_siscon_06b_7c157082:
    mike.say "Мне пришлось сюда с боем пробираться, Минами!"

# ch/minami/events.rpy:3779
translate russian minami_siscon_06b_a0b72142:
    mike.say "Кажется, какая-то женщина даже ударила меня коленом в пах!"

# ch/minami/events.rpy:3780
translate russian minami_siscon_06b_51911681:
    minami.say "Ой, неважно."

# ch/minami/events.rpy:3782
translate russian minami_siscon_06b_c4e863be:
    minami.say "Ты только посмотри, что у них здесь!"

# ch/minami/events.rpy:3784
translate russian minami_siscon_06b_be587761:
    "Вот так просто Минами отметает мои жалобы."

# ch/minami/events.rpy:3785
translate russian minami_siscon_06b_1a5f7cf6:
    "Её куда больше интересует содержимое витрины."

# ch/minami/events.rpy:3786
translate russian minami_siscon_06b_7a5034ed:
    "Я наклоняюсь, чтобы разглядеть получше, почти касаясь головой головы Минами."

# ch/minami/events.rpy:3787
translate russian minami_siscon_06b_d6ebbe2b:
    mike.say "Что там?"

# ch/minami/events.rpy:3788
translate russian minami_siscon_06b_e4f9f845:
    mike.say "Мы ведь должны покупать подарки, помнишь?"

# ch/minami/events.rpy:3789
translate russian minami_siscon_06b_7c1cb02e:
    "Как раз в этот момент толпа проходящих мимо покупателей подаётся вперёд."

# ch/minami/events.rpy:3791
translate russian minami_siscon_06b_ea6b7e7c:
    "Меня толкают прямо на Минами."

# ch/minami/events.rpy:3792
translate russian minami_siscon_06b_c0c6291c:
    "А её, в свою очередь, прижимает к стеклу витрины."

# ch/minami/events.rpy:3793
translate russian minami_siscon_06b_6464e413:
    "Я слышу её испуганный возглас."

# ch/minami/events.rpy:3794
translate russian minami_siscon_06b_03ad152a:
    "И чувствую её тело, зажатое между мной и стеклом."

# ch/minami/events.rpy:3795
translate russian minami_siscon_06b_960bc3fa:
    "Мой пах плотно прижат к её маленькой попке."

# ch/minami/events.rpy:3796
translate russian minami_siscon_06b_28e9f53c:
    "Я тут же пытаюсь отстраниться, но толпа удерживает меня."

# ch/minami/events.rpy:3797
translate russian minami_siscon_06b_6ab5a9e3:
    "В итоге получается только тереться о Минами."

# ch/minami/events.rpy:3799
translate russian minami_siscon_06b_c85941b7:
    minami.say "Ч..."

# ch/minami/events.rpy:3800
translate russian minami_siscon_06b_432adda7:
    minami.say "Какого чёрта?!"

# ch/minami/events.rpy:3801
translate russian minami_siscon_06b_d154f905:
    minami.say "Братик, что ты делаешь?!"

# ch/minami/events.rpy:3803
translate russian minami_siscon_06b_6760c48b:
    mike.say "П... прости, Минами!"

# ch/minami/events.rpy:3804
translate russian minami_siscon_06b_f308dc5a:
    mike.say "Меня толкнули..."

# ch/minami/events.rpy:3805
translate russian minami_siscon_06b_4d3ebc2e:
    mike.say "Я не хотел..."

# ch/minami/events.rpy:3807
translate russian minami_siscon_06b_85127cc2:
    "Минами раздражённо вздыхает."

# ch/minami/events.rpy:3808
translate russian minami_siscon_06b_be7b3c08:
    "Затем пытается исправить положение сама."

# ch/minami/events.rpy:3809
translate russian minami_siscon_06b_158cb3d4:
    "Но лишь делает хуже, извиваясь вплотную ко мне."

# ch/minami/events.rpy:3811
translate russian minami_siscon_06b_f3137a95:
    minami.say "Ох..."

# ch/minami/events.rpy:3812
translate russian minami_siscon_06b_09a56253:
    minami.say "Ах..."

# ch/minami/events.rpy:3813
translate russian minami_siscon_06b_f49aeb5f:
    minami.say "Что у тебя в кармане, братик?"

# ch/minami/events.rpy:3814
translate russian minami_siscon_06b_59e47f63:
    minami.say "Что-то очень твёрдое..."

# ch/minami/events.rpy:3816
translate russian minami_siscon_06b_d1ca2d15:
    "Вдруг я замечаю просвет в толпе."

# ch/minami/events.rpy:3817
translate russian minami_siscon_06b_88254e2a:
    "И вижу, что в магазине почти пусто."

# ch/minami/events.rpy:3819
translate russian minami_siscon_06b_5eaeade5:
    "Поэтому поспешно увожу Минами внутрь, не тратя времени на вопросы."

# ch/minami/events.rpy:3820
translate russian minami_siscon_06b_96168794:
    "Она открывает рот, чтобы возразить, но замечает, куда мы направляемся."

# ch/minami/events.rpy:3821
translate russian minami_siscon_06b_64917dc9:
    "Минами помогает протиснуться сквозь толпу."

# ch/minami/events.rpy:3822
translate russian minami_siscon_06b_a7cc8a3b:
    "Мгновение спустя мы уже внутри магазина."

# ch/minami/events.rpy:3826
translate russian minami_siscon_06b_38c677a6:
    minami.say "Поняла, братик."

# ch/minami/events.rpy:3827
translate russian minami_siscon_06b_87320f3a:
    minami.say "Ты увидел вещи в витрине, да?"

# ch/minami/events.rpy:3829
translate russian minami_siscon_06b_bc3a9dfc:
    minami.say "И они ТАКИЕ милые, что ты просто не мог не зайти!"

# ch/minami/events.rpy:3831
translate russian minami_siscon_06b_604650c2:
    "Я недоумённо смотрю на Минами."

# ch/minami/events.rpy:3832
translate russian minami_siscon_06b_21fe6c96:
    "Я так и не успел разглядеть, что было в этой чёртовой витрине."

# ch/minami/events.rpy:3833
translate russian minami_siscon_06b_b31348c0:
    "Но выражение моего лица её, похоже, не интересует."

# ch/minami/events.rpy:3835
translate russian minami_siscon_06b_2d9a6cf3:
    minami.say "Мне нужно это примерить!"

# ch/minami/events.rpy:3836
translate russian minami_siscon_06b_6d118728:
    minami.say "И вот это..."

# ch/minami/events.rpy:3837
translate russian minami_siscon_06b_c3ea4b1b:
    minami.say "О-о... и это тоже!"

# ch/minami/events.rpy:3839
translate russian minami_siscon_06b_fd886298:
    "Прежде чем я успеваю возразить, она суёт мне в руки полдюжины вещей."

# ch/minami/events.rpy:3840
translate russian minami_siscon_06b_47293f2d:
    "А затем носится по магазину, добавляя к охапке всё новые!"

# ch/minami/events.rpy:3841
translate russian minami_siscon_06b_8d93d6f8:
    "Я как могу спешу за Минами, тщетно пытаясь привлечь её внимание."

# ch/minami/events.rpy:3842
translate russian minami_siscon_06b_421e2700_1:
    mike.say "Минами..."

# ch/minami/events.rpy:3843
translate russian minami_siscon_06b_15956d19:
    mike.say "Я думал, ты увидела здесь подарок для кого-то другого."

# ch/minami/events.rpy:3844
translate russian minami_siscon_06b_4a1e3017:
    mike.say "Мы ведь пришли за рождественскими подарками, помнишь?!"

# ch/minami/events.rpy:3846
translate russian minami_siscon_06b_47e0692b:
    minami.say "Да-да, братик, как скажешь..."

# ch/minami/events.rpy:3847
translate russian minami_siscon_06b_cc9db4c4:
    minami.say "Я ненадолго, ладно?"

# ch/minami/events.rpy:3848
translate russian minami_siscon_06b_9e14e533:
    minami.say "Мы всё успеем после того, как я куплю себе что-нибудь милое!"

# ch/minami/events.rpy:3850
translate russian minami_siscon_06b_0ac32384:
    "Ни одно моё слово, похоже, ничего не меняет."

# ch/minami/events.rpy:3851
translate russian minami_siscon_06b_6e828976:
    "Минами просто не слушает, снуя по магазину."

# ch/minami/events.rpy:3852
translate russian minami_siscon_06b_787554e4:
    "Не успеваю опомниться, как уже стою у кабинки в примерочной."

# ch/minami/events.rpy:3853
translate russian minami_siscon_06b_9b7563c3:
    mike.say "Минами!"

# ch/minami/events.rpy:3854
translate russian minami_siscon_06b_1104287f:
    mike.say "Ты уже всё перемерила?"

# ch/minami/events.rpy:3855
translate russian minami_siscon_06b_b7f89069:
    mike.say "Серьёзно, магазин скоро закроется!"

# ch/minami/events.rpy:3856
translate russian minami_siscon_06b_97602f83:
    minami.say "Минутку, братик!"

# ch/minami/events.rpy:3857
translate russian minami_siscon_06b_06bc5419:
    minami.say "Кажется, я хочу этот комплект, но не уверена."

# ch/minami/events.rpy:3858
translate russian minami_siscon_06b_fdfc2d68:
    minami.say "Скажи, что думаешь, ладно?"

# ch/minami/events.rpy:3859
translate russian minami_siscon_06b_02204559:
    "Это что, чёртов показ мод?!"

# ch/minami/events.rpy:3860
translate russian minami_siscon_06b_998bad05:
    "Я открываю рот, чтобы снова отчитать Минами."

# ch/minami/events.rpy:3862
translate russian minami_siscon_06b_fe807eea:
    "Но тут она отдёргивает занавеску между нами."

# ch/minami/events.rpy:3863
translate russian minami_siscon_06b_cd987cd6:
    "И слова замирают на языке."

# ch/minami/events.rpy:3865
translate russian minami_siscon_06b_dc74ac66:
    minami.say "Ну что, братик..."

# ch/minami/events.rpy:3866
translate russian minami_siscon_06b_0fd41310:
    minami.say "Как тебе?"

# ch/minami/events.rpy:3868
translate russian minami_siscon_06b_a2c0e041:
    "Трудно сказать, что я думаю в эту секунду."

# ch/minami/events.rpy:3869
translate russian minami_siscon_06b_d35e5000:
    "Потому что командует сейчас явно не мозг."

# ch/minami/events.rpy:3870
translate russian minami_siscon_06b_42abe8ff:
    "Минами стоит передо мной в одном белье."

# ch/minami/events.rpy:3871
translate russian minami_siscon_06b_9210c925:
    "Так что думать за меня принимается член!"

# ch/minami/events.rpy:3872
translate russian minami_siscon_06b_d8864d33:
    "Но слово «бельё» не очень-то описывает то, что на ней надето."

# ch/minami/events.rpy:3873
translate russian minami_siscon_06b_93f82f6f:
    "Это эротическое бельё, созданное исключительно для того, чтобы подчёркивать и выставлять напоказ."

# ch/minami/events.rpy:3874
translate russian minami_siscon_06b_c5efaa05:
    "И именно это оно сейчас делает с телом Минами!"

# ch/minami/events.rpy:3875
translate russian minami_siscon_06b_ea2ffda3:
    "Лифчик, трусики, чулки и пояс — всё разом обрушивается на мой взгляд."

# ch/minami/events.rpy:3877
translate russian minami_siscon_06b_313f6c7c:
    "Затем Минами делает зрелище в десять раз лучше, позируя и соблазнительно надувая губы."

# ch/minami/events.rpy:3878
translate russian minami_siscon_06b_8f14b5f1:
    "Каждый сантиметр её изящного тела на виду, и выглядит она невероятно."

# ch/minami/events.rpy:3879
translate russian minami_siscon_06b_18ab2fd4:
    "Из-за неё у меня встаёт как камень, а я не могу оторвать глаз."

# ch/minami/events.rpy:3881
translate russian minami_siscon_06b_809b4474:
    "Такие моменты всё ещё лишают меня дыхания. Самое прекрасное тело в мире выставлено напоказ прямо передо мной."

# ch/minami/events.rpy:3883
translate russian minami_siscon_06b_d152e23b:
    "Я перестал мысленно называть это неправильным. Передо мной женщина в кружевах. Всё просто."

# ch/minami/events.rpy:3885
translate russian minami_siscon_06b_a0e5730e:
    "Нужно отвернуться. Моя младшая сестра стоит в белье, и моя неспособность отвести взгляд начинает немного пугать."

# ch/minami/events.rpy:3887
translate russian minami_siscon_06b_bc00373a:
    minami.say "Скажи что-нибудь, братик!"

# ch/minami/events.rpy:3888
translate russian minami_siscon_06b_dc3cc416:
    minami.say "А то я подумаю, что тебе совсем не нравится!"

# ch/minami/events.rpy:3892
translate russian minami_siscon_06b_148d50aa:
    "Вдруг все мысли о рождественских покупках исчезают."

# ch/minami/events.rpy:3893
translate russian minami_siscon_06b_36636cac:
    "Просто растворяются в нахлынувшем желании."

# ch/minami/events.rpy:3894
translate russian minami_siscon_06b_566a83f7:
    "Наверное, я улыбаюсь до ушей."

# ch/minami/events.rpy:3895
translate russian minami_siscon_06b_6c07d2f7:
    "Потому что вижу, как Минами радуется моей реакции."

# ch/minami/events.rpy:3896
translate russian minami_siscon_06b_95765dd7:
    mike.say "Ух ты, Минами... просто... УХ ТЫ!"

# ch/minami/events.rpy:3897
translate russian minami_siscon_06b_f15f147f:
    mike.say "Ты обязана это купить! Всё!"

# ch/minami/events.rpy:3899
translate russian minami_siscon_06b_c819e4f6:
    "Минами радостно хихикает."

# ch/minami/events.rpy:3900
translate russian minami_siscon_06b_9a497f9d:
    "И прикрывает рот ладонью."

# ch/minami/events.rpy:3901
translate russian minami_siscon_06b_dabe923f:
    "Из-за этого она выглядит лишь ещё соблазнительнее."

# ch/minami/events.rpy:3903
translate russian minami_siscon_06b_9b506b6a:
    minami.say "О-о..."

# ch/minami/events.rpy:3904
translate russian minami_siscon_06b_6165321f:
    minami.say "Как мило с твоей стороны, братик!"

# ch/minami/events.rpy:3906
translate russian minami_siscon_06b_b93d3b1d:
    minami.say "Знаю, я немного шалю."

# ch/minami/events.rpy:3907
translate russian minami_siscon_06b_e912006c:
    minami.say "Трачу время, хотя мы должны покупать подарки на Рождество..."

# ch/minami/events.rpy:3909
translate russian minami_siscon_06b_9c1b75cc:
    mike.say "Да к чёрту покупки, Минами!"

# ch/minami/events.rpy:3910
translate russian minami_siscon_06b_a6ca1fb1:
    mike.say "Ими можно заняться когда угодно."

# ch/minami/events.rpy:3911
translate russian minami_siscon_06b_df09ec12:
    mike.say "Не каждый день удаётся увидеть тебя в таком наряде!"

# ch/minami/events.rpy:3913
translate russian minami_siscon_06b_7fef4f20:
    "Минами снова смеётся, но на этот раз тише и с явным пониманием."

# ch/minami/events.rpy:3916
translate russian minami_siscon_06b_2caae760:
    "Она наклоняется ближе, приподняв бровь."

# ch/minami/events.rpy:3918
translate russian minami_siscon_06b_e40e6cea:
    minami.say "То есть ты хотел бы почаще видеть меня в белье, братик?"

# ch/minami/events.rpy:3920
translate russian minami_siscon_06b_28dc3296:
    mike.say "Да... я... то есть нет... то есть..."

# ch/minami/events.rpy:3922
translate russian minami_siscon_06b_f86f2ac7:
    minami.say "О-о, ты, похоже, запутался!"

# ch/minami/events.rpy:3923
translate russian minami_siscon_06b_00ae49ea:
    minami.say "Со мной от приятных комплиментов то же самое."

# ch/minami/events.rpy:3924
translate russian minami_siscon_06b_c8de5151:
    minami.say "А тот, который ты только что сделал, был ТАКИМ приятным."

# ch/minami/events.rpy:3926
translate russian minami_siscon_06b_e3b1ad23:
    minami.say "Таким, что голова ещё долго будет кружиться."

# ch/minami/events.rpy:3927
translate russian minami_siscon_06b_7e41c341:
    minami.say "И я могу натворить всяких безумств."

# ch/minami/events.rpy:3928
translate russian minami_siscon_06b_abb0cd06:
    minami.say "Например, надеть бельё и забыть обо всей остальной одежде!"

# ch/minami/events.rpy:3929
translate russian minami_siscon_06b_3c296d0d:
    minami.say "А потом ещё и забыть, какая дверь ведёт в мою спальню..."

# ch/minami/events.rpy:3931
translate russian minami_siscon_06b_83dff9f3:
    "Я настолько зачарован словами Минами, что не замечаю движения её руки."

# ch/minami/events.rpy:3932
translate russian minami_siscon_06b_fb33e86d:
    "Понимаю, что происходит, лишь когда она начинает ласкать мой член."

# ch/minami/events.rpy:3933
translate russian minami_siscon_06b_04a4ef8b:
    "Минами гладит и сжимает его через штаны, заставляя меня судорожно вздохнуть."

# ch/minami/events.rpy:3934
translate russian minami_siscon_06b_db2a6ab0:
    mike.say "Я... я мог бы помочь тебе, Минами!"

# ch/minami/events.rpy:3935
translate russian minami_siscon_06b_1c6c9e2f:
    mike.say "Напомнить... может быть?"

# ch/minami/events.rpy:3937
translate russian minami_siscon_06b_f0fa4ed6:
    minami.say "Уверена, мог бы, братик."

# ch/minami/events.rpy:3938
translate russian minami_siscon_06b_be722614:
    minami.say "Ты бы вернул меня к ТВЁРДОЙ реальности!"

# ch/minami/events.rpy:3940
translate russian minami_siscon_06b_6748e788:
    "С этими словами Минами быстро целует меня в губы."

# ch/minami/events.rpy:3942
translate russian minami_siscon_06b_f8893577:
    "Затем исчезает, юркнув обратно за занавеску."

# ch/minami/events.rpy:3943
translate russian minami_siscon_06b_19f244f6:
    "Я оглядываюсь, чувствуя, как краснеют щёки."

# ch/minami/events.rpy:3944
translate russian minami_siscon_06b_daf87517:
    "Трудно выпрямиться, когда член настолько твёрдый."

# ch/minami/events.rpy:3945
translate russian minami_siscon_06b_2c787667:
    "Но, ожидая Минами, я изо всех сил стараюсь прийти в порядок."

# ch/minami/events.rpy:3949
translate russian minami_siscon_06b_4f0d86c6:
    "Продолжая покупки, мы оба не упоминаем о случившемся."

# ch/minami/events.rpy:3950
translate russian minami_siscon_06b_c7bcf877:
    "Минами ведёт себя как обычно, порхая туда-сюда по настроению."

# ch/minami/events.rpy:3951
translate russian minami_siscon_06b_a809cdec:
    "Но при этом радостно размахивает пакетом с новым бельём."

# ch/minami/events.rpy:3952
translate russian minami_siscon_06b_1a69cb67:
    "Потому что знает: я всё время на него смотрю."

# ch/minami/events.rpy:3953
translate russian minami_siscon_06b_8fe2331d:
    "Смотрю и думаю, когда снова увижу её в этом комплекте."

# ch/minami/events.rpy:3957
translate russian minami_siscon_06b_9c519faf:
    "Вдруг я чувствую, что чары соблазнительного тела Минами ослабевают."

# ch/minami/events.rpy:3958
translate russian minami_siscon_06b_fed61b02:
    "Я встряхиваюсь и с дрожью возвращаю себе контроль над чувствами."

# ch/minami/events.rpy:3959
translate russian minami_siscon_06b_c0d7eeb7:
    "Затем смотрю на неё самым строгим и неодобрительным взглядом."

# ch/minami/events.rpy:3960
translate russian minami_siscon_06b_421e2700_2:
    mike.say "Минами..."

# ch/minami/events.rpy:3961
translate russian minami_siscon_06b_c2ce4c6d:
    mike.say "Ну надо же было выкинуть такую глупость!"

# ch/minami/events.rpy:3962
translate russian minami_siscon_06b_1aeb3a21:
    mike.say "У нас нет времени на твоё дефиле в трусах!"

# ch/minami/events.rpy:3964
translate russian minami_siscon_06b_87bbf762:
    "Настроение Минами мгновенно меняется."

# ch/minami/events.rpy:3965
translate russian minami_siscon_06b_6012ce36:
    "Она опускает взгляд и словно становится меньше."

# ch/minami/events.rpy:3966
translate russian minami_siscon_06b_17c96455:
    "Вся власть, которой она обладала мгновение назад, исчезает."

# ch/minami/events.rpy:3967
translate russian minami_siscon_06b_813d0d0d:
    "Теперь она похожа на глупую девчонку, которую отругал взрослый."

# ch/minami/events.rpy:3969
translate russian minami_siscon_06b_3aa6a2be:
    minami.say "Н... не обязательно быть таким злым, братик!"

# ch/minami/events.rpy:3971
translate russian minami_siscon_06b_c5726140:
    minami.say "Я просто примеряла вещи..."

# ch/minami/events.rpy:3972
translate russian minami_siscon_06b_073ecca2:
    minami.say "Я... я всё сниму, ладно?"

# ch/minami/events.rpy:3974
translate russian minami_siscon_06b_e3099596:
    "Я ожидал, что Минами тут же огрызнётся."

# ch/minami/events.rpy:3975
translate russian minami_siscon_06b_42873909:
    "Что устроит в примерочной одну из своих знаменитых истерик."

# ch/minami/events.rpy:3976
translate russian minami_siscon_06b_ddbc842a:
    "Но теперь боюсь, что она расплачется."

# ch/minami/events.rpy:3977
translate russian minami_siscon_06b_62ee23de:
    mike.say "Прости, Минами."

# ch/minami/events.rpy:3978
translate russian minami_siscon_06b_9056f59e:
    mike.say "Наверное, я был слишком резок."

# ch/minami/events.rpy:3979
translate russian minami_siscon_06b_69abff60:
    mike.say "Но Рождество уже совсем близко, понимаешь?"

# ch/minami/events.rpy:3980
translate russian minami_siscon_06b_214f40b1:
    mike.say "А до праздника ещё столько нужно успеть."

# ch/minami/events.rpy:3982
translate russian minami_siscon_06b_f0b7c380:
    "Минами кивает, но всё же слегка шмыгает носом."

# ch/minami/events.rpy:3984
translate russian minami_siscon_06b_dea3f1b4:
    "Она закрывает занавеску и переодевается обратно."

# ch/minami/events.rpy:3988
translate russian minami_siscon_06b_26444ed1:
    "И всё оставшееся время в торговом центре ведёт себя тихо."

# ch/minami/events.rpy:3989
translate russian minami_siscon_06b_6240081e:
    "Благодаря этому мы успеваем купить почти все рождественские подарки."

# ch/minami/events.rpy:3990
translate russian minami_siscon_06b_6b132adb:
    "Но зато я в итоге чувствую вину."

# ch/minami/events.rpy:3991
translate russian minami_siscon_06b_47ac7842:
    "Может, она с самого начала этого и добивалась?"

# ch/minami/events.rpy:3998
translate russian minami_siscon_06_985e3671:
    "Впервые с переезда Минами погода стала по-настоящему хорошей: жаркое солнце и синее безоблачное небо."

# ch/minami/events.rpy:3999
translate russian minami_siscon_06_bc98cc96:
    "Как обычно, все словно молча решили, что большую часть дня нужно провести у бассейна."

# ch/minami/events.rpy:4001
translate russian minami_siscon_06_be0f3757:
    "Я выхожу чуть позже, чем [bree.name], которая уже лежит на шезлонге в купальнике."

# ch/minami/events.rpy:4002
translate russian minami_siscon_06_40e54354:
    "Присоединится ли Саша или ещё немного побережёт свою бледную кожу — вопрос открытый."

# ch/minami/events.rpy:4003
translate russian minami_siscon_06_316b6aac:
    "Но Минами я точно жду: она была в восторге от того, что у нас есть собственный бассейн."

# ch/minami/events.rpy:4004
translate russian minami_siscon_06_0cde31ab:
    "Пока она где-то в доме, наверняка готовится к купанию."

# ch/minami/events.rpy:4005
translate russian minami_siscon_06_a2d4907a:
    "Я просто устраиваюсь на шезлонге рядом с [bree.name], охотно дожидаясь младшей сестры."

# ch/minami/events.rpy:4007
translate russian minami_siscon_06_15d58a38:
    "Услышав, как я сажусь рядом, [bree.name] довольно вздыхает и поднимает на меня улыбающееся лицо."

# ch/minami/events.rpy:4008
translate russian minami_siscon_06_508c7a05:
    bree.say "М-м-м..."

# ch/minami/events.rpy:4010
translate russian minami_siscon_06_bedb91e4:
    bree.say "Что сегодня с солнцем, [lssb_minami.hero_name()]?"

# ch/minami/events.rpy:4011
translate russian minami_siscon_06_5061347a:
    bree.say "Я уже нанесла солнцезащитный крем."

# ch/minami/events.rpy:4013
translate russian minami_siscon_06_14a0a04a:
    bree.say "Но всё равно чувствую, будто здесь зажариваюсь!"

# ch/minami/events.rpy:4015
translate russian minami_siscon_06_fc7d147b:
    mike.say "Да, сегодня безумно жарко."

# ch/minami/events.rpy:4016
translate russian minami_siscon_06_407d21fc:
    mike.say "Может, нанести ещё один слой?"

# ch/minami/events.rpy:4017
translate russian minami_siscon_06_641850c4:
    "[bree.name] стонет и лениво потягивается, напоминая обессиленную кошку."

# ch/minami/events.rpy:4019
translate russian minami_siscon_06_5e1ebec3:
    bree.say "Ох, у меня совсем нет сил двигаться."

# ch/minami/events.rpy:4021
translate russian minami_siscon_06_8d71f221:
    bree.say "Знаю, с моей стороны это наглость, но ты не мог бы..."

# ch/minami/events.rpy:4023
translate russian minami_siscon_06_c29c3b8d:
    "Не мог бы я намазать кремом мою горячую соседку-блондинку, лежащую в купальнике?!"

# ch/minami/events.rpy:4024
translate russian minami_siscon_06_caeeadc8:
    "Неудивительно, что [bree.name] даже не стала договаривать просьбу!"

# ch/minami/events.rpy:4025
translate russian minami_siscon_06_c839f4f6:
    "Через секунду крем уже у меня в руке, и я выдавливаю щедрую порцию на потные ладони."

# ch/minami/events.rpy:4026
translate russian minami_siscon_06_33006293:
    "[bree.name] лениво и томно улыбается, пока я склоняюсь над ней в предвкушении."

# ch/minami/events.rpy:4027
translate russian minami_siscon_06_569103a2:
    "Лёжа на животе, она вдруг заводит руки за спину и развязывает верх купальника."

# ch/minami/events.rpy:4028
translate russian minami_siscon_06_5146a4c1:
    "Она видит, как расширяются мои глаза, и наверняка слышит, как я ошеломлённо сглатываю."

# ch/minami/events.rpy:4030
translate russian minami_siscon_06_1e69da70:
    bree.say "В чём дело, [lssb_minami.hero_name()]?"

# ch/minami/events.rpy:4031
translate russian minami_siscon_06_24af3650:
    bree.say "Ты ведь не хочешь, чтобы у меня остались некрасивые полоски от загара?"

# ch/minami/events.rpy:4033
translate russian minami_siscon_06_f99b43d5:
    "Я качаю головой, уже протягивая руки, чтобы приступить к порученному делу."

# ch/minami/events.rpy:4034
translate russian minami_siscon_06_691729f8:
    "Решив сделать всё тщательно, я начинаю с затылка [bree.name] и постепенно спускаюсь по спине."

# ch/minami/events.rpy:4035
translate russian minami_siscon_06_86f8bab2:
    "Кажется правильным заодно помассировать кожу — просто чтобы крем хорошо впитался."

# ch/minami/events.rpy:4036
translate russian minami_siscon_06_dc0d50f5:
    "[bree.name] подбадривает меня частыми вздохами и довольными звуками, давая понять, что я отлично справляюсь."

# ch/minami/events.rpy:4037
translate russian minami_siscon_06_faa1f5a1:
    "К концу мне кажется, будто весь жар из её тела перешёл в моё!"

# ch/minami/events.rpy:4041
translate russian minami_siscon_06_25fc4f33:
    minami.say "Ого, братик, ты прямо профессиональный массажист!"

# ch/minami/events.rpy:4043
translate russian minami_siscon_06_3f9cc79f:
    "Услышав Минами, я резко оборачиваюсь и краснею от смущения."

# ch/minami/events.rpy:4044
translate russian minami_siscon_06_3f718e1a:
    "Она стоит в паре шагов от шезлонгов с широкой улыбкой."

# ch/minami/events.rpy:4045
translate russian minami_siscon_06_a9ddfb17:
    "Минами босиком, поэтому ни один из нас не мог услышать, как она подошла."

# ch/minami/events.rpy:4046
translate russian minami_siscon_06_e7541d1a:
    "Хуже того, я никак не могу узнать, сколько она уже наблюдает!"

# ch/minami/events.rpy:4048
translate russian minami_siscon_06_54e49dae:
    minami.say "Не сделаешь мне то же самое, что только что получила [bree.name]?"

# ch/minami/events.rpy:4049
translate russian minami_siscon_06_2e6f6600:
    minami.say "Боюсь пропустить какое-нибудь место."

# ch/minami/events.rpy:4050
translate russian minami_siscon_06_84d69ca9:
    minami.say "Ты же знаешь, как легко я обгораю?"

# ch/minami/events.rpy:4052
translate russian minami_siscon_06_5f3dac6a:
    "Какое-то время я смотрю на Минами, пытаясь решить, как лучше поступить."

# ch/minami/events.rpy:4053
translate russian minami_siscon_06_690d7092:
    "На ней бикини, почти ничего не оставляющее воображению, без полотенца или парео сверху."

# ch/minami/events.rpy:4054
translate russian minami_siscon_06_3bfb2bb7:
    "Даже на таком расстоянии я с неприятной остротой замечаю, как оно подчёркивает её фигуру."

# ch/minami/events.rpy:4055
translate russian minami_siscon_06_b226b718:
    "Да, Минами миниатюрная и совсем не пышногрудая."

# ch/minami/events.rpy:4056
translate russian minami_siscon_06_6d6cc02e:
    "Но нельзя отрицать: пока меня не было дома, она стала женщиной..."

# ch/minami/events.rpy:4059
translate russian minami_siscon_06_61efeee3:
    "Возможно, я лицемерю, и стоило подумать, прежде чем соглашаться помочь [bree.name]."

# ch/minami/events.rpy:4060
translate russian minami_siscon_06_a070c2df:
    "Но всё-таки между соседкой и младшей сестрой должна быть разница, правда?"

# ch/minami/events.rpy:4061
translate russian minami_siscon_06_8308005c:
    "Если я исполню её просьбу, то лишь обману себя, считая это совершенно невинным."

# ch/minami/events.rpy:4062
translate russian minami_siscon_06_9c16a374:
    "Ведь я едва могу смотреть на Минами в этом купальнике дольше пары секунд, прежде чем становится неловко."

# ch/minami/events.rpy:4063
translate russian minami_siscon_06_3cdf5330:
    "Меньше всего мне нужно делать что-то, что подтолкнёт смотреть на неё именно так."

# ch/minami/events.rpy:4064
translate russian minami_siscon_06_288f3337:
    mike.say "Да ладно, Минами, очнись!"

# ch/minami/events.rpy:4065
translate russian minami_siscon_06_2f5ea9c1:
    mike.say "От чего у тебя предыдущий раб умер?"

# ch/minami/events.rpy:4067
translate russian minami_siscon_06_7d10d565:
    "[bree.name] не может сдержать смех."

# ch/minami/events.rpy:4068
translate russian minami_siscon_06_72985edb:
    "Она пытается прикрыть рот, но уже поздно."

# ch/minami/events.rpy:4070
translate russian minami_siscon_06_8f638fa4:
    "Минами мрачнеет и откровенно дуется из-за отказа."

# ch/minami/events.rpy:4071
translate russian minami_siscon_06_6a5c61a1:
    "Она скрещивает руки на груди и даже демонстративно топает ногой."

# ch/minami/events.rpy:4072
translate russian minami_siscon_06_94df3d6d:
    "Видимо, так она пытается выглядеть грозно."

# ch/minami/events.rpy:4073
translate russian minami_siscon_06_030ac261:
    "Но все её старания делают её лишь милой, словно сердитого щенка."

# ch/minami/events.rpy:4075
translate russian minami_siscon_06_53e85f19:
    minami.say "Эй, это нечестно!"

# ch/minami/events.rpy:4076
translate russian minami_siscon_06_d0f1e98e:
    minami.say "Почему для [bree.name] ты это делаешь, а для меня нет?!"

# ch/minami/events.rpy:4078
translate russian minami_siscon_06_7914ba57:
    "Я бросаю на [bree.name] раздражённый взгляд и для пущего эффекта закатываю глаза."

# ch/minami/events.rpy:4079
translate russian minami_siscon_06_724446f1:
    mike.say "Эм, может, потому что она попросила как взрослая, Минами."

# ch/minami/events.rpy:4080
translate russian minami_siscon_06_271469cd:
    mike.say "А не как капризный ребёнок!"

# ch/minami/events.rpy:4082
translate russian minami_siscon_06_30b89321:
    "Рот Минами буквально распахивается от изумления."

# ch/minami/events.rpy:4083
translate russian minami_siscon_06_51138351:
    "Мгновение она стоит неподвижно, словно статуя."

# ch/minami/events.rpy:4085
translate russian minami_siscon_06_ca8d15ab:
    "Потом упирает кулак в бок и указывает на меня другой рукой."

# ch/minami/events.rpy:4087
translate russian minami_siscon_06_576ac1e1:
    minami.say "Что за дела, братик?"

# ch/minami/events.rpy:4088
translate russian minami_siscon_06_08c72aab:
    minami.say "Ты должен хорошо ко мне относиться, пока я здесь живу."

# ch/minami/events.rpy:4089
translate russian minami_siscon_06_d4adad2a:
    minami.say "А это было просто злобно!"

# ch/minami/events.rpy:4091
translate russian minami_siscon_06_63fbea20:
    "Я отмахиваюсь от её слов, наслаждаясь тем, как легко игнорировать эту маленькую истерику."

# ch/minami/events.rpy:4092
translate russian minami_siscon_06_f403b126:
    "К тому же приятно, что [bree.name] видит, как легко и по-взрослому я справляюсь с Минами."

# ch/minami/events.rpy:4093
translate russian minami_siscon_06_68a96c2c:
    mike.say "Как скажешь, Минами."

# ch/minami/events.rpy:4094
translate russian minami_siscon_06_d25eda13:
    mike.say "Но я почти уверен, что это не включает втирание крема в твою задницу!"

# ch/minami/events.rpy:4096
translate russian minami_siscon_06_64a33826:
    minami.say "У-у, как же ты меня иногда бесишь!"

# ch/minami/events.rpy:4097
translate russian minami_siscon_06_86acf21c:
    minami.say "Вот расскажу маме с папой, что ты сделал!"

# ch/minami/events.rpy:4098
translate russian minami_siscon_06_1517dff0:
    minami.say "Тебе очень достанется, братик!"

# ch/minami/events.rpy:4102
translate russian minami_siscon_06_bb9e55bb:
    "С этими словами она разворачивается на пятках и сердито уходит в дом."

# ch/minami/events.rpy:4103
translate russian minami_siscon_06_853f9fc6:
    "[bree.name] смотрит на меня с лёгкой тревогой."

# ch/minami/events.rpy:4104
translate russian minami_siscon_06_9d196e58:
    "Я лишь снова пожимаю плечами, показывая, что беспокоиться не о чем."

# ch/minami/events.rpy:4105
translate russian minami_siscon_06_40cf4bf2:
    mike.say "Ну так, [bree.name], на чём мы остановились?"

# ch/minami/events.rpy:4106
translate russian minami_siscon_06_ef12790c:
    mike.say "Уверена, что на ногах достаточно крема?"

# ch/minami/events.rpy:4108
translate russian minami_siscon_06_5163f177:
    "Если я откажусь сделать то же самое для Минами, то фактически признаю себя лицемером."

# ch/minami/events.rpy:4109
translate russian minami_siscon_06_1cf7c24f:
    "Хуже того, извращенцем, который помогает девушке только ради дешёвого удовольствия."

# ch/minami/events.rpy:4110
translate russian minami_siscon_06_1b104087:
    "К тому же нужно избавиться от этих глупых комплексов насчёт Минами и её тела."

# ch/minami/events.rpy:4111
translate russian minami_siscon_06_08f2b9ee:
    "Не могу же я вечно отводить глаза каждый раз, когда она входит в чём-то чуть более открытом."

# ch/minami/events.rpy:4112
translate russian minami_siscon_06_2808577e:
    "Пожалуй, нужно начать видеть в Минами взрослую, ведь она уже точно не ребёнок!"

# ch/minami/events.rpy:4113
translate russian minami_siscon_06_2b4eddf8:
    mike.say "А, да, думаю, можно, Минами."

# ch/minami/events.rpy:4114
translate russian minami_siscon_06_92255e3c:
    mike.say "Давай ложись на этот шезлонг."

# ch/minami/events.rpy:4115
translate russian minami_siscon_06_8cdd8c51:
    mike.say "Я намажу тебя, пока ты лежишь."

# ch/minami/events.rpy:4117
translate russian minami_siscon_06_7543de75:
    "Минами кивает и улыбается, явно радуясь, как легко добилась своего."

# ch/minami/events.rpy:4119
translate russian minami_siscon_06_11647521:
    "Но когда она спешит к шезлонгу, я замечаю, как [bree.name] поднимает брови."

# ch/minami/events.rpy:4120
translate russian minami_siscon_06_12959d9b:
    "В ответ я качаю головой, отвергая её невысказанный вопрос."

# ch/minami/events.rpy:4122
translate russian minami_siscon_06_0d506679:
    minami.say "Ой, мне тоже лучше снять верх."

# ch/minami/events.rpy:4123
translate russian minami_siscon_06_f1f4ff5f:
    minami.say "Я ведь тоже не хочу полосок от загара!"

# ch/minami/events.rpy:4125
translate russian minami_siscon_06_276bb235:
    mike.say "Конечно, Минами."

# ch/minami/events.rpy:4126
translate russian minami_siscon_06_745853a3:
    mike.say "Как скажешь..."

# ch/minami/events.rpy:4128
translate russian minami_siscon_06_92707544:
    "Мои глаза становятся всё шире, пока Минами развязывает лиф бикини."

# ch/minami/events.rpy:4129
translate russian minami_siscon_06_c1a80f5a:
    "Я вижу, как её небольшая, но безупречная грудь поддаётся силе тяжести..."

# ch/minami/events.rpy:4130
translate russian minami_siscon_06_59c55cf0:
    "О боже, что я вообще делаю?!"

# ch/minami/events.rpy:4131
translate russian minami_siscon_06_ed010557:
    "Из-за собственной младшей сестры у меня уже встаёт."

# ch/minami/events.rpy:4132
translate russian minami_siscon_06_ffa3714d:
    "А я ещё даже пальцем её не коснулся!"

# ch/minami/events.rpy:4134
translate russian minami_siscon_06_52bffa12:
    minami.say "Вот так, братик."

# ch/minami/events.rpy:4136
translate russian minami_siscon_06_7a20297d:
    minami.say "Только не волнуйся, можешь не осторожничать."

# ch/minami/events.rpy:4137
translate russian minami_siscon_06_8cc2b5d8:
    minami.say "Иногда мне нравится погрубее..."

# ch/minami/events.rpy:4141
translate russian minami_siscon_06_91d9ed9a:
    "Выдавливая крем на ладонь, я стараюсь не вникать в слова Минами."

# ch/minami/events.rpy:4142
translate russian minami_siscon_06_197864a2:
    "Нужно просто воспринимать это как одолжение или как работу настоящего массажиста."

# ch/minami/events.rpy:4143
translate russian minami_siscon_06_378aa1e7:
    "Но едва я кладу руки ей на плечи, как она издаёт глубокий, почти чувственный стон."

# ch/minami/events.rpy:4144
translate russian minami_siscon_06_7df764da:
    minami.say "М-м-м..."

# ch/minami/events.rpy:4146
translate russian minami_siscon_06_6e3afaad:
    minami.say "Как же ХОРОШО, братик."

# ch/minami/events.rpy:4147
translate russian minami_siscon_06_b42f416f:
    minami.say "У тебя будто волшебные руки!"

# ch/minami/events.rpy:4149
translate russian minami_siscon_06_1d5c8a2a:
    "Я снова пытаюсь не замечать подтекста в её словах и звуках."

# ch/minami/events.rpy:4150
translate russian minami_siscon_06_5d5648e5:
    "Но Минами лишь усугубляет положение, так же реагируя на мои прикосновения."

# ch/minami/events.rpy:4151
translate russian minami_siscon_06_e032148b:
    "Куда бы ни двигались руки, она дрожит и вздрагивает, словно возбуждаясь от прикосновений."

# ch/minami/events.rpy:4152
translate russian minami_siscon_06_8a080ba3:
    "А когда я наконец добираюсь до талии, она приподнимает попку, будто не может сдержаться!"

# ch/minami/events.rpy:4153
translate russian minami_siscon_06_3e0e237c:
    mike.say "ЛАДНО... то есть ладно..."

# ch/minami/events.rpy:4154
translate russian minami_siscon_06_df51687e:
    mike.say "Всё, Минами, я закончил!"

# ch/minami/events.rpy:4155
translate russian minami_siscon_06_033c14bf:
    mike.say "То есть... с тобой закончили."

# ch/minami/events.rpy:4157
translate russian minami_siscon_06_c0a397e5:
    "Минами оглядывается через плечо, и её широко раскрытые глаза тревожно напоминают взгляд возбуждённой женщины."

# ch/minami/events.rpy:4159
translate russian minami_siscon_06_38c03550:
    minami.say "Ах, спасибо, братик."

# ch/minami/events.rpy:4160
translate russian minami_siscon_06_0f639bc4:
    minami.say "Ты втирал ТАК глубоко."

# ch/minami/events.rpy:4161
translate russian minami_siscon_06_73104c7c:
    minami.say "Будто я чувствовала твои прикосновения изнутри..."

# ch/minami/events.rpy:4163
translate russian minami_siscon_06_f8515cb1:
    "После этого я решаю, что пора окунуться в холодную воду бассейна."

# ch/minami/events.rpy:4164
translate russian minami_siscon_06_2dd22aba:
    "И держусь в воде по пояс, пока не убеждаюсь, что можно снова безопасно показаться..."

# ch/minami/events.rpy:4166
translate russian minami_siscon_06_80f2fade:
    "Больше я от этого не прячусь. Мои руки были на её прекрасном маленьком теле, и я с радостью повторил бы всё на глазах у всего дома."

# ch/minami/events.rpy:4168
translate russian minami_siscon_06_52a97167:
    "Я давно перестал притворяться, что это невинно. Под моими руками стонала женщина, и всё во мне это понимало."

# ch/minami/events.rpy:4170
translate russian minami_siscon_06_4441a292:
    "Нельзя и дальше называть это братской заботой. Она моя младшая сестра, а я только что десять минут боролся с тем, как приятно к ней прикасаться."

# ch/minami/events.rpy:4177
translate russian minami_siscon_05_421328b3:
    "Я слышу, что Минами с чем-то не справляется, ещё до того, как вижу её, и сразу спешу помочь."

# ch/minami/events.rpy:4178
translate russian minami_siscon_05_2d6beace:
    "Но оказывается, я немного опоздал: подхожу как раз в тот момент, когда она роняет охапку книг на пол."

# ch/minami/events.rpy:4179
translate russian minami_siscon_05_97219953:
    "Она громко ругается, давая понять, что после моего отъезда выучила несколько новых ругательств."

# ch/minami/events.rpy:4181
translate russian minami_siscon_05_87fb2fa1:
    minami.say "Ах, чёрт, чёрт... блядь!"

# ch/minami/events.rpy:4183
translate russian minami_siscon_05_80d97d51:
    "Затем сразу приседает и начинает собирать книги."

# ch/minami/events.rpy:4184
translate russian minami_siscon_05_6201d6e8:
    "Мне остаётся опуститься на колени и помочь, взяв на себя самые большие тома."

# ch/minami/events.rpy:4185
translate russian minami_siscon_05_5a6160a4:
    mike.say "Не пытайся унести всё сразу, Минами."

# ch/minami/events.rpy:4186
translate russian minami_siscon_05_b41af6eb:
    mike.say "Давай помогу, ладно?"

# ch/minami/events.rpy:4188
translate russian minami_siscon_05_24aec89a:
    "Минами поднимает глаза и дарит мне одну из тех милых улыбок, с которыми я всегда её связываю."

# ch/minami/events.rpy:4190
translate russian minami_siscon_05_dc35049c:
    minami.say "Спасибо, братик."

# ch/minami/events.rpy:4191
translate russian minami_siscon_05_aed0d03c:
    minami.say "Глупо было думать, что справлюсь одна!"

# ch/minami/events.rpy:4193
translate russian minami_siscon_05_2f542e82:
    "Я улыбаюсь в ответ, даже не спрашивая, для чего все эти книги."

# ch/minami/events.rpy:4194
translate russian minami_siscon_05_af08aff7:
    "Каждая — учебник, и на каждой знакомая наклейка библиотеки колледжа."

# ch/minami/events.rpy:4195
translate russian minami_siscon_05_b395b066:
    "Мы встаём, Минами направляется в свою спальню на чердаке, а я следую за ней."

# ch/minami/events.rpy:4196
translate russian minami_siscon_05_e730e257:
    mike.say "Вам правда столько задали читать на первый семестр?"

# ch/minami/events.rpy:4198
translate russian minami_siscon_05_3a469a6d:
    minami.say "А ты думаешь, я такое ради удовольствия читаю?!"

# ch/minami/events.rpy:4199
translate russian minami_siscon_05_d443ce78:
    minami.say "Это гораздо сложнее всего, что было в школе."

# ch/minami/events.rpy:4201
translate russian minami_siscon_05_967f1e66:
    minami.say "Мне уже кажется, что я отстаю, братик!"

# ch/minami/events.rpy:4203
translate russian minami_siscon_05_21c01ec0:
    "Я качаю головой и пожимаю плечами, чувствуя себя бессильным перед её трудностями."

# ch/minami/events.rpy:4204
translate russian minami_siscon_05_93ca2093:
    mike.say "Наверное, когда я только начал учиться, мне тоже приходилось продираться через такие горы."

# ch/minami/events.rpy:4205
translate russian minami_siscon_05_3e045bfc:
    mike.say "Видимо, мозг справился с травмой, заставив меня обо всём забыть."

# ch/minami/events.rpy:4206
translate russian minami_siscon_05_2fe98615:
    mike.say "Или я сжёг достаточно мозговых клеток, чтобы стереть это из памяти."

# ch/minami/events.rpy:4210
translate russian minami_siscon_05_0031a66e:
    "У подножия лестницы на чердак Минами останавливается и бросает на меня свой особый косой взгляд."

# ch/minami/events.rpy:4211
translate russian minami_siscon_05_70cc1860:
    "Я сразу настораживаюсь: так она обычно подготавливает почву для просьбы."

# ch/minami/events.rpy:4212
translate russian minami_siscon_05_4015ebe3:
    mike.say "Минами, почему ты так на меня смотришь?"

# ch/minami/events.rpy:4214
translate russian minami_siscon_05_68c03180:
    minami.say "Ну-у-у..."

# ch/minami/events.rpy:4215
translate russian minami_siscon_05_955737d4:
    minami.say "Я тут подумала, что ты ведь хорошо учился в школе, братик."

# ch/minami/events.rpy:4216
translate russian minami_siscon_05_d1004634:
    minami.say "И маме с папой всегда говорил, что в колледже тоже справляешься..."

# ch/minami/events.rpy:4218
translate russian minami_siscon_05_67d5b96e:
    mike.say "Угх..."

# ch/minami/events.rpy:4219
translate russian minami_siscon_05_950883f3:
    mike.say "Ну же, Минами, выкладывай!"

# ch/minami/events.rpy:4221
translate russian minami_siscon_05_5feb3439:
    minami.say "Что, если ты мне немного поможешь?"

# ch/minami/events.rpy:4222
translate russian minami_siscon_05_5bff4640:
    minami.say "Я не прошу помогать списывать или что-то такое."

# ch/minami/events.rpy:4223
translate russian minami_siscon_05_d3b0f167:
    minami.say "Просто подскажешь кое-что, как репетитор."

# ch/minami/events.rpy:4224
translate russian minami_siscon_05_fe6f9be3:
    minami.say "Только лучше, потому что это будешь ты, а не какой-нибудь старый зануда!"

# ch/minami/events.rpy:4228
translate russian minami_siscon_05_6eadf2b9:
    mike.say "А, не знаю, хорошая ли это идея, Минами."

# ch/minami/events.rpy:4230
translate russian minami_siscon_05_17131b64:
    "Я вижу, как по лицу Минами пробегает разочарование."

# ch/minami/events.rpy:4232
translate russian minami_siscon_05_430dfdf9:
    minami.say "Ну-у..."

# ch/minami/events.rpy:4233
translate russian minami_siscon_05_45ea32e2:
    minami.say "ПОЖАЛУЙСТА, братик."

# ch/minami/events.rpy:4234
translate russian minami_siscon_05_0ecd0637:
    minami.say "Ты такой умный, тебе будет легко. Я точно знаю!"

# ch/minami/events.rpy:4236
translate russian minami_siscon_05_9347e82d:
    "Минами всегда умела щедро льстить, когда хотела."

# ch/minami/events.rpy:4237
translate russian minami_siscon_05_b1d8b762:
    "Но лесть не меняет того, что мне совсем не хочется этим заниматься."

# ch/minami/events.rpy:4238
translate russian minami_siscon_05_922482d0:
    mike.say "Нет, Минами, я правда не могу."

# ch/minami/events.rpy:4239
translate russian minami_siscon_05_fd75db6e:
    mike.say "Я и со своей учёбой отстаю."

# ch/minami/events.rpy:4240
translate russian minami_siscon_05_44df1940:
    mike.say "К тому же у тебя совсем другая специальность."

# ch/minami/events.rpy:4241
translate russian minami_siscon_05_9167138d:
    mike.say "Я даже не знал бы, с чего начать."

# ch/minami/events.rpy:4243
translate russian minami_siscon_05_b0ffccbb:
    minami.say "Тогда я научу тебя, чтобы ты мог научить меня, да?"

# ch/minami/events.rpy:4245
translate russian minami_siscon_05_6e232ee3:
    "Я качаю головой, ставлю книги на нижнюю ступеньку и начинаю отступать."

# ch/minami/events.rpy:4247
translate russian minami_siscon_05_62ee23de:
    mike.say "Прости, Минами."

# ch/minami/events.rpy:4248
translate russian minami_siscon_05_7e681156:
    mike.say "Может, посмотришь доску объявлений в колледже?"

# ch/minami/events.rpy:4249
translate russian minami_siscon_05_e703d40c:
    mike.say "Обычно каждый семестр несколько старшекурсников предлагают услуги репетиторов."

# ch/minami/events.rpy:4251
translate russian minami_siscon_05_de9a94d0:
    "С этими словами я разворачиваюсь и ухожу, давая понять, что разговор окончен."

# ch/minami/events.rpy:4252
translate russian minami_siscon_05_e65d7dfd:
    "Конечно, мне нехорошо оттого, что я фактически оставляю Минами разбираться самой."

# ch/minami/events.rpy:4253
translate russian minami_siscon_05_e48bcbfe:
    "Но это лишь часть навыков, которым ей придётся научиться."

# ch/minami/events.rpy:4254
translate russian minami_siscon_05_795c0dff:
    "Они понадобятся, чтобы выжить в большом и злом мире."

# ch/minami/events.rpy:4256
translate russian minami_siscon_05_b9031de0:
    "Я уже готов твёрдо отказать Минами."

# ch/minami/events.rpy:4257
translate russian minami_siscon_05_f10080b1:
    "Но тут нахлынули новые воспоминания о моём первом семестре."

# ch/minami/events.rpy:4258
translate russian minami_siscon_05_791c8beb:
    "Я вспоминаю, как тяжело мне было вникать в учёбу."

# ch/minami/events.rpy:4259
translate russian minami_siscon_05_4d05d5c2:
    "Будь у меня помощник, всё прошло бы куда легче."

# ch/minami/events.rpy:4260
translate russian minami_siscon_05_122862d9:
    mike.say "Ладно, Минами. Выделю немного времени и помогу начать, хорошо?"

# ch/minami/events.rpy:4261
translate russian minami_siscon_05_6ec5eee1:
    mike.say "Но только с основами, понимаешь? Дам несколько советов по учёбе."

# ch/minami/events.rpy:4262
translate russian minami_siscon_05_96cb17e9:
    mike.say "Твоих предметов и курсов у меня никогда не было."

# ch/minami/events.rpy:4264
translate russian minami_siscon_05_0e81cc3a:
    "Улыбка Минами растягивается чуть ли не до ушей."

# ch/minami/events.rpy:4265
translate russian minami_siscon_05_a0cc5349:
    minami.say "Ох, спасибо, братик."

# ch/minami/events.rpy:4266
translate russian minami_siscon_05_591d9c62:
    minami.say "С ТВОЕЙ помощью я справлюсь с чем угодно!"

# ch/minami/events.rpy:4270
translate russian minami_siscon_05_44536978:
    "Минами ведёт меня наверх, на чердак, и бросает книги на кровать."

# ch/minami/events.rpy:4271
translate russian minami_siscon_05_da772124:
    "Я сразу вижу несколько вещей, которые можно изменить, чтобы ей легче училось."

# ch/minami/events.rpy:4272
translate russian minami_siscon_05_8ddc157c:
    mike.say "Ты занимаешься за столом, Минами?"

# ch/minami/events.rpy:4274
translate russian minami_siscon_05_fcb95c77:
    minami.say "Ну... да."

# ch/minami/events.rpy:4275
translate russian minami_siscon_05_065c8754:
    minami.say "А почему нет?"

# ch/minami/events.rpy:4277
translate russian minami_siscon_05_3674abb2:
    mike.say "Проблема в том, что там не очень-то порядок."

# ch/minami/events.rpy:4278
translate russian minami_siscon_05_e3fab8b6:
    "Я подзываю Минами и усаживаю на стул перед столом."

# ch/minami/events.rpy:4279
translate russian minami_siscon_05_1a7333e5:
    "Затем пододвигаю табурет и сажусь рядом."

# ch/minami/events.rpy:4280
translate russian minami_siscon_05_82e38b66:
    mike.say "Если организовать всё вот так, будет проще."

# ch/minami/events.rpy:4281
translate russian minami_siscon_05_654e6ede:
    "Я начинаю переставлять книги и раскладывать канцелярские принадлежности."

# ch/minami/events.rpy:4282
translate russian minami_siscon_05_233a2c8e:
    "Минами следит за каждым движением, наклоняясь ближе, чтобы всё видеть."

# ch/minami/events.rpy:4284
translate russian minami_siscon_05_ecba2722:
    minami.say "А, поняла!"

# ch/minami/events.rpy:4285
translate russian minami_siscon_05_5816dff8:
    minami.say "Это очень помогает, братик."

# ch/minami/events.rpy:4287
translate russian minami_siscon_05_aa7ba853:
    "Только теперь я начинаю понимать, насколько она близко."

# ch/minami/events.rpy:4288
translate russian minami_siscon_05_ab31272e:
    "Затем чувствую её руку на своём бедре, скользящую вверх..."

# ch/minami/events.rpy:4289
translate russian minami_siscon_05_82c75539:
    "Минами поворачивает ко мне голову, и наши лица разделяет не больше пары сантиметров."

# ch/minami/events.rpy:4291
translate russian minami_siscon_05_9a9a86d5:
    minami.say "Я ТАК благодарна тебе за помощь, братик."

# ch/minami/events.rpy:4293
translate russian minami_siscon_05_49ca7822:
    minami.say "Иногда думаю, чему ещё ты мог бы меня научить..."

# ch/minami/events.rpy:4294
translate russian minami_siscon_05_0d676c53:
    "Голос у неё тихий, с придыханием, и будто полон скрытых смыслов."

# ch/minami/events.rpy:4295
translate russian minami_siscon_05_c8b5b33f:
    "Я никогда раньше не слышал, чтобы Минами так говорила, и совершенно теряюсь."

# ch/minami/events.rpy:4297
translate russian minami_siscon_05_7707c88e:
    "Я прекрасно понимаю, что она имеет в виду, потому что хочу того же. От её низкого голоса с придыханием все мысли занимает то, что она предлагает."

# ch/minami/events.rpy:4299
translate russian minami_siscon_05_2b03d121:
    "Этот голос ни с чем не спутаешь, как и то, что он со мной делает. Со мной флиртует женщина, и я больше не намерен притворяться, будто это не так."

# ch/minami/events.rpy:4301
translate russian minami_siscon_05_68734a72:
    "Жар и вина накатывают одновременно. Она моя младшая сестра, а часть меня хочет точно услышать, на что она намекает."

# ch/minami/events.rpy:4303
translate russian minami_siscon_05_ffdf9581:
    "Не знаю, что делать с этим чувством. Минами никогда не смущала меня так, и я не уверен, что мне нравится, насколько остро я всё замечаю."

# ch/minami/events.rpy:4305
translate russian minami_siscon_05_33e59ef7:
    "Я списываю это на то, что она, как всегда, увлеклась своей благодарностью. Просто младшая сестрёнка драматизирует."

# ch/minami/events.rpy:4306
translate russian minami_siscon_05_125b312c:
    "Но мгновение спустя меня отрезвляет ощущение её руки, добравшейся до паха..."

# ch/minami/events.rpy:4307
translate russian minami_siscon_05_b60321b7:
    mike.say "Ну... пока хватит, Минами!"

# ch/minami/events.rpy:4308
translate russian minami_siscon_05_795e6722:
    "Выпалив эти слова, я почти вскакиваю и едва не валюсь навзничь."

# ch/minami/events.rpy:4309
translate russian minami_siscon_05_492449a7:
    "Минами всё это, похоже, совершенно не смущает."

# ch/minami/events.rpy:4311
translate russian minami_siscon_05_4cbc32eb:
    "Она просто улыбается, само воплощение невинности."

# ch/minami/events.rpy:4312
translate russian minami_siscon_05_da6bd722:
    minami.say "Ещё раз спасибо, братик."

# ch/minami/events.rpy:4313
translate russian minami_siscon_05_c4b3dd86:
    minami.say "Не могу дождаться, чему ты научишь меня в следующий раз!"

# ch/minami/events.rpy:4322
translate russian minami_siscon_04_aac073a5:
    "Я крепко сплю, не замечая ничего вокруг, и не собираюсь просыпаться до утреннего будильника."

# ch/minami/events.rpy:4323
translate russian minami_siscon_04_7c4c7024:
    "Но тут кто-то начинает трясти меня, вырывая из сна и заставляя проснуться, хочу я того или нет."

# ch/minami/events.rpy:4324
translate russian minami_siscon_04_40eaa393:
    "Сначала я не понимаю, что могло меня разбудить: всё ещё расплывчато и непонятно."

# ch/minami/events.rpy:4330
translate russian minami_siscon_04_8473308a:
    "Затем внезапная вспышка света озаряет комнату даже сквозь закрытые жалюзи."

# ch/minami/events.rpy:4333
translate russian minami_siscon_04_4c697ace:
    "Страшный грохот сразу следом всё объясняет."

# ch/minami/events.rpy:4334
translate russian minami_siscon_04_e89a43df:
    "Снаружи гроза, и, судя по всему, весьма впечатляющая."

# ch/minami/events.rpy:4335
translate russian minami_siscon_04_9210cfdc:
    "Я переворачиваюсь, решив, что меня разбудил особенно громкий раскат."

# ch/minami/events.rpy:4336
translate russian minami_siscon_04_d1bb31e2:
    "Никогда не боялся такого, поэтому надеюсь без труда снова уснуть."

# ch/minami/events.rpy:4337
translate russian minami_siscon_04_6dcf78ad:
    "Но в паузе между раскатами замечаю ещё один звук."

# ch/minami/events.rpy:4339
translate russian minami_siscon_04_aac189cd:
    "Этот, в отличие от грома, доносится из дома."

# ch/minami/events.rpy:4340
translate russian minami_siscon_04_982f5a47:
    "А точнее — кто-то колотит в дверь моей спальни."

# ch/minami/events.rpy:4341
translate russian minami_siscon_04_60c47d30:
    "Пытаюсь не обращать внимания, надеясь, что желающий потревожить меня среди ночи поймёт намёк."

# ch/minami/events.rpy:4342
translate russian minami_siscon_04_b60cf107:
    "Но нет: стук становится всё отчаяннее."

# ch/minami/events.rpy:4343
translate russian minami_siscon_04_c8156a03:
    "Ругаясь себе под нос, я отбрасываю одеяло и спускаю ноги с кровати."

# ch/minami/events.rpy:4344
translate russian minami_siscon_04_502b63e0:
    "Для того, кто окажется за дверью, у меня уже готова отборная коллекция ругательств."

# ch/minami/events.rpy:4346
translate russian minami_siscon_04_c652a3fd:
    "Но, распахнув дверь, я вижу Минами."

# ch/minami/events.rpy:4347
translate russian minami_siscon_04_9f86297f:
    "Она плотно укутана в одеяло, а рука всё ещё поднята для очередного стука."

# ch/minami/events.rpy:4355
translate russian minami_siscon_04_46fb69a7:
    "Выражение лица трудно разобрать, но тут её освещает новая молния."

# ch/minami/events.rpy:4357
translate russian minami_siscon_04_dd7bad95:
    "Минами вздрагивает и испуганно взвизгивает, широко раскрыв полные страха глаза."

# ch/minami/events.rpy:4358
translate russian minami_siscon_04_4e7de801:
    "В этот момент она будто сошла с экрана ужастика, и я сам невольно вскрикиваю."

# ch/minami/events.rpy:4359
translate russian minami_siscon_04_a697d289:
    mike.say "Чёрт, Минами..."

# ch/minami/events.rpy:4360
translate russian minami_siscon_04_125570be:
    mike.say "Ты меня чуть до инфаркта не довела!"

# ch/minami/events.rpy:4361
translate russian minami_siscon_04_fbcce71e:
    mike.say "Чего тебе надо?!"

# ch/minami/events.rpy:4363
translate russian minami_siscon_04_eaf97e33:
    minami.say "Это гроза, братик."

# ch/minami/events.rpy:4364
translate russian minami_siscon_04_24e2d3cc:
    minami.say "Я там наверху совсем одна, и мне страшно!"

# ch/minami/events.rpy:4366
translate russian minami_siscon_04_5b9fe6de:
    "Ну конечно, в детстве Минами всегда ужасно боялась грома и молний."

# ch/minami/events.rpy:4367
translate russian minami_siscon_04_23b6cc21:
    "Наверное, я просто ошибочно решил, что она это уже переросла."

# ch/minami/events.rpy:4368
translate russian minami_siscon_04_5a61d2f7:
    "Не помогает и то, что на чердаке нет жалюзи."

# ch/minami/events.rpy:4369
translate russian minami_siscon_04_8d435d50:
    mike.say "Эм... ладно, Минами."

# ch/minami/events.rpy:4370
translate russian minami_siscon_04_fe9a031e:
    mike.say "Но чего ты от меня хочешь?"

# ch/minami/events.rpy:4372
translate russian minami_siscon_04_6eff69d0:
    "Минами делает шаг вперёд, почти переступая порог спальни."

# ch/minami/events.rpy:4374
translate russian minami_siscon_04_07676a3c:
    minami.say "Я хотела спросить..."

# ch/minami/events.rpy:4375
translate russian minami_siscon_04_69de1181:
    minami.say "Можно мне поспать с тобой?"

# ch/minami/events.rpy:4376
translate russian minami_siscon_04_48bf8965:
    minami.say "Только сегодня, пока не пройдёт гроза?"

# ch/minami/events.rpy:4380
translate russian minami_siscon_04_9dd93bbc:
    "Она это серьёзно?"

# ch/minami/events.rpy:4381
translate russian minami_siscon_04_dc2a03bc:
    "Минами уже почти совсем взрослая: начинает учиться в колледже и сама пробивает себе дорогу в жизни."

# ch/minami/events.rpy:4382
translate russian minami_siscon_04_4192c14f:
    "В детстве я бы без колебаний пустил её к себе в кровать."

# ch/minami/events.rpy:4383
translate russian minami_siscon_04_528259b8:
    "Но теперь мы взрослые, и это уже не кажется правильным."

# ch/minami/events.rpy:4384
translate russian minami_siscon_04_182aa658:
    "К тому же ей пора научиться полагаться на себя, если она хочет выжить в большом и злом мире."

# ch/minami/events.rpy:4386
translate russian minami_siscon_04_e3bee86b:
    mike.say "Хорошая попытка, Минами!"

# ch/minami/events.rpy:4387
translate russian minami_siscon_04_962bcc23:
    mike.say "Но ты уже большая."

# ch/minami/events.rpy:4388
translate russian minami_siscon_04_3fdf1406:
    mike.say "К тому же места в моей кровати нет: мне придётся спать на полу."

# ch/minami/events.rpy:4390
translate russian minami_siscon_04_7ec3c9bc:
    minami.say "Не-е-ет, братик!"

# ch/minami/events.rpy:4391
translate russian minami_siscon_04_a7719bc7:
    minami.say "Пожалуйста, разреши поспать с тобой."

# ch/minami/events.rpy:4392
translate russian minami_siscon_04_6c8e6508:
    minami.say "Я буду такой тихой, что ты меня даже не заметишь!"

# ch/minami/events.rpy:4393
translate russian minami_siscon_04_7bb5a1ba:
    mike.say "Я тебя не замечу, потому что тебя здесь не будет, Минами."

# ch/minami/events.rpy:4394
translate russian minami_siscon_04_bdf7adc4:
    mike.say "Не глупи, это просто гроза, и всё."

# ch/minami/events.rpy:4395
translate russian minami_siscon_04_ff0db0b0:
    mike.say "Завесь окно простынёй, если так легче."

# ch/minami/events.rpy:4396
translate russian minami_siscon_04_e6ee46c7:
    mike.say "Но больше меня не буди. Мне нужно выспаться!"

# ch/minami/events.rpy:4398
translate russian minami_siscon_04_9e933aa4:
    "Я закрываю дверь прежде, чем Минами успевает что-то сказать."

# ch/minami/events.rpy:4399
translate russian minami_siscon_04_45afb818:
    "Конечно, мне неприятно так с ней поступать."

# ch/minami/events.rpy:4400
translate russian minami_siscon_04_a13e2915:
    "Но, наверное, это и называют строгой заботой."

# ch/minami/events.rpy:4401
translate russian minami_siscon_04_b4a090fd:
    "Если я буду постоянно уступать и позволять ей всё, она никогда не научится справляться сама."

# ch/minami/events.rpy:4402
translate russian minami_siscon_04_44b22f87:
    "Остаётся надеяться, что гроза и грызущее чувство вины всё-таки дадут нормально поспать."

# ch/minami/events.rpy:4405
translate russian minami_siscon_04_f8c65517:
    mike.say "Ладно, Минами."

# ch/minami/events.rpy:4406
translate russian minami_siscon_04_26651252:
    mike.say "Если ты уверена, что только так сможешь уснуть."

# ch/minami/events.rpy:4408
translate russian minami_siscon_04_815291e2:
    "Минами сияет и спешит в комнату, довольная, что добилась своего."

# ch/minami/events.rpy:4409
translate russian minami_siscon_04_344050d9:
    "Она торопливо кивает, ожидая, пока я закрою за ней дверь."

# ch/minami/events.rpy:4411
translate russian minami_siscon_04_374ecd85:
    minami.say "Да, братик, уверена."

# ch/minami/events.rpy:4412
translate russian minami_siscon_04_dac5ed5a:
    minami.say "Просто хочу быть рядом с тем, кто напоминает мне о доме."

# ch/minami/events.rpy:4413
translate russian minami_siscon_04_5ddf5414:
    minami.say "С тем, с кем спокойно и кто, я знаю, меня защитит."

# ch/minami/events.rpy:4414
translate russian minami_siscon_04_785b7572:
    "Я возвращаюсь в кровать, а Минами обегает её с другой стороны."

# ch/minami/events.rpy:4415
translate russian minami_siscon_04_cc873bd0:
    "Меня поражает, какой странной была бы эта ситуация с любой другой девушкой."

# ch/minami/events.rpy:4416
translate russian minami_siscon_04_b6cf6a8a:
    "Но она моя младшая сестра, так что это всё равно что разделить с ней зонт под дождём."

# ch/minami/events.rpy:4417
translate russian minami_siscon_04_a7ed68d2:
    "Положив голову на подушку, я смотрю, как Минами сбрасывает с плеч простыню."

# ch/minami/events.rpy:4418
translate russian minami_siscon_04_c013f8b3:
    "На мгновение думаю, что на ней просто открытая пижама."

# ch/minami/events.rpy:4427
translate russian minami_siscon_04_5c16496a:
    "Но затем молния высвечивает очертания её тела."

# ch/minami/events.rpy:4428
translate russian minami_siscon_04_8818a44b:
    "И я впервые замечаю, что она совершенно голая."

# ch/minami/events.rpy:4432
translate russian minami_siscon_04_003c94db:
    "Не успеваю сказать ни слова, как следующий раскат грома заставляет её подпрыгнуть."

# ch/minami/events.rpy:4433
translate russian minami_siscon_04_0e96970f:
    "Минами тихонько вскрикивает и юркает под одеяло."

# ch/minami/events.rpy:4437
translate russian minami_siscon_04_47e7e040:
    "Я ожидал, что она будет держаться на расстоянии, но вместо этого она буквально цепляется за меня."

# ch/minami/events.rpy:4439
translate russian minami_siscon_04_9e680d55:
    minami.say "Ох, братик..."

# ch/minami/events.rpy:4440
translate russian minami_siscon_04_5b3820fa:
    minami.say "Мне так страшно!"

# ch/minami/events.rpy:4441
translate russian minami_siscon_04_60097f78:
    minami.say "Обними меня, как раньше дома!"

# ch/minami/events.rpy:4443
translate russian minami_siscon_04_dd290ee6:
    "С этими словами она придвигается попкой к моему паху и оборачивает мои руки вокруг себя."

# ch/minami/events.rpy:4444
translate russian minami_siscon_04_cd261401:
    "Целую вечность, как мне кажется, я боюсь пошевелиться и даже вдохнуть."

# ch/minami/events.rpy:4445
translate russian minami_siscon_04_330e90af:
    "Я всегда старался не замечать, какое у Минами потрясающее тело."

# ch/minami/events.rpy:4446
translate russian minami_siscon_04_6c51f1af:
    "Но теперь чувствую почти каждый его сантиметр."

# ch/minami/events.rpy:4447
translate russian minami_siscon_04_bb2caf6d:
    "Она прижимается ко мне, и между нами лишь мои трусы и футболка."

# ch/minami/events.rpy:4449
translate russian minami_siscon_04_7df764da:
    minami.say "М-м-м..."

# ch/minami/events.rpy:4450
translate russian minami_siscon_04_6e9dc3e1:
    minami.say "Как приятно, братик."

# ch/minami/events.rpy:4451
translate russian minami_siscon_04_7b97ebe2:
    minami.say "У тебя такие сильные руки. Здесь я в полной безопасности..."

# ch/minami/events.rpy:4453
translate russian minami_siscon_04_fdbf6f60:
    "В её голос уже прокрадывается сон."

# ch/minami/events.rpy:4454
translate russian minami_siscon_04_75b16bfd:
    "Устраиваясь переждать грозу, она прижимается ко мне ещё теснее."

# ch/minami/events.rpy:4455
translate russian minami_siscon_04_8c33f93e:
    "В такие минуты хочется уметь просто отключать мужские инстинкты."

# ch/minami/events.rpy:4456
translate russian minami_siscon_04_97e1ab23:
    "Потому что, лёжа без сна и всё осознавая, я чувствую, как это начинается."

# ch/minami/events.rpy:4457
translate russian minami_siscon_04_7fadc019:
    "Как ни сопротивляюсь, член начинает твердеть в трусах."

# ch/minami/events.rpy:4458
translate russian minami_siscon_04_7bd1bf69:
    "Остаётся лежать тихо и неподвижно, молясь, чтобы Минами не почувствовала вызванную ею эрекцию."

# ch/minami/events.rpy:4460
translate russian minami_siscon_04_bd7a4f66:
    "В какой-то момент в темноте я перестаю бороться. Она прижата ко мне всем телом, каждым мягким изгибом."

# ch/minami/events.rpy:4462
translate russian minami_siscon_04_2a03a52b:
    "Больше невозможно притворяться, что ей нужно лишь утешение, и гроза здесь далеко не главное."

# ch/minami/events.rpy:4464
translate russian minami_siscon_04_1e4a3029:
    "Я лежу, немного ненавидя себя. Она моя сестра, и я не должен так остро ощущать каждое мягкое место, которым она прижимается ко мне."

# ch/minami/events.rpy:4466
translate russian minami_siscon_04_74e16fe7:
    "Меня тревожит, насколько приятно ощущать её рядом. Я не имею права так думать о Минами, но всё равно думаю."

# ch/minami/events.rpy:4468
translate russian minami_siscon_04_519abb7d:
    "Это просто моя испуганная младшая сестрёнка, всё та же, что в детстве забиралась ко мне в кровать во время грозы. Я обнимаю её, потому что так поступают старшие братья."

# ch/minami/events.rpy:4469
translate russian minami_siscon_04_6883cb51:
    "Кто знает, может, я усну и всё само пройдёт?"

# ch/minami/events.rpy:4470
translate russian minami_siscon_04_b0a63ec6:
    "Или потеряю сознание оттого, что мозгу не хватает крови, либо просто от стыда..."

# ch/minami/events.rpy:4477
translate russian minami_siscon_03_3de98504:
    "Без [bree.name] и Саши в доме было довольно тихо."

# ch/minami/events.rpy:4479
translate russian minami_siscon_03_4f37bf36:
    "Никогда не думал, что появление всего одного нового жильца в доме, где мы с Сашей живём, обернётся таким."

# ch/minami/events.rpy:4481
translate russian minami_siscon_03_8d9cb225:
    "Никогда не думал, что появление всего одного нового жильца в доме, где мы с [bree.name] живём, обернётся таким."

# ch/minami/events.rpy:4483
translate russian minami_siscon_03_50ae4deb:
    "Никогда не думал, что появление всего одного нового жильца в доме, где мы с [bree.name] и Сашей живём, обернётся таким."

# ch/minami/events.rpy:4484
translate russian minami_siscon_03_47564929:
    "Вдруг дом стал тесным, и мне хочется проводить побольше времени в своей комнате или где-нибудь ещё."

# ch/minami/events.rpy:4485
translate russian minami_siscon_03_d3c462ac:
    "Я задумываюсь: дело действительно в лишнем жильце или всё осложняет то, что Минами — моя младшая сестра?"

# ch/minami/events.rpy:4486
translate russian minami_siscon_03_a9c61400:
    "Понимаю, ей наверняка страшно: она впервые далеко от дома, от мамы с папой."

# ch/minami/events.rpy:4487
translate russian minami_siscon_03_0a32df60:
    "Но я не готов с утра до вечера заменять ей родителей."

# ch/minami/events.rpy:4488
translate russian minami_siscon_03_8e97352f:
    "Поэтому я чаще сижу в комнате, раньше ухожу в офис или задерживаюсь там по вечерам."

# ch/minami/events.rpy:4489
translate russian minami_siscon_03_eb9e360c:
    "Даже душ превратился в маленький оазис уединения посреди дня, утомительно насыщенного общением."

# ch/minami/events.rpy:4490
translate russian minami_siscon_03_97a1bb87:
    "Сегодня я влетаю в ванную, едва она освобождается, и почти прыгаю в душевую кабину."

# ch/minami/events.rpy:4492
translate russian minami_siscon_03_9b7b7f2a:
    "Закрываю за собой дверь и включаю воду — погорячее и посильнее."

# ch/minami/events.rpy:4493
translate russian minami_siscon_03_8f842e8e:
    "Стёкла запотевают за считаные секунды, и слышен лишь шум льющейся воды."

# ch/minami/events.rpy:4494
translate russian minami_siscon_03_06d36e0b:
    "Знаю, ужасное клише, но мне и правда кажется, что она смывает заботы дня."

# ch/minami/events.rpy:4496
translate russian minami_siscon_03_ef922a21:
    "Однако мгновение спустя расслабление прерывает отчаянный стук в дверь ванной."

# ch/minami/events.rpy:4497
translate russian minami_siscon_03_f5596c8e:
    "Кто это, чёрт возьми?"

# ch/minami/events.rpy:4499
translate russian minami_siscon_03_974f4220:
    "Разве не слышно, что у меня уже включён душ?"

# ch/minami/events.rpy:4500
translate russian minami_siscon_03_3a0e08eb:
    "Тут я понимаю: наверняка Минами. [bree.name] и Саша так бы меня не донимали."

# ch/minami/events.rpy:4501
translate russian minami_siscon_03_30b34fdd:
    "Открыв дверцу душа, я кричу как можно громче."

# ch/minami/events.rpy:4502
translate russian minami_siscon_03_b38a7e03:
    mike.say "МИНАМИ, ЭТО ТЫ?"

# ch/minami/events.rpy:4503
translate russian minami_siscon_03_12dd1514:
    minami.say "Да, братик, я."

# ch/minami/events.rpy:4504
translate russian minami_siscon_03_3be7e9b1:
    mike.say "ЧЕГО ТЕБЕ, ЧЁРТ ВОЗЬМИ?"

# ch/minami/events.rpy:4505
translate russian minami_siscon_03_2ccf77cb:
    minami.say "Впусти меня! Мне ОЧЕНЬ нужно пописать!"

# ch/minami/events.rpy:4506
translate russian minami_siscon_03_8e72115c:
    "Она же не серьёзно?"

# ch/minami/events.rpy:4507
translate russian minami_siscon_03_154479b5:
    mike.say "НЕ МОЖЕШЬ НЕМНОГО ПОТЕРПЕТЬ?!"

# ch/minami/events.rpy:4508
translate russian minami_siscon_03_2f0974b6:
    minami.say "Не могу..."

# ch/minami/events.rpy:4509
translate russian minami_siscon_03_f65384f1:
    minami.say "Впусти! Обещаю, я быстро и смотреть не буду!"

# ch/minami/events.rpy:4512
translate russian minami_siscon_03_669b9544:
    mike.say "НИ ЗА ЧТО!"

# ch/minami/events.rpy:4513
translate russian minami_siscon_03_3858bb15:
    "Из-за двери доносятся невнятные ругательства."

# ch/minami/events.rpy:4514
translate russian minami_siscon_03_f8240212:
    "Но больше никто не стучит и не возражает."

# ch/minami/events.rpy:4515
translate russian minami_siscon_03_2137b784:
    "После этого душ теряет всю прелесть."

# ch/minami/events.rpy:4516
translate russian minami_siscon_03_1c2a411c:
    "Я быстро моюсь и выхожу."

# ch/minami/events.rpy:4518
translate russian minami_siscon_03_7133cddd:
    "Всё это время ругаясь из-за того, что Минами испортила один из немногих спокойных моментов."

# ch/minami/events.rpy:4520
translate russian minami_siscon_03_604c640d:
    "Я раздражённо качаю головой, гадая, как Минами постоянно умудряется ставить меня в такие положения."

# ch/minami/events.rpy:4521
translate russian minami_siscon_03_af6f7844:
    "Какой у меня выбор? Не оставлять же её мочить трусики на лестничной площадке!"

# ch/minami/events.rpy:4522
translate russian minami_siscon_03_07d49a51:
    mike.say "ЛАДНО, НО СМОТРИ СДЕРЖИ ОБЕЩАНИЕ, МИНАМИ!"

# ch/minami/events.rpy:4523
translate russian minami_siscon_03_17a79e06:
    "Через секунду слышу, как дверь открывается и закрывается."

# ch/minami/events.rpy:4524
translate russian minami_siscon_03_267cfb77:
    "Минами вбегает в ванную и направляется прямо к унитазу."

# ch/minami/events.rpy:4525
translate russian minami_siscon_03_29b51626:
    "При этом демонстративно отворачивается от душа."

# ch/minami/events.rpy:4526
translate russian minami_siscon_03_666691bb:
    "Я смотрю, как она спускает трусики и садится, всё ещё глядя в сторону."

# ch/minami/events.rpy:4527
translate russian minami_siscon_03_803b2753:
    "Но тут понимаю, что теперь уже я наблюдаю, как она писает."

# ch/minami/events.rpy:4528
translate russian minami_siscon_03_3fdfb312:
    "Ужасно смутившись, я поспешно закрываю дверцу кабины и пытаюсь продолжить мыться."

# ch/minami/events.rpy:4529
translate russian minami_siscon_03_a94e07f0:
    "Я предполагал, что запотевшее стекло скроет меня."

# ch/minami/events.rpy:4530
translate russian minami_siscon_03_a2ba85e4:
    "Но из-за холодного воздуха, который впустила Минами, оно уже стало прозрачным."

# ch/minami/events.rpy:4531
translate russian minami_siscon_03_1954a2fa:
    "Получается, я фактически стою голый в стеклянной кабинке в нескольких шагах от неё."

# ch/minami/events.rpy:4532
translate russian minami_siscon_03_72f247a3:
    "Стараюсь не смотреть в её сторону, но вскоре искушение становится слишком сильным."

# ch/minami/events.rpy:4533
translate russian minami_siscon_03_1050538b:
    "Оглянувшись через плечо, я совершенно точно ловлю Минами на разглядывании моей голой задницы."

# ch/minami/events.rpy:4534
translate russian minami_siscon_03_8b70b49c:
    "Пойманная с поличным, она отводит глаза и поворачивает голову в другую сторону."

# ch/minami/events.rpy:4535
translate russian minami_siscon_03_43d3970d:
    "Но к этому моменту уже увидела всё, что можно было увидеть."

# ch/minami/events.rpy:4536
translate russian minami_siscon_03_3deb6d93:
    "Единственное, чего она не заметила, — как я покраснел."

# ch/minami/events.rpy:4538
translate russian minami_siscon_03_e1fe8dc7:
    "Часть меня хочет повернуться и показать ей всё. Она женщина и смотрела на меня именно как женщина."

# ch/minami/events.rpy:4540
translate russian minami_siscon_03_75e9eecb:
    "Проблема в том, насколько я не против. Она моя младшая сестра, а я стою и почти надеюсь, что ей понравилось увиденное."

# ch/minami/events.rpy:4542
translate russian minami_siscon_03_f12027ae:
    "От этого я странно смущаюсь, сильнее, чем следовало бы. С каких пор меня волнует, подглядывает ли Минами?"

# ch/minami/events.rpy:4544
translate russian minami_siscon_03_eb71f508:
    "Это безобидно: бывает, когда брат и сестра пользуются одной ванной. Не из-за чего краснеть."

# ch/minami/events.rpy:4545
translate russian minami_siscon_03_e4f165f0:
    "Прежде чем я набираюсь смелости что-то сказать, Минами заканчивает и спускает воду."

# ch/minami/events.rpy:4546
translate russian minami_siscon_03_788d8fe1:
    "Она уходит раньше, чем я успеваю возразить, а мгновение спустя вода в душе становится ледяной."

# ch/minami/events.rpy:4547
translate russian minami_siscon_03_ff60fc6a:
    "Мне остаётся выскочить из кабины, проклиная своё невезение."

# ch/minami/events.rpy:4548
translate russian minami_siscon_03_f8cabe5f:
    "Но ирония такого холодного душа ни на секунду от меня не ускользает..."

# ch/minami/events.rpy:4556
translate russian minami_siscon_02_134d1fd8:
    "Ладно, прежде чем признаться, сразу скажу: такое бывает с каждым."

# ch/minami/events.rpy:4557
translate russian minami_siscon_02_23d34fb5:
    "И это не то, что я привык делать регулярно."

# ch/minami/events.rpy:4558
translate russian minami_siscon_02_6ee0d7b1:
    "Но, как бы то ни было, я дотянул с походом в туалет почти до последнего."

# ch/minami/events.rpy:4559
translate russian minami_siscon_02_4e1c83c4:
    "Поэтому быстро направляюсь в ванную, стараясь не выглядеть так, будто бегу."

# ch/minami/events.rpy:4560
translate russian minami_siscon_02_0bbb7f67:
    "Мочевой пузырь так настойчиво требует внимания, что я почти врываюсь прямо к унитазу."

# ch/minami/events.rpy:4561
translate russian minami_siscon_02_6e9b2a2e:
    "Останавливают лишь закрытая дверь и вполне реальный страх застать кого-нибудь внутри."

# ch/minami/events.rpy:4562
translate russian minami_siscon_02_3360c688:
    "Собрав всю волю, я замираю с рукой над дверной ручкой."

# ch/minami/events.rpy:4563
translate russian minami_siscon_02_7bc80586:
    mike.say "Алло?"

# ch/minami/events.rpy:4564
translate russian minami_siscon_02_c81839bf:
    mike.say "Там кто-нибудь есть?"

# ch/minami/events.rpy:4565
translate russian minami_siscon_02_99724adc:
    mike.say "Я тут немного спешу!"

# ch/minami/events.rpy:4566
translate russian minami_siscon_02_d4a35ae6:
    "Долго ждать ответа не приходится: изнутри отзывается Минами."

# ch/minami/events.rpy:4567
translate russian minami_siscon_02_01f73928:
    minami.say "Привет, братик."

# ch/minami/events.rpy:4568
translate russian minami_siscon_02_31c6aa14:
    minami.say "Тебе очень надо, да?"

# ch/minami/events.rpy:4569
translate russian minami_siscon_02_4c0d5702:
    mike.say "Да, Минами, ОЧЕНЬ надо!"

# ch/minami/events.rpy:4570
translate russian minami_siscon_02_2a7d4c7b:
    "Что это, беседа на фоне лопающегося мочевого пузыря?!"

# ch/minami/events.rpy:4571
translate russian minami_siscon_02_1c0d45e8:
    mike.say "Ну..."

# ch/minami/events.rpy:4572
translate russian minami_siscon_02_09243a68:
    mike.say "Ты там уже закончила или как?"

# ch/minami/events.rpy:4573
translate russian minami_siscon_02_2e8b4c54:
    minami.say "А, да, прости!"

# ch/minami/events.rpy:4574
translate russian minami_siscon_02_d7a169eb:
    minami.say "Я как раз заканчиваю."

# ch/minami/events.rpy:4575
translate russian minami_siscon_02_34e32d4c:
    minami.say "Можешь заходить, не волнуйся!"

# ch/minami/events.rpy:4576
translate russian minami_siscon_02_d19c0c57:
    "Что это вообще значит?"

# ch/minami/events.rpy:4577
translate russian minami_siscon_02_4cdf5b92:
    "Она уже собиралась выходить, когда я постучал?"

# ch/minami/events.rpy:4578
translate russian minami_siscon_02_2e9fd1e7:
    "Чем ещё она могла там заниматься, раз мне можно просто войти?"

# ch/minami/events.rpy:4581
translate russian minami_siscon_02_78c6b328:
    "Будь там [bree.name] или Саша, я, пожалуй, спокойно поверил бы им на слово."

# ch/minami/events.rpy:4582
translate russian minami_siscon_02_6a1fd4dd:
    "Чёрт, может, даже приятно было бы застать их врасплох..."

# ch/minami/events.rpy:4583
translate russian minami_siscon_02_50e35be2:
    "Но здесь другое дело."

# ch/minami/events.rpy:4584
translate russian minami_siscon_02_c3195f41:
    "Это Минами."

# ch/minami/events.rpy:4585
translate russian minami_siscon_02_9fd38728:
    "Моя младшая сестра, ради бога!"

# ch/minami/events.rpy:4586
translate russian minami_siscon_02_ec65367e:
    "Я почти уверен, что такое извращение, а в некоторых странах, возможно, ещё и незаконно."

# ch/minami/events.rpy:4587
translate russian minami_siscon_02_edf54386:
    mike.say "Всё нормально, Минами."

# ch/minami/events.rpy:4588
translate russian minami_siscon_02_938c5522:
    mike.say "Не переживай."

# ch/minami/events.rpy:4589
translate russian minami_siscon_02_d3ee9470:
    mike.say "Я просто выйду на улицу."

# ch/minami/events.rpy:4590
translate russian minami_siscon_02_1a0e196c:
    minami.say "Ну, не будь ханжой, братик."

# ch/minami/events.rpy:4591
translate russian minami_siscon_02_5c8c71c2:
    minami.say "Не то чтобы я раньше всего этого не видела!"

# ch/minami/events.rpy:4592
translate russian minami_siscon_02_d6bb07cd:
    "Внезапный спазм мочевого пузыря, заставивший меня броситься вниз по лестнице, почти приносит облегчение."

# ch/minami/events.rpy:4593
translate russian minami_siscon_02_4ef23c10:
    "Конечно, когда-то мы могли видеть друг друга голыми."

# ch/minami/events.rpy:4594
translate russian minami_siscon_02_a59bc66e:
    "Но тогда мы были маленькими детьми, так что это, уверен, не считается."

# ch/minami/events.rpy:4597
translate russian minami_siscon_02_d42d6529:
    "Я успеваю выскочить наружу и захлопнуть за собой дверь как раз вовремя."

# ch/minami/events.rpy:4598
translate russian minami_siscon_02_2c7275c1:
    "Наконец опорожнив мочевой пузырь, я испытываю невероятное физическое облегчение."

# ch/minami/events.rpy:4599
translate russian minami_siscon_02_3f012ad5:
    "Но это ничуть не уменьшает смущения от приглашения Минами войти к ней в ванную..."

# ch/minami/events.rpy:4601
translate russian minami_siscon_02_a16b29fe:
    "Она ведь должна быть одета, правда?"

# ch/minami/events.rpy:4602
translate russian minami_siscon_02_99163d71:
    "Иначе почему Минами спокойно зовёт меня войти?"

# ch/minami/events.rpy:4603
translate russian minami_siscon_02_fe9d50f2:
    "А если я немедленно что-нибудь не сделаю, точно обмочусь."

# ch/minami/events.rpy:4604
translate russian minami_siscon_02_935497af:
    mike.say "Ладно, Минами, я захожу."

# ch/minami/events.rpy:4605
translate russian minami_siscon_02_94a1ae15:
    minami.say "Конечно, братик."

# ch/minami/events.rpy:4606
translate russian minami_siscon_02_33035fa1:
    "Я поворачиваю ручку, толкаю дверь и вхожу в ванную."

# ch/minami/events.rpy:4607
translate russian minami_siscon_02_e390602c:
    "Уверенный, что она одета, даже не пытаюсь отвести глаза."

# ch/minami/events.rpy:4608
translate russian minami_siscon_02_8a0714c1:
    "Если первой ошибкой было поверить Минами на слово, то второй — не опустить взгляд."

# ch/minami/events.rpy:4612
translate russian minami_siscon_02_d4ef0b82:
    minami.say "Что такое, братик?"

# ch/minami/events.rpy:4613
translate russian minami_siscon_02_c5586ece:
    minami.say "Ты же говорил, что тебе срочно надо."

# ch/minami/events.rpy:4614
translate russian minami_siscon_02_f97440c3:
    minami.say "А теперь просто стоишь и пялишься на меня!"

# ch/minami/events.rpy:4616
translate russian minami_siscon_02_cf90f383:
    "Конечно я на неё пялюсь."

# ch/minami/events.rpy:4617
translate russian minami_siscon_02_53e52a88:
    "Она совершенно голая, ради бога!"

# ch/minami/events.rpy:4618
translate russian minami_siscon_02_aeecfc2f:
    "Полагаю, Минами только что вышла из душа, прежде чем я постучал."

# ch/minami/events.rpy:4619
translate russian minami_siscon_02_82b96917:
    "Возможно, мгновение назад она вытиралась."

# ch/minami/events.rpy:4620
translate russian minami_siscon_02_39548b80:
    "Но теперь полотенце лежит кучей у её ног."

# ch/minami/events.rpy:4621
translate russian minami_siscon_02_d4c470e3:
    "Хуже всего то, что она даже не пытается прикрыться!"

# ch/minami/events.rpy:4622
translate russian minami_siscon_02_59c223f4:
    "Минами сжала кулаки и твёрдо упёрла их в бёдра."

# ch/minami/events.rpy:4623
translate russian minami_siscon_02_a9b69350:
    "Твёрдость — как раз подходящее слово и для её..."

# ch/minami/events.rpy:4624
translate russian minami_siscon_02_9e92b65b:
    "О боже, нет! Не верится, что я чуть этого не сказал!"

# ch/minami/events.rpy:4625
translate russian minami_siscon_02_d1494475:
    "Что со мной не так?!"

# ch/minami/events.rpy:4627
translate russian minami_siscon_02_0458af4a:
    minami.say "Да ладно тебе!"

# ch/minami/events.rpy:4628
translate russian minami_siscon_02_db0519f7:
    minami.say "Подбери челюсть с пола, братик."

# ch/minami/events.rpy:4629
translate russian minami_siscon_02_ce7fe533:
    minami.say "Будто ты никогда не видел меня голой!"

# ch/minami/events.rpy:4631
translate russian minami_siscon_02_23b799df:
    mike.say "Д... да, Минами..."

# ch/minami/events.rpy:4632
translate russian minami_siscon_02_86672254:
    mike.say "Н... но тогда мы были детьми!"

# ch/minami/events.rpy:4634
translate russian minami_siscon_02_92159bfb:
    minami.say "Ну, не будь таким ханжой, братик."

# ch/minami/events.rpy:4635
translate russian minami_siscon_02_92d0677c:
    minami.say "Ничего страшного, если ты увидишь меня вот так."

# ch/minami/events.rpy:4636
translate russian minami_siscon_02_65eee94e:
    minami.say "Я же знаю, что ты никогда не сделаешь из этого что-то странное!"

# ch/minami/events.rpy:4638
translate russian minami_siscon_02_cab430e0:
    "Ей легко говорить..."

# ch/minami/events.rpy:4639
translate russian minami_siscon_02_5f239827:
    "Минами невинно улыбается мне, наклоняясь за полотенцем."

# ch/minami/events.rpy:4640
translate russian minami_siscon_02_984044a9:
    "И, клянусь, старается, чтобы я разглядел каждое движение."

# ch/minami/events.rpy:4641
translate russian minami_siscon_02_b8f73ac8:
    "Затем быстро оборачивается полотенцем и семенит к двери."

# ch/minami/events.rpy:4643
translate russian minami_siscon_02_6e41269a:
    minami.say "Ванная полностью твоя, братик!"

# ch/minami/events.rpy:4644
translate russian minami_siscon_02_a32eab41:
    minami.say "Только теперь не обмочись..."

# ch/minami/events.rpy:4646
translate russian minami_siscon_02_226cbe17:
    "Напоминание о том, зачем я вообще пришёл, словно снова будит мой мочевой пузырь."

# ch/minami/events.rpy:4648
translate russian minami_siscon_02_75fee683:
    "К тому времени, как Минами выходит, я уже едва сдерживаюсь."

# ch/minami/events.rpy:4649
translate russian minami_siscon_02_1fc24ac8:
    "Но в каком-то смысле это желанное отвлечение от всего, что я только что увидел..."

# ch/minami/events.rpy:4651
translate russian minami_siscon_02_d3b75e3e:
    "Я больше не чувствую вины, глядя на неё. Её тело отпечаталось у меня в голове, и я хочу снова увидеть его целиком."

# ch/minami/events.rpy:4653
translate russian minami_siscon_02_a662bc69:
    "Я перестал притворяться, что не хочу её. Передо мной стояла голая Минами, и всё моё тело это знало."

# ch/minami/events.rpy:4655
translate russian minami_siscon_02_50b7bd4f:
    "В этом и проблема, правда? Я смотрел, по-настоящему разглядывал её, а последующая вина не останавливает так, как должна."

# ch/minami/events.rpy:4657
translate russian minami_siscon_02_22479be1:
    "Вид Минами такой неожиданно встряхнул меня. Она уже не та худенькая девчонка, которую я помню, и мозг никак не может этого отпустить."

# ch/minami/events.rpy:4664
translate russian minami_siscon_01_f9282e46:
    "Приезд Минами практически переворачивает весь дом и привычный распорядок вверх дном."

# ch/minami/events.rpy:4665
translate russian minami_siscon_01_3bc3984e:
    "Поэтому я отчаянно цепляюсь за знакомые занятия, в которых её присутствие не предполагается."

# ch/minami/events.rpy:4666
translate russian minami_siscon_01_0ba7d081:
    "Репетиции группы — почти в начале списка, и я с облегчением вздыхаю: Минами даже упоминать не придётся."

# ch/minami/events.rpy:4667
translate russian minami_siscon_01_2fe7da5a:
    "Но после обычной болтовни перед репетицией между мной, Анной, Клео и Сашей нас отвлекает неожиданный звук."

# ch/minami/events.rpy:4668
translate russian minami_siscon_01_e7860e3b:
    "Вдруг дверь репетиционной распахивается."

# ch/minami/events.rpy:4670
translate russian minami_siscon_01_3df0eb35:
    "Внутрь влетает Минами, наполняя комнату шумом и болтовнёй."

# ch/minami/events.rpy:4672
translate russian minami_siscon_01_04ab1241:
    minami.say "О... МОЙ... БОГ!"

# ch/minami/events.rpy:4673
translate russian minami_siscon_01_cac76dbb:
    minami.say "Это... так... круто!"

# ch/minami/events.rpy:4675
translate russian minami_siscon_01_61153328:
    "Она буквально скачет по репетиционной."

# ch/minami/events.rpy:4676
translate russian minami_siscon_01_1d293135:
    "Лавируя между инструментами и аппаратурой, она опасно близка к тому, чтобы что-нибудь серьёзно повредить."

# ch/minami/events.rpy:4678
translate russian minami_siscon_01_72460788:
    minami.say "Ты говорил, что играешь в группе, братик."

# ch/minami/events.rpy:4679
translate russian minami_siscon_01_d3f8c1b9:
    minami.say "Но я думала, это что-то с трубами, тубами и всей той фигнёй."

# ch/minami/events.rpy:4680
translate russian minami_siscon_01_59cfe226:
    minami.say "А это ведь НАСТОЯЩАЯ группа!"

# ch/minami/events.rpy:4681
translate russian minami_siscon_01_16d21895:
    minami.say "И ты словно настоящая рок-звезда!"

# ch/minami/events.rpy:4687
translate russian minami_siscon_01_d36ad095:
    "Ещё до того, как Клео заговаривает, я чувствую её насмешливый взгляд."

# ch/minami/events.rpy:4690
translate russian minami_siscon_01_3bb8d8d8:
    kleio.say "Эй, сердцеед, кто эта мисс «объелась сладкого»?"

# ch/minami/events.rpy:4692
translate russian minami_siscon_01_3bb8d8d8_1:
    kleio.say "Эй, сердцеед, кто эта мисс «объелась сладкого»?"

# ch/minami/events.rpy:4695
translate russian minami_siscon_01_ef87a740:
    "Услышав её голос, Минами так быстро поворачивается к Клео, что та даже отшатывается от неожиданности."

# ch/minami/events.rpy:4697
translate russian minami_siscon_01_46988a72:
    minami.say "Ух ты, ты прямо настоящая крутая рокерша, да?"

# ch/minami/events.rpy:4698
translate russian minami_siscon_01_6be3a9fe:
    minami.say "Спорю, ты НИКОМУ не позволяешь сесть себе на шею!"

# ch/minami/events.rpy:4700
translate russian minami_siscon_01_774e80c0:
    "Клео озадачена словами Минами и не сразу понимает, что это комплимент."

# ch/minami/events.rpy:4703
translate russian minami_siscon_01_87a478d5:
    kleio.say "Ну... наверное... в общем, да."

# ch/minami/events.rpy:4705
translate russian minami_siscon_01_87a478d5_1:
    kleio.say "Ну... наверное... в общем, да."

# ch/minami/events.rpy:4708
translate russian minami_siscon_01_dffde0fa:
    minami.say "А ты, с барабанами!"

# ch/minami/events.rpy:4714
translate russian minami_siscon_01_6457bbaf:
    "Оказавшись в центре внимания Минами, Анна подскакивает на стуле и испуганно пищит."

# ch/minami/events.rpy:4716
translate russian minami_siscon_01_51498739:
    minami.say "Ты такая маленькая! Наверное, шума от тебя очень много!"

# ch/minami/events.rpy:4720
translate russian minami_siscon_01_b9776cc2:
    anna.say "Да... но вообще-то в этом и смысл..."

# ch/minami/events.rpy:4722
translate russian minami_siscon_01_b9776cc2_1:
    anna.say "Да... но вообще-то в этом и смысл..."

# ch/minami/events.rpy:4724
translate russian minami_siscon_01_db939951:
    "Я понимаю, что придётся вмешаться и твёрдо взять Минами в руки."

# ch/minami/events.rpy:4725
translate russian minami_siscon_01_4f73d7a1:
    "Иначе из-за её привычки совать нос во всё мы ни хрена не сделаем."

# ch/minami/events.rpy:4726
translate russian minami_siscon_01_86baf95a:
    mike.say "Минами, я же просил подождать, пока мы закончим?"

# ch/minami/events.rpy:4728
translate russian minami_siscon_01_e377cb02:
    "Услышав мой голос, Минами тут же дуется и начинает ныть."

# ch/minami/events.rpy:4730
translate russian minami_siscon_01_cadaa226:
    minami.say "Ну-у, знаю, братик."

# ch/minami/events.rpy:4731
translate russian minami_siscon_01_c1b687de:
    minami.say "Но это ТАК скучно."

# ch/minami/events.rpy:4732
translate russian minami_siscon_01_3413a7bc:
    minami.say "И я очень хочу послушать, как ты играешь..."

# ch/minami/events.rpy:4736
translate russian minami_siscon_01_499ad658:
    "Обычно желание Минами послушать меня было бы очень лестным."

# ch/minami/events.rpy:4737
translate russian minami_siscon_01_4ab4b78c:
    "Но кажется, с самого приезда она постоянно путается под ногами."

# ch/minami/events.rpy:4738
translate russian minami_siscon_01_e4bbf195:
    "Сейчас мне действительно нужно как следует выпустить пар."

# ch/minami/events.rpy:4739
translate russian minami_siscon_01_41bb634c:
    "К тому же это моя младшая сестра, и навязывать её остальным нечестно."

# ch/minami/events.rpy:4740
translate russian minami_siscon_01_b0a1a8ca:
    mike.say "Нет, Минами, тебе нужно выметаться отсюда."

# ch/minami/events.rpy:4741
translate russian minami_siscon_01_a835fd8c:
    mike.say "Я заглажу вину, ладно?"

# ch/minami/events.rpy:4742
translate russian minami_siscon_01_15048c34:
    mike.say "Можешь прийти на наш ближайший концерт. Как тебе?"

# ch/minami/events.rpy:4744
translate russian minami_siscon_01_561b5f74:
    "Минами мрачнеет и теперь уже совершенно точно дуется."

# ch/minami/events.rpy:4746
translate russian minami_siscon_01_2d94c8e7:
    minami.say "Ну... но я..."

# ch/minami/events.rpy:4748
translate russian minami_siscon_01_f1637d5d:
    mike.say "Нет, это не обсуждается."

# ch/minami/events.rpy:4749
translate russian minami_siscon_01_6320a848:
    mike.say "Выходи!"

# ch/minami/events.rpy:4751
translate russian minami_siscon_01_b9e06616:
    minami.say "Ладно, ладно, уже ухожу!"

# ch/minami/events.rpy:4753
translate russian minami_siscon_01_1ada7d45:
    "Как только за ней закрывается дверь, я смотрю на остальных и качаю головой."

# ch/minami/events.rpy:4754
translate russian minami_siscon_01_d3d5764d:
    mike.say "Ребята, правда, простите, что пришлось это видеть."

# ch/minami/events.rpy:4755
translate russian minami_siscon_01_314df6b6:
    mike.say "Она хорошая девчонка, но с ней нужно быть твёрдым."

# ch/minami/events.rpy:4760
translate russian minami_siscon_01_3cda213c:
    "Анна озадаченно моргает и качает головой."

# ch/minami/events.rpy:4763
translate russian minami_siscon_01_f4808263:
    anna.say "Ты о чём, [lssb_minami.hero_name()]?"

# ch/minami/events.rpy:4764
translate russian minami_siscon_01_22677da4:
    anna.say "Она всего лишь хотела послушать, как ты играешь!"

# ch/minami/events.rpy:4768
translate russian minami_siscon_01_f4808263_1:
    anna.say "Ты о чём, [lssb_minami.hero_name()]?"

# ch/minami/events.rpy:4769
translate russian minami_siscon_01_22677da4_1:
    anna.say "Она всего лишь хотела послушать, как ты играешь!"

# ch/minami/events.rpy:4773
translate russian minami_siscon_01_04e4f1cf:
    kleio.say "Не-а, сердцеед прав, Анна."

# ch/minami/events.rpy:4774
translate russian minami_siscon_01_0578dcc6:
    kleio.say "С такими девчонками нужно быть построже!"

# ch/minami/events.rpy:4778
translate russian minami_siscon_01_04e4f1cf_1:
    kleio.say "Не-а, сердцеед прав, Анна."

# ch/minami/events.rpy:4779
translate russian minami_siscon_01_0578dcc6_1:
    kleio.say "С такими девчонками нужно быть построже!"

# ch/minami/events.rpy:4781
translate russian minami_siscon_01_5a3ad50f:
    "Я мог бы заметить, что Минами не настолько младше самой Клео."

# ch/minami/events.rpy:4782
translate russian minami_siscon_01_f2d046e7:
    "Но предпочитаю хоть раз оставить её на своей стороне."

# ch/minami/events.rpy:4783
translate russian minami_siscon_01_ada81ff9:
    mike.say "Всё нормально, Анна."

# ch/minami/events.rpy:4788
translate russian minami_siscon_01_74f7ec1b:
    mike.say "Она как резиновый мячик — быстро отскочит обратно."

# ch/minami/events.rpy:4789
translate russian minami_siscon_01_f6cb407b:
    "Мы продолжаем репетицию, и вскоре об инциденте забывают."

# ch/minami/events.rpy:4790
translate russian minami_siscon_01_fafcbe35:
    "После неё я чувствую себя отдохнувшим и думаю, что выгнать Минами было не зря."

# ch/minami/events.rpy:4791
translate russian minami_siscon_01_04549ec8:
    "Конечно, по дороге домой она продолжает дуться."

# ch/minami/events.rpy:4792
translate russian minami_siscon_01_e558429a:
    "Но едва появляется что-то отвлекающее, её настроение почти сразу улучшается."

# ch/minami/events.rpy:4794
translate russian minami_siscon_01_a5d1fd27:
    "Я глубоко вдыхаю и выдыхаю, не сводя глаз с Минами."

# ch/minami/events.rpy:4795
translate russian minami_siscon_01_5fcabaf9:
    "Я прекрасно знаю, что не должен колебаться: нужно выставить её за дверь."

# ch/minami/events.rpy:4796
translate russian minami_siscon_01_8b7969af:
    "Но мне всё же нравится, как сильно ей хочется увидеть меня в деле."

# ch/minami/events.rpy:4797
translate russian minami_siscon_01_6ee1d8f2:
    "Да и, может, мнение со стороны пригодится перед следующим концертом?"

# ch/minami/events.rpy:4799
translate russian minami_siscon_01_9fb2f065:
    mike.say "Ладно, Минами, можешь остаться."

# ch/minami/events.rpy:4800
translate russian minami_siscon_01_413fa73b:
    mike.say "Но сиди вон там, никуда не ходи и всё время молчи."

# ch/minami/events.rpy:4801
translate russian minami_siscon_01_cc0a4f37:
    "Минами радостно хлопает в ладоши."

# ch/minami/events.rpy:4803
translate russian minami_siscon_01_84edf9cc:
    minami.say "ДА!"

# ch/minami/events.rpy:4804
translate russian minami_siscon_01_479eb33e:
    minami.say "Спасибо, братик, ты лучший!"

# ch/minami/events.rpy:4806
translate russian minami_siscon_01_82e05bd7:
    "Пока она вприпрыжку бежит к указанному месту, за спиной слышится хихиканье."

# ch/minami/events.rpy:4820
translate russian minami_siscon_01_7c320379:
    "Оборачиваюсь: Анна пытается сдержать смех, а Клео открыто качает головой."

# ch/minami/events.rpy:4823
translate russian minami_siscon_01_262682a6:
    kleio.say "Мастерски, братик."

# ch/minami/events.rpy:4824
translate russian minami_siscon_01_4c0bacd1:
    kleio.say "Вот это ты ей показал!"

# ch/minami/events.rpy:4828
translate russian minami_siscon_01_262682a6_1:
    kleio.say "Мастерски, братик."

# ch/minami/events.rpy:4829
translate russian minami_siscon_01_4c0bacd1_1:
    kleio.say "Вот это ты ей показал!"

# ch/minami/events.rpy:4833
translate russian minami_siscon_01_f4ec197b:
    anna.say "Да, [lssb_minami.hero_name()], ты и правда лучший!"

# ch/minami/events.rpy:4837
translate russian minami_siscon_01_f4ec197b_1:
    anna.say "Да, [lssb_minami.hero_name()], ты и правда лучший!"

# ch/minami/events.rpy:4841
translate russian minami_siscon_01_bf18ad95:
    "Саша лишь закатывает глаза и качает головой."

# ch/minami/events.rpy:4842
translate russian minami_siscon_01_29677a6b:
    "Живя с нами под одной крышей, она уже прекрасно знает, как Минами вьёт из меня верёвки."

# ch/minami/events.rpy:4843
translate russian minami_siscon_01_c1eccb2c:
    "Репетиция начинается всерьёз, и Минами удаётся сдержать обещание."

# ch/minami/events.rpy:4844
translate russian minami_siscon_01_69e75dda:
    "Ну, примерно пять минут."

# ch/minami/events.rpy:4845
translate russian minami_siscon_01_0a3bd5cc:
    "Всё остальное время она ведёт себя как моя личная фанатка."

# ch/minami/events.rpy:4846
translate russian minami_siscon_01_fe3fb636:
    "Каждое моё действие будто заставляет её безумно радоваться, размахивать руками и выкрикивать похвалы."

# ch/minami/events.rpy:4847
translate russian minami_siscon_01_8e9bc621:
    "Поначалу с моего лица не сходит широченная улыбка."

# ch/minami/events.rpy:4848
translate russian minami_siscon_01_b87b446a:
    "Но потом я ловлю взгляды остальных, и сердце уходит в пятки."

# ch/minami/events.rpy:4849
translate russian minami_siscon_01_e1f12b10:
    "Остаток репетиции я кое-как доигрываю, всё время бормоча извинения."

# ch/minami/events.rpy:4850
translate russian minami_siscon_01_bec363a7:
    "После собираю вещи и извиняюсь в последний раз."

# ch/minami/events.rpy:4857
translate russian minami_siscon_01_20867c6d:
    "По дороге домой Минами, похоже, чувствует, что что-то не так."

# ch/minami/events.rpy:4859
translate russian minami_siscon_01_1af7f405:
    minami.say "Братик..."

# ch/minami/events.rpy:4860
translate russian minami_siscon_01_db2a8f3f:
    minami.say "Ты на меня злишься?"

# ch/minami/events.rpy:4862
translate russian minami_siscon_01_141683f0:
    mike.say "Что... нет, Минами."

# ch/minami/events.rpy:4863
translate russian minami_siscon_01_2170a82e:
    mike.say "Просто мне кажется, сегодня я плохо играл, вот и всё."

# ch/minami/events.rpy:4865
translate russian minami_siscon_01_ecdcdc1c:
    minami.say "А... в смысле?"

# ch/minami/events.rpy:4866
translate russian minami_siscon_01_06487c21:
    minami.say "По-моему, ты играл отлично! Я так тобой гордилась!"

# ch/minami/events.rpy:4868
translate russian minami_siscon_01_6df34a97:
    minami.say "Девушки падают в обморок, когда ты выходишь на сцену?"

# ch/minami/events.rpy:4869
translate russian minami_siscon_01_a43c977c:
    minami.say "Думаю, должны. Ты настолько хорош, братик!"

# ch/minami/events.rpy:4871
translate russian minami_siscon_01_b5f9c819:
    mike.say "Я... не уверен, Минами!"

# ch/minami/events.rpy:4873
translate russian minami_siscon_01_49c7a992:
    "Она улыбается и хихикает над моими скромными возражениями."

# ch/minami/events.rpy:4874
translate russian minami_siscon_01_9c189b5b:
    "Но всё равно лесть чертовски приятна..."

# ch/minami/events.rpy:4876
translate russian minami_siscon_01_605b280e:
    "И почему бы нет? Она смотрит на меня, раскрасневшаяся и сияющая, и это уже не ребёнок, подбадривающий брата."

# ch/minami/events.rpy:4877
translate russian minami_siscon_01_464bb98a:
    "На меня так смотрит женщина, и, боже помоги, мне это нравится."

# ch/minami/events.rpy:4879
translate russian minami_siscon_01_7deecda3:
    "Затем тепло сменяется чувством вины. Она моя младшая сестра, и её внимание не должно быть мне настолько приятно."

# ch/minami/events.rpy:4880
translate russian minami_siscon_01_e3df497e:
    "Я велю себе прекратить, но не могу по-настоящему этого захотеть."

# ch/minami/events.rpy:4882
translate russian minami_siscon_01_c2e26501:
    "На полсекунды её слова задевают что-то не то, вызывая трепет, которого я уж точно не ожидал от неё."

# ch/minami/events.rpy:4883
translate russian minami_siscon_01_56f0b6dc:
    "Я быстро отмахиваюсь, но странное замешательство остаётся."

# ch/minami/events.rpy:4885
translate russian minami_siscon_01_7b356461:
    "Просто Минами остаётся собой: младшая сестрёнка, как всегда, меня расхваливает."

# ch/minami/events.rpy:4886
translate russian minami_siscon_01_d6ea8f00:
    "Всего лишь немного гордости между братом и сестрой, и именно так мне нравится."

# ch/minami/events.rpy:4892
translate russian minami_preg_talk_fa14d303:
    "Едва увидев Минами, я понимаю, что что-то не так, хотя она и улыбается."

# ch/minami/events.rpy:4893
translate russian minami_preg_talk_b6c92461:
    "Обычно она такая бодрая, словно ничто не способно её расстроить. Настоящий сгусток заразительной энергии."

# ch/minami/events.rpy:4894
translate russian minami_preg_talk_deb1db82:
    "Но сейчас всё выглядит натянуто, будто она пытается держаться молодцом."

# ch/minami/events.rpy:4895
translate russian minami_preg_talk_8df9f2e5:
    "Я изо всех сил стараюсь не выдавать своей тревоги за неё."

# ch/minami/events.rpy:4896
translate russian minami_preg_talk_3a7b8733:
    "Чутьё подсказывает: если сразу потребовать объяснений, станет только хуже."

# ch/minami/events.rpy:4897
translate russian minami_preg_talk_1ae7e4be:
    "Гораздо лучше дать Минами собраться с духом и самой рассказать так, как она захочет."

# ch/minami/events.rpy:4898
translate russian minami_preg_talk_fd30b6a4:
    mike.say "Привет, Минами."

# ch/minami/events.rpy:4899
translate russian minami_preg_talk_2514a66c:
    "Как ни старается Минами выглядеть совершенно спокойной, перед ответом она всё же вздыхает."

# ch/minami/events.rpy:4901
translate russian minami_preg_talk_01f73928:
    minami.say "Привет, братик."

# ch/minami/events.rpy:4903
translate russian minami_preg_talk_cbe656f1:
    minami.say "Мне... мне нужно с тобой поговорить."

# ch/minami/events.rpy:4905
translate russian minami_preg_talk_019b3456:
    "Продолжая делать вид, будто не замечаю её тревоги, я поднимаю брови и изображаю удивление."

# ch/minami/events.rpy:4906
translate russian minami_preg_talk_9c12cca4:
    mike.say "Вот как?"

# ch/minami/events.rpy:4907
translate russian minami_preg_talk_619dfc27:
    mike.say "Для этого не нужно спрашивать разрешения, Минами."

# ch/minami/events.rpy:4908
translate russian minami_preg_talk_efcfdb5b:
    mike.say "Если хочешь что-то сказать, просто говори."

# ch/minami/events.rpy:4909
translate russian minami_preg_talk_4a78ad29:
    mike.say "После всего, через что мы недавно прошли, думаю, мы справимся с чем угодно!"

# ch/minami/events.rpy:4911
translate russian minami_preg_talk_376b3ffb:
    "Услышав это, Минами впервые хмурится."

# ch/minami/events.rpy:4912
translate russian minami_preg_talk_8a1a8d47:
    "Она отводит взгляд, словно не желая встречаться со мной глазами."

# ch/minami/events.rpy:4914
translate russian minami_preg_talk_662ced98:
    minami.say "Надеюсь, братик."

# ch/minami/events.rpy:4915
translate russian minami_preg_talk_039ae342:
    minami.say "Очень надеюсь!"

# ch/minami/events.rpy:4917
translate russian minami_preg_talk_078e9708:
    "Минами складывает ладони под подбородком и смотрит в пол."

# ch/minami/events.rpy:4918
translate russian minami_preg_talk_421e2700:
    mike.say "Минами..."

# ch/minami/events.rpy:4919
translate russian minami_preg_talk_9ad7ce7e:
    mike.say "Что бы ты ни хотела сказать, это ведь не может быть настолько плохо?"

# ch/minami/events.rpy:4921
translate russian minami_preg_talk_68345618:
    "Лишь когда Минами снова поднимает глаза, я замечаю в них первые слёзы."

# ch/minami/events.rpy:4923
translate russian minami_preg_talk_c7d04a6b:
    minami.say "Сейчас ты так говоришь, братик."

# ch/minami/events.rpy:4924
translate russian minami_preg_talk_4fa8d0ad:
    minami.say "Пока не знаешь, в чём дело..."

# ch/minami/events.rpy:4926
translate russian minami_preg_talk_c6937b4d:
    mike.say "Тогда расскажи, Минами."

# ch/minami/events.rpy:4927
translate russian minami_preg_talk_86d7a322:
    mike.say "Скажи, что случилось."

# ch/minami/events.rpy:4928
translate russian minami_preg_talk_cd773045:
    mike.say "И я смогу сказать, что об этом думаю."

# ch/minami/events.rpy:4930
translate russian minami_preg_talk_4d77b065:
    "Минами грустно кивает, возможно, понимая, что молчать бессмысленно."

# ch/minami/events.rpy:4932
translate russian minami_preg_talk_680e3f07:
    minami.say "Я... я беременна, братик."

# ch/minami/events.rpy:4933
translate russian minami_preg_talk_4a6ab895:
    minami.say "У меня будет твой ребёнок!"

# ch/minami/events.rpy:4935
translate russian minami_preg_talk_e9450746:
    "Признание бьёт меня, как внезапная пощёчина."

# ch/minami/events.rpy:4936
translate russian minami_preg_talk_76fb3325:
    "Девушка, которая сначала была моей младшей сестрой, потом возлюбленной, теперь носит моего ребёнка!"

# ch/minami/events.rpy:4938
translate russian minami_preg_talk_ae1a869b:
    minami.say "Мне нужно знать, что ты хочешь делать, братик."

# ch/minami/events.rpy:4939
translate russian minami_preg_talk_c7cd161b:
    minami.say "То есть... я оставлю ребёнка. В этом я уверена."

# ch/minami/events.rpy:4940
translate russian minami_preg_talk_131ede0b:
    minami.say "Но не знаю, чего хочешь ты..."

# ch/minami/events.rpy:4944
translate russian minami_preg_talk_025ac14d:
    "Я качаю головой и отступаю от Минами, отдаляясь от неё."

# ch/minami/events.rpy:4945
translate russian minami_preg_talk_4e400cba:
    "Она, конечно, сразу понимает смысл этого жеста и собирается пойти следом."

# ch/minami/events.rpy:4946
translate russian minami_preg_talk_2956f60c:
    mike.say "О нет!"

# ch/minami/events.rpy:4947
translate russian minami_preg_talk_095d0a22:
    mike.say "Ничего подобного, Минами!"

# ch/minami/events.rpy:4949
translate russian minami_preg_talk_a491c5e4:
    "Минами начинает говорить: на губах возникает возражение или, может, мольба."

# ch/minami/events.rpy:4950
translate russian minami_preg_talk_cc064b0b:
    "Но я уже слишком разошёлся, чтобы дать ей вставить хоть слово."

# ch/minami/events.rpy:4951
translate russian minami_preg_talk_ac432b81:
    mike.say "Я и так остался бы с тобой."

# ch/minami/events.rpy:4952
translate russian minami_preg_talk_75a93988:
    mike.say "Не нужно было ради этого выкидывать такое!"

# ch/minami/events.rpy:4954
translate russian minami_preg_talk_726e77e1:
    "Минами смотрит на меня изумлённо, явно ошеломлённая обвинением."

# ch/minami/events.rpy:4956
translate russian minami_preg_talk_884f7b27:
    minami.say "Что?"

# ch/minami/events.rpy:4957
translate russian minami_preg_talk_02cdef31:
    minami.say "Ты правда думаешь, что я сделала это нарочно?!"

# ch/minami/events.rpy:4959
translate russian minami_preg_talk_d6690a77:
    mike.say "Всё ведь сходится, разве нет?"

# ch/minami/events.rpy:4960
translate russian minami_preg_talk_31f7b79b:
    "Минами может лишь отрицательно качать головой."

# ch/minami/events.rpy:4961
translate russian minami_preg_talk_9ab9f859:
    mike.say "Да ладно, Минами!"

# ch/minami/events.rpy:4962
translate russian minami_preg_talk_c2b9d379:
    mike.say "После всего, что мы узнали о том, как мама с папой нами вертели?"

# ch/minami/events.rpy:4963
translate russian minami_preg_talk_61121c12:
    mike.say "Ты наверняка боялась, что я порву с тобой."

# ch/minami/events.rpy:4964
translate russian minami_preg_talk_fa07a844:
    mike.say "Беременность, должно быть, показалась верным способом сохранить отношения."

# ch/minami/events.rpy:4966
translate russian minami_preg_talk_e40d26d5:
    "Теперь Минами действительно плачет, слёзы текут по щекам."

# ch/minami/events.rpy:4968
translate russian minami_preg_talk_9c293338:
    minami.say "Нет, братик, это неправда."

# ch/minami/events.rpy:4969
translate russian minami_preg_talk_0b065824:
    minami.say "Ты должен мне поверить!"

# ch/minami/events.rpy:4971
translate russian minami_preg_talk_ea820456:
    "Теперь моя очередь качать головой и отворачиваться от Минами."

# ch/minami/events.rpy:4972
translate russian minami_preg_talk_887b23f2:
    mike.say "Прости, Минами, но я не верю."

# ch/minami/events.rpy:4973
translate russian minami_preg_talk_9703e8fc:
    mike.say "Оставлять ребёнка или нет — твой выбор."

# ch/minami/events.rpy:4974
translate russian minami_preg_talk_4fac1c80:
    mike.say "А участвовать ли в его жизни — мой."

# ch/minami/events.rpy:4975
translate russian minami_preg_talk_0df790c2:
    mike.say "И я не позволю шантажировать меня ребёнком."

# ch/minami/events.rpy:4977
translate russian minami_preg_talk_9603c1fa:
    "Минами смотрит так, словно вдруг перестала меня узнавать."

# ch/minami/events.rpy:4978
translate russian minami_preg_talk_a5e56a5e:
    "На мгновение кажется, что она скажет что-то ещё, снова попытается защититься."

# ch/minami/events.rpy:4980
translate russian minami_preg_talk_194ecd61:
    "Но затем разворачивается и убегает, а я смотрю ей вслед, пока она не скрывается из виду."

# ch/minami/events.rpy:4986
translate russian minami_preg_talk_4dd1b4b8:
    "Я качаю головой, подхожу к Минами и крепко обнимаю."

# ch/minami/events.rpy:4987
translate russian minami_preg_talk_0d73295d:
    "Она слегка вздрагивает от неожиданности, но затем обвивает меня руками в ответ."

# ch/minami/events.rpy:4988
translate russian minami_preg_talk_3387e488:
    mike.say "Минами, это лучшая новость на свете!"

# ch/minami/events.rpy:4990
translate russian minami_preg_talk_eeca8fb3:
    minami.say "П... правда?"

# ch/minami/events.rpy:4992
translate russian minami_preg_talk_dfa341b1:
    "Отпустив её, я начинаю безудержно кивать."

# ch/minami/events.rpy:4993
translate russian minami_preg_talk_59a9f375:
    mike.say "Конечно, Минами! Разве ты не понимаешь, что это значит?"

# ch/minami/events.rpy:4995
translate russian minami_preg_talk_67236db2:
    minami.say "Эм, нет."

# ch/minami/events.rpy:4996
translate russian minami_preg_talk_aabfd464:
    minami.say "Кажется, не понимаю..."

# ch/minami/events.rpy:4998
translate russian minami_preg_talk_eb904d80:
    mike.say "Подумай, Минами."

# ch/minami/events.rpy:4999
translate russian minami_preg_talk_b52c8aa0:
    mike.say "Мой отец и женщина, которую я считал мамой, манипулировали нами обоими."

# ch/minami/events.rpy:5000
translate russian minami_preg_talk_72834f9d:
    mike.say "Когда мы узнали об этом, всё могло закончиться, правда?"

# ch/minami/events.rpy:5002
translate russian minami_preg_talk_b13d23db:
    "Минами медленно кивает: ей неприятно вспоминать, через что нас заставили пройти так называемые родители."

# ch/minami/events.rpy:5003
translate russian minami_preg_talk_17fcd073:
    mike.say "Но не закончилось, потому что наши чувства слишком сильны."

# ch/minami/events.rpy:5004
translate russian minami_preg_talk_49889938:
    mike.say "Мы вместе, потому что МЫ этого хотим, а не благодаря им."

# ch/minami/events.rpy:5005
translate russian minami_preg_talk_10867302:
    mike.say "И этот ребёнок — лучшее тому доказательство."

# ch/minami/events.rpy:5007
translate russian minami_preg_talk_b593fd59:
    "Я вижу, как в глазах Минами загорается понимание."

# ch/minami/events.rpy:5009
translate russian minami_preg_talk_9f6b80ad:
    minami.say "Я... я люблю тебя не из-за того, что они сделали, [lssb_minami.hero_name()]."

# ch/minami/events.rpy:5010
translate russian minami_preg_talk_eac8ecff:
    minami.say "Я люблю тебя вопреки этому..."

# ch/minami/events.rpy:5012
translate russian minami_preg_talk_bd782a64:
    mike.say "Именно, Минами."

# ch/minami/events.rpy:5013
translate russian minami_preg_talk_3a071801:
    mike.say "Я чувствую точно то же самое!"

# ch/minami/events.rpy:5014
translate russian minami_preg_talk_e62cb1b2:
    mike.say "Наш ребёнок станет первым нашим общим делом."

# ch/minami/events.rpy:5015
translate russian minami_preg_talk_505ae874:
    mike.say "Первым в жизни, которую мы построим вместе."

# ch/minami/events.rpy:5016
translate russian minami_preg_talk_8d889876:
    "Минами берёт мои руки и крепко сжимает."

# ch/minami/events.rpy:5018
translate russian minami_preg_talk_e182c998:
    "Она смотрит на меня снизу вверх, почти сияя от гордости и счастья."

# ch/minami/events.rpy:5020
translate russian minami_preg_talk_09674d46:
    minami.say "Ты прав, [lssb_minami.hero_name()]."

# ch/minami/events.rpy:5021
translate russian minami_preg_talk_70c387c6:
    minami.say "Раньше мы лишь притворялись семьёй."

# ch/minami/events.rpy:5022
translate russian minami_preg_talk_0eed312a:
    minami.say "А теперь можем создать свою собственную!"

# ch/minami/events.rpy:5028
translate russian minami_event_03_cdd6b219:
    "Когда наконец наступает день приезда, я весь на нервах, ожидая появления Минами на пороге."

# ch/minami/events.rpy:5029
translate russian minami_event_03_e7f294cb:
    "Кажется, я проверяю время каждые две секунды и никак не могу отвлечься."

# ch/minami/events.rpy:5030
translate russian minami_event_03_342aa522:
    "Каждая останавливающаяся на улице машина кажется такси, которое её привезло."

# ch/minami/events.rpy:5031
translate russian minami_event_03_c72472db:
    "То, что назначенное время приходит и проходит, вообще-то не должно удивлять."

# ch/minami/events.rpy:5032
translate russian minami_event_03_71bd31c6:
    "Минами из тех, кто легко порхает по жизни, оставляя за собой шлейф хаоса."

# ch/minami/events.rpy:5033
translate russian minami_event_03_30fd57c0:
    "Но она никогда не замечает созданных проблем и отмахивается от них так же легко, как создаёт."

# ch/minami/events.rpy:5035
translate russian minami_event_03_c3418ea5:
    "Когда наконец раздаётся звонок в дверь, я почти забываю, чего ждал."

# ch/minami/events.rpy:5036
translate russian minami_event_03_ee673cf8:
    "Часть меня словно уже решила, что я навсегда застрял в этом подвешенном состоянии."

# ch/minami/events.rpy:5038
translate russian minami_event_03_21e52839:
    "Поэтому, пока я вскакиваю и спешу к двери, звонок успевает прозвенеть больше полудюжины раз."

# ch/minami/events.rpy:5040
translate russian minami_event_03_1bc0b2d2:
    "Добравшись до двери, я распахиваю её, приготовив целую лекцию о пунктуальности."

# ch/minami/events.rpy:5041
translate russian minami_event_03_356e261f:
    "Но, конечно, всё это испаряется, едва я вижу Минами..."

# ch/minami/events.rpy:5042
translate russian minami_event_03_05f984a0:
    "Сначала она стоит ко мне спиной и смотрит вслед уезжающему такси."

# ch/minami/events.rpy:5043
translate russian minami_event_03_28ff0f6d:
    "За спиной переполненный туристический рюкзак, а у ног разбросан прочий багаж."

# ch/minami/events.rpy:5044
translate russian minami_event_03_a77f6881:
    "Поэтому ни я её, ни она меня не можем толком разглядеть, пока она не оборачивается."

# ch/minami/events.rpy:5046
translate russian minami_event_03_998a9a9d:
    "Когда это происходит, я едва не ахаю вслух."

# ch/minami/events.rpy:5047
translate russian minami_event_03_84615915:
    "И вдруг чувствую бабочек в животе."

# ch/minami/events.rpy:5049
translate russian minami_event_03_e16aed83:
    minami.say "ПРИВЕТ, БРАТИК!!!"

# ch/minami/events.rpy:5050
translate russian minami_event_03_adbaf1ad:
    minami.say "А вот и я!"

# ch/minami/events.rpy:5052
translate russian minami_event_03_d6eb41ff:
    "Сбросив с плеч рюкзак, Минами буквально бросается на меня."

# ch/minami/events.rpy:5053
translate russian minami_event_03_8192765a:
    "Её руки обвивают мою шею, и она крепко прижимается ко мне."

# ch/minami/events.rpy:5054
translate russian minami_event_03_d4147646:
    "Она ниже меня на целую голову, если не больше, так что мне приходится обхватить её за талию и придерживать."

# ch/minami/events.rpy:5055
translate russian minami_event_03_1b1e292f:
    "Она едва не вышибает из меня дух, повиснув на мне так, словно от этого зависит её жизнь."

# ch/minami/events.rpy:5056
translate russian minami_event_03_22e70fea:
    "Я был подростком, когда впервые заметил, что моя младшая сестра симпатичная."

# ch/minami/events.rpy:5057
translate russian minami_event_03_4294bd43:
    "К тому времени я уже давно начал обращать внимание на девушек."

# ch/minami/events.rpy:5058
translate russian minami_event_03_c0d46301:
    "Но в детстве Минами была для меня скорее ещё одним мальчишкой."

# ch/minami/events.rpy:5059
translate russian minami_event_03_355f0ed2:
    "С тех пор с каждым годом она становилась всё женственнее и красивее."

# ch/minami/events.rpy:5060
translate russian minami_event_03_ef2746a8:
    "Только поймите: я не смотрел на неё В ТАКОМ смысле."

# ch/minami/events.rpy:5061
translate russian minami_event_03_89a3dcf2:
    "Она моя сестра, и мне скорее было не по себе: я переживал, как на неё станут смотреть другие парни."

# ch/minami/events.rpy:5062
translate russian minami_event_03_da1328fc:
    "Но за то время, что я не был дома, этот процесс, похоже, невероятно ускорился!"

# ch/minami/events.rpy:5063
translate russian minami_event_03_abd3591c:
    "Раньше я видел в Минами юную девушку, которая только начинала расцветать."

# ch/minami/events.rpy:5064
translate russian minami_event_03_478a155c:
    "Теперь же ей достаточно войти в комнату, чтобы через пару секунд все взгляды обратились к ней."

# ch/minami/events.rpy:5065
translate russian minami_event_03_cae33171:
    "И что ещё хуже, я понимаю: теперь к милому личику прилагается вполне женская фигура."

# ch/minami/events.rpy:5066
translate russian minami_event_03_4788ab1b:
    "Она так крепко ко мне прижимается, что мне даже не нужно смотреть, чтобы в этом убедиться!"

# ch/minami/events.rpy:5067
translate russian minami_event_03_48aa8d31:
    mike.say "Да, Минами."

# ch/minami/events.rpy:5068
translate russian minami_event_03_b9c6578a:
    mike.say "Вот и ты..."

# ch/minami/events.rpy:5071
translate russian minami_event_03_2b9f8c40:
    "Минами отпускает меня и спрыгивает на землю."

# ch/minami/events.rpy:5073
translate russian minami_event_03_f7f25f79:
    minami.say "Ну, чего же ты ждёшь?!"

