# ch/morgan/reactions.rpy:389
translate russian morgan_movie_liked_reaction_male_cd895596:
    morgan.say "Ура... обожаю этот фильм! Он замечательный!"

# ch/morgan/reactions.rpy:394
translate russian morgan_belly_kiss_male_7c1c3fa8:
    mike.say "Морган..."

# ch/morgan/reactions.rpy:395
translate russian morgan_belly_kiss_male_e3a8d9be:
    mike.say "Я тут подумал, может..."

# ch/morgan/reactions.rpy:396
translate russian morgan_belly_kiss_male_42ac0c78:
    mike.say "Ты не против, если я..."

# ch/morgan/reactions.rpy:397
translate russian morgan_belly_kiss_male_74327d32:
    mike.say "Но если не хочешь, то ничего страшного..."

# ch/morgan/reactions.rpy:399
translate russian morgan_belly_kiss_male_f1b0e5c0:
    "Пока я всё это говорю, Морган машет мне рукой."

# ch/morgan/reactions.rpy:400
translate russian morgan_belly_kiss_male_e89ab073:
    "И для убедительности качает головой."

# ch/morgan/reactions.rpy:402
translate russian morgan_belly_kiss_male_b386eb15:
    morgan.say "Так-так-так..."

# ch/morgan/reactions.rpy:403
translate russian morgan_belly_kiss_male_ce2fff5b:
    morgan.say "Притормози, [lssb_morgan.hero_name()]!"

# ch/morgan/reactions.rpy:404
translate russian morgan_belly_kiss_male_9158e1c2:
    morgan.say "Ты словно сам с собой разговариваешь!"

# ch/morgan/reactions.rpy:406
translate russian morgan_belly_kiss_male_e196d126:
    "Я глубоко вдыхаю и киваю."

# ch/morgan/reactions.rpy:407
translate russian morgan_belly_kiss_male_8eca5952:
    "Отчасти потому, что понимаю: она права."

# ch/morgan/reactions.rpy:408
translate russian morgan_belly_kiss_male_61ab2f93:
    "А отчасти потому, что боюсь попросить о том, чего на самом деле хочу."

# ch/morgan/reactions.rpy:409
translate russian morgan_belly_kiss_male_6e154b71:
    mike.say "Ладно, ладно..."

# ch/morgan/reactions.rpy:410
translate russian morgan_belly_kiss_male_6942f796:
    mike.say "Я хотел тебя кое о чём спросить."

# ch/morgan/reactions.rpy:411
translate russian morgan_belly_kiss_male_be16cef7:
    mike.say "Но боюсь, что ты откажешь."

# ch/morgan/reactions.rpy:413
translate russian morgan_belly_kiss_male_8d8567d0:
    "Морган смотрит на меня с новым интересом."

# ch/morgan/reactions.rpy:414
translate russian morgan_belly_kiss_male_24e35804:
    "И складывает руки над округлившимся животом."

# ch/morgan/reactions.rpy:416
translate russian morgan_belly_kiss_male_e2323907:
    morgan.say "Вот как?"

# ch/morgan/reactions.rpy:417
translate russian morgan_belly_kiss_male_fb842915:
    morgan.say "Так боишься, что даже не хочешь узнать ответ?"

# ch/morgan/reactions.rpy:419
translate russian morgan_belly_kiss_male_f95c31ef:
    "Я киваю, признавая, что тут она меня подловила."

# ch/morgan/reactions.rpy:420
translate russian morgan_belly_kiss_male_560a0546:
    mike.say "Ладно, я хотел спросить..."

# ch/morgan/reactions.rpy:421
translate russian morgan_belly_kiss_male_69f15ab8:
    mike.say "Можно поцеловать тебя в живот?"

# ch/morgan/reactions.rpy:423
translate russian morgan_belly_kiss_male_9e97ac52:
    "Морган приподнимает бровь."

# ch/morgan/reactions.rpy:425
translate russian morgan_belly_kiss_male_34a788c9:
    "По её лицу медленно расползается улыбка."

# ch/morgan/reactions.rpy:428
translate russian morgan_belly_kiss_male_c2483d9a:
    morgan.say "Хех..."

# ch/morgan/reactions.rpy:429
translate russian morgan_belly_kiss_male_697581f2:
