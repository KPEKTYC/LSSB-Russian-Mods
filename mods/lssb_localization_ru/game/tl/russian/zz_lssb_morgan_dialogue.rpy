translate russian morgan_birthday_date_tomboy_946db42f_2:
    mike.say "А я люблю оставаться загадочным!"

# ch/morgan/events.rpy:3472
translate russian morgan_birthday_date_tomboy_ce6a66b1_2:
    "Честно говоря, на картинге я был всего пару раз."

# ch/morgan/events.rpy:3473
