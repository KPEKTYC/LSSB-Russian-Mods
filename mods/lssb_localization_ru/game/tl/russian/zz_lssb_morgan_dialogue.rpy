# ch/morgan/reactions.rpy:438
translate russian morgan_belly_kiss_male_d210c8b3:
    "Морган подаётся животом вперёд, приглашая меня."

# ch/morgan/reactions.rpy:440
translate russian morgan_belly_kiss_male_863c6dd6:
    "Я опускаюсь на колени и наклоняюсь к ней."

# ch/morgan/reactions.rpy:441
translate russian morgan_belly_kiss_male_9e1f4489:
