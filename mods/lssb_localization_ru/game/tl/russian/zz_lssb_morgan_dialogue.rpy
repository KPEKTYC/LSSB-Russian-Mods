# ch/morgan/reactions.rpy:486
translate russian morgan_belly_caress_male_5fe8291d:
    morgan.say "Теперь понимаешь?"

# ch/morgan/reactions.rpy:488
translate russian morgan_belly_caress_male_2b25c761:
    morgan.say "Здорово, да?"

# ch/morgan/reactions.rpy:490
translate russian morgan_belly_caress_male_a9f365d8:
