    morgan.say "Ого..."

# ch/morgan/events.rpy:3499
translate russian morgan_birthday_date_tomboy_280fe50c_1:
    morgan.say "Где ты научился так водить?"

# ch/morgan/events.rpy:3500
translate russian morgan_birthday_date_tomboy_afb2dde3:
    mike.say "Без понятия, Морган."

# ch/morgan/events.rpy:3501
translate russian morgan_birthday_date_tomboy_00ebfe8a:
    mike.say "Наверное, просто повезло."

# ch/morgan/events.rpy:3502
translate russian morgan_birthday_date_tomboy_e6d0bfbd:
    "Я говорю это с улыбкой, и дело не в победе."

# ch/morgan/events.rpy:3503
translate russian morgan_birthday_date_tomboy_8217069b:
    "А в том, что Морган, похоже, получила огромное удовольствие."

# ch/morgan/events.rpy:3506
translate russian morgan_birthday_date_tomboy_ba3935bb_3:
