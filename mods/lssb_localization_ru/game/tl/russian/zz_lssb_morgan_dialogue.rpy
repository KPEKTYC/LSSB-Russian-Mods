# ch/morgan/base.rpy:255
translate russian morgan_propose_male_137d8ae6:
    "До меня наконец доходит происходящее, и я стряхиваю оцепенение."

# ch/morgan/base.rpy:256
translate russian morgan_propose_male_6fa4eb2a:
    "Особенно когда вижу боль и стыд в глазах Морган, которая ругает саму себя."

# ch/morgan/base.rpy:257
translate russian morgan_propose_male_5584f88c:
    "Знаю, это прозвучит жалко."

# ch/morgan/base.rpy:258
translate russian morgan_propose_male_7162123e:
    "Но, клянусь, в этот момент сердце у меня буквально разрывается за неё."

# ch/morgan/base.rpy:259
translate russian morgan_propose_male_6d86de3c:
    mike.say "Да!"

# ch/morgan/base.rpy:261
translate russian morgan_propose_male_db15a921:
    "Услышав мой голос, Морган поднимает на меня изумлённые глаза."

# ch/morgan/base.rpy:262
translate russian morgan_propose_male_28a8da31:
    "Я ожидал, что мой ответ сразу изменит её настроение."

# ch/morgan/base.rpy:263
translate russian morgan_propose_male_f652b44d:
    "Но она всё так же растеряна и зла на себя."

# ch/morgan/base.rpy:264
translate russian morgan_propose_male_8d96aa8d:
    "И тут я понимаю: она не знает, на что именно я ответил «да»."

# ch/morgan/base.rpy:265
translate russian morgan_propose_male_16b6e039:
    "На предложение или на то, что она только что облажалась на людях!"

# ch/morgan/base.rpy:266
translate russian morgan_propose_male_994581be:
    mike.say "Я хочу сказать: да, Морган, я на тебе женюсь!"

# ch/morgan/base.rpy:267
translate russian morgan_propose_male_940d0d48:
    "Я машинально наклоняюсь, осторожно беру её за запястья и помогаю встать."

# ch/morgan/base.rpy:268
translate russian morgan_propose_male_2dac2b89:
    "Она не сопротивляется, всё ещё ошеломлённо глядя мне прямо в глаза."

# ch/morgan/base.rpy:269
translate russian morgan_propose_male_ef58e7e4:
    mike.say "Эй, Морган?"

# ch/morgan/base.rpy:270
translate russian morgan_propose_male_c8c4ad47:
    mike.say "Земля вызывает Морган!"

# ch/morgan/base.rpy:272
translate russian morgan_propose_male_51f5dca4:
    "Наконец Морган начинает выходить из оцепенения и приходить в себя."

# ch/morgan/base.rpy:273
translate russian morgan_propose_male_13b21ca3:
    "Другой парень мог бы даже обидеться на её поступок."

# ch/morgan/base.rpy:274
translate russian morgan_propose_male_0f69c2c7:
    "Решил бы, что это угрожает его хрупкой мужественности."

# ch/morgan/base.rpy:275
translate russian morgan_propose_male_1453a465:
    "Но сомневаюсь, что такой парень вообще смог бы быть с Морган!"

# ch/morgan/base.rpy:276
translate russian morgan_propose_male_2459f65a:
    "Она не тихоня и не скромница, какой некоторые всё ещё хотят видеть любую девушку."

# ch/morgan/base.rpy:277
translate russian morgan_propose_male_71edc8e2:
    "Но именно это делает её особенной."

# ch/morgan/base.rpy:278
translate russian morgan_propose_male_8d051c98:
    "И за это я её тоже люблю."

# ch/morgan/base.rpy:279
translate russian morgan_propose_male_642cbfdc:
    "Сделав мне предложение, она проявила невероятную смелость."

# ch/morgan/base.rpy:280
translate russian morgan_propose_male_41625ce4:
    "Показала, что чувствует ко мне то же самое."

# ch/morgan/base.rpy:281
translate russian morgan_propose_male_22efd97c:
    mike.say "Морган, мне что, САМОМУ надевать себе кольцо?!"

# ch/morgan/base.rpy:283
translate russian morgan_propose_male_dc0c80b3:
    "Морган трясёт головой, окончательно прогоняя оцепенение."

# ch/morgan/base.rpy:284
translate russian morgan_propose_male_83016106:
    "И на её лице постепенно появляется знакомая улыбка."

# ch/morgan/base.rpy:285
translate russian morgan_propose_male_316ebc00:
    morgan.say "Значит, ты хочешь?"

# ch/morgan/base.rpy:286
translate russian morgan_propose_male_2cd74531:
    morgan.say "Жениться на мне, в смысле?"

# ch/morgan/base.rpy:287
translate russian morgan_propose_male_6448b9c0:
    "Она надевает кольцо мне на палец."

# ch/morgan/base.rpy:288
translate russian morgan_propose_male_9e90590f:
    "И я не боюсь признаться, что в этот момент у меня трепещет сердце."

# ch/morgan/base.rpy:289
translate russian morgan_propose_male_3156fa63:
    mike.say "Конечно хочу, Морган."

# ch/morgan/base.rpy:290
translate russian morgan_propose_male_8beb5575:
    mike.say "Больше не представляю своей жизни без тебя."

# ch/morgan/base.rpy:291
translate russian morgan_propose_male_81c2f3c9:
    mike.say "И клянусь, я бы сам решился сделать тебе предложение."

# ch/morgan/base.rpy:292
translate russian morgan_propose_male_195a5272:
    mike.say "Рано или поздно..."

# ch/morgan/base.rpy:293
translate russian morgan_propose_male_7acba8cb:
    morgan.say "Значит, ты не против, что я..."

# ch/morgan/base.rpy:294
translate russian morgan_propose_male_73fe7790:
    "Я качаю головой, улыбаясь в ответ."

# ch/morgan/base.rpy:295
translate russian morgan_propose_male_4198df9b:
    mike.say "Да нет, совсем."

# ch/morgan/base.rpy:296
translate russian morgan_propose_male_842ff058:
    mike.say "Я довольно современный парень, знаешь ли."

# ch/morgan/base.rpy:297
translate russian morgan_propose_male_af24927d:
    mike.say "Даже встречаюсь с девушками, которых раньше принимал за парней!"

# ch/morgan/base.rpy:299
translate russian morgan_propose_male_9d9767b0:
    "Морган широко раскрывает глаза и шутливо бьёт меня по плечу."

# ch/morgan/base.rpy:301
translate russian morgan_propose_male_9711af48:
    "Но в следующее мгновение обхватывает руками и крепко прижимает к себе."

# ch/morgan/base.rpy:302
translate russian morgan_propose_male_5af5e81f:
    "Она кладёт голову мне на плечо и устало, но удовлетворённо вздыхает."

# ch/morgan/base.rpy:303
translate russian morgan_propose_male_e03ebed7:
    "Обнимая её в ответ, я прижимаюсь щекой к её макушке."

# ch/morgan/base.rpy:304
translate russian morgan_propose_male_5bae2881:
    mike.say "Вообще, это особенное чувство — узнать, что ощущает девушка в такой ситуации."

# ch/morgan/base.rpy:306
translate russian morgan_propose_male_c8cc1021:
    morgan.say "Ты серьёзно?"

# ch/morgan/base.rpy:307
translate russian morgan_propose_male_1872f7a2:
    mike.say "Да, Морган, серьёзно."

# ch/morgan/base.rpy:308
translate russian morgan_propose_male_0963b9d6:
    mike.say "Не помню, чтобы когда-нибудь чувствовал себя настолько желанным... нет, нужным, как сейчас."

# ch/morgan/base.rpy:309
translate russian morgan_propose_male_87662a04:
    morgan.say "Я люблю тебя, [lssb_morgan.hero_name()]."

# ch/morgan/base.rpy:310
translate russian morgan_propose_male_b4c1d7b6:
    mike.say "Да, Морган, я знаю."

# ch/morgan/base.rpy:311
translate russian morgan_propose_male_ce8da0ab:
    mike.say "Я тоже тебя люблю."

# ch/morgan/base.rpy:315
translate russian morgan_propose_male_df9b076c:
    "Мне казалось, за последнее время мы с Морган продвинулись далеко вперёд и я справился со своими прежними заморочками."

# ch/morgan/base.rpy:316
translate russian morgan_propose_male_51a2aba9:
    "С тех пор как мы начали встречаться, лёгкие отношения словно в мгновение ока стали серьёзными."

# ch/morgan/base.rpy:317
translate russian morgan_propose_male_81f15529:
    "А вся прежняя неловкость рядом с ней почти превратилась в смутное воспоминание."

# ch/morgan/base.rpy:318
translate russian morgan_propose_male_f575f4e5:
    "Вот почему я решил, что пора как-то закрепить этот успех."

# ch/morgan/base.rpy:319
translate russian morgan_propose_male_aaa55aaf:
    "Но как именно?"

# ch/morgan/base.rpy:320
translate russian morgan_propose_male_71109964:
    "Хотелось сделать для Морган что-то значимое, показать, насколько она мне дорога."

# ch/morgan/base.rpy:321
translate russian morgan_propose_male_95b3b237:
    "И мне очень хотелось, чтобы наши отношения продолжали развиваться так же хорошо."

# ch/morgan/base.rpy:322
translate russian morgan_propose_male_9ae91945:
    "Так что может быть лучше, чем купить кольцо и сделать ей предложение?"

# ch/morgan/base.rpy:323
translate russian morgan_propose_male_cf4f050a:
    "Да, знаю: звучит просто, хотя на деле всё совсем не так."

# ch/morgan/base.rpy:324
translate russian morgan_propose_male_cc3ad073:
    "Просто тогда я плохо соображал, иначе сам бы это понял."

# ch/morgan/base.rpy:325
translate russian morgan_propose_male_f5fcbeef:
    "Наверное, меня просто захлестнули чувства к Морган."

# ch/morgan/base.rpy:326
translate russian morgan_propose_male_37e56568:
    "И опомнился я лишь тогда, когда уже опустился на одно колено!"

# ch/morgan/base.rpy:327
translate russian morgan_propose_male_6c598256:
    "Итак, стою на колене с кольцом в руке."

# ch/morgan/base.rpy:329
translate russian morgan_propose_male_ddc0df49:
    "Морган только что заметила, что я делаю."

# ch/morgan/base.rpy:330
translate russian morgan_propose_male_d44733a6:
    "Но по её лицу видно: смысл моих действий она ещё не вполне осознала."

# ch/morgan/base.rpy:331
translate russian morgan_propose_male_663bb120:
    "Господи, почему серьёзность происходящего дошла до меня только сейчас?"

# ch/morgan/base.rpy:332
translate russian morgan_propose_male_9e25fc8e:
    "Я ведь сам подставляюсь под удар."

# ch/morgan/base.rpy:333
translate russian morgan_propose_male_1e80e3da:
    "А если она скажет «нет»?"

# ch/morgan/base.rpy:334
translate russian morgan_propose_male_dbf1eff9:
    "А если рассмеётся мне в лицо или сбежит при виде кольца?"

# ch/morgan/base.rpy:335
translate russian morgan_propose_male_59669d60:
    "А если она и правда скажет «да»?!"

# ch/morgan/base.rpy:336
translate russian morgan_propose_male_1c1f7d7c:
    "Все прежние сомнения и комплексы, связанные с Морган, начинают возвращаться."

# ch/morgan/base.rpy:337
translate russian morgan_propose_male_b0e33cb1:
    "Будто вдруг исчезли все наши свидания."

# ch/morgan/base.rpy:338
translate russian morgan_propose_male_f56c1bd9:
    "Все откровенные разговоры, все моменты, когда мы словно становились ближе."

# ch/morgan/base.rpy:339
translate russian morgan_propose_male_7af5fa78:
    "Будто меня лишают всего тепла и уверенности, которые они мне подарили."

# ch/morgan/base.rpy:341
translate russian morgan_propose_male_aa85894a:
    morgan.say "Э-э, [lssb_morgan.hero_name()]..."

# ch/morgan/base.rpy:342
translate russian morgan_propose_male_42e3f597:
    mike.say "Д... да, Морган?"

# ch/morgan/base.rpy:344
translate russian morgan_propose_male_50bfd86a:
    morgan.say "Что ты делаешь?"

# ch/morgan/base.rpy:345
translate russian morgan_propose_male_8bd59d7c:
    "Ну, вот и всё."

# ch/morgan/base.rpy:346
translate russian morgan_propose_male_4d7e8f77:
    "Сейчас или никогда..."

# ch/morgan/base.rpy:347
translate russian morgan_propose_male_7c1c3fa8:
    mike.say "Морган..."

# ch/morgan/base.rpy:348
translate russian morgan_propose_male_bc650587:
    mike.say "Ты выйдешь..."

# ch/morgan/base.rpy:350
translate russian morgan_propose_male_8069cfae:
    mike.say "Ты выйдешь за меня?"

# ch/morgan/base.rpy:351
translate russian morgan_propose_male_4adfadf8:
    "Произнося это, я поднимаю кольцо, чтобы Морган точно его увидела."

# ch/morgan/base.rpy:352
translate russian morgan_propose_male_a7797248:
    "Удивление на лице Морган мгновенно вызывает у меня панику."

# ch/morgan/base.rpy:353
translate russian morgan_propose_male_4c5ac73e:
    "Почему она молчит?"

# ch/morgan/base.rpy:354
translate russian morgan_propose_male_59188497:
    "Почему вдруг так растерялась?"

# ch/morgan/base.rpy:355
translate russian morgan_propose_male_497f38fa:
    "Неужели моё предложение настолько неожиданно?"

# ch/morgan/base.rpy:356
translate russian morgan_propose_male_96c2fed6:
    "Зачем ещё парень встаёт на колено перед своей девушкой?"

# ch/morgan/base.rpy:357
translate russian morgan_propose_male_68db3cab:
    "Неужели она медлит по какой-то другой причине?!"

# ch/morgan/base.rpy:358
translate russian morgan_propose_male_61baef27:
    "Наконец Морган трясёт головой, словно сбрасывая краткое оцепенение."

# ch/morgan/base.rpy:359
translate russian morgan_propose_male_ee9a34f8:
    "Она открывает рот."

# ch/morgan/base.rpy:360
translate russian morgan_propose_male_e398312d:
    "А я буквально замираю в ожидании следующих слов..."

# ch/morgan/base.rpy:362
translate russian morgan_propose_male_ffe1ea9d:
    "Едва Морган начинает качать головой, я уже чувствую, как всё внутри обрывается."

# ch/morgan/base.rpy:363
translate russian morgan_propose_male_06fe7651:
    "Будто внутренности превратились в воду и целиком вытекли из меня."

# ch/morgan/base.rpy:364
translate russian morgan_propose_male_e32fa744:
    "Поэтому, когда она заговаривает, я словно уже знаю, что услышу."

# ch/morgan/base.rpy:365
translate russian morgan_propose_male_57f14c09_2:
    morgan.say "[lssb_morgan.hero_name()]..."

# ch/morgan/base.rpy:366
translate russian morgan_propose_male_354fdce7:
    morgan.say "Я понятия не имела, что ты собираешься это спросить!"

# ch/morgan/base.rpy:367
translate russian morgan_propose_male_03e51177:
    mike.say "Ну, в этом и смысл, Морган."

# ch/morgan/base.rpy:368
translate russian morgan_propose_male_ed2bc83e:
    mike.say "Если бы ты знала о предложении заранее, это ведь не было бы сюрпризом?"

# ch/morgan/base.rpy:369
translate russian morgan_propose_male_fa8199c4:
    mike.say "Хотя, может, тогда я бы не выставил себя таким идиотом..."

# ch/morgan/base.rpy:370
translate russian morgan_propose_male_2d5c7236:
    morgan.say "Я просто ещё не готова к таким обязательствам."

# ch/morgan/base.rpy:371
translate russian morgan_propose_male_e5cd417b:
    "Я убираю кольцо и медленно поднимаюсь."

# ch/morgan/base.rpy:372
translate russian morgan_propose_male_9d4d55db:
    mike.say "А... ладно, Морган."

# ch/morgan/base.rpy:374
translate russian morgan_propose_male_9bce34f6:
    "Морган улыбается, и я вижу, как ей уже легче от того, что неловкий момент позади."

# ch/morgan/base.rpy:380
translate russian morgan_propose_male_df9b076c_1:
    "Мне казалось, за последнее время мы с Морган продвинулись далеко вперёд и я справился со своими прежними заморочками."

# ch/morgan/base.rpy:381
