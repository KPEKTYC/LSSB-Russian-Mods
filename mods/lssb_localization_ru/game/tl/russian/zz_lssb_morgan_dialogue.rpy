# ch/morgan/base.rpy:384
translate russian morgan_propose_male_aaa55aaf_1:
    "Но как именно?"

# ch/morgan/base.rpy:385
translate russian morgan_propose_male_71109964_1:
    "Хотелось сделать для Морган что-то значимое, показать, насколько она мне дорога."

# ch/morgan/base.rpy:386
translate russian morgan_propose_male_95b3b237_1:
    "И мне очень хотелось, чтобы наши отношения продолжали развиваться так же хорошо."

# ch/morgan/base.rpy:387
translate russian morgan_propose_male_9ae91945_1:
    "Так что может быть лучше, чем купить кольцо и сделать ей предложение?"

# ch/morgan/base.rpy:388
translate russian morgan_propose_male_cf4f050a_1:
    "Да, знаю: звучит просто, хотя на деле всё совсем не так."

# ch/morgan/base.rpy:389
translate russian morgan_propose_male_cc3ad073_1:
    "Просто тогда я плохо соображал, иначе сам бы это понял."

# ch/morgan/base.rpy:390
translate russian morgan_propose_male_f5fcbeef_1:
    "Наверное, меня просто захлестнули чувства к Морган."

# ch/morgan/base.rpy:391
translate russian morgan_propose_male_37e56568_1:
    "И опомнился я лишь тогда, когда уже опустился на одно колено!"

# ch/morgan/base.rpy:392
translate russian morgan_propose_male_6c598256_1:
    "Итак, стою на колене с кольцом в руке."

# ch/morgan/base.rpy:394
translate russian morgan_propose_male_ddc0df49_1:
    "Морган только что заметила, что я делаю."

# ch/morgan/base.rpy:395
translate russian morgan_propose_male_d44733a6_1:
    "Но по её лицу видно: смысл моих действий она ещё не вполне осознала."

# ch/morgan/base.rpy:396
translate russian morgan_propose_male_663bb120_1:
    "Господи, почему серьёзность происходящего дошла до меня только сейчас?"

# ch/morgan/base.rpy:397
translate russian morgan_propose_male_9e25fc8e_1:
    "Я ведь сам подставляюсь под удар."

# ch/morgan/base.rpy:398
translate russian morgan_propose_male_1e80e3da_1:
    "А если она скажет «нет»?"

# ch/morgan/base.rpy:399
translate russian morgan_propose_male_dbf1eff9_1:
    "А если рассмеётся мне в лицо или сбежит при виде кольца?"

# ch/morgan/base.rpy:400
translate russian morgan_propose_male_59669d60_1:
    "А если она и правда скажет «да»?!"

# ch/morgan/base.rpy:401
translate russian morgan_propose_male_1c1f7d7c_1:
    "Все прежние сомнения и комплексы, связанные с Морган, начинают возвращаться."

# ch/morgan/base.rpy:402
translate russian morgan_propose_male_b0e33cb1_1:
    "Будто вдруг исчезли все наши свидания."

# ch/morgan/base.rpy:403
translate russian morgan_propose_male_f56c1bd9_1:
    "Все откровенные разговоры, все моменты, когда мы словно становились ближе."

# ch/morgan/base.rpy:404
translate russian morgan_propose_male_7af5fa78_1:
    "Будто меня лишают всего тепла и уверенности, которые они мне подарили."

# ch/morgan/base.rpy:406
translate russian morgan_propose_male_aa85894a_1:
    morgan.say "Э-э, [lssb_morgan.hero_name()]..."

# ch/morgan/base.rpy:407
translate russian morgan_propose_male_42e3f597_1:
    mike.say "Д... да, Морган?"

# ch/morgan/base.rpy:409
translate russian morgan_propose_male_50bfd86a_1:
    morgan.say "Что ты делаешь?"

# ch/morgan/base.rpy:410
translate russian morgan_propose_male_8bd59d7c_1:
    "Ну, вот и всё."

# ch/morgan/base.rpy:411
translate russian morgan_propose_male_4d7e8f77_1:
    "Сейчас или никогда..."

# ch/morgan/base.rpy:412
translate russian morgan_propose_male_7c1c3fa8_1:
    mike.say "Морган..."

# ch/morgan/base.rpy:413
translate russian morgan_propose_male_bc650587_1:
    mike.say "Ты выйдешь..."

# ch/morgan/base.rpy:415
translate russian morgan_propose_male_8069cfae_1:
    mike.say "Ты выйдешь за меня?"

# ch/morgan/base.rpy:416
translate russian morgan_propose_male_4adfadf8_1:
    "Произнося это, я поднимаю кольцо, чтобы Морган точно его увидела."

# ch/morgan/base.rpy:417
translate russian morgan_propose_male_a7797248_1:
    "Удивление на лице Морган мгновенно вызывает у меня панику."

# ch/morgan/base.rpy:418
translate russian morgan_propose_male_4c5ac73e_1:
    "Почему она молчит?"

# ch/morgan/base.rpy:419
translate russian morgan_propose_male_59188497_1:
    "Почему вдруг так растерялась?"

# ch/morgan/base.rpy:420
translate russian morgan_propose_male_497f38fa_1:
    "Неужели моё предложение настолько неожиданно?"

# ch/morgan/base.rpy:421
translate russian morgan_propose_male_96c2fed6_1:
    "Зачем ещё парень встаёт на колено перед своей девушкой?"

# ch/morgan/base.rpy:422
translate russian morgan_propose_male_68db3cab_1:
    "Неужели она медлит по какой-то другой причине?!"

# ch/morgan/base.rpy:423
translate russian morgan_propose_male_61baef27_1:
    "Наконец Морган трясёт головой, словно сбрасывая краткое оцепенение."

# ch/morgan/base.rpy:424
translate russian morgan_propose_male_ee9a34f8_1:
    "Она открывает рот."

# ch/morgan/base.rpy:425
translate russian morgan_propose_male_e398312d_1:
    "А я буквально замираю в ожидании следующих слов..."

# ch/morgan/base.rpy:428
translate russian morgan_propose_male_e39eb65e:
    "Когда Морган начинает энергично кивать, я чуть не забываю, что означает этот жест."

# ch/morgan/base.rpy:429
translate russian morgan_propose_male_8ba4364c:
    "Но какая-то часть меня, видимо, понимает всё лучше: в животе уже порхают бабочки."

# ch/morgan/base.rpy:430
translate russian morgan_propose_male_7c557407:
    "Морган прикусывает губу, хватает меня за руки и поднимает на ноги."

# ch/morgan/base.rpy:431
translate russian morgan_propose_male_5d2f3639:
    "Кажется, она сейчас лопнет от переполняющих чувств!"

# ch/morgan/base.rpy:432
translate russian morgan_propose_male_61511c58:
    morgan.say "[lssb_morgan.hero_name()], ты правда этого хочешь?!"

# ch/morgan/base.rpy:433
translate russian morgan_propose_male_0698c838:
    "Признаюсь, услышать я ожидал совсем другое!"

# ch/morgan/base.rpy:434
translate russian morgan_propose_male_d5fc3fb0:
    mike.say "Э-э, да, Морган! Правда!"

# ch/morgan/base.rpy:436
translate russian morgan_propose_male_58c4bcdb:
    morgan.say "Тогда мой ответ — да."

# ch/morgan/base.rpy:437
translate russian morgan_propose_male_5f89075d:
    morgan.say "Да, я выйду за тебя!"

# ch/morgan/base.rpy:438
translate russian morgan_propose_male_d7beeba3:
    "Она нетерпеливо шевелит пальцами у меня перед лицом."

# ch/morgan/base.rpy:439
translate russian morgan_propose_male_f7d9d11d:
    morgan.say "Ну, чего ты ждёшь?"

# ch/morgan/base.rpy:440
translate russian morgan_propose_male_67e265ea:
    morgan.say "Надень уже это чёртово кольцо, пока не передумал!"

# ch/morgan/base.rpy:441
translate russian morgan_propose_male_d982cd91:
    "Я спешу послушаться и неловко надеваю кольцо на протянутый палец Морган."

# ch/morgan/base.rpy:442
translate russian morgan_propose_male_b8f5a307:
    "И замечаю: она сказала «пока ты не передумал», а не пока передумала ОНА!"

# ch/morgan/base.rpy:443
translate russian morgan_propose_male_ef13b22a:
    "Неужели она всерьёз боится, что это я дам задний ход?!"

# ch/morgan/base.rpy:444
translate russian morgan_propose_male_27365ec5:
    "Наверное, у девушек могут быть те же сомнения, что и у парней."

# ch/morgan/base.rpy:445
translate russian morgan_propose_male_2d7882c7:
    "Но я бы никогда не подумал, что такая дерзкая и уверенная в себе Морган хоть на секунду сомневается в себе."

# ch/morgan/base.rpy:446
translate russian morgan_propose_male_c6d7ad4a:
    "И ещё удивительнее, что она допускала, будто мои чувства к ней могут остыть!"

# ch/morgan/base.rpy:447
translate russian morgan_propose_male_8ef00495:
    "Вот и доказательство: невозможно знать о человеке абсолютно всё."

# ch/morgan/base.rpy:448
translate russian morgan_propose_male_5a56bdb0:
    mike.say "Я переживал, Морган."

# ch/morgan/base.rpy:449
translate russian morgan_propose_male_a8f8c635:
    mike.say "Боялся, что ты откажешь!"

# ch/morgan/base.rpy:451
translate russian morgan_propose_male_38cbb991:
    "Пока я говорю, Морган неотрывно любуется кольцом на пальце."

# ch/morgan/base.rpy:452
translate russian morgan_propose_male_b7e11e3a:
    "Но на мои слова поднимает удивлённый взгляд."

# ch/morgan/base.rpy:453
translate russian morgan_propose_male_727ab9e7:
    morgan.say "А я боялась, что ты так и не предложишь."

# ch/morgan/base.rpy:454
translate russian morgan_propose_male_64f2adde:
    morgan.say "Вот сколько, оказывается, мы друг о друге не знаем!"

# ch/morgan/base.rpy:455
translate russian morgan_propose_male_300a9d55:
    morgan.say "А если серьёзно, [lssb_morgan.hero_name()], я точно знаю, что хочу быть с тобой."

# ch/morgan/base.rpy:456
translate russian morgan_propose_male_cb466bc1:
    morgan.say "И мне этого достаточно."

# ch/morgan/base.rpy:457
translate russian morgan_propose_male_5a34cd71:
    "Я только улыбаюсь, потеряв дар речи и переполняясь счастьем."

# ch/morgan/base.rpy:458
translate russian morgan_propose_male_b628fc53:
    "Дело не только в том, что я рад возвращению Морган в мою жизнь после стольких лет."

# ch/morgan/base.rpy:459
translate russian morgan_propose_male_40693c77:
    "Ещё больше радует, что вместе с ней я открыл совершенно новый мир возможностей."

# ch/morgan/base.rpy:463
translate russian morgan_propose_male_ffe1ea9d_1:
    "Едва Морган начинает качать головой, я уже чувствую, как всё внутри обрывается."

# ch/morgan/base.rpy:464
translate russian morgan_propose_male_06fe7651_1:
    "Будто внутренности превратились в воду и целиком вытекли из меня."

# ch/morgan/base.rpy:465
translate russian morgan_propose_male_e32fa744_1:
    "Поэтому, когда она заговаривает, я словно уже знаю, что услышу."

# ch/morgan/base.rpy:466
translate russian morgan_propose_male_68569b00:
    morgan.say "Ох, [lssb_morgan.hero_name()]..."

# ch/morgan/base.rpy:467
translate russian morgan_propose_male_354fdce7_1:
    morgan.say "Я понятия не имела, что ты собираешься это спросить!"

# ch/morgan/base.rpy:468
translate russian morgan_propose_male_03e51177_1:
    mike.say "Ну, в этом и смысл, Морган."

# ch/morgan/base.rpy:469
translate russian morgan_propose_male_ed2bc83e_1:
    mike.say "Если бы ты знала о предложении заранее, это ведь не было бы сюрпризом?"

# ch/morgan/base.rpy:470
translate russian morgan_propose_male_fa8199c4_1:
    mike.say "Хотя, может, тогда я бы не выставил себя таким идиотом..."

# ch/morgan/base.rpy:471
translate russian morgan_propose_male_209a1d2b:
    "Моя повисшая в воздухе фраза заставляет Морган встрепенуться."

# ch/morgan/base.rpy:472
translate russian morgan_propose_male_81bfe995:
    "Она словно вдруг понимает, что тоже держит меня в подвешенном состоянии!"

# ch/morgan/base.rpy:473
translate russian morgan_propose_male_68569b00_1:
    morgan.say "Ох, [lssb_morgan.hero_name()]..."

# ch/morgan/base.rpy:474
translate russian morgan_propose_male_941fead8:
    morgan.say "Это так мило с твоей стороны, так романтично..."

# ch/morgan/base.rpy:475
translate russian morgan_propose_male_fdb1e7f4:
    mike.say "Но сейчас будет «но», да?"

# ch/morgan/base.rpy:476
translate russian morgan_propose_male_9baf791a:
    morgan.say "Но я просто ещё не готова к таким обязательствам."

# ch/morgan/base.rpy:477
translate russian morgan_propose_male_e9075900:
    morgan.say "То есть я ОЧЕНЬ рада, что ТЫ готов."

# ch/morgan/base.rpy:478
translate russian morgan_propose_male_106c4b36:
    morgan.say "Дело не в тебе, а во мне!"

# ch/morgan/base.rpy:479
translate russian morgan_propose_male_6380b580:
    "Я правда это слышу?"

# ch/morgan/base.rpy:480
translate russian morgan_propose_male_3bbe34fa:
    "Она только что выдала самое избитое клише всех времён?"

# ch/morgan/base.rpy:481
translate russian morgan_propose_male_90f3a8ae:
    "Но даже если так, что я могу сделать?"

# ch/morgan/base.rpy:482
translate russian morgan_propose_male_ca40ded7:
    "Конечно, можно весь день пытаться переубедить Морган."

# ch/morgan/base.rpy:483
translate russian morgan_propose_male_661437a2:
    "Но тогда я просто буду уговаривать её сделать то, чего она явно не хочет."

# ch/morgan/base.rpy:484
translate russian morgan_propose_male_fc82de69:
    "А я не из тех, кому нужна жена, которую принудили к браку!"

# ch/morgan/base.rpy:485
translate russian morgan_propose_male_cfcd17e4:
    "Поэтому убираю кольцо и медленно встаю."

# ch/morgan/base.rpy:486
translate russian morgan_propose_male_9d4d55db_1:
    mike.say "А... ладно, Морган."

# ch/morgan/base.rpy:487
translate russian morgan_propose_male_039c7a05:
    mike.say "Я тебя понимаю."

# ch/morgan/base.rpy:488
translate russian morgan_propose_male_c6c027cc:
    mike.say "Спасибо за честность. Для меня это важно."

# ch/morgan/base.rpy:490
translate russian morgan_propose_male_9bce34f6_1:
    "Морган улыбается, и я вижу, как ей уже легче от того, что неловкий момент позади."

# ch/morgan/base.rpy:491
translate russian morgan_propose_male_c305a52c:
    "Но к облегчению примешивается сильное чувство вины, вполне ожидаемое после отказа на искреннее предложение."

# ch/morgan/base.rpy:492
translate russian morgan_propose_male_874206b6:
    "Я легко мог бы этим воспользоваться, но не хочу быть таким человеком."

# ch/morgan/base.rpy:493
translate russian morgan_propose_male_47a5c0e5:
    morgan.say "Нет, [lssb_morgan.hero_name()], это ТЕБЕ спасибо за то, что так ко мне относишься."

# ch/morgan/base.rpy:494
translate russian morgan_propose_male_885cf661:
    morgan.say "И кто знает, может, в следующий раз я уже буду готова!"

# ch/morgan/base.rpy:495
translate russian morgan_propose_male_6dc5df36:
    "Я киваю и улыбаюсь, молча надеясь, что сумею набраться смелости для второй попытки."

# ch/morgan/base.rpy:501
translate russian morgan_propose_male_6c630beb:
    "Пока я всё планировал, ни разу даже не задумался, хорошая ли это идея."

# ch/morgan/base.rpy:502
translate russian morgan_propose_male_dda1595f:
    "С самого начала я был уверен: купить кольцо и сделать Морган предложение — правильный шаг."

# ch/morgan/base.rpy:503
translate russian morgan_propose_male_d2386d5f:
    "Мы ведь с первого свидания прекрасно ладим, и страсти между нами хоть отбавляй!"

# ch/morgan/base.rpy:504
translate russian morgan_propose_male_46f3d687:
    "Даже в разлуке она почти постоянно занимает мои мысли."

# ch/morgan/base.rpy:505
translate russian morgan_propose_male_23781c57:
    "Я либо вспоминаю нашу последнюю встречу, либо планирую следующую."

# ch/morgan/base.rpy:506
translate russian morgan_propose_male_e95954a7:
    "Она такая милая, нежная и очаровательная, что трудно поверить: это та же девушка, которую я знал много лет назад."

# ch/morgan/base.rpy:507
translate russian morgan_propose_male_3f29b8e1:
    "Ведь прежняя Морган была такой пацанкой, что я и впрямь принимал её за мальчишку!"

# ch/morgan/base.rpy:508
translate russian morgan_propose_male_962a1cda:
    "А теперь она будто только и хочет, что наряжаться для меня и делать всё ради моего счастья."

# ch/morgan/base.rpy:509
translate russian morgan_propose_male_d0b0486a:
    "На днях Морган чуть не угодила в паутину с одним из самых здоровенных пауков, каких я видел."

# ch/morgan/base.rpy:510
translate russian morgan_propose_male_8578593b:
    "Я ожидал, что она просто смахнёт её, как сделала бы в детстве."

# ch/morgan/base.rpy:511
translate russian morgan_propose_male_2f6fc757:
    "А вместо этого она взвизгнула и буквально прыгнула ко мне на руки!"

# ch/morgan/base.rpy:512
translate russian morgan_propose_male_cd7ece55:
    "Конечно, поначалу я опешил."

# ch/morgan/base.rpy:513
translate russian morgan_propose_male_50ecd23b:
    "Такого не ждёшь от современной девушки в подобной ситуации."

# ch/morgan/base.rpy:514
translate russian morgan_propose_male_240f3c2d:
    "Но признаюсь, в тот момент это меня здорово завело!"

# ch/morgan/base.rpy:515
translate russian morgan_propose_male_3b56d60a:
    "Само осознание, что она ждёт от меня защиты от чего-то страшного."

# ch/morgan/base.rpy:516
translate russian morgan_propose_male_2fe886de:
    "Пусть даже от крошечного паука, который, наверное, боялся её больше, чем она его..."

# ch/morgan/base.rpy:517
translate russian morgan_propose_male_02618eb6:
    "Пожалуй, это одна из причин, по которым мне вообще захотелось сделать Морган предложение."

# ch/morgan/base.rpy:518
translate russian morgan_propose_male_a58323d0:
    "Рядом с ней хочется и дальше её защищать."

# ch/morgan/base.rpy:519
translate russian morgan_propose_male_4a146798:
    "Следить, чтобы ничто в мире больше не могло ей навредить."

# ch/morgan/base.rpy:520
translate russian morgan_propose_male_13cd58c9:
    "Ну, разве что слегка напугать, как тот самый паук..."

# ch/morgan/base.rpy:521
translate russian morgan_propose_male_b78819b3:
    "Поэтому, улучив подходящий момент, я опускаюсь на одно колено."

# ch/morgan/base.rpy:524
translate russian morgan_propose_male_f44dd65f:
    mike.say "Морган, я хотел спросить..."

# ch/morgan/base.rpy:525
translate russian morgan_propose_male_4cc27ef2:
    mike.say "Ты бы..."

# ch/morgan/base.rpy:527
translate russian morgan_propose_male_bb5e8026:
    "Я замолкаю, не успев договорить."

# ch/morgan/base.rpy:528
translate russian morgan_propose_male_2acf92b8:
    "Крепко сжимаю в руках коробочку с кольцом."

# ch/morgan/base.rpy:529
translate russian morgan_propose_male_6d966a51:
    "И дело даже не в выражении лица Морган."

# ch/morgan/base.rpy:530
translate russian morgan_propose_male_8b2021f7:
    "Скорее в том, что я, кажется, буквально слышу, как она дрожит от восторга."

# ch/morgan/base.rpy:531
translate russian morgan_propose_male_3ff1f0ce:
    "Глаза у неё как блюдца, а улыбка почти до ушей."

# ch/morgan/base.rpy:532
translate russian morgan_propose_male_409f7373:
    "Она так сияет, что напоминает героиню какого-нибудь приторно милого аниме!"

# ch/morgan/base.rpy:533
translate russian morgan_propose_male_a5b398c7:
    mike.say "Э-э, Морган..."

# ch/morgan/base.rpy:534
translate russian morgan_propose_male_9fd2d5ce:
    mike.say "Ты... ты выйдешь за меня?"

# ch/morgan/base.rpy:536
translate russian morgan_propose_male_d983e4ad:
    "Морган сжимает ладони под подбородком."

# ch/morgan/base.rpy:537
translate russian morgan_propose_male_382e4548:
    "А потом буквально начинает прыгать на месте."

# ch/morgan/base.rpy:538
translate russian morgan_propose_male_5bc92af5:
    morgan.say "О да, да, да!"

# ch/morgan/base.rpy:539
translate russian morgan_propose_male_a7384da3:
    morgan.say "Миллион раз да!"

# ch/morgan/base.rpy:540
translate russian morgan_propose_male_9ea4dcd3:
    morgan.say "Конечно выйду, [lssb_morgan.hero_name()]!"

# ch/morgan/base.rpy:541
translate russian morgan_propose_male_304b0551:
    morgan.say "Ты ещё спрашиваешь?!"

# ch/morgan/base.rpy:542
translate russian morgan_propose_male_727e7a7a:
    morgan.say "Ну, конечно, спрашиваешь."

# ch/morgan/base.rpy:543
translate russian morgan_propose_male_505fc5af:
    morgan.say "Иначе как бы ты сейчас сделал предложение!"

# ch/morgan/base.rpy:544
translate russian morgan_propose_male_43721d55:
    mike.say "Ого, Морган, давай немного спокойнее, ладно?"

# ch/morgan/base.rpy:545
translate russian morgan_propose_male_aa365959:
    mike.say "Ты тараторишь без умолку!"

# ch/morgan/base.rpy:547
translate russian morgan_propose_male_3c5d4c42:
    "Морган трясёт головой, и её затуманенный взгляд становится яснее."

# ch/morgan/base.rpy:548
translate russian morgan_propose_male_d9bfde90:
    "Будто она стряхивает охватившее её минуту назад безумие."

# ch/morgan/base.rpy:549
translate russian morgan_propose_male_a9e2313e:
    morgan.say "А, точно..."

# ch/morgan/base.rpy:550
translate russian morgan_propose_male_2ec5becc:
    morgan.say "Прости, просто в голове вдруг столько прекрасных мыслей!"

# ch/morgan/base.rpy:551
translate russian morgan_propose_male_e93db55c:
    "Я немного настороженно улыбаюсь, достаю кольцо из коробочки и надеваю ей на палец."

# ch/morgan/base.rpy:552
translate russian morgan_propose_male_9c80bf65:
    "И всё это время всерьёз опасаюсь, что она опять начнёт тараторить."

# ch/morgan/base.rpy:553
translate russian morgan_propose_male_bd91b83a:
    "Я медленно встаю, всё ещё держа Морган за руку."

# ch/morgan/base.rpy:554
translate russian morgan_propose_male_833bcb55:
    "Она не сводит с меня глаз, словно ждёт безмолвного сигнала."

# ch/morgan/base.rpy:555
translate russian morgan_propose_male_9522425d:
    "Не понимая, чего от меня ждут, я улыбаюсь ей как можно теплее и искреннее."

# ch/morgan/base.rpy:557
translate russian morgan_propose_male_2d24b0f8:
    "Тогда Морган обхватывает меня за пояс и обнимает изо всех сил."

# ch/morgan/base.rpy:558
translate russian morgan_propose_male_0e05b5d4:
    "Я ещё не успеваю ответить на объятие, а воздух уже словно выжимают из моих лёгких."

# ch/morgan/base.rpy:559
translate russian morgan_propose_male_23253f81:
    "Господи, она всегда была такой сильной?"

# ch/morgan/base.rpy:560
translate russian morgan_propose_male_0ec3b4db:
    "Или предложение вызвало безумный прилив адреналина?"

# ch/morgan/base.rpy:561
translate russian morgan_propose_male_6f6d834a:
    "Как бы то ни было, я обнимаю Морган в ответ, насколько могу."

# ch/morgan/base.rpy:562
translate russian morgan_propose_male_63d15778:
    "Ведь я получил тот ответ, которого хотел."

# ch/morgan/base.rpy:563
translate russian morgan_propose_male_4c1156a2:
    "А в конце концов только это и важно."

# ch/morgan/base.rpy:566
translate russian morgan_propose_male_1f1bf6e9:
    "Едва опустившись на колено и начав искать кольцо, я понимаю, что совершил ужасную ошибку."

# ch/morgan/base.rpy:567
translate russian morgan_propose_male_826666ac:
    "Глаза Морган округляются, и я почти вижу момент, когда до неё доходит происходящее."

# ch/morgan/base.rpy:568
translate russian morgan_propose_male_4c83fcf4:
    "Но отступать поздно: я уже открываю коробочку с кольцом и собираюсь задать вопрос."

# ch/morgan/base.rpy:569
translate russian morgan_propose_male_f70ff0bd:
    "В конце концов, что хуже: получить отказ или остановиться, даже не сделав предложения?"

# ch/morgan/base.rpy:570
translate russian morgan_propose_male_f44dd65f_1:
    mike.say "Морган, я хотел спросить..."

# ch/morgan/base.rpy:571
translate russian morgan_propose_male_4cc27ef2_1:
    mike.say "Ты бы..."

# ch/morgan/base.rpy:572
translate russian morgan_propose_male_2fde9353:
    morgan.say "О боже... о боже... о боже!"

# ch/morgan/base.rpy:573
translate russian morgan_propose_male_876d4aa1:
    morgan.say "Это правда происходит?"

# ch/morgan/base.rpy:574
translate russian morgan_propose_male_8ff44772:
    mike.say "Э-э, да, Морган."

# ch/morgan/base.rpy:575
translate russian morgan_propose_male_f4183acd:
    mike.say "Я правда предлагаю тебе выйти за меня!"

# ch/morgan/base.rpy:576
translate russian morgan_propose_male_5b18923c:
    "Морган словно собирается что-то сказать."

# ch/morgan/base.rpy:577
translate russian morgan_propose_male_45e67c0b:
    "Но потом зажимает рот обеими руками и качает головой."

# ch/morgan/base.rpy:578
translate russian morgan_propose_male_31a1ce8d:
    "В её глазах не только растерянность, но и настоящий ужас."

# ch/morgan/base.rpy:579
translate russian morgan_propose_male_b09adae2:
    "Пытаясь встать и спросить, что случилось, я невольно подношу кольцо ещё ближе."

# ch/morgan/base.rpy:580
translate russian morgan_propose_male_9023741b:
    "Морган отшатывается от него, как вампир от чеснока."

# ch/morgan/base.rpy:582
translate russian morgan_propose_male_61e4a465:
    "А мгновение спустя разворачивается и убегает без единого слова."

# ch/morgan/base.rpy:583
translate russian morgan_propose_male_e7c4a403:
    "Оставляет меня одного с открытым ртом и кольцом на ладони."

# ch/morgan/base.rpy:584
translate russian morgan_propose_male_6120b144:
    "Видимо, это её способ сказать «нет»."

# ch/morgan/base.rpy:585
translate russian morgan_propose_male_f44c6c3f:
    "Хотя можно было обойтись без такого спектакля..."

# ch/morgan/chat.rpy:32
translate russian morgan_chat_hang_male_cf9df49d:
    morgan.say "Боже, как же я любила просто слоняться без дела, когда мы были детьми."

# ch/morgan/chat.rpy:33
translate russian morgan_chat_hang_male_558b365e:
    morgan.say "Тогда даже ничегонеделание казалось настоящим занятием."

# ch/morgan/chat.rpy:36
translate russian morgan_chat_hang_male_394d69e6:
    mike.say "Просто расслабляться и убивать время было так здорово."

# ch/morgan/chat.rpy:40
translate russian morgan_chat_hang_male_356ea928:
    mike.say "Но мы из этого вроде выросли, да?"

# ch/morgan/chat.rpy:47
translate russian morgan_chat_hang_male_15b45d5d:
    mike.say "Столько времени вместе, а я ничего о тебе не знал, Морган..."

# ch/morgan/chat.rpy:56
translate russian morgan_chat_bike_male_20c47b97:
    morgan.say "Помнишь, как мы устраивали велогонки по району?"

# ch/morgan/chat.rpy:57
translate russian morgan_chat_bike_male_4a246b96:
    morgan.say "И как однажды Джек свалился, ободрал коленки и разревелся, как последний хлюпик?"

# ch/morgan/chat.rpy:60
translate russian morgan_chat_bike_male_62fbe7f1:
    mike.say "Ты была лихой гонщицей, Морган! Сама же вытеснила Джека с дороги!"

# ch/morgan/chat.rpy:61
translate russian morgan_chat_bike_male_b89e2486:
    morgan.say "Нечего было путаться под колёсами!"

# ch/morgan/chat.rpy:64
translate russian morgan_chat_bike_male_e8a74bfa:
    mike.say "Нет. Увы, теперь мой максимум — велотренажёр в спортзале!"

# ch/morgan/chat.rpy:65
translate russian morgan_chat_bike_male_30da1f41:
    morgan.say "Стареть — отстой, да?"

# ch/morgan/chat.rpy:71
translate russian morgan_chat_bike2_male_d4e582e3:
    morgan.say "Ах, помню, как мы часами вместе катались на великах!"

# ch/morgan/chat.rpy:72
translate russian morgan_chat_bike2_male_4cc9bb63:
    morgan.say "Иногда хотелось просто уехать и никогда не возвращаться."

# ch/morgan/chat.rpy:75
translate russian morgan_chat_bike2_male_bd59852d:
    mike.say "Куда бы ты поехала?"

# ch/morgan/chat.rpy:76
translate russian morgan_chat_bike2_male_37a01b9d:
    morgan.say "Не знаю. Куда угодно? Только не домой."

# ch/morgan/chat.rpy:79
translate russian morgan_chat_bike2_male_4c20cb39:
    mike.say "Но ты осталась! И хорошо: думаю, я бы по тебе скучал."

# ch/morgan/chat.rpy:80
translate russian morgan_chat_bike2_male_6bb97399:
    morgan.say "Как мило!"

# ch/morgan/chat.rpy:86
translate russian morgan_chat_tough_male_d9318261:
    morgan.say "Наверное, в детстве я всё пыталась быть такой же крутой, как мальчишки."

# ch/morgan/chat.rpy:87
translate russian morgan_chat_tough_male_728a167f:
    morgan.say "Просто хотела стать для вас своей."

# ch/morgan/chat.rpy:90
translate russian morgan_chat_tough_male_d04203e5:
    mike.say "Ты так строила из себя крутого парня, что совсем меня провела, Морган."

# ch/morgan/chat.rpy:93
translate russian morgan_chat_tough_male_5f877368:
    mike.say "Не нужно было притворяться крутой, Морган! Ты нравилась нам такой, какая есть."

# ch/morgan/chat.rpy:97
translate russian morgan_chat_tough_male_cb49bf62:
    mike.say "И не получилось. Помню, многие мальчишки над тобой за это смеялись!"

# ch/morgan/chat.rpy:103
translate russian morgan_chat_sexuality_male_f565cfda:
    morgan.say "В детстве я толком не понимала, кто мне нравится. Мне нравились ты и Джек."

# ch/morgan/chat.rpy:104
translate russian morgan_chat_sexuality_male_db2748a0:
    morgan.say "Но девочки меня тоже интересовали."

# ch/morgan/chat.rpy:105
translate russian morgan_chat_sexuality_male_5cc97c40:
    morgan.say "Я так старалась вписаться в вашу компанию, но ничего не выходило."

# ch/morgan/chat.rpy:108
translate russian morgan_chat_sexuality_male_5177a996:
    mike.say "Надо было сильнее стараться. Людям трудно понять такие противоречивые сигналы!"

# ch/morgan/chat.rpy:112
translate russian morgan_chat_sexuality_male_fe46ad12:
    mike.say "Ты слишком старалась! Нужно было просто быть собой. С настоящей тобой очень весело."

# ch/morgan/chat.rpy:116
translate russian morgan_chat_sexuality_male_20298043:
    mike.say "Тогда я не замечал, но теперь понимаю, как ты была растеряна!"

# ch/morgan/chat.rpy:120
translate russian morgan_chat_sexuality_male_74f6c7ab:
    mike.say "Не знаю, важно ли тебе моё мнение, Морган, но, по-моему, здорово, что тебя привлекают и девушки."

# ch/morgan/chat.rpy:121
translate russian morgan_chat_sexuality_male_38883f71:
    morgan.say "Ха! Большинство парней либо пугаются, либо начинают нести сальности."

# ch/morgan/chat.rpy:122
translate russian morgan_chat_sexuality_male_424954f6:
    morgan.say "А ты спокойно к этому относишься... Может, однажды покажу тебе и эту сторону себя."

# ch/morgan/chat.rpy:126
translate russian morgan_chat_sexuality_male_0d018ac0:
    mike.say "Ну, всё это в прошлом. Теперь есть только я, верно, Морган?"

# ch/morgan/chat.rpy:127
translate russian morgan_chat_sexuality_male_1050cc32:
    morgan.say "Полегче, [lssb_morgan.hero_name()]. Мне нравятся те, кто нравится. Это так просто не выключить."

# ch/morgan/chat.rpy:128
translate russian morgan_chat_sexuality_male_9a6f0483:
    morgan.say "Но сейчас? Да, сейчас я увлечена тобой."

# ch/morgan/chat.rpy:133
translate russian morgan_chat_skin_male_e9cc0c00:
    morgan.say "Сейчас мне комфортнее быть собой, чем когда-либо. Та крутизна была просто маской."

# ch/morgan/chat.rpy:134
translate russian morgan_chat_skin_male_f35e1b2b:
    morgan.say "И я рада, что ты помог мне это понять!"

# ch/morgan/chat.rpy:137
translate russian morgan_chat_skin_male_b4031163:
    mike.say "Честно говоря, прежняя ты нравилась мне больше."

# ch/morgan/chat.rpy:141
translate russian morgan_chat_skin_male_11dd2d7c:
    mike.say "Стоило подождать. С тобой теперь очень здорово, Морган!"

# ch/morgan/chat.rpy:145
translate russian morgan_chat_skin_male_20298043:
    mike.say "Тогда я не замечал, но теперь понимаю, как ты была растеряна!"

# ch/morgan/chat.rpy:152
translate russian morgan_chat_feelings_male_5060ad08:
    morgan.say "Знаешь, мне нелегко говорить о чувствах."

# ch/morgan/chat.rpy:153
translate russian morgan_chat_feelings_male_bae98862:
    morgan.say "Но, встретившись с тобой снова, я вспомнила, как сильно была в тебя влюблена!"

# ch/morgan/chat.rpy:155
translate russian morgan_chat_feelings_male_3864a9a4:
    morgan.say "Странно, но я никогда не думала, что у меня будет шанс сделать с тобой всё, о чём я всегда мечтала, [lssb_morgan.hero_name()]!"

# ch/morgan/chat.rpy:157
translate russian morgan_chat_feelings_male_7302de36:
    morgan.say "Ох, [lssb_morgan.hero_name()], наша новая встреча оживила все мои прежние чувства к тебе!"

# ch/morgan/chat.rpy:160
translate russian morgan_chat_feelings_male_92b23adc:
    mike.say "Мне тоже нелегко это сказать, Морган, но я очень рад, что ты снова рядом."

# ch/morgan/chat.rpy:163
translate russian morgan_chat_feelings_male_40915f62:
    mike.say "Я чувствую то же самое, Морган. Будто нам дали второй шанс."

# ch/morgan/chat.rpy:170
translate russian morgan_chat_feelings_male_c6062c28:
    mike.say "Со мной можешь не бояться говорить откровенно, Морган!"

# ch/morgan/chat.rpy:180
translate russian morgan_chat_love_you_male_e27dabac:
    morgan.say "[lssb_morgan.hero_name()]... мне трудно это сказать... очень трудно."

# ch/morgan/chat.rpy:181
translate russian morgan_chat_love_you_male_f4cfc16a:
    morgan.say "Но, кажется, я тебя люблю. Сейчас сильнее, чем когда мы были детьми..."

# ch/morgan/chat.rpy:183
translate russian morgan_chat_love_you_male_a0e89b68:
    morgan.say "Трудно это произнести, [lssb_morgan.hero_name()], но, кажется, я в тебя влюблена!"

# ch/morgan/chat.rpy:185
translate russian morgan_chat_love_you_male_bc4bde42:
    morgan.say "Ох, [lssb_morgan.hero_name()], в юности я всегда тебя любила."

# ch/morgan/chat.rpy:186
translate russian morgan_chat_love_you_male_3a2a93a9:
    morgan.say "А теперь мы снова вместе, и я опять в тебя влюбилась. Словно сказка стала явью!"

# ch/morgan/chat.rpy:189
translate russian morgan_chat_love_you_male_512fd32b:
    mike.say "Э-э... прозвучу глупо, Морган, но, кажется, я тоже тебя люблю!"

# ch/morgan/chat.rpy:192
translate russian morgan_chat_love_you_male_2563633c:
    mike.say "Думаю, это судьба, Морган. Нам на роду написано быть вместе!"

# ch/morgan/chat.rpy:200
translate russian morgan_chat_jack_male_74010ff1:
    morgan.say "Помнишь то лето, когда Джек начал отращивать волосы и слушать тяжёлый метал?"

# ch/morgan/chat.rpy:202
translate russian morgan_chat_jack_male_f91f21e0:
    morgan.say "Помнишь, как Джек ходил с сальными патлами и глушил нас своим тяжёлым металом?"

# ch/morgan/chat.rpy:205
translate russian morgan_chat_jack_male_177176fd:
    mike.say "Да, и с тех пор не свернул с пути. Будет металлистом до самой смерти!"

# ch/morgan/chat.rpy:208
translate russian morgan_chat_jack_male_6ec78656:
    mike.say "Он всегда жил по принципу «всё или ничего». И, похоже, до сих пор так живёт!"

# ch/morgan/chat.rpy:215
translate russian morgan_chat_jack_male_eeed15bb:
    mike.say "Ага, менее сальным и прыщавым он так и не стал — только вырос и растолстел!"

# ch/morgan/chat.rpy:225
translate russian morgan_chat_alexis_male_40a43851:
    morgan.say "Знаешь, я так и не простила Алексис того, что она сделала с тобой в школе."

# ch/morgan/chat.rpy:226
translate russian morgan_chat_alexis_male_2ff04fec:
    morgan.say "Не раз еле сдерживалась, чтобы не врезать ей по зубам..."

# ch/morgan/chat.rpy:229
translate russian morgan_chat_alexis_male_3514faec:
    mike.say "Я бы тебя не остановил, Морган. Ещё и от меня могла бы добавить!"

# ch/morgan/chat.rpy:232
translate russian morgan_chat_alexis_male_91f43c97:
    mike.say "Спасибо, Морган, я это ценю."

# ch/morgan/chat.rpy:233
translate russian morgan_chat_alexis_male_bcbbde67:
    mike.say "Но это было давно. Я лучше сосредоточусь на настоящем."

# ch/morgan/chat.rpy:240
translate russian morgan_chat_alexis_male_662f4a2d:
    mike.say "Не опускайся до её уровня, Морган, иначе будешь ничем не лучше!"

# ch/morgan/chat.rpy:249
translate russian morgan_chat_kylie_male_80e79b4e:
    morgan.say "Кайли ещё маленькой всегда меня пугала."

# ch/morgan/chat.rpy:250
translate russian morgan_chat_kylie_male_d594b2b0:
    morgan.say "Как уставится своими холодными, мёртвыми глазами!"

# ch/morgan/chat.rpy:253
translate russian morgan_chat_kylie_male_f7777b23:
    mike.say "Видела бы ты её сейчас. Не так уж сильно она изменилась!"

# ch/morgan/chat.rpy:256
translate russian morgan_chat_kylie_male_f2dedf59:
    mike.say "Понимаю, о чём ты. Она довольно напряжная!"

# ch/morgan/chat.rpy:263
translate russian morgan_chat_kylie_male_11217b5b:
    mike.say "Она и сейчас жутковатая, Морган. Но не бойся, я её к тебе не подпущу."

# ch/morgan/chat.rpy:272
translate russian morgan_chat_girl_male_3c3fe2d2:
    morgan.say "В детстве ты всегда был безрассудным и нетерпеливым, [lssb_morgan.hero_name()]."

# ch/morgan/chat.rpy:273
translate russian morgan_chat_girl_male_dbbc19bd:
    morgan.say "Часто думаю: может, поэтому ты и не заметил, что я девочка!"

# ch/morgan/chat.rpy:276
translate russian morgan_chat_girl_male_82dd0b3e:
    mike.say "Эй, с тобой тоже было непросто, Морган! Да и сейчас не легче!"

# ch/morgan/chat.rpy:279
translate russian morgan_chat_girl_male_25ee6a7f:
    mike.say "Наверное, я просто не присматривался. Зато теперь вижу тебя прекрасно!"

# ch/morgan/chat.rpy:286
translate russian morgan_chat_girl_male_a4ef890c:
    mike.say "Стоило мне хоть ненадолго притормозить, Морган, и я бы понял, какая ты особенная!"

# ch/morgan/chat.rpy:295
translate russian morgan_chat_girl2_male_8c5f30d9:
    morgan.say "Только честно, [lssb_morgan.hero_name()]..."

# ch/morgan/chat.rpy:296
translate russian morgan_chat_girl2_male_e920398d:
    morgan.say "Ты не понял, что я девочка, потому что я была пацанкой?"

# ch/morgan/chat.rpy:297
translate russian morgan_chat_girl2_male_3aaeacc7:
    morgan.say "Или потому что вечно витал в облаках?"

# ch/morgan/chat.rpy:300
translate russian morgan_chat_girl2_male_e788c7c7:
    mike.say "Ты не просто была пацанкой — иногда и правда вела себя как мальчишка!"

# ch/morgan/chat.rpy:303
translate russian morgan_chat_girl2_male_3a47b488:
    mike.say "И то и другое понемногу. Но теперь я тебя прекрасно вижу!"

# ch/morgan/chat.rpy:309
translate russian morgan_chat_lovers_male_00eb1180:
    morgan.say "Странно, [lssb_morgan.hero_name()]: в детстве мы дружили, а повзрослев, стали любовниками."

# ch/morgan/chat.rpy:310
translate russian morgan_chat_lovers_male_72bba5e1:
    morgan.say "Тебе не кажется?"

# ch/morgan/chat.rpy:311
translate russian morgan_chat_lovers_male_825cb82e:
    morgan.say "Девочка любила мальчика, который считал её мальчиком, потом узнал, что она девочка, а потом они влюбились друг в друга?"

# ch/morgan/chat.rpy:314
translate russian morgan_chat_lovers_male_4b5361c6:
    mike.say "Слушай, если я считал тебя парнем, а теперь мы вместе, я что, гей?"

# ch/morgan/chat.rpy:315
translate russian morgan_chat_lovers_male_5091b38d:
    morgan.say "Нет. Но даже если бы был, ничего страшного."

# ch/morgan/chat.rpy:318
translate russian morgan_chat_lovers_male_5c15f7ae:
    mike.say "Я бы никогда такого не представил, Морган."

# ch/morgan/chat.rpy:319
translate russian morgan_chat_lovers_male_f5c054bf:
    mike.say "Просто рад, что так вышло."

# ch/morgan/chat.rpy:326
translate russian morgan_chat_lovers_male_0d148cfb:
    mike.say "Такое чувство, будто я попал в волшебную сказку!"

# ch/morgan/chat.rpy:335
translate russian morgan_chat_friends_lovers_male_94cb44db:
    morgan.say "Мне нравится, что сначала мы были друзьями, а уже потом любовниками, [lssb_morgan.hero_name()]."

# ch/morgan/chat.rpy:336
translate russian morgan_chat_friends_lovers_male_5d04ae3b:
    morgan.say "Мне нужен и друг, и любимый, и я хочу, чтобы ты оставался обоими."

# ch/morgan/chat.rpy:339
translate russian morgan_chat_friends_lovers_male_97f9ad9c:
    mike.say "Одно делает другое только крепче, Морган."

# ch/morgan/chat.rpy:342
translate russian morgan_chat_friends_lovers_male_f4cb5920:
    mike.say "Хочется верить, что нам было суждено снова встретиться."

# ch/morgan/chat.rpy:343
translate russian morgan_chat_friends_lovers_male_50319ea8:
    mike.say "Я именно так это и чувствую!"

# ch/morgan/chat.rpy:347
translate russian morgan_chat_friends_lovers_male_dde05019:
    mike.say "Два в одном — друзья с привилегиями!"

# ch/morgan/chat.rpy:355
translate russian morgan_good_sweet_talk_male_9a2a80a8:
    mike.say "Каким же я был тупицей, что не замечал в тебе девушку, Морган!"

# ch/morgan/chat.rpy:356
translate russian morgan_good_sweet_talk_male_9312cc79:
    mike.say "Самая горячая девушка на свете была прямо у меня под носом!"

# ch/morgan/chat.rpy:358
translate russian morgan_good_sweet_talk_male_9d4a15a4:
    morgan.say "Т... ты правда так думаешь?"

# ch/morgan/chat.rpy:359
translate russian morgan_good_sweet_talk_male_987b61cb:
    morgan.say "Ну, теперь мы вместе и можем наверстать упущенное!"

# ch/morgan/chat.rpy:361
translate russian morgan_good_sweet_talk_male_4fb50c01:
    mike.say "Напомни, Морган, у тебя в детстве были синие волосы?"

# ch/morgan/chat.rpy:362
translate russian morgan_good_sweet_talk_male_d7244837:
    mike.say "Они так классно смотрятся и так тебе идут."

# ch/morgan/chat.rpy:363
translate russian morgan_good_sweet_talk_male_bc9129e1:
    mike.say "Не могу представить тебя без них!"

# ch/morgan/chat.rpy:365
translate russian morgan_good_sweet_talk_male_cf45f034:
    morgan.say "Ой, как приятно это слышать!"

# ch/morgan/chat.rpy:366
translate russian morgan_good_sweet_talk_male_e8a71c1d:
    morgan.say "Скажу, что были, раз уж тебе так нравится!"

# ch/morgan/chat.rpy:368
translate russian morgan_good_sweet_talk_male_69a948c2:
    mike.say "Рад, что мы снова встретились, Морган."

# ch/morgan/chat.rpy:369
translate russian morgan_good_sweet_talk_male_0a8df4a2:
    mike.say "Я вспомнил, какой ты замечательный человек."

# ch/morgan/chat.rpy:371
translate russian morgan_good_sweet_talk_male_5d7152bb:
    morgan.say "С... спасибо, [lssb_morgan.hero_name()]."

# ch/morgan/chat.rpy:372
translate russian morgan_good_sweet_talk_male_71f480ae:
    morgan.say "Для меня это очень важно!"

# ch/morgan/chat.rpy:378
translate russian morgan_bad_sweet_talk_male_9fb42c9d:
    mike.say "Иногда легко понять, почему я раньше принимал тебя за парня, Морган."

# ch/morgan/chat.rpy:380
translate russian morgan_bad_sweet_talk_male_cd1118fc:
    morgan.say "Это ещё что значит?"

# ch/morgan/chat.rpy:381
translate russian morgan_bad_sweet_talk_male_8381f962:
    morgan.say "Что из меня не получается женщина?"

# ch/morgan/chat.rpy:382
translate russian morgan_bad_sweet_talk_male_53cc3cae:
    morgan.say "Хотя я и есть женщина?!"

# ch/morgan/chat.rpy:383
translate russian morgan_bad_sweet_talk_male_cc1474f7:
    mike.say "Ну... если так поставить вопрос..."

# ch/morgan/condom.rpy:4
translate russian morgan_use_condom_0584c5ee:
    "То, что я здесь командую, не отменяет осторожности."

# ch/morgan/condom.rpy:5
translate russian morgan_use_condom_75346eb0:
    "Одной рукой я крепко сжимаю её ягодицу, а другой тянусь за презервативом на тумбочке."

# ch/morgan/condom.rpy:6
translate russian morgan_use_condom_5fc3e8f5:
    "Когда я ненадолго отстраняюсь, чтобы надеть его, Морган лишь тихонько вздыхает."

# ch/morgan/condom.rpy:7
translate russian morgan_use_condom_5bcca2e2:
    "И ещё раз — когда я возвращаюсь в прежнее положение."

# ch/morgan/condom.rpy:9
translate russian morgan_use_condom_9e4e8c5e:
    "Но спешка ни к чему: не хочется плохо кончить — простите за каламбур."

# ch/morgan/condom.rpy:10
translate russian morgan_use_condom_4d957d33:
    "Морган такая милая и послушная, что вполне подождёт ещё пару секунд."

# ch/morgan/condom.rpy:11
translate russian morgan_use_condom_045977b7:
    "Поэтому я спокойно беру с тумбочки презерватив и натягиваю на член."

# ch/morgan/condom.rpy:12
translate russian morgan_use_condom_6e5f573b:
    "Пожалуй, ожидание лишь усиливает её желание узнать, что я приготовил дальше."

# ch/morgan/condom.rpy:14
translate russian morgan_use_condom_ef897172:
    "Как бы мне ни хотелось заставить Морган краснеть ещё сильнее, рисковать я не собираюсь."

# ch/morgan/condom.rpy:15
translate russian morgan_use_condom_0854d28e:
    "Я беру презерватив с тумбочки, и она одобрительно кивает."

# ch/morgan/condom.rpy:16
translate russian morgan_use_condom_c872692f:
    morgan.say "Упс, об этом ведь нельзя забывать, правда?"

# ch/morgan/condom.rpy:17
translate russian morgan_use_condom_047abdc8:
    morgan.say "Нам же не нужен случайный топот маленьких ножек!"

# ch/morgan/condom.rpy:19
translate russian morgan_use_condom_cb5d97cb:
    mike.say "Ладно, Морган, ладно."

# ch/morgan/condom.rpy:20
translate russian morgan_use_condom_68b87257:
    mike.say "Подожди, я быстренько кое о чём позабочусь!"

# ch/morgan/condom.rpy:21
translate russian morgan_use_condom_e456ff84:
    "Морган откидывается назад и вопросительно смотрит на меня, скрестив руки на груди."

# ch/morgan/condom.rpy:22
translate russian morgan_use_condom_aa90b531:
    "Я хватаю с тумбочки презерватив и начинаю неловко натягивать его на член."

# ch/morgan/condom.rpy:23
translate russian morgan_use_condom_0b51f2d8:
    morgan.say "А-а, решил перестраховаться?"

# ch/morgan/condom.rpy:24
translate russian morgan_use_condom_652eb7d4:
    morgan.say "Давай помогу!"

# ch/morgan/condom.rpy:25
translate russian morgan_use_condom_5ca4a49a:
    "Я откидываюсь и смотрю, как Морган с улыбкой раскатывает презерватив по моему члену, разглаживая его поглаживаниями."

# ch/morgan/condom.rpy:27
translate russian morgan_use_condom_9e0bf95d:
    "Я ненадолго отвлекаюсь, чтобы взять презерватив и натянуть на член."

# ch/morgan/condom.rpy:28
translate russian morgan_use_condom_66fefd76:
    "Я знаю, что тяну время, и по тихому смешку Морган ясно: она тоже знает."

# ch/morgan/condom.rpy:29
translate russian morgan_use_condom_51018ead:
    "Но едва закончив, я принимаю решение."

# ch/morgan/condom.rpy:30
translate russian morgan_use_condom_0493c9aa:
    "И ей уже давно пора узнать, что именно я решил."

# ch/morgan/condom.rpy:41
translate russian morgan_warn_condom_3a5830c9:
    morgan.say "Эй... какого хрена!"

# ch/morgan/condom.rpy:42
translate russian morgan_warn_condom_58c8ef02:
    "Я замираю: по тону и выражению лица Морган ясно, что дальше нельзя."

# ch/morgan/condom.rpy:43
translate russian morgan_warn_condom_ff1ef624:
    morgan.say "Без презерватива ты эту штуку в меня не сунешь, чувак!"

# ch/morgan/condom.rpy:45
translate russian morgan_warn_condom_6e7a83d8:
    morgan.say "Ох, [lssb_morgan.hero_name()]... плохой мальчик!"

# ch/morgan/condom.rpy:46
translate russian morgan_warn_condom_5c8d42a0:
    "Я резко останавливаюсь, услышав в голосе Морган укор."

# ch/morgan/condom.rpy:47
translate russian morgan_warn_condom_e020f115:
    morgan.say "Без защиты вход запрещён!"

# ch/morgan/condom.rpy:52
translate russian morgan_force_condom_f4c18976:
    "Она тянется к куртке, которая как раз лежит рядом."

# ch/morgan/condom.rpy:53
translate russian morgan_force_condom_df32edb6:
    "Мгновение спустя её рука возвращается с презервативом."

# ch/morgan/condom.rpy:54
translate russian morgan_force_condom_5260ab20:
    morgan.say "Не будешь ли так любезен?!"

# ch/morgan/condom.rpy:56
translate russian morgan_force_condom_6a10e7b0:
    "Она тянется к куртке на куче одежды неподалёку."

# ch/morgan/condom.rpy:57
translate russian morgan_force_condom_fb939afe:
    "И протягивает мне найденный презерватив."

# ch/morgan/condom.rpy:58
translate russian morgan_force_condom_f2d8516b:
    morgan.say "Оденься как следует — тогда заходи!"

# ch/morgan/condom.rpy:63
translate russian morgan_mad_condom_f0391dde:
    mike.say "Да ладно, Морган, обойдёмся без резинки. Расслабься."

# ch/morgan/condom.rpy:64
translate russian morgan_mad_condom_c0f32f83:
    "Жар в её глазах, ещё секунду назад пылавших, сменяется холодом."

# ch/morgan/condom.rpy:65
translate russian morgan_mad_condom_604b87e7:
    morgan.say "Ты что, блядь, глухой?"

# ch/morgan/condom.rpy:66
translate russian morgan_mad_condom_9196abcd:
    morgan.say "Без резинки секса не будет. Я не ломаюсь — это твёрдое «нет»."

# ch/morgan/condom.rpy:67
translate russian morgan_mad_condom_47c0eefc:
    "Она отталкивает меня и хватает с пола куртку. Настроение мгновенно испаряется."

# ch/morgan/condom.rpy:69
translate russian morgan_mad_condom_f8bc8054:
    mike.say "Обязательно с ним возиться? Может, хоть раз без него?"

# ch/morgan/condom.rpy:70
translate russian morgan_mad_condom_88fd4d32:
    "Игривый блеск исчезает с лица Морган, и она снова скрещивает руки на груди."

# ch/morgan/condom.rpy:71
translate russian morgan_mad_condom_d359e255:
    morgan.say "Ничего себе. А я-то считала тебя умным."

# ch/morgan/condom.rpy:72
translate russian morgan_mad_condom_8bc662ec:
    morgan.say "Я не собираюсь так рисковать, [lssb_morgan.hero_name()], каким бы красавчиком ты себя ни считал."

# ch/morgan/condom.rpy:73
translate russian morgan_mad_condom_ff21ea13:
    "Она выскальзывает из-под меня и начинает искать одежду. Настроение испорчено окончательно."

# ch/morgan/condom.rpy:77
translate russian morgan_no_condom_acf2963d:
    "Я так поглощён моментом, что думаю лишь о том, как опуститься на Морган."

# ch/morgan/condom.rpy:78
translate russian morgan_no_condom_f3c7ff37:
    "Похоже, она чувствует то же самое: жадно принимает меня, обвивая руками и ногами."

# ch/morgan/condom.rpy:79
translate russian morgan_no_condom_b34b3769:
    "Не представляю, сколько она ждала этого момента, и меньше всего хочу заставлять её ждать ещё."

# ch/morgan/date.rpy:2
translate russian morgan_date_intro_valentine_male_7f492627:
    mike.say "С Днём святого Валентина, Морган."

# ch/morgan/date.rpy:3
translate russian morgan_date_intro_valentine_male_1f3dd852:
    mike.say "Ты готова к нашему свиданию?"

# ch/morgan/date.rpy:4
translate russian morgan_date_intro_valentine_male_528ad18a:
    mike.say "Не терпится провести время с моей любимой!"

# ch/morgan/date.rpy:6
translate russian morgan_date_intro_valentine_male_d4298326:
    morgan.say "Ой, только без этих соплей, [lssb_morgan.hero_name()]!"

# ch/morgan/date.rpy:7
translate russian morgan_date_intro_valentine_male_a517fb01:
    morgan.say "Просто расслабься и получай удовольствие."

# ch/morgan/date.rpy:9
translate russian morgan_date_intro_valentine_male_224b8491:
    morgan.say "Мне тоже, [lssb_morgan.hero_name()]!"

# ch/morgan/date.rpy:10
translate russian morgan_date_intro_valentine_male_73f1485b:
    morgan.say "Я дни считала!"

# ch/morgan/date.rpy:12
translate russian morgan_date_intro_valentine_male_bc76f9a1:
    morgan.say "Ещё как, [lssb_morgan.hero_name()]!"

# ch/morgan/date.rpy:13
translate russian morgan_date_intro_valentine_male_af6ddb20:
    morgan.say "Мне тоже не терпится побыть со своим любимым!"

# ch/morgan/date.rpy:17
translate russian morgan_date_intro_halloween_male_c1fcc7dc:
    mike.say "Готова идти, Морган?"

# ch/morgan/date.rpy:18
translate russian morgan_date_intro_halloween_male_6519f8ed:
    mike.say "Сегодня Хэллоуин, должно быть весело!"

# ch/morgan/date.rpy:20
translate russian morgan_date_intro_halloween_male_65e30f55:
    morgan.say "Лишь бы не пришлось наряжаться в дурацкие костюмы!"

# ch/morgan/date.rpy:22
translate russian morgan_date_intro_halloween_male_0b31d34e:
    morgan.say "Чёрт, надо было надеть какие-нибудь прикольные костюмы!"

# ch/morgan/date.rpy:24
translate russian morgan_date_intro_halloween_male_4c12cc71:
    morgan.say "О нет, я ведь могла сегодня нарядиться во что-нибудь очень милое!"

# ch/morgan/date.rpy:25
translate russian morgan_date_intro_halloween_male_90074779:
    mike.say "Не переживай, Морган."

# ch/morgan/date.rpy:26
translate russian morgan_date_intro_halloween_male_8d45a9e7:
    mike.say "Можно повеселиться и без костюмов."

# ch/morgan/date.rpy:27
translate russian morgan_date_intro_halloween_male_73699d4f:
    mike.say "А к следующему Хэллоуину подготовимся заранее."

# ch/morgan/date.rpy:31
translate russian morgan_date_intro_christmas_male_2e8b8de4:
    mike.say "С Рождеством, Морган!"

# ch/morgan/date.rpy:32
translate russian morgan_date_intro_christmas_male_af0f5b34:
    mike.say "Надеюсь, на свидание ты пришла с праздничным настроением!"

# ch/morgan/date.rpy:34
translate russian morgan_date_intro_christmas_male_baf13872:
    morgan.say "Ха... меня больше интересуют самые приятные части."

# ch/morgan/date.rpy:35
translate russian morgan_date_intro_christmas_male_45c4e626:
    morgan.say "Например, твои горячие булочки, [lssb_morgan.hero_name()]!"

# ch/morgan/date.rpy:37
translate russian morgan_date_intro_christmas_male_7d487540:
    morgan.say "Не знаю насчёт этого, [lssb_morgan.hero_name()]."

# ch/morgan/date.rpy:38
translate russian morgan_date_intro_christmas_male_43c738ab:
    morgan.say "Мне интереснее просто побыть с тобой!"

# ch/morgan/date.rpy:40
translate russian morgan_date_intro_christmas_male_2a3d2de8:
    morgan.say "Конечно, [lssb_morgan.hero_name()]."

# ch/morgan/date.rpy:41
translate russian morgan_date_intro_christmas_male_358a4dc2:
    morgan.say "Очень люблю это время года!"

# ch/morgan/date.rpy:45
translate russian morgan_date_intro_birthday_male_0a92d1e3:
    mike.say "С днём рождения, Морган!"

# ch/morgan/date.rpy:46
translate russian morgan_date_intro_birthday_male_a9453a5f:
    mike.say "И ни о чём не волнуйся."

# ch/morgan/date.rpy:47
translate russian morgan_date_intro_birthday_male_5bc616d8:
    mike.say "На твой день рождения я придумал кое-что особенное!"

# ch/morgan/date.rpy:49
translate russian morgan_date_intro_birthday_male_bb50dff4:
    morgan.say "Да ну?"

# ch/morgan/date.rpy:50
translate russian morgan_date_intro_birthday_male_59a7b732:
    morgan.say "Надеюсь, зрелище будет стоящее!"

# ch/morgan/date.rpy:52
translate russian morgan_date_intro_birthday_male_875d5ba2:
    morgan.say "Ты правда вспомнил?"

# ch/morgan/date.rpy:53
translate russian morgan_date_intro_birthday_male_f0dbecf2:
    morgan.say "Как здорово, [lssb_morgan.hero_name()]!"

# ch/morgan/date.rpy:55
translate russian morgan_date_intro_birthday_male_7c7913b1:
    morgan.say "Ой, [lssb_morgan.hero_name()], как мило с твоей стороны!"

# ch/morgan/date.rpy:56
translate russian morgan_date_intro_birthday_male_495ba004:
    morgan.say "Как же мне повезло!"

# ch/morgan/date.rpy:60
translate russian morgan_date_intro_mc_birthday_male_e8eff22f:
    mike.say "Готова повеселиться на свидании, Морган?"

# ch/morgan/date.rpy:62
translate russian morgan_date_intro_mc_birthday_male_c1b71345:
    morgan.say "Погоди-ка, [lssb_morgan.hero_name()]."

# ch/morgan/date.rpy:63
translate russian morgan_date_intro_mc_birthday_male_5dd30c6d:
    morgan.say "В этом году тебе не отвертеться!"

# ch/morgan/date.rpy:65
translate russian morgan_date_intro_mc_birthday_male_1179a041:
    morgan.say "Ну уж нет, [lssb_morgan.hero_name()]!"

# ch/morgan/date.rpy:66
translate russian morgan_date_intro_mc_birthday_male_e779ca65:
    morgan.say "Ничего не забыл?"

# ch/morgan/date.rpy:68
translate russian morgan_date_intro_mc_birthday_male_0db437a2:
    morgan.say "Не глупи, [lssb_morgan.hero_name()]!"

# ch/morgan/date.rpy:69
translate russian morgan_date_intro_mc_birthday_male_d8399e88:
    morgan.say "Ты ведь не думал, что я забыла?"

# ch/morgan/date.rpy:70
translate russian morgan_date_intro_mc_birthday_male_f0081194:
    morgan.say "С днём рождения!"

# ch/morgan/date.rpy:71
translate russian morgan_date_intro_mc_birthday_male_f05859cb:
    mike.say "Ох... спасибо, Морган!"

# ch/morgan/date.rpy:72
translate russian morgan_date_intro_mc_birthday_male_f15ea544:
    mike.say "Мог бы и догадаться, что ты вспомнишь."

# ch/morgan/date.rpy:76
translate russian morgan_date_eat_a_burger_71e92e3b:
    "Почему-то бургер очень веселит Морган."

# ch/morgan/date.rpy:77
translate russian morgan_date_eat_a_burger_1f20a226:
    "Она с удовольствием ест, но время от времени не может удержаться от смешка."

# ch/morgan/date.rpy:78
translate russian morgan_date_eat_a_burger_66c98f36:
    "Не представляю, что её так смешит, и посвящать меня в тайну она, похоже, не собирается."

# ch/morgan/date.rpy:86
translate russian morgan_date_buy_drink_67ac40c5:
    morgan.say "О нет, [lssb_morgan.hero_name()]!"

# ch/morgan/date.rpy:87
translate russian morgan_date_buy_drink_d68edd8b:
    morgan.say "Ты о малыше-то подумай!"

# ch/morgan/date.rpy:89
translate russian morgan_date_buy_drink_80800942:
    morgan.say "Э-э, ты забыл, что я беременна?"

# ch/morgan/date.rpy:90
translate russian morgan_date_buy_drink_9155aee7:
    morgan.say "Фу... иногда ты такой безответственный!"

# ch/morgan/date.rpy:92
translate russian morgan_date_buy_drink_42676472:
    morgan.say "Какого хрена?"

# ch/morgan/date.rpy:93
translate russian morgan_date_buy_drink_ab126ca6:
    morgan.say "Ты забыл, что я беременна, придурок?!"

# ch/morgan/date.rpy:97
translate russian morgan_date_buy_drink_eba10a7b:
    "С выпивкой в руках Морган, кажется, легче расслабиться и начать получать удовольствие."

# ch/morgan/date.rpy:98
translate russian morgan_date_buy_drink_5788bb59:
    "Я не хочу сказать, что она зависит от алкоголя, понимаете?"

# ch/morgan/date.rpy:99
translate russian morgan_date_buy_drink_9084c315:
    "Просто он, похоже, помогает ей оставаться собой рядом со мной."

# ch/morgan/date.rpy:103
translate russian morgan_date_play_darts_314fdb6b:
    "Кажется, я зря так легко вызвал Морган на партию в дартс."

# ch/morgan/date.rpy:104
translate russian morgan_date_play_darts_0f742b27:
    "Перед началом она не хвастается, но вскоре выясняется: играет она чертовски хорошо."

# ch/morgan/date.rpy:105
translate russian morgan_date_play_darts_b96c481f:
    "В итоге это мне приходится изо всех сил за ней поспевать."

# ch/morgan/date.rpy:109
translate russian morgan_date_pub_play_pool_550fd4c3:
    "Морган берёт кий и уверенно направляется к бильярдному столу."

# ch/morgan/date.rpy:110
translate russian morgan_date_pub_play_pool_7967c447:
    "Не спрашивая, расставляет шары и ставит биток в полукруг."

# ch/morgan/date.rpy:111
translate russian morgan_date_pub_play_pool_9f536603:
    "Я глубоко вдыхаю, уже гадая, во что ввязался!"

# ch/morgan/date.rpy:119
translate russian morgan_date_buy_a_round_67ac40c5:
    morgan.say "О нет, [lssb_morgan.hero_name()]!"

# ch/morgan/date.rpy:120
translate russian morgan_date_buy_a_round_d68edd8b:
    morgan.say "Ты о малыше-то подумай!"

# ch/morgan/date.rpy:122
translate russian morgan_date_buy_a_round_80800942:
    morgan.say "Э-э, ты забыл, что я беременна?"

# ch/morgan/date.rpy:123
translate russian morgan_date_buy_a_round_9155aee7:
    morgan.say "Фу... иногда ты такой безответственный!"

# ch/morgan/date.rpy:125
translate russian morgan_date_buy_a_round_42676472:
    morgan.say "Какого хрена?"

# ch/morgan/date.rpy:126
translate russian morgan_date_buy_a_round_ab126ca6:
    morgan.say "Ты забыл, что я беременна, придурок?!"

# ch/morgan/date.rpy:130
translate russian morgan_date_buy_a_round_68250f6f:
    "Когда я предлагаю купить следующую порцию выпивки, Морган лишь пожимает плечами и кивает."

# ch/morgan/date.rpy:131
translate russian morgan_date_buy_a_round_125e5e34:
    "Видимо, она и так считает, что мы будем угощать друг друга по очереди."

# ch/morgan/date.rpy:132
translate russian morgan_date_buy_a_round_cac5ba76:
    "Совершенно современная девушка."

# ch/morgan/date.rpy:139
translate russian morgan_date_buy_a_round_fb20fd2c:
    "Я хочу угостить пивом весь паб."

# ch/morgan/date.rpy:140
translate russian morgan_date_buy_a_round_5308b153:
    "Но Морган, кажется, не хочет пить, поэтому я тоже воздерживаюсь."

# ch/morgan/date.rpy:146
translate russian morgan_date_play_arcade_intro_male_da8b927a:
    morgan.say "Уф..."

# ch/morgan/date.rpy:147
translate russian morgan_date_play_arcade_intro_male_5526ce29:
    morgan.say "Ты вообще серьёзно, [lssb_morgan.hero_name()]?"

# ch/morgan/date.rpy:149
translate russian morgan_date_play_arcade_intro_male_0a250529:
    morgan.say "Нам обязательно этим заниматься, [lssb_morgan.hero_name()]?"

# ch/morgan/date.rpy:150
translate russian morgan_date_play_arcade_intro_male_6fed8ddc:
    morgan.say "Серьёзно?"

# ch/morgan/date.rpy:152
translate russian morgan_date_play_arcade_intro_male_13babde8:
    morgan.say "Фу..."

# ch/morgan/date.rpy:153
translate russian morgan_date_play_arcade_intro_male_02d59987:
    morgan.say "Тут всё липкое! И воняет!"

# ch/morgan/date.rpy:154
translate russian morgan_date_play_arcade_intro_male_37a5a03f:
    "Оторвавшись от окружающих автоматов, я поворачиваюсь к Морган."

# ch/morgan/date.rpy:155
translate russian morgan_date_play_arcade_intro_male_a1ecad32:
    "Я ожидал, что поход в игровой зал вызовет у неё больше восторга."

# ch/morgan/date.rpy:156
translate russian morgan_date_play_arcade_intro_male_bc362171:
    "Мне трудно её понять: сам я обожаю это место."

# ch/morgan/date.rpy:157
translate russian morgan_date_play_arcade_intro_male_7dfae070:
    mike.say "Дай этому месту шанс, Морган."

# ch/morgan/date.rpy:158
translate russian morgan_date_play_arcade_intro_male_b26bc618:
    mike.say "Тут чуть ли не сотня разных игр."

# ch/morgan/date.rpy:159
translate russian morgan_date_play_arcade_intro_male_03038819:
    mike.say "Уверен, найдём что-нибудь по твоему вкусу!"

# ch/morgan/date.rpy:160
translate russian morgan_date_play_arcade_intro_male_b540ef58:
    "Морган выглядит не слишком убеждённой."

# ch/morgan/date.rpy:161
translate russian morgan_date_play_arcade_intro_male_5d212b54:
    "Но всё же кивает."

# ch/morgan/date.rpy:162
translate russian morgan_date_play_arcade_intro_male_ede0f9d5:
    "Принимаю это за разрешение поискать подходящую игру."

# ch/morgan/date.rpy:163
translate russian morgan_date_play_arcade_intro_male_ef1b5f46:
    "И нахожу её довольно быстро."

# ch/morgan/date.rpy:164
translate russian morgan_date_play_arcade_intro_male_05f2b8f9:
    mike.say "Как тебе эта, Морган?"

# ch/morgan/date.rpy:165
translate russian morgan_date_play_arcade_intro_male_6da53072:
    mike.say "Называется «Чудо-трио»."

# ch/morgan/date.rpy:166
translate russian morgan_date_play_arcade_intro_male_375cdcf6:
    mike.say "Причём здесь сразу три игры."

# ch/morgan/date.rpy:167
translate russian morgan_date_play_arcade_intro_male_ad4042ea:
    mike.say "Выберешь ту, которая больше понравится!"

# ch/morgan/date.rpy:169
translate russian morgan_date_play_arcade_intro_male_a1658d31:
    morgan.say "Ладно, [lssb_morgan.hero_name()], давай попробуем стрелялку."

# ch/morgan/date.rpy:171
translate russian morgan_date_play_arcade_intro_male_c6d7d700:
    morgan.say "Ладно, [lssb_morgan.hero_name()], давай попробуем платформер."

# ch/morgan/date.rpy:173
translate russian morgan_date_play_arcade_intro_male_1a67bd88:
    morgan.say "О-о, головоломка выглядит интересной!"

# ch/morgan/date.rpy:174
translate russian morgan_date_play_arcade_intro_male_3de7f2f8:
    "Я с энтузиазмом киваю и забрасываю монеты в щель."

# ch/morgan/date.rpy:178
translate russian morgan_date_play_arcade_win_male_ae45c11c:
    "Наверное, стоило предупредить Морган, что я неплохо играю в эту игру."

# ch/morgan/date.rpy:179
translate russian morgan_date_play_arcade_win_male_6b277ae2:
    "Потому что это очень быстро становится заметно."

# ch/morgan/date.rpy:180
translate russian morgan_date_play_arcade_win_male_d3dac7c7:
    "Я вырываюсь вперёд, пока она пытается освоиться."

# ch/morgan/date.rpy:182
translate russian morgan_date_play_arcade_win_male_b6640a8c:
    morgan.say "Чёрт..."

# ch/morgan/date.rpy:183
translate russian morgan_date_play_arcade_win_male_d5e8558f:
    morgan.say "Это ОЧЕНЬ сложно!"

# ch/morgan/date.rpy:185
translate russian morgan_date_play_arcade_win_male_f907a5ff:
    morgan.say "Блин, [lssb_morgan.hero_name()]..."

# ch/morgan/date.rpy:186
translate russian morgan_date_play_arcade_win_male_87212836:
    morgan.say "Как же сложно!"

# ch/morgan/date.rpy:188
translate russian morgan_date_play_arcade_win_male_56ab04f3:
    morgan.say "Ой..."

# ch/morgan/date.rpy:189
translate russian morgan_date_play_arcade_win_male_58ade918:
    morgan.say "Не думаю, что у меня получится!"

# ch/morgan/date.rpy:190
translate russian morgan_date_play_arcade_win_male_919b6230:
    mike.say "Просто делай как я, Морган."

# ch/morgan/date.rpy:191
translate russian morgan_date_play_arcade_win_male_42a06b16:
    mike.say "Это не так сложно, как кажется!"

# ch/morgan/date.rpy:192
translate russian morgan_date_play_arcade_win_male_14c7b718:
    "Мой совет, похоже, проходит мимо ушей."

# ch/morgan/date.rpy:193
translate russian morgan_date_play_arcade_win_male_1a071e76:
    "А даже если нет, пользы Морган он не приносит."

# ch/morgan/date.rpy:194
translate russian morgan_date_play_arcade_win_male_3ba143c7:
    "Так что к концу оплаченных попыток я далеко впереди."

# ch/morgan/date.rpy:195
translate russian morgan_date_play_arcade_win_male_25f59957:
    mike.say "Молодец, Морган."

# ch/morgan/date.rpy:196
translate russian morgan_date_play_arcade_win_male_a98d86d4:
    mike.say "Ты неплохо играла!"

# ch/morgan/date.rpy:198
translate russian morgan_date_play_arcade_win_male_2adab4cd:
    morgan.say "Не надо снисходительности, [lssb_morgan.hero_name()]!"

# ch/morgan/date.rpy:199
translate russian morgan_date_play_arcade_win_male_a018dbf7:
    morgan.say "Я в эту игру играю паршиво!"

# ch/morgan/date.rpy:201
translate russian morgan_date_play_arcade_win_male_8449496e:
    morgan.say "Не надо меня утешать, [lssb_morgan.hero_name()]."

# ch/morgan/date.rpy:202
translate russian morgan_date_play_arcade_win_male_a5c6d274:
    morgan.say "Я знаю, что у меня такие вещи плохо получаются!"

# ch/morgan/date.rpy:204
translate russian morgan_date_play_arcade_win_male_91b6a2ba:
    morgan.say "Ой, спасибо, [lssb_morgan.hero_name()]!"

# ch/morgan/date.rpy:205
translate russian morgan_date_play_arcade_win_male_2b3da635:
    morgan.say "Ты правда так думаешь?"

# ch/morgan/date.rpy:206
translate russian morgan_date_play_arcade_win_male_3a75341a:
    morgan.say "Но в общем..."

# ch/morgan/date.rpy:207
translate russian morgan_date_play_arcade_win_male_56395735:
    morgan.say "Мы поиграли. Теперь можно уйти?"

# ch/morgan/date.rpy:211
translate russian morgan_date_play_arcade_lose_male_bc5fbfd2:
    "Может, стоило выбрать для нас с Морган другую игру?"

# ch/morgan/date.rpy:212
translate russian morgan_date_play_arcade_lose_male_4181fbb2:
    "Потому что в эту я, честно говоря, играю неважно!"

# ch/morgan/date.rpy:213
translate russian morgan_date_play_arcade_lose_male_907a5d1c:
    "Морган вырывается вперёд почти с самого начала."

# ch/morgan/date.rpy:215
translate russian morgan_date_play_arcade_lose_male_60d85371:
    morgan.say "О да..."

# ch/morgan/date.rpy:216
translate russian morgan_date_play_arcade_lose_male_f2e30c52:
    morgan.say "Довольно весело, [lssb_morgan.hero_name()]!"

# ch/morgan/date.rpy:218
translate russian morgan_date_play_arcade_lose_male_812be26f:
    morgan.say "Ух ты..."

# ch/morgan/date.rpy:219
translate russian morgan_date_play_arcade_lose_male_acf5fc97:
    morgan.say "А ведь правда очень весело!"

# ch/morgan/date.rpy:221
translate russian morgan_date_play_arcade_lose_male_2168becf:
    morgan.say "Ого..."

# ch/morgan/date.rpy:222
translate russian morgan_date_play_arcade_lose_male_417ab942:
    morgan.say "У меня получается!"

# ch/morgan/date.rpy:223
translate russian morgan_date_play_arcade_lose_male_c695080b:
    mike.say "П... погоди, Морган..."

# ch/morgan/date.rpy:224
translate russian morgan_date_play_arcade_lose_male_3d971e54:
    mike.say "Вообще-то это была моя идея!"

# ch/morgan/date.rpy:225
translate russian morgan_date_play_arcade_lose_male_ced91e65:
    "Мои мольбы, похоже, не достигают её ушей."

# ch/morgan/date.rpy:226
translate russian morgan_date_play_arcade_lose_male_be6f8fbb:
    "Или она просто не обращает на них внимания."

# ch/morgan/date.rpy:227
translate russian morgan_date_play_arcade_lose_male_e3b40dbd:
    "Так что, когда оплаченные попытки заканчиваются, она далеко впереди."

# ch/morgan/date.rpy:228
translate russian morgan_date_play_arcade_lose_male_9b1f08a4:
    mike.say "Ого, Морган..."

# ch/morgan/date.rpy:229
translate russian morgan_date_play_arcade_lose_male_afc5522f:
    mike.say "Ты отлично сыграла!"

# ch/morgan/date.rpy:231
translate russian morgan_date_play_arcade_lose_male_c44922a3:
    morgan.say "Ещё бы, [lssb_morgan.hero_name()]!"

# ch/morgan/date.rpy:233
translate russian morgan_date_play_arcade_lose_male_7bdff0e8:
    morgan.say "Ага, сама от себя не ожидала!"

# ch/morgan/date.rpy:235
translate russian morgan_date_play_arcade_lose_male_180e8902:
    morgan.say "Ой, спасибо, [lssb_morgan.hero_name()]!"

# ch/morgan/date.rpy:236
translate russian morgan_date_play_arcade_lose_male_9b71c052:
    mike.say "Ну что, теперь хочешь пойти куда-нибудь ещё?"

# ch/morgan/date.rpy:237
translate russian morgan_date_play_arcade_lose_male_27b2861c:
    morgan.say "О нет, [lssb_morgan.hero_name()]."

# ch/morgan/date.rpy:238
translate russian morgan_date_play_arcade_lose_male_99861d0b:
    morgan.say "Хочу ещё сыграть!"

# ch/morgan/date.rpy:246
translate russian morgan_dick_reactions_24fa1d09:
    morgan.say "Ого, [lssb_morgan.hero_name()]..."

# ch/morgan/date.rpy:247
translate russian morgan_dick_reactions_99702172:
    morgan.say "У тебя там неплохо выросло!"

# ch/morgan/date.rpy:248
translate russian morgan_dick_reactions_89c9ff03:
    mike.say "Это... проблема, Морган?"

# ch/morgan/date.rpy:249
translate russian morgan_dick_reactions_bd409031:
    morgan.say "Я... я даже не знаю!"

# ch/morgan/date.rpy:250
translate russian morgan_dick_reactions_e82fb43b:
    morgan.say "Только обещай быть нежным, ладно?"

# ch/morgan/date.rpy:254
translate russian morgan_dick_reactions_d1c603fc:
    morgan.say "М-м-м..."

# ch/morgan/date.rpy:255
translate russian morgan_dick_reactions_8d4c28fb:
    morgan.say "Карманная ракета!"

# ch/morgan/date.rpy:256
translate russian morgan_dick_reactions_89c9ff03_1:
    mike.say "Это... проблема, Морган?"

# ch/morgan/date.rpy:258
translate russian morgan_dick_reactions_83076650:
    morgan.say "Ни капли!"

# ch/morgan/date.rpy:259
translate russian morgan_dick_reactions_3c4be7f6:
    morgan.say "Мне не нужен чудовищный член, чтобы кончить."

# ch/morgan/date.rpy:260
translate russian morgan_dick_reactions_26bd2097:
    morgan.say "Главное, чтобы я хотела парня, которому он принадлежит!"

# ch/morgan/date.rpy:267
translate russian morgan_halloween_invitation_75ea3a86:
    "Я с самого начала знаю, какую единственную девушку хочу позвать на вечеринку в честь Хэллоуина."

# ch/morgan/date.rpy:268
translate russian morgan_halloween_invitation_bdabe82b:
    "Морган: с ней этот вечер станет гораздо особеннее."

# ch/morgan/date.rpy:269
translate russian morgan_halloween_invitation_e58411fd:
    "Осталось только выбрать подходящий момент и пригласить её."

# ch/morgan/date.rpy:270
translate russian morgan_halloween_invitation_7b29128b:
    "Ведь это не должно быть сложно?"

# ch/morgan/date.rpy:271
translate russian morgan_halloween_invitation_3f806d8a:
    "Кто откажется от весёлой костюмированной вечеринки на Хэллоуин?"

# ch/morgan/date.rpy:272
translate russian morgan_halloween_invitation_898c1884:
    mike.say "Слушай, Морган..."

# ch/morgan/date.rpy:273
translate russian morgan_halloween_invitation_a141f622:
    mike.say "Мы с соседками устраиваем вечеринку на Хэллоуин."

# ch/morgan/date.rpy:274
translate russian morgan_halloween_invitation_de31c589:
    mike.say "Хочешь прийти?"

# ch/morgan/date.rpy:275
translate russian morgan_halloween_invitation_f38d0c55:
    mike.say "Ну... как бы со мной, в качестве пары?"

# ch/morgan/date.rpy:277
translate russian morgan_halloween_invitation_9029956c:
    "При одном упоминании вечеринки Морган приподнимает брови."

# ch/morgan/date.rpy:278
translate russian morgan_halloween_invitation_0de7445a:
    "Значит, мне удалось её заинтересовать."

# ch/morgan/date.rpy:279
translate russian morgan_halloween_invitation_333d651c:
    morgan.say "Домашняя вечеринка?"

# ch/morgan/date.rpy:281
translate russian morgan_halloween_invitation_49dacbf5:
    morgan.say "Я сто лет не была на таких на Хэллоуин!"

# ch/morgan/date.rpy:282
translate russian morgan_halloween_invitation_5008ce71:
    "Чувствую шанс увлечь Морган этой идеей."

# ch/morgan/date.rpy:283
translate russian morgan_halloween_invitation_66c97d7e:
    "И тут же удваиваю старания."

# ch/morgan/date.rpy:284
translate russian morgan_halloween_invitation_0726a571:
    mike.say "Будет здорово, Морган."

# ch/morgan/date.rpy:285
translate russian morgan_halloween_invitation_95406a6a:
    mike.say "Музыка, украшения по всему дому..."

# ch/morgan/date.rpy:286
translate russian morgan_halloween_invitation_5083cd94:
    mike.say "А, ещё нужно прийти в костюме!"

# ch/morgan/date.rpy:287
translate russian morgan_halloween_invitation_61ce8c11:
    "Морган на мгновение замолкает."

# ch/morgan/date.rpy:288
translate russian morgan_halloween_invitation_280629b8:
    "Вижу, что она обдумывает предложение."

# ch/morgan/date.rpy:289
translate russian morgan_halloween_invitation_d2159614:
    "А потом открывает рот, собираясь ответить."

# ch/morgan/date.rpy:293
translate russian morgan_halloween_invitation_c5096e53:
    morgan.say "Знаешь, звучит весело!"

# ch/morgan/date.rpy:294
translate russian morgan_halloween_invitation_f468aee6:
    "Я не могу сдержать улыбку."

# ch/morgan/date.rpy:295
translate russian morgan_halloween_invitation_a313887d:
    "Это почти то же самое, что «да»!"

# ch/morgan/date.rpy:296
translate russian morgan_halloween_invitation_ec28d95c:
    mike.say "Значит, придёшь?"

# ch/morgan/date.rpy:299
translate russian morgan_halloween_invitation_9362d834:
    "Морган кивает и утвердительно мычит."

# ch/morgan/date.rpy:300
translate russian morgan_halloween_invitation_87511b56:
    morgan.say "Конечно приду."

# ch/morgan/date.rpy:301
translate russian morgan_halloween_invitation_f51e4810:
    morgan.say "Хороший повод потусить и повеселиться!"

# ch/morgan/date.rpy:303
translate russian morgan_halloween_invitation_a421c8c7:
    morgan.say "Я за такое всегда за."

# ch/morgan/date.rpy:304
translate russian morgan_halloween_invitation_cfcf1217:
    "Я с энтузиазмом киваю."

# ch/morgan/date.rpy:305
translate russian morgan_halloween_invitation_a9ac61b1:
    "Меньше всего хочется сбивать настрой Морган."

# ch/morgan/date.rpy:306
translate russian morgan_halloween_invitation_2cc172ad:
    mike.say "Уже придумала, какой костюм наденешь?"

# ch/morgan/date.rpy:308
translate russian morgan_halloween_invitation_3aad2429:
    morgan.say "Не-а, понятия не имею!"

# ch/morgan/date.rpy:309
translate russian morgan_halloween_invitation_494a723e:
    morgan.say "Но до вечеринки что-нибудь придумаю."

# ch/morgan/date.rpy:310
translate russian morgan_halloween_invitation_82483dac:
    mike.say "Отлично, Морган."

# ch/morgan/date.rpy:311
translate russian morgan_halloween_invitation_bcfc26ba:
    mike.say "Не терпится увидеть, что ты придумаешь!"

# ch/morgan/date.rpy:313
translate russian morgan_halloween_invitation_1ff9e372:
    "Морган кивает и радостно взвизгивает."

# ch/morgan/date.rpy:314
translate russian morgan_halloween_invitation_512101f1:
    morgan.say "Ещё бы, [lssb_morgan.hero_name()]!"

# ch/morgan/date.rpy:315
translate russian morgan_halloween_invitation_d2a9f0d6:
    morgan.say "Можно нарядиться, потанцевать и повеселиться!"

# ch/morgan/date.rpy:316
translate russian morgan_halloween_invitation_8ee505ff:
    morgan.say "Должно быть безумно здорово."

# ch/morgan/date.rpy:317
translate russian morgan_halloween_invitation_cfcf1217_1:
    "Я с энтузиазмом киваю."

# ch/morgan/date.rpy:318
translate russian morgan_halloween_invitation_a9ac61b1_1:
    "Меньше всего хочется сбивать настрой Морган."

# ch/morgan/date.rpy:319
translate russian morgan_halloween_invitation_2cc172ad_1:
    mike.say "Уже придумала, какой костюм наденешь?"

# ch/morgan/date.rpy:321
translate russian morgan_halloween_invitation_5ab2ee6f:
    morgan.say "О-о..."

# ch/morgan/date.rpy:322
translate russian morgan_halloween_invitation_178918f8:
    morgan.say "Не знаю!"

# ch/morgan/date.rpy:324
translate russian morgan_halloween_invitation_494a723e_1:
    morgan.say "Но до вечеринки что-нибудь придумаю."

# ch/morgan/date.rpy:325
translate russian morgan_halloween_invitation_82483dac_1:
    mike.say "Отлично, Морган."

# ch/morgan/date.rpy:326
translate russian morgan_halloween_invitation_bcfc26ba_1:
    mike.say "Не терпится увидеть, что ты придумаешь!"

# ch/morgan/date.rpy:329
translate russian morgan_halloween_invitation_a5e82024:
    "Морган кивает и улыбается мне."

# ch/morgan/date.rpy:330
translate russian morgan_halloween_invitation_989ebf66:
    morgan.say "Да, [lssb_morgan.hero_name()], приду."

# ch/morgan/date.rpy:331
translate russian morgan_halloween_invitation_a7559a3a:
    morgan.say "Как я и сказала, сто лет не была на хэллоуинской вечеринке."

# ch/morgan/date.rpy:332
translate russian morgan_halloween_invitation_bd27c53c:
    morgan.say "Будто снова станем детьми!"

# ch/morgan/date.rpy:333
translate russian morgan_halloween_invitation_cfcf1217_2:
    "Я с энтузиазмом киваю."

# ch/morgan/date.rpy:334
translate russian morgan_halloween_invitation_a9ac61b1_2:
    "Меньше всего хочется сбивать настрой Морган."

# ch/morgan/date.rpy:335
translate russian morgan_halloween_invitation_2cc172ad_2:
    mike.say "Уже придумала, какой костюм наденешь?"

# ch/morgan/date.rpy:336
translate russian morgan_halloween_invitation_df690303:
    morgan.say "Нет, ты ведь только что меня пригласил! Помнишь?!"

# ch/morgan/date.rpy:337
translate russian morgan_halloween_invitation_494a723e_2:
    morgan.say "Но до вечеринки что-нибудь придумаю."

# ch/morgan/date.rpy:338
translate russian morgan_halloween_invitation_82483dac_2:
    mike.say "Отлично, Морган."

# ch/morgan/date.rpy:339
translate russian morgan_halloween_invitation_bcfc26ba_2:
    mike.say "Не терпится увидеть, что ты придумаешь!"

# ch/morgan/date.rpy:342
translate russian morgan_halloween_invitation_355d4e2e:
    morgan.say "Не-а, я точно пас."

# ch/morgan/date.rpy:343
translate russian morgan_halloween_invitation_8101fc93:
    "Я недоумённо и удивлённо моргаю."

# ch/morgan/date.rpy:344
translate russian morgan_halloween_invitation_b71cc651:
    "Морган правда отказалась?"

# ch/morgan/date.rpy:345
translate russian morgan_halloween_invitation_328cac3e:
    mike.say "Н... но почему, Морган?"

# ch/morgan/date.rpy:347
translate russian morgan_halloween_invitation_cc682c69:
    "Морган пожимает плечами и равнодушно мычит."

# ch/morgan/date.rpy:348
translate russian morgan_halloween_invitation_be111c06:
    morgan.say "Не знаю, [lssb_morgan.hero_name()]."

# ch/morgan/date.rpy:350
translate russian morgan_halloween_invitation_9d7a5cb1:
    morgan.say "Просто звучит отстойно, вот и всё."

# ch/morgan/date.rpy:351
translate russian morgan_halloween_invitation_d507c569:
    morgan.say "Есть куча вещей, которыми я лучше бы занялась."

# ch/morgan/date.rpy:352
translate russian morgan_halloween_invitation_d2e5715c:
    "Я медленно киваю, стараясь изобразить понимание."

# ch/morgan/date.rpy:353
translate russian morgan_halloween_invitation_0e9182c7:
    "Морган так небрежно отмахнулась от моей идеи."

# ch/morgan/date.rpy:354
translate russian morgan_halloween_invitation_9ed76ba6:
    "Боюсь, если покажу, насколько расстроен..."

# ch/morgan/date.rpy:355
translate russian morgan_halloween_invitation_36c713a4:
    "Она так же отмахнётся и от моих чувств!"

# ch/morgan/date.rpy:356
translate russian morgan_halloween_invitation_46b007b6:
    mike.say "Ладно, Морган."

# ch/morgan/date.rpy:357
translate russian morgan_halloween_invitation_d460b5f1:
    mike.say "Раз ты так считаешь..."

# ch/morgan/date.rpy:358
translate russian morgan_halloween_invitation_87de473c:
    morgan.say "Считаю! Именно так и считаю!"

# ch/morgan/date.rpy:360
translate russian morgan_halloween_invitation_8fcf1cd4:
    "Морган пожимает плечами и протяжно вздыхает."

# ch/morgan/date.rpy:361
translate russian morgan_halloween_invitation_68569b00:
    morgan.say "Ох, [lssb_morgan.hero_name()]..."

# ch/morgan/date.rpy:363
translate russian morgan_halloween_invitation_316d5ea7:
    morgan.say "Это же такая СКУКОТА!"

# ch/morgan/date.rpy:364
translate russian morgan_halloween_invitation_595b8206:
    morgan.say "На Хэллоуин мне хочется веселиться."

# ch/morgan/date.rpy:365
translate russian morgan_halloween_invitation_f0f54747:
    morgan.say "А не засыпать!"

# ch/morgan/date.rpy:366
translate russian morgan_halloween_invitation_d2e5715c_1:
    "Я медленно киваю, стараясь изобразить понимание."

# ch/morgan/date.rpy:367
translate russian morgan_halloween_invitation_7acede15:
    "Морган так решительно отвергла эту идею."

# ch/morgan/date.rpy:368
translate russian morgan_halloween_invitation_e7b24704:
    "И сколько при этом было драматизма!"

# ch/morgan/date.rpy:369
translate russian morgan_halloween_invitation_c66a9bd1:
    "Мне совсем не хочется продолжать в том же духе."

# ch/morgan/date.rpy:370
translate russian morgan_halloween_invitation_46b007b6_1:
    mike.say "Ладно, Морган."

# ch/morgan/date.rpy:371
translate russian morgan_halloween_invitation_d460b5f1_1:
    mike.say "Раз ты так считаешь..."

# ch/morgan/date.rpy:372
translate russian morgan_halloween_invitation_c038984e:
    morgan.say "Да!"

# ch/morgan/date.rpy:373
translate russian morgan_halloween_invitation_20dcc856:
    morgan.say "А теперь давай о чём-нибудь другом..."

# ch/morgan/date.rpy:375
translate russian morgan_halloween_invitation_ce1dfe56:
    "Морган пожимает плечами и вздыхает."

# ch/morgan/date.rpy:376
translate russian morgan_halloween_invitation_403c77ca:
    morgan.say "Ничего личного, [lssb_morgan.hero_name()]."

# ch/morgan/date.rpy:377
translate russian morgan_halloween_invitation_890f97b0:
    morgan.say "Просто, по-моему, я из этого выросла."

# ch/morgan/date.rpy:378
translate russian morgan_halloween_invitation_4841526d:
    morgan.say "Это занятие для нас в детстве."

# ch/morgan/date.rpy:379
translate russian morgan_halloween_invitation_0c86d410:
    "Я медленно киваю, показывая, что понимаю."

# ch/morgan/date.rpy:380
translate russian morgan_halloween_invitation_19fbcd0d:
    "Морган привела вполне разумную причину своего отказа."

# ch/morgan/date.rpy:381
translate russian morgan_halloween_invitation_8a9c357c:
    "Стоит ответить ей тем же уважением."

# ch/morgan/date.rpy:382
translate russian morgan_halloween_invitation_46b007b6_2:
    mike.say "Ладно, Морган."

# ch/morgan/date.rpy:383
translate russian morgan_halloween_invitation_d460b5f1_2:
    mike.say "Раз ты так считаешь..."

# ch/morgan/date.rpy:385
translate russian morgan_halloween_invitation_60200d7a:
    morgan.say "Спасибо за понимание, [lssb_morgan.hero_name()]."

# ch/morgan/date.rpy:386
translate russian morgan_halloween_invitation_1867282b:
    morgan.say "Для меня очень важно знать, что ты понимаешь!"

# ch/morgan/date.rpy:391
translate russian morgan_halloween_arrival_6835066b:
    "Открываю дверь, всё ещё витая мыслями где-то далеко."

# ch/morgan/date.rpy:392
translate russian morgan_halloween_arrival_d5a1163d:
    "Все мысли заняты хлопотами по подготовке вечеринки."

# ch/morgan/date.rpy:393
translate russian morgan_halloween_arrival_0625054d:
    "Но вид пушистого коричневого хвоста мигом возвращает меня к реальности."

# ch/morgan/date.rpy:394
translate russian morgan_halloween_arrival_791304fb:
    "Хвост принадлежит такой же пушистой фигуре, стоящей ко мне спиной."

# ch/morgan/date.rpy:395
translate russian morgan_halloween_arrival_c766e9f8:
    mike.say "Морган?"

# ch/morgan/date.rpy:396
translate russian morgan_halloween_arrival_a9cf13f0:
    mike.say "Это ты?"

# ch/morgan/date.rpy:397
translate russian morgan_halloween_arrival_0dba652b:
    "От звука моего голоса фигура слегка вздрагивает."

# ch/morgan/date.rpy:399
translate russian morgan_halloween_arrival_4ff02502:
    "Потом поворачивается, подтверждая мою догадку."

# ch/morgan/date.rpy:400
translate russian morgan_halloween_arrival_d5ad7c9a:
    "На Морган комбинезон из коричневого меха."

# ch/morgan/date.rpy:401
translate russian morgan_halloween_arrival_bd58cfe0:
    "По ушкам на капюшоне ясно: она нарядилась медведем."

# ch/morgan/date.rpy:402
translate russian morgan_halloween_arrival_edf33c19:
    morgan.say "Привет, [lssb_morgan.hero_name()]."

# ch/morgan/date.rpy:403
translate russian morgan_halloween_arrival_7df6a333:
    morgan.say "Как тебе мой костюм?"

# ch/morgan/date.rpy:405
translate russian morgan_halloween_arrival_67c3ec93:
    mike.say "Ты плюшевый мишка?!"

# ch/morgan/date.rpy:407
translate russian morgan_halloween_arrival_1d5d8759:
    "Морган ощетинивается при одном этом словосочетании."

# ch/morgan/date.rpy:409
translate russian morgan_halloween_arrival_6843793c:
    "Демонстративно скрещивает руки на груди."

# ch/morgan/date.rpy:410
translate russian morgan_halloween_arrival_8f8acd24:
    morgan.say "Кто сказал, что я плюшевый мишка?"

# ch/morgan/date.rpy:411
translate russian morgan_halloween_arrival_9476ace0:
    morgan.say "Почему все так говорят?!"

# ch/morgan/date.rpy:412
translate russian morgan_halloween_arrival_13404fcc:
    morgan.say "Я просто медведь, чёрт возьми!"

# ch/morgan/date.rpy:415
translate russian morgan_halloween_arrival_ddcfa5a4:
    morgan.say "Я плюшевый мишка!"

# ch/morgan/date.rpy:416
translate russian morgan_halloween_arrival_f43ff1b9:
    morgan.say "И я пришла обниматься!"

# ch/morgan/date.rpy:419
translate russian morgan_halloween_arrival_d332a946:
    "Я поднимаю руки в знак капитуляции."

# ch/morgan/date.rpy:420
translate russian morgan_halloween_arrival_877e0319:
    "В такие моменты лучше просто подыграть!"

# ch/morgan/date.rpy:421
translate russian morgan_halloween_arrival_cb5d97cb:
    mike.say "Ладно, Морган, ладно."

# ch/morgan/date.rpy:422
translate russian morgan_halloween_arrival_cbeacd8d:
    mike.say "Ты большой грозный медведь."

# ch/morgan/date.rpy:423
translate russian morgan_halloween_arrival_1cf66ed8:
    mike.say "И я тебя ужасно боюсь!"

# ch/morgan/date.rpy:424
translate russian morgan_halloween_arrival_b9c7ceb1:
    "На секунду кажется, что Морган снова возмутится."

# ch/morgan/date.rpy:426
translate russian morgan_halloween_arrival_15a22939:
    "Но затем раздражение исчезает с её лица."

# ch/morgan/date.rpy:428
translate russian morgan_halloween_arrival_eea26132:
    "Она смеётся и качает головой."

# ch/morgan/date.rpy:429
translate russian morgan_halloween_arrival_7d2c1de6:
    morgan.say "Наверное, сама напросилась, раз так нарядилась."

# ch/morgan/date.rpy:431
translate russian morgan_halloween_arrival_bd763fbe:
    morgan.say "В следующий раз надо будет сильнее постараться."

# ch/morgan/date.rpy:432
translate russian morgan_halloween_arrival_4f496c4b:
    mike.say "Ну не знаю, Морган."

# ch/morgan/date.rpy:433
translate russian morgan_halloween_arrival_aade79ef:
    mike.say "Быть медведем тебе идёт."

# ch/morgan/date.rpy:434
translate russian morgan_halloween_arrival_fc1c7525:
    mike.say "А с пушистым хвостиком ты очень милая!"

# ch/morgan/date.rpy:437
translate russian morgan_halloween_arrival_0a275923:
    "В награду за комплимент Морган норовит стукнуть меня по руке."

# ch/morgan/date.rpy:438
translate russian morgan_halloween_arrival_3a65ac1c:
    "Но снова смеётся и протискивается в дом."

# ch/morgan/date.rpy:440
translate russian morgan_halloween_arrival_c6a9f59c:
    "Я подпираю подбородок ладонью."

# ch/morgan/date.rpy:441
translate russian morgan_halloween_arrival_6f964e74:
    "И отступаю, чтобы рассмотреть Морган получше."

# ch/morgan/date.rpy:442
translate russian morgan_halloween_arrival_e1d914e5:
    mike.say "Хм..."

# ch/morgan/date.rpy:443
translate russian morgan_halloween_arrival_2143bbf6:
    mike.say "Ты маленькая, пушистая и невероятно очаровательная."

# ch/morgan/date.rpy:444
translate russian morgan_halloween_arrival_df055890:
    mike.say "Всё указывает на то, что ты милый плюшевый мишка!"

# ch/morgan/date.rpy:445
translate russian morgan_halloween_arrival_159a5657:
    "Морган уже буквально трясётся от злости."

# ch/morgan/date.rpy:446
translate russian morgan_halloween_arrival_85ef154d:
    "Она упирает руки в бока и встаёт прямо передо мной."

# ch/morgan/date.rpy:450
translate russian morgan_halloween_arrival_e8f3a909:
    morgan.say "Я НЕ ПЛЮШЕВЫЙ МИШКА!!!"

# ch/morgan/date.rpy:451
translate russian morgan_halloween_arrival_727fcd9c:
    "Больше сдерживаться невозможно."

# ch/morgan/date.rpy:452
translate russian morgan_halloween_arrival_9afdbfcf:
    "И мгновение спустя я заливаюсь смехом."

# ch/morgan/date.rpy:453
translate russian morgan_halloween_arrival_501108cd:
    "На секунду кажется, что Морган сейчас взорвётся."

# ch/morgan/date.rpy:455
translate russian morgan_halloween_arrival_15a22939_1:
    "Но затем раздражение исчезает с её лица."

# ch/morgan/date.rpy:457
translate russian morgan_halloween_arrival_eea26132_1:
    "Она смеётся и качает головой."

# ch/morgan/date.rpy:458
translate russian morgan_halloween_arrival_7d2c1de6_1:
    morgan.say "Наверное, сама напросилась, раз так нарядилась."

# ch/morgan/date.rpy:459
translate russian morgan_halloween_arrival_bd763fbe_1:
    morgan.say "В следующий раз надо будет сильнее постараться."

# ch/morgan/date.rpy:460
translate russian morgan_halloween_arrival_4f496c4b_1:
    mike.say "Ну не знаю, Морган."

# ch/morgan/date.rpy:461
translate russian morgan_halloween_arrival_aade79ef_1:
    mike.say "Быть медведем тебе идёт."

# ch/morgan/date.rpy:462
translate russian morgan_halloween_arrival_fc1c7525_1:
    mike.say "А с пушистым хвостиком ты очень милая!"

# ch/morgan/date.rpy:463
translate russian morgan_halloween_arrival_0a275923_1:
    "В награду за комплимент Морган норовит стукнуть меня по руке."

# ch/morgan/date.rpy:464
translate russian morgan_halloween_arrival_3a65ac1c_1:
    "Но снова смеётся и протискивается в дом."

# ch/morgan/date.rpy:466
translate russian morgan_halloween_arrival_dff21fb7:
    "При виде Морган в этом костюме я невольно улыбаюсь."

# ch/morgan/date.rpy:467
translate russian morgan_halloween_arrival_47bf75e7:
    "Она такая милая и очаровательная, да ещё и сексуальная!"

# ch/morgan/date.rpy:468
translate russian morgan_halloween_arrival_b0e6403f:
    "А как краснеет, пока я её разглядываю..."

# ch/morgan/date.rpy:469
translate russian morgan_halloween_arrival_e64b4690:
    "Теперь все мои мысли только о ней!"

# ch/morgan/date.rpy:470
translate russian morgan_halloween_arrival_93b3b211:
    mike.say "Ты потрясающе выглядишь, Морган."

# ch/morgan/date.rpy:471
translate russian morgan_halloween_arrival_71bda7d6:
    mike.say "Самый милый мишка из всех, кого я видел!"

# ch/morgan/date.rpy:475
translate russian morgan_halloween_arrival_83845e6d:
    "Лицо Морган озаряется улыбкой."

# ch/morgan/date.rpy:476
translate russian morgan_halloween_arrival_952a5e4c:
    "Она сцепляет ладони под подбородком."

# ch/morgan/date.rpy:477
translate russian morgan_halloween_arrival_df006755:
    "На миг мне кажется, что она сейчас лопнет от радости."

# ch/morgan/date.rpy:479
translate russian morgan_halloween_arrival_52203498:
    morgan.say "Т... ты правда так думаешь?"

# ch/morgan/date.rpy:481
translate russian morgan_halloween_arrival_64d880ed:
    morgan.say "Ой, как же ты меня порадовал!"

# ch/morgan/date.rpy:482
translate russian morgan_halloween_arrival_4f14f6ea:
    morgan.say "Хочу быть твоим плюшевым мишкой, [lssb_morgan.hero_name()]."

# ch/morgan/date.rpy:483
translate russian morgan_halloween_arrival_f14f1cd8:
    morgan.say "Можешь обнимать меня всю ночь!"

# ch/morgan/date.rpy:484
translate russian morgan_halloween_arrival_64783f10:
    "Я улыбаюсь и провожаю Морган в дом."

# ch/morgan/date.rpy:485
translate russian morgan_halloween_arrival_cb5239a8:
    "Всё это время стараясь скрыть, насколько сильно у меня сейчас стоит!"

# ch/morgan/date.rpy:490
translate russian morgan_halloween_arrival_d2fb3390:
    "Морган морщит нос и на секунду отводит взгляд."

# ch/morgan/date.rpy:491
translate russian morgan_halloween_arrival_94720649:
    "Изо всех сил делает вид, что ей не нравится такое внимание."

# ch/morgan/date.rpy:492
translate russian morgan_halloween_arrival_f553bc03:
    "Но я знаю её слишком хорошо, чтобы поверить."

# ch/morgan/date.rpy:493
translate russian morgan_halloween_arrival_31c5c9cc:
    "В глубине души она любит комплименты."

# ch/morgan/date.rpy:494
translate russian morgan_halloween_arrival_7a814e36:
    morgan.say "Ой, замолчи!"

# ch/morgan/date.rpy:495
translate russian morgan_halloween_arrival_500b65ce:
    morgan.say "Ничего особенного."

# ch/morgan/date.rpy:496
translate russian morgan_halloween_arrival_2f6b2c36:
    morgan.say "Просто накинула первое, что попалось, в последний момент."

# ch/morgan/date.rpy:497
translate russian morgan_halloween_arrival_a80a1d00:
    mike.say "Как скажешь, Морган."

# ch/morgan/date.rpy:498
translate russian morgan_halloween_arrival_eafca87d:
    mike.say "Главное, чтобы сегодня ты была моим плюшевым мишкой!"

# ch/morgan/date.rpy:500
translate russian morgan_halloween_arrival_a5b1b059:
    "Щёки Морган вспыхивают."

# ch/morgan/date.rpy:501
translate russian morgan_halloween_arrival_f9d0236b:
    "Но она всё равно прижимается ко мне."

# ch/morgan/date.rpy:503
translate russian morgan_halloween_arrival_f1d8a63c:
    mike.say "Эм..."

# ch/morgan/date.rpy:504
translate russian morgan_halloween_arrival_4f496c4b_2:
    mike.say "Ну не знаю, Морган."

# ch/morgan/date.rpy:506
translate russian morgan_halloween_arrival_c9180e49:
    "Морган сдвигает брови."

# ch/morgan/date.rpy:507
translate russian morgan_halloween_arrival_dce541c8:
    "И хмуро склоняет голову набок."

# ch/morgan/date.rpy:508
translate russian morgan_halloween_arrival_cd1118fc:
    morgan.say "Это ещё что значит?"

# ch/morgan/date.rpy:509
translate russian morgan_halloween_arrival_4c72744e:
    "Я пожимаю плечами и качаю головой."

# ch/morgan/date.rpy:510
translate russian morgan_halloween_arrival_75fc6fa1:
    mike.say "Просто не представляю тебя плюшевым мишкой."

# ch/morgan/date.rpy:511
translate russian morgan_halloween_arrival_e444cb48:
    mike.say "Мило, конечно, и всё такое."

# ch/morgan/date.rpy:513
translate russian morgan_halloween_arrival_b5ad3107:
    mike.say "Но мягкое и пушистое — не в моём вкусе!"

# ch/morgan/date.rpy:515
translate russian morgan_halloween_arrival_a07821d4:
    mike.say "Но я никогда не считал тебя мягкой и пушистой!"

# ch/morgan/date.rpy:517
translate russian morgan_halloween_arrival_07ba218b:
    "Морган упирает руки в бока."

# ch/morgan/date.rpy:518
translate russian morgan_halloween_arrival_dcafb6c5:
    "И раздражённо фыркает."

# ch/morgan/date.rpy:520
translate russian morgan_halloween_arrival_7c4755d5:
    morgan.say "Просто замечательно, [lssb_morgan.hero_name()]!"

# ch/morgan/date.rpy:521
translate russian morgan_halloween_arrival_a094a716:
    morgan.say "Я так старалась нарядиться для тебя."

# ch/morgan/date.rpy:522
translate russian morgan_halloween_arrival_62d4180d:
    morgan.say "А ты даже притвориться не можешь, что тебе нравится!"

# ch/morgan/date.rpy:525
translate russian morgan_halloween_arrival_484e2c56:
    morgan.say "Кто сказал, что я вообще плюшевый мишка, а?"

# ch/morgan/date.rpy:526
translate russian morgan_halloween_arrival_a95755f8:
    morgan.say "Может, я чёртов гризли!"

# ch/morgan/date.rpy:527
translate russian morgan_halloween_arrival_fe44edd2:
    "От этой демонстрации непокорности Морган я невольно усмехаюсь."

# ch/morgan/date.rpy:528
translate russian morgan_halloween_arrival_bd394d4b:
    "Что, конечно, ничуть не улучшает её настроение."

# ch/morgan/date.rpy:530
translate russian morgan_halloween_arrival_fb431744:
    mike.say "Ладно, ладно, прости, Морган."

# ch/morgan/date.rpy:531
translate russian morgan_halloween_arrival_fb546def:
    mike.say "Заходи. Кто знает..."

# ch/morgan/date.rpy:532
translate russian morgan_halloween_arrival_c7ff0d87:
    mike.say "Может, я ещё распробую."

# ch/morgan/date.rpy:534
translate russian morgan_halloween_arrival_606abe60:
    mike.say "Ладно, ладно, понял!"

# ch/morgan/date.rpy:535
translate russian morgan_halloween_arrival_a8e67c80:
    mike.say "Тогда тебе придётся это доказать."

# ch/morgan/date.rpy:536
translate russian morgan_halloween_arrival_b6a81bc1:
    mike.say "Покажи, какой ты на самом деле гризли!"

# ch/morgan/date.rpy:545
translate russian morgan_halloween_party_a907020f:
    scottie.say "Ух ты, плюшевый мишка!"

# ch/morgan/date.rpy:546
translate russian morgan_halloween_party_05f63844:
    scottie.say "И какой хорошенький!"

# ch/morgan/date.rpy:547
translate russian morgan_halloween_party_ab126b17:
    scottie.say "Как насчёт обнимашек со мной, детка?"

# ch/morgan/date.rpy:548
translate russian morgan_halloween_party_da759435:
    "Едва услышав голос Скотти, я понимаю, что происходит."

# ch/morgan/date.rpy:549
translate russian morgan_halloween_party_c4560d7a:
    "Судя по его словам, он может подкатывать только к Морган!"

# ch/morgan/date.rpy:553
translate russian morgan_halloween_party_71620941:
    "Оборачиваюсь — и убеждаюсь в своей правоте."

# ch/morgan/date.rpy:554
translate russian morgan_halloween_party_bc2dace9:
    "Он навис над ней и чуть ли не пускает слюни."

# ch/morgan/date.rpy:557
translate russian morgan_halloween_party_d432069b:
    morgan.say "Эй!"

# ch/morgan/date.rpy:558
translate russian morgan_halloween_party_675929bd:
    morgan.say "Это кого ты назвал хорошенькой?!"

# ch/morgan/date.rpy:561
translate russian morgan_halloween_party_9bd5b7cc:
    morgan.say "О нет!"

# ch/morgan/date.rpy:562
translate russian morgan_halloween_party_5db2c737:
    morgan.say "Я не такой мишка!"

# ch/morgan/date.rpy:565
translate russian morgan_halloween_party_da8b927a:
    morgan.say "Фу..."

# ch/morgan/date.rpy:566
translate russian morgan_halloween_party_dc791fa6:
    morgan.say "А если я откажусь?"

# ch/morgan/date.rpy:567
translate russian morgan_halloween_party_f3ab6795:
    "Похоже, пора вмешаться."

# ch/morgan/date.rpy:568
translate russian morgan_halloween_party_278d9b36:
    "Пока всё не вышло из-под контроля!"

# ch/morgan/date.rpy:571
translate russian morgan_halloween_party_0a5ced89:
    mike.say "Эй, Скотти."

# ch/morgan/date.rpy:572
translate russian morgan_halloween_party_eb1b5b35:
    mike.say "Обнимать медведей без их согласия нехорошо!"

# ch/morgan/date.rpy:574
translate russian morgan_halloween_party_47b70c91:
    "Скотти удивляется, увидев меня."

# ch/morgan/date.rpy:575
translate russian morgan_halloween_party_f5bd6696:
    "И пытается оправдаться."

# ch/morgan/date.rpy:576
translate russian morgan_halloween_party_48023723:
    scottie.say "Я не..."

# ch/morgan/date.rpy:577
translate russian morgan_halloween_party_5d739c56:
    scottie.say "Я вовсе не..."

# ch/morgan/date.rpy:578
translate russian morgan_halloween_party_0ab362b1:
    scottie.say "Я бы никогда..."

# ch/morgan/date.rpy:582
translate russian morgan_halloween_party_cf88c371:
    "Он удирает, всё ещё нервно бормоча."

# ch/morgan/date.rpy:583
translate russian morgan_halloween_party_7656334d:
    "И оставляет меня наедине с Морган."

# ch/morgan/date.rpy:586
translate russian morgan_halloween_party_614dd3de:
    morgan.say "Я бы и сама с ним справилась, между прочим!"

# ch/morgan/date.rpy:589
translate russian morgan_halloween_party_ec6c49a2:
    morgan.say "Но спасибо за помощь."

# ch/morgan/date.rpy:590
translate russian morgan_halloween_party_a3fb11f9:
    morgan.say "И за то, что не назвал меня плюшевым мишкой!"

# ch/morgan/date.rpy:595
translate russian morgan_halloween_party_18bb0931:
    morgan.say "Ох, спасибо, [lssb_morgan.hero_name()]!"

# ch/morgan/date.rpy:596
translate russian morgan_halloween_party_b4ba62ef:
    morgan.say "Совсем не хотелось, чтобы этот тип меня обнимал!"

# ch/morgan/date.rpy:598
translate russian morgan_halloween_party_a91addc6:
    morgan.say "А вот тебе можно обнимать сколько захочешь..."

# ch/morgan/date.rpy:602
translate russian morgan_halloween_party_aaf3d4a9:
    morgan.say "Я уже собиралась послать его подальше."

# ch/morgan/date.rpy:603
translate russian morgan_halloween_party_cf3dbb5d:
    morgan.say "Но всё равно спасибо, что выручил."

# ch/morgan/date.rpy:605
translate russian morgan_halloween_party_c10ba077:
    mike.say "Эй, Морган."

# ch/morgan/date.rpy:606
translate russian morgan_halloween_party_68b62537:
    mike.say "Расслабься уже!"

# ch/morgan/date.rpy:607
translate russian morgan_halloween_party_dff43ca9:
    mike.say "Не стоит винить парня за такую реакцию."

# ch/morgan/date.rpy:610
translate russian morgan_halloween_party_47b70c91_1:
    "Скотти удивляется, увидев меня."

# ch/morgan/date.rpy:611
translate russian morgan_halloween_party_66850f80:
    "Но затем на его лице появляется облегчение."

# ch/morgan/date.rpy:612
translate russian morgan_halloween_party_503a2790:
    "А вот Морган совсем не в восторге."

# ch/morgan/date.rpy:615
translate russian morgan_halloween_party_3f0699e3:
    morgan.say "Не указывай мне, что делать!"

# ch/morgan/date.rpy:616
translate russian morgan_halloween_party_eaa77685:
    morgan.say "И подкаты этого придурка мне тоже не нужны!"

# ch/morgan/date.rpy:620
translate russian morgan_halloween_party_d9b0e56c:
    morgan.say "Это совсем не нормально, [lssb_morgan.hero_name()]."

# ch/morgan/date.rpy:621
translate russian morgan_halloween_party_3fe4a16a:
    morgan.say "Мне было страшно без тебя, некому было меня спасти!"

# ch/morgan/date.rpy:624
translate russian morgan_halloween_party_a7404ac2:
    morgan.say "Серьёзно, [lssb_morgan.hero_name()]..."

# ch/morgan/date.rpy:625
translate russian morgan_halloween_party_be21e5a6:
    morgan.say "Мне не нравится, когда ко мне так пристают!"

# ch/morgan/date.rpy:626
translate russian morgan_halloween_party_2d535d89:
    "Я качаю головой и закатываю глаза, нисколько ей не сочувствуя."

# ch/morgan/date.rpy:630
translate russian morgan_halloween_party_7b8a1317:
    "Скотти пользуется случаем улизнуть и оставляет меня разбираться с Морган."

# ch/morgan/date.rpy:631
translate russian morgan_halloween_party_3700097b:
    "По-моему, моё решение проблемы её совсем не впечатлило!"

# ch/morgan/date.rpy:641
translate russian morgan_halloween_dance_4f637831:
    morgan.say "Э-э..."

# ch/morgan/date.rpy:642
translate russian morgan_halloween_dance_e1183238:
    morgan.say "Кажется, все уже танцуют!"

# ch/morgan/date.rpy:643
translate russian morgan_halloween_dance_31ea1b3a:
    morgan.say "Может, и нам стоит?"

# ch/morgan/date.rpy:644
translate russian morgan_halloween_dance_f66a5930:
    "Обычно я бы с радостью отправился танцевать с Морган."

# ch/morgan/date.rpy:645
translate russian morgan_halloween_dance_c7c38de4:
    "Но в её голосе есть что-то странное."

# ch/morgan/date.rpy:646
translate russian morgan_halloween_dance_f905e957:
    "Словно она заставляет себя задать этот вопрос."

# ch/morgan/date.rpy:647
translate russian morgan_halloween_dance_ed2acde5:
    "Не понимаю, хочет ли она, чтобы я уговорил её потанцевать."

# ch/morgan/date.rpy:648
translate russian morgan_halloween_dance_26c72441:
    "Или, наоборот, избавил от этого, сказав, что не в настроении."

# ch/morgan/date.rpy:649
translate russian morgan_halloween_dance_40aabafa:
    "Но она смотрит на меня, ожидая ответа."

# ch/morgan/date.rpy:650
translate russian morgan_halloween_dance_2169ea3f:
    "Так что нужно выбрать одно из двух..."

# ch/morgan/date.rpy:653
translate russian morgan_halloween_dance_e001e0b4:
    mike.say "Да, Морган, стоит."

# ch/morgan/date.rpy:654
translate russian morgan_halloween_dance_b3dc4ddd:
    mike.say "Давай присоединимся!"

# ch/morgan/date.rpy:655
translate russian morgan_halloween_dance_2a92dfd1:
    "Не дав Морган возразить, я беру её за руку."

# ch/morgan/date.rpy:659
translate russian morgan_halloween_dance_bd7fc79b:
    "И через мгновение мы уже вместе на танцполе."

# ch/morgan/date.rpy:661
translate russian morgan_halloween_dance_b001e366:
    "Едва начав танцевать, Морган застывает."

# ch/morgan/date.rpy:663
translate russian morgan_halloween_dance_44bc8bb9:
    "Почти не двигается, словно приросла к полу!"

# ch/morgan/date.rpy:664
translate russian morgan_halloween_dance_5fa9e857:
    "И по её лицу видно, что ей это не нравится."

# ch/morgan/date.rpy:665
translate russian morgan_halloween_dance_462be5a5:
    "Но отступать уже поздно."

# ch/morgan/date.rpy:666
translate russian morgan_halloween_dance_cfe59aec:
    "Вышли танцевать — придётся потерпеть."

# ch/morgan/date.rpy:667
translate russian morgan_halloween_dance_1468ab21:
    "Дальше следуют одни из самых мучительных минут в моей жизни."

# ch/morgan/date.rpy:668
translate russian morgan_halloween_dance_e3775761:
    "Я продолжаю улыбаться, понемногу умирая внутри."

# ch/morgan/date.rpy:669
translate russian morgan_halloween_dance_3e10e037:
    "Даже когда всё заканчивается, легче не становится."

# ch/morgan/date.rpy:670
translate russian morgan_halloween_dance_ca0051db:
    "Я почти физически чувствую, как Морган на меня злится."

# ch/morgan/date.rpy:672
translate russian morgan_halloween_dance_f92cf739:
    "Едва мы начинаем танцевать, я понимаю, что поступил правильно."

# ch/morgan/date.rpy:674
translate russian morgan_halloween_dance_c9a60db9:
    "На танцполе Морган оживает, превращаясь в сгусток энергии."

# ch/morgan/date.rpy:675
translate russian morgan_halloween_dance_8e0cea00:
    "С каждой песней я чувствую, как устаю всё сильнее."

# ch/morgan/date.rpy:676
translate russian morgan_halloween_dance_aec6eeef:
    "А её каждая новая песня будто заново заряжает!"

# ch/morgan/date.rpy:677
translate russian morgan_halloween_dance_b17fbc51:
    "Утешает, конечно, то, что она всё это время жмётся ко мне."

# ch/morgan/date.rpy:678
translate russian morgan_halloween_dance_16d9e860:
    "Ради такой близости с Морган стоит постараться."

# ch/morgan/date.rpy:679
translate russian morgan_halloween_dance_7760eaa5:
    "Скажем так, контакт кожи с мехом у нас весьма тесный."

# ch/morgan/date.rpy:680
translate russian morgan_halloween_dance_61ce5015:
    "Помню, в детстве у меня был плюшевый мишка."

# ch/morgan/date.rpy:681
translate russian morgan_halloween_dance_e09c9141:
    "Но от объятий с ним у меня никогда так не вставал, как от Морган!"

# ch/morgan/date.rpy:683
translate russian morgan_halloween_dance_d406ffc2:
    "Едва мы начинаем танцевать, Морган словно раскрепощается."

# ch/morgan/date.rpy:686
translate russian morgan_halloween_dance_b0d81c64:
    "Прежняя скованность и нервозность уступают расслабленности."

# ch/morgan/date.rpy:687
translate russian morgan_halloween_dance_6a9456bf:
    "Вскоре мы уже вовсю отплясываем, пусть и не слишком искусно."

# ch/morgan/date.rpy:688
translate russian morgan_halloween_dance_4b4290bf:
