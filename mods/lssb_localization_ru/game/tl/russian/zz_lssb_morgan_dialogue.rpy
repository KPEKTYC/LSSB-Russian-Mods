# ch/morgan/reactions.rpy:451
translate russian morgan_belly_caress_male_5ff33945:
    "Чувствуешь некое право на него: ведь ребёнок внутри появился и благодаря тебе."

# ch/morgan/reactions.rpy:452
translate russian morgan_belly_caress_male_d7617c6f:
