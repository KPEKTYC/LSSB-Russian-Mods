# ch/morgan/reactions.rpy:454
translate russian morgan_belly_caress_male_11a2c992:
    "Потом спохватываюсь и отдёргиваю руку, надеясь, что она не заметила."

# ch/morgan/reactions.rpy:455
translate russian morgan_belly_caress_male_f45484a7:
