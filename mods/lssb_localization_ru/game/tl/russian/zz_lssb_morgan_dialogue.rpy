# ch/morgan/reactions.rpy:491
translate russian morgan_belly_caress_male_aaff18cd:
    mike.say "Д... да, Морган..."

# ch/morgan/reactions.rpy:492
translate russian morgan_belly_caress_male_d640fe12:
    mike.say "Ничего лучше в жизни не было."

# ch/morgan/reactions.rpy:493
translate russian morgan_belly_caress_male_15561977:
    mike.say "Это просто невероятно!"

# ch/morgan/reactions.rpy:498
translate russian morgan_belly_listen_male_5ab2ee6f:
    morgan.say "Ох..."

# ch/morgan/reactions.rpy:499
translate russian morgan_belly_listen_male_ef3f54bb:
    morgan.say "Ах ты маленький проказник!"

# ch/morgan/reactions.rpy:500
translate russian morgan_belly_listen_male_70395108:
    morgan.say "Угомонишься ты там наконец?"

# ch/morgan/reactions.rpy:502
translate russian morgan_belly_listen_male_87340777:
    "Сейчас достаточно самого тихого стона или вздоха Морган."

# ch/morgan/reactions.rpy:504
translate russian morgan_belly_listen_male_f75ef2e9:
    "И я уже мчусь к ней, охваченный тревогой."

# ch/morgan/reactions.rpy:505
translate russian morgan_belly_listen_male_542d1adf:
    "С номером больницы на быстром наборе!"

# ch/morgan/reactions.rpy:506
translate russian morgan_belly_listen_male_ff1e4afb:
    mike.say "Морган, ты в порядке?"

# ch/morgan/reactions.rpy:507
translate russian morgan_belly_listen_male_76f3f71a:
    mike.say "С ребёнком что-то не так?!"

# ch/morgan/reactions.rpy:509
translate russian morgan_belly_listen_male_3b2f6ab0:
    "Морган качает головой."

# ch/morgan/reactions.rpy:510
translate russian morgan_belly_listen_male_f2071346:
    "Кажется, она уже привыкла к моей чрезмерной заботе."

# ch/morgan/reactions.rpy:512
translate russian morgan_belly_listen_male_0eca52e3:
