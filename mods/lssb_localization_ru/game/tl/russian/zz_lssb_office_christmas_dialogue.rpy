# ch/harems_full/office/events/office_christmas_party.rpy:2832
translate russian office_christmas_dwayne_sex_c6e14ba4:
    "Вскоре выясняется, что сказать проще, чем сделать: её нигде нет."

# ch/harems_full/office/events/office_christmas_party.rpy:2833
translate russian office_christmas_dwayne_sex_7c4656ff:
