# ch/harems_full/office/events/office_christmas_party.rpy:808
translate russian office_christmas_antics_ea84a112:
    aletta.say "Раньше я отказалась лишь потому, что ещё не поняла общего настроя."

# ch/harems_full/office/events/office_christmas_party.rpy:809
translate russian office_christmas_antics_e570a917:
