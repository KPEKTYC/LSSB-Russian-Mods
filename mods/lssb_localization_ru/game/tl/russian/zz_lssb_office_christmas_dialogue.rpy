# Native Office_christmas identifiers, current source catalog. Translation only.

# ch/harems_full/office/events/office_christmas_party.rpy:73
translate russian office_christmas_intro_709c5519:
    "Вместе с идущей рядом Алеттой я вхожу в офис, где раньше работал."

# ch/harems_full/office/events/office_christmas_party.rpy:74
translate russian office_christmas_intro_d452e2a1:
    "Я всё ещё не привык приходить сюда в роли генерального директора всей компании."

# ch/harems_full/office/events/office_christmas_party.rpy:75
translate russian office_christmas_intro_ef832ba0:
    "Кажется, я должен вернуться за свой старый стол и просто заняться работой."

# ch/harems_full/office/events/office_christmas_party.rpy:80
translate russian office_christmas_intro_269b740a:
    "Ещё страннее становится, когда я вижу реакцию бывших коллег."

# ch/harems_full/office/events/office_christmas_party.rpy:81
translate russian office_christmas_intro_f588ba38:
    "Одри, Лавиш и Сиори одна за другой отрываются от работы."

# ch/harems_full/office/events/office_christmas_party.rpy:85
translate russian office_christmas_intro_86c8d683:
    "И округляют глаза, поняв, что к ним заглянул большой босс."

# ch/harems_full/office/events/office_christmas_party.rpy:86
translate russian office_christmas_intro_1e215d9e:
    "Похоже, они довольно быстро привыкают к перемене в наших отношениях."

# ch/harems_full/office/events/office_christmas_party.rpy:87
translate russian office_christmas_intro_f7e69aa9:
    "Почему же мне это даётся так тяжело?"

# ch/harems_full/office/events/office_christmas_party.rpy:93
translate russian office_christmas_intro_6158312a:
    aletta.say "Прошу минуту внимания."

# ch/harems_full/office/events/office_christmas_party.rpy:95
translate russian office_christmas_intro_eedc0388:
    aletta.say "Мистер [hero.family_name] хочет кое-что объявить."

# ch/harems_full/office/events/office_christmas_party.rpy:96
translate russian office_christmas_intro_e2311aea:
    "Все тут же смотрят на Алетту."

# ch/harems_full/office/events/office_christmas_party.rpy:97
translate russian office_christmas_intro_9ecc441a:
    "Признаюсь, я восхищаюсь её умением придавать приказу форму вопроса!"

# ch/harems_full/office/events/office_christmas_party.rpy:98
translate russian office_christmas_intro_cf427454:
    "Привыкшие являться по зову Алетты, девушки встают."

# ch/harems_full/office/events/office_christmas_party.rpy:103
translate russian office_christmas_intro_7088a355:
    "Когда все собираются передо мной, видимо, наступает моя очередь говорить."

# ch/harems_full/office/events/office_christmas_party.rpy:104
translate russian office_christmas_intro_75c936a5:
    mike.say "А... здравствуйте..."

# ch/harems_full/office/events/office_christmas_party.rpy:105
translate russian office_christmas_intro_f7ede885:
    mike.say "Я ненадолго. Хотел сказать, что в следующую пятницу мы закроем офис пораньше."

# ch/harems_full/office/events/office_christmas_party.rpy:106
translate russian office_christmas_intro_7404f387:
    "Девушки тут же переглядываются."

# ch/harems_full/office/events/office_christmas_party.rpy:110
translate russian office_christmas_intro_c710c0fa:
    "И начинают оживлённо перешёптываться."

# ch/harems_full/office/events/office_christmas_party.rpy:111
translate russian office_christmas_intro_6573b07f:
    "Вот чёрт!"

# ch/harems_full/office/events/office_christmas_party.rpy:112
translate russian office_christmas_intro_38a80193:
    "Теперь ясно, что происходит."

# ch/harems_full/office/events/office_christmas_party.rpy:113
translate russian office_christmas_intro_7ddae7b2:
    "Они решили, что я отпускаю их домой после обеда!"

# ch/harems_full/office/events/office_christmas_party.rpy:114
translate russian office_christmas_intro_b1bed9e5:
    "Их не за что винить: на их месте я подумал бы то же самое!"

# ch/harems_full/office/events/office_christmas_party.rpy:115
translate russian office_christmas_intro_967bf65f:
    mike.say "Эм... закроем пораньше, потому что устроим рождественский корпоратив!"

# ch/harems_full/office/events/office_christmas_party.rpy:119
translate russian office_christmas_intro_794185eb:
    "Радость вдруг сменяется удивлением."

# ch/harems_full/office/events/office_christmas_party.rpy:120
translate russian office_christmas_intro_aa6cd620:
    "Сиори выглядит встревоженной и разочарованной."

# ch/harems_full/office/events/office_christmas_party.rpy:121
translate russian office_christmas_intro_2eca83a9:
    "Лавиш удаётся сохранить почти невозмутимое выражение лица."

# ch/harems_full/office/events/office_christmas_party.rpy:122
translate russian office_christmas_intro_a87303f8:
    "А вот Одри, напротив, явно рада."

# ch/harems_full/office/events/office_christmas_party.rpy:127
translate russian office_christmas_intro_51b2bb96:
    "Я смотрю на Алетту, но та лишь пожимает плечами."

# ch/harems_full/office/events/office_christmas_party.rpy:133
translate russian office_christmas_intro_f0f6938b:
    mike.say "Приходить, наверное, необязательно..."

# ch/harems_full/office/events/office_christmas_party.rpy:134
translate russian office_christmas_intro_ecc60430:
    mike.say "Но будет здорово, если вы всё-таки придёте!"

# ch/harems_full/office/events/office_christmas_party.rpy:135
translate russian office_christmas_intro_9b75a287:
    "Я натягиваю улыбку, надеясь сойти за хорошего начальника."

# ch/harems_full/office/events/office_christmas_party.rpy:136
translate russian office_christmas_intro_e43e268b:
    "Хотя внутри будто что-то умерло."

# ch/harems_full/office/events/office_christmas_party.rpy:137
translate russian office_christmas_intro_68b5b0cb:
    "В таких ситуациях я всегда стоял в дальнем конце офиса."

# ch/harems_full/office/events/office_christmas_party.rpy:138
translate russian office_christmas_intro_0450ca73:
    "Бурчал себе под нос и закатывал глаза, когда начальник пытался казаться крутым."

# ch/harems_full/office/events/office_christmas_party.rpy:139
translate russian office_christmas_intro_3060dc3a:
    "Теперь остаётся надеяться, что подчинённые не думают обо мне то же самое!"

# ch/harems_full/office/events/office_christmas_party.rpy:140
translate russian office_christmas_intro_6c95fcb0:
    "Но я уже вижу: большинство считает, что явиться придётся."

# ch/harems_full/office/events/office_christmas_party.rpy:145
translate russian office_christmas_intro_30e3cf18:
    "Алетта приходит мне на помощь."

# ch/harems_full/office/events/office_christmas_party.rpy:146
translate russian office_christmas_intro_d1286e01:
    "Она хлопает в ладоши и властно кивает."

# ch/harems_full/office/events/office_christmas_party.rpy:147
translate russian office_christmas_intro_a6d434b6:
    aletta.say "Что ж, значит, решено."

# ch/harems_full/office/events/office_christmas_party.rpy:149
translate russian office_christmas_intro_a3b1a074:
    aletta.say "Увидимся на вечеринке на следующей неделе."

# ch/harems_full/office/events/office_christmas_party.rpy:152
translate russian office_christmas_intro_9b86cecb:
    shiori.say "Ох..."

# ch/harems_full/office/events/office_christmas_party.rpy:153
translate russian office_christmas_intro_227e9fae:
    shiori.say "Надеюсь, удастся найти няню для Канты!"

# ch/harems_full/office/events/office_christmas_party.rpy:154
translate russian office_christmas_intro_b1c22217:
    lavish.say "Я всё равно собиралась работать в тот день после обеда."

# ch/harems_full/office/events/office_christmas_party.rpy:155
translate russian office_christmas_intro_e4d0911f:
    lavish.say "Так что ничего страшного."

# ch/harems_full/office/events/office_christmas_party.rpy:157
translate russian office_christmas_intro_ca7b1f04:
    audrey.say "Господи, да повеселейте вы, унылые клуши!"

# ch/harems_full/office/events/office_christmas_party.rpy:159
translate russian office_christmas_intro_ff92c676:
    audrey.say "Вы хоть представляете, как весело бывает на корпоративах?"

# ch/harems_full/office/events/office_christmas_party.rpy:160
translate russian office_christmas_intro_4ba85c15:
    audrey.say "Еда, выпивка и куча тёмных уголков, где можно пошалить!"

# ch/harems_full/office/events/office_christmas_party.rpy:161
translate russian office_christmas_intro_33cf95e0:
    "Я продолжаю улыбаться, стараясь не прислушиваться к их разговорам."

# ch/harems_full/office/events/office_christmas_party.rpy:162
translate russian office_christmas_intro_0ace8676:
    "Дуэйн бы так не переживал."

# ch/harems_full/office/events/office_christmas_party.rpy:163
translate russian office_christmas_intro_25f676fa:
    "Просто вошёл бы и объявил свою волю."

# ch/harems_full/office/events/office_christmas_party.rpy:164
translate russian office_christmas_intro_7df58668:
    "Но тут я вспоминаю, что Дуэйн мёртв."

# ch/harems_full/office/events/office_christmas_party.rpy:165
translate russian office_christmas_intro_1eebc7f7:
    "И теперь это я пытаюсь занять его место!"

# ch/harems_full/office/events/office_christmas_party.rpy:168
translate russian office_christmas_intro_ca929972:
    "Из середины офиса доносятся голоса."

# ch/harems_full/office/events/office_christmas_party.rpy:169
translate russian office_christmas_intro_465c38af:
    "И на этот раз они даже не похожи на праздные сплетни."

# ch/harems_full/office/events/office_christmas_party.rpy:170
translate russian office_christmas_intro_2731db7e:
    "Я встаю из-за стола и подхожу узнать, что происходит."

# ch/harems_full/office/events/office_christmas_party.rpy:176
translate russian office_christmas_intro_0556154d:
    "Вижу, что все собрались вместе."

# ch/harems_full/office/events/office_christmas_party.rpy:177
translate russian office_christmas_intro_b2f89dc2:
    "Киваю Одри, Лавиш и Сиори."

# ch/harems_full/office/events/office_christmas_party.rpy:178
translate russian office_christmas_intro_e471853b:
    "Но тут замечаю, что и Алетта здесь."

# ch/harems_full/office/events/office_christmas_party.rpy:184
translate russian office_christmas_intro_1f19aa33:
    "А в центре всего этого стоит Дуэйн."

# ch/harems_full/office/events/office_christmas_party.rpy:185
translate russian office_christmas_intro_706adabc:
    "Большой начальник соизволил спуститься из своей башни к простолюдинам!"

# ch/harems_full/office/events/office_christmas_party.rpy:186
translate russian office_christmas_intro_e4fb07ed:
    "Интересно, что за чертовщина тут творится?"

# ch/harems_full/office/events/office_christmas_party.rpy:189
translate russian office_christmas_intro_7dca09c8:
    aletta.say "Тихо, все!"

# ch/harems_full/office/events/office_christmas_party.rpy:190
translate russian office_christmas_intro_8ff76bea:
    aletta.say "Мистер Джексон хочет сделать объявление."

# ch/harems_full/office/events/office_christmas_party.rpy:191
translate russian office_christmas_intro_8c549a1d:
    dwayne.say "Спасибо, Алетта."

# ch/harems_full/office/events/office_christmas_party.rpy:193
translate russian office_christmas_intro_f8117ccf:
    dwayne.say "Дальше я сам!"

# ch/harems_full/office/events/office_christmas_party.rpy:194
translate russian office_christmas_intro_0ec88fa0:
    "Алетта немного смягчается."

# ch/harems_full/office/events/office_christmas_party.rpy:197
translate russian office_christmas_intro_29d0f544:
    "Но всё же кивает и отступает на шаг."

# ch/harems_full/office/events/office_christmas_party.rpy:198
translate russian office_christmas_intro_781ed6ad:
    dwayne.say "Не волнуйтесь, ребята, ничего страшного."

# ch/harems_full/office/events/office_christmas_party.rpy:199
translate russian office_christmas_intro_79698bae:
    dwayne.say "Даже совсем наоборот!"

# ch/harems_full/office/events/office_christmas_party.rpy:200
translate russian office_christmas_intro_96519493:
    dwayne.say "В следующую пятницу мы закроем офис пораньше."

# ch/harems_full/office/events/office_christmas_party.rpy:205
translate russian office_christmas_intro_dfc1ffc7:
    "По собравшимся прокатывается волна радости."

# ch/harems_full/office/events/office_christmas_party.rpy:206
translate russian office_christmas_intro_affe742f:
    "Ещё бы."

# ch/harems_full/office/events/office_christmas_party.rpy:207
translate russian office_christmas_intro_cad92ab5:
    "Кто не хочет уйти с работы пораньше перед праздниками!"

# ch/harems_full/office/events/office_christmas_party.rpy:208
translate russian office_christmas_intro_3144683d:
    dwayne.say "Потому что мы устраиваем корпоратив!"

# ch/harems_full/office/events/office_christmas_party.rpy:212
translate russian office_christmas_intro_794185eb_1:
    "Радость вдруг сменяется удивлением."

# ch/harems_full/office/events/office_christmas_party.rpy:216
translate russian office_christmas_intro_aa6cd620_1:
    "Сиори выглядит встревоженной и разочарованной."

# ch/harems_full/office/events/office_christmas_party.rpy:217
translate russian office_christmas_intro_2eca83a9_1:
    "Лавиш удаётся сохранить почти невозмутимое выражение лица."

# ch/harems_full/office/events/office_christmas_party.rpy:218
translate russian office_christmas_intro_a87303f8_1:
    "А вот Одри, напротив, явно рада."

# ch/harems_full/office/events/office_christmas_party.rpy:223
translate russian office_christmas_intro_51b2bb96_1:
    "Я смотрю на Алетту, но та лишь пожимает плечами."

# ch/harems_full/office/events/office_christmas_party.rpy:226
translate russian office_christmas_intro_e1f3336c:
    dwayne.say "Разумеется, присутствие необязательно."

# ch/harems_full/office/events/office_christmas_party.rpy:227
translate russian office_christmas_intro_c2d9c511:
    dwayne.say "Я вам начальник, а не тюремщик."

# ch/harems_full/office/events/office_christmas_party.rpy:228
translate russian office_christmas_intro_4be08a81:
    dwayne.say "Но мне хочется верить, что я парень что надо."

# ch/harems_full/office/events/office_christmas_party.rpy:229
translate russian office_christmas_intro_ac8bf8ae:
    dwayne.say "Такой, с которым вам всем было бы приятно потусоваться, да?"

# ch/harems_full/office/events/office_christmas_party.rpy:230
translate russian office_christmas_intro_4562d06d:
    "Ух..."

# ch/harems_full/office/events/office_christmas_party.rpy:231
translate russian office_christmas_intro_dc1c0316:
    "Мне не нужен переводчик, чтобы понять этот намёк!"

# ch/harems_full/office/events/office_christmas_party.rpy:232
translate russian office_christmas_intro_5ccc208d:
    "По сути, Дуэйн говорит, что не может заставить нас прийти."

# ch/harems_full/office/events/office_christmas_party.rpy:233
translate russian office_christmas_intro_a7b8a138:
    "Но если мы отправимся домой, он нам это припомнит!"

# ch/harems_full/office/events/office_christmas_party.rpy:234
translate russian office_christmas_intro_c3f3131f:
    "Дуэйн подкрепляет свои слова фирменной ухмылкой."

# ch/harems_full/office/events/office_christmas_party.rpy:235
translate russian office_christmas_intro_b74b6e11:
    "И напоследок поднимает оба больших пальца, отчего мне становится неловко за него."

# ch/harems_full/office/events/office_christmas_party.rpy:237
translate russian office_christmas_intro_aa39a56b:
    "Затем Дуэйн разворачивается и выходит из офиса."

# ch/harems_full/office/events/office_christmas_party.rpy:239
translate russian office_christmas_intro_a6d434b6_1:
    aletta.say "Что ж, значит, решено."

# ch/harems_full/office/events/office_christmas_party.rpy:240
translate russian office_christmas_intro_a3b1a074_1:
    aletta.say "Увидимся на вечеринке на следующей неделе."

# ch/harems_full/office/events/office_christmas_party.rpy:245
translate russian office_christmas_intro_9b86cecb_1:
    shiori.say "Ох..."

# ch/harems_full/office/events/office_christmas_party.rpy:246
translate russian office_christmas_intro_227e9fae_1:
    shiori.say "Надеюсь, удастся найти няню для Канты!"

# ch/harems_full/office/events/office_christmas_party.rpy:247
translate russian office_christmas_intro_b1c22217_1:
    lavish.say "Я всё равно собиралась работать в тот день после обеда."

# ch/harems_full/office/events/office_christmas_party.rpy:248
translate russian office_christmas_intro_e4d0911f_1:
    lavish.say "Так что ничего страшного."

# ch/harems_full/office/events/office_christmas_party.rpy:249
translate russian office_christmas_intro_ca7b1f04_1:
    audrey.say "Господи, да повеселейте вы, унылые клуши!"

# ch/harems_full/office/events/office_christmas_party.rpy:251
translate russian office_christmas_intro_ff92c676_1:
    audrey.say "Вы хоть представляете, как весело бывает на корпоративах?"

# ch/harems_full/office/events/office_christmas_party.rpy:252
translate russian office_christmas_intro_4ba85c15_1:
    audrey.say "Еда, выпивка и куча тёмных уголков, где можно пошалить!"

# ch/harems_full/office/events/office_christmas_party.rpy:253
translate russian office_christmas_intro_9fd3ee41:
    "Я смеюсь и качаю головой."

# ch/harems_full/office/events/office_christmas_party.rpy:254
translate russian office_christmas_intro_5567984f:
    mike.say "У меня плохое предчувствие!"

# ch/harems_full/office/events/office_christmas_party.rpy:263
translate russian office_christmas_missed_fc242ed2:
    "Чёрт, я пропустил рождественский корпоратив. Алетта будет злиться."

# ch/harems_full/office/events/office_christmas_party.rpy:270
translate russian office_christmas_cancelled_90015532:
    "Я ведь больше не работаю в офисе. Похоже на то."

# ch/harems_full/office/events/office_christmas_party.rpy:272
translate russian office_christmas_cancelled_f1ccf175:
    "Меня отстранили от работы. В этом году рождественского корпоратива мне не видать."

# ch/harems_full/office/events/office_christmas_party.rpy:274
translate russian office_christmas_cancelled_768c6ba0:
    "Дуэйн мёртв. Похоже, в этом году рождественского корпоратива не будет."

# ch/harems_full/office/events/office_christmas_party.rpy:287
translate russian office_christmas_arrival_441182d2:
    "Наконец наступила пятница, и пора начинать рождественский корпоратив."

# ch/harems_full/office/events/office_christmas_party.rpy:288
translate russian office_christmas_arrival_ed12faf1:
    "В прошлые годы я просто подтягивался на вечеринку, когда хотелось."

# ch/harems_full/office/events/office_christmas_party.rpy:289
translate russian office_christmas_arrival_bf9e2c3e:
    "Меня волновало лишь одно: выпить столько бесплатного алкоголя, сколько в меня влезет."

# ch/harems_full/office/events/office_christmas_party.rpy:290
translate russian office_christmas_arrival_2408298f:
    "Ну и ещё возможность пофлиртовать с коллегами за счёт рабочего времени!"

# ch/harems_full/office/events/office_christmas_party.rpy:291
translate russian office_christmas_arrival_afc80f42:
    "Но в этом году всё иначе."

# ch/harems_full/office/events/office_christmas_party.rpy:292
translate russian office_christmas_arrival_8d61acdc:
    "Теперь я генеральный директор компании, а значит, хозяин вечеринки!"

# ch/harems_full/office/events/office_christmas_party.rpy:293
translate russian office_christmas_arrival_c7da5125:
    "Поэтому-то я сейчас и одет Сантой."

# ch/harems_full/office/events/office_christmas_party.rpy:294
translate russian office_christmas_arrival_b7d9ce12:
    "Я знаю, что наряжаться на корпоратив никто не обязан."

# ch/harems_full/office/events/office_christmas_party.rpy:295
translate russian office_christmas_arrival_dae5a9ea:
    "Но чувствую, что должен подать пример и проявить инициативу."

# ch/harems_full/office/events/office_christmas_party.rpy:296
translate russian office_christmas_arrival_3c1ed1e7:
    "Ну, показать, что проникся духом Рождества."

# ch/harems_full/office/events/office_christmas_party.rpy:297
translate russian office_christmas_arrival_f2d490dc:
    "Я продолжаю убеждать себя в этом, входя на вечеринку."

# ch/harems_full/office/events/office_christmas_party.rpy:299
translate russian office_christmas_arrival_a13f7211:
    mike.say "Хо-хо-хо!"

# ch/harems_full/office/events/office_christmas_party.rpy:300
translate russian office_christmas_arrival_20249446:
    mike.say "Всех с Рождеством!"

# ch/harems_full/office/events/office_christmas_party.rpy:305
translate russian office_christmas_arrival_49bc4313:
    "Все как один оборачиваются и смотрят на меня."

# ch/harems_full/office/events/office_christmas_party.rpy:306
translate russian office_christmas_arrival_a3576c8f:
    "И тут я понимаю, что нарядиться потрудился только я!"

# ch/harems_full/office/events/office_christmas_party.rpy:307
translate russian office_christmas_arrival_130ce965:
    audrey.say "О... мой... бог!"

# ch/harems_full/office/events/office_christmas_party.rpy:308
translate russian office_christmas_arrival_65020f8a:
    lavish.say "Ха-ха... привет, Санта!"

# ch/harems_full/office/events/office_christmas_party.rpy:309
translate russian office_christmas_arrival_242c615f:
    shiori.say "Ой..."

# ch/harems_full/office/events/office_christmas_party.rpy:310
translate russian office_christmas_arrival_e205345a:
    shiori.say "Нам тоже нужно было нарядиться?"

# ch/harems_full/office/events/office_christmas_party.rpy:312
translate russian office_christmas_arrival_ca621007:
    aletta.say "Не знала, что тебе так идёт красный, [lssb_common.hero_name()]!"

# ch/harems_full/office/events/office_christmas_party.rpy:313
translate russian office_christmas_arrival_21914ff8:
    "Я улыбаюсь и потираю затылок, стараясь выглядеть непринуждённо."

# ch/harems_full/office/events/office_christmas_party.rpy:314
translate russian office_christmas_arrival_0b5338bd:
    "Но факт остаётся фактом: надо мной только что хихикали четыре красотки."

# ch/harems_full/office/events/office_christmas_party.rpy:315
translate russian office_christmas_arrival_f3278674:
    "Не самое удачное начало вечеринки, правда?"

# ch/harems_full/office/events/office_christmas_party.rpy:316
translate russian office_christmas_arrival_86e84d0c:
    "С Дуэйном такого никогда бы не случилось."

# ch/harems_full/office/events/office_christmas_party.rpy:317
translate russian office_christmas_arrival_bf72e468:
    "Он бы вошёл и сразу подчинил себе весь зал."

# ch/harems_full/office/events/office_christmas_party.rpy:318
translate russian office_christmas_arrival_bdde3e76:
    "Но в этом-то и дело, разве нет?"

# ch/harems_full/office/events/office_christmas_party.rpy:319
translate russian office_christmas_arrival_038850d5:
    "Дуэйн к тому же напился бы и начал шуметь."

# ch/harems_full/office/events/office_christmas_party.rpy:320
translate russian office_christmas_arrival_05c37429:
    "А потом принялся бы клеиться ко всем девушкам на вечеринке."

# ch/harems_full/office/events/office_christmas_party.rpy:321
translate russian office_christmas_arrival_a729126a:
    "Суть в том, что я не Дуэйн."

# ch/harems_full/office/events/office_christmas_party.rpy:322
translate russian office_christmas_arrival_683cf058:
    "И хочу, чтобы мои сотрудники это увидели."

# ch/harems_full/office/events/office_christmas_party.rpy:323
translate russian office_christmas_arrival_21f25746:
    "Так какая разница, если мой костюм их рассмешил?"

# ch/harems_full/office/events/office_christmas_party.rpy:325
translate russian office_christmas_arrival_fcc10f26:
    mike.say "Ну же, ребята!"

# ch/harems_full/office/events/office_christmas_party.rpy:326
translate russian office_christmas_arrival_d5bdde31:
    mike.say "Рождество на дворе, и у нас вообще-то вечеринка!"

# ch/harems_full/office/events/office_christmas_party.rpy:331
translate russian office_christmas_arrival_ba9beb0a:
    "Девушки одна за другой начинают откликаться на мои призывы."

# ch/harems_full/office/events/office_christmas_party.rpy:332
translate russian office_christmas_arrival_25014bd5:
    audrey.say "Ладно, [lssb_common.hero_name()], ладно."

# ch/harems_full/office/events/office_christmas_party.rpy:334
translate russian office_christmas_arrival_c89d945f:
    audrey.say "Думаю, выпивка нам поможет!"

# ch/harems_full/office/events/office_christmas_party.rpy:335
translate russian office_christmas_arrival_91ff562a:
    lavish.say "Ты прав, [lssb_common.hero_name()]."

# ch/harems_full/office/events/office_christmas_party.rpy:336
translate russian office_christmas_arrival_88b4259d:
    lavish.say "С Рождеством!"

# ch/harems_full/office/events/office_christmas_party.rpy:337
translate russian office_christmas_arrival_1d0ba991:
    shiori.say "Мне... мне очень нравится твой костюм, [lssb_common.hero_name()]!"

# ch/harems_full/office/events/office_christmas_party.rpy:338
translate russian office_christmas_arrival_e85df173:
    shiori.say "Просто я стеснялась сказать..."

# ch/harems_full/office/events/office_christmas_party.rpy:339
translate russian office_christmas_arrival_b19908f0:
    aletta.say "Надо отдать тебе должное, [lssb_common.hero_name()]."

# ch/harems_full/office/events/office_christmas_party.rpy:340
translate russian office_christmas_arrival_d1362ab0:
    aletta.say "Ты и правда стараешься подать пример."

# ch/harems_full/office/events/office_christmas_party.rpy:342
translate russian office_christmas_arrival_8858ef1c:
    aletta.say "И мне это нравится."

# ch/harems_full/office/events/office_christmas_party.rpy:343
translate russian office_christmas_arrival_7b68fdd0:
    "Все начинают общаться, и настроение у меня поднимается."

# ch/harems_full/office/events/office_christmas_party.rpy:344
translate russian office_christmas_arrival_f49299e6:
    "Может, всё всё-таки получится, как я надеялся."

# ch/harems_full/office/events/office_christmas_party.rpy:345
translate russian office_christmas_arrival_b83b34ad:
    "Может, я смогу быть начальником по-своему и выйти из тени Дуэйна."

# ch/harems_full/office/events/office_christmas_party.rpy:346
translate russian office_christmas_arrival_f7c953d6:
    "Но затем я усилием воли отгоняю эти мысли."

# ch/harems_full/office/events/office_christmas_party.rpy:347
translate russian office_christmas_arrival_ba2f930b:
    "Нужно просто наслаждаться вечеринкой, как все остальные."

# ch/harems_full/office/events/office_christmas_party.rpy:349
translate russian office_christmas_arrival_cec99850:
    "Наконец наступила пятница, а с ней и долгожданный рождественский корпоратив."

# ch/harems_full/office/events/office_christmas_party.rpy:350
translate russian office_christmas_arrival_45cbf5a2:
    "Чтобы проникнуться праздничным духом, я уже подготовился и нарядился Сантой."

# ch/harems_full/office/events/office_christmas_party.rpy:351
translate russian office_christmas_arrival_86278840:
    "Я знаю, что о праздничных костюмах ничего не говорили."

# ch/harems_full/office/events/office_christmas_party.rpy:352
translate russian office_christmas_arrival_65cd5d8b:
    "Но, может, кому-то из коллег пришла в голову та же идея."

# ch/harems_full/office/events/office_christmas_party.rpy:353
translate russian office_christmas_arrival_eb6eb24e:
    "А если нет... что ж, по крайней мере, не я тут рождественский ворчун!"

# ch/harems_full/office/events/office_christmas_party.rpy:355
translate russian office_christmas_arrival_a13f7211_1:
    mike.say "Хо-хо-хо!"

# ch/harems_full/office/events/office_christmas_party.rpy:356
translate russian office_christmas_arrival_20249446_1:
    mike.say "Всех с Рождеством!"

# ch/harems_full/office/events/office_christmas_party.rpy:361
translate russian office_christmas_arrival_49bc4313_1:
    "Все как один оборачиваются и смотрят на меня."

# ch/harems_full/office/events/office_christmas_party.rpy:362
translate russian office_christmas_arrival_a3576c8f_1:
    "И тут я понимаю, что нарядиться потрудился только я!"

# ch/harems_full/office/events/office_christmas_party.rpy:363
translate russian office_christmas_arrival_130ce965_1:
    audrey.say "О... мой... бог!"

# ch/harems_full/office/events/office_christmas_party.rpy:364
translate russian office_christmas_arrival_65020f8a_1:
    lavish.say "Ха-ха... привет, Санта!"

# ch/harems_full/office/events/office_christmas_party.rpy:365
translate russian office_christmas_arrival_242c615f_1:
    shiori.say "Ой..."

# ch/harems_full/office/events/office_christmas_party.rpy:366
translate russian office_christmas_arrival_e205345a_1:
    shiori.say "Нам тоже нужно было нарядиться?"

# ch/harems_full/office/events/office_christmas_party.rpy:368
translate russian office_christmas_arrival_ca621007_1:
    aletta.say "Не знала, что тебе так идёт красный, [lssb_common.hero_name()]!"

# ch/harems_full/office/events/office_christmas_party.rpy:369
translate russian office_christmas_arrival_21914ff8_1:
    "Я улыбаюсь и потираю затылок, стараясь выглядеть непринуждённо."

# ch/harems_full/office/events/office_christmas_party.rpy:370
translate russian office_christmas_arrival_0b5338bd_1:
    "Но факт остаётся фактом: надо мной только что хихикали четыре красотки."

# ch/harems_full/office/events/office_christmas_party.rpy:371
translate russian office_christmas_arrival_f3278674_1:
    "Не самое удачное начало вечеринки, правда?"

# ch/harems_full/office/events/office_christmas_party.rpy:377
translate russian office_christmas_arrival_f63f049f:
    dwayne.say "Эй, эй, эй!"

# ch/harems_full/office/events/office_christmas_party.rpy:378
translate russian office_christmas_arrival_9a053e73:
    dwayne.say "Вот это я понимаю!"

# ch/harems_full/office/events/office_christmas_party.rpy:379
translate russian office_christmas_arrival_2a38c92e:
    "В этот момент между девушками протискивается Дуэйн."

# ch/harems_full/office/events/office_christmas_party.rpy:380
translate russian office_christmas_arrival_ce855269:
    "На лице широкая ухмылка, в руке стакан."

# ch/harems_full/office/events/office_christmas_party.rpy:381
translate russian office_christmas_arrival_0039a4e3:
    "Судя по виду, далеко не первый."

# ch/harems_full/office/events/office_christmas_party.rpy:382
translate russian office_christmas_arrival_b344fd44:
    "А судя по запаху изо рта, в стакане вовсе не сок!"

# ch/harems_full/office/events/office_christmas_party.rpy:385
translate russian office_christmas_arrival_348cce4b:
    dwayne.say "Знал, что уж ты-то поддержишь праздничное настроение, [lssb_common.hero_name()]!"

# ch/harems_full/office/events/office_christmas_party.rpy:386
translate russian office_christmas_arrival_c0ab031a:
    dwayne.say "Ты ведь у нас такой, понимаешь?"

# ch/harems_full/office/events/office_christmas_party.rpy:387
translate russian office_christmas_arrival_0b015452:
    "Дуэйн обхватывает меня за плечи своей огромной рукой." with hpunch

# ch/harems_full/office/events/office_christmas_party.rpy:388
translate russian office_christmas_arrival_5c672789:
    "Клянусь, я чувствую, как под этим нажимом сжимаются кости и сухожилия."

# ch/harems_full/office/events/office_christmas_party.rpy:389
translate russian office_christmas_arrival_f9cc161e:
    dwayne.say "Вот я, например, ни за что не смог бы вырядиться клоуном."

# ch/harems_full/office/events/office_christmas_party.rpy:390
translate russian office_christmas_arrival_52ccffaa:
    dwayne.say "Мне ведь нужно поддерживать имидж, да?"

# ch/harems_full/office/events/office_christmas_party.rpy:391
translate russian office_christmas_arrival_6f3ddfcc:
    dwayne.say "А тебе, [lssb_common.hero_name()], в этом плане терять нечего!"

# ch/harems_full/office/events/office_christmas_party.rpy:393
translate russian office_christmas_arrival_8a8bc391:
    mike.say "Спасибо... наверное?"

# ch/harems_full/office/events/office_christmas_party.rpy:394
translate russian office_christmas_arrival_a8cb6c22:
    "После этого Дуэйн, похоже, теряет ко мне интерес."

# ch/harems_full/office/events/office_christmas_party.rpy:396
translate russian office_christmas_arrival_d8116017:
    "Он уходит, оставив меня с отбитым плечом и задетым самолюбием."

# ch/harems_full/office/events/office_christmas_party.rpy:397
translate russian office_christmas_arrival_9d3d27fb:
    "Кажется, я ещё никогда не видел его настолько пьяным."

# ch/harems_full/office/events/office_christmas_party.rpy:398
translate russian office_christmas_arrival_775d6fa1:
    "Может, кому-то стоит за ним присмотреть?"

# ch/harems_full/office/events/office_christmas_party.rpy:399
translate russian office_christmas_arrival_e7357f06:
    "Чтобы не натворил глупостей."

# ch/harems_full/office/events/office_christmas_party.rpy:400
translate russian office_christmas_arrival_ea5b8a47:
    "Ведь все знают, что бывает на корпоративах."

# ch/harems_full/office/events/office_christmas_party.rpy:401
translate russian office_christmas_arrival_ca330ee2:
    "Особенно когда есть выпивка!"

# ch/harems_full/office/events/office_christmas_party.rpy:402
translate russian office_christmas_arrival_038b1510:
    "С другой стороны, Дуэйн только что оскорбил меня при коллегах."

# ch/harems_full/office/events/office_christmas_party.rpy:403
translate russian office_christmas_arrival_a41dab97:
    "Может, он и не заслуживает, чтобы о нём заботились?"

# ch/harems_full/office/events/office_christmas_party.rpy:404
translate russian office_christmas_arrival_33b894b6:
    "Ах... хватит думать об этом козле!"

# ch/harems_full/office/events/office_christmas_party.rpy:405
translate russian office_christmas_arrival_15ff0483:
    "Сейчас Рождество, и мы на вечеринке."

# ch/harems_full/office/events/office_christmas_party.rpy:406
translate russian office_christmas_arrival_c44dd368:
    "Он здесь не единственный."

# ch/harems_full/office/events/office_christmas_party.rpy:407
translate russian office_christmas_arrival_77fde713:
    "И есть люди, с которыми мне куда приятнее провести время!"

# ch/harems_full/office/events/office_christmas_party.rpy:417
translate russian office_christmas_dancing_66d52629:
    "Нужно воспользоваться возможностью повеселиться и пообщаться с коллегами."

# ch/harems_full/office/events/office_christmas_party.rpy:418
translate russian office_christmas_dancing_4903d564:
    "А раз музыка уже играет, может, стоит потанцевать."

# ch/harems_full/office/events/office_christmas_party.rpy:419
translate russian office_christmas_dancing_77b38c5d:
    "Только кого выбрать в партнёрши?"

# ch/harems_full/office/events/office_christmas_party.rpy:420
translate russian office_christmas_dancing_b37a3183:
    "Пока никто ещё не решился выйти потанцевать."

# ch/harems_full/office/events/office_christmas_party.rpy:421
translate russian office_christmas_dancing_5961ebf3:
    "Так что я могу выбирать любую партнёршу."

# ch/harems_full/office/events/office_christmas_party.rpy:441
translate russian office_christmas_dancing_d541882e:
    "Но мне и думать не приходится, с кем я хочу танцевать."

# ch/harems_full/office/events/office_christmas_party.rpy:443
translate russian office_christmas_dancing_9fd109fe:
    "Я сразу подхожу к Алетте и без колебаний приглашаю её."

# ch/harems_full/office/events/office_christmas_party.rpy:445
translate russian office_christmas_dancing_0ca696cb:
    mike.say "Хочешь потанцевать?"

# ch/harems_full/office/events/office_christmas_party.rpy:447
translate russian office_christmas_dancing_4a506def:
    "Алетта поворачивается ко мне с лёгким удивлением."

# ch/harems_full/office/events/office_christmas_party.rpy:448
translate russian office_christmas_dancing_414a9e82:
    "Но уже через секунду берёт себя в руки и снова выглядит невозмутимой."

# ch/harems_full/office/events/office_christmas_party.rpy:449
translate russian office_christmas_dancing_ee3d2817:
    "Она приподнимает бровь, словно сама мысль о танце со мной её забавляет."

# ch/harems_full/office/events/office_christmas_party.rpy:450
translate russian office_christmas_dancing_0b5e1be1:
    aletta.say "Какая забавная идея, [lssb_common.hero_name()]!"

# ch/harems_full/office/events/office_christmas_party.rpy:451
translate russian office_christmas_dancing_3271322f:
    aletta.say "Извиваться под рождественскую попсу перед подчинёнными."

# ch/harems_full/office/events/office_christmas_party.rpy:452
translate russian office_christmas_dancing_d40f7a05:
    aletta.say "Обычно я сказала бы, что это ниже моего достоинства и должности."

# ch/harems_full/office/events/office_christmas_party.rpy:454
translate russian office_christmas_dancing_d6e6fed5:
    "Алетта умолкает и вздыхает."

# ch/harems_full/office/events/office_christmas_party.rpy:455
translate russian office_christmas_dancing_6b658872:
    aletta.say "Но..."

# ch/harems_full/office/events/office_christmas_party.rpy:456
translate russian office_christmas_dancing_be5c9616:
    aletta.say "Раз уж сейчас время добрых дел, я сделаю исключение."

# ch/harems_full/office/events/office_christmas_party.rpy:457
translate russian office_christmas_dancing_6dba22bb:
    "Меня такой ответ вполне устраивает."

# ch/harems_full/office/events/office_christmas_party.rpy:460
translate russian office_christmas_dancing_4391be4e:
    "Я беру Алетту за руку и отвожу туда, где можно потанцевать."

# ch/harems_full/office/events/office_christmas_party.rpy:461
translate russian office_christmas_dancing_7d406b85:
    "И она довольно быстро расслабляется."

# ch/harems_full/office/events/office_christmas_party.rpy:462
translate russian office_christmas_dancing_6e7ff26d:
    "Стоит ей улыбнуться, и я понимаю, что дело сделано."

# ch/harems_full/office/events/office_christmas_party.rpy:463
translate russian office_christmas_dancing_17efa558:
    "Ей весело, и даже она больше не может этого скрыть!"

# ch/harems_full/office/events/office_christmas_party.rpy:464
translate russian office_christmas_dancing_df1e405b:
    "Алетта не возражает, когда я придвигаюсь поближе."

# ch/harems_full/office/events/office_christmas_party.rpy:465
translate russian office_christmas_dancing_aaed6be8:
    "Более того, её лукавое выражение лица прямо подталкивает меня к этому."

# ch/harems_full/office/events/office_christmas_party.rpy:466
translate russian office_christmas_dancing_d1a79dba:
    "Я и опомниться не успеваю, как мы оказываемся в объятиях друг друга."

# ch/harems_full/office/events/office_christmas_party.rpy:467
translate russian office_christmas_dancing_8d105ae1:
    "Следующие несколько песен мы танцуем, прижавшись друг к другу."

# ch/harems_full/office/events/office_christmas_party.rpy:470
translate russian office_christmas_dancing_98284f03:
    "Да так, что к концу я чувствую себя совершенно измотанным!"

# ch/harems_full/office/events/office_christmas_party.rpy:471
translate russian office_christmas_dancing_93da7c1c:
    "И в трусах у меня тоже всё весьма ощутимо затвердело..."

# ch/harems_full/office/events/office_christmas_party.rpy:476
translate russian office_christmas_dancing_283c1631:
    "Но стоит мне увидеть Одри, и я уже не могу думать ни о ком другом."

# ch/harems_full/office/events/office_christmas_party.rpy:477
translate russian office_christmas_dancing_35abf43f:
    "Она замечает меня раньше, чем я успеваю пересечь комнату и подойти."

# ch/harems_full/office/events/office_christmas_party.rpy:478
translate russian office_christmas_dancing_f04d9281:
    "И смотрит на меня, скрестив руки на груди."

# ch/harems_full/office/events/office_christmas_party.rpy:480
translate russian office_christmas_dancing_8458995b:
    audrey.say "Ну здравствуй..."

# ch/harems_full/office/events/office_christmas_party.rpy:481
translate russian office_christmas_dancing_0e4c9632:
    audrey.say "Чем обязана такой чести?"

# ch/harems_full/office/events/office_christmas_party.rpy:483
translate russian office_christmas_dancing_36da8e6f:
    mike.say "Привет, Одри..."

# ch/harems_full/office/events/office_christmas_party.rpy:484
translate russian office_christmas_dancing_475b390d:
    mike.say "Хочешь потанцевать?"

# ch/harems_full/office/events/office_christmas_party.rpy:485
translate russian office_christmas_dancing_2b0b9074:
    "В ответ Одри качает головой."

# ch/harems_full/office/events/office_christmas_party.rpy:487
translate russian office_christmas_dancing_b3892702:
    "И издаёт свой обычный похабный смешок."

# ch/harems_full/office/events/office_christmas_party.rpy:488
translate russian office_christmas_dancing_a6b26e18:
    audrey.say "Конечно, [lssb_common.hero_name()], почему бы и нет."

# ch/harems_full/office/events/office_christmas_party.rpy:489
translate russian office_christmas_dancing_c74f5156:
    audrey.say "Хоть как-то оживим эту скукотищу!"

# ch/harems_full/office/events/office_christmas_party.rpy:492
translate russian office_christmas_dancing_bf543897:
    "Одри хватает меня за руку и ведёт туда, где можно потанцевать."

# ch/harems_full/office/events/office_christmas_party.rpy:493
translate russian office_christmas_dancing_c33039c8:
    "И как только мы начинаем, она тоже берёт всё в свои руки."

# ch/harems_full/office/events/office_christmas_party.rpy:494
translate russian office_christmas_dancing_c60f44a0:
    "Я-то собирался просто невинно потанцевать."

# ch/harems_full/office/events/office_christmas_party.rpy:495
translate russian office_christmas_dancing_2a84ae32:
    "Может, немного подурачиться, чтобы развеселить всех."

# ch/harems_full/office/events/office_christmas_party.rpy:496
translate russian office_christmas_dancing_f143f7a2:
    "Но Одри сразу задаёт тон, прижимаясь ко мне."

# ch/harems_full/office/events/office_christmas_party.rpy:497
translate russian office_christmas_dancing_e0dce295:
    "От того, что происходит дальше, я бы покрылся потом и задохнулся даже в тёмном ночном клубе."

# ch/harems_full/office/events/office_christmas_party.rpy:498
translate russian office_christmas_dancing_b5e47841:
    "Представьте, каково, когда Одри извивается, прижавшись ко мне, прямо в офисе!"

# ch/harems_full/office/events/office_christmas_party.rpy:499
translate russian office_christmas_dancing_af56fe3c:
    "В конце концов я почти замираю, пока она использует меня как шест."

# ch/harems_full/office/events/office_christmas_party.rpy:500
translate russian office_christmas_dancing_eee1565a:
    "Не то чтобы я жаловался, понимаете?"

# ch/harems_full/office/events/office_christmas_party.rpy:501
translate russian office_christmas_dancing_ddd71773:
    "Просто я слишком хорошо осознаю, что у нас есть зрители."

# ch/harems_full/office/events/office_christmas_party.rpy:502
translate russian office_christmas_dancing_af137a89:
    "Всё это время я чувствую на себе чужие взгляды."

# ch/harems_full/office/events/office_christmas_party.rpy:503
translate russian office_christmas_dancing_e41dc328:
    "Но тело Одри, прижатое к моему, ощущаю ещё сильнее!"

# ch/harems_full/office/events/office_christmas_party.rpy:504
translate russian office_christmas_dancing_f241b0ed:
    "И её тяжёлое дыхание у самого уха."

# ch/harems_full/office/events/office_christmas_party.rpy:507
translate russian office_christmas_dancing_44c22d46:
    "К концу я чувствую себя совершенно измотанным!"

# ch/harems_full/office/events/office_christmas_party.rpy:508
translate russian office_christmas_dancing_93da7c1c_1:
    "И в трусах у меня тоже всё весьма ощутимо затвердело..."

# ch/harems_full/office/events/office_christmas_party.rpy:512
translate russian office_christmas_dancing_6a5bd6e3:
    "Мне не приходится долго думать, с кем именно я хочу потанцевать."

# ch/harems_full/office/events/office_christmas_party.rpy:514
translate russian office_christmas_dancing_6f4a518e:
    "Подходя к Лавиш, я невольно улыбаюсь её взгляду."

# ch/harems_full/office/events/office_christmas_party.rpy:515
translate russian office_christmas_dancing_569e0a8c:
    "Она так спокойна и уверена, так собранна и грациозна."

# ch/harems_full/office/events/office_christmas_party.rpy:516
translate russian office_christmas_dancing_1122cd62:
    "Даже мимолётного взгляда хватает, чтобы я её захотел!"

# ch/harems_full/office/events/office_christmas_party.rpy:517
translate russian office_christmas_dancing_f04f9a80:
    mike.say "Привет, Лавиш..."

# ch/harems_full/office/events/office_christmas_party.rpy:518
translate russian office_christmas_dancing_0c4f3e14:
    mike.say "Не хочешь потанцевать?"

# ch/harems_full/office/events/office_christmas_party.rpy:520
translate russian office_christmas_dancing_33817098:
    "В улыбке Лавиш что-то едва заметно меняется."

# ch/harems_full/office/events/office_christmas_party.rpy:521
translate russian office_christmas_dancing_4d272301:
    "Она становится чуть лукавой и даже немного загадочной."

# ch/harems_full/office/events/office_christmas_party.rpy:522
translate russian office_christmas_dancing_68d27027:
    "И от этого я хочу её только сильнее!"

# ch/harems_full/office/events/office_christmas_party.rpy:523
translate russian office_christmas_dancing_731ecee4:
    lavish.say "Признаюсь, [lssb_common.hero_name()]..."

# ch/harems_full/office/events/office_christmas_party.rpy:524
translate russian office_christmas_dancing_4214b634:
    lavish.say "Я немного надеялась, что ты меня пригласишь!"

# ch/harems_full/office/events/office_christmas_party.rpy:525
translate russian office_christmas_dancing_11c9f960:
    mike.say "Значит, это да?"

# ch/harems_full/office/events/office_christmas_party.rpy:526
translate russian office_christmas_dancing_1bdc7225:
    "Вместо ответа Лавиш кивает."

# ch/harems_full/office/events/office_christmas_party.rpy:527
translate russian office_christmas_dancing_98cee93f:
    "А затем протягивает мне руку."

# ch/harems_full/office/events/office_christmas_party.rpy:530
translate russian office_christmas_dancing_802bffce:
    "Я беру её, и мы вместе находим место для танца."

# ch/harems_full/office/events/office_christmas_party.rpy:531
translate russian office_christmas_dancing_123f7979:
    "Поначалу мы ведём себя непринуждённо."

# ch/harems_full/office/events/office_christmas_party.rpy:532
translate russian office_christmas_dancing_4296479d:
    "Держимся рядом, но не касаемся друг друга."

# ch/harems_full/office/events/office_christmas_party.rpy:533
translate russian office_christmas_dancing_28a7d09e:
    "Однако в какой-то момент что-то словно щёлкает."

# ch/harems_full/office/events/office_christmas_party.rpy:534
translate russian office_christmas_dancing_6e32bf21:
    "В головах у нас обоих будто переключают тумблер, и всё меняется."

# ch/harems_full/office/events/office_christmas_party.rpy:535
translate russian office_christmas_dancing_19669dec:
    "Мои руки оказываются на бёдрах Лавиш, притягивая её ко мне."

# ch/harems_full/office/events/office_christmas_party.rpy:536
translate russian office_christmas_dancing_e1172728:
    "А её руки тянутся к моим плечам, а затем обвивают шею."

# ch/harems_full/office/events/office_christmas_party.rpy:537
translate russian office_christmas_dancing_bd7db4f0:
    "Мгновение спустя мы уже в объятиях друг друга."

# ch/harems_full/office/events/office_christmas_party.rpy:538
translate russian office_christmas_dancing_edc1ca35:
    "Всё оставшееся время мы так и танцуем, прижавшись друг к другу."

# ch/harems_full/office/events/office_christmas_party.rpy:539
translate russian office_christmas_dancing_fe585d4e:
    "А время будто еле ползёт."

# ch/harems_full/office/events/office_christmas_party.rpy:542
translate russian office_christmas_dancing_44c22d46_1:
    "К концу я чувствую себя совершенно измотанным!"

# ch/harems_full/office/events/office_christmas_party.rpy:543
translate russian office_christmas_dancing_93da7c1c_2:
    "И в трусах у меня тоже всё весьма ощутимо затвердело..."

# ch/harems_full/office/events/office_christmas_party.rpy:548
translate russian office_christmas_dancing_f7a245a9:
    "Стоит моему взгляду остановиться на Сиори, как сердце начинает трепетать."

# ch/harems_full/office/events/office_christmas_party.rpy:549
translate russian office_christmas_dancing_09c4de56:
    "Я без раздумий иду к ней."

# ch/harems_full/office/events/office_christmas_party.rpy:551
translate russian office_christmas_dancing_52fc491d:
    "Она удивлённо поднимает глаза, словно не ожидала, что я вообще её замечу."

# ch/harems_full/office/events/office_christmas_party.rpy:552
translate russian office_christmas_dancing_c9e4ceda:
    "Эти огромные невинные глаза почти разбивают мне сердце!"

# ch/harems_full/office/events/office_christmas_party.rpy:553
translate russian office_christmas_dancing_9bd81ea4:
    mike.say "Привет, Сиори..."

# ch/harems_full/office/events/office_christmas_party.rpy:554
translate russian office_christmas_dancing_9fc8d5a4:
    mike.say "Хочешь со мной потанцевать?"

# ch/harems_full/office/events/office_christmas_party.rpy:556
translate russian office_christmas_dancing_16e68689:
    "Сиори растерянно смотрит по сторонам."

# ch/harems_full/office/events/office_christmas_party.rpy:557
translate russian office_christmas_dancing_3364bee6:
    "А потом показывает на себя."

# ch/harems_full/office/events/office_christmas_party.rpy:558
translate russian office_christmas_dancing_a73cecfa:
    shiori.say "П-почему ты хочешь танцевать со мной?!"

# ch/harems_full/office/events/office_christmas_party.rpy:559
translate russian office_christmas_dancing_2043da0e:
    shiori.say "На вечеринке столько других девушек!"

# ch/harems_full/office/events/office_christmas_party.rpy:560
translate russian office_christmas_dancing_33759a9a:
    shiori.say "Наверняка тебе больше хочется..."

# ch/harems_full/office/events/office_christmas_party.rpy:562
translate russian office_christmas_dancing_a85a6d96:
    mike.say "Я не хочу танцевать с ними, Сиори."

# ch/harems_full/office/events/office_christmas_party.rpy:563
translate russian office_christmas_dancing_ebafd7b5:
    mike.say "Я хочу танцевать с тобой!"

# ch/harems_full/office/events/office_christmas_party.rpy:566
translate russian office_christmas_dancing_55473265:
    "Улыбаясь и кивая, я беру Сиори за руку."

# ch/harems_full/office/events/office_christmas_party.rpy:569
translate russian office_christmas_dancing_350de6b9:
    "Она не сопротивляется, когда я веду её туда, где можно потанцевать."

# ch/harems_full/office/events/office_christmas_party.rpy:570
translate russian office_christmas_dancing_18da221c:
    "Поначалу Сиори явно не может справиться с волнением."

# ch/harems_full/office/events/office_christmas_party.rpy:571
translate russian office_christmas_dancing_6b6345c2:
    "Она держится на расстоянии и даже не смотрит мне в глаза."

# ch/harems_full/office/events/office_christmas_party.rpy:572
translate russian office_christmas_dancing_b147a9c0:
    "Но деликатность, похоже, помогает."

# ch/harems_full/office/events/office_christmas_party.rpy:573
translate russian office_christmas_dancing_f685ab3e:
    "Сначала она встречается со мной взглядом, а потом улыбается."

# ch/harems_full/office/events/office_christmas_party.rpy:574
translate russian office_christmas_dancing_4107d66d:
    "Я улыбаюсь в ответ и вижу, как она подходит на шаг ближе."

# ch/harems_full/office/events/office_christmas_party.rpy:575
translate russian office_christmas_dancing_a084c45c:
    "А когда она прижимается ко мне и кладёт голову мне на грудь..."

# ch/harems_full/office/events/office_christmas_party.rpy:576
translate russian office_christmas_dancing_c2e63ae1:
    "Это почти невозможно описать словами — настолько хорошо!"

# ch/harems_full/office/events/office_christmas_party.rpy:577
translate russian office_christmas_dancing_60bb70fc:
    "Всё оставшееся время мы танцуем в объятиях друг друга."

# ch/harems_full/office/events/office_christmas_party.rpy:578
translate russian office_christmas_dancing_55c99a31:
    "Мне так нравится ощущать тело Сиори, прижатое к моему."

# ch/harems_full/office/events/office_christmas_party.rpy:579
translate russian office_christmas_dancing_e5e1ebe9:
    "Конечно, её фигурка — просто эротическая мечта."

# ch/harems_full/office/events/office_christmas_party.rpy:580
translate russian office_christmas_dancing_effe74f7:
    "Но этот момент особенный не только поэтому."

# ch/harems_full/office/events/office_christmas_party.rpy:583
translate russian office_christmas_dancing_ccded80a:
    "К концу я чувствую себя почти измотанным!"

# ch/harems_full/office/events/office_christmas_party.rpy:584
translate russian office_christmas_dancing_2cbd19a5:
    "Словно эмоции забрали все силы."

# ch/harems_full/office/events/office_christmas_party.rpy:585
translate russian office_christmas_dancing_93da7c1c_3:
    "И в трусах у меня тоже всё весьма ощутимо затвердело..."

# ch/harems_full/office/events/office_christmas_party.rpy:589
translate russian office_christmas_dancing_853dcd1c:
    "Я оглядываю комнату в поисках подходящей партнёрши для танца."

# ch/harems_full/office/events/office_christmas_party.rpy:590
translate russian office_christmas_dancing_d5ee868c:
    "В офисе точно нет недостатка в красивых девушках."

# ch/harems_full/office/events/office_christmas_party.rpy:591
translate russian office_christmas_dancing_3f5538eb:
    "В том числе таких, с которыми я бы охотно познакомился поближе!"

# ch/harems_full/office/events/office_christmas_party.rpy:592
translate russian office_christmas_dancing_5f7ffefd:
    "Но тут в другом конце комнаты я замечаю ту, кого совсем не ожидал здесь увидеть."

# ch/harems_full/office/events/office_christmas_party.rpy:594
translate russian office_christmas_dancing_2be10172:
    "Это Шери, жена Дуэйна. Хотя теперь уже, наверное, вдова!"

# ch/harems_full/office/events/office_christmas_party.rpy:595
translate russian office_christmas_dancing_fcb6ec18:
    "Я направляюсь прямо к ней сквозь толпу гостей."

# ch/harems_full/office/events/office_christmas_party.rpy:596
translate russian office_christmas_dancing_43fb37bf:
    mike.say "Здравствуйте, Шери..."

# ch/harems_full/office/events/office_christmas_party.rpy:597
translate russian office_christmas_dancing_8c1248de:
    mike.say "Не ожидал вас здесь увидеть!"

# ch/harems_full/office/events/office_christmas_party.rpy:599
translate russian office_christmas_dancing_8b85a93d:
    "Шери поворачивается ко мне с улыбкой."

# ch/harems_full/office/events/office_christmas_party.rpy:600
translate russian office_christmas_dancing_6f50f486:
    "Но нетрудно заметить, что улыбка немного натянутая."

# ch/harems_full/office/events/office_christmas_party.rpy:601
translate russian office_christmas_dancing_8e73083f:
    "Она прекрасно выглядит, но очень устала."

# ch/harems_full/office/events/office_christmas_party.rpy:602
translate russian office_christmas_dancing_c3d87e64:
    "Неудивительно: она ведь только что потеряла мужа."

# ch/harems_full/office/events/office_christmas_party.rpy:604
translate russian office_christmas_dancing_f169d7c6:
    cherie.say "О..."

# ch/harems_full/office/events/office_christmas_party.rpy:605
translate russian office_christmas_dancing_2853b9e0:
    cherie.say "Здравствуйте!"

# ch/harems_full/office/events/office_christmas_party.rpy:607
translate russian office_christmas_dancing_18dea8ec:
    "Она качает головой и обводит комнату рукой."

# ch/harems_full/office/events/office_christmas_party.rpy:609
translate russian office_christmas_dancing_1acd249e:
    cherie.say "Меня всегда приглашали на такие мероприятия."

# ch/harems_full/office/events/office_christmas_party.rpy:610
translate russian office_christmas_dancing_dbcb6fea:
    cherie.say "Просто до сих пор мне ни разу не хотелось прийти."

# ch/harems_full/office/events/office_christmas_party.rpy:612
translate russian office_christmas_dancing_3ed48fbd:
    cherie.say "А сейчас... ну... мне захотелось выбраться из дома!"

# ch/harems_full/office/events/office_christmas_party.rpy:614
translate russian office_christmas_dancing_e3a21043:
    cherie.say "Надеюсь, это не звучит так ужасно, как мне кажется!"

# ch/harems_full/office/events/office_christmas_party.rpy:616
translate russian office_christmas_dancing_c5515a06:
    "Теперь уже я качаю головой."

# ch/harems_full/office/events/office_christmas_party.rpy:617
translate russian office_christmas_dancing_ccf0b408:
    "Мне очень хочется развеять тревоги Шери."

# ch/harems_full/office/events/office_christmas_party.rpy:618
translate russian office_christmas_dancing_5ee3c92e:
    mike.say "Конечно нет, Шери!"

# ch/harems_full/office/events/office_christmas_party.rpy:619
translate russian office_christmas_dancing_47b43d6a:
    mike.say "По-моему, нужно быть очень смелой, чтобы сюда прийти."

# ch/harems_full/office/events/office_christmas_party.rpy:620
translate russian office_christmas_dancing_5cbc1583:
    mike.say "Особенно после всего, что вы пережили."

# ch/harems_full/office/events/office_christmas_party.rpy:622
translate russian office_christmas_dancing_b9b409fe:
    "Шери мило улыбается в ответ на мои попытки её утешить."

# ch/harems_full/office/events/office_christmas_party.rpy:623
translate russian office_christmas_dancing_5cdab94b:
    "Но затем повисает неловкая пауза."

# ch/harems_full/office/events/office_christmas_party.rpy:624
translate russian office_christmas_dancing_2b091130:
    "Кажется, ни один из нас не знает, что делать дальше."

# ch/harems_full/office/events/office_christmas_party.rpy:625
translate russian office_christmas_dancing_0ee0c1b8:
    "И тут меня осеняет."

# ch/harems_full/office/events/office_christmas_party.rpy:627
translate russian office_christmas_dancing_0ca696cb_1:
    mike.say "Хотите потанцевать?"

# ch/harems_full/office/events/office_christmas_party.rpy:629
translate russian office_christmas_dancing_6dccb878:
    "Шери на мгновение удивлённо смотрит на меня."

# ch/harems_full/office/events/office_christmas_party.rpy:630
translate russian office_christmas_dancing_bb8f933b:
    "Но потом искренне улыбается и хихикает совсем по-девичьи."

# ch/harems_full/office/events/office_christmas_party.rpy:632
translate russian office_christmas_dancing_e38017c9:
    cherie.say "А знаете... какого чёрта, почему бы и нет!"

# ch/harems_full/office/events/office_christmas_party.rpy:633
translate russian office_christmas_dancing_91b5080d:
    cherie.say "Ведите!"

# ch/harems_full/office/events/office_christmas_party.rpy:637
translate russian office_christmas_dancing_c96de948:
    "Шери берёт меня под руку, и я веду её на импровизированный танцпол."

# ch/harems_full/office/events/office_christmas_party.rpy:638
translate russian office_christmas_dancing_1555642b:
    "Всё это время я чувствую на нас взгляды остальных гостей."

# ch/harems_full/office/events/office_christmas_party.rpy:639
translate russian office_christmas_dancing_0f4cd3c7:
    "Как-никак я танцую с шикарной вдовой покойного генерального директора!"

# ch/harems_full/office/events/office_christmas_party.rpy:640
translate russian office_christmas_dancing_218e4143:
    "Но вскоре я совсем о них забываю."

# ch/harems_full/office/events/office_christmas_party.rpy:641
translate russian office_christmas_dancing_3409a63a:
    "Вообще забываю обо всех в комнате, кроме Шери."

# ch/harems_full/office/events/office_christmas_party.rpy:642
translate russian office_christmas_dancing_8fb3f88f:
    "Она всё время тесно прижимается ко мне."

# ch/harems_full/office/events/office_christmas_party.rpy:643
translate russian office_christmas_dancing_d083d5b1:
    "Обнимает так, словно без моей поддержки не устоит на ногах."

# ch/harems_full/office/events/office_christmas_party.rpy:644
translate russian office_christmas_dancing_eb8600bb:
    "Кажется, я почти чувствую её потребность в близости."

# ch/harems_full/office/events/office_christmas_party.rpy:645
translate russian office_christmas_dancing_9b719eb5:
    "То, как одиноко ей стало после смерти Дуэйна."

# ch/harems_full/office/events/office_christmas_party.rpy:647
translate russian office_christmas_dancing_ccded80a_1:
    "К концу я чувствую себя почти измотанным!"

# ch/harems_full/office/events/office_christmas_party.rpy:648
translate russian office_christmas_dancing_2cbd19a5_1:
    "Словно эмоции забрали все силы."

# ch/harems_full/office/events/office_christmas_party.rpy:649
translate russian office_christmas_dancing_93da7c1c_4:
    "И в трусах у меня тоже всё весьма ощутимо затвердело..."

# ch/harems_full/office/events/office_christmas_party.rpy:659
translate russian office_christmas_antics_be552b18:
    "Вечеринка уже в самом разгаре: все смеются, шутят и танцуют."

# ch/harems_full/office/events/office_christmas_party.rpy:660
translate russian office_christmas_antics_870249f7:
    "Кажется, все наконец расслабились и прониклись праздничным духом."

# ch/harems_full/office/events/office_christmas_party.rpy:661
translate russian office_christmas_antics_1d3000ee:
    "Хотя точнее будет сказать — пропитались праздничными напитками."

# ch/harems_full/office/events/office_christmas_party.rpy:662
translate russian office_christmas_antics_ceb49725:
    "Потому что выпито, судя по всему, тоже немало!"

# ch/harems_full/office/events/office_christmas_party.rpy:663
translate russian office_christmas_antics_042a5928:
    "У многих от алкоголя порозовели носы и раскраснелись щёки."

# ch/harems_full/office/events/office_christmas_party.rpy:664
translate russian office_christmas_antics_47b6e104:
    "И вскоре разговоры начинают принимать рискованный оборот..."

# ch/harems_full/office/events/office_christmas_party.rpy:667
translate russian office_christmas_antics_e2efb79e:
    audrey.say "Я лишь говорю, что это рождественский корпоратив, Лавиш!"

# ch/harems_full/office/events/office_christmas_party.rpy:668
translate russian office_christmas_antics_c45544f8:
    audrey.say "Все ждут, что ты напьёшься и выкинешь что-нибудь безумное."

# ch/harems_full/office/events/office_christmas_party.rpy:669
translate russian office_christmas_antics_41e2e025:
    lavish.say "Может, от тебя этого и ждут, Одри."

# ch/harems_full/office/events/office_christmas_party.rpy:670
translate russian office_christmas_antics_efcfe77a:
    lavish.say "Но это ещё не повод так поступать!"

# ch/harems_full/office/events/office_christmas_party.rpy:675
translate russian office_christmas_antics_9b86cecb:
    shiori.say "Ох..."

# ch/harems_full/office/events/office_christmas_party.rpy:676
translate russian office_christmas_antics_875a1e8d:
    shiori.say "Звучит страшновато!"

# ch/harems_full/office/events/office_christmas_party.rpy:680
translate russian office_christmas_antics_3d356bd7:
    aletta.say "Кто-то задумал розыгрыш?"

# ch/harems_full/office/events/office_christmas_party.rpy:681
translate russian office_christmas_antics_172187d4:
    "Разговор девушек меня невольно заинтриговывает."

# ch/harems_full/office/events/office_christmas_party.rpy:682
translate russian office_christmas_antics_cb6b9f95:
    "Я подхожу поближе, чтобы тоже в нём поучаствовать."

# ch/harems_full/office/events/office_christmas_party.rpy:683
translate russian office_christmas_antics_179a428c:
    mike.say "Да, о чём это вы?"

# ch/harems_full/office/events/office_christmas_party.rpy:684
translate russian office_christmas_antics_cc304aff:
    mike.say "Ну же, выкладывайте!"

# ch/harems_full/office/events/office_christmas_party.rpy:689
translate russian office_christmas_antics_7daf3745:
    "Вдруг все четыре девушки смотрят прямо на меня."

# ch/harems_full/office/events/office_christmas_party.rpy:690
translate russian office_christmas_antics_206fe33e:
    "И выражения их лиц меня изрядно забавляют."

# ch/harems_full/office/events/office_christmas_party.rpy:691
translate russian office_christmas_antics_8831a36c:
    "Все четверо, даже Алетта, сейчас похожи на провинившихся школьниц!"

# ch/harems_full/office/events/office_christmas_party.rpy:692
translate russian office_christmas_antics_4facb4ad:
    aletta.say "Мы просто..."

# ch/harems_full/office/events/office_christmas_party.rpy:693
translate russian office_christmas_antics_cf49796b:
    lavish.say "Просто разговаривали..."

# ch/harems_full/office/events/office_christmas_party.rpy:694
translate russian office_christmas_antics_118b7857:
    shiori.say "Говорили о..."

# ch/harems_full/office/events/office_christmas_party.rpy:699
translate russian office_christmas_antics_3239daf3:
    audrey.say "Да бросьте вы, девчонки!"

# ch/harems_full/office/events/office_christmas_party.rpy:700
translate russian office_christmas_antics_ba5701e0:
    audrey.say "Это же [lssb_common.hero_name()]!"

# ch/harems_full/office/events/office_christmas_party.rpy:705
translate russian office_christmas_antics_65a35ed9:
    audrey.say "В душе он такой же раздолбай, как и все!"

# ch/harems_full/office/events/office_christmas_party.rpy:706
translate russian office_christmas_antics_212e5a67:
    audrey.say "Мы говорили о розыгрышах, [lssb_common.hero_name()]."

# ch/harems_full/office/events/office_christmas_party.rpy:708
translate russian office_christmas_antics_e5eb2c02:
    audrey.say "Ну, о выходках на рождественском корпоративе."

# ch/harems_full/office/events/office_christmas_party.rpy:709
translate russian office_christmas_antics_f938b4cd:
    "Я медленно киваю, затем оглядываюсь на копировальный аппарат."

# ch/harems_full/office/events/office_christmas_party.rpy:710
translate russian office_christmas_antics_6af623f9:
    "Все четверо тоже следуют за моим взглядом."

# ch/harems_full/office/events/office_christmas_party.rpy:711
translate russian office_christmas_antics_e8d5cbcd:
    mike.say "Вы про старую добрую классику?"

# ch/harems_full/office/events/office_christmas_party.rpy:712
translate russian office_christmas_antics_134a2554:
    mike.say "Например, сделать ксерокопию определённой части тела?"

# ch/harems_full/office/events/office_christmas_party.rpy:714
translate russian office_christmas_antics_3c8e6ce6:
    aletta.say "Хм, какое ребячество!"

# ch/harems_full/office/events/office_christmas_party.rpy:716
translate russian office_christmas_antics_69b6cf22:
    lavish.say "Совершенно непрофессионально!"

# ch/harems_full/office/events/office_christmas_party.rpy:718
translate russian office_christmas_antics_3a03c8a6:
    shiori.say "И негигиенично к тому же!"

# ch/harems_full/office/events/office_christmas_party.rpy:720
translate russian office_christmas_antics_15a8c996:
    audrey.say "Да, [lssb_common.hero_name()], отличная идея!"

# ch/harems_full/office/events/office_christmas_party.rpy:721
translate russian office_christmas_antics_a13dc2e4:
    "Что ж, по крайней мере, одна из них явно за."

# ch/harems_full/office/events/office_christmas_party.rpy:722
translate russian office_christmas_antics_e673264e:
    "Интересно, удастся ли уговорить остальных троих?"

# ch/harems_full/office/events/office_christmas_party.rpy:729
translate russian office_christmas_antics_715f7544:
    "Ей явно не терпится увидеть эту выходку."

# ch/harems_full/office/events/office_christmas_party.rpy:730
translate russian office_christmas_antics_751b12cc:
    "Значит, вполне логично, если сама Одри её и устроит."

# ch/harems_full/office/events/office_christmas_party.rpy:731
translate russian office_christmas_antics_7597a60a:
    "Поставит на кон свою задницу."

# ch/harems_full/office/events/office_christmas_party.rpy:732
translate russian office_christmas_antics_d1a19b01:
    "Вернее, в данном случае — на ксерокс!"

# ch/harems_full/office/events/office_christmas_party.rpy:733
translate russian office_christmas_antics_eba41f6d:
    "Я подхожу к аппарату, поднимаю крышку и похлопываю по стеклу."

# ch/harems_full/office/events/office_christmas_party.rpy:734
translate russian office_christmas_antics_7a17ec52:
    mike.say "Отлично, Одри!"

# ch/harems_full/office/events/office_christmas_party.rpy:735
translate russian office_christmas_antics_8d2f1124:
    mike.say "Почему бы тебе не показать нам, как это делается?"

# ch/harems_full/office/events/office_christmas_party.rpy:738
translate russian office_christmas_antics_33d370a0:
    "Лицо Одри вдруг меняется."

# ch/harems_full/office/events/office_christmas_party.rpy:739
translate russian office_christmas_antics_f6e4fd72:
    "Она явно не ожидала, что я поймаю её на слове!"

# ch/harems_full/office/events/office_christmas_party.rpy:740
translate russian office_christmas_antics_24ec79d7:
    audrey.say "Ч-что?!"

# ch/harems_full/office/events/office_christmas_party.rpy:741
translate russian office_christmas_antics_ee51889c:
    audrey.say "Почему я?"

# ch/harems_full/office/events/office_christmas_party.rpy:743
translate russian office_christmas_antics_01991af4:
    aletta.say "Какое разочарование!"

# ch/harems_full/office/events/office_christmas_party.rpy:745
translate russian office_christmas_antics_73a3248e:
    lavish.say "Да уж, Одри, вот это ты подала пример!"

# ch/harems_full/office/events/office_christmas_party.rpy:747
translate russian office_christmas_antics_5004029d:
    shiori.say "Ну, если она не будет, то и я не стану!"

# ch/harems_full/office/events/office_christmas_party.rpy:748
translate russian office_christmas_antics_5ee91a1f:
    "Я смотрю на Одри, приподняв брови."

# ch/harems_full/office/events/office_christmas_party.rpy:749
translate russian office_christmas_antics_5fdcdc19:
    "И она пытается выглядеть увереннее."

# ch/harems_full/office/events/office_christmas_party.rpy:751
translate russian office_christmas_antics_3990bd24:
    audrey.say "Я не говорила, что не буду!"

# ch/harems_full/office/events/office_christmas_party.rpy:752
translate russian office_christmas_antics_a0de86d4:
    audrey.say "Просто хотела узнать, почему именно я."

# ch/harems_full/office/events/office_christmas_party.rpy:753
translate russian office_christmas_antics_27c1da9a:
    audrey.say "Очевидно, потому что только у меня и хватит на это смелости!"

# ch/harems_full/office/events/office_christmas_party.rpy:759
translate russian office_christmas_antics_bad284e7:
    "Одри проходит мимо остальных и берёт меня за руку."

# ch/harems_full/office/events/office_christmas_party.rpy:761
translate russian office_christmas_antics_fb75376c:
    "Затем задирает юбку и забирается на ксерокс."

# ch/harems_full/office/events/office_christmas_party.rpy:763
translate russian office_christmas_antics_f8ac3e5b:
    "Но стоит ей поёрзать на нём, как раздаётся жуткий треск!"

# ch/harems_full/office/events/office_christmas_party.rpy:764
translate russian office_christmas_antics_bd3f3b05:
    audrey.say "О нет, моя задница!"

# ch/harems_full/office/events/office_christmas_party.rpy:766
translate russian office_christmas_antics_c8975c1f:
    "Одри тут же спрыгивает с ксерокса."

# ch/harems_full/office/events/office_christmas_party.rpy:767
translate russian office_christmas_antics_a5de88fb:
    "Теперь я вижу треснувшее стекло там, где она только что сидела."

# ch/harems_full/office/events/office_christmas_party.rpy:768
translate russian office_christmas_antics_cfb46d13:
    mike.say "Ничего себе, Одри."

# ch/harems_full/office/events/office_christmas_party.rpy:769
translate russian office_christmas_antics_e2301b04:
    mike.say "Не знал, что у тебя НАСТОЛЬКО тяжёлая задница!"

# ch/harems_full/office/events/office_christmas_party.rpy:771
translate russian office_christmas_antics_dd440515:
    "Не успеваю я добавить ни слова, как Одри поворачивается ко мне задом."

# ch/harems_full/office/events/office_christmas_party.rpy:772
translate russian office_christmas_antics_289b5c33:
    audrey.say "Сейчас не до этого, [lssb_common.hero_name()]!"

# ch/harems_full/office/events/office_christmas_party.rpy:773
translate russian office_christmas_antics_ebfbd914:
    audrey.say "Осмотри мою задницу!"

# ch/harems_full/office/events/office_christmas_party.rpy:775
translate russian office_christmas_antics_c48144ad:
    "Я послушно выполняю просьбу и осматриваю ягодицы Одри в поисках повреждений."

# ch/harems_full/office/events/office_christmas_party.rpy:776
translate russian office_christmas_antics_84fef3a3:
    "Признаюсь, это занимает больше времени, чем нужно."

# ch/harems_full/office/events/office_christmas_party.rpy:777
translate russian office_christmas_antics_cec4cc31:
    "Но я считаю своим долгом всё тщательно проверить!"

# ch/harems_full/office/events/office_christmas_party.rpy:778
translate russian office_christmas_antics_1a060c84:
    mike.say "Не волнуйся, сзади всё в порядке!"

# ch/harems_full/office/events/office_christmas_party.rpy:780
translate russian office_christmas_antics_e0d8c530:
    "Одри громко вздыхает с облегчением."

# ch/harems_full/office/events/office_christmas_party.rpy:781
translate russian office_christmas_antics_a81e1c4e:
    "А остальные от души смеются над ней."

# ch/harems_full/office/events/office_christmas_party.rpy:785
translate russian office_christmas_antics_4c7476a6:
    "Я широко улыбаюсь и смотрю прямо на Алетту."

# ch/harems_full/office/events/office_christmas_party.rpy:786
translate russian office_christmas_antics_760a62c8:
    "Затем подхожу к ксероксу."

# ch/harems_full/office/events/office_christmas_party.rpy:787
translate russian office_christmas_antics_c04c029b:
    "Поднимаю крышку и похлопываю по стеклу."

# ch/harems_full/office/events/office_christmas_party.rpy:788
translate russian office_christmas_antics_1c3af33d:
    mike.say "А почему бы тебе сюда не забраться, Алетта?"

# ch/harems_full/office/events/office_christmas_party.rpy:792
translate russian office_christmas_antics_955f1183:
    "В ответ Алетта презрительно фыркает."

# ch/harems_full/office/events/office_christmas_party.rpy:793
translate russian office_christmas_antics_40339541:
    aletta.say "И зачем, позволь спросить, мне это делать?"

# ch/harems_full/office/events/office_christmas_party.rpy:794
translate russian office_christmas_antics_facac870:
    "Я пожимаю плечами и хмурюсь."

# ch/harems_full/office/events/office_christmas_party.rpy:795
translate russian office_christmas_antics_234e9139:
    mike.say "Может, потому что настоящий руководитель подаёт пример?"

# ch/harems_full/office/events/office_christmas_party.rpy:796
translate russian office_christmas_antics_75b4d96d:
    mike.say "Ты же не боишься в самом деле, правда?"

# ch/harems_full/office/events/office_christmas_party.rpy:798
translate russian office_christmas_antics_e2217b7d:
    audrey.say "Я бы сделала это не раздумывая!"

# ch/harems_full/office/events/office_christmas_party.rpy:800
translate russian office_christmas_antics_00cf54c9:
