# ch/harems_full/office/events/office_christmas_party.rpy:2824
translate russian office_christmas_dwayne_sex_5db91522_2:
    "Меньше всего хочу, чтобы кто-то из них меня увидел!"

# ch/harems_full/office/events/office_christmas_party.rpy:2827
translate russian office_christmas_dwayne_sex_1b919193:
