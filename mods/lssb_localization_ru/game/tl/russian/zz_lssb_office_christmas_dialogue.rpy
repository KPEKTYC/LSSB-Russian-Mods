# ch/harems_full/office/events/office_christmas_party.rpy:2312
translate russian office_christmas_sex_2758bc22:
    "Я понял, что хочу этого, почти сразу, как узнал, что Шери будет на вечеринке."

# ch/harems_full/office/events/office_christmas_party.rpy:2313
translate russian office_christmas_sex_b387d356:
