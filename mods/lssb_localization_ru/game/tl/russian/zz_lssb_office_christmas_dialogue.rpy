translate russian office_christmas_antics_213ddfc5:
    audrey.say "Ты первый!"

# ch/harems_full/office/events/office_christmas_party.rpy:979
translate russian office_christmas_antics_d31cf51c:
    "А, теперь понятно."

# ch/harems_full/office/events/office_christmas_party.rpy:980
translate russian office_christmas_antics_38911f48:
    "Уж Одри-то всегда переходит прямо к делу!"

# ch/harems_full/office/events/office_christmas_party.rpy:981
translate russian office_christmas_antics_26ff7d7d:
    lavish.say "Интересно, решится ли он?"

# ch/harems_full/office/events/office_christmas_party.rpy:983
translate russian office_christmas_antics_1d77c1ae_1:
    shiori.say "Ох, [lssb_common.hero_name()]!"

# ch/harems_full/office/events/office_christmas_party.rpy:984
translate russian office_christmas_antics_095a99df:
    shiori.say "Пожалуйста, будь осторожен!"

# ch/harems_full/office/events/office_christmas_party.rpy:985
translate russian office_christmas_antics_2e2424c1:
    "В ответ я презрительно фыркаю."

# ch/harems_full/office/events/office_christmas_party.rpy:986
translate russian office_christmas_antics_618eb48b:
    "Не позволю им считать меня трусом!"

# ch/harems_full/office/events/office_christmas_party.rpy:987
translate russian office_christmas_antics_d9ef13b3:
    mike.say "Конечно, если вы этого хотите, девчонки."

# ch/harems_full/office/events/office_christmas_party.rpy:988
translate russian office_christmas_antics_7d41b2ca:
    mike.say "Я буду первым."

# ch/harems_full/office/events/office_christmas_party.rpy:989
translate russian office_christmas_antics_40f7ffeb:
    "Я киваю, пытаясь показать свою уверенность."

# ch/harems_full/office/events/office_christmas_party.rpy:990
translate russian office_christmas_antics_ea91e64b:
    "Но внутри уже переживаю, что придётся довести дело до конца!"

# ch/harems_full/office/events/office_christmas_party.rpy:991
translate russian office_christmas_antics_41c32d10:
    "Я спускаю брюки и трусы."

# ch/harems_full/office/events/office_christmas_party.rpy:992
translate russian office_christmas_antics_44d9e594:
    "При этом слежу, чтобы ничего лишнего им не показать."

# ch/harems_full/office/events/office_christmas_party.rpy:993
translate russian office_christmas_antics_a8758080:
    "А затем запрыгиваю на ксерокс."

# ch/harems_full/office/events/office_christmas_party.rpy:998
translate russian office_christmas_antics_e00b4f1d:
    "Не проходит и секунды, как раздаётся жуткий треск!"

# ch/harems_full/office/events/office_christmas_party.rpy:999
translate russian office_christmas_antics_10ebe3ea:
    mike.say "Вот чёрт!"

# ch/harems_full/office/events/office_christmas_party.rpy:1000
translate russian office_christmas_antics_b5778fdc:
    mike.say "Чёрт, чёрт, чёрт!"

# ch/harems_full/office/events/office_christmas_party.rpy:1001
translate russian office_christmas_antics_1cb3a85e:
    "Я тут же спрыгиваю с ксерокса."

# ch/harems_full/office/events/office_christmas_party.rpy:1002
translate russian office_christmas_antics_dec36f94:
    "А девушки спешат посмотреть на треснувшее стекло, где я только что сидел."

# ch/harems_full/office/events/office_christmas_party.rpy:1004
translate russian office_christmas_antics_e959ea11:
    aletta.say "Ремонт обойдётся недёшево!"

# ch/harems_full/office/events/office_christmas_party.rpy:1006
translate russian office_christmas_antics_43c9cec1:
    audrey.say "Ничего себе, [lssb_common.hero_name()]."

# ch/harems_full/office/events/office_christmas_party.rpy:1007
translate russian office_christmas_antics_b200e6af:
    audrey.say "Не знала, что у тебя НАСТОЛЬКО тяжёлая задница!"

# ch/harems_full/office/events/office_christmas_party.rpy:1009
translate russian office_christmas_antics_80902041:
    lavish.say "Теперь я рада, что ты полез первым!"

# ch/harems_full/office/events/office_christmas_party.rpy:1011
translate russian office_christmas_antics_804b86ab:
    shiori.say "[lssb_common.hero_name()], ты в порядке?"

# ch/harems_full/office/events/office_christmas_party.rpy:1012
translate russian office_christmas_antics_9956cc93:
    shiori.say "Тебе вызвать скорую?!"

# ch/harems_full/office/events/office_christmas_party.rpy:1013
translate russian office_christmas_antics_d2564db1:
    mike.say "Да неважно всё это!"

# ch/harems_full/office/events/office_christmas_party.rpy:1014
translate russian office_christmas_antics_4fb84e57:
    mike.say "Может, проверите, цела ли моя задница?!"

# ch/harems_full/office/events/office_christmas_party.rpy:1019
translate russian office_christmas_antics_c32c1991:
    "Я наклоняюсь, пока они собираются вокруг, чтобы осмотреть мой зад."

# ch/harems_full/office/events/office_christmas_party.rpy:1020
translate russian office_christmas_antics_45ab7bac:
    "И всё это время чувствую, как горят щёки."

# ch/harems_full/office/events/office_christmas_party.rpy:1021
translate russian office_christmas_antics_ec14cd40:
    "Тем более что осмотр явно затягивается!"

# ch/harems_full/office/events/office_christmas_party.rpy:1022
translate russian office_christmas_antics_d047bce4:
    mike.say "Эй, что там у вас происходит?!"

# ch/harems_full/office/events/office_christmas_party.rpy:1024
translate russian office_christmas_antics_e8a36f64:
    aletta.say "Да помолчи ты!"

# ch/harems_full/office/events/office_christmas_party.rpy:1026
translate russian office_christmas_antics_f666b807:
    audrey.say "Да, нам нужно всё тщательно проверить!"

# ch/harems_full/office/events/office_christmas_party.rpy:1028
translate russian office_christmas_antics_8f2ee1f1:
    lavish.say "Надо убедиться, что с тобой всё в порядке!"

# ch/harems_full/office/events/office_christmas_party.rpy:1030
translate russian office_christmas_antics_dc8634c1:
    shiori.say "Ох, мой бедный [lssb_common.hero_name()]!"

# ch/harems_full/office/events/office_christmas_party.rpy:1035
translate russian office_christmas_antics_f963d47a:
    "Мне остаётся только стоять и позволять им развлекаться."

# ch/harems_full/office/events/office_christmas_party.rpy:1036
translate russian office_christmas_antics_d0c65a77:
    "Каждый смешок напоминает о моём унизительном положении."

# ch/harems_full/office/events/office_christmas_party.rpy:1037
translate russian office_christmas_antics_7fc844e8:
    "И о том, как глупо было вообще на это соглашаться!"

# ch/harems_full/office/events/office_christmas_party.rpy:1047
translate russian office_christmas_mistletoe_kiss_56c2e020:
    "Всю вечеринку я то и дело поглядываю на омелу."

# ch/harems_full/office/events/office_christmas_party.rpy:1048
translate russian office_christmas_mistletoe_kiss_7ea6ab26:
    "Она свисает с потолка, и большинство гостей её словно не замечает."

# ch/harems_full/office/events/office_christmas_party.rpy:1049
translate russian office_christmas_mistletoe_kiss_525054cd:
    "А мне при каждом взгляде кажется, что она надо мной насмехается."

# ch/harems_full/office/events/office_christmas_party.rpy:1050
translate russian office_christmas_mistletoe_kiss_e4377c53:
    "Пока я смотрю, под ней постоянно кто-то проходит."

# ch/harems_full/office/events/office_christmas_party.rpy:1051
translate russian office_christmas_mistletoe_kiss_58dd0718:
    "Но нужный человек всё никак не оказывается там в нужный момент!"

# ch/harems_full/office/events/office_christmas_party.rpy:1052
translate russian office_christmas_mistletoe_kiss_de77bb8c:
    "Наконец я вижу свой шанс и решаюсь действовать."

# ch/harems_full/office/events/office_christmas_party.rpy:1053
translate russian office_christmas_mistletoe_kiss_6b8e65d6:
    "Когда та, кого я жду, проходит под омелой, я обращаюсь к ней..."

# ch/harems_full/office/events/office_christmas_party.rpy:1074
translate russian office_christmas_mistletoe_kiss_9474bcff:
    mike.say "Посмотри наверх!"

# ch/harems_full/office/events/office_christmas_party.rpy:1076
translate russian office_christmas_mistletoe_kiss_c7711aa3:
    "Алетта резко останавливается и хмурится."

# ch/harems_full/office/events/office_christmas_party.rpy:1077
translate russian office_christmas_mistletoe_kiss_4a3d1a36:
    "Затем вздыхает и делает, как я прошу."

# ch/harems_full/office/events/office_christmas_party.rpy:1078
translate russian office_christmas_mistletoe_kiss_1d368928:
    aletta.say "Я вижу потолок, [lssb_common.hero_name()]."

# ch/harems_full/office/events/office_christmas_party.rpy:1079
translate russian office_christmas_mistletoe_kiss_88b0f086:
    aletta.say "И жалкую веточку омелы!"

# ch/harems_full/office/events/office_christmas_party.rpy:1080
translate russian office_christmas_mistletoe_kiss_5e868fa3:
    "Она снова смотрит на меня."

# ch/harems_full/office/events/office_christmas_party.rpy:1081
translate russian office_christmas_mistletoe_kiss_16d950f9:
    "Теперь на её лице лукавая усмешка."

# ch/harems_full/office/events/office_christmas_party.rpy:1082
translate russian office_christmas_mistletoe_kiss_1981e8d4:
    "Алетта ещё и приподнимает бровь."

# ch/harems_full/office/events/office_christmas_party.rpy:1084
translate russian office_christmas_mistletoe_kiss_136bc071:
    aletta.say "И к чему ты клонишь?"

# ch/harems_full/office/events/office_christmas_party.rpy:1086
translate russian office_christmas_mistletoe_kiss_2598e5f4:
    mike.say "Есть ведь такая традиция, правда?"

# ch/harems_full/office/events/office_christmas_party.rpy:1087
translate russian office_christmas_mistletoe_kiss_987d7dc1:
    mike.say "Ну... в это время года?"

# ch/harems_full/office/events/office_christmas_party.rpy:1088
translate russian office_christmas_mistletoe_kiss_97a7d7da:
    "Алетте, похоже, нравится происходящее."

# ch/harems_full/office/events/office_christmas_party.rpy:1089
translate russian office_christmas_mistletoe_kiss_247b0d48:
    "Нравится смотреть, как я мнусь, пока она вытягивает из меня признание."

# ch/harems_full/office/events/office_christmas_party.rpy:1092
translate russian office_christmas_mistletoe_kiss_968497a1:
    aletta.say "Обычно я против вольностей в рабочее время."

# ch/harems_full/office/events/office_christmas_party.rpy:1093
translate russian office_christmas_mistletoe_kiss_9ddf247a:
    aletta.say "Но раз у нас вечеринка..."

# ch/harems_full/office/events/office_christmas_party.rpy:1094
translate russian office_christmas_mistletoe_kiss_4d18ad00:
    "Алетта кладёт ладони мне на щёки и притягивает ближе."

# ch/harems_full/office/events/office_christmas_party.rpy:1098
translate russian office_christmas_mistletoe_kiss_fbe068c9:
    "А затем прижимается губами к моим."

# ch/harems_full/office/events/office_christmas_party.rpy:1099
translate russian office_christmas_mistletoe_kiss_f8e8ad70:
    "Я едва успеваю ответить на поцелуй."

# ch/harems_full/office/events/office_christmas_party.rpy:1100
translate russian office_christmas_mistletoe_kiss_dd0aa5aa:
    "Её язык уже оказывается между моих губ."

# ch/harems_full/office/events/office_christmas_party.rpy:1101
translate russian office_christmas_mistletoe_kiss_e6c356fd:
    "Это совсем не целомудренный праздничный поцелуй."

# ch/harems_full/office/events/office_christmas_party.rpy:1102
translate russian office_christmas_mistletoe_kiss_83478903:
    "А настоящее проявление необузданной страсти!"

# ch/harems_full/office/events/office_christmas_party.rpy:1103
translate russian office_christmas_mistletoe_kiss_18a3e569:
    "И длится он, кажется, целую вечность."

# ch/harems_full/office/events/office_christmas_party.rpy:1104
translate russian office_christmas_mistletoe_kiss_64b19b34:
    "Когда она наконец отстраняется, я судорожно хватаю воздух."

# ch/harems_full/office/events/office_christmas_party.rpy:1107
translate russian office_christmas_mistletoe_kiss_726dec70:
    aletta.say "С Рождеством, [lssb_common.hero_name()]."

# ch/harems_full/office/events/office_christmas_party.rpy:1108
translate russian office_christmas_mistletoe_kiss_2d6ddf26:
    aletta.say "И удачи в новом году!"

# ch/harems_full/office/events/office_christmas_party.rpy:1112
translate russian office_christmas_mistletoe_kiss_f0d2f347:
    mike.say "Эм, Одри..."

# ch/harems_full/office/events/office_christmas_party.rpy:1113
translate russian office_christmas_mistletoe_kiss_47f393f1:
    mike.say "Видишь, что там наверху?"

# ch/harems_full/office/events/office_christmas_party.rpy:1115
translate russian office_christmas_mistletoe_kiss_071188ae:
    "На мгновение Одри выглядит удивлённой."

# ch/harems_full/office/events/office_christmas_party.rpy:1116
translate russian office_christmas_mistletoe_kiss_1c742f60:
    "Но затем поднимает глаза вслед за мной."

# ch/harems_full/office/events/office_christmas_party.rpy:1117
translate russian office_christmas_mistletoe_kiss_4b8ef91a:
    "Стоит ей заметить омелу, как настроение меняется."

# ch/harems_full/office/events/office_christmas_party.rpy:1119
translate russian office_christmas_mistletoe_kiss_02c2175f:
    "Одри снова смотрит на меня с озорной улыбкой."

# ch/harems_full/office/events/office_christmas_party.rpy:1120
translate russian office_christmas_mistletoe_kiss_2436ce1c:
    audrey.say "Давно ты здесь стоишь, [lssb_common.hero_name()]?"

# ch/harems_full/office/events/office_christmas_party.rpy:1121
translate russian office_christmas_mistletoe_kiss_eb56b412:
    audrey.say "Ждал, пока я пройду под ней, да?"

# ch/harems_full/office/events/office_christmas_party.rpy:1122
translate russian office_christmas_mistletoe_kiss_15f1967f:
    "Я невольно нервно сглатываю."

# ch/harems_full/office/events/office_christmas_party.rpy:1123
translate russian office_christmas_mistletoe_kiss_68bef9e5:
    "Уверен, щёки у меня сейчас тоже покраснели!"

# ch/harems_full/office/events/office_christmas_party.rpy:1125
translate russian office_christmas_mistletoe_kiss_c3da4233:
    mike.say "Может быть..."

# ch/harems_full/office/events/office_christmas_party.rpy:1126
translate russian office_christmas_mistletoe_kiss_84ad3b8c:
    audrey.say "И наверняка уже представил себе каждую секунду!"

# ch/harems_full/office/events/office_christmas_party.rpy:1127
translate russian office_christmas_mistletoe_kiss_bbd8d2b4:
    audrey.say "Но вживую всегда гораздо лучше..."

# ch/harems_full/office/events/office_christmas_party.rpy:1128
translate russian office_christmas_mistletoe_kiss_ac5fa1da:
    "Подтверждая свои слова, Одри наклоняется ко мне."

# ch/harems_full/office/events/office_christmas_party.rpy:1132
translate russian office_christmas_mistletoe_kiss_f51717f1:
    "А затем прижимается губами к моим."

# ch/harems_full/office/events/office_christmas_party.rpy:1133
translate russian office_christmas_mistletoe_kiss_018437fb:
    "Некоторое время она так и остаётся, тесно прижавшись ко мне."

# ch/harems_full/office/events/office_christmas_party.rpy:1134
translate russian office_christmas_mistletoe_kiss_9d90c175:
    "И делает следующий шаг лишь тогда, когда я кладу руки ей на бёдра."

# ch/harems_full/office/events/office_christmas_party.rpy:1135
translate russian office_christmas_mistletoe_kiss_5b38b945:
    "Она тут же опускает их ниже, заставляя меня обхватить её задницу."

# ch/harems_full/office/events/office_christmas_party.rpy:1136
translate russian office_christmas_mistletoe_kiss_055cf407:
    "Затем глубоко проникает языком в мой открытый рот."

# ch/harems_full/office/events/office_christmas_party.rpy:1137
translate russian office_christmas_mistletoe_kiss_d72e96c3:
    "Одри извивается и прижимается ко мне, словно неугомонная змея."

# ch/harems_full/office/events/office_christmas_party.rpy:1138
translate russian office_christmas_mistletoe_kiss_652bbcc0:
    "И её язык движется так же, как тело."

# ch/harems_full/office/events/office_christmas_party.rpy:1139
translate russian office_christmas_mistletoe_kiss_f63434b4:
    "Меня ещё никогда так не целовали под омелой."

# ch/harems_full/office/events/office_christmas_party.rpy:1140
translate russian office_christmas_mistletoe_kiss_1e597a1e:
    "Настолько страстно и долго."

# ch/harems_full/office/events/office_christmas_party.rpy:1141
translate russian office_christmas_mistletoe_kiss_6596a4af:
    "Когда она наконец отстраняется, я судорожно хватаю воздух."

# ch/harems_full/office/events/office_christmas_party.rpy:1144
translate russian office_christmas_mistletoe_kiss_317f4980:
    audrey.say "М-м-м..."

# ch/harems_full/office/events/office_christmas_party.rpy:1145
translate russian office_christmas_mistletoe_kiss_3c05a514:
    audrey.say "С Рождеством, [lssb_common.hero_name()]."

# ch/harems_full/office/events/office_christmas_party.rpy:1149
translate russian office_christmas_mistletoe_kiss_0da6cbeb:
    mike.say "Эм, Лавиш..."

# ch/harems_full/office/events/office_christmas_party.rpy:1150
translate russian office_christmas_mistletoe_kiss_80770ceb:
    mike.say "Посмотри наверх!"

# ch/harems_full/office/events/office_christmas_party.rpy:1152
translate russian office_christmas_mistletoe_kiss_ebc00de5:
    "Лавиш удивлённо моргает, словно я застал её врасплох."

# ch/harems_full/office/events/office_christmas_party.rpy:1153
translate russian office_christmas_mistletoe_kiss_d6a620ce:
    "Но всё же невольно поднимает взгляд вслед за мной."

# ch/harems_full/office/events/office_christmas_party.rpy:1154
translate russian office_christmas_mistletoe_kiss_e5ca786e:
    lavish.say "О..."

# ch/harems_full/office/events/office_christmas_party.rpy:1155
translate russian office_christmas_mistletoe_kiss_a1c1502b:
    lavish.say "Омела!"

# ch/harems_full/office/events/office_christmas_party.rpy:1156
translate russian office_christmas_mistletoe_kiss_1a8bed97:
    "Лавиш снова смотрит на меня и краснеет."

# ch/harems_full/office/events/office_christmas_party.rpy:1157
translate russian office_christmas_mistletoe_kiss_cf02fec8:
    "На её лице понимающая улыбка."

# ch/harems_full/office/events/office_christmas_party.rpy:1158
translate russian office_christmas_mistletoe_kiss_4b9dee60:
    "Но она, кажется, ещё и немного смущена."

# ch/harems_full/office/events/office_christmas_party.rpy:1159
translate russian office_christmas_mistletoe_kiss_8079d212:
    "И это сочетание ей очень идёт."

# ch/harems_full/office/events/office_christmas_party.rpy:1160
translate russian office_christmas_mistletoe_kiss_920fe010:
    "Она выглядит невероятно мило!"

# ch/harems_full/office/events/office_christmas_party.rpy:1162
translate russian office_christmas_mistletoe_kiss_52a87da1:
    lavish.say "Ты..."

# ch/harems_full/office/events/office_christmas_party.rpy:1163
translate russian office_christmas_mistletoe_kiss_2cc85820:
    lavish.say "Просишь у меня рождественский поцелуй, [lssb_common.hero_name()]?"

# ch/harems_full/office/events/office_christmas_party.rpy:1164
translate russian office_christmas_mistletoe_kiss_6da90f37:
    mike.say "Д-да, Лавиш."

# ch/harems_full/office/events/office_christmas_party.rpy:1165
translate russian office_christmas_mistletoe_kiss_04fdd9e8:
    mike.say "Пожалуй, да!"

# ch/harems_full/office/events/office_christmas_party.rpy:1166
translate russian office_christmas_mistletoe_kiss_ae5f822b:
    "Лавиш подзывает меня ближе."

# ch/harems_full/office/events/office_christmas_party.rpy:1170
translate russian office_christmas_mistletoe_kiss_db9d2fa4:
    "Затем встаёт на цыпочки, чтобы дотянуться."

# ch/harems_full/office/events/office_christmas_party.rpy:1171
translate russian office_christmas_mistletoe_kiss_b32d9de1:
    "Поначалу она нежно прижимается губами к моим."

# ch/harems_full/office/events/office_christmas_party.rpy:1172
translate russian office_christmas_mistletoe_kiss_304bd2ca:
    "Поцелуй довольно целомудренный и невинный."

# ch/harems_full/office/events/office_christmas_party.rpy:1173
translate russian office_christmas_mistletoe_kiss_e3df088f:
    "Но отчего-то у меня всё равно порхают бабочки в животе."

# ch/harems_full/office/events/office_christmas_party.rpy:1174
translate russian office_christmas_mistletoe_kiss_38074bb6:
    "А когда я чувствую язык Лавиш между своих губ..."

# ch/harems_full/office/events/office_christmas_party.rpy:1175
translate russian office_christmas_mistletoe_kiss_4a813d22:
    "Трудно описать, насколько сильно это меня волнует!"

# ch/harems_full/office/events/office_christmas_party.rpy:1176
translate russian office_christmas_mistletoe_kiss_3a444da3:
    "Лавиш, похоже, испытывает то же самое."

# ch/harems_full/office/events/office_christmas_party.rpy:1177
translate russian office_christmas_mistletoe_kiss_30cc6250:
    "Я понимаю это по тому, как смело она продолжает."

# ch/harems_full/office/events/office_christmas_party.rpy:1178
translate russian office_christmas_mistletoe_kiss_6d18dcc2:
    "Её руки обвивают мою шею, а мои — её талию."

# ch/harems_full/office/events/office_christmas_party.rpy:1179
translate russian office_christmas_mistletoe_kiss_ca691929:
    "И всё это время её язык исследует мой рот."

# ch/harems_full/office/events/office_christmas_party.rpy:1180
translate russian office_christmas_mistletoe_kiss_677ea5d3:
    "Когда Лавиш наконец отстраняется, я судорожно хватаю воздух."

# ch/harems_full/office/events/office_christmas_party.rpy:1183
translate russian office_christmas_mistletoe_kiss_e5ca786e_1:
    lavish.say "Ох..."

# ch/harems_full/office/events/office_christmas_party.rpy:1184
translate russian office_christmas_mistletoe_kiss_82ae7bc3:
    lavish.say "О боже..."

# ch/harems_full/office/events/office_christmas_party.rpy:1185
translate russian office_christmas_mistletoe_kiss_10911e90:
    lavish.say "С Рождеством, [lssb_common.hero_name()]."

# ch/harems_full/office/events/office_christmas_party.rpy:1189
translate russian office_christmas_mistletoe_kiss_d5300e8d:
    mike.say "Эм, Сиори..."

# ch/harems_full/office/events/office_christmas_party.rpy:1190
translate russian office_christmas_mistletoe_kiss_f8e08ff9:
    mike.say "Посмотри наверх!"

# ch/harems_full/office/events/office_christmas_party.rpy:1192
translate russian office_christmas_mistletoe_kiss_cab0d643:
    "Услышав мой голос, Сиори тут же замирает."

# ch/harems_full/office/events/office_christmas_party.rpy:1193
translate russian office_christmas_mistletoe_kiss_ffdd4cea:
    "И так же быстро поднимает взгляд."

# ch/harems_full/office/events/office_christmas_party.rpy:1194
translate russian office_christmas_mistletoe_kiss_80c00354:
    shiori.say "Чт..."

# ch/harems_full/office/events/office_christmas_party.rpy:1195
translate russian office_christmas_mistletoe_kiss_499c0343:
    shiori.say "Ой!"

# ch/harems_full/office/events/office_christmas_party.rpy:1196
translate russian office_christmas_mistletoe_kiss_54127ba7:
    shiori.say "Омела!"

# ch/harems_full/office/events/office_christmas_party.rpy:1198
translate russian office_christmas_mistletoe_kiss_ffbc0145:
    "Опустив глаза, Сиори тут же краснеет."

# ch/harems_full/office/events/office_christmas_party.rpy:1199
translate russian office_christmas_mistletoe_kiss_45220502:
    "И с трудом выдерживает мой взгляд!"

# ch/harems_full/office/events/office_christmas_party.rpy:1200
translate russian office_christmas_mistletoe_kiss_d783f573:
    mike.say "Сиори..."

# ch/harems_full/office/events/office_christmas_party.rpy:1201
translate russian office_christmas_mistletoe_kiss_d2413ce7:
    mike.say "Не хочешь..."

# ch/harems_full/office/events/office_christmas_party.rpy:1202
translate russian office_christmas_mistletoe_kiss_80a28220:
    shiori.say "Поцеловаться под омелой!"

# ch/harems_full/office/events/office_christmas_party.rpy:1203
translate russian office_christmas_mistletoe_kiss_527cf57c:
    shiori.say "О да, [lssb_common.hero_name()]!"

# ch/harems_full/office/events/office_christmas_party.rpy:1204
translate russian office_christmas_mistletoe_kiss_fffb37a6:
    shiori.say "Я с самого начала вечеринки ждала, когда ты предложишь!"

# ch/harems_full/office/events/office_christmas_party.rpy:1205
translate russian office_christmas_mistletoe_kiss_9239c21f:
    "Я наклоняюсь и мягко кладу руки Сиори на плечи."

# ch/harems_full/office/events/office_christmas_party.rpy:1206
translate russian office_christmas_mistletoe_kiss_e673b1ff:
    "Она встаёт на цыпочки навстречу мне."

# ch/harems_full/office/events/office_christmas_party.rpy:1210
translate russian office_christmas_mistletoe_kiss_f0baa7b5:
    "Поначалу наши губы соприкасаются мягко и нежно."

# ch/harems_full/office/events/office_christmas_party.rpy:1211
translate russian office_christmas_mistletoe_kiss_91d58cc8:
    "Я почти чувствую дрожь, пробегающую по телу Сиори."

# ch/harems_full/office/events/office_christmas_party.rpy:1212
translate russian office_christmas_mistletoe_kiss_efb0e4d2:
    "Она поднимает руки и обвивает ими мою шею."

# ch/harems_full/office/events/office_christmas_party.rpy:1213
translate russian office_christmas_mistletoe_kiss_19abe4ff:
    "Тогда я решаю рискнуть."

# ch/harems_full/office/events/office_christmas_party.rpy:1214
translate russian office_christmas_mistletoe_kiss_313dc64c:
    "Я проникаю языком ей в рот."

# ch/harems_full/office/events/office_christmas_party.rpy:1215
translate russian office_christmas_mistletoe_kiss_39441511:
    "Сиори стонет, не в силах скрыть восторг."

# ch/harems_full/office/events/office_christmas_party.rpy:1216
translate russian office_christmas_mistletoe_kiss_a3b8acd0:
    "А когда она отвечает тем же, становится ещё лучше."

# ch/harems_full/office/events/office_christmas_party.rpy:1217
translate russian office_christmas_mistletoe_kiss_63ac693f:
    "Страсть между нами разгорается с каждой секундой."

# ch/harems_full/office/events/office_christmas_party.rpy:1218
translate russian office_christmas_mistletoe_kiss_901ba62c:
    "Когда Сиори наконец отпускает меня, я судорожно хватаю воздух."

# ch/harems_full/office/events/office_christmas_party.rpy:1221
translate russian office_christmas_mistletoe_kiss_c102a48f:
    shiori.say "Ох..."

# ch/harems_full/office/events/office_christmas_party.rpy:1222
translate russian office_christmas_mistletoe_kiss_f86a3464:
    shiori.say "Ох, [lssb_common.hero_name()]..."

# ch/harems_full/office/events/office_christmas_party.rpy:1226
translate russian office_christmas_mistletoe_kiss_e368ae77:
    mike.say "А, Шери..."

# ch/harems_full/office/events/office_christmas_party.rpy:1227
translate russian office_christmas_mistletoe_kiss_80770ceb_1:
    mike.say "Посмотрите наверх!"

# ch/harems_full/office/events/office_christmas_party.rpy:1229
translate russian office_christmas_mistletoe_kiss_2e1ab2ff:
    "Шери поворачивается и удивлённо поднимает глаза."

# ch/harems_full/office/events/office_christmas_party.rpy:1230
translate russian office_christmas_mistletoe_kiss_910edf80:
    "Ей требуется мгновение, чтобы заметить над головой веточку омелы."

# ch/harems_full/office/events/office_christmas_party.rpy:1232
translate russian office_christmas_mistletoe_kiss_489b0358:
    "Она снова смотрит на меня, слегка краснея."

# ch/harems_full/office/events/office_christmas_party.rpy:1233
translate russian office_christmas_mistletoe_kiss_122e87e2:
    "Её реакция такая искренняя, неожиданная и даже немного беззащитная."

# ch/harems_full/office/events/office_christmas_party.rpy:1234
translate russian office_christmas_mistletoe_kiss_cc148635:
    "И сразу трогает меня до глубины души."

# ch/harems_full/office/events/office_christmas_party.rpy:1236
translate russian office_christmas_mistletoe_kiss_ffc4bdbf:
    cherie.say "А, понимаю..."

# ch/harems_full/office/events/office_christmas_party.rpy:1237
translate russian office_christmas_mistletoe_kiss_dc1e16d0:
    cherie.say "Омела!"

# ch/harems_full/office/events/office_christmas_party.rpy:1239
translate russian office_christmas_mistletoe_kiss_d058b8d6:
    mike.say "И... ну..."

# ch/harems_full/office/events/office_christmas_party.rpy:1240
translate russian office_christmas_mistletoe_kiss_adcef5b3:
    mike.say "Вы ведь знаете традицию?"

# ch/harems_full/office/events/office_christmas_party.rpy:1242
translate russian office_christmas_mistletoe_kiss_e6f8e1f0:
    "Шери притворно хмурится и склоняет голову набок."

# ch/harems_full/office/events/office_christmas_party.rpy:1244
translate russian office_christmas_mistletoe_kiss_e0161f06:
    cherie.say "Постойте..."

# ch/harems_full/office/events/office_christmas_party.rpy:1245
translate russian office_christmas_mistletoe_kiss_e200e395:
    cherie.say "Вы просите меня о поцелуе?"

# ch/harems_full/office/events/office_christmas_party.rpy:1247
translate russian office_christmas_mistletoe_kiss_19483e5a:
    mike.say "Не то чтобы прошу..."

# ch/harems_full/office/events/office_christmas_party.rpy:1248
translate russian office_christmas_mistletoe_kiss_1a78c27e:
    mike.say "Скорее интересуюсь..."

# ch/harems_full/office/events/office_christmas_party.rpy:1249
translate russian office_christmas_mistletoe_kiss_caf6f404:
    mike.say "Так сказать, прощупываю почву..."

# ch/harems_full/office/events/office_christmas_party.rpy:1251
translate russian office_christmas_mistletoe_kiss_2419f520:
    "Шери смеётся и обвивает руками мою шею."

# ch/harems_full/office/events/office_christmas_party.rpy:1255
translate russian office_christmas_mistletoe_kiss_402c9eb4:
    "А затем прижимается губами к моим."

# ch/harems_full/office/events/office_christmas_party.rpy:1256
translate russian office_christmas_mistletoe_kiss_3a30c939:
    "Поначалу она целует меня нежно."

# ch/harems_full/office/events/office_christmas_party.rpy:1257
translate russian office_christmas_mistletoe_kiss_081a5cba:
    "Но потом я чувствую, как она прижимается ко мне всем телом."

# ch/harems_full/office/events/office_christmas_party.rpy:1258
translate russian office_christmas_mistletoe_kiss_d400cebb:
    "Одновременно её язык медленно проникает между моих губ."

# ch/harems_full/office/events/office_christmas_party.rpy:1259
translate russian office_christmas_mistletoe_kiss_34d6019e:
    "Я отвечаю ей, притягивая всё ближе."

# ch/harems_full/office/events/office_christmas_party.rpy:1260
translate russian office_christmas_mistletoe_kiss_29003c75:
    "Из-за этого поцелуй становится всё жарче."

# ch/harems_full/office/events/office_christmas_party.rpy:1261
translate russian office_christmas_mistletoe_kiss_1f74dff5:
    "И вскоре она уже почти задыхается в моих объятиях."

# ch/harems_full/office/events/office_christmas_party.rpy:1265
translate russian office_christmas_mistletoe_kiss_88a3542f:
    "Когда Шери наконец отстраняется, я судорожно хватаю воздух."

# ch/harems_full/office/events/office_christmas_party.rpy:1267
translate russian office_christmas_mistletoe_kiss_f169d7c6:
    cherie.say "Ох..."

# ch/harems_full/office/events/office_christmas_party.rpy:1268
translate russian office_christmas_mistletoe_kiss_295ae857:
    cherie.say "Ничего себе... кажется, я немного увлеклась!"

# ch/harems_full/office/events/office_christmas_party.rpy:1269
translate russian office_christmas_mistletoe_kiss_6f7fc977:
    cherie.say "С Рождеством, [lssb_common.hero_name()]!"

# ch/harems_full/office/events/office_christmas_party.rpy:1284
translate russian office_christmas_dwayne_antics_f0463472:
    "Вечеринка в самом разгаре: все танцуют и весело болтают."

# ch/harems_full/office/events/office_christmas_party.rpy:1285
translate russian office_christmas_dwayne_antics_c3edc075:
    "И во многом это хорошее настроение объясняется щедрыми запасами алкоголя."

# ch/harems_full/office/events/office_christmas_party.rpy:1286
translate russian office_christmas_dwayne_antics_e1e25ec8:
    "Надо признать, в этом году Дуэйн не поскупился на бюджет."

# ch/harems_full/office/events/office_christmas_party.rpy:1287
translate russian office_christmas_dwayne_antics_a8ed9cc1:
    "Но, судя по виду, сам он тоже ни в чём себе не отказывает!"

# ch/harems_full/office/events/office_christmas_party.rpy:1288
translate russian office_christmas_dwayne_antics_f5dec2d4:
    "Я вижу его в другом конце комнаты: он громко смеётся и шутит."

# ch/harems_full/office/events/office_christmas_party.rpy:1289
translate russian office_christmas_dwayne_antics_2ea95085:
    "Он хорошо это скрывает, но я знаю его достаточно, чтобы понять: он изрядно пьян."

# ch/harems_full/office/events/office_christmas_party.rpy:1290
translate russian office_christmas_dwayne_antics_a8d13192:
    "Вдруг он замечает что-то интересное."

# ch/harems_full/office/events/office_christmas_party.rpy:1291
translate russian office_christmas_dwayne_antics_f5c695dc:
    "И, ни с кем не попрощавшись, нетвёрдой походкой направляется туда."

# ch/harems_full/office/events/office_christmas_party.rpy:1292
translate russian office_christmas_dwayne_antics_836147f0:
    "Почему-то мне кажется, что это не к добру."

# ch/harems_full/office/events/office_christmas_party.rpy:1293
translate russian office_christmas_dwayne_antics_a0512989:
    "Я иду за Дуэйном, стараясь не попадаться ему на глаза."

# ch/harems_full/office/events/office_christmas_party.rpy:1294
translate russian office_christmas_dwayne_antics_41b84310:
    "И вскоре он приводит меня к тому, что заметил."

# ch/harems_full/office/events/office_christmas_party.rpy:1295
translate russian office_christmas_dwayne_antics_7652dfff:
    "Точнее, к той..."

# ch/harems_full/office/events/office_christmas_party.rpy:1302
translate russian office_christmas_dwayne_antics_9069987a:
    "Я наблюдаю, как Дуэйн подходит к Алетте."

# ch/harems_full/office/events/office_christmas_party.rpy:1304
translate russian office_christmas_dwayne_antics_58bbb0b7:
    dwayne.say "Эй, Алетта!"

# ch/harems_full/office/events/office_christmas_party.rpy:1305
translate russian office_christmas_dwayne_antics_1df84f03:
    dwayne.say "На улице холодно."

# ch/harems_full/office/events/office_christmas_party.rpy:1306
translate russian office_christmas_dwayne_antics_b510a7a7:
    dwayne.say "А ты, как всегда, горячая штучка!"

# ch/harems_full/office/events/office_christmas_party.rpy:1308
translate russian office_christmas_dwayne_antics_cc6c398d:
    "Алетта закатывает глаза от избитой фразы."

# ch/harems_full/office/events/office_christmas_party.rpy:1309
translate russian office_christmas_dwayne_antics_80a5b21d:
    "Но я вижу, что она пытается скрыть отвращение."

# ch/harems_full/office/events/office_christmas_party.rpy:1310
translate russian office_christmas_dwayne_antics_04edb127:
    aletta.say "По-моему, ты перебрал, Дуэйн."

# ch/harems_full/office/events/office_christmas_party.rpy:1311
translate russian office_christmas_dwayne_antics_9f363f19:
    aletta.say "Может, возьмёшь что-нибудь с фуршетного стола?"

# ch/harems_full/office/events/office_christmas_party.rpy:1312
translate russian office_christmas_dwayne_antics_ed029aa6:
    aletta.say "Еда хоть немного впитает выпивку."

# ch/harems_full/office/events/office_christmas_party.rpy:1313
translate russian office_christmas_dwayne_antics_64578fed:
    "Ответ Алетты кажется Дуэйну невероятно смешным."

# ch/harems_full/office/events/office_christmas_party.rpy:1314
translate russian office_christmas_dwayne_antics_16c43bd9:
    "Он хохочет и качает головой."

# ch/harems_full/office/events/office_christmas_party.rpy:1315
translate russian office_christmas_dwayne_antics_2a4c61d7:
    "А потом наклоняется к ней ещё ближе."

# ch/harems_full/office/events/office_christmas_party.rpy:1316
translate russian office_christmas_dwayne_antics_72bd2dc7:
    dwayne.say "Знаешь что, Алетта?"

# ch/harems_full/office/events/office_christmas_party.rpy:1317
translate russian office_christmas_dwayne_antics_3646276e:
    dwayne.say "Думаю, тебе стоит самой последовать этому совету."

# ch/harems_full/office/events/office_christmas_party.rpy:1318
translate russian office_christmas_dwayne_antics_a4eae6e3:
    dwayne.say "Как насчёт ненадолго зайти ко мне в кабинет?"

# ch/harems_full/office/events/office_christmas_party.rpy:1319
translate russian office_christmas_dwayne_antics_d86d7cdc:
    dwayne.say "У меня там для тебя есть кое-что особенное, чем можно полакомиться!"

# ch/harems_full/office/events/office_christmas_party.rpy:1320
translate russian office_christmas_dwayne_antics_a4dce06a:
    "Алетта смотрит по сторонам."

# ch/harems_full/office/events/office_christmas_party.rpy:1321
translate russian office_christmas_dwayne_antics_af078e5d:
    "Ясно, что она ищет способ выбраться."

# ch/harems_full/office/events/office_christmas_party.rpy:1322
translate russian office_christmas_dwayne_antics_cb1f7667:
    "И тут её взгляд падает на меня."

# ch/harems_full/office/events/office_christmas_party.rpy:1324
translate russian office_christmas_dwayne_antics_ef837137:
    "Глаза Алетты расширяются в безмолвной просьбе о помощи."

# ch/harems_full/office/events/office_christmas_party.rpy:1327
translate russian office_christmas_dwayne_antics_c8c2dda4:
    "Я знаю, что Алетта отлично умеет за себя постоять."

# ch/harems_full/office/events/office_christmas_party.rpy:1328
translate russian office_christmas_dwayne_antics_14aedc69:
    "Если она просит о помощи, значит, дело серьёзное!"

# ch/harems_full/office/events/office_christmas_party.rpy:1329
translate russian office_christmas_dwayne_antics_70585966:
    "Понятия не имею, что буду делать или говорить."

# ch/harems_full/office/events/office_christmas_party.rpy:1330
translate russian office_christmas_dwayne_antics_05d807ea:
    "Но всё равно спешу к ним."

# ch/harems_full/office/events/office_christmas_party.rpy:1331
translate russian office_christmas_dwayne_antics_97e8d277:
    mike.say "Эй, Дуэйн!"

# ch/harems_full/office/events/office_christmas_party.rpy:1332
translate russian office_christmas_dwayne_antics_f1ca2079:
    mike.say "Кто-то говорил про фуршет?!"

# ch/harems_full/office/events/office_christmas_party.rpy:1333
translate russian office_christmas_dwayne_antics_ce13483b:
    "Дуэйн растерянно поворачивается ко мне."

# ch/harems_full/office/events/office_christmas_party.rpy:1334
translate russian office_christmas_dwayne_antics_91962f12:
    dwayne.say "А?"

# ch/harems_full/office/events/office_christmas_party.rpy:1335
translate russian office_christmas_dwayne_antics_89a8ca5b:
    mike.say "Там такое — не увидишь, не поверишь!"

# ch/harems_full/office/events/office_christmas_party.rpy:1336
translate russian office_christmas_dwayne_antics_b264f0ac:
    mike.say "Пойдёмте, я уже отложил вам тарелку."

# ch/harems_full/office/events/office_christmas_party.rpy:1337
translate russian office_christmas_dwayne_antics_b0be8147:
    mike.say "Нужно поесть, пока всё не разобрали!"

# ch/harems_full/office/events/office_christmas_party.rpy:1338
translate russian office_christmas_dwayne_antics_deb8362e:
    "Пьяный Дуэйн позволяет увести себя от Алетты."

# ch/harems_full/office/events/office_christmas_party.rpy:1339
translate russian office_christmas_dwayne_antics_ea43109d:
    "В конце концов, что ему остаётся?"

# ch/harems_full/office/events/office_christmas_party.rpy:1340
translate russian office_christmas_dwayne_antics_d25f2da0:
    "Отругать меня и потребовать отпустить его обратно приставать к ней?"

# ch/harems_full/office/events/office_christmas_party.rpy:1341
translate russian office_christmas_dwayne_antics_49185c54:
    "Я на миг оглядываюсь через плечо."

# ch/harems_full/office/events/office_christmas_party.rpy:1345
translate russian office_christmas_dwayne_antics_8b2fa32f:
    "И вижу, как Алетта с облегчением одними губами произносит: «Спасибо»."

# ch/harems_full/office/events/office_christmas_party.rpy:1347
translate russian office_christmas_dwayne_antics_2e1ec0f7:
    "Не собираюсь влезать в эту историю."

# ch/harems_full/office/events/office_christmas_party.rpy:1348
translate russian office_christmas_dwayne_antics_894b555c:
    "Алетта прекрасно умеет за себя постоять."

# ch/harems_full/office/events/office_christmas_party.rpy:1349
translate russian office_christmas_dwayne_antics_51e7dc89:
    "Я как можно скорее отвожу взгляд."

# ch/harems_full/office/events/office_christmas_party.rpy:1350
translate russian office_christmas_dwayne_antics_a0ea02d9:
    "И стараюсь сделать вид, что не понял её намёка."

# ch/harems_full/office/events/office_christmas_party.rpy:1351
translate russian office_christmas_dwayne_antics_348e596e:
    "Уходя, я напоследок замечаю выражение лица Алетты."

# ch/harems_full/office/events/office_christmas_party.rpy:1352
translate russian office_christmas_dwayne_antics_07936944:
    "Как я ни старался, она прекрасно поняла, что я бросил её в беде."

# ch/harems_full/office/events/office_christmas_party.rpy:1357
translate russian office_christmas_dwayne_antics_a76ba06b:
    "Я наблюдаю, как Дуэйн подходит к Одри."

# ch/harems_full/office/events/office_christmas_party.rpy:1359
translate russian office_christmas_dwayne_antics_5b16bbfa:
    dwayne.say "Эй, Одри!"

# ch/harems_full/office/events/office_christmas_party.rpy:1360
translate russian office_christmas_dwayne_antics_6cb8ce15:
    dwayne.say "Я за тобой внимательно наблюдал."

# ch/harems_full/office/events/office_christmas_party.rpy:1361
translate russian office_christmas_dwayne_antics_faccc44a:
    dwayne.say "И вижу, что ты любишь повеселиться, верно?"

# ch/harems_full/office/events/office_christmas_party.rpy:1363
translate russian office_christmas_dwayne_antics_e72309d9:
    "Одри смотрит на Дуэйна с едва сдерживаемым отвращением."

# ch/harems_full/office/events/office_christmas_party.rpy:1364
translate russian office_christmas_dwayne_antics_1d2fc1cc:
    "Возможно, он ближе к истине, чем сам думает."

# ch/harems_full/office/events/office_christmas_party.rpy:1365
translate russian office_christmas_dwayne_antics_5226f40a:
    "Но у Одри всё же есть самоуважение."

# ch/harems_full/office/events/office_christmas_party.rpy:1366
translate russian office_christmas_dwayne_antics_b03fc50c:
    "Так что его пьяные приставания, конечно, её оскорбляют."

# ch/harems_full/office/events/office_christmas_party.rpy:1367
translate russian office_christmas_dwayne_antics_0be9e048:
    audrey.say "По-моему, вы что-то путаете."

# ch/harems_full/office/events/office_christmas_party.rpy:1368
translate russian office_christmas_dwayne_antics_7df38a3b:
    audrey.say "Потому что я понятия не имею, о чём вы!"

# ch/harems_full/office/events/office_christmas_party.rpy:1369
translate russian office_christmas_dwayne_antics_2deaf675:
    "Это нисколько не смущает Дуэйна."

# ch/harems_full/office/events/office_christmas_party.rpy:1370
translate russian office_christmas_dwayne_antics_3857992c:
    "Более того, он, кажется, принимает её слова за поощрение."

# ch/harems_full/office/events/office_christmas_party.rpy:1371
translate russian office_christmas_dwayne_antics_e6dc11b7:
    dwayne.say "Да брось, Одри."

# ch/harems_full/office/events/office_christmas_party.rpy:1372
translate russian office_christmas_dwayne_antics_816e0c5f:
    dwayne.say "Уж офисную шлюху я сразу узнаю!"

# ch/harems_full/office/events/office_christmas_party.rpy:1373
translate russian office_christmas_dwayne_antics_88182ee7:
    dwayne.say "Я просто хочу, чтобы и моя очередь до тебя дошла!"

# ch/harems_full/office/events/office_christmas_party.rpy:1374
translate russian office_christmas_dwayne_antics_2b688e5c:
    "Одри смотрит по сторонам."

# ch/harems_full/office/events/office_christmas_party.rpy:1375
translate russian office_christmas_dwayne_antics_af078e5d_1:
    "Ясно, что она ищет способ выбраться."

# ch/harems_full/office/events/office_christmas_party.rpy:1376
translate russian office_christmas_dwayne_antics_cb1f7667_1:
    "И тут её взгляд падает на меня."

# ch/harems_full/office/events/office_christmas_party.rpy:1378
translate russian office_christmas_dwayne_antics_7691cc5a:
    "Глаза Одри расширяются в безмолвной просьбе о помощи."

# ch/harems_full/office/events/office_christmas_party.rpy:1381
translate russian office_christmas_dwayne_antics_896d6ed4:
    "Я прекрасно знаю, что Одри умеет за себя постоять."

# ch/harems_full/office/events/office_christmas_party.rpy:1382
translate russian office_christmas_dwayne_antics_8a865bf9:
    "Так что если она просит о помощи, значит, ей действительно тяжело."

# ch/harems_full/office/events/office_christmas_party.rpy:1383
translate russian office_christmas_dwayne_antics_cb3ca59b:
    "Я спешу к ним, проталкиваясь сквозь толпу."

# ch/harems_full/office/events/office_christmas_party.rpy:1384
translate russian office_christmas_dwayne_antics_e6fc3d65:
    "До последнего лихорадочно пытаюсь придумать план."

# ch/harems_full/office/events/office_christmas_party.rpy:1385
translate russian office_christmas_dwayne_antics_e42f2ac8:
    mike.say "Эй, Одри!"

# ch/harems_full/office/events/office_christmas_party.rpy:1386
translate russian office_christmas_dwayne_antics_f5471d42:
    mike.say "Я нашёл свободную кладовку с канцтоварами!"

# ch/harems_full/office/events/office_christmas_party.rpy:1387
translate russian office_christmas_dwayne_antics_c9ebd334:
    mike.say "Можем пойти и..."

# ch/harems_full/office/events/office_christmas_party.rpy:1388
translate russian office_christmas_dwayne_antics_3ae78214:
    mike.say "О... здравствуйте, Дуэйн!"

# ch/harems_full/office/events/office_christmas_party.rpy:1390
translate russian office_christmas_dwayne_antics_cdac5f41:
    "И Дуэйн, и Одри ошарашены и растеряны моим появлением."

# ch/harems_full/office/events/office_christmas_party.rpy:1391
translate russian office_christmas_dwayne_antics_1ba18dc4:
    "К счастью, Одри соображает быстрее."

# ch/harems_full/office/events/office_christmas_party.rpy:1392
translate russian office_christmas_dwayne_antics_3fced8f8:
    audrey.say "А... а, да!"

# ch/harems_full/office/events/office_christmas_party.rpy:1393
translate russian office_christmas_dwayne_antics_ad95462d:
    audrey.say "Кладовка с канцтоварами!"

# ch/harems_full/office/events/office_christmas_party.rpy:1394
translate russian office_christmas_dwayne_antics_f99c6b82:
    "Она выразительно мне подмигивает."

# ch/harems_full/office/events/office_christmas_party.rpy:1395
translate russian office_christmas_dwayne_antics_e5b60207:
    "И я подмигиваю в ответ."

# ch/harems_full/office/events/office_christmas_party.rpy:1396
translate russian office_christmas_dwayne_antics_95f8615c:
    dwayne.say "А, теперь понятно, что тут происходит!"

# ch/harems_full/office/events/office_christmas_party.rpy:1397
translate russian office_christmas_dwayne_antics_fc58df5e:
    "Дуэйн кивает и улыбается."

# ch/harems_full/office/events/office_christmas_party.rpy:1398
translate russian office_christmas_dwayne_antics_88e2c4a8:
    dwayne.say "Прости, [lssb_common.hero_name()]."

# ch/harems_full/office/events/office_christmas_party.rpy:1399
translate russian office_christmas_dwayne_antics_1c2fd077:
    dwayne.say "Не знал, что она уже занята!"

# ch/harems_full/office/events/office_christmas_party.rpy:1400
translate russian office_christmas_dwayne_antics_925433bd:
    "Он одаривает меня сальной ухмылкой и уходит."

# ch/harems_full/office/events/office_christmas_party.rpy:1405
translate russian office_christmas_dwayne_antics_c886b748:
    "Мы с Одри наконец можем вздохнуть с облегчением."

# ch/harems_full/office/events/office_christmas_party.rpy:1406
translate russian office_christmas_dwayne_antics_a671726a:
    mike.say "Прости за это, Одри."

# ch/harems_full/office/events/office_christmas_party.rpy:1407
translate russian office_christmas_dwayne_antics_bf75673a:
    mike.say "Пришлось импровизировать на ходу!"

# ch/harems_full/office/events/office_christmas_party.rpy:1409
translate russian office_christmas_dwayne_antics_48c3cde8:
    audrey.say "Ничего страшного, [lssb_common.hero_name()]."

# ch/harems_full/office/events/office_christmas_party.rpy:1410
translate russian office_christmas_dwayne_antics_f1e5e910:
    audrey.say "На самом деле свободной кладовки нет, да?"

# ch/harems_full/office/events/office_christmas_party.rpy:1411
translate russian office_christmas_dwayne_antics_cdd3acae:
    mike.say "Эм... нет."

# ch/harems_full/office/events/office_christmas_party.rpy:1412
translate russian office_christmas_dwayne_antics_6ff51677:
    audrey.say "Жаль..."

# ch/harems_full/office/events/office_christmas_party.rpy:1414
translate russian office_christmas_dwayne_antics_98da4ef0:
    "Если бы Одри не флиртовала здесь направо и налево..."

# ch/harems_full/office/events/office_christmas_party.rpy:1415
translate russian office_christmas_dwayne_antics_aedcfddf:
    "Может, и не оказалась бы сейчас в такой передряге."

# ch/harems_full/office/events/office_christmas_party.rpy:1416
translate russian office_christmas_dwayne_antics_51e7dc89_1:
    "Я как можно скорее отвожу взгляд."

# ch/harems_full/office/events/office_christmas_party.rpy:1417
translate russian office_christmas_dwayne_antics_a0ea02d9_1:
    "И стараюсь сделать вид, что не понял её намёка."

# ch/harems_full/office/events/office_christmas_party.rpy:1418
translate russian office_christmas_dwayne_antics_07b2b00c:
    "Уходя, я напоследок замечаю выражение лица Одри."

# ch/harems_full/office/events/office_christmas_party.rpy:1420
translate russian office_christmas_dwayne_antics_07936944_1:
    "Как я ни старался, она прекрасно поняла, что я бросил её в беде."

# ch/harems_full/office/events/office_christmas_party.rpy:1424
translate russian office_christmas_dwayne_antics_337b0dca:
    "Я наблюдаю, как Дуэйн подходит к Лавиш."

# ch/harems_full/office/events/office_christmas_party.rpy:1426
translate russian office_christmas_dwayne_antics_052c6ec3:
    dwayne.say "Эй, Лавиш!"

# ch/harems_full/office/events/office_christmas_party.rpy:1427
translate russian office_christmas_dwayne_antics_b0b26ac4:
    dwayne.say "У тебя ведь серьёзные карьерные планы, да?"

# ch/harems_full/office/events/office_christmas_party.rpy:1428
translate russian office_christmas_dwayne_antics_29fa7bdb:
    dwayne.say "Думаю, нам стоит обсудить их у меня в кабинете."

# ch/harems_full/office/events/office_christmas_party.rpy:1430
translate russian office_christmas_dwayne_antics_6f5ef2f6:
    "Лавиш тут же приходит в ужас от поведения Дуэйна."

# ch/harems_full/office/events/office_christmas_party.rpy:1431
translate russian office_christmas_dwayne_antics_7c945128:
    "Он наклоняется к ней вплотную, вторгаясь в личное пространство."

# ch/harems_full/office/events/office_christmas_party.rpy:1432
translate russian office_christmas_dwayne_antics_677f1319:
    "От его поведения за версту несёт непрофессионализмом."

# ch/harems_full/office/events/office_christmas_party.rpy:1433
translate russian office_christmas_dwayne_antics_b78d867c:
    "А всего этого Лавиш терпеть не может."

# ch/harems_full/office/events/office_christmas_party.rpy:1434
translate russian office_christmas_dwayne_antics_840a82cd:
    lavish.say "Мистер Джексон..."

# ch/harems_full/office/events/office_christmas_party.rpy:1435
translate russian office_christmas_dwayne_antics_be405498:
    lavish.say "По-моему, сейчас не время и не место!"

# ch/harems_full/office/events/office_christmas_party.rpy:1436
translate russian office_christmas_dwayne_antics_83b1d477:
    lavish.say "И вы ведёте себя недопустимо!"

# ch/harems_full/office/events/office_christmas_party.rpy:1437
translate russian office_christmas_dwayne_antics_b418f717:
    "Дуэйна это, похоже, нисколько не смущает."

# ch/harems_full/office/events/office_christmas_party.rpy:1438
translate russian office_christmas_dwayne_antics_abb0aa89:
    "Более того, он считает, что Лавиш просто строит недотрогу!"

# ch/harems_full/office/events/office_christmas_party.rpy:1439
translate russian office_christmas_dwayne_antics_504ef763:
    dwayne.say "Да брось, Лавиш."

# ch/harems_full/office/events/office_christmas_party.rpy:1440
translate russian office_christmas_dwayne_antics_788fd761:
    dwayne.say "Это твой шанс подняться повыше."

# ch/harems_full/office/events/office_christmas_party.rpy:1441
translate russian office_christmas_dwayne_antics_4a5c0399:
    dwayne.say "Нужно лишь сначала опуститься и отсосать мне!"

# ch/harems_full/office/events/office_christmas_party.rpy:1442
translate russian office_christmas_dwayne_antics_d41208a6:
    "Лавиш смотрит по сторонам."

# ch/harems_full/office/events/office_christmas_party.rpy:1443
translate russian office_christmas_dwayne_antics_af078e5d_2:
    "Ясно, что она ищет способ выбраться."

# ch/harems_full/office/events/office_christmas_party.rpy:1444
translate russian office_christmas_dwayne_antics_cb1f7667_2:
    "И тут её взгляд падает на меня."

# ch/harems_full/office/events/office_christmas_party.rpy:1446
translate russian office_christmas_dwayne_antics_d292e1b7:
    "Глаза Лавиш расширяются в безмолвной просьбе о помощи."

# ch/harems_full/office/events/office_christmas_party.rpy:1449
translate russian office_christmas_dwayne_antics_6f21f858:
    "Я прекрасно знаю, что Лавиш умеет за себя постоять."

# ch/harems_full/office/events/office_christmas_party.rpy:1450
translate russian office_christmas_dwayne_antics_8a865bf9_1:
    "Так что если она просит о помощи, значит, ей действительно тяжело."

# ch/harems_full/office/events/office_christmas_party.rpy:1451
translate russian office_christmas_dwayne_antics_cb3ca59b_1:
    "Я спешу к ним, проталкиваясь сквозь толпу."

# ch/harems_full/office/events/office_christmas_party.rpy:1452
translate russian office_christmas_dwayne_antics_e6fc3d65_1:
    "До последнего лихорадочно пытаюсь придумать план."

# ch/harems_full/office/events/office_christmas_party.rpy:1453
translate russian office_christmas_dwayne_antics_b21975c1:
    mike.say "Эй, Лавиш!"

# ch/harems_full/office/events/office_christmas_party.rpy:1454
translate russian office_christmas_dwayne_antics_e345ca04:
    mike.say "Мой друг обратился к тому адвокату, которого ты посоветовала."

# ch/harems_full/office/events/office_christmas_party.rpy:1455
translate russian office_christmas_dwayne_antics_b7a21624:
    mike.say "И тот его начальнику задницу порвал!"

# ch/harems_full/office/events/office_christmas_party.rpy:1457
translate russian office_christmas_dwayne_antics_462b2ba9:
    "И Дуэйн, и Лавиш ошарашены и растеряны моим появлением."

# ch/harems_full/office/events/office_christmas_party.rpy:1458
translate russian office_christmas_dwayne_antics_7e74f3cd:
    "К счастью, Лавиш соображает быстрее."

# ch/harems_full/office/events/office_christmas_party.rpy:1460
translate russian office_christmas_dwayne_antics_e3a166fa:
    lavish.say "А... а, да!"

# ch/harems_full/office/events/office_christmas_party.rpy:1461
translate russian office_christmas_dwayne_antics_e1779739:
    lavish.say "Он настоящий профессионал!"

# ch/harems_full/office/events/office_christmas_party.rpy:1462
translate russian office_christmas_dwayne_antics_44df8fe8:
    lavish.say "Начальников, которые позволяют себе лишнее, он живьём съедает!"

# ch/harems_full/office/events/office_christmas_party.rpy:1463
translate russian office_christmas_dwayne_antics_e24d9244:
    "Я смотрю на Дуэйна, делая вид, что только что его заметил."

# ch/harems_full/office/events/office_christmas_party.rpy:1464
translate russian office_christmas_dwayne_antics_96cd78de:
    mike.say "О, здравствуйте, Дуэйн!"

# ch/harems_full/office/events/office_christmas_party.rpy:1465
translate russian office_christmas_dwayne_antics_0cde015e:
    mike.say "Простите, что заговорил о начальниках, которых обдирают до нитки."

# ch/harems_full/office/events/office_christmas_party.rpy:1466
translate russian office_christmas_dwayne_antics_6fefc338:
    mike.say "Но вы-то из хороших, верно?"

# ch/harems_full/office/events/office_christmas_party.rpy:1467
translate russian office_christmas_dwayne_antics_392d66ef:
    mike.say "Вам можно не бояться, что после суда даже штанов не останется!"

# ch/harems_full/office/events/office_christmas_party.rpy:1468
translate russian office_christmas_dwayne_antics_2891a37c:
    "Дуэйн кивает, словно мгновенно протрезвев."

# ch/harems_full/office/events/office_christmas_party.rpy:1469
translate russian office_christmas_dwayne_antics_dc5a956a:
    dwayne.say "Д-да, конечно!"

# ch/harems_full/office/events/office_christmas_party.rpy:1470
translate russian office_christmas_dwayne_antics_3e99bb87:
    dwayne.say "Я же не из этих мерзких козлов!"

# ch/harems_full/office/events/office_christmas_party.rpy:1471
translate russian office_christmas_dwayne_antics_fec65f77:
    dwayne.say "Ни за что!"

# ch/harems_full/office/events/office_christmas_party.rpy:1472
translate russian office_christmas_dwayne_antics_2e6d6026:
    "Он натянуто улыбается мне и поспешно уходит."

# ch/harems_full/office/events/office_christmas_party.rpy:1477
translate russian office_christmas_dwayne_antics_a780d127:
    "Мы с Лавиш наконец можем вздохнуть с облегчением."

# ch/harems_full/office/events/office_christmas_party.rpy:1478
translate russian office_christmas_dwayne_antics_1f03e314:
    mike.say "Прости за это, Лавиш."

# ch/harems_full/office/events/office_christmas_party.rpy:1479
translate russian office_christmas_dwayne_antics_bf75673a_1:
    mike.say "Пришлось импровизировать на ходу!"

# ch/harems_full/office/events/office_christmas_party.rpy:1481
translate russian office_christmas_dwayne_antics_230d526b:
    lavish.say "Ничего страшного, [lssb_common.hero_name()]."

# ch/harems_full/office/events/office_christmas_party.rpy:1482
translate russian office_christmas_dwayne_antics_1859c595:
    lavish.say "Я твоя должница!"

# ch/harems_full/office/events/office_christmas_party.rpy:1484
translate russian office_christmas_dwayne_antics_8d6e0212:
    "Если Лавиш хочет пробиться наверх, ей придётся сделать это самой."

# ch/harems_full/office/events/office_christmas_party.rpy:1485
translate russian office_christmas_dwayne_antics_db17c5ab:
    "И разбираться с такими вещами ей всё равно придётся."

# ch/harems_full/office/events/office_christmas_party.rpy:1486
translate russian office_christmas_dwayne_antics_51e7dc89_2:
    "Я как можно скорее отвожу взгляд."

# ch/harems_full/office/events/office_christmas_party.rpy:1487
translate russian office_christmas_dwayne_antics_a0ea02d9_2:
    "И стараюсь сделать вид, что не понял её намёка."

# ch/harems_full/office/events/office_christmas_party.rpy:1488
translate russian office_christmas_dwayne_antics_905ed249:
    "Уходя, я напоследок замечаю выражение лица Лавиш."

# ch/harems_full/office/events/office_christmas_party.rpy:1489
translate russian office_christmas_dwayne_antics_07936944_2:
    "Как я ни старался, она прекрасно поняла, что я бросил её в беде."

# ch/harems_full/office/events/office_christmas_party.rpy:1494
translate russian office_christmas_dwayne_antics_bbab5095:
    "Я наблюдаю, как Дуэйн подходит к Сиори."

# ch/harems_full/office/events/office_christmas_party.rpy:1496
translate russian office_christmas_dwayne_antics_7f057540:
    dwayne.say "Эй, Сиори!"

# ch/harems_full/office/events/office_christmas_party.rpy:1497
translate russian office_christmas_dwayne_antics_6de3c07e:
    dwayne.say "Знаешь, что говорят про Рождество?"

# ch/harems_full/office/events/office_christmas_party.rpy:1498
translate russian office_christmas_dwayne_antics_fae10e92:
    dwayne.say "Про доброту к ближнему и всё такое?"

# ch/harems_full/office/events/office_christmas_party.rpy:1499
translate russian office_christmas_dwayne_antics_60ff6894:
    dwayne.say "Вот я гляжу на твои прелести — и мне уже хорошо!"

# ch/harems_full/office/events/office_christmas_party.rpy:1501
translate russian office_christmas_dwayne_antics_999cbcec:
    "Сиори буквально подпрыгивает, когда перед ней появляется Дуэйн."

# ch/harems_full/office/events/office_christmas_party.rpy:1502
translate russian office_christmas_dwayne_antics_17534d52:
    "Он нависает над ней, словно великан из сказки."

# ch/harems_full/office/events/office_christmas_party.rpy:1503
translate russian office_christmas_dwayne_antics_825fbc56:
    "А она слишком напугана, чтобы повернуться к нему спиной и сбежать."

# ch/harems_full/office/events/office_christmas_party.rpy:1504
translate russian office_christmas_dwayne_antics_f35bf32b:
    shiori.say "Ч-чего вы хотите, мистер Джексон?"

# ch/harems_full/office/events/office_christmas_party.rpy:1505
translate russian office_christmas_dwayne_antics_8508ba49:
    shiori.say "Мне, кажется, за такое не платят!"

# ch/harems_full/office/events/office_christmas_party.rpy:1506
translate russian office_christmas_dwayne_antics_dc04bd0c:
    "Дуэйн словно не слышит страха в голосе Сиори."

# ch/harems_full/office/events/office_christmas_party.rpy:1507
translate russian office_christmas_dwayne_antics_fab75bbb:
    "Вместо того чтобы отступить, он наклоняется ещё ближе."

# ch/harems_full/office/events/office_christmas_party.rpy:1508
translate russian office_christmas_dwayne_antics_e892a83e:
    dwayne.say "Да не волнуйся ты об этом, Сиори."

# ch/harems_full/office/events/office_christmas_party.rpy:1509
translate russian office_christmas_dwayne_antics_fee2497c:
    dwayne.say "Сейчас Рождество, и я буду Сантой!"

# ch/harems_full/office/events/office_christmas_party.rpy:1510
translate russian office_christmas_dwayne_antics_565fd6a3:
    dwayne.say "Просто зайди ко мне в кабинет и немного посиди у меня на коленях."

# ch/harems_full/office/events/office_christmas_party.rpy:1511
translate russian office_christmas_dwayne_antics_32ebfc1e:
    dwayne.say "У меня в мешке для тебя кое-что припасено!"

# ch/harems_full/office/events/office_christmas_party.rpy:1512
translate russian office_christmas_dwayne_antics_4414d904:
    "Сиори смотрит по сторонам."

# ch/harems_full/office/events/office_christmas_party.rpy:1513
translate russian office_christmas_dwayne_antics_af078e5d_3:
    "Ясно, что она ищет способ выбраться."

# ch/harems_full/office/events/office_christmas_party.rpy:1514
translate russian office_christmas_dwayne_antics_cb1f7667_3:
    "И тут её взгляд падает на меня."

# ch/harems_full/office/events/office_christmas_party.rpy:1516
translate russian office_christmas_dwayne_antics_a344ce3e:
    "Глаза Сиори расширяются в безмолвной просьбе о помощи."

# ch/harems_full/office/events/office_christmas_party.rpy:1519
translate russian office_christmas_dwayne_antics_890be79e:
    "Я прекрасно знаю, что Сиори не умеет за себя постоять."

# ch/harems_full/office/events/office_christmas_party.rpy:1520
translate russian office_christmas_dwayne_antics_78bda32e:
    "В такой ситуации ей нужна помощь, и я ей помогу."

# ch/harems_full/office/events/office_christmas_party.rpy:1521
translate russian office_christmas_dwayne_antics_cb3ca59b_2:
    "Я спешу к ним, проталкиваясь сквозь толпу."

# ch/harems_full/office/events/office_christmas_party.rpy:1522
translate russian office_christmas_dwayne_antics_e6fc3d65_2:
    "До последнего лихорадочно пытаюсь придумать план."

# ch/harems_full/office/events/office_christmas_party.rpy:1523
translate russian office_christmas_dwayne_antics_0061118a:
    mike.say "Эй, Сиори!"

# ch/harems_full/office/events/office_christmas_party.rpy:1524
translate russian office_christmas_dwayne_antics_5e079ca9:
    mike.say "Только что звонили из школы."

# ch/harems_full/office/events/office_christmas_party.rpy:1525
translate russian office_christmas_dwayne_antics_eebe53ee:
    mike.say "Сказали, у Канты пошла кровь из носа или что-то такое?"

# ch/harems_full/office/events/office_christmas_party.rpy:1527
translate russian office_christmas_dwayne_antics_2a4ca724:
    "И Дуэйн, и Сиори ошарашены и растеряны моим появлением."

# ch/harems_full/office/events/office_christmas_party.rpy:1528
translate russian office_christmas_dwayne_antics_53c5b392:
    "К счастью, Сиори соображает быстрее."

# ch/harems_full/office/events/office_christmas_party.rpy:1530
translate russian office_christmas_dwayne_antics_f7f07fde:
    shiori.say "А... а, да-да, с ним такое бывает!"

# ch/harems_full/office/events/office_christmas_party.rpy:1531
translate russian office_christmas_dwayne_antics_d387e40f:
    shiori.say "Но мне лучше самой с ними поговорить."

# ch/harems_full/office/events/office_christmas_party.rpy:1532
translate russian office_christmas_dwayne_antics_e451273b:
    shiori.say "Ну, проверить, что его не тошнит!"

# ch/harems_full/office/events/office_christmas_party.rpy:1533
translate russian office_christmas_dwayne_antics_32a3556e:
    "Разговоры о детях, крови и рвоте, кажется, отрезвляют Дуэйна."

# ch/harems_full/office/events/office_christmas_party.rpy:1534
translate russian office_christmas_dwayne_antics_6f62f042:
    "Он отступает от Сиори, сам слегка позеленев."

# ch/harems_full/office/events/office_christmas_party.rpy:1535
translate russian office_christmas_dwayne_antics_96cd78de_1:
    mike.say "О, здравствуйте, Дуэйн!"

# ch/harems_full/office/events/office_christmas_party.rpy:1537
translate russian office_christmas_dwayne_antics_5dd44af5:
    mike.say "Наверняка вспомнили, как Кэссиди была маленькой?"

# ch/harems_full/office/events/office_christmas_party.rpy:1538
translate russian office_christmas_dwayne_antics_44fd2f1b:
    mike.say "Её ведь постоянно рвало после обеда, да?"

# ch/harems_full/office/events/office_christmas_party.rpy:1539
translate russian office_christmas_dwayne_antics_fc90aaa3:
    mike.say "И все эти вонючие подгузники!"

# ch/harems_full/office/events/office_christmas_party.rpy:1540
translate russian office_christmas_dwayne_antics_fae97f00:
    "Дуэйн словно внезапно покрывается испариной."

# ch/harems_full/office/events/office_christmas_party.rpy:1541
translate russian office_christmas_dwayne_antics_2f20c361:
    "Серьёзно, вид у него неважный!"

# ch/harems_full/office/events/office_christmas_party.rpy:1542
translate russian office_christmas_dwayne_antics_c08f0278:
    dwayne.say "А... да..."

# ch/harems_full/office/events/office_christmas_party.rpy:1543
translate russian office_christmas_dwayne_antics_ca4a77c1:
    dwayne.say "Слушайте, мне нужно в туалет."

# ch/harems_full/office/events/office_christmas_party.rpy:1544
translate russian office_christmas_dwayne_antics_35d27f51:
    dwayne.say "Что-то мне нехорошо..."

# ch/harems_full/office/events/office_christmas_party.rpy:1549
translate russian office_christmas_dwayne_antics_dfd933e0:
    "Он поспешно уходит, оставляя нас с Сиори вдвоём."

# ch/harems_full/office/events/office_christmas_party.rpy:1550
translate russian office_christmas_dwayne_antics_2d51c666:
    mike.say "Прости за это, Сиори."

# ch/harems_full/office/events/office_christmas_party.rpy:1551
translate russian office_christmas_dwayne_antics_bf75673a_2:
    mike.say "Пришлось импровизировать на ходу!"

# ch/harems_full/office/events/office_christmas_party.rpy:1553
translate russian office_christmas_dwayne_antics_b36569ea:
    shiori.say "Ох, спасибо, [lssb_common.hero_name()]."

# ch/harems_full/office/events/office_christmas_party.rpy:1554
translate russian office_christmas_dwayne_antics_1c641b16:
    shiori.say "Я так благодарна тебе за помощь."

# ch/harems_full/office/events/office_christmas_party.rpy:1555
translate russian office_christmas_dwayne_antics_9817ae63:
    shiori.say "Очень, очень благодарна!"

# ch/harems_full/office/events/office_christmas_party.rpy:1557
translate russian office_christmas_dwayne_antics_2e1ec0f7_1:
    "Не собираюсь влезать в эту историю."

# ch/harems_full/office/events/office_christmas_party.rpy:1558
translate russian office_christmas_dwayne_antics_1c071a7f:
    "И Сиори уже пора научиться за себя постоять."

# ch/harems_full/office/events/office_christmas_party.rpy:1559
translate russian office_christmas_dwayne_antics_51e7dc89_3:
    "Я как можно скорее отвожу взгляд."

# ch/harems_full/office/events/office_christmas_party.rpy:1560
translate russian office_christmas_dwayne_antics_a0ea02d9_3:
    "И стараюсь сделать вид, что не понял её намёка."

# ch/harems_full/office/events/office_christmas_party.rpy:1561
translate russian office_christmas_dwayne_antics_bd3b688b:
    "Уходя, я напоследок замечаю выражение лица Сиори."

# ch/harems_full/office/events/office_christmas_party.rpy:1562
translate russian office_christmas_dwayne_antics_07936944_3:
    "Как я ни старался, она прекрасно поняла, что я бросил её в беде."

# ch/harems_full/office/events/office_christmas_party.rpy:1581
translate russian office_christmas_sex_1f88922a:
    "Думаю, сейчас самое время по-настоящему повеселиться."

# ch/harems_full/office/events/office_christmas_party.rpy:1582
translate russian office_christmas_sex_2de9889d:
    "Я оглядываю комнату в поисках той самой девушки."

# ch/harems_full/office/events/office_christmas_party.rpy:1583
translate russian office_christmas_sex_fece032c:
    "И вот она — та, о которой я думал весь день."

# ch/harems_full/office/events/office_christmas_party.rpy:1586
translate russian office_christmas_sex_cfc0c5dd:
    "Самое время подойти и дать понять, чего я хочу."

# ch/harems_full/office/events/office_christmas_party.rpy:1587
translate russian office_christmas_sex_96f406c0:
    "Я так и делаю, шепнув ей на ухо."

# ch/harems_full/office/events/office_christmas_party.rpy:1588
translate russian office_christmas_sex_5a40769b:
    mike.say "Иди за мной и не задавай вопросов, ладно?"

# ch/harems_full/office/events/office_christmas_party.rpy:1589
translate russian office_christmas_sex_fbeba034:
    mike.say "Обещаю, будет очень весело!"

# ch/harems_full/office/events/office_christmas_party.rpy:1594
translate russian office_christmas_sex_aa1f3261:
    "Алетта берёт меня за руку, спешит в пустой кабинет и закрывает за нами дверь."

# ch/harems_full/office/events/office_christmas_party.rpy:1596
translate russian office_christmas_sex_299c2a0f:
    "Мы не знаем, сколько пройдёт времени, прежде чем кто-нибудь заметит наше отсутствие."

# ch/harems_full/office/events/office_christmas_party.rpy:1597
translate russian office_christmas_sex_3630fb65:
    "Но намерены успеть получить как можно больше удовольствия!"

# ch/harems_full/office/events/office_christmas_party.rpy:1598
translate russian office_christmas_sex_1afa3aac:
    "К счастью, в выбранном кабинете есть не только стол, но и диван."

# ch/harems_full/office/events/office_christmas_party.rpy:1599
translate russian office_christmas_sex_bfcf517c:
    "Так что хотя бы устроимся удобно на то время, которое сможем урвать для себя."

# ch/harems_full/office/events/office_christmas_party.rpy:1600
translate russian office_christmas_sex_cfe2781e:
    "Алетта первой добирается до дивана, садится и похлопывает по месту рядом."

# ch/harems_full/office/events/office_christmas_party.rpy:1602
translate russian office_christmas_sex_85f0f4f7:
    aletta.say "Ну же, [lssb_common.hero_name()]!"

# ch/harems_full/office/events/office_christmas_party.rpy:1603
translate russian office_christmas_sex_77361522:
    aletta.say "Чего ты ждёшь?"

# ch/harems_full/office/events/office_christmas_party.rpy:1604
translate russian office_christmas_sex_fbc15637:
    "Следуя за ней, я пытаюсь раздеться."

# ch/harems_full/office/events/office_christmas_party.rpy:1605
translate russian office_christmas_sex_19889c17:
    "Подходя всё ближе, отбрасываю вещи в стороны."

# ch/harems_full/office/events/office_christmas_party.rpy:1606
translate russian office_christmas_sex_de45e8f4:
    mike.say "Секунду, Алетта..."

# ch/harems_full/office/events/office_christmas_party.rpy:1607
translate russian office_christmas_sex_a0ce6157:
    mike.say "Нужно вылезти из этого костюма Санты!"

# ch/harems_full/office/events/office_christmas_party.rpy:1608
translate russian office_christmas_sex_7b128544:
    mike.say "А тебе разве не нужно раздеться?!"

# ch/harems_full/office/events/office_christmas_party.rpy:1610
translate russian office_christmas_sex_43ef95dc:
    "Вместо ответа Алетта расстёгивает блузку."

# ch/harems_full/office/events/office_christmas_party.rpy:1611
translate russian office_christmas_sex_44af5314:
    "Её тяжёлые груди вырываются на свободу."

# ch/harems_full/office/events/office_christmas_party.rpy:1612
translate russian office_christmas_sex_68b3fd5a:
    "И соблазнительно покачиваются."

# ch/harems_full/office/events/office_christmas_party.rpy:1613
translate russian office_christmas_sex_556bc5d6:
    "Они так завораживают, что я едва не пропускаю её следующее действие."

# ch/harems_full/office/events/office_christmas_party.rpy:1615
translate russian office_christmas_sex_5e5792ab:
    "Она стягивает трусики и бросает их в меня!"

# ch/harems_full/office/events/office_christmas_party.rpy:1616
translate russian office_christmas_sex_c3d0adce:
    aletta.say "Ты усердно работал в этом году."

# ch/harems_full/office/events/office_christmas_party.rpy:1617
translate russian office_christmas_sex_e83572e5:
    aletta.say "И, думаю, заслужил рождественскую премию!"

# ch/harems_full/office/events/office_christmas_party.rpy:1618
