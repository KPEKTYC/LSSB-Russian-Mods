# ch/harems_full/office/events/office_harem_common.rpy:402
translate russian aletta_audrey_lavish_shiori_propose_male_4c5a0d94:
    aletta.say "Конец разгульной жизни, [lssb_common.hero_name()]."

# ch/harems_full/office/events/office_harem_common.rpy:403
translate russian aletta_audrey_lavish_shiori_propose_male_3c7629de:
    aletta.say "Ты станешь женатым человеком!"

# ch/harems_full/office/events/office_harem_common.rpy:404
translate russian aletta_audrey_lavish_shiori_propose_male_3e2cce37:
    audrey.say "Да, [lssb_common.hero_name()], теперь твоя задница принадлежит нам!"

# ch/harems_full/office/events/office_harem_common.rpy:405
translate russian aletta_audrey_lavish_shiori_propose_male_79920888:
    lavish.say "Ну... он может сказать о нас то же самое, Одри!"

# ch/harems_full/office/events/office_harem_common.rpy:406
translate russian aletta_audrey_lavish_shiori_propose_male_3d0aa6e6:
    lavish.say "В конце концов, брак — равноправное партнёрство."

# ch/harems_full/office/events/office_harem_common.rpy:407
translate russian aletta_audrey_lavish_shiori_propose_male_f5fb2207:
    shiori.say "Я... я не против быть старомодной женой."

# ch/harems_full/office/events/office_harem_common.rpy:408
translate russian aletta_audrey_lavish_shiori_propose_male_c38cab66:
    shiori.say "[lssb_common.hero_name()] может командовать мной сколько угодно!"

# ch/harems_full/office/events/office_harem_common.rpy:409
translate russian aletta_audrey_lavish_shiori_propose_male_cee381b3:
    audrey.say "Господи..."

# ch/harems_full/office/events/office_harem_common.rpy:410
translate russian aletta_audrey_lavish_shiori_propose_male_65f608cb:
    audrey.say "Вот так и становятся тряпкой, Сиори!"

# ch/harems_full/office/events/office_harem_common.rpy:411
translate russian aletta_audrey_lavish_shiori_propose_male_15b9ffd0:
    "Слушая их разговор, я невольно улыбаюсь."

# ch/harems_full/office/events/office_harem_common.rpy:412
translate russian aletta_audrey_lavish_shiori_propose_male_a8d31bfa:
    "Конечно, компания у нас довольно странная."

# ch/harems_full/office/events/office_harem_common.rpy:413
translate russian aletta_audrey_lavish_shiori_propose_male_bc68ba24:
    "Но мне кажется, именно это и поможет нам ужиться."

# ch/harems_full/office/events/office_harem_common.rpy:414
translate russian aletta_audrey_lavish_shiori_propose_male_5b72848e:
    "Ведь каждому предстоит жить ещё с четырьмя людьми."

# ch/harems_full/office/events/office_harem_common.rpy:415
translate russian aletta_audrey_lavish_shiori_propose_male_ba9cf855:
    "Что может быть хуже, чем если бы все они были похожи на тебя?"

# ch/harems_full/office/events/office_harem_common.rpy:417
translate russian aletta_audrey_lavish_shiori_propose_male_5606b6b3:
    "Я встаю и неловко прячу в карман четыре кольца, которые теперь не нужны."

# ch/harems_full/office/events/office_harem_common.rpy:418
translate russian aletta_audrey_lavish_shiori_propose_male_f4c72828:
    "Все смотрят на меня, и унижение кажется полным."

# ch/harems_full/office/events/office_harem_common.rpy:419
translate russian aletta_audrey_lavish_shiori_propose_male_6280299a:
    "Хуже будет, только если с меня свалятся штаны или я вдруг вспыхну."

# ch/harems_full/office/events/office_harem_common.rpy:420
translate russian aletta_audrey_lavish_shiori_propose_male_c62fd749:
    "Хотя нет, беру слова обратно: такое хоть отвлекло бы внимание!"

# ch/harems_full/office/events/office_harem_common.rpy:422
translate russian aletta_audrey_lavish_shiori_propose_male_d98e6ad4:
    mike.say "Ладно..."

# ch/harems_full/office/events/office_harem_common.rpy:423
translate russian aletta_audrey_lavish_shiori_propose_male_1873393c:
    mike.say "Думаю, совещание окончено!"

# ch/harems_full/office/events/office_harem_common.rpy:424
translate russian aletta_audrey_lavish_shiori_propose_male_cfe19add:
    "Я разворачиваюсь и почти выбегаю из переговорной."

# ch/harems_full/office/events/office_harem_common.rpy:425
translate russian aletta_audrey_lavish_shiori_propose_male_d51d0fc9:
    "Я сбегаю, прежде чем успеваю услышать за спиной их голоса."

# ch/harems_full/office/events/office_harem_common.rpy:426
translate russian aletta_audrey_lavish_shiori_propose_male_bf431521:
    "Прежде чем придётся отвечать на вопросы, каждый из которых был бы пыткой."

# ch/harems_full/office/events/office_harem_common.rpy:427
translate russian aletta_audrey_lavish_shiori_propose_male_dba951ec:
    "Может, сейчас самое время использовать накопившиеся отпускные дни?"

# ch/harems_full/office/events/office_harem_common.rpy:428
translate russian aletta_audrey_lavish_shiori_propose_male_20f24199:
    "Или взять длительный отпуск и уйти в монастырь?"

# ch/harems_full/office/events/office_harem_common.rpy:429
translate russian aletta_audrey_lavish_shiori_propose_male_92284482:
    "Что угодно, лишь бы подальше отсюда и от четырёх женщин, которые одновременно мне отказали!"

# ch/harems_full/office/events/office_harem_common.rpy:431
translate russian aletta_audrey_lavish_shiori_propose_male_00507281:
    "Я встаю и надеваю кольца на все протянутые руки."

# ch/harems_full/office/events/office_harem_common.rpy:432
translate russian aletta_audrey_lavish_shiori_propose_male_145278ba:
    "Чувствую на себе взгляды тех, кто отказал, но стараюсь не обращать внимания."

# ch/harems_full/office/events/office_harem_common.rpy:433
translate russian aletta_audrey_lavish_shiori_propose_male_87970527:
    "Ох... будет тяжело."

# ch/harems_full/office/events/office_harem_common.rpy:434
translate russian aletta_audrey_lavish_shiori_propose_male_b9ff0ddc:
    "Я буду скучать по тем, кто сказал нет."

# ch/harems_full/office/events/office_harem_common.rpy:435
translate russian aletta_audrey_lavish_shiori_propose_male_76c588ba:
    "Но те из нас, кто решил быть вместе, должны и дальше идти вместе."

# ch/harems_full/office/events/office_harem_common.rpy:436
translate russian aletta_audrey_lavish_shiori_propose_male_30f16e1e:
    "Мы тесно обнимаемся, пока остальные неловко выходят из комнаты."

# ch/harems_full/office/events/office_harem_common.rpy:437
translate russian aletta_audrey_lavish_shiori_propose_male_adb1481c:
    "Мы вступаем на неизведанную территорию."

# ch/harems_full/office/events/office_harem_common.rpy:438
translate russian aletta_audrey_lavish_shiori_propose_male_d873522f:
    "Но любовь, которую я чувствую от своих будущих жён, убеждает меня: у нас всё получится."

# ch/harems_full/office/events/office_harem_common.rpy:442
translate russian audrey_lavish_shiori_propose_male_364318ef:
    "Поддерживать хорошие отношения со всеми девушками в офисе — всё равно что жонглировать бензопилами."

# ch/harems_full/office/events/office_harem_common.rpy:443
translate russian audrey_lavish_shiori_propose_male_e341b6eb:
    "Это требует всей моей сосредоточенности и ловкости."

# ch/harems_full/office/events/office_harem_common.rpy:444
translate russian audrey_lavish_shiori_propose_male_96d190b1:
    "И одна-единственная ошибка может обернуться для меня смертельно опасной ситуацией!"

# ch/harems_full/office/events/office_harem_common.rpy:445
translate russian audrey_lavish_shiori_propose_male_b1997792:
    "Так что вы наверняка спросите, зачем мне вообще думать о предложении им всем."

# ch/harems_full/office/events/office_harem_common.rpy:446
translate russian audrey_lavish_shiori_propose_male_4fde221b:
    "Но выслушайте меня, ладно?"

# ch/harems_full/office/events/office_harem_common.rpy:447
translate russian audrey_lavish_shiori_propose_male_65bbe4f6:
    "По-моему, если мы поженимся, всё станет официально, верно?"

# ch/harems_full/office/events/office_harem_common.rpy:448
translate russian audrey_lavish_shiori_propose_male_df9c8fe5:
    "Больше не придётся тайком встречаться за чужими спинами и бояться, что нас застукают."

# ch/harems_full/office/events/office_harem_common.rpy:449
translate russian audrey_lavish_shiori_propose_male_afee1c3e:
    "Я прекрасно знаю, что многожёнство в нашей стране разрешили совсем недавно."

# ch/harems_full/office/events/office_harem_common.rpy:450
translate russian audrey_lavish_shiori_propose_male_8136ba76:
    "Но, по мне, жениться на трёх не так уж отличается от женитьбы на двух."

# ch/harems_full/office/events/office_harem_common.rpy:451
translate russian audrey_lavish_shiori_propose_male_a1ab3626:
    "Нет, настоящая разница в том, что придётся раскошелиться на три чёртовых кольца!"

# ch/harems_full/office/events/office_harem_common.rpy:452
translate russian audrey_lavish_shiori_propose_male_a7aef0b5:
    "И ещё собрать их всех в одном месте, чтобы сделать предложение."

# ch/harems_full/office/events/office_harem_common.rpy:453
translate russian audrey_lavish_shiori_propose_male_2687003b:
    "В конце концов я решаю притвориться, будто созываю совещание."

# ch/harems_full/office/events/office_harem_common.rpy:454
translate russian audrey_lavish_shiori_propose_male_98304d93:
    "Вот почему сейчас жду их в переговорной."

# ch/harems_full/office/events/office_harem_common.rpy:456
translate russian audrey_lavish_shiori_propose_male_86c46c0c:
    "Следом входит Лавиш, как всегда собранная и готовая к совещанию."

# ch/harems_full/office/events/office_harem_common.rpy:458
translate russian audrey_lavish_shiori_propose_male_3ff50c07:
    "Чуть позже нехотя подтягивается Одри: хмурая, больше занятая телефоном, чем работой."

# ch/harems_full/office/events/office_harem_common.rpy:459
translate russian audrey_lavish_shiori_propose_male_ac4b2b2c:
    "Я уже собираюсь закрыть дверь, когда вбегает Сиори."

# ch/harems_full/office/events/office_harem_common.rpy:461
translate russian audrey_lavish_shiori_propose_male_5738db24:
    shiori.say "Прости, пожалуйста, [lssb_common.hero_name()]."

# ch/harems_full/office/events/office_harem_common.rpy:462
translate russian audrey_lavish_shiori_propose_male_e9521209:
    shiori.say "Тот, кто подвозил меня на работу, опоздал."

# ch/harems_full/office/events/office_harem_common.rpy:463
translate russian audrey_lavish_shiori_propose_male_dd1efdc0:
    shiori.say "А потом оказалось, что лифты не работают."

# ch/harems_full/office/events/office_harem_common.rpy:464
translate russian audrey_lavish_shiori_propose_male_d74f7ff5:
    shiori.say "А потом..."

# ch/harems_full/office/events/office_harem_common.rpy:465
translate russian audrey_lavish_shiori_propose_male_3406129d:
    mike.say "Всё хорошо, Сиори..."

# ch/harems_full/office/events/office_harem_common.rpy:466
translate russian audrey_lavish_shiori_propose_male_193b86af:
    mike.say "Просто проходи и садись."

# ch/harems_full/office/events/office_harem_common.rpy:467
translate russian audrey_lavish_shiori_propose_male_3e5cf0cb:
    "Сиори кивает и спешит выполнить просьбу."

# ch/harems_full/office/events/office_harem_common.rpy:468
translate russian audrey_lavish_shiori_propose_male_e72d4c14:
    "Я подхожу к торцу стола, и все смотрят на меня."

# ch/harems_full/office/events/office_harem_common.rpy:469
translate russian audrey_lavish_shiori_propose_male_f7b332d3:
    lavish.say "Ты совсем не предупредил меня о совещании!"

# ch/harems_full/office/events/office_harem_common.rpy:471
translate russian audrey_lavish_shiori_propose_male_e866e559:
    lavish.say "Я не успела подготовиться за такое короткое время."

# ch/harems_full/office/events/office_harem_common.rpy:472
translate russian audrey_lavish_shiori_propose_male_1bb5b922:
    audrey.say "Значит, не сделала домашнее задание, Лавиш."

# ch/harems_full/office/events/office_harem_common.rpy:473
translate russian audrey_lavish_shiori_propose_male_7c1997fb:
    audrey.say "Кого это, чёрт возьми, волнует?"

# ch/harems_full/office/events/office_harem_common.rpy:474
translate russian audrey_lavish_shiori_propose_male_d0d58d00:
    audrey.say "Давайте уже закончим и уберёмся отсюда!"

# ch/harems_full/office/events/office_harem_common.rpy:475
translate russian audrey_lavish_shiori_propose_male_f4e3a950:
    "Я натягиваю улыбку, убеждая себя, что это хорошая идея."

# ch/harems_full/office/events/office_harem_common.rpy:476
translate russian audrey_lavish_shiori_propose_male_e5096f0b:
    "Я ведь люблю каждую из этих девушек, правда люблю."

# ch/harems_full/office/events/office_harem_common.rpy:477
translate russian audrey_lavish_shiori_propose_male_fb5985a9:
    "Но прекрасно знаю, что временами они все могут быть той ещё занозой в заднице!"

# ch/harems_full/office/events/office_harem_common.rpy:479
translate russian audrey_lavish_shiori_propose_male_4ab6d240:
    mike.say "Я не предупредил о встрече, потому что хотел сделать сюрприз."

# ch/harems_full/office/events/office_harem_common.rpy:480
translate russian audrey_lavish_shiori_propose_male_106c67c0:
    mike.say "И мне нужно было собрать вас всех вместе, чтобы сделать вот что..."

# ch/harems_full/office/events/office_harem_common.rpy:481
translate russian audrey_lavish_shiori_propose_male_79910399:
    "Я опускаюсь на одно колено и достаю из кармана три одинаковых кольца."

# ch/harems_full/office/events/office_harem_common.rpy:482
translate russian audrey_lavish_shiori_propose_male_ff3ebfd9:
    mike.say "Одри, Лавиш, Сиори..."

# ch/harems_full/office/events/office_harem_common.rpy:484
translate russian audrey_lavish_shiori_propose_male_c795a089:
    mike.say "И друг за друга, наверное, тоже!"

# ch/harems_full/office/events/office_harem_common.rpy:488
translate russian audrey_lavish_shiori_propose_male_b5700755:
    "Впервые на моей памяти все они лишаются дара речи."

# ch/harems_full/office/events/office_harem_common.rpy:489
translate russian audrey_lavish_shiori_propose_male_4af83198:
    "Девушки смотрят на меня, затем переглядываются."

# ch/harems_full/office/events/office_harem_common.rpy:490
translate russian audrey_lavish_shiori_propose_male_c6c3d050:
    "А я всё ещё стою на одном колене и жду ответа."

# ch/harems_full/office/events/office_harem_common.rpy:493
translate russian audrey_lavish_shiori_propose_male_947bcb8b:
    "Одри странно кривится, словно усиленно думает."

# ch/harems_full/office/events/office_harem_common.rpy:494
translate russian audrey_lavish_shiori_propose_male_7a5bdb84:
    "А затем отвечает с обычной прямотой."

# ch/harems_full/office/events/office_harem_common.rpy:495
translate russian audrey_lavish_shiori_propose_male_90eda6e5:
    audrey.say "Чёрта с два! Ещё не хватало выйти за вас, неудачников!"

# ch/harems_full/office/events/office_harem_common.rpy:496
translate russian audrey_lavish_shiori_propose_male_5860ad2b:
    audrey.say "Мне уже достаточно того, что приходится с вами работать."

# ch/harems_full/office/events/office_harem_common.rpy:497
translate russian audrey_lavish_shiori_propose_male_d3306c4e:
    audrey.say "Забудьте о том, чтобы провести вместе ещё и всю жизнь!"

# ch/harems_full/office/events/office_harem_common.rpy:501
translate russian audrey_lavish_shiori_propose_male_947bcb8b_1:
    "Одри странно кривится, словно усиленно думает."

# ch/harems_full/office/events/office_harem_common.rpy:502
translate russian audrey_lavish_shiori_propose_male_7a5bdb84_1:
    "А затем отвечает с обычной прямотой."

# ch/harems_full/office/events/office_harem_common.rpy:504
translate russian audrey_lavish_shiori_propose_male_17387692:
    audrey.say "Да, я согласна."

# ch/harems_full/office/events/office_harem_common.rpy:505
translate russian audrey_lavish_shiori_propose_male_e53de238:
    audrey.say "Вы все по-прежнему слишком зажатые."

# ch/harems_full/office/events/office_harem_common.rpy:506
translate russian audrey_lavish_shiori_propose_male_19aa4504:
    audrey.say "И без меня вам эти палки из задниц не вытащить!"

# ch/harems_full/office/events/office_harem_common.rpy:510
translate russian audrey_lavish_shiori_propose_male_a94738bd:
    "Лавиш выглядит задумчивой, словно всерьёз взвешивает ответ."

# ch/harems_full/office/events/office_harem_common.rpy:511
translate russian audrey_lavish_shiori_propose_male_539a5760:
    "Затем кивает и коротко выдыхает."

# ch/harems_full/office/events/office_harem_common.rpy:512
translate russian audrey_lavish_shiori_propose_male_4879009e:
    lavish.say "Придётся сказать нет."

# ch/harems_full/office/events/office_harem_common.rpy:513
translate russian audrey_lavish_shiori_propose_male_a845c91a:
    lavish.say "Не думаю, что эти отношения идут мне на пользу."

# ch/harems_full/office/events/office_harem_common.rpy:514
translate russian audrey_lavish_shiori_propose_male_f79e418c:
    lavish.say "И, скорее всего, помешают моим долгосрочным карьерным планам."

# ch/harems_full/office/events/office_harem_common.rpy:518
translate russian audrey_lavish_shiori_propose_male_a94738bd_1:
    "Лавиш выглядит задумчивой, словно всерьёз взвешивает ответ."

# ch/harems_full/office/events/office_harem_common.rpy:519
translate russian audrey_lavish_shiori_propose_male_539a5760_1:
    "Затем кивает и коротко выдыхает."

# ch/harems_full/office/events/office_harem_common.rpy:521
translate russian audrey_lavish_shiori_propose_male_26ac0382:
    lavish.say "Я говорю да."

# ch/harems_full/office/events/office_harem_common.rpy:522
translate russian audrey_lavish_shiori_propose_male_f804e109:
    lavish.say "Отношения у нас, конечно, немного странные."

# ch/harems_full/office/events/office_harem_common.rpy:523
translate russian audrey_lavish_shiori_propose_male_9618b8ed:
    lavish.say "Но всё, похоже, получается, и мне очень нравится!"

# ch/harems_full/office/events/office_harem_common.rpy:527
translate russian audrey_lavish_shiori_propose_male_b134dbfd:
    "Сиори обводит взглядом всех присутствующих."

# ch/harems_full/office/events/office_harem_common.rpy:528
translate russian audrey_lavish_shiori_propose_male_0841ed9b:
    "На мгновение мне кажется, что она попросит их решить за неё."

# ch/harems_full/office/events/office_harem_common.rpy:529
translate russian audrey_lavish_shiori_propose_male_dd9a67f1:
    "Но в конце концов набирается смелости высказаться сама."

# ch/harems_full/office/events/office_harem_common.rpy:530
translate russian audrey_lavish_shiori_propose_male_0c945ab9:
    shiori.say "Я... я говорю нет."

# ch/harems_full/office/events/office_harem_common.rpy:531
translate russian audrey_lavish_shiori_propose_male_fc11a726:
    shiori.say "Мне кажется, я теряю себя в этих отношениях."

# ch/harems_full/office/events/office_harem_common.rpy:532
translate russian audrey_lavish_shiori_propose_male_f21a3a74:
    shiori.say "Будто все воспринимают меня как должное и не замечают!"

# ch/harems_full/office/events/office_harem_common.rpy:536
translate russian audrey_lavish_shiori_propose_male_b134dbfd_1:
    "Сиори обводит взглядом всех присутствующих."

# ch/harems_full/office/events/office_harem_common.rpy:537
translate russian audrey_lavish_shiori_propose_male_0841ed9b_1:
    "На мгновение мне кажется, что она попросит их решить за неё."

# ch/harems_full/office/events/office_harem_common.rpy:538
translate russian audrey_lavish_shiori_propose_male_dd9a67f1_1:
    "Но в конце концов набирается смелости высказаться сама."

# ch/harems_full/office/events/office_harem_common.rpy:540
translate russian audrey_lavish_shiori_propose_male_e482cd60:
    shiori.say "Я... я говорю да."

# ch/harems_full/office/events/office_harem_common.rpy:541
translate russian audrey_lavish_shiori_propose_male_8714c3bc:
    shiori.say "Мне нравится быть в отношениях со всеми вами."

# ch/harems_full/office/events/office_harem_common.rpy:542
translate russian audrey_lavish_shiori_propose_male_18c577cd:
    shiori.say "Я больше не чувствую себя одинокой и потерянной!"

# ch/harems_full/office/events/office_harem_common.rpy:544
translate russian audrey_lavish_shiori_propose_male_b4daf315:
    "Слушая их ответы, я чувствую, как колотится сердце."

# ch/harems_full/office/events/office_harem_common.rpy:545
translate russian audrey_lavish_shiori_propose_male_8f6f25a5:
    "Но разве могло быть иначе?"

# ch/harems_full/office/events/office_harem_common.rpy:546
translate russian audrey_lavish_shiori_propose_male_edd36fb9:
    "Я прошу их принять очень важное решение."

# ch/harems_full/office/events/office_harem_common.rpy:547
translate russian audrey_lavish_shiori_propose_male_f865e794:
    "И оно неизбежно вызовет уйму эмоций."

# ch/harems_full/office/events/office_harem_common.rpy:549
translate russian audrey_lavish_shiori_propose_male_13c7fcb6:
    "Я встаю и начинаю надевать кольца им на пальцы."

# ch/harems_full/office/events/office_harem_common.rpy:550
translate russian audrey_lavish_shiori_propose_male_d5d90334:
    "Вскоре всё готово, и девушки любуются новыми украшениями."

# ch/harems_full/office/events/office_harem_common.rpy:551
translate russian audrey_lavish_shiori_propose_male_78889186:
    "Мне хочется ущипнуть себя, чтобы убедиться, что всё происходит наяву."

# ch/harems_full/office/events/office_harem_common.rpy:552
translate russian audrey_lavish_shiori_propose_male_3db55a5d:
    "Я правда женюсь на всех троих?"

# ch/harems_full/office/events/office_harem_common.rpy:553
translate russian audrey_lavish_shiori_propose_male_3e2cce37:
    audrey.say "Да, [lssb_common.hero_name()], теперь твоя задница принадлежит нам!"

# ch/harems_full/office/events/office_harem_common.rpy:554
translate russian audrey_lavish_shiori_propose_male_79920888:
    lavish.say "Ну... он может сказать о нас то же самое, Одри!"

# ch/harems_full/office/events/office_harem_common.rpy:555
translate russian audrey_lavish_shiori_propose_male_3d0aa6e6:
    lavish.say "В конце концов, брак — равноправное партнёрство."

# ch/harems_full/office/events/office_harem_common.rpy:556
translate russian audrey_lavish_shiori_propose_male_f5fb2207:
    shiori.say "Я... я не против быть старомодной женой."

# ch/harems_full/office/events/office_harem_common.rpy:557
translate russian audrey_lavish_shiori_propose_male_c38cab66:
    shiori.say "[lssb_common.hero_name()] может командовать мной сколько угодно!"

# ch/harems_full/office/events/office_harem_common.rpy:558
translate russian audrey_lavish_shiori_propose_male_cee381b3:
    audrey.say "Господи..."

# ch/harems_full/office/events/office_harem_common.rpy:559
translate russian audrey_lavish_shiori_propose_male_65f608cb:
    audrey.say "Вот так и становятся тряпкой, Сиори!"

# ch/harems_full/office/events/office_harem_common.rpy:560
translate russian audrey_lavish_shiori_propose_male_15b9ffd0:
    "Слушая их разговор, я невольно улыбаюсь."

# ch/harems_full/office/events/office_harem_common.rpy:561
translate russian audrey_lavish_shiori_propose_male_a8d31bfa:
    "Конечно, компания у нас довольно странная."

# ch/harems_full/office/events/office_harem_common.rpy:562
translate russian audrey_lavish_shiori_propose_male_bc68ba24:
    "Но мне кажется, именно это и поможет нам ужиться."

# ch/harems_full/office/events/office_harem_common.rpy:563
translate russian audrey_lavish_shiori_propose_male_2df417ba:
    "Ведь каждому предстоит жить ещё с тремя людьми."

# ch/harems_full/office/events/office_harem_common.rpy:564
translate russian audrey_lavish_shiori_propose_male_ba9cf855:
    "Что может быть хуже, чем если бы все они были похожи на тебя?"

# ch/harems_full/office/events/office_harem_common.rpy:566
translate russian audrey_lavish_shiori_propose_male_2db28238:
    "Я встаю и неловко прячу в карман три кольца, которые теперь не нужны."

# ch/harems_full/office/events/office_harem_common.rpy:567
translate russian audrey_lavish_shiori_propose_male_f4c72828:
    "Все смотрят на меня, и унижение кажется полным."

# ch/harems_full/office/events/office_harem_common.rpy:568
translate russian audrey_lavish_shiori_propose_male_6280299a:
    "Хуже будет, только если с меня свалятся штаны или я вдруг вспыхну."

# ch/harems_full/office/events/office_harem_common.rpy:569
translate russian audrey_lavish_shiori_propose_male_c62fd749:
    "Хотя нет, беру слова обратно: такое хоть отвлекло бы внимание!"

# ch/harems_full/office/events/office_harem_common.rpy:571
translate russian audrey_lavish_shiori_propose_male_d98e6ad4:
    mike.say "Ладно..."

# ch/harems_full/office/events/office_harem_common.rpy:572
translate russian audrey_lavish_shiori_propose_male_1873393c:
    mike.say "Думаю, совещание окончено!"

# ch/harems_full/office/events/office_harem_common.rpy:573
translate russian audrey_lavish_shiori_propose_male_cfe19add:
    "Я разворачиваюсь и почти выбегаю из переговорной."

# ch/harems_full/office/events/office_harem_common.rpy:574
translate russian audrey_lavish_shiori_propose_male_d51d0fc9:
    "Я сбегаю, прежде чем успеваю услышать за спиной их голоса."

# ch/harems_full/office/events/office_harem_common.rpy:575
translate russian audrey_lavish_shiori_propose_male_bf431521:
    "Прежде чем придётся отвечать на вопросы, каждый из которых был бы пыткой."

# ch/harems_full/office/events/office_harem_common.rpy:576
translate russian audrey_lavish_shiori_propose_male_dba951ec:
    "Может, сейчас самое время использовать накопившиеся отпускные дни?"

# ch/harems_full/office/events/office_harem_common.rpy:577
translate russian audrey_lavish_shiori_propose_male_20f24199:
    "Или взять длительный отпуск и уйти в монастырь?"

# ch/harems_full/office/events/office_harem_common.rpy:578
translate russian audrey_lavish_shiori_propose_male_e06cc43b:
    "Что угодно, лишь бы подальше отсюда и от трёх женщин, которые одновременно мне отказали!"

# ch/harems_full/office/events/office_harem_common.rpy:580
translate russian audrey_lavish_shiori_propose_male_00507281:
    "Я встаю и надеваю кольца на все протянутые руки."

# ch/harems_full/office/events/office_harem_common.rpy:581
translate russian audrey_lavish_shiori_propose_male_145278ba:
    "Чувствую на себе взгляды тех, кто отказал, но стараюсь не обращать внимания."

# ch/harems_full/office/events/office_harem_common.rpy:582
translate russian audrey_lavish_shiori_propose_male_87970527:
    "Ох... будет тяжело."

# ch/harems_full/office/events/office_harem_common.rpy:583
translate russian audrey_lavish_shiori_propose_male_b9ff0ddc:
    "Я буду скучать по тем, кто сказал нет."

# ch/harems_full/office/events/office_harem_common.rpy:584
translate russian audrey_lavish_shiori_propose_male_76c588ba:
    "Но те из нас, кто решил быть вместе, должны и дальше идти вместе."

# ch/harems_full/office/events/office_harem_common.rpy:585
translate russian audrey_lavish_shiori_propose_male_30f16e1e:
    "Мы тесно обнимаемся, пока остальные неловко выходят из комнаты."

# ch/harems_full/office/events/office_harem_common.rpy:586
translate russian audrey_lavish_shiori_propose_male_adb1481c:
    "Мы вступаем на неизведанную территорию."

# ch/harems_full/office/events/office_harem_common.rpy:587
translate russian audrey_lavish_shiori_propose_male_d873522f:
    "Но любовь, которую я чувствую от своих будущих жён, убеждает меня: у нас всё получится."

# ch/harems_full/office/events/office_harem_common.rpy:591
translate russian aletta_lavish_shiori_propose_male_364318ef:
    "Поддерживать хорошие отношения со всеми девушками в офисе — всё равно что жонглировать бензопилами."

# ch/harems_full/office/events/office_harem_common.rpy:592
translate russian aletta_lavish_shiori_propose_male_e341b6eb:
    "Это требует всей моей сосредоточенности и ловкости."

# ch/harems_full/office/events/office_harem_common.rpy:593
translate russian aletta_lavish_shiori_propose_male_96d190b1:
    "И одна-единственная ошибка может обернуться для меня смертельно опасной ситуацией!"

# ch/harems_full/office/events/office_harem_common.rpy:594
translate russian aletta_lavish_shiori_propose_male_b1997792:
    "Так что вы наверняка спросите, зачем мне вообще думать о предложении им всем."

# ch/harems_full/office/events/office_harem_common.rpy:595
translate russian aletta_lavish_shiori_propose_male_4fde221b:
    "Но выслушайте меня, ладно?"

# ch/harems_full/office/events/office_harem_common.rpy:596
translate russian aletta_lavish_shiori_propose_male_65bbe4f6:
    "По-моему, если мы поженимся, всё станет официально, верно?"

# ch/harems_full/office/events/office_harem_common.rpy:597
translate russian aletta_lavish_shiori_propose_male_df9c8fe5:
    "Больше не придётся тайком встречаться за чужими спинами и бояться, что нас застукают."

# ch/harems_full/office/events/office_harem_common.rpy:598
translate russian aletta_lavish_shiori_propose_male_afee1c3e:
    "Я прекрасно знаю, что многожёнство в нашей стране разрешили совсем недавно."

# ch/harems_full/office/events/office_harem_common.rpy:599
translate russian aletta_lavish_shiori_propose_male_8136ba76:
    "Но, по мне, жениться на трёх не так уж отличается от женитьбы на двух."

# ch/harems_full/office/events/office_harem_common.rpy:600
translate russian aletta_lavish_shiori_propose_male_a1ab3626:
    "Нет, настоящая разница в том, что придётся раскошелиться на три чёртовых кольца!"

# ch/harems_full/office/events/office_harem_common.rpy:601
translate russian aletta_lavish_shiori_propose_male_a7aef0b5:
    "И ещё собрать их всех в одном месте, чтобы сделать предложение."

# ch/harems_full/office/events/office_harem_common.rpy:602
translate russian aletta_lavish_shiori_propose_male_2687003b:
    "В конце концов я решаю притвориться, будто созываю совещание."

# ch/harems_full/office/events/office_harem_common.rpy:603
translate russian aletta_lavish_shiori_propose_male_98304d93:
    "Вот почему сейчас жду их в переговорной."

# ch/harems_full/office/events/office_harem_common.rpy:605
translate russian aletta_lavish_shiori_propose_male_8d38f9ef:
    "Алетта приходит первой, с очень деловым видом."

# ch/harems_full/office/events/office_harem_common.rpy:607
translate russian aletta_lavish_shiori_propose_male_86c46c0c:
    "Следом входит Лавиш, как всегда собранная и готовая к совещанию."

# ch/harems_full/office/events/office_harem_common.rpy:608
translate russian aletta_lavish_shiori_propose_male_ac4b2b2c:
    "Я уже собираюсь закрыть дверь, когда вбегает Сиори."

# ch/harems_full/office/events/office_harem_common.rpy:610
translate russian aletta_lavish_shiori_propose_male_5738db24:
    shiori.say "Прости, пожалуйста, [lssb_common.hero_name()]."

# ch/harems_full/office/events/office_harem_common.rpy:611
translate russian aletta_lavish_shiori_propose_male_e9521209:
    shiori.say "Тот, кто подвозил меня на работу, опоздал."

# ch/harems_full/office/events/office_harem_common.rpy:612
translate russian aletta_lavish_shiori_propose_male_dd1efdc0:
    shiori.say "А потом оказалось, что лифты не работают."

# ch/harems_full/office/events/office_harem_common.rpy:613
translate russian aletta_lavish_shiori_propose_male_d74f7ff5:
    shiori.say "А потом..."

# ch/harems_full/office/events/office_harem_common.rpy:614
translate russian aletta_lavish_shiori_propose_male_3406129d:
    mike.say "Всё хорошо, Сиори..."

# ch/harems_full/office/events/office_harem_common.rpy:615
translate russian aletta_lavish_shiori_propose_male_193b86af:
    mike.say "Просто проходи и садись."

# ch/harems_full/office/events/office_harem_common.rpy:616
translate russian aletta_lavish_shiori_propose_male_3e5cf0cb:
    "Сиори кивает и спешит выполнить просьбу."

# ch/harems_full/office/events/office_harem_common.rpy:617
translate russian aletta_lavish_shiori_propose_male_e72d4c14:
    "Я подхожу к торцу стола, и все смотрят на меня."

# ch/harems_full/office/events/office_harem_common.rpy:618
translate russian aletta_lavish_shiori_propose_male_12820c04:
    aletta.say "Должна сказать, это непрофессионально, [lssb_common.hero_name()]."

# ch/harems_full/office/events/office_harem_common.rpy:620
translate russian aletta_lavish_shiori_propose_male_81173a57:
    aletta.say "Ты совсем не предупредил меня о совещании!"

# ch/harems_full/office/events/office_harem_common.rpy:621
translate russian aletta_lavish_shiori_propose_male_ba5b29d4:
    lavish.say "Алетта права, [lssb_common.hero_name()]."

# ch/harems_full/office/events/office_harem_common.rpy:623
translate russian aletta_lavish_shiori_propose_male_e866e559:
    lavish.say "Я не успела подготовиться за такое короткое время."

# ch/harems_full/office/events/office_harem_common.rpy:624
translate russian aletta_lavish_shiori_propose_male_f4e3a950:
    "Я натягиваю улыбку, убеждая себя, что это хорошая идея."

# ch/harems_full/office/events/office_harem_common.rpy:625
translate russian aletta_lavish_shiori_propose_male_e5096f0b:
    "Я ведь люблю каждую из этих девушек, правда люблю."

# ch/harems_full/office/events/office_harem_common.rpy:626
translate russian aletta_lavish_shiori_propose_male_fb5985a9:
    "Но прекрасно знаю, что временами они все могут быть той ещё занозой в заднице!"

# ch/harems_full/office/events/office_harem_common.rpy:628
translate russian aletta_lavish_shiori_propose_male_4ab6d240:
    mike.say "Я не предупредил о встрече, потому что хотел сделать сюрприз."

# ch/harems_full/office/events/office_harem_common.rpy:629
translate russian aletta_lavish_shiori_propose_male_106c67c0:
    mike.say "И мне нужно было собрать вас всех вместе, чтобы сделать вот что..."

# ch/harems_full/office/events/office_harem_common.rpy:630
translate russian aletta_lavish_shiori_propose_male_79910399:
    "Я опускаюсь на одно колено и достаю из кармана три одинаковых кольца."

# ch/harems_full/office/events/office_harem_common.rpy:631
translate russian aletta_lavish_shiori_propose_male_5324be1e:
    mike.say "Алетта, Лавиш, Сиори..."

# ch/harems_full/office/events/office_harem_common.rpy:633
translate russian aletta_lavish_shiori_propose_male_c795a089:
    mike.say "И друг за друга, наверное, тоже!"

# ch/harems_full/office/events/office_harem_common.rpy:637
translate russian aletta_lavish_shiori_propose_male_b5700755:
    "Впервые на моей памяти все они лишаются дара речи."

# ch/harems_full/office/events/office_harem_common.rpy:638
translate russian aletta_lavish_shiori_propose_male_4af83198:
    "Девушки смотрят на меня, затем переглядываются."

# ch/harems_full/office/events/office_harem_common.rpy:639
translate russian aletta_lavish_shiori_propose_male_c6c3d050:
    "А я всё ещё стою на одном колене и жду ответа."

# ch/harems_full/office/events/office_harem_common.rpy:642
translate russian aletta_lavish_shiori_propose_male_32e7a398:
    "Алетта по привычке сохраняет властный вид."

# ch/harems_full/office/events/office_harem_common.rpy:643
translate russian aletta_lavish_shiori_propose_male_778a549a:
    "Отвечает первой, твёрдо и уверенно."

# ch/harems_full/office/events/office_harem_common.rpy:644
translate russian aletta_lavish_shiori_propose_male_3f93e7ee:
    aletta.say "Определённо нет."

# ch/harems_full/office/events/office_harem_common.rpy:645
translate russian aletta_lavish_shiori_propose_male_4b4ee576:
    aletta.say "Для меня эти отношения прежде всего деловая договорённость."

# ch/harems_full/office/events/office_harem_common.rpy:646
translate russian aletta_lavish_shiori_propose_male_b0512339:
    aletta.say "И я не согласна превращать их в юридические обязательства."

# ch/harems_full/office/events/office_harem_common.rpy:650
translate russian aletta_lavish_shiori_propose_male_32e7a398_1:
    "Алетта по привычке сохраняет властный вид."

# ch/harems_full/office/events/office_harem_common.rpy:651
translate russian aletta_lavish_shiori_propose_male_778a549a_1:
    "Отвечает первой, твёрдо и уверенно."

# ch/harems_full/office/events/office_harem_common.rpy:653
translate russian aletta_lavish_shiori_propose_male_7760ffd5:
    aletta.say "Да, [lssb_common.hero_name()]."

# ch/harems_full/office/events/office_harem_common.rpy:654
translate russian aletta_lavish_shiori_propose_male_90dd339c:
    aletta.say "Признаюсь, в начале наших отношений я была... настроена скептически."

# ch/harems_full/office/events/office_harem_common.rpy:655
translate russian aletta_lavish_shiori_propose_male_541a9e8a:
    aletta.say "Но всё оказалось гораздо лучше, чем я могла представить."

# ch/harems_full/office/events/office_harem_common.rpy:659
translate russian aletta_lavish_shiori_propose_male_a94738bd:
    "Лавиш выглядит задумчивой, словно всерьёз взвешивает ответ."

# ch/harems_full/office/events/office_harem_common.rpy:660
translate russian aletta_lavish_shiori_propose_male_539a5760:
    "Затем кивает и коротко выдыхает."

# ch/harems_full/office/events/office_harem_common.rpy:661
translate russian aletta_lavish_shiori_propose_male_4879009e:
    lavish.say "Придётся сказать нет."

# ch/harems_full/office/events/office_harem_common.rpy:662
translate russian aletta_lavish_shiori_propose_male_a845c91a:
    lavish.say "Не думаю, что эти отношения идут мне на пользу."

# ch/harems_full/office/events/office_harem_common.rpy:663
translate russian aletta_lavish_shiori_propose_male_f79e418c:
    lavish.say "И, скорее всего, помешают моим долгосрочным карьерным планам."

# ch/harems_full/office/events/office_harem_common.rpy:667
translate russian aletta_lavish_shiori_propose_male_a94738bd_1:
    "Лавиш выглядит задумчивой, словно всерьёз взвешивает ответ."

# ch/harems_full/office/events/office_harem_common.rpy:668
translate russian aletta_lavish_shiori_propose_male_539a5760_1:
    "Затем кивает и коротко выдыхает."

# ch/harems_full/office/events/office_harem_common.rpy:670
translate russian aletta_lavish_shiori_propose_male_26ac0382:
    lavish.say "Я говорю да."

# ch/harems_full/office/events/office_harem_common.rpy:671
translate russian aletta_lavish_shiori_propose_male_f804e109:
    lavish.say "Отношения у нас, конечно, немного странные."

# ch/harems_full/office/events/office_harem_common.rpy:672
translate russian aletta_lavish_shiori_propose_male_9618b8ed:
    lavish.say "Но всё, похоже, получается, и мне очень нравится!"

# ch/harems_full/office/events/office_harem_common.rpy:676
translate russian aletta_lavish_shiori_propose_male_b134dbfd:
    "Сиори обводит взглядом всех присутствующих."

# ch/harems_full/office/events/office_harem_common.rpy:677
translate russian aletta_lavish_shiori_propose_male_0841ed9b:
    "На мгновение мне кажется, что она попросит их решить за неё."

# ch/harems_full/office/events/office_harem_common.rpy:678
translate russian aletta_lavish_shiori_propose_male_dd9a67f1:
    "Но в конце концов набирается смелости высказаться сама."

# ch/harems_full/office/events/office_harem_common.rpy:679
translate russian aletta_lavish_shiori_propose_male_0c945ab9:
    shiori.say "Я... я говорю нет."

# ch/harems_full/office/events/office_harem_common.rpy:680
translate russian aletta_lavish_shiori_propose_male_fc11a726:
    shiori.say "Мне кажется, я теряю себя в этих отношениях."

# ch/harems_full/office/events/office_harem_common.rpy:681
translate russian aletta_lavish_shiori_propose_male_f21a3a74:
    shiori.say "Будто все воспринимают меня как должное и не замечают!"

# ch/harems_full/office/events/office_harem_common.rpy:685
translate russian aletta_lavish_shiori_propose_male_b134dbfd_1:
    "Сиори обводит взглядом всех присутствующих."

# ch/harems_full/office/events/office_harem_common.rpy:686
translate russian aletta_lavish_shiori_propose_male_0841ed9b_1:
    "На мгновение мне кажется, что она попросит их решить за неё."

# ch/harems_full/office/events/office_harem_common.rpy:687
translate russian aletta_lavish_shiori_propose_male_dd9a67f1_1:
    "Но в конце концов набирается смелости высказаться сама."

# ch/harems_full/office/events/office_harem_common.rpy:689
translate russian aletta_lavish_shiori_propose_male_e482cd60:
    shiori.say "Я... я говорю да."

# ch/harems_full/office/events/office_harem_common.rpy:690
translate russian aletta_lavish_shiori_propose_male_8714c3bc:
    shiori.say "Мне нравится быть в отношениях со всеми вами."

# ch/harems_full/office/events/office_harem_common.rpy:691
translate russian aletta_lavish_shiori_propose_male_18c577cd:
    shiori.say "Я больше не чувствую себя одинокой и потерянной!"

# ch/harems_full/office/events/office_harem_common.rpy:693
translate russian aletta_lavish_shiori_propose_male_b4daf315:
    "Слушая их ответы, я чувствую, как колотится сердце."

# ch/harems_full/office/events/office_harem_common.rpy:694
translate russian aletta_lavish_shiori_propose_male_8f6f25a5:
    "Но разве могло быть иначе?"

# ch/harems_full/office/events/office_harem_common.rpy:695
translate russian aletta_lavish_shiori_propose_male_edd36fb9:
    "Я прошу их принять очень важное решение."

# ch/harems_full/office/events/office_harem_common.rpy:696
translate russian aletta_lavish_shiori_propose_male_f865e794:
    "И оно неизбежно вызовет уйму эмоций."

# ch/harems_full/office/events/office_harem_common.rpy:698
translate russian aletta_lavish_shiori_propose_male_13c7fcb6:
    "Я встаю и начинаю надевать кольца им на пальцы."

# ch/harems_full/office/events/office_harem_common.rpy:699
translate russian aletta_lavish_shiori_propose_male_d5d90334:
    "Вскоре всё готово, и девушки любуются новыми украшениями."

# ch/harems_full/office/events/office_harem_common.rpy:700
translate russian aletta_lavish_shiori_propose_male_78889186:
    "Мне хочется ущипнуть себя, чтобы убедиться, что всё происходит наяву."

# ch/harems_full/office/events/office_harem_common.rpy:701
translate russian aletta_lavish_shiori_propose_male_3db55a5d:
    "Я правда женюсь на всех троих?"

# ch/harems_full/office/events/office_harem_common.rpy:702
translate russian aletta_lavish_shiori_propose_male_4c5a0d94:
    aletta.say "Конец разгульной жизни, [lssb_common.hero_name()]."

# ch/harems_full/office/events/office_harem_common.rpy:703
translate russian aletta_lavish_shiori_propose_male_3c7629de:
    aletta.say "Ты станешь женатым человеком!"

# ch/harems_full/office/events/office_harem_common.rpy:704
translate russian aletta_lavish_shiori_propose_male_79920888:
    lavish.say "Ну... он может сказать о нас то же самое, Одри!"

# ch/harems_full/office/events/office_harem_common.rpy:705
translate russian aletta_lavish_shiori_propose_male_3d0aa6e6:
    lavish.say "В конце концов, брак — равноправное партнёрство."

# ch/harems_full/office/events/office_harem_common.rpy:706
translate russian aletta_lavish_shiori_propose_male_f5fb2207:
    shiori.say "Я... я не против быть старомодной женой."

# ch/harems_full/office/events/office_harem_common.rpy:707
translate russian aletta_lavish_shiori_propose_male_c38cab66:
    shiori.say "[lssb_common.hero_name()] может командовать мной сколько угодно!"

# ch/harems_full/office/events/office_harem_common.rpy:708
translate russian aletta_lavish_shiori_propose_male_15b9ffd0:
    "Слушая их разговор, я невольно улыбаюсь."

# ch/harems_full/office/events/office_harem_common.rpy:709
translate russian aletta_lavish_shiori_propose_male_a8d31bfa:
    "Конечно, компания у нас довольно странная."

# ch/harems_full/office/events/office_harem_common.rpy:710
translate russian aletta_lavish_shiori_propose_male_bc68ba24:
    "Но мне кажется, именно это и поможет нам ужиться."

# ch/harems_full/office/events/office_harem_common.rpy:711
translate russian aletta_lavish_shiori_propose_male_2df417ba:
    "Ведь каждому предстоит жить ещё с тремя людьми."

# ch/harems_full/office/events/office_harem_common.rpy:712
translate russian aletta_lavish_shiori_propose_male_ba9cf855:
    "Что может быть хуже, чем если бы все они были похожи на тебя?"

# ch/harems_full/office/events/office_harem_common.rpy:714
translate russian aletta_lavish_shiori_propose_male_2db28238:
    "Я встаю и неловко прячу в карман три кольца, которые теперь не нужны."

# ch/harems_full/office/events/office_harem_common.rpy:715
translate russian aletta_lavish_shiori_propose_male_f4c72828:
    "Все смотрят на меня, и унижение кажется полным."

# ch/harems_full/office/events/office_harem_common.rpy:716
translate russian aletta_lavish_shiori_propose_male_6280299a:
    "Хуже будет, только если с меня свалятся штаны или я вдруг вспыхну."

# ch/harems_full/office/events/office_harem_common.rpy:717
translate russian aletta_lavish_shiori_propose_male_c62fd749:
    "Хотя нет, беру слова обратно: такое хоть отвлекло бы внимание!"

# ch/harems_full/office/events/office_harem_common.rpy:719
translate russian aletta_lavish_shiori_propose_male_d98e6ad4:
    mike.say "Ладно..."

# ch/harems_full/office/events/office_harem_common.rpy:720
translate russian aletta_lavish_shiori_propose_male_1873393c:
    mike.say "Думаю, совещание окончено!"

# ch/harems_full/office/events/office_harem_common.rpy:721
translate russian aletta_lavish_shiori_propose_male_cfe19add:
    "Я разворачиваюсь и почти выбегаю из переговорной."

# ch/harems_full/office/events/office_harem_common.rpy:722
translate russian aletta_lavish_shiori_propose_male_d51d0fc9:
    "Я сбегаю, прежде чем успеваю услышать за спиной их голоса."

# ch/harems_full/office/events/office_harem_common.rpy:723
translate russian aletta_lavish_shiori_propose_male_bf431521:
    "Прежде чем придётся отвечать на вопросы, каждый из которых был бы пыткой."

# ch/harems_full/office/events/office_harem_common.rpy:724
translate russian aletta_lavish_shiori_propose_male_dba951ec:
    "Может, сейчас самое время использовать накопившиеся отпускные дни?"

# ch/harems_full/office/events/office_harem_common.rpy:725
translate russian aletta_lavish_shiori_propose_male_20f24199:
    "Или взять длительный отпуск и уйти в монастырь?"

# ch/harems_full/office/events/office_harem_common.rpy:726
translate russian aletta_lavish_shiori_propose_male_e06cc43b:
    "Что угодно, лишь бы подальше отсюда и от трёх женщин, которые одновременно мне отказали!"

# ch/harems_full/office/events/office_harem_common.rpy:728
translate russian aletta_lavish_shiori_propose_male_00507281:
    "Я встаю и надеваю кольца на все протянутые руки."

# ch/harems_full/office/events/office_harem_common.rpy:729
translate russian aletta_lavish_shiori_propose_male_145278ba:
    "Чувствую на себе взгляды тех, кто отказал, но стараюсь не обращать внимания."

# ch/harems_full/office/events/office_harem_common.rpy:730
translate russian aletta_lavish_shiori_propose_male_87970527:
    "Ох... будет тяжело."

# ch/harems_full/office/events/office_harem_common.rpy:731
translate russian aletta_lavish_shiori_propose_male_b9ff0ddc:
    "Я буду скучать по тем, кто сказал нет."

# ch/harems_full/office/events/office_harem_common.rpy:732
translate russian aletta_lavish_shiori_propose_male_76c588ba:
    "Но те из нас, кто решил быть вместе, должны и дальше идти вместе."

# ch/harems_full/office/events/office_harem_common.rpy:733
translate russian aletta_lavish_shiori_propose_male_30f16e1e:
    "Мы тесно обнимаемся, пока остальные неловко выходят из комнаты."

# ch/harems_full/office/events/office_harem_common.rpy:734
translate russian aletta_lavish_shiori_propose_male_adb1481c:
    "Мы вступаем на неизведанную территорию."

# ch/harems_full/office/events/office_harem_common.rpy:735
translate russian aletta_lavish_shiori_propose_male_d873522f:
    "Но любовь, которую я чувствую от своих будущих жён, убеждает меня: у нас всё получится."

# ch/harems_full/office/events/office_harem_common.rpy:739
translate russian aletta_audrey_shiori_propose_male_364318ef:
    "Поддерживать хорошие отношения со всеми девушками в офисе — всё равно что жонглировать бензопилами."

# ch/harems_full/office/events/office_harem_common.rpy:740
translate russian aletta_audrey_shiori_propose_male_e341b6eb:
    "Это требует всей моей сосредоточенности и ловкости."

# ch/harems_full/office/events/office_harem_common.rpy:741
translate russian aletta_audrey_shiori_propose_male_96d190b1:
    "И одна-единственная ошибка может обернуться для меня смертельно опасной ситуацией!"

# ch/harems_full/office/events/office_harem_common.rpy:742
translate russian aletta_audrey_shiori_propose_male_b1997792:
    "Так что вы наверняка спросите, зачем мне вообще думать о предложении им всем."

# ch/harems_full/office/events/office_harem_common.rpy:743
translate russian aletta_audrey_shiori_propose_male_4fde221b:
    "Но выслушайте меня, ладно?"

# ch/harems_full/office/events/office_harem_common.rpy:744
translate russian aletta_audrey_shiori_propose_male_65bbe4f6:
    "По-моему, если мы поженимся, всё станет официально, верно?"

# ch/harems_full/office/events/office_harem_common.rpy:745
translate russian aletta_audrey_shiori_propose_male_df9c8fe5:
    "Больше не придётся тайком встречаться за чужими спинами и бояться, что нас застукают."

# ch/harems_full/office/events/office_harem_common.rpy:746
translate russian aletta_audrey_shiori_propose_male_afee1c3e:
    "Я прекрасно знаю, что многожёнство в нашей стране разрешили совсем недавно."

# ch/harems_full/office/events/office_harem_common.rpy:747
translate russian aletta_audrey_shiori_propose_male_8136ba76:
    "Но, по мне, жениться на трёх не так уж отличается от женитьбы на двух."

# ch/harems_full/office/events/office_harem_common.rpy:748
translate russian aletta_audrey_shiori_propose_male_a1ab3626:
    "Нет, настоящая разница в том, что придётся раскошелиться на три чёртовых кольца!"

# ch/harems_full/office/events/office_harem_common.rpy:749
translate russian aletta_audrey_shiori_propose_male_a7aef0b5:
    "И ещё собрать их всех в одном месте, чтобы сделать предложение."

# ch/harems_full/office/events/office_harem_common.rpy:750
translate russian aletta_audrey_shiori_propose_male_2687003b:
    "В конце концов я решаю притвориться, будто созываю совещание."

# ch/harems_full/office/events/office_harem_common.rpy:751
translate russian aletta_audrey_shiori_propose_male_98304d93:
    "Вот почему сейчас жду их в переговорной."

# ch/harems_full/office/events/office_harem_common.rpy:753
translate russian aletta_audrey_shiori_propose_male_8d38f9ef:
    "Алетта приходит первой, с очень деловым видом."

# ch/harems_full/office/events/office_harem_common.rpy:755
translate russian aletta_audrey_shiori_propose_male_3ff50c07:
    "Чуть позже нехотя подтягивается Одри: хмурая, больше занятая телефоном, чем работой."

# ch/harems_full/office/events/office_harem_common.rpy:756
translate russian aletta_audrey_shiori_propose_male_ac4b2b2c:
    "Я уже собираюсь закрыть дверь, когда вбегает Сиори."

# ch/harems_full/office/events/office_harem_common.rpy:758
translate russian aletta_audrey_shiori_propose_male_5738db24:
    shiori.say "Прости, пожалуйста, [lssb_common.hero_name()]."

# ch/harems_full/office/events/office_harem_common.rpy:759
translate russian aletta_audrey_shiori_propose_male_e9521209:
    shiori.say "Тот, кто подвозил меня на работу, опоздал."

# ch/harems_full/office/events/office_harem_common.rpy:760
translate russian aletta_audrey_shiori_propose_male_dd1efdc0:
    shiori.say "А потом оказалось, что лифты не работают."

# ch/harems_full/office/events/office_harem_common.rpy:761
translate russian aletta_audrey_shiori_propose_male_d74f7ff5:
    shiori.say "А потом..."

# ch/harems_full/office/events/office_harem_common.rpy:762
translate russian aletta_audrey_shiori_propose_male_3406129d:
    mike.say "Всё хорошо, Сиори..."

# ch/harems_full/office/events/office_harem_common.rpy:763
translate russian aletta_audrey_shiori_propose_male_193b86af:
    mike.say "Просто проходи и садись."

# ch/harems_full/office/events/office_harem_common.rpy:764
translate russian aletta_audrey_shiori_propose_male_3e5cf0cb:
    "Сиори кивает и спешит выполнить просьбу."

# ch/harems_full/office/events/office_harem_common.rpy:765
translate russian aletta_audrey_shiori_propose_male_e72d4c14:
    "Я подхожу к торцу стола, и все смотрят на меня."

# ch/harems_full/office/events/office_harem_common.rpy:766
translate russian aletta_audrey_shiori_propose_male_12820c04:
    aletta.say "Должна сказать, это непрофессионально, [lssb_common.hero_name()]."

# ch/harems_full/office/events/office_harem_common.rpy:768
translate russian aletta_audrey_shiori_propose_male_81173a57:
    aletta.say "Ты совсем не предупредил меня о совещании!"

# ch/harems_full/office/events/office_harem_common.rpy:769
translate russian aletta_audrey_shiori_propose_male_7c1997fb:
    audrey.say "Кого это, чёрт возьми, волнует?"

# ch/harems_full/office/events/office_harem_common.rpy:770
translate russian aletta_audrey_shiori_propose_male_d0d58d00:
    audrey.say "Давайте уже закончим и уберёмся отсюда!"

# ch/harems_full/office/events/office_harem_common.rpy:771
translate russian aletta_audrey_shiori_propose_male_f4e3a950:
    "Я натягиваю улыбку, убеждая себя, что это хорошая идея."

# ch/harems_full/office/events/office_harem_common.rpy:772
translate russian aletta_audrey_shiori_propose_male_e5096f0b:
    "Я ведь люблю каждую из этих девушек, правда люблю."

# ch/harems_full/office/events/office_harem_common.rpy:773
translate russian aletta_audrey_shiori_propose_male_fb5985a9:
    "Но прекрасно знаю, что временами они все могут быть той ещё занозой в заднице!"

# ch/harems_full/office/events/office_harem_common.rpy:775
translate russian aletta_audrey_shiori_propose_male_4ab6d240:
    mike.say "Я не предупредил о встрече, потому что хотел сделать сюрприз."

# ch/harems_full/office/events/office_harem_common.rpy:776
translate russian aletta_audrey_shiori_propose_male_106c67c0:
    mike.say "И мне нужно было собрать вас всех вместе, чтобы сделать вот что..."

# ch/harems_full/office/events/office_harem_common.rpy:777
translate russian aletta_audrey_shiori_propose_male_79910399:
    "Я опускаюсь на одно колено и достаю из кармана три одинаковых кольца."

# ch/harems_full/office/events/office_harem_common.rpy:778
translate russian aletta_audrey_shiori_propose_male_fec5f5b5:
    mike.say "Алетта, Одри, Сиори..."

# ch/harems_full/office/events/office_harem_common.rpy:780
translate russian aletta_audrey_shiori_propose_male_c795a089:
    mike.say "И друг за друга, наверное, тоже!"

# ch/harems_full/office/events/office_harem_common.rpy:784
translate russian aletta_audrey_shiori_propose_male_b5700755:
    "Впервые на моей памяти все они лишаются дара речи."

# ch/harems_full/office/events/office_harem_common.rpy:785
translate russian aletta_audrey_shiori_propose_male_4af83198:
    "Девушки смотрят на меня, затем переглядываются."

# ch/harems_full/office/events/office_harem_common.rpy:786
translate russian aletta_audrey_shiori_propose_male_c6c3d050:
    "А я всё ещё стою на одном колене и жду ответа."

# ch/harems_full/office/events/office_harem_common.rpy:789
translate russian aletta_audrey_shiori_propose_male_32e7a398:
    "Алетта по привычке сохраняет властный вид."

# ch/harems_full/office/events/office_harem_common.rpy:790
translate russian aletta_audrey_shiori_propose_male_778a549a:
    "Отвечает первой, твёрдо и уверенно."

# ch/harems_full/office/events/office_harem_common.rpy:791
translate russian aletta_audrey_shiori_propose_male_3f93e7ee:
    aletta.say "Определённо нет."

# ch/harems_full/office/events/office_harem_common.rpy:792
translate russian aletta_audrey_shiori_propose_male_4b4ee576:
    aletta.say "Для меня эти отношения прежде всего деловая договорённость."

# ch/harems_full/office/events/office_harem_common.rpy:793
translate russian aletta_audrey_shiori_propose_male_b0512339:
    aletta.say "И я не согласна превращать их в юридические обязательства."

# ch/harems_full/office/events/office_harem_common.rpy:797
translate russian aletta_audrey_shiori_propose_male_32e7a398_1:
    "Алетта по привычке сохраняет властный вид."

# ch/harems_full/office/events/office_harem_common.rpy:798
translate russian aletta_audrey_shiori_propose_male_778a549a_1:
    "Отвечает первой, твёрдо и уверенно."

# ch/harems_full/office/events/office_harem_common.rpy:800
translate russian aletta_audrey_shiori_propose_male_7760ffd5:
    aletta.say "Да, [lssb_common.hero_name()]."

# ch/harems_full/office/events/office_harem_common.rpy:801
translate russian aletta_audrey_shiori_propose_male_90dd339c:
    aletta.say "Признаюсь, в начале наших отношений я была... настроена скептически."

# ch/harems_full/office/events/office_harem_common.rpy:802
translate russian aletta_audrey_shiori_propose_male_541a9e8a:
    aletta.say "Но всё оказалось гораздо лучше, чем я могла представить."

# ch/harems_full/office/events/office_harem_common.rpy:806
translate russian aletta_audrey_shiori_propose_male_947bcb8b:
    "Одри странно кривится, словно усиленно думает."

# ch/harems_full/office/events/office_harem_common.rpy:807
translate russian aletta_audrey_shiori_propose_male_7a5bdb84:
    "А затем отвечает с обычной прямотой."

# ch/harems_full/office/events/office_harem_common.rpy:808
translate russian aletta_audrey_shiori_propose_male_90eda6e5:
    audrey.say "Чёрта с два! Ещё не хватало выйти за вас, неудачников!"

# ch/harems_full/office/events/office_harem_common.rpy:809
translate russian aletta_audrey_shiori_propose_male_5860ad2b:
    audrey.say "Мне уже достаточно того, что приходится с вами работать."

# ch/harems_full/office/events/office_harem_common.rpy:810
translate russian aletta_audrey_shiori_propose_male_d3306c4e:
    audrey.say "Забудьте о том, чтобы провести вместе ещё и всю жизнь!"

# ch/harems_full/office/events/office_harem_common.rpy:814
translate russian aletta_audrey_shiori_propose_male_947bcb8b_1:
    "Одри странно кривится, словно усиленно думает."

# ch/harems_full/office/events/office_harem_common.rpy:815
translate russian aletta_audrey_shiori_propose_male_7a5bdb84_1:
    "А затем отвечает с обычной прямотой."

# ch/harems_full/office/events/office_harem_common.rpy:817
translate russian aletta_audrey_shiori_propose_male_17387692:
    audrey.say "Да, я согласна."

# ch/harems_full/office/events/office_harem_common.rpy:818
translate russian aletta_audrey_shiori_propose_male_e53de238:
    audrey.say "Вы все по-прежнему слишком зажатые."

# ch/harems_full/office/events/office_harem_common.rpy:819
translate russian aletta_audrey_shiori_propose_male_19aa4504:
    audrey.say "И без меня вам эти палки из задниц не вытащить!"

# ch/harems_full/office/events/office_harem_common.rpy:823
translate russian aletta_audrey_shiori_propose_male_b134dbfd:
    "Сиори обводит взглядом всех присутствующих."

# ch/harems_full/office/events/office_harem_common.rpy:824
translate russian aletta_audrey_shiori_propose_male_0841ed9b:
    "На мгновение мне кажется, что она попросит их решить за неё."

# ch/harems_full/office/events/office_harem_common.rpy:825
translate russian aletta_audrey_shiori_propose_male_dd9a67f1:
    "Но в конце концов набирается смелости высказаться сама."

# ch/harems_full/office/events/office_harem_common.rpy:826
translate russian aletta_audrey_shiori_propose_male_0c945ab9:
    shiori.say "Я... я говорю нет."

# ch/harems_full/office/events/office_harem_common.rpy:827
translate russian aletta_audrey_shiori_propose_male_fc11a726:
    shiori.say "Мне кажется, я теряю себя в этих отношениях."

# ch/harems_full/office/events/office_harem_common.rpy:828
translate russian aletta_audrey_shiori_propose_male_f21a3a74:
    shiori.say "Будто все воспринимают меня как должное и не замечают!"

# ch/harems_full/office/events/office_harem_common.rpy:832
translate russian aletta_audrey_shiori_propose_male_b134dbfd_1:
    "Сиори обводит взглядом всех присутствующих."

# ch/harems_full/office/events/office_harem_common.rpy:833
translate russian aletta_audrey_shiori_propose_male_0841ed9b_1:
    "На мгновение мне кажется, что она попросит их решить за неё."

# ch/harems_full/office/events/office_harem_common.rpy:834
translate russian aletta_audrey_shiori_propose_male_dd9a67f1_1:
    "Но в конце концов набирается смелости высказаться сама."

# ch/harems_full/office/events/office_harem_common.rpy:836
translate russian aletta_audrey_shiori_propose_male_e482cd60:
    shiori.say "Я... я говорю да."

# ch/harems_full/office/events/office_harem_common.rpy:837
translate russian aletta_audrey_shiori_propose_male_8714c3bc:
    shiori.say "Мне нравится быть в отношениях со всеми вами."

# ch/harems_full/office/events/office_harem_common.rpy:838
translate russian aletta_audrey_shiori_propose_male_18c577cd:
    shiori.say "Я больше не чувствую себя одинокой и потерянной!"

# ch/harems_full/office/events/office_harem_common.rpy:840
translate russian aletta_audrey_shiori_propose_male_b4daf315:
    "Слушая их ответы, я чувствую, как колотится сердце."

# ch/harems_full/office/events/office_harem_common.rpy:841
translate russian aletta_audrey_shiori_propose_male_8f6f25a5:
    "Но разве могло быть иначе?"

# ch/harems_full/office/events/office_harem_common.rpy:842
translate russian aletta_audrey_shiori_propose_male_edd36fb9:
    "Я прошу их принять очень важное решение."

# ch/harems_full/office/events/office_harem_common.rpy:843
translate russian aletta_audrey_shiori_propose_male_f865e794:
    "И оно неизбежно вызовет уйму эмоций."

# ch/harems_full/office/events/office_harem_common.rpy:845
translate russian aletta_audrey_shiori_propose_male_13c7fcb6:
    "Я встаю и начинаю надевать кольца им на пальцы."

# ch/harems_full/office/events/office_harem_common.rpy:846
translate russian aletta_audrey_shiori_propose_male_d5d90334:
    "Вскоре всё готово, и девушки любуются новыми украшениями."

# ch/harems_full/office/events/office_harem_common.rpy:847
translate russian aletta_audrey_shiori_propose_male_78889186:
    "Мне хочется ущипнуть себя, чтобы убедиться, что всё происходит наяву."

# ch/harems_full/office/events/office_harem_common.rpy:848
translate russian aletta_audrey_shiori_propose_male_3db55a5d:
    "Я правда женюсь на всех троих?"

# ch/harems_full/office/events/office_harem_common.rpy:849
translate russian aletta_audrey_shiori_propose_male_4c5a0d94:
    aletta.say "Конец разгульной жизни, [lssb_common.hero_name()]."

# ch/harems_full/office/events/office_harem_common.rpy:850
translate russian aletta_audrey_shiori_propose_male_3c7629de:
    aletta.say "Ты станешь женатым человеком!"

# ch/harems_full/office/events/office_harem_common.rpy:851
translate russian aletta_audrey_shiori_propose_male_3e2cce37:
    audrey.say "Да, [lssb_common.hero_name()], теперь твоя задница принадлежит нам!"

# ch/harems_full/office/events/office_harem_common.rpy:852
translate russian aletta_audrey_shiori_propose_male_f5fb2207:
    shiori.say "Я... я не против быть старомодной женой."

# ch/harems_full/office/events/office_harem_common.rpy:853
translate russian aletta_audrey_shiori_propose_male_c38cab66:
    shiori.say "[lssb_common.hero_name()] может командовать мной сколько угодно!"

# ch/harems_full/office/events/office_harem_common.rpy:854
translate russian aletta_audrey_shiori_propose_male_cee381b3:
    audrey.say "Господи..."

# ch/harems_full/office/events/office_harem_common.rpy:855
translate russian aletta_audrey_shiori_propose_male_65f608cb:
    audrey.say "Вот так и становятся тряпкой, Сиори!"

# ch/harems_full/office/events/office_harem_common.rpy:856
translate russian aletta_audrey_shiori_propose_male_15b9ffd0:
    "Слушая их разговор, я невольно улыбаюсь."

# ch/harems_full/office/events/office_harem_common.rpy:857
translate russian aletta_audrey_shiori_propose_male_a8d31bfa:
    "Конечно, компания у нас довольно странная."

# ch/harems_full/office/events/office_harem_common.rpy:858
translate russian aletta_audrey_shiori_propose_male_bc68ba24:
    "Но мне кажется, именно это и поможет нам ужиться."

# ch/harems_full/office/events/office_harem_common.rpy:859
translate russian aletta_audrey_shiori_propose_male_2df417ba:
    "Ведь каждому предстоит жить ещё с тремя людьми."

# ch/harems_full/office/events/office_harem_common.rpy:860
translate russian aletta_audrey_shiori_propose_male_ba9cf855:
    "Что может быть хуже, чем если бы все они были похожи на тебя?"

# ch/harems_full/office/events/office_harem_common.rpy:862
translate russian aletta_audrey_shiori_propose_male_2db28238:
    "Я встаю и неловко прячу в карман три кольца, которые теперь не нужны."

# ch/harems_full/office/events/office_harem_common.rpy:863
translate russian aletta_audrey_shiori_propose_male_f4c72828:
    "Все смотрят на меня, и унижение кажется полным."

# ch/harems_full/office/events/office_harem_common.rpy:864
translate russian aletta_audrey_shiori_propose_male_6280299a:
    "Хуже будет, только если с меня свалятся штаны или я вдруг вспыхну."

# ch/harems_full/office/events/office_harem_common.rpy:865
translate russian aletta_audrey_shiori_propose_male_c62fd749:
    "Хотя нет, беру слова обратно: такое хоть отвлекло бы внимание!"

# ch/harems_full/office/events/office_harem_common.rpy:867
translate russian aletta_audrey_shiori_propose_male_d98e6ad4:
    mike.say "Ладно..."

# ch/harems_full/office/events/office_harem_common.rpy:868
translate russian aletta_audrey_shiori_propose_male_1873393c:
    mike.say "Думаю, совещание окончено!"

# ch/harems_full/office/events/office_harem_common.rpy:869
translate russian aletta_audrey_shiori_propose_male_cfe19add:
    "Я разворачиваюсь и почти выбегаю из переговорной."

# ch/harems_full/office/events/office_harem_common.rpy:870
translate russian aletta_audrey_shiori_propose_male_d51d0fc9:
    "Я сбегаю, прежде чем успеваю услышать за спиной их голоса."

# ch/harems_full/office/events/office_harem_common.rpy:871
translate russian aletta_audrey_shiori_propose_male_bf431521:
    "Прежде чем придётся отвечать на вопросы, каждый из которых был бы пыткой."

# ch/harems_full/office/events/office_harem_common.rpy:872
translate russian aletta_audrey_shiori_propose_male_dba951ec:
    "Может, сейчас самое время использовать накопившиеся отпускные дни?"

# ch/harems_full/office/events/office_harem_common.rpy:873
translate russian aletta_audrey_shiori_propose_male_20f24199:
    "Или взять длительный отпуск и уйти в монастырь?"

# ch/harems_full/office/events/office_harem_common.rpy:874
translate russian aletta_audrey_shiori_propose_male_e06cc43b:
    "Что угодно, лишь бы подальше отсюда и от трёх женщин, которые одновременно мне отказали!"

# ch/harems_full/office/events/office_harem_common.rpy:876
translate russian aletta_audrey_shiori_propose_male_00507281:
    "Я встаю и надеваю кольца на все протянутые руки."

# ch/harems_full/office/events/office_harem_common.rpy:877
translate russian aletta_audrey_shiori_propose_male_145278ba:
    "Чувствую на себе взгляды тех, кто отказал, но стараюсь не обращать внимания."

# ch/harems_full/office/events/office_harem_common.rpy:878
translate russian aletta_audrey_shiori_propose_male_87970527:
    "Ох... будет тяжело."

# ch/harems_full/office/events/office_harem_common.rpy:879
translate russian aletta_audrey_shiori_propose_male_b9ff0ddc:
    "Я буду скучать по тем, кто сказал нет."

# ch/harems_full/office/events/office_harem_common.rpy:880
translate russian aletta_audrey_shiori_propose_male_76c588ba:
    "Но те из нас, кто решил быть вместе, должны и дальше идти вместе."

# ch/harems_full/office/events/office_harem_common.rpy:881
translate russian aletta_audrey_shiori_propose_male_30f16e1e:
    "Мы тесно обнимаемся, пока остальные неловко выходят из комнаты."

# ch/harems_full/office/events/office_harem_common.rpy:882
translate russian aletta_audrey_shiori_propose_male_adb1481c:
    "Мы вступаем на неизведанную территорию."

# ch/harems_full/office/events/office_harem_common.rpy:883
translate russian aletta_audrey_shiori_propose_male_d873522f:
    "Но любовь, которую я чувствую от своих будущих жён, убеждает меня: у нас всё получится."

# ch/harems_full/office/events/office_harem_common.rpy:887
translate russian aletta_audrey_lavish_propose_male_364318ef:
    "Поддерживать хорошие отношения со всеми девушками в офисе — всё равно что жонглировать бензопилами."

# ch/harems_full/office/events/office_harem_common.rpy:888
translate russian aletta_audrey_lavish_propose_male_e341b6eb:
    "Это требует всей моей сосредоточенности и ловкости."

# ch/harems_full/office/events/office_harem_common.rpy:889
translate russian aletta_audrey_lavish_propose_male_96d190b1:
    "И одна-единственная ошибка может обернуться для меня смертельно опасной ситуацией!"

# ch/harems_full/office/events/office_harem_common.rpy:890
translate russian aletta_audrey_lavish_propose_male_b1997792:
    "Так что вы наверняка спросите, зачем мне вообще думать о предложении им всем."

# ch/harems_full/office/events/office_harem_common.rpy:891
translate russian aletta_audrey_lavish_propose_male_4fde221b:
    "Но выслушайте меня, ладно?"

# ch/harems_full/office/events/office_harem_common.rpy:892
translate russian aletta_audrey_lavish_propose_male_65bbe4f6:
    "По-моему, если мы поженимся, всё станет официально, верно?"

# ch/harems_full/office/events/office_harem_common.rpy:893
translate russian aletta_audrey_lavish_propose_male_df9c8fe5:
    "Больше не придётся тайком встречаться за чужими спинами и бояться, что нас застукают."

# ch/harems_full/office/events/office_harem_common.rpy:894
translate russian aletta_audrey_lavish_propose_male_afee1c3e:
    "Я прекрасно знаю, что многожёнство в нашей стране разрешили совсем недавно."

# ch/harems_full/office/events/office_harem_common.rpy:895
translate russian aletta_audrey_lavish_propose_male_8136ba76:
    "Но, по мне, жениться на трёх не так уж отличается от женитьбы на двух."

# ch/harems_full/office/events/office_harem_common.rpy:896
translate russian aletta_audrey_lavish_propose_male_a1ab3626:
    "Нет, настоящая разница в том, что придётся раскошелиться на три чёртовых кольца!"

# ch/harems_full/office/events/office_harem_common.rpy:897
translate russian aletta_audrey_lavish_propose_male_a7aef0b5:
    "И ещё собрать их всех в одном месте, чтобы сделать предложение."

# ch/harems_full/office/events/office_harem_common.rpy:898
translate russian aletta_audrey_lavish_propose_male_2687003b:
    "В конце концов я решаю притвориться, будто созываю совещание."

# ch/harems_full/office/events/office_harem_common.rpy:899
translate russian aletta_audrey_lavish_propose_male_98304d93:
    "Вот почему сейчас жду их в переговорной."

# ch/harems_full/office/events/office_harem_common.rpy:901
translate russian aletta_audrey_lavish_propose_male_8d38f9ef:
    "Алетта приходит первой, с очень деловым видом."

# ch/harems_full/office/events/office_harem_common.rpy:903
translate russian aletta_audrey_lavish_propose_male_86c46c0c:
    "Следом входит Лавиш, как всегда собранная и готовая к совещанию."

# ch/harems_full/office/events/office_harem_common.rpy:905
translate russian aletta_audrey_lavish_propose_male_3ff50c07:
    "Чуть позже нехотя подтягивается Одри: хмурая, больше занятая телефоном, чем работой."

# ch/harems_full/office/events/office_harem_common.rpy:906
translate russian aletta_audrey_lavish_propose_male_e72d4c14:
    "Я подхожу к торцу стола, и все смотрят на меня."

# ch/harems_full/office/events/office_harem_common.rpy:907
translate russian aletta_audrey_lavish_propose_male_12820c04:
    aletta.say "Должна сказать, это непрофессионально, [lssb_common.hero_name()]."

# ch/harems_full/office/events/office_harem_common.rpy:909
translate russian aletta_audrey_lavish_propose_male_81173a57:
    aletta.say "Ты совсем не предупредил меня о совещании!"

# ch/harems_full/office/events/office_harem_common.rpy:910
translate russian aletta_audrey_lavish_propose_male_ba5b29d4:
    lavish.say "Алетта права, [lssb_common.hero_name()]."

# ch/harems_full/office/events/office_harem_common.rpy:912
translate russian aletta_audrey_lavish_propose_male_e866e559:
    lavish.say "Я не успела подготовиться за такое короткое время."

# ch/harems_full/office/events/office_harem_common.rpy:913
translate russian aletta_audrey_lavish_propose_male_1bb5b922:
    audrey.say "Значит, не сделала домашнее задание, Лавиш."

# ch/harems_full/office/events/office_harem_common.rpy:914
translate russian aletta_audrey_lavish_propose_male_7c1997fb:
    audrey.say "Кого это, чёрт возьми, волнует?"

# ch/harems_full/office/events/office_harem_common.rpy:915
translate russian aletta_audrey_lavish_propose_male_d0d58d00:
    audrey.say "Давайте уже закончим и уберёмся отсюда!"

# ch/harems_full/office/events/office_harem_common.rpy:916
translate russian aletta_audrey_lavish_propose_male_f4e3a950:
    "Я натягиваю улыбку, убеждая себя, что это хорошая идея."

# ch/harems_full/office/events/office_harem_common.rpy:917
translate russian aletta_audrey_lavish_propose_male_e5096f0b:
    "Я ведь люблю каждую из этих девушек, правда люблю."

# ch/harems_full/office/events/office_harem_common.rpy:918
translate russian aletta_audrey_lavish_propose_male_fb5985a9:
    "Но прекрасно знаю, что временами они все могут быть той ещё занозой в заднице!"

# ch/harems_full/office/events/office_harem_common.rpy:920
translate russian aletta_audrey_lavish_propose_male_4ab6d240:
    mike.say "Я не предупредил о встрече, потому что хотел сделать сюрприз."

# ch/harems_full/office/events/office_harem_common.rpy:921
translate russian aletta_audrey_lavish_propose_male_106c67c0:
    mike.say "И мне нужно было собрать вас всех вместе, чтобы сделать вот что..."

# ch/harems_full/office/events/office_harem_common.rpy:922
translate russian aletta_audrey_lavish_propose_male_79910399:
    "Я опускаюсь на одно колено и достаю из кармана три одинаковых кольца."

# ch/harems_full/office/events/office_harem_common.rpy:923
translate russian aletta_audrey_lavish_propose_male_447606c5:
    mike.say "Алетта, Одри, Лавиш..."

# ch/harems_full/office/events/office_harem_common.rpy:925
translate russian aletta_audrey_lavish_propose_male_c795a089:
    mike.say "И друг за друга, наверное, тоже!"

# ch/harems_full/office/events/office_harem_common.rpy:929
translate russian aletta_audrey_lavish_propose_male_b5700755:
    "Впервые на моей памяти все они лишаются дара речи."

# ch/harems_full/office/events/office_harem_common.rpy:930
translate russian aletta_audrey_lavish_propose_male_4af83198:
    "Девушки смотрят на меня, затем переглядываются."

# ch/harems_full/office/events/office_harem_common.rpy:931
translate russian aletta_audrey_lavish_propose_male_c6c3d050:
    "А я всё ещё стою на одном колене и жду ответа."

# ch/harems_full/office/events/office_harem_common.rpy:934
translate russian aletta_audrey_lavish_propose_male_32e7a398:
    "Алетта по привычке сохраняет властный вид."

# ch/harems_full/office/events/office_harem_common.rpy:935
translate russian aletta_audrey_lavish_propose_male_778a549a:
    "Отвечает первой, твёрдо и уверенно."

# ch/harems_full/office/events/office_harem_common.rpy:936
translate russian aletta_audrey_lavish_propose_male_3f93e7ee:
    aletta.say "Определённо нет."

# ch/harems_full/office/events/office_harem_common.rpy:937
translate russian aletta_audrey_lavish_propose_male_4b4ee576:
    aletta.say "Для меня эти отношения прежде всего деловая договорённость."

# ch/harems_full/office/events/office_harem_common.rpy:938
translate russian aletta_audrey_lavish_propose_male_b0512339:
    aletta.say "И я не согласна превращать их в юридические обязательства."

# ch/harems_full/office/events/office_harem_common.rpy:942
translate russian aletta_audrey_lavish_propose_male_32e7a398_1:
    "Алетта по привычке сохраняет властный вид."

# ch/harems_full/office/events/office_harem_common.rpy:943
translate russian aletta_audrey_lavish_propose_male_778a549a_1:
    "Отвечает первой, твёрдо и уверенно."

# ch/harems_full/office/events/office_harem_common.rpy:945
translate russian aletta_audrey_lavish_propose_male_7760ffd5:
    aletta.say "Да, [lssb_common.hero_name()]."

# ch/harems_full/office/events/office_harem_common.rpy:946
translate russian aletta_audrey_lavish_propose_male_90dd339c:
    aletta.say "Признаюсь, в начале наших отношений я была... настроена скептически."

# ch/harems_full/office/events/office_harem_common.rpy:947
translate russian aletta_audrey_lavish_propose_male_541a9e8a:
    aletta.say "Но всё оказалось гораздо лучше, чем я могла представить."

# ch/harems_full/office/events/office_harem_common.rpy:951
translate russian aletta_audrey_lavish_propose_male_947bcb8b:
    "Одри странно кривится, словно усиленно думает."

# ch/harems_full/office/events/office_harem_common.rpy:952
translate russian aletta_audrey_lavish_propose_male_7a5bdb84:
    "А затем отвечает с обычной прямотой."

# ch/harems_full/office/events/office_harem_common.rpy:953
translate russian aletta_audrey_lavish_propose_male_90eda6e5:
    audrey.say "Чёрта с два! Ещё не хватало выйти за вас, неудачников!"

# ch/harems_full/office/events/office_harem_common.rpy:954
translate russian aletta_audrey_lavish_propose_male_5860ad2b:
    audrey.say "Мне уже достаточно того, что приходится с вами работать."

# ch/harems_full/office/events/office_harem_common.rpy:955
translate russian aletta_audrey_lavish_propose_male_d3306c4e:
    audrey.say "Забудьте о том, чтобы провести вместе ещё и всю жизнь!"

# ch/harems_full/office/events/office_harem_common.rpy:959
translate russian aletta_audrey_lavish_propose_male_947bcb8b_1:
    "Одри странно кривится, словно усиленно думает."

# ch/harems_full/office/events/office_harem_common.rpy:960
translate russian aletta_audrey_lavish_propose_male_7a5bdb84_1:
    "А затем отвечает с обычной прямотой."

# ch/harems_full/office/events/office_harem_common.rpy:962
translate russian aletta_audrey_lavish_propose_male_17387692:
    audrey.say "Да, я согласна."

# ch/harems_full/office/events/office_harem_common.rpy:963
translate russian aletta_audrey_lavish_propose_male_e53de238:
    audrey.say "Вы все по-прежнему слишком зажатые."

# ch/harems_full/office/events/office_harem_common.rpy:964
translate russian aletta_audrey_lavish_propose_male_19aa4504:
    audrey.say "И без меня вам эти палки из задниц не вытащить!"

# ch/harems_full/office/events/office_harem_common.rpy:968
translate russian aletta_audrey_lavish_propose_male_a94738bd:
    "Лавиш выглядит задумчивой, словно всерьёз взвешивает ответ."

# ch/harems_full/office/events/office_harem_common.rpy:969
translate russian aletta_audrey_lavish_propose_male_539a5760:
    "Затем кивает и коротко выдыхает."

# ch/harems_full/office/events/office_harem_common.rpy:970
translate russian aletta_audrey_lavish_propose_male_4879009e:
    lavish.say "Придётся сказать нет."

# ch/harems_full/office/events/office_harem_common.rpy:971
translate russian aletta_audrey_lavish_propose_male_a845c91a:
    lavish.say "Не думаю, что эти отношения идут мне на пользу."

# ch/harems_full/office/events/office_harem_common.rpy:972
translate russian aletta_audrey_lavish_propose_male_f79e418c:
    lavish.say "И, скорее всего, помешают моим долгосрочным карьерным планам."

# ch/harems_full/office/events/office_harem_common.rpy:976
translate russian aletta_audrey_lavish_propose_male_a94738bd_1:
    "Лавиш выглядит задумчивой, словно всерьёз взвешивает ответ."

# ch/harems_full/office/events/office_harem_common.rpy:977
translate russian aletta_audrey_lavish_propose_male_539a5760_1:
    "Затем кивает и коротко выдыхает."

# ch/harems_full/office/events/office_harem_common.rpy:979
translate russian aletta_audrey_lavish_propose_male_26ac0382:
    lavish.say "Я говорю да."

# ch/harems_full/office/events/office_harem_common.rpy:980
translate russian aletta_audrey_lavish_propose_male_f804e109:
    lavish.say "Отношения у нас, конечно, немного странные."

# ch/harems_full/office/events/office_harem_common.rpy:981
translate russian aletta_audrey_lavish_propose_male_9618b8ed:
    lavish.say "Но всё, похоже, получается, и мне очень нравится!"

# ch/harems_full/office/events/office_harem_common.rpy:983
translate russian aletta_audrey_lavish_propose_male_b4daf315:
    "Слушая их ответы, я чувствую, как колотится сердце."

# ch/harems_full/office/events/office_harem_common.rpy:984
translate russian aletta_audrey_lavish_propose_male_8f6f25a5:
    "Но разве могло быть иначе?"

# ch/harems_full/office/events/office_harem_common.rpy:985
translate russian aletta_audrey_lavish_propose_male_edd36fb9:
    "Я прошу их принять очень важное решение."

# ch/harems_full/office/events/office_harem_common.rpy:986
translate russian aletta_audrey_lavish_propose_male_f865e794:
    "И оно неизбежно вызовет уйму эмоций."

# ch/harems_full/office/events/office_harem_common.rpy:988
translate russian aletta_audrey_lavish_propose_male_13c7fcb6:
    "Я встаю и начинаю надевать кольца им на пальцы."

# ch/harems_full/office/events/office_harem_common.rpy:989
translate russian aletta_audrey_lavish_propose_male_d5d90334:
    "Вскоре всё готово, и девушки любуются новыми украшениями."

# ch/harems_full/office/events/office_harem_common.rpy:990
translate russian aletta_audrey_lavish_propose_male_78889186:
    "Мне хочется ущипнуть себя, чтобы убедиться, что всё происходит наяву."

# ch/harems_full/office/events/office_harem_common.rpy:991
translate russian aletta_audrey_lavish_propose_male_3db55a5d:
    "Я правда женюсь на всех троих?"

# ch/harems_full/office/events/office_harem_common.rpy:992
translate russian aletta_audrey_lavish_propose_male_4c5a0d94:
    aletta.say "Конец разгульной жизни, [lssb_common.hero_name()]."

# ch/harems_full/office/events/office_harem_common.rpy:993
translate russian aletta_audrey_lavish_propose_male_3c7629de:
    aletta.say "Ты станешь женатым человеком!"

# ch/harems_full/office/events/office_harem_common.rpy:994
translate russian aletta_audrey_lavish_propose_male_3e2cce37:
    audrey.say "Да, [lssb_common.hero_name()], теперь твоя задница принадлежит нам!"

# ch/harems_full/office/events/office_harem_common.rpy:995
translate russian aletta_audrey_lavish_propose_male_79920888:
    lavish.say "Ну... он может сказать о нас то же самое, Одри!"

# ch/harems_full/office/events/office_harem_common.rpy:996
translate russian aletta_audrey_lavish_propose_male_3d0aa6e6:
    lavish.say "В конце концов, брак — равноправное партнёрство."

# ch/harems_full/office/events/office_harem_common.rpy:997
translate russian aletta_audrey_lavish_propose_male_cee381b3:
    audrey.say "Господи..."

# ch/harems_full/office/events/office_harem_common.rpy:998
translate russian aletta_audrey_lavish_propose_male_65f608cb:
    audrey.say "Вот так и становятся тряпкой, Сиори!"

# ch/harems_full/office/events/office_harem_common.rpy:999
translate russian aletta_audrey_lavish_propose_male_15b9ffd0:
    "Слушая их разговор, я невольно улыбаюсь."

# ch/harems_full/office/events/office_harem_common.rpy:1000
translate russian aletta_audrey_lavish_propose_male_a8d31bfa:
    "Конечно, компания у нас довольно странная."

# ch/harems_full/office/events/office_harem_common.rpy:1001
translate russian aletta_audrey_lavish_propose_male_bc68ba24:
    "Но мне кажется, именно это и поможет нам ужиться."

# ch/harems_full/office/events/office_harem_common.rpy:1002
translate russian aletta_audrey_lavish_propose_male_2df417ba:
    "Ведь каждому предстоит жить ещё с тремя людьми."

# ch/harems_full/office/events/office_harem_common.rpy:1003
translate russian aletta_audrey_lavish_propose_male_ba9cf855:
    "Что может быть хуже, чем если бы все они были похожи на тебя?"

# ch/harems_full/office/events/office_harem_common.rpy:1005
translate russian aletta_audrey_lavish_propose_male_2db28238:
    "Я встаю и неловко прячу в карман три кольца, которые теперь не нужны."

# ch/harems_full/office/events/office_harem_common.rpy:1006
translate russian aletta_audrey_lavish_propose_male_f4c72828:
    "Все смотрят на меня, и унижение кажется полным."

# ch/harems_full/office/events/office_harem_common.rpy:1007
translate russian aletta_audrey_lavish_propose_male_6280299a:
    "Хуже будет, только если с меня свалятся штаны или я вдруг вспыхну."

# ch/harems_full/office/events/office_harem_common.rpy:1008
translate russian aletta_audrey_lavish_propose_male_c62fd749:
    "Хотя нет, беру слова обратно: такое хоть отвлекло бы внимание!"

# ch/harems_full/office/events/office_harem_common.rpy:1010
translate russian aletta_audrey_lavish_propose_male_d98e6ad4:
    mike.say "Ладно..."

# ch/harems_full/office/events/office_harem_common.rpy:1011
translate russian aletta_audrey_lavish_propose_male_1873393c:
    mike.say "Думаю, совещание окончено!"

# ch/harems_full/office/events/office_harem_common.rpy:1012
translate russian aletta_audrey_lavish_propose_male_cfe19add:
    "Я разворачиваюсь и почти выбегаю из переговорной."

# ch/harems_full/office/events/office_harem_common.rpy:1013
translate russian aletta_audrey_lavish_propose_male_d51d0fc9:
    "Я сбегаю, прежде чем успеваю услышать за спиной их голоса."

# ch/harems_full/office/events/office_harem_common.rpy:1014
translate russian aletta_audrey_lavish_propose_male_bf431521:
    "Прежде чем придётся отвечать на вопросы, каждый из которых был бы пыткой."

# ch/harems_full/office/events/office_harem_common.rpy:1015
translate russian aletta_audrey_lavish_propose_male_dba951ec:
    "Может, сейчас самое время использовать накопившиеся отпускные дни?"

# ch/harems_full/office/events/office_harem_common.rpy:1016
translate russian aletta_audrey_lavish_propose_male_20f24199:
    "Или взять длительный отпуск и уйти в монастырь?"

# ch/harems_full/office/events/office_harem_common.rpy:1017
translate russian aletta_audrey_lavish_propose_male_e06cc43b:
    "Что угодно, лишь бы подальше отсюда и от трёх женщин, которые одновременно мне отказали!"

# ch/harems_full/office/events/office_harem_common.rpy:1019
translate russian aletta_audrey_lavish_propose_male_00507281:
    "Я встаю и надеваю кольца на все протянутые руки."

# ch/harems_full/office/events/office_harem_common.rpy:1020
translate russian aletta_audrey_lavish_propose_male_145278ba:
    "Чувствую на себе взгляды тех, кто отказал, но стараюсь не обращать внимания."

# ch/harems_full/office/events/office_harem_common.rpy:1021
translate russian aletta_audrey_lavish_propose_male_87970527:
    "Ох... будет тяжело."

# ch/harems_full/office/events/office_harem_common.rpy:1022
translate russian aletta_audrey_lavish_propose_male_b9ff0ddc:
    "Я буду скучать по тем, кто сказал нет."

# ch/harems_full/office/events/office_harem_common.rpy:1023
translate russian aletta_audrey_lavish_propose_male_76c588ba:
    "Но те из нас, кто решил быть вместе, должны и дальше идти вместе."

# ch/harems_full/office/events/office_harem_common.rpy:1024
translate russian aletta_audrey_lavish_propose_male_30f16e1e:
    "Мы тесно обнимаемся, пока остальные неловко выходят из комнаты."

# ch/harems_full/office/events/office_harem_common.rpy:1025
translate russian aletta_audrey_lavish_propose_male_adb1481c:
    "Мы вступаем на неизведанную территорию."

# ch/harems_full/office/events/office_harem_common.rpy:1026
translate russian aletta_audrey_lavish_propose_male_d873522f:
    "Но любовь, которую я чувствую от своих будущих жён, убеждает меня: у нас всё получится."

# ch/harems_full/office/events/office_harem_common.rpy:1030
translate russian lavish_shiori_propose_male_364318ef:
    "Поддерживать хорошие отношения со всеми девушками в офисе — всё равно что жонглировать бензопилами."

# ch/harems_full/office/events/office_harem_common.rpy:1031
translate russian lavish_shiori_propose_male_e341b6eb:
    "Это требует всей моей сосредоточенности и ловкости."

# ch/harems_full/office/events/office_harem_common.rpy:1032
translate russian lavish_shiori_propose_male_96d190b1:
    "И одна-единственная ошибка может обернуться для меня смертельно опасной ситуацией!"

# ch/harems_full/office/events/office_harem_common.rpy:1033
translate russian lavish_shiori_propose_male_b1997792:
    "Так что вы наверняка спросите, зачем мне вообще думать о предложении им всем."

# ch/harems_full/office/events/office_harem_common.rpy:1034
translate russian lavish_shiori_propose_male_4fde221b:
    "Но выслушайте меня, ладно?"

# ch/harems_full/office/events/office_harem_common.rpy:1035
translate russian lavish_shiori_propose_male_65bbe4f6:
    "По-моему, если мы поженимся, всё станет официально, верно?"

# ch/harems_full/office/events/office_harem_common.rpy:1036
translate russian lavish_shiori_propose_male_df9c8fe5:
    "Больше не придётся тайком встречаться за чужими спинами и бояться, что нас застукают."

# ch/harems_full/office/events/office_harem_common.rpy:1037
translate russian lavish_shiori_propose_male_afee1c3e:
    "Я прекрасно знаю, что многожёнство в нашей стране разрешили совсем недавно."

# ch/harems_full/office/events/office_harem_common.rpy:1038
translate russian lavish_shiori_propose_male_ee77a7df:
    "Но, по мне, жениться на двух не так уж отличается от женитьбы на одной."

# ch/harems_full/office/events/office_harem_common.rpy:1039
translate russian lavish_shiori_propose_male_6f8931d9:
    "Нет, настоящая разница в том, что придётся раскошелиться на два чёртовых кольца!"

# ch/harems_full/office/events/office_harem_common.rpy:1040
translate russian lavish_shiori_propose_male_a7aef0b5:
    "И ещё собрать их всех в одном месте, чтобы сделать предложение."

# ch/harems_full/office/events/office_harem_common.rpy:1041
translate russian lavish_shiori_propose_male_2687003b:
    "В конце концов я решаю притвориться, будто созываю совещание."

# ch/harems_full/office/events/office_harem_common.rpy:1042
translate russian lavish_shiori_propose_male_98304d93:
    "Вот почему сейчас жду их в переговорной."

# ch/harems_full/office/events/office_harem_common.rpy:1044
translate russian lavish_shiori_propose_male_86c46c0c:
    "Следом входит Лавиш, как всегда собранная и готовая к совещанию."

# ch/harems_full/office/events/office_harem_common.rpy:1045
translate russian lavish_shiori_propose_male_ac4b2b2c:
    "Я уже собираюсь закрыть дверь, когда вбегает Сиори."

# ch/harems_full/office/events/office_harem_common.rpy:1047
translate russian lavish_shiori_propose_male_5738db24:
    shiori.say "Прости, пожалуйста, [lssb_common.hero_name()]."

# ch/harems_full/office/events/office_harem_common.rpy:1048
translate russian lavish_shiori_propose_male_e9521209:
    shiori.say "Тот, кто подвозил меня на работу, опоздал."

# ch/harems_full/office/events/office_harem_common.rpy:1049
translate russian lavish_shiori_propose_male_dd1efdc0:
    shiori.say "А потом оказалось, что лифты не работают."

# ch/harems_full/office/events/office_harem_common.rpy:1050
translate russian lavish_shiori_propose_male_d74f7ff5:
    shiori.say "А потом..."

# ch/harems_full/office/events/office_harem_common.rpy:1051
translate russian lavish_shiori_propose_male_3406129d:
    mike.say "Всё хорошо, Сиори..."

# ch/harems_full/office/events/office_harem_common.rpy:1052
translate russian lavish_shiori_propose_male_193b86af:
    mike.say "Просто проходи и садись."

# ch/harems_full/office/events/office_harem_common.rpy:1053
translate russian lavish_shiori_propose_male_3e5cf0cb:
    "Сиори кивает и спешит выполнить просьбу."

# ch/harems_full/office/events/office_harem_common.rpy:1054
translate russian lavish_shiori_propose_male_e72d4c14:
    "Я подхожу к торцу стола, и все смотрят на меня."

# ch/harems_full/office/events/office_harem_common.rpy:1055
translate russian lavish_shiori_propose_male_f7b332d3:
    lavish.say "Ты совсем не предупредил меня о совещании!"

# ch/harems_full/office/events/office_harem_common.rpy:1057
translate russian lavish_shiori_propose_male_e866e559:
    lavish.say "Я не успела подготовиться за такое короткое время."

# ch/harems_full/office/events/office_harem_common.rpy:1058
translate russian lavish_shiori_propose_male_f4e3a950:
    "Я натягиваю улыбку, убеждая себя, что это хорошая идея."

# ch/harems_full/office/events/office_harem_common.rpy:1059
translate russian lavish_shiori_propose_male_e5096f0b:
    "Я ведь люблю каждую из этих девушек, правда люблю."

# ch/harems_full/office/events/office_harem_common.rpy:1060
translate russian lavish_shiori_propose_male_fb5985a9:
    "Но прекрасно знаю, что временами они все могут быть той ещё занозой в заднице!"

# ch/harems_full/office/events/office_harem_common.rpy:1062
translate russian lavish_shiori_propose_male_4ab6d240:
    mike.say "Я не предупредил о встрече, потому что хотел сделать сюрприз."

# ch/harems_full/office/events/office_harem_common.rpy:1063
translate russian lavish_shiori_propose_male_106c67c0:
    mike.say "И мне нужно было собрать вас всех вместе, чтобы сделать вот что..."

# ch/harems_full/office/events/office_harem_common.rpy:1064
translate russian lavish_shiori_propose_male_05ee23d6:
    "Я опускаюсь на одно колено и достаю из кармана два одинаковых кольца."

# ch/harems_full/office/events/office_harem_common.rpy:1065
translate russian lavish_shiori_propose_male_cc22fa1d:
    mike.say "Лавиш, Сиори..."

# ch/harems_full/office/events/office_harem_common.rpy:1067
translate russian lavish_shiori_propose_male_c795a089:
    mike.say "И друг за друга, наверное, тоже!"

# ch/harems_full/office/events/office_harem_common.rpy:1070
translate russian lavish_shiori_propose_male_b5700755:
    "Впервые на моей памяти все они лишаются дара речи."

# ch/harems_full/office/events/office_harem_common.rpy:1071
translate russian lavish_shiori_propose_male_4af83198:
    "Девушки смотрят на меня, затем переглядываются."

# ch/harems_full/office/events/office_harem_common.rpy:1072
translate russian lavish_shiori_propose_male_c6c3d050:
    "А я всё ещё стою на одном колене и жду ответа."

# ch/harems_full/office/events/office_harem_common.rpy:1075
translate russian lavish_shiori_propose_male_a94738bd:
    "Лавиш выглядит задумчивой, словно всерьёз взвешивает ответ."

# ch/harems_full/office/events/office_harem_common.rpy:1076
translate russian lavish_shiori_propose_male_539a5760:
    "Затем кивает и коротко выдыхает."

# ch/harems_full/office/events/office_harem_common.rpy:1077
translate russian lavish_shiori_propose_male_4879009e:
    lavish.say "Придётся сказать нет."

# ch/harems_full/office/events/office_harem_common.rpy:1078
translate russian lavish_shiori_propose_male_a845c91a:
    lavish.say "Не думаю, что эти отношения идут мне на пользу."

# ch/harems_full/office/events/office_harem_common.rpy:1079
translate russian lavish_shiori_propose_male_f79e418c:
    lavish.say "И, скорее всего, помешают моим долгосрочным карьерным планам."

# ch/harems_full/office/events/office_harem_common.rpy:1083
translate russian lavish_shiori_propose_male_a94738bd_1:
    "Лавиш выглядит задумчивой, словно всерьёз взвешивает ответ."

# ch/harems_full/office/events/office_harem_common.rpy:1084
translate russian lavish_shiori_propose_male_539a5760_1:
    "Затем кивает и коротко выдыхает."

# ch/harems_full/office/events/office_harem_common.rpy:1086
translate russian lavish_shiori_propose_male_26ac0382:
    lavish.say "Я говорю да."

# ch/harems_full/office/events/office_harem_common.rpy:1087
translate russian lavish_shiori_propose_male_f804e109:
    lavish.say "Отношения у нас, конечно, немного странные."

# ch/harems_full/office/events/office_harem_common.rpy:1088
translate russian lavish_shiori_propose_male_9618b8ed:
    lavish.say "Но всё, похоже, получается, и мне очень нравится!"

# ch/harems_full/office/events/office_harem_common.rpy:1092
translate russian lavish_shiori_propose_male_b134dbfd:
    "Сиори обводит взглядом всех присутствующих."

# ch/harems_full/office/events/office_harem_common.rpy:1093
translate russian lavish_shiori_propose_male_0841ed9b:
    "На мгновение мне кажется, что она попросит их решить за неё."

# ch/harems_full/office/events/office_harem_common.rpy:1094
translate russian lavish_shiori_propose_male_dd9a67f1:
    "Но в конце концов набирается смелости высказаться сама."

# ch/harems_full/office/events/office_harem_common.rpy:1095
translate russian lavish_shiori_propose_male_0c945ab9:
    shiori.say "Я... я говорю нет."

# ch/harems_full/office/events/office_harem_common.rpy:1096
translate russian lavish_shiori_propose_male_fc11a726:
    shiori.say "Мне кажется, я теряю себя в этих отношениях."

# ch/harems_full/office/events/office_harem_common.rpy:1097
translate russian lavish_shiori_propose_male_f21a3a74:
    shiori.say "Будто все воспринимают меня как должное и не замечают!"

# ch/harems_full/office/events/office_harem_common.rpy:1101
translate russian lavish_shiori_propose_male_b134dbfd_1:
    "Сиори обводит взглядом всех присутствующих."

# ch/harems_full/office/events/office_harem_common.rpy:1102
translate russian lavish_shiori_propose_male_0841ed9b_1:
    "На мгновение мне кажется, что она попросит их решить за неё."

# ch/harems_full/office/events/office_harem_common.rpy:1103
translate russian lavish_shiori_propose_male_dd9a67f1_1:
    "Но в конце концов набирается смелости высказаться сама."

# ch/harems_full/office/events/office_harem_common.rpy:1105
translate russian lavish_shiori_propose_male_e482cd60:
    shiori.say "Я... я говорю да."

# ch/harems_full/office/events/office_harem_common.rpy:1106
translate russian lavish_shiori_propose_male_8714c3bc:
    shiori.say "Мне нравится быть в отношениях со всеми вами."

# ch/harems_full/office/events/office_harem_common.rpy:1107
translate russian lavish_shiori_propose_male_18c577cd:
    shiori.say "Я больше не чувствую себя одинокой и потерянной!"

# ch/harems_full/office/events/office_harem_common.rpy:1109
translate russian lavish_shiori_propose_male_b4daf315:
    "Слушая их ответы, я чувствую, как колотится сердце."

# ch/harems_full/office/events/office_harem_common.rpy:1110
translate russian lavish_shiori_propose_male_8f6f25a5:
    "Но разве могло быть иначе?"

# ch/harems_full/office/events/office_harem_common.rpy:1111
translate russian lavish_shiori_propose_male_edd36fb9:
    "Я прошу их принять очень важное решение."

# ch/harems_full/office/events/office_harem_common.rpy:1112
translate russian lavish_shiori_propose_male_f865e794:
    "И оно неизбежно вызовет уйму эмоций."

# ch/harems_full/office/events/office_harem_common.rpy:1114
translate russian lavish_shiori_propose_male_13c7fcb6:
    "Я встаю и начинаю надевать кольца им на пальцы."

# ch/harems_full/office/events/office_harem_common.rpy:1115
translate russian lavish_shiori_propose_male_d5d90334:
    "Вскоре всё готово, и девушки любуются новыми украшениями."

# ch/harems_full/office/events/office_harem_common.rpy:1116
translate russian lavish_shiori_propose_male_78889186:
    "Мне хочется ущипнуть себя, чтобы убедиться, что всё происходит наяву."

# ch/harems_full/office/events/office_harem_common.rpy:1117
translate russian lavish_shiori_propose_male_f7431606:
    "Я правда женюсь на обеих?"

# ch/harems_full/office/events/office_harem_common.rpy:1118
translate russian lavish_shiori_propose_male_79920888:
    lavish.say "Ну... он может сказать о нас то же самое, Одри!"

# ch/harems_full/office/events/office_harem_common.rpy:1119
translate russian lavish_shiori_propose_male_3d0aa6e6:
    lavish.say "В конце концов, брак — равноправное партнёрство."

# ch/harems_full/office/events/office_harem_common.rpy:1120
translate russian lavish_shiori_propose_male_f5fb2207:
    shiori.say "Я... я не против быть старомодной женой."

# ch/harems_full/office/events/office_harem_common.rpy:1121
translate russian lavish_shiori_propose_male_c38cab66:
    shiori.say "[lssb_common.hero_name()] может командовать мной сколько угодно!"

# ch/harems_full/office/events/office_harem_common.rpy:1122
translate russian lavish_shiori_propose_male_15b9ffd0:
    "Слушая их разговор, я невольно улыбаюсь."

# ch/harems_full/office/events/office_harem_common.rpy:1123
translate russian lavish_shiori_propose_male_a8d31bfa:
    "Конечно, компания у нас довольно странная."

# ch/harems_full/office/events/office_harem_common.rpy:1124
translate russian lavish_shiori_propose_male_bc68ba24:
    "Но мне кажется, именно это и поможет нам ужиться."

# ch/harems_full/office/events/office_harem_common.rpy:1125
translate russian lavish_shiori_propose_male_786dfb38:
    "Ведь каждому предстоит жить ещё с двумя людьми."

# ch/harems_full/office/events/office_harem_common.rpy:1126
translate russian lavish_shiori_propose_male_ba9cf855:
    "Что может быть хуже, чем если бы все они были похожи на тебя?"

# ch/harems_full/office/events/office_harem_common.rpy:1128
translate russian lavish_shiori_propose_male_8b6a38ef:
    "Я встаю и неловко прячу в карман два кольца, которые теперь не нужны."

# ch/harems_full/office/events/office_harem_common.rpy:1129
translate russian lavish_shiori_propose_male_f4c72828:
    "Все смотрят на меня, и унижение кажется полным."

# ch/harems_full/office/events/office_harem_common.rpy:1130
translate russian lavish_shiori_propose_male_6280299a:
    "Хуже будет, только если с меня свалятся штаны или я вдруг вспыхну."

# ch/harems_full/office/events/office_harem_common.rpy:1131
translate russian lavish_shiori_propose_male_c62fd749:
    "Хотя нет, беру слова обратно: такое хоть отвлекло бы внимание!"

# ch/harems_full/office/events/office_harem_common.rpy:1133
translate russian lavish_shiori_propose_male_d98e6ad4:
    mike.say "Ладно..."

# ch/harems_full/office/events/office_harem_common.rpy:1134
translate russian lavish_shiori_propose_male_1873393c:
    mike.say "Думаю, совещание окончено!"

# ch/harems_full/office/events/office_harem_common.rpy:1135
translate russian lavish_shiori_propose_male_cfe19add:
    "Я разворачиваюсь и почти выбегаю из переговорной."

# ch/harems_full/office/events/office_harem_common.rpy:1136
translate russian lavish_shiori_propose_male_d51d0fc9:
    "Я сбегаю, прежде чем успеваю услышать за спиной их голоса."

# ch/harems_full/office/events/office_harem_common.rpy:1137
translate russian lavish_shiori_propose_male_bf431521:
    "Прежде чем придётся отвечать на вопросы, каждый из которых был бы пыткой."

# ch/harems_full/office/events/office_harem_common.rpy:1138
translate russian lavish_shiori_propose_male_dba951ec:
    "Может, сейчас самое время использовать накопившиеся отпускные дни?"

# ch/harems_full/office/events/office_harem_common.rpy:1139
translate russian lavish_shiori_propose_male_20f24199:
    "Или взять длительный отпуск и уйти в монастырь?"

# ch/harems_full/office/events/office_harem_common.rpy:1140
translate russian lavish_shiori_propose_male_18338f00:
    "Что угодно, лишь бы подальше отсюда и от двух женщин, которые одновременно мне отказали!"

# ch/harems_full/office/events/office_harem_common.rpy:1142
translate russian lavish_shiori_propose_male_00507281:
    "Я встаю и надеваю кольца на все протянутые руки."

# ch/harems_full/office/events/office_harem_common.rpy:1143
translate russian lavish_shiori_propose_male_145278ba:
    "Чувствую на себе взгляды тех, кто отказал, но стараюсь не обращать внимания."

# ch/harems_full/office/events/office_harem_common.rpy:1144
translate russian lavish_shiori_propose_male_87970527:
    "Ох... будет тяжело."

# ch/harems_full/office/events/office_harem_common.rpy:1145
translate russian lavish_shiori_propose_male_b9ff0ddc:
    "Я буду скучать по тем, кто сказал нет."

# ch/harems_full/office/events/office_harem_common.rpy:1146
translate russian lavish_shiori_propose_male_76c588ba:
    "Но те из нас, кто решил быть вместе, должны и дальше идти вместе."

# ch/harems_full/office/events/office_harem_common.rpy:1147
translate russian lavish_shiori_propose_male_30f16e1e:
    "Мы тесно обнимаемся, пока остальные неловко выходят из комнаты."

# ch/harems_full/office/events/office_harem_common.rpy:1148
translate russian lavish_shiori_propose_male_adb1481c:
    "Мы вступаем на неизведанную территорию."

# ch/harems_full/office/events/office_harem_common.rpy:1149
translate russian lavish_shiori_propose_male_d873522f:
    "Но любовь, которую я чувствую от своих будущих жён, убеждает меня: у нас всё получится."

# ch/harems_full/office/events/office_harem_common.rpy:1153
translate russian audrey_shiori_propose_male_364318ef:
    "Поддерживать хорошие отношения со всеми девушками в офисе — всё равно что жонглировать бензопилами."

# ch/harems_full/office/events/office_harem_common.rpy:1154
translate russian audrey_shiori_propose_male_e341b6eb:
    "Это требует всей моей сосредоточенности и ловкости."

# ch/harems_full/office/events/office_harem_common.rpy:1155
translate russian audrey_shiori_propose_male_96d190b1:
    "И одна-единственная ошибка может обернуться для меня смертельно опасной ситуацией!"

# ch/harems_full/office/events/office_harem_common.rpy:1156
translate russian audrey_shiori_propose_male_b1997792:
    "Так что вы наверняка спросите, зачем мне вообще думать о предложении им всем."

# ch/harems_full/office/events/office_harem_common.rpy:1157
translate russian audrey_shiori_propose_male_4fde221b:
    "Но выслушайте меня, ладно?"

# ch/harems_full/office/events/office_harem_common.rpy:1158
translate russian audrey_shiori_propose_male_65bbe4f6:
    "По-моему, если мы поженимся, всё станет официально, верно?"

# ch/harems_full/office/events/office_harem_common.rpy:1159
translate russian audrey_shiori_propose_male_df9c8fe5:
    "Больше не придётся тайком встречаться за чужими спинами и бояться, что нас застукают."

# ch/harems_full/office/events/office_harem_common.rpy:1160
translate russian audrey_shiori_propose_male_afee1c3e:
    "Я прекрасно знаю, что многожёнство в нашей стране разрешили совсем недавно."

# ch/harems_full/office/events/office_harem_common.rpy:1161
translate russian audrey_shiori_propose_male_ee77a7df:
    "Но, по мне, жениться на двух не так уж отличается от женитьбы на одной."

# ch/harems_full/office/events/office_harem_common.rpy:1162
translate russian audrey_shiori_propose_male_6f8931d9:
    "Нет, настоящая разница в том, что придётся раскошелиться на два чёртовых кольца!"

# ch/harems_full/office/events/office_harem_common.rpy:1163
translate russian audrey_shiori_propose_male_a7aef0b5:
    "И ещё собрать их всех в одном месте, чтобы сделать предложение."

# ch/harems_full/office/events/office_harem_common.rpy:1164
translate russian audrey_shiori_propose_male_2687003b:
    "В конце концов я решаю притвориться, будто созываю совещание."

# ch/harems_full/office/events/office_harem_common.rpy:1165
translate russian audrey_shiori_propose_male_98304d93:
    "Вот почему сейчас жду их в переговорной."

# ch/harems_full/office/events/office_harem_common.rpy:1167
translate russian audrey_shiori_propose_male_3ff50c07:
    "Чуть позже нехотя подтягивается Одри: хмурая, больше занятая телефоном, чем работой."

# ch/harems_full/office/events/office_harem_common.rpy:1168
translate russian audrey_shiori_propose_male_ac4b2b2c:
    "Я уже собираюсь закрыть дверь, когда вбегает Сиори."

# ch/harems_full/office/events/office_harem_common.rpy:1170
translate russian audrey_shiori_propose_male_5738db24:
    shiori.say "Прости, пожалуйста, [lssb_common.hero_name()]."

# ch/harems_full/office/events/office_harem_common.rpy:1171
translate russian audrey_shiori_propose_male_e9521209:
    shiori.say "Тот, кто подвозил меня на работу, опоздал."

# ch/harems_full/office/events/office_harem_common.rpy:1172
translate russian audrey_shiori_propose_male_dd1efdc0:
    shiori.say "А потом оказалось, что лифты не работают."

# ch/harems_full/office/events/office_harem_common.rpy:1173
translate russian audrey_shiori_propose_male_d74f7ff5:
    shiori.say "А потом..."

# ch/harems_full/office/events/office_harem_common.rpy:1174
translate russian audrey_shiori_propose_male_3406129d:
    mike.say "Всё хорошо, Сиори..."

# ch/harems_full/office/events/office_harem_common.rpy:1175
translate russian audrey_shiori_propose_male_193b86af:
    mike.say "Просто проходи и садись."

# ch/harems_full/office/events/office_harem_common.rpy:1176
translate russian audrey_shiori_propose_male_3e5cf0cb:
    "Сиори кивает и спешит выполнить просьбу."

# ch/harems_full/office/events/office_harem_common.rpy:1177
translate russian audrey_shiori_propose_male_e72d4c14:
    "Я подхожу к торцу стола, и все смотрят на меня."

# ch/harems_full/office/events/office_harem_common.rpy:1178
translate russian audrey_shiori_propose_male_f4e3a950:
    "Я натягиваю улыбку, убеждая себя, что это хорошая идея."

# ch/harems_full/office/events/office_harem_common.rpy:1179
translate russian audrey_shiori_propose_male_e5096f0b:
    "Я ведь люблю каждую из этих девушек, правда люблю."

# ch/harems_full/office/events/office_harem_common.rpy:1180
translate russian audrey_shiori_propose_male_fb5985a9:
    "Но прекрасно знаю, что временами они все могут быть той ещё занозой в заднице!"

# ch/harems_full/office/events/office_harem_common.rpy:1182
translate russian audrey_shiori_propose_male_4ab6d240:
    mike.say "Я не предупредил о встрече, потому что хотел сделать сюрприз."

# ch/harems_full/office/events/office_harem_common.rpy:1183
translate russian audrey_shiori_propose_male_106c67c0:
    mike.say "И мне нужно было собрать вас всех вместе, чтобы сделать вот что..."

# ch/harems_full/office/events/office_harem_common.rpy:1184
translate russian audrey_shiori_propose_male_05ee23d6:
    "Я опускаюсь на одно колено и достаю из кармана два одинаковых кольца."

# ch/harems_full/office/events/office_harem_common.rpy:1185
translate russian audrey_shiori_propose_male_3ae2410c:
    mike.say "Одри, Сиори..."

# ch/harems_full/office/events/office_harem_common.rpy:1187
translate russian audrey_shiori_propose_male_c795a089:
    mike.say "И друг за друга, наверное, тоже!"

# ch/harems_full/office/events/office_harem_common.rpy:1190
translate russian audrey_shiori_propose_male_b5700755:
    "Впервые на моей памяти все они лишаются дара речи."

# ch/harems_full/office/events/office_harem_common.rpy:1191
translate russian audrey_shiori_propose_male_4af83198:
    "Девушки смотрят на меня, затем переглядываются."

# ch/harems_full/office/events/office_harem_common.rpy:1192
translate russian audrey_shiori_propose_male_c6c3d050:
    "А я всё ещё стою на одном колене и жду ответа."

# ch/harems_full/office/events/office_harem_common.rpy:1195
translate russian audrey_shiori_propose_male_947bcb8b:
    "Одри странно кривится, словно усиленно думает."

# ch/harems_full/office/events/office_harem_common.rpy:1196
translate russian audrey_shiori_propose_male_7a5bdb84:
    "А затем отвечает с обычной прямотой."

# ch/harems_full/office/events/office_harem_common.rpy:1197
translate russian audrey_shiori_propose_male_90eda6e5:
    audrey.say "Чёрта с два! Ещё не хватало выйти за вас, неудачников!"

# ch/harems_full/office/events/office_harem_common.rpy:1198
translate russian audrey_shiori_propose_male_5860ad2b:
    audrey.say "Мне уже достаточно того, что приходится с вами работать."

# ch/harems_full/office/events/office_harem_common.rpy:1199
translate russian audrey_shiori_propose_male_d3306c4e:
    audrey.say "Забудьте о том, чтобы провести вместе ещё и всю жизнь!"

# ch/harems_full/office/events/office_harem_common.rpy:1203
translate russian audrey_shiori_propose_male_947bcb8b_1:
    "Одри странно кривится, словно усиленно думает."

# ch/harems_full/office/events/office_harem_common.rpy:1204
translate russian audrey_shiori_propose_male_7a5bdb84_1:
    "А затем отвечает с обычной прямотой."

# ch/harems_full/office/events/office_harem_common.rpy:1206
translate russian audrey_shiori_propose_male_17387692:
    audrey.say "Да, я согласна."

# ch/harems_full/office/events/office_harem_common.rpy:1207
translate russian audrey_shiori_propose_male_e53de238:
    audrey.say "Вы все по-прежнему слишком зажатые."

# ch/harems_full/office/events/office_harem_common.rpy:1208
translate russian audrey_shiori_propose_male_19aa4504:
    audrey.say "И без меня вам эти палки из задниц не вытащить!"

# ch/harems_full/office/events/office_harem_common.rpy:1212
translate russian audrey_shiori_propose_male_b134dbfd:
    "Сиори обводит взглядом всех присутствующих."

# ch/harems_full/office/events/office_harem_common.rpy:1213
translate russian audrey_shiori_propose_male_0841ed9b:
    "На мгновение мне кажется, что она попросит их решить за неё."

# ch/harems_full/office/events/office_harem_common.rpy:1214
translate russian audrey_shiori_propose_male_dd9a67f1:
    "Но в конце концов набирается смелости высказаться сама."

# ch/harems_full/office/events/office_harem_common.rpy:1215
translate russian audrey_shiori_propose_male_0c945ab9:
    shiori.say "Я... я говорю нет."

# ch/harems_full/office/events/office_harem_common.rpy:1216
translate russian audrey_shiori_propose_male_fc11a726:
    shiori.say "Мне кажется, я теряю себя в этих отношениях."

# ch/harems_full/office/events/office_harem_common.rpy:1217
translate russian audrey_shiori_propose_male_f21a3a74:
    shiori.say "Будто все воспринимают меня как должное и не замечают!"

# ch/harems_full/office/events/office_harem_common.rpy:1221
translate russian audrey_shiori_propose_male_b134dbfd_1:
    "Сиори обводит взглядом всех присутствующих."

# ch/harems_full/office/events/office_harem_common.rpy:1222
translate russian audrey_shiori_propose_male_0841ed9b_1:
    "На мгновение мне кажется, что она попросит их решить за неё."

# ch/harems_full/office/events/office_harem_common.rpy:1223
translate russian audrey_shiori_propose_male_dd9a67f1_1:
    "Но в конце концов набирается смелости высказаться сама."

# ch/harems_full/office/events/office_harem_common.rpy:1225
translate russian audrey_shiori_propose_male_e482cd60:
    shiori.say "Я... я говорю да."

# ch/harems_full/office/events/office_harem_common.rpy:1226
translate russian audrey_shiori_propose_male_8714c3bc:
    shiori.say "Мне нравится быть в отношениях со всеми вами."

# ch/harems_full/office/events/office_harem_common.rpy:1227
translate russian audrey_shiori_propose_male_18c577cd:
    shiori.say "Я больше не чувствую себя одинокой и потерянной!"

# ch/harems_full/office/events/office_harem_common.rpy:1229
translate russian audrey_shiori_propose_male_b4daf315:
    "Слушая их ответы, я чувствую, как колотится сердце."

# ch/harems_full/office/events/office_harem_common.rpy:1230
translate russian audrey_shiori_propose_male_8f6f25a5:
    "Но разве могло быть иначе?"

# ch/harems_full/office/events/office_harem_common.rpy:1231
translate russian audrey_shiori_propose_male_edd36fb9:
    "Я прошу их принять очень важное решение."

# ch/harems_full/office/events/office_harem_common.rpy:1232
translate russian audrey_shiori_propose_male_f865e794:
    "И оно неизбежно вызовет уйму эмоций."

# ch/harems_full/office/events/office_harem_common.rpy:1234
translate russian audrey_shiori_propose_male_13c7fcb6:
    "Я встаю и начинаю надевать кольца им на пальцы."

# ch/harems_full/office/events/office_harem_common.rpy:1235
translate russian audrey_shiori_propose_male_d5d90334:
    "Вскоре всё готово, и девушки любуются новыми украшениями."

# ch/harems_full/office/events/office_harem_common.rpy:1236
translate russian audrey_shiori_propose_male_78889186:
    "Мне хочется ущипнуть себя, чтобы убедиться, что всё происходит наяву."

# ch/harems_full/office/events/office_harem_common.rpy:1237
translate russian audrey_shiori_propose_male_f7431606:
    "Я правда женюсь на обеих?"

# ch/harems_full/office/events/office_harem_common.rpy:1238
translate russian audrey_shiori_propose_male_3e2cce37:
    audrey.say "Да, [lssb_common.hero_name()], теперь твоя задница принадлежит нам!"

# ch/harems_full/office/events/office_harem_common.rpy:1239
translate russian audrey_shiori_propose_male_f5fb2207:
    shiori.say "Я... я не против быть старомодной женой."

# ch/harems_full/office/events/office_harem_common.rpy:1240
translate russian audrey_shiori_propose_male_c38cab66:
    shiori.say "[lssb_common.hero_name()] может командовать мной сколько угодно!"

# ch/harems_full/office/events/office_harem_common.rpy:1241
translate russian audrey_shiori_propose_male_cee381b3:
    audrey.say "Господи..."

# ch/harems_full/office/events/office_harem_common.rpy:1242
translate russian audrey_shiori_propose_male_65f608cb:
    audrey.say "Вот так и становятся тряпкой, Сиори!"

# ch/harems_full/office/events/office_harem_common.rpy:1243
translate russian audrey_shiori_propose_male_15b9ffd0:
    "Слушая их разговор, я невольно улыбаюсь."

# ch/harems_full/office/events/office_harem_common.rpy:1244
translate russian audrey_shiori_propose_male_a8d31bfa:
    "Конечно, компания у нас довольно странная."

# ch/harems_full/office/events/office_harem_common.rpy:1245
translate russian audrey_shiori_propose_male_bc68ba24:
    "Но мне кажется, именно это и поможет нам ужиться."

# ch/harems_full/office/events/office_harem_common.rpy:1246
translate russian audrey_shiori_propose_male_786dfb38:
    "Ведь каждому предстоит жить ещё с двумя людьми."

# ch/harems_full/office/events/office_harem_common.rpy:1247
translate russian audrey_shiori_propose_male_ba9cf855:
    "Что может быть хуже, чем если бы все они были похожи на тебя?"

# ch/harems_full/office/events/office_harem_common.rpy:1249
translate russian audrey_shiori_propose_male_8b6a38ef:
    "Я встаю и неловко прячу в карман два кольца, которые теперь не нужны."

# ch/harems_full/office/events/office_harem_common.rpy:1250
translate russian audrey_shiori_propose_male_f4c72828:
    "Все смотрят на меня, и унижение кажется полным."

# ch/harems_full/office/events/office_harem_common.rpy:1251
translate russian audrey_shiori_propose_male_6280299a:
    "Хуже будет, только если с меня свалятся штаны или я вдруг вспыхну."

# ch/harems_full/office/events/office_harem_common.rpy:1252
translate russian audrey_shiori_propose_male_c62fd749:
    "Хотя нет, беру слова обратно: такое хоть отвлекло бы внимание!"

# ch/harems_full/office/events/office_harem_common.rpy:1254
translate russian audrey_shiori_propose_male_d98e6ad4:
    mike.say "Ладно..."

# ch/harems_full/office/events/office_harem_common.rpy:1255
translate russian audrey_shiori_propose_male_1873393c:
    mike.say "Думаю, совещание окончено!"

# ch/harems_full/office/events/office_harem_common.rpy:1256
translate russian audrey_shiori_propose_male_cfe19add:
    "Я разворачиваюсь и почти выбегаю из переговорной."

# ch/harems_full/office/events/office_harem_common.rpy:1257
translate russian audrey_shiori_propose_male_d51d0fc9:
    "Я сбегаю, прежде чем успеваю услышать за спиной их голоса."

# ch/harems_full/office/events/office_harem_common.rpy:1258
translate russian audrey_shiori_propose_male_bf431521:
    "Прежде чем придётся отвечать на вопросы, каждый из которых был бы пыткой."

# ch/harems_full/office/events/office_harem_common.rpy:1259
translate russian audrey_shiori_propose_male_dba951ec:
    "Может, сейчас самое время использовать накопившиеся отпускные дни?"

# ch/harems_full/office/events/office_harem_common.rpy:1260
translate russian audrey_shiori_propose_male_20f24199:
    "Или взять длительный отпуск и уйти в монастырь?"

# ch/harems_full/office/events/office_harem_common.rpy:1261
translate russian audrey_shiori_propose_male_18338f00:
    "Что угодно, лишь бы подальше отсюда и от двух женщин, которые одновременно мне отказали!"

# ch/harems_full/office/events/office_harem_common.rpy:1263
translate russian audrey_shiori_propose_male_00507281:
    "Я встаю и надеваю кольца на все протянутые руки."

# ch/harems_full/office/events/office_harem_common.rpy:1264
translate russian audrey_shiori_propose_male_145278ba:
    "Чувствую на себе взгляды тех, кто отказал, но стараюсь не обращать внимания."

# ch/harems_full/office/events/office_harem_common.rpy:1265
translate russian audrey_shiori_propose_male_87970527:
    "Ох... будет тяжело."

# ch/harems_full/office/events/office_harem_common.rpy:1266
translate russian audrey_shiori_propose_male_b9ff0ddc:
    "Я буду скучать по тем, кто сказал нет."

# ch/harems_full/office/events/office_harem_common.rpy:1267
translate russian audrey_shiori_propose_male_76c588ba:
    "Но те из нас, кто решил быть вместе, должны и дальше идти вместе."

# ch/harems_full/office/events/office_harem_common.rpy:1268
translate russian audrey_shiori_propose_male_30f16e1e:
    "Мы тесно обнимаемся, пока остальные неловко выходят из комнаты."

# ch/harems_full/office/events/office_harem_common.rpy:1269
translate russian audrey_shiori_propose_male_adb1481c:
    "Мы вступаем на неизведанную территорию."

# ch/harems_full/office/events/office_harem_common.rpy:1270
translate russian audrey_shiori_propose_male_d873522f:
    "Но любовь, которую я чувствую от своих будущих жён, убеждает меня: у нас всё получится."

# ch/harems_full/office/events/office_harem_common.rpy:1274
translate russian audrey_lavish_propose_male_364318ef:
    "Поддерживать хорошие отношения со всеми девушками в офисе — всё равно что жонглировать бензопилами."

# ch/harems_full/office/events/office_harem_common.rpy:1275
translate russian audrey_lavish_propose_male_e341b6eb:
    "Это требует всей моей сосредоточенности и ловкости."

# ch/harems_full/office/events/office_harem_common.rpy:1276
translate russian audrey_lavish_propose_male_96d190b1:
    "И одна-единственная ошибка может обернуться для меня смертельно опасной ситуацией!"

# ch/harems_full/office/events/office_harem_common.rpy:1277
translate russian audrey_lavish_propose_male_b1997792:
    "Так что вы наверняка спросите, зачем мне вообще думать о предложении им всем."

# ch/harems_full/office/events/office_harem_common.rpy:1278
translate russian audrey_lavish_propose_male_4fde221b:
    "Но выслушайте меня, ладно?"

# ch/harems_full/office/events/office_harem_common.rpy:1279
translate russian audrey_lavish_propose_male_65bbe4f6:
    "По-моему, если мы поженимся, всё станет официально, верно?"

# ch/harems_full/office/events/office_harem_common.rpy:1280
translate russian audrey_lavish_propose_male_df9c8fe5:
    "Больше не придётся тайком встречаться за чужими спинами и бояться, что нас застукают."

# ch/harems_full/office/events/office_harem_common.rpy:1281
translate russian audrey_lavish_propose_male_afee1c3e:
    "Я прекрасно знаю, что многожёнство в нашей стране разрешили совсем недавно."

# ch/harems_full/office/events/office_harem_common.rpy:1282
translate russian audrey_lavish_propose_male_ee77a7df:
    "Но, по мне, жениться на двух не так уж отличается от женитьбы на одной."

# ch/harems_full/office/events/office_harem_common.rpy:1283
translate russian audrey_lavish_propose_male_6f8931d9:
    "Нет, настоящая разница в том, что придётся раскошелиться на два чёртовых кольца!"

# ch/harems_full/office/events/office_harem_common.rpy:1284
translate russian audrey_lavish_propose_male_a7aef0b5:
    "И ещё собрать их всех в одном месте, чтобы сделать предложение."

# ch/harems_full/office/events/office_harem_common.rpy:1285
translate russian audrey_lavish_propose_male_2687003b:
    "В конце концов я решаю притвориться, будто созываю совещание."

# ch/harems_full/office/events/office_harem_common.rpy:1286
translate russian audrey_lavish_propose_male_98304d93:
    "Вот почему сейчас жду их в переговорной."

# ch/harems_full/office/events/office_harem_common.rpy:1288
translate russian audrey_lavish_propose_male_86c46c0c:
    "Следом входит Лавиш, как всегда собранная и готовая к совещанию."

# ch/harems_full/office/events/office_harem_common.rpy:1290
translate russian audrey_lavish_propose_male_3ff50c07:
    "Чуть позже нехотя подтягивается Одри: хмурая, больше занятая телефоном, чем работой."

# ch/harems_full/office/events/office_harem_common.rpy:1291
translate russian audrey_lavish_propose_male_e72d4c14:
    "Я подхожу к торцу стола, и все смотрят на меня."

# ch/harems_full/office/events/office_harem_common.rpy:1292
translate russian audrey_lavish_propose_male_f7b332d3:
    lavish.say "Ты совсем не предупредил меня о совещании!"

# ch/harems_full/office/events/office_harem_common.rpy:1294
translate russian audrey_lavish_propose_male_e866e559:
    lavish.say "Я не успела подготовиться за такое короткое время."

# ch/harems_full/office/events/office_harem_common.rpy:1295
translate russian audrey_lavish_propose_male_1bb5b922:
    audrey.say "Значит, не сделала домашнее задание, Лавиш."

# ch/harems_full/office/events/office_harem_common.rpy:1296
translate russian audrey_lavish_propose_male_7c1997fb:
    audrey.say "Кого это, чёрт возьми, волнует?"

# ch/harems_full/office/events/office_harem_common.rpy:1297
translate russian audrey_lavish_propose_male_d0d58d00:
    audrey.say "Давайте уже закончим и уберёмся отсюда!"

# ch/harems_full/office/events/office_harem_common.rpy:1298
translate russian audrey_lavish_propose_male_f4e3a950:
    "Я натягиваю улыбку, убеждая себя, что это хорошая идея."

# ch/harems_full/office/events/office_harem_common.rpy:1299
translate russian audrey_lavish_propose_male_e5096f0b:
    "Я ведь люблю каждую из этих девушек, правда люблю."

# ch/harems_full/office/events/office_harem_common.rpy:1300
translate russian audrey_lavish_propose_male_fb5985a9:
    "Но прекрасно знаю, что временами они все могут быть той ещё занозой в заднице!"

# ch/harems_full/office/events/office_harem_common.rpy:1302
translate russian audrey_lavish_propose_male_4ab6d240:
    mike.say "Я не предупредил о встрече, потому что хотел сделать сюрприз."

# ch/harems_full/office/events/office_harem_common.rpy:1303
translate russian audrey_lavish_propose_male_106c67c0:
    mike.say "И мне нужно было собрать вас всех вместе, чтобы сделать вот что..."

# ch/harems_full/office/events/office_harem_common.rpy:1304
translate russian audrey_lavish_propose_male_05ee23d6:
    "Я опускаюсь на одно колено и достаю из кармана два одинаковых кольца."

# ch/harems_full/office/events/office_harem_common.rpy:1305
translate russian audrey_lavish_propose_male_385c3a4f:
    mike.say "Одри, Лавиш..."

# ch/harems_full/office/events/office_harem_common.rpy:1307
translate russian audrey_lavish_propose_male_c795a089:
    mike.say "И друг за друга, наверное, тоже!"

# ch/harems_full/office/events/office_harem_common.rpy:1310
translate russian audrey_lavish_propose_male_b5700755:
    "Впервые на моей памяти все они лишаются дара речи."

# ch/harems_full/office/events/office_harem_common.rpy:1311
translate russian audrey_lavish_propose_male_4af83198:
    "Девушки смотрят на меня, затем переглядываются."

# ch/harems_full/office/events/office_harem_common.rpy:1312
translate russian audrey_lavish_propose_male_c6c3d050:
    "А я всё ещё стою на одном колене и жду ответа."

# ch/harems_full/office/events/office_harem_common.rpy:1315
translate russian audrey_lavish_propose_male_947bcb8b:
    "Одри странно кривится, словно усиленно думает."

# ch/harems_full/office/events/office_harem_common.rpy:1316
translate russian audrey_lavish_propose_male_7a5bdb84:
    "А затем отвечает с обычной прямотой."

# ch/harems_full/office/events/office_harem_common.rpy:1317
translate russian audrey_lavish_propose_male_90eda6e5:
    audrey.say "Чёрта с два! Ещё не хватало выйти за вас, неудачников!"

# ch/harems_full/office/events/office_harem_common.rpy:1318
translate russian audrey_lavish_propose_male_5860ad2b:
    audrey.say "Мне уже достаточно того, что приходится с вами работать."

# ch/harems_full/office/events/office_harem_common.rpy:1319
translate russian audrey_lavish_propose_male_d3306c4e:
    audrey.say "Забудьте о том, чтобы провести вместе ещё и всю жизнь!"

# ch/harems_full/office/events/office_harem_common.rpy:1323
translate russian audrey_lavish_propose_male_947bcb8b_1:
    "Одри странно кривится, словно усиленно думает."

# ch/harems_full/office/events/office_harem_common.rpy:1324
translate russian audrey_lavish_propose_male_7a5bdb84_1:
    "А затем отвечает с обычной прямотой."

# ch/harems_full/office/events/office_harem_common.rpy:1326
translate russian audrey_lavish_propose_male_17387692:
    audrey.say "Да, я согласна."

# ch/harems_full/office/events/office_harem_common.rpy:1327
translate russian audrey_lavish_propose_male_e53de238:
    audrey.say "Вы все по-прежнему слишком зажатые."

# ch/harems_full/office/events/office_harem_common.rpy:1328
translate russian audrey_lavish_propose_male_19aa4504:
    audrey.say "И без меня вам эти палки из задниц не вытащить!"

# ch/harems_full/office/events/office_harem_common.rpy:1332
translate russian audrey_lavish_propose_male_a94738bd:
    "Лавиш выглядит задумчивой, словно всерьёз взвешивает ответ."

# ch/harems_full/office/events/office_harem_common.rpy:1333
translate russian audrey_lavish_propose_male_539a5760:
    "Затем кивает и коротко выдыхает."

# ch/harems_full/office/events/office_harem_common.rpy:1334
translate russian audrey_lavish_propose_male_4879009e:
    lavish.say "Придётся сказать нет."

# ch/harems_full/office/events/office_harem_common.rpy:1335
translate russian audrey_lavish_propose_male_a845c91a:
    lavish.say "Не думаю, что эти отношения идут мне на пользу."

# ch/harems_full/office/events/office_harem_common.rpy:1336
translate russian audrey_lavish_propose_male_f79e418c:
    lavish.say "И, скорее всего, помешают моим долгосрочным карьерным планам."

# ch/harems_full/office/events/office_harem_common.rpy:1340
translate russian audrey_lavish_propose_male_a94738bd_1:
    "Лавиш выглядит задумчивой, словно всерьёз взвешивает ответ."

# ch/harems_full/office/events/office_harem_common.rpy:1341
translate russian audrey_lavish_propose_male_539a5760_1:
    "Затем кивает и коротко выдыхает."

# ch/harems_full/office/events/office_harem_common.rpy:1343
translate russian audrey_lavish_propose_male_26ac0382:
    lavish.say "Я говорю да."

# ch/harems_full/office/events/office_harem_common.rpy:1344
translate russian audrey_lavish_propose_male_f804e109:
    lavish.say "Отношения у нас, конечно, немного странные."

# ch/harems_full/office/events/office_harem_common.rpy:1345
translate russian audrey_lavish_propose_male_9618b8ed:
    lavish.say "Но всё, похоже, получается, и мне очень нравится!"

# ch/harems_full/office/events/office_harem_common.rpy:1347
translate russian audrey_lavish_propose_male_b4daf315:
    "Слушая их ответы, я чувствую, как колотится сердце."

# ch/harems_full/office/events/office_harem_common.rpy:1348
translate russian audrey_lavish_propose_male_8f6f25a5:
    "Но разве могло быть иначе?"

# ch/harems_full/office/events/office_harem_common.rpy:1349
translate russian audrey_lavish_propose_male_edd36fb9:
    "Я прошу их принять очень важное решение."

# ch/harems_full/office/events/office_harem_common.rpy:1350
translate russian audrey_lavish_propose_male_f865e794:
    "И оно неизбежно вызовет уйму эмоций."

# ch/harems_full/office/events/office_harem_common.rpy:1352
translate russian audrey_lavish_propose_male_13c7fcb6:
    "Я встаю и начинаю надевать кольца им на пальцы."

# ch/harems_full/office/events/office_harem_common.rpy:1353
translate russian audrey_lavish_propose_male_d5d90334:
    "Вскоре всё готово, и девушки любуются новыми украшениями."

# ch/harems_full/office/events/office_harem_common.rpy:1354
translate russian audrey_lavish_propose_male_78889186:
    "Мне хочется ущипнуть себя, чтобы убедиться, что всё происходит наяву."

# ch/harems_full/office/events/office_harem_common.rpy:1355
translate russian audrey_lavish_propose_male_f7431606:
    "Я правда женюсь на обеих?"

# ch/harems_full/office/events/office_harem_common.rpy:1356
translate russian audrey_lavish_propose_male_4c5a0d94:
    aletta.say "Конец разгульной жизни, [lssb_common.hero_name()]."

# ch/harems_full/office/events/office_harem_common.rpy:1357
translate russian audrey_lavish_propose_male_3c7629de:
    aletta.say "Ты станешь женатым человеком!"

# ch/harems_full/office/events/office_harem_common.rpy:1358
translate russian audrey_lavish_propose_male_3e2cce37:
    audrey.say "Да, [lssb_common.hero_name()], теперь твоя задница принадлежит нам!"

# ch/harems_full/office/events/office_harem_common.rpy:1359
translate russian audrey_lavish_propose_male_79920888:
    lavish.say "Ну... он может сказать о нас то же самое, Одри!"

# ch/harems_full/office/events/office_harem_common.rpy:1360
translate russian audrey_lavish_propose_male_3d0aa6e6:
    lavish.say "В конце концов, брак — равноправное партнёрство."

# ch/harems_full/office/events/office_harem_common.rpy:1361
translate russian audrey_lavish_propose_male_f5fb2207:
    shiori.say "Я... я не против быть старомодной женой."

# ch/harems_full/office/events/office_harem_common.rpy:1362
translate russian audrey_lavish_propose_male_c38cab66:
    shiori.say "[lssb_common.hero_name()] может командовать мной сколько угодно!"

# ch/harems_full/office/events/office_harem_common.rpy:1363
translate russian audrey_lavish_propose_male_cee381b3:
    audrey.say "Господи..."

# ch/harems_full/office/events/office_harem_common.rpy:1364
translate russian audrey_lavish_propose_male_65f608cb:
    audrey.say "Вот так и становятся тряпкой, Сиори!"

# ch/harems_full/office/events/office_harem_common.rpy:1365
translate russian audrey_lavish_propose_male_15b9ffd0:
    "Слушая их разговор, я невольно улыбаюсь."

# ch/harems_full/office/events/office_harem_common.rpy:1366
translate russian audrey_lavish_propose_male_a8d31bfa:
    "Конечно, компания у нас довольно странная."

# ch/harems_full/office/events/office_harem_common.rpy:1367
translate russian audrey_lavish_propose_male_bc68ba24:
    "Но мне кажется, именно это и поможет нам ужиться."

# ch/harems_full/office/events/office_harem_common.rpy:1368
translate russian audrey_lavish_propose_male_786dfb38:
    "Ведь каждому предстоит жить ещё с двумя людьми."

# ch/harems_full/office/events/office_harem_common.rpy:1369
translate russian audrey_lavish_propose_male_ba9cf855:
    "Что может быть хуже, чем если бы все они были похожи на тебя?"

# ch/harems_full/office/events/office_harem_common.rpy:1371
translate russian audrey_lavish_propose_male_8b6a38ef:
    "Я встаю и неловко прячу в карман два кольца, которые теперь не нужны."

# ch/harems_full/office/events/office_harem_common.rpy:1372
translate russian audrey_lavish_propose_male_f4c72828:
    "Все смотрят на меня, и унижение кажется полным."

# ch/harems_full/office/events/office_harem_common.rpy:1373
translate russian audrey_lavish_propose_male_6280299a:
    "Хуже будет, только если с меня свалятся штаны или я вдруг вспыхну."

# ch/harems_full/office/events/office_harem_common.rpy:1374
translate russian audrey_lavish_propose_male_c62fd749:
    "Хотя нет, беру слова обратно: такое хоть отвлекло бы внимание!"

# ch/harems_full/office/events/office_harem_common.rpy:1376
translate russian audrey_lavish_propose_male_d98e6ad4:
    mike.say "Ладно..."

# ch/harems_full/office/events/office_harem_common.rpy:1377
translate russian audrey_lavish_propose_male_1873393c:
    mike.say "Думаю, совещание окончено!"

# ch/harems_full/office/events/office_harem_common.rpy:1378
translate russian audrey_lavish_propose_male_cfe19add:
    "Я разворачиваюсь и почти выбегаю из переговорной."

# ch/harems_full/office/events/office_harem_common.rpy:1379
translate russian audrey_lavish_propose_male_d51d0fc9:
    "Я сбегаю, прежде чем успеваю услышать за спиной их голоса."

# ch/harems_full/office/events/office_harem_common.rpy:1380
translate russian audrey_lavish_propose_male_bf431521:
    "Прежде чем придётся отвечать на вопросы, каждый из которых был бы пыткой."

# ch/harems_full/office/events/office_harem_common.rpy:1381
translate russian audrey_lavish_propose_male_dba951ec:
    "Может, сейчас самое время использовать накопившиеся отпускные дни?"

# ch/harems_full/office/events/office_harem_common.rpy:1382
translate russian audrey_lavish_propose_male_20f24199:
    "Или взять длительный отпуск и уйти в монастырь?"

# ch/harems_full/office/events/office_harem_common.rpy:1383
translate russian audrey_lavish_propose_male_18338f00:
    "Что угодно, лишь бы подальше отсюда и от двух женщин, которые одновременно мне отказали!"

# ch/harems_full/office/events/office_harem_common.rpy:1385
translate russian audrey_lavish_propose_male_00507281:
    "Я встаю и надеваю кольца на все протянутые руки."

# ch/harems_full/office/events/office_harem_common.rpy:1386
translate russian audrey_lavish_propose_male_145278ba:
    "Чувствую на себе взгляды тех, кто отказал, но стараюсь не обращать внимания."

# ch/harems_full/office/events/office_harem_common.rpy:1387
translate russian audrey_lavish_propose_male_87970527:
    "Ох... будет тяжело."

# ch/harems_full/office/events/office_harem_common.rpy:1388
translate russian audrey_lavish_propose_male_b9ff0ddc:
    "Я буду скучать по тем, кто сказал нет."

# ch/harems_full/office/events/office_harem_common.rpy:1389
translate russian audrey_lavish_propose_male_76c588ba:
    "Но те из нас, кто решил быть вместе, должны и дальше идти вместе."

# ch/harems_full/office/events/office_harem_common.rpy:1390
translate russian audrey_lavish_propose_male_30f16e1e:
    "Мы тесно обнимаемся, пока остальные неловко выходят из комнаты."

# ch/harems_full/office/events/office_harem_common.rpy:1391
translate russian audrey_lavish_propose_male_adb1481c:
    "Мы вступаем на неизведанную территорию."

# ch/harems_full/office/events/office_harem_common.rpy:1392
translate russian audrey_lavish_propose_male_d873522f:
    "Но любовь, которую я чувствую от своих будущих жён, убеждает меня: у нас всё получится."

# ch/harems_full/office/events/office_harem_common.rpy:1396
translate russian aletta_shiori_propose_male_364318ef:
    "Поддерживать хорошие отношения со всеми девушками в офисе — всё равно что жонглировать бензопилами."

# ch/harems_full/office/events/office_harem_common.rpy:1397
translate russian aletta_shiori_propose_male_e341b6eb:
    "Это требует всей моей сосредоточенности и ловкости."

# ch/harems_full/office/events/office_harem_common.rpy:1398
translate russian aletta_shiori_propose_male_96d190b1:
    "И одна-единственная ошибка может обернуться для меня смертельно опасной ситуацией!"

# ch/harems_full/office/events/office_harem_common.rpy:1399
translate russian aletta_shiori_propose_male_b1997792:
    "Так что вы наверняка спросите, зачем мне вообще думать о предложении им всем."

# ch/harems_full/office/events/office_harem_common.rpy:1400
translate russian aletta_shiori_propose_male_4fde221b:
    "Но выслушайте меня, ладно?"

# ch/harems_full/office/events/office_harem_common.rpy:1401
translate russian aletta_shiori_propose_male_65bbe4f6:
    "По-моему, если мы поженимся, всё станет официально, верно?"

# ch/harems_full/office/events/office_harem_common.rpy:1402
translate russian aletta_shiori_propose_male_df9c8fe5:
    "Больше не придётся тайком встречаться за чужими спинами и бояться, что нас застукают."

# ch/harems_full/office/events/office_harem_common.rpy:1403
translate russian aletta_shiori_propose_male_afee1c3e:
    "Я прекрасно знаю, что многожёнство в нашей стране разрешили совсем недавно."

# ch/harems_full/office/events/office_harem_common.rpy:1404
translate russian aletta_shiori_propose_male_ee77a7df:
    "Но, по мне, жениться на двух не так уж отличается от женитьбы на одной."

# ch/harems_full/office/events/office_harem_common.rpy:1405
translate russian aletta_shiori_propose_male_6f8931d9:
    "Нет, настоящая разница в том, что придётся раскошелиться на два чёртовых кольца!"

# ch/harems_full/office/events/office_harem_common.rpy:1406
translate russian aletta_shiori_propose_male_a7aef0b5:
    "И ещё собрать их всех в одном месте, чтобы сделать предложение."

# ch/harems_full/office/events/office_harem_common.rpy:1407
translate russian aletta_shiori_propose_male_2687003b:
    "В конце концов я решаю притвориться, будто созываю совещание."

# ch/harems_full/office/events/office_harem_common.rpy:1408
translate russian aletta_shiori_propose_male_98304d93:
    "Вот почему сейчас жду их в переговорной."

# ch/harems_full/office/events/office_harem_common.rpy:1410
translate russian aletta_shiori_propose_male_8d38f9ef:
    "Алетта приходит первой, с очень деловым видом."

# ch/harems_full/office/events/office_harem_common.rpy:1411
translate russian aletta_shiori_propose_male_3ff50c07:
    "Чуть позже нехотя подтягивается Одри: хмурая, больше занятая телефоном, чем работой."

# ch/harems_full/office/events/office_harem_common.rpy:1412
translate russian aletta_shiori_propose_male_ac4b2b2c:
    "Я уже собираюсь закрыть дверь, когда вбегает Сиори."

# ch/harems_full/office/events/office_harem_common.rpy:1414
translate russian aletta_shiori_propose_male_5738db24:
    shiori.say "Прости, пожалуйста, [lssb_common.hero_name()]."

# ch/harems_full/office/events/office_harem_common.rpy:1415
translate russian aletta_shiori_propose_male_e9521209:
    shiori.say "Тот, кто подвозил меня на работу, опоздал."

# ch/harems_full/office/events/office_harem_common.rpy:1416
translate russian aletta_shiori_propose_male_dd1efdc0:
    shiori.say "А потом оказалось, что лифты не работают."

# ch/harems_full/office/events/office_harem_common.rpy:1417
translate russian aletta_shiori_propose_male_d74f7ff5:
    shiori.say "А потом..."

# ch/harems_full/office/events/office_harem_common.rpy:1418
translate russian aletta_shiori_propose_male_3406129d:
    mike.say "Всё хорошо, Сиори..."

# ch/harems_full/office/events/office_harem_common.rpy:1419
translate russian aletta_shiori_propose_male_193b86af:
    mike.say "Просто проходи и садись."

# ch/harems_full/office/events/office_harem_common.rpy:1420
translate russian aletta_shiori_propose_male_3e5cf0cb:
    "Сиори кивает и спешит выполнить просьбу."

# ch/harems_full/office/events/office_harem_common.rpy:1421
translate russian aletta_shiori_propose_male_e72d4c14:
    "Я подхожу к торцу стола, и все смотрят на меня."

# ch/harems_full/office/events/office_harem_common.rpy:1422
translate russian aletta_shiori_propose_male_12820c04:
    aletta.say "Должна сказать, это непрофессионально, [lssb_common.hero_name()]."

# ch/harems_full/office/events/office_harem_common.rpy:1424
translate russian aletta_shiori_propose_male_81173a57:
    aletta.say "Ты совсем не предупредил меня о совещании!"

# ch/harems_full/office/events/office_harem_common.rpy:1425
translate russian aletta_shiori_propose_male_f4e3a950:
    "Я натягиваю улыбку, убеждая себя, что это хорошая идея."

# ch/harems_full/office/events/office_harem_common.rpy:1426
translate russian aletta_shiori_propose_male_e5096f0b:
    "Я ведь люблю каждую из этих девушек, правда люблю."

# ch/harems_full/office/events/office_harem_common.rpy:1427
translate russian aletta_shiori_propose_male_fb5985a9:
    "Но прекрасно знаю, что временами они все могут быть той ещё занозой в заднице!"

# ch/harems_full/office/events/office_harem_common.rpy:1429
translate russian aletta_shiori_propose_male_4ab6d240:
    mike.say "Я не предупредил о встрече, потому что хотел сделать сюрприз."

# ch/harems_full/office/events/office_harem_common.rpy:1430
translate russian aletta_shiori_propose_male_106c67c0:
    mike.say "И мне нужно было собрать вас всех вместе, чтобы сделать вот что..."

# ch/harems_full/office/events/office_harem_common.rpy:1431
translate russian aletta_shiori_propose_male_05ee23d6:
    "Я опускаюсь на одно колено и достаю из кармана два одинаковых кольца."

# ch/harems_full/office/events/office_harem_common.rpy:1432
translate russian aletta_shiori_propose_male_b03b812e:
    mike.say "Алетта, Сиори..."

# ch/harems_full/office/events/office_harem_common.rpy:1434
translate russian aletta_shiori_propose_male_c795a089:
    mike.say "И друг за друга, наверное, тоже!"

# ch/harems_full/office/events/office_harem_common.rpy:1437
translate russian aletta_shiori_propose_male_b5700755:
    "Впервые на моей памяти все они лишаются дара речи."

# ch/harems_full/office/events/office_harem_common.rpy:1438
translate russian aletta_shiori_propose_male_4af83198:
    "Девушки смотрят на меня, затем переглядываются."

# ch/harems_full/office/events/office_harem_common.rpy:1439
translate russian aletta_shiori_propose_male_c6c3d050:
    "А я всё ещё стою на одном колене и жду ответа."

# ch/harems_full/office/events/office_harem_common.rpy:1442
translate russian aletta_shiori_propose_male_32e7a398:
    "Алетта по привычке сохраняет властный вид."

# ch/harems_full/office/events/office_harem_common.rpy:1443
translate russian aletta_shiori_propose_male_778a549a:
    "Отвечает первой, твёрдо и уверенно."

# ch/harems_full/office/events/office_harem_common.rpy:1444
translate russian aletta_shiori_propose_male_3f93e7ee:
    aletta.say "Определённо нет."

# ch/harems_full/office/events/office_harem_common.rpy:1445
translate russian aletta_shiori_propose_male_4b4ee576:
    aletta.say "Для меня эти отношения прежде всего деловая договорённость."

# ch/harems_full/office/events/office_harem_common.rpy:1446
translate russian aletta_shiori_propose_male_b0512339:
    aletta.say "И я не согласна превращать их в юридические обязательства."

# ch/harems_full/office/events/office_harem_common.rpy:1450
translate russian aletta_shiori_propose_male_32e7a398_1:
    "Алетта по привычке сохраняет властный вид."

# ch/harems_full/office/events/office_harem_common.rpy:1451
translate russian aletta_shiori_propose_male_778a549a_1:
    "Отвечает первой, твёрдо и уверенно."

# ch/harems_full/office/events/office_harem_common.rpy:1453
translate russian aletta_shiori_propose_male_7760ffd5:
    aletta.say "Да, [lssb_common.hero_name()]."

# ch/harems_full/office/events/office_harem_common.rpy:1454
translate russian aletta_shiori_propose_male_90dd339c:
    aletta.say "Признаюсь, в начале наших отношений я была... настроена скептически."

# ch/harems_full/office/events/office_harem_common.rpy:1455
translate russian aletta_shiori_propose_male_541a9e8a:
    aletta.say "Но всё оказалось гораздо лучше, чем я могла представить."

# ch/harems_full/office/events/office_harem_common.rpy:1459
translate russian aletta_shiori_propose_male_b134dbfd:
    "Сиори обводит взглядом всех присутствующих."

# ch/harems_full/office/events/office_harem_common.rpy:1460
translate russian aletta_shiori_propose_male_0841ed9b:
    "На мгновение мне кажется, что она попросит их решить за неё."

# ch/harems_full/office/events/office_harem_common.rpy:1461
translate russian aletta_shiori_propose_male_dd9a67f1:
    "Но в конце концов набирается смелости высказаться сама."

# ch/harems_full/office/events/office_harem_common.rpy:1462
translate russian aletta_shiori_propose_male_0c945ab9:
    shiori.say "Я... я говорю нет."

# ch/harems_full/office/events/office_harem_common.rpy:1463
translate russian aletta_shiori_propose_male_fc11a726:
    shiori.say "Мне кажется, я теряю себя в этих отношениях."

# ch/harems_full/office/events/office_harem_common.rpy:1464
translate russian aletta_shiori_propose_male_f21a3a74:
    shiori.say "Будто все воспринимают меня как должное и не замечают!"

# ch/harems_full/office/events/office_harem_common.rpy:1468
translate russian aletta_shiori_propose_male_b134dbfd_1:
    "Сиори обводит взглядом всех присутствующих."

# ch/harems_full/office/events/office_harem_common.rpy:1469
translate russian aletta_shiori_propose_male_0841ed9b_1:
    "На мгновение мне кажется, что она попросит их решить за неё."

# ch/harems_full/office/events/office_harem_common.rpy:1470
translate russian aletta_shiori_propose_male_dd9a67f1_1:
    "Но в конце концов набирается смелости высказаться сама."

# ch/harems_full/office/events/office_harem_common.rpy:1472
translate russian aletta_shiori_propose_male_e482cd60:
    shiori.say "Я... я говорю да."

# ch/harems_full/office/events/office_harem_common.rpy:1473
translate russian aletta_shiori_propose_male_8714c3bc:
    shiori.say "Мне нравится быть в отношениях со всеми вами."

# ch/harems_full/office/events/office_harem_common.rpy:1474
translate russian aletta_shiori_propose_male_18c577cd:
    shiori.say "Я больше не чувствую себя одинокой и потерянной!"

# ch/harems_full/office/events/office_harem_common.rpy:1476
translate russian aletta_shiori_propose_male_b4daf315:
    "Слушая их ответы, я чувствую, как колотится сердце."

# ch/harems_full/office/events/office_harem_common.rpy:1477
translate russian aletta_shiori_propose_male_8f6f25a5:
    "Но разве могло быть иначе?"

# ch/harems_full/office/events/office_harem_common.rpy:1478
translate russian aletta_shiori_propose_male_edd36fb9:
    "Я прошу их принять очень важное решение."

# ch/harems_full/office/events/office_harem_common.rpy:1479
translate russian aletta_shiori_propose_male_f865e794:
    "И оно неизбежно вызовет уйму эмоций."

# ch/harems_full/office/events/office_harem_common.rpy:1481
translate russian aletta_shiori_propose_male_13c7fcb6:
    "Я встаю и начинаю надевать кольца им на пальцы."

# ch/harems_full/office/events/office_harem_common.rpy:1482
translate russian aletta_shiori_propose_male_d5d90334:
    "Вскоре всё готово, и девушки любуются новыми украшениями."

# ch/harems_full/office/events/office_harem_common.rpy:1483
translate russian aletta_shiori_propose_male_78889186:
    "Мне хочется ущипнуть себя, чтобы убедиться, что всё происходит наяву."

# ch/harems_full/office/events/office_harem_common.rpy:1484
translate russian aletta_shiori_propose_male_f7431606:
    "Я правда женюсь на обеих?"

# ch/harems_full/office/events/office_harem_common.rpy:1485
translate russian aletta_shiori_propose_male_4c5a0d94:
    aletta.say "Конец разгульной жизни, [lssb_common.hero_name()]."

# ch/harems_full/office/events/office_harem_common.rpy:1486
translate russian aletta_shiori_propose_male_3c7629de:
    aletta.say "Ты станешь женатым человеком!"

# ch/harems_full/office/events/office_harem_common.rpy:1487
translate russian aletta_shiori_propose_male_f5fb2207:
    shiori.say "Я... я не против быть старомодной женой."

# ch/harems_full/office/events/office_harem_common.rpy:1488
translate russian aletta_shiori_propose_male_c38cab66:
    shiori.say "[lssb_common.hero_name()] может командовать мной сколько угодно!"

# ch/harems_full/office/events/office_harem_common.rpy:1489
translate russian aletta_shiori_propose_male_15b9ffd0:
    "Слушая их разговор, я невольно улыбаюсь."

# ch/harems_full/office/events/office_harem_common.rpy:1490
translate russian aletta_shiori_propose_male_a8d31bfa:
    "Конечно, компания у нас довольно странная."

# ch/harems_full/office/events/office_harem_common.rpy:1491
translate russian aletta_shiori_propose_male_bc68ba24:
    "Но мне кажется, именно это и поможет нам ужиться."

# ch/harems_full/office/events/office_harem_common.rpy:1492
translate russian aletta_shiori_propose_male_786dfb38:
    "Ведь каждому предстоит жить ещё с двумя людьми."

# ch/harems_full/office/events/office_harem_common.rpy:1493
translate russian aletta_shiori_propose_male_ba9cf855:
    "Что может быть хуже, чем если бы все они были похожи на тебя?"

# ch/harems_full/office/events/office_harem_common.rpy:1495
translate russian aletta_shiori_propose_male_8b6a38ef:
    "Я встаю и неловко прячу в карман два кольца, которые теперь не нужны."

# ch/harems_full/office/events/office_harem_common.rpy:1496
translate russian aletta_shiori_propose_male_f4c72828:
    "Все смотрят на меня, и унижение кажется полным."

# ch/harems_full/office/events/office_harem_common.rpy:1497
translate russian aletta_shiori_propose_male_6280299a:
    "Хуже будет, только если с меня свалятся штаны или я вдруг вспыхну."

# ch/harems_full/office/events/office_harem_common.rpy:1498
translate russian aletta_shiori_propose_male_c62fd749:
    "Хотя нет, беру слова обратно: такое хоть отвлекло бы внимание!"

# ch/harems_full/office/events/office_harem_common.rpy:1500
translate russian aletta_shiori_propose_male_d98e6ad4:
    mike.say "Ладно..."

# ch/harems_full/office/events/office_harem_common.rpy:1501
translate russian aletta_shiori_propose_male_1873393c:
    mike.say "Думаю, совещание окончено!"

# ch/harems_full/office/events/office_harem_common.rpy:1502
translate russian aletta_shiori_propose_male_cfe19add:
    "Я разворачиваюсь и почти выбегаю из переговорной."

# ch/harems_full/office/events/office_harem_common.rpy:1503
translate russian aletta_shiori_propose_male_d51d0fc9:
    "Я сбегаю, прежде чем успеваю услышать за спиной их голоса."

# ch/harems_full/office/events/office_harem_common.rpy:1504
translate russian aletta_shiori_propose_male_bf431521:
    "Прежде чем придётся отвечать на вопросы, каждый из которых был бы пыткой."

# ch/harems_full/office/events/office_harem_common.rpy:1505
translate russian aletta_shiori_propose_male_dba951ec:
    "Может, сейчас самое время использовать накопившиеся отпускные дни?"

# ch/harems_full/office/events/office_harem_common.rpy:1506
translate russian aletta_shiori_propose_male_20f24199:
    "Или взять длительный отпуск и уйти в монастырь?"

# ch/harems_full/office/events/office_harem_common.rpy:1507
translate russian aletta_shiori_propose_male_18338f00:
    "Что угодно, лишь бы подальше отсюда и от двух женщин, которые одновременно мне отказали!"

# ch/harems_full/office/events/office_harem_common.rpy:1509
translate russian aletta_shiori_propose_male_00507281:
    "Я встаю и надеваю кольца на все протянутые руки."

# ch/harems_full/office/events/office_harem_common.rpy:1510
translate russian aletta_shiori_propose_male_145278ba:
    "Чувствую на себе взгляды тех, кто отказал, но стараюсь не обращать внимания."

# ch/harems_full/office/events/office_harem_common.rpy:1511
translate russian aletta_shiori_propose_male_87970527:
    "Ох... будет тяжело."

# ch/harems_full/office/events/office_harem_common.rpy:1512
translate russian aletta_shiori_propose_male_b9ff0ddc:
    "Я буду скучать по тем, кто сказал нет."

# ch/harems_full/office/events/office_harem_common.rpy:1513
translate russian aletta_shiori_propose_male_76c588ba:
    "Но те из нас, кто решил быть вместе, должны и дальше идти вместе."

# ch/harems_full/office/events/office_harem_common.rpy:1514
translate russian aletta_shiori_propose_male_30f16e1e:
    "Мы тесно обнимаемся, пока остальные неловко выходят из комнаты."

# ch/harems_full/office/events/office_harem_common.rpy:1515
translate russian aletta_shiori_propose_male_adb1481c:
    "Мы вступаем на неизведанную территорию."

# ch/harems_full/office/events/office_harem_common.rpy:1516
translate russian aletta_shiori_propose_male_d873522f:
    "Но любовь, которую я чувствую от своих будущих жён, убеждает меня: у нас всё получится."

# ch/harems_full/office/events/office_harem_common.rpy:1520
translate russian aletta_lavish_propose_male_364318ef:
    "Поддерживать хорошие отношения со всеми девушками в офисе — всё равно что жонглировать бензопилами."

# ch/harems_full/office/events/office_harem_common.rpy:1521
translate russian aletta_lavish_propose_male_e341b6eb:
    "Это требует всей моей сосредоточенности и ловкости."

# ch/harems_full/office/events/office_harem_common.rpy:1522
translate russian aletta_lavish_propose_male_96d190b1:
    "И одна-единственная ошибка может обернуться для меня смертельно опасной ситуацией!"

# ch/harems_full/office/events/office_harem_common.rpy:1523
translate russian aletta_lavish_propose_male_b1997792:
    "Так что вы наверняка спросите, зачем мне вообще думать о предложении им всем."

# ch/harems_full/office/events/office_harem_common.rpy:1524
translate russian aletta_lavish_propose_male_4fde221b:
    "Но выслушайте меня, ладно?"

# ch/harems_full/office/events/office_harem_common.rpy:1525
translate russian aletta_lavish_propose_male_65bbe4f6:
    "По-моему, если мы поженимся, всё станет официально, верно?"

# ch/harems_full/office/events/office_harem_common.rpy:1526
translate russian aletta_lavish_propose_male_df9c8fe5:
    "Больше не придётся тайком встречаться за чужими спинами и бояться, что нас застукают."

# ch/harems_full/office/events/office_harem_common.rpy:1527
translate russian aletta_lavish_propose_male_afee1c3e:
    "Я прекрасно знаю, что многожёнство в нашей стране разрешили совсем недавно."

# ch/harems_full/office/events/office_harem_common.rpy:1528
translate russian aletta_lavish_propose_male_ee77a7df:
    "Но, по мне, жениться на двух не так уж отличается от женитьбы на одной."

# ch/harems_full/office/events/office_harem_common.rpy:1529
translate russian aletta_lavish_propose_male_6f8931d9:
    "Нет, настоящая разница в том, что придётся раскошелиться на два чёртовых кольца!"

# ch/harems_full/office/events/office_harem_common.rpy:1530
translate russian aletta_lavish_propose_male_a7aef0b5:
    "И ещё собрать их всех в одном месте, чтобы сделать предложение."

# ch/harems_full/office/events/office_harem_common.rpy:1531
translate russian aletta_lavish_propose_male_2687003b:
    "В конце концов я решаю притвориться, будто созываю совещание."

# ch/harems_full/office/events/office_harem_common.rpy:1532
translate russian aletta_lavish_propose_male_98304d93:
    "Вот почему сейчас жду их в переговорной."

# ch/harems_full/office/events/office_harem_common.rpy:1534
translate russian aletta_lavish_propose_male_8d38f9ef:
    "Алетта приходит первой, с очень деловым видом."

# ch/harems_full/office/events/office_harem_common.rpy:1536
translate russian aletta_lavish_propose_male_86c46c0c:
    "Следом входит Лавиш, как всегда собранная и готовая к совещанию."

# ch/harems_full/office/events/office_harem_common.rpy:1537
translate russian aletta_lavish_propose_male_e72d4c14:
    "Я подхожу к торцу стола, и все смотрят на меня."

# ch/harems_full/office/events/office_harem_common.rpy:1538
translate russian aletta_lavish_propose_male_12820c04:
    aletta.say "Должна сказать, это непрофессионально, [lssb_common.hero_name()]."

# ch/harems_full/office/events/office_harem_common.rpy:1540
translate russian aletta_lavish_propose_male_81173a57:
    aletta.say "Ты совсем не предупредил меня о совещании!"

# ch/harems_full/office/events/office_harem_common.rpy:1541
translate russian aletta_lavish_propose_male_ba5b29d4:
    lavish.say "Алетта права, [lssb_common.hero_name()]."

# ch/harems_full/office/events/office_harem_common.rpy:1543
translate russian aletta_lavish_propose_male_e866e559:
    lavish.say "Я не успела подготовиться за такое короткое время."

# ch/harems_full/office/events/office_harem_common.rpy:1544
translate russian aletta_lavish_propose_male_f4e3a950:
    "Я натягиваю улыбку, убеждая себя, что это хорошая идея."

# ch/harems_full/office/events/office_harem_common.rpy:1545
translate russian aletta_lavish_propose_male_e5096f0b:
    "Я ведь люблю каждую из этих девушек, правда люблю."

# ch/harems_full/office/events/office_harem_common.rpy:1546
translate russian aletta_lavish_propose_male_fb5985a9:
    "Но прекрасно знаю, что временами они все могут быть той ещё занозой в заднице!"

# ch/harems_full/office/events/office_harem_common.rpy:1548
translate russian aletta_lavish_propose_male_4ab6d240:
    mike.say "Я не предупредил о встрече, потому что хотел сделать сюрприз."

# ch/harems_full/office/events/office_harem_common.rpy:1549
translate russian aletta_lavish_propose_male_106c67c0:
    mike.say "И мне нужно было собрать вас всех вместе, чтобы сделать вот что..."

# ch/harems_full/office/events/office_harem_common.rpy:1550
translate russian aletta_lavish_propose_male_05ee23d6:
    "Я опускаюсь на одно колено и достаю из кармана два одинаковых кольца."

# ch/harems_full/office/events/office_harem_common.rpy:1551
translate russian aletta_lavish_propose_male_cf6f21de:
    mike.say "Алетта, Лавиш..."

# ch/harems_full/office/events/office_harem_common.rpy:1553
translate russian aletta_lavish_propose_male_c795a089:
    mike.say "И друг за друга, наверное, тоже!"

# ch/harems_full/office/events/office_harem_common.rpy:1556
translate russian aletta_lavish_propose_male_b5700755:
    "Впервые на моей памяти все они лишаются дара речи."

# ch/harems_full/office/events/office_harem_common.rpy:1557
translate russian aletta_lavish_propose_male_4af83198:
    "Девушки смотрят на меня, затем переглядываются."

# ch/harems_full/office/events/office_harem_common.rpy:1558
translate russian aletta_lavish_propose_male_c6c3d050:
    "А я всё ещё стою на одном колене и жду ответа."

# ch/harems_full/office/events/office_harem_common.rpy:1561
translate russian aletta_lavish_propose_male_32e7a398:
    "Алетта по привычке сохраняет властный вид."

# ch/harems_full/office/events/office_harem_common.rpy:1562
translate russian aletta_lavish_propose_male_778a549a:
    "Отвечает первой, твёрдо и уверенно."

# ch/harems_full/office/events/office_harem_common.rpy:1563
translate russian aletta_lavish_propose_male_3f93e7ee:
    aletta.say "Определённо нет."

# ch/harems_full/office/events/office_harem_common.rpy:1564
translate russian aletta_lavish_propose_male_4b4ee576:
    aletta.say "Для меня эти отношения прежде всего деловая договорённость."

# ch/harems_full/office/events/office_harem_common.rpy:1565
translate russian aletta_lavish_propose_male_b0512339:
    aletta.say "И я не согласна превращать их в юридические обязательства."

# ch/harems_full/office/events/office_harem_common.rpy:1569
translate russian aletta_lavish_propose_male_32e7a398_1:
    "Алетта по привычке сохраняет властный вид."

# ch/harems_full/office/events/office_harem_common.rpy:1570
translate russian aletta_lavish_propose_male_778a549a_1:
    "Отвечает первой, твёрдо и уверенно."

# ch/harems_full/office/events/office_harem_common.rpy:1572
translate russian aletta_lavish_propose_male_7760ffd5:
    aletta.say "Да, [lssb_common.hero_name()]."

# ch/harems_full/office/events/office_harem_common.rpy:1573
translate russian aletta_lavish_propose_male_90dd339c:
    aletta.say "Признаюсь, в начале наших отношений я была... настроена скептически."

# ch/harems_full/office/events/office_harem_common.rpy:1574
translate russian aletta_lavish_propose_male_541a9e8a:
    aletta.say "Но всё оказалось гораздо лучше, чем я могла представить."

# ch/harems_full/office/events/office_harem_common.rpy:1578
translate russian aletta_lavish_propose_male_a94738bd:
    "Лавиш выглядит задумчивой, словно всерьёз взвешивает ответ."

# ch/harems_full/office/events/office_harem_common.rpy:1579
translate russian aletta_lavish_propose_male_539a5760:
    "Затем кивает и коротко выдыхает."

# ch/harems_full/office/events/office_harem_common.rpy:1580
translate russian aletta_lavish_propose_male_4879009e:
    lavish.say "Придётся сказать нет."

# ch/harems_full/office/events/office_harem_common.rpy:1581
translate russian aletta_lavish_propose_male_a845c91a:
    lavish.say "Не думаю, что эти отношения идут мне на пользу."

# ch/harems_full/office/events/office_harem_common.rpy:1582
translate russian aletta_lavish_propose_male_f79e418c:
    lavish.say "И, скорее всего, помешают моим долгосрочным карьерным планам."

# ch/harems_full/office/events/office_harem_common.rpy:1586
translate russian aletta_lavish_propose_male_a94738bd_1:
    "Лавиш выглядит задумчивой, словно всерьёз взвешивает ответ."

# ch/harems_full/office/events/office_harem_common.rpy:1587
translate russian aletta_lavish_propose_male_539a5760_1:
    "Затем кивает и коротко выдыхает."

# ch/harems_full/office/events/office_harem_common.rpy:1589
translate russian aletta_lavish_propose_male_26ac0382:
    lavish.say "Я говорю да."

# ch/harems_full/office/events/office_harem_common.rpy:1590
translate russian aletta_lavish_propose_male_f804e109:
    lavish.say "Отношения у нас, конечно, немного странные."

# ch/harems_full/office/events/office_harem_common.rpy:1591
translate russian aletta_lavish_propose_male_9618b8ed:
    lavish.say "Но всё, похоже, получается, и мне очень нравится!"

# ch/harems_full/office/events/office_harem_common.rpy:1593
translate russian aletta_lavish_propose_male_b4daf315:
    "Слушая их ответы, я чувствую, как колотится сердце."

# ch/harems_full/office/events/office_harem_common.rpy:1594
translate russian aletta_lavish_propose_male_8f6f25a5:
    "Но разве могло быть иначе?"

# ch/harems_full/office/events/office_harem_common.rpy:1595
translate russian aletta_lavish_propose_male_edd36fb9:
    "Я прошу их принять очень важное решение."

# ch/harems_full/office/events/office_harem_common.rpy:1596
translate russian aletta_lavish_propose_male_f865e794:
    "И оно неизбежно вызовет уйму эмоций."

# ch/harems_full/office/events/office_harem_common.rpy:1598
translate russian aletta_lavish_propose_male_13c7fcb6:
    "Я встаю и начинаю надевать кольца им на пальцы."

# ch/harems_full/office/events/office_harem_common.rpy:1599
translate russian aletta_lavish_propose_male_d5d90334:
    "Вскоре всё готово, и девушки любуются новыми украшениями."

# ch/harems_full/office/events/office_harem_common.rpy:1600
translate russian aletta_lavish_propose_male_78889186:
    "Мне хочется ущипнуть себя, чтобы убедиться, что всё происходит наяву."

# ch/harems_full/office/events/office_harem_common.rpy:1601
translate russian aletta_lavish_propose_male_f7431606:
    "Я правда женюсь на обеих?"

# ch/harems_full/office/events/office_harem_common.rpy:1602
translate russian aletta_lavish_propose_male_4c5a0d94:
    aletta.say "Конец разгульной жизни, [lssb_common.hero_name()]."

# ch/harems_full/office/events/office_harem_common.rpy:1603
translate russian aletta_lavish_propose_male_3c7629de:
    aletta.say "Ты станешь женатым человеком!"

# ch/harems_full/office/events/office_harem_common.rpy:1604
translate russian aletta_lavish_propose_male_79920888:
    lavish.say "Ну... он может сказать о нас то же самое, Одри!"

# ch/harems_full/office/events/office_harem_common.rpy:1605
translate russian aletta_lavish_propose_male_3d0aa6e6:
    lavish.say "В конце концов, брак — равноправное партнёрство."

# ch/harems_full/office/events/office_harem_common.rpy:1606
translate russian aletta_lavish_propose_male_15b9ffd0:
    "Слушая их разговор, я невольно улыбаюсь."

# ch/harems_full/office/events/office_harem_common.rpy:1607
translate russian aletta_lavish_propose_male_a8d31bfa:
    "Конечно, компания у нас довольно странная."

# ch/harems_full/office/events/office_harem_common.rpy:1608
translate russian aletta_lavish_propose_male_bc68ba24:
    "Но мне кажется, именно это и поможет нам ужиться."

# ch/harems_full/office/events/office_harem_common.rpy:1609
translate russian aletta_lavish_propose_male_786dfb38:
    "Ведь каждому предстоит жить ещё с двумя людьми."

# ch/harems_full/office/events/office_harem_common.rpy:1610
translate russian aletta_lavish_propose_male_ba9cf855:
    "Что может быть хуже, чем если бы все они были похожи на тебя?"

# ch/harems_full/office/events/office_harem_common.rpy:1612
translate russian aletta_lavish_propose_male_8b6a38ef:
    "Я встаю и неловко прячу в карман два кольца, которые теперь не нужны."

# ch/harems_full/office/events/office_harem_common.rpy:1613
translate russian aletta_lavish_propose_male_f4c72828:
    "Все смотрят на меня, и унижение кажется полным."

# ch/harems_full/office/events/office_harem_common.rpy:1614
translate russian aletta_lavish_propose_male_6280299a:
    "Хуже будет, только если с меня свалятся штаны или я вдруг вспыхну."

# ch/harems_full/office/events/office_harem_common.rpy:1615
translate russian aletta_lavish_propose_male_c62fd749:
    "Хотя нет, беру слова обратно: такое хоть отвлекло бы внимание!"

# ch/harems_full/office/events/office_harem_common.rpy:1617
translate russian aletta_lavish_propose_male_d98e6ad4:
    mike.say "Ладно..."

# ch/harems_full/office/events/office_harem_common.rpy:1618
translate russian aletta_lavish_propose_male_1873393c:
    mike.say "Думаю, совещание окончено!"

# ch/harems_full/office/events/office_harem_common.rpy:1619
translate russian aletta_lavish_propose_male_cfe19add:
    "Я разворачиваюсь и почти выбегаю из переговорной."

# ch/harems_full/office/events/office_harem_common.rpy:1620
translate russian aletta_lavish_propose_male_d51d0fc9:
    "Я сбегаю, прежде чем успеваю услышать за спиной их голоса."

# ch/harems_full/office/events/office_harem_common.rpy:1621
translate russian aletta_lavish_propose_male_bf431521:
    "Прежде чем придётся отвечать на вопросы, каждый из которых был бы пыткой."

# ch/harems_full/office/events/office_harem_common.rpy:1622
translate russian aletta_lavish_propose_male_dba951ec:
    "Может, сейчас самое время использовать накопившиеся отпускные дни?"

# ch/harems_full/office/events/office_harem_common.rpy:1623
translate russian aletta_lavish_propose_male_20f24199:
    "Или взять длительный отпуск и уйти в монастырь?"

# ch/harems_full/office/events/office_harem_common.rpy:1624
translate russian aletta_lavish_propose_male_18338f00:
    "Что угодно, лишь бы подальше отсюда и от двух женщин, которые одновременно мне отказали!"

# ch/harems_full/office/events/office_harem_common.rpy:1626
translate russian aletta_lavish_propose_male_00507281:
    "Я встаю и надеваю кольца на все протянутые руки."

# ch/harems_full/office/events/office_harem_common.rpy:1627
translate russian aletta_lavish_propose_male_145278ba:
    "Чувствую на себе взгляды тех, кто отказал, но стараюсь не обращать внимания."

# ch/harems_full/office/events/office_harem_common.rpy:1628
translate russian aletta_lavish_propose_male_87970527:
    "Ох... будет тяжело."

# ch/harems_full/office/events/office_harem_common.rpy:1629
translate russian aletta_lavish_propose_male_b9ff0ddc:
    "Я буду скучать по тем, кто сказал нет."

# ch/harems_full/office/events/office_harem_common.rpy:1630
translate russian aletta_lavish_propose_male_76c588ba:
    "Но те из нас, кто решил быть вместе, должны и дальше идти вместе."

# ch/harems_full/office/events/office_harem_common.rpy:1631
translate russian aletta_lavish_propose_male_30f16e1e:
    "Мы тесно обнимаемся, пока остальные неловко выходят из комнаты."

# ch/harems_full/office/events/office_harem_common.rpy:1632
translate russian aletta_lavish_propose_male_adb1481c:
    "Мы вступаем на неизведанную территорию."

# ch/harems_full/office/events/office_harem_common.rpy:1633
translate russian aletta_lavish_propose_male_d873522f:
    "Но любовь, которую я чувствую от своих будущих жён, убеждает меня: у нас всё получится."

# ch/harems_full/office/events/office_harem_common.rpy:1637
translate russian aletta_audrey_propose_male_364318ef:
    "Поддерживать хорошие отношения со всеми девушками в офисе — всё равно что жонглировать бензопилами."

# ch/harems_full/office/events/office_harem_common.rpy:1638
translate russian aletta_audrey_propose_male_e341b6eb:
    "Это требует всей моей сосредоточенности и ловкости."

# ch/harems_full/office/events/office_harem_common.rpy:1639
translate russian aletta_audrey_propose_male_96d190b1:
    "И одна-единственная ошибка может обернуться для меня смертельно опасной ситуацией!"

# ch/harems_full/office/events/office_harem_common.rpy:1640
translate russian aletta_audrey_propose_male_b1997792:
    "Так что вы наверняка спросите, зачем мне вообще думать о предложении им всем."

# ch/harems_full/office/events/office_harem_common.rpy:1641
translate russian aletta_audrey_propose_male_4fde221b:
    "Но выслушайте меня, ладно?"

# ch/harems_full/office/events/office_harem_common.rpy:1642
translate russian aletta_audrey_propose_male_65bbe4f6:
    "По-моему, если мы поженимся, всё станет официально, верно?"

# ch/harems_full/office/events/office_harem_common.rpy:1643
translate russian aletta_audrey_propose_male_df9c8fe5:
    "Больше не придётся тайком встречаться за чужими спинами и бояться, что нас застукают."

# ch/harems_full/office/events/office_harem_common.rpy:1644
translate russian aletta_audrey_propose_male_afee1c3e:
    "Я прекрасно знаю, что многожёнство в нашей стране разрешили совсем недавно."

# ch/harems_full/office/events/office_harem_common.rpy:1645
translate russian aletta_audrey_propose_male_ee77a7df:
    "Но, по мне, жениться на двух не так уж отличается от женитьбы на одной."

# ch/harems_full/office/events/office_harem_common.rpy:1646
translate russian aletta_audrey_propose_male_6f8931d9:
    "Нет, настоящая разница в том, что придётся раскошелиться на два чёртовых кольца!"

# ch/harems_full/office/events/office_harem_common.rpy:1647
translate russian aletta_audrey_propose_male_a7aef0b5:
    "И ещё собрать их всех в одном месте, чтобы сделать предложение."

# ch/harems_full/office/events/office_harem_common.rpy:1648
translate russian aletta_audrey_propose_male_2687003b:
    "В конце концов я решаю притвориться, будто созываю совещание."

# ch/harems_full/office/events/office_harem_common.rpy:1649
translate russian aletta_audrey_propose_male_98304d93:
    "Вот почему сейчас жду их в переговорной."

# ch/harems_full/office/events/office_harem_common.rpy:1651
translate russian aletta_audrey_propose_male_8d38f9ef:
    "Алетта приходит первой, с очень деловым видом."

# ch/harems_full/office/events/office_harem_common.rpy:1653
translate russian aletta_audrey_propose_male_3ff50c07:
    "Чуть позже нехотя подтягивается Одри: хмурая, больше занятая телефоном, чем работой."

# ch/harems_full/office/events/office_harem_common.rpy:1654
translate russian aletta_audrey_propose_male_e72d4c14:
    "Я подхожу к торцу стола, и все смотрят на меня."

# ch/harems_full/office/events/office_harem_common.rpy:1655
translate russian aletta_audrey_propose_male_12820c04:
    aletta.say "Должна сказать, это непрофессионально, [lssb_common.hero_name()]."

# ch/harems_full/office/events/office_harem_common.rpy:1657
translate russian aletta_audrey_propose_male_81173a57:
    aletta.say "Ты совсем не предупредил меня о совещании!"

# ch/harems_full/office/events/office_harem_common.rpy:1658
translate russian aletta_audrey_propose_male_7c1997fb:
    audrey.say "Кого это, чёрт возьми, волнует?"

# ch/harems_full/office/events/office_harem_common.rpy:1659
translate russian aletta_audrey_propose_male_d0d58d00:
    audrey.say "Давайте уже закончим и уберёмся отсюда!"

# ch/harems_full/office/events/office_harem_common.rpy:1660
translate russian aletta_audrey_propose_male_f4e3a950:
    "Я натягиваю улыбку, убеждая себя, что это хорошая идея."

# ch/harems_full/office/events/office_harem_common.rpy:1661
translate russian aletta_audrey_propose_male_e5096f0b:
    "Я ведь люблю каждую из этих девушек, правда люблю."

# ch/harems_full/office/events/office_harem_common.rpy:1662
translate russian aletta_audrey_propose_male_fb5985a9:
    "Но прекрасно знаю, что временами они все могут быть той ещё занозой в заднице!"

# ch/harems_full/office/events/office_harem_common.rpy:1664
translate russian aletta_audrey_propose_male_4ab6d240:
    mike.say "Я не предупредил о встрече, потому что хотел сделать сюрприз."

# ch/harems_full/office/events/office_harem_common.rpy:1665
translate russian aletta_audrey_propose_male_106c67c0:
    mike.say "И мне нужно было собрать вас всех вместе, чтобы сделать вот что..."

# ch/harems_full/office/events/office_harem_common.rpy:1666
translate russian aletta_audrey_propose_male_05ee23d6:
    "Я опускаюсь на одно колено и достаю из кармана два одинаковых кольца."

# ch/harems_full/office/events/office_harem_common.rpy:1667
translate russian aletta_audrey_propose_male_b18e963e:
    mike.say "Алетта, Одри..."

# ch/harems_full/office/events/office_harem_common.rpy:1669
translate russian aletta_audrey_propose_male_c795a089:
    mike.say "И друг за друга, наверное, тоже!"

# ch/harems_full/office/events/office_harem_common.rpy:1672
translate russian aletta_audrey_propose_male_b5700755:
    "Впервые на моей памяти все они лишаются дара речи."

# ch/harems_full/office/events/office_harem_common.rpy:1673
translate russian aletta_audrey_propose_male_4af83198:
    "Девушки смотрят на меня, затем переглядываются."

# ch/harems_full/office/events/office_harem_common.rpy:1674
translate russian aletta_audrey_propose_male_c6c3d050:
    "А я всё ещё стою на одном колене и жду ответа."

# ch/harems_full/office/events/office_harem_common.rpy:1677
translate russian aletta_audrey_propose_male_32e7a398:
    "Алетта по привычке сохраняет властный вид."

# ch/harems_full/office/events/office_harem_common.rpy:1678
translate russian aletta_audrey_propose_male_778a549a:
    "Отвечает первой, твёрдо и уверенно."

# ch/harems_full/office/events/office_harem_common.rpy:1679
translate russian aletta_audrey_propose_male_3f93e7ee:
    aletta.say "Определённо нет."

# ch/harems_full/office/events/office_harem_common.rpy:1680
translate russian aletta_audrey_propose_male_4b4ee576:
    aletta.say "Для меня эти отношения прежде всего деловая договорённость."

# ch/harems_full/office/events/office_harem_common.rpy:1681
translate russian aletta_audrey_propose_male_b0512339:
    aletta.say "И я не согласна превращать их в юридические обязательства."

# ch/harems_full/office/events/office_harem_common.rpy:1685
translate russian aletta_audrey_propose_male_32e7a398_1:
    "Алетта по привычке сохраняет властный вид."

# ch/harems_full/office/events/office_harem_common.rpy:1686
translate russian aletta_audrey_propose_male_778a549a_1:
    "Отвечает первой, твёрдо и уверенно."

# ch/harems_full/office/events/office_harem_common.rpy:1688
translate russian aletta_audrey_propose_male_7760ffd5:
    aletta.say "Да, [lssb_common.hero_name()]."

# ch/harems_full/office/events/office_harem_common.rpy:1689
translate russian aletta_audrey_propose_male_90dd339c:
    aletta.say "Признаюсь, в начале наших отношений я была... настроена скептически."

# ch/harems_full/office/events/office_harem_common.rpy:1690
translate russian aletta_audrey_propose_male_541a9e8a:
    aletta.say "Но всё оказалось гораздо лучше, чем я могла представить."

# ch/harems_full/office/events/office_harem_common.rpy:1694
translate russian aletta_audrey_propose_male_947bcb8b:
    "Одри странно кривится, словно усиленно думает."

# ch/harems_full/office/events/office_harem_common.rpy:1695
translate russian aletta_audrey_propose_male_7a5bdb84:
    "А затем отвечает с обычной прямотой."

# ch/harems_full/office/events/office_harem_common.rpy:1696
translate russian aletta_audrey_propose_male_90eda6e5:
    audrey.say "Чёрта с два! Ещё не хватало выйти за вас, неудачников!"

# ch/harems_full/office/events/office_harem_common.rpy:1697
translate russian aletta_audrey_propose_male_5860ad2b:
    audrey.say "Мне уже достаточно того, что приходится с вами работать."

# ch/harems_full/office/events/office_harem_common.rpy:1698
translate russian aletta_audrey_propose_male_d3306c4e:
    audrey.say "Забудьте о том, чтобы провести вместе ещё и всю жизнь!"

# ch/harems_full/office/events/office_harem_common.rpy:1702
translate russian aletta_audrey_propose_male_947bcb8b_1:
    "Одри странно кривится, словно усиленно думает."

# ch/harems_full/office/events/office_harem_common.rpy:1703
translate russian aletta_audrey_propose_male_7a5bdb84_1:
    "А затем отвечает с обычной прямотой."

# ch/harems_full/office/events/office_harem_common.rpy:1705
translate russian aletta_audrey_propose_male_17387692:
    audrey.say "Да, я согласна."

# ch/harems_full/office/events/office_harem_common.rpy:1706
translate russian aletta_audrey_propose_male_e53de238:
    audrey.say "Вы все по-прежнему слишком зажатые."

# ch/harems_full/office/events/office_harem_common.rpy:1707
translate russian aletta_audrey_propose_male_19aa4504:
    audrey.say "И без меня вам эти палки из задниц не вытащить!"

# ch/harems_full/office/events/office_harem_common.rpy:1709
translate russian aletta_audrey_propose_male_b4daf315:
    "Слушая их ответы, я чувствую, как колотится сердце."

# ch/harems_full/office/events/office_harem_common.rpy:1710
translate russian aletta_audrey_propose_male_8f6f25a5:
    "Но разве могло быть иначе?"

# ch/harems_full/office/events/office_harem_common.rpy:1711
translate russian aletta_audrey_propose_male_edd36fb9:
    "Я прошу их принять очень важное решение."

# ch/harems_full/office/events/office_harem_common.rpy:1712
translate russian aletta_audrey_propose_male_f865e794:
    "И оно неизбежно вызовет уйму эмоций."

# ch/harems_full/office/events/office_harem_common.rpy:1714
translate russian aletta_audrey_propose_male_13c7fcb6:
    "Я встаю и начинаю надевать кольца им на пальцы."

# ch/harems_full/office/events/office_harem_common.rpy:1715
translate russian aletta_audrey_propose_male_d5d90334:
    "Вскоре всё готово, и девушки любуются новыми украшениями."

# ch/harems_full/office/events/office_harem_common.rpy:1716
translate russian aletta_audrey_propose_male_78889186:
    "Мне хочется ущипнуть себя, чтобы убедиться, что всё происходит наяву."

# ch/harems_full/office/events/office_harem_common.rpy:1717
translate russian aletta_audrey_propose_male_f7431606:
    "Я правда женюсь на обеих?"

# ch/harems_full/office/events/office_harem_common.rpy:1718
translate russian aletta_audrey_propose_male_4c5a0d94:
    aletta.say "Конец разгульной жизни, [lssb_common.hero_name()]."

# ch/harems_full/office/events/office_harem_common.rpy:1719
translate russian aletta_audrey_propose_male_3c7629de:
    aletta.say "Ты станешь женатым человеком!"

# ch/harems_full/office/events/office_harem_common.rpy:1720
translate russian aletta_audrey_propose_male_3e2cce37:
    audrey.say "Да, [lssb_common.hero_name()], теперь твоя задница принадлежит нам!"

# ch/harems_full/office/events/office_harem_common.rpy:1721
translate russian aletta_audrey_propose_male_cee381b3:
    audrey.say "Господи..."

# ch/harems_full/office/events/office_harem_common.rpy:1722
translate russian aletta_audrey_propose_male_65f608cb:
    audrey.say "Вот так и становятся тряпкой, Сиори!"

# ch/harems_full/office/events/office_harem_common.rpy:1723
translate russian aletta_audrey_propose_male_15b9ffd0:
    "Слушая их разговор, я невольно улыбаюсь."

# ch/harems_full/office/events/office_harem_common.rpy:1724
translate russian aletta_audrey_propose_male_a8d31bfa:
    "Конечно, компания у нас довольно странная."

# ch/harems_full/office/events/office_harem_common.rpy:1725
translate russian aletta_audrey_propose_male_bc68ba24:
    "Но мне кажется, именно это и поможет нам ужиться."

# ch/harems_full/office/events/office_harem_common.rpy:1726
translate russian aletta_audrey_propose_male_786dfb38:
    "Ведь каждому предстоит жить ещё с двумя людьми."

# ch/harems_full/office/events/office_harem_common.rpy:1727
translate russian aletta_audrey_propose_male_ba9cf855:
    "Что может быть хуже, чем если бы все они были похожи на тебя?"

# ch/harems_full/office/events/office_harem_common.rpy:1729
translate russian aletta_audrey_propose_male_8b6a38ef:
    "Я встаю и неловко прячу в карман два кольца, которые теперь не нужны."

# ch/harems_full/office/events/office_harem_common.rpy:1730
translate russian aletta_audrey_propose_male_f4c72828:
    "Все смотрят на меня, и унижение кажется полным."

# ch/harems_full/office/events/office_harem_common.rpy:1731
translate russian aletta_audrey_propose_male_6280299a:
    "Хуже будет, только если с меня свалятся штаны или я вдруг вспыхну."

# ch/harems_full/office/events/office_harem_common.rpy:1732
translate russian aletta_audrey_propose_male_c62fd749:
    "Хотя нет, беру слова обратно: такое хоть отвлекло бы внимание!"

# ch/harems_full/office/events/office_harem_common.rpy:1734
translate russian aletta_audrey_propose_male_d98e6ad4:
    mike.say "Ладно..."

# ch/harems_full/office/events/office_harem_common.rpy:1735
translate russian aletta_audrey_propose_male_1873393c:
    mike.say "Думаю, совещание окончено!"

# ch/harems_full/office/events/office_harem_common.rpy:1736
translate russian aletta_audrey_propose_male_cfe19add:
    "Я разворачиваюсь и почти выбегаю из переговорной."

# ch/harems_full/office/events/office_harem_common.rpy:1737
translate russian aletta_audrey_propose_male_d51d0fc9:
    "Я сбегаю, прежде чем успеваю услышать за спиной их голоса."

# ch/harems_full/office/events/office_harem_common.rpy:1738
translate russian aletta_audrey_propose_male_bf431521:
    "Прежде чем придётся отвечать на вопросы, каждый из которых был бы пыткой."

# ch/harems_full/office/events/office_harem_common.rpy:1739
translate russian aletta_audrey_propose_male_dba951ec:
    "Может, сейчас самое время использовать накопившиеся отпускные дни?"

# ch/harems_full/office/events/office_harem_common.rpy:1740
translate russian aletta_audrey_propose_male_20f24199:
    "Или взять длительный отпуск и уйти в монастырь?"

# ch/harems_full/office/events/office_harem_common.rpy:1741
translate russian aletta_audrey_propose_male_18338f00:
    "Что угодно, лишь бы подальше отсюда и от двух женщин, которые одновременно мне отказали!"

# ch/harems_full/office/events/office_harem_common.rpy:1743
translate russian aletta_audrey_propose_male_00507281:
    "Я встаю и надеваю кольца на все протянутые руки."

# ch/harems_full/office/events/office_harem_common.rpy:1744
translate russian aletta_audrey_propose_male_145278ba:
    "Чувствую на себе взгляды тех, кто отказал, но стараюсь не обращать внимания."

# ch/harems_full/office/events/office_harem_common.rpy:1745
translate russian aletta_audrey_propose_male_87970527:
    "Ох... будет тяжело."

# ch/harems_full/office/events/office_harem_common.rpy:1746
translate russian aletta_audrey_propose_male_b9ff0ddc:
    "Я буду скучать по тем, кто сказал нет."

# ch/harems_full/office/events/office_harem_common.rpy:1747
translate russian aletta_audrey_propose_male_76c588ba:
    "Но те из нас, кто решил быть вместе, должны и дальше идти вместе."

# ch/harems_full/office/events/office_harem_common.rpy:1748
translate russian aletta_audrey_propose_male_30f16e1e:
    "Мы тесно обнимаемся, пока остальные неловко выходят из комнаты."

# ch/harems_full/office/events/office_harem_common.rpy:1749
translate russian aletta_audrey_propose_male_adb1481c:
    "Мы вступаем на неизведанную территорию."

# ch/harems_full/office/events/office_harem_common.rpy:1750
translate russian aletta_audrey_propose_male_d873522f:
    "Но любовь, которую я чувствую от своих будущих жён, убеждает меня: у нас всё получится."

# ch/harems_full/office/events/office_harem_common.rpy:1784
translate russian aletta_audrey_lavish_shiori_male_ending_163e3150:
    "Знаете, я уже даже не помню, какие планы строил, когда устроился на нынешнюю работу."

# ch/harems_full/office/events/office_harem_common.rpy:1785
translate russian aletta_audrey_lavish_shiori_male_ending_afe3281b:
    "Собирался ли подниматься по карьерной лестнице так высоко, как смогу."

# ch/harems_full/office/events/office_harem_common.rpy:1786
translate russian aletta_audrey_lavish_shiori_male_ending_94c63a64:
    "Или просто хотел оплачивать счета, пока не найдётся что-то получше."

# ch/harems_full/office/events/office_harem_common.rpy:1787
translate russian aletta_audrey_lavish_shiori_male_ending_24743f63:
    "Но точно не думал встретить там будущих спутниц жизни!"

# ch/harems_full/office/events/office_harem_common.rpy:1788
translate russian aletta_audrey_lavish_shiori_male_ending_687b5cb6:
    "Насколько помню, я просто собирался немного повеселиться в офисе."

# ch/harems_full/office/events/office_harem_common.rpy:1789
translate russian aletta_audrey_lavish_shiori_male_ending_09d11206:
    "Ну, бездельничать и снимать рабочий стресс приятным общением с коллегами."

# ch/harems_full/office/events/office_harem_common.rpy:1790
translate russian aletta_audrey_lavish_shiori_male_ending_6c102b68:
    "Но одно потянулось за другим, и вот я здесь."

# ch/harems_full/office/events/office_harem_common.rpy:1791
translate russian aletta_audrey_lavish_shiori_male_ending_822fefa7:
    "Стою у алтаря и жду, когда те самые коллеги присоединятся ко мне."

# ch/harems_full/office/events/office_harem_common.rpy:1792
translate russian aletta_audrey_lavish_shiori_male_ending_1e6bb361:
    "Никогда бы не предположил, что всё закончится свадьбой."

# ch/harems_full/office/events/office_harem_common.rpy:1793
translate russian aletta_audrey_lavish_shiori_male_ending_3f238e55:
    "Тем более сразу с несколькими девушками с работы!"

# ch/harems_full/office/events/office_harem_common.rpy:1794
translate russian aletta_audrey_lavish_shiori_male_ending_0e3e2a13:
    "Не то чтобы я жаловался, понимаете?"

# ch/harems_full/office/events/office_harem_common.rpy:1795
translate russian aletta_audrey_lavish_shiori_male_ending_1cf1fe8c:
    "Я очень рад оказаться здесь."

# ch/harems_full/office/events/office_harem_common.rpy:1796
translate russian aletta_audrey_lavish_shiori_male_ending_a16093fe:
    "Просто сейчас моя жизнь напоминает американские горки!"

# ch/harems_full/office/events/office_harem_common.rpy:1797
translate russian aletta_audrey_lavish_shiori_male_ending_72c660cb:
    "Чтобы отвлечься, я оглядываю часовню."

# ch/harems_full/office/events/office_harem_common.rpy:1798
translate russian aletta_audrey_lavish_shiori_male_ending_62bccaf4:
    "Она красиво украшена, и это уже само по себе чудо."

# ch/harems_full/office/events/office_harem_common.rpy:1799
translate russian aletta_audrey_lavish_shiori_male_ending_4dcbc715:
    "Поверьте, когда оформление выбирает больше одной девушки, споры бывают жаркими!"

# ch/harems_full/office/events/office_harem_common.rpy:1800
translate russian aletta_audrey_lavish_shiori_male_ending_2d7ce45a:
    "Скамьи переполнены гостями — тоже ожидаемо, когда невест несколько."

# ch/harems_full/office/events/office_harem_common.rpy:1801
translate russian aletta_audrey_lavish_shiori_male_ending_f7ea0744:
    "Оглядывая ряд за рядом, я узнаю некоторые обращённые ко мне лица."

# ch/harems_full/office/events/office_harem_common.rpy:1802
translate russian aletta_audrey_lavish_shiori_male_ending_86f39f93:
    "Но разве можно знать здесь всех?"

# ch/harems_full/office/events/office_harem_common.rpy:1803
translate russian aletta_audrey_lavish_shiori_male_ending_03c31662:
    "Каждый участник свадьбы привёл целую толпу своих гостей."

# ch/harems_full/office/events/office_harem_common.rpy:1804
translate russian aletta_audrey_lavish_shiori_male_ending_de9f50a4:
    "Разобраться, кто к кому относится, почти невозможно!"

# ch/harems_full/office/events/office_harem_common.rpy:1805
translate russian aletta_audrey_lavish_shiori_male_ending_ccf5169a:
    "Я уже думаю попросить у девушек фотографии родственников с пояснениями."

# ch/harems_full/office/events/office_harem_common.rpy:1806
translate russian aletta_audrey_lavish_shiori_male_ending_f4e85421:
    "И тут часовню наполняет музыка."

# ch/harems_full/office/events/office_harem_common.rpy:1807
translate russian aletta_audrey_lavish_shiori_male_ending_29c59cdd:
    "Разумеется, я тут же прихожу в себя и выпрямляюсь почти по стойке смирно."

# ch/harems_full/office/events/office_harem_common.rpy:1808
translate russian aletta_audrey_lavish_shiori_male_ending_4ba2f2ee:
    "Как я могу не узнать эту музыку и не понять, что она означает?"

# ch/harems_full/office/events/office_harem_common.rpy:1809
translate russian aletta_audrey_lavish_shiori_male_ending_7f5b0022:
    "Я ведь сам оказался в центре споров о том, под что они пойдут к алтарю!"

# ch/harems_full/office/events/office_harem_common.rpy:1810
translate russian aletta_audrey_lavish_shiori_male_ending_be3eda7a:
    "Но воспоминания о последней ссоре и достигнутом компромиссе вдруг исчезают."

# ch/harems_full/office/events/office_harem_common.rpy:1811
translate russian aletta_audrey_lavish_shiori_male_ending_19827532:
    "Потому что я вижу только девушек, которые входят в часовню и идут по проходу."

# ch/harems_full/office/events/office_harem_common.rpy:1813
translate russian aletta_audrey_lavish_shiori_male_ending_5f9bfcb3:
    "Алетта идёт первой, словно возглавляет шествие."

# ch/harems_full/office/events/office_harem_common.rpy:1814
translate russian aletta_audrey_lavish_shiori_male_ending_13d712ad:
    "Голову держит высоко, как королева."

# ch/harems_full/office/events/office_harem_common.rpy:1815
translate russian aletta_audrey_lavish_shiori_male_ending_48929c23:
    "От одного её вида сердце бьётся быстрее."

# ch/harems_full/office/events/office_harem_common.rpy:1817
translate russian aletta_audrey_lavish_shiori_male_ending_61481264:
    "Я почти не замечаю, что она беременна."

# ch/harems_full/office/events/office_harem_common.rpy:1818
translate russian aletta_audrey_lavish_shiori_male_ending_55dfaa7f:
    "Платье так удачно скроено, что почти скрывает живот."

# ch/harems_full/office/events/office_harem_common.rpy:1819
translate russian aletta_audrey_lavish_shiori_male_ending_cb879e7a:
    "Почти, но не совсем. И, наверное, именно в этом вся прелесть."

# ch/harems_full/office/events/office_harem_common.rpy:1821
translate russian aletta_audrey_lavish_shiori_male_ending_9c17ea8b:
    "Одри каким-то образом идёт вместе с остальными и всё же держится особняком."

# ch/harems_full/office/events/office_harem_common.rpy:1822
translate russian aletta_audrey_lavish_shiori_male_ending_19ed8d0a:
    "На лице чуть язвительная, ироничная улыбка."

# ch/harems_full/office/events/office_harem_common.rpy:1823
translate russian aletta_audrey_lavish_shiori_male_ending_a1f07c5a:
    "Но в своём платье она всё равно элегантна и прекрасна."

# ch/harems_full/office/events/office_harem_common.rpy:1825
translate russian aletta_audrey_lavish_shiori_male_ending_3e02c880:
    "Одри держит букет прямо над округлившимся животом."

# ch/harems_full/office/events/office_harem_common.rpy:1826
translate russian aletta_audrey_lavish_shiori_male_ending_a76ee6d1:
    "Словно хочет показать его всему миру."

# ch/harems_full/office/events/office_harem_common.rpy:1827
translate russian aletta_audrey_lavish_shiori_male_ending_8fa30085:
    "Стоило догадаться, что она будет такой смелой и ничуть не смущённой!"

# ch/harems_full/office/events/office_harem_common.rpy:1829
translate russian aletta_audrey_lavish_shiori_male_ending_621b32f4:
    "Лавиш идёт ко мне с привычной спокойной уверенностью."

# ch/harems_full/office/events/office_harem_common.rpy:1830
translate russian aletta_audrey_lavish_shiori_male_ending_5c7a0c15:
    "Сдержанное платье лишь подчёркивает её красоту."

# ch/harems_full/office/events/office_harem_common.rpy:1831
translate russian aletta_audrey_lavish_shiori_male_ending_3c30d210:
    "Не понимаю, как ей удаётся сказать так много без единого слова."

# ch/harems_full/office/events/office_harem_common.rpy:1833
translate russian aletta_audrey_lavish_shiori_male_ending_443d5342:
    "Я почти забываю, что она беременна и это уже заметно."

# ch/harems_full/office/events/office_harem_common.rpy:1834
translate russian aletta_audrey_lavish_shiori_male_ending_1b0f172f:
    "Но тут вижу мягкий изгиб её живота."

# ch/harems_full/office/events/office_harem_common.rpy:1835
translate russian aletta_audrey_lavish_shiori_male_ending_463b28c3:
    "И вспоминаю, как сильно её люблю."

# ch/harems_full/office/events/office_harem_common.rpy:1837
translate russian aletta_audrey_lavish_shiori_male_ending_44563d73:
    "Сиори идёт последней, но именно на ней я дольше всего задерживаю взгляд."

# ch/harems_full/office/events/office_harem_common.rpy:1838
translate russian aletta_audrey_lavish_shiori_male_ending_0a48bf25:
    "Конечно, в своём платье она просто прекрасна."

# ch/harems_full/office/events/office_harem_common.rpy:1839
translate russian aletta_audrey_lavish_shiori_male_ending_7efc02d1:
    "Но важнее всего для меня то, что она улыбается."

# ch/harems_full/office/events/office_harem_common.rpy:1840
translate russian aletta_audrey_lavish_shiori_male_ending_ade0bdc1:
    "И я чувствую прилив счастья, зная, что она тоже счастлива."

# ch/harems_full/office/events/office_harem_common.rpy:1842
translate russian aletta_audrey_lavish_shiori_male_ending_71a6d072:
    "Может, дело ещё и в виде её живота?"

# ch/harems_full/office/events/office_harem_common.rpy:1843
translate russian aletta_audrey_lavish_shiori_male_ending_2f4773ce:
    "Мы одновременно женимся и начинаем новую семью."

# ch/harems_full/office/events/office_harem_common.rpy:1844
translate russian aletta_audrey_lavish_shiori_male_ending_bd9dd1ec:
    "Для всех нас это и правда начало новой жизни!"

# ch/harems_full/office/events/office_harem_common.rpy:1845
translate russian aletta_audrey_lavish_shiori_male_ending_a0c4ba2c:
    "Когда девушки подходят к алтарю, я неловко отодвигаюсь."

# ch/harems_full/office/events/office_harem_common.rpy:1846
translate russian aletta_audrey_lavish_shiori_male_ending_3043fcb4:
    "Они одна за другой встают рядом, то и дело меняясь местами."

# ch/harems_full/office/events/office_harem_common.rpy:1847
translate russian aletta_audrey_lavish_shiori_male_ending_ac482e86:
    "Конечно, мы пытались разобраться со всем этим на недавней репетиции."

# ch/harems_full/office/events/office_harem_common.rpy:1848
translate russian aletta_audrey_lavish_shiori_male_ending_378f4c4f:
    "Но, думаю, все толкаются из-за волнения."

# ch/harems_full/office/events/office_harem_common.rpy:1849
translate russian aletta_audrey_lavish_shiori_male_ending_c5b3de92:
    "Когда места наконец хватает всем, мы обмениваемся улыбками и взглядами."

# ch/harems_full/office/events/office_harem_common.rpy:1850
translate russian aletta_audrey_lavish_shiori_male_ending_e0a1dc8d:
    "Вижу, что каждая девушка чувствует себя так же, как я."

# ch/harems_full/office/events/office_harem_common.rpy:1851
translate russian aletta_audrey_lavish_shiori_male_ending_e220e585:
    "Эта странная смесь восторга и почти страха, от которой трепещет всё внутри!"

# ch/harems_full/office/events/office_harem_common.rpy:1853
translate russian aletta_audrey_lavish_shiori_male_ending_2a3aa788:
    "Мы все разом смотрим на священника."

# ch/harems_full/office/events/office_harem_common.rpy:1854
translate russian aletta_audrey_lavish_shiori_male_ending_b515515b:
    "Он жестом показывает, что церемония начинается."

# ch/harems_full/office/events/office_harem_common.rpy:1855
translate russian aletta_audrey_lavish_shiori_male_ending_6475c777:
    "Я рад, что он так уверенно берёт всё в свои руки."

# ch/harems_full/office/events/office_harem_common.rpy:1856
translate russian aletta_audrey_lavish_shiori_male_ending_bb69a3eb:
    "Потому что мы сразу сосредотачиваемся и следуем указаниям."

# ch/harems_full/office/events/office_harem_common.rpy:1858
translate russian aletta_audrey_lavish_shiori_male_ending_d601e095:
    "Священник" "Мы собрались здесь сегодня..."

# ch/harems_full/office/events/office_harem_common.rpy:1859
translate russian aletta_audrey_lavish_shiori_male_ending_c0a13476:
    "Священник" "Чтобы соединить этих людей — и я действительно имею в виду ВСЕХ!"

# ch/harems_full/office/events/office_harem_common.rpy:1860
translate russian aletta_audrey_lavish_shiori_male_ending_d05a0e2d:
    "Среди гостей прокатывается смех в ответ на маленькую шутку."

# ch/harems_full/office/events/office_harem_common.rpy:1861
translate russian aletta_audrey_lavish_shiori_male_ending_36cf52b2:
    "Но священник продолжает, и все снова умолкают."

# ch/harems_full/office/events/office_harem_common.rpy:1862
translate russian aletta_audrey_lavish_shiori_male_ending_20520034:
    "Священник" "Священными узами брака..."

# ch/harems_full/office/events/office_harem_common.rpy:1863
translate russian aletta_audrey_lavish_shiori_male_ending_22fe795c:
    "Остальная церемония проходит примерно так, как вы и представляете."

# ch/harems_full/office/events/office_harem_common.rpy:1864
translate russian aletta_audrey_lavish_shiori_male_ending_f3f3e6b5:
    "А чего вы ожидали?"

# ch/harems_full/office/events/office_harem_common.rpy:1865
translate russian aletta_audrey_lavish_shiori_male_ending_bb5a9817:
    "Призыва демонов и жертвоприношения животных?"

# ch/harems_full/office/events/office_harem_common.rpy:1866
translate russian aletta_audrey_lavish_shiori_male_ending_9b5d2ac7:
    "От обычной свадьбы отличается лишь то, что всё повторяют больше двух раз."

# ch/harems_full/office/events/office_harem_common.rpy:1867
translate russian aletta_audrey_lavish_shiori_male_ending_b9a1186d:
    "Священник" "Согласны ли вы, Алетта, вступить с этими людьми..."

# ch/harems_full/office/events/office_harem_common.rpy:1868
translate russian aletta_audrey_lavish_shiori_male_ending_8c7361cd:
    "Священник" "В законный брак?"

# ch/harems_full/office/events/office_harem_common.rpy:1871
translate russian aletta_audrey_lavish_shiori_male_ending_5af96bc2:
    "Священник" "Согласны ли вы, Одри, вступить с этими людьми..."

# ch/harems_full/office/events/office_harem_common.rpy:1872
translate russian aletta_audrey_lavish_shiori_male_ending_8c7361cd_1:
    "Священник" "В законный брак?"

# ch/harems_full/office/events/office_harem_common.rpy:1874
translate russian aletta_audrey_lavish_shiori_male_ending_944edfac:
    audrey.say "Согласна."

# ch/harems_full/office/events/office_harem_common.rpy:1875
translate russian aletta_audrey_lavish_shiori_male_ending_95513d99:
    "Священник" "Согласны ли вы, Лавиш, вступить с этими людьми..."

# ch/harems_full/office/events/office_harem_common.rpy:1876
translate russian aletta_audrey_lavish_shiori_male_ending_8c7361cd_2:
    "Священник" "В законный брак?"

# ch/harems_full/office/events/office_harem_common.rpy:1878
translate russian aletta_audrey_lavish_shiori_male_ending_12994482:
    lavish.say "Согласна."

# ch/harems_full/office/events/office_harem_common.rpy:1879
translate russian aletta_audrey_lavish_shiori_male_ending_c5007986:
    "Священник" "Согласны ли вы, Сиори, вступить с этими людьми..."

# ch/harems_full/office/events/office_harem_common.rpy:1880
translate russian aletta_audrey_lavish_shiori_male_ending_8c7361cd_3:
    "Священник" "В законный брак?"

# ch/harems_full/office/events/office_harem_common.rpy:1882
translate russian aletta_audrey_lavish_shiori_male_ending_d1bfdb33:
    shiori.say "Согласна."

# ch/harems_full/office/events/office_harem_common.rpy:1883
translate russian aletta_audrey_lavish_shiori_male_ending_f732b602:
    "Священник" "И наконец..."

# ch/harems_full/office/events/office_harem_common.rpy:1884
translate russian aletta_audrey_lavish_shiori_male_ending_a9301f98:
    "Священник" "Согласны ли вы, [lssb_common.hero_name()], вступить с этими людьми..."

# ch/harems_full/office/events/office_harem_common.rpy:1885
translate russian aletta_audrey_lavish_shiori_male_ending_8c7361cd_4:
    "Священник" "В законный брак?"

# ch/harems_full/office/events/office_harem_common.rpy:1886
translate russian aletta_audrey_lavish_shiori_male_ending_cc481164:
    mike.say "Согласен."

# ch/harems_full/office/events/office_harem_common.rpy:1887
translate russian aletta_audrey_lavish_shiori_male_ending_c088e303:
    "Священник кивает и на миг переводит дух."

# ch/harems_full/office/events/office_harem_common.rpy:1888
translate russian aletta_audrey_lavish_shiori_male_ending_58c83231:
    "Священник" "Обращаюсь ко всем присутствующим..."

# ch/harems_full/office/events/office_harem_common.rpy:1889
translate russian aletta_audrey_lavish_shiori_male_ending_34d3fae8:
    "Священник" "Если кому-то известна законная причина, по которой эти люди не могут заключить брак..."

# ch/harems_full/office/events/office_harem_common.rpy:1890
translate russian aletta_audrey_lavish_shiori_male_ending_713d080b:
    "Священник" "Скажите сейчас или молчите вечно!"

# ch/harems_full/office/events/office_harem_common.rpy:1891
translate russian aletta_audrey_lavish_shiori_male_ending_59eeee8b:
    "Повисает привычная пауза: гости посмеиваются и оглядываются."

# ch/harems_full/office/events/office_harem_common.rpy:1892
translate russian aletta_audrey_lavish_shiori_male_ending_2bdc3a2c:
    "Может, они ждут, что сейчас в часовню ворвётся армия разгневанных бывших."

# ch/harems_full/office/events/office_harem_common.rpy:1893
translate russian aletta_audrey_lavish_shiori_male_ending_96cf9a58:
    "Но, к счастью, ничего столь невероятного не происходит."

# ch/harems_full/office/events/office_harem_common.rpy:1894
translate russian aletta_audrey_lavish_shiori_male_ending_e054f310:
    "Священник" "Что ж..."

# ch/harems_full/office/events/office_harem_common.rpy:1895
translate russian aletta_audrey_lavish_shiori_male_ending_7d5acc60:
    "Священник" "Объявляю вас супругами."

# ch/harems_full/office/events/office_harem_common.rpy:1896
translate russian aletta_audrey_lavish_shiori_male_ending_64235e41:
    "Священник" "Можете... эм..."

# ch/harems_full/office/events/office_harem_common.rpy:1897
translate russian aletta_audrey_lavish_shiori_male_ending_9751f813:
    "Священник" "Ну... сделать что-нибудь подобающее случаю!"

# ch/harems_full/office/events/office_harem_common.rpy:1898
translate russian aletta_audrey_lavish_shiori_male_ending_c2d44e57:
    "На этих словах священника мы все обнимаемся."

# ch/harems_full/office/events/office_harem_common.rpy:1899
translate russian aletta_audrey_lavish_shiori_male_ending_d4a89fae:
    "Переплетая руки и прижимаясь друг к другу."

# ch/harems_full/office/events/office_harem_common.rpy:1900
translate russian aletta_audrey_lavish_shiori_male_ending_7f03cb6b:
    "Наверное, наши отношения чем-то на это похожи."

# ch/harems_full/office/events/office_harem_common.rpy:1901
translate russian aletta_audrey_lavish_shiori_male_ending_4c722292:
    "Мы не всегда понимаем, как всё должно быть устроено."

# ch/harems_full/office/events/office_harem_common.rpy:1902
translate russian aletta_audrey_lavish_shiori_male_ending_c64d880a:
    "Но чувствуем, что нам хорошо вместе, и только это по-настоящему важно."

# ch/harems_full/office/events/office_harem_common.rpy:1905
translate russian aletta_audrey_lavish_shiori_male_ending_fb135262:
    aletta.say "Было бы лучше, если бы с самого начала всё было так."

# ch/harems_full/office/events/office_harem_common.rpy:1906
translate russian aletta_audrey_lavish_shiori_male_ending_3fee3f60:
    aletta.say "В самом деле, вы думаете, [lssb_common.hero_name()] всегда будет совершенно честен?"

# ch/harems_full/office/events/office_harem_common.rpy:1907
translate russian aletta_audrey_lavish_shiori_male_ending_0bee8452:
    aletta.say "Нам-то известно, что его словам не всегда можно верить."

# ch/harems_full/office/events/office_harem_common.rpy:1908
translate russian aletta_audrey_lavish_shiori_male_ending_18edf2c6:
    aletta.say "В конце концов, мы видели содержимое его трусов после того, как он его нам описывал!"

# ch/harems_full/office/events/office_harem_common.rpy:1909
translate russian aletta_audrey_lavish_shiori_male_ending_db6b1ec4:
    audrey.say "Я бы и сама со всем справилась. [lssb_common.hero_name()] мог бы вообще не участвовать."

# ch/harems_full/office/events/office_harem_common.rpy:1910
translate russian aletta_audrey_lavish_shiori_male_ending_3bf1fee5:
    audrey.say "Вообще-то и ваше участие необязательно."

# ch/harems_full/office/events/office_harem_common.rpy:1911
translate russian aletta_audrey_lavish_shiori_male_ending_f555ec5b:
    audrey.say "Никто из вас не расскажет так хорошо, как я."

# ch/harems_full/office/events/office_harem_common.rpy:1912
translate russian aletta_audrey_lavish_shiori_male_ending_452dc528:
    lavish.say "Я просто обязана была высказаться, пусть даже под конец истории."

# ch/harems_full/office/events/office_harem_common.rpy:1913
translate russian aletta_audrey_lavish_shiori_male_ending_7513fa12:
    lavish.say "И не думайте, что моя любовь куда-то делась: [lssb_common.hero_name()] и все вы мне по-прежнему дороги."

# ch/harems_full/office/events/office_harem_common.rpy:1914
translate russian aletta_audrey_lavish_shiori_male_ending_1b407c2a:
    lavish.say "Но я всё-таки самая надёжная и честная из всех участников!"

# ch/harems_full/office/events/office_harem_common.rpy:1915
translate russian aletta_audrey_lavish_shiori_male_ending_16de9855:
    shiori.say "Я... я не знаю, стоит ли нам это делать, когда [lssb_common.hero_name()] не здесь!"

# ch/harems_full/office/events/office_harem_common.rpy:1916
translate russian aletta_audrey_lavish_shiori_male_ending_93d00ac6:
    shiori.say "Ведь без него ничего этого вообще бы не было, правда?"

# ch/harems_full/office/events/office_harem_common.rpy:1917
translate russian aletta_audrey_lavish_shiori_male_ending_58f159c1:
    shiori.say "Ох... надеюсь, он не расстроится из-за того, что все о нём говорят!"

# ch/harems_full/office/events/office_harem_common.rpy:1918
translate russian aletta_audrey_lavish_shiori_male_ending_e32e38b6:
    aletta.say "Может, начнём с начала?"

# ch/harems_full/office/events/office_harem_common.rpy:1919
translate russian aletta_audrey_lavish_shiori_male_ending_d4ce6e65:
    aletta.say "[lssb_common.hero_name()] работал подо мной, когда мы познакомились в офисе. Простите за столь очевидную двусмысленность!"

# ch/harems_full/office/events/office_harem_common.rpy:1920
translate russian aletta_audrey_lavish_shiori_male_ending_da247318:
    aletta.say "Поначалу он меня не впечатлил, хотя говорят, что мне трудно угодить."

# ch/harems_full/office/events/office_harem_common.rpy:1921
translate russian aletta_audrey_lavish_shiori_male_ending_ec759ec2:
    audrey.say "Да, обычно я ненавижу мужчин, под которыми приходится... работать!"

# ch/harems_full/office/events/office_harem_common.rpy:1922
translate russian aletta_audrey_lavish_shiori_male_ending_63750b5e:
    audrey.say "И была почти уверена, что [lssb_common.hero_name()] окажется таким же."

# ch/harems_full/office/events/office_harem_common.rpy:1923
translate russian aletta_audrey_lavish_shiori_male_ending_a74f7b23:
    audrey.say "Но особо не переживала: таким парням я всегда устраиваю ад!"

# ch/harems_full/office/events/office_harem_common.rpy:1924
translate russian aletta_audrey_lavish_shiori_male_ending_c3b96b26:
    lavish.say "Когда [lssb_common.hero_name()] стал моим начальником, у меня были сомнения."

# ch/harems_full/office/events/office_harem_common.rpy:1925
translate russian aletta_audrey_lavish_shiori_male_ending_80fb32ff:
    lavish.say "Я привыкла к профессиональной обстановке и целеустремлённым коллегам."

# ch/harems_full/office/events/office_harem_common.rpy:1926
translate russian aletta_audrey_lavish_shiori_male_ending_b08e7a01:
    lavish.say "А он казался... ну, немного раздолбаем!"

# ch/harems_full/office/events/office_harem_common.rpy:1927
translate russian aletta_audrey_lavish_shiori_male_ending_f3d293b5:
    shiori.say "Я ТАК волновалась, когда [lssb_common.hero_name()] стал моим коллегой."

# ch/harems_full/office/events/office_harem_common.rpy:1928
translate russian aletta_audrey_lavish_shiori_male_ending_622a24ff:
    shiori.say "Деньги были очень нужны, счета копились."

# ch/harems_full/office/events/office_harem_common.rpy:1929
translate russian aletta_audrey_lavish_shiori_male_ending_972679c4:
    shiori.say "Я была уверена, что не понравлюсь ему, что он сочтёт меня бесполезной!"

# ch/harems_full/office/events/office_harem_common.rpy:1930
translate russian aletta_audrey_lavish_shiori_male_ending_278dc089:
    aletta.say "Но должна признать: он доказал, что я ошибалась."

# ch/harems_full/office/events/office_harem_common.rpy:1931
translate russian aletta_audrey_lavish_shiori_male_ending_1257bf5f:
    aletta.say "В том смысле, что как человек оказался приятнее, чем я ожидала."

# ch/harems_full/office/events/office_harem_common.rpy:1932
translate russian aletta_audrey_lavish_shiori_male_ending_7b99ac54:
    aletta.say "А вот в работе он, откровенно говоря, безнадёжен без моей поддержки!"

# ch/harems_full/office/events/office_harem_common.rpy:1933
translate russian aletta_audrey_lavish_shiori_male_ending_4049420f:
    audrey.say "[lssb_common.hero_name()] стал жертвой моих обычных изощрённых издевательств."

# ch/harems_full/office/events/office_harem_common.rpy:1934
translate russian aletta_audrey_lavish_shiori_male_ending_20525bae:
    audrey.say "И, чёрт возьми, мне это начало нравиться."

# ch/harems_full/office/events/office_harem_common.rpy:1935
translate russian aletta_audrey_lavish_shiori_male_ending_51ff6098:
    audrey.say "То есть больше обычного, больше, чем просто смотреть на его мучения!"

# ch/harems_full/office/events/office_harem_common.rpy:1936
translate russian aletta_audrey_lavish_shiori_male_ending_0a4e7805:
    lavish.say "Не могу сказать, что [lssb_common.hero_name()] опроверг мои первые впечатления."

# ch/harems_full/office/events/office_harem_common.rpy:1937
translate russian aletta_audrey_lavish_shiori_male_ending_e94e0cc3:
    lavish.say "Но вскоре выяснилось, что он гораздо лучше умеет дружить, чем делать карьеру!"

# ch/harems_full/office/events/office_harem_common.rpy:1938
translate russian aletta_audrey_lavish_shiori_male_ending_935e27cf:
    lavish.say "Наверное, тогда я и начала видеть в нём не только коллегу."

# ch/harems_full/office/events/office_harem_common.rpy:1939
translate russian aletta_audrey_lavish_shiori_male_ending_ff6555d0:
    shiori.say "Конечно, [lssb_common.hero_name()] иногда терял со мной терпение. В худшие дни я сама не своя!"

# ch/harems_full/office/events/office_harem_common.rpy:1940
translate russian aletta_audrey_lavish_shiori_male_ending_8f1c0660:
    shiori.say "Но обычно он был терпелив и добр, и я чувствовала, что меня ценят."

# ch/harems_full/office/events/office_harem_common.rpy:1941
translate russian aletta_audrey_lavish_shiori_male_ending_63daadda:
    shiori.say "И с каждым днём всё сильнее к нему привязывалась."

# ch/harems_full/office/events/office_harem_common.rpy:1942
translate russian aletta_audrey_lavish_shiori_male_ending_13bfef04:
    aletta.say "Не успела оглянуться, как мы уже общались вне работы!"

# ch/harems_full/office/events/office_harem_common.rpy:1943
translate russian aletta_audrey_lavish_shiori_male_ending_1162e5bd:
    aletta.say "Сама виновата: нужно было внимательнее следить за статусом наших отношений."

# ch/harems_full/office/events/office_harem_common.rpy:1944
translate russian aletta_audrey_lavish_shiori_male_ending_af140e8f:
    aletta.say "Но было уже поздно: [lssb_common.hero_name()] сумел втереться ко мне в сердце!"

# ch/harems_full/office/events/office_harem_common.rpy:1945
translate russian aletta_audrey_lavish_shiori_male_ending_ef76f68c:
    audrey.say "Вот так он меня и поймал: мне было слишком весело!"

# ch/harems_full/office/events/office_harem_common.rpy:1946
translate russian aletta_audrey_lavish_shiori_male_ending_33cfb592:
    audrey.say "Я и понять ничего не успела, как уже сама возвращалась за новой порцией."

# ch/harems_full/office/events/office_harem_common.rpy:1947
translate russian aletta_audrey_lavish_shiori_male_ending_7d9f90fe:
    audrey.say "И дня не могла прожить, не подразнив его, хотя бы ради реакции!"

# ch/harems_full/office/events/office_harem_common.rpy:1948
translate russian aletta_audrey_lavish_shiori_male_ending_8eda7546:
    lavish.say "Ах... наверное, с самого начала стоило держаться с ним профессиональнее."

# ch/harems_full/office/events/office_harem_common.rpy:1949
translate russian aletta_audrey_lavish_shiori_male_ending_b33ee2f9:
    lavish.say "Я не следила за границей между работой и удовольствием."

# ch/harems_full/office/events/office_harem_common.rpy:1950
translate russian aletta_audrey_lavish_shiori_male_ending_831ad9f1:
    lavish.say "И вскоре он стал больше чем коллегой и уж точно больше чем другом!"

# ch/harems_full/office/events/office_harem_common.rpy:1951
translate russian aletta_audrey_lavish_shiori_male_ending_3ee1254c:
    shiori.say "Я правда старалась сохранить деловые отношения, но так хотела ему угодить!"

# ch/harems_full/office/events/office_harem_common.rpy:1952
translate russian aletta_audrey_lavish_shiori_male_ending_c7fea004:
    shiori.say "[lssb_common.hero_name()] просил — и я делала всё, причём с удовольствием."

# ch/harems_full/office/events/office_harem_common.rpy:1953
translate russian aletta_audrey_lavish_shiori_male_ending_c0b34381:
    shiori.say "А когда стало ясно, что ему это тоже нравится... я уже была безнадёжно влюблена!"

# ch/harems_full/office/events/office_harem_common.rpy:1954
translate russian aletta_audrey_lavish_shiori_male_ending_ae7dde37:
    aletta.say "После этого мы словно начали вместе подниматься по карьерной лестнице."

# ch/harems_full/office/events/office_harem_common.rpy:1955
translate russian aletta_audrey_lavish_shiori_male_ending_c9d219a5:
    aletta.say "Чем серьёзнее становились наши отношения, тем успешнее [lssb_common.hero_name()] и я работали."

# ch/harems_full/office/events/office_harem_common.rpy:1956
translate russian aletta_audrey_lavish_shiori_male_ending_8f0d010a:
    aletta.say "Не успела оглянуться, как мы оказались на самой вершине!"

# ch/harems_full/office/events/office_harem_common.rpy:1957
translate russian aletta_audrey_lavish_shiori_male_ending_19e4825a:
    audrey.say "Ещё никто из тех, над кем я издевалась, не начинал получать повышения!"

# ch/harems_full/office/events/office_harem_common.rpy:1958
translate russian aletta_audrey_lavish_shiori_male_ending_2a530e68:
    audrey.say "Но чем ближе становились наши отношения, тем успешнее был [lssb_common.hero_name()]."

# ch/harems_full/office/events/office_harem_common.rpy:1959
translate russian aletta_audrey_lavish_shiori_male_ending_de1eb4f3:
    audrey.say "Вскоре он уже сидел на самой верхушке!"

# ch/harems_full/office/events/office_harem_common.rpy:1960
translate russian aletta_audrey_lavish_shiori_male_ending_2a835dff:
    lavish.say "[lssb_common.hero_name()] сделал меня счастливой в личной жизни. По-настоящему счастливой!"

# ch/harems_full/office/events/office_harem_common.rpy:1961
translate russian aletta_audrey_lavish_shiori_male_ending_07275f12:
    lavish.say "А я, кажется, положительно влияла на его профессиональную жизнь."

# ch/harems_full/office/events/office_harem_common.rpy:1962
translate russian aletta_audrey_lavish_shiori_male_ending_79a567f7:
    lavish.say "Наверное, научила его работать эффективнее, раз его начали повышать!"

# ch/harems_full/office/events/office_harem_common.rpy:1963
translate russian aletta_audrey_lavish_shiori_male_ending_15fe1caf:
    shiori.say "Я так радовалась, когда [lssb_common.hero_name()] начал получать повышения."

# ch/harems_full/office/events/office_harem_common.rpy:1964
translate russian aletta_audrey_lavish_shiori_male_ending_c78790c4:
    shiori.say "А когда радовался и он, то становился ещё добрее ко мне."

# ch/harems_full/office/events/office_harem_common.rpy:1965
translate russian aletta_audrey_lavish_shiori_male_ending_e623b8db:
    shiori.say "Мне хочется верить, что я помогла ему добиться такого успеха!"

# ch/harems_full/office/events/office_harem_common.rpy:1966
translate russian aletta_audrey_lavish_shiori_male_ending_72e6e505:
    aletta.say "Не скажу, что обрадовалась, узнав, что наши отношения не совсем исключительные."

# ch/harems_full/office/events/office_harem_common.rpy:1967
translate russian aletta_audrey_lavish_shiori_male_ending_e30fd0c6:
    aletta.say "Но затем начала смотреть на всё это как на бизнес, понимаете?"

# ch/harems_full/office/events/office_harem_common.rpy:1968
translate russian aletta_audrey_lavish_shiori_male_ending_89a3cbeb:
    aletta.say "Партнёрство — хорошо, но компания с большим числом сотрудников ещё лучше."

# ch/harems_full/office/events/office_harem_common.rpy:1969
translate russian aletta_audrey_lavish_shiori_male_ending_20b05590:
    aletta.say "И мне по-прежнему нравится считать себя старшим партнёром!"

# ch/harems_full/office/events/office_harem_common.rpy:1970
translate russian aletta_audrey_lavish_shiori_male_ending_101688db:
    audrey.say "Да, я немного обалдела, узнав, что [lssb_common.hero_name()] встречается и с другими девушками в офисе."

# ch/harems_full/office/events/office_harem_common.rpy:1971
translate russian aletta_audrey_lavish_shiori_male_ending_584b7d13:
    audrey.say "Обычно это я всех шокирую, понимаете?"

# ch/harems_full/office/events/office_harem_common.rpy:1972
translate russian aletta_audrey_lavish_shiori_male_ending_b723cbd8:
    audrey.say "Но больше участников — больше возможностей повеселиться!"

# ch/harems_full/office/events/office_harem_common.rpy:1973
translate russian aletta_audrey_lavish_shiori_male_ending_1c508feb:
    lavish.say "Мне не нравилось, что [lssb_common.hero_name()] и я встречаемся не только друг с другом."

# ch/harems_full/office/events/office_harem_common.rpy:1974
translate russian aletta_audrey_lavish_shiori_male_ending_88cd0374:
    lavish.say "Но потом я подумала и увидела преимущества."

# ch/harems_full/office/events/office_harem_common.rpy:1975
translate russian aletta_audrey_lavish_shiori_male_ending_33be693a:
    lavish.say "Во многом так эффективнее и гибче. И НАМНОГО увлекательнее!"

# ch/harems_full/office/events/office_harem_common.rpy:1976
translate russian aletta_audrey_lavish_shiori_male_ending_4ffc0cb2:
    shiori.say "Когда [lssb_common.hero_name()] сказал, что встречается с другими девушками одновременно со мной, я испугалась."

# ch/harems_full/office/events/office_harem_common.rpy:1977
translate russian aletta_audrey_lavish_shiori_male_ending_5dee63a8:
    shiori.say "Решила, что они уведут его и я снова останусь одна."

# ch/harems_full/office/events/office_harem_common.rpy:1978
translate russian aletta_audrey_lavish_shiori_male_ending_ad20697c:
    shiori.say "Но [lssb_common.hero_name()] убедил меня, что всё будет иначе: мы все состоим в одних отношениях."

# ch/harems_full/office/events/office_harem_common.rpy:1979
translate russian aletta_audrey_lavish_shiori_male_ending_f3b7f09a:
    aletta.say "К моему удивлению, всё сложилось довольно хорошо."

# ch/harems_full/office/events/office_harem_common.rpy:1980
translate russian aletta_audrey_lavish_shiori_male_ending_9fc26d54:
    aletta.say "Мы в основном ладили и стали единым целым."

# ch/harems_full/office/events/office_harem_common.rpy:1981
translate russian aletta_audrey_lavish_shiori_male_ending_df89c038:
    aletta.say "Настолько хорошо, что брак показался следующим логичным шагом."

# ch/harems_full/office/events/office_harem_common.rpy:1982
translate russian aletta_audrey_lavish_shiori_male_ending_0092b8b7:
    audrey.say "Поверьте, я никогда не думала, что выйду замуж даже за одного человека."

# ch/harems_full/office/events/office_harem_common.rpy:1983
translate russian aletta_audrey_lavish_shiori_male_ending_059e8d07:
    audrey.say "Так могла ли я представить брак сразу с несколькими?!"

# ch/harems_full/office/events/office_harem_common.rpy:1984
translate russian aletta_audrey_lavish_shiori_male_ending_c0246911:
    audrey.say "Ну... может, я именно поэтому и согласилась: идея-то безумная!"

# ch/harems_full/office/events/office_harem_common.rpy:1985
translate russian aletta_audrey_lavish_shiori_male_ending_f9b87953:
    lavish.say "Знаю, как безумно звучит желание пожениться со всеми, с кем я спала."

# ch/harems_full/office/events/office_harem_common.rpy:1986
translate russian aletta_audrey_lavish_shiori_male_ending_d56a140d:
    lavish.say "Но вы должны понять: всё складывалось очень хорошо."

# ch/harems_full/office/events/office_harem_common.rpy:1987
translate russian aletta_audrey_lavish_shiori_male_ending_be296e69:
    lavish.say "Иногда и одного подходящего партнёра найти — удача, не говоря уже о нескольких!"

# ch/harems_full/office/events/office_harem_common.rpy:1988
translate russian aletta_audrey_lavish_shiori_male_ending_27f98246:
    shiori.say "Мой страх, что [lssb_common.hero_name()] уйдёт к другим девушкам и бросит меня, быстро исчез."

# ch/harems_full/office/events/office_harem_common.rpy:1989
translate russian aletta_audrey_lavish_shiori_male_ending_f1773a4c:
    shiori.say "Вскоре они стали мне как сёстры... даже больше, если понимаете, о чём я!"

# ch/harems_full/office/events/office_harem_common.rpy:1990
translate russian aletta_audrey_lavish_shiori_male_ending_bfe47a19:
    shiori.say "Поэтому мысль, что [lssb_common.hero_name()], девушки и я сможем пожениться, казалась чудесной!"

# ch/harems_full/office/events/office_harem_common.rpy:1991
translate russian aletta_audrey_lavish_shiori_male_ending_214c32e2:
    aletta.say "И теперь, когда мы воплотили это в жизнь, всё по-прежнему получается."

# ch/harems_full/office/events/office_harem_common.rpy:1992
translate russian aletta_audrey_lavish_shiori_male_ending_43600446:
    aletta.say "Мы команда и дома, и в офисе. На каждом шагу действуем сообща."

# ch/harems_full/office/events/office_harem_common.rpy:1993
translate russian aletta_audrey_lavish_shiori_male_ending_0f5cba8b:
    aletta.say "Рядом все, кто помогает мне оставаться сильной и собранной. Чего ещё желать?"

# ch/harems_full/office/events/office_harem_common.rpy:1994
translate russian aletta_audrey_lavish_shiori_male_ending_c660529e:
    audrey.say "Все говорят, что после свадьбы я стала спокойнее и остепенилась."

# ch/harems_full/office/events/office_harem_common.rpy:1995
translate russian aletta_audrey_lavish_shiori_male_ending_697d0dbb:
    audrey.say "И знаете, что меня в этом больше всего бесит? То, что они вроде бы правы."

# ch/harems_full/office/events/office_harem_common.rpy:1996
translate russian aletta_audrey_lavish_shiori_male_ending_96b577b4:
    audrey.say "Рядом столько людей, о которых я могу заботиться и которые заботятся обо мне, — я уже не такая злая, как раньше!"

# ch/harems_full/office/events/office_harem_common.rpy:1997
translate russian aletta_audrey_lavish_shiori_male_ending_b011dd69:
    lavish.say "Я всегда была готова пожертвовать замужеством ради карьеры."

# ch/harems_full/office/events/office_harem_common.rpy:1998
translate russian aletta_audrey_lavish_shiori_male_ending_15811ba1:
    lavish.say "Но теперь, когда я замужем, понимаю, что выбирать необязательно."

# ch/harems_full/office/events/office_harem_common.rpy:1999
translate russian aletta_audrey_lavish_shiori_male_ending_15455b40:
    lavish.say "Ведь рядом все, кого я люблю, и они готовы меня поддержать!"

# ch/harems_full/office/events/office_harem_common.rpy:2000
translate russian aletta_audrey_lavish_shiori_male_ending_113f4b18:
    shiori.say "Я уже была замужем, и ничем хорошим это не кончилось!"

# ch/harems_full/office/events/office_harem_common.rpy:2001
translate russian aletta_audrey_lavish_shiori_male_ending_8ee731b2:
    shiori.say "Но теперь всё совсем иначе: мы скорее семья, чем просто пара."

# ch/harems_full/office/events/office_harem_common.rpy:2002
translate russian aletta_audrey_lavish_shiori_male_ending_3d3f2e10:
    shiori.say "Может, если бы мой первый брак был таким, всё сложилось бы по-другому?"

# ch/harems_full/office/events/office_harem_common.rpy:2003
translate russian aletta_audrey_lavish_shiori_male_ending_ab56a6ab:
    shiori.say "Хотя я ни за что не променяла бы то, что у меня есть сейчас, на такую возможность!"

# ch/harems_full/office/events/office_harem_common.rpy:2004
translate russian aletta_audrey_lavish_shiori_male_ending_e182316e:
    aletta.say "Так что будущее у нас светлое, и мне не терпится узнать, что оно готовит!"

# ch/harems_full/office/events/office_harem_common.rpy:2005
translate russian aletta_audrey_lavish_shiori_male_ending_3e7ffed2:
    audrey.say "Впереди нас ждёт много интересного!"

# ch/harems_full/office/events/office_harem_common.rpy:2006
translate russian aletta_audrey_lavish_shiori_male_ending_3a6c24a1:
    lavish.say "Кто знает, как высоко мы сможем подняться и как далеко зайти вместе!"

# ch/harems_full/office/events/office_harem_common.rpy:2007
translate russian aletta_audrey_lavish_shiori_male_ending_c1dcf20d:
    shiori.say "Теперь у меня наконец есть семья, о которой я всегда мечтала!"

# ch/harems_full/office/events/office_harem_common.rpy:2014
translate russian audrey_lavish_shiori_male_ending_163e3150:
    "Знаете, я уже даже не помню, какие планы строил, когда устроился на нынешнюю работу."

# ch/harems_full/office/events/office_harem_common.rpy:2015
translate russian audrey_lavish_shiori_male_ending_afe3281b:
    "Собирался ли подниматься по карьерной лестнице так высоко, как смогу."

# ch/harems_full/office/events/office_harem_common.rpy:2016
translate russian audrey_lavish_shiori_male_ending_94c63a64:
    "Или просто хотел оплачивать счета, пока не найдётся что-то получше."

# ch/harems_full/office/events/office_harem_common.rpy:2017
translate russian audrey_lavish_shiori_male_ending_24743f63:
    "Но точно не думал встретить там будущих спутниц жизни!"

# ch/harems_full/office/events/office_harem_common.rpy:2018
translate russian audrey_lavish_shiori_male_ending_687b5cb6:
    "Насколько помню, я просто собирался немного повеселиться в офисе."

# ch/harems_full/office/events/office_harem_common.rpy:2019
translate russian audrey_lavish_shiori_male_ending_09d11206:
    "Ну, бездельничать и снимать рабочий стресс приятным общением с коллегами."

# ch/harems_full/office/events/office_harem_common.rpy:2020
translate russian audrey_lavish_shiori_male_ending_6c102b68:
    "Но одно потянулось за другим, и вот я здесь."

# ch/harems_full/office/events/office_harem_common.rpy:2021
translate russian audrey_lavish_shiori_male_ending_822fefa7:
    "Стою у алтаря и жду, когда те самые коллеги присоединятся ко мне."

# ch/harems_full/office/events/office_harem_common.rpy:2022
translate russian audrey_lavish_shiori_male_ending_1e6bb361:
    "Никогда бы не предположил, что всё закончится свадьбой."

# ch/harems_full/office/events/office_harem_common.rpy:2023
translate russian audrey_lavish_shiori_male_ending_3f238e55:
    "Тем более сразу с несколькими девушками с работы!"

# ch/harems_full/office/events/office_harem_common.rpy:2024
translate russian audrey_lavish_shiori_male_ending_0e3e2a13:
    "Не то чтобы я жаловался, понимаете?"

# ch/harems_full/office/events/office_harem_common.rpy:2025
translate russian audrey_lavish_shiori_male_ending_1cf1fe8c:
    "Я очень рад оказаться здесь."

# ch/harems_full/office/events/office_harem_common.rpy:2026
translate russian audrey_lavish_shiori_male_ending_a16093fe:
    "Просто сейчас моя жизнь напоминает американские горки!"

# ch/harems_full/office/events/office_harem_common.rpy:2027
translate russian audrey_lavish_shiori_male_ending_72c660cb:
    "Чтобы отвлечься, я оглядываю часовню."

# ch/harems_full/office/events/office_harem_common.rpy:2028
translate russian audrey_lavish_shiori_male_ending_62bccaf4:
    "Она красиво украшена, и это уже само по себе чудо."

# ch/harems_full/office/events/office_harem_common.rpy:2029
translate russian audrey_lavish_shiori_male_ending_4dcbc715:
    "Поверьте, когда оформление выбирает больше одной девушки, споры бывают жаркими!"

# ch/harems_full/office/events/office_harem_common.rpy:2030
translate russian audrey_lavish_shiori_male_ending_2d7ce45a:
    "Скамьи переполнены гостями — тоже ожидаемо, когда невест несколько."

# ch/harems_full/office/events/office_harem_common.rpy:2031
translate russian audrey_lavish_shiori_male_ending_f7ea0744:
    "Оглядывая ряд за рядом, я узнаю некоторые обращённые ко мне лица."

# ch/harems_full/office/events/office_harem_common.rpy:2032
translate russian audrey_lavish_shiori_male_ending_86f39f93:
    "Но разве можно знать здесь всех?"

# ch/harems_full/office/events/office_harem_common.rpy:2033
translate russian audrey_lavish_shiori_male_ending_03c31662:
    "Каждый участник свадьбы привёл целую толпу своих гостей."

# ch/harems_full/office/events/office_harem_common.rpy:2034
translate russian audrey_lavish_shiori_male_ending_de9f50a4:
    "Разобраться, кто к кому относится, почти невозможно!"

# ch/harems_full/office/events/office_harem_common.rpy:2035
translate russian audrey_lavish_shiori_male_ending_ccf5169a:
    "Я уже думаю попросить у девушек фотографии родственников с пояснениями."

# ch/harems_full/office/events/office_harem_common.rpy:2036
translate russian audrey_lavish_shiori_male_ending_f4e85421:
    "И тут часовню наполняет музыка."

# ch/harems_full/office/events/office_harem_common.rpy:2037
translate russian audrey_lavish_shiori_male_ending_29c59cdd:
    "Разумеется, я тут же прихожу в себя и выпрямляюсь почти по стойке смирно."

# ch/harems_full/office/events/office_harem_common.rpy:2038
translate russian audrey_lavish_shiori_male_ending_4ba2f2ee:
    "Как я могу не узнать эту музыку и не понять, что она означает?"

# ch/harems_full/office/events/office_harem_common.rpy:2039
translate russian audrey_lavish_shiori_male_ending_7f5b0022:
    "Я ведь сам оказался в центре споров о том, под что они пойдут к алтарю!"

# ch/harems_full/office/events/office_harem_common.rpy:2040
translate russian audrey_lavish_shiori_male_ending_be3eda7a:
    "Но воспоминания о последней ссоре и достигнутом компромиссе вдруг исчезают."

# ch/harems_full/office/events/office_harem_common.rpy:2041
translate russian audrey_lavish_shiori_male_ending_19827532:
    "Потому что я вижу только девушек, которые входят в часовню и идут по проходу."

# ch/harems_full/office/events/office_harem_common.rpy:2043
translate russian audrey_lavish_shiori_male_ending_9c17ea8b:
    "Одри каким-то образом идёт вместе с остальными и всё же держится особняком."

# ch/harems_full/office/events/office_harem_common.rpy:2044
translate russian audrey_lavish_shiori_male_ending_19ed8d0a:
    "На лице чуть язвительная, ироничная улыбка."

# ch/harems_full/office/events/office_harem_common.rpy:2045
translate russian audrey_lavish_shiori_male_ending_a1f07c5a:
    "Но в своём платье она всё равно элегантна и прекрасна."

# ch/harems_full/office/events/office_harem_common.rpy:2047
translate russian audrey_lavish_shiori_male_ending_3e02c880:
    "Одри держит букет прямо над округлившимся животом."

# ch/harems_full/office/events/office_harem_common.rpy:2048
translate russian audrey_lavish_shiori_male_ending_a76ee6d1:
    "Словно хочет показать его всему миру."

# ch/harems_full/office/events/office_harem_common.rpy:2049
translate russian audrey_lavish_shiori_male_ending_8fa30085:
    "Стоило догадаться, что она будет такой смелой и ничуть не смущённой!"

# ch/harems_full/office/events/office_harem_common.rpy:2051
translate russian audrey_lavish_shiori_male_ending_621b32f4:
    "Лавиш идёт ко мне с привычной спокойной уверенностью."

# ch/harems_full/office/events/office_harem_common.rpy:2052
translate russian audrey_lavish_shiori_male_ending_5c7a0c15:
    "Сдержанное платье лишь подчёркивает её красоту."

# ch/harems_full/office/events/office_harem_common.rpy:2053
translate russian audrey_lavish_shiori_male_ending_3c30d210:
    "Не понимаю, как ей удаётся сказать так много без единого слова."

# ch/harems_full/office/events/office_harem_common.rpy:2055
translate russian audrey_lavish_shiori_male_ending_443d5342:
    "Я почти забываю, что она беременна и это уже заметно."

# ch/harems_full/office/events/office_harem_common.rpy:2056
translate russian audrey_lavish_shiori_male_ending_1b0f172f:
    "Но тут вижу мягкий изгиб её живота."

# ch/harems_full/office/events/office_harem_common.rpy:2057
translate russian audrey_lavish_shiori_male_ending_463b28c3:
    "И вспоминаю, как сильно её люблю."

# ch/harems_full/office/events/office_harem_common.rpy:2059
translate russian audrey_lavish_shiori_male_ending_44563d73:
    "Сиори идёт последней, но именно на ней я дольше всего задерживаю взгляд."

# ch/harems_full/office/events/office_harem_common.rpy:2060
translate russian audrey_lavish_shiori_male_ending_0a48bf25:
    "Конечно, в своём платье она просто прекрасна."

# ch/harems_full/office/events/office_harem_common.rpy:2061
translate russian audrey_lavish_shiori_male_ending_7efc02d1:
    "Но важнее всего для меня то, что она улыбается."

# ch/harems_full/office/events/office_harem_common.rpy:2062
translate russian audrey_lavish_shiori_male_ending_ade0bdc1:
    "И я чувствую прилив счастья, зная, что она тоже счастлива."

# ch/harems_full/office/events/office_harem_common.rpy:2064
translate russian audrey_lavish_shiori_male_ending_71a6d072:
    "Может, дело ещё и в виде её живота?"

# ch/harems_full/office/events/office_harem_common.rpy:2065
translate russian audrey_lavish_shiori_male_ending_2f4773ce:
    "Мы одновременно женимся и начинаем новую семью."

# ch/harems_full/office/events/office_harem_common.rpy:2066
translate russian audrey_lavish_shiori_male_ending_bd9dd1ec:
    "Для всех нас это и правда начало новой жизни!"

# ch/harems_full/office/events/office_harem_common.rpy:2067
translate russian audrey_lavish_shiori_male_ending_a0c4ba2c:
    "Когда девушки подходят к алтарю, я неловко отодвигаюсь."

# ch/harems_full/office/events/office_harem_common.rpy:2068
translate russian audrey_lavish_shiori_male_ending_3043fcb4:
    "Они одна за другой встают рядом, то и дело меняясь местами."

# ch/harems_full/office/events/office_harem_common.rpy:2069
translate russian audrey_lavish_shiori_male_ending_ac482e86:
    "Конечно, мы пытались разобраться со всем этим на недавней репетиции."

# ch/harems_full/office/events/office_harem_common.rpy:2070
translate russian audrey_lavish_shiori_male_ending_378f4c4f:
    "Но, думаю, все толкаются из-за волнения."

# ch/harems_full/office/events/office_harem_common.rpy:2071
translate russian audrey_lavish_shiori_male_ending_c5b3de92:
    "Когда места наконец хватает всем, мы обмениваемся улыбками и взглядами."

# ch/harems_full/office/events/office_harem_common.rpy:2072
translate russian audrey_lavish_shiori_male_ending_e0a1dc8d:
    "Вижу, что каждая девушка чувствует себя так же, как я."

# ch/harems_full/office/events/office_harem_common.rpy:2073
translate russian audrey_lavish_shiori_male_ending_e220e585:
    "Эта странная смесь восторга и почти страха, от которой трепещет всё внутри!"

# ch/harems_full/office/events/office_harem_common.rpy:2075
translate russian audrey_lavish_shiori_male_ending_2a3aa788:
    "Мы все разом смотрим на священника."

# ch/harems_full/office/events/office_harem_common.rpy:2076
translate russian audrey_lavish_shiori_male_ending_b515515b:
    "Он жестом показывает, что церемония начинается."

# ch/harems_full/office/events/office_harem_common.rpy:2077
translate russian audrey_lavish_shiori_male_ending_6475c777:
    "Я рад, что он так уверенно берёт всё в свои руки."

# ch/harems_full/office/events/office_harem_common.rpy:2078
translate russian audrey_lavish_shiori_male_ending_bb69a3eb:
    "Потому что мы сразу сосредотачиваемся и следуем указаниям."

# ch/harems_full/office/events/office_harem_common.rpy:2080
translate russian audrey_lavish_shiori_male_ending_d601e095:
    "Священник" "Мы собрались здесь сегодня..."

# ch/harems_full/office/events/office_harem_common.rpy:2081
translate russian audrey_lavish_shiori_male_ending_c0a13476:
    "Священник" "Чтобы соединить этих людей — и я действительно имею в виду ВСЕХ!"

# ch/harems_full/office/events/office_harem_common.rpy:2082
translate russian audrey_lavish_shiori_male_ending_d05a0e2d:
    "Среди гостей прокатывается смех в ответ на маленькую шутку."

# ch/harems_full/office/events/office_harem_common.rpy:2083
translate russian audrey_lavish_shiori_male_ending_36cf52b2:
    "Но священник продолжает, и все снова умолкают."

# ch/harems_full/office/events/office_harem_common.rpy:2084
translate russian audrey_lavish_shiori_male_ending_20520034:
    "Священник" "Священными узами брака..."

# ch/harems_full/office/events/office_harem_common.rpy:2085
translate russian audrey_lavish_shiori_male_ending_22fe795c:
    "Остальная церемония проходит примерно так, как вы и представляете."

# ch/harems_full/office/events/office_harem_common.rpy:2086
translate russian audrey_lavish_shiori_male_ending_f3f3e6b5:
    "А чего вы ожидали?"

# ch/harems_full/office/events/office_harem_common.rpy:2087
translate russian audrey_lavish_shiori_male_ending_bb5a9817:
    "Призыва демонов и жертвоприношения животных?"

# ch/harems_full/office/events/office_harem_common.rpy:2088
translate russian audrey_lavish_shiori_male_ending_9b5d2ac7:
    "От обычной свадьбы отличается лишь то, что всё повторяют больше двух раз."

# ch/harems_full/office/events/office_harem_common.rpy:2089
translate russian audrey_lavish_shiori_male_ending_5af96bc2:
    "Священник" "Согласны ли вы, Одри, вступить с этими людьми..."

# ch/harems_full/office/events/office_harem_common.rpy:2090
translate russian audrey_lavish_shiori_male_ending_8c7361cd:
    "Священник" "В законный брак?"

# ch/harems_full/office/events/office_harem_common.rpy:2092
translate russian audrey_lavish_shiori_male_ending_944edfac:
    audrey.say "Согласна."

# ch/harems_full/office/events/office_harem_common.rpy:2093
translate russian audrey_lavish_shiori_male_ending_95513d99:
    "Священник" "Согласны ли вы, Лавиш, вступить с этими людьми..."

# ch/harems_full/office/events/office_harem_common.rpy:2094
translate russian audrey_lavish_shiori_male_ending_8c7361cd_1:
    "Священник" "В законный брак?"

# ch/harems_full/office/events/office_harem_common.rpy:2096
translate russian audrey_lavish_shiori_male_ending_12994482:
    lavish.say "Согласна."

# ch/harems_full/office/events/office_harem_common.rpy:2097
translate russian audrey_lavish_shiori_male_ending_c5007986:
    "Священник" "Согласны ли вы, Сиори, вступить с этими людьми..."

# ch/harems_full/office/events/office_harem_common.rpy:2098
translate russian audrey_lavish_shiori_male_ending_8c7361cd_2:
    "Священник" "В законный брак?"

# ch/harems_full/office/events/office_harem_common.rpy:2100
translate russian audrey_lavish_shiori_male_ending_d1bfdb33:
    shiori.say "Согласна."

# ch/harems_full/office/events/office_harem_common.rpy:2101
translate russian audrey_lavish_shiori_male_ending_f732b602:
    "Священник" "И наконец..."

# ch/harems_full/office/events/office_harem_common.rpy:2102
translate russian audrey_lavish_shiori_male_ending_a9301f98:
    "Священник" "Согласны ли вы, [lssb_common.hero_name()], вступить с этими людьми..."

# ch/harems_full/office/events/office_harem_common.rpy:2103
translate russian audrey_lavish_shiori_male_ending_8c7361cd_3:
    "Священник" "В законный брак?"

# ch/harems_full/office/events/office_harem_common.rpy:2104
translate russian audrey_lavish_shiori_male_ending_cc481164:
    mike.say "Согласен."

# ch/harems_full/office/events/office_harem_common.rpy:2105
translate russian audrey_lavish_shiori_male_ending_c088e303:
    "Священник кивает и на миг переводит дух."

# ch/harems_full/office/events/office_harem_common.rpy:2106
translate russian audrey_lavish_shiori_male_ending_58c83231:
    "Священник" "Обращаюсь ко всем присутствующим..."

# ch/harems_full/office/events/office_harem_common.rpy:2107
translate russian audrey_lavish_shiori_male_ending_34d3fae8:
    "Священник" "Если кому-то известна законная причина, по которой эти люди не могут заключить брак..."

# ch/harems_full/office/events/office_harem_common.rpy:2108
translate russian audrey_lavish_shiori_male_ending_713d080b:
    "Священник" "Скажите сейчас или молчите вечно!"

# ch/harems_full/office/events/office_harem_common.rpy:2109
translate russian audrey_lavish_shiori_male_ending_59eeee8b:
    "Повисает привычная пауза: гости посмеиваются и оглядываются."

# ch/harems_full/office/events/office_harem_common.rpy:2110
translate russian audrey_lavish_shiori_male_ending_2bdc3a2c:
    "Может, они ждут, что сейчас в часовню ворвётся армия разгневанных бывших."

# ch/harems_full/office/events/office_harem_common.rpy:2111
translate russian audrey_lavish_shiori_male_ending_96cf9a58:
    "Но, к счастью, ничего столь невероятного не происходит."

# ch/harems_full/office/events/office_harem_common.rpy:2112
translate russian audrey_lavish_shiori_male_ending_e054f310:
    "Священник" "Что ж..."

# ch/harems_full/office/events/office_harem_common.rpy:2113
translate russian audrey_lavish_shiori_male_ending_7d5acc60:
    "Священник" "Объявляю вас супругами."

# ch/harems_full/office/events/office_harem_common.rpy:2114
translate russian audrey_lavish_shiori_male_ending_64235e41:
    "Священник" "Можете... эм..."

# ch/harems_full/office/events/office_harem_common.rpy:2115
translate russian audrey_lavish_shiori_male_ending_9751f813:
    "Священник" "Ну... сделать что-нибудь подобающее случаю!"

# ch/harems_full/office/events/office_harem_common.rpy:2116
translate russian audrey_lavish_shiori_male_ending_c2d44e57:
    "На этих словах священника мы все обнимаемся."

# ch/harems_full/office/events/office_harem_common.rpy:2117
translate russian audrey_lavish_shiori_male_ending_d4a89fae:
    "Переплетая руки и прижимаясь друг к другу."

# ch/harems_full/office/events/office_harem_common.rpy:2118
translate russian audrey_lavish_shiori_male_ending_7f03cb6b:
    "Наверное, наши отношения чем-то на это похожи."

# ch/harems_full/office/events/office_harem_common.rpy:2119
translate russian audrey_lavish_shiori_male_ending_4c722292:
    "Мы не всегда понимаем, как всё должно быть устроено."

# ch/harems_full/office/events/office_harem_common.rpy:2120
translate russian audrey_lavish_shiori_male_ending_c64d880a:
    "Но чувствуем, что нам хорошо вместе, и только это по-настоящему важно."

# ch/harems_full/office/events/office_harem_common.rpy:2123
translate russian audrey_lavish_shiori_male_ending_db6b1ec4:
    audrey.say "Я бы и сама со всем справилась. [lssb_common.hero_name()] мог бы вообще не участвовать."

# ch/harems_full/office/events/office_harem_common.rpy:2124
translate russian audrey_lavish_shiori_male_ending_3bf1fee5:
    audrey.say "Вообще-то и ваше участие необязательно."

# ch/harems_full/office/events/office_harem_common.rpy:2125
translate russian audrey_lavish_shiori_male_ending_f555ec5b:
    audrey.say "Никто из вас не расскажет так хорошо, как я."

# ch/harems_full/office/events/office_harem_common.rpy:2126
translate russian audrey_lavish_shiori_male_ending_452dc528:
    lavish.say "Я просто обязана была высказаться, пусть даже под конец истории."

# ch/harems_full/office/events/office_harem_common.rpy:2127
translate russian audrey_lavish_shiori_male_ending_7513fa12:
    lavish.say "И не думайте, что моя любовь куда-то делась: [lssb_common.hero_name()] и все вы мне по-прежнему дороги."

# ch/harems_full/office/events/office_harem_common.rpy:2128
translate russian audrey_lavish_shiori_male_ending_1b407c2a:
    lavish.say "Но я всё-таки самая надёжная и честная из всех участников!"

# ch/harems_full/office/events/office_harem_common.rpy:2129
translate russian audrey_lavish_shiori_male_ending_16de9855:
    shiori.say "Я... я не знаю, стоит ли нам это делать, когда [lssb_common.hero_name()] не здесь!"

# ch/harems_full/office/events/office_harem_common.rpy:2130
translate russian audrey_lavish_shiori_male_ending_93d00ac6:
    shiori.say "Ведь без него ничего этого вообще бы не было, правда?"

# ch/harems_full/office/events/office_harem_common.rpy:2131
translate russian audrey_lavish_shiori_male_ending_58f159c1:
    shiori.say "Ох... надеюсь, он не расстроится из-за того, что все о нём говорят!"

# ch/harems_full/office/events/office_harem_common.rpy:2132
translate russian audrey_lavish_shiori_male_ending_ec759ec2:
    audrey.say "Да, обычно я ненавижу мужчин, под которыми приходится... работать!"

# ch/harems_full/office/events/office_harem_common.rpy:2133
translate russian audrey_lavish_shiori_male_ending_63750b5e:
    audrey.say "И была почти уверена, что [lssb_common.hero_name()] окажется таким же."

# ch/harems_full/office/events/office_harem_common.rpy:2134
translate russian audrey_lavish_shiori_male_ending_a74f7b23:
    audrey.say "Но особо не переживала: таким парням я всегда устраиваю ад!"

# ch/harems_full/office/events/office_harem_common.rpy:2135
translate russian audrey_lavish_shiori_male_ending_c3b96b26:
    lavish.say "Когда [lssb_common.hero_name()] стал моим начальником, у меня были сомнения."

# ch/harems_full/office/events/office_harem_common.rpy:2136
translate russian audrey_lavish_shiori_male_ending_80fb32ff:
    lavish.say "Я привыкла к профессиональной обстановке и целеустремлённым коллегам."

# ch/harems_full/office/events/office_harem_common.rpy:2137
translate russian audrey_lavish_shiori_male_ending_b08e7a01:
    lavish.say "А он казался... ну, немного раздолбаем!"

# ch/harems_full/office/events/office_harem_common.rpy:2138
translate russian audrey_lavish_shiori_male_ending_f3d293b5:
    shiori.say "Я ТАК волновалась, когда [lssb_common.hero_name()] стал моим коллегой."

# ch/harems_full/office/events/office_harem_common.rpy:2139
translate russian audrey_lavish_shiori_male_ending_622a24ff:
    shiori.say "Деньги были очень нужны, счета копились."

# ch/harems_full/office/events/office_harem_common.rpy:2140
translate russian audrey_lavish_shiori_male_ending_972679c4:
    shiori.say "Я была уверена, что не понравлюсь ему, что он сочтёт меня бесполезной!"

# ch/harems_full/office/events/office_harem_common.rpy:2141
translate russian audrey_lavish_shiori_male_ending_4049420f:
    audrey.say "[lssb_common.hero_name()] стал жертвой моих обычных изощрённых издевательств."

# ch/harems_full/office/events/office_harem_common.rpy:2142
translate russian audrey_lavish_shiori_male_ending_20525bae:
    audrey.say "И, чёрт возьми, мне это начало нравиться."

# ch/harems_full/office/events/office_harem_common.rpy:2143
translate russian audrey_lavish_shiori_male_ending_51ff6098:
    audrey.say "То есть больше обычного, больше, чем просто смотреть на его мучения!"

# ch/harems_full/office/events/office_harem_common.rpy:2144
translate russian audrey_lavish_shiori_male_ending_0a4e7805:
    lavish.say "Не могу сказать, что [lssb_common.hero_name()] опроверг мои первые впечатления."

# ch/harems_full/office/events/office_harem_common.rpy:2145
translate russian audrey_lavish_shiori_male_ending_e94e0cc3:
    lavish.say "Но вскоре выяснилось, что он гораздо лучше умеет дружить, чем делать карьеру!"

# ch/harems_full/office/events/office_harem_common.rpy:2146
translate russian audrey_lavish_shiori_male_ending_935e27cf:
    lavish.say "Наверное, тогда я и начала видеть в нём не только коллегу."

# ch/harems_full/office/events/office_harem_common.rpy:2147
translate russian audrey_lavish_shiori_male_ending_ff6555d0:
    shiori.say "Конечно, [lssb_common.hero_name()] иногда терял со мной терпение. В худшие дни я сама не своя!"

# ch/harems_full/office/events/office_harem_common.rpy:2148
translate russian audrey_lavish_shiori_male_ending_8f1c0660:
    shiori.say "Но обычно он был терпелив и добр, и я чувствовала, что меня ценят."

# ch/harems_full/office/events/office_harem_common.rpy:2149
translate russian audrey_lavish_shiori_male_ending_63daadda:
    shiori.say "И с каждым днём всё сильнее к нему привязывалась."

# ch/harems_full/office/events/office_harem_common.rpy:2150
translate russian audrey_lavish_shiori_male_ending_ef76f68c:
    audrey.say "Вот так он меня и поймал: мне было слишком весело!"

# ch/harems_full/office/events/office_harem_common.rpy:2151
translate russian audrey_lavish_shiori_male_ending_33cfb592:
    audrey.say "Я и понять ничего не успела, как уже сама возвращалась за новой порцией."

# ch/harems_full/office/events/office_harem_common.rpy:2152
translate russian audrey_lavish_shiori_male_ending_7d9f90fe:
    audrey.say "И дня не могла прожить, не подразнив его, хотя бы ради реакции!"

# ch/harems_full/office/events/office_harem_common.rpy:2153
translate russian audrey_lavish_shiori_male_ending_8eda7546:
    lavish.say "Ах... наверное, с самого начала стоило держаться с ним профессиональнее."

# ch/harems_full/office/events/office_harem_common.rpy:2154
translate russian audrey_lavish_shiori_male_ending_b33ee2f9:
    lavish.say "Я не следила за границей между работой и удовольствием."

# ch/harems_full/office/events/office_harem_common.rpy:2155
translate russian audrey_lavish_shiori_male_ending_831ad9f1:
    lavish.say "И вскоре он стал больше чем коллегой и уж точно больше чем другом!"

# ch/harems_full/office/events/office_harem_common.rpy:2156
translate russian audrey_lavish_shiori_male_ending_3ee1254c:
    shiori.say "Я правда старалась сохранить деловые отношения, но так хотела ему угодить!"

# ch/harems_full/office/events/office_harem_common.rpy:2157
translate russian audrey_lavish_shiori_male_ending_c7fea004:
    shiori.say "[lssb_common.hero_name()] просил — и я делала всё, причём с удовольствием."

# ch/harems_full/office/events/office_harem_common.rpy:2158
translate russian audrey_lavish_shiori_male_ending_c0b34381:
    shiori.say "А когда стало ясно, что ему это тоже нравится... я уже была безнадёжно влюблена!"

# ch/harems_full/office/events/office_harem_common.rpy:2159
translate russian audrey_lavish_shiori_male_ending_19e4825a:
    audrey.say "Ещё никто из тех, над кем я издевалась, не начинал получать повышения!"

# ch/harems_full/office/events/office_harem_common.rpy:2160
translate russian audrey_lavish_shiori_male_ending_2a530e68:
    audrey.say "Но чем ближе становились наши отношения, тем успешнее был [lssb_common.hero_name()]."

# ch/harems_full/office/events/office_harem_common.rpy:2161
translate russian audrey_lavish_shiori_male_ending_de1eb4f3:
    audrey.say "Вскоре он уже сидел на самой верхушке!"

# ch/harems_full/office/events/office_harem_common.rpy:2162
translate russian audrey_lavish_shiori_male_ending_2a835dff:
    lavish.say "[lssb_common.hero_name()] сделал меня счастливой в личной жизни. По-настоящему счастливой!"

# ch/harems_full/office/events/office_harem_common.rpy:2163
translate russian audrey_lavish_shiori_male_ending_07275f12:
    lavish.say "А я, кажется, положительно влияла на его профессиональную жизнь."

# ch/harems_full/office/events/office_harem_common.rpy:2164
translate russian audrey_lavish_shiori_male_ending_79a567f7:
    lavish.say "Наверное, научила его работать эффективнее, раз его начали повышать!"

# ch/harems_full/office/events/office_harem_common.rpy:2165
translate russian audrey_lavish_shiori_male_ending_15fe1caf:
    shiori.say "Я так радовалась, когда [lssb_common.hero_name()] начал получать повышения."

# ch/harems_full/office/events/office_harem_common.rpy:2166
translate russian audrey_lavish_shiori_male_ending_c78790c4:
    shiori.say "А когда радовался и он, то становился ещё добрее ко мне."

# ch/harems_full/office/events/office_harem_common.rpy:2167
translate russian audrey_lavish_shiori_male_ending_e623b8db:
    shiori.say "Мне хочется верить, что я помогла ему добиться такого успеха!"

# ch/harems_full/office/events/office_harem_common.rpy:2168
translate russian audrey_lavish_shiori_male_ending_101688db:
    audrey.say "Да, я немного обалдела, узнав, что [lssb_common.hero_name()] встречается и с другими девушками в офисе."

# ch/harems_full/office/events/office_harem_common.rpy:2169
translate russian audrey_lavish_shiori_male_ending_584b7d13:
    audrey.say "Обычно это я всех шокирую, понимаете?"

# ch/harems_full/office/events/office_harem_common.rpy:2170
translate russian audrey_lavish_shiori_male_ending_b723cbd8:
    audrey.say "Но больше участников — больше возможностей повеселиться!"

# ch/harems_full/office/events/office_harem_common.rpy:2171
translate russian audrey_lavish_shiori_male_ending_1c508feb:
    lavish.say "Мне не нравилось, что [lssb_common.hero_name()] и я встречаемся не только друг с другом."

# ch/harems_full/office/events/office_harem_common.rpy:2172
translate russian audrey_lavish_shiori_male_ending_88cd0374:
    lavish.say "Но потом я подумала и увидела преимущества."

# ch/harems_full/office/events/office_harem_common.rpy:2173
translate russian audrey_lavish_shiori_male_ending_33be693a:
    lavish.say "Во многом так эффективнее и гибче. И НАМНОГО увлекательнее!"

# ch/harems_full/office/events/office_harem_common.rpy:2174
translate russian audrey_lavish_shiori_male_ending_4ffc0cb2:
    shiori.say "Когда [lssb_common.hero_name()] сказал, что встречается с другими девушками одновременно со мной, я испугалась."

# ch/harems_full/office/events/office_harem_common.rpy:2175
translate russian audrey_lavish_shiori_male_ending_5dee63a8:
    shiori.say "Решила, что они уведут его и я снова останусь одна."

# ch/harems_full/office/events/office_harem_common.rpy:2176
translate russian audrey_lavish_shiori_male_ending_ad20697c:
    shiori.say "Но [lssb_common.hero_name()] убедил меня, что всё будет иначе: мы все состоим в одних отношениях."

# ch/harems_full/office/events/office_harem_common.rpy:2177
translate russian audrey_lavish_shiori_male_ending_0092b8b7:
    audrey.say "Поверьте, я никогда не думала, что выйду замуж даже за одного человека."

# ch/harems_full/office/events/office_harem_common.rpy:2178
translate russian audrey_lavish_shiori_male_ending_059e8d07:
    audrey.say "Так могла ли я представить брак сразу с несколькими?!"

# ch/harems_full/office/events/office_harem_common.rpy:2179
translate russian audrey_lavish_shiori_male_ending_c0246911:
    audrey.say "Ну... может, я именно поэтому и согласилась: идея-то безумная!"

# ch/harems_full/office/events/office_harem_common.rpy:2180
translate russian audrey_lavish_shiori_male_ending_f9b87953:
    lavish.say "Знаю, как безумно звучит желание пожениться со всеми, с кем я спала."

# ch/harems_full/office/events/office_harem_common.rpy:2181
translate russian audrey_lavish_shiori_male_ending_d56a140d:
    lavish.say "Но вы должны понять: всё складывалось очень хорошо."

# ch/harems_full/office/events/office_harem_common.rpy:2182
translate russian audrey_lavish_shiori_male_ending_be296e69:
    lavish.say "Иногда и одного подходящего партнёра найти — удача, не говоря уже о нескольких!"

# ch/harems_full/office/events/office_harem_common.rpy:2183
translate russian audrey_lavish_shiori_male_ending_27f98246:
    shiori.say "Мой страх, что [lssb_common.hero_name()] уйдёт к другим девушкам и бросит меня, быстро исчез."

# ch/harems_full/office/events/office_harem_common.rpy:2184
translate russian audrey_lavish_shiori_male_ending_f1773a4c:
    shiori.say "Вскоре они стали мне как сёстры... даже больше, если понимаете, о чём я!"

# ch/harems_full/office/events/office_harem_common.rpy:2185
translate russian audrey_lavish_shiori_male_ending_bfe47a19:
    shiori.say "Поэтому мысль, что [lssb_common.hero_name()], девушки и я сможем пожениться, казалась чудесной!"

# ch/harems_full/office/events/office_harem_common.rpy:2186
translate russian audrey_lavish_shiori_male_ending_c660529e:
    audrey.say "Все говорят, что после свадьбы я стала спокойнее и остепенилась."

# ch/harems_full/office/events/office_harem_common.rpy:2187
translate russian audrey_lavish_shiori_male_ending_697d0dbb:
    audrey.say "И знаете, что меня в этом больше всего бесит? То, что они вроде бы правы."

# ch/harems_full/office/events/office_harem_common.rpy:2188
translate russian audrey_lavish_shiori_male_ending_96b577b4:
    audrey.say "Рядом столько людей, о которых я могу заботиться и которые заботятся обо мне, — я уже не такая злая, как раньше!"

# ch/harems_full/office/events/office_harem_common.rpy:2189
translate russian audrey_lavish_shiori_male_ending_b011dd69:
    lavish.say "Я всегда была готова пожертвовать замужеством ради карьеры."

# ch/harems_full/office/events/office_harem_common.rpy:2190
translate russian audrey_lavish_shiori_male_ending_15811ba1:
    lavish.say "Но теперь, когда я замужем, понимаю, что выбирать необязательно."

# ch/harems_full/office/events/office_harem_common.rpy:2191
translate russian audrey_lavish_shiori_male_ending_15455b40:
    lavish.say "Ведь рядом все, кого я люблю, и они готовы меня поддержать!"

# ch/harems_full/office/events/office_harem_common.rpy:2192
translate russian audrey_lavish_shiori_male_ending_113f4b18:
    shiori.say "Я уже была замужем, и ничем хорошим это не кончилось!"

# ch/harems_full/office/events/office_harem_common.rpy:2193
translate russian audrey_lavish_shiori_male_ending_8ee731b2:
    shiori.say "Но теперь всё совсем иначе: мы скорее семья, чем просто пара."

# ch/harems_full/office/events/office_harem_common.rpy:2194
translate russian audrey_lavish_shiori_male_ending_3d3f2e10:
    shiori.say "Может, если бы мой первый брак был таким, всё сложилось бы по-другому?"

# ch/harems_full/office/events/office_harem_common.rpy:2195
translate russian audrey_lavish_shiori_male_ending_ab56a6ab:
    shiori.say "Хотя я ни за что не променяла бы то, что у меня есть сейчас, на такую возможность!"

# ch/harems_full/office/events/office_harem_common.rpy:2196
translate russian audrey_lavish_shiori_male_ending_3e7ffed2:
    audrey.say "Впереди нас ждёт много интересного!"

# ch/harems_full/office/events/office_harem_common.rpy:2197
translate russian audrey_lavish_shiori_male_ending_3a6c24a1:
    lavish.say "Кто знает, как высоко мы сможем подняться и как далеко зайти вместе!"

# ch/harems_full/office/events/office_harem_common.rpy:2198
translate russian audrey_lavish_shiori_male_ending_c1dcf20d:
    shiori.say "Теперь у меня наконец есть семья, о которой я всегда мечтала!"

# ch/harems_full/office/events/office_harem_common.rpy:2205
translate russian aletta_lavish_shiori_male_ending_163e3150:
    "Знаете, я уже даже не помню, какие планы строил, когда устроился на нынешнюю работу."

# ch/harems_full/office/events/office_harem_common.rpy:2206
translate russian aletta_lavish_shiori_male_ending_afe3281b:
    "Собирался ли подниматься по карьерной лестнице так высоко, как смогу."

# ch/harems_full/office/events/office_harem_common.rpy:2207
translate russian aletta_lavish_shiori_male_ending_94c63a64:
    "Или просто хотел оплачивать счета, пока не найдётся что-то получше."

# ch/harems_full/office/events/office_harem_common.rpy:2208
translate russian aletta_lavish_shiori_male_ending_24743f63:
    "Но точно не думал встретить там будущих спутниц жизни!"

# ch/harems_full/office/events/office_harem_common.rpy:2209
translate russian aletta_lavish_shiori_male_ending_687b5cb6:
    "Насколько помню, я просто собирался немного повеселиться в офисе."

# ch/harems_full/office/events/office_harem_common.rpy:2210
translate russian aletta_lavish_shiori_male_ending_09d11206:
    "Ну, бездельничать и снимать рабочий стресс приятным общением с коллегами."

# ch/harems_full/office/events/office_harem_common.rpy:2211
translate russian aletta_lavish_shiori_male_ending_6c102b68:
    "Но одно потянулось за другим, и вот я здесь."

# ch/harems_full/office/events/office_harem_common.rpy:2212
translate russian aletta_lavish_shiori_male_ending_822fefa7:
    "Стою у алтаря и жду, когда те самые коллеги присоединятся ко мне."

# ch/harems_full/office/events/office_harem_common.rpy:2213
translate russian aletta_lavish_shiori_male_ending_1e6bb361:
    "Никогда бы не предположил, что всё закончится свадьбой."

# ch/harems_full/office/events/office_harem_common.rpy:2214
translate russian aletta_lavish_shiori_male_ending_3f238e55:
    "Тем более сразу с несколькими девушками с работы!"

# ch/harems_full/office/events/office_harem_common.rpy:2215
translate russian aletta_lavish_shiori_male_ending_0e3e2a13:
    "Не то чтобы я жаловался, понимаете?"

# ch/harems_full/office/events/office_harem_common.rpy:2216
translate russian aletta_lavish_shiori_male_ending_1cf1fe8c:
    "Я очень рад оказаться здесь."

# ch/harems_full/office/events/office_harem_common.rpy:2217
translate russian aletta_lavish_shiori_male_ending_a16093fe:
    "Просто сейчас моя жизнь напоминает американские горки!"

# ch/harems_full/office/events/office_harem_common.rpy:2218
translate russian aletta_lavish_shiori_male_ending_72c660cb:
    "Чтобы отвлечься, я оглядываю часовню."

# ch/harems_full/office/events/office_harem_common.rpy:2219
translate russian aletta_lavish_shiori_male_ending_62bccaf4:
    "Она красиво украшена, и это уже само по себе чудо."

# ch/harems_full/office/events/office_harem_common.rpy:2220
translate russian aletta_lavish_shiori_male_ending_4dcbc715:
    "Поверьте, когда оформление выбирает больше одной девушки, споры бывают жаркими!"

# ch/harems_full/office/events/office_harem_common.rpy:2221
translate russian aletta_lavish_shiori_male_ending_2d7ce45a:
    "Скамьи переполнены гостями — тоже ожидаемо, когда невест несколько."

# ch/harems_full/office/events/office_harem_common.rpy:2222
translate russian aletta_lavish_shiori_male_ending_f7ea0744:
    "Оглядывая ряд за рядом, я узнаю некоторые обращённые ко мне лица."

# ch/harems_full/office/events/office_harem_common.rpy:2223
translate russian aletta_lavish_shiori_male_ending_86f39f93:
    "Но разве можно знать здесь всех?"

# ch/harems_full/office/events/office_harem_common.rpy:2224
translate russian aletta_lavish_shiori_male_ending_03c31662:
    "Каждый участник свадьбы привёл целую толпу своих гостей."

# ch/harems_full/office/events/office_harem_common.rpy:2225
translate russian aletta_lavish_shiori_male_ending_de9f50a4:
    "Разобраться, кто к кому относится, почти невозможно!"

# ch/harems_full/office/events/office_harem_common.rpy:2226
translate russian aletta_lavish_shiori_male_ending_ccf5169a:
    "Я уже думаю попросить у девушек фотографии родственников с пояснениями."

# ch/harems_full/office/events/office_harem_common.rpy:2227
translate russian aletta_lavish_shiori_male_ending_f4e85421:
    "И тут часовню наполняет музыка."

# ch/harems_full/office/events/office_harem_common.rpy:2228
translate russian aletta_lavish_shiori_male_ending_29c59cdd:
    "Разумеется, я тут же прихожу в себя и выпрямляюсь почти по стойке смирно."

# ch/harems_full/office/events/office_harem_common.rpy:2229
translate russian aletta_lavish_shiori_male_ending_4ba2f2ee:
    "Как я могу не узнать эту музыку и не понять, что она означает?"

# ch/harems_full/office/events/office_harem_common.rpy:2230
translate russian aletta_lavish_shiori_male_ending_7f5b0022:
    "Я ведь сам оказался в центре споров о том, под что они пойдут к алтарю!"

# ch/harems_full/office/events/office_harem_common.rpy:2231
translate russian aletta_lavish_shiori_male_ending_be3eda7a:
    "Но воспоминания о последней ссоре и достигнутом компромиссе вдруг исчезают."

# ch/harems_full/office/events/office_harem_common.rpy:2232
translate russian aletta_lavish_shiori_male_ending_19827532:
    "Потому что я вижу только девушек, которые входят в часовню и идут по проходу."

# ch/harems_full/office/events/office_harem_common.rpy:2234
translate russian aletta_lavish_shiori_male_ending_5f9bfcb3:
    "Алетта идёт первой, словно возглавляет шествие."

# ch/harems_full/office/events/office_harem_common.rpy:2235
translate russian aletta_lavish_shiori_male_ending_13d712ad:
    "Голову держит высоко, как королева."

# ch/harems_full/office/events/office_harem_common.rpy:2236
translate russian aletta_lavish_shiori_male_ending_48929c23:
    "От одного её вида сердце бьётся быстрее."

# ch/harems_full/office/events/office_harem_common.rpy:2238
translate russian aletta_lavish_shiori_male_ending_61481264:
    "Я почти не замечаю, что она беременна."

# ch/harems_full/office/events/office_harem_common.rpy:2239
translate russian aletta_lavish_shiori_male_ending_55dfaa7f:
    "Платье так удачно скроено, что почти скрывает живот."

# ch/harems_full/office/events/office_harem_common.rpy:2240
translate russian aletta_lavish_shiori_male_ending_cb879e7a:
    "Почти, но не совсем. И, наверное, именно в этом вся прелесть."

# ch/harems_full/office/events/office_harem_common.rpy:2242
translate russian aletta_lavish_shiori_male_ending_621b32f4:
    "Лавиш идёт ко мне с привычной спокойной уверенностью."

# ch/harems_full/office/events/office_harem_common.rpy:2243
translate russian aletta_lavish_shiori_male_ending_5c7a0c15:
    "Сдержанное платье лишь подчёркивает её красоту."

# ch/harems_full/office/events/office_harem_common.rpy:2244
translate russian aletta_lavish_shiori_male_ending_3c30d210:
    "Не понимаю, как ей удаётся сказать так много без единого слова."

# ch/harems_full/office/events/office_harem_common.rpy:2246
translate russian aletta_lavish_shiori_male_ending_443d5342:
    "Я почти забываю, что она беременна и это уже заметно."

# ch/harems_full/office/events/office_harem_common.rpy:2247
translate russian aletta_lavish_shiori_male_ending_1b0f172f:
    "Но тут вижу мягкий изгиб её живота."

# ch/harems_full/office/events/office_harem_common.rpy:2248
translate russian aletta_lavish_shiori_male_ending_463b28c3:
    "И вспоминаю, как сильно её люблю."

# ch/harems_full/office/events/office_harem_common.rpy:2250
translate russian aletta_lavish_shiori_male_ending_44563d73:
    "Сиори идёт последней, но именно на ней я дольше всего задерживаю взгляд."

# ch/harems_full/office/events/office_harem_common.rpy:2251
translate russian aletta_lavish_shiori_male_ending_0a48bf25:
    "Конечно, в своём платье она просто прекрасна."

# ch/harems_full/office/events/office_harem_common.rpy:2252
translate russian aletta_lavish_shiori_male_ending_7efc02d1:
    "Но важнее всего для меня то, что она улыбается."

# ch/harems_full/office/events/office_harem_common.rpy:2253
translate russian aletta_lavish_shiori_male_ending_ade0bdc1:
    "И я чувствую прилив счастья, зная, что она тоже счастлива."

# ch/harems_full/office/events/office_harem_common.rpy:2255
translate russian aletta_lavish_shiori_male_ending_71a6d072:
    "Может, дело ещё и в виде её живота?"

# ch/harems_full/office/events/office_harem_common.rpy:2256
translate russian aletta_lavish_shiori_male_ending_2f4773ce:
    "Мы одновременно женимся и начинаем новую семью."

# ch/harems_full/office/events/office_harem_common.rpy:2257
translate russian aletta_lavish_shiori_male_ending_bd9dd1ec:
    "Для всех нас это и правда начало новой жизни!"

# ch/harems_full/office/events/office_harem_common.rpy:2258
translate russian aletta_lavish_shiori_male_ending_a0c4ba2c:
    "Когда девушки подходят к алтарю, я неловко отодвигаюсь."

# ch/harems_full/office/events/office_harem_common.rpy:2259
translate russian aletta_lavish_shiori_male_ending_3043fcb4:
    "Они одна за другой встают рядом, то и дело меняясь местами."

# ch/harems_full/office/events/office_harem_common.rpy:2260
translate russian aletta_lavish_shiori_male_ending_ac482e86:
    "Конечно, мы пытались разобраться со всем этим на недавней репетиции."

# ch/harems_full/office/events/office_harem_common.rpy:2261
translate russian aletta_lavish_shiori_male_ending_378f4c4f:
    "Но, думаю, все толкаются из-за волнения."

# ch/harems_full/office/events/office_harem_common.rpy:2262
translate russian aletta_lavish_shiori_male_ending_c5b3de92:
    "Когда места наконец хватает всем, мы обмениваемся улыбками и взглядами."

# ch/harems_full/office/events/office_harem_common.rpy:2263
translate russian aletta_lavish_shiori_male_ending_e0a1dc8d:
    "Вижу, что каждая девушка чувствует себя так же, как я."

# ch/harems_full/office/events/office_harem_common.rpy:2264
translate russian aletta_lavish_shiori_male_ending_e220e585:
    "Эта странная смесь восторга и почти страха, от которой трепещет всё внутри!"

# ch/harems_full/office/events/office_harem_common.rpy:2266
translate russian aletta_lavish_shiori_male_ending_2a3aa788:
    "Мы все разом смотрим на священника."

# ch/harems_full/office/events/office_harem_common.rpy:2267
translate russian aletta_lavish_shiori_male_ending_b515515b:
    "Он жестом показывает, что церемония начинается."

# ch/harems_full/office/events/office_harem_common.rpy:2268
translate russian aletta_lavish_shiori_male_ending_6475c777:
    "Я рад, что он так уверенно берёт всё в свои руки."

# ch/harems_full/office/events/office_harem_common.rpy:2269
translate russian aletta_lavish_shiori_male_ending_bb69a3eb:
    "Потому что мы сразу сосредотачиваемся и следуем указаниям."

# ch/harems_full/office/events/office_harem_common.rpy:2271
translate russian aletta_lavish_shiori_male_ending_d601e095:
    "Священник" "Мы собрались здесь сегодня..."

# ch/harems_full/office/events/office_harem_common.rpy:2272
translate russian aletta_lavish_shiori_male_ending_c0a13476:
    "Священник" "Чтобы соединить этих людей — и я действительно имею в виду ВСЕХ!"

# ch/harems_full/office/events/office_harem_common.rpy:2273
translate russian aletta_lavish_shiori_male_ending_d05a0e2d:
    "Среди гостей прокатывается смех в ответ на маленькую шутку."

# ch/harems_full/office/events/office_harem_common.rpy:2274
translate russian aletta_lavish_shiori_male_ending_36cf52b2:
    "Но священник продолжает, и все снова умолкают."

# ch/harems_full/office/events/office_harem_common.rpy:2275
translate russian aletta_lavish_shiori_male_ending_20520034:
    "Священник" "Священными узами брака..."

# ch/harems_full/office/events/office_harem_common.rpy:2276
translate russian aletta_lavish_shiori_male_ending_22fe795c:
    "Остальная церемония проходит примерно так, как вы и представляете."

# ch/harems_full/office/events/office_harem_common.rpy:2277
translate russian aletta_lavish_shiori_male_ending_f3f3e6b5:
    "А чего вы ожидали?"

# ch/harems_full/office/events/office_harem_common.rpy:2278
translate russian aletta_lavish_shiori_male_ending_bb5a9817:
    "Призыва демонов и жертвоприношения животных?"

# ch/harems_full/office/events/office_harem_common.rpy:2279
translate russian aletta_lavish_shiori_male_ending_9b5d2ac7:
    "От обычной свадьбы отличается лишь то, что всё повторяют больше двух раз."

# ch/harems_full/office/events/office_harem_common.rpy:2280
translate russian aletta_lavish_shiori_male_ending_b9a1186d:
    "Священник" "Согласны ли вы, Алетта, вступить с этими людьми..."

# ch/harems_full/office/events/office_harem_common.rpy:2281
translate russian aletta_lavish_shiori_male_ending_8c7361cd:
    "Священник" "В законный брак?"

# ch/harems_full/office/events/office_harem_common.rpy:2284
translate russian aletta_lavish_shiori_male_ending_95513d99:
    "Священник" "Согласны ли вы, Лавиш, вступить с этими людьми..."

# ch/harems_full/office/events/office_harem_common.rpy:2285
translate russian aletta_lavish_shiori_male_ending_8c7361cd_1:
    "Священник" "В законный брак?"

# ch/harems_full/office/events/office_harem_common.rpy:2287
translate russian aletta_lavish_shiori_male_ending_12994482:
    lavish.say "Согласна."

# ch/harems_full/office/events/office_harem_common.rpy:2288
translate russian aletta_lavish_shiori_male_ending_c5007986:
    "Священник" "Согласны ли вы, Сиори, вступить с этими людьми..."

# ch/harems_full/office/events/office_harem_common.rpy:2289
translate russian aletta_lavish_shiori_male_ending_8c7361cd_2:
    "Священник" "В законный брак?"

# ch/harems_full/office/events/office_harem_common.rpy:2291
translate russian aletta_lavish_shiori_male_ending_d1bfdb33:
    shiori.say "Согласна."

# ch/harems_full/office/events/office_harem_common.rpy:2292
translate russian aletta_lavish_shiori_male_ending_f732b602:
    "Священник" "И наконец..."

# ch/harems_full/office/events/office_harem_common.rpy:2293
translate russian aletta_lavish_shiori_male_ending_a9301f98:
    "Священник" "Согласны ли вы, [lssb_common.hero_name()], вступить с этими людьми..."

# ch/harems_full/office/events/office_harem_common.rpy:2294
translate russian aletta_lavish_shiori_male_ending_8c7361cd_3:
    "Священник" "В законный брак?"

# ch/harems_full/office/events/office_harem_common.rpy:2295
translate russian aletta_lavish_shiori_male_ending_cc481164:
    mike.say "Согласен."

# ch/harems_full/office/events/office_harem_common.rpy:2296
translate russian aletta_lavish_shiori_male_ending_c088e303:
    "Священник кивает и на миг переводит дух."

# ch/harems_full/office/events/office_harem_common.rpy:2297
translate russian aletta_lavish_shiori_male_ending_58c83231:
    "Священник" "Обращаюсь ко всем присутствующим..."

# ch/harems_full/office/events/office_harem_common.rpy:2298
translate russian aletta_lavish_shiori_male_ending_34d3fae8:
    "Священник" "Если кому-то известна законная причина, по которой эти люди не могут заключить брак..."

# ch/harems_full/office/events/office_harem_common.rpy:2299
translate russian aletta_lavish_shiori_male_ending_713d080b:
    "Священник" "Скажите сейчас или молчите вечно!"

# ch/harems_full/office/events/office_harem_common.rpy:2300
translate russian aletta_lavish_shiori_male_ending_59eeee8b:
    "Повисает привычная пауза: гости посмеиваются и оглядываются."

# ch/harems_full/office/events/office_harem_common.rpy:2301
translate russian aletta_lavish_shiori_male_ending_2bdc3a2c:
    "Может, они ждут, что сейчас в часовню ворвётся армия разгневанных бывших."

# ch/harems_full/office/events/office_harem_common.rpy:2302
translate russian aletta_lavish_shiori_male_ending_96cf9a58:
    "Но, к счастью, ничего столь невероятного не происходит."

# ch/harems_full/office/events/office_harem_common.rpy:2303
translate russian aletta_lavish_shiori_male_ending_e054f310:
    "Священник" "Что ж..."

# ch/harems_full/office/events/office_harem_common.rpy:2304
translate russian aletta_lavish_shiori_male_ending_7d5acc60:
    "Священник" "Объявляю вас супругами."

# ch/harems_full/office/events/office_harem_common.rpy:2305
translate russian aletta_lavish_shiori_male_ending_64235e41:
    "Священник" "Можете... эм..."

# ch/harems_full/office/events/office_harem_common.rpy:2306
translate russian aletta_lavish_shiori_male_ending_9751f813:
    "Священник" "Ну... сделать что-нибудь подобающее случаю!"

# ch/harems_full/office/events/office_harem_common.rpy:2307
translate russian aletta_lavish_shiori_male_ending_c2d44e57:
    "На этих словах священника мы все обнимаемся."

# ch/harems_full/office/events/office_harem_common.rpy:2308
translate russian aletta_lavish_shiori_male_ending_d4a89fae:
    "Переплетая руки и прижимаясь друг к другу."

# ch/harems_full/office/events/office_harem_common.rpy:2309
translate russian aletta_lavish_shiori_male_ending_7f03cb6b:
    "Наверное, наши отношения чем-то на это похожи."

# ch/harems_full/office/events/office_harem_common.rpy:2310
translate russian aletta_lavish_shiori_male_ending_4c722292:
    "Мы не всегда понимаем, как всё должно быть устроено."

# ch/harems_full/office/events/office_harem_common.rpy:2311
translate russian aletta_lavish_shiori_male_ending_c64d880a:
    "Но чувствуем, что нам хорошо вместе, и только это по-настоящему важно."

# ch/harems_full/office/events/office_harem_common.rpy:2314
translate russian aletta_lavish_shiori_male_ending_fb135262:
    aletta.say "Было бы лучше, если бы с самого начала всё было так."

# ch/harems_full/office/events/office_harem_common.rpy:2315
translate russian aletta_lavish_shiori_male_ending_3fee3f60:
    aletta.say "В самом деле, вы думаете, [lssb_common.hero_name()] всегда будет совершенно честен?"

# ch/harems_full/office/events/office_harem_common.rpy:2316
translate russian aletta_lavish_shiori_male_ending_0bee8452:
    aletta.say "Нам-то известно, что его словам не всегда можно верить."

# ch/harems_full/office/events/office_harem_common.rpy:2317
translate russian aletta_lavish_shiori_male_ending_18edf2c6:
    aletta.say "В конце концов, мы видели содержимое его трусов после того, как он его нам описывал!"

# ch/harems_full/office/events/office_harem_common.rpy:2318
translate russian aletta_lavish_shiori_male_ending_452dc528:
    lavish.say "Я просто обязана была высказаться, пусть даже под конец истории."

# ch/harems_full/office/events/office_harem_common.rpy:2319
translate russian aletta_lavish_shiori_male_ending_7513fa12:
    lavish.say "И не думайте, что моя любовь куда-то делась: [lssb_common.hero_name()] и все вы мне по-прежнему дороги."

# ch/harems_full/office/events/office_harem_common.rpy:2320
translate russian aletta_lavish_shiori_male_ending_1b407c2a:
    lavish.say "Но я всё-таки самая надёжная и честная из всех участников!"

# ch/harems_full/office/events/office_harem_common.rpy:2321
translate russian aletta_lavish_shiori_male_ending_16de9855:
    shiori.say "Я... я не знаю, стоит ли нам это делать, когда [lssb_common.hero_name()] не здесь!"

# ch/harems_full/office/events/office_harem_common.rpy:2322
translate russian aletta_lavish_shiori_male_ending_93d00ac6:
    shiori.say "Ведь без него ничего этого вообще бы не было, правда?"

# ch/harems_full/office/events/office_harem_common.rpy:2323
translate russian aletta_lavish_shiori_male_ending_58f159c1:
    shiori.say "Ох... надеюсь, он не расстроится из-за того, что все о нём говорят!"

# ch/harems_full/office/events/office_harem_common.rpy:2324
translate russian aletta_lavish_shiori_male_ending_e32e38b6:
    aletta.say "Может, начнём с начала?"

# ch/harems_full/office/events/office_harem_common.rpy:2325
translate russian aletta_lavish_shiori_male_ending_d4ce6e65:
    aletta.say "[lssb_common.hero_name()] работал подо мной, когда мы познакомились в офисе. Простите за столь очевидную двусмысленность!"

# ch/harems_full/office/events/office_harem_common.rpy:2326
translate russian aletta_lavish_shiori_male_ending_da247318:
    aletta.say "Поначалу он меня не впечатлил, хотя говорят, что мне трудно угодить."

# ch/harems_full/office/events/office_harem_common.rpy:2327
translate russian aletta_lavish_shiori_male_ending_c3b96b26:
    lavish.say "Когда [lssb_common.hero_name()] стал моим начальником, у меня были сомнения."

# ch/harems_full/office/events/office_harem_common.rpy:2328
translate russian aletta_lavish_shiori_male_ending_80fb32ff:
    lavish.say "Я привыкла к профессиональной обстановке и целеустремлённым коллегам."

# ch/harems_full/office/events/office_harem_common.rpy:2329
translate russian aletta_lavish_shiori_male_ending_b08e7a01:
    lavish.say "А он казался... ну, немного раздолбаем!"

# ch/harems_full/office/events/office_harem_common.rpy:2330
translate russian aletta_lavish_shiori_male_ending_f3d293b5:
    shiori.say "Я ТАК волновалась, когда [lssb_common.hero_name()] стал моим коллегой."

# ch/harems_full/office/events/office_harem_common.rpy:2331
translate russian aletta_lavish_shiori_male_ending_622a24ff:
    shiori.say "Деньги были очень нужны, счета копились."

# ch/harems_full/office/events/office_harem_common.rpy:2332
translate russian aletta_lavish_shiori_male_ending_972679c4:
    shiori.say "Я была уверена, что не понравлюсь ему, что он сочтёт меня бесполезной!"

# ch/harems_full/office/events/office_harem_common.rpy:2333
translate russian aletta_lavish_shiori_male_ending_278dc089:
    aletta.say "Но должна признать: он доказал, что я ошибалась."

# ch/harems_full/office/events/office_harem_common.rpy:2334
translate russian aletta_lavish_shiori_male_ending_1257bf5f:
    aletta.say "В том смысле, что как человек оказался приятнее, чем я ожидала."

# ch/harems_full/office/events/office_harem_common.rpy:2335
translate russian aletta_lavish_shiori_male_ending_7b99ac54:
    aletta.say "А вот в работе он, откровенно говоря, безнадёжен без моей поддержки!"

# ch/harems_full/office/events/office_harem_common.rpy:2336
translate russian aletta_lavish_shiori_male_ending_0a4e7805:
    lavish.say "Не могу сказать, что [lssb_common.hero_name()] опроверг мои первые впечатления."

# ch/harems_full/office/events/office_harem_common.rpy:2337
translate russian aletta_lavish_shiori_male_ending_e94e0cc3:
    lavish.say "Но вскоре выяснилось, что он гораздо лучше умеет дружить, чем делать карьеру!"

# ch/harems_full/office/events/office_harem_common.rpy:2338
translate russian aletta_lavish_shiori_male_ending_935e27cf:
    lavish.say "Наверное, тогда я и начала видеть в нём не только коллегу."

# ch/harems_full/office/events/office_harem_common.rpy:2339
translate russian aletta_lavish_shiori_male_ending_ff6555d0:
    shiori.say "Конечно, [lssb_common.hero_name()] иногда терял со мной терпение. В худшие дни я сама не своя!"

# ch/harems_full/office/events/office_harem_common.rpy:2340
translate russian aletta_lavish_shiori_male_ending_8f1c0660:
    shiori.say "Но обычно он был терпелив и добр, и я чувствовала, что меня ценят."

# ch/harems_full/office/events/office_harem_common.rpy:2341
translate russian aletta_lavish_shiori_male_ending_63daadda:
    shiori.say "И с каждым днём всё сильнее к нему привязывалась."

# ch/harems_full/office/events/office_harem_common.rpy:2342
translate russian aletta_lavish_shiori_male_ending_13bfef04:
    aletta.say "Не успела оглянуться, как мы уже общались вне работы!"

# ch/harems_full/office/events/office_harem_common.rpy:2343
translate russian aletta_lavish_shiori_male_ending_1162e5bd:
    aletta.say "Сама виновата: нужно было внимательнее следить за статусом наших отношений."

# ch/harems_full/office/events/office_harem_common.rpy:2344
translate russian aletta_lavish_shiori_male_ending_af140e8f:
    aletta.say "Но было уже поздно: [lssb_common.hero_name()] сумел втереться ко мне в сердце!"

# ch/harems_full/office/events/office_harem_common.rpy:2345
translate russian aletta_lavish_shiori_male_ending_8eda7546:
    lavish.say "Ах... наверное, с самого начала стоило держаться с ним профессиональнее."

# ch/harems_full/office/events/office_harem_common.rpy:2346
translate russian aletta_lavish_shiori_male_ending_b33ee2f9:
    lavish.say "Я не следила за границей между работой и удовольствием."

# ch/harems_full/office/events/office_harem_common.rpy:2347
translate russian aletta_lavish_shiori_male_ending_831ad9f1:
    lavish.say "И вскоре он стал больше чем коллегой и уж точно больше чем другом!"

# ch/harems_full/office/events/office_harem_common.rpy:2348
translate russian aletta_lavish_shiori_male_ending_3ee1254c:
    shiori.say "Я правда старалась сохранить деловые отношения, но так хотела ему угодить!"

# ch/harems_full/office/events/office_harem_common.rpy:2349
translate russian aletta_lavish_shiori_male_ending_c7fea004:
    shiori.say "[lssb_common.hero_name()] просил — и я делала всё, причём с удовольствием."

# ch/harems_full/office/events/office_harem_common.rpy:2350
translate russian aletta_lavish_shiori_male_ending_c0b34381:
    shiori.say "А когда стало ясно, что ему это тоже нравится... я уже была безнадёжно влюблена!"

# ch/harems_full/office/events/office_harem_common.rpy:2351
translate russian aletta_lavish_shiori_male_ending_ae7dde37:
    aletta.say "После этого мы словно начали вместе подниматься по карьерной лестнице."

# ch/harems_full/office/events/office_harem_common.rpy:2352
translate russian aletta_lavish_shiori_male_ending_c9d219a5:
    aletta.say "Чем серьёзнее становились наши отношения, тем успешнее [lssb_common.hero_name()] и я работали."

# ch/harems_full/office/events/office_harem_common.rpy:2353
translate russian aletta_lavish_shiori_male_ending_8f0d010a:
    aletta.say "Не успела оглянуться, как мы оказались на самой вершине!"

# ch/harems_full/office/events/office_harem_common.rpy:2354
translate russian aletta_lavish_shiori_male_ending_2a835dff:
    lavish.say "[lssb_common.hero_name()] сделал меня счастливой в личной жизни. По-настоящему счастливой!"

# ch/harems_full/office/events/office_harem_common.rpy:2355
translate russian aletta_lavish_shiori_male_ending_07275f12:
    lavish.say "А я, кажется, положительно влияла на его профессиональную жизнь."

# ch/harems_full/office/events/office_harem_common.rpy:2356
translate russian aletta_lavish_shiori_male_ending_79a567f7:
    lavish.say "Наверное, научила его работать эффективнее, раз его начали повышать!"

# ch/harems_full/office/events/office_harem_common.rpy:2357
translate russian aletta_lavish_shiori_male_ending_15fe1caf:
    shiori.say "Я так радовалась, когда [lssb_common.hero_name()] начал получать повышения."

# ch/harems_full/office/events/office_harem_common.rpy:2358
translate russian aletta_lavish_shiori_male_ending_c78790c4:
    shiori.say "А когда радовался и он, то становился ещё добрее ко мне."

# ch/harems_full/office/events/office_harem_common.rpy:2359
translate russian aletta_lavish_shiori_male_ending_e623b8db:
    shiori.say "Мне хочется верить, что я помогла ему добиться такого успеха!"

# ch/harems_full/office/events/office_harem_common.rpy:2360
translate russian aletta_lavish_shiori_male_ending_72e6e505:
    aletta.say "Не скажу, что обрадовалась, узнав, что наши отношения не совсем исключительные."

# ch/harems_full/office/events/office_harem_common.rpy:2361
translate russian aletta_lavish_shiori_male_ending_e30fd0c6:
    aletta.say "Но затем начала смотреть на всё это как на бизнес, понимаете?"

# ch/harems_full/office/events/office_harem_common.rpy:2362
translate russian aletta_lavish_shiori_male_ending_89a3cbeb:
    aletta.say "Партнёрство — хорошо, но компания с большим числом сотрудников ещё лучше."

# ch/harems_full/office/events/office_harem_common.rpy:2363
translate russian aletta_lavish_shiori_male_ending_20b05590:
    aletta.say "И мне по-прежнему нравится считать себя старшим партнёром!"

# ch/harems_full/office/events/office_harem_common.rpy:2364
translate russian aletta_lavish_shiori_male_ending_1c508feb:
    lavish.say "Мне не нравилось, что [lssb_common.hero_name()] и я встречаемся не только друг с другом."

# ch/harems_full/office/events/office_harem_common.rpy:2365
translate russian aletta_lavish_shiori_male_ending_88cd0374:
    lavish.say "Но потом я подумала и увидела преимущества."

# ch/harems_full/office/events/office_harem_common.rpy:2366
translate russian aletta_lavish_shiori_male_ending_33be693a:
    lavish.say "Во многом так эффективнее и гибче. И НАМНОГО увлекательнее!"

# ch/harems_full/office/events/office_harem_common.rpy:2367
translate russian aletta_lavish_shiori_male_ending_4ffc0cb2:
    shiori.say "Когда [lssb_common.hero_name()] сказал, что встречается с другими девушками одновременно со мной, я испугалась."

# ch/harems_full/office/events/office_harem_common.rpy:2368
translate russian aletta_lavish_shiori_male_ending_5dee63a8:
    shiori.say "Решила, что они уведут его и я снова останусь одна."

# ch/harems_full/office/events/office_harem_common.rpy:2369
translate russian aletta_lavish_shiori_male_ending_ad20697c:
    shiori.say "Но [lssb_common.hero_name()] убедил меня, что всё будет иначе: мы все состоим в одних отношениях."

# ch/harems_full/office/events/office_harem_common.rpy:2370
translate russian aletta_lavish_shiori_male_ending_f3b7f09a:
    aletta.say "К моему удивлению, всё сложилось довольно хорошо."

# ch/harems_full/office/events/office_harem_common.rpy:2371
translate russian aletta_lavish_shiori_male_ending_9fc26d54:
    aletta.say "Мы в основном ладили и стали единым целым."

# ch/harems_full/office/events/office_harem_common.rpy:2372
translate russian aletta_lavish_shiori_male_ending_df89c038:
    aletta.say "Настолько хорошо, что брак показался следующим логичным шагом."

# ch/harems_full/office/events/office_harem_common.rpy:2373
translate russian aletta_lavish_shiori_male_ending_f9b87953:
    lavish.say "Знаю, как безумно звучит желание пожениться со всеми, с кем я спала."

# ch/harems_full/office/events/office_harem_common.rpy:2374
translate russian aletta_lavish_shiori_male_ending_d56a140d:
    lavish.say "Но вы должны понять: всё складывалось очень хорошо."

# ch/harems_full/office/events/office_harem_common.rpy:2375
translate russian aletta_lavish_shiori_male_ending_be296e69:
    lavish.say "Иногда и одного подходящего партнёра найти — удача, не говоря уже о нескольких!"

# ch/harems_full/office/events/office_harem_common.rpy:2376
translate russian aletta_lavish_shiori_male_ending_27f98246:
    shiori.say "Мой страх, что [lssb_common.hero_name()] уйдёт к другим девушкам и бросит меня, быстро исчез."

# ch/harems_full/office/events/office_harem_common.rpy:2377
translate russian aletta_lavish_shiori_male_ending_f1773a4c:
    shiori.say "Вскоре они стали мне как сёстры... даже больше, если понимаете, о чём я!"

# ch/harems_full/office/events/office_harem_common.rpy:2378
translate russian aletta_lavish_shiori_male_ending_bfe47a19:
    shiori.say "Поэтому мысль, что [lssb_common.hero_name()], девушки и я сможем пожениться, казалась чудесной!"

# ch/harems_full/office/events/office_harem_common.rpy:2379
translate russian aletta_lavish_shiori_male_ending_214c32e2:
    aletta.say "И теперь, когда мы воплотили это в жизнь, всё по-прежнему получается."

# ch/harems_full/office/events/office_harem_common.rpy:2380
translate russian aletta_lavish_shiori_male_ending_43600446:
    aletta.say "Мы команда и дома, и в офисе. На каждом шагу действуем сообща."

# ch/harems_full/office/events/office_harem_common.rpy:2381
translate russian aletta_lavish_shiori_male_ending_0f5cba8b:
    aletta.say "Рядом все, кто помогает мне оставаться сильной и собранной. Чего ещё желать?"

# ch/harems_full/office/events/office_harem_common.rpy:2382
translate russian aletta_lavish_shiori_male_ending_b011dd69:
    lavish.say "Я всегда была готова пожертвовать замужеством ради карьеры."

# ch/harems_full/office/events/office_harem_common.rpy:2383
translate russian aletta_lavish_shiori_male_ending_15811ba1:
    lavish.say "Но теперь, когда я замужем, понимаю, что выбирать необязательно."

# ch/harems_full/office/events/office_harem_common.rpy:2384
translate russian aletta_lavish_shiori_male_ending_15455b40:
    lavish.say "Ведь рядом все, кого я люблю, и они готовы меня поддержать!"

# ch/harems_full/office/events/office_harem_common.rpy:2385
translate russian aletta_lavish_shiori_male_ending_113f4b18:
    shiori.say "Я уже была замужем, и ничем хорошим это не кончилось!"

# ch/harems_full/office/events/office_harem_common.rpy:2386
translate russian aletta_lavish_shiori_male_ending_8ee731b2:
    shiori.say "Но теперь всё совсем иначе: мы скорее семья, чем просто пара."

# ch/harems_full/office/events/office_harem_common.rpy:2387
translate russian aletta_lavish_shiori_male_ending_3d3f2e10:
    shiori.say "Может, если бы мой первый брак был таким, всё сложилось бы по-другому?"

# ch/harems_full/office/events/office_harem_common.rpy:2388
translate russian aletta_lavish_shiori_male_ending_ab56a6ab:
    shiori.say "Хотя я ни за что не променяла бы то, что у меня есть сейчас, на такую возможность!"

# ch/harems_full/office/events/office_harem_common.rpy:2389
translate russian aletta_lavish_shiori_male_ending_e182316e:
    aletta.say "Так что будущее у нас светлое, и мне не терпится узнать, что оно готовит!"

# ch/harems_full/office/events/office_harem_common.rpy:2390
translate russian aletta_lavish_shiori_male_ending_3a6c24a1:
    lavish.say "Кто знает, как высоко мы сможем подняться и как далеко зайти вместе!"

# ch/harems_full/office/events/office_harem_common.rpy:2391
translate russian aletta_lavish_shiori_male_ending_c1dcf20d:
    shiori.say "Теперь у меня наконец есть семья, о которой я всегда мечтала!"

# ch/harems_full/office/events/office_harem_common.rpy:2398
translate russian aletta_audrey_shiori_male_ending_163e3150:
    "Знаете, я уже даже не помню, какие планы строил, когда устроился на нынешнюю работу."

# ch/harems_full/office/events/office_harem_common.rpy:2399
translate russian aletta_audrey_shiori_male_ending_afe3281b:
    "Собирался ли подниматься по карьерной лестнице так высоко, как смогу."

# ch/harems_full/office/events/office_harem_common.rpy:2400
translate russian aletta_audrey_shiori_male_ending_94c63a64:
    "Или просто хотел оплачивать счета, пока не найдётся что-то получше."

# ch/harems_full/office/events/office_harem_common.rpy:2401
translate russian aletta_audrey_shiori_male_ending_24743f63:
    "Но точно не думал встретить там будущих спутниц жизни!"

# ch/harems_full/office/events/office_harem_common.rpy:2402
translate russian aletta_audrey_shiori_male_ending_687b5cb6:
    "Насколько помню, я просто собирался немного повеселиться в офисе."

# ch/harems_full/office/events/office_harem_common.rpy:2403
translate russian aletta_audrey_shiori_male_ending_09d11206:
    "Ну, бездельничать и снимать рабочий стресс приятным общением с коллегами."

# ch/harems_full/office/events/office_harem_common.rpy:2404
translate russian aletta_audrey_shiori_male_ending_6c102b68:
    "Но одно потянулось за другим, и вот я здесь."

# ch/harems_full/office/events/office_harem_common.rpy:2405
translate russian aletta_audrey_shiori_male_ending_822fefa7:
    "Стою у алтаря и жду, когда те самые коллеги присоединятся ко мне."

# ch/harems_full/office/events/office_harem_common.rpy:2406
translate russian aletta_audrey_shiori_male_ending_1e6bb361:
    "Никогда бы не предположил, что всё закончится свадьбой."

# ch/harems_full/office/events/office_harem_common.rpy:2407
translate russian aletta_audrey_shiori_male_ending_3f238e55:
    "Тем более сразу с несколькими девушками с работы!"

# ch/harems_full/office/events/office_harem_common.rpy:2408
translate russian aletta_audrey_shiori_male_ending_0e3e2a13:
    "Не то чтобы я жаловался, понимаете?"

# ch/harems_full/office/events/office_harem_common.rpy:2409
translate russian aletta_audrey_shiori_male_ending_1cf1fe8c:
    "Я очень рад оказаться здесь."

# ch/harems_full/office/events/office_harem_common.rpy:2410
translate russian aletta_audrey_shiori_male_ending_a16093fe:
    "Просто сейчас моя жизнь напоминает американские горки!"

# ch/harems_full/office/events/office_harem_common.rpy:2411
translate russian aletta_audrey_shiori_male_ending_72c660cb:
    "Чтобы отвлечься, я оглядываю часовню."

# ch/harems_full/office/events/office_harem_common.rpy:2412
translate russian aletta_audrey_shiori_male_ending_62bccaf4:
    "Она красиво украшена, и это уже само по себе чудо."

# ch/harems_full/office/events/office_harem_common.rpy:2413
translate russian aletta_audrey_shiori_male_ending_4dcbc715:
    "Поверьте, когда оформление выбирает больше одной девушки, споры бывают жаркими!"

# ch/harems_full/office/events/office_harem_common.rpy:2414
translate russian aletta_audrey_shiori_male_ending_2d7ce45a:
    "Скамьи переполнены гостями — тоже ожидаемо, когда невест несколько."

# ch/harems_full/office/events/office_harem_common.rpy:2415
translate russian aletta_audrey_shiori_male_ending_f7ea0744:
    "Оглядывая ряд за рядом, я узнаю некоторые обращённые ко мне лица."

# ch/harems_full/office/events/office_harem_common.rpy:2416
translate russian aletta_audrey_shiori_male_ending_86f39f93:
    "Но разве можно знать здесь всех?"

# ch/harems_full/office/events/office_harem_common.rpy:2417
translate russian aletta_audrey_shiori_male_ending_03c31662:
    "Каждый участник свадьбы привёл целую толпу своих гостей."

# ch/harems_full/office/events/office_harem_common.rpy:2418
translate russian aletta_audrey_shiori_male_ending_de9f50a4:
    "Разобраться, кто к кому относится, почти невозможно!"

# ch/harems_full/office/events/office_harem_common.rpy:2419
translate russian aletta_audrey_shiori_male_ending_ccf5169a:
    "Я уже думаю попросить у девушек фотографии родственников с пояснениями."

# ch/harems_full/office/events/office_harem_common.rpy:2420
translate russian aletta_audrey_shiori_male_ending_f4e85421:
    "И тут часовню наполняет музыка."

# ch/harems_full/office/events/office_harem_common.rpy:2421
translate russian aletta_audrey_shiori_male_ending_29c59cdd:
    "Разумеется, я тут же прихожу в себя и выпрямляюсь почти по стойке смирно."

# ch/harems_full/office/events/office_harem_common.rpy:2422
translate russian aletta_audrey_shiori_male_ending_4ba2f2ee:
    "Как я могу не узнать эту музыку и не понять, что она означает?"

# ch/harems_full/office/events/office_harem_common.rpy:2423
translate russian aletta_audrey_shiori_male_ending_7f5b0022:
    "Я ведь сам оказался в центре споров о том, под что они пойдут к алтарю!"

# ch/harems_full/office/events/office_harem_common.rpy:2424
translate russian aletta_audrey_shiori_male_ending_be3eda7a:
    "Но воспоминания о последней ссоре и достигнутом компромиссе вдруг исчезают."

# ch/harems_full/office/events/office_harem_common.rpy:2425
translate russian aletta_audrey_shiori_male_ending_19827532:
    "Потому что я вижу только девушек, которые входят в часовню и идут по проходу."

# ch/harems_full/office/events/office_harem_common.rpy:2427
translate russian aletta_audrey_shiori_male_ending_5f9bfcb3:
    "Алетта идёт первой, словно возглавляет шествие."

# ch/harems_full/office/events/office_harem_common.rpy:2428
translate russian aletta_audrey_shiori_male_ending_13d712ad:
    "Голову держит высоко, как королева."

# ch/harems_full/office/events/office_harem_common.rpy:2429
translate russian aletta_audrey_shiori_male_ending_48929c23:
    "От одного её вида сердце бьётся быстрее."

# ch/harems_full/office/events/office_harem_common.rpy:2431
translate russian aletta_audrey_shiori_male_ending_61481264:
    "Я почти не замечаю, что она беременна."

# ch/harems_full/office/events/office_harem_common.rpy:2432
translate russian aletta_audrey_shiori_male_ending_55dfaa7f:
    "Платье так удачно скроено, что почти скрывает живот."

# ch/harems_full/office/events/office_harem_common.rpy:2433
translate russian aletta_audrey_shiori_male_ending_cb879e7a:
    "Почти, но не совсем. И, наверное, именно в этом вся прелесть."

# ch/harems_full/office/events/office_harem_common.rpy:2435
translate russian aletta_audrey_shiori_male_ending_9c17ea8b:
    "Одри каким-то образом идёт вместе с остальными и всё же держится особняком."

# ch/harems_full/office/events/office_harem_common.rpy:2436
translate russian aletta_audrey_shiori_male_ending_19ed8d0a:
    "На лице чуть язвительная, ироничная улыбка."

# ch/harems_full/office/events/office_harem_common.rpy:2437
translate russian aletta_audrey_shiori_male_ending_a1f07c5a:
    "Но в своём платье она всё равно элегантна и прекрасна."

# ch/harems_full/office/events/office_harem_common.rpy:2439
translate russian aletta_audrey_shiori_male_ending_3e02c880:
    "Одри держит букет прямо над округлившимся животом."

# ch/harems_full/office/events/office_harem_common.rpy:2440
translate russian aletta_audrey_shiori_male_ending_a76ee6d1:
    "Словно хочет показать его всему миру."

# ch/harems_full/office/events/office_harem_common.rpy:2441
translate russian aletta_audrey_shiori_male_ending_8fa30085:
    "Стоило догадаться, что она будет такой смелой и ничуть не смущённой!"

# ch/harems_full/office/events/office_harem_common.rpy:2443
translate russian aletta_audrey_shiori_male_ending_44563d73:
    "Сиори идёт последней, но именно на ней я дольше всего задерживаю взгляд."

# ch/harems_full/office/events/office_harem_common.rpy:2444
translate russian aletta_audrey_shiori_male_ending_0a48bf25:
    "Конечно, в своём платье она просто прекрасна."

# ch/harems_full/office/events/office_harem_common.rpy:2445
translate russian aletta_audrey_shiori_male_ending_7efc02d1:
    "Но важнее всего для меня то, что она улыбается."

# ch/harems_full/office/events/office_harem_common.rpy:2446
translate russian aletta_audrey_shiori_male_ending_ade0bdc1:
    "И я чувствую прилив счастья, зная, что она тоже счастлива."

# ch/harems_full/office/events/office_harem_common.rpy:2448
translate russian aletta_audrey_shiori_male_ending_71a6d072:
    "Может, дело ещё и в виде её живота?"

# ch/harems_full/office/events/office_harem_common.rpy:2449
translate russian aletta_audrey_shiori_male_ending_2f4773ce:
    "Мы одновременно женимся и начинаем новую семью."

# ch/harems_full/office/events/office_harem_common.rpy:2450
translate russian aletta_audrey_shiori_male_ending_bd9dd1ec:
    "Для всех нас это и правда начало новой жизни!"

# ch/harems_full/office/events/office_harem_common.rpy:2451
translate russian aletta_audrey_shiori_male_ending_a0c4ba2c:
    "Когда девушки подходят к алтарю, я неловко отодвигаюсь."

# ch/harems_full/office/events/office_harem_common.rpy:2452
translate russian aletta_audrey_shiori_male_ending_3043fcb4:
    "Они одна за другой встают рядом, то и дело меняясь местами."

# ch/harems_full/office/events/office_harem_common.rpy:2453
translate russian aletta_audrey_shiori_male_ending_ac482e86:
    "Конечно, мы пытались разобраться со всем этим на недавней репетиции."

# ch/harems_full/office/events/office_harem_common.rpy:2454
translate russian aletta_audrey_shiori_male_ending_378f4c4f:
    "Но, думаю, все толкаются из-за волнения."

# ch/harems_full/office/events/office_harem_common.rpy:2455
translate russian aletta_audrey_shiori_male_ending_c5b3de92:
    "Когда места наконец хватает всем, мы обмениваемся улыбками и взглядами."

# ch/harems_full/office/events/office_harem_common.rpy:2456
translate russian aletta_audrey_shiori_male_ending_e0a1dc8d:
    "Вижу, что каждая девушка чувствует себя так же, как я."

# ch/harems_full/office/events/office_harem_common.rpy:2457
translate russian aletta_audrey_shiori_male_ending_e220e585:
    "Эта странная смесь восторга и почти страха, от которой трепещет всё внутри!"

# ch/harems_full/office/events/office_harem_common.rpy:2459
translate russian aletta_audrey_shiori_male_ending_2a3aa788:
    "Мы все разом смотрим на священника."

# ch/harems_full/office/events/office_harem_common.rpy:2460
translate russian aletta_audrey_shiori_male_ending_b515515b:
    "Он жестом показывает, что церемония начинается."

# ch/harems_full/office/events/office_harem_common.rpy:2461
translate russian aletta_audrey_shiori_male_ending_6475c777:
    "Я рад, что он так уверенно берёт всё в свои руки."

# ch/harems_full/office/events/office_harem_common.rpy:2462
translate russian aletta_audrey_shiori_male_ending_bb69a3eb:
    "Потому что мы сразу сосредотачиваемся и следуем указаниям."

# ch/harems_full/office/events/office_harem_common.rpy:2464
translate russian aletta_audrey_shiori_male_ending_d601e095:
    "Священник" "Мы собрались здесь сегодня..."

# ch/harems_full/office/events/office_harem_common.rpy:2465
translate russian aletta_audrey_shiori_male_ending_c0a13476:
    "Священник" "Чтобы соединить этих людей — и я действительно имею в виду ВСЕХ!"

# ch/harems_full/office/events/office_harem_common.rpy:2466
translate russian aletta_audrey_shiori_male_ending_d05a0e2d:
    "Среди гостей прокатывается смех в ответ на маленькую шутку."

# ch/harems_full/office/events/office_harem_common.rpy:2467
translate russian aletta_audrey_shiori_male_ending_36cf52b2:
    "Но священник продолжает, и все снова умолкают."

# ch/harems_full/office/events/office_harem_common.rpy:2468
translate russian aletta_audrey_shiori_male_ending_20520034:
    "Священник" "Священными узами брака..."

# ch/harems_full/office/events/office_harem_common.rpy:2469
translate russian aletta_audrey_shiori_male_ending_22fe795c:
    "Остальная церемония проходит примерно так, как вы и представляете."

# ch/harems_full/office/events/office_harem_common.rpy:2470
translate russian aletta_audrey_shiori_male_ending_f3f3e6b5:
    "А чего вы ожидали?"

# ch/harems_full/office/events/office_harem_common.rpy:2471
translate russian aletta_audrey_shiori_male_ending_bb5a9817:
    "Призыва демонов и жертвоприношения животных?"

# ch/harems_full/office/events/office_harem_common.rpy:2472
translate russian aletta_audrey_shiori_male_ending_9b5d2ac7:
    "От обычной свадьбы отличается лишь то, что всё повторяют больше двух раз."

# ch/harems_full/office/events/office_harem_common.rpy:2473
translate russian aletta_audrey_shiori_male_ending_b9a1186d:
    "Священник" "Согласны ли вы, Алетта, вступить с этими людьми..."

# ch/harems_full/office/events/office_harem_common.rpy:2474
translate russian aletta_audrey_shiori_male_ending_8c7361cd:
    "Священник" "В законный брак?"

# ch/harems_full/office/events/office_harem_common.rpy:2477
translate russian aletta_audrey_shiori_male_ending_5af96bc2:
    "Священник" "Согласны ли вы, Одри, вступить с этими людьми..."

# ch/harems_full/office/events/office_harem_common.rpy:2478
translate russian aletta_audrey_shiori_male_ending_8c7361cd_1:
    "Священник" "В законный брак?"

# ch/harems_full/office/events/office_harem_common.rpy:2480
translate russian aletta_audrey_shiori_male_ending_944edfac:
    audrey.say "Согласна."

# ch/harems_full/office/events/office_harem_common.rpy:2481
translate russian aletta_audrey_shiori_male_ending_c5007986:
    "Священник" "Согласны ли вы, Сиори, вступить с этими людьми..."

# ch/harems_full/office/events/office_harem_common.rpy:2482
translate russian aletta_audrey_shiori_male_ending_8c7361cd_2:
    "Священник" "В законный брак?"

# ch/harems_full/office/events/office_harem_common.rpy:2484
translate russian aletta_audrey_shiori_male_ending_d1bfdb33:
    shiori.say "Согласна."

# ch/harems_full/office/events/office_harem_common.rpy:2485
translate russian aletta_audrey_shiori_male_ending_f732b602:
    "Священник" "И наконец..."

# ch/harems_full/office/events/office_harem_common.rpy:2486
translate russian aletta_audrey_shiori_male_ending_a9301f98:
    "Священник" "Согласны ли вы, [lssb_common.hero_name()], вступить с этими людьми..."

# ch/harems_full/office/events/office_harem_common.rpy:2487
translate russian aletta_audrey_shiori_male_ending_8c7361cd_3:
    "Священник" "В законный брак?"

# ch/harems_full/office/events/office_harem_common.rpy:2488
translate russian aletta_audrey_shiori_male_ending_cc481164:
    mike.say "Согласен."

# ch/harems_full/office/events/office_harem_common.rpy:2489
translate russian aletta_audrey_shiori_male_ending_c088e303:
    "Священник кивает и на миг переводит дух."

# ch/harems_full/office/events/office_harem_common.rpy:2490
translate russian aletta_audrey_shiori_male_ending_58c83231:
    "Священник" "Обращаюсь ко всем присутствующим..."

# ch/harems_full/office/events/office_harem_common.rpy:2491
translate russian aletta_audrey_shiori_male_ending_34d3fae8:
    "Священник" "Если кому-то известна законная причина, по которой эти люди не могут заключить брак..."

# ch/harems_full/office/events/office_harem_common.rpy:2492
translate russian aletta_audrey_shiori_male_ending_713d080b:
    "Священник" "Скажите сейчас или молчите вечно!"

# ch/harems_full/office/events/office_harem_common.rpy:2493
translate russian aletta_audrey_shiori_male_ending_59eeee8b:
    "Повисает привычная пауза: гости посмеиваются и оглядываются."

# ch/harems_full/office/events/office_harem_common.rpy:2494
translate russian aletta_audrey_shiori_male_ending_2bdc3a2c:
    "Может, они ждут, что сейчас в часовню ворвётся армия разгневанных бывших."

# ch/harems_full/office/events/office_harem_common.rpy:2495
translate russian aletta_audrey_shiori_male_ending_96cf9a58:
    "Но, к счастью, ничего столь невероятного не происходит."

# ch/harems_full/office/events/office_harem_common.rpy:2496
translate russian aletta_audrey_shiori_male_ending_e054f310:
    "Священник" "Что ж..."

# ch/harems_full/office/events/office_harem_common.rpy:2497
translate russian aletta_audrey_shiori_male_ending_7d5acc60:
    "Священник" "Объявляю вас супругами."

# ch/harems_full/office/events/office_harem_common.rpy:2498
translate russian aletta_audrey_shiori_male_ending_64235e41:
    "Священник" "Можете... эм..."

# ch/harems_full/office/events/office_harem_common.rpy:2499
translate russian aletta_audrey_shiori_male_ending_9751f813:
    "Священник" "Ну... сделать что-нибудь подобающее случаю!"

# ch/harems_full/office/events/office_harem_common.rpy:2500
translate russian aletta_audrey_shiori_male_ending_c2d44e57:
    "На этих словах священника мы все обнимаемся."

# ch/harems_full/office/events/office_harem_common.rpy:2501
translate russian aletta_audrey_shiori_male_ending_d4a89fae:
    "Переплетая руки и прижимаясь друг к другу."

# ch/harems_full/office/events/office_harem_common.rpy:2502
translate russian aletta_audrey_shiori_male_ending_7f03cb6b:
    "Наверное, наши отношения чем-то на это похожи."

# ch/harems_full/office/events/office_harem_common.rpy:2503
translate russian aletta_audrey_shiori_male_ending_4c722292:
    "Мы не всегда понимаем, как всё должно быть устроено."

# ch/harems_full/office/events/office_harem_common.rpy:2504
translate russian aletta_audrey_shiori_male_ending_c64d880a:
    "Но чувствуем, что нам хорошо вместе, и только это по-настоящему важно."

# ch/harems_full/office/events/office_harem_common.rpy:2507
translate russian aletta_audrey_shiori_male_ending_fb135262:
    aletta.say "Было бы лучше, если бы с самого начала всё было так."

# ch/harems_full/office/events/office_harem_common.rpy:2508
translate russian aletta_audrey_shiori_male_ending_3fee3f60:
    aletta.say "В самом деле, вы думаете, [lssb_common.hero_name()] всегда будет совершенно честен?"

# ch/harems_full/office/events/office_harem_common.rpy:2509
translate russian aletta_audrey_shiori_male_ending_0bee8452:
    aletta.say "Нам-то известно, что его словам не всегда можно верить."

# ch/harems_full/office/events/office_harem_common.rpy:2510
translate russian aletta_audrey_shiori_male_ending_18edf2c6:
    aletta.say "В конце концов, мы видели содержимое его трусов после того, как он его нам описывал!"

# ch/harems_full/office/events/office_harem_common.rpy:2511
translate russian aletta_audrey_shiori_male_ending_db6b1ec4:
    audrey.say "Я бы и сама со всем справилась. [lssb_common.hero_name()] мог бы вообще не участвовать."

# ch/harems_full/office/events/office_harem_common.rpy:2512
translate russian aletta_audrey_shiori_male_ending_3bf1fee5:
    audrey.say "Вообще-то и ваше участие необязательно."

# ch/harems_full/office/events/office_harem_common.rpy:2513
translate russian aletta_audrey_shiori_male_ending_f555ec5b:
    audrey.say "Никто из вас не расскажет так хорошо, как я."

# ch/harems_full/office/events/office_harem_common.rpy:2514
translate russian aletta_audrey_shiori_male_ending_16de9855:
    shiori.say "Я... я не знаю, стоит ли нам это делать, когда [lssb_common.hero_name()] не здесь!"

# ch/harems_full/office/events/office_harem_common.rpy:2515
translate russian aletta_audrey_shiori_male_ending_93d00ac6:
    shiori.say "Ведь без него ничего этого вообще бы не было, правда?"

# ch/harems_full/office/events/office_harem_common.rpy:2516
translate russian aletta_audrey_shiori_male_ending_58f159c1:
    shiori.say "Ох... надеюсь, он не расстроится из-за того, что все о нём говорят!"

# ch/harems_full/office/events/office_harem_common.rpy:2517
translate russian aletta_audrey_shiori_male_ending_e32e38b6:
    aletta.say "Может, начнём с начала?"

# ch/harems_full/office/events/office_harem_common.rpy:2518
translate russian aletta_audrey_shiori_male_ending_d4ce6e65:
    aletta.say "[lssb_common.hero_name()] работал подо мной, когда мы познакомились в офисе. Простите за столь очевидную двусмысленность!"

# ch/harems_full/office/events/office_harem_common.rpy:2519
translate russian aletta_audrey_shiori_male_ending_da247318:
    aletta.say "Поначалу он меня не впечатлил, хотя говорят, что мне трудно угодить."

# ch/harems_full/office/events/office_harem_common.rpy:2520
translate russian aletta_audrey_shiori_male_ending_ec759ec2:
    audrey.say "Да, обычно я ненавижу мужчин, под которыми приходится... работать!"

# ch/harems_full/office/events/office_harem_common.rpy:2521
translate russian aletta_audrey_shiori_male_ending_63750b5e:
    audrey.say "И была почти уверена, что [lssb_common.hero_name()] окажется таким же."

# ch/harems_full/office/events/office_harem_common.rpy:2522
translate russian aletta_audrey_shiori_male_ending_a74f7b23:
    audrey.say "Но особо не переживала: таким парням я всегда устраиваю ад!"

# ch/harems_full/office/events/office_harem_common.rpy:2523
translate russian aletta_audrey_shiori_male_ending_f3d293b5:
    shiori.say "Я ТАК волновалась, когда [lssb_common.hero_name()] стал моим коллегой."

# ch/harems_full/office/events/office_harem_common.rpy:2524
translate russian aletta_audrey_shiori_male_ending_622a24ff:
    shiori.say "Деньги были очень нужны, счета копились."

# ch/harems_full/office/events/office_harem_common.rpy:2525
translate russian aletta_audrey_shiori_male_ending_972679c4:
    shiori.say "Я была уверена, что не понравлюсь ему, что он сочтёт меня бесполезной!"

# ch/harems_full/office/events/office_harem_common.rpy:2526
translate russian aletta_audrey_shiori_male_ending_278dc089:
    aletta.say "Но должна признать: он доказал, что я ошибалась."

# ch/harems_full/office/events/office_harem_common.rpy:2527
translate russian aletta_audrey_shiori_male_ending_1257bf5f:
    aletta.say "В том смысле, что как человек оказался приятнее, чем я ожидала."

# ch/harems_full/office/events/office_harem_common.rpy:2528
translate russian aletta_audrey_shiori_male_ending_7b99ac54:
    aletta.say "А вот в работе он, откровенно говоря, безнадёжен без моей поддержки!"

# ch/harems_full/office/events/office_harem_common.rpy:2529
translate russian aletta_audrey_shiori_male_ending_4049420f:
    audrey.say "[lssb_common.hero_name()] стал жертвой моих обычных изощрённых издевательств."

# ch/harems_full/office/events/office_harem_common.rpy:2530
translate russian aletta_audrey_shiori_male_ending_20525bae:
    audrey.say "И, чёрт возьми, мне это начало нравиться."

# ch/harems_full/office/events/office_harem_common.rpy:2531
translate russian aletta_audrey_shiori_male_ending_51ff6098:
    audrey.say "То есть больше обычного, больше, чем просто смотреть на его мучения!"

# ch/harems_full/office/events/office_harem_common.rpy:2532
translate russian aletta_audrey_shiori_male_ending_ff6555d0:
    shiori.say "Конечно, [lssb_common.hero_name()] иногда терял со мной терпение. В худшие дни я сама не своя!"

# ch/harems_full/office/events/office_harem_common.rpy:2533
translate russian aletta_audrey_shiori_male_ending_8f1c0660:
    shiori.say "Но обычно он был терпелив и добр, и я чувствовала, что меня ценят."

# ch/harems_full/office/events/office_harem_common.rpy:2534
translate russian aletta_audrey_shiori_male_ending_63daadda:
    shiori.say "И с каждым днём всё сильнее к нему привязывалась."

# ch/harems_full/office/events/office_harem_common.rpy:2535
translate russian aletta_audrey_shiori_male_ending_13bfef04:
    aletta.say "Не успела оглянуться, как мы уже общались вне работы!"

# ch/harems_full/office/events/office_harem_common.rpy:2536
translate russian aletta_audrey_shiori_male_ending_1162e5bd:
    aletta.say "Сама виновата: нужно было внимательнее следить за статусом наших отношений."

# ch/harems_full/office/events/office_harem_common.rpy:2537
translate russian aletta_audrey_shiori_male_ending_af140e8f:
    aletta.say "Но было уже поздно: [lssb_common.hero_name()] сумел втереться ко мне в сердце!"

# ch/harems_full/office/events/office_harem_common.rpy:2538
translate russian aletta_audrey_shiori_male_ending_ef76f68c:
    audrey.say "Вот так он меня и поймал: мне было слишком весело!"

# ch/harems_full/office/events/office_harem_common.rpy:2539
translate russian aletta_audrey_shiori_male_ending_33cfb592:
    audrey.say "Я и понять ничего не успела, как уже сама возвращалась за новой порцией."

# ch/harems_full/office/events/office_harem_common.rpy:2540
translate russian aletta_audrey_shiori_male_ending_7d9f90fe:
    audrey.say "И дня не могла прожить, не подразнив его, хотя бы ради реакции!"

# ch/harems_full/office/events/office_harem_common.rpy:2541
translate russian aletta_audrey_shiori_male_ending_3ee1254c:
    shiori.say "Я правда старалась сохранить деловые отношения, но так хотела ему угодить!"

# ch/harems_full/office/events/office_harem_common.rpy:2542
translate russian aletta_audrey_shiori_male_ending_c7fea004:
    shiori.say "[lssb_common.hero_name()] просил — и я делала всё, причём с удовольствием."

# ch/harems_full/office/events/office_harem_common.rpy:2543
translate russian aletta_audrey_shiori_male_ending_c0b34381:
    shiori.say "А когда стало ясно, что ему это тоже нравится... я уже была безнадёжно влюблена!"

# ch/harems_full/office/events/office_harem_common.rpy:2544
translate russian aletta_audrey_shiori_male_ending_ae7dde37:
    aletta.say "После этого мы словно начали вместе подниматься по карьерной лестнице."

# ch/harems_full/office/events/office_harem_common.rpy:2545
translate russian aletta_audrey_shiori_male_ending_c9d219a5:
    aletta.say "Чем серьёзнее становились наши отношения, тем успешнее [lssb_common.hero_name()] и я работали."

# ch/harems_full/office/events/office_harem_common.rpy:2546
translate russian aletta_audrey_shiori_male_ending_8f0d010a:
    aletta.say "Не успела оглянуться, как мы оказались на самой вершине!"

# ch/harems_full/office/events/office_harem_common.rpy:2547
translate russian aletta_audrey_shiori_male_ending_19e4825a:
    audrey.say "Ещё никто из тех, над кем я издевалась, не начинал получать повышения!"

# ch/harems_full/office/events/office_harem_common.rpy:2548
translate russian aletta_audrey_shiori_male_ending_2a530e68:
    audrey.say "Но чем ближе становились наши отношения, тем успешнее был [lssb_common.hero_name()]."

# ch/harems_full/office/events/office_harem_common.rpy:2549
translate russian aletta_audrey_shiori_male_ending_de1eb4f3:
    audrey.say "Вскоре он уже сидел на самой верхушке!"

# ch/harems_full/office/events/office_harem_common.rpy:2550
translate russian aletta_audrey_shiori_male_ending_15fe1caf:
    shiori.say "Я так радовалась, когда [lssb_common.hero_name()] начал получать повышения."

# ch/harems_full/office/events/office_harem_common.rpy:2551
translate russian aletta_audrey_shiori_male_ending_c78790c4:
    shiori.say "А когда радовался и он, то становился ещё добрее ко мне."

# ch/harems_full/office/events/office_harem_common.rpy:2552
translate russian aletta_audrey_shiori_male_ending_e623b8db:
    shiori.say "Мне хочется верить, что я помогла ему добиться такого успеха!"

# ch/harems_full/office/events/office_harem_common.rpy:2553
translate russian aletta_audrey_shiori_male_ending_72e6e505:
    aletta.say "Не скажу, что обрадовалась, узнав, что наши отношения не совсем исключительные."

# ch/harems_full/office/events/office_harem_common.rpy:2554
translate russian aletta_audrey_shiori_male_ending_e30fd0c6:
    aletta.say "Но затем начала смотреть на всё это как на бизнес, понимаете?"

# ch/harems_full/office/events/office_harem_common.rpy:2555
translate russian aletta_audrey_shiori_male_ending_89a3cbeb:
    aletta.say "Партнёрство — хорошо, но компания с большим числом сотрудников ещё лучше."

# ch/harems_full/office/events/office_harem_common.rpy:2556
translate russian aletta_audrey_shiori_male_ending_20b05590:
    aletta.say "И мне по-прежнему нравится считать себя старшим партнёром!"

# ch/harems_full/office/events/office_harem_common.rpy:2557
translate russian aletta_audrey_shiori_male_ending_101688db:
    audrey.say "Да, я немного обалдела, узнав, что [lssb_common.hero_name()] встречается и с другими девушками в офисе."

# ch/harems_full/office/events/office_harem_common.rpy:2558
translate russian aletta_audrey_shiori_male_ending_584b7d13:
    audrey.say "Обычно это я всех шокирую, понимаете?"

# ch/harems_full/office/events/office_harem_common.rpy:2559
translate russian aletta_audrey_shiori_male_ending_b723cbd8:
    audrey.say "Но больше участников — больше возможностей повеселиться!"

# ch/harems_full/office/events/office_harem_common.rpy:2560
translate russian aletta_audrey_shiori_male_ending_4ffc0cb2:
    shiori.say "Когда [lssb_common.hero_name()] сказал, что встречается с другими девушками одновременно со мной, я испугалась."

# ch/harems_full/office/events/office_harem_common.rpy:2561
translate russian aletta_audrey_shiori_male_ending_5dee63a8:
    shiori.say "Решила, что они уведут его и я снова останусь одна."

# ch/harems_full/office/events/office_harem_common.rpy:2562
translate russian aletta_audrey_shiori_male_ending_ad20697c:
    shiori.say "Но [lssb_common.hero_name()] убедил меня, что всё будет иначе: мы все состоим в одних отношениях."

# ch/harems_full/office/events/office_harem_common.rpy:2563
translate russian aletta_audrey_shiori_male_ending_f3b7f09a:
    aletta.say "К моему удивлению, всё сложилось довольно хорошо."

# ch/harems_full/office/events/office_harem_common.rpy:2564
translate russian aletta_audrey_shiori_male_ending_9fc26d54:
    aletta.say "Мы в основном ладили и стали единым целым."

# ch/harems_full/office/events/office_harem_common.rpy:2565
translate russian aletta_audrey_shiori_male_ending_df89c038:
    aletta.say "Настолько хорошо, что брак показался следующим логичным шагом."

# ch/harems_full/office/events/office_harem_common.rpy:2566
translate russian aletta_audrey_shiori_male_ending_0092b8b7:
    audrey.say "Поверьте, я никогда не думала, что выйду замуж даже за одного человека."

# ch/harems_full/office/events/office_harem_common.rpy:2567
translate russian aletta_audrey_shiori_male_ending_059e8d07:
    audrey.say "Так могла ли я представить брак сразу с несколькими?!"

# ch/harems_full/office/events/office_harem_common.rpy:2568
translate russian aletta_audrey_shiori_male_ending_c0246911:
    audrey.say "Ну... может, я именно поэтому и согласилась: идея-то безумная!"

# ch/harems_full/office/events/office_harem_common.rpy:2569
translate russian aletta_audrey_shiori_male_ending_27f98246:
    shiori.say "Мой страх, что [lssb_common.hero_name()] уйдёт к другим девушкам и бросит меня, быстро исчез."

# ch/harems_full/office/events/office_harem_common.rpy:2570
translate russian aletta_audrey_shiori_male_ending_f1773a4c:
    shiori.say "Вскоре они стали мне как сёстры... даже больше, если понимаете, о чём я!"

# ch/harems_full/office/events/office_harem_common.rpy:2571
translate russian aletta_audrey_shiori_male_ending_bfe47a19:
    shiori.say "Поэтому мысль, что [lssb_common.hero_name()], девушки и я сможем пожениться, казалась чудесной!"

# ch/harems_full/office/events/office_harem_common.rpy:2572
translate russian aletta_audrey_shiori_male_ending_214c32e2:
    aletta.say "И теперь, когда мы воплотили это в жизнь, всё по-прежнему получается."

# ch/harems_full/office/events/office_harem_common.rpy:2573
translate russian aletta_audrey_shiori_male_ending_43600446:
    aletta.say "Мы команда и дома, и в офисе. На каждом шагу действуем сообща."

# ch/harems_full/office/events/office_harem_common.rpy:2574
translate russian aletta_audrey_shiori_male_ending_0f5cba8b:
    aletta.say "Рядом все, кто помогает мне оставаться сильной и собранной. Чего ещё желать?"

# ch/harems_full/office/events/office_harem_common.rpy:2575
translate russian aletta_audrey_shiori_male_ending_c660529e:
    audrey.say "Все говорят, что после свадьбы я стала спокойнее и остепенилась."

# ch/harems_full/office/events/office_harem_common.rpy:2576
translate russian aletta_audrey_shiori_male_ending_697d0dbb:
    audrey.say "И знаете, что меня в этом больше всего бесит? То, что они вроде бы правы."

# ch/harems_full/office/events/office_harem_common.rpy:2577
translate russian aletta_audrey_shiori_male_ending_96b577b4:
    audrey.say "Рядом столько людей, о которых я могу заботиться и которые заботятся обо мне, — я уже не такая злая, как раньше!"

# ch/harems_full/office/events/office_harem_common.rpy:2578
translate russian aletta_audrey_shiori_male_ending_113f4b18:
    shiori.say "Я уже была замужем, и ничем хорошим это не кончилось!"

# ch/harems_full/office/events/office_harem_common.rpy:2579
translate russian aletta_audrey_shiori_male_ending_8ee731b2:
    shiori.say "Но теперь всё совсем иначе: мы скорее семья, чем просто пара."

# ch/harems_full/office/events/office_harem_common.rpy:2580
translate russian aletta_audrey_shiori_male_ending_3d3f2e10:
    shiori.say "Может, если бы мой первый брак был таким, всё сложилось бы по-другому?"

# ch/harems_full/office/events/office_harem_common.rpy:2581
translate russian aletta_audrey_shiori_male_ending_ab56a6ab:
    shiori.say "Хотя я ни за что не променяла бы то, что у меня есть сейчас, на такую возможность!"

# ch/harems_full/office/events/office_harem_common.rpy:2582
translate russian aletta_audrey_shiori_male_ending_e182316e:
    aletta.say "Так что будущее у нас светлое, и мне не терпится узнать, что оно готовит!"

# ch/harems_full/office/events/office_harem_common.rpy:2583
translate russian aletta_audrey_shiori_male_ending_3e7ffed2:
    audrey.say "Впереди нас ждёт много интересного!"

# ch/harems_full/office/events/office_harem_common.rpy:2584
translate russian aletta_audrey_shiori_male_ending_c1dcf20d:
    shiori.say "Теперь у меня наконец есть семья, о которой я всегда мечтала!"

# ch/harems_full/office/events/office_harem_common.rpy:2591
translate russian aletta_audrey_lavish_male_ending_163e3150:
    "Знаете, я уже даже не помню, какие планы строил, когда устроился на нынешнюю работу."

# ch/harems_full/office/events/office_harem_common.rpy:2592
translate russian aletta_audrey_lavish_male_ending_afe3281b:
    "Собирался ли подниматься по карьерной лестнице так высоко, как смогу."

# ch/harems_full/office/events/office_harem_common.rpy:2593
translate russian aletta_audrey_lavish_male_ending_94c63a64:
    "Или просто хотел оплачивать счета, пока не найдётся что-то получше."

# ch/harems_full/office/events/office_harem_common.rpy:2594
translate russian aletta_audrey_lavish_male_ending_24743f63:
    "Но точно не думал встретить там будущих спутниц жизни!"

# ch/harems_full/office/events/office_harem_common.rpy:2595
translate russian aletta_audrey_lavish_male_ending_687b5cb6:
    "Насколько помню, я просто собирался немного повеселиться в офисе."

# ch/harems_full/office/events/office_harem_common.rpy:2596
translate russian aletta_audrey_lavish_male_ending_09d11206:
    "Ну, бездельничать и снимать рабочий стресс приятным общением с коллегами."

# ch/harems_full/office/events/office_harem_common.rpy:2597
translate russian aletta_audrey_lavish_male_ending_6c102b68:
    "Но одно потянулось за другим, и вот я здесь."

# ch/harems_full/office/events/office_harem_common.rpy:2598
translate russian aletta_audrey_lavish_male_ending_822fefa7:
    "Стою у алтаря и жду, когда те самые коллеги присоединятся ко мне."

# ch/harems_full/office/events/office_harem_common.rpy:2599
translate russian aletta_audrey_lavish_male_ending_1e6bb361:
    "Никогда бы не предположил, что всё закончится свадьбой."

# ch/harems_full/office/events/office_harem_common.rpy:2600
translate russian aletta_audrey_lavish_male_ending_3f238e55:
    "Тем более сразу с несколькими девушками с работы!"

# ch/harems_full/office/events/office_harem_common.rpy:2601
translate russian aletta_audrey_lavish_male_ending_0e3e2a13:
    "Не то чтобы я жаловался, понимаете?"

# ch/harems_full/office/events/office_harem_common.rpy:2602
translate russian aletta_audrey_lavish_male_ending_1cf1fe8c:
    "Я очень рад оказаться здесь."

# ch/harems_full/office/events/office_harem_common.rpy:2603
translate russian aletta_audrey_lavish_male_ending_a16093fe:
    "Просто сейчас моя жизнь напоминает американские горки!"

# ch/harems_full/office/events/office_harem_common.rpy:2604
translate russian aletta_audrey_lavish_male_ending_72c660cb:
    "Чтобы отвлечься, я оглядываю часовню."

# ch/harems_full/office/events/office_harem_common.rpy:2605
translate russian aletta_audrey_lavish_male_ending_62bccaf4:
    "Она красиво украшена, и это уже само по себе чудо."

# ch/harems_full/office/events/office_harem_common.rpy:2606
translate russian aletta_audrey_lavish_male_ending_4dcbc715:
    "Поверьте, когда оформление выбирает больше одной девушки, споры бывают жаркими!"

# ch/harems_full/office/events/office_harem_common.rpy:2607
translate russian aletta_audrey_lavish_male_ending_2d7ce45a:
    "Скамьи переполнены гостями — тоже ожидаемо, когда невест несколько."

# ch/harems_full/office/events/office_harem_common.rpy:2608
translate russian aletta_audrey_lavish_male_ending_f7ea0744:
    "Оглядывая ряд за рядом, я узнаю некоторые обращённые ко мне лица."

# ch/harems_full/office/events/office_harem_common.rpy:2609
translate russian aletta_audrey_lavish_male_ending_86f39f93:
    "Но разве можно знать здесь всех?"

# ch/harems_full/office/events/office_harem_common.rpy:2610
translate russian aletta_audrey_lavish_male_ending_03c31662:
    "Каждый участник свадьбы привёл целую толпу своих гостей."

# ch/harems_full/office/events/office_harem_common.rpy:2611
translate russian aletta_audrey_lavish_male_ending_de9f50a4:
    "Разобраться, кто к кому относится, почти невозможно!"

# ch/harems_full/office/events/office_harem_common.rpy:2612
translate russian aletta_audrey_lavish_male_ending_ccf5169a:
    "Я уже думаю попросить у девушек фотографии родственников с пояснениями."

# ch/harems_full/office/events/office_harem_common.rpy:2613
translate russian aletta_audrey_lavish_male_ending_f4e85421:
    "И тут часовню наполняет музыка."

# ch/harems_full/office/events/office_harem_common.rpy:2614
translate russian aletta_audrey_lavish_male_ending_29c59cdd:
    "Разумеется, я тут же прихожу в себя и выпрямляюсь почти по стойке смирно."

# ch/harems_full/office/events/office_harem_common.rpy:2615
translate russian aletta_audrey_lavish_male_ending_4ba2f2ee:
    "Как я могу не узнать эту музыку и не понять, что она означает?"

# ch/harems_full/office/events/office_harem_common.rpy:2616
translate russian aletta_audrey_lavish_male_ending_7f5b0022:
    "Я ведь сам оказался в центре споров о том, под что они пойдут к алтарю!"

# ch/harems_full/office/events/office_harem_common.rpy:2617
translate russian aletta_audrey_lavish_male_ending_be3eda7a:
    "Но воспоминания о последней ссоре и достигнутом компромиссе вдруг исчезают."

# ch/harems_full/office/events/office_harem_common.rpy:2618
translate russian aletta_audrey_lavish_male_ending_19827532:
    "Потому что я вижу только девушек, которые входят в часовню и идут по проходу."

# ch/harems_full/office/events/office_harem_common.rpy:2620
translate russian aletta_audrey_lavish_male_ending_5f9bfcb3:
    "Алетта идёт первой, словно возглавляет шествие."

# ch/harems_full/office/events/office_harem_common.rpy:2621
translate russian aletta_audrey_lavish_male_ending_13d712ad:
    "Голову держит высоко, как королева."

# ch/harems_full/office/events/office_harem_common.rpy:2622
translate russian aletta_audrey_lavish_male_ending_48929c23:
    "От одного её вида сердце бьётся быстрее."

# ch/harems_full/office/events/office_harem_common.rpy:2624
translate russian aletta_audrey_lavish_male_ending_61481264:
    "Я почти не замечаю, что она беременна."

# ch/harems_full/office/events/office_harem_common.rpy:2625
translate russian aletta_audrey_lavish_male_ending_55dfaa7f:
    "Платье так удачно скроено, что почти скрывает живот."

# ch/harems_full/office/events/office_harem_common.rpy:2626
translate russian aletta_audrey_lavish_male_ending_cb879e7a:
    "Почти, но не совсем. И, наверное, именно в этом вся прелесть."

# ch/harems_full/office/events/office_harem_common.rpy:2628
translate russian aletta_audrey_lavish_male_ending_9c17ea8b:
    "Одри каким-то образом идёт вместе с остальными и всё же держится особняком."

# ch/harems_full/office/events/office_harem_common.rpy:2629
translate russian aletta_audrey_lavish_male_ending_19ed8d0a:
    "На лице чуть язвительная, ироничная улыбка."

# ch/harems_full/office/events/office_harem_common.rpy:2630
translate russian aletta_audrey_lavish_male_ending_a1f07c5a:
    "Но в своём платье она всё равно элегантна и прекрасна."

# ch/harems_full/office/events/office_harem_common.rpy:2632
translate russian aletta_audrey_lavish_male_ending_3e02c880:
    "Одри держит букет прямо над округлившимся животом."

# ch/harems_full/office/events/office_harem_common.rpy:2633
translate russian aletta_audrey_lavish_male_ending_a76ee6d1:
    "Словно хочет показать его всему миру."

# ch/harems_full/office/events/office_harem_common.rpy:2634
translate russian aletta_audrey_lavish_male_ending_8fa30085:
    "Стоило догадаться, что она будет такой смелой и ничуть не смущённой!"

# ch/harems_full/office/events/office_harem_common.rpy:2636
translate russian aletta_audrey_lavish_male_ending_621b32f4:
    "Лавиш идёт ко мне с привычной спокойной уверенностью."

# ch/harems_full/office/events/office_harem_common.rpy:2637
translate russian aletta_audrey_lavish_male_ending_5c7a0c15:
    "Сдержанное платье лишь подчёркивает её красоту."

# ch/harems_full/office/events/office_harem_common.rpy:2638
translate russian aletta_audrey_lavish_male_ending_3c30d210:
    "Не понимаю, как ей удаётся сказать так много без единого слова."

# ch/harems_full/office/events/office_harem_common.rpy:2640
translate russian aletta_audrey_lavish_male_ending_443d5342:
    "Я почти забываю, что она беременна и это уже заметно."

# ch/harems_full/office/events/office_harem_common.rpy:2641
translate russian aletta_audrey_lavish_male_ending_1b0f172f:
    "Но тут вижу мягкий изгиб её живота."

# ch/harems_full/office/events/office_harem_common.rpy:2642
translate russian aletta_audrey_lavish_male_ending_463b28c3:
    "И вспоминаю, как сильно её люблю."

# ch/harems_full/office/events/office_harem_common.rpy:2643
translate russian aletta_audrey_lavish_male_ending_a0c4ba2c:
    "Когда девушки подходят к алтарю, я неловко отодвигаюсь."

# ch/harems_full/office/events/office_harem_common.rpy:2644
translate russian aletta_audrey_lavish_male_ending_3043fcb4:
    "Они одна за другой встают рядом, то и дело меняясь местами."

# ch/harems_full/office/events/office_harem_common.rpy:2645
translate russian aletta_audrey_lavish_male_ending_ac482e86:
    "Конечно, мы пытались разобраться со всем этим на недавней репетиции."

# ch/harems_full/office/events/office_harem_common.rpy:2646
translate russian aletta_audrey_lavish_male_ending_378f4c4f:
    "Но, думаю, все толкаются из-за волнения."

# ch/harems_full/office/events/office_harem_common.rpy:2647
translate russian aletta_audrey_lavish_male_ending_c5b3de92:
    "Когда места наконец хватает всем, мы обмениваемся улыбками и взглядами."

# ch/harems_full/office/events/office_harem_common.rpy:2648
translate russian aletta_audrey_lavish_male_ending_e0a1dc8d:
    "Вижу, что каждая девушка чувствует себя так же, как я."

# ch/harems_full/office/events/office_harem_common.rpy:2649
translate russian aletta_audrey_lavish_male_ending_e220e585:
    "Эта странная смесь восторга и почти страха, от которой трепещет всё внутри!"

# ch/harems_full/office/events/office_harem_common.rpy:2651
translate russian aletta_audrey_lavish_male_ending_2a3aa788:
    "Мы все разом смотрим на священника."

# ch/harems_full/office/events/office_harem_common.rpy:2652
translate russian aletta_audrey_lavish_male_ending_b515515b:
    "Он жестом показывает, что церемония начинается."

# ch/harems_full/office/events/office_harem_common.rpy:2653
translate russian aletta_audrey_lavish_male_ending_6475c777:
    "Я рад, что он так уверенно берёт всё в свои руки."

# ch/harems_full/office/events/office_harem_common.rpy:2654
translate russian aletta_audrey_lavish_male_ending_bb69a3eb:
    "Потому что мы сразу сосредотачиваемся и следуем указаниям."

# ch/harems_full/office/events/office_harem_common.rpy:2656
translate russian aletta_audrey_lavish_male_ending_d601e095:
    "Священник" "Мы собрались здесь сегодня..."

# ch/harems_full/office/events/office_harem_common.rpy:2657
translate russian aletta_audrey_lavish_male_ending_c0a13476:
    "Священник" "Чтобы соединить этих людей — и я действительно имею в виду ВСЕХ!"

# ch/harems_full/office/events/office_harem_common.rpy:2658
translate russian aletta_audrey_lavish_male_ending_d05a0e2d:
    "Среди гостей прокатывается смех в ответ на маленькую шутку."

# ch/harems_full/office/events/office_harem_common.rpy:2659
translate russian aletta_audrey_lavish_male_ending_36cf52b2:
    "Но священник продолжает, и все снова умолкают."

# ch/harems_full/office/events/office_harem_common.rpy:2660
translate russian aletta_audrey_lavish_male_ending_20520034:
    "Священник" "Священными узами брака..."

# ch/harems_full/office/events/office_harem_common.rpy:2661
translate russian aletta_audrey_lavish_male_ending_22fe795c:
    "Остальная церемония проходит примерно так, как вы и представляете."

# ch/harems_full/office/events/office_harem_common.rpy:2662
translate russian aletta_audrey_lavish_male_ending_f3f3e6b5:
    "А чего вы ожидали?"

# ch/harems_full/office/events/office_harem_common.rpy:2663
translate russian aletta_audrey_lavish_male_ending_bb5a9817:
    "Призыва демонов и жертвоприношения животных?"

# ch/harems_full/office/events/office_harem_common.rpy:2664
translate russian aletta_audrey_lavish_male_ending_9b5d2ac7:
    "От обычной свадьбы отличается лишь то, что всё повторяют больше двух раз."

# ch/harems_full/office/events/office_harem_common.rpy:2665
translate russian aletta_audrey_lavish_male_ending_b9a1186d:
    "Священник" "Согласны ли вы, Алетта, вступить с этими людьми..."

# ch/harems_full/office/events/office_harem_common.rpy:2666
translate russian aletta_audrey_lavish_male_ending_8c7361cd:
    "Священник" "В законный брак?"

# ch/harems_full/office/events/office_harem_common.rpy:2669
translate russian aletta_audrey_lavish_male_ending_5af96bc2:
    "Священник" "Согласны ли вы, Одри, вступить с этими людьми..."

# ch/harems_full/office/events/office_harem_common.rpy:2670
translate russian aletta_audrey_lavish_male_ending_8c7361cd_1:
    "Священник" "В законный брак?"

# ch/harems_full/office/events/office_harem_common.rpy:2672
translate russian aletta_audrey_lavish_male_ending_944edfac:
    audrey.say "Согласна."

# ch/harems_full/office/events/office_harem_common.rpy:2673
translate russian aletta_audrey_lavish_male_ending_95513d99:
    "Священник" "Согласны ли вы, Лавиш, вступить с этими людьми..."

# ch/harems_full/office/events/office_harem_common.rpy:2674
translate russian aletta_audrey_lavish_male_ending_8c7361cd_2:
    "Священник" "В законный брак?"

# ch/harems_full/office/events/office_harem_common.rpy:2676
translate russian aletta_audrey_lavish_male_ending_12994482:
    lavish.say "Согласна."

# ch/harems_full/office/events/office_harem_common.rpy:2677
translate russian aletta_audrey_lavish_male_ending_f732b602:
    "Священник" "И наконец..."

# ch/harems_full/office/events/office_harem_common.rpy:2678
translate russian aletta_audrey_lavish_male_ending_a9301f98:
    "Священник" "Согласны ли вы, [lssb_common.hero_name()], вступить с этими людьми..."

# ch/harems_full/office/events/office_harem_common.rpy:2679
translate russian aletta_audrey_lavish_male_ending_8c7361cd_3:
    "Священник" "В законный брак?"

# ch/harems_full/office/events/office_harem_common.rpy:2680
translate russian aletta_audrey_lavish_male_ending_cc481164:
    mike.say "Согласен."

# ch/harems_full/office/events/office_harem_common.rpy:2681
translate russian aletta_audrey_lavish_male_ending_c088e303:
    "Священник кивает и на миг переводит дух."

# ch/harems_full/office/events/office_harem_common.rpy:2682
translate russian aletta_audrey_lavish_male_ending_58c83231:
    "Священник" "Обращаюсь ко всем присутствующим..."

# ch/harems_full/office/events/office_harem_common.rpy:2683
translate russian aletta_audrey_lavish_male_ending_34d3fae8:
    "Священник" "Если кому-то известна законная причина, по которой эти люди не могут заключить брак..."

# ch/harems_full/office/events/office_harem_common.rpy:2684
translate russian aletta_audrey_lavish_male_ending_713d080b:
    "Священник" "Скажите сейчас или молчите вечно!"

# ch/harems_full/office/events/office_harem_common.rpy:2685
translate russian aletta_audrey_lavish_male_ending_59eeee8b:
    "Повисает привычная пауза: гости посмеиваются и оглядываются."

# ch/harems_full/office/events/office_harem_common.rpy:2686
translate russian aletta_audrey_lavish_male_ending_2bdc3a2c:
    "Может, они ждут, что сейчас в часовню ворвётся армия разгневанных бывших."

# ch/harems_full/office/events/office_harem_common.rpy:2687
translate russian aletta_audrey_lavish_male_ending_96cf9a58:
    "Но, к счастью, ничего столь невероятного не происходит."

# ch/harems_full/office/events/office_harem_common.rpy:2688
translate russian aletta_audrey_lavish_male_ending_e054f310:
    "Священник" "Что ж..."

# ch/harems_full/office/events/office_harem_common.rpy:2689
translate russian aletta_audrey_lavish_male_ending_7d5acc60:
    "Священник" "Объявляю вас супругами."

# ch/harems_full/office/events/office_harem_common.rpy:2690
translate russian aletta_audrey_lavish_male_ending_64235e41:
    "Священник" "Можете... эм..."

# ch/harems_full/office/events/office_harem_common.rpy:2691
translate russian aletta_audrey_lavish_male_ending_9751f813:
    "Священник" "Ну... сделать что-нибудь подобающее случаю!"

# ch/harems_full/office/events/office_harem_common.rpy:2692
translate russian aletta_audrey_lavish_male_ending_c2d44e57:
    "На этих словах священника мы все обнимаемся."

# ch/harems_full/office/events/office_harem_common.rpy:2693
translate russian aletta_audrey_lavish_male_ending_d4a89fae:
    "Переплетая руки и прижимаясь друг к другу."

# ch/harems_full/office/events/office_harem_common.rpy:2694
translate russian aletta_audrey_lavish_male_ending_7f03cb6b:
    "Наверное, наши отношения чем-то на это похожи."

# ch/harems_full/office/events/office_harem_common.rpy:2695
translate russian aletta_audrey_lavish_male_ending_4c722292:
    "Мы не всегда понимаем, как всё должно быть устроено."

# ch/harems_full/office/events/office_harem_common.rpy:2696
translate russian aletta_audrey_lavish_male_ending_c64d880a:
    "Но чувствуем, что нам хорошо вместе, и только это по-настоящему важно."

# ch/harems_full/office/events/office_harem_common.rpy:2699
translate russian aletta_audrey_lavish_male_ending_fb135262:
    aletta.say "Было бы лучше, если бы с самого начала всё было так."

# ch/harems_full/office/events/office_harem_common.rpy:2700
translate russian aletta_audrey_lavish_male_ending_3fee3f60:
    aletta.say "В самом деле, вы думаете, [lssb_common.hero_name()] всегда будет совершенно честен?"

# ch/harems_full/office/events/office_harem_common.rpy:2701
translate russian aletta_audrey_lavish_male_ending_0bee8452:
    aletta.say "Нам-то известно, что его словам не всегда можно верить."

# ch/harems_full/office/events/office_harem_common.rpy:2702
translate russian aletta_audrey_lavish_male_ending_18edf2c6:
    aletta.say "В конце концов, мы видели содержимое его трусов после того, как он его нам описывал!"

# ch/harems_full/office/events/office_harem_common.rpy:2703
translate russian aletta_audrey_lavish_male_ending_db6b1ec4:
    audrey.say "Я бы и сама со всем справилась. [lssb_common.hero_name()] мог бы вообще не участвовать."

# ch/harems_full/office/events/office_harem_common.rpy:2704
translate russian aletta_audrey_lavish_male_ending_3bf1fee5:
    audrey.say "Вообще-то и ваше участие необязательно."

# ch/harems_full/office/events/office_harem_common.rpy:2705
translate russian aletta_audrey_lavish_male_ending_f555ec5b:
    audrey.say "Никто из вас не расскажет так хорошо, как я."

# ch/harems_full/office/events/office_harem_common.rpy:2706
translate russian aletta_audrey_lavish_male_ending_452dc528:
    lavish.say "Я просто обязана была высказаться, пусть даже под конец истории."

# ch/harems_full/office/events/office_harem_common.rpy:2707
translate russian aletta_audrey_lavish_male_ending_7513fa12:
    lavish.say "И не думайте, что моя любовь куда-то делась: [lssb_common.hero_name()] и все вы мне по-прежнему дороги."

# ch/harems_full/office/events/office_harem_common.rpy:2708
translate russian aletta_audrey_lavish_male_ending_1b407c2a:
    lavish.say "Но я всё-таки самая надёжная и честная из всех участников!"

# ch/harems_full/office/events/office_harem_common.rpy:2709
translate russian aletta_audrey_lavish_male_ending_e32e38b6:
    aletta.say "Может, начнём с начала?"

# ch/harems_full/office/events/office_harem_common.rpy:2710
translate russian aletta_audrey_lavish_male_ending_d4ce6e65:
    aletta.say "[lssb_common.hero_name()] работал подо мной, когда мы познакомились в офисе. Простите за столь очевидную двусмысленность!"

# ch/harems_full/office/events/office_harem_common.rpy:2711
translate russian aletta_audrey_lavish_male_ending_da247318:
    aletta.say "Поначалу он меня не впечатлил, хотя говорят, что мне трудно угодить."

# ch/harems_full/office/events/office_harem_common.rpy:2712
translate russian aletta_audrey_lavish_male_ending_ec759ec2:
    audrey.say "Да, обычно я ненавижу мужчин, под которыми приходится... работать!"

# ch/harems_full/office/events/office_harem_common.rpy:2713
translate russian aletta_audrey_lavish_male_ending_63750b5e:
    audrey.say "И была почти уверена, что [lssb_common.hero_name()] окажется таким же."

# ch/harems_full/office/events/office_harem_common.rpy:2714
translate russian aletta_audrey_lavish_male_ending_a74f7b23:
    audrey.say "Но особо не переживала: таким парням я всегда устраиваю ад!"

# ch/harems_full/office/events/office_harem_common.rpy:2715
translate russian aletta_audrey_lavish_male_ending_c3b96b26:
    lavish.say "Когда [lssb_common.hero_name()] стал моим начальником, у меня были сомнения."

# ch/harems_full/office/events/office_harem_common.rpy:2716
translate russian aletta_audrey_lavish_male_ending_80fb32ff:
    lavish.say "Я привыкла к профессиональной обстановке и целеустремлённым коллегам."

# ch/harems_full/office/events/office_harem_common.rpy:2717
translate russian aletta_audrey_lavish_male_ending_b08e7a01:
    lavish.say "А он казался... ну, немного раздолбаем!"

# ch/harems_full/office/events/office_harem_common.rpy:2718
translate russian aletta_audrey_lavish_male_ending_278dc089:
    aletta.say "Но должна признать: он доказал, что я ошибалась."

# ch/harems_full/office/events/office_harem_common.rpy:2719
translate russian aletta_audrey_lavish_male_ending_1257bf5f:
    aletta.say "В том смысле, что как человек оказался приятнее, чем я ожидала."

# ch/harems_full/office/events/office_harem_common.rpy:2720
translate russian aletta_audrey_lavish_male_ending_7b99ac54:
    aletta.say "А вот в работе он, откровенно говоря, безнадёжен без моей поддержки!"

# ch/harems_full/office/events/office_harem_common.rpy:2721
translate russian aletta_audrey_lavish_male_ending_4049420f:
    audrey.say "[lssb_common.hero_name()] стал жертвой моих обычных изощрённых издевательств."

# ch/harems_full/office/events/office_harem_common.rpy:2722
translate russian aletta_audrey_lavish_male_ending_20525bae:
    audrey.say "И, чёрт возьми, мне это начало нравиться."

# ch/harems_full/office/events/office_harem_common.rpy:2723
translate russian aletta_audrey_lavish_male_ending_51ff6098:
    audrey.say "То есть больше обычного, больше, чем просто смотреть на его мучения!"

# ch/harems_full/office/events/office_harem_common.rpy:2724
translate russian aletta_audrey_lavish_male_ending_0a4e7805:
    lavish.say "Не могу сказать, что [lssb_common.hero_name()] опроверг мои первые впечатления."

# ch/harems_full/office/events/office_harem_common.rpy:2725
translate russian aletta_audrey_lavish_male_ending_e94e0cc3:
    lavish.say "Но вскоре выяснилось, что он гораздо лучше умеет дружить, чем делать карьеру!"

# ch/harems_full/office/events/office_harem_common.rpy:2726
translate russian aletta_audrey_lavish_male_ending_935e27cf:
    lavish.say "Наверное, тогда я и начала видеть в нём не только коллегу."

# ch/harems_full/office/events/office_harem_common.rpy:2727
translate russian aletta_audrey_lavish_male_ending_13bfef04:
    aletta.say "Не успела оглянуться, как мы уже общались вне работы!"

# ch/harems_full/office/events/office_harem_common.rpy:2728
translate russian aletta_audrey_lavish_male_ending_1162e5bd:
    aletta.say "Сама виновата: нужно было внимательнее следить за статусом наших отношений."

# ch/harems_full/office/events/office_harem_common.rpy:2729
translate russian aletta_audrey_lavish_male_ending_af140e8f:
    aletta.say "Но было уже поздно: [lssb_common.hero_name()] сумел втереться ко мне в сердце!"

# ch/harems_full/office/events/office_harem_common.rpy:2730
translate russian aletta_audrey_lavish_male_ending_ef76f68c:
    audrey.say "Вот так он меня и поймал: мне было слишком весело!"

# ch/harems_full/office/events/office_harem_common.rpy:2731
translate russian aletta_audrey_lavish_male_ending_33cfb592:
    audrey.say "Я и понять ничего не успела, как уже сама возвращалась за новой порцией."

# ch/harems_full/office/events/office_harem_common.rpy:2732
translate russian aletta_audrey_lavish_male_ending_7d9f90fe:
    audrey.say "И дня не могла прожить, не подразнив его, хотя бы ради реакции!"

# ch/harems_full/office/events/office_harem_common.rpy:2733
translate russian aletta_audrey_lavish_male_ending_8eda7546:
    lavish.say "Ах... наверное, с самого начала стоило держаться с ним профессиональнее."

# ch/harems_full/office/events/office_harem_common.rpy:2734
translate russian aletta_audrey_lavish_male_ending_b33ee2f9:
    lavish.say "Я не следила за границей между работой и удовольствием."

# ch/harems_full/office/events/office_harem_common.rpy:2735
translate russian aletta_audrey_lavish_male_ending_831ad9f1:
    lavish.say "И вскоре он стал больше чем коллегой и уж точно больше чем другом!"

# ch/harems_full/office/events/office_harem_common.rpy:2736
translate russian aletta_audrey_lavish_male_ending_ae7dde37:
    aletta.say "После этого мы словно начали вместе подниматься по карьерной лестнице."

# ch/harems_full/office/events/office_harem_common.rpy:2737
translate russian aletta_audrey_lavish_male_ending_c9d219a5:
    aletta.say "Чем серьёзнее становились наши отношения, тем успешнее [lssb_common.hero_name()] и я работали."

# ch/harems_full/office/events/office_harem_common.rpy:2738
translate russian aletta_audrey_lavish_male_ending_8f0d010a:
    aletta.say "Не успела оглянуться, как мы оказались на самой вершине!"

# ch/harems_full/office/events/office_harem_common.rpy:2739
translate russian aletta_audrey_lavish_male_ending_19e4825a:
    audrey.say "Ещё никто из тех, над кем я издевалась, не начинал получать повышения!"

# ch/harems_full/office/events/office_harem_common.rpy:2740
translate russian aletta_audrey_lavish_male_ending_2a530e68:
    audrey.say "Но чем ближе становились наши отношения, тем успешнее был [lssb_common.hero_name()]."

# ch/harems_full/office/events/office_harem_common.rpy:2741
translate russian aletta_audrey_lavish_male_ending_de1eb4f3:
    audrey.say "Вскоре он уже сидел на самой верхушке!"

# ch/harems_full/office/events/office_harem_common.rpy:2742
translate russian aletta_audrey_lavish_male_ending_2a835dff:
    lavish.say "[lssb_common.hero_name()] сделал меня счастливой в личной жизни. По-настоящему счастливой!"

# ch/harems_full/office/events/office_harem_common.rpy:2743
translate russian aletta_audrey_lavish_male_ending_07275f12:
    lavish.say "А я, кажется, положительно влияла на его профессиональную жизнь."

# ch/harems_full/office/events/office_harem_common.rpy:2744
translate russian aletta_audrey_lavish_male_ending_79a567f7:
    lavish.say "Наверное, научила его работать эффективнее, раз его начали повышать!"

# ch/harems_full/office/events/office_harem_common.rpy:2745
translate russian aletta_audrey_lavish_male_ending_72e6e505:
    aletta.say "Не скажу, что обрадовалась, узнав, что наши отношения не совсем исключительные."

# ch/harems_full/office/events/office_harem_common.rpy:2746
translate russian aletta_audrey_lavish_male_ending_e30fd0c6:
    aletta.say "Но затем начала смотреть на всё это как на бизнес, понимаете?"

# ch/harems_full/office/events/office_harem_common.rpy:2747
translate russian aletta_audrey_lavish_male_ending_89a3cbeb:
    aletta.say "Партнёрство — хорошо, но компания с большим числом сотрудников ещё лучше."

# ch/harems_full/office/events/office_harem_common.rpy:2748
translate russian aletta_audrey_lavish_male_ending_20b05590:
    aletta.say "И мне по-прежнему нравится считать себя старшим партнёром!"

# ch/harems_full/office/events/office_harem_common.rpy:2749
translate russian aletta_audrey_lavish_male_ending_101688db:
    audrey.say "Да, я немного обалдела, узнав, что [lssb_common.hero_name()] встречается и с другими девушками в офисе."

# ch/harems_full/office/events/office_harem_common.rpy:2750
translate russian aletta_audrey_lavish_male_ending_584b7d13:
    audrey.say "Обычно это я всех шокирую, понимаете?"

# ch/harems_full/office/events/office_harem_common.rpy:2751
translate russian aletta_audrey_lavish_male_ending_b723cbd8:
    audrey.say "Но больше участников — больше возможностей повеселиться!"

# ch/harems_full/office/events/office_harem_common.rpy:2752
translate russian aletta_audrey_lavish_male_ending_1c508feb:
    lavish.say "Мне не нравилось, что [lssb_common.hero_name()] и я встречаемся не только друг с другом."

# ch/harems_full/office/events/office_harem_common.rpy:2753
translate russian aletta_audrey_lavish_male_ending_88cd0374:
    lavish.say "Но потом я подумала и увидела преимущества."

# ch/harems_full/office/events/office_harem_common.rpy:2754
translate russian aletta_audrey_lavish_male_ending_33be693a:
    lavish.say "Во многом так эффективнее и гибче. И НАМНОГО увлекательнее!"

# ch/harems_full/office/events/office_harem_common.rpy:2755
translate russian aletta_audrey_lavish_male_ending_f3b7f09a:
    aletta.say "К моему удивлению, всё сложилось довольно хорошо."

# ch/harems_full/office/events/office_harem_common.rpy:2756
translate russian aletta_audrey_lavish_male_ending_9fc26d54:
    aletta.say "Мы в основном ладили и стали единым целым."

# ch/harems_full/office/events/office_harem_common.rpy:2757
translate russian aletta_audrey_lavish_male_ending_df89c038:
    aletta.say "Настолько хорошо, что брак показался следующим логичным шагом."

# ch/harems_full/office/events/office_harem_common.rpy:2758
translate russian aletta_audrey_lavish_male_ending_0092b8b7:
    audrey.say "Поверьте, я никогда не думала, что выйду замуж даже за одного человека."

# ch/harems_full/office/events/office_harem_common.rpy:2759
translate russian aletta_audrey_lavish_male_ending_059e8d07:
    audrey.say "Так могла ли я представить брак сразу с несколькими?!"

# ch/harems_full/office/events/office_harem_common.rpy:2760
translate russian aletta_audrey_lavish_male_ending_c0246911:
    audrey.say "Ну... может, я именно поэтому и согласилась: идея-то безумная!"

# ch/harems_full/office/events/office_harem_common.rpy:2761
translate russian aletta_audrey_lavish_male_ending_f9b87953:
    lavish.say "Знаю, как безумно звучит желание пожениться со всеми, с кем я спала."

# ch/harems_full/office/events/office_harem_common.rpy:2762
translate russian aletta_audrey_lavish_male_ending_d56a140d:
    lavish.say "Но вы должны понять: всё складывалось очень хорошо."

# ch/harems_full/office/events/office_harem_common.rpy:2763
translate russian aletta_audrey_lavish_male_ending_be296e69:
    lavish.say "Иногда и одного подходящего партнёра найти — удача, не говоря уже о нескольких!"

# ch/harems_full/office/events/office_harem_common.rpy:2764
translate russian aletta_audrey_lavish_male_ending_214c32e2:
    aletta.say "И теперь, когда мы воплотили это в жизнь, всё по-прежнему получается."

# ch/harems_full/office/events/office_harem_common.rpy:2765
translate russian aletta_audrey_lavish_male_ending_43600446:
    aletta.say "Мы команда и дома, и в офисе. На каждом шагу действуем сообща."

# ch/harems_full/office/events/office_harem_common.rpy:2766
translate russian aletta_audrey_lavish_male_ending_0f5cba8b:
    aletta.say "Рядом все, кто помогает мне оставаться сильной и собранной. Чего ещё желать?"

# ch/harems_full/office/events/office_harem_common.rpy:2767
translate russian aletta_audrey_lavish_male_ending_c660529e:
    audrey.say "Все говорят, что после свадьбы я стала спокойнее и остепенилась."

# ch/harems_full/office/events/office_harem_common.rpy:2768
translate russian aletta_audrey_lavish_male_ending_697d0dbb:
    audrey.say "И знаете, что меня в этом больше всего бесит? То, что они вроде бы правы."

# ch/harems_full/office/events/office_harem_common.rpy:2769
translate russian aletta_audrey_lavish_male_ending_96b577b4:
    audrey.say "Рядом столько людей, о которых я могу заботиться и которые заботятся обо мне, — я уже не такая злая, как раньше!"

# ch/harems_full/office/events/office_harem_common.rpy:2770
translate russian aletta_audrey_lavish_male_ending_b011dd69:
    lavish.say "Я всегда была готова пожертвовать замужеством ради карьеры."

# ch/harems_full/office/events/office_harem_common.rpy:2771
translate russian aletta_audrey_lavish_male_ending_15811ba1:
    lavish.say "Но теперь, когда я замужем, понимаю, что выбирать необязательно."

# ch/harems_full/office/events/office_harem_common.rpy:2772
translate russian aletta_audrey_lavish_male_ending_15455b40:
    lavish.say "Ведь рядом все, кого я люблю, и они готовы меня поддержать!"

# ch/harems_full/office/events/office_harem_common.rpy:2773
translate russian aletta_audrey_lavish_male_ending_e182316e:
    aletta.say "Так что будущее у нас светлое, и мне не терпится узнать, что оно готовит!"

# ch/harems_full/office/events/office_harem_common.rpy:2774
translate russian aletta_audrey_lavish_male_ending_3e7ffed2:
    audrey.say "Впереди нас ждёт много интересного!"

# ch/harems_full/office/events/office_harem_common.rpy:2775
translate russian aletta_audrey_lavish_male_ending_3a6c24a1:
    lavish.say "Кто знает, как высоко мы сможем подняться и как далеко зайти вместе!"

# ch/harems_full/office/events/office_harem_common.rpy:2776
translate russian aletta_audrey_lavish_male_ending_c1dcf20d:
    shiori.say "Теперь у меня наконец есть семья, о которой я всегда мечтала!"

# ch/harems_full/office/events/office_harem_common.rpy:2783
translate russian lavish_shiori_male_ending_163e3150:
    "Знаете, я уже даже не помню, какие планы строил, когда устроился на нынешнюю работу."

# ch/harems_full/office/events/office_harem_common.rpy:2784
translate russian lavish_shiori_male_ending_afe3281b:
    "Собирался ли подниматься по карьерной лестнице так высоко, как смогу."

# ch/harems_full/office/events/office_harem_common.rpy:2785
translate russian lavish_shiori_male_ending_94c63a64:
    "Или просто хотел оплачивать счета, пока не найдётся что-то получше."

# ch/harems_full/office/events/office_harem_common.rpy:2786
translate russian lavish_shiori_male_ending_24743f63:
    "Но точно не думал встретить там будущих спутниц жизни!"

# ch/harems_full/office/events/office_harem_common.rpy:2787
translate russian lavish_shiori_male_ending_687b5cb6:
    "Насколько помню, я просто собирался немного повеселиться в офисе."

# ch/harems_full/office/events/office_harem_common.rpy:2788
translate russian lavish_shiori_male_ending_09d11206:
    "Ну, бездельничать и снимать рабочий стресс приятным общением с коллегами."

# ch/harems_full/office/events/office_harem_common.rpy:2789
translate russian lavish_shiori_male_ending_6c102b68:
    "Но одно потянулось за другим, и вот я здесь."

# ch/harems_full/office/events/office_harem_common.rpy:2790
translate russian lavish_shiori_male_ending_822fefa7:
    "Стою у алтаря и жду, когда те самые коллеги присоединятся ко мне."

# ch/harems_full/office/events/office_harem_common.rpy:2791
translate russian lavish_shiori_male_ending_1e6bb361:
    "Никогда бы не предположил, что всё закончится свадьбой."

# ch/harems_full/office/events/office_harem_common.rpy:2792
translate russian lavish_shiori_male_ending_3f238e55:
    "Тем более сразу с несколькими девушками с работы!"

# ch/harems_full/office/events/office_harem_common.rpy:2793
translate russian lavish_shiori_male_ending_0e3e2a13:
    "Не то чтобы я жаловался, понимаете?"

# ch/harems_full/office/events/office_harem_common.rpy:2794
translate russian lavish_shiori_male_ending_1cf1fe8c:
    "Я очень рад оказаться здесь."

# ch/harems_full/office/events/office_harem_common.rpy:2795
translate russian lavish_shiori_male_ending_a16093fe:
    "Просто сейчас моя жизнь напоминает американские горки!"

# ch/harems_full/office/events/office_harem_common.rpy:2796
translate russian lavish_shiori_male_ending_72c660cb:
    "Чтобы отвлечься, я оглядываю часовню."

# ch/harems_full/office/events/office_harem_common.rpy:2797
translate russian lavish_shiori_male_ending_62bccaf4:
    "Она красиво украшена, и это уже само по себе чудо."

# ch/harems_full/office/events/office_harem_common.rpy:2798
translate russian lavish_shiori_male_ending_4dcbc715:
    "Поверьте, когда оформление выбирает больше одной девушки, споры бывают жаркими!"

# ch/harems_full/office/events/office_harem_common.rpy:2799
translate russian lavish_shiori_male_ending_2d7ce45a:
    "Скамьи переполнены гостями — тоже ожидаемо, когда невест несколько."

# ch/harems_full/office/events/office_harem_common.rpy:2800
translate russian lavish_shiori_male_ending_f7ea0744:
    "Оглядывая ряд за рядом, я узнаю некоторые обращённые ко мне лица."

# ch/harems_full/office/events/office_harem_common.rpy:2801
translate russian lavish_shiori_male_ending_86f39f93:
    "Но разве можно знать здесь всех?"

# ch/harems_full/office/events/office_harem_common.rpy:2802
translate russian lavish_shiori_male_ending_03c31662:
    "Каждый участник свадьбы привёл целую толпу своих гостей."

# ch/harems_full/office/events/office_harem_common.rpy:2803
translate russian lavish_shiori_male_ending_de9f50a4:
    "Разобраться, кто к кому относится, почти невозможно!"

# ch/harems_full/office/events/office_harem_common.rpy:2804
translate russian lavish_shiori_male_ending_ccf5169a:
    "Я уже думаю попросить у девушек фотографии родственников с пояснениями."

# ch/harems_full/office/events/office_harem_common.rpy:2805
translate russian lavish_shiori_male_ending_f4e85421:
    "И тут часовню наполняет музыка."

# ch/harems_full/office/events/office_harem_common.rpy:2806
translate russian lavish_shiori_male_ending_29c59cdd:
    "Разумеется, я тут же прихожу в себя и выпрямляюсь почти по стойке смирно."

# ch/harems_full/office/events/office_harem_common.rpy:2807
translate russian lavish_shiori_male_ending_4ba2f2ee:
    "Как я могу не узнать эту музыку и не понять, что она означает?"

# ch/harems_full/office/events/office_harem_common.rpy:2808
translate russian lavish_shiori_male_ending_7f5b0022:
    "Я ведь сам оказался в центре споров о том, под что они пойдут к алтарю!"

# ch/harems_full/office/events/office_harem_common.rpy:2809
translate russian lavish_shiori_male_ending_be3eda7a:
    "Но воспоминания о последней ссоре и достигнутом компромиссе вдруг исчезают."

# ch/harems_full/office/events/office_harem_common.rpy:2810
translate russian lavish_shiori_male_ending_19827532:
    "Потому что я вижу только девушек, которые входят в часовню и идут по проходу."

# ch/harems_full/office/events/office_harem_common.rpy:2812
translate russian lavish_shiori_male_ending_621b32f4:
    "Лавиш идёт ко мне с привычной спокойной уверенностью."

# ch/harems_full/office/events/office_harem_common.rpy:2813
translate russian lavish_shiori_male_ending_5c7a0c15:
    "Сдержанное платье лишь подчёркивает её красоту."

# ch/harems_full/office/events/office_harem_common.rpy:2814
translate russian lavish_shiori_male_ending_3c30d210:
    "Не понимаю, как ей удаётся сказать так много без единого слова."

# ch/harems_full/office/events/office_harem_common.rpy:2816
translate russian lavish_shiori_male_ending_443d5342:
    "Я почти забываю, что она беременна и это уже заметно."

# ch/harems_full/office/events/office_harem_common.rpy:2817
translate russian lavish_shiori_male_ending_1b0f172f:
    "Но тут вижу мягкий изгиб её живота."

# ch/harems_full/office/events/office_harem_common.rpy:2818
translate russian lavish_shiori_male_ending_463b28c3:
    "И вспоминаю, как сильно её люблю."

# ch/harems_full/office/events/office_harem_common.rpy:2820
translate russian lavish_shiori_male_ending_44563d73:
    "Сиори идёт последней, но именно на ней я дольше всего задерживаю взгляд."

# ch/harems_full/office/events/office_harem_common.rpy:2821
translate russian lavish_shiori_male_ending_0a48bf25:
    "Конечно, в своём платье она просто прекрасна."

# ch/harems_full/office/events/office_harem_common.rpy:2822
translate russian lavish_shiori_male_ending_7efc02d1:
    "Но важнее всего для меня то, что она улыбается."

# ch/harems_full/office/events/office_harem_common.rpy:2823
translate russian lavish_shiori_male_ending_ade0bdc1:
    "И я чувствую прилив счастья, зная, что она тоже счастлива."

# ch/harems_full/office/events/office_harem_common.rpy:2825
translate russian lavish_shiori_male_ending_71a6d072:
    "Может, дело ещё и в виде её живота?"

# ch/harems_full/office/events/office_harem_common.rpy:2826
translate russian lavish_shiori_male_ending_2f4773ce:
    "Мы одновременно женимся и начинаем новую семью."

# ch/harems_full/office/events/office_harem_common.rpy:2827
translate russian lavish_shiori_male_ending_bd9dd1ec:
    "Для всех нас это и правда начало новой жизни!"

# ch/harems_full/office/events/office_harem_common.rpy:2828
translate russian lavish_shiori_male_ending_a0c4ba2c:
    "Когда девушки подходят к алтарю, я неловко отодвигаюсь."

# ch/harems_full/office/events/office_harem_common.rpy:2829
translate russian lavish_shiori_male_ending_3043fcb4:
    "Они одна за другой встают рядом, то и дело меняясь местами."

# ch/harems_full/office/events/office_harem_common.rpy:2830
translate russian lavish_shiori_male_ending_ac482e86:
    "Конечно, мы пытались разобраться со всем этим на недавней репетиции."

# ch/harems_full/office/events/office_harem_common.rpy:2831
translate russian lavish_shiori_male_ending_378f4c4f:
    "Но, думаю, все толкаются из-за волнения."

# ch/harems_full/office/events/office_harem_common.rpy:2832
translate russian lavish_shiori_male_ending_c5b3de92:
    "Когда места наконец хватает всем, мы обмениваемся улыбками и взглядами."

# ch/harems_full/office/events/office_harem_common.rpy:2833
translate russian lavish_shiori_male_ending_e0a1dc8d:
    "Вижу, что каждая девушка чувствует себя так же, как я."

# ch/harems_full/office/events/office_harem_common.rpy:2834
translate russian lavish_shiori_male_ending_e220e585:
    "Эта странная смесь восторга и почти страха, от которой трепещет всё внутри!"

# ch/harems_full/office/events/office_harem_common.rpy:2836
translate russian lavish_shiori_male_ending_2a3aa788:
    "Мы все разом смотрим на священника."

# ch/harems_full/office/events/office_harem_common.rpy:2837
translate russian lavish_shiori_male_ending_b515515b:
    "Он жестом показывает, что церемония начинается."

# ch/harems_full/office/events/office_harem_common.rpy:2838
translate russian lavish_shiori_male_ending_6475c777:
    "Я рад, что он так уверенно берёт всё в свои руки."

# ch/harems_full/office/events/office_harem_common.rpy:2839
translate russian lavish_shiori_male_ending_bb69a3eb:
    "Потому что мы сразу сосредотачиваемся и следуем указаниям."

# ch/harems_full/office/events/office_harem_common.rpy:2841
translate russian lavish_shiori_male_ending_d601e095:
    "Священник" "Мы собрались здесь сегодня..."

# ch/harems_full/office/events/office_harem_common.rpy:2842
translate russian lavish_shiori_male_ending_c0a13476:
    "Священник" "Чтобы соединить этих людей — и я действительно имею в виду ВСЕХ!"

# ch/harems_full/office/events/office_harem_common.rpy:2843
translate russian lavish_shiori_male_ending_d05a0e2d:
    "Среди гостей прокатывается смех в ответ на маленькую шутку."

# ch/harems_full/office/events/office_harem_common.rpy:2844
translate russian lavish_shiori_male_ending_36cf52b2:
    "Но священник продолжает, и все снова умолкают."

# ch/harems_full/office/events/office_harem_common.rpy:2845
translate russian lavish_shiori_male_ending_20520034:
    "Священник" "Священными узами брака..."

# ch/harems_full/office/events/office_harem_common.rpy:2846
translate russian lavish_shiori_male_ending_22fe795c:
    "Остальная церемония проходит примерно так, как вы и представляете."

# ch/harems_full/office/events/office_harem_common.rpy:2847
translate russian lavish_shiori_male_ending_f3f3e6b5:
    "А чего вы ожидали?"

# ch/harems_full/office/events/office_harem_common.rpy:2848
translate russian lavish_shiori_male_ending_bb5a9817:
    "Призыва демонов и жертвоприношения животных?"

# ch/harems_full/office/events/office_harem_common.rpy:2849
translate russian lavish_shiori_male_ending_9b5d2ac7:
    "От обычной свадьбы отличается лишь то, что всё повторяют больше двух раз."

# ch/harems_full/office/events/office_harem_common.rpy:2850
translate russian lavish_shiori_male_ending_95513d99:
    "Священник" "Согласны ли вы, Лавиш, вступить с этими людьми..."

# ch/harems_full/office/events/office_harem_common.rpy:2851
translate russian lavish_shiori_male_ending_8c7361cd:
    "Священник" "В законный брак?"

# ch/harems_full/office/events/office_harem_common.rpy:2853
translate russian lavish_shiori_male_ending_12994482:
    lavish.say "Согласна."

# ch/harems_full/office/events/office_harem_common.rpy:2854
translate russian lavish_shiori_male_ending_c5007986:
    "Священник" "Согласны ли вы, Сиори, вступить с этими людьми..."

# ch/harems_full/office/events/office_harem_common.rpy:2855
translate russian lavish_shiori_male_ending_8c7361cd_1:
    "Священник" "В законный брак?"

# ch/harems_full/office/events/office_harem_common.rpy:2857
translate russian lavish_shiori_male_ending_d1bfdb33:
    shiori.say "Согласна."

# ch/harems_full/office/events/office_harem_common.rpy:2858
translate russian lavish_shiori_male_ending_f732b602:
    "Священник" "И наконец..."

# ch/harems_full/office/events/office_harem_common.rpy:2859
translate russian lavish_shiori_male_ending_a9301f98:
    "Священник" "Согласны ли вы, [lssb_common.hero_name()], вступить с этими людьми..."

# ch/harems_full/office/events/office_harem_common.rpy:2860
translate russian lavish_shiori_male_ending_8c7361cd_2:
    "Священник" "В законный брак?"

# ch/harems_full/office/events/office_harem_common.rpy:2861
translate russian lavish_shiori_male_ending_cc481164:
    mike.say "Согласен."

# ch/harems_full/office/events/office_harem_common.rpy:2862
translate russian lavish_shiori_male_ending_c088e303:
    "Священник кивает и на миг переводит дух."

# ch/harems_full/office/events/office_harem_common.rpy:2863
translate russian lavish_shiori_male_ending_58c83231:
    "Священник" "Обращаюсь ко всем присутствующим..."

# ch/harems_full/office/events/office_harem_common.rpy:2864
translate russian lavish_shiori_male_ending_34d3fae8:
    "Священник" "Если кому-то известна законная причина, по которой эти люди не могут заключить брак..."

# ch/harems_full/office/events/office_harem_common.rpy:2865
translate russian lavish_shiori_male_ending_713d080b:
    "Священник" "Скажите сейчас или молчите вечно!"

# ch/harems_full/office/events/office_harem_common.rpy:2866
translate russian lavish_shiori_male_ending_59eeee8b:
    "Повисает привычная пауза: гости посмеиваются и оглядываются."

# ch/harems_full/office/events/office_harem_common.rpy:2867
translate russian lavish_shiori_male_ending_2bdc3a2c:
    "Может, они ждут, что сейчас в часовню ворвётся армия разгневанных бывших."

# ch/harems_full/office/events/office_harem_common.rpy:2868
translate russian lavish_shiori_male_ending_96cf9a58:
    "Но, к счастью, ничего столь невероятного не происходит."

# ch/harems_full/office/events/office_harem_common.rpy:2869
translate russian lavish_shiori_male_ending_e054f310:
    "Священник" "Что ж..."

# ch/harems_full/office/events/office_harem_common.rpy:2870
translate russian lavish_shiori_male_ending_7d5acc60:
    "Священник" "Объявляю вас супругами."

# ch/harems_full/office/events/office_harem_common.rpy:2871
translate russian lavish_shiori_male_ending_64235e41:
    "Священник" "Можете... эм..."

# ch/harems_full/office/events/office_harem_common.rpy:2872
translate russian lavish_shiori_male_ending_9751f813:
    "Священник" "Ну... сделать что-нибудь подобающее случаю!"

# ch/harems_full/office/events/office_harem_common.rpy:2873
translate russian lavish_shiori_male_ending_c2d44e57:
    "На этих словах священника мы все обнимаемся."

# ch/harems_full/office/events/office_harem_common.rpy:2874
translate russian lavish_shiori_male_ending_d4a89fae:
    "Переплетая руки и прижимаясь друг к другу."

# ch/harems_full/office/events/office_harem_common.rpy:2875
translate russian lavish_shiori_male_ending_7f03cb6b:
    "Наверное, наши отношения чем-то на это похожи."

# ch/harems_full/office/events/office_harem_common.rpy:2876
translate russian lavish_shiori_male_ending_4c722292:
    "Мы не всегда понимаем, как всё должно быть устроено."

# ch/harems_full/office/events/office_harem_common.rpy:2877
translate russian lavish_shiori_male_ending_c64d880a:
    "Но чувствуем, что нам хорошо вместе, и только это по-настоящему важно."

# ch/harems_full/office/events/office_harem_common.rpy:2880
translate russian lavish_shiori_male_ending_452dc528:
    lavish.say "Я просто обязана была высказаться, пусть даже под конец истории."

# ch/harems_full/office/events/office_harem_common.rpy:2881
translate russian lavish_shiori_male_ending_7513fa12:
    lavish.say "И не думайте, что моя любовь куда-то делась: [lssb_common.hero_name()] и все вы мне по-прежнему дороги."

# ch/harems_full/office/events/office_harem_common.rpy:2882
translate russian lavish_shiori_male_ending_1b407c2a:
    lavish.say "Но я всё-таки самая надёжная и честная из всех участников!"

# ch/harems_full/office/events/office_harem_common.rpy:2883
translate russian lavish_shiori_male_ending_16de9855:
    shiori.say "Я... я не знаю, стоит ли нам это делать, когда [lssb_common.hero_name()] не здесь!"

# ch/harems_full/office/events/office_harem_common.rpy:2884
translate russian lavish_shiori_male_ending_93d00ac6:
    shiori.say "Ведь без него ничего этого вообще бы не было, правда?"

# ch/harems_full/office/events/office_harem_common.rpy:2885
translate russian lavish_shiori_male_ending_58f159c1:
    shiori.say "Ох... надеюсь, он не расстроится из-за того, что все о нём говорят!"

# ch/harems_full/office/events/office_harem_common.rpy:2886
translate russian lavish_shiori_male_ending_c3b96b26:
    lavish.say "Когда [lssb_common.hero_name()] стал моим начальником, у меня были сомнения."

# ch/harems_full/office/events/office_harem_common.rpy:2887
translate russian lavish_shiori_male_ending_80fb32ff:
    lavish.say "Я привыкла к профессиональной обстановке и целеустремлённым коллегам."

# ch/harems_full/office/events/office_harem_common.rpy:2888
translate russian lavish_shiori_male_ending_b08e7a01:
    lavish.say "А он казался... ну, немного раздолбаем!"

# ch/harems_full/office/events/office_harem_common.rpy:2889
translate russian lavish_shiori_male_ending_f3d293b5:
    shiori.say "Я ТАК волновалась, когда [lssb_common.hero_name()] стал моим коллегой."

# ch/harems_full/office/events/office_harem_common.rpy:2890
translate russian lavish_shiori_male_ending_622a24ff:
    shiori.say "Деньги были очень нужны, счета копились."

# ch/harems_full/office/events/office_harem_common.rpy:2891
translate russian lavish_shiori_male_ending_972679c4:
    shiori.say "Я была уверена, что не понравлюсь ему, что он сочтёт меня бесполезной!"

# ch/harems_full/office/events/office_harem_common.rpy:2892
translate russian lavish_shiori_male_ending_0a4e7805:
    lavish.say "Не могу сказать, что [lssb_common.hero_name()] опроверг мои первые впечатления."

# ch/harems_full/office/events/office_harem_common.rpy:2893
translate russian lavish_shiori_male_ending_e94e0cc3:
    lavish.say "Но вскоре выяснилось, что он гораздо лучше умеет дружить, чем делать карьеру!"

# ch/harems_full/office/events/office_harem_common.rpy:2894
translate russian lavish_shiori_male_ending_935e27cf:
    lavish.say "Наверное, тогда я и начала видеть в нём не только коллегу."

# ch/harems_full/office/events/office_harem_common.rpy:2895
translate russian lavish_shiori_male_ending_ff6555d0:
    shiori.say "Конечно, [lssb_common.hero_name()] иногда терял со мной терпение. В худшие дни я сама не своя!"

# ch/harems_full/office/events/office_harem_common.rpy:2896
translate russian lavish_shiori_male_ending_8f1c0660:
    shiori.say "Но обычно он был терпелив и добр, и я чувствовала, что меня ценят."

# ch/harems_full/office/events/office_harem_common.rpy:2897
translate russian lavish_shiori_male_ending_63daadda:
    shiori.say "И с каждым днём всё сильнее к нему привязывалась."

# ch/harems_full/office/events/office_harem_common.rpy:2898
translate russian lavish_shiori_male_ending_8eda7546:
    lavish.say "Ах... наверное, с самого начала стоило держаться с ним профессиональнее."

# ch/harems_full/office/events/office_harem_common.rpy:2899
translate russian lavish_shiori_male_ending_b33ee2f9:
    lavish.say "Я не следила за границей между работой и удовольствием."

# ch/harems_full/office/events/office_harem_common.rpy:2900
translate russian lavish_shiori_male_ending_831ad9f1:
    lavish.say "И вскоре он стал больше чем коллегой и уж точно больше чем другом!"

# ch/harems_full/office/events/office_harem_common.rpy:2901
translate russian lavish_shiori_male_ending_3ee1254c:
    shiori.say "Я правда старалась сохранить деловые отношения, но так хотела ему угодить!"

# ch/harems_full/office/events/office_harem_common.rpy:2902
translate russian lavish_shiori_male_ending_c7fea004:
    shiori.say "[lssb_common.hero_name()] просил — и я делала всё, причём с удовольствием."

# ch/harems_full/office/events/office_harem_common.rpy:2903
translate russian lavish_shiori_male_ending_c0b34381:
    shiori.say "А когда стало ясно, что ему это тоже нравится... я уже была безнадёжно влюблена!"

# ch/harems_full/office/events/office_harem_common.rpy:2904
translate russian lavish_shiori_male_ending_2a835dff:
    lavish.say "[lssb_common.hero_name()] сделал меня счастливой в личной жизни. По-настоящему счастливой!"

# ch/harems_full/office/events/office_harem_common.rpy:2905
translate russian lavish_shiori_male_ending_07275f12:
    lavish.say "А я, кажется, положительно влияла на его профессиональную жизнь."

# ch/harems_full/office/events/office_harem_common.rpy:2906
translate russian lavish_shiori_male_ending_79a567f7:
    lavish.say "Наверное, научила его работать эффективнее, раз его начали повышать!"

# ch/harems_full/office/events/office_harem_common.rpy:2907
translate russian lavish_shiori_male_ending_15fe1caf:
    shiori.say "Я так радовалась, когда [lssb_common.hero_name()] начал получать повышения."

# ch/harems_full/office/events/office_harem_common.rpy:2908
translate russian lavish_shiori_male_ending_c78790c4:
    shiori.say "А когда радовался и он, то становился ещё добрее ко мне."

# ch/harems_full/office/events/office_harem_common.rpy:2909
translate russian lavish_shiori_male_ending_e623b8db:
    shiori.say "Мне хочется верить, что я помогла ему добиться такого успеха!"

# ch/harems_full/office/events/office_harem_common.rpy:2910
translate russian lavish_shiori_male_ending_1c508feb:
    lavish.say "Мне не нравилось, что [lssb_common.hero_name()] и я встречаемся не только друг с другом."

# ch/harems_full/office/events/office_harem_common.rpy:2911
translate russian lavish_shiori_male_ending_88cd0374:
    lavish.say "Но потом я подумала и увидела преимущества."

# ch/harems_full/office/events/office_harem_common.rpy:2912
translate russian lavish_shiori_male_ending_33be693a:
    lavish.say "Во многом так эффективнее и гибче. И НАМНОГО увлекательнее!"

# ch/harems_full/office/events/office_harem_common.rpy:2913
translate russian lavish_shiori_male_ending_4ffc0cb2:
    shiori.say "Когда [lssb_common.hero_name()] сказал, что встречается с другими девушками одновременно со мной, я испугалась."

# ch/harems_full/office/events/office_harem_common.rpy:2914
translate russian lavish_shiori_male_ending_5dee63a8:
    shiori.say "Решила, что они уведут его и я снова останусь одна."

# ch/harems_full/office/events/office_harem_common.rpy:2915
translate russian lavish_shiori_male_ending_ad20697c:
    shiori.say "Но [lssb_common.hero_name()] убедил меня, что всё будет иначе: мы все состоим в одних отношениях."

# ch/harems_full/office/events/office_harem_common.rpy:2916
translate russian lavish_shiori_male_ending_f9b87953:
    lavish.say "Знаю, как безумно звучит желание пожениться со всеми, с кем я спала."

# ch/harems_full/office/events/office_harem_common.rpy:2917
translate russian lavish_shiori_male_ending_d56a140d:
    lavish.say "Но вы должны понять: всё складывалось очень хорошо."

# ch/harems_full/office/events/office_harem_common.rpy:2918
translate russian lavish_shiori_male_ending_be296e69:
    lavish.say "Иногда и одного подходящего партнёра найти — удача, не говоря уже о нескольких!"

# ch/harems_full/office/events/office_harem_common.rpy:2919
translate russian lavish_shiori_male_ending_27f98246:
    shiori.say "Мой страх, что [lssb_common.hero_name()] уйдёт к другим девушкам и бросит меня, быстро исчез."

# ch/harems_full/office/events/office_harem_common.rpy:2920
translate russian lavish_shiori_male_ending_f1773a4c:
    shiori.say "Вскоре они стали мне как сёстры... даже больше, если понимаете, о чём я!"

# ch/harems_full/office/events/office_harem_common.rpy:2921
translate russian lavish_shiori_male_ending_bfe47a19:
    shiori.say "Поэтому мысль, что [lssb_common.hero_name()], девушки и я сможем пожениться, казалась чудесной!"

# ch/harems_full/office/events/office_harem_common.rpy:2922
translate russian lavish_shiori_male_ending_b011dd69:
    lavish.say "Я всегда была готова пожертвовать замужеством ради карьеры."

# ch/harems_full/office/events/office_harem_common.rpy:2923
translate russian lavish_shiori_male_ending_15811ba1:
    lavish.say "Но теперь, когда я замужем, понимаю, что выбирать необязательно."

# ch/harems_full/office/events/office_harem_common.rpy:2924
translate russian lavish_shiori_male_ending_15455b40:
    lavish.say "Ведь рядом все, кого я люблю, и они готовы меня поддержать!"

# ch/harems_full/office/events/office_harem_common.rpy:2925
translate russian lavish_shiori_male_ending_113f4b18:
    shiori.say "Я уже была замужем, и ничем хорошим это не кончилось!"

# ch/harems_full/office/events/office_harem_common.rpy:2926
translate russian lavish_shiori_male_ending_8ee731b2:
    shiori.say "Но теперь всё совсем иначе: мы скорее семья, чем просто пара."

# ch/harems_full/office/events/office_harem_common.rpy:2927
translate russian lavish_shiori_male_ending_3d3f2e10:
    shiori.say "Может, если бы мой первый брак был таким, всё сложилось бы по-другому?"

# ch/harems_full/office/events/office_harem_common.rpy:2928
translate russian lavish_shiori_male_ending_ab56a6ab:
    shiori.say "Хотя я ни за что не променяла бы то, что у меня есть сейчас, на такую возможность!"

# ch/harems_full/office/events/office_harem_common.rpy:2929
translate russian lavish_shiori_male_ending_3a6c24a1:
    lavish.say "Кто знает, как высоко мы сможем подняться и как далеко зайти вместе!"

# ch/harems_full/office/events/office_harem_common.rpy:2930
translate russian lavish_shiori_male_ending_c1dcf20d:
    shiori.say "Теперь у меня наконец есть семья, о которой я всегда мечтала!"

# ch/harems_full/office/events/office_harem_common.rpy:2937
translate russian audrey_shiori_male_ending_163e3150:
    "Знаете, я уже даже не помню, какие планы строил, когда устроился на нынешнюю работу."

# ch/harems_full/office/events/office_harem_common.rpy:2938
translate russian audrey_shiori_male_ending_afe3281b:
    "Собирался ли подниматься по карьерной лестнице так высоко, как смогу."

# ch/harems_full/office/events/office_harem_common.rpy:2939
translate russian audrey_shiori_male_ending_94c63a64:
    "Или просто хотел оплачивать счета, пока не найдётся что-то получше."

# ch/harems_full/office/events/office_harem_common.rpy:2940
translate russian audrey_shiori_male_ending_24743f63:
    "Но точно не думал встретить там будущих спутниц жизни!"

# ch/harems_full/office/events/office_harem_common.rpy:2941
translate russian audrey_shiori_male_ending_687b5cb6:
    "Насколько помню, я просто собирался немного повеселиться в офисе."

# ch/harems_full/office/events/office_harem_common.rpy:2942
translate russian audrey_shiori_male_ending_09d11206:
    "Ну, бездельничать и снимать рабочий стресс приятным общением с коллегами."

# ch/harems_full/office/events/office_harem_common.rpy:2943
translate russian audrey_shiori_male_ending_6c102b68:
    "Но одно потянулось за другим, и вот я здесь."

# ch/harems_full/office/events/office_harem_common.rpy:2944
translate russian audrey_shiori_male_ending_822fefa7:
    "Стою у алтаря и жду, когда те самые коллеги присоединятся ко мне."

# ch/harems_full/office/events/office_harem_common.rpy:2945
translate russian audrey_shiori_male_ending_1e6bb361:
    "Никогда бы не предположил, что всё закончится свадьбой."

# ch/harems_full/office/events/office_harem_common.rpy:2946
translate russian audrey_shiori_male_ending_3f238e55:
    "Тем более сразу с несколькими девушками с работы!"

# ch/harems_full/office/events/office_harem_common.rpy:2947
translate russian audrey_shiori_male_ending_0e3e2a13:
    "Не то чтобы я жаловался, понимаете?"

# ch/harems_full/office/events/office_harem_common.rpy:2948
translate russian audrey_shiori_male_ending_1cf1fe8c:
    "Я очень рад оказаться здесь."

# ch/harems_full/office/events/office_harem_common.rpy:2949
translate russian audrey_shiori_male_ending_a16093fe:
    "Просто сейчас моя жизнь напоминает американские горки!"

# ch/harems_full/office/events/office_harem_common.rpy:2950
translate russian audrey_shiori_male_ending_72c660cb:
    "Чтобы отвлечься, я оглядываю часовню."

# ch/harems_full/office/events/office_harem_common.rpy:2951
translate russian audrey_shiori_male_ending_62bccaf4:
    "Она красиво украшена, и это уже само по себе чудо."

# ch/harems_full/office/events/office_harem_common.rpy:2952
translate russian audrey_shiori_male_ending_4dcbc715:
    "Поверьте, когда оформление выбирает больше одной девушки, споры бывают жаркими!"

# ch/harems_full/office/events/office_harem_common.rpy:2953
translate russian audrey_shiori_male_ending_2d7ce45a:
    "Скамьи переполнены гостями — тоже ожидаемо, когда невест несколько."

# ch/harems_full/office/events/office_harem_common.rpy:2954
translate russian audrey_shiori_male_ending_f7ea0744:
    "Оглядывая ряд за рядом, я узнаю некоторые обращённые ко мне лица."

# ch/harems_full/office/events/office_harem_common.rpy:2955
translate russian audrey_shiori_male_ending_86f39f93:
    "Но разве можно знать здесь всех?"

# ch/harems_full/office/events/office_harem_common.rpy:2956
translate russian audrey_shiori_male_ending_03c31662:
    "Каждый участник свадьбы привёл целую толпу своих гостей."

# ch/harems_full/office/events/office_harem_common.rpy:2957
translate russian audrey_shiori_male_ending_de9f50a4:
    "Разобраться, кто к кому относится, почти невозможно!"

# ch/harems_full/office/events/office_harem_common.rpy:2958
translate russian audrey_shiori_male_ending_ccf5169a:
    "Я уже думаю попросить у девушек фотографии родственников с пояснениями."

# ch/harems_full/office/events/office_harem_common.rpy:2959
translate russian audrey_shiori_male_ending_f4e85421:
    "И тут часовню наполняет музыка."

# ch/harems_full/office/events/office_harem_common.rpy:2960
translate russian audrey_shiori_male_ending_29c59cdd:
    "Разумеется, я тут же прихожу в себя и выпрямляюсь почти по стойке смирно."

# ch/harems_full/office/events/office_harem_common.rpy:2961
translate russian audrey_shiori_male_ending_4ba2f2ee:
    "Как я могу не узнать эту музыку и не понять, что она означает?"

# ch/harems_full/office/events/office_harem_common.rpy:2962
translate russian audrey_shiori_male_ending_7f5b0022:
    "Я ведь сам оказался в центре споров о том, под что они пойдут к алтарю!"

# ch/harems_full/office/events/office_harem_common.rpy:2963
translate russian audrey_shiori_male_ending_be3eda7a:
    "Но воспоминания о последней ссоре и достигнутом компромиссе вдруг исчезают."

# ch/harems_full/office/events/office_harem_common.rpy:2964
translate russian audrey_shiori_male_ending_19827532:
    "Потому что я вижу только девушек, которые входят в часовню и идут по проходу."

# ch/harems_full/office/events/office_harem_common.rpy:2966
translate russian audrey_shiori_male_ending_9c17ea8b:
    "Одри каким-то образом идёт вместе с остальными и всё же держится особняком."

# ch/harems_full/office/events/office_harem_common.rpy:2967
translate russian audrey_shiori_male_ending_19ed8d0a:
    "На лице чуть язвительная, ироничная улыбка."

# ch/harems_full/office/events/office_harem_common.rpy:2968
translate russian audrey_shiori_male_ending_a1f07c5a:
    "Но в своём платье она всё равно элегантна и прекрасна."

# ch/harems_full/office/events/office_harem_common.rpy:2970
translate russian audrey_shiori_male_ending_3e02c880:
    "Одри держит букет прямо над округлившимся животом."

# ch/harems_full/office/events/office_harem_common.rpy:2971
translate russian audrey_shiori_male_ending_a76ee6d1:
    "Словно хочет показать его всему миру."

# ch/harems_full/office/events/office_harem_common.rpy:2972
translate russian audrey_shiori_male_ending_8fa30085:
    "Стоило догадаться, что она будет такой смелой и ничуть не смущённой!"

# ch/harems_full/office/events/office_harem_common.rpy:2974
translate russian audrey_shiori_male_ending_44563d73:
    "Сиори идёт последней, но именно на ней я дольше всего задерживаю взгляд."

# ch/harems_full/office/events/office_harem_common.rpy:2975
translate russian audrey_shiori_male_ending_0a48bf25:
    "Конечно, в своём платье она просто прекрасна."

# ch/harems_full/office/events/office_harem_common.rpy:2976
translate russian audrey_shiori_male_ending_7efc02d1:
    "Но важнее всего для меня то, что она улыбается."

# ch/harems_full/office/events/office_harem_common.rpy:2977
translate russian audrey_shiori_male_ending_ade0bdc1:
    "И я чувствую прилив счастья, зная, что она тоже счастлива."

# ch/harems_full/office/events/office_harem_common.rpy:2979
translate russian audrey_shiori_male_ending_71a6d072:
    "Может, дело ещё и в виде её живота?"

# ch/harems_full/office/events/office_harem_common.rpy:2980
translate russian audrey_shiori_male_ending_2f4773ce:
    "Мы одновременно женимся и начинаем новую семью."

# ch/harems_full/office/events/office_harem_common.rpy:2981
translate russian audrey_shiori_male_ending_bd9dd1ec:
    "Для всех нас это и правда начало новой жизни!"

# ch/harems_full/office/events/office_harem_common.rpy:2982
translate russian audrey_shiori_male_ending_a0c4ba2c:
    "Когда девушки подходят к алтарю, я неловко отодвигаюсь."

# ch/harems_full/office/events/office_harem_common.rpy:2983
translate russian audrey_shiori_male_ending_3043fcb4:
    "Они одна за другой встают рядом, то и дело меняясь местами."

# ch/harems_full/office/events/office_harem_common.rpy:2984
translate russian audrey_shiori_male_ending_ac482e86:
    "Конечно, мы пытались разобраться со всем этим на недавней репетиции."

# ch/harems_full/office/events/office_harem_common.rpy:2985
translate russian audrey_shiori_male_ending_378f4c4f:
    "Но, думаю, все толкаются из-за волнения."

# ch/harems_full/office/events/office_harem_common.rpy:2986
translate russian audrey_shiori_male_ending_c5b3de92:
    "Когда места наконец хватает всем, мы обмениваемся улыбками и взглядами."

# ch/harems_full/office/events/office_harem_common.rpy:2987
translate russian audrey_shiori_male_ending_e0a1dc8d:
    "Вижу, что каждая девушка чувствует себя так же, как я."

# ch/harems_full/office/events/office_harem_common.rpy:2988
translate russian audrey_shiori_male_ending_e220e585:
    "Эта странная смесь восторга и почти страха, от которой трепещет всё внутри!"

# ch/harems_full/office/events/office_harem_common.rpy:2990
translate russian audrey_shiori_male_ending_2a3aa788:
    "Мы все разом смотрим на священника."

# ch/harems_full/office/events/office_harem_common.rpy:2991
translate russian audrey_shiori_male_ending_b515515b:
    "Он жестом показывает, что церемония начинается."

# ch/harems_full/office/events/office_harem_common.rpy:2992
translate russian audrey_shiori_male_ending_6475c777:
    "Я рад, что он так уверенно берёт всё в свои руки."

# ch/harems_full/office/events/office_harem_common.rpy:2993
translate russian audrey_shiori_male_ending_bb69a3eb:
    "Потому что мы сразу сосредотачиваемся и следуем указаниям."

# ch/harems_full/office/events/office_harem_common.rpy:2995
translate russian audrey_shiori_male_ending_d601e095:
    "Священник" "Мы собрались здесь сегодня..."

# ch/harems_full/office/events/office_harem_common.rpy:2996
translate russian audrey_shiori_male_ending_c0a13476:
    "Священник" "Чтобы соединить этих людей — и я действительно имею в виду ВСЕХ!"

# ch/harems_full/office/events/office_harem_common.rpy:2997
translate russian audrey_shiori_male_ending_d05a0e2d:
    "Среди гостей прокатывается смех в ответ на маленькую шутку."

# ch/harems_full/office/events/office_harem_common.rpy:2998
translate russian audrey_shiori_male_ending_36cf52b2:
    "Но священник продолжает, и все снова умолкают."

# ch/harems_full/office/events/office_harem_common.rpy:2999
translate russian audrey_shiori_male_ending_20520034:
    "Священник" "Священными узами брака..."

# ch/harems_full/office/events/office_harem_common.rpy:3000
translate russian audrey_shiori_male_ending_22fe795c:
    "Остальная церемония проходит примерно так, как вы и представляете."

# ch/harems_full/office/events/office_harem_common.rpy:3001
translate russian audrey_shiori_male_ending_f3f3e6b5:
    "А чего вы ожидали?"

# ch/harems_full/office/events/office_harem_common.rpy:3002
translate russian audrey_shiori_male_ending_bb5a9817:
    "Призыва демонов и жертвоприношения животных?"

# ch/harems_full/office/events/office_harem_common.rpy:3003
translate russian audrey_shiori_male_ending_9b5d2ac7:
    "От обычной свадьбы отличается лишь то, что всё повторяют больше двух раз."

# ch/harems_full/office/events/office_harem_common.rpy:3004
translate russian audrey_shiori_male_ending_5af96bc2:
    "Священник" "Согласны ли вы, Одри, вступить с этими людьми..."

# ch/harems_full/office/events/office_harem_common.rpy:3005
translate russian audrey_shiori_male_ending_8c7361cd:
    "Священник" "В законный брак?"

# ch/harems_full/office/events/office_harem_common.rpy:3007
translate russian audrey_shiori_male_ending_944edfac:
    audrey.say "Согласна."

# ch/harems_full/office/events/office_harem_common.rpy:3008
translate russian audrey_shiori_male_ending_c5007986:
    "Священник" "Согласны ли вы, Сиори, вступить с этими людьми..."

# ch/harems_full/office/events/office_harem_common.rpy:3009
translate russian audrey_shiori_male_ending_8c7361cd_1:
    "Священник" "В законный брак?"

# ch/harems_full/office/events/office_harem_common.rpy:3011
translate russian audrey_shiori_male_ending_d1bfdb33:
    shiori.say "Согласна."

# ch/harems_full/office/events/office_harem_common.rpy:3012
translate russian audrey_shiori_male_ending_f732b602:
    "Священник" "И наконец..."

# ch/harems_full/office/events/office_harem_common.rpy:3013
translate russian audrey_shiori_male_ending_a9301f98:
    "Священник" "Согласны ли вы, [lssb_common.hero_name()], вступить с этими людьми..."

# ch/harems_full/office/events/office_harem_common.rpy:3014
translate russian audrey_shiori_male_ending_8c7361cd_2:
    "Священник" "В законный брак?"

# ch/harems_full/office/events/office_harem_common.rpy:3015
translate russian audrey_shiori_male_ending_cc481164:
    mike.say "Согласен."

# ch/harems_full/office/events/office_harem_common.rpy:3016
translate russian audrey_shiori_male_ending_c088e303:
    "Священник кивает и на миг переводит дух."

# ch/harems_full/office/events/office_harem_common.rpy:3017
translate russian audrey_shiori_male_ending_58c83231:
    "Священник" "Обращаюсь ко всем присутствующим..."

# ch/harems_full/office/events/office_harem_common.rpy:3018
translate russian audrey_shiori_male_ending_34d3fae8:
    "Священник" "Если кому-то известна законная причина, по которой эти люди не могут заключить брак..."

# ch/harems_full/office/events/office_harem_common.rpy:3019
translate russian audrey_shiori_male_ending_713d080b:
    "Священник" "Скажите сейчас или молчите вечно!"

# ch/harems_full/office/events/office_harem_common.rpy:3020
translate russian audrey_shiori_male_ending_59eeee8b:
    "Повисает привычная пауза: гости посмеиваются и оглядываются."

# ch/harems_full/office/events/office_harem_common.rpy:3021
translate russian audrey_shiori_male_ending_2bdc3a2c:
    "Может, они ждут, что сейчас в часовню ворвётся армия разгневанных бывших."

# ch/harems_full/office/events/office_harem_common.rpy:3022
translate russian audrey_shiori_male_ending_96cf9a58:
    "Но, к счастью, ничего столь невероятного не происходит."

# ch/harems_full/office/events/office_harem_common.rpy:3023
translate russian audrey_shiori_male_ending_e054f310:
    "Священник" "Что ж..."

# ch/harems_full/office/events/office_harem_common.rpy:3024
translate russian audrey_shiori_male_ending_7d5acc60:
    "Священник" "Объявляю вас супругами."

# ch/harems_full/office/events/office_harem_common.rpy:3025
translate russian audrey_shiori_male_ending_64235e41:
    "Священник" "Можете... эм..."

# ch/harems_full/office/events/office_harem_common.rpy:3026
translate russian audrey_shiori_male_ending_9751f813:
    "Священник" "Ну... сделать что-нибудь подобающее случаю!"

# ch/harems_full/office/events/office_harem_common.rpy:3027
translate russian audrey_shiori_male_ending_c2d44e57:
    "На этих словах священника мы все обнимаемся."

# ch/harems_full/office/events/office_harem_common.rpy:3028
translate russian audrey_shiori_male_ending_d4a89fae:
    "Переплетая руки и прижимаясь друг к другу."

# ch/harems_full/office/events/office_harem_common.rpy:3029
translate russian audrey_shiori_male_ending_7f03cb6b:
    "Наверное, наши отношения чем-то на это похожи."

# ch/harems_full/office/events/office_harem_common.rpy:3030
translate russian audrey_shiori_male_ending_4c722292:
    "Мы не всегда понимаем, как всё должно быть устроено."

# ch/harems_full/office/events/office_harem_common.rpy:3031
translate russian audrey_shiori_male_ending_c64d880a:
    "Но чувствуем, что нам хорошо вместе, и только это по-настоящему важно."

# ch/harems_full/office/events/office_harem_common.rpy:3034
translate russian audrey_shiori_male_ending_db6b1ec4:
    audrey.say "Я бы и сама со всем справилась. [lssb_common.hero_name()] мог бы вообще не участвовать."

# ch/harems_full/office/events/office_harem_common.rpy:3035
translate russian audrey_shiori_male_ending_3bf1fee5:
    audrey.say "Вообще-то и ваше участие необязательно."

# ch/harems_full/office/events/office_harem_common.rpy:3036
translate russian audrey_shiori_male_ending_f555ec5b:
    audrey.say "Никто из вас не расскажет так хорошо, как я."

# ch/harems_full/office/events/office_harem_common.rpy:3037
translate russian audrey_shiori_male_ending_16de9855:
    shiori.say "Я... я не знаю, стоит ли нам это делать, когда [lssb_common.hero_name()] не здесь!"

# ch/harems_full/office/events/office_harem_common.rpy:3038
translate russian audrey_shiori_male_ending_93d00ac6:
    shiori.say "Ведь без него ничего этого вообще бы не было, правда?"

# ch/harems_full/office/events/office_harem_common.rpy:3039
translate russian audrey_shiori_male_ending_58f159c1:
    shiori.say "Ох... надеюсь, он не расстроится из-за того, что все о нём говорят!"

# ch/harems_full/office/events/office_harem_common.rpy:3040
translate russian audrey_shiori_male_ending_ec759ec2:
    audrey.say "Да, обычно я ненавижу мужчин, под которыми приходится... работать!"

# ch/harems_full/office/events/office_harem_common.rpy:3041
translate russian audrey_shiori_male_ending_63750b5e:
    audrey.say "И была почти уверена, что [lssb_common.hero_name()] окажется таким же."

# ch/harems_full/office/events/office_harem_common.rpy:3042
translate russian audrey_shiori_male_ending_a74f7b23:
    audrey.say "Но особо не переживала: таким парням я всегда устраиваю ад!"

# ch/harems_full/office/events/office_harem_common.rpy:3043
translate russian audrey_shiori_male_ending_f3d293b5:
    shiori.say "Я ТАК волновалась, когда [lssb_common.hero_name()] стал моим коллегой."

# ch/harems_full/office/events/office_harem_common.rpy:3044
translate russian audrey_shiori_male_ending_622a24ff:
    shiori.say "Деньги были очень нужны, счета копились."

# ch/harems_full/office/events/office_harem_common.rpy:3045
translate russian audrey_shiori_male_ending_972679c4:
    shiori.say "Я была уверена, что не понравлюсь ему, что он сочтёт меня бесполезной!"

# ch/harems_full/office/events/office_harem_common.rpy:3046
translate russian audrey_shiori_male_ending_4049420f:
    audrey.say "[lssb_common.hero_name()] стал жертвой моих обычных изощрённых издевательств."

# ch/harems_full/office/events/office_harem_common.rpy:3047
translate russian audrey_shiori_male_ending_20525bae:
    audrey.say "И, чёрт возьми, мне это начало нравиться."

# ch/harems_full/office/events/office_harem_common.rpy:3048
translate russian audrey_shiori_male_ending_51ff6098:
    audrey.say "То есть больше обычного, больше, чем просто смотреть на его мучения!"

# ch/harems_full/office/events/office_harem_common.rpy:3049
translate russian audrey_shiori_male_ending_ff6555d0:
    shiori.say "Конечно, [lssb_common.hero_name()] иногда терял со мной терпение. В худшие дни я сама не своя!"

# ch/harems_full/office/events/office_harem_common.rpy:3050
translate russian audrey_shiori_male_ending_8f1c0660:
    shiori.say "Но обычно он был терпелив и добр, и я чувствовала, что меня ценят."

# ch/harems_full/office/events/office_harem_common.rpy:3051
translate russian audrey_shiori_male_ending_63daadda:
    shiori.say "И с каждым днём всё сильнее к нему привязывалась."

# ch/harems_full/office/events/office_harem_common.rpy:3052
translate russian audrey_shiori_male_ending_ef76f68c:
    audrey.say "Вот так он меня и поймал: мне было слишком весело!"

# ch/harems_full/office/events/office_harem_common.rpy:3053
translate russian audrey_shiori_male_ending_33cfb592:
    audrey.say "Я и понять ничего не успела, как уже сама возвращалась за новой порцией."

# ch/harems_full/office/events/office_harem_common.rpy:3054
translate russian audrey_shiori_male_ending_7d9f90fe:
    audrey.say "И дня не могла прожить, не подразнив его, хотя бы ради реакции!"

# ch/harems_full/office/events/office_harem_common.rpy:3055
translate russian audrey_shiori_male_ending_3ee1254c:
    shiori.say "Я правда старалась сохранить деловые отношения, но так хотела ему угодить!"

# ch/harems_full/office/events/office_harem_common.rpy:3056
translate russian audrey_shiori_male_ending_c7fea004:
    shiori.say "[lssb_common.hero_name()] просил — и я делала всё, причём с удовольствием."

# ch/harems_full/office/events/office_harem_common.rpy:3057
translate russian audrey_shiori_male_ending_c0b34381:
    shiori.say "А когда стало ясно, что ему это тоже нравится... я уже была безнадёжно влюблена!"

# ch/harems_full/office/events/office_harem_common.rpy:3058
translate russian audrey_shiori_male_ending_19e4825a:
    audrey.say "Ещё никто из тех, над кем я издевалась, не начинал получать повышения!"

# ch/harems_full/office/events/office_harem_common.rpy:3059
translate russian audrey_shiori_male_ending_2a530e68:
    audrey.say "Но чем ближе становились наши отношения, тем успешнее был [lssb_common.hero_name()]."

# ch/harems_full/office/events/office_harem_common.rpy:3060
translate russian audrey_shiori_male_ending_de1eb4f3:
    audrey.say "Вскоре он уже сидел на самой верхушке!"

# ch/harems_full/office/events/office_harem_common.rpy:3061
translate russian audrey_shiori_male_ending_15fe1caf:
    shiori.say "Я так радовалась, когда [lssb_common.hero_name()] начал получать повышения."

# ch/harems_full/office/events/office_harem_common.rpy:3062
translate russian audrey_shiori_male_ending_c78790c4:
    shiori.say "А когда радовался и он, то становился ещё добрее ко мне."

# ch/harems_full/office/events/office_harem_common.rpy:3063
translate russian audrey_shiori_male_ending_e623b8db:
    shiori.say "Мне хочется верить, что я помогла ему добиться такого успеха!"

# ch/harems_full/office/events/office_harem_common.rpy:3064
translate russian audrey_shiori_male_ending_101688db:
    audrey.say "Да, я немного обалдела, узнав, что [lssb_common.hero_name()] встречается и с другими девушками в офисе."

# ch/harems_full/office/events/office_harem_common.rpy:3065
translate russian audrey_shiori_male_ending_584b7d13:
    audrey.say "Обычно это я всех шокирую, понимаете?"

# ch/harems_full/office/events/office_harem_common.rpy:3066
translate russian audrey_shiori_male_ending_b723cbd8:
    audrey.say "Но больше участников — больше возможностей повеселиться!"

# ch/harems_full/office/events/office_harem_common.rpy:3067
translate russian audrey_shiori_male_ending_4ffc0cb2:
    shiori.say "Когда [lssb_common.hero_name()] сказал, что встречается с другими девушками одновременно со мной, я испугалась."

# ch/harems_full/office/events/office_harem_common.rpy:3068
translate russian audrey_shiori_male_ending_5dee63a8:
    shiori.say "Решила, что они уведут его и я снова останусь одна."

# ch/harems_full/office/events/office_harem_common.rpy:3069
translate russian audrey_shiori_male_ending_ad20697c:
    shiori.say "Но [lssb_common.hero_name()] убедил меня, что всё будет иначе: мы все состоим в одних отношениях."

# ch/harems_full/office/events/office_harem_common.rpy:3070
translate russian audrey_shiori_male_ending_0092b8b7:
    audrey.say "Поверьте, я никогда не думала, что выйду замуж даже за одного человека."

# ch/harems_full/office/events/office_harem_common.rpy:3071
translate russian audrey_shiori_male_ending_059e8d07:
    audrey.say "Так могла ли я представить брак сразу с несколькими?!"

# ch/harems_full/office/events/office_harem_common.rpy:3072
translate russian audrey_shiori_male_ending_c0246911:
    audrey.say "Ну... может, я именно поэтому и согласилась: идея-то безумная!"

# ch/harems_full/office/events/office_harem_common.rpy:3073
translate russian audrey_shiori_male_ending_27f98246:
    shiori.say "Мой страх, что [lssb_common.hero_name()] уйдёт к другим девушкам и бросит меня, быстро исчез."

# ch/harems_full/office/events/office_harem_common.rpy:3074
translate russian audrey_shiori_male_ending_f1773a4c:
    shiori.say "Вскоре они стали мне как сёстры... даже больше, если понимаете, о чём я!"

# ch/harems_full/office/events/office_harem_common.rpy:3075
translate russian audrey_shiori_male_ending_bfe47a19:
    shiori.say "Поэтому мысль, что [lssb_common.hero_name()], девушки и я сможем пожениться, казалась чудесной!"

# ch/harems_full/office/events/office_harem_common.rpy:3076
translate russian audrey_shiori_male_ending_c660529e:
    audrey.say "Все говорят, что после свадьбы я стала спокойнее и остепенилась."

# ch/harems_full/office/events/office_harem_common.rpy:3077
translate russian audrey_shiori_male_ending_697d0dbb:
    audrey.say "И знаете, что меня в этом больше всего бесит? То, что они вроде бы правы."

# ch/harems_full/office/events/office_harem_common.rpy:3078
translate russian audrey_shiori_male_ending_96b577b4:
    audrey.say "Рядом столько людей, о которых я могу заботиться и которые заботятся обо мне, — я уже не такая злая, как раньше!"

# ch/harems_full/office/events/office_harem_common.rpy:3079
translate russian audrey_shiori_male_ending_113f4b18:
    shiori.say "Я уже была замужем, и ничем хорошим это не кончилось!"

# ch/harems_full/office/events/office_harem_common.rpy:3080
translate russian audrey_shiori_male_ending_8ee731b2:
    shiori.say "Но теперь всё совсем иначе: мы скорее семья, чем просто пара."

# ch/harems_full/office/events/office_harem_common.rpy:3081
translate russian audrey_shiori_male_ending_3d3f2e10:
    shiori.say "Может, если бы мой первый брак был таким, всё сложилось бы по-другому?"

# ch/harems_full/office/events/office_harem_common.rpy:3082
translate russian audrey_shiori_male_ending_ab56a6ab:
    shiori.say "Хотя я ни за что не променяла бы то, что у меня есть сейчас, на такую возможность!"

# ch/harems_full/office/events/office_harem_common.rpy:3083
translate russian audrey_shiori_male_ending_3e7ffed2:
    audrey.say "Впереди нас ждёт много интересного!"

# ch/harems_full/office/events/office_harem_common.rpy:3084
translate russian audrey_shiori_male_ending_c1dcf20d:
    shiori.say "Теперь у меня наконец есть семья, о которой я всегда мечтала!"

# ch/harems_full/office/events/office_harem_common.rpy:3091
translate russian audrey_lavish_male_ending_163e3150:
    "Знаете, я уже даже не помню, какие планы строил, когда устроился на нынешнюю работу."

# ch/harems_full/office/events/office_harem_common.rpy:3092
translate russian audrey_lavish_male_ending_afe3281b:
    "Собирался ли подниматься по карьерной лестнице так высоко, как смогу."

# ch/harems_full/office/events/office_harem_common.rpy:3093
translate russian audrey_lavish_male_ending_94c63a64:
    "Или просто хотел оплачивать счета, пока не найдётся что-то получше."

# ch/harems_full/office/events/office_harem_common.rpy:3094
translate russian audrey_lavish_male_ending_24743f63:
    "Но точно не думал встретить там будущих спутниц жизни!"

# ch/harems_full/office/events/office_harem_common.rpy:3095
translate russian audrey_lavish_male_ending_687b5cb6:
    "Насколько помню, я просто собирался немного повеселиться в офисе."

# ch/harems_full/office/events/office_harem_common.rpy:3096
translate russian audrey_lavish_male_ending_09d11206:
    "Ну, бездельничать и снимать рабочий стресс приятным общением с коллегами."

# ch/harems_full/office/events/office_harem_common.rpy:3097
translate russian audrey_lavish_male_ending_6c102b68:
    "Но одно потянулось за другим, и вот я здесь."

# ch/harems_full/office/events/office_harem_common.rpy:3098
translate russian audrey_lavish_male_ending_822fefa7:
    "Стою у алтаря и жду, когда те самые коллеги присоединятся ко мне."

# ch/harems_full/office/events/office_harem_common.rpy:3099
translate russian audrey_lavish_male_ending_1e6bb361:
    "Никогда бы не предположил, что всё закончится свадьбой."

# ch/harems_full/office/events/office_harem_common.rpy:3100
translate russian audrey_lavish_male_ending_3f238e55:
    "Тем более сразу с несколькими девушками с работы!"

# ch/harems_full/office/events/office_harem_common.rpy:3101
translate russian audrey_lavish_male_ending_0e3e2a13:
    "Не то чтобы я жаловался, понимаете?"

# ch/harems_full/office/events/office_harem_common.rpy:3102
translate russian audrey_lavish_male_ending_1cf1fe8c:
    "Я очень рад оказаться здесь."

# ch/harems_full/office/events/office_harem_common.rpy:3103
translate russian audrey_lavish_male_ending_a16093fe:
    "Просто сейчас моя жизнь напоминает американские горки!"

# ch/harems_full/office/events/office_harem_common.rpy:3104
translate russian audrey_lavish_male_ending_72c660cb:
    "Чтобы отвлечься, я оглядываю часовню."

# ch/harems_full/office/events/office_harem_common.rpy:3105
translate russian audrey_lavish_male_ending_62bccaf4:
    "Она красиво украшена, и это уже само по себе чудо."

# ch/harems_full/office/events/office_harem_common.rpy:3106
translate russian audrey_lavish_male_ending_4dcbc715:
    "Поверьте, когда оформление выбирает больше одной девушки, споры бывают жаркими!"

# ch/harems_full/office/events/office_harem_common.rpy:3107
translate russian audrey_lavish_male_ending_2d7ce45a:
    "Скамьи переполнены гостями — тоже ожидаемо, когда невест несколько."

# ch/harems_full/office/events/office_harem_common.rpy:3108
translate russian audrey_lavish_male_ending_f7ea0744:
    "Оглядывая ряд за рядом, я узнаю некоторые обращённые ко мне лица."

# ch/harems_full/office/events/office_harem_common.rpy:3109
translate russian audrey_lavish_male_ending_86f39f93:
    "Но разве можно знать здесь всех?"

# ch/harems_full/office/events/office_harem_common.rpy:3110
translate russian audrey_lavish_male_ending_03c31662:
    "Каждый участник свадьбы привёл целую толпу своих гостей."

# ch/harems_full/office/events/office_harem_common.rpy:3111
translate russian audrey_lavish_male_ending_de9f50a4:
    "Разобраться, кто к кому относится, почти невозможно!"

# ch/harems_full/office/events/office_harem_common.rpy:3112
translate russian audrey_lavish_male_ending_ccf5169a:
    "Я уже думаю попросить у девушек фотографии родственников с пояснениями."

# ch/harems_full/office/events/office_harem_common.rpy:3113
translate russian audrey_lavish_male_ending_f4e85421:
    "И тут часовню наполняет музыка."

# ch/harems_full/office/events/office_harem_common.rpy:3114
translate russian audrey_lavish_male_ending_29c59cdd:
    "Разумеется, я тут же прихожу в себя и выпрямляюсь почти по стойке смирно."

# ch/harems_full/office/events/office_harem_common.rpy:3115
translate russian audrey_lavish_male_ending_4ba2f2ee:
    "Как я могу не узнать эту музыку и не понять, что она означает?"

# ch/harems_full/office/events/office_harem_common.rpy:3116
translate russian audrey_lavish_male_ending_7f5b0022:
    "Я ведь сам оказался в центре споров о том, под что они пойдут к алтарю!"

# ch/harems_full/office/events/office_harem_common.rpy:3117
translate russian audrey_lavish_male_ending_be3eda7a:
    "Но воспоминания о последней ссоре и достигнутом компромиссе вдруг исчезают."

# ch/harems_full/office/events/office_harem_common.rpy:3118
translate russian audrey_lavish_male_ending_19827532:
    "Потому что я вижу только девушек, которые входят в часовню и идут по проходу."

# ch/harems_full/office/events/office_harem_common.rpy:3120
translate russian audrey_lavish_male_ending_9c17ea8b:
    "Одри каким-то образом идёт вместе с остальными и всё же держится особняком."

# ch/harems_full/office/events/office_harem_common.rpy:3121
translate russian audrey_lavish_male_ending_19ed8d0a:
    "На лице чуть язвительная, ироничная улыбка."

# ch/harems_full/office/events/office_harem_common.rpy:3122
translate russian audrey_lavish_male_ending_a1f07c5a:
    "Но в своём платье она всё равно элегантна и прекрасна."

# ch/harems_full/office/events/office_harem_common.rpy:3124
translate russian audrey_lavish_male_ending_3e02c880:
    "Одри держит букет прямо над округлившимся животом."

# ch/harems_full/office/events/office_harem_common.rpy:3125
translate russian audrey_lavish_male_ending_a76ee6d1:
    "Словно хочет показать его всему миру."

# ch/harems_full/office/events/office_harem_common.rpy:3126
translate russian audrey_lavish_male_ending_8fa30085:
    "Стоило догадаться, что она будет такой смелой и ничуть не смущённой!"

# ch/harems_full/office/events/office_harem_common.rpy:3128
translate russian audrey_lavish_male_ending_621b32f4:
    "Лавиш идёт ко мне с привычной спокойной уверенностью."

# ch/harems_full/office/events/office_harem_common.rpy:3129
translate russian audrey_lavish_male_ending_5c7a0c15:
    "Сдержанное платье лишь подчёркивает её красоту."

# ch/harems_full/office/events/office_harem_common.rpy:3130
translate russian audrey_lavish_male_ending_3c30d210:
    "Не понимаю, как ей удаётся сказать так много без единого слова."

# ch/harems_full/office/events/office_harem_common.rpy:3132
translate russian audrey_lavish_male_ending_443d5342:
    "Я почти забываю, что она беременна и это уже заметно."

# ch/harems_full/office/events/office_harem_common.rpy:3133
translate russian audrey_lavish_male_ending_1b0f172f:
    "Но тут вижу мягкий изгиб её живота."

# ch/harems_full/office/events/office_harem_common.rpy:3134
translate russian audrey_lavish_male_ending_463b28c3:
    "И вспоминаю, как сильно её люблю."

# ch/harems_full/office/events/office_harem_common.rpy:3135
translate russian audrey_lavish_male_ending_a0c4ba2c:
    "Когда девушки подходят к алтарю, я неловко отодвигаюсь."

# ch/harems_full/office/events/office_harem_common.rpy:3136
translate russian audrey_lavish_male_ending_3043fcb4:
    "Они одна за другой встают рядом, то и дело меняясь местами."

# ch/harems_full/office/events/office_harem_common.rpy:3137
translate russian audrey_lavish_male_ending_ac482e86:
    "Конечно, мы пытались разобраться со всем этим на недавней репетиции."

# ch/harems_full/office/events/office_harem_common.rpy:3138
translate russian audrey_lavish_male_ending_378f4c4f:
    "Но, думаю, все толкаются из-за волнения."

# ch/harems_full/office/events/office_harem_common.rpy:3139
translate russian audrey_lavish_male_ending_c5b3de92:
    "Когда места наконец хватает всем, мы обмениваемся улыбками и взглядами."

# ch/harems_full/office/events/office_harem_common.rpy:3140
translate russian audrey_lavish_male_ending_e0a1dc8d:
    "Вижу, что каждая девушка чувствует себя так же, как я."

# ch/harems_full/office/events/office_harem_common.rpy:3141
translate russian audrey_lavish_male_ending_e220e585:
    "Эта странная смесь восторга и почти страха, от которой трепещет всё внутри!"

# ch/harems_full/office/events/office_harem_common.rpy:3143
translate russian audrey_lavish_male_ending_2a3aa788:
    "Мы все разом смотрим на священника."

# ch/harems_full/office/events/office_harem_common.rpy:3144
translate russian audrey_lavish_male_ending_b515515b:
    "Он жестом показывает, что церемония начинается."

# ch/harems_full/office/events/office_harem_common.rpy:3145
translate russian audrey_lavish_male_ending_6475c777:
    "Я рад, что он так уверенно берёт всё в свои руки."

# ch/harems_full/office/events/office_harem_common.rpy:3146
translate russian audrey_lavish_male_ending_bb69a3eb:
    "Потому что мы сразу сосредотачиваемся и следуем указаниям."

# ch/harems_full/office/events/office_harem_common.rpy:3148
translate russian audrey_lavish_male_ending_d601e095:
    "Священник" "Мы собрались здесь сегодня..."

# ch/harems_full/office/events/office_harem_common.rpy:3149
translate russian audrey_lavish_male_ending_c0a13476:
    "Священник" "Чтобы соединить этих людей — и я действительно имею в виду ВСЕХ!"

# ch/harems_full/office/events/office_harem_common.rpy:3150
translate russian audrey_lavish_male_ending_d05a0e2d:
    "Среди гостей прокатывается смех в ответ на маленькую шутку."

# ch/harems_full/office/events/office_harem_common.rpy:3151
translate russian audrey_lavish_male_ending_36cf52b2:
    "Но священник продолжает, и все снова умолкают."

# ch/harems_full/office/events/office_harem_common.rpy:3152
translate russian audrey_lavish_male_ending_20520034:
    "Священник" "Священными узами брака..."

# ch/harems_full/office/events/office_harem_common.rpy:3153
translate russian audrey_lavish_male_ending_22fe795c:
    "Остальная церемония проходит примерно так, как вы и представляете."

# ch/harems_full/office/events/office_harem_common.rpy:3154
translate russian audrey_lavish_male_ending_f3f3e6b5:
    "А чего вы ожидали?"

# ch/harems_full/office/events/office_harem_common.rpy:3155
translate russian audrey_lavish_male_ending_bb5a9817:
    "Призыва демонов и жертвоприношения животных?"

# ch/harems_full/office/events/office_harem_common.rpy:3156
translate russian audrey_lavish_male_ending_9b5d2ac7:
    "От обычной свадьбы отличается лишь то, что всё повторяют больше двух раз."

# ch/harems_full/office/events/office_harem_common.rpy:3157
translate russian audrey_lavish_male_ending_5af96bc2:
    "Священник" "Согласны ли вы, Одри, вступить с этими людьми..."

# ch/harems_full/office/events/office_harem_common.rpy:3158
translate russian audrey_lavish_male_ending_8c7361cd:
    "Священник" "В законный брак?"

# ch/harems_full/office/events/office_harem_common.rpy:3160
translate russian audrey_lavish_male_ending_944edfac:
    audrey.say "Согласна."

# ch/harems_full/office/events/office_harem_common.rpy:3161
translate russian audrey_lavish_male_ending_95513d99:
    "Священник" "Согласны ли вы, Лавиш, вступить с этими людьми..."

# ch/harems_full/office/events/office_harem_common.rpy:3162
translate russian audrey_lavish_male_ending_8c7361cd_1:
    "Священник" "В законный брак?"

# ch/harems_full/office/events/office_harem_common.rpy:3164
translate russian audrey_lavish_male_ending_12994482:
    lavish.say "Согласна."

# ch/harems_full/office/events/office_harem_common.rpy:3165
translate russian audrey_lavish_male_ending_f732b602:
    "Священник" "И наконец..."

# ch/harems_full/office/events/office_harem_common.rpy:3166
translate russian audrey_lavish_male_ending_a9301f98:
    "Священник" "Согласны ли вы, [lssb_common.hero_name()], вступить с этими людьми..."

# ch/harems_full/office/events/office_harem_common.rpy:3167
translate russian audrey_lavish_male_ending_8c7361cd_2:
    "Священник" "В законный брак?"

# ch/harems_full/office/events/office_harem_common.rpy:3168
translate russian audrey_lavish_male_ending_cc481164:
    mike.say "Согласен."

# ch/harems_full/office/events/office_harem_common.rpy:3169
translate russian audrey_lavish_male_ending_c088e303:
    "Священник кивает и на миг переводит дух."

# ch/harems_full/office/events/office_harem_common.rpy:3170
translate russian audrey_lavish_male_ending_58c83231:
    "Священник" "Обращаюсь ко всем присутствующим..."

# ch/harems_full/office/events/office_harem_common.rpy:3171
translate russian audrey_lavish_male_ending_34d3fae8:
    "Священник" "Если кому-то известна законная причина, по которой эти люди не могут заключить брак..."

# ch/harems_full/office/events/office_harem_common.rpy:3172
translate russian audrey_lavish_male_ending_713d080b:
    "Священник" "Скажите сейчас или молчите вечно!"

# ch/harems_full/office/events/office_harem_common.rpy:3173
translate russian audrey_lavish_male_ending_59eeee8b:
    "Повисает привычная пауза: гости посмеиваются и оглядываются."

# ch/harems_full/office/events/office_harem_common.rpy:3174
translate russian audrey_lavish_male_ending_2bdc3a2c:
    "Может, они ждут, что сейчас в часовню ворвётся армия разгневанных бывших."

# ch/harems_full/office/events/office_harem_common.rpy:3175
translate russian audrey_lavish_male_ending_96cf9a58:
    "Но, к счастью, ничего столь невероятного не происходит."

# ch/harems_full/office/events/office_harem_common.rpy:3176
translate russian audrey_lavish_male_ending_e054f310:
    "Священник" "Что ж..."

# ch/harems_full/office/events/office_harem_common.rpy:3177
translate russian audrey_lavish_male_ending_7d5acc60:
    "Священник" "Объявляю вас супругами."

# ch/harems_full/office/events/office_harem_common.rpy:3178
translate russian audrey_lavish_male_ending_64235e41:
    "Священник" "Можете... эм..."

# ch/harems_full/office/events/office_harem_common.rpy:3179
translate russian audrey_lavish_male_ending_9751f813:
    "Священник" "Ну... сделать что-нибудь подобающее случаю!"

# ch/harems_full/office/events/office_harem_common.rpy:3180
translate russian audrey_lavish_male_ending_c2d44e57:
    "На этих словах священника мы все обнимаемся."

# ch/harems_full/office/events/office_harem_common.rpy:3181
translate russian audrey_lavish_male_ending_d4a89fae:
    "Переплетая руки и прижимаясь друг к другу."

# ch/harems_full/office/events/office_harem_common.rpy:3182
translate russian audrey_lavish_male_ending_7f03cb6b:
    "Наверное, наши отношения чем-то на это похожи."

# ch/harems_full/office/events/office_harem_common.rpy:3183
translate russian audrey_lavish_male_ending_4c722292:
    "Мы не всегда понимаем, как всё должно быть устроено."

# ch/harems_full/office/events/office_harem_common.rpy:3184
translate russian audrey_lavish_male_ending_c64d880a:
    "Но чувствуем, что нам хорошо вместе, и только это по-настоящему важно."

# ch/harems_full/office/events/office_harem_common.rpy:3187
translate russian audrey_lavish_male_ending_db6b1ec4:
    audrey.say "Я бы и сама со всем справилась. [lssb_common.hero_name()] мог бы вообще не участвовать."

# ch/harems_full/office/events/office_harem_common.rpy:3188
translate russian audrey_lavish_male_ending_3bf1fee5:
    audrey.say "Вообще-то и ваше участие необязательно."

# ch/harems_full/office/events/office_harem_common.rpy:3189
translate russian audrey_lavish_male_ending_f555ec5b:
    audrey.say "Никто из вас не расскажет так хорошо, как я."

# ch/harems_full/office/events/office_harem_common.rpy:3190
translate russian audrey_lavish_male_ending_452dc528:
    lavish.say "Я просто обязана была высказаться, пусть даже под конец истории."

# ch/harems_full/office/events/office_harem_common.rpy:3191
translate russian audrey_lavish_male_ending_7513fa12:
    lavish.say "И не думайте, что моя любовь куда-то делась: [lssb_common.hero_name()] и все вы мне по-прежнему дороги."

# ch/harems_full/office/events/office_harem_common.rpy:3192
translate russian audrey_lavish_male_ending_1b407c2a:
    lavish.say "Но я всё-таки самая надёжная и честная из всех участников!"

# ch/harems_full/office/events/office_harem_common.rpy:3193
translate russian audrey_lavish_male_ending_ec759ec2:
    audrey.say "Да, обычно я ненавижу мужчин, под которыми приходится... работать!"

# ch/harems_full/office/events/office_harem_common.rpy:3194
translate russian audrey_lavish_male_ending_63750b5e:
    audrey.say "И была почти уверена, что [lssb_common.hero_name()] окажется таким же."

# ch/harems_full/office/events/office_harem_common.rpy:3195
translate russian audrey_lavish_male_ending_a74f7b23:
    audrey.say "Но особо не переживала: таким парням я всегда устраиваю ад!"

# ch/harems_full/office/events/office_harem_common.rpy:3196
translate russian audrey_lavish_male_ending_c3b96b26:
    lavish.say "Когда [lssb_common.hero_name()] стал моим начальником, у меня были сомнения."

# ch/harems_full/office/events/office_harem_common.rpy:3197
translate russian audrey_lavish_male_ending_80fb32ff:
    lavish.say "Я привыкла к профессиональной обстановке и целеустремлённым коллегам."

# ch/harems_full/office/events/office_harem_common.rpy:3198
translate russian audrey_lavish_male_ending_b08e7a01:
    lavish.say "А он казался... ну, немного раздолбаем!"

# ch/harems_full/office/events/office_harem_common.rpy:3199
translate russian audrey_lavish_male_ending_4049420f:
    audrey.say "[lssb_common.hero_name()] стал жертвой моих обычных изощрённых издевательств."

# ch/harems_full/office/events/office_harem_common.rpy:3200
translate russian audrey_lavish_male_ending_20525bae:
    audrey.say "И, чёрт возьми, мне это начало нравиться."

# ch/harems_full/office/events/office_harem_common.rpy:3201
translate russian audrey_lavish_male_ending_51ff6098:
    audrey.say "То есть больше обычного, больше, чем просто смотреть на его мучения!"

# ch/harems_full/office/events/office_harem_common.rpy:3202
translate russian audrey_lavish_male_ending_0a4e7805:
    lavish.say "Не могу сказать, что [lssb_common.hero_name()] опроверг мои первые впечатления."

# ch/harems_full/office/events/office_harem_common.rpy:3203
translate russian audrey_lavish_male_ending_e94e0cc3:
    lavish.say "Но вскоре выяснилось, что он гораздо лучше умеет дружить, чем делать карьеру!"

# ch/harems_full/office/events/office_harem_common.rpy:3204
translate russian audrey_lavish_male_ending_935e27cf:
    lavish.say "Наверное, тогда я и начала видеть в нём не только коллегу."

# ch/harems_full/office/events/office_harem_common.rpy:3205
translate russian audrey_lavish_male_ending_ef76f68c:
    audrey.say "Вот так он меня и поймал: мне было слишком весело!"

# ch/harems_full/office/events/office_harem_common.rpy:3206
translate russian audrey_lavish_male_ending_33cfb592:
    audrey.say "Я и понять ничего не успела, как уже сама возвращалась за новой порцией."

# ch/harems_full/office/events/office_harem_common.rpy:3207
translate russian audrey_lavish_male_ending_7d9f90fe:
    audrey.say "И дня не могла прожить, не подразнив его, хотя бы ради реакции!"

# ch/harems_full/office/events/office_harem_common.rpy:3208
translate russian audrey_lavish_male_ending_8eda7546:
    lavish.say "Ах... наверное, с самого начала стоило держаться с ним профессиональнее."

# ch/harems_full/office/events/office_harem_common.rpy:3209
translate russian audrey_lavish_male_ending_b33ee2f9:
    lavish.say "Я не следила за границей между работой и удовольствием."

# ch/harems_full/office/events/office_harem_common.rpy:3210
translate russian audrey_lavish_male_ending_831ad9f1:
    lavish.say "И вскоре он стал больше чем коллегой и уж точно больше чем другом!"

# ch/harems_full/office/events/office_harem_common.rpy:3211
translate russian audrey_lavish_male_ending_19e4825a:
    audrey.say "Ещё никто из тех, над кем я издевалась, не начинал получать повышения!"

# ch/harems_full/office/events/office_harem_common.rpy:3212
translate russian audrey_lavish_male_ending_2a530e68:
    audrey.say "Но чем ближе становились наши отношения, тем успешнее был [lssb_common.hero_name()]."

# ch/harems_full/office/events/office_harem_common.rpy:3213
translate russian audrey_lavish_male_ending_de1eb4f3:
    audrey.say "Вскоре он уже сидел на самой верхушке!"

# ch/harems_full/office/events/office_harem_common.rpy:3214
translate russian audrey_lavish_male_ending_2a835dff:
    lavish.say "[lssb_common.hero_name()] сделал меня счастливой в личной жизни. По-настоящему счастливой!"

# ch/harems_full/office/events/office_harem_common.rpy:3215
translate russian audrey_lavish_male_ending_07275f12:
    lavish.say "А я, кажется, положительно влияла на его профессиональную жизнь."

# ch/harems_full/office/events/office_harem_common.rpy:3216
translate russian audrey_lavish_male_ending_79a567f7:
    lavish.say "Наверное, научила его работать эффективнее, раз его начали повышать!"

# ch/harems_full/office/events/office_harem_common.rpy:3217
translate russian audrey_lavish_male_ending_101688db:
    audrey.say "Да, я немного обалдела, узнав, что [lssb_common.hero_name()] встречается и с другими девушками в офисе."

# ch/harems_full/office/events/office_harem_common.rpy:3218
translate russian audrey_lavish_male_ending_584b7d13:
    audrey.say "Обычно это я всех шокирую, понимаете?"

# ch/harems_full/office/events/office_harem_common.rpy:3219
translate russian audrey_lavish_male_ending_b723cbd8:
    audrey.say "Но больше участников — больше возможностей повеселиться!"

# ch/harems_full/office/events/office_harem_common.rpy:3220
translate russian audrey_lavish_male_ending_1c508feb:
    lavish.say "Мне не нравилось, что [lssb_common.hero_name()] и я встречаемся не только друг с другом."

# ch/harems_full/office/events/office_harem_common.rpy:3221
translate russian audrey_lavish_male_ending_88cd0374:
    lavish.say "Но потом я подумала и увидела преимущества."

# ch/harems_full/office/events/office_harem_common.rpy:3222
translate russian audrey_lavish_male_ending_33be693a:
    lavish.say "Во многом так эффективнее и гибче. И НАМНОГО увлекательнее!"

# ch/harems_full/office/events/office_harem_common.rpy:3223
translate russian audrey_lavish_male_ending_0092b8b7:
    audrey.say "Поверьте, я никогда не думала, что выйду замуж даже за одного человека."

# ch/harems_full/office/events/office_harem_common.rpy:3224
translate russian audrey_lavish_male_ending_059e8d07:
    audrey.say "Так могла ли я представить брак сразу с несколькими?!"

# ch/harems_full/office/events/office_harem_common.rpy:3225
translate russian audrey_lavish_male_ending_c0246911:
    audrey.say "Ну... может, я именно поэтому и согласилась: идея-то безумная!"

# ch/harems_full/office/events/office_harem_common.rpy:3226
translate russian audrey_lavish_male_ending_f9b87953:
    lavish.say "Знаю, как безумно звучит желание пожениться со всеми, с кем я спала."

# ch/harems_full/office/events/office_harem_common.rpy:3227
translate russian audrey_lavish_male_ending_d56a140d:
    lavish.say "Но вы должны понять: всё складывалось очень хорошо."

# ch/harems_full/office/events/office_harem_common.rpy:3228
translate russian audrey_lavish_male_ending_be296e69:
    lavish.say "Иногда и одного подходящего партнёра найти — удача, не говоря уже о нескольких!"

# ch/harems_full/office/events/office_harem_common.rpy:3229
translate russian audrey_lavish_male_ending_c660529e:
    audrey.say "Все говорят, что после свадьбы я стала спокойнее и остепенилась."

# ch/harems_full/office/events/office_harem_common.rpy:3230
translate russian audrey_lavish_male_ending_697d0dbb:
    audrey.say "И знаете, что меня в этом больше всего бесит? То, что они вроде бы правы."

# ch/harems_full/office/events/office_harem_common.rpy:3231
translate russian audrey_lavish_male_ending_96b577b4:
    audrey.say "Рядом столько людей, о которых я могу заботиться и которые заботятся обо мне, — я уже не такая злая, как раньше!"

# ch/harems_full/office/events/office_harem_common.rpy:3232
translate russian audrey_lavish_male_ending_b011dd69:
    lavish.say "Я всегда была готова пожертвовать замужеством ради карьеры."

# ch/harems_full/office/events/office_harem_common.rpy:3233
translate russian audrey_lavish_male_ending_15811ba1:
    lavish.say "Но теперь, когда я замужем, понимаю, что выбирать необязательно."

# ch/harems_full/office/events/office_harem_common.rpy:3234
translate russian audrey_lavish_male_ending_15455b40:
    lavish.say "Ведь рядом все, кого я люблю, и они готовы меня поддержать!"

# ch/harems_full/office/events/office_harem_common.rpy:3235
translate russian audrey_lavish_male_ending_3e7ffed2:
    audrey.say "Впереди нас ждёт много интересного!"

# ch/harems_full/office/events/office_harem_common.rpy:3236
translate russian audrey_lavish_male_ending_3a6c24a1:
    lavish.say "Кто знает, как высоко мы сможем подняться и как далеко зайти вместе!"

# ch/harems_full/office/events/office_harem_common.rpy:3243
translate russian aletta_shiori_male_ending_163e3150:
    "Знаете, я уже даже не помню, какие планы строил, когда устроился на нынешнюю работу."

# ch/harems_full/office/events/office_harem_common.rpy:3244
translate russian aletta_shiori_male_ending_afe3281b:
    "Собирался ли подниматься по карьерной лестнице так высоко, как смогу."

# ch/harems_full/office/events/office_harem_common.rpy:3245
translate russian aletta_shiori_male_ending_94c63a64:
    "Или просто хотел оплачивать счета, пока не найдётся что-то получше."

# ch/harems_full/office/events/office_harem_common.rpy:3246
translate russian aletta_shiori_male_ending_24743f63:
    "Но точно не думал встретить там будущих спутниц жизни!"

# ch/harems_full/office/events/office_harem_common.rpy:3247
translate russian aletta_shiori_male_ending_687b5cb6:
    "Насколько помню, я просто собирался немного повеселиться в офисе."

# ch/harems_full/office/events/office_harem_common.rpy:3248
translate russian aletta_shiori_male_ending_09d11206:
    "Ну, бездельничать и снимать рабочий стресс приятным общением с коллегами."

# ch/harems_full/office/events/office_harem_common.rpy:3249
translate russian aletta_shiori_male_ending_6c102b68:
    "Но одно потянулось за другим, и вот я здесь."

# ch/harems_full/office/events/office_harem_common.rpy:3250
translate russian aletta_shiori_male_ending_822fefa7:
    "Стою у алтаря и жду, когда те самые коллеги присоединятся ко мне."

# ch/harems_full/office/events/office_harem_common.rpy:3251
translate russian aletta_shiori_male_ending_1e6bb361:
    "Никогда бы не предположил, что всё закончится свадьбой."

# ch/harems_full/office/events/office_harem_common.rpy:3252
translate russian aletta_shiori_male_ending_3f238e55:
    "Тем более сразу с несколькими девушками с работы!"

# ch/harems_full/office/events/office_harem_common.rpy:3253
translate russian aletta_shiori_male_ending_0e3e2a13:
    "Не то чтобы я жаловался, понимаете?"

# ch/harems_full/office/events/office_harem_common.rpy:3254
translate russian aletta_shiori_male_ending_1cf1fe8c:
    "Я очень рад оказаться здесь."

# ch/harems_full/office/events/office_harem_common.rpy:3255
translate russian aletta_shiori_male_ending_a16093fe:
    "Просто сейчас моя жизнь напоминает американские горки!"

# ch/harems_full/office/events/office_harem_common.rpy:3256
translate russian aletta_shiori_male_ending_72c660cb:
    "Чтобы отвлечься, я оглядываю часовню."

# ch/harems_full/office/events/office_harem_common.rpy:3257
translate russian aletta_shiori_male_ending_62bccaf4:
    "Она красиво украшена, и это уже само по себе чудо."

# ch/harems_full/office/events/office_harem_common.rpy:3258
translate russian aletta_shiori_male_ending_4dcbc715:
    "Поверьте, когда оформление выбирает больше одной девушки, споры бывают жаркими!"

# ch/harems_full/office/events/office_harem_common.rpy:3259
translate russian aletta_shiori_male_ending_2d7ce45a:
    "Скамьи переполнены гостями — тоже ожидаемо, когда невест несколько."

# ch/harems_full/office/events/office_harem_common.rpy:3260
translate russian aletta_shiori_male_ending_f7ea0744:
    "Оглядывая ряд за рядом, я узнаю некоторые обращённые ко мне лица."

# ch/harems_full/office/events/office_harem_common.rpy:3261
translate russian aletta_shiori_male_ending_86f39f93:
    "Но разве можно знать здесь всех?"

# ch/harems_full/office/events/office_harem_common.rpy:3262
translate russian aletta_shiori_male_ending_03c31662:
    "Каждый участник свадьбы привёл целую толпу своих гостей."

# ch/harems_full/office/events/office_harem_common.rpy:3263
translate russian aletta_shiori_male_ending_de9f50a4:
    "Разобраться, кто к кому относится, почти невозможно!"

# ch/harems_full/office/events/office_harem_common.rpy:3264
translate russian aletta_shiori_male_ending_ccf5169a:
    "Я уже думаю попросить у девушек фотографии родственников с пояснениями."

# ch/harems_full/office/events/office_harem_common.rpy:3265
translate russian aletta_shiori_male_ending_f4e85421:
    "И тут часовню наполняет музыка."

# ch/harems_full/office/events/office_harem_common.rpy:3266
translate russian aletta_shiori_male_ending_29c59cdd:
    "Разумеется, я тут же прихожу в себя и выпрямляюсь почти по стойке смирно."

# ch/harems_full/office/events/office_harem_common.rpy:3267
translate russian aletta_shiori_male_ending_4ba2f2ee:
    "Как я могу не узнать эту музыку и не понять, что она означает?"

# ch/harems_full/office/events/office_harem_common.rpy:3268
translate russian aletta_shiori_male_ending_7f5b0022:
    "Я ведь сам оказался в центре споров о том, под что они пойдут к алтарю!"

# ch/harems_full/office/events/office_harem_common.rpy:3269
translate russian aletta_shiori_male_ending_be3eda7a:
    "Но воспоминания о последней ссоре и достигнутом компромиссе вдруг исчезают."

# ch/harems_full/office/events/office_harem_common.rpy:3270
translate russian aletta_shiori_male_ending_19827532:
    "Потому что я вижу только девушек, которые входят в часовню и идут по проходу."

# ch/harems_full/office/events/office_harem_common.rpy:3272
translate russian aletta_shiori_male_ending_5f9bfcb3:
    "Алетта идёт первой, словно возглавляет шествие."

# ch/harems_full/office/events/office_harem_common.rpy:3273
translate russian aletta_shiori_male_ending_13d712ad:
    "Голову держит высоко, как королева."

# ch/harems_full/office/events/office_harem_common.rpy:3274
translate russian aletta_shiori_male_ending_48929c23:
    "От одного её вида сердце бьётся быстрее."

# ch/harems_full/office/events/office_harem_common.rpy:3276
translate russian aletta_shiori_male_ending_61481264:
    "Я почти не замечаю, что она беременна."

# ch/harems_full/office/events/office_harem_common.rpy:3277
translate russian aletta_shiori_male_ending_55dfaa7f:
    "Платье так удачно скроено, что почти скрывает живот."

# ch/harems_full/office/events/office_harem_common.rpy:3278
translate russian aletta_shiori_male_ending_cb879e7a:
    "Почти, но не совсем. И, наверное, именно в этом вся прелесть."

# ch/harems_full/office/events/office_harem_common.rpy:3280
translate russian aletta_shiori_male_ending_44563d73:
    "Сиори идёт последней, но именно на ней я дольше всего задерживаю взгляд."

# ch/harems_full/office/events/office_harem_common.rpy:3281
translate russian aletta_shiori_male_ending_0a48bf25:
    "Конечно, в своём платье она просто прекрасна."

# ch/harems_full/office/events/office_harem_common.rpy:3282
translate russian aletta_shiori_male_ending_7efc02d1:
    "Но важнее всего для меня то, что она улыбается."

# ch/harems_full/office/events/office_harem_common.rpy:3283
translate russian aletta_shiori_male_ending_ade0bdc1:
    "И я чувствую прилив счастья, зная, что она тоже счастлива."

# ch/harems_full/office/events/office_harem_common.rpy:3285
translate russian aletta_shiori_male_ending_71a6d072:
    "Может, дело ещё и в виде её живота?"

# ch/harems_full/office/events/office_harem_common.rpy:3286
translate russian aletta_shiori_male_ending_2f4773ce:
    "Мы одновременно женимся и начинаем новую семью."

# ch/harems_full/office/events/office_harem_common.rpy:3287
translate russian aletta_shiori_male_ending_bd9dd1ec:
    "Для всех нас это и правда начало новой жизни!"

# ch/harems_full/office/events/office_harem_common.rpy:3288
translate russian aletta_shiori_male_ending_a0c4ba2c:
    "Когда девушки подходят к алтарю, я неловко отодвигаюсь."

# ch/harems_full/office/events/office_harem_common.rpy:3289
translate russian aletta_shiori_male_ending_3043fcb4:
    "Они одна за другой встают рядом, то и дело меняясь местами."

# ch/harems_full/office/events/office_harem_common.rpy:3290
translate russian aletta_shiori_male_ending_ac482e86:
    "Конечно, мы пытались разобраться со всем этим на недавней репетиции."

# ch/harems_full/office/events/office_harem_common.rpy:3291
translate russian aletta_shiori_male_ending_378f4c4f:
    "Но, думаю, все толкаются из-за волнения."

# ch/harems_full/office/events/office_harem_common.rpy:3292
translate russian aletta_shiori_male_ending_c5b3de92:
    "Когда места наконец хватает всем, мы обмениваемся улыбками и взглядами."

# ch/harems_full/office/events/office_harem_common.rpy:3293
translate russian aletta_shiori_male_ending_e0a1dc8d:
    "Вижу, что каждая девушка чувствует себя так же, как я."

# ch/harems_full/office/events/office_harem_common.rpy:3294
translate russian aletta_shiori_male_ending_e220e585:
    "Эта странная смесь восторга и почти страха, от которой трепещет всё внутри!"

# ch/harems_full/office/events/office_harem_common.rpy:3296
translate russian aletta_shiori_male_ending_2a3aa788:
    "Мы все разом смотрим на священника."

# ch/harems_full/office/events/office_harem_common.rpy:3297
translate russian aletta_shiori_male_ending_b515515b:
    "Он жестом показывает, что церемония начинается."

# ch/harems_full/office/events/office_harem_common.rpy:3298
translate russian aletta_shiori_male_ending_6475c777:
    "Я рад, что он так уверенно берёт всё в свои руки."

# ch/harems_full/office/events/office_harem_common.rpy:3299
translate russian aletta_shiori_male_ending_bb69a3eb:
    "Потому что мы сразу сосредотачиваемся и следуем указаниям."

# ch/harems_full/office/events/office_harem_common.rpy:3301
translate russian aletta_shiori_male_ending_d601e095:
    "Священник" "Мы собрались здесь сегодня..."

# ch/harems_full/office/events/office_harem_common.rpy:3302
translate russian aletta_shiori_male_ending_c0a13476:
    "Священник" "Чтобы соединить этих людей — и я действительно имею в виду ВСЕХ!"

# ch/harems_full/office/events/office_harem_common.rpy:3303
translate russian aletta_shiori_male_ending_d05a0e2d:
    "Среди гостей прокатывается смех в ответ на маленькую шутку."

# ch/harems_full/office/events/office_harem_common.rpy:3304
translate russian aletta_shiori_male_ending_36cf52b2:
    "Но священник продолжает, и все снова умолкают."

# ch/harems_full/office/events/office_harem_common.rpy:3305
translate russian aletta_shiori_male_ending_20520034:
    "Священник" "Священными узами брака..."

# ch/harems_full/office/events/office_harem_common.rpy:3306
translate russian aletta_shiori_male_ending_22fe795c:
    "Остальная церемония проходит примерно так, как вы и представляете."

# ch/harems_full/office/events/office_harem_common.rpy:3307
translate russian aletta_shiori_male_ending_f3f3e6b5:
    "А чего вы ожидали?"

# ch/harems_full/office/events/office_harem_common.rpy:3308
translate russian aletta_shiori_male_ending_bb5a9817:
    "Призыва демонов и жертвоприношения животных?"

# ch/harems_full/office/events/office_harem_common.rpy:3309
translate russian aletta_shiori_male_ending_9b5d2ac7:
    "От обычной свадьбы отличается лишь то, что всё повторяют больше двух раз."

# ch/harems_full/office/events/office_harem_common.rpy:3310
translate russian aletta_shiori_male_ending_b9a1186d:
    "Священник" "Согласны ли вы, Алетта, вступить с этими людьми..."

# ch/harems_full/office/events/office_harem_common.rpy:3311
translate russian aletta_shiori_male_ending_8c7361cd:
    "Священник" "В законный брак?"

# ch/harems_full/office/events/office_harem_common.rpy:3314
translate russian aletta_shiori_male_ending_c5007986:
    "Священник" "Согласны ли вы, Сиори, вступить с этими людьми..."

# ch/harems_full/office/events/office_harem_common.rpy:3315
translate russian aletta_shiori_male_ending_8c7361cd_1:
    "Священник" "В законный брак?"

# ch/harems_full/office/events/office_harem_common.rpy:3317
translate russian aletta_shiori_male_ending_d1bfdb33:
    shiori.say "Согласна."

# ch/harems_full/office/events/office_harem_common.rpy:3318
translate russian aletta_shiori_male_ending_f732b602:
    "Священник" "И наконец..."

# ch/harems_full/office/events/office_harem_common.rpy:3319
translate russian aletta_shiori_male_ending_a9301f98:
    "Священник" "Согласны ли вы, [lssb_common.hero_name()], вступить с этими людьми..."

# ch/harems_full/office/events/office_harem_common.rpy:3320
translate russian aletta_shiori_male_ending_8c7361cd_2:
    "Священник" "В законный брак?"

# ch/harems_full/office/events/office_harem_common.rpy:3321
translate russian aletta_shiori_male_ending_cc481164:
    mike.say "Согласен."

# ch/harems_full/office/events/office_harem_common.rpy:3322
translate russian aletta_shiori_male_ending_c088e303:
    "Священник кивает и на миг переводит дух."

# ch/harems_full/office/events/office_harem_common.rpy:3323
translate russian aletta_shiori_male_ending_58c83231:
    "Священник" "Обращаюсь ко всем присутствующим..."

# ch/harems_full/office/events/office_harem_common.rpy:3324
translate russian aletta_shiori_male_ending_34d3fae8:
    "Священник" "Если кому-то известна законная причина, по которой эти люди не могут заключить брак..."

# ch/harems_full/office/events/office_harem_common.rpy:3325
translate russian aletta_shiori_male_ending_713d080b:
    "Священник" "Скажите сейчас или молчите вечно!"

# ch/harems_full/office/events/office_harem_common.rpy:3326
translate russian aletta_shiori_male_ending_59eeee8b:
    "Повисает привычная пауза: гости посмеиваются и оглядываются."

# ch/harems_full/office/events/office_harem_common.rpy:3327
translate russian aletta_shiori_male_ending_2bdc3a2c:
    "Может, они ждут, что сейчас в часовню ворвётся армия разгневанных бывших."

# ch/harems_full/office/events/office_harem_common.rpy:3328
translate russian aletta_shiori_male_ending_96cf9a58:
    "Но, к счастью, ничего столь невероятного не происходит."

# ch/harems_full/office/events/office_harem_common.rpy:3329
translate russian aletta_shiori_male_ending_e054f310:
    "Священник" "Что ж..."

# ch/harems_full/office/events/office_harem_common.rpy:3330
translate russian aletta_shiori_male_ending_7d5acc60:
    "Священник" "Объявляю вас супругами."

# ch/harems_full/office/events/office_harem_common.rpy:3331
translate russian aletta_shiori_male_ending_64235e41:
    "Священник" "Можете... эм..."

# ch/harems_full/office/events/office_harem_common.rpy:3332
translate russian aletta_shiori_male_ending_9751f813:
    "Священник" "Ну... сделать что-нибудь подобающее случаю!"

# ch/harems_full/office/events/office_harem_common.rpy:3333
translate russian aletta_shiori_male_ending_c2d44e57:
    "На этих словах священника мы все обнимаемся."

# ch/harems_full/office/events/office_harem_common.rpy:3334
translate russian aletta_shiori_male_ending_d4a89fae:
    "Переплетая руки и прижимаясь друг к другу."

# ch/harems_full/office/events/office_harem_common.rpy:3335
translate russian aletta_shiori_male_ending_7f03cb6b:
    "Наверное, наши отношения чем-то на это похожи."

# ch/harems_full/office/events/office_harem_common.rpy:3336
translate russian aletta_shiori_male_ending_4c722292:
    "Мы не всегда понимаем, как всё должно быть устроено."

# ch/harems_full/office/events/office_harem_common.rpy:3337
translate russian aletta_shiori_male_ending_c64d880a:
    "Но чувствуем, что нам хорошо вместе, и только это по-настоящему важно."

# ch/harems_full/office/events/office_harem_common.rpy:3340
translate russian aletta_shiori_male_ending_fb135262:
    aletta.say "Было бы лучше, если бы с самого начала всё было так."

# ch/harems_full/office/events/office_harem_common.rpy:3341
translate russian aletta_shiori_male_ending_3fee3f60:
    aletta.say "В самом деле, вы думаете, [lssb_common.hero_name()] всегда будет совершенно честен?"

# ch/harems_full/office/events/office_harem_common.rpy:3342
translate russian aletta_shiori_male_ending_0bee8452:
    aletta.say "Нам-то известно, что его словам не всегда можно верить."

# ch/harems_full/office/events/office_harem_common.rpy:3343
translate russian aletta_shiori_male_ending_18edf2c6:
    aletta.say "В конце концов, мы видели содержимое его трусов после того, как он его нам описывал!"

# ch/harems_full/office/events/office_harem_common.rpy:3344
translate russian aletta_shiori_male_ending_16de9855:
    shiori.say "Я... я не знаю, стоит ли нам это делать, когда [lssb_common.hero_name()] не здесь!"

# ch/harems_full/office/events/office_harem_common.rpy:3345
translate russian aletta_shiori_male_ending_93d00ac6:
    shiori.say "Ведь без него ничего этого вообще бы не было, правда?"

# ch/harems_full/office/events/office_harem_common.rpy:3346
translate russian aletta_shiori_male_ending_58f159c1:
    shiori.say "Ох... надеюсь, он не расстроится из-за того, что все о нём говорят!"

# ch/harems_full/office/events/office_harem_common.rpy:3347
translate russian aletta_shiori_male_ending_e32e38b6:
    aletta.say "Может, начнём с начала?"

# ch/harems_full/office/events/office_harem_common.rpy:3348
translate russian aletta_shiori_male_ending_d4ce6e65:
    aletta.say "[lssb_common.hero_name()] работал подо мной, когда мы познакомились в офисе. Простите за столь очевидную двусмысленность!"

# ch/harems_full/office/events/office_harem_common.rpy:3349
translate russian aletta_shiori_male_ending_da247318:
    aletta.say "Поначалу он меня не впечатлил, хотя говорят, что мне трудно угодить."

# ch/harems_full/office/events/office_harem_common.rpy:3350
translate russian aletta_shiori_male_ending_f3d293b5:
    shiori.say "Я ТАК волновалась, когда [lssb_common.hero_name()] стал моим коллегой."

# ch/harems_full/office/events/office_harem_common.rpy:3351
translate russian aletta_shiori_male_ending_622a24ff:
    shiori.say "Деньги были очень нужны, счета копились."

# ch/harems_full/office/events/office_harem_common.rpy:3352
translate russian aletta_shiori_male_ending_972679c4:
    shiori.say "Я была уверена, что не понравлюсь ему, что он сочтёт меня бесполезной!"

# ch/harems_full/office/events/office_harem_common.rpy:3353
translate russian aletta_shiori_male_ending_278dc089:
    aletta.say "Но должна признать: он доказал, что я ошибалась."

# ch/harems_full/office/events/office_harem_common.rpy:3354
translate russian aletta_shiori_male_ending_1257bf5f:
    aletta.say "В том смысле, что как человек оказался приятнее, чем я ожидала."

# ch/harems_full/office/events/office_harem_common.rpy:3355
translate russian aletta_shiori_male_ending_7b99ac54:
    aletta.say "А вот в работе он, откровенно говоря, безнадёжен без моей поддержки!"

# ch/harems_full/office/events/office_harem_common.rpy:3356
translate russian aletta_shiori_male_ending_ff6555d0:
    shiori.say "Конечно, [lssb_common.hero_name()] иногда терял со мной терпение. В худшие дни я сама не своя!"

# ch/harems_full/office/events/office_harem_common.rpy:3357
translate russian aletta_shiori_male_ending_8f1c0660:
    shiori.say "Но обычно он был терпелив и добр, и я чувствовала, что меня ценят."

# ch/harems_full/office/events/office_harem_common.rpy:3358
translate russian aletta_shiori_male_ending_63daadda:
    shiori.say "И с каждым днём всё сильнее к нему привязывалась."

# ch/harems_full/office/events/office_harem_common.rpy:3359
translate russian aletta_shiori_male_ending_13bfef04:
    aletta.say "Не успела оглянуться, как мы уже общались вне работы!"

# ch/harems_full/office/events/office_harem_common.rpy:3360
translate russian aletta_shiori_male_ending_1162e5bd:
    aletta.say "Сама виновата: нужно было внимательнее следить за статусом наших отношений."

# ch/harems_full/office/events/office_harem_common.rpy:3361
translate russian aletta_shiori_male_ending_af140e8f:
    aletta.say "Но было уже поздно: [lssb_common.hero_name()] сумел втереться ко мне в сердце!"

# ch/harems_full/office/events/office_harem_common.rpy:3362
translate russian aletta_shiori_male_ending_3ee1254c:
    shiori.say "Я правда старалась сохранить деловые отношения, но так хотела ему угодить!"

# ch/harems_full/office/events/office_harem_common.rpy:3363
translate russian aletta_shiori_male_ending_c7fea004:
    shiori.say "[lssb_common.hero_name()] просил — и я делала всё, причём с удовольствием."

# ch/harems_full/office/events/office_harem_common.rpy:3364
translate russian aletta_shiori_male_ending_c0b34381:
    shiori.say "А когда стало ясно, что ему это тоже нравится... я уже была безнадёжно влюблена!"

# ch/harems_full/office/events/office_harem_common.rpy:3365
translate russian aletta_shiori_male_ending_ae7dde37:
    aletta.say "После этого мы словно начали вместе подниматься по карьерной лестнице."

# ch/harems_full/office/events/office_harem_common.rpy:3366
translate russian aletta_shiori_male_ending_c9d219a5:
    aletta.say "Чем серьёзнее становились наши отношения, тем успешнее [lssb_common.hero_name()] и я работали."

# ch/harems_full/office/events/office_harem_common.rpy:3367
translate russian aletta_shiori_male_ending_8f0d010a:
    aletta.say "Не успела оглянуться, как мы оказались на самой вершине!"

# ch/harems_full/office/events/office_harem_common.rpy:3368
translate russian aletta_shiori_male_ending_15fe1caf:
    shiori.say "Я так радовалась, когда [lssb_common.hero_name()] начал получать повышения."

# ch/harems_full/office/events/office_harem_common.rpy:3369
translate russian aletta_shiori_male_ending_c78790c4:
    shiori.say "А когда радовался и он, то становился ещё добрее ко мне."

# ch/harems_full/office/events/office_harem_common.rpy:3370
translate russian aletta_shiori_male_ending_e623b8db:
    shiori.say "Мне хочется верить, что я помогла ему добиться такого успеха!"

# ch/harems_full/office/events/office_harem_common.rpy:3371
translate russian aletta_shiori_male_ending_72e6e505:
    aletta.say "Не скажу, что обрадовалась, узнав, что наши отношения не совсем исключительные."

# ch/harems_full/office/events/office_harem_common.rpy:3372
translate russian aletta_shiori_male_ending_e30fd0c6:
    aletta.say "Но затем начала смотреть на всё это как на бизнес, понимаете?"

# ch/harems_full/office/events/office_harem_common.rpy:3373
translate russian aletta_shiori_male_ending_89a3cbeb:
    aletta.say "Партнёрство — хорошо, но компания с большим числом сотрудников ещё лучше."

# ch/harems_full/office/events/office_harem_common.rpy:3374
translate russian aletta_shiori_male_ending_20b05590:
    aletta.say "И мне по-прежнему нравится считать себя старшим партнёром!"

# ch/harems_full/office/events/office_harem_common.rpy:3375
translate russian aletta_shiori_male_ending_4ffc0cb2:
    shiori.say "Когда [lssb_common.hero_name()] сказал, что встречается с другими девушками одновременно со мной, я испугалась."

# ch/harems_full/office/events/office_harem_common.rpy:3376
translate russian aletta_shiori_male_ending_5dee63a8:
    shiori.say "Решила, что они уведут его и я снова останусь одна."

# ch/harems_full/office/events/office_harem_common.rpy:3377
translate russian aletta_shiori_male_ending_ad20697c:
    shiori.say "Но [lssb_common.hero_name()] убедил меня, что всё будет иначе: мы все состоим в одних отношениях."

# ch/harems_full/office/events/office_harem_common.rpy:3378
translate russian aletta_shiori_male_ending_f3b7f09a:
    aletta.say "К моему удивлению, всё сложилось довольно хорошо."

# ch/harems_full/office/events/office_harem_common.rpy:3379
translate russian aletta_shiori_male_ending_9fc26d54:
    aletta.say "Мы в основном ладили и стали единым целым."

# ch/harems_full/office/events/office_harem_common.rpy:3380
translate russian aletta_shiori_male_ending_df89c038:
    aletta.say "Настолько хорошо, что брак показался следующим логичным шагом."

# ch/harems_full/office/events/office_harem_common.rpy:3381
translate russian aletta_shiori_male_ending_27f98246:
    shiori.say "Мой страх, что [lssb_common.hero_name()] уйдёт к другим девушкам и бросит меня, быстро исчез."

# ch/harems_full/office/events/office_harem_common.rpy:3382
translate russian aletta_shiori_male_ending_f1773a4c:
    shiori.say "Вскоре они стали мне как сёстры... даже больше, если понимаете, о чём я!"

# ch/harems_full/office/events/office_harem_common.rpy:3383
translate russian aletta_shiori_male_ending_bfe47a19:
    shiori.say "Поэтому мысль, что [lssb_common.hero_name()], девушки и я сможем пожениться, казалась чудесной!"

# ch/harems_full/office/events/office_harem_common.rpy:3384
translate russian aletta_shiori_male_ending_214c32e2:
    aletta.say "И теперь, когда мы воплотили это в жизнь, всё по-прежнему получается."

# ch/harems_full/office/events/office_harem_common.rpy:3385
translate russian aletta_shiori_male_ending_43600446:
    aletta.say "Мы команда и дома, и в офисе. На каждом шагу действуем сообща."

# ch/harems_full/office/events/office_harem_common.rpy:3386
translate russian aletta_shiori_male_ending_0f5cba8b:
    aletta.say "Рядом все, кто помогает мне оставаться сильной и собранной. Чего ещё желать?"

# ch/harems_full/office/events/office_harem_common.rpy:3387
translate russian aletta_shiori_male_ending_113f4b18:
    shiori.say "Я уже была замужем, и ничем хорошим это не кончилось!"

# ch/harems_full/office/events/office_harem_common.rpy:3388
translate russian aletta_shiori_male_ending_8ee731b2:
    shiori.say "Но теперь всё совсем иначе: мы скорее семья, чем просто пара."

# ch/harems_full/office/events/office_harem_common.rpy:3389
translate russian aletta_shiori_male_ending_3d3f2e10:
    shiori.say "Может, если бы мой первый брак был таким, всё сложилось бы по-другому?"

# ch/harems_full/office/events/office_harem_common.rpy:3390
translate russian aletta_shiori_male_ending_ab56a6ab:
    shiori.say "Хотя я ни за что не променяла бы то, что у меня есть сейчас, на такую возможность!"

# ch/harems_full/office/events/office_harem_common.rpy:3391
translate russian aletta_shiori_male_ending_e182316e:
    aletta.say "Так что будущее у нас светлое, и мне не терпится узнать, что оно готовит!"

# ch/harems_full/office/events/office_harem_common.rpy:3392
translate russian aletta_shiori_male_ending_c1dcf20d:
    shiori.say "Теперь у меня наконец есть семья, о которой я всегда мечтала!"

# ch/harems_full/office/events/office_harem_common.rpy:3399
translate russian aletta_lavish_male_ending_163e3150:
    "Знаете, я уже даже не помню, какие планы строил, когда устроился на нынешнюю работу."

# ch/harems_full/office/events/office_harem_common.rpy:3400
translate russian aletta_lavish_male_ending_afe3281b:
    "Собирался ли подниматься по карьерной лестнице так высоко, как смогу."

# ch/harems_full/office/events/office_harem_common.rpy:3401
translate russian aletta_lavish_male_ending_94c63a64:
    "Или просто хотел оплачивать счета, пока не найдётся что-то получше."

# ch/harems_full/office/events/office_harem_common.rpy:3402
translate russian aletta_lavish_male_ending_24743f63:
    "Но точно не думал встретить там будущих спутниц жизни!"

# ch/harems_full/office/events/office_harem_common.rpy:3403
translate russian aletta_lavish_male_ending_687b5cb6:
    "Насколько помню, я просто собирался немного повеселиться в офисе."

# ch/harems_full/office/events/office_harem_common.rpy:3404
translate russian aletta_lavish_male_ending_09d11206:
    "Ну, бездельничать и снимать рабочий стресс приятным общением с коллегами."

# ch/harems_full/office/events/office_harem_common.rpy:3405
translate russian aletta_lavish_male_ending_6c102b68:
    "Но одно потянулось за другим, и вот я здесь."

# ch/harems_full/office/events/office_harem_common.rpy:3406
translate russian aletta_lavish_male_ending_822fefa7:
    "Стою у алтаря и жду, когда те самые коллеги присоединятся ко мне."

# ch/harems_full/office/events/office_harem_common.rpy:3407
translate russian aletta_lavish_male_ending_1e6bb361:
    "Никогда бы не предположил, что всё закончится свадьбой."

# ch/harems_full/office/events/office_harem_common.rpy:3408
translate russian aletta_lavish_male_ending_3f238e55:
    "Тем более сразу с несколькими девушками с работы!"

# ch/harems_full/office/events/office_harem_common.rpy:3409
translate russian aletta_lavish_male_ending_0e3e2a13:
    "Не то чтобы я жаловался, понимаете?"

# ch/harems_full/office/events/office_harem_common.rpy:3410
translate russian aletta_lavish_male_ending_1cf1fe8c:
    "Я очень рад оказаться здесь."

# ch/harems_full/office/events/office_harem_common.rpy:3411
translate russian aletta_lavish_male_ending_a16093fe:
    "Просто сейчас моя жизнь напоминает американские горки!"

# ch/harems_full/office/events/office_harem_common.rpy:3412
translate russian aletta_lavish_male_ending_72c660cb:
    "Чтобы отвлечься, я оглядываю часовню."

# ch/harems_full/office/events/office_harem_common.rpy:3413
translate russian aletta_lavish_male_ending_62bccaf4:
    "Она красиво украшена, и это уже само по себе чудо."

# ch/harems_full/office/events/office_harem_common.rpy:3414
translate russian aletta_lavish_male_ending_4dcbc715:
    "Поверьте, когда оформление выбирает больше одной девушки, споры бывают жаркими!"

# ch/harems_full/office/events/office_harem_common.rpy:3415
translate russian aletta_lavish_male_ending_2d7ce45a:
    "Скамьи переполнены гостями — тоже ожидаемо, когда невест несколько."

# ch/harems_full/office/events/office_harem_common.rpy:3416
translate russian aletta_lavish_male_ending_f7ea0744:
    "Оглядывая ряд за рядом, я узнаю некоторые обращённые ко мне лица."

# ch/harems_full/office/events/office_harem_common.rpy:3417
translate russian aletta_lavish_male_ending_86f39f93:
    "Но разве можно знать здесь всех?"

# ch/harems_full/office/events/office_harem_common.rpy:3418
translate russian aletta_lavish_male_ending_03c31662:
    "Каждый участник свадьбы привёл целую толпу своих гостей."

# ch/harems_full/office/events/office_harem_common.rpy:3419
translate russian aletta_lavish_male_ending_de9f50a4:
    "Разобраться, кто к кому относится, почти невозможно!"

# ch/harems_full/office/events/office_harem_common.rpy:3420
translate russian aletta_lavish_male_ending_ccf5169a:
    "Я уже думаю попросить у девушек фотографии родственников с пояснениями."

# ch/harems_full/office/events/office_harem_common.rpy:3421
translate russian aletta_lavish_male_ending_f4e85421:
    "И тут часовню наполняет музыка."

# ch/harems_full/office/events/office_harem_common.rpy:3422
translate russian aletta_lavish_male_ending_29c59cdd:
    "Разумеется, я тут же прихожу в себя и выпрямляюсь почти по стойке смирно."

# ch/harems_full/office/events/office_harem_common.rpy:3423
translate russian aletta_lavish_male_ending_4ba2f2ee:
    "Как я могу не узнать эту музыку и не понять, что она означает?"

# ch/harems_full/office/events/office_harem_common.rpy:3424
translate russian aletta_lavish_male_ending_7f5b0022:
    "Я ведь сам оказался в центре споров о том, под что они пойдут к алтарю!"

# ch/harems_full/office/events/office_harem_common.rpy:3425
translate russian aletta_lavish_male_ending_be3eda7a:
    "Но воспоминания о последней ссоре и достигнутом компромиссе вдруг исчезают."

# ch/harems_full/office/events/office_harem_common.rpy:3426
translate russian aletta_lavish_male_ending_19827532:
    "Потому что я вижу только девушек, которые входят в часовню и идут по проходу."

# ch/harems_full/office/events/office_harem_common.rpy:3428
translate russian aletta_lavish_male_ending_5f9bfcb3:
    "Алетта идёт первой, словно возглавляет шествие."

# ch/harems_full/office/events/office_harem_common.rpy:3429
translate russian aletta_lavish_male_ending_13d712ad:
    "Голову держит высоко, как королева."

# ch/harems_full/office/events/office_harem_common.rpy:3430
translate russian aletta_lavish_male_ending_48929c23:
    "От одного её вида сердце бьётся быстрее."

# ch/harems_full/office/events/office_harem_common.rpy:3432
translate russian aletta_lavish_male_ending_61481264:
    "Я почти не замечаю, что она беременна."

# ch/harems_full/office/events/office_harem_common.rpy:3433
translate russian aletta_lavish_male_ending_55dfaa7f:
    "Платье так удачно скроено, что почти скрывает живот."

# ch/harems_full/office/events/office_harem_common.rpy:3434
translate russian aletta_lavish_male_ending_cb879e7a:
    "Почти, но не совсем. И, наверное, именно в этом вся прелесть."

# ch/harems_full/office/events/office_harem_common.rpy:3436
translate russian aletta_lavish_male_ending_621b32f4:
    "Лавиш идёт ко мне с привычной спокойной уверенностью."

# ch/harems_full/office/events/office_harem_common.rpy:3437
translate russian aletta_lavish_male_ending_5c7a0c15:
    "Сдержанное платье лишь подчёркивает её красоту."

# ch/harems_full/office/events/office_harem_common.rpy:3438
translate russian aletta_lavish_male_ending_3c30d210:
    "Не понимаю, как ей удаётся сказать так много без единого слова."

# ch/harems_full/office/events/office_harem_common.rpy:3440
translate russian aletta_lavish_male_ending_443d5342:
    "Я почти забываю, что она беременна и это уже заметно."

# ch/harems_full/office/events/office_harem_common.rpy:3441
translate russian aletta_lavish_male_ending_1b0f172f:
    "Но тут вижу мягкий изгиб её живота."

# ch/harems_full/office/events/office_harem_common.rpy:3442
translate russian aletta_lavish_male_ending_463b28c3:
    "И вспоминаю, как сильно её люблю."

# ch/harems_full/office/events/office_harem_common.rpy:3443
translate russian aletta_lavish_male_ending_a0c4ba2c:
    "Когда девушки подходят к алтарю, я неловко отодвигаюсь."

# ch/harems_full/office/events/office_harem_common.rpy:3444
translate russian aletta_lavish_male_ending_3043fcb4:
    "Они одна за другой встают рядом, то и дело меняясь местами."

# ch/harems_full/office/events/office_harem_common.rpy:3445
translate russian aletta_lavish_male_ending_ac482e86:
    "Конечно, мы пытались разобраться со всем этим на недавней репетиции."

# ch/harems_full/office/events/office_harem_common.rpy:3446
translate russian aletta_lavish_male_ending_378f4c4f:
    "Но, думаю, все толкаются из-за волнения."

# ch/harems_full/office/events/office_harem_common.rpy:3447
translate russian aletta_lavish_male_ending_c5b3de92:
    "Когда места наконец хватает всем, мы обмениваемся улыбками и взглядами."

# ch/harems_full/office/events/office_harem_common.rpy:3448
translate russian aletta_lavish_male_ending_e0a1dc8d:
    "Вижу, что каждая девушка чувствует себя так же, как я."

# ch/harems_full/office/events/office_harem_common.rpy:3449
translate russian aletta_lavish_male_ending_e220e585:
    "Эта странная смесь восторга и почти страха, от которой трепещет всё внутри!"

# ch/harems_full/office/events/office_harem_common.rpy:3451
translate russian aletta_lavish_male_ending_2a3aa788:
    "Мы все разом смотрим на священника."

# ch/harems_full/office/events/office_harem_common.rpy:3452
translate russian aletta_lavish_male_ending_b515515b:
    "Он жестом показывает, что церемония начинается."

# ch/harems_full/office/events/office_harem_common.rpy:3453
translate russian aletta_lavish_male_ending_6475c777:
    "Я рад, что он так уверенно берёт всё в свои руки."

# ch/harems_full/office/events/office_harem_common.rpy:3454
translate russian aletta_lavish_male_ending_bb69a3eb:
    "Потому что мы сразу сосредотачиваемся и следуем указаниям."

# ch/harems_full/office/events/office_harem_common.rpy:3456
translate russian aletta_lavish_male_ending_d601e095:
    "Священник" "Мы собрались здесь сегодня..."

# ch/harems_full/office/events/office_harem_common.rpy:3457
translate russian aletta_lavish_male_ending_c0a13476:
    "Священник" "Чтобы соединить этих людей — и я действительно имею в виду ВСЕХ!"

# ch/harems_full/office/events/office_harem_common.rpy:3458
translate russian aletta_lavish_male_ending_d05a0e2d:
    "Среди гостей прокатывается смех в ответ на маленькую шутку."

# ch/harems_full/office/events/office_harem_common.rpy:3459
translate russian aletta_lavish_male_ending_36cf52b2:
    "Но священник продолжает, и все снова умолкают."

# ch/harems_full/office/events/office_harem_common.rpy:3460
translate russian aletta_lavish_male_ending_20520034:
    "Священник" "Священными узами брака..."

# ch/harems_full/office/events/office_harem_common.rpy:3461
translate russian aletta_lavish_male_ending_22fe795c:
    "Остальная церемония проходит примерно так, как вы и представляете."

# ch/harems_full/office/events/office_harem_common.rpy:3462
translate russian aletta_lavish_male_ending_f3f3e6b5:
    "А чего вы ожидали?"

# ch/harems_full/office/events/office_harem_common.rpy:3463
translate russian aletta_lavish_male_ending_bb5a9817:
    "Призыва демонов и жертвоприношения животных?"

# ch/harems_full/office/events/office_harem_common.rpy:3464
translate russian aletta_lavish_male_ending_9b5d2ac7:
    "От обычной свадьбы отличается лишь то, что всё повторяют больше двух раз."

# ch/harems_full/office/events/office_harem_common.rpy:3465
translate russian aletta_lavish_male_ending_b9a1186d:
    "Священник" "Согласны ли вы, Алетта, вступить с этими людьми..."

# ch/harems_full/office/events/office_harem_common.rpy:3466
translate russian aletta_lavish_male_ending_8c7361cd:
    "Священник" "В законный брак?"

# ch/harems_full/office/events/office_harem_common.rpy:3469
translate russian aletta_lavish_male_ending_95513d99:
    "Священник" "Согласны ли вы, Лавиш, вступить с этими людьми..."

# ch/harems_full/office/events/office_harem_common.rpy:3470
translate russian aletta_lavish_male_ending_8c7361cd_1:
    "Священник" "В законный брак?"

# ch/harems_full/office/events/office_harem_common.rpy:3472
translate russian aletta_lavish_male_ending_12994482:
    lavish.say "Согласна."

# ch/harems_full/office/events/office_harem_common.rpy:3473
translate russian aletta_lavish_male_ending_f732b602:
    "Священник" "И наконец..."

# ch/harems_full/office/events/office_harem_common.rpy:3474
translate russian aletta_lavish_male_ending_a9301f98:
    "Священник" "Согласны ли вы, [lssb_common.hero_name()], вступить с этими людьми..."

# ch/harems_full/office/events/office_harem_common.rpy:3475
translate russian aletta_lavish_male_ending_8c7361cd_2:
    "Священник" "В законный брак?"

# ch/harems_full/office/events/office_harem_common.rpy:3476
translate russian aletta_lavish_male_ending_cc481164:
    mike.say "Согласен."

# ch/harems_full/office/events/office_harem_common.rpy:3477
translate russian aletta_lavish_male_ending_c088e303:
    "Священник кивает и на миг переводит дух."

# ch/harems_full/office/events/office_harem_common.rpy:3478
translate russian aletta_lavish_male_ending_58c83231:
    "Священник" "Обращаюсь ко всем присутствующим..."

# ch/harems_full/office/events/office_harem_common.rpy:3479
translate russian aletta_lavish_male_ending_34d3fae8:
    "Священник" "Если кому-то известна законная причина, по которой эти люди не могут заключить брак..."

# ch/harems_full/office/events/office_harem_common.rpy:3480
translate russian aletta_lavish_male_ending_713d080b:
    "Священник" "Скажите сейчас или молчите вечно!"

# ch/harems_full/office/events/office_harem_common.rpy:3481
translate russian aletta_lavish_male_ending_59eeee8b:
    "Повисает привычная пауза: гости посмеиваются и оглядываются."

# ch/harems_full/office/events/office_harem_common.rpy:3482
translate russian aletta_lavish_male_ending_2bdc3a2c:
    "Может, они ждут, что сейчас в часовню ворвётся армия разгневанных бывших."

# ch/harems_full/office/events/office_harem_common.rpy:3483
translate russian aletta_lavish_male_ending_96cf9a58:
    "Но, к счастью, ничего столь невероятного не происходит."

# ch/harems_full/office/events/office_harem_common.rpy:3484
translate russian aletta_lavish_male_ending_e054f310:
    "Священник" "Что ж..."

# ch/harems_full/office/events/office_harem_common.rpy:3485
translate russian aletta_lavish_male_ending_7d5acc60:
    "Священник" "Объявляю вас супругами."

# ch/harems_full/office/events/office_harem_common.rpy:3486
translate russian aletta_lavish_male_ending_64235e41:
    "Священник" "Можете... эм..."

# ch/harems_full/office/events/office_harem_common.rpy:3487
translate russian aletta_lavish_male_ending_9751f813:
    "Священник" "Ну... сделать что-нибудь подобающее случаю!"

# ch/harems_full/office/events/office_harem_common.rpy:3488
translate russian aletta_lavish_male_ending_c2d44e57:
    "На этих словах священника мы все обнимаемся."

# ch/harems_full/office/events/office_harem_common.rpy:3489
translate russian aletta_lavish_male_ending_d4a89fae:
    "Переплетая руки и прижимаясь друг к другу."

# ch/harems_full/office/events/office_harem_common.rpy:3490
translate russian aletta_lavish_male_ending_7f03cb6b:
    "Наверное, наши отношения чем-то на это похожи."

# ch/harems_full/office/events/office_harem_common.rpy:3491
translate russian aletta_lavish_male_ending_4c722292:
    "Мы не всегда понимаем, как всё должно быть устроено."

# ch/harems_full/office/events/office_harem_common.rpy:3492
translate russian aletta_lavish_male_ending_c64d880a:
    "Но чувствуем, что нам хорошо вместе, и только это по-настоящему важно."

# ch/harems_full/office/events/office_harem_common.rpy:3495
translate russian aletta_lavish_male_ending_fb135262:
    aletta.say "Было бы лучше, если бы с самого начала всё было так."

# ch/harems_full/office/events/office_harem_common.rpy:3496
translate russian aletta_lavish_male_ending_3fee3f60:
    aletta.say "В самом деле, вы думаете, [lssb_common.hero_name()] всегда будет совершенно честен?"

# ch/harems_full/office/events/office_harem_common.rpy:3497
translate russian aletta_lavish_male_ending_0bee8452:
    aletta.say "Нам-то известно, что его словам не всегда можно верить."

# ch/harems_full/office/events/office_harem_common.rpy:3498
translate russian aletta_lavish_male_ending_18edf2c6:
    aletta.say "В конце концов, мы видели содержимое его трусов после того, как он его нам описывал!"

# ch/harems_full/office/events/office_harem_common.rpy:3499
translate russian aletta_lavish_male_ending_452dc528:
    lavish.say "Я просто обязана была высказаться, пусть даже под конец истории."

# ch/harems_full/office/events/office_harem_common.rpy:3500
translate russian aletta_lavish_male_ending_7513fa12:
    lavish.say "И не думайте, что моя любовь куда-то делась: [lssb_common.hero_name()] и все вы мне по-прежнему дороги."

# ch/harems_full/office/events/office_harem_common.rpy:3501
translate russian aletta_lavish_male_ending_1b407c2a:
    lavish.say "Но я всё-таки самая надёжная и честная из всех участников!"

# ch/harems_full/office/events/office_harem_common.rpy:3502
translate russian aletta_lavish_male_ending_e32e38b6:
    aletta.say "Может, начнём с начала?"

# ch/harems_full/office/events/office_harem_common.rpy:3503
translate russian aletta_lavish_male_ending_d4ce6e65:
    aletta.say "[lssb_common.hero_name()] работал подо мной, когда мы познакомились в офисе. Простите за столь очевидную двусмысленность!"

# ch/harems_full/office/events/office_harem_common.rpy:3504
translate russian aletta_lavish_male_ending_da247318:
    aletta.say "Поначалу он меня не впечатлил, хотя говорят, что мне трудно угодить."

# ch/harems_full/office/events/office_harem_common.rpy:3505
translate russian aletta_lavish_male_ending_c3b96b26:
    lavish.say "Когда [lssb_common.hero_name()] стал моим начальником, у меня были сомнения."

# ch/harems_full/office/events/office_harem_common.rpy:3506
translate russian aletta_lavish_male_ending_80fb32ff:
    lavish.say "Я привыкла к профессиональной обстановке и целеустремлённым коллегам."

# ch/harems_full/office/events/office_harem_common.rpy:3507
translate russian aletta_lavish_male_ending_b08e7a01:
    lavish.say "А он казался... ну, немного раздолбаем!"

# ch/harems_full/office/events/office_harem_common.rpy:3508
translate russian aletta_lavish_male_ending_278dc089:
    aletta.say "Но должна признать: он доказал, что я ошибалась."

# ch/harems_full/office/events/office_harem_common.rpy:3509
translate russian aletta_lavish_male_ending_1257bf5f:
    aletta.say "В том смысле, что как человек оказался приятнее, чем я ожидала."

# ch/harems_full/office/events/office_harem_common.rpy:3510
translate russian aletta_lavish_male_ending_7b99ac54:
    aletta.say "А вот в работе он, откровенно говоря, безнадёжен без моей поддержки!"

# ch/harems_full/office/events/office_harem_common.rpy:3511
translate russian aletta_lavish_male_ending_0a4e7805:
    lavish.say "Не могу сказать, что [lssb_common.hero_name()] опроверг мои первые впечатления."

# ch/harems_full/office/events/office_harem_common.rpy:3512
translate russian aletta_lavish_male_ending_e94e0cc3:
    lavish.say "Но вскоре выяснилось, что он гораздо лучше умеет дружить, чем делать карьеру!"

# ch/harems_full/office/events/office_harem_common.rpy:3513
translate russian aletta_lavish_male_ending_935e27cf:
    lavish.say "Наверное, тогда я и начала видеть в нём не только коллегу."

# ch/harems_full/office/events/office_harem_common.rpy:3514
translate russian aletta_lavish_male_ending_13bfef04:
    aletta.say "Не успела оглянуться, как мы уже общались вне работы!"

# ch/harems_full/office/events/office_harem_common.rpy:3515
translate russian aletta_lavish_male_ending_1162e5bd:
    aletta.say "Сама виновата: нужно было внимательнее следить за статусом наших отношений."

# ch/harems_full/office/events/office_harem_common.rpy:3516
translate russian aletta_lavish_male_ending_af140e8f:
    aletta.say "Но было уже поздно: [lssb_common.hero_name()] сумел втереться ко мне в сердце!"

# ch/harems_full/office/events/office_harem_common.rpy:3517
translate russian aletta_lavish_male_ending_8eda7546:
    lavish.say "Ах... наверное, с самого начала стоило держаться с ним профессиональнее."

# ch/harems_full/office/events/office_harem_common.rpy:3518
translate russian aletta_lavish_male_ending_b33ee2f9:
    lavish.say "Я не следила за границей между работой и удовольствием."

# ch/harems_full/office/events/office_harem_common.rpy:3519
translate russian aletta_lavish_male_ending_831ad9f1:
    lavish.say "И вскоре он стал больше чем коллегой и уж точно больше чем другом!"

# ch/harems_full/office/events/office_harem_common.rpy:3520
translate russian aletta_lavish_male_ending_ae7dde37:
    aletta.say "После этого мы словно начали вместе подниматься по карьерной лестнице."

# ch/harems_full/office/events/office_harem_common.rpy:3521
translate russian aletta_lavish_male_ending_c9d219a5:
    aletta.say "Чем серьёзнее становились наши отношения, тем успешнее [lssb_common.hero_name()] и я работали."

# ch/harems_full/office/events/office_harem_common.rpy:3522
translate russian aletta_lavish_male_ending_8f0d010a:
    aletta.say "Не успела оглянуться, как мы оказались на самой вершине!"

# ch/harems_full/office/events/office_harem_common.rpy:3523
translate russian aletta_lavish_male_ending_2a835dff:
    lavish.say "[lssb_common.hero_name()] сделал меня счастливой в личной жизни. По-настоящему счастливой!"

# ch/harems_full/office/events/office_harem_common.rpy:3524
translate russian aletta_lavish_male_ending_07275f12:
    lavish.say "А я, кажется, положительно влияла на его профессиональную жизнь."

# ch/harems_full/office/events/office_harem_common.rpy:3525
translate russian aletta_lavish_male_ending_79a567f7:
    lavish.say "Наверное, научила его работать эффективнее, раз его начали повышать!"

# ch/harems_full/office/events/office_harem_common.rpy:3526
translate russian aletta_lavish_male_ending_72e6e505:
    aletta.say "Не скажу, что обрадовалась, узнав, что наши отношения не совсем исключительные."

# ch/harems_full/office/events/office_harem_common.rpy:3527
translate russian aletta_lavish_male_ending_e30fd0c6:
    aletta.say "Но затем начала смотреть на всё это как на бизнес, понимаете?"

# ch/harems_full/office/events/office_harem_common.rpy:3528
translate russian aletta_lavish_male_ending_89a3cbeb:
    aletta.say "Партнёрство — хорошо, но компания с большим числом сотрудников ещё лучше."

# ch/harems_full/office/events/office_harem_common.rpy:3529
translate russian aletta_lavish_male_ending_20b05590:
    aletta.say "И мне по-прежнему нравится считать себя старшим партнёром!"

# ch/harems_full/office/events/office_harem_common.rpy:3530
translate russian aletta_lavish_male_ending_1c508feb:
    lavish.say "Мне не нравилось, что [lssb_common.hero_name()] и я встречаемся не только друг с другом."

# ch/harems_full/office/events/office_harem_common.rpy:3531
translate russian aletta_lavish_male_ending_88cd0374:
    lavish.say "Но потом я подумала и увидела преимущества."

# ch/harems_full/office/events/office_harem_common.rpy:3532
translate russian aletta_lavish_male_ending_33be693a:
    lavish.say "Во многом так эффективнее и гибче. И НАМНОГО увлекательнее!"

# ch/harems_full/office/events/office_harem_common.rpy:3533
translate russian aletta_lavish_male_ending_f3b7f09a:
    aletta.say "К моему удивлению, всё сложилось довольно хорошо."

# ch/harems_full/office/events/office_harem_common.rpy:3534
translate russian aletta_lavish_male_ending_9fc26d54:
    aletta.say "Мы в основном ладили и стали единым целым."

# ch/harems_full/office/events/office_harem_common.rpy:3535
translate russian aletta_lavish_male_ending_df89c038:
    aletta.say "Настолько хорошо, что брак показался следующим логичным шагом."

# ch/harems_full/office/events/office_harem_common.rpy:3536
translate russian aletta_lavish_male_ending_f9b87953:
    lavish.say "Знаю, как безумно звучит желание пожениться со всеми, с кем я спала."

# ch/harems_full/office/events/office_harem_common.rpy:3537
translate russian aletta_lavish_male_ending_d56a140d:
    lavish.say "Но вы должны понять: всё складывалось очень хорошо."

# ch/harems_full/office/events/office_harem_common.rpy:3538
translate russian aletta_lavish_male_ending_be296e69:
    lavish.say "Иногда и одного подходящего партнёра найти — удача, не говоря уже о нескольких!"

# ch/harems_full/office/events/office_harem_common.rpy:3539
translate russian aletta_lavish_male_ending_214c32e2:
    aletta.say "И теперь, когда мы воплотили это в жизнь, всё по-прежнему получается."

# ch/harems_full/office/events/office_harem_common.rpy:3540
translate russian aletta_lavish_male_ending_43600446:
    aletta.say "Мы команда и дома, и в офисе. На каждом шагу действуем сообща."

# ch/harems_full/office/events/office_harem_common.rpy:3541
translate russian aletta_lavish_male_ending_0f5cba8b:
    aletta.say "Рядом все, кто помогает мне оставаться сильной и собранной. Чего ещё желать?"

# ch/harems_full/office/events/office_harem_common.rpy:3542
translate russian aletta_lavish_male_ending_b011dd69:
    lavish.say "Я всегда была готова пожертвовать замужеством ради карьеры."

# ch/harems_full/office/events/office_harem_common.rpy:3543
translate russian aletta_lavish_male_ending_15811ba1:
    lavish.say "Но теперь, когда я замужем, понимаю, что выбирать необязательно."

# ch/harems_full/office/events/office_harem_common.rpy:3544
translate russian aletta_lavish_male_ending_15455b40:
    lavish.say "Ведь рядом все, кого я люблю, и они готовы меня поддержать!"

# ch/harems_full/office/events/office_harem_common.rpy:3545
translate russian aletta_lavish_male_ending_e182316e:
    aletta.say "Так что будущее у нас светлое, и мне не терпится узнать, что оно готовит!"

# ch/harems_full/office/events/office_harem_common.rpy:3546
translate russian aletta_lavish_male_ending_3a6c24a1:
    lavish.say "Кто знает, как высоко мы сможем подняться и как далеко зайти вместе!"

# ch/harems_full/office/events/office_harem_common.rpy:3553
translate russian aletta_audrey_male_ending_163e3150:
    "Знаете, я уже даже не помню, какие планы строил, когда устроился на нынешнюю работу."

# ch/harems_full/office/events/office_harem_common.rpy:3554
translate russian aletta_audrey_male_ending_afe3281b:
    "Собирался ли подниматься по карьерной лестнице так высоко, как смогу."

# ch/harems_full/office/events/office_harem_common.rpy:3555
translate russian aletta_audrey_male_ending_94c63a64:
    "Или просто хотел оплачивать счета, пока не найдётся что-то получше."

# ch/harems_full/office/events/office_harem_common.rpy:3556
translate russian aletta_audrey_male_ending_24743f63:
    "Но точно не думал встретить там будущих спутниц жизни!"

# ch/harems_full/office/events/office_harem_common.rpy:3557
translate russian aletta_audrey_male_ending_687b5cb6:
    "Насколько помню, я просто собирался немного повеселиться в офисе."

# ch/harems_full/office/events/office_harem_common.rpy:3558
translate russian aletta_audrey_male_ending_09d11206:
    "Ну, бездельничать и снимать рабочий стресс приятным общением с коллегами."

# ch/harems_full/office/events/office_harem_common.rpy:3559
translate russian aletta_audrey_male_ending_6c102b68:
    "Но одно потянулось за другим, и вот я здесь."

# ch/harems_full/office/events/office_harem_common.rpy:3560
translate russian aletta_audrey_male_ending_822fefa7:
    "Стою у алтаря и жду, когда те самые коллеги присоединятся ко мне."

# ch/harems_full/office/events/office_harem_common.rpy:3561
translate russian aletta_audrey_male_ending_1e6bb361:
    "Никогда бы не предположил, что всё закончится свадьбой."

# ch/harems_full/office/events/office_harem_common.rpy:3562
translate russian aletta_audrey_male_ending_3f238e55:
    "Тем более сразу с несколькими девушками с работы!"

# ch/harems_full/office/events/office_harem_common.rpy:3563
translate russian aletta_audrey_male_ending_0e3e2a13:
    "Не то чтобы я жаловался, понимаете?"

# ch/harems_full/office/events/office_harem_common.rpy:3564
translate russian aletta_audrey_male_ending_1cf1fe8c:
    "Я очень рад оказаться здесь."

# ch/harems_full/office/events/office_harem_common.rpy:3565
translate russian aletta_audrey_male_ending_a16093fe:
    "Просто сейчас моя жизнь напоминает американские горки!"

# ch/harems_full/office/events/office_harem_common.rpy:3566
translate russian aletta_audrey_male_ending_72c660cb:
    "Чтобы отвлечься, я оглядываю часовню."

# ch/harems_full/office/events/office_harem_common.rpy:3567
translate russian aletta_audrey_male_ending_62bccaf4:
    "Она красиво украшена, и это уже само по себе чудо."

# ch/harems_full/office/events/office_harem_common.rpy:3568
translate russian aletta_audrey_male_ending_4dcbc715:
    "Поверьте, когда оформление выбирает больше одной девушки, споры бывают жаркими!"

# ch/harems_full/office/events/office_harem_common.rpy:3569
translate russian aletta_audrey_male_ending_2d7ce45a:
    "Скамьи переполнены гостями — тоже ожидаемо, когда невест несколько."

# ch/harems_full/office/events/office_harem_common.rpy:3570
translate russian aletta_audrey_male_ending_f7ea0744:
    "Оглядывая ряд за рядом, я узнаю некоторые обращённые ко мне лица."

# ch/harems_full/office/events/office_harem_common.rpy:3571
translate russian aletta_audrey_male_ending_86f39f93:
    "Но разве можно знать здесь всех?"

# ch/harems_full/office/events/office_harem_common.rpy:3572
translate russian aletta_audrey_male_ending_03c31662:
    "Каждый участник свадьбы привёл целую толпу своих гостей."

# ch/harems_full/office/events/office_harem_common.rpy:3573
translate russian aletta_audrey_male_ending_de9f50a4:
    "Разобраться, кто к кому относится, почти невозможно!"

# ch/harems_full/office/events/office_harem_common.rpy:3574
translate russian aletta_audrey_male_ending_ccf5169a:
    "Я уже думаю попросить у девушек фотографии родственников с пояснениями."

# ch/harems_full/office/events/office_harem_common.rpy:3575
translate russian aletta_audrey_male_ending_f4e85421:
    "И тут часовню наполняет музыка."

# ch/harems_full/office/events/office_harem_common.rpy:3576
translate russian aletta_audrey_male_ending_29c59cdd:
    "Разумеется, я тут же прихожу в себя и выпрямляюсь почти по стойке смирно."

# ch/harems_full/office/events/office_harem_common.rpy:3577
translate russian aletta_audrey_male_ending_4ba2f2ee:
    "Как я могу не узнать эту музыку и не понять, что она означает?"

# ch/harems_full/office/events/office_harem_common.rpy:3578
translate russian aletta_audrey_male_ending_7f5b0022:
    "Я ведь сам оказался в центре споров о том, под что они пойдут к алтарю!"

# ch/harems_full/office/events/office_harem_common.rpy:3579
translate russian aletta_audrey_male_ending_be3eda7a:
    "Но воспоминания о последней ссоре и достигнутом компромиссе вдруг исчезают."

# ch/harems_full/office/events/office_harem_common.rpy:3580
translate russian aletta_audrey_male_ending_19827532:
    "Потому что я вижу только девушек, которые входят в часовню и идут по проходу."

# ch/harems_full/office/events/office_harem_common.rpy:3582
translate russian aletta_audrey_male_ending_5f9bfcb3:
    "Алетта идёт первой, словно возглавляет шествие."

# ch/harems_full/office/events/office_harem_common.rpy:3583
translate russian aletta_audrey_male_ending_13d712ad:
    "Голову держит высоко, как королева."

# ch/harems_full/office/events/office_harem_common.rpy:3584
translate russian aletta_audrey_male_ending_48929c23:
    "От одного её вида сердце бьётся быстрее."

# ch/harems_full/office/events/office_harem_common.rpy:3586
translate russian aletta_audrey_male_ending_61481264:
    "Я почти не замечаю, что она беременна."

# ch/harems_full/office/events/office_harem_common.rpy:3587
translate russian aletta_audrey_male_ending_55dfaa7f:
    "Платье так удачно скроено, что почти скрывает живот."

# ch/harems_full/office/events/office_harem_common.rpy:3588
translate russian aletta_audrey_male_ending_cb879e7a:
    "Почти, но не совсем. И, наверное, именно в этом вся прелесть."

# ch/harems_full/office/events/office_harem_common.rpy:3590
translate russian aletta_audrey_male_ending_9c17ea8b:
    "Одри каким-то образом идёт вместе с остальными и всё же держится особняком."

# ch/harems_full/office/events/office_harem_common.rpy:3591
translate russian aletta_audrey_male_ending_19ed8d0a:
    "На лице чуть язвительная, ироничная улыбка."

# ch/harems_full/office/events/office_harem_common.rpy:3592
translate russian aletta_audrey_male_ending_a1f07c5a:
    "Но в своём платье она всё равно элегантна и прекрасна."

# ch/harems_full/office/events/office_harem_common.rpy:3594
translate russian aletta_audrey_male_ending_3e02c880:
    "Одри держит букет прямо над округлившимся животом."

# ch/harems_full/office/events/office_harem_common.rpy:3595
translate russian aletta_audrey_male_ending_a76ee6d1:
    "Словно хочет показать его всему миру."

# ch/harems_full/office/events/office_harem_common.rpy:3596
translate russian aletta_audrey_male_ending_8fa30085:
    "Стоило догадаться, что она будет такой смелой и ничуть не смущённой!"

# ch/harems_full/office/events/office_harem_common.rpy:3597
translate russian aletta_audrey_male_ending_a0c4ba2c:
    "Когда девушки подходят к алтарю, я неловко отодвигаюсь."

# ch/harems_full/office/events/office_harem_common.rpy:3598
translate russian aletta_audrey_male_ending_3043fcb4:
    "Они одна за другой встают рядом, то и дело меняясь местами."

# ch/harems_full/office/events/office_harem_common.rpy:3599
translate russian aletta_audrey_male_ending_ac482e86:
    "Конечно, мы пытались разобраться со всем этим на недавней репетиции."

# ch/harems_full/office/events/office_harem_common.rpy:3600
translate russian aletta_audrey_male_ending_378f4c4f:
    "Но, думаю, все толкаются из-за волнения."

# ch/harems_full/office/events/office_harem_common.rpy:3601
translate russian aletta_audrey_male_ending_c5b3de92:
    "Когда места наконец хватает всем, мы обмениваемся улыбками и взглядами."

# ch/harems_full/office/events/office_harem_common.rpy:3602
translate russian aletta_audrey_male_ending_e0a1dc8d:
    "Вижу, что каждая девушка чувствует себя так же, как я."

# ch/harems_full/office/events/office_harem_common.rpy:3603
translate russian aletta_audrey_male_ending_e220e585:
    "Эта странная смесь восторга и почти страха, от которой трепещет всё внутри!"

# ch/harems_full/office/events/office_harem_common.rpy:3605
translate russian aletta_audrey_male_ending_2a3aa788:
    "Мы все разом смотрим на священника."

# ch/harems_full/office/events/office_harem_common.rpy:3606
translate russian aletta_audrey_male_ending_b515515b:
    "Он жестом показывает, что церемония начинается."

# ch/harems_full/office/events/office_harem_common.rpy:3607
translate russian aletta_audrey_male_ending_6475c777:
    "Я рад, что он так уверенно берёт всё в свои руки."

# ch/harems_full/office/events/office_harem_common.rpy:3608
translate russian aletta_audrey_male_ending_bb69a3eb:
    "Потому что мы сразу сосредотачиваемся и следуем указаниям."

# ch/harems_full/office/events/office_harem_common.rpy:3610
translate russian aletta_audrey_male_ending_d601e095:
    "Священник" "Мы собрались здесь сегодня..."

# ch/harems_full/office/events/office_harem_common.rpy:3611
translate russian aletta_audrey_male_ending_c0a13476:
    "Священник" "Чтобы соединить этих людей — и я действительно имею в виду ВСЕХ!"

# ch/harems_full/office/events/office_harem_common.rpy:3612
translate russian aletta_audrey_male_ending_d05a0e2d:
    "Среди гостей прокатывается смех в ответ на маленькую шутку."

# ch/harems_full/office/events/office_harem_common.rpy:3613
translate russian aletta_audrey_male_ending_36cf52b2:
    "Но священник продолжает, и все снова умолкают."

# ch/harems_full/office/events/office_harem_common.rpy:3614
translate russian aletta_audrey_male_ending_20520034:
    "Священник" "Священными узами брака..."

# ch/harems_full/office/events/office_harem_common.rpy:3615
translate russian aletta_audrey_male_ending_22fe795c:
    "Остальная церемония проходит примерно так, как вы и представляете."

# ch/harems_full/office/events/office_harem_common.rpy:3616
translate russian aletta_audrey_male_ending_f3f3e6b5:
    "А чего вы ожидали?"

# ch/harems_full/office/events/office_harem_common.rpy:3617
translate russian aletta_audrey_male_ending_bb5a9817:
    "Призыва демонов и жертвоприношения животных?"

# ch/harems_full/office/events/office_harem_common.rpy:3618
translate russian aletta_audrey_male_ending_9b5d2ac7:
    "От обычной свадьбы отличается лишь то, что всё повторяют больше двух раз."

# ch/harems_full/office/events/office_harem_common.rpy:3619
translate russian aletta_audrey_male_ending_b9a1186d:
    "Священник" "Согласны ли вы, Алетта, вступить с этими людьми..."

# ch/harems_full/office/events/office_harem_common.rpy:3620
translate russian aletta_audrey_male_ending_8c7361cd:
    "Священник" "В законный брак?"

# ch/harems_full/office/events/office_harem_common.rpy:3623
translate russian aletta_audrey_male_ending_5af96bc2:
    "Священник" "Согласны ли вы, Одри, вступить с этими людьми..."

# ch/harems_full/office/events/office_harem_common.rpy:3624
translate russian aletta_audrey_male_ending_8c7361cd_1:
    "Священник" "В законный брак?"

# ch/harems_full/office/events/office_harem_common.rpy:3626
translate russian aletta_audrey_male_ending_944edfac:
    audrey.say "Согласна."

# ch/harems_full/office/events/office_harem_common.rpy:3627
translate russian aletta_audrey_male_ending_f732b602:
    "Священник" "И наконец..."

# ch/harems_full/office/events/office_harem_common.rpy:3628
translate russian aletta_audrey_male_ending_a9301f98:
    "Священник" "Согласны ли вы, [lssb_common.hero_name()], вступить с этими людьми..."

# ch/harems_full/office/events/office_harem_common.rpy:3629
translate russian aletta_audrey_male_ending_8c7361cd_2:
    "Священник" "В законный брак?"

# ch/harems_full/office/events/office_harem_common.rpy:3630
translate russian aletta_audrey_male_ending_cc481164:
    mike.say "Согласен."

# ch/harems_full/office/events/office_harem_common.rpy:3631
translate russian aletta_audrey_male_ending_c088e303:
    "Священник кивает и на миг переводит дух."

# ch/harems_full/office/events/office_harem_common.rpy:3632
translate russian aletta_audrey_male_ending_58c83231:
    "Священник" "Обращаюсь ко всем присутствующим..."

# ch/harems_full/office/events/office_harem_common.rpy:3633
translate russian aletta_audrey_male_ending_34d3fae8:
    "Священник" "Если кому-то известна законная причина, по которой эти люди не могут заключить брак..."

# ch/harems_full/office/events/office_harem_common.rpy:3634
translate russian aletta_audrey_male_ending_713d080b:
    "Священник" "Скажите сейчас или молчите вечно!"

# ch/harems_full/office/events/office_harem_common.rpy:3635
translate russian aletta_audrey_male_ending_59eeee8b:
    "Повисает привычная пауза: гости посмеиваются и оглядываются."

# ch/harems_full/office/events/office_harem_common.rpy:3636
translate russian aletta_audrey_male_ending_2bdc3a2c:
    "Может, они ждут, что сейчас в часовню ворвётся армия разгневанных бывших."

# ch/harems_full/office/events/office_harem_common.rpy:3637
translate russian aletta_audrey_male_ending_96cf9a58:
    "Но, к счастью, ничего столь невероятного не происходит."

# ch/harems_full/office/events/office_harem_common.rpy:3638
translate russian aletta_audrey_male_ending_e054f310:
    "Священник" "Что ж..."

# ch/harems_full/office/events/office_harem_common.rpy:3639
translate russian aletta_audrey_male_ending_7d5acc60:
    "Священник" "Объявляю вас супругами."

# ch/harems_full/office/events/office_harem_common.rpy:3640
translate russian aletta_audrey_male_ending_64235e41:
    "Священник" "Можете... эм..."

# ch/harems_full/office/events/office_harem_common.rpy:3641
translate russian aletta_audrey_male_ending_9751f813:
    "Священник" "Ну... сделать что-нибудь подобающее случаю!"

# ch/harems_full/office/events/office_harem_common.rpy:3642
translate russian aletta_audrey_male_ending_c2d44e57:
    "На этих словах священника мы все обнимаемся."

# ch/harems_full/office/events/office_harem_common.rpy:3643
translate russian aletta_audrey_male_ending_d4a89fae:
    "Переплетая руки и прижимаясь друг к другу."

# ch/harems_full/office/events/office_harem_common.rpy:3644
translate russian aletta_audrey_male_ending_7f03cb6b:
    "Наверное, наши отношения чем-то на это похожи."

# ch/harems_full/office/events/office_harem_common.rpy:3645
translate russian aletta_audrey_male_ending_4c722292:
    "Мы не всегда понимаем, как всё должно быть устроено."

# ch/harems_full/office/events/office_harem_common.rpy:3646
translate russian aletta_audrey_male_ending_c64d880a:
    "Но чувствуем, что нам хорошо вместе, и только это по-настоящему важно."

# ch/harems_full/office/events/office_harem_common.rpy:3649
translate russian aletta_audrey_male_ending_fb135262:
    aletta.say "Было бы лучше, если бы с самого начала всё было так."

# ch/harems_full/office/events/office_harem_common.rpy:3650
translate russian aletta_audrey_male_ending_3fee3f60:
    aletta.say "В самом деле, вы думаете, [lssb_common.hero_name()] всегда будет совершенно честен?"

# ch/harems_full/office/events/office_harem_common.rpy:3651
translate russian aletta_audrey_male_ending_0bee8452:
    aletta.say "Нам-то известно, что его словам не всегда можно верить."

# ch/harems_full/office/events/office_harem_common.rpy:3652
translate russian aletta_audrey_male_ending_18edf2c6:
    aletta.say "В конце концов, мы видели содержимое его трусов после того, как он его нам описывал!"

# ch/harems_full/office/events/office_harem_common.rpy:3653
translate russian aletta_audrey_male_ending_db6b1ec4:
    audrey.say "Я бы и сама со всем справилась. [lssb_common.hero_name()] мог бы вообще не участвовать."

# ch/harems_full/office/events/office_harem_common.rpy:3654
translate russian aletta_audrey_male_ending_3bf1fee5:
    audrey.say "Вообще-то и ваше участие необязательно."

# ch/harems_full/office/events/office_harem_common.rpy:3655
translate russian aletta_audrey_male_ending_f555ec5b:
    audrey.say "Никто из вас не расскажет так хорошо, как я."

# ch/harems_full/office/events/office_harem_common.rpy:3656
translate russian aletta_audrey_male_ending_e32e38b6:
    aletta.say "Может, начнём с начала?"

# ch/harems_full/office/events/office_harem_common.rpy:3657
translate russian aletta_audrey_male_ending_d4ce6e65:
    aletta.say "[lssb_common.hero_name()] работал подо мной, когда мы познакомились в офисе. Простите за столь очевидную двусмысленность!"

# ch/harems_full/office/events/office_harem_common.rpy:3658
translate russian aletta_audrey_male_ending_da247318:
    aletta.say "Поначалу он меня не впечатлил, хотя говорят, что мне трудно угодить."

# ch/harems_full/office/events/office_harem_common.rpy:3659
translate russian aletta_audrey_male_ending_ec759ec2:
    audrey.say "Да, обычно я ненавижу мужчин, под которыми приходится... работать!"

# ch/harems_full/office/events/office_harem_common.rpy:3660
translate russian aletta_audrey_male_ending_63750b5e:
    audrey.say "И была почти уверена, что [lssb_common.hero_name()] окажется таким же."

# ch/harems_full/office/events/office_harem_common.rpy:3661
translate russian aletta_audrey_male_ending_a74f7b23:
    audrey.say "Но особо не переживала: таким парням я всегда устраиваю ад!"

# ch/harems_full/office/events/office_harem_common.rpy:3662
translate russian aletta_audrey_male_ending_278dc089:
    aletta.say "Но должна признать: он доказал, что я ошибалась."

# ch/harems_full/office/events/office_harem_common.rpy:3663
translate russian aletta_audrey_male_ending_1257bf5f:
    aletta.say "В том смысле, что как человек оказался приятнее, чем я ожидала."

# ch/harems_full/office/events/office_harem_common.rpy:3664
translate russian aletta_audrey_male_ending_7b99ac54:
    aletta.say "А вот в работе он, откровенно говоря, безнадёжен без моей поддержки!"

# ch/harems_full/office/events/office_harem_common.rpy:3665
translate russian aletta_audrey_male_ending_4049420f:
    audrey.say "[lssb_common.hero_name()] стал жертвой моих обычных изощрённых издевательств."

# ch/harems_full/office/events/office_harem_common.rpy:3666
translate russian aletta_audrey_male_ending_20525bae:
    audrey.say "И, чёрт возьми, мне это начало нравиться."

# ch/harems_full/office/events/office_harem_common.rpy:3667
translate russian aletta_audrey_male_ending_51ff6098:
    audrey.say "То есть больше обычного, больше, чем просто смотреть на его мучения!"

# ch/harems_full/office/events/office_harem_common.rpy:3668
translate russian aletta_audrey_male_ending_13bfef04:
    aletta.say "Не успела оглянуться, как мы уже общались вне работы!"

# ch/harems_full/office/events/office_harem_common.rpy:3669
translate russian aletta_audrey_male_ending_1162e5bd:
    aletta.say "Сама виновата: нужно было внимательнее следить за статусом наших отношений."

# ch/harems_full/office/events/office_harem_common.rpy:3670
translate russian aletta_audrey_male_ending_af140e8f:
    aletta.say "Но было уже поздно: [lssb_common.hero_name()] сумел втереться ко мне в сердце!"

# ch/harems_full/office/events/office_harem_common.rpy:3671
translate russian aletta_audrey_male_ending_ef76f68c:
    audrey.say "Вот так он меня и поймал: мне было слишком весело!"

# ch/harems_full/office/events/office_harem_common.rpy:3672
translate russian aletta_audrey_male_ending_33cfb592:
    audrey.say "Я и понять ничего не успела, как уже сама возвращалась за новой порцией."

# ch/harems_full/office/events/office_harem_common.rpy:3673
translate russian aletta_audrey_male_ending_7d9f90fe:
    audrey.say "И дня не могла прожить, не подразнив его, хотя бы ради реакции!"

# ch/harems_full/office/events/office_harem_common.rpy:3674
translate russian aletta_audrey_male_ending_ae7dde37:
    aletta.say "После этого мы словно начали вместе подниматься по карьерной лестнице."

# ch/harems_full/office/events/office_harem_common.rpy:3675
translate russian aletta_audrey_male_ending_c9d219a5:
    aletta.say "Чем серьёзнее становились наши отношения, тем успешнее [lssb_common.hero_name()] и я работали."

# ch/harems_full/office/events/office_harem_common.rpy:3676
translate russian aletta_audrey_male_ending_8f0d010a:
    aletta.say "Не успела оглянуться, как мы оказались на самой вершине!"

# ch/harems_full/office/events/office_harem_common.rpy:3677
translate russian aletta_audrey_male_ending_19e4825a:
    audrey.say "Ещё никто из тех, над кем я издевалась, не начинал получать повышения!"

# ch/harems_full/office/events/office_harem_common.rpy:3678
translate russian aletta_audrey_male_ending_2a530e68:
    audrey.say "Но чем ближе становились наши отношения, тем успешнее был [lssb_common.hero_name()]."

# ch/harems_full/office/events/office_harem_common.rpy:3679
translate russian aletta_audrey_male_ending_de1eb4f3:
    audrey.say "Вскоре он уже сидел на самой верхушке!"

# ch/harems_full/office/events/office_harem_common.rpy:3680
translate russian aletta_audrey_male_ending_72e6e505:
    aletta.say "Не скажу, что обрадовалась, узнав, что наши отношения не совсем исключительные."

# ch/harems_full/office/events/office_harem_common.rpy:3681
translate russian aletta_audrey_male_ending_e30fd0c6:
    aletta.say "Но затем начала смотреть на всё это как на бизнес, понимаете?"

# ch/harems_full/office/events/office_harem_common.rpy:3682
translate russian aletta_audrey_male_ending_89a3cbeb:
    aletta.say "Партнёрство — хорошо, но компания с большим числом сотрудников ещё лучше."

# ch/harems_full/office/events/office_harem_common.rpy:3683
translate russian aletta_audrey_male_ending_20b05590:
    aletta.say "И мне по-прежнему нравится считать себя старшим партнёром!"

# ch/harems_full/office/events/office_harem_common.rpy:3684
translate russian aletta_audrey_male_ending_101688db:
    audrey.say "Да, я немного обалдела, узнав, что [lssb_common.hero_name()] встречается и с другими девушками в офисе."

# ch/harems_full/office/events/office_harem_common.rpy:3685
translate russian aletta_audrey_male_ending_584b7d13:
    audrey.say "Обычно это я всех шокирую, понимаете?"

# ch/harems_full/office/events/office_harem_common.rpy:3686
translate russian aletta_audrey_male_ending_b723cbd8:
    audrey.say "Но больше участников — больше возможностей повеселиться!"

# ch/harems_full/office/events/office_harem_common.rpy:3687
translate russian aletta_audrey_male_ending_f3b7f09a:
    aletta.say "К моему удивлению, всё сложилось довольно хорошо."

# ch/harems_full/office/events/office_harem_common.rpy:3688
translate russian aletta_audrey_male_ending_9fc26d54:
    aletta.say "Мы в основном ладили и стали единым целым."

# ch/harems_full/office/events/office_harem_common.rpy:3689
translate russian aletta_audrey_male_ending_df89c038:
    aletta.say "Настолько хорошо, что брак показался следующим логичным шагом."

# ch/harems_full/office/events/office_harem_common.rpy:3690
translate russian aletta_audrey_male_ending_0092b8b7:
    audrey.say "Поверьте, я никогда не думала, что выйду замуж даже за одного человека."

# ch/harems_full/office/events/office_harem_common.rpy:3691
translate russian aletta_audrey_male_ending_059e8d07:
    audrey.say "Так могла ли я представить брак сразу с несколькими?!"

# ch/harems_full/office/events/office_harem_common.rpy:3692
translate russian aletta_audrey_male_ending_c0246911:
    audrey.say "Ну... может, я именно поэтому и согласилась: идея-то безумная!"

# ch/harems_full/office/events/office_harem_common.rpy:3693
translate russian aletta_audrey_male_ending_214c32e2:
    aletta.say "И теперь, когда мы воплотили это в жизнь, всё по-прежнему получается."

# ch/harems_full/office/events/office_harem_common.rpy:3694
translate russian aletta_audrey_male_ending_43600446:
    aletta.say "Мы команда и дома, и в офисе. На каждом шагу действуем сообща."

# ch/harems_full/office/events/office_harem_common.rpy:3695
translate russian aletta_audrey_male_ending_0f5cba8b:
    aletta.say "Рядом все, кто помогает мне оставаться сильной и собранной. Чего ещё желать?"

# ch/harems_full/office/events/office_harem_common.rpy:3696
translate russian aletta_audrey_male_ending_c660529e:
    audrey.say "Все говорят, что после свадьбы я стала спокойнее и остепенилась."

# ch/harems_full/office/events/office_harem_common.rpy:3697
translate russian aletta_audrey_male_ending_697d0dbb:
    audrey.say "И знаете, что меня в этом больше всего бесит? То, что они вроде бы правы."

# ch/harems_full/office/events/office_harem_common.rpy:3698
translate russian aletta_audrey_male_ending_96b577b4:
    audrey.say "Рядом столько людей, о которых я могу заботиться и которые заботятся обо мне, — я уже не такая злая, как раньше!"

# ch/harems_full/office/events/office_harem_common.rpy:3699
translate russian aletta_audrey_male_ending_e182316e:
    aletta.say "Так что будущее у нас светлое, и мне не терпится узнать, что оно готовит!"

# ch/harems_full/office/events/office_harem_common.rpy:3700
translate russian aletta_audrey_male_ending_3e7ffed2:
    audrey.say "Впереди нас ждёт много интересного!"
