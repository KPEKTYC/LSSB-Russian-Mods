translate russian aletta_audrey_lavish_shiori_propose_male_65bbe4f6:
    "По-моему, если мы поженимся, всё станет официально, верно?"

# ch/harems_full/office/events/office_harem_common.rpy:274
translate russian aletta_audrey_lavish_shiori_propose_male_df9c8fe5:
    "Больше не придётся тайком встречаться за чужими спинами и бояться, что нас застукают."

# ch/harems_full/office/events/office_harem_common.rpy:275
translate russian aletta_audrey_lavish_shiori_propose_male_afee1c3e:
    "Я прекрасно знаю, что многожёнство в нашей стране разрешили совсем недавно."

# ch/harems_full/office/events/office_harem_common.rpy:276
translate russian aletta_audrey_lavish_shiori_propose_male_630145ef:
    "Но, по мне, жениться на четырёх не так уж отличается от женитьбы на двух."

# ch/harems_full/office/events/office_harem_common.rpy:277
translate russian aletta_audrey_lavish_shiori_propose_male_74114d84:
    "Нет, настоящая разница в том, что придётся раскошелиться на четыре чёртовых кольца!"

# ch/harems_full/office/events/office_harem_common.rpy:278
translate russian aletta_audrey_lavish_shiori_propose_male_a7aef0b5:
    "И ещё собрать их всех в одном месте, чтобы сделать предложение."

# ch/harems_full/office/events/office_harem_common.rpy:279
translate russian aletta_audrey_lavish_shiori_propose_male_2687003b:
    "В конце концов я решаю притвориться, будто созываю совещание."

# ch/harems_full/office/events/office_harem_common.rpy:280
translate russian aletta_audrey_lavish_shiori_propose_male_98304d93:
    "Вот почему сейчас жду их в переговорной."

# ch/harems_full/office/events/office_harem_common.rpy:282
translate russian aletta_audrey_lavish_shiori_propose_male_8d38f9ef:
    "Алетта приходит первой, с очень деловым видом."

# ch/harems_full/office/events/office_harem_common.rpy:284
translate russian aletta_audrey_lavish_shiori_propose_male_86c46c0c:
    "Следом входит Лавиш, как всегда собранная и готовая к совещанию."

# ch/harems_full/office/events/office_harem_common.rpy:286
translate russian aletta_audrey_lavish_shiori_propose_male_3ff50c07:
    "Чуть позже нехотя подтягивается Одри: хмурая, больше занятая телефоном, чем работой."

# ch/harems_full/office/events/office_harem_common.rpy:287
translate russian aletta_audrey_lavish_shiori_propose_male_ac4b2b2c:
    "Я уже собираюсь закрыть дверь, когда вбегает Сиори."

# ch/harems_full/office/events/office_harem_common.rpy:289
translate russian aletta_audrey_lavish_shiori_propose_male_5738db24:
    shiori.say "Прости, пожалуйста, [lssb_common.hero_name()]."

# ch/harems_full/office/events/office_harem_common.rpy:290
translate russian aletta_audrey_lavish_shiori_propose_male_e9521209:
    shiori.say "Тот, кто подвозил меня на работу, опоздал."

# ch/harems_full/office/events/office_harem_common.rpy:291
translate russian aletta_audrey_lavish_shiori_propose_male_dd1efdc0:
    shiori.say "А потом оказалось, что лифты не работают."

# ch/harems_full/office/events/office_harem_common.rpy:292
translate russian aletta_audrey_lavish_shiori_propose_male_d74f7ff5:
    shiori.say "А потом..."

# ch/harems_full/office/events/office_harem_common.rpy:293
translate russian aletta_audrey_lavish_shiori_propose_male_3406129d:
    mike.say "Всё хорошо, Сиори..."

# ch/harems_full/office/events/office_harem_common.rpy:294
translate russian aletta_audrey_lavish_shiori_propose_male_193b86af:
    mike.say "Просто проходи и садись."

# ch/harems_full/office/events/office_harem_common.rpy:295
translate russian aletta_audrey_lavish_shiori_propose_male_3e5cf0cb:
    "Сиори кивает и спешит выполнить просьбу."

# ch/harems_full/office/events/office_harem_common.rpy:296
translate russian aletta_audrey_lavish_shiori_propose_male_e72d4c14:
    "Я подхожу к торцу стола, и все смотрят на меня."

# ch/harems_full/office/events/office_harem_common.rpy:297
translate russian aletta_audrey_lavish_shiori_propose_male_12820c04:
    aletta.say "Должна сказать, это непрофессионально, [lssb_common.hero_name()]."

# ch/harems_full/office/events/office_harem_common.rpy:299
translate russian aletta_audrey_lavish_shiori_propose_male_81173a57:
    aletta.say "Ты совсем не предупредил меня о совещании!"

# ch/harems_full/office/events/office_harem_common.rpy:300
translate russian aletta_audrey_lavish_shiori_propose_male_ba5b29d4:
    lavish.say "Алетта права, [lssb_common.hero_name()]."

# ch/harems_full/office/events/office_harem_common.rpy:302
translate russian aletta_audrey_lavish_shiori_propose_male_e866e559:
    lavish.say "Я не успела подготовиться за такое короткое время."

# ch/harems_full/office/events/office_harem_common.rpy:303
translate russian aletta_audrey_lavish_shiori_propose_male_1bb5b922:
    audrey.say "Значит, не сделала домашнее задание, Лавиш."

# ch/harems_full/office/events/office_harem_common.rpy:304
translate russian aletta_audrey_lavish_shiori_propose_male_7c1997fb:
    audrey.say "Кого это, чёрт возьми, волнует?"

# ch/harems_full/office/events/office_harem_common.rpy:305
translate russian aletta_audrey_lavish_shiori_propose_male_d0d58d00:
    audrey.say "Давайте уже закончим и уберёмся отсюда!"

# ch/harems_full/office/events/office_harem_common.rpy:306
translate russian aletta_audrey_lavish_shiori_propose_male_f4e3a950:
    "Я натягиваю улыбку, убеждая себя, что это хорошая идея."

# ch/harems_full/office/events/office_harem_common.rpy:307
translate russian aletta_audrey_lavish_shiori_propose_male_e5096f0b:
    "Я ведь люблю каждую из этих девушек, правда люблю."

# ch/harems_full/office/events/office_harem_common.rpy:308
translate russian aletta_audrey_lavish_shiori_propose_male_fb5985a9:
    "Но прекрасно знаю, что временами они все могут быть той ещё занозой в заднице!"

# ch/harems_full/office/events/office_harem_common.rpy:310
translate russian aletta_audrey_lavish_shiori_propose_male_4ab6d240:
    mike.say "Я не предупредил о встрече, потому что хотел сделать сюрприз."

# ch/harems_full/office/events/office_harem_common.rpy:311
translate russian aletta_audrey_lavish_shiori_propose_male_106c67c0:
    mike.say "И мне нужно было собрать вас всех вместе, чтобы сделать вот что..."

# ch/harems_full/office/events/office_harem_common.rpy:312
translate russian aletta_audrey_lavish_shiori_propose_male_3bfc1eae:
    "Я опускаюсь на одно колено и достаю из кармана четыре одинаковых кольца."

# ch/harems_full/office/events/office_harem_common.rpy:313
translate russian aletta_audrey_lavish_shiori_propose_male_6a6112fa:
    mike.say "Алетта, Одри, Лавиш, Сиори..."

# ch/harems_full/office/events/office_harem_common.rpy:315
translate russian aletta_audrey_lavish_shiori_propose_male_c795a089:
    mike.say "И друг за друга, наверное, тоже!"

# ch/harems_full/office/events/office_harem_common.rpy:320
translate russian aletta_audrey_lavish_shiori_propose_male_b5700755:
    "Впервые на моей памяти все они лишаются дара речи."

# ch/harems_full/office/events/office_harem_common.rpy:321
translate russian aletta_audrey_lavish_shiori_propose_male_4af83198:
    "Девушки смотрят на меня, затем переглядываются."

# ch/harems_full/office/events/office_harem_common.rpy:322
translate russian aletta_audrey_lavish_shiori_propose_male_c6c3d050:
    "А я всё ещё стою на одном колене и жду ответа."

# ch/harems_full/office/events/office_harem_common.rpy:325
translate russian aletta_audrey_lavish_shiori_propose_male_32e7a398:
    "Алетта по привычке сохраняет властный вид."

# ch/harems_full/office/events/office_harem_common.rpy:326
translate russian aletta_audrey_lavish_shiori_propose_male_778a549a:
    "Отвечает первой, твёрдо и уверенно."

# ch/harems_full/office/events/office_harem_common.rpy:327
translate russian aletta_audrey_lavish_shiori_propose_male_3f93e7ee:
    aletta.say "Определённо нет."

# ch/harems_full/office/events/office_harem_common.rpy:328
translate russian aletta_audrey_lavish_shiori_propose_male_4b4ee576:
    aletta.say "Для меня эти отношения прежде всего деловая договорённость."

# ch/harems_full/office/events/office_harem_common.rpy:329
translate russian aletta_audrey_lavish_shiori_propose_male_b0512339:
    aletta.say "И я не согласна превращать их в юридические обязательства."

# ch/harems_full/office/events/office_harem_common.rpy:333
translate russian aletta_audrey_lavish_shiori_propose_male_32e7a398_1:
    "Алетта по привычке сохраняет властный вид."

# ch/harems_full/office/events/office_harem_common.rpy:334
translate russian aletta_audrey_lavish_shiori_propose_male_778a549a_1:
    "Отвечает первой, твёрдо и уверенно."

# ch/harems_full/office/events/office_harem_common.rpy:336
translate russian aletta_audrey_lavish_shiori_propose_male_7760ffd5:
    aletta.say "Да, [lssb_common.hero_name()]."

# ch/harems_full/office/events/office_harem_common.rpy:337
translate russian aletta_audrey_lavish_shiori_propose_male_90dd339c:
    aletta.say "Признаюсь, в начале наших отношений я была... настроена скептически."

# ch/harems_full/office/events/office_harem_common.rpy:338
translate russian aletta_audrey_lavish_shiori_propose_male_541a9e8a:
    aletta.say "Но всё оказалось гораздо лучше, чем я могла представить."

# ch/harems_full/office/events/office_harem_common.rpy:342
translate russian aletta_audrey_lavish_shiori_propose_male_947bcb8b:
    "Одри странно кривится, словно усиленно думает."

# ch/harems_full/office/events/office_harem_common.rpy:343
translate russian aletta_audrey_lavish_shiori_propose_male_7a5bdb84:
    "А затем отвечает с обычной прямотой."

# ch/harems_full/office/events/office_harem_common.rpy:344
translate russian aletta_audrey_lavish_shiori_propose_male_90eda6e5:
    audrey.say "Чёрта с два! Ещё не хватало выйти за вас, неудачников!"

# ch/harems_full/office/events/office_harem_common.rpy:345
translate russian aletta_audrey_lavish_shiori_propose_male_5860ad2b:
    audrey.say "Мне уже достаточно того, что приходится с вами работать."

# ch/harems_full/office/events/office_harem_common.rpy:346
translate russian aletta_audrey_lavish_shiori_propose_male_d3306c4e:
    audrey.say "Забудьте о том, чтобы провести вместе ещё и всю жизнь!"

# ch/harems_full/office/events/office_harem_common.rpy:350
translate russian aletta_audrey_lavish_shiori_propose_male_947bcb8b_1:
    "Одри странно кривится, словно усиленно думает."

# ch/harems_full/office/events/office_harem_common.rpy:351
translate russian aletta_audrey_lavish_shiori_propose_male_7a5bdb84_1:
    "А затем отвечает с обычной прямотой."

# ch/harems_full/office/events/office_harem_common.rpy:353
translate russian aletta_audrey_lavish_shiori_propose_male_17387692:
    audrey.say "Да, я согласна."

# ch/harems_full/office/events/office_harem_common.rpy:354
translate russian aletta_audrey_lavish_shiori_propose_male_e53de238:
    audrey.say "Вы все по-прежнему слишком зажатые."

# ch/harems_full/office/events/office_harem_common.rpy:355
translate russian aletta_audrey_lavish_shiori_propose_male_19aa4504:
    audrey.say "И без меня вам эти палки из задниц не вытащить!"

# ch/harems_full/office/events/office_harem_common.rpy:359
translate russian aletta_audrey_lavish_shiori_propose_male_a94738bd:
    "Лавиш выглядит задумчивой, словно всерьёз взвешивает ответ."

# ch/harems_full/office/events/office_harem_common.rpy:360
translate russian aletta_audrey_lavish_shiori_propose_male_539a5760:
    "Затем кивает и коротко выдыхает."

# ch/harems_full/office/events/office_harem_common.rpy:361
translate russian aletta_audrey_lavish_shiori_propose_male_4879009e:
    lavish.say "Придётся сказать нет."

# ch/harems_full/office/events/office_harem_common.rpy:362
translate russian aletta_audrey_lavish_shiori_propose_male_a845c91a:
    lavish.say "Не думаю, что эти отношения идут мне на пользу."

# ch/harems_full/office/events/office_harem_common.rpy:363
translate russian aletta_audrey_lavish_shiori_propose_male_f79e418c:
    lavish.say "И, скорее всего, помешают моим долгосрочным карьерным планам."

# ch/harems_full/office/events/office_harem_common.rpy:367
translate russian aletta_audrey_lavish_shiori_propose_male_a94738bd_1:
    "Лавиш выглядит задумчивой, словно всерьёз взвешивает ответ."

# ch/harems_full/office/events/office_harem_common.rpy:368
translate russian aletta_audrey_lavish_shiori_propose_male_539a5760_1:
    "Затем кивает и коротко выдыхает."

# ch/harems_full/office/events/office_harem_common.rpy:370
translate russian aletta_audrey_lavish_shiori_propose_male_26ac0382:
    lavish.say "Я говорю да."

# ch/harems_full/office/events/office_harem_common.rpy:371
translate russian aletta_audrey_lavish_shiori_propose_male_f804e109:
    lavish.say "Отношения у нас, конечно, немного странные."

# ch/harems_full/office/events/office_harem_common.rpy:372
translate russian aletta_audrey_lavish_shiori_propose_male_9618b8ed:
    lavish.say "Но всё, похоже, получается, и мне очень нравится!"

# ch/harems_full/office/events/office_harem_common.rpy:376
translate russian aletta_audrey_lavish_shiori_propose_male_b134dbfd:
    "Сиори обводит взглядом всех присутствующих."

# ch/harems_full/office/events/office_harem_common.rpy:377
translate russian aletta_audrey_lavish_shiori_propose_male_0841ed9b:
    "На мгновение мне кажется, что она попросит их решить за неё."

# ch/harems_full/office/events/office_harem_common.rpy:378
translate russian aletta_audrey_lavish_shiori_propose_male_dd9a67f1:
    "Но в конце концов набирается смелости высказаться сама."

# ch/harems_full/office/events/office_harem_common.rpy:379
translate russian aletta_audrey_lavish_shiori_propose_male_0c945ab9:
    shiori.say "Я... я говорю нет."

# ch/harems_full/office/events/office_harem_common.rpy:380
translate russian aletta_audrey_lavish_shiori_propose_male_fc11a726:
    shiori.say "Мне кажется, я теряю себя в этих отношениях."

# ch/harems_full/office/events/office_harem_common.rpy:381
translate russian aletta_audrey_lavish_shiori_propose_male_f21a3a74:
    shiori.say "Будто все воспринимают меня как должное и не замечают!"

# ch/harems_full/office/events/office_harem_common.rpy:385
translate russian aletta_audrey_lavish_shiori_propose_male_b134dbfd_1:
    "Сиори обводит взглядом всех присутствующих."

# ch/harems_full/office/events/office_harem_common.rpy:386
translate russian aletta_audrey_lavish_shiori_propose_male_0841ed9b_1:
    "На мгновение мне кажется, что она попросит их решить за неё."

# ch/harems_full/office/events/office_harem_common.rpy:387
translate russian aletta_audrey_lavish_shiori_propose_male_dd9a67f1_1:
    "Но в конце концов набирается смелости высказаться сама."

# ch/harems_full/office/events/office_harem_common.rpy:389
translate russian aletta_audrey_lavish_shiori_propose_male_e482cd60:
    shiori.say "Я... я говорю да."

# ch/harems_full/office/events/office_harem_common.rpy:390
translate russian aletta_audrey_lavish_shiori_propose_male_8714c3bc:
    shiori.say "Мне нравится быть в отношениях со всеми вами."

# ch/harems_full/office/events/office_harem_common.rpy:391
translate russian aletta_audrey_lavish_shiori_propose_male_18c577cd:
    shiori.say "Я больше не чувствую себя одинокой и потерянной!"

# ch/harems_full/office/events/office_harem_common.rpy:393
translate russian aletta_audrey_lavish_shiori_propose_male_b4daf315:
    "Слушая их ответы, я чувствую, как колотится сердце."

# ch/harems_full/office/events/office_harem_common.rpy:394
translate russian aletta_audrey_lavish_shiori_propose_male_8f6f25a5:
    "Но разве могло быть иначе?"

# ch/harems_full/office/events/office_harem_common.rpy:395
translate russian aletta_audrey_lavish_shiori_propose_male_edd36fb9:
    "Я прошу их принять очень важное решение."

# ch/harems_full/office/events/office_harem_common.rpy:396
translate russian aletta_audrey_lavish_shiori_propose_male_f865e794:
    "И оно неизбежно вызовет уйму эмоций."

# ch/harems_full/office/events/office_harem_common.rpy:398
translate russian aletta_audrey_lavish_shiori_propose_male_13c7fcb6:
    "Я встаю и начинаю надевать кольца им на пальцы."

# ch/harems_full/office/events/office_harem_common.rpy:399
translate russian aletta_audrey_lavish_shiori_propose_male_d5d90334:
    "Вскоре всё готово, и девушки любуются новыми украшениями."

# ch/harems_full/office/events/office_harem_common.rpy:400
translate russian aletta_audrey_lavish_shiori_propose_male_78889186:
    "Мне хочется ущипнуть себя, чтобы убедиться, что всё происходит наяву."

# ch/harems_full/office/events/office_harem_common.rpy:401
translate russian aletta_audrey_lavish_shiori_propose_male_5bad55bf:
