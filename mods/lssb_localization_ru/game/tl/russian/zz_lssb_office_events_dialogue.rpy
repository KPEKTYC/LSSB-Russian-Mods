# ch/harems_full/office/events/events.rpy:4010
translate russian office_threesome_shiorifuck_lavish_70487806:
    shiori.say "Ты всю меня заполняешь..."

# ch/harems_full/office/events/events.rpy:4011
translate russian office_threesome_shiorifuck_lavish_ee4476d1:
    shiori.say "[lssb_common.hero_name()], пожалуйста..."

# ch/harems_full/office/events/events.rpy:4012
translate russian office_threesome_shiorifuck_lavish_6abed38f:
    shiori.say "Трахни меня!"

# ch/harems_full/office/events/events.rpy:4013
translate russian office_threesome_shiorifuck_lavish_c2f15671:
    "Сиори вовсе не обязательно меня просить!"

# ch/harems_full/office/events/events.rpy:4014
translate russian office_threesome_shiorifuck_lavish_8f9ccd53:
    "Едва она заканчивает говорить, я перехожу к делу."

# ch/harems_full/office/events/events.rpy:4015
translate russian office_threesome_shiorifuck_lavish_dd2190f3:
    "Никакого медленного начала и постепенного ускорения."

# ch/harems_full/office/events/events.rpy:4016
translate russian office_threesome_shiorifuck_lavish_c363d5ef:
    "Я сразу начинаю безжалостно долбить Сиори."

# ch/harems_full/office/events/events.rpy:4017
translate russian office_threesome_shiorifuck_lavish_bdf8cac2:
    "Она стонет и вскрикивает, голосом выражая всё, что испытывает."

# ch/harems_full/office/events/events.rpy:4018
translate russian office_threesome_shiorifuck_lavish_858623f0:
    "Громче только шлепки кожи о кожу."

# ch/harems_full/office/events/events.rpy:4019
translate russian office_threesome_shiorifuck_lavish_a2816e62:
    "Мой пах бьётся о пышные ягодицы и бёдра Сиори."

# ch/harems_full/office/events/events.rpy:4020
translate russian office_threesome_shiorifuck_lavish_312db2c2:
    "Они принимают каждый удар, дрожа и колыхаясь."

# ch/harems_full/office/events/events.rpy:4021
translate russian office_threesome_shiorifuck_lavish_0002af9c:
    "Вдруг меня пронзает острое ощущение, словно кто-то сжимает мои яйца."

# ch/harems_full/office/events/events.rpy:4022
translate russian office_threesome_shiorifuck_lavish_c972361f:
    "Достаточно взглянуть вниз, чтобы понять: я наполовину прав."

# ch/harems_full/office/events/events.rpy:4023
translate russian office_threesome_shiorifuck_lavish_504a8679:
    "Лавиш и правда взялась за них, но не сжимает."

# ch/harems_full/office/events/events.rpy:4024
translate russian office_threesome_shiorifuck_lavish_3164e001:
    "Она взяла одно в рот и теперь сосёт и ласкает его."

# ch/harems_full/office/events/events.rpy:4025
translate russian office_threesome_shiorifuck_lavish_2a1ee881:
    "Я и так тяжело дышал от усилий, с которыми трахал Сиори."

# ch/harems_full/office/events/events.rpy:4026
translate russian office_threesome_shiorifuck_lavish_a0536ce8:
    "Но теперь, когда за меня принялась ещё и Лавиш, дыхание становится судорожным."

# ch/harems_full/office/events/events.rpy:4027
translate russian office_threesome_shiorifuck_lavish_587d0002:
    "Её ласки действуют почти мгновенно, словно она нажала кнопку."

# ch/harems_full/office/events/events.rpy:4028
translate russian office_threesome_shiorifuck_lavish_43d6fc86:
    "Я понимаю: до оргазма осталось одно мгновение!"

# ch/harems_full/office/events/events.rpy:4034
translate russian office_threesome_shiorifuck_lavish_2547cf9d:
    "Я ничего не могу сделать, чтобы его остановить."

# ch/harems_full/office/events/events.rpy:4035
translate russian office_threesome_shiorifuck_lavish_66a11fb4:
    "И даже не пытаюсь, просто отдаюсь ощущениям."

# ch/harems_full/office/events/events.rpy:4038
translate russian office_threesome_shiorifuck_lavish_23119203:
    "С последним толчком я изливаюсь в Сиори."

# ch/harems_full/office/events/events.rpy:4040
translate russian office_threesome_shiorifuck_lavish_f66a4a52:
    "Принимая меня, она стонет и тихо всхлипывает."

# ch/harems_full/office/events/events.rpy:4041
translate russian office_threesome_shiorifuck_lavish_16018701:
    "Я чувствую, что она тоже кончает, дрожа на моём члене."

# ch/harems_full/office/events/events.rpy:4043
translate russian office_threesome_shiorifuck_lavish_8f973635:
    "Мне остаётся лишь собрать последние силы и успеть выйти."

# ch/harems_full/office/events/events.rpy:4045
translate russian office_threesome_shiorifuck_lavish_b442cbdf:
    "Сиори стонет, пока мой член выскальзывает из её киски."

# ch/harems_full/office/events/events.rpy:4047
translate russian office_threesome_shiorifuck_lavish_85560a0a:
    "Затем удивлённо вскрикивает, когда я кончаю на неё."

# ch/harems_full/office/events/events.rpy:4049
translate russian office_threesome_shiorifuck_lavish_bd2e6c91:
    "Сперма забрызгивает её ягодицы и спину, а часть летит мимо."

# ch/harems_full/office/events/events.rpy:4050
translate russian office_threesome_shiorifuck_lavish_a7ca266d:
    "Эти капли попадают на лицо лежащей внизу Лавиш."

# ch/harems_full/office/events/events.rpy:4051
translate russian office_threesome_shiorifuck_lavish_ce69430a:
    "Она облизывает губы, ловя всё, что может."

# ch/harems_full/office/events/events.rpy:4055
translate russian office_threesome_shiorifuck_lavish_feaee996:
