# ch/harems_full/office/events/events.rpy:3996
translate russian office_threesome_shiorifuck_lavish_e0bfbd0b:
    shiori.say "Он такой большой..."

# ch/harems_full/office/events/events.rpy:3998
translate russian office_threesome_shiorifuck_lavish_8f78f4a2:
    shiori.say "Мне страшно... но я так хочу почувствовать тебя внутри!"

# ch/harems_full/office/events/events.rpy:3999
translate russian office_threesome_shiorifuck_lavish_bb085ec4:
    "Не знаю, действительно ли Сиори сейчас страшно."

# ch/harems_full/office/events/events.rpy:4000
translate russian office_threesome_shiorifuck_lavish_60c31ca3:
    "Или она играет роль, зная, что мне это понравится."

# ch/harems_full/office/events/events.rpy:4001
translate russian office_threesome_shiorifuck_lavish_cb4984d9:
    "Но в любом случае я не могу выговорить в ответ ни слова."

# ch/harems_full/office/events/events.rpy:4002
translate russian office_threesome_shiorifuck_lavish_1636f805:
    "Мне остаётся только прижать член к её киске."

# ch/harems_full/office/events/events.rpy:4004
translate russian office_threesome_shiorifuck_lavish_330e349b:
    "Я толкаюсь изо всех сил, отчаянно желая овладеть ею."

# ch/harems_full/office/events/events.rpy:4005
translate russian office_threesome_shiorifuck_lavish_30c96874:
    "Сиори стонет и взвизгивает, пока я погружаюсь в неё."

# ch/harems_full/office/events/events.rpy:4006
translate russian office_threesome_shiorifuck_lavish_951d8add:
    "Сопротивления ровно столько, чтобы сделать ощущения ещё острее."

# ch/harems_full/office/events/events.rpy:4007
translate russian office_threesome_shiorifuck_lavish_bf0a761a:
    "Затем её тело сдаётся, и я внутри."

# ch/harems_full/office/events/events.rpy:4008
translate russian office_threesome_shiorifuck_lavish_83c26258:
    "Я вхожу до конца, так глубоко, как только могу."

# ch/harems_full/office/events/events.rpy:4009
translate russian office_threesome_shiorifuck_lavish_568b15da:
