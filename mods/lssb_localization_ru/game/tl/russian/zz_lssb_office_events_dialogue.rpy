# ch/harems_full/office/events/events.rpy:4070
translate russian office_threesome_shiorifuck_lavish_0b2de5f8:
    "Но от этого лишь сильнее хочу проникнуть внутрь."

# ch/harems_full/office/events/events.rpy:4071
translate russian office_threesome_shiorifuck_lavish_0b813aac:
    shiori.say "Ох... о боже..."

# ch/harems_full/office/events/events.rpy:4072
translate russian office_threesome_shiorifuck_lavish_304c2143:
    shiori.say "[lssb_common.hero_name()]..."

# ch/harems_full/office/events/events.rpy:4073
translate russian office_threesome_shiorifuck_lavish_bab2c150:
    shiori.say "Ты в моей... моей попе!"

# ch/harems_full/office/events/events.rpy:4074
translate russian office_threesome_shiorifuck_lavish_de1a805a:
    "Я не останавливаюсь ни на мгновение."

# ch/harems_full/office/events/events.rpy:4075
translate russian office_threesome_shiorifuck_lavish_2ee3edbc:
    "Продолжаю проталкиваться изо всех сил."

# ch/harems_full/office/events/events.rpy:4076
translate russian office_threesome_shiorifuck_lavish_5a10fa30:
    "Задница Сиори такая тугая — невероятное ощущение."

# ch/harems_full/office/events/events.rpy:4077
translate russian office_threesome_shiorifuck_lavish_06c92055:
    "А ягодицы такие мягкие!"

# ch/harems_full/office/events/events.rpy:4078
translate russian office_threesome_shiorifuck_lavish_a6de2ace:
    "Мгновение спустя я чувствую, как её мышцы поддаются."

# ch/harems_full/office/events/events.rpy:4080
translate russian office_threesome_shiorifuck_lavish_568b15da_1:
