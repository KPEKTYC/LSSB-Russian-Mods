# ch/harems_full/office/events/events.rpy:4056
translate russian office_threesome_shiorifuck_lavish_2f01fe33:
    "Значит, стоит сделать всё, чтобы Лавиш тоже участвовала."

# ch/harems_full/office/events/events.rpy:4057
translate russian office_threesome_shiorifuck_lavish_34daf11e:
    "В конце концов, хороший начальник умеет мотивировать сотрудников!"

# ch/harems_full/office/events/events.rpy:4058
translate russian office_threesome_shiorifuck_lavish_dd30f6cd_1:
