# ch/harems_full/office/events/events.rpy:4102
translate russian office_threesome_shiorifuck_lavish_7070baa0:
    "И чувствую, что тоже кончаю!"

# ch/harems_full/office/events/events.rpy:4108
translate russian office_threesome_shiorifuck_lavish_2f2b4a55:
    "Я не могу продержаться ни секунды дольше."

# ch/harems_full/office/events/events.rpy:4109
translate russian office_threesome_shiorifuck_lavish_1a08a96f:
