# ch/harems_full/office/events/events.rpy:4063
translate russian office_threesome_shiorifuck_lavish_1d77c1ae_1:
    shiori.say "Ох, [lssb_common.hero_name()]!"

# ch/harems_full/office/events/events.rpy:4064
translate russian office_threesome_shiorifuck_lavish_e0bfbd0b_1:
    shiori.say "Он такой большой..."

# ch/harems_full/office/events/events.rpy:4066
translate russian office_threesome_shiorifuck_lavish_8f78f4a2_1:
    shiori.say "Мне страшно... но я так хочу почувствовать тебя внутри!"

# ch/harems_full/office/events/events.rpy:4067
translate russian office_threesome_shiorifuck_lavish_3e1fe9c9:
    "Я хочу того же, но совсем не так, как думает Сиори!"

# ch/harems_full/office/events/events.rpy:4068
translate russian office_threesome_shiorifuck_lavish_77e28f36:
    "Одного уверенного толчка хватает, чтобы ввести головку."

# ch/harems_full/office/events/events.rpy:4069
translate russian office_threesome_shiorifuck_lavish_e24f837e:
