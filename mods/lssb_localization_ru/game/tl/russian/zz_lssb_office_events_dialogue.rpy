# ch/harems_full/office/events/events.rpy:4082
translate russian office_threesome_shiorifuck_lavish_fef18895:
    shiori.say "Пожалуйста, [lssb_common.hero_name()]..."

# ch/harems_full/office/events/events.rpy:4083
translate russian office_threesome_shiorifuck_lavish_84ab0bcd:
