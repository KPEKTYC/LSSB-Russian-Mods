# ch/harems_full/office/events/events.rpy:5074
translate russian office_foursome_cowgirl_76833fe3:
    "На долю секунды мне кажется, что в её глазах мелькает тревога."

# ch/harems_full/office/events/events.rpy:5075
translate russian office_foursome_cowgirl_19f2f642:
    "Но затем она словно стряхивает её и снова становится привычной нам Одри."

# ch/harems_full/office/events/events.rpy:5077
translate russian office_foursome_cowgirl_495ee239:
    audrey.say "Конечно, [lssb_common.hero_name()]."

# ch/harems_full/office/events/events.rpy:5078
translate russian office_foursome_cowgirl_42325db6:
    audrey.say "Покажем им, как это делается!"

# ch/harems_full/office/events/events.rpy:5079
translate russian office_foursome_cowgirl_d9c88bf9:
    "Лавиш и Сиори понимающе переглядываются."

# ch/harems_full/office/events/events.rpy:5080
translate russian office_foursome_cowgirl_38575eb1:
    "Но своими мыслями не делятся."

# ch/harems_full/office/events/events.rpy:5081
translate russian office_foursome_cowgirl_33c44836:
    "Одри берёт меня за руку и позволяет отвести себя к дивану."

# ch/harems_full/office/events/events.rpy:5082
translate russian office_foursome_cowgirl_aca58528:
    "Там я поворачиваю её к себе спиной."

# ch/harems_full/office/events/events.rpy:5083
translate russian office_foursome_cowgirl_33dedd75:
    "Я сажусь на диван, а она оглядывается через плечо."

# ch/harems_full/office/events/events.rpy:5084
translate russian office_foursome_cowgirl_205fe27e:
    "Кажется, ждёт, когда я скажу, что делать дальше."

# ch/harems_full/office/events/events.rpy:5085
translate russian office_foursome_cowgirl_dd4702c1:
    "Но, заметив мой уже твёрдый член, Одри берёт дело в свои руки."

# ch/harems_full/office/events/events.rpy:5089
translate russian office_foursome_cowgirl_77edba9b:
    "Она опускается спиной ко мне на мои колени, направляясь к члену."

# ch/harems_full/office/events/events.rpy:5090
translate russian office_foursome_cowgirl_24c54092:
    "В этот момент Лавиш и Сиори тоже присоединяются."

# ch/harems_full/office/events/events.rpy:5091
translate russian office_foursome_cowgirl_cf0f9d97:
    "Встав по обе стороны от Одри, они поддерживают её, пока она устраивается на мне верхом."

# ch/harems_full/office/events/events.rpy:5092
translate russian office_foursome_cowgirl_edabfd39:
    "Мгновение спустя я чувствую, как головка члена касается её между ног."

# ch/harems_full/office/events/events.rpy:5093
translate russian office_foursome_cowgirl_06deaa5c:
    "И слышу, как от этого ощущения Одри вскрикивает."

# ch/harems_full/office/events/events.rpy:5094
translate russian office_foursome_cowgirl_14a6191a:
    audrey.say "Ох..."

# ch/harems_full/office/events/events.rpy:5095
translate russian office_foursome_cowgirl_647f4ab4:
    audrey.say "Я... то есть, ах..."

# ch/harems_full/office/events/events.rpy:5096
translate russian office_foursome_cowgirl_d40a910b:
    audrey.say "Вот он!"

# ch/harems_full/office/events/events.rpy:5097
translate russian office_foursome_cowgirl_9cab8d41:
    "Я слышу в голосе Одри характерные нотки."

# ch/harems_full/office/events/events.rpy:5098
translate russian office_foursome_cowgirl_83226927:
    "Они выдают её попытки делать вид, будто она всё контролирует."

# ch/harems_full/office/events/events.rpy:5099
translate russian office_foursome_cowgirl_b2385692:
    "Но на самом деле она целиком в моих руках."

# ch/harems_full/office/events/events.rpy:5100
translate russian office_foursome_cowgirl_75948de3:
    "Я могу делать с ней почти всё, что захочу."

# ch/harems_full/office/events/events.rpy:5101
translate russian office_foursome_cowgirl_d775a933:
    "И сейчас подходящий момент ей об этом напомнить..."

# ch/harems_full/office/events/events.rpy:5105
translate russian office_foursome_cowgirl_29741546:
    "Если Одри так хочет мой член, нет причин ей отказывать."

# ch/harems_full/office/events/events.rpy:5106
translate russian office_foursome_cowgirl_f4f08f89:
    "Но она ведь так и не сказала, куда именно его хочет."

# ch/harems_full/office/events/events.rpy:5107
translate russian office_foursome_cowgirl_f7bc9997:
    "Может, преподнести ей сюрприз?"

# ch/harems_full/office/events/events.rpy:5108
translate russian office_foursome_cowgirl_06a2b9e3:
    "Я крепко обхватываю Одри за талию."

# ch/harems_full/office/events/events.rpy:5109
translate russian office_foursome_cowgirl_f8869c01:
    "Затем тяну её вниз особым образом..."

# ch/harems_full/office/events/events.rpy:5110
translate russian office_foursome_cowgirl_1c94e7f1:
    audrey.say "Чт..."

# ch/harems_full/office/events/events.rpy:5111
translate russian office_foursome_cowgirl_6dced9f6:
    audrey.say "Погоди-ка..."

# ch/harems_full/office/events/events.rpy:5112
translate russian office_foursome_cowgirl_317f4980:
    audrey.say "М-м-м..."

# ch/harems_full/office/events/events.rpy:5114
translate russian office_foursome_cowgirl_3e347a22:
    audrey.say "Ох, чёрт... засранец!"

# ch/harems_full/office/events/events.rpy:5115
translate russian office_foursome_cowgirl_502676e0:
    "Она ещё не закончила говорить, а мой член уже глубоко в её заднице."

# ch/harems_full/office/events/events.rpy:5116
translate russian office_foursome_cowgirl_2077a353:
    "Я чувствую каждое движение её мышц, сжимающихся вокруг меня."

# ch/harems_full/office/events/events.rpy:5117
translate russian office_foursome_cowgirl_f8373778:
    "Но продолжаю проталкиваться, пока они наконец не поддаются."

# ch/harems_full/office/events/events.rpy:5120
translate russian office_foursome_cowgirl_fee8ceca:
    audrey.say "О да..."

# ch/harems_full/office/events/events.rpy:5121
translate russian office_foursome_cowgirl_22bcad60:
    audrey.say "Хорошо..."

# ch/harems_full/office/events/events.rpy:5122
translate russian office_foursome_cowgirl_01960aa7:
    audrey.say "Вот так!"

# ch/harems_full/office/events/events.rpy:5123
translate russian office_foursome_cowgirl_8348a65f:
    "Вслед за мышцами Одри словно поддаётся всем телом."

# ch/harems_full/office/events/events.rpy:5124
translate russian office_foursome_cowgirl_bfcb453f:
    "Она расслабляется и позволяет мне двигаться внутри."

# ch/harems_full/office/events/events.rpy:5126
translate russian office_foursome_cowgirl_568480ab:
    "Я крепко беру Одри за талию и тяну вниз."

# ch/harems_full/office/events/events.rpy:5127
translate russian office_foursome_cowgirl_11b7e5be:
    "Губы её киски прижимаются к головке моего члена."

# ch/harems_full/office/events/events.rpy:5128
translate russian office_foursome_cowgirl_5b3cb4d7:
    "Она влажная и готова ко мне, но член скользит то туда, то сюда."

# ch/harems_full/office/events/events.rpy:5129
translate russian office_foursome_cowgirl_71f8c6d3:
    "На мгновение я думаю, что вообще промахнусь."

# ch/harems_full/office/events/events.rpy:5130
translate russian office_foursome_cowgirl_27315adf:
    "Но тут чувствую, как Одри ёрзает и извивается у меня на коленях."

# ch/harems_full/office/events/events.rpy:5131
translate russian office_foursome_cowgirl_d76cd95a:
    "Она опускается ниже..."

# ch/harems_full/office/events/events.rpy:5133
translate russian office_foursome_cowgirl_61713391:
    "И я вхожу в неё одним плавным движением."

# ch/harems_full/office/events/events.rpy:5136
translate russian office_foursome_cowgirl_80ea7439:
    audrey.say "Ого..."

# ch/harems_full/office/events/events.rpy:5137
translate russian office_foursome_cowgirl_03e49650:
    audrey.say "Привет, здоровяк!"

# ch/harems_full/office/events/events.rpy:5138
translate russian office_foursome_cowgirl_e08dd0c4:
    audrey.say "Ну, покажи, на что способен..."

# ch/harems_full/office/events/events.rpy:5139
translate russian office_foursome_cowgirl_8b68d1f1:
    "Мало того, что я уже так глубоко в Одри."

# ch/harems_full/office/events/events.rpy:5140
translate russian office_foursome_cowgirl_4577f9e2:
    "От её слов становится ещё приятнее!"

# ch/harems_full/office/events/events.rpy:5141
translate russian office_foursome_cowgirl_45997a91:
    "Каким-то образом она создаёт ощущение, будто собирается прокатиться на американских горках!"

# ch/harems_full/office/events/events.rpy:5142
translate russian office_foursome_cowgirl_84e1b5e1:
    "И мне хочется лишь одного: устроить ей лучшую поездку в жизни."

# ch/harems_full/office/events/events.rpy:5144
translate russian office_foursome_cowgirl_8542493d:
    "Когда я начинаю двигаться, Лавиш и Сиори крепко держат Одри."

# ch/harems_full/office/events/events.rpy:5145
translate russian office_foursome_cowgirl_ac66292a:
    "Она уже упирается руками позади себя, но этого будет мало."

# ch/harems_full/office/events/events.rpy:5146
translate russian office_foursome_cowgirl_d8997840:
    "С самого начала Одри подпрыгивает у меня на коленях."

# ch/harems_full/office/events/events.rpy:5147
translate russian office_foursome_cowgirl_31d6eb8d:
    "Ей удалось как следует меня раззадорить."

# ch/harems_full/office/events/events.rpy:5148
translate russian office_foursome_cowgirl_de83602e:
    "И теперь я ни за что не замедлюсь до самого конца!"

# ch/harems_full/office/events/events.rpy:5149
translate russian office_foursome_cowgirl_97f51426:
    "Каждый раз, входя в Одри, стараюсь проникнуть как можно глубже."

# ch/harems_full/office/events/events.rpy:5150
translate russian office_foursome_cowgirl_701bf20f:
    "И каждый раз слышу её беспомощный стон наслаждения."

# ch/harems_full/office/events/events.rpy:5151
translate russian office_foursome_cowgirl_3ddb9ca2:
    "Теперь она не просто опирается на меня руками."

# ch/harems_full/office/events/events.rpy:5152
translate russian office_foursome_cowgirl_d693e6c6:
    "Я чувствую, как её пальцы впиваются мне в кожу, цепляясь за меня."

# ch/harems_full/office/events/events.rpy:5154
translate russian office_foursome_cowgirl_2348df39:
    "Это довольно больно, но лишь подстёгивает меня ещё сильнее."

# ch/harems_full/office/events/events.rpy:5155
translate russian office_foursome_cowgirl_831483bf:
    "Со своего места я хорошо вижу Лавиш и Сиори."

# ch/harems_full/office/events/events.rpy:5156
translate russian office_foursome_cowgirl_1203562b:
    "Пока Одри никуда не может деться, они вольны делать что угодно."

# ch/harems_full/office/events/events.rpy:5157
translate russian office_foursome_cowgirl_4114b6d5:
    "И свободными руками, которыми не поддерживают её, уже исследуют всё её тело!"

# ch/harems_full/office/events/events.rpy:5158
translate russian office_foursome_cowgirl_795851cd:
    "На лице Сиори — неподдельное любопытство, глаза широко раскрыты."

# ch/harems_full/office/events/events.rpy:5159
translate russian office_foursome_cowgirl_ad68e4aa:
    "Она словно боится даже прикоснуться к Одри."

# ch/harems_full/office/events/events.rpy:5160
translate russian office_foursome_cowgirl_a0e49950:
    "Лавиш совсем другая: смотрит на Одри с улыбкой."

# ch/harems_full/office/events/events.rpy:5161
translate russian office_foursome_cowgirl_0a35b6d4:
    "Её свободная рука уже ласкает ближайшую к ней грудь."

# ch/harems_full/office/events/events.rpy:5162
translate russian office_foursome_cowgirl_bc3c45d9:
    "И я слышу, как Одри тихонько вскрикивает, когда Лавиш начинает ещё и пощипывать сосок!"

# ch/harems_full/office/events/events.rpy:5163
translate russian office_foursome_cowgirl_0553bafd:
    "Пример Лавиш словно придаёт Сиори уверенности, и она становится смелее."

# ch/harems_full/office/events/events.rpy:5164
translate russian office_foursome_cowgirl_37b98582:
    "Повторяет её движения и начинает гладить другую грудь Одри."

# ch/harems_full/office/events/events.rpy:5165
translate russian office_foursome_cowgirl_b6e89d2a:
    "Трудно сказать, что возбуждает меня сильнее."

# ch/harems_full/office/events/events.rpy:5166
translate russian office_foursome_cowgirl_98323dd2:
    "Быть внутри Одри или смотреть, как Лавиш и Сиори играют с ней!"

# ch/harems_full/office/events/events.rpy:5167
translate russian office_foursome_cowgirl_c05bb93c:
    "Ладно, ладно... скорее всего, первое."

# ch/harems_full/office/events/events.rpy:5168
translate russian office_foursome_cowgirl_70d67e3b:
    "Но второе определённо усиливает ощущения!"

# ch/harems_full/office/events/events.rpy:5169
translate russian office_foursome_cowgirl_dae2ec59:
    "Такими темпами я долго не продержусь..."

# ch/harems_full/office/events/events.rpy:5181
translate russian office_foursome_cowgirl_09e03d85:
    "С последним толчком я изливаюсь в Одри."

# ch/harems_full/office/events/events.rpy:5183
translate russian office_foursome_cowgirl_52a28ad8:
    "От этого ощущения она выгибает спину дугой."

# ch/harems_full/office/events/events.rpy:5184
translate russian office_foursome_cowgirl_3d247ecf:
    "Теперь Лавиш и Сиори держат её по-настоящему крепко."

# ch/harems_full/office/events/events.rpy:5185
translate russian office_foursome_cowgirl_34b1aea3:
    "Без них она вполне могла бы свалиться!"

# ch/harems_full/office/events/events.rpy:5186
translate russian office_foursome_cowgirl_399026ff:
    "Одри переживает оргазм до последней секунды, содрогаясь и запрокидывая голову."

# ch/harems_full/office/events/events.rpy:5187
translate russian office_foursome_cowgirl_981d7afd:
    "Затем соскальзывает набок и падает в объятия остальных девушек."

# ch/harems_full/office/events/events.rpy:5189
translate russian office_foursome_cowgirl_d825076c:
    "Когда я уже готов кончить, Одри всё ещё извивается."

# ch/harems_full/office/events/events.rpy:5191
translate russian office_foursome_cowgirl_899d6140:
    "Я пользуюсь этим и за секунду до оргазма выскальзываю из-под неё."

# ch/harems_full/office/events/events.rpy:5193
translate russian office_foursome_cowgirl_fcdce0e2:
    "Она удивлённо вскрикивает от этого ощущения, а затем ещё раз — когда сперма забрызгивает её."

# ch/harems_full/office/events/events.rpy:5195
translate russian office_foursome_cowgirl_4ac70bdd:
    "Сперма ложится на её грудь и живот, а также на руки Лавиш и Сиори."

# ch/harems_full/office/events/events.rpy:5196
translate russian office_foursome_cowgirl_790eb82e:
    "Одри ещё мгновение держится, содрогаясь и запрокидывая голову."

# ch/harems_full/office/events/events.rpy:5197
translate russian office_foursome_cowgirl_981d7afd_1:
    "Затем соскальзывает набок и падает в объятия остальных девушек."

# ch/harems_full/office/events/events.rpy:5205
translate russian office_aletta_audrey_lavish_shiori_showdown_7e2706e9:
    "Ненавижу большинство совещаний, которые возникают, пока я пытаюсь работать."

# ch/harems_full/office/events/events.rpy:5206
translate russian office_aletta_audrey_lavish_shiori_showdown_ef508c11:
    "Но собрания коллектива хуже всех: от них меня сразу клонит в сон."

# ch/harems_full/office/events/events.rpy:5207
translate russian office_aletta_audrey_lavish_shiori_showdown_cf3a5e82:
    "Столько времени сидеть в комнате и слушать, как кто-то бесконечно бубнит о чём-то."

# ch/harems_full/office/events/events.rpy:5208
translate russian office_aletta_audrey_lavish_shiori_showdown_38b929c4:
    "Почему нельзя просто прислать письмо?"

# ch/harems_full/office/events/events.rpy:5209
translate russian office_aletta_audrey_lavish_shiori_showdown_e855d142:
    "Зачем отнимать час моей жизни, который уже не вернуть?"

# ch/harems_full/office/events/events.rpy:5211
translate russian office_aletta_audrey_lavish_shiori_showdown_4449f3a6:
    "Сейчас меня мучает Алетта."

# ch/harems_full/office/events/events.rpy:5212
translate russian office_aletta_audrey_lavish_shiori_showdown_e7bc6324:
    "Вытягивает из меня желание жить своей презентацией со слайдами."

# ch/harems_full/office/events/events.rpy:5214
translate russian office_aletta_audrey_lavish_shiori_showdown_aa24a9c9:
    "Я оглядываю комнату и вижу, что Лавиш сидит прямо и внимательно слушает."

# ch/harems_full/office/events/events.rpy:5216
translate russian office_aletta_audrey_lavish_shiori_showdown_63522559:
    "Сиори хотя бы делает вид, что слушает, но мыслями, похоже, витает где-то ещё."

# ch/harems_full/office/events/events.rpy:5218
translate russian office_aletta_audrey_lavish_shiori_showdown_694b3ca8:
    "Затем мой взгляд останавливается на Одри: она выглядит такой же одуревшей от скуки, как я."

# ch/harems_full/office/events/events.rpy:5219
translate russian office_aletta_audrey_lavish_shiori_showdown_2f81d84c:
    "Разница в том, что она даже не пытается это скрыть."

# ch/harems_full/office/events/events.rpy:5220
translate russian office_aletta_audrey_lavish_shiori_showdown_417edd1b:
    "Заметив мой взгляд, Одри сразу оживляется."

# ch/harems_full/office/events/events.rpy:5221
translate russian office_aletta_audrey_lavish_shiori_showdown_301aefd7:
    "Глядя мне в глаза, она нарочито широко зевает."

# ch/harems_full/office/events/events.rpy:5222
translate russian office_aletta_audrey_lavish_shiori_showdown_7286116d:
    "Затем приставляет пальцы ко лбу и изображает выстрел себе в голову."

# ch/harems_full/office/events/events.rpy:5223
translate russian office_aletta_audrey_lavish_shiori_showdown_37338d11:
    "Это непрофессионально и довольно ребячески."

# ch/harems_full/office/events/events.rpy:5224
translate russian office_aletta_audrey_lavish_shiori_showdown_e38e7c10:
    "Но мне так скучно, что я всё равно не могу удержаться от смешка."

# ch/harems_full/office/events/events.rpy:5227
translate russian office_aletta_audrey_lavish_shiori_showdown_a5cf294c:
    "Услышав, как Алетта откашливается, я мгновенно перестаю смеяться."

# ch/harems_full/office/events/events.rpy:5228
translate russian office_aletta_audrey_lavish_shiori_showdown_514b2817:
    "Резко поворачиваю голову и вижу, что она прервала презентацию."

# ch/harems_full/office/events/events.rpy:5229
translate russian office_aletta_audrey_lavish_shiori_showdown_b81cd0e1:
    "Что ещё хуже, она смотрит прямо на меня!"

# ch/harems_full/office/events/events.rpy:5231
translate russian office_aletta_audrey_lavish_shiori_showdown_fe1a07ac:
    aletta.say "Ты хотел что-то добавить, [lssb_common.hero_name()]?"

# ch/harems_full/office/events/events.rpy:5232
translate russian office_aletta_audrey_lavish_shiori_showdown_cbafbf81:
    aletta.say "Какое-нибудь глубокое наблюдение или свежий взгляд на вещи?"

# ch/harems_full/office/events/events.rpy:5233
translate russian office_aletta_audrey_lavish_shiori_showdown_3bb9238a:
    "Я ёрзаю на стуле, пока Алетта допрашивает меня при всех."

# ch/harems_full/office/events/events.rpy:5234
translate russian office_aletta_audrey_lavish_shiori_showdown_1af5e17f:
    "И с раздражением замечаю, что Одри тоже не собирается помогать."

# ch/harems_full/office/events/events.rpy:5235
translate russian office_aletta_audrey_lavish_shiori_showdown_b7a0b2cc:
    mike.say "А... нет, Алетта."

# ch/harems_full/office/events/events.rpy:5236
translate russian office_aletta_audrey_lavish_shiori_showdown_96b3f7a7:
    mike.say "Я просто... просто прочистил горло."

# ch/harems_full/office/events/events.rpy:5237
translate russian office_aletta_audrey_lavish_shiori_showdown_dae29c1b:
    mike.say "Прости..."

# ch/harems_full/office/events/events.rpy:5239
translate russian office_aletta_audrey_lavish_shiori_showdown_06ef6fcf:
    "Алетта приподнимает брови."

# ch/harems_full/office/events/events.rpy:5240
translate russian office_aletta_audrey_lavish_shiori_showdown_a063b96f:
    "Моё объяснение её явно нисколько не убеждает."

# ch/harems_full/office/events/events.rpy:5242
translate russian office_aletta_audrey_lavish_shiori_showdown_908793d1:
    "Сейчас она напоминает мне всех строгих учителей, которых я помню со школы!"

# ch/harems_full/office/events/events.rpy:5244
translate russian office_aletta_audrey_lavish_shiori_showdown_142d30e5:
    aletta.say "Итак, если позволите продолжить..."

# ch/harems_full/office/events/events.rpy:5245
translate russian office_aletta_audrey_lavish_shiori_showdown_2b918517:
    aletta.say "Словарь определяет «полиаморию» как практику нескольких романтических и сексуальных отношений одновременно."

# ch/harems_full/office/events/events.rpy:5246
translate russian office_aletta_audrey_lavish_shiori_showdown_1acbed13:
    aletta.say "При согласии всех участвующих сторон..."

# ch/harems_full/office/events/events.rpy:5247
translate russian office_aletta_audrey_lavish_shiori_showdown_97a731c4:
    "Вдруг я чувствую, как меняется настроение в комнате."

# ch/harems_full/office/events/events.rpy:5251
translate russian office_aletta_audrey_lavish_shiori_showdown_675006b6:
    "Теперь мы все четверо выпрямляемся и напряжённо слушаем."

# ch/harems_full/office/events/events.rpy:5252
translate russian office_aletta_audrey_lavish_shiori_showdown_ef40e329:
    "Куда, чёрт возьми, она клонит?"

# ch/harems_full/office/events/events.rpy:5253
translate russian office_aletta_audrey_lavish_shiori_showdown_792a5f32:
    "Почему Алетта говорит о полиамории?"

# ch/harems_full/office/events/events.rpy:5254
translate russian office_aletta_audrey_lavish_shiori_showdown_2427c749:
    "Она узнала, что мы все вместе трахаемся на работе?!"

# ch/harems_full/office/events/events.rpy:5258
translate russian office_aletta_audrey_lavish_shiori_showdown_a3270ea0:
    "Я вижу, как Одри, Лавиш и Сиори переглядываются."

# ch/harems_full/office/events/events.rpy:5259
translate russian office_aletta_audrey_lavish_shiori_showdown_1904f429:
    "Но пока никто не спешит заговорить и возразить Алетте."

# ch/harems_full/office/events/events.rpy:5260
translate russian office_aletta_audrey_lavish_shiori_showdown_3ad6b0af:
    aletta.say "Как вы уже знаете, недавно эту практику узаконили."

# ch/harems_full/office/events/events.rpy:5261
translate russian office_aletta_audrey_lavish_shiori_showdown_38188b69:
    aletta.say "Тогда считалось, что она может повредить бизнесу."

# ch/harems_full/office/events/events.rpy:5262
translate russian office_aletta_audrey_lavish_shiori_showdown_7a00fb3d:
    aletta.say "Предполагалось, что такие отношения способны отвлекать от работы."

# ch/harems_full/office/events/events.rpy:5263
translate russian office_aletta_audrey_lavish_shiori_showdown_66b8f872:
    "Все в комнате разом затаивают дыхание."

# ch/harems_full/office/events/events.rpy:5264
translate russian office_aletta_audrey_lavish_shiori_showdown_c4b3b3f6:
    "Неужели Алетта сейчас объявит наши тайные отношения вчетвером вредными для компании?"

# ch/harems_full/office/events/events.rpy:5265
translate russian office_aletta_audrey_lavish_shiori_showdown_149ae40c:
    aletta.say "Однако исследования, похоже, показывают обратное."

# ch/harems_full/office/events/events.rpy:5266
translate russian office_aletta_audrey_lavish_shiori_showdown_93c71a79:
    aletta.say "Компании, сотрудники которых признались в подобных отношениях, работают эффективнее."

# ch/harems_full/office/events/events.rpy:5267
translate russian office_aletta_audrey_lavish_shiori_showdown_95712a9b:
    aletta.say "Похоже, чем ближе сотрудники друг к другу, тем продуктивнее их работа."

# ch/harems_full/office/events/events.rpy:5268
translate russian office_aletta_audrey_lavish_shiori_showdown_5fd606bf:
    "После этих слов все разом выдыхают."

# ch/harems_full/office/events/events.rpy:5269
translate russian office_aletta_audrey_lavish_shiori_showdown_dcc44742:
    "Значит, нам ничего не грозит, верно?"

# ch/harems_full/office/events/events.rpy:5270
translate russian office_aletta_audrey_lavish_shiori_showdown_7d0bb310:
    "Алетта ведь только что сказала, что так мы работаем эффективнее?"

# ch/harems_full/office/events/events.rpy:5271
translate russian office_aletta_audrey_lavish_shiori_showdown_0ac2dc26:
    "Да и она же не просит нас во всём признаваться. Или просит?"

# ch/harems_full/office/events/events.rpy:5272
translate russian office_aletta_audrey_lavish_shiori_showdown_4f118a6c:
    "Не знаю почему, но эта мысль заставляет меня взглянуть на Одри."

# ch/harems_full/office/events/events.rpy:5273
translate russian office_aletta_audrey_lavish_shiori_showdown_70a19342:
    "И сердце сразу уходит в пятки."

# ch/harems_full/office/events/events.rpy:5274
translate russian office_aletta_audrey_lavish_shiori_showdown_d693d2c0:
    "Выражением лица она напоминает кошку."

# ch/harems_full/office/events/events.rpy:5275
translate russian office_aletta_audrey_lavish_shiori_showdown_cfa4b3eb:
    "Кошку, которая только что заметила выпавшего из гнезда птенца."

# ch/harems_full/office/events/events.rpy:5276
translate russian office_aletta_audrey_lavish_shiori_showdown_59955bb0:
    "И знает, что рядом нет никого, кто помешал бы ей полакомиться!"

# ch/harems_full/office/events/events.rpy:5278
translate russian office_aletta_audrey_lavish_shiori_showdown_5d959e89:
    audrey.say "Ну, значит, наша продуктивность тоже выросла, верно?"

# ch/harems_full/office/events/events.rpy:5279
translate russian office_aletta_audrey_lavish_shiori_showdown_a678b98d:
    "Алетта смотрит на Одри и моргает."

# ch/harems_full/office/events/events.rpy:5280
translate russian office_aletta_audrey_lavish_shiori_showdown_5db27d59:
    "Не знаю, что её сбило с толку: внезапность вопроса..."

# ch/harems_full/office/events/events.rpy:5281
translate russian office_aletta_audrey_lavish_shiori_showdown_29b4466c:
    "Или то, что Одри вообще сказала что-то полезное, чего от неё обычно не дождёшься."

# ch/harems_full/office/events/events.rpy:5282
translate russian office_aletta_audrey_lavish_shiori_showdown_530c2b06:
    aletta.say "Прости..."

# ch/harems_full/office/events/events.rpy:5284
translate russian office_aletta_audrey_lavish_shiori_showdown_64de830f:
    aletta.say "Но при чём тут твоя продуктивность?"

# ch/harems_full/office/events/events.rpy:5285
translate russian office_aletta_audrey_lavish_shiori_showdown_2baeb4f2:
    "Все остальные словно двигаются в замедленной съёмке."

# ch/harems_full/office/events/events.rpy:5286
translate russian office_aletta_audrey_lavish_shiori_showdown_b235d949:
    "Мы с Лавиш и Сиори пытаемся заговорить раньше, чем ответит Одри."

# ch/harems_full/office/events/events.rpy:5287
translate russian office_aletta_audrey_lavish_shiori_showdown_0658c40e:
    audrey.say "Ну, мы ведь все полиаморны, правда, ребята?"

# ch/harems_full/office/events/events.rpy:5288
translate russian office_aletta_audrey_lavish_shiori_showdown_7a1c8fe8:
    audrey.say "Кроме тебя, Алетта."

# ch/harems_full/office/events/events.rpy:5289
translate russian office_aletta_audrey_lavish_shiori_showdown_2b1e283c:
    "Алетта моргает и качает головой."

# ch/harems_full/office/events/events.rpy:5290
translate russian office_aletta_audrey_lavish_shiori_showdown_b4f94270:
    "Затем моргает снова, пытаясь осмыслить новую информацию."

# ch/harems_full/office/events/events.rpy:5291
translate russian office_aletta_audrey_lavish_shiori_showdown_f3ba8cfc:
    aletta.say "То есть..."

# ch/harems_full/office/events/events.rpy:5292
translate russian office_aletta_audrey_lavish_shiori_showdown_541ca98c:
    aletta.say "Вы все..."

# ch/harems_full/office/events/events.rpy:5296
translate russian office_aletta_audrey_lavish_shiori_showdown_ea5db3a4:
    aletta.say "Я... я и понятия не имела!"

# ch/harems_full/office/events/events.rpy:5297
translate russian office_aletta_audrey_lavish_shiori_showdown_d8a646bf:
    mike.say "Никто больше не знал, Алетта."

# ch/harems_full/office/events/events.rpy:5298
translate russian office_aletta_audrey_lavish_shiori_showdown_aa7806d8:
    mike.say "И никто больше не должен был узнать!"

# ch/harems_full/office/events/events.rpy:5299
translate russian office_aletta_audrey_lavish_shiori_showdown_a0b94667:
    "Одри вдруг ахает, изо всех сил изображая смущение и стыд."

# ch/harems_full/office/events/events.rpy:5301
translate russian office_aletta_audrey_lavish_shiori_showdown_b1b710a8:
    audrey.say "Ох, мне ТАК жаль, ребята!"

# ch/harems_full/office/events/events.rpy:5302
translate russian office_aletta_audrey_lavish_shiori_showdown_43891b85:
    audrey.say "Я просто подумала, что это отличный шанс всем нам перестать скрываться!"

# ch/harems_full/office/events/events.rpy:5303
translate russian office_aletta_audrey_lavish_shiori_showdown_56a6126f:
    audrey.say "Ты ведь никому не расскажешь, Алетта?"

# ch/harems_full/office/events/events.rpy:5305
translate russian office_aletta_audrey_lavish_shiori_showdown_927f52d3:
    aletta.say "Я... я не могу сказать..."

# ch/harems_full/office/events/events.rpy:5306
translate russian office_aletta_audrey_lavish_shiori_showdown_e727ff99:
    audrey.say "Ты даже могла бы присоединиться. Правда, [lssb_common.hero_name()]?"

# ch/harems_full/office/events/events.rpy:5311
translate russian office_aletta_audrey_lavish_shiori_showdown_29ff1afd:
    "Вдруг всё внимание переключается на меня: четыре пары глаз будто прожигают мозг."

# ch/harems_full/office/events/events.rpy:5313
translate russian office_aletta_audrey_lavish_shiori_showdown_e3afb1a6:
    lavish.say "Ты позволишь ей это, [lssb_common.hero_name()]?"

# ch/harems_full/office/events/events.rpy:5315
translate russian office_aletta_audrey_lavish_shiori_showdown_d9abdd62:
    shiori.say "Что происходит, [lssb_common.hero_name()]?"

# ch/harems_full/office/events/events.rpy:5316
translate russian office_aletta_audrey_lavish_shiori_showdown_03f0a721:
    shiori.say "Мне страшно!"

# ch/harems_full/office/events/events.rpy:5317
translate russian office_aletta_audrey_lavish_shiori_showdown_b6a34695:
    "Я пытаюсь собраться с мыслями и отгородиться от их голосов."

# ch/harems_full/office/events/events.rpy:5318
translate russian office_aletta_audrey_lavish_shiori_showdown_3ff3b6ce:
    "В этих отношениях нас уже четверо."

# ch/harems_full/office/events/events.rpy:5319
translate russian office_aletta_audrey_lavish_shiori_showdown_40609945:
    "Есть ли место ещё для одной?"

# ch/harems_full/office/events/events.rpy:5320
translate russian office_aletta_audrey_lavish_shiori_showdown_7c6394bf:
    "Хотя какая разница — четверо или пятеро?"

# ch/harems_full/office/events/events.rpy:5321
translate russian office_aletta_audrey_lavish_shiori_showdown_219d9966:
    "К тому же, если Алетта присоединится, точно будет молчать."

# ch/harems_full/office/events/events.rpy:5322
translate russian office_aletta_audrey_lavish_shiori_showdown_ffc3adc0:
    mike.say "Я не против, если ты согласна, Алетта."

# ch/harems_full/office/events/events.rpy:5323
translate russian office_aletta_audrey_lavish_shiori_showdown_8323a54f:
    mike.say "И ты тоже сможешь работать эффективнее."

# ch/harems_full/office/events/events.rpy:5324
translate russian office_aletta_audrey_lavish_shiori_showdown_e9d398d9:
    mike.say "По-моему, тут все в выигрыше!"

# ch/harems_full/office/events/events.rpy:5328
translate russian office_aletta_audrey_lavish_shiori_showdown_2844889c:
    "Я почти вижу, как в голове Алетты крутятся шестерёнки."

# ch/harems_full/office/events/events.rpy:5329
translate russian office_aletta_audrey_lavish_shiori_showdown_8d61428d:
    "Остаётся надеяться, что в нужную сторону..."

# ch/harems_full/office/events/events.rpy:5332
translate russian office_aletta_audrey_lavish_shiori_showdown_05848c55:
    aletta.say "Ф... формально ты прав."

# ch/harems_full/office/events/events.rpy:5333
translate russian office_aletta_audrey_lavish_shiori_showdown_a74517fc:
    aletta.say "А это самая правильная правота..."

# ch/harems_full/office/events/events.rpy:5334
translate russian office_aletta_audrey_lavish_shiori_showdown_357c489d:
    "Алетта на мгновение опускает взгляд на стол."

# ch/harems_full/office/events/events.rpy:5335
translate russian office_aletta_audrey_lavish_shiori_showdown_e190a6a9:
    "Кажется, собирается с силами, чтобы что-то сказать."

# ch/harems_full/office/events/events.rpy:5337
translate russian office_aletta_audrey_lavish_shiori_showdown_0d0e425a:
    aletta.say "Я попробую."

# ch/harems_full/office/events/events.rpy:5339
translate russian office_aletta_audrey_lavish_shiori_showdown_48cedb35:
    aletta.say "Хочу участвовать."

# ch/harems_full/office/events/events.rpy:5340
translate russian office_aletta_audrey_lavish_shiori_showdown_23644bbd:
    "Одри морщит лицо и прикладывает ладонь к уху."

# ch/harems_full/office/events/events.rpy:5342
translate russian office_aletta_audrey_lavish_shiori_showdown_f0331d2a:
    audrey.say "А, что ты сказала, Алетта?"

# ch/harems_full/office/events/events.rpy:5344
translate russian office_aletta_audrey_lavish_shiori_showdown_02cb09f9:
    lavish.say "Я тоже, кажется, не расслышала..."

# ch/harems_full/office/events/events.rpy:5346
translate russian office_aletta_audrey_lavish_shiori_showdown_bc44c4ce:
    shiori.say "Хи-хи... да, Алетта, погромче!"

# ch/harems_full/office/events/events.rpy:5347
translate russian office_aletta_audrey_lavish_shiori_showdown_65ea8e20:
    "Алетта стонет, пока остальные девушки её изводят."

# ch/harems_full/office/events/events.rpy:5348
translate russian office_aletta_audrey_lavish_shiori_showdown_7f31df6d:
    "Но, похоже, выхода у неё нет."

# ch/harems_full/office/events/events.rpy:5349
translate russian office_aletta_audrey_lavish_shiori_showdown_e4ccc0fe:
    "Разве что дать им то, чего они хотят."

# ch/harems_full/office/events/events.rpy:5351
translate russian office_aletta_audrey_lavish_shiori_showdown_a7e30e27:
    aletta.say "Уф... что за детский сад!"

# ch/harems_full/office/events/events.rpy:5352
translate russian office_aletta_audrey_lavish_shiori_showdown_686faece:
    aletta.say "Ладно, скажу..."

# ch/harems_full/office/events/events.rpy:5353
translate russian office_aletta_audrey_lavish_shiori_showdown_1cb6ef9b:
    aletta.say "Я хочу стать частью ваших отношений."

# ch/harems_full/office/events/events.rpy:5355
translate russian office_aletta_audrey_lavish_shiori_showdown_a48e8635:
    aletta.say "Если вы меня примете?"

# ch/harems_full/office/events/events.rpy:5357
translate russian office_aletta_audrey_lavish_shiori_showdown_23756d0c:
    audrey.say "Да, Алетта, для тебя местечко найдём!"

# ch/harems_full/office/events/events.rpy:5359
translate russian office_aletta_audrey_lavish_shiori_showdown_721546e4:
    lavish.say "Добро пожаловать в команду! Тебе понравится."

# ch/harems_full/office/events/events.rpy:5361
translate russian office_aletta_audrey_lavish_shiori_showdown_53bb46ed:
    shiori.say "[lssb_common.hero_name()] не против, значит, и я тоже!"

# ch/harems_full/office/events/events.rpy:5362
translate russian office_aletta_audrey_lavish_shiori_showdown_d8d3ab49:
    mike.say "Значит, договорились?"

# ch/harems_full/office/events/events.rpy:5363
translate russian office_aletta_audrey_lavish_shiori_showdown_67ac76ab:
    mike.say "Алетта с нами."

# ch/harems_full/office/events/events.rpy:5364
translate russian office_aletta_audrey_lavish_shiori_showdown_25575a8b:
    mike.say "И теперь мы официально кто — пятёрка?"

# ch/harems_full/office/events/events.rpy:5366
translate russian office_aletta_audrey_lavish_shiori_showdown_e44ba84a:
    aletta.say "Не пытайся слишком много думать, [lssb_common.hero_name()]."

# ch/harems_full/office/events/events.rpy:5367
translate russian office_aletta_audrey_lavish_shiori_showdown_20b5f7e6:
    aletta.say "Только себе навредишь!"

# ch/harems_full/office/events/events.rpy:5368
translate russian office_aletta_audrey_lavish_shiori_showdown_3677f9b8:
    "Все четверо разражаются смехом надо мной."

# ch/harems_full/office/events/events.rpy:5369
translate russian office_aletta_audrey_lavish_shiori_showdown_62ff9519:
    "Невольно надеюсь, что дальше так будет не всегда!"

# ch/harems_full/office/events/events.rpy:5374
translate russian office_aletta_audrey_lavish_shiori_showdown_31b20432:
    aletta.say "Нет, я никак не могу на это пойти."

# ch/harems_full/office/events/events.rpy:5375
translate russian office_aletta_audrey_lavish_shiori_showdown_365542b3:
    aletta.say "Это... это было бы неэффективно."

# ch/harems_full/office/events/events.rpy:5377
translate russian office_aletta_audrey_lavish_shiori_showdown_2de9efe8:
    "Лавиш морщится и склоняет голову набок."

# ch/harems_full/office/events/events.rpy:5378
translate russian office_aletta_audrey_lavish_shiori_showdown_fa41cb5e:
    "Похоже, объяснение Алетты её не убедило."

# ch/harems_full/office/events/events.rpy:5379
translate russian office_aletta_audrey_lavish_shiori_showdown_55b40bd7:
    lavish.say "Но я думала, для тебя главное — продуктивность, Алетта?"

# ch/harems_full/office/events/events.rpy:5380
translate russian office_aletta_audrey_lavish_shiori_showdown_ff7b7641:
    lavish.say "Лично меня это определённо стало сильнее мотивировать."

# ch/harems_full/office/events/events.rpy:5382
translate russian office_aletta_audrey_lavish_shiori_showdown_df4fefc7:
    "Сиори прижимается ко мне, словно ища защиты."

# ch/harems_full/office/events/events.rpy:5383
translate russian office_aletta_audrey_lavish_shiori_showdown_1c783daa:
    shiori.say "Может, она считает себя слишком хорошей для таких, как мы?"

# ch/harems_full/office/events/events.rpy:5384
translate russian office_aletta_audrey_lavish_shiori_showdown_6afa6618:
    shiori.say "Не слушай её, [lssb_common.hero_name()]."

# ch/harems_full/office/events/events.rpy:5385
translate russian office_aletta_audrey_lavish_shiori_showdown_be712c85:
    shiori.say "Это ты слишком хорош для неё!"

# ch/harems_full/office/events/events.rpy:5387
translate russian office_aletta_audrey_lavish_shiori_showdown_74cb2584:
    "Одри качает головой, словно знает ответ."

# ch/harems_full/office/events/events.rpy:5388
translate russian office_aletta_audrey_lavish_shiori_showdown_e52f0a76:
    audrey.say "Нет, Сиори, дело не в этом."

# ch/harems_full/office/events/events.rpy:5389
translate russian office_aletta_audrey_lavish_shiori_showdown_66163db5:
    audrey.say "Алетта не любит делиться."

# ch/harems_full/office/events/events.rpy:5390
translate russian office_aletta_audrey_lavish_shiori_showdown_f637b379:
    audrey.say "Хочет быть главной сукой!"

# ch/harems_full/office/events/events.rpy:5391
translate russian office_aletta_audrey_lavish_shiori_showdown_4d850be9:
    "При этих словах Алетта встаёт и качает головой."

# ch/harems_full/office/events/events.rpy:5393
translate russian office_aletta_audrey_lavish_shiori_showdown_a0e57c64:
    aletta.say "Я... я ещё никогда не слышала такой чуши."

# ch/harems_full/office/events/events.rpy:5394
translate russian office_aletta_audrey_lavish_shiori_showdown_26b4c75e:
    aletta.say "Этот разговор окончен. ОКОНЧЕН!"

# ch/harems_full/office/events/events.rpy:5395
translate russian office_aletta_audrey_lavish_shiori_showdown_84a3893c:
    aletta.say "Надо бы пожаловаться на всех вас в отдел кадров!"

# ch/harems_full/office/events/events.rpy:5397
translate russian office_aletta_audrey_lavish_shiori_showdown_61f5554f:
    mike.say "Ты сама сказала: полиамория вообще-то законна."

# ch/harems_full/office/events/events.rpy:5399
translate russian office_aletta_audrey_lavish_shiori_showdown_2ed50aa0:
    "Лицо Алетты краснеет от смущения."

# ch/harems_full/office/events/events.rpy:5400
translate russian office_aletta_audrey_lavish_shiori_showdown_4a1c9661:
    "Её рот шевелится, но слов не слышно."

# ch/harems_full/office/events/events.rpy:5401
translate russian office_aletta_audrey_lavish_shiori_showdown_3deaffd5:
    "Затем она резко разворачивается и вылетает из переговорной."

# ch/harems_full/office/events/events.rpy:5403
translate russian office_aletta_audrey_lavish_shiori_showdown_e2132644:
    "Мне остаётся лишь пожать плечами, глядя на остальных."

# ch/harems_full/office/events/events.rpy:5404
translate russian office_aletta_audrey_lavish_shiori_showdown_3b6e6d5e:
    mike.say "Может, с таким характером нам и правда лучше без неё?"

# ch/harems_full/office/events/events.rpy:5410
translate russian office_aletta_audrey_lavish_shiori_01_55ea1fab:
    "Меньше всего сегодня утром мне было нужно ещё одно чёртово совещание."

# ch/harems_full/office/events/events.rpy:5411
translate russian office_aletta_audrey_lavish_shiori_01_86463e06:
    "Но стоило проверить расписание, как оно оказалось прямо перед глазами."

# ch/harems_full/office/events/events.rpy:5412
translate russian office_aletta_audrey_lavish_shiori_01_372cc04f:
    "Я сижу за столом, вцепившись в свой кофе."

# ch/harems_full/office/events/events.rpy:5413
translate russian office_aletta_audrey_lavish_shiori_01_4d1eed65:
    "Когда начинают входить остальные, я вижу, что они чувствуют то же самое."

# ch/harems_full/office/events/events.rpy:5415
translate russian office_aletta_audrey_lavish_shiori_01_41604380:
    "Одри влетает в комнату мрачнее тучи."

# ch/harems_full/office/events/events.rpy:5416
translate russian office_aletta_audrey_lavish_shiori_01_dc07603e:
    "Ничего не говорит, лишь ворчит и бормочет себе под нос."

# ch/harems_full/office/events/events.rpy:5420
translate russian office_aletta_audrey_lavish_shiori_01_b200a12e:
    "Сиори торопливо входит, усталая и явно замотанная."

# ch/harems_full/office/events/events.rpy:5423
translate russian office_aletta_audrey_lavish_shiori_01_11094739:
    "Но всё же не забывает о вежливости и заставляет себя улыбнуться."

# ch/harems_full/office/events/events.rpy:5424
translate russian office_aletta_audrey_lavish_shiori_01_c102a48f:
    shiori.say "Ох..."

# ch/harems_full/office/events/events.rpy:5425
translate russian office_aletta_audrey_lavish_shiori_01_0a26bbf5:
    shiori.say "Доброе утро, [lssb_common.hero_name()]."

# ch/harems_full/office/events/events.rpy:5426
translate russian office_aletta_audrey_lavish_shiori_01_2b70d4db:
    mike.say "Доброе утро, Сиори."

# ch/harems_full/office/events/events.rpy:5427
translate russian office_aletta_audrey_lavish_shiori_01_d42fcd5f:
    "Даже этого короткого приветствия хватает, чтобы поднять Сиори настроение."

# ch/harems_full/office/events/events.rpy:5429
translate russian office_aletta_audrey_lavish_shiori_01_b28b30aa:
    "Она с радостью выбирает место как можно ближе ко мне."

# ch/harems_full/office/events/events.rpy:5431
translate russian office_aletta_audrey_lavish_shiori_01_81fd3b60:
    "Лавиш входит деловая и готовая к совещанию."

# ch/harems_full/office/events/events.rpy:5432
translate russian office_aletta_audrey_lavish_shiori_01_0a58c7bf:
    "Но даже у неё за привычным профессионализмом заметна лёгкая усталость."

# ch/harems_full/office/events/events.rpy:5434
translate russian office_aletta_audrey_lavish_shiori_01_a1e096ce:
    lavish.say "Всем доброе утро."

# ch/harems_full/office/events/events.rpy:5435
translate russian office_aletta_audrey_lavish_shiori_01_fd268faf:
    lavish.say "Кто-нибудь знает, чему посвящено это совещание?"

# ch/harems_full/office/events/events.rpy:5436
translate russian office_aletta_audrey_lavish_shiori_01_69f4d190:
    "Все переглядываются, а затем пожимают плечами."

# ch/harems_full/office/events/events.rpy:5437
translate russian office_aletta_audrey_lavish_shiori_01_596f0bd0:
    mike.say "Понятия не имею, Лавиш."

# ch/harems_full/office/events/events.rpy:5438
translate russian office_aletta_audrey_lavish_shiori_01_3a7494f9:
    shiori.say "Эм... я тоже не знаю, Лавиш."

# ch/harems_full/office/events/events.rpy:5439
translate russian office_aletta_audrey_lavish_shiori_01_cefad4f9:
    shiori.say "Прости!"

# ch/harems_full/office/events/events.rpy:5441
translate russian office_aletta_audrey_lavish_shiori_01_27265e68:
    audrey.say "Тому, чтобы нас помучить, очевидно!"

# ch/harems_full/office/events/events.rpy:5442
translate russian office_aletta_audrey_lavish_shiori_01_ba7620ac:
    audrey.say "Чему же ещё?!"

# ch/harems_full/office/events/events.rpy:5443
translate russian office_aletta_audrey_lavish_shiori_01_afe8be77:
    aletta.say "А, все в сборе. Хорошо."

# ch/harems_full/office/events/events.rpy:5444
translate russian office_aletta_audrey_lavish_shiori_01_c08bb3a5:
    "Все поднимают глаза и оборачиваются на новый голос."

# ch/harems_full/office/events/events.rpy:5446
translate russian office_aletta_audrey_lavish_shiori_01_2e2b970e:
    "В дверном проёме стоит Алетта."

# ch/harems_full/office/events/events.rpy:5447
translate russian office_aletta_audrey_lavish_shiori_01_46f7bec9:
    "Руки в боки, вид такой, будто готова ко всему."

# ch/harems_full/office/events/events.rpy:5450
translate russian office_aletta_audrey_lavish_shiori_01_1de8a2b2:
    mike.say "Значит, это ты созвала совещание?"

# ch/harems_full/office/events/events.rpy:5452
translate russian office_aletta_audrey_lavish_shiori_01_9f44d86a:
    "Алетта уверенно входит в комнату, закрывая за собой дверь."

# ch/harems_full/office/events/events.rpy:5453
translate russian office_aletta_audrey_lavish_shiori_01_d26ce947:
    "Останавливается во главе стола, занимая командную позицию."

# ch/harems_full/office/events/events.rpy:5454
translate russian office_aletta_audrey_lavish_shiori_01_8749924e:
    aletta.say "Разумеется, я."

# ch/harems_full/office/events/events.rpy:5455
translate russian office_aletta_audrey_lavish_shiori_01_da25f674:
    aletta.say "Но я бы не называла это совещанием."

# ch/harems_full/office/events/events.rpy:5457
translate russian office_aletta_audrey_lavish_shiori_01_d7aecf6c:
    aletta.say "Это звучит так официально!"

# ch/harems_full/office/events/events.rpy:5458
translate russian office_aletta_audrey_lavish_shiori_01_cee2fd4c:
    mike.say "Не понимаю, Алетта."

# ch/harems_full/office/events/events.rpy:5459
translate russian office_aletta_audrey_lavish_shiori_01_ac3efb6d:
    mike.say "Если это не совещание, то что именно?"

# ch/harems_full/office/events/events.rpy:5461
translate russian office_aletta_audrey_lavish_shiori_01_317a4d4f:
    aletta.say "Мне казалось, мы обсудили это на прошлом настоящем совещании?"

# ch/harems_full/office/events/events.rpy:5462
translate russian office_aletta_audrey_lavish_shiori_01_6f3062ea:
    aletta.say "Моё участие в ваших непристойных отношениях?"

# ch/harems_full/office/events/events.rpy:5463
translate russian office_aletta_audrey_lavish_shiori_01_79b336ed:
    "Потрясённый словами Алетты, я оглядываюсь на остальных."

# ch/harems_full/office/events/events.rpy:5464
translate russian office_aletta_audrey_lavish_shiori_01_274601ae:
    "И вижу, что их реакция примерно такая же."

# ch/harems_full/office/events/events.rpy:5466
translate russian office_aletta_audrey_lavish_shiori_01_71f926f0:
    shiori.say "То есть..."

# ch/harems_full/office/events/events.rpy:5468
translate russian office_aletta_audrey_lavish_shiori_01_763d1a72:
    lavish.say "Ты позвала нас всех сюда..."

# ch/harems_full/office/events/events.rpy:5470
translate russian office_aletta_audrey_lavish_shiori_01_e0c605f7:
    audrey.say "Ради СЕКСА?!"

# ch/harems_full/office/events/events.rpy:5472
translate russian office_aletta_audrey_lavish_shiori_01_ac73775d:
    "Алетта вопросительно приподнимает бровь."

# ch/harems_full/office/events/events.rpy:5474
translate russian office_aletta_audrey_lavish_shiori_01_e09e0a18:
    aletta.say "Должна сказать, ваш недостаток энтузиазма меня разочаровывает."

# ch/harems_full/office/events/events.rpy:5475
translate russian office_aletta_audrey_lavish_shiori_01_4a01939f:
    aletta.say "Мне сказали, что это поможет повысить мою продуктивность."

# ch/harems_full/office/events/events.rpy:5477
translate russian office_aletta_audrey_lavish_shiori_01_4fed02d8:
    aletta.say "Почему бы мне не подойти к этому так же, как к любому другому занятию с подобным эффектом?"

# ch/harems_full/office/events/events.rpy:5479
translate russian office_aletta_audrey_lavish_shiori_01_5ed231ec:
    mike.say "Может, потому что это ещё и должно приносить удовольствие?"

# ch/harems_full/office/events/events.rpy:5481
translate russian office_aletta_audrey_lavish_shiori_01_adbd2086:
    "Алетта высокомерно фыркает, переводя внимание на меня."

# ch/harems_full/office/events/events.rpy:5482
translate russian office_aletta_audrey_lavish_shiori_01_22949f14:
    aletta.say "Ну, это ещё предстоит выяснить."

# ch/harems_full/office/events/events.rpy:5483
translate russian office_aletta_audrey_lavish_shiori_01_152218a1:
    aletta.say "Так чего вы все ждёте?"

# ch/harems_full/office/events/events.rpy:5484
translate russian office_aletta_audrey_lavish_shiori_01_46d86195:
    aletta.say "Раздеваемся и приступаем!"

# ch/harems_full/office/events/events.rpy:5485
translate russian office_aletta_audrey_lavish_shiori_01_e5f20a78:
    "Я киваю и начинаю выполнять требование Алетты."

# ch/harems_full/office/events/events.rpy:5486
translate russian office_aletta_audrey_lavish_shiori_01_d8ea07cf:
    "Не потому, что мне нравится, когда она командует, поймите правильно."

# ch/harems_full/office/events/events.rpy:5487
translate russian office_aletta_audrey_lavish_shiori_01_9f10618a:
    "Скорее хочу показать готовность и сделать всё, чтобы у нас получилось."

# ch/harems_full/office/events/events.rpy:5488
translate russian office_aletta_audrey_lavish_shiori_01_c45d2310:
    "Постепенно Одри, Лавиш и Сиори следуют моему примеру."

# ch/harems_full/office/events/events.rpy:5494
translate russian office_aletta_audrey_lavish_shiori_01_523254c4:
    "Но когда все раздеты и готовы, я понимаю, что пора действовать."

# ch/harems_full/office/events/events.rpy:5495
translate russian office_aletta_audrey_lavish_shiori_01_9d4e1ac3:
    "Подхожу и протягиваю руку к выбранной девушке."

# ch/harems_full/office/events/events.rpy:5496
translate russian office_aletta_audrey_lavish_shiori_01_a9796246:
    "Вот это я Алетте диктовать не позволю!"

# ch/harems_full/office/events/events.rpy:5517
translate russian office_fivesome_alettafuck_audrey_lavish_shiori_4e51c473:
    "Сейчас мне меньше всего хочется отдавать Алетте власть."

# ch/harems_full/office/events/events.rpy:5518
translate russian office_fivesome_alettafuck_audrey_lavish_shiori_c58b398a:
    "Я прекрасно знаю: в любой ситуации она любит быть главной сукой."

# ch/harems_full/office/events/events.rpy:5519
translate russian office_fivesome_alettafuck_audrey_lavish_shiori_58ac5fb6:
    "Возможно, я бы и позволил ей командовать остальными девушками."

# ch/harems_full/office/events/events.rpy:5520
translate russian office_fivesome_alettafuck_audrey_lavish_shiori_04bad6d1:
    "Но уж точно не хочу, чтобы она ещё и мной помыкала!"

# ch/harems_full/office/events/events.rpy:5521
translate russian office_fivesome_alettafuck_audrey_lavish_shiori_963f9b72:
    "Самое очевидное — предпочесть ей Одри, Лавиш или Сиори."

# ch/harems_full/office/events/events.rpy:5522
translate russian office_fivesome_alettafuck_audrey_lavish_shiori_7840f70d:
    "Но, может, лучше сработает обратная психология?"

# ch/harems_full/office/events/events.rpy:5523
translate russian office_fivesome_alettafuck_audrey_lavish_shiori_d5df8897:
    mike.say "Для Алетты это первый раз."

# ch/harems_full/office/events/events.rpy:5524
translate russian office_fivesome_alettafuck_audrey_lavish_shiori_8ead2ed4:
    mike.say "Так что, по-моему, прокатиться должна именно она."

# ch/harems_full/office/events/events.rpy:5525
translate russian office_fivesome_alettafuck_audrey_lavish_shiori_316735ee:
    "Лавиш и Сиори сразу кивают в знак согласия."

# ch/harems_full/office/events/events.rpy:5527
translate russian office_fivesome_alettafuck_audrey_lavish_shiori_e28654f5:
    lavish.say "Я не против."

# ch/harems_full/office/events/events.rpy:5529
translate russian office_fivesome_alettafuck_audrey_lavish_shiori_0288ae2a:
    shiori.say "Конечно, [lssb_common.hero_name()]."

# ch/harems_full/office/events/events.rpy:5531
translate russian office_fivesome_alettafuck_audrey_lavish_shiori_b127baa1:
    "Но по лицу Одри вижу, что она хочет возразить."

# ch/harems_full/office/events/events.rpy:5532
translate russian office_fivesome_alettafuck_audrey_lavish_shiori_7d8042c5:
    "В ответ я выразительно смотрю на неё, широко раскрыв глаза, и качаю головой."

