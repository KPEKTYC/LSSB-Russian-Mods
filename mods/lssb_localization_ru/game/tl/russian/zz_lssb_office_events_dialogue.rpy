# Native Office_events identifiers, current source catalog. Translation only.

# ch/harems_full/office/events/events.rpy:393
translate russian office_event_01_44e7b803:
    "Последние несколько дней я сознательно пытаюсь с головой уйти в работу."

# ch/harems_full/office/events/events.rpy:394
translate russian office_event_01_34f9b054:
    "И, кажется, получается: мысли заняты только делом."

# ch/harems_full/office/events/events.rpy:395
translate russian office_event_01_d618452c:
    "Возможно, это и правда помогло бы."

# ch/harems_full/office/events/events.rpy:396
translate russian office_event_01_a2cbeab5:
    "Если бы я не услышал нарочитое покашливание и не оторвался от стола."

# ch/harems_full/office/events/events.rpy:397
translate russian office_event_01_42e401fc:
    "Дверь моего кабинета открыта."

# ch/harems_full/office/events/events.rpy:399
translate russian office_event_01_537198a0:
    "И я без труда узнаю стоящую на пороге женщину."

# ch/harems_full/office/events/events.rpy:401
translate russian office_event_01_6eac2e86:
    mike.say "Здравствуйте, Шери."

# ch/harems_full/office/events/events.rpy:404
translate russian office_event_01_a9befd33:
    "Шери поначалу не отвечает, лишь приподнимает бровь."

# ch/harems_full/office/events/events.rpy:405
translate russian office_event_01_83c41ef6:
    "Я изо всех сил стараюсь звучать так, будто просто удивлён её появлению в моём кабинете."

# ch/harems_full/office/events/events.rpy:406
translate russian office_event_01_bfc1309d:
    "Но мы оба понимаем: за этим скрывается нечто большее."

# ch/harems_full/office/events/events.rpy:407
translate russian office_event_01_51ca34b2:
    "С чего бы ещё жене бывшего генерального директора навещать сотрудника моего уровня?"

# ch/harems_full/office/events/events.rpy:409
translate russian office_event_01_2ca4a654:
    cherie.say "Я просто проходила мимо, [lssb_common.hero_name()], только и всего."

# ch/harems_full/office/events/events.rpy:410
translate russian office_event_01_a8e700c3:
    cherie.say "И вопрос скорее в том, чем я могу помочь вам..."

# ch/harems_full/office/events/events.rpy:414
translate russian office_event_01_48d95a47:
    "Шери закрывает за собой дверь и направляется к моему столу."

# ch/harems_full/office/events/events.rpy:415
translate russian office_event_01_09734b5a:
    "Хотя «направляется» — не совсем точное слово."

# ch/harems_full/office/events/events.rpy:416
translate russian office_event_01_1e6fcc07:
    "Такая женщина никогда не ходит просто так."

# ch/harems_full/office/events/events.rpy:417
translate russian office_event_01_c6f0eef1:
    "На самом деле Шери плывёт к столу, покачивая бёдрами."

# ch/harems_full/office/events/events.rpy:418
translate russian office_event_01_4d049172:
    "И каждый шаг выгодно подчёркивает её достоинства, колышущиеся под одеждой."

# ch/harems_full/office/events/events.rpy:420
translate russian office_event_01_c8c195ea:
    cherie.say "Не стану вам лгать, [lssb_common.hero_name()]."

# ch/harems_full/office/events/events.rpy:421
translate russian office_event_01_b88d3b7b:
    cherie.say "И ходить вокруг да около тоже не буду."

# ch/harems_full/office/events/events.rpy:423
translate russian office_event_01_a5f38c49:
    mike.say "Н... не будете?"

# ch/harems_full/office/events/events.rpy:425
translate russian office_event_01_dbddb43b:
    "Шери присаживается на край моего стола."

# ch/harems_full/office/events/events.rpy:427
translate russian office_event_01_13e381a3:
    "Затем наклоняется так близко, что я чувствую её аромат."

# ch/harems_full/office/events/events.rpy:428
translate russian office_event_01_408dc6d4:
    "И даже вижу, как вздымается её грудь, заглянув в вырез платья!"

# ch/harems_full/office/events/events.rpy:430
translate russian office_event_01_ed9bf4d5:
    cherie.say "Нет. Я хочу, чтобы мы были предельно откровенны друг с другом."

# ch/harems_full/office/events/events.rpy:431
translate russian office_event_01_770ccca2:
    cherie.say "В такое время важно быть едиными в мыслях."

# ch/harems_full/office/events/events.rpy:432
translate russian office_event_01_d392d2f3:
    cherie.say "И телом тоже..."

# ch/harems_full/office/events/events.rpy:434
translate russian office_event_01_0240fd6c:
    mike.say "Конечно, Шери."

# ch/harems_full/office/events/events.rpy:435
translate russian office_event_01_1ebe68e2:
    mike.say "Как скажете!"

# ch/harems_full/office/events/events.rpy:436
translate russian office_event_01_c9666e1f:
    "Шери кивает, явно довольная моим ответом."

# ch/harems_full/office/events/events.rpy:438
translate russian office_event_01_a2626c5d:
    cherie.say "Смерть Дуэйна оставила огромную пустоту, [lssb_common.hero_name()]."

# ch/harems_full/office/events/events.rpy:439
translate russian office_event_01_f7848919:
    cherie.say "Огромную зияющую дыру, которая так и просит её заполнить!"

# ch/harems_full/office/events/events.rpy:441
translate russian office_event_01_0716bf9b:
    "Я снова киваю, на этот раз быстрее."

# ch/harems_full/office/events/events.rpy:442
translate russian office_event_01_e706feb1:
    "Вот как на меня действуют её слова."

# ch/harems_full/office/events/events.rpy:444
translate russian office_event_01_a366844f:
    cherie.say "И я думаю, вы как раз тот мужчина, который её заполнит."

# ch/harems_full/office/events/events.rpy:445
translate russian office_event_01_612cc568:
    cherie.say "Ну что скажете, [lssb_common.hero_name()]?"

# ch/harems_full/office/events/events.rpy:446
translate russian office_event_01_5407f584:
    cherie.say "Заполните мою дырочку?"

# ch/harems_full/office/events/events.rpy:447
translate russian office_event_01_8016ee26:
    cherie.say "Возьмёте на себя роль нового генерального директора этой компании?"

# ch/harems_full/office/events/events.rpy:449
translate russian office_event_01_9535af7a:
    "Секундочку, она сказала именно то, что я услышал?"

# ch/harems_full/office/events/events.rpy:450
translate russian office_event_01_9675c00f:
    "Шери только что предложила мне возглавить компанию?!"

# ch/harems_full/office/events/events.rpy:453
translate russian office_event_01_be905e81:
    "Да! Она действительно предлагает мне должность Дуэйна!"

# ch/harems_full/office/events/events.rpy:454
translate russian office_event_01_52cc9176:
    "А если она предлагает мне это, что ещё идёт в придачу?"

# ch/harems_full/office/events/events.rpy:455
translate russian office_event_01_9ef57e2e:
    "Может, это просто карма?"

# ch/harems_full/office/events/events.rpy:456
translate russian office_event_01_ca61f67c:
    "Вселенная наконец воздаёт мне за всё пережитое дерьмо."

# ch/harems_full/office/events/events.rpy:457
translate russian office_event_01_6f8185ba:
    mike.say "Вы серьёзно, Шери?"

# ch/harems_full/office/events/events.rpy:458
translate russian office_event_01_02fe1e86:
    mike.say "Хотите, чтобы я занял место Дуэйна и управлял компанией?"

# ch/harems_full/office/events/events.rpy:459
translate russian office_event_01_166c6afc:
    "Шери посмеивается над моим воодушевлением."

# ch/harems_full/office/events/events.rpy:461
translate russian office_event_01_114f0dde:
    "Она наклоняется ближе и гладит меня по щеке."

# ch/harems_full/office/events/events.rpy:462
translate russian office_event_01_016205e5:
    "Я чувствую на лице тепло её дыхания."

# ch/harems_full/office/events/events.rpy:463
translate russian office_event_01_410d0948:
    "Будто она дразнит меня, собой показывая, что мне предлагают."

# ch/harems_full/office/events/events.rpy:464
translate russian office_event_01_7d900171:
    "Остаётся лишь протянуть руку и взять!"

# ch/harems_full/office/events/events.rpy:466
translate russian office_event_01_3343fa23:
    cherie.say "Ну, не совсем так, как Дуэйн."

# ch/harems_full/office/events/events.rpy:467
translate russian office_event_01_43cdbd77:
    cherie.say "Для начала я буду участвовать в делах гораздо более непосредственно."

# ch/harems_full/office/events/events.rpy:468
translate russian office_event_01_f7f54d70:
    cherie.say "Буду рядом всякий раз, когда понадоблюсь вам."

# ch/harems_full/office/events/events.rpy:470
translate russian office_event_01_e011deef:
    cherie.say "Можете считать меня полезным ресурсом."

# ch/harems_full/office/events/events.rpy:471
translate russian office_event_01_8c20c32d:
    cherie.say "Использовать, как только пожелаете..."

# ch/harems_full/office/events/events.rpy:473
translate russian office_event_01_0077efb8:
    "Не сразу до меня доходит, что Шери замолчала."

# ch/harems_full/office/events/events.rpy:474
translate russian office_event_01_5ede1163:
    "И теперь ждёт моего ответа."

# ch/harems_full/office/events/events.rpy:475
translate russian office_event_01_a06e2b3f:
    "Кажется, всё это время я пялился на её грудь."

# ch/harems_full/office/events/events.rpy:477
translate russian office_event_01_4534f35c:
    cherie.say "Ну, [lssb_common.hero_name()], хотите эту должность?"

# ch/harems_full/office/events/events.rpy:479
translate russian office_event_01_12e67c0b:
    mike.say "Конечно, Шери."

# ch/harems_full/office/events/events.rpy:480
translate russian office_event_01_e3a665d2:
    mike.say "Нужно быть безумцем, чтобы отказаться от такой женщины, как вы..."

# ch/harems_full/office/events/events.rpy:481
translate russian office_event_01_4fb41026:
    mike.say "От такой возможности... я... я имел в виду возможность!"

# ch/harems_full/office/events/events.rpy:483
translate russian office_event_01_f7e8a472:
    "Шери медленно расплывается в широкой улыбке довольной хищницы."

# ch/harems_full/office/events/events.rpy:485
translate russian office_event_01_58ea0a52:
    "Она обхватывает мой подбородок ладонью и притягивает ещё ближе."

# ch/harems_full/office/events/events.rpy:486
translate russian office_event_01_b5ef230a:
    "Затем целует меня в лоб."

# ch/harems_full/office/events/events.rpy:488
translate russian office_event_01_52168e4d:
    cherie.say "Прекрасно, [lssb_common.hero_name()]."

# ch/harems_full/office/events/events.rpy:489
translate russian office_event_01_bc288389:
    cherie.say "Вы приняли верное решение."

# ch/harems_full/office/events/events.rpy:491
translate russian office_event_01_5961abba:
    "Шери встаёт и неторопливо выходит из моего кабинета."

# ch/harems_full/office/events/events.rpy:493
translate russian office_event_01_1355c359:
    "Лишь когда она уходит, я издаю изумлённый вздох."

# ch/harems_full/office/events/events.rpy:494
translate russian office_event_01_d8937bc6:
    "Неужели это происходит на самом деле?"

# ch/harems_full/office/events/events.rpy:495
translate russian office_event_01_49701d7c:
    "Я правда стану генеральным директором всей компании?!"

# ch/harems_full/office/events/events.rpy:507
translate russian office_event_01_0798d2d5:
    "Да о чём она вообще думает?"

# ch/harems_full/office/events/events.rpy:508
translate russian office_event_01_808d3368:
    "У меня нет и близко нужной квалификации для такого повышения!"

# ch/harems_full/office/events/events.rpy:509
translate russian office_event_01_6d50710b:
    "А чем закончил человек, который занимал эту должность до меня?"

# ch/harems_full/office/events/events.rpy:510
translate russian office_event_01_282d5bbb:
    "Каковы бы ни были официальные выводы о смерти Дуэйна, он всё равно мёртв."

# ch/harems_full/office/events/events.rpy:511
translate russian office_event_01_7ccb671a:
    "И, скорее всего, если бы он не был генеральным директором, то до сих пор оставался бы жив!"

# ch/harems_full/office/events/events.rpy:512
translate russian office_event_01_9e73d5e9:
    mike.say "Мне, конечно, очень лестно."

# ch/harems_full/office/events/events.rpy:513
translate russian office_event_01_5f8fa9bf:
    mike.say "Но нет, Шери."

# ch/harems_full/office/events/events.rpy:514
translate russian office_event_01_e1e260f0:
    mike.say "Я не могу взять на себя такую ответственность."

# ch/harems_full/office/events/events.rpy:516
translate russian office_event_01_5ee6048f:
    "Шери наклоняется ещё ближе, поглаживая меня под подбородком."

# ch/harems_full/office/events/events.rpy:517
translate russian office_event_01_32333c95:
    "Она уже так близко, что почти касается меня."

# ch/harems_full/office/events/events.rpy:518
translate russian office_event_01_0b9efde8:
    "Почти, но не совсем — словно показывает то, что находится в пределах досягаемости."

# ch/harems_full/office/events/events.rpy:519
translate russian office_event_01_cd583908:
    "Нужно лишь набраться смелости, протянуть руку и взять..."

# ch/harems_full/office/events/events.rpy:521
translate russian office_event_01_c11e3324:
    cherie.say "Всё не так, [lssb_common.hero_name()]."

# ch/harems_full/office/events/events.rpy:522
translate russian office_event_01_6bcb0542:
    cherie.say "Я буду рядом на каждом шагу."

# ch/harems_full/office/events/events.rpy:523
translate russian office_event_01_491848ee:
    cherie.say "Готова удовлетворить любую вашу потребность."

# ch/harems_full/office/events/events.rpy:524
translate russian office_event_01_3204e1b6:
    cherie.say "Позволю использовать меня как пожелаете..."

# ch/harems_full/office/events/events.rpy:526
translate russian office_event_01_6a4441d4:
    "Я резко откатываюсь в кресле назад, пока оно не упирается в стену."

# ch/harems_full/office/events/events.rpy:527
translate russian office_event_01_5891f7ac:
    mike.say "НЕТ!"

# ch/harems_full/office/events/events.rpy:528
translate russian office_event_01_815055c6:
    mike.say "То есть... нет, Шери."

# ch/harems_full/office/events/events.rpy:529
translate russian office_event_01_547bb54d:
    mike.say "Теперь компания ваша."

# ch/harems_full/office/events/events.rpy:530
translate russian office_event_01_f300b75d:
    mike.say "Вам нужно назначить того, кто справится с этой работой."

# ch/harems_full/office/events/events.rpy:532
translate russian office_event_01_ee8c1a03:
    "Шери выглядит разочарованной."

# ch/harems_full/office/events/events.rpy:534
translate russian office_event_01_3666b310:
    "Она качает головой, отстраняется и встаёт."

# ch/harems_full/office/events/events.rpy:536
translate russian office_event_01_a6b3f403:
    cherie.say "Если вы так считаете, [lssb_common.hero_name()]."

# ch/harems_full/office/events/events.rpy:537
translate russian office_event_01_4dc4fdf1:
    cherie.say "Но, думаю, вы ещё поймёте, что совершаете ошибку..."

# ch/harems_full/office/events/events.rpy:539
translate russian office_event_01_1a942afe:
    "Всё ещё покачивая головой из-за моего решения, Шери выходит из кабинета."

# ch/harems_full/office/events/events.rpy:541
translate russian office_event_01_f9c6b73d:
    "Я жду, пока она уйдёт, и устало выдыхаю."

# ch/harems_full/office/events/events.rpy:542
translate russian office_event_01_cf504cd2:
    "Уверен, она считала, что выражает мне благодарность."

# ch/harems_full/office/events/events.rpy:543
translate russian office_event_01_a8976287:
    "Но уж точно не хочу быть тем, кто отвечает в этой компании за всё!"

# ch/harems_full/office/events/events.rpy:557
translate russian office_harem_pimping_meeting_91993aa0:
    "Кажется, всё это чёртово совещание я просидел, затаив дыхание."

# ch/harems_full/office/events/events.rpy:558
translate russian office_harem_pimping_meeting_b8b0aa44:
    "Последние несколько недель я работал только над этим, и вот наступил момент истины."

# ch/harems_full/office/events/events.rpy:559
translate russian office_harem_pimping_meeting_ed912793:
    "Либо я заключаю сделку с Blissard Games, либо терплю полный крах."

# ch/harems_full/office/events/events.rpy:560
translate russian office_harem_pimping_meeting_79bdb7ad:
    "И во втором случае могу попрощаться ещё и с премией в десять тысяч."

# ch/harems_full/office/events/events.rpy:561
translate russian office_harem_pimping_meeting_d592d66e:
    "Мотивации более чем достаточно, чтобы ради сделки горы свернуть!"

# ch/harems_full/office/events/events.rpy:562
translate russian office_harem_pimping_meeting_f2e451a5:
    "Пока всё вроде идёт хорошо: явного недовольства с другой стороны нет."

# ch/harems_full/office/events/events.rpy:567
translate russian office_harem_pimping_meeting_c161aa86:
    "Все трое присланных представителей внимательно изучают переданные мной документы."

# ch/harems_full/office/events/events.rpy:568
translate russian office_harem_pimping_meeting_925b646d:
    "Да и презентацию они, похоже, слушали внимательно."

# ch/harems_full/office/events/events.rpy:569
translate russian office_harem_pimping_meeting_3618e2fe:
    "В одной руке у меня ручка, в другой — контракты."

# ch/harems_full/office/events/events.rpy:570
translate russian office_harem_pimping_meeting_02e05f62:
    "Остаётся лишь дождаться, когда Том, Дик и Гарри поставят подписи..."

# ch/harems_full/office/events/events.rpy:572
translate russian office_harem_pimping_meeting_00531dde:
    "Том" "Ну что думаете, парни?"

# ch/harems_full/office/events/events.rpy:574
translate russian office_harem_pimping_meeting_ac5e6571:
    "Дик" "Вроде всё в порядке, Том."

# ch/harems_full/office/events/events.rpy:576
translate russian office_harem_pimping_meeting_c7ee4887:
    "Гарри" "Согласен с Диком. У меня тоже замечаний нет."

# ch/harems_full/office/events/events.rpy:577
translate russian office_harem_pimping_meeting_55d95bfd:
    "Я смотрю, как Том обменивается кивками с коллегами, а затем поворачивается ко мне."

# ch/harems_full/office/events/events.rpy:578
translate russian office_harem_pimping_meeting_9008be0f:
    "Едва сдерживаюсь, чтобы тут же не сунуть контракт ему под нос."

# ch/harems_full/office/events/events.rpy:579
translate russian office_harem_pimping_meeting_04f4febf:
    "Но я знаю, как это бывает."

# ch/harems_full/office/events/events.rpy:580
translate russian office_harem_pimping_meeting_dbbb6a96:
    "Наверняка придётся ещё немного потерпеть светскую болтовню."

# ch/harems_full/office/events/events.rpy:582
translate russian office_harem_pimping_meeting_19ab3187:
    "Том" "Не буду вам врать, [lssb_common.hero_name()]."

# ch/harems_full/office/events/events.rpy:583
translate russian office_harem_pimping_meeting_75a5bd02:
    "Том" "Нам понравилось то, что мы сегодня увидели."

# ch/harems_full/office/events/events.rpy:585
translate russian office_harem_pimping_meeting_000eec1b:
    "Дик" "Ещё как понравилось!"

# ch/harems_full/office/events/events.rpy:587
translate russian office_harem_pimping_meeting_6382867d:
    "Гарри" "Чертовски понравилось!"

# ch/harems_full/office/events/events.rpy:588
translate russian office_harem_pimping_meeting_d9d09d8d:
    mike.say "Э... это замечательно!"

# ch/harems_full/office/events/events.rpy:589
translate russian office_harem_pimping_meeting_98e16e01:
    mike.say "Значит, вы готовы подписать контракты?"

# ch/harems_full/office/events/events.rpy:590
translate russian office_harem_pimping_meeting_980ad0ea:
    mike.say "Как только подпишем, сделка заключена."

# ch/harems_full/office/events/events.rpy:591
translate russian office_harem_pimping_meeting_5e10a786:
    "Том широко улыбается, надеюсь, моему энтузиазму."

# ch/harems_full/office/events/events.rpy:592
translate russian office_harem_pimping_meeting_935b2668:
    "Смотрит на Дика и Гарри — те тоже улыбаются."

# ch/harems_full/office/events/events.rpy:593
translate russian office_harem_pimping_meeting_b1844188:
    "Затем снова поворачивается ко мне."

# ch/harems_full/office/events/events.rpy:595
translate russian office_harem_pimping_meeting_578f12c6:
    "Том" "Конечно, [lssb_common.hero_name()]."

# ch/harems_full/office/events/events.rpy:596
translate russian office_harem_pimping_meeting_e065caf8:
    "Том" "У нас руки чешутся всё подписать. Ещё бы."

# ch/harems_full/office/events/events.rpy:597
translate russian office_harem_pimping_meeting_a31776cc:
    "Том" "Но сперва поговорим о том, что чешется ещё кое-где?"

# ch/harems_full/office/events/events.rpy:598
translate russian office_harem_pimping_meeting_458ec6ea:
    "Я не могу скрыть недоумения от слов Тома."

# ch/harems_full/office/events/events.rpy:599
translate russian office_harem_pimping_meeting_c1c0565f:
    "Мы уже всё обсудили до мельчайших подробностей."

# ch/harems_full/office/events/events.rpy:600
translate russian office_harem_pimping_meeting_b23b2e41:
    "Неужели он заметил что-то, что я упустил?"

# ch/harems_full/office/events/events.rpy:601
translate russian office_harem_pimping_meeting_6c558ac9:
    mike.say "Я... не совсем понимаю, Том."

# ch/harems_full/office/events/events.rpy:602
translate russian office_harem_pimping_meeting_a35f26ac:
    mike.say "Что именно у вас чешется?"

# ch/harems_full/office/events/events.rpy:604
translate russian office_harem_pimping_meeting_4c204702:
    "Том" "Вы же понимаете, [lssb_common.hero_name()]."

# ch/harems_full/office/events/events.rpy:606
translate russian office_harem_pimping_meeting_c90fbf93:
    "Дик" "Все эти бумаги — лишь формальность."

# ch/harems_full/office/events/events.rpy:608
translate russian office_harem_pimping_meeting_48ebdf8d:
    "Гарри" "Речь скорее о гостеприимстве принимающей компании."

# ch/harems_full/office/events/events.rpy:609
translate russian office_harem_pimping_meeting_e9eb8a1c:
    "Гарри" "Просто снять зуд, понимаете?"

# ch/harems_full/office/events/events.rpy:610
translate russian office_harem_pimping_meeting_dd73d57b:
    "При упоминании гостеприимства я быстро смотрю на блюдо на столе."

# ch/harems_full/office/events/events.rpy:611
translate russian office_harem_pimping_meeting_96f75041:
    "На нём ещё остались следы рабочего обеда, который я заказал к встрече."

# ch/harems_full/office/events/events.rpy:612
translate russian office_harem_pimping_meeting_bfe3ad9d:
    "Всю еду съели, пока мы изучали документы."

# ch/harems_full/office/events/events.rpy:613
translate russian office_harem_pimping_meeting_a8f17e6d:
    "Том прослеживает мой взгляд, смеётся и качает головой."

# ch/harems_full/office/events/events.rpy:615
translate russian office_harem_pimping_meeting_c5229141:
    "Том" "Нет, [lssb_common.hero_name()], не о таком гостеприимстве!"

# ch/harems_full/office/events/events.rpy:616
translate russian office_harem_pimping_meeting_f4058d44:
    "Дик" "Как мы уже сказали, увиденное нам понравилось."

# ch/harems_full/office/events/events.rpy:617
translate russian office_harem_pimping_meeting_97208453:
    "Гарри" "А именно — ваши сотрудницы, [lssb_common.hero_name()]."

# ch/harems_full/office/events/events.rpy:618
translate russian office_harem_pimping_meeting_1e562b9d:
    "Я моргаю раз шесть, прежде чем до меня доходит смысл сказанного."

# ch/harems_full/office/events/events.rpy:619
translate russian office_harem_pimping_meeting_fbcab232:
    "Затем глаза расширяются: я понимаю, что это не просто комплимент девушкам."

# ch/harems_full/office/events/events.rpy:620
translate russian office_harem_pimping_meeting_55f3d159:
    mike.say "В... вы ведь не их номера телефонов просите?"

# ch/harems_full/office/events/events.rpy:621
translate russian office_harem_pimping_meeting_3dbe3229:
    "Том, Дик и Гарри одновременно качают головами."

# ch/harems_full/office/events/events.rpy:622
translate russian office_harem_pimping_meeting_e67164f1:
    mike.say "Вам нужно больше, да?"

# ch/harems_full/office/events/events.rpy:623
translate russian office_harem_pimping_meeting_5e1ed0e4:
    "Троица кивает, но теперь их улыбки напоминают волчий оскал."

# ch/harems_full/office/events/events.rpy:626
translate russian office_harem_pimping_meeting_c4c0dbbd:
    "Том" "Лично мне приглянулась та маленькая милашка с огромными сиськами."

# ch/harems_full/office/events/events.rpy:627
translate russian office_harem_pimping_meeting_239b9eb0:
    "Должно быть, он про Сиори."

# ch/harems_full/office/events/events.rpy:628
translate russian office_harem_pimping_meeting_25dca56c:
    "Том" "А вам, парни?"

# ch/harems_full/office/events/events.rpy:630
translate russian office_harem_pimping_meeting_ec26b320:
    "Дик" "Мне нравится та, с длинными тёмными волосами."

# ch/harems_full/office/events/events.rpy:631
translate russian office_harem_pimping_meeting_69fcaa2f:
    "Дик" "У меня уже встаёт от одной мысли о ней!"

# ch/harems_full/office/events/events.rpy:632
translate russian office_harem_pimping_meeting_8d968044:
    "Это, наверное, Одри."

# ch/harems_full/office/events/events.rpy:634
translate russian office_harem_pimping_meeting_8da9602f:
    "Гарри" "Ох, а та девушка с каре и огромными глазами!"

# ch/harems_full/office/events/events.rpy:635
translate russian office_harem_pimping_meeting_48b5c16b:
    "Гарри" "Я бы купил это за доллар!"

# ch/harems_full/office/events/events.rpy:636
translate russian office_harem_pimping_meeting_af24ea56:
    "Тут речь может быть только о Лавиш."

# ch/harems_full/office/events/events.rpy:638
translate russian office_harem_pimping_meeting_0197d004:
    "Том" "Не понимаю, как вам удаётся сосредоточиться с такими девушками в офисе, [lssb_common.hero_name()]!"

# ch/harems_full/office/events/events.rpy:639
translate russian office_harem_pimping_meeting_8eef95aa:
    "Том" "Дайте нам как следует с ними развлечься, и дело в шляпе."

# ch/harems_full/office/events/events.rpy:640
translate russian office_harem_pimping_meeting_d007c8f3:
    "Я с трудом сглатываю, поняв, что они совершенно серьёзны."

# ch/harems_full/office/events/events.rpy:641
translate russian office_harem_pimping_meeting_05d99434:
    "Я хочу заключить сделку и получить свои десять тысяч."

# ch/harems_full/office/events/events.rpy:642
translate russian office_harem_pimping_meeting_dbd16c3a:
    "Но ради этого придётся подложить под них своих коллег!"

# ch/harems_full/office/events/events.rpy:645
translate russian office_harem_pimping_meeting_74cd3c7e:
    "А почему бы и нет?"

# ch/harems_full/office/events/events.rpy:646
translate russian office_harem_pimping_meeting_825b1b93:
    "В конце концов, это я из кожи вон лез ради этой сделки."

# ch/harems_full/office/events/events.rpy:647
translate russian office_harem_pimping_meeting_b1db4d2b:
    "А выгоду получит каждая из них."

# ch/harems_full/office/events/events.rpy:648
translate russian office_harem_pimping_meeting_dae86980:
    "Так что в каком-то смысле они просто заработают свою долю прибыли."

# ch/harems_full/office/events/events.rpy:649
translate russian office_harem_pimping_meeting_2b15b423:
    mike.say "Ладно, господа, договорились."

# ch/harems_full/office/events/events.rpy:650
translate russian office_harem_pimping_meeting_4399f087:
    mike.say "Подождите здесь, пока я поговорю с девушками."

# ch/harems_full/office/events/events.rpy:651
translate russian office_harem_pimping_meeting_6f3b1401:
    "Пока я встаю, Том, Дик и Гарри обмениваются взглядами, полными нескрываемого предвкушения."

# ch/harems_full/office/events/events.rpy:652
translate russian office_harem_pimping_meeting_338a40c2:
    "Теперь осталось убедить трёх моих коллег, что это хорошая идея!"

# ch/harems_full/office/events/events.rpy:655
translate russian office_harem_pimping_meeting_6ed22a1e:
    "Том здесь главный — это было ясно с самого начала."

# ch/harems_full/office/events/events.rpy:656
translate russian office_harem_pimping_meeting_f5c8849d:
    "Может, использовать это, чтобы облегчить себе задачу?"

# ch/harems_full/office/events/events.rpy:657
translate russian office_harem_pimping_meeting_a6376234:
    "Если ему нужна только Сиори, возможно, остальные просто подстроятся."

# ch/harems_full/office/events/events.rpy:658
translate russian office_harem_pimping_meeting_4d58e49a:
    mike.say "С тремя девушками здесь будет слишком тесно, поверьте."

# ch/harems_full/office/events/events.rpy:659
translate russian office_harem_pimping_meeting_af5b2105:
    mike.say "К тому же Сиори справится со всеми вами троими."

# ch/harems_full/office/events/events.rpy:660
translate russian office_harem_pimping_meeting_df170d63:
    mike.say "Это та девушка, которая вам понравилась, Том."

# ch/harems_full/office/events/events.rpy:661
translate russian office_harem_pimping_meeting_eac46512:
    "Дик и Гарри собираются возразить, но Том их игнорирует."

# ch/harems_full/office/events/events.rpy:663
translate russian office_harem_pimping_meeting_151c2391:
    "Том" "Как скажете, [lssb_common.hero_name()]."

# ch/harems_full/office/events/events.rpy:664
translate russian office_harem_pimping_meeting_49128e8a:
    "Том" "Но пусть она будет хороша за троих!"

# ch/harems_full/office/events/events.rpy:665
translate russian office_harem_pimping_meeting_26da843b:
    "Пока я встаю, они обмениваются взглядами, полными нескрываемого предвкушения."

# ch/harems_full/office/events/events.rpy:666
translate russian office_harem_pimping_meeting_71256a2d:
    "Теперь осталось убедить Сиори, что это хорошая идея!"

# ch/harems_full/office/events/events.rpy:669
translate russian office_harem_pimping_meeting_9eca9e1a:
    "Каждому нужна своя девушка, и это грозит осложнениями."

# ch/harems_full/office/events/events.rpy:670
translate russian office_harem_pimping_meeting_112e1d68:
    "Но Дик только что особенно заинтересовался Одри."

# ch/harems_full/office/events/events.rpy:671
translate russian office_harem_pimping_meeting_cf21d276:
    "Может, удастся убедить и остальных двоих?"

# ch/harems_full/office/events/events.rpy:672
translate russian office_harem_pimping_meeting_6073472d:
    mike.say "У вас лучший вкус, Дик."

# ch/harems_full/office/events/events.rpy:673
translate russian office_harem_pimping_meeting_d457db2d:
    mike.say "Одри — наша главная шлюха."

# ch/harems_full/office/events/events.rpy:674
translate russian office_harem_pimping_meeting_79eaceaa:
    mike.say "Готов поспорить, она бы справилась со всеми вами троими!"

# ch/harems_full/office/events/events.rpy:675
translate russian office_harem_pimping_meeting_8b97293d:
    "Том и Гарри, кажется, собираются возразить."

# ch/harems_full/office/events/events.rpy:676
translate russian office_harem_pimping_meeting_bb3e7607:
    "Но Дик клюёт на приманку раньше, чем они успевают его остановить."

# ch/harems_full/office/events/events.rpy:677
translate russian office_harem_pimping_meeting_ed0de766:
    "Дик" "Звучит отлично, [lssb_common.hero_name()]!"

# ch/harems_full/office/events/events.rpy:678
translate russian office_harem_pimping_meeting_ca8977f4:
    "Дик" "Берём её вместо двух других."

# ch/harems_full/office/events/events.rpy:679
translate russian office_harem_pimping_meeting_e6fa7453:
    "Том и Гарри испепеляют Дика взглядами, но тот словно не замечает."

# ch/harems_full/office/events/events.rpy:680
translate russian office_harem_pimping_meeting_947d2fd3:
    "Теперь осталось убедить Одри, что это хорошая идея!"

# ch/harems_full/office/events/events.rpy:683
translate russian office_harem_pimping_meeting_9eca9e1a_1:
    "Каждому нужна своя девушка, и это грозит осложнениями."

# ch/harems_full/office/events/events.rpy:684
translate russian office_harem_pimping_meeting_cb798ef8:
    "Но Гарри только что особенно заинтересовался Лавиш."

# ch/harems_full/office/events/events.rpy:685
translate russian office_harem_pimping_meeting_cf21d276_1:
    "Может, удастся убедить и остальных двоих?"

# ch/harems_full/office/events/events.rpy:686
translate russian office_harem_pimping_meeting_419d2d24:
    mike.say "У вас лучший вкус, Гарри."

# ch/harems_full/office/events/events.rpy:687
translate russian office_harem_pimping_meeting_dee27b7f:
    mike.say "Лавиш может казаться невинной, но за этим скрывается шлюха."

# ch/harems_full/office/events/events.rpy:688
translate russian office_harem_pimping_meeting_79eaceaa_1:
    mike.say "Готов поспорить, она бы справилась со всеми вами троими!"

# ch/harems_full/office/events/events.rpy:689
translate russian office_harem_pimping_meeting_baed85a4:
    "Том и Дик, кажется, собираются возразить."

# ch/harems_full/office/events/events.rpy:690
translate russian office_harem_pimping_meeting_97cdb2d8:
    "Но Гарри клюёт на приманку раньше, чем они успевают его остановить."

# ch/harems_full/office/events/events.rpy:691
translate russian office_harem_pimping_meeting_df4b5cf0:
    "Гарри" "Звучит отлично, [lssb_common.hero_name()]!"

# ch/harems_full/office/events/events.rpy:692
translate russian office_harem_pimping_meeting_45ed8a94:
    "Гарри" "Берём её вместо двух других."

# ch/harems_full/office/events/events.rpy:693
translate russian office_harem_pimping_meeting_630ba9cf:
    "Том и Дик испепеляют Гарри взглядами, но тот словно не замечает."

# ch/harems_full/office/events/events.rpy:694
translate russian office_harem_pimping_meeting_77db829c:
    "Теперь осталось убедить Лавиш, что это хорошая идея!"

# ch/harems_full/office/events/events.rpy:697
translate russian office_harem_pimping_meeting_9eca9e1a_2:
    "Каждому нужна своя девушка, и это грозит осложнениями."

# ch/harems_full/office/events/events.rpy:698
translate russian office_harem_pimping_meeting_ab25ff7b:
    "Но что, если есть совсем другой вариант?"

# ch/harems_full/office/events/events.rpy:699
translate russian office_harem_pimping_meeting_0b1a4002:
    "Никто из них ещё не видел Алетту."

# ch/harems_full/office/events/events.rpy:700
translate russian office_harem_pimping_meeting_85c17b62:
    "А ведь она практически воплощённая влажная мечта офисного работника!"

# ch/harems_full/office/events/events.rpy:701
translate russian office_harem_pimping_meeting_2d099840:
    mike.say "Поверьте, не стоит тратить время на этих мелких шлюшек."

# ch/harems_full/office/events/events.rpy:702
translate russian office_harem_pimping_meeting_2311c02b:
    mike.say "Это ниже вашего достоинства — трахать тех, кто вам не по рангу."

# ch/harems_full/office/events/events.rpy:703
translate russian office_harem_pimping_meeting_f2564106:
    mike.say "Вам нужна Алетта, настоящая корпоративная штучка."

# ch/harems_full/office/events/events.rpy:704
translate russian office_harem_pimping_meeting_eaca7d4b:
    mike.say "Чёрт, спорим, она бы справилась со всеми вами сразу!"

# ch/harems_full/office/events/events.rpy:705
translate russian office_harem_pimping_meeting_84701659:
    "Том, Дик и Гарри многозначительно переглядываются."

# ch/harems_full/office/events/events.rpy:706
translate russian office_harem_pimping_meeting_08e12356:
    "И я вижу, что идея пришлась им по душе."

# ch/harems_full/office/events/events.rpy:707
translate russian office_harem_pimping_meeting_76464c3c:
    "Наверняка в Blissard они и так постоянно трахают рядовых сотрудниц."

# ch/harems_full/office/events/events.rpy:708
translate russian office_harem_pimping_meeting_b7db6949:
    "А я предлагаю им деликатес, куда более редкую добычу."

# ch/harems_full/office/events/events.rpy:710
translate russian office_harem_pimping_meeting_151c2391_1:
    "Том" "Как скажете, [lssb_common.hero_name()]."

# ch/harems_full/office/events/events.rpy:711
translate russian office_harem_pimping_meeting_49128e8a_1:
    "Том" "Но пусть она будет хороша за троих!"

# ch/harems_full/office/events/events.rpy:712
translate russian office_harem_pimping_meeting_443a7f19:
    "Отлично. Теперь осталось убедить Алетту, что это хорошая идея!"

# ch/harems_full/office/events/events.rpy:715
translate russian office_harem_pimping_meeting_b6393e3b:
    "Блядь, я всегда думал, что такая мерзость бывает только в кино."

# ch/harems_full/office/events/events.rpy:716
translate russian office_harem_pimping_meeting_e41d6d4d:
    "А эти типы ведут себя так, будто ничего особенного не происходит: обычная часть переговоров."

# ch/harems_full/office/events/events.rpy:717
translate russian office_harem_pimping_meeting_fd50924c:
    "Если я соглашусь, как потом буду смотреть на себя в зеркало?"

# ch/harems_full/office/events/events.rpy:718
translate russian office_harem_pimping_meeting_5e38292f:
    "Деньги будут казаться грязными, а я — чувствовать себя сутенёром!"

# ch/harems_full/office/events/events.rpy:719
translate russian office_harem_pimping_meeting_147da622:
    "Нет, пошли они нахуй!"

# ch/harems_full/office/events/events.rpy:720
translate russian office_harem_pimping_meeting_d4d35623:
    "Да кем они себя возомнили?!"

# ch/harems_full/office/events/events.rpy:721
translate russian office_harem_pimping_meeting_0f68990f:
    mike.say "Не знаю, как у вас в Blissard, Том."

# ch/harems_full/office/events/events.rpy:722
translate russian office_harem_pimping_meeting_dcb4b89d:
    mike.say "Но у нас сексуальные домогательства и эксплуатацию совсем не приветствуют."

# ch/harems_full/office/events/events.rpy:723
translate russian office_harem_pimping_meeting_a059aad8:
    "При этих словах лица Тома, Дика и Гарри мрачнеют."

# ch/harems_full/office/events/events.rpy:724
translate russian office_harem_pimping_meeting_34cec696:
    "Том агрессивно толкает лежащие перед ними бумаги обратно ко мне."

# ch/harems_full/office/events/events.rpy:726
translate russian office_harem_pimping_meeting_b125f82b:
    "Том" "Не глупите, [lssb_common.hero_name()]."

# ch/harems_full/office/events/events.rpy:727
translate russian office_harem_pimping_meeting_ddd9c7aa:
    "Том" "Сделка уже почти у нас в кармане."

# ch/harems_full/office/events/events.rpy:728
translate russian office_harem_pimping_meeting_92e81db3:
    "Дик" "Да, [lssb_common.hero_name()], будьте благоразумны."

# ch/harems_full/office/events/events.rpy:729
translate russian office_harem_pimping_meeting_9c74b448:
    "Дик" "Нам всего-то нужны киски."

# ch/harems_full/office/events/events.rpy:730
translate russian office_harem_pimping_meeting_87d37f03:
    "Гарри" "Правда хотите стать тем, кто сорвал сделку?"

# ch/harems_full/office/events/events.rpy:731
translate russian office_harem_pimping_meeting_6e81d8f2:
    "Гарри" "И ради чего — пары шлюх, перекладывающих бумажки?!"

# ch/harems_full/office/events/events.rpy:732
translate russian office_harem_pimping_meeting_353631d1:
    "До этого я был просто потрясён их предложением."

# ch/harems_full/office/events/events.rpy:733
translate russian office_harem_pimping_meeting_87901952:
    "Но теперь начинаю по-настоящему злиться."

# ch/harems_full/office/events/events.rpy:735
translate russian office_harem_pimping_meeting_4e7bcfdb:
    mike.say "Очень рад, что вы выбрали именно такие слова, господа."

# ch/harems_full/office/events/events.rpy:736
translate russian office_harem_pimping_meeting_6379034a:
    mike.say "Теперь мне будет гораздо проще сделать следующий шаг!"

# ch/harems_full/office/events/events.rpy:737
translate russian office_harem_pimping_meeting_0bc2fc47:
    "Том, Дик и Гарри недоумённо переглядываются."

# ch/harems_full/office/events/events.rpy:738
translate russian office_harem_pimping_meeting_0a2c515b:
    mike.say "Улыбнитесь в камеру, парни!"

# ch/harems_full/office/events/events.rpy:740
translate russian office_harem_pimping_meeting_6a23384c:
    "Том" "Это ещё что за хрень?"

# ch/harems_full/office/events/events.rpy:741
translate russian office_harem_pimping_meeting_c7cca85f:
    "Дик" "Вы всё это время вели запись?"

# ch/harems_full/office/events/events.rpy:742
translate russian office_harem_pimping_meeting_c15c80fa:
    "Гарри" "В... вы не серьёзно?"

# ch/harems_full/office/events/events.rpy:743
translate russian office_harem_pimping_meeting_7797d89e:
    mike.say "Эту запись никому больше не обязательно видеть, господа."

# ch/harems_full/office/events/events.rpy:744
translate russian office_harem_pimping_meeting_7d040324:
    mike.say "Конечно, при условии, что мы заключим сделку до того, как вы выйдете за эту дверь!"

# ch/harems_full/office/events/events.rpy:746
translate russian office_harem_pimping_meeting_54f11001:
    "Том" "Ах ты засранец, это шантаж!"

# ch/harems_full/office/events/events.rpy:747
translate russian office_harem_pimping_meeting_1526b2b9:
    mike.say "Похоже на то!"

# ch/harems_full/office/events/events.rpy:748
translate russian office_harem_pimping_meeting_016d0af0:
    mike.say "Ну и что выбираете?"

# ch/harems_full/office/events/events.rpy:749
translate russian office_harem_pimping_meeting_2b1177d0:
    "Том, Дик и Гарри один за другим подходят подписывать контракты."

# ch/harems_full/office/events/events.rpy:750
translate russian office_harem_pimping_meeting_5b055f7d:
    "Ругаются и чертыхаются себе под нос, но всё же подписывают."

# ch/harems_full/office/events/events.rpy:751
translate russian office_harem_pimping_meeting_ae593f54:
    "Когда они уходят, я откидываюсь в кресле, весьма довольный собой."

# ch/harems_full/office/events/events.rpy:752
translate russian office_harem_pimping_meeting_4fff0667:
    "Я заключил сделку, обеспечил себе десять тысяч и никому не подложил своих сотрудниц."

# ch/harems_full/office/events/events.rpy:753
translate russian office_harem_pimping_meeting_f5901a75:
    "Неплохо поработал за день!"

# ch/harems_full/office/events/events.rpy:758
translate russian office_harem_pimping_meeting_e22f54cd:
    mike.say "Так, встреча официально окончена."

# ch/harems_full/office/events/events.rpy:759
translate russian office_harem_pimping_meeting_dafb8433:
    mike.say "Немедленно убирайтесь."

# ch/harems_full/office/events/events.rpy:760
translate russian office_harem_pimping_meeting_3023d106:
    mike.say "Пока я не вызвал охрану, чтобы вас вышвырнули!"

# ch/harems_full/office/events/events.rpy:761
translate russian office_harem_pimping_meeting_ef676499:
    "Том, Дик и Гарри встают, недоверчиво качая головами."

# ch/harems_full/office/events/events.rpy:762
translate russian office_harem_pimping_meeting_bfa96122:
    "Но перед уходом Том ещё успевает порвать контракты и швырнуть их в сторону."

# ch/harems_full/office/events/events.rpy:763
translate russian office_harem_pimping_meeting_fea4e0a4:
    "Я не поддаюсь на провокацию и молча смотрю, как они выходят."

# ch/harems_full/office/events/events.rpy:764
translate russian office_harem_pimping_meeting_b351651a:
    "Конечно, лишиться десяти тысяч сейчас чертовски неприятно."

# ch/harems_full/office/events/events.rpy:765
translate russian office_harem_pimping_meeting_5f2666b2:
    "Но я знаю: это цена того, чтобы уберечь коллег от этих мерзавцев."

# ch/harems_full/office/events/events.rpy:774
translate russian office_harem_pimping_aletta_e839f594:
    "Мало мне было того, что типы из Blissard потребовали секса ради сделки."

# ch/harems_full/office/events/events.rpy:775
translate russian office_harem_pimping_aletta_131a2198:
    "Так я ещё предложил им Алетту вместо тех девушек, которых они хотели!"

# ch/harems_full/office/events/events.rpy:776
translate russian office_harem_pimping_aletta_23b0d89d:
    "Чем я вообще думал, когда подбрасывал им эту идею?"

# ch/harems_full/office/events/events.rpy:777
translate russian office_harem_pimping_aletta_fc8a5aac:
    "На Одри, Лавиш и Сиори я хотя бы мог попытаться надавить своим положением."

# ch/harems_full/office/events/events.rpy:778
translate russian office_harem_pimping_aletta_b2418c42:
    "А Алетта не из тех, кем можно просто командовать."

# ch/harems_full/office/events/events.rpy:779
translate russian office_harem_pimping_aletta_b3d3f0d6:
    "И я понятия не имею, как заставить её согласиться!"

# ch/harems_full/office/events/events.rpy:781
translate russian office_harem_pimping_aletta_b519f2d8:
    "Не появляется идей и тогда, когда спустя несколько мгновений я натыкаюсь на неё."

# ch/harems_full/office/events/events.rpy:782
translate russian office_harem_pimping_aletta_a85689f5:
    "Увидев меня, Алетта приподнимает бровь."

# ch/harems_full/office/events/events.rpy:784
translate russian office_harem_pimping_aletta_f4ce2707:
    aletta.say "О, [lssb_common.hero_name()], не ожидала увидеть тебя здесь."

# ch/harems_full/office/events/events.rpy:787
translate russian office_harem_pimping_aletta_f0deb73c:
    aletta.say "Разве тебе сейчас не полагается быть в переговорной?"

# ch/harems_full/office/events/events.rpy:788
translate russian office_harem_pimping_aletta_ba6aa46e:
    mike.say "Эм, да..."

# ch/harems_full/office/events/events.rpy:789
translate russian office_harem_pimping_aletta_b2b38650:
    mike.say "Уже всё улажено, осталось только подписать."

# ch/harems_full/office/events/events.rpy:792
translate russian office_harem_pimping_aletta_a791a5bb:
    aletta.say "Разве это не самое главное?"

# ch/harems_full/office/events/events.rpy:793
translate russian office_harem_pimping_aletta_0e80f3a1:
    aletta.say "Пока контракты не подписаны, ничего не решено."

# ch/harems_full/office/events/events.rpy:795
translate russian office_harem_pimping_aletta_14c0350a:
    mike.say "Ну, с этим возникла небольшая проблема."

# ch/harems_full/office/events/events.rpy:796
translate russian office_harem_pimping_aletta_893051db:
    mike.say "Парни из Blissard кое-чего хотят, прежде чем поставят подписи!"

# ch/harems_full/office/events/events.rpy:798
translate russian office_harem_pimping_aletta_ce4d60fb:
    "Алетта на мгновение оглядывает офис."

# ch/harems_full/office/events/events.rpy:800
translate russian office_harem_pimping_aletta_ede8bc3e:
    "Затем многозначительно смотрит на меня."

# ch/harems_full/office/events/events.rpy:801
translate russian office_harem_pimping_aletta_ab8c4ac6:
    aletta.say "И, полагаю, то, чего они хотят, находится здесь?"

# ch/harems_full/office/events/events.rpy:802
translate russian office_harem_pimping_aletta_14dfdbea:
    "Чувствую, как к горлу подступает ком."

# ch/harems_full/office/events/events.rpy:803
translate russian office_harem_pimping_aletta_c2972ec0:
    "С трудом сглатываю, понимая, что отступать некуда."

# ch/harems_full/office/events/events.rpy:804
translate russian office_harem_pimping_aletta_79dd5aec:
    "Во всяком случае, если я хочу получить премию!"

# ch/harems_full/office/events/events.rpy:805
translate russian office_harem_pimping_aletta_97fb2ff3:
    mike.say "Да, Алетта, можно и так сказать."

# ch/harems_full/office/events/events.rpy:806
translate russian office_harem_pimping_aletta_6a9ecd5c:
    mike.say "А ещё можно сказать, что я сейчас как раз на это смотрю!"

# ch/harems_full/office/events/events.rpy:808
translate russian office_harem_pimping_aletta_8643b4d5:
    "Алетта моргает, не вполне понимая, о чём я."

# ch/harems_full/office/events/events.rpy:810
translate russian office_harem_pimping_aletta_5f72be1f:
    aletta.say "Что ты имеешь в виду, [lssb_common.hero_name()]?"

# ch/harems_full/office/events/events.rpy:811
translate russian office_harem_pimping_aletta_1113bfb3:
    aletta.say "Тебе нужна моя помощь, чтобы заключить сделку?"

# ch/harems_full/office/events/events.rpy:812
translate russian office_harem_pimping_aletta_1c34475c:
    aletta.say "У меня немалый опыт ведения переговоров."

# ch/harems_full/office/events/events.rpy:814
translate russian office_harem_pimping_aletta_0ca6c507:
    mike.say "Эм, не совсем, Алетта."

# ch/harems_full/office/events/events.rpy:815
translate russian office_harem_pimping_aletta_98d3c029:
    mike.say "Но ты могла бы помочь заключить сделку, если..."

# ch/harems_full/office/events/events.rpy:816
translate russian office_harem_pimping_aletta_e2834bf9:
    mike.say "Ну, если согласишься развлечь парней из Blissard."

# ch/harems_full/office/events/events.rpy:818
translate russian office_harem_pimping_aletta_b0a6159b:
    aletta.say "Что ты понимаешь под «развлечь», [lssb_common.hero_name()]?"

# ch/harems_full/office/events/events.rpy:819
translate russian office_harem_pimping_aletta_55938538:
    aletta.say "Спеть им песенку?"

# ch/harems_full/office/events/events.rpy:820
translate russian office_harem_pimping_aletta_d905e724:
    aletta.say "Станцевать?"

# ch/harems_full/office/events/events.rpy:821
translate russian office_harem_pimping_aletta_bf45f848:
    "Я морщусь ещё до того, как успеваю произнести слова."

# ch/harems_full/office/events/events.rpy:822
translate russian office_harem_pimping_aletta_b03d4744:
    "Будто заранее жду, что Алетта даст мне пощёчину, едва услышит предложение."

# ch/harems_full/office/events/events.rpy:824
translate russian office_harem_pimping_aletta_b4235532:
    mike.say "Я скорее имел в виду позволить им переспать с тобой..."

# ch/harems_full/office/events/events.rpy:826
translate russian office_harem_pimping_aletta_fcf1b504:
    "И тут я вспоминаю другую сторону Алетты."

# ch/harems_full/office/events/events.rpy:827
translate russian office_harem_pimping_aletta_443ab130:
    "Ту, которую она так тщательно скрывает от окружающих."

# ch/harems_full/office/events/events.rpy:828
translate russian office_harem_pimping_aletta_88e282b1:
    "Ту, которая наверняка ухватилась бы за возможность отдаться на волю незнакомца."

# ch/harems_full/office/events/events.rpy:829
translate russian office_harem_pimping_aletta_0e105ab1:
    "А от возможности сделать это с тремя незнакомцами, пожалуй, запрыгала бы от радости!"

# ch/harems_full/office/events/events.rpy:830
translate russian office_harem_pimping_aletta_210479bc:
    mike.say "Отличный способ снять напряжение, Алетта."

# ch/harems_full/office/events/events.rpy:831
translate russian office_harem_pimping_aletta_9c1d8315:
    mike.say "Ну, избавиться от стресса, на который ты постоянно жалуешься..."

# ch/harems_full/office/events/events.rpy:832
translate russian office_harem_pimping_aletta_a1ebbd36:
    "Я смотрю, как Алетта снова оглядывает офис."

# ch/harems_full/office/events/events.rpy:833
translate russian office_harem_pimping_aletta_19834c5d:
    "Но теперь вижу: она делает это от смущения."

# ch/harems_full/office/events/events.rpy:834
translate russian office_harem_pimping_aletta_699ac01c:
    "Её глаза всё шире, а щёки краснеют."

# ch/harems_full/office/events/events.rpy:836
translate russian office_harem_pimping_aletta_fafc76e6:
    aletta.say "Я... не понимаю, о чём ты, [lssb_common.hero_name()]."

# ch/harems_full/office/events/events.rpy:837
translate russian office_harem_pimping_aletta_f3c8d147:
    aletta.say "Я бы никогда не смогла сделать ничего подобного..."

# ch/harems_full/office/events/events.rpy:838
translate russian office_harem_pimping_aletta_a867b8ca:
    mike.say "Да брось, Алетта."

# ch/harems_full/office/events/events.rpy:839
translate russian office_harem_pimping_aletta_374d8ee8:
    mike.say "После всего, что ты просила меня с тобой делать?"

# ch/harems_full/office/events/events.rpy:840
translate russian office_harem_pimping_aletta_df4ff55e:
    mike.say "Прямо здесь, в этом самом офисе?"

# ch/harems_full/office/events/events.rpy:841
translate russian office_harem_pimping_aletta_6149f38e:
    mike.say "Я думал, для такого дела ты подойдёшь лучше всех!"

# ch/harems_full/office/events/events.rpy:843
translate russian office_harem_pimping_aletta_4ce7f47f:
    "Алетта наклоняется ко мне так близко, как только осмеливается."

# ch/harems_full/office/events/events.rpy:844
translate russian office_harem_pimping_aletta_68645aba:
    "И шепчет, почти шипит мне на ухо."

# ch/harems_full/office/events/events.rpy:846
translate russian office_harem_pimping_aletta_8b1a0da1:
    aletta.say "Ладно, [lssb_common.hero_name()], ладно!"

# ch/harems_full/office/events/events.rpy:847
translate russian office_harem_pimping_aletta_e6a78c78:
    aletta.say "Ты слишком хорошо меня знаешь."

# ch/harems_full/office/events/events.rpy:848
translate russian office_harem_pimping_aletta_925b4648:
    aletta.say "Но это только один раз, ясно?"

# ch/harems_full/office/events/events.rpy:849
translate russian office_harem_pimping_aletta_cd22a229:
    aletta.say "Не смей подкладывать меня под кого-то всякий раз, когда нужно заключить сделку!"

# ch/harems_full/office/events/events.rpy:850
translate russian office_harem_pimping_aletta_42438a86:
    mike.say "Понимаю, Алетта."

# ch/harems_full/office/events/events.rpy:851
translate russian office_harem_pimping_aletta_6fda7404:
    mike.say "Только один раз."

# ch/harems_full/office/events/events.rpy:852
translate russian office_harem_pimping_aletta_f8519c8c:
    mike.say "И никому больше знать об этом не обязательно. Поверь."

# ch/harems_full/office/events/events.rpy:853
translate russian office_harem_pimping_aletta_bfc1b6e9:
    "Алетта кивает и хватает меня за руку."

# ch/harems_full/office/events/events.rpy:854
translate russian office_harem_pimping_aletta_403d0479:
    "Затем чуть ли не тащит к переговорной."

# ch/harems_full/office/events/events.rpy:857
translate russian office_harem_pimping_aletta_4024aac8:
    "Может, я подошёл к этому не с той стороны."

# ch/harems_full/office/events/events.rpy:858
translate russian office_harem_pimping_aletta_f3832188:
    "Всё сводил к тому, что Алетта помогает мне."

# ch/harems_full/office/events/events.rpy:859
translate russian office_harem_pimping_aletta_4e547052:
    "Хотя логичнее было бы поставить в центр её саму."

# ch/harems_full/office/events/events.rpy:860
translate russian office_harem_pimping_aletta_a240c657:
    mike.say "Если без шуток, Алетта."

# ch/harems_full/office/events/events.rpy:861
translate russian office_harem_pimping_aletta_1f7f675f:
    mike.say "Мне правда нужна твоя помощь!"

# ch/harems_full/office/events/events.rpy:864
translate russian office_harem_pimping_aletta_22691e96:
    aletta.say "И почему же, [lssb_common.hero_name()]?"

# ch/harems_full/office/events/events.rpy:865
translate russian office_harem_pimping_aletta_cae6b87f:
    aletta.say "Потому что ты сам не дашь этим типам себя трахнуть?"

# ch/harems_full/office/events/events.rpy:866
translate russian office_harem_pimping_aletta_201deb61:
    mike.say "Нет, Алетта, я не об этом."

# ch/harems_full/office/events/events.rpy:867
translate russian office_harem_pimping_aletta_a422f53f:
    mike.say "Послушай, мы оба знаем: тебя стоило привлечь с самого начала."

# ch/harems_full/office/events/events.rpy:868
translate russian office_harem_pimping_aletta_6de20998:
    mike.say "Если бы ты мне помогала, до такого бы не дошло."

# ch/harems_full/office/events/events.rpy:870
translate russian office_harem_pimping_aletta_247943b3:
    "Алетта немного отстраняется и морщится."

# ch/harems_full/office/events/events.rpy:871
translate russian office_harem_pimping_aletta_dd139e71:
    "Вижу, что ей нравится услышанное."

# ch/harems_full/office/events/events.rpy:872
translate russian office_harem_pimping_aletta_31477282:
    "Но, возможно, она всё ещё немного сомневается."

# ch/harems_full/office/events/events.rpy:874
translate russian office_harem_pimping_aletta_c0d11027:
    aletta.say "Ты серьёзно, [lssb_common.hero_name()]?"

# ch/harems_full/office/events/events.rpy:875
translate russian office_harem_pimping_aletta_f7b66fda:
    aletta.say "Потому что ты, конечно, чертовски прав."

# ch/harems_full/office/events/events.rpy:876
translate russian office_harem_pimping_aletta_f6493b06:
    aletta.say "Но обычно ты не из тех, кто открыто признаёт правду!"

# ch/harems_full/office/events/events.rpy:877
translate russian office_harem_pimping_aletta_0d2e75a8:
    mike.say "Конечно серьёзно, Алетта!"

# ch/harems_full/office/events/events.rpy:878
translate russian office_harem_pimping_aletta_5841381c:
    mike.say "Посмотри, в какую кашу я всё превратил."

# ch/harems_full/office/events/events.rpy:879
translate russian office_harem_pimping_aletta_ec172f8a:
    mike.say "Ты бы точно не дошла до того, чтобы предлагать им секс с коллегой!"

# ch/harems_full/office/events/events.rpy:881
translate russian office_harem_pimping_aletta_cce5c93d:
    aletta.say "Ну, это ТОЧНО."

# ch/harems_full/office/events/events.rpy:882
translate russian office_harem_pimping_aletta_c8cbab00:
    "По голосу Алетты я понимаю: она клюнула."

# ch/harems_full/office/events/events.rpy:883
translate russian office_harem_pimping_aletta_87a270f6:
    "Вместо злости на меня теперь она смотрит на всё отстранённо и холодно."

# ch/harems_full/office/events/events.rpy:884
translate russian office_harem_pimping_aletta_a41e1a32:
    "В таком состоянии Алетта думает только о деле, и эмоциям места нет!"

# ch/harems_full/office/events/events.rpy:885
translate russian office_harem_pimping_aletta_ee8fc4fa:
    aletta.say "Но этим условием о сексе ты загнал себя в угол, [lssb_common.hero_name()]."

# ch/harems_full/office/events/events.rpy:886
translate russian office_harem_pimping_aletta_823d8e2b:
    aletta.say "С такой позиции пересмотреть условия уже не получится."

# ch/harems_full/office/events/events.rpy:887
translate russian office_harem_pimping_aletta_d36b1f7a:
    mike.say "Значит, меня поимели — прости за каламбур!"

# ch/harems_full/office/events/events.rpy:888
translate russian office_harem_pimping_aletta_1153e40d:
    mike.say "Они выиграли, а я проиграл..."

# ch/harems_full/office/events/events.rpy:889
translate russian office_harem_pimping_aletta_abbcfba2:
    aletta.say "С таким настроем — определённо!"

# ch/harems_full/office/events/events.rpy:890
translate russian office_harem_pimping_aletta_b39e7173:
    aletta.say "Но если эти типы получат желаемое, они отвлекутся."

# ch/harems_full/office/events/events.rpy:891
translate russian office_harem_pimping_aletta_07e06f42:
    aletta.say "Тогда можно застать их врасплох и вытрясти из них всё до последнего!"

# ch/harems_full/office/events/events.rpy:892
translate russian office_harem_pimping_aletta_9aea46e8:
    mike.say "Но, Алетта..."

# ch/harems_full/office/events/events.rpy:893
translate russian office_harem_pimping_aletta_ac4cfabf:
    mike.say "Для этого придётся..."

# ch/harems_full/office/events/events.rpy:895
translate russian office_harem_pimping_aletta_709a8fdd:
    "Я не успеваю договорить: Алетта железной хваткой сжимает моё запястье."

# ch/harems_full/office/events/events.rpy:896
translate russian office_harem_pimping_aletta_af3e70c8:
    "И тащит через офис обратно в переговорную, причиняя вполне ощутимую боль."

# ch/harems_full/office/events/events.rpy:897
translate russian office_harem_pimping_aletta_c9b33a3d:
    aletta.say "Речь уже не о сексе, [lssb_common.hero_name()]."

# ch/harems_full/office/events/events.rpy:898
translate russian office_harem_pimping_aletta_0e8efa32:
    aletta.say "Нужно смотреть дальше. Видеть всю картину."

# ch/harems_full/office/events/events.rpy:899
translate russian office_harem_pimping_aletta_d3aabddb:
    aletta.say "Речь о сделке и о том, чтобы не позволить этим типам тебя поиметь."

# ch/harems_full/office/events/events.rpy:900
translate russian office_harem_pimping_aletta_b4f76c50:
    aletta.say "Потому что иначе они поимеют не только нас с тобой."

# ch/harems_full/office/events/events.rpy:901
translate russian office_harem_pimping_aletta_f830f500:
    aletta.say "А всю чёртову компанию!"

# ch/harems_full/office/events/events.rpy:905
translate russian office_harem_pimping_aletta_a9a598d0:
    "И я правильно сделал, что заранее приготовился к удару."

# ch/harems_full/office/events/events.rpy:909
translate russian office_harem_pimping_aletta_e3fff4f2:
    "Потому что через несколько секунд Алетта влепляет мне от души."

# ch/harems_full/office/events/events.rpy:910
translate russian office_harem_pimping_aletta_0df48986:
    "Так сильно, что перед глазами на мгновение мелькают звёзды!"

# ch/harems_full/office/events/events.rpy:912
translate russian office_harem_pimping_aletta_bef62391:
    aletta.say "Я сделаю вид, что этого не слышала, [lssb_common.hero_name()]."

# ch/harems_full/office/events/events.rpy:913
translate russian office_harem_pimping_aletta_d6c30e31:
    aletta.say "А ты сделаешь вид, что этого разговора вообще не было."

# ch/harems_full/office/events/events.rpy:914
translate russian office_harem_pimping_aletta_a90514fc:
    aletta.say "Иначе в следующий раз одной пощёчиной не отделаешься."

# ch/harems_full/office/events/events.rpy:916
translate russian office_harem_pimping_aletta_fce55cb3:
    "Я только многократно киваю, держась за горящую щёку."

# ch/harems_full/office/events/events.rpy:917
translate russian office_harem_pimping_aletta_87afaf50:
    "И думаю лишь о том, что, наверное, ещё легко отделался!"

# ch/harems_full/office/events/events.rpy:918
translate russian office_harem_pimping_aletta_954d0583:
    "В конце концов, Алетта имела полное право устроить скандал."

# ch/harems_full/office/events/events.rpy:919
translate russian office_harem_pimping_aletta_ddc9b1a0:
    "А закончив на меня орать, сразу позвонить в отдел кадров!"

# ch/harems_full/office/events/events.rpy:920
translate russian office_harem_pimping_aletta_a10a73eb:
    "Она раздражённо фыркает, разворачивается и уходит в другую сторону."

# ch/harems_full/office/events/events.rpy:921
translate russian office_harem_pimping_aletta_460912fd:
    "А мне остаётся гадать, как я мог оказаться таким идиотом."

# ch/harems_full/office/events/events.rpy:922
translate russian office_harem_pimping_aletta_44b0e22b:
    "И как же мне будет не хватать премии в десять тысяч!"

# ch/harems_full/office/events/events.rpy:931
translate russian office_harem_pimping_audrey_dded53af:
    "Едва дверь за спиной закрывается, я уже с ужасом думаю о предстоящем разговоре."

# ch/harems_full/office/events/events.rpy:932
translate russian office_harem_pimping_audrey_81728397:
    "Неужели нельзя было выбрать для этого любую другую девушку в офисе?"

# ch/harems_full/office/events/events.rpy:933
translate russian office_harem_pimping_audrey_17a84511:
    "Конечно, Лавиш, Сиори или даже Алетту было бы трудно уговорить."

# ch/harems_full/office/events/events.rpy:934
translate russian office_harem_pimping_audrey_d7e6cdde:
    "Но Одри?"

# ch/harems_full/office/events/events.rpy:935
translate russian office_harem_pimping_audrey_f4f9d874:
    "Чем я вообще думал?!"

# ch/harems_full/office/events/events.rpy:936
translate russian office_harem_pimping_audrey_3a653366:
    "Знаю, что она любит устраивать здесь неприятности."

# ch/harems_full/office/events/events.rpy:937
translate russian office_harem_pimping_audrey_68a515d5:
    "Но тут совсем другое дело."

# ch/harems_full/office/events/events.rpy:938
translate russian office_harem_pimping_audrey_e0ebd0c3:
    "Я прошу её пойти на непристойную выходку ради моей выгоды."

# ch/harems_full/office/events/events.rpy:939
translate russian office_harem_pimping_audrey_d28ad7a2:
    "А с её любовью к проделкам Одри вполне может отказать просто из вредности!"

# ch/harems_full/office/events/events.rpy:941
translate russian office_harem_pimping_audrey_46401419:
    "Наверное, поэтому она замечает мои нервы, едва увидев..."

# ch/harems_full/office/events/events.rpy:943
translate russian office_harem_pimping_audrey_400eacfa:
    audrey.say "О-о, кто-то сегодня выглядит особенно подозрительно!"

# ch/harems_full/office/events/events.rpy:944
translate russian office_harem_pimping_audrey_9b0f9eeb:
    audrey.say "Полагаю, встреча идёт не очень гладко, [lssb_common.hero_name()]?"

# ch/harems_full/office/events/events.rpy:945
translate russian office_harem_pimping_audrey_03f47575:
    "Я громко сглатываю, пытаясь взять себя в руки и перехватить инициативу."

# ch/harems_full/office/events/events.rpy:947
translate russian office_harem_pimping_audrey_4c944b86:
    mike.say "Об этом можешь не волноваться, Одри."

# ch/harems_full/office/events/events.rpy:948
translate russian office_harem_pimping_audrey_39b2d5a4:
    mike.say "Вообще-то они уже почти готовы подписать."

# ch/harems_full/office/events/events.rpy:949
translate russian office_harem_pimping_audrey_0854426e:
    mike.say "Вот об этом я и хотел поговорить..."

# ch/harems_full/office/events/events.rpy:950
translate russian office_harem_pimping_audrey_970522b4:
    "Лишь теперь Одри склоняет голову набок и смотрит на меня с настоящим интересом."

# ch/harems_full/office/events/events.rpy:952
translate russian office_harem_pimping_audrey_58c89f86:
    audrey.say "Тогда почему ты здесь разговариваешь со мной, [lssb_common.hero_name()]?"

# ch/harems_full/office/events/events.rpy:953
translate russian office_harem_pimping_audrey_29c23550:
    audrey.say "Разве не должен быть там и следить, чтобы подписи уже высохли?"

# ch/harems_full/office/events/events.rpy:954
translate russian office_harem_pimping_audrey_70e246c5:
    mike.say "Вот в этом и дело, Одри."

# ch/harems_full/office/events/events.rpy:955
translate russian office_harem_pimping_audrey_922cd8df:
    mike.say "Чтобы они подписали, мне нужна твоя помощь."

# ch/harems_full/office/events/events.rpy:956
translate russian office_harem_pimping_audrey_79c115de:
    mike.say "Просто формальность, но они хотят видеть тебя там..."

# ch/harems_full/office/events/events.rpy:958
translate russian office_harem_pimping_audrey_66837599:
    "Одри хмурится, по-прежнему подозрительно меня разглядывая."

# ch/harems_full/office/events/events.rpy:959
translate russian office_harem_pimping_audrey_1f49f16d:
    audrey.say "Из другого конца офиса меня не видно?"

# ch/harems_full/office/events/events.rpy:960
translate russian office_harem_pimping_audrey_4e9dce96:
    audrey.say "Знаешь, всё это становится довольно странным, [lssb_common.hero_name()]!"

# ch/harems_full/office/events/events.rpy:961
translate russian office_harem_pimping_audrey_0bf6d98a:
    mike.say "Эм... нет, Одри."

# ch/harems_full/office/events/events.rpy:962
translate russian office_harem_pimping_audrey_9699a505:
    mike.say "Дело в том, сколько именно они хотят увидеть."

# ch/harems_full/office/events/events.rpy:963
translate russian office_harem_pimping_audrey_84e9e535:
    mike.say "А хотят они увидеть тебя всю. Без одежды."

# ch/harems_full/office/events/events.rpy:964
translate russian office_harem_pimping_audrey_d227f2c5:
    "Любая другая девушка в офисе наверняка пришла бы от такого признания в ужас."

# ch/harems_full/office/events/events.rpy:966
translate russian office_harem_pimping_audrey_0bf15cf3:
    "Но не Одри: подтверждая мои ожидания, она вдруг смотрит хитро и с явным весельем."

# ch/harems_full/office/events/events.rpy:967
translate russian office_harem_pimping_audrey_cba32167:
    audrey.say "Ты имеешь в виду то, о чём я думаю?"

# ch/harems_full/office/events/events.rpy:969
translate russian office_harem_pimping_audrey_33feb3ee:
    audrey.say "Ах ты грязный ублюдок!"

# ch/harems_full/office/events/events.rpy:970
translate russian office_harem_pimping_audrey_46d10f06:
    audrey.say "Предложил меня им как приятный бонус, да?"

# ch/harems_full/office/events/events.rpy:972
translate russian office_harem_pimping_audrey_aa929de3:
    mike.say "Ну... не совсем."

# ch/harems_full/office/events/events.rpy:973
translate russian office_harem_pimping_audrey_333568eb:
    mike.say "Они заметили тебя, когда шли по офису."

# ch/harems_full/office/events/events.rpy:974
translate russian office_harem_pimping_audrey_46966865:
    mike.say "И им... понравилось увиденное!"

# ch/harems_full/office/events/events.rpy:975
translate russian office_harem_pimping_audrey_0c733124:
    mike.say "Я всего лишь согласился спросить."

# ch/harems_full/office/events/events.rpy:976
translate russian office_harem_pimping_audrey_e6737488:
    audrey.say "Спросить что, [lssb_common.hero_name()]?"

# ch/harems_full/office/events/events.rpy:977
translate russian office_harem_pimping_audrey_9f144cce:
    audrey.say "Ну же, хочу услышать, как ты произнесёшь это вслух!"

# ch/harems_full/office/events/events.rpy:978
translate russian office_harem_pimping_audrey_06c31749:
    mike.say "Ладно, Одри: я согласился спросить, не переспишь ли ты с ними."

# ch/harems_full/office/events/events.rpy:979
translate russian office_harem_pimping_audrey_8ffa4c0c:
    mike.say "Вот, сказал. Довольна?"

# ch/harems_full/office/events/events.rpy:981
translate russian office_harem_pimping_audrey_689d3c1a:
    "Для того, кто знает её не так хорошо, как я, это могло бы пройти незаметно."

# ch/harems_full/office/events/events.rpy:983
translate russian office_harem_pimping_audrey_7c7fa151:
    "Но я вижу точный момент, когда Одри прекращает играть и всерьёз обдумывает предложение."

# ch/harems_full/office/events/events.rpy:984
translate russian office_harem_pimping_audrey_180c9da4:
    "Я уже понял, что её демонстративная уверенность и дерзость — всего лишь фасад."

# ch/harems_full/office/events/events.rpy:985
translate russian office_harem_pimping_audrey_c5d1f3b2:
    "За ним она весьма неуверенна в себе и нуждается в одобрении."

# ch/harems_full/office/events/events.rpy:986
translate russian office_harem_pimping_audrey_5f095fca:
    "И вот я предлагаю ей шанс заслужить его, позволив им себя трахнуть..."

# ch/harems_full/office/events/events.rpy:987
translate russian office_harem_pimping_audrey_071a942f:
    audrey.say "Л... ладно, [lssb_common.hero_name()]."

# ch/harems_full/office/events/events.rpy:988
translate russian office_harem_pimping_audrey_75d393d6:
    audrey.say "Я сделаю это."

# ch/harems_full/office/events/events.rpy:989
translate russian office_harem_pimping_audrey_583ff75d:
    audrey.say "Но только потому, что ты попросил, ясно?"

# ch/harems_full/office/events/events.rpy:990
translate russian office_harem_pimping_audrey_47c0eeef:
    "Я улыбаюсь и киваю."

# ch/harems_full/office/events/events.rpy:991
translate russian office_harem_pimping_audrey_aff73234:
    mike.say "Спасибо, Одри."

# ch/harems_full/office/events/events.rpy:992
translate russian office_harem_pimping_audrey_54de11a7:
    mike.say "Ты очень ценна для компании."

# ch/harems_full/office/events/events.rpy:993
translate russian office_harem_pimping_audrey_53e21e4d:
    mike.say "И к тому же очень хорошая девочка!"

# ch/harems_full/office/events/events.rpy:995
translate russian office_harem_pimping_audrey_1c3ac97f:
    "От моих комплиментов щёки Одри краснеют."

# ch/harems_full/office/events/events.rpy:996
translate russian office_harem_pimping_audrey_2c33168e:
    "Она спешит за мной, когда я веду её обратно к переговорной."

# ch/harems_full/office/events/events.rpy:997
translate russian office_harem_pimping_audrey_d95aca3b:
    "А я всё это время удивляюсь, как легко ею управлять."

# ch/harems_full/office/events/events.rpy:998
translate russian office_harem_pimping_audrey_49e69efe:
    "Если, конечно, знать, за какие ниточки тянуть."

# ch/harems_full/office/events/events.rpy:1001
translate russian office_harem_pimping_audrey_2ae178ed:
    audrey.say "Понимаешь, у меня просто нет мотивации."

# ch/harems_full/office/events/events.rpy:1002
translate russian office_harem_pimping_audrey_66eb47a8:
    audrey.say "У тебя-то есть: премия и всё такое."

# ch/harems_full/office/events/events.rpy:1005
translate russian office_harem_pimping_audrey_c155e05e:
    audrey.say "А мне какой интерес?"

# ch/harems_full/office/events/events.rpy:1006
translate russian office_harem_pimping_audrey_ba355e91:
    "Я смотрю на Одри с открытым ртом, поняв, на что она намекает."

# ch/harems_full/office/events/events.rpy:1007
translate russian office_harem_pimping_audrey_8bfeae17:
    "Эта хитрая сучка хочет долю от моей премии в десять тысяч!"

# ch/harems_full/office/events/events.rpy:1008
translate russian office_harem_pimping_audrey_dcfd85d0:
    "Впрочем, сейчас преимущество действительно на её стороне."

# ch/harems_full/office/events/events.rpy:1009
translate russian office_harem_pimping_audrey_0327e25f:
    "Мне остаётся лишь вздохнуть и устало кивнуть."

# ch/harems_full/office/events/events.rpy:1010
translate russian office_harem_pimping_audrey_45932160:
    mike.say "Ладно, Одри."

# ch/harems_full/office/events/events.rpy:1011
translate russian office_harem_pimping_audrey_0459e2ca:
    mike.say "Я понял, к чему ты клонишь."

# ch/harems_full/office/events/events.rpy:1012
translate russian office_harem_pimping_audrey_f4ebfc6d:
    mike.say "Пяти тысяч хватит для мотивации?"

# ch/harems_full/office/events/events.rpy:1013
translate russian office_harem_pimping_audrey_aa2a6d6b:
    "Одри мило улыбается и кивает."

# ch/harems_full/office/events/events.rpy:1015
translate russian office_harem_pimping_audrey_d616f0ae:
    audrey.say "Для начала неплохо, [lssb_common.hero_name()]."

# ch/harems_full/office/events/events.rpy:1016
translate russian office_harem_pimping_audrey_ae27e2d9:
    audrey.say "Ты отдаёшь деньги, а я отдаюсь им!"

# ch/harems_full/office/events/events.rpy:1017
translate russian office_harem_pimping_audrey_e2b205ae:
    mike.say "Хорошо, хорошо..."

# ch/harems_full/office/events/events.rpy:1018
translate russian office_harem_pimping_audrey_11b46f3c:
    mike.say "Договорились."

# ch/harems_full/office/events/events.rpy:1019
translate russian office_harem_pimping_audrey_5863645d:
    "Одри кивает и позволяет мне повести её обратно к переговорной."

# ch/harems_full/office/events/events.rpy:1020
translate russian office_harem_pimping_audrey_c04dbe77:
    "Да, чтобы заключить сделку, пришлось отдать десять процентов."

# ch/harems_full/office/events/events.rpy:1021
translate russian office_harem_pimping_audrey_fdac193f:
    "Но, по-моему, это разумное вложение."

# ch/harems_full/office/events/events.rpy:1022
translate russian office_harem_pimping_audrey_eac3ee6d:
    "Особенно если альтернатива — круглый ноль!"

# ch/harems_full/office/events/events.rpy:1027
translate russian office_harem_pimping_audrey_af26b2cc:
    "Одри непристойно фыркает со смехом и качает головой."

# ch/harems_full/office/events/events.rpy:1029
translate russian office_harem_pimping_audrey_9dbfc84f:
    "Она скрещивает руки на груди, принимая оборонительную позу."

# ch/harems_full/office/events/events.rpy:1030
translate russian office_harem_pimping_audrey_3e048ce4:
    audrey.say "Я рада, что заставила тебя это произнести, но на этом всё."

# ch/harems_full/office/events/events.rpy:1031
translate russian office_harem_pimping_audrey_e4e6f1ba:
    audrey.say "А если думаешь, что я пойду туда трахаться с этими типами..."

# ch/harems_full/office/events/events.rpy:1033
translate russian office_harem_pimping_audrey_e67942fe:
    audrey.say "То ты ещё тупее, чем кажешься!"

# ch/harems_full/office/events/events.rpy:1034
translate russian office_harem_pimping_audrey_1dac62e2:
    "Какого чёрта?!"

# ch/harems_full/office/events/events.rpy:1035
translate russian office_harem_pimping_audrey_faba8d6c:
    "Она заставила меня пройти через всё это, чтобы просто отказать?"

# ch/harems_full/office/events/events.rpy:1036
translate russian office_harem_pimping_audrey_abafa15f:
    mike.say "Одри, пожалуйста!"

# ch/harems_full/office/events/events.rpy:1037
translate russian office_harem_pimping_audrey_1f390e33:
    mike.say "Эта сделка так важна для компании..."

# ch/harems_full/office/events/events.rpy:1039
translate russian office_harem_pimping_audrey_ecde5ff5:
    "Одри обрывает меня на полуслове."

# ch/harems_full/office/events/events.rpy:1040
translate russian office_harem_pimping_audrey_c4c76476:
    "Снова смеётся и качает головой."

# ch/harems_full/office/events/events.rpy:1042
translate russian office_harem_pimping_audrey_71b74b07:
    audrey.say "Да, [lssb_common.hero_name()], для них важна. И для тебя."

# ch/harems_full/office/events/events.rpy:1045
translate russian office_harem_pimping_audrey_d35330d4:
    audrey.say "А мне какое дело?"

# ch/harems_full/office/events/events.rpy:1046
translate russian office_harem_pimping_audrey_a0c42c3d:
    audrey.say "Это ведь не моя премия на кону!"

# ch/harems_full/office/events/events.rpy:1047
translate russian office_harem_pimping_audrey_36465ac1:
    "Она поворачивается ко мне спиной и уходит."

# ch/harems_full/office/events/events.rpy:1048
translate russian office_harem_pimping_audrey_9154e037:
    "И я вижу, как вместе с ней уходят мои шансы получить десять тысяч!"

# ch/harems_full/office/events/events.rpy:1057
translate russian office_harem_pimping_lavish_38b6b62c:
    "Я успеваю отойти от переговорной всего на пару шагов, как начинаю паниковать."

# ch/harems_full/office/events/events.rpy:1058
translate russian office_harem_pimping_lavish_5396551e:
    "Ну, может, не настоящий приступ тревоги — без таких драм."

# ch/harems_full/office/events/events.rpy:1059
translate russian office_harem_pimping_lavish_1663d782:
    "Но моих ощущений вполне хватает, чтобы осознать, в какое положение я сам себя загнал."

# ch/harems_full/office/events/events.rpy:1060
translate russian office_harem_pimping_lavish_c730c2d8:
    "Неужели я настолько хочу эту премию в десять тысяч, что готов на такое?"

# ch/harems_full/office/events/events.rpy:1061
translate russian office_harem_pimping_lavish_8533fae8:
    "Подойти к Лавиш и попросить её отдаться этим типам?"

# ch/harems_full/office/events/events.rpy:1062
translate russian office_harem_pimping_lavish_ec7c355c:
    "Я качаю головой, проходя по офису в поисках девушки."

# ch/harems_full/office/events/events.rpy:1063
translate russian office_harem_pimping_lavish_2a52b2fb:
    "Нет, дело не только в деньгах. Конечно нет."

# ch/harems_full/office/events/events.rpy:1064
translate russian office_harem_pimping_lavish_32f45634:
    "Дело в необходимости заключить сделку."

# ch/harems_full/office/events/events.rpy:1065
translate russian office_harem_pimping_lavish_9c07b1a5:
    "В необходимости быть достаточно безжалостным, чтобы довести её до конца любой ценой."

# ch/harems_full/office/events/events.rpy:1066
translate russian office_harem_pimping_lavish_8edf25cd:
    "Ага, [lssb_common.hero_name()], продолжай себя убеждать."

# ch/harems_full/office/events/events.rpy:1067
translate russian office_harem_pimping_lavish_9ec7acab:
    "Может, ещё и сам поверишь!"

# ch/harems_full/office/events/events.rpy:1069
translate russian office_harem_pimping_lavish_87cdd42e:
    "В этот момент Лавиш выходит из двери и чуть не врезается в меня."

# ch/harems_full/office/events/events.rpy:1070
translate russian office_harem_pimping_lavish_74ed9a4a:
    "Может, всё дело в том, что мне так нужно её найти."

# ch/harems_full/office/events/events.rpy:1071
translate russian office_harem_pimping_lavish_11d241f0:
    "А может, это просто одно из странных совпадений."

# ch/harems_full/office/events/events.rpy:1072
translate russian office_harem_pimping_lavish_28bf2bc8:
    "Так или иначе, я хватаюсь за возможность, пока совесть не взяла верх."

# ch/harems_full/office/events/events.rpy:1074
translate russian office_harem_pimping_lavish_00a29024:
    lavish.say "Ох... [lssb_common.hero_name()]!"

# ch/harems_full/office/events/events.rpy:1075
translate russian office_harem_pimping_lavish_c6da13a0:
    lavish.say "Прости, я не смотрела, куда иду..."

# ch/harems_full/office/events/events.rpy:1076
translate russian office_harem_pimping_lavish_4c8cfe29:
    mike.say "Ничего, Лавиш. Я тоже!"

# ch/harems_full/office/events/events.rpy:1077
translate russian office_harem_pimping_lavish_fdc78f70:
    mike.say "Вообще-то мне нужно было кое о чём с тобой поговорить..."

# ch/harems_full/office/events/events.rpy:1079
translate russian office_harem_pimping_lavish_a373df8f:
    lavish.say "Конечно, [lssb_common.hero_name()]. У меня сейчас ничего срочного."

# ch/harems_full/office/events/events.rpy:1081
translate russian office_harem_pimping_lavish_8b65f7c4:
    lavish.say "Но это не значит, что я бездельничаю!"

# ch/harems_full/office/events/events.rpy:1082
translate russian office_harem_pimping_lavish_069f50f8:
    "Я отмахиваюсь от попытки Лавиш отшутиться."

# ch/harems_full/office/events/events.rpy:1083
translate russian office_harem_pimping_lavish_fe89deb1:
    "Сейчас нельзя отвлекаться на офисную болтовню."

# ch/harems_full/office/events/events.rpy:1084
translate russian office_harem_pimping_lavish_6ab4274d:
    mike.say "Забудь об этом, Лавиш."

# ch/harems_full/office/events/events.rpy:1085
translate russian office_harem_pimping_lavish_717f4513:
    mike.say "Дело серьёзное."

# ch/harems_full/office/events/events.rpy:1086
translate russian office_harem_pimping_lavish_5abffae6:
    mike.say "Но серьёзное немного в другом смысле."

# ch/harems_full/office/events/events.rpy:1088
translate russian office_harem_pimping_lavish_8c6a2ad8:
    "Лавиш кивает, стараясь показать, что готова внимательно выслушать."

# ch/harems_full/office/events/events.rpy:1089
translate russian office_harem_pimping_lavish_aaf190d6:
    "Но по её расширившимся глазам я вижу: она уже опасается худшего."

# ch/harems_full/office/events/events.rpy:1090
translate russian office_harem_pimping_lavish_4f1f360c:
    mike.say "Ты же знаешь, что я пытаюсь заключить эту сделку?"

# ch/harems_full/office/events/events.rpy:1091
translate russian office_harem_pimping_lavish_05b4ddf5:
    mike.say "И что представители Blissard приехали сегодня именно ради этого?"

# ch/harems_full/office/events/events.rpy:1093
translate russian office_harem_pimping_lavish_de5e3abd:
    lavish.say "Конечно, [lssb_common.hero_name()]."

# ch/harems_full/office/events/events.rpy:1094
translate russian office_harem_pimping_lavish_53cbffa2:
    lavish.say "Ты столько над ней работал!"

# ch/harems_full/office/events/events.rpy:1095
translate russian office_harem_pimping_lavish_2d417530:
    mike.say "Ну, мы тут столкнулись с небольшой загвоздкой."

# ch/harems_full/office/events/events.rpy:1097
translate russian office_harem_pimping_lavish_68e65925:
    lavish.say "О нет!"

# ch/harems_full/office/events/events.rpy:1098
translate russian office_harem_pimping_lavish_2f7a2304:
    mike.say "О да!"

# ch/harems_full/office/events/events.rpy:1099
translate russian office_harem_pimping_lavish_fe9cf182:
    mike.say "Они хотят ещё кое-чего, прежде чем поставить подписи."

# ch/harems_full/office/events/events.rpy:1101
translate russian office_harem_pimping_lavish_fc23cbd0:
    "Лавиш смотрит на меня, и её глаза кажутся уже невообразимо огромными."

# ch/harems_full/office/events/events.rpy:1102
translate russian office_harem_pimping_lavish_5ff1c6f1:
    lavish.say "Чего они хотят?"

# ch/harems_full/office/events/events.rpy:1103
translate russian office_harem_pimping_lavish_c06c7c85:
    "Я глубоко вдыхаю и стараюсь собраться."

# ch/harems_full/office/events/events.rpy:1105
translate russian office_harem_pimping_lavish_40f03266:
    mike.say "Они... хотят тебя, Лавиш."

# ch/harems_full/office/events/events.rpy:1106
translate russian office_harem_pimping_lavish_2f8acd55:
    lavish.say "М... меня?"

# ch/harems_full/office/events/events.rpy:1107
translate russian office_harem_pimping_lavish_1c8a1dde:
    lavish.say "Что значит — хотят меня?"

# ch/harems_full/office/events/events.rpy:1108
translate russian office_harem_pimping_lavish_7f3bf06c:
    mike.say "Ну же, Лавиш."

# ch/harems_full/office/events/events.rpy:1109
translate russian office_harem_pimping_lavish_f4f00fa1:
    mike.say "Не прикидывайся невинной."

# ch/harems_full/office/events/events.rpy:1110
translate russian office_harem_pimping_lavish_c8a0c201:
    mike.say "Они увидели тебя по дороге сюда и потеряли голову."

# ch/harems_full/office/events/events.rpy:1113
translate russian office_harem_pimping_lavish_8ca211c3:
    lavish.say "То есть они хотят... хотят заняться со мной СЕКСОМ?!"

# ch/harems_full/office/events/events.rpy:1114
translate russian office_harem_pimping_lavish_01756fc0:
    mike.say "Послушай, Лавиш, я знаю: такого происходить не должно."

# ch/harems_full/office/events/events.rpy:1115
translate russian office_harem_pimping_lavish_faa1115b:
    mike.say "Но это реальный мир, и иногда приходится делать всё необходимое!"

# ch/harems_full/office/events/events.rpy:1117
translate russian office_harem_pimping_lavish_fc5e9a09:
    "Лавиш опускает глаза, будто мои слова сильно её задели."

# ch/harems_full/office/events/events.rpy:1118
translate russian office_harem_pimping_lavish_69de30e8:
    "Кивает, так и не поднимая взгляда."

# ch/harems_full/office/events/events.rpy:1120
translate russian office_harem_pimping_lavish_a02575e5:
    lavish.say "Л... ладно, [lssb_common.hero_name()]."

# ch/harems_full/office/events/events.rpy:1121
translate russian office_harem_pimping_lavish_39dff2c6:
    lavish.say "Если ты так говоришь..."

# ch/harems_full/office/events/events.rpy:1122
translate russian office_harem_pimping_lavish_1f46c0e6:
    "Я думал, стоит только получить согласие Лавиш, и мне полегчает."

# ch/harems_full/office/events/events.rpy:1123
translate russian office_harem_pimping_lavish_685d068e:
    "Но от того, как она сдаётся и становится покорной, я чувствую ещё большую вину."

# ch/harems_full/office/events/events.rpy:1124
translate russian office_harem_pimping_lavish_e5c1a559:
    "И всё же теперь я уже ввязался."

# ch/harems_full/office/events/events.rpy:1125
translate russian office_harem_pimping_lavish_26a47943:
    "Поэтому подавляю чувство вины и продолжаю."

# ch/harems_full/office/events/events.rpy:1126
translate russian office_harem_pimping_lavish_f9fcfd59:
    mike.say "Хорошая девочка, Лавиш."

# ch/harems_full/office/events/events.rpy:1127
translate russian office_harem_pimping_lavish_b8696f42:
    mike.say "Знал, что могу на тебя положиться."

# ch/harems_full/office/events/events.rpy:1128
translate russian office_harem_pimping_lavish_8a811f99:
    "Лавиш снова кивает, позволяя направить её к переговорной."

# ch/harems_full/office/events/events.rpy:1129
translate russian office_harem_pimping_lavish_170401f0:
    "Но по дороге к двери больше не произносит ни слова."

# ch/harems_full/office/events/events.rpy:1130
translate russian office_harem_pimping_lavish_637df132:
    "И я остаюсь один на один с виной за то, что заставляю её это делать..."

# ch/harems_full/office/events/events.rpy:1133
translate russian office_harem_pimping_lavish_b84134b2:
    "Может, нужно просто сделать предложение привлекательнее для Лавиш?"

# ch/harems_full/office/events/events.rpy:1134
translate russian office_harem_pimping_lavish_963a690a:
    "Ведь я только что сказал, что всё ради сделки с Blissard."

# ch/harems_full/office/events/events.rpy:1135
translate russian office_harem_pimping_lavish_68944690:
    "Так почему бы не дать ей практический стимул сделать то, что мне нужно?"

# ch/harems_full/office/events/events.rpy:1136
translate russian office_harem_pimping_lavish_a5fa3e1b:
    mike.say "Ладно, Лавиш, поговорим серьёзно."

# ch/harems_full/office/events/events.rpy:1137
translate russian office_harem_pimping_lavish_36f45d6f:
    mike.say "Ты же хочешь здесь преуспеть?"

# ch/harems_full/office/events/events.rpy:1138
translate russian office_harem_pimping_lavish_1c6dfc71:
    mike.say "Хочешь подняться по карьерной лестнице?"

# ch/harems_full/office/events/events.rpy:1140
translate russian office_harem_pimping_lavish_2d2e0df1:
    "Лавиш медленно кивает, ожидая, к чему я клоню."

# ch/harems_full/office/events/events.rpy:1141
translate russian office_harem_pimping_lavish_b13ca429:
    mike.say "Для этого полезно, чтобы люди были у тебя в долгу."

# ch/harems_full/office/events/events.rpy:1142
translate russian office_harem_pimping_lavish_b3832ed6:
    mike.say "Чтобы кто-то наверху был обязан тебе услугой."

# ch/harems_full/office/events/events.rpy:1143
translate russian office_harem_pimping_lavish_9e9bf199:
    "Лавиш снова кивает, и, кажется, на её лице появляется понимание."

# ch/harems_full/office/events/events.rpy:1145
translate russian office_harem_pimping_lavish_404a8551:
    lavish.say "Если я это сделаю, ты..."

# ch/harems_full/office/events/events.rpy:1146
translate russian office_harem_pimping_lavish_655f23e2:
    lavish.say "Ты что-нибудь сделаешь для меня?"

# ch/harems_full/office/events/events.rpy:1147
translate russian office_harem_pimping_lavish_02ff4b6f:
    mike.say "Именно, Лавиш."

# ch/harems_full/office/events/events.rpy:1148
translate russian office_harem_pimping_lavish_928411a5:
    mike.say "Когда в следующий раз попросишь прибавку или повышение..."

# ch/harems_full/office/events/events.rpy:1149
translate russian office_harem_pimping_lavish_5d7ee9b3:
    mike.say "Я горы сверну, чтобы ты его получила. Хорошо?"

# ch/harems_full/office/events/events.rpy:1151
translate russian office_harem_pimping_lavish_d67f9e35:
    "Лавиш смотрит мне прямо в глаза, словно пытается заглянуть в душу."

# ch/harems_full/office/events/events.rpy:1152
translate russian office_harem_pimping_lavish_4bcde0bf:
    "Мне становится весьма не по себе, но я стараюсь выдержать её взгляд."

# ch/harems_full/office/events/events.rpy:1153
translate russian office_harem_pimping_lavish_788d27ff:
    "Некоторое время я уверен: сейчас она откроет рот и откажет."

# ch/harems_full/office/events/events.rpy:1155
translate russian office_harem_pimping_lavish_6c31ef76:
    lavish.say "Ах..."

# ch/harems_full/office/events/events.rpy:1156
translate russian office_harem_pimping_lavish_5e9a3e0c:
    lavish.say "Ладно, [lssb_common.hero_name()], ладно."

# ch/harems_full/office/events/events.rpy:1157
translate russian office_harem_pimping_lavish_c0c937d6:
    lavish.say "Но это останется между нами."

# ch/harems_full/office/events/events.rpy:1158
translate russian office_harem_pimping_lavish_6d0b85c0:
    lavish.say "Ну... между нами и теми типами из Blissard, да?"

# ch/harems_full/office/events/events.rpy:1159
translate russian office_harem_pimping_lavish_12451227:
    "Услышав согласие Лавиш, я невольно вздыхаю с облегчением."

# ch/harems_full/office/events/events.rpy:1160
translate russian office_harem_pimping_lavish_c1c34c12:
    "И согласно киваю, желая поскорее закрепить договорённость."

# ch/harems_full/office/events/events.rpy:1161
translate russian office_harem_pimping_lavish_54b27520:
    mike.say "Даю слово, Лавиш."

# ch/harems_full/office/events/events.rpy:1162
translate russian office_harem_pimping_lavish_2685e57c:
    mike.say "Никто больше никогда об этом не узнает."

# ch/harems_full/office/events/events.rpy:1163
translate russian office_harem_pimping_lavish_226bbb2b:
    "Лавиш кивает, всё ещё явно нервничая."

# ch/harems_full/office/events/events.rpy:1164
translate russian office_harem_pimping_lavish_f3979142:
    "Она позволяет направить её к переговорной."

# ch/harems_full/office/events/events.rpy:1165
translate russian office_harem_pimping_lavish_170401f0_1:
    "Но по дороге к двери больше не произносит ни слова."

# ch/harems_full/office/events/events.rpy:1166
translate russian office_harem_pimping_lavish_637df132_1:
    "И я остаюсь один на один с виной за то, что заставляю её это делать..."

# ch/harems_full/office/events/events.rpy:1171
translate russian office_harem_pimping_lavish_2149a162:
    "Вдруг Лавиш словно сбрасывает первоначальный шок от моего предложения."

# ch/harems_full/office/events/events.rpy:1172
translate russian office_harem_pimping_lavish_6671eb6a:
    "За считаные секунды испуг сменяется вызывающим взглядом."

# ch/harems_full/office/events/events.rpy:1173
translate russian office_harem_pimping_lavish_1135b340:
    "А когда она качает головой и уверенно выпрямляется, мне всё становится ясно."

# ch/harems_full/office/events/events.rpy:1174
translate russian office_harem_pimping_lavish_bd584759:
    "Она не даст себя трахнуть — значит, поимели меня самого!"

# ch/harems_full/office/events/events.rpy:1176
translate russian office_harem_pimping_lavish_5ee60a1e:
    lavish.say "Нет, [lssb_common.hero_name()], мы не обязаны делать такие вещи."

# ch/harems_full/office/events/events.rpy:1177
translate russian office_harem_pimping_lavish_16ff80d7:
    lavish.say "И я не позволю так обращаться с собой на работе!"

# ch/harems_full/office/events/events.rpy:1178
translate russian office_harem_pimping_lavish_762b0262:
    mike.say "Погоди, Лавиш, ну же..."

# ch/harems_full/office/events/events.rpy:1180
translate russian office_harem_pimping_lavish_102770e5:
    lavish.say "Нет, даже не думай!"

# ch/harems_full/office/events/events.rpy:1181
translate russian office_harem_pimping_lavish_dfe6a212:
    lavish.say "Сейчас мы оба забудем, что этот разговор вообще состоялся."

# ch/harems_full/office/events/events.rpy:1182
translate russian office_harem_pimping_lavish_b8f41304:
    lavish.say "Иначе, уверена, отделу кадров будет очень интересно об этом узнать!"

# ch/harems_full/office/events/events.rpy:1184
translate russian office_harem_pimping_lavish_e1d3016b:
    "С этими словами Лавиш поворачивается ко мне спиной и стремительно уходит."

# ch/harems_full/office/events/events.rpy:1185
translate russian office_harem_pimping_lavish_43065881:
    "Я смотрю ей вслед: с ней исчезают все надежды на премию в десять тысяч."

# ch/harems_full/office/events/events.rpy:1194
translate russian office_harem_pimping_shiori_b64edb12:
    "Лишь закрыв за собой дверь и поспешив на поиски Сиори, я начинаю по-настоящему задумываться."

# ch/harems_full/office/events/events.rpy:1195
translate russian office_harem_pimping_shiori_425189bd:
    "Я действительно собираюсь подойти к своей подчинённой и попросить её отдаться этим типам?"

# ch/harems_full/office/events/events.rpy:1196
translate russian office_harem_pimping_shiori_6e676d07:
    "Но даже с этой мыслью я не останавливаюсь и не иду обратно, чтобы послать их."

# ch/harems_full/office/events/events.rpy:1197
translate russian office_harem_pimping_shiori_55009e6e:
    "Значит, ответ — да. Я всё-таки собираюсь это сделать!"

# ch/harems_full/office/events/events.rpy:1199
translate russian office_harem_pimping_shiori_51cab284:
    "Нахожу Сиори за её столом: она листает журнал."

# ch/harems_full/office/events/events.rpy:1200
translate russian office_harem_pimping_shiori_c1470a74:
    "Моего приближения она не замечает, поэтому я тихо кашляю, привлекая внимание."

# ch/harems_full/office/events/events.rpy:1201
translate russian office_harem_pimping_shiori_1f588598:
    mike.say "Кхм..."

# ch/harems_full/office/events/events.rpy:1204
translate russian office_harem_pimping_shiori_a8975de0:
    "Услышав кашель, Сиори буквально подскакивает на месте."

# ch/harems_full/office/events/events.rpy:1205
translate russian office_harem_pimping_shiori_8a30c342:
    "Она ещё и испуганно вскрикивает, уже пытаясь спрятать журнал."

# ch/harems_full/office/events/events.rpy:1207
translate russian office_harem_pimping_shiori_7fca205e:
    shiori.say "Ой... боже!"

# ch/harems_full/office/events/events.rpy:1208
translate russian office_harem_pimping_shiori_c0bda8f6:
    shiori.say "[lssb_common.hero_name()], это не то, чем кажется!"

# ch/harems_full/office/events/events.rpy:1209
translate russian office_harem_pimping_shiori_6f6b1b02:
    "Я тут же жестом отметаю её очевидную тревогу."

# ch/harems_full/office/events/events.rpy:1210
translate russian office_harem_pimping_shiori_7be632a1:
    "Конечно, мог бы попытаться шантажировать её тем, что застал за бездельем."

# ch/harems_full/office/events/events.rpy:1211
translate russian office_harem_pimping_shiori_45ad7b57:
    "Но для того, чтобы уговорить на задуманное, такой способ кажется мелочным."

# ch/harems_full/office/events/events.rpy:1212
translate russian office_harem_pimping_shiori_0f7e61fc:
    mike.say "Не волнуйся, Сиори."

# ch/harems_full/office/events/events.rpy:1213
translate russian office_harem_pimping_shiori_728d8469:
    mike.say "Ты столько работаешь, что заслужила перерыв."

# ch/harems_full/office/events/events.rpy:1215
translate russian office_harem_pimping_shiori_1cbe5c01:
    shiori.say "Я... заслужила?"

# ch/harems_full/office/events/events.rpy:1216
translate russian office_harem_pimping_shiori_2fe5e598:
    mike.say "Конечно, Сиори."

# ch/harems_full/office/events/events.rpy:1217
translate russian office_harem_pimping_shiori_002d97d2:
    mike.say "Ты одна из немногих здесь, на кого я всегда могу положиться."

# ch/harems_full/office/events/events.rpy:1219
translate russian office_harem_pimping_shiori_66206fcd:
    "Мне немного стыдно так подлизываться к Сиори."

# ch/harems_full/office/events/events.rpy:1220
translate russian office_harem_pimping_shiori_c3432e77:
    "Но я знаю, что она достаточно нуждается в одобрении, чтобы поддаться такой лести."

# ch/harems_full/office/events/events.rpy:1221
translate russian office_harem_pimping_shiori_521bd9c3:
    mike.say "Я знаю, что могу обратиться к тебе, когда мне действительно нужна помощь."

# ch/harems_full/office/events/events.rpy:1222
translate russian office_harem_pimping_shiori_a187e1a9:
    mike.say "Правда, Сиори?"

# ch/harems_full/office/events/events.rpy:1223
translate russian office_harem_pimping_shiori_6a0d1e45:
    "Это лишь крошечный намёк на возможность заслужить моё расположение."

# ch/harems_full/office/events/events.rpy:1224
translate russian office_harem_pimping_shiori_ae629e23:
    "Но Сиори тут же выпрямляется и внимательно смотрит на меня, словно нетерпеливый щенок."

# ch/harems_full/office/events/events.rpy:1226
translate russian office_harem_pimping_shiori_93c1d077:
    shiori.say "Т... тебе нужно, чтобы я что-то сделала, [lssb_common.hero_name()]?"

# ch/harems_full/office/events/events.rpy:1228
translate russian office_harem_pimping_shiori_e7f972d6:
    shiori.say "Только скажи, и я сразу всё сделаю!"

# ch/harems_full/office/events/events.rpy:1229
translate russian office_harem_pimping_shiori_4719585a:
    "Часть меня уже чувствует вину от того, как легко всё получается."

# ch/harems_full/office/events/events.rpy:1230
translate russian office_harem_pimping_shiori_4fb80b69:
    "Но я подавляю её, стараясь заглушить мыслями о желанной премии в десять тысяч."

# ch/harems_full/office/events/events.rpy:1231
translate russian office_harem_pimping_shiori_63b8b0b9:
    mike.say "Сиори, ты же знаешь, что я пытаюсь заключить сделку с Blissard?"

# ch/harems_full/office/events/events.rpy:1233
translate russian office_harem_pimping_shiori_2b3d848f:
    shiori.say "О да, конечно! Ты в последнее время столько работаешь!"

# ch/harems_full/office/events/events.rpy:1234
translate russian office_harem_pimping_shiori_5972f0ea:
    mike.say "Так вот, мы уже собираемся подписывать контракты."

# ch/harems_full/office/events/events.rpy:1235
translate russian office_harem_pimping_shiori_527fba12:
    "Сиори охотно кивает."

# ch/harems_full/office/events/events.rpy:1236
translate russian office_harem_pimping_shiori_8eebb218:
    mike.say "Но есть небольшая проблема."

# ch/harems_full/office/events/events.rpy:1237
translate russian office_harem_pimping_shiori_02245f60:
    mike.say "Которую нужно решить до подписания."

# ch/harems_full/office/events/events.rpy:1239
translate russian office_harem_pimping_shiori_72ce659f:
    shiori.say "О нет, какая ужасная новость!"

# ch/harems_full/office/events/events.rpy:1240
translate russian office_harem_pimping_shiori_a0f61aed:
    mike.say "Понимаешь, Сиори, все очень устали."

# ch/harems_full/office/events/events.rpy:1241
translate russian office_harem_pimping_shiori_3f1d923f:
    mike.say "Переговоры нас совершенно вымотали."

# ch/harems_full/office/events/events.rpy:1242
translate russian office_harem_pimping_shiori_4c188104:
    mike.say "Поэтому мне нужно, чтобы ты немного... взбодрила парней из Blissard."

# ch/harems_full/office/events/events.rpy:1243
translate russian office_harem_pimping_shiori_df6e9f9d:
    "Сиори склоняет голову набок."

# ch/harems_full/office/events/events.rpy:1245
translate russian office_harem_pimping_shiori_f2ae7684:
    shiori.say "Но, [lssb_common.hero_name()], ради такой просьбы не нужно было сюда приходить!"

# ch/harems_full/office/events/events.rpy:1246
translate russian office_harem_pimping_shiori_96556f54:
    shiori.say "Мог бы просто позвонить или написать."

# ch/harems_full/office/events/events.rpy:1247
translate russian office_harem_pimping_shiori_70d9ca23:
    "Я качаю головой, всё ещё стараясь выглядеть сдержанным и рассудительным."

# ch/harems_full/office/events/events.rpy:1248
translate russian office_harem_pimping_shiori_63acf053:
    "Ну, а не типом, который собирается подложить свою сотрудницу под кого-то ради собственной выгоды."

# ch/harems_full/office/events/events.rpy:1249
translate russian office_harem_pimping_shiori_2c92181d:
    mike.say "Я не о таком способе взбодриться, Сиори."

# ch/harems_full/office/events/events.rpy:1250
translate russian office_harem_pimping_shiori_3e3b55bf:
    mike.say "А о том, при котором все раздеваются."

# ch/harems_full/office/events/events.rpy:1252
translate russian office_harem_pimping_shiori_1dbb4270:
    "Глаза Сиори расширяются, и она ещё больше напоминает невинного щенка."

# ch/harems_full/office/events/events.rpy:1254
translate russian office_harem_pimping_shiori_d5e716da:
    shiori.say "Ох... я... понятно."

# ch/harems_full/office/events/events.rpy:1255
translate russian office_harem_pimping_shiori_9ea8ef5e:
    shiori.say "Ты хочешь, чтобы я занялась сексом с этими мужчинами, [lssb_common.hero_name()]?"

# ch/harems_full/office/events/events.rpy:1256
translate russian office_harem_pimping_shiori_4851944f:
    mike.say "Эм... ну... да, Сиори."

# ch/harems_full/office/events/events.rpy:1257
translate russian office_harem_pimping_shiori_da36fd34:
    mike.say "Если так это сформулировать..."

# ch/harems_full/office/events/events.rpy:1258
translate russian office_harem_pimping_shiori_25a3f843:
    "Сиори прикусывает губу и смотрит на меня снизу вверх, заламывая руки."

# ch/harems_full/office/events/events.rpy:1260
translate russian office_harem_pimping_shiori_bede07df:
    "Она глядит на меня своими щенячьими глазами."

# ch/harems_full/office/events/events.rpy:1261
translate russian office_harem_pimping_shiori_ea62ceb1:
    "Не знай я её лучше, решил бы, что она вот-вот расплачется."

# ch/harems_full/office/events/events.rpy:1262
translate russian office_harem_pimping_shiori_5d7f7c63:
    "Но за время её работы здесь я успел хорошо её узнать."

# ch/harems_full/office/events/events.rpy:1263
translate russian office_harem_pimping_shiori_c83e3b31:
    "И прекрасно знаю одно: Сиори возбуждает, когда ей говорят, что делать."

# ch/harems_full/office/events/events.rpy:1264
translate russian office_harem_pimping_shiori_556121e5:
    mike.say "Ладно, Сиори, ладно."

# ch/harems_full/office/events/events.rpy:1265
translate russian office_harem_pimping_shiori_ae03f179:
    mike.say "Тебе будет проще, если я прикажу?"

# ch/harems_full/office/events/events.rpy:1266
translate russian office_harem_pimping_shiori_291d8bb5:
    "При одном этом слове по телу Сиори словно пробегает трепет."

# ch/harems_full/office/events/events.rpy:1267
translate russian office_harem_pimping_shiori_0e48c340:
    "Она выпрямляется на стуле и смотрит на меня ещё внимательнее."

# ch/harems_full/office/events/events.rpy:1269
translate russian office_harem_pimping_shiori_3c1f9b86:
    shiori.say "Ох, н... но, [lssb_common.hero_name()]..."

# ch/harems_full/office/events/events.rpy:1270
translate russian office_harem_pimping_shiori_8bcf5342:
    shiori.say "Ты ведь... не станешь?"

# ch/harems_full/office/events/events.rpy:1271
translate russian office_harem_pimping_shiori_93675c1a:
    shiori.say "Ты мой начальник, я же буду обязана подчиниться!"

# ch/harems_full/office/events/events.rpy:1272
translate russian office_harem_pimping_shiori_46d6e126:
    "Ага, теперь дело сдвинулось."

# ch/harems_full/office/events/events.rpy:1273
translate russian office_harem_pimping_shiori_933f3278:
    "Сиори играет невинную маленькую офисную сотрудницу."

# ch/harems_full/office/events/events.rpy:1274
translate russian office_harem_pimping_shiori_20f788be:
    "А значит, мне достаётся роль властного начальника, не оставляющего ей выбора!"

# ch/harems_full/office/events/events.rpy:1275
translate russian office_harem_pimping_shiori_38dfce95:
    mike.say "Я не хотел прибегать к этому, Сиори."

# ch/harems_full/office/events/events.rpy:1276
translate russian office_harem_pimping_shiori_d921662e:
    mike.say "Но ты не оставила мне выбора."

# ch/harems_full/office/events/events.rpy:1277
translate russian office_harem_pimping_shiori_36428341:
    mike.say "Тащи свою задницу в переговорную и трахни этих парней!"

# ch/harems_full/office/events/events.rpy:1279
translate russian office_harem_pimping_shiori_8ca029e4:
    "Сиори медленно встаёт, избегая моего взгляда."

# ch/harems_full/office/events/events.rpy:1280
translate russian office_harem_pimping_shiori_ca96047d:
    "Кивает и чуть ли не кланяется, поспешив впереди меня к переговорной."

# ch/harems_full/office/events/events.rpy:1281
translate russian office_harem_pimping_shiori_c23e3eba:
    "Я иду следом, проверяя, не подслушал ли кто наш разговор."

# ch/harems_full/office/events/events.rpy:1282
translate russian office_harem_pimping_shiori_e9124031:
    "И всё время убеждаю себя, что непременно заглажу перед ней вину."

# ch/harems_full/office/events/events.rpy:1283
translate russian office_harem_pimping_shiori_29bd76aa:
    "Хотя, несмотря на её протесты, часть меня гадает: не получает ли Сиори тайное удовольствие..."

# ch/harems_full/office/events/events.rpy:1286
translate russian office_harem_pimping_shiori_0d49e129:
    "Ах, чёрт. Я об этом пожалею, точно знаю."

# ch/harems_full/office/events/events.rpy:1287
translate russian office_harem_pimping_shiori_3ffa9ef2:
    "Но какой у меня сейчас выбор?"

# ch/harems_full/office/events/events.rpy:1288
translate russian office_harem_pimping_shiori_7ce476cc:
    "Нужно ударить Сиори по самому больному, по её уязвимому месту."

# ch/harems_full/office/events/events.rpy:1289
translate russian office_harem_pimping_shiori_339d818a:
    "Надеюсь, когда всё закончится, я ещё смогу смотреть на себя в зеркало!"

# ch/harems_full/office/events/events.rpy:1290
translate russian office_harem_pimping_shiori_b6d19d90:
    mike.say "Эм... я не хотел до этого доводить, Сиори."

# ch/harems_full/office/events/events.rpy:1291
translate russian office_harem_pimping_shiori_b17f15b9:
    mike.say "Но если откажешься, ты уволена."

# ch/harems_full/office/events/events.rpy:1294
translate russian office_harem_pimping_shiori_e87b2e48:
    "Сиори чуть ли не оседает передо мной жалким комочком."

# ch/harems_full/office/events/events.rpy:1295
translate russian office_harem_pimping_shiori_4bcb8b2c:
    "Она хватает меня за руки и начинает отчаянно умолять."

# ch/harems_full/office/events/events.rpy:1297
translate russian office_harem_pimping_shiori_71b96945:
    shiori.say "Ох, [lssb_common.hero_name()], пожалуйста!"

# ch/harems_full/office/events/events.rpy:1298
translate russian office_harem_pimping_shiori_a4b82690:
    shiori.say "Ты... ты ведь не можешь уволить меня за такое? Правда?!"

# ch/harems_full/office/events/events.rpy:1299
translate russian office_harem_pimping_shiori_8af67e86:
    mike.say "Нет, Сиори."

# ch/harems_full/office/events/events.rpy:1300
translate russian office_harem_pimping_shiori_c1e569c7:
    mike.say "Но легко могу уволить за все остальные косяки."

# ch/harems_full/office/events/events.rpy:1301
translate russian office_harem_pimping_shiori_a349eccf:
    mike.say "За всё то, на что я закрывал глаза, потому что хорошо к тебе относился."

# ch/harems_full/office/events/events.rpy:1302
translate russian office_harem_pimping_shiori_735f43df:
    mike.say "За все случаи, когда ты лажала, витая в облаках."

# ch/harems_full/office/events/events.rpy:1303
translate russian office_harem_pimping_shiori_65cea9b3:
    "Сиори нервно сглатывает и опускает взгляд в пол."

# ch/harems_full/office/events/events.rpy:1304
translate russian office_harem_pimping_shiori_9e596b8c:
    "Когда она медленно и печально кивает, я понимаю: сработало."

# ch/harems_full/office/events/events.rpy:1306
translate russian office_harem_pimping_shiori_21c693b3:
    shiori.say "Д... да, [lssb_common.hero_name()]."

# ch/harems_full/office/events/events.rpy:1307
translate russian office_harem_pimping_shiori_65dfdc26:
    shiori.say "Я понимаю..."

# ch/harems_full/office/events/events.rpy:1309
translate russian office_harem_pimping_shiori_d29910fa:
    "Не поднимая головы, Сиори покорно идёт к переговорной."

# ch/harems_full/office/events/events.rpy:1310
translate russian office_harem_pimping_shiori_ce11fab9:
    "А я следую за ней, уже чувствуя, как внутри нарастает вина..."

# ch/harems_full/office/events/events.rpy:1314
translate russian office_harem_pimping_shiori_ae85823d:
    "Глаза Сиори словно становятся ещё шире и наполняются слезами."

# ch/harems_full/office/events/events.rpy:1315
translate russian office_harem_pimping_shiori_ca327479:
    "Вдруг она разражается рыданиями, перекрывающими все звуки в офисе."

# ch/harems_full/office/events/events.rpy:1319
translate russian office_harem_pimping_shiori_75f2e64e:
    "Я ещё не успеваю начать её успокаивать, а она уже встаёт и пятится от меня."

# ch/harems_full/office/events/events.rpy:1321
translate russian office_harem_pimping_shiori_b622caa4:
    shiori.say "Я... мне очень жаль, [lssb_common.hero_name()]."

# ch/harems_full/office/events/events.rpy:1322
translate russian office_harem_pimping_shiori_0b5cccdc:
    shiori.say "Но я не могу... просто не могу!"

# ch/harems_full/office/events/events.rpy:1324
translate russian office_harem_pimping_shiori_3a238d22:
    "С этими словами Сиори разворачивается и буквально выбегает из офиса."

# ch/harems_full/office/events/events.rpy:1325
translate russian office_harem_pimping_shiori_dbc3fb8f:
    "Лишь теперь я оглядываюсь по сторонам."

# ch/harems_full/office/events/events.rpy:1326
translate russian office_harem_pimping_shiori_66ab8fc8:
    "И вижу, что все бросили свои дела и уставились на меня."

# ch/harems_full/office/events/events.rpy:1327
translate russian office_harem_pimping_shiori_70965667:
    "Под тяжестью этих взглядов я начинаю возвращаться к переговорной."

# ch/harems_full/office/events/events.rpy:1328
translate russian office_harem_pimping_shiori_cbefe8cc:
    "Может, за время этой короткой прогулки успею придумать достойное оправдание."

# ch/harems_full/office/events/events.rpy:1329
translate russian office_harem_pimping_shiori_62b699cd:
    "Но что бы я ни придумал, вряд ли это будет больнее потери премии в десять тысяч..."

# ch/harems_full/office/events/events.rpy:1338
translate russian office_harem_pimping_audrey_lavish_shiori_9fe96ca8:
    "Пока я обсуждал идею с Томом, Диком и Гарри, всё казалось таким простым."

# ch/harems_full/office/events/events.rpy:1339
translate russian office_harem_pimping_audrey_lavish_shiori_c46266ef:
    "Но едва я выхожу из комнаты, до меня впервые в полной мере доходит, что происходит."

# ch/harems_full/office/events/events.rpy:1340
translate russian office_harem_pimping_audrey_lavish_shiori_3506bc46:
    "Я только что согласился уговорить не одну, а сразу трёх своих сотрудниц переспать с тремя совершенно незнакомыми мужчинами!"

# ch/harems_full/office/events/events.rpy:1341
translate russian office_harem_pimping_audrey_lavish_shiori_c4877331:
    "Я качаю головой и решаю, что сейчас не время задумываться о тонкостях."

# ch/harems_full/office/events/events.rpy:1342
translate russian office_harem_pimping_audrey_lavish_shiori_e35a86fb:
    "Остаётся сосредоточиться на задаче и помнить, ради чего я вообще согласился."

# ch/harems_full/office/events/events.rpy:1343
translate russian office_harem_pimping_audrey_lavish_shiori_f39deea2:
    "Надеюсь, эти десять тысяч действительно будут того стоить, когда окажутся на счёте!"

# ch/harems_full/office/events/events.rpy:1347
translate russian office_harem_pimping_audrey_lavish_shiori_f31e90ee:
    "К счастью, я нахожу Одри, Лавиш и Сиори за разговором у кулера."

# ch/harems_full/office/events/events.rpy:1348
translate russian office_harem_pimping_audrey_lavish_shiori_997227e6:
    mike.say "Эм... привет, девушки!"

# ch/harems_full/office/events/events.rpy:1349
translate russian office_harem_pimping_audrey_lavish_shiori_7668dc3d:
    mike.say "Как у вас дела?"

# ch/harems_full/office/events/events.rpy:1351
translate russian office_harem_pimping_audrey_lavish_shiori_d54abfc9:
    "При звуке моего голоса Сиори буквально сияет и мило улыбается мне."

# ch/harems_full/office/events/events.rpy:1353
translate russian office_harem_pimping_audrey_lavish_shiori_c6e5fd9c:
    "Лавиш тоже явно рада меня видеть, хотя и не ластится так, как Сиори."

# ch/harems_full/office/events/events.rpy:1355
translate russian office_harem_pimping_audrey_lavish_shiori_317f4e3c:
    "А вот Одри смотрит искоса, с нескрываемым подозрением."

# ch/harems_full/office/events/events.rpy:1356
translate russian office_harem_pimping_audrey_lavish_shiori_26bad385:
    shiori.say "О, доброе утро, [lssb_common.hero_name()]."

# ch/harems_full/office/events/events.rpy:1358
translate russian office_harem_pimping_audrey_lavish_shiori_3db4c8bc:
    lavish.say "Мы просто болтали, пока пили воду. Только и всего."

# ch/harems_full/office/events/events.rpy:1359
translate russian office_harem_pimping_audrey_lavish_shiori_bc364449:
    lavish.say "Через пару минут вернёмся к работе, хорошо?"

# ch/harems_full/office/events/events.rpy:1360
translate russian office_harem_pimping_audrey_lavish_shiori_acdf494b:
    audrey.say "Погоди, [lssb_common.hero_name()]."

# ch/harems_full/office/events/events.rpy:1362
translate russian office_harem_pimping_audrey_lavish_shiori_16997701:
    audrey.say "Чего ты на самом деле хочешь, а?"

# ch/harems_full/office/events/events.rpy:1365
translate russian office_harem_pimping_audrey_lavish_shiori_46d97f2b:
    "Лавиш и Сиори удивлённо смотрят на Одри, услышав её вопрос."

# ch/harems_full/office/events/events.rpy:1366
translate russian office_harem_pimping_audrey_lavish_shiori_1b550012:
    mike.say "Я... не понимаю, о чём ты, Одри!"

# ch/harems_full/office/events/events.rpy:1367
translate russian office_harem_pimping_audrey_lavish_shiori_69891dbc:
    mike.say "Просто проходил мимо и решил поздороваться."

# ch/harems_full/office/events/events.rpy:1370
translate russian office_harem_pimping_audrey_lavish_shiori_c95cf75d:
    audrey.say "Врёшь!"

# ch/harems_full/office/events/events.rpy:1371
translate russian office_harem_pimping_audrey_lavish_shiori_3e45dcd8:
    audrey.say "Ты нас всех загонял до смерти ради своей грандиозной сделки."

# ch/harems_full/office/events/events.rpy:1372
translate russian office_harem_pimping_audrey_lavish_shiori_83073c0a:
    audrey.say "А сегодня заключительная встреча, так что ты должен обливаться холодным потом."

# ch/harems_full/office/events/events.rpy:1373
translate russian office_harem_pimping_audrey_lavish_shiori_42cd19c1:
    audrey.say "Вместо этого стоишь здесь и мило беседуешь с простыми смертными!"

# ch/harems_full/office/events/events.rpy:1374
translate russian office_harem_pimping_audrey_lavish_shiori_dce94250:
    "Я оглядываюсь, опасаясь, что кто-то подслушивает."

# ch/harems_full/office/events/events.rpy:1375
translate russian office_harem_pimping_audrey_lavish_shiori_37f9c71a:
    "Одри меня раскусила, так что нужно поскорее с этим закончить."

# ch/harems_full/office/events/events.rpy:1376
translate russian office_harem_pimping_audrey_lavish_shiori_7d1c9e03:
    mike.say "Ладно, ладно, поймала."

# ch/harems_full/office/events/events.rpy:1377
translate russian office_harem_pimping_audrey_lavish_shiori_54d946d6:
    mike.say "Они уже готовы подписать, но есть загвоздка."

# ch/harems_full/office/events/events.rpy:1381
translate russian office_harem_pimping_audrey_lavish_shiori_80d08df7:
    "Все три девушки смотрят на меня, приподняв брови."

# ch/harems_full/office/events/events.rpy:1382
translate russian office_harem_pimping_audrey_lavish_shiori_0b768f7b:
    "Очевидно, гадают, при чём здесь они."

# ch/harems_full/office/events/events.rpy:1383
translate russian office_harem_pimping_audrey_lavish_shiori_8cfa6130:
    mike.say "Когда представители Blissard пришли, они увидели вас троих."

# ch/harems_full/office/events/events.rpy:1384
translate russian office_harem_pimping_audrey_lavish_shiori_7fb6f373:
    mike.say "И так впечатлились, что хотят, чтобы вы их... развлекли."

# ch/harems_full/office/events/events.rpy:1386
translate russian office_harem_pimping_audrey_lavish_shiori_08f9b5f4:
    audrey.say "Ты же ШУТИШЬ!"

# ch/harems_full/office/events/events.rpy:1388
translate russian office_harem_pimping_audrey_lavish_shiori_26944e04:
    lavish.say "О нет..."

# ch/harems_full/office/events/events.rpy:1390
translate russian office_harem_pimping_audrey_lavish_shiori_9be64bff:
    shiori.say "А что в этом плохого?"

# ch/harems_full/office/events/events.rpy:1391
translate russian office_harem_pimping_audrey_lavish_shiori_0a064e80:
    shiori.say "Нам нужно спеть им песенку или что-то вроде?"

# ch/harems_full/office/events/events.rpy:1392
translate russian office_harem_pimping_audrey_lavish_shiori_151c8401:
    "Лавиш наклоняется и шепчет Сиори на ухо."

# ch/harems_full/office/events/events.rpy:1393
translate russian office_harem_pimping_audrey_lavish_shiori_0adbb0f7:
    "И выражение лица той резко меняется."

# ch/harems_full/office/events/events.rpy:1395
translate russian office_harem_pimping_audrey_lavish_shiori_8a2dc46c:
    shiori.say "Ох... боже!"

# ch/harems_full/office/events/events.rpy:1406
translate russian office_harem_pimping_audrey_lavish_shiori_33487cc5:
    "Вижу, как все трое нервно переглядываются."

# ch/harems_full/office/events/events.rpy:1407
translate russian office_harem_pimping_audrey_lavish_shiori_f19eaed6:
    "Одри быстро докопалась до моего истинного мотива."

# ch/harems_full/office/events/events.rpy:1408
translate russian office_harem_pimping_audrey_lavish_shiori_06f1221b:
    "Но я замечаю, что ни одна пока прямо не отказала."

# ch/harems_full/office/events/events.rpy:1409
translate russian office_harem_pimping_audrey_lavish_shiori_8517c4d7:
    "Может, если вовремя вмешаться и подтолкнуть их в нужную сторону..."

# ch/harems_full/office/events/events.rpy:1410
translate russian office_harem_pimping_audrey_lavish_shiori_7edb06f8:
    mike.say "Знаете, по должности я всё-таки выше вас."

# ch/harems_full/office/events/events.rpy:1411
translate russian office_harem_pimping_audrey_lavish_shiori_8bc3c6ac:
    mike.say "Так что мог бы просто приказать..."

# ch/harems_full/office/events/events.rpy:1414
translate russian office_harem_pimping_audrey_lavish_shiori_e9bbe887:
    shiori.say "О нет!"

# ch/harems_full/office/events/events.rpy:1417
translate russian office_harem_pimping_audrey_lavish_shiori_9e8c78f5:
    lavish.say "Ты... ты не станешь!"

# ch/harems_full/office/events/events.rpy:1420
translate russian office_harem_pimping_audrey_lavish_shiori_0925f56d:
    audrey.say "Что?!"

# ch/harems_full/office/events/events.rpy:1421
translate russian office_harem_pimping_audrey_lavish_shiori_268fd343:
    audrey.say "Ты не можешь так поступить!"

# ch/harems_full/office/events/events.rpy:1422
translate russian office_harem_pimping_audrey_lavish_shiori_237a653a:
    mike.say "Но вы бы сделали это не только ради меня."

# ch/harems_full/office/events/events.rpy:1423
translate russian office_harem_pimping_audrey_lavish_shiori_27bfb9da:
    mike.say "А ещё и ради компании."

# ch/harems_full/office/events/events.rpy:1424
translate russian office_harem_pimping_audrey_lavish_shiori_33954f4f:
    mike.say "Такие вещи многое значат."

# ch/harems_full/office/events/events.rpy:1425
translate russian office_harem_pimping_audrey_lavish_shiori_177bee02:
    mike.say "Руководство их запоминает."

# ch/harems_full/office/events/events.rpy:1426
translate russian office_harem_pimping_audrey_lavish_shiori_73548680:
    mike.say "Когда речь заходит о привилегиях и повышениях..."

# ch/harems_full/office/events/events.rpy:1427
translate russian office_harem_pimping_audrey_lavish_shiori_744cc57c:
    "Сиори, наверное, сделала бы это по одному моему приказу."

# ch/harems_full/office/events/events.rpy:1428
translate russian office_harem_pimping_audrey_lavish_shiori_d087dae5:
    "Поэтому о её согласии можно не беспокоиться."

# ch/harems_full/office/events/events.rpy:1429
translate russian office_harem_pimping_audrey_lavish_shiori_aa400f8e:
    "Лавиш командовать не так просто."

# ch/harems_full/office/events/events.rpy:1430
translate russian office_harem_pimping_audrey_lavish_shiori_cf643474:
    "Но вижу, что она боится испортить карьеру отказом."

# ch/harems_full/office/events/events.rpy:1431
translate russian office_harem_pimping_audrey_lavish_shiori_5051c55b:
    "Ключ ко всему — Одри."

# ch/harems_full/office/events/events.rpy:1432
translate russian office_harem_pimping_audrey_lavish_shiori_5a054669:
    "Если я склоню её на свою сторону, остальные должны последовать."

# ch/harems_full/office/events/events.rpy:1433
translate russian office_harem_pimping_audrey_lavish_shiori_37c9f24c:
    audrey.say "Значит..."

# ch/harems_full/office/events/events.rpy:1435
translate russian office_harem_pimping_audrey_lavish_shiori_797e1c64:
    audrey.say "Ты хочешь сказать, что будешь обязан нам услугой?"

# ch/harems_full/office/events/events.rpy:1436
translate russian office_harem_pimping_audrey_lavish_shiori_c0841324:
    mike.say "Можно и так сказать, Одри."

# ch/harems_full/office/events/events.rpy:1437
translate russian office_harem_pimping_audrey_lavish_shiori_ff769708:
    audrey.say "Тогда какого чёрта — давайте сделаем это."

# ch/harems_full/office/events/events.rpy:1439
translate russian office_harem_pimping_audrey_lavish_shiori_5d12949e:
    lavish.say "Ты уверена, что это хорошая идея, Одри?"

# ch/harems_full/office/events/events.rpy:1441
translate russian office_harem_pimping_audrey_lavish_shiori_648451fd:
    shiori.say "Звучит немного страшно!"

# ch/harems_full/office/events/events.rpy:1443
translate russian office_harem_pimping_audrey_lavish_shiori_77ead35a:
    audrey.say "Не волнуйтесь, девочки."

# ch/harems_full/office/events/events.rpy:1444
translate russian office_harem_pimping_audrey_lavish_shiori_665a1d50:
    audrey.say "Просто делайте как я, и всё будет хорошо."

# ch/harems_full/office/events/events.rpy:1445
translate russian office_harem_pimping_audrey_lavish_shiori_4b8c45f6:
    "Лавиш и Одри всё ещё выглядят нервными."

# ch/harems_full/office/events/events.rpy:1446
translate russian office_harem_pimping_audrey_lavish_shiori_905af461:
    "Но перед уверенностью Одри покорно кивают."

# ch/harems_full/office/events/events.rpy:1447
translate russian office_harem_pimping_audrey_lavish_shiori_605adce0:
    "Заручившись их согласием, она кивает мне, и я киваю в ответ."

# ch/harems_full/office/events/events.rpy:1448
translate russian office_harem_pimping_audrey_lavish_shiori_833b8d42:
    "Ну, была не была."

# ch/harems_full/office/events/events.rpy:1449
translate russian office_harem_pimping_audrey_lavish_shiori_8cccc024:
    "Надеюсь, эти десять тысяч того стоят!"

# ch/harems_full/office/events/events.rpy:1452
translate russian office_harem_pimping_audrey_lavish_shiori_74c21067:
    mike.say "Да ладно вам, девушки!"

# ch/harems_full/office/events/events.rpy:1453
translate russian office_harem_pimping_audrey_lavish_shiori_b04bf6e0:
    mike.say "Считайте это проявлением преданности компании."

# ch/harems_full/office/events/events.rpy:1454
translate russian office_harem_pimping_audrey_lavish_shiori_ff409049:
    mike.say "Вы бы сделали это ради всей компании!"

# ch/harems_full/office/events/events.rpy:1455
translate russian office_harem_pimping_audrey_lavish_shiori_e36d1b02:
    "Лавиш и Сиори всё ещё потрясены самой идеей."

# ch/harems_full/office/events/events.rpy:1456
translate russian office_harem_pimping_audrey_lavish_shiori_783fa5bc:
    "А Одри ни на секунду не сдерживается."

# ch/harems_full/office/events/events.rpy:1458
translate russian office_harem_pimping_audrey_lavish_shiori_af98ac1f:
    audrey.say "Ты хочешь сказать — ради тебя, [lssb_common.hero_name()]."

# ch/harems_full/office/events/events.rpy:1459
translate russian office_harem_pimping_audrey_lavish_shiori_e51fdb64:
    audrey.say "Не думай, что я не знаю о премии, которая стоит на кону!"

# ch/harems_full/office/events/events.rpy:1460
translate russian office_harem_pimping_audrey_lavish_shiori_21f2c51b:
    "Я пытаюсь объясниться или хотя бы сочинить правдоподобную ложь."

# ch/harems_full/office/events/events.rpy:1461
translate russian office_harem_pimping_audrey_lavish_shiori_fc09b700:
    "Но уже вижу, как на лицах Лавиш и Сиори нарастает потрясение."

# ch/harems_full/office/events/events.rpy:1463
translate russian office_harem_pimping_audrey_lavish_shiori_3110f9fe:
    lavish.say "Правда?"

# ch/harems_full/office/events/events.rpy:1464
translate russian office_harem_pimping_audrey_lavish_shiori_bd3be86e:
    lavish.say "Так вот в чём всё дело?"

# ch/harems_full/office/events/events.rpy:1465
translate russian office_harem_pimping_audrey_lavish_shiori_f86a3464:
    shiori.say "Ох, [lssb_common.hero_name()]..."

# ch/harems_full/office/events/events.rpy:1466
translate russian office_harem_pimping_audrey_lavish_shiori_f2d8a616:
    shiori.say "Это правда?"

# ch/harems_full/office/events/events.rpy:1467
translate russian office_harem_pimping_audrey_lavish_shiori_e23ba9ea:
    audrey.say "Думаю, мы просто забудем об этом разговоре, верно?"

# ch/harems_full/office/events/events.rpy:1468
translate russian office_harem_pimping_audrey_lavish_shiori_a7a76899:
    audrey.say "Иначе кто-нибудь может рассказать о нём отделу кадров..."

# ch/harems_full/office/events/events.rpy:1473
translate russian office_harem_pimping_audrey_lavish_shiori_b1a9e3d7:
    "Все трое одновременно поворачиваются ко мне спиной."

# ch/harems_full/office/events/events.rpy:1474
translate russian office_harem_pimping_audrey_lavish_shiori_a61ab61a:
    "И уходят, а я смотрю, как вместе с ними исчезают мои десять тысяч."

# ch/harems_full/office/events/events.rpy:1480
translate russian foursome_office_aletta_925a4c6a:
    "Я придерживаю дверь перед Алеттой, желая хоть немного облегчить ей всё это."

# ch/harems_full/office/events/events.rpy:1482
translate russian foursome_office_aletta_a61b65ba:
    "Но она стремительно проходит мимо, и мне приходится отскочить, пропуская её."

# ch/harems_full/office/events/events.rpy:1483
translate russian foursome_office_aletta_21fd33bd:
    "Едва закрыв за собой дверь, я слышу реакцию представителей Blissard."

# ch/harems_full/office/events/events.rpy:1488
translate russian foursome_office_aletta_84a5c65c:
    "Том" "О, кто это у нас?"

# ch/harems_full/office/events/events.rpy:1490
translate russian foursome_office_aletta_c139b941:
    "Дик" "Насчёт неё вы не шутили, [lssb_common.hero_name()]!"

# ch/harems_full/office/events/events.rpy:1492
translate russian foursome_office_aletta_38423920:
    "Гарри" "Ого! Пусть карабкается по моей корпоративной лестнице сколько угодно!"

# ch/harems_full/office/events/events.rpy:1494
translate russian foursome_office_aletta_14b55a34:
    "Алетта презрительно фыркает."

# ch/harems_full/office/events/events.rpy:1496
translate russian foursome_office_aletta_beff87d4:
    "Она внимательно изучает Тома, Дика и Гарри поверх очков."

# ch/harems_full/office/events/events.rpy:1497
translate russian foursome_office_aletta_90a5ade8:
    "И всего через пару секунд под её взглядом они начинают заметно нервничать."

# ch/harems_full/office/events/events.rpy:1499
translate russian foursome_office_aletta_5ab8b5ec:
    "Том" "Эм, что здесь происходит, [lssb_common.hero_name()]?"

# ch/harems_full/office/events/events.rpy:1501
translate russian foursome_office_aletta_277f5b18:
    "Дик" "Да, почему она так на нас смотрит?"

# ch/harems_full/office/events/events.rpy:1503
translate russian foursome_office_aletta_af1b6f67:
    "Гарри" "Не уверен, что мне это нравится..."

# ch/harems_full/office/events/events.rpy:1504
translate russian foursome_office_aletta_d12c3f8a:
    "Я немного выступаю вперёд, улыбаясь Алетте."

# ch/harems_full/office/events/events.rpy:1505
translate russian foursome_office_aletta_09530753:
    "Хотя сам нервничаю не меньше, чем, судя по виду, представители Blissard."

# ch/harems_full/office/events/events.rpy:1506
translate russian foursome_office_aletta_26b19e22:
    mike.say "Эм... Алетта?"

# ch/harems_full/office/events/events.rpy:1507
translate russian foursome_office_aletta_ffe1b1bc:
    mike.say "Ты ведь помнишь, о чём мы договорились?"

# ch/harems_full/office/events/events.rpy:1509
translate russian foursome_office_aletta_a7371233:
    "Алетта снова фыркает, но всё же кивает."

# ch/harems_full/office/events/events.rpy:1511
translate russian foursome_office_aletta_54d635fd:
    aletta.say "Я просто оценивала противника."

# ch/harems_full/office/events/events.rpy:1513
translate russian foursome_office_aletta_47e2d167:
    "С этими словами она уверенно направляется к представителям Blissard."

# ch/harems_full/office/events/events.rpy:1514
translate russian foursome_office_aletta_bffe6151:
    "Не говоря больше ни слова, Алетта словно берёт ситуацию под контроль."

# ch/harems_full/office/events/events.rpy:1515
translate russian foursome_office_aletta_2440e5a1:
    "Она смотрит на Тома, Дика и Гарри с прежним пренебрежением."

# ch/harems_full/office/events/events.rpy:1516
translate russian foursome_office_aletta_64c39ad0:
    "Но теперь одновременно начинает расстёгивать блузку."

# ch/harems_full/office/events/events.rpy:1518
translate russian foursome_office_aletta_351c50ad:
    aletta.say "Уясните одну вещь, господа."

# ch/harems_full/office/events/events.rpy:1519
translate russian foursome_office_aletta_46d34881:
    aletta.say "Я делаю это ради сделки."

# ch/harems_full/office/events/events.rpy:1520
translate russian foursome_office_aletta_6409f77b:
    aletta.say "И только."

# ch/harems_full/office/events/events.rpy:1521
translate russian foursome_office_aletta_50ad89ee:
    "Том, Дик и Гарри кивают, наблюдая, как Алетта раздевается."

# ch/harems_full/office/events/events.rpy:1522
translate russian foursome_office_aletta_468d217a:
    "Они словно заворожены силой её личности."

# ch/harems_full/office/events/events.rpy:1523
translate russian foursome_office_aletta_0c2b5555:
    "И их словно не волнует, что она всё время говорит с ними свысока."

# ch/harems_full/office/events/events.rpy:1524
translate russian foursome_office_aletta_627cb0ef:
    aletta.say "Я позволяю вам прикасаться ко мне только ради заключения сделки."

# ch/harems_full/office/events/events.rpy:1525
translate russian foursome_office_aletta_057fcae2:
    aletta.say "Хочу, чтобы вы помнили об этом всё время."

# ch/harems_full/office/events/events.rpy:1526
translate russian foursome_office_aletta_1e8bada5:
    aletta.say "За пределами этой комнаты, в реальном мире, подобное было бы невозможно."

# ch/harems_full/office/events/events.rpy:1527
translate russian foursome_office_aletta_c1c4e39f:
    aletta.say "В реальном мире вы, ничтожества, мне не ровня!"

# ch/harems_full/office/events/events.rpy:1529
translate russian foursome_office_aletta_fe5b0e52:
    "Теперь все четверо обнажены, и мужчины медленно приближаются к Алетте."

# ch/harems_full/office/events/events.rpy:1530
translate russian foursome_office_aletta_720ab706:
    "Я заворожённо молчу, наблюдая, как Том ложится перед ней на пол."

# ch/harems_full/office/events/events.rpy:1531
translate russian foursome_office_aletta_a82fb113:
    "Алетта позволяет двум другим помочь ей опуститься."

# ch/harems_full/office/events/events.rpy:1532
translate russian foursome_office_aletta_096e6084:
    "И они направляют её прямо на уже вставший член Тома."

# ch/harems_full/office/events/events.rpy:1533
translate russian foursome_office_aletta_57621d7e:
    "Алетта тихонько вскрикивает, когда он упирается в её половые губы."

# ch/harems_full/office/events/events.rpy:1539
translate russian foursome_office_aletta_4612e971:
    "Затем подавляет вскрик, а остальное делает сила тяжести."

# ch/harems_full/office/events/events.rpy:1540
translate russian foursome_office_aletta_844565f1:
    "На мгновение мне кажется, что она закроет глаза, опускаясь на него."

# ch/harems_full/office/events/events.rpy:1541
translate russian foursome_office_aletta_8bedaad4:
    "Но она поднимает взгляд и смотрит мне в глаза."

# ch/harems_full/office/events/events.rpy:1542
translate russian foursome_office_aletta_8f7948e3:
    "Алетта не отрывает от меня взгляда всё время, пока Том входит в неё."

# ch/harems_full/office/events/events.rpy:1543
translate russian foursome_office_aletta_497c9a74:
    "И продолжает смотреть, когда Дик с готовностью начинает вводить член ей в задницу."

# ch/harems_full/office/events/events.rpy:1544
translate russian foursome_office_aletta_e70745e3:
    "Даже Гарри, грубо тычущий членом ей в лицо, не заставляет её отвернуться."

# ch/harems_full/office/events/events.rpy:1545
translate russian foursome_office_aletta_b193ff8e:
    "Алетта по-прежнему смотрит на меня, размыкая губы и начиная сосать."

# ch/harems_full/office/events/events.rpy:1546
translate russian foursome_office_aletta_36543206:
    "Я громко сглатываю, когда все трое принимаются наслаждаться."

# ch/harems_full/office/events/events.rpy:1547
translate russian foursome_office_aletta_0bd3b128:
    "Вскоре Алетту уже толкают и тянут сразу в трёх направлениях."

# ch/harems_full/office/events/events.rpy:1548
translate russian foursome_office_aletta_ce902bd2:
    "Никто из представителей Blissard не видит выражения её лица."

# ch/harems_full/office/events/events.rpy:1549
translate russian foursome_office_aletta_d15bd947:
    "Они слишком заняты тем, что втыкают в неё члены, чтобы заметить."

# ch/harems_full/office/events/events.rpy:1550
translate russian foursome_office_aletta_2c01b269:
    "Но я вижу: прежняя надменная и отстранённая Алетта исчезла."

# ch/harems_full/office/events/events.rpy:1552
translate russian foursome_office_aletta_e5784ef3:
    "Теперь её глаза широко раскрыты, а щёки густо покраснели."

# ch/harems_full/office/events/events.rpy:1553
translate russian foursome_office_aletta_8fad5d99:
    "Кто-то другой решил бы, что причина лишь в том, через что ей приходится проходить."

# ch/harems_full/office/events/events.rpy:1554
translate russian foursome_office_aletta_74d5f918:
    "Но я достаточно хорошо знаю Алетту, чтобы понимать правду."

# ch/harems_full/office/events/events.rpy:1555
translate russian foursome_office_aletta_e09be846:
    "Есть сторона её натуры, которую она обычно тщательно скрывает."

# ch/harems_full/office/events/events.rpy:1556
translate russian foursome_office_aletta_d08e9d8e:
    "Та, что втайне жаждет именно такого унижения."

# ch/harems_full/office/events/events.rpy:1557
translate russian foursome_office_aletta_546d1606:
    "И дело не только в том, что ею пользуются трое мужчин одновременно."

# ch/harems_full/office/events/events.rpy:1558
translate russian foursome_office_aletta_b0e3b9a4:
    "Я вижу: значительная часть её возбуждения связана с моим присутствием."

# ch/harems_full/office/events/events.rpy:1559
translate russian foursome_office_aletta_8195d539:
    "Возможно, больше всего Алетту заводит то, что её унижают у меня на глазах!"

# ch/harems_full/office/events/events.rpy:1560
translate russian foursome_office_aletta_d51780de:
    "Я тоже не могу отвернуться, словно вынужден наблюдать."

# ch/harems_full/office/events/events.rpy:1561
translate russian foursome_office_aletta_e8a3104a:
    "Том, Дик и Гарри не сдерживаются и не церемонятся."

# ch/harems_full/office/events/events.rpy:1562
translate russian foursome_office_aletta_c313894b:
    "В каждой дырочке Алетты по члену, и все трое трахают её жёстко."

# ch/harems_full/office/events/events.rpy:1563
translate russian foursome_office_aletta_c1d89a2f:
    "Их тела двигаются так, что толчки идут сразу с трёх сторон."

# ch/harems_full/office/events/events.rpy:1564
translate russian foursome_office_aletta_521cf17b:
    "И словно этого мало, руки и рты тоже оказываются повсюду!"

# ch/harems_full/office/events/events.rpy:1565
translate russian foursome_office_aletta_5e53d89d:
    "Вскоре кожа Алетты становится скользкой от пота и их слюны."

# ch/harems_full/office/events/events.rpy:1567
translate russian foursome_office_aletta_e7ba2124:
    "Всё становится лишь хуже, когда они начинают кончать один за другим."

# ch/harems_full/office/events/events.rpy:1569
translate russian foursome_office_aletta_b57d6141:
    "Ни один ни на миг не задумывается, куда изливается."

# ch/harems_full/office/events/events.rpy:1571
translate russian foursome_office_aletta_8424417d:
    "В итоге сперма течёт из киски, попки и рта Алетты."

# ch/harems_full/office/events/events.rpy:1572
translate russian foursome_office_aletta_8b777097:
    "Когда всё заканчивается, они позволяют обессиленной Алетте упасть на пол, тяжело дыша."

# ch/harems_full/office/events/events.rpy:1575
translate russian foursome_office_aletta_f6607afb:
    "Том" "Ах... фух..."

# ch/harems_full/office/events/events.rpy:1576
translate russian foursome_office_aletta_c7f45213:
    "Том" "Уговор есть уговор, верно?"

# ch/harems_full/office/events/events.rpy:1577
translate russian foursome_office_aletta_5bd1010c:
    "Ещё не одевшись, все трое подходят к столу."

# ch/harems_full/office/events/events.rpy:1578
translate russian foursome_office_aletta_daad6d71:
    "И один за другим подписывают бумаги, как мы договорились."

# ch/harems_full/office/events/events.rpy:1579
translate russian foursome_office_aletta_b5a80f1d:
    "Всё это время мой взгляд мечется между представителями Blissard и Алеттой."

# ch/harems_full/office/events/events.rpy:1580
translate russian foursome_office_aletta_cb18e8d9:
    "Они улыбаются и подмигивают, натягивая одежду."

# ch/harems_full/office/events/events.rpy:1582
translate russian foursome_office_aletta_8275c38c:
    "А она всё ещё сидит на полу, неловко нащупывая свою."

# ch/harems_full/office/events/events.rpy:1583
translate russian foursome_office_aletta_c836078b:
    "Я выдавливаю улыбку, пытаясь скрыть противоречивые чувства."

# ch/harems_full/office/events/events.rpy:1584
translate russian foursome_office_aletta_b63c1ade:
    "Да, я получил желаемое."

# ch/harems_full/office/events/events.rpy:1585
translate russian foursome_office_aletta_2c77506e:
    "Но стоило ли оно того, что пришлось пережить Алетте?"

# ch/harems_full/office/events/events.rpy:1591
translate russian foursome_office_audrey_5a2ba061:
    "Я придерживаю дверь, а Одри уверенно входит в комнату."

# ch/harems_full/office/events/events.rpy:1593
translate russian foursome_office_audrey_47ed6acc:
    "Остановившись перед Томом, Диком и Гарри, она смотрит на них почти пренебрежительно."

# ch/harems_full/office/events/events.rpy:1598
translate russian foursome_office_audrey_a36d5eb3:
    "Что, разумеется, лишь усиливает их желание приступить к делу."

# ch/harems_full/office/events/events.rpy:1599
translate russian foursome_office_audrey_179b2c62:
    "Я поспешно закрываю дверь за нами, молясь, чтобы никто не вошёл, пока мы не закончим."

# ch/harems_full/office/events/events.rpy:1601
translate russian foursome_office_audrey_d2b623f2:
    "Том" "Ого, Дик!"

# ch/harems_full/office/events/events.rpy:1602
translate russian foursome_office_audrey_d7766409:
    "Том" "Надо почаще тебя слушать!"

# ch/harems_full/office/events/events.rpy:1604
translate russian foursome_office_audrey_5c7457a1:
    "Гарри" "И не говори! Она чертовски горяча!"

# ch/harems_full/office/events/events.rpy:1605
translate russian foursome_office_audrey_52208f1c:
    "Дик пользуется случаем погреться в лучах славы: это ведь он заприметил Одри."

# ch/harems_full/office/events/events.rpy:1606
translate russian foursome_office_audrey_2ef49d5e:
    "Но сама Одри, похоже, совсем не впечатлена знакомством со своим поклонником."

# ch/harems_full/office/events/events.rpy:1608
translate russian foursome_office_audrey_57966788:
    audrey.say "Считаете, он такой замечательный?"

# ch/harems_full/office/events/events.rpy:1609
translate russian foursome_office_audrey_b8650799:
    audrey.say "Тогда почему бы вам не трахнуть его вместо меня?"

# ch/harems_full/office/events/events.rpy:1610
translate russian foursome_office_audrey_7bfa5154:
    "Уверен, Одри хотела задеть представителей Blissard."

# ch/harems_full/office/events/events.rpy:1611
translate russian foursome_office_audrey_cde81cab:
    "Но её слова лишь сильнее их возбуждают перед предстоящим."

# ch/harems_full/office/events/events.rpy:1613
translate russian foursome_office_audrey_3f8d7cf2:
    "Дик" "Теперь понимаете, о чём я?"

# ch/harems_full/office/events/events.rpy:1614
translate russian foursome_office_audrey_2e8903a7:
    "Дик" "Сразу понял, что эта маленькая шлюха развратная, как только её увидел!"

# ch/harems_full/office/events/events.rpy:1616
translate russian foursome_office_audrey_a5fe7b0a:
    "При слове «шлюха» в глазах Одри вспыхивает раздражение."

# ch/harems_full/office/events/events.rpy:1617
translate russian foursome_office_audrey_36dba749:
    "В следующий миг она поворачивается ко мне, сжав кулаки."

# ch/harems_full/office/events/events.rpy:1619
translate russian foursome_office_audrey_c4b59c14:
    audrey.say "Что это значит, [lssb_common.hero_name()]?"

# ch/harems_full/office/events/events.rpy:1620
translate russian foursome_office_audrey_825a89c5:
    audrey.say "Ты сказал им, что заплатишь мне за это?!"

# ch/harems_full/office/events/events.rpy:1621
translate russian foursome_office_audrey_f7861ba4:
    mike.say "Нет, Одри!"

# ch/harems_full/office/events/events.rpy:1622
translate russian foursome_office_audrey_2464c7a1:
    mike.say "Клянусь, я об этом ни слова не сказал!"

# ch/harems_full/office/events/events.rpy:1623
translate russian foursome_office_audrey_c594498d:
    "Я собираюсь продолжить, но между мной и Одри встаёт Том."

# ch/harems_full/office/events/events.rpy:1624
translate russian foursome_office_audrey_579520b2:
    "Он одаривает её донельзя самодовольной ухмылкой."

# ch/harems_full/office/events/events.rpy:1625
translate russian foursome_office_audrey_229d6807:
    "И я вижу, что он наслаждается каждой секундой."

# ch/harems_full/office/events/events.rpy:1627
translate russian foursome_office_audrey_eda43206:
    "Том" "Он говорит правду, Одри."

# ch/harems_full/office/events/events.rpy:1628
translate russian foursome_office_audrey_645aeaca:
    "Том" "Но раз уж ты делаешь это за деньги..."

# ch/harems_full/office/events/events.rpy:1630
translate russian foursome_office_audrey_5cf4ce49:
    "Дик" "Нам от этого только приятнее!"

# ch/harems_full/office/events/events.rpy:1632
translate russian foursome_office_audrey_55048822:
    "Гарри" "Ага! Значит, мы знаем, что тебя купили и продали!"

# ch/harems_full/office/events/events.rpy:1634
translate russian foursome_office_audrey_a5c4c36e:
    "Том" "Ну и что решишь?"

# ch/harems_full/office/events/events.rpy:1635
translate russian foursome_office_audrey_880ef4c2:
    "Том" "Хочешь свою долю или нет?"

# ch/harems_full/office/events/events.rpy:1636
translate russian foursome_office_audrey_e3066d4b:
    "Одри бросает на меня последний ядовитый взгляд."

# ch/harems_full/office/events/events.rpy:1637
translate russian foursome_office_audrey_90d805b4:
    "Затем я вижу, как она усилием меняет выражение лица."

# ch/harems_full/office/events/events.rpy:1639
translate russian foursome_office_audrey_6045d020:
    "Хмурый взгляд сменяется развратной понимающей ухмылкой."

# ch/harems_full/office/events/events.rpy:1640
translate russian foursome_office_audrey_54da1f59:
    "Она переводит взгляд на Тима и начинает раздеваться."

# ch/harems_full/office/events/events.rpy:1642
translate russian foursome_office_audrey_4676b1ed:
    audrey.say "Не волнуйтесь, мы займёмся делом."

# ch/harems_full/office/events/events.rpy:1643
translate russian foursome_office_audrey_a4ae89df:
    audrey.say "В конце концов, за меня ведь уже заплатили?"

# ch/harems_full/office/events/events.rpy:1645
translate russian foursome_office_audrey_fa71d1ca:
    "Том, Дик и Гарри охотно кивают и следуют её примеру."

# ch/harems_full/office/events/events.rpy:1646
translate russian foursome_office_audrey_26823ab5:
    "Не проходит и минуты, как все уже обнажены и готовы."

# ch/harems_full/office/events/events.rpy:1647
translate russian foursome_office_audrey_0b780cac:
    "Том садится и подзывает Одри к себе."

# ch/harems_full/office/events/events.rpy:1648
translate russian foursome_office_audrey_425dbe56:
    "Она без вопросов подчиняется."

# ch/harems_full/office/events/events.rpy:1649
translate russian foursome_office_audrey_b18c08b0:
    "И всё время не забывает поглядывать на его уже вставший член."

# ch/harems_full/office/events/events.rpy:1650
translate russian foursome_office_audrey_bb2760ef:
    "Она ещё не успевает опуститься достаточно низко, чтобы взять его в рот, а остальные тоже начинают действовать."

# ch/harems_full/office/events/events.rpy:1651
translate russian foursome_office_audrey_d1739d89:
    "Дик прижимает член к киске Одри, толкая её на член Тома."

# ch/harems_full/office/events/events.rpy:1652
translate russian foursome_office_audrey_263b0f62:
    "И почти сразу после того, как он входит, Гарри погружает свой член ей в задницу."

# ch/harems_full/office/events/events.rpy:1658
translate russian foursome_office_audrey_f6feb0d9:
    "Возможно, Одри вошла сюда с мыслью, что берёт инициативу на себя."

# ch/harems_full/office/events/events.rpy:1659
translate russian foursome_office_audrey_4b15c2a8:
    "Но теперь в трёх её дырочках одновременно находятся три члена."

# ch/harems_full/office/events/events.rpy:1660
translate russian foursome_office_audrey_95f56a21:
    "Ей остаётся лишь следовать тому, что с ней происходит."

# ch/harems_full/office/events/events.rpy:1661
translate russian foursome_office_audrey_8e8982d2:
    "Том, Дик и Гарри тоже не теряют времени."

# ch/harems_full/office/events/events.rpy:1662
translate russian foursome_office_audrey_26be31ee:
    "Едва войдя в Одри, они начинают безжалостно двигаться."

# ch/harems_full/office/events/events.rpy:1663
translate russian foursome_office_audrey_f38983b6:
    "Я могу лишь наблюдать с каким-то ужасным, заворожённым интересом."

# ch/harems_full/office/events/events.rpy:1664
translate russian foursome_office_audrey_850432eb:
    "Я привык видеть Одри язвительной и резкой коллегой."

# ch/harems_full/office/events/events.rpy:1666
translate russian foursome_office_audrey_101a3817:
    "Но вскоре она уже лишь беспомощно хватает ртом воздух."

# ch/harems_full/office/events/events.rpy:1667
translate russian foursome_office_audrey_25e315b7:
    "Том, Дик и Гарри, кажется, отлично проводят время."

# ch/harems_full/office/events/events.rpy:1668
translate russian foursome_office_audrey_0655454e:
    "Хотя про Одри я не могу сказать того же."

# ch/harems_full/office/events/events.rpy:1669
translate russian foursome_office_audrey_0e3c913f:
    "По-моему, ею просто пользуются ради собственного удовольствия."

# ch/harems_full/office/events/events.rpy:1670
translate russian foursome_office_audrey_89f4530a:
    "Но на кону мои деньги, поэтому я всё время держу рот на замке."

# ch/harems_full/office/events/events.rpy:1671
translate russian foursome_office_audrey_1e5b5a43:
    "Проще всего было бы отвернуться и дождаться конца."

# ch/harems_full/office/events/events.rpy:1672
translate russian foursome_office_audrey_1fe1de08:
    "Но я не могу: Одри поднимает глаза и встречается со мной взглядом."

# ch/harems_full/office/events/events.rpy:1673
translate russian foursome_office_audrey_ed927a77:
    "Не знаю, делает ли она это, чтобы вызвать во мне чувство вины."

# ch/harems_full/office/events/events.rpy:1674
translate russian foursome_office_audrey_840a73cd:
    "Или действительно надеется, что я как-то вмешаюсь."

# ch/harems_full/office/events/events.rpy:1675
translate russian foursome_office_audrey_6b2bfb15:
    "Так или иначе, я не отвожу от неё глаз до самого конца."

# ch/harems_full/office/events/events.rpy:1677
translate russian foursome_office_audrey_af576244:
    "Том кончает первым, изливаясь прямо Одри в лицо."

# ch/harems_full/office/events/events.rpy:1679
translate russian foursome_office_audrey_b39c5e78:
    "Словно следуя его примеру, Дик и Гарри кончают через мгновение."

# ch/harems_full/office/events/events.rpy:1680
translate russian foursome_office_audrey_4d3bdf28:
    "Кажется, они теряют интерес к Одри в ту же секунду."

# ch/harems_full/office/events/events.rpy:1683
translate russian foursome_office_audrey_76007b65:
    "Она остаётся на полу, задыхаясь, пока они похлопывают друг друга по спине."

# ch/harems_full/office/events/events.rpy:1684
translate russian foursome_office_audrey_f6607afb:
    "Том" "Ах... фух..."

# ch/harems_full/office/events/events.rpy:1685
translate russian foursome_office_audrey_c7f45213:
    "Том" "Уговор есть уговор, верно?"

# ch/harems_full/office/events/events.rpy:1686
translate russian foursome_office_audrey_5bd1010c:
    "Ещё не одевшись, все трое подходят к столу."

# ch/harems_full/office/events/events.rpy:1687
translate russian foursome_office_audrey_daad6d71:
    "И один за другим подписывают бумаги, как мы договорились."

# ch/harems_full/office/events/events.rpy:1688
translate russian foursome_office_audrey_2b9f4916:
    "Всё это время мой взгляд мечется между представителями Blissard и Одри."

# ch/harems_full/office/events/events.rpy:1689
translate russian foursome_office_audrey_cb18e8d9:
    "Они улыбаются и подмигивают, натягивая одежду."

# ch/harems_full/office/events/events.rpy:1691
translate russian foursome_office_audrey_8275c38c:
    "А она всё ещё сидит на полу, неловко нащупывая свою."

# ch/harems_full/office/events/events.rpy:1692
translate russian foursome_office_audrey_c836078b:
    "Я выдавливаю улыбку, пытаясь скрыть противоречивые чувства."

# ch/harems_full/office/events/events.rpy:1693
translate russian foursome_office_audrey_b63c1ade:
    "Да, я получил желаемое."

# ch/harems_full/office/events/events.rpy:1694
translate russian foursome_office_audrey_46f07352:
    "Но стоила ли тысяча того, через что только что прошла Одри?"

# ch/harems_full/office/events/events.rpy:1700
translate russian foursome_office_lavish_f418fd6a:
    "Я не свожу глаз с Лавиш, открывая дверь и пропуская её в переговорную."

# ch/harems_full/office/events/events.rpy:1702
translate russian foursome_office_lavish_357cfa7c:
    "Пока я закрываю за собой дверь, она изо всех сил старается выглядеть уверенной и спокойной."

# ch/harems_full/office/events/events.rpy:1703
translate russian foursome_office_lavish_fa6202cd:
    "Но нетрудно заметить, что сейчас ей очень страшно."

# ch/harems_full/office/events/events.rpy:1704
translate russian foursome_office_lavish_4ffc3524:
    "И, хотя мне от этого не легче, я невольно сочувствую Лавиш."

# ch/harems_full/office/events/events.rpy:1709
translate russian foursome_office_lavish_ebb005c5:
    "Особенно когда вижу похотливые взгляды Тома, Дика и Гарри."

# ch/harems_full/office/events/events.rpy:1710
translate russian foursome_office_lavish_0a94fd35:
    "Лавиш улыбается им и даже пытается дружелюбно помахать рукой."

# ch/harems_full/office/events/events.rpy:1711
translate russian foursome_office_lavish_2f0c9578:
    "Но они уже смотрят на неё как волки на заблудившуюся овечку."

# ch/harems_full/office/events/events.rpy:1713
translate russian foursome_office_lavish_d53c21a8:
    "Том" "Ого, Гарри!"

# ch/harems_full/office/events/events.rpy:1714
translate russian foursome_office_lavish_a58a9a66:
    "Том" "Надо почаще тебя слушать!"

# ch/harems_full/office/events/events.rpy:1716
translate russian foursome_office_lavish_f6e84e2d:
    "Дик" "Да, дружище, она что-то особенное!"

# ch/harems_full/office/events/events.rpy:1718
translate russian foursome_office_lavish_415c362a:
    "Гарри" "Я же говорил вам!"

# ch/harems_full/office/events/events.rpy:1719
translate russian foursome_office_lavish_087ede77:
    "Гарри" "Она чертовски сексуальна!"

# ch/harems_full/office/events/events.rpy:1720
translate russian foursome_office_lavish_4ad3ee5f:
    "Я выдавливаю улыбку, делая вид, что всё идёт хорошо."

# ch/harems_full/office/events/events.rpy:1721
translate russian foursome_office_lavish_e56e9e86:
    "Но на самом деле мне уже жалко Лавиш, пока они пускают на неё слюни."

# ch/harems_full/office/events/events.rpy:1722
translate russian foursome_office_lavish_9832eefc:
    "Наверное, отступать теперь слишком поздно..."

# ch/harems_full/office/events/events.rpy:1723
translate russian foursome_office_lavish_2d0a5b86:
    "У самой Лавиш улыбка будто приколочена к лицу."

# ch/harems_full/office/events/events.rpy:1724
translate russian foursome_office_lavish_b17cd97e:
    "Похоже, она не меньше моего намерена довести дело до конца ради обещанного повышения."

# ch/harems_full/office/events/events.rpy:1726
translate russian foursome_office_lavish_9510c462:
    lavish.say "О-о..."

# ch/harems_full/office/events/events.rpy:1727
translate russian foursome_office_lavish_fd741d48:
    lavish.say "В... вы так добры!"

# ch/harems_full/office/events/events.rpy:1728
translate russian foursome_office_lavish_3edcd24b:
    "Том, Дик и Гарри разражаются смехом."

# ch/harems_full/office/events/events.rpy:1729
translate russian foursome_office_lavish_12f4f15b:
    "Они уже снимают галстуки и расстёгивают рубашки."

# ch/harems_full/office/events/events.rpy:1731
translate russian foursome_office_lavish_a2769d3a:
    "Том" "О, мы умеем быть добрыми."

# ch/harems_full/office/events/events.rpy:1732
translate russian foursome_office_lavish_acbbcfa8:
    "Том" "Но, может, тебе на самом деле нужно другое?"

# ch/harems_full/office/events/events.rpy:1734
translate russian foursome_office_lavish_a804efa4:
    "Дик" "Да, малышка, может, ты хочешь, чтобы мы были плохими?"

# ch/harems_full/office/events/events.rpy:1736
translate russian foursome_office_lavish_a0538796:
    "Гарри" "Ох, пожалуйста, скажи, что хочешь плохих парней!"

# ch/harems_full/office/events/events.rpy:1738
translate russian foursome_office_lavish_2dc90cef:
    "Лавиш снова смеётся, стараясь не падать духом."

# ch/harems_full/office/events/events.rpy:1739
translate russian foursome_office_lavish_b1597d35:
    "Но на этот раз я отчётливо слышу охватившее её волнение."

# ch/harems_full/office/events/events.rpy:1740
translate russian foursome_office_lavish_7deeeca6:
    "Она оглядывается на меня через плечо, словно просит помощи."

# ch/harems_full/office/events/events.rpy:1741
translate russian foursome_office_lavish_c5e2d568:
    "А я лишь ободряюще киваю и слабо улыбаюсь."

# ch/harems_full/office/events/events.rpy:1742
translate russian foursome_office_lavish_224949b4:
    "Лавиш кивает в ответ и идёт к представителям Blissard."

# ch/harems_full/office/events/events.rpy:1744
translate russian foursome_office_lavish_69ff4c2a:
    "Она движется медленно, так же неторопливо снимая одежду."

# ch/harems_full/office/events/events.rpy:1745
translate russian foursome_office_lavish_36f4a83c:
    "Это оттягивает момент, когда она окажется рядом с ними."

# ch/harems_full/office/events/events.rpy:1747
translate russian foursome_office_lavish_17abb964:
    "Но заодно даёт им больше времени похотливо её разглядывать!"

# ch/harems_full/office/events/events.rpy:1748
translate russian foursome_office_lavish_36a3ae1f:
    "Том садится и жестом велит Лавиш повернуться к нему спиной."

# ch/harems_full/office/events/events.rpy:1749
translate russian foursome_office_lavish_dc03cf8a:
    "Затем усаживает её к себе на колени, насаживая на член."

# ch/harems_full/office/events/events.rpy:1750
translate russian foursome_office_lavish_824de5f9:
    "Лавиш вскрикивает и прикусывает губу, чувствуя давление между ягодицами."

# ch/harems_full/office/events/events.rpy:1751
translate russian foursome_office_lavish_006b30af:
    "Но Дик вскоре прекращает это, вводя собственный член ей в рот."

# ch/harems_full/office/events/events.rpy:1752
translate russian foursome_office_lavish_a826422b:
    "Вижу, как её глаза расширяются от потрясения, пока она пытается открыть рот достаточно широко."

# ch/harems_full/office/events/events.rpy:1753
translate russian foursome_office_lavish_b6cef878:
    "Она так отвлечена, что через мгновение Гарри застаёт её совершенно врасплох."

# ch/harems_full/office/events/events.rpy:1754
translate russian foursome_office_lavish_0f572202:
    "Он подходит и погружает свой член в киску Лавиш."

# ch/harems_full/office/events/events.rpy:1760
translate russian foursome_office_lavish_1183c5f2:
    "Когда они приступают к делу, в её глазах я вижу лишь растерянность."

# ch/harems_full/office/events/events.rpy:1761
translate russian foursome_office_lavish_3fa68e84:
    "Могу только догадываться, насколько сильно сопротивляется тело Лавиш."

# ch/harems_full/office/events/events.rpy:1762
translate russian foursome_office_lavish_8d1ce9dc:
    "Но, каким бы ни было желание сопротивляться, вечно это продолжаться не может."

# ch/harems_full/office/events/events.rpy:1763
translate russian foursome_office_lavish_e49c7af2:
    "И вскоре каждый из членов погружается в неё всё глубже."

# ch/harems_full/office/events/events.rpy:1764
translate russian foursome_office_lavish_74ad37f5:
    "Никогда не представлял, что увижу Лавиш в таком положении."

# ch/harems_full/office/events/events.rpy:1765
translate russian foursome_office_lavish_aab09e5e:
    "Конечно, я немало фантазировал о ней в откровенных позах."

# ch/harems_full/office/events/events.rpy:1766
translate russian foursome_office_lavish_e1c4bddb:
    "Кто бы не фантазировал? Девушка она потрясающая."

# ch/harems_full/office/events/events.rpy:1767
translate russian foursome_office_lavish_40027a8d:
    "Но Том, Дик и Гарри обращаются с её телом как с парком аттракционов!"

# ch/harems_full/office/events/events.rpy:1768
translate russian foursome_office_lavish_20689947:
    "Ноги Лавиш задраны в воздух, а сама она подпрыгивает на коленях Тома."

# ch/harems_full/office/events/events.rpy:1769
translate russian foursome_office_lavish_4523d7f2:
    "Я даже не уверен, понимает ли она ещё, где находится и что происходит!"

# ch/harems_full/office/events/events.rpy:1770
translate russian foursome_office_lavish_5889eefd:
    "Но для меня в этом хотя бы есть небольшое облегчение."

# ch/harems_full/office/events/events.rpy:1772
translate russian foursome_office_lavish_665371a7:
    "Лавиш так растеряна, что ей не до взгляда в мою сторону."

# ch/harems_full/office/events/events.rpy:1773
translate russian foursome_office_lavish_f3c6ff60:
    "Иначе она бы непременно заметила всё более виноватое выражение моего лица."

# ch/harems_full/office/events/events.rpy:1774
translate russian foursome_office_lavish_03e60a3b:
    "Обещая ей какое-то вознаграждение, я был лишь наполовину серьёзен."

# ch/harems_full/office/events/events.rpy:1775
translate russian foursome_office_lavish_a64897d6:
    "Но тогда было одно, а теперь я понимаю, что придётся сдержать слово."

# ch/harems_full/office/events/events.rpy:1776
translate russian foursome_office_lavish_f5bf4bbc:
    "Иначе выходит, что я позволил ею воспользоваться исключительно ради своей выгоды!"

# ch/harems_full/office/events/events.rpy:1777
translate russian foursome_office_lavish_21f7c076:
    "Очень скоро представители Blissard начинают кончать."

# ch/harems_full/office/events/events.rpy:1779
translate russian foursome_office_lavish_4ad25292:
    "Том первым, словно другим двоим нужно его разрешение, прежде чем излиться самим."

# ch/harems_full/office/events/events.rpy:1781
translate russian foursome_office_lavish_ef2033d7:
    "Он без колебаний наполняет попку Лавиш, и сперма просачивается вокруг его члена."

# ch/harems_full/office/events/events.rpy:1783
translate russian foursome_office_lavish_177887a7:
    "Следующим кончает Дик, и вскоре сперма течёт уже и с её губ."

# ch/harems_full/office/events/events.rpy:1784
translate russian foursome_office_lavish_36c49101:
    "Гарри заканчивает последним, всё это время продолжая двигаться в киске Лавиш."

# ch/harems_full/office/events/events.rpy:1787
translate russian foursome_office_lavish_cfe22433:
    "Получив своё, они позволяют ей сползти на пол."

# ch/harems_full/office/events/events.rpy:1788
translate russian foursome_office_lavish_1d2b17fd:
    "Какое-то время она лежит там, тяжело дыша и совершенно обессилев."

# ch/harems_full/office/events/events.rpy:1789
translate russian foursome_office_lavish_f6607afb:
    "Том" "Ах... фух..."

# ch/harems_full/office/events/events.rpy:1790
translate russian foursome_office_lavish_c7f45213:
    "Том" "Уговор есть уговор, верно?"

# ch/harems_full/office/events/events.rpy:1791
translate russian foursome_office_lavish_5bd1010c:
    "Ещё не одевшись, все трое подходят к столу."

# ch/harems_full/office/events/events.rpy:1792
translate russian foursome_office_lavish_daad6d71:
    "И один за другим подписывают бумаги, как мы договорились."

# ch/harems_full/office/events/events.rpy:1793
translate russian foursome_office_lavish_5d2a8f7e:
    "Всё это время мой взгляд мечется между представителями Blissard и Лавиш."

# ch/harems_full/office/events/events.rpy:1794
translate russian foursome_office_lavish_cb18e8d9:
    "Они улыбаются и подмигивают, натягивая одежду."

# ch/harems_full/office/events/events.rpy:1796
translate russian foursome_office_lavish_8275c38c:
    "А она всё ещё сидит на полу, неловко нащупывая свою."

# ch/harems_full/office/events/events.rpy:1797
translate russian foursome_office_lavish_c836078b:
    "Я выдавливаю улыбку, пытаясь скрыть противоречивые чувства."

# ch/harems_full/office/events/events.rpy:1798
translate russian foursome_office_lavish_b63c1ade:
    "Да, я получил желаемое."

# ch/harems_full/office/events/events.rpy:1799
translate russian foursome_office_lavish_1b2c35e9:
    "Но как мне вообще возместить Лавиш то, через что ей пришлось пройти?"

# ch/harems_full/office/events/events.rpy:1805
translate russian foursome_office_shiori_5b7ec90e:
    "Мне приходится чуть ли не вести Сиори в переговорную за руку, не отпуская её ни на миг."

# ch/harems_full/office/events/events.rpy:1807
translate russian foursome_office_shiori_c1c1d1c5:
    "Она всё время цепляется за меня, напоминая оленя, застывшего в свете автомобильных фар."

# ch/harems_full/office/events/events.rpy:1812
translate russian foursome_office_shiori_036e12c9:
    "Том, Дик и Гарри тоже ничуть не помогают: едва увидев её, они начинают похотливо ухмыляться и смеяться."

# ch/harems_full/office/events/events.rpy:1813
translate russian foursome_office_shiori_a8e808f4:
    "Я даже чувствую, как прижавшаяся ко мне Сиори слегка дрожит."

# ch/harems_full/office/events/events.rpy:1815
translate russian foursome_office_shiori_bbe5ae02:
    "Том" "Ну что я вам говорил?"

# ch/harems_full/office/events/events.rpy:1816
translate russian foursome_office_shiori_46ede053:
    "Том" "Вот кого мы хотели!"

# ch/harems_full/office/events/events.rpy:1818
translate russian foursome_office_shiori_a72d1ef3:
    "Дик" "Ого! Вы только посмотрите на эти сиськи!"

# ch/harems_full/office/events/events.rpy:1820
translate russian foursome_office_shiori_6de24593:
    "Гарри" "И на задницу под стать им!"

# ch/harems_full/office/events/events.rpy:1821
translate russian foursome_office_shiori_c64b4c97:
    "Я прохожу дальше, направляя Сиори к парням из Blissard."

# ch/harems_full/office/events/events.rpy:1822
translate russian foursome_office_shiori_c33b41a6:
    "Сначала она сопротивляется, глядя на меня снизу вверх умоляющими глазами."

# ch/harems_full/office/events/events.rpy:1823
translate russian foursome_office_shiori_e28aba4e:
    "Но потом, кажется, понимает, что я не уступлю."

# ch/harems_full/office/events/events.rpy:1825
translate russian foursome_office_shiori_297636bb:
    shiori.say "М...мне правда придётся это сделать, [lssb_common.hero_name()]?"

# ch/harems_full/office/events/events.rpy:1826
translate russian foursome_office_shiori_fc8b773e:
    shiori.say "Неужели нет другого выхода?"

# ch/harems_full/office/events/events.rpy:1827
translate russian foursome_office_shiori_4a042f3b:
    "Мольба в голосе Сиори только сильнее раззадоривает Тома, Дика и Гарри."

# ch/harems_full/office/events/events.rpy:1828
translate russian foursome_office_shiori_006f3861:
    "Они идут нам навстречу, уже ослабляя галстуки и расстёгивая рубашки."

# ch/harems_full/office/events/events.rpy:1830
translate russian foursome_office_shiori_5b5ac963:
    "Том" "Не волнуйся, [lssb_common.hero_name()]."

# ch/harems_full/office/events/events.rpy:1832
translate russian foursome_office_shiori_957a08d6:
    "Дик" "Да, мы о ней позаботимся."

# ch/harems_full/office/events/events.rpy:1834
translate russian foursome_office_shiori_7e7bf3dc:
    "Гарри" "Вернём в целости и сохранности!"

# ch/harems_full/office/events/events.rpy:1835
translate russian foursome_office_shiori_7c5bc209:
    "Я намеренно отступаю на шаг, подталкивая Сиори вперёд."

# ch/harems_full/office/events/events.rpy:1836
translate russian foursome_office_shiori_a06372a2:
    "Она в последний раз оглядывается на меня."

# ch/harems_full/office/events/events.rpy:1837
translate russian foursome_office_shiori_e4071d61:
    "Но затем, похоже, понимает, что я не передумаю."

# ch/harems_full/office/events/events.rpy:1838
translate russian foursome_office_shiori_099af3de:
    mike.say "Только будьте с ней нежны, ладно?"

# ch/harems_full/office/events/events.rpy:1839
translate russian foursome_office_shiori_53cc8ee5:
    "Том, Дик и Гарри дружно кивают."

# ch/harems_full/office/events/events.rpy:1840
translate russian foursome_office_shiori_43587aba:
    "Но по их улыбкам видно, как их забавляет сама эта просьба."

# ch/harems_full/office/events/events.rpy:1842
translate russian foursome_office_shiori_3dff5001:
    "В конце концов, я только что согласился, по сути, шантажом заставить Сиори заняться с ними сексом."

# ch/harems_full/office/events/events.rpy:1843
translate russian foursome_office_shiori_269effb0:
    "Так что теперь уже поздновато умолять их быть с ней поласковее!"

# ch/harems_full/office/events/events.rpy:1845
translate russian foursome_office_shiori_f09d2a52:
    "Сиори начинает снимать одежду, но делает это слишком медленно."

# ch/harems_full/office/events/events.rpy:1846
translate russian foursome_office_shiori_1ca3897c:
    "Парни из Blissard вскоре сами берутся её раздевать."

# ch/harems_full/office/events/events.rpy:1847
translate russian foursome_office_shiori_1fca8ca0:
    "И Сиори остаётся лишь терпеть их руки по всему телу."

# ch/harems_full/office/events/events.rpy:1849
translate russian foursome_office_shiori_0d532134:
    "Том подводит Сиори к сиденьям у стены."

# ch/harems_full/office/events/events.rpy:1850
translate russian foursome_office_shiori_deb6808c:
    "Там он заставляет её лечь: без нежности, но и не настолько грубо, чтобы назвать это толчком."

# ch/harems_full/office/events/events.rpy:1851
translate russian foursome_office_shiori_081b2516:
    "Сиори падает на живот и оглядывается на него широко раскрытыми глазами."

# ch/harems_full/office/events/events.rpy:1852
translate russian foursome_office_shiori_49bc36d3:
    "Я вижу удовольствие в глазах Тома, когда он поднимает одну её ногу."

# ch/harems_full/office/events/events.rpy:1853
translate russian foursome_office_shiori_ed0d6daf:
    "И оно становится ещё заметнее, когда он прижимается членом к киске Сиори."

# ch/harems_full/office/events/events.rpy:1854
translate russian foursome_office_shiori_3cbef7be:
    "Она тихонько скулит, но тут Дик поворачивает её голову к себе."

# ch/harems_full/office/events/events.rpy:1855
translate russian foursome_office_shiori_0abad7a9:
    "Перед глазами Сиори тут же оказывается его член."

# ch/harems_full/office/events/events.rpy:1856
translate russian foursome_office_shiori_48942b89:
    "Когда он проталкивает его между её приоткрытых губ, глаза Сиори становятся круглыми, как блюдца."

# ch/harems_full/office/events/events.rpy:1857
translate russian foursome_office_shiori_0223b6f8:
    "Они принимаются за неё с обеих сторон, и Сиори остаётся только покориться."

# ch/harems_full/office/events/events.rpy:1858
translate russian foursome_office_shiori_5168faaa:
    "Даже когда Гарри подводит её руку к своему члену и заставляет начать ласкать его."

# ch/harems_full/office/events/events.rpy:1859
translate russian foursome_office_shiori_4ca48cc0:
    "Сиори не отшатывается, а безропотно обхватывает его ствол."

# ch/harems_full/office/events/events.rpy:1865
translate russian foursome_office_shiori_fc2a6722:
    "Мне бы радоваться, что она делает всё, как велено."

# ch/harems_full/office/events/events.rpy:1866
translate russian foursome_office_shiori_be4568f0:
    "Ведь это значит, что сделка почти у меня в кармане, а с ней и премия."

# ch/harems_full/office/events/events.rpy:1867
translate russian foursome_office_shiori_6756dc4e:
    "Но придумать всё это оказалось куда легче, чем смотреть, как оно происходит на самом деле."

# ch/harems_full/office/events/events.rpy:1868
translate russian foursome_office_shiori_c67731a8:
    "Конечно, Том, Дик и Гарри отрываются вовсю."

# ch/harems_full/office/events/events.rpy:1869
translate russian foursome_office_shiori_e703fba7:
    "Но меня по-настоящему задевает то, с какой покорностью Сиори всё это принимает."

# ch/harems_full/office/events/events.rpy:1871
translate russian foursome_office_shiori_a04228a2:
    "Наверное, я смог бы спокойно смотреть на то, что они заставляют её делать."

# ch/harems_full/office/events/events.rpy:1872
translate russian foursome_office_shiori_ea0af84b:
    "В конце концов, это просто секс — в спальне такое происходит постоянно."

# ch/harems_full/office/events/events.rpy:1873
translate russian foursome_office_shiori_52f7c155:
    "Нет, меня мучает именно то, как они пользуются Сиори."

# ch/harems_full/office/events/events.rpy:1874
translate russian foursome_office_shiori_bce03a51:
    "Я знаю, что в личной жизни ей пришлось несладко."

# ch/harems_full/office/events/events.rpy:1875
translate russian foursome_office_shiori_64e5f3ab:
    "И после всего пережитого она позволяет буквально вытирать о себя ноги."

# ch/harems_full/office/events/events.rpy:1876
translate russian foursome_office_shiori_e4c1d65f:
    "А теперь и я поступил с ней так же, лишь бы набить собственные карманы!"

# ch/harems_full/office/events/events.rpy:1877
translate russian foursome_office_shiori_d2cdc1f3:
    "Вскоре я замечаю первые признаки того, что Том вот-вот кончит."

# ch/harems_full/office/events/events.rpy:1879
translate russian foursome_office_shiori_59443be3:
    "Он со стоном изливается внутрь Сиори, и остальные словно следуют его примеру."

# ch/harems_full/office/events/events.rpy:1881
translate russian foursome_office_shiori_14e2401d:
    "Секундой позже Дик наполняет и без того занятый рот Сиори."

# ch/harems_full/office/events/events.rpy:1883
translate russian foursome_office_shiori_95042872:
    "Затем член Гарри дёргается в её руке, и сперма стекает по пальцам."

# ch/harems_full/office/events/events.rpy:1886
translate russian foursome_office_shiori_ddc22f38:
    "Закончив, они оставляют Сиори тяжело дышать на сиденье."

# ch/harems_full/office/events/events.rpy:1887
translate russian foursome_office_shiori_f6607afb:
    "Том" "Ах... фух..."

# ch/harems_full/office/events/events.rpy:1888
translate russian foursome_office_shiori_c7f45213:
    "Том" "Уговор есть уговор, верно?"

# ch/harems_full/office/events/events.rpy:1889
translate russian foursome_office_shiori_5bd1010c:
    "Даже не успев одеться, они подходят к столу."

# ch/harems_full/office/events/events.rpy:1890
translate russian foursome_office_shiori_daad6d71:
    "И один за другим подписывают бумаги, как мы и договаривались."

# ch/harems_full/office/events/events.rpy:1891
translate russian foursome_office_shiori_6289d8c1:
    "Всё это время мой взгляд мечется между парнями из Blissard и Сиори."

# ch/harems_full/office/events/events.rpy:1892
translate russian foursome_office_shiori_cb18e8d9:
    "Одеваясь, они улыбаются и подмигивают."

# ch/harems_full/office/events/events.rpy:1894
translate russian foursome_office_shiori_1fed322e:
    "А она едва переводит дух, неловко собирая свою одежду."

# ch/harems_full/office/events/events.rpy:1895
translate russian foursome_office_shiori_c836078b:
    "Я вымученно улыбаюсь, пытаясь скрыть раздирающие меня чувства."

# ch/harems_full/office/events/events.rpy:1896
translate russian foursome_office_shiori_b63c1ade:
    "Да, я получил то, чего хотел."

# ch/harems_full/office/events/events.rpy:1897
translate russian foursome_office_shiori_2261c7a5:
    "Но стоило ли это того, что пришлось пережить Сиори?"

# ch/harems_full/office/events/events.rpy:1903
translate russian sixsome_office_audrey_lavish_shiori_9355d66c:
    "Я открываю дверь переговорной, пропуская вперёд Одри, Лавиш и Сиори."

# ch/harems_full/office/events/events.rpy:1908
translate russian sixsome_office_audrey_lavish_shiori_2f0d1b0c:
    "Ещё не успев войти следом и закрыть дверь, я уже слышу, как их встречают."

# ch/harems_full/office/events/events.rpy:1913
translate russian sixsome_office_audrey_lavish_shiori_09187c97:
    "При виде девушек парни из Blissard смеются и даже хлопают в ладоши."

# ch/harems_full/office/events/events.rpy:1914
translate russian sixsome_office_audrey_lavish_shiori_86cf8375:
    "Подходя к остальным, я пытаюсь улыбаться и выглядеть таким же довольным."

# ch/harems_full/office/events/events.rpy:1915
translate russian sixsome_office_audrey_lavish_shiori_aac79856:
    "Но какая-то часть меня всё ещё чувствует себя скорее сутенёром, чем человеком, готовящимся заключить сделку!"

# ch/harems_full/office/events/events.rpy:1917
translate russian sixsome_office_audrey_lavish_shiori_af6f7760:
    "Гарри" "Вот это да... просто нет слов!"

# ch/harems_full/office/events/events.rpy:1918
translate russian sixsome_office_audrey_lavish_shiori_30cd82af:
    "Гарри" "Ты и правда не подвёл!"

# ch/harems_full/office/events/events.rpy:1920
translate russian sixsome_office_audrey_lavish_shiori_7905ac50:
    "Дик" "Ещё бы!"

# ch/harems_full/office/events/events.rpy:1921
translate russian sixsome_office_audrey_lavish_shiori_02f4a6fd:
    "Дик" "Они даже лучше, чем я запомнил!"

# ch/harems_full/office/events/events.rpy:1922
translate russian sixsome_office_audrey_lavish_shiori_4ecb008f:
    "Том" "Нашим компаниям стоит почаще сотрудничать, [lssb_common.hero_name()]."

# ch/harems_full/office/events/events.rpy:1923
translate russian sixsome_office_audrey_lavish_shiori_c5a32013:
    "Том" "Это может стать началом очень плодотворных отношений!"

# ch/harems_full/office/events/events.rpy:1924
translate russian sixsome_office_audrey_lavish_shiori_c87caf2a:
    "Сиори и Лавиш сейчас похожи на двух оленей, застывших в свете автомобильных фар."

# ch/harems_full/office/events/events.rpy:1925
translate russian sixsome_office_audrey_lavish_shiori_148637ec:
    "А вот Одри уже явно раздражают пожирающие её взгляды."

# ch/harems_full/office/events/events.rpy:1927
translate russian sixsome_office_audrey_lavish_shiori_1ebfed3c:
    "К счастью для меня, через мгновение она выходит вперёд и берёт дело в свои руки..."

# ch/harems_full/office/events/events.rpy:1929
translate russian sixsome_office_audrey_lavish_shiori_f99844f9:
    audrey.say "Так вот эти вялочленые, о которых ты нам рассказывал?"

# ch/harems_full/office/events/events.rpy:1930
translate russian sixsome_office_audrey_lavish_shiori_f007419c:
    audrey.say "Это их нам надо обслужить?"

# ch/harems_full/office/events/events.rpy:1931
translate russian sixsome_office_audrey_lavish_shiori_71a40285:
    mike.say "А, да, Одри. Всё верно."

# ch/harems_full/office/events/events.rpy:1932
translate russian sixsome_office_audrey_lavish_shiori_d7707b25:
    mike.say "Так что, девушки, если вы не против..."

# ch/harems_full/office/events/events.rpy:1933
translate russian sixsome_office_audrey_lavish_shiori_28e70b15:
    "В ответ на мою мольбу Одри закатывает глаза."

# ch/harems_full/office/events/events.rpy:1934
translate russian sixsome_office_audrey_lavish_shiori_4ac405bc:
    "Затем упирает руки в бока и смотрит на Сиори и Лавиш."

# ch/harems_full/office/events/events.rpy:1935
translate russian sixsome_office_audrey_lavish_shiori_d7b984d1:
    audrey.say "Ну же, вы двое."

# ch/harems_full/office/events/events.rpy:1936
translate russian sixsome_office_audrey_lavish_shiori_ddf11bbc:
    audrey.say "Давайте поскорее с этим покончим."

# ch/harems_full/office/events/events.rpy:1937
translate russian sixsome_office_audrey_lavish_shiori_f912ad20:
    audrey.say "Спорим, эти типы всё равно кончат через минуту!"

# ch/harems_full/office/events/events.rpy:1938
translate russian sixsome_office_audrey_lavish_shiori_481b08e7:
    "Сиори и Лавиш кивают, но по-прежнему ужасно нервничают."

# ch/harems_full/office/events/events.rpy:1939
translate russian sixsome_office_audrey_lavish_shiori_cca650be:
    "А Тома, Дика и Гарри мнение Одри, похоже, только забавляет."

# ch/harems_full/office/events/events.rpy:1940
translate russian sixsome_office_audrey_lavish_shiori_3f9529c7:
    "Парни из Blissard начинают развязывать галстуки и расстёгивать рубашки."

# ch/harems_full/office/events/events.rpy:1944
translate russian sixsome_office_audrey_lavish_shiori_bc450bf4:
    "Девушки же раздеваются с куда меньшим энтузиазмом."

# ch/harems_full/office/events/events.rpy:1945
translate russian sixsome_office_audrey_lavish_shiori_e2f817a8:
    "Поэтому, когда мужчины подходят за своими призами, они уже совершенно голые."

# ch/harems_full/office/events/events.rpy:1946
translate russian sixsome_office_audrey_lavish_shiori_309d9f1f:
    "Гарри берёт Лавиш за руку и, усаживаясь, направляет её к своему члену."

# ch/harems_full/office/events/events.rpy:1947
translate russian sixsome_office_audrey_lavish_shiori_eb13c032:
    "Дик без промедления укладывает Одри на пол и добирается до её киски."

# ch/harems_full/office/events/events.rpy:1948
translate russian sixsome_office_audrey_lavish_shiori_55c9b40a:
    "Но когда Том протягивает руку к Сиори, она от него отстраняется."

# ch/harems_full/office/events/events.rpy:1949
translate russian sixsome_office_audrey_lavish_shiori_e725a258:
    "Том" "Эй, не бойся меня!"

# ch/harems_full/office/events/events.rpy:1950
translate russian sixsome_office_audrey_lavish_shiori_597dae5c:
    "Том" "Просто расслабься и подумай о чём-нибудь приятном."

# ch/harems_full/office/events/events.rpy:1951
translate russian sixsome_office_audrey_lavish_shiori_dc12468c:
    "Том" "Глядишь, тебе даже понравится!"

# ch/harems_full/office/events/events.rpy:1952
translate russian sixsome_office_audrey_lavish_shiori_b8b2e496:
    "С явной неохотой Сиори позволяет отвести себя к сиденьям."

# ch/harems_full/office/events/events.rpy:1953
translate russian sixsome_office_audrey_lavish_shiori_c8e59fa2:
    "Там Том садится и устраивает её у себя на коленях."

# ch/harems_full/office/events/events.rpy:1954
translate russian sixsome_office_audrey_lavish_shiori_07e9f507:
    "Сиори остаётся только оседлать его бёдра и опуститься на член."

# ch/harems_full/office/events/events.rpy:1960
translate russian sixsome_office_audrey_lavish_shiori_87b5d6be:
    "Мне хочется протереть глаза: трудно поверить в то, что я вижу."

# ch/harems_full/office/events/events.rpy:1961
translate russian sixsome_office_audrey_lavish_shiori_8bef2868:
    "Прошло ведь меньше получаса."

# ch/harems_full/office/events/events.rpy:1962
translate russian sixsome_office_audrey_lavish_shiori_fc5d1de2:
    "А за это время Одри, Лавиш и Сиори от обычной работы в офисе перешли вот к этому!"

# ch/harems_full/office/events/events.rpy:1963
translate russian sixsome_office_audrey_lavish_shiori_97df50d4:
    "Кажется, уже никого не волнует, что сами они были совсем не в восторге от этой затеи."

# ch/harems_full/office/events/events.rpy:1964
translate russian sixsome_office_audrey_lavish_shiori_2887a202:
    "Парни из Blissard с лихвой восполняют их недостаток энтузиазма."

# ch/harems_full/office/events/events.rpy:1966
translate russian sixsome_office_audrey_lavish_shiori_7afbb815:
    "Лавиш сосёт член Гарри со всё большим усердием."

# ch/harems_full/office/events/events.rpy:1968
translate russian sixsome_office_audrey_lavish_shiori_5bda4471:
    "Дик оправдывает своё говорящее имя, безжалостно долбя киску Одри."

# ch/harems_full/office/events/events.rpy:1970
translate russian sixsome_office_audrey_lavish_shiori_1e2b52a2:
    "А Том, развлекаясь с Сиори, то и дело улыбается мне через плечо."

# ch/harems_full/office/events/events.rpy:1971
translate russian sixsome_office_audrey_lavish_shiori_82f31299:
    "Невольно думаю, какая ирония в том, чем всё закончилось."

# ch/harems_full/office/events/events.rpy:1972
translate russian sixsome_office_audrey_lavish_shiori_0b7293f2:
    "Я ведь вложил почти все свои силы в то, чтобы эта сделка состоялась."

# ch/harems_full/office/events/events.rpy:1973
translate russian sixsome_office_audrey_lavish_shiori_9de10068:
    "Но в итоге для её заключения понадобились все силы девушек!"

# ch/harems_full/office/events/events.rpy:1974
translate russian sixsome_office_audrey_lavish_shiori_a9c14ea1:
    "Я пытаюсь выдавить улыбку, убеждая себя, что всё идёт по плану."

# ch/harems_full/office/events/events.rpy:1975
translate russian sixsome_office_audrey_lavish_shiori_c904b8d4:
    "Но чем дольше стою здесь и слушаю доносящиеся отовсюду звуки, тем труднее мне это даётся."

# ch/harems_full/office/events/events.rpy:1976
translate russian sixsome_office_audrey_lavish_shiori_cafb2224:
    "Возможно, я получу премию, которую так хотел заработать."

# ch/harems_full/office/events/events.rpy:1977
translate russian sixsome_office_audrey_lavish_shiori_aebc9729:
    "Но смогу ли когда-нибудь снова взглянуть в глаза Одри, Лавиш и Сиори?"

# ch/harems_full/office/events/events.rpy:1978
translate russian sixsome_office_audrey_lavish_shiori_7f7965a0:
    "Неужели я навсегда останусь для них тем, кто продал их ради сделки?"

# ch/harems_full/office/events/events.rpy:1979
translate russian sixsome_office_audrey_lavish_shiori_65683e1d:
    "Стон кончающего Тома вырывает меня из этих мыслей."

# ch/harems_full/office/events/events.rpy:1981
translate russian sixsome_office_audrey_lavish_shiori_b46be6b8:
    "Сиори стонет и всхлипывает, пока он изливается в неё."

# ch/harems_full/office/events/events.rpy:1982
translate russian sixsome_office_audrey_lavish_shiori_c591fe2b:
    "И следом, словно дождавшись разрешения, кончают остальные."

# ch/harems_full/office/events/events.rpy:1984
translate russian sixsome_office_audrey_lavish_shiori_1b1268dc:
    "Дик забывается внутри Одри, которая всё это время едва не скребёт ногтями ковёр."

# ch/harems_full/office/events/events.rpy:1986
translate russian sixsome_office_audrey_lavish_shiori_b3826cdd:
    "Затем Гарри забрызгивает спермой щёки и нос Лавиш."

# ch/harems_full/office/events/events.rpy:1989
translate russian sixsome_office_audrey_lavish_shiori_532cf9af:
    "Закончив, они оставляют девушек в другом конце комнаты — обессиленных и тяжело дышащих."

# ch/harems_full/office/events/events.rpy:1990
translate russian sixsome_office_audrey_lavish_shiori_f6607afb:
    "Том" "Ах... фух..."

# ch/harems_full/office/events/events.rpy:1991
translate russian sixsome_office_audrey_lavish_shiori_c7f45213:
    "Том" "Уговор есть уговор, верно?"

# ch/harems_full/office/events/events.rpy:1992
translate russian sixsome_office_audrey_lavish_shiori_5bd1010c:
    "Даже не успев одеться, они подходят к столу."

# ch/harems_full/office/events/events.rpy:1993
translate russian sixsome_office_audrey_lavish_shiori_daad6d71:
    "И один за другим подписывают бумаги, как мы и договаривались."

# ch/harems_full/office/events/events.rpy:1994
translate russian sixsome_office_audrey_lavish_shiori_d926581d:
    "Всё это время мой взгляд мечется между парнями из Blissard и моими коллегами."

# ch/harems_full/office/events/events.rpy:1995
translate russian sixsome_office_audrey_lavish_shiori_cb18e8d9:
    "Одеваясь, они улыбаются и подмигивают."

# ch/harems_full/office/events/events.rpy:2000
translate russian sixsome_office_audrey_lavish_shiori_a62e7eb4:
    "А Одри, Лавиш и Сиори молча натягивают свою одежду."

# ch/harems_full/office/events/events.rpy:2001
translate russian sixsome_office_audrey_lavish_shiori_c836078b:
    "Я вымученно улыбаюсь, пытаясь скрыть раздирающие меня чувства."

# ch/harems_full/office/events/events.rpy:2002
translate russian sixsome_office_audrey_lavish_shiori_b63c1ade:
    "Да, я получил то, чего хотел."

# ch/harems_full/office/events/events.rpy:2003
translate russian sixsome_office_audrey_lavish_shiori_df285db8:
    "Но стоило ли это того, что пришлось пережить этим троим?"

# ch/harems_full/office/events/events.rpy:2012
translate russian office_harem_pimping_afterwards_cbbce559:
    "Когда чернила на договорах высыхают, а все снова одеты, обстановка кажется почти обычной."

# ch/harems_full/office/events/events.rpy:2017
translate russian office_harem_pimping_afterwards_71fcd9fd:
    "Том, Дик и Гарри начинают разговор, лишь дождавшись, когда мы останемся вчетвером."

# ch/harems_full/office/events/events.rpy:2018
translate russian office_harem_pimping_afterwards_b2102a61:
    "Немного странно, но, наверное, они не хотят обсуждать дела при посторонних."

# ch/harems_full/office/events/events.rpy:2019
translate russian office_harem_pimping_afterwards_4d506110:
    "Том тут же подходит и довольно сильно хлопает меня по спине."

# ch/harems_full/office/events/events.rpy:2020
translate russian office_harem_pimping_afterwards_28ca5385:
    "Я этого не ожидаю и невольно пошатываюсь вперёд."

# ch/harems_full/office/events/events.rpy:2021
translate russian office_harem_pimping_afterwards_a867a92b:
    "И всё же мне удаётся улыбнуться: я стараюсь выглядеть не менее довольным, чем парни из Blissard."

# ch/harems_full/office/events/events.rpy:2023
translate russian office_harem_pimping_afterwards_64bf6375:
    "Том" "Ну вот, [lssb_common.hero_name()], дело сделано!"

# ch/harems_full/office/events/events.rpy:2024
translate russian office_harem_pimping_afterwards_3945b86e:
    "Том" "И всё благодаря тебе."

# ch/harems_full/office/events/events.rpy:2025
translate russian office_harem_pimping_afterwards_ae350dfa:
    mike.say "Ну, я бы так не сказал..."

# ch/harems_full/office/events/events.rpy:2027
translate russian office_harem_pimping_afterwards_6051083e:
    "Дик" "Да брось ты эту ложную скромность, [lssb_common.hero_name()]."

# ch/harems_full/office/events/events.rpy:2028
translate russian office_harem_pimping_afterwards_56323e2e:
    "Дик" "Мы знаем, что ты с самого начала тащил всё на себе!"

# ch/harems_full/office/events/events.rpy:2029
translate russian office_harem_pimping_afterwards_97cdac1c:
    mike.say "Ну, раз вы так говорите..."

# ch/harems_full/office/events/events.rpy:2031
translate russian office_harem_pimping_afterwards_df9ffa79:
    "Гарри" "Конечно, [lssb_common.hero_name()]."

# ch/harems_full/office/events/events.rpy:2032
translate russian office_harem_pimping_afterwards_57987df3:
    "Гарри" "Без тебя из этой затеи ничего бы не вышло!"

# ch/harems_full/office/events/events.rpy:2033
translate russian office_harem_pimping_afterwards_4046456a:
    "Только сейчас, когда они собираются уходить, смысл их слов начинает до меня доходить."

# ch/harems_full/office/events/events.rpy:2034
translate russian office_harem_pimping_afterwards_d79d4cfb:
    "Наверное, они правы: всю работу с нашей стороны действительно сделал я."

# ch/harems_full/office/events/events.rpy:2035
translate russian office_harem_pimping_afterwards_35b4ea4a:
    "Может, стоит перестать скромничать и гордиться тем, что мне удалось?"

# ch/harems_full/office/events/events.rpy:2037
translate russian office_harem_pimping_afterwards_a3d0a4c8:
    "Том" "Мало у кого хватило бы яиц на то, что сделал ты."

# ch/harems_full/office/events/events.rpy:2038
translate russian office_harem_pimping_afterwards_27ae97dd:
    "Том" "Ну, учитывая, как все сейчас помешались на прогрессивности."

# ch/harems_full/office/events/events.rpy:2040
translate russian office_harem_pimping_afterwards_24f64e0a:
    "Дик" "Но тебя это не остановило, а?"

# ch/harems_full/office/events/events.rpy:2042
translate russian office_harem_pimping_afterwards_2ef8b588:
    "Гарри" "И это по-мужски, мы такое уважаем!"

# ch/harems_full/office/events/events.rpy:2043
translate russian office_harem_pimping_afterwards_8845c8ef:
    "Именно в этот момент меня накрывает чувство вины."

# ch/harems_full/office/events/events.rpy:2044
translate russian office_harem_pimping_afterwards_a9b24c20:
    "В тот миг, когда я понимаю: они вовсе не хвалят моё умение вести переговоры."

# ch/harems_full/office/events/events.rpy:2045
translate russian office_harem_pimping_afterwards_9d8b955f:
    "Их впечатлило то, что я согласился дать им развлечься."

# ch/harems_full/office/events/events.rpy:2046
translate russian office_harem_pimping_afterwards_15e5987e:
    "Что ради сделки я был готов позволить им трахнуть моих коллег!"

# ch/harems_full/office/events/events.rpy:2047
translate russian office_harem_pimping_afterwards_20bb4ea4:
    "Мне остаётся только улыбаться и кивать в надежде, что они поскорее уберутся отсюда к чёрту."

# ch/harems_full/office/events/events.rpy:2048
translate russian office_harem_pimping_afterwards_d74b603b:
    "Да, совсем скоро на мой счёт обещали перечислить солидную премию."

# ch/harems_full/office/events/events.rpy:2049
translate russian office_harem_pimping_afterwards_90781c2b:
    "Но мне ещё предстоит выйти из этой комнаты и встретиться с остальными сотрудниками."

# ch/harems_full/office/events/events.rpy:2050
translate russian office_harem_pimping_afterwards_faaa7b97:
    "К этому времени все наверняка уже знают, что здесь произошло."

# ch/harems_full/office/events/events.rpy:2051
translate russian office_harem_pimping_afterwards_74c77718:
    "Этот офис живёт сплетнями, ничего не утаишь!"

# ch/harems_full/office/events/events.rpy:2052
translate russian office_harem_pimping_afterwards_a54921f3:
    mike.say "Ха..."

# ch/harems_full/office/events/events.rpy:2053
translate russian office_harem_pimping_afterwards_b3dd411a:
    mike.say "Да, весь я!"

# ch/harems_full/office/events/events.rpy:2054
translate russian office_harem_pimping_afterwards_ec0520f9:
    mike.say "На что только не пойдёшь ради дела!"

# ch/harems_full/office/events/events.rpy:2059
translate russian office_harem_pimping_afterwards_97a71aa9:
    "Том, Дик и Гарри один за другим выходят из переговорной."

# ch/harems_full/office/events/events.rpy:2060
translate russian office_harem_pimping_afterwards_9ebf8d53:
    "Оставляя меня наедине с чувством вины."

# ch/harems_full/office/events/events.rpy:2061
translate russian office_harem_pimping_afterwards_da1e44f5:
    "Я не могу сидеть здесь вечно."

# ch/harems_full/office/events/events.rpy:2062
translate russian office_harem_pimping_afterwards_7ebdb5e0:
    "Но уверен, что рано или поздно наберусь храбрости выйти. Надеюсь, пораньше..."

# ch/harems_full/office/events/events.rpy:2077
translate russian office_audrey_shiori_showdown_15984e72:
    "Я уже привык, что каждое утро Сиори появляется в дверях с моим кофе."

# ch/harems_full/office/events/events.rpy:2078
translate russian office_audrey_shiori_showdown_80264b1b:
    "Серьёзно, по части пунктуальности она точнее швейцарских часов!"

# ch/harems_full/office/events/events.rpy:2079
translate russian office_audrey_shiori_showdown_e9cf77a5:
    "В большинстве случаев я так поглощён работой, что кофе нужен мне, как горючее, чтобы не останавливаться."

# ch/harems_full/office/events/events.rpy:2080
translate russian office_audrey_shiori_showdown_924806cb:
    "Обычно я почти не поднимаю головы, когда Сиори заходит его принести."

# ch/harems_full/office/events/events.rpy:2081
translate russian office_audrey_shiori_showdown_2abb91b9:
    "Но признаюсь: когда она уходит, я украдкой любуюсь покачиванием её попки!"

# ch/harems_full/office/events/events.rpy:2082
translate russian office_audrey_shiori_showdown_967f8822:
    "Однако сегодня утром, когда дверь открывается как раз к привычному времени подачи кофе, я поднимаю глаза."

# ch/harems_full/office/events/events.rpy:2083
translate russian office_audrey_shiori_showdown_91cffd34:
    "Ведь это не может быть Сиори: тот, кто вошёл в мой кабинет, даже не потрудился постучать."

# ch/harems_full/office/events/events.rpy:2084
translate russian office_audrey_shiori_showdown_297c8feb:
    "А Сиори всегда стучит и спрашивает разрешения войти."

# ch/harems_full/office/events/events.rpy:2086
translate russian office_audrey_shiori_showdown_b129bc33:
    audrey.say "Доброе утро, [lssb_common.hero_name()]..."

# ch/harems_full/office/events/events.rpy:2087
translate russian office_audrey_shiori_showdown_b913cc36:
    "Я почти не сомневался, кто это, ещё до того, как услышал её голос."

# ch/harems_full/office/events/events.rpy:2088
translate russian office_audrey_shiori_showdown_21940065:
    mike.say "Привет, Одри."

# ch/harems_full/office/events/events.rpy:2089
translate russian office_audrey_shiori_showdown_02ae7cd1:
    mike.say "Чем обязан удовольствию видеть тебя здесь?"

# ch/harems_full/office/events/events.rpy:2091
translate russian office_audrey_shiori_showdown_0c19b566:
    "Одри улыбается, явно уловив лёгкое раздражение в моём голосе."

# ch/harems_full/office/events/events.rpy:2093
translate russian office_audrey_shiori_showdown_3558c102:
    "Она толкает дверь пяткой, закрывая её за собой, и направляется к моему столу."

# ch/harems_full/office/events/events.rpy:2094
translate russian office_audrey_shiori_showdown_37ad64fc:
    audrey.say "Ну не будь таким, [lssb_common.hero_name()]!"

# ch/harems_full/office/events/events.rpy:2095
translate russian office_audrey_shiori_showdown_91ec5474:
    audrey.say "У меня может быть миллион вполне невинных причин зайти сюда."

# ch/harems_full/office/events/events.rpy:2097
translate russian office_audrey_shiori_showdown_af327025:
    audrey.say "И, пожалуй, несколько не таких уж невинных!"

# ch/harems_full/office/events/events.rpy:2099
translate russian office_audrey_shiori_showdown_41f13890:
    "Одри уже неторопливо подошла к столу и обогнула его сбоку."

# ch/harems_full/office/events/events.rpy:2100
translate russian office_audrey_shiori_showdown_3a94ccc0:
    "Когда она приближается, я откидываюсь в кресле и скрещиваю руки на груди."

# ch/harems_full/office/events/events.rpy:2101
translate russian office_audrey_shiori_showdown_2a0ca253:
    "Я изо всех сил стараюсь сохранить скептическое и равнодушное выражение лица."

# ch/harems_full/office/events/events.rpy:2103
translate russian office_audrey_shiori_showdown_8946cab2:
    "Но чем ближе она подходит, тем труднее мне это удаётся."

# ch/harems_full/office/events/events.rpy:2104
translate russian office_audrey_shiori_showdown_1f588598:
    mike.say "Кхм..."

# ch/harems_full/office/events/events.rpy:2105
translate russian office_audrey_shiori_showdown_fbeb9e2d:
    mike.say "Одри, мы всё-таки В ОФИСЕ."

# ch/harems_full/office/events/events.rpy:2106
translate russian office_audrey_shiori_showdown_9103b22a:
    mike.say "У тебя ко мне вообще есть какие-нибудь рабочие вопросы?"

# ch/harems_full/office/events/events.rpy:2107
translate russian office_audrey_shiori_showdown_5a4045cd:
    "Одри кивает, усаживаясь на край стола."

# ch/harems_full/office/events/events.rpy:2109
translate russian office_audrey_shiori_showdown_f338235c:
    "Затем наклоняется ближе, пока наши глаза не оказываются на одном уровне."

# ch/harems_full/office/events/events.rpy:2111
translate russian office_audrey_shiori_showdown_5551958f:
    audrey.say "Конечно, это по работе, [lssb_common.hero_name()]."

# ch/harems_full/office/events/events.rpy:2112
translate russian office_audrey_shiori_showdown_2b564fdf:
    audrey.say "Меня беспокоит только твой уровень стресса."

# ch/harems_full/office/events/events.rpy:2113
translate russian office_audrey_shiori_showdown_35a2111b:
    audrey.say "Стресс и его влияние на твою продуктивность."

# ch/harems_full/office/events/events.rpy:2114
translate russian office_audrey_shiori_showdown_c352e2f1:
    mike.say "В каком смысле, Одри?"

# ch/harems_full/office/events/events.rpy:2116
translate russian office_audrey_shiori_showdown_94d725ae:
    audrey.say "Ну..."

# ch/harems_full/office/events/events.rpy:2117
translate russian office_audrey_shiori_showdown_4440b3b5:
    audrey.say "Ты ведь пьёшь много кофе."

# ch/harems_full/office/events/events.rpy:2118
translate russian office_audrey_shiori_showdown_29bcaa6d:
    audrey.say "А от этого только хуже."

# ch/harems_full/office/events/events.rpy:2119
translate russian office_audrey_shiori_showdown_333a9efc:
    audrey.say "Вот я и подумала, что могу показать тебе другой способ снять стресс..."

# ch/harems_full/office/events/events.rpy:2120
translate russian office_audrey_shiori_showdown_fa8a4a25:
    "И тут я чувствую руку Одри у себя на паху."

# ch/harems_full/office/events/events.rpy:2121
translate russian office_audrey_shiori_showdown_9fae777c:
    "Должно быть, она незаметно опустила её туда, пока смотрела мне в глаза!"

# ch/harems_full/office/events/events.rpy:2122
translate russian office_audrey_shiori_showdown_ab78eb65:
    "Я широко раскрываю глаза и ахаю — и от неожиданности, и от ощущений."

# ch/harems_full/office/events/events.rpy:2123
translate russian office_audrey_shiori_showdown_0516dca9:
    "Одри тут же сжимает сильнее, массируя мой член сквозь брюки."

# ch/harems_full/office/events/events.rpy:2124
translate russian office_audrey_shiori_showdown_c3f31247:
    "И я просто не могу не возбудиться от её прикосновений."

# ch/harems_full/office/events/events.rpy:2126
translate russian office_audrey_shiori_showdown_f953aad5:
    audrey.say "Вот видишь! Я знала, что тебе понравится моя идея."

# ch/harems_full/office/events/events.rpy:2127
translate russian office_audrey_shiori_showdown_4c12bc5a:
    audrey.say "Без кофеина, да ещё и приятно нам обоим!"

# ch/harems_full/office/events/events.rpy:2128
translate russian office_audrey_shiori_showdown_367a7118:
    "Мгновение спустя Одри уже расстегнула мне ширинку и держит член в руке."

# ch/harems_full/office/events/events.rpy:2129
translate russian office_audrey_shiori_showdown_6a43eda4:
    "Часть меня считает, что пора её остановить."

# ch/harems_full/office/events/events.rpy:2130
translate russian office_audrey_shiori_showdown_44cbae6b:
    "Но всё остальное моё существо чуть ли не задыхается от желания позволить ей продолжить."

# ch/harems_full/office/events/events.rpy:2131
translate russian office_audrey_shiori_showdown_93efd213:
    audrey.say "Вот так, [lssb_common.hero_name()]."

# ch/harems_full/office/events/events.rpy:2132
translate russian office_audrey_shiori_showdown_3f124f2d:
    audrey.say "Просто доверься моим рукам..."

# ch/harems_full/office/events/events.rpy:2133
translate russian office_audrey_shiori_showdown_fff7fdbf:
    "И тут раздаётся стук в дверь."

# ch/harems_full/office/events/events.rpy:2134
translate russian office_audrey_shiori_showdown_d837f86e:
    "Я резко вскидываю голову, но Одри, кажется, ничуть не волнуется."

# ch/harems_full/office/events/events.rpy:2135
translate russian office_audrey_shiori_showdown_234ff8e8:
    shiori.say "Время пить кофе, [lssb_common.hero_name()]."

# ch/harems_full/office/events/events.rpy:2136
translate russian office_audrey_shiori_showdown_e896fcd3:
    shiori.say "Горячий, со сливками — как ты любишь!"

# ch/harems_full/office/events/events.rpy:2137
translate russian office_audrey_shiori_showdown_d783f573:
    mike.say "Сиори..."

# ch/harems_full/office/events/events.rpy:2140
translate russian office_audrey_shiori_showdown_7a95ecdd:
    "Услышав мой голос, Сиори открывает дверь и сразу входит."

# ch/harems_full/office/events/events.rpy:2141
translate russian office_audrey_shiori_showdown_ea7aa27c:
    "Наверное, она так привыкла получать разрешение войти, что действует на автомате!"

# ch/harems_full/office/events/events.rpy:2142
translate russian office_audrey_shiori_showdown_d1116439:
    shiori.say "Вот, держи, [lssb_common.hero_name()]."

# ch/harems_full/office/events/events.rpy:2143
translate russian office_audrey_shiori_showdown_c61a5306:
    shiori.say "Это поможет тебе не падать духом..."

# ch/harems_full/office/events/events.rpy:2145
translate russian office_audrey_shiori_showdown_2d1030b8:
    "К счастью, прежде чем вскрикнуть, Сиори прикрывает рот ладонями."

# ch/harems_full/office/events/events.rpy:2146
translate russian office_audrey_shiori_showdown_e71a23de:
    "Поэтому единственный звук — грохот выпавшего у неё подноса."

# ch/harems_full/office/events/events.rpy:2147
translate russian office_audrey_shiori_showdown_d783f573_1:
    mike.say "Сиори..."

# ch/harems_full/office/events/events.rpy:2148
translate russian office_audrey_shiori_showdown_6a7104da:
    mike.say "Боже мой..."

# ch/harems_full/office/events/events.rpy:2149
translate russian office_audrey_shiori_showdown_992ab033:
    mike.say "Это не то, что ты думаешь!"

# ch/harems_full/office/events/events.rpy:2150
translate russian office_audrey_shiori_showdown_f288e92b:
    "Что я, чёрт возьми, несу?"

# ch/harems_full/office/events/events.rpy:2151
translate russian office_audrey_shiori_showdown_43a13140:
    "Сиори надо быть полной дурой, чтобы поверить в это!"

# ch/harems_full/office/events/events.rpy:2152
translate russian office_audrey_shiori_showdown_e2c56ba4:
    "Всё именно так и выглядит: я позволяю Одри дрочить мне в моём кабинете!"

# ch/harems_full/office/events/events.rpy:2154
translate russian office_audrey_shiori_showdown_4f737eb6:
    audrey.say "Ох, Сиори, прости меня."

# ch/harems_full/office/events/events.rpy:2155
translate russian office_audrey_shiori_showdown_c612ed10:
    audrey.say "Я ПОНЯТИЯ НЕ ИМЕЛА, что ты нас застукаешь!"

# ch/harems_full/office/events/events.rpy:2156
translate russian office_audrey_shiori_showdown_2f58af61:
    "Одри звучит искренне, но её слова тут же вызывают у меня сомнения."

# ch/harems_full/office/events/events.rpy:2157
translate russian office_audrey_shiori_showdown_04529cfa:
    "Я замечаю, что при появлении Сиори она не отпустила меня и не отскочила в сторону."

# ch/harems_full/office/events/events.rpy:2158
translate russian office_audrey_shiori_showdown_0f139356:
    "Вообще-то мой член она выпустила из руки только сейчас, когда заговорила."

# ch/harems_full/office/events/events.rpy:2159
translate russian office_audrey_shiori_showdown_aa7235b7:
    "И ещё это её заявление, будто она не знала, что нас прервут."

# ch/harems_full/office/events/events.rpy:2160
translate russian office_audrey_shiori_showdown_ccc1184d:
    "Она же сама сказала, что наблюдала за тем, сколько я пью кофе."

# ch/harems_full/office/events/events.rpy:2161
translate russian office_audrey_shiori_showdown_798114c7:
    "Значит, следила и за распорядком Сиори."

# ch/harems_full/office/events/events.rpy:2162
translate russian office_audrey_shiori_showdown_bfcdc15f:
    "Как она могла не знать, что Сиори принесёт мне кофе именно сейчас?"

# ch/harems_full/office/events/events.rpy:2163
translate russian office_audrey_shiori_showdown_5d31b37b:
    "Ещё я замечаю: она извинилась за то, что Сиори нас увидела."

# ch/harems_full/office/events/events.rpy:2164
translate russian office_audrey_shiori_showdown_b566e4ff:
    "А не за то, что вообще всё это затеяла."

# ch/harems_full/office/events/events.rpy:2165
translate russian office_audrey_shiori_showdown_423ca952:
    "Но сейчас я не могу предъявить Одри свои подозрения."

# ch/harems_full/office/events/events.rpy:2166
translate russian office_audrey_shiori_showdown_2ed6488a:
    "У меня есть дела поважнее."

# ch/harems_full/office/events/events.rpy:2168
translate russian office_audrey_shiori_showdown_7553921d:
    "Во-первых, Сиори вот-вот расплачется."

# ch/harems_full/office/events/events.rpy:2169
translate russian office_audrey_shiori_showdown_6be66652:
    "А во-вторых, я сижу тут с членом наружу."

# ch/harems_full/office/events/events.rpy:2175
translate russian office_audrey_shiori_showdown_88055de9:
    "Заправив его обратно в брюки, я встаю и пытаюсь утешить Сиори."

# ch/harems_full/office/events/events.rpy:2176
translate russian office_audrey_shiori_showdown_7e192cb2:
    mike.say "Чёрт, Сиори..."

# ch/harems_full/office/events/events.rpy:2177
translate russian office_audrey_shiori_showdown_641fdcf1:
    mike.say "Я не хотел, чтобы ты так узнала о нас с Одри!"

# ch/harems_full/office/events/events.rpy:2178
translate russian office_audrey_shiori_showdown_2ac192cb:
    mike.say "Прости. Мне стоило сказать тебе раньше."

# ch/harems_full/office/events/events.rpy:2179
translate russian office_audrey_shiori_showdown_c1c56884:
    "Сиори смотрит на меня огромными глазами с покрасневшими веками."

# ch/harems_full/office/events/events.rpy:2180
translate russian office_audrey_shiori_showdown_97d85227:
    shiori.say "Я... я думала, мы..."

# ch/harems_full/office/events/events.rpy:2181
translate russian office_audrey_shiori_showdown_ed7f11b4:
    shiori.say "Я думала, что я..."

# ch/harems_full/office/events/events.rpy:2183
translate russian office_audrey_shiori_showdown_15077ca0:
    "Но тут Одри вдруг ахает."

# ch/harems_full/office/events/events.rpy:2184
translate russian office_audrey_shiori_showdown_f74da6da:
    audrey.say "Ого... так вы двое..."

# ch/harems_full/office/events/events.rpy:2185
translate russian office_audrey_shiori_showdown_46d66d00:
    audrey.say "Боже мой! Я не знала, что между вами что-то есть!"

# ch/harems_full/office/events/events.rpy:2186
translate russian office_audrey_shiori_showdown_c88af1ee:
    audrey.say "Наверное, вам обоим сейчас ТАК неловко!"

# ch/harems_full/office/events/events.rpy:2187
translate russian office_audrey_shiori_showdown_e253575e:
    "Хочется схватить что-нибудь тяжёлое и швырнуть в сторону Одри."

# ch/harems_full/office/events/events.rpy:2188
translate russian office_audrey_shiori_showdown_8533fb69:
    "Но когда она снова заговаривает, я слышу едва заметную перемену в её голосе."

# ch/harems_full/office/events/events.rpy:2189
translate russian office_audrey_shiori_showdown_128cfb7f:
    "Вместо фальшивого раскаяния в нём теперь звучит лукавство."

# ch/harems_full/office/events/events.rpy:2191
translate russian office_audrey_shiori_showdown_f1d26608:
    audrey.say "Знаете, совершенно незачем устраивать из этого драму."

# ch/harems_full/office/events/events.rpy:2192
translate russian office_audrey_shiori_showdown_78fe95d0:
    audrey.say "Мы ведь все взрослые люди."

# ch/harems_full/office/events/events.rpy:2193
translate russian office_audrey_shiori_showdown_f5b9358b:
    audrey.say "И на дворе всё-таки двадцать первый век..."

# ch/harems_full/office/events/events.rpy:2195
translate russian office_audrey_shiori_showdown_4b269025:
    shiori.say "Ч... что ты хочешь сказать, Одри?"

# ch/harems_full/office/events/events.rpy:2196
translate russian office_audrey_shiori_showdown_0e5b6c0f:
    mike.say "Да, Одри, к чему ты клонишь?"

# ch/harems_full/office/events/events.rpy:2198
translate russian office_audrey_shiori_showdown_cacbb9d0:
    "Одри с улыбкой подходит к нам с Сиори."

# ch/harems_full/office/events/events.rpy:2204
translate russian office_audrey_shiori_showdown_c4903fc9:
    "Одной рукой она обнимает за талию меня, другой — Сиори."

# ch/harems_full/office/events/events.rpy:2209
translate russian office_audrey_shiori_showdown_05c92e55:
    "А затем притягивает нас обоих к себе."

# ch/harems_full/office/events/events.rpy:2211
translate russian office_audrey_shiori_showdown_fb3c12a8:
    audrey.say "Я хочу сказать, что мы можем устроить всё так, чтобы всем было хорошо."

# ch/harems_full/office/events/events.rpy:2212
translate russian office_audrey_shiori_showdown_61853b0b:
    audrey.say "Сиори, нам обеим нравится [lssb_common.hero_name()]."

# ch/harems_full/office/events/events.rpy:2213
translate russian office_audrey_shiori_showdown_5e99fb17:
    audrey.say "[lssb_common.hero_name()], я знаю, что тебе тоже нравимся мы обе."

# ch/harems_full/office/events/events.rpy:2214
translate russian office_audrey_shiori_showdown_f0f7c838:
    audrey.say "Ну и..."

# ch/harems_full/office/events/events.rpy:2215
translate russian office_audrey_shiori_showdown_c4f8d652:
    audrey.say "Твои чары на меня тоже действуют, Сиори..."

# ch/harems_full/office/events/events.rpy:2216
translate russian office_audrey_shiori_showdown_771656b3:
    "Одри делает многозначительную паузу, томно улыбаясь Сиори."

# ch/harems_full/office/events/events.rpy:2217
translate russian office_audrey_shiori_showdown_e809d2ff:
    "И даже такая наивная и невинная девушка, как Сиори, не может не понять намёк."

# ch/harems_full/office/events/events.rpy:2219
translate russian office_audrey_shiori_showdown_e42c3261:
    "Щёки Сиори мгновенно заливает краска, и она отводит взгляд от Одри."

# ch/harems_full/office/events/events.rpy:2220
translate russian office_audrey_shiori_showdown_5a50e29e:
    shiori.say "Я... я бы никогда..."

# ch/harems_full/office/events/events.rpy:2221
translate russian office_audrey_shiori_showdown_fb0bc634:
    shiori.say "Только... только если..."

# ch/harems_full/office/events/events.rpy:2223
translate russian office_audrey_shiori_showdown_05974b25:
    shiori.say "Если ты этого хочешь, [lssb_common.hero_name()]?"

# ch/harems_full/office/events/events.rpy:2225
translate russian office_audrey_shiori_showdown_eba8a7db:
    "Я вдруг вспоминаю, насколько Сиори на самом деле покорна и послушна."

# ch/harems_full/office/events/events.rpy:2226
translate russian office_audrey_shiori_showdown_d350d4a3:
    "Готов поспорить, стоит мне предложить..."

# ch/harems_full/office/events/events.rpy:2227
translate russian office_audrey_shiori_showdown_620f65fb:
    mike.say "Вообще-то, Сиори..."

# ch/harems_full/office/events/events.rpy:2228
translate russian office_audrey_shiori_showdown_d87f5df9:
    mike.say "По-моему, у Одри отличная идея."

# ch/harems_full/office/events/events.rpy:2229
translate russian office_audrey_shiori_showdown_d6249972:
    mike.say "Так каждый получит то, чего хочет, и никто не останется в стороне."

# ch/harems_full/office/events/events.rpy:2231
translate russian office_audrey_shiori_showdown_70b351dd:
    "Я ещё никогда не видел, чтобы Сиори так широко раскрывала глаза."

# ch/harems_full/office/events/events.rpy:2232
translate russian office_audrey_shiori_showdown_6e5bb3e0:
    "И почти уверен, что она даже дрожит от волнения."

# ch/harems_full/office/events/events.rpy:2234
translate russian office_audrey_shiori_showdown_e84b4c77:
    "Но всё же послушно кивает."

# ch/harems_full/office/events/events.rpy:2235
translate russian office_audrey_shiori_showdown_51ded138:
    "А затем склоняет голову, показывая, что принимает моё решение."

# ch/harems_full/office/events/events.rpy:2237
translate russian office_audrey_shiori_showdown_21c693b3:
    shiori.say "Д... да, [lssb_common.hero_name()]."

# ch/harems_full/office/events/events.rpy:2238
translate russian office_audrey_shiori_showdown_18e38a5b:
    shiori.say "Я сделаю, как ты хочешь."

# ch/harems_full/office/events/events.rpy:2239
translate russian office_audrey_shiori_showdown_6cc8d84a:
    "Одри толкает Сиори локтем в бок."

# ch/harems_full/office/events/events.rpy:2241
translate russian office_audrey_shiori_showdown_25fa2430:
    "На лице у неё озорное выражение."

# ch/harems_full/office/events/events.rpy:2242
translate russian office_audrey_shiori_showdown_3414c25e:
    audrey.say "Да ладно тебе, Сиори."

# ch/harems_full/office/events/events.rpy:2243
translate russian office_audrey_shiori_showdown_6ad22acb:
    audrey.say "У тебя такой вид, будто тебе сообщили плохие новости."

# ch/harems_full/office/events/events.rpy:2244
translate russian office_audrey_shiori_showdown_991b2c32:
    audrey.say "Нам всем будет весело, подруга!"

# ch/harems_full/office/events/events.rpy:2245
translate russian office_audrey_shiori_showdown_dff0439d:
    audrey.say "В конце концов, двое — это пара, а трое — уже оргия!"

# ch/harems_full/office/events/events.rpy:2246
translate russian office_audrey_shiori_showdown_5558fb37:
    "Сиори поднимает глаза и робко улыбается."

# ch/harems_full/office/events/events.rpy:2247
translate russian office_audrey_shiori_showdown_44197a28:
    "Но я вижу, что мысль о сексе втроём всё ещё её пугает."

# ch/harems_full/office/events/events.rpy:2248
translate russian office_audrey_shiori_showdown_f15ce808:
    mike.say "Знаешь что, Одри?"

# ch/harems_full/office/events/events.rpy:2249
translate russian office_audrey_shiori_showdown_32ed58c1:
    mike.say "Почему бы вам с Сиори не закончить то, что ты начала?"

# ch/harems_full/office/events/events.rpy:2250
translate russian office_audrey_shiori_showdown_c2237876:
    mike.say "Может, именно такое занятие поможет вам сблизиться."

# ch/harems_full/office/events/events.rpy:2252
translate russian office_audrey_shiori_showdown_a6afae2e:
    "Сиори удивлённо смотрит на меня, едва не качая головой."

# ch/harems_full/office/events/events.rpy:2253
translate russian office_audrey_shiori_showdown_ed80065d:
    "А на лице Одри написано полное согласие."

# ch/harems_full/office/events/events.rpy:2255
translate russian office_audrey_shiori_showdown_3eff3bd8:
    audrey.say "Отличная мысль, [lssb_common.hero_name()]!"

# ch/harems_full/office/events/events.rpy:2256
translate russian office_audrey_shiori_showdown_03543150:
    audrey.say "Давай, Сиори, приступим!"

# ch/harems_full/office/events/events.rpy:2257
translate russian office_audrey_shiori_showdown_d712bca9:
    "Не дав ей сказать ни слова, Одри берёт девушку за запястье."

# ch/harems_full/office/events/events.rpy:2259
translate russian office_audrey_shiori_showdown_4028a96b:
    "И направляет руку Сиори мне ниже пояса."

# ch/harems_full/office/events/events.rpy:2260
translate russian office_audrey_shiori_showdown_c6b0b0da:
    "Когда девушки встают по обе стороны от меня, Сиори кивает."

# ch/harems_full/office/events/events.rpy:2261
translate russian office_audrey_shiori_showdown_a629bda0:
    "Одри тут же расстёгивает мои брюки и достаёт член."

# ch/harems_full/office/events/events.rpy:2262
translate russian office_audrey_shiori_showdown_1758edc0:
    "Сиори смотрит на меня снизу вверх, и я ей киваю."

# ch/harems_full/office/events/events.rpy:2264
translate russian office_audrey_shiori_showdown_754b3c4e:
    "Она улыбается — на этот раз, кажется, искреннее — и кивает в ответ."

# ch/harems_full/office/events/events.rpy:2265
translate russian office_audrey_shiori_showdown_4624cfb8:
    "Я откидываю голову, чувствуя себя королём, обозревающим свои владения."

# ch/harems_full/office/events/events.rpy:2266
translate russian office_audrey_shiori_showdown_8dd62727:
    "Одри ласкает мой член со своим обычным мастерством."

# ch/harems_full/office/events/events.rpy:2267
translate russian office_audrey_shiori_showdown_8207037d:
    "Она действует грубо, но в меру."

# ch/harems_full/office/events/events.rpy:2268
translate russian office_audrey_shiori_showdown_e9d69a5e:
    "А Сиори следует её примеру, осторожно прикасаясь ко мне, когда ей велят."

# ch/harems_full/office/events/events.rpy:2269
translate russian office_audrey_shiori_showdown_70ba152f:
    "Возможно, всё дело в том, что я вижу их за совместным занятием."

# ch/harems_full/office/events/events.rpy:2270
translate russian office_audrey_shiori_showdown_1f283a1c:
    "Вижу, как Сиори улыбается всё шире и забывает о смущении."

# ch/harems_full/office/events/events.rpy:2271
translate russian office_audrey_shiori_showdown_66402466:
    "Может, именно поэтому я так быстро достигаю предела?"

# ch/harems_full/office/events/events.rpy:2273
translate russian office_audrey_shiori_showdown_e43e317f:
    "Мгновение спустя я изливаюсь, не в силах сдержать улыбку."

# ch/harems_full/office/events/events.rpy:2274
translate russian office_audrey_shiori_showdown_06e39cfc:
    "И смотрю, как сперма стекает по пальцам Одри и Сиори."

# ch/harems_full/office/events/events.rpy:2277
translate russian office_audrey_shiori_showdown_3263a1a0:
    "Одри разражается смехом, а Сиори выглядит потрясённой."

# ch/harems_full/office/events/events.rpy:2279
translate russian office_audrey_shiori_showdown_4f84e825:
    "Но потом она тоже начинает смеяться, и всё встаёт на свои места."

# ch/harems_full/office/events/events.rpy:2280
translate russian office_audrey_shiori_showdown_b76a534e:
    "Может, Одри права."

# ch/harems_full/office/events/events.rpy:2281
translate russian office_audrey_shiori_showdown_72862902:
    "Может, для нас троих это и правда лучший выход..."

# ch/harems_full/office/events/events.rpy:2285
translate russian office_audrey_shiori_showdown_357d890d:
    "Втайне я сейчас благодарен Сиори за её кротость и послушание."

# ch/harems_full/office/events/events.rpy:2286
translate russian office_audrey_shiori_showdown_7df6537c:
    "Главным образом потому, что она снова отдала право выбора мне."

# ch/harems_full/office/events/events.rpy:2287
translate russian office_audrey_shiori_showdown_758b2cf8:
    "Одри нужно приструнить, заставить слушаться."

# ch/harems_full/office/events/events.rpy:2288
translate russian office_audrey_shiori_showdown_cc8ea9fd:
    "И первым делом — пресечь эту проблему в зародыше!"

# ch/harems_full/office/events/events.rpy:2289
translate russian office_audrey_shiori_showdown_8af67e86:
    mike.say "Нет, Сиори."

# ch/harems_full/office/events/events.rpy:2290
translate russian office_audrey_shiori_showdown_d049c17a:
    mike.say "Я этого не хочу."

# ch/harems_full/office/events/events.rpy:2291
translate russian office_audrey_shiori_showdown_6150ebeb:
    mike.say "Иди пока, а мы поговорим позже."

# ch/harems_full/office/events/events.rpy:2293
translate russian office_audrey_shiori_showdown_94ad90ec:
    "Сиори тут же испытывает облегчение и принимается собирать с пола содержимое подноса."

# ch/harems_full/office/events/events.rpy:2294
translate russian office_audrey_shiori_showdown_33f9513c:
    "Я слышу, как Одри начинает возражать, но реакция Сиори придала мне уверенности."

# ch/harems_full/office/events/events.rpy:2295
translate russian office_audrey_shiori_showdown_25350514:
    "Я поворачиваюсь к Одри и обрываю её прежде, чем она успевает что-то сказать."

# ch/harems_full/office/events/events.rpy:2296
translate russian office_audrey_shiori_showdown_c016944b:
    mike.say "А что до тебя, Одри..."

# ch/harems_full/office/events/events.rpy:2297
translate russian office_audrey_shiori_showdown_71885703:
    mike.say "Ты можешь ненадолго задержаться."

# ch/harems_full/office/events/events.rpy:2298
translate russian office_audrey_shiori_showdown_4073ee25:
    mike.say "Нам ведь нужно кое-что закончить..."

# ch/harems_full/office/events/events.rpy:2306
translate russian office_audrey_shiori_showdown_130924ec:
    "Пока Сиори торопливо выходит из кабинета, я возвращаюсь к столу."

# ch/harems_full/office/events/events.rpy:2307
translate russian office_audrey_shiori_showdown_15910ecf:
    "Одри скрещивает руки на груди и раздражённо фыркает."

# ch/harems_full/office/events/events.rpy:2309
translate russian office_audrey_shiori_showdown_08761156:
    audrey.say "А ведь могло быть очень весело!"

# ch/harems_full/office/events/events.rpy:2310
translate russian office_audrey_shiori_showdown_b3fe8bdc:
    audrey.say "Всем троим было бы хорошо!"

# ch/harems_full/office/events/events.rpy:2311
translate russian office_audrey_shiori_showdown_2977b103:
    "Я медленно качаю головой, отмахиваясь от жалоб Одри."

# ch/harems_full/office/events/events.rpy:2312
translate russian office_audrey_shiori_showdown_5c38d326:
    mike.say "Да, Одри, я знаю."

# ch/harems_full/office/events/events.rpy:2313
translate russian office_audrey_shiori_showdown_b1ae364e:
    mike.say "Но тогда всё было бы по-твоему."

# ch/harems_full/office/events/events.rpy:2314
translate russian office_audrey_shiori_showdown_eb16da8c:
    mike.say "И ты всегда держала бы нас в руках."

# ch/harems_full/office/events/events.rpy:2315
translate russian office_audrey_shiori_showdown_a8503cf7:
    mike.say "А так я могу утешить Сиори и сохранить её расположение."

# ch/harems_full/office/events/events.rpy:2316
translate russian office_audrey_shiori_showdown_5ae649d8:
    mike.say "И тогда вы обе будете моими, когда я захочу."

# ch/harems_full/office/events/events.rpy:2318
translate russian office_audrey_shiori_showdown_1db1ba11:
    "Одри изо всех сил пытается скрыть удивление от этой мысли."

# ch/harems_full/office/events/events.rpy:2319
translate russian office_audrey_shiori_showdown_f23b4c82:
    "Я знаю, ей нравится чувствовать, что всё под её контролем."

# ch/harems_full/office/events/events.rpy:2320
translate russian office_audrey_shiori_showdown_06603836:
    "Но ещё я знаю, как сильно её возбуждает возможность заниматься этим на работе!"

# ch/harems_full/office/events/events.rpy:2321
translate russian office_audrey_shiori_showdown_94d725ae_1:
    audrey.say "Ну..."

# ch/harems_full/office/events/events.rpy:2322
translate russian office_audrey_shiori_showdown_a264cb00:
    audrey.say "С чего ты взял, что можешь получить нас обеих, а?"

# ch/harems_full/office/events/events.rpy:2323
translate russian office_audrey_shiori_showdown_407bb8fe:
    "Вместо ответа я расстёгиваю ширинку."

# ch/harems_full/office/events/events.rpy:2324
translate russian office_audrey_shiori_showdown_93d228b9:
    mike.say "Помнишь, я сказал Сиори, что нам нужно кое-что закончить?"

# ch/harems_full/office/events/events.rpy:2325
translate russian office_audrey_shiori_showdown_11f243da:
    mike.say "Так вот, иди сюда и заканчивай начатое!"

# ch/harems_full/office/events/events.rpy:2326
translate russian office_audrey_shiori_showdown_1375b48f:
    "На мгновение мне кажется, что Одри сейчас пошлёт меня к чёрту."

# ch/harems_full/office/events/events.rpy:2328
translate russian office_audrey_shiori_showdown_a8e6e82e:
    "Но она лишь качает головой и спешит выполнить приказ."

# ch/harems_full/office/events/events.rpy:2329
translate russian office_audrey_shiori_showdown_cc029c38:
    "Всё это время она что-то ворчит, но меня это не отвлекает."

# ch/harems_full/office/events/events.rpy:2330
translate russian office_audrey_shiori_showdown_fa3e2eb3:
    "Наоборот, командовать Одри так приятно, что удовольствие становится только сильнее!"

# ch/harems_full/office/events/events.rpy:2331
translate russian office_audrey_shiori_showdown_8dd62727_1:
    "Одри ласкает мой член со своим обычным мастерством."

# ch/harems_full/office/events/events.rpy:2332
translate russian office_audrey_shiori_showdown_8207037d_1:
    "Она действует грубо, но в меру."

# ch/harems_full/office/events/events.rpy:2333
translate russian office_audrey_shiori_showdown_052d2127:
    "Но в итоге именно обида в её глазах доводит меня до предела."

# ch/harems_full/office/events/events.rpy:2335
translate russian office_audrey_shiori_showdown_e43e317f_1:
    "Мгновение спустя я изливаюсь, не в силах сдержать улыбку."

# ch/harems_full/office/events/events.rpy:2336
translate russian office_audrey_shiori_showdown_ae3fc714:
    "И смотрю, как сперма стекает по пальцам Одри."

# ch/harems_full/office/events/events.rpy:2337
translate russian office_audrey_shiori_showdown_6f71173a:
    "И всё это время чувствую, что ещё и сумел поставить её на место!"

# ch/harems_full/office/events/events.rpy:2347
translate russian office_audrey_shiori_02_72262f69:
    "В последнее время я так поглощён работой, что ни о чём другом не думаю."

# ch/harems_full/office/events/events.rpy:2348
translate russian office_audrey_shiori_02_2c3d2da0:
    "Поэтому, подняв глаза и увидев в дверях Одри и Сиори, я искренне удивляюсь."

# ch/harems_full/office/events/events.rpy:2349
translate russian office_audrey_shiori_02_3beb221e:
    "Быстро взглянув на часы, я качаю головой и задаю напрашивающийся вопрос."

# ch/harems_full/office/events/events.rpy:2354
translate russian office_audrey_shiori_02_2ca75ee1:
    mike.say "Разве вы ещё не приносили мне утренний кофе?"

# ch/harems_full/office/events/events.rpy:2356
translate russian office_audrey_shiori_02_25437292:
    "На лице Одри тут же появляется смесь раздражения и недоумения."

# ch/harems_full/office/events/events.rpy:2358
translate russian office_audrey_shiori_02_b0bd4333:
    "А Сиори прикрывает рот ладонью и хихикает над моим вопросом."

# ch/harems_full/office/events/events.rpy:2359
translate russian office_audrey_shiori_02_c3f0df99:
    shiori.say "Ох, [lssb_common.hero_name()]."

# ch/harems_full/office/events/events.rpy:2360
translate russian office_audrey_shiori_02_c12aeebb:
    shiori.say "Какой же ты смешной!"

# ch/harems_full/office/events/events.rpy:2361
translate russian office_audrey_shiori_02_b72a8e22:
    shiori.say "Я уже приносила тебе кофе!"

# ch/harems_full/office/events/events.rpy:2362
translate russian office_audrey_shiori_02_6b5f410a:
    audrey.say "Да, [lssb_common.hero_name()], с тобой просто обхохочешься."

# ch/harems_full/office/events/events.rpy:2363
translate russian office_audrey_shiori_02_9744abbc:
    audrey.say "Тебе бы в стендап!"

# ch/harems_full/office/events/events.rpy:2366
translate russian office_audrey_shiori_02_b162da98:
    "С этими словами Одри захлопывает дверь и запирает её."

# ch/harems_full/office/events/events.rpy:2367
translate russian office_audrey_shiori_02_91e880a5:
    "Только тогда я выныриваю из своих мыслей."

# ch/harems_full/office/events/events.rpy:2368
translate russian office_audrey_shiori_02_ea2c734b:
    "Теперь-то я понимаю, зачем они пришли!"

# ch/harems_full/office/events/events.rpy:2370
translate russian office_audrey_shiori_02_ac942e0d:
    mike.say "А, теперь понял!"

# ch/harems_full/office/events/events.rpy:2371
translate russian office_audrey_shiori_02_8e79944d:
    mike.say "Вы двое хотите..."

# ch/harems_full/office/events/events.rpy:2375
translate russian office_audrey_shiori_02_1c31d40a:
    "Одри кивает, подходя к моему столу."

# ch/harems_full/office/events/events.rpy:2376
translate russian office_audrey_shiori_02_9d85512a:
    mike.say "Со мной..."

# ch/harems_full/office/events/events.rpy:2382
translate russian office_audrey_shiori_02_c8d5f8df:
    "Сиори тоже кивает, шагая рядом с Одри."

# ch/harems_full/office/events/events.rpy:2383
translate russian office_audrey_shiori_02_e3bf7048:
    mike.say "Прямо здесь и сейчас!"

# ch/harems_full/office/events/events.rpy:2385
translate russian office_audrey_shiori_02_71b8d8ee:
    audrey.say "Да, [lssb_common.hero_name()], хотим."

# ch/harems_full/office/events/events.rpy:2387
translate russian office_audrey_shiori_02_7aac1942:
    shiori.say "Одри сказала, что тебе будет приятно получить такой сюрприз!"

# ch/harems_full/office/events/events.rpy:2388
translate russian office_audrey_shiori_02_3b749726:
    audrey.say "Если, конечно, ты не слишком занят..."

# ch/harems_full/office/events/events.rpy:2389
translate russian office_audrey_shiori_02_005f63f9:
    "Я вскакиваю с кресла так быстро, как только могу."

# ch/harems_full/office/events/events.rpy:2390
translate russian office_audrey_shiori_02_51e74e7b:
    "И спешу навстречу обеим."

# ch/harems_full/office/events/events.rpy:2392
translate russian office_audrey_shiori_02_6bed7c5d:
    mike.say "Думаю, в моём расписании найдётся окошко!"

# ch/harems_full/office/events/events.rpy:2393
translate russian office_audrey_shiori_02_a899fed9:
    audrey.say "Давай мы его заполним."

# ch/harems_full/office/events/events.rpy:2394
translate russian office_audrey_shiori_02_a92fdb09:
    audrey.say "А ты взамен заполнишь одну из нас!"

# ch/harems_full/office/events/events.rpy:2395
translate russian office_audrey_shiori_02_ae224d4c:
    "Сиори снова прикрывает рот ладонью и хихикает."

# ch/harems_full/office/events/events.rpy:2399
translate russian office_audrey_shiori_02_ed7c8e29:
    "Но мы втроём уже раздеваемся в предвкушении продолжения."

# ch/harems_full/office/events/events.rpy:2400
translate russian office_audrey_shiori_02_07c3d9f9:
    "Так и хочется дать себе пощёчину!"

# ch/harems_full/office/events/events.rpy:2401
translate russian office_audrey_shiori_02_addbbc98:
    "Как я мог забыть, что мы втроём решили вот так встречаться?"

# ch/harems_full/office/events/events.rpy:2405
translate russian office_audrey_shiori_02_4070b5a8:
    "Глядя на Одри и Сиори, я напрочь забываю о работе на столе."

# ch/harems_full/office/events/events.rpy:2406
translate russian office_audrey_shiori_02_8f159624:
    "И уже чувствую, как от мыслей о том, что нас ждёт, у меня встаёт."

# ch/harems_full/office/events/events.rpy:2407
translate russian office_audrey_shiori_02_25e22607:
    "Остаётся только решить, кому он достанется."

# ch/harems_full/office/events/events.rpy:2408
translate russian office_audrey_shiori_02_bdb8cc57:
    "Одри или Сиори?"

# ch/harems_full/office/events/events.rpy:2423
translate russian office_threesome_shiorifuck_audrey_78734ce9:
    "Я долго и пристально рассматриваю обнажённую Одри."

# ch/harems_full/office/events/events.rpy:2424
translate russian office_threesome_shiorifuck_audrey_7e9cfce9:
    "Но стоит отвести от неё глаза и взглянуть на Сиори, как выбор сделан."

# ch/harems_full/office/events/events.rpy:2425
translate russian office_threesome_shiorifuck_audrey_a4d8f440:
    "Она стоит передо мной такая милая и невинная."

# ch/harems_full/office/events/events.rpy:2426
translate russian office_threesome_shiorifuck_audrey_8e723172:
    "И вдруг я больше всего на свете хочу оказаться внутри неё!"

# ch/harems_full/office/events/events.rpy:2427
translate russian office_threesome_shiorifuck_audrey_d783f573:
    mike.say "Сиори..."

# ch/harems_full/office/events/events.rpy:2428
translate russian office_threesome_shiorifuck_audrey_f741a9db:
    mike.say "Иди сюда..."

# ch/harems_full/office/events/events.rpy:2430
translate russian office_threesome_shiorifuck_audrey_b4930bcd:
    "Я вижу, как глаза Сиори расширяются, и она удивлённо ахает."

# ch/harems_full/office/events/events.rpy:2431
translate russian office_threesome_shiorifuck_audrey_7c1d9e06:
    "Конечно, от этого я лишь сильнее её хочу."

# ch/harems_full/office/events/events.rpy:2433
translate russian office_threesome_shiorifuck_audrey_833162a9:
    "Поборов свой страх, она кивает и протягивает руку, чтобы взять меня за ладонь."

# ch/harems_full/office/events/events.rpy:2434
translate russian office_threesome_shiorifuck_audrey_54bc31d6:
    "Я отчасти ожидал, что Одри начнёт возмущаться, ведь я выбрал не её."

# ch/harems_full/office/events/events.rpy:2435
translate russian office_threesome_shiorifuck_audrey_d4125402:
    "Но она ведёт себя безупречно и улыбается, пока Сиори подходит ко мне."

# ch/harems_full/office/events/events.rpy:2436
translate russian office_threesome_shiorifuck_audrey_315708b9:
    "Я сажусь на край стола и широко развожу ноги."

# ch/harems_full/office/events/events.rpy:2437
translate russian office_threesome_shiorifuck_audrey_f6b54f27:
    "Затем поворачиваю Сиори к себе спиной."

# ch/harems_full/office/events/events.rpy:2438
translate russian office_threesome_shiorifuck_audrey_40682b4f:
    "Она оглядывается через плечо, прикусывая губу в предвкушении."

# ch/harems_full/office/events/events.rpy:2439
translate russian office_threesome_shiorifuck_audrey_1f166abe:
    "Но сейчас мои мысли заняты совсем другим."

# ch/harems_full/office/events/events.rpy:2440
translate russian office_threesome_shiorifuck_audrey_f7a2dd83:
    "Ведь Сиори прямо передо мной, готовая отдаться."

# ch/harems_full/office/events/events.rpy:2442
translate russian office_threesome_shiorifuck_audrey_a3294a3c:
    "Осталось решить, куда я хочу его вставить..."

# ch/harems_full/office/events/events.rpy:2445
translate russian office_threesome_shiorifuck_audrey_a8e06d37:
    "Я знаю, что Сиори сильно нервничает."

# ch/harems_full/office/events/events.rpy:2446
translate russian office_threesome_shiorifuck_audrey_78127739:
    "Но мы и так занимаемся сексом втроём у меня в кабинете."

# ch/harems_full/office/events/events.rpy:2447
translate russian office_threesome_shiorifuck_audrey_ad96aa80:
    "Да ещё посреди дня!"

# ch/harems_full/office/events/events.rpy:2448
translate russian office_threesome_shiorifuck_audrey_a7b88f27:
    "Так зачем сдерживаться?"

# ch/harems_full/office/events/events.rpy:2449
translate russian office_threesome_shiorifuck_audrey_2d49f5d2:
    "Почему бы не сделать всё ещё острее?"

# ch/harems_full/office/events/events.rpy:2450
translate russian office_threesome_shiorifuck_audrey_80fc2cfd:
    "С этой мыслью я протягиваю руки и крепко сжимаю округлые ягодицы Сиори."

# ch/harems_full/office/events/events.rpy:2451
translate russian office_threesome_shiorifuck_audrey_f263dd01:
    "Она искренне удивлённо взвизгивает и чуть подаётся вперёд."

# ch/harems_full/office/events/events.rpy:2452
translate russian office_threesome_shiorifuck_audrey_caa051d2:
    "Но я не даю ей ускользнуть."

# ch/harems_full/office/events/events.rpy:2453
translate russian office_threesome_shiorifuck_audrey_d936c482:
    "Ухватив её, я тяну назад и насаживаю на свой член."

# ch/harems_full/office/events/events.rpy:2455
translate russian office_threesome_shiorifuck_audrey_6afc0448:
    "Она такая же тугая, как я и ожидал, но от этого лишь острее ощущения."

# ch/harems_full/office/events/events.rpy:2456
translate russian office_threesome_shiorifuck_audrey_4c686b24:
    "Я продолжаю входить в неё, не обращая внимания на сопротивление мышц."

# ch/harems_full/office/events/events.rpy:2457
translate russian office_threesome_shiorifuck_audrey_c102a48f:
    shiori.say "Ох..."

# ch/harems_full/office/events/events.rpy:2458
translate russian office_threesome_shiorifuck_audrey_f86a3464:
    shiori.say "Ох, [lssb_common.hero_name()]..."

# ch/harems_full/office/events/events.rpy:2459
translate russian office_threesome_shiorifuck_audrey_98955617:
    shiori.say "Это... это моя попа!"

# ch/harems_full/office/events/events.rpy:2460
translate russian office_threesome_shiorifuck_audrey_640642b3:
    "Сиори чувственно стонет, когда её мышцы наконец поддаются."

# ch/harems_full/office/events/events.rpy:2462
translate russian office_threesome_shiorifuck_audrey_75093b1b:
    "Она опускается на мой член, и от этого ощущения я едва не кончаю прямо сейчас!"

# ch/harems_full/office/events/events.rpy:2463
translate russian office_threesome_shiorifuck_audrey_568b15da:
    shiori.say "М-м-м..."

# ch/harems_full/office/events/events.rpy:2464
translate russian office_threesome_shiorifuck_audrey_304c2143:
    shiori.say "[lssb_common.hero_name()]..."

# ch/harems_full/office/events/events.rpy:2465
translate russian office_threesome_shiorifuck_audrey_4a0fae35:
    shiori.say "Что ты со мной делаешь?!"

# ch/harems_full/office/events/events.rpy:2466
translate russian office_threesome_shiorifuck_audrey_2295c25b:
    shiori.say "Не знаю, что это, но не останавливайся!"

# ch/harems_full/office/events/events.rpy:2467
translate russian office_threesome_shiorifuck_audrey_fddc5772:
    shiori.say "Мне так нравится!"

# ch/harems_full/office/events/events.rpy:2468
translate russian office_threesome_shiorifuck_audrey_d6d116e9:
    "Повинуясь внезапной мысли, я наклоняюсь вперёд и просовываю руки под бёдра Сиори."

# ch/harems_full/office/events/events.rpy:2469
translate russian office_threesome_shiorifuck_audrey_afac109f:
    "Она снова взвизгивает, когда я поднимаю её в воздух, оставаясь глубоко внутри."

# ch/harems_full/office/events/events.rpy:2470
translate russian office_threesome_shiorifuck_audrey_10530ca7:
    "Держа Сиори на руках, я складываю её пополам и сцепляю пальцы у неё за головой."

# ch/harems_full/office/events/events.rpy:2471
translate russian office_threesome_shiorifuck_audrey_c7807dff:
    "Затем откидываюсь над столом и начинаю поднимать и опускать её на своём члене."

# ch/harems_full/office/events/events.rpy:2472
translate russian office_threesome_shiorifuck_audrey_a4a7a759:
    "Всё это время Сиори беспомощно стонет от удовольствия."

# ch/harems_full/office/events/events.rpy:2474
translate russian office_threesome_shiorifuck_audrey_f560d19b:
    "Я почти забыл, что Одри всё ещё здесь, с нами."

# ch/harems_full/office/events/events.rpy:2476
translate russian office_threesome_shiorifuck_audrey_64299c97:
    "Но она не из тех, кто останется в стороне и позволит о себе забыть."

# ch/harems_full/office/events/events.rpy:2478
translate russian office_threesome_shiorifuck_audrey_81227844:
    "Теперь моя очередь вздрогнуть от неожиданности: я чувствую, как она сосёт мои яйца!"

# ch/harems_full/office/events/events.rpy:2479
translate russian office_threesome_shiorifuck_audrey_3b44899e:
    "От этого движения Сиори на мгновение подскакивает."

# ch/harems_full/office/events/events.rpy:2480
translate russian office_threesome_shiorifuck_audrey_b0259fb1:
    "Затем опускается обратно, насаживаясь на мой член ещё сильнее."

# ch/harems_full/office/events/events.rpy:2481
translate russian office_threesome_shiorifuck_audrey_9f2c1358:
    "Я слышу что-то похожее на озорной смешок Одри, после чего она удваивает старания."

# ch/harems_full/office/events/events.rpy:2482
translate russian office_threesome_shiorifuck_audrey_20205264:
    "И в результате я трахаю Сиори ещё сильнее!"

# ch/harems_full/office/events/events.rpy:2483
translate russian office_threesome_shiorifuck_audrey_6ba6478c:
    "Хотя я крепко её держу, она начинает извиваться и ёрзать."

# ch/harems_full/office/events/events.rpy:2484
translate russian office_threesome_shiorifuck_audrey_6de1bb4a:
    "Мгновение спустя я понимаю, что она кончает."

# ch/harems_full/office/events/events.rpy:2485
translate russian office_threesome_shiorifuck_audrey_2cc8ae2a:
    "Пока Одри ласкает мои яйца, а Сиори трётся о мой член, я больше не могу сдерживаться."

# ch/harems_full/office/events/events.rpy:2486
translate russian office_threesome_shiorifuck_audrey_57264772:
    "Я тоже сейчас кончу!"

# ch/harems_full/office/events/events.rpy:2492
translate russian office_threesome_shiorifuck_audrey_aced3f6b:
    "С последним толчком я изливаюсь в Сиори."

# ch/harems_full/office/events/events.rpy:2493
translate russian office_threesome_shiorifuck_audrey_42c4ed37:
    "В момент оргазма я вхожу настолько глубоко, насколько возможно."

# ch/harems_full/office/events/events.rpy:2494
translate russian office_threesome_shiorifuck_audrey_7b21811a:
    "И она принимает в себя всё, без остатка."

# ch/harems_full/office/events/events.rpy:2496
translate russian office_threesome_shiorifuck_audrey_57d82639:
    shiori.say "А-а-ах..."

# ch/harems_full/office/events/events.rpy:2497
translate russian office_threesome_shiorifuck_audrey_304c2143_1:
    shiori.say "[lssb_common.hero_name()]..."

# ch/harems_full/office/events/events.rpy:2498
translate russian office_threesome_shiorifuck_audrey_529f049f:
    shiori.say "Ты... кончаешь... в... меня!"

# ch/harems_full/office/events/events.rpy:2499
translate russian office_threesome_shiorifuck_audrey_dc07e03f:
    "Мне остаётся только крепко держать Сиори, наполняя её."

# ch/harems_full/office/events/events.rpy:2500
translate russian office_threesome_shiorifuck_audrey_3daad4c4:
    "И надеяться, что никто не услышит её криков."

# ch/harems_full/office/events/events.rpy:2501
translate russian office_threesome_shiorifuck_audrey_4d160136:
    "Когда мой оргазм проходит, её крики тоже стихают."

# ch/harems_full/office/events/events.rpy:2502
translate russian office_threesome_shiorifuck_audrey_7e306e4d:
    "Одновременно Сиори соскальзывает с меня и обессиленно опускается на пол."

# ch/harems_full/office/events/events.rpy:2503
translate russian office_threesome_shiorifuck_audrey_8585bcc3:
    "Она лежит там, тяжело дыша, вся в поту."

# ch/harems_full/office/events/events.rpy:2504
