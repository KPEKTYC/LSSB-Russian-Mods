translate russian office_threesome_shiorifuck_lavish_be13ec10:
    "Ах, как трудно выбирать!"

# ch/harems_full/office/events/events.rpy:3983
translate russian office_threesome_shiorifuck_lavish_0bb14533:
    "Наверное, это просто часть обязанностей начальника."

# ch/harems_full/office/events/events.rpy:3986
translate russian office_threesome_shiorifuck_lavish_65faef91:
    "Но зато одна из привилегий начальника — получать то, чего хочется."

# ch/harems_full/office/events/events.rpy:3987
translate russian office_threesome_shiorifuck_lavish_6e8bfe36:
    "Лавиш придётся найти себе другое развлечение."

# ch/harems_full/office/events/events.rpy:3988
translate russian office_threesome_shiorifuck_lavish_f189f4d5:
    "Потому что киску Сиори я хочу целиком для себя."

# ch/harems_full/office/events/events.rpy:3989
translate russian office_threesome_shiorifuck_lavish_c0d0a68f:
    "А чего хочет большой босс, то он и получает!"

# ch/harems_full/office/events/events.rpy:3990
translate russian office_threesome_shiorifuck_lavish_dd30f6cd:
