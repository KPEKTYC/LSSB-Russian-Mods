# ch/harems_full/office/events/events.rpy:5072
translate russian office_foursome_cowgirl_13a3e67a:
    mike.say "Иди-ка сюда."

# ch/harems_full/office/events/events.rpy:5073
translate russian office_foursome_cowgirl_36df9c59:
