# ch/harems_full/office/events/events.rpy:4061
translate russian office_threesome_shiorifuck_lavish_190c4ad4:
    "Держа её за бёдра, направляю член между ягодицами."

# ch/harems_full/office/events/events.rpy:4062
translate russian office_threesome_shiorifuck_lavish_9b86cecb_1:
