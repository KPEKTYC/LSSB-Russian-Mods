# ch/palla/events.rpy:5135
translate russian palla_repeat_naked_dogeza_c7e93894:
    palla.say "Именно, [lssb_palla.hero_name()]!"

# ch/palla/events.rpy:5136
translate russian palla_repeat_naked_dogeza_be6e8a46:
