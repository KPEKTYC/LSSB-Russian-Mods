# ch/palla/events.rpy:5114
translate russian palla_repeat_naked_dogeza_d3e5e27b:
    "Потому что едва не спотыкаюсь о что-то мягкое и розовое прямо за порогом."

# ch/palla/events.rpy:5117
translate russian palla_repeat_naked_dogeza_aaa57519:
    mike.say "КАКОГО..."

# ch/palla/events.rpy:5118
translate russian palla_repeat_naked_dogeza_65a8831b:
    mike.say "Палла..."

# ch/palla/events.rpy:5119
translate russian palla_repeat_naked_dogeza_27cbdc15:
    mike.say "Что ты там делаешь?!"

# ch/palla/events.rpy:5120
translate russian palla_repeat_naked_dogeza_814d06fe:
