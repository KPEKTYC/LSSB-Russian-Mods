# ch/palla/events.rpy:5269
translate russian palla_apartment_sex_dbd00093:
    palla.say "Господи, [lssb_palla.hero_name()]..."

# ch/palla/events.rpy:5270
translate russian palla_apartment_sex_4db061bd:
    palla.say "Я способна понять тонкий намёк, что ты хочешь минет!"

# ch/palla/events.rpy:5271
translate russian palla_apartment_sex_53d217bb:
    palla.say "Не обязательно всё разжёвывать."

# ch/palla/events.rpy:5273
translate russian palla_apartment_sex_ad402a4d:
    "Раньше я ёрзал от волнения. Теперь — от сильного возбуждения: одна мысль о минете Паллы уже заставляет мой член встать."

# ch/palla/events.rpy:5274
