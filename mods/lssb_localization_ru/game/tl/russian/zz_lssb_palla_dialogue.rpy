# ch/palla/events.rpy:5137
translate russian palla_repeat_naked_dogeza_7f3d5fe6:
    palla.say "Надеюсь, ты одобряешь?"

# ch/palla/events.rpy:5139
translate russian palla_repeat_naked_dogeza_30e74fc5:
    mike.say "Эм..."

# ch/palla/events.rpy:5140
translate russian palla_repeat_naked_dogeza_262fe191:
