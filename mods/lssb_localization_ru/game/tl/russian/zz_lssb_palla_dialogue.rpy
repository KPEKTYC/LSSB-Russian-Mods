# ch/palla/events.rpy:5198
translate russian palla_apartment_sex_16a2c197:
    palla.say "Потому что у меня сейчас точно такое же настроение!"

# ch/palla/events.rpy:5200
translate russian palla_apartment_sex_e2d3f3bc:
