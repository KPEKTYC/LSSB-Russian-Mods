# ch/palla/reactions.rpy:79
translate russian palla_ask_phone_male_5fc54a27:
    palla.say "Но пришлёшь какую-нибудь глупость — заблокирую в течение недели."

# ch/palla/reactions.rpy:81
translate russian palla_ask_phone_male_aceb74a1:
    palla.say "...Наверное."

# ch/palla/reactions.rpy:84
translate russian palla_ask_phone_male_e0f069f2:
    palla.say "У тебя мой номер уже несколько месяцев, [lssb_palla.hero_name()]."

# ch/palla/reactions.rpy:85
translate russian palla_ask_phone_male_4518cd80:
    palla.say "Спрашиваешь только ради того, чтобы услышать согласие вслух."

# ch/palla/reactions.rpy:86
translate russian palla_ask_phone_male_485942b7:
    palla.say "Ладно. Да. Он твой. Наслаждайся моментом."

# ch/palla/reactions.rpy:89
translate russian palla_ask_phone_male_41d39e82:
    palla.say "Наверное."

# ch/palla/reactions.rpy:94
translate russian palla_ask_birthday_male_30e74fc5:
    mike.say "Эм..."

# ch/palla/reactions.rpy:95
translate russian palla_ask_birthday_male_65a8831b:
    mike.say "Палла..."

# ch/palla/reactions.rpy:96
translate russian palla_ask_birthday_male_2206e31d:
    mike.say "Когда у тебя день рождения?"

# ch/palla/reactions.rpy:100
translate russian palla_ask_birthday_male_1f7c7e42:
    palla.say "Запомнить легко, [lssb_palla.hero_name()]."

# ch/palla/reactions.rpy:101
translate russian palla_ask_birthday_male_bbd6c95e:
    palla.say "14-го числа осени."

# ch/palla/reactions.rpy:102
translate russian palla_ask_birthday_male_180290fc:
    palla.say "Как раз когда выходят осенние коллекции!"

# ch/palla/reactions.rpy:105
translate russian palla_ask_birthday_male_4a3f24bf:
    palla.say "Значит, в этом году встречу день рождения размером с карнавальную платформу."

# ch/palla/reactions.rpy:106
translate russian palla_ask_birthday_male_4c6ca38b:
    palla.say "Так что никаких фотографий, [lssb_palla.hero_name()]. Я совершенно серьёзно."

# ch/palla/reactions.rpy:109
translate russian palla_ask_birthday_male_f77802bc:
    palla.say "Ты ведь запомнишь?"

# ch/palla/reactions.rpy:110
translate russian palla_ask_birthday_male_be624bc4:
    palla.say "Мне хочется, чтобы именно ты помнил."

# ch/palla/reactions.rpy:113
translate russian palla_ask_birthday_male_4ac3b4e4:
    palla.say "И прежде чем спросишь: да, я жду подарок."

# ch/palla/reactions.rpy:114
translate russian palla_ask_birthday_male_cb3396e2:
    palla.say "Хороший. Не стану притворяться, что нет."

# ch/palla/reactions.rpy:119
translate russian palla_ask_birthday_male_491e62d6:
    palla.say "На что ты намекаешь, [lssb_palla.hero_name()]?"

# ch/palla/reactions.rpy:120
translate russian palla_ask_birthday_male_124cef84:
    palla.say "Думаешь, я слишком старая для этого наряда?!"

# ch/palla/reactions.rpy:121
translate russian palla_ask_birthday_male_2acb4030:
    palla.say "Очень подло с твоей стороны!"

# ch/palla/reactions.rpy:125
translate russian palla_offer_a_drink_male_9f0e6d15:
    mike.say "Палла, хочешь выпить?"

# ch/palla/reactions.rpy:126
translate russian palla_offer_a_drink_male_c3525680:
    mike.say "Я как раз иду к бару и подумал..."

# ch/palla/reactions.rpy:127
translate russian palla_offer_a_drink_male_721b7b4a:
    "Едва я успеваю произнести это, как Палла поворачивается ко мне."

# ch/palla/reactions.rpy:132
translate russian palla_offer_a_drink_male_82211dda:
    palla.say "Эм... не забыл, что сделал мне ребёнка, [lssb_palla.hero_name()]?"

# ch/palla/reactions.rpy:133
translate russian palla_offer_a_drink_male_4e3865fc:
    palla.say "Потому что я точно помню!"

# ch/palla/reactions.rpy:134
translate russian palla_offer_a_drink_male_dfc5ae69:
    palla.say "По сути, это из-за тебя мне нельзя ничего весёлого."

# ch/palla/reactions.rpy:135
translate russian palla_offer_a_drink_male_68f02473:
    palla.say "По крайней мере, пока я ношу твоего ребёнка!"

# ch/palla/reactions.rpy:137
translate russian palla_offer_a_drink_male_8c97abc7:
    palla.say "Ты ослеп, [lssb_palla.hero_name()], или надеешься на чудо?"

# ch/palla/reactions.rpy:138
translate russian palla_offer_a_drink_male_db4c5439:
    palla.say "Я беременна. Не пью, не сплю и ни во что не влезаю."

# ch/palla/reactions.rpy:139
translate russian palla_offer_a_drink_male_fff6dd1f:
    palla.say "Так что нет. Спроси месяца через четыре."

# ch/palla/reactions.rpy:145
translate russian palla_offer_a_drink_male_9908cbeb:
    palla.say "Пожалуйста."

# ch/palla/reactions.rpy:147
translate russian palla_offer_a_drink_male_feb768db:
    palla.say "То, что ты считаешь мне подходящим, [lssb_palla.hero_name()]."

# ch/palla/reactions.rpy:148
translate russian palla_offer_a_drink_male_7926e944:
    palla.say "Это и выпью, и мне понравится."

# ch/palla/reactions.rpy:150
translate russian palla_offer_a_drink_male_37d10bde:
    palla.say "То же, что и ты."

# ch/palla/reactions.rpy:151
translate russian palla_offer_a_drink_male_ecae4e9d:
    mike.say "Не хочешь выбрать?"

# ch/palla/reactions.rpy:153
translate russian palla_offer_a_drink_male_9293abc9:
    palla.say "Не хочу выбирать, [lssb_palla.hero_name()]. В этом и смысл."

# ch/palla/reactions.rpy:156
translate russian palla_offer_a_drink_male_7da008ec:
    palla.say "Давай. Удиви меня."

# ch/palla/reactions.rpy:157
translate russian palla_offer_a_drink_male_64f47cbc:
    palla.say "И если промахнёшься, расскажу всем в баре."

# ch/palla/reactions.rpy:159
translate russian palla_offer_a_drink_male_56552c24:
    palla.say "Хм..."

# ch/palla/reactions.rpy:160
translate russian palla_offer_a_drink_male_21d50776:
    palla.say "Ладно, [lssb_palla.hero_name()], ладно."

# ch/palla/reactions.rpy:161
translate russian palla_offer_a_drink_male_01b230a5:
    palla.say "Узнай, могут ли сделать мне «Порнстар мартини»."

# ch/palla/reactions.rpy:162
translate russian palla_offer_a_drink_male_0d36643c:
    palla.say "Если вообще знают, что это!"

# ch/palla/reactions.rpy:165
translate russian palla_offer_a_drink_male_442ebc4e:
    palla.say "И себе что-нибудь возьми, придурок."

# ch/palla/reactions.rpy:166
translate russian palla_offer_a_drink_male_72bb71de:
    palla.say "Не буду стоять у бара и пить одна, как грустная разведёнка."

# ch/palla/reactions.rpy:178
translate russian palla_offer_a_drink_male_ecf63926:
    palla.say "Честно, [lssb_palla.hero_name()], не утруждайся."

# ch/palla/reactions.rpy:179
translate russian palla_offer_a_drink_male_82d44e09:
    palla.say "Сомневаюсь, что они вообще слышали о том, что я закажу."

# ch/palla/reactions.rpy:185
translate russian palla_slap_ass_intro_male_1e39a760:
    "Не знаю, как у неё это получается. Правда не знаю."

# ch/palla/reactions.rpy:186
translate russian palla_slap_ass_intro_male_019c69ab:
    "Но Палла всегда умудряется одеться именно так."

# ch/palla/reactions.rpy:187
translate russian palla_slap_ass_intro_male_cec89967:
    "Так, что её задница выглядит почти лучше, чем без одежды!"

# ch/palla/reactions.rpy:188
translate russian palla_slap_ass_intro_male_a603f8f0:
    "Как она двигается, какие очертания проступают под одеждой..."

# ch/palla/reactions.rpy:190
translate russian palla_slap_ass_intro_male_9b96ecca:
    "А в последнее время её стало заметно больше."

# ch/palla/reactions.rpy:191
translate russian palla_slap_ass_intro_male_12b24978:
    "И, что бы Палла ни говорила зеркалу по утрам, я не жалуюсь."

# ch/palla/reactions.rpy:192
translate russian palla_slap_ass_intro_male_f0438f7f:
    "Не могу удержаться от игривого шлепка!"

# ch/palla/reactions.rpy:196
translate russian palla_slap_ass_happy_male_ef6cac7c:
    "Палла замирает, вскрикнув от неожиданности."

# ch/palla/reactions.rpy:197
translate russian palla_slap_ass_happy_male_138b25ea:
    "Резко поворачивается и упирает руки в бока."

# ch/palla/reactions.rpy:198
translate russian palla_slap_ass_happy_male_0f190bf9:
    palla.say "[lssb_palla.hero_name()], у тебя один шанс сказать правду."

# ch/palla/reactions.rpy:199
translate russian palla_slap_ass_happy_male_e0260189:
    palla.say "Ты только что шлёпнул меня по заднице?!"

# ch/palla/reactions.rpy:200
translate russian palla_slap_ass_happy_male_f430d218:
    "Отпираться, кажется, бессмысленно."

# ch/palla/reactions.rpy:201
translate russian palla_slap_ass_happy_male_eb45e617:
    "Я просто пожимаю плечами и киваю."

# ch/palla/reactions.rpy:202
translate russian palla_slap_ass_happy_male_15122187:
    "Палла словно обдумывает моё признание."

# ch/palla/reactions.rpy:204
translate russian palla_slap_ass_happy_male_f9f1227d:
    "Затем кладёт руку на поясницу и смотрит на меня через плечо."

# ch/palla/reactions.rpy:205
translate russian palla_slap_ass_happy_male_c14fbb54:
    palla.say "Понимаешь, это последняя часть меня, которую ещё стоит фотографировать?"

# ch/palla/reactions.rpy:206
translate russian palla_slap_ass_happy_male_76c31bd2:
    palla.say "Всё, что выше, теперь принадлежит ребёнку."

# ch/palla/reactions.rpy:208
translate russian palla_slap_ass_happy_male_6827ba6d:
    palla.say "Так что продолжай, [lssb_palla.hero_name()]."

# ch/palla/reactions.rpy:209
translate russian palla_slap_ass_happy_male_cee629a4:
    palla.say "Мне нужно, чтобы хотя бы один из нас всё ещё меня хотел."

# ch/palla/reactions.rpy:211
translate russian palla_slap_ass_happy_male_6254b7bf:
    palla.say "Лучше продолжай, иначе я подумаю самое плохое."

# ch/palla/reactions.rpy:212
translate russian palla_slap_ass_happy_male_76457a79:
    palla.say "И тебе не захочется быть рядом, пока я думаю самое плохое."

# ch/palla/reactions.rpy:214
translate russian palla_slap_ass_happy_male_8925809d:
    palla.say "Так что наслаждайся, пока можешь, придурок."

# ch/palla/reactions.rpy:216
translate russian palla_slap_ass_happy_male_102a5f61:
    "И вдруг напряжение покидает её плечи."

# ch/palla/reactions.rpy:217
translate russian palla_slap_ass_happy_male_698e9118:
    palla.say "Ладно."

# ch/palla/reactions.rpy:218
translate russian palla_slap_ass_happy_male_5ed8898e:
    palla.say "Ладно, это... это можно."

# ch/palla/reactions.rpy:219
translate russian palla_slap_ass_happy_male_1cc6d6b0:
    palla.say "Тебе это позволено."

# ch/palla/reactions.rpy:220
translate russian palla_slap_ass_happy_male_f375e65b:
    "Она говорит скорее тротуару, чем мне."

# ch/palla/reactions.rpy:221
translate russian palla_slap_ass_happy_male_3d758c2f:
    palla.say "И не будь таким довольным собой, [lssb_palla.hero_name()]."

# ch/palla/reactions.rpy:223
translate russian palla_slap_ass_happy_male_03578a02:
    "Затем она медленно отворачивается обратно и остаётся на месте."

# ch/palla/reactions.rpy:224
translate russian palla_slap_ass_happy_male_4fd24973:
    palla.say "Ну. Раз уж начал."

# ch/palla/reactions.rpy:225
translate russian palla_slap_ass_happy_male_66d8ffcd:
    palla.say "Можно и как следует сделать."

# ch/palla/reactions.rpy:226
translate russian palla_slap_ass_happy_male_36b4bdcf:
    "Ближе к «пожалуйста» от неё не дождёшься."

# ch/palla/reactions.rpy:228
translate russian palla_slap_ass_happy_male_7ddc1935:
    "Она закатывает глаза, но от меня не отходит."

# ch/palla/reactions.rpy:229
translate russian palla_slap_ass_happy_male_08e067e0:
    palla.say "Один раз."

# ch/palla/reactions.rpy:230
translate russian palla_slap_ass_happy_male_af6d1dcf:
    palla.say "Один раз можно без обсуждения, [lssb_palla.hero_name()]."

# ch/palla/reactions.rpy:231
translate russian palla_slap_ass_happy_male_50e14ee4:
    "За этот месяц она сказала это уже трижды."

# ch/palla/reactions.rpy:233
translate russian palla_slap_ass_happy_male_87cf8dac:
    "Потом тоже пожимает плечами."

# ch/palla/reactions.rpy:234
translate russian palla_slap_ass_happy_male_01334e63:
    palla.say "Ну, ты ведь ВСЕГО ЛИШЬ человек."

# ch/palla/reactions.rpy:235
translate russian palla_slap_ass_happy_male_7fe5a372:
    palla.say "Как тут устоять?"

# ch/palla/reactions.rpy:236
translate russian palla_slap_ass_happy_male_4d606458:
    palla.say "К тому же, перестань ты так делать, я решила бы, что надоела."

# ch/palla/reactions.rpy:237
translate russian palla_slap_ass_happy_male_03351475:
    palla.say "И пришлось бы всю неделю вести себя как последняя стерва."

# ch/palla/reactions.rpy:239
translate russian palla_slap_ass_happy_male_87cf8dac_1:
    "Потом тоже пожимает плечами."

# ch/palla/reactions.rpy:240
translate russian palla_slap_ass_happy_male_01334e63_1:
    palla.say "Ну, ты ведь ВСЕГО ЛИШЬ человек."

# ch/palla/reactions.rpy:241
translate russian palla_slap_ass_happy_male_7fe5a372_1:
    palla.say "Как тут устоять?"

# ch/palla/reactions.rpy:245
translate russian palla_slap_ass_angry_male_ef6cac7c:
    "Палла замирает, вскрикнув от неожиданности."

# ch/palla/reactions.rpy:246
translate russian palla_slap_ass_angry_male_138b25ea:
    "Резко поворачивается и упирает руки в бока."

# ch/palla/reactions.rpy:247
translate russian palla_slap_ass_angry_male_0f190bf9:
    palla.say "[lssb_palla.hero_name()], у тебя один шанс сказать правду."

# ch/palla/reactions.rpy:248
translate russian palla_slap_ass_angry_male_e0260189:
    palla.say "Ты только что шлёпнул меня по заднице?!"

# ch/palla/reactions.rpy:249
translate russian palla_slap_ass_angry_male_f430d218:
    "Отпираться, кажется, бессмысленно."

# ch/palla/reactions.rpy:250
translate russian palla_slap_ass_angry_male_eb45e617:
    "Я просто пожимаю плечами и киваю."

# ch/palla/reactions.rpy:251
translate russian palla_slap_ass_angry_male_15122187:
    "Палла словно обдумывает моё признание."

# ch/palla/reactions.rpy:253
translate russian palla_slap_ass_angry_male_a8d4aa77:
    "Затем смотрит так, словно я совершил нечто непростительное."

# ch/palla/reactions.rpy:254
translate russian palla_slap_ass_angry_male_bb5b0ff7:
    palla.say "Я размером с дом, [lssb_palla.hero_name()]."

# ch/palla/reactions.rpy:255
translate russian palla_slap_ass_angry_male_ede4a8ea:
    palla.say "И ты решил, что СЕЙЧАС удачный момент привлекать внимание к моей заднице?"

# ch/palla/reactions.rpy:256
translate russian palla_slap_ass_angry_male_b62ca31f:
    palla.say "Не надо. Просто... не надо."

# ch/palla/reactions.rpy:258
translate russian palla_slap_ass_angry_male_baa186db:
    "Она качает головой и выглядит несчастной оттого, что приходится отказывать."

# ch/palla/reactions.rpy:259
translate russian palla_slap_ass_angry_male_df568fbf:
    palla.say "Прости, [lssb_palla.hero_name()]."

# ch/palla/reactions.rpy:260
translate russian palla_slap_ass_angry_male_3264ebb7:
    palla.say "Не здесь. Пожалуйста."

# ch/palla/reactions.rpy:261
translate russian palla_slap_ass_angry_male_867aa566:
    palla.say "В любом другом месте я бы и слова не сказала. Обещаю."

# ch/palla/reactions.rpy:263
translate russian palla_slap_ass_angry_male_7b20d55a:
    "Она качает головой, но не отходит."

# ch/palla/reactions.rpy:264
translate russian palla_slap_ass_angry_male_27124f13:
    palla.say "Не здесь, [lssb_palla.hero_name()]."

# ch/palla/reactions.rpy:265
translate russian palla_slap_ass_angry_male_2e649492:
    palla.say "Потом можешь делать со мной что угодно."

# ch/palla/reactions.rpy:266
translate russian palla_slap_ass_angry_male_1be7868f:
    palla.say "Только не там, где люди видят, как я позволяю."

# ch/palla/reactions.rpy:268
translate russian palla_slap_ass_angry_male_b6a20052:
    "Она качает головой — скорее устало, чем сердито."

# ch/palla/reactions.rpy:269
translate russian palla_slap_ass_angry_male_10d0a49e:
    palla.say "Не посреди улицы, [lssb_palla.hero_name()]."

# ch/palla/reactions.rpy:270
translate russian palla_slap_ass_angry_male_c9fbf162:
    palla.say "У меня есть репутация, а ты её методично портишь."

# ch/palla/reactions.rpy:272
translate russian palla_slap_ass_angry_male_a39d0488:
    "Затем качает головой."

# ch/palla/reactions.rpy:273
translate russian palla_slap_ass_angry_male_8febf77c:
    palla.say "На этот раз прощу, [lssb_palla.hero_name()]."

# ch/palla/reactions.rpy:274
translate russian palla_slap_ass_angry_male_35a4b243:
    palla.say "Но советую больше так не делать."

# ch/palla/reactions.rpy:279
translate russian palla_breakup_male_378b04b5:
    "Мне ненавистно это делать, но другого выхода не вижу."

# ch/palla/reactions.rpy:280
translate russian palla_breakup_male_2192a839:
    "Можно, конечно, промолчать и продолжать врать себе и Палле."

# ch/palla/reactions.rpy:281
translate russian palla_breakup_male_4ac0b0b0:
    "Но сколько я всерьёз смогу так протянуть?"

# ch/palla/reactions.rpy:282
translate russian palla_breakup_male_65873422:
    "Нет, нужно сделать это сейчас и принять возможные последствия."

# ch/palla/reactions.rpy:283
translate russian palla_breakup_male_c9536519:
    "Ой... Я сказал «возможные»?"

# ch/palla/reactions.rpy:284
translate russian palla_breakup_male_6a79f77f:
    "Имел в виду неизбежные..."

# ch/palla/reactions.rpy:285
translate russian palla_breakup_male_65a8831b:
    mike.say "Палла..."

# ch/palla/reactions.rpy:286
translate russian palla_breakup_male_c7ed2d6d:
    mike.say "Можем поговорить?"

# ch/palla/reactions.rpy:287
translate russian palla_breakup_male_087cac5c:
    "От вопроса Палла приподнимает бровь."

# ch/palla/reactions.rpy:288
translate russian palla_breakup_male_602fc046:
    "Наверное, и от тона, которым я его задаю."

# ch/palla/reactions.rpy:289
translate russian palla_breakup_male_56552c24:
    palla.say "Хм..."

# ch/palla/reactions.rpy:290
translate russian palla_breakup_male_dbdce565:
    palla.say "Думаю, да, [lssb_palla.hero_name()]."

# ch/palla/reactions.rpy:291
translate russian palla_breakup_male_c23ea8c6:
    palla.say "Но звучит тревожно!"

# ch/palla/reactions.rpy:292
translate russian palla_breakup_male_ce44a725:
    "Сначала мне удаётся только слабо улыбнуться."

# ch/palla/reactions.rpy:293
translate russian palla_breakup_male_1d5f8d3d:
    "Но затем я собираюсь с духом и произношу:"

# ch/palla/reactions.rpy:294
translate russian palla_breakup_male_a2f5d8e8:
    mike.say "Я... кажется, у нас не складывается, Палла."

# ch/palla/reactions.rpy:295
translate russian palla_breakup_male_8daba8d7:
    mike.say "Ты замечательная девушка и всё такое..."

# ch/palla/reactions.rpy:296
translate russian palla_breakup_male_e3c980cc:
    mike.say "Но, думаю, нам стоит расстаться."

# ch/palla/reactions.rpy:298
translate russian palla_breakup_male_25fe4c04:
    "Палла моргает и отступает на шаг."

# ch/palla/reactions.rpy:299
translate russian palla_breakup_male_736633b5:
    "Реагирует почти как на пощёчину!"

# ch/palla/reactions.rpy:300
translate russian palla_breakup_male_589cb0bf:
    "Открывает и закрывает рот, но слова появляются не сразу."

# ch/palla/reactions.rpy:303
translate russian palla_breakup_male_12fb90b5:
    palla.say "Сейчас?"

# ch/palla/reactions.rpy:304
translate russian palla_breakup_male_b52f8766:
    palla.say "Ты выбрал ЭТОТ момент, [lssb_palla.hero_name()]?"

# ch/palla/reactions.rpy:305
translate russian palla_breakup_male_17cdcbe0:
    "Она кладёт ладонь на живот и, кажется, сама этого не замечает."

# ch/palla/reactions.rpy:306
translate russian palla_breakup_male_576f8146:
    palla.say "Ты хоть представляешь, чем я пожертвовала, чтобы стоять здесь вот такой?"

# ch/palla/reactions.rpy:307
translate russian palla_breakup_male_7f40e0b6:
    palla.say "Работой. Телом. Всем, чего добилась сама."

# ch/palla/reactions.rpy:309
translate russian palla_breakup_male_bc2a2d1a:
    "Пару секунд кажется, что она сейчас расплачется."

# ch/palla/reactions.rpy:310
translate russian palla_breakup_male_f21a749a:
    "Потом выпрямляет спину: Палла не плачет на людях."

# ch/palla/reactions.rpy:313
translate russian palla_breakup_male_7a8905be:
    palla.say "Что я сделала?"

# ch/palla/reactions.rpy:314
translate russian palla_breakup_male_05c2d4e9:
    palla.say "Скажи, что я сделала, и больше никогда не буду. Серьёзно."

# ch/palla/reactions.rpy:315
translate russian palla_breakup_male_0d8a348e:
    "Она не спорит. Вот что убивает меня. Ждёт указаний."

# ch/palla/reactions.rpy:317
translate russian palla_breakup_male_ce595ea8:
    "Потом замечает, что стоит и ждёт выговора, и её лицо закрывается."

# ch/palla/reactions.rpy:320
translate russian palla_breakup_male_a754096d:
    palla.say "Нет."

# ch/palla/reactions.rpy:321
translate russian palla_breakup_male_abf1455a:
    palla.say "Нет, скажи, что я сделала не так, и я перестану."

# ch/palla/reactions.rpy:322
translate russian palla_breakup_male_29e3eb4e:
    "Слова вырываются раньше, чем она успевает их приукрасить. Я вижу, как ей ненавистно их слышать."

# ch/palla/reactions.rpy:324
translate russian palla_breakup_male_1704b46b:
    "И она тут же снова надевает броню, деталь за деталью."

# ch/palla/reactions.rpy:327
translate russian palla_breakup_male_216d9df0:
    palla.say "Погоди."

# ch/palla/reactions.rpy:328
translate russian palla_breakup_male_a51cd594:
    palla.say "Нельзя начать с такого, а потом просто стоять, [lssb_palla.hero_name()]."

# ch/palla/reactions.rpy:329
translate russian palla_breakup_male_90f3f54a:
    "Впервые она не ищет оскорбление. Действительно ждёт ответа."

# ch/palla/reactions.rpy:331
translate russian palla_breakup_male_5f89126c:
    palla.say "Н... нет!"

# ch/palla/reactions.rpy:332
translate russian palla_breakup_male_fda01314:
    palla.say "Ты не можешь такое говорить, [lssb_palla.hero_name()]."

# ch/palla/reactions.rpy:333
translate russian palla_breakup_male_7d8940d9:
    palla.say "Не мне!"

# ch/palla/reactions.rpy:334
translate russian palla_breakup_male_7216f4c2:
    mike.say "Эм... да, Палла."

# ch/palla/reactions.rpy:335
translate russian palla_breakup_male_9a6c4778:
    mike.say "Как видишь, могу!"

# ch/palla/reactions.rpy:336
translate russian palla_breakup_male_4f651d8f:
    "Палла качает головой."

# ch/palla/reactions.rpy:337
translate russian palla_breakup_male_2911031e:
    "Словно пытается стряхнуть с себя смысл сказанного."

# ch/palla/reactions.rpy:338
translate russian palla_breakup_male_41d85769:
    palla.say "Нет, [lssb_palla.hero_name()], ты не понимаешь. Да и откуда тебе?"

# ch/palla/reactions.rpy:339
translate russian palla_breakup_male_ddece512:
    palla.say "Такие, как ты, не бросают таких, как я."

# ch/palla/reactions.rpy:340
translate russian palla_breakup_male_f17d2f8d:
    palla.say "Так просто не бывает!"

# ch/palla/reactions.rpy:341
translate russian palla_breakup_male_2b4826cf:
    mike.say "Не бывает?"

# ch/palla/reactions.rpy:342
translate russian palla_breakup_male_235aad4f:
    palla.say "Конечно нет!"

# ch/palla/reactions.rpy:343
translate russian palla_breakup_male_644037e3:
    palla.say "На самом деле ты, наверное, думаешь, что недостоин меня."

# ch/palla/reactions.rpy:344
translate russian palla_breakup_male_9cd48969:
    palla.say "Но не можешь себе признаться и вместо этого притворяешься, будто бросаешь меня."

# ch/palla/reactions.rpy:345
translate russian palla_breakup_male_e59883fe:
    mike.say "Эм... не уверен, Палла..."

# ch/palla/reactions.rpy:346
translate russian palla_breakup_male_7a21c17a:
    "Палла отмахивается, начиная раздражаться."

# ch/palla/reactions.rpy:347
translate russian palla_breakup_male_bf2c9c1d:
    palla.say "Неважно, что ты думаешь."

# ch/palla/reactions.rpy:348
translate russian palla_breakup_male_149839e1:
    palla.say "Я явно слишком хороша для тебя, [lssb_palla.hero_name()]."

# ch/palla/reactions.rpy:349
translate russian palla_breakup_male_a8ba4868:
    palla.say "Поэтому между нами всё кончено. Больше не хочу тебя видеть!"

# ch/palla/reactions.rpy:350
translate russian palla_breakup_male_c8a68eae:
    "Я киваю и смотрю, как Палла разворачивается и уходит."

# ch/palla/reactions.rpy:351
translate russian palla_breakup_male_9b48dc39:
    "И только тогда мне приходит в голову мысль."

# ch/palla/reactions.rpy:352
translate russian palla_breakup_male_3324343a:
    "Разве не я собирался её бросить?!"

# ch/palla/reactions.rpy:356
translate russian palla_go_steady_intro_male_217c669a:
    mike.say "Чувствую, мы по-настоящему сблизились, Палла."

# ch/palla/reactions.rpy:357
translate russian palla_go_steady_intro_male_31677e48:
    mike.say "Наши отношения вышли на новый уровень."

# ch/palla/reactions.rpy:358
translate russian palla_go_steady_intro_male_fc906f0b:
    mike.say "Поэтому, думаю, нам стоит стать парой!"

# ch/palla/reactions.rpy:363
translate russian palla_go_steady_yes_male_401f47a4:
    palla.say "Я не собираюсь быть чьей-то девушкой. Я не собственность, не объект и не вещь, которой можно пользоваться."

# ch/palla/reactions.rpy:365
translate russian palla_go_steady_yes_male_4523a94a:
    palla.say "Это совсем другие отношения, и ты прекрасно знаешь."

# ch/palla/reactions.rpy:366
translate russian palla_go_steady_yes_male_fbd765f6:
    palla.say "Так что не смей теперь приклеивать красивое название, [lssb_palla.hero_name()]."

# ch/palla/reactions.rpy:368
translate russian palla_go_steady_yes_male_8339d2be:
    palla.say "Не смотри так. Я не сказала «никогда»."

# ch/palla/reactions.rpy:369
translate russian palla_go_steady_yes_male_8dbca6c9:
    palla.say "Я сказала — не девушка. Это две разные фразы, [lssb_palla.hero_name()]."

# ch/palla/reactions.rpy:371
translate russian palla_go_steady_yes_male_90e2656e:
    palla.say "Ну, ладно, пользоваться мной можешь, но не {b}так{/b}."

# ch/palla/reactions.rpy:373
translate russian palla_go_steady_yes_male_03cde5cc:
    palla.say "И прежде чем покажешь на живот: нет, он ровным счётом ничего не меняет."

# ch/palla/reactions.rpy:374
translate russian palla_go_steady_yes_male_bc30f622:
    palla.say "Я ношу ребёнка, [lssb_palla.hero_name()]. Не ярлык."

# ch/palla/reactions.rpy:377
translate russian palla_go_steady_yes_male_faba0a68:
    palla.say "Никогда не думала, что скажу это, [lssb_palla.hero_name()]."

# ch/palla/reactions.rpy:378
translate russian palla_go_steady_yes_male_07a9f715:
    palla.say "Но ты прав. Пора сделать всё официально."

# ch/palla/reactions.rpy:379
translate russian palla_go_steady_yes_male_16fd6756:
    palla.say "Ты мне прямо прикипел к сердцу. Как грибок!"

# ch/palla/reactions.rpy:381
translate russian palla_go_steady_yes_male_c3851011:
    palla.say "Хотя момент, честно говоря, выбран занятный."

# ch/palla/reactions.rpy:382
translate russian palla_go_steady_yes_male_ab9c55c4:
    palla.say "Мог бы придать нашим отношениям приличный вид ДО того, как испортил мне талию."

# ch/palla/reactions.rpy:384
translate russian palla_go_steady_yes_male_1989ac3e:
    palla.say "Повтори. Про официально."

# ch/palla/reactions.rpy:385
translate russian palla_go_steady_yes_male_36314ca0:
    mike.say "Ты моя."

# ch/palla/reactions.rpy:386
translate russian palla_go_steady_yes_male_e1132042:
    palla.say "Да."

# ch/palla/reactions.rpy:387
translate russian palla_go_steady_yes_male_30656c0d:
    palla.say "Спасибо, [lssb_palla.hero_name()]. Серьёзно. Лучше не заставляй объяснять."

# ch/palla/reactions.rpy:389
translate russian palla_go_steady_yes_male_46fb7fa7:
    palla.say "Официально. Повтори."

# ch/palla/reactions.rpy:390
translate russian palla_go_steady_yes_male_92460f37:
    palla.say "Хочу услышать, как звучит твоё решение обо мне."

# ch/palla/reactions.rpy:392
translate russian palla_go_steady_yes_male_7a116ecf:
    palla.say "Официально. Ладно. Как скажешь."

# ch/palla/reactions.rpy:393
translate russian palla_go_steady_yes_male_a476b54d:
    palla.say "Но статус нигде не меняю, можешь не проверять."

# ch/palla/reactions.rpy:395
translate russian palla_go_steady_yes_male_194e1d54:
    palla.say "Ты же хотел просто дружить?"

# ch/palla/reactions.rpy:396
translate russian palla_go_steady_yes_male_b3c8e0f2:
    mike.say "Может, передумал."

# ch/palla/reactions.rpy:397
translate russian palla_go_steady_yes_male_67725897:
    palla.say "Я знаю, что у меня классные сиськи, но не думала, что ты из таких."

# ch/palla/reactions.rpy:398
translate russian palla_go_steady_yes_male_fdd96e0a:
    mike.say "Дело не в твоих сиськах."

# ch/palla/reactions.rpy:399
translate russian palla_go_steady_yes_male_01645c3b:
    palla.say "Правда?"

# ch/palla/reactions.rpy:400
translate russian palla_go_steady_yes_male_f957af65:
    mike.say "Не {b}только{/b} в сиськах."

# ch/palla/reactions.rpy:401
translate russian palla_go_steady_yes_male_42d36dbd:
    palla.say "Ладно. Убеди меня, и я подумаю."

# ch/palla/reactions.rpy:402
translate russian palla_go_steady_yes_male_54866275:
    mike.say "Послушай. Ты чокнутая. Сначала я думал, что возненавижу это или что будет забавно вбить в тебя немного здравого смысла."

# ch/palla/reactions.rpy:403
translate russian palla_go_steady_yes_male_dfd40d40:
    palla.say "О да, комплименты тебе прекрасно удаются."

# ch/palla/reactions.rpy:404
translate russian palla_go_steady_yes_male_331d42ec:
    mike.say "Дай закончить!"

# ch/palla/reactions.rpy:405
translate russian palla_go_steady_yes_male_63426702:
    "Палла складывает руки перед собой и демонстративно изображает внимание."

# ch/palla/reactions.rpy:406
translate russian palla_go_steady_yes_male_36e6a582:
    mike.say "Чёрт, Палла, я влюблён в тебя и хочу... большего. Больше, чем дружбы."

# ch/palla/reactions.rpy:407
translate russian palla_go_steady_yes_male_e69e1de0:
    palla.say "А я-то думала, романтика умерла."

# ch/palla/reactions.rpy:408
translate russian palla_go_steady_yes_male_b9f76c9a:
    palla.say "А, нет, действительно умерла."

# ch/palla/reactions.rpy:409
translate russian palla_go_steady_yes_male_c49efffb:
    mike.say "Да чтоб тебя, может, я и {b}не хочу{/b}, чтобы ты была моей девушкой."

# ch/palla/reactions.rpy:410
translate russian palla_go_steady_yes_male_ff177034:
    palla.say "Вот это я и пытаюсь объяснить."

# ch/palla/reactions.rpy:411
translate russian palla_go_steady_yes_male_37c5795a:
    mike.say "Почему, ну почему ты такая стерва, когда я пытаюсь быть милым?"

# ch/palla/reactions.rpy:412
translate russian palla_go_steady_yes_male_835cf6c1:
    palla.say "Потому что мужики — отстой, чувак."

# ch/palla/reactions.rpy:413
translate russian palla_go_steady_yes_male_96802155:
    mike.say "Значит, я отстой?"

# ch/palla/reactions.rpy:414
translate russian palla_go_steady_yes_male_d8354ba9:
    palla.say "Ты ничего не можешь поделать. Генетика."

# ch/palla/reactions.rpy:415
translate russian palla_go_steady_yes_male_b35eea4b:
    mike.say "Тогда зачем вообще со мной?"

# ch/palla/reactions.rpy:416
translate russian palla_go_steady_yes_male_8b03faf5:
    palla.say "Ничего не могу поделать. Меня тянет к мудакам."

# ch/palla/reactions.rpy:417
translate russian palla_go_steady_yes_male_7cadb2d8:
    mike.say "К {b}своему{/b} мудаку тебя точно тянет."

# ch/palla/reactions.rpy:418
translate russian palla_go_steady_yes_male_24b06a6e:
    palla.say "То есть ты теперь мой мудак?"

# ch/palla/reactions.rpy:419
translate russian palla_go_steady_yes_male_af8e4209:
    mike.say "Ты же не хотела быть девушкой?"

# ch/palla/reactions.rpy:420
translate russian palla_go_steady_yes_male_6f92d5b2:
    palla.say "О, как ловко."

# ch/palla/reactions.rpy:421
translate russian palla_go_steady_yes_male_bd7d6587:
    mike.say "Раз тебя тянет к мудакам, почему, чёрт возьми, не стать девушкой этого мудака?"

# ch/palla/reactions.rpy:422
translate russian palla_go_steady_yes_male_0b92372e:
    palla.say "Потому что, если стану твоей девушкой, это... то, что между нами, изменится."

# ch/palla/reactions.rpy:423
translate russian palla_go_steady_yes_male_8f602fc3:
    mike.say "И?"

# ch/palla/reactions.rpy:424
translate russian palla_go_steady_yes_male_a09e9ebd:
    palla.say "Потому что я редко бываю счастлива и не хочу всё испортить."

# ch/palla/reactions.rpy:425
translate russian palla_go_steady_yes_male_97540ce4:
    mike.say "Да ёб твою мать, это всё? Думаешь, одно слово разрушит наши отношения? В этом даже смысла нет."

# ch/palla/reactions.rpy:426
translate russian palla_go_steady_yes_male_4a5b36fe:
    palla.say "Господи на костылях, [lssb_palla.hero_name()]! Если соглашусь, ты наконец заткнёшься?"

# ch/palla/reactions.rpy:427
translate russian palla_go_steady_yes_male_ae2a3cc7:
    mike.say "Хотел сказать «да», но вряд ли. Зато при первой возможности оттрахаю тебя особенно жёстко."

# ch/palla/reactions.rpy:428
translate russian palla_go_steady_yes_male_53b8ca98:
    palla.say "Ладно, да, буду твоей, фу, девушкой. Но не думай, что перестану встречаться с другими, если кто-то понравится."

# ch/palla/reactions.rpy:429
translate russian palla_go_steady_yes_male_46e77075:
    mike.say "Ничего. Знаю, в нужный момент ты всё равно будешь в моей постели."

# ch/palla/reactions.rpy:430
translate russian palla_go_steady_yes_male_38fdd417:
    palla.say "О, так уверен в себе?"

# ch/palla/reactions.rpy:431
translate russian palla_go_steady_yes_male_0ebc823f:
    mike.say "Ага. Знаю, тебе всегда мало меня."

# ch/palla/reactions.rpy:432
translate russian palla_go_steady_yes_male_72c71102:
    palla.say "Звучит как вызов!"

# ch/palla/reactions.rpy:434
translate russian palla_go_steady_yes_male_270927e6:
    mike.say "Понимаешь, что говоришь это, будучи беременной?"

# ch/palla/reactions.rpy:435
translate russian palla_go_steady_yes_male_fbc9e6c9:
    palla.say "Я беременна, [lssb_palla.hero_name()]. Не искалечена."

# ch/palla/reactions.rpy:436
translate russian palla_go_steady_yes_male_dac0de36:
