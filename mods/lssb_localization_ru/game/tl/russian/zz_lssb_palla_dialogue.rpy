# ch/palla/events.rpy:5143
translate russian palla_repeat_naked_dogeza_6ace3b45:
    mike.say "Тогда да, Палла, это просто потрясающе!"

# ch/palla/events.rpy:5144
translate russian palla_repeat_naked_dogeza_52e98590:
    "Довольная ответом, Палла понемногу отползает от двери."

# ch/palla/events.rpy:5145
translate russian palla_repeat_naked_dogeza_5cb9549c:
