# ch/palla/events.rpy:5111
translate russian palla_repeat_naked_dogeza_cb1783cd:
    "Я уже собираюсь заглянуть в коридор: вдруг Палла успела уйти вглубь квартиры."

# ch/palla/events.rpy:5112
translate russian palla_repeat_naked_dogeza_6591523a:
