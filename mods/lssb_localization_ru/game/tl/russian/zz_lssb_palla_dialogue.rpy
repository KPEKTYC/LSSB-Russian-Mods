# ch/palla/events.rpy:5128
translate russian palla_repeat_naked_dogeza_9e393d49:
    "Этот странный выход голышом меня удивляет, но что-то знакомое в нём есть."

# ch/palla/events.rpy:5129
translate russian palla_repeat_naked_dogeza_578411ac:
    "Кажется, я уже слышал о таком."

# ch/palla/events.rpy:5131
translate russian palla_repeat_naked_dogeza_dada2206:
    mike.say "Догэдза!"

# ch/palla/events.rpy:5132
translate russian palla_repeat_naked_dogeza_9ca12d3b:
