    palla.say "М-м-м..."

# ch/palla/events.rpy:5252
translate russian palla_apartment_sex_621a43b1:
    palla.say "Ну вот мы и здесь, [lssb_palla.hero_name()]."

# ch/palla/events.rpy:5253
