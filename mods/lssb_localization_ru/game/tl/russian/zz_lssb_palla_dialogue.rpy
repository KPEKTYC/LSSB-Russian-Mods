# ch/palla/events.rpy:5124
translate russian palla_repeat_naked_dogeza_35a967f8:
    palla.say "Показываю, что знаю своё место."

# ch/palla/events.rpy:5125
translate russian palla_repeat_naked_dogeza_879fed51:
    "Палла буквально прижалась лбом к полу."

# ch/palla/events.rpy:5126
translate russian palla_repeat_naked_dogeza_91e7790f:
