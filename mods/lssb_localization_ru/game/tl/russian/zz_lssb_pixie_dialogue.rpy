# Native Pixie identifiers, current source catalog. Translation only.

# ch/harems_full/pixie/events.rpy:260
translate russian morgan_kleio_event_01_715f5aff:
    "Морган вдруг бледнеет от потрясения и пригибается. Напрашивается единственное объяснение: она увидела кого-то, с кем предпочла бы не встречаться."

# ch/harems_full/pixie/events.rpy:261
translate russian morgan_kleio_event_01_3cd4fc27:
    "Я инстинктивно начинаю поворачивать голову к двери."

# ch/harems_full/pixie/events.rpy:262
translate russian morgan_kleio_event_01_81c48a40:
    "Но останавливаюсь: Морган настойчиво смотрит на меня и качает головой."

# ch/harems_full/pixie/events.rpy:264
translate russian morgan_kleio_event_01_2da11beb:
    morgan.say "Нет, не оборачивайся!"

# ch/harems_full/pixie/events.rpy:265
translate russian morgan_kleio_event_01_5cfef95d:
    "Она шипит это и кивает вбок и вниз, предлагая мне смотреть хоть в стол, лишь бы не назад."

# ch/harems_full/pixie/events.rpy:266
translate russian morgan_kleio_event_01_4aac7358:
    mike.say "Господи, Морган, у тебя такой вид, будто ты дьявола увидела!"

# ch/harems_full/pixie/events.rpy:267
translate russian morgan_kleio_event_01_02043517:
    morgan.say "Почти, но не совсем."

# ch/harems_full/pixie/events.rpy:268
translate russian morgan_kleio_event_01_db1b08a0:
    "Если я и надеялся услышать что-то ещё, то, похоже, напрасно."

# ch/harems_full/pixie/events.rpy:269
translate russian morgan_kleio_event_01_2cccade6:
    "Не дождавшись объяснений от Морган, я начинаю лихорадочно искать их сам."

# ch/harems_full/pixie/events.rpy:270
translate russian morgan_kleio_event_01_2125049e:
    "Кого она настолько боится встретить, что побелела как полотно?"

# ch/harems_full/pixie/events.rpy:271
translate russian morgan_kleio_event_01_d61abccc:
    "Если подумать, правдоподобный вариант всего один..."

# ch/harems_full/pixie/events.rpy:272
translate russian morgan_kleio_event_01_39b78b48:
    mike.say "Твоя бывшая только что вошла, да?"

# ch/harems_full/pixie/events.rpy:274
translate russian morgan_kleio_event_01_d2c6cce7:
    morgan.say "Тсс! Тише!"

# ch/harems_full/pixie/events.rpy:276
translate russian morgan_kleio_event_01_ca246cbc:
    mike.say "Морган, тут полно людей, все разговаривают и шумят."

# ch/harems_full/pixie/events.rpy:277
translate russian morgan_kleio_event_01_4684e570:
    mike.say "Чтобы расслышать нас, ей пришлось бы встать прямо рядом!"

# ch/harems_full/pixie/events.rpy:278
translate russian morgan_kleio_event_01_e7828e73:
    "Правота моих слов немного унимает панику Морган."

# ch/harems_full/pixie/events.rpy:279
translate russian morgan_kleio_event_01_def10dc0:
    "Теперь она вроде бы готова говорить, но всё ещё прячется за мной, чтобы её не заметили."

# ch/harems_full/pixie/events.rpy:280
translate russian morgan_kleio_event_01_200bd742:
    mike.say "Слушай, если её присутствие так тебя тревожит, может, просто пойдём куда-нибудь ещё?"

# ch/harems_full/pixie/events.rpy:281
translate russian morgan_kleio_event_01_f6a33995:
    "Морган кивает, но стоит мне начать вставать, как она хватает меня за запястье."

# ch/harems_full/pixie/events.rpy:282
translate russian morgan_kleio_event_01_3f76fbbc:
    mike.say "Теперь-то что?"

# ch/harems_full/pixie/events.rpy:283
translate russian morgan_kleio_event_01_664e4882:
    morgan.say "Проверь, свободен ли путь, чтобы она не заметила меня, когда мы будем выходить!"

# ch/harems_full/pixie/events.rpy:284
translate russian morgan_kleio_event_01_2ac5b91d:
    "Я раздражённо качаю головой, но затем киваю и начинаю осматривать путь к двери."

# ch/harems_full/pixie/events.rpy:285
translate russian morgan_kleio_event_01_af786bb5:
    "И тут мне приходит в голову очевидная мысль."

# ch/harems_full/pixie/events.rpy:286
translate russian morgan_kleio_event_01_59c42ae9:
    mike.say "Морган, ты же понимаешь, что я понятия не имею, как выглядит эта девушка?"

# ch/harems_full/pixie/events.rpy:287
translate russian morgan_kleio_event_01_39180284:
    "Морган закатывает глаза из-за собственной глупости и наклоняется поближе, чтобы исправить положение."

# ch/harems_full/pixie/events.rpy:288
translate russian morgan_kleio_event_01_cd0fdee1:
    morgan.say "Прости! Увидела её, так разволновалась, что совсем забыла!"

# ch/harems_full/pixie/events.rpy:289
translate russian morgan_kleio_event_01_4f140a7e:
    morgan.say "Худая блондинка, что-то вроде панка. Вечно выглядит так, будто на всех обижена."

# ch/harems_full/pixie/events.rpy:291
translate russian morgan_kleio_event_01_755b8016:
    "Описание довольно необычное, так что найти её должно быть нетрудно."

# ch/harems_full/pixie/events.rpy:292
translate russian morgan_kleio_event_01_e6986207:
    "Но я быстро оглядываю паб и не замечаю никого подходящего."

# ch/harems_full/pixie/events.rpy:294
translate russian morgan_kleio_event_01_b2334a2b:
    "Вижу только Клео, и она замечает меня одновременно со мной."

# ch/harems_full/pixie/events.rpy:296
translate russian morgan_kleio_event_01_5c9c2578:
    "Мгновение назад она выглядела злой, но, узнав меня, заметно оживляется и идёт к нам."

# ch/harems_full/pixie/events.rpy:300
translate russian morgan_kleio_event_01_760ec578:
    "Я поднимаю руку в знак приветствия, и Морган отчаянно дёргает меня за неё."

# ch/harems_full/pixie/events.rpy:302
translate russian morgan_kleio_event_01_9e896475:
    morgan.say "[lssb_common.hero_name()], какого чёрта ты делаешь?!"

# ch/harems_full/pixie/events.rpy:303
translate russian morgan_kleio_event_01_13aaef12:
    mike.say "Всё хорошо, не волнуйся."

# ch/harems_full/pixie/events.rpy:304
translate russian morgan_kleio_event_01_b6605a31:
    mike.say "Твоей бывшей нигде не видно."

# ch/harems_full/pixie/events.rpy:305
translate russian morgan_kleio_event_01_61efb313:
    mike.say "Я просто помахал знакомой, и она идёт поздороваться."

# ch/harems_full/pixie/events.rpy:309
translate russian morgan_kleio_event_01_bb191fbf:
    "Лишь снова подняв глаза и вспомнив расплывчатое описание Морган, я чувствую, как внутри всё сжимается."

# ch/harems_full/pixie/events.rpy:310
translate russian morgan_kleio_event_01_4f97d075:
    "Как я мог до сих пор не догадаться?!"

# ch/harems_full/pixie/events.rpy:311
translate russian morgan_kleio_event_01_9abe6bcb:
    "Блондинка-панк, вечно на всех обиженная, которой нравятся девушки!"

# ch/harems_full/pixie/events.rpy:312
translate russian morgan_kleio_event_01_6dc95ca1:
    mike.say "Эм, Морган... а твою бывшую случайно зовут не..."

# ch/harems_full/pixie/events.rpy:318
translate russian morgan_kleio_event_01_88dc4960:
    morgan.say "КЛЕО!"

# ch/harems_full/pixie/events.rpy:319
translate russian morgan_kleio_event_01_8eb89e04:
    "Надо же, прямо с языка сняла."

# ch/harems_full/pixie/events.rpy:321
translate russian morgan_kleio_event_01_e525cb67:
    kleio.say "МОРГАН!"

# ch/harems_full/pixie/events.rpy:322
translate russian morgan_kleio_event_01_4ae65a11:
    "Пару секунд они смотрят друг на друга, а затем их взгляды обращаются ко мне."

# ch/harems_full/pixie/events.rpy:326
translate russian morgan_kleio_event_01_8de703da:
    "Я понимаю, как больно было Клео, когда её бросили по переписке, но инстинктивно встаю на сторону Морган."

# ch/harems_full/pixie/events.rpy:327
translate russian morgan_kleio_event_01_aeb2bc86:
    "Мы так давно дружим и через столько прошли, что я сразу вступаюсь за неё, едва Клео вопросительно смотрит на меня."

# ch/harems_full/pixie/events.rpy:329
translate russian morgan_kleio_event_01_88cae76b:
    kleio.say "Не объяснишь, какого хрена ты выпиваешь с этой лживой маленькой сучкой, сердцеед?"

# ch/harems_full/pixie/events.rpy:330
translate russian morgan_kleio_event_01_1dcea02c:
    mike.say "Эй, успокойся, Клео!"

# ch/harems_full/pixie/events.rpy:331
translate russian morgan_kleio_event_01_5eb40d18:
    mike.say "Если тебе так хочется знать, мы с Морган вместе учились в школе."

# ch/harems_full/pixie/events.rpy:332
translate russian morgan_kleio_event_01_53bb3616:
    mike.say "Она одна из моих самых давних подруг."

# ch/harems_full/pixie/events.rpy:334
translate russian morgan_kleio_event_01_e2a66e01:
    "Клео скрещивает руки и презрительно фыркает."

# ch/harems_full/pixie/events.rpy:335
translate russian morgan_kleio_event_01_bf05fc96:
    kleio.say "Странное совпадение, не находишь?"

# ch/harems_full/pixie/events.rpy:337
translate russian morgan_kleio_event_01_ef18c77f:
    morgan.say "Клео, пожалуйста! Я понятия не имела, что [lssb_common.hero_name()] — наш общий знакомый."

# ch/harems_full/pixie/events.rpy:338
translate russian morgan_kleio_event_01_bf5a99b9:
    mike.say "Она говорит правду, Клео."

# ch/harems_full/pixie/events.rpy:339
translate russian morgan_kleio_event_01_af4f9cf5:
    mike.say "Я тоже не знал, что ты с ней встречалась."

# ch/harems_full/pixie/events.rpy:340
translate russian morgan_kleio_event_01_5fd2d700:
    "Клео поднимает руки, словно хочет одновременно заставить нас замолчать и оттолкнуть."

# ch/harems_full/pixie/events.rpy:342
translate russian morgan_kleio_event_01_4986ece2:
    kleio.say "Знаете, у меня уже ощущение, что вы вдвоём на меня набросились!"

# ch/harems_full/pixie/events.rpy:343
translate russian morgan_kleio_event_01_ee5858c7:
    "Я подаюсь к ней, но по тому, как она отшатывается, понимаю, что зря."

# ch/harems_full/pixie/events.rpy:345
translate russian morgan_kleio_event_01_9a4b7aff:
    kleio.say "Не трогай меня! Даже на шаг не подходи!"

# ch/harems_full/pixie/events.rpy:346
translate russian morgan_kleio_event_01_eed7856d:
    "Она указывает на Морган с неприкрытой ненавистью в глазах."

# ch/harems_full/pixie/events.rpy:347
translate russian morgan_kleio_event_01_7c7abca8:
    kleio.say "Она лгунья! И если ты хочешь встать на её сторону, значит, ты ничем не лучше!"

# ch/harems_full/pixie/events.rpy:349
translate russian morgan_kleio_event_01_aff19617:
    "С этими словами Клео отворачивается от нас и почти бегом выходит из паба."

# ch/harems_full/pixie/events.rpy:350
translate russian morgan_kleio_event_01_467631c3:
    "В наступившем молчании нам остаётся лишь пожимать плечами и качать головами, не зная, что сказать."

# ch/harems_full/pixie/events.rpy:352
translate russian morgan_kleio_event_01_f3fa5209:
    "Морган, наверное, тяжело справляться со всем, что сейчас у неё на душе."

# ch/harems_full/pixie/events.rpy:353
translate russian morgan_kleio_event_01_3a937964:
    "Но я утешал Клео, когда её бросили по переписке, и чувствовал, какую боль это ей причинило."

# ch/harems_full/pixie/events.rpy:354
translate russian morgan_kleio_event_01_c1a5dfdf:
    "А теперь сижу, пью и смеюсь с той самой девушкой, которая так с ней поступила."

# ch/harems_full/pixie/events.rpy:355
translate russian morgan_kleio_event_01_779762c2:
    mike.say "Морган, это очень неловко, но Клео — моя хорошая подруга."

# ch/harems_full/pixie/events.rpy:356
translate russian morgan_kleio_event_01_0e1a346e:
    mike.say "И она рассказала, как сильно ты её ранила, бросив вот так!"

# ch/harems_full/pixie/events.rpy:358
translate russian morgan_kleio_event_01_b1fd29f5:
    "Морган растерянно качает головой, словно у неё выбили последнюю опору из-под ног."

# ch/harems_full/pixie/events.rpy:360
translate russian morgan_kleio_event_01_21d14313:
    morgan.say "Что... что ты хочешь сказать, [lssb_common.hero_name()]?"

# ch/harems_full/pixie/events.rpy:361
translate russian morgan_kleio_event_01_61c1a3d2:
    kleio.say "Он говорит, что ты грёбаная сучка, раз бросила меня, Морган!"

# ch/harems_full/pixie/events.rpy:362
translate russian morgan_kleio_event_01_dbf0c90e:
    "Я поворачиваюсь к Клео и жестом пытаюсь её унять."

# ch/harems_full/pixie/events.rpy:363
translate russian morgan_kleio_event_01_0d685030:
    mike.say "Я бы выразился иначе..."

# ch/harems_full/pixie/events.rpy:366
translate russian morgan_kleio_event_01_5d5fee9a:
    morgan.say "Но ты ведь и не отрицаешь, правда?"

# ch/harems_full/pixie/events.rpy:367
translate russian morgan_kleio_event_01_30fc9f60:
    morgan.say "Господи, [lssb_common.hero_name()], я думала, ты и мой друг тоже!"

# ch/harems_full/pixie/events.rpy:368
translate russian morgan_kleio_event_01_c2960c4e:
    morgan.say "После всего, что нас связывает..."

# ch/harems_full/pixie/events.rpy:369
translate russian morgan_kleio_event_01_c6876fb3:
    "Как ни стараюсь, я не могу помешать разговору обернуться против Морган."

# ch/harems_full/pixie/events.rpy:370
translate russian morgan_kleio_event_01_8cf273d0:
    "Особенно когда Клео уже почувствовала её слабость, как гиена чует уязвимую добычу."

# ch/harems_full/pixie/events.rpy:372
translate russian morgan_kleio_event_01_bee3fd6b:
    kleio.say "Забавно, Морган. До сих пор он о тебе ни разу не говорил!"

# ch/harems_full/pixie/events.rpy:373
translate russian morgan_kleio_event_01_a45699de:
    kleio.say "И, судя по его лицу, он тоже предпочёл бы оказаться от тебя за миллион миль!"

# ch/harems_full/pixie/events.rpy:375
translate russian morgan_kleio_event_01_fc008b2f:
    "Морган переводит взгляд с Клео на меня и обратно, а затем вдруг бросается к двери."

# ch/harems_full/pixie/events.rpy:376
translate russian morgan_kleio_event_01_485e2070:
    "Я собираюсь пойти за ней, но Клео хватает меня за руку."

# ch/harems_full/pixie/events.rpy:379
translate russian morgan_kleio_event_01_d066c97f:
    kleio.say "А, пусть идёт, [lssb_common.hero_name()]."

# ch/harems_full/pixie/events.rpy:380
translate russian morgan_kleio_event_01_562be2e6:
    kleio.say "Не стоит на неё силы тратить!"

# ch/harems_full/pixie/events.rpy:382
translate russian morgan_kleio_event_01_a0d84083:
    "Ну и неловкая ситуация, да?"

# ch/harems_full/pixie/events.rpy:383
translate russian morgan_kleio_event_01_45e22246:
    "Часто ли выясняется, что ты утешал обе стороны после расставания?"

# ch/harems_full/pixie/events.rpy:384
translate russian morgan_kleio_event_01_71a1252e:
    "Да ещё и не знал об этом!"

# ch/harems_full/pixie/events.rpy:385
translate russian morgan_kleio_event_01_59de1d3c:
    "Я знаю, как тяжело Морган разбираться со всеми проблемами в своей жизни."

# ch/harems_full/pixie/events.rpy:386
translate russian morgan_kleio_event_01_d72b6e72:
    "И я искренне сочувствовал Клео, когда она рассказала, что её бросил человек, который ей изменял."

# ch/harems_full/pixie/events.rpy:387
translate russian morgan_kleio_event_01_db870bf5:
    "Но сомневаюсь, что теперь, когда всё выяснилось, хоть одна из них посочувствует мне!"

# ch/harems_full/pixie/events.rpy:391
translate russian morgan_kleio_event_01_ccfb3004:
    morgan.say "[lssb_common.hero_name()], ты ЕЁ знаешь?!"

# ch/harems_full/pixie/events.rpy:393
translate russian morgan_kleio_event_01_04b49465:
    kleio.say "Погоди, я как раз собиралась спросить то же самое!"

# ch/harems_full/pixie/events.rpy:394
translate russian morgan_kleio_event_01_a39d5a4e:
    morgan.say "Ты же сказал, что я ничего плохого не сделала!"

# ch/harems_full/pixie/events.rpy:398
translate russian morgan_kleio_event_01_6f377c9c:
    kleio.say "Эй-эй-эй! А мне ты сказал, что эта неверная сучка меня не достойна!"

# ch/harems_full/pixie/events.rpy:401
translate russian morgan_kleio_event_01_55e27c0e:
    "Каждая выслушивает, как я утешал другую, и они снова смотрят на меня с ещё большей злостью."

# ch/harems_full/pixie/events.rpy:402
translate russian morgan_kleio_event_01_11ef765b:
    mike.say "Так, подождите секунду!"

# ch/harems_full/pixie/events.rpy:403
translate russian morgan_kleio_event_01_b51875a5:
    mike.say "Вы ведь уже поняли, что я понятия не имел о ваших отношениях?"

# ch/harems_full/pixie/events.rpy:404
translate russian morgan_kleio_event_01_ecbd3e9b:
    "Морган и Клео медленно смотрят друг на друга и неохотно кивают."

# ch/harems_full/pixie/events.rpy:405
translate russian morgan_kleio_event_01_1ffb960e:
    mike.say "Тогда вы должны понять: мои слова каждой из вас не относились к другой, верно?"

# ch/harems_full/pixie/events.rpy:406
translate russian morgan_kleio_event_01_42ae79b1:
    "Я вижу растерянность на их лицах, но всё равно продолжаю."

# ch/harems_full/pixie/events.rpy:407
translate russian morgan_kleio_event_01_530b1f57:
    mike.say "Когда я говорил всё это, речь шла не о Морган и не о Клео."

# ch/harems_full/pixie/events.rpy:409
translate russian morgan_kleio_event_01_4b5c70cf:
    mike.say "Я говорил о бывшей моей давней подруги и о какой-то девушке, бросившей мою коллегу по группе."

# ch/harems_full/pixie/events.rpy:411
translate russian morgan_kleio_event_01_b81938ae:
    mike.say "Моя [kleio.status] рассказала, что её бросила какая-то девушка, а давняя подруга — о своей бывшей. Вот о ком я говорил."

# ch/harems_full/pixie/events.rpy:412
translate russian morgan_kleio_event_01_36ecfe40:
    mike.say "Поймите, я сочувствовал вам обеим, потому что ни одна из вас не виновата целиком и не права во всём!"

# ch/harems_full/pixie/events.rpy:413
translate russian morgan_kleio_event_01_8a5abbb0:
    "Похоже, мои слова не убедили ни одну из них."

# ch/harems_full/pixie/events.rpy:414
translate russian morgan_kleio_event_01_62f6c190:
    "Но они хотя бы перестали кричать друг на друга при всех."

# ch/harems_full/pixie/events.rpy:415
translate russian morgan_kleio_event_01_ff391a00:
    mike.say "Вы не могли бы хотя бы попытаться понять друг друга?"

# ch/harems_full/pixie/events.rpy:416
translate russian morgan_kleio_event_01_49a710c6:
    mike.say "Может, обсудите всё спокойно, как взрослые люди?"

# ch/harems_full/pixie/events.rpy:418
translate russian morgan_kleio_event_01_7f139d11:
    kleio.say "Пока она не извинится за измену — нет!"

# ch/harems_full/pixie/events.rpy:420
translate russian morgan_kleio_event_01_db9fd56d:
    morgan.say "Ага, конечно! Может, это она сначала передо мной извинится?!"

# ch/harems_full/pixie/events.rpy:424
translate russian morgan_kleio_event_01_ad6e34b9:
    "С этими словами они в ярости расходятся в разные стороны, оставляя меня одного."

# ch/harems_full/pixie/events.rpy:425
translate russian morgan_kleio_event_01_424e4fd2:
    "Одного — и в недоумении, как они собираются разойтись, если выход здесь всего один..."

# ch/harems_full/pixie/events.rpy:432
translate russian morgan_kleio_event_02A_1be6f102:
    morgan.say "Прости, [lssb_common.hero_name()]. Я правда сожалею."

# ch/harems_full/pixie/events.rpy:433
translate russian morgan_kleio_event_02A_abec78af:
    morgan.say "Я бы никогда не поставила тебя в такое положение, если бы знала..."

# ch/harems_full/pixie/events.rpy:434
translate russian morgan_kleio_event_02A_b8145456:
    "Я качаю головой: Морган не за что извиняться, хотя я всё равно ценю её слова."

# ch/harems_full/pixie/events.rpy:435
translate russian morgan_kleio_event_02A_d85f9207:
    mike.say "Не говори глупостей, Морган."

# ch/harems_full/pixie/events.rpy:436
translate russian morgan_kleio_event_02A_175a6472:
    mike.say "Откуда тебе было знать, что я дружу с твоей бывшей?"

# ch/harems_full/pixie/events.rpy:437
translate russian morgan_kleio_event_02A_4a8ce4a3:
    mike.say "Просто странное совпадение, и всё."

# ch/harems_full/pixie/events.rpy:439
translate russian morgan_kleio_event_02A_0f277e03:
    "Она кивает. Кажется, её успокаивает скорее само моё прощение, чем слова, которыми я его выразил."

# ch/harems_full/pixie/events.rpy:441
translate russian morgan_kleio_event_02A_d9dc555a:
    morgan.say "Наверное, ты считаешь, что я поступила жалко, да?"

# ch/harems_full/pixie/events.rpy:442
translate russian morgan_kleio_event_02A_ee8f6007:
    morgan.say "Бросила её по сообщению, вместо того чтобы сказать в лицо?"

# ch/harems_full/pixie/events.rpy:443
translate russian morgan_kleio_event_02A_49e8bf9a:
    mike.say "Скажем так: в случае с Клео я понимаю, почему ты так решила!"

# ch/harems_full/pixie/events.rpy:444
translate russian morgan_kleio_event_02A_5b6e0a83:
    mike.say "У меня ведь была возможность убедиться самому, да?"

# ch/harems_full/pixie/events.rpy:446
translate russian morgan_kleio_event_02A_5f897517:
    "Морган посмеивается, словно наконец может увидеть в случившемся что-то забавное."

# ch/harems_full/pixie/events.rpy:448
translate russian morgan_kleio_event_02A_a51144b3:
    morgan.say "Да, когда она злится, становится свирепой, правда?"

# ch/harems_full/pixie/events.rpy:449
translate russian morgan_kleio_event_02A_d70841c7:
    mike.say "Я бы сказал, что Клео больше лает, чем кусается."

# ch/harems_full/pixie/events.rpy:450
translate russian morgan_kleio_event_02A_3ba8a165:
    mike.say "Но это неправда: и то и другое у неё получается отлично!"

# ch/harems_full/pixie/events.rpy:452
translate russian morgan_kleio_event_02A_5b48fabc:
    "Мы вместе смеёмся над Клео, а я невольно начинаю чувствовать себя виноватым."

# ch/harems_full/pixie/events.rpy:453
translate russian morgan_kleio_event_02A_ac6e2987:
    "Я хорошо понимаю и её сторону спора, и вдруг мне хочется заступиться за неё, пока её здесь нет."

# ch/harems_full/pixie/events.rpy:455
translate russian morgan_kleio_event_02A_9a99cf0c:
    mike.say "Но если без шуток, Морган, у неё есть причины злиться на то, как вы расстались."

# ch/harems_full/pixie/events.rpy:456
translate russian morgan_kleio_event_02A_8c99f721:
    mike.say "Я не пытаюсь тебя задеть, просто смотрю на факты, понимаешь?"

# ch/harems_full/pixie/events.rpy:457
translate russian morgan_kleio_event_02A_b06dc0e7:
    "На миг мне кажется, что Морган начнёт спорить или даже рассердится."

# ch/harems_full/pixie/events.rpy:458
translate russian morgan_kleio_event_02A_19919275:
    "Но она кивает и вздыхает, будто разом выпуская уйму накопившегося раздражения."

# ch/harems_full/pixie/events.rpy:460
translate russian morgan_kleio_event_02A_f8414c62:
    morgan.say "Наверное, на её месте я бы тоже сильно разозлилась."

# ch/harems_full/pixie/events.rpy:461
translate russian morgan_kleio_event_02A_fa3f24a8:
    morgan.say "И было бы проще, если бы я сама ненавидела Клео!"

# ch/harems_full/pixie/events.rpy:462
translate russian morgan_kleio_event_02A_7a394df5:
    morgan.say "Просто мы, похоже, познакомились и сошлись в самое неподходящее время."

# ch/harems_full/pixie/events.rpy:463
translate russian morgan_kleio_event_02A_286a657b:
    mike.say "Да, помню, ты говорила, что тебя к ней уже не так тянет."

# ch/harems_full/pixie/events.rpy:464
translate russian morgan_kleio_event_02A_32692320:
    mike.say "Будто появился кто-то ещё..."

# ch/harems_full/pixie/events.rpy:465
translate russian morgan_kleio_event_02A_f3466563:
    "Мне неловко выспрашивать, но какая-то часть меня всё ещё хочет знать, не стала ли причиной наша встреча."

# ch/harems_full/pixie/events.rpy:466
translate russian morgan_kleio_event_02A_6c874e67:
    "Я должен понять, бросила ли она Клео из-за другой девушки или из-за меня."

# ch/harems_full/pixie/events.rpy:468
translate russian morgan_kleio_event_02A_41f4d0f1:
    morgan.say "Знаю, всё сложно."

# ch/harems_full/pixie/events.rpy:470
translate russian morgan_kleio_event_02A_03abe673:
    morgan.say "Но я и сама всегда была девушкой непростой!"

# ch/harems_full/pixie/events.rpy:471
translate russian morgan_kleio_event_02A_6de622d5:
    "Ну, достаточно туманный ответ, чтобы мне оставалось лишь гадать!"

# ch/harems_full/pixie/events.rpy:472
translate russian morgan_kleio_event_02A_fde39273:
    "Наверное, правильно было бы пока забыть о себе и сосредоточиться на помощи Морган и Клео."

# ch/harems_full/pixie/events.rpy:473
translate russian morgan_kleio_event_02A_57b72fa2:
    "Хотя это вовсе не значит, что я хоть на миг перестаю думать о такой возможности."

# ch/harems_full/pixie/events.rpy:474
translate russian morgan_kleio_event_02A_718f4b02:
    mike.say "При знакомстве Клео кажется колючей, но с ней стоит проявить терпение."

# ch/harems_full/pixie/events.rpy:475
translate russian morgan_kleio_event_02A_cc5ea9fa:
    mike.say "Несмотря на постоянные оскорбления в мой адрес, я правда считаю её хорошей подругой."

# ch/harems_full/pixie/events.rpy:476
translate russian morgan_kleio_event_02A_b6043ce5:
    mike.say "Может, и тебе стоит взглянуть на неё так же?"

# ch/harems_full/pixie/events.rpy:478
translate russian morgan_kleio_event_02A_08a34886:
    "Морган пожимает плечами, но выражение лица у неё довольно бодрое."

# ch/harems_full/pixie/events.rpy:479
translate russian morgan_kleio_event_02A_3f5dd0d9:
    morgan.say "Может быть. Посмотрим."

# ch/harems_full/pixie/events.rpy:480
translate russian morgan_kleio_event_02A_ea912dbb:
    morgan.say "Спасибо за разговор, [lssb_common.hero_name()]."

# ch/harems_full/pixie/events.rpy:481
translate russian morgan_kleio_event_02A_e3f93db8:
    morgan.say "Ты дал мне много пищи для размышлений."

# ch/harems_full/pixie/events.rpy:485
translate russian morgan_kleio_event_02B_4871a33f:
    "Стоит мне увидеть Клео, как я понимаю: что-то не так. Она непривычно тихая, со мной почти робеет."

# ch/harems_full/pixie/events.rpy:486
translate russian morgan_kleio_event_02B_5639d894:
    "Если бы на днях я не оказался посреди её бурной ссоры с Морган, решил бы, что она заболела!"

# ch/harems_full/pixie/events.rpy:487
translate russian morgan_kleio_event_02B_b5ec6038:
    "Совсем не та Клео, которая без раздумий обвинила нас с Морган в грандиозном заговоре против неё."

# ch/harems_full/pixie/events.rpy:488
translate russian morgan_kleio_event_02B_0098d627:
    "И заодно устроила неловкую сцену на весь паб..."

# ch/harems_full/pixie/events.rpy:490
translate russian morgan_kleio_event_02B_d4804054:
    kleio.say "Привет, [lssb_common.hero_name()]..."

# ch/harems_full/pixie/events.rpy:491
translate russian morgan_kleio_event_02B_a7e44911:
    kleio.say "Ты, наверное, всё ещё сильно на меня злишься?"

# ch/harems_full/pixie/events.rpy:492
translate russian morgan_kleio_event_02B_544d7f8e:
    "После ссоры в пабе я и правда злился, но прежде всего из-за того, что Клео и Морган ругались на людях."

# ch/harems_full/pixie/events.rpy:493
translate russian morgan_kleio_event_02B_56ab19e9:
    "Впрочем, я быстро остыл и понял: то, что они оказались бывшими, усложняет ситуацию, но по сути ничего не меняет."

# ch/harems_full/pixie/events.rpy:494
translate russian morgan_kleio_event_02B_ffa204dd:
    "Я по-прежнему сочувствовал Морган, которая пыталась понять, кто ей нужен и чего она хочет от отношений."

# ch/harems_full/pixie/events.rpy:495
translate russian morgan_kleio_event_02B_fba2d18b:
    "И мне по-прежнему было жаль Клео, которую бросили по сообщению, так и не объяснив всего."

# ch/harems_full/pixie/events.rpy:496
translate russian morgan_kleio_event_02B_f5cea584:
    mike.say "Нет, Клео."

# ch/harems_full/pixie/events.rpy:497
translate russian morgan_kleio_event_02B_fb05487f:
    mike.say "Я не злюсь."

# ch/harems_full/pixie/events.rpy:498
translate russian morgan_kleio_event_02B_bccaecfc:
    mike.say "Честно говоря, я думал, это ты будешь злиться на меня!"

# ch/harems_full/pixie/events.rpy:500
translate russian morgan_kleio_event_02B_56fc2677:
    "Клео слабо улыбается и качает головой."

# ch/harems_full/pixie/events.rpy:501
translate russian morgan_kleio_event_02B_5d404960:
    kleio.say "Не-а, я не злюсь!"

# ch/harems_full/pixie/events.rpy:502
translate russian morgan_kleio_event_02B_722e8817:
    kleio.say "Я подумала: девушку из-за этого уже потеряла."

# ch/harems_full/pixie/events.rpy:503
translate russian morgan_kleio_event_02B_bcd8ad1f:
    kleio.say "Надо постараться не потерять ещё и друга."

# ch/harems_full/pixie/events.rpy:504
translate russian morgan_kleio_event_02B_ae078d54:
    kleio.say "Тем более того, кто знает её куда лучше, чем я когда-либо знала!"

# ch/harems_full/pixie/events.rpy:505
translate russian morgan_kleio_event_02B_1f6c0a0f:
    "Теперь, когда разговор заходит о Морган, я сам отвечаю Клео такой же слабой улыбкой."

# ch/harems_full/pixie/events.rpy:506
translate russian morgan_kleio_event_02B_5115dff3:
    mike.say "А поверишь, если скажу, что на самом деле не знаю?"

# ch/harems_full/pixie/events.rpy:509
translate russian morgan_kleio_event_02B_4465c014:
    "Это признание озадачивает Клео."

# ch/harems_full/pixie/events.rpy:510
translate russian morgan_kleio_event_02B_fc8273a7:
    kleio.say "В смысле?"

# ch/harems_full/pixie/events.rpy:511
translate russian morgan_kleio_event_02B_1b78ce0f:
    mike.say "Ну, я тоже только недавно узнал о Морган кое-что новое."

# ch/harems_full/pixie/events.rpy:512
translate russian morgan_kleio_event_02B_388ec530:
    mike.say "То, о чём и не подозревал, когда мы были детьми."

# ch/harems_full/pixie/events.rpy:514
translate russian morgan_kleio_event_02B_cffa098b:
    kleio.say "Теперь рассказывай! Нельзя так заинтриговать и оставить меня в неведении!"

# ch/harems_full/pixie/events.rpy:515
translate russian morgan_kleio_event_02B_8072683c:
    mike.say "Ладно, только обещай не смеяться."

# ch/harems_full/pixie/events.rpy:517
translate russian morgan_kleio_event_02B_4e14e60a:
    "Клео поспешно кивает, и это сразу заставляет усомниться в её обещании."

# ch/harems_full/pixie/events.rpy:518
translate russian morgan_kleio_event_02B_725ff672:
    mike.say "Я только недавно узнал, что она вообще-то девушка."

# ch/harems_full/pixie/events.rpy:519
translate russian morgan_kleio_event_02B_51364137:
    "Клео смотрит на меня, явно ожидая шутки или признания, что я её разыгрываю."

# ch/harems_full/pixie/events.rpy:520
translate russian morgan_kleio_event_02B_06780561:
    mike.say "Это правда! В школе я думал, что она парень!"

# ch/harems_full/pixie/events.rpy:522
translate russian morgan_kleio_event_02B_c41f0fbf:
    "Клео заливается смехом. Совсем не на такую реакцию я рассчитывал."

# ch/harems_full/pixie/events.rpy:523
translate russian morgan_kleio_event_02B_8f2fac1a:
    "Я пытаюсь переждать, дать ей отсмеяться, прежде чем продолжать."

# ch/harems_full/pixie/events.rpy:524
translate russian morgan_kleio_event_02B_281cb223:
    "Но она и не думает останавливаться, и я начинаю немного злиться."

# ch/harems_full/pixie/events.rpy:526
translate russian morgan_kleio_event_02B_4184d3c8:
    mike.say "Ладно-ладно, это самая смешная история на свете."

# ch/harems_full/pixie/events.rpy:527
translate russian morgan_kleio_event_02B_44790832:
    mike.say "Можешь теперь перестать надо мной смеяться?"

# ch/harems_full/pixie/events.rpy:528
translate russian morgan_kleio_event_02B_8813ccfd:
    kleio.say "Боже, [lssb_common.hero_name()], только скажи, что ты больше не ходишь по городу, принимая девушек за парней!"

# ch/harems_full/pixie/events.rpy:529
translate russian morgan_kleio_event_02B_5ace143d:
    mike.say "Нет, конечно!"

# ch/harems_full/pixie/events.rpy:530
translate russian morgan_kleio_event_02B_53bfa525:
    mike.say "Слушай, в детстве она была пацанкой, ясно?"

# ch/harems_full/pixie/events.rpy:531
translate russian morgan_kleio_event_02B_3bf4feb7:
    mike.say "Таскалась с мальчишками, играла в грубые игры и даже била парней крупнее себя!"

# ch/harems_full/pixie/events.rpy:532
translate russian morgan_kleio_event_02B_63f9b230:
    "Клео вдруг изображает преувеличенный ужас и прижимает ладони ко рту."

# ch/harems_full/pixie/events.rpy:535
translate russian morgan_kleio_event_02B_298ab9a9:
    kleio.say "Погоди, [lssb_common.hero_name()], ты ведь меня тоже за парня не считаешь?!"

# ch/harems_full/pixie/events.rpy:536
translate russian morgan_kleio_event_02B_0734edef:
    "Она снова хохочет надо мной, вытирая слезинку из уголка глаза."

# ch/harems_full/pixie/events.rpy:537
translate russian morgan_kleio_event_02B_bc968e97:
    mike.say "Ты закончила?"

# ch/harems_full/pixie/events.rpy:538
translate russian morgan_kleio_event_02B_4c4e685c:
    mike.say "Я хотел сказать: можно думать, что знаешь о человеке всё, и всё равно ошалеть от неожиданного открытия."

# ch/harems_full/pixie/events.rpy:539
translate russian morgan_kleio_event_02B_a9edf590:
    mike.say "По-моему, здесь так случилось со всеми нами."

# ch/harems_full/pixie/events.rpy:541
translate russian morgan_kleio_event_02B_e551b9b9:
    "Клео наконец перестаёт смеяться и примирительно поднимает руки."

# ch/harems_full/pixie/events.rpy:542
translate russian morgan_kleio_event_02B_9f877088:
    kleio.say "Ладно-ладно, я поняла."

# ch/harems_full/pixie/events.rpy:543
translate russian morgan_kleio_event_02B_461e32d0:
    kleio.say "Но поступила она со мной всё равно паршиво."

# ch/harems_full/pixie/events.rpy:544
translate russian morgan_kleio_event_02B_10bee533:
    kleio.say "Но, судя по всему, своих проблем у неё тоже хватает."

# ch/harems_full/pixie/events.rpy:545
translate russian morgan_kleio_event_02B_e83317e0:
    mike.say "Если тебе от этого легче, Клео, Морган сказала, что с той девушкой не спала, а только сходила в кино."

# ch/harems_full/pixie/events.rpy:546
translate russian morgan_kleio_event_02B_a2085e0d:
    mike.say "И я ей верю, если моё мнение что-то значит."

# ch/harems_full/pixie/events.rpy:548
translate russian morgan_kleio_event_02B_58b2fc26:
    "На этот раз Клео смеётся с горечью и иронией."

# ch/harems_full/pixie/events.rpy:549
translate russian morgan_kleio_event_02B_d0958816:
    kleio.say "Ненамного легче."

# ch/harems_full/pixie/events.rpy:550
translate russian morgan_kleio_event_02B_0f2a4ce0:
    kleio.say "Но хоть что-то!"

# ch/harems_full/pixie/events.rpy:551
translate russian morgan_kleio_event_02B_420f54da:
    kleio.say "Спасибо, что поговорил со мной, [lssb_common.hero_name()]."

# ch/harems_full/pixie/events.rpy:552
translate russian morgan_kleio_event_02B_e01c7abb:
    mike.say "Не за что, Клео. Спасибо, что выслушала."

# ch/harems_full/pixie/events.rpy:553
translate russian morgan_kleio_event_02B_72576e9f:
    "Разговор подходит к концу, и я надеюсь, что помог Клео пережить случившееся между ней и Морган."

# ch/harems_full/pixie/events.rpy:554
translate russian morgan_kleio_event_02B_aa944dff:
    "Но что-то подсказывает: я ещё не раз услышу об этом от обеих сторон."

# ch/harems_full/pixie/events.rpy:558
translate russian morgan_kleio_event_03_d8122809:
    "Забавно, как всё порой меняется. Например, когда я оказался посреди тяжёлого расставания Морган и Клео."

# ch/harems_full/pixie/events.rpy:559
translate russian morgan_kleio_event_03_1da27725:
    "Когда всё полетело к чертям, мне пришлось одновременно оправдываться перед обеими и пытаться их вразумить."

# ch/harems_full/pixie/events.rpy:560
translate russian morgan_kleio_event_03_9c4c01b8:
    "Но в следующие дни они сами приходили ко мне извиниться и поплакаться в жилетку."

# ch/harems_full/pixie/events.rpy:561
translate russian morgan_kleio_event_03_90d3214c:
    "Я старался быть хорошим другом для каждой: сочувствовал жалобам, а затем приводил доводы в защиту другой."

# ch/harems_full/pixie/events.rpy:562
translate russian morgan_kleio_event_03_9287ca2b:
    "И в основном это работало: Морган и Клео немного поостыли и попытались понять друг друга."

# ch/harems_full/pixie/events.rpy:563
translate russian morgan_kleio_event_03_6e76014b:
    "Не знаю, какова моя роль во всём этом: давняя подруга и коллега по группе сделали меня посредником в любовной ссоре."

# ch/harems_full/pixie/events.rpy:564
translate russian morgan_kleio_event_03_846704bd:
    "Проще не становится и от того, что обе они кажутся мне чертовски привлекательными..."

# ch/harems_full/pixie/events.rpy:565
translate russian morgan_kleio_event_03_812bcc1a:
    "Хотя всё это время я старался не обращать на это внимания."

# ch/harems_full/pixie/events.rpy:566
translate russian morgan_kleio_event_03_d1c348e7:
    "Но разговорами с каждой по отдельности ничего не решить."

# ch/harems_full/pixie/events.rpy:570
translate russian morgan_kleio_event_03_80f820ce:
    "Когда мы наконец собираемся вместе, обстановка весьма напряжённая."

# ch/harems_full/pixie/events.rpy:571
translate russian morgan_kleio_event_03_2bb1ea84:
    "Ни Морган, ни Клео не произносят ни слова."

# ch/harems_full/pixie/events.rpy:572
translate russian morgan_kleio_event_03_f7ec4e66:
    "Словно обеим есть что сказать, но каждая ждёт, чтобы начала другая."

# ch/harems_full/pixie/events.rpy:573
translate russian morgan_kleio_event_03_f3c4ee96:
    "Я не хочу, чтобы одна попалась на крючок, а вторая набросилась на неё, поэтому сам нарушаю молчание."

# ch/harems_full/pixie/events.rpy:574
translate russian morgan_kleio_event_03_5c009411:
    mike.say "Здорово, что вы обе согласились встретиться."

# ch/harems_full/pixie/events.rpy:575
translate russian morgan_kleio_event_03_58ffd374:
    mike.say "Думаю, это значит, что вы решили оставить случившееся в прошлом."

# ch/harems_full/pixie/events.rpy:576
translate russian morgan_kleio_event_03_3976204a:
    mike.say "Что готовы отпустить обиды и двигаться дальше, верно?"

# ch/harems_full/pixie/events.rpy:577
translate russian morgan_kleio_event_03_57783420:
    "Как я и ожидал, первой отвечает Морган."

# ch/harems_full/pixie/events.rpy:579
translate russian morgan_kleio_event_03_b09746ed:
    "Ей явно больно и неловко, но она всё же решается заговорить."

# ch/harems_full/pixie/events.rpy:580
translate russian morgan_kleio_event_03_54fe7f40:
    morgan.say "Как ты и сказал, [lssb_common.hero_name()], приятного мало, но я хочу, чтобы мы разобрались."

# ch/harems_full/pixie/events.rpy:581
translate russian morgan_kleio_event_03_b9516922:
    "Я киваю и смотрю на Клео, давая ей возможность последовать примеру Морган."

# ch/harems_full/pixie/events.rpy:582
translate russian morgan_kleio_event_03_f29ca24c:
    "Она тихо фыркает и на миг кривит губы, словно собирается пойти в наступление."

# ch/harems_full/pixie/events.rpy:583
translate russian morgan_kleio_event_03_3122966f:
    "Но потом вздыхает, и вместе с выдохом будто исчезает весь её боевой настрой."

# ch/harems_full/pixie/events.rpy:584
translate russian morgan_kleio_event_03_e512a3eb:
    kleio.say "Да, ладно. Всё равно глупо и дальше из-за этого ругаться."

# ch/harems_full/pixie/events.rpy:585
translate russian morgan_kleio_event_03_af1efdcc:
    kleio.say "Что сделано, то сделано."

# ch/harems_full/pixie/events.rpy:587
translate russian morgan_kleio_event_03_f156c4a3:
    "Клео поднимает руки, словно сдаётся."

# ch/harems_full/pixie/events.rpy:588
translate russian morgan_kleio_event_03_25de7c2f:
    kleio.say "С моей стороны всё нормально, Морган. Мир."

# ch/harems_full/pixie/events.rpy:590
translate russian morgan_kleio_event_03_cbec65a0:
    "Морган в ответ кивает."

# ch/harems_full/pixie/events.rpy:591
translate russian morgan_kleio_event_03_325b5dfe:
    morgan.say "С моей тоже, Клео."

# ch/harems_full/pixie/events.rpy:592
translate russian morgan_kleio_event_03_e9ed08fe:
    "Обе слабо улыбаются, а затем на губах Клео появляется озорная усмешка."

# ch/harems_full/pixie/events.rpy:594
translate russian morgan_kleio_event_03_662f1d91:
    kleio.say "Как бы то ни было, нам ведь было охрененно весело вместе!"

# ch/harems_full/pixie/events.rpy:596
translate russian morgan_kleio_event_03_157083cb:
    "Морган слегка краснеет, вспоминая что-то, что, скорее всего, так и останется между ними."

# ch/harems_full/pixie/events.rpy:597
translate russian morgan_kleio_event_03_7b84deac:
    morgan.say "Да, но, думаю, в итоге мы поняли, что для нас по-настоящему важно..."

# ch/harems_full/pixie/events.rpy:601
translate russian morgan_kleio_event_03_af0df083:
    "Пока эта напряжённая ситуация с трудом движется к неплохой развязке, я наблюдаю за ней, кажется, всё время затаив дыхание."

# ch/harems_full/pixie/events.rpy:602
translate russian morgan_kleio_event_03_1c7a109a:
    "Поэтому я удивляюсь, когда кто-то незаметно берёт меня за руку."

# ch/harems_full/pixie/events.rpy:603
translate russian morgan_kleio_event_03_c7989c99:
    "Я бы никак этого не выдал, если бы не понял, что держат сразу обе мои руки."

# ch/harems_full/pixie/events.rpy:604
translate russian morgan_kleio_event_03_7f714467:
    "И я почти уверен: ни Морган, ни Клео не заметили бы, что обе держат меня за руки, если бы я не вскрикнул и не поднял их на всеобщее обозрение."

# ch/harems_full/pixie/events.rpy:605
translate russian morgan_kleio_event_03_d9342b48:
    morgan.say "Что ж... интересно!"

# ch/harems_full/pixie/events.rpy:606
translate russian morgan_kleio_event_03_84e170b6:
    kleio.say "Ага, это чертовски многое объясняет!"

# ch/harems_full/pixie/events.rpy:607
translate russian morgan_kleio_event_03_d743f9a9:
    mike.say "Мне — ничего!"

# ch/harems_full/pixie/events.rpy:610
translate russian morgan_kleio_event_03_0db75420:
    morgan.say "Ладно-ладно! Когда [lssb_common.hero_name()] снова появился в моей жизни, мои чувства к нему вспыхнули вновь."

# ch/harems_full/pixie/events.rpy:611
translate russian morgan_kleio_event_03_c6ca39e6:
    morgan.say "Это и было главной причиной нашего расставания, Клео."

# ch/harems_full/pixie/events.rpy:614
translate russian morgan_kleio_event_03_634f7dd6:
    "Клео хмурится: новые сведения её явно не радуют."

# ch/harems_full/pixie/events.rpy:615
translate russian morgan_kleio_event_03_383a3113:
    kleio.say "Это уже в прошлом, Морган!"

# ch/harems_full/pixie/events.rpy:616
translate russian morgan_kleio_event_03_03dac0b4:
    kleio.say "[lssb_common.hero_name()] очень помог мне после того, как ты меня бросила."

# ch/harems_full/pixie/events.rpy:617
translate russian morgan_kleio_event_03_5695633e:
    kleio.say "Помог снова встать на ноги. С ним я чувствую себя нужной... даже особенной!"

# ch/harems_full/pixie/events.rpy:618
translate russian morgan_kleio_event_03_9c8dfa52:
    "Обе на миг замолкают, мрачно обдумывая сказанное."

# ch/harems_full/pixie/events.rpy:619
translate russian morgan_kleio_event_03_5f3a0f5f:
    morgan.say "Очевидно, кто-то один здесь лишний."

# ch/harems_full/pixie/events.rpy:620
translate russian morgan_kleio_event_03_41b52056:
    kleio.say "Ага. Но раз каждая из нас хочет избавиться от другой, пусть [lssb_common.hero_name()] решает, кому уйти!"

# ch/harems_full/pixie/events.rpy:621
translate russian morgan_kleio_event_03_25e29366:
    "Они одновременно поворачиваются ко мне. По их лицам ясно: мне предстоит трудный выбор."

# ch/harems_full/pixie/events.rpy:622
translate russian morgan_kleio_event_03_aea2e68b:
    "И сделать его придётся прямо сейчас!"

# ch/harems_full/pixie/events.rpy:625
translate russian morgan_kleio_event_03_e39caaf9:
    "Честно говоря, я думал, что будет тяжело."

# ch/harems_full/pixie/events.rpy:626
translate russian morgan_kleio_event_03_1e5bf9b5:
    "Но почти без колебаний говорю сам за себя."

# ch/harems_full/pixie/events.rpy:627
translate russian morgan_kleio_event_03_af4df440:
    mike.say "Морган... я хочу быть с тобой."

# ch/harems_full/pixie/events.rpy:628
translate russian morgan_kleio_event_03_8ed86964:
    mike.say "Если ты тоже этого хочешь."

# ch/harems_full/pixie/events.rpy:632
translate russian morgan_kleio_event_03_d0052d25:
    "К моей радости, она широко улыбается и кивает."

# ch/harems_full/pixie/events.rpy:633
translate russian morgan_kleio_event_03_af53feae:
    morgan.say "Да, хочу."

# ch/harems_full/pixie/events.rpy:634
translate russian morgan_kleio_event_03_32f57665:
    morgan.say "Думаю, в детстве мы просто ещё не были готовы друг к другу."

# ch/harems_full/pixie/events.rpy:635
translate russian morgan_kleio_event_03_6013e7f2:
    morgan.say "Но теперь... теперь у нас и правда может всё получиться!"

# ch/harems_full/pixie/events.rpy:639
translate russian morgan_kleio_event_03_4f6efb37:
    "Я чувствую, как Клео выпускает мою руку и отходит."

# ch/harems_full/pixie/events.rpy:640
translate russian morgan_kleio_event_03_a715626a:
    kleio.say "Если ты этого хочешь, [lssb_common.hero_name()], вперёд."

# ch/harems_full/pixie/events.rpy:641
translate russian morgan_kleio_event_03_a08a6d68:
    kleio.say "По крайней мере, теперь я знаю, что не подхожу ни одному из вас!"

# ch/harems_full/pixie/events.rpy:643
translate russian morgan_kleio_event_03_1658a7ec:
    "Мы с Морган пытаемся что-то сказать, но Клео обрывает нас и поворачивается, чтобы уйти."

# ch/harems_full/pixie/events.rpy:644
translate russian morgan_kleio_event_03_e6e7b921:
    "Мне ужасно, когда я смотрю ей вслед."

# ch/harems_full/pixie/events.rpy:645
translate russian morgan_kleio_event_03_12f28eb7:
    "И стыдно оттого, как мне приятно, когда Морган собственнически притягивает меня к себе."

# ch/harems_full/pixie/events.rpy:654
translate russian morgan_kleio_event_03_e6d7847c:
    "Стоит посмотреть на Морган, как я почти физически чувствую притяжение прошлого."

# ch/harems_full/pixie/events.rpy:655
translate russian morgan_kleio_event_03_c2bcb6d0:
    "Но, как ни странно, сейчас сильнее всего на меня действует другое."

# ch/harems_full/pixie/events.rpy:656
translate russian morgan_kleio_event_03_342e777e:
    "Я могу думать лишь о боли, с которой ко мне пришла Клео после расставания."

# ch/harems_full/pixie/events.rpy:657
translate russian morgan_kleio_event_03_58b0a748:
    "И о том, как я ей сочувствовал и как хотел всё исправить."

# ch/harems_full/pixie/events.rpy:661
translate russian morgan_kleio_event_03_1a845277:
    mike.say "Клео... я хочу быть с тобой."

# ch/harems_full/pixie/events.rpy:662
translate russian morgan_kleio_event_03_a30dbf2b:
    mike.say "Кажется, я тебя люблю!"

# ch/harems_full/pixie/events.rpy:664
translate russian morgan_kleio_event_03_59f969b3:
    "Я ожидал увидеть на лице Клео торжество, но вместо этого она, кажется, вот-вот расплачется."

# ch/harems_full/pixie/events.rpy:665
translate russian morgan_kleio_event_03_6fb4cc8b:
    kleio.say "Чёрт... чего я реву, как последняя размазня?!"

# ch/harems_full/pixie/events.rpy:666
translate russian morgan_kleio_event_03_025e6188:
    kleio.say "Только не говори, что это потому, что я тоже тебя люблю, [lssb_common.hero_name()]!"

# ch/harems_full/pixie/events.rpy:670
translate russian morgan_kleio_event_03_faf393f6:
    "Морган вдруг отпускает мою руку и отходит от нас с Клео."

# ch/harems_full/pixie/events.rpy:671
translate russian morgan_kleio_event_03_e6b0cb12:
    morgan.say "Но... [lssb_common.hero_name()]..."

# ch/harems_full/pixie/events.rpy:672
translate russian morgan_kleio_event_03_65a11085:
    morgan.say "Я ведь рассталась с ней из-за чувств к тебе!"

# ch/harems_full/pixie/events.rpy:673
translate russian morgan_kleio_event_03_9f9e5551:
    mike.say "Прости, Морган, но я тоже не властен над своими чувствами!"

# ch/harems_full/pixie/events.rpy:674
translate russian morgan_kleio_event_03_e286436f:
    mike.say "И всё это лишь помогло мне понять, как сильно мне дорога Клео..."

# ch/harems_full/pixie/events.rpy:676
translate russian morgan_kleio_event_03_4aa131c2:
    "Морган словно хочет ещё что-то сказать, но вдруг поворачивается и убегает без единого слова."

# ch/harems_full/pixie/events.rpy:677
translate russian morgan_kleio_event_03_4a9fb628:
    "Мне остаётся лишь смотреть ей вслед, находя утешение в том, как Клео сжимает мою руку."

# ch/harems_full/pixie/events.rpy:680
translate russian morgan_kleio_event_03_505b020c:
    morgan.say "Я... я не справляюсь со всем этим дерьмом."

# ch/harems_full/pixie/events.rpy:683
translate russian morgan_kleio_event_03_a44e880f:
    morgan.say "Правда не справляюсь!"

# ch/harems_full/pixie/events.rpy:684
translate russian morgan_kleio_event_03_9cef3263:
    morgan.say "Раньше я думала, что знаю, кто я и чего хочу."

# ch/harems_full/pixie/events.rpy:685
translate russian morgan_kleio_event_03_d512986d:
    morgan.say "Но с тех пор, как ты вернулся в мою жизнь, [lssb_common.hero_name()], я будто совсем себя не понимаю!"

# ch/harems_full/pixie/events.rpy:687
translate russian morgan_kleio_event_03_39ece72e:
    "Я пытаюсь утешить Морган, но она тут же отпускает мою руку и начинает пятиться."

# ch/harems_full/pixie/events.rpy:688
translate russian morgan_kleio_event_03_1df454f7:
    morgan.say "Нет... пожалуйста, не трогай меня."

# ch/harems_full/pixie/events.rpy:689
translate russian morgan_kleio_event_03_cc9132e5:
    morgan.say "Я так запуталась... не знаю, что сделаю, если ты меня обнимешь!"

# ch/harems_full/pixie/events.rpy:691
translate russian morgan_kleio_event_03_5b3ff445:
    "Клео смотрит на меня, широко раскрыв глаза: у Морган, похоже, срыв."

# ch/harems_full/pixie/events.rpy:692
translate russian morgan_kleio_event_03_f660492e:
    "Впервые в жизни она, кажется, совершенно не находит слов."

# ch/harems_full/pixie/events.rpy:693
translate russian morgan_kleio_event_03_f3c58da8:
    morgan.say "Мне нужно уйти от всего этого..."

# ch/harems_full/pixie/events.rpy:694
translate russian morgan_kleio_event_03_42db1339:
    morgan.say "Мне нужно оказаться там, где я смогу быть собой, а не пытаться стать такой, какой, по моему мнению, меня хотят видеть другие!"

# ch/harems_full/pixie/events.rpy:696
translate russian morgan_kleio_event_03_4aa131c2_1:
    "Морган словно хочет ещё что-то сказать, но вдруг поворачивается и убегает без единого слова."

# ch/harems_full/pixie/events.rpy:697
translate russian morgan_kleio_event_03_4a9fb628_1:
    "Мне остаётся лишь смотреть ей вслед, находя утешение в том, как Клео сжимает мою руку."

# ch/harems_full/pixie/events.rpy:702
translate russian morgan_kleio_event_03_cde46b50:
    kleio.say "Ясно же, что здесь я — третий лишний!"

# ch/harems_full/pixie/events.rpy:703
translate russian morgan_kleio_event_03_bf2dae05:
    "Мы с Морган пытаемся возразить, но она качает головой и иронично усмехается."

# ch/harems_full/pixie/events.rpy:704
translate russian morgan_kleio_event_03_ebf3aa3f:
    kleio.say "Нет, я всё вижу, даже если вы двое не замечаете."

# ch/harems_full/pixie/events.rpy:705
translate russian morgan_kleio_event_03_87c341e4:
    kleio.say "Вы же те самые двое, что разминулись когда-то давным-давно!"

# ch/harems_full/pixie/events.rpy:706
translate russian morgan_kleio_event_03_59459102:
    kleio.say "С таким прошлым мне не тягаться."

# ch/harems_full/pixie/events.rpy:709
translate russian morgan_kleio_event_03_84009617:
    "Следующее возражение она тоже отмахивает и отпускает мою руку."

# ch/harems_full/pixie/events.rpy:710
translate russian morgan_kleio_event_03_6ac6a198:
    kleio.say "Ах... надо уйти отсюда, проветрить голову."

# ch/harems_full/pixie/events.rpy:711
translate russian morgan_kleio_event_03_142ccf81:
    kleio.say "Может, именно это мне и было нужно: возможность всё изменить, начать заново!"

# ch/harems_full/pixie/events.rpy:712
translate russian morgan_kleio_event_03_7b03f8a2:
    "Мы с Морган пытаемся сказать Клео хоть что-нибудь, но она обрывает нас и поворачивается, чтобы уйти."

# ch/harems_full/pixie/events.rpy:714
translate russian morgan_kleio_event_03_e6e7b921_1:
    "Мне ужасно, когда я смотрю ей вслед."

# ch/harems_full/pixie/events.rpy:715
translate russian morgan_kleio_event_03_12f28eb7_1:
    "И стыдно оттого, как мне приятно, когда Морган собственнически притягивает меня к себе."

# ch/harems_full/pixie/events.rpy:726
translate russian morgan_kleio_event_03_9c7f7868:
    morgan.say "Ну, я знаю одно: из-за всей этой истории мне было паршиво."

# ch/harems_full/pixie/events.rpy:727
translate russian morgan_kleio_event_03_81be8b9b:
    morgan.say "Но нашёлся хороший друг, который помог мне через это пройти."

# ch/harems_full/pixie/events.rpy:730
translate russian morgan_kleio_event_03_91661bf2:
    kleio.say "Забавно, я как раз подумала о том же."

# ch/harems_full/pixie/events.rpy:731
translate russian morgan_kleio_event_03_14d0d3ad:
    "Морган и Клео на миг смотрят друг на друга, затем поворачиваются ко мне с хитрыми улыбками."

# ch/harems_full/pixie/events.rpy:732
translate russian morgan_kleio_event_03_860eccbd:
    kleio.say "Кое-кто поддерживал нас обеих."

# ch/harems_full/pixie/events.rpy:733
translate russian morgan_kleio_event_03_59f9656b:
    kleio.say "Кое-кто верил, что мы сможем помириться и дружить."

# ch/harems_full/pixie/events.rpy:734
translate russian morgan_kleio_event_03_24497c9a:
    morgan.say "И я не могу отнять у тебя этого человека, Клео."

# ch/harems_full/pixie/events.rpy:735
translate russian morgan_kleio_event_03_d2f684a1:
    kleio.say "А я бы не смогла отнять его у тебя, Морган."

# ch/harems_full/pixie/events.rpy:736
translate russian morgan_kleio_event_03_864aa039:
    "Я перевожу взгляд с одной на другую, пытаясь понять, на что они намекают."

# ch/harems_full/pixie/events.rpy:737
translate russian morgan_kleio_event_03_dc368dc8:
    morgan.say "Я точно знаю, что хорошие подруги всегда могут делиться..."

# ch/harems_full/pixie/events.rpy:739
translate russian morgan_kleio_event_03_869322b1:
    kleio.say "Думаешь, у нас получится?"

# ch/harems_full/pixie/events.rpy:741
translate russian morgan_kleio_event_03_34979148:
    morgan.say "Думаю, можно попробовать..."

# ch/harems_full/pixie/events.rpy:742
translate russian morgan_kleio_event_03_dca20940:
    "Морган обвивает меня с одной стороны, а Клео — с другой."

# ch/harems_full/pixie/events.rpy:743
translate russian morgan_kleio_event_03_31d48aff:
    "Больше ни одна из них ничего не говорит: они просто прижимаются ко мне самым недвусмысленным образом."

# ch/harems_full/pixie/events.rpy:744
translate russian morgan_kleio_event_03_e0c9ed50:
    "Они замечают моё растерянное возбуждение, посмеиваются и поглаживают мне грудь, лишь усугубляя положение."

# ch/harems_full/pixie/events.rpy:745
translate russian morgan_kleio_event_03_3395e9e7:
    "Кажется, я начинаю понимать, к чему всё идёт. Только не знаю, радоваться, бояться или и то и другое!"

# ch/harems_full/pixie/events.rpy:750
translate russian morgan_kleio_event_03_alternate_03b38c5b:
    "После того мучительного разбора путаницы между мной, Клео и Морган я думал, что всё наконец закончилось."

# ch/harems_full/pixie/events.rpy:751
translate russian morgan_kleio_event_03_alternate_62f3ad78:
    "Это было словно вырывать зубы, и лично я был более чем готов двигаться дальше и забыть случившееся."

# ch/harems_full/pixie/events.rpy:752
translate russian morgan_kleio_event_03_alternate_322b8f4b:
    "Поэтому я совершенно не ожидаю, что именно Клео вдруг снова поднимет эту тему."

# ch/harems_full/pixie/events.rpy:753
translate russian morgan_kleio_event_03_alternate_9bf7ccbe:
    kleio.say "Эй, [lssb_common.hero_name()]."

# ch/harems_full/pixie/events.rpy:755
translate russian morgan_kleio_event_03_alternate_59c298f1:
    kleio.say "Я... я хотела кое-что спросить..."

# ch/harems_full/pixie/events.rpy:756
translate russian morgan_kleio_event_03_alternate_de307682:
    "Уже два тревожных признака, а до подробностей она ещё не дошла."

# ch/harems_full/pixie/events.rpy:757
translate russian morgan_kleio_event_03_alternate_bbbda0ce:
    "Во-первых, Клео не назвала меня «сердцеедом»."

# ch/harems_full/pixie/events.rpy:758
translate russian morgan_kleio_event_03_alternate_b35acef8:
    "Во-вторых, она вообще спрашивает о чём-то разрешения!"

# ch/harems_full/pixie/events.rpy:759
translate russian morgan_kleio_event_03_alternate_20ec184e:
    mike.say "А... хорошо, Клео."

# ch/harems_full/pixie/events.rpy:760
translate russian morgan_kleio_event_03_alternate_47366b2a:
    mike.say "Что такое?"

# ch/harems_full/pixie/events.rpy:762
translate russian morgan_kleio_event_03_alternate_de8dc83b:
    kleio.say "У-уф..."

# ch/harems_full/pixie/events.rpy:763
translate russian morgan_kleio_event_03_alternate_90473589:
    kleio.say "Это насчёт Морган..."

# ch/harems_full/pixie/events.rpy:764
translate russian morgan_kleio_event_03_alternate_a9e3b996:
    "Каждое слово будто приходится вытягивать из Клео огромным усилием."

# ch/harems_full/pixie/events.rpy:765
translate russian morgan_kleio_event_03_alternate_c012595f:
    "Вижу, что ей трудно даже заговорить со мной об этом."

# ch/harems_full/pixie/events.rpy:766
translate russian morgan_kleio_event_03_alternate_26f20850:
    "Я удивлённо поднимаю брови: как я уже сказал, думал, мы всё уладили."

# ch/harems_full/pixie/events.rpy:767
translate russian morgan_kleio_event_03_alternate_c766e9f8:
    mike.say "Морган?"

# ch/harems_full/pixie/events.rpy:769
translate russian morgan_kleio_event_03_alternate_e30c3ead:
    kleio.say "Да, Морган!"

# ch/harems_full/pixie/events.rpy:770
translate russian morgan_kleio_event_03_alternate_98173967:
    kleio.say "Знаешь такую? Маленькая девушка с синими волосами?"

# ch/harems_full/pixie/events.rpy:772
translate russian morgan_kleio_event_03_alternate_4806d217:
    kleio.say "Я с ней встречалась, а ты считал её парнем!"

# ch/harems_full/pixie/events.rpy:773
translate russian morgan_kleio_event_03_alternate_1f81e715:
    "Едва начав язвить и раздражаться, Клео вдруг останавливается."

# ch/harems_full/pixie/events.rpy:775
translate russian morgan_kleio_event_03_alternate_bd32e875:
    "Словно я вижу, что на ссору у неё сейчас просто нет сил."

# ch/harems_full/pixie/events.rpy:776
translate russian morgan_kleio_event_03_alternate_b053b7ef:
    "Она будто сдувается прямо у меня на глазах, вздыхая и пожимая плечами."

# ch/harems_full/pixie/events.rpy:777
translate russian morgan_kleio_event_03_alternate_f015d71e:
    kleio.say "Прости."

# ch/harems_full/pixie/events.rpy:778
translate russian morgan_kleio_event_03_alternate_93f27fcc:
    kleio.say "Не хотела так срываться..."

# ch/harems_full/pixie/events.rpy:779
translate russian morgan_kleio_event_03_alternate_0c6e84c4:
    "Что происходит? Клео действительно извиняется?"

# ch/harems_full/pixie/events.rpy:780
translate russian morgan_kleio_event_03_alternate_35c6f935:
    "Теперь я понимаю: дело серьёзное."

# ch/harems_full/pixie/events.rpy:781
translate russian morgan_kleio_event_03_alternate_f0a78e14:
    mike.say "А что с ней, Клео?"

# ch/harems_full/pixie/events.rpy:782
translate russian morgan_kleio_event_03_alternate_de123797:
    mike.say "Разве мы уже не разобрались?"

# ch/harems_full/pixie/events.rpy:783
translate russian morgan_kleio_event_03_alternate_59a236d5:
    "Клео устало улыбается и качает головой."

# ch/harems_full/pixie/events.rpy:784
translate russian morgan_kleio_event_03_alternate_3f141af2:
    "Она выглядит такой беспомощной, что у меня почти физически щемит сердце."

# ch/harems_full/pixie/events.rpy:785
translate russian morgan_kleio_event_03_alternate_1792a6e7:
    kleio.say "Я тоже так думала."

# ch/harems_full/pixie/events.rpy:787
translate russian morgan_kleio_event_03_alternate_99a932a3:
    kleio.say "Но я никак не могу перестать о ней думать!"

# ch/harems_full/pixie/events.rpy:788
translate russian morgan_kleio_event_03_alternate_00afd6f0:
    "Впервые с начала разговора уязвимым чувствую себя я."

# ch/harems_full/pixie/events.rpy:789
translate russian morgan_kleio_event_03_alternate_9f8c9280:
    "Что она имеет в виду?"

# ch/harems_full/pixie/events.rpy:790
translate russian morgan_kleio_event_03_alternate_7ea71f1a:
    "Что это значит для нас?!"

# ch/harems_full/pixie/events.rpy:791
translate russian morgan_kleio_event_03_alternate_3e79e267:
    "Отвечая, я изо всех сил стараюсь скрыть эмоции."

# ch/harems_full/pixie/events.rpy:792
translate russian morgan_kleio_event_03_alternate_e1359a2c:
    mike.say "Что ты хочешь сказать, Клео?"

# ch/harems_full/pixie/events.rpy:793
translate russian morgan_kleio_event_03_alternate_a73574af:
    mike.say "Ты выбираешь Морган вместо меня?"

# ch/harems_full/pixie/events.rpy:795
translate russian morgan_kleio_event_03_alternate_30d688b5:
    "От второго вопроса глаза Клео расширяются, и она качает головой."

# ch/harems_full/pixie/events.rpy:796
translate russian morgan_kleio_event_03_alternate_46d6d93b:
    "Словно меньше всего ожидала услышать от меня именно это."

# ch/harems_full/pixie/events.rpy:797
translate russian morgan_kleio_event_03_alternate_785b5956:
    "А что ещё я должен думать?"

# ch/harems_full/pixie/events.rpy:798
translate russian morgan_kleio_event_03_alternate_90e6c70b:
    "Особенно когда она говорит, что не может выбросить из головы бывшую!"

# ch/harems_full/pixie/events.rpy:800
translate russian morgan_kleio_event_03_alternate_6581c4ba:
    kleio.say "О нет... чёрт, нет!"

# ch/harems_full/pixie/events.rpy:801
translate russian morgan_kleio_event_03_alternate_8673e16d:
    kleio.say "Я совсем не это имела в виду!"

# ch/harems_full/pixie/events.rpy:803
translate russian morgan_kleio_event_03_alternate_365031c6:
    mike.say "А что тогда?"

# ch/harems_full/pixie/events.rpy:805
translate russian morgan_kleio_event_03_alternate_f7ff037f:
    kleio.say "Я не могу выбрать между вами. Вот что я имею в виду."

# ch/harems_full/pixie/events.rpy:807
translate russian morgan_kleio_event_03_alternate_f6ff9aad:
    kleio.say "Я хочу быть с вами обоими!"

# ch/harems_full/pixie/events.rpy:808
translate russian morgan_kleio_event_03_alternate_13334ccc:
    kleio.say "Было бы здорово, правда?"

# ch/harems_full/pixie/events.rpy:809
translate russian morgan_kleio_event_03_alternate_b48f8cdc:
    kleio.say "Мы ведь могли бы делиться?"

# ch/harems_full/pixie/events.rpy:811
translate russian morgan_kleio_event_03_alternate_550883d9:
    "Я правильно расслышал?"

# ch/harems_full/pixie/events.rpy:812
translate russian morgan_kleio_event_03_alternate_24dfcab6:
    "Клео действительно спрашивает, не против ли я секса втроём?"

# ch/harems_full/pixie/events.rpy:814
translate russian morgan_kleio_event_03_alternate_f31c4cc6:
    "Я некоторое время обдумываю слова Клео."

# ch/harems_full/pixie/events.rpy:815
translate russian morgan_kleio_event_03_alternate_961265ff:
    "Считайте меня параноиком, но я упорно ищу подвох."

# ch/harems_full/pixie/events.rpy:816
translate russian morgan_kleio_event_03_alternate_f0acf250:
    "Он ведь должен быть, правда?"

# ch/harems_full/pixie/events.rpy:817
translate russian morgan_kleio_event_03_alternate_e6ce8dc0:
    "Она же не может всерьёз предлагать мне их обеих."

# ch/harems_full/pixie/events.rpy:818
translate russian morgan_kleio_event_03_alternate_2528b236:
    "Или может?"

# ch/harems_full/pixie/events.rpy:819
translate russian morgan_kleio_event_03_alternate_5d7b1421:
    "Но звучит именно так..."

# ch/harems_full/pixie/events.rpy:820
translate russian morgan_kleio_event_03_alternate_e7fe36d4:
    mike.say "Ты... и я... и Морган?"

# ch/harems_full/pixie/events.rpy:821
translate russian morgan_kleio_event_03_alternate_c7949800:
    "Клео медленно кивает, словно объясняет что-то полному идиоту."

# ch/harems_full/pixie/events.rpy:823
translate russian morgan_kleio_event_03_alternate_c7b65c02:
    kleio.say "Да. Я, ты и Морган."

# ch/harems_full/pixie/events.rpy:824
translate russian morgan_kleio_event_03_alternate_cd9880b6:
    "Я тоже киваю и жду, что сейчас что-нибудь разрушит эту иллюзию."

# ch/harems_full/pixie/events.rpy:825
translate russian morgan_kleio_event_03_alternate_6246bc47:
    "Будто вот-вот проснусь и окажется, что всё это было безумным сном."

# ch/harems_full/pixie/events.rpy:827
translate russian morgan_kleio_event_03_alternate_7d461542:
    mike.say "Думаю, я был бы не против."

# ch/harems_full/pixie/events.rpy:828
translate russian morgan_kleio_event_03_alternate_0a8301c4:
    mike.say "То есть если вы обе этого хотите..."

# ch/harems_full/pixie/events.rpy:830
translate russian morgan_kleio_event_03_alternate_d9d2c47e:
    "Клео щурится и качает головой."

# ch/harems_full/pixie/events.rpy:831
translate russian morgan_kleio_event_03_alternate_946eded9:
    "На её губах появляется понимающая улыбка."

# ch/harems_full/pixie/events.rpy:833
translate russian morgan_kleio_event_03_alternate_fbcb3c2e:
    kleio.say "Так ты согласен?"

# ch/harems_full/pixie/events.rpy:834
translate russian morgan_kleio_event_03_alternate_5edd1772:
    kleio.say "Если считаешь, что справишься, конечно."

# ch/harems_full/pixie/events.rpy:835
translate russian morgan_kleio_event_03_alternate_248e7283:
    kleio.say "С мыслью о том, что мы втроём займёмся сексом?"

# ch/harems_full/pixie/events.rpy:836
translate russian morgan_kleio_event_03_alternate_f31be5c8:
    kleio.say "Тебе же наверняка интересно, чем мы с Морган занимались вместе, правда?"

# ch/harems_full/pixie/events.rpy:837
translate russian morgan_kleio_event_03_alternate_8aa68e6a:
    mike.say "Думаю, справлюсь, Клео."

# ch/harems_full/pixie/events.rpy:838
translate russian morgan_kleio_event_03_alternate_5c780775:
    mike.say "Только обещайте быть со мной нежными."

# ch/harems_full/pixie/events.rpy:840
translate russian morgan_kleio_event_03_alternate_6f326d40:
    "Клео наклоняется ближе."

# ch/harems_full/pixie/events.rpy:841
translate russian morgan_kleio_event_03_alternate_9d21b1f4:
    "В её голосе звучит насмешливая искренность."

# ch/harems_full/pixie/events.rpy:842
translate russian morgan_kleio_event_03_alternate_1fa57d40:
    kleio.say "О, конечно."

# ch/harems_full/pixie/events.rpy:843
translate russian morgan_kleio_event_03_alternate_153c20c4:
    kleio.say "Обещаю, мы будем нежными."

# ch/harems_full/pixie/events.rpy:846
translate russian morgan_kleio_event_03_alternate_b05b4ec9:
    kleio.say "Пока не перестанем..."

# ch/harems_full/pixie/events.rpy:848
translate russian morgan_kleio_event_03_alternate_a0aac9a1:
    "Она подмигивает, и я понимаю это как знак, что мы договорились."

# ch/harems_full/pixie/events.rpy:849
translate russian morgan_kleio_event_03_alternate_e298d183:
    "От одной мысли о том, что ждёт впереди, я невольно начинаю потеть."

# ch/harems_full/pixie/events.rpy:852
translate russian morgan_kleio_event_03_alternate_839defbf:
    "Признаю, с моей точки зрения предложение заманчивое."

# ch/harems_full/pixie/events.rpy:853
translate russian morgan_kleio_event_03_alternate_5b09fac7:
    "Какой парень откажется от отношений с двумя красотками вместо одной?"

# ch/harems_full/pixie/events.rpy:854
translate russian morgan_kleio_event_03_alternate_84386a34:
    "Но уж простите, настолько поверхностным я быть не могу."

# ch/harems_full/pixie/events.rpy:855
translate russian morgan_kleio_event_03_alternate_2afe6cd7:
    "Вся эта история с Клео и Морган была ужасной неразберихой."

# ch/harems_full/pixie/events.rpy:856
translate russian morgan_kleio_event_03_alternate_92697005:
    "Мы все трое ошибались и говорили то, чего не следовало."

# ch/harems_full/pixie/events.rpy:857
translate russian morgan_kleio_event_03_alternate_0b84e7b9:
    "Нам повезло, что в итоге у нас осталось хоть что-то, кроме горьких воспоминаний и разбитых сердец."

# ch/harems_full/pixie/events.rpy:858
translate russian morgan_kleio_event_03_alternate_3525cf68:
    "Поэтому я просто не могу согласиться."

# ch/harems_full/pixie/events.rpy:859
translate russian morgan_kleio_event_03_alternate_f5cea584:
    mike.say "Нет, Клео."

# ch/harems_full/pixie/events.rpy:860
translate russian morgan_kleio_event_03_alternate_5cfa6a03:
    mike.say "Не думаю, что это хорошая идея."

# ch/harems_full/pixie/events.rpy:861
translate russian morgan_kleio_event_03_alternate_2e1a168f:
    "Клео смотрит на меня так, будто не совсем поняла ответ."

# ch/harems_full/pixie/events.rpy:863
translate russian morgan_kleio_event_03_alternate_0f71a935:
    "Затем качает головой, словно этим движением проясняет мысли."

# ch/harems_full/pixie/events.rpy:865
translate russian morgan_kleio_event_03_alternate_efc18af0:
    kleio.say "Ты... ты серьёзно?"

# ch/harems_full/pixie/events.rpy:866
translate russian morgan_kleio_event_03_alternate_11e6cd11:
    kleio.say "Я ведь предлагаю тебе переспать со мной и ещё одной девушкой!"

# ch/harems_full/pixie/events.rpy:868
translate russian morgan_kleio_event_03_alternate_4c5173eb:
    kleio.say "Разве парни не о таком мечтают?"

# ch/harems_full/pixie/events.rpy:870
translate russian morgan_kleio_event_03_alternate_f047d4c5:
    mike.say "Не надо так, Клео."

# ch/harems_full/pixie/events.rpy:871
translate russian morgan_kleio_event_03_alternate_69b29cf3:
    mike.say "Я не такой."

# ch/harems_full/pixie/events.rpy:872
translate russian morgan_kleio_event_03_alternate_d3308c49:
    mike.say "И ты не такая девушка."

# ch/harems_full/pixie/events.rpy:873
translate russian morgan_kleio_event_03_alternate_ce349561:
    mike.say "Вы с Морган заслуживаете большего."

# ch/harems_full/pixie/events.rpy:877
translate russian morgan_kleio_event_03_alternate_1ac2d665:
    "Клео снова качает головой."

# ch/harems_full/pixie/events.rpy:878
translate russian morgan_kleio_event_03_alternate_ff8f2625:
    "Вижу, что мой ответ её сильно разочаровал."

# ch/harems_full/pixie/events.rpy:879
translate russian morgan_kleio_event_03_alternate_dbe733e6:
    "Но спорить со мной она, кажется, всё же не собирается."

# ch/harems_full/pixie/events.rpy:881
translate russian morgan_kleio_event_03_alternate_bbbe3794:
    kleio.say "Ах..."

# ch/harems_full/pixie/events.rpy:882
translate russian morgan_kleio_event_03_alternate_422dcdb0:
    kleio.say "Если ты действительно этого хочешь."

# ch/harems_full/pixie/events.rpy:884
translate russian morgan_kleio_event_03_alternate_39e16836:
    mike.say "Думаю, да, Клео."

# ch/harems_full/pixie/events.rpy:886
translate russian morgan_kleio_event_03_alternate_0f5fd5d9:
    "На этот раз она кивает."

# ch/harems_full/pixie/events.rpy:887
translate russian morgan_kleio_event_03_alternate_083f22b0:
    "И больше об этом не говорит."

# ch/harems_full/pixie/events.rpy:888
translate russian morgan_kleio_event_03_alternate_5c048a2a:
    "По крайней мере, пока."

# ch/harems_full/pixie/events.rpy:897
translate russian morgan_kleio_event_04_098c6caf:
    "Почему, когда пьян, чем сильнее стараешься вести себя тихо, тем громче получается?"

# ch/harems_full/pixie/events.rpy:898
translate russian morgan_kleio_event_04_7a8ee3bc:
    "В пабе мы с Клео и Морган, казалось, шумели не больше остальных."

# ch/harems_full/pixie/events.rpy:899
translate russian morgan_kleio_event_04_c02808a9:
    "Но теперь, когда мы добрались до моего дома, весь остальной мир словно погрузился в полную тишину."

# ch/harems_full/pixie/events.rpy:900
translate russian morgan_kleio_event_04_f9f665fb:
    "А мы превратились в троих неуклюжих, хихикающих идиотов с громкостью на максимуме!"

# ch/harems_full/pixie/events.rpy:901
translate russian morgan_kleio_event_04_fb96998b:
    "Пытаясь попасть ключом в замок входной двери, я кричу обеим, чтобы они вели себя тихо."

# ch/harems_full/pixie/events.rpy:902
translate russian morgan_kleio_event_04_2287aae5:
    mike.say "Тсс... тсс... за-замолчите!"

# ch/harems_full/pixie/events.rpy:903
translate russian morgan_kleio_event_04_dcb6347c:
    mike.say "Нам надо очень тихо..."

# ch/harems_full/pixie/events.rpy:906
translate russian morgan_kleio_event_04_c4ecdffe:
    "Клео и Морган, тесно прижавшись ко мне сзади, отвечают лишь новым приступом хихиканья и фырканья."

# ch/harems_full/pixie/events.rpy:907
translate russian morgan_kleio_event_04_a540c3d4:
    mike.say "Я серьёзно, ребята... и девчата!"

# ch/harems_full/pixie/events.rpy:908
translate russian morgan_kleio_event_04_ccecfa5b:
    mike.say "Соседки не должны нас услышать..."

# ch/harems_full/pixie/events.rpy:909
translate russian morgan_kleio_event_04_df66e276:
    mike.say "Они не должны знать, что мы собираемся заняться сексом втроём!"

# ch/harems_full/pixie/events.rpy:911
translate russian morgan_kleio_event_04_8e8ed57f:
    kleio.say "А... чем?"

# ch/harems_full/pixie/events.rpy:914
translate russian morgan_kleio_event_04_63a8584b:
    morgan.say "Ага, [lssb_common.hero_name()]... я не расслышала!"

# ch/harems_full/pixie/events.rpy:916
translate russian morgan_kleio_event_04_089acd83:
    "Будь я трезвее, наверняка просто покачал бы головой и не обратил внимания."

# ch/harems_full/pixie/events.rpy:917
translate russian morgan_kleio_event_04_551e24c4:
    "Но я не трезвее, поэтому так не делаю."

# ch/harems_full/pixie/events.rpy:918
translate russian morgan_kleio_event_04_211fa124:
    mike.say "Я сказал: соседки не должны знать, что мы тайком пробираемся заняться сексом втроём!"

# ch/harems_full/pixie/events.rpy:920
translate russian morgan_kleio_event_04_a498bcd8:
    kleio.say "Не-а, не слышу!"

# ch/harems_full/pixie/events.rpy:923
translate russian morgan_kleio_event_04_67be0292:
    morgan.say "Я тоже!"

# ch/harems_full/pixie/events.rpy:925
translate russian morgan_kleio_event_04_d6122d6e:
    mike.say "Уф... вы что, оглохли?"

# ch/harems_full/pixie/events.rpy:927
translate russian morgan_kleio_event_04_952908e0:
    mike.say "Я сказал... СОСЕДКИ НЕ ДОЛЖНЫ ЗНАТЬ, ЧТО МЫ ЗАЙМЁМСЯ СЕКСОМ ВТРОЁМ!"

# ch/harems_full/pixie/events.rpy:928
translate russian morgan_kleio_event_04_d255d77f:
    "Едва выкрикнув эти слова, я понимаю, что натворил."

# ch/harems_full/pixie/events.rpy:931
translate russian morgan_kleio_event_04_4409c198:
    "Клео и Морган тут же сгибаются от смеха, навалившись друг на друга."

# ch/harems_full/pixie/events.rpy:932
translate russian morgan_kleio_event_04_a108fd5d:
    morgan.say "Спасибо, [lssb_common.hero_name()]! Теперь-то я отлично расслышала!"

# ch/harems_full/pixie/events.rpy:934
translate russian morgan_kleio_event_04_66aa2e61:
    kleio.say "Ага, о соседках я бы на твоём месте не переживала, сердцеед."

# ch/harems_full/pixie/events.rpy:935
translate russian morgan_kleio_event_04_b09f6825:
    kleio.say "Лучше переживай о том, что теперь весь район знает о твоих планах!"

# ch/harems_full/pixie/events.rpy:937
translate russian morgan_kleio_event_04_18cbea7a:
    "К счастью, через пару секунд ключ и замок решают со мной сотрудничать."

# ch/harems_full/pixie/events.rpy:939
translate russian morgan_kleio_event_04_37676d78:
    "Входная дверь распахивается, и мы едва не падаем в прихожую; я держусь за ключ."

# ch/harems_full/pixie/events.rpy:940
translate russian morgan_kleio_event_04_cf8bf4f5:
    "Дальше я веду девушек по дому, крадучись на цыпочках, словно персонаж детского мультика."

# ch/harems_full/pixie/events.rpy:941
translate russian morgan_kleio_event_04_bf2faee7:
    "Наверное, больше мы не шумели. Или выбрали вечер, когда [bree.name] и Саша ушли из дома."

# ch/harems_full/pixie/events.rpy:942
translate russian morgan_kleio_event_04_5f961eb0:
    "Или они просто сжалились надо мной и решили не выходить с требованием объяснить происходящее."

# ch/harems_full/pixie/events.rpy:943
translate russian morgan_kleio_event_04_3f9542c7:
    "Неважно почему: главное, мы добрались до двери моей спальни."

# ch/harems_full/pixie/events.rpy:944
translate russian morgan_kleio_event_04_904faa21:
    "На ней замка нет, так что распахнуть её получается гораздо быстрее."

# ch/harems_full/pixie/events.rpy:946
translate russian morgan_kleio_event_04_0ec9b1db:
    "Едва я это делаю, Клео и Морган протискиваются мимо и спешат в комнату."

# ch/harems_full/pixie/events.rpy:947
translate russian morgan_kleio_event_04_8639f59a:
    "Они толкают меня то в одну, то в другую сторону, и я уже открываю рот, чтобы возмутиться."

# ch/harems_full/pixie/events.rpy:951
translate russian morgan_kleio_event_04_64ce5e63:
    "Но тут вижу, как они начинают стягивать друг с друга одежду прямо передо мной."

# ch/harems_full/pixie/events.rpy:952
translate russian morgan_kleio_event_04_bbbe44e5:
    "И вдруг вспоминаю, зачем мы здесь, удивляясь, как вообще мог забыть..."

# ch/harems_full/pixie/events.rpy:953
translate russian morgan_kleio_event_04_ceab13bf:
    "Закончив раздевать друг друга, Клео и Морган валятся на кровать."

# ch/harems_full/pixie/events.rpy:957
translate russian morgan_kleio_event_04_9022eac4:
    "Я смотрю, как их руки и ноги нетерпеливо переплетаются, а поцелуи становятся всё страстнее."

# ch/harems_full/pixie/events.rpy:958
translate russian morgan_kleio_event_04_3ee27c18:
    "Вида их переплетённых обнажённых тел вполне хватает, чтобы я совершенно замер."

# ch/harems_full/pixie/events.rpy:959
translate russian morgan_kleio_event_04_17cd4910:
    "Только когда обе останавливаются и смотрят мне прямо в глаза, я возвращаюсь к реальности."

# ch/harems_full/pixie/events.rpy:961
translate russian morgan_kleio_event_04_1e898bfa:
    kleio.say "Ты только посмотри на нашего сердцееда."

# ch/harems_full/pixie/events.rpy:962
translate russian morgan_kleio_event_04_ed1b4f9d:
    kleio.say "Он бы о собственный язык споткнулся, если бы мог с места сдвинуться!"

# ch/harems_full/pixie/events.rpy:965
translate russian morgan_kleio_event_04_9753b884:
    "Морган хихикает над словами Клео, но всё же манит меня к себе."

# ch/harems_full/pixie/events.rpy:967
translate russian morgan_kleio_event_04_046370be:
    morgan.say "Чего ждёшь, [lssb_common.hero_name()]?"

# ch/harems_full/pixie/events.rpy:968
translate russian morgan_kleio_event_04_b991b1ff:
    morgan.say "Ты ведь не собираешься только смотреть?"

# ch/harems_full/pixie/events.rpy:970
translate russian morgan_kleio_event_04_be9f458a:
    "Мне приходится буквально встряхнуться, чтобы прийти в себя."

# ch/harems_full/pixie/events.rpy:971
translate russian morgan_kleio_event_04_db3d798c:
    "Но, едва почувствовав себя снова здесь, я тоже начинаю раздеваться."

# ch/harems_full/pixie/events.rpy:972
translate russian morgan_kleio_event_04_8c673f7c:
    mike.say "Да... конечно, нет."

# ch/harems_full/pixie/events.rpy:973
translate russian morgan_kleio_event_04_77100ef5:
    mike.say "Просто засмотрелся на вас и... ну, на секунду выпал из реальности!"

# ch/harems_full/pixie/events.rpy:974
translate russian morgan_kleio_event_04_8bce8765:
    "Клео и Морган всё ещё хихикают, наблюдая, как я пытаюсь одновременно раздеться и пересечь комнату."

# ch/harems_full/pixie/events.rpy:975
translate russian morgan_kleio_event_04_d4348563:
    "Я едва добираюсь до кровати, не споткнувшись и не рухнув на пол."

# ch/harems_full/pixie/events.rpy:976
translate russian morgan_kleio_event_04_464b8592:
    "Но, когда я забираюсь к ним, они освобождают мне место, отползая к подушкам."

# ch/harems_full/pixie/events.rpy:977
translate russian morgan_kleio_event_04_faf5fb36:
    "Они снова целуются и ласкают друг друга, но теперь мне достаточно протянуть руку, чтобы прикоснуться."

# ch/harems_full/pixie/events.rpy:978
translate russian morgan_kleio_event_04_fbf51546:
    "И Клео, и Морган раздвинули бёдра, словно открыто приглашая меня."

# ch/harems_full/pixie/events.rpy:979
translate russian morgan_kleio_event_04_b512799e:
    "Обе выглядят невероятно соблазнительно, влажные и готовые принять меня."

# ch/harems_full/pixie/events.rpy:980
translate russian morgan_kleio_event_04_8966dd5e:
    "И на миг я понятия не имею, как выбрать между ними."

# ch/harems_full/pixie/events.rpy:981
translate russian morgan_kleio_event_04_3e0a0caa:
    "В конце концов решаю не выбирать."

# ch/harems_full/pixie/events.rpy:987
translate russian morgan_kleio_event_04_ff513490:
    "Я ложусь, устраивая голову между бёдер Клео, а член — между бёдер Морган."

# ch/harems_full/pixie/events.rpy:988
translate russian morgan_kleio_event_04_afae59aa:
    "Нечего и говорить, что член к этому моменту уже каменно-твёрдый."

# ch/harems_full/pixie/events.rpy:989
translate russian morgan_kleio_event_04_17c74da0:
    "Но мне всё же приходится поднять взгляд, чтобы убедиться, что он попадает куда нужно."

# ch/harems_full/pixie/events.rpy:992
translate russian morgan_kleio_event_04_fc501f01:
    "Стона Морган, прорвавшегося сквозь поцелуй с Клео, достаточно для подтверждения."

# ch/harems_full/pixie/events.rpy:993
translate russian morgan_kleio_event_04_cb6fc7d3:
    "Этот звук возбуждает меня ещё сильнее, и я вхожу так глубоко, как могу."

# ch/harems_full/pixie/events.rpy:998
translate russian morgan_kleio_event_04_c603518c:
    "Даже под таким углом тесная маленькая киска Морган ощущается невероятно."

# ch/harems_full/pixie/events.rpy:999
translate russian morgan_kleio_event_04_614eaf19:
    "Но нельзя же отдавать всё удовольствие Морган, оставляя Клео ни с чем, правда?"

# ch/harems_full/pixie/events.rpy:1003
translate russian morgan_kleio_event_04_1dcba493:
    "Раздвинув губы киски Клео, я начинаю дразнить её кончиком языка."

# ch/harems_full/pixie/events.rpy:1004
translate russian morgan_kleio_event_04_7373080d:
    "Её особенный вкус наполняет рот — будто лизнул контакт батарейки."

# ch/harems_full/pixie/events.rpy:1005
translate russian morgan_kleio_event_04_c22b585f:
    "Морган сейчас получает мой член на всю длину."

# ch/harems_full/pixie/events.rpy:1007
translate russian morgan_kleio_event_04_e6e3e8a5:
    "Зато язык даёт гораздо больше простора для выдумки, в чём Клео вскоре убеждается."

# ch/harems_full/pixie/events.rpy:1008
translate russian morgan_kleio_event_04_2b3f05cc:
    "Я всё глубже исследую складки её киски, и она тоже начинает издавать звуки."

# ch/harems_full/pixie/events.rpy:1009
translate russian morgan_kleio_event_04_62100be0:
    "Пока Морган стонет от моего члена внутри, Клео вскрикивает и взвизгивает от моих ласк."

# ch/harems_full/pixie/events.rpy:1011
translate russian morgan_kleio_event_04_4317d8f6:
    "Улучив миг и подняв глаза, я вижу, как её щёки заливаются румянцем, а глаза закатываются."

# ch/harems_full/pixie/events.rpy:1012
translate russian morgan_kleio_event_04_be71bfea:
    "Это лишь заставляет меня удвоить усилия для обеих."

# ch/harems_full/pixie/events.rpy:1017
translate russian morgan_kleio_event_04_a6a1e303:
    "Я вижу, как движения члена в Морган и языка в киске Клео всё ближе подводят их к краю."

# ch/harems_full/pixie/events.rpy:1018
translate russian morgan_kleio_event_04_22366faa:
    "Теперь им едва удаётся продолжать прижиматься губами друг к другу."

# ch/harems_full/pixie/events.rpy:1022
translate russian morgan_kleio_event_04_caf1ae39:
    "И Клео, и Морган извиваются на кровати под моими ласками."

# ch/harems_full/pixie/events.rpy:1023
translate russian morgan_kleio_event_04_de4ad2e1:
    "Недолго осталось до того, как одна из них бурно кончит."

# ch/harems_full/pixie/events.rpy:1024
translate russian morgan_kleio_event_04_ee68611e:
    "Но мгновение спустя толчок внизу живота подсказывает, что я могу их опередить..."

# ch/harems_full/pixie/events.rpy:1027
translate russian morgan_kleio_event_04_992f6a39:
    "Я и не пытаюсь выйти из Морган, продолжая двигаться в ней до самого последнего мгновения."

# ch/harems_full/pixie/events.rpy:1030
translate russian morgan_kleio_event_04_feb0f9b0:
    "Словно в ответ на то, что я кончаю внутри неё, Морган ещё теснее притягивает Клео."

# ch/harems_full/pixie/events.rpy:1032
translate russian morgan_kleio_event_04_2ccb63b9:
    "Я смотрю, как она буквально безжалостно проталкивает язык в рот другой девушке."

# ch/harems_full/pixie/events.rpy:1033
translate russian morgan_kleio_event_04_24dbd2c6:
    "Клео остаётся лишь уступить Морган и отвечать на поцелуй, как получается."

# ch/harems_full/pixie/events.rpy:1035
translate russian morgan_kleio_event_04_1d6d8eb6:
    "Я продолжаю входить в неё, тратя остатки сил."

# ch/harems_full/pixie/events.rpy:1036
translate russian morgan_kleio_event_04_77c92385:
    "Но не могу отделаться от мысли, что Морган орудует языком так же, как я — членом."

# ch/harems_full/pixie/events.rpy:1038
translate russian morgan_kleio_event_04_4b29b97a:
    "Чем глубже я вхожу в её киску, тем глубже она проталкивает язык в горло Клео!"

# ch/harems_full/pixie/events.rpy:1039
translate russian morgan_kleio_event_04_4eed07f0:
    "В конце концов я уже не понимаю, задыхается ли Клео от оргазма или от настоящего страха задохнуться!"

# ch/harems_full/pixie/events.rpy:1040
translate russian morgan_kleio_event_04_7359c715:
    "Но когда всё стихает и остаётся лишь усталая нега, ни жалоб, ни упрёков не слышно."

# ch/harems_full/pixie/events.rpy:1041
translate russian morgan_kleio_event_04_b50a1dd4:
    "Только тяжёлое дыхание троих людей, лежащих в переплетении потных рук и ног."

# ch/harems_full/pixie/events.rpy:1042
translate russian morgan_kleio_event_04_496acaad:
    "Вообще-то тише за весь вечер мы ещё не были."

# ch/harems_full/pixie/events.rpy:1046
translate russian morgan_kleio_event_04_dea5cffd:
    "Без предупреждения я вынимаю член из Морган, а затем убираю язык от Клео."

# ch/harems_full/pixie/events.rpy:1047
translate russian morgan_kleio_event_04_ce1d8c5c:
    "Как я и надеялся, внезапное прекращение ласк тут же привлекает внимание обеих."

# ch/harems_full/pixie/events.rpy:1052
translate russian morgan_kleio_event_04_3540a911:
    kleio.say "Эй... ты чего?!"

# ch/harems_full/pixie/events.rpy:1053
translate russian morgan_kleio_event_04_668da4ed:
    morgan.say "Ну-у, так нечестно!"

# ch/harems_full/pixie/events.rpy:1054
translate russian morgan_kleio_event_04_4390b967:
    "Не обращая внимания на протесты, я встаю с кровати и маню их за собой."

# ch/harems_full/pixie/events.rpy:1055
translate russian morgan_kleio_event_04_ed742c80:
    "Сначала они смотрят раздражённо и озадаченно, не понимая намёка."

# ch/harems_full/pixie/events.rpy:1056
translate russian morgan_kleio_event_04_00c10654:
    "Но затем одной рукой я показываю на пол перед собой."

# ch/harems_full/pixie/events.rpy:1057
translate russian morgan_kleio_event_04_62b00cbe:
    "А другой в это время поглаживаю член, всё ещё скользкий от киски Морган."

# ch/harems_full/pixie/events.rpy:1058
translate russian morgan_kleio_event_04_1400b6cf:
    "Первой, кажется, догадывается Клео: она соскальзывает с кровати и зовёт Морган за собой."

# ch/harems_full/pixie/events.rpy:1059
translate russian morgan_kleio_event_04_8053d55b:
    "Когда до той доходит, её глаза расширяются, а на лице появляется улыбка."

# ch/harems_full/pixie/events.rpy:1064
translate russian morgan_kleio_event_04_17dba3e1:
    "Мгновение спустя обе уже стоят передо мной на коленях."

# ch/harems_full/pixie/events.rpy:1065
translate russian morgan_kleio_event_04_75cec27d:
    "Словно две выпрашивающие угощение сучки, Клео и Морган молча ждут с открытыми ртами."

# ch/harems_full/pixie/events.rpy:1069
translate russian morgan_kleio_event_04_fd86902a:
    "Первая струя спермы каким-то образом попадает на лица обеих."

# ch/harems_full/pixie/events.rpy:1071
translate russian morgan_kleio_event_04_525523a2:
    "Они удивлённо смеются, и следующая струя достаётся языкам и губам."

# ch/harems_full/pixie/events.rpy:1073
translate russian morgan_kleio_event_04_689d451f:
    "Вскоре обе покрыты спермой и, улыбаясь и хихикая, слизывают её."

# ch/harems_full/pixie/events.rpy:1080
translate russian morgan_kleio_event_05_6a17e041:
    "Знаете это чувство, когда просто сидишь, никого не трогаешь и ничего не подозреваешь?"

# ch/harems_full/pixie/events.rpy:1081
translate russian morgan_kleio_event_05_10c4cdbc:
    "А потом вдруг странным образом чувствуешь, что на тебя смотрят?"

# ch/harems_full/pixie/events.rpy:1082
translate russian morgan_kleio_event_05_60d86a3a:
    "Вот именно это сейчас происходит со мной в пабе."

# ch/harems_full/pixie/events.rpy:1083
translate russian morgan_kleio_event_05_84942864:
    "Я всего лишь пришёл расслабиться за холодным пивом и забыть о проблемах."

# ch/harems_full/pixie/events.rpy:1084
translate russian morgan_kleio_event_05_1228100b:
    "Но теперь невольно поднимаю глаза, чтобы понять, кто на меня смотрит."

# ch/harems_full/pixie/events.rpy:1086
translate russian morgan_kleio_event_05_d49c216f:
    kleio.say "Привет, сердцеед!"

# ch/harems_full/pixie/events.rpy:1087
translate russian morgan_kleio_event_05_e9dbc84c:
    kleio.say "Чем занят?"

# ch/harems_full/pixie/events.rpy:1090
translate russian morgan_kleio_event_05_ebb91d3d:
    morgan.say "Ага, дружище."

# ch/harems_full/pixie/events.rpy:1091
translate russian morgan_kleio_event_05_398e44c4:
    morgan.say "Вот это мы на тебя наткнулись!"

# ch/harems_full/pixie/events.rpy:1093
translate russian morgan_kleio_event_05_a319a7d3:
    morgan.say "Привет, [lssb_common.hero_name()]..."

# ch/harems_full/pixie/events.rpy:1094
translate russian morgan_kleio_event_05_44d12c98:
    morgan.say "Какое совпадение, ты тоже здесь!"

# ch/harems_full/pixie/events.rpy:1096
translate russian morgan_kleio_event_05_68ec701b:
    morgan.say "О, привет, [lssb_common.hero_name()]..."

# ch/harems_full/pixie/events.rpy:1097
translate russian morgan_kleio_event_05_8a4d059b:
    morgan.say "Вот уж не ожидала тебя здесь увидеть!"

# ch/harems_full/pixie/events.rpy:1099
translate russian morgan_kleio_event_05_430cb0e7:
    "Я перевожу взгляд с Клео на Морган и хмурюсь."

# ch/harems_full/pixie/events.rpy:1100
translate russian morgan_kleio_event_05_1e4d97e0:
    "Что-то тут нечисто."

# ch/harems_full/pixie/events.rpy:1101
translate russian morgan_kleio_event_05_588158f4:
    mike.say "Ага, девчонки..."

# ch/harems_full/pixie/events.rpy:1102
translate russian morgan_kleio_event_05_993afcc6:
    mike.say "Вот это вероятность — случайно найти меня в моём обычном пабе!"

# ch/harems_full/pixie/events.rpy:1103
translate russian morgan_kleio_event_05_f7255894:
    mike.say "Буквально в ближайшем к дому месте, куда я вообще хожу!"

# ch/harems_full/pixie/events.rpy:1104
translate russian morgan_kleio_event_05_56d6a947:
    mike.say "Вы ведь совершенно случайно не заглянули сначала ко мне домой?"

# ch/harems_full/pixie/events.rpy:1106
translate russian morgan_kleio_event_05_e97d150b:
    kleio.say "Господи, сердцеед..."

# ch/harems_full/pixie/events.rpy:1107
translate russian morgan_kleio_event_05_779d8526:
    kleio.say "Ты себя вообще слышишь?"

# ch/harems_full/pixie/events.rpy:1108
translate russian morgan_kleio_event_05_8d68992b:
    kleio.say "Звучишь как законченный параноик!"

# ch/harems_full/pixie/events.rpy:1110
translate russian morgan_kleio_event_05_6c110db1:
    "Я закатываю глаза в ответ на жалкую попытку Клео увести разговор в сторону."

# ch/harems_full/pixie/events.rpy:1111
translate russian morgan_kleio_event_05_f5111c73:
    "Но не успеваю сказать ни слова, как вмешивается Морган."

# ch/harems_full/pixie/events.rpy:1113
translate russian morgan_kleio_event_05_f049f16c:
    morgan.say "Неважно."

# ch/harems_full/pixie/events.rpy:1114
translate russian morgan_kleio_event_05_1c5dda3e:
    morgan.say "Нам нужно кое-что спросить."

# ch/harems_full/pixie/events.rpy:1116
translate russian morgan_kleio_event_05_aa642a7f:
    morgan.say "Ладно-ладно..."

# ch/harems_full/pixie/events.rpy:1117
translate russian morgan_kleio_event_05_aa3eae3d:
    morgan.say "У нас к тебе важный вопрос!"

# ch/harems_full/pixie/events.rpy:1119
translate russian morgan_kleio_event_05_c361638a:
    morgan.say "Да перестань, Клео!"

# ch/harems_full/pixie/events.rpy:1120
translate russian morgan_kleio_event_05_5c87a2f3:
    morgan.say "Так мы никогда его не спросим!"

# ch/harems_full/pixie/events.rpy:1121
translate russian morgan_kleio_event_05_fb42d8e1:
    "Теперь они меня заинтриговали."

# ch/harems_full/pixie/events.rpy:1122
translate russian morgan_kleio_event_05_11a2bb34:
    mike.say "Что именно спросить?"

# ch/harems_full/pixie/events.rpy:1124
translate russian morgan_kleio_event_05_b304040f:
    "Клео хмуро смотрит в сторону Морган."

# ch/harems_full/pixie/events.rpy:1125
translate russian morgan_kleio_event_05_62880e06:
    "Ей явно не нравится, что веселье прервали."

# ch/harems_full/pixie/events.rpy:1126
translate russian morgan_kleio_event_05_510ad2c2:
    kleio.say "Ладно, Морган!"

# ch/harems_full/pixie/events.rpy:1127
translate russian morgan_kleio_event_05_2691bd6f:
    kleio.say "Нечего ходить вокруг да около!"

# ch/harems_full/pixie/events.rpy:1129
translate russian morgan_kleio_event_05_c8a8aa87:
    kleio.say "Ну... ты понимаешь, о чём я!"

# ch/harems_full/pixie/events.rpy:1130
translate russian morgan_kleio_event_05_fa3c3664:
    "Я поднимаю брови и смотрю на Морган."

# ch/harems_full/pixie/events.rpy:1131
translate russian morgan_kleio_event_05_467327ae:
    "Кажется, Клео сказала что-то, что её смутило."

# ch/harems_full/pixie/events.rpy:1132
translate russian morgan_kleio_event_05_b26ef587:
    "Хотя я понятия не имею почему."

# ch/harems_full/pixie/events.rpy:1135
translate russian morgan_kleio_event_05_49565506:
    morgan.say "Сразу к делу, [lssb_common.hero_name()]."

# ch/harems_full/pixie/events.rpy:1136
translate russian morgan_kleio_event_05_ea87151d:
    morgan.say "Помнишь, как мы напились и потрахались?"

# ch/harems_full/pixie/events.rpy:1138
translate russian morgan_kleio_event_05_9b38526f:
    morgan.say "Вот в чём дело, [lssb_common.hero_name()]..."

# ch/harems_full/pixie/events.rpy:1139
translate russian morgan_kleio_event_05_fdfc89a7:
    morgan.say "Помнишь, как мы все... ну, сделали это вместе?"

# ch/harems_full/pixie/events.rpy:1141
translate russian morgan_kleio_event_05_3ef50cd5:
    morgan.say "Даже не знаю, как сказать, [lssb_common.hero_name()]."

# ch/harems_full/pixie/events.rpy:1142
translate russian morgan_kleio_event_05_f6b2d229:
    morgan.say "Но помнишь, как мы все... кое-чем вместе занимались?"

# ch/harems_full/pixie/events.rpy:1143
translate russian morgan_kleio_event_05_7ffd12fc:
    mike.say "Конечно, помню!"

# ch/harems_full/pixie/events.rpy:1144
translate russian morgan_kleio_event_05_fe61edcb:
    mike.say "Разве такую ночь забудешь?!"

# ch/harems_full/pixie/events.rpy:1147
translate russian morgan_kleio_event_05_c2fecf94:
    "Моя реакция явно радует и Клео, и Морган."

# ch/harems_full/pixie/events.rpy:1148
translate russian morgan_kleio_event_05_672f5b68:
    "Но затем они замечают, что видят радость друг друга."

# ch/harems_full/pixie/events.rpy:1149
translate russian morgan_kleio_event_05_884dd4ba:
    "И тут же пытаются вернуть лицам невозмутимое выражение."

# ch/harems_full/pixie/events.rpy:1152
translate russian morgan_kleio_event_05_189e00ce:
    kleio.say "Ага, ну..."

# ch/harems_full/pixie/events.rpy:1153
translate russian morgan_kleio_event_05_d830b745:
    kleio.say "Мы решили, что тебе наверняка хочется ещё."

# ch/harems_full/pixie/events.rpy:1155
translate russian morgan_kleio_event_05_c7a68c60:
    kleio.say "Наверняка слюной на нас исходишь, похотливый пёс!"

# ch/harems_full/pixie/events.rpy:1159
translate russian morgan_kleio_event_05_741b74ae:
    morgan.say "Ну?!"

# ch/harems_full/pixie/events.rpy:1160
translate russian morgan_kleio_event_05_2f24d27b:
    morgan.say "Хочешь ещё раз втроём или нет?"

# ch/harems_full/pixie/events.rpy:1162
translate russian morgan_kleio_event_05_2afe0055:
    morgan.say "Ты немного перегибаешь, Клео!"

# ch/harems_full/pixie/events.rpy:1163
translate russian morgan_kleio_event_05_8b621d7c:
    morgan.say "Но всё же: как тебе идея?"

# ch/harems_full/pixie/events.rpy:1165
translate russian morgan_kleio_event_05_34b77fc9:
    morgan.say "Фу, Клео!"

# ch/harems_full/pixie/events.rpy:1166
translate russian morgan_kleio_event_05_7aa11787:
    morgan.say "Не слушай её, [lssb_common.hero_name()]."

# ch/harems_full/pixie/events.rpy:1167
translate russian morgan_kleio_event_05_0a99c4e7:
    morgan.say "Но ты ведь хочешь снова сделать это с нами?"

# ch/harems_full/pixie/events.rpy:1170
translate russian morgan_kleio_event_05_39e167c4:
    "Будто мне вообще нужно думать над ответом!"

# ch/harems_full/pixie/events.rpy:1171
translate russian morgan_kleio_event_05_ef4f01bc:
    "Да, сейчас они вели себя со мной довольно грубо."

# ch/harems_full/pixie/events.rpy:1172
translate russian morgan_kleio_event_05_6c085b97:
    "Подошли, уверенные, что у меня нет дел получше."

# ch/harems_full/pixie/events.rpy:1173
translate russian morgan_kleio_event_05_025bbae4:
    "Но правда в том, что лучше секса с Клео и Морган ничего и нет!"

# ch/harems_full/pixie/events.rpy:1174
translate russian morgan_kleio_event_05_677d03a9:
    mike.say "Вы что, считаете меня полным идиотом?!"

# ch/harems_full/pixie/events.rpy:1175
translate russian morgan_kleio_event_05_2273eb9e:
    mike.say "Конечно, я хочу снова заняться с вами сексом втроём!"

# ch/harems_full/pixie/events.rpy:1176
translate russian morgan_kleio_event_05_62f47c5a:
    mike.say "Когда всё устроим?"

# ch/harems_full/pixie/events.rpy:1177
translate russian morgan_kleio_event_05_75f7b105:
    "Клео и Морган обмениваются понимающими взглядами."

# ch/harems_full/pixie/events.rpy:1178
translate russian morgan_kleio_event_05_85a21b3a:
    "Теперь развитие событий явно радует их гораздо больше."

# ch/harems_full/pixie/events.rpy:1181
translate russian morgan_kleio_event_05_0d08166b:
    kleio.say "Притормози, сердцеед!"

# ch/harems_full/pixie/events.rpy:1182
translate russian morgan_kleio_event_05_e1dd5951:
    kleio.say "Мы ещё уточняем детали."

# ch/harems_full/pixie/events.rpy:1184
translate russian morgan_kleio_event_05_b1b4dab0:
    morgan.say "Просто будь готов предоставить член, когда мы будем готовы, ладно?"

# ch/harems_full/pixie/events.rpy:1186
translate russian morgan_kleio_event_05_cd252d64:
    morgan.say "Ни о чём не переживай, [lssb_common.hero_name()]."

# ch/harems_full/pixie/events.rpy:1187
translate russian morgan_kleio_event_05_3b0a6363:
    morgan.say "Это будет совсем скоро, обещаю!"

# ch/harems_full/pixie/events.rpy:1189
translate russian morgan_kleio_event_05_7d3c7e9c:
    morgan.say "Ох, надеюсь, совсем скоро!"

# ch/harems_full/pixie/events.rpy:1190
translate russian morgan_kleio_event_05_09742fbe:
    morgan.say "Мне тоже не терпится!"

# ch/harems_full/pixie/events.rpy:1191
translate russian morgan_kleio_event_05_7b107c3d:
    "Мы быстро обо всём договариваемся."

# ch/harems_full/pixie/events.rpy:1192
translate russian morgan_kleio_event_05_b6cbb4e8:
    "И к тому моменту, когда выходим из паба, все уже в предвкушении."

# ch/harems_full/pixie/events.rpy:1193
translate russian morgan_kleio_event_05_3781400c:
    "Теперь мне остаётся лишь оправдать их ожидания..."

# ch/harems_full/pixie/events.rpy:1200
translate russian morgan_kleio_event_05_1d97d51b:
    "Конечно, какая-то часть меня хочет немедленно согласиться на секс втроём."

# ch/harems_full/pixie/events.rpy:1201
translate russian morgan_kleio_event_05_ac029ee4:
    "И вы наверняка догадываетесь, какая именно, правда?"

# ch/harems_full/pixie/events.rpy:1202
translate russian morgan_kleio_event_05_a826463e:
    "Но я всё ещё злюсь на Клео и Морган за то, что не дали спокойно выпить."

# ch/harems_full/pixie/events.rpy:1203
translate russian morgan_kleio_event_05_14a39867:
    "Да и деликатностью они сейчас не отличаются."

# ch/harems_full/pixie/events.rpy:1204
translate russian morgan_kleio_event_05_e92d3080:
    "Поэтому хочется поставить их на место."

# ch/harems_full/pixie/events.rpy:1205
translate russian morgan_kleio_event_05_cdf99374:
    "Напомнить, что я существую не только ради их развлечения и удовольствия."

# ch/harems_full/pixie/events.rpy:1206
translate russian morgan_kleio_event_05_e13abecb:
    mike.say "Знаете что? Думаю, я откажусь."

# ch/harems_full/pixie/events.rpy:1207
translate russian morgan_kleio_event_05_b9f1b971:
    mike.say "Я сейчас просто не в том настроении."

# ch/harems_full/pixie/events.rpy:1210
translate russian morgan_kleio_event_05_e47cddff:
    "И Клео, и Морган выглядят так, будто получили пощёчину."

# ch/harems_full/pixie/events.rpy:1211
translate russian morgan_kleio_event_05_27e55bbd:
    "Ни одна не может поверить, что я действительно им отказал."

# ch/harems_full/pixie/events.rpy:1212
translate russian morgan_kleio_event_05_124f71d5:
    kleio.say "Ты ведь понимаешь, что мы предлагаем не просто посмотреть?"

# ch/harems_full/pixie/events.rpy:1213
translate russian morgan_kleio_event_05_965df7c4:
    kleio.say "Правда, сердцеед?"

# ch/harems_full/pixie/events.rpy:1215
translate russian morgan_kleio_event_05_ff9c0db1:
    morgan.say "Ага, [lssb_common.hero_name()]..."

# ch/harems_full/pixie/events.rpy:1216
translate russian morgan_kleio_event_05_e8632ecc:
    morgan.say "С нас киски, с тебя член!"

# ch/harems_full/pixie/events.rpy:1218
translate russian morgan_kleio_event_05_812be26f:
    morgan.say "Ничего себе..."

# ch/harems_full/pixie/events.rpy:1219
translate russian morgan_kleio_event_05_b1e17beb:
    morgan.say "Даже не знаю, как это воспринимать!"

# ch/harems_full/pixie/events.rpy:1221
translate russian morgan_kleio_event_05_6c5c6161:
    morgan.say "Что?!"

# ch/harems_full/pixie/events.rpy:1222
translate russian morgan_kleio_event_05_e76a35e4:
    morgan.say "По-моему, это просто подло!"

# ch/harems_full/pixie/events.rpy:1224
translate russian morgan_kleio_event_05_4890f298:
    "Я отмахиваюсь от их протестов."

# ch/harems_full/pixie/events.rpy:1225
translate russian morgan_kleio_event_05_74ee3b80:
    mike.say "Простите, дамы."

# ch/harems_full/pixie/events.rpy:1226
translate russian morgan_kleio_event_05_7397b96a:
    mike.say "Придётся найти себе другой аттракцион."

# ch/harems_full/pixie/events.rpy:1227
translate russian morgan_kleio_event_05_16b35611:
    mike.say "Этот закрыт на техобслуживание!"

# ch/harems_full/pixie/events.rpy:1229
translate russian morgan_kleio_event_05_11af3a6e:
    kleio.say "А по-моему, его давно пора списать как гнилой!"

# ch/harems_full/pixie/events.rpy:1230
translate russian morgan_kleio_event_05_5dc98664:
    "Клео и Морган разворачиваются и сердито выходят из паба."

# ch/harems_full/pixie/events.rpy:1234
translate russian morgan_kleio_event_05_76cb25ed:
    "А я наконец могу спокойно допить."

# ch/harems_full/pixie/events.rpy:1241
translate russian pixie_threesome_ea911bab:
    "Со временем я замечаю, что Клео что-то задумала."

# ch/harems_full/pixie/events.rpy:1244
translate russian pixie_threesome_c494301f:
    kleio.say "Эй, ребята, как насчёт... ну, вы понимаете."

# ch/harems_full/pixie/events.rpy:1245
translate russian pixie_threesome_2aa8843f:
    morgan.say "А, да! В прошлый раз было довольно весело."

# ch/harems_full/pixie/events.rpy:1246
translate russian pixie_threesome_997eefb3:
    kleio.say "Что скажешь, сердцеед?"

# ch/harems_full/pixie/events.rpy:1247
translate russian pixie_threesome_29bbe8c1:
    mike.say "Пошли!"

# ch/harems_full/pixie/events.rpy:1252
translate russian pixie_threesome_2397b3b9:
    "Вскоре мы уже в моей спальне."

# ch/harems_full/pixie/events.rpy:1253
translate russian pixie_threesome_c4565f0c:
    "Клео и Морган уже начинают стягивать друг с друга одежду."

# ch/harems_full/pixie/events.rpy:1254
translate russian pixie_threesome_ceab13bf:
    "Закончив раздевать друг друга, Клео и Морган валятся на кровать."

# ch/harems_full/pixie/events.rpy:1257
translate russian pixie_threesome_9022eac4:
    "Я смотрю, как их руки и ноги нетерпеливо переплетаются, а поцелуи становятся всё страстнее."

# ch/harems_full/pixie/events.rpy:1258
translate russian pixie_threesome_3ee27c18:
    "Вида их переплетённых обнажённых тел вполне хватает, чтобы я совершенно замер."

# ch/harems_full/pixie/events.rpy:1259
translate russian pixie_threesome_17cd4910:
    "Только когда обе останавливаются и смотрят мне прямо в глаза, я возвращаюсь к реальности."

# ch/harems_full/pixie/events.rpy:1261
translate russian pixie_threesome_1e898bfa:
    kleio.say "Ты только посмотри на нашего сердцееда."

# ch/harems_full/pixie/events.rpy:1262
translate russian pixie_threesome_ed1b4f9d:
    kleio.say "Он бы о собственный язык споткнулся, если бы мог с места сдвинуться!"

# ch/harems_full/pixie/events.rpy:1263
translate russian pixie_threesome_9753b884:
    "Морган хихикает над словами Клео, но всё же манит меня к себе."

# ch/harems_full/pixie/events.rpy:1265
translate russian pixie_threesome_046370be:
    morgan.say "Чего ждёшь, [lssb_common.hero_name()]?"

# ch/harems_full/pixie/events.rpy:1266
translate russian pixie_threesome_b991b1ff:
    morgan.say "Ты ведь не собираешься только смотреть?"

# ch/harems_full/pixie/events.rpy:1267
translate russian pixie_threesome_be9f458a:
    "Мне приходится буквально встряхнуться, чтобы прийти в себя."

# ch/harems_full/pixie/events.rpy:1268
translate russian pixie_threesome_db3d798c:
    "Но, едва почувствовав себя снова здесь, я тоже начинаю раздеваться."

# ch/harems_full/pixie/events.rpy:1269
translate russian pixie_threesome_8c673f7c:
    mike.say "Да... конечно, нет."

# ch/harems_full/pixie/events.rpy:1270
translate russian pixie_threesome_77100ef5:
    mike.say "Просто засмотрелся на вас и... ну, на секунду выпал из реальности!"

# ch/harems_full/pixie/events.rpy:1271
translate russian pixie_threesome_8bce8765:
    "Клео и Морган всё ещё хихикают, наблюдая, как я пытаюсь одновременно раздеться и пересечь комнату."

# ch/harems_full/pixie/events.rpy:1272
translate russian pixie_threesome_d57ef9ea:
    "Когда я забираюсь на кровать, они освобождают мне место, отползая к подушкам."

# ch/harems_full/pixie/events.rpy:1273
translate russian pixie_threesome_faf5fb36:
    "Они снова целуются и ласкают друг друга, но теперь мне достаточно протянуть руку, чтобы прикоснуться."

# ch/harems_full/pixie/events.rpy:1274
translate russian pixie_threesome_fbf51546:
    "И Клео, и Морган раздвинули бёдра, словно открыто приглашая меня."

# ch/harems_full/pixie/events.rpy:1275
translate russian pixie_threesome_b512799e:
    "Обе выглядят невероятно соблазнительно, влажные и готовые принять меня."

# ch/harems_full/pixie/events.rpy:1276
translate russian pixie_threesome_8966dd5e:
    "И на миг я понятия не имею, как выбрать между ними."

# ch/harems_full/pixie/events.rpy:1277
translate russian pixie_threesome_3e0a0caa:
    "В конце концов решаю не выбирать."

# ch/harems_full/pixie/events.rpy:1282
translate russian pixie_threesome_ff513490:
    "Я ложусь, устраивая голову между бёдер Клео, а член — между бёдер Морган."

# ch/harems_full/pixie/events.rpy:1283
translate russian pixie_threesome_afae59aa:
    "Нечего и говорить, что член к этому моменту уже каменно-твёрдый."

# ch/harems_full/pixie/events.rpy:1284
translate russian pixie_threesome_17c74da0:
    "Но мне всё же приходится поднять взгляд, чтобы убедиться, что он попадает куда нужно."

# ch/harems_full/pixie/events.rpy:1287
translate russian pixie_threesome_fc501f01:
    "Стона Морган, прорвавшегося сквозь поцелуй с Клео, достаточно для подтверждения."

# ch/harems_full/pixie/events.rpy:1290
translate russian pixie_threesome_cb6fc7d3:
    "Этот звук возбуждает меня ещё сильнее, и я вхожу так глубоко, как могу."

# ch/harems_full/pixie/events.rpy:1295
translate russian pixie_threesome_c603518c:
    "Даже под таким углом тесная маленькая киска Морган ощущается невероятно."

# ch/harems_full/pixie/events.rpy:1296
translate russian pixie_threesome_614eaf19:
    "Но нельзя же отдавать всё удовольствие Морган, оставляя Клео ни с чем, правда?"

# ch/harems_full/pixie/events.rpy:1300
translate russian pixie_threesome_1dcba493:
    "Раздвинув губы киски Клео, я начинаю дразнить её кончиком языка."

# ch/harems_full/pixie/events.rpy:1301
translate russian pixie_threesome_7373080d:
    "Её особенный вкус наполняет рот — будто лизнул контакт батарейки."

# ch/harems_full/pixie/events.rpy:1302
translate russian pixie_threesome_c22b585f:
    "Морган сейчас получает мой член на всю длину."

# ch/harems_full/pixie/events.rpy:1304
translate russian pixie_threesome_e6e3e8a5:
    "Зато язык даёт гораздо больше простора для выдумки, в чём Клео вскоре убеждается."

# ch/harems_full/pixie/events.rpy:1305
translate russian pixie_threesome_2b3f05cc:
    "Я всё глубже исследую складки её киски, и она тоже начинает издавать звуки."

# ch/harems_full/pixie/events.rpy:1306
translate russian pixie_threesome_62100be0:
    "Пока Морган стонет от моего члена внутри, Клео вскрикивает и взвизгивает от моих ласк."

# ch/harems_full/pixie/events.rpy:1308
translate russian pixie_threesome_4317d8f6:
    "Улучив миг и подняв глаза, я вижу, как её щёки заливаются румянцем, а глаза закатываются."

# ch/harems_full/pixie/events.rpy:1309
translate russian pixie_threesome_be71bfea:
    "Это лишь заставляет меня удвоить усилия для обеих."

# ch/harems_full/pixie/events.rpy:1314
translate russian pixie_threesome_a6a1e303:
    "Я вижу, как движения члена в Морган и языка в киске Клео всё ближе подводят их к краю."

# ch/harems_full/pixie/events.rpy:1315
translate russian pixie_threesome_22366faa:
    "Теперь им едва удаётся продолжать прижиматься губами друг к другу."

# ch/harems_full/pixie/events.rpy:1319
translate russian pixie_threesome_caf1ae39:
    "И Клео, и Морган извиваются на кровати под моими ласками."

# ch/harems_full/pixie/events.rpy:1320
translate russian pixie_threesome_de4ad2e1:
    "Недолго осталось до того, как одна из них бурно кончит."

# ch/harems_full/pixie/events.rpy:1321
translate russian pixie_threesome_ee68611e:
    "Но мгновение спустя толчок внизу живота подсказывает, что я могу их опередить..."

# ch/harems_full/pixie/events.rpy:1324
translate russian pixie_threesome_992f6a39:
    "Я и не пытаюсь выйти из Морган, продолжая двигаться в ней до самого последнего мгновения."

# ch/harems_full/pixie/events.rpy:1327
translate russian pixie_threesome_feb0f9b0:
    "Словно в ответ на то, что я кончаю внутри неё, Морган ещё теснее притягивает Клео."

# ch/harems_full/pixie/events.rpy:1329
translate russian pixie_threesome_2ccb63b9:
    "Я смотрю, как она буквально безжалостно проталкивает язык в рот другой девушке."

# ch/harems_full/pixie/events.rpy:1330
translate russian pixie_threesome_24dbd2c6:
    "Клео остаётся лишь уступить Морган и отвечать на поцелуй, как получается."

# ch/harems_full/pixie/events.rpy:1332
translate russian pixie_threesome_1d6d8eb6:
    "Я продолжаю входить в неё, тратя остатки сил."

# ch/harems_full/pixie/events.rpy:1333
translate russian pixie_threesome_77c92385:
    "Но не могу отделаться от мысли, что Морган орудует языком так же, как я — членом."

# ch/harems_full/pixie/events.rpy:1335
translate russian pixie_threesome_4b29b97a:
    "Чем глубже я вхожу в её киску, тем глубже она проталкивает язык в горло Клео!"

# ch/harems_full/pixie/events.rpy:1336
translate russian pixie_threesome_4eed07f0:
    "В конце концов я уже не понимаю, задыхается ли Клео от оргазма или от настоящего страха задохнуться!"

# ch/harems_full/pixie/events.rpy:1337
translate russian pixie_threesome_7359c715:
    "Но когда всё стихает и остаётся лишь усталая нега, ни жалоб, ни упрёков не слышно."

# ch/harems_full/pixie/events.rpy:1338
translate russian pixie_threesome_b50a1dd4:
    "Только тяжёлое дыхание троих людей, лежащих в переплетении потных рук и ног."

# ch/harems_full/pixie/events.rpy:1339
translate russian pixie_threesome_496acaad:
    "Вообще-то тише за весь вечер мы ещё не были."

# ch/harems_full/pixie/events.rpy:1342
translate russian pixie_threesome_dea5cffd:
    "Без предупреждения я вынимаю член из Морган, а затем убираю язык от Клео."

# ch/harems_full/pixie/events.rpy:1343
translate russian pixie_threesome_ce1d8c5c:
    "Как я и надеялся, внезапное прекращение ласк тут же привлекает внимание обеих."

# ch/harems_full/pixie/events.rpy:1348
translate russian pixie_threesome_3540a911:
    kleio.say "Эй... ты чего?!"

# ch/harems_full/pixie/events.rpy:1349
translate russian pixie_threesome_668da4ed:
    morgan.say "Ну-у, так нечестно!"

# ch/harems_full/pixie/events.rpy:1350
translate russian pixie_threesome_4390b967:
    "Не обращая внимания на протесты, я встаю с кровати и маню их за собой."

# ch/harems_full/pixie/events.rpy:1351
translate russian pixie_threesome_ed742c80:
    "Сначала они смотрят раздражённо и озадаченно, не понимая намёка."

# ch/harems_full/pixie/events.rpy:1352
translate russian pixie_threesome_00c10654:
    "Но затем одной рукой я показываю на пол перед собой."

# ch/harems_full/pixie/events.rpy:1353
translate russian pixie_threesome_62b00cbe:
    "А другой в это время поглаживаю член, всё ещё скользкий от киски Морган."

# ch/harems_full/pixie/events.rpy:1354
translate russian pixie_threesome_1400b6cf:
    "Первой, кажется, догадывается Клео: она соскальзывает с кровати и зовёт Морган за собой."

# ch/harems_full/pixie/events.rpy:1355
translate russian pixie_threesome_8053d55b:
    "Когда до той доходит, её глаза расширяются, а на лице появляется улыбка."

# ch/harems_full/pixie/events.rpy:1360
translate russian pixie_threesome_17dba3e1:
    "Мгновение спустя обе уже стоят передо мной на коленях."

# ch/harems_full/pixie/events.rpy:1361
translate russian pixie_threesome_75cec27d:
    "Словно две выпрашивающие угощение сучки, Клео и Морган молча ждут с открытыми ртами."

# ch/harems_full/pixie/events.rpy:1363
translate russian pixie_threesome_fd86902a:
    "Первая струя спермы каким-то образом попадает на лица обеих."

# ch/harems_full/pixie/events.rpy:1365
translate russian pixie_threesome_525523a2:
    "Они удивлённо смеются, и следующая струя достаётся языкам и губам."

# ch/harems_full/pixie/events.rpy:1367
translate russian pixie_threesome_689d451f:
    "Вскоре обе покрыты спермой и, улыбаясь и хихикая, слизывают её."

# ch/harems_full/pixie/events.rpy:1369
translate russian pixie_threesome_fc501f01_1:
    "Стона Морган, прорвавшегося сквозь поцелуй с Клео, достаточно для подтверждения."

# ch/harems_full/pixie/events.rpy:1372
translate russian pixie_threesome_cb6fc7d3_1:
    "Этот звук возбуждает меня ещё сильнее, и я вхожу так глубоко, как могу."

# ch/harems_full/pixie/events.rpy:1377
translate russian pixie_threesome_5e22caf5:
    "Даже под таким углом тесная маленькая попка Морган ощущается невероятно."

# ch/harems_full/pixie/events.rpy:1378
translate russian pixie_threesome_614eaf19_1:
    "Но нельзя же отдавать всё удовольствие Морган, оставляя Клео ни с чем, правда?"

# ch/harems_full/pixie/events.rpy:1382
translate russian pixie_threesome_1dcba493_1:
    "Раздвинув губы киски Клео, я начинаю дразнить её кончиком языка."

# ch/harems_full/pixie/events.rpy:1383
translate russian pixie_threesome_7373080d_1:
    "Её особенный вкус наполняет рот — будто лизнул контакт батарейки."

# ch/harems_full/pixie/events.rpy:1384
translate russian pixie_threesome_c22b585f_1:
    "Морган сейчас получает мой член на всю длину."

# ch/harems_full/pixie/events.rpy:1386
translate russian pixie_threesome_e6e3e8a5_1:
    "Зато язык даёт гораздо больше простора для выдумки, в чём Клео вскоре убеждается."

# ch/harems_full/pixie/events.rpy:1387
translate russian pixie_threesome_2b3f05cc_1:
    "Я всё глубже исследую складки её киски, и она тоже начинает издавать звуки."

# ch/harems_full/pixie/events.rpy:1388
translate russian pixie_threesome_62100be0_1:
    "Пока Морган стонет от моего члена внутри, Клео вскрикивает и взвизгивает от моих ласк."

# ch/harems_full/pixie/events.rpy:1390
translate russian pixie_threesome_4317d8f6_1:
    "Улучив миг и подняв глаза, я вижу, как её щёки заливаются румянцем, а глаза закатываются."

# ch/harems_full/pixie/events.rpy:1391
translate russian pixie_threesome_be71bfea_1:
    "Это лишь заставляет меня удвоить усилия для обеих."

# ch/harems_full/pixie/events.rpy:1396
translate russian pixie_threesome_a6a1e303_1:
    "Я вижу, как движения члена в Морган и языка в киске Клео всё ближе подводят их к краю."

# ch/harems_full/pixie/events.rpy:1397
translate russian pixie_threesome_22366faa_1:
    "Теперь им едва удаётся продолжать прижиматься губами друг к другу."

# ch/harems_full/pixie/events.rpy:1401
translate russian pixie_threesome_caf1ae39_1:
    "И Клео, и Морган извиваются на кровати под моими ласками."

# ch/harems_full/pixie/events.rpy:1402
translate russian pixie_threesome_de4ad2e1_1:
    "Недолго осталось до того, как одна из них бурно кончит."

# ch/harems_full/pixie/events.rpy:1403
translate russian pixie_threesome_ee68611e_1:
    "Но мгновение спустя толчок внизу живота подсказывает, что я могу их опередить..."

# ch/harems_full/pixie/events.rpy:1406
translate russian pixie_threesome_992f6a39_1:
    "Я и не пытаюсь выйти из Морган, продолжая двигаться в ней до самого последнего мгновения."

# ch/harems_full/pixie/events.rpy:1409
translate russian pixie_threesome_feb0f9b0_1:
    "Словно в ответ на то, что я кончаю внутри неё, Морган ещё теснее притягивает Клео."

# ch/harems_full/pixie/events.rpy:1411
translate russian pixie_threesome_2ccb63b9_1:
    "Я смотрю, как она буквально безжалостно проталкивает язык в рот другой девушке."

# ch/harems_full/pixie/events.rpy:1412
translate russian pixie_threesome_24dbd2c6_1:
    "Клео остаётся лишь уступить Морган и отвечать на поцелуй, как получается."

# ch/harems_full/pixie/events.rpy:1414
translate russian pixie_threesome_1d6d8eb6_1:
    "Я продолжаю входить в неё, тратя остатки сил."

# ch/harems_full/pixie/events.rpy:1415
translate russian pixie_threesome_77c92385_1:
    "Но не могу отделаться от мысли, что Морган орудует языком так же, как я — членом."

# ch/harems_full/pixie/events.rpy:1417
translate russian pixie_threesome_13d600a5:
    "Чем глубже я вхожу в её задницу, тем глубже она проталкивает язык в горло Клео!"

# ch/harems_full/pixie/events.rpy:1418
translate russian pixie_threesome_4eed07f0_1:
    "В конце концов я уже не понимаю, задыхается ли Клео от оргазма или от настоящего страха задохнуться!"

# ch/harems_full/pixie/events.rpy:1419
translate russian pixie_threesome_7359c715_1:
    "Но когда всё стихает и остаётся лишь усталая нега, ни жалоб, ни упрёков не слышно."

# ch/harems_full/pixie/events.rpy:1420
translate russian pixie_threesome_b50a1dd4_1:
    "Только тяжёлое дыхание троих людей, лежащих в переплетении потных рук и ног."

# ch/harems_full/pixie/events.rpy:1421
translate russian pixie_threesome_496acaad_1:
    "Вообще-то тише за весь вечер мы ещё не были."

# ch/harems_full/pixie/events.rpy:1424
translate russian pixie_threesome_dea5cffd_1:
    "Без предупреждения я вынимаю член из Морган, а затем убираю язык от Клео."

# ch/harems_full/pixie/events.rpy:1425
translate russian pixie_threesome_ce1d8c5c_1:
    "Как я и надеялся, внезапное прекращение ласк тут же привлекает внимание обеих."

# ch/harems_full/pixie/events.rpy:1430
translate russian pixie_threesome_3540a911_1:
    kleio.say "Эй... ты чего?!"

# ch/harems_full/pixie/events.rpy:1431
translate russian pixie_threesome_668da4ed_1:
    morgan.say "Ну-у, так нечестно!"

# ch/harems_full/pixie/events.rpy:1432
translate russian pixie_threesome_4390b967_1:
    "Не обращая внимания на протесты, я встаю с кровати и маню их за собой."

# ch/harems_full/pixie/events.rpy:1433
translate russian pixie_threesome_ed742c80_1:
    "Сначала они смотрят раздражённо и озадаченно, не понимая намёка."

# ch/harems_full/pixie/events.rpy:1434
translate russian pixie_threesome_00c10654_1:
    "Но затем одной рукой я показываю на пол перед собой."

# ch/harems_full/pixie/events.rpy:1435
translate russian pixie_threesome_f040b241:
    "А другой в это время поглаживаю член."

# ch/harems_full/pixie/events.rpy:1436
translate russian pixie_threesome_1400b6cf_1:
    "Первой, кажется, догадывается Клео: она соскальзывает с кровати и зовёт Морган за собой."

# ch/harems_full/pixie/events.rpy:1437
translate russian pixie_threesome_8053d55b_1:
    "Когда до той доходит, её глаза расширяются, а на лице появляется улыбка."

# ch/harems_full/pixie/events.rpy:1442
translate russian pixie_threesome_17dba3e1_1:
    "Мгновение спустя обе уже стоят передо мной на коленях."

# ch/harems_full/pixie/events.rpy:1443
translate russian pixie_threesome_75cec27d_1:
    "Словно две выпрашивающие угощение сучки, Клео и Морган молча ждут с открытыми ртами."

# ch/harems_full/pixie/events.rpy:1445
translate russian pixie_threesome_fd86902a_1:
    "Первая струя спермы каким-то образом попадает на лица обеих."

# ch/harems_full/pixie/events.rpy:1447
translate russian pixie_threesome_525523a2_1:
    "Они удивлённо смеются, и следующая струя достаётся языкам и губам."

# ch/harems_full/pixie/events.rpy:1449
translate russian pixie_threesome_689d451f_1:
    "Вскоре обе покрыты спермой и, улыбаясь и хихикая, слизывают её."

# ch/harems_full/pixie/events.rpy:1461
translate russian pixie_second_threesome_be999145:
    "Едва договорившись о сексе втроём, мы уже встаём и направляемся к выходу из паба."

# ch/harems_full/pixie/events.rpy:1462
translate russian pixie_second_threesome_81b8a581:
    "Все трое знают, что мой дом ближе всего, поэтому вопроса, куда идти, не возникает."

# ch/harems_full/pixie/events.rpy:1464
translate russian pixie_second_threesome_2c43b84b:
    "Добравшись домой, я открываю дверь и провожаю Клео и Морган в свою комнату."

# ch/harems_full/pixie/events.rpy:1465
translate russian pixie_second_threesome_c5859a81:
    "Я почти уверен, что никто не видел, как мы проскользнули внутрь, так что можно сразу перейти к делу."

# ch/harems_full/pixie/events.rpy:1466
translate russian pixie_second_threesome_494de244:
    "Но, закрыв дверь и повернувшись к Клео и Морган, я обнаруживаю сюрприз."

# ch/harems_full/pixie/events.rpy:1470
translate russian pixie_second_threesome_3d022d56:
    "Обе уже разделись до белья и снимают даже его!"

# ch/harems_full/pixie/events.rpy:1471
translate russian pixie_second_threesome_91a9e09a:
    kleio.say "Поторопись, сердцеед!"

# ch/harems_full/pixie/events.rpy:1473
translate russian pixie_second_threesome_398d23e0:
    morgan.say "Ага, лучше нас не заставлять ждать!"

# ch/harems_full/pixie/events.rpy:1475
translate russian pixie_second_threesome_66be0b6e:
    morgan.say "Давай, [lssb_common.hero_name()]!"

# ch/harems_full/pixie/events.rpy:1476
translate russian pixie_second_threesome_0f2a267a:
    morgan.say "Повеселимся!"

# ch/harems_full/pixie/events.rpy:1478
translate russian pixie_second_threesome_7f7118e8:
    morgan.say "Шевелись, копуша!"

# ch/harems_full/pixie/events.rpy:1479
translate russian pixie_second_threesome_8c406f40:
    mike.say "Эй, девчонки!"

# ch/harems_full/pixie/events.rpy:1480
translate russian pixie_second_threesome_7ddd9557:
    mike.say "Нечестно! Могли бы и меня подождать!"

# ch/harems_full/pixie/events.rpy:1481
translate russian pixie_second_threesome_daeb4b75:
    "Клео и Морган обмениваются лукавыми улыбками и качают головами."

# ch/harems_full/pixie/events.rpy:1485
translate russian pixie_second_threesome_e9e0bf63:
    "Почти одновременно они роняют лифчики на пол."

# ch/harems_full/pixie/events.rpy:1486
translate russian pixie_second_threesome_fe06284b:
    "Затем стягивают трусики и тоже отбрасывают их ногой."

# ch/harems_full/pixie/events.rpy:1487
translate russian pixie_second_threesome_a41db767:
    "Я уже изо всех сил стараюсь поскорее снять собственную одежду."

# ch/harems_full/pixie/events.rpy:1488
translate russian pixie_second_threesome_0acc910e:
    "Поэтому вижу происходящее лишь урывками."

# ch/harems_full/pixie/events.rpy:1489
translate russian pixie_second_threesome_3d8bbad6:
    "Одновременно я пытаюсь пересечь комнату, подпрыгивая и спотыкаясь."

# ch/harems_full/pixie/events.rpy:1490
translate russian pixie_second_threesome_7abf94b1:
    "И едва не падаю лицом в пол, прежде чем добираюсь до них."

# ch/harems_full/pixie/events.rpy:1491
translate russian pixie_second_threesome_adb57a65:
    "Теперь Клео и Морган наблюдают за моей вознёй и от души надо мной смеются."

# ch/harems_full/pixie/events.rpy:1492
translate russian pixie_second_threesome_b9b89602:
    "Но я, честно говоря, почти ничего не замечаю и не слышу."

# ch/harems_full/pixie/events.rpy:1493
translate russian pixie_second_threesome_25a0537b:
    "Потому что все мои мысли заняты видом их двоих."

# ch/harems_full/pixie/events.rpy:1495
translate russian pixie_second_threesome_b707f078:
    "Особенно потому, что Клео уже сжимает и поглаживает мой член."

# ch/harems_full/pixie/events.rpy:1496
translate russian pixie_second_threesome_c834fbcf:
    "А Морган нежно сжимает мои яйца своей милой ладошкой."

# ch/harems_full/pixie/events.rpy:1497
translate russian pixie_second_threesome_2590f8fa:
    "По выражению их лиц я вижу: Клео и Морган думают об одном и том же!"

# ch/harems_full/pixie/events.rpy:1498
translate russian pixie_second_threesome_d5a7f1dc:
    kleio.say "Ну, как будем это делать, народ?"

# ch/harems_full/pixie/events.rpy:1499
translate russian pixie_second_threesome_98bd6c74:
    kleio.say "То есть с чего начнём?"

# ch/harems_full/pixie/events.rpy:1501
translate russian pixie_second_threesome_71ac30bb:
    morgan.say "Ага, немного пошалим?"

# ch/harems_full/pixie/events.rpy:1502
translate russian pixie_second_threesome_6731338c:
    morgan.say "Или сразу трахаться?"

# ch/harems_full/pixie/events.rpy:1504
translate russian pixie_second_threesome_939a656b:
    morgan.say "Я бы не отказалась от небольшой прелюдии!"

# ch/harems_full/pixie/events.rpy:1505
translate russian pixie_second_threesome_60649d11:
    morgan.say "Если вы, конечно, ещё можете терпеть."

# ch/harems_full/pixie/events.rpy:1507
translate russian pixie_second_threesome_27658b50:
    morgan.say "Я люблю начинать неспешно."

# ch/harems_full/pixie/events.rpy:1508
translate russian pixie_second_threesome_0d93e8eb:
    morgan.say "Но вообще я на всё согласна!"

# ch/harems_full/pixie/events.rpy:1509
translate russian pixie_second_threesome_9927b723:
    "Хм... вот это выбор!"

# ch/harems_full/pixie/events.rpy:1510
translate russian pixie_second_threesome_849e0953:
    "Одна часть меня хочет наброситься на Клео и Морган прямо сейчас."

# ch/harems_full/pixie/events.rpy:1511
translate russian pixie_second_threesome_b441f95a:
    "А другая думает о том, чтобы немного растянуть удовольствие..."

# ch/harems_full/pixie/events.rpy:1512
translate russian pixie_second_threesome_398ad5fa:
    "Но решать нужно скорее: они ждут моего ответа!"

# ch/harems_full/pixie/events.rpy:1515
translate russian pixie_second_threesome_151e4ed3:
    "Я не объясняю Клео и Морган, что собираюсь делать, а просто действую."

# ch/harems_full/pixie/events.rpy:1516
translate russian pixie_second_threesome_d8ca2488:
    "Кладу ладонь на плечо одной из них и мягко нажимаю вниз."

# ch/harems_full/pixie/events.rpy:1518
translate russian pixie_second_threesome_b61cd9d0:
    "Клео и Морган поддаются движению и садятся на край кровати."

# ch/harems_full/pixie/events.rpy:1519
translate russian pixie_second_threesome_189d4a28:
    "Но всё это время не сводят с меня глаз, ожидая, что я задумал."

# ch/harems_full/pixie/events.rpy:1520
translate russian pixie_second_threesome_000d8736:
    "Опускаясь на колени, я стараюсь удержать их взгляды."

# ch/harems_full/pixie/events.rpy:1521
translate russian pixie_second_threesome_d2e65bf5:
    "Кажется, они быстро догадываются, что будет дальше."

# ch/harems_full/pixie/events.rpy:1522
translate russian pixie_second_threesome_95927dfa:
    "Потому что и Клео, и Морган раздвигают ноги."

# ch/harems_full/pixie/events.rpy:1524
translate russian pixie_second_threesome_0629c381:
    "А мгновение спустя поднимают их, ещё шире раскрывая бёдра."

# ch/harems_full/pixie/events.rpy:1525
translate russian pixie_second_threesome_46d36d6c:
    "Теперь мне ничто не мешает дотянуться между ними."

# ch/harems_full/pixie/events.rpy:1526
translate russian pixie_second_threesome_1a5da25a:
    "Там меня ждут их киски."

# ch/harems_full/pixie/events.rpy:1527
translate russian pixie_second_threesome_0806ef75:
    "Левая рука ложится на губы Клео, правая — Морган."

# ch/harems_full/pixie/events.rpy:1528
translate russian pixie_second_threesome_91516cae:
    "Провожу пальцами по складкам и слышу, как обе ахают."

# ch/harems_full/pixie/events.rpy:1529
translate russian pixie_second_threesome_4f100275:
    "И клянусь, влажными они тоже становятся одновременно!"

# ch/harems_full/pixie/events.rpy:1530
translate russian pixie_second_threesome_f024cbd7:
    "Мне даже не нужно видеть, что я делаю с каждой из них."

# ch/harems_full/pixie/events.rpy:1531
translate russian pixie_second_threesome_28475e1f:
    "Достаточно позволить рукам двигаться неторопливыми кругами."

# ch/harems_full/pixie/events.rpy:1532
translate russian pixie_second_threesome_80a617d7:
    "Клео и Морган уже откинулись назад на кровати."

# ch/harems_full/pixie/events.rpy:1533
translate russian pixie_second_threesome_9496c7d2:
    "Они опираются на локти, и их руки тоже начинают блуждать."

# ch/harems_full/pixie/events.rpy:1534
translate russian pixie_second_threesome_4bb643b0:
    "Я смотрю, как они гладят и ласкают свои тела выше пояса."

# ch/harems_full/pixie/events.rpy:1535
translate russian pixie_second_threesome_f469089c:
    "И в конце концов каждая кладёт ладони на грудь."

# ch/harems_full/pixie/events.rpy:1536
translate russian pixie_second_threesome_00f5008f:
    "Глядя на них, я чувствую, как с каждой секундой становлюсь всё твёрже."

# ch/harems_full/pixie/events.rpy:1537
translate russian pixie_second_threesome_32775f58:
    "Клео и Морган сжимают груди, пощипывая соски."

# ch/harems_full/pixie/events.rpy:1538
translate russian pixie_second_threesome_fee2f0a5:
    "Словно пытаются выпустить напряжение, которое я в них накапливаю."

# ch/harems_full/pixie/events.rpy:1539
translate russian pixie_second_threesome_71cd8fe8:
    "Но на меня это действует совсем наоборот!"

# ch/harems_full/pixie/events.rpy:1540
translate russian pixie_second_threesome_790a01e0:
    "Кажется, я вот-вот взорвусь!"

# ch/harems_full/pixie/events.rpy:1541
translate russian pixie_second_threesome_ecee42b6:
    "Пытаясь сосредоточиться на чём-то другом, я опускаю голову."

# ch/harems_full/pixie/events.rpy:1542
translate russian pixie_second_threesome_6e53e756:
    "Не знаю, почему выбираю Морган, а не Клео."

# ch/harems_full/pixie/events.rpy:1543
translate russian pixie_second_threesome_b8bdae26:
    "Но через секунду моя голова уже между её бёдер."

# ch/harems_full/pixie/events.rpy:1544
translate russian pixie_second_threesome_0845b0b8:
    "Когда я пускаю в ход рот, стоны Морган становятся ещё громче."

# ch/harems_full/pixie/events.rpy:1545
translate russian pixie_second_threesome_b3ab576a:
    "Я целую и лижу, словно от этого зависит моя жизнь, всё глубже проникая языком."

# ch/harems_full/pixie/events.rpy:1546
translate russian pixie_second_threesome_3d6deb2f:
    "Вскоре от моих ласк Морган начинает громко вскрикивать."

# ch/harems_full/pixie/events.rpy:1547
translate russian pixie_second_threesome_437b1db9:
    "Всё её тело дрожит, когда она кончает от прикосновений моего языка."

# ch/harems_full/pixie/events.rpy:1550
translate russian pixie_second_threesome_65d5ca97:
    "Я улыбаюсь Клео и Морган, надеясь, что улыбка выглядит лукавой."

# ch/harems_full/pixie/events.rpy:1551
translate russian pixie_second_threesome_2e581362:
    mike.say "Вы, кажется, знаете, чего хотите."

# ch/harems_full/pixie/events.rpy:1552
translate russian pixie_second_threesome_9b3df2b5:
    mike.say "Так почему бы вам не показать?"

# ch/harems_full/pixie/events.rpy:1553
translate russian pixie_second_threesome_ad4004f7:
    "Клео и Морган обмениваются многозначительным взглядом."

# ch/harems_full/pixie/events.rpy:1554
translate russian pixie_second_threesome_132dd05d:
    "Затем обе кивают."

# ch/harems_full/pixie/events.rpy:1555
translate russian pixie_second_threesome_42a4fbfc:
    kleio.say "Ты берёшь верх, а я — низ."

# ch/harems_full/pixie/events.rpy:1556
translate russian pixie_second_threesome_da43601a:
    kleio.say "Как и договаривались?"

# ch/harems_full/pixie/events.rpy:1558
translate russian pixie_second_threesome_eec57699:
    morgan.say "Конечно, Клео!"

# ch/harems_full/pixie/events.rpy:1559
translate russian pixie_second_threesome_86ea6721:
    morgan.say "За дело!"

# ch/harems_full/pixie/events.rpy:1561
translate russian pixie_second_threesome_fbf9df4d:
    morgan.say "Ладно, Клео, я помню план."

# ch/harems_full/pixie/events.rpy:1562
translate russian pixie_second_threesome_ba3d02f9:
    morgan.say "Начинай, а я за тобой!"

# ch/harems_full/pixie/events.rpy:1564
translate russian pixie_second_threesome_9f0f5c99:
    morgan.say "Конечно, Клео!"

# ch/harems_full/pixie/events.rpy:1565
translate russian pixie_second_threesome_b6db0da8:
    morgan.say "Можешь на меня рассчитывать!"

# ch/harems_full/pixie/events.rpy:1566
translate russian pixie_second_threesome_d2c4d295:
    "Я не успеваю произнести ни слова, как они переходят к действиям."

# ch/harems_full/pixie/events.rpy:1567
translate russian pixie_second_threesome_62416ea8:
    "Клео обхватывает мои ноги руками, не давая сдвинуться с места."

# ch/harems_full/pixie/events.rpy:1568
translate russian pixie_second_threesome_1a08c9af:
    "А Морган практически набрасывается на меня, схватив за плечи."

# ch/harems_full/pixie/events.rpy:1569
translate russian pixie_second_threesome_2c9c488c:
    "Вдвоём они добиваются того, что я падаю назад."

# ch/harems_full/pixie/events.rpy:1570
translate russian pixie_second_threesome_a11fce9d:
    "К счастью, кровать смягчает падение!"

# ch/harems_full/pixie/events.rpy:1572
translate russian pixie_second_threesome_f4318b65:
    "Едва я оказываюсь на матрасе, Клео уже устраивается между моих ног."

# ch/harems_full/pixie/events.rpy:1573
translate russian pixie_second_threesome_293b96fa:
    "Одновременно Морган перебирается через мою грудь."

# ch/harems_full/pixie/events.rpy:1574
translate russian pixie_second_threesome_f3f29dde:
    "Её груди касаются моего лица, а затем я чувствую запах её киски."

# ch/harems_full/pixie/events.rpy:1575
translate russian pixie_second_threesome_c8b0ec8e:
    "Я вытягиваю шею, чтобы дотянуться и лизнуть, касаясь языком её губ."

# ch/harems_full/pixie/events.rpy:1576
translate russian pixie_second_threesome_afd03c53:
    "Морган ахает, а затем хихикает."

# ch/harems_full/pixie/events.rpy:1577
translate russian pixie_second_threesome_eb723814:
    "Но потом обе принимаются за дело, и я оказываюсь совершенно беспомощен."

# ch/harems_full/pixie/events.rpy:1578
translate russian pixie_second_threesome_f103861c:
    "Я не знаю, кто что со мной делает, потому что ничего не вижу."

# ch/harems_full/pixie/events.rpy:1580
translate russian pixie_second_threesome_c2eaab02:
    "Но одна из них сосёт мои яйца."

# ch/harems_full/pixie/events.rpy:1581
translate russian pixie_second_threesome_e210412d:
    "А другая уже глубоко заглатывает мой член!"

# ch/harems_full/pixie/events.rpy:1582
translate russian pixie_second_threesome_906f7c33:
    "Мне остаётся лишь лежать, придавленному весом Морган."

# ch/harems_full/pixie/events.rpy:1583
translate russian pixie_second_threesome_cd196250:
    "Не то чтобы сейчас мне хотелось оказаться где-то ещё!"

# ch/harems_full/pixie/events.rpy:1584
translate russian pixie_second_threesome_69d7b191:
    "Я с удовольствием позволяю им ласкать меня с обеих сторон."

# ch/harems_full/pixie/events.rpy:1585
translate russian pixie_second_threesome_331a9572:
    "И при каждой возможности сам лижу киску Морган!"

# ch/harems_full/pixie/events.rpy:1586
translate russian pixie_second_threesome_2f8f4b6e:
    "Только бесконечно я так не выдержу."

# ch/harems_full/pixie/events.rpy:1588
translate russian pixie_second_threesome_462965ae:
    mike.say "Девчонки..."

# ch/harems_full/pixie/events.rpy:1589
translate russian pixie_second_threesome_1732d2c0:
    mike.say "Нужно сбавить темп!"

# ch/harems_full/pixie/events.rpy:1592
translate russian pixie_second_threesome_fa1ad919:
    "Я уже вот-вот кончу и думаю о том, куда именно."

# ch/harems_full/pixie/events.rpy:1593
translate russian pixie_second_threesome_d7bd4adf:
    "Но именно в этот миг Клео и Морган снова переходят к действиям."

# ch/harems_full/pixie/events.rpy:1596
translate russian pixie_second_threesome_8ef85f9a:
    "Я и понять ничего не успеваю, как мой член с отчётливым хлопком выскальзывает наружу."

# ch/harems_full/pixie/events.rpy:1597
translate russian pixie_second_threesome_96fef868:
    "Затем Клео и Морган оказываются передо мной на коленях на кровати."

# ch/harems_full/pixie/events.rpy:1598
translate russian pixie_second_threesome_2b7b26cb:
    "Они тут же снова принимаются за меня, не давая возбуждению угаснуть."

# ch/harems_full/pixie/events.rpy:1599
translate russian pixie_second_threesome_4761c049:
    "В ход идут руки, языки и губы, дразнящие мой член."

# ch/harems_full/pixie/events.rpy:1600
translate russian pixie_second_threesome_1f633477:
    "Словно они обе телепаты и всё время обмениваются мыслями."

# ch/harems_full/pixie/events.rpy:1601
translate russian pixie_second_threesome_30d31500:
    "Ведь для такой слаженности им, кажется, не нужен даже намёк друг от друга."

# ch/harems_full/pixie/events.rpy:1602
translate russian pixie_second_threesome_c190e309:
    "И своего они добиваются довольно быстро."

# ch/harems_full/pixie/events.rpy:1603
translate russian pixie_second_threesome_bd85eaf9:
    "До последнего мгновения Клео и Морган умело передают мой член друг другу."

# ch/harems_full/pixie/events.rpy:1604
translate russian pixie_second_threesome_52965ff4:
    "А когда я наконец теряю контроль, наклоняются совсем близко."

# ch/harems_full/pixie/events.rpy:1606
translate russian pixie_second_threesome_1778672c:
    "Оргазм оказывается таким же мощным, как я и надеялся."

# ch/harems_full/pixie/events.rpy:1608
translate russian pixie_second_threesome_687aa5bf:
    "Лица Клео и Морган тут же покрываются белыми полосами."

# ch/harems_full/pixie/events.rpy:1610
translate russian pixie_second_threesome_0cc11502:
    "Они взвизгивают и смеются, пока сперма покрывает щёки и стекает вниз."

# ch/harems_full/pixie/events.rpy:1611
translate russian pixie_second_threesome_38444474:
    "А я могу лишь смотреть, тяжело дыша и совершенно обессилев."

# ch/harems_full/pixie/events.rpy:1617
translate russian pixie_second_threesome_bbbe3794:
    kleio.say "Ах..."

# ch/harems_full/pixie/events.rpy:1621
translate russian pixie_second_threesome_b10643ea:
    kleio.say "Наверное, он прав, Морган."

# ch/harems_full/pixie/events.rpy:1622
translate russian pixie_second_threesome_955a5d39:
    kleio.say "Мы ведь не хотим вымотать его... по крайней мере, пока!"

# ch/harems_full/pixie/events.rpy:1623
translate russian pixie_second_threesome_cfa20fe7:
    "Они нехотя отпускают меня, получив обещание, что продолжение ещё будет."

# ch/harems_full/pixie/events.rpy:1660
translate russian pixie_second_threesome_898c1884:
    mike.say "Эй, Морган..."

# ch/harems_full/pixie/events.rpy:1661
translate russian pixie_second_threesome_2b6aa837:
    mike.say "Подойди и помоги мне, ладно?"

# ch/harems_full/pixie/events.rpy:1662
translate russian pixie_second_threesome_2f3ce21a:
    morgan.say "Хорошо, [lssb_common.hero_name()]..."

# ch/harems_full/pixie/events.rpy:1664
translate russian pixie_second_threesome_f0bb7247:
    morgan.say "А ты пока посиди спокойно, Клео!"

# ch/harems_full/pixie/events.rpy:1666
translate russian pixie_second_threesome_f445ec29:
    morgan.say "Подожди минутку, Клео!"

# ch/harems_full/pixie/events.rpy:1668
translate russian pixie_second_threesome_2139d9a5:
    morgan.say "Хи-хи... только не ревнуй, Клео!"

# ch/harems_full/pixie/events.rpy:1669
translate russian pixie_second_threesome_e75956a6:
    "Клео с любопытством смотрит на меня, когда я зову Морган на помощь."

# ch/harems_full/pixie/events.rpy:1670
translate russian pixie_second_threesome_7fc41995:
    "Но стоит той поспешить ко мне, как взгляд Клео становится откровенно подозрительным."

# ch/harems_full/pixie/events.rpy:1671
translate russian pixie_second_threesome_66d60a71:
    kleio.say "Эй..."

# ch/harems_full/pixie/events.rpy:1672
translate russian pixie_second_threesome_e74537f5:
    kleio.say "Вы чего удумали?"

# ch/harems_full/pixie/events.rpy:1673
translate russian pixie_second_threesome_a0bd2fbb:
    "Несмотря на явные сомнения, Клео не сопротивляется."

# ch/harems_full/pixie/events.rpy:1674
translate russian pixie_second_threesome_674aad7a:
    "Она позволяет нам с Морган уложить её на кровать."

# ch/harems_full/pixie/events.rpy:1676
translate russian pixie_second_threesome_201c224f:
    "Когда Клео оказывается на спине, я мягко раздвигаю ей ноги."

# ch/harems_full/pixie/events.rpy:1677
translate russian pixie_second_threesome_49b60758:
    "Морган, кажется, быстро понимает, что я задумал."

# ch/harems_full/pixie/events.rpy:1678
translate russian pixie_second_threesome_24059def:
    "Она следует моему примеру, когда я наклоняюсь между бёдер Морган."

# ch/harems_full/pixie/events.rpy:1679
translate russian pixie_second_threesome_a9a48e09:
    "Вскоре мы вместе исследуем то, что находим внизу."

# ch/harems_full/pixie/events.rpy:1680
translate russian pixie_second_threesome_c2bbd9f2:
    "Я успеваю увидеть выражение лица Клео, когда она смотрит на нас."

# ch/harems_full/pixie/events.rpy:1681
translate russian pixie_second_threesome_1e566018:
    "В нём смешались опасение и сильное желание."

# ch/harems_full/pixie/events.rpy:1682
translate russian pixie_second_threesome_936ce7b3:
    "Но мгновение спустя я закрываю глаза и сосредотачиваюсь на деле."

# ch/harems_full/pixie/events.rpy:1683
translate russian pixie_second_threesome_f284c540:
    "Теперь ориентироваться могу только по звукам Клео."

# ch/harems_full/pixie/events.rpy:1684
translate russian pixie_second_threesome_9501dd4e:
    "И по тому, что её киска с каждой секундой становится всё влажнее!"

# ch/harems_full/pixie/events.rpy:1685
translate russian pixie_second_threesome_539c8f47:
    "Морган — идеальная напарница для такого занятия."

# ch/harems_full/pixie/events.rpy:1686
translate russian pixie_second_threesome_3c994aa7:
    "Она, кажется, знает там всё как никто другой!"

# ch/harems_full/pixie/events.rpy:1687
translate russian pixie_second_threesome_6f91fad0:
    "И ей совсем нетрудно действовать рядом, не мешая мне."

# ch/harems_full/pixie/events.rpy:1688
translate russian pixie_second_threesome_f4ecc7cf:
    "Вместе мы доводим Клео до полной беспомощности."

# ch/harems_full/pixie/events.rpy:1689
translate russian pixie_second_threesome_6d3898fd:
    "Ей остаётся лишь лежать и принимать все наши ласки."

# ch/harems_full/pixie/events.rpy:1690
translate russian pixie_second_threesome_cd886c7f:
    "Мы не останавливаемся до самого её вскрика."

# ch/harems_full/pixie/events.rpy:1691
translate russian pixie_second_threesome_e45c9c9a:
    "По нему и по сжавшимся бёдрам я понимаю, что она кончила."

# ch/harems_full/pixie/events.rpy:1692
translate russian pixie_second_threesome_18b0b55d:
    "Мы с Морган отстраняемся, переводя дыхание, а Клео извивается на кровати."

# ch/harems_full/pixie/events.rpy:1698
translate russian pixie_second_threesome_8109d288:
    "Я улыбаюсь и изо всех сил стараюсь продолжать шутить."

# ch/harems_full/pixie/events.rpy:1699
translate russian pixie_second_threesome_2f8bdcbf:
    "Но какая-то часть меня всё ещё боится, что Клео и Морган заметят."

# ch/harems_full/pixie/events.rpy:1700
translate russian pixie_second_threesome_9c1270d8:
    "Поймут, насколько сильно я сейчас нервничаю."

# ch/harems_full/pixie/events.rpy:1701
translate russian pixie_second_threesome_73b43dc5:
    "Мы за закрытой дверью, в уединении моей спальни."

# ch/harems_full/pixie/events.rpy:1702
translate russian pixie_second_threesome_ebb2fb02:
    "И все трое целиком и полностью хотим того, что собираемся делать."

# ch/harems_full/pixie/events.rpy:1703
translate russian pixie_second_threesome_12c72ac0:
    "Но я всё ещё не могу поверить, что это действительно происходит со мной."

# ch/harems_full/pixie/events.rpy:1704
translate russian pixie_second_threesome_cef0e71e:
    "Оттого и нервы."

# ch/harems_full/pixie/events.rpy:1705
translate russian pixie_second_threesome_210a2d18:
    "Сначала безумием было узнать, что они раньше встречались."

# ch/harems_full/pixie/events.rpy:1706
translate russian pixie_second_threesome_1596c344:
    "Потом полным сумасшествием показалось, что мы все трое сходимся вместе."

# ch/harems_full/pixie/events.rpy:1710
translate russian pixie_second_threesome_d981b39d:
    "А теперь я смотрю, как Клео и Морган раздеваются в моей комнате!"

# ch/harems_full/pixie/events.rpy:1711
translate russian pixie_second_threesome_34d2cfb8:
    "Снимая одежду, они хихикают и шутливо толкают друг друга."

# ch/harems_full/pixie/events.rpy:1712
translate russian pixie_second_threesome_52b18a12:
    "И постепенно обнажают свои тела."

# ch/harems_full/pixie/events.rpy:1713
translate russian pixie_second_threesome_e880b5cc:
    "Честно говоря, я, кажется, никогда не видел двух более красивых девушек."

# ch/harems_full/pixie/events.rpy:1714
translate russian pixie_second_threesome_26290dd9:
    "Просто не могу отвести от них глаз."

# ch/harems_full/pixie/events.rpy:1715
translate russian pixie_second_threesome_f66d6cfd:
    "Какая-то часть меня уверена: стоит ущипнуть себя — и я проснусь, а всё это окажется сном."

# ch/harems_full/pixie/events.rpy:1716
translate russian pixie_second_threesome_fd2b33ed:
    "И тут Клео останавливается и смотрит мне в глаза."

# ch/harems_full/pixie/events.rpy:1721
translate russian pixie_second_threesome_3bc25c9a:
    kleio.say "Эй, сердцеед..."

# ch/harems_full/pixie/events.rpy:1722
translate russian pixie_second_threesome_728192fd:
    kleio.say "Что у тебя там случилось?"

# ch/harems_full/pixie/events.rpy:1723
translate russian pixie_second_threesome_e581cfb9:
    "Морган тоже тут же обращает на меня внимание."

# ch/harems_full/pixie/events.rpy:1724
translate russian pixie_second_threesome_54452345:
    "Разглядывая меня, она склоняет голову набок."

# ch/harems_full/pixie/events.rpy:1727
translate russian pixie_second_threesome_ed247726:
    morgan.say "А?"

# ch/harems_full/pixie/events.rpy:1728
translate russian pixie_second_threesome_d2fba2e6:
    morgan.say "Ага, [lssb_common.hero_name()], что такое?"

# ch/harems_full/pixie/events.rpy:1730
translate russian pixie_second_threesome_ff9c0db1:
    morgan.say "Ага, [lssb_common.hero_name()]..."

# ch/harems_full/pixie/events.rpy:1731
translate russian pixie_second_threesome_d4297d3d:
    morgan.say "Хорошо себя чувствуешь?"

# ch/harems_full/pixie/events.rpy:1733
translate russian pixie_second_threesome_66e99ec3:
    morgan.say "Ох..."

# ch/harems_full/pixie/events.rpy:1734
translate russian pixie_second_threesome_b5af8858:
    morgan.say "Всё в порядке, [lssb_common.hero_name()]?"

# ch/harems_full/pixie/events.rpy:1736
translate russian pixie_second_threesome_d1f5d33d:
    "Под их взглядами я понимаю, что всё это время стоял неподвижно."

# ch/harems_full/pixie/events.rpy:1737
translate russian pixie_second_threesome_5ca2ccb0:
    "Я всё ещё полностью одет, а они обе уже совсем голые."

# ch/harems_full/pixie/events.rpy:1739
translate russian pixie_second_threesome_11931ff0:
    mike.say "Простите, девчонки."

# ch/harems_full/pixie/events.rpy:1740
translate russian pixie_second_threesome_5a14136a:
    mike.say "Я... кажется, я разволновался!"

# ch/harems_full/pixie/events.rpy:1742
translate russian pixie_second_threesome_40ea31cf:
    "Клео и Морган обмениваются озадаченными взглядами."

# ch/harems_full/pixie/events.rpy:1743
translate russian pixie_second_threesome_93204a85:
    "А затем обе начинают надо мной смеяться."

# ch/harems_full/pixie/events.rpy:1746
translate russian pixie_second_threesome_212a56eb:
    kleio.say "Ты издеваешься!"

# ch/harems_full/pixie/events.rpy:1747
translate russian pixie_second_threesome_e3ffe726:
    kleio.say "Я думала, об этом мечтает каждый парень!"

# ch/harems_full/pixie/events.rpy:1751
translate russian pixie_second_threesome_19189b14:
    morgan.say "Трахнуть двух горячих красоток!"

# ch/harems_full/pixie/events.rpy:1752
translate russian pixie_second_threesome_c6e60a16:
    morgan.say "Тебе разве не нравится?"

# ch/harems_full/pixie/events.rpy:1754
translate russian pixie_second_threesome_44432e9a:
    morgan.say "Я думала, ты этого хочешь."

# ch/harems_full/pixie/events.rpy:1755
translate russian pixie_second_threesome_1a183841:
    morgan.say "Что мы тебе очень нравимся!"

# ch/harems_full/pixie/events.rpy:1757
translate russian pixie_second_threesome_96331274:
    morgan.say "Ты ведь не передумал?"

# ch/harems_full/pixie/events.rpy:1758
translate russian pixie_second_threesome_ed536be4:
    morgan.say "Правда?"

# ch/harems_full/pixie/events.rpy:1759
translate russian pixie_second_threesome_9396ae4b:
    "Я шагаю вперёд, замахав руками."

# ch/harems_full/pixie/events.rpy:1760
translate russian pixie_second_threesome_9cbc5a3f:
    mike.say "Нет-нет-нет!"

# ch/harems_full/pixie/events.rpy:1761
translate russian pixie_second_threesome_c9484cc7:
    mike.say "Просто..."

# ch/harems_full/pixie/events.rpy:1762
translate russian pixie_second_threesome_1cb6bf10:
    mike.say "Ну... вы-то уже делали это раньше."

# ch/harems_full/pixie/events.rpy:1763
translate russian pixie_second_threesome_290e566b:
    mike.say "А я тут всё ещё новичок, понимаете?"

# ch/harems_full/pixie/events.rpy:1764
translate russian pixie_second_threesome_56d45ef5:
    "Клео тут же пользуется тем, что я подошёл ближе."

# ch/harems_full/pixie/events.rpy:1765
translate russian pixie_second_threesome_8bfbed3c:
    "Без предупреждения набрасывается на меня и тянет к кровати."

# ch/harems_full/pixie/events.rpy:1766
translate russian pixie_second_threesome_a96065e8:
    "Морган озорно хихикает и присоединяется."

# ch/harems_full/pixie/events.rpy:1767
translate russian pixie_second_threesome_bf086fb8:
    "Вдвоём они стаскивают меня на матрас."

# ch/harems_full/pixie/events.rpy:1769
translate russian pixie_second_threesome_93b83c75:
    kleio.say "Всё не так, сердцеед."

# ch/harems_full/pixie/events.rpy:1772
translate russian pixie_second_threesome_3c33a4c9:
    morgan.say "Для нас это тоже пока в новинку."

# ch/harems_full/pixie/events.rpy:1775
translate russian pixie_second_threesome_0c1c629b:
    kleio.say "Хотя бы потому..."

# ch/harems_full/pixie/events.rpy:1777
translate russian pixie_second_threesome_2f8ab045:
    kleio.say "Что раньше у нас такой игрушки не было!"

# ch/harems_full/pixie/events.rpy:1779
translate russian pixie_second_threesome_34930970:
    "С этими словами Клео сжимает мой член через брюки."

# ch/harems_full/pixie/events.rpy:1780
translate russian pixie_second_threesome_9b8810ea:
    "Я ахаю и чувствую, как сердце бьётся быстрее."

# ch/harems_full/pixie/events.rpy:1781
translate russian pixie_second_threesome_5b92475b:
    mike.say "Н-но как же фаллоимитаторы?"

# ch/harems_full/pixie/events.rpy:1782
translate russian pixie_second_threesome_39417f88:
    mike.say "И... и всё такое?"

# ch/harems_full/pixie/events.rpy:1784
translate russian pixie_second_threesome_8e91cb0f:
    kleio.say "О да, они хороши."

# ch/harems_full/pixie/events.rpy:1785
translate russian pixie_second_threesome_ae5458b7:
    kleio.say "Но мне всё равно нравится чувствовать внутри твёрдый член!"

# ch/harems_full/pixie/events.rpy:1788
translate russian pixie_second_threesome_e8a434d0:
    morgan.say "Или во рту!"

# ch/harems_full/pixie/events.rpy:1791
translate russian pixie_second_threesome_7bf7a10f:
    "Я нетерпеливо киваю, пока Клео расстёгивает мне ширинку и просовывает руку внутрь."

# ch/harems_full/pixie/events.rpy:1793
translate russian pixie_second_threesome_84856a94:
    "Одновременно Морган начинает снимать с меня одежду."

# ch/harems_full/pixie/events.rpy:1794
translate russian pixie_second_threesome_02e6f7ed:
    "Не знаю, поднимает ли меня на ноги одна из них."

# ch/harems_full/pixie/events.rpy:1795
translate russian pixie_second_threesome_d78b42a4:
    "Или я встаю сам, чтобы помочь."

# ch/harems_full/pixie/events.rpy:1797
translate russian pixie_second_threesome_641835a3:
    "Так или иначе, я уже стою и смотрю, как они орудуют."

# ch/harems_full/pixie/events.rpy:1799
translate russian pixie_second_threesome_637b1a63:
    "Морган раздевает меня в рекордное время."

# ch/harems_full/pixie/events.rpy:1801
translate russian pixie_second_threesome_73602b0b:
    "А Клео заботится, чтобы к этому моменту я был к ним готов."

# ch/harems_full/pixie/events.rpy:1803
translate russian pixie_second_threesome_5f81231c:
    "Хотя, надо сказать, у Клео работа попроще."

# ch/harems_full/pixie/events.rpy:1804
translate russian pixie_second_threesome_5a652956:
    "Потому что я уже давно становлюсь всё твёрже с каждой секундой."

# ch/harems_full/pixie/events.rpy:1805
translate russian pixie_second_threesome_06d9e971:
    "Ей достаточно простого прикосновения, чтобы я встал по стойке смирно."

# ch/harems_full/pixie/events.rpy:1807
translate russian pixie_second_threesome_c8e7406d:
    "Клео к этому моменту уже опустилась передо мной на колени."

# ch/harems_full/pixie/events.rpy:1808
translate russian pixie_second_threesome_31642c09:
    "А Морган всё ещё отбрасывает последние предметы моей одежды."

# ch/harems_full/pixie/events.rpy:1809
translate russian pixie_second_threesome_b2ba5279:
    "Затем, кажется, замечает, что её никто не ждёт."

# ch/harems_full/pixie/events.rpy:1810
translate russian pixie_second_threesome_f367b954:
    "И поспешно перебирается через мою грудь, принимаясь за головку члена."

# ch/harems_full/pixie/events.rpy:1811
translate russian pixie_second_threesome_162ae04d:
    "На Клео это, похоже, никак не влияет."

# ch/harems_full/pixie/events.rpy:1812
translate russian pixie_second_threesome_1a361f82:
    "Она лишь смеётся и тоже сразу наклоняется."

# ch/harems_full/pixie/events.rpy:1814
translate russian pixie_second_threesome_ca2b1c15:
    "Обычно я привык, что сначала меня гладят и дразнят."

# ch/harems_full/pixie/events.rpy:1819
translate russian pixie_second_threesome_3ef520dd:
    "Но Морган просто открывает рот и заглатывает целиком!"

# ch/harems_full/pixie/events.rpy:1821
translate russian pixie_second_threesome_0e5a3326:
    "Мгновение спустя её голова уже движется вперёд-назад."

# ch/harems_full/pixie/events.rpy:1822
translate russian pixie_second_threesome_617c95b7:
    "И я ахаю от ощущений, которые она дарит."

# ch/harems_full/pixie/events.rpy:1823
translate russian pixie_second_threesome_1ce86a58:
    "Клео на миг теряется и раздражённо смотрит на Морган."

# ch/harems_full/pixie/events.rpy:1824
translate russian pixie_second_threesome_17fa1fb5:
    "Но потом на её лице появляется решимость, и она принимается за дело."

# ch/harems_full/pixie/events.rpy:1826
translate russian pixie_second_threesome_36639f9f:
    "Опускается ниже и сосредотачивается на моих яйцах."

# ch/harems_full/pixie/events.rpy:1827
translate russian pixie_second_threesome_4f55ce53:
    "И вот уже две части моего тела оказались в разных ртах!"

# ch/harems_full/pixie/events.rpy:1828
translate russian pixie_second_threesome_5ae367b5:
    "Морган продолжает заниматься моим членом."

# ch/harems_full/pixie/events.rpy:1829
translate russian pixie_second_threesome_6b7416d3:
    "Лижет, сосёт и покусывает, пока мне не начинает казаться, что я вот-вот взорвусь."

# ch/harems_full/pixie/events.rpy:1830
translate russian pixie_second_threesome_1c827ee6:
    "Всё это время Клео делает то же самое и даже больше."

# ch/harems_full/pixie/events.rpy:1831
translate russian pixie_second_threesome_a9aa41e2:
    "Когда удовольствие нарастает, я невольно закрываю глаза."

# ch/harems_full/pixie/events.rpy:1836
translate russian pixie_second_threesome_20fc66b6:
    kleio.say "Ой-ой!"

# ch/harems_full/pixie/events.rpy:1837
translate russian pixie_second_threesome_7248d54b:
    kleio.say "Похоже, кто-то вот-вот кончит!"

# ch/harems_full/pixie/events.rpy:1839
translate russian pixie_second_threesome_3a03d6bc:
    morgan.say "Не переживай, я справлюсь!"

# ch/harems_full/pixie/events.rpy:1841
translate russian pixie_second_threesome_c40bf0d0:
    morgan.say "Хочешь, я возьму это на себя, Клео?"

# ch/harems_full/pixie/events.rpy:1843
translate russian pixie_second_threesome_9b5829aa:
    morgan.say "О-о!"

# ch/harems_full/pixie/events.rpy:1844
translate russian pixie_second_threesome_fdcc41c4:
    morgan.say "Можно в этот раз мне?"

# ch/harems_full/pixie/events.rpy:1845
translate russian pixie_second_threesome_a387d8f0:
    kleio.say "Не-а, Морган."

# ch/harems_full/pixie/events.rpy:1846
translate russian pixie_second_threesome_c35c9f7f:
    kleio.say "Пусть он сам выбирает..."

# ch/harems_full/pixie/events.rpy:1847
translate russian pixie_second_threesome_dea5333c:
    "Я смотрю, как Клео и Морган обе садятся на пятки."

# ch/harems_full/pixie/events.rpy:1848
translate russian pixie_second_threesome_d8fef25d:
    "И терпеливо ждут, что я сделаю дальше."

# ch/harems_full/pixie/events.rpy:1851
translate russian pixie_second_threesome_f424093b:
    "Выбрать непросто."

# ch/harems_full/pixie/events.rpy:1852
translate russian pixie_second_threesome_f1db3425:
    "Но если кончить им на лица, может, выбирать вообще не придётся." with hpunch

# ch/harems_full/pixie/events.rpy:1853
translate russian pixie_second_threesome_6f421172:
    "Пока обе стоят передо мной на коленях, я даю себе волю."

# ch/harems_full/pixie/events.rpy:1856
translate russian pixie_second_threesome_66093f52:
    "И, выплёскивая сперму, стараюсь окатить обеих."

# ch/harems_full/pixie/events.rpy:1857
translate russian pixie_second_threesome_bbc42a5d:
    "Клео и Морган закрывают глаза."

# ch/harems_full/pixie/events.rpy:1859
translate russian pixie_second_threesome_0612791a:
    "Но рты держат открытыми."

# ch/harems_full/pixie/events.rpy:1860
translate russian pixie_second_threesome_1d3dbf9f:
    "Белые полосы спермы покрывают их лица и начинают стекать вниз."

# ch/harems_full/pixie/events.rpy:1862
translate russian pixie_second_threesome_96016bf5:
    "Они ни разу не вздрагивают, наслаждаясь происходящим."

# ch/harems_full/pixie/events.rpy:1863
translate russian pixie_second_threesome_180ded1a:
    "Закончив, я сажусь на кровать."

# ch/harems_full/pixie/events.rpy:1864
translate russian pixie_second_threesome_221abe5b:
    "Иначе, я знаю, просто свалюсь на пол."

# ch/harems_full/pixie/events.rpy:1865
translate russian pixie_second_threesome_b7ae390e:
    "Клео и Морган подползают ко мне."

# ch/harems_full/pixie/events.rpy:1866
translate russian pixie_second_threesome_e4bff44d:
    "И каждая обнимает одну из моих ног."

# ch/harems_full/pixie/events.rpy:1867
translate russian pixie_second_threesome_e522e9a7:
    "Но по тому, как они смотрят на меня снизу вверх, я точно понимаю одно."

# ch/harems_full/pixie/events.rpy:1868
translate russian pixie_second_threesome_d471436c:
    "Обе ещё далеки от полного удовлетворения."

# ch/harems_full/pixie/events.rpy:1869
translate russian pixie_second_threesome_10c6e42b:
    "Более того, до конца ночи они наверняка потребуют от меня гораздо большего!"

# ch/harems_full/pixie/events.rpy:1878
translate russian pixie_second_threesome_d7117224:
    "Выбирать между Клео и Морган очень трудно."

# ch/harems_full/pixie/events.rpy:1879
translate russian pixie_second_threesome_58a1c7ff:
    "Почти невозможно!"

# ch/harems_full/pixie/events.rpy:1880
translate russian pixie_second_threesome_451dc595:
    "Поэтому я решаю взглянуть на выбор иначе, надеясь облегчить себе задачу."

# ch/harems_full/pixie/events.rpy:1881
translate russian pixie_second_threesome_52afebb1:
    "И думаю, кого из них хотел бы трахнуть."

# ch/harems_full/pixie/events.rpy:1882
translate russian pixie_second_threesome_626ce265:
    "А кого — позвать помогать мне в этом!"

# ch/harems_full/pixie/events.rpy:1883
translate russian pixie_second_threesome_647913e6:
    mike.say "Эй, Клео..."

# ch/harems_full/pixie/events.rpy:1884
translate russian pixie_second_threesome_717b9f5e:
    mike.say "Как насчёт того, чтобы вдвоём порадовать Морган?"

# ch/harems_full/pixie/events.rpy:1885
translate russian pixie_second_threesome_ab1b1c21:
    "Клео кивает с дьявольской улыбкой."

# ch/harems_full/pixie/events.rpy:1886
translate russian pixie_second_threesome_f60dafcd:
    kleio.say "Почему бы и нет, сердцеед!"

# ch/harems_full/pixie/events.rpy:1887
translate russian pixie_second_threesome_05ba0a5f:
    kleio.say "Только делай, как я, ладно?"

# ch/harems_full/pixie/events.rpy:1888
translate russian pixie_second_threesome_1d7c75d4:
    kleio.say "Глядишь, чему-нибудь научишься!"

# ch/harems_full/pixie/events.rpy:1889
translate russian pixie_second_threesome_a5ffc236:
    "Морган переводит взгляд с меня на Клео и обратно."

# ch/harems_full/pixie/events.rpy:1891
translate russian pixie_second_threesome_3ec951f4:
    morgan.say "Эй..."

# ch/harems_full/pixie/events.rpy:1892
translate russian pixie_second_threesome_01d09eef:
    morgan.say "Чего вы вдвоём на меня нацелились?!"

# ch/harems_full/pixie/events.rpy:1894
translate russian pixie_second_threesome_27fbf898:
    morgan.say "Ч-что происходит?"

# ch/harems_full/pixie/events.rpy:1895
translate russian pixie_second_threesome_793b0bf7:
    morgan.say "Я думала, мы тут все равны!"

# ch/harems_full/pixie/events.rpy:1897
translate russian pixie_second_threesome_fafb452f:
    morgan.say "О нет..."

# ch/harems_full/pixie/events.rpy:1898
translate russian pixie_second_threesome_1b1ebeb0:
    morgan.say "Что вы собираетесь со мной сделать?!"

# ch/harems_full/pixie/events.rpy:1899
translate russian pixie_second_threesome_59ab2fc7:
    "Морган качает головой и отползает назад по кровати."

# ch/harems_full/pixie/events.rpy:1901
translate russian pixie_second_threesome_2c43e3fa:
    "Клео подкрадывается слева, я — справа."

# ch/harems_full/pixie/events.rpy:1902
translate russian pixie_second_threesome_a623bd4e:
    "И мгновение спустя мы набрасываемся на Морган!"

# ch/harems_full/pixie/events.rpy:1903
translate russian pixie_second_threesome_64a6676e:
    "Клео обхватывает её за плечи и тянет вниз."

# ch/harems_full/pixie/events.rpy:1904
translate russian pixie_second_threesome_4f535f5c:
    "А я крепко хватаю Морган за бёдра."

# ch/harems_full/pixie/events.rpy:1905
translate russian pixie_second_threesome_fbc84c11:
    "Она извивается и ёрзает, а мой член уже твёрдый."

# ch/harems_full/pixie/events.rpy:1906
translate russian pixie_second_threesome_f73d2c0b:
    "Я глубоко вдыхаю и делаю своё дело..."

# ch/harems_full/pixie/events.rpy:1909
translate russian pixie_second_threesome_6a2ba028:
    "На изыски нет времени, так что я решаю действовать проще."

# ch/harems_full/pixie/events.rpy:1910
translate russian pixie_second_threesome_254184d6:
    "Или, может, просто чувствую запах киски Морган и не могу удержаться."

# ch/harems_full/pixie/events.rpy:1911
translate russian pixie_second_threesome_c2f88b61:
    "Так или иначе, мой член трётся о её губы."

# ch/harems_full/pixie/events.rpy:1912
translate russian pixie_second_threesome_f95798bd:
    "Они скользкие и уже начинают поддаваться."

# ch/harems_full/pixie/events.rpy:1913
translate russian pixie_second_threesome_6824a066:
    "Мгновение спустя я очень мягко толкаюсь..."

# ch/harems_full/pixie/events.rpy:1916
translate russian pixie_second_threesome_05f66cd0:
    "И чувствую, как губы Морган расходятся, впуская меня."

