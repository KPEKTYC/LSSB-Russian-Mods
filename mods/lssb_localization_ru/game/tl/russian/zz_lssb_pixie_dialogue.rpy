    morgan.say "О-о... куда ты его вставишь?"

# ch/harems_full/pixie/events.rpy:2226
translate russian pixie_second_threesome_e28fcff0:
    "Ягодицы Клео уже раздвигаются перед моим членом."

# ch/harems_full/pixie/events.rpy:2227
translate russian pixie_second_threesome_a48ce77a:
    "И тут я опускаю взгляд на её тесную маленькую попку."

# ch/harems_full/pixie/events.rpy:2228
translate russian pixie_second_threesome_4970cd68:
    "Всё, решено. Не могу устоять!"

# ch/harems_full/pixie/events.rpy:2229
translate russian pixie_second_threesome_67e5b325:
    "Я раздвигаю её ягодицы ещё чуть шире."

# ch/harems_full/pixie/events.rpy:2230
translate russian pixie_second_threesome_4373e3f9:
    "Затем проталкиваю головку члена прямо туда."

# ch/harems_full/pixie/events.rpy:2233
translate russian pixie_second_threesome_a0c62621_1:
    kleio.say "О боже..."

# ch/harems_full/pixie/events.rpy:2234
translate russian pixie_second_threesome_c2b223ee_1:
    kleio.say "Да, сердцеед..."

# ch/harems_full/pixie/events.rpy:2235
