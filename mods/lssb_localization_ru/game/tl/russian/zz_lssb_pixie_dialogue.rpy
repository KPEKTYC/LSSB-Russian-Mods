    "Вижу, что ей не терпится подыграть."

# ch/harems_full/pixie/events.rpy:2090
translate russian pixie_second_threesome_0e41e6a1:
    morgan.say "Конечно, [lssb_common.hero_name()]."

# ch/harems_full/pixie/events.rpy:2091
translate russian pixie_second_threesome_171d3781:
    morgan.say "И давай уж играть по полной!"

# ch/harems_full/pixie/events.rpy:2093
translate russian pixie_second_threesome_f5f24278:
    morgan.say "Будто нужно спрашивать!"

# ch/harems_full/pixie/events.rpy:2094
translate russian pixie_second_threesome_4629f9bf:
    morgan.say "Вот это будет весело!"

# ch/harems_full/pixie/events.rpy:2096
translate russian pixie_second_threesome_f6cf5779:
    morgan.say "Как скажешь, [lssb_common.hero_name()]."

# ch/harems_full/pixie/events.rpy:2097
translate russian pixie_second_threesome_f75dfc5e:
    morgan.say "Только укажи, куда двигаться!"

# ch/harems_full/pixie/events.rpy:2098
translate russian pixie_second_threesome_0f3a4705:
    "А вот Клео выглядит немного встревоженной."

# ch/harems_full/pixie/events.rpy:2099
translate russian pixie_second_threesome_9f34ba40:
    "Не думаю, что она была готова к такому нашему объединению!"

# ch/harems_full/pixie/events.rpy:2100
translate russian pixie_second_threesome_b5927e76:
    kleio.say "Эй!"

# ch/harems_full/pixie/events.rpy:2101
translate russian pixie_second_threesome_a0705efe:
    kleio.say "Это ещё что за хрень?"

# ch/harems_full/pixie/events.rpy:2102
translate russian pixie_second_threesome_d39735d0:
    kleio.say "У нас тут вроде секс втроём!"

# ch/harems_full/pixie/events.rpy:2103
translate russian pixie_second_threesome_cb99ecbb:
    kleio.say "Нельзя вдвоём на одну!"

# ch/harems_full/pixie/events.rpy:2104
translate russian pixie_second_threesome_1d771aea:
    "Я понимающе улыбаюсь Клео и начинаю приближаться."

# ch/harems_full/pixie/events.rpy:2105
translate russian pixie_second_threesome_4e5bf8ea:
    "И киваю Морган, чтобы делала то же."

# ch/harems_full/pixie/events.rpy:2106
translate russian pixie_second_threesome_e4c21a63:
    "Клео отступает от нас, забираясь на кровать."

# ch/harems_full/pixie/events.rpy:2107
translate russian pixie_second_threesome_2ba5e969:
    "Я собирался наброситься на неё."

# ch/harems_full/pixie/events.rpy:2108
translate russian pixie_second_threesome_404e7518:
    "Но Морган меня опережает!"

# ch/harems_full/pixie/events.rpy:2109
translate russian pixie_second_threesome_bf66a313:
    "Неожиданным прыжком она оказывается на Клео и прижимает её!"

# ch/harems_full/pixie/events.rpy:2114
translate russian pixie_second_threesome_a7c4ec09:
    morgan.say "Попалась!"

# ch/harems_full/pixie/events.rpy:2116
translate russian pixie_second_threesome_ad32bd2c:
    morgan.say "Медленно, Клео!"

# ch/harems_full/pixie/events.rpy:2118
translate russian pixie_second_threesome_eb1178b3:
    morgan.say "Скорее, [lssb_common.hero_name()], я её держу!"

# ch/harems_full/pixie/events.rpy:2119
translate russian pixie_second_threesome_c1608229:
    "Морган уже сидит верхом на талии Клео, заставляя ту извиваться под её весом."

# ch/harems_full/pixie/events.rpy:2120
translate russian pixie_second_threesome_57af10de:
    "Я спешу присоединиться и прыгаю на Клео чуть ниже."

# ch/harems_full/pixie/events.rpy:2121
translate russian pixie_second_threesome_4ed5313b:
    kleio.say "Вы двое — засранцы, знаете?!"

# ch/harems_full/pixie/events.rpy:2122
translate russian pixie_second_threesome_4df2a922:
    kleio.say "И лучше бы вам сделать так, чтобы оно того стоило!"

# ch/harems_full/pixie/events.rpy:2123
translate russian pixie_second_threesome_e2a2c8df:
    "Об этом Клео точно не придётся просить."

# ch/harems_full/pixie/events.rpy:2124
translate russian pixie_second_threesome_cc7d2749:
    "Мой член уже как следует затвердел, сердце колотится в груди."

# ch/harems_full/pixie/events.rpy:2125
translate russian pixie_second_threesome_6fadc2b3:
    "И я думаю только о том, как её трахнуть!"

# ch/harems_full/pixie/events.rpy:2128
translate russian pixie_second_threesome_88cdc474:
    "Морган сидит выше меня, оседлав талию Клео."

# ch/harems_full/pixie/events.rpy:2129
translate russian pixie_second_threesome_14d91ab2:
    "А значит, ниже этого места всем распоряжаюсь я."

# ch/harems_full/pixie/events.rpy:2130
translate russian pixie_second_threesome_4b941d93:
    "Не теряя времени, я широко раздвигаю ноги Клео."

# ch/harems_full/pixie/events.rpy:2131
translate russian pixie_second_threesome_57ed02a6:
    "Теперь можно выбрать, куда двигаться дальше."

# ch/harems_full/pixie/events.rpy:2133
translate russian pixie_second_threesome_d9391089:
    morgan.say "Чего ждёшь, письменного приглашения?"

# ch/harems_full/pixie/events.rpy:2135
translate russian pixie_second_threesome_c2bac22e:
    morgan.say "Поторопись, [lssb_common.hero_name()]!"

# ch/harems_full/pixie/events.rpy:2137
translate russian pixie_second_threesome_b55e8ea1:
    morgan.say "О-о... куда ты его вставишь?"

# ch/harems_full/pixie/events.rpy:2138
translate russian pixie_second_threesome_e0ade411:
    "Я уже чувствую губы киски Клео на своём члене."

# ch/harems_full/pixie/events.rpy:2139
translate russian pixie_second_threesome_d8e8b991:
    "Мягкие, влажные, манящие — и полностью в моей власти."

# ch/harems_full/pixie/events.rpy:2140
translate russian pixie_second_threesome_440e8a28:
    "Я не могу устоять перед желанием этим воспользоваться!"

# ch/harems_full/pixie/events.rpy:2141
translate russian pixie_second_threesome_9ef79143:
    "Достаточно лишь слегка надавить."

# ch/harems_full/pixie/events.rpy:2144
translate russian pixie_second_threesome_5ee93c1f:
    "Даже этого хватает, чтобы Клео застонала."

# ch/harems_full/pixie/events.rpy:2145
translate russian pixie_second_threesome_361716eb:
    "Её голос возбуждает почти так же сильно, как ощущения от её тела."

# ch/harems_full/pixie/events.rpy:2146
translate russian pixie_second_threesome_a0c62621:
    kleio.say "О боже..."

# ch/harems_full/pixie/events.rpy:2147
translate russian pixie_second_threesome_c2b223ee:
    kleio.say "Да, сердцеед..."

# ch/harems_full/pixie/events.rpy:2148
translate russian pixie_second_threesome_ae121f6b:
    kleio.say "Ты и правда дашь мне то, чего я хочу!"

# ch/harems_full/pixie/events.rpy:2149
translate russian pixie_second_threesome_ec8d50ff:
    "Мгновение спустя Морган наклоняется над Клео."

# ch/harems_full/pixie/events.rpy:2150
translate russian pixie_second_threesome_4c66d26c:
    "И накрывает её рот своими губами."

# ch/harems_full/pixie/events.rpy:2151
translate russian pixie_second_threesome_6fc65856:
    "Теперь я слышу лишь вздохи Клео сквозь их поцелуи."

# ch/harems_full/pixie/events.rpy:2152
translate russian pixie_second_threesome_0a245ed6:
    "Зрелище потрясающее, и на миг я почти забываю, что делаю."

# ch/harems_full/pixie/events.rpy:2154
translate russian pixie_second_threesome_79ab3da2:
    "Затем вздрагиваю, вспомнив, что нахожусь в Клео настолько глубоко, насколько возможно!"

# ch/harems_full/pixie/events.rpy:2156
translate russian pixie_second_threesome_6f4ed5d2:
    "Секунду спустя я снова начинаю действовать, недоверчиво качая головой."

# ch/harems_full/pixie/events.rpy:2160
translate russian pixie_second_threesome_f7c4e321:
    "Двигаюсь в Клео вперёд-назад."

# ch/harems_full/pixie/events.rpy:2164
translate russian pixie_second_threesome_641a0c92:
    "И результат хорошо заметен."

# ch/harems_full/pixie/events.rpy:2166
translate russian pixie_second_threesome_b9753a15:
    "Голова Клео прижата к подушкам и мечется из стороны в сторону."

# ch/harems_full/pixie/events.rpy:2167
translate russian pixie_second_threesome_4e8e579c:
    "Все её ощущения написаны на лице."

# ch/harems_full/pixie/events.rpy:2168
translate russian pixie_second_threesome_4b9fcffb:
    "Морган прерывает поцелуй, не в силах угнаться."

# ch/harems_full/pixie/events.rpy:2169
translate russian pixie_second_threesome_58ee2390:
    "И вместо этого начинает ласкать обнажённую грудь Клео."

# ch/harems_full/pixie/events.rpy:2170
translate russian pixie_second_threesome_f269e4ea:
    "Конечно, это лишь усиливает её ощущения."

# ch/harems_full/pixie/events.rpy:2172
translate russian pixie_second_threesome_c343c8de:
    "Вскоре Клео совсем беспомощна под нами с Морган."

# ch/harems_full/pixie/events.rpy:2173
translate russian pixie_second_threesome_b4113d29:
    "Но удерживает её не вес наших тел."

# ch/harems_full/pixie/events.rpy:2174
translate russian pixie_second_threesome_6f0167a4:
    "А сила того, что мы с ней делаем!"

# ch/harems_full/pixie/events.rpy:2175
translate russian pixie_second_threesome_db4409f4:
    "С каждой секундой я трахаю её всё сильнее."

# ch/harems_full/pixie/events.rpy:2176
translate russian pixie_second_threesome_defb8eb0:
    "И одновременно Морган тоже её ласкает."

# ch/harems_full/pixie/events.rpy:2178
translate russian pixie_second_threesome_4d4a28f6:
    "Уже чувствую, как Клео начинает подёргиваться и выгибаться подо мной."

# ch/harems_full/pixie/events.rpy:2179
translate russian pixie_second_threesome_8738e9f3:
    "Её мышцы всё сильнее сжимают мой член."

# ch/harems_full/pixie/events.rpy:2180
translate russian pixie_second_threesome_00f06570:
    "Мне не нужно объяснять, что она вот-вот потеряет контроль."

# ch/harems_full/pixie/events.rpy:2181
translate russian pixie_second_threesome_98673164:
    "Но это не мешает Морган поделиться своими наблюдениями!"

# ch/harems_full/pixie/events.rpy:2183
translate russian pixie_second_threesome_8b73a085:
    morgan.say "Держись, [lssb_common.hero_name()]!"

# ch/harems_full/pixie/events.rpy:2184
translate russian pixie_second_threesome_e48952a4:
    morgan.say "Эта сучка сейчас взорвётся!"

# ch/harems_full/pixie/events.rpy:2186
translate russian pixie_second_threesome_4b00239f_2:
    morgan.say "О чёрт..."

# ch/harems_full/pixie/events.rpy:2187
translate russian pixie_second_threesome_4f9b5339:
    morgan.say "Кажется, она сейчас кончит!"

# ch/harems_full/pixie/events.rpy:2189
translate russian pixie_second_threesome_56ab04f3:
    morgan.say "Ох..."

# ch/harems_full/pixie/events.rpy:2190
translate russian pixie_second_threesome_c9bd6a65:
    morgan.say "По-моему, у неё сейчас будет оргазм!"

# ch/harems_full/pixie/events.rpy:2193
translate russian pixie_second_threesome_44bc04e5:
    "Времени ни на что, кроме продолжения, уже нет."

# ch/harems_full/pixie/events.rpy:2194
translate russian pixie_second_threesome_b443b91f:
    "И я именно так и поступаю, вколачиваясь в Клео до самого конца."

# ch/harems_full/pixie/events.rpy:2197
translate russian pixie_second_threesome_64676952:
    "Я ахаю, выплёскивая в неё сперму без остатка."

# ch/harems_full/pixie/events.rpy:2199
translate russian pixie_second_threesome_1fb58aa7:
    "Чувствую, как она принимает всё и тоже теряет контроль."

# ch/harems_full/pixie/events.rpy:2200
translate russian pixie_second_threesome_7dbd019a:
    "Потом я откидываюсь назад на кровать, обессилев и тяжело дыша."

# ch/harems_full/pixie/events.rpy:2201
translate russian pixie_second_threesome_741f1497:
    "Морган смотрит на меня через плечо с лукавой ухмылкой."

# ch/harems_full/pixie/events.rpy:2202
translate russian pixie_second_threesome_589f8f57:
    "Затем переводит взгляд на Клео, наслаждаясь видом нас обоих без сил."

# ch/harems_full/pixie/events.rpy:2207
translate russian pixie_second_threesome_4975c025:
    "Я едва успеваю выйти из Клео, пока не поздно."

# ch/harems_full/pixie/events.rpy:2208
translate russian pixie_second_threesome_4d0925b0:
    "Морган продолжает прижимать её к кровати, пока я откидываюсь назад."

# ch/harems_full/pixie/events.rpy:2210
translate russian pixie_second_threesome_cc60b343:
    "Мгновение спустя я кончаю, и большая часть спермы попадает ей на спину."

# ch/harems_full/pixie/events.rpy:2212
translate russian pixie_second_threesome_741f1497_1:
    "Морган смотрит на меня через плечо с лукавой ухмылкой."

# ch/harems_full/pixie/events.rpy:2213
