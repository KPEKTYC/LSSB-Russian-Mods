# ch/samantha/chat.rpy:187
translate russian samantha_desire_1_male_71b51bbb:
    samantha.say "Мы с Райаном вчера ходили в парк."

# ch/samantha/chat.rpy:188
translate russian samantha_desire_1_male_4d04d5d2:
    samantha.say "Он взял рабочий звонок у утиного пруда и на сорок минут оставил меня на скамейке."

# ch/samantha/chat.rpy:189
translate russian samantha_desire_1_male_c690be30:
    samantha.say "А я сидела с его курткой на коленях и писала тебе непристойности."

# ch/samantha/chat.rpy:190
translate russian samantha_desire_1_male_1d190c8a:
    mike.say "Бедняга..."

# ch/samantha/chat.rpy:192
translate russian samantha_desire_1_male_597f5cc2:
    samantha.say "Вчера гуляла по парку и час просидела на скамейке."

# ch/samantha/chat.rpy:193
translate russian samantha_desire_1_male_13c0d2c6:
    mike.say "Что делала?"

# ch/samantha/chat.rpy:194
translate russian samantha_desire_1_male_bfd4df6d:
    samantha.say "Смотрела, как малыш сражается с голубем за круассан."

# ch/samantha/chat.rpy:195
translate russian samantha_desire_1_male_f01b59b1:
    samantha.say "Вот и все новости, [lssb_samantha.hero_name()]. Голубь победил."

# ch/samantha/chat.rpy:197
translate russian samantha_desire_1_male_71b51bbb_1:
    samantha.say "Мы с Райаном вчера ходили в парк."

# ch/samantha/chat.rpy:204
translate russian samantha_desire_1_male_71749660:
    samantha.say "[lssb_samantha.phrase_text(what)]"

# ch/samantha/chat.rpy:205
translate russian samantha_desire_1_male_90e085f5:
    mike.say "Бедная ты..."

# ch/samantha/chat.rpy:207
translate russian samantha_desire_1_male_6c4e13d1:
    samantha.say "Тебе стоит больше стараться быть сексуальным, чтобы я чувствовала себя желанной."

# ch/samantha/chat.rpy:209
translate russian samantha_desire_1_male_031f487c:
    samantha.say "Вчера ходила в парк. Одна, как женщина из грустной рекламы."

# ch/samantha/chat.rpy:210
translate russian samantha_desire_1_male_0be38ef7:
    mike.say "Было ужасно?"

# ch/samantha/chat.rpy:211
translate russian samantha_desire_1_male_f6e363d2:
    samantha.say "Маленькие победы, [lssb_samantha.hero_name()]. Собираю их, как марки."

# ch/samantha/chat.rpy:213
translate russian samantha_desire_1_male_30135587:
    samantha.say "Райан был настоящей задницей."

# ch/samantha/chat.rpy:214
translate russian samantha_desire_1_male_bd6cb912:
