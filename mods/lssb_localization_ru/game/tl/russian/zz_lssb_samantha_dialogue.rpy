# ch/samantha/chat.rpy:259
translate russian samantha_desire_2_male_97ac24ea:
    samantha.say "Райан говорил, что ты был в меня влюблён, когда мы все жили вместе."

# ch/samantha/chat.rpy:260
translate russian samantha_desire_2_male_43e77d05:
    mike.say "Предатель..."

# ch/samantha/chat.rpy:261
translate russian samantha_desire_2_male_94cc8ef9:
    samantha.say "Он считал это шуткой, [lssb_samantha.hero_name()]."

# ch/samantha/chat.rpy:262
translate russian samantha_desire_2_male_9e833f42:
    samantha.say "Не знал, что зачитывает финал."

# ch/samantha/chat.rpy:265
translate russian samantha_desire_2_male_94e4dab7:
    samantha.say "Райан рассказал, что ты был в меня влюблён, когда мы все жили вместе."

# ch/samantha/chat.rpy:266
translate russian samantha_desire_2_male_e66666a7:
    samantha.say "Считал, что ничего смешнее в жизни не слышал."

# ch/samantha/chat.rpy:267
translate russian samantha_desire_2_male_a3277851:
    mike.say "А теперь?"

# ch/samantha/chat.rpy:268
translate russian samantha_desire_2_male_c7144132:
    samantha.say "А теперь я представляю его лицо каждый раз, когда ты ко мне прикасаешься."

# ch/samantha/chat.rpy:271
translate russian samantha_desire_2_male_2d9b3f61:
    samantha.say "Райан говорил, что ты был в меня влюблён, когда мы жили вместе."

# ch/samantha/chat.rpy:272
translate russian samantha_desire_2_male_43e77d05_1:
    mike.say "Предатель..."

# ch/samantha/chat.rpy:273
translate russian samantha_desire_2_male_7dddce88:
    mike.say "Скорее просто увлечение."

# ch/samantha/chat.rpy:274
translate russian samantha_desire_2_male_bf0470e9:
    mike.say "И оно давно прошло."

# ch/samantha/chat.rpy:275
