# ch/samantha/events.rpy:7872
translate russian samantha_birthday_date_male_fc0eb647:
    mike.say "Мне совсем не хочется делить тебя со всеми остальными, Кексик!"

# ch/samantha/events.rpy:7874
translate russian samantha_birthday_date_male_e26a3d4a:
