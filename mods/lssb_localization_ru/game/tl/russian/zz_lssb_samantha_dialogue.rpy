# ch/samantha/events.rpy:8487
translate russian samantha_exclusive_cheated_469d7a6a:
    mike.say "Ты вообще о чём?!"

# ch/samantha/events.rpy:8488
translate russian samantha_exclusive_cheated_7e4bbd52:
