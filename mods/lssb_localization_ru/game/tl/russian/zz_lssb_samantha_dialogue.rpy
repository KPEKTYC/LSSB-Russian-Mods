    mike.say "Это..."

# ch/samantha/events.rpy:1139
translate russian samantha_preg_talk_ryan_4a966774_1:
    mike.say "Здорово, Кексик! Потрясающая новость!"

# ch/samantha/events.rpy:1141
translate russian samantha_preg_talk_ryan_323d5a16_1:
    mike.say "Здорово, Сэм! Потрясающая новость!"

# ch/samantha/events.rpy:1142
translate russian samantha_preg_talk_ryan_ecfdd96b_1:
    mike.say "Уверен, ты будешь прекрасной мамой."

# ch/samantha/events.rpy:1144
translate russian samantha_preg_talk_ryan_0ff9ce0f_1:
    "Лицо Сэм озаряется улыбкой."

# ch/samantha/events.rpy:1145
translate russian samantha_preg_talk_ryan_5280c5ae_1:
    "Именно той улыбкой, от которой у меня ноет сердце."

# ch/samantha/events.rpy:1146
translate russian samantha_preg_talk_ryan_b5aa93a6_1:
    samantha.say "Ох, спасибо, [lssb_samantha.hero_name()]!"

# ch/samantha/events.rpy:1147
translate russian samantha_preg_talk_ryan_7333d50d_1:
    samantha.say "А Райан?"

# ch/samantha/events.rpy:1148
translate russian samantha_preg_talk_ryan_9747c8d7_1:
    samantha.say "Он ведь будет отличным папой, правда?"

# ch/samantha/events.rpy:1149
translate russian samantha_preg_talk_ryan_06b56a76_1:
    "Спрашивая, Сэм продолжает улыбаться."

# ch/samantha/events.rpy:1150
translate russian samantha_preg_talk_ryan_c85691ee_1:
    "Она не может знать, как это проворачивает нож у меня внутри."

# ch/samantha/events.rpy:1151
translate russian samantha_preg_talk_ryan_0c13bc82:
    "Часть меня хочет рассказать правду."

# ch/samantha/events.rpy:1152
translate russian samantha_preg_talk_ryan_d16f4f9f:
    "Сказать, что он подонок и её не заслуживает."

# ch/samantha/events.rpy:1153
translate russian samantha_preg_talk_ryan_b63465f9:
    "Но я уже сделал выбор."

# ch/samantha/events.rpy:1155
translate russian samantha_preg_talk_ryan_3998d201_1:
    mike.say "Да, Кексик..."

# ch/samantha/events.rpy:1157
translate russian samantha_preg_talk_ryan_7a91cf6a_1:
    mike.say "Да, Сэм..."

# ch/samantha/events.rpy:1158
translate russian samantha_preg_talk_ryan_1c4e2873_1:
    mike.say "Конечно будет!"

# ch/samantha/events.rpy:1159
translate russian samantha_preg_talk_ryan_209a23a8_1:
    mike.say "Вы будете идеальной маленькой семьёй!"

# ch/samantha/events.rpy:1160
translate russian samantha_preg_talk_ryan_978160d8_1:
    "Каким-то образом удерживаю улыбку."

# ch/samantha/events.rpy:1161
translate russian samantha_preg_talk_ryan_e29761e8_1:
    "Сэм не замечает, каких усилий это мне стоит."

# ch/samantha/events.rpy:1164
translate russian samantha_preg_talk_ryan_11391773:
    "После всего, что я видел между Сэм и Райаном и о чём молчал..."

# ch/samantha/events.rpy:1165
translate russian samantha_preg_talk_ryan_bb3ce1f2:
    "Следовало бы просто улыбнуться и притвориться, что рад и этой новости."

# ch/samantha/events.rpy:1166
translate russian samantha_preg_talk_ryan_ff1a9e50:
    "Но я начинаю говорить раньше, чем успеваю себя остановить."

# ch/samantha/events.rpy:1167
translate russian samantha_preg_talk_ryan_0cacc392:
    "А потом уже поздно: всё вырывается наружу."

# ch/samantha/events.rpy:1169
translate russian samantha_preg_talk_ryan_a68d5182:
    mike.say "Больше не могу, Кексик!"

# ch/samantha/events.rpy:1171
translate russian samantha_preg_talk_ryan_0d202c87:
    mike.say "Больше не могу, Сэм!"

# ch/samantha/events.rpy:1172
translate russian samantha_preg_talk_ryan_82d40314:
    mike.say "Не могу дальше его покрывать!"

# ch/samantha/events.rpy:1174
translate russian samantha_preg_talk_ryan_fc3771f3:
    "Сэм озадаченно смотрит на меня и растерянно качает головой."

# ch/samantha/events.rpy:1175
translate russian samantha_preg_talk_ryan_08c70309:
    samantha.say "Кого покрывать, [lssb_samantha.hero_name()]?"

# ch/samantha/events.rpy:1176
translate russian samantha_preg_talk_ryan_510f3e34:
    samantha.say "Ч... что ты имеешь в виду?"

# ch/samantha/events.rpy:1178
translate russian samantha_preg_talk_ryan_ee91d31b:
    mike.say "Райан тебе изменяет, Кексик."

# ch/samantha/events.rpy:1180
translate russian samantha_preg_talk_ryan_a99b71b6:
    mike.say "Райан тебе изменяет, Сэм."

# ch/samantha/events.rpy:1181
translate russian samantha_preg_talk_ryan_acdfb343:
    mike.say "Он всё это время тебе изменял!"

# ch/samantha/events.rpy:1183
translate russian samantha_preg_talk_ryan_e84b46d9:
    "Сэм продолжает качать головой."

# ch/samantha/events.rpy:1184
translate russian samantha_preg_talk_ryan_2dab1829:
    "Будто одним этим движением может опровергнуть мои слова."

# ch/samantha/events.rpy:1185
translate russian samantha_preg_talk_ryan_441f6f55:
    samantha.say "Он... он бы так со мной не поступил!"

# ch/samantha/events.rpy:1186
translate russian samantha_preg_talk_ryan_84a6a233:
    samantha.say "После всего, через что мы прошли."

# ch/samantha/events.rpy:1188
translate russian samantha_preg_talk_ryan_6e15bcf4:
    samantha.say "Зачем ты это говоришь, [lssb_samantha.hero_name()]?"

# ch/samantha/events.rpy:1189
translate russian samantha_preg_talk_ryan_11247baa:
    samantha.say "Ревнуешь? В этом дело?"

# ch/samantha/events.rpy:1190
translate russian samantha_preg_talk_ryan_b8a265be:
    "В моих чувствах Сэм права."

# ch/samantha/events.rpy:1191
translate russian samantha_preg_talk_ryan_b50900d5:
    "Но не в причине, по которой я это делаю."

# ch/samantha/events.rpy:1193
translate russian samantha_preg_talk_ryan_9cafaf13:
    mike.say "Дело не во мне, Кексик."

# ch/samantha/events.rpy:1195
translate russian samantha_preg_talk_ryan_c2975554:
    mike.say "Дело не во мне, Сэм."

# ch/samantha/events.rpy:1196
translate russian samantha_preg_talk_ryan_45ca6ff1:
    mike.say "А в тебе."

# ch/samantha/events.rpy:1197
translate russian samantha_preg_talk_ryan_77900329:
    mike.say "И, наверное, в твоём ребёнке тоже."

# ch/samantha/events.rpy:1198
translate russian samantha_preg_talk_ryan_8eae14bc:
    samantha.say "Но... почему ты говоришь сейчас, [lssb_samantha.hero_name()]?"

# ch/samantha/events.rpy:1200
translate russian samantha_preg_talk_ryan_d82692e1:
    samantha.say "Зачем дождался, пока я забеременею?"

# ch/samantha/events.rpy:1202
translate russian samantha_preg_talk_ryan_35483ca3:
    mike.say "Не знаю, Кексик."

# ch/samantha/events.rpy:1204
translate russian samantha_preg_talk_ryan_625c9815:
    mike.say "Не знаю, Сэм."

# ch/samantha/events.rpy:1205
translate russian samantha_preg_talk_ryan_a90c867d:
    mike.say "До сих пор молчал, потому что думал: всё обойдётся."

# ch/samantha/events.rpy:1206
translate russian samantha_preg_talk_ryan_b0440eca:
    mike.say "Может, боялся, что ты не поверишь."

# ch/samantha/events.rpy:1207
translate russian samantha_preg_talk_ryan_90f1747c:
    mike.say "Решишь, что я просто пытаюсь вас разлучить."

# ch/samantha/events.rpy:1208
translate russian samantha_preg_talk_ryan_dd49cb81:
    mike.say "Но теперь речь ещё и о ребёнке..."

# ch/samantha/events.rpy:1209
translate russian samantha_preg_talk_ryan_cfbac408:
    mike.say "Это ведь всё меняет?"

# ch/samantha/events.rpy:1210
translate russian samantha_preg_talk_ryan_88c12960:
    "Сэм замолкает и медленно кивает."

# ch/samantha/events.rpy:1211
translate russian samantha_preg_talk_ryan_6b52e290:
    "Кажется, глубоко обдумывает мои слова."

# ch/samantha/events.rpy:1213
translate russian samantha_preg_talk_ryan_7ca7b51f:
    "Наконец смотрит мне в глаза и отвечает."

# ch/samantha/events.rpy:1214
translate russian samantha_preg_talk_ryan_b3f4da1c:
    samantha.say "Думаю, сейчас я хочу побыть одна, [lssb_samantha.hero_name()]."

# ch/samantha/events.rpy:1215
translate russian samantha_preg_talk_ryan_603f46f2:
    samantha.say "Мне нужно подумать о том, что ты сказал."

# ch/samantha/events.rpy:1219
translate russian samantha_preg_talk_ryan_6be2d356:
    "Мне остаётся лишь кивнуть в ответ."

# ch/samantha/events.rpy:1221
translate russian samantha_preg_talk_ryan_07adee64:
    "Потом молча смотрю, как она уходит."

# ch/samantha/events.rpy:1233
translate russian samantha_preg_talk_303fd00b:
    "Занимаюсь повседневными делами, когда мягкий голос прерывает мои мысли."

# ch/samantha/events.rpy:1234
translate russian samantha_preg_talk_0ef03238:
    samantha.say "Привет, [lssb_samantha.hero_name()], есть минутка?"

# ch/samantha/events.rpy:1236
translate russian samantha_preg_talk_d1e34c28:
    "Поворачиваюсь к ней и невольно улыбаюсь. Саманта всегда делает мой день светлее. Всё ещё не верится, что она согласилась переехать к нам."

# ch/samantha/events.rpy:1237
translate russian samantha_preg_talk_754bf784:
    "В руках у неё маленькая белая коробка с логотипом пекарни."

# ch/samantha/events.rpy:1238
translate russian samantha_preg_talk_bca4c60f:
    "Раскрываю руки, и мы нежно обнимаемся. Чувствую, как быстро бьётся её обычно спокойное сердце — гораздо быстрее, чем всегда."

# ch/samantha/events.rpy:1239
translate russian samantha_preg_talk_39c92f78:
    "Отступив на шаг, указываю на коробку в её руках."

# ch/samantha/events.rpy:1242
translate russian samantha_preg_talk_7465ce16:
    "Моё внимание привлекает стук в дверь."

# ch/samantha/events.rpy:1244
translate russian samantha_preg_talk_00df1b82:
    "Хочется его проигнорировать, и несколько долгих секунд я не двигаюсь. Но стук продолжается."

# ch/samantha/events.rpy:1245
translate russian samantha_preg_talk_fc7d8b69:
    mike.say "Иду, иду."

# ch/samantha/events.rpy:1250
translate russian samantha_preg_talk_e930c2e6:
    "Неохотно поднимаюсь с дивана и иду к двери. Поворачиваю покрашенный золотой краской замок — и оказываюсь лицом к лицу с Самантой."

# ch/samantha/events.rpy:1252
translate russian samantha_preg_talk_2c6406d7:
    mike.say "Кексик?"

# ch/samantha/events.rpy:1254
translate russian samantha_preg_talk_13a94265:
    mike.say "Сэм?"

# ch/samantha/events.rpy:1255
translate russian samantha_preg_talk_462fd55d:
    "Она стоит на крыльце с мягким взглядом и маленькой белой коробкой с логотипом пекарни."

# ch/samantha/events.rpy:1256
translate russian samantha_preg_talk_6b953e16:
    samantha.say "Привет! Прости, я ведь не предупредила, что приду?"

# ch/samantha/events.rpy:1257
translate russian samantha_preg_talk_e406223e:
    samantha.say "Совсем закрутилась на работе! Ничего, что я без предупреждения?"

# ch/samantha/events.rpy:1258
translate russian samantha_preg_talk_1ad67ab5:
    "Она уже знает, что я отвечу."

# ch/samantha/events.rpy:1259
translate russian samantha_preg_talk_f16acf3e:
    mike.say "Да, конечно. Заходи."

# ch/samantha/events.rpy:1260
translate russian samantha_preg_talk_127a3eda:
    "Отступаю и шире открываю дверь. Она входит, слегка нервничая и крепче прижимая коробку."

# ch/samantha/events.rpy:1264
translate russian samantha_preg_talk_7d540191:
    mike.say "Что это?"

# ch/samantha/events.rpy:1266
translate russian samantha_preg_talk_c2488b04:
    "Указываю на коробку."

# ch/samantha/events.rpy:1267
translate russian samantha_preg_talk_270dc739:
    samantha.say "А. Кое-что приготовила на работе."

# ch/samantha/events.rpy:1268
translate russian samantha_preg_talk_3624762d:
    samantha.say "Это тебе!"

# ch/samantha/events.rpy:1270
translate russian samantha_preg_talk_c2329294:
    "Сэм суёт мне коробку и быстро проходит мимо."

# ch/samantha/events.rpy:1272
translate russian samantha_preg_talk_7910a84b:
    "Едва я закрываю дверь, Сэм суёт мне коробку. Я неловко её подхватываю."

# ch/samantha/events.rpy:1273
translate russian samantha_preg_talk_9b9ef87c:
    samantha.say "Пойду попью воды!"

# ch/samantha/events.rpy:1275
translate russian samantha_preg_talk_2b40baec:
    "Восклицает она и направляется на кухню. Всё это... подозрительно."

# ch/samantha/events.rpy:1276
translate russian samantha_preg_talk_2d1765b4:
    "Иду следом, но замедляюсь, открывая крышку. Затем совсем останавливаюсь."

# ch/samantha/events.rpy:1277
translate russian samantha_preg_talk_772e73d7:
    "Внутри большой кекс, наполовину покрытый розовой глазурью, наполовину — голубой. Посередине белый вопросительный знак."

# ch/samantha/events.rpy:1278
translate russian samantha_preg_talk_371b8676:
    mike.say "..."

# ch/samantha/events.rpy:1280
translate russian samantha_preg_talk_2c6406d7_1:
    mike.say "Кексик?"

# ch/samantha/events.rpy:1282
translate russian samantha_preg_talk_13a94265_1:
    mike.say "Сэм?"

# ch/samantha/events.rpy:1286
translate russian samantha_preg_talk_96fc416d:
    "Ускоряю шаг и дохожу до кухни. Сэм ждёт у столешницы, слегка покраснев. Перед ней лежит длинная белая палочка."

# ch/samantha/events.rpy:1287
translate russian samantha_preg_talk_158c1db2:
    mike.say "Ты...?"

# ch/samantha/events.rpy:1288
translate russian samantha_preg_talk_4d2a44f1:
    "Не могу выговорить ни слова. Понимаю происходящее, но осознать пока не получается."

# ch/samantha/events.rpy:1289
translate russian samantha_preg_talk_6de6638e:
    samantha.say "[lssb_samantha.hero_name()]... я беременна!"

# ch/samantha/events.rpy:1290
translate russian samantha_preg_talk_c1bbaf1b:
    "Она стучит безупречным ноготком по тесту на беременность. На меня смотрят две маленькие розовые полоски."

# ch/samantha/events.rpy:1291
translate russian samantha_preg_talk_db708d30:
    mike.say "Это..."

# ch/samantha/events.rpy:1292
translate russian samantha_preg_talk_930b20e1:
    "Не знаю, что сказать."

# ch/samantha/events.rpy:1298
translate russian samantha_preg_talk_f802e2a1:
    "Бросаюсь к ней и заключаю в объятия. Сначала она удивляется, потом прижимается ко мне."

# ch/samantha/events.rpy:1300
translate russian samantha_preg_talk_b3cb8b8e:
    samantha.say "...Значит, ты не против?"

# ch/samantha/events.rpy:1301
translate russian samantha_preg_talk_96710d26:
    mike.say "Ещё как не против!"

# ch/samantha/events.rpy:1303
translate russian samantha_preg_talk_3ad75439:
    "Сэм отстраняется, и тепло исчезает. Но я вижу её счастливые слёзы, и теперь тепло разливается у меня в груди."

# ch/samantha/events.rpy:1304
translate russian samantha_preg_talk_f248e84d:
    samantha.say "Ты будешь замечательным отцом, [lssb_samantha.hero_name()]!"

# ch/samantha/events.rpy:1305
translate russian samantha_preg_talk_274a3448:
    samantha.say "Спасибо..."

# ch/samantha/events.rpy:1306
translate russian samantha_preg_talk_7a4e3426:
    "Она возвращается в мои объятия. Будущая детская писательница, пекарь и прекрасная девушка? И мама из неё тоже получится замечательная."

# ch/samantha/events.rpy:1308
translate russian samantha_preg_talk_b13d323c:
    "Едва первый шок проходит, в груди поднимается паника. Руки дрожат, и я отступаю."

# ch/samantha/events.rpy:1310
translate russian samantha_preg_talk_7c67ef84:
    "Лицо Саманты заметно мрачнеет."

# ch/samantha/events.rpy:1311
translate russian samantha_preg_talk_a660841a:
    samantha.say "[lssb_samantha.hero_name()]?"

# ch/samantha/events.rpy:1312
translate russian samantha_preg_talk_31696f10:
    mike.say "Я... прости. Ты это имела в виду тогда утром?"

# ch/samantha/events.rpy:1313
translate russian samantha_preg_talk_6dd678df:
    samantha.say "...Да, я просто... наверное, стоило сказать тогда."

# ch/samantha/events.rpy:1314
translate russian samantha_preg_talk_174a133c:
    "Ставлю кекс на столешницу рядом с положительным тестом."

# ch/samantha/events.rpy:1315
translate russian samantha_preg_talk_134fda08:
    samantha.say "Ч-что не так?"

# ch/samantha/events.rpy:1316
translate russian samantha_preg_talk_e80952a2:
    mike.say "Я просто..."

# ch/samantha/events.rpy:1317
translate russian samantha_preg_talk_2cdb5af8:
    "Не знаю, как подобрать слова."

# ch/samantha/events.rpy:1318
translate russian samantha_preg_talk_e9cb5cfe:
    mike.say "Не думаю, что мы к этому готовы."

# ch/samantha/events.rpy:1319
translate russian samantha_preg_talk_9a42fdd3:
    "Саманта выглядит печальной, но в глазах мелькает понимание. Губы дрожат, пока она ищет ответ."

# ch/samantha/events.rpy:1320
translate russian samantha_preg_talk_b63ab251:
    samantha.say "Может быть... но мы можем подготовиться. Я готова попробовать."

# ch/samantha/events.rpy:1321
translate russian samantha_preg_talk_ed06f619:
    mike.say "А если не получится?"

# ch/samantha/events.rpy:1324
translate russian samantha_preg_talk_3512393e:
    "Саманта подходит и крепко берёт меня за руку. Пальцы у неё тёплые."

# ch/samantha/events.rpy:1325
translate russian samantha_preg_talk_ef68a0ec:
    samantha.say "Я не дам нам провалиться. Если мы оба готовы стараться, мы справимся с чем угодно."

# ch/samantha/events.rpy:1326
translate russian samantha_preg_talk_ed893772:
    "Опускаю взгляд, но она не даёт мне уставиться в пол."

# ch/samantha/events.rpy:1327
translate russian samantha_preg_talk_067a0851:
    samantha.say "Пожалуйста. Попробуй ради меня. Обещаю, всё будет хорошо."

# ch/samantha/events.rpy:1328
translate russian samantha_preg_talk_9413088a:
    "Снова смотрю на неровный кекс. Глазурь свисает комками, вопросительный знак дрожащий. Должно быть, она очень переживала, прежде чем прийти с этой новостью."

# ch/samantha/events.rpy:1329
translate russian samantha_preg_talk_477e6ee5:
    mike.say "Хорошо. Давай. Мы справимся."

# ch/samantha/events.rpy:1331
translate russian samantha_preg_talk_daa6edc7:
    "Лицо Сэм светится радостью. Она бросается ко мне и обхватывает за шею. Я ловлю её и крепко обнимаю."

# ch/samantha/events.rpy:1333
translate russian samantha_preg_talk_512cf53c:
    mike.say "Ты уверена, что он не от Райана?"

# ch/samantha/events.rpy:1335
translate russian samantha_preg_talk_65fca506:
    samantha.say "[lssb_samantha.hero_name()]!"

# ch/samantha/events.rpy:1336
translate russian samantha_preg_talk_6e65dd0f:
    samantha.say "Ты грёбаный мудак!"

# ch/samantha/events.rpy:1337
translate russian samantha_preg_talk_9a190b49:
    mike.say "Думаю, тебе лучше уйти..."

# ch/samantha/events.rpy:1338
translate russian samantha_preg_talk_30023da6:
    mike.say "Я почти уверен, что ребёнок не мой."

# ch/samantha/events.rpy:1340
translate russian samantha_preg_talk_dfe11f7f:
    samantha.say "Никогда не думала, что ты так поступишь..."

# ch/samantha/events.rpy:1342
translate russian samantha_preg_talk_f321126e:
    samantha.say "Больше никогда не хочу тебя видеть!"

# ch/samantha/events.rpy:1357
translate russian samantha_wedding_baby_6034008d:
    "Знаю, что пришёл в торговый центр за чем-то нужным."

# ch/samantha/events.rpy:1358
translate russian samantha_wedding_baby_2f6f1f3a:
    "И почти уверен, что направлялся именно в тот магазин, где это продаётся."

# ch/samantha/events.rpy:1359
translate russian samantha_wedding_baby_92c9ec6b:
    "Но знакомый голос мгновенно выбивает из головы все мысли."

# ch/samantha/events.rpy:1360
translate russian samantha_wedding_baby_12cbacbd:
    ryan.say "Эй, приятель!"

# ch/samantha/events.rpy:1361
translate russian samantha_wedding_baby_d506d3d1:
    ryan.say "Мы здесь!"

# ch/samantha/events.rpy:1362
translate russian samantha_wedding_baby_442e721c:
    "Услышав Райана, поворачиваюсь и ищу его глазами."

# ch/samantha/events.rpy:1363
translate russian samantha_wedding_baby_927ef831:
    "При этом часть меня надеется и молится, что он один."

# ch/samantha/events.rpy:1364
translate russian samantha_wedding_baby_e1ec156e:
    "Что, как и я, просто заскочил в торговый центр за покупкой."

# ch/samantha/events.rpy:1368
translate russian samantha_wedding_baby_f07c91b5:
    samantha.say "Привет, [lssb_samantha.hero_name()]."

# ch/samantha/events.rpy:1369
translate russian samantha_wedding_baby_e546f450:
    samantha.say "Вот уж не ожидала тебя здесь увидеть..."

# ch/samantha/events.rpy:1371
translate russian samantha_wedding_baby_9f206366:
    "Чёрт!"

# ch/samantha/events.rpy:1372
translate russian samantha_wedding_baby_c4b2411c:
    "Почему она обязательно с ним?"

# ch/samantha/events.rpy:1373
translate russian samantha_wedding_baby_e273faed:
    "Почему постоянно кажется, что Райан тычет мне в лицо своим счастьем?"

# ch/samantha/events.rpy:1374
translate russian samantha_wedding_baby_b450164f:
    "Ему мало того, что девушка досталась ему, а измены сходят с рук?"

# ch/samantha/events.rpy:1376
translate russian samantha_wedding_baby_5a89422b:
    "Хотя... Сэм тоже изменяет ему со мной."

# ch/samantha/events.rpy:1377
translate russian samantha_wedding_baby_93a0bb1c:
    "Наверное, это немного уравновешивает положение."

# ch/samantha/events.rpy:1378
translate russian samantha_wedding_baby_250b72fd:
    "Изо всех сил стараюсь выдавить искреннюю улыбку."

# ch/samantha/events.rpy:1379
translate russian samantha_wedding_baby_427165f1:
    "Надеюсь, достаточно убедительную."

# ch/samantha/events.rpy:1380
translate russian samantha_wedding_baby_38c88504:
    mike.say "Привет, Райан!"

# ch/samantha/events.rpy:1382
translate russian samantha_wedding_baby_a6b3a406:
    mike.say "Привет, Кексик!"

# ch/samantha/events.rpy:1384
translate russian samantha_wedding_baby_5aff5688:
    mike.say "Привет, Сэм!"

# ch/samantha/events.rpy:1385
translate russian samantha_wedding_baby_769c776e:
    mike.say "Ну как вы тут поживаете?"

# ch/samantha/events.rpy:1387
translate russian samantha_wedding_baby_92882722:
    "Райан хмурится и качает головой."

# ch/samantha/events.rpy:1388
translate russian samantha_wedding_baby_c8b6d86c:
    "Затем смотрит вниз, на то, что стоит перед ними."

# ch/samantha/events.rpy:1389
translate russian samantha_wedding_baby_ee5edd71:
    ryan.say "А с новым членом семьи не поздороваешься?"

# ch/samantha/events.rpy:1390
translate russian samantha_wedding_baby_30e02128:
    ryan.say "Уверен, маленькой Аннике не терпится познакомиться с тобой, дядя [lssb_samantha.hero_name()]!"

# ch/samantha/events.rpy:1391
translate russian samantha_wedding_baby_dc5eb4d4:
    "Опускаю взгляд и вижу перед Сэм и Райаном детскую коляску."

# ch/samantha/events.rpy:1392
translate russian samantha_wedding_baby_3e412e24:
    "Как я, чёрт возьми, мог её не заметить?!"

# ch/samantha/events.rpy:1393
translate russian samantha_wedding_baby_dfd517cd:
    "И в ней действительно лежит агукающий младенец!"

# ch/samantha/events.rpy:1394
translate russian samantha_wedding_baby_f98a0f95:
    mike.say "Это..."

# ch/samantha/events.rpy:1395
translate russian samantha_wedding_baby_c4379411:
    mike.say "Это ребёнок!"

# ch/samantha/events.rpy:1396
translate russian samantha_wedding_baby_fb036cf4:
    ryan.say "Ого!"

# ch/samantha/events.rpy:1397
translate russian samantha_wedding_baby_49fac222:
    ryan.say "Ничего от тебя не скроешь, [lssb_samantha.hero_name()]!"

# ch/samantha/events.rpy:1399
translate russian samantha_wedding_baby_25a3de53:
    samantha.say "Ты будто удивлён."

# ch/samantha/events.rpy:1400
translate russian samantha_wedding_baby_49dd4544:
    samantha.say "Мы разве не говорили, что ждём ребёнка?"

# ch/samantha/events.rpy:1402
translate russian samantha_wedding_baby_404754be:
    "Сэм подкрепляет вопрос многозначительным взглядом."

# ch/samantha/events.rpy:1403
translate russian samantha_wedding_baby_46c26e8a:
    "Конечно, она говорила, что беременна."

# ch/samantha/events.rpy:1404
translate russian samantha_wedding_baby_45d2d86f:
    "Как я мог не заметить, если за последние недели столько раз видел её голой?"

# ch/samantha/events.rpy:1405
translate russian samantha_wedding_baby_622cf9fd:
    "Просто потрясён тем, что впервые вижу самого ребёнка!"

# ch/samantha/events.rpy:1408
translate russian samantha_wedding_baby_efe8007b:
    mike.say "Конечно говорили, Кексик!"

# ch/samantha/events.rpy:1410
translate russian samantha_wedding_baby_adbf2938:
    mike.say "Конечно говорили, Сэм!"

# ch/samantha/events.rpy:1411
translate russian samantha_wedding_baby_409d6960:
    mike.say "У... у меня сейчас просто голова забита другим."

# ch/samantha/events.rpy:1412
translate russian samantha_wedding_baby_bd2b2256:
    mike.say "Поздравляю... вас обоих!"

# ch/samantha/events.rpy:1414
translate russian samantha_wedding_baby_3d20b6ea:
    "Райан привычно сияет, будто все поздравления относятся только к нему."

# ch/samantha/events.rpy:1415
translate russian samantha_wedding_baby_277a6c3e:
    "А вот Сэм выглядит подавленной, улыбка у неё немного натянутая."

# ch/samantha/events.rpy:1416
translate russian samantha_wedding_baby_dbe36b85:
    "Понятно, что после родов она должна быть измотана."

# ch/samantha/events.rpy:1417
translate russian samantha_wedding_baby_508df9d0:
    "Но тут явно что-то ещё."

# ch/samantha/events.rpy:1418
translate russian samantha_wedding_baby_e4c6639c:
    "Большинство молодых матерей буквально светятся радостью."

# ch/samantha/events.rpy:1419
translate russian samantha_wedding_baby_84c30587:
    "А Сэм выглядит так, будто месяц не спала, да ещё и совсем приуныла."

# ch/samantha/events.rpy:1421
translate russian samantha_wedding_baby_6a28f810:
    mike.say "Ты в порядке, Кексик?"

# ch/samantha/events.rpy:1423
translate russian samantha_wedding_baby_2c065df8:
    mike.say "Ты в порядке, Сэм?"

# ch/samantha/events.rpy:1424
translate russian samantha_wedding_baby_b4ec245f:
    mike.say "Выглядишь вымотанной!"

# ch/samantha/events.rpy:1426
translate russian samantha_wedding_baby_828f50b7:
    samantha.say "Ну, сам понимаешь..."

# ch/samantha/events.rpy:1429
translate russian samantha_wedding_baby_05717a26:
    samantha.say "Кормления посреди ночи..."

# ch/samantha/events.rpy:1430
translate russian samantha_wedding_baby_8292d339:
    samantha.say "Внезапные приступы плача на несколько часов..."

# ch/samantha/events.rpy:1432
translate russian samantha_wedding_baby_244c358f:
    ryan.say "И это только Сэм!"

# ch/samantha/events.rpy:1435
translate russian samantha_wedding_baby_19f2af33:
    "Пока Райан хохочет над своей шуткой, я продолжаю расспрашивать Сэм."

# ch/samantha/events.rpy:1437
translate russian samantha_wedding_baby_3ea65180:
    mike.say "Серьёзно, Кексик..."

# ch/samantha/events.rpy:1439
translate russian samantha_wedding_baby_981b6fd6:
    mike.say "Серьёзно, Сэм..."

# ch/samantha/events.rpy:1440
translate russian samantha_wedding_baby_c633af0c:
    mike.say "Ты в порядке?"

# ch/samantha/events.rpy:1442
translate russian samantha_wedding_baby_027f1cd1:
    samantha.say "Я... всё будет хорошо, [lssb_samantha.hero_name()]."

# ch/samantha/events.rpy:1443
translate russian samantha_wedding_baby_4b9e835f:
    samantha.say "Просто привыкаю быть мамой... вот и всё!"

# ch/samantha/events.rpy:1446
translate russian samantha_wedding_baby_f2f22b7c:
    "Сэм наклоняется ближе, чтобы Райан не услышал."

# ch/samantha/events.rpy:1447
translate russian samantha_wedding_baby_8fe4bbff:
    samantha.say "Поговорим при первой возможности, хорошо?"

# ch/samantha/events.rpy:1451
translate russian samantha_wedding_baby_79ffc984:
    "О том, как это скажется на нас, и о папе Анники!"

# ch/samantha/events.rpy:1453
translate russian samantha_wedding_baby_b8d2d36f:
    "Сэм снова выдавливает слабую улыбку."

# ch/samantha/events.rpy:1454
translate russian samantha_wedding_baby_ed22a441:
    "Но тут малышка начинает плакать."

# ch/samantha/events.rpy:1455
translate russian samantha_wedding_baby_e875619f:
    "Этот звук мгновенно приковывает всё внимание Сэм."

# ch/samantha/events.rpy:1456
translate russian samantha_wedding_baby_2c0e3e72:
    "Внезапно у неё остаётся время только на ребёнка."

# ch/samantha/events.rpy:1458
translate russian samantha_wedding_baby_7a0e8140:
    ryan.say "Упс!"

# ch/samantha/events.rpy:1459
translate russian samantha_wedding_baby_6724600f:
    ryan.say "Кажется, долг зовёт!"

# ch/samantha/events.rpy:1461
translate russian samantha_wedding_baby_265d609e:
    ryan.say "Увидимся, [lssb_samantha.hero_name()]!"

# ch/samantha/events.rpy:1462
translate russian samantha_wedding_baby_7165d72e:
    "Киваю и улыбаюсь почти так же слабо, как Сэм."

# ch/samantha/events.rpy:1466
translate russian samantha_wedding_baby_552f7a82:
    "Смотрю, как они с Райаном спешат заниматься тем, чем занимаются молодые родители."

# ch/samantha/events.rpy:1467
translate russian samantha_wedding_baby_a5030825:
    "Ну, хотя бы мне пока не нужно вникать во все эти подробности!"

# ch/samantha/events.rpy:1469
translate russian samantha_wedding_baby_190296bd:
    "Но что Сэм имела в виду?"

# ch/samantha/events.rpy:1470
translate russian samantha_wedding_baby_9015476a:
    "Она ведь знает, кто отец?"

# ch/samantha/events.rpy:1471
translate russian samantha_wedding_baby_04e3696c:
    "И это Райан... правда?!"

# ch/samantha/events.rpy:1472
translate russian samantha_wedding_baby_6eab1dcf:
    "Теперь бы вспомнить, зачем я вообще сюда пришёл..."

# ch/samantha/events.rpy:1477
translate russian samantha_booty_call_784b0c97:
    "Обычно, беря телефон, я выгляжу скучающим и безучастным."

# ch/samantha/events.rpy:1478
translate russian samantha_booty_call_6f61124c:
    "Просто заставляю себя проверить, какой надоедливый человек на этот раз на линии."

# ch/samantha/events.rpy:1479
translate russian samantha_booty_call_f092176a:
    "Неизменно звонит кто-то, кого я терпеть не могу, или мудак, желающий мной воспользоваться под видом просьбы об услуге."

# ch/samantha/events.rpy:1480
translate russian samantha_booty_call_bd9993d5:
    "Но сейчас, увидев имя звонящего, хватаю телефон так, будто мне сообщают об огромном выигрыше в лотерею."

# ch/samantha/events.rpy:1488
translate russian samantha_booty_call_ca6cebb2:
    mike.say "Привет, Кексик! Рад тебя слышать!"

# ch/samantha/events.rpy:1490
translate russian samantha_booty_call_2bee10c6:
    mike.say "Привет, Сэм! Рад тебя слышать!"

# ch/samantha/events.rpy:1491
translate russian samantha_booty_call_3e313187:
    "Кстати, если сейчас я кажусь вам поверхностным, имеете полное право так думать."

# ch/samantha/events.rpy:1492
translate russian samantha_booty_call_bf2866fc:
    "Но сейчас Сэм — самое близкое к выигрышу в лотерею, что есть в моей жизни!"

# ch/samantha/events.rpy:1493
translate russian samantha_booty_call_3e20ebb1:
    samantha.say "Привет, [lssb_samantha.hero_name()]... что сейчас делаешь?"

# ch/samantha/events.rpy:1494
translate russian samantha_booty_call_7e7890c3:
    "Судя по паузе и тону, вопрос явно с подтекстом."

# ch/samantha/events.rpy:1495
translate russian samantha_booty_call_20f92ac3:
    "Заинтригованный тем, к чему она клонит, решаю подыграть."

# ch/samantha/events.rpy:1496
translate russian samantha_booty_call_12c10275:
    mike.say "Да как обычно — совершенно ничего."

# ch/samantha/events.rpy:1497
translate russian samantha_booty_call_61ad8277:
    mike.say "А что?"

# ch/samantha/events.rpy:1498
translate russian samantha_booty_call_cef6b777:
    "Сэм посмеивается на другом конце линии. Для меня это как пение птиц летним днём."

# ch/samantha/events.rpy:1499
translate russian samantha_booty_call_b176f426:
    samantha.say "Я тут подумала: можно к тебе зайти?"

# ch/samantha/events.rpy:1500
translate russian samantha_booty_call_86710a84:
    samantha.say "Тогда сможешь ничего не делать в компании."

# ch/samantha/events.rpy:1501
translate russian samantha_booty_call_a8b12403:
    samantha.say "Или вместо этого мы займёмся чем-нибудь другим..."

# ch/samantha/events.rpy:1502
translate russian samantha_booty_call_249ca88e:
    "Будто мне нужно ещё какое-то поощрение!"

# ch/samantha/events.rpy:1503
translate russian samantha_booty_call_cfb250a4:
    mike.say "Х... хорошо, я никуда не уйду!"

# ch/samantha/events.rpy:1504
translate russian samantha_booty_call_c76798c8:
    samantha.say "Отлично. Скоро увидимся..."

# ch/samantha/events.rpy:1505
translate russian samantha_booty_call_e0b9128f:
    "Закончив разговор, прежде чем броситься наводить порядок, останавливаюсь и изо всех сил щиплю себя."

# ch/samantha/events.rpy:1506
translate russian samantha_booty_call_1c3178d7:
    "Нет, всё-таки не сплю и не вижу сон."

# ch/samantha/events.rpy:1507
translate russian samantha_booty_call_5d9778a1:
    "Мне только что, похоже, совершенно недвусмысленно позвонили ради секса."

# ch/samantha/events.rpy:1508
translate russian samantha_booty_call_5124a10e:
    "И, что ещё невероятнее, это была Сэм!"

# ch/samantha/events.rpy:1510
translate russian samantha_booty_call_727c298e:
    "Вскоре звонок в дверь вырывает меня из мыслей. Она пришла."

# ch/samantha/events.rpy:1511
translate russian samantha_booty_call_e3f31f08:
    "Перед тем как открыть, заставляю себя остановиться и быстро проверить всё по списку."

# ch/samantha/events.rpy:1512
translate russian samantha_booty_call_3e73e64a:
    "Как бы я ни жаждал встречи, Сэм ни к чему знать, что я взмок и извёлся."

# ch/samantha/events.rpy:1513
translate russian samantha_booty_call_4b87d512:
    "Даже если сейчас чувствую себя именно так..."

# ch/samantha/events.rpy:1514
translate russian samantha_booty_call_caf7ede6:
    "Ладно, ничем неприятным не испачкан."

# ch/samantha/events.rpy:1515
translate russian samantha_booty_call_94df7ed3:
    "И не пахну. По крайней мере, плохо."

# ch/samantha/events.rpy:1516
translate russian samantha_booty_call_defc02b4:
    "Наконец, быстрый взгляд вниз подтверждает: одежду надеть я не забыл."

# ch/samantha/events.rpy:1517
translate russian samantha_booty_call_781b35c0:
    "Всё на месте и более-менее в порядке."

# ch/samantha/events.rpy:1518
translate russian samantha_booty_call_1a06a643:
    "Ничто не мешает мне стать для Сэм приятным и обаятельным собеседником."

# ch/samantha/events.rpy:1519
translate russian samantha_booty_call_d0af4b58:
    "Почувствовав прилив уверенности, тянусь к дверной ручке..."

# ch/samantha/events.rpy:1523
translate russian samantha_booty_call_d7a7138b:
    "В открытом дверном проёме стоит Сэм, с головы до ног в ослепительно белом."

# ch/samantha/events.rpy:1524
translate russian samantha_booty_call_a8d2f2cd:
    "Всё бы ничего, если бы это не оказалось тем самым платьем, в котором она выходила замуж."

# ch/samantha/events.rpy:1525
translate russian samantha_booty_call_0b6d6a71:
    "При виде точного повторения её свадебного образа на меня разом накатывают все пережитые тогда чувства."

# ch/samantha/events.rpy:1526
translate russian samantha_booty_call_7b8d85da:
    "На Сэм даже та же фата, а в крепко сжатых руках — букет."

# ch/samantha/events.rpy:1527
translate russian samantha_booty_call_d87f33e4:
    "Видя мой открытый от изумления и восхищения рот, Сэм медленно улыбается."

# ch/samantha/events.rpy:1529
translate russian samantha_booty_call_baf9ab1e:
    samantha.say "Полагаю, помнишь, когда в последний раз видел меня в этом наряде?"

# ch/samantha/events.rpy:1531
translate russian samantha_booty_call_7e283fac:
    "Могу только кивнуть: потрясение ещё не даёт говорить."

# ch/samantha/events.rpy:1533
translate russian samantha_booty_call_5acc927d:
    samantha.say "Говорят, невеста должна быть самой красивой женщиной на своей свадьбе."

# ch/samantha/events.rpy:1534
translate russian samantha_booty_call_7c815892:
    samantha.say "Все взгляды должны быть прикованы к ней, и желать должны только её."

# ch/samantha/events.rpy:1536
translate russian samantha_booty_call_932da406:
    "Пока Сэм говорит об этих свадебных традициях, её лицо мрачнеет, словно от тени воспоминаний."

# ch/samantha/events.rpy:1538
translate russian samantha_booty_call_f5c7c586:
    samantha.say "Но со мной было иначе, правда, [lssb_samantha.hero_name()]?"

# ch/samantha/events.rpy:1540
translate russian samantha_booty_call_35ffe6c1:
    "Качаю головой, не желая вдаваться в отвратительные подробности поступков Райана до церемонии и сразу после."

# ch/samantha/events.rpy:1542
translate russian samantha_booty_call_c4feabef:
    samantha.say "Да, иначе."

# ch/samantha/events.rpy:1543
translate russian samantha_booty_call_14b7a330:
    samantha.say "Единственный мужчина, который должен был смотреть только на меня, изменял мне с какой-то шлюшкой."

# ch/samantha/events.rpy:1545
translate russian samantha_booty_call_b35e02a6:
    samantha.say "Знаешь, каково это, [lssb_samantha.hero_name()]?"

# ch/samantha/events.rpy:1546
translate russian samantha_booty_call_8d0ef87c:
    samantha.say "Можешь представить, каково гадать, не думал ли он о ней, пока мы стояли у алтаря?!"

# ch/samantha/events.rpy:1548
translate russian samantha_booty_call_b0d98026:
    "Наконец удаётся выдавить несколько слов."

# ch/samantha/events.rpy:1550
translate russian samantha_booty_call_231a3b75:
    mike.say "Нет, Кексик... не могу."

# ch/samantha/events.rpy:1552
translate russian samantha_booty_call_4a1b9b21:
    mike.say "Нет, Сэм... не могу."

# ch/samantha/events.rpy:1554
translate russian samantha_booty_call_f72cc23c:
    "Словно обрадовавшись моему голосу, Сэм вновь смягчается."

# ch/samantha/events.rpy:1555
translate russian samantha_booty_call_c913939a:
    samantha.say "Но меня утешает, что там был человек, который думал обо мне именно так."

# ch/samantha/events.rpy:1556
translate russian samantha_booty_call_6fc32b30:
    samantha.say "Честно, [lssb_samantha.hero_name()]... когда увидел меня в этом платье, ты ведь очень хотел меня трахнуть?"

# ch/samantha/events.rpy:1558
translate russian samantha_booty_call_c824b819:
    "Прямота вопроса заставляет сглотнуть и перевести дыхание: Сэм застала меня врасплох."

# ch/samantha/events.rpy:1559
translate russian samantha_booty_call_dfaba5a9:
    "Что тут ответишь?"

# ch/samantha/events.rpy:1560
translate russian samantha_booty_call_9e8230e4:
    "Соврать я точно не могу!"

# ch/samantha/events.rpy:1562
translate russian samantha_booty_call_fa535aa1:
    mike.say "Д... да, Кексик."

# ch/samantha/events.rpy:1564
translate russian samantha_booty_call_56f02f01:
    mike.say "Д... да, Сэм."

# ch/samantha/events.rpy:1565
translate russian samantha_booty_call_aefb3c8a:
    mike.say "Ты была такой красивой. Как и сейчас."

# ch/samantha/events.rpy:1566
translate russian samantha_booty_call_431aeb8d:
    mike.say "Я бы солгал, сказав, что не хотел тебя..."

# ch/samantha/events.rpy:1567
translate russian samantha_booty_call_256c45bf:
    "Сэм на секунду прищуривается."

# ch/samantha/events.rpy:1569
translate russian samantha_booty_call_60e8fee1:
    samantha.say "А под «хотел» ты понимаешь «хотел трахнуть», верно?"

# ch/samantha/events.rpy:1571
translate russian samantha_booty_call_bd455e68:
    "Не понимаю, почему ей так важна точность формулировки, но всё равно подыгрываю."

# ch/samantha/events.rpy:1573
translate russian samantha_booty_call_4919c57b:
    mike.say "Да, Кексик. Это я и имел в виду."

# ch/samantha/events.rpy:1575
translate russian samantha_booty_call_1d5447d1:
    mike.say "Да, Сэм. Это я и имел в виду."

# ch/samantha/events.rpy:1576
translate russian samantha_booty_call_c733c1f6:
    samantha.say "Хорошо, потому что именно такую возможность я тебе и даю, [lssb_samantha.hero_name()]."

# ch/samantha/events.rpy:1578
translate russian samantha_booty_call_2f9647fb:
    samantha.say "Мы повернём время вспять, и ты трахнешь меня так, как хотел в день моей свадьбы."

# ch/samantha/events.rpy:1579
translate russian samantha_booty_call_729727be:
    "Звучит всё довольно странно и напряжённо, будто меня втягивают в порно ради мести."

# ch/samantha/events.rpy:1580
translate russian samantha_booty_call_19795c2d:
    "Но всё-таки это Сэм сама преподносит себя мне на блюдечке."

# ch/samantha/events.rpy:1581
translate russian samantha_booty_call_9aacda27:
    "Её просьба о сексе в особенно извращённой форме вряд ли заставит меня отказаться."

# ch/samantha/events.rpy:1582
translate russian samantha_booty_call_236e0fbc:
    "Искренне и радостно киваю, отступаю, пропуская её в дом. Но перед гостиной Сэм останавливается."

# ch/samantha/events.rpy:1584
translate russian samantha_booty_call_16ee913c:
    samantha.say "Только одно условие."

# ch/samantha/events.rpy:1586
translate russian samantha_booty_call_88b807ac:
    "Ага, вот и оно..."

# ch/samantha/events.rpy:1588
translate russian samantha_booty_call_37c4d558:
    samantha.say "Хочу почувствовать себя грязной маленькой шлюхой, а не чистой и непорочной невестой!"

# ch/samantha/events.rpy:1590
translate russian samantha_booty_call_a0e1aa48:
    mike.say "О... хорошо, Сэм... как скажешь."

# ch/samantha/events.rpy:1592
translate russian samantha_booty_call_7f2a8172:
    samantha.say "Хочу показать этому неверному мудаку, что я тоже женщина и могу быть ничуть не менее развратной шлюхой."

# ch/samantha/events.rpy:1594
translate russian samantha_booty_call_6122dac1:
    mike.say "Если ты этого хочешь, я постараюсь..."

# ch/samantha/events.rpy:1595
translate russian samantha_booty_call_7924c143:
    "Сказав это, Сэм заходит в дом."

# ch/samantha/events.rpy:1599
translate russian samantha_booty_call_4a88ec51:
    "Я редко видел эту сторону её обычно мягкого, нежного характера, но должен признать: сейчас она меня всерьёз возбуждает."

# ch/samantha/events.rpy:1600
translate russian samantha_booty_call_52affbcb:
    "За приятной внешностью скрывается дикая и дерзкая сторона, будто она что-то компенсирует или разом выплёскивает всю накопившуюся обиду."

# ch/samantha/events.rpy:1604
translate russian samantha_booty_call_04fa6d3e:
    "Едва доведя меня до спальни и закрыв дверь, Сэм набрасывается на меня."

# ch/samantha/events.rpy:1605
translate russian samantha_booty_call_6e91a5d8:
    "Отбрасывает букет, почти срывает с головы фату и обхватывает меня ногами — приходится её держать."

# ch/samantha/events.rpy:1610
translate russian samantha_booty_call_5ec60e23:
    "В короткие паузы между поцелуями с её настойчивым языком замечаю белые чулки под задравшимися юбками."

# ch/samantha/events.rpy:1611
translate russian samantha_booty_call_463a86f8:
    "Помню, как мельком увидел их, когда она шла к алтарю."

# ch/samantha/events.rpy:1612
translate russian samantha_booty_call_9857244f:
    "Теперь эти ноги обвивают меня, и это действительно кажется ожившей фантазией."

# ch/samantha/events.rpy:1613
translate russian samantha_booty_call_cb27ac06:
    "Всё ещё держа Сэм на весу, ковыляю к кровати в надежде опустить её туда."

# ch/samantha/events.rpy:1614
translate russian samantha_booty_call_937e4057:
    "Почувствовав край коленями, позволяю себе упасть вперёд: уверен, она не отпустит, даже если вежливо попросить."

# ch/samantha/events.rpy:1615
translate russian samantha_booty_call_2adcd362:
    "Падаем без травм, но неожиданность даёт нужный эффект: Сэм ослабляет хватку."

# ch/samantha/events.rpy:1619
translate russian samantha_booty_call_288473ab:
    "Что ж, она сама попросила обращаться с ней как со шлюхой."

# ch/samantha/events.rpy:1620
translate russian samantha_booty_call_02bf1574:
    "Была не была..."

# ch/samantha/events.rpy:1621
translate russian samantha_booty_call_56708ee0:
    "Встаю и поворачиваюсь к ней. Когда она пытается последовать за мной, мягко, но уверенно толкаю обратно на кровать."

# ch/samantha/events.rpy:1622
translate russian samantha_booty_call_9efa9979:
    mike.say "Иди сюда и займи рот полезным делом."

# ch/samantha/events.rpy:1623
translate russian samantha_booty_call_370404a4:
    "Большие глаза Сэм раскрываются ещё шире, когда я указываю на неё, а затем на свой пах."

# ch/samantha/events.rpy:1625
translate russian samantha_booty_call_fd13fa88:
    mike.say "Ну чего ждёшь? Сам себя он не отсосёт."

# ch/samantha/events.rpy:1626
translate russian samantha_booty_call_4baa284d:
    "На мгновение боюсь, что перегнул: сейчас она всё прекратит и отвесит мне пощёчину."

# ch/samantha/events.rpy:1627
translate russian samantha_booty_call_46c9806b:
    "Но она начинает почти лихорадочно кивать, словно вспомнив, что сама попросила такого обращения."

# ch/samantha/events.rpy:1629
translate russian samantha_booty_call_56867e22:
    "Через секунду нетерпеливо подползает и возится с ширинкой, отчаянно стремясь исполнить приказ."

# ch/samantha/events.rpy:1630
translate russian samantha_booty_call_f084c729:
    "Неудивительно, что, вытащив мой член, Сэм обнаруживает его уже стоящим и совершенно готовым."

# ch/samantha/events.rpy:1631
translate russian samantha_booty_call_312eb5f1:
    "И всё же значительной части меня не по себе от такого обращения с ней."

# ch/samantha/events.rpy:1632
translate russian samantha_booty_call_09ccf670:
    "Стараюсь отогнать эти сомнения. Лучше сосредоточиться на том, что она собирается делать."

# ch/samantha/events.rpy:1633
translate russian samantha_booty_call_6343bcc5:
    "Сама Сэм, похоже, уже вошла в роль и не колеблется ни мгновения."

# ch/samantha/events.rpy:1634
translate russian samantha_booty_call_b3977d4c:
    "Предвкушающе облизывает губы, высовывает язык и обводит им головку."

# ch/samantha/events.rpy:1635
translate russian samantha_booty_call_3e6576d1:
    "Затем открывает рот и начинает брать столько, сколько может вместить."

# ch/samantha/events.rpy:1636
translate russian samantha_booty_call_0fba0593:
    "Ни постепенного нарастания страсти, ни притворной застенчивости и скромности."

# ch/samantha/events.rpy:1638
translate russian samantha_booty_call_22ce31de:
    "Решив вести себя как совершенно бесстыжая шлюха, Сэм сосёт мой член без малейшего стеснения."

# ch/samantha/events.rpy:1639
translate russian samantha_booty_call_80a54d62:
    "При этом стонет, и из переполненного рта начинает сочиться слюна."

# ch/samantha/events.rpy:1640
translate russian samantha_booty_call_c35473e9:
    "Взяв настолько глубоко, насколько может, Сэм начинает двигать головой вперёд-назад."

# ch/samantha/events.rpy:1641
translate russian samantha_booty_call_0df31c96:
    "Одновременно обхватывает основание кольцом из большого и указательного пальцев и работает рукой."

# ch/samantha/events.rpy:1643
translate russian samantha_booty_call_810648d4:
    "Всё это время она смотрит мне в глаза снизу вверх."

# ch/samantha/events.rpy:1644
translate russian samantha_booty_call_ae18be32:
    "Будто отчаянно хочет, чтобы я видел её унижение ради моего удовольствия и понимал, как дорого оно обходится её достоинству."

# ch/samantha/events.rpy:1646
translate russian samantha_booty_call_63ff27e0:
    "Слюна уже вытекает из уголков рта и капает с подбородка."

# ch/samantha/events.rpy:1647
translate russian samantha_booty_call_37a297d5:
    "Но она не собирается ни вытираться, ни останавливаться."

# ch/samantha/events.rpy:1648
translate russian samantha_booty_call_73dc39a0:
    "Я могу кончить в любую секунду, но чувствую: несмотря на унижение, ей всё ещё мало."

# ch/samantha/events.rpy:1652
translate russian samantha_booty_call_97dfea0a:
    "С влажным хлопком вытаскиваю член изо рта Сэм, кладу ладонь ей на плечо и снова толкаю на кровать."

# ch/samantha/events.rpy:1653
translate russian samantha_booty_call_f275ad1c:
    "На этот раз не даю ни восстановить равновесие, ни спросить, чего я хочу."

# ch/samantha/events.rpy:1654
translate russian samantha_booty_call_8063a678:
    "Пока она лежит на спине, забираюсь на кровать и грубо снимаю с неё платье."

# ch/samantha/events.rpy:1656
translate russian samantha_booty_call_2c17cc00:
    "Удивительно, но между мной и её обнажённым телом больше нет ни клочка ткани."

# ch/samantha/events.rpy:1657
translate russian samantha_booty_call_82728f89:
    mike.say "Вижу, ты пришла с определённой целью."

# ch/samantha/events.rpy:1659
translate russian samantha_booty_call_026abd23:
    mike.say "Перевернись и встань на четвереньки. СЕЙЧАС ЖЕ!"

# ch/samantha/events.rpy:1660
translate russian samantha_booty_call_3895c4ec:
    "Не знаю, настолько ли Сэм увлеклась, что так хорошо играет дешёвую шлюху."

# ch/samantha/events.rpy:1661
translate russian samantha_booty_call_d0c19f26:
    "Или я достаточно убедителен, чтобы она поверила в мои слова."

# ch/samantha/events.rpy:1662
translate russian samantha_booty_call_78960434:
    "Так или иначе, она отползает назад по кровати, тяжело дыша."

# ch/samantha/events.rpy:1663
translate russian samantha_booty_call_54f37fcd:
    "Помня приказ, Сэм с трудом встаёт на четвереньки."

# ch/samantha/events.rpy:1665
translate russian samantha_booty_call_1113b39c:
    "Всё время оглядывается через плечо с тревогой и едва скрываемым интересом к моим намерениям."

# ch/samantha/events.rpy:1666
translate russian samantha_booty_call_087aecc4:
    "Встав на колени сзади, хватаю её за талию и притягиваю, прижимаясь к ягодицам."

# ch/samantha/events.rpy:1667
translate russian samantha_booty_call_c38828dc:
    mike.say "Ого... видела бы ты сейчас свою киску."

# ch/samantha/events.rpy:1668
translate russian samantha_booty_call_ea2217f0:
    mike.say "Течёт как сломанный холодильник!"

# ch/samantha/events.rpy:1670
translate russian samantha_booty_call_2653bec1:
    "Провожу пальцем снаружи её половых губ и чувствую дрожь сдерживаемого желания."

# ch/samantha/events.rpy:1671
translate russian samantha_booty_call_378a598c:
    mike.say "Но сегодня ты не получишь желаемого, похотливая сучка."

# ch/samantha/events.rpy:1672
translate russian samantha_booty_call_a817ad2f:
    mike.say "Сегодня я использую тебя, как презерватив."

# ch/samantha/events.rpy:1673
translate russian samantha_booty_call_1a0113fd:
    mike.say "Развлекусь и выброшу, как мусор, которым ты и являешься!"

# ch/samantha/events.rpy:1674
translate russian samantha_booty_call_6408d4d3:
    "Не знаю, не зашёл ли уже слишком далеко, но понимаю, что остановиться теперь поздно."

# ch/samantha/events.rpy:1675
translate russian samantha_booty_call_a3f0bd60:
    "Без предупреждения раздвигаю ягодицы Сэм и начинаю вводить головку в открывшийся анус."

# ch/samantha/events.rpy:1677
translate russian samantha_booty_call_ffd1d05f:
    "Её крик слишком высокий и испуганный, чтобы быть притворным."

# ch/samantha/events.rpy:1679
translate russian samantha_booty_call_f871469c:
    "Боясь, что она сейчас всё остановит, левой рукой хватаю её за волосы и резко оттягиваю голову назад."

# ch/samantha/events.rpy:1680
translate russian samantha_booty_call_62687673:
    "Сэм сразу подаётся назад, пытаясь уменьшить боль."

# ch/samantha/events.rpy:1682
translate russian samantha_booty_call_2d26cdf5:
    "Пользуюсь этим движением, чтобы протолкнуть член ещё глубже."

# ch/samantha/events.rpy:1683
translate russian samantha_booty_call_36728821:
    mike.say "Ну как тебе?"

# ch/samantha/events.rpy:1684
translate russian samantha_booty_call_bed64e2d:
    mike.say "Когда в задницу запихивают член?"

# ch/samantha/events.rpy:1685
translate russian samantha_booty_call_caec58ae:
    mike.say "А твоя бедная киска тем временем плачет, потому что ей ничего не достаётся!"

# ch/samantha/events.rpy:1686
translate russian samantha_booty_call_5609fb08:
    "Сэм вскрикивает при каждом толчке, и эти звуки невероятно меня возбуждают."

# ch/samantha/events.rpy:1687
translate russian samantha_booty_call_84b668ed:
    "Мне нравится ощущение её тугой задницы, но уже не уверен, что заводит сильнее: оно или непрерывные крики..."

# ch/samantha/events.rpy:1689
translate russian samantha_booty_call_301d1bfd:
    "Теперь она больше похожа на животное, доведённое до состояния, в котором остаются лишь самые примитивные телесные реакции."

# ch/samantha/events.rpy:1690
translate russian samantha_booty_call_e9abf12e:
    "Невольно думаю, не так ли чувствует себя тот, кто объезжает изящную прекрасную лошадь."

# ch/samantha/events.rpy:1691
translate russian samantha_booty_call_770dc056:
    "Берёт что-то чистое, почти совершенное в своей кажущейся невинности, и подчиняет, пока чужая воля окончательно не сломается."

# ch/samantha/events.rpy:1692
translate russian samantha_booty_call_0d2ea37c:
    "Эта мысль пугает и возбуждает почти в равной мере."

# ch/samantha/events.rpy:1693
translate russian samantha_booty_call_b7d81f1e:
    "Пожалуй, второго немного больше: вскоре чувствую нарастающее желание кончить."

# ch/samantha/events.rpy:1694
translate russian samantha_booty_call_66783858:
    "Почти так же резко, как вошёл в задницу Сэм, вытаскиваю член. Она кричит почти так же громко."

# ch/samantha/events.rpy:1696
translate russian samantha_booty_call_4afd9208:
    mike.say "Я не буду кончать в тебя, сучка."

# ch/samantha/events.rpy:1697
translate russian samantha_booty_call_40e4c95b:
    mike.say "Ни в одну твою дырку, даже если бы от этого зависела моя жизнь."

# ch/samantha/events.rpy:1698
translate russian samantha_booty_call_8d2b1cd6:
    mike.say "Максимум, чего ты заслуживаешь, — получить в лицо."

# ch/samantha/events.rpy:1699
translate russian samantha_booty_call_6067b808:
    mike.say "Так что поднимайся и принимай. СЕЙЧАС ЖЕ!"

# ch/samantha/events.rpy:1700
translate russian samantha_booty_call_e1db30cd:
    "Сэм поспешно слушается, почти съёжившись передо мной, как побитая собака."

# ch/samantha/events.rpy:1702
translate russian samantha_booty_call_a4625825:
    "Осторожно протягивает руки и берёт мой член."

# ch/samantha/events.rpy:1704
translate russian samantha_booty_call_c60310bd:
    "Он ещё скользкий после её задницы, но возвращается в рот: она покорно доводит меня до конца."

# ch/samantha/events.rpy:1705
translate russian samantha_booty_call_8a9387a3:
    "Выполняя приказ, за секунду до оргазма Сэм вынимает член, позволяя всей сперме попасть ей на лицо."

# ch/samantha/events.rpy:1707
translate russian samantha_booty_call_3a0cee71:
    "Когда я наконец заканчиваю, она взмокла и тяжело дышит."

# ch/samantha/events.rpy:1709
translate russian samantha_booty_call_2125de73:
    "Волосы спутаны, макияж размазан спермой и расплылся по лицу."

# ch/samantha/events.rpy:1713
translate russian samantha_booty_call_5a4c8713:
    "Запыхавшись, с затуманенным взглядом она берёт телефон и фотографирует то великолепное разорение, в которое превратилась."

# ch/samantha/events.rpy:1715
translate russian samantha_booty_call_69d2f885:
    "Венчает снимок то, что в момент съёмки мой член всё ещё наполовину торчит у неё изо рта."

# ch/samantha/events.rpy:1716
translate russian samantha_booty_call_98d6281c:
    "Падаю на кровать, наблюдая за Сэм со смесью ужаса и искреннего восхищения."

# ch/samantha/events.rpy:1717
translate russian samantha_booty_call_35557e71:
    "По злорадной улыбке, возникающей, когда она начинает отправлять сообщение, нетрудно догадаться, кому предназначено селфи."

# ch/samantha/events.rpy:1718
translate russian samantha_booty_call_bb815188:
    "Хотелось бы сказать, что я хоть немного ему сочувствую."

# ch/samantha/events.rpy:1719
translate russian samantha_booty_call_ceda31ad:
    "Но суровая правда в том, что совершенно нет."

# ch/samantha/events.rpy:1728
translate russian samantha_asleep_bedroom2_3d5deeba:
    "Саманта спит. Лучше уйти, пока не разбудил..."

# ch/samantha/events.rpy:1735
translate russian samantha_asleep_bedroom3_3d5deeba:
    "Саманта спит. Лучше уйти, пока не разбудил..."

# ch/samantha/events.rpy:1742
translate russian samantha_asleep_bedroom5_3d5deeba:
    "Саманта спит. Лучше уйти, пока не разбудил..."

# ch/samantha/events.rpy:1748
translate russian sam_murder_talk_sasha_7f878f29:
    "Как нетрудно представить, после случившегося обстановка в доме очень напряжённая."

# ch/samantha/events.rpy:1749
translate russian sam_murder_talk_sasha_327ee21a:
    "И уже то, что я называю это «случившимся», даёт понять, насколько всё плохо."

# ch/samantha/events.rpy:1750
translate russian sam_murder_talk_sasha_1fb08929:
    "Как вообще осмыслить, что кто-то ворвался к тебе в дом и изнасиловал тебя?"

# ch/samantha/events.rpy:1751
translate russian sam_murder_talk_sasha_64ea1406:
    "А в довершение ещё и убил одну из твоих соседок?"

# ch/samantha/events.rpy:1752
translate russian sam_murder_talk_sasha_0055e284:
    "Первые несколько дней мне нужны только на то, чтобы научиться думать о Кайли без холодного пота."

# ch/samantha/events.rpy:1753
translate russian sam_murder_talk_sasha_8e7bfbeb:
    "Но даже когда получается, я снова и снова вижу всё произошедшее."

# ch/samantha/events.rpy:1754
translate russian sam_murder_talk_sasha_e0eff539:
    "Стоит закрыть глаза — передо мной то, что случилось с бедной Сашей."

# ch/samantha/events.rpy:1755
translate russian sam_murder_talk_sasha_e020530f:
    "Картина яркая и беспощадная, будто выжжена в памяти и никогда не сотрётся."

# ch/samantha/events.rpy:1756
translate russian sam_murder_talk_sasha_b0c58b9f:
    "Я так поглощён собственной травмой, что почти не замечаю: остальные меня избегают."

# ch/samantha/events.rpy:1757
translate russian sam_murder_talk_sasha_3a9a2e2f:
    "Сначала думаю, что всем так же тяжело и каждому нужно пространство."

# ch/samantha/events.rpy:1758
translate russian sam_murder_talk_sasha_999d1aa5:
    "Но вскоре начинаю опасаться, что дело в чём-то другом."

# ch/samantha/events.rpy:1759
translate russian sam_murder_talk_sasha_c732c044:
    "Вдруг меня избегают именно потому, что я знал Кайли?"

# ch/samantha/events.rpy:1760
translate russian sam_murder_talk_sasha_d15da794:
    "Словно связь с этой сумасшедшей сукой запятнала и меня?"

# ch/samantha/events.rpy:1761
translate russian sam_murder_talk_sasha_96cd0581:
    "В конце концов решаю спросить напрямую."

# ch/samantha/events.rpy:1762
translate russian sam_murder_talk_sasha_085ecbdf:
    "Как бы то ни было, лучше знать правду."

# ch/samantha/events.rpy:1763
translate russian sam_murder_talk_sasha_f80fff39:
    "Надеюсь, Сэм, которую знаю дольше всех, ответит прямо и честно."

# ch/samantha/events.rpy:1765
translate russian sam_murder_talk_sasha_f1d8a63c:
    mike.say "Эм..."

# ch/samantha/events.rpy:1767
translate russian sam_murder_talk_sasha_a6b3a406:
    mike.say "Привет, Кексик!"

# ch/samantha/events.rpy:1769
translate russian sam_murder_talk_sasha_5aff5688:
    mike.say "Привет, Сэм!"

# ch/samantha/events.rpy:1771
translate russian sam_murder_talk_sasha_ea7a4f86:
    "Сэм останавливается, слегка удивлённая моим появлением."

# ch/samantha/events.rpy:1772
translate russian sam_murder_talk_sasha_0e389323:
    "Но быстро берёт себя в руки, скрывая чувства за сочувственным выражением."

# ch/samantha/events.rpy:1774
translate russian sam_murder_talk_sasha_d930dbce:
    samantha.say "А, привет, [lssb_samantha.hero_name()]."

# ch/samantha/events.rpy:1775
translate russian sam_murder_talk_sasha_d35d180e:
    samantha.say "Как держишься?"

# ch/samantha/events.rpy:1776
translate russian sam_murder_talk_sasha_a23c9920:
    "Могу только пожать плечами и вздохнуть."

# ch/samantha/events.rpy:1777
translate russian sam_murder_talk_sasha_dd9193f4:
    "По правде, не очень. Кто бы чувствовал себя хорошо после такого?"

# ch/samantha/events.rpy:1778
translate russian sam_murder_talk_sasha_ad722c47:
    "Но тонуть в жалости к себе или в чужом сочувствии тоже не хочу."

# ch/samantha/events.rpy:1779
translate russian sam_murder_talk_sasha_a9518cb5:
    "Поэтому немного лгу, лишь бы разговор двинулся дальше."

# ch/samantha/events.rpy:1780
translate russian sam_murder_talk_sasha_b4623183:
    mike.say "Лучше, чем в тот день."

# ch/samantha/events.rpy:1782
translate russian sam_murder_talk_sasha_b9d66397:
    mike.say "А ты, Кексик?"

# ch/samantha/events.rpy:1784
translate russian sam_murder_talk_sasha_7da8acfc:
    mike.say "А ты, Сэм?"

# ch/samantha/events.rpy:1786
translate russian sam_murder_talk_sasha_254a9bb3:
    "Вижу, что вопрос застаёт Сэм врасплох."

# ch/samantha/events.rpy:1787
translate russian sam_murder_talk_sasha_30e7d6d1:
    "Может, она ожидала разговора только обо мне, а не о нас обоих."

# ch/samantha/events.rpy:1788
translate russian sam_murder_talk_sasha_63199117:
    samantha.say "Я... я в порядке, [lssb_samantha.hero_name()]."

# ch/samantha/events.rpy:1789
translate russian sam_murder_talk_sasha_4a04bb02:
    samantha.say "Ведь та сумасшедшая девушка меня не тронула, правда?"

# ch/samantha/events.rpy:1790
translate russian sam_murder_talk_sasha_1a79265d:
    "Хочется выразиться деликатно, но я не могу не сказать очевидного."

# ch/samantha/events.rpy:1791
translate russian sam_murder_talk_sasha_cb4bf4b1:
    mike.say "Сумасшедшая девушка, с которой я был связан?"

# ch/samantha/events.rpy:1793
translate russian sam_murder_talk_sasha_0973f9a1:
    samantha.say "Я... я не это имела в виду, [lssb_samantha.hero_name()]."

# ch/samantha/events.rpy:1795
translate russian sam_murder_talk_sasha_adda61dd:
    mike.say "Но это правда, Кексик. Кайли сюда привёл я."

# ch/samantha/events.rpy:1797
translate russian sam_murder_talk_sasha_51e5abf8:
    mike.say "Но это правда, Сэм. Кайли сюда привёл я."

# ch/samantha/events.rpy:1798
translate russian sam_murder_talk_sasha_996cf95a:
    mike.say "Если бы не я, Саша была бы жива."

# ch/samantha/events.rpy:1799
translate russian sam_murder_talk_sasha_fb3e230e:
    samantha.say "Да брось, [lssb_samantha.hero_name()], ты же не можешь так думать?!"

# ch/samantha/events.rpy:1800
translate russian sam_murder_talk_sasha_d2af7ad4:
    samantha.say "Я думала, что это... что это может быть моя вина!"

# ch/samantha/events.rpy:1802
translate russian sam_murder_talk_sasha_c01a3080:
    "Теперь роли меняются: признание Сэм ставит в тупик уже меня."

# ch/samantha/events.rpy:1803
translate russian sam_murder_talk_sasha_2dfbb806:
    "Качаю головой, пытаясь отвергнуть её слова сразу же, как слышу."

# ch/samantha/events.rpy:1805
translate russian sam_murder_talk_sasha_1efa4d06:
    mike.say "Что ты имеешь в виду, Кексик?!"

# ch/samantha/events.rpy:1807
translate russian sam_murder_talk_sasha_92735124:
    mike.say "Что ты имеешь в виду, Сэм?!"

# ch/samantha/events.rpy:1808
translate russian sam_murder_talk_sasha_6bb0c5d9:
    mike.say "Это же безумие!"

# ch/samantha/events.rpy:1809
translate russian sam_murder_talk_sasha_f73dfe9b:
    samantha.say "Правда, [lssb_samantha.hero_name()]?"

# ch/samantha/events.rpy:1810
translate russian sam_murder_talk_sasha_a86bac51:
    samantha.say "Чем это безумнее твоей попытки взять на себя вину за поступок психопатки?"

# ch/samantha/events.rpy:1811
translate russian sam_murder_talk_sasha_6af77890:
    mike.say "А, да..."

# ch/samantha/events.rpy:1813
translate russian sam_murder_talk_sasha_2b6adb19:
    mike.say "Понял, Кексик."

# ch/samantha/events.rpy:1815
translate russian sam_murder_talk_sasha_93a244c5:
    mike.say "Понял, Сэм."

# ch/samantha/events.rpy:1816
translate russian sam_murder_talk_sasha_7847f624:
    samantha.say "Да, ну..."

# ch/samantha/events.rpy:1817
translate russian sam_murder_talk_sasha_8dfa8411:
    samantha.say "Я думала, что своим возвращением принесла несчастье."

# ch/samantha/events.rpy:1818
translate russian sam_murder_talk_sasha_d9a929f4:
    samantha.say "Вернулась туда, где у нас с Райаном всё начало рушиться."

# ch/samantha/events.rpy:1819
translate russian sam_murder_talk_sasha_599833b5:
    samantha.say "Но это не так. Просто сумасшедшая девушка сделала то, что велел ей её больной разум."

# ch/samantha/events.rpy:1820
translate russian sam_murder_talk_sasha_bcaa271e:
    samantha.say "Тебе лишь не повезло оказаться тем, на ком она зациклилась, [lssb_samantha.hero_name()]."

# ch/samantha/events.rpy:1821
translate russian sam_murder_talk_sasha_fdca3b60:
    samantha.say "А Саша оказалась не в том месте и не в то время."

# ch/samantha/events.rpy:1822
translate russian sam_murder_talk_sasha_4e309053:
    samantha.say "Это ужасно и несправедливо. Но винить себя неправильно."

# ch/samantha/events.rpy:1824
translate russian sam_murder_talk_sasha_ad9b3ea5:
    mike.say "Мне всё равно больно, Кексик."

# ch/samantha/events.rpy:1826
translate russian sam_murder_talk_sasha_8b6f5a82:
    mike.say "Мне всё равно больно, Сэм."

# ch/samantha/events.rpy:1827
translate russian sam_murder_talk_sasha_159fa589:
    samantha.say "Знаю, [lssb_samantha.hero_name()]."

# ch/samantha/events.rpy:1828
translate russian sam_murder_talk_sasha_b2f341e9:
    samantha.say "Но иначе и быть не может."

# ch/samantha/events.rpy:1829
translate russian sam_murder_talk_sasha_95553dbd:
    samantha.say "Вся твоя вина и боль доказывают, что ты не безумен."

# ch/samantha/events.rpy:1831
translate russian sam_murder_talk_sasha_6460f558:
    samantha.say "Доказывают, что ты не такой, как она."

# ch/samantha/events.rpy:1832
translate russian sam_murder_talk_sasha_7b3eb1e4:
    "Говоря это, Сэм крепче сжимает мою руку и не отводит взгляда."

# ch/samantha/events.rpy:1833
translate russian sam_murder_talk_sasha_91ace70d:
    "От осознания, что она рядом, мне становится легче и я увереннее смотрю в будущее."

# ch/samantha/events.rpy:1834
translate russian sam_murder_talk_sasha_a8ccce1b:
    "Сжимаю её руку в ответ и киваю, показывая, что слова помогли."

# ch/samantha/events.rpy:1836
translate russian sam_murder_talk_sasha_4f47e345:
    samantha.say "Мне кажется, я так и не успела узнать Сашу."

# ch/samantha/events.rpy:1837
translate russian sam_murder_talk_sasha_3f27f6d9:
    samantha.say "По-настоящему, по крайней мере."

# ch/samantha/events.rpy:1839
translate russian sam_murder_talk_sasha_598f8c00:
    samantha.say "Хотела бы, чтобы ты рассказал мне о ней, [lssb_samantha.hero_name()]."

# ch/samantha/events.rpy:1840
translate russian sam_murder_talk_sasha_3a14c48d:
    "Снова киваю. Эта мысль начинает мне нравиться."

# ch/samantha/events.rpy:1841
translate russian sam_murder_talk_sasha_d8b3037e:
    "И затем невольно слегка смеюсь."

# ch/samantha/events.rpy:1842
translate russian sam_murder_talk_sasha_9c4931ad:
    "Потому что уже знаю, какие истории рассказать Сэм."

# ch/samantha/events.rpy:1843
translate russian sam_murder_talk_sasha_4b888870:
    "Уверен, они рассмешат и её."

# ch/samantha/events.rpy:1848
translate russian sam_murder_talk_bree_cd95abd5:
    "Знаю, что не стоит прятаться от того, что произошло той ночью."

# ch/samantha/events.rpy:1849
translate russian sam_murder_talk_bree_e839dbce:
    "Ничего хорошего не выйдет, если просто запихнуть всё это поглубже в себя."

# ch/samantha/events.rpy:1850
translate russian sam_murder_talk_bree_d5033777:
    "Но в том и проблема, когда такое происходит с тобой, а не с кем-то другим."

# ch/samantha/events.rpy:1851
translate russian sam_murder_talk_bree_5c68f1a0:
    "Все советы о том, как справляться, ничуть не помогают, когда дело касается тебя."

# ch/samantha/events.rpy:1852
translate russian sam_murder_talk_bree_ba0f8697:
    "Ты слишком занят попытками пережить случившееся, чтобы отстраниться и мыслить ясно."

# ch/samantha/events.rpy:1853
translate russian sam_murder_talk_bree_39f29bd4:
    "Наверное, я начал избегать остальных в доме, даже не замечая этого."

# ch/samantha/events.rpy:1854
translate russian sam_murder_talk_bree_bb07f83c:
    "Стоило услышать голоса — разворачивался и шёл в другую сторону."

# ch/samantha/events.rpy:1855
translate russian sam_murder_talk_bree_327665e5:
    "Собирался войти в комнату, слышал разговор — проходил мимо."

# ch/samantha/events.rpy:1856
translate russian sam_murder_talk_bree_6ae8e33a:
    "В конце концов именно Сэм удаётся меня перехватить."

# ch/samantha/events.rpy:1857
translate russian sam_murder_talk_bree_2e207ac3:
    "На лице у неё мягкое сочувствие."

# ch/samantha/events.rpy:1858
translate russian sam_murder_talk_bree_3f8961a8:
    "Но по её позе вижу: отступать она не собирается."

# ch/samantha/events.rpy:1860
translate russian sam_murder_talk_bree_e3d69131:
    samantha.say "Эй, [lssb_samantha.hero_name()]!"

# ch/samantha/events.rpy:1861
translate russian sam_murder_talk_bree_3e39acc2:
    samantha.say "Куда это ты собрался?"

# ch/samantha/events.rpy:1862
translate russian sam_murder_talk_bree_2efd844f:
    "Вопрос совершенно застаёт меня врасплох."

# ch/samantha/events.rpy:1863
translate russian sam_murder_talk_bree_e43dfed7:
    "Замираю и поворачиваюсь к подошедшей Сэм."

# ch/samantha/events.rpy:1864
translate russian sam_murder_talk_bree_1ccab2e1:
    mike.say "Хм..."

# ch/samantha/events.rpy:1865
translate russian sam_murder_talk_bree_d40a66e9:
    mike.say "Ч... что?"

# ch/samantha/events.rpy:1866
translate russian sam_murder_talk_bree_a11a2d8d:
    mike.say "Никуда я не собирался!"

# ch/samantha/events.rpy:1868
translate russian sam_murder_talk_bree_1bb2a25d:
    "Эту улыбку на лице Сэм я хорошо знаю."

# ch/samantha/events.rpy:1869
translate russian sam_murder_talk_bree_df56b925:
    "Уже видел, когда её что-то забавляло."

# ch/samantha/events.rpy:1870
translate russian sam_murder_talk_bree_093e75b3:
    "А именно — то, во что она ни капли не верит."

# ch/samantha/events.rpy:1871
translate russian sam_murder_talk_bree_edc00936:
    samantha.say "Хватит врать, [lssb_samantha.hero_name()]."

# ch/samantha/events.rpy:1872
translate russian sam_murder_talk_bree_7e575ed6:
    samantha.say "Ты уже несколько дней всех избегаешь!"

# ch/samantha/events.rpy:1873
translate russian sam_murder_talk_bree_96a2ed8c:
    samantha.say "Но я не отстану, пока ты хоть что-нибудь не скажешь."

# ch/samantha/events.rpy:1874
translate russian sam_murder_talk_bree_9a121651:
    "Пожимаю плечами, стараясь отмахнуться от её тревоги, будто всё нормально."

# ch/samantha/events.rpy:1876
translate russian sam_murder_talk_bree_7a136384:
    mike.say "Да я в порядке, Кексик."

# ch/samantha/events.rpy:1878
translate russian sam_murder_talk_bree_9aedd838:
    mike.say "Да я в порядке, Сэм."

# ch/samantha/events.rpy:1879
translate russian sam_murder_talk_bree_d7899bec:
    mike.say "Ты же знаешь: я крепче, чем кажусь!"

# ch/samantha/events.rpy:1880
translate russian sam_murder_talk_bree_c76ad5b5:
    samantha.say "Опять врёшь!"

# ch/samantha/events.rpy:1882
translate russian sam_murder_talk_bree_dbe46db3:
    samantha.say "Эта безумная женщина причинила тебе боль, [lssb_samantha.hero_name()]."

# ch/samantha/events.rpy:1883
translate russian sam_murder_talk_bree_92b97cd9:
    samantha.say "Она убила бедную [bree.name] у тебя на глазах!"

# ch/samantha/events.rpy:1885
translate russian sam_murder_talk_bree_0a234b53:
    mike.say "Я в порядке, Кексик. Правда!"

# ch/samantha/events.rpy:1887
translate russian sam_murder_talk_bree_4413b17a:
    mike.say "Я в порядке, Сэм. Правда!"

# ch/samantha/events.rpy:1888
translate russian sam_murder_talk_bree_431eb01c:
    "Сэм кивает, но я вижу: она совсем не убеждена."

# ch/samantha/events.rpy:1889
translate russian sam_murder_talk_bree_3c76fece:
    samantha.say "Значит, ты в таком особом «порядке», да?"

# ch/samantha/events.rpy:1890
translate russian sam_murder_talk_bree_d64ac5ef:
    samantha.say "Когда на самом деле не в порядке, но говорить не хочется?"

# ch/samantha/events.rpy:1891
translate russian sam_murder_talk_bree_dd061e28:
    "Невольно горько усмехаюсь и киваю."

# ch/samantha/events.rpy:1892
translate russian sam_murder_talk_bree_fc453e59:
    "Вижу, что это признание немного успокоило и Сэм."

# ch/samantha/events.rpy:1894
translate russian sam_murder_talk_bree_48509c96:
    samantha.say "Ничего, [lssb_samantha.hero_name()]."

# ch/samantha/events.rpy:1895
translate russian sam_murder_talk_bree_48f4e53c:
    samantha.say "Потому что я в таком же порядке!"

# ch/samantha/events.rpy:1897
translate russian sam_murder_talk_bree_35a7225a:
    "Сэм протягивает руку и берёт мою."

# ch/samantha/events.rpy:1898
translate russian sam_murder_talk_bree_7a5446a7:
    "Крепко сжимает, и это прикосновение сразу успокаивает."

# ch/samantha/events.rpy:1900
translate russian sam_murder_talk_bree_a120ffc2:
    samantha.say "Знаешь, возвращаясь сюда, я рассчитывала на меньшее количество драм!"

# ch/samantha/events.rpy:1901
translate russian sam_murder_talk_bree_837fea01:
    samantha.say "Боже... не могу поверить, что случилось с бедной [bree.name]."

# ch/samantha/events.rpy:1902
translate russian sam_murder_talk_bree_f1740791:
    samantha.say "Я ведь почти не успела её узнать!"

# ch/samantha/events.rpy:1904
translate russian sam_murder_talk_bree_08230300:
    mike.say "Она всегда была полна жизни, настоящий лучик солнца."

# ch/samantha/events.rpy:1905
translate russian sam_murder_talk_bree_79e62c23:
    mike.say "Может, лучший способ сохранить память о ней — жить полной жизнью?"

# ch/samantha/events.rpy:1906
translate russian sam_murder_talk_bree_acccab64:
    "Сэм кивает с грустной улыбкой."

# ch/samantha/events.rpy:1907
translate russian sam_murder_talk_bree_72a2befb:
    "Кладёт голову мне на плечо и обнимает."

# ch/samantha/events.rpy:1908
translate russian sam_murder_talk_bree_53c692a7:
    "Обняв её в ответ, понимаю, что моё настроение изменилось."

# ch/samantha/events.rpy:1909
translate russian sam_murder_talk_bree_5f418e1c:
    "Впервые после случившегося я не чувствую страха и подавленности."

# ch/samantha/events.rpy:1910
translate russian sam_murder_talk_bree_1f4a0ac0:
    "Могу наконец подумать, что ждёт всех нас впереди."

# ch/samantha/events.rpy:1916
translate russian samantha_waterpark_comment_0eaf049d:
    "Бывало у вас такое, что очень хочется внимательно слушать девушку и отвечать что-нибудь умное?"

# ch/samantha/events.rpy:1917
translate russian samantha_waterpark_comment_90468aa8:
    "Но рядом с ней превращаешься в беспомощный комок бушующих гормонов?"

# ch/samantha/events.rpy:1918
translate russian samantha_waterpark_comment_852d04e6:
    "И вместо уверенного парня, которому стоит дать шанс, из тебя получается безнадёжный слюнявый идиот?"

# ch/samantha/events.rpy:1919
translate russian samantha_waterpark_comment_52802b05:
    "Если ответили «нет», то пошли вы!"

# ch/samantha/events.rpy:1920
translate russian samantha_waterpark_comment_43e39fc1:
    "А если «да», значит, примерно понимаете, какую власть надо мной имеет Сэм."

# ch/samantha/events.rpy:1921
translate russian samantha_waterpark_comment_9413dbb5:
    "Ей даже не нужно говорить что-то кокетливое или двусмысленное."

# ch/samantha/events.rpy:1922
translate russian samantha_waterpark_comment_bc7cd1ec:
    "Меня может завести обычная фраза в непринуждённом разговоре."

# ch/samantha/events.rpy:1923
translate russian samantha_waterpark_comment_da369f3b:
    samantha.say "Ой, я всё хотела сказать, [lssb_samantha.hero_name()]."

# ch/samantha/events.rpy:1924
translate russian samantha_waterpark_comment_343b987e:
    samantha.say "Ты видел, что тут буквально за углом есть отличный аквапарк?"

# ch/samantha/events.rpy:1925
translate russian samantha_waterpark_comment_b8a3a600:
    samantha.say "Думаю, стоит как-нибудь сходить. Только тебе сначала надо купить плавки!"

# ch/samantha/events.rpy:1926
translate russian samantha_waterpark_comment_c4c9474a:
    "Вот, опять! Прямо сейчас!"

# ch/samantha/events.rpy:1927
translate russian samantha_waterpark_comment_8f4fc71b:
    "Она всего лишь предложила аквапарк — место для вполне невинных развлечений."

# ch/samantha/events.rpy:1928
translate russian samantha_waterpark_comment_49fd4d27:
    "Но я могу лишь представлять, как она, смеясь, забегает в воду и пытается увернуться от брызг."

# ch/samantha/events.rpy:1929
translate russian samantha_waterpark_comment_2143d163:
    "Я понятия не имею, какой у Сэм купальник, поэтому воображение само дорисовывает всё остальное."

# ch/samantha/events.rpy:1933
translate russian samantha_waterpark_comment_6e8e462f:
    "Разумеется, вряд ли мне представится скромный чёрный слитный купальник."

# ch/samantha/events.rpy:1934
translate russian samantha_waterpark_comment_a91d072a:
    "Вместо этого я воображаю на ней бикини, в котором завязок больше, чем ткани."

# ch/samantha/events.rpy:1935
translate russian samantha_waterpark_comment_d5d38446:
    "Забавно: воображение нарядило её в такую вещицу, которая совсем не оставляет места для воображения!"

# ch/samantha/events.rpy:1936
translate russian samantha_waterpark_comment_a9a2c93f:
    "Мысленным взором я вижу, как Сэм хихикает, а потом её смех почти переходит в визг, пока я безжалостно окатываю её брызгами."

# ch/samantha/events.rpy:1937
translate russian samantha_waterpark_comment_43aa8a99:
    "Она прикрывается руками, но всё равно промокает с головы до ног."

# ch/samantha/events.rpy:1938
translate russian samantha_waterpark_comment_5ab6ad71:
    "От воды скудная ткань бикини ещё плотнее облепляет её тело."

# ch/samantha/events.rpy:1939
translate russian samantha_waterpark_comment_ebdd57df:
    "А волосы обрамляют лицо вьющимися прядями."

# ch/samantha/events.rpy:1940
translate russian samantha_waterpark_comment_1c74132e:
    "Она чуть запыхалась, когда я загнал её в воду, и неосознанно улыбается, приоткрыв рот."

# ch/samantha/events.rpy:1941
translate russian samantha_waterpark_comment_9bd1af96:
    "Клянусь, подходя ближе, я даже слышу, как от моего приближения колотится её сердце..."

# ch/samantha/events.rpy:1945
translate russian samantha_waterpark_comment_ea3102f6:
    samantha.say "Ау, [lssb_samantha.hero_name()], Земля вызывает!"

# ch/samantha/events.rpy:1946
translate russian samantha_waterpark_comment_1599bfdb:
    "Сэм машет рукой у меня перед глазами, возвращая меня к реальности."

# ch/samantha/events.rpy:1947
translate russian samantha_waterpark_comment_970aeb1b:
    "Видение мокрой Сэм в одном бикини мгновенно исчезает."

# ch/samantha/events.rpy:1948
translate russian samantha_waterpark_comment_89a19268:
    "Но избавиться от того впечатления, которое она успела произвести на меня за эти короткие мгновения, куда труднее."

# ch/samantha/events.rpy:1949
translate russian samantha_waterpark_comment_023cd4a1:
    samantha.say "Ты в порядке?"

# ch/samantha/events.rpy:1950
translate russian samantha_waterpark_comment_a01716ad:
    samantha.say "Ты как будто на минуту отключился."

# ch/samantha/events.rpy:1951
translate russian samantha_waterpark_comment_06bedc8f:
    mike.say "А?.. Ой, нет... Всё нормально."

# ch/samantha/events.rpy:1952
translate russian samantha_waterpark_comment_ed326ae4:
    mike.say "И нам обязательно нужно!"

# ch/samantha/events.rpy:1954
translate russian samantha_waterpark_comment_3e502773:
    "Сэм недоумённо улыбается и склоняет голову набок."

# ch/samantha/events.rpy:1955
translate russian samantha_waterpark_comment_3f8ed439:
    samantha.say "Что именно нам нужно?"

# ch/samantha/events.rpy:1957
translate russian samantha_waterpark_comment_3a80b4da:
    mike.say "Сходить в аквапарк... Нам обязательно нужно сходить в тот аквапарк, о котором ты говорила."

# ch/samantha/events.rpy:1958
translate russian samantha_waterpark_comment_0409f701:
    "Сэм кивает, явно радуясь, что я поддержал её идею."

# ch/samantha/events.rpy:1959
translate russian samantha_waterpark_comment_672bf08a:
    samantha.say "Отлично! Но тебе всё равно нужно купить плавки!"

# ch/samantha/events.rpy:1962
translate russian samantha_waterpark_comment_a14b494b:
    "Она наклоняется ко мне и заговорщически подмигивает."

# ch/samantha/events.rpy:1963
translate russian samantha_waterpark_comment_7c177a06:
    samantha.say "Ты ведь не собирался брать обтягивающие плавки?"

# ch/samantha/events.rpy:1964
translate russian samantha_waterpark_comment_ed186efc:
    samantha.say "Нам же не нужно, чтобы все девушки на тебя пялились, а парни завидовали, правда?"

# ch/samantha/events.rpy:1965
translate russian samantha_waterpark_comment_6ddda50c:
    "Вот так просто она снова проделывает это со мной."

# ch/samantha/events.rpy:1966
translate russian samantha_waterpark_comment_ed8323b8:
    "Мысленно отмечаю: какие бы плавки я в итоге ни купил, тесными они точно не будут."

# ch/samantha/events.rpy:1967
translate russian samantha_waterpark_comment_df278c55:
    "Вряд ли я смогу спокойно разгуливать на людях, если мои чувства к Сэм будут так заметно выпирать из плавок!"

# ch/samantha/events.rpy:1983
translate russian samantha_male_ending_5463f3ee:
    "Наверное, большинство людей подолгу представляют себе день своей свадьбы, продумывая всё до мелочей."

# ch/samantha/events.rpy:1984
translate russian samantha_male_ending_6403997a:
    "Но я никогда к ним не относился и большую часть жизни даже всерьёз не задумывался, женюсь ли вообще."

# ch/samantha/events.rpy:1985
translate russian samantha_male_ending_b9cfc181:
    "А теперь, когда этот важный день наконец настал, всё кажется каким-то нереальным, словно это происходит с другим человеком, а я только наблюдаю."

# ch/samantha/events.rpy:1986
translate russian samantha_male_ending_cc799811:
    "Кажется, я даже не был уверен, что Сэм ответит согласием, не говоря уже о том, что мы зайдём так далеко."

# ch/samantha/events.rpy:1987
translate russian samantha_male_ending_a83caf8c:
    "Мы постарались сделать всё иначе, чем в её несбывшихся планах с Райаном, и выбрали традиционную церемонию в небольшой часовне."

# ch/samantha/events.rpy:1988
translate russian samantha_male_ending_55dcfa0b:
    "Список гостей был коротким: со стороны Сэм в основном близкие родственники и друзья."

# ch/samantha/events.rpy:1989
translate russian samantha_male_ending_5aad8f33:
    "У меня почти нет родни, а с той, что есть, мы не общаемся, так что с моей стороны пришло ещё меньше гостей — только друзья."

# ch/samantha/events.rpy:1990
translate russian samantha_male_ending_7d5f74f5:
    "Хотя никто из нас не говорил об этом вслух, думаю, мы оба рады тихой свадьбе, на которую позвали лишь тех, кого сами хотели видеть."

# ch/samantha/events.rpy:1991
translate russian samantha_male_ending_b150ead3:
    "Из-за явной нехватки надёжных и приятных друзей-мужчин у меня не было ни шафера, ни друзей жениха."

# ch/samantha/events.rpy:1992
translate russian samantha_male_ending_8a01d4a5:
    "Так что в назначенный день я стою у алтаря один, рядом лишь священник, который проведёт церемонию."

# ch/samantha/events.rpy:1993
translate russian samantha_male_ending_ba036697:
    "Но, оглядывая часовню, я чувствую лишь предвкушение, а вовсе не страх."

# ch/samantha/events.rpy:1994
translate russian samantha_male_ending_d9281d2f:
    "Наверное, раз я никогда не представлял себе этот день, то и не очень понимаю, чего ждать."

# ch/samantha/events.rpy:1995
translate russian samantha_male_ending_45c0cc5f:
    "Поэтому я совершенно не переживаю из-за множества мелочей, о которых в такие моменты обычно волнуются люди."

# ch/samantha/events.rpy:1996
translate russian samantha_male_ending_ba1c13d7:
    "Я просто жду, когда заиграет музыка, которую мы выбирали, хотя я уже почти не помню как."

# ch/samantha/events.rpy:1997
translate russian samantha_male_ending_14326fdd:
    "Но на самом деле я жду, когда в дверях в дальнем конце часовни появится Сэм."

# ch/samantha/events.rpy:1998
translate russian samantha_male_ending_1b5d1775:
    "Когда музыка наконец начинает играть, я почти этого не замечаю."

# ch/samantha/events.rpy:1999
translate russian samantha_male_ending_e11e4719:
    "И только когда двери распахиваются, впуская яркий дневной свет, я возвращаюсь к происходящему."

# ch/samantha/events.rpy:2000
translate russian samantha_male_ending_83de4c72:
    "Поначалу Сэм почти невозможно разглядеть: она медленно входит в часовню и идёт по проходу."

# ch/samantha/events.rpy:2001
translate russian samantha_male_ending_d15dac5b:
    "Я вижу лишь её силуэт, пока глаза не привыкают к свету и её облик наконец не становится чётким."

# ch/samantha/events.rpy:2005
translate russian samantha_male_ending_2d75b001:
    "Приготовьтесь к сплошным банальностям: я сейчас слишком захвачен моментом, чтобы быть невозмутимым и оригинальным."

# ch/samantha/events.rpy:2006
translate russian samantha_male_ending_4bacd902:
    "Сэм всегда была одной из самых красивых девушек, которых я встречал."

# ch/samantha/events.rpy:2007
translate russian samantha_male_ending_e823fef2:
    "Она могла возбудить меня одной улыбкой, а если делала чуть больше — и вовсе свести с ума."

# ch/samantha/events.rpy:2008
translate russian samantha_male_ending_89b9e31e:
    "Но сегодня в моих глазах она словно превзошла саму себя."

# ch/samantha/events.rpy:2009
translate russian samantha_male_ending_e1cd8854:
    "Кажется, сейчас всё, за что я её полюбил, видно каждому."

# ch/samantha/events.rpy:2010
translate russian samantha_male_ending_ca74b668:
    "Её белое платье довольно простое, и это лишь подчёркивает природную красоту Сэм."

# ch/samantha/events.rpy:2011
translate russian samantha_male_ending_7f16114a:
    "В руках у неё букет белых цветов, таких же, как те, что украшают часовню."

# ch/samantha/events.rpy:2013
translate russian samantha_male_ending_b54e3009:
    "Я и оглянуться не успеваю, как она преодолевает короткий проход и оказывается передо мной."

# ch/samantha/events.rpy:2015
translate russian samantha_male_ending_878142cb:
    "Сэм просто сияет, пока идёт ко мне по проходу."

# ch/samantha/events.rpy:2016
translate russian samantha_male_ending_bf7d28fb:
    "Не помню, чтобы она когда-нибудь казалась мне прекраснее, чем сегодня."

# ch/samantha/events.rpy:2017
translate russian samantha_male_ending_79ccbff9:
    "Возможно, из-за уже весьма заметного животика её белое платье и не могло быть более сложного покроя."

# ch/samantha/events.rpy:2018
translate russian samantha_male_ending_3f06d28f:
    "Но для меня это лишь делает этот миг ещё прекраснее."

# ch/samantha/events.rpy:2019
translate russian samantha_male_ending_1c985151:
    "Мы много говорили о том, что она забеременела до свадьбы."

# ch/samantha/events.rpy:2020
translate russian samantha_male_ending_20965806:
    "И оба считали, что нам нечего стыдиться или скрывать."

# ch/samantha/events.rpy:2022
translate russian samantha_male_ending_fd5dc422:
    "Ребёнок растёт внутри неё потому, что мы любим друг друга."

# ch/samantha/events.rpy:2023
translate russian samantha_male_ending_bdea6380:
    "Пожалуй, это более искреннее признание в любви, чем любая свадебная церемония."

# ch/samantha/events.rpy:2025
translate russian samantha_male_ending_f8703cde:
    "Я всё ещё любуюсь приближающейся Сэм, когда она подходит ко мне у алтаря и с улыбкой качает головой."

# ch/samantha/events.rpy:2026
translate russian samantha_male_ending_521f2279:
    "Священник" "Кхм... Начнём?"

# ch/samantha/events.rpy:2028
translate russian samantha_male_ending_412f518e:
    "Дальше я стараюсь сосредоточиться на происходящем. Правда стараюсь."

# ch/samantha/events.rpy:2029
translate russian samantha_male_ending_89e3592b:
    "Но слова церемонии сливаются в один поток, и просто чудо, что я не забываю отвечать в нужные моменты."

# ch/samantha/events.rpy:2030
translate russian samantha_male_ending_28648ba9:
    "В определённый момент церемонии наступает привычная драматическая пауза..."

# ch/samantha/events.rpy:2031
translate russian samantha_male_ending_7656ad47:
    "Священник" "Если кому-либо из присутствующих известна причина, по которой эти двое не могут законно вступить в брак, пусть скажет сейчас или молчит вечно."

# ch/samantha/events.rpy:2032
translate russian samantha_male_ending_214a83cb:
    "Повисает напряжённая тишина, и я думаю: не сейчас ли в двери ворвётся Райан?"

# ch/samantha/events.rpy:2033
translate russian samantha_male_ending_e5e23c9b:
    "Или, что ещё хуже, одна из девушек, с которыми я когда-то развлекался!"

# ch/samantha/events.rpy:2034
translate russian samantha_male_ending_9df3ef62:
    "Но через несколько секунд становится ясно, что внезапного вторжения, как в кино, не будет, и церемония продолжается без помех."

# ch/samantha/events.rpy:2035
translate russian samantha_male_ending_e936c898:
    "Незаметно наступает заключительная часть церемонии: мы произносим клятвы и обмениваемся кольцами."

# ch/samantha/events.rpy:2037
translate russian samantha_male_ending_6b55b186:
    "Всё очень просто: мы с Сэм заранее решили, что для нас важны мы сами, а не заученные слова или вещи."

# ch/samantha/events.rpy:2038
translate russian samantha_male_ending_e635ef29:
    "Священник" "С великой радостью объявляю вас мужем и женой."

# ch/samantha/events.rpy:2039
translate russian samantha_male_ending_36a37d32:
    "Священник" "Можете поцеловать невесту."

# ch/samantha/events.rpy:2041
translate russian samantha_male_ending_8574419f:
    "Дважды просить меня не нужно."

# ch/samantha/events.rpy:2046
translate russian samantha_male_ending_f71b8ce6:
    "Обняв Сэм, я отклоняю её назад как можно сильнее и страстно целую."

# ch/samantha/events.rpy:2047
translate russian samantha_male_ending_2fd3afc0:
    "Всё это совершенно реально, но какая-то маленькая часть меня всё ещё отказывается верить."

# ch/samantha/events.rpy:2048
translate russian samantha_male_ending_8dd17bc7:
    "Охренеть! Я не просто добился девушки — она ещё и пошла со мной под венец и стала моей женой!"

# ch/samantha/events.rpy:2050
translate russian samantha_male_ending_0495dd85:
    "Я вижу, как меняется лицо священника, когда он понимает, что сейчас произойдёт."

# ch/samantha/events.rpy:2051
translate russian samantha_male_ending_ed4cda8c:
    "А когда приходит время объявить об этом, на его лбу выступает пот."

# ch/samantha/events.rpy:2052
translate russian samantha_male_ending_cab29fcc:
    "Священник" "Ах..."

# ch/samantha/events.rpy:2053
translate russian samantha_male_ending_09d6c9d5:
    "Священник" "Я... э-э..."

# ch/samantha/events.rpy:2054
translate russian samantha_male_ending_b9f1484c:
    "Священник" "Что ж... Настало время Саманте совершить... необычный жест."

# ch/samantha/events.rpy:2055
translate russian samantha_male_ending_ec22742c:
    "Священник" "Она считает, что это достойный способ продемонстрировать преданность своему супругу."

# ch/samantha/events.rpy:2056
translate russian samantha_male_ending_094f9937:
    "Священник" "Так что всё, что будет дальше, — исключительно её идея!"

# ch/samantha/events.rpy:2060
translate russian samantha_male_ending_5aa7ad26:
    "Священник отступает, пытаясь отстраниться ещё и физически, как только что сделал это на словах."

# ch/samantha/events.rpy:2061
translate russian samantha_male_ending_ff682f29:
    "А Сэм тем временем поворачивается ко мне."

# ch/samantha/events.rpy:2063
translate russian samantha_male_ending_7e5e9373:
    "С улыбкой она опускается передо мной на колени."

# ch/samantha/events.rpy:2064
translate russian samantha_male_ending_fc3a3684:
    "Среди гостей уже слышится шёпот."

# ch/samantha/events.rpy:2065
translate russian samantha_male_ending_f24d05e7:
    "По обе стороны прохода люди спрашивают друг друга, что происходит."

# ch/samantha/events.rpy:2066
translate russian samantha_male_ending_7e768860:
    "Но через мгновение к шёпоту добавляются охи и возгласы."

# ch/samantha/events.rpy:2067
translate russian samantha_male_ending_0c126cb3:
    "Потому что Сэм положила букет и расстёгивает мне ширинку."

# ch/samantha/events.rpy:2068
translate russian samantha_male_ending_cad498b6:
    "Запуская руку в мои брюки, она выглядит совершенно уверенной в себе."

# ch/samantha/events.rpy:2072
translate russian samantha_male_ending_e4abe661:
    "Уверенной в том, что этот поступок как нельзя лучше выражает её чувства."

# ch/samantha/events.rpy:2073
translate russian samantha_male_ending_7c760fc9:
    "А я?"

# ch/samantha/events.rpy:2074
translate russian samantha_male_ending_a8cdc2b0:
    "Ну... Признаюсь, сердце у меня сейчас просто выскакивает из груди!"

# ch/samantha/events.rpy:2075
translate russian samantha_male_ending_efa75dcf:
    "Сэм объяснила мне, что хочет сделать."

# ch/samantha/events.rpy:2076
translate russian samantha_male_ending_68d4f026:
    "Она даже убедила меня согласиться."

# ch/samantha/events.rpy:2077
translate russian samantha_male_ending_cb866232:
    "Но я всё равно изо всех сил стараюсь не смотреть на собравшихся гостей."

# ch/samantha/events.rpy:2078
translate russian samantha_male_ending_20140908:
    "Меня захлёстывает пьянящая смесь настоящего страха и возбуждения."

# ch/samantha/events.rpy:2079
translate russian samantha_male_ending_ced71378:
    "Не отрывая глаз от Сэм, я стараюсь отгородиться от всего остального."

# ch/samantha/events.rpy:2081
translate russian samantha_male_ending_4108eec3:
    "Пока я сосредоточен на ней, всё должно быть нормально."

# ch/samantha/events.rpy:2082
translate russian samantha_male_ending_804a2e17:
    "Она уже достала мой член из брюк."

# ch/samantha/events.rpy:2083
translate russian samantha_male_ending_80ecb320:
    "Сэм поглаживает его, стараясь привести в полную боевую готовность."

# ch/samantha/events.rpy:2084
translate russian samantha_male_ending_5f7fd8b9:
    "Эй, можно сделать мне небольшую скидку?"

# ch/samantha/events.rpy:2085
translate russian samantha_male_ending_9692054d:
    "Всё это происходит в день моей свадьбы."

# ch/samantha/events.rpy:2086
translate russian samantha_male_ending_dd7f961e:
    "Да ещё и на глазах у всех, кого мы на неё пригласили!"

# ch/samantha/events.rpy:2087
translate russian samantha_male_ending_59235062:
    "Но даже так её усилия довольно быстро приносят результат."

# ch/samantha/events.rpy:2088
translate russian samantha_male_ending_0faf369e:
    "Мой член с каждой секундой твердеет, и забыть обо всём остальном становится всё легче."

# ch/samantha/events.rpy:2089
translate russian samantha_male_ending_828806a5:
    "К тому времени, как Сэм целует головку моего члена, я уже полностью сосредоточен."

# ch/samantha/events.rpy:2090
translate russian samantha_male_ending_798a0252:
    "Для меня существует лишь то, что она со мной делает."

# ch/samantha/events.rpy:2092
translate russian samantha_male_ending_ca70aad1:
    "Затаив дыхание, я смотрю, как Сэм берёт мой член в рот."

# ch/samantha/events.rpy:2093
translate russian samantha_male_ending_6ae3321d:
    "Она впускает его понемногу, делая короткие паузы."

# ch/samantha/events.rpy:2094
translate russian samantha_male_ending_1cec17c0:
    "Когда он оказывается достаточно глубоко, чтобы она могла начать, я уже не могу дышать."

# ch/samantha/events.rpy:2096
translate russian samantha_male_ending_89697f16:
    "И только когда Сэм начинает двигать головой взад-вперёд, я наконец выдыхаю."

# ch/samantha/events.rpy:2097
translate russian samantha_male_ending_3558ee47:
    "Даже тогда наслаждение заставляет меня дышать прерывисто."

# ch/samantha/events.rpy:2098
translate russian samantha_male_ending_d8eb599a:
    "Потому что Сэм чертовски хороша в таких делах."

# ch/samantha/events.rpy:2099
translate russian samantha_male_ending_8aa512a9:
    "Губы, зубы, язык — она умело пускает в ход всё."

# ch/samantha/events.rpy:2101
translate russian samantha_male_ending_a616ba28:
    "Но дело не только в этом."

# ch/samantha/events.rpy:2102
translate russian samantha_male_ending_34e6bd14:
    "Сэм сейчас делает мне далеко не обычный минет."

# ch/samantha/events.rpy:2103
translate russian samantha_male_ending_03b3b622:
    "Так она решила выразить свою любовь ко мне."

# ch/samantha/events.rpy:2104
translate russian samantha_male_ending_9b992c8e:
    "И этим чувством проникнуто каждое её движение."

# ch/samantha/events.rpy:2106
translate russian samantha_male_ending_9f9157d1:
    "Сэм с бесконечной заботой старается сделать каждое мгновение незабываемым."

# ch/samantha/events.rpy:2107
translate russian samantha_male_ending_ad64fd2a:
    "Она отдаётся этому целиком, чтобы я ощутил всю глубину её нежности."

# ch/samantha/events.rpy:2108
translate russian samantha_male_ending_0e290e2c:
    "Будь я более поэтичным человеком, я бы даже назвал это поклонением!"

# ch/samantha/events.rpy:2109
translate russian samantha_male_ending_950387a0:
    "Хотя, наверное, это немного кощунственно, учитывая, что мы сейчас в часовне..."

# ch/samantha/events.rpy:2110
translate russian samantha_male_ending_2b22e8ea:
    "Сэм ласкает головку и ствол, сжимает мои яйца."

# ch/samantha/events.rpy:2111
translate russian samantha_male_ending_dae42911:
    "От всего этого я вскоре оказываюсь на грани."

# ch/samantha/events.rpy:2112
translate russian samantha_male_ending_38808221:
    "Как всегда, она всё предугадывает и полностью владеет ситуацией."

# ch/samantha/events.rpy:2113
translate russian samantha_male_ending_c884075d:
    "Чувствуя, что я вот-вот кончу, Сэм готовится."

# ch/samantha/events.rpy:2117
translate russian samantha_male_ending_01529fa0:
    "Сэм раскрывает рот и выпускает мой член."

# ch/samantha/events.rpy:2118
translate russian samantha_male_ending_cb171933:
    "Затем остаётся передо мной на коленях в ожидании."

# ch/samantha/events.rpy:2119
translate russian samantha_male_ending_cf9b2e87:
    "С этой улыбкой её лицо кажется чистым и невинным."

# ch/samantha/events.rpy:2121
translate russian samantha_male_ending_76679858:
    "И когда я кончаю ей на лицо, зрелище выходит совершенно особенным!"

# ch/samantha/events.rpy:2123
translate russian samantha_male_ending_69de3aa3:
    "Сэм даже не вздрагивает и с радостью позволяет мне покрыть её лицо спермой."

# ch/samantha/events.rpy:2125
translate russian samantha_male_ending_b2c2e036:
    "Вскоре по нему тянутся густые влажные полосы."

# ch/samantha/events.rpy:2128
translate russian samantha_male_ending_36c8665e:
    "Когда это происходит, Сэм не выпускает мой член изо рта."

# ch/samantha/events.rpy:2130
translate russian samantha_male_ending_7089c71a:
    "И проглатывает каждую каплю, вырывающуюся из меня."

# ch/samantha/events.rpy:2132
translate russian samantha_male_ending_6b69d479:
    "Ни разу не замешкавшись, она принимает всё, что я могу ей дать."

# ch/samantha/events.rpy:2134
translate russian samantha_male_ending_b26a6821:
    "Когда я заканчиваю, Сэм открывает рот и выпускает мой член."

# ch/samantha/events.rpy:2135
translate russian samantha_male_ending_cf9b2e87_1:
    "С этой улыбкой её лицо кажется чистым и невинным."

# ch/samantha/events.rpy:2136
translate russian samantha_male_ending_c1e9b6a2:
    "Словно она наконец утолила голод."

# ch/samantha/events.rpy:2137
translate russian samantha_male_ending_9a19ba41:
    "Почти как один, все присутствующие вскакивают на ноги."

# ch/samantha/events.rpy:2138
translate russian samantha_male_ending_1e56780e:
    "На миг мне кажется, что сейчас они возмущённо покинут часовню."

# ch/samantha/events.rpy:2139
translate russian samantha_male_ending_ea0cd10a:
    "Или, что хуже, бросятся к алтарю и сожгут нас как еретиков!"

# ch/samantha/events.rpy:2140
translate russian samantha_male_ending_7d339ae0:
    "Но затем я слышу хлопки, и часовня наполняется аплодисментами."

# ch/samantha/events.rpy:2141
translate russian samantha_male_ending_a67656a6:
    "Кто-то даже одобрительно кричит!"

# ch/samantha/events.rpy:2142
translate russian samantha_male_ending_290fd186:
    "Похоже, выступление Сэм всё-таки пришлось им по душе!"

# ch/samantha/events.rpy:2147
translate russian samantha_male_ending_02152ad5:
    samantha.say "Говорят, жизнь — это то, что происходит, пока мы строим планы. Думаю, мой путь сюда это подтверждает."

# ch/samantha/events.rpy:2148
translate russian samantha_male_ending_ae606407:
    samantha.say "Сколько себя помню, я всегда представляла, как сложится моя жизнь: строила планы, мечтала о том, как всё будет."

# ch/samantha/events.rpy:2149
translate russian samantha_male_ending_7b4e6a7f:
    samantha.say "Но потом я поняла: если твёрдо знаешь, как должна сложиться твоя жизнь, то порой не замечаешь даже очевидного."

# ch/samantha/events.rpy:2150
translate russian samantha_male_ending_876ceefa:
    samantha.say "Взять хотя бы мой выбор мужчин. Я была уверена, что, встретив того самого, сразу это пойму и смогу построить с ним отношения, ведь нам суждено быть вместе."

# ch/samantha/events.rpy:2151
translate russian samantha_male_ending_bfe4e9b6:
    samantha.say "Когда я поселилась в доме, где жили [lssb_samantha.hero_name()] и Райан, первый был дружелюбным и немного тихим, а второй сразу принялся очаровывать меня собой и своими грандиозными планами на жизнь."

# ch/samantha/events.rpy:2152
translate russian samantha_male_ending_e816af18:
    samantha.say "Угадайте, в кого я влюбилась, а к кому мне стоило бы присмотреться внимательнее?"

# ch/samantha/events.rpy:2153
translate russian samantha_male_ending_36a6b35c:
    samantha.say "Если вы решили, что это два разных человека, то угадали!"

# ch/samantha/events.rpy:2154
translate russian samantha_male_ending_a96f48c3:
    samantha.say "[lssb_samantha.hero_name()] вскоре стал просто хорошим другом, а Райан ухаживал за мной и покорил моё сердце."

# ch/samantha/events.rpy:2155
translate russian samantha_male_ending_c38768d9:
    samantha.say "И когда он предложил мне выйти за него, я решила, что это доказательство правильности моего выбора."

# ch/samantha/events.rpy:2156
translate russian samantha_male_ending_c39cf221:
    samantha.say "Оказалось, я ошибалась... В некотором смысле."

# ch/samantha/events.rpy:2157
translate russian samantha_male_ending_9cff697f:
    samantha.say "Райан охотно добивался женщин, но не собирался ограничиваться одной победой за раз."

# ch/samantha/events.rpy:2158
translate russian samantha_male_ending_c0adb5d5:
    samantha.say "То, что именно [lssb_samantha.hero_name()] открыл мне на это глаза, могло бы вызвать у кого-то сомнения в его мотивах."

# ch/samantha/events.rpy:2159
translate russian samantha_male_ending_773589a4:
    samantha.say "Да и я, честно говоря, тогда тоже сомневалась."

# ch/samantha/events.rpy:2160
translate russian samantha_male_ending_e24ec745:
    samantha.say "Но он был со мной совершенно честен и ни на секунду не отрицал, что всегда испытывал ко мне чувства."

# ch/samantha/events.rpy:2161
translate russian samantha_male_ending_1f648f7e:
    samantha.say "После этого он предоставил мне решать самой и ни разу не попытался навязать себя."

# ch/samantha/events.rpy:2162
translate russian samantha_male_ending_430246fc:
    samantha.say "Тогда я впервые задумалась: может, я ошибалась всякий раз, когда искала то, чего, как мне казалось, хотела?"

# ch/samantha/events.rpy:2163
translate russian samantha_male_ending_e0c81c91:
    samantha.say "Я начала думать о том, что будет, если просто принимать жизнь такой, какая она есть, и посмотреть, что она принесёт."

# ch/samantha/events.rpy:2164
translate russian samantha_male_ending_da05e2c4:
    samantha.say "С радостью могу сказать: благодаря этому рядом со мной оказался [lssb_samantha.hero_name()], а вместе с ним пришло всё наше счастье."

# ch/samantha/events.rpy:2165
translate russian samantha_male_ending_4fd20261:
    samantha.say "Когда он неожиданно предложил мне выйти за него, это показалось ещё одним непредсказуемым поворотом жизни."

# ch/samantha/events.rpy:2166
translate russian samantha_male_ending_67227de5:
    samantha.say "И я согласилась."

# ch/samantha/events.rpy:2167
translate russian samantha_male_ending_7419b5f2:
    samantha.say "Со свадьбы прошло не так много времени, и мы всё ещё учимся жить как муж и жена."

# ch/samantha/events.rpy:2168
translate russian samantha_male_ending_53d7df66:
    samantha.say "Но за этот короткий срок многое изменилось."

# ch/samantha/events.rpy:2169
translate russian samantha_male_ending_7d450e3a:
    samantha.say "[lssb_samantha.hero_name()] съехал из дома, в котором мы когда-то жили вместе, и мы оба наконец избавились от связанных с ним плохих воспоминаний."

# ch/samantha/events.rpy:2170
translate russian samantha_male_ending_8007fd77:
    samantha.say "Мы переехали в домик поменьше, зато подальше от всех, на побережье, с видом на продуваемый ветрами пляж."

# ch/samantha/events.rpy:2171
translate russian samantha_male_ending_34d4760a:
    samantha.say "Его работа позволяла трудиться из дома."

# ch/samantha/events.rpy:2172
translate russian samantha_male_ending_706793c0:
    samantha.say "А я наконец взялась за перо — по крайней мере, образно говоря — и написала первую из множества историй, положивших начало моей карьере детской писательницы."

# ch/samantha/events.rpy:2173
translate russian samantha_male_ending_6ccaf8b1:
    samantha.say "Вряд ли я скоро стану новой Джоан Роулинг, но у меня есть деятельный агент и заинтересованный издатель, так что всё складывается неплохо."

# ch/samantha/events.rpy:2174
translate russian samantha_male_ending_b18a43c3:
    samantha.say "Именно этим я и занималась, прежде чем сесть за эти небольшие размышления: работала над очередной историей."

# ch/samantha/events.rpy:2176
translate russian samantha_male_ending_003fa2cd:
    samantha.say "Но теперь я слышу, как [lssb_samantha.hero_name()] зовёт меня с улицы."

# ch/samantha/events.rpy:2177
translate russian samantha_male_ending_5f443171:
    samantha.say "Он хочет отправиться на одну из долгих прогулок по пляжу, к которым мы так привыкли."

# ch/samantha/events.rpy:2178
translate russian samantha_male_ending_ff81a4e1:
    samantha.say "Каждый день мы просто выходим из дома и идём, куда захотим."

# ch/samantha/events.rpy:2179
translate russian samantha_male_ending_ec0da945:
    samantha.say "Разговариваем, делимся идеями и всегда высматриваем интересные коряги и другие находки, выброшенные за ночь на берег."

# ch/samantha/events.rpy:2180
translate russian samantha_male_ending_142be820:
    samantha.say "[lssb_samantha.hero_name()] всё говорит о том, чтобы делать скульптуры из наших находок и даже продавать их на блошином рынке в ближайшем городке."

# ch/samantha/events.rpy:2181
translate russian samantha_male_ending_70c9a812:
    samantha.say "Он возмущается, когда я предлагаю отрастить бороду и начать пить местный IPA, чтобы стать настоящим хипстером."

# ch/samantha/events.rpy:2182
translate russian samantha_male_ending_501874f8:
    samantha.say "Но, по-моему, эта новая жизнь и правда меняет нас обоих к лучшему."

# ch/samantha/events.rpy:2183
translate russian samantha_male_ending_a5c5c72b:
    samantha.say "Или просто омывает нас, словно прилив — коряги, постепенно стирая всё лишнее, пока мы не становимся теми, кем всегда должны были быть."

# ch/samantha/events.rpy:2185
translate russian samantha_male_ending_62daba0d:
    samantha.say "Но теперь я слышу, как [lssb_samantha.hero_name()] зовёт меня из гостиной."

# ch/samantha/events.rpy:2186
translate russian samantha_male_ending_e8110e10:
    samantha.say "Слышны и милые тихие возгласы Айзека, уже понемногу похожие на слова."

# ch/samantha/events.rpy:2187
translate russian samantha_male_ending_62b7f8b1:
    samantha.say "Айзек уже начинает ходить, но пока не делает ни шага без мамы, которая должна смотреть и хлопать в ладоши, радуясь его успехам."

# ch/samantha/events.rpy:2188
translate russian samantha_male_ending_df2a06a4:
    samantha.say "Я знаю, что иногда [lssb_samantha.hero_name()] считает нашу здешнюю жизнь слишком тихой и размеренной по сравнению с городской."

# ch/samantha/events.rpy:2189
translate russian samantha_male_ending_ae4e6515:
    samantha.say "Но, думаю, теперь он находит радость совсем в другом, чем раньше."

# ch/samantha/events.rpy:2190
translate russian samantha_male_ending_87141ece:
    samantha.say "Забавно, как часто, имея вроде бы меньше, начинаешь и желать меньшего."

# ch/samantha/events.rpy:2191
translate russian samantha_male_ending_d0d3e879:
    samantha.say "Наверное, нужно просто понять, что действительно ценно в жизни."

# ch/samantha/events.rpy:2192
translate russian samantha_male_ending_e7800f1c:
    samantha.say "Я почти уверена, что наша история ещё очень далека от завершения."

# ch/samantha/events.rpy:2193
translate russian samantha_male_ending_571baaf1:
    samantha.say "Но, возможно, именно сейчас она незаметно меняется."

# ch/samantha/events.rpy:2194
translate russian samantha_male_ending_c2d162d4:
    samantha.say "Так, что становится интереснее нам самим, чем любому случайному наблюдателю."

# ch/samantha/events.rpy:2207
translate russian samantha_babyshopping_b88cd1a2:
    samantha.say "Я уже так волнуюсь!"

# ch/samantha/events.rpy:2208
translate russian samantha_babyshopping_5ef244d3:
    "На её лице сияет улыбка — привычное и всегда приятное зрелище, от которого я улыбаюсь в ответ."

# ch/samantha/events.rpy:2209
translate russian samantha_babyshopping_f3fe950a:
    mike.say "Уже скоро. Осталось совсем немного."

# ch/samantha/events.rpy:2211
translate russian samantha_babyshopping_0007ac9e:
    samantha.say "В последнее время малыш часто пинается. Думаю, ему тоже не терпится."

# ch/samantha/events.rpy:2212
translate russian samantha_babyshopping_e5bbb9cf:
    mike.say "Тогда, может, он даже появится пораньше."

# ch/samantha/events.rpy:2214
translate russian samantha_babyshopping_4f9d7da9:
    samantha.say "Ох, надеюсь!"

# ch/samantha/events.rpy:2215
translate russian samantha_babyshopping_f381b068:
    samantha.say "Не настолько рано, чтобы это было опасно, конечно. Просто я уже не могу ждать!"

# ch/samantha/events.rpy:2216
translate russian samantha_babyshopping_f229f7a0:
    "Я смеюсь, обнимаю Саманту за плечи и притягиваю к себе."

# ch/samantha/events.rpy:2217
translate russian samantha_babyshopping_c5765f93:
    mike.say "С такими родителями, как мы, ребёнок точно будет красавчиком."

# ch/samantha/events.rpy:2219
translate russian samantha_babyshopping_f196f7ed:
    "Теперь смеётся Саманта и, покраснев, легко целует меня в щёку."

# ch/samantha/events.rpy:2220
translate russian samantha_babyshopping_f9d3d73d:
    samantha.say "Надеюсь, он будет весь в тебя."

# ch/samantha/events.rpy:2221
translate russian samantha_babyshopping_85c96372:
    mike.say "А я надеюсь, что в тебя. Будем держать кулачки, чтобы он взял лучшее от нас обоих."

# ch/samantha/events.rpy:2223
translate russian samantha_babyshopping_81c267d5:
    samantha.say "Я составила список всего, что нам нужно."

# ch/samantha/events.rpy:2224
translate russian samantha_babyshopping_2e35a6f0:
    "Начинает Саманта, доставая из кармана лист бумаги."

# ch/samantha/events.rpy:2225
translate russian samantha_babyshopping_848880d2:
    "Когда я вижу, что там написано, у меня отвисает челюсть. Это не один лист, а целых четыре, с обеих сторон исписанных списками покупок."

# ch/samantha/events.rpy:2226
translate russian samantha_babyshopping_4f764a39:
    "Мой кошелёк вдруг кажется совсем пустым, но я сглатываю и киваю, пока Саманта продолжает."

# ch/samantha/events.rpy:2227
translate russian samantha_babyshopping_2a09a6d1:
    samantha.say "Итак, думаю, нам стоит купить..."

# ch/samantha/events.rpy:2228
translate russian samantha_babyshopping_a56cf9cb:
    "Я и сам вижу список, но, когда Саманта читает его вслух, он кажется ещё длиннее."

# ch/samantha/events.rpy:2229
translate russian samantha_babyshopping_ebb4c09d:
    samantha.say "А в конце возьмём всего несколько наборов слюнявчиков! Всё понял?"

# ch/samantha/events.rpy:2230
translate russian samantha_babyshopping_ceeb3174:
    mike.say "Да, я... э-э... Всё понял."

# ch/samantha/events.rpy:2231
translate russian samantha_babyshopping_7bba5d0f:
    "Она улыбается, а я киваю, чувствуя, как ужасно вспотели ладони."

# ch/samantha/events.rpy:2233
translate russian samantha_babyshopping_76f018f4:
    "К счастью, Саманту это не смущает: она подходит вплотную и берёт меня за руки."

# ch/samantha/events.rpy:2234
translate russian samantha_babyshopping_f07fa142:
    "На несколько мгновений я теряюсь в её глазах."

# ch/samantha/events.rpy:2236
translate russian samantha_babyshopping_54338cbd:
    samantha.say "Я люблю тебя, [lssb_samantha.hero_name()]."

# ch/samantha/events.rpy:2237
translate russian samantha_babyshopping_b56d3e8e:
    "Я подмигиваю ей, наклоняюсь и обнимаю."

# ch/samantha/events.rpy:2238
translate russian samantha_babyshopping_ce8da0ab:
    mike.say "Я тоже тебя люблю."

# ch/samantha/events.rpy:2240
translate russian samantha_babyshopping_3f1ae14f:
    "Видеть её такой счастливой, эту милую улыбку, то, как всё её лицо светится от радости, — ради этого стоит постараться."

# ch/samantha/events.rpy:2241
translate russian samantha_babyshopping_fea6a130:
    "Это бесценно."

# ch/samantha/events.rpy:2242
translate russian samantha_babyshopping_ae8bd4fc:
    mike.say "Ну что, пойдём. Дел ещё много."

# ch/samantha/events.rpy:2246
translate russian samantha_babyshopping_dbce958d:
    "Я быстро отстраняюсь, не выпуская её руки, и жестом предлагаю вести."

# ch/samantha/events.rpy:2247
translate russian samantha_babyshopping_5fbdc1d4:
    "Хотя эту поездку запланировал я, сам бы я не знал, с чего начать. А она явно подготовилась основательно."

# ch/samantha/events.rpy:2248
translate russian samantha_babyshopping_9be85464:
    "Она даже заранее выбрала конкретные товары. До такой предусмотрительности мне далеко."

# ch/samantha/events.rpy:2249
translate russian samantha_babyshopping_56e63f2a:
    mike.say "Ты точно знаешь, что делаешь, да?"

# ch/samantha/events.rpy:2250
translate russian samantha_babyshopping_1c0a403f:
    samantha.say "Ну, даже немного неловко."

# ch/samantha/events.rpy:2251
translate russian samantha_babyshopping_ab597bac:
    samantha.say "Я подумала, что тебе не захочется целый день разглядывать детские комбинезончики, и вчера пришла сюда выбрать кое-что заранее."

# ch/samantha/events.rpy:2252
translate russian samantha_babyshopping_306303bf:
    "На мгновение я просто теряю дар речи."

# ch/samantha/events.rpy:2253
translate russian samantha_babyshopping_51442b85:
    mike.say "Ты дважды сюда приехала, просто чтобы мне было легче?"

# ch/samantha/events.rpy:2255
translate russian samantha_babyshopping_cc4ee49b:
    samantha.say "Я знала, что ты будешь переживать, ведь роды уже скоро. Да и мне не сиделось на месте. Так что да."

# ch/samantha/events.rpy:2256
translate russian samantha_babyshopping_731cea5b:
    "Она выглядит немного смущённой, но я слишком восхищён ею, чтобы сразу её успокоить."

# ch/samantha/events.rpy:2257
translate russian samantha_babyshopping_b0d6ad05:
    mike.say "Ты иногда просто поражаешь меня."

# ch/samantha/events.rpy:2258
translate russian samantha_babyshopping_c58b82b7:
    mike.say "Ты такая заботливая. Это невероятно."

# ch/samantha/events.rpy:2260
translate russian samantha_babyshopping_f11c24e0:
    samantha.say "Хе-хе, я просто хочу сделать всё, что могу, чтобы тебе было легче."

# ch/samantha/events.rpy:2261
translate russian samantha_babyshopping_b7042ce3:
    mike.say "Это моя задача. Это я должен заботиться о тебе."

# ch/samantha/events.rpy:2262
translate russian samantha_babyshopping_e14b2fcf:
    samantha.say "Ты и так столько делаешь. Мне просто хотелось ответить тем же."

# ch/samantha/events.rpy:2265
translate russian samantha_babyshopping_a24b8628:
    "Я фыркаю и собираюсь возразить, но тут она вдруг вскрикивает."

# ch/samantha/events.rpy:2266
translate russian samantha_babyshopping_b997bc5b:
    samantha.say "Ах! Пинается!"

# ch/samantha/events.rpy:2270
translate russian samantha_babyshopping_bd0ef448:
    "Я чуть ли не роняю пакеты, освобождая руки, и Саманта направляет их к своему животу."

# ch/samantha/events.rpy:2271
translate russian samantha_babyshopping_17eadd39:
    "Её кожа тёплая, и вскоре я действительно чувствую толчок в ладонь."

# ch/samantha/events.rpy:2272
translate russian samantha_babyshopping_fcf3342d:
    "Я поражён его силой. Видимо, это заметно по лицу, потому что Саманта тут же смеётся."

# ch/samantha/events.rpy:2273
translate russian samantha_babyshopping_a5be6597:
    mike.say "Ого! Настоящий боец растёт, да?"

# ch/samantha/events.rpy:2274
translate russian samantha_babyshopping_8a962420:
    samantha.say "По ощущениям — точно. И маленькая проказница: постоянно будит меня своими пинками."

# ch/samantha/events.rpy:2275
translate russian samantha_babyshopping_7d1c1609:
    "Я укоризненно грожу пальцем животу Саманты, качаю головой и говорю самым строгим голосом."

# ch/samantha/events.rpy:2276
translate russian samantha_babyshopping_39105669:
    mike.say "Так-так, маме нужно отдыхать. Прекращай её будить."

# ch/samantha/events.rpy:2277
translate russian samantha_babyshopping_f4f8795d:
    "Саманта смеётся над моим выражением лица."

# ch/samantha/events.rpy:2278
translate russian samantha_babyshopping_149fbc80:
    samantha.say "Ты уже выглядишь как папа. Осталось научиться дурацким шуткам — и готово."

# ch/samantha/events.rpy:2279
translate russian samantha_babyshopping_df6428f4:
    mike.say "Дурацким шуткам?"

# ch/samantha/events.rpy:2280
translate russian samantha_babyshopping_960bbe8b:
    mike.say "Как приготовить святую воду?"

# ch/samantha/events.rpy:2281
translate russian samantha_babyshopping_4e76836b:
    samantha.say "Не знаю. Как?"

# ch/samantha/events.rpy:2282
translate russian samantha_babyshopping_622f2531:
    mike.say "Кипятить до тех пор, пока все черти не выскочат."

# ch/samantha/events.rpy:2283
translate russian samantha_babyshopping_4875e595:
    "Саманта явно морщится, но всё равно смеётся. Правда, я не могу понять, не из жалости ли."

# ch/samantha/events.rpy:2284
translate russian samantha_babyshopping_367cf0a7:
    samantha.say "Хе-хе, ты и правда готов стать папой."

# ch/samantha/events.rpy:2285
translate russian samantha_babyshopping_9262d075:
    mike.say "Если только это и нужно, я буду лучшим папой на свете."

# ch/samantha/events.rpy:2286
translate russian samantha_babyshopping_3f78bde0:
    samantha.say "Уверена, ты и так им будешь, [lssb_samantha.hero_name()]."

# ch/samantha/events.rpy:2287
translate russian samantha_babyshopping_e0ba904c:
    "Ещё один пинок прерывает мои мысли. Саманта тихо вскрикивает — должно быть, этот был особенно сильным."

# ch/samantha/events.rpy:2288
translate russian samantha_babyshopping_45e40329:
    samantha.say "Может, малыш пойдёт в спорт."

# ch/samantha/events.rpy:2289
translate russian samantha_babyshopping_010fe22f:
    mike.say "Силы ему точно хватит."

# ch/samantha/events.rpy:2290
translate russian samantha_babyshopping_b7917aaf:
    mike.say "Ну что скажешь? Хочешь заниматься спортом?"

# ch/samantha/events.rpy:2291
translate russian samantha_babyshopping_24158a97:
    "Спрашиваю я у округлого живота Саманты, затем наклоняюсь и осторожно прижимаюсь к нему щекой."

# ch/samantha/events.rpy:2292
translate russian samantha_babyshopping_f42656c4:
    "Я не вижу лица Саманты, но она наверняка краснеет: даже её живот становится чуть теплее."

# ch/samantha/events.rpy:2293
translate russian samantha_babyshopping_04bf4ddb:
    mike.say "Интересно..."

# ch/samantha/events.rpy:2294
translate russian samantha_babyshopping_5ae2d71b:
    "Протягиваю я, усмехаясь."

# ch/samantha/events.rpy:2296
translate russian samantha_babyshopping_e71c487b:
    mike.say "Кексик, малыш говорит, что хочет заниматься наукой."

# ch/samantha/events.rpy:2298
translate russian samantha_babyshopping_a2b845b2:
    mike.say "Саманта, малыш говорит, что хочет заниматься наукой."

# ch/samantha/events.rpy:2299
translate russian samantha_babyshopping_d4c27fd1:
    samantha.say "Хе-хе, тебе повезло. Со мной она никогда не разговаривает."

# ch/samantha/events.rpy:2300
translate russian samantha_babyshopping_396933f5:
    mike.say "Почему ты не разговариваешь с мамой?"

# ch/samantha/events.rpy:2301
translate russian samantha_babyshopping_3ab3cbb8:
    "Спрашиваю я, чуть сильнее прижимаясь к животу. Конечно, не настолько, чтобы навредить ребёнку, но достаточно, чтобы снова смутить Саманту."

# ch/samantha/events.rpy:2303
translate russian samantha_babyshopping_5189a615:
    mike.say "А, говорит, потому что я круче. Прости, Кексик, передаю слова малыша."

# ch/samantha/events.rpy:2305
translate russian samantha_babyshopping_8b42813e:
    mike.say "А, говорит, потому что я круче. Прости, Саманта, передаю слова малыша."

# ch/samantha/events.rpy:2306
translate russian samantha_babyshopping_bab1d762:
    samantha.say "Ах вот как? Я это припомню, когда кому-то захочется шоколадный кекс."

# ch/samantha/events.rpy:2307
translate russian samantha_babyshopping_e604ec6d:
    mike.say "Слышишь? Больше никаких шоколадных кексов."

# ch/samantha/events.rpy:2308
translate russian samantha_babyshopping_64b78176:
    "Я начинаю смеяться, но тут получаю пинок в щёку."

# ch/samantha/events.rpy:2309
translate russian samantha_babyshopping_8079a146:
    "От неожиданности я отдёргиваюсь, а потом мы с Самантой смеёмся вместе."

# ch/samantha/events.rpy:2310
translate russian samantha_babyshopping_2d9cf6ca:
    samantha.say "Думаю, ей это не понравилось."

# ch/samantha/events.rpy:2311
translate russian samantha_babyshopping_7ca8eb70:
    mike.say "Ну, я бы тоже не обрадовался, если бы кто-то пригрозил отобрать МОИ кексы."

# ch/samantha/events.rpy:2315
translate russian samantha_babyshopping_ab46407c:
    "Я выпрямляюсь и крепко обнимаю Саманту."

# ch/samantha/events.rpy:2316
translate russian samantha_babyshopping_b3095226:
    samantha.say "Наш малыш будет замечательным."

# ch/samantha/events.rpy:2317
translate russian samantha_babyshopping_6c6bb1a1:
    mike.say "Весь в маму."

# ch/samantha/events.rpy:2318
translate russian samantha_babyshopping_422d6b20:
    samantha.say "Весь в папу."

# ch/samantha/events.rpy:2319
translate russian samantha_babyshopping_0488b472:
    "Я прерываю её поцелуем, иначе мы до конца дня будем спорить, кто лучше."

# ch/samantha/events.rpy:2320
translate russian samantha_babyshopping_3b25e499:
    "Похоже, Саманта смущена тем, что всё это произошло на людях. К счастью, мы успеваем уйти, прежде чем кто-то заглядывает в проход, где мы стояли."

# ch/samantha/events.rpy:2323
translate russian samantha_babyshopping_3432b02b:
    "К концу дня пакетов набирается столько, что я едва их уношу. Хотя до дома недалеко, приходится взять такси."

# ch/samantha/events.rpy:2324
translate russian samantha_babyshopping_dd3ebe2d:
    "Но лучше купить всё сейчас, чем потом. Да и одна только радость Саманты, выбирающей милые детские вещички, того стоила."

# ch/samantha/events.rpy:2333
translate russian samantha_meet_sasha_704e4c32:
    sasha.say "Привет, я Саша."

# ch/samantha/events.rpy:2335
translate russian samantha_meet_sasha_e70c2230:
    samantha.say "Я Саманта. Приятно познакомиться."

# ch/samantha/events.rpy:2337
translate russian samantha_meet_sasha_f17e615a:
    sasha.say "Та самая бывшая влюблённость?"

# ch/samantha/events.rpy:2339
translate russian samantha_meet_sasha_9707e6c3:
    sasha.say "Наверное, ты по ночам плачешь. Много."

# ch/samantha/events.rpy:2341
translate russian samantha_meet_sasha_b38db0c4:
    samantha.say "Почему?"

# ch/samantha/events.rpy:2343
translate russian samantha_meet_sasha_f384cef1:
    sasha.say "Ну, такого жеребца упустила."

# ch/samantha/events.rpy:2344
translate russian samantha_meet_sasha_371b8676:
    mike.say "..."

# ch/samantha/events.rpy:2347
translate russian samantha_meet_sasha_08d76793:
    samantha.say "Никогда не поздно."

# ch/samantha/events.rpy:2349
translate russian samantha_meet_sasha_cfa2f32e:
    sasha.say "Шанс был, ты его упустила. Проходи мимо."

# ch/samantha/events.rpy:2354
translate russian samantha_meet_sasha_6a7151a0:
    samantha.say "С Райаном выбор был непростой. Я тянула жребий."

# ch/samantha/events.rpy:2359
translate russian samantha_meet_sasha_04dd50fb:
    samantha.say "Он настоящий друг, это точно."

# ch/samantha/events.rpy:2362
translate russian samantha_meet_sasha_346c0627:
    samantha.say "Это ему решать."

# ch/samantha/events.rpy:2364
translate russian samantha_meet_sasha_489e84c2:
    samantha.say "Мне пора."

# ch/samantha/events.rpy:2366
translate russian samantha_meet_sasha_576bcb8f:
    sasha.say "Пока."

# ch/samantha/events.rpy:2377
translate russian samantha_chat_bree_f28c3e58:
    "Саманта и [bree.name] разговаривают у бара."

# ch/samantha/events.rpy:2381
translate russian samantha_chat_bree_0d9eea5d:
    bree.say "Я так за тебя рада!!"

# ch/samantha/events.rpy:2383
translate russian samantha_chat_bree_d04ee2ed:
    samantha.say "Спасибо, я за себя тоже очень рада."

# ch/samantha/events.rpy:2385
translate russian samantha_chat_bree_63b8d442:
    bree.say "Хотела бы я тоже кого-нибудь найти."

# ch/samantha/events.rpy:2387
translate russian samantha_chat_bree_7db54b42:
    samantha.say "А [lssb_samantha.hero_name()] тебя не интересует?"

# ch/samantha/events.rpy:2389
translate russian samantha_chat_bree_8d276eab:
    bree.say "Интересует, но я не уверена, что он видит во мне девушку."

# ch/samantha/events.rpy:2392
translate russian samantha_chat_bree_210e93b7:
    bree.say "Интересует, но только ради хорошего траха. Он такой горячий."

# ch/samantha/events.rpy:2396
translate russian samantha_chat_bree_f54a240f:
    samantha.say "Я бы тоже не отказалась с ним потрахаться..."

# ch/samantha/events.rpy:2399
translate russian samantha_chat_bree_865356da:
    samantha.say "Но не уверена, что сосать член лучшего друга своего жениха — хорошая идея."

# ch/samantha/events.rpy:2401
translate russian samantha_chat_bree_bfb9d77a:
    bree.say "Ха-ха!"

# ch/samantha/events.rpy:2403
translate russian samantha_chat_bree_8d276eab_1:
    bree.say "Интересует, но я не уверена, что он видит во мне девушку."

# ch/samantha/events.rpy:2405
translate russian samantha_chat_bree_eaf56540:
    bree.say "Я не собираюсь довольствоваться твоими объедками!"

# ch/samantha/events.rpy:2408
translate russian samantha_chat_bree_782427b7:
    samantha.say "Райан в последнее время часто ходит в тот стриптиз-клуб."

# ch/samantha/events.rpy:2410
translate russian samantha_chat_bree_5c962526:
    bree.say "Зачем? По-моему, этим девицам до тебя далеко."

# ch/samantha/events.rpy:2411
translate russian samantha_chat_bree_a89f668e:
    samantha.say "Он думает, я не знаю. Но я знаю, просто подыгрываю."

# ch/samantha/events.rpy:2413
translate russian samantha_chat_bree_f4f2855b:
    bree.say "Не уверена, что так стоит поступать в отношениях."

# ch/samantha/events.rpy:2414
translate russian samantha_chat_bree_874e6159:
    samantha.say "Ему просто нужно продолжать считать себя высшим хищником..."

# ch/samantha/events.rpy:2415
translate russian samantha_chat_bree_7d55fd4e:
    bree.say "Вот придурок."

# ch/samantha/events.rpy:2416
translate russian samantha_chat_bree_fedbfaee:
    samantha.say "Зато симпатичный."

# ch/samantha/events.rpy:2417
translate russian samantha_chat_bree_486fe2d7:
    bree.say "Это да..."

# ch/samantha/events.rpy:2420
translate russian samantha_chat_bree_f6838cff:
    samantha.say "Мы с [lssb_samantha.hero_name()] на днях потрахались..."

# ch/samantha/events.rpy:2422
translate russian samantha_chat_bree_306b1366:
    bree.say "Что? Ты же шутишь?"

# ch/samantha/events.rpy:2424
translate russian samantha_chat_bree_30481474:
    samantha.say "Я была немного пьяна."

# ch/samantha/events.rpy:2429
translate russian samantha_chat_bree_3aab2df1:
    bree.say "Не могу поверить, что Райан тебе изменил..."

# ch/samantha/events.rpy:2431
translate russian samantha_chat_bree_71837ddb:
    samantha.say "Да, я тоже. До сих пор в шоке."

# ch/samantha/events.rpy:2433
translate russian samantha_chat_bree_6b0b1036:
    bree.say "Ты же идеальная женщина."

# ch/samantha/events.rpy:2434
translate russian samantha_chat_bree_be3d002d:
    bree.say "Красивая, весёлая, ещё и любишь сосать члены."

# ch/samantha/events.rpy:2436
translate russian samantha_chat_bree_b46c4264:
    samantha.say "Это уж точно..."

# ch/samantha/events.rpy:2437
translate russian samantha_chat_bree_0b8e4a38:
    samantha.say "Спасибо, [bree.name]."

# ch/samantha/events.rpy:2439
translate russian samantha_chat_bree_a16444af:
    bree.say "Покажи кольцо ещё раз."

# ch/samantha/events.rpy:2440
translate russian samantha_chat_bree_9ef052b7:
    "Саманта протягивает руку, чтобы [bree.name] могла рассмотреть кольцо."

# ch/samantha/events.rpy:2442
translate russian samantha_chat_bree_fb3a3afe:
    bree.say "Оно такое красивое!!!"

# ch/samantha/events.rpy:2444
translate russian samantha_chat_bree_77c74944:
    "Они просто болтают о девичьих делах."

# ch/samantha/events.rpy:2454
translate russian samantha_meet_bree_eb76b05c:
    "Саманта смотрит туда, где стоит [bree.name]."

# ch/samantha/events.rpy:2455
translate russian samantha_meet_bree_480d391d:
    samantha.say "Наверняка это одна из твоих новых соседок?"

# ch/samantha/events.rpy:2456
translate russian samantha_meet_bree_bda787cf:
    mike.say "Ага. Хочешь познакомиться?"

# ch/samantha/events.rpy:2457
translate russian samantha_meet_bree_65adca7e:
    samantha.say "Почему бы и нет? Может быть интересно..."

# ch/samantha/events.rpy:2459
translate russian samantha_meet_bree_9db51a26:
    mike.say "Эй, [bree.name], это Саманта, моя бывшая соседка."

# ch/samantha/events.rpy:2461
translate russian samantha_meet_bree_dc005b40:
    samantha.say "Приятно познакомиться."

# ch/samantha/events.rpy:2463
translate russian samantha_meet_bree_8796abf0:
    bree.say "Мне тоже."

# ch/samantha/events.rpy:2465
translate russian samantha_meet_bree_7285ee6f:
    bree.say "Так это ты та бедняжка, которая упустила такого прекрасного молодого человека?"

# ch/samantha/events.rpy:2467
translate russian samantha_meet_bree_f345d7a2:
    samantha.say "Можно и так сказать."

# ch/samantha/events.rpy:2468
translate russian samantha_meet_bree_a431acea:
    bree.say "Позволь поблагодарить тебя от имени остальных женщин."

# ch/samantha/events.rpy:2472
translate russian samantha_meet_bree_7e6246e9:
    samantha.say "Не зазнавайся. Я ведь могу забрать его обратно."

# ch/samantha/events.rpy:2476
translate russian samantha_meet_bree_c6c797ba:
    samantha.say "Не за что."

# ch/samantha/events.rpy:2480
translate russian samantha_meet_bree_4a2db68d:
    bree.say "Как хорошо, что ты разместила то объявление! Дом просто отличный."

# ch/samantha/events.rpy:2481
translate russian samantha_meet_bree_c6c797ba_1:
    samantha.say "Не за что."

# ch/samantha/events.rpy:2500
translate russian samantha_move_in_3902f474:
    "Я беру столько небольших коробок, сколько могу унести, и направляюсь внутрь."

# ch/samantha/events.rpy:2502
translate russian samantha_move_in_3a151e98:
    "Я ещё не видел её новую квартиру, но, едва войдя, сразу чувствую домашний уют."

# ch/samantha/events.rpy:2503
translate russian samantha_move_in_442114a5:
    "Хотя часть мебели ещё лежит в коробках, здесь уже тесновато, но уютно."

# ch/samantha/events.rpy:2504
translate russian samantha_move_in_d172a3cc:
    "Я уверен, Сэм здесь понравится."

# ch/samantha/events.rpy:2505
translate russian samantha_move_in_000d6f12:
    "Я осторожно ставлю коробки рядом с диваном, а Саманта проходит мимо за следующей порцией вещей."

# ch/samantha/events.rpy:2509
translate russian samantha_move_in_4d595dd6:
    "Я легко поднимаю коробки и несу в квартиру. Ставлю их у двери и выпрямляюсь, разминая спину."

# ch/samantha/events.rpy:2510
translate russian samantha_move_in_840fd66f:
    samantha.say "Ого! Спасибо, что принёс. А ты сильный!"

# ch/samantha/events.rpy:2513
translate russian samantha_move_in_bf34cfbb:
    "Не уверен, что смогу это поднять. Лучше подождать Саманту и занести вместе."

# ch/samantha/events.rpy:2517
translate russian samantha_move_in_ad3a4ab3:
    "Саманта наконец выходит обратно и усмехается, глядя на меня."

# ch/samantha/events.rpy:2518
translate russian samantha_move_in_ef7a2cab:
    samantha.say "Помочь?"

# ch/samantha/events.rpy:2519
translate russian samantha_move_in_75ae4750:
    "Я невнятно что-то бурчу в ответ, но мы берёмся за коробку с двух сторон и вместе поднимаем её."

# ch/samantha/events.rpy:2520
translate russian samantha_move_in_db03ad4f:
    "Вскоре она уже стоит посреди главной спальни."

# ch/samantha/events.rpy:2521
translate russian samantha_move_in_d28c43c0:
    samantha.say "Отличная работа, команда!"

# ch/samantha/events.rpy:2524
translate russian samantha_move_in_d96bff7b:
    "Я подхватываю коробки снизу и поднимаю изо всех сил. Поднять удаётся, но стоит сделать шаг, как всё летит вниз."

# ch/samantha/events.rpy:2532
translate russian samantha_move_in_e2515db6:
    "Коробки выскальзывают из рук. Услышав, как что-то разбивается, я морщусь. Это определённо плохо."

# ch/samantha/events.rpy:2533
translate russian samantha_move_in_49907194:
    "Я ещё не успеваю оценить ущерб, как наружу выбегает Саманта. Наверное, услышала."

# ch/samantha/events.rpy:2535
translate russian samantha_move_in_2f512444:
    samantha.say "О нет!"

# ch/samantha/events.rpy:2536
translate russian samantha_move_in_f7c9e754:
    mike.say "Прости меня!"

# ch/samantha/events.rpy:2538
translate russian samantha_move_in_965e41b4:
    "Саманта отмахивается, качая головой, и раскрывает коробку."

# ch/samantha/events.rpy:2539
translate russian samantha_move_in_dcce6794:
    "Внутри лежат шкатулки с украшениями, палетки косметики и прочие вещи, названий которых я не знаю."

# ch/samantha/events.rpy:2540
translate russian samantha_move_in_aa70d8aa:
    "Но сильнее всего бросается в глаза большое зеркало с гравировкой."

# ch/samantha/events.rpy:2541
translate russian samantha_move_in_46441d1e:
    "Стекло покрыто паутиной трещин, а дно коробки усыпано осколками."

# ch/samantha/events.rpy:2542
translate russian samantha_move_in_54e29423:
    "Мне становится не по себе, когда я вижу, как вытягивается её лицо."

# ch/samantha/events.rpy:2543
translate russian samantha_move_in_5cf1582d:
    mike.say "Мне правда очень жаль. Я заплачу за новое!"

# ch/samantha/events.rpy:2544
translate russian samantha_move_in_03af4976:
    "Сказав это, я надеюсь, что оно не слишком дорогое. С моим везением это окажется какой-нибудь редкой семейной реликвией, которой она любовалась каждое утро."

# ch/samantha/events.rpy:2545
translate russian samantha_move_in_4129959d:
    samantha.say "Нет-нет, всё нормально. К тому же мне скорее стоит переживать за тебя!"

# ch/samantha/events.rpy:2546
translate russian samantha_move_in_0e22ae34:
    samantha.say "Тебе теперь семь лет неудачи!"

# ch/samantha/events.rpy:2548
translate russian samantha_move_in_ce298ea8:
    "Она улыбается мне, пытаясь отшутиться, но я вижу, как напряжены её губы."

# ch/samantha/events.rpy:2549
translate russian samantha_move_in_1d57d115:
    "Я помогаю занести остальные вещи, решив больше не возвращаться к этому, раз она так хочет."

# ch/samantha/events.rpy:2555
translate russian samantha_move_in_bf260443:
    "Когда я оборачиваюсь, чтобы поднять письменный стол, рядом вдруг оказывается Саманта."

# ch/samantha/events.rpy:2557
translate russian samantha_move_in_579ae5a9:
    samantha.say "С этим я тебе помогу."

# ch/samantha/events.rpy:2558
translate russian samantha_move_in_992922d1:
    samantha.say "Райан говорит, это подарок от родных. Не хочу его повредить."

# ch/samantha/events.rpy:2559
translate russian samantha_move_in_09d1b0c2:
    mike.say "Хочешь сказать, ты мне не доверяешь?"

# ch/samantha/events.rpy:2561
translate russian samantha_move_in_276d1e32:
    samantha.say "Ты же знаешь, я бы такого не сказала! Просто нам стоит быть особенно осторожными."

# ch/samantha/events.rpy:2562
translate russian samantha_move_in_fc7d8b69:
    mike.say "Ладно, ладно."

# ch/samantha/events.rpy:2563
translate russian samantha_move_in_bcc8130e:
    "Мы медленно заносим стол вдвоём и ставим в квартире. Саманта облегчённо вздыхает."

# ch/samantha/events.rpy:2573
translate russian samantha_event_02_00a00dc3:
    "Войдя через стеклянные двери пекарни, я сразу вижу, сколько здесь народу."

# ch/samantha/events.rpy:2574
translate russian samantha_event_02_fc6f443d:
    "В этом заведении рядом с кофейней любят собираться местные. Здесь всегда оживлённо — приятная смена обстановки."

# ch/samantha/events.rpy:2575
translate russian samantha_event_02_eec9e749:
    "Я встаю в очередь за несколькими посетителями и щурюсь, разглядывая меню на меловой доске."

# ch/samantha/events.rpy:2576
translate russian samantha_event_02_2110e158:
    "Хотя я бывал здесь миллион раз, каждый раз изучаю знакомое меню — и тут же заказываю то же, что всегда."

# ch/samantha/events.rpy:2577
translate russian samantha_event_02_29c8a036:
    "Наконец подходит моя очередь."

# ch/samantha/events.rpy:2579
translate russian samantha_event_02_b6b1a8c9:
    samantha.say "Здравствуйте! Что вам... [lssb_samantha.hero_name()]!"

# ch/samantha/events.rpy:2581
translate russian samantha_event_02_9ef9f8fa:
    mike.say "Привет. Не знал, что ты сегодня работаешь."

# ch/samantha/events.rpy:2582
translate russian samantha_event_02_e087cbf0:
    samantha.say "Ага! Подменяю подругу."

# ch/samantha/events.rpy:2584
translate russian samantha_event_02_c931dff2:
    samantha.say "Она утром позвонила, сказала, что заболела. У бедняжки голос был ужасный."

# ch/samantha/events.rpy:2585
translate russian samantha_event_02_6f466b8d:
    mike.say "Звучит скверно."

# ch/samantha/events.rpy:2587
translate russian samantha_event_02_d7c26025:
    samantha.say "Уверена, она поправится. К тому же мне нравится здесь работать."

# ch/samantha/events.rpy:2588
translate russian samantha_event_02_48c04ab5:
    samantha.say "Так что будешь? Как обычно?"

# ch/samantha/events.rpy:2589
translate russian samantha_event_02_1878e640:
    mike.say "Нет! Я возьму..."

# ch/samantha/events.rpy:2592
translate russian samantha_event_02_c8f47c97:
    mike.say "Холодный эспрессо, но на этот раз с дополнительной ложкой сахара."

# ch/samantha/events.rpy:2593
translate russian samantha_event_02_49b966f1:
    "Саманта прикрывает рот рукой и хихикает."

# ch/samantha/events.rpy:2594
translate russian samantha_event_02_7353ed35:
    samantha.say "И это ты называешь чем-то новеньким? Ладно! Сейчас будет."

# ch/samantha/events.rpy:2596
translate russian samantha_event_02_6ded129c:
    mike.say "Эм... зелёный чай и... черничный маффин."

# ch/samantha/events.rpy:2598
translate russian samantha_event_02_199f8ea2:
    "Саманта улыбается и радостно хлопает в ладоши."

# ch/samantha/events.rpy:2599
translate russian samantha_event_02_a3bcf4d8:
    samantha.say "Потянуло на приключения? Сейчас всё принесу!"

# ch/samantha/events.rpy:2604
translate russian samantha_event_02_b53374c5:
    samantha.say "Держи!"

# ch/samantha/events.rpy:2605
translate russian samantha_event_02_367c0457:
    "Саманта протягивает мне хрустящий коричневый пакет с чёрным логотипом пекарни. Я отдаю ей несколько долларов и монеты."

# ch/samantha/events.rpy:2607
translate russian samantha_event_02_05f4d729:
    mike.say "Спасибо, Кексик! Увидимся..."

# ch/samantha/events.rpy:2609
translate russian samantha_event_02_a0c7df61:
    mike.say "Спасибо, Сэм! Увидимся..."

# ch/samantha/events.rpy:2610
translate russian samantha_event_02_1a7e5206:
    samantha.say "Подожди! У меня через несколько минут перерыв."

# ch/samantha/events.rpy:2612
translate russian samantha_event_02_f7f48732:
    samantha.say "Можем посидеть и немного поболтать!"

# ch/samantha/events.rpy:2615
translate russian samantha_event_02_89a9177a:
    mike.say "Прости, я могу остаться только ненадолго."

# ch/samantha/events.rpy:2617
translate russian samantha_event_02_ede39c95:
    samantha.say "Ох, жаль."

# ch/samantha/events.rpy:2618
translate russian samantha_event_02_db840e30:
    samantha.say "Тогда рада была тебя повидать!"

# ch/samantha/events.rpy:2623
translate russian samantha_event_02_13c55e43:
    samantha.say "Ура! Займи нам столик, а я подойду — и оглянуться не успеешь."

# ch/samantha/events.rpy:2624
translate russian samantha_event_02_adf16cfb:
    "Я киваю и выбираю столик у окна."

# ch/samantha/events.rpy:2628
translate russian samantha_event_02_06492532:
    "Саманта выскакивает из-за прилавка с большим коричневым пакетом в одной руке и дымящейся чашкой в другой. Отодвигает стул напротив меня и садится."

# ch/samantha/events.rpy:2630
translate russian samantha_event_02_da4a604e:
    samantha.say "Ну-у?"

# ch/samantha/events.rpy:2631
translate russian samantha_event_02_bd5ed0d3:
    mike.say "...Что «ну»?"

# ch/samantha/events.rpy:2633
translate russian samantha_event_02_222a000c:
    samantha.say "Рассказывай всё о своих соседках!"

# ch/samantha/events.rpy:2634
translate russian samantha_event_02_c6827366:
    samantha.say "В прошлый раз ты почти ничего не рассказал. Как у вас дела?"

# ch/samantha/events.rpy:2635
translate russian samantha_event_02_7840e0f5:
    mike.say "Они... интересные?"

# ch/samantha/events.rpy:2637
translate russian samantha_event_02_375b21ba:
    samantha.say "Не уходи от ответа! Расскажи, что ты о них думаешь!"

# ch/samantha/events.rpy:2638
translate russian samantha_event_02_34a374af:
    mike.say "Они..."

# ch/samantha/events.rpy:2641
translate russian samantha_event_02_a58089c2:
    mike.say "Они вполне ничего. [bree.name] — настоящая гикша, постоянно играет в видеоигры."

# ch/samantha/events.rpy:2643
translate russian samantha_event_02_f5dac6f2:
    samantha.say "Говоришь так, будто сам не делаешь то же самое."

# ch/samantha/events.rpy:2644
translate russian samantha_event_02_301ba469:
    mike.say "Теперь уже не так часто!"

# ch/samantha/events.rpy:2646
translate russian samantha_event_02_70da0d64:
    samantha.say "А что насчёт второй? Саша, да?"

# ch/samantha/events.rpy:2647
translate russian samantha_event_02_722a0e7d:
    mike.say "Ага. По-моему, я ей не очень нравлюсь."

# ch/samantha/events.rpy:2648
translate russian samantha_event_02_86082267:
    samantha.say "Ну не говори так!"

# ch/samantha/events.rpy:2650
translate russian samantha_event_02_79c695e9:
    samantha.say "Уверена, со временем она к тебе потеплеет."

# ch/samantha/events.rpy:2653
translate russian samantha_event_02_ade1c3fa:
    mike.say "Они просто соседки. Пока платят свою долю, мне не особо важно, чем они занимаются."

# ch/samantha/events.rpy:2654
translate russian samantha_event_02_da623284:
    samantha.say "Тебе стоит хотя бы немного их узнать!"

# ch/samantha/events.rpy:2655
translate russian samantha_event_02_14c3aa38:
    samantha.say "Кто знает, может, они понравятся тебе сильнее, чем ты думаешь."

# ch/samantha/events.rpy:2656
translate russian samantha_event_02_8e0facc7:
    "Саманта подмигивает мне, а я закатываю глаза. В ответ она лишь тихонько смеётся."

# ch/samantha/events.rpy:2659
translate russian samantha_event_02_6b667513:
    samantha.say "О-о, значит, кое-что тебя всё-таки интересует."

# ch/samantha/events.rpy:2660
translate russian samantha_event_02_cf2e7b1f:
    mike.say "Не говори таким тоном! Но да, [bree.name] и Саша более чем симпатичные."

# ch/samantha/events.rpy:2662
translate russian samantha_event_02_9bf894ea:
    samantha.say "Не стесняйся просить меня помочь с девушками. Когда захочу, я могу быть первоклассной сводницей."

# ch/samantha/events.rpy:2665
translate russian samantha_event_02_3bb4e29f:
    "Мы пьём в уютном молчании. Она достаёт из пакета бейгл с печеньем и с удовольствием принимается за угощение."

# ch/samantha/events.rpy:2666
translate russian samantha_event_02_1f1fa394:
    "Мы болтаем ещё немного, пока другой сотрудник не окликает Саманту, напоминая, что пора вернуться к работе."

# ch/samantha/events.rpy:2668
translate russian samantha_event_02_ed920a34:
    samantha.say "Ох, мне пора. Постой!"

# ch/samantha/events.rpy:2671
translate russian samantha_event_02_f83f8b77:
    "Саманта подаётся вперёд и хватает меня за руки."

# ch/samantha/events.rpy:2672
translate russian samantha_event_02_2049e598:
    samantha.say "Поможешь мне сегодня вечером занести остальные вещи?"

# ch/samantha/events.rpy:2674
translate russian samantha_event_02_0d0c90a2:
    samantha.say "Райан сегодня работает и вернётся, когда я уже буду спать."

# ch/samantha/events.rpy:2675
translate russian samantha_event_02_2ace1a7c:
    samantha.say "Было бы здорово сделать ему сюрприз — полностью обустроенный дом!"

# ch/samantha/events.rpy:2677
translate russian samantha_event_02_5308af18:
    mike.say "Не знаю, Кексик..."

# ch/samantha/events.rpy:2679
translate russian samantha_event_02_c47c591e:
    mike.say "Не знаю, Сэм..."

# ch/samantha/events.rpy:2680
translate russian samantha_event_02_69e6921c:
    samantha.say "Я куплю тебе ещё кофе. И как насчёт кусочка нашего торта?"

# ch/samantha/events.rpy:2683
translate russian samantha_event_02_32fcbc43:
    mike.say "Прости, но сегодня мне нужно кое-что сделать. А завтра на работу, так что поздно задерживаться нельзя."

# ch/samantha/events.rpy:2685
translate russian samantha_event_02_ede39c95_1:
    samantha.say "Ох, жаль."

# ch/samantha/events.rpy:2686
translate russian samantha_event_02_fe1694ee:
    samantha.say "Ладно, понимаю. Всё равно спасибо, что посидел со мной!"

# ch/samantha/events.rpy:2687
translate russian samantha_event_02_1086ea48:
    samantha.say "Было приятно поболтать."

# ch/samantha/events.rpy:2691
translate russian samantha_event_02_41c7ffa5:
    "Саманта встаёт, машет мне и возвращается за прилавок. Я поднимаюсь и выхожу на улицу."

# ch/samantha/events.rpy:2696
translate russian samantha_event_02_15a17d54:
    samantha.say "Ура! Спасибо тебе огромное! Увидимся после работы."

# ch/samantha/events.rpy:2702
translate russian samantha_event_02_9c8f4270:
    "Она стоит прямо на улице рядом с грудой коробок и небольшим письменным столом из тёмного красного дерева."

# ch/samantha/events.rpy:2703
translate russian samantha_event_02_e533cd07:
    mike.say "Почему все вещи здесь?"

# ch/samantha/events.rpy:2704
translate russian samantha_event_02_ded33203:
    samantha.say "Грузчики просто выгрузили остатки на улице и пропали. Представляешь?"

# ch/samantha/events.rpy:2705
translate russian samantha_event_02_3c91b75f:
    "Я подозрительно поднимаю бровь, но принимаю объяснение."

# ch/samantha/events.rpy:2706
translate russian samantha_event_02_8d305532:
    "Наверняка тут есть ещё что-то. Буду считать, что Райан их разозлил."

# ch/samantha/events.rpy:2707
translate russian samantha_event_02_1219ee8d:
    mike.say "Вот отстой! Тогда давай занесём всё, пока не стало слишком поздно."

# ch/samantha/events.rpy:2708
translate russian samantha_event_02_e7c161c3:
    samantha.say "Отлично! Бери что хочешь, главное — занести внутрь."

# ch/samantha/events.rpy:2709
translate russian samantha_event_02_660ce9c2:
    "Саманта берёт стопку коробок среднего размера и направляется в дом."

# ch/samantha/events.rpy:2710
translate russian samantha_event_02_6b1c8537:
    samantha.say "Дверь открыта, об этом не беспокойся!"

# ch/samantha/events.rpy:2711
translate russian samantha_event_02_dd7913a1:
    "Я смотрю на гору коробок, размышляя, с чего начать."

# ch/samantha/events.rpy:2712
translate russian samantha_event_02_cb8052ba:
    "Некоторые выглядят довольно тяжёлыми, и мне не хочется что-нибудь разбить, уронив их."

# ch/samantha/events.rpy:2713
translate russian samantha_event_02_64841bcb:
    "К тому же будет стыдно перед Самантой. С чего же начать?"

# ch/samantha/events.rpy:2725
translate russian samantha_event_02_da7eab78:
    samantha.say "Уф!"

# ch/samantha/events.rpy:2727
translate russian samantha_event_02_de9e6dfd:
    samantha.say "Спасибо, что занёс вещи. Ты здорово помог!"

# ch/samantha/events.rpy:2729
translate russian samantha_event_02_4ab9de91:
    mike.say "Да без проблем. Рад помочь тебе с этим разобраться. Но не думай, что я забуду о бесплатном кофе."

# ch/samantha/events.rpy:2731
translate russian samantha_event_02_902dce82:
    samantha.say "Я держу своё слово."

# ch/samantha/events.rpy:2732
translate russian samantha_event_02_a0ed975d:
    "Какое-то время мы смотрим друг на друга, и я замечаю в её глазах беспокойство."

# ch/samantha/events.rpy:2733
translate russian samantha_event_02_488aed14:
    mike.say "Что-то не так?"

# ch/samantha/events.rpy:2734
translate russian samantha_event_02_3c80fbeb:
    "Проходит минута. Она пытается подобрать слова, но вместо этого просто берёт меня за руки."

# ch/samantha/events.rpy:2735
translate russian samantha_event_02_1343f3cc:
    samantha.say "Обещай никому не говорить."

# ch/samantha/events.rpy:2736
translate russian samantha_event_02_371b8676:
    mike.say "..."

# ch/samantha/events.rpy:2737
translate russian samantha_event_02_a25a0fe0:
    mike.say "Конечно."

# ch/samantha/events.rpy:2738
translate russian samantha_event_02_bc72827e:
    samantha.say "Ну..."

# ch/samantha/events.rpy:2739
translate russian samantha_event_02_d6e5870e:
    "Саманта поднимает руку, показывая пальцы."

# ch/samantha/events.rpy:2740
translate russian samantha_event_02_80d4bbbe:
    "Только тогда я замечаю блестящее золотое кольцо на её безымянном пальце."

# ch/samantha/events.rpy:2741
translate russian samantha_event_02_e4d3a596:
    "Снова взглянув ей в лицо, я вижу в глазах слёзы радости."

# ch/samantha/events.rpy:2743
translate russian samantha_event_02_fee1c2f9:
    samantha.say "Райан сделал мне предложение!"

# ch/samantha/events.rpy:2744
translate russian samantha_event_02_371b8676_1:
    mike.say "..."

# ch/samantha/events.rpy:2745
translate russian samantha_event_02_306e1d6e:
    "Я не знаю, что сказать. От этой новости сердце падает. Неужели Райан теперь окончательно забирает у меня Сэм?"

# ch/samantha/events.rpy:2746
translate russian samantha_event_02_fa1cd49a:
    samantha.say "Он просил пока сохранить это в тайне, но я больше не могу молчать!"

# ch/samantha/events.rpy:2750
translate russian samantha_event_02_620b1976:
    mike.say "...Это здорово, Кексик! Уверен, вы будете счастливы вместе."

# ch/samantha/events.rpy:2752
translate russian samantha_event_02_b9f3307f:
    mike.say "...Это здорово, Сэм! Уверен, вы будете счастливы вместе."

# ch/samantha/events.rpy:2754
translate russian samantha_event_02_e300fa64:
    samantha.say "Спасибо! Мне так с ним повезло."

# ch/samantha/events.rpy:2755
translate russian samantha_event_02_fc261346:
    mike.say "Надеюсь, меня пригласят на свадьбу."

# ch/samantha/events.rpy:2756
translate russian samantha_event_02_4f430f78:
    samantha.say "Ха-ха, конечно. Ты будешь первым в списке!"

# ch/samantha/events.rpy:2758
translate russian samantha_event_02_d4467c64:
    "В кармане вибрирует телефон. Я смотрю на время — уже довольно поздно. Интересно, что так задержало Райана?"

# ch/samantha/events.rpy:2760
translate russian samantha_event_02_7da56504:
    samantha.say "Я слишком долго тебя задерживаю, да? Прости! Тебе пора домой."

# ch/samantha/events.rpy:2761
translate russian samantha_event_02_f91255e3:
    mike.say "Ты права. Завтра на работу, так что я пойду."

# ch/samantha/events.rpy:2763
translate russian samantha_event_02_13bd812c:
    "Мы направляемся к двери. Саманта провожает меня, но сначала крепко обнимает."

# ch/samantha/events.rpy:2764
translate russian samantha_event_02_0fcb3719:
    samantha.say "Огромное спасибо, [lssb_samantha.hero_name()]!"

# ch/samantha/events.rpy:2767
translate russian samantha_event_02_c740e3d2:
    mike.say "Не знаю... Не думаешь, что вы слишком молоды для такой спешки? Вы ведь только съехались. А если вам не понравится?"

# ch/samantha/events.rpy:2769
translate russian samantha_event_02_20ada60b:
    samantha.say "В смысле? Мы любим друг друга. Только это и важно, правда?"

# ch/samantha/events.rpy:2770
translate russian samantha_event_02_2dda55b4:
    mike.say "По-моему, вы не думаете как следует."

# ch/samantha/events.rpy:2772
translate russian samantha_event_02_7e138424:
    "На лице Саманты — боль, словно я её предал. Она доверила мне то, что так долго скрывала, а я взял и растоптал её мечту."

# ch/samantha/events.rpy:2773
translate russian samantha_event_02_a0ec0aa3:
    samantha.say "Я всегда хотела быть с ним вот так. Я счастлива, он счастлив, и мне этого достаточно. Тебе, наверное, лучше уйти. Спасибо за помощь сегодня."

# ch/samantha/events.rpy:2774
translate russian samantha_event_02_23a3b2cf:
    "Не сказав больше ни слова, она провожает меня до двери. Я даже не успеваю попрощаться, как та уже захлопывается за спиной."

# ch/samantha/events.rpy:2785
translate russian samantha_event_03_ddf4c823:
    "Войдя в парк, я оглядываюсь. Тут и там отдыхают компании людей."

# ch/samantha/events.rpy:2787
translate russian samantha_event_03_32a39de7:
    "Вдруг я замечаю Саманту: она сидит одна за столиком под деревом."

# ch/samantha/events.rpy:2788
translate russian samantha_event_03_e0dbb81d:
    "Она склонилась над книгой, а по столу разбросаны листы бумаги."

# ch/samantha/events.rpy:2789
translate russian samantha_event_03_83b5fd57:
    "Я подхожу, но она, кажется, меня не замечает: слишком поглощена работой."

# ch/samantha/events.rpy:2790
translate russian samantha_event_03_cb10e44c:
    "Заглянув ей через плечо, я вижу карандашные записи и пометки."

# ch/samantha/events.rpy:2791
translate russian samantha_event_03_add20eda:
    "Она всё ещё не замечает меня."

# ch/samantha/events.rpy:2795
translate russian samantha_event_03_4dbec03a:
    "Саманта поднимает голову, оборачивается и тепло мне улыбается."

# ch/samantha/events.rpy:2796
translate russian samantha_event_03_fbdf318c:
    samantha.say "Привет, [lssb_samantha.hero_name()]! Не ожидала тебя здесь увидеть."

# ch/samantha/events.rpy:2797
translate russian samantha_event_03_1c5890d2:
    "Я сажусь напротив."

# ch/samantha/events.rpy:2800
translate russian samantha_event_03_a78b1a3d:
    "Я резко кладу руки ей на плечи и чувствую, как она вздрагивает от неожиданности."

# ch/samantha/events.rpy:2801
translate russian samantha_event_03_407af144:
    "Карандаш в её руке дёргается, перечёркивая запись длинной линией."

# ch/samantha/events.rpy:2802
translate russian samantha_event_03_efc0da24:
    samantha.say "Ай!"

# ch/samantha/events.rpy:2803
translate russian samantha_event_03_8e4978e3:
    "Я тихонько смеюсь над её реакцией."

# ch/samantha/events.rpy:2805
translate russian samantha_event_03_23415891:
    "Но улыбка немного меркнет, когда я замечаю, что она расстроилась."

# ch/samantha/events.rpy:2806
translate russian samantha_event_03_9d043bbf:
    samantha.say "[lssb_samantha.hero_name()]?! Это не смешно!"

# ch/samantha/events.rpy:2807
translate russian samantha_event_03_38a8da59:
    "Она откидывается назад и пытается меня шлёпнуть, но я отступаю."

# ch/samantha/events.rpy:2808
translate russian samantha_event_03_ad7da526:
    mike.say "Прости, прости!"

# ch/samantha/events.rpy:2810
translate russian samantha_event_03_d257555b:
    "Я смущённо сажусь напротив."

# ch/samantha/events.rpy:2812
translate russian samantha_event_03_f90453ee:
    mike.say "Над чем работаешь?"

# ch/samantha/events.rpy:2814
translate russian samantha_event_03_846b0321:
    samantha.say "Да так, домашнее задание."

# ch/samantha/events.rpy:2815
translate russian samantha_event_03_e0654138:
    "На её лице написано раздражение."

# ch/samantha/events.rpy:2816
translate russian samantha_event_03_241e7d78:
    "Похоже, ей непросто."

# ch/samantha/events.rpy:2820
translate russian samantha_event_03_7bb8b012:
    samantha.say "Нет, я...!"

# ch/samantha/events.rpy:2822
translate russian samantha_event_03_f56c8b62:
    "Она пытается что-то сказать, но в конце концов сникает."

# ch/samantha/events.rpy:2823
translate russian samantha_event_03_0ba07d09:
    "Кажется, моё замечание её не обрадовало."

# ch/samantha/events.rpy:2824
translate russian samantha_event_03_a6f80898:
    samantha.say "Наверное... Если ты разбираешься в этом предмете, может, поможешь мне?"

# ch/samantha/events.rpy:2828
translate russian samantha_event_03_1d7b17f6:
    "Сэм поджимает губы, но затем её лицо смягчается."

# ch/samantha/events.rpy:2829
translate russian samantha_event_03_b67aff44:
    samantha.say "Знаешь что... Да. Не помешало бы немного подсказать. Спасибо!"

# ch/samantha/events.rpy:2832
translate russian samantha_event_03_d4815399:
    samantha.say "Ага... Спасибо. Тогда увидимся."

# ch/samantha/events.rpy:2836
translate russian samantha_event_03_3a71f73b:
    "Сэм протягивает мне лист, на котором писала. Он весь исписан заметками и пронумерованными задачами."

# ch/samantha/events.rpy:2839
translate russian samantha_event_03_8a783e09:
    "Похоже на статистику. Помню, это один из её обязательных курсов. Наверное, поэтому он ей и не особо нравится."

# ch/samantha/events.rpy:2840
translate russian samantha_event_03_d56b6108:
    mike.say "Статистика, да? Помню, я её проходил. Не очень любил этот предмет. Хотя, если подумать, много чего не любил."

# ch/samantha/events.rpy:2841
translate russian samantha_event_03_4a6085e8:
    samantha.say "Вот-вот! Мне она тоже не очень нравится."

# ch/samantha/events.rpy:2842
translate russian samantha_event_03_2b1f5799:
    mike.say "Ладно... Начнём отсюда."

# ch/samantha/events.rpy:2843
translate russian samantha_event_03_fc6d1f89:
    "Я беру карандаш Саманты и слегка постукиваю им по одной из цифр на листе. Сэм наклоняется над столом, чтобы посмотреть."

# ch/samantha/events.rpy:2844
translate russian samantha_event_03_27b95b33:
    "Светлые волосы обрамляют её лицо, а руки сложены под грудью."

# ch/samantha/events.rpy:2845
translate russian samantha_event_03_b75ea427:
    mike.say "Эм..."

# ch/samantha/events.rpy:2846
translate russian samantha_event_03_6ae4043c:
    "Я стараюсь не опускать взгляд и снова сосредотачиваюсь."

# ch/samantha/events.rpy:2847
translate russian samantha_event_03_3fba4f88:
    mike.say "Ну, первая ошибка у тебя вот здесь..."

# ch/samantha/events.rpy:2852
translate russian samantha_event_03_629a4758:
    mike.say "Понятно?"

# ch/samantha/events.rpy:2853
translate russian samantha_event_03_db3aa98c:
    "Саманта всё это время не сводит с меня глаз. Приятно безраздельно владеть её вниманием, которое обычно достаётся Райану."

# ch/samantha/events.rpy:2854
translate russian samantha_event_03_d26125a2:
    samantha.say "Кажется, да."

# ch/samantha/events.rpy:2855
translate russian samantha_event_03_c2a34824:
    "Я возвращаю ей карандаш. Она бережно берёт его, словно я только что его освятил."

# ch/samantha/events.rpy:2856
translate russian samantha_event_03_c5826760:
    mike.say "Попробуй решить следующую задачу."

# ch/samantha/events.rpy:2857
translate russian samantha_event_03_adc3661a:
    "Она кивает, и на лице появляется решимость. Медленно записывает решение, а закончив, поворачивает лист ко мне."

# ch/samantha/events.rpy:2858
translate russian samantha_event_03_b11da579:
    "Просмотрев его, я понимаю, что решение неверное."

# ch/samantha/events.rpy:2864
translate russian samantha_event_03_dfbee7c4:
    samantha.say "Я слушала! Прости. Просто, наверное, не понимаю."

# ch/samantha/events.rpy:2865
translate russian samantha_event_03_0988667c:
    mike.say "В этот раз постарайся быть внимательнее."

# ch/samantha/events.rpy:2866
translate russian samantha_event_03_07910095:
    "Я снова объясняю всё, что могу, на этот раз быстрее. Кажется, она путается ещё сильнее, и я сбавляю темп."

# ch/samantha/events.rpy:2867
translate russian samantha_event_03_134651cc:
    mike.say "Поняла?"

# ch/samantha/events.rpy:2868
translate russian samantha_event_03_bf0262bf:
    "Она берёт карандаш и переходит к следующей задаче. Уже лучше, но несколько ошибок всё же есть."

# ch/samantha/events.rpy:2869
translate russian samantha_event_03_feea4dcf:
    mike.say "Нет... Попробуй ещё раз."

# ch/samantha/events.rpy:2870
translate russian samantha_event_03_204c115f:
    "Сэм стонет и проводит рукой по волосам."

# ch/samantha/events.rpy:2871
translate russian samantha_event_03_134a5261:
    samantha.say "По-моему, у меня не получится!"

# ch/samantha/events.rpy:2872
translate russian samantha_event_03_eff97544:
    "Она закрывает книги и начинает собирать вещи."

# ch/samantha/events.rpy:2873
translate russian samantha_event_03_101ff463:
    mike.say "Что? Может, попробуем ещё раз?"

# ch/samantha/events.rpy:2874
translate russian samantha_event_03_9f3f7d81:
    samantha.say "Нет, всё нормально. Я останусь после занятий и попрошу кого-нибудь из преподавателей объяснить."

# ch/samantha/events.rpy:2875
translate russian samantha_event_03_d93430ad:
    mike.say "После занятий? Разве тебе вечером не на работу?"

# ch/samantha/events.rpy:2876
translate russian samantha_event_03_b33a1496:
    samantha.say "Да, но я не могу завалить этот курс. Мне нужны хорошие оценки, чтобы родители были довольны, понимаешь?"

# ch/samantha/events.rpy:2877
translate russian samantha_event_03_df8e17df:
    mike.say "А, ладно. Жаль, что не смог помочь."

# ch/samantha/events.rpy:2879
translate russian samantha_event_03_ed7013c9:
    samantha.say "Ничего! Спасибо, что хотел помочь."

# ch/samantha/events.rpy:2881
translate russian samantha_event_03_cb87ad8e:
    "Я легко исправляю её решение и объясняю каждый шаг."

# ch/samantha/events.rpy:2883
translate russian samantha_event_03_92e7a272:
    samantha.say "А-а!.. Поняла. Спасибо!"

# ch/samantha/events.rpy:2884
translate russian samantha_event_03_f38f3b4d:
    mike.say "Реши следующую."

# ch/samantha/events.rpy:2886
translate russian samantha_event_03_a5526042:
    samantha.say "Ладно..."

# ch/samantha/events.rpy:2887
translate russian samantha_event_03_e698dad7:
    samantha.say "..."

# ch/samantha/events.rpy:2888
translate russian samantha_event_03_e93ffa01:
    samantha.say "Вот так?"

# ch/samantha/events.rpy:2889
translate russian samantha_event_03_fdf9aa9c:
    "Я просматриваю её решение."

# ch/samantha/events.rpy:2890
translate russian samantha_event_03_3d5a1fa3:
    mike.say "Да, отлично! Молодец."

# ch/samantha/events.rpy:2892
translate russian samantha_event_03_2dc41328:
    "Она радостно хлопает в ладоши, и её лицо буквально сияет."

# ch/samantha/events.rpy:2893
translate russian samantha_event_03_f1dadf19:
    samantha.say "Ура! Кажется, теперь я справлюсь. Огромное спасибо!"

# ch/samantha/events.rpy:2894
translate russian samantha_event_03_b1c2b92d:
    mike.say "Без проблем."

# ch/samantha/events.rpy:2895
translate russian samantha_event_03_39381d44:
    samantha.say "Серьёзно, тебе бы в преподаватели."

# ch/samantha/events.rpy:2896
translate russian samantha_event_03_10b3a285:
    mike.say "Ха-ха... Не думаю, что мне это подходит."

# ch/samantha/events.rpy:2897
translate russian samantha_event_03_278356e6:
    mike.say "...Разве Райан не должен был заниматься вместе с тобой?"

# ch/samantha/events.rpy:2899
translate russian samantha_event_03_b0325795:
    samantha.say "Ах. Он в последнее время очень занят. Даже по ночам домой не приходит. Боюсь, он переутомляется. Не хотелось его беспокоить."

# ch/samantha/events.rpy:2900
translate russian samantha_event_03_ef34eb8b:
    mike.say "Жаль. Вам стоит чаще бывать вместе."

# ch/samantha/events.rpy:2904
translate russian samantha_event_03_ce2a9847:
    "Саманта сияет, и я замечаю румянец на её щеках."

# ch/samantha/events.rpy:2905
translate russian samantha_event_03_a2a4e41f:
    samantha.say "Спасибо, [lssb_samantha.hero_name()]. Я очень тебе благодарна."

# ch/samantha/events.rpy:2908
translate russian samantha_event_03_f85aabf4:
    samantha.say "Ты прав. Прости, если я тебя отвлекла."

# ch/samantha/events.rpy:2911
translate russian samantha_event_03_2acd7635:
    mike.say "Нет, мне было приятно, правда. Просто думаю, вам стоит чаще видеться, раз вы собираетесь пожениться."

# ch/samantha/events.rpy:2913
translate russian samantha_event_03_30ec66c1:
    samantha.say "Да! Это точно. Ты всегда знаешь, что сказать, да?"

# ch/samantha/events.rpy:2916
translate russian samantha_event_03_19be134c:
    samantha.say "В следующий раз останусь после занятий. Может, у преподавателя найдётся для меня время."

# ch/samantha/events.rpy:2919
translate russian samantha_event_03_bebd7edb:
    samantha.say "Ну, мне пора."

# ch/samantha/events.rpy:2921
translate russian samantha_event_03_f9064909:
    "Я толком не понимаю, на что смотрю. Это какая-то математика, да? Страница усеяна цифрами и символами, которые в моей голове никак не складываются во что-то осмысленное."

# ch/samantha/events.rpy:2922
translate russian samantha_event_03_bc743914:
    mike.say "Эм... Математика?"

# ch/samantha/events.rpy:2923
translate russian samantha_event_03_c929659c:
    samantha.say "Ага! Знаю, ты в ней не очень силён, так что можешь не помогать."

# ch/samantha/events.rpy:2924
translate russian samantha_event_03_77d2ded4:
    "Я бы изобразил обиду, но понимаю, что она сказала это без всякой злобы. К тому же она права."

# ch/samantha/events.rpy:2925
translate russian samantha_event_03_694a7651:
    "А ещё она даёт мне возможность отступить."

# ch/samantha/events.rpy:2926
translate russian samantha_event_03_010d29b3:
    mike.say "Нет, я всё равно могу помочь! Просто понадобится чуть больше времени. Но ведь одна голова хорошо, а две лучше?"

# ch/samantha/events.rpy:2928
translate russian samantha_event_03_41a55b88:
    samantha.say "Да, ладно! Давай!"

# ch/samantha/events.rpy:2930
translate russian samantha_event_03_c843b8f9:
    "Я мысленно ругаю себя. Надо было воспользоваться возможностью отказаться — ничем хорошим это не кончится."

# ch/samantha/events.rpy:2931
translate russian samantha_event_03_e1f3bccd:
    samantha.say "Знаешь, как решить вот эту часть? Я всё время ошибаюсь."

# ch/samantha/events.rpy:2932
translate russian samantha_event_03_4a86eac4:
    "Она указывает на какое-то, с виду случайное, место на странице. Я смотрю туда, пытаясь придумать ответ."

# ch/samantha/events.rpy:2935
translate russian samantha_event_03_0ca33113:
    mike.say "Хм, да... А зачем ты вообще пришла сюда заниматься?"

# ch/samantha/events.rpy:2936
translate russian samantha_event_03_69f8c395:
    "Сэм вопросительно поднимает бровь, но отвечает."

# ch/samantha/events.rpy:2937
translate russian samantha_event_03_d7d62e3d:
    samantha.say "Потому что не люблю целыми днями сидеть взаперти! Не могу же я ходить только из университета в пекарню и домой."

# ch/samantha/events.rpy:2939
translate russian samantha_event_03_f5d12371:
    samantha.say "Я бы с ума сошла! Да и Райан всё равно редко бывает дома."

# ch/samantha/events.rpy:2940
translate russian samantha_event_03_e698dad7_1:
    samantha.say "..."

# ch/samantha/events.rpy:2941
translate russian samantha_event_03_cd5f5ada:
    samantha.say "Ты вообще не понимаешь, да?"

# ch/samantha/events.rpy:2942
translate russian samantha_event_03_a2c2108f:
    mike.say "Что? Я... эм... Нет."

# ch/samantha/events.rpy:2944
translate russian samantha_event_03_f7b7551d:
    "К моему удивлению, Саманта хихикает."

# ch/samantha/events.rpy:2945
translate russian samantha_event_03_7849d184:
    samantha.say "Ну, с твоей стороны мило было предложить помощь."

# ch/samantha/events.rpy:2947
translate russian samantha_event_03_4fa739e9:
    samantha.say "Может, попросить кого-нибудь из преподавателей? Но они всегда заняты."

# ch/samantha/events.rpy:2948
translate russian samantha_event_03_41ccb2a9:
    mike.say "А Райан?"

# ch/samantha/events.rpy:2949
translate russian samantha_event_03_10ec26d2:
    samantha.say "Уходит утром на работу и возвращается поздно. Не хочу его нагружать."

# ch/samantha/events.rpy:2951
translate russian samantha_event_03_dfa60a89:
    mike.say "Да брось, Кексик. Уж ты-то точно его не нагрузишь. Ты ведь говорила, что он собирался с тобой заниматься."

# ch/samantha/events.rpy:2953
translate russian samantha_event_03_f304f081:
    mike.say "Да брось, Сэм. Уж ты-то точно его не нагрузишь. Ты ведь говорила, что он собирался с тобой заниматься."

# ch/samantha/events.rpy:2954
translate russian samantha_event_03_d24cdf4c:
    samantha.say "Ладно, в этом что-то есть."

# ch/samantha/events.rpy:2955
translate russian samantha_event_03_fd307a84:
    samantha.say "В следующий раз попрошу его! Спасибо, [lssb_samantha.hero_name()]!"

# ch/samantha/events.rpy:2957
translate russian samantha_event_03_e1d914e5:
    mike.say "Хм..."

# ch/samantha/events.rpy:2959
translate russian samantha_event_03_b36fabb1:
    mike.say "Попробуй взять вот эти значения в качестве делимого."

# ch/samantha/events.rpy:2961
translate russian samantha_event_03_dfa2db6f:
    samantha.say "Это сработает?"

# ch/samantha/events.rpy:2962
translate russian samantha_event_03_806cc9e5:
    mike.say "Наверное."

# ch/samantha/events.rpy:2964
translate russian samantha_event_03_3cd6a004:
    "Саманта хихикает над моим уверенным ответом, но всё же следует совету."

# ch/samantha/events.rpy:2965
translate russian samantha_event_03_77ac8600:
    samantha.say "Не-а! Что-то не то."

# ch/samantha/events.rpy:2966
translate russian samantha_event_03_1a268f55:
    mike.say "Ну вот, я внёс свой вклад."

# ch/samantha/events.rpy:2967
translate russian samantha_event_03_4b04ecc0:
    samantha.say "Неплохая попытка!"

# ch/samantha/events.rpy:2968
translate russian samantha_event_03_6510f2db:
    mike.say "Что тут скажешь? Я мастер своего дела."

# ch/samantha/events.rpy:2970
translate russian samantha_event_03_50158ebf:
    "Мы с Самантой смеёмся, и она со вздохом закрывает книгу."

# ch/samantha/events.rpy:2971
translate russian samantha_event_03_e4bff1eb:
    samantha.say "А ты чем занимаешься? Не ожидала тебя сегодня увидеть."

# ch/samantha/events.rpy:2972
translate russian samantha_event_03_a4ad9dce:
    mike.say "Да просто искал, с кем провести время. Повезло, что встретил тебя."

# ch/samantha/events.rpy:2973
translate russian samantha_event_03_5e44d81c:
    samantha.say "Ещё бы! Ну, хоть отвлечёшь меня от домашки, да?"

# ch/samantha/events.rpy:2974
translate russian samantha_event_03_3f082ad3:
    mike.say "Я бы так не сказал. Если не хочешь заниматься, давай сходим куда-нибудь ещё."

# ch/samantha/events.rpy:2975
translate russian samantha_event_03_cf1488fb:
    samantha.say "Заманчиво! Но мне скоро нужно домой."

# ch/samantha/events.rpy:2978
translate russian samantha_event_03_13ac01f4:
    mike.say "Эм... Можно попробовать вот эти... цифры? А почему тут буквы?"

# ch/samantha/events.rpy:2980
translate russian samantha_event_03_399c6283:
    "Саманта смеётся и убирает прядь за ухо."

# ch/samantha/events.rpy:2981
translate russian samantha_event_03_f13740cb:
    samantha.say "Ты во многом хорош, [lssb_samantha.hero_name()], но статистика к этому не относится."

# ch/samantha/events.rpy:2982
translate russian samantha_event_03_27d1b1ea:
    mike.say "Ай, обидно!"

# ch/samantha/events.rpy:2984
translate russian samantha_event_03_6a4323ca:
    "Она шутливо закатывает глаза, закрывает книги и собирает вещи. Похоже, смирилась с тем, что сегодня ничего не закончит."

# ch/samantha/events.rpy:2985
translate russian samantha_event_03_6125079a:
    mike.say "А если серьёзно, прости, что не могу помочь."

# ch/samantha/events.rpy:2986
translate russian samantha_event_03_e08216c5:
    samantha.say "Не переживай. Я уже должна уметь это решать."

# ch/samantha/events.rpy:2987
translate russian samantha_event_03_d4d252c7:
    samantha.say "Но никак не могу сосредоточиться! Всё время думаю о Райане."

# ch/samantha/events.rpy:2988
translate russian samantha_event_03_4f20dcac:
    samantha.say "Он хочет поскорее пожениться, и мне уже не терпится начать подготовку."

# ch/samantha/events.rpy:2989
translate russian samantha_event_03_903a8b30:
    mike.say "Поскорее?"

# ch/samantha/events.rpy:2990
translate russian samantha_event_03_84757598:
    samantha.say "Он хочет всё устроить за несколько месяцев."

# ch/samantha/events.rpy:2991
translate russian samantha_event_03_d66032e5:
    mike.say "Несколько месяцев?! Это же безумие."

# ch/samantha/events.rpy:2993
translate russian samantha_event_03_d26b7a7d:
    samantha.say "Почему? Он меня любит. Я тоже хочу поскорее стать его женой."

# ch/samantha/events.rpy:2994
translate russian samantha_event_03_0f8e29c0:
    "Я качаю головой, но на этот раз молчу. Если они и правда решили торопиться, мои слова их ни на секунду не остановят."

# ch/samantha/events.rpy:2995
translate russian samantha_event_03_bebd7edb_1:
    samantha.say "Ну, мне пора."

# ch/samantha/events.rpy:2997
translate russian samantha_event_03_2b87d8ae:
    mike.say "Ладно. Ещё увидимся?"

# ch/samantha/events.rpy:2998
translate russian samantha_event_03_0cd5e943:
    samantha.say "Обязательно! Мне нужно за покупками, можем тогда встретиться. Надо купить кое-что для нового дома."

# ch/samantha/events.rpy:2999
translate russian samantha_event_03_4ddcc4ec:
    "Походы по магазинам с Самантой обычно означают книги или одежду. Не самое увлекательное занятие, но я не против, если это не затянется на вечность."

# ch/samantha/events.rpy:3000
translate russian samantha_event_03_246c665f:
    mike.say "Конечно... Хорошо."

# ch/samantha/events.rpy:3001
translate russian samantha_event_03_db32fedc:
    "Она, видимо, замечает мой слабый энтузиазм и упирает руки в бока."

# ch/samantha/events.rpy:3002
translate russian samantha_event_03_025c209d:
    samantha.say "Ещё я собираюсь потусоваться. Ну, выпивка, танцы... Как тебе такое?"

# ch/samantha/events.rpy:3003
translate russian samantha_event_03_46844f67:
    mike.say "Вот это я точно могу."

# ch/samantha/events.rpy:3004
translate russian samantha_event_03_37b77b24:
    samantha.say "Я так и думала. Но если будет время, сходи со мной и за покупками. На этот раз я иду не в обычное место. Будет весело!"

# ch/samantha/events.rpy:3005
translate russian samantha_event_03_9f9d4b32:
    "Она подмигивает, а я лишь растерянно моргаю в ответ."

# ch/samantha/events.rpy:3006
translate russian samantha_event_03_2a32fa1f:
    "Наверное, в следующий раз узнаю, что это значит."

# ch/samantha/events.rpy:3007
translate russian samantha_event_03_b20e8546:
    samantha.say "Тогда до встречи, [lssb_samantha.hero_name()]!"

# ch/samantha/events.rpy:3010
translate russian samantha_event_03_f11b3eef:
    "Собрав вещи в охапку, она направляется к выходу и машет рукой. Я машу в ответ, провожая её взглядом."

# ch/samantha/events.rpy:3012
translate russian samantha_event_03_fe8c4a92:
    "Я снова понуро опускаюсь к столу. Становится скучно. Чем теперь заняться?"

# ch/samantha/events.rpy:3018
translate russian samantha_event_04_b405130e:
    "В ночном клубе оказалось люднее, чем я ожидал."

# ch/samantha/events.rpy:3019
translate russian samantha_event_04_53858985:
    "Кажется, он открылся всего час назад, а люди уже вовсю двигаются под музыку с выпивкой в руках."

# ch/samantha/events.rpy:3020
translate russian samantha_event_04_284961ae:
    "Я протискиваюсь вдоль танцпола к бару в глубине зала."

# ch/samantha/events.rpy:3021
translate russian samantha_event_04_3800ae68:
    "Сажусь, заказываю выпивку и жду."

# ch/samantha/events.rpy:3022
translate russian samantha_event_04_8dacef1f:
    "Рассеянно листаю список контактов в телефоне."

# ch/samantha/events.rpy:3023
translate russian samantha_event_04_fea44eae:
    "Может, снова позвонить Сэм и предложить встретиться?"

# ch/samantha/events.rpy:3024
translate russian samantha_event_04_638ecf9f:
    "С ней точно станет веселее."

# ch/samantha/events.rpy:3025
translate russian samantha_event_04_ef8532ac:
    "Но она, наверное, с Райаном."

# ch/samantha/events.rpy:3026
translate russian samantha_event_04_6bb9b32a:
    ryan.say "Привет. Тебе что-нибудь заказать?"

# ch/samantha/events.rpy:3027
translate russian samantha_event_04_3949542c:
    "Словно подслушав мои мысли, неподалёку раздаётся голос Райана."

# ch/samantha/events.rpy:3031
translate russian samantha_event_04_b98253e4:
    "Я резко поднимаю голову и вижу его на другом конце длинной стойки, рядом с пышногрудой девушкой с шелковистыми чёрными волосами."

# ch/samantha/events.rpy:3032
translate russian samantha_event_04_7aed8091:
    "Девушка" "Райан! Не думала, что сегодня тебя увижу."

# ch/samantha/events.rpy:3033
translate russian samantha_event_04_4fd8aa96:
    "Девушка встаёт и бросается обнимать Райана."

# ch/samantha/events.rpy:3034
translate russian samantha_event_04_314c1ee6:
    "Во мне невольно просыпаются подозрения."

# ch/samantha/events.rpy:3035
translate russian samantha_event_04_75976f62:
    "Что происходит?"

# ch/samantha/events.rpy:3037
translate russian samantha_event_04_9de22ff7:
    ryan.say "Конечно, детка. Не могу же я оставить тебя здесь трезвой."

# ch/samantha/events.rpy:3038
translate russian samantha_event_04_b64ad356:
    "Девушка хихикает, прикрыв рот маленькой ладонью."

# ch/samantha/events.rpy:3039
translate russian samantha_event_04_34e51c80:
    "Она краснеет, пока бармен придвигает к ним яркий коктейль."

# ch/samantha/events.rpy:3040
translate russian samantha_event_04_3a4d44a4:
    "Одной рукой девушка берёт бокал, а другой обхватывает руку Райана и зажимает её между грудей."

# ch/samantha/events.rpy:3041
translate russian samantha_event_04_92f142cc:
    "Девушка" "Чем ты занимался всю неделю? Уже несколько вечеров тебя не видела."

# ch/samantha/events.rpy:3042
translate russian samantha_event_04_085cc220:
    ryan.say "Да так. Работал."

# ch/samantha/events.rpy:3043
translate russian samantha_event_04_3b2c0af0:
    "Девушка" "Ты слишком много работаешь. Проводил бы больше времени со мной!"

# ch/samantha/events.rpy:3044
translate russian samantha_event_04_58dc8a57:
    ryan.say "А на что же я буду тебя баловать?"

# ch/samantha/events.rpy:3045
translate russian samantha_event_04_c1e4a3d0:
    "Девушка снова хихикает и прижимается к нему ещё теснее."

# ch/samantha/events.rpy:3046
translate russian samantha_event_04_3d033f92:
    "Девушка" "Может, мне просто ждать тебя дома? Тебе не придётся никуда ехать, и мы сможем развлекаться всю ночь."

# ch/samantha/events.rpy:3047
translate russian samantha_event_04_5776aaaf:
    ryan.say "Не-е, тебе не понравится моя паршивая квартира. Да и живу я с соседями. Не хочу, чтобы они тебя у меня увели."

# ch/samantha/events.rpy:3048
translate russian samantha_event_04_c9b4db88:
    "Девушка" "Райан! Никто меня у тебя не уведёт."

# ch/samantha/events.rpy:3049
translate russian samantha_event_04_8d0f4f8c:
    "Я смотрю на них широко раскрытыми глазами."

# ch/samantha/events.rpy:3050
translate russian samantha_event_04_c7997f0d:
    "Не может быть, чтобы это происходило на самом деле."

# ch/samantha/events.rpy:3051
translate russian samantha_event_04_4ce7499a:
    "Да, Райан придурок, но они с Самантой были самой счастливой парой из всех, кого я знал..."

# ch/samantha/events.rpy:3052
translate russian samantha_event_04_6ca8b59d:
    "Видимо, всё-таки нет."

# ch/samantha/events.rpy:3053
translate russian samantha_event_04_036a308a:
    "Пока они продолжают разговаривать, подозрение во мне сменяется гневом."

# ch/samantha/events.rpy:3054
translate russian samantha_event_04_cea51bbf:
    "Как он может так поступать с Сэм?"

# ch/samantha/events.rpy:3055
translate russian samantha_event_04_a86e22d1:
    "Как вообще можно так поступать с такой милой девушкой?"

# ch/samantha/events.rpy:3056
translate russian samantha_event_04_d8dd5cc9:
    "Бармен подаёт мой напиток, но я держу его словно онемевшими руками."

# ch/samantha/events.rpy:3057
translate russian samantha_event_04_4d75ca5c:
    "Саманта ни за что не поверит, если я просто расскажу ей."

# ch/samantha/events.rpy:3058
translate russian samantha_event_04_e243f399:
    "Я растерянно смотрю на телефон, затем снова на Райана."

# ch/samantha/events.rpy:3059
translate russian samantha_event_04_f2157615:
    "Решение даётся легко: я поднимаю телефон и включаю камеру."

# ch/samantha/events.rpy:3060
translate russian samantha_event_04_ebe38fea:
    "Райан так увлечён прижавшейся к нему девушкой, что ничего не замечает."

# ch/samantha/events.rpy:3061
translate russian samantha_event_04_fdfcd480:
    "Я делаю несколько снимков."

# ch/samantha/events.rpy:3062
translate russian samantha_event_04_56838ae0:
    "Нельзя же просто отправить ей это без всяких объяснений?"

# ch/samantha/events.rpy:3063
translate russian samantha_event_04_194d2b21:
    "Она будет раздавлена."

# ch/samantha/events.rpy:3064
translate russian samantha_event_04_8685d69c:
    "Я должен быть рядом."

# ch/samantha/events.rpy:3065
translate russian samantha_event_04_4cf0605c:
    "Набираю её номер и подношу телефон к уху."

# ch/samantha/events.rpy:3067
translate russian samantha_event_04_a20cefa7:
    "..."

# ch/samantha/events.rpy:3068
translate russian samantha_event_04_ae75039b:
    "Голосовая почта. Телефон выключен?"

# ch/samantha/events.rpy:3069
translate russian samantha_event_04_ae9a3ad9:
    "Значит, придётся найти её позже."

# ch/samantha/events.rpy:3070
translate russian samantha_event_04_792c72c1:
    "Я бросаю на стойку несколько долларов с чаевыми и соскальзываю со стула."

# ch/samantha/events.rpy:3072
translate russian samantha_event_04_2222b794:
    "Почти выбегаю из клуба, опасаясь, что Райан меня заметит, если я задержусь."

# ch/samantha/events.rpy:3073
translate russian samantha_event_04_97c1fcb8:
    "Нужно найти Сэм."

# ch/samantha/events.rpy:3082
translate russian samantha_event_05_5b8ad43c:
    "Я правда хочу это сделать?"

# ch/samantha/events.rpy:3083
translate russian samantha_event_05_2c5853de:
    "Я разобью ей сердце."

# ch/samantha/events.rpy:3084
translate russian samantha_event_05_07d476df:
    "Она любит Райана всем своим существом."

# ch/samantha/events.rpy:3085
translate russian samantha_event_05_bceac5fa:
    "Я только причиню ей боль."

# ch/samantha/events.rpy:3086
translate russian samantha_event_05_50737cd3:
    "Не смогу смотреть, как она плачет из-за всего этого."

# ch/samantha/events.rpy:3089
translate russian samantha_event_05_e698dad7:
    samantha.say "..."

# ch/samantha/events.rpy:3090
translate russian samantha_event_05_b155a598:
    samantha.say "Что-то не так?"

# ch/samantha/events.rpy:3092
translate russian samantha_event_05_03c53eb5:
    mike.say "Кексик, я..."

# ch/samantha/events.rpy:3094
translate russian samantha_event_05_957363ef:
    mike.say "Сэм, я..."

# ch/samantha/events.rpy:3095
translate russian samantha_event_05_8744cf2b:
    "Как это сказать?"

# ch/samantha/events.rpy:3096
translate russian samantha_event_05_c59ac79a:
    mike.say "Я на днях был в ночном клубе."

# ch/samantha/events.rpy:3097
translate russian samantha_event_05_57d712ce:
    samantha.say "М-м? Познакомился с кем-нибудь приятным?"

# ch/samantha/events.rpy:3098
translate russian samantha_event_05_e7e41766:
    mike.say "Я видел Райана..."

# ch/samantha/events.rpy:3099
translate russian samantha_event_05_a7dcda98:
    mike.say "С другой девушкой."

# ch/samantha/events.rpy:3101
translate russian samantha_event_05_004d7984:
    samantha.say "...Это не смешно."

# ch/samantha/events.rpy:3102
translate russian samantha_event_05_27afc0fa:
    mike.say "Я серьёзно."

# ch/samantha/events.rpy:3104
translate russian samantha_event_05_7fc07a37:
    samantha.say "Бред!"

# ch/samantha/events.rpy:3105
translate russian samantha_event_05_8469aac4:
    samantha.say "Не говори такого!"

# ch/samantha/events.rpy:3106
translate russian samantha_event_05_e59d8d3a:
    "Я достаю телефон и разблокирую его."

# ch/samantha/events.rpy:3107
translate russian samantha_event_05_f7213e27:
    "Открываю фотографии и протягиваю ей."

# ch/samantha/events.rpy:3108
translate russian samantha_event_05_e217336e:
    "Она смотрит на снимок, всё ещё сохраняя твёрдое выражение лица."

# ch/samantha/events.rpy:3109
translate russian samantha_event_05_a8304713:
    "Часто моргает и наконец хмурится."

# ch/samantha/events.rpy:3111
translate russian samantha_event_05_a4eec36e:
    samantha.say "Это неправда."

# ch/samantha/events.rpy:3112
translate russian samantha_event_05_1036db79:
    samantha.say "Я... не понимаю."

# ch/samantha/events.rpy:3114
translate russian samantha_event_05_865cb011:
    "Она возвращает мне телефон..."

# ch/samantha/events.rpy:3115
translate russian samantha_event_05_2cc2702f:
    "Я молчу, пока её глаза не наполняются слезами."

# ch/samantha/events.rpy:3117
translate russian samantha_event_05_4c349763:
    mike.say "Ох, Кексик..."

# ch/samantha/events.rpy:3119
translate russian samantha_event_05_b5120446:
    mike.say "Ох, Сэм..."

# ch/samantha/events.rpy:3121
translate russian samantha_event_05_aaaa73c0:
    "Она закрывает лицо руками и рыдает."

# ch/samantha/events.rpy:3122
translate russian samantha_event_05_e046ad36:
    "У меня замирает сердце."

# ch/samantha/events.rpy:3123
translate russian samantha_event_05_c33035ea:
    "Что делать?"

# ch/samantha/events.rpy:3125
translate russian samantha_event_05_ea4b5bdb:
    "Я решаю обнять её за плечи, и она тут же прижимается ко мне."

# ch/samantha/events.rpy:3126
translate russian samantha_event_05_f23568bf:
    samantha.say "Скажи, что это неправда! Пожалуйста!"

# ch/samantha/events.rpy:3127
translate russian samantha_event_05_bdbd732a:
    "Я ничего не говорю, давая ей выплакаться."

# ch/samantha/events.rpy:3128
translate russian samantha_event_05_ab7123f1:
    samantha.say "Мне... Мне нужно идти."

# ch/samantha/events.rpy:3131
translate russian samantha_event_05_7dd5fe2f:
    "Она всхлипывает и резко встаёт."

# ch/samantha/events.rpy:3133
translate russian samantha_event_05_3f14feee:
    mike.say "Подожди, Кексик!"

# ch/samantha/events.rpy:3135
translate russian samantha_event_05_ad55af46:
    mike.say "Подожди, Сэм!"

# ch/samantha/events.rpy:3136
translate russian samantha_event_05_ecd023ae:
    "Я встаю и вздыхаю."

# ch/samantha/events.rpy:3137
translate russian samantha_event_05_3bd9fe72:
    "Если она захочет снова об этом поговорить, то заговорит. В этом я не сомневаюсь."

# ch/samantha/events.rpy:3141
translate russian samantha_event_05_696d2925:
    "Я не могу так с ней поступить."

# ch/samantha/events.rpy:3142
translate russian samantha_event_05_2c7e9983:
    "Лучше пусть думает, что Райан ей верен, правда?"

# ch/samantha/events.rpy:3143
translate russian samantha_event_05_ad5fad82:
    "Крепко сжав телефон, я ухожу без единого слова, оставляя её в счастливом неведении."

# ch/samantha/events.rpy:3159
translate russian samantha_event_A01_1a11e05e:
    "На мгновение я отвлекаюсь: в кармане вибрирует телефон."

# ch/samantha/events.rpy:3160
translate russian samantha_event_A01_ed73238c:
    "На экране имя Саманты."

# ch/samantha/events.rpy:3162
translate russian samantha_event_A01_d7c9c68d:
    mike.say "Алло? Кексик?"

# ch/samantha/events.rpy:3164
translate russian samantha_event_A01_fbbddf9e:
    mike.say "Алло? Сэм?"

# ch/samantha/events.rpy:3165
translate russian samantha_event_A01_f1186c1b:
    samantha.say "При-ивет."

# ch/samantha/events.rpy:3166
translate russian samantha_event_A01_a20cefa7:
    "..."

# ch/samantha/events.rpy:3167
translate russian samantha_event_A01_cee9c1ff:
    "Звучит не очень хорошо."

# ch/samantha/events.rpy:3169
translate russian samantha_event_A01_3ce3427c:
    mike.say "Кексик? Ты в порядке?"

# ch/samantha/events.rpy:3171
translate russian samantha_event_A01_5c36793a:
    mike.say "Саманта? Ты в порядке?"

# ch/samantha/events.rpy:3172
translate russian samantha_event_A01_ebe8425f:
    samantha.say "Лучше не бывает. Хочу тебя увидеть."

# ch/samantha/events.rpy:3173
translate russian samantha_event_A01_4cf775c5:
    mike.say "Что?"

# ch/samantha/events.rpy:3174
translate russian samantha_event_A01_1a95a223:
    samantha.say "Иди сюда!"

# ch/samantha/events.rpy:3175
translate russian samantha_event_A01_414ac8c8:
    mike.say "...Ты где?"

# ch/samantha/events.rpy:3176
translate russian samantha_event_A01_e506e5a4:
    samantha.say "У твоего дома. Стучала, но никто не открывает. Открой! Откро-ой!"

# ch/samantha/events.rpy:3177
translate russian samantha_event_A01_d9a3d136:
    mike.say "...Ладно. Сейчас буду."

# ch/samantha/events.rpy:3183
translate russian samantha_event_A01_7a1c0672:
    "Я смотрю на неё. Щёки красные, а пахнет от неё..."

# ch/samantha/events.rpy:3184
translate russian samantha_event_A01_6dab9b08:
    mike.say "Ты пьяна?"

# ch/samantha/events.rpy:3185
translate russian samantha_event_A01_24ef2f8d:
    samantha.say "Со-овсем чуть-чуть. Но я хорошая девочка."

# ch/samantha/events.rpy:3187
translate russian samantha_event_A01_9e320ed4:
    "Я не успеваю опомниться, как она наваливается на меня и утыкается лицом в рубашку."

# ch/samantha/events.rpy:3189
translate russian samantha_event_A01_6d2bef22:
    mike.say "Эм, Кексик?"

# ch/samantha/events.rpy:3191
translate russian samantha_event_A01_09974c1f:
    mike.say "Эм, Саманта?"

# ch/samantha/events.rpy:3192
translate russian samantha_event_A01_da11629a:
    samantha.say "Ты ведь всё ещё любишь меня?"

# ch/samantha/events.rpy:3193
translate russian samantha_event_A01_447ec157:
    samantha.say "Скажи, что любишь."

# ch/samantha/events.rpy:3196
translate russian samantha_event_A01_acbb0ffe:
    "Саманта хихикает, но смех переходит во всхлип."

# ch/samantha/events.rpy:3197
translate russian samantha_event_A01_584f7a39:
    samantha.say "Знаю, что любишь. Знаю."

# ch/samantha/events.rpy:3200
translate russian samantha_event_A01_7aa97267:
    "Саманта рыдает, уткнувшись в мою рубашку, и я чувствую, как ткань промокает от слёз."

# ch/samantha/events.rpy:3201
translate russian samantha_event_A01_f36cc35f:
    samantha.say "Любишь! Я знаю, что любишь!"

# ch/samantha/events.rpy:3203
translate russian samantha_event_A01_1907890c:
    mike.say "Кексик, ты же знаешь, я всегда буду твоим другом..."

# ch/samantha/events.rpy:3205
translate russian samantha_event_A01_771ddd67:
    mike.say "Саманта, ты же знаешь, я всегда буду твоим другом..."

# ch/samantha/events.rpy:3206
translate russian samantha_event_A01_d1ee9887:
    "Я отвожу её к дивану, и мы сидим там, пока она не засыпает, наплакавшись."

# ch/samantha/events.rpy:3209
translate russian samantha_event_A01_3fac494f:
    mike.say "Пойдём, Кексик. Подожди в моей комнате, я принесу воды."

# ch/samantha/events.rpy:3211
translate russian samantha_event_A01_44e19a4f:
    mike.say "Пойдём, Сэм. Подожди в моей комнате, я принесу воды."

# ch/samantha/events.rpy:3212
translate russian samantha_event_A01_9746fffd:
    "Я принимаю её вялый кивок за согласие и веду к своей комнате."

# ch/samantha/events.rpy:3216
translate russian samantha_event_A01_0426efc8:
    "Она садится на кровать с мутным, пустым взглядом."

# ch/samantha/events.rpy:3217
translate russian samantha_event_A01_d67a4868:
    mike.say "Я сейчас вернусь."

# ch/samantha/events.rpy:3221
translate russian samantha_event_A01_2be49714:
    "Беру стакан из шкафа и наполняю водой из-под крана."

# ch/samantha/events.rpy:3222
translate russian samantha_event_A01_43a762b3:
    "Я толком не знаю, как обращаться с пьяной Самантой."

# ch/samantha/events.rpy:3223
translate russian samantha_event_A01_c89bbca8:
    "Особенно с грустной."

# ch/samantha/events.rpy:3224
translate russian samantha_event_A01_b1ad0754:
    "Понятия не имею, что, чёрт возьми, делать."

# ch/samantha/events.rpy:3226
translate russian samantha_event_A01_14e5913f:
    mike.say "Вот. Я принёс тебе..."

# ch/samantha/events.rpy:3228
translate russian samantha_event_A01_780787aa:
    "Я обрываю себя на полуслове и чуть не роняю стакан."

# ch/samantha/events.rpy:3229
translate russian samantha_event_A01_9d4cb863:
    "Саманта лежит на моей кровати в одном белье и стягивает трусики."

# ch/samantha/events.rpy:3230
translate russian samantha_event_A01_7498aba5:
    samantha.say "Ты такой милый! Иди сюда, дай тебя отблагодарить!"

# ch/samantha/events.rpy:3231
translate russian samantha_event_A01_e80f5399:
    mike.say "Ты... Ты пьяна. Потом пожалеешь."

# ch/samantha/events.rpy:3232
translate russian samantha_event_A01_354d0e93:
    "Мне приходится собрать всю волю, чтобы не прыгнуть к ней в постель."

# ch/samantha/events.rpy:3233
translate russian samantha_event_A01_5e26c13c:
    samantha.say "Ты мне нужен! Ты же хочешь, чтобы мне стало лучше?"

# ch/samantha/events.rpy:3234
translate russian samantha_event_A01_90200563:
    "Я медлю. Саманта, похоже, замечает это и спускает трусики до колен."

# ch/samantha/events.rpy:3235
translate russian samantha_event_A01_09bbc82c:
    "Ноги несут меня быстрее, чем успевает сообразить голова."

# ch/samantha/events.rpy:3236
translate russian samantha_event_A01_09149ea8:
    "Когда я подхожу к краю кровати, она разводит ноги и обхватывает ими мою талию."

# ch/samantha/events.rpy:3237
translate russian samantha_event_A01_e0f533c0:
    samantha.say "Снимешь всё это?"

# ch/samantha/events.rpy:3238
translate russian samantha_event_A01_2103f76f:
    "Я опускаю взгляд и понимаю, что она говорит о моей одежде."

# ch/samantha/events.rpy:3239
translate russian samantha_event_A01_368cd49c:
    "Я словно в оцепенении расстёгиваю джинсы и отбрасываю рубашку через всю спальню."

# ch/samantha/events.rpy:3241
translate russian samantha_event_A01_26d6c5d3:
    "Видимо, я двигаюсь слишком медленно: она тянет меня ногами, и я падаю на неё."

# ch/samantha/events.rpy:3242
translate russian samantha_event_A01_e46e6ab2:
    "Опершись на локти по обе стороны её головы, я чувствую на лице её горячее дыхание."

# ch/samantha/events.rpy:3243
translate russian samantha_event_A01_b6adceea:
    "К её запаху примешивается отчётливый дух алкоголя."

# ch/samantha/events.rpy:3244
translate russian samantha_event_A01_4baf49c2:
    samantha.say "Ты сделаешь меня счастливой, правда?"

# ch/samantha/events.rpy:3245
translate russian samantha_event_A01_5bf69bef:
    samantha.say "Будь грубым, как мой милый."

# ch/samantha/events.rpy:3246
translate russian samantha_event_A01_ac9f0c49:
    samantha.say "Делай со мной что хочешь."

# ch/samantha/events.rpy:3247
translate russian samantha_event_A01_77453d90:
    "Её милый? Она о Райане?"

# ch/samantha/events.rpy:3250
translate russian samantha_event_A01_9f15f05a:
    "Я не отвечаю, лишь нежно прижимаюсь губами к её губам."

# ch/samantha/events.rpy:3251
translate russian samantha_event_A01_23d65b02:
    "Сначала она замирает, широко раскрыв глаза."

# ch/samantha/events.rpy:3252
translate russian samantha_event_A01_d5200cef:
    "Но постепенно тает в моих объятиях."

# ch/samantha/events.rpy:3253
translate russian samantha_event_A01_9754152e:
    "Она обвивает руками мою шею, и грудь переполняют чувства."

# ch/samantha/events.rpy:3254
translate russian samantha_event_A01_6380a3dc:
    "Наконец она со мной, и я могу её любить."

# ch/samantha/events.rpy:3255
translate russian samantha_event_A01_62e7c835:
    mike.say "Я буду с тобой нежен."

# ch/samantha/events.rpy:3256
translate russian samantha_event_A01_2024cca7:
    "Обхватив за талию, я подтягиваю её выше по кровати."

# ch/samantha/events.rpy:3257
translate russian samantha_event_A01_8f991149:
    "Она послушно позволяет себя передвинуть."

# ch/samantha/events.rpy:3258
translate russian samantha_event_A01_61f27792:
    "Теперь прикрыта только её грудь: трусики улетели куда-то на пол, когда она притянула меня к себе."

# ch/samantha/events.rpy:3259
translate russian samantha_event_A01_9e94f255:
    "Я осторожно завожу руку ей за спину и расстёгиваю бюстгальтер."

# ch/samantha/events.rpy:3260
translate russian samantha_event_A01_06297416:
    "Она слегка приподнимается, помогая мне."

# ch/samantha/events.rpy:3262
translate russian samantha_event_A01_d7bc0aa3:
    "Когда я снимаю его, большая грудь оказывается на свободе."

# ch/samantha/events.rpy:3263
translate russian samantha_event_A01_9c521f31:
    "В сосках у неё простые колечки."

# ch/samantha/events.rpy:3264
translate russian samantha_event_A01_d620bf29:
    samantha.say "Я надела их специально для тебя."

# ch/samantha/events.rpy:3265
translate russian samantha_event_A01_2e53adfa:
    "Не знаю, искренне она это говорит или слишком пьяна, чтобы соображать."

# ch/samantha/events.rpy:3266
translate russian samantha_event_A01_29e0d1bb:
    "Тем не менее я склоняюсь к одному из колечек и мягко втягиваю его губами."

# ch/samantha/events.rpy:3267
translate russian samantha_event_A01_8819af04:
    "Надо мной раздаётся тихий стон. Считаю это хорошим знаком."

# ch/samantha/events.rpy:3268
translate russian samantha_event_A01_e5fb3b85:
    "Я захватываю ртом больше её груди и сосу сильнее. Она выгибает спину, а я двигаюсь следом."

# ch/samantha/events.rpy:3269
translate russian samantha_event_A01_4e48799c:
    "Руки ласкают её бока и бёдра, спускаясь всё ниже, пока не достигают жара между ног."

# ch/samantha/events.rpy:3270
translate russian samantha_event_A01_a2ec276c:
    "Сэм ахает и раздвигает ноги как можно шире, когда я касаюсь пальцем входа. На мгновение останавливаюсь, почувствовав металл. Райан и правда заставил её проколоть всё."

# ch/samantha/events.rpy:3271
translate russian samantha_event_A01_d2741d59:
    "Я немного играю с украшением, затем тру клитор костяшкой пальца."

# ch/samantha/events.rpy:3272
translate russian samantha_event_A01_5253233a:
    "Там уже скользко и мокро."

# ch/samantha/events.rpy:3273
translate russian samantha_event_A01_65fca506:
    samantha.say "[lssb_samantha.hero_name()]!"

# ch/samantha/events.rpy:3274
translate russian samantha_event_A01_d25c9539:
    samantha.say "Дай и мне тебя порадовать."

# ch/samantha/events.rpy:3275
translate russian samantha_event_A01_7d0c367d:
    "Я не успеваю отреагировать, как она переворачивает меня, и вот я уже лежу на спине."

# ch/samantha/events.rpy:3276
translate russian samantha_event_A01_2df6751b:
    "Её прекрасные руки скользят к моему члену. Я сдерживаю стон, когда она умело обхватывает его и мягко сжимает."

# ch/samantha/events.rpy:3277
translate russian samantha_event_A01_8024357d:
    "Её руки двигаются вверх-вниз."

# ch/samantha/events.rpy:3278
translate russian samantha_event_A01_efe8e804:
    "Одна рука спускается к основанию и массирует его. На этот раз сдержать звуки я не могу."

# ch/samantha/events.rpy:3279
translate russian samantha_event_A01_bf075842:
    samantha.say "Я подготовлюсь для тебя."

# ch/samantha/events.rpy:3280
translate russian samantha_event_A01_7290f33e:
    "Она почти шепчет, словно разговаривает сама с собой."

# ch/samantha/events.rpy:3281
translate russian samantha_event_A01_9fda02f4:
    "Она убирает руки с меня и вводит в себя два пальца, легко растягивая вход."

# ch/samantha/events.rpy:3282
translate russian samantha_event_A01_ddfccd21:
    "На мгновение на её лице появляется болезненная гримаса, но она всё равно добавляет ещё пальцы."

# ch/samantha/events.rpy:3283
translate russian samantha_event_A01_3b9a6d5b:
    "Я быстро облизываю губы."

# ch/samantha/events.rpy:3284
translate russian samantha_event_A01_c5b0275d:
    "От этого зрелища я твердею ещё сильнее."

# ch/samantha/events.rpy:3285
translate russian samantha_event_A01_e4c4ea2d:
    "В блестящих светлых волосах, рассыпавшихся по плечам, и румянце, разлившемся с лица по всему телу, есть что-то неоспоримо прекрасное."

# ch/samantha/events.rpy:3286
translate russian samantha_event_A01_1c0e7b9d:
    "Она заботится обо мне больше, чем я о ней, правда?"

# ch/samantha/events.rpy:3287
translate russian samantha_event_A01_71ece8c4:
    "Ну что ж, как она хочет."

# ch/samantha/events.rpy:3292
translate russian samantha_event_A01_d5954b60:
    "Я надеваю презерватив и вхожу в неё."

# ch/samantha/events.rpy:3295
translate russian samantha_event_A01_d54c2be4:
    "Я плюю на ладонь, стараюсь как следует смочить член и вхожу в неё."

# ch/samantha/events.rpy:3298
translate russian samantha_event_A01_d54c2be4_1:
    "Я плюю на ладонь, стараюсь как следует смочить член и вхожу в неё."

# ch/samantha/events.rpy:3299
translate russian samantha_event_A01_74993c70:
    samantha.say "Готов, милый?"

# ch/samantha/events.rpy:3300
translate russian samantha_event_A01_e0e1633c:
    "Я беру её за бёдра и располагаю над своим вставшим членом."

# ch/samantha/events.rpy:3304
translate russian samantha_event_A01_b9369cdb:
    "Медленно опускаю её на себя. Она стонет, когда я заполняю её."

# ch/samantha/events.rpy:3306
translate russian samantha_event_A01_e8ed688a:
    "Я даю ей время привыкнуть, но ей хватает мгновения."

# ch/samantha/events.rpy:3318
translate russian samantha_event_A01_d44d1826:
    "Я слегка двигаю бёдрами, и она понимает намёк. Мы движемся вместе, вперёд-назад, с громкими шлепками, пока я вхожу в неё и выхожу."

# ch/samantha/events.rpy:3330
translate russian samantha_event_A01_99156e47:
    "Жар становится невыносимым, а внутри неё так приятно тесно. Наконец я чувствую приближение оргазма."

# ch/samantha/events.rpy:3332
translate russian samantha_event_A01_83d4a336:
    "Прежде чем я успеваю предупредить её и выйти, она наклоняется и проводит языком по моим губам."

# ch/samantha/events.rpy:3335
translate russian samantha_event_A01_13f4d0a0:
    "Я открываю рот, впуская её язык, и кончаю в неё. Она громко ахает."

# ch/samantha/events.rpy:3338
translate russian samantha_event_A01_6d7770d9:
    "Она наклоняется и проводит языком по моим губам."

# ch/samantha/events.rpy:3340
translate russian samantha_event_A01_aa433739:
    "Я открываю рот, впуская её язык, и кончаю в презерватив. Она громко ахает."

# ch/samantha/events.rpy:3342
translate russian samantha_event_A01_f4c2ae3a:
    "Мы оба тяжело дышим."

# ch/samantha/events.rpy:3347
translate russian samantha_event_A01_d59d4f92:
    "Саманта ложится мне на грудь и медленно приподнимает бёдра, выпуская меня."

# ch/samantha/events.rpy:3348
translate russian samantha_event_A01_a6d94f80:
    "В её глазах снова появляются слёзы, и я тревожусь."

# ch/samantha/events.rpy:3349
translate russian samantha_event_A01_a2c774e9:
    "Но стоит ей заговорить, как тревога тут же исчезает."

# ch/samantha/events.rpy:3350
translate russian samantha_event_A01_b11aebc4:
    samantha.say "Спасибо. Спасибо, что рассказал мне о нём."

# ch/samantha/events.rpy:3351
translate russian samantha_event_A01_57401aac:
    "В ответ я лишь глажу её по спине."

# ch/samantha/events.rpy:3352
translate russian samantha_event_A01_79d53bb0:
    "Мы остаёмся так, пока её дыхание не выравнивается и она не начинает тихонько похрапывать у меня на груди."

# ch/samantha/events.rpy:3353
translate russian samantha_event_A01_b59804d2:
    "Довольный, я тоже закрываю глаза."

# ch/samantha/events.rpy:3355
translate russian samantha_event_A01_b9e5b343:
    "Ну, после такого разрешения я точно не собираюсь отступать."

# ch/samantha/events.rpy:3356
translate russian samantha_event_A01_d9d8b219:
    "Я знаю, чего хочу."

# ch/samantha/events.rpy:3357
translate russian samantha_event_A01_f53f4402:
    "Крепко обхватываю её бёдра и забираюсь сверху."

# ch/samantha/events.rpy:3358
translate russian samantha_event_A01_108cca62:
    "Я скидываю свою одежду с кровати."

# ch/samantha/events.rpy:3361
translate russian samantha_event_A01_5af7ddc1:
    "Сэм лежит на спине."

# ch/samantha/events.rpy:3363
translate russian samantha_event_A01_ce4570ce:
    samantha.say "Ох, [lssb_samantha.hero_name()]... Пожалуйста, будь нежнее."

# ch/samantha/events.rpy:3365
translate russian samantha_event_A01_1c56d979:
    samantha.say "[lssb_samantha.hero_name()], я хочу тебя в себе!"

# ch/samantha/events.rpy:3366
translate russian samantha_event_A01_a3f0f0f7:
    "В такие моменты мне приходится мысленно отвешивать себе пощёчину."

# ch/samantha/events.rpy:3367
translate russian samantha_event_A01_0be40137:
    "Потому что какая-то часть меня готова так и остаться на месте."

# ch/samantha/events.rpy:3368
translate russian samantha_event_A01_bedf0fe6:
    "Просто смотреть на обнажённую Сэм, лежащую передо мной."

# ch/samantha/events.rpy:3369
translate russian samantha_event_A01_f83ff665:
    "Не в силах поверить, что всё это правда происходит, что я могу быть с ней вот так!"

# ch/samantha/events.rpy:3370
translate russian samantha_event_A01_56579ec5:
    "Но с такими мыслями далеко не продвинешься."

# ch/samantha/events.rpy:3371
translate russian samantha_event_A01_42e882f7:
    "Поэтому я опускаю взгляд к её бёдрам."

# ch/samantha/events.rpy:3372
translate russian samantha_event_A01_5d071635:
    "И увиденное тут же возвращает меня к делу."

# ch/samantha/events.rpy:3373
translate russian samantha_event_A01_3de9b8b7:
    "Эта аккуратная, идеальная маленькая киска — вот чего я хочу!"

# ch/samantha/events.rpy:3374
translate russian samantha_event_A01_0ecfd776:
    "Через мгновение Сэм окончательно убеждает меня: подтягивает и разводит ноги."

# ch/samantha/events.rpy:3375
translate russian samantha_event_A01_94cd3369:
    "Одновременно она протягивает руки, подзывая меня к себе."

# ch/samantha/events.rpy:3376
translate russian samantha_event_A01_5b0d3a35:
    "Разумеется, сейчас я больше всего на свете хочу именно этого."

# ch/samantha/events.rpy:3377
translate russian samantha_event_A01_40598b69:
    "Но приходится бороться с желанием просто броситься на неё."

# ch/samantha/events.rpy:3378
translate russian samantha_event_A01_46786189:
    "Не хочется выглядеть слишком отчаянным — или расплющить её!"

# ch/samantha/events.rpy:3379
translate russian samantha_event_A01_87c7778b:
    "Поэтому я заставляю себя медленно и осторожно лечь сверху."

# ch/samantha/events.rpy:3381
translate russian samantha_event_A01_f123710c:
    "Сэм обнимает меня, притягивая ещё ближе."

# ch/samantha/events.rpy:3382
translate russian samantha_event_A01_996bf93c:
    "Хотя у меня в голове полный сумбур, нам каким-то образом удаётся всё сделать идеально."

# ch/samantha/events.rpy:3383
translate russian samantha_event_A01_353cdb39:
    "То есть мы соединяемся, как две половинки головоломки, становясь одним целым."

# ch/samantha/events.rpy:3384
translate russian samantha_event_A01_a241c957:
    "Она обвивает меня руками и ногами, а я тоже заключаю её в объятия."

# ch/samantha/events.rpy:3385
translate russian samantha_event_A01_e892cad6:
    "Одновременно я чувствую, как мой член прижимается к её половым губам."

# ch/samantha/events.rpy:3386
translate russian samantha_event_A01_53183e66:
    "Всё между нами кажется совершенно естественным и инстинктивным."

# ch/samantha/events.rpy:3388
translate russian samantha_event_A01_fe370ed0:
    "Поэтому, когда я начинаю двигаться, она подстраивается под меня."

# ch/samantha/events.rpy:3389
translate russian samantha_event_A01_66022200:
    "Головка моего члена уже прижата к губкам её киски."

# ch/samantha/events.rpy:3390
translate russian samantha_event_A01_e39e3fd1:
    "От каждого моего движения Сэм ахает."

# ch/samantha/events.rpy:3391
translate russian samantha_event_A01_06b840ac:
    "Но я совершенно не чувствую неловкости и не теряюсь, что делать дальше."

# ch/samantha/events.rpy:3392
translate russian samantha_event_A01_b96f5de2:
    "Наоборот, словно иду по прямому, понятному пути."

# ch/samantha/events.rpy:3393
translate russian samantha_event_A01_9e16b954:
    "С каждым движением Сэм немного уступает, расслабляется ещё чуть-чуть."

# ch/samantha/events.rpy:3394
translate russian samantha_event_A01_6c47992c:
    "А мне приходится бороться с желанием каждый раз затаить дыхание."

# ch/samantha/events.rpy:3395
translate russian samantha_event_A01_4b52d4a9:
    "Гадаю, не сейчас ли она наконец впустит меня."

# ch/samantha/events.rpy:3396
translate russian samantha_event_A01_bd51a82f:
    "Вскоре ритм увлекает меня, и я перестаю задумываться."

# ch/samantha/events.rpy:3397
translate russian samantha_event_A01_3ec98dd6:
    "Поэтому, когда это наконец происходит, я оказываюсь застигнут врасплох."

# ch/samantha/events.rpy:3400
translate russian samantha_event_A01_8a0afb1c:
    samantha.say "Ох..."

# ch/samantha/events.rpy:3401
translate russian samantha_event_A01_cb768272:
    samantha.say "Ох, [lssb_samantha.hero_name()]..."

# ch/samantha/events.rpy:3402
translate russian samantha_event_A01_ec4150dc:
    mike.say "Какого..."

# ch/samantha/events.rpy:3403
translate russian samantha_event_A01_e7849ea8:
    mike.say "Ох... Ох, бля!"

# ch/samantha/events.rpy:3405
translate russian samantha_event_A01_c474b90e:
    "Я погружаюсь в Сэм с широко раскрытыми глазами и открытым ртом."

# ch/samantha/events.rpy:3406
translate russian samantha_event_A01_8513f30b:
    "Я настолько ошеломлён, что прихожу в себя, лишь войдя в неё наполовину."

# ch/samantha/events.rpy:3407
translate russian samantha_event_A01_753c2b01:
    "И это непросто: ощущения почти невыносимо сильные."

# ch/samantha/events.rpy:3408
translate russian samantha_event_A01_8613a8ec:
    "С каждой секундой я заполняю её всё больше."

# ch/samantha/events.rpy:3409
translate russian samantha_event_A01_38de1560:
    "Словно всё, чего я хотел, обрушивается на меня разом."

# ch/samantha/events.rpy:3410
translate russian samantha_event_A01_6008e5ba:
    "К счастью, вскоре я оказываюсь внутри настолько глубоко, насколько возможно."

# ch/samantha/events.rpy:3411
translate russian samantha_event_A01_eb8916f5:
    "Теперь можно остановиться и осмыслить происходящее."

# ch/samantha/events.rpy:3412
translate russian samantha_event_A01_79975675:
    "Но подсознание, кажется, снова готово перехватить управление."

# ch/samantha/events.rpy:3413
translate russian samantha_event_A01_5014fbe3:
    "Потому что стоит мне замереть, как оно восстаёт."

# ch/samantha/events.rpy:3414
translate russian samantha_event_A01_c72db01d:
    "Зверю внутри меня не нужны паузы и размышления. Ему нужна только Сэм."

# ch/samantha/events.rpy:3415
translate russian samantha_event_A01_a34b0ff0:
    "И теперь, когда я погрузился в неё, он своего не упустит!"

# ch/samantha/events.rpy:3416
translate russian samantha_event_A01_38e1fbf6:
    "Мышцы вдруг напрягаются, а тело начинает двигаться."

# ch/samantha/events.rpy:3418
translate russian samantha_event_A01_d4478d9b:
    "Я приподнимаюсь и снова опускаюсь, повторяя это движение раз за разом."

# ch/samantha/events.rpy:3422
translate russian samantha_event_A01_93115f13:
    "И набираю скорость, с каждой секундой двигаясь всё быстрее."

# ch/samantha/events.rpy:3423
translate russian samantha_event_A01_aef95460:
    "Сэм, кажется, не замечает, что я совершенно потерял над собой контроль."

# ch/samantha/events.rpy:3427
translate russian samantha_event_A01_fe8bb406:
    "Она лишь крепко держится за меня, наверное, ошеломлённая тем, что я делаю."

# ch/samantha/events.rpy:3428
translate russian samantha_event_A01_595da807:
    "Понятия не имею, как долго смогу выдержать такой темп."

# ch/samantha/events.rpy:3432
translate russian samantha_event_A01_a72f133b:
    "И сколько это уже продолжается, тоже не понимаю."

# ch/samantha/events.rpy:3433
translate russian samantha_event_A01_a43ffd04:
    "Есть только близость с Сэм. Всё остальное неважно."

# ch/samantha/events.rpy:3437
translate russian samantha_event_A01_2dfd8047:
    "Я продолжаю вбиваться в неё, пока напряжение не достигает предела."

# ch/samantha/events.rpy:3438
translate russian samantha_event_A01_c9a5acea:
    "Только тогда вспоминаю о том, что будет дальше."

# ch/samantha/events.rpy:3442
translate russian samantha_event_A01_437a01ea:
    mike.say "Ох, чёрт..."

# ch/samantha/events.rpy:3443
translate russian samantha_event_A01_7b9cf58c:
    mike.say "Я... Я сейчас кончу!"

# ch/samantha/events.rpy:3444
translate russian samantha_event_A01_0d01033f:
    "Нельзя кончить в Сэм."

# ch/samantha/events.rpy:3445
translate russian samantha_event_A01_d5f894f8:
    "Жаль, но презервативом мы так и не озаботились."

# ch/samantha/events.rpy:3447
translate russian samantha_event_A01_b8ff55a6:
    "Поэтому я успеваю выйти до того, как случается неизбежное."

# ch/samantha/events.rpy:3449
translate russian samantha_event_A01_7f6b29e5:
    "Мы с Сэм кончаем почти одновременно, подстёгивая друг друга."

# ch/samantha/events.rpy:3451
translate russian samantha_event_A01_2611a6e7:
    "Я чувствую, как она крепко сжимает меня изнутри, пока я выхожу."

# ch/samantha/events.rpy:3454
translate russian samantha_event_A01_0d22f02a:
    "Она ещё во власти оргазма, когда я кончаю ей на живот."

# ch/samantha/events.rpy:3456
translate russian samantha_event_A01_f55c2e35:
    "К счастью, мы оба уже лежим на кровати."

# ch/samantha/events.rpy:3457
translate russian samantha_event_A01_be6aeab2:
    "Так что после этого можем просто без сил рухнуть друг на друга."

# ch/samantha/events.rpy:3472
translate russian samantha_event_A02_65fca506:
    samantha.say "[lssb_samantha.hero_name()]!"

# ch/samantha/events.rpy:3473
translate russian samantha_event_A02_5039a948:
    "Сэм выходит из-за прилавка ко мне, на ходу вешая фартук."

# ch/samantha/events.rpy:3474
translate russian samantha_event_A02_5800ae88:
    "Через плечо перекинута сумочка, а в руке бумажный пакет с логотипом пекарни."

# ch/samantha/events.rpy:3475
translate russian samantha_event_A02_9216cb54:
    "Я нервно улыбаюсь."

# ch/samantha/events.rpy:3476
translate russian samantha_event_A02_6798e490:
    mike.say "Привет."

# ch/samantha/events.rpy:3478
translate russian samantha_event_A02_3172b55c:
    samantha.say "Не нервничай так!"

# ch/samantha/events.rpy:3479
translate russian samantha_event_A02_731cc53d:
    samantha.say "У меня новости."

# ch/samantha/events.rpy:3480
translate russian samantha_event_A02_1c926c52:
    mike.say "Новости?"

# ch/samantha/events.rpy:3481
translate russian samantha_event_A02_b746f907:
    samantha.say "Ага! Пройдёшься со мной?"

# ch/samantha/events.rpy:3482
translate russian samantha_event_A02_e66b95f1:
    "Я киваю и встаю."

# ch/samantha/events.rpy:3483
translate russian samantha_event_A02_49dc735f:
    "Придвигаю стул, беру свой стакан и иду за ней к выходу."

# ch/samantha/events.rpy:3487
translate russian samantha_event_A02_4677f027:
    "Она крепко сжимает пакет из пекарни и поджимает губы."

# ch/samantha/events.rpy:3488
translate russian samantha_event_A02_c0ecfde5:
    "Что-то случилось?"

# ch/samantha/events.rpy:3489
translate russian samantha_event_A02_47366b2a:
    mike.say "Что такое?"

# ch/samantha/events.rpy:3490
translate russian samantha_event_A02_e698dad7:
    samantha.say "..."

# ch/samantha/events.rpy:3491
translate russian samantha_event_A02_637d7901:
    samantha.say "Я рассталась с Райаном."

# ch/samantha/events.rpy:3492
translate russian samantha_event_A02_2e2416ec:
    "У меня в голове на мгновение словно замыкает."

# ch/samantha/events.rpy:3493
translate russian samantha_event_A02_3ab41a87:
    "Парень, по которому она сохла невесть сколько лет, теперь в прошлом?"

# ch/samantha/events.rpy:3494
translate russian samantha_event_A02_ed1f08fd:
    "Она его бросила?"

# ch/samantha/events.rpy:3495
translate russian samantha_event_A02_2ae03913:
    samantha.say "Не смотри на меня так!"

# ch/samantha/events.rpy:3496
translate russian samantha_event_A02_fb1f435f:
    samantha.say "Я много думала о том, что ты сказал."

# ch/samantha/events.rpy:3497
translate russian samantha_event_A02_b37db246:
    samantha.say "Когда пришла домой, спросила об этом Райана."

# ch/samantha/events.rpy:3498
translate russian samantha_event_A02_5422564d:
    samantha.say "Сначала он всё отрицал. Но когда я сказала, что у тебя есть фотографии, он... сдался."

# ch/samantha/events.rpy:3499
translate russian samantha_event_A02_ec0e7f90:
    mike.say "Не знаю, что сказать."

# ch/samantha/events.rpy:3500
translate russian samantha_event_A02_c633af0c:
    mike.say "Ты в порядке?"

# ch/samantha/events.rpy:3501
translate russian samantha_event_A02_2a3bf23a:
    samantha.say "Я в порядке."

# ch/samantha/events.rpy:3502
translate russian samantha_event_A02_fae53ec2:
    samantha.say "Даже лучше."

# ch/samantha/events.rpy:3504
translate russian samantha_event_A02_3049f5ac:
    samantha.say "Я... злюсь. И мне больно."

# ch/samantha/events.rpy:3506
translate russian samantha_event_A02_bde622dd:
    samantha.say "Но я рада, что узнала."

# ch/samantha/events.rpy:3507
translate russian samantha_event_A02_b663cab1:
    mike.say "Ты? Злишься? Как страшно."

# ch/samantha/events.rpy:3509
translate russian samantha_event_A02_22eeb3e3:
    "Она шлёпает меня по плечу, но улыбается."

# ch/samantha/events.rpy:3510
translate russian samantha_event_A02_e7703de8:
    "Вижу, что ей всё ещё грустно, но она держится лучше, чем я ожидал."

# ch/samantha/events.rpy:3511
translate russian samantha_event_A02_55e2360e:
    "Ну, после той истерики."

# ch/samantha/events.rpy:3512
translate russian samantha_event_A02_3a802896:
    samantha.say "Кажется, я приняла решение."

# ch/samantha/events.rpy:3513
translate russian samantha_event_A02_6166182a:
    mike.say "Да?"

# ch/samantha/events.rpy:3515
translate russian samantha_event_A02_f25bede2:
    samantha.say "Я... Я хочу сходить с тобой на свидание."

# ch/samantha/events.rpy:3516
translate russian samantha_event_A02_3bde376a:
    "Если до этого у меня в голове замыкало, то теперь она совсем отключилась."

# ch/samantha/events.rpy:3517
translate russian samantha_event_A02_bb0e35a6:
    "Я правильно расслышал?"

# ch/samantha/events.rpy:3518
translate russian samantha_event_A02_d3a6e07b:
    "Не может быть."

# ch/samantha/events.rpy:3519
translate russian samantha_event_A02_7ed3f86b:
    "Кажется, она замечает, что я потерял дар речи."

# ch/samantha/events.rpy:3521
translate russian samantha_event_A02_aabd7954:
    samantha.say "Ты всегда был рядом."

# ch/samantha/events.rpy:3522
translate russian samantha_event_A02_531ba926:
    samantha.say "Ты честный, проводишь со мной время..."

# ch/samantha/events.rpy:3523
translate russian samantha_event_A02_89457612:
    samantha.say "Ты мне очень нравишься, [lssb_samantha.hero_name()]."

# ch/samantha/events.rpy:3524
translate russian samantha_event_A02_10171788:
    mike.say "Я... Не знаю, что сказать."

# ch/samantha/events.rpy:3526
translate russian samantha_event_A02_e73c4144:
    samantha.say "Ой! Прости. Я всё неправильно поняла?"

# ch/samantha/events.rpy:3531
translate russian samantha_event_A02_90d04ad2:
    mike.say "Кексик... Я с удовольствием схожу с тобой на свидание."

# ch/samantha/events.rpy:3533
translate russian samantha_event_A02_f2a96a44:
    mike.say "Сэм... Я с удовольствием схожу с тобой на свидание."

# ch/samantha/events.rpy:3535
translate russian samantha_event_A02_588a250a:
    samantha.say "Правда? Ох, спасибо!"

# ch/samantha/events.rpy:3537
translate russian samantha_event_A02_f30ce12a:
    mike.say "Не знаю, есть ли у меня к тебе такие чувства."

# ch/samantha/events.rpy:3539
translate russian samantha_event_A02_88afbb26:
    mike.say "...Я не уверен насчёт нас."

# ch/samantha/events.rpy:3541
translate russian samantha_event_A02_559bff32:
    samantha.say "А. Понимаю. Прости."

# ch/samantha/events.rpy:3542
translate russian samantha_event_A02_778e66a5:
    "Что я делаю?.. Нельзя так с ней..."

# ch/samantha/events.rpy:3544
translate russian samantha_event_A02_32d82255:
    mike.say "Но я готов попробовать."

# ch/samantha/events.rpy:3546
translate russian samantha_event_A02_41ccb2a9:
    mike.say "А как же Райан?"

# ch/samantha/events.rpy:3547
translate russian samantha_event_A02_9e20356a:
    mike.say "Вряд ли он так просто это примет."

# ch/samantha/events.rpy:3549
translate russian samantha_event_A02_b7b90ce2:
    samantha.say "Мне всё равно."

# ch/samantha/events.rpy:3550
translate russian samantha_event_A02_5b339a6e:
    samantha.say "Нет значит нет."

# ch/samantha/events.rpy:3552
translate russian samantha_event_A02_bcf9c798:
    samantha.say "Его и так уже несколько дней нет дома."

# ch/samantha/events.rpy:3553
translate russian samantha_event_A02_371b8676:
    mike.say "..."

# ch/samantha/events.rpy:3554
translate russian samantha_event_A02_8f801736:
    mike.say "Наверное, можно попробовать. Я схожу с тобой на свидание."

# ch/samantha/events.rpy:3556
translate russian samantha_event_A02_ff05104d:
    samantha.say "Правда? Отлично! Спасибо! Обещаю, ты не пожалеешь."

# ch/samantha/events.rpy:3557
translate russian samantha_event_A02_acbb5d18:
    "Я и так знаю, что не пожалею."

# ch/samantha/events.rpy:3558
translate russian samantha_event_A02_31fcdcd7:
    "Саманта слишком милая, чтобы заставить кого-то жалеть. Разве что Райана — о том, что потерял её."

# ch/samantha/events.rpy:3559
translate russian samantha_event_A02_e2831ca3:
    mike.say "Ты уверена, что готова? Что прошло достаточно времени?"

# ch/samantha/events.rpy:3561
translate russian samantha_event_A02_1ff00b77:
    samantha.say "Думаю, чем скорее я забуду Райана, тем лучше мне будет."

# ch/samantha/events.rpy:3562
translate russian samantha_event_A02_d82231bb:
    mike.say "Логично."

# ch/samantha/events.rpy:3564
translate russian samantha_event_A02_1ff25d4d:
    samantha.say "Ура! Пойдём!"

# ch/samantha/events.rpy:3565
translate russian samantha_event_A02_adc61fe8:
    mike.say "Что? Прямо сейчас?"

# ch/samantha/events.rpy:3566
translate russian samantha_event_A02_f50bc008:
    samantha.say "Да, прямо сейчас! Я закончила работать, а ты ведь свободен?"

# ch/samantha/events.rpy:3567
translate russian samantha_event_A02_f8db339c:
    mike.say "Ага."

# ch/samantha/events.rpy:3569
translate russian samantha_event_A02_5174180a:
    samantha.say "Тогда вперёд!"

# ch/samantha/events.rpy:3570
translate russian samantha_event_A02_1ab266ba:
    samantha.say "Кто знает, когда мы ещё вот так оба будем свободны?"

# ch/samantha/events.rpy:3571
translate russian samantha_event_A02_f0456bf9:
    samantha.say "У обоих работа, а у меня ещё и университет."

# ch/samantha/events.rpy:3572
translate russian samantha_event_A02_9138267e:
    samantha.say "Сейчас самое время!"

# ch/samantha/events.rpy:3573
translate russian samantha_event_A02_05930946:
    mike.say "Ну тогда пойдём. Есть идеи, куда?"

# ch/samantha/events.rpy:3575
translate russian samantha_event_A02_7509eb3b:
    samantha.say "Эм... Признаюсь, я это толком не продумала."

# ch/samantha/events.rpy:3576
translate russian samantha_event_A02_c4ba599f:
    samantha.say "Не думала, что дойду до этого."

# ch/samantha/events.rpy:3577
translate russian samantha_event_A02_83164c98:
    "Не думала, что дойдёт до этого? Со мной?"

# ch/samantha/events.rpy:3578
translate russian samantha_event_A02_f932af4b:
    mike.say "Ничего страшного. Придумаем, куда сходить."

# ch/samantha/events.rpy:3580
translate russian samantha_event_A02_4eb6a23e:
    samantha.say "Например?"

# ch/samantha/events.rpy:3583
translate russian samantha_event_A02_f049243d:
    mike.say "Может, в кино?"

# ch/samantha/events.rpy:3585
translate russian samantha_event_A02_9799c55d:
    samantha.say "О-о! Отличная идея! Что сейчас идёт?"

# ch/samantha/events.rpy:3586
translate russian samantha_event_A02_8c534eee:
    mike.say "Не знаю. Давай сходим и посмотрим."

# ch/samantha/events.rpy:3589
translate russian samantha_event_A02_c96f85d6:
    "Сегодня в кинотеатре довольно людно."

# ch/samantha/events.rpy:3590
translate russian samantha_event_A02_1aa266cd:
    "Наверное, вышел какой-то новый фильм, о котором я не слышал."

# ch/samantha/events.rpy:3592
translate russian samantha_event_A02_dfc99f3a:
    samantha.say "Совсем забыла! Вчера вышел новый ужастик."

# ch/samantha/events.rpy:3593
translate russian samantha_event_A02_fe0749c9:
    mike.say "Хочешь на него? Раз столько народу, должен быть неплохим."

# ch/samantha/events.rpy:3595
translate russian samantha_event_A02_ff413364:
    samantha.say "Эм... Ладно. Можно на него."

# ch/samantha/events.rpy:3596
translate russian samantha_event_A02_620f3728:
    "Она немного бледнеет, но я замечаю это лишь у кассы, когда мы покупаем билеты."

# ch/samantha/events.rpy:3600
translate russian samantha_event_A02_1119ee9a:
    "Мы находим свои места и садимся ближе к экрану."

# ch/samantha/events.rpy:3601
translate russian samantha_event_A02_5007be40:
    mike.say "Ты точно справишься? Может, посмотрим что-нибудь другое?"

# ch/samantha/events.rpy:3602
translate russian samantha_event_A02_0dc5b473:
    samantha.say "Нет! Всё нормально. Это же просто кино."

# ch/samantha/events.rpy:3603
translate russian samantha_event_A02_dd4c5e7a:
    "Вижу, что она врёт, но её попытка это отрицать невольно кажется милой."

# ch/samantha/events.rpy:3604
translate russian samantha_event_A02_591cc683:
    "Через несколько минут начинаются трейлеры. На экране мелькают скучные анонсы, лишь несколько привлекают моё внимание."

# ch/samantha/events.rpy:3605
translate russian samantha_event_A02_53f67630:
    "Свет гаснет, разговоры стихают."

# ch/samantha/events.rpy:3606
translate russian samantha_event_A02_6124330c:
    "Перед нами появляется типичное для ужастика название."

# ch/samantha/events.rpy:3607
translate russian samantha_event_A02_205daf9c:
    samantha.say "Пока вроде ничего страшного."

# ch/samantha/events.rpy:3608
translate russian samantha_event_A02_808f7d35:
    "Начало неторопливое: пара въезжает в дом и постепенно понимает, что в нём обитают призраки. Ничего особенного, но от первого же страшного момента Саманта подскакивает в кресле."

# ch/samantha/events.rpy:3609
translate russian samantha_event_A02_18775110:
    samantha.say "О боже!"

# ch/samantha/events.rpy:3610
translate russian samantha_event_A02_4b2ce854:
    "Фильм продолжается. Вскоре начинается кровавая мясорубка."

# ch/samantha/events.rpy:3611
translate russian samantha_event_A02_85e81424:
    "Я смотрю на Саманту. Кажется, она слегка позеленела."

# ch/samantha/events.rpy:3612
translate russian samantha_event_A02_156ed819:
    "Её руки вцепились в подлокотники."

# ch/samantha/events.rpy:3613
translate russian samantha_event_A02_1514cf31:
    "Я накрываю её ладонь своей. Она на миг вздрагивает, но тут же расслабляется и переплетает пальцы с моими."

# ch/samantha/events.rpy:3614
translate russian samantha_event_A02_3fa348f7:
    "Весь остаток фильма она прячет лицо у меня на плече."

# ch/samantha/events.rpy:3615
translate russian samantha_event_A02_6ec9762f:
    "Начинаются титры."

# ch/samantha/events.rpy:3616
translate russian samantha_event_A02_4c0e9596:
    samantha.say "Всё закончилось?"

# ch/samantha/events.rpy:3617
translate russian samantha_event_A02_2afc30fc:
    mike.say "Ага. Так страшно было?"

# ch/samantha/events.rpy:3618
translate russian samantha_event_A02_cc6eb540:
    samantha.say "...Ничуть не страшно."

# ch/samantha/events.rpy:3619
translate russian samantha_event_A02_360f0fca:
    mike.say "Как скажешь. Пойдём."

# ch/samantha/events.rpy:3620
translate russian samantha_event_A02_627b9a5a:
    "Саманта кивает. Мы встаём и выходим вместе с остальными зрителями. До самой улицы она держится за мою руку."

# ch/samantha/events.rpy:3622
translate russian samantha_event_A02_dfd6da08:
    samantha.say "Конечно! Мне всё равно нужно в магазин одежды, так что отличный выбор!"

# ch/samantha/events.rpy:3627
translate russian samantha_event_A02_be0a94be:
    "К тому времени, как мы доходим до магазина одежды, в руках у Саманты уже несколько пакетов: по пути заглянули в книжный."

# ch/samantha/events.rpy:3628
translate russian samantha_event_A02_16c47dc3:
    "Внутри почти никого. Только скучающий продавец облокотился на кассовую стойку."

# ch/samantha/events.rpy:3629
translate russian samantha_event_A02_2f752751:
    samantha.say "Эй!"

# ch/samantha/events.rpy:3630
translate russian samantha_event_A02_4cf775c5:
    mike.say "Что?"

# ch/samantha/events.rpy:3631
translate russian samantha_event_A02_eed6acc5:
    samantha.say "Может, выберешь что-нибудь для меня?"

# ch/samantha/events.rpy:3632
translate russian samantha_event_A02_4e02bd1a:
    mike.say "Правда? Я не особо разбираюсь в моде."

# ch/samantha/events.rpy:3633
translate russian samantha_event_A02_1e7f7c6a:
    samantha.say "Поверь в себя! Хочу посмотреть, что ты придумаешь."

# ch/samantha/events.rpy:3635
translate russian samantha_event_A02_efa53a31:
    samantha.say "Только не слишком долго!"

# ch/samantha/events.rpy:3637
translate russian samantha_event_A02_ea13d605:
    "С этими словами она направляется в один из рядов женского отдела, по пути прихватив тележку."

# ch/samantha/events.rpy:3638
translate russian samantha_event_A02_f16ae61c:
    "С чего вообще начать?"

# ch/samantha/events.rpy:3642
translate russian samantha_event_A02_0fa4a79a:
    "На видном месте у входа изящно висит красная блузка."

# ch/samantha/events.rpy:3643
translate russian samantha_event_A02_8e8f6a6b:
    "С оборками и кружевом на плечах."

# ch/samantha/events.rpy:3644
translate russian samantha_event_A02_d9293611:
    "Кажется, ей пойдёт."

# ch/samantha/events.rpy:3647
translate russian samantha_event_A02_eb4de543:
    "Я направляюсь в отдел для плавания. Купальники всех фасонов и размеров развешаны на стенах и стойках."

# ch/samantha/events.rpy:3648
translate russian samantha_event_A02_3f0bcbc6:
    "Взгляд цепляется за фиолетовый купальник. Очень, очень откровенный. Не знаю, надела бы его хоть одна женщина в здравом уме."

# ch/samantha/events.rpy:3650
translate russian samantha_event_A02_43810d9f:
    "Может, как-нибудь сходим поплавать."

# ch/samantha/events.rpy:3651
translate russian samantha_event_A02_b7984937:
    "У неё наверняка уже есть купальник, но я всё равно думаю, что этот смотрелся бы на ней прекрасно, даже если она и не помыслит его надеть."

# ch/samantha/events.rpy:3653
translate russian samantha_event_A02_7ecf29ba:
    "На одной из стоек висит короткий топ с открытой спиной и завязками внизу."

# ch/samantha/events.rpy:3654
translate russian samantha_event_A02_641a07ac:
    "Сэм вообще носит что-нибудь подобное?"

# ch/samantha/events.rpy:3655
translate russian samantha_event_A02_c871cb2b:
    "Почему бы не попробовать? Если не понравится, она просто попросит вернуть его на место."

# ch/samantha/events.rpy:3657
translate russian samantha_event_A02_e8db4241:
    "Когда мы снова встречаемся, я поднимаю выбранную вещь, чтобы Саманта могла её рассмотреть."

# ch/samantha/events.rpy:3659
translate russian samantha_event_A02_84659815:
    "Её тележка завалена джинсами и футболками."

# ch/samantha/events.rpy:3661
translate russian samantha_event_A02_d592598d:
    samantha.say "О-о!"

# ch/samantha/events.rpy:3664
translate russian samantha_event_A02_4db5d911:
    samantha.say "И ты ещё говорил, что не разбираешься в моде! Какая прелесть!"

# ch/samantha/events.rpy:3667
translate russian samantha_event_A02_ef551c38:
    samantha.say "Чуть не забыла!"

# ch/samantha/events.rpy:3669
translate russian samantha_event_A02_228b8e05:
    samantha.say "Мне как раз нужен новый купальник."

# ch/samantha/events.rpy:3673
translate russian samantha_event_A02_bd14480c:
    samantha.say "Но этот немного чересчур."

# ch/samantha/events.rpy:3675
translate russian samantha_event_A02_6909a59d:
    samantha.say "Впрочем..."

# ch/samantha/events.rpy:3678
translate russian samantha_event_A02_2cc6182f:
    samantha.say "Если считаешь, что мне пойдёт, может, и надену. Но он уж очень открытый..."

# ch/samantha/events.rpy:3682
translate russian samantha_event_A02_57a0c799:
    samantha.say "Нужно будет как-нибудь сходить поплавать."

# ch/samantha/events.rpy:3684
translate russian samantha_event_A02_f177a95e:
    samantha.say "Спасибо, [lssb_samantha.hero_name()]!"

# ch/samantha/events.rpy:3686
translate russian samantha_event_A02_e698dad7_1:
    samantha.say "..."

# ch/samantha/events.rpy:3688
translate russian samantha_event_A02_7e967aae:
    samantha.say "Мне нравится. И уверена, тебе тоже."

# ch/samantha/events.rpy:3689
translate russian samantha_event_A02_d29b2fc6:
    "Я чуть не пропускаю её подмигивание и тут же давлюсь воздухом."

# ch/samantha/events.rpy:3691
translate russian samantha_event_A02_72b37ba9:
    samantha.say "Ну всё, я готова! Большое спасибо за помощь."

# ch/samantha/events.rpy:3693
translate russian samantha_event_A02_d90f85e2:
    mike.say "Дальше по улице есть ресторан."

# ch/samantha/events.rpy:3694
translate russian samantha_event_A02_b347c3bf:
    samantha.say "Как бы я ни любила перекусывать в пекарне, нормальная еда — хорошая идея."

# ch/samantha/events.rpy:3695
translate russian samantha_event_A02_b0007a37:
    mike.say "Ересь!"

# ch/samantha/events.rpy:3696
translate russian samantha_event_A02_46e1c154:
    samantha.say "Помолчи!"

# ch/samantha/events.rpy:3701
translate russian samantha_event_A02_4a19afe5:
    "Нас быстро усаживают за хороший столик."

# ch/samantha/events.rpy:3702
translate russian samantha_event_A02_ac0be723:
    "Рад, что мы пришли пораньше: посетителей становится всё больше."

# ch/samantha/events.rpy:3703
translate russian samantha_event_A02_fc41a5fa:
    "Мы заказываем напитки и погружаемся в меню."

# ch/samantha/events.rpy:3704
translate russian samantha_event_A02_c676d25b:
    mike.say "Что будешь?"

# ch/samantha/events.rpy:3705
translate russian samantha_event_A02_c24967b7:
    samantha.say "Хм."

# ch/samantha/events.rpy:3706
translate russian samantha_event_A02_bccbfb4f:
    samantha.say "А давай выберем друг для друга! Оба попробуем что-нибудь новое."

# ch/samantha/events.rpy:3707
translate russian samantha_event_A02_7d118893:
    mike.say "А. Давай."

# ch/samantha/events.rpy:3709
translate russian samantha_event_A02_9ef6026d:
    samantha.say "Ура! Выбери что-нибудь вкусное!"

# ch/samantha/events.rpy:3711
translate russian samantha_event_A02_3c3d2b3f:
    "Я снова смотрю в меню, но в голове вдруг становится пусто. Что бы Сэм хотела съесть?"

# ch/samantha/events.rpy:3714
translate russian samantha_event_A02_cadac4d4:
    "Вроде достаточно просто. Почему бы и нет?"

# ch/samantha/events.rpy:3715
translate russian samantha_event_A02_74c72ab7:
    "Официантка подходит с блокнотом и карандашом, чтобы принять заказ. Я заказываю Саманте спагетти."

# ch/samantha/events.rpy:3716
translate russian samantha_event_A02_d5b4a642:
    samantha.say "Можно... запеканку с курицей?"

# ch/samantha/events.rpy:3718
translate russian samantha_event_A02_ed98db7b:
    "Интересно. Кажется, я такого ещё не пробовал. Я пожимаю плечами, а она улыбается."

# ch/samantha/events.rpy:3721
translate russian samantha_event_A02_de07f5c3:
    "Гамбургеры ведь любят все?"

# ch/samantha/events.rpy:3722
translate russian samantha_event_A02_3189720b:
    "Официантка подходит с блокнотом и карандашом, чтобы принять заказ. Я выбираю для Саманты гамбургер с картошкой фри."

# ch/samantha/events.rpy:3723
translate russian samantha_event_A02_d5b4a642_1:
    samantha.say "Можно... запеканку с курицей?"

# ch/samantha/events.rpy:3725
translate russian samantha_event_A02_d812503f:
    "Интересно. Кажется, я такого ещё не пробовал. Я пожимаю плечами, а она тепло улыбается."

# ch/samantha/events.rpy:3726
translate russian samantha_event_A02_45beff63:
    samantha.say "Спасибо, [lssb_samantha.hero_name()]! Люблю простую вкусную еду."

# ch/samantha/events.rpy:3730
translate russian samantha_event_A02_a5125260:
    "Не помню, любит ли она морепродукты. Знаю, рыбу здесь готовят неплохо, так что попробовать стоит."

# ch/samantha/events.rpy:3731
translate russian samantha_event_A02_17b08bf5:
    "Официантка подходит с блокнотом и карандашом, чтобы принять заказ. Я выбираю для Саманты лосося."

# ch/samantha/events.rpy:3732
translate russian samantha_event_A02_d5b4a642_2:
    samantha.say "Можно... запеканку с курицей?"

# ch/samantha/events.rpy:3734
translate russian samantha_event_A02_2f733a9b:
    "Интересно. Кажется, я такого ещё не пробовал. Я пожимаю плечами, а она натянуто улыбается. Упс. Не любит рыбу?"

# ch/samantha/events.rpy:3736
translate russian samantha_event_A02_e56c4077:
    "Когда приносят еду, мы быстро с ней расправляемся."

# ch/samantha/events.rpy:3737
translate russian samantha_event_A02_4a369efe:
    "Запеканка с курицей вкусная, но вряд ли я стал бы заказывать её постоянно."

# ch/samantha/events.rpy:3738
translate russian samantha_event_A02_94599a5f:
    "Официантка приносит счёт, и я достаю кошелёк."

# ch/samantha/events.rpy:3739
translate russian samantha_event_A02_409e611e:
    "Стоит мне положить деньги, как Сэм хватает счёт и прижимает к груди."

# ch/samantha/events.rpy:3741
translate russian samantha_event_A02_5c06bac2:
    mike.say "Кексик..."

# ch/samantha/events.rpy:3743
translate russian samantha_event_A02_fc410925:
    mike.say "Сэм..."

# ch/samantha/events.rpy:3745
translate russian samantha_event_A02_142c0ccb:
    samantha.say "Пополам! Как минимум!"

# ch/samantha/events.rpy:3746
translate russian samantha_event_A02_e8c783c3:
    "Я вздыхаю, но в конце концов сдаюсь: она явно не вернёт счёт, пока я не соглашусь. Когда официантка забирает оплату и благодарит за визит, Сэм выглядит довольной."

# ch/samantha/events.rpy:3750
translate russian samantha_event_A02_4a9627e7:
    "Мы с Самантой стоим у её дома."

# ch/samantha/events.rpy:3751
translate russian samantha_event_A02_4fe05aa5:
    "На подъездной дорожке нет машины. Значит, Райан где-то... занят тем, на что он там тратит время."

# ch/samantha/events.rpy:3752
translate russian samantha_event_A02_4a3a8ab8:
    "Провожать её домой было на удивление приятно, хотя мы и молчали."

# ch/samantha/events.rpy:3753
translate russian samantha_event_A02_0baee0c9:
    "Всю дорогу она ни за что не хотела отпускать мою руку."

# ch/samantha/events.rpy:3755
translate russian samantha_event_A02_0430a9c2:
    samantha.say "Было весело!"

# ch/samantha/events.rpy:3756
translate russian samantha_event_A02_16d403c7:
    mike.say "Да, очень."

# ch/samantha/events.rpy:3757
translate russian samantha_event_A02_9f679905:
    samantha.say "Надо делать это почаще."

# ch/samantha/events.rpy:3759
translate russian samantha_event_A02_e698dad7_2:
    samantha.say "..."

# ch/samantha/events.rpy:3760
translate russian samantha_event_A02_a73b83f9:
    samantha.say "Спасибо, [lssb_samantha.hero_name()]."

# ch/samantha/events.rpy:3761
translate russian samantha_event_A02_4b6989b3:
    mike.say "М? За что?"

# ch/samantha/events.rpy:3762
translate russian samantha_event_A02_c0f3b658:
    samantha.say "За то, что ты рядом."

# ch/samantha/events.rpy:3763
translate russian samantha_event_A02_8d49a4a5:
    samantha.say "И что сегодня пошёл со мной."

# ch/samantha/events.rpy:3764
translate russian samantha_event_A02_39343535:
    samantha.say "Я боялась, что ты откажешься."

# ch/samantha/events.rpy:3766
translate russian samantha_event_A02_64ecea90:
    samantha.say "Ты мне... очень нравишься, [lssb_samantha.hero_name()]."

# ch/samantha/events.rpy:3768
translate russian samantha_event_A02_b139a4a2:
    "Вдруг её ресницы трепещут, и она наклоняется ко мне."

# ch/samantha/events.rpy:3769
translate russian samantha_event_A02_eb862c80:
    "Это... непривычно."

# ch/samantha/events.rpy:3770
translate russian samantha_event_A02_eddc9e0a:
    "Но мне нравится."

# ch/samantha/events.rpy:3771
translate russian samantha_event_A02_5ce2c7c3:
    "Не знаю, чего я жду."

# ch/samantha/events.rpy:3772
translate russian samantha_event_A02_f1c88940:
    "Девушка, в которую я столько времени влюблён, наконец отвечает взаимностью."

# ch/samantha/events.rpy:3773
translate russian samantha_event_A02_b8e8c9aa:
    "Я преодолеваю оставшееся расстояние."

# ch/samantha/events.rpy:3778
translate russian samantha_event_A02_0fd51d9c:
    "Её губы такие же пухлые и мягкие, какими кажутся."

# ch/samantha/events.rpy:3779
translate russian samantha_event_A02_ed948261:
    "Я кладу руку ей на бедро и чувствую, как её руки обвивают мою шею."

# ch/samantha/events.rpy:3780
translate russian samantha_event_A02_5f2ad0a1:
    "Поцелуй длится всего несколько секунд, но Сэм успевает покраснеть до ушей."

# ch/samantha/events.rpy:3781
translate russian samantha_event_A02_fb331fd8:
    "Наверное, я выгляжу так же."

# ch/samantha/events.rpy:3785
translate russian samantha_event_A02_93eee01d:
    samantha.say "До встречи, [lssb_samantha.hero_name()]."

# ch/samantha/events.rpy:3786
translate russian samantha_event_A02_90ffcc5b:
    "В голове туман. Господи, сколько мне лет? Веду себя как мальчишка, у которого от любви голова кругом. С трудом поднимаю руку и машу."

# ch/samantha/events.rpy:3787
translate russian samantha_event_A02_39793610:
    mike.say "Пока."

# ch/samantha/events.rpy:3788
translate russian samantha_event_A02_dbaa69df:
    "Она хихикает и ещё раз целует меня, теперь в щёку."

# ch/samantha/events.rpy:3790
translate russian samantha_event_A02_53081053:
    "Следующее, что я осознаю: стою один на её крыльце и смотрю на закрытую дверь."

# ch/samantha/events.rpy:3798
translate russian samantha_event_A03_d22afc7c:
    "Я был уверен: нас с Сэм сдерживает лишь то, что она ещё не порвала с Райаном окончательно."

# ch/samantha/events.rpy:3799
translate russian samantha_event_A03_cb581064:
    "Нам даже удалось это обсудить: я поднял тему, и она неохотно разговорилась."

# ch/samantha/events.rpy:3800
translate russian samantha_event_A03_1cf3c425:
    "Поэтому, когда она довела дело до конца и официально сообщила Райану о разрыве помолвки, я был на седьмом небе."

# ch/samantha/events.rpy:3801
translate russian samantha_event_A03_9a7c3117:
    "Но вскоре понял, что перемены, которых я ждал, так и не наступили."

# ch/samantha/events.rpy:3802
translate russian samantha_event_A03_1582d060:
    "Не поймите неправильно: Сэм не охладела ко мне, и наши отношения не испортились."

# ch/samantha/events.rpy:3803
translate russian samantha_event_A03_47205bfa:
    "Просто всё шло примерно так же, как до того, как она бросила Райана и мы стали настоящей парой."

# ch/samantha/events.rpy:3804
translate russian samantha_event_A03_ff884d40:
    "Поэтому, когда она наконец смотрит мне прямо в глаза и говорит, что хочет поговорить, я жду худшего."

# ch/samantha/events.rpy:3806
translate russian samantha_event_A03_1b451edf:
    samantha.say "[lssb_samantha.hero_name()]..."

# ch/samantha/events.rpy:3808
translate russian samantha_event_A03_20ee404f:
    mike.say "Эм, да, Кексик?"

# ch/samantha/events.rpy:3810
translate russian samantha_event_A03_2aedbcec:
    mike.say "Эм, да, Сэм?"

# ch/samantha/events.rpy:3811
translate russian samantha_event_A03_546454c7:
    samantha.say "Я хочу тебе кое-что сказать."

# ch/samantha/events.rpy:3812
translate russian samantha_event_A03_a49479af:
    samantha.say "Наверное, в чём-то признаться."

# ch/samantha/events.rpy:3813
translate russian samantha_event_A03_9fb782b5:
    "В этот миг кажется, будто кто-то запустил руку мне в грудь и сжал сердце."

# ch/samantha/events.rpy:3814
translate russian samantha_event_A03_b15d1926:
    "Думаю лишь о том, что сейчас Сэм скажет самое страшное, что я могу представить."

# ch/samantha/events.rpy:3815
translate russian samantha_event_A03_71cafcec:
    "Воображаю, как она говорит, что у нас всё складывается совсем не так, как она ожидала."

# ch/samantha/events.rpy:3816
translate russian samantha_event_A03_e4a25ca0:
    "Или что, несмотря на всё дерьмо, которое он творил за её спиной, она поняла: всё-таки любит Райана."

# ch/samantha/events.rpy:3817
translate russian samantha_event_A03_476f9f81:
    "В этот момент мне хочется сказать миллион вещей."

# ch/samantha/events.rpy:3818
translate russian samantha_event_A03_f3556f84:
    "Я мог бы начать умолять, упрашивать или спорить, не дав ей произнести больше ни слова."

# ch/samantha/events.rpy:3819
translate russian samantha_event_A03_ab51ea53:
    "Вместо этого подавляю бессмысленную панику и киваю, предлагая продолжать."

# ch/samantha/events.rpy:3821
translate russian samantha_event_A03_1ddfb4cc:
    mike.say "А... Ладно, Кексик."

# ch/samantha/events.rpy:3823
translate russian samantha_event_A03_b9cc61e5:
    mike.say "А... Ладно, Сэм."

# ch/samantha/events.rpy:3824
translate russian samantha_event_A03_6eda8d4f:
    mike.say "Звучит... довольно драматично!"

# ch/samantha/events.rpy:3825
translate russian samantha_event_A03_9777f4d2:
    samantha.say "Да, пожалуй!"

# ch/samantha/events.rpy:3827
translate russian samantha_event_A03_8f0aa4e9:
    samantha.say "Но я и правда хочу сказать тебе кое-что важное."

# ch/samantha/events.rpy:3828
translate russian samantha_event_A03_d8bc7c1a:
    mike.say "Я так и подумал..."

# ch/samantha/events.rpy:3829
translate russian samantha_event_A03_bdd17b89:
    "Сэм нервно улыбается, что ничуть не успокаивает мои страхи."

# ch/samantha/events.rpy:3830
translate russian samantha_event_A03_ab37118e:
    samantha.say "Ну, была не была!"

# ch/samantha/events.rpy:3831
translate russian samantha_event_A03_aec77f7a:
    samantha.say "Помнишь, как ты заметил, что я всё ещё ношу кольцо?"

# ch/samantha/events.rpy:3832
translate russian samantha_event_A03_4a8a760b:
    "Я киваю, уже боясь того, к чему она ведёт."

# ch/samantha/events.rpy:3833
translate russian samantha_event_A03_861d1d21:
    samantha.say "Мне ещё столько всего нужно было обдумать, понимаешь?"

# ch/samantha/events.rpy:3834
translate russian samantha_event_A03_ae948b4b:
    samantha.say "Я так долго считала наши с Райаном отношения нормальными."

# ch/samantha/events.rpy:3835
translate russian samantha_event_A03_691d9383:
    samantha.say "И только когда ты открыл мне глаза на то, какой он на самом деле, я поняла..."

# ch/samantha/events.rpy:3836
translate russian samantha_event_A03_6fa57489:
    samantha.say "Поняла, что чёрт знает сколько времени обманывала себя."

# ch/samantha/events.rpy:3837
translate russian samantha_event_A03_99831381:
    samantha.say "Что была такой дурой и позволяла ему пользоваться мной всё время, пока мы были вместе."

# ch/samantha/events.rpy:3838
translate russian samantha_event_A03_38e0ce53:
    "Теперь я качаю головой, не соглашаясь с тем, как низко Сэм себя оценивает."

# ch/samantha/events.rpy:3840
translate russian samantha_event_A03_f8401521:
    mike.say "Не говори так, Кексик."

# ch/samantha/events.rpy:3842
translate russian samantha_event_A03_d05f95c7:
    mike.say "Не говори так, Сэм."

# ch/samantha/events.rpy:3843
translate russian samantha_event_A03_06d83fc5:
    mike.say "Он подонок и манипулятор!"

# ch/samantha/events.rpy:3844
translate russian samantha_event_A03_1f1dde06:
    mike.say "Ты совершенно не виновата в том, что произошло."

# ch/samantha/events.rpy:3846
translate russian samantha_event_A03_d86f8111:
    "Сэм смеётся и улыбается мне, тоже слегка качая головой."

# ch/samantha/events.rpy:3847
translate russian samantha_event_A03_15501b74:
    samantha.say "Ох, [lssb_samantha.hero_name()]."

# ch/samantha/events.rpy:3848
translate russian samantha_event_A03_8b41c113:
    samantha.say "Иногда мне кажется, что ради меня ты готов назвать чёрное белым!"

# ch/samantha/events.rpy:3850
translate russian samantha_event_A03_35d222ef:
    samantha.say "Ты ведь не хуже меня знаешь, что такое возможно только с участием обоих."

# ch/samantha/events.rpy:3851
translate russian samantha_event_A03_78c803c8:
    samantha.say "Но именно ты показал мне, как я ошибалась."

# ch/samantha/events.rpy:3852
translate russian samantha_event_A03_cb520c9f:
    samantha.say "Из-за тебя я начала во всём сомневаться."

# ch/samantha/events.rpy:3853
translate russian samantha_event_A03_6757cf6b:
    mike.say "Ну..."

# ch/samantha/events.rpy:3855
translate russian samantha_event_A03_ff079688:
    mike.say "Тогда почему понадобилось столько времени, Кексик?"

# ch/samantha/events.rpy:3857
translate russian samantha_event_A03_f157fa85:
    mike.say "Тогда почему понадобилось столько времени, Сэм?"

# ch/samantha/events.rpy:3858
translate russian samantha_event_A03_dcbae2aa:
    "Сэм устало вздыхает и пожимает плечами."

# ch/samantha/events.rpy:3859
translate russian samantha_event_A03_c306bd61:
    samantha.say "Не знаю, [lssb_samantha.hero_name()]."

# ch/samantha/events.rpy:3860
translate russian samantha_event_A03_7a28e999:
    samantha.say "Наверное, мне просто нужно было время, чтобы понять, насколько всё было неправильно."

# ch/samantha/events.rpy:3861
translate russian samantha_event_A03_802d34ae:
    samantha.say "Ну и ещё мне нужно было разобраться кое с чем."

# ch/samantha/events.rpy:3862
translate russian samantha_event_A03_a61c310e:
    "От этих слов мои брови взлетают вверх. Внезапный интерес скрыть не удаётся."

# ch/samantha/events.rpy:3864
translate russian samantha_event_A03_5c0755e1:
    mike.say "С... с чем, Кексик?"

# ch/samantha/events.rpy:3866
translate russian samantha_event_A03_ae4012ee:
    mike.say "С... с чем, Сэм?"

# ch/samantha/events.rpy:3868
translate russian samantha_event_A03_0631871f:
    "Теперь Сэм чуть улыбается и смеётся, слегка отводя взгляд."

# ch/samantha/events.rpy:3869
translate russian samantha_event_A03_29d8bbc1:
    "Это один из тех непринуждённых жестов, которые она делает по привычке, возможно, даже не замечая."

# ch/samantha/events.rpy:3870
translate russian samantha_event_A03_02b665fd:
    "Но для меня он всегда делает её совершенно неотразимой."

# ch/samantha/events.rpy:3871
translate russian samantha_event_A03_74c4d6a7:
    "Он каким-то образом озаряет её лицо прекраснейшим светом."

# ch/samantha/events.rpy:3873
translate russian samantha_event_A03_12793de3:
    samantha.say "Ты ещё не догадался, [lssb_samantha.hero_name()]?"

# ch/samantha/events.rpy:3874
translate russian samantha_event_A03_418f0daf:
    samantha.say "Я понимала, что то, что было у нас с Райаном, на самом деле не любовь."

# ch/samantha/events.rpy:3875
translate russian samantha_event_A03_303333b3:
    samantha.say "Потому что в то же время ты показывал мне настоящую!"

# ch/samantha/events.rpy:3876
translate russian samantha_event_A03_05976abc:
    "Произнося это, Сэм смотрит мне прямо в глаза."

# ch/samantha/events.rpy:3877
translate russian samantha_event_A03_bcb8f882:
    "Её слова словно ударяют меня с настоящей физической силой."

# ch/samantha/events.rpy:3878
translate russian samantha_event_A03_48887c13:
    mike.say "Т-ты... Ты хочешь сказать?!"

# ch/samantha/events.rpy:3880
translate russian samantha_event_A03_17d57361:
    samantha.say "Да, [lssb_samantha.hero_name()], я люблю тебя!"

# ch/samantha/events.rpy:3881
translate russian samantha_event_A03_a31cbe79:
    samantha.say "Я бы сказала раньше, правда."

# ch/samantha/events.rpy:3882
translate russian samantha_event_A03_42615733:
    samantha.say "Но боялась, что ещё не готова, что не разобралась в себе. Понимаешь?"

# ch/samantha/events.rpy:3884
translate russian samantha_event_A03_7246f69f:
    mike.say "Всё... Всё хорошо, Кексик... Хорошо!"

# ch/samantha/events.rpy:3886
translate russian samantha_event_A03_1cf1c2d1:
    mike.say "Всё... Всё хорошо, Сэм... Хорошо!"

# ch/samantha/events.rpy:3887
translate russian samantha_event_A03_046e3eaa:
    mike.say "Ради этого... Ради этого стоило подождать!"

# ch/samantha/events.rpy:3889
translate russian samantha_event_A03_49a3d43e:
    "Сэм снова смеётся, явно забавляясь моей бурной реакцией."

# ch/samantha/events.rpy:3890
translate russian samantha_event_A03_426e4b55:
    samantha.say "Ух ты, [lssb_samantha.hero_name()]."

# ch/samantha/events.rpy:3891
translate russian samantha_event_A03_257c2f80:
    samantha.say "А я думала, это я не справлюсь с эмоциями!"

# ch/samantha/events.rpy:3892
translate russian samantha_event_A03_5823072e:
    samantha.say "Может, это поможет?"

# ch/samantha/events.rpy:3895
translate russian samantha_event_A03_5c9be939:
    "С этими словами Сэм наклоняется и прижимается губами к моим."

# ch/samantha/events.rpy:3896
translate russian samantha_event_A03_485e651b:
    "В тот же миг я чувствую, как напряжение и тревога покидают тело."

# ch/samantha/events.rpy:3897
translate russian samantha_event_A03_01484346:
    "По мере того как поцелуй становится всё страстнее, им на смену приходит безмятежное счастье."

# ch/samantha/events.rpy:3898
translate russian samantha_event_A03_856ca69e:
    "У меня получилось!"

# ch/samantha/events.rpy:3899
translate russian samantha_event_A03_0a0c679a:
    "Я спас подругу от брака с придурком и завоевал сердце девушки своей мечты."

# ch/samantha/events.rpy:3900
translate russian samantha_event_A03_1394bbf0:
    "Причём одновременно: ведь это один и тот же человек!"

# ch/samantha/events.rpy:3907
translate russian samantha_event_A04_11a4aa16:
    "Стоило понимать, что этот золотой период не продлится вечно: Сэм принадлежала только мне, и никаких сложностей."

# ch/samantha/events.rpy:3908
translate russian samantha_event_A04_0d27a5f5:
    "Наверное, меня просто захлестнула радость от того, что я наконец добился девушки, о которой всегда мечтал."

# ch/samantha/events.rpy:3909
translate russian samantha_event_A04_a6b2228d:
    "Я слишком увлёкся ощущением, что мне всё сойдёт с рук, и не замечал происходящего прямо под носом."

# ch/samantha/events.rpy:3910
translate russian samantha_event_A04_7c8e939e:
    "В общем, сам виноват. Теперь я это понимаю."

# ch/samantha/events.rpy:3911
translate russian samantha_event_A04_d93b6d5b:
    "Как я мог думать, что подобное сойдёт мне с рук?"

# ch/samantha/events.rpy:3912
translate russian samantha_event_A04_28d6e43f:
    "Нужно было заранее придумать оправдание, подготовить объяснение."

# ch/samantha/events.rpy:3913
translate russian samantha_event_A04_94f45092:
    "Но когда Сэм задаёт неизбежный вопрос, я оказываюсь совершенно не готов."

# ch/samantha/events.rpy:3915
translate russian samantha_event_A04_23af14f8:
    samantha.say "[lssb_samantha.hero_name()], мне нужно кое-что спросить."

# ch/samantha/events.rpy:3917
translate russian samantha_event_A04_6e31d427:
    mike.say "Эм, хорошо, Кексик."

# ch/samantha/events.rpy:3919
translate russian samantha_event_A04_205283c7:
    mike.say "Эм, хорошо, Сэм."

# ch/samantha/events.rpy:3920
translate russian samantha_event_A04_d6ebbe2b:
    mike.say "Что такое?"

# ch/samantha/events.rpy:3922
translate russian samantha_event_A04_b86e7b2a:
    samantha.say "С тех пор как мы начали встречаться, ты очень скрытничаешь со своим телефоном."

# ch/samantha/events.rpy:3923
translate russian samantha_event_A04_143b520d:
    samantha.say "Никогда не оставляешь его разблокированным рядом со мной и не показываешь сообщения."

# ch/samantha/events.rpy:3924
translate russian samantha_event_A04_bf23ff21:
    mike.say "А... Ну..."

# ch/samantha/events.rpy:3925
translate russian samantha_event_A04_159e3202:
    mike.say "Это просто рабочие дела, понимаешь?"

# ch/samantha/events.rpy:3926
translate russian samantha_event_A04_f6a6b4d1:
    mike.say "Я должен сохранять конфиденциальность."

# ch/samantha/events.rpy:3927
translate russian samantha_event_A04_bbaf750e:
    mike.say "Да и ничего интересного там нет."

# ch/samantha/events.rpy:3929
translate russian samantha_event_A04_39fc36fe:
    "Сэм смотрит на меня искоса."

# ch/samantha/events.rpy:3930
translate russian samantha_event_A04_64bede91:
    "Она кивает, но по лицу видно: не верит."

# ch/samantha/events.rpy:3931
translate russian samantha_event_A04_4b488b42:
    samantha.say "Да, наверное."

# ch/samantha/events.rpy:3932
translate russian samantha_event_A04_8bf34a53:
    samantha.say "Но я почти уверена, что на днях ты назвал меня чужим именем."

# ch/samantha/events.rpy:3933
translate russian samantha_event_A04_7f3c664e:
    samantha.say "[lssb_samantha.hero_name()], будь со мной честен, ладно?"

# ch/samantha/events.rpy:3935
translate russian samantha_event_A04_0af65905:
    samantha.say "Ты встречаешься с другими девушками за моей спиной?"

# ch/samantha/events.rpy:3936
translate russian samantha_event_A04_c7741dfa:
    "Я изо всех сил стараюсь не показывать, что вопрос застал меня врасплох."

# ch/samantha/events.rpy:3937
translate russian samantha_event_A04_0cac2128:
    "Но уже чувствую, как начинаю потеть."

# ch/samantha/events.rpy:3938
translate russian samantha_event_A04_064ea866:
    "Что ей сказать?"

# ch/samantha/events.rpy:3939
translate russian samantha_event_A04_9ee02663:
    "Признаться в измене и принять последствия?"

# ch/samantha/events.rpy:3940
translate russian samantha_event_A04_247c3c02:
    "Или отшутиться и начать бессовестно врать?"

# ch/samantha/events.rpy:3943
translate russian samantha_event_A04_ce6216ba:
    "Не могу."

# ch/samantha/events.rpy:3944
translate russian samantha_event_A04_58727920:
    "Я просто не могу лгать Сэм."

# ch/samantha/events.rpy:3945
translate russian samantha_event_A04_c8076861:
    "Да, так было бы проще."

# ch/samantha/events.rpy:3946
translate russian samantha_event_A04_0907ff31:
    "Но тогда я ничем не лучше этого козла Райана."

# ch/samantha/events.rpy:3948
translate russian samantha_event_A04_19285ac9:
    mike.say "Ладно, Кексик, ты меня раскусила."

# ch/samantha/events.rpy:3950
translate russian samantha_event_A04_5eb73864:
    mike.say "Ладно, Сэм, ты меня раскусила."

# ch/samantha/events.rpy:3951
translate russian samantha_event_A04_713ab8e6:
    mike.say "Ничего серьёзного, но я действительно встречался с другими девушками."

# ch/samantha/events.rpy:3953
translate russian samantha_event_A04_b638fe71:
    "Сэм смотрит на меня и медленно кивает."

# ch/samantha/events.rpy:3954
translate russian samantha_event_A04_b41ad435:
    "Я ожидал, что она взорвётся и тут же меня бросит."

# ch/samantha/events.rpy:3955
translate russian samantha_event_A04_f5259ee2:
    "А она, похоже, даже чувствует облегчение!"

# ch/samantha/events.rpy:3957
translate russian samantha_event_A04_fdcadd32:
    mike.say "Я... Пойму, если ты захочешь всё закончить, Кексик."

# ch/samantha/events.rpy:3959
translate russian samantha_event_A04_9a12560c:
    mike.say "Я... Пойму, если ты захочешь всё закончить, Сэм."

# ch/samantha/events.rpy:3960
translate russian samantha_event_A04_e7c04408:
    mike.say "И, хоть это мало что меняет, прости меня, ладно?"

# ch/samantha/events.rpy:3962
translate russian samantha_event_A04_bdbcd7f9:
    samantha.say "Это не то, что я хотела услышать, [lssb_samantha.hero_name()]."

# ch/samantha/events.rpy:3963
translate russian samantha_event_A04_2af0ae08:
    samantha.say "Уж точно!"

# ch/samantha/events.rpy:3964
translate russian samantha_event_A04_c301fe55:
    mike.say "Но..."

# ch/samantha/events.rpy:3966
translate russian samantha_event_A04_7def92df:
    samantha.say "Но наши отношения начались не в самых лучших обстоятельствах, правда?"

# ch/samantha/events.rpy:3967
translate russian samantha_event_A04_ef1dee30:
    samantha.say "Всё произошло в какой-то безумной спешке."

# ch/samantha/events.rpy:3968
translate russian samantha_event_A04_732ab14b:
    samantha.say "И я не припоминаю, чтобы мы сели и обсудили правила наших отношений!"

# ch/samantha/events.rpy:3969
translate russian samantha_event_A04_5be7c15a:
    mike.say "То есть ты... не хочешь меня бросить?"

# ch/samantha/events.rpy:3971
translate russian samantha_event_A04_aaf97971:
    "Сэм кивает и начинает чуть улыбаться."

# ch/samantha/events.rpy:3972
translate russian samantha_event_A04_93edea36:
    samantha.say "Нет. Я просто хочу, чтобы ты перестал встречаться с другими. Вот и всё."

# ch/samantha/events.rpy:3973
translate russian samantha_event_A04_98c9d9a7:
    samantha.say "Если отношения с Райаном чему-то меня научили, так это тому, что идеальных людей не бывает."

# ch/samantha/events.rpy:3974
translate russian samantha_event_A04_b780b7c5:
    samantha.say "Но сейчас ты сделал то, чего Райан не сделал бы никогда, [lssb_samantha.hero_name()]."

# ch/samantha/events.rpy:3975
translate russian samantha_event_A04_b1cdf744:
    samantha.say "Ты сказал правду и попросил прощения."

# ch/samantha/events.rpy:3976
translate russian samantha_event_A04_e01a9e0c:
    samantha.say "Значит, я знаю, что небезразлична тебе."

# ch/samantha/events.rpy:3978
translate russian samantha_event_A04_c3e7564f:
    mike.say "Ты... Ты мне небезразлична, Кексик."

# ch/samantha/events.rpy:3980
translate russian samantha_event_A04_ab4681db:
    mike.say "Ты... Ты мне небезразлична, Сэм."

# ch/samantha/events.rpy:3981
translate russian samantha_event_A04_2e105772:
    mike.say "Правда."

# ch/samantha/events.rpy:3982
translate russian samantha_event_A04_ec1882df:
    samantha.say "Зная это, я могу дать тебе ещё один шанс."

# ch/samantha/events.rpy:3984
translate russian samantha_event_A04_a01c4b32:
    samantha.say "Просто пообещай, что будешь верен. Только и всего."

# ch/samantha/events.rpy:3988
translate russian samantha_event_A04_531723ae:
    mike.say "Обещаю, Кексик."

# ch/samantha/events.rpy:3990
translate russian samantha_event_A04_b2a45e37:
    mike.say "Обещаю, Сэм."

# ch/samantha/events.rpy:3991
translate russian samantha_event_A04_c85e812f:
    mike.say "С этого момента мы только друг у друга."

# ch/samantha/events.rpy:3993
translate russian samantha_event_A04_92fa348f:
    "Сэм радостно кивает и целует меня в щёку."

# ch/samantha/events.rpy:3994
translate russian samantha_event_A04_de2fe098:
    samantha.say "Это всё, что мне нужно было услышать!"

# ch/samantha/events.rpy:3998
translate russian samantha_event_A04_77535f03:
    mike.say "Прости, Кексик."

# ch/samantha/events.rpy:4000
translate russian samantha_event_A04_e84e0030:
    mike.say "Прости, Сэм."

# ch/samantha/events.rpy:4001
translate russian samantha_event_A04_d70c4cd9:
    mike.say "Не знаю, настолько ли я готов к серьёзным отношениям, чтобы обещать тебе верность."

# ch/samantha/events.rpy:4003
translate russian samantha_event_A04_8b459069:
    samantha.say "Очень жаль."

# ch/samantha/events.rpy:4004
translate russian samantha_event_A04_67734259:
    samantha.say "Мне и так было тяжело, когда я узнала о Райане. Не могу позволить обмануть себя снова."

# ch/samantha/events.rpy:4005
translate russian samantha_event_A04_30009db6:
    samantha.say "Прощай, [lssb_samantha.hero_name()]."

# ch/samantha/events.rpy:4007
translate russian samantha_event_A04_667dd73e:
    "Сказав это, она уходит."

# ch/samantha/events.rpy:4010
translate russian samantha_event_A04_c4ce8b4a:
    "Я ни за что не стану лгать Сэм."

# ch/samantha/events.rpy:4011
translate russian samantha_event_A04_d24b6b6e:
    "Даже если она в итоге меня бросит."

# ch/samantha/events.rpy:4012
translate russian samantha_event_A04_26387ea4:
    "Иначе я буду ничем не лучше Райана."

# ch/samantha/events.rpy:4013
translate russian samantha_event_A04_267e363c:
    "Ещё одним лживым изменником!"

# ch/samantha/events.rpy:4015
translate russian samantha_event_A04_89f1b522:
    mike.say "Я не могу тебе лгать, Кексик."

# ch/samantha/events.rpy:4017
translate russian samantha_event_A04_f3f6e28e:
    mike.say "Я не могу тебе лгать, Сэм."

# ch/samantha/events.rpy:4018
translate russian samantha_event_A04_87045a12:
    mike.say "После того как мы стали парой, я несколько раз ходил на свидания с другими девушками."

# ch/samantha/events.rpy:4019
translate russian samantha_event_A04_b2ecdc06:
    "Я всё жду, что Сэм вот-вот взорвётся."

# ch/samantha/events.rpy:4020
translate russian samantha_event_A04_b5cb5101:
    "Думаю, может, она набросится на меня, ударит или что-нибудь ещё."

# ch/samantha/events.rpy:4022
translate russian samantha_event_A04_c4a69311:
    "Но вместо этого она кивает и выглядит почти облегчённой."

# ch/samantha/events.rpy:4023
translate russian samantha_event_A04_2b884be1:
    mike.say "Ты... Ты не злишься?"

# ch/samantha/events.rpy:4024
translate russian samantha_event_A04_ad46eed5:
    mike.say "Я думал, ты захочешь меня убить!"

# ch/samantha/events.rpy:4026
translate russian samantha_event_A04_8b0f50ad:
    "Сэм застаёт меня врасплох, вдруг заливаясь смехом."

# ch/samantha/events.rpy:4027
translate russian samantha_event_A04_87ac5e4d:
    "Так громко и внезапно, что я невольно думаю: не сходит ли она с ума?"

# ch/samantha/events.rpy:4028
translate russian samantha_event_A04_d592ac1f:
    samantha.say "Господи, конечно нет, [lssb_samantha.hero_name()]!"

# ch/samantha/events.rpy:4030
translate russian samantha_event_A04_9e1bc20c:
    samantha.say "В конце концов, когда всё началось, мы сами действовали за спиной у Райана."

# ch/samantha/events.rpy:4031
translate russian samantha_event_A04_41751d98:
    samantha.say "А я, блядь, не лицемерка!"

# ch/samantha/events.rpy:4032
translate russian samantha_event_A04_11973897:
    mike.say "То есть... ты... не хочешь со мной расстаться?"

# ch/samantha/events.rpy:4033
translate russian samantha_event_A04_9bf7004f:
    samantha.say "Нет, [lssb_samantha.hero_name()]. Просто хочу, чтобы ты был со мной честен."

# ch/samantha/events.rpy:4035
translate russian samantha_event_A04_89e544f5:
    samantha.say "Понимаешь, раньше я считала, что самое плохое в поступках Райана — это секс с другими девушками."

# ch/samantha/events.rpy:4036
translate russian samantha_event_A04_51f685dc:
    samantha.say "Но то, что было между нами, помогло мне понять: ложь хуже."

# ch/samantha/events.rpy:4038
translate russian samantha_event_A04_e5fbbb59:
    samantha.say "Поэтому просто обещай впредь быть со мной честным, ладно?"

# ch/samantha/events.rpy:4039
translate russian samantha_event_A04_7a6ec22c:
    samantha.say "Если с кем-то потрахаешься, расскажи мне всё."

# ch/samantha/events.rpy:4041
translate russian samantha_event_A04_61397979:
    samantha.say "Кто знает, может, мне даже понравится слушать!"

# ch/samantha/events.rpy:4042
translate russian samantha_event_A04_264792ba:
    "Я молча киваю, совершенно ошеломлённый словами Сэм."

# ch/samantha/events.rpy:4043
translate russian samantha_event_A04_1ed82bf7:
    "Может, я сейчас сплю и всё это мне снится?"

# ch/samantha/events.rpy:4044
translate russian samantha_event_A04_288a0d49:
    "Потому что, чёрт возьми, она словно только что разрешила мне гулять налево."

# ch/samantha/events.rpy:4045
translate russian samantha_event_A04_eaa028ad:
    "Трахать кого захочу, если она будет обо всём знать!"

# ch/samantha/events.rpy:4046
translate russian samantha_event_A04_fcf04851:
    "Когда я наконец нахожу слова, то изо всех сил стараюсь говорить спокойно и невозмутимо."

# ch/samantha/events.rpy:4048
translate russian samantha_event_A04_8f68facd:
    mike.say "Да, Кексик, как скажешь."

# ch/samantha/events.rpy:4050
translate russian samantha_event_A04_9eeebd2b:
    mike.say "Да, Сэм, как скажешь."

# ch/samantha/events.rpy:4051
translate russian samantha_event_A04_1135c4aa:
    mike.say "То есть если ты этого хочешь."

# ch/samantha/events.rpy:4052
translate russian samantha_event_A04_cd70704a:
    mike.say "Думаю, у нас получится!"

# ch/samantha/events.rpy:4054
translate russian samantha_event_A04_77e5c784:
    "По улыбке Сэм понятно: она видит меня насквозь."

# ch/samantha/events.rpy:4055
translate russian samantha_event_A04_473b04cb:
    "Но всё равно кивает и целует в щёку."

# ch/samantha/events.rpy:4056
translate russian samantha_event_A04_de2fe098_1:
    samantha.say "Это всё, что мне нужно было услышать!"

# ch/samantha/events.rpy:4060
translate russian samantha_event_A04_9c25b4f5:
    "Я никак не могу этого сделать."

# ch/samantha/events.rpy:4061
translate russian samantha_event_A04_e4583320:
    "Не могу сказать Сэм правду!"

# ch/samantha/events.rpy:4062
translate russian samantha_event_A04_4f67a0af:
    "Не после того, сколько времени понадобилось, чтобы мы оказались здесь."

# ch/samantha/events.rpy:4063
translate russian samantha_event_A04_373db3a5:
    "Если она узнает, что я такой же мерзкий изменник, как Райан..."

# ch/samantha/events.rpy:4064
translate russian samantha_event_A04_dc374d65:
    "Нет, остаётся только бессовестно врать и надеяться, что она поверит!"

# ch/samantha/events.rpy:4066
translate russian samantha_event_A04_d7757a65:
    mike.say "Ни за что, Кексик!"

# ch/samantha/events.rpy:4068
translate russian samantha_event_A04_9acf0f0e:
    mike.say "Ни за что, Сэм!"

# ch/samantha/events.rpy:4069
translate russian samantha_event_A04_5f800b68:
    mike.say "Даже не думай об этом."

# ch/samantha/events.rpy:4070
translate russian samantha_event_A04_d7b5471c:
    "Когда я начинаю лгать, Сэм прищуривается."

# ch/samantha/events.rpy:4071
translate russian samantha_event_A04_2af5817d:
    "И скрещивает руки на груди."

# ch/samantha/events.rpy:4073
translate russian samantha_event_A04_797e9c75:
    samantha.say "Тогда что происходит?"

# ch/samantha/events.rpy:4074
translate russian samantha_event_A04_dc0f482d:
    samantha.say "И лучше пусть объяснение будет убедительным."

# ch/samantha/events.rpy:4076
translate russian samantha_event_A04_3d18c73e:
    samantha.say "Потому что Райан врал постоянно. И посмотри, к чему это его привело!"

# ch/samantha/events.rpy:4077
translate russian samantha_event_A04_8e7118d5:
    "Да-да, Сэм. Ты ведь ничего не замечала, пока я не сунул доказательства тебе под нос!"

# ch/samantha/events.rpy:4078
translate russian samantha_event_A04_6e28c46b:
    "Не знаю, откуда берётся эта мысль, но вот она."

# ch/samantha/events.rpy:4079
translate russian samantha_event_A04_1de20b86:
    "Как она смеет учить меня говорить правду?"

# ch/samantha/events.rpy:4080
translate russian samantha_event_A04_07e6b365:
    "Особенно после того, как сама так долго жила во лжи с тем парнем."

# ch/samantha/events.rpy:4081
translate russian samantha_event_A04_91664deb:
    "Да ещё и хотела отплатить ему той же монетой!"

# ch/samantha/events.rpy:4082
translate russian samantha_event_A04_eea9d10f:
    "Но бросить всё это ей в лицо я не могу, поэтому выбираю другой путь."

# ch/samantha/events.rpy:4084
translate russian samantha_event_A04_198b436c:
    mike.say "Дело ведь совсем не во мне, правда, Кексик?"

# ch/samantha/events.rpy:4086
translate russian samantha_event_A04_80a3a90b:
    mike.say "Дело ведь совсем не во мне, правда, Сэм?"

# ch/samantha/events.rpy:4087
translate russian samantha_event_A04_b7752d78:
    mike.say "Дело в Райане и в том, как он тебя ранил."

# ch/samantha/events.rpy:4090
translate russian samantha_event_A04_510f3e34:
    samantha.say "Ч-что ты имеешь в виду?"

# ch/samantha/events.rpy:4091
translate russian samantha_event_A04_81cb2bc9:
    mike.say "Ты доверяла Райану, а он тебя предал."

# ch/samantha/events.rpy:4092
translate russian samantha_event_A04_ea0a43ee:
    mike.say "Естественно, теперь ты боишься, что я поступлю так же."

# ch/samantha/events.rpy:4093
translate russian samantha_event_A04_6144dfa0:
    mike.say "Но ничего, я тебя прощаю."

# ch/samantha/events.rpy:4095
translate russian samantha_event_A04_d791202b:
    "Осмысливая мои слова, Сэм растерянно качает головой."

# ch/samantha/events.rpy:4096
translate russian samantha_event_A04_f2b40fd4:
    samantha.say "Нет... Нет, дело не в этом..."

# ch/samantha/events.rpy:4097
translate russian samantha_event_A04_b427ddcd:
    samantha.say "Но... Может, ты и прав, [lssb_samantha.hero_name()]."

# ch/samantha/events.rpy:4098
translate russian samantha_event_A04_38eb2341:
    samantha.say "Наверное, я просто не думала об этом с такой стороны!"

# ch/samantha/events.rpy:4099
translate russian samantha_event_A04_113e0c89:
    "Я понимаю, что заставляю её сомневаться в собственном восприятии, но, похоже, это работает."

# ch/samantha/events.rpy:4100
translate russian samantha_event_A04_d843e276:
    "Киваю и улыбаюсь, поддерживая её в этой мысли."

# ch/samantha/events.rpy:4102
translate russian samantha_event_A04_67559351:
    "Сэм тоже кивает и целует меня в щёку."

# ch/samantha/events.rpy:4103
translate russian samantha_event_A04_de2fe098_2:
    samantha.say "Это всё, что мне нужно было услышать!"

# ch/samantha/events.rpy:4119
translate russian samantha_event_B01_bbc5dbcb:
    "Пора на свадьбу Сэм и Райана."

# ch/samantha/events.rpy:4121
translate russian samantha_event_B01_2c5a2e8f:
    "Церковные колокола звонят так громко, что режут слух, словно лично хотят меня пристыдить."

# ch/samantha/events.rpy:4122
translate russian samantha_event_B01_43477441:
    "День свадьбы Саманты наступил быстро. Слишком быстро."

# ch/samantha/events.rpy:4124
translate russian samantha_event_B01_f61e34a4:
    "Не могу перестать думать о Райане."

# ch/samantha/events.rpy:4125
translate russian samantha_event_B01_82a329f4:
    "Он лжец и изменник, а я промолчал."

# ch/samantha/events.rpy:4126
translate russian samantha_event_B01_05009eae:
    "Но ведь так лучше, правда?"

# ch/samantha/events.rpy:4127
translate russian samantha_event_B01_4171ca0a:
    "Сэм счастлива, и только это для меня важно."

# ch/samantha/events.rpy:4128
translate russian samantha_event_B01_e1297678:
    "Девушка" "О боже! [lssb_samantha.hero_name()], это правда ты?"

# ch/samantha/events.rpy:4130
translate russian samantha_event_B01_e15f10ea:
    "Я оборачиваюсь и вижу одну из подруг Саманты, одетую в оговорённых цветах."

# ch/samantha/events.rpy:4131
translate russian samantha_event_B01_4c3a9c47:
    "Лицо знакомое, но воспоминания лишь смутные."

# ch/samantha/events.rpy:4132
translate russian samantha_event_B01_bd1436e1:
    "Девушка" "Сто лет тебя не видела! Как ты?"

# ch/samantha/events.rpy:4133
translate russian samantha_event_B01_c4901335:
    mike.say "Эм... Отлично."

# ch/samantha/events.rpy:4134
translate russian samantha_event_B01_45f9e04c:
    "Всё отлично."

# ch/samantha/events.rpy:4135
translate russian samantha_event_B01_8dc975a3:
    "Просто замечательно."

# ch/samantha/events.rpy:4137
translate russian samantha_event_B01_8128ac97:
    "Девушка" "Здорово!"

# ch/samantha/events.rpy:4138
translate russian samantha_event_B01_09c78b52:
    "Девушка" "Представляешь, они наконец женятся!"

# ch/samantha/events.rpy:4139
translate russian samantha_event_B01_49a56cfc:
    "Девушка" "Будто только вчера ворковали друг с другом на первом курсе."

# ch/samantha/events.rpy:4142
translate russian samantha_event_B01_f8db339c:
    mike.say "Ага."

# ch/samantha/events.rpy:4143
translate russian samantha_event_B01_fd7e5f5c:
    "Сэм выглядит очень счастливой."

# ch/samantha/events.rpy:4144
translate russian samantha_event_B01_61432a83:
    mike.say "Она давно этого ждала."

# ch/samantha/events.rpy:4145
translate russian samantha_event_B01_1c2c141b:
    "Девушка умиляется, глядя на меня, словно женюсь я."

# ch/samantha/events.rpy:4146
translate russian samantha_event_B01_975c4ef5:
    "Девушка" "Они такие милые!"

# ch/samantha/events.rpy:4148
translate russian samantha_event_B01_f4c86d0f:
    mike.say "Тебе не кажется, что они немного торопятся?"

# ch/samantha/events.rpy:4149
translate russian samantha_event_B01_a0cd0446:
    mike.say "Они слишком молоды для такого серьёзного шага."

# ch/samantha/events.rpy:4151
translate russian samantha_event_B01_20211ad2:
    "Девушка" "Что?!"

# ch/samantha/events.rpy:4152
translate russian samantha_event_B01_f2bd7ef4:
    "Девушка" "Если кому-то и стоит жениться немедленно, так это им!"

# ch/samantha/events.rpy:4154
translate russian samantha_event_B01_38cf2a68:
    "Девушка" "Райан ей идеально подходит: любящий, милый... Он даст ей всё, что нужно."

# ch/samantha/events.rpy:4155
translate russian samantha_event_B01_1263e952:
    "Больно."

# ch/samantha/events.rpy:4156
translate russian samantha_event_B01_aa1dbf82:
    "Девушка" "Я уже видела платье Сэм."

# ch/samantha/events.rpy:4157
translate russian samantha_event_B01_df7ecb01:
    "Девушка" "Она настоящая богиня!"

# ch/samantha/events.rpy:4158
translate russian samantha_event_B01_9776e558:
    "Девушка" "Райану повезло."

# ch/samantha/events.rpy:4159
translate russian samantha_event_B01_1c77a6aa:
    mike.say "А. Ты подружка невесты?"

# ch/samantha/events.rpy:4160
translate russian samantha_event_B01_cf445793:
    "Девушка" "Ага! Когда она попросила, я даже помыслить не могла об отказе."

# ch/samantha/events.rpy:4161
translate russian samantha_event_B01_552133c0:
    "Если честно, я думал, она и мне предложит какую-нибудь роль."

# ch/samantha/events.rpy:4162
translate russian samantha_event_B01_1083507c:
    "Наверняка тут не обошлось без Райана."

# ch/samantha/events.rpy:4163
translate russian samantha_event_B01_0968b25f:
    mike.say "...Здорово."

# ch/samantha/events.rpy:4165
translate russian samantha_event_B01_60b53e4b:
    "Девушка" "Слышала, вы какое-то время жили втроём."

# ch/samantha/events.rpy:4166
translate russian samantha_event_B01_dc4e8110:
    "Она наклоняется ко мне, словно делится секретом."

# ch/samantha/events.rpy:4167
translate russian samantha_event_B01_cfc25c07:
    "Девушка" "Не слишком шумно было?"

# ch/samantha/events.rpy:4168
translate russian samantha_event_B01_82a176ec:
    "Почему, чёрт возьми, все так запросто говорят о подобных вещах?"

# ch/samantha/events.rpy:4169
translate russian samantha_event_B01_fba112e6:
    mike.say "Чт... Нет!"

# ch/samantha/events.rpy:4171
translate russian samantha_event_B01_ed569542:
    "Девушка" "Значит, точно шумели!"

# ch/samantha/events.rpy:4172
translate russian samantha_event_B01_fc6c6889:
    "Я со стоном оглядываюсь в поисках другого собеседника."

# ch/samantha/events.rpy:4173
translate russian samantha_event_B01_75572d3a:
    "Но все уже увлечённо беседуют, радуясь за будущих молодожёнов."

# ch/samantha/events.rpy:4174
translate russian samantha_event_B01_a18f560f:
    "Похоже, придётся довольствоваться этим."

# ch/samantha/events.rpy:4177
translate russian samantha_event_B01_02a9cae2:
    "Давно ты знаешь Саманту?"

# ch/samantha/events.rpy:4179
translate russian samantha_event_B01_a06c9c15:
    "Девушка" "Хм... Кажется, со средней школы."

# ch/samantha/events.rpy:4180
translate russian samantha_event_B01_d7ae1036:
    "Девушка" "Мы познакомились на обществознании."

# ch/samantha/events.rpy:4181
translate russian samantha_event_B01_a244eb1f:
    "Девушка" "Я долго болела, и она помогла наверстать пропущенное. С тех пор мы лучшие подруги!"

# ch/samantha/events.rpy:4182
translate russian samantha_event_B01_680db273:
    mike.say "Очень на неё похоже."

# ch/samantha/events.rpy:4183
translate russian samantha_event_B01_62ee7662:
    mike.say "Она милая девушка."

# ch/samantha/events.rpy:4185
translate russian samantha_event_B01_56c719ea:
    "Девушка" "Ха! И сладкая во всех смыслах."

# ch/samantha/events.rpy:4186
translate russian samantha_event_B01_c2484bd8:
    "Девушка" "Та ещё сладкоежка."

# ch/samantha/events.rpy:4187
translate russian samantha_event_B01_43f734c6:
    mike.say "Ага, не зря же работает в пекарне."

# ch/samantha/events.rpy:4188
translate russian samantha_event_B01_cd8e728f:
    mike.say "Иногда думаю, она бы и за оплату десертами там работала."

# ch/samantha/events.rpy:4189
translate russian samantha_event_B01_d934e3c9:
    "Девушка" "Или просто за булочки с корицей."

# ch/samantha/events.rpy:4190
translate russian samantha_event_B01_99b0cfca:
    "Девушка" "Помню, каждый день приносила такую на обед."

# ch/samantha/events.rpy:4191
translate russian samantha_event_B01_af21ec2d:
    "Девушка" "Потом мама запретила: она каждый раз возвращалась домой вся на взводе от сладкого."

# ch/samantha/events.rpy:4192
translate russian samantha_event_B01_8f5105dc:
    "Девушка" "Сэм была такой милой!"

# ch/samantha/events.rpy:4194
translate russian samantha_event_B01_2e9d9f14:
    mike.say "Кто-нибудь помогал ей всё это организовать?"

# ch/samantha/events.rpy:4196
translate russian samantha_event_B01_06adf0a6:
    mike.say "От Райана, наверное, помощи было мало. Он вечно... работает."

# ch/samantha/events.rpy:4197
translate russian samantha_event_B01_a77c92f6:
    "Я стараюсь не подавиться последним словом."

# ch/samantha/events.rpy:4198
translate russian samantha_event_B01_1595f1c6:
    "Девушка" "Я! Ну, среди прочих. Во многом ей помогла мама."

# ch/samantha/events.rpy:4200
translate russian samantha_event_B01_8f2859c3:
    mike.say "Это хорошо."

# ch/samantha/events.rpy:4201
translate russian samantha_event_B01_21b43e24:
    "Девушка" "Да! Хотя, надо сказать, мы сделали не так уж много."

# ch/samantha/events.rpy:4202
translate russian samantha_event_B01_fa49f298:
    "Девушка" "Просто немного помогли ей приблизиться к мечте!"

# ch/samantha/events.rpy:4204
translate russian samantha_event_B01_bc0f566d:
    "Девушка" "Обожаю цвета, которые она выбрала."

# ch/samantha/events.rpy:4205
translate russian samantha_event_B01_20c7f04f:
    "Девушка" "И ей они идеально подходят."

# ch/samantha/events.rpy:4206
translate russian samantha_event_B01_275c21b2:
    "Я внимательно оглядываюсь: церковь украшена в белых и насыщенно-золотых тонах."

# ch/samantha/events.rpy:4207
translate russian samantha_event_B01_57cdb41e:
    "Просто, но заметно."

# ch/samantha/events.rpy:4208
translate russian samantha_event_B01_54910074:
    "Цвета элегантные, а вот остальные украшения, которые я заметил в банкетном зале по пути сюда, довольно сдержанные."

# ch/samantha/events.rpy:4209
translate russian samantha_event_B01_8cbb5fe1:
    mike.say "По-моему, это очень в её духе."

# ch/samantha/events.rpy:4211
translate russian samantha_event_B01_feaf1650:
    mike.say "Знаешь, чем будут угощать?"

# ch/samantha/events.rpy:4212
translate russian samantha_event_B01_b08299a1:
    "Девушка" "Ну конечно, она выбрала всё самое сладкое в меню."

# ch/samantha/events.rpy:4213
translate russian samantha_event_B01_51317a03:
    "Девушка" "Утка с шоколадным соусом, картофельное пюре и салат."

# ch/samantha/events.rpy:4215
translate russian samantha_event_B01_da787a10:
    "Девушка" "Но, между нами, насчёт последнего её наверняка уговорил Райан."

# ch/samantha/events.rpy:4216
translate russian samantha_event_B01_b9db10e7:
    mike.say "Шоколадным соусом?"

# ch/samantha/events.rpy:4217
translate russian samantha_event_B01_c6c02211:
    "Девушка" "Ага. Странно, но это самое изысканное сладкое блюдо, которое она нашла."

# ch/samantha/events.rpy:4218
translate russian samantha_event_B01_09451411:
    "Девушка" "И поверь, она часами изучала меню."

# ch/samantha/events.rpy:4220
translate russian samantha_event_B01_a8530df0:
    "Девушка" "Ей очень хочется, чтобы всё было идеально."

# ch/samantha/events.rpy:4221
translate russian samantha_event_B01_8c0e1a50:
    mike.say "Знаешь, во сколько начало?"

# ch/samantha/events.rpy:4222
translate russian samantha_event_B01_bb80aa6b:
    "Она смотрит на наручные часы и задумчиво мычит."

# ch/samantha/events.rpy:4223
translate russian samantha_event_B01_e4db3bb0:
    "Девушка" "Уже совсем скоро."

# ch/samantha/events.rpy:4224
translate russian samantha_event_B01_7d6e1e37:
    "Девушка" "Нужно будет занять места."

# ch/samantha/events.rpy:4225
translate russian samantha_event_B01_28639425:
    "Не проходит и минуты, как мужчина в облачении священнослужителя привлекает наше внимание и просит приготовиться."

# ch/samantha/events.rpy:4227
translate russian samantha_event_B01_76c12c4f:
    "Я без труда нахожу своё место."

# ch/samantha/events.rpy:4228
translate russian samantha_event_B01_c78c0fd8:
    "Подруга Саманты, как бы её ни звали, спешит наружу под руку с другом жениха. Двери закрываются раньше, чем я успеваю его рассмотреть."

# ch/samantha/events.rpy:4229
translate russian samantha_event_B01_eb0a5524:
    "Райан стоит впереди, нервно перебирая пальцами, но с широкой улыбкой на лице."

# ch/samantha/events.rpy:4230
translate russian samantha_event_B01_89fd5652:
    "Если бы я не знал, что происходит, назвал бы это откровенной ухмылкой. Но стараюсь отогнать эту мысль подальше."

# ch/samantha/events.rpy:4231
translate russian samantha_event_B01_5cb0f79a:
    "Ещё какое-то время в зале шумно, потом разговоры стихают и всё заполняют звуки фортепиано."

# ch/samantha/events.rpy:4232
translate russian samantha_event_B01_3f69bc6f:
    "Я задерживаю дыхание."

# ch/samantha/events.rpy:4233
translate russian samantha_event_B01_6791f06b:
    "Зачем я сюда пришёл?"

# ch/samantha/events.rpy:4234
translate russian samantha_event_B01_e8243e65:
    "Я же не смогу на это смотреть."

# ch/samantha/events.rpy:4235
translate russian samantha_event_B01_1642a559:
    "О чём я думал?"

# ch/samantha/events.rpy:4236
translate russian samantha_event_B01_d2261685:
    "Прежде чем я успеваю вскочить и сбежать, по проходу к алтарю начинают изящно шествовать пары."

# ch/samantha/events.rpy:4237
translate russian samantha_event_B01_8c3acf04:
    "В груди что-то нарастает."

# ch/samantha/events.rpy:4238
translate russian samantha_event_B01_a118b485:
    "Вина? Сожаление? Не могу понять."

# ch/samantha/events.rpy:4239
translate russian samantha_event_B01_75d58e91:
    "Музыка кажется мне какой-то нескладной."

# ch/samantha/events.rpy:4240
translate russian samantha_event_B01_92d8d3a0:
    "С пианистом всё в порядке?"

# ch/samantha/events.rpy:4241
translate russian samantha_event_B01_b781d042:
    "Я быстро оглядываюсь."

# ch/samantha/events.rpy:4242
translate russian samantha_event_B01_1c0b0be6:
    "Остальных, кажется, ничто не беспокоит."

# ch/samantha/events.rpy:4243
translate russian samantha_event_B01_ec0c58ce:
    "А со мной всё в порядке?"

# ch/samantha/events.rpy:4244
translate russian samantha_event_B01_9f094fd9:
    "Когда мелодия меняется и двери распахиваются, сердце подскакивает к горлу."

# ch/samantha/events.rpy:4245
translate russian samantha_event_B01_fe92d78e:
    "Все оборачиваются к невесте — Саманте."

# ch/samantha/events.rpy:4247
translate russian samantha_event_B01_bad5ee14:
    "Стараюсь не смотреть."

# ch/samantha/events.rpy:4248
translate russian samantha_event_B01_6ffa6388:
    "Не получается."

# ch/samantha/events.rpy:4249
translate russian samantha_event_B01_f488378e:
    "Мне приходится сдерживать изумлённый вздох."

# ch/samantha/events.rpy:4250
translate russian samantha_event_B01_f63ef9e1:
    "На ней великолепное короткое белое платье, очень простое, но невероятно элегантное."

# ch/samantha/events.rpy:4251
translate russian samantha_event_B01_0a2e47dc:
    "Я слежу за ней взглядом, пока она идёт по проходу."

# ch/samantha/events.rpy:4252
translate russian samantha_event_B01_29bb9f1a:
    "Она замечает мой взгляд."

# ch/samantha/events.rpy:4253
translate russian samantha_event_B01_7cd7481b:
    "Улыбается мне с надеждой и невинностью."

# ch/samantha/events.rpy:4254
translate russian samantha_event_B01_076166f6:
    "Губы на мгновение перестают слушаться."

# ch/samantha/events.rpy:4257
translate russian samantha_event_B01_33a885fd:
    "Я заставляю себя улыбнуться и быстро показываю ей поднятый большой палец."

# ch/samantha/events.rpy:4258
translate russian samantha_event_B01_33aef822:
    "Её глаза сияют."

# ch/samantha/events.rpy:4261
translate russian samantha_event_B01_0693a58e:
    "Я поспешно отворачиваюсь, переводя внимание на подружек невесты."

# ch/samantha/events.rpy:4262
translate russian samantha_event_B01_699993c6:
    "Почти не могу смотреть на неё без чувства вины."

# ch/samantha/events.rpy:4263
translate russian samantha_event_B01_38ce624c:
    "Священник начинает говорить, но я слышу его лишь вполуха."

# ch/samantha/events.rpy:4264
translate russian samantha_event_B01_3941f9aa:
    "Будто наблюдаю за всем чужими глазами."

# ch/samantha/events.rpy:4265
translate russian samantha_event_B01_a20cefa7:
    "..."

# ch/samantha/events.rpy:4266
translate russian samantha_event_B01_06092107:
    "Произносятся клятвы."

# ch/samantha/events.rpy:4267
translate russian samantha_event_B01_13d6a214:
    "У Саманты на глазах слёзы."

# ch/samantha/events.rpy:4268
translate russian samantha_event_B01_b75c9864:
    samantha.say "Райан..."

# ch/samantha/events.rpy:4269
translate russian samantha_event_B01_2542ddd8:
    "Голос у неё прерывается. Она берёт его за руки и переплетает их пальцы."

# ch/samantha/events.rpy:4270
translate russian samantha_event_B01_63174343:
    samantha.say "С первого взгляда я почувствовала связь между нами."

# ch/samantha/events.rpy:4271
translate russian samantha_event_B01_c264c75a:
    samantha.say "Когда мы познакомились на первом курсе, я поняла, что хочу быть с тобой вечно."

# ch/samantha/events.rpy:4272
translate russian samantha_event_B01_cfb4927a:
    samantha.say "Ты дарил мне больше любви и доброты, чем я заслуживаю."

# ch/samantha/events.rpy:4273
translate russian samantha_event_B01_27c9622e:
    samantha.say "Могу лишь надеяться, что когда-нибудь смогу отплатить тебе тем же."

# ch/samantha/events.rpy:4274
translate russian samantha_event_B01_2e2671d6:
    "Ох, Саманта."

# ch/samantha/events.rpy:4275
translate russian samantha_event_B01_52f35db1:
    "Ты заслуживаешь гораздо большего, чем думаешь."

# ch/samantha/events.rpy:4276
translate russian samantha_event_B01_a5ce944d:
    "Не успеваю опомниться, как они уже целуются."

# ch/samantha/events.rpy:4277
translate russian samantha_event_B01_e4db5e19:
    "Сидящие рядом гости хлопают и свистят."

# ch/samantha/events.rpy:4278
translate russian samantha_event_B01_f466f452:
    "По крайней мере, она счастлива."

# ch/samantha/events.rpy:4281
translate russian samantha_event_B01_f9fb36c3:
    "Я сижу за одним из множества круглых столов в зале. Передо мной керамическая тарелка с куском утки под коричневым соусом. Наверное, шоколадным."

# ch/samantha/events.rpy:4282
translate russian samantha_event_B01_00f18da3:
    "Посреди зала танцуют."

# ch/samantha/events.rpy:4283
translate russian samantha_event_B01_3912c9bb:
    "Бодрый поп постоянно сменяется роком."

# ch/samantha/events.rpy:4284
translate russian samantha_event_B01_296e51c8:
    "Странное сочетание."

# ch/samantha/events.rpy:4285
translate russian samantha_event_B01_34a512e5:
    "Я уже не знаю, где Сэм."

# ch/samantha/events.rpy:4286
translate russian samantha_event_B01_56aae8cc:
    "Как только закончились формальности, она сразу пошла танцевать с Райаном."

# ch/samantha/events.rpy:4287
translate russian samantha_event_B01_cc322477:
    "Чем теперь заняться..."

# ch/samantha/events.rpy:4292
translate russian samantha_event_B01_611f994d:
    "Сколько бы я ни убеждал себя, что прячусь на площадке металлической пожарной лестницы за банкетным залом ради свежего воздуха, обмануть даже себя не получалось."

# ch/samantha/events.rpy:4293
translate russian samantha_event_B01_674e8e90:
    "Даже предлог тайком выкурить сигарету позволил бы хоть как-то оправдать собственное поведение."

# ch/samantha/events.rpy:4294
translate russian samantha_event_B01_bf5375d0:
    "Но оставалось лишь признаться себе: я с самого начала не хотел здесь быть."

# ch/samantha/events.rpy:4295
translate russian samantha_event_B01_1927de68:
    "И стараюсь проводить рядом с остальными гостями как можно меньше времени."

# ch/samantha/events.rpy:4296
translate russian samantha_event_B01_60a4a41e:
    "Да и кто я вообще для Сэм и Райана?"

# ch/samantha/events.rpy:4297
translate russian samantha_event_B01_116d95f7:
    "Всего лишь бывший сосед, которого, наверное, пригласили, вспомнив в последнюю минуту."

# ch/samantha/events.rpy:4298
translate russian samantha_event_B01_dda2d15d:
    "То, что я его терпеть не могу, а к ней всё ещё питаю чувства, — только моя проблема."

# ch/samantha/events.rpy:4299
translate russian samantha_event_B01_3bd4e4fb:
    "Даже если этот козёл изменял ей до самого «знаменательного дня», для них это всё равно начало новой жизни."

# ch/samantha/events.rpy:4300
translate russian samantha_event_B01_af617a5f:
    "Меньше всего им нужен я, слоняющийся рядом и напоминающий о прошлом."

# ch/samantha/events.rpy:4301
translate russian samantha_event_B01_39621265:
    "Я как раз пытаюсь взять себя в руки и вернуться в здание, когда слышу, как за спиной резко открывается дверь."

# ch/samantha/events.rpy:4303
translate russian samantha_event_B01_c5d1cfda:
    "Я слегка вздрагиваю, но человек, выбежавший на маленькую площадку, тоже явно не в себе."

# ch/samantha/events.rpy:4305
translate russian samantha_event_B01_3f313e80:
    mike.say "Кексик... Какого чёрта ты здесь делаешь?"

# ch/samantha/events.rpy:4307
translate russian samantha_event_B01_119222da:
    mike.say "Сэм... Какого чёрта ты здесь делаешь?"

# ch/samantha/events.rpy:4308
translate russian samantha_event_B01_d23a2e1b:
    "Она взвинчена и изрядно растрёпана. Потёки и размазанная косметика выдают, что недавно она плакала."

# ch/samantha/events.rpy:4309
translate russian samantha_event_B01_79869212:
    "Но сильнее бросается в глаза то, что она уже в свадебном платье и с причёской для церемонии."

# ch/samantha/events.rpy:4310
translate russian samantha_event_B01_6a510bed:
    "В такие моменты, по-моему, эгоистичные плотские мысли должны быть последним, что приходит в голову."

# ch/samantha/events.rpy:4311
translate russian samantha_event_B01_1d9a1b56:
    "Но, боже, как же прекрасна Саманта в этом платье."

# ch/samantha/events.rpy:4312
translate russian samantha_event_B01_af07ff41:
    mike.say "Разве ужин не вот-вот начнётся?"

# ch/samantha/events.rpy:4313
translate russian samantha_event_B01_153a41b9:
    "Терпеть не могу это говорить, но..."

# ch/samantha/events.rpy:4314
translate russian samantha_event_B01_858169db:
    mike.say "Райан не будет волноваться, куда ты пропала?"

# ch/samantha/events.rpy:4315
translate russian samantha_event_B01_8a301d9d:
    "Какое-то время Саманта смотрит на меня так, будто не совсем узнаёт или не понимает моих слов."

# ch/samantha/events.rpy:4316
translate russian samantha_event_B01_15562b33:
    "Затем встряхивает головой и словно возвращается к действительности."

# ch/samantha/events.rpy:4318
translate russian samantha_event_B01_3ea0d597:
    samantha.say "К чёрту свадьбу... И Райана туда же!"

# ch/samantha/events.rpy:4320
translate russian samantha_event_B01_118d8ee2:
    "Она улавливает иронию собственных слов и начинает почти безумно смеяться."

# ch/samantha/events.rpy:4322
translate russian samantha_event_B01_13b909e8:
    "Но через пару секунд смех переходит в рыдания, и она обвивает руками мою шею."

# ch/samantha/events.rpy:4324
translate russian samantha_event_B01_7374674c:
    "Я медленно обнимаю её в ответ, искренне сочувствуя."

# ch/samantha/events.rpy:4325
translate russian samantha_event_B01_7b8f17f4:
    samantha.say "Ох, [lssb_samantha.hero_name()]... Это правда?"

# ch/samantha/events.rpy:4327
translate russian samantha_event_B01_f916f407:
    mike.say "Кексик, я бы очень хотел сказать, что нет... Но правда."

# ch/samantha/events.rpy:4329
translate russian samantha_event_B01_6388a3de:
    mike.say "Сэм, я бы очень хотел сказать, что нет... Но правда."

# ch/samantha/events.rpy:4330
translate russian samantha_event_B01_ef25f9fc:
    samantha.say "Ублюдок..."

# ch/samantha/events.rpy:4331
translate russian samantha_event_B01_3a75563f:
    "С горечью шипит она мне в плечо."

# ch/samantha/events.rpy:4332
translate russian samantha_event_B01_9eb5c71d:
    "Сейчас я должен думать о Сэм..."

# ch/samantha/events.rpy:4333
translate russian samantha_event_B01_cb1c7c64:
    "Ну, я и думаю, но..."

# ch/samantha/events.rpy:4334
translate russian samantha_event_B01_f87df5ef:
    "Мне следовало бы сочувствовать ей и быть хорошим другом в трудную минуту."

# ch/samantha/events.rpy:4335
translate russian samantha_event_B01_76fd0791:
    "А я думаю лишь о том, как приятно она прижимается ко мне... Как чудесно пахнут её волосы..."

# ch/samantha/events.rpy:4336
translate russian samantha_event_B01_0afc206e:
    "Примерно через минуту объятий она поднимает голову и смотрит на меня."

# ch/samantha/events.rpy:4338
translate russian samantha_event_B01_9d9630aa:
    "Огромными томными голубыми глазами под длинными ресницами."

# ch/samantha/events.rpy:4339
translate russian samantha_event_B01_264dfd1c:
    samantha.say "[lssb_samantha.hero_name()]... Ты ведь никогда бы так со мной не поступил? Если бы любил?"

# ch/samantha/events.rpy:4340
translate russian samantha_event_B01_848879bb:
    samantha.say "Пожалуйста, мне просто нужно знать, что дело не во мне..."

# ch/samantha/events.rpy:4341
translate russian samantha_event_B01_b8710a0e:
    samantha.say "Что не все мужчины такие, как он..."

# ch/samantha/events.rpy:4342
translate russian samantha_event_B01_2e3a1d83:
    "Я всего лишь человек и не знаю, как повёл бы себя на месте Райана."

# ch/samantha/events.rpy:4343
translate russian samantha_event_B01_929044bc:
    "Но такая суровая честность сейчас Сэм ни к чему."

# ch/samantha/events.rpy:4345
translate russian samantha_event_B01_14e9c746:
    mike.say "Дело не в тебе, Кексик. Нужно быть безумцем, чтобы так с тобой поступить."

# ch/samantha/events.rpy:4347
translate russian samantha_event_B01_d8ec5eab:
    mike.say "Дело не в тебе, Сэм. Нужно быть безумцем, чтобы так с тобой поступить."

# ch/samantha/events.rpy:4348
translate russian samantha_event_B01_27ce8bf1:
    mike.say "Он просто подонок... И не понимает, как ему с тобой повезло."

# ch/samantha/events.rpy:4350
translate russian samantha_event_B01_11ad1e08:
    "Саманта слабо улыбается сквозь слёзы. Мои слова явно её приободрили."

# ch/samantha/events.rpy:4351
translate russian samantha_event_B01_22870f89:
    samantha.say "Спасибо, [lssb_samantha.hero_name()]... Я совершенно разбита... Наверное, мне просто нужно было поговорить с другом."

# ch/samantha/events.rpy:4352
translate russian samantha_event_B01_2a33b22f:
    "Да, ведь я только об этом и мечтал: быть другом, плечом, в которое можно поплакать!"

# ch/samantha/events.rpy:4355
translate russian samantha_event_B01_1a646940:
    samantha.say "Ты всегда был мне хорошим другом, [lssb_samantha.hero_name()]."

# ch/samantha/events.rpy:4356
translate russian samantha_event_B01_84f13893:
    "А это ещё что?"

# ch/samantha/events.rpy:4357
translate russian samantha_event_B01_775d358a:
    "Я улавливаю в её голосе тонкую перемену, словно она берёт себя в руки и начинает смотреть на всё иначе."

# ch/samantha/events.rpy:4358
translate russian samantha_event_B01_b81d0513:
    samantha.say "Очень хорошим другом... А я никогда не отвечала тебе тем же... По-настоящему..."

# ch/samantha/events.rpy:4359
translate russian samantha_event_B01_9ca4a4e3:
    "Вместо того чтобы отстраниться, Сэм прижимается ещё теснее."

# ch/samantha/events.rpy:4360
translate russian samantha_event_B01_f2b35b08:
    samantha.say "Может, я могла бы всё изменить... Начиная прямо сейчас?"

# ch/samantha/events.rpy:4361
translate russian samantha_event_B01_02193de9:
    "Вот чёрт! Я чувствую её руку у себя в паху!"

# ch/samantha/events.rpy:4365
translate russian samantha_event_B01_f34fcfd5:
    mike.say "Кексик, подумай. Ты сейчас точно рассуждаешь здраво?"

# ch/samantha/events.rpy:4367
translate russian samantha_event_B01_ebf6bd3c:
    mike.say "Сэм, подумай. Ты сейчас точно рассуждаешь здраво?"

# ch/samantha/events.rpy:4368
translate russian samantha_event_B01_d35a5854:
    samantha.say "Он трахал другую женщину за моей спиной, [lssb_samantha.hero_name()]."

# ch/samantha/events.rpy:4369
translate russian samantha_event_B01_65ce80f8:
    samantha.say "И собирался жениться на мне, так ничего и не сказав!"

# ch/samantha/events.rpy:4370
translate russian samantha_event_B01_3213473a:
    "Теперь в её голосе появляется яд — гнев, который она подавляла, узнав о поступках Райана."

# ch/samantha/events.rpy:4371
translate russian samantha_event_B01_04afe573:
    samantha.say "Если ему можно, почему мне нельзя?!"

# ch/samantha/events.rpy:4373
translate russian samantha_event_B01_086fe12d:
    mike.say "Сейчас ты не можешь ясно мыслить, Кексик..."

# ch/samantha/events.rpy:4375
translate russian samantha_event_B01_0ea06e42:
    mike.say "Сейчас ты не можешь ясно мыслить, Сэм..."

# ch/samantha/events.rpy:4376
translate russian samantha_event_B01_11d03e2f:
    samantha.say "Что такое, [lssb_samantha.hero_name()]... Тебе не нравится моё предложение?"

# ch/samantha/events.rpy:4377
translate russian samantha_event_B01_23d5edff:
    samantha.say "Разве ты никогда не смотрел на меня раньше и не представлял, каково было бы меня трахнуть?"

# ch/samantha/events.rpy:4378
translate russian samantha_event_B01_6ab01734:
    "Чёрт, почему девушки говорят со мной так только тогда, когда я пытаюсь быть хорошим?"

# ch/samantha/events.rpy:4380
translate russian samantha_event_B01_97a6f7c9:
    mike.say "Кексик, я бы солгал, ответив «нет»."

# ch/samantha/events.rpy:4382
translate russian samantha_event_B01_1895b160:
    mike.say "Сэм, я бы солгал, ответив «нет»."

# ch/samantha/events.rpy:4383
translate russian samantha_event_B01_24ceb891:
    mike.say "Спроси ты раньше — я бы согласился мгновенно."

# ch/samantha/events.rpy:4384
translate russian samantha_event_B01_d485f4f6:
    mike.say "Да и сейчас согласился бы, если бы ты не собиралась замуж..."

# ch/samantha/events.rpy:4385
translate russian samantha_event_B01_31344e56:
    "Сэм чуть ослабляет объятия, и пыл в её глазах отчасти сменяется печалью."

# ch/samantha/events.rpy:4387
translate russian samantha_event_B01_566730df:
    mike.say "Пожалуйста, Кексик... Если у нас когда-нибудь будет шанс, пусть всё начнётся не так. Только не так!"

# ch/samantha/events.rpy:4389
translate russian samantha_event_B01_1e816019:
    mike.say "Пожалуйста, Сэм... Если у нас когда-нибудь будет шанс, пусть всё начнётся не так. Только не так!"

# ch/samantha/events.rpy:4390
translate russian samantha_event_B01_28b3a39a:
    mike.say "Если ты сделаешь из меня такого же, как Райан, скоро ли начнёшь ненавидеть меня, как его?"

# ch/samantha/events.rpy:4391
translate russian samantha_event_B01_58271a04:
    samantha.say "Ох, [lssb_samantha.hero_name()]... Ты слишком хороший, себе же во вред."

# ch/samantha/events.rpy:4392
translate russian samantha_event_B01_be28cfc1:
    samantha.say "И, наверное, слишком хорош для меня!"

# ch/samantha/events.rpy:4393
translate russian samantha_event_B01_868e0776:
    "О да, я чёртов святой!"

# ch/samantha/events.rpy:4394
translate russian samantha_event_B01_c2f08dc7:
    "Покровитель тех, кто сам лишает себя верного шанса!"

# ch/samantha/events.rpy:4398
translate russian samantha_event_B01_5d1a8c04:
    "Какого чёрта?"

# ch/samantha/events.rpy:4399
translate russian samantha_event_B01_18fa9ae8:
    "Может, в данных обстоятельствах для неё это лучший выход?"

# ch/samantha/events.rpy:4400
translate russian samantha_event_B01_081e45bf:
    "Тогда она сможет продолжить весь этот грёбаный спектакль, хотя бы зная, что отомстила подонку."

# ch/samantha/events.rpy:4401
translate russian samantha_event_B01_ba29eff0:
    "Ну разве я не сама самоотверженность?"

# ch/samantha/events.rpy:4403
translate russian samantha_event_B01_5c3e875b:
    mike.say "Кексик... С радостью позволю тебе это сделать!"

# ch/samantha/events.rpy:4405
translate russian samantha_event_B01_ec37049f:
    mike.say "Сэм... С радостью позволю тебе это сделать!"

# ch/samantha/events.rpy:4406
translate russian samantha_event_B01_0872f94c:
    "Глаза Сэм вспыхивают, а её улыбка так порочна, что от одной неё у меня почти встаёт."

# ch/samantha/events.rpy:4407
translate russian samantha_event_B01_28f833fc:
    "Через мгновение она подбирает подол платья и опускается передо мной на колени на лестничной площадке."

# ch/samantha/events.rpy:4408
translate russian samantha_event_B01_dc815929:
    "Я мельком вижу белые чулки и подвязки, напоминая себе, какое у Сэм потрясающее тело."

# ch/samantha/events.rpy:4409
translate russian samantha_event_B01_f221ea0b:
    "Сэм целеустремлённо расстёгивает мне ширинку и достаёт член, улыбаясь и поглядывая на меня."

# ch/samantha/events.rpy:4410
translate russian samantha_event_B01_8b2c3088:
    "По лицу видно, как её сейчас заводит роль плохой девочки."

# ch/samantha/events.rpy:4411
translate russian samantha_event_B01_d6a8be2e:
    "И её энтузиазм явно заразителен."

# ch/samantha/events.rpy:4412
translate russian samantha_event_B01_7d0a3b69:
    "У меня уже стоит задолго до того, как она приближает рот к члену. Перед началом она ещё раз смотрит на меня."

# ch/samantha/events.rpy:4416
translate russian samantha_event_B01_592b989b:
    "Её взгляд словно говорит: это было неизбежно. Нам всегда было суждено сделать что-то подобное, когда наступит подходящий момент."

# ch/samantha/events.rpy:4417
translate russian samantha_event_B01_f9986daf:
    "Не могу сказать, что чувствую то же самое или когда-нибудь думал, что это случится."

# ch/samantha/events.rpy:4419
translate russian samantha_event_B01_065157e0:
    "Конечно, я представлял такое, но не ожидал, что действительно окажусь в этой ситуации с Сэм."

# ch/samantha/events.rpy:4420
translate russian samantha_event_B01_4ba1fff6:
    "Особенно в день её свадьбы, всего через несколько минут после церемонии!"

# ch/samantha/events.rpy:4422
translate russian samantha_event_B01_2c467bb2:
    "Она обхватывает губами головку моего члена и начинает ласкать её языком."

# ch/samantha/events.rpy:4423
translate russian samantha_event_B01_a7aa5cdd:
    "Я чувствую зубы почти так же сильно, как губы и язык. Свою неловкость она пытается компенсировать усердием."

# ch/samantha/events.rpy:4425
translate russian samantha_event_B01_ea54d0d7:
    "Это не лучший минет в моей жизни, и технике Сэм есть куда расти."

# ch/samantha/events.rpy:4426
translate russian samantha_event_B01_f4f1f58c:
    "Но зато мне делает минет девушка, которая, как я думал, навсегда уйдёт из моей жизни — да ещё и к законченному козлу."

# ch/samantha/events.rpy:4428
translate russian samantha_event_B01_b57d1eea:
    "Не говоря уже о том, что мне сосёт невеста сразу после свадебных клятв!"

# ch/samantha/events.rpy:4429
translate russian samantha_event_B01_41cae024:
    "И это с лихвой всё компенсирует."

# ch/samantha/events.rpy:4430
translate russian samantha_event_B01_0787d674:
    "В конце концов я кончаю скорее от вида Сэм на коленях и понимания всей подоплёки происходящего."

# ch/samantha/events.rpy:4431
translate russian samantha_event_B01_a1dedb15:
    "А не от её старательных, но не слишком выдающихся умений."

# ch/samantha/events.rpy:4434
translate russian samantha_event_B01_1c608461:
    "Я кончаю ей в рот, наблюдая, как она старается не выплюнуть сперму и не проглотить её по привычке."

# ch/samantha/events.rpy:4436
translate russian samantha_event_B01_baf079ec:
    "Сначала я не понимаю, зачем она держит сперму во рту, словно полощет ею рот."

# ch/samantha/events.rpy:4438
translate russian samantha_event_B01_485b6a3e:
    "Но когда остатки наконец стекают ей в горло, она замечает моё недоумение и снова улыбается."

# ch/samantha/events.rpy:4442
translate russian samantha_event_B01_a951b068:
    samantha.say "Хочу, чтобы ты остался на моих губах, когда он меня поцелует."

# ch/samantha/events.rpy:4443
translate russian samantha_event_B01_5ae3dd99:
    samantha.say "Хочу отомстить: пусть почувствует на губах своей невесты вкус чужой спермы!"

# ch/samantha/events.rpy:4444
translate russian samantha_event_B01_158dcf08:
    mike.say "Что тут скажешь? Более достойного кандидата и не придумать!"

# ch/samantha/events.rpy:4450
translate russian samantha_event_B01_2124a893:
    "Сэм поправляет платье и слабо мне улыбается."

# ch/samantha/events.rpy:4451
translate russian samantha_event_B01_a1f390f2:
    samantha.say "Пожелаешь удачи, [lssb_samantha.hero_name()]?"

# ch/samantha/events.rpy:4453
translate russian samantha_event_B01_3f58f0c0:
    mike.say "Удачи, Кексик."

# ch/samantha/events.rpy:4455
translate russian samantha_event_B01_c7befce8:
    mike.say "Удачи, Сэм."

# ch/samantha/events.rpy:4456
translate russian samantha_event_B01_b1afe057:
    "Вслух я этого не говорю, но мысленно добавляю: «Она тебе понадобится»."

# ch/samantha/events.rpy:4459
translate russian samantha_event_B01_852c344b:
    "Я встаю, чтобы сходить в туалет."

# ch/samantha/events.rpy:4460
translate russian samantha_event_B01_6d874b18:
    "Мне бы побыть одному и немного привести себя в порядок."

# ch/samantha/events.rpy:4461
translate russian samantha_event_B01_8769d76a:
    "Туалет находится дальше по коридору, так что идти недалеко."

# ch/samantha/events.rpy:4463
translate russian samantha_event_B01_7a121fe6:
    "Толкнув дверь с обычным мужским значком, я с облегчением вижу, что внутри пусто."

# ch/samantha/events.rpy:4464
translate russian samantha_event_B01_5a8c4dfd:
    "Стоя перед зеркалом, я разглядываю себя, поворачиваясь то влево, то вправо."

# ch/samantha/events.rpy:4465
translate russian samantha_event_B01_68a28906:
    "Мешки под глазами отлично дополняют костюм. Сшитый на заказ мне сейчас не по карману, да и вряд ли понадобится больше одного раза, поэтому я взял его напрокат."

# ch/samantha/events.rpy:4466
translate russian samantha_event_B01_0a060287:
    "Он слегка поношен, но выглядит неплохо. По крайней мере, на мой взгляд."

# ch/samantha/events.rpy:4467
translate russian samantha_event_B01_a41c7d96:
    "Я поправляю галстук и направляюсь в одну из кабинок напротив писсуаров."

# ch/samantha/events.rpy:4468
translate russian samantha_event_B01_90a97323:
    "Дверца легко открывается со скрипом, и я запираюсь изнутри."

# ch/samantha/events.rpy:4469
translate russian samantha_event_B01_9a7248ad:
    "Опускаю сиденье и тяжело усаживаюсь."

# ch/samantha/events.rpy:4470
translate russian samantha_event_B01_35c1fdfa:
    "Глубоко вздохнув, достаю телефон."

# ch/samantha/events.rpy:4471
translate russian samantha_event_B01_35d1bc31:
    "Увидь Саманта, как я скучаю за столом, она бы мне этого никогда не забыла."

# ch/samantha/events.rpy:4475
translate russian samantha_event_B01_8c4276c6:
    "Начинаю листать соцсети."

# ch/samantha/events.rpy:4476
translate russian samantha_event_B01_081c21b1:
    "Вскоре перестаю замечать время, бесконечно прокручивая всё, что попадается в интернете."

# ch/samantha/events.rpy:4478
translate russian samantha_event_B01_dde84d38:
    "Резко распахнувшаяся дверь туалета выводит меня из оцепенения."

# ch/samantha/events.rpy:4485
translate russian samantha_event_B01_74449814:
    "Когда телефон вибрирует, я удивлённо моргаю."

# ch/samantha/events.rpy:4488
translate russian samantha_event_B01_e9074bfc:
    nvl clear
    bree_nvl "Приве-ет!"

# ch/samantha/events.rpy:4489
translate russian samantha_event_B01_73bc0ac1:
    bree_nvl "Как твоя свадьба? <33"

# ch/samantha/events.rpy:4490
translate russian samantha_event_B01_7e77e59a:
    "Стоило мне пронести через гостиную костюм в полиэтиленовом чехле, как [bree.name] потребовала рассказать, ради чего я так «прихорашиваюсь»."

# ch/samantha/events.rpy:4491
translate russian samantha_event_B01_3fab4c8b:
    "Как ни странно, она помогла мне собраться, несмотря на мои возражения."

# ch/samantha/events.rpy:4492
translate russian samantha_event_B01_ee9ee9cd:
    "Даже Саша высказалась, когда я выходил, хотя её замечания были куда менее полезными."

# ch/samantha/events.rpy:4493
translate russian samantha_event_B01_4f0f185e:
    mchero_nvl "Это не моя свадьба."

# ch/samantha/events.rpy:4494
translate russian samantha_event_B01_066a373e:
    bree_nvl "Ну да, ну да."

# ch/samantha/events.rpy:4495
translate russian samantha_event_B01_e67bcfef:
    bree_nvl "Как «свадьба Саманты»?"

# ch/samantha/events.rpy:4498
translate russian samantha_event_B01_5a27f1da:
    mchero_nvl "Всё нормально. Саманта выглядит счастливой."

# ch/samantha/events.rpy:4499
translate russian samantha_event_B01_34ce903f:
    bree_nvl "😆"

# ch/samantha/events.rpy:4500
translate russian samantha_event_B01_c554f8dc:
    bree_nvl "Знаешь, «нормально» — не лучшее слово для свадьбы."

# ch/samantha/events.rpy:4501
translate russian samantha_event_B01_bc652ee4:
    mchero_nvl "Как скажешь."

# ch/samantha/events.rpy:4503
translate russian samantha_event_B01_9b397343:
    mchero_nvl "Не очень. Хочу домой."

# ch/samantha/events.rpy:4505
translate russian samantha_event_B01_235a6829:
    bree_nvl "О-о, бедняжка!"

# ch/samantha/events.rpy:4506
translate russian samantha_event_B01_61625ba1:
    bree_nvl "Когда вернёшься, сделаю тебе горячее какао, чтобы поднять настроение."

# ch/samantha/events.rpy:4507
translate russian samantha_event_B01_aaf1266d:
    mchero_nvl "Отвали! 😖"

# ch/samantha/events.rpy:4508
translate russian samantha_event_B01_558b5d5d:
    bree_nvl "😜"

# ch/samantha/events.rpy:4510
translate russian samantha_event_B01_97bda0f4:
    "Резко распахнувшаяся дверь туалета отвлекает меня от переписки, которую затеяла [bree.name]."

# ch/samantha/events.rpy:4512
translate russian samantha_event_B01_256f770e:
    "Я не придаю этому значения, пока странное хихиканье не заставляет усомниться, туда ли я зашёл."

# ch/samantha/events.rpy:4513
translate russian samantha_event_B01_9fc48a06:
    ryan.say "Тс-с."

# ch/samantha/events.rpy:4514
translate russian samantha_event_B01_2edda65c:
    "Девушка" "Со мной тебе будет лучше, милый."

# ch/samantha/events.rpy:4515
translate russian samantha_event_B01_fc61dc47:
    ryan.say "Докажи."

# ch/samantha/events.rpy:4516
translate russian samantha_event_B01_aff3165a:
    "Какого хрена? Это Райан? Не может быть. Только не на собственной свадьбе."

# ch/samantha/events.rpy:4517
translate russian samantha_event_B01_49fddbef:
    "Но вот он, отлично видный в щель кабинки, вместе с той подружкой невесты, с которой я говорил раньше."

# ch/samantha/events.rpy:4519
translate russian samantha_event_B01_32e18411:
    "Слышно, как расстёгивается молния."

# ch/samantha/events.rpy:4520
translate russian samantha_event_B01_4bcb00b6:
    "Девушка" "Ты такой... невозмутимый! Даже Саманта не может удержать такое сокровище."

# ch/samantha/events.rpy:4521
translate russian samantha_event_B01_0b86590d:
    ryan.say "Заткнись и соси."

# ch/samantha/events.rpy:4522
translate russian samantha_event_B01_77a0741d:
    "Нет. Ни за что."

# ch/samantha/events.rpy:4523
translate russian samantha_event_B01_7cd469c9:
    "Я не собираюсь сидеть и слушать, как Райану делают минет в паршивом ресторанном туалете."

# ch/samantha/events.rpy:4524
translate russian samantha_event_B01_afe91d70:
    "Рука касается защёлки, но замирает."

# ch/samantha/events.rpy:4525
translate russian samantha_event_B01_aa2f6166:
    "Нельзя просто выйти и притвориться, что ничего не видел."

# ch/samantha/events.rpy:4526
translate russian samantha_event_B01_13e62c30:
    "Райан разозлится и начнёт угрожать, заставляя меня молчать."

# ch/samantha/events.rpy:4527
translate russian samantha_event_B01_b7da05f4:
    "Будет гадать, почему я ничего не рассказываю Саманте."

# ch/samantha/events.rpy:4528
translate russian samantha_event_B01_a14e3f29:
    "Только этого мне ко всему прочему и не хватало."

# ch/samantha/events.rpy:4530
translate russian samantha_event_B01_4d75ca5c:
    "Саманта ни за что не поверит, если я просто расскажу ей."

# ch/samantha/events.rpy:4531
translate russian samantha_event_B01_47b6f2e9:
    "Я растерянно смотрю на телефон, потом снова на Райана."

# ch/samantha/events.rpy:4532
translate russian samantha_event_B01_1bc79d05:
    "Решение даётся легко: поднимаю телефон и включаю камеру."

# ch/samantha/events.rpy:4533
translate russian samantha_event_B01_fdfcd480:
    "Я делаю несколько снимков."

# ch/samantha/events.rpy:4534
translate russian samantha_event_B01_83f033bc:
    "Нельзя же просто отправить ей это без объяснений?"

# ch/samantha/events.rpy:4535
translate russian samantha_event_B01_194d2b21:
    "Она будет раздавлена."

# ch/samantha/events.rpy:4536
translate russian samantha_event_B01_f397f325:
    "Я должен быть рядом."

# ch/samantha/events.rpy:4541
translate russian samantha_event_B01_faa37ed4:
    ryan.say "М-мх..."

# ch/samantha/events.rpy:4542
translate russian samantha_event_B01_51e202fb:
    "Туалет наполняется влажными звуками, а затем раздаётся громкое чмоканье."

# ch/samantha/events.rpy:4543
translate russian samantha_event_B01_8f6b7ee5:
    "Я затыкаю уши, пытаясь не слышать стоны девушки."

# ch/samantha/events.rpy:4544
translate russian samantha_event_B01_15e243df:
    "Официально: это худшая свадьба, на которой я бывал."

# ch/samantha/events.rpy:4546
translate russian samantha_event_B01_510b3059:
    "Телефон вибрирует в руке, и у меня на несколько секунд замирает сердце."

# ch/samantha/events.rpy:4547
translate russian samantha_event_B01_414c2864:
    "Они не останавливаются, и я облегчённо выдыхаю."

# ch/samantha/events.rpy:4548
translate russian samantha_event_B01_885be71a:
    "Видимо, когда кажется, что вот-вот умрёшь, всё звучит громче."

# ch/samantha/events.rpy:4549
translate russian samantha_event_B01_0118cf68:
    "Снова пишет [bree.name]."

# ch/samantha/events.rpy:4550
translate russian samantha_event_B01_9d78f0aa:
    "Я ненадолго задумываюсь, стоит ли отвечать, и случайно поднимаю взгляд."

# ch/samantha/events.rpy:4554
translate russian samantha_event_B01_2a5a634e:
    "Через щель видно, как Райан впился руками в волосы девушки."

# ch/samantha/events.rpy:4555
translate russian samantha_event_B01_ade9bb7b:
    "Её губы обхватывают член, нос плотно прижат к его паху: она взяла его до самого основания."

# ch/samantha/events.rpy:4557
translate russian samantha_event_B01_5b6f6dee:
    "У неё вообще есть рвотный рефлекс?!"

# ch/samantha/events.rpy:4559
translate russian samantha_event_B01_6211a8d5:
    "Я опускаю взгляд так же быстро, как поднял."

# ch/samantha/events.rpy:4560
translate russian samantha_event_B01_6b756945:
    "Решаю просто смотреть в пол, стараясь не замечать парочку прямо за дверью."

# ch/samantha/events.rpy:4561
translate russian samantha_event_B01_fb013c65:
    "Не знаю, сколько проходит времени, но, когда я заканчиваю пересчитывать все квадратные плитки на полу, дверь туалета снова закрывается и наступает тишина."

# ch/samantha/events.rpy:4562
translate russian samantha_event_B01_b61957a8:
    "Вот же блядство."

# ch/samantha/events.rpy:4567
translate russian samantha_event_B01_e60389bd:
    "Стоит посмотреть, что происходит в главном зале. Может, удастся поговорить с Самантой."

# ch/samantha/events.rpy:4571
translate russian samantha_event_B01_40445bea:
    "Девушка" "Это было так волнительно!"

# ch/samantha/events.rpy:4572
translate russian samantha_event_B01_98a8d5f1:
    "Я вздрагиваю: девушка возникает внезапно и вырывает меня из мыслей."

# ch/samantha/events.rpy:4573
translate russian samantha_event_B01_cba252df:
    "Она плюхается на соседний стул и наклоняется вперёд, опершись локтями на стол."

# ch/samantha/events.rpy:4574
translate russian samantha_event_B01_ac4c5d70:
    "Девушка" "И романтично!"

# ch/samantha/events.rpy:4575
translate russian samantha_event_B01_fc011d46:
    "Девушка" "Вот бы и со мной кто-нибудь так обращался. Ты бы не хотел?"

# ch/samantha/events.rpy:4576
translate russian samantha_event_B01_6f3ab70c:
    mike.say "Эм... Да, наверное."

# ch/samantha/events.rpy:4578
translate russian samantha_event_B01_fb1ffa8d:
    "Я насторожённо смотрю на неё, а перед глазами всё ещё стоит член Райана, засунутый глубоко ей в горло."

# ch/samantha/events.rpy:4579
translate russian samantha_event_B01_90fd4bd1:
    "Невольно замечаю, что её губы теперь пухлее и краснее, чем в начале вечера."

# ch/samantha/events.rpy:4580
translate russian samantha_event_B01_29b44eec:
    "Девушка" "Еда очень вкусная!"

# ch/samantha/events.rpy:4582
translate russian samantha_event_B01_bab06b74:
    "Девушка" "Если честно, я даже немного удивлена."

# ch/samantha/events.rpy:4583
translate russian samantha_event_B01_220d1b9a:
    "Девушка" "..."

# ch/samantha/events.rpy:4585
translate russian samantha_event_B01_1258ee6d:
    "Девушка" "Потанцуешь со мной?"

# ch/samantha/events.rpy:4586
translate russian samantha_event_B01_bfa79728:
    "Я смотрю на неё. Щёки слегка порозовели. Она серьёзно?"

# ch/samantha/events.rpy:4587
translate russian samantha_event_B01_b6420967:
    mike.say "Не знаю. Я не особо танцую..."

# ch/samantha/events.rpy:4589
translate russian samantha_event_B01_2da5840a:
    "Она вдруг хватает меня за руку и поднимает раньше, чем я успеваю отреагировать."

# ch/samantha/events.rpy:4590
translate russian samantha_event_B01_55c26bbd:
    "Девушка" "Ничего! Я тоже. Но можем попробовать вместе!"

# ch/samantha/events.rpy:4591
translate russian samantha_event_B01_98d98f7e:
    "В центре зала приглушённый свет и танцующие пары."

# ch/samantha/events.rpy:4592
translate russian samantha_event_B01_281e82a4:
    "Музыка сменяется чем-то медленным и мягким."

# ch/samantha/events.rpy:4593
translate russian samantha_event_B01_a2a927ee:
    "Она упирает руки в бока, словно чего-то ждёт."

# ch/samantha/events.rpy:4594
translate russian samantha_event_B01_5ef830c3:
    "Я же только что сказал, что не умею заниматься этой ерундой?"

# ch/samantha/events.rpy:4595
translate russian samantha_event_B01_72947603:
    "Лихорадочно пытаюсь вспомнить хоть какой-нибудь пример."

# ch/samantha/events.rpy:4596
translate russian samantha_event_B01_9d8fb593:
    "Фильмы? Сойдёт. Я нервно поднимаю руки, как для бального танца."

# ch/samantha/events.rpy:4597
translate russian samantha_event_B01_0accf80a:
    "Она усмехается, берёт одну мою руку, а другую кладёт себе на бедро. Мы начинаем покачиваться."

# ch/samantha/events.rpy:4598
translate russian samantha_event_B01_4a7f86c0:
    "Ей, похоже, нравится, но я чувствую себя неловко."

# ch/samantha/events.rpy:4599
translate russian samantha_event_B01_42c0cf5c:
    "Саманта и Райан где-то здесь."

# ch/samantha/events.rpy:4600
translate russian samantha_event_B01_af72b12a:
    "Хочется поговорить с ней, поздравить или что-то вроде того."

# ch/samantha/events.rpy:4601
translate russian samantha_event_B01_5555d26c:
    "И в то же время не хочется смотреть, как они влюблены друг в друга."

# ch/samantha/events.rpy:4604
translate russian samantha_event_B01_65fca506:
    samantha.say "[lssb_samantha.hero_name()]!"

# ch/samantha/events.rpy:4605
translate russian samantha_event_B01_7d049ffe:
    "Легка на помине."

# ch/samantha/events.rpy:4606
translate russian samantha_event_B01_36303828:
    samantha.say "Так рада тебя видеть! Большое спасибо, что пришёл."

# ch/samantha/events.rpy:4610
translate russian samantha_event_B01_112ffc78:
    "Она мягко кладёт руку мне на плечо."

# ch/samantha/events.rpy:4611
translate russian samantha_event_B01_ef25a789:
    "Её подруга с недовольным вздохом отступает."

# ch/samantha/events.rpy:4612
translate russian samantha_event_B01_c5eaf75f:
    "Я наконец расслабляюсь."

# ch/samantha/events.rpy:4614
translate russian samantha_event_B01_5e76750a:
    mike.say "Привет, Кексик."

# ch/samantha/events.rpy:4616
translate russian samantha_event_B01_0ed80da9:
    mike.say "Привет, Сэм."

# ch/samantha/events.rpy:4618
translate russian samantha_event_B01_128c9eab:
    "Девушка" "Сэм! Ты такая красивая! Только посмотри на себя!"

# ch/samantha/events.rpy:4619
translate russian samantha_event_B01_20fd094c:
    "Её щёки розовеют, и она легко касается лица рукой."

# ch/samantha/events.rpy:4621
translate russian samantha_event_B01_6b57848b:
    samantha.say "Спасибо! Ты тоже отлично выглядишь. Спасибо, что стала моей подружкой невесты... И помогла всё устроить."

# ch/samantha/events.rpy:4622
translate russian samantha_event_B01_344e55f8:
    "Девушка" "Это всё твоя заслуга! Хватит благодарить, наслаждайся!"

# ch/samantha/events.rpy:4625
translate russian samantha_event_B01_a3d90daa:
    samantha.say "Так и сделаю. Кстати..."

# ch/samantha/events.rpy:4626
translate russian samantha_event_B01_16542bf8:
    "Саманта поворачивается ко мне."

# ch/samantha/events.rpy:4627
translate russian samantha_event_B01_e1ca8f41:
    samantha.say "Можно пригласить тебя на танец?"

# ch/samantha/events.rpy:4628
translate russian samantha_event_B01_371b8676:
    mike.say "..."

# ch/samantha/events.rpy:4631
translate russian samantha_event_B01_a25a0fe0:
    mike.say "Конечно."

# ch/samantha/events.rpy:4632
translate russian samantha_event_B01_47e371c1:
    "Она радостно хлопает в ладоши."

# ch/samantha/events.rpy:4633
translate russian samantha_event_B01_5c6c3213:
    samantha.say "Ура! Надеюсь, ты не против, Натали."

# ch/samantha/events.rpy:4634
translate russian samantha_event_B01_551a6c4c:
    "Натали?.. А."

# ch/samantha/events.rpy:4635
translate russian samantha_event_B01_b23a7463:
    natalie.say "Он твой!"

# ch/samantha/events.rpy:4636
translate russian samantha_event_B01_3b3c985c:
    "Натали подмигивает Сэм, но я замечаю её заминку."

# ch/samantha/events.rpy:4640
translate russian samantha_event_B01_0c1141f8:
    "Я поворачиваюсь к Сэм, которая уже подходит ближе."

# ch/samantha/events.rpy:4642
translate russian samantha_event_B01_5f52b639:
    "Машинально кладу руку ей на бедро, а она нежно берёт меня за другую руку."

# ch/samantha/events.rpy:4643
translate russian samantha_event_B01_80eff575:
    mike.say "Хорошо проводишь вечер?"

# ch/samantha/events.rpy:4645
translate russian samantha_event_B01_99457428:
    "Она смеётся и искренне улыбается. Как же это красиво."

# ch/samantha/events.rpy:4646
translate russian samantha_event_B01_746bd00d:
    samantha.say "Ты не представляешь. Это... моя мечта. Не могу поверить, что всё происходит сейчас."

# ch/samantha/events.rpy:4647
translate russian samantha_event_B01_a30ec220:
    mike.say "Ха! А я могу. Вы друг от друга не отлипали ещё тогда, когда мы жили вместе."

# ch/samantha/events.rpy:4649
translate russian samantha_event_B01_46f6e8b4:
    samantha.say "Ты же понимаешь, о чём я."

# ch/samantha/events.rpy:4650
translate russian samantha_event_B01_e698dad7:
    samantha.say "..."

# ch/samantha/events.rpy:4652
translate russian samantha_event_B01_528bb469:
    samantha.say "Ты выглядишь грустным."

# ch/samantha/events.rpy:4653
translate russian samantha_event_B01_3dbc0673:
    mike.say "Я... Нет. Я рад за тебя."

# ch/samantha/events.rpy:4654
translate russian samantha_event_B01_310f1c5c:
    "Саманта хмурится. Я часто моргаю, пытаясь взять выражение лица под контроль."

# ch/samantha/events.rpy:4655
translate russian samantha_event_B01_3a0e0909:
    mike.say "Не беспокойся обо мне. Сегодня твой вечер. Давай веселиться."

# ch/samantha/events.rpy:4657
translate russian samantha_event_B01_bbdb2c09:
    "Кажется, она хочет что-то добавить, но лишь качает головой и придвигается ближе."

# ch/samantha/events.rpy:4658
translate russian samantha_event_B01_7ada67dc:
    mike.say "Слышал, пришлось здорово потрудиться, чтобы так быстро всё организовать."

# ch/samantha/events.rpy:4659
translate russian samantha_event_B01_cbf9eaa5:
    samantha.say "Ух, даже не начинай. К бессонным ночам я привыкла ещё по учёбе, но это совсем другой уровень!"

# ch/samantha/events.rpy:4660
translate russian samantha_event_B01_a1fb9157:
    samantha.say "Ну как тебе результат такой спешной подготовки?"

# ch/samantha/events.rpy:4663
translate russian samantha_event_B01_10b00ca2:
    mike.say "По-моему, ты отлично справилась. Выглядишь потрясающе, еда вкусная... Можешь собой гордиться."

# ch/samantha/events.rpy:4665
translate russian samantha_event_B01_cf8e9537:
    "Сквозь лёгкий макияж проступает румянец."

# ch/samantha/events.rpy:4666
translate russian samantha_event_B01_5fb2d3a4:
    samantha.say "Спасибо. Ты такой милый!"

# ch/samantha/events.rpy:4669
translate russian samantha_event_B01_6b295841:
    mike.say "Кое-что можно было бы доработать."

# ch/samantha/events.rpy:4671
translate russian samantha_event_B01_b0db6492:
    samantha.say "Конечно можно! Но времени не было."

# ch/samantha/events.rpy:4672
translate russian samantha_event_B01_0fc4ea9d:
    mike.say "Я бы не переживал. Всем весело, и мы уже здесь."

# ch/samantha/events.rpy:4674
translate russian samantha_event_B01_b236ebdc:
    samantha.say "Верно."

# ch/samantha/events.rpy:4676
translate russian samantha_event_B01_171da8a7:
    "Начинается обычный медленный танец. Я уже почти обнимаю её, покачиваясь под плавную музыку."

# ch/samantha/events.rpy:4677
translate russian samantha_event_B01_45f4afd8:
    "К концу вечера она кладёт голову мне на грудь и закрывает глаза."

# ch/samantha/events.rpy:4678
translate russian samantha_event_B01_5e0f91ec:
    "Чувство вины постепенно отступает, пока мы сливаемся в объятиях посреди танцпола."

# ch/samantha/events.rpy:4679
translate russian samantha_event_B01_8a55b736:
    "Её мягкие светлые волосы щекочут мне подбородок, но отстраниться я не могу."

# ch/samantha/events.rpy:4680
translate russian samantha_event_B01_e014bbce:
    "Она тёплая и лёгкая."

# ch/samantha/events.rpy:4681
translate russian samantha_event_B01_725f8fb5:
    "Надеюсь, она не слышит, как колотится моё сердце."

# ch/samantha/events.rpy:4682
translate russian samantha_event_B01_4efe2217:
    "Вечер тихо заканчивается танцем с моей лучшей подругой посреди зала."

# ch/samantha/events.rpy:4685
translate russian samantha_event_B01_23085339:
    "Я не могу украсть невесту в её свадебный вечер."

# ch/samantha/events.rpy:4686
translate russian samantha_event_B01_08604637:
    mike.say "Разве тебе не стоит танцевать с Райаном?"

# ch/samantha/events.rpy:4687
translate russian samantha_event_B01_9b00e0d8:
    samantha.say "Я весь вечер с Райаном!"

# ch/samantha/events.rpy:4688
translate russian samantha_event_B01_03ec7bfc:
    samantha.say "Хочу и с друзьями пообщаться."

# ch/samantha/events.rpy:4689
translate russian samantha_event_B01_e96e531a:
    "Она игриво тянет меня за руку, но я отстраняюсь."

# ch/samantha/events.rpy:4691
translate russian samantha_event_B01_5a54c4a6:
    "Она сникает."

# ch/samantha/events.rpy:4693
translate russian samantha_event_B01_9fb84206:
    natalie.say "Кажется, вон там Райан!"

# ch/samantha/events.rpy:4694
translate russian samantha_event_B01_55c4eb38:
    natalie.say "Иди перехвати его, пока другая девушка не успела."

# ch/samantha/events.rpy:4700
translate russian samantha_event_B01_141d7189:
    "Я смотрю туда же и вижу Райана, беседующего с другой девушкой. Он стоит к ней слишком близко."

# ch/samantha/events.rpy:4702
translate russian samantha_event_B01_b3e41698:
    "Сэм хихикает, а у меня в груди вспыхивает злость. Подавляю её, понимая, чем он, скорее всего, занят."

# ch/samantha/events.rpy:4703
translate russian samantha_event_B01_4c65c8f3:
    "На собственной свадьбе."

# ch/samantha/events.rpy:4709
translate russian samantha_event_B01_e8e71870:
    samantha.say "Ладно, ладно."

# ch/samantha/events.rpy:4710
translate russian samantha_event_B01_5427b07a:
    natalie.say "Скорее! Кажется, начинается медленный танец!"

# ch/samantha/events.rpy:4712
translate russian samantha_event_B01_412c7fe6:
    samantha.say "О-о! Но когда всё закончится, ты должен мне танец, [lssb_samantha.hero_name()]!"

# ch/samantha/events.rpy:4713
translate russian samantha_event_B01_371b8676_1:
    mike.say "..."

# ch/samantha/events.rpy:4714
translate russian samantha_event_B01_3e72786a:
    samantha.say "Обещай!"

# ch/samantha/events.rpy:4715
translate russian samantha_event_B01_3e2ae2b5:
    mike.say "Ладно. Обещаю."

# ch/samantha/events.rpy:4720
translate russian samantha_event_B01_30eca578:
    "Она широко улыбается, затем спешит к Райану и привлекает его внимание. Он смотрит на неё, и лицо тут же становится ласковым. Я возвращаюсь к подруге Сэм."

# ch/samantha/events.rpy:4725
translate russian samantha_event_B01_9e111933:
    natalie.say "Они такие милые. Ты ведь продолжишь танцевать со мной?"

# ch/samantha/events.rpy:4726
translate russian samantha_event_B01_2c0679d6:
    mike.say "Эм..."

# ch/samantha/events.rpy:4728
translate russian samantha_event_B01_f2e540d0:
    "Прежде чем я успеваю ответить, она придвигается, вынуждая меня продолжить медленный танец."

# ch/samantha/events.rpy:4729
translate russian samantha_event_B01_11d4da88:
    "Мы какое-то время кружим по залу. Она говорит, но я почти не слушаю."

# ch/samantha/events.rpy:4730
translate russian samantha_event_B01_bdbf5adb:
    "Лишь смотрю ей за спину на крепко обнимающихся Райана и Саманту."

# ch/samantha/events.rpy:4732
translate russian samantha_event_B01_752ada53:
    natalie.say "Эй, ты слушаешь?"

# ch/samantha/events.rpy:4733
translate russian samantha_event_B01_d01aa590:
    mike.say "Прости, что?"

# ch/samantha/events.rpy:4734
translate russian samantha_event_B01_be1138d3:
    natalie.say "На что ты так отвлекаешься? Я тебе не нравлюсь, что ли?"

# ch/samantha/events.rpy:4735
translate russian samantha_event_B01_694d63fb:
    mike.say "Нет, дело не в этом... Эм..."

# ch/samantha/events.rpy:4736
translate russian samantha_event_B01_3fba4909:
    "Чёрт, как её зовут? Даже не помню, когда мы познакомились. Не могу вспомнить первую букву. Венди? Айрин?"

# ch/samantha/events.rpy:4737
translate russian samantha_event_B01_8ed74005:
    natalie.say "...Натали!"

# ch/samantha/events.rpy:4738
translate russian samantha_event_B01_5a39154b:
    "Даже близко не угадал."

# ch/samantha/events.rpy:4739
translate russian samantha_event_B01_e46c8604:
    mike.say "Прости. Я..."

# ch/samantha/events.rpy:4740
translate russian samantha_event_B01_6fb93cb1:
    natalie.say "Нет, неважно. Вижу, что я тебе неинтересна."

# ch/samantha/events.rpy:4741
translate russian samantha_event_B01_371b8676_2:
    mike.say "..."

# ch/samantha/events.rpy:4742
translate russian samantha_event_B01_9df2c996:
    mike.say "Ну, ты не ошибаешься."

# ch/samantha/events.rpy:4743
translate russian samantha_event_B01_065cff56:
    "У Натали отвисает челюсть, словно я нанёс ей личное оскорбление."

# ch/samantha/events.rpy:4745
translate russian samantha_event_B01_9cc1448c:
    "Она издаёт возмущённый возглас, несильно шлёпает меня по плечу и разворачивается на каблуках."

# ch/samantha/events.rpy:4747
translate russian samantha_event_B01_7b40f4e9:
    mike.say "...Хоть с этим покончено."

# ch/samantha/events.rpy:4748
translate russian samantha_event_B01_7bc177b4:
    "Я возвращаюсь на своё место, снова один. Пробую нетронутую утку."

# ch/samantha/events.rpy:4749
translate russian samantha_event_B01_20224439:
    "Она... сладкая. Но вполне приятно."

# ch/samantha/events.rpy:4750
translate russian samantha_event_B01_90579864:
    "Сэм и правда хорошо выбрала."

# ch/samantha/events.rpy:4751
translate russian samantha_event_B01_d8e3a58c:
    "Официант замечает меня и подходит наполнить высокий бокал светлым шампанским."

# ch/samantha/events.rpy:4752
translate russian samantha_event_B01_8d1c0c6a:
    "Я бормочу благодарность."

# ch/samantha/events.rpy:4753
translate russian samantha_event_B01_387c8463:
    "Не мой любимый напиток, но сейчас сойдёт."

# ch/samantha/events.rpy:4754
translate russian samantha_event_B01_d9aa7fc3:
    "Начинаю пить большими глотками в надежде на знакомый хмель в голове."

# ch/samantha/events.rpy:4755
translate russian samantha_event_B01_c51f8b36:
    "Чем скорее, тем лучше."

# ch/samantha/events.rpy:4767
translate russian samantha_event_B02_65fca506:
    samantha.say "[lssb_samantha.hero_name()]!"

# ch/samantha/events.rpy:4768
translate russian samantha_event_B02_d35a040a:
    "Я сразу узнаю голос Саманты за спиной."

# ch/samantha/events.rpy:4770
translate russian samantha_event_B02_09acede0:
    "Увидев её, невольно смотрю на новенькое кольцо, сверкающее на пальце."

# ch/samantha/events.rpy:4771
translate russian samantha_event_B02_b99c525e:
    "Она подходит и берёт меня под руку."

# ch/samantha/events.rpy:4772
translate russian samantha_event_B02_c8a4d3a8:
    samantha.say "Как ты?"

# ch/samantha/events.rpy:4773
translate russian samantha_event_B02_c2691f96:
    mike.say "Да как обычно — работаю."

# ch/samantha/events.rpy:4775
translate russian samantha_event_B02_b064826b:
    "Сэм надувает губы."

# ch/samantha/events.rpy:4776
translate russian samantha_event_B02_615bb2f3:
    "Пытается выглядеть игривой, но я замечаю за этим что-то ещё."

# ch/samantha/events.rpy:4777
translate russian samantha_event_B02_c16a188e:
    "Уныние? Ей это не идёт."

# ch/samantha/events.rpy:4778
translate russian samantha_event_B02_488aed14:
    mike.say "Что-то не так?"

# ch/samantha/events.rpy:4780
translate russian samantha_event_B02_12ebd862:
    samantha.say "М? Ты о чём?"

# ch/samantha/events.rpy:4781
translate russian samantha_event_B02_e1cb2156:
    mike.say "Я достаточно давно тебя знаю, чтобы видеть, когда тебе грустно."

# ch/samantha/events.rpy:4782
translate russian samantha_event_B02_492aab1c:
    mike.say "Ты ведь знаешь, что можешь со мной поговорить?"

# ch/samantha/events.rpy:4783
translate russian samantha_event_B02_789494f4:
    "Она долго молчит, меняя хватку и уныло сжимая мою руку."

# ch/samantha/events.rpy:4785
translate russian samantha_event_B02_69a76238:
    samantha.say "Просто..."

# ch/samantha/events.rpy:4786
translate russian samantha_event_B02_92c78072:
    samantha.say "Я... Я думала, после свадьбы Райан будет чаще рядом."

# ch/samantha/events.rpy:4787
translate russian samantha_event_B02_2424f2c1:
    samantha.say "Что мы наконец станем настоящей семьёй: будем вместе есть, засыпать в объятиях... Но его никогда нет дома."

# ch/samantha/events.rpy:4788
translate russian samantha_event_B02_868ed453:
    mike.say "А. Мне жаль."

# ch/samantha/events.rpy:4790
translate russian samantha_event_B02_9f4c5844:
    samantha.say "Ха! Ты ведь не виноват."

# ch/samantha/events.rpy:4791
translate russian samantha_event_B02_b61c4451:
    mike.say "Ты говорила с ним об этом?"

# ch/samantha/events.rpy:4793
translate russian samantha_event_B02_9ad32385:
    samantha.say "Мне немного страшно."

# ch/samantha/events.rpy:4794
translate russian samantha_event_B02_c8292012:
    "Должно быть, на моём лице появляется тревога: она тут же вскидывает руки, отрицая мои догадки."

# ch/samantha/events.rpy:4796
translate russian samantha_event_B02_17b11fe5:
    samantha.say "Не в этом смысле!"

# ch/samantha/events.rpy:4797
translate russian samantha_event_B02_25b09a08:
    samantha.say "Такого никогда не было."

# ch/samantha/events.rpy:4799
translate russian samantha_event_B02_a4292c50:
    samantha.say "Просто он всё время очень занят."

# ch/samantha/events.rpy:4800
translate russian samantha_event_B02_53100ea1:
    samantha.say "Боюсь, если попрошу проводить со мной больше времени, он решит, что я... собственница."

# ch/samantha/events.rpy:4801
translate russian samantha_event_B02_4474852c:
    samantha.say "А я не хочу! Я всегда давала ему свободу."

# ch/samantha/events.rpy:4802
translate russian samantha_event_B02_50ba3387:
    samantha.say "Я никогда не была навязчивой девушкой, но... Вдруг он решит, что я изменилась только потому, что мы теперь женаты?"

# ch/samantha/events.rpy:4803
translate russian samantha_event_B02_7b801dab:
    mike.say "Что? Боишься, что он бросит тебя, если ты о чём-то попросишь?"

# ch/samantha/events.rpy:4804
translate russian samantha_event_B02_51b2946b:
    samantha.say "Нет-нет, не бросит. Всё сложно... Но да."

# ch/samantha/events.rpy:4805
translate russian samantha_event_B02_4b62c0b9:
    mike.say "Серьёзно?! Да он ради тебя на всё пойдёт."

# ch/samantha/events.rpy:4806
translate russian samantha_event_B02_4b1cbeaf:
    "Ладно, наверное, не на всё. Но ей нужна поддержка."

# ch/samantha/events.rpy:4807
translate russian samantha_event_B02_65846715:
    mike.say "Если он не уделяет тебе внимания, поговори с ним."

# ch/samantha/events.rpy:4808
translate russian samantha_event_B02_6189295b:
    samantha.say "Он уделяет мне внимание!"

# ch/samantha/events.rpy:4809
translate russian samantha_event_B02_a378d2ec:
    mike.say "По твоим словам, не похоже."

# ch/samantha/events.rpy:4810
translate russian samantha_event_B02_a535f88b:
    samantha.say "...Ладно. Я поговорю. Но он меня не игнорирует!"

# ch/samantha/events.rpy:4811
translate russian samantha_event_B02_8266e8c1:
    "Я качаю головой и молчу. Как скажешь, Сэм."

# ch/samantha/events.rpy:4813
translate russian samantha_event_B02_2c738ae2:
    samantha.say "В общем, я хотела провести время с тобой."

# ch/samantha/events.rpy:4814
translate russian samantha_event_B02_e22e6a70:
    mike.say "Ха! Со мной?"

# ch/samantha/events.rpy:4815
translate russian samantha_event_B02_cc0c806b:
    samantha.say "Да! Не говори таким тоном."

# ch/samantha/events.rpy:4816
translate russian samantha_event_B02_9ba25c54:
    samantha.say "Я собиралась купить несколько романов в книжном в торговом центре. Пойдёшь со мной?"

# ch/samantha/events.rpy:4817
translate russian samantha_event_B02_72b6817a:
    mike.say "Да, ладно."

# ch/samantha/events.rpy:4819
translate russian samantha_event_B02_38f49844:
    samantha.say "Ура!"

# ch/samantha/events.rpy:4823
translate russian samantha_event_B02_844bf4b9:
    "Я стою между книжными стеллажами и безучастно разглядываю названия и обложки."

# ch/samantha/events.rpy:4824
translate russian samantha_event_B02_a4e7ca6b:
    "Ничто особенно не привлекает внимания."

# ch/samantha/events.rpy:4826
translate russian samantha_event_B02_72d6b11b:
    samantha.say "[lssb_samantha.hero_name()]! Что думаешь об этой?"

# ch/samantha/events.rpy:4827
translate russian samantha_event_B02_ed6d224e:
    "Сэм подбегает с книгой из детского отдела. Большая, красочная, страниц десять от силы."

# ch/samantha/events.rpy:4830
translate russian samantha_event_B02_5fafae96:
    mike.say "Ты не великовата для таких книжек?"

# ch/samantha/events.rpy:4831
translate russian samantha_event_B02_693e2fee:
    samantha.say "Они не для чтения, а для изучения! Ты же знаешь, я хочу писать детские книги."

# ch/samantha/events.rpy:4832
translate russian samantha_event_B02_d5c54d52:
    mike.say "А, точно."

# ch/samantha/events.rpy:4834
translate russian samantha_event_B02_ed17eb54:
    "Я верчу книгу в руках. Абстрактные рисунки, яркие цвета и странные персонажи."

# ch/samantha/events.rpy:4835
translate russian samantha_event_B02_44c65032:
    mike.say "Она... неплохая?"

# ch/samantha/events.rpy:4837
translate russian samantha_event_B02_13906d36:
    samantha.say "И это всё? Можешь и лучше!"

# ch/samantha/events.rpy:4840
translate russian samantha_event_B02_7a5ce340:
    "Открываю книгу и изучаю страницы. Они привычно толстые, как в большинстве детских книжек."

# ch/samantha/events.rpy:4841
translate russian samantha_event_B02_ec5bcd8c:
    mike.say "Думаю..."

# ch/samantha/events.rpy:4842
translate russian samantha_event_B02_0cafdb24:
    mike.say "Рисунки необычные. Но, по-моему, это не совсем твой стиль. Тебе ближе что-то мягкое."

# ch/samantha/events.rpy:4843
translate russian samantha_event_B02_c24967b7:
    samantha.say "Хм."

# ch/samantha/events.rpy:4844
translate russian samantha_event_B02_a987475e:
    mike.say "Что касается текста, история по-своему интересная. Но тебе, думаю, стоит присмотреться к теме и морали в конце."

# ch/samantha/events.rpy:4845
translate russian samantha_event_B02_07388cff:
    "Сэм внимательно слушает и кивает. Приятно, когда она меня слушает."

# ch/samantha/events.rpy:4846
translate russian samantha_event_B02_d1cae666:
    samantha.say "Значит, выбор хороший?"

# ch/samantha/events.rpy:4847
translate russian samantha_event_B02_f8354afa:
    mike.say "Конечно."

# ch/samantha/events.rpy:4848
translate russian samantha_event_B02_ccec8a8e:
    "Она шутливо отдаёт мне честь двумя пальцами и зажимает книгу под мышкой."

# ch/samantha/events.rpy:4850
translate russian samantha_event_B02_3e439597:
    "Я бездумно смотрю на обложку. От обилия цветов голова кругом: не привык к такой яркости. По сравнению с моей комнатой это почти радуга."

# ch/samantha/events.rpy:4851
translate russian samantha_event_B02_d90ee21b:
    mike.say "Тут... много... цветов?"

# ch/samantha/events.rpy:4852
translate russian samantha_event_B02_13f58525:
    samantha.say "А ты красноречив!"

# ch/samantha/events.rpy:4853
translate russian samantha_event_B02_c36744be:
    mike.say "Помолчи!"

# ch/samantha/events.rpy:4854
translate russian samantha_event_B02_371b8676:
    mike.say "..."

# ch/samantha/events.rpy:4855
translate russian samantha_event_B02_14759bc2:
    mike.say "Мне нравится."

# ch/samantha/events.rpy:4856
translate russian samantha_event_B02_5efad15c:
    "Сэм послушно кивает и зажимает книгу под мышкой."

# ch/samantha/events.rpy:4857
translate russian samantha_event_B02_2e2f32d3:
    samantha.say "Ну что? Себе что-нибудь берёшь?"

# ch/samantha/events.rpy:4858
translate russian samantha_event_B02_882e070b:
    mike.say "Наверное, раз уж я здесь."

# ch/samantha/events.rpy:4860
translate russian samantha_event_B02_9a9a4325:
    samantha.say "Отлично! Я ещё посмотрю."

# ch/samantha/events.rpy:4862
translate russian samantha_event_B02_e3757be1:
    "Она возвращается в детский отдел на поиски новых книг, а я остаюсь один. Даже не знаю, с чего начать."

# ch/samantha/events.rpy:4865
translate russian samantha_event_B02_e2f337ec:
    "На обложках всех книг в этом ряду красуются аппетитные блюда и безупречные рецепты. Беру первую, привлёкшую внимание."

# ch/samantha/events.rpy:4866
translate russian samantha_event_B02_09380502:
    mike.say "Выпечка?"

# ch/samantha/events.rpy:4867
translate russian samantha_event_B02_ff7b4290:
    "Быстро листаю, пробегая глазами текст. Сложные десерты, которые я вряд ли когда-нибудь освою в совершенстве, смотрят на меня устрашающе."

# ch/samantha/events.rpy:4868
translate russian samantha_event_B02_e0afbe9a:
    "Несу книгу к кассе. Сэм уже ждёт там с пакетами в руках."

# ch/samantha/events.rpy:4872
translate russian samantha_event_B02_fcad8dd1:
    "Американский футбол, бейсбол, обычный футбол... Передо мной все виды спорта, какие только могу представить. Где-то журналы, где-то толстые книги, разбирающие каждый аспект игры."

# ch/samantha/events.rpy:4873
translate russian samantha_event_B02_cf61d471:
    "Рука зависает над журналом с широким обзором разных видов спорта."

# ch/samantha/events.rpy:4874
translate russian samantha_event_B02_186f1a9c:
    "Я беру журнал. Тонкие страницы трепещут в руке. Иду к кассе и достаю кошелёк."

# ch/samantha/events.rpy:4878
translate russian samantha_event_B02_8512a508:
    "Меня манят фэнтези и научная фантастика. На полке красуются свежие издания в блестящих твёрдых обложках."

# ch/samantha/events.rpy:4879
translate russian samantha_event_B02_d656abd9:
    "Переворачиваю одну книгу и читаю аннотацию. Драконы, космос, сражения... Чего ещё желать?"

# ch/samantha/events.rpy:4880
translate russian samantha_event_B02_29b0c400:
    "Выбор очевиден. Я уже считаю книгу своей, ещё до того как кладу её перед продавцом для оплаты."

# ch/samantha/events.rpy:4884
translate russian samantha_event_B02_4affa9c7:
    samantha.say "Нашёл, что хотел?"

# ch/samantha/events.rpy:4885
translate russian samantha_event_B02_05fb3a80:
    mike.say "Ага!"

# ch/samantha/events.rpy:4886
translate russian samantha_event_B02_56be3680:
    "Я машу перед ней своей единственной книгой, и она внимательно её разглядывает."

# ch/samantha/events.rpy:4889
translate russian samantha_event_B02_6636f5e2:
    "Лицо Сэм тут же озаряется."

# ch/samantha/events.rpy:4890
translate russian samantha_event_B02_cceec136:
    samantha.say "Обязательно что-нибудь мне испеки! Посмотри, сколько рецептов. Отличный выбор!"

# ch/samantha/events.rpy:4891
translate russian samantha_event_B02_371b8676_1:
    mike.say "..."

# ch/samantha/events.rpy:4892
translate russian samantha_event_B02_3df15b4b:
    mike.say "Ты работаешь в пекарне."

# ch/samantha/events.rpy:4893
translate russian samantha_event_B02_f5fdd88e:
    samantha.say "Отговорки!"

# ch/samantha/events.rpy:4895
translate russian samantha_event_B02_c5b86cb1:
    samantha.say "Ты помешан на спорте, да?"

# ch/samantha/events.rpy:4896
translate russian samantha_event_B02_ef49ec99:
    mike.say "«Помешан» — сильно сказано."

# ch/samantha/events.rpy:4897
translate russian samantha_event_B02_fdec9907:
    samantha.say "Ну да, ну да. Может, наконец научишься играть со мной в дартс."

# ch/samantha/events.rpy:4898
translate russian samantha_event_B02_15952403:
    mike.say "Не думаю, что здесь про него есть."

# ch/samantha/events.rpy:4900
translate russian samantha_event_B02_3db84475:
    samantha.say "О-о! Увлекательно! Учитывая твою комнату, стоило ожидать."

# ch/samantha/events.rpy:4901
translate russian samantha_event_B02_dcdf4341:
    mike.say "Эй! У меня отличная комната."

# ch/samantha/events.rpy:4902
translate russian samantha_event_B02_a3d887f1:
    samantha.say "Если «отличная» для тебя значит «гиковская», то да, отличная."

# ch/samantha/events.rpy:4904
translate russian samantha_event_B02_7034da5b:
    samantha.say "Спасибо, что пошёл со мной! Было весело."

# ch/samantha/events.rpy:4905
translate russian samantha_event_B02_3bea7900:
    mike.say "Не за что. Домой идёшь?"

# ch/samantha/events.rpy:4907
translate russian samantha_event_B02_26d9b43d:
    samantha.say "...Да, наверное."

# ch/samantha/events.rpy:4908
translate russian samantha_event_B02_a4c325d7:
    "Она снова грустнеет. Неужели ей так одиноко?"

# ch/samantha/events.rpy:4910
translate russian samantha_event_B02_65464f49:
    mike.say "Ох, Кексик."

# ch/samantha/events.rpy:4912
translate russian samantha_event_B02_4dfd1618:
    mike.say "Ох, Сэм."

# ch/samantha/events.rpy:4913
translate russian samantha_event_B02_17f65379:
    samantha.say "Я..."

# ch/samantha/events.rpy:4915
translate russian samantha_event_B02_e698dad7:
    samantha.say "..."

# ch/samantha/events.rpy:4916
translate russian samantha_event_B02_3b3eae5b:
    "Когда по её щекам начинают течь слёзы, сердце у меня падает. Вот чёрт."

# ch/samantha/events.rpy:4918
translate russian samantha_event_B02_a45a4e2d:
    "Я притягиваю её к себе. Она обнимает меня за туловище."

# ch/samantha/events.rpy:4919
translate russian samantha_event_B02_88ee7bd4:
    mike.say "Может, лучше посидим у меня?"

# ch/samantha/events.rpy:4920
translate russian samantha_event_B02_2a3c9551:
    "Чувствую, как она кивает, уткнувшись мне в шею."

# ch/samantha/events.rpy:4921
translate russian samantha_event_B02_bff0b98e:
    mike.say "Хорошо. Пойдём."

# ch/samantha/events.rpy:4926
translate russian samantha_event_B02_ea1a6507:
    "Саманта сидит на диване и листает новую книгу. Слёзы давно высохли."

# ch/samantha/events.rpy:4928
translate russian samantha_event_B02_117b3ca6:
    "А я готовлю ей на кухне сладкий чай."

# ch/samantha/events.rpy:4929
translate russian samantha_event_B02_5062d5c1:
    "Опустив пакетик в горячую воду и щедро насыпав сахара, осторожно несу чашку к ней."

# ch/samantha/events.rpy:4935
translate russian samantha_event_B02_c8364ab6:
    "Завернув за угол, вижу, что из комнаты уже спустилась [bree.name]."

# ch/samantha/events.rpy:4937
translate russian samantha_event_B02_c77cd832:
    bree.say "Приветик! Неужели [lssb_samantha.hero_name()] привёл домой девушку?! Как же быстро он растёт!"

# ch/samantha/events.rpy:4938
translate russian samantha_event_B02_ab204a94:
    mike.say "[bree.name]..."

# ch/samantha/events.rpy:4942
translate russian samantha_event_B02_c0723bc9:
    bree.say "Знакомое лицо. Это ты помогала Райану найти для меня этот дом?"

# ch/samantha/events.rpy:4943
translate russian samantha_event_B02_ab204a94_1:
    mike.say "[bree.name]..."

# ch/samantha/events.rpy:4944
translate russian samantha_event_B02_99b029b2:
    "Несмотря на её непрерывную болтовню, Саманта не выглядит раздражённой. Поэтому я просто ставлю чай на столик перед ней."

# ch/samantha/events.rpy:4945
translate russian samantha_event_B02_e786c818:
    samantha.say "Да, это я."

# ch/samantha/events.rpy:4946
translate russian samantha_event_B02_2cf98380:
    bree.say "Значит... Ты ведь только что вышла замуж?"

# ch/samantha/events.rpy:4947
translate russian samantha_event_B02_556a39c5:
    samantha.say "Ага!"

# ch/samantha/events.rpy:4949
translate russian samantha_event_B02_d8e48d83:
    bree.say "Ха! Теперь понятно, почему [lssb_samantha.hero_name()] так приуныл."

# ch/samantha/events.rpy:4950
translate russian samantha_event_B02_cbdda06b:
    mike.say "[bree.name]! Всё, возвращайся в свою отшельничью нору."

# ch/samantha/events.rpy:4952
translate russian samantha_event_B02_201a1606:
    bree.say "Отшельничью нору?! Раз ты так думаешь, значит, моей коллекции игр даже не видел. Это скорее рай, горемыка!"

# ch/samantha/events.rpy:4954
translate russian samantha_event_B02_9ee4deff:
    samantha.say "Привет, [bree.name]."

# ch/samantha/events.rpy:4955
translate russian samantha_event_B02_1c577f15:
    bree.say "Привет."

# ch/samantha/events.rpy:4956
translate russian samantha_event_B02_18e4d005:
    bree.say "Я буду у себя. Не делайте ничего, чего не сделала бы я."

# ch/samantha/events.rpy:4958
translate russian samantha_event_B02_43403452:
    "С этими словами [bree.name] возвращается наверх. Я стараюсь не покраснеть."

# ch/samantha/events.rpy:4959
translate russian samantha_event_B02_73e150d1:
    mike.say "Понятия не имею, о чём она."

# ch/samantha/events.rpy:4961
translate russian samantha_event_B02_91d7e00a:
    "Саманта лишь хихикает, слегка прикрыв рот рукой."

# ch/samantha/events.rpy:4962
translate russian samantha_event_B02_dd2fd85b:
    samantha.say "Она такая живая. Рад, что она твоя соседка?"

# ch/samantha/events.rpy:4963
translate russian samantha_event_B02_53c94c08:
    mike.say "Наверное, вы могли найти кого-нибудь и похуже."

# ch/samantha/events.rpy:4965
translate russian samantha_event_B02_f915d7e9:
    samantha.say "Не будь вредным! Она симпатичная."

# ch/samantha/events.rpy:4966
translate russian samantha_event_B02_3c3467f9:
    mike.say "Как скажешь."

# ch/samantha/events.rpy:4968
translate russian samantha_event_B02_9fae5cb2:
    samantha.say "Я серьёзно! Вы были бы милой парой."

# ch/samantha/events.rpy:4969
translate russian samantha_event_B02_f4e8e8de:
    mike.say "Смешная ты."

# ch/samantha/events.rpy:4971
translate russian samantha_event_B02_1904dbe1:
    "Она закатывает глаза и сдаётся. Берёт чашку и делает глоток."

# ch/samantha/events.rpy:4973
translate russian samantha_event_B02_2dc14893:
    mike.say "Вот твой чай. Надеюсь, понравится."

# ch/samantha/events.rpy:4974
translate russian samantha_event_B02_598dac88:
    samantha.say "Неплохо."

# ch/samantha/events.rpy:4975
translate russian samantha_event_B02_bd634a93:
    mike.say "Обидно."

# ch/samantha/events.rpy:4976
translate russian samantha_event_B02_f2d4c2ad:
    samantha.say "Что?! Вкусно! Не дуйся. Просто сахара маловато."

# ch/samantha/events.rpy:4977
translate russian samantha_event_B02_2f357f31:
    mike.say "Там вообще-то около трёх чайных ложек."

# ch/samantha/events.rpy:4978
translate russian samantha_event_B02_4e821b41:
    samantha.say "Угу. Как я и сказала, нужно больше сахара."

# ch/samantha/events.rpy:4979
translate russian samantha_event_B02_f83cb523:
    "Некоторое время мы молчим, пока она допивает чай."

# ch/samantha/events.rpy:4980
translate russian samantha_event_B02_e9a040a3:
    mike.say "Ну что, чем поднимем тебе настроение?"

# ch/samantha/events.rpy:4981
translate russian samantha_event_B02_f5012345:
    samantha.say "Не знаю. Что у тебя тут есть?"

# ch/samantha/events.rpy:4984
translate russian samantha_event_B02_10391ef8:
    mike.say "Можем что-нибудь испечь."

# ch/samantha/events.rpy:4986
translate russian samantha_event_B02_b3c853cf:
    samantha.say "О-о! Решил опробовать новую книгу?"

# ch/samantha/events.rpy:4987
translate russian samantha_event_B02_20890e1d:
    "Я поднимаю книгу со столика, куда бросил её раньше, и ищу простые рецепты."

# ch/samantha/events.rpy:4988
translate russian samantha_event_B02_5e3fa253:
    mike.say "Кексы?"

# ch/samantha/events.rpy:4989
translate russian samantha_event_B02_7b6b14d7:
    samantha.say "Да! Давай!"

# ch/samantha/events.rpy:4994
translate russian samantha_event_B02_f575ead3:
    "Саманта проносится мимо меня на кухню. Уже слышно, как гремит посуда и выдвигаются ящики. Я иду следом."

# ch/samantha/events.rpy:4995
translate russian samantha_event_B02_95738788:
    samantha.say "Яйца, ваниль, разрыхлитель..."

# ch/samantha/events.rpy:4997
translate russian samantha_event_B02_09ef917b:
    mike.say "Эй, погоди, ты ещё рецепт не видела."

# ch/samantha/events.rpy:4998
translate russian samantha_event_B02_c2c49650:
    samantha.say "Я работаю в пекарне. Знаю, как делать кексы."

# ch/samantha/events.rpy:4999
translate russian samantha_event_B02_3f0947dd:
    "Пожимаю плечами. Логично. Закрываю книгу и кладу на столешницу. Нахожу несколько больших мисок и ставлю рядом с ингредиентами."

# ch/samantha/events.rpy:5000
translate russian samantha_event_B02_92ed441e:
    samantha.say "Смешай вот это, пожалуйста!"

# ch/samantha/events.rpy:5001
translate russian samantha_event_B02_f82d733a:
    "Она говорит «пожалуйста», но звучит скорее как приказ. Тем не менее я беру протянутые ингредиенты, машинально выливаю в миску и смешиваю венчиком."

# ch/samantha/events.rpy:5002
translate russian samantha_event_B02_4e56558e:
    "Она делает то же самое, перемешивая сухие ингредиенты вилкой."

# ch/samantha/events.rpy:5003
translate russian samantha_event_B02_22b906e3:
    samantha.say "Хм... А где мука?"

# ch/samantha/events.rpy:5004
translate russian samantha_event_B02_4121ddac:
    mike.say "Эм, кажется, на верхней полке."

# ch/samantha/events.rpy:5005
translate russian samantha_event_B02_259ce606:
    "Саманта подходит к полке, на которую я указываю. Та на несколько сантиметров выше её роста. Сомневаюсь, что она дотянется, но она всё равно встаёт на носки и пробует."

# ch/samantha/events.rpy:5006
translate russian samantha_event_B02_55ee2c01:
    mike.say "Тебе помочь?.."

# ch/samantha/events.rpy:5008
translate russian samantha_event_B02_fae08650:
    samantha.say "Ай!"

# ch/samantha/events.rpy:5009
translate russian samantha_event_B02_dfa57d30:
    "Краем глаза замечаю белое облако и резко оборачиваюсь. Саманта стоит, всё ещё вытянув руки к пакету."

# ch/samantha/events.rpy:5010
translate russian samantha_event_B02_431e7378:
    "Она с головы до ног покрыта мукой. Пол выглядит не лучше. Я не выдерживаю и начинаю смеяться."

# ch/samantha/events.rpy:5012
translate russian samantha_event_B02_25787735:
    samantha.say "Ты смеёшься?!"

# ch/samantha/events.rpy:5013
translate russian samantha_event_B02_de190e61:
    "Я пытаюсь взять себя в руки. Правда пытаюсь. Но прежде чем успеваю, Саманта зачерпывает муку с пола и дует мне прямо в лицо."

# ch/samantha/events.rpy:5014
translate russian samantha_event_B02_8fd43b97:
    "Повезло, что глаза были закрыты."

# ch/samantha/events.rpy:5015
translate russian samantha_event_B02_6ded295e:
    mike.say "Что?! Какого хрена?!"

# ch/samantha/events.rpy:5017
translate russian samantha_event_B02_a084eab7:
    "Теперь смеётся она."

# ch/samantha/events.rpy:5019
translate russian samantha_event_B02_df54dd27:
    samantha.say "Ты прав! И правда очень смешно!"

# ch/samantha/events.rpy:5020
translate russian samantha_event_B02_051ef640:
    "Вытирая лицо, я оглядываю разгром. Убирать это будет кошмарно."

# ch/samantha/events.rpy:5021
translate russian samantha_event_B02_f2252641:
    mike.say "Хоть что-нибудь осталось?"

# ch/samantha/events.rpy:5022
translate russian samantha_event_B02_e698dad7_1:
    samantha.say "..."

# ch/samantha/events.rpy:5024
translate russian samantha_event_B02_2ef7974d:
    samantha.say "Ага! В пакете ещё достаточно."

# ch/samantha/events.rpy:5025
translate russian samantha_event_B02_0fe1be47:
    "Она поднимает пакет с остатками муки и высыпает в миску."

# ch/samantha/events.rpy:5026
translate russian samantha_event_B02_f839be2e:
    "Саманта вся перепачкана, но сияет. А это главное."

# ch/samantha/events.rpy:5031
translate russian samantha_event_B02_5e730c20:
    "Саманта достаёт кексы из духовки. Под её чутким присмотром они получились идеальными. Весь первый этаж наполнен чудесным ароматом."

# ch/samantha/events.rpy:5032
translate russian samantha_event_B02_f53a65cc:
    "Она ставит горячий противень на столешницу, чтобы кексы остыли, и отряхивает руки, всё ещё покрытые белым порошком."

# ch/samantha/events.rpy:5034
translate russian samantha_event_B02_934214a6:
    mike.say "Хочешь, найду тебе что-нибудь переодеться? Может, наверху что-то найдётся."

# ch/samantha/events.rpy:5035
translate russian samantha_event_B02_d8f76dda:
    samantha.say "Нет, ничего. Сама виновата."

# ch/samantha/events.rpy:5036
translate russian samantha_event_B02_72e6bc39:
    mike.say "...Верно. Ладно."

# ch/samantha/events.rpy:5039
translate russian samantha_event_B02_e11d6f98:
    "Она достаёт телефон, и улыбка постепенно исчезает."

# ch/samantha/events.rpy:5041
translate russian samantha_event_B02_5df8442e:
    samantha.say "Это Райан. Он дома."

# ch/samantha/events.rpy:5042
translate russian samantha_event_B02_79179920:
    samantha.say "Нам нужно кое о чём поговорить. Прости, мне пора."

# ch/samantha/events.rpy:5043
translate russian samantha_event_B02_3c633381:
    mike.say "А... Ладно, без проблем."

# ch/samantha/events.rpy:5044
translate russian samantha_event_B02_e3cbb6e4:
    samantha.say "Большое спасибо, что пригласил."

# ch/samantha/events.rpy:5045
translate russian samantha_event_B02_bc6c000e:
    mike.say "Тебе здесь всегда рады."

# ch/samantha/events.rpy:5049
translate russian samantha_event_B02_92d4f10b:
    "Она широко улыбается. Я провожаю её до двери."

# ch/samantha/events.rpy:5050
translate russian samantha_event_B02_d5faf96e:
    "Она машет мне, затем притягивает к себе и обнимает. Я провожаю её взглядом."

# ch/samantha/events.rpy:5052
translate russian samantha_event_B02_db072ada:
    mike.say "Хочешь, найду тебе что-нибудь переодеться? Не думаю, что [bree.name] будет против."

# ch/samantha/events.rpy:5053
translate russian samantha_event_B02_d8f76dda_1:
    samantha.say "Нет, ничего. Сама виновата."

# ch/samantha/events.rpy:5054
translate russian samantha_event_B02_647f00ba:
    mike.say "Да брось. Не хочешь же ты идти домой в таком виде?"

# ch/samantha/events.rpy:5055
translate russian samantha_event_B02_8f9ddb3a:
    samantha.say "...Ты прав. Ладно."

# ch/samantha/events.rpy:5057
translate russian samantha_event_B02_b016b715:
    "Оставляю её с кексами и поднимаюсь наверх."

# ch/samantha/events.rpy:5061
translate russian samantha_event_B02_eb185143:
    "Тихонько стучу в дверь."

# ch/samantha/events.rpy:5063
translate russian samantha_event_B02_6b3a4f22:
    "Ответа нет. Стучу громче."

# ch/samantha/events.rpy:5070
translate russian samantha_event_B02_2ffc3362:
    "За дверью что-то грохочет, затем она резко распахивается."

# ch/samantha/events.rpy:5073
translate russian samantha_event_B02_64f64390:
    bree.say "Надеюсь, дело важное! Я посреди боя..."

# ch/samantha/events.rpy:5075
translate russian samantha_event_B02_4984fa58:
    "Она вдруг замолкает, увидев моё лицо, и замирает с наушниками в руке. Видимо, я плохо умылся. Чёрт тебя побери, Саманта."

# ch/samantha/events.rpy:5077
translate russian samantha_event_B02_994b01cd:
    bree.say "Какого хрена вы там делаете?"

# ch/samantha/events.rpy:5079
translate russian samantha_event_B02_00f63ad3:
    mike.say "Можно одолжить для Саманты какую-нибудь одежду?"

# ch/samantha/events.rpy:5081
translate russian samantha_event_B02_a875e43a:
    bree.say "Развлекаетесь там? Конечно, только не испачкайте своими грязными прелюдиями. Вернуть обязательно!"

# ch/samantha/events.rpy:5083
translate russian samantha_event_B02_640abcd6:
    mike.say "Это не..."

# ch/samantha/events.rpy:5084
translate russian samantha_event_B02_0fc8b707:
    "[bree.name] суёт мне в руки стопку одежды и захлопывает дверь перед носом. Эта девушка меня доконает."

# ch/samantha/events.rpy:5088
translate russian samantha_event_B02_5a1a8f08:
    mike.say "Держи."

# ch/samantha/events.rpy:5090
translate russian samantha_event_B02_b6bce198:
    samantha.say "Спасибо. Ой! Передай, пожалуйста, мою благодарность: [bree.name] меня выручила. Но, кажется, мне нужно идти."

# ch/samantha/events.rpy:5091
translate russian samantha_event_B02_3c633381_1:
    mike.say "А... Ладно, без проблем."

# ch/samantha/events.rpy:5093
translate russian samantha_event_B02_5cf44d70:
    samantha.say "Прости! Райан написал, что он дома, а нам... нужно кое о чём поговорить. Большое спасибо, что пригласил."

# ch/samantha/events.rpy:5094
translate russian samantha_event_B02_bc6c000e_1:
    mike.say "Тебе здесь всегда рады."

# ch/samantha/events.rpy:5098
translate russian samantha_event_B02_a8274fd7:
    "Она широко улыбается. Я даю ей переодеться в ванной, затем провожаю до двери."

# ch/samantha/events.rpy:5099
translate russian samantha_event_B02_d5faf96e_1:
    "Она машет мне, затем притягивает к себе и обнимает. Я провожаю её взглядом."

# ch/samantha/events.rpy:5101
translate russian samantha_event_B02_48429062:
    mike.say "Кажется, ещё осталось вино, если Саша до него не добралась."

# ch/samantha/events.rpy:5103
translate russian samantha_event_B02_35e9e062:
    samantha.say "Отличный план."

# ch/samantha/events.rpy:5107
translate russian samantha_event_B02_7849b60e:
    "Мы идём на кухню. Я открываю шкафчик и достаю наполовину полную бутылку красного."

# ch/samantha/events.rpy:5108
translate russian samantha_event_B02_09771711:
    "Сэм берёт два бокала: ещё помнит, где что лежало в её прошлый визит."

# ch/samantha/events.rpy:5109
translate russian samantha_event_B02_ea9c14c4:
    "Я наполняю оба бокала до краёв. Саманта одобрительно кивает и делает большой глоток. Я следую её примеру."

# ch/samantha/events.rpy:5110
translate russian samantha_event_B02_3ab89dd0:
    mike.say "Не может же всё быть плохо. Что у вас двоих хорошего?"

# ch/samantha/events.rpy:5112
translate russian samantha_event_B02_9b082b7e:
    samantha.say "Ну... В первую брачную ночь он отвёл меня в постель, и мы занялись любовью. Давно он не был таким страстным."

# ch/samantha/events.rpy:5113
translate russian samantha_event_B02_ad185ad4:
    mike.say "А..."

# ch/samantha/events.rpy:5114
translate russian samantha_event_B02_bb1f3689:
    samantha.say "В последнее время он стал очень властным. Не могу сказать, что мне это не нравится."

# ch/samantha/events.rpy:5115
translate russian samantha_event_B02_c346c35f:
    mike.say "Я не совсем это имел в виду, но для начала неплохо."

# ch/samantha/events.rpy:5117
translate russian samantha_event_B02_23182445:
    "Она хихикает и делает ещё глоток."

# ch/samantha/events.rpy:5118
translate russian samantha_event_B02_074ace76:
    samantha.say "Вчера, когда наконец вернулся домой, подарил мне стопку новых книг. Я ещё не начала читать, но выглядят интересно."

# ch/samantha/events.rpy:5119
translate russian samantha_event_B02_0a34b02c:
    mike.say "Это мило."

# ch/samantha/events.rpy:5120
translate russian samantha_event_B02_c24967b7_1:
    samantha.say "М-м."

# ch/samantha/events.rpy:5121
translate russian samantha_event_B02_d34fbdbf:
    "Обстановка напряжённая, но по мере того, как мы пьём, напряжение постепенно спадает."

# ch/samantha/events.rpy:5124
translate russian samantha_event_B02_677acf46:
    mike.say "Как учёба? Уже лучше разбираешься в том материале?"

# ch/samantha/events.rpy:5126
translate russian samantha_event_B02_7b63b263:
    samantha.say "В последнее время было не так много времени заниматься, но хотя бы оценки растут. Боже, как же я ненавижу математику."

# ch/samantha/events.rpy:5127
translate russian samantha_event_B02_71cfe762:
    mike.say "Аналогично."

# ch/samantha/events.rpy:5129
translate russian samantha_event_B02_6be39e4b:
    samantha.say "Зато занятия по литературе замечательные. Нам задали эссе о структуре повествования."

# ch/samantha/events.rpy:5130
translate russian samantha_event_B02_913d3538:
    mike.say "Правда? Как продвигается?"

# ch/samantha/events.rpy:5131
translate russian samantha_event_B02_23922dfe:
    samantha.say "Уже закончила!"

# ch/samantha/events.rpy:5132
translate russian samantha_event_B02_9fd4e90e:
    mike.say "А."

# ch/samantha/events.rpy:5134
translate russian samantha_event_B02_e40118e0:
    mike.say "Всё ещё любишь пекарню?"

# ch/samantha/events.rpy:5136
translate russian samantha_event_B02_fd3351ef:
    samantha.say "Ты ещё спрашиваешь?! Конечно!"

# ch/samantha/events.rpy:5138
translate russian samantha_event_B02_41ac8465:
    samantha.say "Ох, жду не дождусь следующей недели. У нас появятся новые блюда в постоянном меню."

# ch/samantha/events.rpy:5139
translate russian samantha_event_B02_2e026be2:
    mike.say "Какие?"

# ch/samantha/events.rpy:5140
translate russian samantha_event_B02_2e8b21b3:
    samantha.say "Угадай! Мои любимые."

# ch/samantha/events.rpy:5143
translate russian samantha_event_B02_97b886c4:
    samantha.say "Нет! Но отличная идея. Надо предложить."

# ch/samantha/events.rpy:5144
translate russian samantha_event_B02_c00a98e2:
    samantha.say "Добавляем в меню свежие булочки с корицей! В пекарне будет так вкусно пахнуть."

# ch/samantha/events.rpy:5145
translate russian samantha_event_B02_988ebf0f:
    mike.say "Там и так вкусно пахнет."

# ch/samantha/events.rpy:5148
translate russian samantha_event_B02_c2a51c63:
    samantha.say "Да-да! Ты запомнил!"

# ch/samantha/events.rpy:5149
translate russian samantha_event_B02_d6a5315d:
    mike.say "Они у тебя по всему дому валялись. Конечно, помню."

# ch/samantha/events.rpy:5152
translate russian samantha_event_B02_ed8f243b:
    samantha.say "Это пекарня, а не ярмарка!"

# ch/samantha/events.rpy:5153
translate russian samantha_event_B02_6904587c:
    mike.say "Что, хочешь сказать, тебе такое не нравится?"

# ch/samantha/events.rpy:5155
translate russian samantha_event_B02_c76cf1db:
    samantha.say "Нет! Я не об этом. Булочки с корицей! Будем печь булочки с корицей."

# ch/samantha/events.rpy:5157
translate russian samantha_event_B02_cb356b8f:
    mike.say "Чем ты занимаешься целыми днями? Ну, кроме бесконечных мыслей о Райане."

# ch/samantha/events.rpy:5158
translate russian samantha_event_B02_0c3e37fa:
    "Она шутливо сверлит меня взглядом, но всё же отвечает."

# ch/samantha/events.rpy:5159
translate russian samantha_event_B02_b8be4151:
    samantha.say "Дартс... Пишу. Мне нравится проводить время с тобой! Это считается?"

# ch/samantha/events.rpy:5160
translate russian samantha_event_B02_371b8676_2:
    mike.say "..."

# ch/samantha/events.rpy:5161
translate russian samantha_event_B02_f6e67d86:
    mike.say "Да, наверное, считается."

# ch/samantha/events.rpy:5164
translate russian samantha_event_B02_6bcabf74:
    "Внезапная вибрация привлекает наше внимание: телефон Саманты. Она достаёт его из заднего кармана."

# ch/samantha/events.rpy:5166
translate russian samantha_event_B02_90fea5a1:
    samantha.say "Райан написал."

# ch/samantha/events.rpy:5167
translate russian samantha_event_B02_39153bbf:
    samantha.say "Говорит, уже дома!"

# ch/samantha/events.rpy:5168
translate russian samantha_event_B02_5837402f:
    mike.say "То есть ты уходишь?"

# ch/samantha/events.rpy:5170
translate russian samantha_event_B02_80af0e23:
    "Она поднимает на меня большие глаза, словно умоляя простить."

# ch/samantha/events.rpy:5171
translate russian samantha_event_B02_c7b8d8df:
    samantha.say "Прости!"

# ch/samantha/events.rpy:5172
translate russian samantha_event_B02_0b5a3117:
    mike.say "Да всё нормально. Только обязательно поговори с ним!"

# ch/samantha/events.rpy:5173
translate russian samantha_event_B02_e698dad7_2:
    samantha.say "..."

# ch/samantha/events.rpy:5175
translate russian samantha_event_B02_bbda40d6:
    mike.say "Кексик! Ты должна!"

# ch/samantha/events.rpy:5177
translate russian samantha_event_B02_0ae7525a:
    mike.say "Сэм! Ты должна!"

# ch/samantha/events.rpy:5178
translate russian samantha_event_B02_bb2ab4c8:
    samantha.say "Ладно! Поговорю."

# ch/samantha/events.rpy:5179
translate russian samantha_event_B02_e7a9f620:
    mike.say "Хорошо."

# ch/samantha/events.rpy:5180
translate russian samantha_event_B02_0e15e4a9:
    "Она допивает вино и ставит бокал на столешницу. Я провожаю её до двери."

# ch/samantha/events.rpy:5184
translate russian samantha_event_B02_5c59f9a2:
    samantha.say "Спасибо, что пригласил, [lssb_samantha.hero_name()]. Я очень благодарна."

# ch/samantha/events.rpy:5185
translate russian samantha_event_B02_ce48c4f8:
    mike.say "В любое время."

# ch/samantha/events.rpy:5186
translate russian samantha_event_B02_8f95dbf6:
    "Саманта дружелюбно машет на прощание и спускается с крыльца. Я улыбаюсь и закрываю за ней дверь."

# ch/samantha/events.rpy:5214
translate russian samantha_event_B03_0569ed48:
    "В заднем кармане внезапно вибрирует телефон. Достаю его и вижу на экране имя Саманты: пришло сообщение."

# ch/samantha/events.rpy:5215
translate russian samantha_event_B03_60969894:
    samantha.say "Привет."

# ch/samantha/events.rpy:5216
translate russian samantha_event_B03_2822423c:
    mike.say "Привет. Что такое?"

# ch/samantha/events.rpy:5217
translate russian samantha_event_B03_a276e7d7:
    samantha.say "Да ничего."

# ch/samantha/events.rpy:5218
translate russian samantha_event_B03_207db9f3:
    samantha.say "Можно к тебе прийти?"

# ch/samantha/events.rpy:5219
translate russian samantha_event_B03_ae518d7e:
    mike.say "Прямо сейчас?"

# ch/samantha/events.rpy:5220
translate russian samantha_event_B03_9cd860f2:
    samantha.say "Да."

# ch/samantha/events.rpy:5221
translate russian samantha_event_B03_b74ec5ae:
    samantha.say "Просто у меня сейчас совсем пусто дома."

# ch/samantha/events.rpy:5222
translate russian samantha_event_B03_003537d5:
    samantha.say "Не знаю, чем заняться."

# ch/samantha/events.rpy:5225
translate russian samantha_event_B03_804d1235:
    mike.say "Да. Приходи."

# ch/samantha/events.rpy:5226
translate russian samantha_event_B03_40ca7587:
    samantha.say "Спасибо."

# ch/samantha/events.rpy:5227
translate russian samantha_event_B03_e9a33c6d:
    samantha.say "Я очень ценю, что ты меня поддерживаешь."

# ch/samantha/events.rpy:5231
translate russian samantha_event_B03_efb65758:
    mike.say "Прости, Кексик. Я сейчас очень занят."

# ch/samantha/events.rpy:5233
translate russian samantha_event_B03_1ea637f4:
    mike.say "Прости, Сэм. Я сейчас очень занят."

# ch/samantha/events.rpy:5234
translate russian samantha_event_B03_496f3fe0:
    mike.say "Может, в другой раз?"

# ch/samantha/events.rpy:5235
translate russian samantha_event_B03_2a522766:
    samantha.say "Ладно. Прости, что побеспокоила."

# ch/samantha/events.rpy:5240
translate russian samantha_event_B03_a84d845e:
    "Стук в дверь прерывает мои мысли."

# ch/samantha/events.rpy:5247
translate russian samantha_event_B03_5e76750a:
    mike.say "Привет, Кексик."

# ch/samantha/events.rpy:5249
translate russian samantha_event_B03_0ed80da9:
    mike.say "Привет, Сэм."

# ch/samantha/events.rpy:5250
translate russian samantha_event_B03_378bf1a8:
    samantha.say "Привет, [lssb_samantha.hero_name()]. Спасибо, что разрешил прийти."

# ch/samantha/events.rpy:5253
translate russian samantha_event_B03_2c6406d7:
    mike.say "Кексик?"

# ch/samantha/events.rpy:5255
translate russian samantha_event_B03_13a94265:
    mike.say "Сэм?"

# ch/samantha/events.rpy:5256
translate russian samantha_event_B03_16fe5c64:
    samantha.say "Привет..."

# ch/samantha/events.rpy:5258
translate russian samantha_event_B03_9240b967:
    samantha.say "Прости. Знаю, ты говорил, что занят, но..."

# ch/samantha/events.rpy:5259
translate russian samantha_event_B03_7c6ca57a:
    samantha.say "Мне просто нужно сейчас с кем-нибудь побыть."

# ch/samantha/events.rpy:5260
translate russian samantha_event_B03_9e87c9b7:
    mike.say "А. Ладно."

# ch/samantha/events.rpy:5264
translate russian samantha_event_B03_7e55313f:
    "Я провожу Саманту в гостиную. Она нервно стоит, потирая руки и поглядывая на лестницу, будто боится, что кто-нибудь войдёт."

# ch/samantha/events.rpy:5265
translate russian samantha_event_B03_89dc923c:
    mike.say "Ты в порядке?"

# ch/samantha/events.rpy:5266
translate russian samantha_event_B03_f24c477d:
    samantha.say "Я... Эм..."

# ch/samantha/events.rpy:5268
translate russian samantha_event_B03_b1cd238d:
    "По её щекам одна за другой катятся слёзы. Не знаю, что сказать."

# ch/samantha/events.rpy:5269
translate russian samantha_event_B03_4e150ad8:
    mike.say "Хочешь перейти в другое место?"

# ch/samantha/events.rpy:5270
translate russian samantha_event_B03_9aa66d97:
    "Она кивает, торопливо вытирая глаза краем рукава. Мы идём в мою комнату. Когда добираемся, она уже рыдает в голос."

# ch/samantha/events.rpy:5274
translate russian samantha_event_B03_371b8676:
    mike.say "..."

# ch/samantha/events.rpy:5278
translate russian samantha_event_B03_97636df3:
    mike.say "Кексик... Ты в порядке? Что-то случилось?"

# ch/samantha/events.rpy:5280
translate russian samantha_event_B03_8b24e0b6:
    mike.say "Сэм... Ты в порядке? Что-то случилось?"

# ch/samantha/events.rpy:5281
translate russian samantha_event_B03_1794c04b:
    samantha.say "Я... Я..."

# ch/samantha/events.rpy:5282
translate russian samantha_event_B03_72cd8b2e:
    samantha.say "Я не... Я..."

# ch/samantha/events.rpy:5283
translate russian samantha_event_B03_08f46c0d:
    "Кажется, она ещё не готова говорить, и я стараюсь не давить."

# ch/samantha/events.rpy:5285
translate russian samantha_event_B03_a20cefa7:
    "..."

# ch/samantha/events.rpy:5287
translate russian samantha_event_B03_108212c0:
    "Усаживаю её на кровать и сажусь рядом. Она склоняется мне на плечо, и я обнимаю её."

# ch/samantha/events.rpy:5288
translate russian samantha_event_B03_a812482b:
    samantha.say "Я поговорила с Райаном."

# ch/samantha/events.rpy:5289
translate russian samantha_event_B03_c9df3368:
    "Внутри всё леденеет. Так вот почему она плачет? Она ещё не успела продолжить, а гнев уже подступает к горлу."

# ch/samantha/events.rpy:5290
translate russian samantha_event_B03_17722ff0:
    samantha.say "Я правда старалась."

# ch/samantha/events.rpy:5291
translate russian samantha_event_B03_f1dede80:
    samantha.say "Когда спросила, почему его никогда нет дома, он разозлился."

# ch/samantha/events.rpy:5292
translate russian samantha_event_B03_553ded08:
    samantha.say "А когда сказала, что хочу проводить больше времени вместе, ответил: то, что я теперь его жена, не даёт мне права его контролировать."

# ch/samantha/events.rpy:5293
translate russian samantha_event_B03_faccf31a:
    samantha.say "Это было пару дней назад. С тех пор он домой не приходил."

# ch/samantha/events.rpy:5294
translate russian samantha_event_B03_4a1acbe0:
    "Райан... ушёл? Нет, он вернётся. Уверен."

# ch/samantha/events.rpy:5295
translate russian samantha_event_B03_c26936e6:
    "Он козёл, но не станет просто бросать Саманту из-за небольшой ссоры."

# ch/samantha/events.rpy:5297
translate russian samantha_event_B03_7a164a69:
    mike.say "Кексик, мне так жаль."

# ch/samantha/events.rpy:5299
translate russian samantha_event_B03_f1249227:
    mike.say "Сэм, мне так жаль."

# ch/samantha/events.rpy:5300
translate russian samantha_event_B03_adc4bc9a:
    samantha.say "Не стоило об этом заговаривать. Я сама во всём виновата."

# ch/samantha/events.rpy:5301
translate russian samantha_event_B03_9696d999:
    mike.say "Эй! Не говори так. Ты совершенно не виновата. Райан — мудак, вот и всё."

# ch/samantha/events.rpy:5302
translate russian samantha_event_B03_510e0d9f:
    samantha.say "Нет, виновата! Я была... слишком агрессивной. Разозлила его. Нужно было говорить спокойнее."

# ch/samantha/events.rpy:5303
translate russian samantha_event_B03_0131532f:
    "Это явная неправда. Саманта — самая добрая девушка из всех, кого я встречал. Если кто и проявлял агрессию, то Райан."

# ch/samantha/events.rpy:5304
translate russian samantha_event_B03_d356d3ec:
    "Не думаю, что она вообще могла повысить голос."

# ch/samantha/events.rpy:5305
translate russian samantha_event_B03_6c0f1875:
    mike.say "Это неправда. Я знаю, всё было не так. И ты тоже знаешь."

# ch/samantha/events.rpy:5306
translate russian samantha_event_B03_c829d481:
    "Она не отвечает, только качает головой. Я беру её руки в свои: они бледные и дрожат."

# ch/samantha/events.rpy:5307
translate russian samantha_event_B03_33b3efe0:
    "На это тяжело смотреть. От тревоги сжимается горло."

# ch/samantha/events.rpy:5308
translate russian samantha_event_B03_6c67432d:
    mike.say "Послушай. Сегодня мы забудем о Райане. Он не заслуживает, чтобы ты о нём думала."

# ch/samantha/events.rpy:5309
translate russian samantha_event_B03_0435b7b7:
    samantha.say "Но..."

# ch/samantha/events.rpy:5310
translate russian samantha_event_B03_2878f3f5:
    mike.say "Никаких «но». Хоть раз подумаешь о себе."

# ch/samantha/events.rpy:5311
translate russian samantha_event_B03_163d3646:
    samantha.say "...Не могу. Прости."

# ch/samantha/events.rpy:5312
translate russian samantha_event_B03_5ca0dd42:
    mike.say "Ты должна. Если не ради себя, то ради меня."

# ch/samantha/events.rpy:5314
translate russian samantha_event_B03_97d1c498:
    samantha.say "Я не знаю как."

# ch/samantha/events.rpy:5315
translate russian samantha_event_B03_3d029bdf:
    "Мысли мечутся. Что сделать? Как её отвлечь?"

# ch/samantha/events.rpy:5316
translate russian samantha_event_B03_e698dad7:
    samantha.say "..."

# ch/samantha/events.rpy:5317
translate russian samantha_event_B03_3524ce9e:
    samantha.say "М-мф!"

# ch/samantha/events.rpy:5322
translate russian samantha_event_B03_d56df2b7:
    "И прежде чем успеваю осознать... Я наклоняюсь и целую её."

# ch/samantha/events.rpy:5323
translate russian samantha_event_B03_5859168e:
    "И тут же чуть не получаю сердечный приступ. О чём я думаю? Это лишь всё ухудшит. Повезёт, если она сейчас не уйдёт."

# ch/samantha/events.rpy:5327
translate russian samantha_event_B03_91b1c6d3:
    mike.say "Боже... Прости! Я не..."

# ch/samantha/events.rpy:5332
translate russian samantha_event_B03_be1ea22d:
    "На мгновение её взгляд стекленеет. Я моргаю, и её губы снова прижимаются к моим. Но на этот раз начал не я."

# ch/samantha/events.rpy:5333
translate russian samantha_event_B03_f00d0784:
    "Мои руки скользят в её светлые волосы. Они мягкие и чистые, будто она весь день расчёсывала их от скуки."

# ch/samantha/events.rpy:5334
translate russian samantha_event_B03_8f9bce68:
    "Кровь закипает от мысли, что она, наверное, и правда делала это, только от тревоги."

# ch/samantha/events.rpy:5335
translate russian samantha_event_B03_c68cfeec:
    "Её язык касается моих губ. Мне вдруг не хватает воздуха, я вдыхаю и впускаю его. Он невероятно мягкий."

# ch/samantha/events.rpy:5336
translate russian samantha_event_B03_90299323:
    "Чувствую соль её слёз вперемешку с тёплой сладкой слюной."

# ch/samantha/events.rpy:5337
translate russian samantha_event_B03_33ed9135:
    "Руки Саманты ложатся мне на грудь. Она то слепо хватается за меня, то осмысленно исследует каждый изгиб тела."

# ch/samantha/events.rpy:5338
translate russian samantha_event_B03_0f3578c2:
    "Мне нужно делать то же самое. Запускаю руки ей под футболку, касаюсь голой спины. Легко нахожу застёжку бюстгальтера и рассеянно тереблю её одной рукой."

# ch/samantha/events.rpy:5339
translate russian samantha_event_B03_54b9c850:
    "Другой веду вдоль позвоночника, медленно спускаясь всё ниже."

# ch/samantha/events.rpy:5340
translate russian samantha_event_B03_8634b055:
    "Когда я достигаю пояса её брюк, она ахает мне в рот. Я просовываю под него пальцы и слегка тяну."

# ch/samantha/events.rpy:5341
translate russian samantha_event_B03_e4985973:
    "Одновременно её руки крепко сжимают мои бёдра. Внизу живота разливается жар, и джинсы становятся тесными в паху."

# ch/samantha/events.rpy:5342
translate russian samantha_event_B03_23e7fdbe:
    "Пальцы у застёжки немного путаются, но наконец расстёгивают её. Бюстгальтер Саманты ослабевает и сползает вперёд."

# ch/samantha/events.rpy:5343
translate russian samantha_event_B03_c66aa497:
    "В следующее мгновение я уже без футболки."

# ch/samantha/events.rpy:5347
translate russian samantha_event_B03_65fca506:
    samantha.say "[lssb_samantha.hero_name()]!"

# ch/samantha/events.rpy:5348
translate russian samantha_event_B03_f28501b2:
    "Саманта стягивает футболку через голову, и бюстгальтер падает на пол. Передо мной её большая, идеально округлая грудь."

# ch/samantha/events.rpy:5350
translate russian samantha_event_B03_74350e25:
    "Я укладываю её на покрывало и тут же беру один сосок в рот. Подо мной раздаётся её вздох."

# ch/samantha/events.rpy:5352
translate russian samantha_event_B03_bdc2839c:
    "Язык касается чего-то твёрдого. Пирсинг?"

# ch/samantha/events.rpy:5353
translate russian samantha_event_B03_f26efb0d:
    "На миг вспоминаю наш поход в секс-шоп. Ага. Точно пирсинг."

# ch/samantha/events.rpy:5356
translate russian samantha_event_B03_7dac2c21:
    "Решившись, обвожу языком металл и сильно втягиваю губами."

# ch/samantha/events.rpy:5357
translate russian samantha_event_B03_144312f1:
    samantha.say "М-мх!"

# ch/samantha/events.rpy:5358
translate russian samantha_event_B03_5d6c9499:
    "Зубы звякают о колечко. Я тяну его вверх и в сторону. Она извивается подо мной."

# ch/samantha/events.rpy:5359
translate russian samantha_event_B03_5417810b:
    "От сочетания кожи и металла лицо горит предвкушением."

# ch/samantha/events.rpy:5360
translate russian samantha_event_B03_b5c7ea62:
    "Руки дёргаются, требуя дела. Одна скользит под её бедро и сжимает пышную попку."

# ch/samantha/events.rpy:5361
translate russian samantha_event_B03_601041f3:
    "Другая играет с колечком во втором соске, дразняще обводя его пальцем."

# ch/samantha/events.rpy:5363
translate russian samantha_event_B03_f7e53979:
    mike.say "Можешь?.."

# ch/samantha/events.rpy:5365
translate russian samantha_event_B03_477e252c:
    "Я ещё не успеваю договорить, а она, словно прочитав мысли, уже вынимает украшения и отбрасывает их в сторону."

# ch/samantha/events.rpy:5366
translate russian samantha_event_B03_7d25aff3:
    "Губы находят мягкую плоть, втягивая сосок в рот. Её кожа нежная, почти сладкая — словно конфета."

# ch/samantha/events.rpy:5367
translate russian samantha_event_B03_6e70aaa2:
    "Я осторожно провожу зубами по чувствительному соску. Как будто издалека слышу её вздох."

# ch/samantha/events.rpy:5368
translate russian samantha_event_B03_9f84c17d:
    "Язык кружит по коже. От выступающего соска я спускаюсь ниже."

# ch/samantha/events.rpy:5369
translate russian samantha_event_B03_e5713a9e:
    "Провожу языком в складке под грудью, почти уткнувшись носом в её мягкие груди. Её руки лежат у меня в волосах."

# ch/samantha/events.rpy:5370
translate russian samantha_event_B03_c2a86f1b:
    "Каждое её прикосновение исполнено любви и нежности."

# ch/samantha/events.rpy:5372
translate russian samantha_event_B03_7d25aff3_1:
    "Губы находят мягкую плоть, втягивая сосок в рот. Её кожа нежная, почти сладкая — словно конфета."

# ch/samantha/events.rpy:5373
translate russian samantha_event_B03_6e70aaa2_1:
    "Я осторожно провожу зубами по чувствительному соску. Как будто издалека слышу её вздох."

# ch/samantha/events.rpy:5374
translate russian samantha_event_B03_9f84c17d_1:
    "Язык кружит по коже. От выступающего соска я спускаюсь ниже."

# ch/samantha/events.rpy:5375
translate russian samantha_event_B03_e5713a9e_1:
    "Провожу языком в складке под грудью, почти уткнувшись носом в её мягкие груди. Её руки лежат у меня в волосах."

# ch/samantha/events.rpy:5376
translate russian samantha_event_B03_c2a86f1b_1:
    "Каждое её прикосновение исполнено любви и нежности."

# ch/samantha/events.rpy:5377
translate russian samantha_event_B03_b09277bf:
    samantha.say "[lssb_samantha.hero_name()]! Пожалуйста! Мне нужно..."

# ch/samantha/events.rpy:5378
translate russian samantha_event_B03_7912cb01:
    "Саманта скидывает брюки с кровати, затем умело расстёгивает мои джинсы."

# ch/samantha/events.rpy:5379
translate russian samantha_event_B03_226d49e5:
    "Когда джинсы падают на пол, а следом трусы, нарастающее давление наконец исчезает."

# ch/samantha/events.rpy:5380
translate russian samantha_event_B03_54c34994:
    "Мой член устремлён к потолку и больше не желает ждать."

# ch/samantha/events.rpy:5381
translate russian samantha_event_B03_d36af367:
    "Я развожу её бёдра, и она послушно раскрывается. Моя кожа пылает."

# ch/samantha/events.rpy:5382
translate russian samantha_event_B03_b0ac5cba:
    "Жар почти удушливый. От неё меня отделяет лишь тонкая ткань внизу."

# ch/samantha/events.rpy:5383
translate russian samantha_event_B03_f872599c:
    "Я утыкаюсь носом ей в трусики, и от её запаха кружится голова."

# ch/samantha/events.rpy:5384
translate russian samantha_event_B03_0f1a0f96:
    "На ткани проступило влажное пятно. Я отстраняюсь. Её полные бёдра манят вернуться."

# ch/samantha/events.rpy:5385
translate russian samantha_event_B03_b0da1fe7:
    "Склоняюсь между её бёдер, цепляю трусики зубами и тяну вниз, пока они не оказываются у колен."

# ch/samantha/events.rpy:5386
translate russian samantha_event_B03_ffce67b8:
    "Когда возвращаюсь, она уже ещё мокрее, сочится от нетерпения и тяжело дышит. Я тоже."

# ch/samantha/events.rpy:5392
translate russian samantha_event_B03_ad9cbf2f:
    "Я провожу языком по её киске. Там горячо, и она вздрагивает подо мной."

# ch/samantha/events.rpy:5394
translate russian samantha_event_B03_7537b8de:
    samantha.say "О боже!"

# ch/samantha/events.rpy:5396
translate russian samantha_event_B03_ac9c8767:
    "Её слова подстёгивают меня. Нахожу взглядом клитор и припадаю к нему ртом."

# ch/samantha/events.rpy:5398
translate russian samantha_event_B03_d4f92248:
    "У неё особенный вкус и пьянящий запах. Ничего подобного я ещё не испытывал."

# ch/samantha/events.rpy:5400
translate russian samantha_event_B03_162cf979:
    "Её бёдра извиваются от наслаждения. Она сильно тянет меня за волосы."

# ch/samantha/events.rpy:5402
translate russian samantha_event_B03_11921d32:
    "Я отстраняюсь, глотая воздух и не обращая внимания на её разочарованный стон. Прежде чем она успевает опомниться, смачиваю пальцы во рту и начинаю раздвигать её анус."

# ch/samantha/events.rpy:5404
translate russian samantha_event_B03_06668fa6:
    samantha.say "Ты мне нужен, нужен!"

# ch/samantha/events.rpy:5406
translate russian samantha_event_B03_4f9f8b3a:
    mike.say "Я буду твоим."

# ch/samantha/events.rpy:5408
translate russian samantha_event_B03_f74446e2:
    "Двигаю пальцем внутри неё и лижу клитор, словно это самое вкусное на свете. Возможно, так и есть."

# ch/samantha/events.rpy:5410
translate russian samantha_event_B03_0fe995d0:
    mike.say "Готова? Всё хорошо?"

# ch/samantha/events.rpy:5412
translate russian samantha_event_B03_87ec722f:
    samantha.say "Войди в меня."

# ch/samantha/events.rpy:5415
translate russian samantha_event_B03_53a2a4ba:
    "Игнорировать твёрдость между ног больше невозможно. Я направляю член."

# ch/samantha/events.rpy:5420
translate russian samantha_event_B03_d5954b60:
    "Я надеваю презерватив и вхожу в неё."

# ch/samantha/events.rpy:5423
translate russian samantha_event_B03_d54c2be4:
    "Я плюю на ладонь, стараюсь как следует смочить член и вхожу в неё."

# ch/samantha/events.rpy:5426
translate russian samantha_event_B03_d54c2be4_1:
    "Я плюю на ладонь, стараюсь как следует смочить член и вхожу в неё."

# ch/samantha/events.rpy:5432
translate russian samantha_event_B03_b7d0f5e2:
    samantha.say "Ах... А-а!"

# ch/samantha/events.rpy:5433
translate russian samantha_event_B03_5cc29ea2:
    "Я медлю лишь мгновение, но, поняв, что она кричит от желания, а не от боли, продолжаю."

# ch/samantha/events.rpy:5434
translate russian samantha_event_B03_c282dac7:
    "Внутри неё тепло. Мне нужно больше, я резко двигаюсь взад-вперёд. Наши тела шлёпаются друг о друга, и эти звуки смешиваются со стонами."

# ch/samantha/events.rpy:5436
translate russian samantha_event_B03_3e1a4c38:
    "Она сжимает меня изнутри, затягивая так, как ничто прежде."

# ch/samantha/events.rpy:5437
translate russian samantha_event_B03_074ae4b6:
    "Я с трудом открываю глаза и вижу расслабленное от наслаждения лицо Саманты. Оно, как и грудь, раскраснелось, а груди подпрыгивают с каждым толчком."

# ch/samantha/events.rpy:5438
translate russian samantha_event_B03_46c9e3c4:
    samantha.say "Ах... [lssb_samantha.hero_name()]."

# ch/samantha/events.rpy:5440
translate russian samantha_event_B03_1604b51b:
    "Меня переворачивают на спину, голова кружится. Когда прихожу в себя, она уже сверху, попкой ко мне."

# ch/samantha/events.rpy:5441
translate russian samantha_event_B03_05a1912c:
    "Я стону от этого движения."

# ch/samantha/events.rpy:5442
translate russian samantha_event_B03_3e7a74e8:
    "Взяв управление на себя, она поднимается и опускается. Мой член твёрже некуда, я на грани."

# ch/samantha/events.rpy:5443
translate russian samantha_event_B03_dc2a511a:
    "Руки находят её бёдра. Пальцы впиваются в кожу, мягкая плоть легко поддаётся."

# ch/samantha/events.rpy:5444
translate russian samantha_event_B03_bbda0108:
    "Я чувствую приближение оргазма. Внизу нарастает напряжение. Мне нужна разрядка."

# ch/samantha/events.rpy:5446
translate russian samantha_event_B03_550b067d:
    mike.say "Кексик! Я... Я сейчас..."

# ch/samantha/events.rpy:5448
translate russian samantha_event_B03_421ec721:
    mike.say "Сэм! Я... Я сейчас..."

# ch/samantha/events.rpy:5449
translate russian samantha_event_B03_764cc68a:
    "Руки и ноги обмякают, бёдра сводит судорогой. Я судорожно хватаю воздух."

# ch/samantha/events.rpy:5451
translate russian samantha_event_B03_a9d3c401:
    "В ушах шумит, по краям зрения темнеет от захлестнувшего наслаждения."

# ch/samantha/events.rpy:5454
translate russian samantha_event_B03_b16d77eb:
    "Как бы мне ни хотелось остаться, что-то в глубине сознания настойчиво напоминает о себе."

# ch/samantha/events.rpy:5456
translate russian samantha_event_B03_6a3b2192:
    "Я успеваю выскользнуть из её влажного лона, и горячая сперма выплёскивается на внутреннюю сторону бёдер."

# ch/samantha/events.rpy:5458
translate russian samantha_event_B03_06be122a:
    samantha.say "Ах, [lssb_samantha.hero_name()]... Ты такой тёплый."

# ch/samantha/events.rpy:5460
translate russian samantha_event_B03_c9f2c849:
    "Её щёки всё ещё пылают, но глаза уже закрываются."

# ch/samantha/events.rpy:5461
translate russian samantha_event_B03_4ec2a580:
    "Дрожащей рукой она проводит по моим спутанным волосам и притягивает к себе для ещё одного поцелуя."

# ch/samantha/events.rpy:5462
translate russian samantha_event_B03_3e61b186:
    "Губы Саманты пухлые, рот такой же мягкий."

# ch/samantha/events.rpy:5463
translate russian samantha_event_B03_d3a8c134:
    "Почти как во сне. Но это точно не сон."

# ch/samantha/events.rpy:5464
translate russian samantha_event_B03_c71f7992:
    "Я устал. Сэм меня совсем вымотала."

# ch/samantha/events.rpy:5465
translate russian samantha_event_B03_d371a100:
    "Я падаю на кровать рядом с ней, и она смотрит на меня."

# ch/samantha/events.rpy:5466
translate russian samantha_event_B03_12d30e6b:
    "Я прочищаю горло."

# ch/samantha/events.rpy:5470
translate russian samantha_event_B03_2c0679d6:
    mike.say "Эм..."

# ch/samantha/events.rpy:5471
translate russian samantha_event_B03_41503f75:
    samantha.say "Тс-с."

# ch/samantha/events.rpy:5472
translate russian samantha_event_B03_d9f6db02:
    mike.say "Но..."

# ch/samantha/events.rpy:5473
translate russian samantha_event_B03_d8d6c997:
    samantha.say "Как только начну думать о том, что мы сделали, меня накроет паника. Я просто хочу... насладиться этим."

# ch/samantha/events.rpy:5474
translate russian samantha_event_B03_71998ec7:
    mike.say "...Ладно."

# ch/samantha/events.rpy:5475
translate russian samantha_event_B03_f449708a:
    "Плечи Саманты расслабляются. Она поворачивается ко мне, укладывается на грудь и глубоко вдыхает."

# ch/samantha/events.rpy:5476
translate russian samantha_event_B03_e4c1a0d9:
    "Веки тяжелеют, и я ничего не могу с этим поделать."

# ch/samantha/events.rpy:5477
translate russian samantha_event_B03_db0fbf4b:
    "Сознание погружается во тьму, а Сэм укрывает меня словно уютное одеяло."

# ch/samantha/events.rpy:5482
translate russian samantha_event_B03_6189cd42:
    "Я кончаю в неё."

# ch/samantha/events.rpy:5489
translate russian samantha_event_B03_4133705f:
    "Я кончаю в презерватив."

# ch/samantha/events.rpy:5491
translate russian samantha_event_B03_7768b74c:
    "Напряжение наконец отпускает. Слух возвращается, и я замечаю, что смотрю в потолок, тяжело дыша."

# ch/samantha/events.rpy:5492
translate russian samantha_event_B03_c43b1ab4:
    "Сэм без сил лежит на мне. Теперь мне тепло совсем по другой причине."

# ch/samantha/events.rpy:5493
translate russian samantha_event_B03_a79b8ac1:
    "Девушка, в которую я давно влюблён, наконец со мной."

# ch/samantha/events.rpy:5498
translate russian samantha_event_B03_3c284df4:
    "Я обнимаю её за спину."

# ch/samantha/events.rpy:5499
translate russian samantha_event_B03_8987ebd7:
    "Мы оба измотаны."

# ch/samantha/events.rpy:5500
translate russian samantha_event_B03_da4bd825:
    "Её волосы разметались повсюду, пряди падают мне на лицо."

# ch/samantha/events.rpy:5501
translate russian samantha_event_B03_b9e7c36a:
    "Меня это совсем не волнует. Я чувствую лишь тяжесть век."

# ch/samantha/events.rpy:5502
translate russian samantha_event_B03_b22e5ec1:
    "Проваливаюсь во тьму, с радостью отдаваясь подступившему сну."

# ch/samantha/events.rpy:5505
translate russian samantha_event_B03_e698dad7_1:
    samantha.say "..."

# ch/samantha/events.rpy:5506
translate russian samantha_event_B03_6d256d0b:
    samantha.say "Фу."

# ch/samantha/events.rpy:5507
translate russian samantha_event_B03_8a4d85e9:
    "Руки Саманты двигаются у меня на груди."

# ch/samantha/events.rpy:5508
translate russian samantha_event_B03_64459de7:
    "Слышу, как она неудобно ёрзает на покрывале."

# ch/samantha/events.rpy:5509
translate russian samantha_event_B03_6d256d0b_1:
    samantha.say "Фу."

# ch/samantha/events.rpy:5510
translate russian samantha_event_B03_81742017:
    "Её слова наконец пробиваются сквозь сонную пелену."

# ch/samantha/events.rpy:5514
translate russian samantha_event_B03_dc2043e7:
    "Я открываю глаза. Она смотрит не на меня — слава богу, — а на свои ноги."

# ch/samantha/events.rpy:5515
translate russian samantha_event_B03_00228927:
    "А, точно. Мы ведь так и не привели себя в порядок?"

# ch/samantha/events.rpy:5516
translate russian samantha_event_B03_ff645163:
    mike.say "Фу? Не так уж всё плохо."

# ch/samantha/events.rpy:5517
translate russian samantha_event_B03_305e4c9d:
    "Сэм поднимает взгляд, в котором смешались отвращение и вялое раздражение."

# ch/samantha/events.rpy:5519
translate russian samantha_event_B03_3638bf28:
    samantha.say "Когда холодное и липкое — ещё как плохо!"

# ch/samantha/events.rpy:5520
translate russian samantha_event_B03_9d9e6cd6:
    mike.say "Ладно. Убедила."

# ch/samantha/events.rpy:5521
translate russian samantha_event_B03_93aa0930:
    mike.say "Ванная должна быть свободна, если хочешь... привести себя в порядок."

# ch/samantha/events.rpy:5523
translate russian samantha_event_B03_515aea64:
    "Саманта кивает."

# ch/samantha/events.rpy:5524
translate russian samantha_event_B03_277e73a0:
    samantha.say "Душ бы не помешал."

# ch/samantha/events.rpy:5525
translate russian samantha_event_B03_b3d8b549:
    "Я медленно сажусь. По краям зрения темнеет, и я жду, пока головокружение пройдёт."

# ch/samantha/events.rpy:5526
translate russian samantha_event_B03_040436ce:
    "Когда оно проходит, Сэм уже стоит у кровати."

# ch/samantha/events.rpy:5527
translate russian samantha_event_B03_984eebb7:
    "Старается идти так, чтобы бёдра не соприкасались, но... В её случае это почти невозможно."

# ch/samantha/events.rpy:5528
translate russian samantha_event_B03_dcc27127:
    "У двери она на миг медлит, затем хватает лежащее неподалёку одеяло, заворачивается и выходит."

# ch/samantha/events.rpy:5530
translate russian samantha_event_B03_6bfe4f82:
    "Я остаюсь наедине с мыслями."

# ch/samantha/events.rpy:5531
translate russian samantha_event_B03_2b373444:
    "Мне должно быть жаль Райана. И в какой-то мере жаль."

# ch/samantha/events.rpy:5532
translate russian samantha_event_B03_74f5a249:
    "Он сам упустил идеальную девушку. Сам виноват."

# ch/samantha/events.rpy:5533
translate russian samantha_event_B03_ed4192e1:
    "Если даже такая милая девушка, как Сэм, перестала хранить верность, значит, последние недели он вёл себя как настоящий мудак."

# ch/samantha/events.rpy:5534
translate russian samantha_event_B03_3f53d66e:
    "Может, наконец рассказать ей, что я видел? Сейчас подходящий момент?"

# ch/samantha/events.rpy:5535
translate russian samantha_event_B03_5f1f93d5:
    "Вряд ли для этого вообще бывает «подходящий» момент. Но теперь я увереннее. Она ведь хочет быть со мной?"

# ch/samantha/events.rpy:5536
translate russian samantha_event_B03_6fdcc912:
    "Проходит несколько минут, и я надеваю вчерашнюю одежду. В душ схожу после неё."

# ch/samantha/events.rpy:5537
translate russian samantha_event_B03_57f997b9:
    "Натягивая футболку через голову, хмурюсь: внутренний спор только нарастает."

# ch/samantha/events.rpy:5538
translate russian samantha_event_B03_577b8253:
    "Невозможно рассказать Саманте о Райане так, чтобы она не расплакалась."

# ch/samantha/events.rpy:5539
translate russian samantha_event_B03_1b2a7983:
    "Я не хочу снова видеть её такой. Может, и правда лучше промолчать."

# ch/samantha/events.rpy:5541
translate russian samantha_event_B03_e9749342:
    "Прежде чем я принимаю решение, дверь спальни открывается."

# ch/samantha/events.rpy:5542
translate russian samantha_event_B03_aaa8c3d1:
    "Влажные волосы Сэм собраны в хвост, вокруг груди обёрнуто пушистое белое полотенце."

# ch/samantha/events.rpy:5543
translate russian samantha_event_B03_8e4c3cd7:
    "Теперь, когда она помылась, выглядит гораздо счастливее."

# ch/samantha/events.rpy:5544
translate russian samantha_event_B03_f38fef03:
    "Но, увидев меня, она становится напряжённее, словно не знает, что сказать."

# ch/samantha/events.rpy:5545
translate russian samantha_event_B03_797179f6:
    "Я тоже не знаю. Но оставлять всё так точно нельзя."

# ch/samantha/events.rpy:5547
translate russian samantha_event_B03_bd102f95:
    "Она начинает надевать вчерашнюю одежду."

# ch/samantha/events.rpy:5552
translate russian samantha_event_B03_6db7ec1d:
    mike.say "Кексик... Нам нужно поговорить."

# ch/samantha/events.rpy:5554
translate russian samantha_event_B03_458c1e63:
    mike.say "Сэм... Нам нужно поговорить."

# ch/samantha/events.rpy:5556
translate russian samantha_event_B03_e67bee02:
    samantha.say "Ты прав. Нам не стоило этого делать."

# ch/samantha/events.rpy:5557
translate russian samantha_event_B03_7c92abc3:
    mike.say "Нет! То есть да. Но нет. Я не об этом."

# ch/samantha/events.rpy:5559
translate russian samantha_event_B03_ee9cc121:
    samantha.say "О чём тогда?"

# ch/samantha/events.rpy:5560
translate russian samantha_event_B03_109f1159:
    "Понимаю, что одних слов недостаточно, особенно после прошлой ночи."

# ch/samantha/events.rpy:5561
translate russian samantha_event_B03_f361f32d:
    "Беру телефон с тумбочки, вспомнив о снимке."

# ch/samantha/events.rpy:5562
translate russian samantha_event_B03_b155a598:
    samantha.say "Что-то не так?"

# ch/samantha/events.rpy:5563
translate russian samantha_event_B03_36211f2f:
    mike.say "Кажется, я знаю, почему Райан так отдалился."

# ch/samantha/events.rpy:5564
translate russian samantha_event_B03_904b8ef5:
    "Саманта выглядит озадаченной, но молчит. Я разблокирую телефон, задержав палец над снимком из бара."

# ch/samantha/events.rpy:5566
translate russian samantha_event_B03_702ebc20:
    mike.say "Я видел Райана в баре. С другой девушкой."

# ch/samantha/events.rpy:5568
translate russian samantha_event_B03_3a50c23a:
    mike.say "Я видел Райана на свадьбе. С другой девушкой."

# ch/samantha/events.rpy:5569
translate russian samantha_event_B03_e698dad7_2:
    samantha.say "..."

# ch/samantha/events.rpy:5570
translate russian samantha_event_B03_a05f8ed1:
    "Поворачиваю экран к ней. Тёмный снимок освещает её побледневшее лицо. Заметив Райана, она расширяет глаза."

# ch/samantha/events.rpy:5571
translate russian samantha_event_B03_e698dad7_3:
    samantha.say "..."

# ch/samantha/events.rpy:5572
translate russian samantha_event_B03_47587647:
    samantha.say "Когда это было?"

# ch/samantha/events.rpy:5573
translate russian samantha_event_B03_ea2bb0b7:
    "Я открываю рот, чтобы ответить, но тут же закрываю, осознав всё."

# ch/samantha/events.rpy:5574
translate russian samantha_event_B03_a0c64940:
    samantha.say "Давно ты об этом знаешь?"

# ch/samantha/events.rpy:5575
translate russian samantha_event_B03_53f68d4d:
    mike.say "Эм... Уже какое-то время."

# ch/samantha/events.rpy:5576
translate russian samantha_event_B03_55d0a3f6:
    samantha.say "Ты знал... и не сказал мне?"

# ch/samantha/events.rpy:5577
translate russian samantha_event_B03_2a9209c8:
    "Её слова накрывают меня чувством вины."

# ch/samantha/events.rpy:5579
translate russian samantha_event_B03_340c45de:
    samantha.say "Я только что вышла замуж! А ты даже перед свадьбой не сказал!"

# ch/samantha/events.rpy:5582
translate russian samantha_event_B03_3fcc09f0:
    "Меня вдруг охватывает раздражение. Она понимает, где сейчас находится?"

# ch/samantha/events.rpy:5583
translate russian samantha_event_B03_9c49f9d9:
    mike.say "Думаешь, ты намного лучше него? Ты тоже действовала за его спиной."

# ch/samantha/events.rpy:5584
translate russian samantha_event_B03_6904c301:
    mike.say "Нельзя злиться на него за то, что делаешь сама."

# ch/samantha/events.rpy:5586
translate russian samantha_event_B03_44f4b87c:
    samantha.say "Я... Это не...!"

# ch/samantha/events.rpy:5587
translate russian samantha_event_B03_90097073:
    "Похоже, я сильно её задел. В широко раскрытых глазах отражается вина."

# ch/samantha/events.rpy:5588
translate russian samantha_event_B03_73d4eded:
    samantha.say "Нет, нет..."

# ch/samantha/events.rpy:5590
translate russian samantha_event_B03_cfc28be3:
    "Слёзы бесконечно текут по её лицу. Она яростно вытирает щёки, но бесполезно: появляются новые."

# ch/samantha/events.rpy:5591
translate russian samantha_event_B03_63307067:
    "Саманта хватает с пола телефон, видимо, упавший туда вместе с одеждой."

# ch/samantha/events.rpy:5593
translate russian samantha_event_B03_7d92236c:
    mike.say "Кексик, подожди!"

# ch/samantha/events.rpy:5595
translate russian samantha_event_B03_1565ce9e:
    mike.say "Сэм, подожди!"

# ch/samantha/events.rpy:5597
translate russian samantha_event_B03_4e66e5ed:
    "Но дверь уже закрывается за ней. Я вскакиваю с кровати и бросаюсь следом."

# ch/samantha/events.rpy:5600
translate russian samantha_event_B03_58ad8abc:
    "Выбежав в коридор, слышу хлопок входной двери. Чёрт."

# ch/samantha/events.rpy:5606
translate russian samantha_event_B03_4fad813e:
    mike.say "Ты права. Прости. Правда, Кексик, мне очень жаль, что я не рассказал."

# ch/samantha/events.rpy:5608
translate russian samantha_event_B03_a2a6d276:
    mike.say "Ты права. Прости. Правда, Сэм, мне очень жаль, что я не рассказал."

# ch/samantha/events.rpy:5609
translate russian samantha_event_B03_fbf43c42:
    samantha.say "Какого чёрта, [lssb_samantha.hero_name()]? О чём ты думал?"

# ch/samantha/events.rpy:5610
translate russian samantha_event_B03_5d292ff4:
    mike.say "О том, что хочу видеть тебя счастливой. Не хотел, чтобы Райан так тебя ранил."

# ch/samantha/events.rpy:5612
translate russian samantha_event_B03_8254dfa7:
    "Она замолкает, потом вздыхает и садится рядом на кровать. Я стараюсь не смотреть на неё, пока не слышу всхлип."

# ch/samantha/events.rpy:5614
translate russian samantha_event_B03_3c35fc7d:
    mike.say "Ох, Кексик."

# ch/samantha/events.rpy:5616
translate russian samantha_event_B03_8c5f502e:
    mike.say "Ох, Сэм."

# ch/samantha/events.rpy:5618
translate russian samantha_event_B03_1f7c679a:
    "Я обнимаю её. Она утыкается мне в плечо и плачет."

# ch/samantha/events.rpy:5619
translate russian samantha_event_B03_a741ac05:
    samantha.say "Что мне делать, [lssb_samantha.hero_name()]? Я... Я больше не знаю, что делать."

# ch/samantha/events.rpy:5620
translate russian samantha_event_B03_538c0c74:
    mike.say "То, что считаешь правильным. Я хочу, чтобы ты была счастлива. Только это важно."

# ch/samantha/events.rpy:5621
translate russian samantha_event_B03_40ab01ce:
    "Мы ещё долго сидим так. В комнате слышны её всхлипы, ночную тьму сменяет восход, но я наконец чувствую, как тяжесть уходит с груди."

# ch/samantha/events.rpy:5628
translate russian samantha_event_B03_daae82fb:
    "Лучше ничего не говорить."

# ch/samantha/events.rpy:5629
translate russian samantha_event_B03_dbbdfa8a:
    "Если Райан сам не может с этим разобраться, почему именно я должен приносить дурные вести?"

# ch/samantha/events.rpy:5630
translate russian samantha_event_B03_7288e016:
    "Его неумение хранить верность официально не моя проблема."

# ch/samantha/events.rpy:5631
translate russian samantha_event_B03_4787faac:
    samantha.say "[lssb_samantha.hero_name()]."

# ch/samantha/events.rpy:5632
translate russian samantha_event_B03_015b59dd:
    "Услышав своё имя, я поднимаю голову."

# ch/samantha/events.rpy:5633
translate russian samantha_event_B03_44bd799d:
    samantha.say "Нам нужно поговорить."

# ch/samantha/events.rpy:5634
translate russian samantha_event_B03_4f24f991:
    "Я уже боюсь этого разговора."

# ch/samantha/events.rpy:5635
translate russian samantha_event_B03_47acf293:
    mike.say "Да... Знаю."

# ch/samantha/events.rpy:5636
translate russian samantha_event_B03_b4dce20f:
    samantha.say "Насчёт Райана..."

# ch/samantha/events.rpy:5637
translate russian samantha_event_B03_1ee17a7c:
    mike.say "Если хочешь рассказать ему, рассказывай."

# ch/samantha/events.rpy:5638
translate russian samantha_event_B03_c996461a:
    mike.say "Я не обижусь. Можешь свалить всю вину на меня."

# ch/samantha/events.rpy:5640
translate russian samantha_event_B03_e82c3190:
    samantha.say "Нет-нет! Я виновата не меньше."

# ch/samantha/events.rpy:5641
translate russian samantha_event_B03_3b4e7a0e:
    samantha.say "Я просто... не знаю, что сказать. Чувствую вину за то, что предала его, но и тебя хочу."

# ch/samantha/events.rpy:5642
translate russian samantha_event_B03_d2c67679:
    mike.say "...Меня?"

# ch/samantha/events.rpy:5644
translate russian samantha_event_B03_20e765d2:
    samantha.say "Да, тебя. Хочу, чтобы всё получилось."

# ch/samantha/events.rpy:5645
translate russian samantha_event_B03_8e74d7c8:
    samantha.say "Не хочу никого огорчать. Особенно не хочу, чтобы вы с Райаном потеряли дружбу из-за меня."

# ch/samantha/events.rpy:5646
translate russian samantha_event_B03_1b4ebc8d:
    "«Дружба» — громко сказано, но я её не поправляю."

# ch/samantha/events.rpy:5647
translate russian samantha_event_B03_4fa875f9:
    "Она замолкает, словно потерявшись. В голову приходит ужасная идея, и я успеваю высказать её раньше, чем заткнуться."

# ch/samantha/events.rpy:5648
translate russian samantha_event_B03_978f5175:
    mike.say "Знаешь, что могло бы помочь вам всё наладить?"

# ch/samantha/events.rpy:5649
translate russian samantha_event_B03_0d9c5f3a:
    samantha.say "М?"

# ch/samantha/events.rpy:5650
translate russian samantha_event_B03_bba7af8d:
    mike.say "Добавьте разнообразия. Скажи, что хочешь чего-то нового."

# ch/samantha/events.rpy:5651
translate russian samantha_event_B03_35d67937:
    samantha.say "Например?"

# ch/samantha/events.rpy:5652
translate russian samantha_event_B03_f6fbb2d8:
    mike.say "Как насчёт секса втроём?"

# ch/samantha/events.rpy:5654
translate russian samantha_event_B03_f5e9337d:
    "Это может сработать, по крайней мере для Райана. Он найдёт ещё одну девушку, чтобы привести её в постель к Саманте."

# ch/samantha/events.rpy:5655
translate russian samantha_event_B03_52fa559d:
    "Наверняка его это заинтересует."

# ch/samantha/events.rpy:5656
translate russian samantha_event_B03_e698dad7_4:
    samantha.say "..."

# ch/samantha/events.rpy:5657
translate russian samantha_event_B03_af47fd13:
    "Я перегнул палку? Если подумать, Сэм вряд ли хочет слышать о других девушках..."

# ch/samantha/events.rpy:5658
translate russian samantha_event_B03_a8c3c3a6:
    samantha.say "Ты уверен?"

# ch/samantha/events.rpy:5659
translate russian samantha_event_B03_9df0b7ac:
    mike.say "Да, почему нет?"

# ch/samantha/events.rpy:5660
translate russian samantha_event_B03_57e9bceb:
    samantha.say "Правда думаешь, Райану понравится?"

# ch/samantha/events.rpy:5661
translate russian samantha_event_B03_fee6f389:
    mike.say "Нисколько не сомневаюсь."

# ch/samantha/events.rpy:5663
translate russian samantha_event_B03_046b314f:
    "Саманта смотрит на меня, прищурившись. Я рад, что моё предложение её не разозлило."

# ch/samantha/events.rpy:5664
translate russian samantha_event_B03_0347a4f5:
    samantha.say "Наверное, я не против... Может сработать."

# ch/samantha/events.rpy:5665
translate russian samantha_event_B03_c08328d2:
    mike.say "Отлично."

# ch/samantha/events.rpy:5666
translate russian samantha_event_B03_b384072e:
    samantha.say "Я... Сейчас ему позвоню. Нужно встретиться дома!"

# ch/samantha/events.rpy:5667
translate russian samantha_event_B03_fcb15203:
    mike.say "Эм, ладно."

# ch/samantha/events.rpy:5668
translate russian samantha_event_B03_a0476e20:
    samantha.say "Спасибо, [lssb_samantha.hero_name()]! Расскажу, что он скажет."

# ch/samantha/events.rpy:5669
translate russian samantha_event_B03_27b70780:
    mike.say "Это совсем не обязательно..."

# ch/samantha/events.rpy:5671
translate russian samantha_event_B03_66c91142:
    "Но она уже ушла, прижав телефон к уху."

# ch/samantha/events.rpy:5672
translate russian samantha_event_B03_4a9b4456:
    "Что я наделал? Только что предложил Сэм заниматься сексом с ещё большим числом людей, среди которых меня нет?"

# ch/samantha/events.rpy:5673
translate russian samantha_event_B03_b8e1cfb9:
    "Надо бы почаще заботиться о собственных интересах."

# ch/samantha/events.rpy:5674
translate russian samantha_event_B03_8bf1c2a1:
    "Я игнорирую внутренний голос, который твердит, что это плохая идея."

# ch/samantha/events.rpy:5676
translate russian samantha_event_B03_1628cf97:
    "Райан точно согласится и наверняка приведёт ту девушку из бара. Упс."

# ch/samantha/events.rpy:5689
translate russian samantha_event_B04_a20cefa7:
    "..."

# ch/samantha/events.rpy:5691
translate russian samantha_event_B04_929d8eb9:
    "Телефон снова вибрирует."

# ch/samantha/events.rpy:5692
translate russian samantha_event_B04_5329a1ce:
    "Кто бы это ни был, подождёт."

# ch/samantha/events.rpy:5693
translate russian samantha_event_B04_9745b630:
    "Я засовываю телефон в карман..."

# ch/samantha/events.rpy:5695
translate russian samantha_event_B04_ea39e582:
    "Даже из дома слышно дождь."

# ch/samantha/events.rpy:5696
translate russian samantha_event_B04_2bd2149e:
    "Где мой зонт?"

# ch/samantha/events.rpy:5697
translate russian samantha_event_B04_74fe57d9:
    "Некоторое время ищу у входа, затем прихожу к выводу, что кто-то из соседок взял его или где-то потерял."

# ch/samantha/events.rpy:5698
translate russian samantha_event_B04_86852b5c:
    "Вздохнув, поворачиваю ручку и открываю дверь."

# ch/samantha/events.rpy:5703
translate russian samantha_event_B04_a20cefa7_1:
    "..."

# ch/samantha/events.rpy:5704
translate russian samantha_event_B04_0a618afc:
    samantha.say "...[lssb_samantha.hero_name()]."

# ch/samantha/events.rpy:5705
translate russian samantha_event_B04_e0cb33ba:
    "Саманта стоит под дождём, едва укрытая крышей крыльца."

# ch/samantha/events.rpy:5706
translate russian samantha_event_B04_4edfbfd2:
    "Волосы мокрые, одежда усеяна каплями."

# ch/samantha/events.rpy:5707
translate russian samantha_event_B04_e48263e7:
    "Она дрожит, обхватив себя руками."

# ch/samantha/events.rpy:5709
translate russian samantha_event_B04_1caadc24:
    mike.say "Кексик? Что ты здесь делаешь?"

# ch/samantha/events.rpy:5711
translate russian samantha_event_B04_6aac03a4:
    mike.say "Сэм? Что ты здесь делаешь?"

# ch/samantha/events.rpy:5712
translate russian samantha_event_B04_b0c4c526:
    "Я толком ничего не понимаю."

# ch/samantha/events.rpy:5713
translate russian samantha_event_B04_ff5bf368:
    "К этому моменту я уже почти решил, что никогда больше её не увижу."

# ch/samantha/events.rpy:5714
translate russian samantha_event_B04_da8f444a:
    "Но вот она."

# ch/samantha/events.rpy:5715
translate russian samantha_event_B04_3cd6623d:
    "Присмотревшись, понимаю: наверное, она пришла пешком."

# ch/samantha/events.rpy:5717
translate russian samantha_event_B04_b9e4f761:
    samantha.say "Мне нужно с тобой поговорить."

# ch/samantha/events.rpy:5718
translate russian samantha_event_B04_f602a6f0:
    "Мысли о работе вылетают из головы."

# ch/samantha/events.rpy:5722
translate russian samantha_event_B04_a818ca97:
    "Я отступаю, пропуская её внутрь. Она..."

# ch/samantha/events.rpy:5723
translate russian samantha_event_B04_e306313c:
    "Непривычно серьёзная."

# ch/samantha/events.rpy:5724
translate russian samantha_event_B04_cba43d2b:
    "Сложно понять, собирается ли она сообщить что-то ужасное."

# ch/samantha/events.rpy:5725
translate russian samantha_event_B04_f232a82d:
    "Я иду к дивану, решив, что ей захочется сесть."

# ch/samantha/events.rpy:5726
translate russian samantha_event_B04_07ead296:
    "Она остаётся у двери."

# ch/samantha/events.rpy:5727
translate russian samantha_event_B04_de2bc3bf:
    "Несколько долгих секунд я смотрю на неё."

# ch/samantha/events.rpy:5728
translate russian samantha_event_B04_21289106:
    samantha.say "Я... Эм."

# ch/samantha/events.rpy:5729
translate russian samantha_event_B04_b0e162f8:
    samantha.say "Я беременна."

# ch/samantha/events.rpy:5730
translate russian samantha_event_B04_a20cefa7_2:
    "..."

# ch/samantha/events.rpy:5731
translate russian samantha_event_B04_67aaa788:
    "Что?"

# ch/samantha/events.rpy:5732
translate russian samantha_event_B04_9fd4e90e:
    mike.say "А."

# ch/samantha/events.rpy:5733
translate russian samantha_event_B04_dda1b4e4:
    mike.say "Поздравляю."

# ch/samantha/events.rpy:5734
translate russian samantha_event_B04_10553ce2:
    "Слова вырываются раньше, чем я успеваю осмыслить услышанное."

# ch/samantha/events.rpy:5735
translate russian samantha_event_B04_ca47b517:
    "Её бесстрастное лицо даёт мне время наконец осознать услышанное."

# ch/samantha/events.rpy:5736
translate russian samantha_event_B04_9fd4e90e_1:
    mike.say "А."

# ch/samantha/events.rpy:5737
translate russian samantha_event_B04_d70e4d84:
    "Судя по её рассказам о Райане, они не слишком часто бывают близки."

# ch/samantha/events.rpy:5738
translate russian samantha_event_B04_5579403e:
    "Если подумать, мы даже не воспользовались презервативом."

# ch/samantha/events.rpy:5739
translate russian samantha_event_B04_562b50a9:
    mike.say "Думаешь, от меня?"

# ch/samantha/events.rpy:5740
translate russian samantha_event_B04_ddd7fece:
    samantha.say "Не знаю."

# ch/samantha/events.rpy:5741
translate russian samantha_event_B04_7e1e52b1:
    "Я делаю несколько шагов к ней."

# ch/samantha/events.rpy:5742
translate russian samantha_event_B04_b9d718a5:
    "Кажется, она хочет отступить, но за спиной стена."

# ch/samantha/events.rpy:5744
translate russian samantha_event_B04_4fdf2d55:
    mike.say "Кексик, я..."

# ch/samantha/events.rpy:5746
translate russian samantha_event_B04_4c679e24:
    mike.say "Сэм, я..."

# ch/samantha/events.rpy:5747
translate russian samantha_event_B04_fae0519b:
    "Что тут вообще скажешь?"

# ch/samantha/events.rpy:5748
translate russian samantha_event_B04_491d9c7e:
    "Я словно физически ощущаю, как мой мир рушится."

# ch/samantha/events.rpy:5749
translate russian samantha_event_B04_f401d819:
    "Я только что... разрушил брак Сэм?"

# ch/samantha/events.rpy:5750
translate russian samantha_event_B04_35f9a9db:
    "Или, хуже того, её жизнь?"

# ch/samantha/events.rpy:5751
translate russian samantha_event_B04_05a591a4:
    "Бесполезно думать в таком духе."

# ch/samantha/events.rpy:5752
translate russian samantha_event_B04_0f23950f:
    mike.say "Принесу тебе полотенце."

# ch/samantha/events.rpy:5754
translate russian samantha_event_B04_babd4770:
    "Не дав ей сказать что-нибудь ещё, спешу к бельевому шкафу и хватаю одно из самых пушистых полотенец."

# ch/samantha/events.rpy:5758
translate russian samantha_event_B04_9649373a:
    "Когда возвращаюсь, она всё ещё стоит на том же месте."

# ch/samantha/events.rpy:5759
translate russian samantha_event_B04_48f27b0c:
    "Протягиваю ей полотенце. Саманта молча берёт его и бездумно держит в руках."

# ch/samantha/events.rpy:5760
translate russian samantha_event_B04_55934954:
    mike.say "Что ты собираешься с этим делать?"

# ch/samantha/events.rpy:5762
translate russian samantha_event_B04_2ba427e6:
    samantha.say "Что?"

# ch/samantha/events.rpy:5763
translate russian samantha_event_B04_871188e8:
    mike.say "То есть... У тебя есть план?"

# ch/samantha/events.rpy:5765
translate russian samantha_event_B04_1739a449:
    samantha.say "Я только что прибежала сюда из своего грёбаного дома. Похоже, что у меня есть план?"

# ch/samantha/events.rpy:5766
translate russian samantha_event_B04_2b952f36:
    "Кажется, я никогда раньше не слышал, чтобы она ругалась."

# ch/samantha/events.rpy:5767
translate russian samantha_event_B04_632093a4:
    "Из её уст это звучит неправильно."

# ch/samantha/events.rpy:5769
translate russian samantha_event_B04_591891f1:
    mike.say "Мне так жаль, Кексик."

# ch/samantha/events.rpy:5771
translate russian samantha_event_B04_657dea04:
    mike.say "Мне так жаль, Сэм."

# ch/samantha/events.rpy:5773
translate russian samantha_event_B04_3517d4f2:
    samantha.say "Не хочу это слышать. Это... Я виновата не меньше. Я не могу лгать Райану. И не буду."

# ch/samantha/events.rpy:5775
translate russian samantha_event_B04_8fcbc6b9:
    samantha.say "Просто хочу знать... Если ребёнок действительно твой, ты будешь рядом? Или я останусь одна?"

# ch/samantha/events.rpy:5777
translate russian samantha_event_B04_3909ba22:
    mike.say "Кексик..."

# ch/samantha/events.rpy:5779
translate russian samantha_event_B04_7295c41f:
    mike.say "Сэм..."

# ch/samantha/events.rpy:5783
translate russian samantha_event_B04_eac0def3:
    mike.say "На каждом шагу, Кексик. Я бы тебя так не бросил."

# ch/samantha/events.rpy:5785
translate russian samantha_event_B04_479c4985:
    mike.say "На каждом шагу, Саманта. Я бы тебя так не бросил."

# ch/samantha/events.rpy:5788
translate russian samantha_event_B04_ba26325c:
    "Сэм кивает. С ресниц наконец срываются слёзы, смешиваясь с дождевой водой. Она бросается ко мне и обнимает."

# ch/samantha/events.rpy:5789
translate russian samantha_event_B04_4db5cfe2:
    samantha.say "Спасибо... Спасибо."

# ch/samantha/events.rpy:5790
translate russian samantha_event_B04_d20d8c9e:
    mike.say "Вот что сделаем, ладно? Запишем тебя на приём и составим настоящий план. А дальше будем решать по ситуации."

# ch/samantha/events.rpy:5792
translate russian samantha_event_B04_5050d89e:
    samantha.say "Хорошо."

# ch/samantha/events.rpy:5793
translate russian samantha_event_B04_93c0b683:
    mike.say "Ты... хочешь оставить ребёнка? С Райаном?"

# ch/samantha/events.rpy:5794
translate russian samantha_event_B04_a0a6f41f:
    samantha.say "Оставить? Это даже не обсуждается. Я не могу просто избавиться от него."

# ch/samantha/events.rpy:5795
translate russian samantha_event_B04_ed904577:
    samantha.say "Это не какой-то мусор, это человек. Хочет Райан ребёнка или нет, я его оставлю."

# ch/samantha/events.rpy:5796
translate russian samantha_event_B04_be9ea0eb:
    mike.say "Я... Ладно."

# ch/samantha/events.rpy:5798
translate russian samantha_event_B04_ba70516e:
    "В заднем кармане вибрирует телефон. Я быстро его выключаю."

# ch/samantha/events.rpy:5799
translate russian samantha_event_B04_5f3e74c5:
    mike.say "Хочешь побыть здесь? Тебе бы немного успокоиться. Чаю?"

# ch/samantha/events.rpy:5800
translate russian samantha_event_B04_e698dad7:
    samantha.say "..."

# ch/samantha/events.rpy:5801
translate russian samantha_event_B04_88e70c81:
    samantha.say "Давай."

# ch/samantha/events.rpy:5802
translate russian samantha_event_B04_198d373f:
    "Чем дольше мы разговариваем, тем тише становятся её всхлипы. Лицо Саманты напряжено: она старается не поддаться панике."

# ch/samantha/events.rpy:5803
translate russian samantha_event_B04_f988bcd1:
    mike.say "Не хочу, чтобы ты переживала из-за Райана, ладно? Возьму всё на себя. Скажем, что виноват я, а ты была не в себе."

# ch/samantha/events.rpy:5804
translate russian samantha_event_B04_8c878f57:
    samantha.say "Нет. Мне и так хватает чувства вины. Я должна рассказать Райану. И расскажу."

# ch/samantha/events.rpy:5805
translate russian samantha_event_B04_ed2e79de:
    mike.say "Хорошо. Если понадоблюсь, буду рядом."

# ch/samantha/events.rpy:5807
translate russian samantha_event_B04_d646bd07:
    samantha.say "Спасибо."

# ch/samantha/events.rpy:5809
translate russian samantha_event_B04_a4a32006:
    "Усаживаю Саманту на диван и иду заваривать ей чай."

# ch/samantha/events.rpy:5810
translate russian samantha_event_B04_89e9cbe0:
    "Насыпая сахар ложку за ложкой, стараюсь не накручивать себя. Да и вообще не думать."

# ch/samantha/events.rpy:5811
translate russian samantha_event_B04_9b54f047:
    "Если ребёнок не мой, то беспокоиться не о чем, кроме злости Райана."

# ch/samantha/events.rpy:5813
translate russian samantha_event_B04_fd4a7ff2:
    "Впрочем, у меня всё ещё есть на него компромат."

# ch/samantha/events.rpy:5814
translate russian samantha_event_B04_9ea3d2fd:
    "Предъявлю его — могу получить весьма некрасивый фингал, но... Ладно, я точно себя накручиваю."

# ch/samantha/events.rpy:5815
translate russian samantha_event_B04_eb778c0c:
    "Саманте нужен кто-то, на кого можно опереться. Если этим человеком должен стать я, пусть так."

# ch/samantha/events.rpy:5818
translate russian samantha_event_B04_f00afc7b:
    mike.say "Кексик... Что? Ни один из нас с этим не справится. Даже вы с Райаном."

# ch/samantha/events.rpy:5820
translate russian samantha_event_B04_89fa8644:
    mike.say "Сэм... Что? Ни один из нас с этим не справится. Даже вы с Райаном."

# ch/samantha/events.rpy:5821
translate russian samantha_event_B04_6397fc12:
    mike.say "Ты ещё учишься в университете, мне нужны соседки, чтобы платить за дом, а ты только что вышла замуж. Откуда возьмутся деньги?"

# ch/samantha/events.rpy:5822
translate russian samantha_event_B04_e698dad7_1:
    samantha.say "..."

# ch/samantha/events.rpy:5823
translate russian samantha_event_B04_ffbda2bd:
    mike.say "Думаю, тебе нужно решить это с Райаном. Вы пара. У вас есть родители, которые могут помочь. Мне лучше не вмешиваться."

# ch/samantha/events.rpy:5825
translate russian samantha_event_B04_64a395c7:
    samantha.say "Даже если он твой?"

# ch/samantha/events.rpy:5826
translate russian samantha_event_B04_371b8676:
    mike.say "..."

# ch/samantha/events.rpy:5827
translate russian samantha_event_B04_4ef4f8cb:
    mike.say "Я..."

# ch/samantha/events.rpy:5829
translate russian samantha_event_B04_58a426b1:
    samantha.say "Я поняла. Прощай, [lssb_samantha.hero_name()]."

# ch/samantha/events.rpy:5831
translate russian samantha_event_B04_1ca593b0:
    "Не успеваю её остановить, как она уже выбегает за дверь и мчится по улице. Я всё испортил, да?"

# ch/samantha/events.rpy:5845
translate russian samantha_event_C01_e3d69131:
    samantha.say "Привет, [lssb_samantha.hero_name()]!"

# ch/samantha/events.rpy:5846
translate russian samantha_event_C01_200eb25b:
    mike.say "Эй!"

# ch/samantha/events.rpy:5847
translate russian samantha_event_C01_19d28102:
    samantha.say "Как твой день?"

# ch/samantha/events.rpy:5848
translate russian samantha_event_C01_13398a98:
    mike.say "Нормально. А твой?"

# ch/samantha/events.rpy:5849
translate russian samantha_event_C01_d12fd236:
    samantha.say "Хорошо!"

# ch/samantha/events.rpy:5850
translate russian samantha_event_C01_d2a1be94:
    samantha.say "У меня к тебе ещё один вопрос."

# ch/samantha/events.rpy:5851
translate russian samantha_event_C01_93b2dcd5:
    mike.say "Спрашивай."

# ch/samantha/events.rpy:5852
translate russian samantha_event_C01_9d51f12c:
    samantha.say "Тебе нравится мой пирсинг?"

# ch/samantha/events.rpy:5856
translate russian samantha_event_C01_b4e9293c:
    mike.say "Я не против. Смотрится на тебе сексуально."

# ch/samantha/events.rpy:5857
translate russian samantha_event_C01_ad1f8cb1:
    samantha.say "Ух ты! Спасибо <3"

# ch/samantha/events.rpy:5860
translate russian samantha_event_C01_e8ba899d:
    mike.say "Не знаю. Тебе не очень подходит."

# ch/samantha/events.rpy:5861
translate russian samantha_event_C01_a660df3a:
    samantha.say "А. Ну ладно."

# ch/samantha/events.rpy:5862
translate russian samantha_event_C01_81dc5767:
    samantha.say "М-м..."

# ch/samantha/events.rpy:5863
translate russian samantha_event_C01_5858829a:
    samantha.say "Со сколькими девушками у тебя был секс?"

# ch/samantha/events.rpy:5864
translate russian samantha_event_C01_371b8676:
    mike.say "..."

# ch/samantha/events.rpy:5865
translate russian samantha_event_C01_afad014d:
    mike.say "Ого. И ты спрашиваешь в переписке?"

# ch/samantha/events.rpy:5866
translate russian samantha_event_C01_998c8284:
    samantha.say "Это важно!"

# ch/samantha/events.rpy:5867
translate russian samantha_event_C01_1c0d45e8:
    mike.say "Ну..."

# ch/samantha/events.rpy:5871
translate russian samantha_event_C01_52fbae86:
    mike.say "Точное число не назову. Слишком много, чтобы сосчитать."

# ch/samantha/events.rpy:5872
translate russian samantha_event_C01_8a0afb1c:
    samantha.say "О..."

# ch/samantha/events.rpy:5875
translate russian samantha_event_C01_b7127639:
    mike.say "С несколькими в разное время."

# ch/samantha/events.rpy:5876
translate russian samantha_event_C01_57292c09:
    samantha.say "А. С кем?"

# ch/samantha/events.rpy:5877
translate russian samantha_event_C01_7dfeb79c:
    mike.say "Нет."

# ch/samantha/events.rpy:5878
translate russian samantha_event_C01_338d1e07:
    samantha.say "Ладно. Прости."

# ch/samantha/events.rpy:5880
translate russian samantha_event_C01_5d2c7262:
    mike.say "Честно говоря, только с тобой."

# ch/samantha/events.rpy:5881
translate russian samantha_event_C01_e698dad7:
    samantha.say "..."

# ch/samantha/events.rpy:5882
translate russian samantha_event_C01_25290f68:
    samantha.say "Правда?"

# ch/samantha/events.rpy:5883
translate russian samantha_event_C01_64463886:
    samantha.say "Это... так мило, [lssb_samantha.hero_name()]!"

# ch/samantha/events.rpy:5885
translate russian samantha_event_C01_a0ef6add:
    samantha.say "Так."

# ch/samantha/events.rpy:5886
translate russian samantha_event_C01_9c46462a:
    samantha.say "Ты не против благовоний или свечей?"

# ch/samantha/events.rpy:5888
translate russian samantha_event_C01_2c6406d7:
    mike.say "Кексик?"

# ch/samantha/events.rpy:5890
translate russian samantha_event_C01_13a94265:
    mike.say "Сэм?"

# ch/samantha/events.rpy:5891
translate russian samantha_event_C01_6c6b1185:
    samantha.say "Да?"

# ch/samantha/events.rpy:5892
translate russian samantha_event_C01_39de0c35:
    mike.say "Почему ты всё это спрашиваешь?"

# ch/samantha/events.rpy:5893
translate russian samantha_event_C01_b4683440:
    samantha.say "Потому что мне нужно знать! Всем нам!"

# ch/samantha/events.rpy:5894
translate russian samantha_event_C01_cc0ded1c:
    mike.say "Что??"

# ch/samantha/events.rpy:5895
translate russian samantha_event_C01_d29bd552:
    samantha.say "У меня через несколько минут смена, поговорим позже."

# ch/samantha/events.rpy:5896
translate russian samantha_event_C01_10d6a650:
    "Но ты всё-таки ответь!"

# ch/samantha/events.rpy:5897
translate russian samantha_event_C01_a20cefa7:
    "..."

# ch/samantha/events.rpy:5898
translate russian samantha_event_C01_808e61e5:
    "Не понимаю, что это значит. Вопросы о моих... предпочтениях не прекращаются. Поначалу я спокойно отвечал."

# ch/samantha/events.rpy:5899
translate russian samantha_event_C01_0167d962:
    "Думал, ей просто любопытно. И уж точно не откажусь, если она хочет провести со мной ещё одну ночь."

# ch/samantha/events.rpy:5900
translate russian samantha_event_C01_0516c23f:
    "Но теперь вопросов слишком много. Может, зайти к ней после работы и выяснить, что всё это значит?"

# ch/samantha/events.rpy:5907
translate russian samantha_event_C02_18ca89c9:
    "В пекарне привычно пахнет корицей, сахаром и свежей выпечкой."

# ch/samantha/events.rpy:5908
translate russian samantha_event_C02_4995beb5:
    "Этот уютный запах встречает меня, когда я открываю стеклянные двери."

# ch/samantha/events.rpy:5909
translate russian samantha_event_C02_04b6a4f6:
    "За прилавком Саманты нет. Наверное, сегодня работает на кухне."

# ch/samantha/events.rpy:5910
translate russian samantha_event_C02_386cbd5e:
    "Смотрю время на телефоне: до конца её смены всего десять минут."

# ch/samantha/events.rpy:5911
translate russian samantha_event_C02_2b797ac6:
    "Можно подождать за столиком."

# ch/samantha/events.rpy:5912
translate russian samantha_event_C02_6366dcbd:
    "Прежде чем сесть у окна, заказываю маленькую чашку кофе."

# ch/samantha/events.rpy:5913
translate russian samantha_event_C02_fa6df5de:
    "Стул негромко скребёт по полу, когда я отодвигаю его и сажусь."

# ch/samantha/events.rpy:5914
translate russian samantha_event_C02_af1c58ab:
    "Остаётся только ждать."

# ch/samantha/events.rpy:5916
translate russian samantha_event_C02_53724c2c:
    ryan.say "Ты."

# ch/samantha/events.rpy:5917
translate russian samantha_event_C02_b0cd9110:
    "Поднимаю голову. Райан? Что он тут делает?"

# ch/samantha/events.rpy:5918
translate russian samantha_event_C02_83015a13:
    mike.say "Я?"

# ch/samantha/events.rpy:5919
translate russian samantha_event_C02_53724c2c_1:
    ryan.say "Ты."

# ch/samantha/events.rpy:5921
translate russian samantha_event_C02_247d3c7f:
    "Он отодвигает стул напротив и садится. Эм..."

# ch/samantha/events.rpy:5922
translate russian samantha_event_C02_fca96f3a:
    ryan.say "Ты вообще понимаешь, что делаешь?"

# ch/samantha/events.rpy:5923
translate russian samantha_event_C02_6030d0ba:
    "Я медленно моргаю. Пытаюсь вспомнить, что мог натворить за последнюю неделю."

# ch/samantha/events.rpy:5924
translate russian samantha_event_C02_1c2ec5b0:
    "Кроме того, что трахнул его жену. Хотя он сам напросился."

# ch/samantha/events.rpy:5925
translate russian samantha_event_C02_625c658a:
    mike.say "...Сижу?"

# ch/samantha/events.rpy:5926
translate russian samantha_event_C02_431b1dc2:
    "Кажется, ответ ему не нравится."

# ch/samantha/events.rpy:5927
translate russian samantha_event_C02_aee842c4:
    ryan.say "Нет. Ты серьёзно?"

# ch/samantha/events.rpy:5928
translate russian samantha_event_C02_c2c18767:
    mike.say "Объясни, пожалуйста."

# ch/samantha/events.rpy:5929
translate russian samantha_event_C02_bf8cc36f:
    "Он наклоняется ко мне, словно собирается сообщить секрет."

# ch/samantha/events.rpy:5931
translate russian samantha_event_C02_b0128951:
    ryan.say "Ты. Ты сказал Сэм, что секс втроём — хорошая идея."

# ch/samantha/events.rpy:5932
translate russian samantha_event_C02_94004a03:
    "А."

# ch/samantha/events.rpy:5933
translate russian samantha_event_C02_f6efbe02:
    mike.say "Она просила совета."

# ch/samantha/events.rpy:5934
translate russian samantha_event_C02_3e628b24:
    ryan.say "И ты советуешь ей такую хрень?!"

# ch/samantha/events.rpy:5935
translate russian samantha_event_C02_d4fddef8:
    mike.say "Чувак, это было просто предложение."

# ch/samantha/events.rpy:5936
translate russian samantha_event_C02_1e1b14c2:
    ryan.say "Теперь она вбила себе в голову, что это отличная идея!"

# ch/samantha/events.rpy:5937
translate russian samantha_event_C02_7bb1216b:
    mike.say "Именно ты хочешь сказать, что тебе не понравился бы секс втроём?"

# ch/samantha/events.rpy:5938
translate russian samantha_event_C02_4672fe87:
    ryan.say "С какого хрена ты взял, что я захочу делать это с..."

# ch/samantha/events.rpy:5940
translate russian samantha_event_C02_de34b925:
    samantha.say "Райан!"

# ch/samantha/events.rpy:5941
translate russian samantha_event_C02_c1de55cd:
    "У нашего столика появляется Сэм, всё ещё в фартуке и с мукой на щеках. Она замечает меня."

# ch/samantha/events.rpy:5942
translate russian samantha_event_C02_e6b7f498:
    samantha.say "[lssb_samantha.hero_name()]! Ты тоже здесь?"

# ch/samantha/events.rpy:5943
translate russian samantha_event_C02_c397cda1:
    mike.say "Ага... Хотел поговорить с тобой."

# ch/samantha/events.rpy:5944
translate russian samantha_event_C02_98797b70:
    samantha.say "О! Я тоже."

# ch/samantha/events.rpy:5945
translate russian samantha_event_C02_28756165:
    "Она сцепляет ладони и смотрит на меня, словно ждёт, когда я начну."

# ch/samantha/events.rpy:5946
translate russian samantha_event_C02_1772cd9c:
    mike.say "Эм..."

# ch/samantha/events.rpy:5947
translate russian samantha_event_C02_d4966fce:
    "При Райане этот разговор лучше не заводить."

# ch/samantha/events.rpy:5948
translate russian samantha_event_C02_99ce396a:
    mike.say "Может, пойдём куда-нибудь, где... поспокойнее?"

# ch/samantha/events.rpy:5949
translate russian samantha_event_C02_b213a57d:
    "Райан собирается что-то сказать, но Саманта его опережает."

# ch/samantha/events.rpy:5950
translate russian samantha_event_C02_f0d9aae1:
    samantha.say "Конечно! Давайте все поедем домой и там поговорим."

# ch/samantha/events.rpy:5951
translate russian samantha_event_C02_b30ec3f6:
    mike.say "Это немного..."

# ch/samantha/events.rpy:5953
translate russian samantha_event_C02_e18d99f9:
    ryan.say "Нет. Я согласен. Там кое-что проясним."

# ch/samantha/events.rpy:5954
translate russian samantha_event_C02_770d15f5:
    "Слова Райана удивляют меня. Теперь стало интересно."

# ch/samantha/events.rpy:5955
translate russian samantha_event_C02_e2c53a01:
    mike.say "...Ладно."

# ch/samantha/events.rpy:5956
translate russian samantha_event_C02_1e8abb8a:
    ryan.say "Хорошо."

# ch/samantha/events.rpy:5959
translate russian samantha_event_C02_e623184c:
    "Он встаёт с самодовольным выражением лица. Саманта улыбается мне и поднимается следом."

# ch/samantha/events.rpy:5960
translate russian samantha_event_C02_2387205b:
    samantha.say "Пойдём!"

# ch/samantha/events.rpy:5961
translate russian samantha_event_C02_a9f0498b:
    "Она берёт меня за руку и тянет вверх, задерживая прикосновение."

# ch/samantha/events.rpy:5963
translate russian samantha_event_C02_701c5a99:
    "Самодовольство на лице Райана сменяется злым взглядом."

# ch/samantha/events.rpy:5972
translate russian samantha_event_C02_0631688c:
    "Мы садимся в машину Райана, которая лучше моей, хотя я никогда этого не признаю, и быстро едем к ним домой."

# ch/samantha/events.rpy:5973
translate russian samantha_event_C02_b346bde4:
    "Обстановка настолько напряжённая, что хочется выскочить на ближайшем светофоре."

# ch/samantha/events.rpy:5974
translate russian samantha_event_C02_189d0862:
    "Сэм этого будто не замечает: что-то печатает в телефоне с довольной улыбкой."

# ch/samantha/events.rpy:5975
translate russian samantha_event_C02_25283eb9:
    "Мы останавливаемся на моей подъездной дорожке."

# ch/samantha/events.rpy:5976
translate russian samantha_event_C02_396697b8:
    "Райан глушит двигатель и сразу выходит."

# ch/samantha/events.rpy:5977
translate russian samantha_event_C02_701e1083:
    samantha.say "Пойдём!"

# ch/samantha/events.rpy:5978
translate russian samantha_event_C02_5f9421c3:
    "Я киваю. Начинаю нервничать, но всё-таки выхожу."

# ch/samantha/events.rpy:5983
translate russian samantha_event_C02_0a10f9d7:
    "Мы входим через парадную дверь и собираемся в гостиной."

# ch/samantha/events.rpy:5985
translate russian samantha_event_C02_87cb55b5:
    "Саманта указывает на диван."

# ch/samantha/events.rpy:5986
translate russian samantha_event_C02_a88cf9f3:
    "Я неохотно сажусь."

# ch/samantha/events.rpy:5987
translate russian samantha_event_C02_4a205333:
    "Райан устраивается напротив в кресле, а Сэм — рядом со мной на диване."

# ch/samantha/events.rpy:5988
translate russian samantha_event_C02_939550d8:
    samantha.say "Итак..."

# ch/samantha/events.rpy:5989
translate russian samantha_event_C02_17c7c37a:
    ryan.say "Ты идиот?"

# ch/samantha/events.rpy:5990
translate russian samantha_event_C02_aaeeed9d:
    "Я недоумённо моргаю."

# ch/samantha/events.rpy:5991
translate russian samantha_event_C02_d196b8aa:
    "Райан часто меня оскорбляет, но обычно хотя бы понятно за что."

# ch/samantha/events.rpy:5992
translate russian samantha_event_C02_93d66a7a:
    mike.say "Эм?.."

# ch/samantha/events.rpy:5993
translate russian samantha_event_C02_627119ae:
    "Я быстро перевожу взгляд с одного на другую."

# ch/samantha/events.rpy:5994
translate russian samantha_event_C02_cc903157:
    mike.say "Тебя настолько задела идея секса втроём?"

# ch/samantha/events.rpy:5995
translate russian samantha_event_C02_a92e3d6c:
    mike.say "Ты ведь мог не воспринимать это всерьёз..."

# ch/samantha/events.rpy:5997
translate russian samantha_event_C02_428cee05:
    ryan.say "С какого хрена мне не воспринимать это всерьёз?!"

# ch/samantha/events.rpy:5999
translate russian samantha_event_C02_7b30997a:
    samantha.say "Райан! Когда я предложила, чтобы [lssb_samantha.hero_name()] поговорил с нами, ты обещал выслушать каждого. Вот и слушай!"

# ch/samantha/events.rpy:6000
translate russian samantha_event_C02_40b61e53:
    "Райан сникает и откидывается в кресле."

# ch/samantha/events.rpy:6002
translate russian samantha_event_C02_e3a70d8a:
    ryan.say "Ладно. Как скажешь."

# ch/samantha/events.rpy:6003
translate russian samantha_event_C02_af8a045a:
    ryan.say "Просто хочу знать... Ты не шутишь? Правда этого хочешь? Потому что это не смешно."

# ch/samantha/events.rpy:6004
translate russian samantha_event_C02_94f3a050:
    "Мозг лихорадочно пытается сложить всё воедино. Что?"

# ch/samantha/events.rpy:6006
translate russian samantha_event_C02_33173990:
    "Саманта переплетает пальцы и кладёт руки на колени."

# ch/samantha/events.rpy:6007
translate russian samantha_event_C02_b491f0f0:
    samantha.say "Он был совершенно серьёзен! Я тоже удивилась, но это хорошая идея, Райан!"

# ch/samantha/events.rpy:6008
translate russian samantha_event_C02_94004a03_1:
    "А."

# ch/samantha/events.rpy:6009
translate russian samantha_event_C02_52189d59:
    mike.say "Подождите..."

# ch/samantha/events.rpy:6012
translate russian samantha_event_C02_7a0dbf74:
    "Я... не это имел в виду. Совсем не это. Но раз они действительно предлагают..."

# ch/samantha/events.rpy:6013
translate russian samantha_event_C02_27297c36:
    mike.say "Эм, да. Мне интересно."

# ch/samantha/events.rpy:6015
translate russian samantha_event_C02_9dbe6495:
    "Лицо Саманты смягчается."

# ch/samantha/events.rpy:6016
translate russian samantha_event_C02_9d403c27:
    samantha.say "Видишь! Я говорила, что он серьёзно."

# ch/samantha/events.rpy:6018
translate russian samantha_event_C02_821880af:
    ryan.say "..."

# ch/samantha/events.rpy:6019
translate russian samantha_event_C02_171fc7d9:
    ryan.say "Хорошо."

# ch/samantha/events.rpy:6020
translate russian samantha_event_C02_86c742dd:
    mike.say "Хорошо?"

# ch/samantha/events.rpy:6021
translate russian samantha_event_C02_29615659:
    ryan.say "Да какая разница. Только у Сэм есть правила."

# ch/samantha/events.rpy:6023
translate russian samantha_event_C02_32075849:
    samantha.say "Это не правила! Скорее... список вопросов."

# ch/samantha/events.rpy:6024
translate russian samantha_event_C02_ac960ed3:
    mike.say "Погоди. Так вот почему ты в последнее время обо всём этом спрашивала?"

# ch/samantha/events.rpy:6026
translate russian samantha_event_C02_ffa80961:
    "Саманта смущённо кивает."

# ch/samantha/events.rpy:6027
translate russian samantha_event_C02_b5408ca3:
    samantha.say "Прости. Я не очень понятно объяснила, да?"

# ch/samantha/events.rpy:6028
translate russian samantha_event_C02_a82b3b70:
    samantha.say "Но теперь, когда мы все согласны..."

# ch/samantha/events.rpy:6029
translate russian samantha_event_C02_dcea8fbc:
    "Сэм достаёт из сумочки распечатанный лист."

# ch/samantha/events.rpy:6030
translate russian samantha_event_C02_be006a2e:
    "Протягивает мне, и я осторожно беру его."

# ch/samantha/events.rpy:6031
translate russian samantha_event_C02_6c771781:
    "Быстро пробегаю глазами, и глаза расширяются."

# ch/samantha/events.rpy:6032
translate russian samantha_event_C02_1a12d423:
    "Здесь собраны почти все вопросы, которые она задавала в последние дни, а также другие, уже более медицинского характера."

# ch/samantha/events.rpy:6033
translate russian samantha_event_C02_44c1b308:
    "О прошлых партнёрах, инфекциях, передающихся половым путём..."

# ch/samantha/events.rpy:6034
translate russian samantha_event_C02_320d2a9f:
    samantha.say "Хочу, чтобы ты всё заполнил. Тогда мы с Райаном будем знать, как действовать!"

# ch/samantha/events.rpy:6035
translate russian samantha_event_C02_3ee92761:
    samantha.say "Когда заполнишь, мы сможем... выбрать время, когда все свободны."

# ch/samantha/events.rpy:6037
translate russian samantha_event_C02_cbe8b53a:
    "Я поднимаю взгляд от листа, и Саманта подмигивает. По спине пробегает дрожь. Похоже, мне задали домашку."

# ch/samantha/events.rpy:6040
translate russian samantha_event_C02_a2217a34:
    mike.say "Нет. Нет-нет. Я совсем не это имел в виду. Ни за что."

# ch/samantha/events.rpy:6042
translate russian samantha_event_C02_77a7d02a:
    "Глаза Сэм расширяются, а Райан снова хмурится, хотя в его взгляде появляется и доля самодовольства."

# ch/samantha/events.rpy:6043
translate russian samantha_event_C02_b09bd53c:
    mike.say "Я имел в виду... ну... с другой девушкой!"

# ch/samantha/events.rpy:6044
translate russian samantha_event_C02_e266fe41:
    samantha.say "Другой... девушкой?"

# ch/samantha/events.rpy:6045
translate russian samantha_event_C02_cd471d19:
    "Саманта явно не знает, как отнестись к этой мысли, словно ей такое и в голову не приходило. С искренним любопытством поворачивается к Райану."

# ch/samantha/events.rpy:6046
translate russian samantha_event_C02_c53c3ca2:
    samantha.say "Ты бы...?"

# ch/samantha/events.rpy:6047
translate russian samantha_event_C02_ba30c040:
    "Она умолкает, не зная, как спросить. Райан словно принимает это за вызов."

# ch/samantha/events.rpy:6049
translate russian samantha_event_C02_bc5f6459:
    ryan.say "Серьёзно?! Думаешь, мне нужна какая-то девушка, кроме Сэм?"

# ch/samantha/events.rpy:6050
translate russian samantha_event_C02_480cfbc3:
    ryan.say "Ты, похоже, совсем ничего не замечаешь, [lssb_samantha.hero_name()]."

# ch/samantha/events.rpy:6052
translate russian samantha_event_C02_3406180e:
    ryan.say "Спасибо, обойдёмся. Твои советы не нужны."

# ch/samantha/events.rpy:6053
translate russian samantha_event_C02_d3f5104e:
    mike.say "Погоди... Ты что?.."

# ch/samantha/events.rpy:6054
translate russian samantha_event_C02_4728da54:
    ryan.say "Думаю, тебе лучше уйти."

# ch/samantha/events.rpy:6055
translate russian samantha_event_C02_84d3f770:
    mike.say "Что?!"

# ch/samantha/events.rpy:6057
translate russian samantha_event_C02_c8d80d34:
    samantha.say "Райан! Он не хотел ничего плохого!"

# ch/samantha/events.rpy:6059
translate russian samantha_event_C02_fe0fc698:
    ryan.say "Мне всё равно, Сэм!"

# ch/samantha/events.rpy:6060
translate russian samantha_event_C02_502445f7:
    ryan.say "[lssb_samantha.hero_name()], вон!"

# ch/samantha/events.rpy:6061
translate russian samantha_event_C02_fc5ee515:
    "Повторного приглашения уйти мне не требуется. Я тут же встаю и направляюсь к двери."

# ch/samantha/events.rpy:6062
translate russian samantha_event_C02_7ae09390:
    mike.say "До встречи, Сэм."

# ch/samantha/events.rpy:6063
translate russian samantha_event_C02_e49c5b07:
    "Я бормочу это ей, но Райан всё равно слышит."

# ch/samantha/events.rpy:6064
translate russian samantha_event_C02_a77185dd:
    ryan.say "Нет уж, никаких встреч."

# ch/samantha/events.rpy:6065
translate russian samantha_event_C02_ae255fa0:
    ryan.say "Держись подальше от моей жены."

# ch/samantha/events.rpy:6066
translate russian samantha_event_C02_6f07bee3:
    "В груди кипят ответы, так и просятся наружу. Но я уже всё решил."

# ch/samantha/events.rpy:6071
translate russian samantha_event_C02_b1b030d4:
    "Хватаюсь за ручку и распахиваю дверь. Резко захлопываю её за собой, жалея, что не могу ударить ещё сильнее."

# ch/samantha/events.rpy:6072
translate russian samantha_event_C02_f47ca146:
    "Стоя на их крыльце, глубоко вдыхаю. Это было... неловко, мягко говоря."

# ch/samantha/events.rpy:6073
translate russian samantha_event_C02_cbc0e23c:
    "Сэм, похоже, поняла, что я имел в виду, но Райан ведёт себя как мудак."

# ch/samantha/events.rpy:6074
translate russian samantha_event_C02_0fe7dfc7:
    "Что ещё нового?"

# ch/samantha/events.rpy:6081
translate russian samantha_event_C03_7400a4b5:
    "Я неловко стою у входа, ожидая двух гостей."

# ch/samantha/events.rpy:6082
translate russian samantha_event_C03_8d37751a:
    "Уже не помню точную цепочку событий, приведших к этому моменту. Даже не вполне верю, что не сплю, но на всякий случай щиплю себя за руку, развеивая сомнения."

# ch/samantha/events.rpy:6083
translate russian samantha_event_C03_4fe7b4c9:
    "Время тянется странно медленно. Негромкое тиканье часов на заднем плане почти мучительно."

# ch/samantha/events.rpy:6084
translate russian samantha_event_C03_bd9deca9:
    "Тик. Так."

# ch/samantha/events.rpy:6085
translate russian samantha_event_C03_0979d98f:
    "На миг думаю снять их и вынуть батарейки ради собственного спокойствия, но понимаю: тогда просто стану каждые несколько секунд проверять телефон."

# ch/samantha/events.rpy:6086
translate russian samantha_event_C03_bd9deca9_1:
    "Тик. Так."

# ch/samantha/events.rpy:6087
translate russian samantha_event_C03_49528499:
    "Это не значит, что я не раздражён. Но в основном просто нервничаю. Вечер будет... очень, очень странный."

# ch/samantha/events.rpy:6088
translate russian samantha_event_C03_bd9deca9_2:
    "Тик. Так."

# ch/samantha/events.rpy:6089
translate russian samantha_event_C03_834953fc:
    "Они опаздывают? Уже не помню, она сказала в восемь пятнадцать или в восемь тридцать. Наверное, неважно, но..."

# ch/samantha/events.rpy:6091
translate russian samantha_event_C03_e96e7256:
    "Вместо привычного тиканья слышу кого-то у двери. Они успевают позвонить раньше, чем я открываю."

# ch/samantha/events.rpy:6097
translate russian samantha_event_C03_d7e19fbb:
    "На пороге стоят Райан и Саманта. Её палец всё ещё на звонке, и я сразу понимаю, как неловко выгляжу."

# ch/samantha/events.rpy:6098
translate russian samantha_event_C03_9823ef16:
    "Пытаюсь снять напряжение неуверенной улыбкой. Райан качает головой, а Саманта искренне улыбается в ответ, развеивая все тревоги."

# ch/samantha/events.rpy:6099
translate russian samantha_event_C03_d2915560:
    samantha.say "Вот и ты. Расслабься, [lssb_samantha.hero_name()], у тебя вид, будто нагрянула налоговая."

# ch/samantha/events.rpy:6100
translate russian samantha_event_C03_43ebeaa2:
    samantha.say "Я обещала нам троим сегодня маленькое удовольствие. А обещания я держу."

# ch/samantha/events.rpy:6101
translate russian samantha_event_C03_fcfd7059:
    "Райан бурчит, что пора бы начинать, но Саманта лишь закатывает глаза, глядя на меня. Этот безмолвный обмен словно оставляет нас вдвоём."

# ch/samantha/events.rpy:6102
translate russian samantha_event_C03_26fac808:
    "Они быстро входят, и Райан ведёт нас в мою спальню раньше, чем я успеваю предложить что-то другое. Ему либо не терпится начать, либо хочется поскорее закончить."

# ch/samantha/events.rpy:6107
translate russian samantha_event_C03_0b4b5988:
    "Саманта просто идёт следом, охотно подчиняясь. Я не хочу затевать спор именно сейчас и тоже иду."

# ch/samantha/events.rpy:6108
translate russian samantha_event_C03_5d89dccc:
    "Оказавшись у моей кровати, мы некоторое время молчим. Все прекрасно понимают, к чему всё идёт, но никто не знает, как начать."

# ch/samantha/events.rpy:6109
translate russian samantha_event_C03_34c86848:
    samantha.say "Ну, кто-то должен сдвинуть дело с места."

# ch/samantha/events.rpy:6115
translate russian samantha_event_C03_f237b12b:
    "Не желая уступать Райану и уже не в силах противиться притяжению губ Саманты, я шагаю вперёд и быстро притягиваю её для поцелуя."

# ch/samantha/events.rpy:6116
translate russian samantha_event_C03_a4fd3e2a:
    "Прижимаю её к себе, позволяя груди прильнуть к моей. Даже сквозь одежду чувствую исходящий от неё жар."

# ch/samantha/events.rpy:6117
translate russian samantha_event_C03_7be44f6e:
    "Она ахает, но быстро отвечает на ласку. Райан остаётся забытым третьим лишним, что меня очень радует."

# ch/samantha/events.rpy:6118
translate russian samantha_event_C03_1485ba09:
    "Пусть смотрит, как я ласкаю его женщину. Руки крепко обхватывают её талию, затем спускаются к попке и сжимают её через одежду."

# ch/samantha/events.rpy:6119
translate russian samantha_event_C03_14cb8477:
    "Я мну её пышные формы, подталкивая всё ближе к кровати. Райану остаётся только смотреть."

# ch/samantha/events.rpy:6120
translate russian samantha_event_C03_cb5bce11:
    "Вскоре мы с глухим шлепком падаем на постель, почти не размыкая объятий. Отстраняемся лишь затем, чтобы я мог стянуть футболку через голову."

# ch/samantha/events.rpy:6121
translate russian samantha_event_C03_2fcbef3f:
    "Краем глаза вижу, как Райан подходит и, повторяя мои действия, целует Саманту. Она отвечает страстно, но вскоре снова обращает внимание на меня: я начинаю её раздевать."

# ch/samantha/events.rpy:6122
translate russian samantha_event_C03_ed96e8f7:
    samantha.say "М-м. У тебя вкус неприятностей, [lssb_samantha.hero_name()]. Мой любимый."

# ch/samantha/events.rpy:6124
translate russian samantha_event_C03_0e204856:
    "Первым исчезает верх. Её пышную грудь прикрывает только бюстгальтер, но я быстро исправляю это, оставляя твёрдые соски на прохладном воздухе."

# ch/samantha/events.rpy:6125
translate russian samantha_event_C03_cf7baaa3:
    "Губы медленно скользят от шеи к груди и ниже, пока я быстро снимаю остальную одежду. В ответ она вскрикивает, вздрагивает и стонет."

# ch/samantha/events.rpy:6126
translate russian samantha_event_C03_dbe67107:
    "Я не спеша исследую её тело, смакую каждое прикосновение, обвожу языком соски. Вскоре она уже мокрая и изнывает от желания."

# ch/samantha/events.rpy:6127
translate russian samantha_event_C03_9ae2dd1f:
    samantha.say "Осторожнее. Будешь так лизать — забуду, что мы привели надзирателя."

# ch/samantha/events.rpy:6128
translate russian samantha_event_C03_426e7de9:
    "Она говорит достаточно громко, чтобы Райан услышал. Я чувствую её улыбку у своего виска."

# ch/samantha/events.rpy:6129
translate russian samantha_event_C03_66853014:
    "Я ложусь на спину и позволяю ей ответить на ласки. Пальцы немного возятся с ремнём, но вскоре брюки быстро сползают с меня."

# ch/samantha/events.rpy:6130
translate russian samantha_event_C03_5ed6c082:
    "Её твёрдые соски дразняще скользят по моей голой груди, вызывая дрожь. Наконец член освобождается из джинсового плена."

# ch/samantha/events.rpy:6131
translate russian samantha_event_C03_92ba2765:
    "По одному блеску в глазах Саманты понятно, что она не ожидала такого размера. А её вздох, когда член оказывается прямо перед лицом, только подтверждает это."

# ch/samantha/events.rpy:6132
translate russian samantha_event_C03_c43054d2:
    samantha.say "Ого. Кто-то хорошо кушал. Райан, бери пример."

# ch/samantha/events.rpy:6133
translate russian samantha_event_C03_3b1b3163:
    "Она одаривает меня лукавой усмешкой. В этот миг решаю: такая Саманта мне очень нравится."

# ch/samantha/events.rpy:6134
translate russian samantha_event_C03_7ad268bb:
    "Смотрю на Райана: он тоже разделся. Вид стонущей и извивающейся Саманты, пусть и от моих прикосновений, привёл и его в полную готовность."

# ch/samantha/events.rpy:6135
translate russian samantha_event_C03_2e54a3ca:
    "Ищу подсказку у Саманты, но она быстро переводит взгляд с одного на другого. Почти вижу, как в её голове крутятся шестерёнки, выбирая позу для нас троих."

# ch/samantha/events.rpy:6136
translate russian samantha_event_C03_161e802e:
    "Наконец она решается: подзывает Райана ближе, а сама садится на меня верхом, располагая попку над моими бёдрами."

# ch/samantha/events.rpy:6137
translate russian samantha_event_C03_23f81e61:
    "Я откидываюсь и жду. Член подрагивает на воздухе от предвкушения."

# ch/samantha/events.rpy:6138
translate russian samantha_event_C03_8357e90d:
    "Несложно понять, почему она выбрала сесть на меня, а не на Райана. Мой член заметно больше, и с самого прихода я уделяю ей куда больше внимания."

# ch/samantha/events.rpy:6139
translate russian samantha_event_C03_4b0346be:
    samantha.say "Так. [lssb_samantha.hero_name()], ты снизу. Райан, тебе достанется мой рот, если успеешь."

# ch/samantha/events.rpy:6140
translate russian samantha_event_C03_fc687a42:
    "Она говорит это так мило, что Райан будто не замечает: ему только что выдали утешительный приз."

# ch/samantha/events.rpy:6141
translate russian samantha_event_C03_f7338c52:
    samantha.say "Каждый получит свою порцию. Так ведь справедливо?"

# ch/samantha/events.rpy:6143
translate russian samantha_event_C03_545072e6:
    "Я вздрагиваю, когда её киска слегка касается члена, и усмехаюсь, заметив её ответную дрожь. Райан торопливо подходит сбоку и неуклюже суёт член к её лицу."

# ch/samantha/events.rpy:6144
translate russian samantha_event_C03_95471ed6:
    "Несколько секунд Саманта почти не обращает на него внимания. Собирается с силами, смотрит на меня сверху и улыбается."

# ch/samantha/events.rpy:6145
translate russian samantha_event_C03_878f9b98:
    "Она медленно опускает бёдра. Несколько мучительных мгновений член давит на тесный вход, затем она поддаётся, впуская меня, и влажные стенки тут же крепко сжимают его."

# ch/samantha/events.rpy:6147
translate russian samantha_event_C03_924b22c6:
    "Мы оба ахаем. Несколько секунд привыкаю к ощущениям: сокам, стекающим по члену, горячим стенкам, сжимающим его. Затем начинаю толкаться, заставляя Саманту подниматься и опускаться."

# ch/samantha/events.rpy:6148
translate russian samantha_event_C03_c7caa5a6:
    samantha.say "Ох... Вот он. Именно о нём я всю неделю думала, [lssb_samantha.hero_name()]."

# ch/samantha/events.rpy:6149
translate russian samantha_event_C03_83eac7d5:
    "Она так и делает: её попка поднимается и опускается, а грудь подпрыгивает, радуя глаз."

# ch/samantha/events.rpy:6150
translate russian samantha_event_C03_2ba41398:
    samantha.say "Не дуйся, Райан. Открывай пошире."

# ch/samantha/events.rpy:6152
translate russian samantha_event_C03_24c98d16:
    "С этими словами она наклоняется и берёт член Райана в рот, быстро опускаясь до самого основания и касаясь носом его паха."

# ch/samantha/events.rpy:6153
translate russian samantha_event_C03_2c866d65:
    "Но я больше сосредоточен на том, как её попка шлёпается о мои ноги. Если правильно податься бёдрами вперёд, можно заставить её взвизгнуть от наслаждения уже сейчас, хотя мы только начали."

# ch/samantha/events.rpy:6154
translate russian samantha_event_C03_d9c13525:
    "Саманта уже явно наслаждается, а я намерен доставить ей удовольствие. Обхватив за талию, постепенно ускоряюсь."

# ch/samantha/events.rpy:6155
translate russian samantha_event_C03_d60dba05:
    "Она стонет и захлёбывается вокруг члена Райана, пока я умело ласкаю её. Колени уже дрожат и слабеют от моих усилий."

# ch/samantha/events.rpy:6156
translate russian samantha_event_C03_dd86ce2b:
    "Я стону, начиная теряться в море наслаждения, в которое Саманта уже погрузилась. С каждым толчком член скользит всё легче."

# ch/samantha/events.rpy:6157
translate russian samantha_event_C03_43f699e4:
    "Чувствую, как её киска подстраивается под форму и размер моего члена, всё лучше обхватывая его."

# ch/samantha/events.rpy:6158
translate russian samantha_event_C03_71a919b1:
    "Мягкая плоть поддаётся пальцам, пока я играю с её попкой, пару раз шутливо шлёпнув, не прекращая толчков."

# ch/samantha/events.rpy:6159
translate russian samantha_event_C03_cc6d017f:
    "От ударов по телу расходятся волны, колыхая округлости в нужных местах."

# ch/samantha/events.rpy:6160
translate russian samantha_event_C03_d2a38c17:
    "Другой рукой беру её за грудь и снова начинаю мять и ласкать, выкручивая и оттягивая соски так, чтобы она стонала с членом Райана во рту."

# ch/samantha/events.rpy:6162
translate russian samantha_event_C03_ee61b819:
    "Из-за моих ласк ей явно трудно сосредоточиться на минете. Это доставляет мне какое-то извращённое удовольствие."

# ch/samantha/events.rpy:6163
translate russian samantha_event_C03_1be6fe7f:
    "Я решаю отвлечь её как можно сильнее."

# ch/samantha/events.rpy:6164
translate russian samantha_event_C03_bf02fc27:
    "Заставить визжать, стонать, хныкать — что угодно, лишь бы остановить язык, который, несомненно, умело обслуживает жалкий член Райана."

# ch/samantha/events.rpy:6165
translate russian samantha_event_C03_1fd2bee2:
    "Её мокрая киска становится мишенью моего натиска: я яростно толкаюсь под разными углами, меняю темп и нахожу места, от которых она дрожит и кричит."

# ch/samantha/events.rpy:6166
translate russian samantha_event_C03_e4228e9d:
    "Вскоре Саманта полностью поддаётся мне. Её киска сжимается и пульсирует вокруг члена, а всё внимание обращено ко мне, не к мужу."

# ch/samantha/events.rpy:6167
translate russian samantha_event_C03_f7c7408e:
    "Он продолжает жалко толкаться ей в рот, но Саманта уже явно обслуживает его без прежней страсти. Вместо этого старается сильнее опускаться на меня, принимая всё глубже."

# ch/samantha/events.rpy:6168
translate russian samantha_event_C03_f1b22ce0:
    "Она выпускает его с влажным чмоканьем, больше даже не притворяясь, что делит внимание между нами."

# ch/samantha/events.rpy:6169
translate russian samantha_event_C03_0c17b183:
    samantha.say "Е-ещё... [lssb_samantha.hero_name()], пожалуйста, быстрее."

# ch/samantha/events.rpy:6170
translate russian samantha_event_C03_b93deab4:
    "И всё же Райан кончает первым, выплёскивая немного спермы ей в горло, затем отступает, оставляя нас вдвоём."

# ch/samantha/events.rpy:6171
translate russian samantha_event_C03_3591a64c:
    "Не знаю, замечает ли Саманта его отсутствие. Теперь ничто не заглушает её крики, и они звучат по комнате ещё громче."

# ch/samantha/events.rpy:6172
translate russian samantha_event_C03_af4396d6:
    samantha.say "Это всё? Я едва распробовала."

# ch/samantha/events.rpy:6173
translate russian samantha_event_C03_f2b20798:
    samantha.say "Хорошо. Теперь только мы. Не останавливайся, [lssb_samantha.hero_name()], хочу всю порцию."

# ch/samantha/events.rpy:6174
translate russian samantha_event_C03_2d7cfc09:
    "В её глазах теперь тот самый огонь, который появляется, когда она решает больше не быть вежливой. Райан уже на заднем плане."

# ch/samantha/events.rpy:6175
translate russian samantha_event_C03_5de8549e:
    "Мы ещё немного продолжаем это безумное, страстное занятие любовью. Но оба отдаёмся ему целиком, совсем не сдерживаясь, так что оргазм — лишь вопрос времени."

# ch/samantha/events.rpy:6176
translate russian samantha_event_C03_3acc0dfc:
    samantha.say "Да... Наполни меня, [lssb_samantha.hero_name()], отдай всё до последней капли!"

# ch/samantha/events.rpy:6178
translate russian samantha_event_C03_b28cdce4:
    "Он накрывает быстро и мощно. Перед глазами белеет, пока я изливаю в неё густую липкую сперму, окончательно помечая своей."

# ch/samantha/events.rpy:6179
translate russian samantha_event_C03_dce18e35:
    "Чувствую, как её тело напрягается и содрогается. С последним криком она тоже достигает разрядки."

# ch/samantha/events.rpy:6180
translate russian samantha_event_C03_53ce982b:
    "Мой член пульсирует, а её киска сжимается, выжимая последние капли. Оргазм такой сильный, что я едва не теряю сознание."

# ch/samantha/events.rpy:6181
translate russian samantha_event_C03_0c66a340:
    "Но рано или поздно всё хорошее заканчивается. Саманта падает на меня, и мы лежим, тяжело дыша в объятиях друг друга."

# ch/samantha/events.rpy:6182
translate russian samantha_event_C03_6a248241:
    samantha.say "М-м. Вот это я понимаю — начинка."

# ch/samantha/events.rpy:6183
translate russian samantha_event_C03_f6fdccd4:
    samantha.say "Лучшая моя идея с тех пор, как я начала добавлять морскую соль в карамель."

# ch/samantha/events.rpy:6184
translate russian samantha_event_C03_c40a9a48:
    "Она хихикает у меня на груди, тёплая и довольная собой. Ради этого звука стоила того каждая секунда странного дня."

# ch/samantha/events.rpy:6185
translate russian samantha_event_C03_8fe6bf00:
    "Я почти забываю о Райане. Наконец, придя в себя, Саманта приподнимается и улыбается ему, рассказывая, какой замечательной была идея и как ей понравилось."

# ch/samantha/events.rpy:6186
translate russian samantha_event_C03_94b4eb23:
    "Я усмехаюсь ему за её спиной и самодовольно подмигиваю, прежде чем он успевает отвернуться. Вскоре они уходят, оставляя меня наслаждаться своим торжеством."

# ch/samantha/events.rpy:6199
translate russian samantha_event_D01_ced4bdee:
    "Кажется, впервые за целую вечность у меня выдался день без дел, полностью для себя."

# ch/samantha/events.rpy:6200
translate russian samantha_event_D01_d7eaddd4:
    "Как ни странно, ради такого дня обычно приходится здорово постараться и всё заранее спланировать!"

# ch/samantha/events.rpy:6201
translate russian samantha_event_D01_5dd9ccc0:
    "Работа, две колоритные соседки и насыщенная личная жизнь почти всё время держат меня занятым."

# ch/samantha/events.rpy:6202
translate russian samantha_event_D01_c38ebe36:
    "Но сегодня рабочие дела закончены, а [bree.name] и Саша на пару часов ушли из дома."

# ch/samantha/events.rpy:6203
translate russian samantha_event_D01_bf53baff:
    "Так что можно просто развалиться на диване и не смотреть на то, что показывают по телевизору."

# ch/samantha/events.rpy:6204
translate russian samantha_event_D01_f992a7a3:
    "В этом я чертовски хорош. Вскоре уже совершенно не понимаю, что вообще смотрю!"

# ch/samantha/events.rpy:6206
translate russian samantha_event_D01_06ea170c:
    "Наверное, поэтому мне нужно добрых пару минут, чтобы осознать: дверной звонок раздаётся не из телевизора."

# ch/samantha/events.rpy:6207
translate russian samantha_event_D01_4b86127a:
    "Сажусь и трясу головой, пытаясь вернуться к реальности."

# ch/samantha/events.rpy:6208
translate russian samantha_event_D01_d8134a02:
    "Затем стаскиваю себя с дивана и недовольно плетусь к входной двери."

# ch/samantha/events.rpy:6213
translate russian samantha_event_D01_afaf51e0:
    "Но стоит её открыть, как со мной происходит чудесное преображение."

# ch/samantha/events.rpy:6214
translate russian samantha_event_D01_a73cb0d8:
    "Вдруг я бодрее, чем за весь день: спина выпрямляется, тело наполняется энергией."

# ch/samantha/events.rpy:6215
translate russian samantha_event_D01_9ed8b970:
    "В том, что так резко меняет настроение и пробуждает меня из полудрёмы, нет никакой тайны."

# ch/samantha/events.rpy:6216
translate russian samantha_event_D01_6e700ff9:
    "Всё дело исключительно в том, кого я вижу на пороге."

# ch/samantha/events.rpy:6218
translate russian samantha_event_D01_e3d69131:
    samantha.say "Привет, [lssb_samantha.hero_name()]!"

# ch/samantha/events.rpy:6220
translate russian samantha_event_D01_30db09a5:
    mike.say "А... Привет, Кексик."

# ch/samantha/events.rpy:6222
translate russian samantha_event_D01_a42c3fa1:
    mike.say "А... Привет, Сэм."

# ch/samantha/events.rpy:6223
translate russian samantha_event_D01_224bc51f:
    samantha.say "Прости, что вот так нагрянула!"

# ch/samantha/events.rpy:6224
translate russian samantha_event_D01_4c6ba9ad:
    samantha.say "Проходила мимо и решила узнать, дома ли ты..."

# ch/samantha/events.rpy:6225
translate russian samantha_event_D01_14cbdc3f:
    "От этого объяснения у меня в голове сразу звенит тревожный звоночек."

# ch/samantha/events.rpy:6226
translate russian samantha_event_D01_edbdd23a:
    "Новый дом Сэм и Райана находится на другом конце города."

# ch/samantha/events.rpy:6227
translate russian samantha_event_D01_2d515a07:
    "А я живу слишком далеко в пригороде, чтобы у неё здесь были какие-то дела."

# ch/samantha/events.rpy:6228
translate russian samantha_event_D01_3f733ea1:
    "Но, несмотря на подозрения, я всё равно безмерно рад её видеть."

# ch/samantha/events.rpy:6229
translate russian samantha_event_D01_3313a2f9:
    "Так что отбрасываю остальные мысли и поспешно отступаю, приглашая её в прихожую."

# ch/samantha/events.rpy:6231
translate russian samantha_event_D01_0883d68b:
    mike.say "Конечно... Конечно, Кексик."

# ch/samantha/events.rpy:6233
translate russian samantha_event_D01_0f4b9f33:
    mike.say "Конечно... Конечно, Сэм."

# ch/samantha/events.rpy:6234
translate russian samantha_event_D01_74e65121:
    mike.say "Я дома... Как видишь!"

# ch/samantha/events.rpy:6235
translate russian samantha_event_D01_3ac358c8:
    mike.say "Тебе тоже стоит зайти..."

# ch/samantha/events.rpy:6236
translate russian samantha_event_D01_ecc8ab43:
    mike.say "То есть заходи!"

# ch/samantha/events.rpy:6240
translate russian samantha_event_D01_70f7a4ba:
    "Сэм улыбается моей косноязычности и входит. Я закрываю за ней дверь."

# ch/samantha/events.rpy:6241
translate russian samantha_event_D01_3ac8b707:
    samantha.say "Надеюсь, я не помешала?"

# ch/samantha/events.rpy:6242
translate russian samantha_event_D01_b656d4f4:
    samantha.say "Могу ведь прийти в другой раз..."

# ch/samantha/events.rpy:6243
translate russian samantha_event_D01_73014f9d:
    mike.say "Нет... Нет, всё нормально."

# ch/samantha/events.rpy:6244
translate russian samantha_event_D01_03b3b27b:
    mike.say "Просто немного отдыхал."

# ch/samantha/events.rpy:6245
translate russian samantha_event_D01_bbc3580e:
    mike.say "Но от компании не откажусь."

# ch/samantha/events.rpy:6246
translate russian samantha_event_D01_4e57dc93:
    "Я провожу её в гостиную, хотя это всё ещё немного странно."

# ch/samantha/events.rpy:6247
translate russian samantha_event_D01_8e18eb2d:
    "Ведь не так уж давно она с Райаном жила здесь вместе со мной."

# ch/samantha/events.rpy:6248
translate russian samantha_event_D01_3cb3017a:
    "Мы стоим посреди комнаты: достаточно близко для друзей и достаточно далеко, чтобы всё оставалось платоническим."

# ch/samantha/events.rpy:6249
translate russian samantha_event_D01_fc58f3f7:
    "Она оглядывает обстановку, задерживаясь на вещах, которые изменились после её отъезда."

# ch/samantha/events.rpy:6250
translate russian samantha_event_D01_907f16df:
    samantha.say "Смотрю, после нашего переезда вы тут мало что поменяли."

# ch/samantha/events.rpy:6251
translate russian samantha_event_D01_26ca2758:
    mike.say "Да, особо ничего."

# ch/samantha/events.rpy:6252
translate russian samantha_event_D01_184066d8:
    mike.say "Мы — это [bree.name], Саша и я..."

# ch/samantha/events.rpy:6253
translate russian samantha_event_D01_64f56f52:
    "При упоминании новых соседок Сэм слегка поднимает брови."

# ch/samantha/events.rpy:6254
translate russian samantha_event_D01_21fdad7c:
    samantha.say "Как тебе живётся с двумя девушками?"

# ch/samantha/events.rpy:6256
translate russian samantha_event_D01_0d45bee4:
    samantha.say "Наверное, для большинства парней это сбывшаяся мечта!"

# ch/samantha/events.rpy:6257
translate russian samantha_event_D01_57c949ab:
    "Она спрашивает шутливо, но я чувствую за вопросом нечто большее."

# ch/samantha/events.rpy:6259
translate russian samantha_event_D01_e8869e2f:
    "Сэм прекрасно знает, что я к ней неравнодушен."

# ch/samantha/events.rpy:6260
translate russian samantha_event_D01_75999f76:
    "И я точно понимаю: упоминая имена [bree.name] и Саши, она пытается выяснить, что я чувствую к ним."

# ch/samantha/events.rpy:6261
translate russian samantha_event_D01_c35e9a3b:
    mike.say "Ну, большинству парней не приходится мириться с их неряшливостью и грязным бельём по всему дому!"

# ch/samantha/events.rpy:6263
translate russian samantha_event_D01_ba546ab4:
    samantha.say "Да брось, [lssb_samantha.hero_name()]!"

# ch/samantha/events.rpy:6265
translate russian samantha_event_D01_d09d76ed:
    mike.say "Я же не говорю, что они не симпатичные."

# ch/samantha/events.rpy:6266
translate russian samantha_event_D01_9f147858:
    mike.say "Но когда живёшь с человеком, узнаёшь его ОЧЕНЬ хорошо!"

# ch/samantha/events.rpy:6268
translate russian samantha_event_D01_dde21cf1:
    "Сэм склоняет голову набок с вопросительным выражением лица."

# ch/samantha/events.rpy:6269
translate russian samantha_event_D01_4537f139:
    samantha.say "Вот как?"

# ch/samantha/events.rpy:6270
translate russian samantha_event_D01_20379dd7:
    samantha.say "Может, спросить, что же ты узнал обо мне?"

# ch/samantha/events.rpy:6272
translate russian samantha_event_D01_e1ff84f5:
    mike.say "Иногда всё наоборот, Кексик."

# ch/samantha/events.rpy:6274
translate russian samantha_event_D01_4af86d5c:
    mike.say "Иногда всё наоборот, Сэм."

# ch/samantha/events.rpy:6275
translate russian samantha_event_D01_f0b540eb:
    mike.say "Иногда так и не узнаёшь девушку настолько близко, насколько хотелось бы..."

# ch/samantha/events.rpy:6277
translate russian samantha_event_D01_7ac34e0a:
    "Сэм на мгновение задерживает мой взгляд, затем отворачивается."

# ch/samantha/events.rpy:6279
translate russian samantha_event_D01_5d4db09c:
    samantha.say "Да..."

# ch/samantha/events.rpy:6280
translate russian samantha_event_D01_612c8b06:
    samantha.say "Насчёт этого..."

# ch/samantha/events.rpy:6282
translate russian samantha_event_D01_d2bfe452:
    "Сэм глубоко вдыхает, прежде чем снова посмотреть на меня."

# ch/samantha/events.rpy:6283
translate russian samantha_event_D01_407c4138:
    samantha.say "Пора признаться: я не совсем случайно проходила мимо."

# ch/samantha/events.rpy:6284
translate russian samantha_event_D01_9cf1e494:
    samantha.say "Хотела поговорить с тобой... о том, что ты рассказал."

# ch/samantha/events.rpy:6285
translate russian samantha_event_D01_7fa03db6:
    "Я глубоко вдыхаю, на секунду задерживаю воздух и выдыхаю разом."

# ch/samantha/events.rpy:6287
translate russian samantha_event_D01_ac2f7a6c:
    mike.say "Хорошо, Кексик."

# ch/samantha/events.rpy:6289
translate russian samantha_event_D01_bcfc370b:
    mike.say "Хорошо, Сэм."

# ch/samantha/events.rpy:6290
translate russian samantha_event_D01_fb1bff17:
    mike.say "Давай поговорим."

# ch/samantha/events.rpy:6291
translate russian samantha_event_D01_3a82e63a:
    "Сэм открывает рот, но её прерывают раньше, чем она успевает произнести хоть слово."

# ch/samantha/events.rpy:6293
translate russian samantha_event_D01_c0226a63:
    "Разговор перебивает вибрация её телефона."

# ch/samantha/events.rpy:6294
translate russian samantha_event_D01_9e401156:
    "Она машинально опускает взгляд на экран в ладони."

# ch/samantha/events.rpy:6296
translate russian samantha_event_D01_4620b544:
    samantha.say "Чёрт... Это ОН!"

# ch/samantha/events.rpy:6297
translate russian samantha_event_D01_fedae46c:
    samantha.say "Прости, нужно ответить, иначе что-нибудь заподозрит."

# ch/samantha/events.rpy:6299
translate russian samantha_event_D01_6cf36d45:
    "Мне не нужно видеть экран, чтобы понять: звонит Райан."

# ch/samantha/events.rpy:6301
translate russian samantha_event_D01_5541ee1e:
    samantha.say "Привет, милый. Что такое?"

# ch/samantha/events.rpy:6302
translate russian samantha_event_D01_17edf71b:
    samantha.say "Где я?"

# ch/samantha/events.rpy:6303
translate russian samantha_event_D01_f679ae38:
    "Произнося это, Сэм смотрит на меня и явно обдумывает ответ."

# ch/samantha/events.rpy:6304
translate russian samantha_event_D01_337e9738:
    samantha.say "Да вот, [lssb_samantha.hero_name()] дома, я заглянула в гости."

# ch/samantha/events.rpy:6305
translate russian samantha_event_D01_13262ee2:
    "Я начинаю мотать головой и махать руками, умоляя Сэм не впутывать меня."

# ch/samantha/events.rpy:6306
translate russian samantha_event_D01_0b88875e:
    samantha.say "Потому что проходила мимо. Вот почему."

# ch/samantha/events.rpy:6307
translate russian samantha_event_D01_dfbedcdf:
    samantha.say "Не знаю..."

# ch/samantha/events.rpy:6308
translate russian samantha_event_D01_eb4616e1:
    samantha.say "Наверное, захотелось в последний раз взглянуть на дом, вспомнить прежние времена."

# ch/samantha/events.rpy:6309
translate russian samantha_event_D01_fa3aeb9b:
    "На несколько секунд она умолкает, то кивая, то качая головой."

# ch/samantha/events.rpy:6310
translate russian samantha_event_D01_ab0052c2:
    "Сэм закатывает глаза, глядя на меня: Райан явно снова о чём-то нудит."

# ch/samantha/events.rpy:6311
translate russian samantha_event_D01_2599a1b2:
    "Но затем хмурится и беззвучно произносит впечатляющую тираду ругательств."

# ch/samantha/events.rpy:6312
translate russian samantha_event_D01_7529b0e5:
    "Прикрыв телефон рукой, она протягивает его мне."

# ch/samantha/events.rpy:6313
translate russian samantha_event_D01_13039230:
    samantha.say "Он хочет поговорить с тобой!"

# ch/samantha/events.rpy:6314
translate russian samantha_event_D01_b6791e42:
    mike.say "ЧТО?!"

# ch/samantha/events.rpy:6315
translate russian samantha_event_D01_e5b65482:
    samantha.say "Хочет поговорить со старым приятелем!"

# ch/samantha/events.rpy:6316
translate russian samantha_event_D01_7b31dcd3:
    samantha.say "И что мне ему сказать?"

# ch/samantha/events.rpy:6317
translate russian samantha_event_D01_1feaa8d6:
    samantha.say "Быстро бери трубку и поговори, а то заподозрит!"

# ch/samantha/events.rpy:6318
translate russian samantha_event_D01_094bcad1:
    "Я неохотно позволяю Сэм сунуть телефон мне в руку."

# ch/samantha/events.rpy:6319
translate russian samantha_event_D01_effe58bb:
    "Поднося его к уху, стараюсь придать и лицу, и голосу подобие улыбки."

# ch/samantha/events.rpy:6320
translate russian samantha_event_D01_45f6c0e7:
    mike.say "П-привет, дружище!"

# ch/samantha/events.rpy:6321
translate russian samantha_event_D01_9f05f11c:
    ryan.say "Привет, [lssb_samantha.hero_name()], старина!"

# ch/samantha/events.rpy:6322
translate russian samantha_event_D01_d1085642:
    "Я так сосредоточен на звонке, что не замечаю, чем тем временем занята Сэм."

# ch/samantha/events.rpy:6324
translate russian samantha_event_D01_402ce138:
    "Вдруг меня толкают назад, и я падаю на диван."

# ch/samantha/events.rpy:6325
translate russian samantha_event_D01_786aeaf8:
    mike.say "Ого!"

# ch/samantha/events.rpy:6326
translate russian samantha_event_D01_01013d91:
    ryan.say "Эй, что там, [lssb_samantha.hero_name()]?"

# ch/samantha/events.rpy:6327
translate russian samantha_event_D01_c688456b:
    mike.say "Ничего... Совсем ничего."

# ch/samantha/events.rpy:6328
translate russian samantha_event_D01_d7cf5ba2:
    mike.say "Просто споткнулся... В собственных ногах запутался."

# ch/samantha/events.rpy:6329
translate russian samantha_event_D01_491303d0:
    ryan.say "Господи, ну ты и неуклюжий засранец!"

# ch/samantha/events.rpy:6331
translate russian samantha_event_D01_a4987f91:
    "Могу лишь рассмеяться, глядя вниз на то, что Сэм со мной делает."

# ch/samantha/events.rpy:6332
translate russian samantha_event_D01_bcab91e5:
    "Конечно же, это она меня толкнула и теперь пользуется моей растерянностью."

# ch/samantha/events.rpy:6333
translate russian samantha_event_D01_3c63fa6c:
    "Она стоит передо мной на коленях, уже тянет за ремень и расстёгивает ширинку."

# ch/samantha/events.rpy:6335
translate russian samantha_event_D01_275359a7:
    "Сэм поднимает голову, ловит мой взгляд, хитро улыбается и похотливо подмигивает."

# ch/samantha/events.rpy:6336
translate russian samantha_event_D01_b7d523e4:
    "Я пытаюсь мотать головой и жестами просить остановиться, но она просто игнорирует меня и продолжает."

# ch/samantha/events.rpy:6337
translate russian samantha_event_D01_ecf40bcc:
    "Её пальцы обхватывают член и начинают вытаскивать его из брюк."

# ch/samantha/events.rpy:6338
translate russian samantha_event_D01_af7068c7:
    mike.say "ТАК... Так, Райан, как тебе семейная жизнь?"

# ch/samantha/events.rpy:6339
translate russian samantha_event_D01_2ba0d92e:
    "Слышу одну из привычных усмешек Райана."

# ch/samantha/events.rpy:6340
translate russian samantha_event_D01_3cc5208a:
    "Сплошное самодовольство и радость от возможности поговорить о себе."

# ch/samantha/events.rpy:6341
translate russian samantha_event_D01_af387ad8:
    ryan.say "Отлично, [lssb_samantha.hero_name()], просто отлично."

# ch/samantha/events.rpy:6342
translate russian samantha_event_D01_54d076c3:
    ryan.say "Каждый вечер возвращаешься домой к милой жёнушке."

# ch/samantha/events.rpy:6343
translate russian samantha_event_D01_4a02749d:
    ryan.say "Но хочешь узнать секрет?"

# ch/samantha/events.rpy:6345
translate russian samantha_event_D01_da3b8510:
    "К этому моменту Сэм уже держит мой член и поглаживает его по всей длине."

# ch/samantha/events.rpy:6346
translate russian samantha_event_D01_65ed62a8:
    "Пока в ухе звучат слова Райана, она наклоняется и начинает ещё и целовать и лизать мои яйца."

# ch/samantha/events.rpy:6347
translate russian samantha_event_D01_11c501a8:
    mike.say "Конечно, Райан, конечно!"

# ch/samantha/events.rpy:6348
translate russian samantha_event_D01_919bf996:
    ryan.say "Больше ничего не меняется. Вообще ничего!"

# ch/samantha/events.rpy:6349
translate russian samantha_event_D01_668a438a:
    ryan.say "Я всё тот же парень, понимаешь?"

# ch/samantha/events.rpy:6350
translate russian samantha_event_D01_dc770920:
    mike.say "М-м..."

# ch/samantha/events.rpy:6351
translate russian samantha_event_D01_6b36bf90:
    ryan.say "Те же чувства, желания и потребности..."

# ch/samantha/events.rpy:6352
translate russian samantha_event_D01_aa152efc:
    "Пока Райан всё это рассказывает, я не могу ни ответить, ни тем более уличить его."

# ch/samantha/events.rpy:6353
translate russian samantha_event_D01_e845b65f:
    "Потому что именно сейчас Сэм проводит языком вдоль всего моего члена."

# ch/samantha/events.rpy:6355
translate russian samantha_event_D01_79dba2f5:
    "Добравшись до верха, она размыкает губы и берёт головку в рот."

# ch/samantha/events.rpy:6356
translate russian samantha_event_D01_8cc974ce:
    "Не могу сказать, выдающийся это минет или самый заурядный."

# ch/samantha/events.rpy:6357
translate russian samantha_event_D01_bff242c2:
    "Важно лишь то, что мой член во рту у Сэм и она непрерывно сосёт."

# ch/samantha/events.rpy:6358
translate russian samantha_event_D01_386ed170:
    "Девушка, чувства к которой я скрывал, пока мы жили под одной крышей, теперь доставляет мне удовольствие в этом самом доме!"

# ch/samantha/events.rpy:6359
translate russian samantha_event_D01_091b548f:
    ryan.say "[lssb_samantha.hero_name()], понимаешь, о чём я?"

# ch/samantha/events.rpy:6360
translate russian samantha_event_D01_11a89571:
    ryan.say "[lssb_samantha.hero_name()], ты меня слушаешь?!"

# ch/samantha/events.rpy:6361
translate russian samantha_event_D01_a70309e4:
    mike.say "А... Д-да, Райан. Отлично тебя слышу!"

# ch/samantha/events.rpy:6362
translate russian samantha_event_D01_ab07c9b4:
    ryan.say "Просто проверяю, не уснул ли ты!"

# ch/samantha/events.rpy:6363
translate russian samantha_event_D01_b1026764:
    "Я нервно смеюсь, и смех почти превращается в стон, когда Сэм обхватывает основание члена."

# ch/samantha/events.rpy:6364
translate russian samantha_event_D01_491bcab2:
    "Её голова движется вверх-вниз, а сжатые вокруг ствола пальцы помогают."

# ch/samantha/events.rpy:6365
translate russian samantha_event_D01_8431da5b:
    ryan.say "То есть не думай, что я какая-нибудь крыса."

# ch/samantha/events.rpy:6366
translate russian samantha_event_D01_71548977:
    ryan.say "Но если Сэм не знает, то ей и не больно, правда?"

# ch/samantha/events.rpy:6367
translate russian samantha_event_D01_de2f356a:
    mike.say "Конечно, Райан, да..."

# ch/samantha/events.rpy:6368
translate russian samantha_event_D01_08f20a8b:
    mike.say "Если она не знает..."

# ch/samantha/events.rpy:6370
translate russian samantha_event_D01_5173ed36:
    "Произнося это, я смотрю на Сэм широко раскрытыми от вины и стыда глазами."

# ch/samantha/events.rpy:6371
translate russian samantha_event_D01_68620c88:
    "Но вместо ярости от услышанного в её глазах вспыхивает новая решимость."

# ch/samantha/events.rpy:6372
translate russian samantha_event_D01_339846fb:
    "И она начинает сосать с удвоенной энергией и напором."

# ch/samantha/events.rpy:6373
translate russian samantha_event_D01_dd1f9fe5:
    "Пока Сэм старается, моя свободная рука впивается в диванную подушку."

# ch/samantha/events.rpy:6374
translate russian samantha_event_D01_858683d1:
    "Райан продолжает нудеть мне в ухо какую-то чушь, но я не слышу ни слова."

# ch/samantha/events.rpy:6375
translate russian samantha_event_D01_c3f594b1:
    "Вдруг чувствую, что вот-вот кончу, а затем Сэм выпускает мой член изо рта."

# ch/samantha/events.rpy:6376
translate russian samantha_event_D01_d78fa98e:
    mike.say "Ох... Вот чёрт!"

# ch/samantha/events.rpy:6378
translate russian samantha_event_D01_3b342d3f:
    "Смотрю, как всё, что у меня есть, попадает Сэм прямо в лицо, оставляя липкие белые полосы спермы."

# ch/samantha/events.rpy:6380
translate russian samantha_event_D01_b204f58d:
    "Она успевает закрыть глаза, но рот широко раскрыт, и я вижу, как сперма попадает на язык и губы."

# ch/samantha/events.rpy:6382
translate russian samantha_event_D01_0862940c:
    "При этом Сэм всё время улыбается и выглядит совершенно довольной результатом."

# ch/samantha/events.rpy:6383
translate russian samantha_event_D01_3dcc9205:
    ryan.say "Эй... Какого чёрта!"

# ch/samantha/events.rpy:6384
translate russian samantha_event_D01_3ac2def7:
    ryan.say "Что у вас там происходит?!"

# ch/samantha/events.rpy:6385
translate russian samantha_event_D01_a97a1cdc:
    ryan.say "С Сэм всё нормально?"

# ch/samantha/events.rpy:6386
translate russian samantha_event_D01_2a306070:
    "Наверное, нужно отдать ему должное: хотя бы вспомнил спросить, в порядке ли жена!"

# ch/samantha/events.rpy:6390
translate russian samantha_event_D01_5a1eab77:
    "Но прежде чем я успеваю ответить, Сэм выхватывает телефон из моей руки."

# ch/samantha/events.rpy:6391
translate russian samantha_event_D01_75cd1c61:
    "Всё ещё слизывая сперму с губ, подносит его к уху."

# ch/samantha/events.rpy:6392
translate russian samantha_event_D01_7538f4a6:
    samantha.say "Я здесь, милый. Не волнуйся."

# ch/samantha/events.rpy:6393
translate russian samantha_event_D01_eca92d4b:
    samantha.say "Нет-нет, с нами обоими всё хорошо. Правда."

# ch/samantha/events.rpy:6394
translate russian samantha_event_D01_fff773cf:
    samantha.say "[lssb_samantha.hero_name()] тут занимался выпечкой и решил, что что-то подгорело. Только и всего!"

# ch/samantha/events.rpy:6395
translate russian samantha_event_D01_6157ba66:
    samantha.say "Знаю, знаю. Он такой растяпа!"

# ch/samantha/events.rpy:6396
translate russian samantha_event_D01_c2077be9:
    "Говоря это, Сэм многозначительно подмигивает и снова облизывает губы."

# ch/samantha/events.rpy:6397
translate russian samantha_event_D01_b5134fba:
    samantha.say "Что я ем?"

# ch/samantha/events.rpy:6398
translate russian samantha_event_D01_b2d7d00f:
    samantha.say "А, [lssb_samantha.hero_name()] сделал пончики с кремом. Я попробовала один."

# ch/samantha/events.rpy:6399
translate russian samantha_event_D01_3f160bb7:
    samantha.say "Наверное, слишком много начинки положил. Я укусила, а крем брызнул наружу."

# ch/samantha/events.rpy:6400
translate russian samantha_event_D01_34988dd0:
    samantha.say "Ага, вся перепачкалась!"

# ch/samantha/events.rpy:6401
translate russian samantha_event_D01_07bfa4f5:
    "Я смотрю, как Сэм заканчивает разговор, непринуждённо лгая Райану о том, где была и что мы делали."

# ch/samantha/events.rpy:6402
translate russian samantha_event_D01_32ff11dd:
    "Да, приятно отплатить ему за то, как он с ней поступил."

# ch/samantha/events.rpy:6403
translate russian samantha_event_D01_506b73ab:
    "А одновременно получать ласки Сэм ещё приятнее."

# ch/samantha/events.rpy:6404
translate russian samantha_event_D01_f9cfb70b:
    "Но какая-то часть меня задаётся вопросом: может, мы ничем не лучше самого Райана?"

# ch/samantha/events.rpy:6405
translate russian samantha_event_D01_8efffe44:
    "Может, одним дурным поступком другой не исправить."

# ch/samantha/events.rpy:6406
translate russian samantha_event_D01_4b6141d1:
    "Или мне просто нужно больше доказательств обратного?"

# ch/samantha/events.rpy:6418
translate russian samantha_event_D02_e4cc71c7:
    "Как нетрудно представить, неожиданный визит Сэм в прошлые выходные изрядно меня озадачил."

# ch/samantha/events.rpy:6419
translate russian samantha_event_D02_ad4489f0:
    "С одной стороны, словно сбылась мечта: девушка, которую я считал потерянной, вдруг появилась на пороге."

# ch/samantha/events.rpy:6420
translate russian samantha_event_D02_ed658b28:
    "Ну, а потом выразила свои чувства весьма ощутимым, физическим способом!"

# ch/samantha/events.rpy:6421
translate russian samantha_event_D02_d26b14ef:
    "Но с другой стороны, это породило множество вопросов, на большинство из которых у меня не было ответа."

# ch/samantha/events.rpy:6422
translate russian samantha_event_D02_a4bbdb58:
    "Главный из них: какие намерения у Сэм теперь в отношении меня?"

# ch/samantha/events.rpy:6423
translate russian samantha_event_D02_63ad0f6f:
    "Именно я рассказал ей, что Райану сделали минет в день их свадьбы."

# ch/samantha/events.rpy:6424
translate russian samantha_event_D02_a86eedd4:
    "Так что я мог понять её желание отплатить ему тем же."

# ch/samantha/events.rpy:6425
translate russian samantha_event_D02_c8865b21:
    "И то, что я был самым очевидным выбором для этого."

# ch/samantha/events.rpy:6426
translate russian samantha_event_D02_64813051:
    "Но меня мучило, есть ли за этим что-то большее."

# ch/samantha/events.rpy:6427
translate russian samantha_event_D02_75b33825:
    "Если нет, я не уверен, что готов быть просто орудием мести другому парню."

# ch/samantha/events.rpy:6428
translate russian samantha_event_D02_702cf712:
    "Как бы приятно мне ни было, я рассказал Сэм обо всём из дружеских побуждений."

# ch/samantha/events.rpy:6429
translate russian samantha_event_D02_ed5bd830:
    "Ну... И потому, что всегда был в неё влюблён, конечно!"

# ch/samantha/events.rpy:6431
translate russian samantha_event_D02_cab67a8c:
    "Поэтому, услышав звонок в дверь, я изрядно погружён в мысли."

# ch/samantha/events.rpy:6432
translate russian samantha_event_D02_13945da8:
    "Только дойдя до двери и случайно взглянув на календарь на доске, вдруг понимаю."

# ch/samantha/events.rpy:6433
translate russian samantha_event_D02_ae3e1369:
    "Выходной, как и во время прошлого визита Сэм."

# ch/samantha/events.rpy:6434
translate russian samantha_event_D02_f2f28d63:
    "Быстрый взгляд на телефон подсказывает, что и время примерно то же — после полудня."

# ch/samantha/events.rpy:6435
translate russian samantha_event_D02_92a2952e:
    "Нет, думаю я, открывая дверь. Неужели?"

# ch/samantha/events.rpy:6440
translate russian samantha_event_D02_e3d69131:
    samantha.say "Привет, [lssb_samantha.hero_name()]!"

# ch/samantha/events.rpy:6441
translate russian samantha_event_D02_7822c356:
    "Да, вот она, собственной персоной."

# ch/samantha/events.rpy:6443
translate russian samantha_event_D02_30db09a5:
    mike.say "А... Привет, Кексик."

# ch/samantha/events.rpy:6445
translate russian samantha_event_D02_a42c3fa1:
    mike.say "А... Привет, Сэм."

# ch/samantha/events.rpy:6446
translate russian samantha_event_D02_089273c7:
    "Она широко улыбается и терпеливо ждёт приглашения войти."

# ch/samantha/events.rpy:6447
translate russian samantha_event_D02_b89f6544:
    mike.say "Это только у меня дежавю или у тебя тоже?"

# ch/samantha/events.rpy:6448
translate russian samantha_event_D02_b816b98d:
    "Сэм смеётся и отмахивается от моих опасений."

# ch/samantha/events.rpy:6449
translate russian samantha_event_D02_d11a502d:
    samantha.say "Да, знаю! То же время, то же место!"

# ch/samantha/events.rpy:6450
translate russian samantha_event_D02_1aadd02a:
    samantha.say "Но именно поэтому я и поняла, что должна снова тебя навестить."

# ch/samantha/events.rpy:6451
translate russian samantha_event_D02_e84ffc6f:
    mike.say "Что?"

# ch/samantha/events.rpy:6452
translate russian samantha_event_D02_8ba6d7b3:
    mike.say "Не понимаю..."

# ch/samantha/events.rpy:6454
translate russian samantha_event_D02_09b84a2f:
    samantha.say "Сейчас объясню!"

# ch/samantha/events.rpy:6455
translate russian samantha_event_D02_52a47dbb:
    samantha.say "Я ехала по той же дороге, в то же время, что и на прошлой неделе."

# ch/samantha/events.rpy:6456
translate russian samantha_event_D02_c0738b00:
    samantha.say "И вспомнила о тебе и этом доме."

# ch/samantha/events.rpy:6457
translate russian samantha_event_D02_ed216547:
    samantha.say "И о своём прошлом визите..."

# ch/samantha/events.rpy:6458
translate russian samantha_event_D02_ee180702:
    "Сэм даёт этим словам повиснуть в воздухе: мы оба прекрасно помним, что тогда произошло."

# ch/samantha/events.rpy:6460
translate russian samantha_event_D02_5fea86d4:
    "Она слегка краснеет и торопится продолжить объяснение."

# ch/samantha/events.rpy:6461
translate russian samantha_event_D02_a051eb3a:
    samantha.say "Ну... И вспомнила, что кое-что здесь оставила."

# ch/samantha/events.rpy:6462
translate russian samantha_event_D02_45429330:
    samantha.say "Решила заглянуть и забрать."

# ch/samantha/events.rpy:6463
translate russian samantha_event_D02_6b52cca4:
    "Звучит правдоподобно, поэтому я решаю поверить Сэм на слово."

# ch/samantha/events.rpy:6467
translate russian samantha_event_D02_fdc1f069:
    "Но, пропуская её внутрь, всё же кое о чём задумываюсь."

# ch/samantha/events.rpy:6468
translate russian samantha_event_D02_739070a1:
    mike.say "А откуда ты знала, что я буду дома?"

# ch/samantha/events.rpy:6469
translate russian samantha_event_D02_a6f67eb0:
    mike.say "Могла ведь сначала позвонить и проверить."

# ch/samantha/events.rpy:6470
translate russian samantha_event_D02_a27d8126:
    "Сэм пожимает плечами, отмахиваясь от вопроса, и проходит мимо меня в гостиную."

# ch/samantha/events.rpy:6471
translate russian samantha_event_D02_83b48814:
    samantha.say "Как я и сказала, это было спонтанно."

# ch/samantha/events.rpy:6472
translate russian samantha_event_D02_2aed4ecd:
    samantha.say "Могла бы попросить кого-нибудь из твоих соседок или просунуть записку под дверь."

# ch/samantha/events.rpy:6473
translate russian samantha_event_D02_ab6ffea4:
    "Снова вполне правдоподобно."

# ch/samantha/events.rpy:6474
translate russian samantha_event_D02_06cdfe2b:
    "Стоп, что я вообще делаю?"

# ch/samantha/events.rpy:6475
translate russian samantha_event_D02_f5f32125:
    "Зачем разбираю каждое её слово?"

# ch/samantha/events.rpy:6476
translate russian samantha_event_D02_e9d87996:
    "Ведь это отличный предлог провести ещё немного времени с ней наедине."

# ch/samantha/events.rpy:6477
translate russian samantha_event_D02_5ecfd6ce:
    "И тут мне приходит ещё одна мысль. Я начинаю заглядывать ей за плечо, в окно."

# ch/samantha/events.rpy:6478
translate russian samantha_event_D02_055ae3c4:
    mike.say "Ты ведь одна приехала?"

# ch/samantha/events.rpy:6479
translate russian samantha_event_D02_846d6852:
    mike.say "Райан не ждёт в машине?"

# ch/samantha/events.rpy:6481
translate russian samantha_event_D02_4f6d53e4:
    "Сэм запрокидывает голову и смеётся над моей явной паранойей."

# ch/samantha/events.rpy:6482
translate russian samantha_event_D02_8ddaf14c:
    samantha.say "Нет, [lssb_samantha.hero_name()], не ждёт!"

# ch/samantha/events.rpy:6484
translate russian samantha_event_D02_851149dc:
    samantha.say "И можешь перестать из-за него волноваться."

# ch/samantha/events.rpy:6485
translate russian samantha_event_D02_1422c1a2:
    samantha.say "Он ничего не подозревает!"

# ch/samantha/events.rpy:6486
translate russian samantha_event_D02_7161d9d0:
    "Сэм садится на диван и хлопает по месту рядом, приглашая меня."

# ch/samantha/events.rpy:6487
translate russian samantha_event_D02_a33426ae:
    "Довольно расслабленный способ искать потерянную вещь."

# ch/samantha/events.rpy:6488
translate russian samantha_event_D02_ba946857:
    "Но я отбрасываю эту мысль и послушно сажусь."

# ch/samantha/events.rpy:6490
translate russian samantha_event_D02_cacd44ea:
    "Если подумать, Сэм даже не сказала, что именно ищет."

# ch/samantha/events.rpy:6491
translate russian samantha_event_D02_8127f709:
    mike.say "Эм... Так что ты здесь оставила?"

# ch/samantha/events.rpy:6492
translate russian samantha_event_D02_0702e24e:
    "Улыбка Сэм вдруг становится шире и даже кажется мне немного хищной."

# ch/samantha/events.rpy:6493
translate russian samantha_event_D02_ccba4501:
    "Она наклоняется так близко, что я чувствую её тёплое дыхание на щеке."

# ch/samantha/events.rpy:6494
translate russian samantha_event_D02_edcfcec2:
    "А затем и руку, которая поглаживает и сжимает мой пах."

# ch/samantha/events.rpy:6496
translate russian samantha_event_D02_9b4e07b8:
    samantha.say "О, не беспокойся."

# ch/samantha/events.rpy:6497
translate russian samantha_event_D02_31258066:
    samantha.say "Кажется, уже нашла!"

# ch/samantha/events.rpy:6502
translate russian samantha_event_D02_d917ebf5:
    "Не успеваю сказать ни слова, как Сэм наклоняется и целует меня прямо в губы."

# ch/samantha/events.rpy:6503
translate russian samantha_event_D02_6a6ff975:
    "Какая-то часть меня понимает, что это неправильно: она всё ещё замужем."

# ch/samantha/events.rpy:6504
translate russian samantha_event_D02_6cc55bb1:
    "Но эта лучшая часть проигрывает той, что всегда сходила по ней с ума."

# ch/samantha/events.rpy:6505
translate russian samantha_event_D02_b80c15fc:
    "Во время поцелуя я чувствую, как Сэм расстёгивает ширинку и просовывает руку внутрь."

# ch/samantha/events.rpy:6506
translate russian samantha_event_D02_20bd28c3:
    "Через мгновение она уже массирует мой член. Чтобы он встал, особых усилий не требуется."

# ch/samantha/events.rpy:6510
translate russian samantha_event_D02_52536f19:
    "К тому времени, как Сэм прерывает поцелуй, член уже снаружи, зажат в её ладони."

# ch/samantha/events.rpy:6511
translate russian samantha_event_D02_a8508ecc:
    "Я откидываюсь на диван, хватая воздух."

# ch/samantha/events.rpy:6513
translate russian samantha_event_D02_b19fb9be:
    "Отчасти из-за нехватки дыхания, отчасти от того, что её пальцы делают с моим членом."

# ch/samantha/events.rpy:6514
translate russian samantha_event_D02_52395826:
    samantha.say "М-м..."

# ch/samantha/events.rpy:6515
translate russian samantha_event_D02_88acb375:
    samantha.say "Вот за чем я вернулась, [lssb_samantha.hero_name()]."

# ch/samantha/events.rpy:6516
translate russian samantha_event_D02_583f85ee:
    samantha.say "За ощущением твоего члена в моей руке!"

# ch/samantha/events.rpy:6517
translate russian samantha_event_D02_203b7100:
    samantha.say "И его вкусом на языке..."

# ch/samantha/events.rpy:6518
translate russian samantha_event_D02_c04cfb23:
    mike.say "Ну... Я... Рад, что ты нашла то, что хотела!"

# ch/samantha/events.rpy:6519
translate russian samantha_event_D02_c0f495ff:
    "Сэм улыбается, в предвкушении прикусив губу, и переводит взгляд с моих глаз на член."

# ch/samantha/events.rpy:6520
translate russian samantha_event_D02_50704f78:
    "Затем наклоняется, целует его основание и проводит вокруг языком."

# ch/samantha/events.rpy:6521
translate russian samantha_event_D02_78d9a3f3:
    "Медленно, с бесконечным вниманием к каждому движению, Сэм ведёт языком вверх."

# ch/samantha/events.rpy:6522
translate russian samantha_event_D02_bd098dcf:
    "После каждого прикосновения издаёт довольный звук."

# ch/samantha/events.rpy:6523
translate russian samantha_event_D02_ec7031d6:
    "И всё это время смотрит на меня большими глазами, полными желания."

# ch/samantha/events.rpy:6524
translate russian samantha_event_D02_dabba368:
    "Она закрывает их лишь добравшись до самой вершины, опустив взгляд."

# ch/samantha/events.rpy:6526
translate russian samantha_event_D02_d2bf64d0:
    "В этот момент Сэм наконец берёт головку в рот."

# ch/samantha/events.rpy:6527
translate russian samantha_event_D02_34d49009:
    "Я живо помню ощущение её языка с прошлого раза."

# ch/samantha/events.rpy:6528
translate russian samantha_event_D02_ade155c4:
    "И всё же теперь оно почему-то ещё сильнее и невероятнее."

# ch/samantha/events.rpy:6529
translate russian samantha_event_D02_b549533a:
    "Раньше Сэм, пожалуй, немного робела: для нас всё было внове."

# ch/samantha/events.rpy:6530
translate russian samantha_event_D02_270c4996:
    "Но сейчас от этой робости не осталось и следа."

# ch/samantha/events.rpy:6531
translate russian samantha_event_D02_de7b91d3:
    "Она берёт меня глубже с такой уверенностью, что я невольно ахаю от искреннего удивления."

# ch/samantha/events.rpy:6532
translate russian samantha_event_D02_0104b02f:
    "Смотрю на Сэм, всё ещё с трудом веря, что это вообще происходит."

# ch/samantha/events.rpy:6533
translate russian samantha_event_D02_a8a5bc8b:
    "Может, она чувствует мой взгляд и потому старается ещё сильнее."

# ch/samantha/events.rpy:6534
translate russian samantha_event_D02_34ab7a1f:
    "Одной рукой Сэм сжимает мои яйца, заставляя вздрогнуть от приятной неожиданности."

# ch/samantha/events.rpy:6536
translate russian samantha_event_D02_3de0998b:
    "И только тогда я замечаю, чем занята другая рука."

# ch/samantha/events.rpy:6538
translate russian samantha_event_D02_25fb05ff:
    mike.say "Ах... Кексик..."

# ch/samantha/events.rpy:6540
translate russian samantha_event_D02_111c2f69:
    mike.say "Ах... Сэм..."

# ch/samantha/events.rpy:6541
translate russian samantha_event_D02_f809254b:
    mike.say "Что ты делаешь?!"

# ch/samantha/events.rpy:6542
translate russian samantha_event_D02_cc51229f:
    "Теперь я не свожу глаз с телефона в руке Сэм."

# ch/samantha/events.rpy:6543
translate russian samantha_event_D02_e1ec644c:
    "С ужасом наблюдаю, как она открывает контакты и набирает номер."

# ch/samantha/events.rpy:6544
translate russian samantha_event_D02_a226b298:
    "Она делает всё, даже не глядя на экран. Возникает ощущение, что заранее тренировалась."

# ch/samantha/events.rpy:6545
translate russian samantha_event_D02_321e3cf9:
    "Затем поднимает телефон, явно ожидая, что я заберу эту чёртову штуку."

# ch/samantha/events.rpy:6546
translate russian samantha_event_D02_a7053a3f:
    "Я уже собираюсь взять его, но замечаю имя над номером."

# ch/samantha/events.rpy:6547
translate russian samantha_event_D02_8ec2f3e3:
    mike.say "Какого чёрта?"

# ch/samantha/events.rpy:6548
translate russian samantha_event_D02_6f9fef00:
    mike.say "Ты с ума сошла?!"

# ch/samantha/events.rpy:6549
translate russian samantha_event_D02_390aff18:
    "Она звонит Райану!"

# ch/samantha/events.rpy:6550
translate russian samantha_event_D02_d929c7c4:
    "Прямо сейчас, с моим членом во рту, она действительно ему звонит!"

# ch/samantha/events.rpy:6551
translate russian samantha_event_D02_57488be9:
    "Сэм игнорирует мои встревоженные возгласы и выпускает член изо рта."

# ch/samantha/events.rpy:6552
translate russian samantha_event_D02_dfacaa44:
    "В те несколько мгновений, пока соединение устанавливается и он ещё не ответил, мысли мечутся."

# ch/samantha/events.rpy:6553
translate russian samantha_event_D02_36e6504f:
    "Можно забрать телефон и отбросить. Но что это даст?"

# ch/samantha/events.rpy:6554
translate russian samantha_event_D02_93981d6f:
    "Сэм одержима местью и, нравится мне это или нет, похоже, уже решила, что я участвую."

# ch/samantha/events.rpy:6555
translate russian samantha_event_D02_6a19297f:
    "А если не подыграю, не расскажет ли Райану обо всём, что мы уже сделали?"

# ch/samantha/events.rpy:6556
translate russian samantha_event_D02_96f26783:
    "За долю секунды решаю, что рисковать не стоит."

# ch/samantha/events.rpy:6557
translate russian samantha_event_D02_bb0b34ca:
    ryan.say "Привет, детка!"

# ch/samantha/events.rpy:6558
translate russian samantha_event_D02_e9f9d2d9:
    ryan.say "Куда ты пропала?"

# ch/samantha/events.rpy:6559
translate russian samantha_event_D02_f5258791:
    "Глубоко вдыхаю, ожидая, когда Сэм заговорит."

# ch/samantha/events.rpy:6560
translate russian samantha_event_D02_ecb1ad1e:
    "Изо всех сил стараюсь не издавать звуки парня, которому жена друга делает минет."

# ch/samantha/events.rpy:6561
translate russian samantha_event_D02_219444b1:
    "Будто я вообще знаю, как это должно звучать..."

# ch/samantha/events.rpy:6563
translate russian samantha_event_D02_af8ee077:
    samantha.say "Привет, милый!"

# ch/samantha/events.rpy:6564
translate russian samantha_event_D02_5b3b334c:
    samantha.say "Угадай, с кем я сейчас?"

# ch/samantha/events.rpy:6565
translate russian samantha_event_D02_1116852e:
    "На другом конце линии повисает пауза."

# ch/samantha/events.rpy:6566
translate russian samantha_event_D02_d59025d6:
    "А в голове у меня лишь лицо Райана в тот момент, когда до него наконец доходит."

# ch/samantha/events.rpy:6567
translate russian samantha_event_D02_3caec317:
    ryan.say "Только не говори... [lssb_samantha.hero_name()]?"

# ch/samantha/events.rpy:6568
translate russian samantha_event_D02_1756cff3:
    samantha.say "С первого раза! Надо же, какие шансы?"

# ch/samantha/events.rpy:6569
translate russian samantha_event_D02_772d4a6e:
    ryan.say "Только не говори, что снова приехала ему надоедать?"

# ch/samantha/events.rpy:6570
translate russian samantha_event_D02_ea594f8b:
    "Сэм смеётся, качая головой."

# ch/samantha/events.rpy:6571
translate russian samantha_event_D02_927a244a:
    ryan.say "Я ведь твой муж, ради бога."

# ch/samantha/events.rpy:6572
translate russian samantha_event_D02_444081f9:
    ryan.say "Это мне ты должна весь день надоедать!"

# ch/samantha/events.rpy:6573
translate russian samantha_event_D02_fdc967e9:
    samantha.say "Наверное, просто не могу держаться подальше!"

# ch/samantha/events.rpy:6574
translate russian samantha_event_D02_ae78801c:
    ryan.say "Ну, не злоупотребляй гостеприимством: [lssb_samantha.hero_name()] тоже может устать."

# ch/samantha/events.rpy:6575
translate russian samantha_event_D02_574a370e:
    ryan.say "А то он тебе как следует рот заткнёт. И с моего благословения!"

# ch/samantha/events.rpy:6576
translate russian samantha_event_D02_e6bbe453:
    "Услышав слова Райана, невольно смотрю вниз и замечаю, что именно сейчас перед лицом Сэм."

# ch/samantha/events.rpy:6578
translate russian samantha_event_D02_31f57d4f:
    samantha.say "Не волнуйся, Райан. Уверена, так и будет!"

# ch/samantha/events.rpy:6579
translate russian samantha_event_D02_b6f75528:
    ryan.say "Кстати, где он вообще?"

# ch/samantha/events.rpy:6580
translate russian samantha_event_D02_69b9a222:
    ryan.say "Не передашь ему трубку?"

# ch/samantha/events.rpy:6581
translate russian samantha_event_D02_a22c4a25:
    "Через мгновение мне хочется закричать: чувствую, что вот-вот кончу..."

# ch/samantha/events.rpy:6585
translate russian samantha_event_D02_b7db2580:
    "Почти не думая, протягиваю свободную руку и обхватываю затылок Сэм."

# ch/samantha/events.rpy:6587
translate russian samantha_event_D02_03302307:
    "Резко опускаю её голову, заставляя снова взять головку в рот."

# ch/samantha/events.rpy:6588
translate russian samantha_event_D02_e1cb9dd1:
    "Но не останавливаюсь и проталкиваю член ещё глубже ей в горло."

# ch/samantha/events.rpy:6589
translate russian samantha_event_D02_70cff9ed:
    "Сэм издаёт приглушённый, почти сдавленный звук, вынужденная принять мой член глубоко в горло."

# ch/samantha/events.rpy:6590
translate russian samantha_event_D02_3b08ba14:
    ryan.say "Что это, чёрт возьми, было?!"

# ch/samantha/events.rpy:6591
translate russian samantha_event_D02_87cfa306:
    "Я протягиваю руку и выхватываю телефон из мечущейся ладони Сэм."

# ch/samantha/events.rpy:6592
translate russian samantha_event_D02_9dc34f1d:
    mike.say "Это Сэм."

# ch/samantha/events.rpy:6593
translate russian samantha_event_D02_9050dd1e:
    mike.say "Кажется, что-то не в то горло пошло..."

# ch/samantha/events.rpy:6594
translate russian samantha_event_D02_6a9b1e1c:
    ryan.say "[lssb_samantha.hero_name()]... Это ты?"

# ch/samantha/events.rpy:6595
translate russian samantha_event_D02_5714fda5:
    mike.say "А... Привет, Райан!"

# ch/samantha/events.rpy:6596
translate russian samantha_event_D02_b34a6c65:
    mike.say "Представляешь, Райан, у Сэм и правда сейчас полный рот!"

# ch/samantha/events.rpy:6597
translate russian samantha_event_D02_6a69b38b:
    ryan.say "А, понятно."

# ch/samantha/events.rpy:6598
translate russian samantha_event_D02_7a194c1d:
    ryan.say "Вы там перекусываете, что ли?"

# ch/samantha/events.rpy:6599
translate russian samantha_event_D02_2c9fa2cf:
    mike.say "Эм... Да, можно и так сказать."

# ch/samantha/events.rpy:6600
translate russian samantha_event_D02_d3b4e291:
    ryan.say "Ух ты, ей явно нравится твоё угощение!"

# ch/samantha/events.rpy:6601
translate russian samantha_event_D02_1e7e1f0c:
    ryan.say "Господи, она всегда ела так неаккуратно!"

# ch/samantha/events.rpy:6602
translate russian samantha_event_D02_9f6ad71d:
    ryan.say "Если захочешь применить приём Геймлиха, разрешаю, приятель."

# ch/samantha/events.rpy:6603
translate russian samantha_event_D02_8335186d:
    mike.say "Конечно... приятель!"

# ch/samantha/events.rpy:6605
translate russian samantha_event_D02_926c7b7c:
    "Произнося это, я уже чувствую, как кончаю Сэм в рот."

# ch/samantha/events.rpy:6607
translate russian samantha_event_D02_1583bb3e:
    "Она поняла, что происходит, и давится уже меньше."

# ch/samantha/events.rpy:6610
translate russian samantha_event_D02_4fa40e5f:
    "Но всё же не может сдержать кашель, когда я вытаскиваю член."

# ch/samantha/events.rpy:6611
translate russian samantha_event_D02_a74fa626:
    "Всё это время Сэм судорожно хватает воздух."

# ch/samantha/events.rpy:6612
translate russian samantha_event_D02_3b7230c0:
    "Между её губами и головкой моего члена тянутся нити слюны и спермы."

# ch/samantha/events.rpy:6615
translate russian samantha_event_D02_921edf65:
    ryan.say "Она в порядке?"

# ch/samantha/events.rpy:6616
translate russian samantha_event_D02_9395ffe1:
    mike.say "Да, вроде."

# ch/samantha/events.rpy:6617
translate russian samantha_event_D02_ad19714d:
    mike.say "Кажется, большую часть проглотила!"

# ch/samantha/events.rpy:6618
translate russian samantha_event_D02_4a6f30e1:
    ryan.say "Фу..."

# ch/samantha/events.rpy:6619
translate russian samantha_event_D02_2213c4b0:
    ryan.say "Не хочу разговаривать с ней в таком состоянии!"

# ch/samantha/events.rpy:6620
translate russian samantha_event_D02_a3741e29:
    ryan.say "Просто передай, чтобы впредь не жрала так жадно."

# ch/samantha/events.rpy:6621
translate russian samantha_event_D02_470a9236:
    "И с этими словами он завершает звонок."

# ch/samantha/events.rpy:6623
translate russian samantha_event_D02_53feb914:
    "Сэм открывает рот, чтобы ответить Райану, и именно в этот миг меня накрывает оргазм."

# ch/samantha/events.rpy:6626
translate russian samantha_event_D02_cbc2f1a8:
    "Сперма бьёт прямо в её удивлённое лицо и между раскрытых губ."

# ch/samantha/events.rpy:6628
translate russian samantha_event_D02_a2fc714c:
    "От неожиданности она издаёт сдавленный, почти отчаянный звук."

# ch/samantha/events.rpy:6629
translate russian samantha_event_D02_3b08ba14_1:
    ryan.say "Что это, чёрт возьми, было?!"

# ch/samantha/events.rpy:6630
translate russian samantha_event_D02_cca5ec70:
    samantha.say "Это я..."

# ch/samantha/events.rpy:6631
translate russian samantha_event_D02_58ce8fc0:
    samantha.say "Кажется, что-то не в то горло пошло..."

# ch/samantha/events.rpy:6632
translate russian samantha_event_D02_4bef8a10:
    ryan.say "Господи, хватит уже набивать рот!"

# ch/samantha/events.rpy:6633
translate russian samantha_event_D02_04963384:
    "Вытирая блестящую сперму с лица, Сэм закатывает глаза в ответ на неласковое замечание мужа."

# ch/samantha/events.rpy:6635
translate russian samantha_event_D02_79c254a7:
    samantha.say "Слушай, мне нужно немного привести себя в порядок."

# ch/samantha/events.rpy:6636
translate russian samantha_event_D02_19b69bfd:
    samantha.say "Передам телефон. [lssb_samantha.hero_name()] с тобой поговорит, ладно?"

# ch/samantha/events.rpy:6637
translate russian samantha_event_D02_74330249:
    "Во время всего разговора я не отрываю глаз от лица Сэм."

# ch/samantha/events.rpy:6638
translate russian samantha_event_D02_9c9d7e2e:
    "Почти каждый его сантиметр покрыт блестящей маской из спермы."

# ch/samantha/events.rpy:6639
translate russian samantha_event_D02_7b022705:
    "Смотрю, как она стекает по щекам, капает с носа и подбородка."

# ch/samantha/events.rpy:6640
translate russian samantha_event_D02_08f6d69a:
    "Несколько нитей даже тянутся от губ к головке моего члена."

# ch/samantha/events.rpy:6641
translate russian samantha_event_D02_ffbdcc90:
    "От этого зрелища меня отвлекает лишь протянутый телефон."

# ch/samantha/events.rpy:6642
translate russian samantha_event_D02_811d747e:
    mike.say "Эм... Привет, Райан!"

# ch/samantha/events.rpy:6643
translate russian samantha_event_D02_cf0deb60:
    ryan.say "Господи, [lssb_samantha.hero_name()], с Сэм точно всё хорошо?"

# ch/samantha/events.rpy:6644
translate russian samantha_event_D02_044ae282:
    mike.say "А, да... Наверное."

# ch/samantha/events.rpy:6645
translate russian samantha_event_D02_17b60b14:
    mike.say "Кажется... Кажется, она уже всё откашляла."

# ch/samantha/events.rpy:6646
translate russian samantha_event_D02_aa73542f:
    ryan.say "Фу... Прелестно!"

# ch/samantha/events.rpy:6647
translate russian samantha_event_D02_2101bacf:
    ryan.say "Не думаю, что хочу разговаривать с ней в таком виде."

# ch/samantha/events.rpy:6648
translate russian samantha_event_D02_16c834d3:
    ryan.say "И я знаю, что могу доверить тебе позаботиться о ней. Правда?"

# ch/samantha/events.rpy:6649
translate russian samantha_event_D02_b84d1c92:
    mike.say "Конечно... Конечно."

# ch/samantha/events.rpy:6650
translate russian samantha_event_D02_b4a2313b:
    "После этого он кладёт трубку."

# ch/samantha/events.rpy:6654
translate russian samantha_event_D02_f1686b72:
    "Сэм вытирает рот тыльной стороной ладони и почти презрительно смотрит на телефон в моей руке."

# ch/samantha/events.rpy:6655
translate russian samantha_event_D02_91a65673:
    "Какая-то часть меня хочет рассердиться на неё за то, что она мстит Райану тем же предательством."

# ch/samantha/events.rpy:6656
translate russian samantha_event_D02_c0be301f:
    "Эта часть, наверное, стала бы читать ей нотации: мол, ты становишься ничем не лучше него."

# ch/samantha/events.rpy:6657
translate russian samantha_event_D02_74b32cb2:
    "Но я знаю, что ничего подобного не сделаю."

# ch/samantha/events.rpy:6658
translate russian samantha_event_D02_7eb99a8d:
    "Наверное, моё желание быть с Сэм намного сильнее верности Райану."

# ch/samantha/events.rpy:6659
translate russian samantha_event_D02_e49e897f:
    "Да, соглашаясь на всё это, я, возможно, опускаюсь до его уровня."

# ch/samantha/events.rpy:6660
translate russian samantha_event_D02_6323a1b0:
    "Но, если выбирать, я лучше останусь виноватым и буду получать от Сэм такие ласки."

# ch/samantha/events.rpy:6661
translate russian samantha_event_D02_1a159ef5:
    "Чем останусь один с уверенностью, что поступил правильно."

# ch/samantha/events.rpy:6674
translate russian samantha_event_D03_bcccf467:
    "После второго визита Сэм в выходные всё между нами, похоже, становится серьёзным."

# ch/samantha/events.rpy:6675
translate russian samantha_event_D03_00111d28:
    "Уже не помню, на что именно надеялся, впервые рассказывая ей об измене Райана в день свадьбы."

# ch/samantha/events.rpy:6676
translate russian samantha_event_D03_f8df02f9:
    "Возможно, одной из причин было то, что я всегда жалел: между нами только дружба."

# ch/samantha/events.rpy:6677
translate russian samantha_event_D03_686c0d9b:
    "Но вряд ли мог представить, что в итоге окажусь втянут в план мести Сэм за его измену."

# ch/samantha/events.rpy:6678
translate russian samantha_event_D03_cff6d673:
    "По крайней мере, не такой!"

# ch/samantha/events.rpy:6679
translate russian samantha_event_D03_901a2e78:
    "Пожалуй, прежние надежды уже неважны: у нас с Сэм, по сути, роман."

# ch/samantha/events.rpy:6680
translate russian samantha_event_D03_be1ae825:
    "По крайней мере, надеюсь, что именно это между нами и происходит."

# ch/samantha/events.rpy:6681
translate russian samantha_event_D03_48ce4d6e:
    "Не знаю, смог бы я смириться с тем, что мной просто пользуются ради мести такому парню, как Райан."

# ch/samantha/events.rpy:6682
translate russian samantha_event_D03_ea945885:
    "Особенно если пользуется девушка, к которой у меня такие сильные чувства!"

# ch/samantha/events.rpy:6684
translate russian samantha_event_D03_81c0f583:
    "Может, поэтому я так стремлюсь ей угодить, когда Сэм неожиданно звонит?"

# ch/samantha/events.rpy:6686
translate russian samantha_event_D03_fed01ec2:
    samantha.say "Привет, [lssb_samantha.hero_name()]! Чем сейчас занимаешься?"

# ch/samantha/events.rpy:6688
translate russian samantha_event_D03_b201ce17:
    mike.say "А... Привет, Кексик."

# ch/samantha/events.rpy:6690
translate russian samantha_event_D03_c006a5ad:
    mike.say "А... Привет, Сэм."

# ch/samantha/events.rpy:6691
translate russian samantha_event_D03_70ef9238:
    mike.say "Да, пожалуй, ничем особенным."

# ch/samantha/events.rpy:6692
translate russian samantha_event_D03_bafcf083:
    "Сэм изображает сигнал неправильного ответа на телеигре."

# ch/samantha/events.rpy:6693
translate russian samantha_event_D03_ea699b87:
    samantha.say "Неверно!"

# ch/samantha/events.rpy:6694
translate russian samantha_event_D03_0eb164e2:
    samantha.say "Правильный ответ: поднимаешь свою задницу."

# ch/samantha/events.rpy:6695
translate russian samantha_event_D03_297f62db:
    mike.say "Что..."

# ch/samantha/events.rpy:6696
translate russian samantha_event_D03_26325b3f:
    samantha.say "А потом идёшь к двери и впускаешь меня!"

# ch/samantha/events.rpy:6697
translate russian samantha_event_D03_1b10092c:
    mike.say "Что... Ты снаружи?"

# ch/samantha/events.rpy:6698
translate russian samantha_event_D03_c04845da:
    mike.say "Прямо сейчас?"

# ch/samantha/events.rpy:6699
translate russian samantha_event_D03_a9f5c781:
    "Хотя я ещё задаю вопрос, уже встаю и иду в прихожую."

# ch/samantha/events.rpy:6704
translate russian samantha_event_D03_a7dc79c5:
    "Успеваю дойти и открыть дверь раньше, чем Сэм отвечает."

# ch/samantha/events.rpy:6705
translate russian samantha_event_D03_a386704b:
    samantha.say "Ну, пригласишь войти?"

# ch/samantha/events.rpy:6706
translate russian samantha_event_D03_3f510b35:
    mike.say "Эм, да... Конечно."

# ch/samantha/events.rpy:6708
translate russian samantha_event_D03_1ea8ad38:
    "Я наверняка выгляжу довольно растерянным, но Сэм либо игнорирует это, либо вовсе не замечает."

# ch/samantha/events.rpy:6710
translate russian samantha_event_D03_631d3b08:
    "Она весело входит в дом и на этот раз направляется прямо в мою спальню."

# ch/samantha/events.rpy:6711
translate russian samantha_event_D03_52d119a8:
    "В любых других обстоятельствах я объяснил бы это тем, что она здесь жила и прекрасно знает дом."

# ch/samantha/events.rpy:6712
translate russian samantha_event_D03_0abba86c:
    "Но после того, чем мы занимались в её прошлые визиты, это приобретает совершенно иной смысл."

# ch/samantha/events.rpy:6713
translate russian samantha_event_D03_9757fbe9:
    "Иду вслед за Сэм в свою комнату, стараясь не выглядеть ни подозрительным, ни смущённым."

# ch/samantha/events.rpy:6714
translate russian samantha_event_D03_fc510ffb:
    "Однако, едва сев на кровать и подняв на меня взгляд, она замечает мою нерешительность."

# ch/samantha/events.rpy:6716
translate russian samantha_event_D03_04a02639:
    samantha.say "Что такое, [lssb_samantha.hero_name()]?"

# ch/samantha/events.rpy:6717
translate russian samantha_event_D03_c61bccc4:
    samantha.say "Думала, ты будешь рад меня видеть."

# ch/samantha/events.rpy:6718
translate russian samantha_event_D03_e53089fb:
    samantha.say "Знаешь, я всю неделю о тебе думала!"

# ch/samantha/events.rpy:6719
translate russian samantha_event_D03_2bb771d9:
    "Сэм хлопает по кровати рядом с собой, и я послушно сажусь."

# ch/samantha/events.rpy:6721
translate russian samantha_event_D03_66f0d89e:
    mike.say "Я... Я рад тебя видеть, Кексик."

# ch/samantha/events.rpy:6723
translate russian samantha_event_D03_a40310d8:
    mike.say "Я... Я рад тебя видеть, Сэм."

# ch/samantha/events.rpy:6724
translate russian samantha_event_D03_23847fb2:
    mike.say "Сам ни о чём другом думать не мог..."

# ch/samantha/events.rpy:6725
translate russian samantha_event_D03_2b69805e:
    samantha.say "Но..."

# ch/samantha/events.rpy:6726
translate russian samantha_event_D03_61277a64:
    mike.say "Но не хочу думать, что ты просто..."

# ch/samantha/events.rpy:6727
translate russian samantha_event_D03_4625d89e:
    mike.say "Ну... используешь меня, чтобы отомстить Райану!"

# ch/samantha/events.rpy:6729
translate russian samantha_event_D03_56cc3cd0:
    "Глаза Сэм расширяются, словно она искренне удивлена."

# ch/samantha/events.rpy:6730
translate russian samantha_event_D03_1391622c:
    samantha.say "Нет... Конечно нет, [lssb_samantha.hero_name()]!"

# ch/samantha/events.rpy:6732
translate russian samantha_event_D03_58adb0b4:
    samantha.say "Ради этого я могла бы выйти на улицу и трахнуть первого встречного."

# ch/samantha/events.rpy:6733
translate russian samantha_event_D03_c4c54722:
    samantha.say "Хочу отомстить ему с тобой, чтобы мы оба могли утереть ему его самодовольную рожу."

# ch/samantha/events.rpy:6734
translate russian samantha_event_D03_b11ca9c3:
    "Говоря это, Сэм протягивает руки и берёт мои."

# ch/samantha/events.rpy:6736
translate russian samantha_event_D03_b9871f6f:
    samantha.say "Но надеюсь, когда он исчезнет из нашей жизни, между нами будет гораздо больше."

# ch/samantha/events.rpy:6737
translate russian samantha_event_D03_782d2b64:
    samantha.say "Если ты тоже этого хочешь?"

# ch/samantha/events.rpy:6738
translate russian samantha_event_D03_3e707609:
    "Я киваю с облегчением."

# ch/samantha/events.rpy:6740
translate russian samantha_event_D03_d466e274:
    samantha.say "Хорошо. Теперь, когда разобрались, может, займёмся чем-нибудь приятным?"

# ch/samantha/events.rpy:6741
translate russian samantha_event_D03_f5946199:
    "Снова киваю, невольно сглотнув от предвкушения."

# ch/samantha/events.rpy:6742
translate russian samantha_event_D03_51b618dc:
    samantha.say "Отлично, [lssb_samantha.hero_name()]."

# ch/samantha/events.rpy:6743
translate russian samantha_event_D03_28916bdb:
    samantha.say "Потому что хочу забраться сверху, чтобы ты меня трахнул!"

# ch/samantha/events.rpy:6744
translate russian samantha_event_D03_7fb9a322:
    "Нужно мгновение, чтобы слова Сэм полностью дошли до меня."

# ch/samantha/events.rpy:6745
translate russian samantha_event_D03_b6898a8e:
    "Та, кого я чуть не потерял, только что попросила её трахнуть?"

# ch/samantha/events.rpy:6746
translate russian samantha_event_D03_3021b55f:
    mike.say "Что ты хочешь?"

# ch/samantha/events.rpy:6747
translate russian samantha_event_D03_5a851346:
    samantha.say "Трахни меня, [lssb_samantha.hero_name()]. Прямо здесь и сейчас."

# ch/samantha/events.rpy:6748
translate russian samantha_event_D03_237f508d:
    "Словно её будничного тона мало, Сэм переходит к действиям, показывая свои намерения."

# ch/samantha/events.rpy:6749
translate russian samantha_event_D03_093b9b70:
    "Толкает меня на спину, укладывая на кровать."

# ch/samantha/events.rpy:6751
translate russian samantha_event_D03_8ccb9d01:
    "Затем задирает платье и стягивает трусики."

# ch/samantha/events.rpy:6753
translate russian samantha_event_D03_b5bbf1ed:
    samantha.say "Ну же, [lssb_samantha.hero_name()], чего ждёшь?"

# ch/samantha/events.rpy:6754
translate russian samantha_event_D03_c8907b53:
    samantha.say "Я знаю, как сильно ты всегда меня хотел!"

# ch/samantha/events.rpy:6755
translate russian samantha_event_D03_7f4b99f9:
    "Не знаю, что действует сильнее: вид Сэм, вот так предлагающей себя."

# ch/samantha/events.rpy:6756
translate russian samantha_event_D03_540c17b2:
    "Или понимающее выражение лица, с которым она меня соблазняет."

# ch/samantha/events.rpy:6757
translate russian samantha_event_D03_6dc90294:
    "Но в любом случае ясно одно: устоять перед таким предложением невозможно."

# ch/samantha/events.rpy:6758
translate russian samantha_event_D03_1fb2f90b:
    mike.say "А, к чёрту."

# ch/samantha/events.rpy:6759
translate russian samantha_event_D03_5e9fcecc:
    mike.say "Да пошёл Райан в жопу!"

# ch/samantha/events.rpy:6760
translate russian samantha_event_D03_0fe06f73:
    "Сэм улыбается через плечо и качает головой."

# ch/samantha/events.rpy:6761
translate russian samantha_event_D03_0a83e263:
    samantha.say "Лучше трахни меня!"

# ch/samantha/events.rpy:6765
translate russian samantha_event_D03_230ea5cf:
    "За пару секунд она срывает с меня одежду и отбрасывает в сторону."

# ch/samantha/events.rpy:6766
translate russian samantha_event_D03_21116e4b:
    "Почему-то сразу понятно: этот секс не будет самым неторопливым и романтичным на свете."

# ch/samantha/events.rpy:6767
translate russian samantha_event_D03_564cfb63:
    "Желание полностью завладевает мной. Хочу только прикоснуться к ней."

# ch/samantha/events.rpy:6768
translate russian samantha_event_D03_75a1207d:
    "Всё ещё спиной ко мне, Сэм садится верхом на мои бёдра и берёт член."

# ch/samantha/events.rpy:6770
translate russian samantha_event_D03_b8e849f1:
    "Направляет его точно куда нужно, проводя головкой по уже влажным губкам."

# ch/samantha/events.rpy:6771
translate russian samantha_event_D03_c7852c49:
    "Начав опускаться, оглядывается на меня через плечо."

# ch/samantha/events.rpy:6772
translate russian samantha_event_D03_e92d4d3a:
    "Поэтому я вижу на её лице отражение всех ощущений."

# ch/samantha/events.rpy:6774
translate russian samantha_event_D03_bdc66c83:
    "Сэм закрывает глаза и всё шире приоткрывает рот, пока головка понемногу входит в неё."

# ch/samantha/events.rpy:6775
translate russian samantha_event_D03_4a52da7d:
    "Её дыхание всё больше напоминает череду прерывистых вздохов."

# ch/samantha/events.rpy:6776
translate russian samantha_event_D03_65f05f40:
    "Она опускается на член, и наслаждение на лице становится всё заметнее."

# ch/samantha/events.rpy:6777
translate russian samantha_event_D03_928e4ca8:
    "Словно каждый новый сантиметр внутри резко усиливает ощущения."

# ch/samantha/events.rpy:6778
translate russian samantha_event_D03_aa7373fd:
    "Наконец я чувствую, как она всем весом прижимается ко мне."

# ch/samantha/events.rpy:6779
translate russian samantha_event_D03_77842412:
    "Значит, глубже уже некуда."

# ch/samantha/events.rpy:6780
translate russian samantha_event_D03_e24e8aa2:
    "Сэм некоторое время сидит сверху, явно наслаждаясь мгновением."

# ch/samantha/events.rpy:6782
translate russian samantha_event_D03_378b9315:
    "Но тут я замечаю что-то у неё в руке."

# ch/samantha/events.rpy:6783
translate russian samantha_event_D03_57d48923:
    "Наверное, следовало сразу догадаться, что именно!"

# ch/samantha/events.rpy:6785
translate russian samantha_event_D03_78b8cda2:
    mike.say "Кексик, что ты..."

# ch/samantha/events.rpy:6787
translate russian samantha_event_D03_e77d9dad:
    mike.say "Сэм, что ты..."

# ch/samantha/events.rpy:6788
translate russian samantha_event_D03_de0e08fd:
    "Как только я начинаю говорить, Сэм начинает скакать на мне."

# ch/samantha/events.rpy:6789
translate russian samantha_event_D03_e87dff14:
    "Она каким-то образом идеально использует свой вес и вызываемые этим ощущения."

# ch/samantha/events.rpy:6790
translate russian samantha_event_D03_ecc2839c:
    "Вместе они оставляют мне лишь возможность беспомощно извиваться под ней."

# ch/samantha/events.rpy:6792
translate russian samantha_event_D03_cc4af3ae:
    mike.say "Нет, Кексик!"

# ch/samantha/events.rpy:6794
translate russian samantha_event_D03_0a5ec1f3:
    mike.say "Нет, Сэм!"

# ch/samantha/events.rpy:6795
translate russian samantha_event_D03_7ae8a746:
    "Но уже поздно: я вижу имя над набираемым номером."

# ch/samantha/events.rpy:6796
translate russian samantha_event_D03_9431627f:
    "Раздаются гудки. Сэм машет телефоном через плечо и качает головой."

# ch/samantha/events.rpy:6797
translate russian samantha_event_D03_2561ec78:
    "Намёк предельно ясен."

# ch/samantha/events.rpy:6798
translate russian samantha_event_D03_57009917:
    "Несколько секунд напряжённо смотрю на неё в молчании, затем поспешно киваю."

# ch/samantha/events.rpy:6799
translate russian samantha_event_D03_c12bb953:
    "Сэм мило улыбается, зная, что полностью владеет ситуацией."

# ch/samantha/events.rpy:6800
translate russian samantha_event_D03_0b7e4e85:
    ryan.say "Привет, детка. Что такое?"

# ch/samantha/events.rpy:6801
translate russian samantha_event_D03_e2ec9dad:
    ryan.say "Ты ведь говорила, что до вечера будешь в спортзале?"

# ch/samantha/events.rpy:6802
translate russian samantha_event_D03_803bab6e:
    "К тому времени, как Сэм отвечает, она уже значительно ускорилась."

# ch/samantha/events.rpy:6803
translate russian samantha_event_D03_4bb76d29:
    "Поэтому говорит, тяжело дыша и задыхаясь, словно на пределе физических сил."

# ch/samantha/events.rpy:6805
translate russian samantha_event_D03_95ebf668:
    samantha.say "Я... всё ещё... в зале."

# ch/samantha/events.rpy:6806
translate russian samantha_event_D03_f69d84f9:
    samantha.say "Просто... решила позвонить!"

# ch/samantha/events.rpy:6808
translate russian samantha_event_D03_227ff1d6:
    ryan.say "Соскучилась по сладчайшему звуку моего голоса, да?"

# ch/samantha/events.rpy:6809
translate russian samantha_event_D03_e636e39d:
    "Лицо Сэм искажается от отвращения, и она изображает, как суёт пальцы в горло."

# ch/samantha/events.rpy:6810
translate russian samantha_event_D03_90403165:
    "Но в ответе ничто не выдаёт этих чувств."

# ch/samantha/events.rpy:6812
translate russian samantha_event_D03_0eef3614:
    samantha.say "Ах... Ты меня раскусил."

# ch/samantha/events.rpy:6813
translate russian samantha_event_D03_acfc1568:
    samantha.say "Ты всегда... знаешь, что у меня... внутри!"

# ch/samantha/events.rpy:6815
translate russian samantha_event_D03_319d84bd:
    "Скрытый смысл фразы я понимаю мгновенно."

# ch/samantha/events.rpy:6816
translate russian samantha_event_D03_8011fcc3:
    "И должен сказать, сейчас я знаю об этом больше Райана!"

# ch/samantha/events.rpy:6817
translate russian samantha_event_D03_535dc350:
    ryan.say "Слушай... По голосу похоже, тебя там хорошенько имеют!"

# ch/samantha/events.rpy:6818
translate russian samantha_event_D03_06ccd641:
    ryan.say "Уверена, что выдержишь такую нагрузку?"

# ch/samantha/events.rpy:6819
translate russian samantha_event_D03_3729f853:
    "Сэм смеётся над заботливым тоном Райана, явно наслаждаясь тем, как им манипулирует."

# ch/samantha/events.rpy:6821
translate russian samantha_event_D03_9b118865:
    samantha.say "Это... новый тренер. Его недавно... наняли."

# ch/samantha/events.rpy:6823
translate russian samantha_event_D03_17bf20de:
    samantha.say "Он сегодня... меня совсем загонял!"

# ch/samantha/events.rpy:6824
translate russian samantha_event_D03_70cf7795:
    ryan.say "Чёрт, по голосу слышно!"

# ch/samantha/events.rpy:6836
translate russian samantha_event_D03_2665687a:
    samantha.say "Да... Он... тот ещё... хер."

# ch/samantha/events.rpy:6848
translate russian samantha_event_D03_e83c1d85:
    samantha.say "Но... не волнуйся... я получу... всё, за что заплатила!"

# ch/samantha/events.rpy:6849
translate russian samantha_event_D03_32f86ed0:
    ryan.say "Вот и правильно, детка."

# ch/samantha/events.rpy:6850
translate russian samantha_event_D03_d4c37802:
    "Вдруг чувствую приближение неизбежного и хватаю Сэм за бёдра."

# ch/samantha/events.rpy:6862
translate russian samantha_event_D03_824ab12d:
    samantha.say "Ого!"

# ch/samantha/events.rpy:6863
translate russian samantha_event_D03_abada575:
    samantha.say "Кажется, он решил мощно закончить!"

# ch/samantha/events.rpy:6864
translate russian samantha_event_D03_69ccaca2:
    samantha.say "Мне пора. Люблю тебя."

# ch/samantha/events.rpy:6865
translate russian samantha_event_D03_481400b0:
    ryan.say "Ладно. А я тебя больше!"

# ch/samantha/events.rpy:6879
translate russian samantha_event_D03_0d883c6c:
    "Почти в тот же миг, как Сэм заканчивает звонок, я кончаю в неё как можно глубже."

# ch/samantha/events.rpy:6881
translate russian samantha_event_D03_d2cbb358:
    "Она тут же бросает телефон и почти отчаянно принимается массировать грудь."

# ch/samantha/events.rpy:6883
translate russian samantha_event_D03_6614fd8f:
    "Чувствую, как она трётся о мой член."

# ch/samantha/events.rpy:6884
translate russian samantha_event_D03_5669c299:
    "Словно хочет выжать наслаждение из каждого мгновения, пока он ещё внутри."

# ch/samantha/events.rpy:6885
translate russian samantha_event_D03_14b4189e:
    "И ей вовсе не приходится довольствоваться несколькими короткими секундами."

# ch/samantha/events.rpy:6887
translate russian samantha_event_D03_8ab47f77:
    "Не знаю, то ли я просто давно не кончал."

# ch/samantha/events.rpy:6888
translate russian samantha_event_D03_392dc9f6:
    "То ли всё это время копил в себе столько спермы исключительно для Сэм."

# ch/samantha/events.rpy:6890
translate russian samantha_event_D03_24e60d92:
    "Так или иначе, я продолжаю кончать, пока она не наполняется до краёв."

# ch/samantha/events.rpy:6894
translate russian samantha_event_D03_514118f1:
    "А когда мне наконец удаётся вытащить член из её киски, из Сэм сразу же начинает вытекать сперма."

# ch/samantha/events.rpy:6895
translate russian samantha_event_D03_540d7b86:
    "Я слышу только её тяжёлое, изнурённое дыхание."

# ch/samantha/events.rpy:6896
translate russian samantha_event_D03_0e172f44:
    "И вижу только сперму, которая непрерывно капает из-под её набухших половых губ."

# ch/samantha/events.rpy:6898
translate russian samantha_event_D03_ff5245f3:
    "И тут мне вдруг приходит в голову одна мысль."

# ch/samantha/events.rpy:6900
translate russian samantha_event_D03_3909ba22:
    mike.say "Кексик..."

# ch/samantha/events.rpy:6902
translate russian samantha_event_D03_7295c41f:
    mike.say "Сэм..."

# ch/samantha/events.rpy:6903
translate russian samantha_event_D03_d0cc614e:
    samantha.say "М-м?"

# ch/samantha/events.rpy:6904
translate russian samantha_event_D03_25f67173:
    mike.say "Ты ведь принимаешь таблетки, правда?"

# ch/samantha/events.rpy:6906
translate russian samantha_event_D03_2e2af206:
    samantha.say "М-м-м... нет."

# ch/samantha/events.rpy:6908
translate russian samantha_event_D03_38f52ac7:
    samantha.say "Незачем: Райан всё равно всегда пользуется резинкой!"

# ch/samantha/events.rpy:6909
translate russian samantha_event_D03_d9b43fcc:
    "Внезапно струйка спермы, всё ещё вытекающая из киски Сэм, приобретает куда большее значение."

# ch/samantha/events.rpy:6910
translate russian samantha_event_D03_955962ad:
    "Я смотрю на неё с неподдельным удивлением, а она лишь улыбается мне в ответ."

# ch/samantha/events.rpy:6911
translate russian samantha_event_D03_12859873:
    "По её лицу можно подумать, что во всём мире нет ничего невиннее."

# ch/samantha/events.rpy:6923
translate russian samantha_event_D04_5bd59457:
    "Для мужчины нет ничего страшнее, чем услышать от своей девушки: «Нам надо поговорить»."

# ch/samantha/events.rpy:6924
translate russian samantha_event_D04_12273e57:
    "Поэтому я и сам произношу эти слова с большой осторожностью: наверное, девушкам слышать их не менее страшно."

# ch/samantha/events.rpy:6925
translate russian samantha_event_D04_324e4e2f:
    "Но стоит мне повернуться к Сэм и произнести эти три жутких слова, как я начинаю сомневаться в своей правоте."

# ch/samantha/events.rpy:6927
translate russian samantha_event_D04_df63972b:
    mike.say "Эм, Кексик?"

# ch/samantha/events.rpy:6929
translate russian samantha_event_D04_cfa4394a:
    mike.say "Эм, Сэм?"

# ch/samantha/events.rpy:6930
translate russian samantha_event_D04_1391f201:
    samantha.say "М-м... да, [lssb_samantha.hero_name()]?"

# ch/samantha/events.rpy:6931
translate russian samantha_event_D04_4dd35f08:
    mike.say "Я... думаю, нам надо поговорить..."

# ch/samantha/events.rpy:6932
translate russian samantha_event_D04_67b4faca:
    "Я жду, что в глазах Сэм тут же появится затравленное выражение, но этого не происходит."

# ch/samantha/events.rpy:6933
translate russian samantha_event_D04_b24f80c3:
    "Вместо этого она придвигается ко мне, улыбается и согласно кивает."

# ch/samantha/events.rpy:6934
translate russian samantha_event_D04_d422bc88:
    samantha.say "Конечно, давай поговорим, [lssb_samantha.hero_name()]!"

# ch/samantha/events.rpy:6935
translate russian samantha_event_D04_9cc377c5:
    samantha.say "С тех пор как я съехала, столько всего накопилось."

# ch/samantha/events.rpy:6936
translate russian samantha_event_D04_2528fad4:
    samantha.say "И теперь мы можем сказать друг другу столько того, о чём раньше не могли даже заикнуться."

# ch/samantha/events.rpy:6937
translate russian samantha_event_D04_b70cc815:
    "Пока она всё это выпаливает, я начинаю подозревать, что тут возникло небольшое недоразумение."

# ch/samantha/events.rpy:6938
translate russian samantha_event_D04_e8f5c6fa:
    samantha.say "И знаешь, как же приятно слышать такое предложение от тебя!"

# ch/samantha/events.rpy:6939
translate russian samantha_event_D04_722f5d23:
    samantha.say "Столько парней совершенно не умеют по-настоящему разговаривать с девушкой."

# ch/samantha/events.rpy:6940
translate russian samantha_event_D04_991cec1b:
    samantha.say "Здорово, что ты сам этого хочешь, [lssb_samantha.hero_name()]!"

# ch/samantha/events.rpy:6941
translate russian samantha_event_D04_6a63b197:
    "Ага, кажется, я понял, в чём проблема."

# ch/samantha/events.rpy:6942
translate russian samantha_event_D04_5c18013b:
    "Я хотел поговорить о чём-то конкретном, как обычно и бывает у парней."

# ch/samantha/events.rpy:6943
translate russian samantha_event_D04_f4c87798:
    "А Сэм думает, что я хочу долго и обстоятельно поговорить о наших отношениях вообще."

# ch/samantha/events.rpy:6945
translate russian samantha_event_D04_101ab43f:
    samantha.say "Вот Райан бы никогда такого не предложил!"

# ch/samantha/events.rpy:6946
translate russian samantha_event_D04_23bb7ff8:
    "Услышав имя Райана, я сразу же хватаюсь за возможность."

# ch/samantha/events.rpy:6947
translate russian samantha_event_D04_a0469cda:
    mike.say "Вообще-то он как раз одна из тем, которые я хотел обсудить."

# ch/samantha/events.rpy:6949
translate russian samantha_event_D04_a9e43832:
    samantha.say "Да?"

# ch/samantha/events.rpy:6950
translate russian samantha_event_D04_360c4d1a:
    samantha.say "В смысле?"

# ch/samantha/events.rpy:6951
translate russian samantha_event_D04_c6eea7c4:
    "Прежде чем продолжить, я делаю паузу и стараюсь незаметно глубоко вздохнуть."

# ch/samantha/events.rpy:6953
translate russian samantha_event_D04_c7a166a1:
    mike.say "Кексик, мы ведь уже какое-то время встречаемся, да?"

# ch/samantha/events.rpy:6955
translate russian samantha_event_D04_d28e1d76:
    mike.say "Сэм, мы ведь уже какое-то время встречаемся, да?"

# ch/samantha/events.rpy:6957
translate russian samantha_event_D04_0304936d:
    "Сэм кивает: с этим утверждением не поспоришь."

# ch/samantha/events.rpy:6958
translate russian samantha_event_D04_b13fafe0:
    mike.say "Достаточно долго, чтобы оба понимали: это не просто безумная интрижка, правда?"

# ch/samantha/events.rpy:6959
translate russian samantha_event_D04_86f9fe25:
    mike.say "Достаточно долго, чтобы всё не сводилось к нашему общему желанию насолить Райану?"

# ch/samantha/events.rpy:6960
translate russian samantha_event_D04_d09b4110:
    "Сэм снова кивает, но на этот раз заметно медленнее."

# ch/samantha/events.rpy:6961
translate russian samantha_event_D04_a9f859b1:
    "И я вижу, что она наконец начинает понимать, к чему я клоню."

# ch/samantha/events.rpy:6962
translate russian samantha_event_D04_ce7d7b3c:
    "Она соглашается не так быстро, как мне хотелось бы."

# ch/samantha/events.rpy:6963
translate russian samantha_event_D04_a73acdf8:
    "Но я решаю считать хорошим знаком то, что она всё ещё кивает."

# ch/samantha/events.rpy:6964
translate russian samantha_event_D04_95edc171:
    samantha.say "Наверное, ты прав, [lssb_samantha.hero_name()]."

# ch/samantha/events.rpy:6965
translate russian samantha_event_D04_bdfdc271:
    samantha.say "После того как ты рассказал, что он творил за моей спиной..."

# ch/samantha/events.rpy:6966
translate russian samantha_event_D04_f9fcd803:
    samantha.say "Я ведь могла просто пойти и трахнуться с кем угодно ему назло."

# ch/samantha/events.rpy:6967
translate russian samantha_event_D04_19b4f22c:
    "От этого признания у меня щемит в груди; надеюсь, оно означает именно то, что я думаю."

# ch/samantha/events.rpy:6968
translate russian samantha_event_D04_e87d1ac3:
    samantha.say "Всё, что между нами произошло, было не только из ненависти к Райану."

# ch/samantha/events.rpy:6969
translate russian samantha_event_D04_bdd025bc:
    samantha.say "Мы ещё и поняли, что именно нам с тобой следовало быть вместе."

# ch/samantha/events.rpy:6970
translate russian samantha_event_D04_374386d6:
    "Теперь киваю уже я, стараясь показать Сэм, что полностью с ней согласен."

# ch/samantha/events.rpy:6971
translate russian samantha_event_D04_7fd52cae:
    mike.say "Вот почему я и хочу поговорить о нём."

# ch/samantha/events.rpy:6972
translate russian samantha_event_D04_3fe74f00:
    mike.say "О том, что ты всё ещё носишь его кольцо."

# ch/samantha/events.rpy:6973
translate russian samantha_event_D04_e7680f85:
    "Сэм невольно опускает взгляд на обручальное кольцо у себя на пальце — символ их брака."

# ch/samantha/events.rpy:6974
translate russian samantha_event_D04_511ad161:
    "Я чувствую себя мудаком, поднимая эту тему вот так, но какой у меня выбор?"

# ch/samantha/events.rpy:6975
translate russian samantha_event_D04_d87322dd:
    "Сейчас Сэм скрывает от Райана свои настоящие чувства к нему."

# ch/samantha/events.rpy:6976
translate russian samantha_event_D04_7f4a3554:
    "И заодно держит в тайне наши отношения."

# ch/samantha/events.rpy:6978
translate russian samantha_event_D04_5473281f:
    mike.say "Я понимаю, это трудно, Кексик."

# ch/samantha/events.rpy:6980
translate russian samantha_event_D04_26c30f99:
    mike.say "Я понимаю, это трудно, Сэм."

# ch/samantha/events.rpy:6981
translate russian samantha_event_D04_f9738d73:
    mike.say "Но пока мы всё скрываем, у нас просто связь на стороне."

# ch/samantha/events.rpy:6982
translate russian samantha_event_D04_999de463:
    mike.say "А я... хочу, чтобы между нами было нечто большее."

# ch/samantha/events.rpy:6984
translate russian samantha_event_D04_321ccec9:
    mike.say "Я хочу, чтобы ты ушла от него, Кексик."

# ch/samantha/events.rpy:6986
translate russian samantha_event_D04_c6bc4619:
    mike.say "Я хочу, чтобы ты ушла от него, Сэм."

# ch/samantha/events.rpy:6987
translate russian samantha_event_D04_f75b2cba:
    "Сэм некоторое время смотрит на меня, а потом отводит взгляд, не желая встречаться со мной глазами."

# ch/samantha/events.rpy:6989
translate russian samantha_event_D04_1a54faf3:
    samantha.say "Я всё это понимаю."

# ch/samantha/events.rpy:6990
translate russian samantha_event_D04_665c18f9:
    samantha.say "Конечно, понимаю!"

# ch/samantha/events.rpy:6991
translate russian samantha_event_D04_3b1970a6:
    "Прежде чем продолжить, она тяжело вздыхает."

# ch/samantha/events.rpy:6992
translate russian samantha_event_D04_ea30abde:
    samantha.say "Наверное, мне просто было слишком весело хоть раз самой нарушать правила."

# ch/samantha/events.rpy:6993
translate russian samantha_event_D04_fa3e36f1:
    samantha.say "Может, я немного увлеклась и слишком вжилась в роль плохой девочки?"

# ch/samantha/events.rpy:6994
translate russian samantha_event_D04_41b89217:
    samantha.say "И я понимаю, что не должна так легко продолжать врать Райану."

# ch/samantha/events.rpy:6995
translate russian samantha_event_D04_49ff713f:
    samantha.say "Может, я пока просто до этого не дошла, потому что нам так хорошо за его спиной."

# ch/samantha/events.rpy:6996
translate russian samantha_event_D04_3375bc26:
    samantha.say "Может, когда всё закончится официально, я даже смотреть на него не смогу..."

# ch/samantha/events.rpy:6997
translate russian samantha_event_D04_fa6ea699:
    mike.say "Значит, ты это сделаешь?"

# ch/samantha/events.rpy:6998
translate russian samantha_event_D04_d10590e4:
    mike.say "Ты говоришь, что порвёшь с ним?"

# ch/samantha/events.rpy:7000
translate russian samantha_event_D04_8ebaec64:
    "Сэм снова поворачивается ко мне и смотрит прямо в глаза; её лицо спокойно и сдержанно."

# ch/samantha/events.rpy:7002
translate russian samantha_event_D04_cf919bd0:
    samantha.say "Я говорю, что подумаю об этом."

# ch/samantha/events.rpy:7003
translate russian samantha_event_D04_868fabb8:
    samantha.say "И я правда подумаю, [lssb_samantha.hero_name()]."

# ch/samantha/events.rpy:7004
translate russian samantha_event_D04_b0752676:
    samantha.say "Мне просто нужно немного времени, вот и всё."

# ch/samantha/events.rpy:7005
translate russian samantha_event_D04_4c39a7e2:
    "Этими словами она недвусмысленно даёт понять, что тема закрыта и обсуждать больше нечего."

# ch/samantha/events.rpy:7006
translate russian samantha_event_D04_f6dd6642:
    "Мы переходим к менее напряжённым и неловким темам, но я всё равно гадаю, как она в итоге поступит."

# ch/samantha/events.rpy:7007
translate russian samantha_event_D04_a79f78b6:
    "И надеюсь, что наши представления о правильном решении совпадут."

# ch/samantha/events.rpy:7018
translate russian samantha_event_D05_fed01ec2:
    samantha.say "Эй, [lssb_samantha.hero_name()], чем занимаешься?"

# ch/samantha/events.rpy:7019
translate russian samantha_event_D05_9ce20856:
    samantha.say "Ну же!!! Открой входную дверь и впусти меня!"

# ch/samantha/events.rpy:7024
translate russian samantha_event_D05_a7dc79c5:
    "Я добираюсь до двери и открываю её прежде, чем Сэм успевает ответить."

# ch/samantha/events.rpy:7025
translate russian samantha_event_D05_a386704b:
    samantha.say "Ну что, не пригласишь меня войти?"

# ch/samantha/events.rpy:7026
translate russian samantha_event_D05_3f510b35:
    mike.say "Э-э, да... конечно."

# ch/samantha/events.rpy:7031
translate russian samantha_event_D05_e7e5ac5f:
    "Сэм торопит меня в спальню, словно ей уже совершенно невтерпёж."

# ch/samantha/events.rpy:7033
translate russian samantha_event_D05_dc06389d:
    "И я спешу за ней, думая ровно о том же."

# ch/samantha/events.rpy:7034
translate russian samantha_event_D05_94abc61e:
    "Но вдруг замираю на месте: в голову приходит одна мысль."

# ch/samantha/events.rpy:7035
translate russian samantha_event_D05_fc579c2d:
    "К чему всё это сейчас ведёт?"

# ch/samantha/events.rpy:7036
translate russian samantha_event_D05_24646c76:
    "Мы сейчас трахнемся, потому что без ума друг от друга?"

# ch/samantha/events.rpy:7037
translate russian samantha_event_D05_b1903317:
    "Или Сэм снова использует меня, чтобы отомстить Райану?"

# ch/samantha/events.rpy:7039
translate russian samantha_event_D05_9ad836fa:
    "Возможно, почувствовав моё беспокойство, она тоже останавливается и оглядывается через плечо."

# ch/samantha/events.rpy:7041
translate russian samantha_event_D05_adbd371b:
    samantha.say "Эй, [lssb_samantha.hero_name()]... что такое?"

# ch/samantha/events.rpy:7042
translate russian samantha_event_D05_97c6c0e4:
    mike.say "А... ничего."

# ch/samantha/events.rpy:7044
translate russian samantha_event_D05_5bded8f2:
    samantha.say "Если бы ничего, ты бы не переживал!"

# ch/samantha/events.rpy:7045
translate russian samantha_event_D05_d1af2ec1:
    mike.say "Ну... вся эта история с Райаном, понимаешь?"

# ch/samantha/events.rpy:7046
translate russian samantha_event_D05_995601cf:
    "Сэм улыбается и качает головой."

# ch/samantha/events.rpy:7047
translate russian samantha_event_D05_e214cab9:
    samantha.say "Давай подумаешь о нём потом, ладно?"

# ch/samantha/events.rpy:7048
translate russian samantha_event_D05_d36b6060:
    samantha.say "Хотя бы ближайшие пару минут не думай!"

# ch/samantha/events.rpy:7049
translate russian samantha_event_D05_cad6f525:
    "В том, как она произносит «минут», есть что-то, что выдёргивает меня из мрачных мыслей."

# ch/samantha/events.rpy:7050
translate russian samantha_event_D05_9fee4885:
    mike.say "Погоди... что... в смысле «минут»?!"

# ch/samantha/events.rpy:7051
translate russian samantha_event_D05_714a8c05:
    mike.say "Ты это намекаешь на мою выносливость?"

# ch/samantha/events.rpy:7053
translate russian samantha_event_D05_dcfd4143:
    "Сэм посмеивается и отводит взгляд, оставляя мой вопрос без ответа."

# ch/samantha/events.rpy:7054
translate russian samantha_event_D05_ef967a88:
    samantha.say "Может, да... а может, нет."

# ch/samantha/events.rpy:7055
translate russian samantha_event_D05_13ff3f0b:
    samantha.say "Может, тебе стоит доказать, что я ошибаюсь..."

# ch/samantha/events.rpy:7056
translate russian samantha_event_D05_c76c02fc:
    "Послушайте, я прекрасно понимаю, что она делает, ясно?"

# ch/samantha/events.rpy:7057
translate russian samantha_event_D05_64dcc313:
    "Какой бы милой и скромной Сэм ни казалась, невинной простушкой её не назовёшь."

# ch/samantha/events.rpy:7058
translate russian samantha_event_D05_4448cdec:
    "Я вижу, когда она пытается заставить меня плясать под свою дудку."

# ch/samantha/events.rpy:7059
translate russian samantha_event_D05_579f884f:
    "Проблема лишь в том, что ей удаётся заставить и меня захотеть того же!"

# ch/samantha/events.rpy:7063
translate russian samantha_event_D05_589878cc:
    "Я некоторое время стою на месте, а Сэм поворачивается ко мне спиной и идёт к кровати."

# ch/samantha/events.rpy:7065
translate russian samantha_event_D05_abd6936e:
    "На ходу она начинает раздеваться, отбрасывая одежду в сторону."

# ch/samantha/events.rpy:7067
translate russian samantha_event_D05_a1426f46:
    "К кровати она подходит совершенно голая, одетая лишь в ту же улыбку."

# ch/samantha/events.rpy:7068
translate russian samantha_event_D05_111587f5:
    "Забыть только что увиденное я уже никак не могу."

# ch/samantha/events.rpy:7069
translate russian samantha_event_D05_3d561a07:
    "В конце концов, я всего лишь человек."

# ch/samantha/events.rpy:7070
translate russian samantha_event_D05_35872e58:
    "И вот я снова спешу за Сэм, торопливо сдирая с себя одежду."

# ch/samantha/events.rpy:7071
translate russian samantha_event_D05_1f02f6db:
    "Она замечает, какое впечатление на меня произвела, и довольно хихикает."

# ch/samantha/events.rpy:7076
translate russian samantha_event_D05_c20bfaff:
    "Но стоит мне добраться до неё, как я прижимаюсь губами к её губам."

# ch/samantha/events.rpy:7077
translate russian samantha_event_D05_fe04e428:
    "Её смешок мгновенно стихает, а уже через секунду она отвечает на поцелуй."

# ch/samantha/events.rpy:7078
translate russian samantha_event_D05_1da29092:
    "Сэм прижимается ко мне и крепко обнимает."

# ch/samantha/events.rpy:7079
translate russian samantha_event_D05_cf83b2dc:
    "Тепло её кожи, соприкасающейся с моей, невероятно приятно."

# ch/samantha/events.rpy:7080
translate russian samantha_event_D05_0a686788:
    "А мягкость её тела не сравнить ни с чем, что я могу вообразить."

# ch/samantha/events.rpy:7081
translate russian samantha_event_D05_03e7e84e:
    "Но от этой мягкости я твердею — и весьма быстро."

# ch/samantha/events.rpy:7082
translate russian samantha_event_D05_f674245d:
    "Я чувствую, как Сэм опускает руку и начинает гладить мой твердеющий член; я резко вдыхаю, прерывая поцелуй."

# ch/samantha/events.rpy:7086
translate russian samantha_event_D05_52395826:
    samantha.say "М-м-м..."

# ch/samantha/events.rpy:7087
translate russian samantha_event_D05_9e5919a2:
    samantha.say "Что это тут у нас?"

# ch/samantha/events.rpy:7088
translate russian samantha_event_D05_f1d8a63c:
    mike.say "Эм..."

# ch/samantha/events.rpy:7089
translate russian samantha_event_D05_2a6a950c:
    mike.say "Тебе... нравится на ощупь?"

# ch/samantha/events.rpy:7090
translate russian samantha_event_D05_09f049c6:
    samantha.say "М-м... ещё как!"

# ch/samantha/events.rpy:7091
translate russian samantha_event_D05_0a0e862d:
    samantha.say "Интересно только, как приятно будет ощутить его внутри..."

# ch/samantha/events.rpy:7092
translate russian samantha_event_D05_2c866321:
    "Иногда изображать из себя уверенного жеребца просто невозможно, как ни старайся!"

# ch/samantha/events.rpy:7093
translate russian samantha_event_D05_6ac66cf5:
    "Я нервно сглатываю, начинаю чаще дышать и чувствую, как краснеют щёки."

# ch/samantha/events.rpy:7094
translate russian samantha_event_D05_259dc5e0:
    "Сознание того, что Сэм хочет ощутить мой член внутри себя, до сих пор неизменно действует на меня именно так."

# ch/samantha/events.rpy:7095
translate russian samantha_event_D05_8597ac8a:
    "Мне остаётся только идти за ней: одной рукой она по-прежнему держит мой член, а другой берёт меня за запястье."

# ch/samantha/events.rpy:7096
translate russian samantha_event_D05_414eb25a:
    "Сэм тянет меня за собой к кровати, а затем и на неё."

# ch/samantha/events.rpy:7097
translate russian samantha_event_D05_e91f9243:
    "Всё ещё не выпуская мой член, она собирается лечь на бок."

# ch/samantha/events.rpy:7098
translate russian samantha_event_D05_090d2dc8:
    "Но как раз в этот момент ко мне возвращается немного самообладания."

# ch/samantha/events.rpy:7099
translate russian samantha_event_D05_5972520d:
    "И почти сразу я понимаю, чего хочу и как этого добиться."

# ch/samantha/events.rpy:7103
translate russian samantha_event_D05_0a5c3714:
    "Звук, с которым мои ладони хватают Сэм за попку, оказывается громче, чем я ожидал."

# ch/samantha/events.rpy:7104
translate russian samantha_event_D05_42c28f01:
    "Но не громче её испуганного вскрика."

# ch/samantha/events.rpy:7105
translate russian samantha_event_D05_4ff0c761:
    "На руку мне и то, что от неожиданности она выпускает мой член."

# ch/samantha/events.rpy:7106
translate russian samantha_event_D05_987cbda7:
    "Благодаря этому я могу притянуть её назад, проталкивая его между ягодицами."

# ch/samantha/events.rpy:7107
translate russian samantha_event_D05_bed61341:
    "Сэм снова вскрикивает, наверное, не зная, куда именно я собираюсь его засунуть."

# ch/samantha/events.rpy:7108
translate russian samantha_event_D05_49ac6426:
    "А её неуверенность только добавляет мне удовольствия."

# ch/samantha/events.rpy:7109
translate russian samantha_event_D05_a7978ac6:
    "Так что, когда я наконец сдаюсь и раскрываю свои намерения, она уже более чем готова."

# ch/samantha/events.rpy:7110
translate russian samantha_event_D05_1756fa12:
    "Пару секунд я просто трусь головкой о киску Сэм."

# ch/samantha/events.rpy:7111
translate russian samantha_event_D05_a14820c1:
    "Она тихонько стонет, когда головка скользит вверх и вниз по влажным губам, и оглядывается через плечо."

# ch/samantha/events.rpy:7112
translate russian samantha_event_D05_ca0bfb3b:
    "Я уже вижу, как в её глазах разгорается желание, как ей хочется, чтобы я пошёл дальше."

# ch/samantha/events.rpy:7114
translate russian samantha_event_D05_33e14ca5:
    "И когда я начинаю входить в неё, рот Сэм раскрывается одновременно с её киской."

# ch/samantha/events.rpy:7115
translate russian samantha_event_D05_c19d22fe:
    "Сколько бы мы ни занимались этим, я всё равно не могу поверить, как же с ней хорошо."

# ch/samantha/events.rpy:7118
translate russian samantha_event_D05_40d079de:
    "Я ощущаю, насколько тяжелее стало тело Сэм из-за большого округлившегося живота."

# ch/samantha/events.rpy:7119
translate russian samantha_event_D05_44ef018d:
    "А её груди свисают вниз, уже увеличившиеся в ожидании грядущего; из них уже сочится молоко."

# ch/samantha/events.rpy:7121
translate russian samantha_event_D05_b16a9662:
    "Когда я украдкой поглядывал на одетую Сэм, то и представить не мог, что её тело может выглядеть ещё прекраснее."

# ch/samantha/events.rpy:7122
translate russian samantha_event_D05_353f0cc5:
    "Но голая она просто невероятна."

# ch/samantha/events.rpy:7124
translate russian samantha_event_D05_7f9e6276:
    samantha.say "Ох... [lssb_samantha.hero_name()]..."

# ch/samantha/events.rpy:7125
translate russian samantha_event_D05_952f39a5:
    samantha.say "Как же мне хорошо... ТАК хорошо чувствовать тебя внутри!"

# ch/samantha/events.rpy:7126
translate russian samantha_event_D05_63e405a5:
    samantha.say "Ты... ты и правда... показал мне... как это приятно!"

# ch/samantha/events.rpy:7127
translate russian samantha_event_D05_67237cd1:
    samantha.say "Я не хочу, чтобы ты останавливался... делай это со мной вечно!"

# ch/samantha/events.rpy:7128
translate russian samantha_event_D05_209b4240:
    "Господи, вот ещё одна вещь, в которой она оказалась неожиданно хороша!"

# ch/samantha/events.rpy:7129
translate russian samantha_event_D05_11bfb8ca:
    "Пошлости из этих безупречных губ звучат так... так правильно..."

# ch/samantha/events.rpy:7130
translate russian samantha_event_D05_f93e66e0:
    "Своими словами Сэм уже завела меня настолько, что о неспешности не может быть и речи."

# ch/samantha/events.rpy:7131
translate russian samantha_event_D05_0348d25c:
    "И вскоре я трахаю её так сильно, как только могу."

# ch/samantha/events.rpy:7132
translate russian samantha_event_D05_1711119d:
    "Но она ничем не показывает, что ей слишком тяжело."

# ch/samantha/events.rpy:7133
translate russian samantha_event_D05_f9cfc973:
    "Напротив, принимает всё, что я могу ей дать, не издавая ни единого звука недовольства."

# ch/samantha/events.rpy:7134
translate russian samantha_event_D05_49d6e223:
    "Тело Сэм покрывается потом и становится скользким, так что удерживать её всё труднее."

# ch/samantha/events.rpy:7135
translate russian samantha_event_D05_b1715612:
    "Поэтому, продолжая вколачиваться в неё, я двигаюсь всё напряжённее и отчаяннее."

# ch/samantha/events.rpy:7136
translate russian samantha_event_D05_b686ed15:
    "То и дело мне приходится стараться, чтобы она не выскользнула из моих рук."

# ch/samantha/events.rpy:7137
translate russian samantha_event_D05_d7dc573b:
    "А если не из рук, то с моего члена."

# ch/samantha/events.rpy:7138
translate russian samantha_event_D05_e35d7791:
    "Пошлые разговоры тоже прекращаются, сменившись громкими стонами Сэм."

# ch/samantha/events.rpy:7139
translate russian samantha_event_D05_ea3f1eeb:
    "При этом она смотрит на меня через плечо."

# ch/samantha/events.rpy:7140
translate russian samantha_event_D05_f8f1a57f:
    "Каждый мой толчок словно заставляет её стонать ещё сильнее."

# ch/samantha/events.rpy:7141
translate russian samantha_event_D05_4c439acd:
    "Вскоре я понимаю, что долго так продолжаться уже не может."

# ch/samantha/events.rpy:7142
translate russian samantha_event_D05_55916c4f:
    "Я закусываю губу, чувствуя, что скоро кончу."

# ch/samantha/events.rpy:7143
translate russian samantha_event_D05_0770f751:
    "Странно, но на Сэм это, похоже, действует сильнее, чем на меня."

# ch/samantha/events.rpy:7144
translate russian samantha_event_D05_8663595d:
    "До этого ей вполне нравилось стоять на четвереньках и принимать мои толчки."

# ch/samantha/events.rpy:7145
translate russian samantha_event_D05_5d887823:
    "Но теперь она начинает извиваться передо мной и скользить из стороны в сторону."

# ch/samantha/events.rpy:7146
translate russian samantha_event_D05_785096d4:
    "В отличие от прежних попыток, теперь я никак не могу удержать её скользкое тело."

# ch/samantha/events.rpy:7150
translate russian samantha_event_D05_7275eebd:
    "Когда Сэм соскальзывает с моего члена, я издаю разочарованный звук."

# ch/samantha/events.rpy:7151
translate russian samantha_event_D05_abf32e09:
    "Но она либо не замечает моего огорчения, либо предпочитает его проигнорировать."

# ch/samantha/events.rpy:7152
translate russian samantha_event_D05_12ba3593:
    "Вместо этого она толкает меня назад, не спрашивая разрешения и ничего не объясняя."

# ch/samantha/events.rpy:7153
translate russian samantha_event_D05_446507fc:
    "И тут я вижу, как она подаётся грудью вперёд, и чувствую, как её груди обхватывают мой член."

# ch/samantha/events.rpy:7157
translate russian samantha_event_D05_c62c3063:
    "За считаные секунды Сэм устраивает его именно там, где хочет."

# ch/samantha/events.rpy:7158
translate russian samantha_event_D05_ee712e1f:
    "А затем начинает сжимать груди вместе, массируя мой член."

# ch/samantha/events.rpy:7159
translate russian samantha_event_D05_cf246498:
    "Даже после того, как я только что побывал внутри неё, ощущение всё равно очень сильное."

# ch/samantha/events.rpy:7160
translate russian samantha_event_D05_835fef5c:
    "Мой и без того чувствительный член теперь зажат между мягкими подушечками её грудей."

# ch/samantha/events.rpy:7161
translate russian samantha_event_D05_75c90163:
    "Мне остаётся лишь смотреть вниз широко раскрытыми глазами, приоткрыв рот."

# ch/samantha/events.rpy:7162
translate russian samantha_event_D05_fb89fcb6:
    "Возможно, я необъективен, но грудь Сэм, наверное, самая потрясающая из всех, что я видел."

# ch/samantha/events.rpy:7163
translate russian samantha_event_D05_382890e8:
    "Не слишком маленькая и не слишком большая — в самый раз, да ещё и безупречной формы."

# ch/samantha/events.rpy:7164
translate russian samantha_event_D05_ace2675d:
    "И теперь она обжимает мой член!"

# ch/samantha/events.rpy:7165
translate russian samantha_event_D05_2a1dad1d:
    "После того как я побывал внутри Сэм, он и так чувствителен до предела."

# ch/samantha/events.rpy:7166
translate russian samantha_event_D05_c6aa6ce6:
    "Поэтому совсем скоро приближающийся оргазм возвращается с удвоенной силой."

# ch/samantha/events.rpy:7169
translate russian samantha_event_D05_0167c8b9:
    mike.say "Ох... Кексик..."

# ch/samantha/events.rpy:7171
translate russian samantha_event_D05_e18bab65:
    mike.say "Ох... Сэм..."

# ch/samantha/events.rpy:7172
translate russian samantha_event_D05_110eb8e0:
    mike.say "Ох... блядь... блядь!"

# ch/samantha/events.rpy:7173
translate russian samantha_event_D05_89e35d91:
    "И тут я вижу, как головка моего члена появляется между её грудями."

# ch/samantha/events.rpy:7175
translate russian samantha_event_D05_745c6b2b:
    "Сперма бьёт Сэм прямо в лицо, и она даже не пытается уклониться."

# ch/samantha/events.rpy:7177
translate russian samantha_event_D05_638c8620:
    "Я задерживаю дыхание, пока блестящие белые полоски покрывают её лицо."

# ch/samantha/events.rpy:7178
translate russian samantha_event_D05_ff0a9c6b:
    "Для меня всё происходит словно в невероятно замедленной съёмке под одну из тех волнующих классических мелодий."

# ch/samantha/events.rpy:7179
translate russian samantha_event_D05_df925efc:
    "А Сэм принимает всё, что я могу ей дать, ни разу даже не вздрогнув."

# ch/samantha/events.rpy:7183
translate russian samantha_event_D05_3dcfbcab:
    "Потом я валюсь на кровать, измотанный и совершенно опустошённый."

# ch/samantha/events.rpy:7184
translate russian samantha_event_D05_f78fc9f7:
    "Я тяжело дышу, сердце колотится; я смотрю, как Сэм тянется за чем-то на полу возле кровати."

# ch/samantha/events.rpy:7185
translate russian samantha_event_D05_e9fa183e:
    "И тут моё сердце на миг замирает: я понимаю, что это её телефон."

# ch/samantha/events.rpy:7187
translate russian samantha_event_D05_2a0addc0:
    "Что, чёрт возьми, она собирается сделать на этот раз?"

# ch/samantha/events.rpy:7188
translate russian samantha_event_D05_e265fa9c:
    "Позвонить Райану и снова поговорить с ним о том, где она якобы находится?"

# ch/samantha/events.rpy:7189
translate russian samantha_event_D05_5569aba7:
    "Мило болтать с ним, пока моя сперма стекает по её лицу?"

# ch/samantha/events.rpy:7191
translate russian samantha_event_D05_f4e2552a:
    "Я не смею пошевелиться, когда она поднимает телефон и фотографирует нас обоих."

# ch/samantha/events.rpy:7192
translate russian samantha_event_D05_3411d541:
    "Моя улыбка выглядит немного натянутой, а с её улыбающихся губ капает сперма."

# ch/samantha/events.rpy:7193
translate russian samantha_event_D05_facdcf79:
    "Потом я замечаю, что она что-то печатает в телефоне, и придвигаюсь поближе, чтобы прочитать."

# ch/samantha/events.rpy:7194
translate russian samantha_event_D05_a79b4bc7:
    "Я сразу вижу, что это сообщение и что она отправляет его Райану."

# ch/samantha/events.rpy:7195
translate russian samantha_event_D05_5a972ca1:
    "Но затем я разбираю слова и чувствую, как с плеч сваливается огромная тяжесть."

# ch/samantha/events.rpy:7196
translate russian samantha_event_D05_ecff23d2:
    "Вообще-то от того, что пишет Сэм, мне хочется взлететь!"

# ch/samantha/events.rpy:7198
translate russian samantha_event_D05_4fcac665:
    "«Милый, — пишет она, — я хочу развестись!»"

# ch/samantha/events.rpy:7199
translate russian samantha_event_D05_1c7f74ea:
    "Нажав «Отправить», Сэм поворачивается ко мне и улыбается."

# ch/samantha/events.rpy:7200
translate russian samantha_event_D05_9960c360:
    samantha.say "Вот видишь? Я же сказала: подумаешь о нём потом."

# ch/samantha/events.rpy:7202
translate russian samantha_event_D05_2bfc4565:
    samantha.say "А совсем скоро нам обоим вообще больше не придётся о нём думать!"

# ch/samantha/events.rpy:7215
translate russian samantha_event_D05B_34b0398b:
    "Сегодня днём я не ждал гостей, но звонок в дверь всё равно меня не удивляет."

# ch/samantha/events.rpy:7219
translate russian samantha_event_D05B_c5d13568:
    "Последние пару выходных Сэм довольно регулярно заходила ко мне немного развлечься."

# ch/samantha/events.rpy:7220
translate russian samantha_event_D05B_7d0d7775:
    "Так что, когда я вскакиваю и спешу открыть дверь, увидеть её на пороге вполне ожидаемо."

# ch/samantha/events.rpy:7222
translate russian samantha_event_D05B_a6b3a406:
    mike.say "Привет, Кексик!"

# ch/samantha/events.rpy:7224
translate russian samantha_event_D05B_5aff5688:
    mike.say "Привет, Сэм!"

# ch/samantha/events.rpy:7225
translate russian samantha_event_D05B_55181bf6:
    samantha.say "[lssb_samantha.hero_name()], привет!"

# ch/samantha/events.rpy:7227
translate russian samantha_event_D05B_c9abb95c:
    natalie.say "Привет!"

# ch/samantha/events.rpy:7228
translate russian samantha_event_D05B_3c73402e:
    "Вот ещё один голос я услышать никак не ожидал."

# ch/samantha/events.rpy:7229
translate russian samantha_event_D05B_040f83b5:
    "И, наверное, удивление написано у меня на лице."

# ch/samantha/events.rpy:7230
translate russian samantha_event_D05B_534e863d:
    samantha.say "А, [lssb_samantha.hero_name()], ты ведь помнишь Натали?"

# ch/samantha/events.rpy:7234
translate russian samantha_event_D05B_7001595a:
    "Тут из-за спины Сэм кто-то выглядывает."

# ch/samantha/events.rpy:7235
translate russian samantha_event_D05B_7d0f42df:
    "Я сразу узнаю брюнетку, которая приветливо улыбается и машет мне рукой."

# ch/samantha/events.rpy:7236
translate russian samantha_event_D05B_f570081f:
    "Она была одной из подружек невесты на свадьбе Сэм и Райана."

# ch/samantha/events.rpy:7237
translate russian samantha_event_D05B_2e4b08c2:
    "Помню, как танцевал с ней на свадебном приёме."

# ch/samantha/events.rpy:7238
translate russian samantha_event_D05B_820b0509:
    "Но помню и то, чем она занималась с Райаном за спиной Сэм."

# ch/samantha/events.rpy:7240
translate russian samantha_event_D05B_d9f907f8:
    mike.say "Да, я её помню, Кексик."

# ch/samantha/events.rpy:7242
translate russian samantha_event_D05B_1254e823:
    mike.say "Да, я её помню, Сэм."

# ch/samantha/events.rpy:7243
translate russian samantha_event_D05B_51b618dc:
    samantha.say "Отлично, [lssb_samantha.hero_name()]."

# ch/samantha/events.rpy:7244
translate russian samantha_event_D05B_22e5ec08:
    samantha.say "Ну... ты пригласишь нас войти или нет?"

# ch/samantha/events.rpy:7245
translate russian samantha_event_D05B_593d4ac1:
    mike.say "Конечно, конечно..."

# ch/samantha/events.rpy:7246
translate russian samantha_event_D05B_ff743231:
    mike.say "Совсем забыл о приличиях!"

# ch/samantha/events.rpy:7247
translate russian samantha_event_D05B_3757fd40:
    "Я отступаю, пропуская Сэм и Натали внутрь, и закрываю за ними дверь."

# ch/samantha/events.rpy:7252
translate russian samantha_event_D05B_48630fdf:
    "Но когда Натали уходит в гостиную, я придерживаю Сэм за руку."

# ch/samantha/events.rpy:7254
translate russian samantha_event_D05B_3909ba22:
    mike.say "Кексик..."

# ch/samantha/events.rpy:7256
translate russian samantha_event_D05B_7295c41f:
    mike.say "Сэм..."

# ch/samantha/events.rpy:7257
translate russian samantha_event_D05B_19986628:
    mike.say "Что здесь происходит?"

# ch/samantha/events.rpy:7258
translate russian samantha_event_D05B_ae07efc5:
    mike.say "Это же та девушка, с которой Райан тебе изменял!"

# ch/samantha/events.rpy:7260
translate russian samantha_event_D05B_7782a206:
    samantha.say "Думаешь, я не знаю, [lssb_samantha.hero_name()]?"

# ch/samantha/events.rpy:7261
translate russian samantha_event_D05B_cbf0cfec:
    samantha.say "Она прикидывалась моей лучшей подругой."

# ch/samantha/events.rpy:7262
translate russian samantha_event_D05B_5e7026fe:
    samantha.say "Использовала меня."

# ch/samantha/events.rpy:7263
translate russian samantha_event_D05B_059209ba:
    samantha.say "А потом воткнула нож в спину!"

# ch/samantha/events.rpy:7264
translate russian samantha_event_D05B_3ab90bc8:
    mike.say "Так зачем она теперь здесь?!"

# ch/samantha/events.rpy:7266
translate russian samantha_event_D05B_1a1e48a7:
    samantha.say "Натали хочет всё, что есть у меня, [lssb_samantha.hero_name()]."

# ch/samantha/events.rpy:7267
translate russian samantha_event_D05B_b7ede644:
    samantha.say "Поэтому я рассказала ей, что у нас с тобой происходит."

# ch/samantha/events.rpy:7268
translate russian samantha_event_D05B_32ff24f2:
    samantha.say "Она сразу ухватилась за возможность присоединиться."

# ch/samantha/events.rpy:7270
translate russian samantha_event_D05B_68cb223b:
    samantha.say "Теперь наша очередь её использовать."

# ch/samantha/events.rpy:7272
translate russian samantha_event_D05B_96c20e85:
    mike.say "И как ты это представляешь, Кексик?"

# ch/samantha/events.rpy:7274
translate russian samantha_event_D05B_09809b52:
    mike.say "И как ты это представляешь, Сэм?"

# ch/samantha/events.rpy:7275
translate russian samantha_event_D05B_b75b6c9d:
    samantha.say "Мы вдвоём её оттрахаем, а потом отправим Райану откровенные снимки."

# ch/samantha/events.rpy:7276
translate russian samantha_event_D05B_2cfed8b9:
    samantha.say "А потом я вышвырну её из своей жизни!"

# ch/samantha/events.rpy:7279
translate russian samantha_event_D05B_06a80110:
    "Не могу поверить, что это говорит Сэм."

# ch/samantha/events.rpy:7280
translate russian samantha_event_D05B_2d4d324a:
    "Да, я трахал её за спиной Райана."

# ch/samantha/events.rpy:7281
translate russian samantha_event_D05B_90b00cfa:
    "Но я любил её задолго до их свадьбы."

# ch/samantha/events.rpy:7282
translate russian samantha_event_D05B_0769b9a6:
    "А это просто месть ради мести, ради того, чтобы причинить кому-то боль."

# ch/samantha/events.rpy:7284
translate russian samantha_event_D05B_9ef7a991:
    mike.say "Послушай себя, Кексик."

# ch/samantha/events.rpy:7286
translate russian samantha_event_D05B_e0bf4b9c:
    mike.say "Послушай себя, Сэм."

# ch/samantha/events.rpy:7287
translate russian samantha_event_D05B_ac04cc04:
    mike.say "Это на тебя не похоже."

# ch/samantha/events.rpy:7289
translate russian samantha_event_D05B_2f15ac03:
    samantha.say "А?.."

# ch/samantha/events.rpy:7290
translate russian samantha_event_D05B_ee9cc121:
    samantha.say "В каком смысле?"

# ch/samantha/events.rpy:7291
translate russian samantha_event_D05B_f1bc8fa4:
    mike.say "Я думал, достаточно было узнать, что Райан изменяет."

# ch/samantha/events.rpy:7292
translate russian samantha_event_D05B_69884b83:
    mike.say "Но и подумать не мог, что ты захочешь переплюнуть его в его же игре."

# ch/samantha/events.rpy:7293
translate russian samantha_event_D05B_5c60f9a7:
    samantha.say "Что это значит, [lssb_samantha.hero_name()]?"

# ch/samantha/events.rpy:7294
translate russian samantha_event_D05B_76a35c21:
    samantha.say "Ты говоришь, что не станешь этого делать?"

# ch/samantha/events.rpy:7297
translate russian samantha_event_D05B_0fed21f6:
    mike.say "Да, Кексик."

# ch/samantha/events.rpy:7299
translate russian samantha_event_D05B_255de3dc:
    mike.say "Да, Сэм."

# ch/samantha/events.rpy:7300
translate russian samantha_event_D05B_1415d527:
    mike.say "По-моему, это уже перебор."

# ch/samantha/events.rpy:7302
translate russian samantha_event_D05B_69b8f901:
    natalie.say "Сэм..."

# ch/samantha/events.rpy:7303
translate russian samantha_event_D05B_f59207e1:
    natalie.say "Что-то случилось?"

# ch/samantha/events.rpy:7304
translate russian samantha_event_D05B_a84c468a:
    "Не знаю, подслушала ли она разговор или просто устала ждать."

# ch/samantha/events.rpy:7305
translate russian samantha_event_D05B_fa414837:
    "Но мы оба оборачиваемся и видим Натали в дверях гостиной."

# ch/samantha/events.rpy:7306
translate russian samantha_event_D05B_a54bfc31:
    samantha.say "А... да."

# ch/samantha/events.rpy:7307
translate russian samantha_event_D05B_ffd90ef2:
    samantha.say "[lssb_samantha.hero_name()] только что сказал, что у него дела."

# ch/samantha/events.rpy:7308
translate russian samantha_event_D05B_9806b73a:
    natalie.say "А... понятно."

# ch/samantha/events.rpy:7310
translate russian samantha_event_D05B_5760206e:
    samantha.say "Это моя вина, Нэт."

# ch/samantha/events.rpy:7311
translate russian samantha_event_D05B_7a8ce8ce:
    samantha.say "Надо было сначала позвонить."

# ch/samantha/events.rpy:7312
translate russian samantha_event_D05B_7fa7ae0d:
    samantha.say "Вот что бывает, когда действуешь спонтанно!"

# ch/samantha/events.rpy:7315
translate russian samantha_event_D05B_97518ec3:
    "Уходя, Сэм бросает на меня красноречивый взгляд."

# ch/samantha/events.rpy:7316
translate russian samantha_event_D05B_c17b1e6a:
    "Помимо прочего, он обещает, что мы вскоре ещё об этом поговорим."

# ch/samantha/events.rpy:7318
translate russian samantha_event_D05B_74a0b19e:
    "От идеи, которую Сэм подкинула мне, у меня уже начинает вставать."

# ch/samantha/events.rpy:7319
translate russian samantha_event_D05B_82b59e33:
    "На мой взгляд, предложение весьма заманчивое."

# ch/samantha/events.rpy:7320
translate russian samantha_event_D05B_162044d6:
    "Возможность развлечься с парой горячих девушек."

# ch/samantha/events.rpy:7321
translate russian samantha_event_D05B_1710841e:
    "И заодно насолить Райану."

# ch/samantha/events.rpy:7322
translate russian samantha_event_D05B_61ea3e05:
    "Что тут может не нравиться?"

# ch/samantha/events.rpy:7324
translate russian samantha_event_D05B_a7f77b66:
    mike.say "По-моему, отлично, Кексик."

# ch/samantha/events.rpy:7326
translate russian samantha_event_D05B_a22e5b0b:
    mike.say "По-моему, отлично, Сэм."

# ch/samantha/events.rpy:7328
translate russian samantha_event_D05B_526b4612:
    samantha.say "Здорово, [lssb_samantha.hero_name()]."

# ch/samantha/events.rpy:7329
translate russian samantha_event_D05B_74256649:
    samantha.say "Я знала, что могу рассчитывать на твою помощь."

# ch/samantha/events.rpy:7334
translate russian samantha_event_D05B_2679340d:
    "Мы идём в гостиную, где нас ждёт Натали."

# ch/samantha/events.rpy:7335
translate russian samantha_event_D05B_cd4dde72:
    natalie.say "Мы..."

# ch/samantha/events.rpy:7336
translate russian samantha_event_D05B_8e993927:
    natalie.say "Он сказал..."

# ch/samantha/events.rpy:7337
translate russian samantha_event_D05B_4e4a5b4a:
    samantha.say "Не волнуйся, Нэт."

# ch/samantha/events.rpy:7338
translate russian samantha_event_D05B_5a8032d6:
    samantha.say "Всё в силе, всё в силе."

# ch/samantha/events.rpy:7340
translate russian samantha_event_D05B_2c2f2418:
    natalie.say "О... ура!"

# ch/samantha/events.rpy:7341
translate russian samantha_event_D05B_32aa1d31:
    natalie.say "Будет ТАК весело!"

# ch/samantha/events.rpy:7343
translate russian samantha_event_D05B_7c59205f:
    samantha.say "Конечно, Нэт."

# ch/samantha/events.rpy:7344
translate russian samantha_event_D05B_13cfdf60:
    samantha.say "Уж я позабочусь о том, чтобы каждый получил по заслугам!"

# ch/samantha/events.rpy:7348
translate russian samantha_event_D05B_fbc08756:
    "Поднимаясь по лестнице в мою комнату, я вопросительно смотрю на Сэм."

# ch/samantha/events.rpy:7349
translate russian samantha_event_D05B_d9870cea:
    "В этих словах столько скрытого смысла, что не верится, будто Натали ничего не заподозрит."

# ch/samantha/events.rpy:7353
translate russian samantha_event_D05B_ec08fc35:
    "Но Сэм лишь качает головой, отмахиваясь от моих опасений."

# ch/samantha/events.rpy:7354
translate russian samantha_event_D05B_a794c3ba:
    samantha.say "Нэт, ты просто ОБЯЗАНА попробовать, какой у нас [lssb_samantha.hero_name()] на вкус."

# ch/samantha/events.rpy:7355
translate russian samantha_event_D05B_ebc4c8d2:
    samantha.say "Поверь, его член куда лучше, чем у Райана!"

# ch/samantha/events.rpy:7360
translate russian samantha_event_D05B_43ce6f47:
    "Сэм произносит это сразу же, как за нами закрывается дверь."

# ch/samantha/events.rpy:7361
translate russian samantha_event_D05B_99350e22:
    "Больше уговаривать Натали не приходится."

# ch/samantha/events.rpy:7363
translate russian samantha_event_D05B_70b5d1f7:
    "Мгновение спустя она уже стоит на коленях и раздевается."

# ch/samantha/events.rpy:7365
translate russian samantha_event_D05B_a3a5affb:
    "Мы с Сэм как можно скорее следуем её примеру."

# ch/samantha/events.rpy:7366
translate russian samantha_event_D05B_4c7fde1c:
    "И уж мне-то не приходится прилагать усилий, чтобы оказаться на высоте."

# ch/samantha/events.rpy:7367
translate russian samantha_event_D05B_5e9dc8a1:
    "Натали и так довольно симпатичная."

# ch/samantha/events.rpy:7368
translate russian samantha_event_D05B_e53da1d1:
    "А под одеждой у неё ещё и подтянутое миниатюрное тело."

# ch/samantha/events.rpy:7369
translate russian samantha_event_D05B_005ea33a:
    "Пожалуй, я могу самую малость понять Райана..."

# ch/samantha/events.rpy:7370
translate russian samantha_event_D05B_17fef09a:
    samantha.say "Залезай на кровать, Нэт."

# ch/samantha/events.rpy:7371
translate russian samantha_event_D05B_881b23e6:
    samantha.say "На четвереньки, ладно?"

# ch/samantha/events.rpy:7372
translate russian samantha_event_D05B_68f7e038:
    "Мы оба оглядываемся на Сэм, а затем изумлённо смотрим ещё раз."

# ch/samantha/events.rpy:7373
translate russian samantha_event_D05B_5d9388d3:
    "Она только что закрепила у себя на поясе большой страпон."

# ch/samantha/events.rpy:7375
translate russian samantha_event_D05B_5a0a22d2:
    natalie.say "С... Сэм..."

# ch/samantha/events.rpy:7376
translate russian samantha_event_D05B_9b6040dc:
    natalie.say "Ч... что это?"

# ch/samantha/events.rpy:7378
translate russian samantha_event_D05B_07def1b3:
    "Сэм лишь улыбается и шлёпает по головке фаллоимитатора, так что тот качается из стороны в сторону."

# ch/samantha/events.rpy:7379
translate russian samantha_event_D05B_77a63940:
    samantha.say "А, эта мелочь?"

# ch/samantha/events.rpy:7381
translate russian samantha_event_D05B_29a81ee5:
    samantha.say "Мы с тобой, [lssb_samantha.hero_name()], ведь постоянно таким занимаемся."

# ch/samantha/events.rpy:7382
translate russian samantha_event_D05B_64b0f433:
    samantha.say "Но если тебе страшно..."

# ch/samantha/events.rpy:7383
translate russian samantha_event_D05B_5e1c714e:
    natalie.say "Нет... нет, Сэм."

# ch/samantha/events.rpy:7385
translate russian samantha_event_D05B_c3c98f99:
    natalie.say "Всё хорошо... правда!"

# ch/samantha/events.rpy:7393
translate russian samantha_event_D05B_85d9082e:
    "Я берусь за голову Натали и направляю член ей в рот."

# ch/samantha/events.rpy:7396
translate russian samantha_event_D05B_5903b5ba:
    "Одновременно я наблюдаю, как Сэм наносит смазку на фаллоимитатор."

# ch/samantha/events.rpy:7399
translate russian samantha_event_D05B_cff8c945:
    "Я качаю головой, глядя на неё, и стараюсь не рассмеяться над положением Натали."

# ch/samantha/events.rpy:7400
translate russian samantha_event_D05B_39788c28:
    "В ответ Сэм подмигивает мне, а затем хватается за ягодицы Натали."

# ch/samantha/events.rpy:7401
translate russian samantha_event_D05B_f6d959e6:
    "Ну что ж, похоже, мы действительно это сделаем!"

# ch/samantha/events.rpy:7402
translate russian samantha_event_D05B_57d8f0cd:
    "Поехали..."

# ch/samantha/events.rpy:7403
translate russian samantha_event_D05B_546a2216:
    "Мой член уже примерно наполовину во рту Натали."

# ch/samantha/events.rpy:7405
translate russian samantha_event_D05B_3efc9c33:
    "И тут Сэм приступает к делу с другой стороны."

# ch/samantha/events.rpy:7407
translate russian samantha_event_D05B_b11bd636:
    "Я чувствую толчок, когда она вводит фаллоимитатор в задницу Натали."

# ch/samantha/events.rpy:7410
translate russian samantha_event_D05B_3b5b9005:
    "От неожиданности та пытается вскрикнуть."

# ch/samantha/events.rpy:7414
translate russian samantha_event_D05B_2a9523a4:
    "Разумеется, на деле это лишь позволяет мне протолкнуть член ещё глубже."

# ch/samantha/events.rpy:7417
translate russian samantha_event_D05B_10ffc292:
    "Что я и делаю уже через мгновение."

# ch/samantha/events.rpy:7420
translate russian samantha_event_D05B_d3a530b3:
    "Натали ничего не остаётся, кроме как покориться."

# ch/samantha/events.rpy:7422
translate russian samantha_event_D05B_9c27c376:
    "Иначе она подавится членом, который сейчас заполняет её рот."

# ch/samantha/events.rpy:7424
translate russian samantha_event_D05B_36e9503d:
    "Я хватаю её за косу, чтобы она точно всё поняла."

# ch/samantha/events.rpy:7427
translate russian samantha_event_D05B_b6fa5c7f:
    "А Сэм с другой стороны продолжает вталкиваться ей в задницу."

# ch/samantha/events.rpy:7431
translate russian samantha_event_D05B_11e1abfa:
    "Вскоре мы входим в ритм, и Натали приходится его принять."

# ch/samantha/events.rpy:7433
translate russian samantha_event_D05B_e1c65c66:
    "Нужно отдать ей должное."

# ch/samantha/events.rpy:7434
translate russian samantha_event_D05B_4b8fc8ed:
    "Миниатюрная брюнетка ни разу не давится и не отшатывается."

# ch/samantha/events.rpy:7435
translate russian samantha_event_D05B_5fb5fd26:
    "Она принимает всё, что мы с Сэм можем ей дать."

# ch/samantha/events.rpy:7438
translate russian samantha_event_D05B_13f76996:
    "И я вижу, что Сэм готова на гораздо большее, чем я!"

# ch/samantha/events.rpy:7440
translate russian samantha_event_D05B_83ec9372:
    "Я просто наслаждаюсь губами и языком Натали вокруг моего члена."

# ch/samantha/events.rpy:7443
translate russian samantha_event_D05B_0db72929:
    "Но одного взгляда на Сэм достаточно, чтобы понять: она вымещает всю свою злость на заднице Натали."

# ch/samantha/events.rpy:7445
translate russian samantha_event_D05B_1ab2338a:
    "Она почти что вколачивает страпон в девушку, не давая ей ни секунды передышки."

# ch/samantha/events.rpy:7450
translate russian samantha_event_D05B_aaa39c0f:
    "От одного этого зрелища мне уже хочется кончить."

# ch/samantha/events.rpy:7452
translate russian samantha_event_D05B_7a0094a3:
    "Сэм, должно быть, замечает это по моему лицу и отчаянно качает головой."

# ch/samantha/events.rpy:7454
translate russian samantha_event_D05B_ba7bd215:
    samantha.say "Нет... ах..."

# ch/samantha/events.rpy:7455
translate russian samantha_event_D05B_264a773d:
    samantha.say "Ещё... не надо..."

# ch/samantha/events.rpy:7456
translate russian samantha_event_D05B_3d0976ad:
    "С этими словами она выдёргивает фаллоимитатор из задницы Натали."

# ch/samantha/events.rpy:7459
translate russian samantha_event_D05B_6f2de5ef:
    "Раздаётся почти комичный хлопок, и Натали валится на кровать."

# ch/samantha/events.rpy:7461
translate russian samantha_event_D05B_43d1b016:
    "Мой член выскальзывает изо рта Натали. Сэм тут же набрасывается на него."

# ch/samantha/events.rpy:7465
translate russian samantha_event_D05B_70cf3880:
    "Она принимается сосать так, словно от этого зависит её жизнь."

# ch/samantha/events.rpy:7468
translate russian samantha_event_D05B_54dbfd73:
    "Всё ещё ошеломлённой Натали остаётся лишь посасывать мои яйца и наблюдать."

# ch/samantha/events.rpy:7469
translate russian samantha_event_D05B_d1d3bb57:
    "И снова Сэм будто стремится что-то доказать."

# ch/samantha/events.rpy:7470
translate russian samantha_event_D05B_6daab3b2:
    "Она старается так, словно хочет показать, что во всём лучше Натали."

# ch/samantha/events.rpy:7476
translate russian samantha_event_D05B_b3db5cec:
    "Так что до оргазма я добираюсь очень быстро..."

# ch/samantha/events.rpy:7479
translate russian samantha_event_D05B_00ddc0a1:
    "Но едва ощутив сперму на языке, Сэм снова начинает двигаться."

# ch/samantha/events.rpy:7483
translate russian samantha_event_D05B_c3e87636:
    "Я ещё не успеваю понять, что происходит, а она уже ставит меня на ноги возле кровати."

# ch/samantha/events.rpy:7485
translate russian samantha_event_D05B_7cc4746d:
    "Они с Натали лежат передо мной на спине."

# ch/samantha/events.rpy:7487
translate russian samantha_event_D05B_ea42748e:
    "Только когда я начинаю кончать на них, я замечаю селфи-палку."

# ch/samantha/events.rpy:7489
translate russian samantha_event_D05B_85e79d1c:
    "Сэм снимает каждое мгновение, пока моя сперма льётся на их лица."

# ch/samantha/events.rpy:7491
translate russian samantha_event_D05B_6e09531b:
    "Обеим достаётся поровну: полосы тянутся от лба до подбородка."

# ch/samantha/events.rpy:7492
translate russian samantha_event_D05B_a8ebd801:
    "Натали выглядит удивлённой, моргает и ахает, принимая сперму."

# ch/samantha/events.rpy:7493
translate russian samantha_event_D05B_a3af3b8f:
    "А на лице Сэм я вижу решимость."

# ch/samantha/events.rpy:7494
translate russian samantha_event_D05B_b2d41d5a:
    "Она смотрит на телефон и всё время улыбается."

# ch/samantha/events.rpy:7495
translate russian samantha_event_D05B_1a6f63eb:
    "И ещё до того, как мы заканчиваем, я уже знаю, кому предназначено это видео..."

# ch/samantha/events.rpy:7505
translate russian samantha_event_E01_4661f384:
    "Телефон настойчиво вибрирует у меня в кармане."

# ch/samantha/events.rpy:7506
translate russian samantha_event_E01_ea22e1f9:
    "Я уже натягиваю одежду и провожу пальцем по экрану, чтобы проверить сообщение."

# ch/samantha/events.rpy:7519
translate russian samantha_event_E01_b0a47190:
    "Это Саманта. Я беру телефон и собираюсь ответить."

# ch/samantha/events.rpy:7521
translate russian samantha_event_E01_86a3bd9e:
    "Я не очень понимаю, что сказать."

# ch/samantha/events.rpy:7522
translate russian samantha_event_E01_1c3d1066:
    "Она... хочет встретиться со мной в парке."

# ch/samantha/events.rpy:7523
translate russian samantha_event_E01_4b4505b7:
    "Я быстро смотрю на время вверху экрана."

# ch/samantha/events.rpy:7524
translate russian samantha_event_E01_e00c49fe:
    "Время у меня есть."

# ch/samantha/events.rpy:7525
translate russian samantha_event_E01_42250238:
    "Я сразу соглашаюсь."

# ch/samantha/events.rpy:7526
translate russian samantha_event_E01_7e5e78db:
    "Она благодарит меня и больше ничего не объясняет."

# ch/samantha/events.rpy:7527
translate russian samantha_event_E01_ca9278a6:
    "Я не расспрашиваю, боясь, что под давлением она передумает."

# ch/samantha/events.rpy:7528
translate russian samantha_event_E01_b6304ce7:
    "С тех пор как я рассказал ей об измене Райана, мне плохо оттого, что я так её расстроил. Но в ту самую минуту, когда я признался, с груди свалилась тяжесть, о которой я даже не подозревал."

# ch/samantha/events.rpy:7530
translate russian samantha_event_E01_50f3600f:
    "Я быстро добираюсь до парка и, выйдя на ведущую внутрь дорожку, перевожу дыхание."

# ch/samantha/events.rpy:7531
translate russian samantha_event_E01_5df2b9e1:
    "Золотистые волосы Саманты я замечаю сразу."

# ch/samantha/events.rpy:7532
translate russian samantha_event_E01_36ee0de4:
    "Похоже, она ещё не выбрала, где расположиться."

# ch/samantha/events.rpy:7534
translate russian samantha_event_E01_0441121c:
    mike.say "Кексик!"

# ch/samantha/events.rpy:7536
translate russian samantha_event_E01_b654852b:
    mike.say "Сэм!"

# ch/samantha/events.rpy:7538
translate russian samantha_event_E01_f0a867d2:
    "Она резко оборачивается, широко раскрыв глаза. Мы идём навстречу друг другу и встречаемся на полпути."

# ch/samantha/events.rpy:7539
translate russian samantha_event_E01_e698dad7:
    samantha.say "..."

# ch/samantha/events.rpy:7540
translate russian samantha_event_E01_b99161cd:
    samantha.say "Привет, [lssb_samantha.hero_name()]."

# ch/samantha/events.rpy:7541
translate russian samantha_event_E01_c155a10d:
    mike.say "Эй..."

# ch/samantha/events.rpy:7542
translate russian samantha_event_E01_309618d0:
    mike.say "Как ты?"

# ch/samantha/events.rpy:7543
translate russian samantha_event_E01_d6c19fdf:
    samantha.say "Нормально, наверное."

# ch/samantha/events.rpy:7544
translate russian samantha_event_E01_b598f2d2:
    mike.say "Хорошо, хорошо."

# ch/samantha/events.rpy:7545
translate russian samantha_event_E01_feff2920:
    "Между нами повисает неловкое молчание. Саманта слегка качает головой и поднимает на меня взгляд."

# ch/samantha/events.rpy:7546
translate russian samantha_event_E01_f7514c3c:
    samantha.say "Ладно, сразу к делу. Я всё ещё расстроена, что ты не рассказал о Райане раньше."

# ch/samantha/events.rpy:7547
translate russian samantha_event_E01_9dc46f5f:
    samantha.say "Но хочу сказать тебе спасибо. Ты ведь мог вообще не рассказать, а всё-таки рассказал."

# ch/samantha/events.rpy:7548
translate russian samantha_event_E01_77f62b72:
    "Я не отвечаю, давая ей выговориться."

# ch/samantha/events.rpy:7549
translate russian samantha_event_E01_d134df7a:
    samantha.say "И я... хочу с ним расстаться."

# ch/samantha/events.rpy:7550
translate russian samantha_event_E01_57c49a13:
    mike.say "Я... о."

# ch/samantha/events.rpy:7551
translate russian samantha_event_E01_6885f03f:
    mike.say "Правда?"

# ch/samantha/events.rpy:7552
translate russian samantha_event_E01_acdc2483:
    samantha.say "Да, правда. Я больше не хочу быть с ним, если он гуляет с другими женщинами. Я... сначала не хотела верить. Но..."

# ch/samantha/events.rpy:7554
translate russian samantha_event_E01_be769b39:
    "На глазах Саманты выступают слёзы, но прежде, чем я успеваю её утешить, она берёт себя в руки."

# ch/samantha/events.rpy:7555
translate russian samantha_event_E01_4cf775c5:
    mike.say "Что?"

# ch/samantha/events.rpy:7556
translate russian samantha_event_E01_5fdff14b:
    samantha.say "Недавно я уходила на работу. На выходе увидела у двери девушку, которая его спрашивала."

# ch/samantha/events.rpy:7557
translate russian samantha_event_E01_354c9b40:
    samantha.say "Райан сказал, что это просто коллега: живёт неподалёку и хочет, чтобы он её подвёз."

# ch/samantha/events.rpy:7558
translate russian samantha_event_E01_5ae0baa3:
    samantha.say "Но... это была та самая девушка с фотографии, которую ты мне показал."

# ch/samantha/events.rpy:7559
translate russian samantha_event_E01_5a33e8de:
    "Ого. Она ещё и приходит к ним домой? Это... подло."

# ch/samantha/events.rpy:7561
translate russian samantha_event_E01_a7a254d0:
    mike.say "Ох, мне очень жаль, Кексик."

# ch/samantha/events.rpy:7563
translate russian samantha_event_E01_ffec3891:
    mike.say "Ох, мне очень жаль, Сэм."

# ch/samantha/events.rpy:7564
translate russian samantha_event_E01_91412160:
    samantha.say "Нет, нет. Всё в порядке. Я должна была заметить раньше."

# ch/samantha/events.rpy:7565
translate russian samantha_event_E01_a4376761:
    mike.say "Ты никак не могла знать. Он просто притворялся, что любит тебя..."

# ch/samantha/events.rpy:7566
translate russian samantha_event_E01_cd34c93d:
    ryan.say "Заткнись!"

# ch/samantha/events.rpy:7568
translate russian samantha_event_E01_29c82498:
    "Саманта смотрит мне за спину, и ещё до того, как я оборачиваюсь, я уже знаю, кто там."

# ch/samantha/events.rpy:7572
translate russian samantha_event_E01_e4eee26f:
    samantha.say "Райан?! Ты что, пошёл за мной?"

# ch/samantha/events.rpy:7573
translate russian samantha_event_E01_6b986450:
    "Лицо Райана красное от злости. Не обращая внимания на Саманту, он идёт прямо ко мне."

# ch/samantha/events.rpy:7574
translate russian samantha_event_E01_be0f934b:
    ryan.say "Как ты посмел?! Зачем ты ей рассказал? Ты что, совсем охренел?!"

# ch/samantha/events.rpy:7575
translate russian samantha_event_E01_cc331c06:
    mike.say "Это я охренел?"

# ch/samantha/events.rpy:7577
translate russian samantha_event_E01_142b0dd0:
    "Пока я говорю, Райан толкает меня в плечо, и я слегка отшатываюсь."

# ch/samantha/events.rpy:7579
translate russian samantha_event_E01_989d91f9:
    samantha.say "Райан! Прекрати!"

# ch/samantha/events.rpy:7580
translate russian samantha_event_E01_0dce3616:
    mike.say "Ты её не заслуживаешь."

# ch/samantha/events.rpy:7581
translate russian samantha_event_E01_2629d281:
    ryan.say "Заткнись! Она моя жена, разрушитель семей!"

# ch/samantha/events.rpy:7583
translate russian samantha_event_E01_cb1c60af:
    "Он снова толкает меня, но на этот раз я готов и не сдвигаюсь с места."

# ch/samantha/events.rpy:7585
translate russian samantha_event_E01_1c8c456c:
    samantha.say "Райан! Между нами всё кончено! Ты меня вообще слышишь?!"

# ch/samantha/events.rpy:7586
translate russian samantha_event_E01_54dc428a:
    ryan.say "Заткнись, Саманта!"

# ch/samantha/events.rpy:7588
translate russian samantha_event_E01_050bc8ed:
    "Теперь Райан обрушивает свою ярость на неё."

# ch/samantha/events.rpy:7592
translate russian samantha_event_E01_e25826cf:
    "Я даже не задумываюсь."

# ch/samantha/events.rpy:7598
translate russian samantha_event_E01_3714a50b:
    "Я замахиваюсь и бью его кулаком прямо в лицо."

# ch/samantha/events.rpy:7599
translate russian samantha_event_E01_965977a4:
    "Похоже, он не ожидал, что я действительно ударю, поэтому кулак попадает точно в цель."

# ch/samantha/events.rpy:7600
translate russian samantha_event_E01_71bac13d:
    "Райан отшатывается; на его уже окровавленном лице застыло изумление."

# ch/samantha/events.rpy:7601
translate russian samantha_event_E01_ace92de0:
    "Кровь течёт из носа ему на губы. Костяшки моих пальцев начинает саднить и ломить от удара."

# ch/samantha/events.rpy:7603
translate russian samantha_event_E01_6bba5af3:
    "Райан бросается на меня, но я отступаю в сторону, прежде чем он успевает ударить меня локтем."

# ch/samantha/events.rpy:7604
translate russian samantha_event_E01_fcecd4e3:
    "Я сильно бью его ногой в бок, заставляя отступить и согнуться."

# ch/samantha/events.rpy:7610
translate russian samantha_event_E01_6ceb2b95:
    "Он приходит в себя быстрее, чем я ожидал. Прежде чем он успевает снова броситься на меня, я сам устремляюсь вперёд и бью кулаком прямо в грудь."

# ch/samantha/events.rpy:7611
translate russian samantha_event_E01_5c75addd:
    "Удар попадает в цель, и Райан с болезненным хрипом выдыхает."

# ch/samantha/events.rpy:7612
translate russian samantha_event_E01_457d680c:
    "Райан кашляет и пытается вдохнуть."

# ch/samantha/events.rpy:7613
translate russian samantha_event_E01_c5de4312:
    "Я грубо толкаю его на землю, и он без сопротивления валится набок."

# ch/samantha/events.rpy:7617
translate russian samantha_event_E01_cfc351a3:
    samantha.say "[lssb_samantha.hero_name()]! Райан! Прекратите, пожалуйста!"

# ch/samantha/events.rpy:7618
translate russian samantha_event_E01_9a166df1:
    "Голос Сэм приводит меня в чувство."

# ch/samantha/events.rpy:7619
translate russian samantha_event_E01_11fb0cfb:
    "От адреналина у меня шумит в ушах и трясутся руки; удивительно, что я вообще её услышал."

# ch/samantha/events.rpy:7620
translate russian samantha_event_E01_c7f4a921:
    "Я отступаю, а Райан остаётся на земле."

# ch/samantha/events.rpy:7621
translate russian samantha_event_E01_aded4608:
    "Переводя дыхание, он смотрит на меня с неприкрытой ненавистью."

# ch/samantha/events.rpy:7623
translate russian samantha_event_E01_72eba38e:
    "Саманта хватает меня за руку и тащит прочь."

# ch/samantha/events.rpy:7624
translate russian samantha_event_E01_c3f015eb:
    "Я не сопротивляюсь."

# ch/samantha/events.rpy:7625
translate russian samantha_event_E01_71de5f60:
    "Мы оставляем Райана там, но, думаю, он усвоил, что к ней больше лучше не приближаться."

# ch/samantha/events.rpy:7632
translate russian samantha_event_E01_ca0ef99d:
    "Райан бросается на меня и бьёт локтем в рёбра."

# ch/samantha/events.rpy:7633
translate russian samantha_event_E01_778703d2:
    "Я хриплю, чувствуя, как от удара что-то хрустит."

# ch/samantha/events.rpy:7634
translate russian samantha_event_E01_ea01f333:
    samantha.say "Прекратите! Пожалуйста!"

# ch/samantha/events.rpy:7635
translate russian samantha_event_E01_44240d67:
    "Я пытаюсь выпрямиться, но морщусь от боли."

# ch/samantha/events.rpy:7641
translate russian samantha_event_E01_b3e1a911:
    "Удар кулаком в бок заставляет меня выпрямиться: тело рефлекторно дёргается прочь."

# ch/samantha/events.rpy:7646
translate russian samantha_event_E01_cbd0b362:
    "Он бьёт ещё раз, но я успеваю подставить предплечье."

# ch/samantha/events.rpy:7647
translate russian samantha_event_E01_2c552deb:
    "Хотя можно ли назвать это блоком, если всё равно больно?"

# ch/samantha/events.rpy:7653
translate russian samantha_event_E01_95893d22:
    "Я изо всех сил отталкиваю Райана."

# ch/samantha/events.rpy:7654
translate russian samantha_event_E01_d0b95eec:
    "Он поскальзывается в грязи и падает на бок."

# ch/samantha/events.rpy:7655
translate russian samantha_event_E01_854803a5:
    "Шипя от боли, он снова поднимается."

# ch/samantha/events.rpy:7659
translate russian samantha_event_E01_e4ba93d9:
    "Прежде чем я успеваю отреагировать, Саманта бросается передо мной и раскидывает руки, защищая меня."

# ch/samantha/events.rpy:7660
translate russian samantha_event_E01_bc1c2766:
    "Райана это, похоже, не останавливает: он подходит ближе и заносит кулак."

# ch/samantha/events.rpy:7661
translate russian samantha_event_E01_972b8950:
    "Но наконец замирает."

# ch/samantha/events.rpy:7662
translate russian samantha_event_E01_45eb1fb2:
    "Глядя на Сэм, он смягчается и опускает руку."

# ch/samantha/events.rpy:7663
translate russian samantha_event_E01_9dad8616:
    "Райан резко мотает головой и отворачивается."

# ch/samantha/events.rpy:7664
translate russian samantha_event_E01_571cea7c:
    "Он надолго застывает на месте, словно хочет что-то сказать."

# ch/samantha/events.rpy:7665
translate russian samantha_event_E01_be44bac2:
    "А потом уходит."

# ch/samantha/events.rpy:7666
translate russian samantha_event_E01_c006659c:
    "Долгое время стоит тишина, затем я тяжело опускаюсь на землю, морщась от боли в рёбрах."

# ch/samantha/events.rpy:7669
translate russian samantha_event_E01_6c816035:
    samantha.say "[lssb_samantha.hero_name()]! Господи... ты в порядке?"

# ch/samantha/events.rpy:7670
translate russian samantha_event_E01_3e0743af:
    mike.say "Всё хорошо. Я в порядке."

# ch/samantha/events.rpy:7671
translate russian samantha_event_E01_b6241aad:
    "Наверное. Возможно, по пути домой придётся зайти в клинику, но я не умираю."

# ch/samantha/events.rpy:7672
translate russian samantha_event_E01_02ae7dd1:
    samantha.say "Мне так жаль, что это случилось!"

# ch/samantha/events.rpy:7673
translate russian samantha_event_E01_750e2356:
    "Похоже, Сэм снова вот-вот расплачется; я буквально вижу, как её накрывает чувство вины."

# ch/samantha/events.rpy:7675
translate russian samantha_event_E01_7267a38a:
    mike.say "Кексик. Ты не виновата. В этом совершенно нет твоей вины."

# ch/samantha/events.rpy:7677
translate russian samantha_event_E01_baaeb6e2:
    mike.say "Сэм. Ты не виновата. В этом совершенно нет твоей вины."

# ch/samantha/events.rpy:7678
translate russian samantha_event_E01_574c600e:
    "Сэм неуверенно кивает, явно не веря моим словам. Вместо ответа она пристально смотрит на меня, словно что-то ищет."

# ch/samantha/events.rpy:7679
translate russian samantha_event_E01_e0bac291:
    mike.say "Что..."

# ch/samantha/events.rpy:7682
translate russian samantha_event_E01_a9a675ff:
    "Я не успеваю договорить: она наклоняется и прижимается губами к моим."

# ch/samantha/events.rpy:7683
translate russian samantha_event_E01_1f123a9c:
    samantha.say "...Спасибо."

# ch/samantha/events.rpy:7684
translate russian samantha_event_E01_2e5f0fce:
    "Она шепчет, но я слышу каждое слово."

# ch/samantha/events.rpy:7688
translate russian samantha_event_E01_b7c1ab0a:
    "Я заслоняю её от него и отступаю."

# ch/samantha/events.rpy:7689
translate russian samantha_event_E01_93e71de6:
    mike.say "Райан. Тебе нужно успокоиться."

# ch/samantha/events.rpy:7690
translate russian samantha_event_E01_9033f3b1:
    ryan.say "Пошёл ты!"

# ch/samantha/events.rpy:7691
translate russian samantha_event_E01_fd9885da:
    "Я жестом показываю Саманте уходить, и она понимает намёк."

# ch/samantha/events.rpy:7699
translate russian samantha_are_you_sick_75622411:
    samantha.say "Серьёзно, сделай что-нибудь, у тебя вид умирающего..."

# ch/samantha/events.rpy:7702
translate russian samantha_are_you_sick_dff225a9:
    samantha.say "Хочешь поиграть в доктора?"

# ch/samantha/events.rpy:7705
translate russian samantha_are_you_sick_0f1ab802:
    samantha.say "Я могла бы быть твоей сексуальной медсестричкой..."

# ch/samantha/events.rpy:7708
translate russian samantha_are_you_sick_263ae2a2:
    samantha.say "Шучу, не обольщайся."

# ch/samantha/events.rpy:7710
translate russian samantha_are_you_sick_dff225a9_1:
    samantha.say "Хочешь поиграть в доктора?"

# ch/samantha/events.rpy:7718
translate russian samantha_buy_dress_a711d1db:
    "Саманта нерешительно смотрит на соблазнительное платье..."

# ch/samantha/events.rpy:7720
translate russian samantha_buy_dress_8c3e6c0c:
    samantha.say "Это платье чудесное, но мне оно не по карману."

# ch/samantha/events.rpy:7724
translate russian samantha_buy_dress_3f53fc7d:
    mike.say "Я куплю его тебе..."

# ch/samantha/events.rpy:7727
translate russian samantha_buy_dress_bf970aa1:
    samantha.say "Огромное спасибо, [lssb_samantha.hero_name()]!"

# ch/samantha/events.rpy:7731
translate russian samantha_buy_dress_e08b7dd7:
    samantha.say "Я не могу это принять, но спасибо за предложение."

# ch/samantha/events.rpy:7734
translate russian samantha_buy_dress_a31387d8:
    "Саманта улыбается мне."

# ch/samantha/events.rpy:7735
translate russian samantha_buy_dress_9479d40e:
    samantha.say "Заведи себе девушку и покупай одежду ей, а не мне."

# ch/samantha/events.rpy:7739
translate russian samantha_buy_dress_73c3c7e3:
    samantha.say "Может, в следующем месяце..."

# ch/samantha/events.rpy:7742
translate russian samantha_buy_dress_d6954fd1:
    samantha.say "Это было бы неразумно..."

# ch/samantha/events.rpy:7749
translate russian samantha_forgot_money_98a94ec4:
    samantha.say "Блядь!"

# ch/samantha/events.rpy:7751
translate russian samantha_forgot_money_1c14cacb:
    mike.say "Что такое, Кексик?"

# ch/samantha/events.rpy:7753
translate russian samantha_forgot_money_70e238b7:
    mike.say "Что такое, Саманта?"

# ch/samantha/events.rpy:7756
translate russian samantha_forgot_money_7a2610ed:
    samantha.say "Я забыла деньги."

# ch/samantha/events.rpy:7760
translate russian samantha_forgot_money_0a7fd0b1:
    mike.say "Не переживай, я за тебя заплачу."

# ch/samantha/events.rpy:7762
translate russian samantha_forgot_money_f826fa49:
    samantha.say "Спасибо, ты настоящий друг."

# ch/samantha/events.rpy:7766
translate russian samantha_forgot_money_2c847315:
    samantha.say "Придётся попросить записать на мой счёт..."

# ch/samantha/events.rpy:7769
translate russian samantha_forgot_money_2c847315_1:
    samantha.say "Придётся попросить записать на мой счёт..."

# ch/samantha/events.rpy:7778
translate russian samantha_kiss_me_b67505cb:
    "Саманта смотрит на меня с тоской и желанием."

# ch/samantha/events.rpy:7786
translate russian samantha_kiss_me_ec013c90:
    "Я так долго представлял, как всё будет, если мне когда-нибудь выпадет шанс поцеловать Сэм."

# ch/samantha/events.rpy:7787
translate russian samantha_kiss_me_cffbed1e:
