# ch/samantha/chat.rpy:367
translate russian samantha_desire_3_male_ef6f0799:
    samantha.say "Я вообще-то замужняя женщина... За твоим другом."

# ch/samantha/chat.rpy:369
translate russian samantha_desire_3_male_616cc36a:
    samantha.say "У меня вообще-то есть парень... Твой друг."

# ch/samantha/chat.rpy:370
translate russian samantha_desire_3_male_68224c49:
    mike.say "Минет от тебя стоит тысячи друзей."

# ch/samantha/chat.rpy:373
translate russian samantha_desire_3_male_854fb7a2:
    samantha.say "Лучше не рассказывай Райану, что сказал."

# ch/samantha/chat.rpy:377
translate russian samantha_desire_3_male_e6abc529:
    samantha.say "Надо будет как-нибудь попробовать."

# ch/samantha/chat.rpy:378
translate russian samantha_desire_3_male_0bbed57e:
    mike.say "Напиши, когда будешь готова."

# ch/samantha/chat.rpy:379
translate russian samantha_desire_3_male_b4dac135:
    samantha.say "Хорошо."

# ch/samantha/chat.rpy:382
translate russian samantha_desire_3_male_2a071caf:
    samantha.say "В следующий раз, когда останемся одни, обязательно попробуем."

# ch/samantha/chat.rpy:383
translate russian samantha_desire_3_male_7cb9b67c:
    mike.say "Пойдём ко мне в комнату."

# ch/samantha/chat.rpy:384
translate russian samantha_desire_3_male_3a1c688d:
    samantha.say "Ха-ха!"

# ch/samantha/chat.rpy:387
translate russian samantha_desire_3_male_c7ee5235:
    mike.say "Может, попробуешь перекраситься в рыжий..."

# ch/samantha/chat.rpy:388
translate russian samantha_desire_3_male_a7c6cff5:
    samantha.say "Как моя подруга Джессика?"

# ch/samantha/chat.rpy:390
translate russian samantha_desire_3_male_89a55a96:
    mike.say "Я её не знаю."

# ch/samantha/chat.rpy:391
translate russian samantha_desire_3_male_8cf65836:
    samantha.say "Хорошая девушка, работает в цветочном магазине в торговом центре."

# ch/samantha/chat.rpy:392
translate russian samantha_desire_3_male_bb5335ed:
    samantha.say "Всё же думаю, блондинкой мне лучше."

# ch/samantha/chat.rpy:393
translate russian samantha_desire_3_male_845918ff:
    mike.say "Зато так никто по ошибке не решит, что у тебя есть мозги."

# ch/samantha/chat.rpy:394
translate russian samantha_desire_3_male_72180ef7:
    samantha.say "Ха. Ха. Ха... Придурок."

# ch/samantha/chat.rpy:397
translate russian samantha_desire_3_male_c56a748a:
    mike.say "Может, попробуешь сделать пирсинг."

# ch/samantha/chat.rpy:398
translate russian samantha_desire_3_male_dfbedcdf:
    samantha.say "Не знаю..."

# ch/samantha/chat.rpy:400
translate russian samantha_desire_3_male_36222bc5:
    samantha.say "У меня уже проколот пупок..."

# ch/samantha/chat.rpy:401
translate russian samantha_desire_3_male_f87d8dab:
    mike.say "Знаю. И, по-моему, это чертовски сексуально."

# ch/samantha/chat.rpy:404
translate russian samantha_desire_3_male_5765e9a1:
    "Щёки Саманты слегка краснеют."

# ch/samantha/chat.rpy:405
translate russian samantha_desire_3_male_08a68f06:
    samantha.say "...И оба соска..."

# ch/samantha/chat.rpy:406
translate russian samantha_desire_3_male_3c6e1afa:
    "Я медленно сглатываю..."

# ch/samantha/chat.rpy:409
translate russian samantha_desire_3_male_6ac466cb:
    "Саманта начинает дышать чаще."

# ch/samantha/chat.rpy:410
translate russian samantha_desire_3_male_68e2a75c:
    samantha.say "...И клитор тоже."

# ch/samantha/chat.rpy:411
translate russian samantha_desire_3_male_1bf5e720:
    "Чувствую, как в штанах становится тесно."

# ch/samantha/chat.rpy:413
translate russian samantha_desire_3_male_7210a49a:
    samantha.say "Так что не уверена, что нужно ещё."

# ch/samantha/chat.rpy:414
translate russian samantha_desire_3_male_09f92884:
    samantha.say "Может получиться перебор."

# ch/samantha/chat.rpy:415
translate russian samantha_desire_3_male_f2db753f:
    "Она явно довольна тем, какое впечатление на меня произвела."

# ch/samantha/chat.rpy:418
translate russian samantha_desire_3_male_fbe175c5:
    samantha.say "Может, побрею голову."

# ch/samantha/chat.rpy:420
translate russian samantha_desire_3_male_36ea774a:
    mike.say "Нет, лучше избавься от мужа. Без него ты будешь прекрасно смотреться."

# ch/samantha/chat.rpy:422
translate russian samantha_desire_3_male_59dea2df:
    mike.say "Нет, лучше избавься от парня. Без него ты будешь прекрасно смотреться."

# ch/samantha/chat.rpy:424
translate russian samantha_desire_3_male_b00ffc2b:
    mike.say "Сделаешь — я тоже побреюсь."

# ch/samantha/chat.rpy:425
translate russian samantha_desire_3_male_0c81e7aa:
    mike.say "Будем ходить как два влюблённых больших пальца."

# ch/samantha/chat.rpy:427
translate russian samantha_desire_3_male_e861fd49:
    mike.say "От балласта ты уже избавилась. Тебе пошло."

# ch/samantha/chat.rpy:428
translate russian samantha_desire_3_male_36e835fd:
    mike.say "Честно говоря, я теперь готов смотреть, как ты бреешь что угодно."

# ch/samantha/chat.rpy:430
translate russian samantha_desire_3_male_08724952:
    mike.say "Ага, а я начну краситься."

# ch/samantha/chat.rpy:431
translate russian samantha_desire_3_male_b345dd66:
    samantha.say "Хватит шутить..."

# ch/samantha/chat.rpy:437
translate russian samantha_desire_4_male_f8393af0:
    samantha.say "Я за выходные немного похудела."

# ch/samantha/chat.rpy:438
translate russian samantha_desire_4_male_0d3ee51c:
    samantha.say "Подстригла ногти."

# ch/samantha/chat.rpy:440
translate russian samantha_desire_4_male_a9cc35cd:
    samantha.say "Парень и девушка могут просто дружить, но рано или поздно они влюбятся друг в друга..."

# ch/samantha/chat.rpy:441
translate russian samantha_desire_4_male_a5fcb225:
    samantha.say "Может, ненадолго, может, не вовремя, может, слишком поздно. А может, навсегда."

# ch/samantha/chat.rpy:443
translate russian samantha_desire_4_male_a0bf8f3f:
    samantha.say "Мужчины, может, и открыли огонь, зато женщины научились с ним играть."

# ch/samantha/chat.rpy:445
translate russian samantha_desire_4_male_95f4990f:
    samantha.say "Мне кажется, лучшие отношения — те, что длятся долго, — часто вырастают из дружбы."

# ch/samantha/chat.rpy:446
translate russian samantha_desire_4_male_c112c9de:
    samantha.say "Однажды смотришь на человека и видишь больше, чем видел накануне."

# ch/samantha/chat.rpy:447
translate russian samantha_desire_4_male_42f0cc4e:
    samantha.say "Будто где-то щёлкнул переключатель. И тот, кто был просто другом..."

# ch/samantha/chat.rpy:448
translate russian samantha_desire_4_male_462bc9b4:
    samantha.say "Вдруг становится единственным, с кем ты можешь представить себя."

# ch/samantha/chat.rpy:450
translate russian samantha_desire_4_male_6d888b37:
    samantha.say "Я не намекаю, [lssb_samantha.hero_name()]."

# ch/samantha/chat.rpy:451
translate russian samantha_desire_4_male_0dc86a33:
    samantha.say "Намёки я давно бросила. Ты был рядом и прекрасно знаешь когда."

# ch/samantha/chat.rpy:454
translate russian samantha_desire_4_male_7921f6a6:
    samantha.say "А мне достался другой вариант: всё начинается с прекрасного свидания, а заканчивается пошлиной за развод."

# ch/samantha/chat.rpy:455
translate russian samantha_desire_4_male_7295c41f:
    mike.say "Сэм..."

# ch/samantha/chat.rpy:457
translate russian samantha_desire_4_male_87694fef:
    samantha.say "А бывает ещё так: из двух друзей смотришь не на того и выбираешь с закрытыми глазами."

# ch/samantha/chat.rpy:458
translate russian samantha_desire_4_male_337c8b4a:
    samantha.say "Чисто теоретически."

# ch/samantha/chat.rpy:460
translate russian samantha_desire_4_male_9069746c:
    samantha.say "Я бы всё отдала, чтобы тебя было двое. Позвонила бы тому, кто мой друг, и рассказала о том, кто мне так нравится."

# ch/samantha/chat.rpy:462
translate russian samantha_desire_4_male_0a0008eb:
    samantha.say "Хотя один ты уже съедаешь почти всю мою выпечку. Двое бы меня разорили."

# ch/samantha/chat.rpy:465
translate russian samantha_desire_4_male_d32813be:
    samantha.say "Впрочем, с нашими договорённостями вы бы оба были заняты в пятницу."

# ch/samantha/chat.rpy:466
translate russian samantha_desire_4_male_bd634a93:
    mike.say "Больно."

# ch/samantha/chat.rpy:474
translate russian samantha_desire_5_male_43173ff4:
    samantha.say "Раньше я страдала синдромом соседской девчонки. Это когда парень, которого любишь, тебе просто друг, и всё."

# ch/samantha/chat.rpy:475
translate russian samantha_desire_5_male_806413b2:
    samantha.say "Оказалось, достаточно ему признаться. Вот чудеса медицины."

# ch/samantha/chat.rpy:478
translate russian samantha_desire_5_male_f2cfb647:
    samantha.say "Я годами страдала синдромом соседской девчонки: любимый парень — просто друг, и всё."

# ch/samantha/chat.rpy:479
translate russian samantha_desire_5_male_ec43efc9:
    samantha.say "А потом взяла и обручилась. Вылечилась дорогим способом."

# ch/samantha/chat.rpy:481
translate russian samantha_desire_5_male_82a11f1f:
    samantha.say "Я страдаю синдромом соседской девчонки: парень, которого любишь, с тобой дружит, и только."

# ch/samantha/chat.rpy:483
translate russian samantha_desire_5_male_81448975:
    samantha.say "Попробуй не думать о том, как я тебе отсасываю."

# ch/samantha/chat.rpy:485
translate russian samantha_desire_5_male_333b5a2f:
    samantha.say "Вчера мне приснился непристойный сон. Угадай, кто там был?"

# ch/samantha/chat.rpy:486
translate russian samantha_desire_5_male_90a58dfd:
    samantha.say "Подскажу: я сейчас с ним разговариваю."

# ch/samantha/chat.rpy:488
translate russian samantha_desire_5_male_11686f0b:
    samantha.say "Тебе когда-нибудь снился эротический сон со мной? Только честно..."

# ch/samantha/chat.rpy:490
translate russian samantha_desire_5_male_25ecba07:
    samantha.say "Если бы мог сделать со мной всё что захочешь, что бы сделал?"

# ch/samantha/chat.rpy:493
translate russian samantha_desire_5_male_9c321eaa:
    mike.say "Сказал бы тебе, где именно встать на колени."

# ch/samantha/chat.rpy:494
translate russian samantha_desire_5_male_dc9b0e34:
    samantha.say "М-м-м. Да, шеф."

# ch/samantha/chat.rpy:495
translate russian samantha_desire_5_male_9b7b3bf9:
    samantha.say "Оказывается, я прекрасно выполняю указания, когда мне нравится тот, кто их даёт."

# ch/samantha/chat.rpy:498
translate russian samantha_desire_5_male_d44e9a47:
    mike.say "Всё, что ты позволишь."

# ch/samantha/chat.rpy:499
translate russian samantha_desire_5_male_e80e22d8:
    samantha.say "Мило. Неправильный ответ, но мило."

# ch/samantha/chat.rpy:500
translate russian samantha_desire_5_male_eda46909:
    samantha.say "Перед тобой было всё, [lssb_samantha.hero_name()]. А ты попросил разрешения положить руку мне на колено."

# ch/samantha/chat.rpy:501
translate russian samantha_desire_5_male_22cb579b:
    samantha.say "Сиди спокойно. Я решу, что будет дальше."

# ch/samantha/chat.rpy:509
translate russian samantha_love_0_male_18f02365:
    "Хотелось бы сказать, что я достаточно взрослый и уверенный в себе, чтобы слова Одри меня не задевали."

# ch/samantha/chat.rpy:510
translate russian samantha_love_0_male_2d0f6d74:
    "Но правда в том, что они засели у меня под кожей и почти сразу начали раздражать."

# ch/samantha/chat.rpy:511
translate russian samantha_love_0_male_605b4240:
    "Ловлю себя на том, что намеренно избегаю движений, которые можно счесть манерными."

# ch/samantha/chat.rpy:512
translate russian samantha_love_0_male_1948c85d:
    "И не раз замечаю, что говорю нарочито низким, почти нелепым голосом."

# ch/samantha/chat.rpy:513
translate russian samantha_love_0_male_38efb08b:
    "Часть меня не верит, что я веду себя настолько предсказуемо и мнительно."

# ch/samantha/chat.rpy:514
translate russian samantha_love_0_male_e9d6ca6d:
    "Я современный парень и совершенно нормально отношусь к таким вещам."

# ch/samantha/chat.rpy:515
translate russian samantha_love_0_male_e853565b:
    "Так почему же я так отреагировал на то, что меня приняли за гея?"

# ch/samantha/chat.rpy:516
translate russian samantha_love_0_male_3ff2ccfd:
    "Я просто хотел хорошо выглядеть и одеваться со вкусом. Неужели теперь нужно носить табличку?!"

# ch/samantha/chat.rpy:517
translate russian samantha_love_0_male_41afba6c:
    "Повторяю себе, что дело, наверное, только в Одри и том Грегори, которого она упоминала."

# ch/samantha/chat.rpy:518
translate russian samantha_love_0_male_2c5fbdb8:
    "Неужели такое впечатление я произвожу на всех, кого встречаю?"

# ch/samantha/chat.rpy:519
translate russian samantha_love_0_male_da5bd861:
    "Не переставая об этом думать, при следующей встрече поднимаю тему с Сэм."

# ch/samantha/chat.rpy:520
translate russian samantha_love_0_male_8ac7e44e:
    mike.say "Не поверишь, что со мной на днях случилось на работе."

# ch/samantha/chat.rpy:521
translate russian samantha_love_0_male_1ac6f336:
    samantha.say "Правда? Что же?"

# ch/samantha/chat.rpy:522
translate russian samantha_love_0_male_0dd1af0b:
    "Чувствую, Сэм понимает: мне хочется пожаловаться."

# ch/samantha/chat.rpy:523
translate russian samantha_love_0_male_47c16b64:
    "Но она из тех друзей, которые всегда готовы выслушать и посочувствовать."

# ch/samantha/chat.rpy:524
translate russian samantha_love_0_male_6382839e:
    mike.say "Ладно, слушай."

# ch/samantha/chat.rpy:525
translate russian samantha_love_0_male_44a815a7:
    mike.say "Значит, Одри — моя коллега — заходит ко мне в кабинет."

# ch/samantha/chat.rpy:526
translate russian samantha_love_0_male_0de31389:
    "Сэм кивает."

# ch/samantha/chat.rpy:527
translate russian samantha_love_0_male_c32b004a:
    mike.say "И начинает говорить, как несправедливо, что я одинок."

# ch/samantha/chat.rpy:528
translate russian samantha_love_0_male_1aa3b90c:
    "Сэм приподнимает брови, но я продолжаю."

# ch/samantha/chat.rpy:529
translate russian samantha_love_0_male_d0515f1e:
    mike.say "Конечно, я думаю, что она ко мне подкатывает."

# ch/samantha/chat.rpy:530
translate russian samantha_love_0_male_4e966cce:
    samantha.say "Конечно."

# ch/samantha/chat.rpy:531
translate russian samantha_love_0_male_95796a75:
    mike.say "А потом она рассказывает про какого-то Грегори."

# ch/samantha/chat.rpy:532
translate russian samantha_love_0_male_039697cc:
    mike.say "Мол, он на меня заглядывается и она может устроить нам свидание!"

# ch/samantha/chat.rpy:533
translate russian samantha_love_0_male_9321208d:
    "Сэм ещё пару секунд смотрит прямо на меня."

# ch/samantha/chat.rpy:534
translate russian samantha_love_0_male_c1c57483:
    "Явно ждёт продолжения."

# ch/samantha/chat.rpy:535
translate russian samantha_love_0_male_04445ba2:
    "Когда понимает, что его не будет, лицо быстро принимает сочувственное выражение."

# ch/samantha/chat.rpy:536
translate russian samantha_love_0_male_c5b7652d:
    samantha.say "О... о нет..."

# ch/samantha/chat.rpy:537
translate russian samantha_love_0_male_8ec04d87:
    samantha.say "Это ужасно, [lssb_samantha.hero_name()]!"

# ch/samantha/chat.rpy:538
translate russian samantha_love_0_male_9e1a9647:
    samantha.say "Как она могла такое подумать?"

# ch/samantha/chat.rpy:539
translate russian samantha_love_0_male_c2f7d9f1:
    "Я киваю, пытаясь убедить себя, что именно такой реакции и хотел."

# ch/samantha/chat.rpy:540
translate russian samantha_love_0_male_07817b42:
    mike.say "Вот и я о том!"

# ch/samantha/chat.rpy:541
translate russian samantha_love_0_male_7dabae50:
    mike.say "Как она вообще могла решить, что я гей?"

# ch/samantha/chat.rpy:542
translate russian samantha_love_0_male_47dcc2c8:
    mike.say "Ты ведь так не думаешь?"

# ch/samantha/chat.rpy:543
translate russian samantha_love_0_male_2da20db7:
    mike.say "Что я гей, в смысле?"

# ch/samantha/chat.rpy:544
translate russian samantha_love_0_male_e6e807df:
    "Сэм хмурится и качает головой, пожалуй, слишком уж энергично."

# ch/samantha/chat.rpy:545
translate russian samantha_love_0_male_3009b5da:
    samantha.say "Нет... нет..."

# ch/samantha/chat.rpy:546
translate russian samantha_love_0_male_c59947c2:
    samantha.say "По крайней мере... уже нет..."

# ch/samantha/chat.rpy:547
translate russian samantha_love_0_male_3c329644:
    mike.say "Погоди, что..."

# ch/samantha/chat.rpy:548
translate russian samantha_love_0_male_6695e2c2:
    mike.say "В смысле «уже нет»?!"

# ch/samantha/chat.rpy:549
translate russian samantha_love_0_male_8bb0a644:
    "Под моим взглядом Сэм неловко ёрзает, явно стараясь тщательно подбирать слова."

# ch/samantha/chat.rpy:550
translate russian samantha_love_0_male_bc72827e:
    samantha.say "Ну..."

# ch/samantha/chat.rpy:551
translate russian samantha_love_0_male_a479673a:
    samantha.say "Было какое-то время, когда я, возможно, смутно что-то подозревала."

# ch/samantha/chat.rpy:552
translate russian samantha_love_0_male_a683b52b:
    "Я вопросительно смотрю на неё, и оправдываться ей становится ещё труднее."

# ch/samantha/chat.rpy:553
translate russian samantha_love_0_male_748864c8:
    samantha.say "Только когда я впервые переехала к вам с Райаном."

# ch/samantha/chat.rpy:554
translate russian samantha_love_0_male_59b13e83:
    samantha.say "Он довольно быстро меня разубедил."

# ch/samantha/chat.rpy:555
translate russian samantha_love_0_male_104aee06:
    samantha.say "Теперь я тебя и представить не могу в коротеньких шортиках... честно."

# ch/samantha/chat.rpy:556
translate russian samantha_love_0_male_17ca9494:
    mike.say "Но... но... какого чёрта?!"

# ch/samantha/chat.rpy:557
translate russian samantha_love_0_male_1e216f6a:
    samantha.say "Просто... ты следишь за собой лучше большинства парней, [lssb_samantha.hero_name()]."

# ch/samantha/chat.rpy:558
translate russian samantha_love_0_male_d0e85f8b:
    samantha.say "Хорошо одеваешься, тренируешься, стрижёшься строго раз в две недели."

# ch/samantha/chat.rpy:559
translate russian samantha_love_0_male_786e9f6c:
    mike.say "Потому что мне важно, как я выгляжу!"

# ch/samantha/chat.rpy:560
translate russian samantha_love_0_male_b2c47ad2:
    mike.say "Обязательно быть мерзким волосатым неряхой, чтобы меня считали натуралом?!"

# ch/samantha/chat.rpy:561
translate russian samantha_love_0_male_026cb1d2:
    samantha.say "[lssb_samantha.hero_name()], тебе не приходило в голову, что эта Одри специально тебя дразнит?"

# ch/samantha/chat.rpy:562
translate russian samantha_love_0_male_4dda1c6b:
    mike.say "Что..."

# ch/samantha/chat.rpy:563
translate russian samantha_love_0_male_b8472024:
    mike.say "Э-э, нет... кажется, нет."

# ch/samantha/chat.rpy:564
translate russian samantha_love_0_male_c1e38e88:
    samantha.say "Подумай: этого Грегори ведь рядом не было?"

# ch/samantha/chat.rpy:565
translate russian samantha_love_0_male_24de3e36:
    samantha.say "Для неё это очень удобно, понимаешь?"

# ch/samantha/chat.rpy:566
translate russian samantha_love_0_male_f8997f5a:
    samantha.say "Не нужно объяснять, почему она не знала, что ты натурал."

# ch/samantha/chat.rpy:567
translate russian samantha_love_0_male_7b78a466:
    mike.say "Если так посмотреть..."

# ch/samantha/chat.rpy:568
translate russian samantha_love_0_male_43b24b4f:
    samantha.say "Вот именно!"

# ch/samantha/chat.rpy:569
translate russian samantha_love_0_male_507bfe1d:
    samantha.say "Может, она с этим парнем вообще не разговаривала."

# ch/samantha/chat.rpy:570
translate russian samantha_love_0_male_943790eb:
    samantha.say "И он даже не знает о твоём существовании!"

# ch/samantha/chat.rpy:571
translate russian samantha_love_0_male_1ea9fa81:
    mike.say "Эй, погоди-ка!"

# ch/samantha/chat.rpy:572
translate russian samantha_love_0_male_cbc8328a:
    mike.say "Ты хочешь сказать, что я недостаточно хорош для такого, как Грегори?"

# ch/samantha/chat.rpy:573
translate russian samantha_love_0_male_5a322a0e:
    "Сэм закатывает глаза, показывая, насколько нелепым считает этот вопрос."

# ch/samantha/chat.rpy:574
translate russian samantha_love_0_male_5b83dd14:
    samantha.say "Давай просто забудем, [lssb_samantha.hero_name()]."

# ch/samantha/chat.rpy:575
translate russian samantha_love_0_male_75c22362:
    samantha.say "Как тебе такое?"

# ch/samantha/chat.rpy:576
translate russian samantha_love_0_male_5e11dcb6:
    "Я киваю, всё ещё немного задетый тем, что симпатия Грегори ко мне могла оказаться выдумкой."

# ch/samantha/chat.rpy:579
translate russian samantha_love_0_male_9da749b0:
    mike.say "Иногда у меня болит шея."

# ch/samantha/chat.rpy:580
translate russian samantha_love_0_male_b38db0c4:
    samantha.say "Почему?"

# ch/samantha/chat.rpy:581
translate russian samantha_love_0_male_c7f0ca17:
    mike.say "Потому что мозг слишком большой."

# ch/samantha/chat.rpy:582
translate russian samantha_love_0_male_c7c98814:
    "Саманта слегка усмехается."

# ch/samantha/chat.rpy:584
translate russian samantha_love_0_male_41382f8d:
    samantha.say "Когда перестаёшь ждать от людей совершенства, начинаешь любить их такими, какие они есть."

# ch/samantha/chat.rpy:586
translate russian samantha_love_0_male_feb1d1d8:
    mike.say "Почему мне кажется, будто я знаю тебя столько лет?"

# ch/samantha/chat.rpy:587
translate russian samantha_love_0_male_401190aa:
    samantha.say "Потому что ты мне нравишься и мне от тебя ничего не нужно."

# ch/samantha/chat.rpy:589
translate russian samantha_love_0_male_93f08b79:
    samantha.say "Каждый мужчина, которого встречаю, хочет меня защищать."

# ch/samantha/chat.rpy:590
translate russian samantha_love_0_male_01c0fe2a:
    samantha.say "Никак не пойму от чего."

# ch/samantha/chat.rpy:592
translate russian samantha_love_0_male_3249ba8f:
    samantha.say "Что сделала Золушка, когда добралась до королевских шаров?"

# ch/samantha/chat.rpy:593
translate russian samantha_love_0_male_2165358e:
    mike.say "Подавилась."

# ch/samantha/chat.rpy:595
translate russian samantha_love_0_male_db0ac875:
    mike.say "Самое болезненное — потерять себя, слишком сильно любя другого, и забыть, что ты тоже чего-то стоишь."

# ch/samantha/chat.rpy:602
translate russian samantha_love_1_male_d01cb574:
    samantha.say "Безумие — делать одно и то же снова и снова, ожидая другого результата."

# ch/samantha/chat.rpy:604
translate russian samantha_love_1_male_c48f04af:
    samantha.say "Женщины и кошки будут делать что хотят. Мужчинам и собакам стоит расслабиться и привыкнуть."

# ch/samantha/chat.rpy:606
translate russian samantha_love_1_male_e69b54df:
    samantha.say "Беда открытого ума в том, что все норовят прийти и что-нибудь в него засунуть."

# ch/samantha/chat.rpy:608
translate russian samantha_love_1_male_2960f867:
    samantha.say "По статистике, психическим расстройством страдает каждый четвёртый."

# ch/samantha/chat.rpy:609
translate russian samantha_love_1_male_1422f77a:
    samantha.say "Посмотри на трёх лучших друзей."

# ch/samantha/chat.rpy:610
translate russian samantha_love_1_male_3657028c:
    samantha.say "Если с ними всё в порядке — значит, это ты."

# ch/samantha/chat.rpy:612
translate russian samantha_love_1_male_e242fc27:
    samantha.say "Мой девиз — уйти, пока они не опустились."

# ch/samantha/chat.rpy:613
translate russian samantha_love_1_male_c600a160:
    mike.say "Точно не мой девиз."

# ch/samantha/chat.rpy:620
translate russian samantha_love_2_male_f9d1d948:
    mike.say "Когда ты в тюрьме, хороший друг пытается внести за тебя залог."

# ch/samantha/chat.rpy:621
translate russian samantha_love_2_male_183a3d6a:
    mike.say "А лучший сидит в соседней камере и говорит: «Чёрт, было весело»."

# ch/samantha/chat.rpy:622
translate russian samantha_love_2_male_fb865ed2:
    samantha.say "Нет, лучший друг вообще не дал бы тебе совершить глупость."

# ch/samantha/chat.rpy:624
translate russian samantha_love_2_male_50d4a231:
    samantha.say "Некоторые люди готовы на всё, лишь бы проверить, возможно ли это."

# ch/samantha/chat.rpy:625
translate russian samantha_love_2_male_59ae6dec:
    samantha.say "Поставь где-нибудь в пещере большой выключатель с надписью «Конец света. ПОЖАЛУЙСТА, НЕ ТРОГАТЬ» — краска даже высохнуть не успеет."

# ch/samantha/chat.rpy:627
translate russian samantha_love_2_male_7f021e6c:
    samantha.say "Обычно я избегаю искушений, если только не могу им противостоять."

# ch/samantha/chat.rpy:629
translate russian samantha_love_2_male_46bab73a:
    samantha.say "Как понять, что блондинка с кем-то встречается?"

# ch/samantha/chat.rpy:630
translate russian samantha_love_2_male_b3a35d92:
    mike.say "Не знаю."

# ch/samantha/chat.rpy:631
translate russian samantha_love_2_male_fcdba033:
    samantha.say "По отпечатку пряжки на лбу."

# ch/samantha/chat.rpy:632
translate russian samantha_love_2_male_deb610f9:
    samantha.say "А как узнать парня блондинки?"

# ch/samantha/chat.rpy:633
translate russian samantha_love_2_male_e25d5ce4:
    mike.say "Тоже не знаю."

# ch/samantha/chat.rpy:634
translate russian samantha_love_2_male_27d57043:
    samantha.say "У него пряжка ремня совпадает с отпечатком у неё на лбу."

# ch/samantha/chat.rpy:638
translate russian samantha_love_2_male_dd7dd6da:
    mike.say "Кексик, когда у тебя день рождения?"

# ch/samantha/chat.rpy:640
translate russian samantha_love_2_male_06a38dc6:
    mike.say "Саманта, когда у тебя день рождения?"

# ch/samantha/chat.rpy:641
translate russian samantha_love_2_male_9dd3c8a4:
    samantha.say "[samantha.birthday[1]]-го числа [lssb_samantha.season_text(samantha.birthday[0])]."

# ch/samantha/chat.rpy:642
translate russian samantha_love_2_male_c8a2561a:
    samantha.say "Собираешься подарить мне подарок?"

# ch/samantha/chat.rpy:643
translate russian samantha_love_2_male_79dbb238:
    mike.say "Возможно..."

# ch/samantha/chat.rpy:646
translate russian samantha_love_2_male_97ec04c6:
    mike.say "Советы у меня не очень получаются."

# ch/samantha/chat.rpy:647
translate russian samantha_love_2_male_32a82c13:
    mike.say "Саркастический комментарий не интересует?"

# ch/samantha/chat.rpy:654
translate russian samantha_love_3_male_4c2c4785:
    samantha.say "Как парню понять, что у него много спермы?"

# ch/samantha/chat.rpy:655
translate russian samantha_love_3_male_1433982f:
    mike.say "Не знаю."

# ch/samantha/chat.rpy:656
translate russian samantha_love_3_male_a73cc24c:
    samantha.say "Если девушке приходится жевать, прежде чем проглотить."

# ch/samantha/chat.rpy:658
translate russian samantha_love_3_male_766e9bf3:
    samantha.say "Знаешь..."

# ch/samantha/chat.rpy:659
translate russian samantha_love_3_male_4cf775c5:
    mike.say "Что?"

# ch/samantha/chat.rpy:660
translate russian samantha_love_3_male_88e83c42:
    samantha.say "Только никому не говори: у меня есть странная сексуальная слабость..."

# ch/samantha/chat.rpy:661
translate russian samantha_love_3_male_522f10c2:
    samantha.say "Люблю сосать почти так же сильно, как трахаться..."

# ch/samantha/chat.rpy:662
translate russian samantha_love_3_male_f2a1b906:
    mike.say "Интересно."

# ch/samantha/chat.rpy:664
translate russian samantha_love_3_male_46897968:
    samantha.say "На днях ходила в кино..."

# ch/samantha/chat.rpy:665
translate russian samantha_love_3_male_a3688355:
    samantha.say "Там одна девушка отсасывала своему парню..."

# ch/samantha/chat.rpy:666
translate russian samantha_love_3_male_853871bf:
    samantha.say "Видела, как он обкончал ей всё лицо."

# ch/samantha/chat.rpy:667
translate russian samantha_love_3_male_f9ab42ff:
    samantha.say "Она убрала всё языком и пальцами..."

# ch/samantha/chat.rpy:668
translate russian samantha_love_3_male_6a1d457a:
    samantha.say "Это было так горячо."

# ch/samantha/chat.rpy:670
translate russian samantha_love_3_male_6a1770d8:
    samantha.say "Я бы сейчас с удовольствием съела банан."

# ch/samantha/chat.rpy:673
translate russian samantha_love_3_male_bceab28b:
    samantha.say "Скажи вслух «невеста»."

# ch/samantha/chat.rpy:674
translate russian samantha_love_3_male_b7b167de:
    mike.say "Невеста."

# ch/samantha/chat.rpy:677
translate russian samantha_love_3_male_3a341f03:
    samantha.say "Так у тебя есть девушка?"

# ch/samantha/chat.rpy:678
translate russian samantha_love_3_male_371b8676:
    mike.say "..."

# ch/samantha/chat.rpy:681
translate russian samantha_love_3_male_8e6dfbeb:
    samantha.say "Так у тебя есть девушка?"

# ch/samantha/chat.rpy:682
translate russian samantha_love_3_male_d9f90f21:
    samantha.say "Я спрашиваю между прочим. Это мой непринуждённый голос. На пристальный взгляд не обращай внимания."

# ch/samantha/chat.rpy:684
translate russian samantha_love_3_male_8e6dfbeb_1:
    samantha.say "Так у тебя есть девушка?"

# ch/samantha/chat.rpy:691
translate russian samantha_love_4_male_678571c2:
    samantha.say "Чем блондинка отличается от комара?"

# ch/samantha/chat.rpy:692
translate russian samantha_love_4_male_1433982f:
    mike.say "Не знаю."

# ch/samantha/chat.rpy:693
translate russian samantha_love_4_male_8c8ab01d:
    samantha.say "Комар перестаёт сосать, когда его шлёпнешь."

# ch/samantha/chat.rpy:695
translate russian samantha_love_4_male_e9f7a958:
    samantha.say "Никогда не пробовала анальный секс..."

# ch/samantha/chat.rpy:696
translate russian samantha_love_4_male_fed413e8:
    mike.say "Знаешь, мы могли бы это исправить."

# ch/samantha/chat.rpy:698
translate russian samantha_love_4_male_557496c2:
    samantha.say "Мне нравятся анекдоты про блондинок."

# ch/samantha/chat.rpy:699
translate russian samantha_love_4_male_81cc9f56:
    mike.say "Я заметил."

# ch/samantha/chat.rpy:701
translate russian samantha_love_4_male_974c94c7:
    samantha.say "Разве девушки, которые не скрывают своих желаний, не самые сексуальные?"

# ch/samantha/chat.rpy:703
translate russian samantha_love_4_male_a834e6c3:
    samantha.say "Я бы сейчас с удовольствием съела пирожное с кремом..."

# ch/samantha/chat.rpy:710
translate russian samantha_love_5_male_de74d976:
    samantha.say "Что такое доверие?"

# ch/samantha/chat.rpy:711
translate russian samantha_love_5_male_1433982f:
    mike.say "Не знаю."

# ch/samantha/chat.rpy:712
translate russian samantha_love_5_male_92e0f043:
    samantha.say "Два каннибала делают друг другу минет."

# ch/samantha/chat.rpy:714
translate russian samantha_love_5_male_3e17cbbe:
    samantha.say "Знаешь, у меня совсем нет рвотного рефлекса?"

# ch/samantha/chat.rpy:716
translate russian samantha_love_5_male_699648e7:
    samantha.say "На днях смотрела порно: у девушки всё лицо было в сперме дюжины парней."

# ch/samantha/chat.rpy:717
translate russian samantha_love_5_male_ce435907:
    samantha.say "Мне показалось, она немного похожа на меня."

# ch/samantha/chat.rpy:719
translate russian samantha_love_5_male_c461bd64:
    samantha.say "Ну как живётся с соседками?"

# ch/samantha/chat.rpy:722
translate russian samantha_love_5_male_16196ee5:
    samantha.say "Кажется, ближе друга, чем ты, у меня никогда не было."

# ch/samantha/chat.rpy:723
translate russian samantha_love_5_male_a6a6682f:
    samantha.say "Странно говорить такое мужчине, который знает, какие звуки я издаю в душе, но вот так."

# ch/samantha/chat.rpy:726
translate russian samantha_love_5_male_16196ee5_1:
    samantha.say "Кажется, ближе друга, чем ты, у меня никогда не было."

# ch/samantha/chat.rpy:727
translate russian samantha_love_5_male_876dbc57:
    samantha.say "Ты единственный в моём телефоне, кому не нужен свежий отчёт о разводе."

# ch/samantha/chat.rpy:728
translate russian samantha_love_5_male_4812d284:
    mike.say "А ты хочешь рассказать?"

# ch/samantha/chat.rpy:729
translate russian samantha_love_5_male_b0d7579b:
    samantha.say "Боже, нет. Расскажи, как прошёл твой день. Подробно. Медленно."

# ch/samantha/chat.rpy:731
translate russian samantha_love_5_male_16196ee5_2:
    samantha.say "Кажется, ближе друга, чем ты, у меня никогда не было."

# ch/samantha/chat.rpy:739
translate russian samantha_good_sweet_talk_male_0568d061:
    mike.say "До сих пор не совсем верю, что ты сказала «да», Кексик."

# ch/samantha/chat.rpy:741
translate russian samantha_good_sweet_talk_male_543f4ed6:
    mike.say "До сих пор не совсем верю, что ты сказала «да», Сэм."

# ch/samantha/chat.rpy:743
translate russian samantha_good_sweet_talk_male_0a219ba4:
    samantha.say "Я тоже. А ведь сама это сказала."

# ch/samantha/chat.rpy:745
translate russian samantha_good_sweet_talk_male_0f005b68:
    samantha.say "Только пока не заводи меня разговором о торте, [lssb_samantha.hero_name()]."

# ch/samantha/chat.rpy:746
translate russian samantha_good_sweet_talk_male_38546b3f:
    samantha.say "Если начну — весь вечер пропадёт."

# ch/samantha/chat.rpy:749
translate russian samantha_good_sweet_talk_male_9c558b9a:
    mike.say "Часть меня до сих пор не верит, что мы наконец вместе, Кексик."

# ch/samantha/chat.rpy:751
translate russian samantha_good_sweet_talk_male_07fb97a8:
    mike.say "Часть меня до сих пор не верит, что мы наконец вместе, Сэм."

# ch/samantha/chat.rpy:752
translate russian samantha_good_sweet_talk_male_d033f157:
    mike.say "Ущипнул бы себя, но боюсь проснуться!"

# ch/samantha/chat.rpy:754
translate russian samantha_good_sweet_talk_male_b1a1d689:
    samantha.say "Я тоже, [lssb_samantha.hero_name()]."

# ch/samantha/chat.rpy:755
translate russian samantha_good_sweet_talk_male_51973310:
    samantha.say "Мы долго к этому шли."

# ch/samantha/chat.rpy:757
translate russian samantha_good_sweet_talk_male_d8bb7400:
    samantha.say "Но оно того стоило!"

# ch/samantha/chat.rpy:759
translate russian samantha_good_sweet_talk_male_a294deda:
    mike.say "Знаешь, почему я называю тебя своим кексиком, Сэм?"

# ch/samantha/chat.rpy:760
translate russian samantha_good_sweet_talk_male_9556569b:
    mike.say "Потому что ты сладкая и с тобой всё становится лучше!"

# ch/samantha/chat.rpy:762
translate russian samantha_good_sweet_talk_male_56e967d7:
    samantha.say "Ой, перестань!"

# ch/samantha/chat.rpy:764
translate russian samantha_good_sweet_talk_male_064506d2:
    samantha.say "Хотя не переставай. Люблю, когда ты так обо мне говоришь!"

# ch/samantha/chat.rpy:767
translate russian samantha_good_sweet_talk_male_dbfef515:
    mike.say "Так рад, что мы не потеряли связь после твоего переезда, Кексик."

# ch/samantha/chat.rpy:769
translate russian samantha_good_sweet_talk_male_f091bceb:
    mike.say "Так рад, что мы не потеряли связь после твоего переезда, Сэм."

# ch/samantha/chat.rpy:770
translate russian samantha_good_sweet_talk_male_7d7a24e5:
    mike.say "Не знаю, что бы делал без такой подруги."

# ch/samantha/chat.rpy:772
translate russian samantha_good_sweet_talk_male_30d6bc21:
    samantha.say "О-о... как мило!"

# ch/samantha/chat.rpy:773
translate russian samantha_good_sweet_talk_male_33730f65:
    samantha.say "Я чувствую к тебе то же самое."

# ch/samantha/chat.rpy:780
translate russian samantha_bad_sweet_talk_male_4337338e:
    mike.say "Зачем я столько времени искал любовь, Кексик?"

# ch/samantha/chat.rpy:782
translate russian samantha_bad_sweet_talk_male_a12b6f77:
    mike.say "Зачем я столько времени искал любовь, Сэм?"

# ch/samantha/chat.rpy:783
translate russian samantha_bad_sweet_talk_male_1535b763:
    mike.say "Когда ты была прямо у меня под носом!"

# ch/samantha/chat.rpy:785
translate russian samantha_bad_sweet_talk_male_d5e35cfa:
    samantha.say "Ого... звучит так, будто меня можно было просто взять!"

# ch/samantha/chat.rpy:786
translate russian samantha_bad_sweet_talk_male_d0f04823:
    samantha.say "Будто ты стоял в очереди, чтобы на мне прокатиться!"

# ch/samantha/chat.rpy:788
translate russian samantha_bad_sweet_talk_male_3a4b3def:
    mike.say "Э-э, нет... я не это имел в виду, Кексик!"

# ch/samantha/chat.rpy:790
translate russian samantha_bad_sweet_talk_male_dbe6f131:
    mike.say "Э-э, нет... я не это имел в виду, Сэм!"

# ch/samantha/condom.rpy:4
translate russian samantha_use_condom_351a09f1:
    "Но как бы нам обоим ни хотелось, это не повод рисковать."

# ch/samantha/condom.rpy:6
translate russian samantha_use_condom_5a65bcc9:
    mike.say "На тумбочке у кровати, Кексик..."

# ch/samantha/condom.rpy:8
translate russian samantha_use_condom_3354e627:
    mike.say "На тумбочке у кровати, Сэм..."

# ch/samantha/condom.rpy:9
translate russian samantha_use_condom_76b4ed93:
    samantha.say "Что?"

# ch/samantha/condom.rpy:10
translate russian samantha_use_condom_be8852e6:
    mike.say "Презервативы. Они на тумбочке!"

# ch/samantha/condom.rpy:11
translate russian samantha_use_condom_0cb998b2:
    samantha.say "А, точно. Хорошо, что вспомнил!"

# ch/samantha/condom.rpy:12
translate russian samantha_use_condom_98bcab81:
    "Сэм наклоняется и берёт презерватив."

# ch/samantha/condom.rpy:13
translate russian samantha_use_condom_6f240200:
    "Потом вскрывает упаковку и раскатывает его по моему члену."

# ch/samantha/condom.rpy:14
translate russian samantha_use_condom_d0a062e8:
    "Теперь всё готово."

# ch/samantha/condom.rpy:16
translate russian samantha_use_condom_9270bede:
    "Вдруг я замираю и хлопаю себя по лбу."

# ch/samantha/condom.rpy:17
translate russian samantha_use_condom_04a02639:
    samantha.say "Что такое, [lssb_samantha.hero_name()]?"

# ch/samantha/condom.rpy:18
translate russian samantha_use_condom_e2388b0e:
    samantha.say "Судорога, что ли?"

# ch/samantha/condom.rpy:20
translate russian samantha_use_condom_bf9bd93e:
    mike.say "Нет, Кексик..."

# ch/samantha/condom.rpy:22
translate russian samantha_use_condom_7d490eab:
    mike.say "Нет, Сэм..."

# ch/samantha/condom.rpy:23
translate russian samantha_use_condom_4bda1a82:
    mike.say "Просто вспомнил, что нужен презерватив."

# ch/samantha/condom.rpy:24
translate russian samantha_use_condom_b720f205:
    samantha.say "А, точно."

# ch/samantha/condom.rpy:25
translate russian samantha_use_condom_35ff0593:
    samantha.say "Хорошо, что вспомнил!"

# ch/samantha/condom.rpy:26
translate russian samantha_use_condom_c833342f:
    "Мне хватает пары секунд, чтобы взять презерватив."

# ch/samantha/condom.rpy:27
translate russian samantha_use_condom_1c32da9b:
    "Стоит его надеть — и мы готовы продолжать."

# ch/samantha/condom.rpy:29
translate russian samantha_use_condom_91e95b3a:
    mike.say "Эм..."

# ch/samantha/condom.rpy:30
translate russian samantha_use_condom_eab51ddb:
    mike.say "Нам стоит..."

# ch/samantha/condom.rpy:31
translate russian samantha_use_condom_0a9a04c0:
    mike.say "Нам нужен презерватив!"

# ch/samantha/condom.rpy:32
translate russian samantha_use_condom_4455c95c:
    "Сэм замирает, будто совершенно об этом забыла."

# ch/samantha/condom.rpy:33
translate russian samantha_use_condom_cbae0c89:
    "А потом согласно кивает."

# ch/samantha/condom.rpy:34
translate russian samantha_use_condom_cd085712:
    samantha.say "Да-да, давай наденем."

# ch/samantha/condom.rpy:35
translate russian samantha_use_condom_97aa3796:
    samantha.say "В моих фантазиях такой проблемы не было!"

# ch/samantha/condom.rpy:36
translate russian samantha_use_condom_d3782ff4:
    "Сэм терпеливо ждёт, пока я беру презерватив и вскрываю упаковку."

# ch/samantha/condom.rpy:37
translate russian samantha_use_condom_98e23683:
    "Потом помогает раскатать его по моему члену."

# ch/samantha/condom.rpy:38
translate russian samantha_use_condom_369dd6b6:
    "Готово, можно продолжать!"

# ch/samantha/condom.rpy:40
translate russian samantha_use_condom_c0a4ccf3:
    "Но сначала нужно позаботиться о защите."

# ch/samantha/condom.rpy:41
translate russian samantha_use_condom_e3ce8724:
    "Поэтому я поднимаю руку, слезаю с кровати и иду к тумбочке."

# ch/samantha/condom.rpy:42
translate russian samantha_use_condom_a8e5e0a7:
    mike.say "Секунду, Сэм..."

# ch/samantha/condom.rpy:43
translate russian samantha_use_condom_5d8ac1d7:
    mike.say "Нужно кое-что взять."

# ch/samantha/condom.rpy:44
translate russian samantha_use_condom_eec42dc0:
    "Сэм смотрит на меня с неподдельным удивлением."

# ch/samantha/condom.rpy:45
translate russian samantha_use_condom_408eea68:
    "Её можно понять: уверен, раньше ни один парень не терял к ней интерес на таком этапе."

# ch/samantha/condom.rpy:47
translate russian samantha_use_condom_87e584c4:
    samantha.say "Куда ты, [lssb_samantha.hero_name()]?"

# ch/samantha/condom.rpy:48
translate russian samantha_use_condom_96475a96:
    samantha.say "Я что-то сделала не так?"

# ch/samantha/condom.rpy:50
translate russian samantha_use_condom_a3385711:
    samantha.say "Что ты делаешь?"

# ch/samantha/condom.rpy:51
translate russian samantha_use_condom_b155a598:
    samantha.say "Что-то не так?"

# ch/samantha/condom.rpy:52
translate russian samantha_use_condom_f6b01497:
    "Пока Сэм всё это произносит, я уже нахожу нужное."

# ch/samantha/condom.rpy:53
translate russian samantha_use_condom_a139fa16:
    "Когда показываю презерватив, на её лице появляется облегчение."

# ch/samantha/condom.rpy:54
translate russian samantha_use_condom_7cb294e6:
    "Она охотно кивает, пока я возвращаюсь, уже разрывая упаковку."

# ch/samantha/condom.rpy:55
translate russian samantha_use_condom_7230e442:
    "Потом помогает его надеть, и мы готовы продолжать."

# ch/samantha/condom.rpy:57
translate russian samantha_use_condom_795e39f7:
    samantha.say "Ты посмотри, какой осторожный."

# ch/samantha/condom.rpy:58
translate russian samantha_use_condom_bdb3dd66:
    samantha.say "Он никогда таким не бывает. Это не ему комплимент, [lssb_samantha.hero_name()], а тебе."

# ch/samantha/condom.rpy:70
translate russian samantha_warn_condom_8f0951c6:
    samantha.say "Подожди минутку..."

# ch/samantha/condom.rpy:71
translate russian samantha_warn_condom_806b4748:
    samantha.say "Нам нужен презерватив!"

# ch/samantha/condom.rpy:73
translate russian samantha_warn_condom_e55b4f43:
    samantha.say "Ой, погоди..."

# ch/samantha/condom.rpy:74
translate russian samantha_warn_condom_f2699d72:
    samantha.say "Нам действительно стоит воспользоваться презервативом!"

# ch/samantha/condom.rpy:76
translate russian samantha_warn_condom_6e64e82b:
    "Но тут она останавливается, будто что-то вспомнила."

# ch/samantha/condom.rpy:77
translate russian samantha_warn_condom_a48c8530:
    samantha.say "Упс!"

# ch/samantha/condom.rpy:78
translate russian samantha_warn_condom_e3fa0032:
    samantha.say "Нам нужен презерватив, [lssb_samantha.hero_name()]!"

# ch/samantha/condom.rpy:80
translate russian samantha_warn_condom_e6eb38f9:
    "Но прежде чем я продолжаю, Сэм поднимает руку, останавливая меня."

# ch/samantha/condom.rpy:81
translate russian samantha_warn_condom_1ccab2e1:
    mike.say "Хм..."

# ch/samantha/condom.rpy:82
translate russian samantha_warn_condom_e3507b3c:
    mike.say "Что такое, Сэм?"

# ch/samantha/condom.rpy:84
translate russian samantha_warn_condom_b7756033:
    samantha.say "Прости, [lssb_samantha.hero_name()]..."

# ch/samantha/condom.rpy:85
translate russian samantha_warn_condom_8b7af7d4:
    samantha.say "Но можно с презервативом?"

# ch/samantha/condom.rpy:87
translate russian samantha_warn_condom_6a0c0c4b:
    samantha.say "Нам нужен презерватив, [lssb_samantha.hero_name()]..."

# ch/samantha/condom.rpy:89
translate russian samantha_warn_condom_5a6cae7a:
    samantha.say "Знаю-знаю. Поезд ушёл и весь вокзал с собой унёс."

# ch/samantha/condom.rpy:90
translate russian samantha_warn_condom_9f403690:
    samantha.say "Всё равно подыграй мне. Мне нравится, когда ты обо мне заботишься."

# ch/samantha/condom.rpy:92
translate russian samantha_warn_condom_7514dec8:
    samantha.say "И прежде чем состришь — да, я об этом думала."

# ch/samantha/condom.rpy:93
translate russian samantha_warn_condom_a9bef2cb:
    samantha.say "Ребёнок его бы добил. Именно поэтому я не дам этому случиться случайно."

# ch/samantha/condom.rpy:95
translate russian samantha_warn_condom_1f3c95f6:
    samantha.say "Правила дома, [lssb_samantha.hero_name()]. На тебя он согласился. На сюрпризы — нет."

# ch/samantha/condom.rpy:97
translate russian samantha_warn_condom_14a90cbe:
    samantha.say "Мне нужно, чтобы, когда я отсчитаю назад на пальцах, всё сошлось."

# ch/samantha/condom.rpy:98
translate russian samantha_warn_condom_1d5f77bc:
    samantha.say "Это наименее романтичная фраза в моей жизни, но я всё равно права."

# ch/samantha/condom.rpy:100
translate russian samantha_warn_condom_7cc54c3c:
    samantha.say "Но не навсегда, заметь."

# ch/samantha/condom.rpy:101
translate russian samantha_warn_condom_2a052d1b:
    samantha.say "Однажды вечером я не попрошу. Ты сразу поймёшь, что это за вечер."

# ch/samantha/condom.rpy:107
translate russian samantha_force_condom_b2ea92a9:
    samantha.say "Не переживай."

# ch/samantha/condom.rpy:108
translate russian samantha_force_condom_838df2e7:
    samantha.say "У меня есть!"

# ch/samantha/condom.rpy:109
translate russian samantha_force_condom_a55251fb:
    "Сэм слезает с меня, затем с кровати."

# ch/samantha/condom.rpy:110
translate russian samantha_force_condom_a2a2418f:
    "Какое-то время роется в своей одежде."

# ch/samantha/condom.rpy:111
translate russian samantha_force_condom_3e275b3b:
    "И возвращается с презервативом."

# ch/samantha/condom.rpy:112
translate russian samantha_force_condom_f54d7155:
    "Вскрывая упаковку, Сэм снова забирается на меня."

# ch/samantha/condom.rpy:113
translate russian samantha_force_condom_c53e8aec:
    "Потом надевает его на мой член, и мы готовы продолжать."

# ch/samantha/condom.rpy:115
translate russian samantha_force_condom_cd09cc0a:
    samantha.say "Всё нормально..."

# ch/samantha/condom.rpy:116
translate russian samantha_force_condom_1b505df5:
    samantha.say "У меня есть в сумочке!"

# ch/samantha/condom.rpy:117
translate russian samantha_force_condom_c833342f:
    "Мне хватает пары секунд, чтобы взять презерватив."

# ch/samantha/condom.rpy:118
translate russian samantha_force_condom_1c32da9b:
    "Стоит его надеть — и мы готовы продолжать."

# ch/samantha/condom.rpy:120
translate russian samantha_force_condom_059b872f:
    samantha.say "Не волнуйся, [lssb_samantha.hero_name()]."

# ch/samantha/condom.rpy:121
translate russian samantha_force_condom_2d94df1a:
    samantha.say "Я уже тысячу раз прокрутила это в голове."

# ch/samantha/condom.rpy:122
translate russian samantha_force_condom_ea64baae:
    samantha.say "И предусмотрела все варианты!"

# ch/samantha/condom.rpy:123
translate russian samantha_force_condom_7ce33071:
    "Сэм показывает презерватив и передаёт мне."

# ch/samantha/condom.rpy:124
translate russian samantha_force_condom_972eb22d:
    "Терпеливо ждёт, пока я беру его и вскрываю упаковку."

# ch/samantha/condom.rpy:125
translate russian samantha_force_condom_d15f2eb0:
    "Потом помогает раскатать его по моему члену."

# ch/samantha/condom.rpy:126
translate russian samantha_force_condom_369dd6b6:
    "Готово, можно продолжать!"

# ch/samantha/condom.rpy:128
translate russian samantha_force_condom_5f71d168:
    "Сэм указывает на одежду, сброшенную возле кровати."

# ch/samantha/condom.rpy:129
translate russian samantha_force_condom_7129dfad:
    samantha.say "Там, в моём кармане, есть один."

# ch/samantha/condom.rpy:130
translate russian samantha_force_condom_8a3c6b3b:
    "Не могу поверить, что сам забыл взять."

# ch/samantha/condom.rpy:131
translate russian samantha_force_condom_a7783a50:
    "Я подчёркнуто киваю и делаю, как просит Сэм."

# ch/samantha/condom.rpy:132
translate russian samantha_force_condom_e640b878:
    "Быстро нахожу презерватив в её кармане."

# ch/samantha/condom.rpy:133
translate russian samantha_force_condom_7cb294e6:
    "Она охотно кивает, пока я возвращаюсь, уже разрывая упаковку."

# ch/samantha/condom.rpy:134
translate russian samantha_force_condom_7230e442:
    "Потом помогает его надеть, и мы готовы продолжать."

# ch/samantha/condom.rpy:136
translate russian samantha_force_condom_de08729f:
    samantha.say "Знаю. Этот поезд давно ушёл."

# ch/samantha/condom.rpy:137
translate russian samantha_force_condom_2c899f02:
    samantha.say "Оставь мне хоть то, что я ещё могу решать, ладно?"

# ch/samantha/condom.rpy:139
translate russian samantha_force_condom_708f6ea9:
    samantha.say "Не спрашивай, почему он у меня с собой."

# ch/samantha/condom.rpy:140
translate russian samantha_force_condom_d64dbb0e:
    samantha.say "Замужние женщины тоже имеют право на секреты, [lssb_samantha.hero_name()]. Этот я храню в сумочке."

# ch/samantha/condom.rpy:147
translate russian samantha_mad_condom_8dd85c62:
    mike.say "Ты серьёзно, Кексик?"

# ch/samantha/condom.rpy:149
translate russian samantha_mad_condom_8022bd32:
    mike.say "Ты серьёзно, Сэм?"

# ch/samantha/condom.rpy:150
translate russian samantha_mad_condom_ef0555f7:
    mike.say "Минуту назад умоляла продолжать..."

# ch/samantha/condom.rpy:151
translate russian samantha_mad_condom_699962d3:
    mike.say "А теперь просишь надеть презерватив?"

# ch/samantha/condom.rpy:152
translate russian samantha_mad_condom_6ba2e185:
    samantha.say "Да, [lssb_samantha.hero_name()]."

# ch/samantha/condom.rpy:153
translate russian samantha_mad_condom_d596647b:
    samantha.say "Именно это я и делаю!"

# ch/samantha/condom.rpy:154
translate russian samantha_mad_condom_b33718d7:
    samantha.say "Хочешь сказать, не наденешь?"

# ch/samantha/condom.rpy:155
translate russian samantha_mad_condom_b8f26fa3:
    mike.say "Нет, не надену. Давай просто продолжим!"

# ch/samantha/condom.rpy:156
translate russian samantha_mad_condom_a70f6944:
    "Сэм качает головой, слезает с меня и спрыгивает с кровати."

# ch/samantha/condom.rpy:157
translate russian samantha_mad_condom_1ce45e04:
    "Начинает собирать одежду и одеваться."

# ch/samantha/condom.rpy:158
translate russian samantha_mad_condom_9a43ceb0:
    samantha.say "Если ты так настроен, я кончу как-нибудь иначе!"

# ch/samantha/condom.rpy:159
translate russian samantha_mad_condom_4cf775c5:
    mike.say "Что?"

# ch/samantha/condom.rpy:161
translate russian samantha_mad_condom_a2a9c903:
    mike.say "Кексик, вернись!"

# ch/samantha/condom.rpy:163
translate russian samantha_mad_condom_04ce7121:
    mike.say "Сэм, вернись!"

# ch/samantha/condom.rpy:164
translate russian samantha_mad_condom_3b3bd1be:
    "Но всё бесполезно."

# ch/samantha/condom.rpy:165
translate russian samantha_mad_condom_1708500d:
    "Одеваясь, Сэм просто игнорирует меня."

# ch/samantha/condom.rpy:166
translate russian samantha_mad_condom_8c6c3eb9:
    "Потом уходит, хлопнув дверью."

# ch/samantha/condom.rpy:169
translate russian samantha_mad_condom_e980cfe6:
    mike.say "О чём ты, Кексик?"

# ch/samantha/condom.rpy:171
translate russian samantha_mad_condom_150eb151:
    mike.say "О чём ты, Сэм?"

# ch/samantha/condom.rpy:172
translate russian samantha_mad_condom_7f225132:
    mike.say "Минуту назад ты умоляла тебя трахнуть."

# ch/samantha/condom.rpy:173
translate russian samantha_mad_condom_0078f929:
    mike.say "А теперь велишь остановиться!"

# ch/samantha/condom.rpy:174
translate russian samantha_mad_condom_2648806d:
    samantha.say "Почему ты так себя ведёшь, [lssb_samantha.hero_name()]?"

# ch/samantha/condom.rpy:175
translate russian samantha_mad_condom_e7cd6ca3:
    samantha.say "Я всего лишь прошу надеть презерватив."

# ch/samantha/condom.rpy:176
translate russian samantha_mad_condom_800a8ffb:
    samantha.say "Боже... иногда ты такой придурок!"

# ch/samantha/condom.rpy:177
translate russian samantha_mad_condom_1d605a5f:
    "Сэм слезает с кровати и начинает одеваться."

# ch/samantha/condom.rpy:178
translate russian samantha_mad_condom_fb8993dd:
    mike.say "Ох..."

# ch/samantha/condom.rpy:180
translate russian samantha_mad_condom_b45c727a:
    mike.say "Да ладно тебе, Кексик!"

# ch/samantha/condom.rpy:182
