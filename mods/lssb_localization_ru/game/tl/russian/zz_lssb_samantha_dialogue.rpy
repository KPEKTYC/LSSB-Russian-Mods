# ch/samantha/events.rpy:8028
translate russian samantha_birthday_date_male_78238723:
    samantha.say "Знаешь, если бы здесь сейчас был Райан, он бы уже изводил меня."

# ch/samantha/events.rpy:8029
translate russian samantha_birthday_date_male_70409bd2:
