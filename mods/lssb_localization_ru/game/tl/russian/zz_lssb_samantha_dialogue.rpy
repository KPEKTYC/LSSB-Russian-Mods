    samantha.say "Ревнуешь?"

# ch/samantha/date.rpy:623
translate russian samantha_halloween_arrival_6f0daf3a:
    samantha.say "К чему именно?"

# ch/samantha/date.rpy:625
translate russian samantha_halloween_arrival_2765f185:
    mike.say "К другим парням, которые на тебя смотрят, Кексик."

