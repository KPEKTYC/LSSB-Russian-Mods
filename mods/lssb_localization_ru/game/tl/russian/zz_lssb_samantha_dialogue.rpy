# ch/samantha/base.rpy:677
translate russian samantha_ask_date_emma_samantha_637edda5:
    mike.say "Хочешь встретиться с Эммой и развлечься?"

# ch/samantha/base.rpy:679
translate russian samantha_ask_date_emma_samantha_4e6ca07a:
    samantha.say "С удовольствием."

# ch/samantha/base.rpy:690
translate russian samantha_ask_date_emma_samantha_327743c4:
    samantha.say "Прости, [lssb_samantha.hero_name()], я бы предпочла, чтобы ты достался только мне."

