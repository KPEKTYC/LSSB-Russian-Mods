# ch/samantha/events.rpy:8403
translate russian samantha_birthday_sex_33b73c96:
    samantha.say "Вставь мне, [lssb_samantha.hero_name()]!"

# ch/samantha/events.rpy:8404
translate russian samantha_birthday_sex_8872ee4d:
    samantha.say "От твоего члена мне ТАК хорошо!"

# ch/samantha/events.rpy:8405
translate russian samantha_birthday_sex_601b0b54:
    "Теперь я вошёл в Сэм по самые яйца."

# ch/samantha/events.rpy:8406
translate russian samantha_birthday_sex_c535a17d:
