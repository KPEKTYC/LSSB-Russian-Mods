translate russian samantha_desire_1_male_1b8dd097:
    samantha.say "Знаешь, ненавижу воскресенья..."

# ch/samantha/chat.rpy:163
translate russian samantha_desire_1_male_57276d50:
    mike.say "Почему?"

# ch/samantha/chat.rpy:164
translate russian samantha_desire_1_male_ded2f51b:
