# ch/samantha/chat.rpy:167
translate russian samantha_desire_1_male_df33f98c:
    samantha.say "Знаешь, я обнаружила, что сон прекрасно расслабляет."

# ch/samantha/chat.rpy:168
translate russian samantha_desire_1_male_9718cc85:
    mike.say "Да?"

# ch/samantha/chat.rpy:169
translate russian samantha_desire_1_male_f89235c5:
    samantha.say "И это ещё и интересно."

# ch/samantha/chat.rpy:170
translate russian samantha_desire_1_male_8a5c4b01:
