# ch/samantha/gift.rpy:178
translate russian samantha_gift_slutty_dress_male_ad18ae34:
    "Конечно, Сэм довольно самоуверенно решила, что коробка за моей спиной предназначена ей."

# ch/samantha/gift.rpy:179
translate russian samantha_gift_slutty_dress_male_0e61c6a5:
    "Но кого я, чёрт возьми, пытаюсь обмануть?"

# ch/samantha/gift.rpy:180
translate russian samantha_gift_slutty_dress_male_0fbf6c17:
    "Своей улыбкой она уже поймала меня на крючок."

# ch/samantha/gift.rpy:181
translate russian samantha_gift_slutty_dress_male_96f62702:
    "И теперь я полностью в её власти."

# ch/samantha/gift.rpy:182
translate russian samantha_gift_slutty_dress_male_1c370746:
    mike.say "Ха-ха..."

# ch/samantha/gift.rpy:183
translate russian samantha_gift_slutty_dress_male_c9254e53:
    mike.say "Да, раскусила ты меня, Сэм..."

# ch/samantha/gift.rpy:184
translate russian samantha_gift_slutty_dress_male_95c56d9d:
    mike.say "Я кое-что тебе купил."

# ch/samantha/gift.rpy:185
translate russian samantha_gift_slutty_dress_male_98b0a739:
    "Я достаю коробку из-за спины и протягиваю Сэм."

# ch/samantha/gift.rpy:186
translate russian samantha_gift_slutty_dress_male_868a82e0:
    "Она берёт её со скромной, благодарной улыбкой."

# ch/samantha/gift.rpy:187
translate russian samantha_gift_slutty_dress_male_a5f807e3:
    "От этого моё сердце бьётся ещё сильнее."

# ch/samantha/gift.rpy:189
translate russian samantha_gift_slutty_dress_male_8420c5f7:
    samantha.say "Спасибо, [lssb_samantha.hero_name()]."

# ch/samantha/gift.rpy:190
translate russian samantha_gift_slutty_dress_male_b9c1f7da:
    samantha.say "Не стоило..."

# ch/samantha/gift.rpy:191
translate russian samantha_gift_slutty_dress_male_7071ce55:
    samantha.say "Но я очень тронута."

# ch/samantha/gift.rpy:194
translate russian samantha_gift_slutty_dress_male_c72315ed:
    "Я продолжаю кивать, пока Сэм срывает обёрточную бумагу."

# ch/samantha/gift.rpy:195
translate russian samantha_gift_slutty_dress_male_a19ee842:
    "И умудряюсь сохранить улыбку, когда она открывает коробку."

# ch/samantha/gift.rpy:197
translate russian samantha_gift_slutty_dress_male_894374b6:
    "Затем слышу, как она ахает, доставая и рассматривая платье."

# ch/samantha/gift.rpy:198
translate russian samantha_gift_slutty_dress_male_12843f33:
    "Очень соблазнительное, облегающее платье, которое обещает не оставить ничего для воображения."

# ch/samantha/gift.rpy:199
translate russian samantha_gift_slutty_dress_male_2b84b113:
    mike.say "Ну как, Сэм..."

# ch/samantha/gift.rpy:200
translate russian samantha_gift_slutty_dress_male_a1c6a138:
    mike.say "Что думаешь?"

# ch/samantha/gift.rpy:201
translate russian samantha_gift_slutty_dress_male_ce7bf4ff:
    mike.say "Довольно смело, да?"

# ch/samantha/gift.rpy:203
translate russian samantha_gift_slutty_dress_male_fdec985e:
    "Она разворачивает вызывающее платье."

# ch/samantha/gift.rpy:205
translate russian samantha_gift_slutty_dress_male_8876fc8e:
    "Сэм поднимает на меня широко раскрытые глаза — надеюсь, от восхищения."

# ch/samantha/gift.rpy:206
translate russian samantha_gift_slutty_dress_male_eddbaa3d:
    "А затем медленно качает головой."

# ch/samantha/gift.rpy:208
translate russian samantha_gift_slutty_dress_male_bf21f3b0:
    samantha.say "Это довольно вызывающе, [lssb_samantha.hero_name()]…"

# ch/samantha/gift.rpy:209
translate russian samantha_gift_slutty_dress_male_2b200487:
    samantha.say "Но, кажется, мне нравится."

# ch/samantha/gift.rpy:211
translate russian samantha_gift_slutty_dress_male_24694e0a:
    "Мне нужна секунда, чтобы понять: Сэм отзывается о нём хорошо."

# ch/samantha/gift.rpy:212
translate russian samantha_gift_slutty_dress_male_7d817aa2:
    "И когда до меня наконец доходит, слова сами льются потоком."

# ch/samantha/gift.rpy:213
translate russian samantha_gift_slutty_dress_male_89d2bf47:
    mike.say "Ты..."

# ch/samantha/gift.rpy:214
translate russian samantha_gift_slutty_dress_male_f2364b3b:
    mike.say "То есть тебе нравится?"

# ch/samantha/gift.rpy:215
translate russian samantha_gift_slutty_dress_male_0b8d18b2:
    mike.say "Боже, какое облегчение!"

# ch/samantha/gift.rpy:216
translate russian samantha_gift_slutty_dress_male_1e2798e5:
    mike.say "Я ужасно боялся, что тебе не понравится..."

# ch/samantha/gift.rpy:217
translate russian samantha_gift_slutty_dress_male_4ff1ba58:
    mike.say "Что ты подумаешь..."

# ch/samantha/gift.rpy:218
translate russian samantha_gift_slutty_dress_male_d67bc49e:
    "Сэм поднимает руку и машет ею у меня перед лицом."

# ch/samantha/gift.rpy:219
translate russian samantha_gift_slutty_dress_male_bafcea8c:
    "Наконец я понимаю: этим жестом она просит меня замолчать."

# ch/samantha/gift.rpy:221
translate russian samantha_gift_slutty_dress_male_6d33d4fc:
    samantha.say "Успокойся, [lssb_samantha.hero_name()]…"

# ch/samantha/gift.rpy:222
translate russian samantha_gift_slutty_dress_male_4cb571b6:
    samantha.say "Ты уже заговариваешься!"

# ch/samantha/gift.rpy:223
translate russian samantha_gift_slutty_dress_male_38e0da29:
    samantha.say "Но да, мне нравится."

# ch/samantha/gift.rpy:227
translate russian samantha_gift_slutty_dress_male_d8703a45:
    samantha.say "Райан никогда бы не выпустил меня в таком наряде."

# ch/samantha/gift.rpy:228
translate russian samantha_gift_slutty_dress_male_c0170610:
    samantha.say "Я до сих пор ловлю себя на том, что жду запрета. Его здесь нет, запрещать некому, а я всё жду."

# ch/samantha/gift.rpy:229
translate russian samantha_gift_slutty_dress_male_5ad289d9:
    samantha.say "Впрочем, всё. Он не может мне запретить. Я надену это платье."

# ch/samantha/gift.rpy:231
translate russian samantha_gift_slutty_dress_male_d8703a45_1:
    samantha.say "Райан никогда бы не выпустил меня в таком наряде."

# ch/samantha/gift.rpy:232
translate russian samantha_gift_slutty_dress_male_77ac5ee9:
    samantha.say "Оказывается, теперь я могу решать это сама. И я решила: да."

# ch/samantha/gift.rpy:234
translate russian samantha_gift_slutty_dress_male_10ffca76:
    samantha.say "Райан никогда не выпустит меня из дома в таком."

# ch/samantha/gift.rpy:235
translate russian samantha_gift_slutty_dress_male_335931a3:
    samantha.say "И ладно: я ведь не для него собиралась его надевать."

# ch/samantha/gift.rpy:237
translate russian samantha_gift_slutty_dress_male_a99501a2:
    samantha.say "Райан никогда бы не выпустил меня из дома в чём-то подобном."

# ch/samantha/gift.rpy:238
translate russian samantha_gift_slutty_dress_male_1873fa37:
    samantha.say "Он до паранойи боится, что на меня будут смотреть другие мужчины."

# ch/samantha/gift.rpy:239
translate russian samantha_gift_slutty_dress_male_810a43f5:
    samantha.say "Так что платье будет жить в глубине шкафа. Только для нас."

# ch/samantha/gift.rpy:241
translate russian samantha_gift_slutty_dress_male_d8703a45_2:
    samantha.say "Райан никогда бы не выпустил меня в таком наряде."

# ch/samantha/gift.rpy:242
translate russian samantha_gift_slutty_dress_male_13a2102a:
    samantha.say "Он до паранойи боялся, что иначе на меня будут смотреть другие мужчины."

# ch/samantha/gift.rpy:243
translate russian samantha_gift_slutty_dress_male_316f45b9:
    samantha.say "А этот подарок говорит, что ты ценишь моё тело и при этом доверяешь мне."

# ch/samantha/gift.rpy:245
translate russian samantha_gift_slutty_dress_male_44ce834f:
    "Я с готовностью киваю, лишь поверхностно вникая в слова Сэм."

# ch/samantha/gift.rpy:246
translate russian samantha_gift_slutty_dress_male_5a168df6:
    "Меня куда больше занимает то, что она собирается его носить."

# ch/samantha/gift.rpy:252
translate russian samantha_gift_slutty_dress_male_8876fc8e_1:
    "Сэм поднимает на меня широко раскрытые глаза — надеюсь, от восхищения."

# ch/samantha/gift.rpy:253
translate russian samantha_gift_slutty_dress_male_eddbaa3d_1:
    "А затем медленно качает головой."

# ch/samantha/gift.rpy:255
translate russian samantha_gift_slutty_dress_male_bf21f3b0_1:
    samantha.say "Это довольно вызывающе, [lssb_samantha.hero_name()]…"

# ch/samantha/gift.rpy:256
translate russian samantha_gift_slutty_dress_male_0448837e:
    samantha.say "И я не думаю, что смогу это надеть."

# ch/samantha/gift.rpy:258
translate russian samantha_gift_slutty_dress_male_3b579d16:
    "Когда Сэм возвращает платье, я чувствую, как мои надежды рушатся."

# ch/samantha/gift.rpy:259
translate russian samantha_gift_slutty_dress_male_5b43ab9a:
    "Но переубеждать её, похоже, бессмысленно."

# ch/samantha/gift.rpy:260
translate russian samantha_gift_slutty_dress_male_dccac533:
    "По её лицу видно, что она уже всё решила."

# ch/samantha/gift.rpy:261
translate russian samantha_gift_slutty_dress_male_c65d906b:
    "И давить на неё из-за такого откровенного наряда кажется плохой идеей."

# ch/samantha/gift.rpy:262
translate russian samantha_gift_slutty_dress_male_d9eb9531:
    "Поэтому я беру платье и киваю."

# ch/samantha/gift.rpy:263
translate russian samantha_gift_slutty_dress_male_649609fc:
    mike.say "Ладно, Сэм..."

# ch/samantha/gift.rpy:264
translate russian samantha_gift_slutty_dress_male_bd41bc92:
    mike.say "Может, смогу вернуть его и получить деньги назад."

# ch/samantha/gift.rpy:265
translate russian samantha_gift_slutty_dress_male_cdae152c:
    mike.say "Или хотя бы попросить зачесть сумму в счёт следующей покупки."

# ch/samantha/gift.rpy:272
translate russian samantha_gift_collar_male_e952a5b4:
    mike.say "Если бы меня спросили о тебе всего пару месяцев назад, я бы сказал, что ты — моя упущенная любовь."

# ch/samantha/gift.rpy:273
translate russian samantha_gift_collar_male_6bb53abf:
    mike.say "Девушка, которую я всегда тайно любил, но так и не набрался смелости признаться ей."

# ch/samantha/gift.rpy:274
translate russian samantha_gift_collar_male_a75711df:
    mike.say "Но мне повезло получить второй шанс с тобой."

# ch/samantha/gift.rpy:275
translate russian samantha_gift_collar_male_1bd7e64d:
    mike.say "И я знаю, всё было непросто: Райан, свадьба и всё остальное..."

# ch/samantha/gift.rpy:276
translate russian samantha_gift_collar_male_dc1063fa:
    "Сэм собирается что-то сказать — скорее всего, возразить или заверить меня, что хаос, с которого всё началось, был не моей виной."

# ch/samantha/gift.rpy:277
translate russian samantha_gift_collar_male_ca187306:
    "Я поднимаю руку, мягко прося её подождать и дать мне договорить, прежде чем возражать."

# ch/samantha/gift.rpy:279
translate russian samantha_gift_collar_male_150382dc:
    mike.say "Знаю... знаю, что ты скажешь, Кексик."

# ch/samantha/gift.rpy:281
translate russian samantha_gift_collar_male_362ba086:
    mike.say "Знаю... знаю, что ты скажешь, Сэм."

# ch/samantha/gift.rpy:282
translate russian samantha_gift_collar_male_202c3da7:
    mike.say "Что ничего нельзя было поделать и всё к лучшему."

# ch/samantha/gift.rpy:283
translate russian samantha_gift_collar_male_9412c909:
    mike.say "И ты права, всё действительно к лучшему."

# ch/samantha/gift.rpy:284
translate russian samantha_gift_collar_male_2f8f4d6c:
    mike.say "Но я хочу, чтобы дальше у нас всё было хорошо, чтобы мы не повторяли прежних ошибок."

# ch/samantha/gift.rpy:285
translate russian samantha_gift_collar_male_84718bd8:
    "Я глубоко вздыхаю, собираясь с духом перед следующим шагом."

# ch/samantha/gift.rpy:287
translate russian samantha_gift_collar_male_bab7796e:
    mike.say "Я больше не собираюсь скрывать наши отношения, Кексик."

# ch/samantha/gift.rpy:289
translate russian samantha_gift_collar_male_1747f47f:
    mike.say "Я больше не собираюсь скрывать наши отношения, Сэм."

# ch/samantha/gift.rpy:290
translate russian samantha_gift_collar_male_3c433016:
    mike.say "Больше никаких тайных встреч за чужими спинами и никаких секретов о наших чувствах."

# ch/samantha/gift.rpy:291
translate russian samantha_gift_collar_male_77475a61:
    mike.say "Я... я хочу попросить тебя носить кое-что, что покажет всем: ты моя. Сделать это так, чтобы сомнений не осталось."

# ch/samantha/gift.rpy:292
translate russian samantha_gift_collar_male_f4a80da6:
    "Сэм, кажется, почти затаила дыхание, ожидая, когда я покажу, что именно прошу её носить."

# ch/samantha/gift.rpy:293
translate russian samantha_gift_collar_male_28c0513b:
    "Собрав всю свою смелость, я лезу в карман и достаю это."

# ch/samantha/gift.rpy:294
translate russian samantha_gift_collar_male_b917f457:
    "Держа в руках оба конца синего кожаного ремешка, я впервые показываю ей ошейник."

# ch/samantha/gift.rpy:295
translate russian samantha_gift_collar_male_88df5352:
    "Свет падает на подвеску в середине, и на миг в её изгибах трудно узнать кексик, который она изображает."

# ch/samantha/gift.rpy:296
translate russian samantha_gift_collar_male_8850387a:
    "На мгновение глаза Сэм раскрываются ещё шире; она молча осознаёт, что именно я хочу на неё надеть."

# ch/samantha/gift.rpy:297
translate russian samantha_gift_collar_male_4c4bcb70:
    "Затем она пару раз моргает, и её губы снова начинают двигаться."

# ch/samantha/gift.rpy:298
translate russian samantha_gift_collar_male_7d7437c5:
    samantha.say "Н... но... [lssb_samantha.hero_name()], это же похоже на собачий ошейник?!"

# ch/samantha/gift.rpy:299
translate russian samantha_gift_collar_male_8e9026d5:
    "Я киваю, не в силах спорить с очевидным."

# ch/samantha/gift.rpy:301
translate russian samantha_gift_collar_male_4d1ad262:
    mike.say "Потому что это он и есть, Кексик."

# ch/samantha/gift.rpy:303
translate russian samantha_gift_collar_male_813f2cae:
    mike.say "Потому что это он и есть, Сэм."

# ch/samantha/gift.rpy:304
translate russian samantha_gift_collar_male_bb3ee40d:
    "Она смотрит на меня так, будто я вдруг заговорил на иностранном языке; в глазах — непонимание."

# ch/samantha/gift.rpy:305
translate russian samantha_gift_collar_male_850fc336:
    samantha.say "Ты просишь меня о чём... притворяться твоей собакой?!"

# ch/samantha/gift.rpy:307
translate russian samantha_gift_collar_male_84b8aac9:
    mike.say "Может, это и собачий ошейник, Кексик, но на тебе он будет означать совсем другое."

# ch/samantha/gift.rpy:309
translate russian samantha_gift_collar_male_7b4ccdb3:
    mike.say "Может, это и собачий ошейник, Сэм, но на тебе он будет означать совсем другое."

# ch/samantha/gift.rpy:310
translate russian samantha_gift_collar_male_13397052:
    samantha.say "Разве?"

# ch/samantha/gift.rpy:311
translate russian samantha_gift_collar_male_9eadb21c:
    "Я горячо качаю головой."

# ch/samantha/gift.rpy:312
translate russian samantha_gift_collar_male_3d399e15:
    mike.say "Нет, конечно! Это скорее знак того, что ты принадлежишь мне, что ты окончательно и бесповоротно занята."

# ch/samantha/gift.rpy:313
translate russian samantha_gift_collar_male_799a1136:
    "По её взгляду ясно: логика всей этой затеи её совершенно не убедила."

# ch/samantha/gift.rpy:318
translate russian samantha_gift_collar_male_5d63a3c1:
    "Её лицо мрачнеет, и она смотрит на меня с таким отвращением, какое я редко видел за всё время нашего знакомства."

# ch/samantha/gift.rpy:319
translate russian samantha_gift_collar_male_cc2f0b44:
    samantha.say "Спасибо, что показал, что всё это время творилось в твоей больной голове!"

# ch/samantha/gift.rpy:320
translate russian samantha_gift_collar_male_1efb795d:
    "С этими словами она в ярости уходит, оставляя меня стоять одного с зажатым в пальцах ошейником."

# ch/samantha/gift.rpy:323
translate russian samantha_gift_collar_male_7a9c67a7:
    "Может, стоит сменить подход и объяснить это через что-то более знакомое ей по собственному опыту..."

# ch/samantha/gift.rpy:324
translate russian samantha_gift_collar_male_608d1715:
    mike.say "Помнишь, как ты носила помолвочное кольцо, которое подарил Райан?"

# ch/samantha/gift.rpy:325
translate russian samantha_gift_collar_male_c32a945f:
    "Знаю, упоминать его сейчас чрезвычайно рискованно, но я решил идти ва-банк."

# ch/samantha/gift.rpy:326
translate russian samantha_gift_collar_male_338016f9:
    "Сэм кивает, всё ещё не понимая, к чему я веду."

# ch/samantha/gift.rpy:327
translate russian samantha_gift_collar_male_f38376cc:
    mike.say "Оно символизировало вашу верность друг другу. Или её отсутствие — по крайней мере, с его стороны."

# ch/samantha/gift.rpy:328
translate russian samantha_gift_collar_male_7f28a561:
    mike.say "Этот ошейник символизирует мои чувства к тебе."

# ch/samantha/gift.rpy:329
translate russian samantha_gift_collar_male_79de28ba:
    mike.say "Но это не просто кольцо на пальце, которое можно снять при удобном случае или спрятать, чтобы не мешало флиртовать."

# ch/samantha/gift.rpy:330
translate russian samantha_gift_collar_male_fe25e93c:
    mike.say "Это нечто большее и более сильное, чем то, что было у тебя с Райаном. Я хочу, чтобы все видели этот ошейник и понимали, насколько крепка наша связь."

# ch/samantha/gift.rpy:332
translate russian samantha_gift_collar_male_61515e7e:
    mike.say "Теперь мы связаны друг с другом, Кексик, и этот ошейник — символ нашей связи!"

# ch/samantha/gift.rpy:334
translate russian samantha_gift_collar_male_6633aa8a:
    mike.say "Теперь мы связаны друг с другом, Сэм, и этот ошейник — символ нашей связи!"

# ch/samantha/gift.rpy:335
translate russian samantha_gift_collar_male_672b1ae5:
    "Я вижу, как Сэм обдумывает мои слова. Мгновение молчания растягивается в минуты."

# ch/samantha/gift.rpy:336
translate russian samantha_gift_collar_male_4115643a:
    "Затем она поднимает на меня глаза с какой-то необычной открытостью, словно ждёт, что я скажу ещё что-нибудь."

# ch/samantha/gift.rpy:337
translate russian samantha_gift_collar_male_23f16b82:
    "После неловкой паузы я больше не выдерживаю."

# ch/samantha/gift.rpy:339
translate russian samantha_gift_collar_male_dc227e43:
    mike.say "Кексик, скажи что-нибудь... пожалуйста!"

# ch/samantha/gift.rpy:341
translate russian samantha_gift_collar_male_6a192862:
    mike.say "Сэм, скажи что-нибудь... пожалуйста!"

# ch/samantha/gift.rpy:342
translate russian samantha_gift_collar_male_88f5e7f0:
    samantha.say "Я просто вспоминала всё, что случилось с тех пор, как ты вернулся в мою жизнь."

# ch/samantha/gift.rpy:343
translate russian samantha_gift_collar_male_2fa4b100:
    samantha.say "Раньше я думала, что счастлива, но ты показал мне, что всё это время я жила во лжи."

# ch/samantha/gift.rpy:344
translate russian samantha_gift_collar_male_e3608d2d:
    samantha.say "Было больно, но с тех пор, как я ушла от Райана, моя жизнь становится только лучше. И всё благодаря тебе."

# ch/samantha/gift.rpy:346
translate russian samantha_gift_collar_male_3a04c942:
    samantha.say "И на пальце у меня уже твоё кольцо, так что это вторая вещь, которую ты просишь меня носить."

# ch/samantha/gift.rpy:347
translate russian samantha_gift_collar_male_9b0e1a79:
    samantha.say "Кольцо — для всех остальных, да? А это, кажется, только для тебя."

# ch/samantha/gift.rpy:348
translate russian samantha_gift_collar_male_a9de19cc:
    "Сэм снова смотрит на меня тем же взглядом, и лишь теперь я понимаю, что это — покорность."

# ch/samantha/gift.rpy:351
translate russian samantha_gift_collar_male_1aa8e167:
    samantha.say "Было бы довольно глупо перестать слушать тебя после всего, что ты сделал ради моего счастья, правда?"

# ch/samantha/gift.rpy:352
translate russian samantha_gift_collar_male_254430c9:
    "Я невольно с энтузиазмом киваю: Сэм говорит именно то, что мне сейчас хочется услышать."

# ch/samantha/gift.rpy:353
translate russian samantha_gift_collar_male_d7656fe7:
    "Она нервно улыбается и приподнимает волосы, позволяя мне застегнуть ошейник на её шее — не так туго, чтобы душить, но достаточно плотно, чтобы она постоянно его чувствовала."

# ch/samantha/gift.rpy:356
translate russian samantha_gift_collar_male_d8874dd4:
    "Сэм смотрит на подвеску и игриво щёлкает по ней пальцем."

# ch/samantha/gift.rpy:357
translate russian samantha_gift_collar_male_d0144f67:
    samantha.say "Ой, кексик! [lssb_samantha.hero_name()], ты всегда дразнил меня за любовь к сладкому!"

# ch/samantha/gift.rpy:359
translate russian samantha_gift_collar_male_280be4b5:
    mike.say "Эм, пожалуй, пока на тебе ошейник, лучше зови меня «господин», Кексик."

# ch/samantha/gift.rpy:361
translate russian samantha_gift_collar_male_9548999d:
    mike.say "Эм, пожалуй, пока на тебе ошейник, лучше зови меня «господин», Сэм."

# ch/samantha/gift.rpy:362
translate russian samantha_gift_collar_male_e79a4fec:
    mike.say "А я буду звать тебя Кексиком."

# ch/samantha/gift.rpy:364
translate russian samantha_gift_collar_male_fa85b438:
    mike.say "Но такие тонкости обсудим, когда начнём учить тебя послушанию, ладно?"

# ch/samantha/gift.rpy:365
translate russian samantha_gift_collar_male_40ead738:
    "Мой небрежный тон вызывает у Сэм прежде всего удивление, хотя, уверен, к нему примешивается и любопытство."

# ch/samantha/gift.rpy:370
translate russian samantha_gift_butt_plug_male_967ea59f:
    samantha.say "О, [lssb_samantha.hero_name()], это мне?"

# ch/samantha/gift.rpy:371
translate russian samantha_gift_butt_plug_male_1a19f559:
    "Она разворачивает анальную пробку."

# ch/samantha/gift.rpy:374
translate russian samantha_gift_butt_plug_male_e698dad7:
    samantha.say "..."

# ch/samantha/gift.rpy:375
translate russian samantha_gift_butt_plug_male_b4f3daaa:
    samantha.say "Оставь себе... Я не хочу, так что оставь."

# ch/samantha/gift.rpy:376
translate russian samantha_gift_butt_plug_male_30f2edfc:
    samantha.say "Уверена, тебе она пригодится больше, чем мне."

# ch/samantha/gift.rpy:380
translate russian samantha_gift_butt_plug_male_ebfc0adb:
    samantha.say "Идеально!"

# ch/samantha/gift.rpy:382
translate russian samantha_gift_butt_plug_male_471899c5:
    samantha.say "Спасибо, [lssb_samantha.hero_name()], я найду ей хорошее применение."

# ch/samantha/reactions.rpy:3
translate russian samantha_ice_cream_reaction_male_cb0d3314:
    mike.say "В такой день, Кексик, нам просто необходимо мороженое!"

# ch/samantha/reactions.rpy:5
translate russian samantha_ice_cream_reaction_male_5858788a:
    mike.say "В такой день, Сэм, нам просто необходимо мороженое!"

# ch/samantha/reactions.rpy:6
translate russian samantha_ice_cream_reaction_male_b8200c06:
    samantha.say "Ты читаешь мои мысли! Пойдём купим?"

# ch/samantha/reactions.rpy:7
translate russian samantha_ice_cream_reaction_male_73a4ddd7:
    "У киоска с мороженым я покупаю рожок с парой разных шариков."

# ch/samantha/reactions.rpy:8
translate russian samantha_ice_cream_reaction_male_38e2228c:
    "Сэм выбирает то же самое, но с другим сочетанием вкусов."

# ch/samantha/reactions.rpy:9
translate russian samantha_ice_cream_reaction_male_d9f41cf7:
    samantha.say "М-м-м... Как же ВКУСНО!"

# ch/samantha/reactions.rpy:10
translate russian samantha_ice_cream_reaction_male_85921a92:
    samantha.say "Ой... ой-ой-ой... а вот это уже не очень!"

# ch/samantha/reactions.rpy:11
translate russian samantha_ice_cream_reaction_male_12b4ddea:
    "Я опускаю взгляд, пытаясь понять, что так расстроило Сэм."

# ch/samantha/reactions.rpy:12
translate russian samantha_ice_cream_reaction_male_94b41cb3:
    "И изумлённо смотрю, как мороженое капает ей на грудь!"

# ch/samantha/reactions.rpy:13
translate russian samantha_ice_cream_reaction_male_39409967:
    samantha.say "Боже, как я могла промахнуться мимо рта?!"

# ch/samantha/reactions.rpy:14
translate russian samantha_ice_cream_reaction_male_bda88b73:
    "Мне остаётся лишь сочувственно кивать: боюсь открыть рот и выдать то, о чём на самом деле думаю!"

# ch/samantha/reactions.rpy:19
translate russian samantha_ask_phone_male_996dd973:
    mike.say "Слушай, Кексик..."

# ch/samantha/reactions.rpy:21
translate russian samantha_ask_phone_male_b5bfd0d7:
    mike.say "Слушай, Сэм..."

# ch/samantha/reactions.rpy:22
translate russian samantha_ask_phone_male_f04b9365:
    mike.say "Дашь свой номер телефона?"

# ch/samantha/reactions.rpy:26
translate russian samantha_ask_phone_male_5411dc02:
    samantha.say "Я думала, он у тебя уже есть, [lssb_samantha.hero_name()]?"

# ch/samantha/reactions.rpy:27
translate russian samantha_ask_phone_male_32790ec2:
    samantha.say "Но на всякий случай вот..."

# ch/samantha/reactions.rpy:29
translate russian samantha_ask_phone_male_c5241d37:
    samantha.say "Запиши меня как-нибудь скучно. Поставщик для пекарни или мой стоматолог."

# ch/samantha/reactions.rpy:30
translate russian samantha_ask_phone_male_feff73e8:
    samantha.say "Я буду часто появляться у тебя в телефоне, [lssb_samantha.hero_name()]. А телефоны иногда забывают на столе."

# ch/samantha/reactions.rpy:32
translate russian samantha_ask_phone_male_23ada741:
    samantha.say "Только пиши перед звонком. Райан берёт мой телефон, когда у меня руки в муке."

# ch/samantha/reactions.rpy:37
translate russian samantha_ask_phone_male_333e2ece:
    samantha.say "Лучше не надо, [lssb_samantha.hero_name()]."

# ch/samantha/reactions.rpy:38
translate russian samantha_ask_phone_male_4c28b6a6:
    samantha.say "Я только что сменила номер."

# ch/samantha/reactions.rpy:39
translate russian samantha_ask_phone_male_21a8b25f:
    samantha.say "И пока держу его в секрете, чтобы мне не звонил кто попало!"

# ch/samantha/reactions.rpy:43
translate russian samantha_ask_birthday_male_3b4abbac:
    mike.say "А, кстати..."

# ch/samantha/reactions.rpy:45
translate russian samantha_ask_birthday_male_b4c53185:
    mike.say "Пока не забыл, Кексик: когда у тебя день рождения?"

# ch/samantha/reactions.rpy:47
translate russian samantha_ask_birthday_male_f09134cc:
    mike.say "Пока не забыл, Сэм: когда у тебя день рождения?"

# ch/samantha/reactions.rpy:51
translate russian samantha_ask_birthday_male_42ad2bf6:
    samantha.say "Ты и так знаешь, [lssb_samantha.hero_name()]!"

# ch/samantha/reactions.rpy:52
translate russian samantha_ask_birthday_male_6974e8ae:
    samantha.say "Но напомню: 8-го числа лета!"

# ch/samantha/reactions.rpy:57
translate russian samantha_ask_birthday_male_80f9f7af:
    samantha.say "Уф..."

# ch/samantha/reactions.rpy:58
translate russian samantha_ask_birthday_male_f5865feb:
    samantha.say "Мы же целую вечность жили вместе, [lssb_samantha.hero_name()]!"

# ch/samantha/reactions.rpy:59
translate russian samantha_ask_birthday_male_82448396:
    samantha.say "Ты должен это знать!"

# ch/samantha/reactions.rpy:64
translate russian samantha_offer_a_drink_male_996dd973:
    mike.say "Слушай, Кексик..."

# ch/samantha/reactions.rpy:66
translate russian samantha_offer_a_drink_male_b5bfd0d7:
    mike.say "Слушай, Сэм..."

# ch/samantha/reactions.rpy:67
translate russian samantha_offer_a_drink_male_f4fec2fc:
    mike.say "Тебе что-нибудь взять в баре?"

# ch/samantha/reactions.rpy:68
translate russian samantha_offer_a_drink_male_2c943bee:
    mike.say "Я как раз собираюсь заказать ещё."

# ch/samantha/reactions.rpy:69
translate russian samantha_offer_a_drink_male_544875c6:
    "Едва я успеваю договорить, Сэм поворачивается ко мне."

# ch/samantha/reactions.rpy:73
translate russian samantha_offer_a_drink_male_c079ab43:
    samantha.say "Повзрослей уже, [lssb_samantha.hero_name()]!"

# ch/samantha/reactions.rpy:74
translate russian samantha_offer_a_drink_male_adf558c3:
    samantha.say "Я беременна, помнишь?"

# ch/samantha/reactions.rpy:76
translate russian samantha_offer_a_drink_male_a6ec2553:
    samantha.say "И ты, насколько я помню, тоже к этому причастен!"

# ch/samantha/reactions.rpy:81
translate russian samantha_offer_a_drink_male_19f72fab:
    samantha.say "О, конечно, [lssb_samantha.hero_name()]."

# ch/samantha/reactions.rpy:82
translate russian samantha_offer_a_drink_male_95616aae:
    samantha.say "Возьми мне просто пива, ладно?"

# ch/samantha/reactions.rpy:84
translate russian samantha_offer_a_drink_male_a7124aab:
    samantha.say "А лучше два. Я с обеда на телефоне с адвокатом."

# ch/samantha/reactions.rpy:85
translate russian samantha_offer_a_drink_male_5894588f:
    samantha.say "Никто не предупреждает, что развод — это в основном коробки и бумажная волокита."

# ch/samantha/reactions.rpy:87
translate russian samantha_offer_a_drink_male_4dd3c8d0:
    samantha.say "И если зайдёт кто-то из знакомых, ты мой старый друг, а мы просто делимся новостями."

# ch/samantha/reactions.rpy:88
translate russian samantha_offer_a_drink_male_e6470cf0:
    samantha.say "Что, в общем-то, правда. Просто не вся."

# ch/samantha/reactions.rpy:100
translate russian samantha_offer_a_drink_male_de1aca32:
    samantha.say "Нет, спасибо, [lssb_samantha.hero_name()]."

# ch/samantha/reactions.rpy:101
translate russian samantha_offer_a_drink_male_3cf18b30:
    samantha.say "Хочу держать себя в руках."

# ch/samantha/reactions.rpy:107
translate russian samantha_slap_ass_intro_male_d4c92a11:
    "Мне всегда было тяжело смотреть, как Сэм ходит."

# ch/samantha/reactions.rpy:108
translate russian samantha_slap_ass_intro_male_fe352974:
    "Не в том смысле, что на неё неприятно смотреть."

# ch/samantha/reactions.rpy:109
translate russian samantha_slap_ass_intro_male_6cb9e0c8:
    "Как раз наоборот: глаз не оторвать!"

# ch/samantha/reactions.rpy:110
translate russian samantha_slap_ass_intro_male_40d44e52:
    "Она хороша и стоя на месте, а в движении — настоящая поэзия."

# ch/samantha/reactions.rpy:111
translate russian samantha_slap_ass_intro_male_95e709c5:
    "А эта попка... так и хочется протянуть руку и шлёпнуть..."

# ch/samantha/reactions.rpy:115
translate russian samantha_slap_ass_happy_male_2f752751:
    samantha.say "Эй!"

# ch/samantha/reactions.rpy:116
translate russian samantha_slap_ass_happy_male_788eb5d4:
    samantha.say "Какого чёрта?!"

# ch/samantha/reactions.rpy:117
translate russian samantha_slap_ass_happy_male_c3179dc4:
    samantha.say "Это был ты, да, [lssb_samantha.hero_name()]?"

# ch/samantha/reactions.rpy:118
translate russian samantha_slap_ass_happy_male_f1e012d5:
    "Больше это просто некому сделать."

# ch/samantha/reactions.rpy:119
translate russian samantha_slap_ass_happy_male_b98045c8:
    "Поэтому я лишь пожимаю плечами и киваю."

# ch/samantha/reactions.rpy:120
translate russian samantha_slap_ass_happy_male_6610c1c2:
    "Сэм прищуривается и качает головой."

# ch/samantha/reactions.rpy:121
translate russian samantha_slap_ass_happy_male_766f8a39:
    "Но я вижу, что она не злится."

# ch/samantha/reactions.rpy:122
translate russian samantha_slap_ass_happy_male_7cadb22a:
    samantha.say "Я не против, если ты иногда так делаешь."

# ch/samantha/reactions.rpy:123
translate russian samantha_slap_ass_happy_male_10aa1851:
    samantha.say "Только не превращай это в постоянную привычку."

# ch/samantha/reactions.rpy:125
translate russian samantha_slap_ass_happy_male_da5dfe4e:
    samantha.say "И сначала смотри, кто рядом, [lssb_samantha.hero_name()]. Я всё ещё ношу его кольцо."

# ch/samantha/reactions.rpy:126
translate russian samantha_slap_ass_happy_male_1330fc8f:
    samantha.say "Хотя половина удовольствия как раз в чужих взглядах, так что слишком осторожным тоже не становись."

# ch/samantha/reactions.rpy:128
translate russian samantha_slap_ass_happy_male_aa2fcdc3:
    samantha.say "Можешь делать это и при нём, знаешь ли. Он уже перестал притворяться, что возражает."

# ch/samantha/reactions.rpy:129
translate russian samantha_slap_ass_happy_male_340157a8:
    samantha.say "Я больше за соседей переживаю. Хотя, честно говоря, даже за них не особо."

# ch/samantha/reactions.rpy:132
translate russian samantha_slap_ass_happy_male_cd4799c3:
    samantha.say "И не при людях. Я замужняя женщина, а в этом городе языки длинные."

# ch/samantha/reactions.rpy:134
translate russian samantha_slap_ass_happy_male_e7b9026b:
    samantha.say "И не при людях. Я скоро выхожу замуж, а в этом городе языки длинные."

# ch/samantha/reactions.rpy:135
translate russian samantha_slap_ass_happy_male_30b132a9:
    samantha.say "Я тебя не отчитываю, [lssb_samantha.hero_name()]. Просто говорю, где это делать."

# ch/samantha/reactions.rpy:137
translate russian samantha_slap_ass_happy_male_a752ca10:
    samantha.say "А знаешь, делай при всех. Пусть поймут, чья я."

# ch/samantha/reactions.rpy:138
translate russian samantha_slap_ass_happy_male_a392b2db:
    samantha.say "Я годами молчала о том, кому принадлежу. Больше молчать не собираюсь."

# ch/samantha/reactions.rpy:143
translate russian samantha_slap_ass_angry_male_2f752751:
    samantha.say "Эй!"

# ch/samantha/reactions.rpy:144
translate russian samantha_slap_ass_angry_male_788eb5d4:
    samantha.say "Какого чёрта?!"

# ch/samantha/reactions.rpy:145
translate russian samantha_slap_ass_angry_male_c3179dc4:
    samantha.say "Это был ты, да, [lssb_samantha.hero_name()]?"

# ch/samantha/reactions.rpy:146
translate russian samantha_slap_ass_angry_male_f1e012d5:
    "Больше это просто некому сделать."

# ch/samantha/reactions.rpy:147
translate russian samantha_slap_ass_angry_male_b98045c8:
    "Поэтому я лишь пожимаю плечами и киваю."

# ch/samantha/reactions.rpy:148
translate russian samantha_slap_ass_angry_male_6610c1c2:
    "Сэм прищуривается и качает головой."

# ch/samantha/reactions.rpy:149
translate russian samantha_slap_ass_angry_male_60a458e2:
    "И я вижу, что она изрядно злится."

# ch/samantha/reactions.rpy:150
translate russian samantha_slap_ass_angry_male_7f78fdb1:
    samantha.say "Я бы предпочла, чтобы ты так не делал, [lssb_samantha.hero_name()]."

