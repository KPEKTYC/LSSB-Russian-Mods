# ch/samantha/chat.rpy:179
translate russian samantha_desire_1_male_dfbedcdf:
    samantha.say "Не знаю..."

# ch/samantha/chat.rpy:180
translate russian samantha_desire_1_male_b14476a3:
    samantha.say "Слышала, если слишком широко открыть разум, мозги выпадут."

# ch/samantha/chat.rpy:181
translate russian samantha_desire_1_male_b9ccb916:
