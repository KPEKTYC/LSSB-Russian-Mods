# ch/sasha/events/events.rpy:216
translate russian sasha_murder_talk_bree_899e5ef9:
    "Я невольно смеюсь вместе с ней и чувствую облегчение."

# ch/sasha/events/events.rpy:217
translate russian sasha_murder_talk_bree_bd5f9140:
