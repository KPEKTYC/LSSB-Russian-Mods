translate russian sasha_cheated_sam_advice_9b0cd10f:
    mike.say "Прости - я понимаю, что не должен был говорить тебе об этом..."

# ch/sasha/events/events_male.rpy:5441
translate russian sasha_cheated_sam_advice_bb637263:
    samantha.say "Нет, [lssb_sasha.hero_name()], подожди - не уходи сразу."

# ch/sasha/events/events_male.rpy:5442
translate russian sasha_cheated_sam_advice_11bf13a3:
    "Я замираю, ожидая, что скажет Сэм дальше."

# ch/sasha/events/events_male.rpy:5443
translate russian sasha_cheated_sam_advice_f98a6e67:
    samantha.say "Я только что набросилась на тебя, наказывая тебя за то, что случилось со мной."

# ch/sasha/events/events_male.rpy:5444
translate russian sasha_cheated_sam_advice_8f0e4a79:
    samantha.say "Я забыла, что ты сделал для меня тогда."

# ch/sasha/events/events_male.rpy:5445
translate russian sasha_cheated_sam_advice_58cc6eaf:
    samantha.say "И никто никогда так не мучился из-за измены, как ты сейчас."

# ch/sasha/events/events_male.rpy:5447
translate russian sasha_cheated_sam_advice_984f8ae5:
    mike.say "Спасибо, Кекс... но я не уверен, что заслуживаю этого комплимента."

# ch/sasha/events/events_male.rpy:5449
translate russian sasha_cheated_sam_advice_c6bf20c0:
    mike.say "Спасибо, Сэм... но я не уверен, что заслуживаю этого комплимента."

# ch/sasha/events/events_male.rpy:5450
translate russian sasha_cheated_sam_advice_cf727373:
    mike.say "Поможешь мне найти способ, чтобы она меня простила?"

# ch/sasha/events/events_male.rpy:5451
translate russian sasha_cheated_sam_advice_2dc28659:
    samantha.say "Нет, я не могу."

# ch/sasha/events/events_male.rpy:5452
translate russian sasha_cheated_sam_advice_2110364d:
    samantha.say "Она должна сама этого захотеть."

# ch/sasha/events/events_male.rpy:5453
translate russian sasha_cheated_sam_advice_19d26cf6:
    mike.say "Но как мне...?"

# ch/sasha/events/events_male.rpy:5454
translate russian sasha_cheated_sam_advice_b99cc270:
    samantha.say "Тебе просто нужно продолжать делать то, что ты делаешь, [lssb_sasha.hero_name()]."

# ch/sasha/events/events_male.rpy:5455
translate russian sasha_cheated_sam_advice_5319add2:
    samantha.say "Будь честен, покажи ей, что ты понимаешь, что то, что ты сделал, было неправильно, и что ты сожалеешь о том, что причинил ей боль."

# ch/sasha/events/events_male.rpy:5456
translate russian sasha_cheated_sam_advice_7a66f13a:
    samantha.say "В конце концов, решение принимает она."

# ch/sasha/events/events_male.rpy:5458
translate russian sasha_cheated_sam_advice_69504f98:
    "Когда разговор с Сэм закончен, я снова и снова обдумываю ее совет."

# ch/sasha/events/events_male.rpy:5459
translate russian sasha_cheated_sam_advice_7e4b919c:
    "То, что она сказала, имеет смысл, но я все еще боюсь полностью передать решение в руки Саши."

# ch/sasha/events/events_male.rpy:5460
translate russian sasha_cheated_sam_advice_ae88aebf:
    "Но потом я попросил совета у человека, который, как я думал, мог мне больше всего помочь."

# ch/sasha/events/events_male.rpy:5461
translate russian sasha_cheated_sam_advice_fa748a00:
    "Итак, если я действительно хочу наладить отношения с Сашей, какой у меня есть выбор?"

# ch/sasha/events/events_male.rpy:5466
translate russian sasha_morningwood_dc8981e3:
    "В тот момент, когда я просыпаюсь, я понимаю, что у меня самый сильный утренний \"вопрос\"."

# ch/sasha/events/events_male.rpy:5467
translate russian sasha_morningwood_2b79f35f:
    "Мой член настолько твердый, что это почти болезненно!"

# ch/sasha/events/events_male.rpy:5468
translate russian sasha_morningwood_533c1171:
    "И я знаю, что если я хочу встать и начать день, мне сначала нужно это решить."

# ch/sasha/events/events_male.rpy:5469
translate russian sasha_morningwood_78d82071:
    "Я собираюсь прибегнуть к самому очевидному решению, взяв дело в свои руки."

# ch/sasha/events/events_male.rpy:5470
translate russian sasha_morningwood_8e42411a:
    "Поэтому я думаю о том, чтобы вспомнить какой-нибудь особенно горячий момент или найти что-нибудь на своем телефоне."

# ch/sasha/events/events_male.rpy:5471
translate russian sasha_morningwood_fd9e5988:
    "Но потом мне приходит в голову другая мысль."

# ch/sasha/events/events_male.rpy:5472
translate russian sasha_morningwood_f61589a9:
    "Зачем тратить время на что-то воображаемое или на кучу картинок?"

# ch/sasha/events/events_male.rpy:5473
translate russian sasha_morningwood_71073623:
    "Особенно когда у меня есть \"оригинал\" под одной крышей!"

# ch/sasha/events/events_male.rpy:5481
translate russian sasha_morningwood_a6bff644:
    "При этом я вылезаю из постели и спешу к двери."

# ch/sasha/events/events_male.rpy:5483
translate russian sasha_morningwood_58e1a83b:
    "Затем я спешу к другой двери, стараясь быть как можно быстрее и тише."

# ch/sasha/events/events_male.rpy:5484
translate russian sasha_morningwood_0e6c155b:
    "Я почти уверен, что я первый, кто встал сегодня утром."

# ch/sasha/events/events_male.rpy:5485
translate russian sasha_morningwood_fa6aa052:
    "Я еще не слышал, чтобы кто-нибудь проснулся, и все любят поспать подольше, когда есть такая возможность."

# ch/sasha/events/events_male.rpy:5486
translate russian sasha_morningwood_aa5939b7:
    "Поэтому, когда я тихо открываю дверь в комнату Саши, я почти уверен, что она все еще там."

# ch/sasha/events/events_male.rpy:5488
translate russian sasha_morningwood_bc907d58:
    "И мое другое предположение, что она все еще спит, подтверждается через мгновение."

# ch/sasha/events/events_male.rpy:5489
translate russian sasha_morningwood_7bdf7d68:
    "Я вижу ее голову на подушке, когда я тихо проникаю внутрь и закрываю дверь."

# ch/sasha/events/events_male.rpy:5491
translate russian sasha_morningwood_b5d838cb:
    "Конечно, Саша сейчас повернулась ко мне спиной."

# ch/sasha/events/events_male.rpy:5492
translate russian sasha_morningwood_4ee69e82:
    "Но я уверен, что она спит, потому что я слышу ее храп."

# ch/sasha/events/events_male.rpy:5493
translate russian sasha_morningwood_e8fb68bb:
    "Это не то, что она пилит дерево во сне или что-то в этом роде."

# ch/sasha/events/events_male.rpy:5494
translate russian sasha_morningwood_57488c5b:
    "Звук довольно тихий, даже милый на мой слух."

# ch/sasha/events/events_male.rpy:5495
translate russian sasha_morningwood_8a375a5e:
    "Но это все равно успокаивает, когда я крадусь к ее кровати."

# ch/sasha/events/events_male.rpy:5496
translate russian sasha_morningwood_f02323d7:
    "Одеяло немного сползло, достаточно, чтобы показать спину Саши."

# ch/sasha/events/events_male.rpy:5497
translate russian sasha_morningwood_5fda9bd7:
    "И оно также открывает соблазнительный вид на ее ягодицы!"

# ch/sasha/events/events_male.rpy:5498
translate russian sasha_morningwood_86d19f4f:
    "Еще раз оглядываясь на дверь, я немного приподнимаю одеяло."

# ch/sasha/events/events_male.rpy:5499
translate russian sasha_morningwood_0da08b9c:
    "Достаточно, чтобы я мог медленно проскользнуть под него и забраться в постель к Саше."

# ch/sasha/events/events_male.rpy:5500
translate russian sasha_morningwood_ae40928a:
    "Я думаю, что она любит сюрпризы, так что это должно ей понравиться."

# ch/sasha/events/events_male.rpy:5501
translate russian sasha_morningwood_1936abbe:
    "А если нет... ну, я это сразу узнаю!"

# ch/sasha/events/events_male.rpy:5502
translate russian sasha_morningwood_10ad8040:
    "К счастью для меня, Саша любит спать в довольно откровенной одежде."

# ch/sasha/events/events_male.rpy:5503
translate russian sasha_morningwood_7e5d8832:
    "Поэтому, после того как я снимаю с себя свою одежду, больше делать нечего."

# ch/sasha/events/events_male.rpy:5504
translate russian sasha_morningwood_57778d14:
    "Я осторожно отодвигаю то, что она носит ниже талии."

# ch/sasha/events/events_male.rpy:5505
translate russian sasha_morningwood_6ec8d232:
    "А затем я наклоняюсь вперед, приближая свой член к намеченной цели."

# ch/sasha/events/events_male.rpy:5506
translate russian sasha_morningwood_2acc7357:
    "Я на самом деле задерживаю дыхание, когда он начинает касаться губ Саши."

# ch/sasha/events/events_male.rpy:5507
translate russian sasha_morningwood_4280bc9b:
    "В любой момент я узнаю, оправдается ли моя ставка."

# ch/sasha/events/events_male.rpy:5508
translate russian sasha_morningwood_c0fbdb63:
    "И в тот самый момент, когда Саша начинает шевелиться, я почти теряю самообладание."

# ch/sasha/events/events_male.rpy:5509
translate russian sasha_morningwood_e81fe7a1:
    "Она двигается под мной, тихо стоная, когда я пытаюсь пробудить ее."

# ch/sasha/events/events_male.rpy:5510
translate russian sasha_morningwood_ebd197b1:
    sasha.say "Ммм..."

# ch/sasha/events/events_male.rpy:5511
translate russian sasha_morningwood_a41717e9:
    sasha.say "Что..."

# ch/sasha/events/events_male.rpy:5512
translate russian sasha_morningwood_fcddae03:
    sasha.say "Что происходит..."

# ch/sasha/events/events_male.rpy:5513
translate russian sasha_morningwood_3428ca6d:
    mike.say "Доброе утро, красавица..."

# ch/sasha/events/events_male.rpy:5514
translate russian sasha_morningwood_0f14bcfc:
    mike.say "Я подумал, что разбужу тебя приятным сюрпризом!"

# ch/sasha/events/events_male.rpy:5515
translate russian sasha_morningwood_8372e1da:
    "Саша оборачивается и смотрит через плечо, ее глаза все еще полузакрыты от сна."

# ch/sasha/events/events_male.rpy:5516
translate russian sasha_morningwood_324fbb17:
    "Но, к моему облегчению, она улыбается, как только понимает, что это я."

# ch/sasha/events/events_male.rpy:5517
translate russian sasha_morningwood_87648ffd:
    "Затем она открывает рот, чтобы выдохнуть от ощущения того, что я с ней делаю."

# ch/sasha/events/events_male.rpy:5518
translate russian sasha_morningwood_601ee3c6:
    sasha.say "Ох..."

# ch/sasha/events/events_male.rpy:5519
translate russian sasha_morningwood_cca437f0:
    sasha.say "Ты, хулиган!"

# ch/sasha/events/events_male.rpy:5520
translate russian sasha_morningwood_01c0f108:
    sasha.say "Я знаю, что ты задумал!"

# ch/sasha/events/events_male.rpy:5521
translate russian sasha_morningwood_51cbe68d:
    "Я не могу удержаться от смеха, слыша тон голоса Саши."

# ch/sasha/events/events_male.rpy:5522
translate russian sasha_morningwood_084f294f:
    "И, делая это, я на мгновение останавливаюсь."

# ch/sasha/events/events_male.rpy:5523
translate russian sasha_morningwood_5ace3312:
    sasha.say "Эй!"

# ch/sasha/events/events_male.rpy:5524
translate russian sasha_morningwood_f8c2e340:
    sasha.say "Я не помню, чтобы говорила тебе остановиться!"

# ch/sasha/events/events_male.rpy:5525
translate russian sasha_morningwood_0489119a:
    "Прежде чем я успеваю среагировать, Саша тянется вниз и хватает мой член."

# ch/sasha/events/events_male.rpy:5529
translate russian sasha_morningwood_1529e9fa:
    "Одновременно она поднимается, вставая на четвереньки."

# ch/sasha/events/events_male.rpy:5530
translate russian sasha_morningwood_c3f039d0:
    "И она начинает сильно тереть его о свою вульву."

# ch/sasha/events/events_male.rpy:5532
translate russian sasha_morningwood_1c29e89e:
    "Губы Саши уже довольно влажные и скользкие."

# ch/sasha/events/events_male.rpy:5533
translate russian sasha_morningwood_a32517e6:
    "Что означает, что то, что произойдет дальше, в некотором роде неизбежно."

# ch/sasha/events/events_male.rpy:5534
translate russian sasha_morningwood_ffe3ddd2:
    "Я изо всех сил пытаюсь удержать ее и занять удобное положение."

# ch/sasha/events/events_male.rpy:5535
translate russian sasha_morningwood_2e2766a7:
    "И, делая это, мой член начинает погружаться в нее."

# ch/sasha/events/events_male.rpy:5536
translate russian sasha_morningwood_d59a3546:
    sasha.say "А..."

# ch/sasha/events/events_male.rpy:5538
translate russian sasha_morningwood_592a782c:
    sasha.say "Да, точно..."

# ch/sasha/events/events_male.rpy:5539
translate russian sasha_morningwood_f7a6b801:
    sasha.say "Вот это лучше!"

# ch/sasha/events/events_male.rpy:5540
translate russian sasha_morningwood_2697d944:
    sasha.say "Теперь ты меня будишь!"

# ch/sasha/events/events_male.rpy:5542
translate russian sasha_morningwood_24e068cc:
    "Мне и так хватает поддержки, которую Саша мне сейчас оказывает."

# ch/sasha/events/events_male.rpy:5543
translate russian sasha_morningwood_b0a352b1:
    "После первоначального прилива ощущений от того, что я внутри нее, берет верх инстинкт."

# ch/sasha/events/events_male.rpy:5544
translate russian sasha_morningwood_a9eb30cb:
    "Вагина Саши чувствуется настолько хорошо, что я не могу это описать."

# ch/sasha/events/events_male.rpy:5545
translate russian sasha_morningwood_6c0b7a34:
    "И я двигаюсь вверх и вниз внутри нее без остановки и колебаний."

# ch/sasha/events/events_male.rpy:5546
translate russian sasha_morningwood_f4dba688:
    "У меня руки на ее ягодицах, я крепко ее держу."

# ch/sasha/events/events_male.rpy:5547
translate russian sasha_morningwood_a06a7d96:
    "Скорость, с которой я двигаюсь, может быть не самой быстрой, на которую я способен."

# ch/sasha/events/events_male.rpy:5548
translate russian sasha_morningwood_3e6374ae:
    "Но, тем не менее, Саше, похоже, нравится этот ровный ритм."

# ch/sasha/events/events_male.rpy:5549
translate russian sasha_morningwood_f6ad4291:
    "И я также стараюсь проникать как можно глубже при каждом движении."

# ch/sasha/events/events_male.rpy:5550
translate russian sasha_morningwood_a0f60288:
    sasha.say "О, [lssb_sasha.hero_name()]..."

# ch/sasha/events/events_male.rpy:5552
translate russian sasha_morningwood_79e4afdb:
    sasha.say "Это ОЧЕНЬ хорошо!"

# ch/sasha/events/events_male.rpy:5553
translate russian sasha_morningwood_b43161d0:
    "Не нужно, чтобы Саша говорила мне, насколько это хорошо."

# ch/sasha/events/events_male.rpy:5554
translate russian sasha_morningwood_815a10ae:
    "Кажется, наши тела просыпаются все больше с каждой секундой."

# ch/sasha/events/events_male.rpy:5555
translate russian sasha_morningwood_c7c88883:
    "Они оживают одновременно, пробуждаясь друг к другу."

# ch/sasha/events/events_male.rpy:5556
translate russian sasha_morningwood_97458fce:
    "Это намного лучше, чем проснуться от будильника."

# ch/sasha/events/events_male.rpy:5557
translate russian sasha_morningwood_cb0bd535:
    "И это лучший способ избавиться от утренней эрекции, который я могу придумать!"

# ch/sasha/events/events_male.rpy:5558
translate russian sasha_morningwood_dc43083b:
    "Саша поворачивает голову, глядя на меня через плечо."

# ch/sasha/events/events_male.rpy:5561
translate russian sasha_morningwood_20a983c2:
    "Ее глаза полны удовольствия, которое она испытывает."

# ch/sasha/events/events_male.rpy:5562
translate russian sasha_morningwood_8775fe2c:
    "Она кусает губу, словно надеется выпустить ощущения, которые накапливаются внутри нее."

# ch/sasha/events/events_male.rpy:5563
translate russian sasha_morningwood_8d7aa83a:
    "И у нее одна рука на груди, она щиплет и сжимает свои напряженные соски."

# ch/sasha/events/events_male.rpy:5564
translate russian sasha_morningwood_98cf33ae:
    "Саша кивает, подбадривая меня и давая мне понять, что она хочет больше."

# ch/sasha/events/events_male.rpy:5566
translate russian sasha_morningwood_0dae4389:
    "Но я не могу этого выдержать бесконечно."

# ch/sasha/events/events_male.rpy:5567
translate russian sasha_morningwood_d28f27f3:
    mike.say "Саша..."

# ch/sasha/events/events_male.rpy:5568
translate russian sasha_morningwood_12031c7d:
    mike.say "Я схожу с ума!"

# ch/sasha/events/events_male.rpy:5570
translate russian sasha_morningwood_e6ae5af6:
    sasha.say "Да, используй меня...Я твоя секс-кукла, [lssb_sasha.hero_name()]!"

# ch/sasha/events/events_male.rpy:5571
translate russian sasha_morningwood_93f822e9:
    sasha.say "Заполни меня, заставь меня забеременеть, делай что хочешь... Я умоляю тебя!"

# ch/sasha/events/events_male.rpy:5573
translate russian sasha_morningwood_49df66f2:
    sasha.say "Да... по...й в меня!"

# ch/sasha/events/events_male.rpy:5574
translate russian sasha_morningwood_ea6ec6a8:
    sasha.say "Заполни меня, [lssb_sasha.hero_name()]... заставь меня забеременеть!"

# ch/sasha/events/events_male.rpy:5576
translate russian sasha_morningwood_0a177e30:
    sasha.say "Ты даже не смей выходить, ты заканчиваешь там, где я скажу, и ни секунды раньше..."

# ch/sasha/events/events_male.rpy:5577
translate russian sasha_morningwood_d3715acb:
    sasha.say "Ты существуешь, чтобы доставить мне удовольствие, [lssb_sasha.hero_name()], так что сделай это хорошо!"

# ch/sasha/events/events_male.rpy:5579
translate russian sasha_morningwood_ab90925a:
    sasha.say "Ты даже не смей выходить на мне..."

# ch/sasha/events/events_male.rpy:5580
translate russian sasha_morningwood_e37be77c:
    sasha.say "Ты заканчиваешь именно там, где я тебе скажу, [lssb_sasha.hero_name()]!"

# ch/sasha/events/events_male.rpy:5582
translate russian sasha_morningwood_592a782c_1:
    sasha.say "О, да..."

# ch/sasha/events/events_male.rpy:5583
translate russian sasha_morningwood_d67c1869:
    sasha.say "Я тоже!"

# ch/sasha/events/events_male.rpy:5585
translate russian sasha_morningwood_081a2ead:
    sasha.say "Вот так, [lssb_sasha.hero_name()]... доброе утро мне."

# ch/sasha/events/events_male.rpy:5588
