# ch/sasha/events/events.rpy:147
translate russian sasha_rape_talk_17499eed:
    sasha.say "И вид у тебя совсем не как у человека, который в порядке."

# ch/sasha/events/events.rpy:148
translate russian sasha_rape_talk_38935dc3:
