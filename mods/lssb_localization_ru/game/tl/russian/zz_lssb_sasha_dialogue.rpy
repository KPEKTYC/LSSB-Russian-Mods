# ch/sasha/events/events.rpy:232
translate russian sasha_murder_talk_bree_0d708c41:
    sasha.say "Чёрт..."

# ch/sasha/events/events.rpy:233
translate russian sasha_murder_talk_bree_fee6bdcf:
    sasha.say "Мне будет её не хватать."

# ch/sasha/events/events.rpy:234
translate russian sasha_murder_talk_bree_cdc0594b:
    mike.say "Мне тоже. И мне кажется, что это ещё и моя вина."

# ch/sasha/events/events.rpy:235
translate russian sasha_murder_talk_bree_bd520257:
    "Когда я произношу это, Саша обнимает меня."

# ch/sasha/events/events.rpy:236
