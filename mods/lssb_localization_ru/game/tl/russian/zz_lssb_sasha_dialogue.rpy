# ch/sasha/events/events.rpy:191
translate russian sasha_murder_talk_bree_8bcad058:
    mike.say "Не знаю, как ты..."

# ch/sasha/events/events.rpy:192
translate russian sasha_murder_talk_bree_1a09be36:
    mike.say "А я всё ещё не могу прийти в себя после случившегося."

# ch/sasha/events/events.rpy:193
translate russian sasha_murder_talk_bree_f9f60cc9:
    "Как только я произношу это, на лице Саши появляется облегчение."

# ch/sasha/events/events.rpy:194
translate russian sasha_murder_talk_bree_4b73f407:
