# ch/sasha/events/events.rpy:175
translate russian sasha_murder_talk_bree_d11940db:
    "После случившегося всё никак не могло просто вернуться на круги своя."

# ch/sasha/events/events.rpy:176
translate russian sasha_murder_talk_bree_a0625d32:
