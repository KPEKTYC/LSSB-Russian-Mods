# ch/sasha/events/events.rpy:244
translate russian sasha_murder_talk_bree_bc3d8e82:
    sasha.say "Может, так мы сохраним частичку [bree.name] в себе."

# ch/sasha/events/events.rpy:251
translate russian sasha_asleep_3d5deeba:
    "Саманта спит. Лучше уйти, пока я её не разбудил..."

# ch/sasha/events/events.rpy:254
translate russian sasha_asleep_2ca16b78:
    "Саша и Саманта спят. Лучше уйти, пока я их не разбудил..."

# ch/sasha/events/events.rpy:257
translate russian sasha_asleep_7a3d6e05:
