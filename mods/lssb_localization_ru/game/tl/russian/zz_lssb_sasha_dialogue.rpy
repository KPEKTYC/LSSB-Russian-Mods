# ch/sasha/date.rpy:388
translate russian sasha_halloween_invitation_c9a47c42:
    mike.say "Как скажешь, Саша..."

# ch/sasha/date.rpy:390
translate russian sasha_halloween_invitation_d20c62e2:
    sasha.say "Вот и говорю!"

# ch/sasha/date.rpy:392
translate russian sasha_halloween_invitation_912c723c:
    "Я заставляю себя улыбнуться."

# ch/sasha/date.rpy:393
translate russian sasha_halloween_invitation_17f5e8e2:
    "Заметив это, Саша подмигивает мне."

# ch/sasha/date.rpy:395
translate russian sasha_halloween_invitation_b2437c18:
    sasha.say "И не переживай, [lssb_sasha.hero_name()]."

# ch/sasha/date.rpy:396
translate russian sasha_halloween_invitation_4e96aa14:
    sasha.say "Когда вечеринка закончится, я тебе всё компенсирую!"

# ch/sasha/date.rpy:398
translate russian sasha_halloween_invitation_3d27182a:
    "Теперь моя улыбка становится искренней."

# ch/sasha/date.rpy:399
translate russian sasha_halloween_invitation_1eae1a57:
    "Может, во всём этом всё-таки есть свои плюсы?"

# ch/sasha/date.rpy:404
translate russian sasha_halloween_arrival_15df0e97:
    "Ещё мгновение смотрю на дверь, а потом хлопаю себя по лбу."

# ch/sasha/date.rpy:405
translate russian sasha_halloween_arrival_6c783ac8:
    "Ну конечно, Саша ведь тоже здесь живёт."

# ch/sasha/date.rpy:406
translate russian sasha_halloween_arrival_bfb57e07:
    "Значит, моя спутница уже в доме!"

# ch/sasha/date.rpy:407
translate russian sasha_halloween_arrival_f05a3393:
    "Блин, столько сил отдал вечеринке, что мозги набекрень."

# ch/sasha/date.rpy:410
translate russian sasha_halloween_arrival_dcfb2c77:
    "А вот Саша явно в полном порядке: она выжидающе смотрит на меня."

# ch/sasha/date.rpy:412
translate russian sasha_halloween_arrival_ddec1f88:
    sasha.say "Ну, [lssb_sasha.hero_name()], я жду."

# ch/sasha/date.rpy:413
translate russian sasha_halloween_arrival_65cd4a11:
    sasha.say "Как тебе мой костюм?"

# ch/sasha/date.rpy:415
translate russian sasha_halloween_arrival_073fe758:
    "Ещё раз оглядываю Сашу с головы до ног."

# ch/sasha/date.rpy:416
translate russian sasha_halloween_arrival_d7b96df3:
    "А потом делаю глубокий вдох."

# ch/sasha/date.rpy:417
translate russian sasha_halloween_arrival_7155e040:
    "Собираюсь наконец сказать ей, что думаю."

# ch/sasha/date.rpy:420
translate russian sasha_halloween_arrival_a6f8c034:
    mike.say "Не хотел говорить при остальных."

# ch/sasha/date.rpy:421
translate russian sasha_halloween_arrival_5f2df755:
    mike.say "Но я в восторге, Саша."

# ch/sasha/date.rpy:422
translate russian sasha_halloween_arrival_311c6bb9:
    mike.say "Ты невероятно сексуальна!"

# ch/sasha/date.rpy:425
translate russian sasha_halloween_arrival_ec2c2ff3:
    "Саша улыбается: похвала ей явно по душе."

# ch/sasha/date.rpy:426
translate russian sasha_halloween_arrival_cedfbca8:
    sasha.say "Спасибо, [lssb_sasha.hero_name()]!"

# ch/sasha/date.rpy:427
translate russian sasha_halloween_arrival_cc13fd46:
    sasha.say "Именно это я и хотела услышать."

# ch/sasha/date.rpy:429
translate russian sasha_halloween_arrival_41c0ee98:
    sasha.say "Знаю, сегодня мы должны принимать гостей."

# ch/sasha/date.rpy:430
translate russian sasha_halloween_arrival_18e17430:
    sasha.say "Но это не значит, что мы не найдём времени друг для друга."

# ch/sasha/date.rpy:432
translate russian sasha_halloween_arrival_0ff63654:
    sasha.say "Чтобы повеселиться, понимаешь?"

# ch/sasha/date.rpy:434
translate russian sasha_halloween_arrival_578d651f:
    "Я с готовностью киваю."

# ch/sasha/date.rpy:435
translate russian sasha_halloween_arrival_ddc314a8:
    "В голове уже мелькают всевозможные варианты."

# ch/sasha/date.rpy:436
translate russian sasha_halloween_arrival_1d662c3f:
    mike.say "Конечно, Саша."

# ch/sasha/date.rpy:437
translate russian sasha_halloween_arrival_b91e5444:
    mike.say "А до тех пор я, пожалуй, так и буду на тебя пялиться."

# ch/sasha/date.rpy:438
translate russian sasha_halloween_arrival_10232a50:
    mike.say "Сразу предупреждаю: вряд ли смогу остановиться!"

# ch/sasha/date.rpy:440
translate russian sasha_halloween_arrival_f1d8a63c:
    mike.say "Эм..."

# ch/sasha/date.rpy:441
translate russian sasha_halloween_arrival_12765781:
    mike.say "Не знаю, Саша."

# ch/sasha/date.rpy:442
translate russian sasha_halloween_arrival_985714a6:
    mike.say "Ну... видно, что ты очень старалась!"

# ch/sasha/date.rpy:445
translate russian sasha_halloween_arrival_e5d6e9c2:
    "Саша склоняет голову набок и прищуривается."

# ch/sasha/date.rpy:446
translate russian sasha_halloween_arrival_535659c9:
    "Похоже, она не знает, как воспринимать мой ответ."

# ch/sasha/date.rpy:448
translate russian sasha_halloween_arrival_9b18e17e:
    sasha.say "Эм..."

# ch/sasha/date.rpy:449
translate russian sasha_halloween_arrival_4131e3d6:
    sasha.say "Ну... спасибо, наверное!"

# ch/sasha/date.rpy:450
translate russian sasha_halloween_arrival_7e074be0:
    sasha.say "Я думала, тебе понравится больше!"

# ch/sasha/date.rpy:452
translate russian sasha_halloween_arrival_a9d86dc8:
    "Услышав это, невольно морщу нос."

# ch/sasha/date.rpy:453
translate russian sasha_halloween_arrival_273a0416:
    "Мне хочется быть с ней как можно честнее."

# ch/sasha/date.rpy:454
translate russian sasha_halloween_arrival_7e7ef970:
    "Может, так я не слишком задену её чувства."

# ch/sasha/date.rpy:455
translate russian sasha_halloween_arrival_679e3f92:
    mike.say "Дело не в костюме, Саша."

# ch/sasha/date.rpy:456
translate russian sasha_halloween_arrival_4bd61518:
    mike.say "Он отличный. Правда отличный."

# ch/sasha/date.rpy:458
translate russian sasha_halloween_arrival_743586b1:
    sasha.say "А в чём тогда?!"

# ch/sasha/date.rpy:460
translate russian sasha_halloween_arrival_6550472c:
    mike.say "Ты мне больше нравишься в образе рокерши, Саша."

# ch/sasha/date.rpy:461
translate russian sasha_halloween_arrival_c0412b5c:
    mike.say "Вся эта готика..."

# ch/sasha/date.rpy:462
translate russian sasha_halloween_arrival_cde5666a:
    mike.say "Ну... просто не моё!"

# ch/sasha/date.rpy:463
translate russian sasha_halloween_arrival_1e339174:
    "Саша закатывает глаза и вздыхает."

# ch/sasha/date.rpy:465
translate russian sasha_halloween_arrival_2e1ac3d6:
    sasha.say "По крайней мере, ты честен, [lssb_sasha.hero_name()]."

# ch/sasha/date.rpy:466
translate russian sasha_halloween_arrival_b786178d:
    sasha.say "Но настроение ты мне слегка подпортил!"

# ch/sasha/date.rpy:477
translate russian sasha_halloween_party_25a40503:
    scottie.say "Ого..."

# ch/sasha/date.rpy:478
translate russian sasha_halloween_party_a197e026:
    scottie.say "Саша, ты ТАКАЯ сексуальная!"

# ch/sasha/date.rpy:480
translate russian sasha_halloween_party_d59a3546:
    sasha.say "Эм..."

# ch/sasha/date.rpy:481
translate russian sasha_halloween_party_86f1993b:
    sasha.say "Ну... спасибо, Скотти..."

# ch/sasha/date.rpy:483
translate russian sasha_halloween_party_2b30f2c3:
    "Я оборачиваюсь и вижу, как Скотти наклонился к Саше вплотную."

# ch/sasha/date.rpy:484
translate russian sasha_halloween_party_fee430d7:
    "На её лице — неловкая улыбка."

# ch/sasha/date.rpy:485
translate russian sasha_halloween_party_bdb4306e:
    "Видно, что ей неприятно это внимание."

# ch/sasha/date.rpy:487
translate russian sasha_halloween_party_c0025ba9:
    scottie.say "Нет, серьёзно, Саша."

# ch/sasha/date.rpy:488
translate russian sasha_halloween_party_d183da09:
    scottie.say "Очень сексуальный образ."

# ch/sasha/date.rpy:489
translate russian sasha_halloween_party_40f8f662:
    scottie.say "Сразу притягивает взгляд!"

# ch/sasha/date.rpy:490
translate russian sasha_halloween_party_169f06ec:
    "Саша оглядывается на меня через плечо."

# ch/sasha/date.rpy:491
translate russian sasha_halloween_party_84769ef2:
    "Думаю, она хочет, чтобы я вмешался и выручил её."

# ch/sasha/date.rpy:494
translate russian sasha_halloween_party_a3ad5a98:
    mike.say "Не так близко, Скотти."

# ch/sasha/date.rpy:495
translate russian sasha_halloween_party_e64444a7:
    mike.say "Саше не нужно, чтобы ты слюной залил её костюм!"

# ch/sasha/date.rpy:497
translate russian sasha_halloween_party_f4730863:
    scottie.say "Ч... что?"

# ch/sasha/date.rpy:498
translate russian sasha_halloween_party_d1ad4189:
    scottie.say "Я не пускал слюни! Правда, Саша?"

# ch/sasha/date.rpy:499
translate russian sasha_halloween_party_30153b07:
    scottie.say "Мы просто болтали, вот и всё."

# ch/sasha/date.rpy:500
translate russian sasha_halloween_party_d0a86aaf:
    "Я делаю шаг вперёд и встаю между Скотти и Сашей."

# ch/sasha/date.rpy:501
translate russian sasha_halloween_party_4e2f779c:
    "Стараюсь, чтобы это не выглядело агрессивно."

# ch/sasha/date.rpy:502
translate russian sasha_halloween_party_f0df792c:
    "Но он, кажется, всё равно понимает намёк."

# ch/sasha/date.rpy:506
translate russian sasha_halloween_party_ebf6de05:
    sasha.say "Он прав, Скотти."

# ch/sasha/date.rpy:507
translate russian sasha_halloween_party_7058442b:
    sasha.say "Мне ни к чему нюхать твои подмышки!"

# ch/sasha/date.rpy:509
translate russian sasha_halloween_party_fecdf778:
    "Скотти открывает рот, собираясь что-то сказать."

# ch/sasha/date.rpy:513
translate russian sasha_halloween_party_c544cef5:
    "Но затем кивает и уходит."

# ch/sasha/date.rpy:515
translate russian sasha_halloween_party_c01d0c21:
    mike.say "Да ладно тебе, Саша, не наезжай на парня."

# ch/sasha/date.rpy:516
translate russian sasha_halloween_party_929167d8:
    mike.say "Он просто пытается сделать тебе комплимент."

# ch/sasha/date.rpy:518
translate russian sasha_halloween_party_3f5fb656:
    scottie.say "Ага..."

# ch/sasha/date.rpy:519
translate russian sasha_halloween_party_78d7a3c4:
    scottie.say "Да, именно!"

# ch/sasha/date.rpy:522
translate russian sasha_halloween_party_53f31995:
    "Саша отступает на шаг."

# ch/sasha/date.rpy:523
translate russian sasha_halloween_party_3dbe8c8b:
    "Она качает головой, словно не понимает, зачем я это делаю."

# ch/sasha/date.rpy:525
translate russian sasha_halloween_party_35807a67:
    sasha.say "Т... ты сейчас издеваешься, да?"

# ch/sasha/date.rpy:527
translate russian sasha_halloween_party_532fd751:
    sasha.say "Ты ведь, блядь, издеваешься!"

# ch/sasha/date.rpy:529
translate russian sasha_halloween_party_7aa8cc78:
    mike.say "Да расслабься ты, Саша."

# ch/sasha/date.rpy:530
translate russian sasha_halloween_party_e16d3bda:
    mike.say "У нас вроде как вечеринка."

# ch/sasha/date.rpy:531
translate russian sasha_halloween_party_3ba61ecc:
    mike.say "Не воспринимай всё так серьёзно!"

# ch/sasha/date.rpy:532
translate russian sasha_halloween_party_e0e6c0ec:
    "Саша ничего не отвечает."

# ch/sasha/date.rpy:534
translate russian sasha_halloween_party_32525e79:
    "Только качает головой и отворачивается от меня."

# ch/sasha/date.rpy:545
translate russian sasha_halloween_dance_56513fd9:
    scottie.say "Да брось, Саша!"

# ch/sasha/date.rpy:546
translate russian sasha_halloween_dance_ab83e5ba:
    scottie.say "Всего один танец, в память о былом!"

# ch/sasha/date.rpy:547
translate russian sasha_halloween_dance_a4b566c2:
    "Я не замечаю, как Скотти подходит к нам с Сашей."

# ch/sasha/date.rpy:548
translate russian sasha_halloween_dance_6b67d9b9:
    "И успеваю услышать только его часть разговора."

# ch/sasha/date.rpy:549
translate russian sasha_halloween_dance_84bb013a:
    "Но нетрудно догадаться, что происходит."

# ch/sasha/date.rpy:550
translate russian sasha_halloween_dance_be41f08a:
    "Саша отступает, стараясь оказаться за моей спиной."

# ch/sasha/date.rpy:552
translate russian sasha_halloween_dance_b836b725:
    sasha.say "Я уже сказала «нет», Скотти."

# ch/sasha/date.rpy:553
translate russian sasha_halloween_dance_cf07c1b0:
    sasha.say "Сегодня я хочу провести вечер с [lssb_sasha.hero_name()]!"

# ch/sasha/date.rpy:555
translate russian sasha_halloween_dance_a5c75de8:
    "Саша смотрит на меня в поисках поддержки."

# ch/sasha/date.rpy:556
translate russian sasha_halloween_dance_b71609d3:
    "И я понимаю, что придётся вмешаться."

# ch/sasha/date.rpy:559
translate russian sasha_halloween_dance_ad758739:
    mike.say "Девушка уже сказала «нет», Скотти."

# ch/sasha/date.rpy:560
translate russian sasha_halloween_dance_8b2d8e47:
    mike.say "По-моему, ответ ты получил."

# ch/sasha/date.rpy:562
translate russian sasha_halloween_dance_946a03c9:
    "Скотти открывает рот, собираясь возразить."

# ch/sasha/date.rpy:563
translate russian sasha_halloween_dance_014e2b0a:
    "Но я делаю шаг вперёд и качаю головой."

# ch/sasha/date.rpy:564
translate russian sasha_halloween_dance_a9be2cfc:
    "Кажется, он понимает намёк и отступает."

# ch/sasha/date.rpy:565
translate russian sasha_halloween_dance_93938a57:
    scottie.say "Ладно, ладно!"

# ch/sasha/date.rpy:566
translate russian sasha_halloween_dance_6b4702b4:
    scottie.say "Мне дважды повторять не надо!"

# ch/sasha/date.rpy:572
translate russian sasha_halloween_dance_1e0d3515:
    sasha.say "Спасибо, [lssb_sasha.hero_name()]."

# ch/sasha/date.rpy:573
translate russian sasha_halloween_dance_80d2a066:
    sasha.say "Я у тебя в долгу!"

# ch/sasha/date.rpy:575
translate russian sasha_halloween_dance_381b4f5c:
    mike.say "Может, расплатишься танцем?"

# ch/sasha/date.rpy:576
translate russian sasha_halloween_dance_0fb23b84:
    "Саша улыбается мне и кивает."

# ch/sasha/date.rpy:579
translate russian sasha_halloween_dance_dfcf0697:
    "И как только включают песню, которая ей нравится, мы выходим танцевать."

# ch/sasha/date.rpy:580
translate russian sasha_halloween_dance_f6bc716c:
    "Со мной Саша совсем не так сдержанна, как со Скотти."

# ch/sasha/date.rpy:581
translate russian sasha_halloween_dance_43977638:
    "Между нами с первых секунд всё жарко и страстно!"

# ch/sasha/date.rpy:582
translate russian sasha_halloween_dance_9cd13fc4:
    "Она движется под музыку, почти не отстраняясь от меня."

# ch/sasha/date.rpy:583
translate russian sasha_halloween_dance_597dc193:
    "А я двигаюсь в такт с Сашей, сосредоточив на ней всё внимание."

# ch/sasha/date.rpy:584
translate russian sasha_halloween_dance_1b3ca0da:
    "Она действительно не шутила, когда говорила, что хочет быть со мной!"

# ch/sasha/date.rpy:586
translate russian sasha_halloween_dance_484a930b:
    mike.say "Ничего страшного, Саша."

# ch/sasha/date.rpy:587
translate russian sasha_halloween_dance_c38b129c:
    mike.say "На один танец я тебя отпущу."

# ch/sasha/date.rpy:590
translate russian sasha_halloween_dance_13b7da1d:
    "Глаза Саши расширяются."

# ch/sasha/date.rpy:591
translate russian sasha_halloween_dance_6d473721:
    "Такого ответа она явно не ожидала."

# ch/sasha/date.rpy:593
translate russian sasha_halloween_dance_3426c4c0:
    sasha.say "Я... я не..."

# ch/sasha/date.rpy:595
translate russian sasha_halloween_dance_d88dded9:
    scottie.say "Видишь, Саша?"

# ch/sasha/date.rpy:596
translate russian sasha_halloween_dance_3ecc85e2:
    scottie.say "Я же говорил: ничего страшного!"

# ch/sasha/date.rpy:599
translate russian sasha_halloween_dance_92d037d8:
    "Смотрю, как Скотти тащит её на импровизированный танцпол."

# ch/sasha/date.rpy:600
translate russian sasha_halloween_dance_d47ac2cf:
    "И только тогда начинаю задумываться, не совершил ли я ошибку."

# ch/sasha/date.rpy:601
translate russian sasha_halloween_dance_7ddd1bd4:
    "Всё это время Саша сверлит меня злым взглядом."

# ch/sasha/date.rpy:602
translate russian sasha_halloween_dance_3324388e:
    "Она изо всех сил старается держаться на расстоянии."

# ch/sasha/date.rpy:603
translate russian sasha_halloween_dance_bd858fa9:
    "Но Скотти словно нарочно вторгается в её личное пространство."

# ch/sasha/date.rpy:604
translate russian sasha_halloween_dance_cc4fc33e:
    "Закончив танец, она в ярости отходит от него."

# ch/sasha/date.rpy:605
translate russian sasha_halloween_dance_dbf03942:
    "Когда она направляется ко мне, мне вдруг становится не по себе."

# ch/sasha/date.rpy:606
translate russian sasha_halloween_dance_a4dba308:
    "Если она так злится на Скотти..."

# ch/sasha/date.rpy:607
translate russian sasha_halloween_dance_dc9dda4a:
    "То насколько же разозлилась на меня?"

# ch/sasha/date.rpy:616
translate russian sasha_halloween_sex_8b83239f:
    "Уже довольно поздно, и вечеринка постепенно затихает."

# ch/sasha/date.rpy:617
translate russian sasha_halloween_sex_1820b8cf:
