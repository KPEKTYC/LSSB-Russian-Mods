# ch/sasha/events/events.rpy:225
translate russian sasha_murder_talk_bree_f5046321:
    mike.say "Сколько разных оттенков чёрного у тебя в гардеробе?"

# ch/sasha/events/events.rpy:227
translate russian sasha_murder_talk_bree_e4e48d69:
    "Саша снова заливается смехом."

# ch/sasha/events/events.rpy:231
translate russian sasha_murder_talk_bree_093ce374:
