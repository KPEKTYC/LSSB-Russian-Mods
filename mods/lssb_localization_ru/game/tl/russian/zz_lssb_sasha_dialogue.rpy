# ch/sasha/reactions.rpy:399
translate russian sasha_belly_caress_male_940a98c2:
    sasha.say "Не знаю. Будто тело узнаёт тебя."

# ch/sasha/reactions.rpy:400
translate russian sasha_belly_caress_male_93d58575:
    sasha.say "И ребёнок тоже. Оба сразу успокаиваются, чёрт возьми!"

# ch/sasha/reactions.rpy:401
translate russian sasha_belly_caress_male_1ff1a4d8:
    mike.say "То есть я полезен для твоего здоровья?"

# ch/sasha/reactions.rpy:402
translate russian sasha_belly_caress_male_88d50903:
    mike.say "Ты это хочешь сказать?"

# ch/sasha/reactions.rpy:404
translate russian sasha_belly_caress_male_844eb317:
    "Саша открывает глаза и смотрит на меня с иронией."

# ch/sasha/reactions.rpy:406
translate russian sasha_belly_caress_male_aa144fd3:
    sasha.say "Не делай далеко идущих выводов, [lssb_sasha.hero_name()]."

# ch/sasha/reactions.rpy:407
translate russian sasha_belly_caress_male_826ea79a:
    sasha.say "Сейчас у меня мозги залиты гормонами беременности."

# ch/sasha/reactions.rpy:408
translate russian sasha_belly_caress_male_c005117e:
    sasha.say "Может, я вообще несу полную чушь!"

# ch/sasha/reactions.rpy:411
translate russian sasha_belly_caress_male_cc8b453b:
    sasha.say "...Но я рада, что прохожу через это именно с тобой, [lssb_sasha.hero_name()]. Правда."

# ch/sasha/reactions.rpy:412
translate russian sasha_belly_caress_male_b5789913:
    sasha.say "Это тоже гормоны говорят. Наверное."

# ch/sasha/reactions.rpy:414
translate russian sasha_belly_caress_male_50b8ed7e:
    sasha.say "А теперь помолчи и держи руку там, где она лежит, [lssb_sasha.hero_name()]."

# ch/sasha/reactions.rpy:421
translate russian sasha_belly_listen_male_1fcb246d:
    "Кладу обе руки на живот Саши, наслаждаясь прикосновением."

# ch/sasha/reactions.rpy:422
translate russian sasha_belly_listen_male_b3c9cfbc:
    "Ей это тоже явно нравится: она широко улыбается."

# ch/sasha/reactions.rpy:423
translate russian sasha_belly_listen_male_9dee2f27:
    "Но одна мысль не даёт покоя: её живот мне что-то очень напоминает."

# ch/sasha/reactions.rpy:424
translate russian sasha_belly_listen_male_51d754a2:
    "И тут до меня доходит. Улыбаясь, я начинаю легонько постукивать ладонями по его округлости."

# ch/sasha/reactions.rpy:426
translate russian sasha_belly_listen_male_d293023e:
    "Она хмурится и пытается разглядеть, что я делаю."

# ch/sasha/reactions.rpy:428
translate russian sasha_belly_listen_male_5ace3312:
    sasha.say "Эй!"

# ch/sasha/reactions.rpy:429
translate russian sasha_belly_listen_male_0268d552:
    sasha.say "Это ещё что такое?"

# ch/sasha/reactions.rpy:430
translate russian sasha_belly_listen_male_02d11156:
    sasha.say "Поосторожнее там!"

# ch/sasha/reactions.rpy:432
translate russian sasha_belly_listen_male_919e3fc0:
    mike.say "Ты же знаешь, я всегда осторожен, Саша!"

# ch/sasha/reactions.rpy:433
translate russian sasha_belly_listen_male_1243c532:
    mike.say "Но не могу удержаться."

# ch/sasha/reactions.rpy:434
translate russian sasha_belly_listen_male_ea3c2df8:
    mike.say "Твой живот похож на большой круглый барабан."

# ch/sasha/reactions.rpy:435
translate russian sasha_belly_listen_male_387988e0:
    mike.say "Вот и хочу узнать, получится ли сыграть на тебе мелодию!"

# ch/sasha/reactions.rpy:437
translate russian sasha_belly_listen_male_5c414ae9:
    "Глаза Саши округляются, а брови взлетают вверх."

# ch/sasha/reactions.rpy:439
translate russian sasha_belly_listen_male_8041fe6c:
    sasha.say "Не верю, что ты такое сказал обо мне, [lssb_sasha.hero_name()]..."

# ch/sasha/reactions.rpy:440
translate russian sasha_belly_listen_male_5a54d08a:
    sasha.say "Я музыкант. Я играю на инструменте."

# ch/sasha/reactions.rpy:441
translate russian sasha_belly_listen_male_b6759e23:
    sasha.say "А не хочу сама им становиться!"

# ch/sasha/reactions.rpy:443
translate russian sasha_belly_listen_male_49cc80b4:
    "Я собираюсь что-нибудь ответить."

# ch/sasha/reactions.rpy:444
translate russian sasha_belly_listen_male_306fdfe6:
    "Наверное, успокоить Сашу и заверить, что я шучу."

# ch/sasha/reactions.rpy:445
translate russian sasha_belly_listen_male_eab55e94:
    "Но тут чувствую, как внутри неё что-то шевелится."

# ch/sasha/reactions.rpy:446
translate russian sasha_belly_listen_male_3f8382ca:
    mike.say "Ого..."

# ch/sasha/reactions.rpy:447
translate russian sasha_belly_listen_male_39a03baf:
    mike.say "Саша, ты ела что-нибудь острое на обед?"

# ch/sasha/reactions.rpy:449
translate russian sasha_belly_listen_male_9bb3799c:
    sasha.say "Нет!"

# ch/sasha/reactions.rpy:451
translate russian sasha_belly_listen_male_8609d66d:
    mike.say "Тогда это ребёнок там шевелится..."

# ch/sasha/reactions.rpy:452
translate russian sasha_belly_listen_male_55c2c711:
    mike.say "Будто... будто отвечает на мою барабанную дробь!"

# ch/sasha/reactions.rpy:454
translate russian sasha_belly_listen_male_8c3083bb:
    "Убираю руки и наклоняюсь ближе, прижав ухо к животу Саши сбоку."

# ch/sasha/reactions.rpy:455
translate russian sasha_belly_listen_male_2d976dee:
    "Она снова пытается посмотреть, что я делаю, но собственный живот мешает."

# ch/sasha/reactions.rpy:456
translate russian sasha_belly_listen_male_bfc33669:
    sasha.say "Ты никакой не барабанщик, [lssb_sasha.hero_name()]..."

# ch/sasha/reactions.rpy:457
translate russian sasha_belly_listen_male_eb089e3a:
    sasha.say "Ты и на чёртовой гитаре еле играешь!"

# ch/sasha/reactions.rpy:458
translate russian sasha_belly_listen_male_c9b0d47f:
    sasha.say "И вообще, ребёнок правда может на такое реагировать?"

# ch/sasha/reactions.rpy:459
translate russian sasha_belly_listen_male_9cfdbb32:
    mike.say "Понятия не имею, Саша..."

# ch/sasha/reactions.rpy:460
translate russian sasha_belly_listen_male_034ddacc:
    mike.say "Но если хоть малейший шанс есть, я хочу увидеть!"

# ch/sasha/reactions.rpy:461
translate russian sasha_belly_listen_male_4c8773f7:
    mike.say "То есть... услышать..."

# ch/sasha/reactions.rpy:462
translate russian sasha_belly_listen_male_2fe4444b:
    "Я замолкаю и прислушиваюсь, стараясь ждать терпеливо."

# ch/sasha/reactions.rpy:463
translate russian sasha_belly_listen_male_d923e4ac:
    "И вскоре в награду слышу, как что-то внутри шевелится."

# ch/sasha/reactions.rpy:464
translate russian sasha_belly_listen_male_8c7678b4:
    mike.say "Вот видишь, Саша..."

# ch/sasha/reactions.rpy:465
translate russian sasha_belly_listen_male_096846c6:
    mike.say "Шевельнулся. Думаю, ему тоже понравилось, как я барабаню."

# ch/sasha/reactions.rpy:468
translate russian sasha_belly_listen_male_1db2ce90:
    sasha.say "Но... да. Я только что почувствовала, как ребёнок шевельнулся в ответ тебе, [lssb_sasha.hero_name()]."

# ch/sasha/reactions.rpy:470
translate russian sasha_belly_listen_male_eef62fb2:
    sasha.say "Там внутри — наш малыш. Иногда всё ещё не верится."

# ch/sasha/reactions.rpy:472
translate russian sasha_belly_listen_male_2637ab46:
    sasha.say "Ну, по-моему, кто-то из нас точно сходит с ума!"

# ch/sasha/reactions.rpy:474
translate russian sasha_belly_listen_male_1a30e7a2:
    sasha.say "Но по-хорошему, [lssb_sasha.hero_name()]. Только не перегибай."

# ch/sasha/talk.rpy:6
translate russian sasha_talk_love_male_29d9feac:
    sasha.say "Я люблю тебя, [lssb_sasha.hero_name()]."

# ch/sasha/talk.rpy:9
translate russian sasha_talk_love_male_f2d2f4da:
    mike.say "Почему никогда не снимают кино о том, что происходит после поцелуя?"

# ch/sasha/talk.rpy:11
translate russian sasha_talk_love_male_dcdaf69c:
    sasha.say "Снимают. Это называется порно."

# ch/sasha/talk.rpy:14
translate russian sasha_talk_love_male_b78a48c4:
    sasha.say "Ты когда-нибудь влюблялся?"

# ch/sasha/talk.rpy:15
translate russian sasha_talk_love_male_f8354afa:
    mike.say "Конечно."

# ch/sasha/talk.rpy:17
translate russian sasha_talk_love_male_5c34d7b0:
    sasha.say "Ужасно, правда?"

# ch/sasha/talk.rpy:18
translate russian sasha_talk_love_male_57276d50:
    mike.say "Почему?"

# ch/sasha/talk.rpy:19
translate russian sasha_talk_love_male_d646deea:
    sasha.say "Становишься такой уязвимой."

# ch/sasha/talk.rpy:20
translate russian sasha_talk_love_male_3f5be9eb:
    sasha.say "Любовь вскрывает тебе грудь, распахивает сердце. Кто-то забирается внутрь и всё там ломает."

# ch/sasha/talk.rpy:25
translate russian sasha_talk_love_male_7d689d89:
    sasha.say "Хуже парня, который тебя ненавидит, может быть только парень, который тебя любит."

# ch/sasha/talk.rpy:29
translate russian sasha_talk_love_male_b26281a8:
    sasha.say "Ты ведь не гей?"

# ch/sasha/talk.rpy:30
translate russian sasha_talk_love_male_11d0e707:
    mike.say "Будь я геем, одевался бы лучше."

# ch/sasha/talk.rpy:33
translate russian sasha_talk_love_male_6e299fea:
    mike.say "Почему женщины думают, что заставить мужчину сделать что-то можно только манипуляциями?"

# ch/sasha/talk.rpy:34
translate russian sasha_talk_love_male_6c4423aa:
    sasha.say "Причин, вообще-то, много."

# ch/sasha/talk.rpy:36
translate russian sasha_talk_love_male_460dbb9f:
    sasha.say "История, личный опыт, романтические комедии."

# ch/sasha/talk.rpy:49
translate russian sasha_talk_sex_male_1db5e9e0:
    sasha.say "Пожалуйста, делай со мной всё, что захочешь, [lssb_sasha.hero_name()]."

# ch/sasha/talk.rpy:52
translate russian sasha_talk_sex_male_138c923d:
    sasha.say "Сегодня я вся твоя, [lssb_sasha.hero_name()]. Только скажи, что делать."

# ch/sasha/talk.rpy:55
translate russian sasha_talk_sex_male_97221787:
    sasha.say "На колени, [lssb_sasha.hero_name()]. У тебя там внизу работа."

# ch/sasha/talk.rpy:58
translate russian sasha_talk_sex_male_a58cbf1e:
    sasha.say "Иди сюда, [lssb_sasha.hero_name()]. Сегодня всё будет по-моему."

# ch/sasha/talk.rpy:61
translate russian sasha_talk_sex_male_f0613994:
    sasha.say "Иди ко мне, [lssb_sasha.hero_name()]. Я хочу тебя. Прямо сейчас."

# ch/sasha/talk.rpy:65
translate russian sasha_talk_sex_male_9697ea95:
    mike.say "Зачем Бог дал мужчинам члены?"

# ch/sasha/talk.rpy:67
translate russian sasha_talk_sex_male_d3e0f492:
    sasha.say "Чтобы у них был хоть один способ заткнуть женщину."

# ch/sasha/talk.rpy:70
translate russian sasha_talk_sex_male_37eff869:
    sasha.say "Что лишнее: мясо, яйца, жена или минет?"

# ch/sasha/talk.rpy:71
translate russian sasha_talk_sex_male_867ef27f:
    mike.say "Минет. Мясо, яйца и жену можно взбить, а минет ничем не перебьёшь."

# ch/sasha/talk.rpy:75
translate russian sasha_talk_sex_male_86d11037:
    sasha.say "Как сделать обрезание деревенщине?"

# ch/sasha/talk.rpy:76
translate russian sasha_talk_sex_male_b3a35d92:
    mike.say "Не знаю."

# ch/sasha/talk.rpy:78
translate russian sasha_talk_sex_male_7597d746:
    sasha.say "Пнуть его сестру в челюсть."

# ch/sasha/talk.rpy:82
translate russian sasha_talk_sex_male_cd060917:
    sasha.say "Не знаю, в чём вопрос, но ответ точно — секс."

# ch/sasha/talk.rpy:86
translate russian sasha_talk_sex_male_53c1ae3d:
    mike.say "Ты могла бы замутить с другой девушкой?"

# ch/sasha/talk.rpy:88
translate russian sasha_talk_sex_male_89a5847b:
    sasha.say "Я пою в женской группе, [lssb_sasha.hero_name()]. Знаю, что творится за кулисами."

# ch/sasha/talk.rpy:89
translate russian sasha_talk_sex_male_98705db5:
    sasha.say "Девушка всегда знает, где что находится. Инструкция не нужна."

# ch/sasha/talk.rpy:93
translate russian sasha_talk_sex_male_53de1548:
    mike.say "Не думала пригласить в постель ещё одну женщину?"

# ch/sasha/talk.rpy:95
translate russian sasha_talk_sex_male_e37f4707:
    sasha.say "Нет уж. Мне звёздных закидонов и на репетициях хватает, [lssb_sasha.hero_name()]."

# ch/sasha/talk.rpy:96
translate russian sasha_talk_sex_male_8469ef7c:
    sasha.say "Одна королева драмы на матрас — вот мой предел."

# ch/sasha/talk.rpy:100
translate russian sasha_talk_sex_male_a6f7c982:
    mike.say "Чем оральный секс отличается от анального?"

# ch/sasha/talk.rpy:101
translate russian sasha_talk_sex_male_e5d892c8:
    sasha.say "Не знаю..."

# ch/sasha/talk.rpy:102
translate russian sasha_talk_sex_male_33bc784b:
    mike.say "От орального весь день хорошо, а от анального всю неделю задница болит."

# ch/sasha/talk.rpy:111
translate russian sasha_talk_politics_male_b548ade7:
    sasha.say "Нельзя так ослепнуть от патриотизма, чтобы перестать видеть реальность."

# ch/sasha/talk.rpy:112
translate russian sasha_talk_politics_male_01640357:
    sasha.say "Зло остаётся злом, кто бы его ни творил и ни оправдывал."

# ch/sasha/talk.rpy:120
translate russian sasha_talk_food_male_666f9ce1:
    sasha.say "Не понимаю я диет."

# ch/sasha/talk.rpy:121
translate russian sasha_talk_food_male_526334fd:
    sasha.say "Живи моментом."

# ch/sasha/talk.rpy:123
translate russian sasha_talk_food_male_6c890d1b:
    sasha.say "Вспомни всех женщин на «Титанике», которые отказались от десерта."

# ch/sasha/talk.rpy:130
translate russian sasha_talk_travels_male_4279a382:
    sasha.say "Не у каждого путешествия должна быть конечная цель."

# ch/sasha/talk.rpy:131
translate russian sasha_talk_travels_male_a22d24e3:
    sasha.say "Некоторые хороши сами по себе."

# ch/sasha/talk.rpy:138
translate russian sasha_talk_tv_male_21bd966e:
    sasha.say "Чтобы найти пару, нужно написать идеальное объявление."

# ch/sasha/talk.rpy:140
translate russian sasha_talk_tv_male_099da6b8:
    sasha.say "Вот моё: при покупке чипсов и дивана телевизор в подарок."

# ch/sasha/talk.rpy:151
translate russian sasha_talk_sports_male_6628529c:
    mike.say "Проблема зимних видов спорта в том... следи за мыслью... что ими обычно занимаются зимой."

# ch/sasha/talk.rpy:160
translate russian sasha_talk_fashion_male_d00aad42:
    sasha.say "Нельзя быть слишком хорошо одетой или слишком образованной."

# ch/sasha/talk.rpy:163
translate russian sasha_talk_fashion_male_c811dcce:
    sasha.say "Девушка должна быть элегантной и сногсшибательной."

# ch/sasha/talk.rpy:166
translate russian sasha_talk_fashion_male_3e1b0af8:
    sasha.say "Не знаю, кто придумал высокие каблуки, но все женщины ему многим обязаны!"

# ch/sasha/talk.rpy:169
translate russian sasha_talk_fashion_male_8f5e1904:
    sasha.say "Оденься плохо — запомнят платье. Оденься безупречно — запомнят женщину."

# ch/sasha/talk.rpy:172
translate russian sasha_talk_fashion_male_6762865f:
    sasha.say "Лучший макияж женщины — страсть. Но косметику купить проще."

# ch/sasha/talk.rpy:175
translate russian sasha_talk_fashion_male_05607e96:
    sasha.say "Обожаю новую одежду."

# ch/sasha/talk.rpy:176
translate russian sasha_talk_fashion_male_fefc0f2a:
    sasha.say "Если бы все могли каждый день носить что-нибудь новое, депрессия бы, наверное, исчезла."

# ch/sasha/talk.rpy:179
translate russian sasha_talk_fashion_male_5abf1ce2:
    sasha.say "У женщины без духов нет будущего."

# ch/sasha/talk.rpy:182
translate russian sasha_talk_fashion_male_8e4b72cd:
    sasha.say "Кто сказал, что счастье не купишь, просто не знал, где делать покупки."

# ch/sasha/talk.rpy:185
translate russian sasha_talk_fashion_male_293e7363:
    sasha.say "Платье должно быть как забор из колючей проволоки: выполнять свою функцию, не загораживая вид."

# ch/sasha/talk.rpy:189
translate russian sasha_talk_fashion_male_6079b9f4:
    sasha.say "Хорошо, что я родилась девушкой. Иначе стала бы дрэг-королевой."

# ch/sasha/talk.rpy:198
translate russian sasha_talk_books_male_09437293:
    sasha.say "Ты иногда бываешь мрачноват, но это, наверное, от любви к чтению."

# ch/sasha/talk.rpy:199
translate russian sasha_talk_books_male_c1d92c17:
    sasha.say "Те, кто любит читать, всегда немного с приветом."

# ch/sasha/talk.rpy:203
translate russian sasha_talk_books_male_143aafde:
    mike.say "Если пришёл к кому-то домой, а у него нет книг — не трахайся с ним!"

# ch/sasha/talk.rpy:210
translate russian sasha_talk_people_male_87375c4d:
    mike.say "Я люблю женщин, но некоторым, кажется, нельзя доверять. Врут ведь!"

# ch/sasha/talk.rpy:211
translate russian sasha_talk_people_male_2b57a480:
    mike.say "Как-то встретил в парке симпатичную девушку с собакой."

# ch/sasha/talk.rpy:212
translate russian sasha_talk_people_male_3eb95f95:
    mike.say "Подошёл, разговорились. Она сказала, как зовут собаку."

# ch/sasha/talk.rpy:214
translate russian sasha_talk_people_male_9417e5b5:
