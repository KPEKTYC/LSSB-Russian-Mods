# ch/shiori/chat.rpy:343
translate russian shiori_good_sweet_talk_male_70571bc3:
    mike.say "Я вообще не представляю жизни без тебя!"

# ch/shiori/chat.rpy:345
translate russian shiori_good_sweet_talk_male_1d77c1ae:
    shiori.say "Ох, [lssb_shiori.hero_name()]!"

# ch/shiori/chat.rpy:346
translate russian shiori_good_sweet_talk_male_91241446:
    shiori.say "Я так сильно тебя люблю!"

# ch/shiori/chat.rpy:348
translate russian shiori_good_sweet_talk_male_e51ff85d:
    mike.say "Я уже говорил, какая ты сегодня красивая, Сиори?"

# ch/shiori/chat.rpy:349
translate russian shiori_good_sweet_talk_male_25486643:
    mike.say "Нужно говорить это почаще!"

# ch/shiori/chat.rpy:351
translate russian shiori_good_sweet_talk_male_9c166c6d:
    shiori.say "Ой, ты заставляешь меня краснеть... боже!"

# ch/shiori/chat.rpy:352
translate russian shiori_good_sweet_talk_male_9b80e183:
    shiori.say "Спасибо, [lssb_shiori.hero_name()]!"

# ch/shiori/chat.rpy:354
translate russian shiori_good_sweet_talk_male_5dd5f169:
    mike.say "Не знаю, как у тебя получается, Сиори."

# ch/shiori/chat.rpy:355
translate russian shiori_good_sweet_talk_male_36b5ca24:
    mike.say "Ты одна растишь ребёнка и при этом работаешь."

# ch/shiori/chat.rpy:356
translate russian shiori_good_sweet_talk_male_04d6810f:
    mike.say "И с обоими делами прекрасно справляешься. Ты потрясающая!"

# ch/shiori/chat.rpy:358
translate russian shiori_good_sweet_talk_male_1fd14bc4:
    shiori.say "Я... правда?!"

# ch/shiori/chat.rpy:359
translate russian shiori_good_sweet_talk_male_9b80e183_1:
    shiori.say "Спасибо, [lssb_shiori.hero_name()]!"

# ch/shiori/chat.rpy:365
translate russian shiori_bad_sweet_talk_male_87465d74:
    mike.say "Тебе очень идёт быть мамой, Сиори."

# ch/shiori/chat.rpy:366
translate russian shiori_bad_sweet_talk_male_607338c1:
    mike.say "Ты кажешься такой домашней!"

# ch/shiori/chat.rpy:368
translate russian shiori_bad_sweet_talk_male_1b9499c0:
    shiori.say "То есть толстой и неопрятной?!"

# ch/shiori/chat.rpy:369
translate russian shiori_bad_sweet_talk_male_f27e3eb7:
    mike.say "Эм, нет... я не это имел в виду!"

# ch/shiori/condom.rpy:4
translate russian shiori_use_condom_1669d4d9:
    "Я прерываюсь ровно настолько, чтобы взять презерватив с прикроватной тумбочки и натянуть на член."

# ch/shiori/condom.rpy:5
translate russian shiori_use_condom_4cd32b59:
    "У Сиори уже есть ребёнок, и становиться отцом второго по случайности я точно не хочу."

# ch/shiori/condom.rpy:6
translate russian shiori_use_condom_ba68a05a:
    "Одобряет она презерватив или нет, ни слова возражения я не слышу."

# ch/shiori/condom.rpy:8
translate russian shiori_use_condom_63092259:
    "Я уже собираюсь продолжить, когда случайно замечаю презервативы на тумбочке."

# ch/shiori/condom.rpy:9
translate russian shiori_use_condom_8779c27c:
    "Отпустить Сиори, взять один и надеть — дело секунды. Куда лучше возможной альтернативы."

# ch/shiori/condom.rpy:10
translate russian shiori_use_condom_22d04b4a:
    "Я снова заключаю её в объятия и готовлюсь приступить к делу."

# ch/shiori/condom.rpy:12
translate russian shiori_use_condom_181cae99:
    "И тут вспоминаю кое-что очень важное."

# ch/shiori/condom.rpy:13
translate russian shiori_use_condom_c213fef9:
    "Я поднимаю руку, прося Сиори немного подождать."

# ch/shiori/condom.rpy:14
translate russian shiori_use_condom_19682355:
    "Она выглядит озадаченной, но всё же кивает."

# ch/shiori/condom.rpy:15
translate russian shiori_use_condom_67af0840:
    "Увидев, как я беру с тумбочки презерватив, она кивает снова."

# ch/shiori/condom.rpy:16
translate russian shiori_use_condom_628f8be1:
    "Я торопливо надеваю его, и мы готовы."

# ch/shiori/condom.rpy:18
translate russian shiori_use_condom_04a81938:
    mike.say "Секундочку, Сиори."

# ch/shiori/condom.rpy:19
translate russian shiori_use_condom_434d73ba:
    shiori.say "Ой, что случилось, [lssb_shiori.hero_name()]?"

# ch/shiori/condom.rpy:20
translate russian shiori_use_condom_12bc341f:
    "Сиори наблюдает, как я тянусь за презервативом на тумбочке."

# ch/shiori/condom.rpy:21
translate russian shiori_use_condom_c3524b20:
    "Получив ответ на свой вопрос, она кивает, пока я его надеваю."

# ch/shiori/condom.rpy:22
translate russian shiori_use_condom_bb7097f0:
    "Через мгновение мы готовы."

# ch/shiori/condom.rpy:24
translate russian shiori_use_condom_d783f573:
    mike.say "Сиори..."

# ch/shiori/condom.rpy:25
translate russian shiori_use_condom_772f33a0:
    mike.say "Подожди немного."

# ch/shiori/condom.rpy:26
translate russian shiori_use_condom_96025693:
    "При одном намёке на задержку Сиори начинает тревожиться."

# ch/shiori/condom.rpy:27
translate russian shiori_use_condom_98930be6:
    shiori.say "Что случилось, [lssb_shiori.hero_name()]?"

# ch/shiori/condom.rpy:28
translate russian shiori_use_condom_5b216aa5:
    mike.say "Не волнуйся, Сиори."

# ch/shiori/condom.rpy:29
translate russian shiori_use_condom_731467a8:
    mike.say "Я просто хочу взять презерватив, вот и всё."

# ch/shiori/condom.rpy:30
translate russian shiori_use_condom_92c76fb2:
    "На лице Сиори тут же появляется облегчение."

# ch/shiori/condom.rpy:31
translate russian shiori_use_condom_7d701aeb:
    "И улыбается она искренне."

# ch/shiori/condom.rpy:32
translate russian shiori_use_condom_5d1cff59:
    shiori.say "Конечно!"

# ch/shiori/condom.rpy:33
translate russian shiori_use_condom_51a7ffa0:
    shiori.say "Возьми."

# ch/shiori/condom.rpy:34
translate russian shiori_use_condom_f87d4e9f:
    "Мне хватает нескольких мгновений, чтобы найти презерватив."

# ch/shiori/condom.rpy:35
translate russian shiori_use_condom_9b159839:
    "Ещё несколько секунд — и он на мне."

# ch/shiori/condom.rpy:36
translate russian shiori_use_condom_f85b50d7:
    "Теперь мы готовы."

# ch/shiori/condom.rpy:42
translate russian shiori_intro_condom_25ebf643:
    "Может, я и расхваливал свою эрекцию, чтобы сильнее возбудить Сиори."

# ch/shiori/condom.rpy:43
translate russian shiori_intro_condom_b20607fb:
    "Но вовсе не выдумывал всё это только ради неё."

# ch/shiori/condom.rpy:44
translate russian shiori_intro_condom_648ba58c:
    "Я так сильно хочу сейчас войти в неё, и совсем не хочу, чтобы внутри нас что-то разделяло!"

# ch/shiori/condom.rpy:46
translate russian shiori_intro_condom_95926b89:
    "В этот миг я думаю только о Сиори и больше ни секунды не могу ждать."

# ch/shiori/condom.rpy:47
translate russian shiori_intro_condom_152c8654:
    "Не останавливаясь даже для вздоха, я толкаюсь членом вверх."

# ch/shiori/condom.rpy:54
translate russian shiori_warn_condom_2e23d98c:
    shiori.say "Ой, подожди..."

# ch/shiori/condom.rpy:55
translate russian shiori_warn_condom_95bd7cb6:
    shiori.say "Нам правда стоит надеть презерватив!"

# ch/shiori/condom.rpy:57
translate russian shiori_warn_condom_f182a549:
    shiori.say "Ох, [lssb_shiori.hero_name()], подожди!"

# ch/shiori/condom.rpy:58
translate russian shiori_warn_condom_5bc807fe:
    shiori.say "А как же защита?"

# ch/shiori/condom.rpy:59
translate russian shiori_warn_condom_7b18271f:
    "Вопрос Сиори заставляет меня мгновенно замереть."

# ch/shiori/condom.rpy:60
translate russian shiori_warn_condom_372a291c:
    "Мне это действительно даже не пришло в голову!"

# ch/shiori/condom.rpy:62
translate russian shiori_warn_condom_69dcf570:
    shiori.say "[lssb_shiori.hero_name()], подожди!"

# ch/shiori/condom.rpy:63
translate russian shiori_warn_condom_1dbe3cb5:
    shiori.say "Ты не собираешься надеть презерватив?"

# ch/shiori/condom.rpy:64
translate russian shiori_warn_condom_9990d857:
    "После вопроса Сиори всё останавливается."

# ch/shiori/condom.rpy:65
translate russian shiori_warn_condom_776c5701:
    "И чтобы продолжить, мне нужно ответить!"

# ch/shiori/condom.rpy:66
translate russian shiori_warn_condom_943e962b:
    mike.say "Эм, нет, Сиори."

# ch/shiori/condom.rpy:67
translate russian shiori_warn_condom_6f80efe3:
    mike.say "Пожалуй, нет!"

# ch/shiori/condom.rpy:68
translate russian shiori_warn_condom_c9fd19d8:
    "Сиори выглядит удивлённой и немного задетой."

# ch/shiori/condom.rpy:72
translate russian shiori_force_condom_7159d372:
    shiori.say "Не волнуйся..."

# ch/shiori/condom.rpy:73
translate russian shiori_force_condom_1c3c585c:
    shiori.say "У меня есть один в сумке."

# ch/shiori/condom.rpy:74
translate russian shiori_force_condom_52eb7800:
    shiori.say "Вон там!"

# ch/shiori/condom.rpy:75
translate russian shiori_force_condom_f87d4e9f:
    "Мне хватает нескольких мгновений, чтобы найти презерватив."

# ch/shiori/condom.rpy:76
translate russian shiori_force_condom_9b159839:
    "Ещё несколько секунд — и он на мне."

# ch/shiori/condom.rpy:77
translate russian shiori_force_condom_f85b50d7:
    "Теперь мы готовы."

# ch/shiori/condom.rpy:81
translate russian shiori_mad_condom_f46d5799:
    mike.say "Забудь об этом, Сиори!"

# ch/shiori/condom.rpy:82
translate russian shiori_mad_condom_58f08fe4:
    mike.say "Давай просто повеселимся, ладно?"

# ch/shiori/condom.rpy:83
translate russian shiori_mad_condom_b8de9a7d:
    "Сиори смотрит на меня потрясённо."

# ch/shiori/condom.rpy:84
translate russian shiori_mad_condom_3316562f:
    "Затем отталкивает меня и скатывается с кровати."

# ch/shiori/condom.rpy:85
translate russian shiori_mad_condom_f1c809b9:
    mike.say "Сиори!"

# ch/shiori/condom.rpy:86
translate russian shiori_mad_condom_f809254b:
    mike.say "Ты что делаешь?!"

# ch/shiori/condom.rpy:87
translate russian shiori_mad_condom_28eb386e:
    "Сиори не оборачивается."

# ch/shiori/condom.rpy:88
translate russian shiori_mad_condom_92cd9025:
    "Она просто начинает одеваться."

# ch/shiori/condom.rpy:89
translate russian shiori_mad_condom_7f04e360:
    shiori.say "Я... я думала, ты другой, [lssb_shiori.hero_name()]."

# ch/shiori/condom.rpy:90
translate russian shiori_mad_condom_12597403:
    shiori.say "Но ты такой же, как все мужчины."

# ch/shiori/condom.rpy:91
translate russian shiori_mad_condom_f9b04671:
    shiori.say "Эгоистичный зверь!"

# ch/shiori/condom.rpy:92
translate russian shiori_mad_condom_edd23fad:
    "Полуодетая Сиори в ярости вылетает из комнаты."

# ch/shiori/condom.rpy:93
translate russian shiori_mad_condom_6341b2cd:
    "А я остаюсь один и проклинаю себя."

# ch/shiori/date.rpy:2
translate russian shiori_date_intro_valentine_male_497d1e4b:
    mike.say "С Днём святого Валентина, Сиори."

# ch/shiori/date.rpy:3
translate russian shiori_date_intro_valentine_male_870a1f7d:
    mike.say "И я просто хотел сказать..."

# ch/shiori/date.rpy:4
translate russian shiori_date_intro_valentine_male_d352c381:
    mike.say "Ни с кем другим я не хотел бы провести этот день больше, чем с тобой!"

# ch/shiori/date.rpy:5
translate russian shiori_date_intro_valentine_male_a6a0a991:
    "От моих слов глаза Сиори загораются, и она складывает ладони вместе."

# ch/shiori/date.rpy:6
translate russian shiori_date_intro_valentine_male_54a48035:
    shiori.say "Т... ты правда так думаешь?!"

# ch/shiori/date.rpy:7
translate russian shiori_date_intro_valentine_male_7b67ebae:
    mike.say "Конечно, Сиори."

# ch/shiori/date.rpy:8
translate russian shiori_date_intro_valentine_male_263dac02:
    mike.say "Для меня ты самый особенный человек на свете!"

# ch/shiori/date.rpy:9
translate russian shiori_date_intro_valentine_male_61a120a3:
    "Сиори бросается мне на шею, обнимает и отказывается отпускать."

# ch/shiori/date.rpy:13
translate russian shiori_date_intro_halloween_male_0b4fbe78:
    mike.say "Эй, Сиори, ты без костюма на Хэллоуин?"

# ch/shiori/date.rpy:14
translate russian shiori_date_intro_halloween_male_d4dc078e:
    "Едва услышав вопрос, Сиори начинает качать головой."

# ch/shiori/date.rpy:15
translate russian shiori_date_intro_halloween_male_59a009ed:
    shiori.say "Ой... мне нужно было надеть костюм?"

# ch/shiori/date.rpy:16
translate russian shiori_date_intro_halloween_male_29398b23:
    shiori.say "Наверное, совсем забыла. Какая же я растяпа!"

# ch/shiori/date.rpy:17
translate russian shiori_date_intro_halloween_male_c1b76912:
    "Я поднимаю руки, пытаясь остановить её самобичевание."

# ch/shiori/date.rpy:18
translate russian shiori_date_intro_halloween_male_d6575458:
    mike.say "Погоди, Сиори, всё хорошо!"

# ch/shiori/date.rpy:19
translate russian shiori_date_intro_halloween_male_7a96b151:
    mike.say "Мы не договаривались о костюмах. Я просто пошутил!"

# ch/shiori/date.rpy:20
translate russian shiori_date_intro_halloween_male_7dfa678a:
    "Услышав это, Сиори тут же успокаивается."

# ch/shiori/date.rpy:21
translate russian shiori_date_intro_halloween_male_a94d34cc:
    shiori.say "Ох, слава богу!"

# ch/shiori/date.rpy:22
translate russian shiori_date_intro_halloween_male_50bc5ac8:
    shiori.say "Но... на следующий Хэллоуин я могу нарядиться, если хочешь?"

# ch/shiori/date.rpy:26
translate russian shiori_date_intro_christmas_male_2582b266:
    shiori.say "С Рождеством, [lssb_shiori.hero_name()]."

# ch/shiori/date.rpy:27
translate russian shiori_date_intro_christmas_male_995bdc56:
    shiori.say "И огромное спасибо, что решил провести его со мной!"

# ch/shiori/date.rpy:28
translate russian shiori_date_intro_christmas_male_0069cdcc:
    "Сиори прижимается к моей руке и смотрит на меня снизу вверх с нескрываемым обожанием."

# ch/shiori/date.rpy:29
translate russian shiori_date_intro_christmas_male_45a99200:
    "Сердце переполняется нежностью, и мне хочется защищать её изо всех сил."

# ch/shiori/date.rpy:30
translate russian shiori_date_intro_christmas_male_f9c8380f:
    mike.say "Ни с кем другим я не хотел бы быть больше, чем с тобой, Сиори."

# ch/shiori/date.rpy:31
translate russian shiori_date_intro_christmas_male_8acc0b59:
    mike.say "И единственный подарок, который я хочу на это Рождество, — ты."

# ch/shiori/date.rpy:35
translate russian shiori_date_intro_birthday_male_3faa9c6f:
    mike.say "С днём рождения, Сиори!"

# ch/shiori/date.rpy:36
translate russian shiori_date_intro_birthday_male_d6743f39:
    mike.say "Я сделаю этот день рождения лучшим в твоей жизни."

# ch/shiori/date.rpy:37
translate russian shiori_date_intro_birthday_male_5e8ba1f2:
    mike.say "Потому что ты особенная!"

# ch/shiori/date.rpy:38
translate russian shiori_date_intro_birthday_male_1d77c1ae:
    shiori.say "Ох, [lssb_shiori.hero_name()]!"

# ch/shiori/date.rpy:39
translate russian shiori_date_intro_birthday_male_4f29b0ae:
    shiori.say "Ты правда так думаешь?"

# ch/shiori/date.rpy:40
translate russian shiori_date_intro_birthday_male_a3644110:
    shiori.say "Боже, я чувствую себя самой везучей девушкой на свете!"

# ch/shiori/date.rpy:44
translate russian shiori_date_intro_mc_birthday_male_91514098:
    shiori.say "С днём рождения, [lssb_shiori.hero_name()]!"

# ch/shiori/date.rpy:45
translate russian shiori_date_intro_mc_birthday_male_ddceb8ab:
    shiori.say "И не волнуйся: я позабочусь о том, чтобы наше свидание было особенным!"

# ch/shiori/date.rpy:46
translate russian shiori_date_intro_mc_birthday_male_e0594fe6:
    mike.say "Ох... спасибо, Сиори!"

# ch/shiori/date.rpy:47
translate russian shiori_date_intro_mc_birthday_male_bb9448b3:
    mike.say "Так мило, что ты помнишь мой день рождения."

# ch/shiori/date.rpy:48
translate russian shiori_date_intro_mc_birthday_male_c218ca29:
    shiori.say "Конечно помню, [lssb_shiori.hero_name()]!"

# ch/shiori/date.rpy:49
translate russian shiori_date_intro_mc_birthday_male_6aa30122:
    shiori.say "Я хочу быть лучшей девушкой на свете."

# ch/shiori/date.rpy:50
translate russian shiori_date_intro_mc_birthday_male_92d55caa:
    shiori.say "Потому что ты этого заслуживаешь!"

# ch/shiori/date.rpy:54
translate russian shiori_date_eat_a_burger_a92c95e9:
    "Сиори, кажется, счастлива уже оттого, что ест со мной бургер на людях."

# ch/shiori/date.rpy:55
translate russian shiori_date_eat_a_burger_1e7a74a4:
    "Она ни на секунду не перестаёт хихикать и улыбаться, словно восторженный ребёнок."

# ch/shiori/date.rpy:56
translate russian shiori_date_eat_a_burger_4f470b16:
    "Я даже удивляюсь, как у неё от этого не раздувает живот!"

# ch/shiori/date.rpy:63
translate russian shiori_date_buy_drink_c0765072:
    shiori.say "Ох... как ты мог, [lssb_shiori.hero_name()]?"

# ch/shiori/date.rpy:64
translate russian shiori_date_buy_drink_4438ebac:
    shiori.say "Ты же знаешь, что мне нельзя пить во время беременности!"

# ch/shiori/date.rpy:65
translate russian shiori_date_buy_drink_14f42a84:
    shiori.say "Я думала, тебе небезразличны я и малыш?!"

# ch/shiori/date.rpy:69
translate russian shiori_date_buy_drink_c77a9816:
    "Заказывая напитки, Сиори ведёт себя так, будто совершенно не знает, что делать и говорить."

# ch/shiori/date.rpy:70
translate russian shiori_date_buy_drink_62a59985:
    "В итоге мне приходится выбрать напиток за неё."

# ch/shiori/date.rpy:71
translate russian shiori_date_buy_drink_433cbd67:
    "Когда его приносят, она смотрит на него с неподдельным интересом."

# ch/shiori/date.rpy:72
translate russian shiori_date_buy_drink_5e4539a9:
    "По её виду можно подумать, что она собирается выпить какое-то невероятное волшебное зелье."

# ch/shiori/date.rpy:76
translate russian shiori_date_play_darts_eff5b025:
    "Сиори послушно подходит к линии броска, но дротики в руке явно приводят её в замешательство."

# ch/shiori/date.rpy:77
translate russian shiori_date_play_darts_43f5c9bb:
    "Не знаю, чего она больше боится: острых наконечников или опозориться на людях."

# ch/shiori/date.rpy:78
translate russian shiori_date_play_darts_f7cce772:
    "Наконец она набирается смелости и бросает."

# ch/shiori/date.rpy:79
translate russian shiori_date_play_darts_d0ae88cd:
    "Один дротик даже попадает в мишень, прежде чем отскочить в толпу."

# ch/shiori/date.rpy:83
translate russian shiori_date_pub_play_pool_7adb493b:
    "Сиори явно понятия не имеет, как играть в пул."

# ch/shiori/date.rpy:84
translate russian shiori_date_pub_play_pool_f3c0105d:
    "Она смотрит на кий в своей руке, словно это заряженное ружьё."

# ch/shiori/date.rpy:85
translate russian shiori_date_pub_play_pool_197ffa23:
    "Мне едва удаётся добиться, чтобы она попала хотя бы по битку, не говоря обо всём остальном."

# ch/shiori/date.rpy:92
translate russian shiori_date_buy_a_round_c0765072:
    shiori.say "Ох... как ты мог, [lssb_shiori.hero_name()]?"

# ch/shiori/date.rpy:93
translate russian shiori_date_buy_a_round_4438ebac:
    shiori.say "Ты же знаешь, что мне нельзя пить во время беременности!"

# ch/shiori/date.rpy:94
translate russian shiori_date_buy_a_round_14f42a84:
    shiori.say "Я думала, тебе небезразличны я и малыш?!"

# ch/shiori/date.rpy:99
translate russian shiori_date_buy_a_round_ad472b03:
    "Когда я предлагаю заказать ещё, Сиори мило улыбается."

# ch/shiori/date.rpy:100
translate russian shiori_date_buy_a_round_2098fca0:
    "Но по её лицу ясно: ей всё равно."

# ch/shiori/date.rpy:101
translate russian shiori_date_buy_a_round_72a58caa:
    "Может, она просто не очень любит выпить?"

# ch/shiori/date.rpy:108
translate russian shiori_date_buy_a_round_fb20fd2c:
    "Я хочу угостить пивом весь паб."

# ch/shiori/date.rpy:109
translate russian shiori_date_buy_a_round_fe29619d:
    "Но Сиори, похоже, не хочет пить, поэтому я тоже воздерживаюсь."

# ch/shiori/date.rpy:114
translate russian shiori_dance_with_37a50c25:
    "Хотя Сиори немного неуклюжа и не уверена в себе, на танцполе она выкладывается целиком."

# ch/shiori/date.rpy:115
translate russian shiori_dance_with_8ab126b8:
    "И меня покоряет её воодушевление от одной лишь возможности танцевать со мной."

# ch/shiori/date.rpy:116
translate russian shiori_dance_with_f64bf804:
    "Я начинаю испытывать к ней то же самое."

# ch/shiori/date.rpy:120
translate russian shiori_date_play_arcade_intro_male_242c615f:
    shiori.say "Ох..."

# ch/shiori/date.rpy:121
translate russian shiori_date_play_arcade_intro_male_bad70fac:
    shiori.say "Не думаю, что это место для меня, [lssb_shiori.hero_name()]!"

# ch/shiori/date.rpy:122
translate russian shiori_date_play_arcade_intro_male_aa9ac0e0:
    shiori.say "То есть я, КОНЕЧНО, играла с Кантой на его Zbox."

# ch/shiori/date.rpy:123
translate russian shiori_date_play_arcade_intro_male_469679f6:
    shiori.say "Но у меня никогда толком не получалось!"

# ch/shiori/date.rpy:124
translate russian shiori_date_play_arcade_intro_male_34c1eaaa:
    "Я стараюсь улыбнуться как можно ободряюще Сиори, повисшей на моей руке."

# ch/shiori/date.rpy:125
translate russian shiori_date_play_arcade_intro_male_ea8c411e:
    "Но одновременно окружающие игры неудержимо меня манят."

# ch/shiori/date.rpy:126
translate russian shiori_date_play_arcade_intro_male_06e5d655:
    "Мне пришлось изрядно постараться, чтобы убедить её сходить в зал игровых автоматов."

# ch/shiori/date.rpy:127
translate russian shiori_date_play_arcade_intro_male_e261e4a6:
    "И теперь, когда мы здесь, совсем не хочется, чтобы она убежала."

# ch/shiori/date.rpy:128
translate russian shiori_date_play_arcade_intro_male_5b216aa5:
    mike.say "Не волнуйся, Сиори."

# ch/shiori/date.rpy:129
translate russian shiori_date_play_arcade_intro_male_90c91d77:
    mike.say "Спорим, Канта играет только в новые игры?"

# ch/shiori/date.rpy:130
translate russian shiori_date_play_arcade_intro_male_1a1bf46b:
    mike.say "В те, которые очень сложные?"

# ch/shiori/date.rpy:131
translate russian shiori_date_play_arcade_intro_male_7d956342:
    shiori.say "Эм... наверное, [lssb_shiori.hero_name()]."

# ch/shiori/date.rpy:132
translate russian shiori_date_play_arcade_intro_male_00891fcd:
    mike.say "А здесь в основном старые игры."

# ch/shiori/date.rpy:133
translate russian shiori_date_play_arcade_intro_male_bd2918b7:
    mike.say "Классика, понимаешь?"

# ch/shiori/date.rpy:134
translate russian shiori_date_play_arcade_intro_male_9a04fd47:
    mike.say "В них играть гораздо проще, Сиори."

# ch/shiori/date.rpy:135
translate russian shiori_date_play_arcade_intro_male_5ccc4b09:
    shiori.say "Как скажешь, [lssb_shiori.hero_name()]."

# ch/shiori/date.rpy:136
translate russian shiori_date_play_arcade_intro_male_b1418722:
    mike.say "Давай попробуем эту — «Баббл Бубл»!"

# ch/shiori/date.rpy:137
translate russian shiori_date_play_arcade_intro_male_4e7d431b:
    "Сиори смотрит с тревогой."

# ch/shiori/date.rpy:138
translate russian shiori_date_play_arcade_intro_male_0a190135:
    "Но я уже бросаю монеты в автомат."

# ch/shiori/date.rpy:139
translate russian shiori_date_play_arcade_intro_male_d823df84:
    shiori.say "Это... драконы?"

# ch/shiori/date.rpy:140
translate russian shiori_date_play_arcade_intro_male_1222590d:
    shiori.say "Драконы с грудью?!"

# ch/shiori/date.rpy:141
translate russian shiori_date_play_arcade_intro_male_34c3d8a3:
    mike.say "Не обращай внимания на драконьи груди, Сиори."

# ch/shiori/date.rpy:142
translate russian shiori_date_play_arcade_intro_male_68120a93:
    mike.say "Просто смотри на меня — и мигом научишься!"

# ch/shiori/date.rpy:146
translate russian shiori_date_play_arcade_win_male_a6849017:
    "Вскоре я сосредоточен только на игре."

# ch/shiori/date.rpy:147
translate russian shiori_date_play_arcade_win_male_fcc41941:
    "Так что понятия не имею, следует ли Сиори моему совету."

# ch/shiori/date.rpy:148
translate russian shiori_date_play_arcade_win_male_cec27a71:
    "Но, судя по тому, что я слышу, разницы это всё равно не делает!"

# ch/shiori/date.rpy:149
translate russian shiori_date_play_arcade_win_male_0b813aac:
    shiori.say "Ой... боже..."

# ch/shiori/date.rpy:150
translate russian shiori_date_play_arcade_win_male_6d5cbfe4:
    shiori.say "А что делает эта кнопка?"

# ch/shiori/date.rpy:151
translate russian shiori_date_play_arcade_win_male_86bce440:
    shiori.say "Надо же, он выдул пузырь!"

# ch/shiori/date.rpy:152
translate russian shiori_date_play_arcade_win_male_1f4b5f63:
    shiori.say "Как заставить его сделать это снова?!"

# ch/shiori/date.rpy:153
translate russian shiori_date_play_arcade_win_male_e840d9b6:
    mike.say "Не может быть так сложно, Сиори."

# ch/shiori/date.rpy:154
translate russian shiori_date_play_arcade_win_male_4424a0b0:
    mike.say "Тут всего две кнопки!"

# ch/shiori/date.rpy:155
translate russian shiori_date_play_arcade_win_male_f12de9e8:
    "До конца игры Сиори продолжает путаться."

# ch/shiori/date.rpy:156
translate russian shiori_date_play_arcade_win_male_1c5a57c3:
    "И каждое её действие сопровождается новыми тревожными возгласами."

# ch/shiori/date.rpy:157
translate russian shiori_date_play_arcade_win_male_bef774dd:
    "Когда у нас заканчиваются все попытки, она уже чуть не плачет!"

# ch/shiori/date.rpy:158
translate russian shiori_date_play_arcade_win_male_73f852aa:
    shiori.say "Можно больше не играть, [lssb_shiori.hero_name()]?"

# ch/shiori/date.rpy:159
translate russian shiori_date_play_arcade_win_male_cb552c98:
    shiori.say "Пожалуйста, не заставляй меня снова!"

# ch/shiori/date.rpy:160
translate russian shiori_date_play_arcade_win_male_495b3037:
    shiori.say "Я сделаю что угодно, только скажи, что больше не придётся играть!"

# ch/shiori/date.rpy:161
translate russian shiori_date_play_arcade_win_male_a83c43f9:
    mike.say "Боже, Сиори, успокойся!"

# ch/shiori/date.rpy:162
translate russian shiori_date_play_arcade_win_male_e5e893c3:
    mike.say "Больше не будем, ладно?"

# ch/shiori/date.rpy:163
translate russian shiori_date_play_arcade_win_male_01082267:
    "Сиори облегчённо вздыхает."

# ch/shiori/date.rpy:164
translate russian shiori_date_play_arcade_win_male_53dd58a7:
    "И снова берёт меня под руку."

# ch/shiori/date.rpy:165
translate russian shiori_date_play_arcade_win_male_d5aa778a:
    mike.say "Ну так вот, Сиори."

# ch/shiori/date.rpy:166
translate russian shiori_date_play_arcade_win_male_adb900b2:
    mike.say "Насчёт обещания сделать что угодно..."

# ch/shiori/date.rpy:170
translate russian shiori_date_play_arcade_lose_male_3cb1514a:
    "Я пытаюсь сосредоточиться на игре и не слышать просьб Сиори о помощи."

# ch/shiori/date.rpy:171
translate russian shiori_date_play_arcade_lose_male_4ade6aa7:
    "Но она продолжает задавать вопросы, и я отвлекаюсь всё сильнее."

# ch/shiori/date.rpy:172
translate russian shiori_date_play_arcade_lose_male_27764998:
    "Хуже того, мои советы, похоже, ей действительно помогают!"

# ch/shiori/date.rpy:173
translate russian shiori_date_play_arcade_lose_male_34fe7274:
    shiori.say "А-а... теперь понимаю, что делает эта кнопка!"

# ch/shiori/date.rpy:174
translate russian shiori_date_play_arcade_lose_male_c061c80d:
    shiori.say "И эта тоже..."

# ch/shiori/date.rpy:175
translate russian shiori_date_play_arcade_lose_male_fb2d744e:
    shiori.say "Хи-хи... Я заставила драконьи сиськи подпрыгнуть!"

# ch/shiori/date.rpy:176
translate russian shiori_date_play_arcade_lose_male_c63ef2dd:
    mike.say "Хватит болтать мне под ухо, Сиори."

# ch/shiori/date.rpy:177
translate russian shiori_date_play_arcade_lose_male_95841a6b:
    mike.say "Ты меня отвлекаешь!"

# ch/shiori/date.rpy:178
translate russian shiori_date_play_arcade_lose_male_90df4310:
    "Если Сиори вообще меня слышит, то предпочитает не обращать внимания."

# ch/shiori/date.rpy:179
translate russian shiori_date_play_arcade_lose_male_a0f0fe58:
    "Вместо этого она продолжает щебетать всю игру."

# ch/shiori/date.rpy:180
translate russian shiori_date_play_arcade_lose_male_e15ea23f:
    "И чем лучше она осваивается, тем сильнее я отстаю."

# ch/shiori/date.rpy:181
translate russian shiori_date_play_arcade_lose_male_f6dddbeb:
    "Когда у нас заканчиваются попытки, я уже чуть не плачу от досады!"

# ch/shiori/date.rpy:182
translate russian shiori_date_play_arcade_lose_male_a06e7ef7:
    mike.say "Может, хватит, Сиори?"

# ch/shiori/date.rpy:183
translate russian shiori_date_play_arcade_lose_male_7a2e2668:
    mike.say "Пожалуйста, не заставляй меня играть снова!"

# ch/shiori/date.rpy:184
translate russian shiori_date_play_arcade_lose_male_0d0457ea:
    shiori.say "Т... ты серьёзно, [lssb_shiori.hero_name()]?"

# ch/shiori/date.rpy:185
translate russian shiori_date_play_arcade_lose_male_b9a9daeb:
    shiori.say "Я думала, ты такое любишь?"

# ch/shiori/date.rpy:186
translate russian shiori_date_play_arcade_lose_male_bb9cb681:
    mike.say "Не знаю, Сиори..."

# ch/shiori/date.rpy:187
translate russian shiori_date_play_arcade_lose_male_de39b7fb:
    mike.say "Сегодня никак не могу сосредоточиться, понимаешь?"

# ch/shiori/date.rpy:188
translate russian shiori_date_play_arcade_lose_male_7fffd85d:
    shiori.say "Ой, бедненький, [lssb_shiori.hero_name()]!"

# ch/shiori/date.rpy:189
translate russian shiori_date_play_arcade_lose_male_7d380c5f:
    shiori.say "Пойдём посидим где-нибудь в тишине."

# ch/shiori/date.rpy:190
translate russian shiori_date_play_arcade_lose_male_ce5477af:
    shiori.say "И я расскажу тебе во всех подробностях, как выиграла!"

# ch/shiori/date.rpy:198
translate russian shiori_dick_reactions_fb74f630:
    shiori.say "О боже... боже..."

# ch/shiori/date.rpy:199
translate russian shiori_dick_reactions_a49bb50a:
    shiori.say "Ты не говорил, что он ТАКОЙ большой!"

# ch/shiori/date.rpy:200
translate russian shiori_dick_reactions_9745166b:
    mike.say "Не волнуйся, Сиори, обещаю быть нежным."

# ch/shiori/date.rpy:201
translate russian shiori_dick_reactions_75db8c78:
    shiori.say "П... правда?"

# ch/shiori/date.rpy:203
translate russian shiori_dick_reactions_e30ea788:
    shiori.say "Ну... ладно, раз ты так говоришь..."

# ch/shiori/date.rpy:207
translate russian shiori_dick_reactions_d49097f1:
    shiori.say "Ой... какой аккуратный!"

# ch/shiori/date.rpy:208
translate russian shiori_dick_reactions_d6a69cff:
    mike.say "Т... ты хочешь сказать, маленький?!"

# ch/shiori/date.rpy:209
translate russian shiori_dick_reactions_64aac3d3:
    shiori.say "О нет, он идеальный!"

# ch/shiori/date.rpy:210
translate russian shiori_dick_reactions_832af1b7:
    shiori.say "Чем больше, тем больнее."

# ch/shiori/date.rpy:211
translate russian shiori_dick_reactions_99f3d8cf:
    shiori.say "Мне нравится, когда со мной нежны..."

# ch/shiori/date.rpy:218
translate russian shiori_halloween_invitation_61185b05:
    "С самого начала я знаю, что на вечеринку в честь Хэллоуина хочу пригласить именно Сиори."

# ch/shiori/date.rpy:219
translate russian shiori_halloween_invitation_16222032:
    "Это кажется правильным, и я легко представляю, как хорошо ей будет среди гостей."

# ch/shiori/date.rpy:220
translate russian shiori_halloween_invitation_d8e7c213:
    "К тому же у меня появится возможность провести с ней большую часть вечера."

# ch/shiori/date.rpy:221
translate russian shiori_halloween_invitation_79f86124:
    "В общем, идеальный способ и отметить Хэллоуин, и повеселиться с Сиори."

# ch/shiori/date.rpy:222
translate russian shiori_halloween_invitation_ffa507aa:
    "Поэтому при первой же возможности я без колебаний приглашаю её."

# ch/shiori/date.rpy:223
translate russian shiori_halloween_invitation_d783f573:
    mike.say "Сиори..."

# ch/shiori/date.rpy:224
translate russian shiori_halloween_invitation_c36e23c9:
    mike.say "У тебя есть планы на Хэллоуин?"

# ch/shiori/date.rpy:226
translate russian shiori_halloween_invitation_d2583630:
    "От вопроса глаза Сиори расширяются."

# ch/shiori/date.rpy:227
translate russian shiori_halloween_invitation_76b754a8:
    "Она явно застигнута врасплох."

# ch/shiori/date.rpy:228
translate russian shiori_halloween_invitation_c102a48f:
    shiori.say "О..."

# ch/shiori/date.rpy:229
translate russian shiori_halloween_invitation_3d6ea9c8:
    shiori.say "На Хэллоуин?"

# ch/shiori/date.rpy:231
translate russian shiori_halloween_invitation_f00cf5ff:
    shiori.say "Нет, [lssb_shiori.hero_name()], никаких."

# ch/shiori/date.rpy:232
translate russian shiori_halloween_invitation_d986c764:
    shiori.say "Обычно я просто хожу с Кантой собирать сладости!"

# ch/shiori/date.rpy:233
translate russian shiori_halloween_invitation_19f192c5:
    "Я киваю, чувствуя себя немного виноватым за то, что пропускаю её объяснение мимо ушей."

# ch/shiori/date.rpy:234
translate russian shiori_halloween_invitation_dca05c20:
    "Но иначе никогда не доберусь до сути."

# ch/shiori/date.rpy:235
translate russian shiori_halloween_invitation_1c0d45e8:
    mike.say "Ну..."

# ch/shiori/date.rpy:236
translate russian shiori_halloween_invitation_6ba87b0d:
    mike.say "Мы устраиваем у меня вечеринку на Хэллоуин."

# ch/shiori/date.rpy:237
translate russian shiori_halloween_invitation_86ee4c8d:
    mike.say "И я хотел бы, чтобы ты пришла — со мной, как моя девушка."

# ch/shiori/date.rpy:239
translate russian shiori_halloween_invitation_4bc4b861:
    "Глаза Сиори раскрываются ещё шире."

# ch/shiori/date.rpy:240
translate russian shiori_halloween_invitation_a07002bd:
    "И она начинает краснеть."

# ch/shiori/date.rpy:241
translate russian shiori_halloween_invitation_24593ef1:
    shiori.say "Вечеринку?"

# ch/shiori/date.rpy:243
translate russian shiori_halloween_invitation_7a721c37:
    shiori.say "Ох, [lssb_shiori.hero_name()], как мило, что ты меня пригласил!"

# ch/shiori/date.rpy:244
translate russian shiori_halloween_invitation_dca42be3:
    mike.say "Конечно, Сиори, конечно."

# ch/shiori/date.rpy:245
translate russian shiori_halloween_invitation_4bf29f04:
    mike.say "Так ты придёшь или нет?"

# ch/shiori/date.rpy:248
translate russian shiori_halloween_invitation_901f817c:
    "Сиори медленно кивает."

# ch/shiori/date.rpy:249
translate russian shiori_halloween_invitation_a012c634:
    "А затем всё быстрее."

# ch/shiori/date.rpy:250
translate russian shiori_halloween_invitation_8401667f:
    "И моё сердце тоже начинает биться чаще!"

# ch/shiori/date.rpy:251
translate russian shiori_halloween_invitation_2df979d7:
    shiori.say "Обычно на Хэллоуин я хожу с Кантой собирать сладости."

# ch/shiori/date.rpy:252
translate russian shiori_halloween_invitation_1c8e3794:
    shiori.say "Но в этом году он хочет пойти со школьным другом и его мамой."

# ch/shiori/date.rpy:253
translate russian shiori_halloween_invitation_03613e5b:
    shiori.say "Я собиралась отказать, но если разрешу..."

# ch/shiori/date.rpy:254
translate russian shiori_halloween_invitation_2b64db54:
    mike.say "Ты сможешь прийти на вечеринку?"

# ch/shiori/date.rpy:257
translate russian shiori_halloween_invitation_ad65ffab:
    "Сиори кивает и улыбается."

# ch/shiori/date.rpy:258
translate russian shiori_halloween_invitation_d3362982:
    "Она явно счастлива, что может меня порадовать."

# ch/shiori/date.rpy:260
translate russian shiori_halloween_invitation_2f7bc7af:
    shiori.say "Раньше Канта всегда ходил собирать сладости с отцом."

# ch/shiori/date.rpy:261
translate russian shiori_halloween_invitation_185e6096:
    shiori.say "Я старалась сохранить эту традицию, чтобы ему было хорошо."

# ch/shiori/date.rpy:262
translate russian shiori_halloween_invitation_15c621b8:
    shiori.say "Но, может, пора перестать за такое цепляться?"

# ch/shiori/date.rpy:264
translate russian shiori_halloween_invitation_2d4e4a12:
    shiori.say "И... знаешь, завести собственные новые традиции?"

# ch/shiori/date.rpy:265
translate russian shiori_halloween_invitation_ea2cc650:
    "Говоря это, Сиори берёт меня за руку."

# ch/shiori/date.rpy:266
translate russian shiori_halloween_invitation_bc63c5e7:
    "И я чувствую, как тоже расплываюсь в улыбке!"

# ch/shiori/date.rpy:270
translate russian shiori_halloween_invitation_581f73cc:
    "Сиори медленно качает головой."

# ch/shiori/date.rpy:271
translate russian shiori_halloween_invitation_b920d32d:
    "Но в её глазах я вижу сожаление."

# ch/shiori/date.rpy:272
translate russian shiori_halloween_invitation_13ab7ca3:
    "Она хочет согласиться."

# ch/shiori/date.rpy:273
translate russian shiori_halloween_invitation_52ea45d6:
    "Но что-то её останавливает."

# ch/shiori/date.rpy:274
translate russian shiori_halloween_invitation_1d9ea02e:
    shiori.say "Не могу, [lssb_shiori.hero_name()]."

# ch/shiori/date.rpy:275
translate russian shiori_halloween_invitation_18c652fe:
    shiori.say "Нужно отвести Канту собирать сладости."

# ch/shiori/date.rpy:276
translate russian shiori_halloween_invitation_bac10683:
    shiori.say "Раньше он всегда делал это с отцом."

# ch/shiori/date.rpy:277
translate russian shiori_halloween_invitation_35293472:
    shiori.say "Он очень расстроится, если я его не отведу!"

# ch/shiori/date.rpy:278
translate russian shiori_halloween_invitation_b8e770f7:
    "Мне хочется поспорить с Сиори и переубедить её."

# ch/shiori/date.rpy:279
translate russian shiori_halloween_invitation_b3be2d7c:
    "Но я знаю, как сильно она любит сына."

# ch/shiori/date.rpy:280
translate russian shiori_halloween_invitation_b367c183:
    "И знаю, как тяжело мальчику с тех пор, как отец их бросил."

# ch/shiori/date.rpy:281
translate russian shiori_halloween_invitation_ca1c10ad:
    "Было бы эгоистично давить на неё ради своих желаний."

# ch/shiori/date.rpy:282
translate russian shiori_halloween_invitation_1243de92:
    mike.say "Всё хорошо, Сиори."

# ch/shiori/date.rpy:283
translate russian shiori_halloween_invitation_23f467eb:
    mike.say "Я понимаю, что ты должна быть рядом с Кантой."

# ch/shiori/date.rpy:286
translate russian shiori_halloween_invitation_b45b239d:
    "Сиори смотрит на меня снизу вверх и улыбается, искренне радуясь моему ответу."

# ch/shiori/date.rpy:287
translate russian shiori_halloween_invitation_7fb64e0e:
    "Пусть в этот раз я не получил желаемого."

# ch/shiori/date.rpy:288
translate russian shiori_halloween_invitation_a8e6ead3:
    "Но чувствую, что поступил правильно."

# ch/shiori/date.rpy:289
translate russian shiori_halloween_invitation_89a7058c:
    "И заодно заслужил расположение Сиори."

# ch/shiori/date.rpy:298
translate russian shiori_halloween_arrival_71ced52a:
    "Открывая дверь, я почти не думаю о том, что делаю."

# ch/shiori/date.rpy:299
translate russian shiori_halloween_arrival_00a5335d:
    "В голове всё ещё крутятся тревоги о вечеринке."

# ch/shiori/date.rpy:301
translate russian shiori_halloween_arrival_5871634b:
    "Но всё это исчезает, стоит мне увидеть, кто стоит передо мной."

# ch/shiori/date.rpy:302
translate russian shiori_halloween_arrival_3f8382ca:
    mike.say "Ого..."

# ch/shiori/date.rpy:303
translate russian shiori_halloween_arrival_0de50a8e:
    mike.say "Эти штуки..."

# ch/shiori/date.rpy:305
translate russian shiori_halloween_arrival_cd19f936:
    shiori.say "Ой, знаю, знаю!"

# ch/shiori/date.rpy:306
translate russian shiori_halloween_arrival_10b28cf9:
    shiori.say "Такие костюмы ужасно тесные."

# ch/shiori/date.rpy:307
translate russian shiori_halloween_arrival_e4f7c303:
    shiori.say "Я еле в него влезла!"

# ch/shiori/date.rpy:308
translate russian shiori_halloween_arrival_91693369:
    "Я машинально киваю в ответ, даже не глядя Сиори в лицо."

# ch/shiori/date.rpy:309
translate russian shiori_halloween_arrival_e6522393:
    "А всё потому, что не могу оторвать взгляд от её груди!"

# ch/shiori/date.rpy:310
translate russian shiori_halloween_arrival_5174ff92:
    "Она и так обычно отвлекает меня."

# ch/shiori/date.rpy:311
translate russian shiori_halloween_arrival_6013947a:
    "Но сейчас её обтягивает красный латекс в чёрный горошек!"

# ch/shiori/date.rpy:312
translate russian shiori_halloween_arrival_1e7fd1d0:
    shiori.say "Прости, [lssb_shiori.hero_name()]."

# ch/shiori/date.rpy:313
translate russian shiori_halloween_arrival_47a27b69:
    shiori.say "Наверное, я ужасно глупо выгляжу в этом костюме!"

# ch/shiori/date.rpy:314
translate russian shiori_halloween_arrival_a2e41e76:
    shiori.say "Просто я узнала его — это из мультика, который смотрит Канта."

# ch/shiori/date.rpy:315
translate russian shiori_halloween_arrival_c6bc35e5:
    shiori.say "Вот и схватила не подумав..."

# ch/shiori/date.rpy:316
translate russian shiori_halloween_arrival_ce7ef491:
    mike.say "Леди Баг, Сиори."

# ch/shiori/date.rpy:317
translate russian shiori_halloween_arrival_d50ff33a:
    mike.say "Эту героиню зовут Леди Баг."

# ch/shiori/date.rpy:319
translate russian shiori_halloween_arrival_b4e5c96a:
    "Сиори беспомощно улыбается мне."

# ch/shiori/date.rpy:320
translate russian shiori_halloween_arrival_3864ab85:
    shiori.say "Ну, тогда понятно, откуда такая расцветка!"

# ch/shiori/date.rpy:321
translate russian shiori_halloween_arrival_51288805:
    shiori.say "Ты, наверное, думаешь, что я выгляжу нелепо..."

# ch/shiori/date.rpy:324
translate russian shiori_halloween_arrival_8ffabd14:
    mike.say "Ты что, Сиори?"

# ch/shiori/date.rpy:325
translate russian shiori_halloween_arrival_f7cf9579:
    mike.say "Ты невероятно сексуальна в этом костюме!"

# ch/shiori/date.rpy:326
translate russian shiori_halloween_arrival_4a099dce:
    mike.say "Я бы даже хотел, чтобы ты надевала его почаще."

# ch/shiori/date.rpy:329
translate russian shiori_halloween_arrival_538247ac:
    "Стоит мне начать делать ей комплименты, как Сиори совершенно преображается."

# ch/shiori/date.rpy:330
translate russian shiori_halloween_arrival_0156acc4:
