# ch/shiori/date.rpy:348
translate russian shiori_halloween_arrival_9db98611:
    "Сиори кивает, нервно сжимая руки."

# ch/shiori/date.rpy:349
translate russian shiori_halloween_arrival_6d8fbc81:
    shiori.say "Я так и знала."

# ch/shiori/date.rpy:350
translate russian shiori_halloween_arrival_29df162a:
    shiori.say "Так и знала!"

# ch/shiori/date.rpy:351
