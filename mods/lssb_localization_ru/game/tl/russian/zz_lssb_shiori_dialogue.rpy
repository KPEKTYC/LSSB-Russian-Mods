translate russian shiori_gift_butt_plug_male_7e4a839f:
    "Сиори погружает руку в тонкую бумагу внутри и достаёт то, что там находит."

# ch/shiori/gift.rpy:284
translate russian shiori_gift_butt_plug_male_499c0343:
    shiori.say "Боже мой!"

# ch/shiori/gift.rpy:285
translate russian shiori_gift_butt_plug_male_9a6ff8c6:
    "Её глаза становятся круглыми как блюдца, когда она смотрит на огромную чёрную анальную пробку в своей руке."

# ch/shiori/gift.rpy:286
translate russian shiori_gift_butt_plug_male_621ecc76:
    "Сиори смотрит на секс-игрушку."

# ch/shiori/gift.rpy:287
translate russian shiori_gift_butt_plug_male_a7087e37:
    "Потом на меня."

# ch/shiori/gift.rpy:288
translate russian shiori_gift_butt_plug_male_f1ebe37a:
    "Потом снова на игрушку."

# ch/shiori/gift.rpy:289
translate russian shiori_gift_butt_plug_male_a6ef0678:
    shiori.say "Ох, [lssb_shiori.hero_name()], я просто не знаю, что сказать!"

# ch/shiori/gift.rpy:290
translate russian shiori_gift_butt_plug_male_ab5ae09f:
    mike.say "Ничего говорить не нужно, Сиори."

# ch/shiori/gift.rpy:291
translate russian shiori_gift_butt_plug_male_f039fe82:
    mike.say "Просто позволяй мне смотреть, когда будешь пользоваться ею рядом со мной..."

# ch/shiori/gift.rpy:294
translate russian shiori_gift_butt_plug_male_4744f2f9:
    "Сиори изо всех сил тычет мне в живот пробкой вместе с коробкой."

# ch/shiori/gift.rpy:295
translate russian shiori_gift_butt_plug_male_fa649dad:
    "У меня перехватывает дыхание, и я ахаю и стону, пока она укоризненно машет пальцем перед моим лицом."

# ch/shiori/gift.rpy:296
translate russian shiori_gift_butt_plug_male_11ab09ee:
    shiori.say "Думаешь, я вообще стану ПОЛЬЗОВАТЬСЯ этой мерзостью?"

# ch/shiori/gift.rpy:297
translate russian shiori_gift_butt_plug_male_7c34b70c:
    shiori.say "Не говоря уже о том, чтобы дать тебе смотреть?!"

# ch/shiori/gift.rpy:298
translate russian shiori_gift_butt_plug_male_1bf5e97a:
    shiori.say "За кого ты меня принимаешь?"

# ch/shiori/gift.rpy:299
translate russian shiori_gift_butt_plug_male_283169a6:
    shiori.say "Мерзкий извращенец!"

# ch/shiori/gift.rpy:302
translate russian shiori_gift_butt_plug_male_eaeff6b2:
    "Не в силах вымолвить ни слова, я вынужден терпеть гневную тираду Сиори."

# ch/shiori/gift.rpy:303
translate russian shiori_gift_butt_plug_male_902b9919:
    "Я всё ещё не могу разогнуться, когда она скрещивает руки и поворачивается ко мне спиной."

# ch/shiori/gift.rpy:304
translate russian shiori_gift_butt_plug_male_c9701143:
    shiori.say "А теперь до свидания. И попрошу за мной не идти!"

# ch/shiori/gift.rpy:305
translate russian shiori_gift_butt_plug_male_d619fc7d:
    "С этими словами она уходит, оставив меня одного хрипеть и кашлять."

# ch/shiori/gift.rpy:310
translate russian shiori_gift_butt_plug_male_de68f2ba:
    "Сиори ещё какое-то время выглядит ошарашенной."

# ch/shiori/gift.rpy:311
translate russian shiori_gift_butt_plug_male_829371ef:
    "Но затем выражение её лица начинает меняться."

# ch/shiori/gift.rpy:312
translate russian shiori_gift_butt_plug_male_9719688d:
    "Она поднимает на меня большие невинные глаза."

# ch/shiori/gift.rpy:314
translate russian shiori_gift_butt_plug_male_e905fb42:
    shiori.say "Ты... ты хочешь смотреть на меня?"

# ch/shiori/gift.rpy:315
translate russian shiori_gift_butt_plug_male_8ce61eb8:
    "Я киваю."

# ch/shiori/gift.rpy:316
translate russian shiori_gift_butt_plug_male_72fec520:
    shiori.say "Смотреть, как я этим пользуюсь?"

# ch/shiori/gift.rpy:317
translate russian shiori_gift_butt_plug_male_c9ec908a:
    "Я снова киваю."

# ch/shiori/gift.rpy:318
translate russian shiori_gift_butt_plug_male_18f80ced:
    shiori.say "Как я... использую это на себе?"

# ch/shiori/gift.rpy:319
translate russian shiori_gift_butt_plug_male_73685cad:
    "Я киваю в третий раз."

# ch/shiori/gift.rpy:320
translate russian shiori_gift_butt_plug_male_1ee7ae5f:
    "Сиори отводит взгляд, словно её вдруг охватила застенчивость."

# ch/shiori/gift.rpy:321
translate russian shiori_gift_butt_plug_male_95629132:
    "Но я замечаю, что при этом она тоже кивает."

# ch/shiori/reactions.rpy:2
translate russian shiori_ice_cream_reaction_male_f5d4781b:
    mike.say "Мне жарко и неспокойно, Сиори. Давай возьмём мороженое!"

# ch/shiori/reactions.rpy:3
translate russian shiori_ice_cream_reaction_male_482cb9de:
    shiori.say "О, я обожаю мороженое! Пойдём!"

# ch/shiori/reactions.rpy:4
translate russian shiori_ice_cream_reaction_male_73a4ddd7:
    "У киоска с мороженым я покупаю рожок с парой разных шариков."

# ch/shiori/reactions.rpy:5
translate russian shiori_ice_cream_reaction_male_7a5b06e9:
    "Сиори выбирает то же самое, но с другим сочетанием вкусов."

# ch/shiori/reactions.rpy:6
translate russian shiori_ice_cream_reaction_male_d07765cb:
    shiori.say "М-м-м... Какая прекрасная идея, [lssb_shiori.hero_name()]!"

# ch/shiori/reactions.rpy:7
translate russian shiori_ice_cream_reaction_male_5d2b5ffb:
    shiori.say "Ох... ой, ой, ой... боже мой... о нет!"

# ch/shiori/reactions.rpy:8
translate russian shiori_ice_cream_reaction_male_908e3514:
    "Я смотрю вниз, пытаясь понять, что расстроило Сиори."

# ch/shiori/reactions.rpy:9
translate russian shiori_ice_cream_reaction_male_cde4aaef:
    "И тут вижу, как мороженое капает ей на грудь!"

# ch/shiori/reactions.rpy:10
translate russian shiori_ice_cream_reaction_male_3584413c:
    shiori.say "Ох, какая я неуклюжая! Что ты только обо мне подумаешь?!"

# ch/shiori/reactions.rpy:11
translate russian shiori_ice_cream_reaction_male_743385dc:
    "Сейчас я и правда думаю о Сиори, но совсем не то, чего она опасается!"

# ch/shiori/reactions.rpy:17
translate russian shiori_call_in_e4e9705f:
    "С тех пор как я впервые увидел торчащую из Сиори анальную пробку, никак не могу выбросить её из головы."

# ch/shiori/reactions.rpy:18
translate russian shiori_call_in_bd216eea:
    "Каждый раз при виде Сиори я думаю лишь о том, осталась ли пробка внутри и как это сейчас выглядит."

# ch/shiori/reactions.rpy:19
translate russian shiori_call_in_e73cad3c:
    "Вскоре всё становится настолько плохо, что я уже не могу переключиться ни на что другое."

# ch/shiori/reactions.rpy:20
translate russian shiori_call_in_305ed598:
    "Я то и дело смотрю на дверь кабинета, гадая, когда снова появится Сиори."

# ch/shiori/reactions.rpy:21
translate russian shiori_call_in_9ba234a5:
    "В конце концов это совершенно лишает меня покоя, и мне просто необходимо что-то предпринять."

# ch/shiori/reactions.rpy:22
translate russian shiori_call_in_d4793af4:
    "Не позволяя себе думать о возможных последствиях, я поднимаю трубку настольного телефона."

# ch/shiori/reactions.rpy:24
translate russian shiori_call_in_8fa126d8:
    "Знаете, бывает, засядет в голове мысль, которую просто невозможно игнорировать?"

# ch/shiori/reactions.rpy:25
translate russian shiori_call_in_e95ee806:
    "Конечно, стараешься отмахнуться и заниматься делами, как нормальный человек."

# ch/shiori/reactions.rpy:26
translate russian shiori_call_in_e6475933:
    "Но она всё ещё там, точит тебя где-то на задворках сознания."

# ch/shiori/reactions.rpy:27
translate russian shiori_call_in_d6c6d7ad:
    "И гораздо хуже, когда сидишь в офисе, а думать можешь только о сексе."

# ch/shiori/reactions.rpy:28
translate russian shiori_call_in_743e607e:
    "Каждый раз, когда я замечаю Сиори, становится только хуже."

# ch/shiori/reactions.rpy:29
translate russian shiori_call_in_26580dcb:
    "Какое она имеет право быть такой горячей и сексуальной на работе?"

# ch/shiori/reactions.rpy:30
translate russian shiori_call_in_b0763208:
    "Словно нарочно пытается свести меня с ума!"

# ch/shiori/reactions.rpy:31
translate russian shiori_call_in_710e0dd7:
    "В конце концов я больше не выдерживаю и поднимаю трубку настольного телефона."

# ch/shiori/reactions.rpy:33
translate russian shiori_call_in_0522d64b:
    shiori.say "А, здравствуйте..."

# ch/shiori/reactions.rpy:34
translate russian shiori_call_in_6e3f363b:
    shiori.say "Сиори слушает?"

# ch/shiori/reactions.rpy:35
translate russian shiori_call_in_92cb68e2:
    "Даже её голос меня возбуждает."

# ch/shiori/reactions.rpy:36
translate russian shiori_call_in_72b7f1dc:
    "Такой скромный и невинный."

# ch/shiori/reactions.rpy:37
translate russian shiori_call_in_2efa3c88:
    "Так и хочется сделать с ней что-нибудь порочное!"

# ch/shiori/reactions.rpy:38
translate russian shiori_call_in_30e74fc5:
    mike.say "Эм..."

# ch/shiori/reactions.rpy:39
translate russian shiori_call_in_9bd81ea4:
    mike.say "Привет, Сиори..."

# ch/shiori/reactions.rpy:40
translate russian shiori_call_in_d5c31a51:
    mike.say "Можешь на минутку зайти ко мне в кабинет?"

# ch/shiori/reactions.rpy:41
translate russian shiori_call_in_3dd3487a:
    "Услышав мой голос, Сиори тут же оживляется."

# ch/shiori/reactions.rpy:42
translate russian shiori_call_in_1b71c587:
    "Словно радуется возможности угодить мне."

# ch/shiori/reactions.rpy:43
translate russian shiori_call_in_34c33e05:
    shiori.say "Конечно, [lssb_shiori.hero_name()]."

# ch/shiori/reactions.rpy:44
translate russian shiori_call_in_0e3c6c6e:
    shiori.say "Уже иду!"

# ch/shiori/reactions.rpy:46
translate russian shiori_call_in_4f7af2e6:
    "Не проходит и минуты, как Сиори стучит в дверь моего кабинета."

# ch/shiori/reactions.rpy:47
translate russian shiori_call_in_7f57c2ef:
    "Но даже за это время я успеваю изойтись от нетерпения."

# ch/shiori/reactions.rpy:48
translate russian shiori_call_in_83e8654f:
    mike.say "Входи, Сиори."

# ch/shiori/reactions.rpy:50
translate russian shiori_call_in_9a70f700:
    "Послушная, как всегда, Сиори открывает дверь и торопливо входит."

# ch/shiori/reactions.rpy:51
translate russian shiori_call_in_8311b5ee:
    "Она аккуратно закрывает дверь за собой и спешит к моему столу."

# ch/shiori/reactions.rpy:52
translate russian shiori_call_in_bf7e1a27:
    "Я вижу, что она держит блокнот с ручкой и явно горит желанием помочь."

# ch/shiori/reactions.rpy:53
translate russian shiori_call_in_5b07f015:
    shiori.say "Вот и я, [lssb_shiori.hero_name()]."

# ch/shiori/reactions.rpy:55
translate russian shiori_call_in_7ec85b6b:
    shiori.say "Здравствуйте, Сиори слушает."

# ch/shiori/reactions.rpy:56
translate russian shiori_call_in_bb27bec1:
    shiori.say "Чем могу помочь?"

# ch/shiori/reactions.rpy:57
translate russian shiori_call_in_2d8a4283:
    "Даже звука её милого, невинного голоса достаточно, чтобы возбудить меня сильнее."

# ch/shiori/reactions.rpy:58
translate russian shiori_call_in_634cbfe8:
    mike.say "А, Сиори..."

# ch/shiori/reactions.rpy:59
translate russian shiori_call_in_9494dd25:
    shiori.say "О, привет, [lssb_shiori.hero_name()]!"

# ch/shiori/reactions.rpy:60
translate russian shiori_call_in_7f021133:
    shiori.say "Что я могу для тебя сделать?"

# ch/shiori/reactions.rpy:61
translate russian shiori_call_in_7b1c6134:
    "Мне приходится прикусить язык, чтобы не сказать что-нибудь, о чём тут же пожалею."

# ch/shiori/reactions.rpy:62
translate russian shiori_call_in_aab69089:
    mike.say "Эм... да..."

# ch/shiori/reactions.rpy:63
translate russian shiori_call_in_49da35d4:
    mike.say "Можешь зайти ко мне, когда будет минутка, Сиори?"

# ch/shiori/reactions.rpy:64
translate russian shiori_call_in_efb2cadb:
    shiori.say "Конечно, [lssb_shiori.hero_name()], сейчас буду!"

# ch/shiori/reactions.rpy:65
translate russian shiori_call_in_8f46a035:
    "Я кладу трубку и качаю головой: до чего же она доверчивая."

# ch/shiori/reactions.rpy:67
translate russian shiori_call_in_f73d9cca:
    "Одри или Лавиш потребовали бы объяснить, что именно мне нужно."

# ch/shiori/reactions.rpy:69
translate russian shiori_call_in_f5759e2a:
    "Одри потребовала бы объяснить, что именно мне нужно."

# ch/shiori/reactions.rpy:71
translate russian shiori_call_in_2817212e:
    "Лавиш потребовала бы объяснить, что именно мне нужно."

# ch/shiori/reactions.rpy:72
translate russian shiori_call_in_e1539156:
    "А Сиори рада просто прибежать ко мне, словно нетерпеливый щенок..."

# ch/shiori/reactions.rpy:73
translate russian shiori_call_in_6718a552:
    "И действительно, вскоре я слышу стук в дверь кабинета."

# ch/shiori/reactions.rpy:74
translate russian shiori_call_in_6daf917f:
    mike.say "Входи."

# ch/shiori/reactions.rpy:76
translate russian shiori_call_in_c2386a43:
    "Сиори торопливо входит, вся в улыбках, и даже мило машет мне рукой."

# ch/shiori/reactions.rpy:77
translate russian shiori_call_in_bb749905:
    shiori.say "Ну вот, [lssb_shiori.hero_name()], я здесь!"

# ch/shiori/reactions.rpy:81
translate russian shiori_ask_phone_male_e4780783:
    mike.say "Я хотел попросить твой номер, Сиори."

# ch/shiori/reactions.rpy:82
translate russian shiori_ask_phone_male_342bbbca:
    mike.say "Ну, чтобы как-нибудь тебе позвонить."

# ch/shiori/reactions.rpy:86
translate russian shiori_ask_phone_male_5a23e03d:
    shiori.say "Правда?!"

# ch/shiori/reactions.rpy:87
translate russian shiori_ask_phone_male_1b1d8a46:
    shiori.say "Конечно, я дам тебе свой номер, [lssb_shiori.hero_name()]!"

# ch/shiori/reactions.rpy:88
translate russian shiori_ask_phone_male_0780ef3d:
    shiori.say "И звони когда захочешь!"

# ch/shiori/reactions.rpy:93
translate russian shiori_ask_phone_male_324e2133:
    shiori.say "Ох... боже мой..."

# ch/shiori/reactions.rpy:94
translate russian shiori_ask_phone_male_3cbfe80a:
    shiori.say "Не думаю, [lssb_shiori.hero_name()]."

# ch/shiori/reactions.rpy:95
translate russian shiori_ask_phone_male_1631bd39:
    shiori.say "По-моему, это было бы неуместно!"

# ch/shiori/reactions.rpy:99
translate russian shiori_ask_birthday_male_9bd81ea4:
    mike.say "Привет, Сиори..."

# ch/shiori/reactions.rpy:100
translate russian shiori_ask_birthday_male_2206e31d:
    mike.say "Когда у тебя день рождения?"

# ch/shiori/reactions.rpy:104
translate russian shiori_ask_birthday_male_c102a48f:
    shiori.say "Ох..."

# ch/shiori/reactions.rpy:105
translate russian shiori_ask_birthday_male_fa376c89:
    shiori.say "23-го дня весны, [lssb_shiori.hero_name()]."

# ch/shiori/reactions.rpy:106
translate russian shiori_ask_birthday_male_f1e0f65f:
    shiori.say "Спасибо, что спросил!"

# ch/shiori/reactions.rpy:111
translate russian shiori_ask_birthday_male_1535ec00:
    shiori.say "Но... но..."

# ch/shiori/reactions.rpy:112
translate russian shiori_ask_birthday_male_3546f597:
    shiori.say "Я ведь уже говорила, сколько мне лет!"

# ch/shiori/reactions.rpy:113
translate russian shiori_ask_birthday_male_224181ec:
    shiori.say "Ты мне не веришь?!"

# ch/shiori/reactions.rpy:117
translate russian shiori_offer_a_drink_male_8246693b:
    mike.say "Хочешь выпить, Сиори?"

# ch/shiori/reactions.rpy:118
translate russian shiori_offer_a_drink_male_790ef801:
    mike.say "Я иду к бару, мне нетрудно взять что-нибудь и тебе."

# ch/shiori/reactions.rpy:119
translate russian shiori_offer_a_drink_male_f24294d0:
    "Едва я успеваю договорить, как Сиори поворачивается ко мне."

# ch/shiori/reactions.rpy:123
translate russian shiori_offer_a_drink_male_c0765072:
    shiori.say "Ох... как ты можешь, [lssb_shiori.hero_name()]?"

# ch/shiori/reactions.rpy:124
translate russian shiori_offer_a_drink_male_4438ebac:
    shiori.say "Ты же знаешь, что мне нельзя пить во время беременности!"

# ch/shiori/reactions.rpy:125
translate russian shiori_offer_a_drink_male_14f42a84:
    shiori.say "Я думала, ты заботишься обо мне и о малыше!"

# ch/shiori/reactions.rpy:130
translate russian shiori_offer_a_drink_male_37b071c4:
    shiori.say "Ох... хорошо, [lssb_shiori.hero_name()]."

# ch/shiori/reactions.rpy:131
translate russian shiori_offer_a_drink_male_d572554e:
    shiori.say "Может, бокал вина?"

