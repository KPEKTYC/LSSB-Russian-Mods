# Native Sporty identifiers, current source catalog. Translation only.

# ch/harems_full/sporty/events.rpy:72
translate russian ayesha_hanna_showdown_9e8ca89c:
    "Я горжусь тем, что умею замечать неприятности ещё на горизонте."

# ch/harems_full/sporty/events.rpy:73
translate russian ayesha_hanna_showdown_b8ae1931:
    "И тем, что хватает ума убраться с дороги, прежде чем они до меня доберутся!"

# ch/harems_full/sporty/events.rpy:74
translate russian ayesha_hanna_showdown_1cf6d771:
    "А заметить неприятности в облике Айши довольно легко."

# ch/harems_full/sporty/events.rpy:76
translate russian ayesha_hanna_showdown_a4de1722:
    "Она возвышается почти над всеми — и мужчинами, и женщинами."

# ch/harems_full/sporty/events.rpy:78
translate russian ayesha_hanna_showdown_3fd75497:
    "Поэтому, когда она появляется мрачнее тучи, я понимаю: пора исчезнуть."

# ch/harems_full/sporty/events.rpy:79
translate russian ayesha_hanna_showdown_9ceb7cf5:
    "Проблема лишь в том, что, повернувшись уходить, я обнаруживаю перекрытый путь."

# ch/harems_full/sporty/events.rpy:83
translate russian ayesha_hanna_showdown_22c90f80:
    "Передо мной стоит Ханна, уперев руки в бока и сердито глядя на меня."

# ch/harems_full/sporty/events.rpy:84
translate russian ayesha_hanna_showdown_560b8537:
    "И выражение её лица лишь чуть менее страшное, чем у Айши!"

# ch/harems_full/sporty/events.rpy:85
translate russian ayesha_hanna_showdown_dc60af17:
    "Я заглядываю то за левое плечо Ханны, то за правое, всё ещё пытаясь уйти."

# ch/harems_full/sporty/events.rpy:87
translate russian ayesha_hanna_showdown_e3a3e526:
    "Но она перекрывает мне путь, в какую сторону я ни подамся."

# ch/harems_full/sporty/events.rpy:88
translate russian ayesha_hanna_showdown_cd8a9608:
    hanna.say "Эй, [lssb_common.hero_name()]..."

# ch/harems_full/sporty/events.rpy:89
translate russian ayesha_hanna_showdown_0d429ba9:
    hanna.say "Куда так торопишься?"

# ch/harems_full/sporty/events.rpy:91
translate russian ayesha_hanna_showdown_f5ddb194:
    mike.say "Никуда, Ханна, никуда..."

# ch/harems_full/sporty/events.rpy:92
translate russian ayesha_hanna_showdown_e98f75e2:
    mike.say "Только мне туда нужно побыстрее!"

# ch/harems_full/sporty/events.rpy:94
translate russian ayesha_hanna_showdown_e0bf1e7a:
    hanna.say "Вот как?"

# ch/harems_full/sporty/events.rpy:95
translate russian ayesha_hanna_showdown_236441d9:
    hanna.say "Может, спросишь дорогу?"

# ch/harems_full/sporty/events.rpy:96
translate russian ayesha_hanna_showdown_8d6d389a:
    hanna.say "Знаю! Спросим у Айши, не знает ли она короткого пути!"

# ch/harems_full/sporty/events.rpy:98
translate russian ayesha_hanna_showdown_f7e79b3a:
    "Когда Ханна смотрит мне через плечо, у меня внутри всё холодеет от настоящего страха."

# ch/harems_full/sporty/events.rpy:99
translate russian ayesha_hanna_showdown_c165e937:
    "Затем на плечо опускается тяжёлая ладонь Айши."

# ch/harems_full/sporty/events.rpy:100
translate russian ayesha_hanna_showdown_d0dc23e7:
    "Прежде чем я успеваю что-то сказать, она разворачивает меня на месте."

# ch/harems_full/sporty/events.rpy:104
translate russian ayesha_hanna_showdown_91d8bbb1:
    ayesha.say "Вот ты где, червяк!"

# ch/harems_full/sporty/events.rpy:105
translate russian ayesha_hanna_showdown_81277221:
    ayesha.say "Тощий задрот!"

# ch/harems_full/sporty/events.rpy:106
translate russian ayesha_hanna_showdown_377cf26d:
    ayesha.say "Дерьмовый мальчик для битья!"

# ch/harems_full/sporty/events.rpy:107
translate russian ayesha_hanna_showdown_cd13fa4c:
    "Я отшатываюсь от тирады Айши, словно она идёт на меня со сжатыми кулаками."

# ch/harems_full/sporty/events.rpy:108
translate russian ayesha_hanna_showdown_d3419f88:
    "Я видел её на ринге и даже боролся с ней на мате."

# ch/harems_full/sporty/events.rpy:109
translate russian ayesha_hanna_showdown_1b03108a:
    "Но ещё никогда не видел её настолько злой по-настоящему!"

# ch/harems_full/sporty/events.rpy:110
translate russian ayesha_hanna_showdown_b2e726fd:
    "В отчаянии поворачиваюсь то в одну, то в другую сторону."

# ch/harems_full/sporty/events.rpy:111
translate russian ayesha_hanna_showdown_ef6aae7a:
    "Но с каждой стороны — сердитая девушка!"

# ch/harems_full/sporty/events.rpy:112
translate russian ayesha_hanna_showdown_2d04e00e:
    mike.say "Ханна..."

# ch/harems_full/sporty/events.rpy:113
translate russian ayesha_hanna_showdown_74e8d35d:
    mike.say "Айша..."

# ch/harems_full/sporty/events.rpy:114
translate russian ayesha_hanna_showdown_7757dee2:
    mike.say "Я могу объяснить!"

# ch/harems_full/sporty/events.rpy:116
translate russian ayesha_hanna_showdown_77f84392:
    "Ханна смеётся над моей мольбой и качает головой."

# ch/harems_full/sporty/events.rpy:117
translate russian ayesha_hanna_showdown_9ce61fa7:
    "Айша лишь издаёт низкое угрожающее рычание."

# ch/harems_full/sporty/events.rpy:119
translate russian ayesha_hanna_showdown_c576d267:
    hanna.say "Правда, [lssb_common.hero_name()]?"

# ch/harems_full/sporty/events.rpy:121
translate russian ayesha_hanna_showdown_a5e39e3d:
    hanna.say "Объяснишь, как мы с Айшей только что разговорились?"

# ch/harems_full/sporty/events.rpy:122
translate russian ayesha_hanna_showdown_304db77a:
    ayesha.say "И как выяснилось, что мы обе встречаемся с отличным парнем?"

# ch/harems_full/sporty/events.rpy:123
translate russian ayesha_hanna_showdown_c91ca5a3:
    hanna.say "И решили сравнить впечатления о нём?"

# ch/harems_full/sporty/events.rpy:124
translate russian ayesha_hanna_showdown_0a82a013:
    ayesha.say "А потом начали замечать, что эти два парня очень похожи?"

# ch/harems_full/sporty/events.rpy:125
translate russian ayesha_hanna_showdown_ff3d4c6e:
    hanna.say "Что оба занимаются в нашем зале?"

# ch/harems_full/sporty/events.rpy:126
translate russian ayesha_hanna_showdown_ac7c8aae:
    ayesha.say "И зовут их одинаково?"

# ch/harems_full/sporty/events.rpy:128
translate russian ayesha_hanna_showdown_49695f7e:
    "Айша и Ханна одновременно указывают на свои округлившиеся животы."

# ch/harems_full/sporty/events.rpy:129
translate russian ayesha_hanna_showdown_236dab25:
    ayesha.say "Отец моего ребёнка — неверная крыса!"

# ch/harems_full/sporty/events.rpy:130
translate russian ayesha_hanna_showdown_4bf38bbf:
    hanna.say "Ты меня обрюхатил, пока шлялся по другим!"

# ch/harems_full/sporty/events.rpy:132
translate russian ayesha_hanna_showdown_f9b5951a:
    "Айша указывает на свой уже округлившийся живот."

# ch/harems_full/sporty/events.rpy:133
translate russian ayesha_hanna_showdown_236dab25_1:
    ayesha.say "Отец моего ребёнка — неверная крыса!"

# ch/harems_full/sporty/events.rpy:135
translate russian ayesha_hanna_showdown_45356554:
    "Ханна указывает на свой заметно округлившийся живот."

# ch/harems_full/sporty/events.rpy:136
translate russian ayesha_hanna_showdown_4bf38bbf_1:
    hanna.say "Ты меня обрюхатил, пока шлялся по другим!"

# ch/harems_full/sporty/events.rpy:138
translate russian ayesha_hanna_showdown_1b08cae4:
    ayesha.say "Хорошо хоть я заставляла тебя предохраняться!"

# ch/harems_full/sporty/events.rpy:139
translate russian ayesha_hanna_showdown_ed282bcb:
    hanna.say "Ага, я тоже!"

# ch/harems_full/sporty/events.rpy:140
translate russian ayesha_hanna_showdown_b9bd8806:
    "Вот чем опасно крутить сразу с двумя девушками."

# ch/harems_full/sporty/events.rpy:141
translate russian ayesha_hanna_showdown_be7cdd87:
    "Было весело, пока всё сходило с рук."

# ch/harems_full/sporty/events.rpy:142
translate russian ayesha_hanna_showdown_ff486c7e:
    "Но теперь меня поймали, и пора расплачиваться."

# ch/harems_full/sporty/events.rpy:144
translate russian ayesha_hanna_showdown_cb4aac98:
    mike.say "Поймали с поличным."

# ch/harems_full/sporty/events.rpy:145
translate russian ayesha_hanna_showdown_ebce91d2:
    mike.say "Мне должно было хватить одной потрясающей девушки."

# ch/harems_full/sporty/events.rpy:146
translate russian ayesha_hanna_showdown_6a390096:
    mike.say "Наверное, от возможности быть с двумя просто снесло крышу!"

# ch/harems_full/sporty/events.rpy:147
translate russian ayesha_hanna_showdown_b9967f63:
    "Да, знаю: я пытаюсь одновременно быть скромным и очаровать их."

# ch/harems_full/sporty/events.rpy:148
translate russian ayesha_hanna_showdown_5d7f4047:
    "Но не вижу способа выйти из этой ситуации и сохранить лицо."

# ch/harems_full/sporty/events.rpy:149
translate russian ayesha_hanna_showdown_c1bd6886:
    "Так что остаётся полностью отдаться на их милость."

# ch/harems_full/sporty/events.rpy:151
translate russian ayesha_hanna_showdown_8f26c560:
    "И я уже вижу, что комплимент немного смягчает Ханну."

# ch/harems_full/sporty/events.rpy:152
translate russian ayesha_hanna_showdown_ea123e78:
    "Она вполне может поверить, что парень потерял голову от её красоты!"

# ch/harems_full/sporty/events.rpy:153
translate russian ayesha_hanna_showdown_1f5dcbb3:
    "Но стоило догадаться, что Айшу убедить будет труднее."

# ch/harems_full/sporty/events.rpy:154
translate russian ayesha_hanna_showdown_2c412447:
    "Большую часть жизни она комплексовала из-за своих габаритов."

# ch/harems_full/sporty/events.rpy:155
translate russian ayesha_hanna_showdown_9ed0d43b:
    "Поэтому особенно хорошо чует враньё!"

# ch/harems_full/sporty/events.rpy:156
translate russian ayesha_hanna_showdown_5331d068:
    hanna.say "Ну..."

# ch/harems_full/sporty/events.rpy:158
translate russian ayesha_hanna_showdown_1adc00c2:
    hanna.say "В чём-то ты и ПРАВДА прав!"

# ch/harems_full/sporty/events.rpy:159
translate russian ayesha_hanna_showdown_222a2181:
    ayesha.say "Что ты говоришь, Ханна?"

# ch/harems_full/sporty/events.rpy:161
translate russian ayesha_hanna_showdown_8a9656ce:
    ayesha.say "Этот парень нам изменял!"

# ch/harems_full/sporty/events.rpy:162
translate russian ayesha_hanna_showdown_a2e68d2e:
    ayesha.say "Трахал каждую за спиной у другой!"

# ch/harems_full/sporty/events.rpy:163
translate russian ayesha_hanna_showdown_c2e16450:
    "Я чувствую возможность воспользоваться разногласием между ними."

# ch/harems_full/sporty/events.rpy:164
translate russian ayesha_hanna_showdown_fc39af80:
    "И хватаюсь за неё обеими руками, словно от этого зависит моя жизнь!"

# ch/harems_full/sporty/events.rpy:165
translate russian ayesha_hanna_showdown_8a92a465:
    mike.say "Знаю, Айша, и не жду, что ты меня простишь."

# ch/harems_full/sporty/events.rpy:166
translate russian ayesha_hanna_showdown_bea3f9f8:
    mike.say "Но я правда сожалею, поверь!"

# ch/harems_full/sporty/events.rpy:167
translate russian ayesha_hanna_showdown_3a7c039a:
    mike.say "Просто в спортзале есть что-то такое, понимаете?"

# ch/harems_full/sporty/events.rpy:168
translate russian ayesha_hanna_showdown_5f387593:
    mike.say "Мы все вместе, в одном месте."

# ch/harems_full/sporty/events.rpy:169
translate russian ayesha_hanna_showdown_dcebb975:
    mike.say "В тесной обтягивающей одежде."

# ch/harems_full/sporty/events.rpy:170
translate russian ayesha_hanna_showdown_94aa1118:
    mike.say "Вместе тренируемся, вместе потеем..."

# ch/harems_full/sporty/events.rpy:171
translate russian ayesha_hanna_showdown_f51ad68b:
    mike.say "Будто я всё время вдыхаю ваши феромоны!"

# ch/harems_full/sporty/events.rpy:173
translate russian ayesha_hanna_showdown_cbafd81e:
    "Обе девушки молча слушают."

# ch/harems_full/sporty/events.rpy:174
translate russian ayesha_hanna_showdown_ff17d6b0:
    "Кажется, каждая обдумывает мои слова."

# ch/harems_full/sporty/events.rpy:175
translate russian ayesha_hanna_showdown_9945294b:
    "Затем они обмениваются многозначительным взглядом."

# ch/harems_full/sporty/events.rpy:176
translate russian ayesha_hanna_showdown_5b6ca6e2:
    "И я почти чувствую, как они приходят к окончательному решению."

# ch/harems_full/sporty/events.rpy:178
translate russian ayesha_hanna_showdown_c89ddee6:
    "Айша и Ханна смотрят друг на друга и качают головами."

# ch/harems_full/sporty/events.rpy:179
translate russian ayesha_hanna_showdown_f9dcf1a7:
    "Затем пожимают плечами и смеются."

# ch/harems_full/sporty/events.rpy:180
translate russian ayesha_hanna_showdown_9b9c319d:
    hanna.say "Тебе повезло, что мы такие замечательные, [lssb_common.hero_name()]."

# ch/harems_full/sporty/events.rpy:181
translate russian ayesha_hanna_showdown_adb87fff:
    hanna.say "Большинство женщин на нашем месте не проявили бы столько понимания!"

# ch/harems_full/sporty/events.rpy:182
translate russian ayesha_hanna_showdown_12cec2c4:
    ayesha.say "Но заруби себе на носу одно, ясно?"

# ch/harems_full/sporty/events.rpy:183
translate russian ayesha_hanna_showdown_8db9a2a8:
    ayesha.say "В этих отношениях будем только мы трое!"

# ch/harems_full/sporty/events.rpy:184
translate russian ayesha_hanna_showdown_d1d06ada:
    "Я перевожу взгляд с Айши на Ханну и обратно."

# ch/harems_full/sporty/events.rpy:186
translate russian ayesha_hanna_showdown_8a38776a:
    mike.say "То есть..."

# ch/harems_full/sporty/events.rpy:187
translate russian ayesha_hanna_showdown_88e98e33:
    mike.say "А что именно вы имеете в виду?!"

# ch/harems_full/sporty/events.rpy:188
translate russian ayesha_hanna_showdown_75376850:
    "Айша и Ханна одновременно наклоняются и целуют меня с двух сторон в щёки."

# ch/harems_full/sporty/events.rpy:189
translate russian ayesha_hanna_showdown_be4b5629:
    hanna.say "Имеем в виду, что ты прощён, [lssb_common.hero_name()]."

# ch/harems_full/sporty/events.rpy:191
translate russian ayesha_hanna_showdown_d23f4992:
    ayesha.say "И можешь остаться с нами обеими."

# ch/harems_full/sporty/events.rpy:193
translate russian ayesha_hanna_showdown_1e737afa:
    ayesha.say "Но больше ничего за нашей спиной!"

# ch/harems_full/sporty/events.rpy:194
translate russian ayesha_hanna_showdown_d5a39398:
    hanna.say "Да, [lssb_common.hero_name()]!"

# ch/harems_full/sporty/events.rpy:195
translate russian ayesha_hanna_showdown_e044dcd2:
    hanna.say "Теперь мы все в этих отношениях вместе, понятно?"

# ch/harems_full/sporty/events.rpy:196
translate russian ayesha_hanna_showdown_6fdb3aaa:
    "Я лишь удивлённо моргаю."

# ch/harems_full/sporty/events.rpy:197
translate russian ayesha_hanna_showdown_f409a686:
    "Мозгу словно нужна вечность, чтобы всё осознать."

# ch/harems_full/sporty/events.rpy:198
translate russian ayesha_hanna_showdown_8a38776a_1:
    mike.say "То есть..."

# ch/harems_full/sporty/events.rpy:199
translate russian ayesha_hanna_showdown_1550ca5d:
    mike.say "Мы теперь вроде..."

# ch/harems_full/sporty/events.rpy:200
translate russian ayesha_hanna_showdown_b6dab310:
    mike.say "Теперь у нас отношения втроём?"

# ch/harems_full/sporty/events.rpy:201
translate russian ayesha_hanna_showdown_2bcefec4:
    hanna.say "Именно, [lssb_common.hero_name()]!"

# ch/harems_full/sporty/events.rpy:202
translate russian ayesha_hanna_showdown_d44e4019:
    ayesha.say "Ой, ну милый!"

# ch/harems_full/sporty/events.rpy:203
translate russian ayesha_hanna_showdown_e1b2b8dc:
    ayesha.say "Наконец-то дошло!"

# ch/harems_full/sporty/events.rpy:204
translate russian ayesha_hanna_showdown_956b0708:
    "Теперь, когда я знаю, что всё всерьёз, я по-прежнему не нахожу слов."

# ch/harems_full/sporty/events.rpy:205
translate russian ayesha_hanna_showdown_36c863ba:
    "Но уже скорее потому, что думаю о возможностях."

# ch/harems_full/sporty/events.rpy:206
translate russian ayesha_hanna_showdown_d9e31389:
    "А их определённо немало!"

# ch/harems_full/sporty/events.rpy:210
translate russian ayesha_hanna_showdown_c44b7040:
    ayesha.say "Я..."

# ch/harems_full/sporty/events.rpy:211
translate russian ayesha_hanna_showdown_dc0b3c7d:
    ayesha.say "Наверное, могу это понять, [lssb_common.hero_name()]."

# ch/harems_full/sporty/events.rpy:212
translate russian ayesha_hanna_showdown_5ec3db77:
    ayesha.say "То есть... в спортзале и правда бывает довольно возбуждающая атмосфера."

# ch/harems_full/sporty/events.rpy:213
translate russian ayesha_hanna_showdown_4e4bc9bb:
    ayesha.say "И всем нам иногда нравится поглядеть на подтянутое тело!"

# ch/harems_full/sporty/events.rpy:214
translate russian ayesha_hanna_showdown_e41231c6:
    "Я киваю и улыбаюсь, стараясь поддержать этот ход мыслей Айши."

# ch/harems_full/sporty/events.rpy:215
translate russian ayesha_hanna_showdown_f3f308dc:
    "Но одновременно вижу: Ханна с ней соглашаться не собирается."

# ch/harems_full/sporty/events.rpy:217
translate russian ayesha_hanna_showdown_0954c0c7:
    hanna.say "Нет, меня это не устраивает."

# ch/harems_full/sporty/events.rpy:218
translate russian ayesha_hanna_showdown_adf30a21:
    hanna.say "Я фактически управляю залом и должна вести себя профессионально."

# ch/harems_full/sporty/events.rpy:219
translate russian ayesha_hanna_showdown_6f71c3b9:
    hanna.say "Не могу же весь день с вожделением пялиться на чужие задницы!"

# ch/harems_full/sporty/events.rpy:220
translate russian ayesha_hanna_showdown_76fe787d:
    mike.say "Что ты хочешь сказать, Ханна?"

# ch/harems_full/sporty/events.rpy:221
translate russian ayesha_hanna_showdown_fcc554af:
    mike.say "Что хочешь расстаться?"

# ch/harems_full/sporty/events.rpy:223
translate russian ayesha_hanna_showdown_caff1a7b:
    "Ханна вздыхает и качает головой."

# ch/harems_full/sporty/events.rpy:224
translate russian ayesha_hanna_showdown_c1b0129e:
    hanna.say "Да, но дело не только в этом."

# ch/harems_full/sporty/events.rpy:225
translate russian ayesha_hanna_showdown_c332771f:
    hanna.say "Я уже какое-то время чувствую, что мне нужны перемены."

# ch/harems_full/sporty/events.rpy:226
translate russian ayesha_hanna_showdown_0fecbad9:
    hanna.say "Что пора заняться своим делом."

# ch/harems_full/sporty/events.rpy:227
translate russian ayesha_hanna_showdown_ed8829f6:
    hanna.say "Может, начать заново в другом городе."

# ch/harems_full/sporty/events.rpy:228
translate russian ayesha_hanna_showdown_7de6f37b:
    hanna.say "Даже открыть собственный зал."

# ch/harems_full/sporty/events.rpy:229
translate russian ayesha_hanna_showdown_64b659d8:
    hanna.say "Потому что вы двое, думаю, будете счастливы и без меня!"

# ch/harems_full/sporty/events.rpy:230
translate russian ayesha_hanna_showdown_725b86d1:
    "Я смотрю на Айшу, и она кивает."

# ch/harems_full/sporty/events.rpy:231
translate russian ayesha_hanna_showdown_9171e2e9:
    "И одновременно сжимает мою руку."

# ch/harems_full/sporty/events.rpy:232
translate russian ayesha_hanna_showdown_3654acfe:
    mike.say "Знаешь, Ханна..."

# ch/harems_full/sporty/events.rpy:234
translate russian ayesha_hanna_showdown_44f9728d:
    mike.say "Думаю, ты права!"

# ch/harems_full/sporty/events.rpy:237
translate russian ayesha_hanna_showdown_7726c0a4:
    hanna.say "Да, ну..."

# ch/harems_full/sporty/events.rpy:238
translate russian ayesha_hanna_showdown_1387c1db:
    hanna.say "Ты всего лишь человек, [lssb_common.hero_name()]!"

# ch/harems_full/sporty/events.rpy:239
translate russian ayesha_hanna_showdown_fc7456dc:
    hanna.say "Наверное, большинство парней, которых я тренирую, в меня влюблены!"

# ch/harems_full/sporty/events.rpy:240
translate russian ayesha_hanna_showdown_b76bb799:
    hanna.say "Не могу же я злиться на тебя за то, что ты человек!"

# ch/harems_full/sporty/events.rpy:241
translate russian ayesha_hanna_showdown_506e84fd:
    "Айша презрительно фыркает и качает головой."

# ch/harems_full/sporty/events.rpy:242
translate russian ayesha_hanna_showdown_668ca3dd:
    "Совершенно ясно: чувств Ханны она не разделяет."

# ch/harems_full/sporty/events.rpy:243
translate russian ayesha_hanna_showdown_3bd0916e:
    ayesha.say "Не верю своим ушам!"

# ch/harems_full/sporty/events.rpy:245
translate russian ayesha_hanna_showdown_f959677d:
    ayesha.say "Он изменял нам обеим, а ты говоришь о прощении?"

# ch/harems_full/sporty/events.rpy:246
translate russian ayesha_hanna_showdown_e331a8cd:
    ayesha.say "Мне плевать, с какими извращениями ты готова мириться, Ханна!"

# ch/harems_full/sporty/events.rpy:247
translate russian ayesha_hanna_showdown_2cee85f6:
    ayesha.say "Я этого жалкого ублюдка бросаю!"

# ch/harems_full/sporty/events.rpy:248
translate russian ayesha_hanna_showdown_94a284d9:
    "Ханну тут же задевает обвинение."

# ch/harems_full/sporty/events.rpy:249
translate russian ayesha_hanna_showdown_c591ed22:
    "Она строго смотрит на Айшу."

# ch/harems_full/sporty/events.rpy:250
translate russian ayesha_hanna_showdown_d6af8f37:
    hanna.say "Эй!"

# ch/harems_full/sporty/events.rpy:252
translate russian ayesha_hanna_showdown_36b2fae1:
    hanna.say "Кого ты называешь извращенкой?!"

# ch/harems_full/sporty/events.rpy:253
translate russian ayesha_hanna_showdown_03b6f098:
    hanna.say "Я вообще-то всё ещё твоя начальница!"

# ch/harems_full/sporty/events.rpy:254
translate russian ayesha_hanna_showdown_5e59c1dd:
    ayesha.say "Ага, ну..."

# ch/harems_full/sporty/events.rpy:255
translate russian ayesha_hanna_showdown_deb15bcc:
    ayesha.say "Это я быстро исправлю, Ханна."

# ch/harems_full/sporty/events.rpy:256
translate russian ayesha_hanna_showdown_36ae8fd7:
    ayesha.say "Потому что увольняюсь!"

# ch/harems_full/sporty/events.rpy:257
translate russian ayesha_hanna_showdown_143d3f80:
    ayesha.say "Можешь оставить себе этого парня, а работу засунуть куда подальше!"

# ch/harems_full/sporty/events.rpy:258
translate russian ayesha_hanna_showdown_041ba680:
    "Айша сердито уходит, а Ханна берёт меня за руку."

# ch/harems_full/sporty/events.rpy:260
translate russian ayesha_hanna_showdown_4b7251e3:
    "Сжимает её и прислоняется к моему плечу."

# ch/harems_full/sporty/events.rpy:261
translate russian ayesha_hanna_showdown_ee8f85f5:
    hanna.say "Не переживай из-за неё, [lssb_common.hero_name()]."

# ch/harems_full/sporty/events.rpy:263
translate russian ayesha_hanna_showdown_7e2f8489:
    hanna.say "Она всегда была слишком зажатой."

# ch/harems_full/sporty/events.rpy:264
translate russian ayesha_hanna_showdown_b27cd1ab:
    hanna.say "А меня тебе хватит с лихвой, обещаю!"

# ch/harems_full/sporty/events.rpy:270
translate russian ayesha_hanna_showdown_cce60220:
    "Айша и Ханна почти одновременно поворачиваются и дают мне пощёчины."

# ch/harems_full/sporty/events.rpy:271
translate russian ayesha_hanna_showdown_952fce77:
    "Каждая бьёт со своей стороны, резко мотая мою голову."

# ch/harems_full/sporty/events.rpy:272
translate russian ayesha_hanna_showdown_ab980475:
    "После этого я ошеломлён: голова кружится, перед глазами всё расплывается."

# ch/harems_full/sporty/events.rpy:276
translate russian ayesha_hanna_showdown_6ba1ad63:
    hanna.say "Хватит себя жалеть!"

# ch/harems_full/sporty/events.rpy:277
translate russian ayesha_hanna_showdown_1a70faa0:
    hanna.say "Ты заслужил куда больше лёгкой пощёчины!"

# ch/harems_full/sporty/events.rpy:279
translate russian ayesha_hanna_showdown_c7c5d187:
    ayesha.say "Ага, козёл!"

# ch/harems_full/sporty/events.rpy:280
translate russian ayesha_hanna_showdown_0619c8e1:
    ayesha.say "Надо тебя так растянуть, чтобы хрустнул!"

# ch/harems_full/sporty/events.rpy:281
translate russian ayesha_hanna_showdown_efce1045:
    "Я ошалело трясу головой."

# ch/harems_full/sporty/events.rpy:282
translate russian ayesha_hanna_showdown_0925879f:
    "И немного прихожу в себя."

# ch/harems_full/sporty/events.rpy:283
translate russian ayesha_hanna_showdown_61fdfe71:
    mike.say "Да ладно вам, девчонки!"

# ch/harems_full/sporty/events.rpy:284
translate russian ayesha_hanna_showdown_b5d2c12a:
    mike.say "Дайте мне шанс загладить вину!"

# ch/harems_full/sporty/events.rpy:286
translate russian ayesha_hanna_showdown_9e9c92ec:
    "Ханна презрительно усмехается."

# ch/harems_full/sporty/events.rpy:287
translate russian ayesha_hanna_showdown_c73408d8:
    "Айша глухо рычит."

# ch/harems_full/sporty/events.rpy:288
translate russian ayesha_hanna_showdown_c332771f_1:
    hanna.say "Я уже какое-то время чувствую, что мне нужны перемены."

# ch/harems_full/sporty/events.rpy:289
translate russian ayesha_hanna_showdown_0fecbad9_1:
    hanna.say "Что пора заняться своим делом."

# ch/harems_full/sporty/events.rpy:290
translate russian ayesha_hanna_showdown_ed8829f6_1:
    hanna.say "Может, начать заново в другом городе."

# ch/harems_full/sporty/events.rpy:291
translate russian ayesha_hanna_showdown_7de6f37b_1:
    hanna.say "Даже открыть собственный зал."

# ch/harems_full/sporty/events.rpy:292
translate russian ayesha_hanna_showdown_355493c1:
    hanna.say "Что скажешь, Айша?"

# ch/harems_full/sporty/events.rpy:293
translate russian ayesha_hanna_showdown_e97f3643:
    hanna.say "Не хочешь работать у меня?"

# ch/harems_full/sporty/events.rpy:295
translate russian ayesha_hanna_showdown_77d190a0:
    "Айша кивает, поворачиваясь ко мне спиной."

# ch/harems_full/sporty/events.rpy:296
translate russian ayesha_hanna_showdown_d035885c:
    ayesha.say "Может, и приму твоё предложение, Ханна."

# ch/harems_full/sporty/events.rpy:297
translate russian ayesha_hanna_showdown_6380de19:
    ayesha.say "Это место уже надоело."

# ch/harems_full/sporty/events.rpy:298
translate russian ayesha_hanna_showdown_a70070f2:
    ayesha.say "Знаешь, будто сплошная помойка?"

# ch/harems_full/sporty/events.rpy:302
translate russian ayesha_hanna_showdown_98cb7ce1:
    "Но затем я вижу, как обе смотрят на меня через плечо."

# ch/harems_full/sporty/events.rpy:303
translate russian ayesha_hanna_showdown_ed7e7360:
    "Чистая ненависть в их глазах останавливает меня на месте."

# ch/harems_full/sporty/events.rpy:307
translate russian ayesha_hanna_showdown_02692dac:
    "Мне остаётся лишь молча стоять."

# ch/harems_full/sporty/events.rpy:308
translate russian ayesha_hanna_showdown_18e614ee:
    "Стоять и смотреть, как они уходят."

# ch/harems_full/sporty/events.rpy:316
translate russian sporty_harem_event_01_2d77a331:
    "Знаете, как люди говорят, что перед каким-то поступком у них было странное предчувствие?"

# ch/harems_full/sporty/events.rpy:317
translate russian sporty_harem_event_01_38621d59:
    "То маленькое сомнение, которое не отстаёт, как ни старайся его игнорировать?"

# ch/harems_full/sporty/events.rpy:318
translate russian sporty_harem_event_01_abce54fc:
    "Так вот, уточню: ничего подобного я не чувствую, когда мы с Ханной приезжаем в торговый центр."

# ch/harems_full/sporty/events.rpy:319
translate russian sporty_harem_event_01_fe75cca8:
    "Ведь это должно быть обычное, ничем не примечательное свидание."

# ch/harems_full/sporty/events.rpy:320
translate russian sporty_harem_event_01_c727a82c:
    "Без особых изысков и уж точно без чего-то тяжёлого."

# ch/harems_full/sporty/events.rpy:321
translate russian sporty_harem_event_01_c2c532a9:
    "И поначалу всё именно так и идёт."

# ch/harems_full/sporty/events.rpy:322
translate russian sporty_harem_event_01_1f84e5d8:
    "Мы гуляем от одного места к другому, по возможности обходя толпы."

# ch/harems_full/sporty/events.rpy:323
translate russian sporty_harem_event_01_6635d240:
    "Болтаем ни о чём конкретном, умудряясь при этом обсудить всё."

# ch/harems_full/sporty/events.rpy:324
translate russian sporty_harem_event_01_2a0e1d33:
    "Решаем, не взять ли мороженого, но в итоге выбираем кофе."

# ch/harems_full/sporty/events.rpy:325
translate russian sporty_harem_event_01_84100300:
    "И вот мы ждём в очереди наши эспрессо, латте или что мы там заказали."

# ch/harems_full/sporty/events.rpy:326
translate russian sporty_harem_event_01_e630fafa:
    "Тут я случайно оглядываюсь и замечаю знакомое лицо в одном из магазинов напротив."

# ch/harems_full/sporty/events.rpy:327
translate russian sporty_harem_event_01_ed07e202:
    "Это довольно современный и впечатляющий магазин спортивной одежды и всяких сопутствующих товаров."

# ch/harems_full/sporty/events.rpy:328
translate russian sporty_harem_event_01_bde555d1:
    "Сначала я разглядываю дорогие кроссовки в витрине, но затем внимание привлекает кто-то внутри."

# ch/harems_full/sporty/events.rpy:329
translate russian sporty_harem_event_01_d78b70e9:
    "Высокая, сложением словно греческая богиня — это может быть только Айша."

# ch/harems_full/sporty/events.rpy:330
translate russian sporty_harem_event_01_58a62a75:
    "Она стоит ко мне вполоборота, но я всё равно вижу, что почти весь её наряд — облегающий спандекс."

# ch/harems_full/sporty/events.rpy:331
translate russian sporty_harem_event_01_0d0b4b50:
    "Слушайте, я понимаю, о чём вы сейчас думаете."

# ch/harems_full/sporty/events.rpy:332
translate russian sporty_harem_event_01_b552f499:
    "Я и так постоянно могу любоваться потрясающим телом Айши в зале."

# ch/harems_full/sporty/events.rpy:333
translate russian sporty_harem_event_01_58c4c4d8:
    "А сейчас у меня свидание с Ханной, и по правилам я должен смотреть только на неё."

# ch/harems_full/sporty/events.rpy:334
translate russian sporty_harem_event_01_4e9f3851:
    "Но я ведь не собирался разглядывать другую девушку. И я всего лишь смотрю."

# ch/harems_full/sporty/events.rpy:335
translate russian sporty_harem_event_01_8f8e1a72:
    hanna.say "Эй, [lssb_common.hero_name()]."

# ch/harems_full/sporty/events.rpy:337
translate russian sporty_harem_event_01_b0386863:
    hanna.say "На что засмотрелся, а?"

# ch/harems_full/sporty/events.rpy:338
translate russian sporty_harem_event_01_c59684f6:
    "Чёрт, попался!"

# ch/harems_full/sporty/events.rpy:339
translate russian sporty_harem_event_01_1206c60e:
    "Я инстинктивно пытаюсь сделать вид, что ничего не произошло."

# ch/harems_full/sporty/events.rpy:340
translate russian sporty_harem_event_01_9546aaf8:
    "Может, прикинусь невинным, Ханна поверит, и свидание продолжится?"

# ch/harems_full/sporty/events.rpy:341
translate russian sporty_harem_event_01_9a6c7f7b:
    mike.say "А, ничего, Ханна. Совсем ничего!"

# ch/harems_full/sporty/events.rpy:342
translate russian sporty_harem_event_01_0e66ad5e:
    mike.say "Я... я просто..."

# ch/harems_full/sporty/events.rpy:343
translate russian sporty_harem_event_01_cdc2a98a:
    mike.say "Разглядывал обувь в витрине... вон там."

# ch/harems_full/sporty/events.rpy:344
translate russian sporty_harem_event_01_e1541cca:
    mike.say "Как думаешь, мне не пора купить новые кроссовки?"

# ch/harems_full/sporty/events.rpy:345
translate russian sporty_harem_event_01_d17c1f16:
    "Ханна смотрит на меня с весёлым прищуром, склонив голову набок и криво усмехаясь."

# ch/harems_full/sporty/events.rpy:346
translate russian sporty_harem_event_01_1c74c1a9:
    "Весь её вид сейчас кричит: «Врёшь!»"

# ch/harems_full/sporty/events.rpy:347
translate russian sporty_harem_event_01_c3071819:
    "Она явно видит мои жалкие отговорки насквозь."

# ch/harems_full/sporty/events.rpy:349
translate russian sporty_harem_event_01_de601f59:
    hanna.say "Да ладно тебе, [lssb_common.hero_name()]."

# ch/harems_full/sporty/events.rpy:350
translate russian sporty_harem_event_01_c80c7840:
    hanna.say "Ты кое-что разглядывал."

# ch/harems_full/sporty/events.rpy:351
translate russian sporty_harem_event_01_45351d39:
    hanna.say "Но явно не обувь!"

# ch/harems_full/sporty/events.rpy:352
translate russian sporty_harem_event_01_24a88068:
    "Мы забираем напитки и выходим из кофейни, а Ханна не собирается оставлять эту тему."

# ch/harems_full/sporty/events.rpy:353
translate russian sporty_harem_event_01_9bbcf643:
    "Вижу, ей нравится наблюдать, как я выкручиваюсь."

# ch/harems_full/sporty/events.rpy:354
translate russian sporty_harem_event_01_d11e1ffb:
    "Так что лучшее, на что можно надеяться, — извиняться и переждать."

# ch/harems_full/sporty/events.rpy:355
translate russian sporty_harem_event_01_298e5305:
    "Может, ещё вставить пару смущённых комплиментов, чтобы потешить немалое самолюбие Ханны."

# ch/harems_full/sporty/events.rpy:356
translate russian sporty_harem_event_01_402105f3:
    "Но тут Ханна останавливается и указывает в тот самый магазин."

# ch/harems_full/sporty/events.rpy:358
translate russian sporty_harem_event_01_0afd687b:
    hanna.say "Погоди, ты сейчас на неё пялился?"

# ch/harems_full/sporty/events.rpy:359
translate russian sporty_harem_event_01_7e5d2776:
    mike.say "Эм... не уверен, Ханна..."

# ch/harems_full/sporty/events.rpy:360
translate russian sporty_harem_event_01_cb9ed6cf:
    mike.say "Я толком лица не видел..."

# ch/harems_full/sporty/events.rpy:361
translate russian sporty_harem_event_01_46bc7714:
    hanna.say "Да ну, это же Айша! Я точно знаю!"

# ch/harems_full/sporty/events.rpy:362
translate russian sporty_harem_event_01_8eae4c61:
    "Она смотрит на меня, и я вижу вспышку ревности в её глазах."

# ch/harems_full/sporty/events.rpy:363
translate russian sporty_harem_event_01_5198f1c4:
    hanna.say "Ты засмотрелся на эту неповоротливую лосиху?!"

# ch/harems_full/sporty/events.rpy:364
translate russian sporty_harem_event_01_ef215eb1:
    mike.say "Ханна, пожалуйста..."

# ch/harems_full/sporty/events.rpy:365
translate russian sporty_harem_event_01_6741ada9:
    "Не успеваю её остановить, как Ханна уже шагает к спортивному магазину."

# ch/harems_full/sporty/events.rpy:366
translate russian sporty_harem_event_01_8828f237:
    "Я спешу следом, всё ещё надеясь как-то предотвратить надвигающийся конфликт."

# ch/harems_full/sporty/events.rpy:367
translate russian sporty_harem_event_01_7cc06219:
    "Внутри Ханна идёт прямо к Айше, которая всё ещё стоит к нам спиной."

# ch/harems_full/sporty/events.rpy:368
translate russian sporty_harem_event_01_7b4af884:
    "Кладёт ладонь ей на плечо — для этого, замечаю я, приходится тянуться вверх — и разворачивает её."

# ch/harems_full/sporty/events.rpy:372
translate russian sporty_harem_event_01_fc0c016c:
    ayesha.say "Эй... какого чёрта?!"

# ch/harems_full/sporty/events.rpy:373
translate russian sporty_harem_event_01_e0a1261d:
    ayesha.say "А, Ханна, это ты. Что такое?"

# ch/harems_full/sporty/events.rpy:375
translate russian sporty_harem_event_01_adcbfa32:
    "Ханна открывает рот, явно собираясь сказать что-то враждебное, но я успеваю встать между ними."

# ch/harems_full/sporty/events.rpy:376
translate russian sporty_harem_event_01_7f88f53c:
    mike.say "Привет, Айша."

# ch/harems_full/sporty/events.rpy:377
translate russian sporty_harem_event_01_36a7a6ab:
    mike.say "Мы просто проходили мимо и случайно тебя заметили."

# ch/harems_full/sporty/events.rpy:378
translate russian sporty_harem_event_01_eda2f876:
    mike.say "Было бы невежливо не зайти поздороваться."

# ch/harems_full/sporty/events.rpy:379
translate russian sporty_harem_event_01_100c404c:
    "Вижу, как Айша начинает понимать происходящее."

# ch/harems_full/sporty/events.rpy:380
translate russian sporty_harem_event_01_8cd8326c:
    "Теперь это выглядит не как внезапный налёт начальницы, а как то, чем и является."

# ch/harems_full/sporty/events.rpy:381
translate russian sporty_harem_event_01_a5429b21:
    "Просто знакомые случайно встретили её в торговом центре."

# ch/harems_full/sporty/events.rpy:382
translate russian sporty_harem_event_01_3d2043ac:
    ayesha.say "А, конечно..."

# ch/harems_full/sporty/events.rpy:383
translate russian sporty_harem_event_01_aacd234c:
    ayesha.say "Рада вас видеть."

# ch/harems_full/sporty/events.rpy:384
translate russian sporty_harem_event_01_56d324b7:
    "Она неловко улыбается и обводит рукой пространство вокруг."

# ch/harems_full/sporty/events.rpy:386
translate russian sporty_harem_event_01_0bfbc12b:
    ayesha.say "Я просто, знаете, зашла купить пару вещей..."

# ch/harems_full/sporty/events.rpy:387
translate russian sporty_harem_event_01_4f81c2d1:
    "Впервые до меня доходит, почему Айше так неуютно."

# ch/harems_full/sporty/events.rpy:388
translate russian sporty_harem_event_01_b7704729:
    "Она стоит перед нами лишь в облегающем спандексе и беговых кроссовках."

# ch/harems_full/sporty/events.rpy:389
translate russian sporty_harem_event_01_c41a2464:
    "Да, в зале она может ходить так же, но там это её работа."

# ch/harems_full/sporty/events.rpy:390
translate russian sporty_harem_event_01_f5fd52ee:
    "А здесь она гораздо застенчивее и острее чувствует, насколько её тело выставлено напоказ."

# ch/harems_full/sporty/events.rpy:391
translate russian sporty_harem_event_01_1b8a487f:
    "В этот миг я искренне ей сочувствую."

# ch/harems_full/sporty/events.rpy:392
translate russian sporty_harem_event_01_d283fdd9:
    "Но мне и немного стыдно: застенчивость делает Айшу ещё привлекательнее..."

# ch/harems_full/sporty/events.rpy:393
translate russian sporty_harem_event_01_14804880:
    hanna.say "Наверное, непросто, да?"

# ch/harems_full/sporty/events.rpy:395
translate russian sporty_harem_event_01_04ab4546:
    hanna.say "Найти всё это в мужских размерах?"

# ch/harems_full/sporty/events.rpy:396
translate russian sporty_harem_event_01_24142eb2:
    "Едкая, злая реплика мгновенно меняет настроение встречи."

# ch/harems_full/sporty/events.rpy:398
translate russian sporty_harem_event_01_18a3cd71:
    ayesha.say "Прости, ЧТО ты сейчас сказала?!"

# ch/harems_full/sporty/events.rpy:399
translate russian sporty_harem_event_01_9c49bc88:
    hanna.say "Ты слышала, Айша."

# ch/harems_full/sporty/events.rpy:400
translate russian sporty_harem_event_01_55311445:
    hanna.say "Конечно, эта одежда тянется."

# ch/harems_full/sporty/events.rpy:401
translate russian sporty_harem_event_01_a126f441:
    hanna.say "Но даже она не может скрыть столько тестостерона!"

# ch/harems_full/sporty/events.rpy:402
translate russian sporty_harem_event_01_ca26f695:
    ayesha.say "Ах ты... тощая маленькая сучка!"

# ch/harems_full/sporty/events.rpy:403
translate russian sporty_harem_event_01_b50300bd:
    ayesha.say "Если бы мне не была так нужна эта паршивая работа, я бы..."

# ch/harems_full/sporty/events.rpy:404
translate russian sporty_harem_event_01_a69106d1:
    hanna.say "Что бы ты сделала, Айша?"

# ch/harems_full/sporty/events.rpy:406
translate russian sporty_harem_event_01_4955e18d:
    hanna.say "Говори. Обещаю, не попрошу папочку тебя уволить."

# ch/harems_full/sporty/events.rpy:407
translate russian sporty_harem_event_01_cfc4bdcc:
    "Всё быстро выходит из-под контроля."

# ch/harems_full/sporty/events.rpy:408
translate russian sporty_harem_event_01_fd8b5e23:
    "Я уже боюсь, что они подерутся прямо посреди магазина."

# ch/harems_full/sporty/events.rpy:409
translate russian sporty_harem_event_01_efc500d8:
    mike.say "Девушки, это глупо."

# ch/harems_full/sporty/events.rpy:410
translate russian sporty_harem_event_01_8c52bb1a:
    mike.say "О чём вы вообще спорите?"

# ch/harems_full/sporty/events.rpy:411
translate russian sporty_harem_event_01_6da06e08:
    hanna.say "О том, с чего кому-то вообще пялиться на эту корову!"

# ch/harems_full/sporty/events.rpy:412
translate russian sporty_harem_event_01_8067a891:
    ayesha.say "А, вот в чём дело?"

# ch/harems_full/sporty/events.rpy:413
translate russian sporty_harem_event_01_eaaca5f1:
    ayesha.say "[lssb_common.hero_name()] посмотрел на меня, и ты испугалась, что ему нужна настоящая женщина, а не дешёвка!"

# ch/harems_full/sporty/events.rpy:414
translate russian sporty_harem_event_01_240ea6bd:
    hanna.say "Ах ты сучка!"

# ch/harems_full/sporty/events.rpy:415
translate russian sporty_harem_event_01_c88c8448:
    hanna.say "Всё, решить это можно только одним способом!"

# ch/harems_full/sporty/events.rpy:416
translate russian sporty_harem_event_01_ad618fb5:
    mike.say "Эм... можно?"

# ch/harems_full/sporty/events.rpy:417
translate russian sporty_harem_event_01_76d88c67:
    hanna.say "Мы обе купим купальники, и пусть [lssb_common.hero_name()] решит, кто ему больше нравится!"

# ch/harems_full/sporty/events.rpy:418
translate russian sporty_harem_event_01_530bed64:
    ayesha.say "Вызов принят!"

# ch/harems_full/sporty/events.rpy:419
translate russian sporty_harem_event_01_b4b3b950:
    mike.say "А... погоди... что?!"

# ch/harems_full/sporty/events.rpy:420
translate russian sporty_harem_event_01_5aa76bf6:
    "Я и возразить не успеваю, как обе уже шагают в отдел купальников."

# ch/harems_full/sporty/events.rpy:421
translate russian sporty_harem_event_01_0cbd39ff:
    "Мне остаётся лишь идти следом и гадать, как всё могло так быстро зайти настолько далеко."

# ch/harems_full/sporty/events.rpy:422
translate russian sporty_harem_event_01_3c021017:
    "Лишь спустя некоторое время до меня начинает доходить довольно очевидная мысль."

# ch/harems_full/sporty/events.rpy:423
translate russian sporty_harem_event_01_06a96745:
    "Если правильно разыграть карты, для меня всё может оказаться чертовски весело..."

# ch/harems_full/sporty/events.rpy:433
translate russian sporty_harem_swimsuit_contest_48a22716:
    "Странное чувство — смотреть, как Айша и Ханна, ревнуя друг к другу, рыщут среди вешалок в поисках купальников."

# ch/harems_full/sporty/events.rpy:434
translate russian sporty_harem_swimsuit_contest_599eb556:
    "А затем быть поспешно увезённым к себе домой, чтобы они их надели и устроили соревнование, дефилируя передо мной."

# ch/harems_full/sporty/events.rpy:435
translate russian sporty_harem_swimsuit_contest_5de29e05:
    "Даже когда меня практически загоняют вниз по лестнице в спальню, всё по-прежнему кажется странным и нереальным."

# ch/harems_full/sporty/events.rpy:439
translate russian sporty_harem_swimsuit_contest_1a7ef45a:
    "Обычно одной мысли о любой из них в купальнике хватило бы, чтобы меня завести."

# ch/harems_full/sporty/events.rpy:440
translate russian sporty_harem_swimsuit_contest_0a5da79f:
    "Но из-за внезапного превращения всего этого в состязание мне почему-то трудно осознать происходящее."

# ch/harems_full/sporty/events.rpy:444
translate russian sporty_harem_swimsuit_contest_7459de4b:
    "Ханна закрывает за нами дверь и для верности ещё и прислоняется к ней."

# ch/harems_full/sporty/events.rpy:445
translate russian sporty_harem_swimsuit_contest_16108127:
    "Айша тем временем подводит меня к кровати и заставляет сесть."

# ch/harems_full/sporty/events.rpy:446
translate russian sporty_harem_swimsuit_contest_3620822d:
    ayesha.say "Припаркуй задницу вот тут, мистер."

# ch/harems_full/sporty/events.rpy:447
translate russian sporty_harem_swimsuit_contest_fee0fcb1:
    ayesha.say "И даже не думай двигаться, пока мы не закончим!"

# ch/harems_full/sporty/events.rpy:448
translate russian sporty_harem_swimsuit_contest_856a26aa:
    "Хотя сейчас они выглядят заклятыми врагами, Ханна согласно кивает."

# ch/harems_full/sporty/events.rpy:449
translate russian sporty_harem_swimsuit_contest_0a29fd7b:
    hanna.say "Да, [lssb_common.hero_name()], так и сделай."

# ch/harems_full/sporty/events.rpy:450
translate russian sporty_harem_swimsuit_contest_24bb8cd3:
    hanna.say "Мы ведь всё это затеяли не ради твоего удовольствия, знаешь ли."

# ch/harems_full/sporty/events.rpy:451
translate russian sporty_harem_swimsuit_contest_4c48c60d:
    "Серьёзно?!"

# ch/harems_full/sporty/events.rpy:452
translate russian sporty_harem_swimsuit_contest_56e08cf5:
    "Две взрослые женщины собираются надеть купальники и расхаживать передо мной."

# ch/harems_full/sporty/events.rpy:453
translate russian sporty_harem_swimsuit_contest_4fdfe8b7:
    "А потом ждут, что я скажу, какая из них выглядит лучше."

# ch/harems_full/sporty/events.rpy:454
translate russian sporty_harem_swimsuit_contest_7256916b:
    "Понятия не имею, кому ещё это, чёрт возьми, может доставить удовольствие..."

# ch/harems_full/sporty/events.rpy:455
translate russian sporty_harem_swimsuit_contest_6aae2108:
    "Но, не желая лишиться обещанного зрелища, я охотно подыгрываю."

# ch/harems_full/sporty/events.rpy:456
translate russian sporty_harem_swimsuit_contest_f6e09203:
    "Поэтому по очереди киваю каждой."

# ch/harems_full/sporty/events.rpy:457
translate russian sporty_harem_swimsuit_contest_c74b0bd6:
    mike.say "Хорошо, Ханна."

# ch/harems_full/sporty/events.rpy:458
translate russian sporty_harem_swimsuit_contest_5e5fe18a:
    mike.say "Хорошо, Айша."

# ch/harems_full/sporty/events.rpy:459
translate russian sporty_harem_swimsuit_contest_e434bccf:
    mike.say "Постараюсь не получать удовольствия..."

# ch/harems_full/sporty/events.rpy:460
translate russian sporty_harem_swimsuit_contest_87515baf:
    "К счастью, это срабатывает: ни одна не замечает нарастающего веселья в моём голосе."

# ch/harems_full/sporty/events.rpy:461
translate russian sporty_harem_swimsuit_contest_8132578f:
    "Может, потому что после моего согласия они уже не особенно слушали."

# ch/harems_full/sporty/events.rpy:462
translate russian sporty_harem_swimsuit_contest_ef14882f:
    "Я так и сижу на кровати, с полным изумлением наблюдая за началом."

# ch/harems_full/sporty/events.rpy:463
translate russian sporty_harem_swimsuit_contest_e2f58c7d:
    "Айша и Ханна сразу лезут в пакеты с только что купленными купальниками."

# ch/harems_full/sporty/events.rpy:464
translate russian sporty_harem_swimsuit_contest_680f157c:
    "Но затем почти одновременно поднимают головы и сердито смотрят на меня, словно я успел провиниться, просто сидя молча."

# ch/harems_full/sporty/events.rpy:465
translate russian sporty_harem_swimsuit_contest_b29f8683:
    hanna.say "Не подглядывай, [lssb_common.hero_name()]!"

# ch/harems_full/sporty/events.rpy:466
translate russian sporty_harem_swimsuit_contest_39c4f5c8:
    ayesha.say "Да, закрой глаза и не открывай, пока не разрешим!"

# ch/harems_full/sporty/events.rpy:467
translate russian sporty_harem_swimsuit_contest_eb45cc29:
    "Мне хочется возразить."

# ch/harems_full/sporty/events.rpy:468
translate russian sporty_harem_swimsuit_contest_e0d37785:
    "Но не хочется разрушить очарование момента и привести их в чувство."

# ch/harems_full/sporty/events.rpy:470
translate russian sporty_harem_swimsuit_contest_a33d3c49:
    "Поэтому я демонстративно закрываю глаза, изображая крайнее нежелание."

# ch/harems_full/sporty/events.rpy:471
translate russian sporty_harem_swimsuit_contest_4a0d1311:
    "Впрочем, не совсем изображая: посмотреть, как Айша и Ханна раздеваются, мне бы хотелось."

# ch/harems_full/sporty/events.rpy:472
translate russian sporty_harem_swimsuit_contest_970f2a09:
    "Но ещё сильнее хочется увидеть, как они будут красоваться в новых нарядах!"

# ch/harems_full/sporty/events.rpy:473
translate russian sporty_harem_swimsuit_contest_ade084c7:
    hanna.say "Уф... серьёзно?"

# ch/harems_full/sporty/events.rpy:474
translate russian sporty_harem_swimsuit_contest_13c69ed7:
    ayesha.say "Теперь-то что не так, Ханна?"

# ch/harems_full/sporty/events.rpy:475
translate russian sporty_harem_swimsuit_contest_b186b7f8:
    hanna.say "Чего ты смотришь, как я раздеваюсь, извращенка?"

# ch/harems_full/sporty/events.rpy:476
translate russian sporty_harem_swimsuit_contest_6cc6f4af:
    ayesha.say "Я на тебя НЕ смотрю!"

# ch/harems_full/sporty/events.rpy:477
translate russian sporty_harem_swimsuit_contest_71af8d15:
    ayesha.say "Просто... проверяю, чтобы ты не жульничала, вот и всё."

# ch/harems_full/sporty/events.rpy:478
translate russian sporty_harem_swimsuit_contest_dfe23b5c:
    hanna.say "Как я могу сжульничать, Айша? Дублёршу подставлю, что ли?!"

# ch/harems_full/sporty/events.rpy:479
translate russian sporty_harem_swimsuit_contest_b246e817:
    "Пока они препираются, я изо всех сил стараюсь сохранять серьёзное лицо."

# ch/harems_full/sporty/events.rpy:480
translate russian sporty_harem_swimsuit_contest_5a701924:
    "Но, похоже, усмешка всё-таки прокралась на губы."

# ch/harems_full/sporty/events.rpy:481
translate russian sporty_harem_swimsuit_contest_4b8024dc:
    hanna.say "Эй, [lssb_common.hero_name()], ты чего?"

# ch/harems_full/sporty/events.rpy:482
translate russian sporty_harem_swimsuit_contest_b20ec834:
    ayesha.say "Он... он над нами смеётся?!"

# ch/harems_full/sporty/events.rpy:483
translate russian sporty_harem_swimsuit_contest_b0a2427b:
    "Решив, что меня раскусили и лучше бы извиниться, я украдкой приоткрываю один глаз."

# ch/harems_full/sporty/events.rpy:488
translate russian sporty_harem_swimsuit_contest_97c4dde6:
    "И, едва увидев, кто стоит передо мной, открываю второй, чтобы рассмотреть получше."

# ch/harems_full/sporty/events.rpy:489
translate russian sporty_harem_swimsuit_contest_9a7b32bd:
    "Айша и Ханна сдержали слово: обе стоят передо мной в купальниках."

# ch/harems_full/sporty/events.rpy:490
translate russian sporty_harem_swimsuit_contest_87590672:
