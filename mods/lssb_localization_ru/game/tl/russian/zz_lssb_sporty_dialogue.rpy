# ch/harems_full/sporty/events.rpy:1005
translate russian ayesha_hanna_propose_male_b3ed34fe:
    hanna.say "[lssb_common.hero_name()] и я всегда будем в твоём углу ринга."

# ch/harems_full/sporty/events.rpy:1006
translate russian ayesha_hanna_propose_male_7ef3be48:
    "Айша выслушивает наши доводы."

# ch/harems_full/sporty/events.rpy:1008
translate russian ayesha_hanna_propose_male_68d2e613:
    ayesha.say "Спасибо, но нет."

# ch/harems_full/sporty/events.rpy:1009
translate russian ayesha_hanna_propose_male_f73227c3:
    ayesha.say "Мне нужно сосредоточиться на своём боевом духе."

# ch/harems_full/sporty/events.rpy:1010
translate russian ayesha_hanna_propose_male_a2be112e:
    ayesha.say "Вообще-то сейчас мне хочется побыть одной и подумать."

# ch/harems_full/sporty/events.rpy:1012
translate russian ayesha_hanna_propose_male_f1b4bcf3:
    "Мы с Ханной смотрим, как Айша разворачивается и уходит."

# ch/harems_full/sporty/events.rpy:1013
translate russian ayesha_hanna_propose_male_55c0ee2f_1:
    "Понятия не имею, что нам теперь делать."

# ch/harems_full/sporty/events.rpy:1015
translate russian ayesha_hanna_propose_male_ed0d6b1c:
    "Но объятия Ханны, пока мы смотрим ей вслед, очень меня утешают."

# ch/harems_full/sporty/events.rpy:1022
translate russian ayesha_hanna_propose_male_52477826:
    "Айша и Ханна смотрят на меня в полном изумлении."

# ch/harems_full/sporty/events.rpy:1023
translate russian ayesha_hanna_propose_male_689a569f:
    "Но затем я замечаю, что обе качают головами."

# ch/harems_full/sporty/events.rpy:1026
translate russian ayesha_hanna_propose_male_eff7dea0:
    "И это не может быть хорошим знаком."

# ch/harems_full/sporty/events.rpy:1027
translate russian ayesha_hanna_propose_male_47e57d18_1:
    hanna.say "О боже..."

# ch/harems_full/sporty/events.rpy:1028
translate russian ayesha_hanna_propose_male_46e453e1_1:
    hanna.say "Зачем ты об этом спросил, [lssb_common.hero_name()]?"

# ch/harems_full/sporty/events.rpy:1029
translate russian ayesha_hanna_propose_male_428c02e6_1:
    hanna.say "Я не могу выйти за тебя: мне нужно управлять залом!"

# ch/harems_full/sporty/events.rpy:1030
translate russian ayesha_hanna_propose_male_94800173_1:
    ayesha.say "Ох, [lssb_common.hero_name()]..."

# ch/harems_full/sporty/events.rpy:1031
translate russian ayesha_hanna_propose_male_7c4e83e3_1:
    ayesha.say "Я польщена, но не могу выйти замуж."

# ch/harems_full/sporty/events.rpy:1032
translate russian ayesha_hanna_propose_male_f103b237_1:
    ayesha.say "Не сейчас, когда моя карьера на ринге в самом разгаре!"

# ch/harems_full/sporty/events.rpy:1033
translate russian ayesha_hanna_propose_male_91c7029c:
    "Вдруг кажется, будто мне дали пощёчину."

# ch/harems_full/sporty/events.rpy:1034
translate russian ayesha_hanna_propose_male_7d80071e:
    "И заодно вырвали всё внутри."

# ch/harems_full/sporty/events.rpy:1035
translate russian ayesha_hanna_propose_male_1c49a787:
    "Я медленно убираю кольца и поднимаюсь на ноги."

# ch/harems_full/sporty/events.rpy:1037
translate russian ayesha_hanna_propose_male_d98e6ad4:
    mike.say "Ладно..."

# ch/harems_full/sporty/events.rpy:1038
translate russian ayesha_hanna_propose_male_d2329ed1:
    mike.say "Наверное, идея и правда была глупой!"

# ch/harems_full/sporty/events.rpy:1041
translate russian ayesha_hanna_propose_male_369789c7:
    "Айша и Ханна улыбаются и кивают."

# ch/harems_full/sporty/events.rpy:1042
translate russian ayesha_hanna_propose_male_df30a52f:
    "Знаю, они пытаются смягчить отказ."

# ch/harems_full/sporty/events.rpy:1043
translate russian ayesha_hanna_propose_male_6c89f9a8:
    "Но, думаю, этим ранам понадобится время, чтобы зажить."

# ch/harems_full/sporty/events.rpy:1057
translate russian ayesha_hanna_male_ending_61389362:
    "Прежде чем начать, должен кое в чём признаться."

# ch/harems_full/sporty/events.rpy:1058
translate russian ayesha_hanna_male_ending_0ff5fa57:
    "В последние недели перед свадьбой я практически жил в спортзале!"

# ch/harems_full/sporty/events.rpy:1059
translate russian ayesha_hanna_male_ending_75b8411c:
    "И даже костюм для важного дня выбрал такой, чтобы подчеркнуть результаты."

# ch/harems_full/sporty/events.rpy:1060
translate russian ayesha_hanna_male_ending_9c94e6cc:
    "Но разве можно винить меня за желание хорошо выглядеть на своей свадьбе?"

# ch/harems_full/sporty/events.rpy:1061
translate russian ayesha_hanna_male_ending_07a62ca5:
    "Особенно когда женишься на таких девушках, как Айша и Ханна!"

# ch/harems_full/sporty/events.rpy:1062
translate russian ayesha_hanna_male_ending_0c1d0206:
    "Они ведь практически живут в зале."

# ch/harems_full/sporty/events.rpy:1063
translate russian ayesha_hanna_male_ending_cc184dcf:
    "Мне казалось, что я их подведу, если тоже не буду в отличной форме."

# ch/harems_full/sporty/events.rpy:1064
translate russian ayesha_hanna_male_ending_e40b93bc:
    "И... может, мне для разнообразия тоже хочется поймать несколько восхищённых взглядов!"

# ch/harems_full/sporty/events.rpy:1065
translate russian ayesha_hanna_male_ending_28a32355:
    "Поэтому теперь я стою у алтаря и чувствую себя довольно странно."

# ch/harems_full/sporty/events.rpy:1066
translate russian ayesha_hanna_male_ending_0dd6ca72:
    "То и дело оглядываюсь на собравшихся гостей."

# ch/harems_full/sporty/events.rpy:1067
translate russian ayesha_hanna_male_ending_e704f162:
    "Конечно, всех своих друзей и родственников узнаю."

# ch/harems_full/sporty/events.rpy:1068
translate russian ayesha_hanna_male_ending_017c37c9:
    "Но тут ещё целая толпа незнакомых людей."

# ch/harems_full/sporty/events.rpy:1069
translate russian ayesha_hanna_male_ending_daedc0d2:
    "И, кажется, все они накачанные и пышут здоровьем!"

# ch/harems_full/sporty/events.rpy:1070
translate russian ayesha_hanna_male_ending_0911eef3:
    "Наверное, большинство гостей Ханны тоже ходят в её зал."

# ch/harems_full/sporty/events.rpy:1071
translate russian ayesha_hanna_male_ending_ed5ccdc2:
    "А Айша явно пригласила немало приятелей по рестлингу!"

# ch/harems_full/sporty/events.rpy:1072
translate russian ayesha_hanna_male_ending_a14ccc21:
    "Вдруг часовню наполняет музыка, и настроение мгновенно меняется."

# ch/harems_full/sporty/events.rpy:1073
translate russian ayesha_hanna_male_ending_627ced66:
    "Теперь все тоже оглядываются."

# ch/harems_full/sporty/events.rpy:1074
translate russian ayesha_hanna_male_ending_a6b32945:
    "Мы вытягиваем шеи, пытаясь увидеть Айшу и Ханну."

# ch/harems_full/sporty/events.rpy:1078
translate russian ayesha_hanna_male_ending_44a249da:
    "И вот я их вижу!"

# ch/harems_full/sporty/events.rpy:1079
translate russian ayesha_hanna_male_ending_17a488de:
    "Ожидание того стоило."

# ch/harems_full/sporty/events.rpy:1080
translate russian ayesha_hanna_male_ending_9366b2d7:
    "Я знаю, Ханне всегда нравилось быть в центре внимания."

# ch/harems_full/sporty/events.rpy:1081
translate russian ayesha_hanna_male_ending_8d0c30dd:
    "Но сейчас не понимаю, как вообще можно смотреть куда-то ещё."

# ch/harems_full/sporty/events.rpy:1082
translate russian ayesha_hanna_male_ending_7cea250f:
    "Каждое её движение вызывает у меня дрожь: настолько она прекрасна."

# ch/harems_full/sporty/events.rpy:1083
translate russian ayesha_hanna_male_ending_ca98326c:
    "Платье тоже идеально, ненавязчиво подчёркивает фигуру."

# ch/harems_full/sporty/events.rpy:1085
translate russian ayesha_hanna_male_ending_a00e6de8:
    "Даже округлившийся от беременности живот выглядит потрясающе."

# ch/harems_full/sporty/events.rpy:1086
translate russian ayesha_hanna_male_ending_e09e7cbd:
    "Каким-то образом гармонично дополняет её прекрасные формы."

# ch/harems_full/sporty/events.rpy:1087
translate russian ayesha_hanna_male_ending_4b06c48d:
    "Затем мне удаётся оторвать взгляд от Ханны и посмотреть на вторую невесту."

# ch/harems_full/sporty/events.rpy:1088
translate russian ayesha_hanna_male_ending_61d654c5:
    "От Айши у меня перехватывает дыхание не меньше."

# ch/harems_full/sporty/events.rpy:1089
translate russian ayesha_hanna_male_ending_4a19a869:
    "Ханна спортивная, а Айша величественная, настоящая богиня-амазонка!"

# ch/harems_full/sporty/events.rpy:1090
translate russian ayesha_hanna_male_ending_0ef02ce3:
    "Я так привык видеть её в спандексе, что это почти откровение."

# ch/harems_full/sporty/events.rpy:1091
translate russian ayesha_hanna_male_ending_53bfca26:
    "И к алтарю она шагает совершенно уверенно."

# ch/harems_full/sporty/events.rpy:1093
translate russian ayesha_hanna_male_ending_752e26f9:
    "Опускаю взгляд и вижу, что Айша тоже беременна, — это кажется почти закономерным."

# ch/harems_full/sporty/events.rpy:1094
translate russian ayesha_hanna_male_ending_0aa0b461:
    "Словно она богиня плодородия или что-то такое же невероятное!"

# ch/harems_full/sporty/events.rpy:1095
translate russian ayesha_hanna_male_ending_b397039b:
    "Наверное, я улыбаюсь как дурак, когда они подходят к алтарю."

# ch/harems_full/sporty/events.rpy:1098
translate russian ayesha_hanna_male_ending_ee44c87b:
    "Потому что Айша и Ханна хихикают, переглядываясь."

# ch/harems_full/sporty/events.rpy:1100
translate russian ayesha_hanna_male_ending_1cbd586c:
    hanna.say "Нравится, милый?"

# ch/harems_full/sporty/events.rpy:1101
translate russian ayesha_hanna_male_ending_87924f64:
    ayesha.say "Потом сможешь увидеть ещё больше!"

# ch/harems_full/sporty/events.rpy:1105
translate russian ayesha_hanna_male_ending_968b77b7:
    "Священник кашляет, и теперь уже я лукаво усмехаюсь."

# ch/harems_full/sporty/events.rpy:1106
translate russian ayesha_hanna_male_ending_d2a64f2a:
    "Айша и Ханна выглядят ужасно смущёнными."

# ch/harems_full/sporty/events.rpy:1107
translate russian ayesha_hanna_male_ending_9b5d025d:
    "И поспешно занимают свои места."

# ch/harems_full/sporty/events.rpy:1109
translate russian ayesha_hanna_male_ending_d601e095:
    "Священник" "Мы собрались здесь сегодня..."

# ch/harems_full/sporty/events.rpy:1110
translate russian ayesha_hanna_male_ending_ff5a9a14:
    "Священник" "Чтобы соединить этих троих священными узами брака..."

# ch/harems_full/sporty/events.rpy:1111
translate russian ayesha_hanna_male_ending_6bc6d872:
    "Мы, наверное, раз сто репетировали церемонию."

# ch/harems_full/sporty/events.rpy:1112
translate russian ayesha_hanna_male_ending_fbef2e9a:
    "Так что теперь, когда всё по-настоящему, я действую почти на автопилоте."

# ch/harems_full/sporty/events.rpy:1113
translate russian ayesha_hanna_male_ending_ce5617c1:
    "Особенно запоминается мне лишь обмен клятвами."

# ch/harems_full/sporty/events.rpy:1114
translate russian ayesha_hanna_male_ending_a4c0b7e6:
    "Священник" "Согласны ли вы, Айша..."

# ch/harems_full/sporty/events.rpy:1115
translate russian ayesha_hanna_male_ending_0d6d07d8:
    "Священник" "Вступить с этими людьми..."

# ch/harems_full/sporty/events.rpy:1116
translate russian ayesha_hanna_male_ending_8c7361cd:
    "Священник" "В законный брак?"

# ch/harems_full/sporty/events.rpy:1118
translate russian ayesha_hanna_male_ending_c1f5002d:
    ayesha.say "Согласна."

# ch/harems_full/sporty/events.rpy:1119
translate russian ayesha_hanna_male_ending_b7d87991:
    "Священник" "А вы, Ханна, согласны..."

# ch/harems_full/sporty/events.rpy:1120
translate russian ayesha_hanna_male_ending_0d6d07d8_1:
    "Священник" "Вступить с этими людьми..."

# ch/harems_full/sporty/events.rpy:1121
translate russian ayesha_hanna_male_ending_8c7361cd_1:
    "Священник" "В законный брак?"

# ch/harems_full/sporty/events.rpy:1123
translate russian ayesha_hanna_male_ending_54f2dce9:
    hanna.say "Согласна."

# ch/harems_full/sporty/events.rpy:1124
translate russian ayesha_hanna_male_ending_2f91345e:
    "Священник" "И наконец, вы, [lssb_common.hero_name()], согласны..."

# ch/harems_full/sporty/events.rpy:1125
translate russian ayesha_hanna_male_ending_0d6d07d8_2:
    "Священник" "Вступить с этими людьми..."

# ch/harems_full/sporty/events.rpy:1126
translate russian ayesha_hanna_male_ending_8c7361cd_2:
    "Священник" "В законный брак?"

# ch/harems_full/sporty/events.rpy:1127
translate russian ayesha_hanna_male_ending_cc481164:
    mike.say "Согласен."

# ch/harems_full/sporty/events.rpy:1128
translate russian ayesha_hanna_male_ending_a925eb3f:
    "Священник кивает и смотрит на собравшихся гостей."

# ch/harems_full/sporty/events.rpy:1129
translate russian ayesha_hanna_male_ending_58c83231:
    "Священник" "Обращаюсь ко всем присутствующим..."

# ch/harems_full/sporty/events.rpy:1130
translate russian ayesha_hanna_male_ending_40514e3f:
    "Священник" "Если кому-то известна причина, по которой эти люди не должны вступать в брак..."

# ch/harems_full/sporty/events.rpy:1131
translate russian ayesha_hanna_male_ending_b17c1f9a:
    "Священник" "Скажите сейчас или молчите вечно."

# ch/harems_full/sporty/events.rpy:1134
translate russian ayesha_hanna_male_ending_61bd385c:
    "Наступает обычное неловкое молчание, слышатся смешки."

# ch/harems_full/sporty/events.rpy:1135
translate russian ayesha_hanna_male_ending_a764cb40:
    "Я специально смотрю на друзей Айши по рестлингу."

# ch/harems_full/sporty/events.rpy:1136
translate russian ayesha_hanna_male_ending_b1080376:
    "Если кто и выкинет какую-нибудь странную театральную выходку, так это они!"

# ch/harems_full/sporty/events.rpy:1137
translate russian ayesha_hanna_male_ending_5d8ba981:
    "Но, к счастью, все ведут себя прилично."

# ch/harems_full/sporty/events.rpy:1138
translate russian ayesha_hanna_male_ending_d00b3666:
    "Священник" "Хорошо."

# ch/harems_full/sporty/events.rpy:1139
translate russian ayesha_hanna_male_ending_9afc106a:
    "Священник" "С большой радостью объявляю вас супругами."

# ch/harems_full/sporty/events.rpy:1140
translate russian ayesha_hanna_male_ending_e8460257:
    "Священник" "Можете выразить любовь друг к другу любым выбранным вами способом."

# ch/harems_full/sporty/events.rpy:1143
translate russian ayesha_hanna_male_ending_2e661123:
    "Айша и Ханна не медлят ни секунды."

# ch/harems_full/sporty/events.rpy:1149
translate russian ayesha_hanna_male_ending_b920e096:
    "И я оказываюсь в их объятиях."

# ch/harems_full/sporty/events.rpy:1150
translate russian ayesha_hanna_male_ending_8c741111:
    "Повсюду руки и поцелуи."

# ch/harems_full/sporty/events.rpy:1151
translate russian ayesha_hanna_male_ending_5beee719:
    "Некоторые руки даже сжимают мне задницу!"

# ch/harems_full/sporty/events.rpy:1156
translate russian ayesha_hanna_male_ending_39a135c5:
    "Но на это я жаловаться не собираюсь."

# ch/harems_full/sporty/events.rpy:1157
translate russian ayesha_hanna_male_ending_16299a54:
    "Ведь я только что женился на двух самых прекрасных девушках в мире."

# ch/harems_full/sporty/events.rpy:1158
translate russian ayesha_hanna_male_ending_70d6d214:
    "И наша совместная жизнь начинается прямо здесь и сейчас."

# ch/harems_full/sporty/events.rpy:1161
translate russian ayesha_hanna_male_ending_b858aee3:
    hanna.say "И как это должно работать?"

# ch/harems_full/sporty/events.rpy:1162
translate russian ayesha_hanna_male_ending_b7ff573e:
    hanna.say "Просто рассказываем о совместной жизни? О том, какой [lssb_common.hero_name()] в быту?"

# ch/harems_full/sporty/events.rpy:1163
translate russian ayesha_hanna_male_ending_cec236af:
    ayesha.say "Наверное, да, Ханна."

# ch/harems_full/sporty/events.rpy:1164
translate russian ayesha_hanna_male_ending_765b69f0:
    ayesha.say "И стоит постараться говорить честно."

# ch/harems_full/sporty/events.rpy:1165
translate russian ayesha_hanna_male_ending_9692e44b:
    ayesha.say "Чтобы не казалось, будто мы всё приукрашиваем."

# ch/harems_full/sporty/events.rpy:1166
translate russian ayesha_hanna_male_ending_50420663:
    hanna.say "О, об этом не волнуйся."

# ch/harems_full/sporty/events.rpy:1167
translate russian ayesha_hanna_male_ending_43cb58c6:
    hanna.say "Мы его уже слишком долго терпим!"

# ch/harems_full/sporty/events.rpy:1168
translate russian ayesha_hanna_male_ending_0adc88c5:
    ayesha.say "Ага-ага..."

# ch/harems_full/sporty/events.rpy:1169
translate russian ayesha_hanna_male_ending_0759c2ab:
    ayesha.say "Но и не выставляй его сплошным кошмаром."

# ch/harems_full/sporty/events.rpy:1170
translate russian ayesha_hanna_male_ending_75da09a4:
    ayesha.say "Мне есть что сказать о нём хорошего."

# ch/harems_full/sporty/events.rpy:1171
translate russian ayesha_hanna_male_ending_8f8f5360:
    ayesha.say "Например, он один из немногих парней, которым я нравилась такой, какая есть."

# ch/harems_full/sporty/events.rpy:1172
translate russian ayesha_hanna_male_ending_3bed3236:
    ayesha.say "Его не отпугнуло, что я выше и мускулистее."

# ch/harems_full/sporty/events.rpy:1173
translate russian ayesha_hanna_male_ending_bb398011:
    hanna.say "Ха!"

# ch/harems_full/sporty/events.rpy:1174
translate russian ayesha_hanna_male_ending_e94052af:
    hanna.say "До того, как он начал заниматься в моём зале, это было несложно!"

# ch/harems_full/sporty/events.rpy:1175
translate russian ayesha_hanna_male_ending_5a206e3e:
    ayesha.say "Я серьёзно, Ханна!"

# ch/harems_full/sporty/events.rpy:1176
translate russian ayesha_hanna_male_ending_5704eb08:
    ayesha.say "Всю жизнь мужчины либо пугались моих габаритов."

# ch/harems_full/sporty/events.rpy:1177
translate russian ayesha_hanna_male_ending_5b8bd2d8:
    ayesha.say "Либо оказывались извращенцами, которым хотелось, чтобы я их заломала!"

# ch/harems_full/sporty/events.rpy:1178
translate russian ayesha_hanna_male_ending_7d05d594:
    hanna.say "Фу..."

# ch/harems_full/sporty/events.rpy:1179
translate russian ayesha_hanna_male_ending_714624e6:
    hanna.say "Только не начинай про извращенцев!"

# ch/harems_full/sporty/events.rpy:1180
translate russian ayesha_hanna_male_ending_5e5a3e54:
    hanna.say "В зале их полно."

# ch/harems_full/sporty/events.rpy:1181
translate russian ayesha_hanna_male_ending_aa44f077:
    hanna.say "Так трудно заставить их перестать на тебя пялиться."

# ch/harems_full/sporty/events.rpy:1182
translate russian ayesha_hanna_male_ending_a09f5819:
    hanna.say "И добиться, чтобы вместо них смотрели подходящие парни."

# ch/harems_full/sporty/events.rpy:1183
translate russian ayesha_hanna_male_ending_f6916b1b:
    ayesha.say "Такие, как [lssb_common.hero_name()]?"

# ch/harems_full/sporty/events.rpy:1184
translate russian ayesha_hanna_male_ending_1dfce5c6:
    hanna.say "Ну... да, Айша."

# ch/harems_full/sporty/events.rpy:1185
translate russian ayesha_hanna_male_ending_de7d4cdb:
    hanna.say "Я всегда хотела быть в форме и хорошо выглядеть."

# ch/harems_full/sporty/events.rpy:1186
translate russian ayesha_hanna_male_ending_516c31de:
    hanna.say "И мне нравится, когда это привлекает внимание."

# ch/harems_full/sporty/events.rpy:1187
translate russian ayesha_hanna_male_ending_df32482f:
    hanna.say "Но я всегда чувствовала, что [lssb_common.hero_name()] видит во мне нечто большее."

# ch/harems_full/sporty/events.rpy:1188
translate russian ayesha_hanna_male_ending_e0c2ae35:
    ayesha.say "Не думаю, что твоя красота его когда-либо отпугивала!"

# ch/harems_full/sporty/events.rpy:1189
translate russian ayesha_hanna_male_ending_e5f4e761:
    hanna.say "Конечно, нет!"

# ch/harems_full/sporty/events.rpy:1190
translate russian ayesha_hanna_male_ending_55193d93:
    hanna.say "Просто я никогда не чувствовала, что обязана перед ним красоваться."

# ch/harems_full/sporty/events.rpy:1191
translate russian ayesha_hanna_male_ending_6e61d633:
    hanna.say "Понимаешь, о чём я?"

# ch/harems_full/sporty/events.rpy:1192
translate russian ayesha_hanna_male_ending_822cc314:
    ayesha.say "Понимаю, понимаю..."

# ch/harems_full/sporty/events.rpy:1193
translate russian ayesha_hanna_male_ending_b0763fda:
    ayesha.say "Он словно даёт нам свободу быть такими, какими мы хотим."

# ch/harems_full/sporty/events.rpy:1194
translate russian ayesha_hanna_male_ending_08185170:
    ayesha.say "Например, когда я сказала, что свадьба не означает уход из спорта."

# ch/harems_full/sporty/events.rpy:1195
translate russian ayesha_hanna_male_ending_b802888f:
    ayesha.say "Что хочу продолжать выступать на ринге даже после согласия выйти замуж."

# ch/harems_full/sporty/events.rpy:1196
translate russian ayesha_hanna_male_ending_f354bd3b:
    hanna.say "Ну, даже если бы он возражал, ты могла бы взять его на болевой."

# ch/harems_full/sporty/events.rpy:1197
translate russian ayesha_hanna_male_ending_305c0b8d:
    hanna.say "Это бы точно заставило его передумать!"

# ch/harems_full/sporty/events.rpy:1199
translate russian ayesha_hanna_male_ending_f2961ad2:
    hanna.say "Понимаю, Айша."

# ch/harems_full/sporty/events.rpy:1200
translate russian ayesha_hanna_male_ending_4b279da9:
    hanna.say "Вот и меня он поддержал, когда я решила уйти из зала."

# ch/harems_full/sporty/events.rpy:1201
translate russian ayesha_hanna_male_ending_777ab949:
    ayesha.say "Именно, Ханна."

# ch/harems_full/sporty/events.rpy:1202
translate russian ayesha_hanna_male_ending_428d754a:
    ayesha.say "Он уважал твоё решение и поддержал тебя."

# ch/harems_full/sporty/events.rpy:1204
translate russian ayesha_hanna_male_ending_f2961ad2_1:
    hanna.say "Понимаю, Айша."

# ch/harems_full/sporty/events.rpy:1205
translate russian ayesha_hanna_male_ending_cb5bb49b:
    hanna.say "Вот и меня он поддержал, когда я решила продолжить работать в зале."

# ch/harems_full/sporty/events.rpy:1206
translate russian ayesha_hanna_male_ending_777ab949_1:
    ayesha.say "Именно, Ханна."

# ch/harems_full/sporty/events.rpy:1207
translate russian ayesha_hanna_male_ending_428d754a_1:
    ayesha.say "Он уважал твоё решение и поддержал тебя."

# ch/harems_full/sporty/events.rpy:1208
translate russian ayesha_hanna_male_ending_f109ee21:
    hanna.say "Но всё-таки довольно странно."

# ch/harems_full/sporty/events.rpy:1209
translate russian ayesha_hanna_male_ending_2d43a582:
    hanna.say "То, как у нас всё сложилось."

# ch/harems_full/sporty/events.rpy:1210
translate russian ayesha_hanna_male_ending_9e8c6483:
    ayesha.say "Хм..."

# ch/harems_full/sporty/events.rpy:1211
translate russian ayesha_hanna_male_ending_423ef553:
    ayesha.say "Я уж точно не думала, что встречу спутников жизни на работе!"

# ch/harems_full/sporty/events.rpy:1212
translate russian ayesha_hanna_male_ending_360bd14a:
    ayesha.say "Но, наверное, такие вещи не предугадаешь."

# ch/harems_full/sporty/events.rpy:1214
translate russian ayesha_hanna_male_ending_1a06ce2c:
    hanna.say "Эй, знаешь что!"

# ch/harems_full/sporty/events.rpy:1215
translate russian ayesha_hanna_male_ending_b13d78a9:
    hanna.say "Теперь мы семья."

# ch/harems_full/sporty/events.rpy:1216
translate russian ayesha_hanna_male_ending_a96ea115:
    hanna.say "Может, стоит подумать о пополнении?"

# ch/harems_full/sporty/events.rpy:1217
translate russian ayesha_hanna_male_ending_419f64ea:
    ayesha.say "Забавно, что ты заговорила об этом, Ханна."

# ch/harems_full/sporty/events.rpy:1218
translate russian ayesha_hanna_male_ending_76038f44:
    ayesha.say "Я как раз думала о том же."

# ch/harems_full/sporty/events.rpy:1219
translate russian ayesha_hanna_male_ending_340b9327:
    ayesha.say "[lssb_common.hero_name()] тоже должен участвовать в этом разговоре."

# ch/harems_full/sporty/events.rpy:1220
translate russian ayesha_hanna_male_ending_d166c8c6:
    hanna.say "А можем просто устроить ему сюрприз!"

# ch/harems_full/sporty/events.rpy:1222
translate russian ayesha_hanna_male_ending_46aacd01:
    ayesha.say "Ведь я никак не могла предугадать, что стану мамой!"

# ch/harems_full/sporty/events.rpy:1223
translate russian ayesha_hanna_male_ending_804c82c1:
    ayesha.say "И никогда не думала, что мой ребёнок окажется таким чудесным, как Эбигейл."

# ch/harems_full/sporty/events.rpy:1224
translate russian ayesha_hanna_male_ending_aef9f012:
    hanna.say "Вот уж точно, Айша."

# ch/harems_full/sporty/events.rpy:1225
translate russian ayesha_hanna_male_ending_c77f41c0:
    hanna.say "Она просто прелесть!"

# ch/harems_full/sporty/events.rpy:1227
translate russian ayesha_hanna_male_ending_9565e2c4:
    hanna.say "[lssb_common.hero_name()]-младший точно стал для меня неожиданностью."

# ch/harems_full/sporty/events.rpy:1228
translate russian ayesha_hanna_male_ending_1f0dc055:
    hanna.say "И с самого рождения не даёт мне перевести дух!"

# ch/harems_full/sporty/events.rpy:1229
translate russian ayesha_hanna_male_ending_c2b00598:
    ayesha.say "Вот уж точно, Ханна!"

# ch/harems_full/sporty/events.rpy:1230
translate russian ayesha_hanna_male_ending_7919f0a7:
    ayesha.say "Маленький сорванец!"

# ch/harems_full/sporty/events.rpy:1231
translate russian ayesha_hanna_male_ending_3b1f6103:
    ayesha.say "Думаю, мы обе можем признать, что нам повезло."

# ch/harems_full/sporty/events.rpy:1232
translate russian ayesha_hanna_male_ending_1dc145da:
    ayesha.say "Что [lssb_common.hero_name()] — отличный муж."

# ch/harems_full/sporty/events.rpy:1233
translate russian ayesha_hanna_male_ending_3328e012:
    hanna.say "Да, пожалуй."

# ch/harems_full/sporty/events.rpy:1234
translate russian ayesha_hanna_male_ending_343b2f48:
    hanna.say "Только ему не говори!"

# ch/harems_full/sporty/events.rpy:1235
translate russian ayesha_hanna_male_ending_c32cedf9:
    ayesha.say "Не волнуйся, не скажу!"
