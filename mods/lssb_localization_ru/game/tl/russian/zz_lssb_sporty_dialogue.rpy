# ch/harems_full/sporty/events.rpy:994
translate russian ayesha_hanna_propose_male_90474110_1:
    hanna.say "Умеешь же ты заставить девушку ждать!"

# ch/harems_full/sporty/events.rpy:996
translate russian ayesha_hanna_propose_male_94800173:
    ayesha.say "Ох, [lssb_common.hero_name()]..."

# ch/harems_full/sporty/events.rpy:997
translate russian ayesha_hanna_propose_male_7c4e83e3:
    ayesha.say "Я польщена, но не могу выйти замуж."

# ch/harems_full/sporty/events.rpy:998
translate russian ayesha_hanna_propose_male_f103b237:
    ayesha.say "Не сейчас, когда моя карьера на ринге в самом разгаре!"

# ch/harems_full/sporty/events.rpy:999
translate russian ayesha_hanna_propose_male_cb3db99e:
    "На миг мы с Ханной полны улыбок и счастья."

# ch/harems_full/sporty/events.rpy:1001
translate russian ayesha_hanna_propose_male_ba5e3182:
    "Но затем до нас доходит смысл слов Айши."

# ch/harems_full/sporty/events.rpy:1002
translate russian ayesha_hanna_propose_male_6b56db54:
    mike.say "Ты серьёзно, Айша?"

# ch/harems_full/sporty/events.rpy:1003
