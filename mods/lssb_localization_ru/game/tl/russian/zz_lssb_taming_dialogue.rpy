# Native Taming identifiers, current source catalog. Translation only.

# ch/harems_full/taming/events.rpy:191
translate russian kylie_attack_ayesha_74d5572a:
    "Может, прозвучит как самовосхваление, но в последнее время я хожу в зал с почти религиозной регулярностью."

# ch/harems_full/taming/events.rpy:192
translate russian kylie_attack_ayesha_95019139:
    "И всё же бывают особенно удачные дни, когда всю тренировку словно находишься в потоке."

# ch/harems_full/taming/events.rpy:193
translate russian kylie_attack_ayesha_a448175e:
    "Сегодня у меня именно такой день: клянусь, я уже физически ощущаю пользу от нагрузки."

# ch/harems_full/taming/events.rpy:194
translate russian kylie_attack_ayesha_8352dfe7:
    "И, положа руку на сердце, могу поклясться: дело вовсе не в близости Ханны."

# ch/harems_full/taming/events.rpy:196
translate russian kylie_attack_ayesha_eff6ca76:
    "Хотя, возможно, всё дело в присутствии Айши, а не дочери владельца..."

# ch/harems_full/taming/events.rpy:198
translate russian kylie_attack_ayesha_3a377953:
    "Даже когда мы не занимаемся один на один, вид моей любимой амазонки словно подстёгивает меня."

# ch/harems_full/taming/events.rpy:199
translate russian kylie_attack_ayesha_a11ce89a:
    "Айше достаточно посмотреть в мою сторону, и кажется, что я могу тренироваться с рассвета до заката без единой остановки!"

# ch/harems_full/taming/events.rpy:200
translate russian kylie_attack_ayesha_62bf3a8d:
    "Странно: до знакомства с ней я не думал, что настолько мускулистая женщина может меня привлечь."

# ch/harems_full/taming/events.rpy:202
translate russian kylie_attack_ayesha_ec2ed700:
    "Но стоит увидеть её в облегающем латексе, и я чувствую, как мой..."

# ch/harems_full/taming/events.rpy:203
translate russian kylie_attack_ayesha_204f22f4:
    "Ой! Я ведь собираюсь в душ, так что надо держать себя в руках!"

# ch/harems_full/taming/events.rpy:204
translate russian kylie_attack_ayesha_fef35c89:
    "Иначе лучше сразу под холодный..."

# ch/harems_full/taming/events.rpy:206
translate russian kylie_attack_ayesha_6cacbea3:
    "С этими мыслями я иду в мужскую раздевалку."

# ch/harems_full/taming/events.rpy:207
translate russian kylie_attack_ayesha_ed755ea6:
    "И всю дорогу пытаюсь думать о чём угодно, кроме тела Айши."

# ch/harems_full/taming/events.rpy:208
translate russian kylie_attack_ayesha_d40d8adc:
    "У самой двери что-то привлекает моё внимание."

# ch/harems_full/taming/events.rpy:209
translate russian kylie_attack_ayesha_2442553f:
    "Всего лишь светлые волосы, мелькнувшие краем глаза."

# ch/harems_full/taming/events.rpy:210
translate russian kylie_attack_ayesha_a1a972f8:
    "Но они что-то напоминают, и я никак не могу вспомнить что, пока собираюсь в душ."

# ch/harems_full/taming/events.rpy:211
translate russian kylie_attack_ayesha_7541d531:
    "Встав под струи воды, я вскоре всё забываю."

# ch/harems_full/taming/events.rpy:212
translate russian kylie_attack_ayesha_683e4b9c:
    "На этом бы всё и закончилось: случайная мысль, которая больше не вернётся."

# ch/harems_full/taming/events.rpy:213
translate russian kylie_attack_ayesha_9d281aff:
    "Я почти окончательно о ней забываю, когда слышу первый крик."

# ch/harems_full/taming/events.rpy:214
translate russian kylie_attack_ayesha_95886c64:
    "Резко поворачиваю голову, и ни для чего другого в мыслях больше нет места."

# ch/harems_full/taming/events.rpy:215
translate russian kylie_attack_ayesha_db73a026:
    "Не вижу, откуда он доносится, но понимаю: как минимум из соседнего помещения."

# ch/harems_full/taming/events.rpy:216
translate russian kylie_attack_ayesha_9ff353c3:
    "Инстинктивно спешу на звук и начинаю слышать ещё и громкие голоса."

# ch/harems_full/taming/events.rpy:217
translate russian kylie_attack_ayesha_ce8fe06a:
    kylie.say "Я тебя отделаю, сука!"

# ch/harems_full/taming/events.rpy:218
translate russian kylie_attack_ayesha_6ed4e81d:
    kylie.say "Распорю от одних губ до других!"

# ch/harems_full/taming/events.rpy:219
translate russian kylie_attack_ayesha_4633124f:
    ayesha.say "Да ну?"

# ch/harems_full/taming/events.rpy:220
translate russian kylie_attack_ayesha_7ac633ad:
    ayesha.say "Пока ты только болтаешь!"

# ch/harems_full/taming/events.rpy:221
translate russian kylie_attack_ayesha_0ffc3bb7:
    "Голоса определённо женские и доносятся из женской душевой!"

# ch/harems_full/taming/events.rpy:222
translate russian kylie_attack_ayesha_28ad424e:
    "Через несколько мгновений я вбегаю туда, едва не поскользнувшись на мокрой плитке."

# ch/harems_full/taming/events.rpy:224
translate russian kylie_attack_ayesha_7280c469:
    "И сразу узнаю светлые волосы, мелькнувшие по дороге в раздевалку."

# ch/harems_full/taming/events.rpy:225
translate russian kylie_attack_ayesha_eaf01b52:
    "Это Кайли. Она голая извивается на полу!"

# ch/harems_full/taming/events.rpy:226
translate russian kylie_attack_ayesha_168b304f:
    "Причём пытается вырваться из захвата другой, гораздо более крупной женщины."

# ch/harems_full/taming/events.rpy:227
translate russian kylie_attack_ayesha_e7b1a6c6:
    "Даже в суматохе и пару от горячей воды её невозможно с кем-то спутать."

# ch/harems_full/taming/events.rpy:228
translate russian kylie_attack_ayesha_3edcff09:
    "Кайли прижимает к полу не кто иная, как Айша."

# ch/harems_full/taming/events.rpy:229
translate russian kylie_attack_ayesha_14ccf4ff:
    "И надо сказать, справляется весьма неплохо!"

# ch/harems_full/taming/events.rpy:230
translate russian kylie_attack_ayesha_98dc1ce1:
    "Ноги Айши обхватывают Кайли поперёк тела, словно клещи."

# ch/harems_full/taming/events.rpy:231
translate russian kylie_attack_ayesha_9cec338c:
    "Руки не менее крепко сжимают её шею."

# ch/harems_full/taming/events.rpy:232
translate russian kylie_attack_ayesha_f119f7fa:
    "Кайли тщетно пытается вырваться из профессионального борцовского захвата."

# ch/harems_full/taming/events.rpy:234
translate russian kylie_attack_ayesha_dec958f2:
    "Но прямо у меня на глазах её лицо краснеет, а глаза начинают закатываться."

# ch/harems_full/taming/events.rpy:238
translate russian kylie_attack_ayesha_14b5f6ed:
    mike.say "Айша, какого чёрта ты делаешь?!"

# ch/harems_full/taming/events.rpy:239
translate russian kylie_attack_ayesha_b96b5e80:
    "Услышав мой голос, Айша устремляет взгляд на меня."

# ch/harems_full/taming/events.rpy:240
translate russian kylie_attack_ayesha_4c0f0728:
    "На миг мне кажется, что она слишком увлеклась и уже не ответит."

# ch/harems_full/taming/events.rpy:241
translate russian kylie_attack_ayesha_b3e45f01:
    "Но затем шумно выдыхает."

# ch/harems_full/taming/events.rpy:242
translate russian kylie_attack_ayesha_803843da:
    ayesha.say "Просто... уф... выношу... ар-р... мусор!"

# ch/harems_full/taming/events.rpy:243
translate russian kylie_attack_ayesha_f381bcc3:
    "Чтобы ответить, Айше приходится немного ослабить хватку."

# ch/harems_full/taming/events.rpy:244
translate russian kylie_attack_ayesha_23b1da28:
    "Я слышу судорожный вдох Кайли, и та начинает оправдываться."

# ch/harems_full/taming/events.rpy:245
translate russian kylie_attack_ayesha_0f02b57e:
    kylie.say "Помоги... [lssb_common.hero_name()]... она меня... душит!"

# ch/harems_full/taming/events.rpy:246
translate russian kylie_attack_ayesha_b550c1ab:
    "В суматохе я вижу только то, что Кайли вот-вот потеряет сознание."

# ch/harems_full/taming/events.rpy:247
translate russian kylie_attack_ayesha_d7d1cd94:
    mike.say "Айша, отпусти её! НЕМЕДЛЕННО!"

# ch/harems_full/taming/events.rpy:248
translate russian kylie_attack_ayesha_daf675d2:
    "Айша недоверчиво смотрит на меня, но всё же начинает отпускать."

# ch/harems_full/taming/events.rpy:249
translate russian kylie_attack_ayesha_ded822ff:
    ayesha.say "Тебя здесь не было, когда всё началось, [lssb_common.hero_name()]."

# ch/harems_full/taming/events.rpy:250
translate russian kylie_attack_ayesha_3552e75e:
    ayesha.say "Она сумасшедшая! Она пыталась меня убить!"

# ch/harems_full/taming/events.rpy:251
translate russian kylie_attack_ayesha_c8c65403:
    mike.say "И что?"

# ch/harems_full/taming/events.rpy:252
translate russian kylie_attack_ayesha_a147213e:
    mike.say "Теперь ты убьёшь её?"

# ch/harems_full/taming/events.rpy:253
translate russian kylie_attack_ayesha_fd1fa8ed:
    mike.say "Так, Айша?!"

# ch/harems_full/taming/events.rpy:260
translate russian kylie_attack_ayesha_964c8e65:
    "Айша наконец отпускает Кайли, и та поспешно отползает к противоположной стороне душевой."

# ch/harems_full/taming/events.rpy:261
translate russian kylie_attack_ayesha_720a394c:
    "Там она садится спиной к стене и прижимает ладонь к ушибленной шее."

# ch/harems_full/taming/events.rpy:263
translate russian kylie_attack_ayesha_d8a0718e:
    ayesha.say "НЕТ!"

# ch/harems_full/taming/events.rpy:265
translate russian kylie_attack_ayesha_b4363658:
    ayesha.say "Конечно, нет..."

# ch/harems_full/taming/events.rpy:267
translate russian kylie_attack_ayesha_feaccdde:
    mike.say "А с моей стороны выглядело именно так!"

# ch/harems_full/taming/events.rpy:269
translate russian kylie_attack_ayesha_218eb881:
    "Айша медленно поднимается и открывает рот, собираясь ответить."

# ch/harems_full/taming/events.rpy:271
translate russian kylie_attack_ayesha_ec7affb8:
    "Но затем отводит взгляд и качает головой, явно передумав."

# ch/harems_full/taming/events.rpy:273
translate russian kylie_attack_ayesha_8719a31f:
    "Она тут же сердито выходит из душевой, оставив меня с Кайли."

# ch/harems_full/taming/events.rpy:274
translate russian kylie_attack_ayesha_e67f5a92:
    "Я поворачиваюсь утешить Кайли, а она буквально бросается мне в объятия!"

# ch/harems_full/taming/events.rpy:278
translate russian kylie_attack_ayesha_e07345fc:
    kylie.say "О, [lssb_common.hero_name()], ты спас мне жизнь!"

# ch/harems_full/taming/events.rpy:279
translate russian kylie_attack_ayesha_33664b32:
    kylie.say "Мне было ТАК страшно!"

# ch/harems_full/taming/events.rpy:281
translate russian kylie_attack_ayesha_86843a15:
    mike.say "Ну-ну, Кайли."

# ch/harems_full/taming/events.rpy:282
translate russian kylie_attack_ayesha_7b035660:
    mike.say "Теперь ты в безопасности. Больше я не позволю ей тебя обидеть..."

# ch/harems_full/taming/events.rpy:283
translate russian kylie_attack_ayesha_16ead15a:
    "Только гладя Кайли по волосам и похлопывая по спине, я замечаю кое-что неуместное."

# ch/harems_full/taming/events.rpy:284
translate russian kylie_attack_ayesha_31d04a12:
    "Канцелярский нож на полу душевой."

# ch/harems_full/taming/events.rpy:285
translate russian kylie_attack_ayesha_705e5639:
    "Мысленно отмечаю: нужно спросить у Кайли, откуда он взялся, когда она успокоится."

# ch/harems_full/taming/events.rpy:286
translate russian kylie_attack_ayesha_6653464c:
    "Надеюсь только, что к тому времени не забуду..."

# ch/harems_full/taming/events.rpy:288
translate russian kylie_attack_ayesha_aa6279f7:
    "Я понимаю случившееся так ясно, будто сам присутствовал с самого начала."

# ch/harems_full/taming/events.rpy:289
translate russian kylie_attack_ayesha_04236041:
    "И мне не нужно объяснять, какую роль сыграл канцелярский нож в углу!"

# ch/harems_full/taming/events.rpy:290
translate russian kylie_attack_ayesha_676da941:
    mike.say "Айша, ты в порядке?!"

# ch/harems_full/taming/events.rpy:292
translate russian kylie_attack_ayesha_b96b5e80_1:
    "Услышав мой голос, Айша устремляет взгляд на меня."

# ch/harems_full/taming/events.rpy:293
translate russian kylie_attack_ayesha_4c0f0728_1:
    "На миг мне кажется, что она слишком увлеклась и уже не ответит."

# ch/harems_full/taming/events.rpy:294
translate russian kylie_attack_ayesha_b3e45f01_1:
    "Но затем шумно выдыхает."

# ch/harems_full/taming/events.rpy:295
translate russian kylie_attack_ayesha_803843da_1:
    ayesha.say "Просто... уф... выношу... ар-р... мусор!"

# ch/harems_full/taming/events.rpy:296
translate russian kylie_attack_ayesha_f381bcc3_1:
    "Чтобы ответить, Айше приходится немного ослабить хватку."

# ch/harems_full/taming/events.rpy:297
translate russian kylie_attack_ayesha_f4eab861:
    "Я слышу судорожный вдох Кайли, и та начинает оправдываться."

# ch/harems_full/taming/events.rpy:298
translate russian kylie_attack_ayesha_0f02b57e_1:
    kylie.say "Помоги... [lssb_common.hero_name()]... она меня... душит!"

# ch/harems_full/taming/events.rpy:299
translate russian kylie_attack_ayesha_bae2c7ad:
    mike.say "Да заткнись, Кайли!"

# ch/harems_full/taming/events.rpy:300
translate russian kylie_attack_ayesha_da12370d:
    mike.say "Или лучше не надо. Вырубись и сделай нам всем одолжение!"

# ch/harems_full/taming/events.rpy:301
translate russian kylie_attack_ayesha_7975b328:
    "Кайли недоверчиво смотрит на меня, раскрыв глаза шире, чем когда-либо."

# ch/harems_full/taming/events.rpy:302
translate russian kylie_attack_ayesha_358906dd:
    kylie.say "Она сумасшедшая, [lssb_common.hero_name()]! Она пытается меня убить!"

# ch/harems_full/taming/events.rpy:303
translate russian kylie_attack_ayesha_b563395b:
    mike.say "Конечно, Кайли, ага."

# ch/harems_full/taming/events.rpy:305
translate russian kylie_attack_ayesha_164722c0:
    mike.say "А ты, надо полагать, совершенно случайно оказалась здесь с ножом в руке?"

# ch/harems_full/taming/events.rpy:306
translate russian kylie_attack_ayesha_b17d6a1f:
    "Кайли снова пытается возражать, но я уже вижу, как её взгляд тускнеет."

# ch/harems_full/taming/events.rpy:307
translate russian kylie_attack_ayesha_16ae10d2:
    "Вскоре железная хватка Айши лишает её сознания."

# ch/harems_full/taming/events.rpy:308
translate russian kylie_attack_ayesha_7dec6042:
    "Айша разжимает захват, и бесчувственное тело Кайли падает на пол, а я спешу к Айше."

# ch/harems_full/taming/events.rpy:312
translate russian kylie_attack_ayesha_2caa6a98:
    mike.say "Айша, ты в порядке?"

# ch/harems_full/taming/events.rpy:313
translate russian kylie_attack_ayesha_ed5c207a:
    "Она тяжело дышит от напряжения."

# ch/harems_full/taming/events.rpy:315
translate russian kylie_attack_ayesha_77469dc2:
    "Но, повернувшись ко мне, всё же криво улыбается."

# ch/harems_full/taming/events.rpy:317
translate russian kylie_attack_ayesha_0c6457e7:
    ayesha.say "Да, всё хорошо, [lssb_common.hero_name()]."

# ch/harems_full/taming/events.rpy:318
translate russian kylie_attack_ayesha_30ce8070:
    ayesha.say "Я не дала ей пустить нож в ход."

# ch/harems_full/taming/events.rpy:320
translate russian kylie_attack_ayesha_ed21a2e4:
    mike.say "Айша, НИКОГДА больше так не делай."

# ch/harems_full/taming/events.rpy:321
translate russian kylie_attack_ayesha_8c178a61:
    mike.say "Понимаешь?"

# ch/harems_full/taming/events.rpy:322
translate russian kylie_attack_ayesha_dcccda36:
    "Айша явно не ожидала, что я заговорю с такой силой."

# ch/harems_full/taming/events.rpy:324
translate russian kylie_attack_ayesha_44ce324e:
    ayesha.say "П-почему, [lssb_common.hero_name()]?"

# ch/harems_full/taming/events.rpy:325
translate russian kylie_attack_ayesha_6dfe98a9:
    ayesha.say "Ты злишься, что я причинила ей боль?"

# ch/harems_full/taming/events.rpy:327
translate russian kylie_attack_ayesha_9f83162d:
    mike.say "Нет, Айша, дело совсем не в этом."

# ch/harems_full/taming/events.rpy:328
translate russian kylie_attack_ayesha_51076a0d:
    mike.say "Просто не могу вынести мысли, что кто-то причинит тебе боль!"

# ch/harems_full/taming/events.rpy:330
translate russian kylie_attack_ayesha_96f5476c:
    "Теперь она и правда потрясена: её глаза широко раскрываются от удивления."

# ch/harems_full/taming/events.rpy:331
translate russian kylie_attack_ayesha_05980c3b:
    "Она нежно прижимается лбом к моему лбу, и мы стоим вместе под струями душа..."

# ch/harems_full/taming/events.rpy:333
translate russian kylie_attack_ayesha_1b58191f:
    "Понятия не имею, что здесь происходит и как вообще могло дойти до такого безумия."

# ch/harems_full/taming/events.rpy:334
translate russian kylie_attack_ayesha_0ffaeee0:
    "Остаётся лишь недоверчиво покачать головой и потребовать объяснений."

# ch/harems_full/taming/events.rpy:335
translate russian kylie_attack_ayesha_1cb48b45:
    mike.say "Чёрт, да что тут вообще происходит?"

# ch/harems_full/taming/events.rpy:336
translate russian kylie_attack_ayesha_b96b5e80_2:
    "Услышав мой голос, Айша устремляет взгляд на меня."

# ch/harems_full/taming/events.rpy:337
translate russian kylie_attack_ayesha_4c0f0728_2:
    "На миг мне даже кажется, что она слишком разошлась, чтобы ответить."

# ch/harems_full/taming/events.rpy:338
translate russian kylie_attack_ayesha_b3e45f01_2:
    "Но затем она с шумом выдыхает."

# ch/harems_full/taming/events.rpy:339
translate russian kylie_attack_ayesha_803843da_2:
    ayesha.say "Просто... ух... выношу... ар-р... мусор!"

# ch/harems_full/taming/events.rpy:340
translate russian kylie_attack_ayesha_f381bcc3_2:
    "Отвечая мне, Айша вынуждена немного ослабить хватку."

# ch/harems_full/taming/events.rpy:341
translate russian kylie_attack_ayesha_23b1da28_1:
    "Кайли судорожно втягивает воздух и начинает оправдываться."

# ch/harems_full/taming/events.rpy:342
translate russian kylie_attack_ayesha_0f02b57e_2:
    kylie.say "Помоги мне... [lssb_common.hero_name()]... она меня... душит!"

# ch/harems_full/taming/events.rpy:343
translate russian kylie_attack_ayesha_e5f5fe3a:
    "Я раздражённо качаю головой, не веря до конца ни одной из них."

# ch/harems_full/taming/events.rpy:344
translate russian kylie_attack_ayesha_3f97a42f:
    mike.say "Айша, отпусти её. Сейчас же!"

# ch/harems_full/taming/events.rpy:345
translate russian kylie_attack_ayesha_b6b5c097:
    mike.say "А ты, Кайли, тоже помолчи!"

# ch/harems_full/taming/events.rpy:346
translate russian kylie_attack_ayesha_e3cb12bf:
    "Айша уступает и выпускает Кайли из захвата."

# ch/harems_full/taming/events.rpy:352
translate russian kylie_attack_ayesha_a47b665d:
    "Едва освободившись, Кайли поспешно отползает в дальний конец душевой."

# ch/harems_full/taming/events.rpy:353
translate russian kylie_attack_ayesha_b63aee3f:
    "Она прижимается спиной к стене, держась за пострадавшее горло."

# ch/harems_full/taming/events.rpy:354
translate russian kylie_attack_ayesha_5ecaab39:
    mike.say "Теперь кто-нибудь из вас объяснит, что произошло НА САМОМ ДЕЛЕ?"

# ch/harems_full/taming/events.rpy:356
translate russian kylie_attack_ayesha_ed3c69a4:
    kylie.say "У меня не было выбора, [lssb_common.hero_name()]."

# ch/harems_full/taming/events.rpy:358
translate russian kylie_attack_ayesha_f54bc87a:
    kylie.say "Она пытается тебя у меня отнять!"

# ch/harems_full/taming/events.rpy:360
translate russian kylie_attack_ayesha_a8843ce7:
    "Кайли почти выкрикивает эти слова, умоляя меня встать на её сторону."

# ch/harems_full/taming/events.rpy:361
translate russian kylie_attack_ayesha_13f5dc06:
    "Айша качает головой: такое объяснение её явно не убеждает."

# ch/harems_full/taming/events.rpy:363
translate russian kylie_attack_ayesha_a21e899a:
    ayesha.say "Если тебе приходится устранять соперниц ножом, ты уже проиграла, сука!"

# ch/harems_full/taming/events.rpy:365
translate russian kylie_attack_ayesha_67c80c59:
    mike.say "Погодите-ка..."

# ch/harems_full/taming/events.rpy:366
translate russian kylie_attack_ayesha_f3277073:
    mike.say "Вы что, дерётесь из-за меня?"

# ch/harems_full/taming/events.rpy:368
translate russian kylie_attack_ayesha_602cda91:
    kylie.say "ДА!"

# ch/harems_full/taming/events.rpy:371
translate russian kylie_attack_ayesha_d8a0718e_1:
    ayesha.say "НЕТ!"

# ch/harems_full/taming/events.rpy:373
translate russian kylie_attack_ayesha_68e4aee8:
    ayesha.say "Ну... в каком-то смысле... наверное..."

# ch/harems_full/taming/events.rpy:375
translate russian kylie_attack_ayesha_817ca8bc:
    mike.say "Вы ведь обе знаете, что в нашей стране недавно узаконили многожёнство?"

# ch/harems_full/taming/events.rpy:377
translate russian kylie_attack_ayesha_d08221ef:
    kylie.say "Ну... да..."

# ch/harems_full/taming/events.rpy:380
translate russian kylie_attack_ayesha_7df836df:
    ayesha.say "И какое это имеет отношение к делу?"

# ch/harems_full/taming/events.rpy:382
translate russian kylie_attack_ayesha_acdad069:
    mike.say "Вы можете делить меня. Научиться ладить друг с другом."

# ch/harems_full/taming/events.rpy:383
translate russian kylie_attack_ayesha_8a5af64d:
    "Словно почуяв возможность взять верх, Кайли тут же хватается за моё предложение."

# ch/harems_full/taming/events.rpy:385
translate russian kylie_attack_ayesha_fcef6efb:
    kylie.say "Я смогу, [lssb_common.hero_name()], вот увидишь!"

# ch/harems_full/taming/events.rpy:388
translate russian kylie_attack_ayesha_e5370146:
    ayesha.say "Что... да погоди ты, чёрт возьми!"

# ch/harems_full/taming/events.rpy:390
translate russian kylie_attack_ayesha_6589dc23:
    mike.say "Значит, договорились?"

# ch/harems_full/taming/events.rpy:392
translate russian kylie_attack_ayesha_d668db62:
    mike.say "Кайли, больше никаких безумных выходок."

# ch/harems_full/taming/events.rpy:393
translate russian kylie_attack_ayesha_ab086941:
    mike.say "Айша, больше никакого насилия."

# ch/harems_full/taming/events.rpy:394
translate russian kylie_attack_ayesha_1d3265a7:
    mike.say "С этого момента мы — счастливая троица!"

# ch/harems_full/taming/events.rpy:395
translate russian kylie_attack_ayesha_a170a68a:
    mike.say "Ведь любить — значит делиться. Повторите!"

# ch/harems_full/taming/events.rpy:397
translate russian kylie_attack_ayesha_2a6c5aa0:
    "Кайли улыбается, радостно кивает и хлопает в ладоши."

# ch/harems_full/taming/events.rpy:399
translate russian kylie_attack_ayesha_013baa26:
    kylie.say "Конечно, [lssb_common.hero_name()]! Любить — значит делиться!"

# ch/harems_full/taming/events.rpy:402
translate russian kylie_attack_ayesha_5df4fc8e:
    "Айша растерянно качает головой, словно сама толком не понимает, что сейчас произошло."

# ch/harems_full/taming/events.rpy:404
translate russian kylie_attack_ayesha_d2fbc339:
    ayesha.say "Э-э... делиться — значит любить... наверное..."

# ch/harems_full/taming/events.rpy:406
translate russian kylie_attack_ayesha_4cde4b6b:
    "Но всё же я замечаю, что прямо отвергать эту идею она тоже не спешит..."

# ch/harems_full/taming/events.rpy:421
translate russian taming_event_1_a9b711e0:
    "Учитывая, как начались наши отношения, подозреваю, что между Айшей и Кайли ещё осталась некоторая напряжённость."

# ch/harems_full/taming/events.rpy:422
translate russian taming_event_1_11e22ae1:
    "Но даже столь бурное знакомство не мешает им со временем научиться ладить."

# ch/harems_full/taming/events.rpy:423
translate russian taming_event_1_d75f2227:
    "Поэтому я решаю, что нам троим нужно как можно скорее начать вести себя как обычная троица влюблённых."

# ch/harems_full/taming/events.rpy:424
translate russian taming_event_1_23fd85c5:
    "С этой целью беру на себя заказ столика в одном из хороших городских ресторанов."

# ch/harems_full/taming/events.rpy:425
translate russian taming_event_1_51ada010:
    "А возражения Айши и Кайли даже не принимаются..."

# ch/harems_full/taming/events.rpy:426
translate russian taming_event_1_f69bb164:
    "В назначенный день я договариваюсь встретиться с ними прямо в ресторане."

# ch/harems_full/taming/events.rpy:427
translate russian taming_event_1_4a9e1f04:
    "Думаю, так мы все окажемся в равных условиях и вероятность ссоры будет меньше."

# ch/harems_full/taming/events.rpy:428
translate russian taming_event_1_e141d35f:
    "Но тут мне приходит в голову: это же отличная возможность дать Айше и Кайли немного побыть вдвоём."

# ch/harems_full/taming/events.rpy:429
translate russian taming_event_1_aa225d55:
    "Поэтому я нарочно прихожу чуть позже оговорённого времени."

# ch/harems_full/taming/events.rpy:431
translate russian taming_event_1_1c14d6a4:
    "Когда я наконец появляюсь, обе девушки сидят за столиком в ледяном молчании."

# ch/harems_full/taming/events.rpy:432
translate russian taming_event_1_3313be1b:
    "Кайли упёрла руки в бока, а Айша скрестила их на груди."

# ch/harems_full/taming/events.rpy:433
translate russian taming_event_1_c2856c91:
    "Сейчас они молчат, но у меня стойкое ощущение, что только что между ними произошла жаркая перепалка."

# ch/harems_full/taming/events.rpy:434
translate russian taming_event_1_34743cfc:
    "Будь я менее умудрён жизнью, сразу спросил бы, что случилось."

# ch/harems_full/taming/events.rpy:438
translate russian taming_event_1_879ac84c:
    "Но раз ни одна не собирается меня просвещать, я с чистой совестью делаю вид, что ничего не замечаю."

# ch/harems_full/taming/events.rpy:439
translate russian taming_event_1_265d92de:
    mike.say "Привет, девушки!"

# ch/harems_full/taming/events.rpy:440
translate russian taming_event_1_9b6225c4:
    "Заметили, что я обращаюсь сразу к обеим?"

# ch/harems_full/taming/events.rpy:441
translate russian taming_event_1_a7a66dfc:
    "Так ни одна не решит, будто я ценю её больше другой."

# ch/harems_full/taming/events.rpy:442
translate russian taming_event_1_f8a558bb:
    "Да меня хоть сейчас в дипломаты!"

# ch/harems_full/taming/events.rpy:444
translate russian taming_event_1_b3970fd1:
    ayesha.say "Привет, [lssb_common.hero_name()]."

# ch/harems_full/taming/events.rpy:447
translate russian taming_event_1_494dbfeb:
    kylie.say "О, привет, [lssb_common.hero_name()]."

# ch/harems_full/taming/events.rpy:449
translate russian taming_event_1_21fe1011:
    kylie.say "Наконец-то ты пришёл!"

# ch/harems_full/taming/events.rpy:451
translate russian taming_event_1_addc4ee2:
    "Ну, нетрудно догадаться, кому сегодня достанется награда за показную милоту и доброжелательность!"

# ch/harems_full/taming/events.rpy:452
translate russian taming_event_1_aeb0b593:
    mike.say "Простите, что немного опоздал."

# ch/harems_full/taming/events.rpy:453
translate russian taming_event_1_61a895b9:
    mike.say "Я уже выходил, но вдруг возникло одно дело!"

# ch/harems_full/taming/events.rpy:455
translate russian taming_event_1_b8522a5b:
    "Кайли хмурится и слегка надувает губы: ей явно неприятно, что что-то в моей жизни оказалось важнее неё."

# ch/harems_full/taming/events.rpy:457
translate russian taming_event_1_950d621b:
    kylie.say "Ой, ничего страшного, [lssb_common.hero_name()]."

# ch/harems_full/taming/events.rpy:458
translate russian taming_event_1_8e45ae32:
    kylie.say "Главное, что теперь ты здесь!"

# ch/harems_full/taming/events.rpy:460
translate russian taming_event_1_a42c54ff:
    "Словно чувствуя, что соперница её обходит, Айша слабо улыбается мне."

# ch/harems_full/taming/events.rpy:462
translate russian taming_event_1_cf239c9f:
    ayesha.say "Я тоже рада тебя видеть, [lssb_common.hero_name()]."

# ch/harems_full/taming/events.rpy:463
translate russian taming_event_1_6d14143f:
    ayesha.say "Но ты ведь и так это знаешь?"

# ch/harems_full/taming/events.rpy:465
translate russian taming_event_1_25b3d168:
    "Я киваю и улыбаюсь, прекрасно понимая, что Айша говорит искренне."

# ch/harems_full/taming/events.rpy:466
translate russian taming_event_1_865fb483:
    mike.say "По-моему, это я должен вас благодарить, девушки."

# ch/harems_full/taming/events.rpy:467
translate russian taming_event_1_fff32b24:
    mike.say "Сегодня вы обе так хороши, что я чувствую себя самым счастливым парнем на свете!"

# ch/harems_full/taming/events.rpy:470
translate russian taming_event_1_a3275837:
    "Кайли, более привычная к таким комплиментам, тут же довольно расцветает."

# ch/harems_full/taming/events.rpy:471
translate russian taming_event_1_309c4012:
    "А вот Айша смущённо улыбается и отводит взгляд."

# ch/harems_full/taming/events.rpy:472
translate russian taming_event_1_dece87bd:
    "И всё же похвала явно трогает её и доставляет удовольствие, несмотря на заметное смущение."

# ch/harems_full/taming/events.rpy:473
translate russian taming_event_1_0389827d:
    mike.say "В общем..."

# ch/harems_full/taming/events.rpy:474
translate russian taming_event_1_cc107f7d:
    mike.say "От этих хвалебных речей у меня уже в горле пересохло."

# ch/harems_full/taming/events.rpy:475
translate russian taming_event_1_4a497550:
    mike.say "Давайте закажем что-нибудь выпить?"

# ch/harems_full/taming/events.rpy:478
translate russian taming_event_1_2880f67b:
    "При упоминании алкоголя Кайли радостно хлопает в ладоши."

# ch/harems_full/taming/events.rpy:479
translate russian taming_event_1_019a96fd:
    "Айша согласно кивает. Кажется, ей не помешает выпить, чтобы немного успокоиться."

# ch/harems_full/taming/events.rpy:480
translate russian taming_event_1_ad6b5d4d:
    "Оглядывая зал, я привлекаю внимание оказавшейся поблизости официантки."

# ch/harems_full/taming/events.rpy:481
translate russian taming_event_1_e6a0fcf1:
    "Она тут же кивает: опыт подсказывает ей, чего от неё хотят."

# ch/harems_full/taming/events.rpy:482
translate russian taming_event_1_99dcd393:
    "Клянусь, пока она была в другом конце зала, я этого не заметил."

# ch/harems_full/taming/events.rpy:483
translate russian taming_event_1_b071da24:
    "Но стоит официантке подойти к столу, становится ясно: она чертовски симпатичная."

# ch/harems_full/taming/events.rpy:484
translate russian taming_event_1_72c9ee05:
    "Не поймите неправильно: сейчас меня не интересует никто, кроме Айши и Кайли."

# ch/harems_full/taming/events.rpy:485
translate russian taming_event_1_78c64243:
    "Просто отрицать очевидное я тоже не собираюсь."

# ch/harems_full/taming/events.rpy:486
translate russian taming_event_1_88b2f625:
    "Официантка" "Добрый вечер, сэр... и дамы..."

# ch/harems_full/taming/events.rpy:487
translate russian taming_event_1_8c024100:
    "Официантка" "Желаете ознакомиться с картой напитков?"

# ch/harems_full/taming/events.rpy:490
translate russian taming_event_1_2a9069c4:
    "Я вижу, как Айша и Кайли напрягаются: официантка упомянула их словно между прочим."

# ch/harems_full/taming/events.rpy:491
translate russian taming_event_1_8127e51f:
    "И только усугубляет эту оплошность, вручая карту вин мне, а остальные бросая на стол, чтобы девушки взяли их сами."

# ch/harems_full/taming/events.rpy:492
translate russian taming_event_1_e27afcd2:
    "Официантка" "Позвольте, сэр?"

# ch/harems_full/taming/events.rpy:493
translate russian taming_event_1_04df28dd:
    "Официантка" "Сегодня у нас есть несколько весьма достойных предложений..."

# ch/harems_full/taming/events.rpy:494
translate russian taming_event_1_22fb3bae:
    "Официантка наклоняется совсем близко, показывая названные напитки в карте."

# ch/harems_full/taming/events.rpy:495
translate russian taming_event_1_520068d7:
    "Она так близко, что я чувствую её духи и почти ощущаю прикосновение волос к лицу..."

# ch/harems_full/taming/events.rpy:497
translate russian taming_event_1_031c24c8:
    kylie.say "Уф..."

# ch/harems_full/taming/events.rpy:498
translate russian taming_event_1_669860ec:
    kylie.say "Может, сразу предложишь себя на горячее?!"

# ch/harems_full/taming/events.rpy:499
translate russian taming_event_1_b4aa9b38:
    kylie.say "Или таких недожаренных шлюшек тут не подают?!"

# ch/harems_full/taming/events.rpy:501
translate russian taming_event_1_ed432c63:
    "Официантка резко отшатывается, явно задетая неожиданным выпадом Кайли."

# ch/harems_full/taming/events.rpy:502
translate russian taming_event_1_ad48a8b9:
    "Я вижу, что Кайли уже вцепилась в сумочку, и гадаю, прихватила ли она сегодня канцелярский нож..."

# ch/harems_full/taming/events.rpy:507
translate russian taming_event_1_7ead4556:
    ayesha.say "Эй, да успокойся ты, чёрт..."

# ch/harems_full/taming/events.rpy:509
translate russian taming_event_1_94abcf49:
    "Айша резко поворачивает голову и удивлённо смотрит на меня."

# ch/harems_full/taming/events.rpy:510
translate russian taming_event_1_c8f209ad:
    "Но я не отпускаю её запястье, за которое только что схватил под столом."

# ch/harems_full/taming/events.rpy:511
translate russian taming_event_1_ed5b4ce8:
    "Затем быстро качаю головой, давая понять, что хочу, чтобы она не вмешивалась."

# ch/harems_full/taming/events.rpy:512
translate russian taming_event_1_da2f5384:
    "Похоже, Айша сейчас вырвет руку и проигнорирует мою просьбу."

# ch/harems_full/taming/events.rpy:514
translate russian taming_event_1_dd8bb5b7:
    "Но затем она кивает, и я чувствую, как она всем телом расслабляется."

# ch/harems_full/taming/events.rpy:515
translate russian taming_event_1_dfd8546e:
    "А тем временем представление только начинается."

# ch/harems_full/taming/events.rpy:516
translate russian taming_event_1_8282ca0e:
    "Официантка" "Я... я..."

# ch/harems_full/taming/events.rpy:520
translate russian taming_event_1_4b12f155:
    kylie.say "Что такое, сука?"

# ch/harems_full/taming/events.rpy:521
translate russian taming_event_1_6b966bce:
    kylie.say "Ещё секунду назад ты вполне бойко болтала с моим парнем!"

# ch/harems_full/taming/events.rpy:523
translate russian taming_event_1_15b19ece:
    "Кайли поднимается со стула и наклоняется к официантке так же близко, как та наклонялась ко мне."

# ch/harems_full/taming/events.rpy:524
translate russian taming_event_1_044c7301:
    "Затем шипит прямо в ухо бедной дрожащей девушке."

# ch/harems_full/taming/events.rpy:526
translate russian taming_event_1_2049cc66:
    kylie.say "А теперь слушай меня, маленькая шлюха."

# ch/harems_full/taming/events.rpy:527
translate russian taming_event_1_9837652f:
    kylie.say "Своим языком ты будешь говорить только «да» и «нет»."

# ch/harems_full/taming/events.rpy:528
translate russian taming_event_1_8bb33722:
    kylie.say "И только когда к тебе обращаются. Иначе я тебе его отрежу!"

# ch/harems_full/taming/events.rpy:530
translate russian taming_event_1_44af427d:
    "Официантка едва не подпрыгивает от страха, съёживается и кивает."

# ch/harems_full/taming/events.rpy:532
translate russian taming_event_1_cbdf9b3d:
    "Вдруг вся ненависть и злоба словно исчезают с лица Кайли."

# ch/harems_full/taming/events.rpy:534
translate russian taming_event_1_1749d834:
    "Садясь на место, она уже сияет улыбкой, будто ничего не случилось."

# ch/harems_full/taming/events.rpy:535
translate russian taming_event_1_2ee0b1c0:
    "Айша смотрит на меня широко раскрытыми от изумления глазами."

# ch/harems_full/taming/events.rpy:536
translate russian taming_event_1_91b67a93:
    "Мне остаётся лишь пожать плечами и вновь уткнуться в карту вин."

# ch/harems_full/taming/events.rpy:540
translate russian taming_event_1_1507365a:
    ayesha.say "Эй, да успокойся ты, чёрт возьми, Кайли!"

# ch/harems_full/taming/events.rpy:542
translate russian taming_event_1_17ea6d05:
    "Кайли мгновенно забывает об официантке и переключает всё внимание на Айшу."

# ch/harems_full/taming/events.rpy:543
translate russian taming_event_1_d08e182d:
    "Бедняжка чуть ли не отшатывается, словно её только что освободили из чьей-то хватки."

# ch/harems_full/taming/events.rpy:544
translate russian taming_event_1_ac277ad4:
    "Но я слежу лишь за столкновением, которое вот-вот разразится прямо передо мной."

# ch/harems_full/taming/events.rpy:546
translate russian taming_event_1_ae64e778:
    kylie.say "Что, позволить этой маленькой шлюхе флиртовать с ним? [lssb_common.hero_name()] — наш парень!"

# ch/harems_full/taming/events.rpy:547
translate russian taming_event_1_5b57adc4:
    kylie.say "Она делает это прямо у нас под носом, Айша!"

# ch/harems_full/taming/events.rpy:548
translate russian taming_event_1_6a94b6d0:
    kylie.say "Её нужно поставить на место..."

# ch/harems_full/taming/events.rpy:550
translate russian taming_event_1_958badbb:
    "Рука Кайли тянется к сумочке, практически подтверждая мои опасения насчёт канцелярского ножа."

# ch/harems_full/taming/events.rpy:552
translate russian taming_event_1_e960ef0a:
    "К счастью для всех присутствующих, Айша тоже это замечает."

# ch/harems_full/taming/events.rpy:554
translate russian taming_event_1_57b2f357:
    "Кайли и опомниться не успевает, как более крупная девушка стремительно хватает её за запястье."

# ch/harems_full/taming/events.rpy:556
translate russian taming_event_1_bfc46258:
    kylie.say "ЭЙ!"

# ch/harems_full/taming/events.rpy:557
translate russian taming_event_1_53e85bfe:
    kylie.say "ДА ПОШЛА ТЫ НА..."

# ch/harems_full/taming/events.rpy:562
translate russian taming_event_1_3a7a8c13:
    "Айша обрывает её, прикрыв ей рот второй рукой."

# ch/harems_full/taming/events.rpy:563
translate russian taming_event_1_ea361376:
    "Кайли вырывается и издаёт приглушённые звуки, за которыми, вероятно, скрывается самая грязная ругань."

# ch/harems_full/taming/events.rpy:564
translate russian taming_event_1_5398b512:
    "Но Айшу это нисколько не беспокоит: она всё это время лишь улыбается ей."

# ch/harems_full/taming/events.rpy:566
translate russian taming_event_1_ffb307af:
    ayesha.say "Простите, мисс."

# ch/harems_full/taming/events.rpy:567
translate russian taming_event_1_538f2e34:
    ayesha.say "Моя спутница не слишком хорошо знакома с правилами поведения в обществе."

# ch/harems_full/taming/events.rpy:569
translate russian taming_event_1_d39f62aa:
    "Официантка, похоже, не знает, как реагировать на разыгравшуюся перед ней сцену."

# ch/harems_full/taming/events.rpy:570
translate russian taming_event_1_c91ce2c6:
    "Она нервно улыбается и смеётся."

# ch/harems_full/taming/events.rpy:571
translate russian taming_event_1_b5d1ca8c:
    "Но по её глазам видно: Айша, пожалуй, напугала её ещё сильнее!"

# ch/harems_full/taming/events.rpy:572
translate russian taming_event_1_dc0ad082:
    mike.say "Может, дадите нам пару минут ознакомиться с картой?"

# ch/harems_full/taming/events.rpy:573
translate russian taming_event_1_4e5309e1:
    "Я поднимаю карту вин и улыбаюсь официантке как можно приветливее."

# ch/harems_full/taming/events.rpy:575
translate russian taming_event_1_f917d178:
    "Она кивает и поспешно уходит, стараясь оказаться подальше, прежде чем Айша отпустит Кайли."

# ch/harems_full/taming/events.rpy:579
translate russian taming_event_1_90ce5a70:
    "Я резко протягиваю руку и хватаю Кайли за запястье."

# ch/harems_full/taming/events.rpy:580
translate russian taming_event_1_9c7dba43:
    "Затем отвожу её руку под стол, не давая залезть в сумочку."

# ch/harems_full/taming/events.rpy:581
translate russian taming_event_1_8d6fe96f:
    "Но секунду спустя замечаю, что Айша подаётся к ней, и хватаю за запястье её тоже."

# ch/harems_full/taming/events.rpy:582
translate russian taming_event_1_c5060e1a:
    "Удерживая обеих и завладев всем их вниманием, я сурово смотрю на них через стол."

# ch/harems_full/taming/events.rpy:586
translate russian taming_event_1_eb24d1d2:
    kylie.say "Эй!"

# ch/harems_full/taming/events.rpy:589
translate russian taming_event_1_a85d7201:
    ayesha.say "[lssb_common.hero_name()], ты чего?!"

# ch/harems_full/taming/events.rpy:591
translate russian taming_event_1_9d093ee4:
    mike.say "Простите, мисс."

# ch/harems_full/taming/events.rpy:592
translate russian taming_event_1_b7079890:
    mike.say "Похоже, мои спутницы забыли, как вести себя за столом."

# ch/harems_full/taming/events.rpy:593
translate russian taming_event_1_859c848f:
    mike.say "Не оставите нас на пару минут?"

# ch/harems_full/taming/events.rpy:594
translate russian taming_event_1_7f9be4fb:
    mike.say "Уверен, к тому времени мы уже выберем напитки."

# ch/harems_full/taming/events.rpy:596
translate russian taming_event_1_4c1a78d4:
    "Официантка кивает и улыбается."

# ch/harems_full/taming/events.rpy:597
translate russian taming_event_1_14e5a980:
    "Но по глазам видно, что она с радостью оставит нас в покое."

# ch/harems_full/taming/events.rpy:598
translate russian taming_event_1_94af21e2:
    "Как только она уходит, я отпускаю руки Айши и Кайли."

# ch/harems_full/taming/events.rpy:599
translate russian taming_event_1_c43f75ef:
    mike.say "Вы не хотите объяснить, что это, блядь, было?"

# ch/harems_full/taming/events.rpy:601
translate russian taming_event_1_c74cd759:
    kylie.say "Она с тобой флиртовала!"

# ch/harems_full/taming/events.rpy:603
translate russian taming_event_1_3955fecb:
    "Кайли произносит это жалобным голосом и демонстративно потирает запястье."

# ch/harems_full/taming/events.rpy:605
translate russian taming_event_1_cea7212f:
    ayesha.say "А ОНА собиралась её за это порезать!"

# ch/harems_full/taming/events.rpy:607
translate russian taming_event_1_f93fe3cc:
    "А сама Айша выглядит так, будто готова убить Кайли — с канцелярским ножом или без!"

# ch/harems_full/taming/events.rpy:608
translate russian taming_event_1_b7d8f817:
    "Терпеть не могу разыгрывать из себя главного."

# ch/harems_full/taming/events.rpy:609
translate russian taming_event_1_977c693f:
    "Но какой ещё выбор они мне оставили?"

# ch/harems_full/taming/events.rpy:610
translate russian taming_event_1_72a99437:
    mike.say "Кайли, мы ведь договорились, что больше никаких безумных выходок?"

# ch/harems_full/taming/events.rpy:612
translate russian taming_event_1_091fdd6d:
    kylie.say "Да, но..."

# ch/harems_full/taming/events.rpy:614
translate russian taming_event_1_2d774780:
    mike.say "Нет! Никаких «но»!"

# ch/harems_full/taming/events.rpy:615
translate russian taming_event_1_d96ca59c:
    mike.say "Не хватало мне ещё появляться на людях с Джеком-потрошителем в трусиках!"

# ch/harems_full/taming/events.rpy:617
translate russian taming_event_1_c0aef2f2:
    "Услышав смешок Айши, я тут же переключаюсь на неё."

# ch/harems_full/taming/events.rpy:618
translate russian taming_event_1_3a79c573:
    mike.say "А ты что собиралась с ней сделать, Айша?"

# ch/harems_full/taming/events.rpy:619
translate russian taming_event_1_f63714d7:
    mike.say "Проломить ею этот чёртов стол?!"

# ch/harems_full/taming/events.rpy:620
translate russian taming_event_1_0cd8d16f:
    mike.say "Прибереги такие приёмы для ринга, ладно?"

# ch/harems_full/taming/events.rpy:622
translate russian taming_event_1_dd45bdf7:
    "Я перевожу взгляд с одной на другую и не успокаиваюсь, пока обе нехотя не кивают."

# ch/harems_full/taming/events.rpy:625
translate russian taming_event_1_d1182f81:
    "Когда сцена наконец заканчивается, всё ещё встревоженная официантка возвращается принять заказ."

# ch/harems_full/taming/events.rpy:626
translate russian taming_event_1_f9879751:
    "Айша и Кайли ещё обмениваются колкими взглядами через стол, но боевые действия, кажется, закончились."

# ch/harems_full/taming/events.rpy:629
translate russian taming_event_1_c9310a1e:
    "Учитывая обстоятельства, остаток вечера проходит довольно хорошо. Мы почти похожи на совершенно обычную троицу."

# ch/harems_full/taming/events.rpy:630
translate russian taming_event_1_ea677c43:
    "Из чувства вины я оставляю щедрые чаевые, но утешаюсь тем, что заставляю Айшу и Кайли тоже скинуться."

# ch/harems_full/taming/events.rpy:637
translate russian taming_event_1_repeated_ea5e6ae7:
    "Признаюсь, после прошлого свидания я немного опасался, что Кайли и Айша устроят повторное представление."

# ch/harems_full/taming/events.rpy:638
translate russian taming_event_1_repeated_9f1a82d1:
    "Но, несмотря на все вечерние происшествия, закончилось всё хорошо, и мы решили попробовать ещё раз."

# ch/harems_full/taming/events.rpy:639
translate russian taming_event_1_repeated_56192e27:
    "Вот так я снова направляюсь в наш местный ресторан."

# ch/harems_full/taming/events.rpy:640
translate russian taming_event_1_repeated_bb46869f:
    "Молю все высшие силы, чтобы на этот раз Айша и Кайли вели себя прилично."

# ch/harems_full/taming/events.rpy:642
translate russian taming_event_1_repeated_0402c0af:
    "Ещё одной такой вспышки Кайли мне точно не нужно. Возможно, стоит поискать другой способ обуздать её «энтузиазм»..."

# ch/harems_full/taming/events.rpy:644
translate russian taming_event_1_repeated_f97c8e8f:
    "Хотя в прошлый раз Айша справилась с Кайли весьма впечатляюще. Может, стоит чаще позволять ей держать Кайли в узде."

# ch/harems_full/taming/events.rpy:646
translate russian taming_event_1_repeated_be3ecc95:
    "Если хочу, как и в прошлый раз, держать ситуацию под контролем, придётся быть начеку."

# ch/harems_full/taming/events.rpy:647
translate russian taming_event_1_repeated_9c401c38:
    "Подходя к ресторану, я вижу недовольных Айшу и Кайли. Хотя, надо признать, выглядят они лучше, чем в прошлый раз."

# ch/harems_full/taming/events.rpy:648
translate russian taming_event_1_repeated_e4c2f89b:
    "Надеюсь, на этот раз они обойдутся без драки и, может быть, научатся получать удовольствие от общения друг с другом."

# ch/harems_full/taming/events.rpy:652
translate russian taming_event_1_repeated_062cc8a4:
    "Когда я наконец подхожу, обе девушки сидят за столиком и тихо беседуют. Честно говоря, это меня немного удивляет."

# ch/harems_full/taming/events.rpy:653
translate russian taming_event_1_repeated_d5cd5ed3:
    "Возможно, они начинают привыкать друг к другу. После того, как хорошо всё закончилось в прошлый раз, хочется на это надеяться."

# ch/harems_full/taming/events.rpy:654
translate russian taming_event_1_repeated_265d92de:
    mike.say "Привет, девушки!"

# ch/harems_full/taming/events.rpy:657
translate russian taming_event_1_repeated_b3970fd1:
    ayesha.say "Привет, [lssb_common.hero_name()]."

# ch/harems_full/taming/events.rpy:658
translate russian taming_event_1_repeated_043d4fb7:
    kylie.say "[lssb_common.hero_name()]!"

# ch/harems_full/taming/events.rpy:660
translate russian taming_event_1_repeated_9720c541:
    mike.say "Сегодня вы обе особенно прекрасны!"

# ch/harems_full/taming/events.rpy:664
translate russian taming_event_1_repeated_e21331c0:
    mike.say "Надеюсь, я не заставил вас долго ждать."

# ch/harems_full/taming/events.rpy:665
translate russian taming_event_1_repeated_828904de:
    "Отмахнувшись, они уверяют, что ждать почти не пришлось."

# ch/harems_full/taming/events.rpy:667
translate russian taming_event_1_repeated_62b990a8:
    "Я улыбаюсь, на миг задерживаю на них восхищённый взгляд и спрашиваю:"

# ch/harems_full/taming/events.rpy:668
translate russian taming_event_1_repeated_fe90caab:
    mike.say "Вы уже успели посмотреть меню? Присмотрели что-нибудь на ужин?"

# ch/harems_full/taming/events.rpy:670
translate russian taming_event_1_repeated_5731f324:
    "Айша усмехается и упоминает стейк."

# ch/harems_full/taming/events.rpy:671
translate russian taming_event_1_repeated_17c1f845:
    ayesha.say "Хотя десерта я жду больше."

# ch/harems_full/taming/events.rpy:672
translate russian taming_event_1_repeated_0804db48:
    "Если вы никогда не видели тигрицу на охоте, не знаю, как вам это описать."

# ch/harems_full/taming/events.rpy:673
translate russian taming_event_1_repeated_8704ef1d:
    "От взгляда Айши и того, как она облизывает губы, я сглатываю, гадая, переживу ли предстоящее."

# ch/harems_full/taming/events.rpy:674
translate russian taming_event_1_repeated_148cc0aa:
    "Кайли мило надувает губы, с живым интересом наблюдая за нашим обменом намёками."

# ch/harems_full/taming/events.rpy:675
translate russian taming_event_1_repeated_707cea61:
    "Разумеется, именно в этот момент к столику подходит официантка. Честно говоря, я просто рад, что не та же, что в прошлый раз."

# ch/harems_full/taming/events.rpy:676
translate russian taming_event_1_repeated_28bb60c0:
    "Я уже вижу, как напрягается Кайли, и заранее ободряюще сжимаю её ногу."

# ch/harems_full/taming/events.rpy:677
translate russian taming_event_1_repeated_88b2f625:
    "Официантка" "Добрый вечер, сэр... и дамы..."

# ch/harems_full/taming/events.rpy:678
translate russian taming_event_1_repeated_8c024100:
    "Официантка" "Желаете ознакомиться с картой напитков?"

# ch/harems_full/taming/events.rpy:681
translate russian taming_event_1_repeated_2a9069c4:
    "Я вижу, как Айша и Кайли напрягаются: официантка упомянула их словно между прочим."

# ch/harems_full/taming/events.rpy:682
translate russian taming_event_1_repeated_8127e51f:
    "И только усугубляет эту оплошность, вручая карту вин мне, а остальные бросая на стол, чтобы девушки взяли их сами."

# ch/harems_full/taming/events.rpy:683
translate russian taming_event_1_repeated_017176a5:
    "Мне, честно говоря, уже тревожно. Как нам опять попалась официантка с точно такими же манерами?"

# ch/harems_full/taming/events.rpy:684
translate russian taming_event_1_repeated_e27afcd2:
    "Официантка" "Позвольте, сэр?"

# ch/harems_full/taming/events.rpy:685
translate russian taming_event_1_repeated_04df28dd:
    "Официантка" "Сегодня у нас есть несколько весьма достойных предложений..."

# ch/harems_full/taming/events.rpy:686
translate russian taming_event_1_repeated_22fb3bae:
    "Официантка наклоняется совсем близко, показывая названные напитки в карте."

# ch/harems_full/taming/events.rpy:687
translate russian taming_event_1_repeated_520068d7:
    "Она так близко, что я чувствую её духи и почти ощущаю прикосновение волос к лицу..."

# ch/harems_full/taming/events.rpy:688
translate russian taming_event_1_repeated_031c24c8:
    kylie.say "Уф..."

# ch/harems_full/taming/events.rpy:689
translate russian taming_event_1_repeated_669860ec:
    kylie.say "Может, сразу предложишь себя на горячее?!"

# ch/harems_full/taming/events.rpy:690
translate russian taming_event_1_repeated_b4aa9b38:
    kylie.say "Или таких недожаренных шлюшек тут не подают?!"

# ch/harems_full/taming/events.rpy:691
translate russian taming_event_1_repeated_ed432c63:
    "Официантка резко отшатывается, явно задетая неожиданным выпадом Кайли."

# ch/harems_full/taming/events.rpy:692
translate russian taming_event_1_repeated_ad48a8b9:
    "Я вижу, что Кайли уже вцепилась в сумочку, и гадаю, прихватила ли она сегодня канцелярский нож..."

# ch/harems_full/taming/events.rpy:695
translate russian taming_event_1_repeated_7ead4556:
    ayesha.say "Эй, да успокойся ты, чёрт..."

# ch/harems_full/taming/events.rpy:696
translate russian taming_event_1_repeated_94abcf49:
    "Айша резко поворачивает голову и удивлённо смотрит на меня."

# ch/harems_full/taming/events.rpy:697
translate russian taming_event_1_repeated_c8f209ad:
    "Но я не отпускаю её запястье, за которое только что схватил под столом."

# ch/harems_full/taming/events.rpy:698
translate russian taming_event_1_repeated_ed5b4ce8:
    "Затем быстро качаю головой, давая понять, что хочу, чтобы она не вмешивалась."

# ch/harems_full/taming/events.rpy:699
translate russian taming_event_1_repeated_da2f5384:
    "Похоже, Айша сейчас вырвет руку и проигнорирует мою просьбу."

# ch/harems_full/taming/events.rpy:701
translate russian taming_event_1_repeated_dd8bb5b7:
    "Но затем она кивает, и я чувствую, как она всем телом расслабляется."

# ch/harems_full/taming/events.rpy:703
translate russian taming_event_1_repeated_dfd8546e:
    "А тем временем представление только начинается."

# ch/harems_full/taming/events.rpy:704
translate russian taming_event_1_repeated_8282ca0e:
    "Официантка" "Я... я..."

# ch/harems_full/taming/events.rpy:707
translate russian taming_event_1_repeated_4b12f155:
    kylie.say "Что такое, сука?"

# ch/harems_full/taming/events.rpy:708
translate russian taming_event_1_repeated_6b966bce:
    kylie.say "Ещё секунду назад ты вполне бойко болтала с моим парнем!"

# ch/harems_full/taming/events.rpy:710
translate russian taming_event_1_repeated_15b19ece:
    "Кайли поднимается со стула и наклоняется к официантке так же близко, как та наклонялась ко мне."

# ch/harems_full/taming/events.rpy:711
translate russian taming_event_1_repeated_044c7301:
    "Затем шипит прямо в ухо бедной дрожащей девушке."

# ch/harems_full/taming/events.rpy:712
translate russian taming_event_1_repeated_2049cc66:
    kylie.say "А теперь слушай меня, маленькая шлюха."

# ch/harems_full/taming/events.rpy:713
translate russian taming_event_1_repeated_9837652f:
    kylie.say "Своим языком ты будешь говорить только «да» и «нет»."

# ch/harems_full/taming/events.rpy:714
translate russian taming_event_1_repeated_8bb33722:
    kylie.say "И только когда к тебе обращаются. Иначе я тебе его отрежу!"

# ch/harems_full/taming/events.rpy:715
translate russian taming_event_1_repeated_44af427d:
    "Официантка едва не подпрыгивает от страха, съёживается и кивает."

# ch/harems_full/taming/events.rpy:717
translate russian taming_event_1_repeated_cbdf9b3d:
    "Вдруг вся ненависть и злоба словно исчезают с лица Кайли."

# ch/harems_full/taming/events.rpy:719
translate russian taming_event_1_repeated_1749d834:
    "Садясь на место, она уже сияет улыбкой, будто ничего не случилось."

# ch/harems_full/taming/events.rpy:720
translate russian taming_event_1_repeated_2ee0b1c0:
    "Айша смотрит на меня широко раскрытыми от изумления глазами."

# ch/harems_full/taming/events.rpy:721
translate russian taming_event_1_repeated_91b67a93:
    "Мне остаётся лишь пожать плечами и вновь уткнуться в карту вин."

# ch/harems_full/taming/events.rpy:723
translate russian taming_event_1_repeated_1507365a:
    ayesha.say "Эй, да успокойся ты, чёрт возьми, Кайли!"

# ch/harems_full/taming/events.rpy:724
translate russian taming_event_1_repeated_17ea6d05:
    "Кайли мгновенно забывает об официантке и переключает всё внимание на Айшу."

# ch/harems_full/taming/events.rpy:725
translate russian taming_event_1_repeated_d08e182d:
    "Бедняжка чуть ли не отшатывается, словно её только что освободили из чьей-то хватки."

# ch/harems_full/taming/events.rpy:726
translate russian taming_event_1_repeated_ac277ad4:
    "Но я слежу лишь за столкновением, которое вот-вот разразится прямо передо мной."

# ch/harems_full/taming/events.rpy:727
translate russian taming_event_1_repeated_ae64e778:
    kylie.say "Что, позволить этой маленькой шлюхе флиртовать с ним? [lssb_common.hero_name()] — наш парень!"

# ch/harems_full/taming/events.rpy:728
translate russian taming_event_1_repeated_5b57adc4:
    kylie.say "Она делает это прямо у нас под носом, Айша!"

# ch/harems_full/taming/events.rpy:729
translate russian taming_event_1_repeated_6a94b6d0:
    kylie.say "Её нужно поставить на место..."

# ch/harems_full/taming/events.rpy:730
translate russian taming_event_1_repeated_958badbb:
    "Рука Кайли тянется к сумочке, практически подтверждая мои опасения насчёт канцелярского ножа."

# ch/harems_full/taming/events.rpy:731
translate russian taming_event_1_repeated_e960ef0a:
    "К счастью для всех присутствующих, Айша тоже это замечает."

# ch/harems_full/taming/events.rpy:733
translate russian taming_event_1_repeated_57b2f357:
    "Кайли и опомниться не успевает, как более крупная девушка стремительно хватает её за запястье."

# ch/harems_full/taming/events.rpy:735
translate russian taming_event_1_repeated_bfc46258:
    kylie.say "ЭЙ!"

# ch/harems_full/taming/events.rpy:736
translate russian taming_event_1_repeated_53e85bfe:
    kylie.say "ДА ПОШЛА ТЫ НА..."

# ch/harems_full/taming/events.rpy:740
translate russian taming_event_1_repeated_3a7a8c13:
    "Айша обрывает её, прикрыв ей рот второй рукой."

# ch/harems_full/taming/events.rpy:741
translate russian taming_event_1_repeated_ea361376:
    "Кайли вырывается и издаёт приглушённые звуки, за которыми, вероятно, скрывается самая грязная ругань."

# ch/harems_full/taming/events.rpy:742
translate russian taming_event_1_repeated_5398b512:
    "Но Айшу это нисколько не беспокоит: она всё это время лишь улыбается ей."

# ch/harems_full/taming/events.rpy:743
translate russian taming_event_1_repeated_ffb307af:
    ayesha.say "Простите, мисс."

# ch/harems_full/taming/events.rpy:744
translate russian taming_event_1_repeated_538f2e34:
    ayesha.say "Моя спутница не слишком хорошо знакома с правилами поведения в обществе."

# ch/harems_full/taming/events.rpy:745
translate russian taming_event_1_repeated_d39f62aa:
    "Официантка, похоже, не знает, как реагировать на разыгравшуюся перед ней сцену."

# ch/harems_full/taming/events.rpy:746
translate russian taming_event_1_repeated_c91ce2c6:
    "Она нервно улыбается и смеётся."

# ch/harems_full/taming/events.rpy:747
translate russian taming_event_1_repeated_b5d1ca8c:
    "Но по её глазам видно: Айша, пожалуй, напугала её ещё сильнее!"

# ch/harems_full/taming/events.rpy:748
translate russian taming_event_1_repeated_dc0ad082:
    mike.say "Может, дадите нам пару минут ознакомиться с картой?"

# ch/harems_full/taming/events.rpy:749
translate russian taming_event_1_repeated_4e5309e1:
    "Я поднимаю карту вин и улыбаюсь официантке как можно приветливее."

# ch/harems_full/taming/events.rpy:750
translate russian taming_event_1_repeated_f917d178:
    "Она кивает и поспешно уходит, стараясь оказаться подальше, прежде чем Айша отпустит Кайли."

# ch/harems_full/taming/events.rpy:753
translate russian taming_event_1_repeated_90ce5a70:
    "Я резко протягиваю руку и хватаю Кайли за запястье."

# ch/harems_full/taming/events.rpy:754
translate russian taming_event_1_repeated_9c7dba43:
    "Затем отвожу её руку под стол, не давая залезть в сумочку."

# ch/harems_full/taming/events.rpy:755
translate russian taming_event_1_repeated_8d6fe96f:
    "Но секунду спустя замечаю, что Айша подаётся к ней, и хватаю за запястье её тоже."

# ch/harems_full/taming/events.rpy:756
translate russian taming_event_1_repeated_c5060e1a:
    "Удерживая обеих и завладев всем их вниманием, я сурово смотрю на них через стол."

# ch/harems_full/taming/events.rpy:759
translate russian taming_event_1_repeated_eb24d1d2:
    kylie.say "Эй!"

# ch/harems_full/taming/events.rpy:760
translate russian taming_event_1_repeated_a85d7201:
    ayesha.say "[lssb_common.hero_name()], ты чего?!"

# ch/harems_full/taming/events.rpy:761
translate russian taming_event_1_repeated_9d093ee4:
    mike.say "Простите, мисс."

# ch/harems_full/taming/events.rpy:762
translate russian taming_event_1_repeated_b7079890:
    mike.say "Похоже, мои спутницы забыли, как вести себя за столом."

# ch/harems_full/taming/events.rpy:763
translate russian taming_event_1_repeated_859c848f:
    mike.say "Не оставите нас на пару минут?"

# ch/harems_full/taming/events.rpy:764
translate russian taming_event_1_repeated_7f9be4fb:
    mike.say "Уверен, к тому времени мы уже выберем напитки."

# ch/harems_full/taming/events.rpy:765
translate russian taming_event_1_repeated_4c1a78d4:
    "Официантка кивает и улыбается."

# ch/harems_full/taming/events.rpy:766
translate russian taming_event_1_repeated_14e5a980:
    "Но по глазам видно, что она с радостью оставит нас в покое."

# ch/harems_full/taming/events.rpy:767
translate russian taming_event_1_repeated_94af21e2:
    "Как только она уходит, я отпускаю руки Айши и Кайли."

# ch/harems_full/taming/events.rpy:768
translate russian taming_event_1_repeated_c43f75ef:
    mike.say "Вы не хотите объяснить, что это, блядь, было?"

# ch/harems_full/taming/events.rpy:770
translate russian taming_event_1_repeated_c74cd759:
    kylie.say "Она с тобой флиртовала!"

# ch/harems_full/taming/events.rpy:771
translate russian taming_event_1_repeated_3955fecb:
    "Кайли произносит это жалобным голосом и демонстративно потирает запястье."

# ch/harems_full/taming/events.rpy:773
translate russian taming_event_1_repeated_cea7212f:
    ayesha.say "А ОНА собиралась её за это порезать!"

# ch/harems_full/taming/events.rpy:774
translate russian taming_event_1_repeated_f93fe3cc:
    "А сама Айша выглядит так, будто готова убить Кайли — с канцелярским ножом или без!"

# ch/harems_full/taming/events.rpy:775
translate russian taming_event_1_repeated_b7d8f817:
    "Терпеть не могу разыгрывать из себя главного."

# ch/harems_full/taming/events.rpy:776
translate russian taming_event_1_repeated_977c693f:
    "Но какой ещё выбор они мне оставили?"

# ch/harems_full/taming/events.rpy:777
translate russian taming_event_1_repeated_72a99437:
    mike.say "Кайли, мы ведь договорились, что больше никаких безумных выходок?"

# ch/harems_full/taming/events.rpy:778
translate russian taming_event_1_repeated_091fdd6d:
    kylie.say "Да, но..."

# ch/harems_full/taming/events.rpy:779
translate russian taming_event_1_repeated_2d774780:
    mike.say "Нет! Никаких «но»!"

# ch/harems_full/taming/events.rpy:780
translate russian taming_event_1_repeated_d96ca59c:
    mike.say "Не хватало мне ещё появляться на людях с Джеком-потрошителем в трусиках!"

# ch/harems_full/taming/events.rpy:782
translate russian taming_event_1_repeated_c0aef2f2:
    "Услышав смешок Айши, я тут же переключаюсь на неё."

# ch/harems_full/taming/events.rpy:783
translate russian taming_event_1_repeated_3a79c573:
    mike.say "А ты что собиралась с ней сделать, Айша?"

# ch/harems_full/taming/events.rpy:784
translate russian taming_event_1_repeated_f63714d7:
    mike.say "Проломить ею этот чёртов стол?!"

# ch/harems_full/taming/events.rpy:785
translate russian taming_event_1_repeated_0cd8d16f:
    mike.say "Прибереги такие приёмы для ринга, ладно?"

# ch/harems_full/taming/events.rpy:787
translate russian taming_event_1_repeated_dd45bdf7:
    "Я перевожу взгляд с одной на другую и не успокаиваюсь, пока обе нехотя не кивают."

# ch/harems_full/taming/events.rpy:790
translate russian taming_event_1_repeated_d1182f81:
    "Когда сцена наконец заканчивается, всё ещё встревоженная официантка возвращается принять заказ."

# ch/harems_full/taming/events.rpy:791
translate russian taming_event_1_repeated_f9879751:
    "Айша и Кайли ещё обмениваются колкими взглядами через стол, но боевые действия, кажется, закончились."

# ch/harems_full/taming/events.rpy:794
translate russian taming_event_1_repeated_c9310a1e:
    "Учитывая обстоятельства, остаток вечера проходит довольно хорошо. Мы почти похожи на совершенно обычную троицу."

# ch/harems_full/taming/events.rpy:795
translate russian taming_event_1_repeated_ea677c43:
    "Из чувства вины я оставляю щедрые чаевые, но утешаюсь тем, что заставляю Айшу и Кайли тоже скинуться."

# ch/harems_full/taming/events.rpy:813
translate russian taming_event_2_0554945b:
    "Выходить на свидание с Айшей и Кайли — довольно безумный опыт, причём не только по очевидным причинам!"

# ch/harems_full/taming/events.rpy:814
translate russian taming_event_2_99701e77:
    "Конечно, многожёнство у нас узаконили совсем недавно, и троицы влюблённых на публике пока ещё в диковинку."

# ch/harems_full/taming/events.rpy:815
translate russian taming_event_2_4087054a:
    "Да и сами девушки смотрятся вместе весьма эффектно, с этим не поспоришь."

# ch/harems_full/taming/events.rpy:816
translate russian taming_event_2_f9b40ed6:
    "Но я знаю то, чего не знают окружающие: их характеры тоже образуют взрывоопасное сочетание!"

# ch/harems_full/taming/events.rpy:817
translate russian taming_event_2_6bba7566:
    "В том числе поэтому я настоял на том, чтобы самому выбрать ночной клуб на сегодняшний вечер."

# ch/harems_full/taming/events.rpy:818
translate russian taming_event_2_743dc8d7:
    "Надеюсь, на нейтральной территории у них будет меньше поводов для столкновений."

# ch/harems_full/taming/events.rpy:819
translate russian taming_event_2_5c0116b9:
    "И пока мы стоим в очереди у входа, план, кажется, работает."

# ch/harems_full/taming/events.rpy:820
translate russian taming_event_2_57e47761:
    "Ни Айша, ни Кайли вроде бы не собираются затевать ссору."

# ch/harems_full/taming/events.rpy:821
translate russian taming_event_2_e17b227f:
    "Так что я могу просто наслаждаться всеобщим вниманием, держа обеих под руку."

# ch/harems_full/taming/events.rpy:823
translate russian taming_event_2_2edb0cd5:
    "Но едва мы заходим внутрь, возникает первая возможная проблема."

# ch/harems_full/taming/events.rpy:824
translate russian taming_event_2_3c8c24d2:
    ayesha.say "Ах..."

# ch/harems_full/taming/events.rpy:825
translate russian taming_event_2_b4bc3a11:
    ayesha.say "Может, возьмём что-нибудь выпить, [lssb_common.hero_name()]?"

# ch/harems_full/taming/events.rpy:826
translate russian taming_event_2_67daa537:
    ayesha.say "Что-то в горле пересохло..."

# ch/harems_full/taming/events.rpy:827
translate russian taming_event_2_b31cdfd7:
    mike.say "Конечно, Айша."

# ch/harems_full/taming/events.rpy:828
translate russian taming_event_2_3bf6dc68:
    mike.say "Бар как раз во..."

# ch/harems_full/taming/events.rpy:831
translate russian taming_event_2_e8e6c902:
    kylie.say "ВАУ! Это же моя САМАЯ любимая песня!"

# ch/harems_full/taming/events.rpy:832
translate russian taming_event_2_94e9202a:
    kylie.say "Мы ОБЯЗАНЫ под неё потанцевать! Прямо сейчас!"

# ch/harems_full/taming/events.rpy:834
translate russian taming_event_2_a9d70792:
    "Айша закатывает глаза, явно недовольная требованием Кайли."

# ch/harems_full/taming/events.rpy:835
translate russian taming_event_2_6b03fb9c:
    "Признаться, мне оно тоже кажется немного подозрительным."

# ch/harems_full/taming/events.rpy:836
translate russian taming_event_2_3723f661:
    "Раньше Кайли ни разу не упоминала эту песню."

# ch/harems_full/taming/events.rpy:837
translate russian taming_event_2_259c0c17:
    "Хотя на танцпол она и правда рвётся с огромным энтузиазмом."

# ch/harems_full/taming/events.rpy:838
translate russian taming_event_2_8aee4ac4:
    mike.say "Ну, у бара вроде немного народу."

# ch/harems_full/taming/events.rpy:839
translate russian taming_event_2_49a27989:
    mike.say "И песня только началась."

# ch/harems_full/taming/events.rpy:842
translate russian taming_event_2_6bce288f:
    mike.say "Кайли, может, займёшь нам место на танцполе?"

# ch/harems_full/taming/events.rpy:843
translate russian taming_event_2_366698de:
    ayesha.say "Да, Кайли. Мы и тебе что-нибудь возьмём."

# ch/harems_full/taming/events.rpy:844
translate russian taming_event_2_383cfff4:
    "Тон Айши далеко не такой примирительный, как у меня."

# ch/harems_full/taming/events.rpy:845
translate russian taming_event_2_10630aee:
    "На мгновение я всерьёз думаю, что Кайли сейчас топнет ногой и откажется."

# ch/harems_full/taming/events.rpy:846
translate russian taming_event_2_d3dd657c:
    "Но затем на её лице появляется натянутая улыбка, и она кивает."

# ch/harems_full/taming/events.rpy:847
translate russian taming_event_2_ea40a255:
    kylie.say "Ладно... ладно, хорошо."

# ch/harems_full/taming/events.rpy:848
translate russian taming_event_2_e82e840c:
    kylie.say "Только побыстрее, да?"

# ch/harems_full/taming/events.rpy:849
translate russian taming_event_2_ed001a00:
    "Кайли разворачивается и идёт на танцпол."

# ch/harems_full/taming/events.rpy:855
translate russian taming_event_2_b9708520:
    "А мы с Айшей остаёмся вдвоём и направляемся к бару."

# ch/harems_full/taming/events.rpy:856
translate russian taming_event_2_eac513f1:
    ayesha.say "Спасибо тебе, [lssb_common.hero_name()]."

# ch/harems_full/taming/events.rpy:858
translate russian taming_event_2_e849ebbe:
    mike.say "За что, Айша?"

# ch/harems_full/taming/events.rpy:859
translate russian taming_event_2_bf90793f:
    ayesha.say "За то, что понял: мне нужна минутка, чтобы собраться."

# ch/harems_full/taming/events.rpy:860
translate russian taming_event_2_5920050c:
    ayesha.say "В таких местах я всегда нервничаю."

# ch/harems_full/taming/events.rpy:861
translate russian taming_event_2_713e402a:
    ayesha.say "Мне нужно немного освоиться, прежде чем расслабиться."

# ch/harems_full/taming/events.rpy:862
translate russian taming_event_2_9fff631a:
    mike.say "А, конечно, Айша."

# ch/harems_full/taming/events.rpy:863
translate russian taming_event_2_0fcd1ddd:
    mike.say "Я прекрасно понимаю."

# ch/harems_full/taming/events.rpy:865
translate russian taming_event_2_c1dc07ad:
    mike.say "Айша, может, возьмёшь нам всем напитки в баре?"

# ch/harems_full/taming/events.rpy:866
translate russian taming_event_2_381dd222:
    kylie.say "Да, Айша. А мы займём нам место на танцполе."

# ch/harems_full/taming/events.rpy:867
translate russian taming_event_2_243c5079:
    "Тон Кайли далеко не такой примирительный, как у меня."

# ch/harems_full/taming/events.rpy:868
translate russian taming_event_2_1e5f7d62:
    "На мгновение я всерьёз думаю, что Айша наотрез откажется."

# ch/harems_full/taming/events.rpy:869
translate russian taming_event_2_d3dd657c_1:
    "Но затем на её лице появляется натянутая улыбка, и она кивает."

# ch/harems_full/taming/events.rpy:870
translate russian taming_event_2_7e7d4d02:
    ayesha.say "Да, конечно."

# ch/harems_full/taming/events.rpy:871
translate russian taming_event_2_b1b734ff:
    ayesha.say "Пожалуй, так будет разумно."

# ch/harems_full/taming/events.rpy:872
translate russian taming_event_2_4faf121f:
    "Айша разворачивается и идёт к бару."

# ch/harems_full/taming/events.rpy:878
translate russian taming_event_2_fa266de6:
    "А Кайли тут же хватает меня за запястье и тащит на танцпол."

# ch/harems_full/taming/events.rpy:879
translate russian taming_event_2_dc60db68:
    kylie.say "Я знала, что ты поймёшь, [lssb_common.hero_name()]."

# ch/harems_full/taming/events.rpy:881
translate russian taming_event_2_9d9cf392:
    mike.say "Что пойму, Кайли?"

# ch/harems_full/taming/events.rpy:882
translate russian taming_event_2_6bbd2abc:
    kylie.say "Что мне нужно побыть с тобой наедине."

# ch/harems_full/taming/events.rpy:883
translate russian taming_event_2_4456c91b:
    kylie.say "Пусть даже совсем недолго!"

# ch/harems_full/taming/events.rpy:884
translate russian taming_event_2_dcc9c5af:
    mike.say "А... ладно, Кайли."

# ch/harems_full/taming/events.rpy:885
translate russian taming_event_2_ec5bcd8c:
    mike.say "Наверное..."

# ch/harems_full/taming/events.rpy:891
translate russian taming_event_2_dd9daa7c:
    "Вскоре мы уже все на танцполе, с напитками в руках."

# ch/harems_full/taming/events.rpy:892
translate russian taming_event_2_2d6f4eaf:
    "И для меня наша размолвка быстро превращается в далёкое воспоминание."

# ch/harems_full/taming/events.rpy:893
translate russian taming_event_2_1516a663:
    "О таком легко забыть, когда танцуешь с Айшей и Кайли."

# ch/harems_full/taming/events.rpy:894
translate russian taming_event_2_3599686d:
    "Куда ни повернусь — рядом невероятно сексуальная девушка, которая старается прижаться ко мне поближе."

# ch/harems_full/taming/events.rpy:895
translate russian taming_event_2_222cda54:
    "Вскоре я оказываюсь буквально зажат между ними."

# ch/harems_full/taming/events.rpy:896
translate russian taming_event_2_a8b5ecb7:
    "Чувствую взгляды других посетителей и почти осязаю их зависть!"

# ch/harems_full/taming/events.rpy:897
translate russian taming_event_2_48565d80:
    "Но затем понимаю, что ревность есть и гораздо ближе."

# ch/harems_full/taming/events.rpy:898
translate russian taming_event_2_95081e31:
    "Айша танцует с одной стороны от меня, Кайли — с другой, и обе начинают стараться переплюнуть друг друга."

# ch/harems_full/taming/events.rpy:899
translate russian taming_event_2_801ba99a:
    "Вскоре их взгляды становятся такими острыми, что ими впору порезаться."

# ch/harems_full/taming/events.rpy:900
translate russian taming_event_2_a8305819:
    "Нужно что-то сделать, пока всё не вышло из-под контроля."

# ch/harems_full/taming/events.rpy:901
translate russian taming_event_2_a2e27e94:
    "Единственное, что приходит в голову, — целиком сосредоточиться на одной из них."

# ch/harems_full/taming/events.rpy:902
translate russian taming_event_2_d15631a2:
    "Но на какой?"

# ch/harems_full/taming/events.rpy:905
translate russian taming_event_2_5a2f670e:
    "Конечно, физически Айша внушительнее."

# ch/harems_full/taming/events.rpy:906
translate russian taming_event_2_f2269eb2:
    "Но это ещё не значит, что эмоционально она крепче."

# ch/harems_full/taming/events.rpy:912
translate russian taming_event_2_6e9fb09d:
    "Поэтому я обвиваю руками её талию и притягиваю к себе."

# ch/harems_full/taming/events.rpy:913
translate russian taming_event_2_1bfff02d:
    "Айша ни мгновения не сопротивляется, и я чувствую, как ко мне прижимаются её упругие мышцы."

# ch/harems_full/taming/events.rpy:914
translate russian taming_event_2_85982ef3:
    "Не успеваю я опомниться, как её язык скользит между моих губ и она страстно целует меня."

# ch/harems_full/taming/events.rpy:915
translate russian taming_event_2_1f95a583:
    "Не знаю, чувствует ли она это, но в ответ мой член становится твёрдым как камень."

# ch/harems_full/taming/events.rpy:916
translate russian taming_event_2_6516d8f4:
    "Вообще-то я собирался что-нибудь сказать Кайли."

# ch/harems_full/taming/events.rpy:917
translate russian taming_event_2_1ed4cc27:
    "Как-нибудь объяснить ей свой выбор."

# ch/harems_full/taming/events.rpy:918
translate russian taming_event_2_11c977cc:
    "Но теперь могу думать лишь о том, как прижать Айшу к себе ещё крепче."

# ch/harems_full/taming/events.rpy:919
translate russian taming_event_2_a4ca6edf:
    "В этот миг все мои мысли только о ней."

# ch/harems_full/taming/events.rpy:921
translate russian taming_event_2_11196974:
    "Айша уже взрослая, пару минут как-нибудь о себе позаботится."

# ch/harems_full/taming/events.rpy:922
translate russian taming_event_2_1896d92d:
    "А вот насколько ранимой бывает Кайли в таких ситуациях, я уже знаю."

# ch/harems_full/taming/events.rpy:928
translate russian taming_event_2_4807fe40:
    "Поэтому кладу руки ей на бёдра и притягиваю к себе."

# ch/harems_full/taming/events.rpy:929
translate russian taming_event_2_22c45df5:
    "Впрочем, Кайли и самой особого приглашения не требуется."

# ch/harems_full/taming/events.rpy:930
translate russian taming_event_2_e85aa062:
    "Я лишь собирался её обнять, но вскоре она сама чуть ли не вцепляется в меня."

# ch/harems_full/taming/events.rpy:931
translate russian taming_event_2_80170899:
    "Кайли прижимается губами к моим, вынуждая ответить на поцелуй."

# ch/harems_full/taming/events.rpy:932
translate russian taming_event_2_c4a0038d:
    "Затем её язык проникает между ними и исследует мой рот."

# ch/harems_full/taming/events.rpy:933
translate russian taming_event_2_76bb1ef6:
    "Только не подумайте, что я жалуюсь."

# ch/harems_full/taming/events.rpy:934
translate russian taming_event_2_1db41d96:
    "Стоит телу Кайли прижаться ко мне, как у меня встаёт."

# ch/harems_full/taming/events.rpy:935
translate russian taming_event_2_ce0a9aa6:
    "И всё это время для мыслей об Айше у меня просто не остаётся места."

# ch/harems_full/taming/events.rpy:939
translate russian taming_event_2_d6a86991:
    "Но ни одна из девушек не может завладеть мной на весь вечер."

# ch/harems_full/taming/events.rpy:940
translate russian taming_event_2_e8950d07:
    "Едва поцелуй заканчивается, мы вновь танцуем втроём."

# ch/harems_full/taming/events.rpy:941
translate russian taming_event_2_239c07b6:
    "Понятия не имею, сколько мы уже провели на танцполе."

# ch/harems_full/taming/events.rpy:942
translate russian taming_event_2_f8d4a6aa:
    "Знаю лишь, что начинаю уставать от танцев."

# ch/harems_full/taming/events.rpy:943
translate russian taming_event_2_f21f5c21:
    "Да и в горле изрядно пересохло. Не мешало бы выпить."

# ch/harems_full/taming/events.rpy:944
translate russian taming_event_2_1939d140:
    "Поэтому я жестом прошу перерыв и увожу девушек с танцпола."

# ch/harems_full/taming/events.rpy:945
translate russian taming_event_2_74ee3b80:
    mike.say "Простите, дамы."

# ch/harems_full/taming/events.rpy:946
translate russian taming_event_2_62c43b10:
    mike.say "Но мне нужно пополнить запас жидкости, иначе я рухну!"

# ch/harems_full/taming/events.rpy:948
translate russian taming_event_2_5579f5ee:
    "Кайли с энтузиазмом кивает."

# ch/harems_full/taming/events.rpy:949
translate russian taming_event_2_4664fe7c:
    "Но я вижу, что ей уже не терпится вернуться к танцам."

# ch/harems_full/taming/events.rpy:950
translate russian taming_event_2_37ae697e:
    kylie.say "Тогда скорее бери себе что-нибудь выпить, [lssb_common.hero_name()]."

# ch/harems_full/taming/events.rpy:951
translate russian taming_event_2_263995d2:
    kylie.say "До закрытия ещё пара часов!"

# ch/harems_full/taming/events.rpy:953
translate russian taming_event_2_15ba3ce1:
    "Айша качает головой."

# ch/harems_full/taming/events.rpy:954
translate russian taming_event_2_33a8d400:
    "Похоже, сама мысль о возвращении на танцпол её ужасает."

# ch/harems_full/taming/events.rpy:955
translate russian taming_event_2_7c7247a1:
    ayesha.say "Ты шутишь!"

# ch/harems_full/taming/events.rpy:956
translate russian taming_event_2_6aea65d0:
    ayesha.say "Я уже с ног валюсь."

# ch/harems_full/taming/events.rpy:957
translate russian taming_event_2_f874f841:
    ayesha.say "Может, возьмём такси и поедем к тебе, [lssb_common.hero_name()]?"

# ch/harems_full/taming/events.rpy:960
translate russian taming_event_2_6081ed4d:
    mike.say "Я просто хотел немного передохнуть, Айша."

# ch/harems_full/taming/events.rpy:961
translate russian taming_event_2_afa8eca9:
    mike.say "Выпью чего-нибудь — и смогу танцевать ещё час, а то и больше!"

# ch/harems_full/taming/events.rpy:962
translate russian taming_event_2_584edbef:
    mike.say "Если устала, может, немного посидишь?"

# ch/harems_full/taming/events.rpy:963
translate russian taming_event_2_73df4d99:
    kylie.say "Да, Айша."

# ch/harems_full/taming/events.rpy:964
translate russian taming_event_2_1475a77f:
    kylie.say "Или сядешь в то такси, о котором говорила."

# ch/harems_full/taming/events.rpy:965
translate russian taming_event_2_2218f760:
    kylie.say "Не волнуйся, со мной [lssb_common.hero_name()] доберётся домой целым и невредимым!"

# ch/harems_full/taming/events.rpy:968
translate russian taming_event_2_f07ce637:
    "На миг мне кажется, что Айша сейчас попадётся на эту провокацию."

# ch/harems_full/taming/events.rpy:969
translate russian taming_event_2_cb1fb1b4:
    "Либо просто даст Кайли по зубам!"

# ch/harems_full/taming/events.rpy:970
translate russian taming_event_2_871f8ec4:
    ayesha.say "Нет, всё нормально."

# ch/harems_full/taming/events.rpy:971
translate russian taming_event_2_faa1eef6:
    ayesha.say "Я от вас не отстану."

# ch/harems_full/taming/events.rpy:972
translate russian taming_event_2_ff025583:
    "И она держит слово."

# ch/harems_full/taming/events.rpy:973
translate russian taming_event_2_93d37bef:
    "Мы остаёмся в клубе ещё на час или два и всё это время танцуем."

# ch/harems_full/taming/events.rpy:974
translate russian taming_event_2_f8db6c54:
    "Не уверен, но, кажется, Кайли расстроена, что Айша не уехала пораньше."

# ch/harems_full/taming/events.rpy:975
translate russian taming_event_2_5e1069cf:
    "Впрочем, неважно..."

# ch/harems_full/taming/events.rpy:976
translate russian taming_event_2_17b000dd:
    "В результате к моменту ухода мы все совершенно вымотаны."

# ch/harems_full/taming/events.rpy:977
translate russian taming_event_2_b63a1eae:
    "Настолько, что в такси по дороге ко мне едва удаётся не уснуть."

# ch/harems_full/taming/events.rpy:979
translate russian taming_event_2_096476f9:
    mike.say "Может, ты и права, Айша."

# ch/harems_full/taming/events.rpy:980
translate russian taming_event_2_9455f68e:
    mike.say "Я и правда порядком устал."

# ch/harems_full/taming/events.rpy:981
translate russian taming_event_2_339834ec:
    mike.say "И хочу приберечь немного сил для того, что будет у меня дома!"

# ch/harems_full/taming/events.rpy:984
translate russian taming_event_2_bacfaa59:
    kylie.say "Ну-у... скукотища!"

# ch/harems_full/taming/events.rpy:985
translate russian taming_event_2_8355f4f0:
    kylie.say "Я ещё хочу танцевать!"

# ch/harems_full/taming/events.rpy:987
translate russian taming_event_2_8de87abb:
    ayesha.say "Можешь остаться, Кайли."

# ch/harems_full/taming/events.rpy:988
translate russian taming_event_2_b8908d2e:
    ayesha.say "Не волнуйся, со мной [lssb_common.hero_name()] доберётся домой целым и невредимым!"

# ch/harems_full/taming/events.rpy:989
translate russian taming_event_2_d997fce9:
    "Кайли щурится, внезапно поняв, что её обводят вокруг пальца."

# ch/harems_full/taming/events.rpy:991
translate russian taming_event_2_963f5195:
    "Она презрительно кривит губы и качает головой, не желая поддаваться на уловку."

# ch/harems_full/taming/events.rpy:992
translate russian taming_event_2_62b9821d:
    kylie.say "Нет, всё нормально."

# ch/harems_full/taming/events.rpy:993
translate russian taming_event_2_28d0c0df:
    kylie.say "Я тоже устала."

# ch/harems_full/taming/events.rpy:994
translate russian taming_event_2_f6bea48a:
    kylie.say "Я собиралась остаться лишь потому, что [lssb_common.hero_name()] этого хотел."

# ch/harems_full/taming/events.rpy:998
translate russian taming_event_2_4b3d4a57:
    "Решив так, мы выходим на улицу и ловим такси."

# ch/harems_full/taming/events.rpy:999
translate russian taming_event_2_70c1c2e7:
    "Мы уехали чуть раньше, чем планировали, и потому по дороге домой ещё полны сил."

# ch/harems_full/taming/events.rpy:1000
translate russian taming_event_2_d04c6e23:
    "Бороться со сном до самого моего дома не приходится!"

# ch/harems_full/taming/events.rpy:1011
translate russian taming_threesome_fuck_213247a3:
