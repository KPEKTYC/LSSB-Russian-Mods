# ch/harems_full/taming/events.rpy:2211
translate russian taming_event_03_b_d6b3686f:
    "И всё это время молюсь, чтобы обеим здесь понравилось: место ведь выбрал я."

# ch/harems_full/taming/events.rpy:2212
translate russian taming_event_03_b_d02f9eb1:
    "А вы теперь думаете, что я какой-то старомодный шовинист?"

# ch/harems_full/taming/events.rpy:2213
translate russian taming_event_03_b_17b7a69e:
    "Настоял на том, чтобы самому выбрать, где нам троим поесть?"

# ch/harems_full/taming/events.rpy:2214
translate russian taming_event_03_b_07d7a3e8:
    "Так вот: мне ПРИШЛОСЬ выбрать самому."

# ch/harems_full/taming/events.rpy:2215
translate russian taming_event_03_b_44d0a9a9:
    "Иначе всё свидание отменилось бы, даже не начавшись!"

# ch/harems_full/taming/events.rpy:2216
translate russian taming_event_03_b_425b703d:
    "Дело было так..."

# ch/harems_full/taming/events.rpy:2217
translate russian taming_event_03_b_d6461e66:
    "Айша хотела попробовать новый японский ресторан."

# ch/harems_full/taming/events.rpy:2218
translate russian taming_event_03_b_9aa1199e:
    "А Кайли настаивала на своём любимом стейк-хаусе."

# ch/harems_full/taming/events.rpy:2219
translate russian taming_event_03_b_b291e1ae:
    "Я с радостью пошёл бы в любой из них, ведь для меня главное — компания."

# ch/harems_full/taming/events.rpy:2220
translate russian taming_event_03_b_de91f59f:
    "Но эти двое, похоже, скорее умрут от голода в полном одиночестве, чем пойдут на компромисс!"

# ch/harems_full/taming/events.rpy:2225
translate russian taming_event_03_b_99d0930e:
    "Поэтому мы и сидим в ресторане, который для меня давно стал проверенным вариантом."

# ch/harems_full/taming/events.rpy:2226
translate russian taming_event_03_b_af9279ec:
    "Я натянул улыбку, пытаясь добиться, чтобы все вели себя дружелюбно."

# ch/harems_full/taming/events.rpy:2227
translate russian taming_event_03_b_45993153:
    "Но уже вижу, как Айша и Кайли сердито смотрят друг на друга через стол."

# ch/harems_full/taming/events.rpy:2228
translate russian taming_event_03_b_542004e3:
    "И это ужасно обидно, ведь все остальные посетители смотрят на них."

# ch/harems_full/taming/events.rpy:2229
translate russian taming_event_03_b_001a6a47:
    "Да и кто бы не смотрел?"

# ch/harems_full/taming/events.rpy:2230
translate russian taming_event_03_b_427ff778:
    "С одной стороны от меня амазонка, с другой — сногсшибательная блондинка!"

# ch/harems_full/taming/events.rpy:2231
translate russian taming_event_03_b_96884240:
    "Вот только первая в любой момент может озвереть."

# ch/harems_full/taming/events.rpy:2232
translate russian taming_event_03_b_42175747:
    "А вторая выглядит так, будто вот-вот взорвётся!"

# ch/harems_full/taming/events.rpy:2234
translate russian taming_event_03_b_2b80ae6e:
    mike.say "Здесь ведь довольно приятно, правда?"

# ch/harems_full/taming/events.rpy:2235
translate russian taming_event_03_b_2cde562b:
    mike.say "А какой столик! Нас прямо балуют!"

# ch/harems_full/taming/events.rpy:2236
translate russian taming_event_03_b_27afa3df:
    ayesha.say "Хм..."

# ch/harems_full/taming/events.rpy:2238
translate russian taming_event_03_b_429da40f:
    ayesha.say "Я всё равно предпочла бы суши!"

# ch/harems_full/taming/events.rpy:2239
translate russian taming_event_03_b_474faf36:
    kylie.say "Про стейк-хаус не забывай!"

# ch/harems_full/taming/events.rpy:2241
translate russian taming_event_03_b_8e42bf47:
    kylie.say "Там подают стейки с настоящей кровью!"

# ch/harems_full/taming/events.rpy:2242
translate russian taming_event_03_b_1799f921:
    "Отчаянно пытаясь заключить перемирие, я поднимаю меню."

# ch/harems_full/taming/events.rpy:2244
translate russian taming_event_03_b_9b8a967e:
    mike.say "Здесь в меню тоже есть весьма внушительные стейки, Кайли."

# ch/harems_full/taming/events.rpy:2245
translate russian taming_event_03_b_f9390838:
    mike.say "И морепродукты, Айша. Пусть и не совсем суши!"

# ch/harems_full/taming/events.rpy:2246
translate russian taming_event_03_b_0a40f726:
    "Когда обе переводят взгляд на меня, я невольно вжимаюсь в стул."

# ch/harems_full/taming/events.rpy:2247
translate russian taming_event_03_b_cb9af43d:
    "Вся сдерживаемая враждебность внезапно направляется на меня!"

# ch/harems_full/taming/events.rpy:2248
translate russian taming_event_03_b_a185583a:
    "Понимаю, что нужно как-то разрядить обстановку."

# ch/harems_full/taming/events.rpy:2249
translate russian taming_event_03_b_2ef739d8:
    "Официант" "Сэр..."

# ch/harems_full/taming/events.rpy:2250
translate russian taming_event_03_b_08c174d0:
    "Официант" "Вы готовы сделать заказ?"

# ch/harems_full/taming/events.rpy:2251
translate russian taming_event_03_b_12877343:
    "От неожиданного голоса официанта я едва не подпрыгиваю."

# ch/harems_full/taming/events.rpy:2252
translate russian taming_event_03_b_69601212:
    "Но затем понимаю: он может стать моим спасением."

# ch/harems_full/taming/events.rpy:2253
translate russian taming_event_03_b_5590af97:
    "При нём Айша и Кайли наверняка будут вести себя прилично, правда?"

# ch/harems_full/taming/events.rpy:2255
translate russian taming_event_03_b_609c356b:
    mike.say "Думаю, да!"

# ch/harems_full/taming/events.rpy:2256
translate russian taming_event_03_b_64cbc6dd:
    mike.say "Нет, минутку..."

# ch/harems_full/taming/events.rpy:2257
translate russian taming_event_03_b_f409bcec:
    mike.say "А что у вас сегодня особенного?"

# ch/harems_full/taming/events.rpy:2258
translate russian taming_event_03_b_64ceb6d8:
    "Официант" "Сегодня у нас пицца на растянутом вручную тесте, выпеченная на камне."

# ch/harems_full/taming/events.rpy:2259
translate russian taming_event_03_b_7d02fa98:
    "Официант" "Также есть королевские креветки на гриле с чесночным маслом."

# ch/harems_full/taming/events.rpy:2260
translate russian taming_event_03_b_65cbf00b:
    "Официант" "Стейк из филейной части с сезонными овощами."

# ch/harems_full/taming/events.rpy:2261
translate russian taming_event_03_b_cef78c4f:
    "Официант" "Ах да..."

# ch/harems_full/taming/events.rpy:2262
translate russian taming_event_03_b_b35e2bf9:
    "Официант" "И ещё солёный свиной окорок. Очень солёный!"

# ch/harems_full/taming/events.rpy:2265
translate russian taming_event_03_b_dc770920:
    mike.say "М-м-м..."

# ch/harems_full/taming/events.rpy:2268
translate russian taming_event_03_b_d4bcae7d:
    mike.say "Очень солёный, говорите?"

# ch/harems_full/taming/events.rpy:2269
translate russian taming_event_03_b_503c27d9:
    mike.say "Тогда три порции окорока!"

# ch/harems_full/taming/events.rpy:2270
translate russian taming_event_03_b_40cf86d6:
    "Официант кивает и улыбается, забирая меню."

# ch/harems_full/taming/events.rpy:2271
translate russian taming_event_03_b_087b9662:
    "Знаю, ни одна из девушек не хотела именно этого блюда."

# ch/harems_full/taming/events.rpy:2272
translate russian taming_event_03_b_d8e2c979:
    "Но они ведь должны понимать, что мне пришлось искать компромисс?"

# ch/harems_full/taming/events.rpy:2273
translate russian taming_event_03_b_0f1d0cdf:
    "Я улыбаюсь им в надежде на ответную улыбку."

# ch/harems_full/taming/events.rpy:2276
translate russian taming_event_03_b_a2ade68d:
    "Но Айша и Кайли лишь сердито смотрят на меня через стол."

# ch/harems_full/taming/events.rpy:2281
translate russian taming_event_03_b_1fa64218:
    mike.say "Думаю, нам всем стоит взять пиццу."

# ch/harems_full/taming/events.rpy:2282
translate russian taming_event_03_b_05810b35:
    mike.say "Пиццу ведь все любят, правда?"

# ch/harems_full/taming/events.rpy:2283
translate russian taming_event_03_b_c44b7040:
    ayesha.say "Я..."

# ch/harems_full/taming/events.rpy:2285
translate russian taming_event_03_b_dff17704:
    ayesha.say "Я бы и правда съела пиццу."

# ch/harems_full/taming/events.rpy:2286
translate russian taming_event_03_b_3395401e:
    kylie.say "А знаете..."

# ch/harems_full/taming/events.rpy:2288
translate russian taming_event_03_b_668f510b:
    kylie.say "Звучит неплохо."

# ch/harems_full/taming/events.rpy:2289
translate russian taming_event_03_b_40cf86d6_1:
    "Официант кивает и улыбается, забирая меню."

# ch/harems_full/taming/events.rpy:2290
translate russian taming_event_03_b_087b9662_1:
    "Знаю, ни одна из девушек не хотела именно этого блюда."

# ch/harems_full/taming/events.rpy:2291
translate russian taming_event_03_b_530d119c:
    "Но, к счастью, похоже, они готовы пойти на компромисс!"

# ch/harems_full/taming/events.rpy:2294
translate russian taming_event_03_b_7cff6057:
    mike.say "Всем креветки, да?"

# ch/harems_full/taming/events.rpy:2295
translate russian taming_event_03_b_929c2cae:
    mike.say "Ведь креветки любят все."

# ch/harems_full/taming/events.rpy:2298
translate russian taming_event_03_b_f5d957a9:
    mike.say "Пусть это и не суши."

# ch/harems_full/taming/events.rpy:2299
translate russian taming_event_03_b_5c0a5450:
    mike.say "Но всё равно морепродукты."

# ch/harems_full/taming/events.rpy:2300
translate russian taming_event_03_b_8696722a:
    mike.say "Правда, Айша?"

# ch/harems_full/taming/events.rpy:2302
translate russian taming_event_03_b_e080b204:
    "Айша улыбается и кивает, явно довольная моим решением."

# ch/harems_full/taming/events.rpy:2303
translate russian taming_event_03_b_a3a3872e:
    "А вот Кайли почти испепеляет меня взглядом через стол."

# ch/harems_full/taming/events.rpy:2305
translate russian taming_event_03_b_461b1c5f:
    "Ну что ж, всем не угодишь."

# ch/harems_full/taming/events.rpy:2309
translate russian taming_event_03_b_e036ac48:
    mike.say "Всем стейки, да?"

# ch/harems_full/taming/events.rpy:2310
translate russian taming_event_03_b_51f7b85d:
    mike.say "Ведь стейки любят все."

# ch/harems_full/taming/events.rpy:2313
translate russian taming_event_03_b_2d16abcd:
    mike.say "Пусть и не из модного стейк-хауса."

# ch/harems_full/taming/events.rpy:2314
translate russian taming_event_03_b_02849bcc:
    mike.say "Но вполне достойная замена."

# ch/harems_full/taming/events.rpy:2315
translate russian taming_event_03_b_ac37310a:
    mike.say "Правда, Кайли?"

# ch/harems_full/taming/events.rpy:2317
translate russian taming_event_03_b_4e8d73d2:
    "Кайли улыбается и кивает, явно довольная моим решением."

# ch/harems_full/taming/events.rpy:2318
translate russian taming_event_03_b_d5de2991:
    "А вот Айша почти испепеляет меня взглядом через стол."

# ch/harems_full/taming/events.rpy:2320
translate russian taming_event_03_b_461b1c5f_1:
    "Ну что ж, всем не угодишь."

# ch/harems_full/taming/events.rpy:2323
translate russian taming_event_03_b_931818ff:
    "Еду заказали, и я думаю, что наконец можно продолжить свидание."

# ch/harems_full/taming/events.rpy:2326
translate russian taming_event_03_b_a27bff83:
    "Как только её приносят, я демонстративно радуюсь и принимаюсь за еду."

# ch/harems_full/taming/events.rpy:2327
translate russian taming_event_03_b_70145218:
    "Но, съев едва ли один кусок, поднимаю глаза и вижу, что Айша и Кайли смотрят на меня."

# ch/harems_full/taming/events.rpy:2328
translate russian taming_event_03_b_30366ad4:
    "Я замираю, метаясь взглядом из стороны в сторону и пытаясь сообразить, что не так."

# ch/harems_full/taming/events.rpy:2330
translate russian taming_event_03_b_c305fb97:
    mike.say "Почему вы так на меня смотрите?"

# ch/harems_full/taming/events.rpy:2331
translate russian taming_event_03_b_42cd876a:
    mike.say "Ждали, что я прочту молитву перед едой?"

# ch/harems_full/taming/events.rpy:2332
translate russian taming_event_03_b_da01172a:
    "Вопрос явно раздражает и Айшу, и Кайли."

# ch/harems_full/taming/events.rpy:2335
translate russian taming_event_03_b_e94cfb11:
    "Они цокают языками и недоверчиво качают головами."

# ch/harems_full/taming/events.rpy:2336
translate russian taming_event_03_b_bef483ba:
    ayesha.say "Ты шутишь, [lssb_common.hero_name()]!"

# ch/harems_full/taming/events.rpy:2337
translate russian taming_event_03_b_f432f655:
    kylie.say "Как ты можешь говорить, что не заметил?!"

# ch/harems_full/taming/events.rpy:2338
translate russian taming_event_03_b_86b0fc3a:
    mike.say "Не заметил чего?"

# ch/harems_full/taming/events.rpy:2339
translate russian taming_event_03_b_e89b83b0:
    mike.say "Как я могу сказать, чего не заметил, если не знаю, что должен был заметить?"

# ch/harems_full/taming/events.rpy:2340
translate russian taming_event_03_b_ab9bd5ba:
    ayesha.say "Официант, [lssb_common.hero_name()]!"

# ch/harems_full/taming/events.rpy:2341
translate russian taming_event_03_b_c53d3bab:
    ayesha.say "Когда он только что ставил еду на стол!"

# ch/harems_full/taming/events.rpy:2342
translate russian taming_event_03_b_f5c502c9:
    kylie.say "Хочешь сказать, ты не видел, что он делал?"

# ch/harems_full/taming/events.rpy:2343
translate russian taming_event_03_b_6cc9a737:
    kylie.say "Он заглядывал нам в вырезы!"

# ch/harems_full/taming/events.rpy:2344
translate russian taming_event_03_b_23225764:
    ayesha.say "Да, [lssb_common.hero_name()]! Пялился нам на грудь!"

# ch/harems_full/taming/events.rpy:2345
translate russian taming_event_03_b_489f859f:
    "От этих слов мои глаза невольно расширяются."

# ch/harems_full/taming/events.rpy:2346
translate russian taming_event_03_b_3279b6ba:
    "Если девушки правы, это совсем не дело."

# ch/harems_full/taming/events.rpy:2347
translate russian taming_event_03_b_62cbe0fb:
    "Но как, чёрт возьми, я мог такое пропустить?"

# ch/harems_full/taming/events.rpy:2348
translate russian taming_event_03_b_f0cfa43f:
    "Неужели настолько увлёкся едой?"

# ch/harems_full/taming/events.rpy:2349
translate russian taming_event_03_b_ca5345aa:
    "Как бы то ни было, нужно что-то предпринять."

# ch/harems_full/taming/events.rpy:2352
translate russian taming_event_03_b_86fa2a31:
    "Не могу же я просто обвинить официанта в том, что он пялится на грудь моих спутниц."

# ch/harems_full/taming/events.rpy:2353
translate russian taming_event_03_b_59769ea5:
    "Он всё отрицает и выставит меня полным идиотом."

# ch/harems_full/taming/events.rpy:2354
translate russian taming_event_03_b_5c7cd5d9:
    "Лучше преуменьшить случившееся в надежде, что всё само забудется."

# ch/harems_full/taming/events.rpy:2355
translate russian taming_event_03_b_70b442a0:
    "Так что простите, пока я немного займусь газлайтингом..."

# ch/harems_full/taming/events.rpy:2358
translate russian taming_event_03_b_876feb2a:
    mike.say "Вы уверены, что всё было именно так?"

# ch/harems_full/taming/events.rpy:2359
translate russian taming_event_03_b_c123cac8:
    mike.say "Он ведь стоит, а вы сидите."

# ch/harems_full/taming/events.rpy:2360
translate russian taming_event_03_b_14311e96:
    mike.say "Со стороны всегда будет казаться, что он смотрит вам на грудь, разве нет?"

# ch/harems_full/taming/events.rpy:2361
translate russian taming_event_03_b_f58e37b0:
    ayesha.say "Ты... ты встаёшь на сторону официанта?!"

# ch/harems_full/taming/events.rpy:2363
translate russian taming_event_03_b_abebe10c:
    kylie.say "Зачем ты это делаешь, [lssb_common.hero_name()]?"

# ch/harems_full/taming/events.rpy:2365
translate russian taming_event_03_b_0f354433:
    kylie.say "Он вёл себя как мерзкий извращенец!"

# ch/harems_full/taming/events.rpy:2366
translate russian taming_event_03_b_05e82d6a:
    ayesha.say "Он точно на нас пялился!"

# ch/harems_full/taming/events.rpy:2367
translate russian taming_event_03_b_aeec8576:
    mike.say "Тогда почему сами ничего не сказали?"

# ch/harems_full/taming/events.rpy:2368
translate russian taming_event_03_b_2d7346a2:
    mike.say "Вы ведь современные женщины?"

# ch/harems_full/taming/events.rpy:2369
translate russian taming_event_03_b_f7b91e27:
    mike.say "С каких пор вам нужно, чтобы я решал за вас ваши проблемы?"

# ch/harems_full/taming/events.rpy:2370
translate russian taming_event_03_b_8eb8fade:
    "Айша и Кайли обе открывают рты, собираясь возразить."

# ch/harems_full/taming/events.rpy:2371
translate russian taming_event_03_b_aa6b104f:
    "Но затем, похоже, до них доходит смысл моих слов."

# ch/harems_full/taming/events.rpy:2372
translate russian taming_event_03_b_01ab417d:
    "Обе отворачиваются и обречённо качают головами."

# ch/harems_full/taming/events.rpy:2373
translate russian taming_event_03_b_6cec9bdc:
    "Да, с моей стороны это был дешёвый трюк."

# ch/harems_full/taming/events.rpy:2374
translate russian taming_event_03_b_7594b4ce:
    "Зато позволил выкрутиться. Так что чёрт с ним!"

# ch/harems_full/taming/events.rpy:2379
translate russian taming_event_03_b_c8ed3c12:
    "Причём быстро."

# ch/harems_full/taming/events.rpy:2380
translate russian taming_event_03_b_7e27e623:
    "Иначе буду выглядеть мудаком."

# ch/harems_full/taming/events.rpy:2381
translate russian taming_event_03_b_30b7f9e1:
    "Тем самым мудаком, который позволяет обижать своих спутниц!"

# ch/harems_full/taming/events.rpy:2383
translate russian taming_event_03_b_6fe69530:
    mike.say "Предоставьте это мне!"

# ch/harems_full/taming/events.rpy:2386
translate russian taming_event_03_b_b392a180:
    "Я встаю и подхожу к ближайшему сотруднику."

# ch/harems_full/taming/events.rpy:2387
translate russian taming_event_03_b_9422e65d:
    mike.say "Позовите управляющего."

# ch/harems_full/taming/events.rpy:2388
translate russian taming_event_03_b_fd50b1cf:
    "Официант" "Ч-что?!"

# ch/harems_full/taming/events.rpy:2389
translate russian taming_event_03_b_a596b9bb:
    mike.say "Я сказал, позовите управляющего. Сейчас же!"

# ch/harems_full/taming/events.rpy:2390
translate russian taming_event_03_b_35a25b47:
    "Несчастный сотрудник спешит выполнить требование."

# ch/harems_full/taming/events.rpy:2391
translate russian taming_event_03_b_774629d2:
    "Через несколько мгновений появляется управляющий."

# ch/harems_full/taming/events.rpy:2392
translate russian taming_event_03_b_9aedfa9b:
    "Пока я излагаю жалобу, в ответ следуют то кивки, то неодобрительное покачивание головой."

# ch/harems_full/taming/events.rpy:2393
translate russian taming_event_03_b_bb8cad1b:
    "Затем я стою и смотрю, как к управляющему вызывают официанта."

# ch/harems_full/taming/events.rpy:2394
translate russian taming_event_03_b_be5ccc7b:
    "Я не слышу, что ему говорят."

# ch/harems_full/taming/events.rpy:2395
translate russian taming_event_03_b_4023e7f3:
    "Но парень, кажется, буквально вздрагивает от летящих в него слов!"

# ch/harems_full/taming/events.rpy:2396
translate russian taming_event_03_b_382ddde6:
    "После этого я киваю и возвращаюсь за стол."

# ch/harems_full/taming/events.rpy:2397
translate russian taming_event_03_b_ad8bd3d8:
    mike.say "Вот так."

# ch/harems_full/taming/events.rpy:2398
translate russian taming_event_03_b_e5619b7a:
    mike.say "Теперь он всё понял!"

# ch/harems_full/taming/events.rpy:2399
translate russian taming_event_03_b_8f041f50:
    ayesha.say "А... хорошо, [lssb_common.hero_name()]."

# ch/harems_full/taming/events.rpy:2400
translate russian taming_event_03_b_b9d78a6a:
    ayesha.say "Надеюсь, официанта из-за этого не уволят."

# ch/harems_full/taming/events.rpy:2401
translate russian taming_event_03_b_a1186ddc:
    kylie.say "Я... уверена, его просто отчитают, и всё!"

# ch/harems_full/taming/events.rpy:2402
translate russian taming_event_03_b_59bf9bd2:
    mike.say "Не жалейте этого мерзавца!"

# ch/harems_full/taming/events.rpy:2403
translate russian taming_event_03_b_9a38804b:
    mike.say "Он получает ровно то, что заслужил."

# ch/harems_full/taming/events.rpy:2404
translate russian taming_event_03_b_0103e46b:
    "Айша и Кайли кивают."

# ch/harems_full/taming/events.rpy:2405
translate russian taming_event_03_b_414d39a2:
    "И я замечаю, как обе украдкой поглядывают на меня."

# ch/harems_full/taming/events.rpy:2406
translate russian taming_event_03_b_97f3045c:
    "Можете считать меня безумцем, но я почти уверен: они смотрят на меня с новым восхищением!"

# ch/harems_full/taming/events.rpy:2409
translate russian taming_event_03_b_86fa2a31_1:
    "Не могу же я просто обвинить официанта в том, что он пялится на грудь моих спутниц."

# ch/harems_full/taming/events.rpy:2410
translate russian taming_event_03_b_59769ea5_1:
    "Он всё отрицает и выставит меня полным идиотом."

# ch/harems_full/taming/events.rpy:2411
translate russian taming_event_03_b_5c7cd5d9_1:
    "Лучше преуменьшить случившееся в надежде, что всё само забудется."

# ch/harems_full/taming/events.rpy:2412
translate russian taming_event_03_b_5d9b3d3c:
    "Так что простите, пока я немного займусь газлайтингом..."

# ch/harems_full/taming/events.rpy:2416
translate russian taming_event_03_b_4544bc31:
    mike.say "Конечно, он на тебя пялился, Кайли."

# ch/harems_full/taming/events.rpy:2417
translate russian taming_event_03_b_07b8cb86:
    mike.say "Ты ведь сама выставляешь себя напоказ, разве нет?"

# ch/harems_full/taming/events.rpy:2418
translate russian taming_event_03_b_e30d0368:
    "Единство девушек мгновенно исчезает."

# ch/harems_full/taming/events.rpy:2420
translate russian taming_event_03_b_d3be595f:
    "Кайли наклоняется вперёд и сердито смотрит на меня через стол."

# ch/harems_full/taming/events.rpy:2422
translate russian taming_event_03_b_b78aeccd:
    "А Айша откидывается на спинку стула, смеясь над моим намёком."

# ch/harems_full/taming/events.rpy:2423
translate russian taming_event_03_b_f06e562e:
    kylie.say "Что это, чёрт возьми, должно означать?!"

# ch/harems_full/taming/events.rpy:2424
translate russian taming_event_03_b_abb49275:
    ayesha.say "Это значит, что ты одеваешься как дешёвая проститутка, Кайли!"

# ch/harems_full/taming/events.rpy:2425
translate russian taming_event_03_b_6f5567ae:
    ayesha.say "Не оставляешь простора воображению — вот все и смотрят!"

# ch/harems_full/taming/events.rpy:2426
translate russian taming_event_03_b_0123533f:
    "Когда они начинают спорить, я невольно улыбаюсь и откидываюсь на стуле."

# ch/harems_full/taming/events.rpy:2427
translate russian taming_event_03_b_73ade157:
    "Проблему с пялящимся официантом это не решает."

# ch/harems_full/taming/events.rpy:2428
translate russian taming_event_03_b_5d0f50e7:
    "Зато ко мне больше никаких претензий!"

# ch/harems_full/taming/events.rpy:2431
translate russian taming_event_03_b_86fa2a31_2:
    "Не могу же я просто обвинить официанта в том, что он пялится на грудь моих спутниц."

# ch/harems_full/taming/events.rpy:2432
translate russian taming_event_03_b_59769ea5_2:
    "Он всё отрицает и выставит меня полным идиотом."

# ch/harems_full/taming/events.rpy:2433
translate russian taming_event_03_b_5c7cd5d9_2:
    "Лучше преуменьшить случившееся в надежде, что всё само забудется."

# ch/harems_full/taming/events.rpy:2434
translate russian taming_event_03_b_5d9b3d3c_1:
    "Так что простите, пока я немного займусь газлайтингом..."

# ch/harems_full/taming/events.rpy:2438
translate russian taming_event_03_b_02c0d36e:
    mike.say "На Кайли он, может, и смотрел с интересом."

# ch/harems_full/taming/events.rpy:2439
translate russian taming_event_03_b_c7cd913a:
    mike.say "Но тебе, думаю, нечего опасаться, Айша!"

# ch/harems_full/taming/events.rpy:2440
translate russian taming_event_03_b_e30d0368_1:
    "Единство девушек мгновенно исчезает."

# ch/harems_full/taming/events.rpy:2442
translate russian taming_event_03_b_ca0433ca:
    "Айша наклоняется вперёд и сердито смотрит на меня через стол."

# ch/harems_full/taming/events.rpy:2444
translate russian taming_event_03_b_106c370f:
    "А Кайли откидывается на спинку стула, смеясь над моим намёком."

# ch/harems_full/taming/events.rpy:2445
translate russian taming_event_03_b_e54f8467:
    ayesha.say "Что это, чёрт возьми, должно означать?!"

# ch/harems_full/taming/events.rpy:2446
translate russian taming_event_03_b_20f7e2ea:
    kylie.say "Это значит, что ему нравятся женщины, Айша."

# ch/harems_full/taming/events.rpy:2447
translate russian taming_event_03_b_40983c62:
    kylie.say "А не здоровенные мускулистые мужики, у которых случайно выросла грудь!"

# ch/harems_full/taming/events.rpy:2448
translate russian taming_event_03_b_0123533f_1:
    "Когда они начинают спорить, я невольно улыбаюсь и откидываюсь на стуле."

# ch/harems_full/taming/events.rpy:2449
translate russian taming_event_03_b_73ade157_1:
    "Проблему с пялящимся официантом это не решает."

# ch/harems_full/taming/events.rpy:2450
translate russian taming_event_03_b_5d0f50e7_1:
    "Зато ко мне больше никаких претензий!"

# ch/harems_full/taming/events.rpy:2452
translate russian taming_event_03_b_a521244b:
    "Когда история с официантом заканчивается, всё вроде бы успокаивается."

# ch/harems_full/taming/events.rpy:2453
translate russian taming_event_03_b_a5442b46:
    "То ли у Айши и Кайли закончились поводы для спора."

# ch/harems_full/taming/events.rpy:2456
translate russian taming_event_03_b_1a52ad7a:
    "То ли им и правда приятно общество друг друга."

# ch/harems_full/taming/events.rpy:2457
translate russian taming_event_03_b_13f3f568:
    "Первое, конечно, вероятнее второго."

# ch/harems_full/taming/events.rpy:2458
translate russian taming_event_03_b_c57118a4:
    "Но выяснять причину и рисковать новым скандалом я не собираюсь!"

# ch/harems_full/taming/events.rpy:2459
translate russian taming_event_03_b_ea00e84a:
    "Остаток ужина и правда проходит без происшествий."

# ch/harems_full/taming/events.rpy:2460
translate russian taming_event_03_b_b526a5f6:
    "До тех пор, пока не приносят счёт и мы не видим размер ущерба..."

# ch/harems_full/taming/events.rpy:2461
translate russian taming_event_03_b_265c0fc5:
    ayesha.say "Ох..."

# ch/harems_full/taming/events.rpy:2463
translate russian taming_event_03_b_553f4e4a:
    ayesha.say "Теперь я вспомнила, почему редко ем в ресторанах!"

# ch/harems_full/taming/events.rpy:2464
translate russian taming_event_03_b_8743079a:
    kylie.say "И не говори!"

# ch/harems_full/taming/events.rpy:2466
translate russian taming_event_03_b_73cfa9fc:
    kylie.say "Они что, и воздух нам в счёт включили?!"

# ch/harems_full/taming/events.rpy:2467
translate russian taming_event_03_b_d3c53b60:
    mike.say "Да не так уж всё страшно!"

# ch/harems_full/taming/events.rpy:2468
translate russian taming_event_03_b_d5ff7dd2:
    mike.say "Нас ведь трое."

# ch/harems_full/taming/events.rpy:2469
translate russian taming_event_03_b_d9447a7c:
    "Пока никто даже не заикнулся, как мы будем оплачивать ужин."

# ch/harems_full/taming/events.rpy:2470
translate russian taming_event_03_b_4119eb33:
    "Похоже, решать придётся мне."

# ch/harems_full/taming/events.rpy:2473
translate russian taming_event_03_b_af501fb5:
    mike.say "Эй, не волнуйтесь."

# ch/harems_full/taming/events.rpy:2474
translate russian taming_event_03_b_d94b36b4:
    mike.say "Какой же я джентльмен, если не оплачу счёт?"

# ch/harems_full/taming/events.rpy:2475
translate russian taming_event_03_b_a40ffcc8:
    ayesha.say "Эм..."

# ch/harems_full/taming/events.rpy:2477
translate russian taming_event_03_b_d7ed47b6:
    ayesha.say "Может, тот, который живёт в двадцать первом веке?"

# ch/harems_full/taming/events.rpy:2478
translate russian taming_event_03_b_e55174ed:
    kylie.say "Да, [lssb_common.hero_name()]!"

# ch/harems_full/taming/events.rpy:2480
translate russian taming_event_03_b_f9864ed8:
    kylie.say "Довольно самонадеянно с твоей стороны."

# ch/harems_full/taming/events.rpy:2481
translate russian taming_event_03_b_750e1936:
    "От их реакции я начинаю ощетиниваться."

# ch/harems_full/taming/events.rpy:2482
translate russian taming_event_03_b_39c9febc:
    "И вдруг отчаянно хочется настоять на своём обещании заплатить."

# ch/harems_full/taming/events.rpy:2483
translate russian taming_event_03_b_bb818a5a:
    mike.say "Ну тогда считайте меня старомодным!"

# ch/harems_full/taming/events.rpy:2484
translate russian taming_event_03_b_925039be:
    mike.say "Господи... пытаешься сделать приятное."

# ch/harems_full/taming/events.rpy:2485
translate russian taming_event_03_b_4d336b56:
    mike.say "А в ответ одни нападки!"

# ch/harems_full/taming/events.rpy:2492
translate russian taming_event_03_b_2562bd59:
    mike.say "Если разделить на троих, получится не так уж много."

# ch/harems_full/taming/events.rpy:2493
translate russian taming_event_03_b_c651cb95:
    mike.say "Вы обе не против?"

# ch/harems_full/taming/events.rpy:2496
translate russian taming_event_03_b_f9825e1f:
    "Айша и Кайли переглядываются, пожимают плечами и кивают."

# ch/harems_full/taming/events.rpy:2497
translate russian taming_event_03_b_4e9b4816:
    ayesha.say "Ладно, [lssb_common.hero_name()]."

# ch/harems_full/taming/events.rpy:2498
translate russian taming_event_03_b_0b0abafe:
    ayesha.say "По-моему, справедливо."

# ch/harems_full/taming/events.rpy:2499
translate russian taming_event_03_b_bac9847a:
    kylie.say "Я не против."

# ch/harems_full/taming/events.rpy:2500
translate russian taming_event_03_b_b0566a48:
    kylie.say "Так и сделаем."

# ch/harems_full/taming/events.rpy:2501
translate russian taming_event_03_b_9d48bf0c:
    "Когда обе соглашаются, я облегчённо вздыхаю."

# ch/harems_full/taming/events.rpy:2502
translate russian taming_event_03_b_cd3dc0d0:
    "Похоже, удалось избежать сцены!"

# ch/harems_full/taming/events.rpy:2505
translate russian taming_event_03_b_db55bc7b:
    mike.say "Может, на этот раз заплатишь ты, Айша?"

# ch/harems_full/taming/events.rpy:2506
translate russian taming_event_03_b_08164f41:
    mike.say "Всё-таки у тебя есть работа."

# ch/harems_full/taming/events.rpy:2507
translate russian taming_event_03_b_f631b169:
    mike.say "А Кайли — всего лишь бедная студентка!"

# ch/harems_full/taming/events.rpy:2509
translate russian taming_event_03_b_96d16c6b:
    "Айша смотрит на меня с неприкрытым изумлением."

# ch/harems_full/taming/events.rpy:2510
translate russian taming_event_03_b_fa1b9b8c:
    "Словно не может поверить, что я только что сказал."

# ch/harems_full/taming/events.rpy:2512
translate russian taming_event_03_b_7dfb66af:
    "А Кайли согласно кивает и не может сдержать смех."

# ch/harems_full/taming/events.rpy:2515
translate russian taming_event_03_b_6c9b2109:
    mike.say "Может, на этот раз заплатишь ты, Кайли?"

# ch/harems_full/taming/events.rpy:2516
translate russian taming_event_03_b_6ba43401:
    mike.say "Я точно знаю, что ты только что получила студенческий кредит на этот семестр."

# ch/harems_full/taming/events.rpy:2517
translate russian taming_event_03_b_b3fd56c9:
    mike.say "Так что можешь потратить часть на нас, вместо того чтобы спускать всё на учебники!"

# ch/harems_full/taming/events.rpy:2519
translate russian taming_event_03_b_446d5c46:
    "Кайли смотрит на меня с неприкрытым изумлением."

# ch/harems_full/taming/events.rpy:2520
translate russian taming_event_03_b_fa1b9b8c_1:
    "Словно не может поверить, что я только что сказал."

# ch/harems_full/taming/events.rpy:2522
translate russian taming_event_03_b_ce657892:
    "А Айша согласно кивает и не может сдержать смех."

# ch/harems_full/taming/events.rpy:2524
translate russian taming_event_03_b_05929728:
    "Выйдя из ресторана, я пытаюсь понять настроение девушек."

# ch/harems_full/taming/events.rpy:2525
translate russian taming_event_03_b_9a739b0d:
    "По-моему, учитывая обстоятельства, свидание прошло довольно хорошо."

# ch/harems_full/taming/events.rpy:2526
translate russian taming_event_03_b_ce4d2e07:
    "И заканчивать его прямо сейчас я ещё не готов."

# ch/harems_full/taming/events.rpy:2530
translate russian taming_event_03_b_32c9ddd3:
    mike.say "Ну как вам?"

# ch/harems_full/taming/events.rpy:2531
translate russian taming_event_03_b_8994282a:
    mike.say "Я отлично провёл время!"

# ch/harems_full/taming/events.rpy:2533
translate russian taming_event_03_b_48666191:
    ayesha.say "Очнись, [lssb_common.hero_name()]!"

# ch/harems_full/taming/events.rpy:2535
translate russian taming_event_03_b_d44bba02:
    ayesha.say "Это была катастрофа от начала до конца!"

# ch/harems_full/taming/events.rpy:2536
translate russian taming_event_03_b_7ad56b88:
    kylie.say "Она права, это было ужасно!"

# ch/harems_full/taming/events.rpy:2538
translate russian taming_event_03_b_52eb31f8:
    kylie.say "Мне понадобится время, чтобы прийти в себя!"

# ch/harems_full/taming/events.rpy:2539
translate russian taming_event_03_b_b52c4064:
    "Я смотрю, как Айша и Кайли уходят, оставляя меня в полном одиночестве."

# ch/harems_full/taming/events.rpy:2542
translate russian taming_event_03_b_d9d6e1b2:
    "Неужели всё и правда прошло настолько плохо?"

# ch/harems_full/taming/events.rpy:2543
translate russian taming_event_03_b_5b78c2a5:
    "И если да, почему я не заметил?"

# ch/harems_full/taming/events.rpy:2544
translate russian taming_event_03_b_c6ad920a:
    "В следующий раз придётся постараться получше."

# ch/harems_full/taming/events.rpy:2545
translate russian taming_event_03_b_741abdbd:
    "Нужно выходить на новый уровень!"

# ch/harems_full/taming/events.rpy:2548
translate russian taming_event_03_b_87310cf9:
    ayesha.say "Я отлично провела время, [lssb_common.hero_name()]."

# ch/harems_full/taming/events.rpy:2550
translate russian taming_event_03_b_91ce9f01:
    ayesha.say "Если честно, мне не хочется, чтобы всё уже заканчивалось."

# ch/harems_full/taming/events.rpy:2551
translate russian taming_event_03_b_a3de0264:
    kylie.say "Мне тоже, [lssb_common.hero_name()]."

# ch/harems_full/taming/events.rpy:2553
translate russian taming_event_03_b_04512386:
    kylie.say "Я тоже не хочу, чтобы веселье закончилось!"

# ch/harems_full/taming/events.rpy:2555
translate russian taming_event_03_b_4cd7073a:
    mike.say "Что скажете, если закончим вечер на пляже?"

# ch/harems_full/taming/events.rpy:2556
translate russian taming_event_03_b_f16b653c:
    ayesha.say "Отличная идея!"

# ch/harems_full/taming/events.rpy:2557
translate russian taming_event_03_b_6ad6acba:
    kylie.say "Да, я за!"

# ch/harems_full/taming/events.rpy:2558
translate russian taming_event_03_b_3ab01194:
    "Направляясь к пляжу, я улыбаюсь во весь рот."

# ch/harems_full/taming/events.rpy:2559
translate russian taming_event_03_b_f6130c5a:
    "С одной стороны от меня Айша, с другой — Кайли."

# ch/harems_full/taming/events.rpy:2560
translate russian taming_event_03_b_9921a0c7:
    "А мысли уже мчатся вперёд: что же мы ещё устроим!"

# ch/harems_full/taming/events.rpy:2565
translate russian taming_event_03_b_d31c930f:
    ayesha.say "Сегодня вечером было довольно здорово."

# ch/harems_full/taming/events.rpy:2566
translate russian taming_event_03_b_c731ce6a:
    ayesha.say "Нужно будет вскоре повторить."

# ch/harems_full/taming/events.rpy:2567
translate russian taming_event_03_b_3c771299:
    kylie.say "Да, мне тоже понравилось."

# ch/harems_full/taming/events.rpy:2568
translate russian taming_event_03_b_46ca8205:
    kylie.say "Сообщи, когда соберёмся в следующий раз."

# ch/harems_full/taming/events.rpy:2569
translate russian taming_event_03_b_3b3ce20c:
    "Я улыбаюсь, глядя вслед уходящим Айше и Кайли."

# ch/harems_full/taming/events.rpy:2572
translate russian taming_event_03_b_4f72086d:
    "Да, свидание закончено, и домой я отправлюсь один."

# ch/harems_full/taming/events.rpy:2573
translate russian taming_event_03_b_edce3058:
    "Но зато впереди новое свидание с ними."

# ch/harems_full/taming/events.rpy:2574
translate russian taming_event_03_b_114ca050:
    "И я решительно намерен сделать его ещё лучше!"

# ch/harems_full/taming/events.rpy:2584
translate russian taming_event_03_c_7e681072:
    "Последние несколько дней я ломаю голову, куда пригласить Айшу и Кайли на свидание."

# ch/harems_full/taming/events.rpy:2585
translate russian taming_event_03_c_3eaa42f9:
    "С любыми другими девушками я просто придумал бы что-нибудь интересное и устроил сюрприз."

# ch/harems_full/taming/events.rpy:2586
translate russian taming_event_03_c_846f234d:
    "Но Айша и Кайли — не обычные девушки. С каждой возникают свои особенные сложности."

# ch/harems_full/taming/events.rpy:2587
translate russian taming_event_03_c_0606f1f0:
    "Хуже того, они словно получают удовольствие, мгновенно отвергая всё, чего хочет другая."

# ch/harems_full/taming/events.rpy:2588
translate russian taming_event_03_c_93c01ef1:
    "Поэтому вместо чего-то весёлого мне нужно придумать то, против чего никто не сможет возразить."

# ch/harems_full/taming/events.rpy:2589
translate russian taming_event_03_c_61319e2b:
    "Что-нибудь настолько простое и незамысловатое, что спорить будет не о чем."

# ch/harems_full/taming/events.rpy:2590
translate russian taming_event_03_c_7d353401:
    "И тут меня осеняет: как насчёт прогулки по пляжу при лунном свете?"

# ch/harems_full/taming/events.rpy:2591
translate russian taming_event_03_c_ad481c03:
    "Просто, классически и совершенно без осложнений."

# ch/harems_full/taming/events.rpy:2592
translate russian taming_event_03_c_c2d1e93f:
    "Что может пойти не так?"

# ch/harems_full/taming/events.rpy:2593
translate russian taming_event_03_c_39a8c7cb:
    "Да-да, я знаю!"

# ch/harems_full/taming/events.rpy:2594
translate russian taming_event_03_c_3bc34392:
    "Наверное, только что всё сглазил!"

# ch/harems_full/taming/events.rpy:2595
translate russian taming_event_03_c_a6dae24d:
    "Но была не была..."

# ch/harems_full/taming/events.rpy:2599
translate russian taming_event_03_c_d0afcade:
    ayesha.say "Никому больше не кажется, что это..."

# ch/harems_full/taming/events.rpy:2600
translate russian taming_event_03_c_9448dde6:
    ayesha.say "Не знаю... немного странно?"

# ch/harems_full/taming/events.rpy:2601
translate russian taming_event_03_c_f3b36ab8:
    "Мы идём по песку всего пару минут."

# ch/harems_full/taming/events.rpy:2602
translate russian taming_event_03_c_20461243:
    "И пока все молчали, никто не произнёс ни слова."

# ch/harems_full/taming/events.rpy:2603
translate russian taming_event_03_c_d65c424a:
    "Поэтому вопрос Айши застаёт меня врасплох."

# ch/harems_full/taming/events.rpy:2604
translate russian taming_event_03_c_2099594a:
    "Мне даже требуется мгновение, чтобы осмыслить сказанное."

# ch/harems_full/taming/events.rpy:2606
translate russian taming_event_03_c_319a0d23:
    mike.say "То есть тебе кажется странным..."

# ch/harems_full/taming/events.rpy:2607
translate russian taming_event_03_c_06cff3a4:
    mike.say "Гулять ночью по пляжу?"

# ch/harems_full/taming/events.rpy:2608
translate russian taming_event_03_c_b10930d1:
    "Я невольно удивлённо качаю головой."

# ch/harems_full/taming/events.rpy:2609
translate russian taming_event_03_c_acdd9b7c:
    mike.say "Айша, это же классика романтики!"

# ch/harems_full/taming/events.rpy:2611
translate russian taming_event_03_c_b8242be6:
    "В ответ Айша хмурится и оглядывается по сторонам."

# ch/harems_full/taming/events.rpy:2612
translate russian taming_event_03_c_9fe79c5a:
    "Тут дело в чём-то другом."

# ch/harems_full/taming/events.rpy:2613
translate russian taming_event_03_c_21568bcf:
    "Только не пойму, в чём."

# ch/harems_full/taming/events.rpy:2614
translate russian taming_event_03_c_de2d7893:
    "А вот Кайли, похоже, соображает быстрее меня."

# ch/harems_full/taming/events.rpy:2615
translate russian taming_event_03_c_0cbe028a:
    kylie.say "Боже мой..."

# ch/harems_full/taming/events.rpy:2616
translate russian taming_event_03_c_aec3214b:
    kylie.say "Айша, ты что... боишься?"

# ch/harems_full/taming/events.rpy:2618
translate russian taming_event_03_c_77cb253c:
    kylie.say "Как такая здоровенная девушка может бояться темноты?!"

# ch/harems_full/taming/events.rpy:2620
translate russian taming_event_03_c_6c909bc0:
    "Айша тут же занимает оборонительную позицию, скрещивая руки на груди."

# ch/harems_full/taming/events.rpy:2621
translate russian taming_event_03_c_9a2ececc:
    "Но при этом продолжает оглядываться."

# ch/harems_full/taming/events.rpy:2622
translate russian taming_event_03_c_47d77b94:
    "Может, Кайли права и Айше действительно страшно."

# ch/harems_full/taming/events.rpy:2623
translate russian taming_event_03_c_858e1a56:
    ayesha.say "Я не боюсь, что из темноты кто-то выскочит, Кайли!"

# ch/harems_full/taming/events.rpy:2624
translate russian taming_event_03_c_907d96af:
    ayesha.say "Я же сказала: тут странно. Как-то жутко, понимаешь?"

# ch/harems_full/taming/events.rpy:2627
translate russian taming_event_03_c_4552c877:
    ayesha.say "Я привыкла бывать здесь днём, когда полно народу."

# ch/harems_full/taming/events.rpy:2628
translate russian taming_event_03_c_6308cbd6:
    ayesha.say "А без людей здесь не по себе!"

# ch/harems_full/taming/events.rpy:2631
translate russian taming_event_03_c_4562d06d:
    "Уф..."

# ch/harems_full/taming/events.rpy:2632
translate russian taming_event_03_c_dc69bfe8:
    "Я знал, что этим закончится!"

# ch/harems_full/taming/events.rpy:2633
translate russian taming_event_03_c_665ca9a6:
    "Мы едва успели сделать пару шагов по песку."

# ch/harems_full/taming/events.rpy:2634
translate russian taming_event_03_c_21229a0d:
    "А эти двое уже препираются!"

# ch/harems_full/taming/events.rpy:2635
translate russian taming_event_03_c_dc4514c9:
    mike.say "Вы обе можете помолчать?"

# ch/harems_full/taming/events.rpy:2636
translate russian taming_event_03_c_8491439d:
    mike.say "Айша, здесь нет ничего, что может тебе навредить."

# ch/harems_full/taming/events.rpy:2637
translate russian taming_event_03_c_49ed7c3a:
    mike.say "Так что перестань вести себя как испуганная девочка."

# ch/harems_full/taming/events.rpy:2638
translate russian taming_event_03_c_7e56bde3:
    mike.say "А ты, Кайли..."

# ch/harems_full/taming/events.rpy:2639
translate russian taming_event_03_c_32f6fb3c:
    mike.say "Перестань цепляться к ней при каждом удобном случае."

# ch/harems_full/taming/events.rpy:2640
translate russian taming_event_03_c_e3941781:
    mike.say "От этого всё только хуже!"

# ch/harems_full/taming/events.rpy:2643
translate russian taming_event_03_c_acfd2b64:
    "Обе девушки раздражены тем, что я их отчитываю."

# ch/harems_full/taming/events.rpy:2644
translate russian taming_event_03_c_c0870fc1:
    "На миг мне кажется, что сейчас они выскажут мне всё в ответ."

# ch/harems_full/taming/events.rpy:2645
translate russian taming_event_03_c_682cf503:
    "Но в итоге обе лишь раздражённо фыркают."

# ch/harems_full/taming/events.rpy:2646
translate russian taming_event_03_c_e073cfb0:
    "На этом я решаю считать вопрос закрытым."

# ch/harems_full/taming/events.rpy:2651
translate russian taming_event_03_c_f66e2ee3:
    "Я поднимаю руки, призывая к спокойствию."

# ch/harems_full/taming/events.rpy:2652
translate russian taming_event_03_c_7127f9e9:
    mike.say "Эй, эй, эй!"

# ch/harems_full/taming/events.rpy:2653
translate russian taming_event_03_c_125f36f6:
    mike.say "У нас вообще-то свидание!"

# ch/harems_full/taming/events.rpy:2654
translate russian taming_event_03_c_033f97ca:
    mike.say "С чего мы вдруг начинаем ругаться?"

# ch/harems_full/taming/events.rpy:2656
translate russian taming_event_03_c_4fefa9ac:
    ayesha.say "Потому что Кайли меня обижает!"

# ch/harems_full/taming/events.rpy:2658
translate russian taming_event_03_c_3dd98200:
    kylie.say "Я разозлилась только потому, что ты собралась испортить свидание, прежде чем оно началось!"

# ch/harems_full/taming/events.rpy:2659
translate russian taming_event_03_c_dcbce93f:
    "Я качаю головой и отмахиваюсь от их возражений."

# ch/harems_full/taming/events.rpy:2660
translate russian taming_event_03_c_d0d23867:
    mike.say "Вам обеим нужно успокоиться!"

# ch/harems_full/taming/events.rpy:2661
translate russian taming_event_03_c_56b44f41:
    mike.say "Айша, я понимаю, о чём ты."

# ch/harems_full/taming/events.rpy:2663
translate russian taming_event_03_c_28925825:
    mike.say "Странно, когда здесь нет людей."

# ch/harems_full/taming/events.rpy:2664
translate russian taming_event_03_c_80af1a9f:
    mike.say "Но мы с Кайли рядом, ты не одна."

# ch/harems_full/taming/events.rpy:2665
translate russian taming_event_03_c_4d77c034:
    mike.say "А Кайли, если боишься, что Айша захочет уйти, почему бы её не успокоить?"

# ch/harems_full/taming/events.rpy:2667
translate russian taming_event_03_c_698bd350:
    mike.say "Может, у тебя получится убедить её, что с нами она в безопасности!"

# ch/harems_full/taming/events.rpy:2668
translate russian taming_event_03_c_221368b5:
    "Обе девушки выглядят так, будто собираются возразить."

# ch/harems_full/taming/events.rpy:2669
translate russian taming_event_03_c_5311d2ff:
    "Но затем, похоже, передумывают."

# ch/harems_full/taming/events.rpy:2670
translate russian taming_event_03_c_4c260be0:
    "Они по очереди кивают, и мы продолжаем прогулку."

# ch/harems_full/taming/events.rpy:2671
translate russian taming_event_03_c_f5a9fcca:
    "Быстро глянув по сторонам, я вижу, что обе вроде довольны."

# ch/harems_full/taming/events.rpy:2672
translate russian taming_event_03_c_6300d36b:
    "Может, и не на все сто."

# ch/harems_full/taming/events.rpy:2673
translate russian taming_event_03_c_0d97fa87:
    "Но хотя бы больше не ссорятся."

# ch/harems_full/taming/events.rpy:2676
translate russian taming_event_03_c_a0b3fb18:
    "Я закатываю глаза, глядя на Айшу, и устало вздыхаю."

# ch/harems_full/taming/events.rpy:2677
translate russian taming_event_03_c_4cbe6bde:
    mike.say "Кайли права, Айша."

# ch/harems_full/taming/events.rpy:2680
translate russian taming_event_03_c_29e5dc34:
    mike.say "Сейчас здесь так же безопасно, как среди бела дня."

# ch/harems_full/taming/events.rpy:2681
translate russian taming_event_03_c_dc96432d:
    mike.say "По-моему, поддаваться этому страху довольно ребячески!"

# ch/harems_full/taming/events.rpy:2682
translate russian taming_event_03_c_ba086b9e:
    ayesha.say "Что?!"

# ch/harems_full/taming/events.rpy:2684
translate russian taming_event_03_c_f63108ef:
    ayesha.say "Я уже сказала, что не боюсь!"

# ch/harems_full/taming/events.rpy:2685
translate russian taming_event_03_c_f39a09b7:
    ayesha.say "Это Кайли так решила!"

# ch/harems_full/taming/events.rpy:2686
translate russian taming_event_03_c_30665883:
    "Я качаю головой, отмахиваясь от объяснения Айши."

# ch/harems_full/taming/events.rpy:2687
translate russian taming_event_03_c_0ddd69b2:
    mike.say "Давай просто забудем об этом, ладно?"

# ch/harems_full/taming/events.rpy:2688
translate russian taming_event_03_c_34098bdd:
    mike.say "Если поможет, я буду покрепче держать тебя за руку!"

# ch/harems_full/taming/events.rpy:2689
translate russian taming_event_03_c_c9de70d1:
    "Айша открывает рот, собираясь возразить."

# ch/harems_full/taming/events.rpy:2690
translate russian taming_event_03_c_34fbb041:
    "Но затем, похоже, передумывает."

# ch/harems_full/taming/events.rpy:2691
translate russian taming_event_03_c_f8a9eb33:
    "Мы продолжаем идти по пляжу."

# ch/harems_full/taming/events.rpy:2692
translate russian taming_event_03_c_c6c7592c:
    "Быстрый взгляд в сторону подтверждает: Айша сердито смотрит на меня."

# ch/harems_full/taming/events.rpy:2693
translate russian taming_event_03_c_c350dfe5:
    "А с другой стороны злорадствует Кайли."

# ch/harems_full/taming/events.rpy:2697
translate russian taming_event_03_c_41c279a6:
    "Я резко поворачиваюсь к Кайли и смотрю ей прямо в глаза."

# ch/harems_full/taming/events.rpy:2698
translate russian taming_event_03_c_1aa980f0:
    mike.say "Да помолчи ты, Кайли!"

# ch/harems_full/taming/events.rpy:2700
translate russian taming_event_03_c_5f217030:
    mike.say "Айша не говорила, что чего-то боится. Это ты сказала!"

# ch/harems_full/taming/events.rpy:2701
translate russian taming_event_03_c_5b87bcc9:
    mike.say "Она сказала, что в темноте здесь странно. И она права."

# ch/harems_full/taming/events.rpy:2703
translate russian taming_event_03_c_54e0f228:
    kylie.say "Чт..."

# ch/harems_full/taming/events.rpy:2705
translate russian taming_event_03_c_07bc0e62:
    kylie.say "Почему ты злишься на меня?!"

# ch/harems_full/taming/events.rpy:2706
translate russian taming_event_03_c_965df1ab:
    kylie.say "Не я же жаловалась!"

# ch/harems_full/taming/events.rpy:2707
translate russian taming_event_03_c_4cdaf22a:
    "Я качаю головой, отмахиваясь от оправданий Кайли."

# ch/harems_full/taming/events.rpy:2708
translate russian taming_event_03_c_df3c385a:
    mike.say "Да, Кайли, я знаю."

# ch/harems_full/taming/events.rpy:2709
translate russian taming_event_03_c_e374b44d:
    mike.say "Но тебе не обязательно было вмешиваться и всё усугублять!"

# ch/harems_full/taming/events.rpy:2710
translate russian taming_event_03_c_ad7513af:
    "Кайли открывает рот, собираясь возразить."

# ch/harems_full/taming/events.rpy:2712
translate russian taming_event_03_c_34fbb041_1:
    "Но затем, похоже, передумывает."

# ch/harems_full/taming/events.rpy:2713
translate russian taming_event_03_c_f8a9eb33_1:
    "Мы продолжаем идти по пляжу."

# ch/harems_full/taming/events.rpy:2714
translate russian taming_event_03_c_0b4058ed:
    "Быстрый взгляд в сторону подтверждает: Кайли сердито смотрит на меня."

# ch/harems_full/taming/events.rpy:2715
translate russian taming_event_03_c_8db3f0bb:
    "А с другой стороны злорадствует Айша."

# ch/harems_full/taming/events.rpy:2718
translate russian taming_event_03_c_9549fbe8:
    "Когда мы наконец идём вдоль берега, всё будто налаживается."

# ch/harems_full/taming/events.rpy:2719
translate russian taming_event_03_c_089aaffb:
    "Тихий плеск океанских волн создаёт естественный звуковой фон."

# ch/harems_full/taming/events.rpy:2722
translate russian taming_event_03_c_2a8ece7e:
    "Мягкий песок под ногами так же приятен, как и днём."

# ch/harems_full/taming/events.rpy:2723
translate russian taming_event_03_c_935a4598:
    "Не говоря уже об отражениях луны и звёзд в воде."

# ch/harems_full/taming/events.rpy:2724
translate russian taming_event_03_c_2df18430:
    "Ночь быстро становится безупречно красивой."

# ch/harems_full/taming/events.rpy:2725
translate russian taming_event_03_c_1885a468:
    "Ну, понимаете, как в кино?"

# ch/harems_full/taming/events.rpy:2727
translate russian taming_event_03_c_a7fa92a7:
    kylie.say "Ай!"

# ch/harems_full/taming/events.rpy:2728
translate russian taming_event_03_c_099b2cdd:
    kylie.say "Чёрт побери!"

# ch/harems_full/taming/events.rpy:2730
translate russian taming_event_03_c_9bee6d2a:
    kylie.say "Я, кажется, палец на ноге сломала, блядь!"

# ch/harems_full/taming/events.rpy:2731
translate russian taming_event_03_c_27234951:
    "Ни в одном фильме, который я видел, такого не было!"

# ch/harems_full/taming/events.rpy:2732
translate russian taming_event_03_c_4960b90e:
    "И настроение это изрядно портит."

# ch/harems_full/taming/events.rpy:2733
translate russian taming_event_03_c_9c6d4109:
    "Мы с Айшей оборачиваемся посмотреть, что случилось с Кайли."

# ch/harems_full/taming/events.rpy:2734
translate russian taming_event_03_c_2e042cd5:
    "Как раз вовремя, чтобы увидеть, как она наклоняется и хватает с песка камень."

# ch/harems_full/taming/events.rpy:2735
translate russian taming_event_03_c_f1ee567e:
    "Наверное, именно он стал причиной её недавней вспышки."

# ch/harems_full/taming/events.rpy:2737
translate russian taming_event_03_c_34e12d3c:
    "Догадка подтверждается, когда она размахивается и швыряет провинившийся камень в море."

# ch/harems_full/taming/events.rpy:2738
translate russian taming_event_03_c_a6d677ae:
    "Все трое смотрят, как он летит к воде."

# ch/harems_full/taming/events.rpy:2739
translate russian taming_event_03_c_ef0571b1:
    "Но неожиданно камень несколько раз отскакивает от поверхности и лишь потом тонет."

# ch/harems_full/taming/events.rpy:2740
translate russian taming_event_03_c_2fb56c20:
    mike.say "Ух ты, Кайли!"

# ch/harems_full/taming/events.rpy:2741
translate russian taming_event_03_c_9c24fc0b:
    mike.say "Ты довольно далеко пустила блинчик!"

# ch/harems_full/taming/events.rpy:2743
translate russian taming_event_03_c_700cc710:
    kylie.say "Хмф..."

# ch/harems_full/taming/events.rpy:2744
translate russian taming_event_03_c_2155bbe3:
    kylie.say "Недостаточно далеко для этой дряни!"

# ch/harems_full/taming/events.rpy:2745
translate russian taming_event_03_c_1d1b27c5:
    kylie.say "Кто вообще его сюда положил?!"

# ch/harems_full/taming/events.rpy:2746
translate russian taming_event_03_c_68cc29d6:
    kylie.say "Любой мог споткнуться!"

# ch/harems_full/taming/events.rpy:2748
translate russian taming_event_03_c_8b2527b0:
    "Поначалу Айша не вступает в разговор."

# ch/harems_full/taming/events.rpy:2749
translate russian taming_event_03_c_746720fb:
    "Просто стоит, будто глубоко задумавшись."

# ch/harems_full/taming/events.rpy:2750
translate russian taming_event_03_c_9e8c6483:
    ayesha.say "М-м..."

# ch/harems_full/taming/events.rpy:2751
translate russian taming_event_03_c_1f16e31a:
    ayesha.say "Можно было бросить гораздо дальше."

# ch/harems_full/taming/events.rpy:2752
translate russian taming_event_03_c_3e8e8ff6:
    ayesha.say "Всё дело в движении кисти."

# ch/harems_full/taming/events.rpy:2753
translate russian taming_event_03_c_c36a3738:
    kylie.say "Ну да..."

# ch/harems_full/taming/events.rpy:2754
translate russian taming_event_03_c_3d3a30e5:
    kylie.say "Я вообще-то не собиралась бить мировой рекорд!"

# ch/harems_full/taming/events.rpy:2755
translate russian taming_event_03_c_a21b5762:
    "Айша словно не слышит Кайли и наклоняется за другим камнем."

# ch/harems_full/taming/events.rpy:2757
translate russian taming_event_03_c_a1321acd:
    "Затем взмахом кисти отправляет его скакать по воде."

# ch/harems_full/taming/events.rpy:2758
translate russian taming_event_03_c_c6309192:
    "Я вижу, что Айша права: её камень улетает гораздо дальше, чем камень Кайли."

# ch/harems_full/taming/events.rpy:2760
translate russian taming_event_03_c_c3992426:
    ayesha.say "Вот так!"

# ch/harems_full/taming/events.rpy:2761
translate russian taming_event_03_c_d657b0ad:
    ayesha.say "Вот как пускают блинчики, Кайли."

# ch/harems_full/taming/events.rpy:2762
translate russian taming_event_03_c_9443faaf:
    kylie.say "О чём ты вообще, Айша?"

# ch/harems_full/taming/events.rpy:2763
translate russian taming_event_03_c_e11bdaf6:
    kylie.say "Мне не нужен урок по бросанию камней!"

# ch/harems_full/taming/events.rpy:2765
translate russian taming_event_03_c_4ce1aeec:
    kylie.say "Я просто разозлилась, потому что ударила палец, и всё!"

# ch/harems_full/taming/events.rpy:2767
translate russian taming_event_03_c_13d82709:
    "Есть хоть что-то, что эти двое не способны превратить в спор?"

# ch/harems_full/taming/events.rpy:2770
translate russian taming_event_03_c_95e8b395:
    "Может, пора кому-нибудь поставить обеих на место?"

# ch/harems_full/taming/events.rpy:2771
translate russian taming_event_03_c_5b1a562e:
    "С этой мыслью я наклоняюсь и тоже подбираю камень."

# ch/harems_full/taming/events.rpy:2772
translate russian taming_event_03_c_eef87b04:
    "Затем плечами протискиваюсь между Айшей и Кайли."

# ch/harems_full/taming/events.rpy:2775
translate russian taming_event_03_c_7e2ea35b:
    ayesha.say "Эй!"

# ch/harems_full/taming/events.rpy:2776
translate russian taming_event_03_c_958f3f77:
    kylie.say "Какого..."

# ch/harems_full/taming/events.rpy:2777
translate russian taming_event_03_c_b1e2399f:
    mike.say "Так, выступление любителей окончено!"

# ch/harems_full/taming/events.rpy:2778
translate russian taming_event_03_c_1b2b8222:
    mike.say "Отойдите, сейчас покажу, как это делается."

# ch/harems_full/taming/events.rpy:2779
translate russian taming_event_03_c_fcdb8e9c:
    "Слышу недовольные возгласы и фырканье девушек."

# ch/harems_full/taming/events.rpy:2780
translate russian taming_event_03_c_2219eb27:
    "Но выбрасываю их из головы, готовясь к броску."

# ch/harems_full/taming/events.rpy:2781
translate russian taming_event_03_c_bea9e422:
    "И запускаю свой камень по воде."

# ch/harems_full/taming/events.rpy:2782
translate russian taming_event_03_c_21c48a62:
    "Он пролетает по воздуху и касается волн."

# ch/harems_full/taming/events.rpy:2783
translate russian taming_event_03_c_f4cb1bd3:
    "После чего идеально скачет по поверхности!"

# ch/harems_full/taming/events.rpy:2784
translate russian taming_event_03_c_1cb51987:
    mike.say "Что я говорил!"

# ch/harems_full/taming/events.rpy:2785
translate russian taming_event_03_c_a947b4b5:
    mike.say "Вот как, чёрт возьми, пускают блинчики!"

# ch/harems_full/taming/events.rpy:2786
translate russian taming_event_03_c_fbf0ea0f:
    ayesha.say "Господи..."

# ch/harems_full/taming/events.rpy:2787
translate russian taming_event_03_c_bcae060d:
    ayesha.say "Вот хвастун!"

# ch/harems_full/taming/events.rpy:2788
translate russian taming_event_03_c_00bc4646:
    kylie.say "И что мне с того, [lssb_common.hero_name()]?"

# ch/harems_full/taming/events.rpy:2789
translate russian taming_event_03_c_65262dce:
    kylie.say "Я вообще не пыталась пускать блинчики!"

# ch/harems_full/taming/events.rpy:2794
translate russian taming_event_03_c_92eb21ca:
    "Может, я сумею разрядить обстановку?"

# ch/harems_full/taming/events.rpy:2795
translate russian taming_event_03_c_5b1a562e_1:
    "С этой мыслью я наклоняюсь и тоже подбираю камень."

# ch/harems_full/taming/events.rpy:2796
translate russian taming_event_03_c_eef87b04_1:
    "Затем плечами протискиваюсь между Айшей и Кайли."

# ch/harems_full/taming/events.rpy:2799
translate russian taming_event_03_c_7e2ea35b_1:
    ayesha.say "Эй!"

# ch/harems_full/taming/events.rpy:2800
translate russian taming_event_03_c_958f3f77_1:
    kylie.say "Какого..."

# ch/harems_full/taming/events.rpy:2801
translate russian taming_event_03_c_b1e2399f_1:
    mike.say "Так, выступление любителей окончено!"

# ch/harems_full/taming/events.rpy:2802
translate russian taming_event_03_c_1b2b8222_1:
    mike.say "Отойдите, сейчас покажу, как это делается."

# ch/harems_full/taming/events.rpy:2803
translate russian taming_event_03_c_fcdb8e9c_1:
    "Слышу недовольные возгласы и фырканье девушек."

# ch/harems_full/taming/events.rpy:2804
translate russian taming_event_03_c_2219eb27_1:
    "Но выбрасываю их из головы, готовясь к броску."

# ch/harems_full/taming/events.rpy:2805
translate russian taming_event_03_c_bea9e422_1:
    "И запускаю свой камень по воде."

# ch/harems_full/taming/events.rpy:2806
translate russian taming_event_03_c_21c48a62_1:
    "Он пролетает по воздуху и касается волн."

# ch/harems_full/taming/events.rpy:2807
translate russian taming_event_03_c_642e8301:
    "После чего тонет как... ну, как камень."

# ch/harems_full/taming/events.rpy:2808
translate russian taming_event_03_c_3998d21a:
    ayesha.say "Ого..."

# ch/harems_full/taming/events.rpy:2810
translate russian taming_event_03_c_4b00fa38:
    ayesha.say "Как-то даже неловко!"

# ch/harems_full/taming/events.rpy:2811
translate russian taming_event_03_c_69d4f075:
    kylie.say "Боже мой, [lssb_common.hero_name()]!"

# ch/harems_full/taming/events.rpy:2813
translate russian taming_event_03_c_c93e18f3:
    kylie.say "Мой дальше улетел."

# ch/harems_full/taming/events.rpy:2814
translate russian taming_event_03_c_171ee2a8:
    kylie.say "А я ведь даже не старалась!"

# ch/harems_full/taming/events.rpy:2816
translate russian taming_event_03_c_ef4094b3:
    mike.say "Я не был готов!"

# ch/harems_full/taming/events.rpy:2817
translate russian taming_event_03_c_8a952784:
    mike.say "Сейчас только найду другой камень..."

# ch/harems_full/taming/events.rpy:2820
translate russian taming_event_03_c_952913b6:
    ayesha.say "Думаю, одного хватит, [lssb_common.hero_name()]!"

# ch/harems_full/taming/events.rpy:2821
translate russian taming_event_03_c_31d995e5:
    kylie.say "Да, давайте на этом закончим!"

# ch/harems_full/taming/events.rpy:2822
translate russian taming_event_03_c_54ad2655:
    "Я нехотя киваю и иду следом за девушками."

# ch/harems_full/taming/events.rpy:2823
translate russian taming_event_03_c_2bb26bc8:
    "Но, дождавшись, когда они отвернутся, позволяю себе хитрую улыбку."

# ch/harems_full/taming/events.rpy:2824
translate russian taming_event_03_c_cfcd471d:
    "Конечно, чтобы далеко пустить блинчик, нужна сноровка."

# ch/harems_full/taming/events.rpy:2825
translate russian taming_event_03_c_40e4deb8:
    "Но чтобы убедительно изобразить настолько плохой бросок, нужно настоящее мастерство!"

# ch/harems_full/taming/events.rpy:2826
translate russian taming_event_03_c_683d5361:
    "А дома я был бесспорным чемпионом по пусканию блинчиков!"

# ch/harems_full/taming/events.rpy:2829
translate russian taming_event_03_c_e9c67bc2:
    "Наверное, сейчас мне следовало бы беспокоиться о пальце Кайли."

# ch/harems_full/taming/events.rpy:2832
translate russian taming_event_03_c_321126d6:
    "Но в детстве я обожал пускать блинчики и потому совершенно увлечён."

# ch/harems_full/taming/events.rpy:2833
translate russian taming_event_03_c_20a90e6d:
    "Айша бросила и правда здорово, и мне хочется понять, как она это сделала."

# ch/harems_full/taming/events.rpy:2834
translate russian taming_event_03_c_5a3afcc7:
    mike.say "Давно не видел такого отличного броска, Айша!"

# ch/harems_full/taming/events.rpy:2835
translate russian taming_event_03_c_6ea9e100:
    mike.say "У тебя настоящий талант!"

# ch/harems_full/taming/events.rpy:2836
translate russian taming_event_03_c_6014d804:
    mike.say "Ты просто обязана меня научить!"

# ch/harems_full/taming/events.rpy:2837
translate russian taming_event_03_c_d8e314c4:
    ayesha.say "Конечно, [lssb_common.hero_name()]."

# ch/harems_full/taming/events.rpy:2839
translate russian taming_event_03_c_971a5caa:
    ayesha.say "На самом деле это не так уж сложно."

# ch/harems_full/taming/events.rpy:2840
translate russian taming_event_03_c_db816a60:
    ayesha.say "Нужно просто вовремя отпустить камень..."

# ch/harems_full/taming/events.rpy:2841
translate russian taming_event_03_c_dd7c180a:
    "Я наклоняюсь поближе, пока Айша показывает свою технику."

# ch/harems_full/taming/events.rpy:2842
translate russian taming_event_03_c_2eb8eb55:
    "И увлекаюсь настолько, что совсем забываю о Кайли."

# ch/harems_full/taming/events.rpy:2843
translate russian taming_event_03_c_1fb5ef94:
    kylie.say "Кхм..."

# ch/harems_full/taming/events.rpy:2845
translate russian taming_event_03_c_335a43ba:
    kylie.say "Эй, алло?"

# ch/harems_full/taming/events.rpy:2846
translate russian taming_event_03_c_2696bb5d:
    kylie.say "Я что, невидимой стала?!"

# ch/harems_full/taming/events.rpy:2847
translate russian taming_event_03_c_adbcc819:
    "Мы с Айшей поднимаем глаза и видим, что Кайли испепеляет нас взглядом."

# ch/harems_full/taming/events.rpy:2848
translate russian taming_event_03_c_96ca475d:
    "Руки у неё скрещены на груди."

# ch/harems_full/taming/events.rpy:2849
translate russian taming_event_03_c_265e8009:
    "Но боль в пальце, кажется, немного утихла."

# ch/harems_full/taming/events.rpy:2850
translate russian taming_event_03_c_c50cf8c1:
    "По крайней мере настолько, что Кайли топает ногой и сердито уходит вдоль пляжа."

# ch/harems_full/taming/events.rpy:2853
translate russian taming_event_03_c_420272c5:
    "Меня сейчас и правда беспокоит палец Кайли."

# ch/harems_full/taming/events.rpy:2856
translate russian taming_event_03_c_f2ed863c:
    "Вдруг она его сломала и мне придётся нести её до машины?"

# ch/harems_full/taming/events.rpy:2857
translate russian taming_event_03_c_3e576043:
    mike.say "Господи, Айша!"

# ch/harems_full/taming/events.rpy:2858
translate russian taming_event_03_c_2296c312:
    mike.say "Тебе обязательно превращать всё в соревнование?"

# ch/harems_full/taming/events.rpy:2859
translate russian taming_event_03_c_c44b7040:
    ayesha.say "Я..."

# ch/harems_full/taming/events.rpy:2861
translate russian taming_event_03_c_3bd601e3:
    ayesha.say "Прости, [lssb_common.hero_name()]..."

# ch/harems_full/taming/events.rpy:2862
translate russian taming_event_03_c_3be893a0:
    ayesha.say "Я не подумала!"

# ch/harems_full/taming/events.rpy:2863
translate russian taming_event_03_c_7d0c0580:
    "Кайли не упускает возможности воспользоваться моим сочувствием."

# ch/harems_full/taming/events.rpy:2864
translate russian taming_event_03_c_dc2c9451:
    "И заодно ещё раз задеть Айшу!"

# ch/harems_full/taming/events.rpy:2866
translate russian taming_event_03_c_34792262:
    kylie.say "Ай-ай-ай!"

# ch/harems_full/taming/events.rpy:2867
translate russian taming_event_03_c_2f0a8b1f:
    kylie.say "Всё ещё больно, [lssb_common.hero_name()]!"

# ch/harems_full/taming/events.rpy:2869
translate russian taming_event_03_c_594855db:
    kylie.say "Но, думаю, идти я смогу."

# ch/harems_full/taming/events.rpy:2871
translate russian taming_event_03_c_3bfb74aa:
    "Пока я вожусь с Кайли, она щурится и улыбается Айше."

# ch/harems_full/taming/events.rpy:2872
translate russian taming_event_03_c_8797d559:
    "Настолько выразительно, что я начинаю сомневаться, так ли сильно она ушиблась."

# ch/harems_full/taming/events.rpy:2873
translate russian taming_event_03_c_707a6b69:
    "Айша хмурится и отводит взгляд."

# ch/harems_full/taming/events.rpy:2875
translate russian taming_event_03_c_7afc741d:
    "Мы гуляем уже довольно долго и прошли почти весь пляж."

# ch/harems_full/taming/events.rpy:2876
translate russian taming_event_03_c_9b72f20d:
    "Наверное, скоро пора заканчивать вечер и ехать домой."

# ch/harems_full/taming/events.rpy:2879
translate russian taming_event_03_c_5d964c8a:
    "Разговор уже какое-то время перескакивает с темы на тему."

# ch/harems_full/taming/events.rpy:2880
translate russian taming_event_03_c_7ee6ae53:
    "Честно говоря, я даже не вполне понимаю, о чём мы теперь говорим."

# ch/harems_full/taming/events.rpy:2881
translate russian taming_event_03_c_41b4ace3:
    "Впрочем, стоит поднять взгляд на луну, как я совсем теряю интерес к беседе."

# ch/harems_full/taming/events.rpy:2883
translate russian taming_event_03_c_688c7ef2:
    mike.say "Как мы раньше этого не заметили?"

# ch/harems_full/taming/events.rpy:2884
translate russian taming_event_03_c_0fe501f3:
    ayesha.say "Не заметили чего, [lssb_common.hero_name()]?"

# ch/harems_full/taming/events.rpy:2885
translate russian taming_event_03_c_5d860ba8:
    kylie.say "Да, о чём ты?"

# ch/harems_full/taming/events.rpy:2886
translate russian taming_event_03_c_ffc626db:
    mike.say "Луна, девушки!"

# ch/harems_full/taming/events.rpy:2887
translate russian taming_event_03_c_a9f7e5c6:
    mike.say "Она совершенно полная!"

# ch/harems_full/taming/events.rpy:2888
translate russian taming_event_03_c_75bd9b46:
    mike.say "Вы только посмотрите!"

# ch/harems_full/taming/events.rpy:2889
translate russian taming_event_03_c_2af88408:
    "Айша и Кайли послушно поднимают глаза к небу."

# ch/harems_full/taming/events.rpy:2890
translate russian taming_event_03_c_5de99c41:
    ayesha.say "Ты прав, она огромная!"

# ch/harems_full/taming/events.rpy:2891
translate russian taming_event_03_c_aa508e75:
    kylie.say "Не помню, чтобы она когда-нибудь была такой большой!"

# ch/harems_full/taming/events.rpy:2892
translate russian taming_event_03_c_2d020930:
    mike.say "А знаете что..."

# ch/harems_full/taming/events.rpy:2893
translate russian taming_event_03_c_257cdff9:
    mike.say "Нужно загадать желание!"

# ch/harems_full/taming/events.rpy:2896
translate russian taming_event_03_c_83f3b255:
    "Айша и Кайли переводят взгляд с луны на меня."

# ch/harems_full/taming/events.rpy:2897
translate russian taming_event_03_c_4de93b23:
    "Моё предложение явно их забавляет: обе усмехаются и хихикают."

# ch/harems_full/taming/events.rpy:2898
translate russian taming_event_03_c_aa4d4d65:
    kylie.say "О чём ты вообще, [lssb_common.hero_name()]?"

# ch/harems_full/taming/events.rpy:2900
translate russian taming_event_03_c_dd105ae5:
    kylie.say "Никто не загадывает желания на луну!"

# ch/harems_full/taming/events.rpy:2901
translate russian taming_event_03_c_3bb0b618:
    ayesha.say "Она права, [lssb_common.hero_name()]."

# ch/harems_full/taming/events.rpy:2903
translate russian taming_event_03_c_f92d810d:
    ayesha.say "Ты перепутал со звёздами!"

# ch/harems_full/taming/events.rpy:2906
translate russian taming_event_03_c_f392b614:
    "Пока они смеются надо мной, я начинаю хмуриться."

# ch/harems_full/taming/events.rpy:2907
translate russian taming_event_03_c_40046a10:
    "Может, на полную луну и не принято загадывать желания."

# ch/harems_full/taming/events.rpy:2908
translate russian taming_event_03_c_84b9ffa2:
    "Но мне показалось, что это романтично, понимаете?"

# ch/harems_full/taming/events.rpy:2909
translate russian taming_event_03_c_f742f712:
    "Прекрасное завершение свидания!"

# ch/harems_full/taming/events.rpy:2912
translate russian taming_event_03_c_4e5f6198:
    mike.say "Разве женщины не упрекают нас постоянно за недостаток романтики?"

# ch/harems_full/taming/events.rpy:2913
translate russian taming_event_03_c_d752b40b:
    mike.say "А стоит кому-то из нас попробовать — и вот результат!"

# ch/harems_full/taming/events.rpy:2914
translate russian taming_event_03_c_f7c9dc9f:
    mike.say "Вы тут же всё высмеиваете!"

# ch/harems_full/taming/events.rpy:2917
translate russian taming_event_03_c_204971f5:
    "Качая головой, я немного отхожу от них."

# ch/harems_full/taming/events.rpy:2918
translate russian taming_event_03_c_0102dff5:
    mike.say "Да ну вас обеих."

# ch/harems_full/taming/events.rpy:2919
translate russian taming_event_03_c_9e4d8c17:
    mike.say "Загадаю сам!"

# ch/harems_full/taming/events.rpy:2920
translate russian taming_event_03_c_ebc9c999:
    ayesha.say "Делай как знаешь, [lssb_common.hero_name()]."

# ch/harems_full/taming/events.rpy:2921
translate russian taming_event_03_c_bc9c3a7f:
    ayesha.say "Лишь бы тебе стало легче!"

# ch/harems_full/taming/events.rpy:2922
translate russian taming_event_03_c_55b1ed4f:
    kylie.say "Только не задерживайся."

# ch/harems_full/taming/events.rpy:2923
translate russian taming_event_03_c_78565555:
    kylie.say "Тут ещё ракушка есть. Потом можешь загадать на неё."

# ch/harems_full/taming/events.rpy:2924
translate russian taming_event_03_c_76a026f2:
    kylie.say "Или на один из мусорных баков на парковке?"

# ch/harems_full/taming/events.rpy:2925
translate russian taming_event_03_c_1d813c0a:
    "Я изо всех сил стараюсь не слушать Айшу и Кайли."

# ch/harems_full/taming/events.rpy:2926
translate russian taming_event_03_c_3feb8841:
    "Но, как ни стараюсь, всё равно чувствую себя дураком."

# ch/harems_full/taming/events.rpy:2932
translate russian taming_event_03_c_6001eeec:
    mike.say "Теперь, когда вы сказали, идея и правда довольно дурацкая!"

# ch/harems_full/taming/events.rpy:2935
translate russian taming_event_03_c_d8981bf9:
    "Айша и Кайли с улыбками кивают, принимая моё поражение."

# ch/harems_full/taming/events.rpy:2936
translate russian taming_event_03_c_201cc1fa:
    "Каждая берёт меня под руку, и они ведут меня дальше по пляжу."

# ch/harems_full/taming/events.rpy:2937
translate russian taming_event_03_c_1a9cf055:
    "Конечно, обидно, что обе раскритиковали мою идею."

# ch/harems_full/taming/events.rpy:2938
translate russian taming_event_03_c_10ef44c8:
    "Но я достаточно взрослый, чтобы спокойно это пережить."

# ch/harems_full/taming/events.rpy:2939
translate russian taming_event_03_c_1d83fea5:
    "Особенно если в итоге они решат, что сумели меня одолеть."

# ch/harems_full/taming/events.rpy:2940
translate russian taming_event_03_c_6f3c8b1e:
    "Заметив, что мы идём без ссор, я даже позволяю себе лёгкую усмешку."

# ch/harems_full/taming/events.rpy:2941
translate russian taming_event_03_c_b32eb9b2:
    "Неважно, что думают Айша и Кайли."

# ch/harems_full/taming/events.rpy:2942
translate russian taming_event_03_c_6de953b8:
    "Я-то знаю, что сам решил уступить, а вовсе не проиграл им."

# ch/harems_full/taming/events.rpy:2947
translate russian taming_event_03_c_40cb7c0f:
    mike.say "От Кайли я ещё мог ожидать, что она высмеет эту идею."

# ch/harems_full/taming/events.rpy:2948
translate russian taming_event_03_c_3001b2ea:
    mike.say "Но от тебя, Айша, ждал большего!"

# ch/harems_full/taming/events.rpy:2950
translate russian taming_event_03_c_aa10611c:
    ayesha.say "Ч-что?!"

# ch/harems_full/taming/events.rpy:2952
translate russian taming_event_03_c_6d222830:
    ayesha.say "Что ты имеешь в виду?"

# ch/harems_full/taming/events.rpy:2953
translate russian taming_event_03_c_b534490c:
    mike.say "Это ведь ты постоянно говоришь, что мне нужно быть чутче."

# ch/harems_full/taming/events.rpy:2954
translate russian taming_event_03_c_6525d51b:
    mike.say "Что я должен лучше понимать свои чувства."

# ch/harems_full/taming/events.rpy:2955
translate russian taming_event_03_c_cf76e573:
    mike.say "Так почему бы тебе хоть раз не подкрепить слова делом и не поддержать меня?!"

# ch/harems_full/taming/events.rpy:2956
translate russian taming_event_03_c_9e729d34:
    "Я решительно иду дальше по пляжу."

# ch/harems_full/taming/events.rpy:2957
translate russian taming_event_03_c_4001ce4e:
    "Айша спешит следом."

# ch/harems_full/taming/events.rpy:2958
translate russian taming_event_03_c_24bb062e:
    ayesha.say "Погоди..."

# ch/harems_full/taming/events.rpy:2960
translate russian taming_event_03_c_2ad9280a:
    ayesha.say "Я не хотела..."

# ch/harems_full/taming/events.rpy:2961
translate russian taming_event_03_c_99db5223:
    ayesha.say "Я могу объяснить!"

# ch/harems_full/taming/events.rpy:2962
translate russian taming_event_03_c_8d00ecd0:
    "Кайли идёт за нами медленнее."

# ch/harems_full/taming/events.rpy:2963
translate russian taming_event_03_c_8a01602e:
    "Наверное, надеется создать впечатление, что уважает нашу личную беседу."

# ch/harems_full/taming/events.rpy:2964
translate russian taming_event_03_c_72208319:
    "Но я прекрасно знаю: ей не терпится посмотреть на скандал между мной и Айшей."

# ch/harems_full/taming/events.rpy:2967
translate russian taming_event_03_c_3f0d529f:
    mike.say "От Айши я ещё мог ожидать, что она высмеет эту идею."

# ch/harems_full/taming/events.rpy:2970
translate russian taming_event_03_c_3f92c0a7:
    mike.say "Но от тебя, Кайли, ждал большего!"

# ch/harems_full/taming/events.rpy:2972
translate russian taming_event_03_c_82b3804f:
    kylie.say "Ч-что?!"

# ch/harems_full/taming/events.rpy:2973
translate russian taming_event_03_c_44e36c65:
    kylie.say "Что ты имеешь в виду?"

# ch/harems_full/taming/events.rpy:2974
translate russian taming_event_03_c_b7cbac42:
    mike.say "Это ведь ты постоянно говоришь, как сильно меня любишь."

# ch/harems_full/taming/events.rpy:2975
translate russian taming_event_03_c_17e56430:
    mike.say "Что я мужчина твоей мечты и нам суждено быть вместе."

# ch/harems_full/taming/events.rpy:2976
translate russian taming_event_03_c_74ddcefa:
    mike.say "Так почему бы тебе хоть раз не повести себя соответственно и не поддержать меня?!"

# ch/harems_full/taming/events.rpy:2977
translate russian taming_event_03_c_9e729d34_1:
    "Я решительно иду дальше по пляжу."

# ch/harems_full/taming/events.rpy:2978
translate russian taming_event_03_c_1d6d6041:
    "Кайли спешит следом."

# ch/harems_full/taming/events.rpy:2979
translate russian taming_event_03_c_1755448d:
    kylie.say "Погоди..."

# ch/harems_full/taming/events.rpy:2981
translate russian taming_event_03_c_068f0954:
    kylie.say "Я не хотела..."

# ch/harems_full/taming/events.rpy:2982
translate russian taming_event_03_c_3b0e6945:
    kylie.say "Я могу объяснить!"

# ch/harems_full/taming/events.rpy:2983
translate russian taming_event_03_c_f40a4727:
    "Айша идёт за нами медленнее."

# ch/harems_full/taming/events.rpy:2984
translate russian taming_event_03_c_8a01602e_1:
    "Наверное, надеется создать впечатление, что уважает нашу личную беседу."

# ch/harems_full/taming/events.rpy:2985
translate russian taming_event_03_c_2909f534:
    "Но я прекрасно знаю: ей не терпится посмотреть на скандал между мной и Кайли."

# ch/harems_full/taming/events.rpy:2987
translate russian taming_event_03_c_2fbf6706:
    "Вернувшись к машине, я пытаюсь понять настроение девушек."

# ch/harems_full/taming/events.rpy:2990
translate russian taming_event_03_c_9a739b0d:
    "По-моему, учитывая обстоятельства, свидание прошло довольно хорошо."

# ch/harems_full/taming/events.rpy:2991
translate russian taming_event_03_c_ce4d2e07:
    "И заканчивать его прямо сейчас я ещё не готов."

# ch/harems_full/taming/events.rpy:2993
translate russian taming_event_03_c_32c9ddd3:
    mike.say "Ну как вам?"

# ch/harems_full/taming/events.rpy:2994
translate russian taming_event_03_c_8994282a:
    mike.say "Я отлично провёл время!"

# ch/harems_full/taming/events.rpy:2996
translate russian taming_event_03_c_48666191:
    ayesha.say "Очнись, [lssb_common.hero_name()]!"

# ch/harems_full/taming/events.rpy:2998
translate russian taming_event_03_c_d44bba02:
    ayesha.say "Это была катастрофа от начала до конца!"

# ch/harems_full/taming/events.rpy:2999
translate russian taming_event_03_c_7ad56b88:
    kylie.say "Она права, это было ужасно!"

# ch/harems_full/taming/events.rpy:3001
translate russian taming_event_03_c_52eb31f8:
    kylie.say "Мне понадобится время, чтобы прийти в себя!"

# ch/harems_full/taming/events.rpy:3009
translate russian taming_event_03_c_c980ddfc:
    "Я смотрю, как Айша и Кайли забираются в машину."

# ch/harems_full/taming/events.rpy:3010
translate russian taming_event_03_c_3be11f5d:
    "И на мгновение остаюсь наедине со своими мыслями."

# ch/harems_full/taming/events.rpy:3011
translate russian taming_event_03_c_d9d6e1b2:
    "Неужели всё и правда прошло настолько плохо?"

# ch/harems_full/taming/events.rpy:3012
translate russian taming_event_03_c_5b78c2a5:
    "И если да, почему я не заметил?"

# ch/harems_full/taming/events.rpy:3013
translate russian taming_event_03_c_c6ad920a:
    "В следующий раз придётся постараться получше."

# ch/harems_full/taming/events.rpy:3014
translate russian taming_event_03_c_741abdbd:
    "Нужно выходить на новый уровень!"

# ch/harems_full/taming/events.rpy:3017
translate russian taming_event_03_c_87310cf9:
    ayesha.say "Я отлично провела время, [lssb_common.hero_name()]."

# ch/harems_full/taming/events.rpy:3019
translate russian taming_event_03_c_91ce9f01:
    ayesha.say "Если честно, мне не хочется, чтобы всё уже заканчивалось."

# ch/harems_full/taming/events.rpy:3020
translate russian taming_event_03_c_a3de0264:
    kylie.say "Мне тоже, [lssb_common.hero_name()]."

# ch/harems_full/taming/events.rpy:3022
translate russian taming_event_03_c_04512386:
    kylie.say "Я тоже не хочу, чтобы веселье закончилось!"

# ch/harems_full/taming/events.rpy:3024
translate russian taming_event_03_c_7fadd686:
    mike.say "Может, тогда поедем ко мне?"

# ch/harems_full/taming/events.rpy:3025
translate russian taming_event_03_c_f16b653c:
    ayesha.say "Отличная идея!"

# ch/harems_full/taming/events.rpy:3026
translate russian taming_event_03_c_6ad6acba:
    kylie.say "Да, я за!"

# ch/harems_full/taming/events.rpy:3027
translate russian taming_event_03_c_0bcac88d:
    "Отправляясь домой, я улыбаюсь во весь рот."

# ch/harems_full/taming/events.rpy:3028
translate russian taming_event_03_c_123eb4a6:
    "Айша и Кайли едут со мной."

# ch/harems_full/taming/events.rpy:3029
translate russian taming_event_03_c_9921a0c7:
    "А мысли уже мчатся вперёд: что же мы ещё устроим!"

# ch/harems_full/taming/events.rpy:3036
translate russian taming_event_03_c_d31c930f:
    ayesha.say "Сегодня вечером было довольно здорово."

# ch/harems_full/taming/events.rpy:3037
translate russian taming_event_03_c_c731ce6a:
    ayesha.say "Нужно будет вскоре повторить."

# ch/harems_full/taming/events.rpy:3038
translate russian taming_event_03_c_3c771299:
    kylie.say "Да, мне тоже понравилось."

# ch/harems_full/taming/events.rpy:3039
translate russian taming_event_03_c_46ca8205:
    kylie.say "Сообщи, когда соберёмся в следующий раз."

# ch/harems_full/taming/events.rpy:3047
translate russian taming_event_03_c_ceda4c87:
    "Я улыбаюсь, глядя, как Айша и Кайли садятся в машину."

# ch/harems_full/taming/events.rpy:3048
translate russian taming_event_03_c_9f09c363:
    "Да, свидание закончено. Развезу их и поеду домой один."

# ch/harems_full/taming/events.rpy:3049
translate russian taming_event_03_c_edce3058:
    "Но зато впереди новое свидание с ними."

# ch/harems_full/taming/events.rpy:3050
translate russian taming_event_03_c_114ca050:
    "И я решительно намерен сделать его ещё лучше!"

# ch/harems_full/taming/events.rpy:3060
translate russian taming_event_04_33724da8:
    "Обычно я с нетерпением жду прихода Кайли, чтобы немного развлечься в моей спальне."

# ch/harems_full/taming/events.rpy:3061
translate russian taming_event_04_a1ba4b41:
    "Тем более что Айша уже здесь и мы собираемся провести время втроём."

# ch/harems_full/taming/events.rpy:3062
translate russian taming_event_04_8f2dad71:
    "Но сейчас я почти физически ощущаю тревогу Айши, пока мы ждём."

# ch/harems_full/taming/events.rpy:3063
translate russian taming_event_04_99630aa6:
    "И винить её трудно: Кайли ясно дала понять, что приготовила «сюрприз»."

# ch/harems_full/taming/events.rpy:3064
translate russian taming_event_04_1badefca:
    "Будь это кто-то другой, мы бы строили догадки и с нетерпением ждали разгадки."

# ch/harems_full/taming/events.rpy:3065
translate russian taming_event_04_839f1f7e:
    "Но Кайли и в лучшие времена немного с приветом, понимаете?"

# ch/harems_full/taming/events.rpy:3066
translate russian taming_event_04_e3992af4:
    "Часть меня опасается, что она заявится с коробкой, в которой лежит отрубленная голова!"

# ch/harems_full/taming/events.rpy:3067
translate russian taming_event_04_0b1aff4a:
    "Ну, может, и не с чем-то настолько безумным!"

# ch/harems_full/taming/events.rpy:3068
translate russian taming_event_04_fd92d689:
    "Она ведь не психопатка, правда?"

# ch/harems_full/taming/events.rpy:3069
translate russian taming_event_04_0dd104aa:
    mike.say "Не волнуйся, Айша."

# ch/harems_full/taming/events.rpy:3070
translate russian taming_event_04_ece0f976:
    mike.say "Уверен, всё будет хорошо."

# ch/harems_full/taming/events.rpy:3071
translate russian taming_event_04_b9d23eae:
    "Айша поднимает на меня взгляд, сидя на кровати."

# ch/harems_full/taming/events.rpy:3073
translate russian taming_event_04_61f68335:
    "В её глазах настоящая тревога."

# ch/harems_full/taming/events.rpy:3074
translate russian taming_event_04_79863e5e:
    "Странно видеть настолько сильного физически человека таким встревоженным."

# ch/harems_full/taming/events.rpy:3075
translate russian taming_event_04_9618bf75:
    ayesha.say "Я... наверное, ты прав, [lssb_common.hero_name()]."

# ch/harems_full/taming/events.rpy:3076
translate russian taming_event_04_bf73809b:
    ayesha.say "В последнее время Кайли ведёт себя гораздо спокойнее."

# ch/harems_full/taming/events.rpy:3077
translate russian taming_event_04_e03b3944:
    ayesha.say "Просто... обещай меня защитить, ладно?"

# ch/harems_full/taming/events.rpy:3078
translate russian taming_event_04_455913c5:
    mike.say "Обещаю, Айша."

# ch/harems_full/taming/events.rpy:3079
translate russian taming_event_04_4594dd95:
    mike.say "Со мной ты в безопасности, хорошо?"

# ch/harems_full/taming/events.rpy:3081
translate russian taming_event_04_07887e56:
    "Айша кивает, и в её лице появляется немного надежды."

# ch/harems_full/taming/events.rpy:3083
translate russian taming_event_04_3a69242a:
    "Но тут дверь распахивается, и в комнату уверенно входит Кайли."

# ch/harems_full/taming/events.rpy:3085
translate russian taming_event_04_79cbffd0:
    kylie.say "Привет, народ..."

# ch/harems_full/taming/events.rpy:3086
translate russian taming_event_04_52e484f3:
    kylie.say "Простите, что немного опоздала."

# ch/harems_full/taming/events.rpy:3087
translate russian taming_event_04_81e55d5a:
    kylie.say "Пришлось покопаться в шкафу, чтобы всё это найти!"

# ch/harems_full/taming/events.rpy:3091
translate russian taming_event_04_7a20ee97:
    "Словно в подтверждение своих слов, Кайли высыпает содержимое сумки на кровать."

# ch/harems_full/taming/events.rpy:3092
translate russian taming_event_04_4173a594:
    "Айша инстинктивно отодвигается, когда вещи падают рядом с ней."

# ch/harems_full/taming/events.rpy:3093
translate russian taming_event_04_9a1785ff:
    "Я замечаю что-то похожее на повязку для глаз и даже весьма внушительный фаллоимитатор."

# ch/harems_full/taming/events.rpy:3094
translate russian taming_event_04_01e59a84:
    "Но большую часть содержимого составляют верёвки."

# ch/harems_full/taming/events.rpy:3095
translate russian taming_event_04_3dbc20b4:
    "Причём хорошие, явно недешёвые верёвки."

# ch/harems_full/taming/events.rpy:3096
translate russian taming_event_04_26ab4522:
    "Я вижу, как Айша на всё это смотрит."

# ch/harems_full/taming/events.rpy:3097
translate russian taming_event_04_b89f57d4:
    "Достаточно сказать, что её страхи ничуть не развеялись."

# ch/harems_full/taming/events.rpy:3098
translate russian taming_event_04_88c361b9:
    "Поэтому пытаюсь вмешаться и выяснить, что происходит."

# ch/harems_full/taming/events.rpy:3099
translate russian taming_event_04_56c8c927:
    mike.say "Для чего всё это, Кайли?"

# ch/harems_full/taming/events.rpy:3100
translate russian taming_event_04_6e93c296:
    mike.say "Будешь учить нас вязать узлы?"

# ch/harems_full/taming/events.rpy:3101
translate russian taming_event_04_2059c246:
    mike.say "По-моему, мы уже немного великоваты для игры в бойскаутов!"

# ch/harems_full/taming/events.rpy:3103
translate russian taming_event_04_ee20466f:
    "Кайли закатывает глаза."

# ch/harems_full/taming/events.rpy:3105
translate russian taming_event_04_256dc1b7:
    kylie.say "Мы будем играть с узлами."

# ch/harems_full/taming/events.rpy:3107
translate russian taming_event_04_11361edc:
    kylie.say "Но эти игры строго для взрослых."

# ch/harems_full/taming/events.rpy:3108
translate russian taming_event_04_fa9b7410:
    kylie.say "Я научу вас обоих бондажу!"

# ch/harems_full/taming/events.rpy:3109
translate russian taming_event_04_58f25247:
    ayesha.say "О нет!"

# ch/harems_full/taming/events.rpy:3111
translate russian taming_event_04_4b0cf125:
    ayesha.say "Связывать меня ты точно не будешь!"

# ch/harems_full/taming/events.rpy:3112
translate russian taming_event_04_1003b633:
    kylie.say "Господи, Айша, успокойся!"

# ch/harems_full/taming/events.rpy:3114
translate russian taming_event_04_d657af9d:
    kylie.say "Я хочу, чтобы вы связали меня, а не наоборот."

# ch/harems_full/taming/events.rpy:3116
translate russian taming_event_04_66a4c0d1:
    kylie.say "Ни за что не стала бы начинать со связывания новичка!"

# ch/harems_full/taming/events.rpy:3117
translate russian taming_event_04_04d3205d:
    mike.say "По-моему, звучит неплохо, Айша."

# ch/harems_full/taming/events.rpy:3118
translate russian taming_event_04_e3b09b25:
    mike.say "Кайли покажет нам что-нибудь новое и интересное."

# ch/harems_full/taming/events.rpy:3119
translate russian taming_event_04_c5d6d67b:
    mike.say "Причём делать это мы будем с ней. Что тут может не понравиться?"

# ch/harems_full/taming/events.rpy:3120
translate russian taming_event_04_900b5a5a:
    "Я всё ещё пытаюсь убедить Айшу и успокоить её."

# ch/harems_full/taming/events.rpy:3122
translate russian taming_event_04_bc326564:
    "Но теперь стараюсь сильнее ещё и из собственного интереса."

# ch/harems_full/taming/events.rpy:3123
translate russian taming_event_04_30a812cc:
    "Мысль связать Кайли и насладиться ею звучит прекрасно."

# ch/harems_full/taming/events.rpy:3124
translate russian taming_event_04_85e1a8fc:
    "Не хочется упускать такую возможность лишь из-за волнения Айши."

# ch/harems_full/taming/events.rpy:3125
translate russian taming_event_04_130aaca4:
    ayesha.say "Ладно, ладно..."

# ch/harems_full/taming/events.rpy:3127
translate russian taming_event_04_906b1df2:
    ayesha.say "Если связывать будем её."

# ch/harems_full/taming/events.rpy:3128
translate russian taming_event_04_9a165499:
    ayesha.say "Но если станет странно, я могу всё прекратить!"

# ch/harems_full/taming/events.rpy:3129
translate russian taming_event_04_57a1f09a:
    "Мы с Кайли согласно киваем, желая поскорее приступить."

# ch/harems_full/taming/events.rpy:3130
translate russian taming_event_04_30b15a4f:
    "Хотя я всё же гадаю, что именно Айша подразумевает под «странно»."

# ch/harems_full/taming/events.rpy:3131
translate russian taming_event_04_108ea733:
    "Кайли ведь уже согласилась, чтобы её связала настоящая амазонка."

# ch/harems_full/taming/events.rpy:3132
translate russian taming_event_04_40721118:
    "Куда уж страннее?"

# ch/harems_full/taming/events.rpy:3133
translate russian taming_event_04_a0b98714:
    kylie.say "Ну?"

# ch/harems_full/taming/events.rpy:3135
translate russian taming_event_04_d3d7fcf6:
    kylie.say "Чего ждёте?"

# ch/harems_full/taming/events.rpy:3136
translate russian taming_event_04_83e88ce8:
    kylie.say "Давайте начинать!"

# ch/harems_full/taming/events.rpy:3138
translate russian taming_event_04_b380db3a:
    "Мгновение спустя Кайли подаёт пример, начиная раздеваться."

# ch/harems_full/taming/events.rpy:3139
translate russian taming_event_04_dad4c925:
    "Мы с Айшей обмениваемся многозначительным взглядом. Надеюсь, он её немного успокоит."

# ch/harems_full/taming/events.rpy:3141
translate russian taming_event_04_da07a275:
    "Затем я тоже раздеваюсь, стараясь побудить её последовать примеру."

# ch/harems_full/taming/events.rpy:3142
translate russian taming_event_04_c7cfc0e8:
    "Айша так и делает, хотя всё ещё отстаёт от нас с Кайли."

# ch/harems_full/taming/events.rpy:3144
translate russian taming_event_04_90f9854e:
    "Кайли запрыгивает на кровать и тут же начинает давать указания."

# ch/harems_full/taming/events.rpy:3146
translate russian taming_event_04_99d6d13a:
    "Большую часть работы делаю я: Айша старается по возможности держаться в стороне."

# ch/harems_full/taming/events.rpy:3147
translate russian taming_event_04_24c9eff2:
    "Но несколько раз мне всё же приходится воспользоваться её силой."

# ch/harems_full/taming/events.rpy:3148
translate russian taming_event_04_bf28cc1d:
    "Мало-помалу, точно следуя указаниям Кайли, мы продвигаемся вперёд."

# ch/harems_full/taming/events.rpy:3149
translate russian taming_event_04_6fd7242d:
    "Сам я совершенно не знал бы, за что браться."

# ch/harems_full/taming/events.rpy:3150
translate russian taming_event_04_363430ae:
    "Но вскоре Кайли уже связана в весьма откровенной позе."

# ch/harems_full/taming/events.rpy:3151
translate russian taming_event_04_c33a15d0:
    "Её запястья связаны вместе и закреплены над головой."

# ch/harems_full/taming/events.rpy:3153
translate russian taming_event_04_c04113f6:
    "Лодыжки тоже подняты вверх, но широко разведены."

# ch/harems_full/taming/events.rpy:3154
translate russian taming_event_04_ff34d151:
    "Однако сильнее всего меня поражает то, насколько Кайли сейчас беспомощна."

# ch/harems_full/taming/events.rpy:3155
translate russian taming_event_04_576822ab:
    "Она невероятно доверяет нам с Айшей."

# ch/harems_full/taming/events.rpy:3156
translate russian taming_event_04_3becbd43:
    "Хотя, наверное, именно это и составляет немалую часть удовольствия."

# ch/harems_full/taming/events.rpy:3157
translate russian taming_event_04_a8e5f362:
    kylie.say "Вот так! Я полностью в вашей власти!"

# ch/harems_full/taming/events.rpy:3158
translate russian taming_event_04_e0fafee0:
    kylie.say "Ну и что вы со мной сделаете?"

# ch/harems_full/taming/events.rpy:3159
translate russian taming_event_04_b3e2fe7c:
    "Я смотрю на стоящую рядом Айшу."

# ch/harems_full/taming/events.rpy:3160
translate russian taming_event_04_d52a3f37:
    "Она начинает выглядеть немного увереннее."

# ch/harems_full/taming/events.rpy:3161
translate russian taming_event_04_b7922fb5:
    "Словно наконец осознаёт, что происходит."

# ch/harems_full/taming/events.rpy:3162
translate russian taming_event_04_fb0e11f4:
    "Я поднимаю повязку для глаз, показывая ей."

# ch/harems_full/taming/events.rpy:3163
translate russian taming_event_04_2afcb09f:
    mike.say "Начнём с главного, Айша."

# ch/harems_full/taming/events.rpy:3164
translate russian taming_event_04_15f812af:
    mike.say "Как думаешь, нам это понадобится?"

# ch/harems_full/taming/events.rpy:3167
translate russian taming_event_04_6eb156c1:
    "Айша какое-то время смотрит на Кайли сверху вниз."

# ch/harems_full/taming/events.rpy:3168
translate russian taming_event_04_a201fe84:
    "Затем словно замечает что-то в её глазах."

# ch/harems_full/taming/events.rpy:3169
translate russian taming_event_04_2d5b4dd3:
    "И что бы это ни было, оно помогает ей решиться."

# ch/harems_full/taming/events.rpy:3170
translate russian taming_event_04_3d8d81cf:
    ayesha.say "Да, [lssb_common.hero_name()]."

# ch/harems_full/taming/events.rpy:3171
translate russian taming_event_04_c643e89b:
    ayesha.say "Думаю, пригодится."

# ch/harems_full/taming/events.rpy:3172
translate russian taming_event_04_cc9a6240:
    ayesha.say "Пусть Кайли побудет в неведении. И в темноте!"

# ch/harems_full/taming/events.rpy:3173
translate russian taming_event_04_6ddc01a7:
    "Я мог бы поспорить с Айшей."

# ch/harems_full/taming/events.rpy:3174
translate russian taming_event_04_a40a2135:
    "Но на самом деле хочу, чтобы ей было как можно комфортнее."

# ch/harems_full/taming/events.rpy:3175
translate russian taming_event_04_b8d852a2:
    "Поэтому решаю, что лучше уступить ей в этом вопросе."

# ch/harems_full/taming/events.rpy:3176
translate russian taming_event_04_8b12cf1a:
    mike.say "Как скажешь, Айша..."

# ch/harems_full/taming/events.rpy:3177
translate russian taming_event_04_3fb8b1d4:
    "Я наклоняюсь и надеваю повязку на глаза Кайли."

# ch/harems_full/taming/events.rpy:3179
translate russian taming_event_04_4513c256:
    "Она не шевелится и подыгрывает без возражений."

# ch/harems_full/taming/events.rpy:3182
translate russian taming_event_04_6eb156c1_1:
    "Айша какое-то время смотрит на Кайли сверху вниз."

# ch/harems_full/taming/events.rpy:3183
translate russian taming_event_04_a201fe84_1:
    "Затем словно замечает что-то в её глазах."

# ch/harems_full/taming/events.rpy:3184
translate russian taming_event_04_2d5b4dd3_1:
    "И что бы это ни было, оно помогает ей решиться."

# ch/harems_full/taming/events.rpy:3185
translate russian taming_event_04_6898cac7:
    ayesha.say "Нет, [lssb_common.hero_name()]."

# ch/harems_full/taming/events.rpy:3186
translate russian taming_event_04_c184fddb:
    ayesha.say "Думаю, ей стоит увидеть всё своими глазами."

# ch/harems_full/taming/events.rpy:3187
translate russian taming_event_04_636252ef:
    ayesha.say "Сегодня обойдёмся без этой штуки."

# ch/harems_full/taming/events.rpy:3188
translate russian taming_event_04_6ddc01a7_1:
    "Я мог бы поспорить с Айшей."

# ch/harems_full/taming/events.rpy:3189
translate russian taming_event_04_a40a2135_1:
    "Но на самом деле хочу, чтобы ей было как можно комфортнее."

# ch/harems_full/taming/events.rpy:3190
translate russian taming_event_04_b8d852a2_1:
    "Поэтому решаю, что лучше уступить ей в этом вопросе."

# ch/harems_full/taming/events.rpy:3191
translate russian taming_event_04_8b12cf1a_1:
    mike.say "Как скажешь, Айша..."

# ch/harems_full/taming/events.rpy:3192
translate russian taming_event_04_07021a84:
    "Улыбаясь, я отбрасываю повязку в сторону."

# ch/harems_full/taming/events.rpy:3194
translate russian taming_event_04_3f47ee0f:
    "Но, разобравшись с этой мелочью, мы сталкиваемся со следующим вопросом."

# ch/harems_full/taming/events.rpy:3195
translate russian taming_event_04_899f2c24:
    "Я наклоняюсь и поднимаю фаллоимитатор из сумки Кайли."

# ch/harems_full/taming/events.rpy:3196
translate russian taming_event_04_23a60ca8:
    "Только теперь замечаю прикреплённые к нему ремни."

# ch/harems_full/taming/events.rpy:3197
translate russian taming_event_04_6c65b62c:
    "Очевидно, эту штуку принесли не для меня."

# ch/harems_full/taming/events.rpy:3198
translate russian taming_event_04_9b66d085:
    "Зато Айше она отлично подойдёт."

# ch/harems_full/taming/events.rpy:3199
translate russian taming_event_04_312b64e2:
    "Вижу, как она разглядывает её, а затем поднимает взгляд на меня."

# ch/harems_full/taming/events.rpy:3200
translate russian taming_event_04_76f59416:
    mike.say "Ну что, Айша..."

# ch/harems_full/taming/events.rpy:3201
translate russian taming_event_04_b0145f08:
    mike.say "Как мы это устроим?"

# ch/harems_full/taming/events.rpy:3202
translate russian taming_event_04_44eb5b07:
    "Айша поспешно подходит ко мне."

# ch/harems_full/taming/events.rpy:3203
translate russian taming_event_04_5bc72844:
    "Затем наклоняется ближе, чтобы Кайли не услышала её слов."

# ch/harems_full/taming/events.rpy:3206
translate russian taming_event_04_ce918155:
    "Я вижу, что Айша гораздо увереннее, чем вначале."

# ch/harems_full/taming/events.rpy:3207
translate russian taming_event_04_df97fa80:
    "Но в её движениях и речи всё ещё много тревоги."

# ch/harems_full/taming/events.rpy:3208
translate russian taming_event_04_f296e628:
    "Настолько, что мне хочется вмешаться и взять инициативу на себя."

# ch/harems_full/taming/events.rpy:3209
translate russian taming_event_04_3ba750e8:
    mike.say "Предоставь это мне, Айша."

# ch/harems_full/taming/events.rpy:3210
translate russian taming_event_04_3b703b66:
    mike.say "Основным делом займусь я."

# ch/harems_full/taming/events.rpy:3211
translate russian taming_event_04_413d1af8:
    mike.say "А ты подключайся, когда захочешь, ладно?"

# ch/harems_full/taming/events.rpy:3212
translate russian taming_event_04_efb72fc9:
    "Айша смотрит на страпон так, словно он её пугает."

# ch/harems_full/taming/events.rpy:3213
translate russian taming_event_04_8e466818:
    "В её ответе слышится явное облегчение."

# ch/harems_full/taming/events.rpy:3214
translate russian taming_event_04_4e9b4816:
    ayesha.say "Ладно, [lssb_common.hero_name()]."

# ch/harems_full/taming/events.rpy:3215
translate russian taming_event_04_6c8f6c56:
    ayesha.say "С этим я справлюсь."

# ch/harems_full/taming/events.rpy:3216
translate russian taming_event_04_eca7c56a:
    ayesha.say "Спасибо, что заботишься обо мне!"

# ch/harems_full/taming/events.rpy:3217
translate russian taming_event_04_a2b7da33:
    "Я улыбаюсь, киваю и поворачиваюсь к Кайли на кровати."

# ch/harems_full/taming/events.rpy:3220
translate russian taming_event_04_868a2b4f:
    "Кайли чувствует, как кто-то забирается на матрас."

# ch/harems_full/taming/events.rpy:3221
translate russian taming_event_04_be1abf92:
    "И вертит головой из стороны в сторону."

# ch/harems_full/taming/events.rpy:3222
translate russian taming_event_04_64a4c465:
    kylie.say "Кто здесь?"

# ch/harems_full/taming/events.rpy:3223
translate russian taming_event_04_f7e0d1b3:
    kylie.say "Кто это ко мне подкрадывается?"

# ch/harems_full/taming/events.rpy:3225
translate russian taming_event_04_b5a07984:
    "Кайли улыбается, когда я забираюсь на матрас."

# ch/harems_full/taming/events.rpy:3226
translate russian taming_event_04_923ac44d:
    kylie.say "А, вот оно как."

# ch/harems_full/taming/events.rpy:3227
translate russian taming_event_04_703c474c:
    kylie.say "Значит, всё будет натуральное!"

# ch/harems_full/taming/events.rpy:3228
translate russian taming_event_04_4b2990e5:
    ayesha.say "Поживём — увидим, Кайли."

# ch/harems_full/taming/events.rpy:3229
translate russian taming_event_04_f288783d:
    ayesha.say "Получишь то, что тебе дадут."

# ch/harems_full/taming/events.rpy:3230
translate russian taming_event_04_b80c72a5:
    ayesha.say "И тебе это понравится!"

# ch/harems_full/taming/events.rpy:3231
translate russian taming_event_04_72a5e6f9:
    "Не знаю, пыталась ли Айша последней фразой действительно припугнуть Кайли."

# ch/harems_full/taming/events.rpy:3232
translate russian taming_event_04_75a63c30:
    "Но эффект получается противоположный: та хихикает от предвкушения."

# ch/harems_full/taming/events.rpy:3233
translate russian taming_event_04_13d414f3:
    "По мере моего приближения Кайли начинает демонстративно извиваться."

# ch/harems_full/taming/events.rpy:3234
translate russian taming_event_04_9a413855:
    "Тянет связывающие её верёвки, но узлы держат крепко."

# ch/harems_full/taming/events.rpy:3235
translate russian taming_event_04_b5fd4573:
    "Кайли прекрасно знает, что узлы, которые она велела мне завязать, не подведут."

# ch/harems_full/taming/events.rpy:3236
translate russian taming_event_04_9fa3e96c:
    "Она просто разыгрывает представление, изображая деву в беде."

# ch/harems_full/taming/events.rpy:3237
translate russian taming_event_04_14ed2425:
    "Посмотрим, сможет ли она продолжать, когда всё действительно начнётся!"

# ch/harems_full/taming/events.rpy:3240
translate russian taming_event_04_07d0371d:
    "В такой ситуации можно проявить немало фантазии."

# ch/harems_full/taming/events.rpy:3241
translate russian taming_event_04_45b3fd0d:
    "Но, может, вместе с верёвками это будет уже перебор?"

# ch/harems_full/taming/events.rpy:3242
translate russian taming_event_04_72f9c486:
    "Возможно, сейчас нужно что-нибудь простое."

# ch/harems_full/taming/events.rpy:3243
translate russian taming_event_04_5f34c41e:
    "Поэтому я начинаю обводить членом контуры киски Кайли."

# ch/harems_full/taming/events.rpy:3244
translate russian taming_event_04_f04cfb17:
    "Чтобы сполна воспользоваться верёвками, достаточно просто её дразнить."

# ch/harems_full/taming/events.rpy:3245
translate russian taming_event_04_128c99dc:
    "Ведь она никак не может уклониться от моих ласк."

# ch/harems_full/taming/events.rpy:3246
translate russian taming_event_04_aecdd3b7:
    kylie.say "М-м-м..."

# ch/harems_full/taming/events.rpy:3247
translate russian taming_event_04_dab13141:
    kylie.say "Как хорошо!"

# ch/harems_full/taming/events.rpy:3249
translate russian taming_event_04_7f0ee35e:
    kylie.say "Но это настоящий?"

# ch/harems_full/taming/events.rpy:3251
translate russian taming_event_04_eabf9716:
    kylie.say "С настоящим ничто не сравнится!"

# ch/harems_full/taming/events.rpy:3252
translate russian taming_event_04_c6556e1a:
    "Я улыбаюсь, наслаждаясь выражением лица Кайли."

# ch/harems_full/taming/events.rpy:3253
translate russian taming_event_04_2f9e3469:
    "Вижу, как она старается не подавать виду."

# ch/harems_full/taming/events.rpy:3254
translate russian taming_event_04_c296f943:
    "Но беспомощность заставляет её ощущать всё острее обычного."

# ch/harems_full/taming/events.rpy:3255
translate russian taming_event_04_ce164fbd:
    "Из любопытства и немалого желания я сильнее прижимаюсь к её половым губам."

# ch/harems_full/taming/events.rpy:3256
translate russian taming_event_04_83ab9129:
    "Кайли стонет, когда природа берёт своё и они начинают раскрываться передо мной."

# ch/harems_full/taming/events.rpy:3257
translate russian taming_event_04_889373bc:
    "Её голова опускается на подушку, пока мой член медленно входит внутрь."

# ch/harems_full/taming/events.rpy:3259
translate russian taming_event_04_9d0bd4b2:
    "Пользуясь ситуацией, я сразу начинаю двигаться."

# ch/harems_full/taming/events.rpy:3260
translate russian taming_event_04_f88f855d:
    "Кайли раскрыта передо мной и просит дать ей всё, на что я способен."

# ch/harems_full/taming/events.rpy:3261
translate russian taming_event_04_5d42123e:
    "Её киска уже уступает мне: тёплая, мокрая и гостеприимная."

# ch/harems_full/taming/events.rpy:3262
translate russian taming_event_04_f582a5aa:
    "Двигаясь в Кайли, я почти не замечаю наблюдающую Айшу."

# ch/harems_full/taming/events.rpy:3263
translate russian taming_event_04_2cf48e9c:
    "Но она рядом и внимательно следит за тем, как я наслаждаюсь."

# ch/harems_full/taming/events.rpy:3264
translate russian taming_event_04_b973fdf2:
    "Постепенно начинаю замечать и то, что делает она сама."

# ch/harems_full/taming/events.rpy:3265
translate russian taming_event_04_71706a3d:
    "Наблюдая, Айша касается определённых частей своего тела."

# ch/harems_full/taming/events.rpy:3266
translate russian taming_event_04_72de227a:
    "Не знаю, делает ли она это намеренно и вообще осознаёт ли."

# ch/harems_full/taming/events.rpy:3267
translate russian taming_event_04_21fab443:
    "Но вскоре одна её ладонь оказывается на груди."

# ch/harems_full/taming/events.rpy:3268
translate russian taming_event_04_0a6cb2fc:
    "А другая скользит между бёдер."

# ch/harems_full/taming/events.rpy:3269
translate russian taming_event_04_38f4bb0f:
    "Айша ласкает себя, глядя на нас."

# ch/harems_full/taming/events.rpy:3270
translate russian taming_event_04_68c6af39:
    "Она дышит всё прерывистее, всё сильнее возбуждаясь."

# ch/harems_full/taming/events.rpy:3271
translate russian taming_event_04_ddbace7b:
    "Поверьте мне."

# ch/harems_full/taming/events.rpy:3272
translate russian taming_event_04_4a95650f:
    "Я не забываю, что сейчас по самые яйца в Кайли."

# ch/harems_full/taming/events.rpy:3273
translate russian taming_event_04_b0c3c092:
    "Но и ласкающая себя Айша получает немалую долю моего внимания!"

# ch/harems_full/taming/events.rpy:3274
translate russian taming_event_04_3607586b:
    "Я стараюсь отвести от неё взгляд и сосредоточиться на Кайли."

# ch/harems_full/taming/events.rpy:3275
translate russian taming_event_04_cd03f369:
    "Но Айша наклоняется над ней, протягивая руку."

# ch/harems_full/taming/events.rpy:3276
translate russian taming_event_04_1c67af2e:
    "И проводит ею по контурам беспомощного тела Кайли."

# ch/harems_full/taming/events.rpy:3277
translate russian taming_event_04_4a4189da:
    "Дольше всего задерживаясь на обнажённой груди."

# ch/harems_full/taming/events.rpy:3278
translate russian taming_event_04_73f0fe9e:
    "Одной рукой Айша по-прежнему ласкает собственную киску."

# ch/harems_full/taming/events.rpy:3279
translate russian taming_event_04_8e4c2826:
    "Другой исследует грудь Кайли, сжимая её и пощипывая соски."

# ch/harems_full/taming/events.rpy:3280
translate russian taming_event_04_dc55dfec:
    "Голова Кайли всё ещё утопает в подушках."

# ch/harems_full/taming/events.rpy:3281
translate russian taming_event_04_5378130a:
    "Но теперь она ещё и мечется из стороны в сторону."

# ch/harems_full/taming/events.rpy:3282
translate russian taming_event_04_0765a271:
    "Кажется, Кайли быстро приближается к своему пределу."

# ch/harems_full/taming/events.rpy:3283
translate russian taming_event_04_d3be7953:
    "Словно её тело уже не может выдержать больше того, что мы ему даём."

# ch/harems_full/taming/events.rpy:3284
translate russian taming_event_04_ac34f829:
    "Она безумно стонет и задыхается, напоминая животное в течке."

# ch/harems_full/taming/events.rpy:3285
translate russian taming_event_04_cb17e954:
    "Кажется, я должен был бы продержаться дольше."

# ch/harems_full/taming/events.rpy:3286
translate russian taming_event_04_665de6e2:
    "Но с учётом того, что вытворяет Айша, я больше не могу!"

# ch/harems_full/taming/events.rpy:3289
translate russian taming_event_04_308f75b3:
    "Кайли связана и беспомощна, так что всё здесь решаю я."

# ch/harems_full/taming/events.rpy:3290
translate russian taming_event_04_4838410c:
    "Ничто не мешает мне продолжать, пока я не кончу в неё."

# ch/harems_full/taming/events.rpy:3292
translate russian taming_event_04_e10ea91f:
    "Так я и делаю, вкладывая в это последние силы."

# ch/harems_full/taming/events.rpy:3295
translate russian taming_event_04_91e22d52:
    "Когда я кончаю в неё, Кайли натягивает путы, а её мышцы непрерывно подрагивают."

# ch/harems_full/taming/events.rpy:3297
translate russian taming_event_04_db30ae7d:
    "Она задыхается и стонет, охваченная собственным оргазмом."

# ch/harems_full/taming/events.rpy:3298
translate russian taming_event_04_439bd034:
    "Когда всё заканчивается, её голова опускается на подушку, а тело обмякает."

# ch/harems_full/taming/events.rpy:3300
translate russian taming_event_04_308f75b3_1:
    "Кайли связана и беспомощна, так что всё здесь решаю я."

# ch/harems_full/taming/events.rpy:3301
translate russian taming_event_04_36f116d9:
    "Ничто не мешает мне добавить немного сладкой пытки, выйдя из неё."

# ch/harems_full/taming/events.rpy:3302
translate russian taming_event_04_22a420e9:
    "Я успеваю сделать это до оргазма, вовремя выскальзывая из киски Кайли."

# ch/harems_full/taming/events.rpy:3304
translate russian taming_event_04_a8a25457:
    "Кайли напрасно натягивает путы и протестует невнятными животными звуками."

# ch/harems_full/taming/events.rpy:3306
translate russian taming_event_04_b40a6f10:
    "Но уже поздно: я кончаю на её беспомощное тело."

# ch/harems_full/taming/events.rpy:3309
translate russian taming_event_04_db30ae7d_1:
    "Она задыхается и стонет, охваченная собственным оргазмом."

# ch/harems_full/taming/events.rpy:3311
translate russian taming_event_04_439bd034_1:
    "Когда всё заканчивается, её голова опускается на подушку, а тело обмякает."

# ch/harems_full/taming/events.rpy:3313
translate russian taming_event_04_07d0371d_1:
    "В такой ситуации можно проявить немало фантазии."

# ch/harems_full/taming/events.rpy:3314
translate russian taming_event_04_25f32795:
    "Когда ещё воспользоваться всеми этими верёвками?"

# ch/harems_full/taming/events.rpy:3315
translate russian taming_event_04_5c01f317:
    "Поэтому выбираю кое-что менее привычное."

# ch/harems_full/taming/events.rpy:3316
translate russian taming_event_04_b8e03f5e:
    "Начинаю проталкивать член между пышных ягодиц Кайли."

# ch/harems_full/taming/events.rpy:3317
translate russian taming_event_04_f04cfb17_1:
    "Чтобы сполна воспользоваться верёвками, достаточно просто её дразнить."

# ch/harems_full/taming/events.rpy:3318
translate russian taming_event_04_128c99dc_1:
    "Ведь она никак не может уклониться от моих ласк."

# ch/harems_full/taming/events.rpy:3319
translate russian taming_event_04_aecdd3b7_1:
    kylie.say "М-м-м..."

# ch/harems_full/taming/events.rpy:3320
translate russian taming_event_04_dab13141_1:
    kylie.say "Как хорошо!"

# ch/harems_full/taming/events.rpy:3321
translate russian taming_event_04_71fcf932:
    kylie.say "Можешь взять меня в попку, если хочешь!"

# ch/harems_full/taming/events.rpy:3323
translate russian taming_event_04_7f0ee35e_1:
    kylie.say "Но это настоящий?"

# ch/harems_full/taming/events.rpy:3325
translate russian taming_event_04_eabf9716_1:
    kylie.say "С настоящим ничто не сравнится!"

# ch/harems_full/taming/events.rpy:3326
translate russian taming_event_04_c6556e1a_1:
    "Я улыбаюсь, наслаждаясь выражением лица Кайли."

# ch/harems_full/taming/events.rpy:3327
translate russian taming_event_04_2f9e3469_1:
    "Вижу, как она старается не подавать виду."

# ch/harems_full/taming/events.rpy:3328
translate russian taming_event_04_c296f943_1:
    "Но беспомощность заставляет её ощущать всё острее обычного."

# ch/harems_full/taming/events.rpy:3329
translate russian taming_event_04_bed7a621:
    "Из любопытства и немалого желания я сильнее прижимаюсь к её отверстию."

# ch/harems_full/taming/events.rpy:3331
translate russian taming_event_04_83ab9129_1:
    "Кайли стонет, когда природа берёт своё и они начинают раскрываться передо мной."

# ch/harems_full/taming/events.rpy:3332
translate russian taming_event_04_889373bc_1:
    "Её голова опускается на подушку, пока мой член медленно входит внутрь."

# ch/harems_full/taming/events.rpy:3333
translate russian taming_event_04_9d0bd4b2_1:
    "Пользуясь ситуацией, я сразу начинаю двигаться."

# ch/harems_full/taming/events.rpy:3335
translate russian taming_event_04_f88f855d_1:
    "Кайли раскрыта передо мной и просит дать ей всё, на что я способен."

# ch/harems_full/taming/events.rpy:3336
translate russian taming_event_04_0cc1d49b:
    "Её попка уже уступает мне, мышцы расслабляются ровно настолько, насколько нужно."

# ch/harems_full/taming/events.rpy:3337
translate russian taming_event_04_f582a5aa_1:
    "Двигаясь в Кайли, я почти не замечаю наблюдающую Айшу."

# ch/harems_full/taming/events.rpy:3338
translate russian taming_event_04_2cf48e9c_1:
    "Но она рядом и внимательно следит за тем, как я наслаждаюсь."

# ch/harems_full/taming/events.rpy:3339
translate russian taming_event_04_b973fdf2_1:
    "Постепенно начинаю замечать и то, что делает она сама."

# ch/harems_full/taming/events.rpy:3340
translate russian taming_event_04_71706a3d_1:
    "Наблюдая, Айша касается определённых частей своего тела."

# ch/harems_full/taming/events.rpy:3341
translate russian taming_event_04_72de227a_1:
    "Не знаю, делает ли она это намеренно и вообще осознаёт ли."

# ch/harems_full/taming/events.rpy:3342
translate russian taming_event_04_21fab443_1:
    "Но вскоре одна её ладонь оказывается на груди."

# ch/harems_full/taming/events.rpy:3343
translate russian taming_event_04_0a6cb2fc_1:
    "А другая скользит между бёдер."

# ch/harems_full/taming/events.rpy:3344
translate russian taming_event_04_38f4bb0f_1:
    "Айша ласкает себя, глядя на нас."

# ch/harems_full/taming/events.rpy:3345
translate russian taming_event_04_68c6af39_1:
    "Она дышит всё прерывистее, всё сильнее возбуждаясь."

# ch/harems_full/taming/events.rpy:3346
translate russian taming_event_04_ddbace7b_1:
    "Поверьте мне."

# ch/harems_full/taming/events.rpy:3347
translate russian taming_event_04_4a95650f_1:
    "Я не забываю, что сейчас по самые яйца в Кайли."

# ch/harems_full/taming/events.rpy:3348
translate russian taming_event_04_b0c3c092_1:
    "Но и ласкающая себя Айша получает немалую долю моего внимания!"

# ch/harems_full/taming/events.rpy:3349
translate russian taming_event_04_3607586b_1:
    "Я стараюсь отвести от неё взгляд и сосредоточиться на Кайли."

# ch/harems_full/taming/events.rpy:3350
translate russian taming_event_04_cd03f369_1:
    "Но Айша наклоняется над ней, протягивая руку."

# ch/harems_full/taming/events.rpy:3351
translate russian taming_event_04_1c67af2e_1:
    "И проводит ею по контурам беспомощного тела Кайли."

# ch/harems_full/taming/events.rpy:3352
translate russian taming_event_04_4a4189da_1:
    "Дольше всего задерживаясь на обнажённой груди."

# ch/harems_full/taming/events.rpy:3353
translate russian taming_event_04_73f0fe9e_1:
    "Одной рукой Айша по-прежнему ласкает собственную киску."

# ch/harems_full/taming/events.rpy:3354
translate russian taming_event_04_8e4c2826_1:
    "Другой исследует грудь Кайли, сжимая её и пощипывая соски."

# ch/harems_full/taming/events.rpy:3355
translate russian taming_event_04_dc55dfec_1:
    "Голова Кайли всё ещё утопает в подушках."

# ch/harems_full/taming/events.rpy:3356
translate russian taming_event_04_5378130a_1:
    "Но теперь она ещё и мечется из стороны в сторону."

# ch/harems_full/taming/events.rpy:3357
translate russian taming_event_04_0765a271_1:
    "Кажется, Кайли быстро приближается к своему пределу."

# ch/harems_full/taming/events.rpy:3358
translate russian taming_event_04_d3be7953_1:
    "Словно её тело уже не может выдержать больше того, что мы ему даём."

# ch/harems_full/taming/events.rpy:3359
translate russian taming_event_04_ac34f829_1:
    "Она безумно стонет и задыхается, напоминая животное в течке."

# ch/harems_full/taming/events.rpy:3360
translate russian taming_event_04_cb17e954_1:
    "Кажется, я должен был бы продержаться дольше."

# ch/harems_full/taming/events.rpy:3361
translate russian taming_event_04_665de6e2_1:
    "Но с учётом того, что вытворяет Айша, я больше не могу!"

# ch/harems_full/taming/events.rpy:3364
translate russian taming_event_04_308f75b3_2:
    "Кайли связана и беспомощна, так что всё здесь решаю я."

# ch/harems_full/taming/events.rpy:3365
translate russian taming_event_04_4838410c_1:
    "Ничто не мешает мне продолжать, пока я не кончу в неё."

# ch/harems_full/taming/events.rpy:3367
translate russian taming_event_04_e10ea91f_1:
    "Так я и делаю, вкладывая в это последние силы."

# ch/harems_full/taming/events.rpy:3370
translate russian taming_event_04_91e22d52_1:
    "Когда я кончаю в неё, Кайли натягивает путы, а её мышцы непрерывно подрагивают."

# ch/harems_full/taming/events.rpy:3372
translate russian taming_event_04_db30ae7d_2:
    "Она задыхается и стонет, охваченная собственным оргазмом."

# ch/harems_full/taming/events.rpy:3373
translate russian taming_event_04_439bd034_2:
    "Когда всё заканчивается, её голова опускается на подушку, а тело обмякает."

# ch/harems_full/taming/events.rpy:3375
translate russian taming_event_04_308f75b3_3:
    "Кайли связана и беспомощна, так что всё здесь решаю я."

# ch/harems_full/taming/events.rpy:3376
translate russian taming_event_04_36f116d9_1:
    "Ничто не мешает мне добавить немного сладкой пытки, выйдя из неё."

# ch/harems_full/taming/events.rpy:3377
translate russian taming_event_04_1a5108fd:
    "Я успеваю сделать это до оргазма, вовремя выскальзывая из попки Кайли."

# ch/harems_full/taming/events.rpy:3379
translate russian taming_event_04_a8a25457_1:
    "Кайли напрасно натягивает путы и протестует невнятными животными звуками."

# ch/harems_full/taming/events.rpy:3381
translate russian taming_event_04_b40a6f10_1:
    "Но уже поздно: я кончаю на её беспомощное тело."

# ch/harems_full/taming/events.rpy:3384
translate russian taming_event_04_db30ae7d_3:
    "Она задыхается и стонет, охваченная собственным оргазмом."

# ch/harems_full/taming/events.rpy:3386
translate russian taming_event_04_439bd034_3:
    "Когда всё заканчивается, её голова опускается на подушку, а тело обмякает."

# ch/harems_full/taming/events.rpy:3389
translate russian taming_event_04_8f75f1ca:
    "Айша словно сбрасывает большую часть недавней тревоги."

# ch/harems_full/taming/events.rpy:3390
translate russian taming_event_04_f604815f:
    "Теперь она выглядит почти так же, как перед выходом на ринг!"

# ch/harems_full/taming/events.rpy:3391
translate russian taming_event_04_23aa7db0:
    "По её лицу видно: она настроена серьёзно."

# ch/harems_full/taming/events.rpy:3392
translate russian taming_event_04_7c735075:
    mike.say "Ты не обязана делать ничего, чего не хочешь, Айша."

# ch/harems_full/taming/events.rpy:3393
translate russian taming_event_04_349602b5:
    mike.say "Я могу справиться сам."

# ch/harems_full/taming/events.rpy:3394
translate russian taming_event_04_f751888b:
    mike.say "Если хочешь, просто устройся поудобнее и смотри."

# ch/harems_full/taming/events.rpy:3395
translate russian taming_event_04_4fcc6245:
    "Айша качает головой."

# ch/harems_full/taming/events.rpy:3396
translate russian taming_event_04_1d8631c1:
    "Я смотрю, как она берёт страпон."

# ch/harems_full/taming/events.rpy:3397
translate russian taming_event_04_cfedca91:
    ayesha.say "Спасибо, но нет, [lssb_common.hero_name()]."

# ch/harems_full/taming/events.rpy:3398
translate russian taming_event_04_8c8e53a6:
    ayesha.say "Думаю, сейчас мне нужно встретиться со своими страхами лицом к лицу."

# ch/harems_full/taming/events.rpy:3399
translate russian taming_event_04_8f360168:
    ayesha.say "Просто будь рядом и поддержи меня, ладно?"

# ch/harems_full/taming/events.rpy:3400
translate russian taming_event_04_2be464fb:
    "Я киваю и помогаю Айше закрепить страпон."

# ch/harems_full/taming/events.rpy:3401
translate russian taming_event_04_e1efc9be:
    "Закончив, мы поворачиваемся к Кайли на кровати."

# ch/harems_full/taming/events.rpy:3404
translate russian taming_event_04_868a2b4f_1:
    "Кайли чувствует, как кто-то забирается на матрас."

# ch/harems_full/taming/events.rpy:3405
translate russian taming_event_04_be1abf92_1:
    "И вертит головой из стороны в сторону."

# ch/harems_full/taming/events.rpy:3406
translate russian taming_event_04_64a4c465_1:
    kylie.say "Кто здесь?"

# ch/harems_full/taming/events.rpy:3407
translate russian taming_event_04_f7e0d1b3_1:
    kylie.say "Кто это ко мне подкрадывается?"

# ch/harems_full/taming/events.rpy:3409
translate russian taming_event_04_313985ed:
    "Кайли улыбается, когда Айша забирается на матрас."

# ch/harems_full/taming/events.rpy:3410
translate russian taming_event_04_923ac44d_1:
    kylie.say "А, вот оно как."

# ch/harems_full/taming/events.rpy:3411
translate russian taming_event_04_abb90534:
    kylie.say "Значит, мне досталась девчонка с членом!"

# ch/harems_full/taming/events.rpy:3412
translate russian taming_event_04_4b2990e5_1:
    ayesha.say "Поживём — увидим, Кайли."

# ch/harems_full/taming/events.rpy:3413
translate russian taming_event_04_f288783d_1:
    ayesha.say "Получишь то, что тебе дадут."

# ch/harems_full/taming/events.rpy:3414
translate russian taming_event_04_b80c72a5_1:
    ayesha.say "И тебе это понравится!"

# ch/harems_full/taming/events.rpy:3415
translate russian taming_event_04_72a5e6f9_1:
    "Не знаю, пыталась ли Айша последней фразой действительно припугнуть Кайли."

# ch/harems_full/taming/events.rpy:3416
translate russian taming_event_04_75a63c30_1:
    "Но эффект получается противоположный: та хихикает от предвкушения."

# ch/harems_full/taming/events.rpy:3417
translate russian taming_event_04_a71a5ef5:
    "По мере приближения Айши Кайли начинает демонстративно извиваться."

# ch/harems_full/taming/events.rpy:3418
translate russian taming_event_04_9a413855_1:
    "Тянет связывающие её верёвки, но узлы держат крепко."

# ch/harems_full/taming/events.rpy:3419
translate russian taming_event_04_b5fd4573_1:
    "Кайли прекрасно знает, что узлы, которые она велела мне завязать, не подведут."

# ch/harems_full/taming/events.rpy:3420
translate russian taming_event_04_9fa3e96c_1:
    "Она просто разыгрывает представление, изображая деву в беде."

# ch/harems_full/taming/events.rpy:3421
translate russian taming_event_04_14ed2425_1:
    "Посмотрим, сможет ли она продолжать, когда всё действительно начнётся!"

# ch/harems_full/taming/events.rpy:3424
translate russian taming_event_04_33ace61d:
    "Мне непривычно смотреть, как Айша приближается к Кайли."

# ch/harems_full/taming/events.rpy:3425
translate russian taming_event_04_8a2ca6c8:
    "Во-первых, я не привык наблюдать за чужим сексом."

# ch/harems_full/taming/events.rpy:3426
translate russian taming_event_04_de6f266d:
    "Во-вторых, невольно думаю, что сделал бы иначе."

# ch/harems_full/taming/events.rpy:3427
translate russian taming_event_04_167dd24d:
    "К тому же уверенность Айши словно растёт с каждой секундой."

# ch/harems_full/taming/events.rpy:3428
translate russian taming_event_04_11ebe64a:
    "Перед началом она сомневалась, стоит ли вообще во всё это ввязываться."

# ch/harems_full/taming/events.rpy:3429
translate russian taming_event_04_f7a31451:
    "А теперь страпон словно придаёт ей силы!"

# ch/harems_full/taming/events.rpy:3430
translate russian taming_event_04_4625b4ee:
    "Я смотрю, как она опускается над беспомощной Кайли."

# ch/harems_full/taming/events.rpy:3431
translate russian taming_event_04_3b698339:
    "И невольно наклоняюсь ближе, чтобы увидеть, куда направляется фаллоимитатор."

# ch/harems_full/taming/events.rpy:3432
translate russian taming_event_04_e33491fb:
    "На миг мне всерьёз кажется, что Айша выберет попку."

# ch/harems_full/taming/events.rpy:3433
translate russian taming_event_04_eaed83a1:
    "Но затем головка скользит вдоль половых губ Кайли."

# ch/harems_full/taming/events.rpy:3434
translate russian taming_event_04_83daa5f3:
    "Та пытается сдерживаться, чтобы усложнить Айше задачу."

# ch/harems_full/taming/events.rpy:3435
translate russian taming_event_04_6156e055:
    "Но всё же издаёт долгий низкий стон удовольствия."

# ch/harems_full/taming/events.rpy:3436
translate russian taming_event_04_aecdd3b7_2:
    kylie.say "М-м-м..."

# ch/harems_full/taming/events.rpy:3437
translate russian taming_event_04_dab13141_2:
    kylie.say "Как хорошо!"

# ch/harems_full/taming/events.rpy:3439
translate russian taming_event_04_7f0ee35e_2:
    kylie.say "Но это настоящий?"

# ch/harems_full/taming/events.rpy:3441
translate russian taming_event_04_eabf9716_2:
    kylie.say "С настоящим ничто не сравнится!"

# ch/harems_full/taming/events.rpy:3442
translate russian taming_event_04_e27a0348:
    "По лицу Айши расползается лукавая усмешка."

# ch/harems_full/taming/events.rpy:3443
translate russian taming_event_04_d80a85c5:
    "Похоже, она воспринимает слова Кайли как вызов."

# ch/harems_full/taming/events.rpy:3444
translate russian taming_event_04_119d56a5:
    "Айше достаточно лишь немного усилить давление."

# ch/harems_full/taming/events.rpy:3446
translate russian taming_event_04_e6cd6fb3:
    "Когда она подаётся вперёд, половые губы Кайли начинают уступать."

# ch/harems_full/taming/events.rpy:3447
translate russian taming_event_04_8c2e98d9:
    "Та снова стонет, её тело поддаётся, губы раскрываются."

# ch/harems_full/taming/events.rpy:3448
translate russian taming_event_04_9171e991:
    "Я заворожённо смотрю, как фаллоимитатор погружается в неё."

# ch/harems_full/taming/events.rpy:3449
translate russian taming_event_04_34a48bfc:
    "Айша молчит, начиная трахать Кайли."

# ch/harems_full/taming/events.rpy:3450
translate russian taming_event_04_0a14df49:
    "Всё её внимание сосредоточено на происходящем."

# ch/harems_full/taming/events.rpy:3451
translate russian taming_event_04_b220cfad:
    "Гибкие, сильные мышцы её тела приходят в движение."

# ch/harems_full/taming/events.rpy:3452
translate russian taming_event_04_678955e6:
    "И каждое движение передаётся фаллоимитатору внутри Кайли."

# ch/harems_full/taming/events.rpy:3453
translate russian taming_event_04_80d06868:
    "Айша не просто механически двигается."

# ch/harems_full/taming/events.rpy:3454
translate russian taming_event_04_1606620f:
    "Вижу, что она изо всех сил старается повторить настоящий секс."

# ch/harems_full/taming/events.rpy:3455
translate russian taming_event_04_801ca761:
    "Её тело движется до удивления знакомо."

# ch/harems_full/taming/events.rpy:3456
translate russian taming_event_04_1469a8df:
    "Почти точно так двигался бы я, будь на её месте!"

# ch/harems_full/taming/events.rpy:3457
translate russian taming_event_04_321dbdbc:
    "Неужели Айша так внимательно наблюдала за мной, когда мы занимались любовью?"

# ch/harems_full/taming/events.rpy:3458
translate russian taming_event_04_81ab8a4b:
    "Потому что сейчас она вытворяет с Кайли нечто потрясающее!"

# ch/harems_full/taming/events.rpy:3459
translate russian taming_event_04_af458a1e:
    "И, похоже, сама получает удовольствие."

# ch/harems_full/taming/events.rpy:3460
translate russian taming_event_04_8c58df24:
    "Знаю, Айша глубоко не доверяет Кайли."

# ch/harems_full/taming/events.rpy:3461
translate russian taming_event_04_8c43147d:
    "Конечно, с начала наших отношений втроём это недоверие ослабло."

# ch/harems_full/taming/events.rpy:3462
translate russian taming_event_04_671cd054:
    "Но мне кажется, то, что Айша сейчас делает с ней, помогает справиться и с остальным."

# ch/harems_full/taming/events.rpy:3463
translate russian taming_event_04_b283f512:
    "Словно она наконец может самоутвердиться рядом с Кайли."

# ch/harems_full/taming/events.rpy:3464
translate russian taming_event_04_636286a1:
    "Доминировать над ней приемлемым способом."

# ch/harems_full/taming/events.rpy:3465
translate russian taming_event_04_3cc7a483:
    "С моей точки зрения, всё это ещё и невероятно возбуждает!"

# ch/harems_full/taming/events.rpy:3466
translate russian taming_event_04_71b3024b:
    "Честно говоря, не помню, как мой член оказался у меня в руке."

# ch/harems_full/taming/events.rpy:3467
translate russian taming_event_04_9e60c4a7:
    "Но он твёрдый, и я не могу не поглаживать его, наблюдая."

# ch/harems_full/taming/events.rpy:3468
translate russian taming_event_04_6836df2f:
    "Я наклоняюсь ближе, пользуясь возможностью поиграть с беспомощным телом Кайли."

# ch/harems_full/taming/events.rpy:3469
translate russian taming_event_04_3f8def97:
    "Сжимаю её грудь, пощипываю соски и делаю всё, что приходит в голову."

# ch/harems_full/taming/events.rpy:3470
translate russian taming_event_04_1e1af1f5:
    "Ведь она никак не может мне помешать."

# ch/harems_full/taming/events.rpy:3471
translate russian taming_event_04_7fdd7438:
    "Кайли извивается на кровати от ласк и проникновения, которыми мы окружаем её со всех сторон."

# ch/harems_full/taming/events.rpy:3472
translate russian taming_event_04_907e2d1f:
    "Она безуспешно тянет путы, которые сама велела нам завязать, не в силах сопротивляться."

# ch/harems_full/taming/events.rpy:3473
translate russian taming_event_04_2cc06ead:
    "И лишь усиливает ощущения от всего, что мы с ней делаем."

# ch/harems_full/taming/events.rpy:3474
translate russian taming_event_04_6474f968:
    kylie.say "Ах..."

# ch/harems_full/taming/events.rpy:3475
translate russian taming_event_04_f4571542:
    kylie.say "О боже..."

# ch/harems_full/taming/events.rpy:3476
translate russian taming_event_04_2003b12e:
    kylie.say "Пожалуйста... я сейчас..."

# ch/harems_full/taming/events.rpy:3477
translate russian taming_event_04_c920c607:
    "Кайли даже не нужно договаривать."

# ch/harems_full/taming/events.rpy:3478
translate russian taming_event_04_7e230aa1:
    "Мы с Айшей прекрасно понимаем, что сейчас произойдёт."

# ch/harems_full/taming/events.rpy:3481
translate russian taming_event_04_4e405d54:
    "Но Айша не останавливается и даже не замедляется."

# ch/harems_full/taming/events.rpy:3482
translate russian taming_event_04_208f4af0:
    "Она явно намерена трахать Кайли до последнего."

# ch/harems_full/taming/events.rpy:3483
translate russian taming_event_04_acfc0654:
    "Именно так всё и происходит."

# ch/harems_full/taming/events.rpy:3484
translate russian taming_event_04_93ceaf64:
    "Кайли выгибается и извивается на фаллоимитаторе."

# ch/harems_full/taming/events.rpy:3488
translate russian taming_event_04_c63e5824:
    "И я чувствую, что тоже больше не могу."

# ch/harems_full/taming/events.rpy:3490
translate russian taming_event_04_4de45507:
    "Не спрашивая разрешения, я кончаю Кайли на живот."

# ch/harems_full/taming/events.rpy:3492
translate russian taming_event_04_522d5028:
    "Тёплая липкая белая сперма ложится полосами на её живот."

# ch/harems_full/taming/events.rpy:3493
translate russian taming_event_04_439bd034_4:
    "Когда всё заканчивается, её голова опускается на подушку, а тело обмякает."

# ch/harems_full/taming/events.rpy:3495
translate russian taming_event_04_fcec60a2:
    "Внезапно Айша выдёргивает фаллоимитатор из Кайли."

# ch/harems_full/taming/events.rpy:3497
translate russian taming_event_04_47e6b9df:
    "Та выгибается и извивается, когда он выскальзывает наружу."

# ch/harems_full/taming/events.rpy:3498
translate russian taming_event_04_c63e5824_1:
    "И я чувствую, что тоже больше не могу."

# ch/harems_full/taming/events.rpy:3502
translate russian taming_event_04_4de45507_1:
    "Не спрашивая разрешения, я кончаю Кайли на живот."

# ch/harems_full/taming/events.rpy:3504
translate russian taming_event_04_522d5028_1:
    "Тёплая липкая белая сперма ложится полосами на её живот."

# ch/harems_full/taming/events.rpy:3505
translate russian taming_event_04_439bd034_5:
    "Когда всё заканчивается, её голова опускается на подушку, а тело обмякает."

# ch/harems_full/taming/events.rpy:3507
translate russian taming_event_04_33ace61d_1:
    "Мне непривычно смотреть, как Айша приближается к Кайли."

# ch/harems_full/taming/events.rpy:3508
translate russian taming_event_04_8a2ca6c8_1:
    "Во-первых, я не привык наблюдать за чужим сексом."

# ch/harems_full/taming/events.rpy:3509
translate russian taming_event_04_de6f266d_1:
    "Во-вторых, невольно думаю, что сделал бы иначе."

# ch/harems_full/taming/events.rpy:3510
translate russian taming_event_04_167dd24d_1:
    "К тому же уверенность Айши словно растёт с каждой секундой."

# ch/harems_full/taming/events.rpy:3511
translate russian taming_event_04_11ebe64a_1:
    "Перед началом она сомневалась, стоит ли вообще во всё это ввязываться."

# ch/harems_full/taming/events.rpy:3512
translate russian taming_event_04_f7a31451_1:
    "А теперь страпон словно придаёт ей силы!"

# ch/harems_full/taming/events.rpy:3513
translate russian taming_event_04_4625b4ee_1:
    "Я смотрю, как она опускается над беспомощной Кайли."

# ch/harems_full/taming/events.rpy:3514
translate russian taming_event_04_3b698339_1:
    "И невольно наклоняюсь ближе, чтобы увидеть, куда направляется фаллоимитатор."

# ch/harems_full/taming/events.rpy:3515
translate russian taming_event_04_12ec608d:
    "На миг мне всерьёз кажется, что Айша выберет киску."

# ch/harems_full/taming/events.rpy:3516
translate russian taming_event_04_fc2e61cf:
    "Но затем головка скользит между ягодиц Кайли."

# ch/harems_full/taming/events.rpy:3517
translate russian taming_event_04_83daa5f3_1:
    "Та пытается сдерживаться, чтобы усложнить Айше задачу."

# ch/harems_full/taming/events.rpy:3518
translate russian taming_event_04_6156e055_1:
    "Но всё же издаёт долгий низкий стон удовольствия."

# ch/harems_full/taming/events.rpy:3519
translate russian taming_event_04_aecdd3b7_3:
    kylie.say "М-м-м..."

# ch/harems_full/taming/events.rpy:3520
translate russian taming_event_04_dab13141_3:
    kylie.say "Как хорошо!"

# ch/harems_full/taming/events.rpy:3521
translate russian taming_event_04_71fcf932_1:
    kylie.say "Можешь взять меня в попку, если хочешь!"

# ch/harems_full/taming/events.rpy:3523
translate russian taming_event_04_7f0ee35e_3:
    kylie.say "Но это настоящий?"

# ch/harems_full/taming/events.rpy:3525
translate russian taming_event_04_eabf9716_3:
    kylie.say "С настоящим ничто не сравнится!"

# ch/harems_full/taming/events.rpy:3526
translate russian taming_event_04_e27a0348_1:
    "По лицу Айши расползается лукавая усмешка."

# ch/harems_full/taming/events.rpy:3527
translate russian taming_event_04_d80a85c5_1:
    "Похоже, она воспринимает слова Кайли как вызов."

# ch/harems_full/taming/events.rpy:3528
translate russian taming_event_04_119d56a5_1:
    "Айше достаточно лишь немного усилить давление."

# ch/harems_full/taming/events.rpy:3529
translate russian taming_event_04_20453436:
    "Когда она подаётся вперёд, ягодицы Кайли начинают раздвигаться."

# ch/harems_full/taming/events.rpy:3531
translate russian taming_event_04_45417f09:
    "Та снова стонет, её тело поддаётся, мышцы расслабляются."

# ch/harems_full/taming/events.rpy:3532
translate russian taming_event_04_9171e991_1:
    "Я заворожённо смотрю, как фаллоимитатор погружается в неё."

# ch/harems_full/taming/events.rpy:3533
translate russian taming_event_04_34a48bfc_1:
    "Айша молчит, начиная трахать Кайли."

# ch/harems_full/taming/events.rpy:3534
translate russian taming_event_04_0a14df49_1:
    "Всё её внимание сосредоточено на происходящем."

# ch/harems_full/taming/events.rpy:3535
translate russian taming_event_04_b220cfad_1:
    "Гибкие, сильные мышцы её тела приходят в движение."

# ch/harems_full/taming/events.rpy:3536
translate russian taming_event_04_678955e6_1:
    "И каждое движение передаётся фаллоимитатору внутри Кайли."

# ch/harems_full/taming/events.rpy:3537
translate russian taming_event_04_80d06868_1:
    "Айша не просто механически двигается."

# ch/harems_full/taming/events.rpy:3538
translate russian taming_event_04_1606620f_1:
    "Вижу, что она изо всех сил старается повторить настоящий секс."

# ch/harems_full/taming/events.rpy:3539
translate russian taming_event_04_801ca761_1:
    "Её тело движется до удивления знакомо."

# ch/harems_full/taming/events.rpy:3540
translate russian taming_event_04_1469a8df_1:
    "Почти точно так двигался бы я, будь на её месте!"

# ch/harems_full/taming/events.rpy:3541
translate russian taming_event_04_321dbdbc_1:
    "Неужели Айша так внимательно наблюдала за мной, когда мы занимались любовью?"

# ch/harems_full/taming/events.rpy:3542
translate russian taming_event_04_81ab8a4b_1:
    "Потому что сейчас она вытворяет с Кайли нечто потрясающее!"

# ch/harems_full/taming/events.rpy:3543
translate russian taming_event_04_af458a1e_1:
    "И, похоже, сама получает удовольствие."

# ch/harems_full/taming/events.rpy:3544
translate russian taming_event_04_8c58df24_1:
    "Знаю, Айша глубоко не доверяет Кайли."

# ch/harems_full/taming/events.rpy:3545
translate russian taming_event_04_8c43147d_1:
    "Конечно, с начала наших отношений втроём это недоверие ослабло."

# ch/harems_full/taming/events.rpy:3546
translate russian taming_event_04_671cd054_1:
    "Но мне кажется, то, что Айша сейчас делает с ней, помогает справиться и с остальным."

# ch/harems_full/taming/events.rpy:3547
translate russian taming_event_04_b283f512_1:
    "Словно она наконец может самоутвердиться рядом с Кайли."

# ch/harems_full/taming/events.rpy:3548
translate russian taming_event_04_636286a1_1:
    "Доминировать над ней приемлемым способом."

# ch/harems_full/taming/events.rpy:3549
translate russian taming_event_04_3cc7a483_1:
    "С моей точки зрения, всё это ещё и невероятно возбуждает!"

# ch/harems_full/taming/events.rpy:3550
translate russian taming_event_04_71b3024b_1:
    "Честно говоря, не помню, как мой член оказался у меня в руке."

# ch/harems_full/taming/events.rpy:3551
translate russian taming_event_04_9e60c4a7_1:
    "Но он твёрдый, и я не могу не поглаживать его, наблюдая."

# ch/harems_full/taming/events.rpy:3552
translate russian taming_event_04_6836df2f_1:
    "Я наклоняюсь ближе, пользуясь возможностью поиграть с беспомощным телом Кайли."

# ch/harems_full/taming/events.rpy:3553
translate russian taming_event_04_3f8def97_1:
    "Сжимаю её грудь, пощипываю соски и делаю всё, что приходит в голову."

# ch/harems_full/taming/events.rpy:3554
translate russian taming_event_04_1e1af1f5_1:
    "Ведь она никак не может мне помешать."

# ch/harems_full/taming/events.rpy:3555
translate russian taming_event_04_7fdd7438_1:
    "Кайли извивается на кровати от ласк и проникновения, которыми мы окружаем её со всех сторон."

# ch/harems_full/taming/events.rpy:3556
translate russian taming_event_04_907e2d1f_1:
    "Она безуспешно тянет путы, которые сама велела нам завязать, не в силах сопротивляться."

# ch/harems_full/taming/events.rpy:3557
translate russian taming_event_04_2cc06ead_1:
    "И лишь усиливает ощущения от всего, что мы с ней делаем."

# ch/harems_full/taming/events.rpy:3558
translate russian taming_event_04_6474f968_1:
    kylie.say "Ах..."

# ch/harems_full/taming/events.rpy:3559
translate russian taming_event_04_f4571542_1:
    kylie.say "О боже..."

# ch/harems_full/taming/events.rpy:3560
translate russian taming_event_04_2003b12e_1:
    kylie.say "Пожалуйста... я сейчас..."

# ch/harems_full/taming/events.rpy:3561
translate russian taming_event_04_c920c607_1:
    "Кайли даже не нужно договаривать."

# ch/harems_full/taming/events.rpy:3562
translate russian taming_event_04_7e230aa1_1:
    "Мы с Айшей прекрасно понимаем, что сейчас произойдёт."

# ch/harems_full/taming/events.rpy:3565
translate russian taming_event_04_4e405d54_1:
    "Но Айша не останавливается и даже не замедляется."

# ch/harems_full/taming/events.rpy:3566
