# ch/harems_full/taming/events.rpy:1875
translate russian taming_event_03_a_14d66230:
    kylie.say "Но я хотя бы не жестокая громила, как ты, Айша!"

# ch/harems_full/taming/events.rpy:1876
translate russian taming_event_03_a_8562883d:
    "Всё начинает выходить из-под контроля."

# ch/harems_full/taming/events.rpy:1877
translate russian taming_event_03_a_ba42b4c7:
    "Если срочно ничего не предпринять, свидания вообще не будет."

# ch/harems_full/taming/events.rpy:1878
translate russian taming_event_03_a_1a0d6544:
    "Всё закончится дракой, прямо здесь и сейчас!"

# ch/harems_full/taming/events.rpy:1879
translate russian taming_event_03_a_4292ed72:
    "Может, объяснить им ход моих мыслей?"

# ch/harems_full/taming/events.rpy:1880
translate russian taming_event_03_a_2fdb08d2:
    "Вдруг это убедит их, что идея хорошая..."

# ch/harems_full/taming/events.rpy:1883
translate russian taming_event_03_a_3dc69b9d:
    mike.say "Ну, я подумал: в прошлый раз вы так и не уладили разногласия."

# ch/harems_full/taming/events.rpy:1884
translate russian taming_event_03_a_adf77f6d:
    mike.say "И решил устроить вам встречу, чтобы вы снова всё обсудили."

# ch/harems_full/taming/events.rpy:1885
translate russian taming_event_03_a_7205a829:
    mike.say "Только сделайте одолжение: на этот раз разберитесь до того, как мы уйдём из океанариума, ладно?"

# ch/harems_full/taming/events.rpy:1886
translate russian taming_event_03_a_b15e5cb3:
    mike.say "Потому что это уже порядком надоело!"

# ch/harems_full/taming/events.rpy:1889
translate russian taming_event_03_a_5df2dfae:
    "Дослушав, Айша и Кайли обе сердито смотрят на меня."

# ch/harems_full/taming/events.rpy:1890
translate russian taming_event_03_a_c033253b:
    "На миг мне кажется, что сейчас они отвесят мне столько пощёчин, что я лишусь чувств."

# ch/harems_full/taming/events.rpy:1891
translate russian taming_event_03_a_f4ef92fe:
    "Но затем отворачиваются и сердито уходят в океанариум."

# ch/harems_full/taming/events.rpy:1892
translate russian taming_event_03_a_38eb9525:
    "Значит, я всё неплохо объяснил, да?"

# ch/harems_full/taming/events.rpy:1893
translate russian taming_event_03_a_e9cd1a79:
    "Ведь они и правда пошли туда вместе."

# ch/harems_full/taming/events.rpy:1898
translate russian taming_event_03_a_50190dd8:
    mike.say "Послушайте, простите, что обманул вас обеих, ладно?"

# ch/harems_full/taming/events.rpy:1899
translate russian taming_event_03_a_571e910c:
    mike.say "Нужно было честно предупредить каждую, что придёт и другая."

# ch/harems_full/taming/events.rpy:1900
translate russian taming_event_03_a_2b425eb4:
    mike.say "Но я боялся, что иначе вы обе откажетесь."

# ch/harems_full/taming/events.rpy:1901
translate russian taming_event_03_a_f80f4f49:
    mike.say "Знаю, у вас есть разногласия."

# ch/harems_full/taming/events.rpy:1902
translate russian taming_event_03_a_55609c4e:
    mike.say "Но в прошлый раз мне было так хорошо с вами обеими."

# ch/harems_full/taming/events.rpy:1903
translate russian taming_event_03_a_095e3d5a:
    mike.say "Я просто хотел попробовать повторить это, и всё."

# ch/harems_full/taming/events.rpy:1904
translate russian taming_event_03_a_89b1be83:
    "Когда я заканчиваю, Айша и Кайли долго и пристально смотрят друг на друга."

# ch/harems_full/taming/events.rpy:1907
translate russian taming_event_03_a_a6ff0f31:
    "Затем обе медленно пожимают плечами и кивают."

# ch/harems_full/taming/events.rpy:1908
translate russian taming_event_03_a_04b8198c:
    ayesha.say "Ладно, [lssb_common.hero_name()], ладно."

# ch/harems_full/taming/events.rpy:1909
translate russian taming_event_03_a_f0c85bb1:
    ayesha.say "Наверное, можно попробовать."

# ch/harems_full/taming/events.rpy:1910
translate russian taming_event_03_a_e791feac:
    kylie.say "Хорошо, хорошо, хорошо..."

# ch/harems_full/taming/events.rpy:1911
translate russian taming_event_03_a_87b5985b:
    kylie.say "Но это пробный раз, ясно?"

# ch/harems_full/taming/events.rpy:1912
translate russian taming_event_03_a_4b331b50:
    "Я киваю, сейчас готовый согласиться на что угодно."

# ch/harems_full/taming/events.rpy:1913
translate russian taming_event_03_a_16c5573d:
    "И мы вместе заходим в океанариум."

# ch/harems_full/taming/events.rpy:1916
translate russian taming_event_03_a_aada299f:
    mike.say "Айша права, Кайли."

# ch/harems_full/taming/events.rpy:1919
translate russian taming_event_03_a_3fadeffc:
    mike.say "Ты и правда немного не в себе."

# ch/harems_full/taming/events.rpy:1920
translate russian taming_event_03_a_5d52ad8a:
    mike.say "Я пригласил вас обеих на свидание."

# ch/harems_full/taming/events.rpy:1921
translate russian taming_event_03_a_04209d86:
    mike.say "А ты прячешься по углам, чтобы потом выскочить на нас!"

# ch/harems_full/taming/events.rpy:1922
translate russian taming_event_03_a_c671c3d6:
    "Дослушав, Кайли сердито смотрит на меня."

# ch/harems_full/taming/events.rpy:1924
translate russian taming_event_03_a_4eb8e861:
    "На миг мне кажется, что сейчас она отхлещет меня по щекам до потери сознания."

# ch/harems_full/taming/events.rpy:1925
translate russian taming_event_03_a_9b908e04:
    "Но затем она резко разворачивается и сердито уходит в океанариум."

# ch/harems_full/taming/events.rpy:1926
translate russian taming_event_03_a_c8ea3ed5:
    "Я ищу поддержки у Айши и вижу, что она улыбается."

# ch/harems_full/taming/events.rpy:1927
translate russian taming_event_03_a_df8274a2:
    "Без всяких просьб она берёт меня за руку."

# ch/harems_full/taming/events.rpy:1928
translate russian taming_event_03_a_f971f51f:
    "И почти затягивает внутрь вслед за Кайли."

# ch/harems_full/taming/events.rpy:1932
translate russian taming_event_03_a_4cbe6bde:
    mike.say "Кайли права, Айша."

# ch/harems_full/taming/events.rpy:1935
translate russian taming_event_03_a_05cc46f7:
    mike.say "Тебе нужно успокоиться, ладно?"

# ch/harems_full/taming/events.rpy:1936
translate russian taming_event_03_a_5d52ad8a_1:
    mike.say "Я пригласил вас обеих на свидание."

# ch/harems_full/taming/events.rpy:1937
translate russian taming_event_03_a_ff575662:
    mike.say "А стоило Кайли появиться, ты тут же начала давить на неё!"

# ch/harems_full/taming/events.rpy:1938
translate russian taming_event_03_a_e4a4dbc6:
    "Дослушав, Айша сердито смотрит на меня."

# ch/harems_full/taming/events.rpy:1940
translate russian taming_event_03_a_4eb8e861_1:
    "На миг мне кажется, что сейчас она отхлещет меня по щекам до потери сознания."

# ch/harems_full/taming/events.rpy:1941
translate russian taming_event_03_a_9b908e04_1:
    "Но затем она резко разворачивается и сердито уходит в океанариум."

# ch/harems_full/taming/events.rpy:1942
translate russian taming_event_03_a_624f0b11:
    "Я ищу поддержки у Кайли и вижу, что она улыбается."

# ch/harems_full/taming/events.rpy:1943
translate russian taming_event_03_a_df8274a2_1:
    "Без всяких просьб она берёт меня за руку."

# ch/harems_full/taming/events.rpy:1944
translate russian taming_event_03_a_362889c3:
    "И почти затягивает внутрь вслед за Айшей."

# ch/harems_full/taming/events.rpy:1947
translate russian taming_event_03_a_6f89840c:
    "Внутри всё и правда немного налаживается."

# ch/harems_full/taming/events.rpy:1950
translate russian taming_event_03_a_63274378:
    "Может, Айша и Кайли сегодня действительно постараются поладить."

# ch/harems_full/taming/events.rpy:1951
translate russian taming_event_03_a_fa448fc8:
    "А может, всё дело в приглушённом свете и мерцающей воде."

# ch/harems_full/taming/events.rpy:1952
translate russian taming_event_03_a_be18f2d8:
    "Как бы то ни было, я стараюсь извлечь из временного перемирия максимум."

# ch/harems_full/taming/events.rpy:1953
translate russian taming_event_03_a_50374e53:
    "Стоит одной из девушек чем-то заинтересоваться, как я уже рядом."

# ch/harems_full/taming/events.rpy:1954
translate russian taming_event_03_a_d2c3f92d:
    "Читаю вслух все таблички у аквариумов и даже задаю вопросы сотрудникам."

# ch/harems_full/taming/events.rpy:1955
translate russian taming_event_03_a_c9340c3f:
    "И мне каким-то образом удаётся уделять внимание и Айше, и Кайли."

# ch/harems_full/taming/events.rpy:1956
translate russian taming_event_03_a_a2829c31:
    "К тому времени, как мы подходим к одному из самых больших аквариумов, обе вполне расслаблены."

# ch/harems_full/taming/events.rpy:1957
translate russian taming_event_03_a_155c9c26:
    kylie.say "М-м..."

# ch/harems_full/taming/events.rpy:1958
translate russian taming_event_03_a_308cf3b6:
    kylie.say "Интересно, каково это — плавать там?"

# ch/harems_full/taming/events.rpy:1959
translate russian taming_event_03_a_e4217b3d:
    ayesha.say "Что, в этом аквариуме?"

# ch/harems_full/taming/events.rpy:1960
translate russian taming_event_03_a_28acdfe2:
    ayesha.say "Со всеми этими рыбами?"

# ch/harems_full/taming/events.rpy:1961
translate russian taming_event_03_a_5a1ffaac:
    "Впервые слышу, как Айша и Кайли разговаривают друг с другом."

# ch/harems_full/taming/events.rpy:1962
translate russian taming_event_03_a_8ab3d752:
    "Ну, по крайней мере разговаривают без ссоры!"

# ch/harems_full/taming/events.rpy:1963
translate russian taming_event_03_a_d07c6107:
    "Поэтому незаметно подбираюсь поближе, надеясь послушать."

# ch/harems_full/taming/events.rpy:1964
translate russian taming_event_03_a_b03a6477:
    kylie.say "Да ладно тебе, Айша."

# ch/harems_full/taming/events.rpy:1965
translate russian taming_event_03_a_a1fe1d0d:
    kylie.say "Только не говори, что никогда не мечтала стать русалкой!"

# ch/harems_full/taming/events.rpy:1966
translate russian taming_event_03_a_0d41d757:
    kylie.say "Я раньше постоянно об этом мечтала."

# ch/harems_full/taming/events.rpy:1967
translate russian taming_event_03_a_02849350:
    ayesha.say "Ну... да."

# ch/harems_full/taming/events.rpy:1969
translate russian taming_event_03_a_acb58669:
    ayesha.say "Наверное, и правда мечтала!"

# ch/harems_full/taming/events.rpy:1970
translate russian taming_event_03_a_47bb57fe:
    kylie.say "Хотя, знаешь, Айша..."

# ch/harems_full/taming/events.rpy:1971
translate russian taming_event_03_a_020d4934:
    kylie.say "Может, тебе больше подошло бы что-нибудь покрупнее?"

# ch/harems_full/taming/events.rpy:1972
translate russian taming_event_03_a_892d44b0:
    kylie.say "Например, косатка?"

# ch/harems_full/taming/events.rpy:1973
translate russian taming_event_03_a_8aeaa8f7:
    "Как только разговор становится язвительным, моё настроение стремительно падает."

# ch/harems_full/taming/events.rpy:1974
translate russian taming_event_03_a_ba4c4bf7:
    "Я глубоко вдыхаю, готовясь вмешаться и прекратить ссору."

# ch/harems_full/taming/events.rpy:1977
translate russian taming_event_03_a_4633124f:
    ayesha.say "Да ну?"

# ch/harems_full/taming/events.rpy:1978
translate russian taming_event_03_a_c94f3aef:
    ayesha.say "А ты напоминаешь мне одну из тех акул, Кайли."

# ch/harems_full/taming/events.rpy:1979
translate russian taming_event_03_a_f1ec331f:
    ayesha.say "Холоднокровная, злая, с маленькими глазками-бусинками!"

# ch/harems_full/taming/events.rpy:1980
translate russian taming_event_03_a_bdf87b59:
    mike.say "Эй, эй, эй..."

# ch/harems_full/taming/events.rpy:1981
translate russian taming_event_03_a_19986628:
    mike.say "Что здесь происходит?"

# ch/harems_full/taming/events.rpy:1982
translate russian taming_event_03_a_59dfcdce:
    mike.say "Мы ведь вроде хорошо проводили время?"

# ch/harems_full/taming/events.rpy:1983
translate russian taming_event_03_a_9f9bb4dc:
    ayesha.say "Кайли первая начала!"

# ch/harems_full/taming/events.rpy:1985
translate russian taming_event_03_a_62c43b47:
    ayesha.say "Я просто пыталась быть милой!"

# ch/harems_full/taming/events.rpy:1986
translate russian taming_event_03_a_57b072d2:
    kylie.say "Я не виновата, что Айша не понимает шуток!"

# ch/harems_full/taming/events.rpy:1988
translate russian taming_event_03_a_7df51205:
    kylie.say "Пусть перестанет быть такой обидчивой!"

# ch/harems_full/taming/events.rpy:1990
translate russian taming_event_03_a_77bb4ff4:
    "Похоже, придётся это уладить..."

# ch/harems_full/taming/events.rpy:1993
translate russian taming_event_03_a_9a9bbd0c:
    mike.say "Вы обе можете хотя бы попытаться вести себя повзрослее?"

# ch/harems_full/taming/events.rpy:1994
translate russian taming_event_03_a_3294c6a8:
    mike.say "Я слышал каждое слово, которое вы сейчас друг другу сказали."

# ch/harems_full/taming/events.rpy:1995
translate russian taming_event_03_a_2fddf260:
    mike.say "И, чтобы закончить спор, русалками вы обе выглядели бы нелепо!"

# ch/harems_full/taming/events.rpy:1996
translate russian taming_event_03_a_a8b904ea:
    mike.say "Не могу даже представить, как вы плюхаетесь на берегу словно тюлени!"

# ch/harems_full/taming/events.rpy:1997
translate russian taming_event_03_a_bec37164:
    "У Айши и Кайли почти одновременно отвисают челюсти."

# ch/harems_full/taming/events.rpy:2000
translate russian taming_event_03_a_24a2ef5f:
    "Но я не задерживаюсь ни для извинений, ни для их ответов."

# ch/harems_full/taming/events.rpy:2001
translate russian taming_event_03_a_52b261e4:
    "Считаю, что уже высказался вполне ясно, поэтому просто разворачиваюсь и ухожу."

# ch/harems_full/taming/events.rpy:2006
translate russian taming_event_03_a_a8c470b1:
    mike.say "Может, хватит уже разговоров о русалках?"

# ch/harems_full/taming/events.rpy:2007
translate russian taming_event_03_a_17660a4b:
    mike.say "Теперь только и могу представлять вас с хвостами!"

# ch/harems_full/taming/events.rpy:2008
translate russian taming_event_03_a_a40c8b2f:
    mike.say "И... ну... в лифчиках из ракушек!"

# ch/harems_full/taming/events.rpy:2009
translate russian taming_event_03_a_5010e92e:
    "Вдруг я замечаю перемену в Айше и Кайли."

# ch/harems_full/taming/events.rpy:2012
translate russian taming_event_03_a_c5d310ba:
    "Всё потому, что они почуяли мою слабость!"

# ch/harems_full/taming/events.rpy:2013
translate russian taming_event_03_a_57d0a800:
    kylie.say "Правда, [lssb_common.hero_name()]?"

# ch/harems_full/taming/events.rpy:2014
translate russian taming_event_03_a_40977085:
    kylie.say "Тебя это так возбуждает, да?"

# ch/harems_full/taming/events.rpy:2015
translate russian taming_event_03_a_34c97c84:
    kylie.say "Представлять нас с Айшей русалками?"

# ch/harems_full/taming/events.rpy:2016
translate russian taming_event_03_a_86e0e3c2:
    ayesha.say "Мне... кажется, мне тоже нравится!"

# ch/harems_full/taming/events.rpy:2017
translate russian taming_event_03_a_1e36a78a:
    ayesha.say "Иметь сильный, мощный хвост!"

# ch/harems_full/taming/events.rpy:2018
translate russian taming_event_03_a_cf8be08b:
    ayesha.say "Утаскивать мужчин в воду навстречу гибели!"

# ch/harems_full/taming/events.rpy:2019
translate russian taming_event_03_a_1c3c9286:
    kylie.say "Да, Айша! Только представь, что мы перед этим с ними сделаем!"

# ch/harems_full/taming/events.rpy:2020
translate russian taming_event_03_a_3ebedede:
    mike.say "Вы можете прекратить, пожалуйста?"

# ch/harems_full/taming/events.rpy:2021
translate russian taming_event_03_a_877ac738:
    mike.say "А то мне придётся уйти в туалет, чтобы снять напряжение!"

# ch/harems_full/taming/events.rpy:2022
translate russian taming_event_03_a_f2eca5e5:
    "Айша и Кайли вместе искренне смеются, пусть и надо мной."

# ch/harems_full/taming/events.rpy:2023
translate russian taming_event_03_a_b160766c:
    "Я облегчённо вздыхаю, но затем вспоминаю о том, что творится у меня в шортах."

# ch/harems_full/taming/events.rpy:2024
translate russian taming_event_03_a_b8cef3f0:
    "Может, если немного посмотреть на совсем уж уродливых рыб, всё пройдёт..."

# ch/harems_full/taming/events.rpy:2027
translate russian taming_event_03_a_642db23f:
    mike.say "Не стоит дразнить Айшу из-за её комплекции, Кайли."

# ch/harems_full/taming/events.rpy:2029
translate russian taming_event_03_a_d3d70614:
    mike.say "Это всё мышцы, результат тренировок в зале."

# ch/harems_full/taming/events.rpy:2030
translate russian taming_event_03_a_33bbedb0:
    mike.say "Да и задница у тебя гораздо больше, чем у неё!"

# ch/harems_full/taming/events.rpy:2031
