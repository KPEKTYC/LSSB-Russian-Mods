# Native Taphophile identifiers, current source catalog. Translation only.

# ch/harems_full/taphophile/events.rpy:24
translate russian cemetery_threesome_84487fb4:
    "Я спешу по своим делам и уже боюсь, что не успею вовремя."

# ch/harems_full/taphophile/events.rpy:25
translate russian cemetery_threesome_27d8be81:
    "Поэтому решаю срезать путь: знаю, что чуть впереди есть проход."

# ch/harems_full/taphophile/events.rpy:26
translate russian cemetery_threesome_e7c113b2:
    "Проблема лишь в том, что он ведёт через место, где мне совсем не хочется бродить в темноте."

# ch/harems_full/taphophile/events.rpy:27
translate russian cemetery_threesome_8bbe4d85:
    "Через кладбище, ворота которого открыты в любое время дня и ночи."

# ch/harems_full/taphophile/events.rpy:28
translate russian cemetery_threesome_be724142:
    "Сразу проясним: сверхъестественного я не боюсь, ясно?"

# ch/harems_full/taphophile/events.rpy:29
translate russian cemetery_threesome_0e64b246:
    "Гораздо страшнее перспектива, что меня там ограбят или на меня нападут."

# ch/harems_full/taphophile/events.rpy:30
translate russian cemetery_threesome_061ae074:
    "Освещение плохое, кругом надгробия и склепы — отличные укрытия."

# ch/harems_full/taphophile/events.rpy:31
translate russian cemetery_threesome_438a841c:
    "Проходя через ворота, я опасаюсь встречи именно с живыми людьми из плоти и крови."

# ch/harems_full/taphophile/events.rpy:32
translate russian cemetery_threesome_499f1271:
    "А не с упырями и призраками, выскакивающими из могил!"

# ch/harems_full/taphophile/events.rpy:33
translate russian cemetery_threesome_d900357e:
    "Помня об этом, я прибавляю шаг, почти переходя на бег."

# ch/harems_full/taphophile/events.rpy:34
translate russian cemetery_threesome_214aa057:
    "Так я быстро пересеку кладбище и продолжу свой путь."

# ch/harems_full/taphophile/events.rpy:35
translate russian cemetery_threesome_68398ed3:
    "Большую часть дороги прохожу без происшествий."

# ch/harems_full/taphophile/events.rpy:36
translate russian cemetery_threesome_7d6078e4:
    "Вижу лишь тени, а слышу только шум ветра в деревьях."

# ch/harems_full/taphophile/events.rpy:37
translate russian cemetery_threesome_8792e921:
    "Но стоит подумать, что я зря тревожился, как всё меняется."

# ch/harems_full/taphophile/events.rpy:38
translate russian cemetery_threesome_700160fe:
    "Я замечаю и слышу нечто, от чего волосы встают дыбом."

# ch/harems_full/taphophile/events.rpy:39
translate russian cemetery_threesome_677a371f:
    "Немного в стороне от главной кладбищенской дорожки есть небольшой холм."

# ch/harems_full/taphophile/events.rpy:40
translate russian cemetery_threesome_0f09de49:
    "На нём стоят несколько вычурных гробниц, украшенных крестами и статуями."

# ch/harems_full/taphophile/events.rpy:41
translate russian cemetery_threesome_2c4f67b5:
    "Клянусь, среди них движется что-то белое."

# ch/harems_full/taphophile/events.rpy:42
translate russian cemetery_threesome_fc096d84:
    "И слышатся какие-то призрачные голоса!"

# ch/harems_full/taphophile/events.rpy:43
translate russian cemetery_threesome_578c7c60:
    violaine.say "О да..."

# ch/harems_full/taphophile/events.rpy:44
translate russian cemetery_threesome_8fe60b71:
    violaine.say "О да, владыка ночи!"

# ch/harems_full/taphophile/events.rpy:45
translate russian cemetery_threesome_b46b2541:
    "Винсент" "Я поражаю твоё воображение?"

# ch/harems_full/taphophile/events.rpy:46
translate russian cemetery_threesome_d5abd905:
    "Первая мысль — броситься наутёк."

# ch/harems_full/taphophile/events.rpy:47
translate russian cemetery_threesome_89a90ed0:
    "До противоположного края кладбища отсюда недалеко."

# ch/harems_full/taphophile/events.rpy:48
translate russian cemetery_threesome_9f9f3747:
    "Уверен, успею добраться туда, прежде чем тот, кто наверху, меня догонит."

# ch/harems_full/taphophile/events.rpy:49
translate russian cemetery_threesome_355c45bd:
    "Но в этих голосах есть что-то странно знакомое."

# ch/harems_full/taphophile/events.rpy:50
translate russian cemetery_threesome_97e5e402:
    "Словно я уже слышал их раньше, только отсюда не могу понять, кому они принадлежат."

# ch/harems_full/taphophile/events.rpy:51
translate russian cemetery_threesome_be70d9f6:
    "Наверное, я ещё пожалею об этом решении. И скорее рано, чем поздно."

# ch/harems_full/taphophile/events.rpy:52
translate russian cemetery_threesome_2dcf6bf2:
    "Но что-то заставляет меня свернуть и начать подниматься на холм."

# ch/harems_full/taphophile/events.rpy:53
translate russian cemetery_threesome_beb0a269:
    "Чем ближе я к источнику голосов, тем отчётливее их слышу."

# ch/harems_full/taphophile/events.rpy:54
translate russian cemetery_threesome_b67b9ae7:
    "Поначалу кажется, что это какое-то песнопение или даже обряд."

# ch/harems_full/taphophile/events.rpy:55
translate russian cemetery_threesome_3f023318:
    "Затем я лучше различаю тех, кому принадлежат голоса."

# ch/harems_full/taphophile/events.rpy:57
translate russian cemetery_threesome_47d609b6:
    "На плоской гробнице вижу два бледных тела, одно поверх другого."

# ch/harems_full/taphophile/events.rpy:58
translate russian cemetery_threesome_1718e610:
    "Белые как снег, в лунном свете они словно сияют."

# ch/harems_full/taphophile/events.rpy:59
translate russian cemetery_threesome_8b3aca8c:
    "Вдруг я наступаю на что-то, и раздаётся звук."

# ch/harems_full/taphophile/events.rpy:60
translate russian cemetery_threesome_307cdfff:
    "Обе головы поворачиваются ко мне, и я вижу два бледных лица."

# ch/harems_full/taphophile/events.rpy:61
translate russian cemetery_threesome_f478e6fb:
    "Они словно сошли прямо с экрана фильма ужасов!"

# ch/harems_full/taphophile/events.rpy:62
translate russian cemetery_threesome_0a90abc1:
    "Я почти вскрикиваю от страха, но они заговаривают первыми."

# ch/harems_full/taphophile/events.rpy:63
translate russian cemetery_threesome_eb3a7f51:
    "И к моему удивлению, улыбаются и кивают!"

# ch/harems_full/taphophile/events.rpy:64
translate russian cemetery_threesome_581bf842:
    violaine.say "Ох..."

# ch/harems_full/taphophile/events.rpy:65
translate russian cemetery_threesome_f67933ad:
    violaine.say "[lssb_common.hero_name()], это ты!"

# ch/harems_full/taphophile/events.rpy:66
translate russian cemetery_threesome_89658426:
    "Винсент" "Приветствую, друг!"

# ch/harems_full/taphophile/events.rpy:67
translate russian cemetery_threesome_5ac972a3:
    "Винсент" "Вот уж не ожидал встретить тебя здесь!"

# ch/harems_full/taphophile/events.rpy:68
translate russian cemetery_threesome_a84faceb:
    "Узнав Виолен и Винсента, я невольно облегчённо вздыхаю."

# ch/harems_full/taphophile/events.rpy:69
translate russian cemetery_threesome_7d48bb7e:
    "Это не два мертвенно-бледных упыря, а просто пара знакомых готов!"

# ch/harems_full/taphophile/events.rpy:70
translate russian cemetery_threesome_3ab81369:
    "Но это всё ещё не объясняет, что они делают на кладбище."

# ch/harems_full/taphophile/events.rpy:71
translate russian cemetery_threesome_0f12376b:
    "Хотя теперь, вблизи, ситуация становится понятнее."

# ch/harems_full/taphophile/events.rpy:72
translate russian cemetery_threesome_0f56747f:
    "Они ведь голые и лежат в откровенной позе на гробнице."

# ch/harems_full/taphophile/events.rpy:73
translate russian cemetery_threesome_aa02431e:
    "Какое тут самое вероятное объяснение?"

# ch/harems_full/taphophile/events.rpy:75
translate russian cemetery_threesome_5d75927d:
    mike.say "Привет, ребята..."

# ch/harems_full/taphophile/events.rpy:76
translate russian cemetery_threesome_44a2b190:
    mike.say "Я просто шёл здесь, чтобы срезать путь."

# ch/harems_full/taphophile/events.rpy:77
translate russian cemetery_threesome_1f260852:
    mike.say "Услышал шум и решил проверить."

# ch/harems_full/taphophile/events.rpy:78
translate russian cemetery_threesome_786493e9:
    mike.say "Не хотел вам мешать!"

# ch/harems_full/taphophile/events.rpy:79
translate russian cemetery_threesome_e5b5a967:
    "Большинство людей разозлились бы и обиделись, если бы их застали за сексом в общественном месте."

# ch/harems_full/taphophile/events.rpy:80
translate russian cemetery_threesome_4c07b600:
    "Но Виолен и Винсент относятся к этому спокойно: только кивают и улыбаются."

# ch/harems_full/taphophile/events.rpy:81
translate russian cemetery_threesome_c2809ab2:
    violaine.say "Не беспокойся, [lssb_common.hero_name()]."

# ch/harems_full/taphophile/events.rpy:82
translate russian cemetery_threesome_bbb87db4:
    violaine.say "Ты хотя бы извинился."

# ch/harems_full/taphophile/events.rpy:83
translate russian cemetery_threesome_fc3d9edf:
    violaine.say "Обычно люди проявляют куда меньше понимания."

# ch/harems_full/taphophile/events.rpy:84
translate russian cemetery_threesome_7c1876fd:
    "Винсент" "Они ТАК ограниченны!"

# ch/harems_full/taphophile/events.rpy:85
translate russian cemetery_threesome_0c703707:
    "Винсент" "Когда такое случается, очень разочаровывает."

# ch/harems_full/taphophile/events.rpy:86
translate russian cemetery_threesome_a09c8d75:
    "Я совершенно не знаю, как вести себя в этой ситуации."

# ch/harems_full/taphophile/events.rpy:87
translate russian cemetery_threesome_4bff142e:
    "Но раз Виолен и Винсент спокойны, просто беру с них пример."

# ch/harems_full/taphophile/events.rpy:89
translate russian cemetery_threesome_6f2c9359:
    mike.say "Вы тут ради какого-нибудь магического обряда?"

# ch/harems_full/taphophile/events.rpy:90
translate russian cemetery_threesome_8ae68a8b:
    mike.say "Занимаетесь любовью на могиле знаменитой ведьмы или колдуна?"

# ch/harems_full/taphophile/events.rpy:91
translate russian cemetery_threesome_1d9a7bfe:
    mike.say "Или вызываете демона с помощью сексуальной энергии?"

# ch/harems_full/taphophile/events.rpy:92
translate russian cemetery_threesome_430c4fda:
    violaine.say "О нет, [lssb_common.hero_name()]!"

# ch/harems_full/taphophile/events.rpy:93
translate russian cemetery_threesome_0eeee110:
    violaine.say "У наших соседей ремонт."

# ch/harems_full/taphophile/events.rpy:94
translate russian cemetery_threesome_a29443dc:
    "Винсент" "Да, мы пришли сюда за тишиной и покоем."

# ch/harems_full/taphophile/events.rpy:95
translate russian cemetery_threesome_d9a9c37a:
    "Винсент" "Этот шум сводил мой крохотный умишко с ума!"

# ch/harems_full/taphophile/events.rpy:96
translate russian cemetery_threesome_0bb03cd0:
    violaine.say "А эту могилу выбрали просто потому, что она удобнее остальных."

# ch/harems_full/taphophile/events.rpy:97
translate russian cemetery_threesome_61ca5f57:
    "Винсент" "Кажется, тут похоронен человек, который торговал подержанными машинами!"

# ch/harems_full/taphophile/events.rpy:98
translate russian cemetery_threesome_b7b990bf:
    "Я усмехаюсь и качаю головой."

# ch/harems_full/taphophile/events.rpy:100
translate russian cemetery_threesome_5e18eb48:
    mike.say "Мне и правда пора идти."

# ch/harems_full/taphophile/events.rpy:101
translate russian cemetery_threesome_07cfb02f:
    mike.say "Простите, что помешал!"

# ch/harems_full/taphophile/events.rpy:102
translate russian cemetery_threesome_a41c68c8:
    "Виолен и Винсент обмениваются многозначительными взглядами."

# ch/harems_full/taphophile/events.rpy:103
translate russian cemetery_threesome_b4a15ef7:
    "Поначалу ни один не произносит ни слова."

# ch/harems_full/taphophile/events.rpy:104
translate russian cemetery_threesome_8ebf210f:
    "Но мне кажется, между ними только что промелькнула общая мысль."

# ch/harems_full/taphophile/events.rpy:105
translate russian cemetery_threesome_7db21968:
    violaine.say "Не торопись уходить, [lssb_common.hero_name()]."

# ch/harems_full/taphophile/events.rpy:106
translate russian cemetery_threesome_a2f159a1:
    violaine.say "Может, присоединишься?"

# ch/harems_full/taphophile/events.rpy:107
translate russian cemetery_threesome_6692d358:
    "Винсент" "Да, места здесь предостаточно."

# ch/harems_full/taphophile/events.rpy:108
translate russian cemetery_threesome_d068587c:
    "Винсент" "Мы могли бы стать зверем с ТРЕМЯ спинами!"

# ch/harems_full/taphophile/events.rpy:111
translate russian cemetery_threesome_7eff2abd:
    "Вдруг необходимость спешить по делам перестаёт казаться такой важной."

# ch/harems_full/taphophile/events.rpy:112
translate russian cemetery_threesome_19b22756:
    "Вместо этого я пристально разглядываю очертания голого тела Виолен."

# ch/harems_full/taphophile/events.rpy:113
translate russian cemetery_threesome_87cf207f:
    "Да, она бледна до анемичности, но при этом бесспорно сексуальна."

# ch/harems_full/taphophile/events.rpy:114
translate russian cemetery_threesome_119d1083:
    "И судя по её ярким голубым глазам, настроена совершенно серьёзно!"

# ch/harems_full/taphophile/events.rpy:115
translate russian cemetery_threesome_d453d042:
    "Я перевожу взгляд на Винсента, и он кивает, подтверждая, что не шутит."

# ch/harems_full/taphophile/events.rpy:116
translate russian cemetery_threesome_97f7f873:
    "Может, раздеваться рядом с ним мне не так уж хочется."

# ch/harems_full/taphophile/events.rpy:117
translate russian cemetery_threesome_4a67fc4d:
    "Но он не собирается выбираться из-под Виолен."

# ch/harems_full/taphophile/events.rpy:118
translate russian cemetery_threesome_fb4888ef:
    "Так что хотя бы не придётся смотреть ему в лицо!"

# ch/harems_full/taphophile/events.rpy:119
translate russian cemetery_threesome_75370f11:
    mike.say "Ладно, раз вы настаиваете!"

# ch/harems_full/taphophile/events.rpy:120
translate russian cemetery_threesome_1a8233a7:
    mike.say "Ради кое-чего стоит и опоздать!"

# ch/harems_full/taphophile/events.rpy:121
translate russian cemetery_threesome_f94debff:
    "Виолен и Винсент кивают и сдержанно усмехаются."

# ch/harems_full/taphophile/events.rpy:122
translate russian cemetery_threesome_77eb75af:
    "А я уже раздеваюсь рядом с ними."

# ch/harems_full/taphophile/events.rpy:123
translate russian cemetery_threesome_2ce14683:
    violaine.say "Скорее забирайся, [lssb_common.hero_name()]."

# ch/harems_full/taphophile/events.rpy:124
translate russian cemetery_threesome_e3ef9171:
    violaine.say "Винсент уже занял парадный вход в мою пещеру летучих мышей."

# ch/harems_full/taphophile/events.rpy:125
translate russian cemetery_threesome_d5243e4c:
    violaine.say "Так что тебе придётся воспользоваться чёрным ходом!"

# ch/harems_full/taphophile/events.rpy:129
translate russian cemetery_threesome_2faccbc8:
    "Я с готовностью киваю, забираюсь на гробницу, а затем на Виолен."

# ch/harems_full/taphophile/events.rpy:130
translate russian cemetery_threesome_3a9cf841:
    "Она тоже кивает, когда я беру её за бёдра и развожу ягодицы."

# ch/harems_full/taphophile/events.rpy:131
translate russian cemetery_threesome_c9b64ad2:
    "Мой член уже твёрдый, так что я без промедления подаюсь вперёд."

# ch/harems_full/taphophile/events.rpy:133
translate russian cemetery_threesome_25545615:
    "Виолен стонет, чувствуя, как он входит ей в попку."

# ch/harems_full/taphophile/events.rpy:134
translate russian cemetery_threesome_c437a86e:
    "Она оглядывается через плечо, прикусывая кроваво-красную губу."

# ch/harems_full/taphophile/events.rpy:135
translate russian cemetery_threesome_a64c0936:
    "Я не отвожу взгляда, медленно погружаясь в неё."

# ch/harems_full/taphophile/events.rpy:136
translate russian cemetery_threesome_7a9e222c:
    "Винсент" "Сэр, мадам..."

# ch/harems_full/taphophile/events.rpy:137
translate russian cemetery_threesome_03fa52f3:
    "Винсент" "Приступим?"

# ch/harems_full/taphophile/events.rpy:138
translate russian cemetery_threesome_7a3608ff:
    "С этими словами он начинает двигаться снизу."

# ch/harems_full/taphophile/events.rpy:139
translate russian cemetery_threesome_9d142745:
    "Мгновение спустя я делаю то же самое сверху."

# ch/harems_full/taphophile/events.rpy:140
translate russian cemetery_threesome_8419917e:
    "Мы инстинктивно согласуем движения, чтобы не мешать друг другу."

# ch/harems_full/taphophile/events.rpy:141
translate russian cemetery_threesome_a2aef11e:
    "И вскоре Виолен уже скачет сразу на двух членах."

# ch/harems_full/taphophile/events.rpy:142
translate russian cemetery_threesome_a3b8be87:
    "Когда один входит, другой выходит."

# ch/harems_full/taphophile/events.rpy:143
translate russian cemetery_threesome_8b63e156:
    "Наблюдать за этим весьма впечатляюще."

# ch/harems_full/taphophile/events.rpy:144
translate russian cemetery_threesome_92e865ac:
    "Она поднимается и опускается в ритме, который задаём мы."

# ch/harems_full/taphophile/events.rpy:145
translate russian cemetery_threesome_4fba5ca6:
    "И всё это время получает всё больше удовольствия!"

# ch/harems_full/taphophile/events.rpy:146
translate russian cemetery_threesome_578c7c60_1:
    violaine.say "О да..."

# ch/harems_full/taphophile/events.rpy:147
translate russian cemetery_threesome_868f6e47:
    violaine.say "Дайте мне..."

# ch/harems_full/taphophile/events.rpy:148
translate russian cemetery_threesome_1de8a6e8:
    violaine.say "Оскверните мою бренную плоть!"

# ch/harems_full/taphophile/events.rpy:149
translate russian cemetery_threesome_856500d3:
    violaine.say "Унесите меня в ад на волне изысканного наслаждения!"

# ch/harems_full/taphophile/events.rpy:150
translate russian cemetery_threesome_6b7fefd2:
    "Между витиеватыми фразами Виолен стонет от восторга."

# ch/harems_full/taphophile/events.rpy:151
translate russian cemetery_threesome_13ba198d:
    "Обеими руками ласкает своё тело, обводя каждый изгиб."

# ch/harems_full/taphophile/events.rpy:152
translate russian cemetery_threesome_871645e4:
    "Затем начинает сжимать собственную грудь почти отчаянно."

# ch/harems_full/taphophile/events.rpy:153
translate russian cemetery_threesome_bf1ed7d6:
    "Словно пытается выпустить часть нарастающего внутри напряжения."

# ch/harems_full/taphophile/events.rpy:154
translate russian cemetery_threesome_78b419f4:
    "Все трое уже приближаемся к этому моменту."

# ch/harems_full/taphophile/events.rpy:155
translate russian cemetery_threesome_560e301f:
    "Двигаемся вместе, подталкивая друг друга к новым вершинам."

# ch/harems_full/taphophile/events.rpy:156
translate russian cemetery_threesome_450fd107:
    "Все опасения насчёт секса в таком месте давно исчезли."

# ch/harems_full/taphophile/events.rpy:157
translate russian cemetery_threesome_6be5682a:
    "Теперь я могу думать лишь о движении внутри Виолен."

# ch/harems_full/taphophile/events.rpy:158
translate russian cemetery_threesome_e62d3360:
    "Хочу только услышать, как она кончит."

# ch/harems_full/taphophile/events.rpy:160
translate russian cemetery_threesome_60192fab:
    "Почувствовать, как в этот момент мышцы её попки сожмут мой член."

# ch/harems_full/taphophile/events.rpy:161
translate russian cemetery_threesome_41d4d4bf:
    violaine.say "Час настал!"

# ch/harems_full/taphophile/events.rpy:162
translate russian cemetery_threesome_63661dcd:
    violaine.say "Моя буря стремительно приближается!"

# ch/harems_full/taphophile/events.rpy:163
translate russian cemetery_threesome_ed7e42b5:
    violaine.say "Узрите, она уже здесь!"

# ch/harems_full/taphophile/events.rpy:165
translate russian cemetery_threesome_5b5ea813:
    "Когда Виолен кончает подо мной, чувствую, что тоже больше не могу."

# ch/harems_full/taphophile/events.rpy:167
translate russian cemetery_threesome_1f2ad7d0:
    "Издаю почти звериный стон, изливаясь в неё."

# ch/harems_full/taphophile/events.rpy:169
translate russian cemetery_threesome_9e142558:
    "Винсент" "Ого..."

# ch/harems_full/taphophile/events.rpy:170
translate russian cemetery_threesome_b46b2541_1:
    "Винсент" "Я поражаю твоё воображение?"

# ch/harems_full/taphophile/events.rpy:171
translate russian cemetery_threesome_6fc28aa0:
    "Мы все трое достигаем пика почти одновременно."

# ch/harems_full/taphophile/events.rpy:173
translate russian cemetery_threesome_18a3de6f:
    "Тела дрожат, дыхание становится рваным и тяжёлым."

# ch/harems_full/taphophile/events.rpy:174
translate russian cemetery_threesome_166ab1a3:
    "Когда всё заканчивается, я осторожно слезаю с Виолен и начинаю одеваться."

# ch/harems_full/taphophile/events.rpy:175
translate russian cemetery_threesome_e93052f3:
    "Виолен и Винсент делают то же самое, но гораздо неспешнее."

# ch/harems_full/taphophile/events.rpy:176
translate russian cemetery_threesome_1f96b836:
    "Им-то хорошо: в отличие от меня, им никуда не нужно!"

# ch/harems_full/taphophile/events.rpy:181
translate russian cemetery_threesome_afa900d4:
    violaine.say "Было весело, [lssb_common.hero_name()]."

# ch/harems_full/taphophile/events.rpy:182
translate russian cemetery_threesome_c0a8e442:
    violaine.say "Надо будет вскоре повторить!"

# ch/harems_full/taphophile/events.rpy:183
translate russian cemetery_threesome_ea56b470:
    "Винсент" "В следующий раз будем тебе очень рады."

# ch/harems_full/taphophile/events.rpy:184
translate russian cemetery_threesome_d06876d0:
    "Винсент" "Мы любим заниматься сексом в весьма необычных местах!"

# ch/harems_full/taphophile/events.rpy:185
translate russian cemetery_threesome_79b669f4:
    mike.say "Спасибо, ребята."

# ch/harems_full/taphophile/events.rpy:186
translate russian cemetery_threesome_828cfc4e:
    mike.say "Может, как-нибудь устроим."

# ch/harems_full/taphophile/events.rpy:187
translate russian cemetery_threesome_c52aa036:
    "Я машу им, торопливо спускаясь с холма."

# ch/harems_full/taphophile/events.rpy:191
translate russian cemetery_threesome_8a96d007:
    "Было весело, но мне не хочется выглядеть слишком жадным до продолжения."

# ch/harems_full/taphophile/events.rpy:192
translate russian cemetery_threesome_d931ced8:
    "Ведь понятия не имею, в каких ещё безумных местах эти двое любят трахаться!"

# ch/harems_full/taphophile/events.rpy:193
translate russian cemetery_threesome_0a67a3e7:
    "И, как ни стараюсь, ещё несколько часов не могу перестать перебирать варианты."

# ch/harems_full/taphophile/events.rpy:195
translate russian cemetery_threesome_33357698:
    "От этого предложения я невольно отступаю на шаг."

# ch/harems_full/taphophile/events.rpy:196
translate russian cemetery_threesome_1d3c19d2:
    "И уже качаю головой, поворачиваясь к выходу."

# ch/harems_full/taphophile/events.rpy:198
translate russian cemetery_threesome_1c1b986d:
    mike.say "Нет, ребята..."

# ch/harems_full/taphophile/events.rpy:199
translate russian cemetery_threesome_11f92601:
    mike.say "Хотя очень мило с вашей стороны предложить."

# ch/harems_full/taphophile/events.rpy:200
translate russian cemetery_threesome_f3e90ab8:
    mike.say "Будь у меня время, я бы с радостью!"

# ch/harems_full/taphophile/events.rpy:201
translate russian cemetery_threesome_4339b5f8:
    mike.say "Но, как я говорил, мне сейчас нужно в другое место."

# ch/harems_full/taphophile/events.rpy:202
translate russian cemetery_threesome_2c57866a:
    "Виолен и Винсент переглядываются и непринуждённо пожимают плечами."

# ch/harems_full/taphophile/events.rpy:203
translate russian cemetery_threesome_a1ec7f50:
    violaine.say "Жаль."

# ch/harems_full/taphophile/events.rpy:204
translate russian cemetery_threesome_9c17e859:
    violaine.say "Может, в следующий раз?"

# ch/harems_full/taphophile/events.rpy:205
translate russian cemetery_threesome_e4f8181a:
    "Винсент" "Конечно, мы дадим тебе знать."

# ch/harems_full/taphophile/events.rpy:206
translate russian cemetery_threesome_1c5f1fa4:
    "Винсент" "Тогда сможешь заранее освободить время, да?"

# ch/harems_full/taphophile/events.rpy:207
translate russian cemetery_threesome_48f4abd5:
    "Я киваю и улыбаюсь, уже уходя."

# ch/harems_full/taphophile/events.rpy:209
translate russian cemetery_threesome_c9b4df57:
    "Пока спускаюсь с холма, звуки за спиной возобновляются."

# ch/harems_full/taphophile/events.rpy:210
translate russian cemetery_threesome_464c673d:
    "Оставшийся путь через кладбище я всё же прохожу поспешно."

# ch/harems_full/taphophile/events.rpy:211
translate russian cemetery_threesome_f94daaea:
    "Из всех пугающих вещей, которые можно вообразить на кладбище, эта теперь на первом месте!"
