translate russian cupid_hanna_master_wedding_altar_calledoff_396018b3:
    "Ханна смотрит на меня, потом на Мастера, потом на священника, который ждёт с раскрытой книгой."

# dlc_cupid/ch/cupid/hanna_master/wedding.rpy:342
translate russian cupid_hanna_master_wedding_altar_calledoff_d6a737af:
    hanna.say "Я... не могу."

# dlc_cupid/ch/cupid/hanna_master/wedding.rpy:343
translate russian cupid_hanna_master_wedding_altar_calledoff_76a8d0ca:
    hanna.say "Прости. Я думала, что смогу, а потом был сегодняшний день, и..."

# dlc_cupid/ch/cupid/hanna_master/wedding.rpy:346
translate russian cupid_hanna_master_wedding_altar_calledoff_93494e7d:
    master.say "Сегодняшний день?"

# dlc_cupid/ch/cupid/hanna_master/wedding.rpy:348
translate russian cupid_hanna_master_wedding_altar_calledoff_92a8fd53:
    "Он принюхивается перед ней, потом передо мной."

# dlc_cupid/ch/cupid/hanna_master/wedding.rpy:350
translate russian cupid_hanna_master_wedding_altar_calledoff_b78a2ae9:
    master.say "Спортзал! От тебя пахнет спортзалом!" with vpunch

# dlc_cupid/ch/cupid/hanna_master/wedding.rpy:351
translate russian cupid_hanna_master_wedding_altar_calledoff_1f06ab2f:
    master.say "От вас обоих!"

# dlc_cupid/ch/cupid/hanna_master/wedding.rpy:353
translate russian cupid_hanna_master_wedding_altar_calledoff_59f66df3:
    "По скамьям прокатывается волна ахов."

# dlc_cupid/ch/cupid/hanna_master/wedding.rpy:355
translate russian cupid_hanna_master_wedding_altar_calledoff_73dea714:
    hanna.say "Ты должен был стать моим учителем. Я этого хотела. Клянусь, хотела."

# dlc_cupid/ch/cupid/hanna_master/wedding.rpy:356
translate russian cupid_hanna_master_wedding_altar_calledoff_57a8a816:
    hanna.say "Но я не могу из-за этого выйти за тебя замуж."

# dlc_cupid/ch/cupid/hanna_master/wedding.rpy:359
translate russian cupid_hanna_master_wedding_altar_calledoff_e74e53ff:
    "На мгновение Мастер выглядит на все свои девяносто три."

# dlc_cupid/ch/cupid/hanna_master/wedding.rpy:360
translate russian cupid_hanna_master_wedding_altar_calledoff_b0c7f2d8:
    "Потом он поправляет галстук — тот самый, который я дважды ему завязывал, — и кланяется ей."

# dlc_cupid/ch/cupid/hanna_master/wedding.rpy:362
translate russian cupid_hanna_master_wedding_altar_calledoff_5f035648:
    master.say "Что ж, дорогая. Мастер знает, когда урок окончен."

# dlc_cupid/ch/cupid/hanna_master/wedding.rpy:364
translate russian cupid_hanna_master_wedding_altar_calledoff_c5a6fe28:
    master.say "А что до тебя, [hero.name]... я слишком хорошо тебя обучил."

# dlc_cupid/ch/cupid/hanna_master/wedding.rpy:366
translate russian cupid_hanna_master_wedding_altar_calledoff_1388875a:
    "Он один идёт обратно по проходу, высоко подняв голову, и вся часовня провожает его взглядом."

# dlc_cupid/ch/cupid/hanna_master/wedding.rpy:367
translate russian cupid_hanna_master_wedding_altar_calledoff_3337c14b:
    "Священник закрывает книгу и смотрит на меня так, будто это мне следует извиняться перед Богом."

# dlc_cupid/ch/cupid/hanna_master/wedding.rpy:369
translate russian cupid_hanna_master_wedding_altar_calledoff_9e692732:
    "Ханна сгребает подол в оба кулака."

# dlc_cupid/ch/cupid/hanna_master/wedding.rpy:371
translate russian cupid_hanna_master_wedding_altar_calledoff_d9c247d1:
    hanna.say "Ну. Это самое худшее, что я когда-либо делала."

# dlc_cupid/ch/cupid/hanna_master/wedding.rpy:372
translate russian cupid_hanna_master_wedding_altar_calledoff_0cda3fac:
    hanna.say "Может, пойдём? Прямо сейчас, [lssb_hanna.hero_name()]? Пока я не струсила?"

# dlc_cupid/ch/cupid/hanna_master/wedding.rpy:374
translate russian cupid_hanna_master_wedding_altar_calledoff_f4e25890:
    "Она хватает меня за руку, и мы вдвоём несёмся к боковой двери, пока гости не успели понять, что сейчас произошло."

# dlc_cupid/ch/cupid/kleio_morgan/aftermath.rpy:59
translate russian cupid_kleio_morgan_aftermath_6c255fa3:
    "Клео стоит, прислонившись к стене у угла, и курит так яростно, что сигареты хватает на три затяжки."

# dlc_cupid/ch/cupid/kleio_morgan/aftermath.rpy:60
translate russian cupid_kleio_morgan_aftermath_83d8eab7:
    "В другом кулаке у неё туго свёрнутая книжка в мягкой обложке. С обложки скалится мультяшная русалка."

# dlc_cupid/ch/cupid/kleio_morgan/aftermath.rpy:62
translate russian cupid_kleio_morgan_aftermath_a7db6fee:
    kleio.say "Не надо."

# dlc_cupid/ch/cupid/kleio_morgan/aftermath.rpy:64
translate russian cupid_kleio_morgan_aftermath_336930b7:
    mike.say "Я ничего не сказал."

# dlc_cupid/ch/cupid/kleio_morgan/aftermath.rpy:66
translate russian cupid_kleio_morgan_aftermath_273e3902:
    kleio.say "Собирался. Я видела, как это загружается у тебя на лице, [lssb_kleio.hero_name()]."

# dlc_cupid/ch/cupid/kleio_morgan/aftermath.rpy:68
translate russian cupid_kleio_morgan_aftermath_6fd58884:
    "Она стряхивает пепел на тротуар и поднимает сценарий между нами."

# dlc_cupid/ch/cupid/kleio_morgan/aftermath.rpy:72
translate russian cupid_kleio_morgan_aftermath_ae43f131:
    kleio.say "После той репетиции Морган сводила меня поужинать. И заплатила сама."

# dlc_cupid/ch/cupid/kleio_morgan/aftermath.rpy:73
translate russian cupid_kleio_morgan_aftermath_063040b6:
    kleio.say "Морган никогда не платит. Однажды она заставила меня скинуться пополам за пакет чипсов."

# dlc_cupid/ch/cupid/kleio_morgan/aftermath.rpy:75
translate russian cupid_kleio_morgan_aftermath_82b7c65a:
    kleio.say "А потом, через пару дней, я оказываюсь у тебя."

# dlc_cupid/ch/cupid/kleio_morgan/aftermath.rpy:79
translate russian cupid_kleio_morgan_aftermath_2ee719c9:
    kleio.say "Морган хочет, чтобы я пришла на следующую репетицию. Сказала, что если не явлюсь, она меня из-под земли достанет."

# dlc_cupid/ch/cupid/kleio_morgan/aftermath.rpy:81
translate russian cupid_kleio_morgan_aftermath_addbd3f9:
    kleio.say "Она улыбалась, когда это говорила. Я уже забыла, что она так умеет."

# dlc_cupid/ch/cupid/kleio_morgan/aftermath.rpy:82
translate russian cupid_kleio_morgan_aftermath_82b7c65a_1:
    kleio.say "А потом, через пару дней, я оказываюсь у тебя."

# dlc_cupid/ch/cupid/kleio_morgan/aftermath.rpy:86
translate russian cupid_kleio_morgan_aftermath_682cc850:
    kleio.say "Скоро генеральная репетиция. Та самая, на которую ты меня записал добровольцем — прямо при ней."

# dlc_cupid/ch/cupid/kleio_morgan/aftermath.rpy:88
translate russian cupid_kleio_morgan_aftermath_a81ab887:
    kleio.say "Я выучила слова и всё такое. А потом оказалась у тебя."

# dlc_cupid/ch/cupid/kleio_morgan/aftermath.rpy:91
translate russian cupid_kleio_morgan_aftermath_2aea4db4:
    kleio.say "Тоже мне помощник."

# dlc_cupid/ch/cupid/kleio_morgan/aftermath.rpy:93
translate russian cupid_kleio_morgan_aftermath_a2f7a925:
    mike.say "Что-то не припомню, чтобы ты сильно сопротивлялась."

# dlc_cupid/ch/cupid/kleio_morgan/aftermath.rpy:95
translate russian cupid_kleio_morgan_aftermath_4fd688d3:
    kleio.say "Дело не в этом!"

# dlc_cupid/ch/cupid/kleio_morgan/aftermath.rpy:96
translate russian cupid_kleio_morgan_aftermath_6536c675:
    kleio.say "Ты должен был вручить меня Морган, перевязав бантиком. А не распаковывать меня первым."

# dlc_cupid/ch/cupid/kleio_morgan/aftermath.rpy:98
translate russian cupid_kleio_morgan_aftermath_3b58385f:
    "Я открываю рот, но ничего умного оттуда не выходит."

# dlc_cupid/ch/cupid/kleio_morgan/aftermath.rpy:100
translate russian cupid_kleio_morgan_aftermath_b2973bd0:
    "У неё в куртке вибрирует телефон. Она проверяет его и молча поворачивает экран ко мне."

# dlc_cupid/ch/cupid/kleio_morgan/aftermath.rpy:101
translate russian cupid_kleio_morgan_aftermath_c7eef30a:
    "Это от Морган. «Слова уже выучила, Ваше Высочество?» А следом — маленькая рыбка."

# dlc_cupid/ch/cupid/kleio_morgan/aftermath.rpy:103
translate russian cupid_kleio_morgan_aftermath_151e2569:
    kleio.say "Она думает, что я репетирую сцену с поцелуем перед зеркалом."

# dlc_cupid/ch/cupid/kleio_morgan/aftermath.rpy:105
translate russian cupid_kleio_morgan_aftermath_48453800:
    kleio.say "Я не могу стоять там и целовать её, [lssb_kleio.hero_name()]. Не тогда, когда ты сидишь в третьем ряду и знаешь то, что знаешь."

# dlc_cupid/ch/cupid/kleio_morgan/aftermath.rpy:107
translate russian cupid_kleio_morgan_aftermath_12fc1592:
    kleio.say "Секс — это секс. Но врать ей в лицо в бутафорской короне? Не могу."

# dlc_cupid/ch/cupid/kleio_morgan/aftermath.rpy:109
translate russian cupid_kleio_morgan_aftermath_7660951f:
    "Она ждёт, глядя на меня, а не в телефон."

# dlc_cupid/ch/cupid/kleio_morgan/aftermath.rpy:112
translate russian cupid_kleio_morgan_aftermath_30a45aba:
    mike.say "Тогда не выходи на сцену. Брось спектакль."

# dlc_cupid/ch/cupid/kleio_morgan/aftermath.rpy:113
translate russian cupid_kleio_morgan_aftermath_99334454:
    mike.say "Останься лучше со мной."

# dlc_cupid/ch/cupid/kleio_morgan/aftermath.rpy:115
translate russian cupid_kleio_morgan_aftermath_ee9e46f8:
    "Секунду она просто смотрит на меня, а сигарета догорает до самых пальцев."

# dlc_cupid/ch/cupid/kleio_morgan/aftermath.rpy:117
translate russian cupid_kleio_morgan_aftermath_e88f8aef:
    kleio.say "Останься. Как собачка."

# dlc_cupid/ch/cupid/kleio_morgan/aftermath.rpy:118
translate russian cupid_kleio_morgan_aftermath_6c7b7928:
    kleio.say "Ух ты. Очень изящно."

# dlc_cupid/ch/cupid/kleio_morgan/aftermath.rpy:120
translate russian cupid_kleio_morgan_aftermath_a9f3794d:
    "Но она уже печатает, тыча большим пальцем в экран."

# dlc_cupid/ch/cupid/kleio_morgan/aftermath.rpy:121
translate russian cupid_kleio_morgan_aftermath_b53327ca:
    "«Не могу. Найди себе настоящего принца. Прости»."

# dlc_cupid/ch/cupid/kleio_morgan/aftermath.rpy:124
translate russian cupid_kleio_morgan_aftermath_c40bb663:
    kleio.say "Вот. Теперь ты мне должен целую сказку."

# dlc_cupid/ch/cupid/kleio_morgan/aftermath.rpy:127
translate russian cupid_kleio_morgan_aftermath_9a443f9e:
    mike.say "Сыграй в спектакле, Клео. Ты же столько для этого работала."

# dlc_cupid/ch/cupid/kleio_morgan/aftermath.rpy:128
translate russian cupid_kleio_morgan_aftermath_a20b6834:
    mike.say "То, что случилось между нами, не обязано ничего менять."

# dlc_cupid/ch/cupid/kleio_morgan/aftermath.rpy:130
translate russian cupid_kleio_morgan_aftermath_9c6da5d5:
    "Что-то в её лице захлопывается, как гаражная дверь."

# dlc_cupid/ch/cupid/kleio_morgan/aftermath.rpy:132
translate russian cupid_kleio_morgan_aftermath_2376cb13:
    kleio.say "Ясно. Не обязано ничего менять."

# dlc_cupid/ch/cupid/kleio_morgan/aftermath.rpy:133
translate russian cupid_kleio_morgan_aftermath_1e4eda89:
    kleio.say "Приятно знать, на каком я у тебя месте, [lssb_kleio.hero_name()]."

# dlc_cupid/ch/cupid/kleio_morgan/aftermath.rpy:136
translate russian cupid_kleio_morgan_aftermath_b9c57f6f:
    "Она всё равно печатает — быстро, не глядя на меня."

# dlc_cupid/ch/cupid/kleio_morgan/aftermath.rpy:137
translate russian cupid_kleio_morgan_aftermath_b53327ca_1:
    "«Не могу. Найди себе настоящего принца. Прости»."

# dlc_cupid/ch/cupid/kleio_morgan/aftermath.rpy:139
translate russian cupid_kleio_morgan_aftermath_bcee2f2c:
    kleio.say "Я не стану этого делать, пока ты смотришь. Можешь относиться к этому сколько угодно спокойно."

# dlc_cupid/ch/cupid/kleio_morgan/aftermath.rpy:142
translate russian cupid_kleio_morgan_aftermath_6b52b99e:
    "Она засовывает сценарий под мышку и вдавливает окурок в асфальт ботинком."

# dlc_cupid/ch/cupid/kleio_morgan/aftermath.rpy:145
translate russian cupid_kleio_morgan_aftermath_d5b8f844:
    kleio.say "И пригони своё ржавое ведро ко мне в гараж. Я слышала, как оно едет, за три квартала."

# dlc_cupid/ch/cupid/kleio_morgan/aftermath.rpy:146
translate russian cupid_kleio_morgan_aftermath_12294930:
    kleio.say "Гляну его после работы. По-дружески."

# dlc_cupid/ch/cupid/kleio_morgan/aftermath.rpy:148
translate russian cupid_kleio_morgan_aftermath_f6346a18:
    "Слово «по-дружески» она произносит так, что на нём остаётся небольшая вмятина."

# dlc_cupid/ch/cupid/kleio_morgan/aftermath.rpy:151
translate russian cupid_kleio_morgan_aftermath_59a9f607:
    kleio.say "Не расслабляйся, [lssb_kleio.hero_name()]. Я ещё решаю, кто ты такой."

# dlc_cupid/ch/cupid/kleio_morgan/event.rpy:1296
translate russian cupid_kleio_morgan_ending_bbcd2c1a:
    "Раньше я боялся, что в этот момент ворвётся кто-нибудь из отвергнутых бывших Клео."

# dlc_cupid/ch/cupid/kleio_morgan/event.rpy:1297
translate russian cupid_kleio_morgan_ending_26ce848e:
    "Оказывается, врываться тут должен я."

# dlc_cupid/ch/cupid/kleio_morgan/event.rpy:1309
translate russian cupid_kleio_morgan_ending_3487d19f:
    "Я не говорю ни слова. Клео бросает на меня ровный, непроницаемый взгляд и снова поворачивается к Морган."

# dlc_cupid/ch/cupid/kleio_morgan/event.rpy:1310
translate russian cupid_kleio_morgan_ending_c55f9f3f:
    "Где-то у меня в кармане лежит крючок от занавеса. Я сжимаю его."

# dlc_cupid/ch/cupid/kleio_morgan/event.rpy:1312
translate russian cupid_kleio_morgan_ending_79df920c:
    "Я остаюсь на месте. Морган выглядывает на меня из-за плеча священника и розовеет."

# dlc_cupid/ch/cupid/kleio_morgan/event.rpy:1313
translate russian cupid_kleio_morgan_ending_4f6deef5:
    "К моему рукаву прилипла блёстка. Я снимаю её и кладу в карман."

# dlc_cupid/ch/cupid/kleio_morgan/event.rpy:1315
translate russian cupid_kleio_morgan_ending_ac7b9692:
    "Я прикусываю язык. Обе невесты одновременно бросают на меня взгляд, потом друг на друга, и Клео приходится закусить губу."

# dlc_cupid/ch/cupid/kleio_morgan/event.rpy:1316
translate russian cupid_kleio_morgan_ending_1fb868d9:
    "Священник решает не спрашивать."

# dlc_cupid/ch/cupid/kleio_morgan/event.rpy:1347
translate russian cupid_kleio_morgan_ending_50ef093e:
    "Потом Клео подхватывает Морган на руки — вместе с хвостом — и выносит её из зала под шквал аплодисментов."

# dlc_cupid/ch/cupid/kleio_morgan/event.rpy:1351
translate russian cupid_kleio_morgan_ending_dae5fc83:
    "Они не уезжают из города, как другие пары Купидона. Клео уже прислала мне адрес афтепати, а следом — подмигивающую рыбку."

# dlc_cupid/ch/cupid/kleio_morgan/event.rpy:1352
translate russian cupid_kleio_morgan_ending_759939d8:
    "Быть свахой утомительно. А чтобы быть их любовником, понадобится ещё больше выносливости."

# dlc_cupid/ch/cupid/kleio_morgan/wedding.rpy:36
translate russian cupid_kleio_morgan_wedding_before_7cd16f8a:
    "До начала двадцать минут, и гости рассаживаются по скамейкам вокруг сцены у аквариума."

# dlc_cupid/ch/cupid/kleio_morgan/wedding.rpy:37
translate russian cupid_kleio_morgan_wedding_before_3e277d21:
    "Морган в гримёрке за сценой, где три подруги из театра с боем впихивают её в хвост."

# dlc_cupid/ch/cupid/kleio_morgan/wedding.rpy:38
translate russian cupid_kleio_morgan_wedding_before_2c38991b:
    "А вот Клео нигде нет. Её телефон лежит экраном вниз на скамейке в первом ряду и жужжит от сообщений Морган."

# dlc_cupid/ch/cupid/kleio_morgan/wedding.rpy:39
translate russian cupid_kleio_morgan_wedding_before_cc5a66f3:
    "Сбоку от сцены есть дверь с табличкой «РЕКВИЗИТ», и из-под неё тянется тонкая струйка сигаретного дыма."

# dlc_cupid/ch/cupid/kleio_morgan/wedding.rpy:50
translate russian cupid_kleio_morgan_wedding_before_a8e46c52:
    "Чем бы каждая из них там ни занималась, это их день. Выйдут, когда будут готовы."

# dlc_cupid/ch/cupid/kleio_morgan/wedding.rpy:51
translate russian cupid_kleio_morgan_wedding_before_7ffa7b8b:
    "Вместо этого я иду составить компанию священнику."

# dlc_cupid/ch/cupid/kleio_morgan/wedding.rpy:60
translate russian cupid_kleio_morgan_wedding_fuck_kleio_efeba71b:
    "Комната реквизита оказывается складом аквариума: коробки до потолка вокруг пары служебных столов, а посередине свалены картонные кораллы и куча запасных сценических занавесов."

# dlc_cupid/ch/cupid/kleio_morgan/wedding.rpy:61
translate russian cupid_kleio_morgan_wedding_fuck_kleio_b4790e2e:
    "Клео сидит на занавесах в чёрном свадебном пиджаке и курит сигарету, которую ей здесь курить не стоило бы."

