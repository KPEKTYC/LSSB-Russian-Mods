# ch/harems_full/band/band_harem_poly.rpy:262
translate russian band_poly_anna_01_ef5f7206:
    "Мне знакомо это вздрагивание. Я уже видел его — каждый раз, когда кто-то рядом с ней повышает голос."

# ch/harems_full/band/band_harem_poly.rpy:263
translate russian band_poly_anna_01_2589dbba:
    "Что бы я сейчас ни сказал, врать ей я не буду."

# ch/harems_full/band/band_harem_poly.rpy:264
translate russian band_poly_anna_01_5083d1d6:
    mike.say "Это не перебор. Ты мне тоже нравишься, Анна. Очень."

# ch/harems_full/band/band_harem_poly.rpy:266
translate russian band_poly_anna_01_167492bd:
    "Её глаза становятся огромными."

# ch/harems_full/band/band_harem_poly.rpy:268
translate russian band_poly_anna_01_e96b569a:
    mike.say "Но сначала тебе кое-что нужно знать, пока никто из нас ничего не натворил."

# ch/harems_full/band/band_harem_poly.rpy:269
translate russian band_poly_anna_01_52d1751b:
    mike.say "У меня есть чувства и к Клео."

# ch/harems_full/band/band_harem_poly.rpy:271
translate russian band_poly_anna_01_6b72b5c6:
    mike.say "И я ей уже сказал. Говорю тебе, потому что не хочу секретов в группе."

# ch/harems_full/band/band_harem_poly.rpy:273
translate russian band_poly_anna_01_86046106:
    mike.say "Я ей ещё не сказал. Но скажу. Не хочу секретов в группе."

# ch/harems_full/band/band_harem_poly.rpy:275
translate russian band_poly_anna_01_56e05b59:
    mike.say "А ещё есть Эми. С ней я тоже встречаюсь."

# ch/harems_full/band/band_harem_poly.rpy:278
translate russian band_poly_anna_01_870c0c50:
    anna.say "ТА САМАЯ Эми? Наша Эми? Которая раньше была в Harpies?"

# ch/harems_full/band/band_harem_poly.rpy:280
translate russian band_poly_anna_01_b14f85f9:
    mike.say "Она рассказала мне про группу. Я знаю, что всё закончилось плохо."

# ch/harems_full/band/band_harem_poly.rpy:282
translate russian band_poly_anna_01_0d9e81bf:
    anna.say "Стоп. Эми с гитарой? Она раньше играла в Harpies."

# ch/harems_full/band/band_harem_poly.rpy:284
translate russian band_poly_anna_01_c946324d:
    anna.say "Всё закончилось очень-очень плохо."

# ch/harems_full/band/band_harem_poly.rpy:286
translate russian band_poly_anna_01_8f26a580:
    "Вот этого мне никто никогда не рассказывал."

# ch/harems_full/band/band_harem_poly.rpy:288
translate russian band_poly_anna_01_d66f129f:
    anna.say "Клео взорвётся. Прям по-настоящему взорвётся."

# ch/harems_full/band/band_harem_poly.rpy:290
translate russian band_poly_anna_01_0b80f655:
    mike.say "Знаю. Я всё равно ей скажу."

# ch/harems_full/band/band_harem_poly.rpy:292
translate russian band_poly_anna_01_d09b5913:
    "Анна смотрит на меня, потом через всю студию на Клео, которая ругается на запутавшийся провод."

# ch/harems_full/band/band_harem_poly.rpy:293
translate russian band_poly_anna_01_9a54af03:
    "Потом снова на меня — так долго, что я начинаю считать про себя."

# ch/harems_full/band/band_harem_poly.rpy:295
translate russian band_poly_anna_01_46a76970:
    anna.say "...Ладно, но ведь у меня так же?"

# ch/harems_full/band/band_harem_poly.rpy:297
translate russian band_poly_anna_01_4cf775c5:
    mike.say "Что?"

# ch/harems_full/band/band_harem_poly.rpy:299
translate russian band_poly_anna_01_4ffae396:
    anna.say "Ты ВИДЕЛ её руки на басу? И как она вот так поднимает бровь, когда злится?"

# ch/harems_full/band/band_harem_poly.rpy:301
translate russian band_poly_anna_01_2af02cd5:
    anna.say "Я думала, это замечаю только я!"

# ch/harems_full/band/band_harem_poly.rpy:303
translate russian band_poly_anna_01_51b76ed7:
    "Я открываю рот, но не могу выдавить ни звука."

# ch/harems_full/band/band_harem_poly.rpy:304
translate russian band_poly_anna_01_a6c7b722:
    "Я готовился к слезам или к тому, что она уйдёт. К такому я готов не был."

# ch/harems_full/band/band_harem_poly.rpy:306
translate russian band_poly_anna_01_f3563ba3:
    anna.say "И что мы... в смысле, что теперь?"

# ch/harems_full/band/band_harem_poly.rpy:310
translate russian band_poly_anna_01_27ff49ab:
    mike.say "Теперь мы будем честными. Друг с другом и с ней."

# ch/harems_full/band/band_harem_poly.rpy:311
translate russian band_poly_anna_01_f651621b:
    mike.say "И посмотрим, куда это приведёт. Никто не пострадает из-за того, что кто-то что-то скрыл."

# ch/harems_full/band/band_harem_poly.rpy:313
translate russian band_poly_anna_01_f6841ca2:
    "Анна бросается мне на шею и стискивает так сильно, что у меня хрустят рёбра."

# ch/harems_full/band/band_harem_poly.rpy:315
translate russian band_poly_anna_01_f9918dfe:
    anna.say "Никто никогда не был со мной честен до того, как поцеловать."

# ch/harems_full/band/band_harem_poly.rpy:317
translate russian band_poly_anna_01_d6a8cd9f:
    anna.say "Ты меня даже не поцеловал! Это лучший отказ, который не отказ, ЗА ВСЮ ИСТОРИЮ."

# ch/harems_full/band/band_harem_poly.rpy:319
translate russian band_poly_anna_01_8b5d07fc:
    "Клео в другом конце студии поднимает голову на шум и закатывает глаза."

# ch/harems_full/band/band_harem_poly.rpy:320
translate russian band_poly_anna_01_8a362f8f:
    "Анна машет ей. С энтузиазмом."

# ch/harems_full/band/band_harem_poly.rpy:324
translate russian band_poly_anna_01_890a4e9b:
    mike.say "Думаю, учитывая всё это, нам лучше остаться друзьями."

# ch/harems_full/band/band_harem_poly.rpy:326
translate russian band_poly_anna_01_b0eaef25:
    anna.say "Да. Да, это логично."

# ch/harems_full/band/band_harem_poly.rpy:328
translate russian band_poly_anna_01_fe14fb91:
    anna.say "Но спасибо, что был честен. Правда."

# ch/harems_full/band/band_harem_poly.rpy:330
translate russian band_poly_anna_01_c8bcc8f1:
    "Она говорит это искренне. И от этого почему-то только хуже."

# ch/harems_full/band/band_harem_poly.rpy:340
translate russian band_poly_kleio_01_0515b12a:
    "После репетиции все расходятся. Кроме Клео."

# ch/harems_full/band/band_harem_poly.rpy:342
translate russian band_poly_kleio_01_c91bd34e:
    "Она лежит на спине на подкатной тележке под фургоном группы в погрузочной зоне, с гаечным ключом в одной руке и фонариком в зубах."

# ch/harems_full/band/band_harem_poly.rpy:343
translate russian band_poly_kleio_01_2b3aeffe:
    kleio.say "Если пришёл поглазеть, [lssb_kleio.hero_name()], хватай ключ. Если поговорить — говори быстро."

# ch/harems_full/band/band_harem_poly.rpy:344
translate russian band_poly_kleio_01_77b5463a:
    mike.say "Я пришёл поговорить."

# ch/harems_full/band/band_harem_poly.rpy:345
translate russian band_poly_kleio_01_b0e4f576:
    kleio.say "Отлично. Обожаю."

# ch/harems_full/band/band_harem_poly.rpy:346
translate russian band_poly_kleio_01_84a31d64:
    "Я сажусь на перевёрнутый ящик. Говорить это паре ботинок проще, чем ей в лицо."

# ch/harems_full/band/band_harem_poly.rpy:348
translate russian band_poly_kleio_01_c634a0b7:
    mike.say "Ты знаешь, что я к тебе чувствую, Клео. Но тебе нужно услышать ещё кое-что."

# ch/harems_full/band/band_harem_poly.rpy:349
translate russian band_poly_kleio_01_564dd9e8:
    "Лязг прекращается."

# ch/harems_full/band/band_harem_poly.rpy:350
translate russian band_poly_kleio_01_6dab5d7b:
    mike.say "У меня есть чувства и к Анне."

# ch/harems_full/band/band_harem_poly.rpy:352
translate russian band_poly_kleio_01_8b0793e3:
    mike.say "У меня есть к тебе чувства, Клео."

# ch/harems_full/band/band_harem_poly.rpy:353
translate russian band_poly_kleio_01_564dd9e8_1:
    "Лязг прекращается."

# ch/harems_full/band/band_harem_poly.rpy:354
translate russian band_poly_kleio_01_7d03c224:
    mike.say "И пока ты ничего не сказала... у меня есть чувства и к Анне."

# ch/harems_full/band/band_harem_poly.rpy:356
translate russian band_poly_kleio_01_c9181a76:
    mike.say "Она знает, я сначала сказал ей. И она, вообще-то, совсем не против."

# ch/harems_full/band/band_harem_poly.rpy:358
translate russian band_poly_kleio_01_4849e3cc:
    mike.say "Ей я тоже скажу. Я не собираюсь делать это ни у кого за спиной."

# ch/harems_full/band/band_harem_poly.rpy:360
translate russian band_poly_kleio_01_dc2fe2d2:
    "Тележка выкатывается наружу."

# ch/harems_full/band/band_harem_poly.rpy:361
translate russian band_poly_kleio_01_0a260c6b:
    "Клео смотрит на меня снизу вверх, вверх тормашками, всё ещё с фонариком во рту."

# ch/harems_full/band/band_harem_poly.rpy:362
translate russian band_poly_kleio_01_16411ad4:
    "Она вынимает его."

# ch/harems_full/band/band_harem_poly.rpy:364
translate russian band_poly_kleio_01_220f0f0a:
    kleio.say "Ты ей СКАЗАЛ?"

# ch/harems_full/band/band_harem_poly.rpy:366
translate russian band_poly_kleio_01_63af1ec7:
    mike.say "Или скажу. Ага."

# ch/harems_full/band/band_harem_poly.rpy:368
translate russian band_poly_kleio_01_537140f2:
    kleio.say "Кто так делает?"

# ch/harems_full/band/band_harem_poly.rpy:369
translate russian band_poly_kleio_01_c1e1da7c:
    kleio.say "Серьёзно. С каждым парнем, с которым я была, про «другую девушку» я узнавала из сообщения, которое он забыл удалить."

# ch/harems_full/band/band_harem_poly.rpy:371
translate russian band_poly_kleio_01_92df321a:
    kleio.say "Любовь — это развод, [lssb_kleio.hero_name()]. Сказка, которую люди рассказывают, чтобы измены казались драматичнее."

# ch/harems_full/band/band_harem_poly.rpy:373
translate russian band_poly_kleio_01_e52c05c9:
    mike.say "Значит, я делаю это неправильно. Я говорю тебе до того, как что-то случилось."

# ch/harems_full/band/band_harem_poly.rpy:375
translate russian band_poly_kleio_01_805a2955:
    "Впервые у Клео не находится, что ответить. Она просто смотрит на меня."

# ch/harems_full/band/band_harem_poly.rpy:377
translate russian band_poly_kleio_01_b2f94af2:
    "А потом закатывается обратно под фургон."

# ch/harems_full/band/band_harem_poly.rpy:378
translate russian band_poly_kleio_01_1ded0d09:
    kleio.say "..."

# ch/harems_full/band/band_harem_poly.rpy:379
translate russian band_poly_kleio_01_0301a5ad:
    kleio.say "Анна, значит."

# ch/harems_full/band/band_harem_poly.rpy:380
translate russian band_poly_kleio_01_612dec08:
    mike.say "Анна."

# ch/harems_full/band/band_harem_poly.rpy:381
translate russian band_poly_kleio_01_a3122bb9:
    kleio.say "Она ходячее стихийное бедствие. Она посыпает палочки блёстками."

# ch/harems_full/band/band_harem_poly.rpy:382
translate russian band_poly_kleio_01_3ddd991b:
    "Пауза."

# ch/harems_full/band/band_harem_poly.rpy:383
translate russian band_poly_kleio_01_f928084a:
    kleio.say "Хотя ей идёт."

# ch/harems_full/band/band_harem_poly.rpy:385
translate russian band_poly_kleio_01_002786ab:
    mike.say "И ещё кое-что. Я встречаюсь и с Эми."

# ch/harems_full/band/band_harem_poly.rpy:387
translate russian band_poly_kleio_01_b5dae12f:
    "Тележка вылетает обратно так резко, что задевает ящик."

# ch/harems_full/band/band_harem_poly.rpy:389
translate russian band_poly_kleio_01_3ed76b28:
    kleio.say "С ЭМИ?"

# ch/harems_full/band/band_harem_poly.rpy:390
translate russian band_poly_kleio_01_f34c529d:
    kleio.say "С той Эми, которая всадила этой группе нож в спину?"

# ch/harems_full/band/band_harem_poly.rpy:392
translate russian band_poly_kleio_01_8ed7574d:
    mike.say "Ага. С той самой."

# ch/harems_full/band/band_harem_poly.rpy:393
translate russian band_poly_kleio_01_53e231f5:
    "Ключ в её руке долго не двигается."

# ch/harems_full/band/band_harem_poly.rpy:395
translate russian band_poly_kleio_01_ab289446:
    kleio.say "...Ну, ты хотя бы сказал. Это больше, чем когда-либо делала она."

# ch/harems_full/band/band_harem_poly.rpy:397
translate russian band_poly_kleio_01_19fb21b1:
    kleio.say "Только не жди, что я буду с ней милой."

# ch/harems_full/band/band_harem_poly.rpy:401
translate russian band_poly_kleio_01_ff8d2c17:
    mike.say "Можешь не отвечать. Я просто не хотел тебе врать."

# ch/harems_full/band/band_harem_poly.rpy:402
translate russian band_poly_kleio_01_a498c058:
    kleio.say "Ну да. Мне ещё никто никогда не не врал."

# ch/harems_full/band/band_harem_poly.rpy:403
translate russian band_poly_kleio_01_2dd553fd:
    kleio.say "Дай мне минуту понять, ненавижу я это или нет."

# ch/harems_full/band/band_harem_poly.rpy:404
translate russian band_poly_kleio_01_658ce3ca:
    "Я встаю, чтобы уйти."

# ch/harems_full/band/band_harem_poly.rpy:405
translate russian band_poly_kleio_01_0aa4ebf0:
    "Уже у самой двери я слышу, как она бормочет днищу фургона:"

# ch/harems_full/band/band_harem_poly.rpy:406
translate russian band_poly_kleio_01_73dd03c2:
    kleio.say "Не ненавижу."

# ch/harems_full/band/band_harem_poly.rpy:410
translate russian band_poly_kleio_01_98afe3e5:
    mike.say "Забудь, что я сказал. Группа важнее."

# ch/harems_full/band/band_harem_poly.rpy:411
translate russian band_poly_kleio_01_177f2b12:
    kleio.say "Уже забыла, сердцеед."

# ch/harems_full/band/band_harem_poly.rpy:412
translate russian band_poly_kleio_01_6859faf3:
    "Лязг возобновляется, громче прежнего."

# ch/harems_full/band/band_harem_poly.rpy:421
translate russian band_poly_setlist_04d85f8d:
    "После репетиции Анна и Клео ждут меня в баре через дорогу, за угловым столиком."

# ch/harems_full/band/band_harem_poly.rpy:425
translate russian band_poly_setlist_da208edd:
    "У Анны в руках заламинированный лист бумаги."

# ch/harems_full/band/band_harem_poly.rpy:426
translate russian band_poly_setlist_5bc17182:
    "У Клео в руках пиво, и вид у неё такой, будто она предпочла бы лежать под фургоном."

# ch/harems_full/band/band_harem_poly.rpy:428
translate russian band_poly_setlist_45848124:
    anna.say "Итак! Добро пожаловать на первое собрание..."

# ch/harems_full/band/band_harem_poly.rpy:431
translate russian band_poly_setlist_a7db6fee:
    kleio.say "Не надо."

# ch/harems_full/band/band_harem_poly.rpy:434
translate russian band_poly_setlist_5f41a62e:
    anna.say "...ТРОЙНИЧКА..."

# ch/harems_full/band/band_harem_poly.rpy:437
translate russian band_poly_setlist_8529b52b:
    kleio.say "Я уйду. Я правда уйду."

# ch/harems_full/band/band_harem_poly.rpy:440
translate russian band_poly_setlist_67c0fc60:
    anna.say "Тройничок, тройничок, тройничок."

# ch/harems_full/band/band_harem_poly.rpy:443
translate russian band_poly_setlist_60d776fd:
    "Клео роняет голову лбом на стол."

# ch/harems_full/band/band_harem_poly.rpy:447
translate russian band_poly_setlist_7bc0333a:
    "Я сажусь между ними. Сердце у меня выделывает что-то сложное."

# ch/harems_full/band/band_harem_poly.rpy:448
translate russian band_poly_setlist_841edf6b:
    mike.say "Значит, мы правда это делаем."

# ch/harems_full/band/band_harem_poly.rpy:450
translate russian band_poly_setlist_95621e2d:
    kleio.say "Анна составила список. Ну конечно, Анна составила список."

# ch/harems_full/band/band_harem_poly.rpy:453
translate russian band_poly_setlist_a15c5d29:
    anna.say "Это сет-лист! Для нас!"

# ch/harems_full/band/band_harem_poly.rpy:455
translate russian band_poly_setlist_7dea2f13:
    "Она выкладывает заламинированный лист на середину стола."

# ch/harems_full/band/band_harem_poly.rpy:456
translate russian band_poly_setlist_2e756f32:
    "Он написан гелевыми ручками трёх цветов, с маленькими звёздочками."

# ch/harems_full/band/band_harem_poly.rpy:458
translate russian band_poly_setlist_a47d7ef6:
    anna.say "Правило первое. Никаких секретов. Никогда. Если что-то странно, мы так и говорим, что это странно."

# ch/harems_full/band/band_harem_poly.rpy:459
translate russian band_poly_setlist_dbe8c002:
    anna.say "Правило второе. Никаких рейтингов. Нет ни главной, ни запасной."

# ch/harems_full/band/band_harem_poly.rpy:460
translate russian band_poly_setlist_e92a6958:
    anna.say "Правило третье. Группа на первом месте. Если всё пойдёт не так, мы не дадим этому развалить Harpies."

# ch/harems_full/band/band_harem_poly.rpy:463
translate russian band_poly_setlist_8c71b356:
    kleio.say "И правило четвёртое."

# ch/harems_full/band/band_harem_poly.rpy:466
translate russian band_poly_setlist_57dd4055:
    anna.say "Четвёртого правила нет."

# ch/harems_full/band/band_harem_poly.rpy:468
translate russian band_poly_setlist_b9cbda71:
    "Клео достаёт из куртки ручку и пишет его сама, печатными буквами."

# ch/harems_full/band/band_harem_poly.rpy:469
translate russian band_poly_setlist_e36f0d1c:
    "МЫ САМИ СКАЖЕМ САШЕ. НЕ ДАДИМ ЕЙ УЗНАТЬ САМОЙ."

# ch/harems_full/band/band_harem_poly.rpy:472
translate russian band_poly_setlist_1ab7f222:
    "Ниже, куда более мелкими буквами, Анна дописывает пятое."

# ch/harems_full/band/band_harem_poly.rpy:473
translate russian band_poly_setlist_e5f7d75e:
    "ЭМИ: ОТДЕЛЬНЫЙ РАЗГОВОР. (КЛЕО, ПОЖАЛУЙСТА, НИКОГО НЕ УБИВАЙ.)"

# ch/harems_full/band/band_harem_poly.rpy:475
translate russian band_poly_setlist_45de8d05:
    kleio.say "Ничего не обещаю."

# ch/harems_full/band/band_harem_poly.rpy:477
translate russian band_poly_setlist_4a1a63ab:
    mike.say "А я расскажу Эми про вас двоих. То же правило. Никаких секретов."

# ch/harems_full/band/band_harem_poly.rpy:480
translate russian band_poly_setlist_d4885e34:
    "Секунду все молчат."

# ch/harems_full/band/band_harem_poly.rpy:481
translate russian band_poly_setlist_5d0f7c6c:
    mike.say "Хорошее правило."

# ch/harems_full/band/band_harem_poly.rpy:483
translate russian band_poly_setlist_0847a074:
    kleio.say "Знаешь, я ведь не умею вот это всё."

# ch/harems_full/band/band_harem_poly.rpy:485
translate russian band_poly_setlist_ac6e9a71:
    kleio.say "Ничего из этого. Двое — это катастрофа, которая ждёт своего часа. Трое — это катастрофа с барабанщицей."

# ch/harems_full/band/band_harem_poly.rpy:488
translate russian band_poly_setlist_4f52af11:
    anna.say "Никто не умеет. Поэтому мы и говорим об этом."

# ch/harems_full/band/band_harem_poly.rpy:490
translate russian band_poly_setlist_f48ef77a:
    anna.say "В этом буквально весь секрет."

# ch/harems_full/band/band_harem_poly.rpy:493
translate russian band_poly_setlist_9df4b87e:
    "Клео смотрит на неё, потом наклоняется и целует Анну."

# ch/harems_full/band/band_harem_poly.rpy:495
translate russian band_poly_setlist_533541cb:
    "Быстро, почти зло, и Анна издаёт звук, как закипающий чайник."

# ch/harems_full/band/band_harem_poly.rpy:498
translate russian band_poly_setlist_198ac443:
    kleio.say "Вот. Теперь это странно. Правило первое."

# ch/harems_full/band/band_harem_poly.rpy:500
translate russian band_poly_setlist_fce38885:
    "И тут они обе поворачиваются ко мне."

# ch/harems_full/band/band_harem_poly.rpy:508
translate russian band_poly_setlist_a75f3d03:
    "Я наклоняюсь и целую Анну — нежно и медленно, как она того заслуживает за то, что первой набралась смелости."

# ch/harems_full/band/band_harem_poly.rpy:512
translate russian band_poly_setlist_0c860144:
    anna.say "Ох. Ого. Ладно. Мне надо присесть."

# ch/harems_full/band/band_harem_poly.rpy:514
translate russian band_poly_setlist_bcb4b518:
    mike.say "Ты и так сидишь."

# ch/harems_full/band/band_harem_poly.rpy:516
translate russian band_poly_setlist_560459cc:
    anna.say "Мне надо присесть ЕЩЁ СИЛЬНЕЕ."

# ch/harems_full/band/band_harem_poly.rpy:519
translate russian band_poly_setlist_28b51bb4:
    "Клео смеётся — по-настоящему — и не дожидается своей очереди. Она притягивает меня к себе за воротник."

# ch/harems_full/band/band_harem_poly.rpy:532
translate russian band_poly_setlist_0f19a69d:
    "Я наклоняюсь и целую Клео, пока она не успела снова надеть броню."

# ch/harems_full/band/band_harem_poly.rpy:533
translate russian band_poly_setlist_96fad96a:
    "На вкус она как пиво и машинное масло, и это она не хочет останавливаться."

# ch/harems_full/band/band_harem_poly.rpy:538
translate russian band_poly_setlist_0b32d85a:
    anna.say "Правило второе! Никаких рейтингов! Иди сюда!"

# ch/harems_full/band/band_harem_poly.rpy:543
translate russian band_poly_setlist_969739fe:
    "Анна хватает моё лицо обеими руками и тут же меня целует."

# ch/harems_full/band/band_harem_poly.rpy:551
translate russian band_poly_setlist_07580051:
    "Мы сидим за тем столиком ещё долго после того, как допили."

# ch/harems_full/band/band_harem_poly.rpy:552
translate russian band_poly_setlist_40dedc2c:
    "В ту ночь никто ни с кем не спит, и это, пожалуй, самое странное."

# ch/harems_full/band/band_harem_poly.rpy:553
translate russian band_poly_setlist_185c704e:
    "Анна всю дорогу домой что-то напевает, а Клео ругается на то, какая она счастливая."

# ch/harems_full/band/band_harem_poly.rpy:556
translate russian band_poly_setlist_1e837f77:
    "Я прихожу домой, и завтра мне нечего будет скрывать. К такому я мог бы привыкнуть."

# ch/harems_full/band/band_harem_poly.rpy:567
translate russian band_poly_sasha_01_3345aea7:
    "Правило четвёртое висит на заламинированном сет-листе Анны уже довольно давно."

# ch/harems_full/band/band_harem_poly.rpy:568
translate russian band_poly_sasha_01_e36f0d1c:
    "МЫ САМИ СКАЖЕМ САШЕ. НЕ ДАДИМ ЕЙ УЗНАТЬ САМОЙ."

# ch/harems_full/band/band_harem_poly.rpy:569
translate russian band_poly_sasha_01_c91f4693:
    "После «Битвы групп» отговорок больше не осталось."

# ch/harems_full/band/band_harem_poly.rpy:574
translate russian band_poly_sasha_01_404a44ec:
    "Так что, когда репетиция заканчивается, мы втроём не собираем вещи."

# ch/harems_full/band/band_harem_poly.rpy:575
translate russian band_poly_sasha_01_a59e53ff:
    "Мы выстраиваемся в ряд перед Сашей, словно ждём приговора."

# ch/harems_full/band/band_harem_poly.rpy:577
translate russian band_poly_sasha_01_ebe3469f:
    sasha.say "Так, это жутко. Чего вы все на меня так смотрите?"

# ch/harems_full/band/band_harem_poly.rpy:579
translate russian band_poly_sasha_01_f2b98ac3:
    sasha.say "Если это вмешательство, то я пью ровно столько, сколько положено басистке."

# ch/harems_full/band/band_harem_poly.rpy:582
translate russian band_poly_sasha_01_ebde50aa:
    anna.say "Это не вмешательство."

# ch/harems_full/band/band_harem_poly.rpy:585
translate russian band_poly_sasha_01_81b7cf18:
    kleio.say "Это вроде как вмешательство."

# ch/harems_full/band/band_harem_poly.rpy:588
translate russian band_poly_sasha_01_81616bb4:
    sasha.say "Боже мой. Вы меня выгоняете."

# ch/harems_full/band/band_harem_poly.rpy:590
translate russian band_poly_sasha_01_56872d6b:
    sasha.say "Я ТАК и знала. Вы уже несколько дней какие-то странные. Репетируете без меня и собираете новую группу. Это ска-группа? Скажите, что не ска."

# ch/harems_full/band/band_harem_poly.rpy:592
translate russian band_poly_sasha_01_aea713e3:
    mike.say "Саша. Никто тебя не выгоняет."

# ch/harems_full/band/band_harem_poly.rpy:593
translate russian band_poly_sasha_01_6ca79245:
    mike.say "Мы втроём вместе. Анна, Клео и я."

# ch/harems_full/band/band_harem_poly.rpy:595
translate russian band_poly_sasha_01_313086d6:
    "Саша моргает."

# ch/harems_full/band/band_harem_poly.rpy:596
translate russian band_poly_sasha_01_8d307a74:
    mike.say "Мы хотели, чтобы ты услышала это от нас. А не узнала как-нибудь иначе."

# ch/harems_full/band/band_harem_poly.rpy:598
translate russian band_poly_sasha_01_a5f0ce3f:
    sasha.say "Вы втроём."

# ch/harems_full/band/band_harem_poly.rpy:600
translate russian band_poly_sasha_01_7a71a96f:
    sasha.say "Вместе. В смысле, ПРЯМ вместе."

# ch/harems_full/band/band_harem_poly.rpy:603
translate russian band_poly_sasha_01_d94c57ec:
    anna.say "У нас есть заламинированный сет-лист!"

# ch/harems_full/band/band_harem_poly.rpy:606
translate russian band_poly_sasha_01_b8fae44c:
    kleio.say "Не показывай ей сет-лист."

# ch/harems_full/band/band_harem_poly.rpy:609
translate russian band_poly_sasha_01_b784d04e:
    "Саша тяжело опускается на свой усилитель."

# ch/harems_full/band/band_harem_poly.rpy:611
translate russian band_poly_sasha_01_8e41dd4d:
    "Она открывает рот, чтобы пошутить, но тут же закрывает его."

# ch/harems_full/band/band_harem_poly.rpy:613
translate russian band_poly_sasha_01_033ae5b5:
    sasha.say "Значит, я четвёртое колесо. Супер. Обожаю."

# ch/harems_full/band/band_harem_poly.rpy:617
translate russian band_poly_sasha_01_13e8a29e:
    "Анна и Клео смотрят на меня. Мы договорились, что эту часть скажу я."

# ch/harems_full/band/band_harem_poly.rpy:618
translate russian band_poly_sasha_01_d1e42035:
    mike.say "Ты не четвёртое колесо, Саша."

# ch/harems_full/band/band_harem_poly.rpy:621
translate russian band_poly_sasha_01_2fe799ea:
    mike.say "Есть ещё кое-что, что мы не держим в секрете. Они знают про нас, Саша. Про то, что у нас дома. Обо всём."

# ch/harems_full/band/band_harem_poly.rpy:623
translate russian band_poly_sasha_01_76978a1f:
    mike.say "Есть ещё кое-что, что мы не держим в секрете. Они знают про нас с тобой, Саша. Обо всём."

# ch/harems_full/band/band_harem_poly.rpy:624
translate russian band_poly_sasha_01_bca3395e:
    mike.say "И они всё равно хотят, чтобы ты была с нами."

# ch/harems_full/band/band_harem_poly.rpy:626
translate russian band_poly_sasha_01_afc6d920:
    mike.say "Есть ещё кое-что, что мы не держим в секрете. У меня есть чувства и к тебе."

# ch/harems_full/band/band_harem_poly.rpy:627
translate russian band_poly_sasha_01_bd6cdb00:
    mike.say "И эти двое уже об этом знают."

# ch/harems_full/band/band_harem_poly.rpy:629
translate russian band_poly_sasha_01_7f9b7919:
    "Саша резко вскидывает голову."

# ch/harems_full/band/band_harem_poly.rpy:632
translate russian band_poly_sasha_01_702ce13b:
    kleio.say "Мы это обсудили. Долго. Анна нарисовала блок-схему."

# ch/harems_full/band/band_harem_poly.rpy:635
translate russian band_poly_sasha_01_0fba93e6:
    anna.say "ХОРОШУЮ блок-схему."

# ch/harems_full/band/band_harem_poly.rpy:638
translate russian band_poly_sasha_01_72b7e248:
    kleio.say "Короче, дверь открыта. Если ты сама этого хочешь."

# ch/harems_full/band/band_harem_poly.rpy:642
translate russian band_poly_sasha_01_503e2b13:
    sasha.say "Стоп. Прежде чем я вообще о чём-то подумаю. Эми в этом участвует?"

# ch/harems_full/band/band_harem_poly.rpy:644
translate russian band_poly_sasha_01_5eb50a51:
    mike.say "С Эми я тоже встречаюсь. Анна и Клео знают."

# ch/harems_full/band/band_harem_poly.rpy:646
translate russian band_poly_sasha_01_324b11b1:
    kleio.say "Отдельный разговор. Есть правило."

# ch/harems_full/band/band_harem_poly.rpy:649
translate russian band_poly_sasha_01_060eb52f:
    sasha.say "Ну конечно, есть правило."

# ch/harems_full/band/band_harem_poly.rpy:651
translate russian band_poly_sasha_01_54ad823a:
    "Саша переводит взгляд с одного из нас на другого и обратно."

# ch/harems_full/band/band_harem_poly.rpy:652
translate russian band_poly_sasha_01_0c82497a:
    "Я вижу, как она ищет, чем бы съязвить, — и не находит."

# ch/harems_full/band/band_harem_poly.rpy:654
translate russian band_poly_sasha_01_6356570a:
    sasha.say "Мне... надо подумать."

# ch/harems_full/band/band_harem_poly.rpy:658
translate russian band_poly_sasha_01_ac1de259:
    mike.say "Думай сколько нужно. В группе в любом случае ничего не изменится."

# ch/harems_full/band/band_harem_poly.rpy:660
translate russian band_poly_sasha_01_6b524413:
    sasha.say "Какие же вы странные."

# ch/harems_full/band/band_harem_poly.rpy:662
translate russian band_poly_sasha_01_a33bc3cb:
    sasha.say "...Спасибо, что сказали. Серьёзно."

# ch/harems_full/band/band_harem_poly.rpy:665
translate russian band_poly_sasha_01_ce0261dd:
    "Она хватает бас и уходит, не смотав кабели."

# ch/harems_full/band/band_harem_poly.rpy:668
translate russian band_poly_sasha_01_ee0f150b:
    "Саша никогда не уходит, не смотав кабели."

# ch/harems_full/band/band_harem_poly.rpy:672
translate russian band_poly_sasha_01_b98f4550:
    mike.say "Забудь последнее. Главное — группа."

# ch/harems_full/band/band_harem_poly.rpy:674
translate russian band_poly_sasha_01_085fff05:
    sasha.say "Ага. Главное — группа."

# ch/harems_full/band/band_harem_poly.rpy:678
translate russian band_poly_sasha_01_224ad84b:
    "Она медленно сматывает кабели, один за другим. Больше никто ничего не говорит."

# ch/harems_full/band/band_harem_poly.rpy:692
translate russian band_poly_sasha_02_aab02144:
    "В дверь моей спальни стучат. Саша не дожидается ответа."

# ch/harems_full/band/band_harem_poly.rpy:695
translate russian band_poly_sasha_02_eb086a52:
    "В руках у неё блокнот, и вид у неё такой, будто она не спала."

# ch/harems_full/band/band_harem_poly.rpy:697
translate russian band_poly_sasha_02_50713253:
    sasha.say "Так. Не говори ничего. Если заговоришь, я струшу."

# ch/harems_full/band/band_harem_poly.rpy:699
translate russian band_poly_sasha_02_d098ee9b:
    "Она садится на край моей кровати и открывает блокнот."

# ch/harems_full/band/band_harem_poly.rpy:700
translate russian band_poly_sasha_02_8804dbd8:
    "Страница вся исписана зачёркнутыми строчками."

# ch/harems_full/band/band_harem_poly.rpy:702
translate russian band_poly_sasha_02_90a04dd6:
    sasha.say "Я написала песню. Про нас четверых."

# ch/harems_full/band/band_harem_poly.rpy:704
translate russian band_poly_sasha_02_2143c164:
    sasha.say "Она ужасная. Хуже ничего в жизни не писала. Там есть рифма к слову «Клео», и я ею не горжусь."

# ch/harems_full/band/band_harem_poly.rpy:706
translate russian band_poly_sasha_02_d28f27f3:
    mike.say "Саша..."

# ch/harems_full/band/band_harem_poly.rpy:708
translate russian band_poly_sasha_02_7373b12c:
    sasha.say "Я же сказала, не говори!"

# ch/harems_full/band/band_harem_poly.rpy:710
translate russian band_poly_sasha_02_ee544bef:
    "Она опускает взгляд на блокнот."

# ch/harems_full/band/band_harem_poly.rpy:712
translate russian band_poly_sasha_02_1145f9e0:
    sasha.say "Я несколько дней пыталась найти причину сказать «нет»."

# ch/harems_full/band/band_harem_poly.rpy:713
translate russian band_poly_sasha_02_5dfd21fe:
    sasha.say "Всё ждала подвоха. Момента, где кто-то врёт или над кем-то смеются."

# ch/harems_full/band/band_harem_poly.rpy:715
translate russian band_poly_sasha_02_07d73810:
    sasha.say "Парни не говорят правду первыми. По крайней мере те, с кем я была."

# ch/harems_full/band/band_harem_poly.rpy:717
translate russian band_poly_sasha_02_0f946ff9:
    sasha.say "И самое дурацкое — я большую часть времени даже не настолько себе нравлюсь, чтобы думать, будто впишусь во что-то такое."

# ch/harems_full/band/band_harem_poly.rpy:719
translate russian band_poly_sasha_02_bd100656:
    "Это самое честное, что я от неё когда-либо слышал, и говорит она это своим коленкам."

# ch/harems_full/band/band_harem_poly.rpy:720
translate russian band_poly_sasha_02_0b65267f:
    mike.say "Ты вписываешься, Саша. Всегда вписывалась. Это из-за тебя вообще есть группа."

# ch/harems_full/band/band_harem_poly.rpy:722
translate russian band_poly_sasha_02_7f096b1f:
    sasha.say "Да-да. Прибереги для буклета к альбому."

# ch/harems_full/band/band_harem_poly.rpy:724
translate russian band_poly_sasha_02_2269b36e:
    "Она закрывает блокнот."

# ch/harems_full/band/band_harem_poly.rpy:726
translate russian band_poly_sasha_02_10e00d56:
    sasha.say "Короче. Я в деле."

# ch/harems_full/band/band_harem_poly.rpy:727
translate russian band_poly_sasha_02_f0fb8b58:
    sasha.say "Но я хочу услышать это и от них. Не только от тебя. Я не стану в это ввязываться, если они просто из вежливости."

# ch/harems_full/band/band_harem_poly.rpy:729
translate russian band_poly_sasha_02_5625f518:
    mike.say "Я спрошу их, когда они в следующий раз зайдут."

# ch/harems_full/band/band_harem_poly.rpy:731
translate russian band_poly_sasha_02_6be85234:
    sasha.say "Тогда в гостиной. А я буду у себя в комнате делать вид, что не подслушиваю."

# ch/harems_full/band/band_harem_poly.rpy:733
translate russian band_poly_sasha_02_7c7fe7da:
    sasha.say "И если Анна притащит блок-схему, я съезжаю."

# ch/harems_full/band/band_harem_poly.rpy:737
translate russian band_poly_sasha_02_9cd743c3:
    "Она оставляет блокнот у меня на кровати."

# ch/harems_full/band/band_harem_poly.rpy:738
translate russian band_poly_sasha_02_08f31a50:
    "Песня и правда ужасная."

