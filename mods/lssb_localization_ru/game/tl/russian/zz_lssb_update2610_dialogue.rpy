# dlc_cupid/ch/cupid/palla_shawn/aftermath.rpy:122
translate russian cupid_palla_shawn_aftermath_61f3c53a:
    "Потом берёт латте и делает долгий глоток, чтобы никто толком не разглядел её лицо."

# dlc_cupid/ch/cupid/palla_shawn/aftermath.rpy:125
translate russian cupid_palla_shawn_aftermath_51bea337:
