# dlc_cupid/ch/cupid/angela_bruce/aftermath.rpy:50
translate russian cupid_angela_bruce_aftermath_da7c867b:
    "Я доедаю половину тарелки хлопьев, когда входная дверь открывается без всякого стука."

# dlc_cupid/ch/cupid/angela_bruce/aftermath.rpy:51
translate russian cupid_angela_bruce_aftermath_075d5983:
    "Только один человек на свете входит в этот дом так, будто он записан на неё."

# dlc_cupid/ch/cupid/angela_bruce/aftermath.rpy:54
translate russian cupid_angela_bruce_aftermath_941758a2:
    angela.say "Сюрприз, милый!"

# dlc_cupid/ch/cupid/angela_bruce/aftermath.rpy:55
translate russian cupid_angela_bruce_aftermath_18ab68cb:
    angela.say "Я была неподалёку и решила заглянуть к своему мальчику."

# dlc_cupid/ch/cupid/angela_bruce/aftermath.rpy:57
translate russian cupid_angela_bruce_aftermath_b2443a3a:
    mike.say "Привет, мам..."

# dlc_cupid/ch/cupid/angela_bruce/aftermath.rpy:58
translate russian cupid_angela_bruce_aftermath_f35f4009:
    mike.say "Ты же знаешь, что можно сначала позвонить?"

# dlc_cupid/ch/cupid/angela_bruce/aftermath.rpy:60
translate russian cupid_angela_bruce_aftermath_67a64d89:
    angela.say "С каких это пор матери нужно записываться на приём?"

# dlc_cupid/ch/cupid/angela_bruce/aftermath.rpy:62
translate russian cupid_angela_bruce_aftermath_77dde786:
    "Она проносится через комнату и обнимает меня так крепко, что ложка звякает о тарелку."

# dlc_cupid/ch/cupid/angela_bruce/aftermath.rpy:63
translate russian cupid_angela_bruce_aftermath_2c2cf67b:
    "Секунду спустя до меня доходит запах её духов — чего-то дорогого, наверняка выбранного папой."

# dlc_cupid/ch/cupid/angela_bruce/aftermath.rpy:64
translate russian cupid_angela_bruce_aftermath_9c39ae06:
    "Не знаю, откуда мне это известно. Просто знаю."

# dlc_cupid/ch/cupid/angela_bruce/aftermath.rpy:66
translate russian cupid_angela_bruce_aftermath_ed0d13da:
    angela.say "Ни за что не угадаешь, что твой отец устроил на этой неделе."

# dlc_cupid/ch/cupid/angela_bruce/aftermath.rpy:68
translate russian cupid_angela_bruce_aftermath_db147dad:
    angela.say "Он поменял все замки в доме. Новенькие, из цельной латуни!"

# dlc_cupid/ch/cupid/angela_bruce/aftermath.rpy:69
translate russian cupid_angela_bruce_aftermath_3af76c3f:
    angela.say "Говорит, что потерял ключи, а осторожность лишней не бывает."

# dlc_cupid/ch/cupid/angela_bruce/aftermath.rpy:71
translate russian cupid_angela_bruce_aftermath_7ca5da71:
    angela.say "Так что пусть [minami.name] знает: её старый ключ больше не подойдёт. Представляешь?"

# dlc_cupid/ch/cupid/angela_bruce/aftermath.rpy:73
translate russian cupid_angela_bruce_aftermath_5dc905e7:
    "По затылку пробегает холодок."

# dlc_cupid/ch/cupid/angela_bruce/aftermath.rpy:74
translate russian cupid_angela_bruce_aftermath_b922f6e3:
    "Ключ поворачивается в замке, а [minami.name] крепко держит меня за рукав."

# dlc_cupid/ch/cupid/angela_bruce/aftermath.rpy:75
translate russian cupid_angela_bruce_aftermath_0fb679ca:
    "А дальше ничего — будто из книги вырвали страницу."

# dlc_cupid/ch/cupid/angela_bruce/aftermath.rpy:76
translate russian cupid_angela_bruce_aftermath_2783d535:
    mike.say "Он поменял... все замки?"

# dlc_cupid/ch/cupid/angela_bruce/aftermath.rpy:79
translate russian cupid_angela_bruce_aftermath_19518b76:
    angela.say "Он поставил совершенно новую входную дверь. Из цельного дуба!"

# dlc_cupid/ch/cupid/angela_bruce/aftermath.rpy:80
translate russian cupid_angela_bruce_aftermath_0fd3f0f5:
    angela.say "Говорит, старая однажды днём просто слетела с петель."

# dlc_cupid/ch/cupid/angela_bruce/aftermath.rpy:82
translate russian cupid_angela_bruce_aftermath_5c6d2078:
    angela.say "Прогнила насквозь, а никто из нас и не замечал. Представляешь?"

# dlc_cupid/ch/cupid/angela_bruce/aftermath.rpy:84
translate russian cupid_angela_bruce_aftermath_5dc905e7_1:
    "По затылку пробегает холодок."

# dlc_cupid/ch/cupid/angela_bruce/aftermath.rpy:85
translate russian cupid_angela_bruce_aftermath_962db8d8:
    "Дверь, вылетающая от удара ботинком, и мужчина, орущий во всё горло."

# dlc_cupid/ch/cupid/angela_bruce/aftermath.rpy:86
translate russian cupid_angela_bruce_aftermath_0fb679ca_1:
    "А дальше ничего — будто из книги вырвали страницу."

# dlc_cupid/ch/cupid/angela_bruce/aftermath.rpy:87
translate russian cupid_angela_bruce_aftermath_25d01472:
    mike.say "Просто... слетела?"

# dlc_cupid/ch/cupid/angela_bruce/aftermath.rpy:89
translate russian cupid_angela_bruce_aftermath_c4ea8c29:
    angela.say "Так говорит твой отец."

# dlc_cupid/ch/cupid/angela_bruce/aftermath.rpy:90
translate russian cupid_angela_bruce_aftermath_92e10c1b:
    angela.say "А в таких вещах твой отец всегда прав."

# dlc_cupid/ch/cupid/angela_bruce/aftermath.rpy:94
translate russian cupid_angela_bruce_aftermath_2416d81f:
    angela.say "Ах да, он просил передать тебе кое-что."

# dlc_cupid/ch/cupid/angela_bruce/aftermath.rpy:95
translate russian cupid_angela_bruce_aftermath_9d14641a:
    angela.say "Говорит, что очень гордится своим учеником и что ты поймёшь."

# dlc_cupid/ch/cupid/angela_bruce/aftermath.rpy:97
translate russian cupid_angela_bruce_aftermath_47fd683a:
    angela.say "Ты что, теперь ходишь к нему на занятия? Ты мне никогда ничего не рассказываешь!"

# dlc_cupid/ch/cupid/angela_bruce/aftermath.rpy:99
translate russian cupid_angela_bruce_aftermath_d1219cd2:
    "Я в жизни не ходил к отцу ни на какие занятия."

# dlc_cupid/ch/cupid/angela_bruce/aftermath.rpy:100
translate russian cupid_angela_bruce_aftermath_76f8a8f3:
    "Но это слово ложится в желудок камнем и не сдвигается с места."

# dlc_cupid/ch/cupid/angela_bruce/aftermath.rpy:103
translate russian cupid_angela_bruce_aftermath_9e6be6ab:
    angela.say "Хотя вот что забавно. Однажды вечером я готова была поклясться, что вы двое стоите у меня в гостиной."

# dlc_cupid/ch/cupid/angela_bruce/aftermath.rpy:104
translate russian cupid_angela_bruce_aftermath_422be761:
    angela.say "Ты и твоя сестра, в куртках, и велите мне надеть свою."

# dlc_cupid/ch/cupid/angela_bruce/aftermath.rpy:106
translate russian cupid_angela_bruce_aftermath_dc6d7fc1:
    angela.say "Но твой отец говорит, что я задремала на диване и мне это приснилось."

# dlc_cupid/ch/cupid/angela_bruce/aftermath.rpy:108
translate russian cupid_angela_bruce_aftermath_19b4aa46:
    angela.say "Глупенькая я!"

# dlc_cupid/ch/cupid/angela_bruce/aftermath.rpy:110
translate russian cupid_angela_bruce_aftermath_80071e1c:
    "В тот вечер [minami.name] и я проснулись на нашем диване прямо в куртках, и никто из нас не понимал почему."

# dlc_cupid/ch/cupid/angela_bruce/aftermath.rpy:111
translate russian cupid_angela_bruce_aftermath_c073ed56:
    "Эта часть мне не приснилась."

# dlc_cupid/ch/cupid/angela_bruce/aftermath.rpy:114
translate russian cupid_angela_bruce_aftermath_da274b55:
    angela.say "Хотя вот что забавно. В тот день, когда это случилось, я готова была поклясться, что ты был там."

# dlc_cupid/ch/cupid/angela_bruce/aftermath.rpy:115
translate russian cupid_angela_bruce_aftermath_b2e48a94:
    angela.say "Ты и какой-то здоровенный лысый мужчина, посреди моей гостиной."

# dlc_cupid/ch/cupid/angela_bruce/aftermath.rpy:117
translate russian cupid_angela_bruce_aftermath_dc6d7fc1_1:
    angela.say "Но твой отец говорит, что я задремала на диване и мне это приснилось."

# dlc_cupid/ch/cupid/angela_bruce/aftermath.rpy:119
translate russian cupid_angela_bruce_aftermath_19b4aa46_1:
    angela.say "Глупенькая я!"

# dlc_cupid/ch/cupid/angela_bruce/aftermath.rpy:121
translate russian cupid_angela_bruce_aftermath_f5e8778d:
    "Какой-то здоровенный лысый мужчина."

# dlc_cupid/ch/cupid/angela_bruce/aftermath.rpy:122
translate russian cupid_angela_bruce_aftermath_92735244:
    "Пытаюсь его представить, но в голове только запах соснового освежителя воздуха."

# dlc_cupid/ch/cupid/angela_bruce/aftermath.rpy:125
translate russian cupid_angela_bruce_aftermath_60e84af9:
    angela.say "Он в последнее время такой внимательный. Цветы, ужины, записочки на холодильнике."

# dlc_cupid/ch/cupid/angela_bruce/aftermath.rpy:126
translate russian cupid_angela_bruce_aftermath_8b4225b3:
    angela.say "Наш брак никогда не был таким крепким, милый. Никогда."

# dlc_cupid/ch/cupid/angela_bruce/aftermath.rpy:128
translate russian cupid_angela_bruce_aftermath_bdfd2e94:
    "Она говорит это так, как люди зачитывают мелкий шрифт в договоре."

# dlc_cupid/ch/cupid/angela_bruce/aftermath.rpy:129
translate russian cupid_angela_bruce_aftermath_a796939d:
    "Каждое слово на своём месте, и ни одно не звучит как она."

# dlc_cupid/ch/cupid/angela_bruce/aftermath.rpy:131
translate russian cupid_angela_bruce_aftermath_22b8fa1c:
    "Её телефон вибрирует. Она бросает взгляд на экран и улыбается тому, что там написано."

# dlc_cupid/ch/cupid/angela_bruce/aftermath.rpy:132
translate russian cupid_angela_bruce_aftermath_4c40539a:
    "Потом присаживается на подлокотник дивана и прикрывает зевок ладонью."

# dlc_cupid/ch/cupid/angela_bruce/aftermath.rpy:134
translate russian cupid_angela_bruce_aftermath_08524a10:
    angela.say "Прошу прощения."

# dlc_cupid/ch/cupid/angela_bruce/aftermath.rpy:135
translate russian cupid_angela_bruce_aftermath_f109f37b:
    angela.say "Твой отец говорит, что в последнее время я выгляжу усталой."

# dlc_cupid/ch/cupid/angela_bruce/aftermath.rpy:137
translate russian cupid_angela_bruce_aftermath_644997bc:
    "Я уже слышал эту фразу. Только никогда — от неё."

# dlc_cupid/ch/cupid/angela_bruce/aftermath.rpy:138
translate russian cupid_angela_bruce_aftermath_890f5a44:
    "И на секунду она смотрит на меня, будто ждёт, что прозвучит дальше."

# dlc_cupid/ch/cupid/angela_bruce/aftermath.rpy:141
translate russian cupid_angela_bruce_aftermath_fbbf910d:
    mike.say "Ты не выглядишь усталой, мам."

# dlc_cupid/ch/cupid/angela_bruce/aftermath.rpy:142
translate russian cupid_angela_bruce_aftermath_26594826:
    mike.say "Ты выглядишь как ты."

# dlc_cupid/ch/cupid/angela_bruce/aftermath.rpy:144
translate russian cupid_angela_bruce_aftermath_5313b250:
    "Она моргает. Раз, другой."

# dlc_cupid/ch/cupid/angela_bruce/aftermath.rpy:145
translate russian cupid_angela_bruce_aftermath_4800f6a8:
    "В глубине её глаз проскальзывает мысль, быстрая, как рыба подо льдом."

# dlc_cupid/ch/cupid/angela_bruce/aftermath.rpy:147
translate russian cupid_angela_bruce_aftermath_4a32b490:
    angela.say "Правда?"

# dlc_cupid/ch/cupid/angela_bruce/aftermath.rpy:148
translate russian cupid_angela_bruce_aftermath_7d1dd08c:
    angela.say "Тогда почему все твердят мне обратное?"

# dlc_cupid/ch/cupid/angela_bruce/aftermath.rpy:150
translate russian cupid_angela_bruce_aftermath_128f3813:
    "На мгновение из её голоса пропадает сладость."

# dlc_cupid/ch/cupid/angela_bruce/aftermath.rpy:151
translate russian cupid_angela_bruce_aftermath_6e8cfd2d:
    "То, что остаётся под ней, звучит резче — голос женщины, привыкшей отдавать приказы."

# dlc_cupid/ch/cupid/angela_bruce/aftermath.rpy:153
translate russian cupid_angela_bruce_aftermath_ad5b37ce:
    angela.say "[hero.name]... я ведь что-то должна была вспомнить?"

# dlc_cupid/ch/cupid/angela_bruce/aftermath.rpy:154
translate russian cupid_angela_bruce_aftermath_6357d542:
    angela.say "Кажется, было что-то такое. Какое-то приятное место. Столик у окна."

# dlc_cupid/ch/cupid/angela_bruce/aftermath.rpy:157
translate russian cupid_angela_bruce_aftermath_75d219a7:
    "Её телефон снова вибрирует, прежде чем я успеваю ответить."

# dlc_cupid/ch/cupid/angela_bruce/aftermath.rpy:158
translate russian cupid_angela_bruce_aftermath_c472509b:
    "Она опускает взгляд, и то, что всплывало, снова уходит на глубину."

# dlc_cupid/ch/cupid/angela_bruce/aftermath.rpy:160
translate russian cupid_angela_bruce_aftermath_2ec465f2:
    angela.say "Твой отец. Мне пора домой."

# dlc_cupid/ch/cupid/angela_bruce/aftermath.rpy:162
translate russian cupid_angela_bruce_aftermath_21ebbbfd:
    "Но у двери она останавливается, держась рукой за косяк."

# dlc_cupid/ch/cupid/angela_bruce/aftermath.rpy:163
translate russian cupid_angela_bruce_aftermath_c6151f04:
    "Она оглядывается на меня, и уйти ей удаётся не сразу."

# dlc_cupid/ch/cupid/angela_bruce/aftermath.rpy:166
translate russian cupid_angela_bruce_aftermath_402455b7:
    mike.say "Может, папа прав, мам."

# dlc_cupid/ch/cupid/angela_bruce/aftermath.rpy:167
translate russian cupid_angela_bruce_aftermath_452a64f6:
    mike.say "Отдохни, ладно?"

# dlc_cupid/ch/cupid/angela_bruce/aftermath.rpy:169
translate russian cupid_angela_bruce_aftermath_516a07f2:
    "Её улыбка становится гладкой, как стекло."

# dlc_cupid/ch/cupid/angela_bruce/aftermath.rpy:170
translate russian cupid_angela_bruce_aftermath_87d2c5f1:
    angela.say "Да. Отдохнуть."

# dlc_cupid/ch/cupid/angela_bruce/aftermath.rpy:171
translate russian cupid_angela_bruce_aftermath_e4f62eea:
    angela.say "Твоему отцу виднее."

# dlc_cupid/ch/cupid/angela_bruce/aftermath.rpy:173
translate russian cupid_angela_bruce_aftermath_507514c2:
    angela.say "Ему всегда было виднее, милый!"

# dlc_cupid/ch/cupid/angela_bruce/aftermath.rpy:175
translate russian cupid_angela_bruce_aftermath_470e962b:
    "Она целует меня в макушку и упархивает так же, как пришла."

# dlc_cupid/ch/cupid/angela_bruce/aftermath.rpy:176
translate russian cupid_angela_bruce_aftermath_77e5f8fb:
    "Я сижу, пока мои хлопья размокают, с чувством, будто только что собственными руками вернул её ему."

# dlc_cupid/ch/cupid/angela_bruce/aftermath.rpy:179
translate russian cupid_angela_bruce_aftermath_dd6d0043:
    "Чуть позже я листаю телефон в поисках номера доставки еды."

# dlc_cupid/ch/cupid/angela_bruce/aftermath.rpy:180
translate russian cupid_angela_bruce_aftermath_d333a58a:
    "И натыкаюсь на заметку, которую не помню, как писал."

# dlc_cupid/ch/cupid/angela_bruce/aftermath.rpy:181
translate russian cupid_angela_bruce_aftermath_16bacd88:
    "«Ты выглядишь усталой» = его триггер. Следи, чтобы [minami.name] не забыла."

# dlc_cupid/ch/cupid/angela_bruce/aftermath.rpy:182
translate russian cupid_angela_bruce_aftermath_895e14ac:
    "Мои слова, мои опечатки. Дата — прошлая неделя."

# dlc_cupid/ch/cupid/angela_bruce/aftermath.rpy:183
translate russian cupid_angela_bruce_aftermath_63ee97a1:
    "Я перечитываю её, пока экран сам не гаснет."

# dlc_cupid/ch/cupid/angela_bruce/aftermath.rpy:185
translate russian cupid_angela_bruce_aftermath_dd6d0043_1:
    "Чуть позже я листаю телефон в поисках номера доставки еды."

# dlc_cupid/ch/cupid/angela_bruce/aftermath.rpy:186
translate russian cupid_angela_bruce_aftermath_637730d8:
    "И натыкаюсь на журнал звонков."

# dlc_cupid/ch/cupid/angela_bruce/aftermath.rpy:187
translate russian cupid_angela_bruce_aftermath_ad7fbff1:
    "Брюс. Три звонка за последние несколько дней, один почти на час."

# dlc_cupid/ch/cupid/angela_bruce/aftermath.rpy:188
translate russian cupid_angela_bruce_aftermath_dcff0e31:
    "Тот самый, у которого дочка — [bree.name]. Бывший коп, который скорее врежет мне, чем пожмёт руку."

# dlc_cupid/ch/cupid/angela_bruce/aftermath.rpy:189
translate russian cupid_angela_bruce_aftermath_6e501f10:
    "Я не помню ни единого слова ни из одного разговора."

# dlc_cupid/ch/cupid/angela_bruce/aftermath.rpy:190
translate russian cupid_angela_bruce_aftermath_2661037e:
    "Мой палец долго висит над его именем."

# dlc_cupid/ch/cupid/angela_bruce/aftermath.rpy:191
translate russian cupid_angela_bruce_aftermath_c1171ec1:
    "А потом экран сам гаснет."

# dlc_cupid/ch/cupid/angela_bruce/event.rpy:453
translate russian cupid_angela_bruce_event_01_0f3674e7:
    mike.say "Если с моей мамой что-то не так, это семейное дело, Брюс."

# dlc_cupid/ch/cupid/angela_bruce/event.rpy:454
translate russian cupid_angela_bruce_event_01_db5f23fa:
    mike.say "[minami.name] и я выросли в этом доме. Мы знаем, как там всё устроено."

# dlc_cupid/ch/cupid/angela_bruce/event.rpy:455
translate russian cupid_angela_bruce_event_01_4fb0600e:
    mike.say "Мы сами разберёмся."

# dlc_cupid/ch/cupid/angela_bruce/event.rpy:457
translate russian cupid_angela_bruce_event_01_adf79448:
    "Брюс долго это переваривает, будто решает, спорить со мной или врезать."

# dlc_cupid/ch/cupid/angela_bruce/event.rpy:459
translate russian cupid_angela_bruce_event_01_5c8f30b3:
    breesdad "Семья, значит?"

# dlc_cupid/ch/cupid/angela_bruce/event.rpy:460
translate russian cupid_angela_bruce_event_01_9a66bf49:
    breesdad "Ладно, парень. Твоя мама — тебе решать."

# dlc_cupid/ch/cupid/angela_bruce/event.rpy:461
translate russian cupid_angela_bruce_event_01_b1c5f514:
    breesdad "Но если вы двое облажаетесь, я войду через парадную дверь."

# dlc_cupid/ch/cupid/angela_bruce/event.rpy:464
translate russian cupid_angela_bruce_event_01_5167c811:
    "Брюс уходит, не сказав больше ни слова."

# dlc_cupid/ch/cupid/angela_bruce/event.rpy:501
translate russian cupid_angela_bruce_event_01_05c3e917:
    mike.say "Э-э... нет, [bree.callname], он, похоже, был в довольно хорошем настроении."

# dlc_cupid/ch/cupid/angela_bruce/event.rpy:879
translate russian cupid_angela_bruce_event_03_89790ba0:
    mike.say "Да, [bree.callname], так и есть."

# dlc_cupid/ch/cupid/angela_bruce/event.rpy:1317
translate russian cupid_angela_bruce_event_04_c3e6c9fc:
    "Последнее, что я помню, — как [minami.name] поворачивает ключ в замке входной двери дома наших родителей."

# dlc_cupid/ch/cupid/angela_bruce/event.rpy:1318
translate russian cupid_angela_bruce_event_04_2380f3a2:
    "Потом мы вошли, и там была мама... и папа, кажется, тоже."

# dlc_cupid/ch/cupid/angela_bruce/event.rpy:1334
translate russian cupid_angela_bruce_event_04_35033c26:
    "Мама тоже выглядит ненастоящей — застыла посреди того, чем занималась, когда я выступил против отца."

# dlc_cupid/ch/cupid/angela_bruce/event.rpy:1336
translate russian cupid_angela_bruce_event_04_ffb299e3:
    "Но [minami.name] — нет. Она рядом со мной и сжимает мой рукав так сильно, что больно."

# dlc_cupid/ch/cupid/angela_bruce/event.rpy:1337
translate russian cupid_angela_bruce_event_04_336418d7:
    "Должно быть, она вцепилась в меня, когда отец щёлкнул зажигалкой, и её затянуло вместе со мной."

# dlc_cupid/ch/cupid/angela_bruce/event.rpy:1472
translate russian cupid_angela_bruce_event_04_3b7e1e57:
    "Но не успеваю я и рта раскрыть, как [minami.name] отпускает мой рукав и выходит вперёд."

# dlc_cupid/ch/cupid/angela_bruce/event.rpy:1474
translate russian cupid_angela_bruce_event_04_18de7fdb:
    minami.say "Нет."

# dlc_cupid/ch/cupid/angela_bruce/event.rpy:1475
translate russian cupid_angela_bruce_event_04_2b175298:
    minami.say "Ты не имеешь права так говорить, папа."

# dlc_cupid/ch/cupid/angela_bruce/event.rpy:1477
translate russian cupid_angela_bruce_event_04_c37a3943:
    "Отец переводит на неё взгляд, и впервые в нём видна неуверенность."

# dlc_cupid/ch/cupid/angela_bruce/event.rpy:1479
translate russian cupid_angela_bruce_event_04_41abca18:
    minami.say "Мама обнимала меня в ту ночь, когда я приехала и не могла перестать плакать."

# dlc_cupid/ch/cupid/angela_bruce/event.rpy:1480
translate russian cupid_angela_bruce_event_04_75991d4f:
    minami.say "Она училась готовить по книге рецепты моей бабушки и спалила все до единого."

# dlc_cupid/ch/cupid/angela_bruce/event.rpy:1481
translate russian cupid_angela_bruce_event_04_d3d6cb94:
    minami.say "Ты не заставлял её всё это делать. Ты был на концерте."

# dlc_cupid/ch/cupid/angela_bruce/event.rpy:1482
translate russian cupid_angela_bruce_event_04_c90e6c47:
    minami.say "И то, что я чувствую, когда рядом [lssb_minami.hero_name()], никто во мне не формировал. Это моё!"

# dlc_cupid/ch/cupid/angela_bruce/event.rpy:1485
translate russian cupid_angela_bruce_event_04_0a4bfdbb:
    "Отец отшатывается, будто она дала ему пощёчину."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:162
translate russian cupid_angela_bruce_minami_01_be161fad:
    "Обернувшись, я вижу, что [minami.name] сидит на середине лестницы, подтянув колени к подбородку."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:163
translate russian cupid_angela_bruce_minami_01_f8a4ae26:
    "Судя по её лицу, она слышала каждое слово."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:165
translate russian cupid_angela_bruce_minami_01_e9321b57:
    minami.say "Этот мужчина говорил о маме, да?"

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:167
translate russian cupid_angela_bruce_minami_01_02a0706b:
    mike.say "Ага. Это был Брюс. Его дочь — [bree.name]."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:168
translate russian cupid_angela_bruce_minami_01_52d48788:
    mike.say "Он водил маму на ужин, а теперь думает, что отец что-то с ней делает."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:170
translate russian cupid_angela_bruce_minami_01_a8f65563:
    "Я жду, что она рассмеётся. Но она не смеётся."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:172
translate russian cupid_angela_bruce_minami_01_c373cb60:
    minami.say "Я звонила ей на прошлой неделе, [lssb_minami.hero_name()]."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:173
translate russian cupid_angela_bruce_minami_01_7609d461:
    minami.say "Она спросила, как прошли мои экзамены. А потом спросила ещё раз, теми же самыми словами."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:174
translate russian cupid_angela_bruce_minami_01_088d3d4c:
    minami.say "Будто кто-то нажал перемотку."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:176
translate russian cupid_angela_bruce_minami_01_24e3973e:
    mike.say "Тогда поедем и посмотрим сами. Завтра, вдвоём."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:178
translate russian cupid_angela_bruce_minami_01_d142a67b:
    minami.say "Как тогда, когда мы разбили бабушкину вазу?"

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:179
translate russian cupid_angela_bruce_minami_01_87df4b41:
    minami.say "Ты всё говорил, а я всё плакала?"

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:181
translate russian cupid_angela_bruce_minami_01_fcdbaf98:
    mike.say "Давай в этот раз обойдёмся без слёз."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:183
translate russian cupid_angela_bruce_minami_01_8b682360:
    minami.say "Ничего не обещаю!"

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:190
translate russian cupid_angela_bruce_minami_02_12ea25b8:
    "[minami.name] держит меня за руку всю дорогу по садовой дорожке к дому родителей — так же, как в детстве."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:191
translate russian cupid_angela_bruce_minami_02_089813e5:
    "Она отпускает её за секунду до того, как открывается дверь, будто стесняется, что её застанут за этим."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:194
translate russian cupid_angela_bruce_minami_02_2c732d15:
    "Dylan" "Оба моих ребёнка, да ещё в один день!"

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:195
translate russian cupid_angela_bruce_minami_02_453e35a7:
    "Dylan" "Чем обязан такой волшебной чести?"

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:198
translate russian cupid_angela_bruce_minami_02_3168f66b:
    minami.say "Привет, пап! Мы были неподалёку."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:200
translate russian cupid_angela_bruce_minami_02_c88750d1:
    "Отец достаёт колоду карт словно из воздуха и веером раскрывает её у неё перед носом."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:202
translate russian cupid_angela_bruce_minami_02_41000c57:
    "Dylan" "Вытяни карту, солнышко. Любую."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:205
translate russian cupid_angela_bruce_minami_02_a063c34b:
    minami.say "Это дама червей, пап. Всегда дама червей."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:206
translate russian cupid_angela_bruce_minami_02_45dad8e2:
    minami.say "Ты научил меня этому фокусу, когда мне было девять."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:209
translate russian cupid_angela_bruce_minami_02_1e3a0fb2:
    "Лицо отца вытягивается, и карты исчезают обратно в рукаве."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:211
translate russian cupid_angela_bruce_minami_02_f90ce439:
    "Dylan" "Тогда на кухню. Ваша мама там, а я как раз заварил чайничек."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:218
translate russian cupid_angela_bruce_minami_02_3915db9f:
    "Мама сидит за столом с чашкой в руках и улыбается непонятно чему."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:219
translate russian cupid_angela_bruce_minami_02_1c6ea3c2:
    mike.say "Привет, мам."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:220
translate russian cupid_angela_bruce_minami_02_d0e0c039:
    mike.say "Мы хотели поговорить с тобой насчёт той истории с рестораном."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:224
translate russian cupid_angela_bruce_minami_02_58f6dd7c:
    "Dylan" "О, мы уже всё забыли. Правда, дорогая?"

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:227
translate russian cupid_angela_bruce_minami_02_dc59ea5c:
    angela.say "Да. Мы уже всё забыли."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:229
translate russian cupid_angela_bruce_minami_02_6fe32478:
    "Dylan" "Давно в прошлом."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:231
translate russian cupid_angela_bruce_minami_02_11c7d908:
    angela.say "Давно в прошлом."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:234
translate russian cupid_angela_bruce_minami_02_871a9811:
    "Я слышу, как [minami.name] у меня за спиной резко втягивает воздух."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:235
translate russian cupid_angela_bruce_minami_02_9620e12d:
    "Оглянувшись, я вижу, что она побелела."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:236
translate russian cupid_angela_bruce_minami_02_df09bd43:
    "Брюс говорил, что мама ведёт себя странно. Он не говорил, что она превратилась в эхо."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:237
translate russian cupid_angela_bruce_minami_02_74c77524:
    "Мне нужна минута наедине с мамой, и [minami.name] читает это по моему лицу раньше, чем я успеваю придумать, как это устроить."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:239
translate russian cupid_angela_bruce_minami_02_48fcdb3d:
    minami.say "Пап, можно посмотреть новый сорт чая?"

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:240
translate russian cupid_angela_bruce_minami_02_9e26c45d:
    minami.say "Тот, что в подвале? Хочу взять немного домой."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:243
translate russian cupid_angela_bruce_minami_02_dc32e9bc:
    "Отец загорается, как прожектор на сцене."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:244
translate russian cupid_angela_bruce_minami_02_95a68109:
    "Dylan" "Наконец-то хоть у одного из моих детей есть вкус!"

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:249
translate russian cupid_angela_bruce_minami_02_bd81d6b4:
    "Как только они спускаются в подвал, я сажусь рядом с мамой."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:250
translate russian cupid_angela_bruce_minami_02_0b6ed054:
    mike.say "Мам, тут только мы. Мне можно рассказать что угодно."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:251
translate russian cupid_angela_bruce_minami_02_aa7d56ad:
    mike.say "Про ужин с Брюсом."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:253
translate russian cupid_angela_bruce_minami_02_8eda1359:
    angela.say "С Брюсом?"

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:254
translate russian cupid_angela_bruce_minami_02_01b85e7b:
    angela.say "В тот ресторан меня водил твой отец, милый. Мы прекрасно провели вечер."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:255
translate russian cupid_angela_bruce_minami_02_a1c81ffe:
    angela.say "После этого я почувствовала, что люблю его сильнее, чем за все последние годы."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:257
translate russian cupid_angela_bruce_minami_02_22a49876:
    "Каждое слово звучит в том же порядке и с тем же весом, будто она читает с карточек-подсказок."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:258
translate russian cupid_angela_bruce_minami_02_5e45b4c7:
    mike.say "Мам, я там был. Я видел тебя с ним."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:260
translate russian cupid_angela_bruce_minami_02_8b8fb494:
    "Она смотрит на меня с вежливым интересом — так смотрят на незнакомца в автобусе."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:261
translate russian cupid_angela_bruce_minami_02_7affee6c:
    "Потом отец и [minami.name] поднимаются обратно, и улыбка снова встаёт на место."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:266
translate russian cupid_angela_bruce_minami_02_ec267357:
    "[minami.name] прижимает к груди бумажный пакет с чаем чуть крепче, чем нужно."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:267
translate russian cupid_angela_bruce_minami_02_1be84b30:
    "Мы придумываем отговорку и направляемся к двери, а отец провожает нас."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:270
translate russian cupid_angela_bruce_minami_02_79017561:
    "Dylan" "Ах да, сынок. Ты получил книгу, которую я тебе отправил?"

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:272
translate russian cupid_angela_bruce_minami_02_a29b66cb:
    mike.say "Э-э... да, пап, получил."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:274
translate russian cupid_angela_bruce_minami_02_28eaeabb:
    "Dylan" "Уже прочёл?"

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:279
translate russian cupid_angela_bruce_minami_02_cb92d8b0:
    mike.say "Да, я её начал."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:281
translate russian cupid_angela_bruce_minami_02_1fc30979:
    "Dylan" "Молодец. Только от корки до корки."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:283
translate russian cupid_angela_bruce_minami_02_8ff92f22:
    mike.say "Пока нет, пап. Я был занят."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:285
translate russian cupid_angela_bruce_minami_02_f1e0a2d1:
    "Dylan" "Так найди время! От корки до корки."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:287
translate russian cupid_angela_bruce_minami_02_729510dd:
    "Dylan" "Эта книга переходит от отца к сыну уже много поколений."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:288
translate russian cupid_angela_bruce_minami_02_a1168829:
    "Dylan" "Без неё ты никогда не поймёшь, кто ты на самом деле."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:290
translate russian cupid_angela_bruce_minami_02_0b7cf787:
    "[minami.name] молчит, пока мы не отходим на три квартала."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:294
translate russian cupid_angela_bruce_minami_02_0786c6c3:
    minami.say "В подвале есть коробка, [lssb_minami.hero_name()]. За чаем."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:295
translate russian cupid_angela_bruce_minami_02_45352c62:
    minami.say "На крышке мамин почерк, и она была заклеена скотчем."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:296
translate russian cupid_angela_bruce_minami_02_e91e28d3:
    minami.say "Открыть я не успела, так что просто забрала её."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:298
translate russian cupid_angela_bruce_minami_02_ded1e13a:
    "Она распахивает пальто. Коробка спрятана внутри, прижатая к рёбрам."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:299
translate russian cupid_angela_bruce_minami_02_78451807:
    mike.say "Ты украла у папы?"

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:301
translate russian cupid_angela_bruce_minami_02_26a15ea0:
    minami.say "А он крадёт у мамы!"

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:303
translate russian cupid_angela_bruce_minami_02_6bfc1e32:
    mike.say "Ладно. Справедливо."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:304
translate russian cupid_angela_bruce_minami_02_209a1de9:
    mike.say "Завтра вечером откроем её вместе."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:313
translate russian cupid_angela_bruce_minami_03_d12af1c6:
    "[minami.name] превратила журнальный столик в доску с уликами."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:314
translate russian cupid_angela_bruce_minami_03_789f3158:
    "Посередине стоит открытая коробка из подвала, а её содержимое разложено аккуратными рядами."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:317
translate russian cupid_angela_bruce_minami_03_bb0eabf9:
    minami.say "Так. Я сделала всё, как в детективных сериалах."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:318
translate russian cupid_angela_bruce_minami_03_db682e5b:
    minami.say "Первое."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:320
translate russian cupid_angela_bruce_minami_03_71387100:
    "Она пододвигает ко мне по столу карточку записи на приём. Клиника памяти, на мамино имя."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:322
translate russian cupid_angela_bruce_minami_03_e6f2eead:
    minami.say "Она ходила к кому-то из-за проблем с памятью. Три раза."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:323
translate russian cupid_angela_bruce_minami_03_2a475e9c:
    minami.say "И ни одному из нас не сказала."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:325
translate russian cupid_angela_bruce_minami_03_51d14019:
    mike.say "Может, она забыла, что ходила."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:327
translate russian cupid_angela_bruce_minami_03_d320857c:
    minami.say "Это не смешно, [lssb_minami.hero_name()]."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:329
translate russian cupid_angela_bruce_minami_03_77cf2c70:
    mike.say "А я и не шучу."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:330
translate russian cupid_angela_bruce_minami_03_80f53355:
    "[minami.name] сглатывает и берёт следующий предмет — старую афишу, сложенную вчетверо."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:331
translate russian cupid_angela_bruce_minami_03_efe264a2:
    "Отец в бархатном костюме, гораздо моложе и гораздо стройнее, держит на свету зажигалку."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:333
translate russian cupid_angela_bruce_minami_03_b05c4c80:
    minami.say "Папа не курит. Он никогда не курил."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:334
translate russian cupid_angela_bruce_minami_03_ddc9a04f:
    minami.say "Так что я поискала его старый номер в интернете. Кто-то выложил запись."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:336
translate russian cupid_angela_bruce_minami_03_7ece58f4:
    "Она разворачивает ко мне ноутбук. Отец на сцене склоняется над девушкой на стуле."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:338
translate russian cupid_angela_bruce_minami_03_347c6160:
    "Он щёлкает зажигалкой, наклоняется поближе и что-то говорит ей на ухо."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:339
translate russian cupid_angela_bruce_minami_03_71f8bcb9:
    mike.say "Что он говорит?"

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:341
translate russian cupid_angela_bruce_minami_03_dc234572:
    minami.say "«Ты выглядишь усталой»."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:343
translate russian cupid_angela_bruce_minami_03_05ee676b:
    minami.say "Он постоянно говорит это маме, [lssb_minami.hero_name()]. Каждый раз, когда она начинает с ним спорить."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:344
translate russian cupid_angela_bruce_minami_03_df1e0d4f:
    minami.say "А я всегда думала, что это мило."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:346
translate russian cupid_angela_bruce_minami_03_dc71fc14:
    "На последнем слове её голос срывается, и она вытирает глаза тыльной стороной ладони."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:348
translate russian cupid_angela_bruce_minami_03_713a3aa3:
    "Последнее, что лежит в коробке, — фото отца с женщиной, которую я никогда не видел, и траурная карточка с её именем."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:349
translate russian cupid_angela_bruce_minami_03_ec622fea:
    "Дата на карточке — двадцать лет назад. До мамы. До нас."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:350
translate russian cupid_angela_bruce_minami_03_525b964e:
    mike.say "Отец уже был женат."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:352
translate russian cupid_angela_bruce_minami_03_55f4a8e5:
    minami.say "И никто никогда о ней не упоминал. Ни разу."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:355
translate russian cupid_angela_bruce_minami_03_9c33b6d9:
    "Если бы я не прочитал начало той книги, то назвал бы всё это совпадением."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:356
translate russian cupid_angela_bruce_minami_03_03e60672:
    "Но в книге говорится о триггерах, якорях и словах, которые открывают двери в головах людей."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:357
translate russian cupid_angela_bruce_minami_03_841ac284:
    "И теперь я знаю, в чью голову отец открывал двери."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:359
translate russian cupid_angela_bruce_minami_03_52124b4e:
    "Я всё ищу невинное объяснение и всё не нахожу."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:360
translate russian cupid_angela_bruce_minami_03_e6d6d742:
    mike.say "Нам надо её оттуда забрать."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:362
translate russian cupid_angela_bruce_minami_03_1def9c17:
    minami.say "У меня до сих пор есть ключ."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:363
translate russian cupid_angela_bruce_minami_03_0e5c9d95:
    minami.say "А по четвергам вечером папа выступает со своим номером в доме культуры. Он не пропустил ни разу."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:365
translate russian cupid_angela_bruce_minami_03_863c8f6e:
    "Она продумала всё дальше, чем я."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:368
translate russian cupid_angela_bruce_minami_03_8b411b92:
    mike.say "Каждый день ожидания — это ещё один день, когда он у неё в голове."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:369
translate russian cupid_angela_bruce_minami_03_28ffc544:
    mike.say "Едем сегодня."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:371
translate russian cupid_angela_bruce_minami_03_b35a47c2:
    "[minami.name] кивает, но берёт пальто так, будто оно весит тонну."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:373
translate russian cupid_angela_bruce_minami_03_d0af2c2a:
    "Ключ поворачивается беззвучно. В доме пахнет чаем и полиролью для мебели, как всегда."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:377
translate russian cupid_angela_bruce_minami_03_484ae7c0:
    angela.say "Дети? Что вы здесь делаете в такой час?"

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:380
translate russian cupid_angela_bruce_minami_03_439793b8:
    minami.say "Надевай пальто, мам. Ты едешь с нами."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:383
translate russian cupid_angela_bruce_minami_03_ab50e41a:
    "Dylan" "Неужели?"

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:384
translate russian cupid_angela_bruce_minami_03_d0e2754f:
    "Отец стоит в дверях у нас за спиной. Я не слышал, как он вошёл."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:386
translate russian cupid_angela_bruce_minami_03_dbc4206f:
    "И он ни капли не выглядит удивлённым."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:387
translate russian cupid_angela_bruce_minami_03_c837b519:
    "Я не замечаю, как появляется зажигалка. Она просто оказывается у него в руке."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:392
translate russian cupid_angela_bruce_minami_03_3ae08de7:
    "Dylan" "Ох, мои дорогие. Вы оба выглядите такими усталыми."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:396
translate russian cupid_angela_bruce_minami_03_a34430fb:
    "Я чувствую, как [minami.name] сжимает мой рукав."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:398
translate russian cupid_angela_bruce_minami_03_61dd0b8d:
    "И в голове у меня всплывает что-то из книги, как пузырь, поднимающийся сквозь воду."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:399
translate russian cupid_angela_bruce_minami_03_21cb8e99:
    mike.say "Иззи-виззи, чудо, явись!"

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:402
translate russian cupid_angela_bruce_minami_03_b6cd4935:
    "Со мной ничего не происходит. Но отец делает шаг назад, а мама замирает на полуслове."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:404
translate russian cupid_angela_bruce_minami_03_8d7c2305:
    "Dylan" "Значит, ты прочитал книгу. Круг замкнулся, и теперь ты мой ученик."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:405
translate russian cupid_angela_bruce_minami_03_797b9cdc:
    "Dylan" "Посмотрим, сколькому ты на самом деле научился!"

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:412
translate russian cupid_angela_bruce_minami_03_25326ee2:
    "Я пытаюсь закрыть уши."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:414
translate russian cupid_angela_bruce_minami_03_bb9f00ee:
    "А потом не понимаю, зачем мне это."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:421
translate russian cupid_angela_bruce_minami_03_7870e845:
    mike.say "Если он может делать такое с мамой, то и с нами сможет."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:422
translate russian cupid_angela_bruce_minami_03_5774840a:
    mike.say "Подождём четверга, когда он уйдёт выступать."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:424
translate russian cupid_angela_bruce_minami_03_87e1c7e8:
    minami.say "Я соберу ей сумку."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:425
translate russian cupid_angela_bruce_minami_03_57630e46:
    minami.say "Её синий кардиган и тапочки с дырками. Она их никогда не выбрасывает."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:427
translate russian cupid_angela_bruce_minami_03_4735b749:
    "Она говорит это как шутку, но уже пишет список на обороте афиши."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:444
translate russian cupid_angela_bruce_minami_lost_ec4150dc:
    mike.say "Какого..."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:445
translate russian cupid_angela_bruce_minami_lost_47f3ede3:
    "Я сижу на нашем диване, так и не сняв пальто. [minami.name] тоже."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:447
translate russian cupid_angela_bruce_minami_lost_dac77019:
    minami.say "[lssb_minami.hero_name()]? Почему мы одеты, будто собрались уходить?"

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:449
translate russian cupid_angela_bruce_minami_lost_38011ffe:
    "У меня нет ответа. У неё тоже."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:450
translate russian cupid_angela_bruce_minami_lost_8d34da75:
    "В руке у неё ключ от дома, и она смотрит на него так, будто видит впервые."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:451
translate russian cupid_angela_bruce_minami_lost_21c91b9a:
    "В конце концов мы решаем, что, наверное, задремали перед фильмом."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:452
translate russian cupid_angela_bruce_minami_lost_c23d8b28:
    "Но ни один из нас не может вспомнить, перед каким."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:459
translate russian cupid_angela_bruce_minami_04_won_741d2952:
    "Но тут его глаза широко распахиваются и стекленеют."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:460
translate russian cupid_angela_bruce_minami_04_won_ca5ec1ac:
    "Руки повисают вдоль тела, и вся комната снова обретает чёткость."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:470
translate russian cupid_angela_bruce_minami_04_won_2aee3a4b:
    "Отец оседает в своё кресло, как марионетка с перерезанными нитями."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:472
translate russian cupid_angela_bruce_minami_04_won_b73fe306:
    angela.say "Дилан? Дети, вашему отцу плохо!"

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:475
translate russian cupid_angela_bruce_minami_04_won_7869ad9b:
    minami.say "Всё с ним нормально, мам. Он просто устал."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:477
translate russian cupid_angela_bruce_minami_04_won_a3dc9624:
    "Она говорит это ровно, без тени иронии, и я не уверен, что она вообще себя слышит."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:478
translate russian cupid_angela_bruce_minami_04_won_b81f8387:
    "Потом она пересекает комнату и берёт мамину руку в обе ладони."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:480
translate russian cupid_angela_bruce_minami_04_won_b7acc59a:
    minami.say "Сегодня ты едешь домой с нами."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:483
translate russian cupid_angela_bruce_minami_04_won_912f6fdf:
    angela.say "Домой? Но мой дом здесь."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:485
translate russian cupid_angela_bruce_minami_04_won_8d25229a:
    mike.say "Я всё объясню, мам. Обещаю. Но не здесь."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:486
translate russian cupid_angela_bruce_minami_04_won_8b54a9a2:
    "[minami.name] вызывает такси, пока я ищу мамино пальто."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:487
translate russian cupid_angela_bruce_minami_04_won_c307a5c0:
    "Всё это время отец не шевелится. Дыхание у него медленное и ровное, как у человека, отсыпающегося после долгого выступления."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:488
translate russian cupid_angela_bruce_minami_04_won_a7a72adc:
    "Где-то в глубине души я знаю, что мог бы оставить ему маленькое внушение перед уходом."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:489
translate russian cupid_angela_bruce_minami_04_won_fb45143b:
    "Что-нибудь, чтобы он забыл всё это или никогда не пытался нас искать."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:490
translate russian cupid_angela_bruce_minami_04_won_432ca05f:
    "Я этого не делаю. Именно так он и дошёл до всего этого."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:497
translate russian cupid_angela_bruce_minami_05_cdbebfb0:
    "Мама ночевала у нас на диване, закутавшись в запасное одеяло, которое ей дала [minami.name]."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:498
translate russian cupid_angela_bruce_minami_05_39d6b4b7:
    "Всё утро она спрашивала, когда можно будет поехать домой и проведать папу."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:500
translate russian cupid_angela_bruce_minami_05_5a0f8338:
    "Мы забрали маму в четверг вечером, пока отец выступал на сцене в доме культуры."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:501
translate russian cupid_angela_bruce_minami_05_696ea2c0:
    "Сумку собрала [minami.name]. Синий кардиган и тапочки с дырками."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:502
translate russian cupid_angela_bruce_minami_05_3a4fb9a9:
    "Мама поехала с нами, потому что её попросили дети. Не уверен, что она понимала зачем."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:506
translate russian cupid_angela_bruce_minami_05_db47d276:
    "Теперь она сидит между нами с чашкой чая, к которой так и не притронулась, а [minami.name] открыла ноутбук."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:508
translate russian cupid_angela_bruce_minami_05_940a8f4a:
    minami.say "Мам, смотри, что я нашла в интернете. Старый номер папы."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:511
translate russian cupid_angela_bruce_minami_05_bacdfb86:
    angela.say "Боже мой. Я думала, никаких записей не осталось."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:512
translate russian cupid_angela_bruce_minami_05_f591a980:
    angela.say "Твой отец говорил, что всё сгорело при пожаре на телестудии."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:514
translate russian cupid_angela_bruce_minami_05_85f6d18a:
    angela.say "Я ведь была его ассистенткой. Он показывал этот фокус на добровольцах из зала."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:517
translate russian cupid_angela_bruce_minami_05_1fc7a3fe:
    "На экране отец щёлкает зажигалкой и склоняется над девушкой на стуле."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:518
translate russian cupid_angela_bruce_minami_05_509967fc:
    mike.say "Тогда кто это на стуле, мам?"

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:520
translate russian cupid_angela_bruce_minami_05_d5302440:
    "Она наклоняется к экрану. Потом ещё ближе."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:522
translate russian cupid_angela_bruce_minami_05_40283da7:
    angela.say "Она похожа на меня."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:523
translate russian cupid_angela_bruce_minami_05_dd51412c:
    angela.say "На двадцать лет моложе, такой я была в колледже. Но это не могу быть я."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:525
translate russian cupid_angela_bruce_minami_05_3a4e1082:
    angela.say "Я ходила на то шоу с соседкой по комнате. Помню корешки билетов и дождь."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:526
translate russian cupid_angela_bruce_minami_05_d78d4865:
    angela.say "А потом... почему всё, что связано с колледжем, обрывается после того вечера?"

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:528
translate russian cupid_angela_bruce_minami_05_ea2cb3f2:
    angela.say "Он всегда щёлкает этой зажигалкой. А потом говорит..."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:531
translate russian cupid_angela_bruce_minami_05_dc234572:
    minami.say "«Ты выглядишь усталой»."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:533
translate russian cupid_angela_bruce_minami_05_8eb03ec0:
    "Мама вздрагивает, будто эти слова могут её укусить."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:535
translate russian cupid_angela_bruce_minami_05_2b459d9f:
    minami.say "Всё хорошо, мам. Когда это говорю я, это просто слова."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:536
translate russian cupid_angela_bruce_minami_05_76102841:
    minami.say "Они действуют, только когда их говорит он."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:539
translate russian cupid_angela_bruce_minami_05_c5cd5736:
    angela.say "Значит, ничего не было настоящим. Двадцать лет — и всё ненастоящее."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:541
translate russian cupid_angela_bruce_minami_05_bef78522:
    "[minami.name] кладёт голову маме на плечо, как делала, когда была маленькой."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:543
translate russian cupid_angela_bruce_minami_05_cd5c713c:
    angela.say "Нет. Это ведь неправда?"

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:544
translate russian cupid_angela_bruce_minami_05_44b43b99:
    angela.say "Он мог заставить меня любить его. Но заставить меня любить вас двоих он не смог бы никогда."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:545
translate russian cupid_angela_bruce_minami_05_d034790e:
    angela.say "Это было только моё."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:548
translate russian cupid_angela_bruce_minami_05_2d5104d9:
    "[minami.name] больше не пытается сдерживать слёзы, да и я держусь не намного лучше."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:550
translate russian cupid_angela_bruce_minami_05_7565fbfe:
    "И тут кто-то начинает колотить во входную дверь."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:553
translate russian cupid_angela_bruce_minami_05_16aa99f8:
    "Dylan" "Открывайте, детки! Я знаю, что ваша мама там."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:554
translate russian cupid_angela_bruce_minami_05_4fa6a5c9:
    "Dylan" "Удивительно, сколько всего сейчас можно узнать по телефону, правда?"

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:555
translate russian cupid_angela_bruce_minami_05_b3df8c40:
    mike.say "Побудь с мамой."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:559
translate russian cupid_angela_bruce_minami_05_7a2bc880:
    "Я приоткрываю дверь на цепочке, и отец налегает на неё плечом так сильно, что цепочку вырывает из косяка."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:560
translate russian cupid_angela_bruce_minami_05_9270201c:
    "Он проходит мимо меня прямо в гостиную."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:570
translate russian cupid_angela_bruce_minami_05_1a8a4fe5:
    "Dylan" "Анджела, любовь моя. Ты выглядишь усталой."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:574
translate russian cupid_angela_bruce_minami_05_733f21a5:
    "Ничего не происходит."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:576
translate russian cupid_angela_bruce_minami_05_05507f9b:
    "Мама просто смотрит на него — спокойно и совершенно бодро."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:578
translate russian cupid_angela_bruce_minami_05_8c3beb0b:
    angela.say "Нет, Дилан. Не выгляжу."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:581
translate russian cupid_angela_bruce_minami_05_fc960585:
    "Впервые в жизни я вижу, как отец не знает, что делать дальше."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:583
translate russian cupid_angela_bruce_minami_05_52ab82c1:
    "Dylan" "Тогда попробуем на детях!"

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:585
translate russian cupid_angela_bruce_minami_05_54a63d7d:
    "Он направляет зажигалку на [minami.name]."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:586
translate russian cupid_angela_bruce_minami_05_155ec66c:
    "Её рука молниеносно взлетает, ловко, как в карточном фокусе, и его пальцы смыкаются на пустоте."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:588
translate russian cupid_angela_bruce_minami_05_390af4a4:
    "Когда она разжимает кулак, зажигалка лежит у неё на ладони."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:590
translate russian cupid_angela_bruce_minami_05_0c3af994:
    minami.say "Этому ты меня тоже научил, пап."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:591
translate russian cupid_angela_bruce_minami_05_3b9dccc5:
    minami.say "Когда мне было десять."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:594
translate russian cupid_angela_bruce_minami_05_a3ad0803:
    "Отец бросается за ней. Я встаю между ними, и он отскакивает от меня, будто забыл, какой я теперь большой."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:598
translate russian cupid_angela_bruce_minami_05_959a83dd:
    "Второго шанса я ему не дам."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:600
translate russian cupid_angela_bruce_minami_05_834559c4:
    "Одной рукой набираю номер, а другую держу у него на груди."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:601
translate russian cupid_angela_bruce_minami_05_35703a29:
    mike.say "Полиция? Ко мне в дом только что вломился мужчина. Он не уходит и угрожает моей матери."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:602
translate russian cupid_angela_bruce_minami_05_136de0ac:
    "Диспетчер спрашивает, пострадал ли кто-нибудь. Я смотрю на маму и решаю, что это долгая история."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:604
translate russian cupid_angela_bruce_minami_05_44b86964:
    angela.say "Мог бы позволить это сделать мне, [hero.name]."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:606
translate russian cupid_angela_bruce_minami_05_777a3670:
    mike.say "Прости, мам. В следующий раз."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:608
translate russian cupid_angela_bruce_minami_05_e3ac9a58:
    angela.say "Следующего раза не будет, милый. В этом-то всё и дело."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:611
translate russian cupid_angela_bruce_minami_05_b724fb4e:
    "Мама достаёт телефон раньше, чем я успеваю потянуться за своим."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:612
translate russian cupid_angela_bruce_minami_05_da7d3fef:
    "Это первое, что она делает за двадцать лет, ни у кого не спросив, и руки у неё ни разу не дрогнут."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:615
translate russian cupid_angela_bruce_minami_05_799c06a7:
    angela.say "Да, полицию, пожалуйста. Мой муж вломился в дом моего сына."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:616
translate russian cupid_angela_bruce_minami_05_e738f483:
    angela.say "Нет, я совершенно уверена. Я хочу, чтобы его увели. А потом я хотела бы поговорить кое с кем о последних двадцати годах."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:619
translate russian cupid_angela_bruce_minami_05_0312b66d:
    "Полиция приезжает минут через десять, и всё это время отец не произносит ни слова."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:620
translate russian cupid_angela_bruce_minami_05_c7696294:
    "Он просто смотрит на зажигалку в руке у [minami.name]."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:621
translate russian cupid_angela_bruce_minami_05_63b546b0:
    "Officer" "Это нам понадобится как улика, мисс."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:623
translate russian cupid_angela_bruce_minami_05_aabec94c:
    minami.say "Забирайте. Пожалуйста."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:626
translate russian cupid_angela_bruce_minami_05_3b6ee42c:
    "Его выводят в наручниках. Он не оглядывается."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:628
translate russian cupid_angela_bruce_minami_05_1517bddc:
    "А потом [minami.name] и мама обнимают друг друга посреди комнаты, и я тоже как-то оказываюсь там."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:630
translate russian cupid_angela_bruce_minami_05_753db165:
    angela.say "Мои малыши. Мои умные, упрямые малыши."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:641
translate russian cupid_angela_bruce_minami_ending_e65b6227:
    "На этот раз мама стучит, прежде чем войти. Она превращает это в шутку, но я вижу, что она всерьёз."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:645
translate russian cupid_angela_bruce_minami_ending_40d9f81b:
    angela.say "Привет, мои дорогие!"

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:647
translate russian cupid_angela_bruce_minami_ending_829a1cdf:
    "Она принесла печенье из пекарни на углу, и на ней пальто, которого я никогда раньше не видел."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:649
translate russian cupid_angela_bruce_minami_ending_81298df1:
    angela.say "Я купила его сама. Нравится?"

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:650
translate russian cupid_angela_bruce_minami_ending_13f026d7:
    angela.say "Одежду мне всегда выбирал ваш отец. Я даже не замечала."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:653
translate russian cupid_angela_bruce_minami_ending_421d33c7:
    minami.say "Оно шикарное, мам."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:655
translate russian cupid_angela_bruce_minami_ending_a8594c1a:
    "Пока мама живёт у старой подруги по колледжу. Той самой соседки по комнате — с корешками билетов и дождём."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:656
translate russian cupid_angela_bruce_minami_ending_c79fba63:
    "Она нашла её номер в коробке из подвала, и они проговорили по телефону четыре часа."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:658
translate russian cupid_angela_bruce_minami_ending_9ed6a07d:
    angela.say "Я поговорила с юристом насчёт развода."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:659
translate russian cupid_angela_bruce_minami_ending_2a99d210:
    angela.say "А в полиции говорят, что вашего отца будут держать под стражей до суда. Зажигалка лежит в пакете для улик."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:661
translate russian cupid_angela_bruce_minami_ending_034ebfb4:
    angela.say "Сначала они не поверили ни слову про гипноз, но помогли больничные записи."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:664
translate russian cupid_angela_bruce_minami_ending_ca21e594:
    angela.say "И в следующий раз, когда в моей жизни что-то понадобится сделать, [hero.name], трубку возьму я сама."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:666
translate russian cupid_angela_bruce_minami_ending_d54049f3:
    mike.say "Договорились."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:668
translate russian cupid_angela_bruce_minami_ending_4459088a:
    minami.say "А что с Брюсом?"

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:670
translate russian cupid_angela_bruce_minami_ending_4848f042:
    "Мама смеётся и слегка розовеет."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:672
translate russian cupid_angela_bruce_minami_ending_887eea7b:
    angela.say "Он прислал цветы. Слишком уж много."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:673
translate russian cupid_angela_bruce_minami_ending_59b2f5e6:
    angela.say "Я позвонила поблагодарить его и сказала ему правду."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:674
translate russian cupid_angela_bruce_minami_ending_b7d972a9:
    angela.say "Двадцать лет я была той, кем меня хотел видеть кто-то другой."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:675
translate russian cupid_angela_bruce_minami_ending_c58348f6:
    angela.say "Прежде чем снова стать для кого-то кем-то, я хочу понять, кто я такая."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:677
translate russian cupid_angela_bruce_minami_ending_d1610d5a:
    "Потом она поворачивается к [minami.name], и её лицо становится серьёзным."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:679
translate russian cupid_angela_bruce_minami_ending_2d0afcf1:
    angela.say "Солнышко, ваш отец говорил о тебе всякое. О том, что мы тебя выбрали."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:680
translate russian cupid_angela_bruce_minami_ending_80892e3b:
    angela.say "Никто не выбирал тебя ни для кого."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:681
translate russian cupid_angela_bruce_minami_ending_040a7ec1:
    angela.say "Я хотела дочку, и мне досталась самая лучшая. Вот и вся история."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:684
translate russian cupid_angela_bruce_minami_ending_5f33705c:
    "[minami.name] издаёт звук — наполовину смех, наполовину всхлип — и утыкается лицом в новое мамино пальто."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:687
translate russian cupid_angela_bruce_minami_ending_a1b186b1:
    "Позже, когда мама уходит, [minami.name] застаёт меня за разглядыванием отцовской книги."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:689
translate russian cupid_angela_bruce_minami_ending_9fac5179:
    minami.say "Сожжёшь её?"

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:691
translate russian cupid_angela_bruce_minami_ending_66a974fc:
    mike.say "Я думал об этом."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:692
translate russian cupid_angela_bruce_minami_ending_cc8091a1:
    mike.say "Но она может понадобиться полиции. И если он когда-нибудь выйдет, я хочу знать то, что знает он."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:693
translate russian cupid_angela_bruce_minami_ending_f32a7090:
    "Я запираю её в нижнем ящике и отдаю ключ ей."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:694
translate russian cupid_angela_bruce_minami_ending_a6538d41:
    mike.say "Храни его у себя."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:696
translate russian cupid_angela_bruce_minami_ending_ea33a755:
    minami.say "Как вазу?"

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:698
translate russian cupid_angela_bruce_minami_ending_84fe13b0:
    mike.say "Точно как вазу."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:701
translate russian cupid_angela_bruce_minami_ending_fc41ced7:
    "Остаток дня мы едим печенье и слушаем мамины рассказы о колледже."

# dlc_cupid/ch/cupid/angela_bruce/minami.rpy:702
translate russian cupid_angela_bruce_minami_ending_2eeac585:
    "Половина историй для неё самой в новинку. Она рассказывает их так, будто разворачивает подарки."

# dlc_cupid/ch/cupid/anna_gwen/aftermath.rpy:48
translate russian cupid_anna_gwen_aftermath_2ae6131d:
    "В кофейне пахнет пригоревшим молоком и корицей, а очередь тянется до самой двери."

# dlc_cupid/ch/cupid/anna_gwen/aftermath.rpy:49
translate russian cupid_anna_gwen_aftermath_70c2eea7:
    "Передо мной у стойки ещё трое, когда чей-то палец цепляется за шлёвку моего ремня и дёргает."

# dlc_cupid/ch/cupid/anna_gwen/aftermath.rpy:51
translate russian cupid_anna_gwen_aftermath_70690cae:
    anna.say "Попался!"

# dlc_cupid/ch/cupid/anna_gwen/aftermath.rpy:53
translate russian cupid_anna_gwen_aftermath_88cfacfa:
    anna.say "Я уже заказала тебе. Не знала, что ты пьёшь, так что угадывала."

# dlc_cupid/ch/cupid/anna_gwen/aftermath.rpy:54
translate russian cupid_anna_gwen_aftermath_5cd78429:
    anna.say "Если не угадала, всё равно выпьешь."

# dlc_cupid/ch/cupid/anna_gwen/aftermath.rpy:56
translate russian cupid_anna_gwen_aftermath_3956045e:
    "Она суёт мне в руку стакан и уводит к угловому столику, прежде чем я успеваю возразить."

# dlc_cupid/ch/cupid/anna_gwen/aftermath.rpy:57
translate russian cupid_anna_gwen_aftermath_e95d6644:
    "В последний раз, когда я её видел, она искала под моей кроватью второй сапог и хихикала непонятно над чем."

# dlc_cupid/ch/cupid/anna_gwen/aftermath.rpy:58
translate russian cupid_anna_gwen_aftermath_c83a9a24:
    "Теперь она сидит напротив, обхватив кружку обеими руками, и не смеётся."

# dlc_cupid/ch/cupid/anna_gwen/aftermath.rpy:60
translate russian cupid_anna_gwen_aftermath_59034e89:
    anna.say "Вот."

# dlc_cupid/ch/cupid/anna_gwen/aftermath.rpy:61
translate russian cupid_anna_gwen_aftermath_abce0d98:
    anna.say "Мы будем об этом говорить или так и будем сидеть и странно друг на друга пялиться?"

# dlc_cupid/ch/cupid/anna_gwen/aftermath.rpy:63
translate russian cupid_anna_gwen_aftermath_3e71591d:
    mike.say "О какой части?"

# dlc_cupid/ch/cupid/anna_gwen/aftermath.rpy:67
translate russian cupid_anna_gwen_aftermath_dc1cbb8b:
    anna.say "О той, где ты подстроил мне встречу в том клубе."

# dlc_cupid/ch/cupid/anna_gwen/aftermath.rpy:68
translate russian cupid_anna_gwen_aftermath_331a5c02:
    anna.say "Мы с Гвен вычислили это в такси. Она считает, что у тебя где-то висит доска с нашими именами."

# dlc_cupid/ch/cupid/anna_gwen/aftermath.rpy:70
translate russian cupid_anna_gwen_aftermath_eaf71943:
    anna.say "И ведь сработало, [lssb_anna.hero_name()]. Она была милой. Это была прежняя Гвен, та, в которую я влюбилась."

# dlc_cupid/ch/cupid/anna_gwen/aftermath.rpy:72
translate russian cupid_anna_gwen_aftermath_7071c479:
    anna.say "А потом я оказалась в твоей постели. Вот это объясни."

# dlc_cupid/ch/cupid/anna_gwen/aftermath.rpy:74
translate russian cupid_anna_gwen_aftermath_034c0db9:
    mike.say "Я как раз надеялся, что ты объяснишь это мне."

# dlc_cupid/ch/cupid/anna_gwen/aftermath.rpy:76
translate russian cupid_anna_gwen_aftermath_3db08c89:
    "Можно было бы прикинуться дурачком. Но получилось бы у меня ужасно."

# dlc_cupid/ch/cupid/anna_gwen/aftermath.rpy:77
translate russian cupid_anna_gwen_aftermath_04467219:
    mike.say "Сначала мне нужно кое-что тебе рассказать, и ты будешь смеяться."

# dlc_cupid/ch/cupid/anna_gwen/aftermath.rpy:78
translate russian cupid_anna_gwen_aftermath_c34f8faf:
    mike.say "Тот вечер в «Винчестере», когда ты рассказывала мне о своём старом клубе? Я делал заметки."

# dlc_cupid/ch/cupid/anna_gwen/aftermath.rpy:79
translate russian cupid_anna_gwen_aftermath_d8d5d712:
    mike.say "У меня был целый план. Группа идёт развлечься, Гвен совершенно случайно там же, а я весь такой невинный."

# dlc_cupid/ch/cupid/anna_gwen/aftermath.rpy:81
translate russian cupid_anna_gwen_aftermath_3bc65e16:
    anna.say "Ты пытался снова свести меня с Гвен?"

# dlc_cupid/ch/cupid/anna_gwen/aftermath.rpy:83
translate russian cupid_anna_gwen_aftermath_f4e92757:
    mike.say "Такая была идея."

# dlc_cupid/ch/cupid/anna_gwen/aftermath.rpy:85
translate russian cupid_anna_gwen_aftermath_02a859a7:
    "Она хохочет так громко, что парень за соседним столиком отрывается от ноутбука."

# dlc_cupid/ch/cupid/anna_gwen/aftermath.rpy:87
translate russian cupid_anna_gwen_aftermath_bf0a978f:
    anna.say "А вместо этого затащил к себе меня!"

# dlc_cupid/ch/cupid/anna_gwen/aftermath.rpy:90
translate russian cupid_anna_gwen_aftermath_2b0e630e:
    anna.say "Купидон должен стрелять в других, [lssb_anna.hero_name()]. А не в себя."

# dlc_cupid/ch/cupid/anna_gwen/aftermath.rpy:92
translate russian cupid_anna_gwen_aftermath_9c82b435:
    "Она наклоняется ближе и понижает голос — для Анны это значит, что её всё ещё слышит полкофейни."

# dlc_cupid/ch/cupid/anna_gwen/aftermath.rpy:94
translate russian cupid_anna_gwen_aftermath_ac8af5c4:
    anna.say "Гвен будет из-за этого невыносимой. Ты же понимаешь?"

# dlc_cupid/ch/cupid/anna_gwen/aftermath.rpy:95
translate russian cupid_anna_gwen_aftermath_c3e6e7af:
    anna.say "Она узнает, она всегда узнаёт. И будет вести себя как последняя стерва."

# dlc_cupid/ch/cupid/anna_gwen/aftermath.rpy:97
translate russian cupid_anna_gwen_aftermath_532664f3:
    anna.say "А мне как-то плевать. Вот это меня и пугает."

# dlc_cupid/ch/cupid/anna_gwen/aftermath.rpy:99
translate russian cupid_anna_gwen_aftermath_054e6caf:
    "Она смотрит на меня поверх стакана, будто теперь я должен сказать что-то важное."

# dlc_cupid/ch/cupid/anna_gwen/aftermath.rpy:102
translate russian cupid_anna_gwen_aftermath_32dfefee:
    mike.say "У Гвен был шанс с тобой, Анна."

# dlc_cupid/ch/cupid/anna_gwen/aftermath.rpy:103
translate russian cupid_anna_gwen_aftermath_88b45f65:
    mike.say "Я ухожу из бизнеса свах. Всё равно у меня это паршиво получалось."

# dlc_cupid/ch/cupid/anna_gwen/aftermath.rpy:105
translate russian cupid_anna_gwen_aftermath_a1068863:
    "Её лицо так и светится. Она пытается спрятать это за кружкой, но ничего не выходит."

# dlc_cupid/ch/cupid/anna_gwen/aftermath.rpy:108
translate russian cupid_anna_gwen_aftermath_da6a5378:
    anna.say "Ладно, круто. Это... да, хорошо."

# dlc_cupid/ch/cupid/anna_gwen/aftermath.rpy:109
translate russian cupid_anna_gwen_aftermath_51b6a746:
    anna.say "Очень по-взрослому, Купидон. Принимаю твою отставку."

# dlc_cupid/ch/cupid/anna_gwen/aftermath.rpy:111
translate russian cupid_anna_gwen_aftermath_c9602e3f:
    anna.say "Но с чёрного хода тебе больше не прокрасться. В переносном смысле, я имею в виду."

# dlc_cupid/ch/cupid/anna_gwen/aftermath.rpy:112
translate russian cupid_anna_gwen_aftermath_647232e8:
    anna.say "А в буквальном — можно обсудить."

# dlc_cupid/ch/cupid/anna_gwen/aftermath.rpy:114
translate russian cupid_anna_gwen_aftermath_0af4c858:
    mike.say "Принято."

# dlc_cupid/ch/cupid/anna_gwen/aftermath.rpy:116
translate russian cupid_anna_gwen_aftermath_21c142cf:
    mike.say "Это я заварил всю эту кашу с Гвен. Дай мне хотя бы закончить по-нормальному."

# dlc_cupid/ch/cupid/anna_gwen/aftermath.rpy:117
translate russian cupid_anna_gwen_aftermath_53f83676:
    mike.say "Если между вами ещё что-то есть, я не хочу быть причиной, по которой вы этого так и не узнаете."

# dlc_cupid/ch/cupid/anna_gwen/aftermath.rpy:119
translate russian cupid_anna_gwen_aftermath_a1f6da17:
    "Улыбка тут же сползает с её лица."

# dlc_cupid/ch/cupid/anna_gwen/aftermath.rpy:121
translate russian cupid_anna_gwen_aftermath_5db68937:
    anna.say "Ты сейчас серьёзно?"

# dlc_cupid/ch/cupid/anna_gwen/aftermath.rpy:122
translate russian cupid_anna_gwen_aftermath_b0dbe21e:
    anna.say "Ты спишь со мной, а при следующей встрече пытаешься вернуть меня ей?"

# dlc_cupid/ch/cupid/anna_gwen/aftermath.rpy:124
translate russian cupid_anna_gwen_aftermath_46e2b937:
    anna.say "Я тебе не библиотечная книга, [lssb_anna.hero_name()]."

# dlc_cupid/ch/cupid/anna_gwen/aftermath.rpy:127
translate russian cupid_anna_gwen_aftermath_19868852:
    "Она долго смотрит в свой кофе."

# dlc_cupid/ch/cupid/anna_gwen/aftermath.rpy:129
translate russian cupid_anna_gwen_aftermath_2a11a46e:
    anna.say "Мне не нужна сваха. Что бы там у нас с Гвен ни оставалось, с этим я покончила."

# dlc_cupid/ch/cupid/anna_gwen/aftermath.rpy:130
translate russian cupid_anna_gwen_aftermath_4f7e0688:
    anna.say "Когда поймёшь, чего ты на самом деле хочешь, позови меня. Меня. Не для кого-то ещё."

# dlc_cupid/ch/cupid/anna_gwen/aftermath.rpy:135
translate russian cupid_anna_gwen_aftermath_1f3dcc3d:
    anna.say "И своди меня куда-нибудь, где есть скатерти. На настоящее свидание, где официант смотрит на нас с осуждением."

# dlc_cupid/ch/cupid/anna_gwen/aftermath.rpy:136
translate russian cupid_anna_gwen_aftermath_fc7f8a40:
    anna.say "Хочу свечи и крошечные порции. Я заслужила крошечные порции."

# dlc_cupid/ch/cupid/anna_gwen/aftermath.rpy:140
translate russian cupid_anna_gwen_aftermath_e63e5b95:
    anna.say "И звонить будешь ты. Я не собираюсь бегать за парнем, который раньше был моим помощником в съёме."

# dlc_cupid/ch/cupid/anna_gwen/aftermath.rpy:142
translate russian cupid_anna_gwen_aftermath_d08174e5:
    "Она допивает кофе, целует меня в щёку, проходя мимо, и оставляет меня с напитком, который я сам ни за что бы не заказал."

# dlc_cupid/ch/cupid/anna_gwen/aftermath.rpy:143
translate russian cupid_anna_gwen_aftermath_c13ec08b:
    "А он вполне неплох."

# dlc_cupid/ch/cupid/anna_gwen/event.rpy:982
translate russian cupid_anna_gwen_ending_358eda64:
    "Успокоить её было бы проще, если бы двадцать минут назад в Номере 12 она не натягивала обратно это платье."

# dlc_cupid/ch/cupid/anna_gwen/event.rpy:984
translate russian cupid_anna_gwen_ending_0207e2f1:
    anna.say "И поправь воротник, пока никто не спросил, почему он перекошен."

# dlc_cupid/ch/cupid/anna_gwen/event.rpy:1028
translate russian cupid_anna_gwen_ending_8feac5da:
    "Полчаса назад мои руки были на этом платье — я расстёгивал на нём молнию."

# dlc_cupid/ch/cupid/anna_gwen/event.rpy:1029
translate russian cupid_anna_gwen_ending_92af16a9:
    "А теперь я иду за ним по проходу и понятия не имею, куда девать глаза."

# dlc_cupid/ch/cupid/anna_gwen/event.rpy:1088
translate russian cupid_anna_gwen_ending_b7a809e5:
    "Все остальные смеются. А я смотрю на затылок Анны, туда, где начинается молния."

# dlc_cupid/ch/cupid/anna_gwen/event.rpy:1095
translate russian cupid_anna_gwen_ending_ac0697ec:
    "Я держу рот на замке. Глаза Анны на полсекунды перескакивают на меня поверх плеча Гвен и возвращаются к священнику."

# dlc_cupid/ch/cupid/anna_gwen/event.rpy:1096
translate russian cupid_anna_gwen_ending_df9f2544:
    "Что случилось в Номере 12, остаётся в Номере 12."

# dlc_cupid/ch/cupid/anna_gwen/wedding.rpy:23
translate russian cupid_anna_gwen_wedding_before_ce3c566f:
    "До церемонии сорок минут, а церковь уже заполняется гостями со стороны Гвен."

# dlc_cupid/ch/cupid/anna_gwen/wedding.rpy:24
translate russian cupid_anna_gwen_wedding_before_4df73420:
    "В кармане пиджака вибрирует телефон. Это Анна."

# dlc_cupid/ch/cupid/anna_gwen/wedding.rpy:25
translate russian cupid_anna_gwen_wedding_before_9ed44176:
    "Дуй сюда. ЧП С МОЛНИЕЙ. Номер 12. Приходи один, зрелище не из приятных."

# dlc_cupid/ch/cupid/anna_gwen/wedding.rpy:26
translate russian cupid_anna_gwen_wedding_before_c6cdf3dc:
    "Отель прямо через дорогу. Но Саша сидит ближе к двери, чем я, и она застёгивала сотню сценических нарядов Анны."

# dlc_cupid/ch/cupid/anna_gwen/wedding.rpy:32
translate russian cupid_anna_gwen_wedding_before_46048661:
    "Я ловлю взгляд Саши и показываю ей телефон. Она читает сообщение, закатывает глаза и направляется к двери."

# dlc_cupid/ch/cupid/anna_gwen/wedding.rpy:33
translate russian cupid_anna_gwen_wedding_before_533ce3f8:
    "Анна в надёжных руках. Наверное, в более надёжных, чем мои."

# dlc_cupid/ch/cupid/anna_gwen/wedding.rpy:40
translate russian cupid_anna_gwen_wedding_fuck_2fea21bc:
    "Анна впускает меня ещё до того, как я заканчиваю стучать, захлопывает дверь спиной и прислоняется к ней."

# dlc_cupid/ch/cupid/anna_gwen/wedding.rpy:41
translate russian cupid_anna_gwen_wedding_fuck_6c4733fc:
    "Платье — всё, что она обещала, если не считать щели вдоль позвоночника там, где сдалась молния."

# dlc_cupid/ch/cupid/anna_gwen/wedding.rpy:43
translate russian cupid_anna_gwen_wedding_fuck_a04f12ce:
    anna.say "Она разошлась. Просто разошлась, [lssb_anna.hero_name()]. Я вдохнула, и всё — пуф."

# dlc_cupid/ch/cupid/anna_gwen/wedding.rpy:44
translate russian cupid_anna_gwen_wedding_fuck_dbcbe77b:
    anna.say "Гвен скажет, что я растолстела. Вслух не скажет. Скажет бровями."

# dlc_cupid/ch/cupid/anna_gwen/wedding.rpy:46
translate russian cupid_anna_gwen_wedding_fuck_11347f62:
    mike.say "Повернись. Дай посмотреть."

# dlc_cupid/ch/cupid/anna_gwen/wedding.rpy:47
translate russian cupid_anna_gwen_wedding_fuck_c0b1daa0:
    "Она поворачивается. С молнией всё в порядке, просто зубчики соскочили с дорожки на пару сантиметров выше поясницы."

# dlc_cupid/ch/cupid/anna_gwen/wedding.rpy:48
translate russian cupid_anna_gwen_wedding_fuck_145a6fff:
    "Я возвращаю их на место ногтем большого пальца. Это занимает секунды четыре."

# dlc_cupid/ch/cupid/anna_gwen/wedding.rpy:49
translate russian cupid_anna_gwen_wedding_fuck_d9422131:
    "А потом моя рука так и остаётся лежать на её голой спине, и никто из нас ничего об этом не говорит."

# dlc_cupid/ch/cupid/anna_gwen/wedding.rpy:51
translate russian cupid_anna_gwen_wedding_fuck_0bf33f21:
    anna.say "...Ты её починил."

# dlc_cupid/ch/cupid/anna_gwen/wedding.rpy:53
translate russian cupid_anna_gwen_wedding_fuck_353fe60a:
    mike.say "Ходил."

# dlc_cupid/ch/cupid/anna_gwen/wedding.rpy:55
translate russian cupid_anna_gwen_wedding_fuck_b9764772:
    anna.say "Так что можешь идти."

# dlc_cupid/ch/cupid/anna_gwen/wedding.rpy:57
translate russian cupid_anna_gwen_wedding_fuck_402c673c:
    "Она не двигается. Я тоже."

# dlc_cupid/ch/cupid/anna_gwen/wedding.rpy:59
translate russian cupid_anna_gwen_wedding_fuck_bb8bd9c8:
    anna.say "Можно скажу одну глупость? Я всё вспоминаю тот вечер в «Винчестере»."

# dlc_cupid/ch/cupid/anna_gwen/wedding.rpy:60
translate russian cupid_anna_gwen_wedding_fuck_a0f47da7:
    anna.say "Это с тобой я должна была в итоге оказаться. В моих мыслях. До всего этого."

# dlc_cupid/ch/cupid/anna_gwen/wedding.rpy:62
translate russian cupid_anna_gwen_wedding_fuck_822a8f37:
    anna.say "А теперь через тридцать пять минут я выхожу замуж, и это твоя рука лежит на мне."

# dlc_cupid/ch/cupid/anna_gwen/wedding.rpy:63
translate russian cupid_anna_gwen_wedding_fuck_372cc88c:
    anna.say "Гвен через две двери отсюда делает причёску. Я слышу через стену, как она смеётся."

# dlc_cupid/ch/cupid/anna_gwen/wedding.rpy:65
translate russian cupid_anna_gwen_wedding_fuck_ceae4395:
    "На имени Гвен её голос запинается, а пальцы на дверной ручке белеют."

# dlc_cupid/ch/cupid/anna_gwen/wedding.rpy:66
translate russian cupid_anna_gwen_wedding_fuck_cbd6d919:
    mike.say "Скажи мне уйти, Анна, и я уйду."

# dlc_cupid/ch/cupid/anna_gwen/wedding.rpy:68
translate russian cupid_anna_gwen_wedding_fuck_4e10c7d6:
    anna.say "Ты мой шафер, [lssb_anna.hero_name()]. Ты должен делать всё, что хочет невеста."

# dlc_cupid/ch/cupid/anna_gwen/wedding.rpy:70
translate russian cupid_anna_gwen_wedding_fuck_f794210f:
    "Она заводит руку за спину и сама расстёгивает молнию до конца."

# dlc_cupid/ch/cupid/anna_gwen/wedding.rpy:72
translate russian cupid_anna_gwen_wedding_fuck_4b3d848a:
    "Платье оседает вокруг её лодыжек, как упавший парашют, и она выходит из него, оставшись только в пирсинге и с ухмылкой."

# dlc_cupid/ch/cupid/anna_gwen/wedding.rpy:74
translate russian cupid_anna_gwen_wedding_fuck_d619e531:
    anna.say "Только посмей что-нибудь пролить на платье."

# dlc_cupid/ch/cupid/anna_gwen/wedding.rpy:75
translate russian cupid_anna_gwen_wedding_fuck_51a0f5a8:
    anna.say "Снимать его с меня должна Гвен. Сегодня вечером, после тостов."

# dlc_cupid/ch/cupid/anna_gwen/wedding.rpy:77
translate russian cupid_anna_gwen_wedding_fuck_e4b030aa:
    anna.say "Почему от того, что я сказала это вслух, стало только лучше?"

# dlc_cupid/ch/cupid/anna_gwen/wedding.rpy:80
translate russian cupid_anna_gwen_wedding_fuck_cdefd5f3:
    mike.say "Лицом к стене. Ладони на неё."

# dlc_cupid/ch/cupid/anna_gwen/wedding.rpy:82
translate russian cupid_anna_gwen_wedding_fuck_1f0623d4:
    anna.say "Да, шафер."

# dlc_cupid/ch/cupid/anna_gwen/wedding.rpy:84
translate russian cupid_anna_gwen_wedding_fuck_d69e2ca3:
    "Она упирается ладонями в обои рядом с зеркалом, выгибает спину и смотрит на меня через плечо в отражении."

# dlc_cupid/ch/cupid/anna_gwen/wedding.rpy:87
translate russian cupid_anna_gwen_wedding_fuck_a4362655:
    anna.say "Просто скажи, как ты меня хочешь. Сегодня я не хочу решать вообще ничего."

# dlc_cupid/ch/cupid/anna_gwen/wedding.rpy:89
translate russian cupid_anna_gwen_wedding_fuck_a35f90f2:
    "Когда она это говорит, её плечи опускаются, будто выбор был самой тяжёлой частью платья."

# dlc_cupid/ch/cupid/anna_gwen/wedding.rpy:92
translate russian cupid_anna_gwen_wedding_fuck_97d8486e:
    "Я подхожу сзади так близко, что она чувствует меня раньше, чем мои руки."

# dlc_cupid/ch/cupid/anna_gwen/wedding.rpy:93
translate russian cupid_anna_gwen_wedding_fuck_a62998db:
    "Её волосы пахнут лаком и цветами апельсина, которые кто-то утром приколол ей за ухо."

# dlc_cupid/ch/cupid/anna_gwen/wedding.rpy:94
translate russian cupid_anna_gwen_wedding_fuck_c9bbe248:
    "Я берусь одной рукой за её бедро и медленно провожу собой по её влажности. У стены у неё перехватывает дыхание."

# dlc_cupid/ch/cupid/anna_gwen/wedding.rpy:96
translate russian cupid_anna_gwen_wedding_fuck_7451014b:
    anna.say "Боже мой. Мы правда это делаем."

# dlc_cupid/ch/cupid/anna_gwen/wedding.rpy:97
translate russian cupid_anna_gwen_wedding_fuck_7d4708b8:
    anna.say "В свадебном люксе. Пока внизу в холодильнике стоит торт."

# dlc_cupid/ch/cupid/anna_gwen/wedding.rpy:98
translate russian cupid_anna_gwen_wedding_fuck_de0b0c10:
    anna.say "Двадцать восемь минут. Я считаю. Я ужасный человек и всё равно считаю."

# dlc_cupid/ch/cupid/anna_gwen/wedding.rpy:100
translate russian cupid_anna_gwen_wedding_fuck_2804d72e:
