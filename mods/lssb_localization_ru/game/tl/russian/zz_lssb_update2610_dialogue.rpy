# dlc_cupid/ch/cupid/palla_shawn/aftermath.rpy:139
translate russian cupid_palla_shawn_aftermath_1bc7f7c7:
    shawn.say "Хм. Я бы всё спланировал."

# dlc_cupid/ch/cupid/palla_shawn/aftermath.rpy:140
translate russian cupid_palla_shawn_aftermath_8fe2613a:
