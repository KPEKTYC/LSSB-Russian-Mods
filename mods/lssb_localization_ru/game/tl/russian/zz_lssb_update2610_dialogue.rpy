# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:343
translate russian office_audrey_initiative_cold_open_9d2ac381:
    mike.say "Одри, что это?"

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:345
translate russian office_audrey_initiative_cold_open_d4aea22f:
    audrey.say "Это я веду себя как хорошая девочка, [lssb_audrey.hero_name()]."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:348
translate russian office_audrey_initiative_cold_open_897ab3aa:
    "Она поддевает пальцем ошейник на шее и с гордостью слегка его тянет."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:350
translate russian office_audrey_initiative_cold_open_f8fa6bd8:
    audrey.say "Твоя игрушка тут подумала."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:352
translate russian office_audrey_initiative_cold_open_5696103c:
    audrey.say "Твоя хорошая девочка тут подумала."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:353
translate russian office_audrey_initiative_cold_open_2500fe96:
    audrey.say "Ты слишком много работаешь. У тебя стресс. И одной меня, чтобы это исправить, просто не хватает."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:355
translate russian office_audrey_initiative_cold_open_08cd2537:
    "Щёлк. Второй слайд."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:356
translate russian office_audrey_initiative_cold_open_3e7718f5:
    "Оргструктура. Наверху моё имя."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:357
translate russian office_audrey_initiative_cold_open_a2e12e66:
    "Под ним имя Одри, а рядом нарисована маленькая корона."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:358
translate russian office_audrey_initiative_cold_open_0d91b978:
    "А под ним три пустые ячейки с подписью «Уточняется (горячие)»."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:359
translate russian office_audrey_initiative_cold_open_371b8676:
    mike.say "..."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:360
translate russian office_audrey_initiative_cold_open_17ee0504:
    mike.say "Одри, нет."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:362
translate russian office_audrey_initiative_cold_open_a9fd4842:
    audrey.say "Одри, ДА."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:364
translate russian office_audrey_initiative_cold_open_477bbb52:
    audrey.say "Я два года была бесполезна на этой работе, босс."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:365
translate russian office_audrey_initiative_cold_open_ae96d0a8:
    audrey.say "Я наконец-то нашла проект, в котором я хороша. Только попробуй его у меня отнять."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:367
translate russian office_audrey_initiative_cold_open_0811d276:
    "Прежде чем я успеваю подобрать слова, она уже уходит."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:369
translate russian office_audrey_initiative_cold_open_628643ac:
    "Лазерную указку она оставляет на моём столе включённой, и красная точка дрожит на стене."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:376
translate russian office_audrey_initiative_shiori_01_7c6c97d5:
    "Я дописываю первое письмо за день, когда в дверь робко стучат."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:377
translate russian office_audrey_initiative_shiori_01_31ebbd77:
    "Сиори. Как всегда, минута в минуту."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:378
translate russian office_audrey_initiative_shiori_01_83e8654f:
    mike.say "Входи, Сиори."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:380
translate russian office_audrey_initiative_shiori_01_c42f2875:
    "Она бочком входит с моим кофе в одной руке и листком бумаги в другой."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:381
translate russian office_audrey_initiative_shiori_01_d4c972c7:
    "А прямо за ней, слишком уж непринуждённо, — Одри."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:385
translate russian office_audrey_initiative_shiori_01_079417c5:
    audrey.say "Не обращайте на меня внимания. Я здесь в качестве консультанта."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:388
translate russian office_audrey_initiative_shiori_01_6631928e:
    shiori.say "Доброе утро, [lssb_shiori.hero_name()]!"

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:389
translate russian office_audrey_initiative_shiori_01_8a586bb3:
    shiori.say "Одри сказала, что я должна принести тебе это вместе с кофе."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:390
translate russian office_audrey_initiative_shiori_01_4bc3e2ca:
    shiori.say "Это бумаги из отдела кадров. Очень важные, сказала она."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:392
translate russian office_audrey_initiative_shiori_01_b0f4e21e:
    "Она протягивает листок."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:393
translate russian office_audrey_initiative_shiori_01_9d417b9f:
    "Наверху жирным шрифтом: ФОРМА 69-Б. СОГЛАСИЕ НА ДОПОЛНИТЕЛЬНЫЕ ОБЯЗАННОСТИ ПО УДОВЛЕТВОРЕНИЮ БОССА."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:394
translate russian office_audrey_initiative_shiori_01_14ea2b4b:
    "Внизу подпись. Аккуратным, старательным почерком Сиори."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:395
translate russian office_audrey_initiative_shiori_01_d783f573:
    mike.say "Сиори..."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:396
translate russian office_audrey_initiative_shiori_01_34154c5f:
    mike.say "Ты это прочитала, прежде чем подписать?"

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:398
translate russian office_audrey_initiative_shiori_01_c9c2b180:
    shiori.say "Прочитала?"

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:400
translate russian office_audrey_initiative_shiori_01_d0b53b97:
    shiori.say "Одри сказала, что это просто формальность..."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:403
translate russian office_audrey_initiative_shiori_01_f717b5a1:
    audrey.say "Это И ЕСТЬ формальность. Сексуальная формальность."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:405
translate russian office_audrey_initiative_shiori_01_5b443298:
    "Сиори опускает глаза на форму."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:406
translate russian office_audrey_initiative_shiori_01_90e56d56:
    "Я смотрю, как она читает первую строчку."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:407
translate russian office_audrey_initiative_shiori_01_a6920496:
    "Потом вторую."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:409
translate russian office_audrey_initiative_shiori_01_dd904c86:
    "А потом кофе оказывается у меня на коленях."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:412
translate russian office_audrey_initiative_shiori_01_378c0456:
    mike.say "А-а-а!"

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:414
translate russian office_audrey_initiative_shiori_01_014341d6:
    shiori.say "О боже! О боже, прости, пожалуйста!"

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:415
translate russian office_audrey_initiative_shiori_01_89751955:
    shiori.say "Я такая неуклюжая, прости, прости, пожалуйста!"

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:417
translate russian office_audrey_initiative_shiori_01_fd881669:
    "Она хватает с моего стола пригоршню салфеток и бросается с ними к моей ширинке."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:418
translate russian office_audrey_initiative_shiori_01_d052900d:
    "Ровно туда, куда Одри с самого начала её и направляла."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:420
translate russian office_audrey_initiative_shiori_01_e7447363:
    audrey.say "Видишь? У неё талант."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:422
translate russian office_audrey_initiative_shiori_01_b48c64b4:
    mike.say "Одри. Вон. Сейчас же."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:424
translate russian office_audrey_initiative_shiori_01_a9dad89e:
    audrey.say "Я руководитель программы!"

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:426
translate russian office_audrey_initiative_shiori_01_4433711e:
    mike.say "ВОН."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:428
translate russian office_audrey_initiative_shiori_01_4684d503:
    "Одри уходит, топая и бормоча что-то про вовлечённость заинтересованных сторон."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:430
translate russian office_audrey_initiative_shiori_01_2fd2f12b:
    "Сиори всё ещё стоит на коленях у моего кресла с салфетками в руках, красная до кончиков ушей."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:432
translate russian office_audrey_initiative_shiori_01_bf22cdfd:
    shiori.say "Я не знала, что там написано. Честное слово, не знала."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:433
translate russian office_audrey_initiative_shiori_01_6271aa74:
    shiori.say "Я просто... я всё подписываю. Мне дают бумаги, и я их подписываю."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:435
translate russian office_audrey_initiative_shiori_01_65e4106a:
    mike.say "Знаю. Всё в порядке."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:436
translate russian office_audrey_initiative_shiori_01_f1f99301:
    mike.say "Никто не станет требовать с тебя по форме, которую Одри набрала в обеденный перерыв."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:437
translate russian office_audrey_initiative_shiori_01_14bbfb4e:
    "Она кивает. Но бумагу не отпускает."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:438
translate russian office_audrey_initiative_shiori_01_3cb4d7fc:
    "Её большой палец то и дело проводит по собственной подписи."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:440
translate russian office_audrey_initiative_shiori_01_e6d8cf39:
    shiori.say "Можно тебя кое о чём спросить, [lssb_shiori.hero_name()]?"

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:441
translate russian office_audrey_initiative_shiori_01_b551ae8a:
    shiori.say "Если бы я её прочитала..."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:442
translate russian office_audrey_initiative_shiori_01_fc5c0563:
    shiori.say "Ты бы рассердился? Если бы я всё равно подписала?"

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:446
translate russian office_audrey_initiative_shiori_01_38ebc705:
    mike.say "Нет, Сиори. Я бы не рассердился."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:447
translate russian office_audrey_initiative_shiori_01_62480f60:
    mike.say "Но решать тебе. Не Одри и не мне."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:448
translate russian office_audrey_initiative_shiori_01_a15fe51b:
    mike.say "Возьми её домой. Прочитай как следует. Думай сколько нужно."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:450
translate russian office_audrey_initiative_shiori_01_ac646aff:
    "Она смотрит на меня так, будто ей никто никогда такого не говорил, — и, может, никто и не говорил."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:452
translate russian office_audrey_initiative_shiori_01_1ddf530f:
    shiori.say "Сколько нужно..."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:454
translate russian office_audrey_initiative_shiori_01_83cb74f9:
    shiori.say "Хорошо. Хорошо, я так и сделаю."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:456
translate russian office_audrey_initiative_shiori_01_107eacde:
    "Она складывает форму в крошечный квадратик и прячет в карман."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:457
translate russian office_audrey_initiative_shiori_01_6293cfc7:
    "А потом, уходя, сбивает со стола пустую чашку."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:459
translate russian office_audrey_initiative_shiori_01_cefad4f9:
    shiori.say "Прости!"

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:464
translate russian office_audrey_initiative_shiori_01_c0d0e481:
    mike.say "Забудь про форму, Сиори."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:465
translate russian office_audrey_initiative_shiori_01_a212c233:
    mike.say "Одри иногда заносит. Ты никому ничего не должна."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:467
translate russian office_audrey_initiative_shiori_01_64db5653:
    "По её лицу что-то пробегает. Облегчение, а может, что-то похожее."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:469
translate russian office_audrey_initiative_shiori_01_9994575c:
    shiori.say "Да. Конечно."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:470
translate russian office_audrey_initiative_shiori_01_36e9e9c0:
    shiori.say "Я принесу тебе новый кофе."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:472
translate russian office_audrey_initiative_shiori_01_9b303fe9:
    "Я замечаю, что форму она уносит с собой."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:485
translate russian office_audrey_initiative_lavish_01_c711fcb9:
    "В моём календаре стоит встреча, которую я не помню, чтобы назначал."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:486
translate russian office_audrey_initiative_lavish_01_1f603aad:
    "«Лавиш, обсуждение карьерного пути. Обязательно. Захватить энтузиазм»."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:487
translate russian office_audrey_initiative_lavish_01_4f8eb467:
    "Организатор — Одри."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:489
translate russian office_audrey_initiative_lavish_01_40b989b8:
    "Не успеваю я её отклонить, как в дверь раздаётся чёткий двойной стук."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:490
translate russian office_audrey_initiative_lavish_01_6daf917f:
    mike.say "Заходи."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:492
translate russian office_audrey_initiative_lavish_01_955f95d1:
    "Входит Лавиш с блокнотом, двумя ручками и осанкой человека, готового получить повышение прямо на месте."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:494
translate russian office_audrey_initiative_lavish_01_036718d4:
    "Одри проскальзывает за ней и запирает дверь."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:496
translate russian office_audrey_initiative_lavish_01_840cb463:
    lavish.say "Доброе утро. Насколько я понимаю, речь о моём карьерном пути?"

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:499
translate russian office_audrey_initiative_lavish_01_baedba0e:
    audrey.say "ИМЕННО. Присаживайся, Лавиш. Босс, приглуши свет."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:501
translate russian office_audrey_initiative_lavish_01_5982d6c6:
    mike.say "Я не буду приглушать..."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:503
translate russian office_audrey_initiative_lavish_01_4304b2fc:
    "Она сама приглушает свет."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:504
translate russian office_audrey_initiative_lavish_01_a0226e4d:
    "На экране загорается новый слайд."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:506
translate russian office_audrey_initiative_lavish_01_7a01917c:
    audrey.say "Программа развития лидерских качеств."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:507
translate russian office_audrey_initiative_lavish_01_f548aab4:
    audrey.say "Эксклюзивная возможность для лучших сотрудников поддержать благополучие генерального директора через тесную личную синергию."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:510
translate russian office_audrey_initiative_lavish_01_c4acba14:
    "Лавиш записывает «тесная личная синергия»."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:511
translate russian office_audrey_initiative_lavish_01_2df2fbf7:
    "Потом перестаёт писать."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:513
translate russian office_audrey_initiative_lavish_01_9b4499ce:
    lavish.say "Можно уточнить, что такое синергия?"

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:516
translate russian office_audrey_initiative_lavish_01_671a186b:
    audrey.say "Секс, Лавиш. Это секс. С ним. И иногда со мной. В презентации есть схемы."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:519
translate russian office_audrey_initiative_lavish_01_1211d792:
    "Лавиш поворачивается ко мне с видом стажёрки, которая только что нашла опечатку в годовом отчёте."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:520
translate russian office_audrey_initiative_lavish_01_cc137d9f:
    mike.say "Лавиш, я сам узнал об этой встрече три минуты назад."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:522
translate russian office_audrey_initiative_lavish_01_7d003b01:
    "Она обдумывает это. Потом открывает в блокноте чистую страницу."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:524
translate russian office_audrey_initiative_lavish_01_ca05cdab:
    lavish.say "Хорошо. Тогда давайте разберём всё как следует."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:525
translate russian office_audrey_initiative_lavish_01_a87a7532:
    lavish.say "Пункт первый. Подчинённость. Перед кем я отчитываюсь в этой программе?"

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:528
translate russian office_audrey_initiative_lavish_01_ff9ddc0e:
    audrey.say "Перед ним."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:531
translate russian office_audrey_initiative_lavish_01_7fc1dc49:
    lavish.say "Пункт второй. Оценка эффективности. Как оценивается моё... участие?"

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:534
translate russian office_audrey_initiative_lavish_01_c63634e0:
    audrey.say "С энтузиазмом."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:537
translate russian office_audrey_initiative_lavish_01_c5c74306:
    lavish.say "Пункт третий. Как это повлияет на моё продвижение по службе?"

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:540
translate russian office_audrey_initiative_lavish_01_3ab89fbc:
    audrey.say "Милая, а ЭТО самое приятное..."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:542
translate russian office_audrey_initiative_lavish_01_eebf2e0b:
    mike.say "Никак."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:543
translate russian office_audrey_initiative_lavish_01_f9cac74d:
    "Обе смотрят на меня."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:544
translate russian office_audrey_initiative_lavish_01_af4283ec:
    mike.say "Никак, Лавиш. Абсолютно. Всё, что происходит здесь, не имеет никакого отношения к твоей карьере."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:545
translate russian office_audrey_initiative_lavish_01_314a1d36:
    mike.say "Тебя повысят, когда ты это заслужишь. Ни днём раньше, ни днём позже."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:547
translate russian office_audrey_initiative_lavish_01_a6484fad:
    audrey.say "Босс, ты убиваешь моё ценностное предложение!"

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:549
translate russian office_audrey_initiative_lavish_01_b7b28c11:
    "Лавиш постукивает ручкой по губе, изучая меня."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:551
translate russian office_audrey_initiative_lavish_01_2c9a7382:
    lavish.say "Никакого отношения к карьере..."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:552
translate russian office_audrey_initiative_lavish_01_cf30524e:
    lavish.say "То есть я бы делала это только потому, что сама хочу?"

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:556
translate russian office_audrey_initiative_lavish_01_f1a579fe:
    mike.say "Только если сама хочешь. В этом весь смысл."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:557
translate russian office_audrey_initiative_lavish_01_c7b83b5c:
    mike.say "И ты можешь прямо сейчас выйти отсюда, и ничего не изменится."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:559
translate russian office_audrey_initiative_lavish_01_ee2dcae7:
    "На секунду маска безупречной стажёрки соскальзывает."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:560
translate russian office_audrey_initiative_lavish_01_63f2da38:
    "Под ней она выглядит юной и немного взволнованной."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:562
translate russian office_audrey_initiative_lavish_01_b57b4622:
    lavish.say "Я бы хотела сначала изучить материалы."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:564
translate russian office_audrey_initiative_lavish_01_758016d8:
    "Она протягивает руку."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:566
translate russian office_audrey_initiative_lavish_01_918cf404:
    "Одри смотрит на неё. Потом очень медленно отдаёт ей ноутбук."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:568
translate russian office_audrey_initiative_lavish_01_61638d71:
    lavish.say "Я вам сообщу."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:571
translate russian office_audrey_initiative_lavish_01_fc5037b5:
    audrey.say "Она взяла презентацию домой, босс."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:572
translate russian office_audrey_initiative_lavish_01_5c7e3a14:
    audrey.say "Никто не берёт презентацию домой, если ему не интересно!"

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:576
translate russian office_audrey_initiative_lavish_01_69df4807:
    mike.say "Никак, Лавиш. Этой встречи не было."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:577
translate russian office_audrey_initiative_lavish_01_7e05d99b:
    mike.say "Возвращайся на своё место. Нам с Одри нужно поговорить."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:579
translate russian office_audrey_initiative_lavish_01_6a238de9:
    lavish.say "Конечно. Спасибо, что уделили время."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:581
translate russian office_audrey_initiative_lavish_01_39008a0b:
    "Блокнот она забирает с собой. Что-то мне подсказывает, что эту страницу она сохранит."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:591
translate russian office_audrey_initiative_talk_01_80c27532:
    "Я и так слишком долго позволял Одри творить что вздумается."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:594
translate russian office_audrey_initiative_talk_01_15ace021:
    "Я снимаю трубку и набираю её добавочный."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:596
translate russian office_audrey_initiative_talk_01_58afac33:
    audrey.say "Директор по оздоровлению слушает!"

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:599
translate russian office_audrey_initiative_talk_01_110ab942:
    mike.say "Ко мне в кабинет, Одри. Сейчас же."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:602
translate russian office_audrey_initiative_talk_01_a1c3f3bd:
    audrey.say "Ооо. Это моя аттестация?"

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:605
translate russian office_audrey_initiative_talk_01_b685fbe3:
    "Я вешаю трубку."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:608
translate russian office_audrey_initiative_talk_01_befd2bde:
    "Она приходит меньше чем через минуту — возможно, это её личный рекорд в компании."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:609
translate russian office_audrey_initiative_talk_01_38738eb7:
    "И ещё она несёт коробку."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:610
translate russian office_audrey_initiative_talk_01_7961fcbc:
    mike.say "Что в коробке?"

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:612
translate russian office_audrey_initiative_talk_01_e0704940:
    audrey.say "Визитки."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:614
translate russian office_audrey_initiative_talk_01_9b8255c5:
    "Она пододвигает одну ко мне по столу."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:615
translate russian office_audrey_initiative_talk_01_2a9d3e4a:
    "«ОДРИ. Директор по оздоровлению. Программа оздоровления босса»."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:616
translate russian office_audrey_initiative_talk_01_a57b137b:
    "Вместо точки над «и» — маленькое сердечко."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:617
translate russian office_audrey_initiative_talk_01_d296bf15:
    mike.say "Сядь, Одри."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:618
translate russian office_audrey_initiative_talk_01_18a2bc05:
    "Вместо этого она садится на стол — для неё это почти одно и то же."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:620
translate russian office_audrey_initiative_talk_01_a216badc:
    mike.say "Липовая форма из отдела кадров. Приглашение в календаре. Засада с кофе."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:622
translate russian office_audrey_initiative_talk_01_d4f3e4f3:
    mike.say "Липовая форма из отдела кадров. Засада с кофе."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:624
translate russian office_audrey_initiative_talk_01_18c2f02e:
    mike.say "Липовое приглашение в календаре. Презентация."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:626
translate russian office_audrey_initiative_talk_01_675f9f22:
    audrey.say "Ты заметил шрифт!"

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:628
translate russian office_audrey_initiative_talk_01_003db81b:
    mike.say "Это не комплимент."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:630
translate russian office_audrey_initiative_talk_01_f1b512cb:
    audrey.say "Прозвучало как комплимент."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:632
translate russian office_audrey_initiative_talk_01_bd6a5215:
    mike.say "Одри, нельзя обманом заставлять женщин спать со мной."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:634
translate russian office_audrey_initiative_talk_01_be137e7a:
    audrey.say "Обманом?"

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:636
translate russian office_audrey_initiative_talk_01_ab5bcafb:
    audrey.say "Босс, я никого не обманывала. Я сделала им предложение."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:638
translate russian office_audrey_initiative_talk_01_e108875b:
    audrey.say "Сиори смотрит на тебя так, будто ты луну на небо повесил."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:640
translate russian office_audrey_initiative_talk_01_e5248799:
    audrey.say "Лавиш составила про тебя список «за» и «против». Там в основном «за»."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:641
translate russian office_audrey_initiative_talk_01_6c8be92f:
    audrey.say "Я ничего не выдумываю. Я просто... ускоряю процесс."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:643
translate russian office_audrey_initiative_talk_01_3ec538ae:
    "Она достаёт из кармана сложенный листок и с эффектным жестом разворачивает его."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:644
translate russian office_audrey_initiative_talk_01_b44a1f43:
    "Это фотография маркерной доски, вверху написано «ЭТАП 2»."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:645
translate russian office_audrey_initiative_talk_01_80a2555a:
    "В углу нарисован талисман — мультяшная кофейная чашка в солнечных очках."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:646
translate russian office_audrey_initiative_talk_01_26d7bc32:
    mike.say "Зачем тут талисман?"

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:648
translate russian office_audrey_initiative_talk_01_92f595be:
    audrey.say "У каждой хорошей инициативы есть талисман."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:650
translate russian office_audrey_initiative_talk_01_15d11d6b:
    "Я тру глаза."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:652
translate russian office_audrey_initiative_talk_01_1d28507a:
    "А потом, раз уж она притихла, внимательно на неё смотрю."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:654
translate russian office_audrey_initiative_talk_01_029939b5:
    audrey.say "Ты же знаешь, что здесь обо мне все думают, [lssb_audrey.hero_name()]."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:655
translate russian office_audrey_initiative_talk_01_5f0aad06:
    audrey.say "Я путаю документы. Я теряю клиентов. Я та, с кем спят, а не та, кого повышают."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:656
translate russian office_audrey_initiative_talk_01_c8d62628:
    audrey.say "Это первое, в чём я хоть когда-то была хороша в этом здании."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:659
translate russian office_audrey_initiative_talk_01_bedea11f:
    "Она теребит ошейник, как всегда, когда хочет, чтобы её восприняли всерьёз."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:661
translate russian office_audrey_initiative_talk_01_407d7c55:
    audrey.say "Я просто хотела дать тебе что-то взамен."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:663
translate russian office_audrey_initiative_talk_01_11458a33:
    "Она говорит это искренне, и это хуже всего."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:666
translate russian office_audrey_initiative_talk_01_363b33bc:
    mike.say "Я знаю, что ты хотела как лучше. Но это прекращается. Сегодня."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:667
translate russian office_audrey_initiative_talk_01_e0f06c3e:
    mike.say "Больше никаких форм, никаких предложений, никаких талисманов."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:669
translate russian office_audrey_initiative_talk_01_ae970e70:
    audrey.say "Даже талисмана?"

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:671
translate russian office_audrey_initiative_talk_01_8461645c:
    mike.say "Особенно талисмана."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:673
translate russian office_audrey_initiative_talk_01_3a996514:
    "Она соскальзывает со стола и берёт свою коробку визиток."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:675
translate russian office_audrey_initiative_talk_01_e415339d:
    audrey.say "Да, босс."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:677
translate russian office_audrey_initiative_talk_01_56865362:
    "Уходя, она бросает коробку в контейнер для макулатуры."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:678
translate russian office_audrey_initiative_talk_01_aaaa7c1f:
    "Наверное, потом я выужу оттуда одну. На память."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:689
translate russian office_audrey_initiative_talk_01_b96cf9fc:
    mike.say "Тебя, Одри, нужно наказать."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:691
translate russian office_audrey_initiative_talk_01_1ea1ff9b:
    "Её глаза загораются."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:693
translate russian office_audrey_initiative_talk_01_d6dcac38:
    audrey.say "О, слава богу. Я думала, ты никогда не предложишь."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:695
translate russian office_audrey_initiative_talk_01_592b9e91:
    mike.say "Ко мне на колени."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:699
translate russian office_audrey_initiative_talk_01_215a7125:
    "Она уже лежит у меня на коленях, прежде чем я договариваю, и юбка у неё уже задрана."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:706
translate russian office_audrey_initiative_talk_01_4af6c81e:
    "Первый шлепок эхом отдаётся от стен кабинета."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:707
translate russian office_audrey_initiative_talk_01_8fe47606:
    audrey.say "Ах! Раз!"

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:714
translate russian office_audrey_initiative_talk_01_30d76b2a:
    "Второй приходится сильнее."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:716
translate russian office_audrey_initiative_talk_01_62131ee8:
    audrey.say "Два! Ох, блядь, да..."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:723
translate russian office_audrey_initiative_talk_01_f42686b1:
    "Где-то на пятом я понимаю, что она ухмыляется мне через плечо."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:725
translate russian office_audrey_initiative_talk_01_371b8676:
    mike.say "..."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:726
translate russian office_audrey_initiative_talk_01_7b5df6bf:
    mike.say "Для тебя это награда, да?"

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:728
translate russian office_audrey_initiative_talk_01_d2d72a39:
    audrey.say "Ну конечно!"

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:730
translate russian office_audrey_initiative_talk_01_a7788d34:
    "Я вздыхаю и отпускаю её."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:745
translate russian office_audrey_initiative_rules_2695b331:
    mike.say "Ладно. Если уж ты этим занимаешься, то делай это как следует."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:747
translate russian office_audrey_initiative_rules_f2fca0fb:
    "Одри замирает, не донеся визитку до рта."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:748
translate russian office_audrey_initiative_rules_b9aabd21:
    mike.say "Правило первое. Никакого давления. Даже чуть-чуть."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:749
translate russian office_audrey_initiative_rules_7f4f175a:
    mike.say "Правило второе. Больше никаких поддельных документов."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:750
translate russian office_audrey_initiative_rules_3a37e72e:
    mike.say "Правило третье. Ничто из происходящего не касается ничьей работы. Никогда."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:751
translate russian office_audrey_initiative_rules_6f7dd3b7:
    mike.say "Правило четвёртое. Каждая девушка говорит «да» мне. Лично. А не тебе."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:753
translate russian office_audrey_initiative_rules_0c820b93:
    "Одри уже записывает всё это на обратной стороне визитки."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:754
translate russian office_audrey_initiative_rules_f5a10d80:
    "Потом на другой визитке."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:755
translate russian office_audrey_initiative_rules_3b57538e:
    "Потом на третьей, потому что почерк у неё огромный."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:757
translate russian office_audrey_initiative_rules_976d4b4d:
    audrey.say "Правила. Регламент. Ох, босс, это же НАСТОЛЬКО официальнее."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:759
translate russian office_audrey_initiative_rules_e0d5c895:
    mike.say "Цель была не в этом."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:761
translate russian office_audrey_initiative_rules_2e5cfcdb:
    audrey.say "Я их заламинирую."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:763
translate russian office_audrey_initiative_rules_e797f4ce:
    "К концу дня правила уже висят в рамке в комнате отдыха."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:764
translate russian office_audrey_initiative_rules_63a453aa:
    "Прямо рядом с плакатом по пожарной безопасности. Никто ни о чём не спрашивает."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:770
translate russian office_audrey_initiative_shiori_02_a7e8d80c:
    "Моя дверь закрыта, и в кои-то веки на этаже тихо."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:772
translate russian office_audrey_initiative_shiori_02_d4bcc4d9:
    "Поэтому от стука я вздрагиваю."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:773
translate russian office_audrey_initiative_shiori_02_3c04eb55:
    mike.say "Войдите?"

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:776
translate russian office_audrey_initiative_shiori_02_f83cb7ef:
    "В дверях стоит Сиори, прижимая к груди листок бумаги, словно щит."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:778
translate russian office_audrey_initiative_shiori_02_52236b2f:
    shiori.say "Прости. Прости, пожалуйста. Ты занят? Вид у тебя занятой."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:780
translate russian office_audrey_initiative_shiori_02_d0827829:
    mike.say "Для тебя я никогда не бываю слишком занят, Сиори."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:782
translate russian office_audrey_initiative_shiori_02_c6664dd4:
    "Она подходит к столу и кладёт передо мной листок."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:783
translate russian office_audrey_initiative_shiori_02_3259c8bb:
    "Форма 69-Б, все поля заполнены, чернилами трёх цветов."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:784
translate russian office_audrey_initiative_shiori_02_bbeb8376:
    "Со сносками."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:786
translate russian office_audrey_initiative_shiori_02_70f829a5:
    shiori.say "Прости за сноски."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:788
translate russian office_audrey_initiative_shiori_02_95de4560:
    shiori.say "Я прочитала её двенадцать раз. Потом прочитала правила в комнате отдыха. Правило четвёртое говорит, что я должна сказать тебе сама."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:789
translate russian office_audrey_initiative_shiori_02_fdce8736:
    shiori.say "Так что..."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:790
translate russian office_audrey_initiative_shiori_02_85c88328:
    shiori.say "Я говорю тебе."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:792
translate russian office_audrey_initiative_shiori_02_8fc22a20:
    "Она делает вдох."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:794
translate russian office_audrey_initiative_shiori_02_d64593e0:
    shiori.say "Меня уже очень давно никто не спрашивал, чего я хочу, [lssb_shiori.hero_name()]."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:795
translate russian office_audrey_initiative_shiori_02_292e6673:
    shiori.say "А ты спросил. И я подумала. И я этого хочу."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:796
translate russian office_audrey_initiative_shiori_02_c8379ff7:
    shiori.say "Я хочу тебя."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:798
translate russian office_audrey_initiative_shiori_02_2466896d:
    "Я встаю и обхожу стол."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:799
translate russian office_audrey_initiative_shiori_02_e442f277:
    "Она слегка дрожит. Но не отступает."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:800
translate russian office_audrey_initiative_shiori_02_cf8a5061:
    mike.say "Уверена?"

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:802
translate russian office_audrey_initiative_shiori_02_066c0ff2:
    shiori.say "В седьмой сноске написано «очень уверена»."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:806
translate russian office_audrey_initiative_shiori_02_ac4cc1d3:
    audrey.say "Я ТАК и знала, что сноски означают «да»!"

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:808
translate russian office_audrey_initiative_shiori_02_1096660f:
    mike.say "Одри! Ты подслушивала под дверью?"

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:810
translate russian office_audrey_initiative_shiori_02_16e27b60:
    audrey.say "Я руководитель программы. Я осуществляла надзор."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:813
translate russian office_audrey_initiative_shiori_02_af1def7b:
    "Сиори закрывает лицо обеими руками."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:814
translate russian office_audrey_initiative_shiori_02_fe063750:
    "Но сквозь пальцы я вижу, что она улыбается."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:816
translate russian office_audrey_initiative_shiori_02_bf1a64d7:
    shiori.say "Пусть останется. Если ты хочешь."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:819
translate russian office_audrey_initiative_shiori_02_ba740b55:
    audrey.say "О, он хочет."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:821
translate russian office_audrey_initiative_shiori_02_e9f8e1fd:
    "Одри запирает дверь и принимается за пуговицы на блузке Сиори."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:822
translate russian office_audrey_initiative_shiori_02_3e812732:
    "Сиори ей не мешает."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:826
translate russian office_audrey_initiative_shiori_02_8a1c5e75:
    "Через минуту мы втроём стоим посреди моего кабинета совершенно голые."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:827
translate russian office_audrey_initiative_shiori_02_e7a76d9c:
    "Прямо сейчас я думаю только об одной из них."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:836
translate russian office_audrey_initiative_shiori_02_e7fbd501:
    "Потом Сиори очень бережно убирает свою форму в ящик моего стола, будто это свидетельство о рождении."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:838
translate russian office_audrey_initiative_shiori_02_b4b1a4e4:
    audrey.say "Одна есть, босс."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:840
translate russian office_audrey_initiative_shiori_02_e27c55b7:
    audrey.say "Я обновлю оргструктуру."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:853
translate russian office_audrey_initiative_lavish_02_61a5c251:
    "В моём календаре новая встреча."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:854
translate russian office_audrey_initiative_lavish_02_8d84ad8d:
    "«Обзор программы. Организатор: Лавиш»."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:855
translate russian office_audrey_initiative_lavish_02_9dcb1518:
    "Десять минут, повестка во вложении."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:857
translate russian office_audrey_initiative_lavish_02_0d26c987:
    "Ровно в назначенный час — два чётких стука."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:858
translate russian office_audrey_initiative_lavish_02_2f2628c3:
    mike.say "Входи, Лавиш."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:861
translate russian office_audrey_initiative_lavish_02_cfb1e3f5:
    "Лавиш входит с ноутбуком Одри под мышкой. Одри плетётся следом, надувшись."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:863
translate russian office_audrey_initiative_lavish_02_d3fac0ad:
    audrey.say "Она переделала мою презентацию, босс."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:866
translate russian office_audrey_initiative_lavish_02_ffb959c6:
    lavish.say "Я улучшила презентацию."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:868
translate russian office_audrey_initiative_lavish_02_0e773c7b:
    "Лавиш подключает ноутбук."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:869
translate russian office_audrey_initiative_lavish_02_b4b7d49f:
    "Агрессивного шрифта больше нет. Талисмана тоже. Теперь там гистограммы."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:871
translate russian office_audrey_initiative_lavish_02_08ceee7c:
    audrey.say "Где моя чашка в солнечных очках?"

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:874
translate russian office_audrey_initiative_lavish_02_785e046f:
    lavish.say "Приложение В."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:875
translate russian office_audrey_initiative_lavish_02_941284aa:
    lavish.say "Я изучила материалы программы. И твои правила."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:876
translate russian office_audrey_initiative_lavish_02_f6d5fa40:
    lavish.say "Для меня важно правило третье."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:878
translate russian office_audrey_initiative_lavish_02_670b5e94:
    "Она переключает на слайд, где написано только: ОТДЕЛЬНО ОТ МОЕЙ КАРЬЕРЫ."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:880
translate russian office_audrey_initiative_lavish_02_c9b8811d:
    lavish.say "Все в этом здании уверены, что хорошенькая стажёрка будет пробиваться наверх через постель."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:881
translate russian office_audrey_initiative_lavish_02_d0b4f65d:
    lavish.say "Я не буду. Я хочу добиться всего, потому что я хороша в своём деле."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:883
translate russian office_audrey_initiative_lavish_02_dbc31fbe:
    lavish.say "Но это... это единственное здесь, что не сделка."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:884
translate russian office_audrey_initiative_lavish_02_0ed23638:
    lavish.say "Так что я согласна. Потому что хочу, а не потому, что мне это выгодно."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:886
translate russian office_audrey_initiative_lavish_02_211022cf:
    "Это самое честное, что кто-либо когда-либо выносил на слайд."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:887
translate russian office_audrey_initiative_lavish_02_4f1c1601:
    mike.say "Тогда добро пожаловать в программу, Лавиш."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:889
translate russian office_audrey_initiative_lavish_02_60ded07e:
    audrey.say "Уже пора переходить к практической части? Пожалуйста, скажите, что пора."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:892
translate russian office_audrey_initiative_lavish_02_ae482b06:
    lavish.say "Это есть в повестке."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:894
translate russian office_audrey_initiative_lavish_02_994c9485:
    "И правда есть. Пункт четыре. «Практическое занятие, 45 минут»."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:896
translate russian office_audrey_initiative_lavish_02_7f10514b:
    "Одри читает это у меня через плечо и впервые выглядит слегка впечатлённой."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:898
translate russian office_audrey_initiative_lavish_02_0d832975:
    "А потом стаскивает с плеч Лавиш пиджак."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:902
translate russian office_audrey_initiative_lavish_02_d84b4334:
    "Лавиш стоит обнажённая, нервничая, и всё же каким-то образом сохраняет полное самообладание."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:911
translate russian office_audrey_initiative_lavish_02_c56fb56b:
    "Застёгивая блузку, Лавиш смотрит на часы."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:913
translate russian office_audrey_initiative_lavish_02_df3cf009:
    lavish.say "Сорок три минуты. В рамках бюджета."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:916
translate russian office_audrey_initiative_lavish_02_523f2ff8:
    audrey.say "Я сейчас расплачусь. Ты дочь, которой у меня никогда не было."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:929
translate russian office_audrey_initiative_aletta_01_e75c95a5:
    "Я понимаю, что что-то не так, когда слышу принтер."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:930
translate russian office_audrey_initiative_aletta_01_5d8a1ce8:
    "Он выплёвывает страницу за страницей и всё не унимается, хотя бумага давно должна была кончиться."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:931
translate russian office_audrey_initiative_aletta_01_8eb4c5b5:
    "Когда он наконец замолкает, тишина ещё хуже."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:934
translate russian office_audrey_initiative_aletta_01_d5455000:
    "Алетта тоже не стучит. Но когда не стучит Алетта, это куда страшнее."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:935
translate russian office_audrey_initiative_aletta_01_6dfc11d7:
    "Она шлёпает мне на стол лист бумаги."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:936
translate russian office_audrey_initiative_aletta_01_611dd75a:
    "Это оргструктура. Наверху моё имя. Одри со своей короной. Лавиш и Сиори вписаны, с маленькими сердечками."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:937
translate russian office_audrey_initiative_aletta_01_97bf827d:
    "И одна пустая ячейка. «Уточняется (горячая)»."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:939
translate russian office_audrey_initiative_aletta_01_20b365e7:
    aletta.say "Сорок копий, [lssb_aletta.hero_name()]."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:940
translate russian office_audrey_initiative_aletta_01_f43f0963:
    aletta.say "Сорок. Копий. На общем принтере. Рядом с бухгалтерией."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:942
translate russian office_audrey_initiative_aletta_01_5c20216e:
    mike.say "Алетта, я могу объяснить."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:944
translate russian office_audrey_initiative_aletta_01_5a826d8e:
    aletta.say "Не сомневаюсь. С нетерпением жду. Это пойдёт в мой отчёт."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:947
translate russian office_audrey_initiative_aletta_01_841a5243:
    "Именно в этот момент входит Одри со стопкой тёплой бумаги."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:949
translate russian office_audrey_initiative_aletta_01_9d345884:
    audrey.say "Босс, кто-то ворует мои распечатки, и..."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:951
translate russian office_audrey_initiative_aletta_01_7222b5c3:
    "Она видит Алетту, потом лист на моём столе."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:952
translate russian office_audrey_initiative_aletta_01_6df5529c:
    "Потом сорок копий, торчащих из мешка для макулатуры у Алетты, и я вижу, как до неё доходит."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:954
translate russian office_audrey_initiative_aletta_01_f2c493b5:
    audrey.say "Алетта! Отлично! Ты слышала о Программе оздоровления босса?"

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:956
translate russian office_audrey_initiative_aletta_01_e1fb0cf6:
    mike.say "Одри, не надо..."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:958
translate russian office_audrey_initiative_aletta_01_87727f4e:
    audrey.say "Это эксклюзивная возможность для лучших сотрудников..."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:961
translate russian office_audrey_initiative_aletta_01_5f3dd2a3:
    aletta.say "Выйди, Одри."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:964
translate russian office_audrey_initiative_aletta_01_940463d1:
    audrey.say "Там бесплатная кружка!"

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:967
translate russian office_audrey_initiative_aletta_01_47d360d6:
    aletta.say "ВОН."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:971
translate russian office_audrey_initiative_aletta_01_16848ff3:
    "Остаёмся я, Алетта и оргструктура."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:973
translate russian office_audrey_initiative_aletta_01_eaabd3b8:
    aletta.say "Сексуальные услуги, организованные подчинённой, в рабочее время."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:974
translate russian office_audrey_initiative_aletta_01_49bac43c:
    aletta.say "Ты понимаешь, как это выглядит?"

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:978
translate russian office_audrey_initiative_aletta_01_ac3216cc:
    mike.say "Это выглядит хуже, чем есть на самом деле. Но врать тебе я не стану."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:979
translate russian office_audrey_initiative_aletta_01_e4c2bc41:
    mike.say "Пусть это и затеяла Одри, я её не остановил. Я ввёл правила. Никого не принуждали."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:981
translate russian office_audrey_initiative_aletta_01_869b69d1:
    mike.say "Лавиш и Сиори сами это выбрали и сами мне об этом сказали."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:983
translate russian office_audrey_initiative_aletta_01_4f6c1de0:
    mike.say "Все, кто присоединился, сами это выбрали и сами мне об этом сказали."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:985
translate russian office_audrey_initiative_aletta_01_0d41e53e:
    "Алетта прищуривается."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:986
translate russian office_audrey_initiative_aletta_01_e468526e:
    "Она снова смотрит на схему. На пустую ячейку."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:988
translate russian office_audrey_initiative_aletta_01_a296f7f7:
    aletta.say "А кто должен был оказаться здесь?"

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:990
translate russian office_audrey_initiative_aletta_01_5a68a1b3:
    mike.say "Одри не сказала."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:991
translate russian office_audrey_initiative_aletta_01_2ac2038f:
    "Алетта долго молчит."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:993
translate russian office_audrey_initiative_aletta_01_739e9b61:
    aletta.say "Можно было бы хоть из вежливости спросить."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:995
translate russian office_audrey_initiative_aletta_01_2d62b7fa:
    "Не успеваю я это осмыслить, как она выхватывает схему с моего стола."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:997
translate russian office_audrey_initiative_aletta_01_60cff059:
    aletta.say "Я начинаю расследование. Не покидай здание."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:999
translate russian office_audrey_initiative_aletta_01_741b5731:
    "Оргструктуру она забирает с собой, аккуратно сложив во внутренний карман."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:1002
translate russian office_audrey_initiative_aletta_01_b0f9dbb6:
    mike.say "Алетта, пожалуйста. Может, просто забудем, что ты это видела?"

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:1004
translate russian office_audrey_initiative_aletta_01_ebfe6a7b:
    aletta.say "Забудем?"

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:1006
translate russian office_audrey_initiative_aletta_01_583aba7e:
    aletta.say "Всю свою карьеру я только и вижу, как мужчины просят меня что-нибудь забыть, [lssb_aletta.hero_name()]."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:1007
translate russian office_audrey_initiative_aletta_01_bebc101d:
    aletta.say "Я забуду, когда сама решу. Не раньше."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:1009
translate russian office_audrey_initiative_aletta_01_f68010ab:
    "Дверь не хлопает."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:1010
translate russian office_audrey_initiative_aletta_01_bd8a4da8:
    "И почему-то это ещё хуже."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:1022
translate russian office_audrey_initiative_talk_02_7f1e302c:
    "На этот раз я не звоню Одри."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:1024
translate russian office_audrey_initiative_talk_02_b7c4412d:
    "Я сам иду к её столу и дважды стучу по нему."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:1025
translate russian office_audrey_initiative_talk_02_15b9ed47:
    mike.say "Ко мне в кабинет."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:1029
translate russian office_audrey_initiative_talk_02_ed776bd4:
    "Она идёт следом без единой шутки — значит, прекрасно понимает, насколько всё плохо."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:1030
translate russian office_audrey_initiative_talk_02_f5621bcd:
    mike.say "Сорок копий, Одри."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:1032
translate russian office_audrey_initiative_talk_02_58046e63:
    audrey.say "Знаю."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:1034
translate russian office_audrey_initiative_talk_02_c6707f74:
    mike.say "Рядом с бухгалтерией."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:1036
translate russian office_audrey_initiative_talk_02_4a4e7db5:
    audrey.say "Я ЗНАЮ."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:1038
translate russian office_audrey_initiative_talk_02_1cee5aa0:
    mike.say "Ты понимаешь, что Алетта одним письмом может закончить карьеру нам обоим?"

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:1039
translate russian office_audrey_initiative_talk_02_8f1818aa:
    mike.say "Мою. Твою. А может, и Лавиш с Сиори."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:1041
translate russian office_audrey_initiative_talk_02_fe5d41c9:
    "Одри открывает рот, и в кои-то веки из него не вылетает ничего остроумного."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:1043
translate russian office_audrey_initiative_talk_02_7ff7dc20:
    audrey.say "Меня занесло."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:1044
translate russian office_audrey_initiative_talk_02_9ef7884f:
    audrey.say "Всё шло так хорошо, босс. Сиори счастлива. Лавиш счастлива. Ты счастлив."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:1045
translate russian office_audrey_initiative_talk_02_f8a99b3e:
    audrey.say "Я хотела, чтобы всё было идеально, а устроила катастрофу."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:1047
translate russian office_audrey_initiative_talk_02_8c25fd06:
    "Она часто моргает."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:1049
translate russian office_audrey_initiative_talk_02_0259d5b0:
    audrey.say "Я всё испортила?"

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:1051
translate russian office_audrey_initiative_talk_02_7ae26c80:
    "Я сажусь рядом с ней на край стола."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:1052
translate russian office_audrey_initiative_talk_02_3e4bfd47:
    mike.say "Нет. Но была близка к этому."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:1054
translate russian office_audrey_initiative_talk_02_0234cac6:
    "Она шмыгает носом. Потом тянется к ноутбуку."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:1056
translate russian office_audrey_initiative_talk_02_e8aae80c:
    audrey.say "Так. Так. Я всё исправлю. Сделаю для Алетты презентацию. Очень уважительную презентацию..."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:1058
translate russian office_audrey_initiative_talk_02_1b2750e8:
    "Я забираю у неё ноутбук и убираю в ящик стола."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:1059
translate russian office_audrey_initiative_talk_02_cc3bfc58:
    mike.say "Никаких больше презентаций."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:1062
translate russian office_audrey_initiative_talk_02_bf7cefb4:
    mike.say "Ты извинишься перед Алеттой. Лично. Сама."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:1064
translate russian office_audrey_initiative_talk_02_f9c03cf6:
    audrey.say "ЛИЧНО?"

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:1066
translate russian office_audrey_initiative_talk_02_65b75fea:
    mike.say "Лично."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:1068
translate russian office_audrey_initiative_talk_02_7f270715:
    audrey.say "...Да, босс."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:1073
translate russian office_audrey_initiative_talk_02_eff16c33:
    mike.say "С Алеттой я разберусь сам. А ты не вмешивайся."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:1074
translate russian office_audrey_initiative_talk_02_2d801fda:
    mike.say "Вообще не вмешивайся."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:1076
translate russian office_audrey_initiative_talk_02_94cbf053:
    audrey.say "Вообще?"

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:1078
translate russian office_audrey_initiative_talk_02_78121a0c:
    mike.say "Вообще."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:1080
translate russian office_audrey_initiative_talk_02_e9f99da5:
    audrey.say "Ладно."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:1082
translate russian office_audrey_initiative_talk_02_2e1a5197:
    "Я ей ни на секунду не верю."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:1094
translate russian office_audrey_initiative_aletta_02_3a3a0f55:
    "Вызов от Алетты приходит в виде приглашения в календаре: «Расследование, заключительное заседание»."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:1099
translate russian office_audrey_initiative_aletta_02_132569ac:
    "Я подхожу к её двери как раз вовремя, чтобы увидеть, что Одри уже стоит перед её столом."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:1101
translate russian office_audrey_initiative_aletta_02_321789bf:
    audrey.say "Алетта. Я хочу извиниться."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:1102
translate russian office_audrey_initiative_aletta_02_0941975b:
    audrey.say "За принтер. За схему. За то, что пыталась впарить тебе кружку."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:1103
translate russian office_audrey_initiative_aletta_02_c2af661e:
    audrey.say "Прости меня. Искренне."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:1105
translate russian office_audrey_initiative_aletta_02_20827397:
    "Алетта долго на неё смотрит."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:1107
translate russian office_audrey_initiative_aletta_02_9715cc8d:
    aletta.say "Это было так сложно?"

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:1110
translate russian office_audrey_initiative_aletta_02_d8ebc13f:
    audrey.say "Да! Это было ужасно! Кажется, я что-то себе потянула!"

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:1113
translate russian office_audrey_initiative_aletta_02_4d4bb6c2:
    "Уголок рта Алетты дёргается."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:1114
translate russian office_audrey_initiative_aletta_02_46454c06:
    "Для Алетты это практически хохот до упаду."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:1117
translate russian office_audrey_initiative_aletta_02_3a3a0f55_1:
    "Вызов от Алетты приходит в виде приглашения в календаре: «Расследование, заключительное заседание»."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:1118
translate russian office_audrey_initiative_aletta_02_c3c66c22:
    "Я иду один, как и говорил Одри."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:1122
translate russian office_audrey_initiative_aletta_02_556e099d:
    "Алетта сидит за столом, перед ней папка, а на ней — оргструктура."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:1124
translate russian office_audrey_initiative_aletta_02_2e240da1:
    aletta.say "Закрой дверь, [lssb_aletta.hero_name()]."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:1125
translate russian office_audrey_initiative_aletta_02_959eca7f:
    aletta.say "Я завершила расследование."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:1127
translate russian office_audrey_initiative_aletta_02_6a4c0744:
    "Она постукивает по папке."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:1129
translate russian office_audrey_initiative_aletta_02_d1ed3ccc:
    aletta.say "Выводы. Твоя маленькая инициатива плохо организована, плохо задокументирована, и руководит ей женщина, которая пишет ручками с блёстками."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:1136
translate russian office_audrey_initiative_aletta_02_23c9215e:
    audrey.say "Это гелевые ручки!"

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:1138
translate russian office_audrey_initiative_aletta_02_a9315aa7:
    mike.say "Одри! Ты же обещала не вмешиваться!"

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:1140
translate russian office_audrey_initiative_aletta_02_4d96c060:
    audrey.say "Я сказала «ЛАДНО». Все знают, что «ладно» не значит «да»."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:1143
translate russian office_audrey_initiative_aletta_02_df055e38:
    aletta.say "Сядь, Одри. Кто-то должен вести протокол."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:1146
translate russian office_audrey_initiative_aletta_02_c334906f:
    "Одри садится. Действительно садится. И достаёт блокнот."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:1148
translate russian office_audrey_initiative_aletta_02_5c37e859:
    aletta.say "Кроме того, всё происходит по согласию, с добрыми намерениями и, насколько я могу судить, делает всех участников чрезвычайно счастливыми."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:1149
translate russian office_audrey_initiative_aletta_02_dd692b29:
    aletta.say "Чего не скажешь о большинстве проектов в этой компании."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:1151
translate russian office_audrey_initiative_aletta_02_5d20e00e:
    aletta.say "Поэтому закрывать её я не стану."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:1152
translate russian office_audrey_initiative_aletta_02_e190aa37:
    aletta.say "Я забираю её себе."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:1154
translate russian office_audrey_initiative_aletta_02_db9ee0d9:
    mike.say "Ты что?"

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:1156
translate russian office_audrey_initiative_aletta_02_d3b181c3:
    aletta.say "Реорганизация. Чёткая повестка. Чёткая вертикаль подчинения. Нормальная документация."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:1158
translate russian office_audrey_initiative_aletta_02_278d59d4:
    "Она разворачивает оргструктуру ко мне."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:1159
translate russian office_audrey_initiative_aletta_02_30aece74:
    "Пустая ячейка больше не пустая. «АЛЕТТА» — аккуратными чёрными печатными буквами."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:1161
translate russian office_audrey_initiative_aletta_02_01af6b6b:
    audrey.say "Она вписала себя в ячейку «Уточняется (горячая)»!"

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:1164
translate russian office_audrey_initiative_aletta_02_b7105025:
    aletta.say "Я заметила вакансию."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:1166
translate russian office_audrey_initiative_aletta_02_c98a7675:
    aletta.say "Я несколько дней злилась, что меня никто не спросил, [lssb_aletta.hero_name()]."

# ch/harems_full/office/events/office_harem_audrey_initiative.rpy:1167
translate russian office_audrey_initiative_aletta_02_cb6d3840:
