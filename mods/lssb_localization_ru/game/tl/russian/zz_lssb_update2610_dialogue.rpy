# dlc_cupid/ch/cupid/palla_shawn/aftermath.rpy:111
translate russian cupid_palla_shawn_aftermath_e2e846ee:
    palla.say "И никто меня не выиграл. Я выбрала сама."

# dlc_cupid/ch/cupid/palla_shawn/aftermath.rpy:113
translate russian cupid_palla_shawn_aftermath_f4533754:
    "Теперь они оба смотрят на меня и ждут, что я скажу дальше."

# dlc_cupid/ch/cupid/palla_shawn/aftermath.rpy:116
translate russian cupid_palla_shawn_aftermath_08683124:
    mike.say "Прости, Шон."

# dlc_cupid/ch/cupid/palla_shawn/aftermath.rpy:117
translate russian cupid_palla_shawn_aftermath_83b3e3d8:
    mike.say "Я говорил всерьёз, когда обещал тебе помочь."

# dlc_cupid/ch/cupid/palla_shawn/aftermath.rpy:118
translate russian cupid_palla_shawn_aftermath_8e3f9b4b:
