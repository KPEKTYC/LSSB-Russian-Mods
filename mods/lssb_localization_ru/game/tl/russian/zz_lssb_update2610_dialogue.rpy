# ch/hanna/petwalk.rpy:91
translate russian petwalk_hanna_crowd_1bc19757:
    "Первый, кто замечает, застывает как вкопанный, и его приятель тоже. А потом в ход идут телефоны."

# ch/hanna/petwalk.rpy:92
translate russian petwalk_hanna_crowd_61536594:
    hanna.say "[lssb_hanna.hero_name()]... их так много..."

# ch/hanna/petwalk.rpy:93
translate russian petwalk_hanna_crowd_30dcb02f:
    "Кто-то смеётся. Кто-то другой говорит это вслух."

# ch/hanna/petwalk.rpy:94
translate russian petwalk_hanna_crowd_c7411dc1:
    "Stranger" "Это не та девчонка из спортзала?"

# ch/hanna/petwalk.rpy:95
translate russian petwalk_hanna_crowd_0d1c5148:
    "Ханна цепенеет."

# ch/hanna/petwalk.rpy:96
translate russian petwalk_hanna_crowd_89323576:
    mike.say "К ноге."

# ch/hanna/petwalk.rpy:97
translate russian petwalk_hanna_crowd_dfc1eead:
    "Она тут же прижимается к моему боку, и почему-то команда её успокаивает."

# ch/hanna/petwalk.rpy:98
translate russian petwalk_hanna_crowd_4ab6d140:
    hanna.say "Ладно. Я твоя собака."

# ch/hanna/petwalk.rpy:99
translate russian petwalk_hanna_crowd_06cbfa61:
    hanna.say "А собакам плевать, кто на них смотрит."

# ch/hanna/petwalk.rpy:100
translate russian petwalk_hanna_crowd_c3191613:
    "Её бёдра дрожат всю дорогу до конца квартала."

# ch/hanna/petwalk.rpy:102
translate russian petwalk_hanna_crowd_d27626fc:
    "Ханна пробивается сквозь лес ног, словно улица принадлежит ей."

# ch/hanna/petwalk.rpy:103
translate russian petwalk_hanna_crowd_68499c55:
    "Поднимаются телефоны. Она задирает для них подбородок."

# ch/hanna/petwalk.rpy:104
translate russian petwalk_hanna_crowd_a0bfdb8a:
    hanna.say "Снимайте меня с выгодной стороны, народ!"

# ch/hanna/petwalk.rpy:105
translate russian petwalk_hanna_crowd_0320104a:
    "А потом тише, только для меня."

# ch/hanna/petwalk.rpy:106
translate russian petwalk_hanna_crowd_a5cbdc35:
    hanna.say "У меня же обе стороны выгодные, правда, [lssb_hanna.hero_name()]?"

# ch/hanna/petwalk.rpy:112
translate russian petwalk_hanna_dog_3f9c5ac3:
    "[dog.name] вылетает из-за угла, видит Ханну на четвереньках и замирает как вкопанный."

# ch/hanna/petwalk.rpy:113
translate russian petwalk_hanna_dog_11c6f72c:
    "Следует долгое и тщательное обнюхивание."

# ch/hanna/petwalk.rpy:114
translate russian petwalk_hanna_dog_b72bc5c9:
    hanna.say "Эй! Глаза выше, приятель!"

# ch/hanna/petwalk.rpy:115
translate russian petwalk_hanna_dog_ea0ffc37:
    "Его хвост начинает крутиться как пропеллер. Ханна прищуривается на него."

# ch/hanna/petwalk.rpy:116
translate russian petwalk_hanna_dog_0ad355a7:
    "К концу улицы она идёт с ним ноздря в ноздрю. К концу следующей — уже наперегонки."

# ch/hanna/petwalk.rpy:117
translate russian petwalk_hanna_dog_b0d90191:
    mike.say "Ханна, это не гонки."

# ch/hanna/petwalk.rpy:118
translate russian petwalk_hanna_dog_09d80bac:
    hanna.say "Он первый начал. Я не собираюсь проигрывать собаке."

# ch/hanna/petwalk.rpy:119
translate russian petwalk_hanna_dog_15a9a51a:
    mike.say "Ты и есть собака."

# ch/hanna/petwalk.rpy:120
translate russian petwalk_hanna_dog_d73585de:
    hanna.say "...Значит, я не собираюсь проигрывать ДРУГОЙ собаке!"

# ch/hanna/petwalk.rpy:122
translate russian petwalk_hanna_dog_ef04e161:
    "Ханна и [dog.name] теперь понимают друг друга."

# ch/hanna/petwalk.rpy:123
translate russian petwalk_hanna_dog_706c6920:
    "Он обнюхивает каждый фонарный столб. Она — нет. В основном."

# ch/hanna/petwalk.rpy:124
translate russian petwalk_hanna_dog_52d026ff:
    hanna.say "Не смотри на меня так. Он первый начал."

# ch/hanna/petwalk.rpy:132
translate russian petwalk_hanna_call_f73ea82d:
    "Ханна читает имя на моём экране и поднимает взгляд к потолку."

# ch/hanna/petwalk.rpy:133
translate russian petwalk_hanna_call_73a7e2da:
    hanna.say "[sasha.name]? Твоя соседка?"

# ch/hanna/petwalk.rpy:134
translate russian petwalk_hanna_call_65c342e4:
    hanna.say "Та, что в два часа ночи играет на гитаре прямо через пол?"

# ch/hanna/petwalk.rpy:135
translate russian petwalk_hanna_call_f644844c:
    mike.say "Она тоже гуляет. Она тебе понравится."

# ch/hanna/petwalk.rpy:136
translate russian petwalk_hanna_call_60172c23:
    hanna.say "Я с ней даже ни разу не здоровалась, [lssb_hanna.hero_name()]!"

# ch/hanna/petwalk.rpy:137
translate russian petwalk_hanna_call_4746ce33:
    hanna.say "И теперь она познакомится со мной ВОТ ТАК?"

# ch/hanna/petwalk.rpy:138
translate russian petwalk_hanna_call_c8435506:
    "Она оглядывает себя. Голая, в ошейнике, на четвереньках на полу моей прихожей."

# ch/hanna/petwalk.rpy:139
translate russian petwalk_hanna_call_55edaba0:
    "А потом втягивает живот и чуть-чуть прогибает спину."

# ch/hanna/petwalk.rpy:141
translate russian petwalk_hanna_call_959368e0:
    hanna.say "[sasha.name] спускается?"

# ch/hanna/petwalk.rpy:142
translate russian petwalk_hanna_call_60bf7413:
    "Она отползает в сторону, освобождая место, а потом тут же возвращается на середину."

# ch/hanna/petwalk.rpy:143
translate russian petwalk_hanna_call_63af68c1:
    hanna.say "Скажи ей, что в этот раз я обгоню её до ворот."

# ch/hanna/petwalk.rpy:148
translate russian petwalk_hanna_call_d0415bcc:
    "Ханна смотрит, как я печатаю. Потом читает имя на экране."

# ch/hanna/petwalk.rpy:149
translate russian petwalk_hanna_call_816be397:
    hanna.say "[cassidy.name]? Та бродяжка из парка?"

# ch/hanna/petwalk.rpy:150
translate russian petwalk_hanna_call_61c072c6:
    hanna.say "Серьёзно, [lssb_hanna.hero_name()]? Она вылезла из кустов и тёрлась о твою ногу!"

# ch/hanna/petwalk.rpy:151
translate russian petwalk_hanna_call_e01b76a2:
    "Она стискивает зубы."

# ch/hanna/petwalk.rpy:152
translate russian petwalk_hanna_call_52250fad:
    mike.say "Будь хорошей девочкой. Похоже, ей не помешают друзья."

# ch/hanna/petwalk.rpy:153
translate russian petwalk_hanna_call_2a4b9503:
    "Ханна дуется целых десять секунд. Потом задирает подбородок."

# ch/hanna/petwalk.rpy:154
translate russian petwalk_hanna_call_ba118c37:
    hanna.say "Ладно. Но я иду слева от тебя."

# ch/hanna/petwalk.rpy:155
translate russian petwalk_hanna_call_96c5bbc4:
    hanna.say "А когда она придёт, я буду держаться у ноги так, что она расплачется."

# ch/hanna/petwalk.rpy:157
translate russian petwalk_hanna_call_8585fb0d:
    "Ханна читает имя на моём экране и хмурится."

# ch/hanna/petwalk.rpy:158
translate russian petwalk_hanna_call_93aa7310:
    hanna.say "Кто такая [cassidy.name]?"

# ch/hanna/petwalk.rpy:159
translate russian petwalk_hanna_call_e7953635:
    mike.say "Подруга. Она тоже любит гулять."

# ch/hanna/petwalk.rpy:160
translate russian petwalk_hanna_call_2007080b:
    hanna.say "Ах, она ЛЮБИТ гулять. Отлично. Просто отлично."

# ch/hanna/petwalk.rpy:161
translate russian petwalk_hanna_call_45cf53d2:
    "Она издаёт тихий кислый звук."

# ch/hanna/petwalk.rpy:162
translate russian petwalk_hanna_call_ba118c37_1:
    hanna.say "Ладно. Но я иду слева от тебя."

# ch/hanna/petwalk.rpy:164
translate russian petwalk_hanna_call_3db8dfe2:
    hanna.say "Снова [cassidy.name]?"

# ch/hanna/petwalk.rpy:165
translate russian petwalk_hanna_call_c598a887:
    "Она долго и громко вздыхает, а потом прижимается вплотную к моей ноге."

# ch/hanna/petwalk.rpy:166
translate russian petwalk_hanna_call_dc528fa2:
    hanna.say "Пусть приходит. Но моё место не займёт."

# ch/hanna/petwalk.rpy:171
translate russian petwalk_hanna_call_b99aedf8:
    "Ханна видит имя на моём экране и стонет в ковёр."

# ch/hanna/petwalk.rpy:172
translate russian petwalk_hanna_call_3776f011:
    hanna.say "[ayesha.name]. Ну конечно, это [ayesha.name]."

# ch/hanna/petwalk.rpy:173
translate russian petwalk_hanna_call_9017c113:
    hanna.say "Она уже видела меня на поводке, [lssb_hanna.hero_name()]. Я на работе ей в глаза смотреть не могу."

# ch/hanna/petwalk.rpy:174
translate russian petwalk_hanna_call_82ad64ab:
    mike.say "Значит, тебе больше нечего скрывать."

# ch/hanna/petwalk.rpy:175
translate russian petwalk_hanna_call_ac865aec:
    hanna.say "...Это не так утешает, как ты думаешь."

# ch/hanna/petwalk.rpy:176
translate russian petwalk_hanna_call_0c393d19:
    "Потом она выпрямляется и разминает плечи."

# ch/hanna/petwalk.rpy:177
translate russian petwalk_hanna_call_4b30165f:
    hanna.say "Ладно. Но если она попробует идти впереди меня, ей конец."

# ch/hanna/petwalk.rpy:180
translate russian petwalk_hanna_call_a7ccd78a:
    "Ханна бросает взгляд на мой экран и белеет как полотно."

# ch/hanna/petwalk.rpy:181
translate russian petwalk_hanna_call_d4c551a2:
    hanna.say "[ayesha.name]? Из спортзала? [lssb_hanna.hero_name()], она же у меня работает!"

# ch/hanna/petwalk.rpy:182
translate russian petwalk_hanna_call_27255201:
    hanna.say "А вдруг она всем расскажет?"

# ch/hanna/petwalk.rpy:183
translate russian petwalk_hanna_call_b8aa4826:
    mike.say "Ей это тоже нравится. Поверь мне."

# ch/hanna/petwalk.rpy:184
translate russian petwalk_hanna_call_f9eb36cf:
    "Ханна открывает рот и снова закрывает. Уши у неё краснеют."

# ch/hanna/petwalk.rpy:185
translate russian petwalk_hanna_call_77591d2f:
    hanna.say "Ой, мамочки. Ладно. Ладно."

# ch/hanna/petwalk.rpy:186
translate russian petwalk_hanna_call_da9a5740:
    hanna.say "Но если это всплывёт, я закопаю тебя в парке."

# ch/hanna/petwalk.rpy:188
translate russian petwalk_hanna_call_a32ffea5:
    hanna.say "[ayesha.name]? Опять?"

# ch/hanna/petwalk.rpy:189
translate russian petwalk_hanna_call_6621a411:
    "Ханна разминает шею и встряхивает руками."

# ch/hanna/petwalk.rpy:190
translate russian petwalk_hanna_call_310da46a:
    hanna.say "Ладно. Но сегодня я иду по внутренней стороне."

# ch/hanna/petwalk.rpy:193
translate russian petwalk_hanna_call_d0415bcc_1:
    "Ханна смотрит, как я печатаю. Потом читает имя на экране."

# ch/hanna/petwalk.rpy:194
translate russian petwalk_hanna_call_c5a5067e:
    hanna.say "[other.girl.name]?"

# ch/hanna/petwalk.rpy:195
translate russian petwalk_hanna_call_d35e0e17:
    hanna.say "Серьёзно, [lssb_hanna.hero_name()]?"

# ch/hanna/petwalk.rpy:196
translate russian petwalk_hanna_call_f512c411:
    "Её губы сжимаются в линию."

# ch/hanna/petwalk.rpy:197
translate russian petwalk_hanna_call_4151bdb5:
    mike.say "Будь хорошей девочкой. Она новенькая."

# ch/hanna/petwalk.rpy:198
translate russian petwalk_hanna_call_57de503b:
    "Ханна дуется целых десять секунд. Потом фыркает и сдаётся."

# ch/hanna/petwalk.rpy:199
translate russian petwalk_hanna_call_ba118c37_2:
    hanna.say "Ладно. Но я иду слева от тебя."

# ch/hanna/petwalk.rpy:200
translate russian petwalk_hanna_call_96c5bbc4_1:
    hanna.say "А когда она придёт, я буду держаться у ноги так, что она расплачется."

# ch/hanna/petwalk.rpy:202
translate russian petwalk_hanna_call_d03fb94a:
    hanna.say "Снова [other.girl.name]?"

# ch/hanna/petwalk.rpy:203
translate russian petwalk_hanna_call_6fa3b2b8:
    "Она вздыхает, глядя в потолок, потом отползает в сторону, освобождая место."

# ch/hanna/petwalk.rpy:204
translate russian petwalk_hanna_call_28d93c7a:
    "А через секунду возвращается обратно на середину."

# ch/hanna/petwalk.rpy:205
translate russian petwalk_hanna_call_dc528fa2_1:
    hanna.say "Пусть приходит. Но моё место не займёт."

# ch/hanna/petwalk.rpy:214
translate russian petwalk_hanna_joined_c9ee11ed:
    "Через двадцать минут после моего сообщения Ханна врывается в дверь, запыхавшись."

# ch/hanna/petwalk.rpy:215
translate russian petwalk_hanna_joined_6a437f22:
    "Она начинает раздеваться, даже не закрыв за собой дверь."

# ch/hanna/petwalk.rpy:216
translate russian petwalk_hanna_joined_4b73bc3a:
    "И тут видит у двери на четвереньках совершенно незнакомую ей девушку по имени [sasha.name] и замирает, наполовину раздетая."

# ch/hanna/petwalk.rpy:217
translate russian petwalk_hanna_joined_ed5eb93d:
    hanna.say "Ой! Привет! Ты, наверное, соседка."

# ch/hanna/petwalk.rpy:218
translate russian petwalk_hanna_joined_93897594:
    hanna.say "Я [hanna.name]. Я бы пожала тебе руку, но ты на ней вроде как... стоишь."

# ch/hanna/petwalk.rpy:219
translate russian petwalk_hanna_joined_3285d524:
    "[sasha.name] отрывает одну руку от пола. Я киваю."

# ch/hanna/petwalk.rpy:220
translate russian petwalk_hanna_joined_75d627f4:
    mike.say "Говори."

# ch/hanna/petwalk.rpy:221
translate russian petwalk_hanna_joined_dcdcaff9:
    sasha.say "Привет. Странный способ познакомиться."

# ch/hanna/petwalk.rpy:222
translate russian petwalk_hanna_joined_9adfa915:
    "Ханна хихикает, сбрасывает остатки одежды и опускается рядом с ней, плечом к плечу."

# ch/hanna/petwalk.rpy:224
translate russian petwalk_hanna_joined_a1b592bc:
    "Ханна у двери через десять минут после моего сообщения, и ошейник у неё уже надет под толстовкой."

# ch/hanna/petwalk.rpy:225
translate russian petwalk_hanna_joined_6690b350:
    "Толстовка летит на пол, следом всё остальное, и она толкает плечом девушку по имени [sasha.name]."

# ch/hanna/petwalk.rpy:226
translate russian petwalk_hanna_joined_6ebdd382:
    hanna.say "Привет, [sasha.name]. Наперегонки до ворот."

# ch/hanna/petwalk.rpy:227
translate russian petwalk_hanna_joined_77db405b:
    "[sasha.name] не поднимает руку. Она просто толкает её в ответ, сильнее."

# ch/hanna/petwalk.rpy:233
translate russian petwalk_hanna_joined_17b0876d:
    "Через двадцать минут после моего сообщения Ханна врывается в дверь, уже стягивая топ через голову."

# ch/hanna/petwalk.rpy:234
translate russian petwalk_hanna_joined_36fc6ed8:
    "И тут видит, кто стоит на четвереньках в моей прихожей, и застывает, а топ так и застревает на локтях."

# ch/hanna/petwalk.rpy:235
translate russian petwalk_hanna_joined_0a92e3c5:
    hanna.say "А. Это ТЫ."

# ch/hanna/petwalk.rpy:236
translate russian petwalk_hanna_joined_91407b7d:
    hanna.say "Бродяжка из парка."

# ch/hanna/petwalk.rpy:237
translate russian petwalk_hanna_joined_ef572d1c:
    cassidy.say "Вообще-то, породистая."

# ch/hanna/petwalk.rpy:238
translate russian petwalk_hanna_joined_b34edb45:
    "Остальное Ханна снимает секунды за четыре."

# ch/hanna/petwalk.rpy:239
translate russian petwalk_hanna_joined_917442a5:
    "Она опускается рядом с девушкой по имени [cassidy.name] — ближе, чем нужно, и на полголовы впереди."

# ch/hanna/petwalk.rpy:242
translate russian petwalk_hanna_joined_c5705bea:
    "Через двадцать минут после моего сообщения Ханна заходит, щёки раскраснелись от холода."

# ch/hanna/petwalk.rpy:243
translate russian petwalk_hanna_joined_2909d7c3:
    "Она начинает раздеваться, даже не закрыв дверь. И тут видит на четвереньках девушку по имени [cassidy.name] и замирает, наполовину раздетая."

# ch/hanna/petwalk.rpy:244
translate russian petwalk_hanna_joined_2723196b:
    hanna.say "Ой. ОЙ."

# ch/hanna/petwalk.rpy:245
translate russian petwalk_hanna_joined_01010377:
    hanna.say "Привет. Я [hanna.name]. Это у тебя... милый ошейник?"

# ch/hanna/petwalk.rpy:246
translate russian petwalk_hanna_joined_d86fd17d:
    cassidy.say "Знаю. Он итальянский."

# ch/hanna/petwalk.rpy:247
translate russian petwalk_hanna_joined_8d9440a9:
    "Ханна стягивает с себя остатки одежды и опускается рядом с ней, так близко, чтобы толкнуть плечом. Сильно."

# ch/hanna/petwalk.rpy:249
translate russian petwalk_hanna_joined_a1b592bc_1:
    "Ханна у двери через десять минут после моего сообщения, и ошейник у неё уже надет под толстовкой."

# ch/hanna/petwalk.rpy:250
translate russian petwalk_hanna_joined_4117f752:
    hanna.say "[cassidy.name]."

# ch/hanna/petwalk.rpy:251
translate russian petwalk_hanna_joined_8958cb81:
    cassidy.say "[hanna.name]."

# ch/hanna/petwalk.rpy:252
translate russian petwalk_hanna_joined_dfd0428b:
    "Толстовка летит на пол, следом всё остальное. Ни одна не уступает ни сантиметра моей ноги."

# ch/hanna/petwalk.rpy:257
translate russian petwalk_hanna_joined_54d76e40:
    "Через двадцать минут после моего сообщения Ханна врывается в дверь."

# ch/hanna/petwalk.rpy:258
translate russian petwalk_hanna_joined_6a437f22_1:
    "Она начинает раздеваться, даже не закрыв за собой дверь."

# ch/hanna/petwalk.rpy:259
translate russian petwalk_hanna_joined_dee40ccf:
    "И тут видит у двери на четвереньках девушку по имени [ayesha.name] и замирает, наполовину раздетая."

# ch/hanna/petwalk.rpy:260
translate russian petwalk_hanna_joined_32edd85e:
    hanna.say "[ayesha.name]."

# ch/hanna/petwalk.rpy:261
translate russian petwalk_hanna_joined_dbacdc36:
    ayesha.say "[hanna.name]."

# ch/hanna/petwalk.rpy:262
translate russian petwalk_hanna_joined_007cc22d:
    "Долгую секунду все молчат."

# ch/hanna/petwalk.rpy:263
translate russian petwalk_hanna_joined_a2fd342f:
    hanna.say "Ладно. Новое правило. Что было на прогулке, остаётся на прогулке."

# ch/hanna/petwalk.rpy:264
translate russian petwalk_hanna_joined_c0ddcd87:
    ayesha.say "Договорились. А теперь опускайся сюда, ты холод напускаешь."

# ch/hanna/petwalk.rpy:265
translate russian petwalk_hanna_joined_82b1eb87:
    "Ханна сбрасывает остатки одежды и опускается рядом с ней, плечом к плечу."

# ch/hanna/petwalk.rpy:267
translate russian petwalk_hanna_joined_b6135a4a:
    "Ханна у двери через десять минут после моего сообщения, волосы ещё мокрые после душа."

# ch/hanna/petwalk.rpy:268
translate russian petwalk_hanna_joined_70860811:
    hanna.say "Только попробуй сегодня идти впереди меня, [ayesha.name]."

# ch/hanna/petwalk.rpy:269
translate russian petwalk_hanna_joined_00e93f77:
    ayesha.say "Тогда не отставай, [hanna.name]."

# ch/hanna/petwalk.rpy:270
translate russian petwalk_hanna_joined_45b52fd1:
    "Ханна раздевается, опускается рядом с ней, и они толкаются плечами. Сильно."

# ch/hanna/petwalk.rpy:274
translate russian petwalk_hanna_joined_1b4267d2:
    "Через двадцать минут после моего сообщения Ханна врывается в дверь, слегка запыхавшись."

# ch/hanna/petwalk.rpy:275
translate russian petwalk_hanna_joined_6a437f22_2:
    "Она начинает раздеваться, даже не закрыв за собой дверь."

# ch/hanna/petwalk.rpy:276
translate russian petwalk_hanna_joined_7cd96772:
    hanna.say "Погоди-ка..."

# ch/hanna/petwalk.rpy:277
translate russian petwalk_hanna_joined_dfc14a89:
    hanna.say "Я ведь не перепутала вечер, да?"

# ch/hanna/petwalk.rpy:278
translate russian petwalk_hanna_joined_a9c7679a:
    hanna.say "Мы же сегодня голышом изображаем выгул собак, так?"

# ch/hanna/petwalk.rpy:279
translate russian petwalk_hanna_joined_f66ad5d8:
    "И тут видит у двери на четвереньках девушку по имени [other.girl.name] и замирает, наполовину раздетая."

# ch/hanna/petwalk.rpy:280
translate russian petwalk_hanna_joined_2723196b_1:
    hanna.say "Ой. ОЙ."

# ch/hanna/petwalk.rpy:281
translate russian petwalk_hanna_joined_c89a2ad4:
    hanna.say "Как мило, что ты наконец позвал меня на самое интересное, [lssb_hanna.hero_name()]."

# ch/hanna/petwalk.rpy:282
translate russian petwalk_hanna_joined_0c5757c5:
    "Она стягивает остатки одежды и опускается на колени рядом с девушкой по имени [other.girl.name]."

# ch/hanna/petwalk.rpy:283
translate russian petwalk_hanna_joined_ab23d210:
    "Она прижимается плечом к плечу, ближе, чем нужно."

# ch/hanna/petwalk.rpy:285
translate russian petwalk_hanna_joined_a1b592bc_2:
    "Ханна у двери через десять минут после моего сообщения, и ошейник у неё уже надет под толстовкой."

# ch/hanna/petwalk.rpy:286
translate russian petwalk_hanna_joined_8219c90c:
    hanna.say "[lssb_hanna.hero_name()]. [other.girl.name]."

# ch/hanna/petwalk.rpy:287
translate russian petwalk_hanna_joined_c7725089:
    "Толстовка летит на пол, следом всё остальное."

# ch/hanna/petwalk.rpy:288
translate russian petwalk_hanna_joined_c154c1ef:
    hanna.say "Подвинься. У ноги — моё место."

# ch/hanna/petwalk.rpy:289
translate russian petwalk_hanna_joined_8da22fda:
    "Она опускается на четвереньки прямо рядом с девушкой по имени [other.girl.name], уже ухмыляясь."

# ch/hanna/petwalk.rpy:295
translate russian petwalk_hanna_bark_4617a084:
    mike.say "Голос, девочка."

# ch/hanna/petwalk.rpy:296
translate russian petwalk_hanna_bark_cc708b3e:
    hanna.say "Ты хочешь, чтобы я... залаяла? Вслух? Прямо здесь?"

# ch/hanna/petwalk.rpy:297
translate russian petwalk_hanna_bark_75d627f4:
    mike.say "Говори."

# ch/hanna/petwalk.rpy:298
translate russian petwalk_hanna_bark_e1a9118d:
    hanna.say "Гав."

# ch/hanna/petwalk.rpy:299
translate russian petwalk_hanna_bark_09b42475:
    mike.say "Это был шёпот."

# ch/hanna/petwalk.rpy:300
translate russian petwalk_hanna_bark_c3b322bd:
    hanna.say "ГАВ!"

# ch/hanna/petwalk.rpy:301
translate russian petwalk_hanna_bark_c06c712a:
    "Эхо отскакивает от каждой стены на улице."

# ch/hanna/petwalk.rpy:302
translate russian petwalk_hanna_bark_1de2e947:
    "Ханна втягивает голову и хихикает, уткнувшись в плечо."

# ch/hanna/petwalk.rpy:303
translate russian petwalk_hanna_bark_f698ca7b:
    hanna.say "Ой, мамочки, там было эхо. Было же эхо?"

# ch/hanna/petwalk.rpy:304
translate russian petwalk_hanna_bark_f8bff328:
    hanna.say "...Гав! Гав!"

# ch/hanna/petwalk.rpy:306
translate russian petwalk_hanna_bark_75d627f4_1:
    mike.say "Говори."

# ch/hanna/petwalk.rpy:307
translate russian petwalk_hanna_bark_c3b322bd_1:
    hanna.say "ГАВ!"

# ch/hanna/petwalk.rpy:309
translate russian petwalk_hanna_bark_d7b0d35e:
    "Она не колеблется ни секунды, и выходит так громко, что через пару домов отзывается настоящая собака."

# ch/hanna/petwalk.rpy:310
translate russian petwalk_hanna_bark_d397059e:
    hanna.say "Достаточно громко?"

# ch/hanna/petwalk.rpy:316
translate russian petwalk_hanna_tummy_66a1b995:
    "Я присаживаюсь и хлопаю себя по колену. Ханна понимает, чего я хочу, и краснеет до ушей."

# ch/hanna/petwalk.rpy:317
translate russian petwalk_hanna_tummy_d28fb5fd:
    "И всё же она перекатывается на спину, лапки кверху, выставив всё напоказ ночи."

# ch/hanna/petwalk.rpy:318
translate russian petwalk_hanna_tummy_27c2b5b5:
    hanna.say "Не смотри на меня так! Собаки ведь так делают, правда?"

# ch/hanna/petwalk.rpy:319
translate russian petwalk_hanna_tummy_9952e6b2:
    hanna.say "Это нормально. Для собак."

# ch/hanna/petwalk.rpy:320
translate russian petwalk_hanna_tummy_fdf1e377:
    "Её живот тёплый и упругий под моей ладонью."

# ch/hanna/petwalk.rpy:321
translate russian petwalk_hanna_tummy_fdc156d2:
    hanna.say "Ну? Не пялься на него просто так."

# ch/hanna/petwalk.rpy:322
translate russian petwalk_hanna_tummy_9afb1a42:
    "Тогда я чешу её чуть ниже рёбер, и её нога сама собой начинает дрыгаться."

# ch/hanna/petwalk.rpy:323
translate russian petwalk_hanna_tummy_989f012e:
    "Она сгорает от стыда, но остановить ногу даже не пытается."

# ch/hanna/petwalk.rpy:325
translate russian petwalk_hanna_tummy_5d78107a:
    "Не успеваю я присесть, как Ханна уже на спине, лапки кверху, и ухмыляется."

# ch/hanna/petwalk.rpy:326
translate russian petwalk_hanna_tummy_1cbc35e3:
    hanna.say "Ниже."

# ch/hanna/petwalk.rpy:327
translate russian petwalk_hanna_tummy_88fc092d:
    hanna.say "Ниже... вот тут."

# ch/hanna/petwalk.rpy:328
translate russian petwalk_hanna_tummy_dd5a537a:
    "Её нога молотит воздух, будто заведённая."

# ch/hanna/petwalk.rpy:334
translate russian petwalk_hanna_growl_2a24e6aa:
    mike.say "Рычи, девочка."

# ch/hanna/petwalk.rpy:335
translate russian petwalk_hanna_growl_d38bb2dd:
    hanna.say "На что?"

# ch/hanna/petwalk.rpy:336
translate russian petwalk_hanna_growl_e4205a5a:
    mike.say "Вон на ту тень. Там кто-то есть."

# ch/hanna/petwalk.rpy:337
translate russian petwalk_hanna_growl_00b038b1:
    hanna.say "Ррр."

# ch/hanna/petwalk.rpy:338
translate russian petwalk_hanna_growl_015abe6d:
    mike.say "Ханна. Это был котёнок."

# ch/hanna/petwalk.rpy:339
translate russian petwalk_hanna_growl_b35a5b20:
    "Следующий рык поднимается из самой глубины груди, низкий и злобный."

# ch/hanna/petwalk.rpy:340
translate russian petwalk_hanna_growl_c0d28add:
    "Потом она моргает, сама себе удивившись."

# ch/hanna/petwalk.rpy:341
translate russian petwalk_hanna_growl_084f3556:
    hanna.say "Откуда ЭТО взялось?"

# ch/hanna/petwalk.rpy:342
translate russian petwalk_hanna_growl_382f85fd:
    hanna.say "Мы все просто животные, [lssb_hanna.hero_name()]. Я всегда это говорила."

# ch/hanna/petwalk.rpy:344
translate russian petwalk_hanna_growl_e91a20d9:
    mike.say "Рычи."

# ch/hanna/petwalk.rpy:345
translate russian petwalk_hanna_growl_2eedda06:
    "Ханна опускает плечи и рычит в темноту, низко и зло, ни секунды не раздумывая."

# ch/hanna/petwalk.rpy:346
translate russian petwalk_hanna_growl_7c6e536c:
    hanna.say "Кто к тебе подойдёт — укушу."

# ch/hanna/petwalk.rpy:352
translate russian petwalk_hanna_pee_de0581d2:
    hanna.say "[lssb_hanna.hero_name()]... я, эм..."

# ch/hanna/petwalk.rpy:353
translate russian petwalk_hanna_pee_b615bab9:
    hanna.say "Как я уже говорила. Мне нужно в туалет."

# ch/hanna/petwalk.rpy:354
translate russian petwalk_hanna_pee_719ca1f6:
    "Она смотрит на дерево. Потом снова на меня."

# ch/hanna/petwalk.rpy:355
translate russian petwalk_hanna_pee_38c652c9:
    hanna.say "Здесь? Как настоящая собака?"

# ch/hanna/petwalk.rpy:356
translate russian petwalk_hanna_pee_fb5ffd51:
    mike.say "Собаки так и делают."

# ch/hanna/petwalk.rpy:357
translate russian petwalk_hanna_pee_152f07f2:
    "Долгое мгновение она не шевелится. Потом подползает и задирает ногу."

# ch/hanna/petwalk.rpy:359
translate russian petwalk_hanna_pee_9540e6b4:
    "В тишине этот звук кажется оглушительным."

# ch/hanna/petwalk.rpy:360
translate russian petwalk_hanna_pee_7a87fa0e:
    hanna.say "Не смотри!"

# ch/hanna/petwalk.rpy:361
translate russian petwalk_hanna_pee_c4569f62:
    hanna.say "Нет, стой. Смотри. Фу, я не знаю!"

# ch/hanna/petwalk.rpy:364
translate russian petwalk_hanna_pee_23153eaf:
    "Ханна трусит к дереву и задирает ногу так, будто всю жизнь только этим и занималась."

# ch/hanna/petwalk.rpy:365
translate russian petwalk_hanna_pee_9b47a0ed:
    hanna.say "Не торопи меня."

# ch/hanna/petwalk.rpy:371
translate russian petwalk_hanna_bj_park_26539819:
    hanna.say "Пожалуйста, [lssb_hanna.hero_name()]... я хочу поиграть!"

# ch/hanna/petwalk.rpy:372
translate russian petwalk_hanna_bj_park_cc03bf3c:
    hanna.say "Дашь мне поиграть с твоей палочкой?"

# ch/hanna/petwalk.rpy:374
translate russian petwalk_hanna_bj_park_924fea9c:
    "Я оглядываюсь в темноте. Никого."

# ch/hanna/petwalk.rpy:375
translate russian petwalk_hanna_bj_park_9c9ccafc:
    mike.say "Ладно. Ты сегодня была хорошей собакой."

# ch/hanna/petwalk.rpy:376
translate russian petwalk_hanna_bj_park_fc85481e:
    mike.say "Так что заслужила награду."

# ch/hanna/petwalk.rpy:377
translate russian petwalk_hanna_bj_park_c131ac58:
    "Она чуть ли не подпрыгивает на месте, а потом утягивает меня поглубже за кусты."

# ch/hanna/petwalk.rpy:378
translate russian petwalk_hanna_bj_park_52862c0a:
    hanna.say "Только вот здесь, сзади. Ладно?"

# ch/hanna/petwalk.rpy:381
translate russian petwalk_hanna_bj_park_0543eca2:
    hanna.say "Тот же куст, что и в прошлый раз?"

# ch/hanna/petwalk.rpy:382
translate russian petwalk_hanna_bj_park_1e6aae77:
    "Она уже у моей ширинки, а я даже не успел проверить дорожку."

# ch/hanna/petwalk.rpy:388
translate russian petwalk_hanna_bj_alley_395e9c33:
    "Двумя этажами выше у кого-то работает телевизор. Мне слышен закадровый смех."

# ch/hanna/petwalk.rpy:389
translate russian petwalk_hanna_bj_alley_01e0bbcd:
    hanna.say "Прямо здесь? Рядом с мусорным баком?"

# ch/hanna/petwalk.rpy:390
translate russian petwalk_hanna_bj_alley_cf2ee1f3:
    hanna.say "[lssb_hanna.hero_name()], это же... мерзко."

# ch/hanna/petwalk.rpy:391
translate russian petwalk_hanna_bj_alley_2a5c1dc4:
    "Пауза. Её взгляд скользит к освещённому окну."

# ch/hanna/petwalk.rpy:393
translate russian petwalk_hanna_bj_alley_816c66ad:
    hanna.say "...Давай."

# ch/hanna/petwalk.rpy:394
translate russian petwalk_hanna_bj_alley_14c6680a:
    hanna.say "Но если откроется окно, кончай быстро. Договорились?"

# ch/hanna/petwalk.rpy:397
translate russian petwalk_hanna_bj_alley_d8aad9f8:
    hanna.say "Быстрее, пока наверху не зажёгся свет."

# ch/hanna/petwalk.rpy:398
translate russian petwalk_hanna_bj_alley_353867c8:
    "Не похоже, что она хочет успеть до света."

# ch/hanna/petwalk.rpy:404
translate russian petwalk_hanna_bj_street_575c5d10:
    hanna.say "Прямо здесь? Под фонарём?"

# ch/hanna/petwalk.rpy:405
translate russian petwalk_hanna_bj_street_1d0e1b29:
    "Её взгляд мечется к дороге. Мимо с шипением медленно проезжает машина — и исчезает."

# ch/hanna/petwalk.rpy:407
translate russian petwalk_hanna_bj_street_aaf83d04:
    "Она сглатывает. Потом снова поднимает на меня глаза, и её лицо застывает."

# ch/hanna/petwalk.rpy:408
translate russian petwalk_hanna_bj_street_f46b92a8:
    hanna.say "Хорошо."

# ch/hanna/petwalk.rpy:409
translate russian petwalk_hanna_bj_street_1518b2e8:
    hanna.say "Если посигналят, буду считать это аплодисментами."

# ch/hanna/petwalk.rpy:411
translate russian petwalk_hanna_bj_street_3d38466e:
    "Я направляю её к тени у стены. Она тащит меня обратно под самый яркий фонарь в квартале."

# ch/hanna/petwalk.rpy:413
translate russian petwalk_hanna_bj_street_e6b238df:
    hanna.say "Здесь. Я хочу, чтобы было светло."

# ch/hanna/petwalk.rpy:419
translate russian petwalk_hanna_bj_crowd_f84a85e2:
    "Кто-то свистит. Загорается фонарик телефона, потом ещё три."

# ch/hanna/petwalk.rpy:420
translate russian petwalk_hanna_bj_crowd_969c4738:
    hanna.say "[lssb_hanna.hero_name()], они... они все смотрят."

# ch/hanna/petwalk.rpy:421
translate russian petwalk_hanna_bj_crowd_3e460cba:
    "Её пальцы дрожат на моём ремне."

# ch/hanna/petwalk.rpy:422
translate russian petwalk_hanna_bj_crowd_3b95167f:
    "Она смотрит на толпу, потом на меня. Того, что она видит на моём лице, ей хватает."

# ch/hanna/petwalk.rpy:423
translate russian petwalk_hanna_bj_crowd_2fda69c5:
    hanna.say "Я твоя собака."

# ch/hanna/petwalk.rpy:425
translate russian petwalk_hanna_bj_crowd_52a85aef:
    hanna.say "Пусть смотрят на твою собаку."

# ch/hanna/petwalk.rpy:428
translate russian petwalk_hanna_bj_crowd_0b58ed09:
    "Ханна смотрит прямо в объектив ближайшего телефона."

# ch/hanna/petwalk.rpy:429
translate russian petwalk_hanna_bj_crowd_db18e487:
    hanna.say "Надеюсь, вы всё снимаете."

# ch/hanna/petwalk.rpy:435
translate russian petwalk_hanna_bj_after_95b1a343:
    "Отдышавшись, Ханна поднимает на меня взгляд и вопросительно поскуливает."

# ch/hanna/petwalk.rpy:436
translate russian petwalk_hanna_bj_after_c4c13d69:
    hanna.say "Я... мне хорошо удалось?"

# ch/hanna/petwalk.rpy:437
translate russian petwalk_hanna_bj_after_7a0f08ce:
    hanna.say "Для собаки, в смысле."

# ch/hanna/petwalk.rpy:438
translate russian petwalk_hanna_bj_after_eb938ab3:
    "Я улыбаюсь и глажу её по голове."

# ch/hanna/petwalk.rpy:439
translate russian petwalk_hanna_bj_after_6ec1821c:
    mike.say "Лучшая собака на свете."

# ch/hanna/petwalk.rpy:440
translate russian petwalk_hanna_bj_after_d4c9a69e:
    "Она сияет так, что у неё виляет всё тело."

# ch/hanna/petwalk.rpy:442
translate russian petwalk_hanna_bj_after_d48a80ff:
    "Ханна медленно, напоказ облизывает губы."

# ch/hanna/petwalk.rpy:443
translate russian petwalk_hanna_bj_after_53e610aa:
    hanna.say "Ммм. Ещё тёплое."

# ch/hanna/petwalk.rpy:449
translate russian petwalk_hanna_outro_9c525ad5:
    "Ханна без команды встаёт к ноге, и мы направляемся домой."

# ch/hanna/petwalk.rpy:450
translate russian petwalk_hanna_outro_f41a5eb7:
    "Я машинально глажу её по голове. Она прижимается к моей ладони."

# ch/hanna/petwalk.rpy:451
translate russian petwalk_hanna_outro_d65f48cf:
    "Я это запоминаю."

# ch/hanna/petwalk.rpy:452
translate russian petwalk_hanna_outro_3171a1bc:
    hanna.say "[lssb_hanna.hero_name()]... можно тебе кое-что сказать?"

# ch/hanna/petwalk.rpy:453
translate russian petwalk_hanna_outro_73e20b12:
    hanna.say "Мне никогда в жизни не было так страшно."

# ch/hanna/petwalk.rpy:454
translate russian petwalk_hanna_outro_2420b43c:
    hanna.say "И я хочу повторить."

# ch/hanna/petwalk.rpy:455
translate russian petwalk_hanna_outro_ee4d17bf:
    "Она говорит это тротуару, а не мне. Щёки у неё пылают."

# ch/hanna/petwalk.rpy:456
translate russian petwalk_hanna_outro_e2a4657d:
    "Всю дорогу я запоминаю, как она выглядит на поводке, каждый шаг."

# ch/hanna/petwalk.rpy:458
translate russian petwalk_hanna_outro_9037fefd:
    "Ханну всё ещё потряхивает от восторга всю обратную дорогу: она тяжело дышит, поводок между нами провисает."

# ch/hanna/petwalk.rpy:459
translate russian petwalk_hanna_outro_35647bda:
    hanna.say "В то же время через неделю?"

# ch/hanna/petwalk.rpy:460
translate russian petwalk_hanna_outro_cd1f135c:
    mike.say "Если будешь хорошо себя вести."

# ch/hanna/petwalk.rpy:461
translate russian petwalk_hanna_outro_ab059feb:
    hanna.say "Я ВСЕГДА хорошо себя веду."

# ch/hanna/petwalk.rpy:468
translate russian petwalk_hanna_ask_6ad2356e:
    "Ханна уже минут десять топчется у двери, делая вид, что смотрит в телефон."

# ch/hanna/petwalk.rpy:470
translate russian petwalk_hanna_ask_bf29c997:
    hanna.say "Так вот, эм. [lssb_hanna.hero_name()]."

# ch/hanna/petwalk.rpy:471
translate russian petwalk_hanna_ask_403339cd:
    hanna.say "Я весь день была хорошей. Ну, прям очень хорошей."

# ch/hanna/petwalk.rpy:472
translate russian petwalk_hanna_ask_a962ba5f:
    hanna.say "Вот я и подумала... может... если ты не занят..."

# ch/hanna/petwalk.rpy:474
translate russian petwalk_hanna_ask_e1ea5168:
    "Она вынимает руку из-за спины — в ней поводок."

# ch/hanna/petwalk.rpy:476
translate russian petwalk_hanna_ask_49e484c2:
    hanna.say "Не выгуляешь свою сучку?"

# ch/hanna/petwalk.rpy:478
translate russian petwalk_hanna_ask_fe21f951:
    "Её лицо становится цвета знака «стоп»."

# ch/hanna/petwalk.rpy:480
translate russian petwalk_hanna_ask_3f92d318:
    hanna.say "Гулять... пожалуйста?"

# ch/hanna/petwalk.rpy:484
translate russian petwalk_hanna_ask_30088de3:
    "Ханна прислоняется к дверному косяку, покачивая поводком на пальце."

# ch/hanna/petwalk.rpy:486
translate russian petwalk_hanna_ask_376a754c:
    hanna.say "Гулять?"

# ch/hanna/petwalk.rpy:488
translate russian petwalk_hanna_ask_2b74bfad:
    hanna.say "Твоя сучка весь день ждала, [lssb_hanna.hero_name()]."

# ch/hanna/petwalk.rpy:495
translate russian petwalk_hanna_bark_alley_7f05991e:
    "Над мусорными баками светится окно, шторы раздвинуты. Внутри кто-то ходит."

# ch/hanna/petwalk.rpy:496
translate russian petwalk_hanna_bark_alley_4617a084:
    mike.say "Голос, девочка."

# ch/hanna/petwalk.rpy:497
translate russian petwalk_hanna_bark_alley_67c58369:
    hanna.say "Под ОКНОМ? [lssb_hanna.hero_name()], они же услышат!"

# ch/hanna/petwalk.rpy:498
translate russian petwalk_hanna_bark_alley_5067c788:
    mike.say "На то и расчёт."

# ch/hanna/petwalk.rpy:499
translate russian petwalk_hanna_bark_alley_e9730b7a:
    hanna.say "Гав!"

# ch/hanna/petwalk.rpy:500
translate russian petwalk_hanna_bark_alley_c77bf559:
    "Тень за стеклом перестаёт двигаться. Ханна вжимается в стену и задерживает дыхание."

# ch/hanna/petwalk.rpy:501
translate russian petwalk_hanna_bark_alley_2d6a4b0b:
    "Потом штора дёргается, и она лает снова, прежде чем я успеваю попросить."

# ch/hanna/petwalk.rpy:502
translate russian petwalk_hanna_bark_alley_016913f0:
    hanna.say "Ой, мамочки. Не знаю, зачем я это сделала."

# ch/hanna/petwalk.rpy:504
translate russian petwalk_hanna_bark_alley_9530779e:
    "Ханна сама останавливается под освещённым окном."

# ch/hanna/petwalk.rpy:505
translate russian petwalk_hanna_bark_alley_83b7e69f:
    hanna.say "Гав! Гав!"

# ch/hanna/petwalk.rpy:506
translate russian petwalk_hanna_bark_alley_1aa9f344:
    "Кто-то внутри стучит по стеклу. Она убегает трусцой, виляя попой, очень довольная собой."

# ch/hanna/petwalk.rpy:512
translate russian petwalk_hanna_bark_street_611591e0:
    "У магазинчика на углу курит парочка. Я останавливаю нас под фонарём прямо напротив них."

# ch/hanna/petwalk.rpy:513
translate russian petwalk_hanna_bark_street_75d627f4:
    mike.say "Говори."

# ch/hanna/petwalk.rpy:514
translate russian petwalk_hanna_bark_street_47828127:
    hanna.say "[lssb_hanna.hero_name()]... они же прямо тут. Они смотрят."

# ch/hanna/petwalk.rpy:515
translate russian petwalk_hanna_bark_street_4617a084:
    mike.say "Голос, девочка."

# ch/hanna/petwalk.rpy:516
translate russian petwalk_hanna_bark_street_c3b322bd:
    hanna.say "ГАВ!"

# ch/hanna/petwalk.rpy:517
translate russian petwalk_hanna_bark_street_56624bc2:
    "Парень роняет сигарету. Его девушка хватает его за руку."

# ch/hanna/petwalk.rpy:518
translate russian petwalk_hanna_bark_street_849ca556:
    "Passer-by" "Она что... на нас гавкнула?"

# ch/hanna/petwalk.rpy:519
translate russian petwalk_hanna_bark_street_61636357:
    hanna.say "Да! То есть... гав."

# ch/hanna/petwalk.rpy:520
translate russian petwalk_hanna_bark_street_c1972838:
    "Она ухмыляется так широко, что приходится прятать лицо в плечо."

# ch/hanna/petwalk.rpy:522
translate russian petwalk_hanna_bark_street_a91adbc8:
    "Рядом с нами на светофоре стоит машина с опущенным стеклом."

# ch/hanna/petwalk.rpy:523
translate russian petwalk_hanna_bark_street_75d627f4_1:
    mike.say "Говори."

# ch/hanna/petwalk.rpy:524
translate russian petwalk_hanna_bark_street_36ad3427:
    hanna.say "ГАВ! ГАВ!"

# ch/hanna/petwalk.rpy:526
translate russian petwalk_hanna_bark_street_6b371f95:
    "Водитель сигналит в ответ. Ханна лает громче."

# ch/hanna/petwalk.rpy:532
translate russian petwalk_hanna_bark_crowd_0036d264:
    "У баров толпа стеной. Стоит мне остановиться, как вокруг нас образуется круг."

# ch/hanna/petwalk.rpy:533
translate russian petwalk_hanna_bark_crowd_4617a084:
    mike.say "Голос, девочка."

# ch/hanna/petwalk.rpy:534
translate russian petwalk_hanna_bark_crowd_0f37ad08:
    "Телефоны поднимаются ещё до того, как она издаёт хоть звук."

# ch/hanna/petwalk.rpy:535
translate russian petwalk_hanna_bark_crowd_2408dfe4:
    "Passer-by" "Давай, щеночек! Голос!"

# ch/hanna/petwalk.rpy:536
translate russian petwalk_hanna_bark_crowd_c3b322bd:
    hanna.say "ГАВ!"

# ch/hanna/petwalk.rpy:538
translate russian petwalk_hanna_bark_crowd_df2a40dc:
    "Выходит так громко, что вся улица ликует."

# ch/hanna/petwalk.rpy:539
translate russian petwalk_hanna_bark_crowd_7b4cf305:
    "Потом она оглядывает все направленные на неё телефоны, и у неё краснеют уши."

# ch/hanna/petwalk.rpy:540
translate russian petwalk_hanna_bark_crowd_828e9344:
    "Passer-by" "Ещё! Давай ещё!"

# ch/hanna/petwalk.rpy:541
translate russian petwalk_hanna_bark_crowd_a7e9f3d3:
    hanna.say "...Гав?"

# ch/hanna/petwalk.rpy:543
translate russian petwalk_hanna_bark_crowd_dcd95833:
    "Толпа уже знает, что к чему. Кто-то выкрикивает команду раньше меня."

# ch/hanna/petwalk.rpy:544
translate russian petwalk_hanna_bark_crowd_fc77dcc3:
    "Passer-by" "Голос!"

# ch/hanna/petwalk.rpy:545
translate russian petwalk_hanna_bark_crowd_724bc8c4:
    hanna.say "ГАВ! ГАВ! ГАВ!"

# ch/hanna/petwalk.rpy:547
translate russian petwalk_hanna_bark_crowd_0e9ce561:
    "Она лает на каждый направленный на неё телефон и за каждый получает в ответ восторженный вопль."

# ch/hanna/petwalk.rpy:553
translate russian petwalk_hanna_tummy_alley_9b05cbbd:
    "На полпути по переулку я присаживаюсь и хлопаю себя по колену."

# ch/hanna/petwalk.rpy:554
translate russian petwalk_hanna_tummy_alley_efb7a611:
    hanna.say "Здесь? На земле?"

# ch/hanna/petwalk.rpy:555
translate russian petwalk_hanna_tummy_alley_070d02b3:
    "Но она всё равно перекатывается на спину, лапки кверху, прямо под освещённым окном."

# ch/hanna/petwalk.rpy:556
translate russian petwalk_hanna_tummy_alley_aa7a3803:
    "Я начинаю чесать. Над нами со скрипом поднимается оконная рама."

# ch/hanna/petwalk.rpy:557
translate russian petwalk_hanna_tummy_alley_f97f4f74:
    "Мужчина высовывается стряхнуть пепел, смотрит вниз и замирает."

# ch/hanna/petwalk.rpy:558
translate russian petwalk_hanna_tummy_alley_8b8d2e0d:
    hanna.say "[lssb_hanna.hero_name()]. [lssb_hanna.hero_name()], там мужик."

# ch/hanna/petwalk.rpy:559
translate russian petwalk_hanna_tummy_alley_9e97233d:
    mike.say "Лежать."

# ch/hanna/petwalk.rpy:560
translate russian petwalk_hanna_tummy_alley_d2be634f:
    "Она лежит. Её нога начинает дрыгаться, и окно очень медленно закрывается."

# ch/hanna/petwalk.rpy:562
translate russian petwalk_hanna_tummy_alley_16d2fdda:
    "Ханна без просьбы перекатывается на спину под освещённым окном, растянувшись на холодном асфальте."

# ch/hanna/petwalk.rpy:563
translate russian petwalk_hanna_tummy_alley_e49dad06:
    hanna.say "Чеши медленнее. Дай им время подойти к окну."

# ch/hanna/petwalk.rpy:569
translate russian petwalk_hanna_tummy_street_26751cc9:
    "Ханна останавливается под фонарём, оглядывает улицу в обе стороны и перекатывается на спину прямо на тротуаре."

# ch/hanna/petwalk.rpy:570
translate russian petwalk_hanna_tummy_street_9f2ad5d6:
    hanna.say "Быстрее, пока никто не пришёл."

# ch/hanna/petwalk.rpy:571
translate russian petwalk_hanna_tummy_street_b7760456:
    "Кто-то приходит. Женщина на каблуках, идущая домой, застывает как вкопанная в паре шагов."

# ch/hanna/petwalk.rpy:572
translate russian petwalk_hanna_tummy_street_630a638a:
    "Passer-by" "Боже мой. С ней всё в порядке?"

# ch/hanna/petwalk.rpy:573
translate russian petwalk_hanna_tummy_street_05c704ec:
    mike.say "Всё хорошо. Она любит, когда ей чешут животик."

# ch/hanna/petwalk.rpy:574
translate russian petwalk_hanna_tummy_street_b051e0b7:
    "Ханна зажмуривается и краснеет до самых ключиц."

# ch/hanna/petwalk.rpy:575
translate russian petwalk_hanna_tummy_street_c7de8dce:
    "Но когда я чешу ей под рёбрами, нога всё равно дрыгается — прямо там, в свете фонаря."

# ch/hanna/petwalk.rpy:576
translate russian petwalk_hanna_tummy_street_f0ff9681:
    "Женщина идёт дальше. Дважды оглядывается."

# ch/hanna/petwalk.rpy:577
translate russian petwalk_hanna_tummy_street_b2885245:
    hanna.say "Ой, мамочки. Она оглянулась. Зачем она оглянулась?"

# ch/hanna/petwalk.rpy:579
translate russian petwalk_hanna_tummy_street_425b6a7c:
    "Ханна перекатывается на спину на тротуаре, едва какая-то машина сбавляет скорость."

# ch/hanna/petwalk.rpy:580
translate russian petwalk_hanna_tummy_street_ed82cb31:
    "Та ползёт мимо со скоростью пешехода. Ханна выгибает для неё спину, дрыгая ногой в воздухе."

# ch/hanna/petwalk.rpy:581
translate russian petwalk_hanna_tummy_street_476273a0:
    hanna.say "Он всё ещё смотрит?"

# ch/hanna/petwalk.rpy:587
translate russian petwalk_hanna_tummy_crowd_5147ffca:
    "Прямо посреди толпы я присаживаюсь и хлопаю себя по колену. Ханна смотрит на меня так, будто я спятил."

# ch/hanna/petwalk.rpy:588
translate russian petwalk_hanna_tummy_crowd_1eb953cf:
    hanna.say "[lssb_hanna.hero_name()]... на СПИНУ? При них всех?"

# ch/hanna/petwalk.rpy:589
translate russian petwalk_hanna_tummy_crowd_3671b5d1:
    mike.say "Перевернись."

# ch/hanna/petwalk.rpy:590
translate russian petwalk_hanna_tummy_crowd_6db7ea78:
    "Она переворачивается. Животом кверху, всё напоказ — кольцу незнакомцев с их телефонами."

# ch/hanna/petwalk.rpy:591
translate russian petwalk_hanna_tummy_crowd_4ab976b8:
    "Passer-by" "Обалдеть, она правда это делает!"

# ch/hanna/petwalk.rpy:592
translate russian petwalk_hanna_tummy_crowd_e962563a:
    "Passer-by" "Почеши ей пузико, мужик! Давай!"

# ch/hanna/petwalk.rpy:594
translate russian petwalk_hanna_tummy_crowd_45647157:
    "Я чешу. Её нога дрыгается, толпа взрывается, и кто-то начинает медленно хлопать."

# ch/hanna/petwalk.rpy:595
translate russian petwalk_hanna_tummy_crowd_5e0b93c4:
    hanna.say "Не останавливайся, [lssb_hanna.hero_name()]. Только попробуй остановиться."

# ch/hanna/petwalk.rpy:597
translate russian petwalk_hanna_tummy_crowd_0e0d8c31:
    "Ханна плюхается на спину посреди толпы и вытягивается перед телефонами."

# ch/hanna/petwalk.rpy:598
translate russian petwalk_hanna_tummy_crowd_2012bcc2:
    "Passer-by" "Хорошая девочка!"

# ch/hanna/petwalk.rpy:599
translate russian petwalk_hanna_tummy_crowd_90b2ce0a:
    hanna.say "Сама знаю!"

# ch/hanna/petwalk.rpy:606
translate russian petwalk_hanna_growl_alley_bca595d1:
    "В конце переулка со скрипом открывается задняя дверь. Выходит мужчина в кухонном фартуке с мешком мусора и останавливается."

# ch/hanna/petwalk.rpy:607
translate russian petwalk_hanna_growl_alley_2a24e6aa:
    mike.say "Рычи, девочка."

# ch/hanna/petwalk.rpy:608
translate russian petwalk_hanna_growl_alley_c99ea1b5:
    hanna.say "На НЕГО? [lssb_hanna.hero_name()], он просто выносит мусор!"

# ch/hanna/petwalk.rpy:609
translate russian petwalk_hanna_growl_alley_e91a20d9:
    mike.say "Рычи."

# ch/hanna/petwalk.rpy:610
translate russian petwalk_hanna_growl_alley_3abbff6f:
    "Начинается тихо. Потом рык опускается в грудь, низкий и злобный, и прокатывается по всему переулку."

# ch/hanna/petwalk.rpy:612
translate russian petwalk_hanna_growl_alley_13c12c63:
    "Мужчина делает шаг назад. Потом ещё один. Дверь с грохотом захлопывается."

# ch/hanna/petwalk.rpy:613
translate russian petwalk_hanna_growl_alley_b10e400d:
    hanna.say "Ой, мамочки. Я напугала мужика."

# ch/hanna/petwalk.rpy:614
translate russian petwalk_hanna_growl_alley_fc05051c:
    hanna.say "...Я напугала мужика. Это было потрясающе."

# ch/hanna/petwalk.rpy:616
translate russian petwalk_hanna_growl_alley_4918815c:
    "За мусорным баком что-то шевелится. Ханна рычит на это раньше, чем я открываю рот."

# ch/hanna/petwalk.rpy:617
translate russian petwalk_hanna_growl_alley_f47cdfd3:
    hanna.say "Крыса или грабитель — мне всё равно. Никто к тебе не подойдёт."

# ch/hanna/petwalk.rpy:623
translate russian petwalk_hanna_growl_street_638fb7b0:
    "Парень на другой стороне дороги свистит нам вслед, потом направляется к нам, уже с телефоном в руке."

# ch/hanna/petwalk.rpy:624
translate russian petwalk_hanna_growl_street_e91a20d9:
    mike.say "Рычи."

# ch/hanna/petwalk.rpy:625
translate russian petwalk_hanna_growl_street_23cd9169:
    "Ханна опускает плечи, упирается руками, и звук, который из неё вырывается, останавливает его посреди дороги."

# ch/hanna/petwalk.rpy:626
translate russian petwalk_hanna_growl_street_cbf0c68a:
    "Passer-by" "Ого. Ладно. Ладно, психованная."

# ch/hanna/petwalk.rpy:627
translate russian petwalk_hanna_growl_street_70f61546:
    "Он отступает на свой тротуар с поднятыми руками."

# ch/hanna/petwalk.rpy:628
translate russian petwalk_hanna_growl_street_bf8b81a7:
    hanna.say "Ты видел его лицо, [lssb_hanna.hero_name()]?"

# ch/hanna/petwalk.rpy:629
translate russian petwalk_hanna_growl_street_6f8b72c4:
    hanna.say "Это я сделала. Я."

# ch/hanna/petwalk.rpy:630
translate russian petwalk_hanna_growl_street_b3938d71:
    "Её всю трясёт, и она не может перестать улыбаться."

# ch/hanna/petwalk.rpy:632
translate russian petwalk_hanna_growl_street_2c936365:
    "Рядом с нами притормаживает машина, чтобы получше рассмотреть."

# ch/hanna/petwalk.rpy:633
translate russian petwalk_hanna_growl_street_c65cda22:
    "Ханна поворачивается и рычит прямо в открытое окно. Машина срывается с места."

# ch/hanna/petwalk.rpy:634
translate russian petwalk_hanna_growl_street_a7fe62c0:
    hanna.say "Езжай дальше, извращенец."

# ch/hanna/petwalk.rpy:640
translate russian petwalk_hanna_growl_crowd_87367c4c:
    "Из толпы выходит парень и тянется погладить её по голове, будто она чья угодно собака."

# ch/hanna/petwalk.rpy:641
translate russian petwalk_hanna_growl_crowd_e91a20d9:
    mike.say "Рычи."

# ch/hanna/petwalk.rpy:642
translate russian petwalk_hanna_growl_crowd_909ef253:
    "Ханна скалит зубы, и он отдёргивает руку, будто коснулся плиты."

# ch/hanna/petwalk.rpy:644
translate russian petwalk_hanna_growl_crowd_abbb0954:
    "Толпа воет от восторга. Все телефоны разворачиваются, чтобы это заснять."

# ch/hanna/petwalk.rpy:645
translate russian petwalk_hanna_growl_crowd_5b5fb588:
    "Passer-by" "Плохая собака! Кто-нибудь, поставьте её в угол!"

# ch/hanna/petwalk.rpy:646
translate russian petwalk_hanna_growl_crowd_0d2a338d:
    "Passer-by" "Чувак, она тебе чуть руку не откусила."

# ch/hanna/petwalk.rpy:647
translate russian petwalk_hanna_growl_crowd_9807df10:
    "У Ханны краснеют уши."

# ch/hanna/petwalk.rpy:648
translate russian petwalk_hanna_growl_crowd_03826d05:
    hanna.say "[lssb_hanna.hero_name()]... они все меня снимают."

# ch/hanna/petwalk.rpy:649
translate russian petwalk_hanna_growl_crowd_5ffadca1:
    "Она сглатывает. А потом поворачивается и рычит на всех них, на каждый телефон."

# ch/hanna/petwalk.rpy:651
translate russian petwalk_hanna_growl_crowd_ba858518:
    "Кто-то в толпе тянется к ней. Ханна рычит прежде, чем мне приходится сказать хоть слово."

# ch/hanna/petwalk.rpy:652
translate russian petwalk_hanna_growl_crowd_1c8c4f1e:
    "Passer-by" "Сторожевая собака! Уважаю!"

# ch/hanna/petwalk.rpy:653
translate russian petwalk_hanna_growl_crowd_bd33249d:
    hanna.say "Руки прочь. Гладить меня может только [heroname]."

# ch/hanna/petwalk.rpy:659
translate russian petwalk_hanna_pee_alley_b971b5ea:
    hanna.say "[lssb_hanna.hero_name()]... мне надо в туалет."

# ch/hanna/petwalk.rpy:660
translate russian petwalk_hanna_pee_alley_0c52bfac:
    "Она поглядывает на водосточную трубу у задней двери. Прямо над ней кухонное окно, запотевшее и освещённое."

# ch/hanna/petwalk.rpy:661
translate russian petwalk_hanna_pee_alley_23c28db1:
    hanna.say "Там? Прямо под их окном?"

# ch/hanna/petwalk.rpy:662
translate russian petwalk_hanna_pee_alley_360546c7:
    mike.say "Давай, девочка."

# ch/hanna/petwalk.rpy:663
translate russian petwalk_hanna_pee_alley_e54bc865:
    "Она медленно подползает и задирает ногу у стены."

# ch/hanna/petwalk.rpy:665
translate russian petwalk_hanna_pee_alley_42f45ee5:
    "Звук бьёт по кирпичу, и внутри стихает грохот кастрюль."

# ch/hanna/petwalk.rpy:666
translate russian petwalk_hanna_pee_alley_43fc371c:
    hanna.say "Не открывайте окно. Пожалуйста, не открывайте окно..."

# ch/hanna/petwalk.rpy:667
translate russian petwalk_hanna_pee_alley_a2b64aab:
    "Никто не открывает. Закончив, она тяжело дышит и не смотрит на меня."

# ch/hanna/petwalk.rpy:670
translate russian petwalk_hanna_pee_alley_3c7bc9b8:
    "Ханна снова выбирает трубу под освещённым окном и без спроса задирает ногу."

# ch/hanna/petwalk.rpy:671
translate russian petwalk_hanna_pee_alley_4aac5d56:
    hanna.say "Кто-нибудь там однажды всё поймёт."

# ch/hanna/petwalk.rpy:672
translate russian petwalk_hanna_pee_alley_cf120eaa:
    "Не похоже, чтобы её это беспокоило."

# ch/hanna/petwalk.rpy:678
translate russian petwalk_hanna_pee_street_8dbb8a8c:
    "Ханна останавливается у фонарного столба на углу и смотрит на меня."

# ch/hanna/petwalk.rpy:679
translate russian petwalk_hanna_pee_street_f4c165a3:
    hanna.say "[lssb_hanna.hero_name()]. Мне правда очень надо."

# ch/hanna/petwalk.rpy:680
translate russian petwalk_hanna_pee_street_503c99a8:
    mike.say "Так иди."

# ch/hanna/petwalk.rpy:681
translate russian petwalk_hanna_pee_street_c6b0dfca:
    hanna.say "ЗДЕСЬ? Тут же остановка рядом!"

# ch/hanna/petwalk.rpy:682
translate russian petwalk_hanna_pee_street_14e9388c:
    "И правда. А на ней сидит женщина и пялится."

# ch/hanna/petwalk.rpy:684
translate russian petwalk_hanna_pee_street_9f648a8a:
    "Лицо Ханны пылает. Но она упирается руками и высоко задирает ногу у столба, прямо в свете фонаря."

# ch/hanna/petwalk.rpy:685
translate russian petwalk_hanna_pee_street_eec6c3f8:
    "Passer-by" "Да вы, должно быть, издеваетесь."

# ch/hanna/petwalk.rpy:686
translate russian petwalk_hanna_pee_street_fd43d7b3:
    "Мимо медленно проезжает машина, фары выхватывают всё до мелочей. Кто-то внутри улюлюкает."

# ch/hanna/petwalk.rpy:687
translate russian petwalk_hanna_pee_street_67815069:
    hanna.say "Ой, мамочки. Ой, мамочки, я уже не могу остановиться!"

# ch/hanna/petwalk.rpy:690
translate russian petwalk_hanna_pee_street_09305876:
    "Ханна выбирает фонарь поближе к остановке и задирает ногу — высоко и уверенно."

# ch/hanna/petwalk.rpy:691
translate russian petwalk_hanna_pee_street_3c7b2b43:
    "Passer-by" "Только не опять..."

# ch/hanna/petwalk.rpy:692
translate russian petwalk_hanna_pee_street_abf41acd:
    hanna.say "Добрый вечер!"

# ch/hanna/petwalk.rpy:698
translate russian petwalk_hanna_pee_crowd_8c84fbb1:
    "Мы в самой гуще толпы, когда Ханна утыкается лицом мне в ногу."

# ch/hanna/petwalk.rpy:699
translate russian petwalk_hanna_pee_crowd_8ad9609e:
    hanna.say "[lssb_hanna.hero_name()]... мне надо пописать. Очень."

# ch/hanna/petwalk.rpy:700
translate russian petwalk_hanna_pee_crowd_a59d2891:
    "У бордюра в квадрате земли растёт одно тощее деревце, а вокруг него человек пятьдесят."

# ch/hanna/petwalk.rpy:701
translate russian petwalk_hanna_pee_crowd_fc25663a:
    hanna.say "Все увидят. Все это СНИМУТ."

# ch/hanna/petwalk.rpy:702
translate russian petwalk_hanna_pee_crowd_212cbf6d:
    mike.say "Хорошая девочка. Давай."

# ch/hanna/petwalk.rpy:705
translate russian petwalk_hanna_pee_crowd_df9de721:
    "Она подползает и высоко задирает ногу. Улица замирает в мёртвой тишине, а потом взрывается, телефоны повсюду."

# ch/hanna/petwalk.rpy:706
translate russian petwalk_hanna_pee_crowd_c2fa95ea:
    "Passer-by" "Да НУ НАФИГ! Она правда это делает!"

# ch/hanna/petwalk.rpy:707
translate russian petwalk_hanna_pee_crowd_a2bb6a78:
    "Ханна зажмуривается. Но ногу не опускает."

# ch/hanna/petwalk.rpy:708
translate russian petwalk_hanna_pee_crowd_f5824e2d:
    hanna.say "Просто держи поводок, [lssb_hanna.hero_name()]. Ладно?"

# ch/hanna/petwalk.rpy:711
translate russian petwalk_hanna_pee_crowd_0b2b7017:
    "Ханна направляется к дереву посреди толпы и задирает ногу, пока никто не заметил."

# ch/hanna/petwalk.rpy:713
translate russian petwalk_hanna_pee_crowd_c8d7d770:
    "Потом замечают. Поднимается рёв восторга, а вместе с ним и телефоны."

# ch/hanna/petwalk.rpy:714
translate russian petwalk_hanna_pee_crowd_400de7a5:
    hanna.say "Ладно! Ладно, хватит хлопать!"

# ch/hanna/petwalk.rpy:721
translate russian petwalk_hanna_bj_after_alley_30684e2e:
    "Ханна садится на пятки, тяжело дыша, сперма блестит у неё на подбородке."

# ch/hanna/petwalk.rpy:722
translate russian petwalk_hanna_bj_after_alley_5328c45e:
    "Наверху свет в окне погас. Штора всё ещё раздвинута."

# ch/hanna/petwalk.rpy:723
translate russian petwalk_hanna_bj_after_alley_91e28420:
    hanna.say "[lssb_hanna.hero_name()]... там что, всё это время кто-то был?"

# ch/hanna/petwalk.rpy:724
translate russian petwalk_hanna_bj_after_alley_806cc9e5:
    mike.say "Наверное."

# ch/hanna/petwalk.rpy:726
translate russian petwalk_hanna_bj_after_alley_a5998616:
    hanna.say "Ой, мамочки. Думаешь, для них я тоже была хорошей девочкой?"

# ch/hanna/petwalk.rpy:729
translate russian petwalk_hanna_bj_after_alley_b65cfe14:
    "Ханна слизывает вкус с губ и машет тёмному окну."

# ch/hanna/petwalk.rpy:730
translate russian petwalk_hanna_bj_after_alley_0db4ac59:
    hanna.say "Завтра в то же время!"

# ch/hanna/petwalk.rpy:736
translate russian petwalk_hanna_bj_after_street_1873d6f1:
    "На другой стороне дороги стоит машина с работающим двигателем, фары всё ещё направлены на нас."

# ch/hanna/petwalk.rpy:738
translate russian petwalk_hanna_bj_after_street_ece75cff:
    "Ханна смотрит прямо в них — сперма на подбородке, дыхание ещё не восстановилось."

# ch/hanna/petwalk.rpy:740
translate russian petwalk_hanna_bj_after_street_d4bfc200:
    "Водитель дважды коротко сигналит и уезжает."

# ch/hanna/petwalk.rpy:741
translate russian petwalk_hanna_bj_after_street_79ce3c42:
    hanna.say "Это ведь были аплодисменты, да? Я же говорила, что буду считать это аплодисментами."

# ch/hanna/petwalk.rpy:742
translate russian petwalk_hanna_bj_after_street_e4786d87:
    mike.say "Хорошая девочка."

# ch/hanna/petwalk.rpy:743
translate russian petwalk_hanna_bj_after_street_ca47445c:
    hanna.say "Лучшая девочка. На всей улице."

# ch/hanna/petwalk.rpy:746
translate russian petwalk_hanna_bj_after_street_d3b49526:
    "Ханна не торопясь вылизывает губы дочиста, а парень на другой стороне дороги просто стоит и смотрит."

# ch/hanna/petwalk.rpy:747
translate russian petwalk_hanna_bj_after_street_0a6a27f8:
    hanna.say "Шоу окончено, приятель."

# ch/hanna/petwalk.rpy:754
translate russian petwalk_hanna_bj_after_crowd_9aad3781:
    "Толпа всё ещё ликует. Кто-то свистит в пальцы."

# ch/hanna/petwalk.rpy:756
translate russian petwalk_hanna_bj_after_crowd_06f81b56:
    "Ханна поднимает на меня взгляд со спермой на подбородке, и все телефоны берут крупный план."

# ch/hanna/petwalk.rpy:757
translate russian petwalk_hanna_bj_after_crowd_9e52470a:
    "Passer-by" "Охренеть! Скажите, что кто-то это снял!"

# ch/hanna/petwalk.rpy:758
translate russian petwalk_hanna_bj_after_crowd_d77015b1:
    hanna.say "Ой, мамочки, [lssb_hanna.hero_name()]... завтра это будет везде."

# ch/hanna/petwalk.rpy:759
translate russian petwalk_hanna_bj_after_crowd_e4786d87:
    mike.say "Хорошая девочка."

# ch/hanna/petwalk.rpy:760
translate russian petwalk_hanna_bj_after_crowd_531f9231:
    hanna.say "...Лучшая девочка. Проследите, чтобы это тоже попало в кадр."

# ch/hanna/petwalk.rpy:763
translate russian petwalk_hanna_bj_after_crowd_15a70e5f:
    "Ханна медленно слизывает с губ остатки вкуса — для первого ряда."

# ch/hanna/petwalk.rpy:764
translate russian petwalk_hanna_bj_after_crowd_fc0a1f87:
    "Passer-by" "Бис!"

# ch/hanna/reactions.rpy:385
translate russian hanna_life_fitness_male_78ecad53:
    hanna.say "Посмотри на эти плечи! Ты ведь хорошо поработал, да?"

# ch/hanna/reactions.rpy:387
translate russian hanna_life_fitness_male_ca68e614:
    hanna.say "Мне нравится, как ты следишь за своим телом. То есть я... мне нравится это с тренерской точки зрения! В основном."

# ch/hanna/reactions.rpy:395
translate russian hanna_act_refuse_male_936b3df3:
    hanna.say "Эй, ты куда его суёшь?!?"

# ch/hanna/reactions.rpy:396
translate russian hanna_act_refuse_male_b1c172f7:
    hanna.say "Я... я к этому ещё не готова, [lssb_hanna.hero_name()]!"

# ch/hanna/reactions.rpy:398
translate russian hanna_act_refuse_male_c115fbd9:
    hanna.say "П... подожди, [lssb_hanna.hero_name()], ты так торопишься!"

# ch/hanna/reactions.rpy:399
translate russian hanna_act_refuse_male_0f3c5933:
    hanna.say "По-моему, мы до этого ещё не дошли. Не то чтобы я не хотела, просто... ой, мамочки!"

# ch/hanna/reactions.rpy:405
translate russian hanna_act_refuse_hard_male_5537b8ca:
    hanna.say "Ого... я... поверить не могу, что ты вообще об этом попросил!"

# ch/hanna/reactions.rpy:406
translate russian hanna_act_refuse_hard_male_567af0f7:
    hanna.say "Это так обламывает весь настрой, [lssb_hanna.hero_name()]!"

# ch/hanna/reactions.rpy:407
translate russian hanna_act_refuse_hard_male_8bcff2aa:
    "Ханна встаёт и собирает разбросанную одежду."

# ch/hanna/reactions.rpy:408
translate russian hanna_act_refuse_hard_male_5c42ed13:
    hanna.say "Тогда в другой раз... может быть."

# ch/hanna/talk.rpy:6
translate russian hanna_talk_love_male_ab0f8eec:
    hanna.say "Я ради тебя ушла с собственной свадьбы, [lssb_hanna.hero_name()]. В платье, у всех на глазах."

# ch/hanna/talk.rpy:7
translate russian hanna_talk_love_male_d869bb93:
    hanna.say "Так что, думаю, у меня есть право спросить."

# ch/hanna/talk.rpy:9
translate russian hanna_talk_love_male_71ada5a1:
    hanna.say "Честно предупреждаю, [lssb_hanna.hero_name()]. Если ответ — девяностотрёхлетний старик в кимоно для карате, я ухожу."

# ch/hanna/talk.rpy:46
translate russian hanna_talk_sex_male_24a8e247:
    hanna.say "Так вот, эм. Тот раз в спортзале."

# ch/hanna/talk.rpy:48
translate russian hanna_talk_sex_male_01dd9be2:
    hanna.say "Тот, что стоил мне мужа и вполне приличного учителя боевых искусств."

# ch/hanna/talk.rpy:49
translate russian hanna_talk_sex_male_d771e306:
    hanna.say "Тебе было... ну, понимаешь. Хорошо?"

# ch/hanna/talk.rpy:53
translate russian hanna_talk_sex_male_eb22ed84:
    mike.say "Лучшая тренировка в моей жизни, Ханна."

# ch/hanna/talk.rpy:55
translate russian hanna_talk_sex_male_669d81f4:
    hanna.say "Ха! У меня тоже. Только никому не говори, а то все захотят узнать мой секрет."

# ch/hanna/talk.rpy:59
translate russian hanna_talk_sex_male_94f878d6:
    mike.say "Нужно больше повторений, прежде чем я скажу наверняка."

# ch/hanna/talk.rpy:61
translate russian hanna_talk_sex_male_c9d795ba:
    hanna.say "Повторений, значит? Осторожнее с желаниями. Я не делаю подходы наполовину."

# ch/hanna/talk.rpy:274
translate russian hanna_talk_sports_male_f59834cd:
    mike.say "Я тут подумываю заняться боевыми искусствами."

# ch/hanna/talk.rpy:276
translate russian hanna_talk_sports_male_b144dda9:
    hanna.say "Да? Тебе понадобится учитель."

# ch/hanna/talk.rpy:278
translate russian hanna_talk_sports_male_3d7363db:
    hanna.say "И если ты хоть подумаешь о том типе из дюн, я аннулирую твой абонемент."

# ch/hanna/talk.rpy:396
translate russian hanna_talk_people_male_7c13477a:
    mike.say "Давно видела Мастера?"

# ch/hanna/talk.rpy:399
translate russian hanna_talk_people_male_b8e511e1:
    hanna.say "Он прислал цветы в спортзал. На открытке было написано: «Без обид. Техника у тебя всё ещё неряшливая»."

# ch/hanna/talk.rpy:400
translate russian hanna_talk_people_male_34fd60f8:
    hanna.say "Бесит, что я по нему немного скучаю."

# ch/hanna/talk.rpy:404
translate russian hanna_talk_people_male_371641f6:
    hanna.say "Он вернулся в свои дюны. Я теперь бегаю длинным кругом."

# ch/hanna/talk.rpy:405
translate russian hanna_talk_people_male_a2d14950:
    hanna.say "Но всё равно поглядываю. Просто чтобы убедиться, что старый козёл ещё дышит."

# ch/harems/friendly/events.rpy:643
translate russian emma_samantha_threesome_1689e2f3:
    "Я кладу руку Эмме на голову и мягко надавливаю вниз, подкрепляя жест кивком."

# ch/harems/friendly/events.rpy:644
translate russian emma_samantha_threesome_6129ba17:
    "Эмма выглядит заметно растерянной."

# ch/harems/friendly/events.rpy:646
translate russian emma_samantha_threesome_2403eec4:
    "Но постепенно до неё доходит, и она без малейшего стыда пускает в ход язык там, внизу."

# ch/harems/friendly/events.rpy:648
translate russian emma_samantha_threesome_ba2a63cf:
    "Ей больше свойственен энтузиазм, чем умение, и от каждого движения её языка у меня перехватывает дыхание."

# ch/harems/home/events/home_harem_beach_date.rpy:130
translate russian home_harem_bree_sasha_beach_date_16cadf99:
    mike.say "Эй, [bree.callname]."

# ch/harems/home/events/home_harem_beach_date.rpy:365
translate russian home_harem_bree_sasha_beach_date_e9ffb7aa:
    mike.say "[bree.callname], тебе придётся помочь Саше, и побыстрее!"

# ch/harems/home/events/home_harem_beach_date.rpy:406
translate russian home_harem_bree_sasha_beach_date_5d3e9de4:
    mike.say "Эм, [bree.callname]..."

# ch/harems/home/events/home_harem_beach_date.rpy:513
translate russian home_harem_bree_sasha_beach_fuck_4864e6f7:
    mike.say "Просто начал собираться, [bree.callname]."

# ch/harems/home/events/home_harem_beach_date.rpy:787
translate russian home_harem_bree_lexi_beach_date_c364269a:
    mike.say "Я уже обжёг ступни, [bree.callname]!"

# ch/harems/home/events/home_harem_beach_date.rpy:796
translate russian home_harem_bree_lexi_beach_date_ec7bf214:
    mike.say "Всё не так, [bree.callname]!"

# ch/harems/home/events/home_harem_beach_date.rpy:883
translate russian home_harem_bree_lexi_beach_date_1eb236e0:
    mike.say "Сейчас подойду, [bree.callname]."

# ch/harems/home/events/home_harem_beach_date.rpy:947
translate russian home_harem_bree_lexi_beach_date_34359282:
    mike.say "[bree.callname], ты уже вся в креме от солнца."

# ch/harems/home/events/home_harem_beach_date.rpy:976
translate russian home_harem_bree_lexi_beach_date_d50ade0c:
    mike.say "А ты, [bree.callname], заодно сделай Лекси массаж."

# ch/harems/home/events/home_harem_beach_date.rpy:1045
translate russian home_harem_bree_lexi_beach_date_ef3267de:
    mike.say "Я в твоей команде, [bree.callname]!"

# ch/harems/home/events/home_harem_beach_date.rpy:1594
translate russian home_harem_lexi_minami_samantha_beach_date_4142b5bc:
    minami.say "Подожди меня, [lssb_minami.hero_name()]!"

# ch/harems/home/events/home_harem_beach_date.rpy:1617
translate russian home_harem_lexi_minami_samantha_beach_date_25d6bdaf:
    minami.say "Ещё бы, [lssb_minami.hero_name()]!"

# ch/harems/home/events/home_harem_beach_date.rpy:1668
translate russian home_harem_lexi_minami_samantha_beach_date_4142b5bc_1:
    minami.say "Подожди меня, [lssb_minami.hero_name()]!"

# ch/harems/home/events/home_harem_beach_date.rpy:1701
translate russian home_harem_lexi_minami_samantha_beach_date_bcb1d284:
