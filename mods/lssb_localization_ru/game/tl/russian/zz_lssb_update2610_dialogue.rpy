    anna.say "М-м... из-за тебя у меня будет столько проблем."

# dlc_cupid/ch/cupid/anna_gwen/wedding.rpy:283
translate russian cupid_anna_gwen_wedding_fuck_4f6223ba_1:
    anna.say "...Я не говорю останавливаться."

# dlc_cupid/ch/cupid/anna_gwen/wedding.rpy:285
translate russian cupid_anna_gwen_wedding_fuck_57c668df_1:
    "Она обмякает у меня на груди, расслабленная и улыбающаяся, и я принимаю её вес на себя."

# dlc_cupid/ch/cupid/anna_gwen/wedding.rpy:290
translate russian cupid_anna_gwen_wedding_fuck_2b3caa04:
    "Какое-то время никто из нас не двигается. Она тёплая и тяжёлая, а её сердце колотится у меня под ладонью."

# dlc_cupid/ch/cupid/anna_gwen/wedding.rpy:291
translate russian cupid_anna_gwen_wedding_fuck_5d20b422:
    anna.say "Так. Значит, это случилось."

# dlc_cupid/ch/cupid/anna_gwen/wedding.rpy:292
translate russian cupid_anna_gwen_wedding_fuck_4af3fe51:
    anna.say "Мне нужно стоять там и клясться отречься от всех остальных. Когда ты ещё весь на мне."

# dlc_cupid/ch/cupid/anna_gwen/wedding.rpy:293
translate russian cupid_anna_gwen_wedding_fuck_b272c5fe:
    "Она закрывает лицо обеими руками, и я слышу, как она улыбается за ними."

# dlc_cupid/ch/cupid/anna_gwen/wedding.rpy:294
translate russian cupid_anna_gwen_wedding_fuck_1f44a830:
    "Она откидывает голову мне на плечо и улыбается снизу вверх, раскрасневшаяся, где-то между эйфорией и ужасом."

# dlc_cupid/ch/cupid/anna_gwen/wedding.rpy:296
translate russian cupid_anna_gwen_wedding_fuck_4d4a6189:
    anna.say "Не говори ничего умного, [lssb_anna.hero_name()]. Если ты сейчас скажешь что-нибудь умное, я сделаю какую-нибудь огромную глупость."

# dlc_cupid/ch/cupid/anna_gwen/wedding.rpy:297
translate russian cupid_anna_gwen_wedding_fuck_fea8f5b7:
    "Она говорит это в шутку. Но звучит это не как шутка."

# dlc_cupid/ch/cupid/anna_gwen/wedding.rpy:299
translate russian cupid_anna_gwen_wedding_fuck_e5d92fee:
    anna.say "Мы никогда никому не расскажем. Никогда. Клянёмся на мизинчиках."

# dlc_cupid/ch/cupid/anna_gwen/wedding.rpy:300
translate russian cupid_anna_gwen_wedding_fuck_8527a9eb:
    "Она поднимает мизинец, и в её лице нет места для возражений."

# dlc_cupid/ch/cupid/anna_gwen/wedding.rpy:303
translate russian cupid_anna_gwen_wedding_fuck_ff6f3fe2:
    "Десять минут спустя она снова в платье, молнию я на этот раз застегнул как следует, и мы переходим дорогу на очень приличном расстоянии друг от друга."

# dlc_cupid/ch/cupid/anna_gwen/wedding.rpy:309
translate russian cupid_anna_gwen_wedding_ask_612dec08:
    mike.say "Анна."

# dlc_cupid/ch/cupid/anna_gwen/wedding.rpy:310
translate russian cupid_anna_gwen_wedding_ask_bd3e1852:
    "Получается громче, чем я хотел. Все головы в часовне поворачиваются."

# dlc_cupid/ch/cupid/anna_gwen/wedding.rpy:312
translate russian cupid_anna_gwen_wedding_ask_432ecb29:
    mike.say "Не делай этого."

# dlc_cupid/ch/cupid/anna_gwen/wedding.rpy:313
translate russian cupid_anna_gwen_wedding_ask_9d412e13:
    "Священник опускает книгу. Где-то в задних рядах кто-то роняет листок с гимном."

# dlc_cupid/ch/cupid/anna_gwen/wedding.rpy:316
translate russian cupid_anna_gwen_wedding_ask_1a41345b:
    "Анна переводит взгляд с меня на Гвен и обратно, и её лицо разом искажается и проясняется."

# dlc_cupid/ch/cupid/anna_gwen/wedding.rpy:317
translate russian cupid_anna_gwen_wedding_ask_680ce185:
    "Gwen" "Анна? О чём он говорит?"

# dlc_cupid/ch/cupid/anna_gwen/wedding.rpy:319
translate russian cupid_anna_gwen_wedding_ask_b24d3f84:
    anna.say "Прости, Гвен. Правда прости."

# dlc_cupid/ch/cupid/anna_gwen/wedding.rpy:320
translate russian cupid_anna_gwen_wedding_ask_df2ecf72:
    anna.say "В этот раз ты была со мной милой. Ты была прежней, той, в которую я влюбилась, и я так этого хотела."

# dlc_cupid/ch/cupid/anna_gwen/wedding.rpy:322
translate russian cupid_anna_gwen_wedding_ask_4ecb53b9:
    anna.say "Но сегодня утром я была с ним. И я не могу стоять здесь и говорить «да», когда у меня во рту такое."

# dlc_cupid/ch/cupid/anna_gwen/wedding.rpy:323
translate russian cupid_anna_gwen_wedding_ask_8f2dbb1f:
    "Gwen" "С ним."

# dlc_cupid/ch/cupid/anna_gwen/wedding.rpy:324
translate russian cupid_anna_gwen_wedding_ask_8b8236d7:
    "Gwen" "С твоим шафером."

# dlc_cupid/ch/cupid/anna_gwen/wedding.rpy:326
translate russian cupid_anna_gwen_wedding_ask_c4484061:
    "На секунду в её лице проступает прежняя Гвен — та, от которой Анна раньше вздрагивала."

# dlc_cupid/ch/cupid/anna_gwen/wedding.rpy:327
translate russian cupid_anna_gwen_wedding_ask_bf9351ec:
    "А потом она просто смеётся — коротко и некрасиво — и поворачивается ко всем нам спиной."

# dlc_cupid/ch/cupid/anna_gwen/wedding.rpy:329
translate russian cupid_anna_gwen_wedding_ask_014a96f8:
    "Её каблуки стучат по всему проходу. Никто не пытается её остановить."

# dlc_cupid/ch/cupid/anna_gwen/wedding.rpy:331
translate russian cupid_anna_gwen_wedding_ask_928f1f29:
    "Анна стоит в платье, букет свисает у неё из руки, и её трясёт."

# dlc_cupid/ch/cupid/anna_gwen/wedding.rpy:332
translate russian cupid_anna_gwen_wedding_ask_544490b4:
    "Потом она роняет его на ступеньку алтаря и хватает меня за руку."

# dlc_cupid/ch/cupid/anna_gwen/wedding.rpy:334
translate russian cupid_anna_gwen_wedding_ask_27b9f83c:
    anna.say "Уведи меня отсюда, пока я не передумала. Или пока Клео не начала аплодировать."

# dlc_cupid/ch/cupid/anna_gwen/wedding.rpy:336
translate russian cupid_anna_gwen_wedding_ask_59b401a0:
    "До дверей мы не успеваем дойти — Клео начинает аплодировать."

# dlc_cupid/ch/cupid/anna_gwen/wedding.rpy:344
translate russian cupid_anna_gwen_wedding_ask_9aaf2447:
    "Снаружи светит солнце, будто до него не дошли новости."

# dlc_cupid/ch/cupid/anna_gwen/wedding.rpy:345
translate russian cupid_anna_gwen_wedding_ask_9e149468:
    "Анна садится на ступеньки церкви в нескольких тысячах фунтов белого шёлка и смотрит на поток машин."

# dlc_cupid/ch/cupid/anna_gwen/wedding.rpy:347
translate russian cupid_anna_gwen_wedding_ask_2961e03a:
    anna.say "Я только что бросила человека у алтаря. Я. Теперь я злодейка на свадебном видео."

# dlc_cupid/ch/cupid/anna_gwen/wedding.rpy:349
translate russian cupid_anna_gwen_wedding_ask_923e4d67:
    mike.say "Ты не злодейка."

# dlc_cupid/ch/cupid/anna_gwen/wedding.rpy:351
translate russian cupid_anna_gwen_wedding_ask_1abe4cdb:
    anna.say "Немножко злодейка. Дай мне побыть ей."

# dlc_cupid/ch/cupid/anna_gwen/wedding.rpy:353
translate russian cupid_anna_gwen_wedding_ask_8075f144:
    "Она кладёт голову мне на плечо и делает долгий, дрожащий выдох."

# dlc_cupid/ch/cupid/anna_gwen/wedding.rpy:356
translate russian cupid_anna_gwen_wedding_ask_cec3d959:
    anna.say "Ты мне должен, [lssb_anna.hero_name()]. Должен настоящее свидание. Где-нибудь со скатертями, где официант смотрит на нас с осуждением."

# dlc_cupid/ch/cupid/anna_gwen/wedding.rpy:357
translate russian cupid_anna_gwen_wedding_ask_eee49922:
    anna.say "Не сегодня. Сегодня я еду домой есть свой свадебный торт прямо из коробки."

# dlc_cupid/ch/cupid/anna_gwen/wedding.rpy:361
translate russian cupid_anna_gwen_wedding_ask_bb679cae:
    anna.say "Позвони мне завтра. Не сегодня. Сегодня я еду домой есть свой свадебный торт прямо из коробки."

# dlc_cupid/ch/cupid/anna_gwen/wedding.rpy:363
translate russian cupid_anna_gwen_wedding_ask_96ed1052:
    anna.say "И коробку несёшь ты."

# dlc_cupid/ch/cupid/anna_gwen/wedding.rpy:370
translate russian cupid_anna_gwen_wedding_ask_c490ef9c:
    "Глаза Анны на одну долгую секунду встречаются с моими."

# dlc_cupid/ch/cupid/anna_gwen/wedding.rpy:371
translate russian cupid_anna_gwen_wedding_ask_049e2ede:
    "Потом она прикусывает губу и снова поворачивается к Гвен."

# dlc_cupid/ch/cupid/anna_gwen/wedding.rpy:373
translate russian cupid_anna_gwen_wedding_ask_f1a8acfb:
    anna.say "Не обращайте на него внимания. Он мой шафер. По договору ему положено быть идиотом."

# dlc_cupid/ch/cupid/anna_gwen/wedding.rpy:375
translate russian cupid_anna_gwen_wedding_ask_81ea3b85:
    "По скамьям пробегает нервный смешок. Улыбка Гвен застыла по краям."

# dlc_cupid/ch/cupid/anna_gwen/wedding.rpy:376
translate russian cupid_anna_gwen_wedding_ask_1d864864:
    "Я стою с пылающим лицом и до самого конца больше не открываю рта."

# dlc_cupid/ch/cupid/cherie_dwayne/event.rpy:826
translate russian cupid_cherie_dwayne_ending_7ee48009:
    "Алетта закатывает глаза так сильно, что я почти слышу это."

# dlc_cupid/ch/cupid/cherie_dwayne/event.rpy:827
translate russian cupid_cherie_dwayne_ending_1f4ab8d1:
    "Потом она ловит мой взгляд через проход и едва заметно качает головой."

# dlc_cupid/ch/cupid/cherie_dwayne/event.rpy:871
translate russian cupid_cherie_dwayne_handover_b41afcf6:
    "Дверь моего кабинета открывается без стука, а это всегда означает только одного человека."

# dlc_cupid/ch/cupid/cherie_dwayne/event.rpy:873
translate russian cupid_cherie_dwayne_handover_53a99ea9:
    "Вот только человек, заполнивший собой дверной проём, одет в рубашку-поло."

# dlc_cupid/ch/cupid/cherie_dwayne/event.rpy:874
translate russian cupid_cherie_dwayne_handover_3e0bee55:
    "Я никогда не видел Дуэйна без костюма. Даже не знал, что так можно."

# dlc_cupid/ch/cupid/cherie_dwayne/event.rpy:875
translate russian cupid_cherie_dwayne_handover_6a1be3f6:
    mike.say "Дуэйн? Всё в..."

# dlc_cupid/ch/cupid/cherie_dwayne/event.rpy:877
translate russian cupid_cherie_dwayne_handover_20f3a5be:
    dwayne.say "Всё просто фантастически, [hero.name]. В этом-то и проблема!"

# dlc_cupid/ch/cupid/cherie_dwayne/event.rpy:879
translate russian cupid_cherie_dwayne_handover_de95ca34:
    dwayne.say "Целый месяц. Ни одного пропущенного ужина. Ни одного... особого совещания."

# dlc_cupid/ch/cupid/cherie_dwayne/event.rpy:880
translate russian cupid_cherie_dwayne_handover_996fe979:
    dwayne.say "Я каждый день гоняю на спорткаре. По воскресеньям объезжаю кобылку."

# dlc_cupid/ch/cupid/cherie_dwayne/event.rpy:881
translate russian cupid_cherie_dwayne_handover_b2c61768:
    "Почти уверен, что на этот раз он имеет в виду это буквально."

# dlc_cupid/ch/cupid/cherie_dwayne/event.rpy:883
translate russian cupid_cherie_dwayne_handover_30e97dbe:
    dwayne.say "А сегодня утром Шери положила мне на подушку буклет. Шесть недель по Европе, и в каждом городе дождь!"

# dlc_cupid/ch/cupid/cherie_dwayne/event.rpy:885
translate russian cupid_cherie_dwayne_handover_794aff1e:
    "Он плюхается в кресло напротив моего стола, и кресло задумывается."

# dlc_cupid/ch/cupid/cherie_dwayne/event.rpy:887
translate russian cupid_cherie_dwayne_handover_1b6e9d0b:
    dwayne.say "Совет директоров хочет услышать имя до моего ухода."

# dlc_cupid/ch/cupid/cherie_dwayne/event.rpy:888
translate russian cupid_cherie_dwayne_handover_1094dc95:
    dwayne.say "Кого-то, кто сможет смотреть банку в глаза и продать им историю."

# dlc_cupid/ch/cupid/cherie_dwayne/event.rpy:890
translate russian cupid_cherie_dwayne_handover_6592d5eb:
    dwayne.say "Я видел, как ты продаёшь истории, [hero.name]. Ты продал её МНЕ — с фоторамкой и кучей брехни!"

# dlc_cupid/ch/cupid/cherie_dwayne/event.rpy:892
translate russian cupid_cherie_dwayne_handover_5b093cdc:
    "Мне нужна секунда, чтобы осознать, что он сейчас сказал."

# dlc_cupid/ch/cupid/cherie_dwayne/event.rpy:893
translate russian cupid_cherie_dwayne_handover_c1b6be3a:
    "Таблица передо мной перестала что-либо значить."

# dlc_cupid/ch/cupid/cherie_dwayne/event.rpy:894
translate russian cupid_cherie_dwayne_handover_008a1612:
    mike.say "Ты уходишь с поста."

# dlc_cupid/ch/cupid/cherie_dwayne/event.rpy:896
translate russian cupid_cherie_dwayne_handover_ec156504:
    dwayne.say "С постов уходят старики. А я иду домой к жене."

# dlc_cupid/ch/cupid/cherie_dwayne/event.rpy:898
translate russian cupid_cherie_dwayne_handover_309ae517:
    dwayne.say "И ты теперь семья, ну или почти. Лучше уж оставить всё в семье, чем отдать какому-нибудь хмырю в галстуке за тысячу долларов."

# dlc_cupid/ch/cupid/cherie_dwayne/event.rpy:900
translate russian cupid_cherie_dwayne_handover_fea9d5e9:
    dwayne.say "Все остальные в совете — хмыри в галстуках за тысячу долларов. А ты хотя бы на моих глазах умеешь уворачиваться."

# dlc_cupid/ch/cupid/cherie_dwayne/event.rpy:902
translate russian cupid_cherie_dwayne_handover_58e1fa15:
    dwayne.say "Ну так что. Кресло. Хочешь его или нет?"

# dlc_cupid/ch/cupid/cherie_dwayne/event.rpy:905
translate russian cupid_cherie_dwayne_handover_1e52a4f9:
    mike.say "Хочу."

# dlc_cupid/ch/cupid/cherie_dwayne/event.rpy:906
translate russian cupid_cherie_dwayne_handover_a5d62118:
    "Я слышу, как говорю это, ещё ничего не решив."

# dlc_cupid/ch/cupid/cherie_dwayne/event.rpy:908
translate russian cupid_cherie_dwayne_handover_4ae08bba:
    dwayne.say "ХА! Вот это я понимаю!"

# dlc_cupid/ch/cupid/cherie_dwayne/event.rpy:909
translate russian cupid_cherie_dwayne_handover_a889bac0:
    "Этот хлопок по спине — последний, которым он наградит меня как начальник, и он вкладывает в него всё."

# dlc_cupid/ch/cupid/cherie_dwayne/event.rpy:912
translate russian cupid_cherie_dwayne_handover_e86a7271:
    mike.say "А-а-аргх!"

# dlc_cupid/ch/cupid/cherie_dwayne/event.rpy:914
translate russian cupid_cherie_dwayne_handover_1ba531d8:
    dwayne.say "Совет собирается по понедельникам. Не дай им учуять страх."

# dlc_cupid/ch/cupid/cherie_dwayne/event.rpy:916
translate russian cupid_cherie_dwayne_handover_aab8fe6c:
    dwayne.say "Алетта знает, где зарыты все трупы. Фигура речи, неженка. Фигура речи."

# dlc_cupid/ch/cupid/cherie_dwayne/event.rpy:917
translate russian cupid_cherie_dwayne_handover_5c0b26dc:
    dwayne.say "С завтрашнего дня мой кабинет твой. А кресло я заберу. Настоящее кресло. Шери отдавала его на перетяжку."

# dlc_cupid/ch/cupid/cherie_dwayne/event.rpy:920
translate russian cupid_cherie_dwayne_handover_aeef76cb:
    "Он уже насвистывает, ещё не дойдя до лифта."

# dlc_cupid/ch/cupid/cherie_dwayne/event.rpy:921
translate russian cupid_cherie_dwayne_handover_3f152ff8:
    "Я долго сижу, уставившись на дверь, которой, похоже, теперь заведую."

# dlc_cupid/ch/cupid/cherie_dwayne/event.rpy:935
translate russian cupid_cherie_dwayne_handover_8dcf5cf3:
    mike.say "Дуэйн, я не тот человек для этого кресла."

# dlc_cupid/ch/cupid/cherie_dwayne/event.rpy:936
translate russian cupid_cherie_dwayne_handover_9c9b70d1:
    mike.say "Я склеил чей-то брак. Банку на это наплевать."

# dlc_cupid/ch/cupid/cherie_dwayne/event.rpy:938
translate russian cupid_cherie_dwayne_handover_29571a10:
    "Дуэйн смотрит на меня так, как смотрит на салат."

# dlc_cupid/ch/cupid/cherie_dwayne/event.rpy:940
translate russian cupid_cherie_dwayne_handover_3e3c1d64:
    dwayne.say "Неженка."

# dlc_cupid/ch/cupid/cherie_dwayne/event.rpy:941
translate russian cupid_cherie_dwayne_handover_f4eafa91:
    dwayne.say "Ладно. Найду какого-нибудь хмыря в галстуке, а Шери подождёт свой дождь ещё месяц."

# dlc_cupid/ch/cupid/cherie_dwayne/event.rpy:943
translate russian cupid_cherie_dwayne_handover_b3253390:
    dwayne.say "Но первым я предложил тебе. Вспомни об этом, когда новенький пошлёт тебя за кофе!"

# dlc_cupid/ch/cupid/cherie_dwayne/event.rpy:945
translate russian cupid_cherie_dwayne_handover_9b7b2d41:
    "Он уходит так же, как вошёл, — без стука."

# dlc_cupid/ch/cupid/cherie_dwayne/event.rpy:946
translate russian cupid_cherie_dwayne_handover_ad5b5487:
    "А я возвращаюсь к своей таблице, которая никогда ещё не казалась такой надёжной."

# dlc_cupid/ch/cupid/hanna_master/aftermath.rpy:54
translate russian cupid_hanna_master_aftermath_31901f0e:
    "Ханна замечает меня, как только я вхожу в дверь."

# dlc_cupid/ch/cupid/hanna_master/aftermath.rpy:56
translate russian cupid_hanna_master_aftermath_24862ec0:
    "Впервые она не встречает меня подсчётом повторений или лекцией о белке."

# dlc_cupid/ch/cupid/hanna_master/aftermath.rpy:58
translate russian cupid_hanna_master_aftermath_9d3a9f99:
    hanna.say "О. Привет, [lssb_hanna.hero_name()]."

# dlc_cupid/ch/cupid/hanna_master/aftermath.rpy:59
translate russian cupid_hanna_master_aftermath_f2234384:
    hanna.say "Уже вернулся, да?"

# dlc_cupid/ch/cupid/hanna_master/aftermath.rpy:61
translate russian cupid_hanna_master_aftermath_01c007eb:
    mike.say "Это проблема?"

# dlc_cupid/ch/cupid/hanna_master/aftermath.rpy:63
translate russian cupid_hanna_master_aftermath_823cf249:
    hanna.say "Нет! С чего бы это было проблемой?"

# dlc_cupid/ch/cupid/hanna_master/aftermath.rpy:64
translate russian cupid_hanna_master_aftermath_b358da1d:
    hanna.say "Просто некоторые парни становятся странными после... ну, сам понимаешь. После."

# dlc_cupid/ch/cupid/hanna_master/aftermath.rpy:65
translate russian cupid_hanna_master_aftermath_8ca6beb7:
    hanna.say "Не то чтобы я об этом думала. Мне тут надо было сложить кучу полотенец."

# dlc_cupid/ch/cupid/hanna_master/aftermath.rpy:67
translate russian cupid_hanna_master_aftermath_5be62d7f:
    "Она складывает одно и то же полотенце уже в третий раз."

# dlc_cupid/ch/cupid/hanna_master/aftermath.rpy:68
translate russian cupid_hanna_master_aftermath_9037ec8b:
    "Я уже собираюсь указать ей на это, когда через весь зал разносится скрипучий голос."

# dlc_cupid/ch/cupid/hanna_master/aftermath.rpy:70
translate russian cupid_hanna_master_aftermath_151195cf:
    master.say "Ханна, дорогая моя! Твой учитель прибыл!"

# dlc_cupid/ch/cupid/hanna_master/aftermath.rpy:73
translate russian cupid_hanna_master_aftermath_e18548e7:
    "Мастер, шаркая, входит со стороны ресепшена в облаке одеколона, вкус которого я чувствую даже отсюда."

# dlc_cupid/ch/cupid/hanna_master/aftermath.rpy:74
translate russian cupid_hanna_master_aftermath_0038fe75:
    "Урок, который Ханна пообещала ему после испытаний. Я совсем о нём забыл."

# dlc_cupid/ch/cupid/hanna_master/aftermath.rpy:75
translate russian cupid_hanna_master_aftermath_3bf7af4a:
    "Судя по её лицу, она тоже."

# dlc_cupid/ch/cupid/hanna_master/aftermath.rpy:77
translate russian cupid_hanna_master_aftermath_8863c2f9:
    master.say "[hero.name]! Мальчик мой!"

# dlc_cupid/ch/cupid/hanna_master/aftermath.rpy:80
translate russian cupid_hanna_master_aftermath_3c5d2991:
    "Все головы в зале поворачиваются, когда старик с бородой до пояса машет мне от ресепшена."

# dlc_cupid/ch/cupid/hanna_master/aftermath.rpy:82
translate russian cupid_hanna_master_aftermath_55ad5f64:
    master.say "День за днём я ждал в дюнах твоего плана!"

# dlc_cupid/ch/cupid/hanna_master/aftermath.rpy:83
translate russian cupid_hanna_master_aftermath_15ae23e3:
    master.say "И вот я сам пришёл к горе."

# dlc_cupid/ch/cupid/hanna_master/aftermath.rpy:86
translate russian cupid_hanna_master_aftermath_a0c8e909:
    hanna.say "Опять ты?"

# dlc_cupid/ch/cupid/hanna_master/aftermath.rpy:87
translate russian cupid_hanna_master_aftermath_15bdaf2f:
    hanna.say "В прошлый раз я отпустила тебя, отделавшись удушающим захватом, дедуля."

# dlc_cupid/ch/cupid/hanna_master/aftermath.rpy:90
translate russian cupid_hanna_master_aftermath_a497256c:
    "Мастер ей не отвечает."

# dlc_cupid/ch/cupid/hanna_master/aftermath.rpy:91
translate russian cupid_hanna_master_aftermath_f5de1731:
    "Его взгляд переходит с лица Ханны на моё и обратно, всякий раз сужаясь чуть сильнее."

# dlc_cupid/ch/cupid/hanna_master/aftermath.rpy:93
translate russian cupid_hanna_master_aftermath_f70d447a:
    "Он принюхивается, как гончая."

# dlc_cupid/ch/cupid/hanna_master/aftermath.rpy:95
translate russian cupid_hanna_master_aftermath_7c0bb11a:
    master.say "Нет..."

# dlc_cupid/ch/cupid/hanna_master/aftermath.rpy:96
translate russian cupid_hanna_master_aftermath_50681cd6:
    master.say "Её ци... она вся на тебе, мальчик."

# dlc_cupid/ch/cupid/hanna_master/aftermath.rpy:98
translate russian cupid_hanna_master_aftermath_7378fc4b:
    master.say "Ты возлёг с ней!" with vpunch

# dlc_cupid/ch/cupid/hanna_master/aftermath.rpy:101
translate russian cupid_hanna_master_aftermath_69cc296a:
    "Ханна становится цвета знака «стоп»."

# dlc_cupid/ch/cupid/hanna_master/aftermath.rpy:103
translate russian cupid_hanna_master_aftermath_d27b70f3:
    hanna.say "Ч... что? Кто тебе такое сказал?!"

# dlc_cupid/ch/cupid/hanna_master/aftermath.rpy:104
translate russian cupid_hanna_master_aftermath_4452e5ab:
    hanna.say "В смысле, никто тебе не говорил, потому что нечего говорить, потому что..."

# dlc_cupid/ch/cupid/hanna_master/aftermath.rpy:107
translate russian cupid_hanna_master_aftermath_516bb932:
    master.say "Ты должен был стать моим посланником любви, [hero.name]!"

# dlc_cupid/ch/cupid/hanna_master/aftermath.rpy:108
translate russian cupid_hanna_master_aftermath_f4c5c191:
    master.say "Моим помощником! Моим глашатаем!"

# dlc_cupid/ch/cupid/hanna_master/aftermath.rpy:109
translate russian cupid_hanna_master_aftermath_d7470ccc:
    master.say "А ты взял и похитил тот самый цветок, за которым тебя послали!"

# dlc_cupid/ch/cupid/hanna_master/aftermath.rpy:112
translate russian cupid_hanna_master_aftermath_3ba8a586:
    "Голова Ханны очень медленно поворачивается, пока она не упирается взглядом прямо в меня."

# dlc_cupid/ch/cupid/hanna_master/aftermath.rpy:114
translate russian cupid_hanna_master_aftermath_5652ef0e:
    hanna.say "Твоим кем?"

# dlc_cupid/ch/cupid/hanna_master/aftermath.rpy:116
translate russian cupid_hanna_master_aftermath_af55eb90:
    hanna.say "Погоди. Испытания, то, что ты притащил его сюда бороться со мной..."

# dlc_cupid/ch/cupid/hanna_master/aftermath.rpy:117
translate russian cupid_hanna_master_aftermath_0a22860e:
    hanna.say "Это было вовсе не ради моего зала. Ты сводил меня с ним?"

# dlc_cupid/ch/cupid/hanna_master/aftermath.rpy:120
translate russian cupid_hanna_master_aftermath_d4882e33:
    hanna.say "Погоди. Ты знаешь этого типа из дюн, потому что помогаешь ему... заполучить меня?"

# dlc_cupid/ch/cupid/hanna_master/aftermath.rpy:121
translate russian cupid_hanna_master_aftermath_77d55b0b:
    hanna.say "Ты сводил меня с ним?"

# dlc_cupid/ch/cupid/hanna_master/aftermath.rpy:123
translate russian cupid_hanna_master_aftermath_0c273691:
    mike.say "В своё оправдание скажу: он очень настойчивый."

# dlc_cupid/ch/cupid/hanna_master/aftermath.rpy:125
translate russian cupid_hanna_master_aftermath_049a10cf:
    hanna.say "Ему девяносто!"

# dlc_cupid/ch/cupid/hanna_master/aftermath.rpy:128
translate russian cupid_hanna_master_aftermath_26d342be:
    master.say "Девяносто три. И каждый из них — в отличной форме."

# dlc_cupid/ch/cupid/hanna_master/aftermath.rpy:131
translate russian cupid_hanna_master_aftermath_be403615:
    hanna.say "Тогда что это было на днях?"

# dlc_cupid/ch/cupid/hanna_master/aftermath.rpy:132
translate russian cupid_hanna_master_aftermath_7549dc69:
    hanna.say "Я тоже была частью плана? Что-то вроде разминки?"

# dlc_cupid/ch/cupid/hanna_master/aftermath.rpy:134
translate russian cupid_hanna_master_aftermath_85470d46:
    "Она пытается говорить об этом жёстко."

# dlc_cupid/ch/cupid/hanna_master/aftermath.rpy:135
translate russian cupid_hanna_master_aftermath_37b33cf5:
    "Но на последнем слове её голос срывается, и она знает, что я это услышал."

# dlc_cupid/ch/cupid/hanna_master/aftermath.rpy:138
translate russian cupid_hanna_master_aftermath_e4dbf83e:
    mike.say "Нет, Ханна."

# dlc_cupid/ch/cupid/hanna_master/aftermath.rpy:139
translate russian cupid_hanna_master_aftermath_e536f04f:
    mike.say "Где-то между пляжем и этим залом я перестал хотеть сводить тебя с кем-либо."

# dlc_cupid/ch/cupid/hanna_master/aftermath.rpy:140
translate russian cupid_hanna_master_aftermath_e56e9f24:
    mike.say "Я хотел тебя для себя."

# dlc_cupid/ch/cupid/hanna_master/aftermath.rpy:142
translate russian cupid_hanna_master_aftermath_c42b1dc9:
    "Секунду она просто стоит, позабыв о полотенце в руках."

# dlc_cupid/ch/cupid/hanna_master/aftermath.rpy:144
translate russian cupid_hanna_master_aftermath_c4299de5:
    hanna.say "А."

# dlc_cupid/ch/cupid/hanna_master/aftermath.rpy:145
translate russian cupid_hanna_master_aftermath_44fb5db9:
    hanna.say "Это... ладно. Вообще-то это хороший ответ."

# dlc_cupid/ch/cupid/hanna_master/aftermath.rpy:149
translate russian cupid_hanna_master_aftermath_dd8ba728:
    master.say "А-а-ах... ученик превзошёл учителя."

# dlc_cupid/ch/cupid/hanna_master/aftermath.rpy:150
translate russian cupid_hanna_master_aftermath_4ba91741:
    master.say "Не так, как мне хотелось бы, но что есть, то есть."

# dlc_cupid/ch/cupid/hanna_master/aftermath.rpy:153
translate russian cupid_hanna_master_aftermath_8fd041ce:
    mike.say "Я ничего такого не планировал, Ханна."

# dlc_cupid/ch/cupid/hanna_master/aftermath.rpy:154
translate russian cupid_hanna_master_aftermath_085785ab:
    mike.say "Это просто случилось."

# dlc_cupid/ch/cupid/hanna_master/aftermath.rpy:156
translate russian cupid_hanna_master_aftermath_1a9cb2a2:
    "Челюсть Ханны напрягается — так бывает, когда кто-то жульничает на последнем повторении."

# dlc_cupid/ch/cupid/hanna_master/aftermath.rpy:158
translate russian cupid_hanna_master_aftermath_14c2f532:
    hanna.say "Ясно. Просто случилось."

# dlc_cupid/ch/cupid/hanna_master/aftermath.rpy:159
translate russian cupid_hanna_master_aftermath_2e58da58:
    hanna.say "То, что просто случается, называется несчастным случаем, [lssb_hanna.hero_name()]."

# dlc_cupid/ch/cupid/hanna_master/aftermath.rpy:162
translate russian cupid_hanna_master_aftermath_0a7f041b:
    hanna.say "Приятно знать, на каком я месте."

# dlc_cupid/ch/cupid/hanna_master/aftermath.rpy:165
translate russian cupid_hanna_master_aftermath_66d2e5d4:
    master.say "Даже я мог бы тебе сказать, что это неправильный ответ, мальчик мой."

# dlc_cupid/ch/cupid/hanna_master/aftermath.rpy:167
translate russian cupid_hanna_master_aftermath_b8ded3fd:
    master.say "Что ж. Я знаю, когда битва проиграна."

# dlc_cupid/ch/cupid/hanna_master/aftermath.rpy:169
translate russian cupid_hanna_master_aftermath_d7907aac:
    master.say "Наш урок, дорогая. Полагаю, он отменяется?"

# dlc_cupid/ch/cupid/hanna_master/aftermath.rpy:172
translate russian cupid_hanna_master_aftermath_5d7a0219:
    hanna.say "Никакого урока. Есть дверь."

# dlc_cupid/ch/cupid/hanna_master/aftermath.rpy:176
translate russian cupid_hanna_master_aftermath_d94a83f8:
    master.say "Я вернусь в дюны. Один."

# dlc_cupid/ch/cupid/hanna_master/aftermath.rpy:180
translate russian cupid_hanna_master_aftermath_74d5e43b:
    hanna.say "И сиди там!"

# dlc_cupid/ch/cupid/hanna_master/aftermath.rpy:184
translate russian cupid_hanna_master_aftermath_1cd54b7c:
    "Он, шаркая, бредёт обратно к ресепшену, борода впереди, спина прямая, как черенок метлы."

# dlc_cupid/ch/cupid/hanna_master/aftermath.rpy:186
translate russian cupid_hanna_master_aftermath_3c002957:
    "И я остаюсь наедине с Ханной и примерно двадцатью завсегдатаями зала, которые делают вид, что не слушали."

# dlc_cupid/ch/cupid/hanna_master/aftermath.rpy:188
translate russian cupid_hanna_master_aftermath_74d78ecd:
    hanna.say "Вот."

# dlc_cupid/ch/cupid/hanna_master/aftermath.rpy:189
translate russian cupid_hanna_master_aftermath_8efd93c7:
    hanna.say "Больше никаких сводничеств, понял?"

# dlc_cupid/ch/cupid/hanna_master/aftermath.rpy:190
translate russian cupid_hanna_master_aftermath_0909cf64:
    hanna.say "Если кто-то меня с кем-то и будет сводить, то только я сама."

# dlc_cupid/ch/cupid/hanna_master/aftermath.rpy:192
translate russian cupid_hanna_master_aftermath_13875a2e:
    hanna.say "А теперь иди разминайся, [lssb_hanna.hero_name()]. Тебе многое надо наверстать."

# dlc_cupid/ch/cupid/hanna_master/aftermath.rpy:194
translate russian cupid_hanna_master_aftermath_efd519e7:
    "Она шагает к стойке, не дожидаясь ответа."

# dlc_cupid/ch/cupid/hanna_master/aftermath.rpy:195
translate russian cupid_hanna_master_aftermath_f77bfe00:
    "Но, пока доходит, дважды оглядывается через плечо."

# dlc_cupid/ch/cupid/hanna_master/wedding.rpy:18
translate russian cupid_hanna_master_wedding_invite_8a1b5b49:
    "До церемонии ещё час, а я уже дважды перевязал Мастеру галстук."

# dlc_cupid/ch/cupid/hanna_master/wedding.rpy:19
translate russian cupid_hanna_master_wedding_invite_93d0916b:
    "Я ищу, где бы присесть в тишине, когда в кармане вибрирует телефон."

# dlc_cupid/ch/cupid/hanna_master/wedding.rpy:20
translate russian cupid_hanna_master_wedding_invite_5ec7774a:
    "Это Ханна."

# dlc_cupid/ch/cupid/hanna_master/wedding.rpy:21
translate russian cupid_hanna_master_wedding_invite_034e9eb8:
    "«Не могу усидеть на месте. Пошла в зал на последний подход. Подстрахуешь?»"

# dlc_cupid/ch/cupid/hanna_master/wedding.rpy:22
translate russian cupid_hanna_master_wedding_invite_8e8fb64e:
    "Через час у неё свадьба, а она в спортзале."

# dlc_cupid/ch/cupid/hanna_master/wedding.rpy:23
translate russian cupid_hanna_master_wedding_invite_939a6675:
    "Ну конечно."

# dlc_cupid/ch/cupid/hanna_master/wedding.rpy:28
translate russian cupid_hanna_master_wedding_invite_8a75b41a:
    "Я отвечаю, что жениху нянька нужна больше, чем ей страхующий."

# dlc_cupid/ch/cupid/hanna_master/wedding.rpy:29
translate russian cupid_hanna_master_wedding_invite_6aed2670:
    "В ответ она присылает один-единственный напряжённый бицепс."

# dlc_cupid/ch/cupid/hanna_master/wedding.rpy:35
translate russian cupid_hanna_master_wedding_fuck_c24dc6e3:
    "Зал в двух кварталах от часовни, и в воскресенье днём там пусто."

# dlc_cupid/ch/cupid/hanna_master/wedding.rpy:37
translate russian cupid_hanna_master_wedding_fuck_ea0d0315:
    "Ханна сидит на скамье в своей лайкре и трясёт коленом, как отбойным молотком."

# dlc_cupid/ch/cupid/hanna_master/wedding.rpy:39
translate russian cupid_hanna_master_wedding_fuck_6ef9d3e0:
    hanna.say "[lssb_hanna.hero_name()]! Ты пришёл."

# dlc_cupid/ch/cupid/hanna_master/wedding.rpy:40
translate russian cupid_hanna_master_wedding_fuck_aa1aba1e:
    hanna.say "Не смотри на меня так. Перед фотосессией все делают пампинг."

# dlc_cupid/ch/cupid/hanna_master/wedding.rpy:42
translate russian cupid_hanna_master_wedding_fuck_83c0ec03:
    hanna.say "Ладно, хорошо. Я немножко психую."

# dlc_cupid/ch/cupid/hanna_master/wedding.rpy:44
translate russian cupid_hanna_master_wedding_fuck_25ce79e9:
    mike.say "Из-за того, что выходишь за девяностотрёхлетнего?"

# dlc_cupid/ch/cupid/hanna_master/wedding.rpy:46
translate russian cupid_hanna_master_wedding_fuck_9e9eff87:
    hanna.say "Из-за того, что вообще выхожу замуж!"

# dlc_cupid/ch/cupid/hanna_master/wedding.rpy:47
translate russian cupid_hanna_master_wedding_fuck_9f4c2931:
    hanna.say "Он научит меня всему, что знает, и я этого хочу. Правда хочу."

# dlc_cupid/ch/cupid/hanna_master/wedding.rpy:49
translate russian cupid_hanna_master_wedding_fuck_c7e5e063:
    hanna.say "Но он будет единственным. Навсегда. И я всё думаю..."

# dlc_cupid/ch/cupid/hanna_master/wedding.rpy:51
translate russian cupid_hanna_master_wedding_fuck_58e3eb16:
    "Она замолкает и смотрит на меня, потом в сторону, потом снова на меня."

# dlc_cupid/ch/cupid/hanna_master/wedding.rpy:53
translate russian cupid_hanna_master_wedding_fuck_f130b2c4:
    hanna.say "Всё думаю о том, с кем бы мне хотелось провести последнюю тренировку перед этим."

# dlc_cupid/ch/cupid/hanna_master/wedding.rpy:55
translate russian cupid_hanna_master_wedding_fuck_41e662a5:
    mike.say "Ханна, он сейчас в часовне. В галстуке, который я ему завязал."

# dlc_cupid/ch/cupid/hanna_master/wedding.rpy:57
translate russian cupid_hanna_master_wedding_fuck_170525c9:
    hanna.say "Я знаю, где он."

# dlc_cupid/ch/cupid/hanna_master/wedding.rpy:58
translate russian cupid_hanna_master_wedding_fuck_7c0442c3:
    hanna.say "Он целый месяц на этих матах учил меня контролю. Дыши, держи стойку, никогда не позволяй телу решать."

# dlc_cupid/ch/cupid/hanna_master/wedding.rpy:59
translate russian cupid_hanna_master_wedding_fuck_958c1bcd:
    hanna.say "А сегодня у меня в голове только одно — позволить ему решить, прямо здесь, на мате, где он заставлял меня потеть."

# dlc_cupid/ch/cupid/hanna_master/wedding.rpy:61
translate russian cupid_hanna_master_wedding_fuck_daa47bde:
    "Её взгляд опускается на мой ремень."

# dlc_cupid/ch/cupid/hanna_master/wedding.rpy:62
translate russian cupid_hanna_master_wedding_fuck_c6ab325b:
    "Потом она встаёт со скамьи, упирается обеими ладонями мне в грудь и, толкая, заставляет меня пятиться на маты."

# dlc_cupid/ch/cupid/hanna_master/wedding.rpy:65
translate russian cupid_hanna_master_wedding_fuck_94bcdc40:
    "Ханна хватает сумку и, не сказав больше ни слова, марширует в душевую."

# dlc_cupid/ch/cupid/hanna_master/wedding.rpy:66
translate russian cupid_hanna_master_wedding_fuck_77d72abb:
    "Я возвращаюсь в часовню один, и никто не спрашивает, где я был."

# dlc_cupid/ch/cupid/hanna_master/wedding.rpy:69
translate russian cupid_hanna_master_wedding_fuck_f2726fb8:
