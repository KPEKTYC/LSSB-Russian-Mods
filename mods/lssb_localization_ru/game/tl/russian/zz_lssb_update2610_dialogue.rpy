# dlc_cupid/ch/cupid/sasha_scottie/aftermath.rpy:65
translate russian cupid_sasha_scottie_aftermath_c83c43d3:
    scottie.say "Чувак! Саша!"

# dlc_cupid/ch/cupid/sasha_scottie/aftermath.rpy:67
translate russian cupid_sasha_scottie_aftermath_40487375:
    "Скотти размахивает над головой пластиковым пакетом, будто только что выиграл его на ярмарке."

# dlc_cupid/ch/cupid/sasha_scottie/aftermath.rpy:69
translate russian cupid_sasha_scottie_aftermath_6c54f7c5:
    scottie.say "Зацените. Новенькая футболка Metalliker."

# dlc_cupid/ch/cupid/sasha_scottie/aftermath.rpy:70
translate russian cupid_sasha_scottie_aftermath_9f145e24:
    scottie.say "Такая же, как та, что я угробил, только эта вообще ни разу не испорченная."

# dlc_cupid/ch/cupid/sasha_scottie/aftermath.rpy:74
translate russian cupid_sasha_scottie_aftermath_3ae0e29a:
    scottie.say "Хотел, чтобы она была у тебя до свадьбы, детка."

# dlc_cupid/ch/cupid/sasha_scottie/aftermath.rpy:75
translate russian cupid_sasha_scottie_aftermath_d6ba6e03:
    scottie.say "И ты, чувак. Первый ряд. Без тебя я бы на ней не женился."

# dlc_cupid/ch/cupid/sasha_scottie/aftermath.rpy:79
translate russian cupid_sasha_scottie_aftermath_9398d49b:
    scottie.say "Как ты и говорил, чувак. Показать, что я думаю о её чувствах и всё такое."

# dlc_cupid/ch/cupid/sasha_scottie/aftermath.rpy:80
translate russian cupid_sasha_scottie_aftermath_bd98bed6:
    scottie.say "Это шаг два. А шаг три — она меня прощает, да?"

# dlc_cupid/ch/cupid/sasha_scottie/aftermath.rpy:82
translate russian cupid_sasha_scottie_aftermath_3ac23e92:
    "Сашины ноги соскальзывают с моих колен."

# dlc_cupid/ch/cupid/sasha_scottie/aftermath.rpy:84
translate russian cupid_sasha_scottie_aftermath_e0e8c36c:
    sasha.say "Кто это говорил?"

# dlc_cupid/ch/cupid/sasha_scottie/aftermath.rpy:87
translate russian cupid_sasha_scottie_aftermath_ccd596a4:
    scottie.say "[heroname]! Он меня всё это время тренировал."

# dlc_cupid/ch/cupid/sasha_scottie/aftermath.rpy:88
translate russian cupid_sasha_scottie_aftermath_88160fbd:
    scottie.say "Он типа мой любовный сэнсэй."

# dlc_cupid/ch/cupid/sasha_scottie/aftermath.rpy:92
translate russian cupid_sasha_scottie_aftermath_2d90dbb3:
    scottie.say "Пикник в парке? Это он мне в ухо говорил. Мелкий наушник и всё такое. Шпионские штучки."

# dlc_cupid/ch/cupid/sasha_scottie/aftermath.rpy:95
translate russian cupid_sasha_scottie_aftermath_4cd31030:
    sasha.say "Так это ты был голосом у него в голове?"

# dlc_cupid/ch/cupid/sasha_scottie/aftermath.rpy:97
translate russian cupid_sasha_scottie_aftermath_a6125ba8:
    "Теперь понятно, с чего Скотти вдруг заговорил как парень, у которого дома есть хоть одна книга."

# dlc_cupid/ch/cupid/sasha_scottie/aftermath.rpy:99
translate russian cupid_sasha_scottie_aftermath_245c31f5:
    "Саша одаривает меня одним тяжёлым взглядом и снова поворачивается к Скотти."

# dlc_cupid/ch/cupid/sasha_scottie/aftermath.rpy:101
translate russian cupid_sasha_scottie_aftermath_a7944d0c:
    sasha.say "Скотти. [heroname] и я переспали."

# dlc_cupid/ch/cupid/sasha_scottie/aftermath.rpy:104
translate russian cupid_sasha_scottie_aftermath_90f41697:
    scottie.say "Типа... реально спала? Или в другом смысле?"

# dlc_cupid/ch/cupid/sasha_scottie/aftermath.rpy:107
translate russian cupid_sasha_scottie_aftermath_13f14a0f:
    sasha.say "В другом смысле, Скотти."

# dlc_cupid/ch/cupid/sasha_scottie/aftermath.rpy:110
translate russian cupid_sasha_scottie_aftermath_9fefa783:
    "До него это доходит медленно, слово за словом."

# dlc_cupid/ch/cupid/sasha_scottie/aftermath.rpy:112
translate russian cupid_sasha_scottie_aftermath_09b0b130:
    scottie.say "Чувак."

# dlc_cupid/ch/cupid/sasha_scottie/aftermath.rpy:113
translate russian cupid_sasha_scottie_aftermath_7ad0d00c:
    scottie.say "Ты мой второй пилот. Второй пилот не сажает самолёт."

# dlc_cupid/ch/cupid/sasha_scottie/aftermath.rpy:115
translate russian cupid_sasha_scottie_aftermath_61c653f0:
    scottie.say "Мы же собирались пожениться, чувак."

# dlc_cupid/ch/cupid/sasha_scottie/aftermath.rpy:117
translate russian cupid_sasha_scottie_aftermath_3e97895a:
    "Саша складывает руки на груди и поворачивается ко мне. Что бы ни было дальше, она хочет услышать это от меня."

# dlc_cupid/ch/cupid/sasha_scottie/aftermath.rpy:121
translate russian cupid_sasha_scottie_aftermath_6f9761bf:
    mike.say "Прости, чувак. Я серьёзно."

# dlc_cupid/ch/cupid/sasha_scottie/aftermath.rpy:122
translate russian cupid_sasha_scottie_aftermath_3b3daa37:
    mike.say "Но я её не отдам, так что отвали, Скотти."

# dlc_cupid/ch/cupid/sasha_scottie/aftermath.rpy:124
translate russian cupid_sasha_scottie_aftermath_38f210bc:
    "Брови у Саши ползут вверх."

# dlc_cupid/ch/cupid/sasha_scottie/aftermath.rpy:126
translate russian cupid_sasha_scottie_aftermath_1ca19cc4:
    sasha.say "Ты что, сейчас забил меня за собой?"

# dlc_cupid/ch/cupid/sasha_scottie/aftermath.rpy:127
translate russian cupid_sasha_scottie_aftermath_a81aafc6:
    sasha.say "Фу. Повтори как-нибудь."

# dlc_cupid/ch/cupid/sasha_scottie/aftermath.rpy:131
translate russian cupid_sasha_scottie_aftermath_c99918f9:
    scottie.say "Ладно. Ага. Наверное, справедливо."

# dlc_cupid/ch/cupid/sasha_scottie/aftermath.rpy:134
translate russian cupid_sasha_scottie_aftermath_c0c51e41:
    mike.say "Я облажался, Скотти. Я тебе должен."

# dlc_cupid/ch/cupid/sasha_scottie/aftermath.rpy:136
translate russian cupid_sasha_scottie_aftermath_eb44e90f:
    sasha.say "Ты должен ЕМУ?"

# dlc_cupid/ch/cupid/sasha_scottie/aftermath.rpy:137
translate russian cupid_sasha_scottie_aftermath_44fb5f58:
    sasha.say "Я тебе что, газонокосилка, которую ты у него одолжил? Никто никому меня не должен, [lssb_sasha.hero_name()]."

# dlc_cupid/ch/cupid/sasha_scottie/aftermath.rpy:141
translate russian cupid_sasha_scottie_aftermath_fb8077f9:
    scottie.say "Не, чувак. Ничего ты мне не должен."

# dlc_cupid/ch/cupid/sasha_scottie/aftermath.rpy:143
translate russian cupid_sasha_scottie_aftermath_6afa267a:
    "Скотти аккуратно кладёт пакет на подлокотник дивана."

# dlc_cupid/ch/cupid/sasha_scottie/aftermath.rpy:145
translate russian cupid_sasha_scottie_aftermath_197b8731:
    scottie.say "Футболку всё равно оставь, Саш. В этот раз размер правильный."

# dlc_cupid/ch/cupid/sasha_scottie/aftermath.rpy:146
translate russian cupid_sasha_scottie_aftermath_fd6e92ae:
    scottie.say "Я даже бирку проверил и всё такое."

# dlc_cupid/ch/cupid/sasha_scottie/aftermath.rpy:149
translate russian cupid_sasha_scottie_aftermath_050019fc:
    "За ним закрывается входная дверь."

# dlc_cupid/ch/cupid/sasha_scottie/aftermath.rpy:151
translate russian cupid_sasha_scottie_aftermath_ff639a83:
    "Саша достаёт футболку из пакета и поднимает её перед собой: чёрная, логотип нарочно напечатан потрескавшимся, точь-в-точь как на старой."

# dlc_cupid/ch/cupid/sasha_scottie/aftermath.rpy:153
translate russian cupid_sasha_scottie_aftermath_23641039:
    sasha.say "Он проверил бирку."

# dlc_cupid/ch/cupid/sasha_scottie/aftermath.rpy:155
translate russian cupid_sasha_scottie_aftermath_2a486940:
    sasha.say "Я ведь собиралась замуж за этого идиота. Придётся всё отменить, да?"

# dlc_cupid/ch/cupid/sasha_scottie/aftermath.rpy:159
translate russian cupid_sasha_scottie_aftermath_11fe6f3a:
    sasha.say "Ладно. Ты и я, наверх."

# dlc_cupid/ch/cupid/sasha_scottie/aftermath.rpy:160
translate russian cupid_sasha_scottie_aftermath_b11d352d:
    sasha.say "Сначала разберёмся, что это вообще такое. А потом, наверное, перестанем разговаривать."

# dlc_cupid/ch/cupid/sasha_scottie/aftermath.rpy:162
translate russian cupid_sasha_scottie_aftermath_4efe2bf0:
    "Она бросает футболку на диван и утаскивает меня за запястье, прежде чем я успеваю возразить."

# dlc_cupid/ch/cupid/sasha_scottie/aftermath.rpy:165
translate russian cupid_sasha_scottie_aftermath_877b8e5c:
    sasha.say "Я к себе, [lssb_sasha.hero_name()]."

# dlc_cupid/ch/cupid/sasha_scottie/aftermath.rpy:166
translate russian cupid_sasha_scottie_aftermath_9afc4946:
    sasha.say "Реши, кто я для тебя, до того как я спущусь."

# dlc_cupid/ch/cupid/sasha_scottie/aftermath.rpy:169
translate russian cupid_sasha_scottie_aftermath_b2761739:
    "Футболку она забирает с собой."

# dlc_cupid/ch/cupid/sasha_scottie/aftermath.rpy:170
translate russian cupid_sasha_scottie_aftermath_86845721:
    "Я остаюсь на диване с пустым пакетом и вопросом, на который к ужину лучше бы найти хороший ответ."

# dlc_cupid/ch/cupid/sasha_scottie/event.rpy:872
translate russian cupid_sasha_scottie_event_03_f7ffc667:
    "За двадцать минут до начала музыки у меня в кармане пиджака вибрирует телефон."

# dlc_cupid/ch/cupid/sasha_scottie/event.rpy:873
translate russian cupid_sasha_scottie_event_03_3a6094f3:
    "Это Саша. Три слова, без эмодзи."

# dlc_cupid/ch/cupid/sasha_scottie/event.rpy:874
translate russian cupid_sasha_scottie_event_03_7ccd1655:
    "{i}Женский туалет. Сейчас же.{/i}"

# dlc_cupid/ch/cupid/sasha_scottie/event.rpy:877
translate russian cupid_sasha_scottie_event_03_ad6204f0:
    "Когда я прохожу мимо притвора, Скотти показывает мне два больших пальца, беззвучно проговаривая про себя клятвы."

# dlc_cupid/ch/cupid/sasha_scottie/event.rpy:881
translate russian cupid_sasha_scottie_event_03_a9d7540a:
    "Что бы там ни было, это подождёт, пока она не выйдет замуж."

# dlc_cupid/ch/cupid/sasha_scottie/event.rpy:882
translate russian cupid_sasha_scottie_event_03_d217001d:
    "Я убираю телефон обратно в карман и иду искать жениха."

# dlc_cupid/ch/cupid/sasha_scottie/event.rpy:918
translate russian cupid_sasha_scottie_event_03_d095e19b:
    "Двадцать минут назад это платье висело на двери кабинки."

# dlc_cupid/ch/cupid/sasha_scottie/event.rpy:919
translate russian cupid_sasha_scottie_event_03_51a43b97:
    "А теперь оно плывёт по проходу, будто с ним ничего и не случалось."

# dlc_cupid/ch/cupid/sasha_scottie/event.rpy:998
translate russian cupid_sasha_scottie_event_03_5555a7fc:
    "Улыбки Скотти одной хватило бы, чтобы осветить всю часовню."

# dlc_cupid/ch/cupid/sasha_scottie/event.rpy:999
translate russian cupid_sasha_scottie_event_03_f0cffe17:
    "Саша смотрит поверх его плеча — на меня."

# dlc_cupid/ch/cupid/sasha_scottie/event.rpy:1002
translate russian cupid_sasha_scottie_event_03_3a9107e9:
    "Я не говорю ни слова. Просто качаю головой — один раз, достаточно медленно, чтобы она не могла понять это неправильно."

# dlc_cupid/ch/cupid/sasha_scottie/event.rpy:1006
translate russian cupid_sasha_scottie_event_03_d4919f59:
    "Саша на один удар сердца задерживает на мне взгляд."

# dlc_cupid/ch/cupid/sasha_scottie/event.rpy:1007
translate russian cupid_sasha_scottie_event_03_3e9de406:
    "Потом отводит глаза и расправляет плечи — так же, как перед выступлением."

# dlc_cupid/ch/cupid/sasha_scottie/event.rpy:1009
translate russian cupid_sasha_scottie_event_03_b7f9ba33:
    "Я сохраняю непроницаемое лицо, сложив руки на коробочке с кольцами."

# dlc_cupid/ch/cupid/sasha_scottie/event.rpy:1010
translate russian cupid_sasha_scottie_event_03_111c76aa:
    "Сашин взгляд задерживается на мне на секунду дольше, чем нужно. Потом она снова поворачивается к священнику."

# dlc_cupid/ch/cupid/sasha_scottie/event.rpy:1027
translate russian cupid_sasha_scottie_event_03_63d94b5d:
    "«Вмешался» — это ещё мягко сказано о том, что я сделал в женском туалете."

# dlc_cupid/ch/cupid/sasha_scottie/wedding.rpy:20
translate russian cupid_sasha_scottie_wedding_fuck_b45d4ecf:
    "В женском туалете в глубине часовни пахнет лилиями и лаком для волос."

# dlc_cupid/ch/cupid/sasha_scottie/wedding.rpy:21
translate russian cupid_sasha_scottie_wedding_fuck_65221ec6:
    "А посреди стоит Саша в свадебном платье, одна, и смотрит на себя в зеркало."

# dlc_cupid/ch/cupid/sasha_scottie/wedding.rpy:23
translate russian cupid_sasha_scottie_wedding_fuck_8a0c8c83:
    sasha.say "Запри дверь."

# dlc_cupid/ch/cupid/sasha_scottie/wedding.rpy:25
translate russian cupid_sasha_scottie_wedding_fuck_38db52d4:
    "Я запираю. А потом приваливаюсь к ней, потому что колени стали как-то ненадёжны."

# dlc_cupid/ch/cupid/sasha_scottie/wedding.rpy:26
translate russian cupid_sasha_scottie_wedding_fuck_fb33ee29:
    mike.say "Ты в порядке?"

# dlc_cupid/ch/cupid/sasha_scottie/wedding.rpy:28
translate russian cupid_sasha_scottie_wedding_fuck_429735b9:
    sasha.say "Нет, я не в порядке, [lssb_sasha.hero_name()]. Я выхожу замуж через двадцать минут."

# dlc_cupid/ch/cupid/sasha_scottie/wedding.rpy:29
translate russian cupid_sasha_scottie_wedding_fuck_ac2b3e4c:
    sasha.say "За Скотти. Которого ты, по сути, собрал из запчастей."

# dlc_cupid/ch/cupid/sasha_scottie/wedding.rpy:30
translate russian cupid_sasha_scottie_wedding_fuck_f29424d5:
    sasha.say "Он вчера вечером рассказал, что ты его тренировал. Парк, наушник, всё. Он считал, что это романтично."

# dlc_cupid/ch/cupid/sasha_scottie/wedding.rpy:32
translate russian cupid_sasha_scottie_wedding_fuck_c4a4999d:
    "Она отворачивается от зеркала и смотрит теперь на меня."

# dlc_cupid/ch/cupid/sasha_scottie/wedding.rpy:34
translate russian cupid_sasha_scottie_wedding_fuck_62981655:
    sasha.say "Так скажи мне, что я не делаю ошибку."

# dlc_cupid/ch/cupid/sasha_scottie/wedding.rpy:36
translate russian cupid_sasha_scottie_wedding_fuck_55cc8d0b:
    "Я открываю рот, и ничего честного из него не выходит."

# dlc_cupid/ch/cupid/sasha_scottie/wedding.rpy:37
translate russian cupid_sasha_scottie_wedding_fuck_db1686ab:
    "Саша смотрит, как я не могу ответить. Потом в три быстрых шага пересекает кафель и целует меня так сильно, что я ударяюсь затылком о дверь."

# dlc_cupid/ch/cupid/sasha_scottie/wedding.rpy:39
translate russian cupid_sasha_scottie_wedding_fuck_c3625ba1:
    sasha.say "Ага. Так я и думала."

# dlc_cupid/ch/cupid/sasha_scottie/wedding.rpy:40
translate russian cupid_sasha_scottie_wedding_fuck_383e6694:
    sasha.say "Двадцать минут. Думаешь, сумеешь сделать так, чтобы невеста опоздала на собственную свадьбу?"

# dlc_cupid/ch/cupid/sasha_scottie/wedding.rpy:45
translate russian cupid_sasha_scottie_wedding_fuck_8ecf348c:
    "Пока я поправляю галстук, она уже снова у зеркала и подкрашивает губы, будто меня здесь нет."

# dlc_cupid/ch/cupid/sasha_scottie/wedding.rpy:46
translate russian cupid_sasha_scottie_wedding_fuck_12ab5dc2:
    "Я выхожу и иду искать Скотти."

# dlc_cupid/ch/cupid/sasha_scottie/wedding.rpy:49
translate russian cupid_sasha_scottie_wedding_fuck_58de98ae:
    "Она заводит руки за спину и тянет молнию вниз."

# dlc_cupid/ch/cupid/sasha_scottie/wedding.rpy:50
translate russian cupid_sasha_scottie_wedding_fuck_e0d62102:
    sasha.say "Если ты хоть что-нибудь прольёшь на это платье, клянусь богом, я убью тебя на глазах у священника."

# dlc_cupid/ch/cupid/sasha_scottie/wedding.rpy:52
translate russian cupid_sasha_scottie_wedding_fuck_6ddbe1ea:
    "Платье отправляется на дверь ближайшей кабинки, фата — поверх него, и вот она стоит на каблуках и больше ни в чём, с таким взглядом, будто подначивает меня струсить."

# dlc_cupid/ch/cupid/sasha_scottie/wedding.rpy:53
translate russian cupid_sasha_scottie_wedding_fuck_0d38b7f5:
    "Я не трушу."

# dlc_cupid/ch/cupid/sasha_scottie/wedding.rpy:55
translate russian cupid_sasha_scottie_wedding_fuck_75deb3ea:
    sasha.say "Оставь фату там, где я её вижу. Хочу смотреть на неё, пока ты меня трахаешь."

# dlc_cupid/ch/cupid/sasha_scottie/wedding.rpy:57
translate russian cupid_sasha_scottie_wedding_fuck_15412396:
    "Я разворачиваю её лицом к длинной столешнице, перехватываю оба запястья и отвожу её руки назад, пока ей не приходится прогнуться для меня."

# dlc_cupid/ch/cupid/sasha_scottie/wedding.rpy:58
translate russian cupid_sasha_scottie_wedding_fuck_24b064f6:
    "В зеркале над раковинами видно, как она закусывает губу."

# dlc_cupid/ch/cupid/sasha_scottie/wedding.rpy:64
translate russian cupid_sasha_scottie_wedding_fuck_bb061c32:
    "Я вхожу в неё одним долгим, медленным движением, до конца, и у неё вырывается шумный выдох."

# dlc_cupid/ch/cupid/sasha_scottie/wedding.rpy:66
translate russian cupid_sasha_scottie_wedding_fuck_e127b462:
    sasha.say "Боже... ладно. Ладно. Делай как хочешь. Только не останавливайся."

# dlc_cupid/ch/cupid/sasha_scottie/wedding.rpy:68
translate russian cupid_sasha_scottie_wedding_fuck_07ffd4b0:
    sasha.say "Трахни меня так, будто ты это всерьёз, [lssb_sasha.hero_name()]. Второй попытки у тебя не будет."

# dlc_cupid/ch/cupid/sasha_scottie/wedding.rpy:70
translate russian cupid_sasha_scottie_wedding_fuck_a3cd3684:
    sasha.say "Нн... чёрт. Только посмей сейчас сбавить темп."

# dlc_cupid/ch/cupid/sasha_scottie/wedding.rpy:73
translate russian cupid_sasha_scottie_wedding_fuck_6ca56f3b:
    "Я выхожу из неё наполовину и снова вбиваюсь, и шлепок отражается от кафеля."

# dlc_cupid/ch/cupid/sasha_scottie/wedding.rpy:74
translate russian cupid_sasha_scottie_wedding_fuck_9b455bee:
    "Там, в часовне, кто-то разыгрывает гаммы на органе."

# dlc_cupid/ch/cupid/sasha_scottie/wedding.rpy:75
translate russian cupid_sasha_scottie_wedding_fuck_f36ad401:
    "Саша задыхаясь смеётся — пока следующий толчок не превращает смех в стон."

# dlc_cupid/ch/cupid/sasha_scottie/wedding.rpy:76
translate russian cupid_sasha_scottie_wedding_fuck_08c27956:
    sasha.say "Он там стоит в прокатном смокинге и читает свои клятвы с карточки распорядителям..."

# dlc_cupid/ch/cupid/sasha_scottie/wedding.rpy:77
translate russian cupid_sasha_scottie_wedding_fuck_4a4818be:
    sasha.say "А его любовный тренер сейчас по самые яйца в его невесте. Ты его так хорошо выдрессировал, [lssb_sasha.hero_name()]."

