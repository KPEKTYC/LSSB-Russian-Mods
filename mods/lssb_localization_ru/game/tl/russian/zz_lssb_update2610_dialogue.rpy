    palla.say "Шон. Я не могу."

# dlc_cupid/ch/cupid/palla_shawn/wedding.rpy:386
translate russian cupid_palla_shawn_wedding_calledoff_68c4b8f1:
    shawn.say "Что? Ты сказала «да». Я слышал. Все слышали."

# dlc_cupid/ch/cupid/palla_shawn/wedding.rpy:389
translate russian cupid_palla_shawn_wedding_calledoff_043c133c:
    palla.say "Я беру свои слова назад."

# dlc_cupid/ch/cupid/palla_shawn/wedding.rpy:390
translate russian cupid_palla_shawn_wedding_calledoff_5d0fc0d1:
    "Priest" "Вообще-то так не совсем..."

# dlc_cupid/ch/cupid/palla_shawn/wedding.rpy:392
translate russian cupid_palla_shawn_wedding_calledoff_181515a6:
    palla.say "Захлопнись, святоша."

# dlc_cupid/ch/cupid/palla_shawn/wedding.rpy:395
translate russian cupid_palla_shawn_wedding_calledoff_d2a38d91:
    "Шон переводит взгляд с неё на меня, и я вижу, как до него доходит."

# dlc_cupid/ch/cupid/palla_shawn/wedding.rpy:397
translate russian cupid_palla_shawn_wedding_calledoff_80cd376c:
    shawn.say "Он? Сегодня?"

# dlc_cupid/ch/cupid/palla_shawn/wedding.rpy:400
translate russian cupid_palla_shawn_wedding_calledoff_177b334b:
    palla.say "Не заставляй меня говорить это при твоей бабушке."

# dlc_cupid/ch/cupid/palla_shawn/wedding.rpy:403
translate russian cupid_palla_shawn_wedding_calledoff_18298267:
    "Шон очень осторожно снимает бутоньерку, будто она может взорваться, и кладёт её на алтарную ограду."

# dlc_cupid/ch/cupid/palla_shawn/wedding.rpy:405
translate russian cupid_palla_shawn_wedding_calledoff_8f24acbb:
    shawn.say "Пойду верну торт."

# dlc_cupid/ch/cupid/palla_shawn/wedding.rpy:408
translate russian cupid_palla_shawn_wedding_calledoff_5f9ebb0b:
    "Он уходит по проходу один. Никто на скамьях не знает, куда девать глаза."

# dlc_cupid/ch/cupid/palla_shawn/wedding.rpy:416
translate russian cupid_palla_shawn_wedding_calledoff_18cb79da:
    palla.say "Пошли. Пока тушь не потекла."

# dlc_cupid/ch/cupid/palla_shawn/wedding.rpy:422
translate russian cupid_palla_shawn_wedding_calledoff_2ee05b28:
    "Мы выходим на улицу, а половина гостей так и сидит, застыв, на скамьях позади нас."

# dlc_cupid/ch/cupid/palla_shawn/wedding.rpy:423
translate russian cupid_palla_shawn_wedding_calledoff_03d4b6a6:
    "Палла в свадебном платье на тротуаре заставляет оборачиваться всю улицу, и она это знает."

# dlc_cupid/ch/cupid/palla_shawn/wedding.rpy:425
translate russian cupid_palla_shawn_wedding_calledoff_c02033d7:
    palla.say "Не воображай себе ничего. Ты мне от этого никем не становишься."

# dlc_cupid/ch/cupid/palla_shawn/wedding.rpy:426
translate russian cupid_palla_shawn_wedding_calledoff_ecd121f8:
    palla.say "Просто я не собиралась выходить за мужчину, пока ещё чувствую тебя."

# dlc_cupid/ch/cupid/palla_shawn/wedding.rpy:428
translate russian cupid_palla_shawn_wedding_calledoff_a9f3f6a7:
    palla.say "А мне сегодня вечером возвращаться в одну квартиру с ним."

# dlc_cupid/ch/cupid/palla_shawn/wedding.rpy:429
translate russian cupid_palla_shawn_wedding_calledoff_c643a277:
    palla.say "Он заварит мне чаю и не скажет ни слова. Честно, лучше бы он чем-нибудь швырнул."

# dlc_cupid/ch/cupid/palla_shawn/wedding.rpy:431
translate russian cupid_palla_shawn_wedding_calledoff_02d23398:
    mike.say "Хочешь, я пойду с тобой?"

# dlc_cupid/ch/cupid/palla_shawn/wedding.rpy:433
translate russian cupid_palla_shawn_wedding_calledoff_53268bbc:
    palla.say "Боже, нет. Позвони завтра. Попозже. Я буду спать как минимум до двух."

# dlc_cupid/ch/cupid/palla_shawn/wedding.rpy:436
translate russian cupid_palla_shawn_wedding_calledoff_6d3c9805:
    "Она уходит в свадебном платье и ни разу не оглядывается."

# dlc_cupid/ch/cupid/reona_jack/aftermath.rpy:49
translate russian cupid_reona_jack_aftermath_aeeae196:
    "Реона пришла ко мне днём с учебником и маркером."

# dlc_cupid/ch/cupid/reona_jack/aftermath.rpy:50
translate russian cupid_reona_jack_aftermath_d3f5bec7:
    "Учебник так и лежит на журнальном столике. Не думаю, что кто-то из нас его открывал."

# dlc_cupid/ch/cupid/reona_jack/aftermath.rpy:52
translate russian cupid_reona_jack_aftermath_9266f745:
    "Тут кто-то стучит. Три быстрых удара, пауза, ещё два."

# dlc_cupid/ch/cupid/reona_jack/aftermath.rpy:53
translate russian cupid_reona_jack_aftermath_3f2edaf5:
    "Я знаю только одного человека, который стучит шифром."

# dlc_cupid/ch/cupid/reona_jack/aftermath.rpy:56
translate russian cupid_reona_jack_aftermath_cd976b5b:
    jack.say "Дружище!"

# dlc_cupid/ch/cupid/reona_jack/aftermath.rpy:57
translate russian cupid_reona_jack_aftermath_1f3a9e4b:
    jack.say "Так, пока ничего не говори. Просто посмотри."

# dlc_cupid/ch/cupid/reona_jack/aftermath.rpy:59
translate russian cupid_reona_jack_aftermath_fa86aeb4:
    "Он поднимает маленький пластиковый футляр, будто святую реликвию."

# dlc_cupid/ch/cupid/reona_jack/aftermath.rpy:60
translate russian cupid_reona_jack_aftermath_34c54e65:
    "Внутри миниатюра, сантиметра два с половиной: рыцарь в серебряных латах с поднятым мечом, и каждая прядка волос прорисована вручную."

# dlc_cupid/ch/cupid/reona_jack/aftermath.rpy:62
translate russian cupid_reona_jack_aftermath_f8e6560d:
    jack.say "Это паладин Реоны. Я до четырёх утра сидел над волосами."

# dlc_cupid/ch/cupid/reona_jack/aftermath.rpy:65
translate russian cupid_reona_jack_aftermath_b1ee3e95:
    jack.say "Подарю ей фигурку на следующей сессии, а потом всё ей скажу. Всё."

# dlc_cupid/ch/cupid/reona_jack/aftermath.rpy:66
translate russian cupid_reona_jack_aftermath_6fa92c7c:
    jack.say "Ты же видел её в мамином саду, [hero.name]. Она держала меня за руку!"

# dlc_cupid/ch/cupid/reona_jack/aftermath.rpy:70
translate russian cupid_reona_jack_aftermath_5b6719d2:
    jack.say "Подарю ей фигурку на следующей сессии."

# dlc_cupid/ch/cupid/reona_jack/aftermath.rpy:71
translate russian cupid_reona_jack_aftermath_0f839cf5:
    jack.say "И если ей понравится, может, я наконец позову её на свидание. Ну, только вдвоём."

# dlc_cupid/ch/cupid/reona_jack/aftermath.rpy:73
translate russian cupid_reona_jack_aftermath_1ed875f4:
    jack.say "Ты всю кампанию был моим напарником. Без тебя я бы ничего из этого не сделал."

# dlc_cupid/ch/cupid/reona_jack/aftermath.rpy:75
translate russian cupid_reona_jack_aftermath_7e3ff5e4:
    "Я открываю рот, чтобы ответить."

# dlc_cupid/ch/cupid/reona_jack/aftermath.rpy:76
translate russian cupid_reona_jack_aftermath_9636d040:
    "И тут сверху по лестнице у меня за спиной доносится голос."

# dlc_cupid/ch/cupid/reona_jack/aftermath.rpy:77
translate russian cupid_reona_jack_aftermath_baf7f838:
    reona.say "[hero.name]? Ты взял мою резинку для волос, или она там просто умерла?"

# dlc_cupid/ch/cupid/reona_jack/aftermath.rpy:80
translate russian cupid_reona_jack_aftermath_8d6bbf7c:
    "Реона босиком входит в комнату, щёки у неё всё ещё розовые."

# dlc_cupid/ch/cupid/reona_jack/aftermath.rpy:81
translate russian cupid_reona_jack_aftermath_ef44c8fe:
    "Она замирает как вкопанная, увидев, кто стоит в дверях."

# dlc_cupid/ch/cupid/reona_jack/aftermath.rpy:83
translate russian cupid_reona_jack_aftermath_3e2c7015:
    reona.say "Ой. Привет, Джек."

# dlc_cupid/ch/cupid/reona_jack/aftermath.rpy:86
translate russian cupid_reona_jack_aftermath_f8d28594:
    "Джек смотрит на неё. Потом на меня, и я вижу, как до него доходит."

# dlc_cupid/ch/cupid/reona_jack/aftermath.rpy:88
translate russian cupid_reona_jack_aftermath_3bf16025:
    jack.say "Ты..."

# dlc_cupid/ch/cupid/reona_jack/aftermath.rpy:89
translate russian cupid_reona_jack_aftermath_0708f02e:
    jack.say "Ты же должен был мне помогать."

# dlc_cupid/ch/cupid/reona_jack/aftermath.rpy:90
translate russian cupid_reona_jack_aftermath_a222b0e5:
    jack.say "В этом и был весь смысл игровых вечеров."

# dlc_cupid/ch/cupid/reona_jack/aftermath.rpy:93
translate russian cupid_reona_jack_aftermath_2400849c:
    reona.say "Помогать тебе с чем?"

# dlc_cupid/ch/cupid/reona_jack/aftermath.rpy:95
translate russian cupid_reona_jack_aftermath_88ea1fe8:
    "Джек ей не отвечает. Он всё ещё смотрит на меня."

# dlc_cupid/ch/cupid/reona_jack/aftermath.rpy:96
translate russian cupid_reona_jack_aftermath_b4ad374a:
    "Реона соображает быстрее, чем мы оба ожидали."

# dlc_cupid/ch/cupid/reona_jack/aftermath.rpy:98
translate russian cupid_reona_jack_aftermath_57dd2335:
    reona.say "Боже мой. Я что, была типа квестом?"

# dlc_cupid/ch/cupid/reona_jack/aftermath.rpy:99
translate russian cupid_reona_jack_aftermath_35cc7e64:
    reona.say "Вы двое бросали кубики, кому достанется девушка?"

# dlc_cupid/ch/cupid/reona_jack/aftermath.rpy:102
translate russian cupid_reona_jack_aftermath_b33eb01e:
    jack.say "Всё было не так! Я просто..."

# dlc_cupid/ch/cupid/reona_jack/aftermath.rpy:103
translate russian cupid_reona_jack_aftermath_23de780f:
    jack.say "Ты мне нравилась. С первого курса, Реона. Ты же знаешь."

# dlc_cupid/ch/cupid/reona_jack/aftermath.rpy:106
translate russian cupid_reona_jack_aftermath_cdeed97e:
    "Впервые у Реоны не находится готового ответа."

# dlc_cupid/ch/cupid/reona_jack/aftermath.rpy:108
translate russian cupid_reona_jack_aftermath_c7ad85d6:
    reona.say "Джек, это просто случилось, ладно? Никто ничего не планировал."

# dlc_cupid/ch/cupid/reona_jack/aftermath.rpy:110
translate russian cupid_reona_jack_aftermath_8a45439d:
    "Говоря это, она бросает на меня взгляд — ждёт, поддержу я её или пойду дальше."

# dlc_cupid/ch/cupid/reona_jack/aftermath.rpy:114
translate russian cupid_reona_jack_aftermath_611e5153:
    mike.say "Мне надо было тебе сказать, Джек. Тут я виноват."

# dlc_cupid/ch/cupid/reona_jack/aftermath.rpy:115
translate russian cupid_reona_jack_aftermath_5a634e7d:
    mike.say "Но я не жалею, что так вышло. Теперь я с Реоной, если она меня примет."

# dlc_cupid/ch/cupid/reona_jack/aftermath.rpy:117
translate russian cupid_reona_jack_aftermath_496e6b2c:
    "Брови Реоны взлетают вверх."

# dlc_cupid/ch/cupid/reona_jack/aftermath.rpy:119
translate russian cupid_reona_jack_aftermath_bef1debd:
    reona.say "Если я тебя приму?"

# dlc_cupid/ch/cupid/reona_jack/aftermath.rpy:120
translate russian cupid_reona_jack_aftermath_d18f4dce:
    reona.say "[hero.name], моя резинка для волос где-то у тебя в кровати. По-моему, это «да»."

# dlc_cupid/ch/cupid/reona_jack/aftermath.rpy:124
translate russian cupid_reona_jack_aftermath_8bc955ad:
    jack.say "Круто. Это... круто."

# dlc_cupid/ch/cupid/reona_jack/aftermath.rpy:125
translate russian cupid_reona_jack_aftermath_013f933d:
    jack.say "Вы хорошо смотритесь вместе. Я серьёзно."

# dlc_cupid/ch/cupid/reona_jack/aftermath.rpy:127
translate russian cupid_reona_jack_aftermath_e901299c:
    "Он говорит это как фразу, которую отрепетировал по дороге к выходу."

# dlc_cupid/ch/cupid/reona_jack/aftermath.rpy:129
translate russian cupid_reona_jack_aftermath_c4a7e2c6:
    mike.say "Это было один раз, Джек. Это не обязано ничего менять."

# dlc_cupid/ch/cupid/reona_jack/aftermath.rpy:131
translate russian cupid_reona_jack_aftermath_c7badd39:
    "Реона застывает."

# dlc_cupid/ch/cupid/reona_jack/aftermath.rpy:133
translate russian cupid_reona_jack_aftermath_450e8941:
    reona.say "Ого. Ладно."

# dlc_cupid/ch/cupid/reona_jack/aftermath.rpy:134
translate russian cupid_reona_jack_aftermath_9b62aefd:
    reona.say "Спасибо, что прояснил, [hero.name]."

# dlc_cupid/ch/cupid/reona_jack/aftermath.rpy:138
translate russian cupid_reona_jack_aftermath_c8b3fb8d:
    jack.say "Не надо. Не преуменьшай, чтобы мне было легче."

# dlc_cupid/ch/cupid/reona_jack/aftermath.rpy:139
translate russian cupid_reona_jack_aftermath_e8de36af:
    jack.say "Это не мелочь. Не для меня, и, думаю, не для неё тоже."

# dlc_cupid/ch/cupid/reona_jack/aftermath.rpy:141
translate russian cupid_reona_jack_aftermath_c073d7bd:
    "Джек ставит маленький футляр на тумбочку — бережно, как ставят что-то, что ещё может разбиться."

# dlc_cupid/ch/cupid/reona_jack/aftermath.rpy:143
translate russian cupid_reona_jack_aftermath_db06a29c:
    jack.say "Всё равно отдай ей это. Я раскрашивал для неё."

# dlc_cupid/ch/cupid/reona_jack/aftermath.rpy:144
translate russian cupid_reona_jack_aftermath_056ba7e4:
    jack.say "Паладины ведь должны держать клятвы, да?"

# dlc_cupid/ch/cupid/reona_jack/aftermath.rpy:146
translate russian cupid_reona_jack_aftermath_5073a296:
    "Говоря это, он смотрит на меня."

# dlc_cupid/ch/cupid/reona_jack/aftermath.rpy:149
translate russian cupid_reona_jack_aftermath_b45aa69f:
    "Входная дверь щёлкает, закрываясь."

# dlc_cupid/ch/cupid/reona_jack/aftermath.rpy:151
translate russian cupid_reona_jack_aftermath_d918f2b5:
    "Реона берёт футляр, вертит его в пальцах и щурится на крошечного рыцаря."

# dlc_cupid/ch/cupid/reona_jack/aftermath.rpy:153
translate russian cupid_reona_jack_aftermath_f01d3678:
    reona.say "Он прорисовал волосы. Ну, каждую прядку."

# dlc_cupid/ch/cupid/reona_jack/aftermath.rpy:157
translate russian cupid_reona_jack_aftermath_28a39115:
    reona.say "Так что, похоже, теперь ты от меня никуда не денешься, [hero.name]."

# dlc_cupid/ch/cupid/reona_jack/aftermath.rpy:158
translate russian cupid_reona_jack_aftermath_e9697c68:
    reona.say "Просто чтоб ты знал: меня много. Спроси кого угодно."

# dlc_cupid/ch/cupid/reona_jack/aftermath.rpy:160
translate russian cupid_reona_jack_aftermath_1284c523:
    "Она прячет паладина в сумку, берёт меня за руку и тянет к лестнице."

# dlc_cupid/ch/cupid/reona_jack/aftermath.rpy:161
translate russian cupid_reona_jack_aftermath_650fa017:
    "Учебник остаётся ровно там, где лежал."

# dlc_cupid/ch/cupid/reona_jack/aftermath.rpy:164
translate russian cupid_reona_jack_aftermath_342c3e58:
    reona.say "Пойду найду свою резинку, [hero.name]."

# dlc_cupid/ch/cupid/reona_jack/aftermath.rpy:165
translate russian cupid_reona_jack_aftermath_b9f28b42:
    reona.say "А потом ты приготовишь мне что-нибудь поесть."

# dlc_cupid/ch/cupid/reona_jack/aftermath.rpy:166
translate russian cupid_reona_jack_aftermath_cda0d164:
    reona.say "И пока готовишь, придумаешь для меня слово получше, чем «один раз», потому что это неправильное."

# dlc_cupid/ch/cupid/reona_jack/aftermath.rpy:169
translate russian cupid_reona_jack_aftermath_c1c5d58f:
    "Она уносит паладина с собой наверх."

# dlc_cupid/ch/cupid/reona_jack/aftermath.rpy:170
translate russian cupid_reona_jack_aftermath_4b2e81ff:
    "Я стою и слушаю, как она роется в моей комнате, и пытаюсь придумать ответ, в который она поверит."

# dlc_cupid/ch/cupid/sam_ryan/aftermath.rpy:61
translate russian cupid_sam_ryan_aftermath_e31ed10a:
    "Сэм замечает меня раньше, чем я решаю, можно ли мне вообще поздороваться."

# dlc_cupid/ch/cupid/sam_ryan/aftermath.rpy:63
translate russian cupid_sam_ryan_aftermath_23ca3bf4:
    mike.say "Привет, [samantha.callname]."

# dlc_cupid/ch/cupid/sam_ryan/aftermath.rpy:66
translate russian cupid_sam_ryan_aftermath_4c6f8b19:
    samantha.say "Не надо."

# dlc_cupid/ch/cupid/sam_ryan/aftermath.rpy:67
translate russian cupid_sam_ryan_aftermath_20a7e42f:
    samantha.say "Я всё ещё слишком злюсь, чтобы сделать это красиво, так что сделаю быстро."

# dlc_cupid/ch/cupid/sam_ryan/aftermath.rpy:71
translate russian cupid_sam_ryan_aftermath_35670987:
    "Глаза у неё опухшие, и, чтобы это скрыть, она накрасилась вдвое сильнее обычного."

# dlc_cupid/ch/cupid/sam_ryan/aftermath.rpy:73
translate russian cupid_sam_ryan_aftermath_bf15ca77:
    samantha.say "Привет, ты."

# dlc_cupid/ch/cupid/sam_ryan/aftermath.rpy:74
translate russian cupid_sam_ryan_aftermath_3eb48bcb:
    samantha.say "Я на ногах и одета. На этой неделе это мой максимум."

# dlc_cupid/ch/cupid/sam_ryan/aftermath.rpy:78
translate russian cupid_sam_ryan_aftermath_e7feeb64:
    "Она краснеет от самого воротника, а у Сэм это очень много красного."

# dlc_cupid/ch/cupid/sam_ryan/aftermath.rpy:80
translate russian cupid_sam_ryan_aftermath_7be94306:
    samantha.say "Привет."

# dlc_cupid/ch/cupid/sam_ryan/aftermath.rpy:81
translate russian cupid_sam_ryan_aftermath_6393bb61:
    samantha.say "Прости, у меня с лицом что-то творится. Не обращай внимания на моё лицо."

# dlc_cupid/ch/cupid/sam_ryan/aftermath.rpy:84
translate russian cupid_sam_ryan_aftermath_a6b22f1e:
    samantha.say "По дороге домой я кое-что поняла."

# dlc_cupid/ch/cupid/sam_ryan/aftermath.rpy:86
translate russian cupid_sam_ryan_aftermath_29bb8e5e:
    samantha.say "Твоё барбекю. Бри и Саша твердили Райану, как ему повезло, каждый раз, как он подходил к грилю."

# dlc_cupid/ch/cupid/sam_ryan/aftermath.rpy:87
translate russian cupid_sam_ryan_aftermath_95df5132:
    samantha.say "Это ведь ты всё подстроил, да?"

# dlc_cupid/ch/cupid/sam_ryan/aftermath.rpy:90
translate russian cupid_sam_ryan_aftermath_623cff41:
    samantha.say "Эти фотоальбомы. Барбекю, которое ты обрушил на нас прямо с порога."

# dlc_cupid/ch/cupid/sam_ryan/aftermath.rpy:91
translate russian cupid_sam_ryan_aftermath_305804be:
    samantha.say "Ты хотел, чтобы Райан вспомнил, как ему со мной повезло."

# dlc_cupid/ch/cupid/sam_ryan/aftermath.rpy:93
translate russian cupid_sam_ryan_aftermath_49c9b2e8:
    mike.say "Я пытался помочь."

# dlc_cupid/ch/cupid/sam_ryan/aftermath.rpy:95
translate russian cupid_sam_ryan_aftermath_7290a703:
    samantha.say "Ты пытался починить мой брак, [lssb_samantha.hero_name()]."

# dlc_cupid/ch/cupid/sam_ryan/aftermath.rpy:96
translate russian cupid_sam_ryan_aftermath_d9d1f402:
    samantha.say "А потом я оказалась в твоей постели."

# dlc_cupid/ch/cupid/sam_ryan/aftermath.rpy:100
translate russian cupid_sam_ryan_aftermath_4d9f1c00:
    samantha.say "И ты всё это время знал, чем он занимается."

# dlc_cupid/ch/cupid/sam_ryan/aftermath.rpy:101
translate russian cupid_sam_ryan_aftermath_07290971:
    samantha.say "Ты играл в сваху для мужчины, которого видел с другой женщиной."

# dlc_cupid/ch/cupid/sam_ryan/aftermath.rpy:105
translate russian cupid_sam_ryan_aftermath_8e9cb538:
    samantha.say "Так что, пожалуйста, больше не зови нас в гости."

# dlc_cupid/ch/cupid/sam_ryan/aftermath.rpy:106
translate russian cupid_sam_ryan_aftermath_81275839:
    samantha.say "Я не могу сидеть за твоим столом напротив него и передавать кетчуп."

# dlc_cupid/ch/cupid/sam_ryan/aftermath.rpy:110
translate russian cupid_sam_ryan_aftermath_ce791200:
    samantha.say "Кстати, мы не придём на барбекю."

# dlc_cupid/ch/cupid/sam_ryan/aftermath.rpy:111
translate russian cupid_sam_ryan_aftermath_8add35ba:
    samantha.say "Скажу Райану, что ты заболел. Он будет в восторге."

# dlc_cupid/ch/cupid/sam_ryan/aftermath.rpy:113
translate russian cupid_sam_ryan_aftermath_11c5f851:
    "Она ждёт, что я что-нибудь скажу."

# dlc_cupid/ch/cupid/sam_ryan/aftermath.rpy:116
translate russian cupid_sam_ryan_aftermath_7b2eb25b:
    mike.say "Я больше не чиню вас двоих, Сэм."

# dlc_cupid/ch/cupid/sam_ryan/aftermath.rpy:117
translate russian cupid_sam_ryan_aftermath_f16a3105:
    mike.say "Я не хочу, чтобы это чинилось."

# dlc_cupid/ch/cupid/sam_ryan/aftermath.rpy:120
translate russian cupid_sam_ryan_aftermath_23f4b220:
    "Её челюсть чуть-чуть разжимается."

# dlc_cupid/ch/cupid/sam_ryan/aftermath.rpy:122
translate russian cupid_sam_ryan_aftermath_8433a89f:
    samantha.say "Хорошо."

# dlc_cupid/ch/cupid/sam_ryan/aftermath.rpy:123
translate russian cupid_sam_ryan_aftermath_a80a9b52:
    samantha.say "Я всё ещё на тебя злюсь. Спроси ещё раз, когда перестану."

# dlc_cupid/ch/cupid/sam_ryan/aftermath.rpy:127
translate russian cupid_sam_ryan_aftermath_1e691446:
    samantha.say "Хорошо. Купидон из тебя был ужасный."

# dlc_cupid/ch/cupid/sam_ryan/aftermath.rpy:128
translate russian cupid_sam_ryan_aftermath_30bcff6c:
    samantha.say "Повесь крылышки на гвоздь. Они тебе никогда не шли."

# dlc_cupid/ch/cupid/sam_ryan/aftermath.rpy:132
translate russian cupid_sam_ryan_aftermath_554aa38c:
    mike.say "Сэм, Райан всё ещё мой друг."

# dlc_cupid/ch/cupid/sam_ryan/aftermath.rpy:133
translate russian cupid_sam_ryan_aftermath_1413ccdb:
    mike.say "Я не могу просто вычеркнуть его."

# dlc_cupid/ch/cupid/sam_ryan/aftermath.rpy:135
translate russian cupid_sam_ryan_aftermath_34b40d47:
    "Она не торопится с ответом."

# dlc_cupid/ch/cupid/sam_ryan/aftermath.rpy:137
translate russian cupid_sam_ryan_aftermath_83d772cf:
    samantha.say "Тогда тебе лучше научиться хорошо врать одному из нас."

# dlc_cupid/ch/cupid/sam_ryan/aftermath.rpy:138
translate russian cupid_sam_ryan_aftermath_c1b0a062:
    samantha.say "Дай знать, кому именно, когда решишь."

# dlc_cupid/ch/cupid/sam_ryan/aftermath.rpy:142
translate russian cupid_sam_ryan_aftermath_20506424:
    "Она уходит, не попрощавшись."

# dlc_cupid/ch/cupid/sam_ryan/aftermath.rpy:144
translate russian cupid_sam_ryan_aftermath_fc684873:
    "Прежде чем уйти, она находит мою руку и один раз сжимает."

# dlc_cupid/ch/cupid/sam_ryan/aftermath.rpy:145
translate russian cupid_sam_ryan_aftermath_bd698b82:
    "Потом быстро отпускает и оглядывается — не видел ли кто."

# dlc_cupid/ch/cupid/sam_ryan/event.rpy:937
translate russian cupid_sam_ryan_ending_8d511db9:
    "В последний раз я видел Сэм несколько минут назад: она лежала на спине на кушетке, и с её губ срывалось моё имя."

# dlc_cupid/ch/cupid/sam_ryan/event.rpy:938
translate russian cupid_sam_ryan_ending_8fd2499c:
    "А теперь я стою рядом с её мужем в роли его шафера."

# dlc_cupid/ch/cupid/sam_ryan/event.rpy:962
translate russian cupid_sam_ryan_ending_30690e4b:
    "Всю дорогу по проходу Сэм не сводит глаз с Райана."

# dlc_cupid/ch/cupid/sam_ryan/event.rpy:963
translate russian cupid_sam_ryan_ending_c3c3181d:
    "Под фатой её щёки всё ещё розовые."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:23
translate russian cupid_sam_ryan_wedding_prelude_6a554c48:
    "Часовня заполнена едва на треть, а Райан не отрывается от телефона с той самой минуты, как вошёл."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:25
translate russian cupid_sam_ryan_wedding_prelude_05cb6c25:
    ryan.say "[hero.name]. Выручи, а?"

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:26
translate russian cupid_sam_ryan_wedding_prelude_f6a1c98a:
    ryan.say "Скажи Сэм, что мы начинаем через пятнадцать минут. Мне надо ответить."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:28
translate russian cupid_sam_ryan_wedding_prelude_9b4c0fd9:
    "Он уже идёт к боковой двери, прижав телефон к уху и понизив голос."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:31
translate russian cupid_sam_ryan_wedding_prelude_eb7eaa04:
    "Комната невесты — в конце коридора за часовней."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:32
translate russian cupid_sam_ryan_wedding_prelude_b187c2cc:
    "Дверь чуть приоткрыта, и я слышу, как Сэм за ней разговаривает сама с собой."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:37
translate russian cupid_sam_ryan_wedding_prelude_511dce53:
    "Я стучу по косяку, не заглядывая внутрь."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:38
translate russian cupid_sam_ryan_wedding_prelude_feaa6340:
    samantha.say "Пять минут! Я тут вообще-то невеста!"

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:39
translate russian cupid_sam_ryan_wedding_prelude_454338bd:
    "Я возвращаюсь к алтарю ждать, пока Райан закончит разговор."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:51
translate russian cupid_sam_ryan_wedding_condom_a266478a:
    "Я достаю из бумажника презерватив. Она смеётся надо мной — надо же, притащить такое в церковь, — а потом сама раскатывает его по моему члену."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:54
translate russian cupid_sam_ryan_wedding_condom_280435cd:
    samantha.say "Стой. Стой, стой."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:55
translate russian cupid_sam_ryan_wedding_condom_74432076:
    samantha.say "Нам нужен презерватив, [lssb_samantha.hero_name()]. Сегодня — особенно."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:57
translate russian cupid_sam_ryan_wedding_condom_70edaff9:
    samantha.say "Без паники. У меня в клатче есть."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:58
translate russian cupid_sam_ryan_wedding_condom_38fe4304:
    samantha.say "Только не спрашивай, зачем женщина берёт презерватив на собственное обновление клятв."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:59
translate russian cupid_sam_ryan_wedding_condom_1a5736ac:
    "Она раскатывает его по мне уверенными руками — так же, как выводит глазурь."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:62
translate russian cupid_sam_ryan_wedding_condom_e15f17de:
    "Когда я не тянусь за презервативом, она отталкивает меня за плечи и садится."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:63
translate russian cupid_sam_ryan_wedding_condom_a600fcac:
    samantha.say "Нет. Не так. Не сегодня."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:64
translate russian cupid_sam_ryan_wedding_condom_f6494bf6:
    samantha.say "Иди встань впереди, [lssb_samantha.hero_name()]. Давай, иди."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:71
translate russian cupid_sam_ryan_wedding_fuck_703e94ac:
    "Я приоткрываю дверь чуть шире."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:75
translate russian cupid_sam_ryan_wedding_fuck_cb26b836:
    "Сэм стоит у самого порога в платье и держит фату так, будто не знает, какой стороной её надевать."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:77
translate russian cupid_sam_ryan_wedding_fuck_c2562bc8:
    samantha.say "[lssb_samantha.hero_name()]! Тебе сюда нельзя."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:79
translate russian cupid_sam_ryan_wedding_fuck_fcf16d30:
    samantha.say "Хотя... можно. Ты же не жених. Про шаферов, кажется, никаких правил нет."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:81
translate russian cupid_sam_ryan_wedding_fuck_07f1a99f:
    mike.say "Райан говорит, через пятнадцать минут."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:83
translate russian cupid_sam_ryan_wedding_fuck_d24e62fe:
    "Она бросает взгляд мимо меня, вдоль коридора, в сторону боковой двери."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:85
translate russian cupid_sam_ryan_wedding_fuck_c563090d:
    samantha.say "Он разговаривает по телефону, да?"

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:87
translate russian cupid_sam_ryan_wedding_fuck_72de69f5:
    "Я не отвечаю, а она больше не спрашивает."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:89
translate russian cupid_sam_ryan_wedding_fuck_f579b0e3:
    samantha.say "Посмотри на меня. Я похожа на трёхъярусный торт, который забыли доделать."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:91
translate russian cupid_sam_ryan_wedding_fuck_9310eacc:
    mike.say "Ты прекрасно выглядишь, Сэм."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:93
translate russian cupid_sam_ryan_wedding_fuck_899b156e:
    samantha.say "Это ведь была твоя идея, знаешь ли."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:94
translate russian cupid_sam_ryan_wedding_fuck_423b2289:
    samantha.say "Барбекю. Девчонки, которые твердили ему, как ему повезло. Это ты снова засунул меня в это платье."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:95
translate russian cupid_sam_ryan_wedding_fuck_b975516d:
    samantha.say "Когда я в первый раз надела такое, я пообещала ему вечность. И говорила это от всего сердца."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:97
translate russian cupid_sam_ryan_wedding_fuck_7585cd51:
    "Пока она это говорит, она всё крутит и крутит кольцо на пальце."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:99
translate russian cupid_sam_ryan_wedding_fuck_c628ab4c:
    mike.say "А ты сама хочешь в нём быть?"

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:100
translate russian cupid_sam_ryan_wedding_fuck_adc45dc8:
    "Она долго не отвечает. Где-то у меня за спиной, в часовне, кто-то слишком громко смеётся."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:102
translate russian cupid_sam_ryan_wedding_fuck_76be7499:
    samantha.say "Я хотела, чтобы ты спросил меня об этом пять лет назад. Когда я ещё жила в твоём доме."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:104
translate russian cupid_sam_ryan_wedding_fuck_e2da51fc:
    "А потом она затаскивает меня внутрь за галстук и целует — так сильно, что фата падает на пол."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:106
translate russian cupid_sam_ryan_wedding_fuck_54470ab4:
    samantha.say "Молния сзади. И у нас пятнадцать минут."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:107
translate russian cupid_sam_ryan_wedding_fuck_ec266b9e:
    samantha.say "Он в шести метрах отсюда. Если он закончит разговор и пойдёт меня искать..."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:109
translate russian cupid_sam_ryan_wedding_fuck_06b2878a:
    "Всё это время её пальцы не перестают расстёгивать мои пуговицы."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:111
translate russian cupid_sam_ryan_wedding_fuck_5cdd1029:
    "Платье соскальзывает к её щиколоткам. Она перешагивает через него, отпихивает ногой к стулу — и вот уже расстёгивает мои пуговицы."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:112
translate russian cupid_sam_ryan_wedding_fuck_9314cbed:
    "Под окном стоит белая кушетка — для невест, которым надо прилечь. Она утягивает меня на неё."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:113
translate russian cupid_sam_ryan_wedding_fuck_a1440e55:
    "Её кольцо звякает о пряжку моего ремня. Секунду она смотрит на него, а потом поворачивает камнем к ладони."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:117
translate russian cupid_sam_ryan_wedding_fuck_3f48b634:
    "Через минуту я уже снова в коридоре, поправляю галстук."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:118
translate russian cupid_sam_ryan_wedding_fuck_22849d47:
    "Ни один из нас больше не скажет об этом ни слова."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:124
translate russian cupid_sam_ryan_wedding_fuck_29262f31:
    "Она откидывается на белый атлас, голая, волосы разметались вокруг головы."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:125
translate russian cupid_sam_ryan_wedding_fuck_f8240e45:
    "Кольцо на её пальце сверкает, когда она тянется ко мне."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:126
translate russian cupid_sam_ryan_wedding_fuck_8ccd9fbd:
    samantha.say "Медленно. Я хочу почувствовать всё."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:127
translate russian cupid_sam_ryan_wedding_fuck_b8518882:
    samantha.say "Я так ничего не хотела уже много лет. Это ужасно, да?"

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:129
translate russian cupid_sam_ryan_wedding_fuck_0ec7619e:
    "Я вхожу в неё медленно, сантиметр за сантиметром, и вижу, как это пронизывает её всю."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:130
translate russian cupid_sam_ryan_wedding_fuck_9ee3e2d7:
    "Её глаза закрываются. А когда снова открываются, взгляд у неё тяжёлый, сонный и прикован ко мне."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:131
translate russian cupid_sam_ryan_wedding_fuck_e4002f92:
    "Она обхватывает свою грудь и сжимает, и её киска при этом стискивает меня."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:133
translate russian cupid_sam_ryan_wedding_fuck_38b938d6:
    samantha.say "Он сейчас там шепчется с ней по телефону. Я точно знаю."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:134
translate russian cupid_sam_ryan_wedding_fuck_7fca6c7d:
    samantha.say "Так что пусть хоть раз он меня подождёт. Сильнее."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:136
translate russian cupid_sam_ryan_wedding_fuck_41e9abc8:
    samantha.say "Через десять минут я должна встать там и снова пообещать ему всё это..."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:137
translate russian cupid_sam_ryan_wedding_fuck_3a6339c6:
    "На этих словах её голос срывается. А бёдра ничуть не замедляются."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:139
translate russian cupid_sam_ryan_wedding_fuck_56be4433:
    "Пирсинг в её сосках ловит свет из окна каждый раз, когда она выгибается."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:141
translate russian cupid_sam_ryan_wedding_fuck_011f52c3:
    "Теперь она задыхается, её бёдра поднимаются навстречу каждому толчку."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:142
translate russian cupid_sam_ryan_wedding_fuck_244ef25f:
    "За стеной начинает играть орган — несколько неуверенных тактов, — потом затихает."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:143
translate russian cupid_sam_ryan_wedding_fuck_208a34b0:
    samantha.say "Это... это просто разминка..."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:144
translate russian cupid_sam_ryan_wedding_fuck_f31e01dd:
    samantha.say "Не останавливайся. Пусть подождёт."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:145
translate russian cupid_sam_ryan_wedding_fuck_752e54cc:
    "Капля пота стекает у неё между грудей. Атлас под ней становится влажным."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:146
translate russian cupid_sam_ryan_wedding_fuck_1f99a053:
    "Я больше не могу сдерживаться."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:149
translate russian cupid_sam_ryan_wedding_fuck_3bc4ee0f:
    "Благодаря презервативу я могу остаться там, где есть, — глубоко в ней, пока кончаю."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:150
translate russian cupid_sam_ryan_wedding_fuck_937b4999:
    "Она чувствует каждую пульсацию и цепляется за меня, пытаясь притянуть глубже."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:151
translate russian cupid_sam_ryan_wedding_fuck_3d39a976:
    "А потом кончает и она, закусив основание ладони, чтобы не шуметь."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:155
translate russian cupid_sam_ryan_wedding_fuck_f73410e4:
    "Я выхожу из неё прямо перед тем, как кончить, и всё остаётся в презервативе."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:156
translate russian cupid_sam_ryan_wedding_fuck_03f42ce5:
    "Сэм жалобно всхлипывает от пустоты и доводит себя пальцами, всё это время глядя на меня."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:161
translate russian cupid_sam_ryan_wedding_fuck_9236e966:
    "Я выхожу из неё прямо перед тем, как кончить, и она протестующе стонет, её рука тут же ныряет между ног."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:163
translate russian cupid_sam_ryan_wedding_fuck_5b4f051b:
    "Моя сперма брызгает на неё."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:165
translate russian cupid_sam_ryan_wedding_fuck_72a3c6ad:
    "На живот и грудь, немного на подбородок. Она взвизгивает, смеётся и продолжает тереть клитор, пока не кончает."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:166
translate russian cupid_sam_ryan_wedding_fuck_892ff210:
    samantha.say "Хорошо, что я сняла платье. Ему нужна совсем не такая глазурь."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:170
translate russian cupid_sam_ryan_wedding_fuck_99c92764:
    samantha.say "В меня. Всё нормально, я пью таблетки. В меня."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:172
translate russian cupid_sam_ryan_wedding_fuck_083b396b:
    "Я теряю голову."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:176
translate russian cupid_sam_ryan_wedding_fuck_49502f9f:
    samantha.say "О, чёрт... о, [lssb_samantha.hero_name()]..."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:177
translate russian cupid_sam_ryan_wedding_fuck_96f1ea3c:
    samantha.say "Я буду произносить клятвы, а у меня ещё будут дрожать коленки."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:178
translate russian cupid_sam_ryan_wedding_fuck_05612b18:
    "Она кончает, уткнувшись лицом в атлас, чтобы заглушить крик."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:181
translate russian cupid_sam_ryan_wedding_fuck_dc20eb2d:
    samantha.say "В меня. Поздновато уже об этом волноваться, нет?"

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:183
translate russian cupid_sam_ryan_wedding_fuck_083b396b_1:
    "Я теряю голову."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:187
translate russian cupid_sam_ryan_wedding_fuck_bfc9e78e:
    "Она обвивает меня ногами и не отпускает, пока тоже не кончает."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:190
translate russian cupid_sam_ryan_wedding_fuck_2823420d:
    "Она чувствует, как я напрягаюсь, и скрещивает лодыжки у меня за спиной."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:191
translate russian cupid_sam_ryan_wedding_fuck_8099b852:
    samantha.say "Не смей выходить."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:193
translate russian cupid_sam_ryan_wedding_fuck_083b396b_2:
    "Я теряю голову."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:198
translate russian cupid_sam_ryan_wedding_fuck_47e763d3:
    "Она кончает, уткнувшись лицом в атлас, чтобы заглушить крик, и всё ещё не выпускает меня из себя."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:199
translate russian cupid_sam_ryan_wedding_fuck_8a4dced2:
    samantha.say "Я буду стоять рядом с ним, а внутри у меня будешь ты."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:200
translate russian cupid_sam_ryan_wedding_fuck_08c28e1a:
    "Не похоже, чтобы она об этом жалела. Похоже, она поражена."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:203
translate russian cupid_sam_ryan_wedding_fuck_df4dc410:
    "Она чувствует, как я напрягаюсь, и пытается выскользнуть из-под меня, но деваться некуда."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:204
translate russian cupid_sam_ryan_wedding_fuck_c367b00f:
    samantha.say "[lssb_samantha.hero_name()], не надо... не в меня..."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:206
translate russian cupid_sam_ryan_wedding_fuck_170ffbbb:
    "Но я всё равно теряю голову."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:212
translate russian cupid_sam_ryan_wedding_fuck_8dfe5972:
    "Она даёт мне пощёчину, и её кольцо царапает мне щёку."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:213
translate russian cupid_sam_ryan_wedding_fuck_59eba07d:
    samantha.say "Ты кончил в меня. В день, когда я обновляю клятвы."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:214
translate russian cupid_sam_ryan_wedding_fuck_1b0a645b:
    samantha.say "Слезь. Слезь с меня, сволочь последняя."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:219
translate russian cupid_sam_ryan_wedding_fuck_61d92270:
    "Она выпихивает меня в коридор в наполовину застёгнутой рубашке и так хлопает дверью, что та дребезжит в раме."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:227
translate russian cupid_sam_ryan_wedding_fuck_c408732c:
    "Пока я нахожу второй ботинок, она уже снова в платье и подталкивает меня к коридору."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:229
translate russian cupid_sam_ryan_wedding_fuck_602ea1b8:
    samantha.say "Мне должно быть ужасно стыдно. И будет — потом. А сейчас я чувствую себя на двадцать пять."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:230
translate russian cupid_sam_ryan_wedding_fuck_2d3a9799:
    samantha.say "Выйди через боковую дверь. Если Райан спросит — я плакала из-за мамы."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:231
translate russian cupid_sam_ryan_wedding_fuck_f26270d1:
    samantha.say "Что, если честно, правда. Раньше."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:238
translate russian cupid_sam_ryan_wedding_altar_b5992d5e:
    "Как обычно, минута-другая тишины, прерываемой смешками."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:239
translate russian cupid_sam_ryan_wedding_altar_e7a3dbf1:
    "Из-за плеча Райана Сэм смотрит прямо на меня — всего секунду."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:242
translate russian cupid_sam_ryan_wedding_altar_d6de1768:
    mike.say "Сэм."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:243
translate russian cupid_sam_ryan_wedding_altar_660bf868:
    "Райан резко оборачивается. Как и все остальные."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:244
translate russian cupid_sam_ryan_wedding_altar_2249735c:
    mike.say "Ты не обязана."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:248
translate russian cupid_sam_ryan_wedding_altar_3f5e9f86:
    "Сэм смотрит на меня, кажется, целую минуту."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:249
translate russian cupid_sam_ryan_wedding_altar_93a582ac:
    "Потом поджимает губы и снова поворачивается к священнику."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:250
translate russian cupid_sam_ryan_wedding_altar_897cc638:
    "Райан отшучивается на публику — что-то про шаферов и нервы."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:251
translate russian cupid_sam_ryan_wedding_altar_328cf97c:
    "Я стою как идиот, пока священник не откашливается."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:254
translate russian cupid_sam_ryan_wedding_altar_040a4918:
    "Я молчу и разглядываю цветы."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:255
translate russian cupid_sam_ryan_wedding_altar_5f6921d6:
    "На ключице у Сэм след, который вырез платья прикрывает не до конца. Это я его оставил."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:264
translate russian cupid_sam_ryan_wedding_calledoff_219e6a7c:
    "Сэм отпускает руки Райана."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:266
translate russian cupid_sam_ryan_wedding_calledoff_b7bb0846:
    samantha.say "Он прав."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:267
translate russian cupid_sam_ryan_wedding_calledoff_304d9944:
    samantha.say "Я уже говорила тебе «да» однажды, Райан, и говорила всерьёз — а посмотри на нас."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:270
translate russian cupid_sam_ryan_wedding_calledoff_ab20b353:
    ryan.say "Сэм. Детка. Люди снимают."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:273
translate russian cupid_sam_ryan_wedding_calledoff_257441f0:
    samantha.say "Вот и хорошо. Значит, останется запись."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:276
translate russian cupid_sam_ryan_wedding_calledoff_602aad52:
    "Райан резко разворачивается ко мне."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:278
translate russian cupid_sam_ryan_wedding_calledoff_7cb3c5b9:
    ryan.say "Ты. Это ведь ты, да? Ты и твои барбекю."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:279
translate russian cupid_sam_ryan_wedding_calledoff_33d1fbe1:
    ryan.say "Меня бросают на моём собственном обновлении клятв, а плохой почему-то я?"

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:282
translate russian cupid_sam_ryan_wedding_calledoff_b42ed6ca:
    samantha.say "Иди закончи свой телефонный разговор, Райан."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:285
translate russian cupid_sam_ryan_wedding_calledoff_fa2733b2:
    "Впервые в жизни Райану нечего ответить."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:288
translate russian cupid_sam_ryan_wedding_calledoff_b87148b9:
    "Он уходит через боковую дверь. Несколько телефонов поворачиваются ему вслед."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:298
translate russian cupid_sam_ryan_wedding_calledoff_968ef714:
    "Сэм садится на ступени церкви прямо в платье, будто ноги её больше не держат."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:299
translate russian cupid_sam_ryan_wedding_calledoff_55ecd4b4:
    mike.say "[samantha.callname]..."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:301
translate russian cupid_sam_ryan_wedding_calledoff_eb1500a0:
    samantha.say "Я только что сбежала с собственного обновления клятв, [lssb_samantha.hero_name()]."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:302
translate russian cupid_sam_ryan_wedding_calledoff_185c5b9e:
    samantha.say "Скажи, что я не сошла с ума."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:307
translate russian cupid_sam_ryan_wedding_calledoff_f62ece96:
    "Телефон мёртвым грузом лежит в кармане пиджака. Та фотография всё ещё в нём."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:310
translate russian cupid_sam_ryan_wedding_calledoff_4dfe3126:
    "Я сажусь рядом с ней, открываю фото и протягиваю ей."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:312
translate russian cupid_sam_ryan_wedding_calledoff_702ebc20:
    mike.say "Я видел Райана в баре. С другой девушкой."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:314
translate russian cupid_sam_ryan_wedding_calledoff_aca8f55a:
    mike.say "Я видел Райана на вашей свадьбе. С другой девушкой."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:316
translate russian cupid_sam_ryan_wedding_calledoff_8eefbe0b:
    "Она долго смотрит на экран, не прикасаясь к телефону."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:318
translate russian cupid_sam_ryan_wedding_calledoff_0be61b9b:
    samantha.say "И давно ты знаешь?"

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:320
translate russian cupid_sam_ryan_wedding_calledoff_2fc7a1b6:
    mike.say "Давно."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:322
translate russian cupid_sam_ryan_wedding_calledoff_72267d1a:
    samantha.say "И всё равно устроил нам барбекю."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:324
translate russian cupid_sam_ryan_wedding_calledoff_c1ec8a9a:
    mike.say "Прости, Сэм. Я хотел, чтобы ты была счастлива, и думал, что тебе нужен именно он."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:326
translate russian cupid_sam_ryan_wedding_calledoff_59b3f910:
    "Она не кричит. Она кладёт голову мне на плечо и плачет в мой лучший костюм, пока фотограф не сдаётся и не уходит домой."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:329
translate russian cupid_sam_ryan_wedding_calledoff_112097e2:
    "Не сегодня. С неё на сегодня хватит."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:331
translate russian cupid_sam_ryan_wedding_calledoff_54fd4c56:
    mike.say "Ты не сошла с ума."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:333
translate russian cupid_sam_ryan_wedding_calledoff_7f16b00d:
    samantha.say "Врёшь. Но спасибо."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:336
translate russian cupid_sam_ryan_wedding_calledoff_21bb1b6b:
    "Позади нас с грохотом распахивается боковая дверь. Райан — галстук ослаблен, телефон всё ещё в руке."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:338
translate russian cupid_sam_ryan_wedding_calledoff_28da2fdc:
    ryan.say "Невероятно. Знаете, кто бы никогда такое не выкинул?"

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:339
translate russian cupid_sam_ryan_wedding_calledoff_6e0ff7d1:
    ryan.say "Натали. Натали меня понимает. Натали хотя бы ценит то, что имеет!"

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:342
translate russian cupid_sam_ryan_wedding_calledoff_1275997e:
    samantha.say "Натали?"

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:345
translate russian cupid_sam_ryan_wedding_calledoff_aec63e6c:
    "Слово уже вылетело, а рот у Райана так и остаётся открытым — будто он пытается поймать его и запихнуть обратно."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:347
translate russian cupid_sam_ryan_wedding_calledoff_5f2dbb27:
    samantha.say "Моя Натали? Моя подружка невесты?"

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:350
translate russian cupid_sam_ryan_wedding_calledoff_deb379e5:
    ryan.say "Это... это не..."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:353
translate russian cupid_sam_ryan_wedding_calledoff_40ac6375:
    "Он не договаривает. Садится в машину и уезжает — белые ленты так и остаются на капоте."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:355
translate russian cupid_sam_ryan_wedding_calledoff_1f356f10:
    "Сэм держится, пока машина не скрывается за углом. А потом кладёт голову мне на плечо и плачет в мой лучший костюм."

# dlc_cupid/ch/cupid/sam_ryan/wedding.rpy:370
translate russian cupid_sam_ryan_wedding_calledoff_16254c74:
    samantha.say "Позвони мне завтра, ладно? Не сегодня. Завтра."

# dlc_cupid/ch/cupid/sasha_scottie/aftermath.rpy:55
translate russian cupid_sasha_scottie_aftermath_db47aee4:
    "Саша развалилась на диване, закинув ноги мне на колени, будто им там всегда и было место."

# dlc_cupid/ch/cupid/sasha_scottie/aftermath.rpy:56
translate russian cupid_sasha_scottie_aftermath_f91cc334:
    "Ни один из нас так и не назвал то, что случилось. Она не просила, а я не пытался."

# dlc_cupid/ch/cupid/sasha_scottie/aftermath.rpy:59
translate russian cupid_sasha_scottie_aftermath_ae3d380f:
    sasha.say "Если это к Бри, я не встаю."

# dlc_cupid/ch/cupid/sasha_scottie/aftermath.rpy:62
translate russian cupid_sasha_scottie_aftermath_10a59ddb:
