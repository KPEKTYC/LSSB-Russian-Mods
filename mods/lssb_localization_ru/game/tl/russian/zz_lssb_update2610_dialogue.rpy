# dlc_cupid/ch/cupid/palla_shawn/aftermath.rpy:107
translate russian cupid_palla_shawn_aftermath_269e37a2:
    shawn.say "Ты же был моим хилом, чувак. Хилы не уходят с лутом."

# dlc_cupid/ch/cupid/palla_shawn/aftermath.rpy:110
translate russian cupid_palla_shawn_aftermath_1fa2cb59:
