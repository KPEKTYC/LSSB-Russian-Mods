# ch/aletta/events.rpy:1032
translate russian aletta_stress_2b_06b24095:
    aletta.say "Доброе утро, [lssb_shiori.hero_name()]."

# ch/aletta/events.rpy:1038
translate russian aletta_stress_2b_3d1eb46e:
    "Она торопливо проходит мимо меня, чтобы закрыть дверь кабинета."

# ch/aletta/events.rpy:1820
translate russian aletta_kink_05_609a355e:
