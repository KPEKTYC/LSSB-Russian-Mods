translate russian cupid_kleio_morgan_wedding_ask_dd603fe7:
    "Она сбегает по ступенькам и выходит за дверь раньше, чем священник успевает закрыть книгу."

# dlc_cupid/ch/cupid/kleio_morgan/wedding.rpy:946
translate russian cupid_kleio_morgan_wedding_ask_a00f248a:
    morgan.say "Так. Эм. Я вообще-то не могу в этом ходить."

# dlc_cupid/ch/cupid/kleio_morgan/wedding.rpy:948
translate russian cupid_kleio_morgan_wedding_ask_d925ee50:
    "Я подхватываю её с камня прямо с хвостом и выношу мимо всей родни Клео."

# dlc_cupid/ch/cupid/kleio_morgan/wedding.rpy:953
translate russian cupid_kleio_morgan_wedding_ask_b6e66c7a:
    "Снаружи я сажаю её на скамейку, и она сидит, высунув плавники на автобусную полосу."

# dlc_cupid/ch/cupid/kleio_morgan/wedding.rpy:955
translate russian cupid_kleio_morgan_wedding_ask_2c879a35:
    morgan.say "Я только что бросила Клео. На нашей свадьбе. В рыбьем костюме."

# dlc_cupid/ch/cupid/kleio_morgan/wedding.rpy:957
translate russian cupid_kleio_morgan_wedding_ask_ad420103:
    mike.say "Технически это костюм русалки."

# dlc_cupid/ch/cupid/kleio_morgan/wedding.rpy:959
translate russian cupid_kleio_morgan_wedding_ask_80fbc732:
    morgan.say "Помолчи, [lssb_morgan.hero_name()]."

# dlc_cupid/ch/cupid/kleio_morgan/wedding.rpy:961
translate russian cupid_kleio_morgan_wedding_ask_3cf55a57:
    "Но она прижимается ко мне боком и так и остаётся."

# dlc_cupid/ch/cupid/kleio_morgan/wedding.rpy:963
translate russian cupid_kleio_morgan_wedding_ask_d833fb8f:
    morgan.say "Своди меня куда-нибудь. На нормальное свидание, не сегодня. Когда ноги снова заработают."

# dlc_cupid/ch/cupid/kleio_morgan/wedding.rpy:971
translate russian cupid_kleio_morgan_wedding_ask_6c6ebbf3:
    "Клео и Морган переглядываются, потом обе смотрят на меня, и Морган приходится сдерживать улыбку."

# dlc_cupid/ch/cupid/kleio_morgan/wedding.rpy:972
translate russian cupid_kleio_morgan_wedding_ask_29ec9fe3:
    kleio.say "Сядь, [lssb_kleio.hero_name()]. С тобой разберёмся позже."

# dlc_cupid/ch/cupid/kleio_morgan/wedding.rpy:975
translate russian cupid_kleio_morgan_wedding_ask_fcc3c793:
    morgan.say "Обещаем."

# dlc_cupid/ch/cupid/kleio_morgan/wedding.rpy:979
translate russian cupid_kleio_morgan_wedding_ask_b1fbc1d9:
    "Морган переводит взгляд на меня, потом опускает его на хвост."

# dlc_cupid/ch/cupid/kleio_morgan/wedding.rpy:981
translate russian cupid_kleio_morgan_wedding_ask_e6be7984:
    morgan.say "Сядь, [lssb_morgan.hero_name()]. Пожалуйста."

# dlc_cupid/ch/cupid/kleio_morgan/wedding.rpy:984
translate russian cupid_kleio_morgan_wedding_ask_b167be27:
    "Клео растерянно переводит взгляд с неё на меня, и Морган сжимает ей руку, пока та не посмотрит обратно."

# dlc_cupid/ch/cupid/kleio_morgan/wedding.rpy:987
translate russian cupid_kleio_morgan_wedding_ask_c676f2d6:
    "Клео резко смотрит на меня. На секунду мне кажется, что она сейчас это скажет."

# dlc_cupid/ch/cupid/kleio_morgan/wedding.rpy:989
translate russian cupid_kleio_morgan_wedding_ask_005ad304:
    kleio.say "Сядь, [lssb_kleio.hero_name()]. Ты устраиваешь сцену на моей свадьбе."

# dlc_cupid/ch/cupid/kleio_morgan/wedding.rpy:992
translate russian cupid_kleio_morgan_wedding_ask_ee5f3789:
    "Морган растерянно переводит взгляд с неё на меня, и Клео сжимает ей руку, пока та не посмотрит обратно."

# dlc_cupid/ch/cupid/kleio_morgan/wedding.rpy:993
translate russian cupid_kleio_morgan_wedding_ask_0f91d9c6:
    "Я сажусь. Лицо у меня горит."

# dlc_cupid/ch/cupid/kleio_morgan/wedding.rpy:1015
translate russian cupid_kleio_morgan_pixie_offer_9acc5021:
    kleio.say "Вот мы и взорвали собственную свадьбу."

# dlc_cupid/ch/cupid/kleio_morgan/wedding.rpy:1018
translate russian cupid_kleio_morgan_pixie_offer_15197b61:
    morgan.say "Взорвали. Я всё ещё хочу за тебя замуж, знаешь. Просто... не сегодня."

# dlc_cupid/ch/cupid/kleio_morgan/wedding.rpy:1021
translate russian cupid_kleio_morgan_pixie_offer_891a574f:
    kleio.say "Да. Я тоже."

# dlc_cupid/ch/cupid/kleio_morgan/wedding.rpy:1026
translate russian cupid_kleio_morgan_pixie_offer_d5bb7e89:
    "Не успеваю я выйти вслед за гостями, как Клео цепляет меня двумя пальцами за воротник и утаскивает обратно за занавес."

# dlc_cupid/ch/cupid/kleio_morgan/wedding.rpy:1028
translate russian cupid_kleio_morgan_pixie_offer_165c7507:
    kleio.say "Не так быстро, [lssb_kleio.hero_name()]."

# dlc_cupid/ch/cupid/kleio_morgan/wedding.rpy:1031
translate russian cupid_kleio_morgan_pixie_offer_3845750f:
    morgan.say "Мы об этом поговорили. До. И после."

# dlc_cupid/ch/cupid/kleio_morgan/wedding.rpy:1033
translate russian cupid_kleio_morgan_pixie_offer_d081953b:
    morgan.say "Мы с Клео — это главное. Это не изменится."

# dlc_cupid/ch/cupid/kleio_morgan/wedding.rpy:1036
translate russian cupid_kleio_morgan_pixie_offer_87c4516f:
    kleio.say "Но мы хотим, чтобы ты был рядом. Время от времени в нашей постели. Без колец, без клятв, и никто никого не называет мужем."

# dlc_cupid/ch/cupid/kleio_morgan/wedding.rpy:1038
translate russian cupid_kleio_morgan_pixie_offer_274e5934:
    kleio.say "Просто скажи «да» или «нет» и не устраивай из этого речь."

# dlc_cupid/ch/cupid/kleio_morgan/wedding.rpy:1041
translate russian cupid_kleio_morgan_pixie_offer_ccfb2391:
    mike.say "Да. Конечно да."

# dlc_cupid/ch/cupid/kleio_morgan/wedding.rpy:1044
translate russian cupid_kleio_morgan_pixie_offer_c0d078e2:
    "Морган вопит так, что где-то срабатывает автосигнализация. Клео только ухмыляется своим ботинкам, будто что-то выиграла."

# dlc_cupid/ch/cupid/kleio_morgan/wedding.rpy:1047
translate russian cupid_kleio_morgan_pixie_offer_3df3a936:
    mike.say "Сегодня было... слишком. Вам двоим нужно быть друг у друга без меня под боком."

# dlc_cupid/ch/cupid/kleio_morgan/wedding.rpy:1050
translate russian cupid_kleio_morgan_pixie_offer_925a16f8:
    "Они воспринимают это лучше, чем я ожидал. Клео пожимает плечами. Морган сжимает мне руку."

# dlc_cupid/ch/cupid/kleio_morgan/wedding.rpy:1052
translate russian cupid_kleio_morgan_pixie_offer_72882999:
    kleio.say "Сам виноват."

# dlc_cupid/ch/cupid/kleio_morgan/wedding.rpy:1055
translate russian cupid_kleio_morgan_pixie_offer_794e09d9:
    morgan.say "Ага. Сам виноват, [lssb_morgan.hero_name()]. Хотя и нам немного жаль."

# dlc_cupid/ch/cupid/lexi_danny/aftermath.rpy:53
translate russian cupid_lexi_danny_aftermath_a51c5784:
    "Лекси стоит, прислонившись к стене посреди переулка, и пускает дым в единственный работающий фонарь."

# dlc_cupid/ch/cupid/lexi_danny/aftermath.rpy:56
translate russian cupid_lexi_danny_aftermath_43ff10bc:
    "Лекси сидит на ступеньках своего трейлера и красит ногти на ногах в розовый, который видно из космоса."

# dlc_cupid/ch/cupid/lexi_danny/aftermath.rpy:58
translate russian cupid_lexi_danny_aftermath_79d9f40a:
    "Она видит, что я иду, и даже не пытается спрятать ухмылку."

# dlc_cupid/ch/cupid/lexi_danny/aftermath.rpy:60
translate russian cupid_lexi_danny_aftermath_c7e396fd:
    lexi.say "Так-так."

# dlc_cupid/ch/cupid/lexi_danny/aftermath.rpy:61
translate russian cupid_lexi_danny_aftermath_eea0c389:
    lexi.say "Кто-то вернулся за добавкой."

# dlc_cupid/ch/cupid/lexi_danny/aftermath.rpy:63
translate russian cupid_lexi_danny_aftermath_e6487c5e:
    lexi.say "Расслабься, я с тебя денег не возьму. Прошлый раз был за счёт заведения."

# dlc_cupid/ch/cupid/lexi_danny/aftermath.rpy:65
translate russian cupid_lexi_danny_aftermath_07aaf66f:
    mike.say "Я тоже рад тебя видеть, Лекси."

# dlc_cupid/ch/cupid/lexi_danny/aftermath.rpy:66
translate russian cupid_lexi_danny_aftermath_37bc5529:
    "Я ещё соображаю, что бы сказать, когда слышу за спиной шаги ботинок по гравию."

# dlc_cupid/ch/cupid/lexi_danny/aftermath.rpy:69
translate russian cupid_lexi_danny_aftermath_46ff245c:
    danny.say "Ну надо же, мой деловой партнёр."

# dlc_cupid/ch/cupid/lexi_danny/aftermath.rpy:70
translate russian cupid_lexi_danny_aftermath_fe7c7274:
    danny.say "Пришёл глянуть, как там мастерская?"

# dlc_cupid/ch/cupid/lexi_danny/aftermath.rpy:73
translate russian cupid_lexi_danny_aftermath_80daae21:
    danny.say "Привет, [hero.name]."

# dlc_cupid/ch/cupid/lexi_danny/aftermath.rpy:74
translate russian cupid_lexi_danny_aftermath_beb0b439:
    danny.say "Я думал, ты мне поможешь, мужик."

# dlc_cupid/ch/cupid/lexi_danny/aftermath.rpy:77
translate russian cupid_lexi_danny_aftermath_ff0c8943:
    "Он переводит взгляд с меня на Лекси."

# dlc_cupid/ch/cupid/lexi_danny/aftermath.rpy:78
translate russian cupid_lexi_danny_aftermath_c9766c32:
    "На её ухмылку, потом на моё лицо, которое, похоже, ничего толком не скрывает."

# dlc_cupid/ch/cupid/lexi_danny/aftermath.rpy:80
translate russian cupid_lexi_danny_aftermath_8a74fb6c:
    danny.say "Погоди."

# dlc_cupid/ch/cupid/lexi_danny/aftermath.rpy:81
translate russian cupid_lexi_danny_aftermath_b0ada1e2:
    danny.say "Она с утра мурлычет себе под нос. Лекси не мурлычет."

# dlc_cupid/ch/cupid/lexi_danny/aftermath.rpy:83
translate russian cupid_lexi_danny_aftermath_74104756:
    danny.say "Ты и она?"

# dlc_cupid/ch/cupid/lexi_danny/aftermath.rpy:86
translate russian cupid_lexi_danny_aftermath_a4294cab:
    lexi.say "А тебе-то что, Дэнни?"

# dlc_cupid/ch/cupid/lexi_danny/aftermath.rpy:88
translate russian cupid_lexi_danny_aftermath_c1ee1bfa:
    lexi.say "Если починил пару тачек, это не значит, что я твоя."

# dlc_cupid/ch/cupid/lexi_danny/aftermath.rpy:91
translate russian cupid_lexi_danny_aftermath_5e8dab09:
    lexi.say "Насколько я помню, я тебя вышвырнула."

# dlc_cupid/ch/cupid/lexi_danny/aftermath.rpy:94
translate russian cupid_lexi_danny_aftermath_f4481363:
    danny.say "Он должен был мне помогать!"

# dlc_cupid/ch/cupid/lexi_danny/aftermath.rpy:95
translate russian cupid_lexi_danny_aftermath_6a3de9b1:
    danny.say "Поставить меня на ноги, чтобы я мог..."

# dlc_cupid/ch/cupid/lexi_danny/aftermath.rpy:97
translate russian cupid_lexi_danny_aftermath_9df7ab09:
    "Он осекается, но слишком поздно."

# dlc_cupid/ch/cupid/lexi_danny/aftermath.rpy:99
translate russian cupid_lexi_danny_aftermath_1a744a85:
    "Ухмылка сползает с лица Лекси."

# dlc_cupid/ch/cupid/lexi_danny/aftermath.rpy:101
translate russian cupid_lexi_danny_aftermath_5e258a6a:
    lexi.say "Чтобы ты мог что?"

# dlc_cupid/ch/cupid/lexi_danny/aftermath.rpy:103
translate russian cupid_lexi_danny_aftermath_b29d6e68:
    lexi.say "Стоп. Гараж, эта дурацкая картонная табличка, все эти тачки, которые ты присылал..."

# dlc_cupid/ch/cupid/lexi_danny/aftermath.rpy:106
translate russian cupid_lexi_danny_aftermath_2b4668ee:
    lexi.say "Стоп. Всё это торчание у моего трейлера в роли миротворца."

# dlc_cupid/ch/cupid/lexi_danny/aftermath.rpy:108
translate russian cupid_lexi_danny_aftermath_6eca79ca:
    lexi.say "Ты пытался снова свести меня с ним?"

# dlc_cupid/ch/cupid/lexi_danny/aftermath.rpy:110
translate russian cupid_lexi_danny_aftermath_c12643d7:
    mike.say "Ну, в общих чертах, да."

# dlc_cupid/ch/cupid/lexi_danny/aftermath.rpy:112
translate russian cupid_lexi_danny_aftermath_d6cc6c2d:
    "Она смотрит на меня так, будто у меня выросла вторая голова."

# dlc_cupid/ch/cupid/lexi_danny/aftermath.rpy:114
translate russian cupid_lexi_danny_aftermath_84d57f82:
    "А потом покатывается со смеху, согнувшись пополам и упершись рукой в колено."

# dlc_cupid/ch/cupid/lexi_danny/aftermath.rpy:115
translate russian cupid_lexi_danny_aftermath_a2e82915:
    lexi.say "Ты играл в купидона. Для Дэнни!"

# dlc_cupid/ch/cupid/lexi_danny/aftermath.rpy:116
translate russian cupid_lexi_danny_aftermath_6466445d:
    lexi.say "А потом взял и трахнул меня сам. Ну ты и сводник."

# dlc_cupid/ch/cupid/lexi_danny/aftermath.rpy:119
translate russian cupid_lexi_danny_aftermath_e464fa44:
    danny.say "Ага. Очень смешно."

# dlc_cupid/ch/cupid/lexi_danny/aftermath.rpy:121
translate russian cupid_lexi_danny_aftermath_2d3bbf6f:
    danny.say "Мы с тобой не закончили, [hero.name]. Слышишь?"

# dlc_cupid/ch/cupid/lexi_danny/aftermath.rpy:122
translate russian cupid_lexi_danny_aftermath_abe11429:
    danny.say "Никто не делает из Дэнни дурака."

# dlc_cupid/ch/cupid/lexi_danny/aftermath.rpy:124
translate russian cupid_lexi_danny_aftermath_060911e5:
    "Он сплёвывает на землю, разворачивается на каблуках и уходит."

# dlc_cupid/ch/cupid/lexi_danny/aftermath.rpy:125
translate russian cupid_lexi_danny_aftermath_7598f48e:
    "Лекси смотрит ему вслед, и смех понемногу уходит из неё."

# dlc_cupid/ch/cupid/lexi_danny/aftermath.rpy:127
translate russian cupid_lexi_danny_aftermath_00f2da57:
    lexi.say "Так кем я тогда была?"

# dlc_cupid/ch/cupid/lexi_danny/aftermath.rpy:128
translate russian cupid_lexi_danny_aftermath_ac6471d4:
    lexi.say "Частью плана или маленьким бонусом сбоку?"

# dlc_cupid/ch/cupid/lexi_danny/aftermath.rpy:130
translate russian cupid_lexi_danny_aftermath_b677743c:
    "Она говорит это так, будто спрашивает про погоду."

# dlc_cupid/ch/cupid/lexi_danny/aftermath.rpy:131
translate russian cupid_lexi_danny_aftermath_3500592a:
    "Но, пока ждёт ответа, старается на меня не смотреть."

# dlc_cupid/ch/cupid/lexi_danny/aftermath.rpy:134
translate russian cupid_lexi_danny_aftermath_ca547d7a:
    mike.say "Ты никогда не была частью никакого плана, Лекси."

# dlc_cupid/ch/cupid/lexi_danny/aftermath.rpy:135
translate russian cupid_lexi_danny_aftermath_8dae7c63:
    mike.say "План вылетел в окно в ту же секунду, как ты меня поцеловала."

# dlc_cupid/ch/cupid/lexi_danny/aftermath.rpy:137
translate russian cupid_lexi_danny_aftermath_0a779e74:
    "Лекси открывает рот и снова закрывает."

# dlc_cupid/ch/cupid/lexi_danny/aftermath.rpy:139
translate russian cupid_lexi_danny_aftermath_90481d4c:
    lexi.say "Хм."

# dlc_cupid/ch/cupid/lexi_danny/aftermath.rpy:140
translate russian cupid_lexi_danny_aftermath_34a27782:
    lexi.say "Меня ещё никто не выбирал вместо плана."

# dlc_cupid/ch/cupid/lexi_danny/aftermath.rpy:143
translate russian cupid_lexi_danny_aftermath_c50ca2ea:
    lexi.say "Только не раздувай из этого. А то размякну и потеряю хватку."

# dlc_cupid/ch/cupid/lexi_danny/aftermath.rpy:146
translate russian cupid_lexi_danny_aftermath_350c7215:
    mike.say "Бонусом, наверное."

# dlc_cupid/ch/cupid/lexi_danny/aftermath.rpy:147
translate russian cupid_lexi_danny_aftermath_136aa0d4:
    mike.say "Но хорошим."

# dlc_cupid/ch/cupid/lexi_danny/aftermath.rpy:149
translate russian cupid_lexi_danny_aftermath_013257d5:
    "Лицо Лекси становится непроницаемым."

# dlc_cupid/ch/cupid/lexi_danny/aftermath.rpy:152
translate russian cupid_lexi_danny_aftermath_e280f2b2:
    lexi.say "Ага, так и думала."

# dlc_cupid/ch/cupid/lexi_danny/aftermath.rpy:153
translate russian cupid_lexi_danny_aftermath_5d77c3cc:
    lexi.say "В следующий раз, как захочешь бонус, приноси наличку."

# dlc_cupid/ch/cupid/lexi_danny/aftermath.rpy:155
translate russian cupid_lexi_danny_aftermath_1d043f84:
    lexi.say "И береги спину, ладно?"

# dlc_cupid/ch/cupid/lexi_danny/aftermath.rpy:156
translate russian cupid_lexi_danny_aftermath_c6b935d5:
    lexi.say "Дэнни не делится, и уж точно, чёрт возьми, не забывает."

# dlc_cupid/ch/cupid/lexi_danny/aftermath.rpy:159
translate russian cupid_lexi_danny_aftermath_3162a297:
    "Я оставляю её в покое."

# dlc_cupid/ch/cupid/lexi_danny/aftermath.rpy:160
translate russian cupid_lexi_danny_aftermath_027f5bfa:
    "Но весь остаток дня ловлю себя на том, что оглядываюсь на улицу за спиной."

# dlc_cupid/ch/cupid/lexi_danny/event.rpy:947
translate russian cupid_lexi_danny_event_02_969ae62d:
    "Я оборачиваюсь: за рулём патрульной машины сидит [camila.name]."

# dlc_cupid/ch/cupid/lexi_danny/event.rpy:948
translate russian cupid_lexi_danny_event_02_b4b7ff56:
    mike.say "Привет, [camila.callname]. Вот так встреча!"

# dlc_cupid/ch/cupid/lexi_danny/wedding.rpy:18
translate russian cupid_lexi_danny_wedding_invite_583d85dc:
    "Лекси всё утро собиралась у меня."

# dlc_cupid/ch/cupid/lexi_danny/wedding.rpy:19
translate russian cupid_lexi_danny_wedding_invite_85548c7f:
