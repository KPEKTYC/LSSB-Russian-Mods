# ch/ayesha/petplay.rpy:175
translate russian ayesha_sub_event_07_db22c932:
    mike.say "Раздевайся."

# ch/ayesha/petplay.rpy:176
translate russian ayesha_sub_event_07_8d2a57a0:
    "Я не устраиваю из этого речей. С ней, как я понемногу понимаю, коротко — лучше всего."

# ch/ayesha/petplay.rpy:177
translate russian ayesha_sub_event_07_effeaf96:
    "Одна чёткая команда — и нервозность просто вытекает из неё."

# ch/ayesha/petplay.rpy:179
translate russian ayesha_sub_event_07_bdf999ab:
    "Она одним рывком стягивает беговую толстовку через голову."

# ch/ayesha/petplay.rpy:180
translate russian ayesha_sub_event_07_ebf9c6da:
    "Следом шорты, потом кроссовки — сброшенные, не развязывая шнурков."

# ch/ayesha/petplay.rpy:182
translate russian ayesha_sub_event_07_d71ffb6f:
    "И вот передо мной просто Аиша, вся целиком, в свете лампы в моей гостиной."

# ch/ayesha/petplay.rpy:183
translate russian ayesha_sub_event_07_e1af1abd:
    "Плечи как у пловчихи. Пресс, о который можно натирать сыр."

# ch/ayesha/petplay.rpy:184
translate russian ayesha_sub_event_07_570ef4fb:
    "И её ошейник, плотно сидящий у основания шеи."

# ch/ayesha/petplay.rpy:185
translate russian ayesha_sub_event_07_0648a123:
    "Она замечает мой взгляд, и руки у неё дёргаются — ей хочется прикрыться."

# ch/ayesha/petplay.rpy:186
translate russian ayesha_sub_event_07_2e10bb7a:
    "Но они остаются опущенными. Она так решила."

# ch/ayesha/petplay.rpy:187
translate russian ayesha_sub_event_07_2187a015:
    "Я пристёгиваю поводок к кольцу. Щелчок громко разносится по тихой комнате."

# ch/ayesha/petplay.rpy:189
translate russian ayesha_sub_event_07_2906a739:
    ayesha.say "О."

# ch/ayesha/petplay.rpy:190
translate russian ayesha_sub_event_07_a6205658:
    ayesha.say "Это... тяжелее, чем я думала."

# ch/ayesha/petplay.rpy:192
translate russian ayesha_sub_event_07_68d717e0:
    mike.say "Поводок?"

# ch/ayesha/petplay.rpy:194
translate russian ayesha_sub_event_07_889cf0cf:
    ayesha.say "Нет. Щелчок."

# ch/ayesha/petplay.rpy:196
translate russian ayesha_sub_event_07_1e58da21:
    mike.say "Место, девочка."

# ch/ayesha/petplay.rpy:198
translate russian ayesha_sub_event_07_94c2e5ac:
    "Она медленно опускается — сначала на колени, потом на ладони, прямо на половицы."

# ch/ayesha/petplay.rpy:200
translate russian ayesha_sub_event_07_524375fd:
    "А потом поднимает на меня глаза, и самая сильная женщина из всех, кого я знаю, ждёт моего следующего слова."

# ch/ayesha/petplay.rpy:202
translate russian ayesha_sub_event_07_66b0955c:
    "Я едва заметно тяну за поводок и открываю дверь."

# ch/ayesha/petplay.rpy:204
translate russian ayesha_sub_event_07_e053b91f:
    "Улица мертва. Где-то вдалеке сдаётся автомобильная сигнализация."

# ch/ayesha/petplay.rpy:205
translate russian ayesha_sub_event_07_eccba1fc:
    "Аиша спускается по ступенькам, держась вплотную к моей ноге — так близко, что её плечо задевает моё колено."

# ch/ayesha/petplay.rpy:206
translate russian ayesha_sub_event_07_13fb455f:
    "Она напрягается от каждого шороха и каждого освещённого окна, пока мы не доходим до тёмного участка у парка."

# ch/ayesha/petplay.rpy:210
translate russian ayesha_sub_event_07_f2d8d90d:
    "И тогда в ней что-то отпускает."

# ch/ayesha/petplay.rpy:211
translate russian ayesha_sub_event_07_045c4112:
    "Её шаг выравнивается, голова поднимается, и она начинает по-настоящему смотреть на ночь — как смотрела бы собака."

# ch/ayesha/petplay.rpy:212
translate russian ayesha_sub_event_07_63f5ca9c:
    "Она обнюхивает ножку скамейки, потом основание фонаря — и ловит себя на этом."

# ch/ayesha/petplay.rpy:213
translate russian ayesha_sub_event_07_1b9c3597:
    "Мы проходим полкруга, прежде чем она издаёт низкий довольный звук — почти рычание, почти смех."

# ch/ayesha/petplay.rpy:215
translate russian ayesha_sub_event_07_cff7d7a0:
    "Вид сзади — просто нелепый."

# ch/ayesha/petplay.rpy:216
translate russian ayesha_sub_event_07_d25049ba:
    "Каждая мышца спины перекатывается у неё под кожей, а задница покачивается, как метроном."

# ch/ayesha/petplay.rpy:217
translate russian ayesha_sub_event_07_ccfc264d:
    "Я мог бы смотреть на это всю ночь."

# ch/ayesha/petplay.rpy:218
translate russian ayesha_sub_event_07_ecc3477c:
    "В дальнем конце дорожки она замирает как вкопанная и оглядывается на меня через плечо."

# ch/ayesha/petplay.rpy:219
translate russian ayesha_sub_event_07_2c93bf02:
    "Она не говорит ни слова, но всё её тело просит."

# ch/ayesha/petplay.rpy:222
translate russian ayesha_sub_event_07_3d3c9ee2:
    mike.say "Ну давай."

# ch/ayesha/petplay.rpy:223
translate russian ayesha_sub_event_07_6846816e:
    "Я отстёгиваю её."

# ch/ayesha/petplay.rpy:225
translate russian ayesha_sub_event_07_a6e5c3ca:
    "Аиша срывается с места."

# ch/ayesha/petplay.rpy:226
translate russian ayesha_sub_event_07_01a77961:
    "На четвереньках, через траву, быстрее, чем вообще имеет право двигаться кто-то в такой позе."

# ch/ayesha/petplay.rpy:227
translate russian ayesha_sub_event_07_e2ea56fc:
    "Она делает широкий круг, потом ещё один, а на третьем тормозит прямо передо мной."

# ch/ayesha/petplay.rpy:229
translate russian ayesha_sub_event_07_0018dbf5:
    "Тяжело дышит, улыбается, на коленях трава."

# ch/ayesha/petplay.rpy:230
translate russian ayesha_sub_event_07_34a2edeb:
    ayesha.say "Ты видел?"

# ch/ayesha/petplay.rpy:231
translate russian ayesha_sub_event_07_6850598d:
    ayesha.say "Я никогда так не бегала. Ни разу."

# ch/ayesha/petplay.rpy:232
translate russian ayesha_sub_event_07_6bc9c040:
    mike.say "Видел."

# ch/ayesha/petplay.rpy:234
translate russian ayesha_sub_event_07_ac95a93f:
    "Я снова пристёгиваю её, и она тычется головой мне в ладонь."

# ch/ayesha/petplay.rpy:237
translate russian ayesha_sub_event_07_89323576:
    mike.say "К ноге."

# ch/ayesha/petplay.rpy:238
translate russian ayesha_sub_event_07_4a555782:
    "Я держу её на коротком поводке и замедляю шаг, пока ей не приходится подстраиваться под меня шаг в шаг."

# ch/ayesha/petplay.rpy:239
translate russian ayesha_sub_event_07_4aeb96f7:
    "Секунд десять она ворчит."

# ch/ayesha/petplay.rpy:240
translate russian ayesha_sub_event_07_ff7e2f20:
    "Потом успокаивается — и так и остаётся спокойной, прижимаясь плечом к моей ноге до конца круга."

# ch/ayesha/petplay.rpy:241
translate russian ayesha_sub_event_07_1415af8a:
    "Когда я чешу её за ухом, она наваливается на мою ладонь всем весом, и я чуть не падаю."

# ch/ayesha/petplay.rpy:244
translate russian ayesha_sub_event_07_e28c4f6d:
    "Домой мы идём длинной дорогой, по неосвещённым улицам."

# ch/ayesha/petplay.rpy:245
translate russian ayesha_sub_event_07_c29c1920:
    "К моей двери она добирается приятно уставшей, руки у неё слегка дрожат."

# ch/ayesha/petplay.rpy:249
translate russian ayesha_sub_event_07_14c44276:
    "Внутри я отстёгиваю поводок, и она садится на пятки на моём ковре."

# ch/ayesha/petplay.rpy:251
translate russian ayesha_sub_event_07_b5b5fa78:
    ayesha.say "[lssb_ayesha.hero_name()]?"

# ch/ayesha/petplay.rpy:252
translate russian ayesha_sub_event_07_268e545d:
    ayesha.say "Сегодня ночью на меня никто не смотрел."

# ch/ayesha/petplay.rpy:253
translate russian ayesha_sub_event_07_611d44ae:
    ayesha.say "Никто, кроме тебя."

# ch/ayesha/petplay.rpy:255
translate russian ayesha_sub_event_07_a981c378:
    ayesha.say "А ты смотрел на меня так, будто я хорошая девочка."

# ch/ayesha/petplay.rpy:259
translate russian ayesha_sub_event_07_5ba8f07a:
    "Она натягивает беговую толстовку обратно, прежде чем я успеваю придумать достойный ответ."

# ch/ayesha/petplay.rpy:261
translate russian ayesha_sub_event_07_ba03ffdd:
    ayesha.say "В то же время на следующей неделе, [lssb_ayesha.hero_name()]?"

# ch/ayesha/petplay.rpy:263
translate russian ayesha_sub_event_07_4ec830c2:
    "Она дразнится. В основном."

# ch/ayesha/petplay.rpy:274
translate russian ayesha_sub_event_07b_4b88f4cc:
    "Я спешу открыть входную дверь, легонько потянув за поводок."

# ch/ayesha/petplay.rpy:278
translate russian ayesha_sub_event_07b_cf03cb67:
    "Ханна трусит за мной, счастливая донельзя, подставив нос ночному воздуху."

# ch/ayesha/petplay.rpy:279
translate russian ayesha_sub_event_07b_513c5c2f:
    "Мы ходили этим маршрутом столько раз, что я мог бы пройти его во сне."

# ch/ayesha/petplay.rpy:280
translate russian ayesha_sub_event_07b_7adda02a:
    "Наверное, поэтому я и не замечаю бегунью, пока она чуть не налетает на нас."

# ch/ayesha/petplay.rpy:282
translate russian ayesha_sub_event_07b_75a51cec:
    "Кто-то большой и быстрый, в капюшоне, несётся по дорожке прямо на нас."

# ch/ayesha/petplay.rpy:283
translate russian ayesha_sub_event_07b_df66f982:
    "Ханна прячется у меня за ногами."

# ch/ayesha/petplay.rpy:284
translate russian ayesha_sub_event_07b_c1817dec:
    "А потом бегунья останавливается в паре шагов от нас и откидывает капюшон."

# ch/ayesha/petplay.rpy:286
translate russian ayesha_sub_event_07b_313696cc:
    ayesha.say "[hanna.name]?"

# ch/ayesha/petplay.rpy:288
translate russian ayesha_sub_event_07b_c28042fd:
    hanna.say "[ayesha.name]?!?"

# ch/ayesha/petplay.rpy:289
translate russian ayesha_sub_event_07b_007cc22d:
    "Долгую секунду никто ничего не говорит."

# ch/ayesha/petplay.rpy:290
translate russian ayesha_sub_event_07b_ab344f17:
    "Аиша смотрит на свою начальницу — на четвереньках, голую, в ошейнике, на поводке, полный комплект."

# ch/ayesha/petplay.rpy:291
translate russian ayesha_sub_event_07b_b7041641:
    "Ханна смотрит на свою лучшую тренершу, которая всё это видела."

# ch/ayesha/petplay.rpy:293
translate russian ayesha_sub_event_07b_7cd94eed:
    ayesha.say "Так вот ПОЧЕМУ ты в последнее время на работе в таком хорошем настроении."

# ch/ayesha/petplay.rpy:295
translate russian ayesha_sub_event_07b_7879c18f:
    hanna.say "Я... это... никому не говори!"

# ch/ayesha/petplay.rpy:297
translate russian ayesha_sub_event_07b_8b7cc733:
    "Потом Аиша поворачивается ко мне, и её улыбка становится смущённой."

# ch/ayesha/petplay.rpy:299
translate russian ayesha_sub_event_07b_acb4a7bf:
    ayesha.say "Ты сказал мне, что это не для тебя, [lssb_ayesha.hero_name()]."

# ch/ayesha/petplay.rpy:301
translate russian ayesha_sub_event_07b_d771ebf0:
    "Она до конца расстёгивает молнию беговой толстовки."

# ch/ayesha/petplay.rpy:302
translate russian ayesha_sub_event_07b_7e331c72:
    "Под ней ничего, кроме кожи и ошейника."

# ch/ayesha/petplay.rpy:304
translate russian ayesha_sub_event_07b_02e0ec0f:
    ayesha.say "Я подумала, что задам вопрос по-другому."

# ch/ayesha/petplay.rpy:307
translate russian ayesha_sub_event_07b_a58dcb5d:
    "Она запихивает одежду в живую изгородь, опускается на четвереньки прямо на дорожке и смотрит на меня снизу вверх."

# ch/ayesha/petplay.rpy:309
translate russian ayesha_sub_event_07b_68bf947d:
    ayesha.say "Гав."

# ch/ayesha/petplay.rpy:311
translate russian ayesha_sub_event_07b_46177ebc:
    "Ханна издаёт сдавленный звук."

# ch/ayesha/petplay.rpy:314
translate russian ayesha_sub_event_07b_44541b66:
    "Я вздыхаю. Этот спор я проиграл бы в любом случае."

# ch/ayesha/petplay.rpy:315
translate russian ayesha_sub_event_07b_b97b27e2:
    "Запасной поводок лежит у меня в кармане куртки с той ночи, когда Ханне понадобился поводок подлиннее."

# ch/ayesha/petplay.rpy:316
translate russian ayesha_sub_event_07b_2874c8e7:
    mike.say "Ну, иди сюда."

# ch/ayesha/petplay.rpy:317
translate russian ayesha_sub_event_07b_79c73aef:
    "Аиша оказывается рядом раньше, чем я договариваю, и склоняет голову, чтобы я пристегнул поводок."

# ch/ayesha/petplay.rpy:318
translate russian ayesha_sub_event_07b_d35e0e17:
    hanna.say "Серьёзно, [lssb_hanna.hero_name()]?"

# ch/ayesha/petplay.rpy:319
translate russian ayesha_sub_event_07b_4151bdb5:
    mike.say "Будь умницей, девочка. Она новенькая."

# ch/ayesha/petplay.rpy:323
translate russian ayesha_sub_event_07b_7ccd8d53:
    "Так что теперь у меня по поводку в каждой руке и по женщине с каждой стороны."

# ch/ayesha/petplay.rpy:324
translate russian ayesha_sub_event_07b_03e889dc:
    "Первый отрезок пути Ханна дуется и держится от неё как можно дальше, насколько позволяет дорожка."

# ch/ayesha/petplay.rpy:325
translate russian ayesha_sub_event_07b_b1050393:
    "Аиша делу не помогает. Всю дорогу она старательно держится на полшага впереди своей начальницы."

# ch/ayesha/petplay.rpy:326
translate russian ayesha_sub_event_07b_93bf48de:
    "Ханна, конечно, это замечает и ускоряется."

# ch/ayesha/petplay.rpy:327
translate russian ayesha_sub_event_07b_0871c9cd:
    "Аиша ускоряется."

# ch/ayesha/petplay.rpy:328
translate russian ayesha_sub_event_07b_31001392:
    "К повороту я уже почти бегу трусцой, чтобы поспевать за двумя взрослыми женщинами, которые устроили гонку на четвереньках."

# ch/ayesha/petplay.rpy:329
translate russian ayesha_sub_event_07b_f903f999:
    mike.say "К ноге! Обе!"

# ch/ayesha/petplay.rpy:330
translate russian ayesha_sub_event_07b_4527917f:
    "Они обе тут же отступают к моим ногам."

# ch/ayesha/petplay.rpy:331
translate russian ayesha_sub_event_07b_258eaf94:
    "И до конца круга ведут себя идеально."

# ch/ayesha/petplay.rpy:333
translate russian ayesha_sub_event_07b_44562117:
    "Две широкие спины покачиваются бок о бок, два поводка натягиваются и провисают в одном ритме."

# ch/ayesha/petplay.rpy:334
translate russian ayesha_sub_event_07b_b6c22da1:
    "Где-то у пруда Ханна перестаёт дуться."

# ch/ayesha/petplay.rpy:335
translate russian ayesha_sub_event_07b_59a70950:
    "У ворот она даже толкает Аишу плечом."

# ch/ayesha/petplay.rpy:336
translate russian ayesha_sub_event_07b_c116883e:
    "Аиша толкает её в ответ. Ни одна из них ничего не говорит."

# ch/ayesha/petplay.rpy:346
translate russian ayesha_sub_event_07b_cb53129f:
    mike.say "Нет, [ayesha.name]."

# ch/ayesha/petplay.rpy:347
translate russian ayesha_sub_event_07b_7f120f88:
    mike.say "Одевайся и иди домой."

# ch/ayesha/petplay.rpy:349
translate russian ayesha_sub_event_07b_f718270b:
    "Она ещё мгновение остаётся на четвереньках, будто думает, что я могу передумать."

# ch/ayesha/petplay.rpy:350
translate russian ayesha_sub_event_07b_0d38b7f5:
    "Я не передумываю."

# ch/ayesha/petplay.rpy:351
translate russian ayesha_sub_event_07b_c1e8f717:
    "Она медленно поднимается, вытаскивает одежду из изгороди и не смотрит ни на одного из нас."

# ch/ayesha/petplay.rpy:355
translate russian ayesha_sub_event_07b_e5d6f508:
    ayesha.say "Поняла."

# ch/ayesha/petplay.rpy:356
translate russian ayesha_sub_event_07b_d77df49e:
    ayesha.say "Увидимся на работе, [hanna.name]."

# ch/ayesha/petplay.rpy:358
translate russian ayesha_sub_event_07b_a4a57a28:
    "А потом она снова бежит — быстрее, чем раньше, — пока её не поглощает темнота."

# ch/ayesha/petplay.rpy:362
translate russian ayesha_sub_event_07b_a9cd6e2f:
    "Всю дорогу домой Ханна молчит."

# ch/ayesha/petplay.rpy:363
translate russian ayesha_sub_event_07b_800d13a3:
    "Не могу понять, рада она или жалеет, и не спрашиваю."

# ch/ayesha/petwalk.rpy:11
translate russian petwalk_ayesha_intro_1ea14f59:
    mike.say "[ayesha.name]."

# ch/ayesha/petwalk.rpy:12
translate russian petwalk_ayesha_intro_ef41e0f4:
    mike.say "Гулять."

# ch/ayesha/petwalk.rpy:13
translate russian petwalk_ayesha_intro_937b9d05:
    "Я едва успеваю это произнести, а она уже на ногах и стягивает толстовку через голову."

# ch/ayesha/petwalk.rpy:14
translate russian petwalk_ayesha_intro_0793f690:
    "Шорты, кроссовки, носки — всё это кучей летит на мой пол."

# ch/ayesha/petwalk.rpy:15
translate russian petwalk_ayesha_intro_9035434b:
    "И вот остаются только она и ошейник, плотно сидящий у основания шеи."

# ch/ayesha/petwalk.rpy:16
translate russian petwalk_ayesha_intro_eba53512:
    "Её руки дёргаются — ей хочется прикрыться. Я смотрю, как она решает, что не станет."

# ch/ayesha/petwalk.rpy:17
translate russian petwalk_ayesha_intro_2187a015:
    "Я пристёгиваю поводок к кольцу. Щелчок громко разносится по тихой комнате."

# ch/ayesha/petwalk.rpy:18
translate russian petwalk_ayesha_intro_cdd12a6e:
    ayesha.say "Боже. Этот звук..."

# ch/ayesha/petwalk.rpy:19
translate russian petwalk_ayesha_intro_0c3bfe50:
    ayesha.say "До сих пор пробирает, [lssb_ayesha.hero_name()]."

# ch/ayesha/petwalk.rpy:20
translate russian petwalk_ayesha_intro_1e58da21:
    mike.say "Место, девочка."

# ch/ayesha/petwalk.rpy:21
translate russian petwalk_ayesha_intro_2ccc0fd1:
    "Она медленно опускается — сначала на колени, потом на ладони, прямо на холодные половицы."

# ch/ayesha/petwalk.rpy:22
translate russian petwalk_ayesha_intro_91877583:
    "А потом ждёт у моей двери, глядя на меня снизу вверх, что я скажу дальше."

# ch/ayesha/petwalk.rpy:24
translate russian petwalk_ayesha_intro_9f186d0d:
    mike.say "[ayesha.name]. Гулять."

# ch/ayesha/petwalk.rpy:25
translate russian petwalk_ayesha_intro_6b01012b:
    "Она уже голая и на четвереньках у двери, а я ещё даже поводок не нашёл."

# ch/ayesha/petwalk.rpy:26
translate russian petwalk_ayesha_intro_b758d79b:
    "Щёлк. От этого звука всё её тело успокаивается."

# ch/ayesha/petwalk.rpy:27
translate russian petwalk_ayesha_intro_4656f62d:
    ayesha.say "Долго же ты возился, [lssb_ayesha.hero_name()]."

# ch/ayesha/petwalk.rpy:33
translate russian petwalk_ayesha_park_13fb455f:
    "Она напрягается от каждого шороха и каждого освещённого окна, пока мы не доходим до тёмного участка у парка."

# ch/ayesha/petwalk.rpy:34
translate russian petwalk_ayesha_park_fe9d8f43:
    "Потом её шаг выравнивается, голова поднимается. Теперь она по-настоящему смотрит на ночь."

# ch/ayesha/petwalk.rpy:35
translate russian petwalk_ayesha_park_63f5ca9c:
    "Она обнюхивает ножку скамейки, потом основание фонаря — и ловит себя на этом."

# ch/ayesha/petwalk.rpy:36
translate russian petwalk_ayesha_park_8cec87f1:
    "На середине круга она издаёт низкий довольный звук — наполовину рычание, наполовину смех."

# ch/ayesha/petwalk.rpy:37
translate russian petwalk_ayesha_park_3c946dd4:
    ayesha.say "Здесь никого, кроме нас."

# ch/ayesha/petwalk.rpy:38
translate russian petwalk_ayesha_park_fe79d274:
    ayesha.say "Я могла бы гулять тут всю ночь."

# ch/ayesha/petwalk.rpy:40
translate russian petwalk_ayesha_park_bed9c64b:
    "Аиша идёт у моей ноги, поводок свободно провисает между нами."

# ch/ayesha/petwalk.rpy:41
translate russian petwalk_ayesha_park_25c25f6f:
    "Время от времени она оглядывается проверить, смотрю ли я. Смотрю."

# ch/ayesha/petwalk.rpy:47
translate russian petwalk_ayesha_alley_9d97506c:
    "Я сворачиваю с дорожки и веду её в переулок за магазинами."

# ch/ayesha/petwalk.rpy:48
translate russian petwalk_ayesha_alley_9d89a580:
    "Мокрый асфальт под её ладонями, ряд мусорных баков, а над ними задние окна домов — половина ещё горит."

# ch/ayesha/petwalk.rpy:49
translate russian petwalk_ayesha_alley_8c0ca430:
    "У входа в переулок она замирает как вкопанная."

# ch/ayesha/petwalk.rpy:50
translate russian petwalk_ayesha_alley_e4b83309:
    ayesha.say "[lssb_ayesha.hero_name()]. Там наверху живут люди."

# ch/ayesha/petwalk.rpy:51
translate russian petwalk_ayesha_alley_ed391004:
    mike.say "Они спят."

# ch/ayesha/petwalk.rpy:52
translate russian petwalk_ayesha_alley_cffc6a6e:
    ayesha.say "Вон в том окне телик работает. Я слышу."

# ch/ayesha/petwalk.rpy:53
translate russian petwalk_ayesha_alley_494d33a3:
    "Я едва заметно тяну за поводок. Она смотрит на окно, потом на меня."

# ch/ayesha/petwalk.rpy:54
translate russian petwalk_ayesha_alley_60ff7ba6:
    "И идёт."

# ch/ayesha/petwalk.rpy:55
translate russian petwalk_ayesha_alley_6f7b3a0a:
    "На полпути дребезжит задняя дверь. Аиша так сильно вжимается в мои ноги, что я чуть не валюсь в мусорные баки." with vpunch

# ch/ayesha/petwalk.rpy:56
translate russian petwalk_ayesha_alley_55c64cc8:
    "Никто не выходит. Кто-то внутри смеётся над телевизором."

# ch/ayesha/petwalk.rpy:57
translate russian petwalk_ayesha_alley_71eaa31f:
    ayesha.say "Охренеть. По-моему, у меня сердце остановилось."

# ch/ayesha/petwalk.rpy:58
translate russian petwalk_ayesha_alley_759600c5:
    "Но при этом она ухмыляется."

# ch/ayesha/petwalk.rpy:60
translate russian petwalk_ayesha_alley_58b31a7c:
    "Теперь Аиша трусит по переулку, опустив нос, мимо мусорных баков."

# ch/ayesha/petwalk.rpy:61
translate russian petwalk_ayesha_alley_ce213eb4:
    "Когда над нами загорается окно, она застывает, а потом оглядывается на меня с ухмылкой, которую видно даже в темноте."

# ch/ayesha/petwalk.rpy:62
translate russian petwalk_ayesha_alley_b9c633bd:
    ayesha.say "Пусть смотрят."

# ch/ayesha/petwalk.rpy:68
translate russian petwalk_ayesha_street_fb717afa:
    "Мы выходим из темноты на улицу, прямо под первый фонарь."

# ch/ayesha/petwalk.rpy:69
translate russian petwalk_ayesha_street_41d1ff02:
    "В этом свете ей некуда деться. Она жмётся к тени у стены, спина напряжена."

# ch/ayesha/petwalk.rpy:70
translate russian petwalk_ayesha_street_8d3e99d0:
    "Из-за угла выворачивает машина. Свет фар скользит по тротуару."

# ch/ayesha/petwalk.rpy:71
translate russian petwalk_ayesha_street_79eb7a6a:
    "Она остаётся на месте, застряв где-то между желанием рвануть прочь и оцепенением."

# ch/ayesha/petwalk.rpy:72
translate russian petwalk_ayesha_street_1142379d:
    "Машина притормаживает. Потом едет дальше."

# ch/ayesha/petwalk.rpy:73
translate russian petwalk_ayesha_street_abb3bb6d:
    ayesha.say "Меня видели."

# ch/ayesha/petwalk.rpy:74
translate russian petwalk_ayesha_street_ba3c014d:
    ayesha.say "Какой-то мужик только что увидел меня голой на поводке."

# ch/ayesha/petwalk.rpy:75
translate russian petwalk_ayesha_street_789dadb1:
    mike.say "Он увидел мою собаку."

# ch/ayesha/petwalk.rpy:76
translate russian petwalk_ayesha_street_efd5ac68:
    "Три фонаря она молчит. Потом выходит из тени и идёт по свету."

# ch/ayesha/petwalk.rpy:78
translate russian petwalk_ayesha_street_82f77d5f:
    "Под уличными фонарями она держится у самой моей ноги, задрав подбородок."

# ch/ayesha/petwalk.rpy:79
translate russian petwalk_ayesha_street_10f24b2c:
    "Рядом с нами притормаживает машина. Аиша даже не поворачивает головы."

# ch/ayesha/petwalk.rpy:80
translate russian petwalk_ayesha_street_dc494498:
    ayesha.say "Проезжай."

# ch/ayesha/petwalk.rpy:81
translate russian petwalk_ayesha_street_94e87fc7:
    "Говорит она это машине. Но смотрит на меня — проверяет, горжусь ли я ею."

# ch/ayesha/petwalk.rpy:87
translate russian petwalk_ayesha_crowd_a57b9602:
    "На главной улице всё ещё людно. Толпа из баров, очередь к фургону с тако, люди, шумными компаниями расходящиеся по домам."

# ch/ayesha/petwalk.rpy:88
translate russian petwalk_ayesha_crowd_f5762dc4:
    "Поводок у меня в руке натягивается. Она встала как вкопанная."

# ch/ayesha/petwalk.rpy:89
translate russian petwalk_ayesha_crowd_39d175d6:
    ayesha.say "[lssb_ayesha.hero_name()]. Нет. Только не здесь."

# ch/ayesha/petwalk.rpy:90
translate russian petwalk_ayesha_crowd_cb94d883:
    ayesha.say "Тут же человек сто."

# ch/ayesha/petwalk.rpy:91
translate russian petwalk_ayesha_crowd_7ed2540f:
    mike.say "К ноге, [ayesha.name]."

# ch/ayesha/petwalk.rpy:92
translate russian petwalk_ayesha_crowd_ba22f716:
    "Долгую секунду она не двигается. Потом встаёт к ноге."

# ch/ayesha/petwalk.rpy:93
translate russian petwalk_ayesha_crowd_e5cc882c:
    "Головы поворачиваются, кто-то свистит. Поднимается телефон, потом ещё три."

# ch/ayesha/petwalk.rpy:94
translate russian petwalk_ayesha_crowd_3871c37c:
    "Кто-то говорит: «Здоровенная». Это бьёт её, как удар под рёбра."

# ch/ayesha/petwalk.rpy:95
translate russian petwalk_ayesha_crowd_d56a0b4f:
    "Она прижимается плечом к моему колену и идёт дальше."

# ch/ayesha/petwalk.rpy:96
translate russian petwalk_ayesha_crowd_9515473e:
    ayesha.say "Они все пялятся на уродину."

# ch/ayesha/petwalk.rpy:97
translate russian petwalk_ayesha_crowd_2b61ef6b:
    mike.say "Они смотрят на хорошую девочку, которая гуляет со своим хозяином."

# ch/ayesha/petwalk.rpy:98
translate russian petwalk_ayesha_crowd_ce3b655d:
    "От этих слов она поднимает голову. Выше, чем я когда-либо видел, чтобы она держала её в толпе."

# ch/ayesha/petwalk.rpy:99
translate russian petwalk_ayesha_crowd_76472d4a:
    ayesha.say "Да. Да, так и есть."

# ch/ayesha/petwalk.rpy:101
translate russian petwalk_ayesha_crowd_ef06ebbb:
    "Толпа расступается перед нами."

# ch/ayesha/petwalk.rpy:102
translate russian petwalk_ayesha_crowd_8cc882df:
    "Поднимаются телефоны. Аиша больше не вздрагивает. Она расправляет плечи и не спешит."

# ch/ayesha/petwalk.rpy:103
translate russian petwalk_ayesha_crowd_6a302033:
    "Кто-то отпускает замечание про её габариты, и она поворачивает голову и смотрит ему прямо в глаза."

# ch/ayesha/petwalk.rpy:104
translate russian petwalk_ayesha_crowd_6c35e04c:
    "Отводит взгляд он."

# ch/ayesha/petwalk.rpy:105
translate russian petwalk_ayesha_crowd_39884e4a:
    ayesha.say "Так я и думала."

# ch/ayesha/petwalk.rpy:111
translate russian petwalk_ayesha_dog_f9d52948:
    "Я снимаю с крючка второй поводок, и из-за угла, скользя по полу, вылетает [dog.name]."

# ch/ayesha/petwalk.rpy:112
translate russian petwalk_ayesha_dog_dc0b3463:
    "Он замирает как вкопанный, увидев Аишу на четвереньках у двери."

# ch/ayesha/petwalk.rpy:113
translate russian petwalk_ayesha_dog_4a983e73:
    "Следует долгое, обстоятельное обнюхивание."

# ch/ayesha/petwalk.rpy:114
translate russian petwalk_ayesha_dog_5f4d65dd:
    ayesha.say "Эй. Эй! Личное пространство, приятель."

# ch/ayesha/petwalk.rpy:115
translate russian petwalk_ayesha_dog_eb6e08f9:
    "[dog.name] начинает вилять хвостом, как пропеллером."

# ch/ayesha/petwalk.rpy:116
translate russian petwalk_ayesha_dog_4a1c588c:
    ayesha.say "Отлично. [dog.name] решил, что я его новая подружка."

# ch/ayesha/petwalk.rpy:117
translate russian petwalk_ayesha_dog_f1cc24ad:
    mike.say "Ну, в каком-то смысле так и есть."

# ch/ayesha/petwalk.rpy:118
translate russian petwalk_ayesha_dog_bbb42852:
    ayesha.say "Он нюхает мою задницу, [lssb_ayesha.hero_name()]."

# ch/ayesha/petwalk.rpy:119
translate russian petwalk_ayesha_dog_a0b31c0c:
    mike.say "Так собаки здороваются."

# ch/ayesha/petwalk.rpy:120
translate russian petwalk_ayesha_dog_0e06e0fb:
    ayesha.say "...Ну, привет, что ли."

# ch/ayesha/petwalk.rpy:122
translate russian petwalk_ayesha_dog_da4e636d:
    "[dog.name] прибегает, едва поводок снимается с крючка, и у двери тычется носом в нос Аиши."

# ch/ayesha/petwalk.rpy:123
translate russian petwalk_ayesha_dog_34e46f28:
    ayesha.say "Привет, дружок."

# ch/ayesha/petwalk.rpy:124
translate russian petwalk_ayesha_dog_cebc31ee:
    "[dog.name] лижет ей ухо. Она не мешает."

# ch/ayesha/petwalk.rpy:132
translate russian petwalk_ayesha_call_811e16b4:
    "Я пишу в чат «[hanna.name]» сообщение из двух слов. Ответ приходит меньше чем через минуту."

# ch/ayesha/petwalk.rpy:133
translate russian petwalk_ayesha_call_b0b3839a:
    "Аиша смотрит, как я печатаю, и у неё разве что уши не прижимаются."

# ch/ayesha/petwalk.rpy:134
translate russian petwalk_ayesha_call_5a96a86f:
    ayesha.say "Это та, о ком я думаю?"

# ch/ayesha/petwalk.rpy:135
translate russian petwalk_ayesha_call_eb20dcb1:
    mike.say "Будь умницей."

# ch/ayesha/petwalk.rpy:136
translate russian petwalk_ayesha_call_2317e6d8:
    ayesha.say "Я всегда умница. Просто хочу, чтобы она знала, кто тут собака получше."

# ch/ayesha/petwalk.rpy:137
translate russian petwalk_ayesha_call_7e7cb854:
    ayesha.say "Она увидит меня на поводке, [lssb_ayesha.hero_name()]."

# ch/ayesha/petwalk.rpy:138
translate russian petwalk_ayesha_call_109a3e8e:
    ayesha.say "Я больше никогда не смогу посмотреть ей в глаза."

# ch/ayesha/petwalk.rpy:139
translate russian petwalk_ayesha_call_356b1216:
    "Она говорит это как жалобу, но бёдра у неё плотно сжаты, а лицо пылает."

# ch/ayesha/petwalk.rpy:141
translate russian petwalk_ayesha_call_65bd01b8:
    "Я пишу в чат «[hanna.name]», и Аиша выпрямляется у двери."

# ch/ayesha/petwalk.rpy:142
translate russian petwalk_ayesha_call_e466c9ab:
    ayesha.say "Ладно. Две собаки."

# ch/ayesha/petwalk.rpy:143
translate russian petwalk_ayesha_call_eef94c43:
    ayesha.say "Но я иду с внутренней стороны."

# ch/ayesha/petwalk.rpy:146
translate russian petwalk_ayesha_call_d237ea8d:
    "Я пишу в чат «[bree.name]». Наверху что-то падает на пол, а потом раздаётся топот бегущих ног."

# ch/ayesha/petwalk.rpy:147
translate russian petwalk_ayesha_call_ddfafc31:
    ayesha.say "Подожди. Твоя соседка? Та, маленькая?"

# ch/ayesha/petwalk.rpy:148
translate russian petwalk_ayesha_call_589ac5be:
    mike.say "Она уже так делала."

# ch/ayesha/petwalk.rpy:149
translate russian petwalk_ayesha_call_b96e7992:
    ayesha.say "Меня беспокоит не это, [lssb_ayesha.hero_name()]."

# ch/ayesha/petwalk.rpy:150
translate russian petwalk_ayesha_call_c73391bc:
    "Она оглядывает себя. Всю целиком — голую, на четвереньках на коврике в моей прихожей."

# ch/ayesha/petwalk.rpy:151
translate russian petwalk_ayesha_call_28574f60:
    ayesha.say "Она один раз на меня глянет и уставится. Они всегда пялятся."

# ch/ayesha/petwalk.rpy:152
translate russian petwalk_ayesha_call_52b575d1:
    mike.say "Тогда пусть пялится на хорошую девочку."

# ch/ayesha/petwalk.rpy:153
translate russian petwalk_ayesha_call_49e322cf:
    "Аиша шумно выдыхает через нос, расправляет плечи и поворачивается лицом к лестнице."

# ch/ayesha/petwalk.rpy:155
translate russian petwalk_ayesha_call_535393b4:
    "Я пишу в чат «[bree.name]», и Аиша сдвигается, освобождая место у двери."

# ch/ayesha/petwalk.rpy:156
translate russian petwalk_ayesha_call_c00d3338:
    ayesha.say "Пусть пялится сколько влезет."

# ch/ayesha/petwalk.rpy:157
translate russian petwalk_ayesha_call_e0040658:
    "[bree.name] сбегает по лестнице, перепрыгивая через ступеньку."

# ch/ayesha/petwalk.rpy:160
translate russian petwalk_ayesha_call_193ac69d:
    "Я пишу в чат «[other.girl.name]», и Аиша смотрит, как я это делаю."

# ch/ayesha/petwalk.rpy:161
translate russian petwalk_ayesha_call_eb292dbc:
    ayesha.say "Отлично. Ещё кто-то увидит меня в таком виде."

# ch/ayesha/petwalk.rpy:162
translate russian petwalk_ayesha_call_f94a0204:
    "Лицо у неё пылает, но от двери она не сдвинулась ни на сантиметр."

# ch/ayesha/petwalk.rpy:163
translate russian petwalk_ayesha_call_eb20dcb1_1:
    mike.say "Будь умницей."

# ch/ayesha/petwalk.rpy:164
translate russian petwalk_ayesha_call_b101778f:
    ayesha.say "Я всегда умница."

# ch/ayesha/petwalk.rpy:166
translate russian petwalk_ayesha_call_2d66987d:
    "Я пишу в чат «[other.girl.name]», и Аиша выпрямляется у двери."

# ch/ayesha/petwalk.rpy:167
translate russian petwalk_ayesha_call_248e9497:
    ayesha.say "Ладно. Две собаки. Но я иду с внутренней стороны."

# ch/ayesha/petwalk.rpy:175
translate russian petwalk_ayesha_joined_2e66112f:
    "Три стука, таких тихих, что я чуть их не пропускаю."

# ch/ayesha/petwalk.rpy:176
translate russian petwalk_ayesha_joined_b28697d4:
    "Аиша занимает почти весь дверной проём: капюшон натянут, руки засунуты в карман беговой толстовки."

# ch/ayesha/petwalk.rpy:177
translate russian petwalk_ayesha_joined_4bb9be17:
    "Она смотрит на свою начальницу — на четвереньках в моей прихожей, голую, в ошейнике, на поводке, полный комплект."

# ch/ayesha/petwalk.rpy:178
translate russian petwalk_ayesha_joined_7cd94eed:
    ayesha.say "Так вот ПОЧЕМУ ты в последнее время на работе в таком хорошем настроении."

# ch/ayesha/petwalk.rpy:179
translate russian petwalk_ayesha_joined_641fd51a:
    hanna.say "Заткнись и раздевайся."

# ch/ayesha/petwalk.rpy:180
translate russian petwalk_ayesha_joined_d771ebf0:
    "Она до конца расстёгивает молнию беговой толстовки."

# ch/ayesha/petwalk.rpy:181
translate russian petwalk_ayesha_joined_7e331c72:
    "Под ней ничего, кроме кожи и ошейника."

# ch/ayesha/petwalk.rpy:182
translate russian petwalk_ayesha_joined_94d726bf:
    "Она опускается на четвереньки туда же, где уже стоит [hanna.name], и склоняет голову, чтобы я пристегнул поводок."

# ch/ayesha/petwalk.rpy:183
translate russian petwalk_ayesha_joined_68bf947d:
    ayesha.say "Гав."

# ch/ayesha/petwalk.rpy:185
translate russian petwalk_ayesha_joined_7cae9066:
    "Аиша стоит у двери уже через десять минут после моего сообщения — ошейник уже надет под толстовкой."

# ch/ayesha/petwalk.rpy:186
translate russian petwalk_ayesha_joined_e2e394f2:
    "Толстовка летит на пол. Аиша опускается рядом, и [hanna.name] тут же получает толчок плечом."

# ch/ayesha/petwalk.rpy:187
translate russian petwalk_ayesha_joined_7e667c9c:
    ayesha.say "Подвинься, [hanna.name]."

# ch/ayesha/petwalk.rpy:191
translate russian petwalk_ayesha_joined_c42fe1f4:
    "Аиша пригибается под дверным косяком: капюшон натянут, руки засунуты в карман беговой толстовки."

# ch/ayesha/petwalk.rpy:192
translate russian petwalk_ayesha_joined_09df44a6:
    "[bree.name] стоит на четвереньках в прихожей. Она поднимает взгляд — выше, и выше, и ещё выше."

# ch/ayesha/petwalk.rpy:193
translate russian petwalk_ayesha_joined_ff595a60:
    bree.say "О. Ого. Ты... эм... НАМНОГО выше, если смотреть снизу."

# ch/ayesha/petwalk.rpy:194
translate russian petwalk_ayesha_joined_9a98ffd0:
    "Челюсти Аиши сжимаются."

# ch/ayesha/petwalk.rpy:195
translate russian petwalk_ayesha_joined_c1eca9bd:
    bree.say "Я-я в хорошем смысле! В смысле, в очень хорошем!"

# ch/ayesha/petwalk.rpy:196
translate russian petwalk_ayesha_joined_4b282675:
    "Что-то в плечах Аиши отпускает. Она фыркает."

# ch/ayesha/petwalk.rpy:197
translate russian petwalk_ayesha_joined_ed997c78:
    "Она до конца расстёгивает молнию беговой толстовки. Под ней ничего, кроме кожи и ошейника."

# ch/ayesha/petwalk.rpy:198
translate russian petwalk_ayesha_joined_4d6b4ab3:
    "Потом она опускается на четвереньки, и вдруг [bree.name] оказывается с ней почти на одном уровне."

# ch/ayesha/petwalk.rpy:199
translate russian petwalk_ayesha_joined_520a3113:
    ayesha.say "Вот. Так лучше?"

# ch/ayesha/petwalk.rpy:201
translate russian petwalk_ayesha_joined_298df4a0:
    "Аиша стоит у двери уже через десять минут после моего сообщения — ошейник уже надет под толстовкой."

# ch/ayesha/petwalk.rpy:202
translate russian petwalk_ayesha_joined_e37b0b48:
    "[bree.name] радостно виляет попкой, сидя на полу в прихожей."

# ch/ayesha/petwalk.rpy:203
translate russian petwalk_ayesha_joined_3fe6a2b1:
    "Аиша сбрасывает толстовку и складывается рядом с ней, стараясь её не опрокинуть."

# ch/ayesha/petwalk.rpy:204
translate russian petwalk_ayesha_joined_239bbd15:
    ayesha.say "Привет, [bree.name]."

# ch/ayesha/petwalk.rpy:208
translate russian petwalk_ayesha_joined_2e66112f_1:
    "Три стука, таких тихих, что я чуть их не пропускаю."

# ch/ayesha/petwalk.rpy:209
translate russian petwalk_ayesha_joined_b28697d4_1:
    "Аиша занимает почти весь дверной проём: капюшон натянут, руки засунуты в карман беговой толстовки."

# ch/ayesha/petwalk.rpy:210
translate russian petwalk_ayesha_joined_447ada7e:
    "Перед ней на четвереньках в моей прихожей — [other.girl.name]: голая, в ошейнике, на поводке, полный комплект."

# ch/ayesha/petwalk.rpy:211
translate russian petwalk_ayesha_joined_2ea32c7f:
    ayesha.say "Хм. Тебе идёт быть внизу, [other.girl.name]."

# ch/ayesha/petwalk.rpy:212
translate russian petwalk_ayesha_joined_d771ebf0_1:
    "Она до конца расстёгивает молнию беговой толстовки."

# ch/ayesha/petwalk.rpy:213
translate russian petwalk_ayesha_joined_7e331c72_1:
    "Под ней ничего, кроме кожи и ошейника."

# ch/ayesha/petwalk.rpy:214
translate russian petwalk_ayesha_joined_8d2954ac:
    "Она опускается на четвереньки туда же, где уже стоит [other.girl.name], и склоняет голову, чтобы я пристегнул поводок."

# ch/ayesha/petwalk.rpy:215
translate russian petwalk_ayesha_joined_68bf947d_1:
    ayesha.say "Гав."

# ch/ayesha/petwalk.rpy:217
translate russian petwalk_ayesha_joined_7cae9066_1:
    "Аиша стоит у двери уже через десять минут после моего сообщения — ошейник уже надет под толстовкой."

# ch/ayesha/petwalk.rpy:218
translate russian petwalk_ayesha_joined_305d460e:
    "Толстовка летит на пол. Аиша опускается рядом, и [other.girl.name] тут же получает толчок плечом."

# ch/ayesha/petwalk.rpy:219
translate russian petwalk_ayesha_joined_289e78e5:
    ayesha.say "Подвинься. Сегодня я иду с внутренней стороны."

# ch/ayesha/petwalk.rpy:225
translate russian petwalk_ayesha_bark_8429a07a:
    mike.say "Голос, [ayesha.name]."

# ch/ayesha/petwalk.rpy:226
translate russian petwalk_ayesha_bark_e16d80dc:
    "Она смотрит на меня так, будто я спятил."

# ch/ayesha/petwalk.rpy:227
translate russian petwalk_ayesha_bark_0d425386:
    ayesha.say "Ты шутишь."

# ch/ayesha/petwalk.rpy:228
translate russian petwalk_ayesha_bark_75d627f4:
    mike.say "Говори."

# ch/ayesha/petwalk.rpy:229
translate russian petwalk_ayesha_bark_1cf00261:
    "Она прокашливается. Оглядывается по сторонам."

# ch/ayesha/petwalk.rpy:230
translate russian petwalk_ayesha_bark_daa649ec:
    ayesha.say "...гав."

# ch/ayesha/petwalk.rpy:231
translate russian petwalk_ayesha_bark_ad06a972:
    mike.say "Громче, [ayesha.name]."

# ch/ayesha/petwalk.rpy:232
translate russian petwalk_ayesha_bark_0fb2d05f:
    "Она глубоко вздыхает."

# ch/ayesha/petwalk.rpy:233
translate russian petwalk_ayesha_bark_f14c61e7:
    ayesha.say "ГАВ!"

# ch/ayesha/petwalk.rpy:235
translate russian petwalk_ayesha_bark_4a1ccfc2:
    "Разносится на несколько кварталов. Где-то вдалеке ей отвечает настоящая собака."

# ch/ayesha/petwalk.rpy:236
translate russian petwalk_ayesha_bark_a0e5216c:
    "Аиша выглядит такой гордой собой, что мне приходится почесать её за ухом."

# ch/ayesha/petwalk.rpy:238
translate russian petwalk_ayesha_bark_75d627f4_1:
    mike.say "Говори."

# ch/ayesha/petwalk.rpy:239
translate russian petwalk_ayesha_bark_64de3e8d:
    ayesha.say "Гав! Гав!"

# ch/ayesha/petwalk.rpy:240
translate russian petwalk_ayesha_bark_0e2ad284:
    "Во весь голос, грудь колесом."

# ch/ayesha/petwalk.rpy:246
translate russian petwalk_ayesha_tummy_bf40760f:
    mike.say "Перевернись."

# ch/ayesha/petwalk.rpy:247
translate russian petwalk_ayesha_tummy_1ca287fc:
    "Она колеблется. На спине, животом кверху, ей негде спрятаться."

# ch/ayesha/petwalk.rpy:248
translate russian petwalk_ayesha_tummy_8fd61a11:
    "Потом она переворачивается на холодной земле и лежит, поджав лапки."

# ch/ayesha/petwalk.rpy:249
translate russian petwalk_ayesha_tummy_1a2839e0:
    "Я глажу её живот. Каменный пресс подрагивает под моей ладонью."

# ch/ayesha/petwalk.rpy:250
translate russian petwalk_ayesha_tummy_7a08ffcb:
    ayesha.say "О. О, это..."

# ch/ayesha/petwalk.rpy:251
translate russian petwalk_ayesha_tummy_7b30ad4b:
    "Одна её нога начинает дёргаться. Она в ужасе на неё смотрит."

# ch/ayesha/petwalk.rpy:252
translate russian petwalk_ayesha_tummy_985158ca:
    ayesha.say "Только попробуй кому-нибудь рассказать про ногу, [lssb_ayesha.hero_name()]."

# ch/ayesha/petwalk.rpy:254
translate russian petwalk_ayesha_tummy_bf40760f_1:
    mike.say "Перевернись."

# ch/ayesha/petwalk.rpy:255
translate russian petwalk_ayesha_tummy_cb73a1ae:
    "Она уже на спине, лапки кверху, ухмыляется, а я ещё даже не договорил."

# ch/ayesha/petwalk.rpy:256
translate russian petwalk_ayesha_tummy_2832cd3e:
    "Я глажу её по животу, и нога снова начинает дёргаться. Она уже перестала с этим бороться."

# ch/ayesha/petwalk.rpy:262
translate russian petwalk_ayesha_growl_34e06f3e:
    "Впереди в темноте что-то движется. Тень, мусорный мешок, может, мужик, который идёт домой."

# ch/ayesha/petwalk.rpy:263
translate russian petwalk_ayesha_growl_0ec4b9d0:
    mike.say "Кто там, девочка? Рычи."

# ch/ayesha/petwalk.rpy:264
translate russian petwalk_ayesha_growl_ea962597:
    "Аиша упирается всеми четырьмя конечностями, опускает голову и издаёт звук откуда-то из глубины груди."

# ch/ayesha/petwalk.rpy:265
translate russian petwalk_ayesha_growl_6c1d0657:
    "Это настоящее рычание, низкое и хриплое, от такого люди переходят на другую сторону улицы."

# ch/ayesha/petwalk.rpy:266
translate russian petwalk_ayesha_growl_1decfcb4:
    "Что бы это ни было, оно исчезло."

# ch/ayesha/petwalk.rpy:267
translate russian petwalk_ayesha_growl_408f39e6:
    ayesha.say "Хм."

# ch/ayesha/petwalk.rpy:268
translate russian petwalk_ayesha_growl_fd55b45f:
    ayesha.say "Боже, как же это было приятно, [lssb_ayesha.hero_name()]."

# ch/ayesha/petwalk.rpy:270
translate russian petwalk_ayesha_growl_e91a20d9:
    mike.say "Рычи."

# ch/ayesha/petwalk.rpy:271
translate russian petwalk_ayesha_growl_80c39866:
    "Цель ей не нужна. Она выбирает ближайшую тень и выдаёт ей по полной — низко, раскатисто."

# ch/ayesha/petwalk.rpy:272
translate russian petwalk_ayesha_growl_ee48a233:
    "Потом поднимает на меня взгляд, ожидая, что я почешу её за ухом."

# ch/ayesha/petwalk.rpy:278
translate russian petwalk_ayesha_pee_c5126b98:
    "На полпути Аиша останавливается."

# ch/ayesha/petwalk.rpy:279
translate russian petwalk_ayesha_pee_8aa0d8ef:
    "Она переминается и косится на ближайшее дерево, а потом поднимает на меня страдальческий взгляд."

# ch/ayesha/petwalk.rpy:280
translate russian petwalk_ayesha_pee_f2675f54:
    ayesha.say "Э-э... [lssb_ayesha.hero_name()]?"

# ch/ayesha/petwalk.rpy:281
translate russian petwalk_ayesha_pee_3160d36d:
    ayesha.say "Перед тем как прийти, я выпила целую бутылку воды."

# ch/ayesha/petwalk.rpy:282
translate russian petwalk_ayesha_pee_7b4e5df8:
    ayesha.say "Как дура."

# ch/ayesha/petwalk.rpy:283
translate russian petwalk_ayesha_pee_10a0f2fc:
    mike.say "Так иди. Собаки так и делают."

# ch/ayesha/petwalk.rpy:284
translate russian petwalk_ayesha_pee_107b1e1f:
    "Она долго испепеляет меня взглядом."

# ch/ayesha/petwalk.rpy:286
translate russian petwalk_ayesha_pee_f7ba71e3:
    "Потом подползает к дереву, крепко зажмуривается и задирает ногу."

# ch/ayesha/petwalk.rpy:287
translate russian petwalk_ayesha_pee_7ea38367:
    ayesha.say "Не смотри. Не смотри, не смотри, не..."

# ch/ayesha/petwalk.rpy:288
translate russian petwalk_ayesha_pee_fedc7b28:
    ayesha.say "...о боже, как же полегчало."

# ch/ayesha/petwalk.rpy:289
translate russian petwalk_ayesha_pee_21f62a1f:
    "Она возвращается ко мне с пылающими щеками и задранным подбородком."

# ch/ayesha/petwalk.rpy:292
translate russian petwalk_ayesha_pee_7b03639e:
    "Аиша сама трусит к дереву, задирает ногу и делает свои дела."

# ch/ayesha/petwalk.rpy:293
translate russian petwalk_ayesha_pee_90525e13:
    "На этот раз она не зажмуривается. Она смотрит прямо на меня, пока это делает."

# ch/ayesha/petwalk.rpy:294
translate russian petwalk_ayesha_pee_357c3ff9:
    ayesha.say "Что? Собаки так и делают."

# ch/ayesha/petwalk.rpy:300
translate russian petwalk_ayesha_outro_e28c4f6d:
    "Домой мы идём длинной дорогой, по неосвещённым улицам."

# ch/ayesha/petwalk.rpy:301
translate russian petwalk_ayesha_outro_c29c1920:
    "К моей двери она добирается приятно уставшей, руки у неё слегка дрожат."

# ch/ayesha/petwalk.rpy:302
translate russian petwalk_ayesha_outro_14c44276:
    "Внутри я отстёгиваю поводок, и она садится на пятки на моём ковре."

# ch/ayesha/petwalk.rpy:303
translate russian petwalk_ayesha_outro_b5b5fa78:
    ayesha.say "[lssb_ayesha.hero_name()]?"

# ch/ayesha/petwalk.rpy:304
translate russian petwalk_ayesha_outro_aa781f42:
    ayesha.say "Там, снаружи, я не была девушкой, которая слишком большая."

# ch/ayesha/petwalk.rpy:305
translate russian petwalk_ayesha_outro_17ae5f2e:
    ayesha.say "Я была просто твоей собакой."

# ch/ayesha/petwalk.rpy:306
translate russian petwalk_ayesha_outro_49a4642f:
    ayesha.say "Это странно?"

# ch/ayesha/petwalk.rpy:307
translate russian petwalk_ayesha_outro_c20fc007:
    "Она натягивает беговую толстовку обратно, прежде чем я успеваю ответить."

# ch/ayesha/petwalk.rpy:308
translate russian petwalk_ayesha_outro_ba03ffdd:
    ayesha.say "В то же время на следующей неделе, [lssb_ayesha.hero_name()]?"

# ch/ayesha/petwalk.rpy:309
translate russian petwalk_ayesha_outro_4ec830c2:
    "Она дразнится. В основном."

# ch/ayesha/petwalk.rpy:311
translate russian petwalk_ayesha_outro_049ec037:
    "Вернувшись в дом, Аиша растягивается на моём ковре, раскрасневшаяся и довольная собой."

# ch/ayesha/petwalk.rpy:312
translate russian petwalk_ayesha_outro_26f27b6e:
    ayesha.say "Спасибо, [lssb_ayesha.hero_name()]."

# ch/ayesha/petwalk.rpy:313
translate russian petwalk_ayesha_outro_c1ef1934:
    "Никогда ещё я не слышал, чтобы она говорила так мягко."

# ch/ayesha/petwalk.rpy:320
translate russian petwalk_ayesha_ask_d753bec9:
    "Аиша уже добрых пять минут теребит ошейник у себя на шее."

# ch/ayesha/petwalk.rpy:321
translate russian petwalk_ayesha_ask_049d68b2:
    "Крутит кольцо, проверяет пряжку, снова крутит кольцо."

# ch/ayesha/petwalk.rpy:323
translate russian petwalk_ayesha_ask_b91e3426:
    ayesha.say "Слушай, [lssb_ayesha.hero_name()]..."

# ch/ayesha/petwalk.rpy:324
translate russian petwalk_ayesha_ask_6c587f7d:
    ayesha.say "Вчера ночью я ходила на пробежку. Три часа ночи, пустые улицы."

# ch/ayesha/petwalk.rpy:326
translate russian petwalk_ayesha_ask_7b3e5c76:
    ayesha.say "И мне это было противно."

# ch/ayesha/petwalk.rpy:327
translate russian petwalk_ayesha_ask_19f61886:
    ayesha.say "Никто на меня не пялился, и впервые мне хотелось, чтобы пялились."

# ch/ayesha/petwalk.rpy:329
translate russian petwalk_ayesha_ask_4834f808:
    ayesha.say "Мне хотелось быть там в ошейнике, а чтобы ты держал поводок."

# ch/ayesha/petwalk.rpy:330
translate russian petwalk_ayesha_ask_72b1da8f:
    ayesha.say "Мне хотелось, чтобы все видели, чья я."

# ch/ayesha/petwalk.rpy:332
translate russian petwalk_ayesha_ask_45955250:
    "Потом она медленно опускается передо мной на четвереньки — так же, как в первый раз."

# ch/ayesha/petwalk.rpy:334
translate russian petwalk_ayesha_ask_747bd159:
    ayesha.say "Так, может, выгуляешь свою сучку, [lssb_ayesha.hero_name()]?"

# ch/ayesha/petwalk.rpy:338
translate russian petwalk_ayesha_ask_ae66288a:
    "Аиша бросает поводок мне на колени и садится на пятки в ожидании."

# ch/ayesha/petwalk.rpy:340
translate russian petwalk_ayesha_ask_5b23f6b1:
    ayesha.say "Твою сучку пора выгулять, [lssb_ayesha.hero_name()]."

# ch/ayesha/petwalk.rpy:342
translate russian petwalk_ayesha_ask_cc81d43a:
    ayesha.say "Не заставляй её грызть мебель."

# ch/ayesha/petwalk.rpy:349
translate russian petwalk_ayesha_bark_alley_20db78e4:
    "Взгляд Аиши устремляется к освещённому окну над мусорными баками. За занавеской мелькает тень."

# ch/ayesha/petwalk.rpy:350
translate russian petwalk_ayesha_bark_alley_75d627f4:
    mike.say "Говори."

# ch/ayesha/petwalk.rpy:351
translate russian petwalk_ayesha_bark_alley_e3cd1bff:
    ayesha.say "Здесь? Меня же услышат, [lssb_ayesha.hero_name()]."

# ch/ayesha/petwalk.rpy:352
translate russian petwalk_ayesha_bark_alley_5067c788:
    mike.say "На то и расчёт."

# ch/ayesha/petwalk.rpy:353
translate russian petwalk_ayesha_bark_alley_daa649ec:
    ayesha.say "...гав."

# ch/ayesha/petwalk.rpy:354
translate russian petwalk_ayesha_bark_alley_33bd52ce:
    "Я жду. Она закрывает глаза и набирает полную грудь воздуха."

# ch/ayesha/petwalk.rpy:355
translate russian petwalk_ayesha_bark_alley_f14c61e7:
    ayesha.say "ГАВ!"

# ch/ayesha/petwalk.rpy:356
translate russian petwalk_ayesha_bark_alley_a7ad8033:
    "Занавеска дёргается. Лицо, долгий взгляд вниз — и свет гаснет."

# ch/ayesha/petwalk.rpy:357
translate russian petwalk_ayesha_bark_alley_ee8368ac:
    ayesha.say "[lssb_ayesha.hero_name()]... на меня смотрели в упор."

# ch/ayesha/petwalk.rpy:359
translate russian petwalk_ayesha_bark_alley_c9003c5c:
    "Окно над мусорными баками снова горит. Аиша смотрит на него, потом на меня, ожидая команды."

# ch/ayesha/petwalk.rpy:360
translate russian petwalk_ayesha_bark_alley_75d627f4_1:
    mike.say "Говори."

# ch/ayesha/petwalk.rpy:361
translate russian petwalk_ayesha_bark_alley_f14c61e7_1:
    ayesha.say "ГАВ!"

# ch/ayesha/petwalk.rpy:362
translate russian petwalk_ayesha_bark_alley_8b8e5611:
    "Занавеска шевелится. Она держит голову высоко и даёт им как следует себя рассмотреть."

# ch/ayesha/petwalk.rpy:368
translate russian petwalk_ayesha_bark_street_99b3efb3:
    "Через дорогу на светофоре стоит машина с работающим мотором, окна опущены, грохочет музыка."

# ch/ayesha/petwalk.rpy:369
translate russian petwalk_ayesha_bark_street_8429a07a:
    mike.say "Голос, [ayesha.name]."

# ch/ayesha/petwalk.rpy:370
translate russian petwalk_ayesha_bark_street_3ec0f546:
    "Я чувствую через весь поводок, как она напрягается."

# ch/ayesha/petwalk.rpy:371
translate russian petwalk_ayesha_bark_street_daceee05:
    ayesha.say "[lssb_ayesha.hero_name()]... только не когда они прямо там."

# ch/ayesha/petwalk.rpy:372
translate russian petwalk_ayesha_bark_street_75d627f4:
    mike.say "Говори."

# ch/ayesha/petwalk.rpy:373
translate russian petwalk_ayesha_bark_street_711140e9:
    ayesha.say "ГАВ! ГАВ!"

# ch/ayesha/petwalk.rpy:374
translate russian petwalk_ayesha_bark_street_c93362db:
    "Музыка обрывается. Кто-то высовывается из окна пассажирского сиденья."

# ch/ayesha/petwalk.rpy:375
translate russian petwalk_ayesha_bark_street_28b8240c:
    "Passenger" "Охренеть! Это что, девка?"

# ch/ayesha/petwalk.rpy:376
translate russian petwalk_ayesha_bark_street_10e0d07e:
    "Загорается зелёный. Аиша посылает вслед их задним фарам ещё один гавк и поднимает на меня взгляд, ожидая, что я её почешу."

# ch/ayesha/petwalk.rpy:378
translate russian petwalk_ayesha_bark_street_5cf61223:
    "Двое парней на противоположном тротуаре замирают как вкопанные и пялятся."

# ch/ayesha/petwalk.rpy:379
translate russian petwalk_ayesha_bark_street_c09013c2:
    "Pedestrian" "Чувак. Чувак, глянь."

# ch/ayesha/petwalk.rpy:380
translate russian petwalk_ayesha_bark_street_75d627f4_1:
    mike.say "Говори."

# ch/ayesha/petwalk.rpy:381
translate russian petwalk_ayesha_bark_street_694a16fd:
    "Она лает прямо на них, так громко, что дребезжат рольставни магазина, и они вспоминают, что им срочно надо куда-то ещё."

# ch/ayesha/petwalk.rpy:387
translate russian petwalk_ayesha_bark_crowd_0cf8d65e:
    "Мы останавливаемся посреди тротуара у бара. На нас уже смотрят."

# ch/ayesha/petwalk.rpy:388
translate russian petwalk_ayesha_bark_crowd_75d627f4:
    mike.say "Говори."

# ch/ayesha/petwalk.rpy:389
translate russian petwalk_ayesha_bark_crowd_5e47cf38:
    "Вся спина Аиши каменеет. Тут человек двадцать, не меньше, и услышит каждый."

# ch/ayesha/petwalk.rpy:390
translate russian petwalk_ayesha_bark_crowd_a03e4a58:
    ayesha.say "[lssb_ayesha.hero_name()], пожалуйста. Не при них всех."

# ch/ayesha/petwalk.rpy:391
translate russian petwalk_ayesha_bark_crowd_11730d6c:
    mike.say "При них всех. Голос."

# ch/ayesha/petwalk.rpy:392
translate russian petwalk_ayesha_bark_crowd_222048ed:
    ayesha.say "...ГАВ!"

# ch/ayesha/petwalk.rpy:394
translate russian petwalk_ayesha_bark_crowd_707acf43:
    "Курильщики у дверей разражаются одобрительными криками. Появляются телефоны."

# ch/ayesha/petwalk.rpy:395
translate russian petwalk_ayesha_bark_crowd_ccb3067e:
    "Bar crowd" "Ещё! Давай ещё!"

# ch/ayesha/petwalk.rpy:396
translate russian petwalk_ayesha_bark_crowd_bc0c4986:
    ayesha.say "Я лаю, только когда велит [lssb_ayesha.hero_name()]."

# ch/ayesha/petwalk.rpy:398
translate russian petwalk_ayesha_bark_crowd_df2da274:
    "У бара кто-то нас замечает и кричит приятелям, чтобы шли посмотреть."

# ch/ayesha/petwalk.rpy:399
translate russian petwalk_ayesha_bark_crowd_75d627f4_1:
    mike.say "Говори."

# ch/ayesha/petwalk.rpy:400
translate russian petwalk_ayesha_bark_crowd_711140e9:
    ayesha.say "ГАВ! ГАВ!"

# ch/ayesha/petwalk.rpy:401
translate russian petwalk_ayesha_bark_crowd_791356d8:
    "Поднимаются телефоны. Аиша лает прямо в ближайший объектив, а потом оглядывается проверить, понравилось ли мне."

# ch/ayesha/petwalk.rpy:407
translate russian petwalk_ayesha_tummy_alley_bf40760f:
    mike.say "Перевернись."

# ch/ayesha/petwalk.rpy:408
translate russian petwalk_ayesha_tummy_alley_90fe9888:
    "Аиша смотрит на мокрый асфальт, потом на заднюю дверь рядом с мусорными баками. За стеклом горит свет."

# ch/ayesha/petwalk.rpy:409
translate russian petwalk_ayesha_tummy_alley_7f7dd39b:
    ayesha.say "На спину? Прямо под чьей-то дверью?"

# ch/ayesha/petwalk.rpy:410
translate russian petwalk_ayesha_tummy_alley_bf40760f_1:
    mike.say "Перевернись."

# ch/ayesha/petwalk.rpy:411
translate russian petwalk_ayesha_tummy_alley_a8afe10f:
    "Она делает это. Живот кверху, лапки поджаты, всё напоказ тому, кто откроет эту дверь."

# ch/ayesha/petwalk.rpy:412
translate russian petwalk_ayesha_tummy_alley_008ecf9e:
    "Я глажу её по животу. Её пресс вздрагивает под моей ладонью от каждого звука изнутри."

# ch/ayesha/petwalk.rpy:413
translate russian petwalk_ayesha_tummy_alley_916ef4ca:
    "Ручка двери дёргается. А нога у неё всё равно начинает дрыгаться."

# ch/ayesha/petwalk.rpy:414
translate russian petwalk_ayesha_tummy_alley_37506820:
    ayesha.say "Не останавливайся. Только попробуй остановиться, [lssb_ayesha.hero_name()]."

# ch/ayesha/petwalk.rpy:415
translate russian petwalk_ayesha_tummy_alley_d359e2b0:
    "Ручка замирает. Никто не выходит, а она лежит на спине, пока я не разрешу встать."

# ch/ayesha/petwalk.rpy:417
translate russian petwalk_ayesha_tummy_alley_bf40760f_2:
    mike.say "Перевернись."

# ch/ayesha/petwalk.rpy:418
translate russian petwalk_ayesha_tummy_alley_0d51b773:
    "Она переворачивается прямо под освещённым окном, лапки кверху, даже не глянув на него."

# ch/ayesha/petwalk.rpy:419
translate russian petwalk_ayesha_tummy_alley_460798a4:
    "Я глажу её по животу, и нога пошла. Наверху кто-то убавляет звук телевизора, чтобы прислушаться."

# ch/ayesha/petwalk.rpy:420
translate russian petwalk_ayesha_tummy_alley_253de603:
    ayesha.say "М-м-м. Вот тут, [lssb_ayesha.hero_name()]."

# ch/ayesha/petwalk.rpy:426
translate russian petwalk_ayesha_tummy_street_bf40760f:
    mike.say "Перевернись."

# ch/ayesha/petwalk.rpy:427
translate russian petwalk_ayesha_tummy_street_5db82774:
    "Мы прямо под уличным фонарём. Машины проезжают каждые несколько секунд."

# ch/ayesha/petwalk.rpy:428
translate russian petwalk_ayesha_tummy_street_2876c5e5:
    ayesha.say "[lssb_ayesha.hero_name()]... свет. Все, кто проезжает мимо, увидят всё."

# ch/ayesha/petwalk.rpy:429
translate russian petwalk_ayesha_tummy_street_cbb13d89:
    mike.say "Знаю. Перевернись."

# ch/ayesha/petwalk.rpy:430
translate russian petwalk_ayesha_tummy_street_a3e8e994:
    "Она переворачивается на спину прямо на тротуаре, вся освещённая фонарём."

# ch/ayesha/petwalk.rpy:431
translate russian petwalk_ayesha_tummy_street_5c552a5c:
    "Машина ползёт еле-еле. Кто-то внутри смеётся."

# ch/ayesha/petwalk.rpy:432
translate russian petwalk_ayesha_tummy_street_4935db67:
    "Driver" "Чувак, на что я вообще смотрю?"

# ch/ayesha/petwalk.rpy:433
translate russian petwalk_ayesha_tummy_street_2167f539:
    "Её руки дёргаются к груди. Я кладу ладонь ей на живот и медленно глажу, и руки остаются на месте."

# ch/ayesha/petwalk.rpy:434
translate russian petwalk_ayesha_tummy_street_1c65ebf1:
    "К тому времени, как машина отъезжает, нога у неё уже дрыгается, а сама она улыбается небу."

# ch/ayesha/petwalk.rpy:436
translate russian petwalk_ayesha_tummy_street_bf40760f_1:
    mike.say "Перевернись."

# ch/ayesha/petwalk.rpy:437
translate russian petwalk_ayesha_tummy_street_06577826:
    "Она плюхается на спину под фонарём, лапки кверху, животом к проезжей части."

# ch/ayesha/petwalk.rpy:439
translate russian petwalk_ayesha_tummy_street_d34b06b2:
    "Сигналит машина. А нога у неё дрыгается в такт моей руке."

# ch/ayesha/petwalk.rpy:440
translate russian petwalk_ayesha_tummy_street_4847b72c:
    ayesha.say "Не обращай на них внимания. Продолжай."

# ch/ayesha/petwalk.rpy:446
translate russian petwalk_ayesha_tummy_crowd_d2499093:
    mike.say "Перевернись, [ayesha.name]."

# ch/ayesha/petwalk.rpy:447
translate russian petwalk_ayesha_tummy_crowd_6aec147e:
    "Вокруг нас уже собираются люди. Аиша смотрит на кольцо из ботинок и телефонов."

# ch/ayesha/petwalk.rpy:448
translate russian petwalk_ayesha_tummy_crowd_cb9c83cc:
    ayesha.say "[lssb_ayesha.hero_name()]... на спину? Перед ними всеми?"

# ch/ayesha/petwalk.rpy:449
translate russian petwalk_ayesha_tummy_crowd_5cc24029:
    mike.say "Для меня. А они просто посмотрят."

# ch/ayesha/petwalk.rpy:450
translate russian petwalk_ayesha_tummy_crowd_8644350e:
    "Она переворачивается посреди тротуара и лежит так, вся напоказ, прижав лапки к груди."

# ch/ayesha/petwalk.rpy:451
translate russian petwalk_ayesha_tummy_crowd_dd447dd5:
    "Woman" "Боже мой, вы только гляньте на этот пресс!"

# ch/ayesha/petwalk.rpy:452
translate russian petwalk_ayesha_tummy_crowd_21e93cf1:
    "Я глажу её по животу. Нога начинает дрыгаться. Кто-то смеётся, срабатывает вспышка телефона."

# ch/ayesha/petwalk.rpy:453
translate russian petwalk_ayesha_tummy_crowd_d167aba6:
    "Аиша крепко зажмуривается, потом снова открывает глаза и смотрит прямо на меня."

# ch/ayesha/petwalk.rpy:454
translate russian petwalk_ayesha_tummy_crowd_d27781ce:
    ayesha.say "Не останавливайся. Хочу, чтобы они видели, как ты это делаешь."

# ch/ayesha/petwalk.rpy:456
translate russian petwalk_ayesha_tummy_crowd_bf40760f:
    mike.say "Перевернись."

# ch/ayesha/petwalk.rpy:457
translate russian petwalk_ayesha_tummy_crowd_51acd2ea:
    "Она переворачивается посреди толпы и растягивается, занимая полтротуара."

# ch/ayesha/petwalk.rpy:458
translate russian petwalk_ayesha_tummy_crowd_8fa549b5:
    "Passer-by" "Это что, всё по-настоящему?"

# ch/ayesha/petwalk.rpy:459
translate russian petwalk_ayesha_tummy_crowd_88c07efe:
    ayesha.say "Обеими руками, [lssb_ayesha.hero_name()]."

# ch/ayesha/petwalk.rpy:466
translate russian petwalk_ayesha_growl_alley_40205e31:
    "На середине переулка распахивается дверь. Оттуда выходит парень в кухонном фартуке с мешком мусора."

# ch/ayesha/petwalk.rpy:467
translate russian petwalk_ayesha_growl_alley_aacab5ce:
    "Он видит нас и останавливается."

# ch/ayesha/petwalk.rpy:468
translate russian petwalk_ayesha_growl_alley_e91a20d9:
    mike.say "Рычи."

# ch/ayesha/petwalk.rpy:469
translate russian petwalk_ayesha_growl_alley_aab4601d:
    "Аиша упирается лапами, опускает голову и глухо рычит на него из глубины груди."

# ch/ayesha/petwalk.rpy:470
translate russian petwalk_ayesha_growl_alley_40291b07:
    "Kitchen guy" "...ладно. Ладно. Я ничё не видел."

# ch/ayesha/petwalk.rpy:472
translate russian petwalk_ayesha_growl_alley_34da83f7:
    "Мешок летит в контейнер, и дверь за ним захлопывается."

# ch/ayesha/petwalk.rpy:473
translate russian petwalk_ayesha_growl_alley_58183fc1:
    ayesha.say "Ты видел его лицо, [lssb_ayesha.hero_name()]?"

# ch/ayesha/petwalk.rpy:474
translate russian petwalk_ayesha_growl_alley_07666f12:
    ayesha.say "Он реально испугался."

# ch/ayesha/petwalk.rpy:475
translate russian petwalk_ayesha_growl_alley_e4786d87:
    mike.say "Хорошая девочка."

# ch/ayesha/petwalk.rpy:477
translate russian petwalk_ayesha_growl_alley_e91a20d9_1:
    mike.say "Рычи."

# ch/ayesha/petwalk.rpy:478
translate russian petwalk_ayesha_growl_alley_00401738:
    "Аиша выбирает заднюю дверь рядом с мусорными баками и рычит на неё, пока свет за стеклом не гаснет."

# ch/ayesha/petwalk.rpy:479
translate russian petwalk_ayesha_growl_alley_4ed27578:
    ayesha.say "Вот так. Сиди там."

# ch/ayesha/petwalk.rpy:485
translate russian petwalk_ayesha_growl_street_8fe0406a:
    "У бордюра рядом с нами останавливается машина, и опускается окно."

# ch/ayesha/petwalk.rpy:486
translate russian petwalk_ayesha_growl_street_1d038f91:
    "Driver" "Эй, здоровячка! Чем он тебя кормит?"

# ch/ayesha/petwalk.rpy:487
translate russian petwalk_ayesha_growl_street_504ed7c2:
    "Опять этот тон. Я чувствую, как она начинает сжиматься."

# ch/ayesha/petwalk.rpy:488
translate russian petwalk_ayesha_growl_street_e91a20d9:
    mike.say "Рычи."

# ch/ayesha/petwalk.rpy:489
translate russian petwalk_ayesha_growl_street_ffc74184:
    "Её голова поднимается. Она разворачивается к машине и скалит зубы."

# ch/ayesha/petwalk.rpy:490
translate russian petwalk_ayesha_growl_street_6aa8368c:
    "Рычание, которое из неё вырывается, заставляет парня убрать руку обратно в салон."

# ch/ayesha/petwalk.rpy:491
translate russian petwalk_ayesha_growl_street_22848821:
    "Окно поднимается. Машина уезжает быстрее, чем подъехала."

# ch/ayesha/petwalk.rpy:492
translate russian petwalk_ayesha_growl_street_c8c6a886:
    ayesha.say "Я всю жизнь мечтала так сделать, [lssb_ayesha.hero_name()]."

# ch/ayesha/petwalk.rpy:494
translate russian petwalk_ayesha_growl_street_8389aab3:
    "Рядом с нами притормаживает машина. Прежде чем кто-нибудь внутри успевает открыть рот, я даю команду."

# ch/ayesha/petwalk.rpy:495
translate russian petwalk_ayesha_growl_street_e91a20d9_1:
    mike.say "Рычи."

# ch/ayesha/petwalk.rpy:496
translate russian petwalk_ayesha_growl_street_533ecc4e:
    "Аиша рычит на окно, низко и ровно, пока его снова не поднимают."

# ch/ayesha/petwalk.rpy:497
translate russian petwalk_ayesha_growl_street_a222e32c:
    ayesha.say "Козёл."

# ch/ayesha/petwalk.rpy:503
translate russian petwalk_ayesha_growl_crowd_302bea56:
    "Какой-то парень проталкивается в первый ряд толпы и тычет телефоном ей прямо в лицо."

# ch/ayesha/petwalk.rpy:504
translate russian petwalk_ayesha_growl_crowd_067609a8:
    "Phone guy" "Бро, пусть она что-нибудь сделает!"

# ch/ayesha/petwalk.rpy:505
translate russian petwalk_ayesha_growl_crowd_ecd6f4d9:
    "Аиша отшатывается, прижимаясь к моей ноге."

# ch/ayesha/petwalk.rpy:506
translate russian petwalk_ayesha_growl_crowd_a593320b:
    mike.say "Рычи, [ayesha.name]."

# ch/ayesha/petwalk.rpy:507
translate russian petwalk_ayesha_growl_crowd_7e30da88:
    "Она встаёт между мной и телефоном и выдаёт ему по полной — глубокое раскатистое рычание, которое я чувствую через поводок."

# ch/ayesha/petwalk.rpy:509
translate russian petwalk_ayesha_growl_crowd_20d691b5:
    "Он пятится, натыкаясь на людей позади. Толпа смеётся — на этот раз над ним."

# ch/ayesha/petwalk.rpy:510
translate russian petwalk_ayesha_growl_crowd_d48f6e92:
    "Woman" "Хорошая собака!"

# ch/ayesha/petwalk.rpy:511
translate russian petwalk_ayesha_growl_crowd_e2ff53ea:
    ayesha.say "Ещё бы."

# ch/ayesha/petwalk.rpy:513
translate russian petwalk_ayesha_growl_crowd_e91a20d9:
    mike.say "Рычи."

# ch/ayesha/petwalk.rpy:514
translate russian petwalk_ayesha_growl_crowd_b582708e:
    "Аиша рычит на первый ряд телефонов, и вся толпа отступает на шаг."

# ch/ayesha/petwalk.rpy:515
translate russian petwalk_ayesha_growl_crowd_739c91d7:
    "Passer-by" "Господи."

# ch/ayesha/petwalk.rpy:516
translate russian petwalk_ayesha_growl_crowd_7491e2a1:
    ayesha.say "Назад."

# ch/ayesha/petwalk.rpy:522
translate russian petwalk_ayesha_pee_alley_b8bbd692:
    "Аиша останавливается у мусорных баков и переминается, поглядывая на водосточную трубу."

# ch/ayesha/petwalk.rpy:523
translate russian petwalk_ayesha_pee_alley_8f0aaf3e:
    ayesha.say "[lssb_ayesha.hero_name()]... мне надо в туалет."

# ch/ayesha/petwalk.rpy:524
translate russian petwalk_ayesha_pee_alley_6dbb70e2:
    ayesha.say "Но прямо над нами горит свет."

# ch/ayesha/petwalk.rpy:525
translate russian petwalk_ayesha_pee_alley_7cfcd255:
    mike.say "Тогда делай это под светом."

# ch/ayesha/petwalk.rpy:527
