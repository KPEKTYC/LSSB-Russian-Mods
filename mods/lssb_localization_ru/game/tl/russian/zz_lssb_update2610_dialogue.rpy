translate russian cupid_palla_shawn_aftermath_f9e68de5:
    "Кофе идёт у меня не в то горло."

# dlc_cupid/ch/cupid/palla_shawn/aftermath.rpy:61
translate russian cupid_palla_shawn_aftermath_65a8831b:
