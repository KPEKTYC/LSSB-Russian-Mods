# ch/cassidy/events.rpy:1348
translate russian cassidy_birthday_date_male_f5989341:
    mike.say "Да, [bree.callname]..."

# ch/cassidy/events.rpy:1372
translate russian cassidy_birthday_date_male_f5989341_1:
