# dlc_cupid/ch/cupid/palla_shawn/aftermath.rpy:95
translate russian cupid_palla_shawn_aftermath_2e3164d4:
    shawn.say "Привет, [hero.name]."

# dlc_cupid/ch/cupid/palla_shawn/aftermath.rpy:97
translate russian cupid_palla_shawn_aftermath_124c01c2:
