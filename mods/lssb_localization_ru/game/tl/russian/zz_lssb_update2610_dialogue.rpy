# ch/cassidy/events.rpy:1779
translate russian cassidy_preg_talk_b97d0dc7:
    "Я едва успеваю поздороваться, как Кэссиди меня перебивает."

# ch/cassidy/events.rpy:1786
translate russian cassidy_preg_talk_4a8477dc:
