# dlc_cupid/ch/cupid/palla_shawn/aftermath.rpy:100
translate russian cupid_palla_shawn_aftermath_8fd99c89:
    shawn.say "Ты правда мне помогал? Типа, всё это время?"

# dlc_cupid/ch/cupid/palla_shawn/aftermath.rpy:102
translate russian cupid_palla_shawn_aftermath_2bebf08b:
    mike.say "Таков был план."

# dlc_cupid/ch/cupid/palla_shawn/aftermath.rpy:104
translate russian cupid_palla_shawn_aftermath_f87cfd89:
