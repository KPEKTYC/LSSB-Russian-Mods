# Lines new or changed in game 26.10.0. Native identifiers; translation only.

# ac/call_in_home.rpy:69
translate russian call_in_home_0cf51b23:
    minami.say "Да, [lssb_minami.hero_name()]?"

# ac/call_in_home.rpy:72
translate russian call_in_home_41c4ad11:
    mike.say "[samantha.callname], можешь подойти сюда?"

# ac/gift.rpy:55
translate russian give_a_gift_cca0dae3:
    active_girl.say "Это... слишком откровенно. На людях я такое не надену. По крайней мере, пока."

# ac/hangout.rpy:136
translate russian hangout_play_water_eccc38dc:
    "Мы плещемся в воде."

# ac/negotiate_house.rpy:60
translate russian negotiate_house_d649102a:
    minami.say "[lssb_minami.hero_name()], ты просишь меня соблазнить нашего домовладельца?"

# ac/negotiate_house.rpy:64
translate russian negotiate_house_0d001f61:
    minami.say "Ну ты и негодник, [lssb_minami.hero_name()]... Ладно! Предоставь его мне."

# ac/pets.rpy:255
translate russian walk_dog_cc067d78:
    "Стоит мне коснуться поводка, как пёс уже у двери и колотит хвостом по косяку."

# ac/pets.rpy:263
translate russian walk_dog_c890984a:
    "Улицы пусты, и он приветствует каждый фонарный столб, как старого друга."

# ac/pets.rpy:265
translate russian walk_dog_952c0b68:
    "Полпрогулки он уверен, что в каждой живой изгороди сидит белка. Её там нет."

# ac/pets.rpy:267
translate russian walk_dog_69ec6e3e:
    "Впереди дорогу перебегает лиса, и пёс, рванув за ней, чуть не отрывает мне руку."

# ac/pets.rpy:269
translate russian walk_dog_76c4a86e:
    "Мы делаем большой круг вокруг пруда — только мы вдвоём и тишина."

# ac/pets.rpy:270
translate russian walk_dog_dd9cb859:
    "Когда мы возвращаемся домой, он уже устал, а я спокоен, как ни разу за весь день."

# ac/pets.rpy:680
translate russian pet_capybara_a6e7f84d:
    "Он спит. Он всегда спит. Я устраиваюсь на полу рядом и почёсываю жёсткую шерсть у него на челюсти, пока он не заводит низкое скрипучее чириканье, так и не открыв глаз."

# ac/pets.rpy:681
translate russian pet_capybara_8d52cb06:
    "Минами клянётся, что этот звук он издаёт только для нас двоих. Проверить это я никак не могу, и проверять у меня нет ни малейшего желания."

# ac/pets.rpy:693
translate russian feed_capybara_810f690c:
    "Гранулы, пригоршня сена и половинка болгарского перца — потому что Минами настаивает, что к ужину ему положено лакомство, иначе он «из-за этого грустит»."

# ac/pets.rpy:694
translate russian feed_capybara_85c8c832:
    "Кроме меня, про перец в этом доме никто не помнит. Минами заметила, что я помню, и с тех пор не даёт мне об этом забыть."

# ac/pets.rpy:703
translate russian capybara_attack_0205cabd:
    "Самое невозмутимое животное на планете. Четыреста долларов безмятежного спокойствия. Но стоит мне подойти на расстояние вытянутой руки, как его уши прижимаются к черепу."

# ac/pets.rpy:704
translate russian capybara_attack_b5fd6d1e:
    mike.say "Нет. Нет, мы не будем этого делать. Ты кресло, которое ест сено."

# ac/pets.rpy:705
translate russian capybara_attack_ee658b11:
    "Он поднимается с пола одним плавным движением, и оказывается, что кресло на ножках способно двигаться с совершенно неприличной скоростью."

# ac/pets.rpy:711
translate russian capybara_attack_9ede39fe:
    "Он врезается мне в колени, как при низком подкате, опрокидывает меня на спину, а потом без малейшей спешки вонзает мне в бедро пару оранжевых резцов размером с клавиши пианино."

# ac/pets.rpy:712
translate russian capybara_attack_cfb19003:
    mike.say "А-а-а! Слезь! Слезь с меня, ты, здоровенный —"

# ac/pets.rpy:713
translate russian capybara_attack_6a3e6493:
    "Когда он наконец неспешно удаляется, я истекаю кровью на ковре, а он снова жуёт своё сено, будто последние тридцать секунд его совершенно не касались."

# ac/pets.rpy:720
translate russian capybara_night_0146e8d4:
    "Что-то грызёт. Не покусывает. Грызёт — всерьёз, с усилием, в пятнадцати сантиметрах от моей головы, по ту сторону двери спальни."

# ac/pets.rpy:721
translate russian capybara_night_796ac341:
    mike.say "...Да ты издеваешься."

# ac/pets.rpy:722
translate russian capybara_night_11107683:
    "Где-то среди ночи он решил, что дверной косяк — это еда. Он обрабатывает его долгими терпеливыми движениями, и каждый раз, когда я колочу в дверь, он затихает ровно настолько, чтобы я успел снова лечь."

# ac/pets.rpy:723
translate russian capybara_night_34ac48d7:
    "А потом начинает снова. И так до тех пор, пока окно не сереет, а к тому времени уже нет смысла делать вид, что мне удастся хоть немного поспать."

# ac/pets.rpy:729
translate russian capybara_morning_a83d539b:
    "Пол в ванной залит водой на пару сантиметров, и цепочка мокрых растопыренных следов ведёт оттуда дальше по коридору."

# ac/pets.rpy:730
translate russian capybara_morning_37834ced:
    mike.say "Как. Как грызун умудряется открыть кран."

# ac/pets.rpy:731
translate russian capybara_morning_5bbb7f70:
    "Ночью он забрался в ванну, напустил воды, сколько позволила пробка, и сидел в ней, пока она не остыла. Вместе с ним туда отправились два полотенца, вчерашняя рубашка и один мой ботинок."

# ac/pets.rpy:733
translate russian capybara_morning_862765f7:
    "Он наблюдает из дверного проёма, как я выжимаю носок, тихонько почирикивая себе под нос, в полном ладу с утром, которое он мне устроил."

# ac/pets.rpy:743
translate russian pet_bunny_dd17cd3a:
    "Кролики не приходят, когда их зовут, так что весь фокус в том, чтобы сесть на пол и смириться с поражением. Минут через десять она подсовывает голову мне под ладонь и требует, чтобы её пригладили между ушами."

# ac/pets.rpy:744
translate russian pet_bunny_971d66ec:
    "Саманта говорит, что та даётся в руки только тем, насчёт кого уже всё для себя решила. Говорит так, будто ставит точку в споре, о котором я даже не подозревал."

# ac/pets.rpy:756
translate russian feed_bunny_a2a392d8:
    "Свежее сено в кормушке, совок гранул, горсть зелени — и она уже стоит на задних лапах, упираясь в прутья, прежде чем миска опустится хотя бы до середины."

# ac/pets.rpy:757
translate russian feed_bunny_49b5c316:
    "Саманта проверяет эту кормушку каждый вечер, ни разу не признаваясь, что проверяет. В последнее время она всё чаще находит её уже полной."

# ac/pets.rpy:768
translate russian bunny_attack_18ef0265:
    "Никто не предупреждает, что кролики рычат. Я и не знал, что у них такое есть в комплектации. Именно этим она сейчас и занимается из-под стола: низко, ровно и без единой паузы."

# ac/pets.rpy:769
translate russian bunny_attack_60bb5c3a:
    mike.say "Это кролик. Два килограмма кролика. Я взрослый мужик."

# ac/pets.rpy:770
translate russian bunny_attack_1e615e6d:
    "Она выходит боком, встав на задние лапы и молотя передними воздух перед моей рукой."

# ac/pets.rpy:776
translate russian bunny_attack_e5af60af:
    "Укус приходится прямо в перепонку у большого пальца, и пока я выясняю, насколько это больно, в ход идут задние лапы и оставляют у меня на предплечье три длинные борозды."

# ac/pets.rpy:777
translate russian bunny_attack_ee59ce30:
    mike.say "Ай — ай — ах ты, мелкое чудовище!"

# ac/pets.rpy:778
translate russian bunny_attack_7c2dde4c:
    "Она скрывается под столом раньше, чем я заканчиваю ругаться, и умывает уши, одержав безоговорочную победу."

# ac/pets.rpy:815
translate russian bunny_night_dee28ac7:
    "БУМ."

# ac/pets.rpy:816
translate russian bunny_night_d671aeed:
    "Обеими задними лапами, со всей силы, по половицам прямо под моей кроватью. Так кролики предупреждают нору, что рядом хищник. Хищника нет. Есть только я, спящий, и, судя по всему, для неё это достаточно близко."

# ac/pets.rpy:817
translate russian bunny_night_f5a123a1:
    mike.say "...Спи. Пожалуйста, просто спи."

# ac/pets.rpy:818
translate russian bunny_night_dee28ac7_1:
    "БУМ."

# ac/pets.rpy:819
translate russian bunny_night_33b5513e:
    "Она делает это каждые одиннадцать минут. Я знаю, что именно каждые одиннадцать, потому что где-то после трёх начал засекать время, и в этот момент ночь была окончательно потеряна."

# ac/pets.rpy:825
translate russian bunny_morning_bdf63c94:
    "Моя зарядка разорвана на четыре части. Провод наушников — на две. Нижних двадцати сантиметров шторы просто больше нет."

# ac/pets.rpy:826
translate russian bunny_morning_8e8b0f35:
    mike.say "Ох, а ты времени зря не теряла."

# ac/pets.rpy:827
translate russian bunny_morning_d46d2976:
    "А в каждом моём ботинке — разложенная, иначе не скажешь, с любовью — аккуратная кучка помёта. Она не обделила ни один ботинок. Поровну."

# ac/pets.rpy:829
translate russian bunny_morning_9035af58:
    "Она сидит посреди разгрома, умывая мордочку, и ни разу не поднимает глаз, пока я всё убираю."

# ac/pets.rpy:839
translate russian pet_turtle_77cdb708:
    "Черепаху не столько гладят, сколько на неё опираются. Я кладу ладонь на гребень его панциря, прямо там, где сходятся щитки, и чешу, и через какое-то время он вытягивает свою древнюю шею во всю длину и закрывает глаза."

# ac/pets.rpy:840
translate russian pet_turtle_c5886392:
    "Лекси разобралась в этом на несколько недель раньше меня. Она никогда ничего не объясняет дважды, так что мне пришлось наблюдать за ней и повторять."

# ac/pets.rpy:852
translate russian feed_turtle_4a6e1745:
    "Охапка сена, два целых кочана ромэна и ведро сорняков с заднего газона — и он перемалывает всё это, как газонокосилка с собственным мнением."

# ac/pets.rpy:853
translate russian feed_turtle_ae376924:
    "Лекси говорит, что кормить его — единственная часть её дня, которая всегда идёт так, как надо. Она не шутила, и именно это не выходит у меня из головы."

# ac/pets.rpy:861
translate russian turtle_attack_6e586371:
    "Он развернулся ко мне мордой — и разворачивался уже где-то полторы минуты. Семьдесят килограммов бронированного терпения, которому совершенно некуда спешить."

# ac/pets.rpy:862
translate russian turtle_attack_3db2ec8a:
    mike.say "Ты ведь даже не быстрый. И какой у тебя план?"

# ac/pets.rpy:863
translate russian turtle_attack_5270d6c7:
    "Плану не нужна скорость. Плану нужна тяжесть, а он тяжёлый."

# ac/pets.rpy:869
translate russian turtle_attack_bd4b0a7e:
    "Он прёт вперёд мне в голени, как тачка, гружённая кирпичами, выбивает у меня почву из-под ног, и я с размаху падаю на край его панциря."

# ac/pets.rpy:870
translate russian turtle_attack_64d650a9:
    "Затем голова без малейшей спешки разворачивается, и клюв смыкается на моей икре с тупой сокрушительной силой существа, созданного перекусывать дерево."

# ac/pets.rpy:871
translate russian turtle_attack_2820c667:
    mike.say "А-а-а! Отпусти! Отпусти меня, бронированная ты сволочь —"

# ac/pets.rpy:872
translate russian turtle_attack_8199f774:
    "Он разжимает челюсти полминуты спустя, по собственному графику, и продолжает путь, начатый ещё до того, как я встал у него на дороге."

# ac/pets.rpy:879
translate russian turtle_night_dd62a8a1:
    "Медленный скрежет проползает вдоль всей стены коридора. Потом пауза. Потом глухой деревянный удар в низ двери спальни."

# ac/pets.rpy:880
translate russian turtle_night_2128f954:
    mike.say "...Тебе не войти. Мы это уже обсуждали."

# ac/pets.rpy:881
translate russian turtle_night_34ea87cb:
    "И правда не войти. Он в полтора раза шире дверного проёма, но это ни разу не помешало ему пытаться. Семьдесят килограммов черепахи, налегающие на дверь, — этот звук чувствуешь через пол."

# ac/pets.rpy:882
translate russian turtle_night_b16d33c2:
    "Скрежет. Удар. Пауза. Скрежет. Он трудится всю ночь с терпением существа, которое рассчитывает быть здесь и через семьдесят лет, и где-то около четырёх я перестаю притворяться, что пересижу его."

# ac/pets.rpy:888
translate russian turtle_morning_63d5b5c8:
    "Кухня выглядит так, будто через неё проехала маленькая машина со скоростью пешехода. Два стула опрокинуты, мусорное ведро лежит на боку, а прямо через середину разгрома пропахана широкая чистая колея."

# ac/pets.rpy:889
translate russian turtle_morning_5738d0b5:
    mike.say "Ох, ты что, серьёзно?"

# ac/pets.rpy:890
translate russian turtle_morning_d08ac2dc:
    "Всю ночь он пересекал дом из конца в конец по идеально прямой линии, и всё, что стояло у него на пути, больше на пути не стоит."

# ac/pets.rpy:891
translate russian turtle_morning_b914109e:
    "Остальные его ночные подвиги я нахожу босыми ногами, дважды, ещё прежде чем добираюсь до выключателя."

# ac/pets.rpy:893
translate russian turtle_morning_648242bf:
    "Он упёрся в дальнюю стену и всё ещё перебирает лапами, совершенно уверенный, что рано или поздно стена поддастся. Если дать ему достаточно времени, я не уверен, что он ошибается."

# bg/ceo/ceo.rpy:1319
translate russian meeting_aletta_cherie_01_male_395f05b2:
    cherie.say "Я знаю его ещё с тех времён, когда он не был Джулианом Хэвлоком, так что ужинать с ним пойду я."

# bg/ceo/ceo.rpy:2465
translate russian meeting_cherie_05_male_53f1db8f:
    cherie.say "Буду откровенной и скучной — очень недооценённое сочетание."

# bg/ceo/ceo.rpy:3360
translate russian meeting_cassidy_05_male_3d5c55ed:
    cassidy.say "Ты... ты серьёзно?"

# bg/drugstore/drugstore.rpy:197
translate russian heart_attack_1c2d2634:
    "Моя улыбка на мгновение исчезает, а шаг сбивается, когда в груди что-то покалывает."

# bg/drugstore/drugstore.rpy:202
translate russian heart_attack_1e5c2869:
    "Но через несколько секунд грудь покалывает снова."

# bg/drugstore/drugstore.rpy:207
translate russian heart_attack_eaf76d8e:
    "Я хватаюсь рукой за грудь, когда меня пронзает новый приступ, а затем ещё один."

# bg/hospital/hospital.rpy:151
translate russian contraceptive_implant_fit_male_ff82127f:
    "Презервативы рвутся, и мне не хотелось бы узнать это на собственном горьком опыте."

# bg/hospital/hospital.rpy:152
translate russian contraceptive_implant_fit_male_4febe846:
    "Поэтому я спрашиваю в регистратуре о мужском контрацептивном импланте."

# bg/hospital/hospital.rpy:153
translate russian contraceptive_implant_fit_male_b81e4d7a:
    "Receptionist" "Конечно. Доктор может принять вас прямо сейчас."

# bg/hospital/hospital.rpy:154
translate russian contraceptive_implant_fit_male_b53ab98c:
    "Doctor" "Это гель, который вводят в семявыводящие протоки. Он блокирует их, пока остаётся там."

# bg/hospital/hospital.rpy:155
translate russian contraceptive_implant_fit_male_ea3d96da:
    "Doctor" "А если когда-нибудь захотите детей, его растворит вторая инъекция."

# bg/hospital/hospital.rpy:156
translate russian contraceptive_implant_fit_male_53564c7d:
    mike.say "И это не больно?"

# bg/hospital/hospital.rpy:157
translate russian contraceptive_implant_fit_male_7486b327:
    "Doctor" "Местная анестезия, лёгкое давление — и готово."

# bg/hospital/hospital.rpy:159
translate russian contraceptive_implant_fit_male_a29be9b6:
    "Он прав. Всё занимает несколько минут, и всё это время я смотрю в потолок."

# bg/hospital/hospital.rpy:161
translate russian contraceptive_implant_fit_male_86c8dad4:
    "Выхожу я слегка враскорячку. Зато теперь порвавшийся презерватив не обернётся ребёнком."

# bg/hospital/hospital.rpy:166
translate russian contraceptive_implant_remove_male_1ccf8acd:
    "Я снова в больнице — пришёл растворить имплант."

# bg/hospital/hospital.rpy:167
translate russian contraceptive_implant_remove_male_e87a9b61:
    "Doctor" "Передумали? Так делают многие мужчины."

# bg/hospital/hospital.rpy:168
translate russian contraceptive_implant_remove_male_0eeb10db:
    "Doctor" "Просто чтобы вы знали: фертильность вернётся почти сразу."

# bg/hospital/hospital.rpy:169
translate russian contraceptive_implant_remove_male_92f0d7bb:
    mike.say "Я понимаю."

# bg/hospital/hospital.rpy:171
translate russian contraceptive_implant_remove_male_edc2d3fd:
    "Он делает мне ещё одну инъекцию, и я провожу ещё несколько минут, глядя в потолок."

# bg/hospital/hospital.rpy:173
translate russian contraceptive_implant_remove_male_cf967ac7:
    "Я снова фертилен, так что если хочу подстраховаться — опять презервативы."

# bg/maidcafe/maidcafe.rpy:151
translate russian maidcafe_order_c60a55a8:
    mike.say "Спасибо, [bree.callname]."

# bg/secondfloor/secondfloor.rpy:211
translate russian vacuum_bree_sleep_male_2b322ec5:
    mike.say "О... привет, [bree.callname]."

# bg/secondfloor/secondfloor.rpy:220
translate russian vacuum_bree_sleep_male_b4e076ae:
    mike.say "Прости, [bree.callname]."

# bg/secondfloor/secondfloor.rpy:236
translate russian vacuum_bree_sleep_male_6744063a:
