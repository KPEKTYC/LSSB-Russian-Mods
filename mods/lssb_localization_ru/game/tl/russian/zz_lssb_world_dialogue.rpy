# Native World identifiers, current source catalog. Translation only.

# bg/ceo/ceo.rpy:104
translate russian boardroom_meeting_9540b3a1:
    "Похоже, сегодня в офисе мало народу. Наверное, взяли выходной или что-то в этом роде."

# bg/ceo/ceo.rpy:154
translate russian meeting_aletta_01_male_98a2e63c:
    "Полгода назад главным событием моего рабочего дня было узнать, что торговый автомат снова заполнили."

# bg/ceo/ceo.rpy:155
translate russian meeting_aletta_01_male_650720f8:
    "Теперь табличка на двери моего кабинета ощущается мишенью прямо посреди лба."

# bg/ceo/ceo.rpy:159
translate russian meeting_aletta_01_male_4d2af714:
    aletta.say "[lssb_common.hero_name()], «Кесслер» пересмотрели цены по рамочному договору."

# bg/ceo/ceo.rpy:160
translate russian meeting_aletta_01_male_a88c5d12:
    aletta.say "На сорок процентов! С конца месяца!"

# bg/ceo/ceo.rpy:162
translate russian meeting_aletta_01_male_27f51311:
    aletta.say "Они знают, что меньше чем за квартал мы не переналадим производство под другого поставщика. Потому и выбрали такой срок."

# bg/ceo/ceo.rpy:164
translate russian meeting_aletta_01_male_4acdba4d:
    "Алетте приходится перевести дух, и сопровождающий её человек впервые получает возможность вставить слово."

# bg/ceo/ceo.rpy:167
translate russian meeting_aletta_01_male_638a857f:
    "Артур" "Именно поэтому мы ничего не предпринимаем, мистер [hero.family_name]."

# bg/ceo/ceo.rpy:168
translate russian meeting_aletta_01_male_16cf980c:
    "Артур" "В этом договоре есть арбитражная оговорка. И весьма хорошая."

# bg/ceo/ceo.rpy:169
translate russian meeting_aletta_01_male_a8eeefe1:
    "Артур" "Уж я-то знаю: сам её составлял!"

# bg/ceo/ceo.rpy:170
translate russian meeting_aletta_01_male_1ea31c6b:
    "Я несколько секунд прищурившись смотрю на другого мужчину, пытаясь вспомнить, кто он."

# bg/ceo/ceo.rpy:171
translate russian meeting_aletta_01_male_cedb10d6:
    "Артур... Артур Макраклур, вот как его зовут. Ещё один местный важный костюм, которому нравится слушать собственный голос."

# bg/ceo/ceo.rpy:172
translate russian meeting_aletta_01_male_35062fad:
    "Артур" "Отклоняем повышение, подаём иск и предоставляем им объясняться перед арбитражем."

# bg/ceo/ceo.rpy:173
translate russian meeting_aletta_01_male_6f8fc700:
    "Артур" "Осторожность и трусость — разные вещи."

# bg/ceo/ceo.rpy:175
translate russian meeting_aletta_01_male_7d49975f:
    "Как обычно, доводы Артура звучат совершенно логично. Пока Алетта не поворачивается и, образно говоря, не впивается в них зубами."

# bg/ceo/ceo.rpy:177
translate russian meeting_aletta_01_male_18c968f9:
    aletta.say "Артур, арбитраж в подобных делах обычно занимает четырнадцать месяцев."

# bg/ceo/ceo.rpy:178
translate russian meeting_aletta_01_male_519eaa63:
    aletta.say "А линия встанет через пять недель!"

# bg/ceo/ceo.rpy:180
translate russian meeting_aletta_01_male_59cc1465:
    aletta.say "Надо платить по повышенной цене девяносто дней. Мне как раз хватит, чтобы одобрить «Ренвик» в качестве второго поставщика."

# bg/ceo/ceo.rpy:181
translate russian meeting_aletta_01_male_4055a4dd:
    aletta.say "И тогда нам больше никогда не придётся вести этот разговор."

# bg/ceo/ceo.rpy:184
translate russian meeting_aletta_01_male_cd157e2a:
    "Артур" "Девяносто дней платить человеку за то, что он вас грабит, юная леди, — это не стратегия, а начало весьма дурной привычки."

# bg/ceo/ceo.rpy:187
translate russian meeting_aletta_01_male_96fb6b73:
    "Два человека, два решения, и оба смотрят на меня, ожидая, что я встану на их сторону."

# bg/ceo/ceo.rpy:190
translate russian meeting_aletta_01_male_a8a3ac68:
    "Если всё взвесить, план Алетты кажется самым простым решением."

# bg/ceo/ceo.rpy:191
translate russian meeting_aletta_01_male_254f16c0:
    mike.say "Будем платить."

# bg/ceo/ceo.rpy:192
translate russian meeting_aletta_01_male_1485f7ff:
    mike.say "Девяносто дней. Ни днём больше."

# bg/ceo/ceo.rpy:193
translate russian meeting_aletta_01_male_5c6e332a:
    mike.say "Алетта, добейся одобрения «Ренвик» как можно скорее."

# bg/ceo/ceo.rpy:195
translate russian meeting_aletta_01_male_75c8d4d6:
    aletta.say "Уже начала."

# bg/ceo/ceo.rpy:197
translate russian meeting_aletta_01_male_a26ba6fd:
    aletta.say "Отправила им наши технические требования, как только увидела новые цены."

# bg/ceo/ceo.rpy:199
translate russian meeting_aletta_01_male_651d978f:
    "Ну разумеется."

# bg/ceo/ceo.rpy:202
translate russian meeting_aletta_01_male_fa0d8ac3:
    "Артур" "Позвольте зафиксировать..."

# bg/ceo/ceo.rpy:203
translate russian meeting_aletta_01_male_aa7144e3:
    "Артур" "Я считаю это дорогостоящей ошибкой."

# bg/ceo/ceo.rpy:204
translate russian meeting_aletta_01_male_6d27ae14:
    mike.say "Ваше мнение учтено, Артур."

# bg/ceo/ceo.rpy:206
translate russian meeting_aletta_01_male_e070704a:
    "Артур на мгновение умолкает, словно ожидая от меня продолжения."

# bg/ceo/ceo.rpy:207
translate russian meeting_aletta_01_male_fe007b7b:
    "Но я молчу, и ему остаётся лишь кивнуть."

# bg/ceo/ceo.rpy:209
translate russian meeting_aletta_01_male_82b13035:
    "Артур" "Хорошо..."

# bg/ceo/ceo.rpy:210
translate russian meeting_aletta_01_male_23a28252:
    "Артур" "Подготовлю дополнительное соглашение, пока вы не передумали."

# bg/ceo/ceo.rpy:212
translate russian meeting_aletta_01_male_08594e0b:
    "Он удаляется с такой скоростью, словно хочет, чтобы все непременно заметили его уход."

# bg/ceo/ceo.rpy:213
translate russian meeting_aletta_01_male_5360d327:
    "Резко разворачивается и без лишних слов выходит из моего кабинета."

# bg/ceo/ceo.rpy:217
translate russian meeting_aletta_01_male_bc6353cf:
    "По-моему, это как раз тот случай, когда нужно твёрдо стоять на своём."

# bg/ceo/ceo.rpy:219
translate russian meeting_aletta_01_male_18a23874:
    mike.say "Мы не будем платить больше, Алетта..."

# bg/ceo/ceo.rpy:220
translate russian meeting_aletta_01_male_2ef5a6d4:
    mike.say "Поэтому подавай иск в арбитраж."

# bg/ceo/ceo.rpy:221
translate russian meeting_aletta_01_male_5272d3b6:
    "Разумеется, Артур тут же согласно кивает."

# bg/ceo/ceo.rpy:224
translate russian meeting_aletta_01_male_56b763ce:
    "Артур" "Разумное решение."

# bg/ceo/ceo.rpy:225
translate russian meeting_aletta_01_male_4d49adb3:
    "Артур" "Договор чего-то стоит лишь тогда, когда другая сторона верит, что вы готовы им воспользоваться."

# bg/ceo/ceo.rpy:228
translate russian meeting_aletta_01_male_68637b21:
    "А вот Алетта моему решению явно рада гораздо меньше."

# bg/ceo/ceo.rpy:230
translate russian meeting_aletta_01_male_194c5a56:
    aletta.say "И за счёт чего мне тем временем поддерживать работу линии?"

# bg/ceo/ceo.rpy:231
translate russian meeting_aletta_01_male_c9d8644c:
    aletta.say "Формальной правоты?"

# bg/ceo/ceo.rpy:232
translate russian meeting_aletta_01_male_9d8664c2:
    aletta.say "Морального превосходства?!"

# bg/ceo/ceo.rpy:234
translate russian meeting_aletta_01_male_07bd35ee:
    mike.say "Алетта, прошу!"

# bg/ceo/ceo.rpy:236
translate russian meeting_aletta_01_male_ee4e6a61:
    aletta.say "Нет..."

# bg/ceo/ceo.rpy:237
translate russian meeting_aletta_01_male_0349b2c3:
    aletta.say "Ты начальник, ты и принял решение."

# bg/ceo/ceo.rpy:238
translate russian meeting_aletta_01_male_7217f183:
    aletta.say "Теперь большое кресло твоё."

# bg/ceo/ceo.rpy:240
translate russian meeting_aletta_01_male_bfd64806:
    aletta.say "Но когда линия встанет, не делай удивлённое лицо."

# bg/ceo/ceo.rpy:242
translate russian meeting_aletta_01_male_025572dd:
    "Я ожидаю, что на выходе Алетта хлопнет дверью."

# bg/ceo/ceo.rpy:244
translate russian meeting_aletta_01_male_417e09aa:
    "Но вместо этого она тихо и спокойно уходит, прикрыв её за собой."

# bg/ceo/ceo.rpy:245
translate russian meeting_aletta_01_male_c2d81332:
    "И почему-то от этого только хуже."

# bg/ceo/ceo.rpy:256
translate russian result_meeting_aletta_01_male_d7cf5b0b:
    "Алетта решительно подходит к моему столу и бросает на него один лист бумаги."

# bg/ceo/ceo.rpy:257
translate russian result_meeting_aletta_01_male_6aac94d0:
    "Затем отступает и скрещивает руки на груди, пока я его изучаю."

# bg/ceo/ceo.rpy:259
translate russian result_meeting_aletta_01_male_bd5b4a50:
    aletta.say "«Ренвик» предложили цену на одиннадцать процентов ниже, чем у «Кесслер»."

# bg/ceo/ceo.rpy:260
translate russian result_meeting_aletta_01_male_76e8d7b7:
    aletta.say "Ниже старой цены, а не новой."

# bg/ceo/ceo.rpy:262
translate russian result_meeting_aletta_01_male_c95453ac:
    aletta.say "И «Кесслер» об этом тоже узнали."

# bg/ceo/ceo.rpy:264
translate russian result_meeting_aletta_01_male_154d7ca3:
    aletta.say "Повышение отменено, и теперь они хотят досрочно пересмотреть рамочный договор."

# bg/ceo/ceo.rpy:266
translate russian result_meeting_aletta_01_male_6ccc1327:
    "Я поднимаю взгляд на Алетту, начиная понимать ситуацию."

# bg/ceo/ceo.rpy:267
translate russian result_meeting_aletta_01_male_a4ad07a4:
    mike.say "То есть теперь мы платим меньше, чем до начала всей этой истории?"

# bg/ceo/ceo.rpy:269
translate russian result_meeting_aletta_01_male_ed9238bf:
    aletta.say "Именно, [lssb_common.hero_name()]..."

# bg/ceo/ceo.rpy:271
translate russian result_meeting_aletta_01_male_479c694d:
    aletta.say "И теперь они знают, что мы можем уйти. А это стоит гораздо больше денег."

# bg/ceo/ceo.rpy:273
translate russian result_meeting_aletta_01_male_e132e49a:
    "Я замечаю Артура, который топчется у открытой двери кабинета."

# bg/ceo/ceo.rpy:274
translate russian result_meeting_aletta_01_male_d95fa459:
    "Наверняка он слышал каждое наше слово."

# bg/ceo/ceo.rpy:275
translate russian result_meeting_aletta_01_male_38c925b5:
    "Он бормочет что-то вроде «новичкам везёт» и торопливо уходит."

# bg/ceo/ceo.rpy:276
translate russian result_meeting_aletta_01_male_787588e1:
    "Но я склонен считать это большим успехом."

# bg/ceo/ceo.rpy:279
translate russian result_meeting_aletta_01_male_d7cf5b0b_1:
    "Алетта решительно подходит к моему столу и бросает на него один лист бумаги."

# bg/ceo/ceo.rpy:280
translate russian result_meeting_aletta_01_male_6aac94d0_1:
    "Затем отступает и скрещивает руки на груди, пока я его изучаю."

# bg/ceo/ceo.rpy:282
translate russian result_meeting_aletta_01_male_e58670df:
    aletta.say "Иск в арбитраж подан, как ты и хотел."

# bg/ceo/ceo.rpy:283
translate russian result_meeting_aletta_01_male_8aef0263:
    aletta.say "«Кесслер» ответили почти сразу."

# bg/ceo/ceo.rpy:285
translate russian result_meeting_aletta_01_male_8f602fc3:
    mike.say "И?"

# bg/ceo/ceo.rpy:287
translate russian result_meeting_aletta_01_male_f22e4c0a:
    aletta.say "Они прекратили поставки!"

# bg/ceo/ceo.rpy:289
translate russian result_meeting_aletta_01_male_48d65fd0:
    aletta.say "Запасов на шесть дней, [lssb_common.hero_name()]..."

# bg/ceo/ceo.rpy:290
translate russian result_meeting_aletta_01_male_97c29b9b:
    aletta.say "Вот что осталось. Всего шесть!"

# bg/ceo/ceo.rpy:292
translate russian result_meeting_aletta_01_male_18b70686:
    aletta.say "У меня люди стоят у линии, на которую нечего подавать."

# bg/ceo/ceo.rpy:293
translate russian result_meeting_aletta_01_male_da22dee7:
    aletta.say "Мне придётся отправить их домой!"

# bg/ceo/ceo.rpy:297
translate russian result_meeting_aletta_01_male_dbd29c63:
    "Артур покашливает и изо всех сил делает вид, что совершенно не обеспокоен."

# bg/ceo/ceo.rpy:299
translate russian result_meeting_aletta_01_male_b376d51e:
    "Артур" "Арбитраж решит дело в нашу пользу..."

# bg/ceo/ceo.rpy:300
translate russian result_meeting_aletta_01_male_ed8a3211:
    "Артур" "В своё время."

# bg/ceo/ceo.rpy:302
translate russian result_meeting_aletta_01_male_b07d7517:
    mike.say "Артур, сколько это — «в своё время»?"

# bg/ceo/ceo.rpy:304
translate russian result_meeting_aletta_01_male_05955556:
    "Артур" "В лучшем случае от одиннадцати до шестнадцати месяцев."

# bg/ceo/ceo.rpy:305
translate russian result_meeting_aletta_01_male_ad1b2a0d:
    "Артур" "Такие дела не терпят спешки."

# bg/ceo/ceo.rpy:307
translate russian result_meeting_aletta_01_male_0cf02c87:
    "Я смотрю на число на доске и пытаюсь подсчитать, сколько месяцев компания может прожить, ничего не производя."

# bg/ceo/ceo.rpy:308
translate russian result_meeting_aletta_01_male_107b32c0:
    "Определённо не шестнадцать."

# bg/ceo/ceo.rpy:320
translate russian meeting_aletta_02_male_6edd4621:
    "Алетта на этот раз особенно напориста и следит за тем, чтобы я слушал внимательно."

# bg/ceo/ceo.rpy:322
translate russian meeting_aletta_02_male_9908911c:
    aletta.say "«Хэллоран» дали устное согласие."

# bg/ceo/ceo.rpy:323
translate russian meeting_aletta_02_male_555597ff:
    aletta.say "Восемьсот тысяч..."

# bg/ceo/ceo.rpy:324
translate russian meeting_aletta_02_male_8667a93c:
    aletta.say "Контракт на двенадцать месяцев..."

# bg/ceo/ceo.rpy:325
translate russian meeting_aletta_02_male_021fa06f:
    aletta.say "И они хотят видеть нас на объекте уже в течение недели."

# bg/ceo/ceo.rpy:327
translate russian meeting_aletta_02_male_fad18c1c:
    "Я послушно киваю, показывая Алетте, что слушаю."

# bg/ceo/ceo.rpy:329
translate russian meeting_aletta_02_male_dc31d4df:
    aletta.say "Их отделу закупок понадобится три недели, чтобы подготовить документы."

# bg/ceo/ceo.rpy:330
translate russian meeting_aletta_02_male_e7470f1e:
    aletta.say "Проблема в том, что трёх недель у нас нет."

# bg/ceo/ceo.rpy:331
translate russian meeting_aletta_02_male_c876f81c:
    aletta.say "Их прежний подрядчик уйдёт через несколько дней."

# bg/ceo/ceo.rpy:333
translate russian meeting_aletta_02_male_6da4a753:
    "Артур выбирает именно этот момент, чтобы вмешаться своим обычным сухим, пренебрежительным тоном."

# bg/ceo/ceo.rpy:335
translate russian meeting_aletta_02_male_cbd97b84:
    "Артур" "Значит, прежний подрядчик — их проблема, а не наша."

# bg/ceo/ceo.rpy:336
translate russian meeting_aletta_02_male_eb8ebab8:
    "Артур" "Я, между прочим, прочитал проект договора."

# bg/ceo/ceo.rpy:337
translate russian meeting_aletta_02_male_2779cb8f:
    "Артур" "Предмет договора описан крайне расплывчато, а возмещение убытков предусмотрено только в одну сторону. В их пользу, разумеется."

# bg/ceo/ceo.rpy:339
translate russian meeting_aletta_02_male_95ebe1cb:
    "Алетта поворачивается к Артуру, уперев сжатые кулаки в бока."

# bg/ceo/ceo.rpy:341
translate russian meeting_aletta_02_male_da69067d:
    aletta.say "Артур, это самый крупный клиент, которого мы заполучили за... за всё время!"

# bg/ceo/ceo.rpy:343
translate russian meeting_aletta_02_male_17f56564:
    aletta.say "Если скажем ждать, они найдут того, кто начнёт сразу."

# bg/ceo/ceo.rpy:345
translate russian meeting_aletta_02_male_a8027c55:
    "Артур качает головой, отмахиваясь от опасений Алетты."

# bg/ceo/ceo.rpy:347
translate russian meeting_aletta_02_male_a947f93f:
    "Артур" "За тридцать один год я видел немало компаний, которые работали под честное слово, мистер [hero.family_name]..."

# bg/ceo/ceo.rpy:348
translate russian meeting_aletta_02_male_5c2f05ef:
    "Артур" "И видел, как многие из них потом пытались получить оплату."

# bg/ceo/ceo.rpy:350
translate russian meeting_aletta_02_male_a3f8be52:
    "Алетта скрещивает руки и сверлит его взглядом. А у Артура такой вид, словно он уже пишет служебную записку о том, что предупреждал меня."

# bg/ceo/ceo.rpy:353
translate russian meeting_aletta_02_male_6a98f64b:
    "Я демонстративно киваю Алетте."

# bg/ceo/ceo.rpy:354
translate russian meeting_aletta_02_male_e4a0918f:
    mike.say "Отправляй людей на объект."

# bg/ceo/ceo.rpy:355
translate russian meeting_aletta_02_male_1d38c759:
    mike.say "Артур, параллельно продолжайте работу над документами."

# bg/ceo/ceo.rpy:357
translate russian meeting_aletta_02_male_c583ac70:
    "Настроение Алетты мгновенно улучшается."

# bg/ceo/ceo.rpy:359
translate russian meeting_aletta_02_male_9a26bac7:
    aletta.say "Спасибо."

# bg/ceo/ceo.rpy:361
translate russian meeting_aletta_02_male_7a3797bb:
    aletta.say "К восьми на объекте будут четверо."

# bg/ceo/ceo.rpy:364
translate russian meeting_aletta_02_male_ac07dd62:
    "А вот Артур, разумеется, доволен куда меньше."

# bg/ceo/ceo.rpy:366
translate russian meeting_aletta_02_male_6a927bc5:
    "Артур" "Прошу внести в протокол, что я рекомендовал этого не делать."

# bg/ceo/ceo.rpy:367
translate russian meeting_aletta_02_male_489cc884:
    mike.say "Вы всегда просите внести в протокол, что рекомендовали этого не делать."

# bg/ceo/ceo.rpy:368
translate russian meeting_aletta_02_male_3fa096dc:
    "Артур" "И однажды, мистер [hero.family_name]..."

# bg/ceo/ceo.rpy:369
translate russian meeting_aletta_02_male_4345c9a8:
    "Артур" "Вы прочитаете протокол и поймёте почему."

# bg/ceo/ceo.rpy:372
translate russian meeting_aletta_02_male_76483a41:
    "Алетта начинает говорить по телефону, ещё не дойдя до двери."

# bg/ceo/ceo.rpy:373
translate russian meeting_aletta_02_male_f42f0d7a:
    "Вот за это ею нельзя не восхищаться."

# bg/ceo/ceo.rpy:374
translate russian meeting_aletta_02_male_97707968:
    "Стоит принять решение, и она молниеносно берётся за дело."

# bg/ceo/ceo.rpy:378
translate russian meeting_aletta_02_male_7edbedef:
    "Я демонстративно киваю Артуру."

# bg/ceo/ceo.rpy:379
translate russian meeting_aletta_02_male_7d34a175:
    mike.say "До подписания никто никуда не едет."

# bg/ceo/ceo.rpy:380
translate russian meeting_aletta_02_male_88813d7a:
    mike.say "Передайте им это. Но вежливо."

# bg/ceo/ceo.rpy:381
translate russian meeting_aletta_02_male_cd131299:
    "Артур тут же становится ещё самодовольнее."

# bg/ceo/ceo.rpy:383
translate russian meeting_aletta_02_male_5d6f285f:
    "Артур" "Разумно..."

# bg/ceo/ceo.rpy:384
translate russian meeting_aletta_02_male_afd4ee63:
    "Артур" "В течение часа отправлю им договор с правками и укажу срок ответа."

# bg/ceo/ceo.rpy:386
translate russian meeting_aletta_02_male_5b37868a:
    "А вот Алетта, разумеется, довольна куда меньше."

# bg/ceo/ceo.rpy:388
translate russian meeting_aletta_02_male_61695b01:
    aletta.say "Помяни моё слово, [lssb_common.hero_name()]..."

# bg/ceo/ceo.rpy:389
translate russian meeting_aletta_02_male_95243c5e:
    aletta.say "Ты их потеряешь."

# bg/ceo/ceo.rpy:390
translate russian meeting_aletta_02_male_1da44730:
    mike.say "Если восемьсот тысяч уходят из-за трёх недель оформления бумаг, значит, этих восьмисот тысяч у нас никогда и не было."

# bg/ceo/ceo.rpy:391
translate russian meeting_aletta_02_male_3b10fc80:
    "Алетта будто собирается мне огрызнуться."

# bg/ceo/ceo.rpy:392
translate russian meeting_aletta_02_male_2b37dd26:
    "Но затем моргает и качает головой."

# bg/ceo/ceo.rpy:394
translate russian meeting_aletta_02_male_e22dbce8:
    aletta.say "Хм..."

# bg/ceo/ceo.rpy:396
translate russian meeting_aletta_02_male_7bee4279:
    aletta.say "Впервые слышу, чтобы ты говорил как настоящий руководитель!"

# bg/ceo/ceo.rpy:397
translate russian meeting_aletta_02_male_b80ef0c8:
    "В исполнении Алетты это практически овация стоя."

# bg/ceo/ceo.rpy:410
translate russian result_meeting_aletta_02_male_b697a187:
    "Артур начинает объяснять последствия моего решения."

# bg/ceo/ceo.rpy:412
translate russian result_meeting_aletta_02_male_6ccea780:
    "Артур" "«Хэллоран» вернули наши правки со своими правками."

# bg/ceo/ceo.rpy:413
translate russian result_meeting_aletta_02_male_d074d5af:
    "Артур" "Они попытались снова вставить условие о возмещении убытков."

# bg/ceo/ceo.rpy:414
translate russian result_meeting_aletta_02_male_1193dc31:
    "Артур" "Дважды..."

# bg/ceo/ceo.rpy:415
translate russian result_meeting_aletta_02_male_108aa3e0:
    "Артур" "Во второй раз — в сноске."

# bg/ceo/ceo.rpy:416
translate russian result_meeting_aletta_02_male_ffb106d7:
    "Артур" "И я его убрал. Дважды."

# bg/ceo/ceo.rpy:419
translate russian result_meeting_aletta_02_male_4203fca1:
    "Алетта неохотно кивает."

# bg/ceo/ceo.rpy:420
translate russian result_meeting_aletta_02_male_94a01623:
    aletta.say "Они подписали."

# bg/ceo/ceo.rpy:421
translate russian result_meeting_aletta_02_male_86a46609:
    aletta.say "Объём работ закреплён, изменения оплачиваются отдельно, расчёт в течение тридцати дней."

# bg/ceo/ceo.rpy:423
translate russian result_meeting_aletta_02_male_37b51ef6:
    aletta.say "И они не ушли."

# bg/ceo/ceo.rpy:424
translate russian result_meeting_aletta_02_male_7f938657:
    "Я многозначительно ей улыбаюсь."

# bg/ceo/ceo.rpy:425
translate russian result_meeting_aletta_02_male_ac1eb718:
    mike.say "Можешь сказать, что я был прав."

# bg/ceo/ceo.rpy:427
translate russian result_meeting_aletta_02_male_abce784f:
    aletta.say "Ты принял верное решение."

# bg/ceo/ceo.rpy:428
translate russian result_meeting_aletta_02_male_f1fec2de:
    aletta.say "Это не одно и то же, и я намерена тебе об этом напоминать."

# bg/ceo/ceo.rpy:430
translate russian result_meeting_aletta_02_male_21b837c5:
    "Артур на этот раз выглядит почти довольным."

# bg/ceo/ceo.rpy:431
translate russian result_meeting_aletta_02_male_89699bd8:
    "На его лице это больше похоже на несварение."

# bg/ceo/ceo.rpy:433
translate russian result_meeting_aletta_02_male_b697a187_1:
    "Артур начинает объяснять последствия моего решения."

# bg/ceo/ceo.rpy:435
translate russian result_meeting_aletta_02_male_a92af3b5:
    "Артур" "Через шесть дней..."

# bg/ceo/ceo.rpy:436
translate russian result_meeting_aletta_02_male_5d0e2394:
    "Артур" "«Хэллоран» передумали насчёт того, что заказывали."

# bg/ceo/ceo.rpy:437
translate russian result_meeting_aletta_02_male_c831da4d:
    "Артур" "По их мнению, вся проделанная работа была лишь предварительным определением объёма проекта."

# bg/ceo/ceo.rpy:438
translate russian result_meeting_aletta_02_male_55df4487:
    "Артур" "А за это, как они считают, не платят."

# bg/ceo/ceo.rpy:440
translate russian result_meeting_aletta_02_male_7076e23f:
    "Я смотрю на него с изумлением и раздражением."

# bg/ceo/ceo.rpy:441
translate russian result_meeting_aletta_02_male_e99861a1:
    mike.say "Но у нас там четверо живут в гостинице!"

# bg/ceo/ceo.rpy:443
translate russian result_meeting_aletta_02_male_9dfc1bbc:
    "Артур" "Судя по последнему счёту, уже пятеро."

# bg/ceo/ceo.rpy:444
translate russian result_meeting_aletta_02_male_dce771bf:
    "Артур" "Я сам проверил расходы."

# bg/ceo/ceo.rpy:447
translate russian result_meeting_aletta_02_male_e2bd73bb:
    "Алетта тоже выглядит подавленной."

# bg/ceo/ceo.rpy:448
translate russian result_meeting_aletta_02_male_a59962d3:
    "Будто ждёт от Артура слов: «Я же говорил»."

# bg/ceo/ceo.rpy:450
translate russian result_meeting_aletta_02_male_24057172:
    aletta.say "Ничего не подписано, [lssb_common.hero_name()]..."

# bg/ceo/ceo.rpy:451
translate russian result_meeting_aletta_02_male_f799abb1:
    aletta.say "Только письмо: «Всё устраивает, давайте начинать»."

# bg/ceo/ceo.rpy:453
translate russian result_meeting_aletta_02_male_001f7f54:
    aletta.say "Не стоило мне на тебя давить."

# bg/ceo/ceo.rpy:454
translate russian result_meeting_aletta_02_male_40dce03c:
    aletta.say "Слишком уж хотелось победить."

# bg/ceo/ceo.rpy:456
translate russian result_meeting_aletta_02_male_eff26d00:
    mike.say "В итоге мы потеряли девяносто одну тысячу и всё равно лишились клиента."

# bg/ceo/ceo.rpy:458
translate russian result_meeting_aletta_02_male_32093c02:
    "Артур не произносит ни слова о протоколе."

# bg/ceo/ceo.rpy:459
translate russian result_meeting_aletta_02_male_b8058c8e:
    "И это ощущается самым убийственным упрёком, на который он способен."

# bg/ceo/ceo.rpy:471
translate russian meeting_aletta_03_male_abf54bdb:
    "Сегодня Энтони разошёлся не на шутку: твердит своё, почти не переводя дух."

# bg/ceo/ceo.rpy:473
translate russian meeting_aletta_03_male_4ae46871:
    "Энтони" "Расходы на сверхурочные — четыреста шесть тысяч при бюджете в двести тридцать."

# bg/ceo/ceo.rpy:474
translate russian meeting_aletta_03_male_f1a2e34e:
    "Энтони" "На одну линию ушёл весь квартальный бюджет."

# bg/ceo/ceo.rpy:475
translate russian meeting_aletta_03_male_1bb29cbb:
    "Энтони" "Я рекомендую жёсткий лимит."

# bg/ceo/ceo.rpy:476
translate russian meeting_aletta_03_male_9554faf2:
    "Энтони" "Ни у кого больше сорока часов без письменного согласования в этом кабинете."

# bg/ceo/ceo.rpy:477
translate russian meeting_aletta_03_male_5778c390:
    "Энтони" "За четырнадцать дней это закроет разрыв."

# bg/ceo/ceo.rpy:480
translate russian meeting_aletta_03_male_d1fc0243:
    "Алетта качает головой и тут же возражает."

# bg/ceo/ceo.rpy:482
translate russian meeting_aletta_03_male_83e8049f:
    aletta.say "Твой лимит не закроет разрыв, Энтони. Он просто перенесёт его в другое место."

# bg/ceo/ceo.rpy:484
translate russian meeting_aletta_03_male_cb4ecc62:
    aletta.say "Мы работаем сверхурочно, потому что во второй смене не хватает четырнадцати человек. И так уже несколько месяцев."

# bg/ceo/ceo.rpy:485
translate russian meeting_aletta_03_male_af229962:
    aletta.say "Переработки — симптом, а не причина."

# bg/ceo/ceo.rpy:487
translate russian meeting_aletta_03_male_46867cd6:
    aletta.say "Предлагаю нанять через агентство двенадцать временных работников."

# bg/ceo/ceo.rpy:488
translate russian meeting_aletta_03_male_04739f62:
    aletta.say "Час их работы стоит меньше, чем полуторная ставка за сверхурочные, а выйти они смогут уже на этой неделе."

# bg/ceo/ceo.rpy:490
translate russian meeting_aletta_03_male_0c476dd9:
    "Теперь уже Энтони качает головой."

# bg/ceo/ceo.rpy:493
translate russian meeting_aletta_03_male_06209242:
    "Энтони" "В первые три недели работники агентства обходятся дороже в расчёте на единицу продукции."

# bg/ceo/ceo.rpy:494
translate russian meeting_aletta_03_male_5329ec1b:
    "Энтони" "Им нужно время на обучение. И я его рассчитал."

# bg/ceo/ceo.rpy:497
translate russian meeting_aletta_03_male_0936dc0b:
    aletta.say "А за просрочку поставки «Брайтуотер» предусмотрен штраф — девять тысяч в день."

# bg/ceo/ceo.rpy:500
translate russian meeting_aletta_03_male_e3cb4d90:
    "Энтони" "Это отдельная статья и отдельный разговор."

# bg/ceo/ceo.rpy:503
translate russian meeting_aletta_03_male_92b1f22d:
    aletta.say "Деньги одни и те же, Энтони."

# bg/ceo/ceo.rpy:504
translate russian meeting_aletta_03_male_e33ba2cc:
    aletta.say "Всё это одни и те же деньги."

# bg/ceo/ceo.rpy:506
translate russian meeting_aletta_03_male_625db1ff:
    "Энтони что-то записывает, как всегда. Но что именно — я никогда не вижу."

# bg/ceo/ceo.rpy:509
translate russian meeting_aletta_03_male_c7638598:
    "Я киваю в сторону Энтони."

# bg/ceo/ceo.rpy:510
translate russian meeting_aletta_03_male_785288dd:
    mike.say "Вводим лимит."

# bg/ceo/ceo.rpy:511
translate russian meeting_aletta_03_male_8917334b:
    mike.say "Сорок часов. Всё сверх — по согласованию в этом кабинете."

# bg/ceo/ceo.rpy:513
translate russian meeting_aletta_03_male_b3155d59:
    "Энтони" "Вступает в силу немедленно."

# bg/ceo/ceo.rpy:514
translate russian meeting_aletta_03_male_244e6b90:
    "Энтони" "В течение часа разошлю уведомление."

# bg/ceo/ceo.rpy:517
translate russian meeting_aletta_03_male_bb28fcf1:
    "Алетта хмуро смотрит на меня и качает головой."

# bg/ceo/ceo.rpy:519
translate russian meeting_aletta_03_male_ab27a0ef:
    aletta.say "[lssb_common.hero_name()], ты только что приказал второй смене, где и так не хватает четырнадцати человек, работать меньше."

# bg/ceo/ceo.rpy:521
translate russian meeting_aletta_03_male_bc304ca3:
    mike.say "Это временно, Алетта..."

# bg/ceo/ceo.rpy:523
translate russian meeting_aletta_03_male_caf0b897:
    aletta.say "Всё временно, пока не превращается в привычный порядок вещей."

# bg/ceo/ceo.rpy:525
translate russian meeting_aletta_03_male_78cf5e21:
    aletta.say "Не волнуйся, я выкручусь. Это моя работа."

# bg/ceo/ceo.rpy:527
translate russian meeting_aletta_03_male_e71ad8eb:
    aletta.say "Но пусть будет зафиксировано: я предупреждала, что это не сработает."

# bg/ceo/ceo.rpy:529
translate russian meeting_aletta_03_male_bf9ad05e:
    "Уже второй человек за неделю хочет что-то зафиксировать."

# bg/ceo/ceo.rpy:530
translate russian meeting_aletta_03_male_1978de5f:
    "Начинаю понимать, почему Дуэйн столько пил."

# bg/ceo/ceo.rpy:534
translate russian meeting_aletta_03_male_b76adbe8:
    "Я киваю в сторону Алетты."

# bg/ceo/ceo.rpy:536
translate russian meeting_aletta_03_male_c2d42342:
    mike.say "Нанимай временных работников, Алетта."

# bg/ceo/ceo.rpy:537
translate russian meeting_aletta_03_male_9976d2db:
    mike.say "Энтони, найдите деньги в бюджете на агентства, а не в фонде зарплаты."

# bg/ceo/ceo.rpy:539
translate russian meeting_aletta_03_male_55379bbd:
    "Энтони явно недоволен, и это слышно по его тону."

# bg/ceo/ceo.rpy:541
translate russian meeting_aletta_03_male_4677dfaf:
    "Энтони" "Это перенос расходов в другую статью, а не экономия."

# bg/ceo/ceo.rpy:542
translate russian meeting_aletta_03_male_7c5c6206:
    "Энтони" "Прошу это отметить."

# bg/ceo/ceo.rpy:544
translate russian meeting_aletta_03_male_4ff9347d:
    mike.say "Отмечено."

# bg/ceo/ceo.rpy:546
translate russian meeting_aletta_03_male_c08226b0:
    "Разумеется, Алетта мной довольна гораздо больше."

# bg/ceo/ceo.rpy:548
translate russian meeting_aletta_03_male_ce8fd555:
    aletta.say "Двенадцати должно хватить."

# bg/ceo/ceo.rpy:549
translate russian meeting_aletta_03_male_7b2ee069:
    aletta.say "К каждому приставлю того, кто знает, что делает."

# bg/ceo/ceo.rpy:552
translate russian meeting_aletta_03_male_47e25b07:
    "Энтони" "Значит, на время обучения три недели у вас два человека будут делать работу одного."

# bg/ceo/ceo.rpy:555
translate russian meeting_aletta_03_male_b16f97cb:
    aletta.say "А на четвёртой неделе у меня будет двенадцать человек, способных работать самостоятельно."

# bg/ceo/ceo.rpy:558
translate russian meeting_aletta_03_male_a5e22837:
    "Энтони записывает что-то ещё и молчит, понимая, что остался в меньшинстве."

# bg/ceo/ceo.rpy:572
translate russian result_meeting_aletta_03_male_e949d24d:
    "На лице Алетты — торжество."

# bg/ceo/ceo.rpy:574
translate russian result_meeting_aletta_03_male_9b037f3e:
    aletta.say "Временные работники с нами уже пару дней."

# bg/ceo/ceo.rpy:575
translate russian result_meeting_aletta_03_male_0ac45b17:
    aletta.say "Четверо уже могут самостоятельно работать на участке."

# bg/ceo/ceo.rpy:577
translate russian result_meeting_aletta_03_male_2c2a2f3e:
    aletta.say "Заказ «Брайтуотер» отгружаем вовремя. Без штрафа."

# bg/ceo/ceo.rpy:580
translate russian result_meeting_aletta_03_male_5f17fa11:
    "Энтони фыркает, но не возражает."

# bg/ceo/ceo.rpy:583
translate russian result_meeting_aletta_03_male_e1dec8dc:
    "Энтони" "Сверхурочные снизились на шестьдесят один процент по сравнению с прошлой неделей."

# bg/ceo/ceo.rpy:584
translate russian result_meeting_aletta_03_male_b9530e63:
    "Энтони" "Расходы на агентство выросли, но не настолько."

# bg/ceo/ceo.rpy:585
translate russian result_meeting_aletta_03_male_c4b13394:
    mike.say "То есть итоговая цифра стала лучше?"

# bg/ceo/ceo.rpy:586
translate russian result_meeting_aletta_03_male_457e72ff:
    "Энтони" "Да, цифра стала лучше."

# bg/ceo/ceo.rpy:587
translate russian result_meeting_aletta_03_male_7d7d59b2:
    "Энтони" "Благодаря решению, которое я бы не выбрал. Но стала лучше."

# bg/ceo/ceo.rpy:590
translate russian result_meeting_aletta_03_male_f0ce18ac:
    aletta.say "Трое из двенадцати временных работников уже спросили о постоянных контрактах."

# bg/ceo/ceo.rpy:592
translate russian result_meeting_aletta_03_male_6ef20af6:
    "Алетта произносит это так, словно речь о пустяке."

# bg/ceo/ceo.rpy:593
translate russian result_meeting_aletta_03_male_4bace998:
    "Но я знаю, что она уже поручила отделу кадров подготовить предложения."

# bg/ceo/ceo.rpy:596
translate russian result_meeting_aletta_03_male_6ff6bf62:
    "Лимит держится ровно семь дней."

# bg/ceo/ceo.rpy:597
translate russian result_meeting_aletta_03_male_a5cde854:
    "Алетта выглядит огорчённой."

# bg/ceo/ceo.rpy:599
translate russian result_meeting_aletta_03_male_9b233319:
    aletta.say "Вторая смена прекратила работу после сорока часов, как мы и велели."

# bg/ceo/ceo.rpy:600
translate russian result_meeting_aletta_03_male_d3b32282:
    aletta.say "Вместе с ней остановился и заказ «Брайтуотер»."

# bg/ceo/ceo.rpy:602
translate russian result_meeting_aletta_03_male_37555ca9:
    "Энтони выбирает этот момент, чтобы вставить слово."

# bg/ceo/ceo.rpy:605
translate russian result_meeting_aletta_03_male_55232a65:
    "Энтони" "Четыре дня просрочки — тридцать шесть тысяч штрафа."

# bg/ceo/ceo.rpy:606
translate russian result_meeting_aletta_03_male_253d158e:
    "Энтони" "При экономии на сверхурочных в тридцать одну тысячу."

# bg/ceo/ceo.rpy:607
translate russian result_meeting_aletta_03_male_dcfe50d1:
    "Я недоверчиво смотрю на него."

# bg/ceo/ceo.rpy:608
translate russian result_meeting_aletta_03_male_aaa8e07c:
    mike.say "То есть, ограничив расходы, мы потеряли деньги?!"

# bg/ceo/ceo.rpy:609
translate russian result_meeting_aletta_03_male_7eccec6e:
    "Энтони" "Мы потеряли пять тысяч и расположение клиента. Последнее в колонку не внесёшь."

# bg/ceo/ceo.rpy:612
translate russian result_meeting_aletta_03_male_ce614ab8:
    aletta.say "И двое моих лучших мастеров подали заявления об уходе: из-за лимита им приходится делать больше за меньшие деньги!"

# bg/ceo/ceo.rpy:614
translate russian result_meeting_aletta_03_male_b1ebe08b:
    aletta.say "Начну искать замену. Но это займёт десять недель."

# bg/ceo/ceo.rpy:616
translate russian result_meeting_aletta_03_male_a98540c1:
    "Десять недель. Почти столько же ушло бы, если бы я просто её послушал."

# bg/ceo/ceo.rpy:628
translate russian meeting_aletta_04_male_5757f05f:
    "Как обычно, Алетта наступает и диктует условия."

# bg/ceo/ceo.rpy:630
translate russian meeting_aletta_04_male_9587bd06:
    aletta.say "Узкое место — четвёртый участок. Так было последние два года и будет дальше, пока кто-нибудь не вложит в него деньги."

# bg/ceo/ceo.rpy:631
translate russian meeting_aletta_04_male_928765f2:
    aletta.say "Автоматическая линия «Кестрел» выполнит работу четвёртого и пятого участков вместе. И домой в шесть она не уходит."

# bg/ceo/ceo.rpy:632
translate russian meeting_aletta_04_male_63a38f21:
    aletta.say "Миллион четыреста тысяч, поставка через одиннадцать недель, [lssb_common.hero_name()]!"

# bg/ceo/ceo.rpy:633
translate russian meeting_aletta_04_male_ec7a39a5:
    aletta.say "Хочу оформить заказ в этом месяце."

# bg/ceo/ceo.rpy:635
translate russian meeting_aletta_04_male_fb7d89bd:
    "Энтони даёт Алетте высказаться, прежде чем изложить возражения."

# bg/ceo/ceo.rpy:638
translate russian meeting_aletta_04_male_e7cf333b:
    "Энтони" "Миллион четыреста тысяч при свободном денежном потоке в двести восемь тысяч в месяц. А скоро проверка соблюдения кредитных условий."

# bg/ceo/ceo.rpy:639
translate russian meeting_aletta_04_male_2c742a5b:
    "Энтони" "По твоим же расчётам окупаемость — восемь лет и два месяца. Наш предел — пять лет."

# bg/ceo/ceo.rpy:642
translate russian meeting_aletta_04_male_ef4bc67d:
    aletta.say "Твой предел предполагает, что ничего не меняется. Но мы оба знаем: меняется всё!"

# bg/ceo/ceo.rpy:645
translate russian meeting_aletta_04_male_8eae3767:
    "Энтони" "После закрытия завода «Дортман» продаётся восстановленная линия «Кестрел»."

# bg/ceo/ceo.rpy:646
translate russian meeting_aletta_04_male_a63d68f8:
    "Энтони" "Четыре года эксплуатации, восемьдесят процентов производительности. Доступна в лизинг за девятнадцать тысяч в месяц."

# bg/ceo/ceo.rpy:647
translate russian meeting_aletta_04_male_4f3eec5d:
    "Энтони" "В сочетании с изменением очерёдности ночных запусков узкое место переместится на седьмой участок. С этим мы справимся."

# bg/ceo/ceo.rpy:650
translate russian meeting_aletta_04_male_d95986c1:
    "Алетта хмурится, явно пытаясь сдержать раздражение на Энтони."

# bg/ceo/ceo.rpy:652
translate russian meeting_aletta_04_male_2595ed75:
    aletta.say "Ты хочешь решить проблему с оборудованием с помощью таблицы."

# bg/ceo/ceo.rpy:655
translate russian meeting_aletta_04_male_e2ea38d9:
    "Энтони" "Я хочу решить проблему с оборудованием, не создав проблему с платёжеспособностью."

# bg/ceo/ceo.rpy:656
translate russian meeting_aletta_04_male_03450590:
    "Энтони" "Это разные проблемы. И лишь одна из них смертельна."

# bg/ceo/ceo.rpy:658
translate russian meeting_aletta_04_male_6d130be4:
    "Что ж, похоже, решение снова придётся принимать мне. Как обычно!"

# bg/ceo/ceo.rpy:661
translate russian meeting_aletta_04_male_c7638598:
    "Я киваю в сторону Энтони."

# bg/ceo/ceo.rpy:662
translate russian meeting_aletta_04_male_33dd88d3:
    mike.say "Берём восстановленную линию в лизинг, меняем порядок ночных запусков."

# bg/ceo/ceo.rpy:664
translate russian meeting_aletta_04_male_11125785:
    "Энтони" "Разумный выбор, сэр..."

# bg/ceo/ceo.rpy:665
translate russian meeting_aletta_04_male_602bddaa:
    "Энтони" "В течение часа передам Артуру документы на лизинг."

# bg/ceo/ceo.rpy:668
translate russian meeting_aletta_04_male_6877b1e5:
    "Алетта чуть ли не сверлит меня взглядом."

# bg/ceo/ceo.rpy:670
translate russian meeting_aletta_04_male_57c69401:
    aletta.say "Восемьдесят процентов производительности — это восемьдесят процентов."

# bg/ceo/ceo.rpy:672
translate russian meeting_aletta_04_male_af9603e7:
    mike.say "Восемьдесят процентов, которые нам по карману, лучше ста, на которые денег нет."

# bg/ceo/ceo.rpy:674
translate russian meeting_aletta_04_male_16643fa1:
    "Раздражение на лице Алетты сменяется удивлением."

# bg/ceo/ceo.rpy:676
translate russian meeting_aletta_04_male_753b7869:
    aletta.say "А ты почитал кое-что, [lssb_common.hero_name()]."

# bg/ceo/ceo.rpy:678
translate russian meeting_aletta_04_male_59d7e125:
    "Я киваю: именно этим я и занимался."

# bg/ceo/ceo.rpy:679
translate russian meeting_aletta_04_male_5008d52e:
    "Читал по теме, лёжа дома в ванне... Но эту подробность Алетте знать необязательно..."

# bg/ceo/ceo.rpy:683
translate russian meeting_aletta_04_male_b76adbe8:
    "Я киваю в сторону Алетты."

# bg/ceo/ceo.rpy:684
translate russian meeting_aletta_04_male_c92ed2df:
    mike.say "Покупаем новую, хорошо?"

# bg/ceo/ceo.rpy:686
translate russian meeting_aletta_04_male_a02e9994:
    "Алетта улыбается и кивает, довольная победой."

# bg/ceo/ceo.rpy:688
translate russian meeting_aletta_04_male_77d82310:
    aletta.say "Не пожалеешь."

# bg/ceo/ceo.rpy:690
translate russian meeting_aletta_04_male_b4320a0f:
    aletta.say "Четвёртый участок душил нас ещё до того, как ты стал здесь главным."

# bg/ceo/ceo.rpy:693
translate russian meeting_aletta_04_male_f6240007:
    "Разумеется, Энтони впечатлён куда меньше."

# bg/ceo/ceo.rpy:695
translate russian meeting_aletta_04_male_ea5b445e:
    "Энтони" "Придётся воспользоваться кредитной линией. Значит, нужно уведомить банк."

# bg/ceo/ceo.rpy:696
translate russian meeting_aletta_04_male_ea08bcdb:
    mike.say "Так уведомите."

# bg/ceo/ceo.rpy:697
translate russian meeting_aletta_04_male_740fb516:
    "Энтони" "Я всегда уведомляю."

# bg/ceo/ceo.rpy:698
translate russian meeting_aletta_04_male_71657386:
    "Энтони" "Просто предпочитаю, чтобы следом не шла проверка соблюдения кредитных условий."

# bg/ceo/ceo.rpy:700
translate russian meeting_aletta_04_male_e8135696:
    "Энтони собирает бумаги с присущей ему размеренной аккуратностью."

# bg/ceo/ceo.rpy:701
translate russian meeting_aletta_04_male_02ad9619:
    "Самое опрятное выражение несогласия, какое я когда-либо видел."

# bg/ceo/ceo.rpy:715
translate russian result_meeting_aletta_04_male_6a55b249:
    aletta.say "Сегодня утром грузовик привёз оборудование из «Дортман»..."

# bg/ceo/ceo.rpy:716
translate russian result_meeting_aletta_04_male_828fa563:
    aletta.say "Выглядит так, словно его подняли с затонувшего корабля!"

# bg/ceo/ceo.rpy:718
translate russian result_meeting_aletta_04_male_11928f4e:
    "Объясняя ситуацию, Алетта закатывает глаза."

# bg/ceo/ceo.rpy:720
translate russian result_meeting_aletta_04_male_f0c2c564:
    aletta.say "Оно работает. Громкое, страшное, но хотя бы работает."

# bg/ceo/ceo.rpy:722
translate russian result_meeting_aletta_04_male_f5023fc9:
    "Энтони эстетические качества нового приобретения, похоже, волнуют гораздо меньше."

# bg/ceo/ceo.rpy:725
translate russian result_meeting_aletta_04_male_716077e1:
    "Энтони" "Производительность выросла на тридцать один процент по сравнению с одним четвёртым участком."

# bg/ceo/ceo.rpy:726
translate russian result_meeting_aletta_04_male_80310561:
    "Энтони" "Девятнадцать тысяч в месяц, полностью учитываются в расходах, на балансе не отражаются."

# bg/ceo/ceo.rpy:727
translate russian result_meeting_aletta_04_male_8321787f:
    "Энтони" "Свободный денежный поток не пострадал, так что проверка кредитных условий больше не представляет интереса."

# bg/ceo/ceo.rpy:730
translate russian result_meeting_aletta_04_male_f12a2d6b:
    aletta.say "Я всё равно хочу новую."

# bg/ceo/ceo.rpy:732
translate russian result_meeting_aletta_04_male_09dfb4a8:
    mike.say "В следующем году, Алетта. Обещаю."

# bg/ceo/ceo.rpy:734
translate russian result_meeting_aletta_04_male_a1178b83:
    aletta.say "Я тебе это припомню. Такие обещания я записываю."

# bg/ceo/ceo.rpy:736
translate russian result_meeting_aletta_04_male_7807e8d1:
    "Ни капли в этом не сомневаюсь."

# bg/ceo/ceo.rpy:740
translate russian result_meeting_aletta_04_male_dbbbb969:
    "Энтони" "Банку не нравится, что мы выбрали кредит."

# bg/ceo/ceo.rpy:741
translate russian result_meeting_aletta_04_male_11c3c30d:
    "Энтони" "Они не отказали, но провели проверку кредитных условий на квартал раньше. На их языке это равносильно крику."

# bg/ceo/ceo.rpy:742
translate russian result_meeting_aletta_04_male_8a2571a6:
    "Энтони" "Сейчас у нас запас до предела в четыреста тысяч, а к следующей проверке останется шестьдесят."

# bg/ceo/ceo.rpy:744
translate russian result_meeting_aletta_04_male_6dc28dc8:
    "Энтони поворачивается к Алетте, которая выглядит весьма удручённой."

# bg/ceo/ceo.rpy:746
translate russian result_meeting_aletta_04_male_3f57c54a:
    aletta.say "А «Кестрел» не приедет ещё несколько месяцев. Они перенесли нашу очередь на производство."

# bg/ceo/ceo.rpy:748
translate russian result_meeting_aletta_04_male_2f26032a:
    mike.say "Значит, мы платим за несуществующую машину деньгами, которых у нас нет."

# bg/ceo/ceo.rpy:750
translate russian result_meeting_aletta_04_male_4c5dc9e9:
    "Энтони" "Сформулировано эмоционально, но по сути верно."

# bg/ceo/ceo.rpy:753
translate russian result_meeting_aletta_04_male_b39db6bd:
    aletta.say "Я как-нибудь вытяну четвёртый участок, обещаю!"

# bg/ceo/ceo.rpy:755
translate russian result_meeting_aletta_04_male_3ce1d37e:
    "На слово «как-нибудь» в этой фразе возложено слишком многое."

# bg/ceo/ceo.rpy:767
translate russian meeting_aletta_05_male_901943fe:
    "Сегодня Уильям разошёлся и с жаром выкладывает мне свои доводы."

# bg/ceo/ceo.rpy:769
translate russian meeting_aletta_05_male_6db4b811:
    "Уильям" "Трое менеджеров по работе с клиентами, босс. ТРОЕ!"

# bg/ceo/ceo.rpy:770
translate russian meeting_aletta_05_male_997d2e37:
    "Уильям" "Все — в «Веррин». И все за одни и те же две недели."

# bg/ceo/ceo.rpy:771
translate russian meeting_aletta_05_male_be749108:
    "Уильям" "Это не текучка, это налёт. Значит, ответим тем же."

# bg/ceo/ceo.rpy:772
translate russian meeting_aletta_05_male_16896e11:
    "Уильям" "Объявляем фонд премий за сохранение сотрудников. Двести тысяч на весь отдел, немедленно."

# bg/ceo/ceo.rpy:773
translate russian meeting_aletta_05_male_455c63e4:
    "Уильям" "Это заявление: мы готовы бороться. А людям нравится, когда за них борются."

# bg/ceo/ceo.rpy:776
translate russian meeting_aletta_05_male_9d2c1e92:
    "Алетта даёт ему закончить, а затем отвечает более ровным тоном."

# bg/ceo/ceo.rpy:778
translate russian meeting_aletta_05_male_96da6746:
    aletta.say "Людям нравится получать деньги, Уильям. Но никто не любит пресс-релизы о том, что получит деньги."

# bg/ceo/ceo.rpy:780
translate russian meeting_aletta_05_male_bc7600ec:
    aletta.say "Все трое подчинялись одному руководителю. И все трое при увольнении сказали одно и то же: дело не в деньгах."

# bg/ceo/ceo.rpy:781
translate russian meeting_aletta_05_male_cdc983dd:
    aletta.say "Дай мне две недели. Я выясню, что происходит в этом отделе, а затем мы это исправим."

# bg/ceo/ceo.rpy:784
translate russian meeting_aletta_05_male_cf4f277a:
    "Уильям" "Две недели — ещё два увольнения. При всём уважении к Алетте, сейчас решает скорость."

# bg/ceo/ceo.rpy:787
translate russian meeting_aletta_05_male_31f04cd8:
    aletta.say "Ты всего тринадцать месяцев в руководстве. Не учи меня, что сейчас решает!"

# bg/ceo/ceo.rpy:790
translate russian meeting_aletta_05_male_809aab4b:
    "Уильям" "Ты управляешь этим отделом дольше, чем мы оба здесь работаем. И потеряла троих за две недели."

# bg/ceo/ceo.rpy:792
translate russian meeting_aletta_05_male_3dbe626e:
    "Кажется, температура в комнате падает градуса на четыре."

# bg/ceo/ceo.rpy:793
translate russian meeting_aletta_05_male_610b0923:
    "Уильям улыбается мне, словно оказал услугу, а Алетта всё это время сверлит его взглядом."

# bg/ceo/ceo.rpy:796
translate russian meeting_aletta_05_male_60e979a9:
    "Я указываю на Алетту и киваю."

# bg/ceo/ceo.rpy:798
translate russian meeting_aletta_05_male_5efd5a61:
    mike.say "Две недели, Алетта. Выясни, что происходит."

# bg/ceo/ceo.rpy:799
translate russian meeting_aletta_05_male_cfc33071:
    "Алетта кивает в ответ."

# bg/ceo/ceo.rpy:801
translate russian meeting_aletta_05_male_e635780c:
    aletta.say "Спасибо, [lssb_common.hero_name()]..."

# bg/ceo/ceo.rpy:804
translate russian meeting_aletta_05_male_803637b3:
    "Уильям" "Совершенно верное решение, босс. Взвешенное..."

# bg/ceo/ceo.rpy:805
translate russian meeting_aletta_05_male_2b9eb15f:
    "Уильям" "Мне нравится."

# bg/ceo/ceo.rpy:806
translate russian meeting_aletta_05_male_0dda40b7:
    mike.say "Уильям, тридцать секунд назад вы говорили обратное!"

# bg/ceo/ceo.rpy:807
translate russian meeting_aletta_05_male_af8a792f:
    "Уильям" "Я говорил обратное {i}до{/i} вашего решения, сэр..."

# bg/ceo/ceo.rpy:808
translate russian meeting_aletta_05_male_706a887c:
    "Уильям" "Поверьте, разница есть!"

# bg/ceo/ceo.rpy:810
translate russian meeting_aletta_05_male_80188df7:
    "Надо признать, никто не умеет так втираться в доверие, как он."

# bg/ceo/ceo.rpy:811
translate russian meeting_aletta_05_male_671bdb74:
    "Почти никто."

# bg/ceo/ceo.rpy:815
translate russian meeting_aletta_05_male_4eaa39ac:
    "Я киваю и указываю в сторону Уильяма."

# bg/ceo/ceo.rpy:816
translate russian meeting_aletta_05_male_8c619c88:
    mike.say "Действуйте. Ответное переманивание и объявление о премиях."

# bg/ceo/ceo.rpy:818
translate russian meeting_aletta_05_male_d9b29b59:
    "Уильям кивает и улыбается, довольный тем, что добился своего."

# bg/ceo/ceo.rpy:819
translate russian meeting_aletta_05_male_87482a5a:
    "Уильям" "Да!"

# bg/ceo/ceo.rpy:820
translate russian meeting_aletta_05_male_6f2dff8d:
    "Уильям" "Не пожалеете. К четырём объявление уже выйдет."

# bg/ceo/ceo.rpy:823
translate russian meeting_aletta_05_male_30d22b6a:
    "Алетта, однако, хмурится и качает головой."

# bg/ceo/ceo.rpy:825
translate russian meeting_aletta_05_male_236fb712:
    aletta.say "Ты собираешься выдать каждому в этом здании премию за то, что он не ушёл."

# bg/ceo/ceo.rpy:827
translate russian meeting_aletta_05_male_da186013:
    mike.say "Это даст нам время, Алетта..."

# bg/ceo/ceo.rpy:829
translate russian meeting_aletta_05_male_e485129c:
    aletta.say "Это даст нам целый отдел людей, которые теперь знают: чтобы получить деньги, нужно пригрозить увольнением!"

# bg/ceo/ceo.rpy:831
translate russian meeting_aletta_05_male_60938014:
    aletta.say "Надеюсь, я ошибаюсь."

# bg/ceo/ceo.rpy:832
translate russian meeting_aletta_05_male_2031fda4:
    "Не могу не заметить: ни разу после этих слов не оказывалось, что Алетта ошиблась."

# bg/ceo/ceo.rpy:845
translate russian result_meeting_aletta_05_male_bf2ff631:
    "Алетте хватает семи дней вместо четырнадцати. Теперь она возвращается доложить об успехе."

# bg/ceo/ceo.rpy:847
translate russian result_meeting_aletta_05_male_d0c92651:
    aletta.say "Их руководитель без предупреждения забирал у них клиентов и оформлял комиссионные на себя."

# bg/ceo/ceo.rpy:849
translate russian result_meeting_aletta_05_male_ade59dbb:
    aletta.say "Три человека ушли не в «Веррин». Они ушли от него!"

# bg/ceo/ceo.rpy:851
translate russian result_meeting_aletta_05_male_a3277851:
    mike.say "И что теперь?"

# bg/ceo/ceo.rpy:853
translate russian result_meeting_aletta_05_male_7cb08931:
    aletta.say "Теперь он уволен, комиссионные возвращены, а двое из троих уже попросились обратно."

# bg/ceo/ceo.rpy:855
translate russian result_meeting_aletta_05_male_95bd071e:
    "Едва Алетта заканчивает, Уильям тут же вмешивается."

# bg/ceo/ceo.rpy:858
translate russian result_meeting_aletta_05_male_dcd7f78e:
    "Уильям" "Блестящее чутьё, босс..."

# bg/ceo/ceo.rpy:859
translate russian result_meeting_aletta_05_male_b20d651c:
    "Уильям" "Я с самого начала говорил, что проблема в людях."

# bg/ceo/ceo.rpy:860
translate russian result_meeting_aletta_05_male_f7a41e4f:
    mike.say "Вы говорили, что это налёт, Уильям!"

# bg/ceo/ceo.rpy:861
translate russian result_meeting_aletta_05_male_672c1b56:
    "Уильям" "Налёт на людей, сэр..."

# bg/ceo/ceo.rpy:863
translate russian result_meeting_aletta_05_male_2bb0eeb1:
    "Я решаю не спорить: не хочется разбираться с последствиями, если начну его прижимать."

# bg/ceo/ceo.rpy:869
translate russian result_meeting_aletta_05_male_2a5a8445:
    "Алетта трёт лоб, объясняя, как сейчас обстоят дела."

# bg/ceo/ceo.rpy:871
translate russian result_meeting_aletta_05_male_10e0d959:
    aletta.say "Стоило объявить премии, как за несколько дней ко мне в кабинет пришли четырнадцать человек."

# bg/ceo/ceo.rpy:872
translate russian result_meeting_aletta_05_male_0cff218e:
    aletta.say "Ни один не увольнялся. Все четырнадцать хотели обсудить, сколько получат, если соберутся уходить."

# bg/ceo/ceo.rpy:875
translate russian result_meeting_aletta_05_male_9a934f10:
    "Энтони" "Выплачено двести тринадцать тысяч. Показатель удержания сотрудников за тот же период статистически не изменился."

# bg/ceo/ceo.rpy:878
translate russian result_meeting_aletta_05_male_5919e2c1:
    aletta.say "А руководитель, из-за которого всё началось, получил свою премию и до сих пор сидит в том отделе, продолжая то же самое."

# bg/ceo/ceo.rpy:880
translate russian result_meeting_aletta_05_male_79f86364:
    mike.say "Что именно продолжая?"

# bg/ceo/ceo.rpy:882
translate russian result_meeting_aletta_05_male_98fa6b61:
    aletta.say "Вот для этого разговора я и просила у тебя две недели, [lssb_common.hero_name()]."

# bg/ceo/ceo.rpy:884
translate russian result_meeting_aletta_05_male_95bd071e_1:
    "Едва Алетта заканчивает, Уильям тут же вмешивается."

# bg/ceo/ceo.rpy:886
translate russian result_meeting_aletta_05_male_c9667aa9:
    "Уильям" "Справедливости ради, босс, никто не мог предсказать..."

# bg/ceo/ceo.rpy:889
translate russian result_meeting_aletta_05_male_2c246791:
    "Неудивительно, что она чуть не откусывает ему голову."

# bg/ceo/ceo.rpy:891
translate russian result_meeting_aletta_05_male_87ea73e2:
    aletta.say "Она могла и предсказала. И она стоит прямо здесь!"

# bg/ceo/ceo.rpy:893
translate russian result_meeting_aletta_05_male_b8e3de85:
    "Уильям внезапно обнаруживает в телефоне что-то невероятно интересное."

# bg/ceo/ceo.rpy:894
translate russian result_meeting_aletta_05_male_f9545819:
    "И смотрит в экран, а не на разъярённую Алетту."

# bg/ceo/ceo.rpy:906
translate russian meeting_aletta_06_male_ed65c91d:
    "Начиная говорить, Уильям выглядит возбуждённым, чуть ли не жаждущим крови."

# bg/ceo/ceo.rpy:908
translate russian meeting_aletta_06_male_903cdfe1:
    "Уильям" "«Марроу и Кайн» идут ко дну. Назначен управляющий, а клиентскую базу можно забрать за бесценок."

# bg/ceo/ceo.rpy:909
translate russian meeting_aletta_06_male_a90094d6:
    "Уильям" "Четыреста клиентов, босс! Половина станет нашей уже на следующий день после подписания. Миллион, и у нас десять дней."

# bg/ceo/ceo.rpy:912
translate russian meeting_aletta_06_male_d42bca7a:
    "Всё звучит слишком хорошо, чтобы быть правдой, пока не вмешивается Алетта."

# bg/ceo/ceo.rpy:914
translate russian meeting_aletta_06_male_925fc0b1:
    aletta.say "Миллион за четыреста клиентов, которых мы не сможем обслужить."

# bg/ceo/ceo.rpy:916
translate russian meeting_aletta_06_male_c1728acb:
    aletta.say "Мы уже работаем на пределе."

# bg/ceo/ceo.rpy:918
translate russian meeting_aletta_06_male_8cb19b48:
    aletta.say "В момент подписания каждый из этих клиентов станет обещанием, которое мы уже не способны выполнить."

# bg/ceo/ceo.rpy:921
translate russian meeting_aletta_06_male_2b1c66cc:
    "Уильям" "Тогда наймём людей, чёрт возьми!"

# bg/ceo/ceo.rpy:924
translate russian meeting_aletta_06_male_230f748f:
    aletta.say "Кого, Уильям?"

# bg/ceo/ceo.rpy:925
translate russian meeting_aletta_06_male_1f2c0e87:
    aletta.say "Тех, которых у нас нет? На рынке, с которого мы уже выбрали всех?"

# bg/ceo/ceo.rpy:927
translate russian meeting_aletta_06_male_f2102cfb:
    aletta.say "[lssb_common.hero_name()], я уже занималась интеграцией после поглощения. Это заняло восемнадцать месяцев и едва не сломало компанию, которая справлялась хорошо."

# bg/ceo/ceo.rpy:930
translate russian meeting_aletta_06_male_559e3c37:
    "Уильям" "А если откажемся, купит «Веррин». «Веррин» с нашими тремя менеджерами получит четыреста клиентов и бросит их всех против нас."

# bg/ceo/ceo.rpy:931
translate russian meeting_aletta_06_male_94ac4f42:
    "Уильям" "Сэр, некоторые двери открываются лишь однажды."

# bg/ceo/ceo.rpy:933
translate russian meeting_aletta_06_male_f0e37cf9:
    "Алетта права насчёт риска, а Уильям — насчёт возможности."

# bg/ceo/ceo.rpy:934
translate russian meeting_aletta_06_male_ce791789:
    "Было бы куда проще, если бы хоть кто-то из них хоть раз ошибался!"

# bg/ceo/ceo.rpy:937
translate russian meeting_aletta_06_male_ca988e62:
    "Я качаю головой, ясно показывая своё отношение."

# bg/ceo/ceo.rpy:938
translate russian meeting_aletta_06_male_5d95ecf0:
    mike.say "Отказываемся от покупки. Мы не готовы."

# bg/ceo/ceo.rpy:940
translate russian meeting_aletta_06_male_fc90a528:
    "Алетта выглядит облегчённой и, возможно, даже немного самодовольной."

# bg/ceo/ceo.rpy:942
translate russian meeting_aletta_06_male_67bd0357:
    aletta.say "Это правильный ответ, даже если сейчас так не кажется."

# bg/ceo/ceo.rpy:945
translate russian meeting_aletta_06_male_5e9eff58:
    "Разумеется, Уильям с ней не согласен."

# bg/ceo/ceo.rpy:948
translate russian meeting_aletta_06_male_f8835f80:
    "Уильям" "Босс, вы правда оставите четыреста клиентов валяться на полу, чтобы их подобрал конкурент?"

# bg/ceo/ceo.rpy:949
translate russian meeting_aletta_06_male_8b7ea186:
    mike.say "Нет, Уильям. Я отказываюсь от четырёхсот клиентов, о которых мы не сможем позаботиться."

# bg/ceo/ceo.rpy:950
translate russian meeting_aletta_06_male_1c02c21f:
    "Уильям" "Понимаю, сэр. И уважаю вашу выдержку."

# bg/ceo/ceo.rpy:953
translate russian meeting_aletta_06_male_95151152:
    "По тому, как Уильям это произносит, я понимаю: на этом разговор не закончится."

# bg/ceo/ceo.rpy:954
translate russian meeting_aletta_06_male_cc55331f:
    "Далеко не закончится."

# bg/ceo/ceo.rpy:958
translate russian meeting_aletta_06_male_2949736e:
    "Я киваю, чуть ли не подгоняя их."

# bg/ceo/ceo.rpy:960
translate russian meeting_aletta_06_male_33178cf4:
    mike.say "Покупаем. Начинайте прямо сейчас, хорошо?"

# bg/ceo/ceo.rpy:963
translate russian meeting_aletta_06_male_32c453d1:
    "Уильям подхватывает приказ, горя желанием его исполнить."

# bg/ceo/ceo.rpy:964
translate russian meeting_aletta_06_male_b3642f7e:
    "Уильям" "Конечно, босс! Всё оформлю, пока остальные даже не успели узнать!"

# bg/ceo/ceo.rpy:965
translate russian meeting_aletta_06_male_6a20a80d:
    "Я качаю головой."

# bg/ceo/ceo.rpy:966
translate russian meeting_aletta_06_male_c4743b28:
    mike.say "Но сначала введите в курс дела Артура и Энтони."

# bg/ceo/ceo.rpy:967
translate russian meeting_aletta_06_male_16929bb0:
    "Уильям" "Сначала введём в курс. Само собой!"

# bg/ceo/ceo.rpy:970
translate russian meeting_aletta_06_male_cd7d858c:
    "Алетта всем этим явно не впечатлена."

# bg/ceo/ceo.rpy:972
translate russian meeting_aletta_06_male_575f8d0a:
    aletta.say "Мне понадобятся восемь новых сотрудников. И нужны они были ещё месяц назад!"

# bg/ceo/ceo.rpy:973
translate russian meeting_aletta_06_male_486e00c5:
    aletta.say "И через три месяца вспомни, что я тебя предупреждала."

# bg/ceo/ceo.rpy:975
translate russian meeting_aletta_06_male_376432e4:
    "Я демонстративно записываю слова Алетты. Кажется, это меньшее, что я могу сделать."

# bg/ceo/ceo.rpy:989
translate russian result_meeting_aletta_06_male_eba834ce:
    "Во всём офисе царит хаос: телефоны разрываются, люди начинают паниковать."

# bg/ceo/ceo.rpy:991
translate russian result_meeting_aletta_06_male_3109e390:
    aletta.say "Восемь новых сотрудников, четверо — ошибка. С момента подписания я толком не спала."

# bg/ceo/ceo.rpy:993
translate russian result_meeting_aletta_06_male_78662e7f:
    aletta.say "Но из четырёхсот клиентов остались триста шестьдесят. Триста шестьдесят, [lssb_common.hero_name()]!"

# bg/ceo/ceo.rpy:994
translate russian result_meeting_aletta_06_male_8f6a3505:
    aletta.say "Пройдёт восемнадцать месяцев, прежде чем этот отдел перестанет напоминать две компании, столкнувшиеся в автомобильной аварии."

# bg/ceo/ceo.rpy:996
translate russian result_meeting_aletta_06_male_ece0cf98:
    "Когда Энтони вступает в разговор, он звучит оптимистичнее Алетты."

# bg/ceo/ceo.rpy:999
translate russian result_meeting_aletta_06_male_5db7af6b:
    "Энтони" "Текущий темп выручки вырос на тридцать восемь процентов."

# bg/ceo/ceo.rpy:1000
translate russian result_meeting_aletta_06_male_da655d96:
    "Энтони" "При нынешних показателях покупка окупится за четырнадцать месяцев."

# bg/ceo/ceo.rpy:1003
translate russian result_meeting_aletta_06_male_93e5370e:
    "Уильям" "Я же говорил, босс!"

# bg/ceo/ceo.rpy:1006
translate russian result_meeting_aletta_06_male_5b305049:
    aletta.say "Это не повод становиться невыносимым, Уильям!"

# bg/ceo/ceo.rpy:1009
translate russian result_meeting_aletta_06_male_181737fb:
    "Уильям" "О, по-моему, этот рубеж мы уже прошли."

# bg/ceo/ceo.rpy:1011
translate russian result_meeting_aletta_06_male_5be21ec0:
    "Сомневаюсь, что он нарочно, но это самое смешное, что я когда-либо слышал от Уильяма."

# bg/ceo/ceo.rpy:1016
translate russian result_meeting_aletta_06_male_98f585f2:
    "Плохие новости приносит Алетта."

# bg/ceo/ceo.rpy:1018
translate russian result_meeting_aletta_06_male_c9974efe:
    aletta.say "«Веррин» только что объявили о покупке «Марроу»."

# bg/ceo/ceo.rpy:1019
translate russian result_meeting_aletta_06_male_522a7775:
    aletta.say "Это главная новость во всех отраслевых изданиях."

# bg/ceo/ceo.rpy:1020
translate russian result_meeting_aletta_06_male_88ce67dc:
    aletta.say "Двоим нашим клиентам уже предложили пакетную цену, с которой мы не можем соперничать."

# bg/ceo/ceo.rpy:1023
translate russian result_meeting_aletta_06_male_acb6dc5f:
    "Уильям" "Четыреста клиентов, босс. Я их посчитал!"

# bg/ceo/ceo.rpy:1024
translate russian result_meeting_aletta_06_male_a92d5d5c:
    mike.say "Уильям..."

# bg/ceo/ceo.rpy:1025
translate russian result_meeting_aletta_06_male_292ab236:
    "Уильям" "Больше ни слова об этом, обещаю."

# bg/ceo/ceo.rpy:1027
translate russian result_meeting_aletta_06_male_3934fa9c:
    "Зная Уильяма, сомневаюсь, что он сдержит обещание."

# bg/ceo/ceo.rpy:1029
translate russian result_meeting_aletta_06_male_cbb6b77e:
    aletta.say "Если это что-то значит, [lssb_common.hero_name()], я бы снова посоветовала то же самое."

# bg/ceo/ceo.rpy:1030
translate russian result_meeting_aletta_06_male_3438f25f:
    aletta.say "Решение было безопасным. Просто не правильным."

# bg/ceo/ceo.rpy:1032
translate russian result_meeting_aletta_06_male_e219c1bf:
    "Впервые слышу, чтобы Алетта признавала: это могут быть разные вещи."

# bg/ceo/ceo.rpy:1044
translate russian meeting_aletta_cassidy_01_male_011bc3b7:
    "Кэссиди находится в здании примерно одиннадцать минут, а уже успела довести кого-то до слёз."

# bg/ceo/ceo.rpy:1046
translate russian meeting_aletta_cassidy_01_male_cd369f0d:
    cassidy.say "Его зовут Белл, он здоровенный и пахнет кофе..."

# bg/ceo/ceo.rpy:1047
translate russian meeting_aletta_cassidy_01_male_39fbb447:
    cassidy.say "И он сказал мне... МНЕ... что я не могу находиться здесь без пропуска!"

# bg/ceo/ceo.rpy:1048
translate russian meeting_aletta_cassidy_01_male_dbeb8382:
    cassidy.say "Уволь его, [lssb_common.hero_name()], сейчас же! Это компания моего папочки, чёрт возьми!"

# bg/ceo/ceo.rpy:1050
translate russian meeting_aletta_cassidy_01_male_600dfafd:
    "Алетта раздражённо смотрит на Кэссиди и вмешивается в разговор."

# bg/ceo/ceo.rpy:1052
translate russian meeting_aletta_cassidy_01_male_74453dd3:
    aletta.say "Белл — единственный мастер, который может вести ночную смену от начала до конца. Девять лет подряд этим занимается."

# bg/ceo/ceo.rpy:1054
translate russian meeting_aletta_cassidy_01_male_14d3454c:
    aletta.say "И он прав. Без пропуска сюда нельзя никому: ни мне, ни даже тебе!"

# bg/ceo/ceo.rpy:1057
translate russian meeting_aletta_cassidy_01_male_c432c506:
    "Кэссиди хмуро смотрит на Алетту. Она не привыкла, чтобы её требования ставили под сомнение."

# bg/ceo/ceo.rpy:1059
translate russian meeting_aletta_cassidy_01_male_39b2cffc:
    cassidy.say "Тогда найди другого, кто сможет вести ночную смену. Не так уж это сложно."

# bg/ceo/ceo.rpy:1062
translate russian meeting_aletta_cassidy_01_male_041435cd:
    aletta.say "Во всей стране лишь трое умеют управлять этим производством. И один из них уже работает здесь."

# bg/ceo/ceo.rpy:1063
translate russian meeting_aletta_cassidy_01_male_3c58d3a8:
    aletta.say "То есть... Проблема с системой есть. Но надо исправить её, а не увольнять Белла."

# bg/ceo/ceo.rpy:1066
translate russian meeting_aletta_cassidy_01_male_7c1d128d:
    cassidy.say "[lssb_common.hero_name()]... Кто важнее: я или какая-то тупая машина?!"

# bg/ceo/ceo.rpy:1069
translate russian meeting_aletta_cassidy_01_male_5939c21f:
    aletta.say "Пожалуйста, можно я отвечу?"

# bg/ceo/ceo.rpy:1071
translate russian meeting_aletta_cassidy_01_male_238b13cb:
    "Хорошо, что здесь не открываются окна. Иначе возник бы соблазн выпрыгнуть."

# bg/ceo/ceo.rpy:1074
translate russian meeting_aletta_cassidy_01_male_c53452b5:
    "Я сочувственно смотрю на Кэссиди, но обращаюсь к Алетте."

# bg/ceo/ceo.rpy:1075
translate russian meeting_aletta_cassidy_01_male_3356d27e:
    mike.say "Просто уволь его, Алетта..."

# bg/ceo/ceo.rpy:1078
translate russian meeting_aletta_cassidy_01_male_c1b0d0a5:
    aletta.say "Ты же не серьёзно?!"

# bg/ceo/ceo.rpy:1080
translate russian meeting_aletta_cassidy_01_male_385d3d2c:
    mike.say "Слушай, он всего лишь один сотрудник. Я сказал: он уходит."

# bg/ceo/ceo.rpy:1082
translate russian meeting_aletta_cassidy_01_male_d22d4bb8:
    aletta.say "Пусть будет зафиксировано, что я была против."

# bg/ceo/ceo.rpy:1084
translate russian meeting_aletta_cassidy_01_male_56739b46:
    "В отличие от Алетты, Кэссиди в восторге от моего решения."

# bg/ceo/ceo.rpy:1086
translate russian meeting_aletta_cassidy_01_male_c4d52203:
    cassidy.say "О, [lssb_common.hero_name()], когда ты распоряжаешься, ты прямо мужчина моей мечты!"

# bg/ceo/ceo.rpy:1089
translate russian meeting_aletta_cassidy_01_male_5a8e3715:
    aletta.say "Ты только что показал всем, что родственные связи здесь важнее профессионализма."

# bg/ceo/ceo.rpy:1093
translate russian meeting_aletta_cassidy_01_male_fbeddf6d:
    "Алетта резко разворачивается и выходит, прежде чем я успеваю что-нибудь сказать."

# bg/ceo/ceo.rpy:1094
translate russian meeting_aletta_cassidy_01_male_a92cc0b2:
    "Но я быстро о ней забываю, видя, с каким обожанием Кэссиди сейчас на меня смотрит."

# bg/ceo/ceo.rpy:1099
translate russian meeting_aletta_cassidy_01_male_c53452b5_1:
    "Я сочувственно смотрю на Кэссиди, но обращаюсь к Алетте."

# bg/ceo/ceo.rpy:1100
translate russian meeting_aletta_cassidy_01_male_79306ee8:
    mike.say "Белл остаётся, Алетта. А систему допуска посетителей исправляем в этом месяце."

# bg/ceo/ceo.rpy:1102
translate russian meeting_aletta_cassidy_01_male_9569f21a:
    "Алетта с облегчением кивает, выслушав распоряжение."

# bg/ceo/ceo.rpy:1104
translate russian meeting_aletta_cassidy_01_male_722c40f6:
    aletta.say "Деньги уже заложены в бюджет. Прослежу, чтобы всё сделали."

# bg/ceo/ceo.rpy:1107
translate russian meeting_aletta_cassidy_01_male_8955b534:
    "Кэссиди, разумеется, принимает это куда хуже."

# bg/ceo/ceo.rpy:1109
translate russian meeting_aletta_cassidy_01_male_f2d96bef:
    cassidy.say "Невероятно... Просто невероятно!"

# bg/ceo/ceo.rpy:1111
translate russian meeting_aletta_cassidy_01_male_b5717b8d:
    mike.say "Кэссиди, человек просто делал свою работу."

# bg/ceo/ceo.rpy:1113
translate russian meeting_aletta_cassidy_01_male_8a1c3756:
    cassidy.say "Как ты можешь быть на его стороне?!"

# bg/ceo/ceo.rpy:1115
translate russian meeting_aletta_cassidy_01_male_115c8eb2:
    "Кэссиди топает ногой и дуется как ребёнок."

# bg/ceo/ceo.rpy:1117
translate russian meeting_aletta_cassidy_01_male_6ddca5ef:
    cassidy.say "Ладно. Но тогда я хочу собственный пропуск..."

# bg/ceo/ceo.rpy:1118
translate russian meeting_aletta_cassidy_01_male_4f98b8af:
    cassidy.say "Красивый. И с удачной фотографией!"

# bg/ceo/ceo.rpy:1120
translate russian meeting_aletta_cassidy_01_male_7e864015:
    mike.say "Будет тебе пропуск, Кэссиди."

# bg/ceo/ceo.rpy:1121
translate russian meeting_aletta_cassidy_01_male_9fc3a984:
    "Она уходит, немного успокоившись, и я наконец получаю минуту покоя."

# bg/ceo/ceo.rpy:1135
translate russian result_meeting_aletta_cassidy_01_male_66600542:
    "Алетта с гордостью перечисляет подробности новой системы допуска посетителей."

# bg/ceo/ceo.rpy:1137
translate russian result_meeting_aletta_cassidy_01_male_26265b64:
    aletta.say "Новая система уже работает."

# bg/ceo/ceo.rpy:1138
translate russian result_meeting_aletta_cassidy_01_male_811a28f8:
    aletta.say "За девяносто секунд она выдаёт пропуск с фотографией."

# bg/ceo/ceo.rpy:1141
translate russian result_meeting_aletta_cassidy_01_male_3a9e94b1:
    "Кэссиди показывает свой пропуск, явно от него в восторге."

# bg/ceo/ceo.rpy:1142
translate russian result_meeting_aletta_cassidy_01_male_da30dd44:
    cassidy.say "Мой просто шикарный! Я заставила их переснять фотографию раза четыре!"

# bg/ceo/ceo.rpy:1145
translate russian result_meeting_aletta_cassidy_01_male_eb57ea34:
    aletta.say "Белл очень помог с внедрением и с пониманием отнёсся к твоим опасениям."

# bg/ceo/ceo.rpy:1146
translate russian result_meeting_aletta_cassidy_01_male_b95b1276:
    aletta.say "Он согласился обучить двоих временных работников вести ночные смены вместе с ним."

# bg/ceo/ceo.rpy:1147
translate russian result_meeting_aletta_cassidy_01_male_9f3bfd2d:
    aletta.say "Раньше он никого обучать не соглашался."

# bg/ceo/ceo.rpy:1149
translate russian result_meeting_aletta_cassidy_01_male_056a0256:
    mike.say "Почему сейчас?"

# bg/ceo/ceo.rpy:1151
translate russian result_meeting_aletta_cassidy_01_male_ea53e78e:
    aletta.say "Потому что впервые за девять лет кто-то в этом кабинете поддержал его, а не того, кто на него орёт."

# bg/ceo/ceo.rpy:1153
translate russian result_meeting_aletta_cassidy_01_male_c4fb055f:
    "Кэссиди делает вид, что не слышит Алетту. Но я знаю: она услышала каждое слово."

# bg/ceo/ceo.rpy:1156
translate russian result_meeting_aletta_cassidy_01_male_cf4a0f83:
    "Сообщая плохие новости, Алетта качает головой."

# bg/ceo/ceo.rpy:1158
translate russian result_meeting_aletta_cassidy_01_male_f91731f4:
    aletta.say "Официально ночной смене понадобилось четыре дня, чтобы развалиться."

# bg/ceo/ceo.rpy:1160
translate russian result_meeting_aletta_cassidy_01_male_a594dbc3:
    aletta.say "Две остановки, чуть не случившаяся авария с погрузчиком и полный бардак: никто не знает, кто на самом деле главный."

# bg/ceo/ceo.rpy:1161
translate russian result_meeting_aletta_cassidy_01_male_aa9ca6e7:
    aletta.say "А Белл ушёл в «Веррин». Наверняка его сразу взяли за опыт работы у конкурента."

# bg/ceo/ceo.rpy:1167
translate russian result_meeting_aletta_cassidy_01_male_2a92ca58:
    "Энтони" "Одни только потери выпуска — шестьдесят две тысячи. И это до повышения страхового взноса."

# bg/ceo/ceo.rpy:1170
translate russian result_meeting_aletta_cassidy_01_male_e443b1da:
    "Кэссиди закатывает глаза и качает головой."

# bg/ceo/ceo.rpy:1172
translate russian result_meeting_aletta_cassidy_01_male_a3f12f15:
    cassidy.say "Бла-бла-бла... Так наймите уже кого-нибудь другого."

# bg/ceo/ceo.rpy:1175
translate russian result_meeting_aletta_cassidy_01_male_2c3b147e:
    aletta.say "В стране осталось двое подходящих людей, а третий теперь работает на «Веррин»."

# bg/ceo/ceo.rpy:1177
translate russian result_meeting_aletta_cassidy_01_male_4aa0419f:
    cassidy.say "Ой... Упс..."

# bg/ceo/ceo.rpy:1179
translate russian result_meeting_aletta_cassidy_01_male_544c80ca:
    "Впервые вижу, как Кэссиди прямо на моих глазах осознаёт, что человек — не вещь."

# bg/ceo/ceo.rpy:1180
translate russian result_meeting_aletta_cassidy_01_male_4e3eea80:
    "Для неё это нравственный урок. Для компании — крайне дорогой."

# bg/ceo/ceo.rpy:1192
translate russian meeting_aletta_cassidy_02_male_89baaea8:
    "Сегодня Алетта собранна и вводит меня в курс последних дел."

# bg/ceo/ceo.rpy:1194
translate russian meeting_aletta_cassidy_02_male_691bdad8:
    aletta.say "«Острандер» просрочили четыре счёта на девяносто один день. А теперь ещё требуют скидку за задержку, которую сами устроили."

# bg/ceo/ceo.rpy:1195
translate russian meeting_aletta_cassidy_02_male_2ff12f7b:
    aletta.say "Но я хочу их сохранить. Их имя фигурирует в каждом нашем предложении, и новые клиенты приходят к нам потому, что мы работаем с «Острандер»."

# bg/ceo/ceo.rpy:1198
translate russian meeting_aletta_cassidy_02_male_c62301a7:
    "Кэссиди вздыхает и качает головой."

# bg/ceo/ceo.rpy:1200
translate russian meeting_aletta_cassidy_02_male_e103e079:
    cassidy.say "Милый, позволю себе смелость: избавься от них."

# bg/ceo/ceo.rpy:1201
translate russian meeting_aletta_cassidy_02_male_edcdb1f3:
    cassidy.say "Их председателя зовут Фредди. Я дважды с ним ужинала, и он полный мошенник."

# bg/ceo/ceo.rpy:1202
translate russian meeting_aletta_cassidy_02_male_3252c933:
    cassidy.say "Два года назад он занял денег у папочки. А папочка никогда никому не давал в долг, если не собирался получать удовольствие от взыскания."

# bg/ceo/ceo.rpy:1205
translate russian meeting_aletta_cassidy_02_male_6adad99a:
    aletta.say "Кэссиди, мы не можем принимать деловые решения по качеству твоих свиданий за ужином!"

# bg/ceo/ceo.rpy:1208
translate russian meeting_aletta_cassidy_02_male_9e8e5417:
    cassidy.say "Тогда как тебе это: две ваши сотрудницы, работающие с клиентами, зовут его «лапучий Фредди»..."

# bg/ceo/ceo.rpy:1209
translate russian meeting_aletta_cassidy_02_male_a6dbc0e3:
    cassidy.say "Я подслушала их в лифте."

# bg/ceo/ceo.rpy:1212
translate russian meeting_aletta_cassidy_02_male_6f6bd4e4:
    aletta.say "Правда?!"

# bg/ceo/ceo.rpy:1214
translate russian meeting_aletta_cassidy_02_male_251cd012:
    aletta.say "Первый раз об этом слышу."

# bg/ceo/ceo.rpy:1216
translate russian meeting_aletta_cassidy_02_male_a76e4739:
    "Так, кажется, дело уже не только в неоплаченных счетах!"

# bg/ceo/ceo.rpy:1219
translate russian meeting_aletta_cassidy_02_male_432cc0b5:
    "Я изо всех сил стараюсь выглядеть серьёзно и по-деловому."

# bg/ceo/ceo.rpy:1221
translate russian meeting_aletta_cassidy_02_male_988cfd73:
    mike.say "Мы продолжаем с ними работать. И точка."

# bg/ceo/ceo.rpy:1222
translate russian meeting_aletta_cassidy_02_male_341fc523:
    mike.say "Алетта, настойчиво добивайся оплаты. И пусть с этим клиентом работает кто-то старший, а не новичок!"

# bg/ceo/ceo.rpy:1223
translate russian meeting_aletta_cassidy_02_male_7c643b64:
    "Алетта кивает и уже собирает бумаги."

# bg/ceo/ceo.rpy:1225
translate russian meeting_aletta_cassidy_02_male_dc3518eb:
    aletta.say "Согласна. На этот квартал возьму его на себя."

# bg/ceo/ceo.rpy:1228
translate russian meeting_aletta_cassidy_02_male_1c0565dc:
    "А вот Кэссиди, похоже, это впечатляет куда меньше."

# bg/ceo/ceo.rpy:1230
translate russian meeting_aletta_cassidy_02_male_9e6c482a:
    cassidy.say "То есть ты оставляешь лапучего Фредди, потому что его имя хорошо смотрится в ваших буклетах?"

# bg/ceo/ceo.rpy:1232
translate russian meeting_aletta_cassidy_02_male_8298329c:
    mike.say "Я сохраняю то, что обеспечивает зарплату двумстам людям, Кэссиди..."

# bg/ceo/ceo.rpy:1233
translate russian meeting_aletta_cassidy_02_male_3f99f642:
    mike.say "Но самим этим человеком я вовсе не доволен, поверь."

# bg/ceo/ceo.rpy:1235
translate russian meeting_aletta_cassidy_02_male_34f5da83:
    cassidy.say "Ого. Сейчас ты говорил совсем как папочка!"

# bg/ceo/ceo.rpy:1237
translate russian meeting_aletta_cassidy_02_male_9cb91c45:
    "Эти слова бьют меня под дых."

# bg/ceo/ceo.rpy:1239
translate russian meeting_aletta_cassidy_02_male_63d5de60:
    "И Кэссиди уходит, прежде чем я успеваю ответить."

# bg/ceo/ceo.rpy:1244
translate russian meeting_aletta_cassidy_02_male_ef2d89ef:
    "Я качаю головой, не скрывая отвращения."

# bg/ceo/ceo.rpy:1245
translate russian meeting_aletta_cassidy_02_male_4d9c23f9:
    mike.say "Мы прекращаем сотрудничество. Точка."

# bg/ceo/ceo.rpy:1246
translate russian meeting_aletta_cassidy_02_male_2a67bc3d:
    mike.say "Алетта, заверши всё как положено. И я хочу поговорить со всеми, кто вёл этого клиента."

# bg/ceo/ceo.rpy:1248
translate russian meeting_aletta_cassidy_02_male_003390eb:
    "Алетта моргает, искренне поражённая."

# bg/ceo/ceo.rpy:1250
translate russian meeting_aletta_cassidy_02_male_6b78856d:
    aletta.say "Это четыре процента всей нашей выручки, [lssb_common.hero_name()]!"

# bg/ceo/ceo.rpy:1252
translate russian meeting_aletta_cassidy_02_male_3f1fba9f:
    mike.say "Сотрудницы уже придумали прозвище для его повадок, Алетта. С ним покончено!"

# bg/ceo/ceo.rpy:1254
translate russian meeting_aletta_cassidy_02_male_595c7f8d:
    aletta.say "Да... Да, ты прав."

# bg/ceo/ceo.rpy:1255
translate russian meeting_aletta_cassidy_02_male_90266003:
    aletta.say "Надо было разобраться глубже. Это моя ошибка."

# bg/ceo/ceo.rpy:1258
translate russian meeting_aletta_cassidy_02_male_62d329bd:
    cassidy.say "Видишь, какой полезной я могу быть?"

# bg/ceo/ceo.rpy:1259
translate russian meeting_aletta_cassidy_02_male_5be4ca75:
    cassidy.say "Запиши это где-нибудь и запомни!"

# bg/ceo/ceo.rpy:1261
translate russian meeting_aletta_cassidy_02_male_8271f646:
    "На этот раз Кэссиди и правда удалось доказать свою ценность."

# bg/ceo/ceo.rpy:1276
translate russian result_meeting_aletta_cassidy_02_male_187586da:
    "Алетта рассказывает о последствиях с облегчением в голосе."

# bg/ceo/ceo.rpy:1278
translate russian result_meeting_aletta_cassidy_02_male_9c314e92:
    aletta.say "«Острандер» официально перешли под внешнее управление. И нас за собой на дно не потащат."

# bg/ceo/ceo.rpy:1281
translate russian result_meeting_aletta_cassidy_02_male_9608d832:
    "Энтони" "Мы завершили сотрудничество, получив оплату по трём из четырёх счетов."

# bg/ceo/ceo.rpy:1282
translate russian result_meeting_aletta_cassidy_02_male_2fc0fb67:
    "Энтони" "По четвёртому списываем девятнадцать тысяч. Дёшево по сравнению с тем, что случилось с ними!"

# bg/ceo/ceo.rpy:1285
translate russian result_meeting_aletta_cassidy_02_male_74ea83c8:
    aletta.say "Освободившиеся мощности уже заняты двумя средними клиентами с лучшей рентабельностью. И ни у кого из них нет такого прозвища."

# bg/ceo/ceo.rpy:1286
translate russian result_meeting_aletta_cassidy_02_male_0dfcc4a3:
    aletta.say "Ко мне пришла менеджер, которая вела «Острандер». Она уже восемь месяцев просила перевести её."

# bg/ceo/ceo.rpy:1288
translate russian result_meeting_aletta_cassidy_02_male_8f602fc3:
    mike.say "И?"

# bg/ceo/ceo.rpy:1290
translate russian result_meeting_aletta_cassidy_02_male_d29c23ce:
    aletta.say "И спросила, почему понадобилось, чтобы дочь Дуэйна что-то подслушала в лифте, прежде чем были приняты меры."

# bg/ceo/ceo.rpy:1293
translate russian result_meeting_aletta_cassidy_02_male_c5827304:
    cassidy.say "Извините, но я член совета директоров, а не просто чья-то дочь!"

# bg/ceo/ceo.rpy:1295
translate russian result_meeting_aletta_cassidy_02_male_0f8a5fc7:
    "Кэссиди какое-то время будет невыносима. Но хотя бы заслужила."

# bg/ceo/ceo.rpy:1300
translate russian result_meeting_aletta_cassidy_02_male_fa905146:
    "Алетта рассказывает о последствиях с ужасом в голосе."

# bg/ceo/ceo.rpy:1302
translate russian result_meeting_aletta_cassidy_02_male_4915259a:
    aletta.say "«Острандер» официально перешли под внешнее управление."

# bg/ceo/ceo.rpy:1305
translate russian result_meeting_aletta_cassidy_02_male_40fd659d:
    "Энтони" "Четыре неоплаченных счёта, двести сорок тысяч. А в очереди кредиторов мы стоим после банков."

# bg/ceo/ceo.rpy:1306
translate russian result_meeting_aletta_cassidy_02_male_f42fb5ea:
    "Энтони" "Получим, возможно, процентов семнадцать, если повезёт."

# bg/ceo/ceo.rpy:1309
translate russian result_meeting_aletta_cassidy_02_male_7038f8a9:
    aletta.say "И ссылка на них теперь ничего не стоит. Никому не хочется быть теми, кто работал с «Острандер»."

# bg/ceo/ceo.rpy:1311
translate russian result_meeting_aletta_cassidy_02_male_e80e52ed:
    aletta.say "Две мои менеджерши рассказали, как этот человек вёл себя на встречах."

# bg/ceo/ceo.rpy:1312
translate russian result_meeting_aletta_cassidy_02_male_6777a104:
    aletta.say "Это продолжалось год, прежде чем мне пришло в голову разобраться."

# bg/ceo/ceo.rpy:1314
translate russian result_meeting_aletta_cassidy_02_male_b75cf5ac:
    mike.say "Признайте, Кэссиди всё предвидела."

# bg/ceo/ceo.rpy:1316
translate russian result_meeting_aletta_cassidy_02_male_cdd05319:
    aletta.say "Кэссиди предвидела это благодаря своим сотрапезникам!"

# bg/ceo/ceo.rpy:1318
translate russian result_meeting_aletta_cassidy_02_male_2712f37a:
    "Рассказывая обо всём Кэссиди, я ожидаю злорадства."

# bg/ceo/ceo.rpy:1319
translate russian result_meeting_aletta_cassidy_02_male_44a2a63e:
    "Но она не злорадствует, и это, пожалуй, тревожит сильнее всего."

# bg/ceo/ceo.rpy:1331
translate russian meeting_aletta_cherie_01_male_c621e3f7:
    "Шери появляется в своём обычном стиле: на двадцать минут раньше, совершенно невозмутимая. Рядом с ней комната почему-то кажется плохо освещённой."

# bg/ceo/ceo.rpy:1333
translate russian meeting_aletta_cherie_01_male_2d93fc67:
    cherie.say "Банк «Братья Хэвлок» попросил о встрече, мон ами..."

# bg/ceo/ceo.rpy:1334
translate russian meeting_aletta_cherie_01_male_4f2793da:
    cherie.say "Они наши кредиторы. За девять лет ни разу не просили о встрече."

# bg/ceo/ceo.rpy:1335
translate russian meeting_aletta_cherie_01_male_07d71cb5:
    cherie.say "Я знаю его ещё с тех пор, когда он не был тем самым Джулианом Хэвлоком. Поэтому приглашу его на ужин."

# bg/ceo/ceo.rpy:1336
translate russian meeting_aletta_cherie_01_male_62875de2:
    cherie.say "Банк перестаёт нервничать не из-за документа, а потому, что кто-то, кому он доверяет, говорит ему успокоиться."

# bg/ceo/ceo.rpy:1338
translate russian meeting_aletta_cherie_01_male_5d5bad87:
    "Едва Шери заканчивает, Алетта тут же вступает в разговор."

# bg/ceo/ceo.rpy:1340
translate russian meeting_aletta_cherie_01_male_95cd5d50:
    aletta.say "При всём уважении, Шери, важные решения принимает не Джулиан Хэвлок."

# bg/ceo/ceo.rpy:1342
translate russian meeting_aletta_cherie_01_male_3f85a290:
    aletta.say "Их принимает кредитный комитет: девять человек в комнате в другом городе. Они никого из нас не встречали и никогда не встретят."

# bg/ceo/ceo.rpy:1343
translate russian meeting_aletta_cherie_01_male_a4ed2609:
    aletta.say "Им нужны проверенная отчётность, запас по кредитным ограничениям и письменный план на четыре квартала. А не приглашение на ужин!"

# bg/ceo/ceo.rpy:1346
translate russian meeting_aletta_cherie_01_male_084afb16:
    cherie.say "Ты говоришь так, будто люди перестали что-либо значить, Алетта..."

# bg/ceo/ceo.rpy:1349
translate russian meeting_aletta_cherie_01_male_759699e2:
    aletta.say "В этом случае так и есть. Вино и ужин с Джулианом Хэвлоком никак не повлияют на решение комитета."

# bg/ceo/ceo.rpy:1351
translate russian meeting_aletta_cherie_01_male_1cf4be78:
    "Шери не спорит. Вместо этого смотрит мне прямо в глаза."

# bg/ceo/ceo.rpy:1352
translate russian meeting_aletta_cherie_01_male_aaa6bcdd:
    "Значит, мне снова придётся вмешаться и рассудить их."

# bg/ceo/ceo.rpy:1355
translate russian meeting_aletta_cherie_01_male_4c72744e:
    "Я пожимаю плечами и качаю головой."

# bg/ceo/ceo.rpy:1356
translate russian meeting_aletta_cherie_01_male_b0efb222:
    mike.say "Отправляем документы. Полную проверенную отчётность, запас по ограничениям, план на четыре квартала."

# bg/ceo/ceo.rpy:1357
translate russian meeting_aletta_cherie_01_male_64e957fe:
    "Алетта улыбается и коротко кивает."

# bg/ceo/ceo.rpy:1359
translate russian meeting_aletta_cherie_01_male_28a0b6e7:
    aletta.say "До ухода подготовим всё с Энтони."

# bg/ceo/ceo.rpy:1360
translate russian meeting_aletta_cherie_01_male_fdce53ba:
    aletta.say "Сразу отправим, как закончим."

# bg/ceo/ceo.rpy:1363
translate russian meeting_aletta_cherie_01_male_d5d4a977:
    "Шери отворачивается и хмурится."

# bg/ceo/ceo.rpy:1365
translate russian meeting_aletta_cherie_01_male_3e511472:
    cherie.say "Если так необходимо..."

# bg/ceo/ceo.rpy:1367
translate russian meeting_aletta_cherie_01_male_7b230180:
    mike.say "Можешь всё равно позвонить Хэвлоку, Шери..."

# bg/ceo/ceo.rpy:1369
translate russian meeting_aletta_cherie_01_male_aca51764:
    cherie.say "Нет, вы уже выбрали порядок действий, мон ами..."

# bg/ceo/ceo.rpy:1370
translate russian meeting_aletta_cherie_01_male_501ef6e9:
    cherie.say "Вы доросли до этого кресла, и теперь оно начинает менять вас."

# bg/ceo/ceo.rpy:1372
translate russian meeting_aletta_cherie_01_male_2c707bce:
    "Не пойму, это комплимент или оскорбление."

# bg/ceo/ceo.rpy:1377
translate russian meeting_aletta_cherie_01_male_e2b4664e:
    "Я пожимаю плечами и киваю Шери."

# bg/ceo/ceo.rpy:1378
translate russian meeting_aletta_cherie_01_male_3826305f:
    mike.say "Что мы теряем?"

# bg/ceo/ceo.rpy:1379
translate russian meeting_aletta_cherie_01_male_59ac31d2:
    mike.say "Пригласи его на ужин и послушай, что он скажет."

# bg/ceo/ceo.rpy:1381
translate russian meeting_aletta_cherie_01_male_20e76f43:
    "Шери улыбается, довольная, что я на её стороне."

# bg/ceo/ceo.rpy:1383
translate russian meeting_aletta_cherie_01_male_4d75fe0f:
    cherie.say "Я буду очаровательна, а он — болтлив. Как всегда."

# bg/ceo/ceo.rpy:1385
translate russian meeting_aletta_cherie_01_male_8e72eff6:
    "Алетта, однако, хмурит брови."

# bg/ceo/ceo.rpy:1387
translate russian meeting_aletta_cherie_01_male_6055e3d4:
    aletta.say "А официальные каналы?"

# bg/ceo/ceo.rpy:1389
translate russian meeting_aletta_cherie_01_male_f7d64608:
    mike.say "Пусть Шери сначала попробует по-своему, Алетта..."

# bg/ceo/ceo.rpy:1391
translate russian meeting_aletta_cherie_01_male_950e146a:
    aletta.say "К тому времени они уже всё решат!"

# bg/ceo/ceo.rpy:1393
translate russian meeting_aletta_cherie_01_male_f0654260:
    aletta.say "Я всё равно подготовлю документы."

# bg/ceo/ceo.rpy:1394
translate russian meeting_aletta_cherie_01_male_fcfdf09b:
    aletta.say "Кто знает, может, ещё спасибо скажешь."

# bg/ceo/ceo.rpy:1396
translate russian meeting_aletta_cherie_01_male_f9d67d95:
    "Она произносит {i}«ещё»{/i} так, как другие произносят {i}«когда всё пойдёт наперекосяк»{/i}."

# bg/ceo/ceo.rpy:1411
translate russian result_meeting_aletta_cherie_01_male_3c8c2c64:
    "Алетта излагает факты, не щадя ничьих чувств и не заботясь о неловкости."

# bg/ceo/ceo.rpy:1412
translate russian result_meeting_aletta_cherie_01_male_58cf2f73:
    aletta.say "Документы отправлены. Двести пять страниц, и Энтони каждую вычитал дважды."

# bg/ceo/ceo.rpy:1414
translate russian result_meeting_aletta_cherie_01_male_e44d150b:
    "Энтони" "Комитет Хэвлока провёл заседание. Кредитную линию подтвердили, досрочную проверку условий отменили."

# bg/ceo/ceo.rpy:1415
translate russian result_meeting_aletta_cherie_01_male_6f327ca0:
    "Энтони" "В их ответе есть формулировка {i}«существенное улучшение раскрытия информации»{/i}. Для банка это любовное письмо!"

# bg/ceo/ceo.rpy:1417
translate russian result_meeting_aletta_cherie_01_male_b4ba650b:
    "Шери фыркает."

# bg/ceo/ceo.rpy:1419
translate russian result_meeting_aletta_cherie_01_male_e9dcf619:
    cherie.say "После этого Джулиан позвонил мне и сказал, как они впечатлены."

# bg/ceo/ceo.rpy:1421
translate russian result_meeting_aletta_cherie_01_male_519264cd:
    cherie.say "Я позволила ему считать это моей идеей. Мне ничего не стоит, а у него останутся приятные воспоминания."

# bg/ceo/ceo.rpy:1424
translate russian result_meeting_aletta_cherie_01_male_f4de4ba2:
    aletta.say "Только для этой части она мне и понадобилась."

# bg/ceo/ceo.rpy:1427
translate russian result_meeting_aletta_cherie_01_male_73461ab8:
    cherie.say "Только для этой части я кому-либо и нужна. Давно с этим смирилась."

# bg/ceo/ceo.rpy:1429
translate russian result_meeting_aletta_cherie_01_male_7874b2ed:
    "Наблюдать за их перепалкой — всё равно что смотреть, как две львицы оценивают друг друга."

# bg/ceo/ceo.rpy:1431
translate russian result_meeting_aletta_cherie_01_male_d0a0d71b:
    "Шери рассказывает о своём ужине с Джулианом Хэвлоком."

# bg/ceo/ceo.rpy:1433
translate russian result_meeting_aletta_cherie_01_male_e4b6c55a:
    cherie.say "Ужин прошёл триумфально. Джулиан был в восторге, совершенно успокоился..."

# bg/ceo/ceo.rpy:1436
translate russian result_meeting_aletta_cherie_01_male_bdfe79c1:
    aletta.say "И ничего от него не зависело!"

# bg/ceo/ceo.rpy:1439
translate russian result_meeting_aletta_cherie_01_male_05a89612:
    cherie.say "Он позвонил, извинился и сказал, что ничего не может сделать."

# bg/ceo/ceo.rpy:1442
translate russian result_meeting_aletta_cherie_01_male_f9cb7327:
    "Энтони" "Комитет сократил кредитную линию на два миллиона и восстановил ежеквартальную проверку кредитных условий."

# bg/ceo/ceo.rpy:1443
translate russian result_meeting_aletta_cherie_01_male_bb5a9f03:
    "Энтони" "В ответе они ссылаются, цитирую, на {i}«недостаточную прозрачность планов руководства»{/i}."

# bg/ceo/ceo.rpy:1445
translate russian result_meeting_aletta_cherie_01_male_e2bc1d41:
    mike.say "Им нужны были документы?"

# bg/ceo/ceo.rpy:1447
translate russian result_meeting_aletta_cherie_01_male_92ae4fcd:
    "Энтони" "Им нужны были документы, и они просили документы."

# bg/ceo/ceo.rpy:1448
translate russian result_meeting_aletta_cherie_01_male_2adf57b2:
    "Энтони" "Я тогда об этом упоминал. Признаю, не слишком громко."

# bg/ceo/ceo.rpy:1451
translate russian result_meeting_aletta_cherie_01_male_1e6443c7:
    aletta.say "Документы готовы. Я всё равно их подготовила."

# bg/ceo/ceo.rpy:1453
translate russian result_meeting_aletta_cherie_01_male_8b0617bb:
    aletta.say "Но теперь их воспримут как реакцию на плохие новости, а не как план."

# bg/ceo/ceo.rpy:1454
translate russian result_meeting_aletta_cherie_01_male_7054c71a:
    aletta.say "Это уже другой документ, что бы в нём ни было написано."

# bg/ceo/ceo.rpy:1457
translate russian result_meeting_aletta_cherie_01_male_197f673b:
    cherie.say "Простите, мон ами. Я понимала человека, но не понимала систему."

# bg/ceo/ceo.rpy:1459
translate russian result_meeting_aletta_cherie_01_male_246b6eac:
    "Впервые вижу, чтобы Шери за что-нибудь извинялась и действительно об этом сожалела."

# bg/ceo/ceo.rpy:1471
translate russian meeting_aletta_cherie_02_male_59665ae5:
    "Алетта явно раздражена, когда начинает рассказывать."

# bg/ceo/ceo.rpy:1473
translate russian meeting_aletta_cherie_02_male_ab669a9b:
    aletta.say "Джеральд Пот. Шестнадцать лет в закупках, потом Дуэйн выдавил его за восемь месяцев до... ну, ты знаешь, до чего."

# bg/ceo/ceo.rpy:1474
translate russian meeting_aletta_cherie_02_male_57b33305:
    aletta.say "Он обзванивает журналистов, а двое из них уже позвонили нам. Говорит, что вёл записи."

# bg/ceo/ceo.rpy:1476
translate russian meeting_aletta_cherie_02_male_44b4b658:
    aletta.say "Через шесть дней Артур может получить судебный запрет: конфиденциальность, запрет на порочащие заявления и всё остальное."

# bg/ceo/ceo.rpy:1477
translate russian meeting_aletta_cherie_02_male_a14f4779:
    aletta.say "Затыкаем ему рот и всё отрицаем."

# bg/ceo/ceo.rpy:1480
translate russian meeting_aletta_cherie_02_male_6085f638:
    "Шери приподнимает брови: всё это явно её заинтересовало."

# bg/ceo/ceo.rpy:1482
translate russian meeting_aletta_cherie_02_male_e7f397b1:
    cherie.say "А что именно ты собираешься отрицать?"

# bg/ceo/ceo.rpy:1485
translate russian meeting_aletta_cherie_02_male_f6a70ef7:
    aletta.say "Ну, я..."

# bg/ceo/ceo.rpy:1488
translate russian meeting_aletta_cherie_02_male_a5d2677a:
    cherie.say "Он написал мне четыре письма, знаешь ли."

# bg/ceo/ceo.rpy:1489
translate russian meeting_aletta_cherie_02_male_7f38ebd5:
    cherie.say "И ни в одном не попросил денег."

# bg/ceo/ceo.rpy:1491
translate russian meeting_aletta_cherie_02_male_b3f1e8e2:
    cherie.say "Если бы ему нужны были деньги, ко второму письму он уже назвал бы сумму. Значит, ему нужно совсем другое."

# bg/ceo/ceo.rpy:1492
translate russian meeting_aletta_cherie_02_male_7f662828:
    cherie.say "Я знаю, каково это, когда тебе дают почувствовать, будто тебя здесь никогда и не было, мон ами..."

# bg/ceo/ceo.rpy:1495
translate russian meeting_aletta_cherie_02_male_10cbfe65:
    aletta.say "А если ты ошибаешься, мы сами пригласим человека с компроматом на нас и позволим ему закинуть ноги на стол!"

# bg/ceo/ceo.rpy:1498
translate russian meeting_aletta_cherie_02_male_6a677266:
    cherie.say "А если ошибаешься ты, мы сделаем из него мученика с адвокатом."

# bg/ceo/ceo.rpy:1499
translate russian meeting_aletta_cherie_02_male_a5953f98:
    cherie.say "И каждый журналист в стране захочет узнать, сколько компания, которой нечего скрывать, тратит на судебные запреты."

# bg/ceo/ceo.rpy:1501
translate russian meeting_aletta_cherie_02_male_51957e59:
    "Кажется, я начинаю понимать, почему Дуэйн держал этих двоих на разных этажах."

# bg/ceo/ceo.rpy:1504
translate russian meeting_aletta_cherie_02_male_995d914d:
    "Я указываю на Шери, давая понять, что обращаюсь к ней."

# bg/ceo/ceo.rpy:1505
translate russian meeting_aletta_cherie_02_male_28119eb9:
    mike.say "Пригласите его. Шери, поговоришь с ним?"

# bg/ceo/ceo.rpy:1507
translate russian meeting_aletta_cherie_02_male_4401f0e1:
    cherie.say "Конечно, мон ами. Я распоряжусь, чтобы принесли хороший кофе."

# bg/ceo/ceo.rpy:1510
translate russian meeting_aletta_cherie_02_male_d766ff4d:
    "Алетта качает головой, явно недовольная."

# bg/ceo/ceo.rpy:1512
translate russian meeting_aletta_cherie_02_male_0ab280a5:
    aletta.say "Это ошибка, [lssb_common.hero_name()]..."

# bg/ceo/ceo.rpy:1514
translate russian meeting_aletta_cherie_02_male_cba26494:
    mike.say "Значит, за эту ошибку отвечать мне."

# bg/ceo/ceo.rpy:1515
translate russian meeting_aletta_cherie_02_male_47fbd361:
    mike.say "Артур всегда сможет придержать судебный запрет на крайний случай."

# bg/ceo/ceo.rpy:1517
translate russian meeting_aletta_cherie_02_male_043eae66:
    aletta.say "Артур будет в восторге. Он обожает быть запасным вариантом!"

# bg/ceo/ceo.rpy:1520
translate russian meeting_aletta_cherie_02_male_2a6d96ab:
    cherie.say "Алетта, тебе тоже стоит прийти на встречу. Джеральду важно увидеть, что кто-то из руководства им интересуется."

# bg/ceo/ceo.rpy:1523
translate russian meeting_aletta_cherie_02_male_466b9dbf:
    aletta.say "Если считаешь, что это поможет... Ладно, приду."

# bg/ceo/ceo.rpy:1525
translate russian meeting_aletta_cherie_02_male_b54e99a3:
    "Впервые вижу, как они работают сообща после того случая с телом одного человека..."

# bg/ceo/ceo.rpy:1530
translate russian meeting_aletta_cherie_02_male_fca1bc79:
    "Я указываю на Алетту, давая понять, что обращаюсь к ней."

# bg/ceo/ceo.rpy:1531
translate russian meeting_aletta_cherie_02_male_c0a0207f:
    mike.say "Пресекай это, Алетта. Пусть Артур подаёт заявление, как только сможет попасть к судье."

# bg/ceo/ceo.rpy:1533
translate russian meeting_aletta_cherie_02_male_1299d939:
    aletta.say "Правильное решение. Таким палец в рот не клади, а то ещё книгу напишут."

# bg/ceo/ceo.rpy:1536
translate russian meeting_aletta_cherie_02_male_79b19a2e:
    "Шери печально качает головой."

# bg/ceo/ceo.rpy:1538
translate russian meeting_aletta_cherie_02_male_056df0a5:
    cherie.say "Ему шестьдесят три года, и он хочет услышать, что был здесь не пустым местом."

# bg/ceo/ceo.rpy:1540
translate russian meeting_aletta_cherie_02_male_2f1f3862:
    mike.say "Шери, если в его записях есть что-то, что может нам навредить..."

# bg/ceo/ceo.rpy:1542
translate russian meeting_aletta_cherie_02_male_fe79f5b1:
    cherie.say "Судебный запрет этого не сотрёт. Он лишь подчеркнёт ценность записей."

# bg/ceo/ceo.rpy:1544
translate russian meeting_aletta_cherie_02_male_d38238ee:
    cherie.say "Но председатель совета директоров — вы. Поступайте как считаете нужным."

# bg/ceo/ceo.rpy:1546
translate russian meeting_aletta_cherie_02_male_28cf1152:
    "Она говорит это без малейшего сарказма, и именно это пугает больше всего."

# bg/ceo/ceo.rpy:1560
translate russian result_meeting_aletta_cherie_02_male_716746b9:
    "Джеральд Пот приходит в костюме, который явно купил давным-давно на чью-то свадьбу."

# bg/ceo/ceo.rpy:1561
translate russian result_meeting_aletta_cherie_02_male_02af30b4:
    "Мне остаётся лишь прикусить язык и передать его в заботливые руки Шери и Алетты."

# bg/ceo/ceo.rpy:1562
translate russian result_meeting_aletta_cherie_02_male_25d4d49b:
    "А потом выслушать их рассказ о том, как прошла встреча."

# bg/ceo/ceo.rpy:1564
translate russian result_meeting_aletta_cherie_02_male_398d6e50:
    cherie.say "Он говорил два часа и одиннадцать минут. Алетта делала заметки: он это заметил, и для него это было чрезвычайно важно."

# bg/ceo/ceo.rpy:1566
translate russian result_meeting_aletta_cherie_02_male_1d1179e1:
    cherie.say "О трёх вещах из его записей мы уже знали, о четвёртой — нет. Она касается поставщика, с которым мы больше не работаем."

# bg/ceo/ceo.rpy:1569
translate russian result_meeting_aletta_cherie_02_male_81ab666a:
    aletta.say "Он согласился, что рассказывать прессе нечего. Не потому, что мы надавили, а потому, что кто-то наконец сел и выслушал его."

# bg/ceo/ceo.rpy:1571
translate russian result_meeting_aletta_cherie_02_male_ef6594cb:
    mike.say "Так... чего он хочет?"

# bg/ceo/ceo.rpy:1573
translate russian result_meeting_aletta_cherie_02_male_ac014634:
    cherie.say "Чтобы ему правильно пересчитали пенсию, что мы и так были обязаны сделать, и пригласили на следующий ужин в честь уходящих на пенсию."

# bg/ceo/ceo.rpy:1574
translate russian result_meeting_aletta_cherie_02_male_8efa84c7:
    cherie.say "Шестнадцать лет, мон ами. Ради приглашения на ужин и суммы, которую Энтони даже не заметит."

# bg/ceo/ceo.rpy:1577
translate russian result_meeting_aletta_cherie_02_male_bd63a1f5:
    aletta.say "Я была неправа. Собиралась натравить адвоката на человека, которому просто хотелось поговорить."

# bg/ceo/ceo.rpy:1579
translate russian result_meeting_aletta_cherie_02_male_e49a986f:
    "Когда Алетта признаёт свою ошибку, молчание Шери говорит само за себя."

# bg/ceo/ceo.rpy:1581
translate russian result_meeting_aletta_cherie_02_male_cfbf1d5d:
    "Алетта швыряет передо мной свежие газеты."

# bg/ceo/ceo.rpy:1583
translate russian result_meeting_aletta_cherie_02_male_baed892a:
    aletta.say "Суд выдал запрет. Но газетам, похоже, плевать на суды."

# bg/ceo/ceo.rpy:1584
translate russian result_meeting_aletta_cherie_02_male_2167f38b:
    aletta.say "В заголовках речь не о Джеральде Поте..."

# bg/ceo/ceo.rpy:1586
translate russian result_meeting_aletta_cherie_02_male_b57b122b:
    aletta.say "А о компании, которая через суд пыталась заткнуть рот шестидесятитрёхлетнему старику!"

# bg/ceo/ceo.rpy:1588
translate russian result_meeting_aletta_cherie_02_male_c8c06cae:
    aletta.say "Три из четырёх его утверждений — правда. Четвёртое... в общем-то, тоже."

# bg/ceo/ceo.rpy:1591
translate russian result_meeting_aletta_cherie_02_male_73be4af8:
    cherie.say "И теперь никто не станет разбираться в подробностях: мы сами сделали из этого одну большую историю."

# bg/ceo/ceo.rpy:1593
translate russian result_meeting_aletta_cherie_02_male_79ec13b7:
    mike.say "Мы можем ответить? Выпустить опровержение?"

# bg/ceo/ceo.rpy:1595
translate russian result_meeting_aletta_cherie_02_male_dc94963a:
    aletta.say "Мы добились судебного запрета. Ответить — значит вступить в спор с человеком, которому мы по закону пытались запретить говорить."

# bg/ceo/ceo.rpy:1598
translate russian result_meeting_aletta_cherie_02_male_72575b16:
    cherie.say "Ему не нужны были деньги, мон ами. Но теперь, как мне сказали, ему предложили очень много."

# bg/ceo/ceo.rpy:1600
translate russian result_meeting_aletta_cherie_02_male_31c84636:
    "И она права: телефоны разрываются больше недели!"

# bg/ceo/ceo.rpy:1612
translate russian meeting_cassidy_cherie_01_male_99610b5d:
    "Кэссиди решительно входит, явно настроенная на деловой разговор."

# bg/ceo/ceo.rpy:1614
translate russian meeting_cassidy_cherie_01_male_202793b8:
    cassidy.say "Фонд Джексона, милый. Четыреста тысяч в год, и всё ради того, чтобы на званых ужинах зачитывали имя папочки."

# bg/ceo/ceo.rpy:1615
translate russian meeting_cassidy_cherie_01_male_93dc4609:
    cassidy.say "Закрой его и отдай деньги на что-нибудь полезное. Или нам. Честно, мне всё равно."

# bg/ceo/ceo.rpy:1618
translate russian meeting_cassidy_cherie_01_male_75220cc8:
    cherie.say "Ты не знаешь, что представляет собой этот фонд, Кэссиди..."

# bg/ceo/ceo.rpy:1619
translate russian meeting_cassidy_cherie_01_male_e6a8fa19:
    cherie.say "Дважды в год там встречаются заммэра, портовое руководство, начальница градостроительства востока города и представитель пенсионного фонда, владеющего четырьмя процентами нашей компании."

# bg/ceo/ceo.rpy:1620
translate russian meeting_cassidy_cherie_01_male_c3d486ba:
    cherie.say "Благотворительность там самая настоящая, но дело совсем не в ней."

# bg/ceo/ceo.rpy:1623
translate russian meeting_cassidy_cherie_01_male_08cb216d:
    cassidy.say "То есть это взятка с бантиком? Ты сама признаёшь?"

# bg/ceo/ceo.rpy:1626
translate russian meeting_cassidy_cherie_01_male_75f7057c:
    cherie.say "В этом городе решения принимают именно за такими столами. И место за этим столом стоит четыреста тысяч в год."

# bg/ceo/ceo.rpy:1627
translate russian meeting_cassidy_cherie_01_male_51f73d66:
    cherie.say "Убери его имя. Я с радостью тебе помогу. Но не закрывай фонд."

# bg/ceo/ceo.rpy:1630
translate russian meeting_cassidy_cherie_01_male_ac005432:
    cassidy.say "Ты просто хочешь и дальше ходить на вечеринки!"

# bg/ceo/ceo.rpy:1633
translate russian meeting_cassidy_cherie_01_male_2f7d2bab:
    cherie.say "Может, и хочу. Но сейчас речь не об этом!"

# bg/ceo/ceo.rpy:1635
translate russian meeting_cassidy_cherie_01_male_49a73690:
    "Наблюдать за их спором — всё равно что следить за шахматной партией!"

# bg/ceo/ceo.rpy:1638
translate russian meeting_cassidy_cherie_01_male_869028ea:
    "Я поднимаю руку, останавливая Кэссиди."

# bg/ceo/ceo.rpy:1639
translate russian meeting_cassidy_cherie_01_male_f57a4595:
    mike.say "Фонд оставляем. Новое название, новый совет, его имя убираем отовсюду."

# bg/ceo/ceo.rpy:1641
translate russian meeting_cassidy_cherie_01_male_aea050c3:
    "Разумеется, Шери тут же одобряет это решение."

# bg/ceo/ceo.rpy:1643
translate russian meeting_cassidy_cherie_01_male_363440ec:
    cherie.say "Спасибо, мон ами. Я подберу название, которое никого не заденет и почти ничего не будет значить. Это моя специальность."

# bg/ceo/ceo.rpy:1645
translate russian meeting_cassidy_cherie_01_male_84bf9c55:
    "А вот Кэссиди совсем не рада."

# bg/ceo/ceo.rpy:1647
translate russian meeting_cassidy_cherie_01_male_162e5e94:
    cassidy.say "Ну кто бы сомневался!"

# bg/ceo/ceo.rpy:1649
translate russian meeting_cassidy_cherie_01_male_532f8c8b:
    mike.say "Кэссиди, ты можешь войти в совет фонда."

# bg/ceo/ceo.rpy:1651
translate russian meeting_cassidy_cherie_01_male_7c9d0c3f:
    cassidy.say "Я... могу?"

# bg/ceo/ceo.rpy:1653
translate russian meeting_cassidy_cherie_01_male_66cd00c8:
    mike.say "Ты сказала, что всё это было ради тщеславия твоего отца. Вот и придай фонду другой смысл."

# bg/ceo/ceo.rpy:1655
translate russian meeting_cassidy_cherie_01_male_1f4813b0:
    cassidy.say "Знаешь что? Пожалуй, так и сделаю!"

# bg/ceo/ceo.rpy:1657
translate russian meeting_cassidy_cherie_01_male_4d54eb29:
    "Кэссиди уходит, больше не споря."

# bg/ceo/ceo.rpy:1658
translate russian meeting_cassidy_cherie_01_male_074ec273:
    "Для неё это почти то же самое, что сказать спасибо."

# bg/ceo/ceo.rpy:1662
translate russian meeting_cassidy_cherie_01_male_5c7f9aff:
    "Я поднимаю руку, призывая Шери остановиться."

# bg/ceo/ceo.rpy:1663
translate russian meeting_cassidy_cherie_01_male_87a5b585:
    mike.say "Закрывай фонд. Аккуратно сверните деятельность и отдайте остаток средств хоспису."

# bg/ceo/ceo.rpy:1666
translate russian meeting_cassidy_cherie_01_male_8500de76:
    "Разумеется, Кэссиди тут же одобряет это решение."

# bg/ceo/ceo.rpy:1668
translate russian meeting_cassidy_cherie_01_male_b134f61f:
    cassidy.say "Наконец-то здесь кто-то начинает соображать!"

# bg/ceo/ceo.rpy:1670
translate russian meeting_cassidy_cherie_01_male_8448147a:
    "А вот Шери совсем не рада."

# bg/ceo/ceo.rpy:1672
translate russian meeting_cassidy_cherie_01_male_aeb13955:
    cherie.say "Хорошо, мон ами..."

# bg/ceo/ceo.rpy:1674
translate russian meeting_cassidy_cherie_01_male_79137137:
    cherie.say "Я сама напишу попечителям."

# bg/ceo/ceo.rpy:1675
translate russian meeting_cassidy_cherie_01_male_574cf595:
    cherie.say "Они пожилые люди и воспримут это болезненно. Лучше уж пусть услышат это от меня."

# bg/ceo/ceo.rpy:1677
translate russian meeting_cassidy_cherie_01_male_34b548e9:
    mike.say "Шери..."

# bg/ceo/ceo.rpy:1679
translate russian meeting_cassidy_cherie_01_male_0b3233d9:
    cherie.say "Это решение можно обосновать, мон ами. Но оно дорого обойдётся, и настоящую цену вы узнаете не сразу."

# bg/ceo/ceo.rpy:1681
translate russian meeting_cassidy_cherie_01_male_2ac12850:
    "Она выходит прежде, чем я успеваю придумать ответ."

# bg/ceo/ceo.rpy:1695
translate russian result_meeting_cassidy_cherie_01_male_d2c3fc15:
    "На смену названия уходит около полутора часов и один очень хороший обед."

# bg/ceo/ceo.rpy:1697
translate russian result_meeting_cassidy_cherie_01_male_1176d8d4:
    cherie.say "Фонд «Гавань». Уж против гавани точно никто не станет возражать."

# bg/ceo/ceo.rpy:1699
translate russian result_meeting_cassidy_cherie_01_male_55834b5e:
    cherie.say "Представитель пенсионного фонда был так рад приглашению в новый совет."

# bg/ceo/ceo.rpy:1700
translate russian result_meeting_cassidy_cherie_01_male_c070c3c0:
    cherie.say "И между делом упомянул, что они подумывали пересмотреть своё участие в нашей компании."

# bg/ceo/ceo.rpy:1702
translate russian result_meeting_cassidy_cherie_01_male_a29c53fd:
    mike.say "Что именно значит «пересмотреть участие»?"

# bg/ceo/ceo.rpy:1704
translate russian result_meeting_cassidy_cherie_01_male_c4b9e040:
    cherie.say "Продать четыре процента акций нашей компании на и без того нервном рынке. Теперь он об этом больше не думает."

# bg/ceo/ceo.rpy:1707
translate russian result_meeting_cassidy_cherie_01_male_a851ecff:
    cassidy.say "А ещё эта женщина из градостроительного отдела восточной части города правда классная, и она мне нравится. Что бесит."

# bg/ceo/ceo.rpy:1708
translate russian result_meeting_cassidy_cherie_01_male_85a74d88:
    cassidy.say "Следующий сбор пожертвований проведу я. Только не надо делать из этого событие."

# bg/ceo/ceo.rpy:1710
translate russian result_meeting_cassidy_cherie_01_male_a7aa575f:
    "Я изо всех сил стараюсь вести себя как обычно, хотя не уверен, что получается."

# bg/ceo/ceo.rpy:1712
translate russian result_meeting_cassidy_cherie_01_male_a7058a4c:
    "Закрыть благотворительный фонд оказывается не так просто, как я надеялся."

# bg/ceo/ceo.rpy:1714
translate russian result_meeting_cassidy_cherie_01_male_7a1ed52e:
    cherie.say "Попечители рассказали об этом газете. Не со зла, а от растерянности, что на бумаге выглядит куда хуже."

# bg/ceo/ceo.rpy:1716
translate russian result_meeting_cassidy_cherie_01_male_30b29caf:
    cherie.say "В канцелярии заместителя мэра отказались от осмотра участка, а нашу заявку на застройку в восточной части города перенесли на следующий цикл рассмотрения."

# bg/ceo/ceo.rpy:1722
translate russian result_meeting_cassidy_cherie_01_male_01191ca1:
    "Энтони" "Это четыре месяца. Четыре месяца содержания участка, за который мы уже заплатили, — сто шестьдесят тысяч."

# bg/ceo/ceo.rpy:1723
translate russian result_meeting_cassidy_cherie_01_male_fa5634d7:
    mike.say "Но мы ведь сэкономили четыреста?"

# bg/ceo/ceo.rpy:1724
translate russian result_meeting_cassidy_cherie_01_male_91672522:
    "Энтони" "За этот год. А пенсионный фонд продал акции."

# bg/ceo/ceo.rpy:1725
translate russian result_meeting_cassidy_cherie_01_male_1101c901:
    "Энтони" "Четыре процента, на малоликвидном рынке, за девять дней."

# bg/ceo/ceo.rpy:1727
translate russian result_meeting_cassidy_cherie_01_male_dd6ae5c9:
    mike.say "И всё из-за благотворительности?!"

# bg/ceo/ceo.rpy:1729
translate russian result_meeting_cassidy_cherie_01_male_7e4c60b6:
    "Энтони" "Из-за того, что человека двадцать лет приглашали на ужины, а потом перестали."

# bg/ceo/ceo.rpy:1730
translate russian result_meeting_cassidy_cherie_01_male_f0a037a8:
    "Энтони" "Акции упали на семь процентов, и я тоже не могу вписать причину в столбец таблицы."

# bg/ceo/ceo.rpy:1733
translate russian result_meeting_cassidy_cherie_01_male_494f0bac:
    cassidy.say "Я всё ещё считаю, что это была взятка с бантиком!"

# bg/ceo/ceo.rpy:1734
translate russian result_meeting_cassidy_cherie_01_male_ffe6c351:
    cassidy.say "Просто не знала, что именно на этом бантике всё и держалось..."

# bg/ceo/ceo.rpy:1736
translate russian result_meeting_cassidy_cherie_01_male_38abefe5:
    "Повисшее молчание говорит больше любых слов."

# bg/ceo/ceo.rpy:1749
translate russian meeting_cassidy_cherie_02_male_04f657c6:
    "Я изо всех сил стараюсь не отвлекаться, пока Энтони объясняет ситуацию."

# bg/ceo/ceo.rpy:1751
translate russian meeting_cassidy_cherie_02_male_3e608e2b:
    "Энтони" "Средний возраст клиента — пятьдесят один год. Шесть лет назад было сорок четыре."

# bg/ceo/ceo.rpy:1752
translate russian meeting_cassidy_cherie_02_male_bf10511a:
    "Энтони" "Мы не теряем клиентов, но стареем вместе с ними."

# bg/ceo/ceo.rpy:1755
translate russian meeting_cassidy_cherie_02_male_9a84f798:
    "Шери довольно кивает."

# bg/ceo/ceo.rpy:1757
translate russian meeting_cassidy_cherie_02_male_d361d587:
    cherie.say "Значит, нам нужно оставаться собой и делать это красиво."

# bg/ceo/ceo.rpy:1759
translate russian meeting_cassidy_cherie_02_male_efb2e030:
    cherie.say "Все кричат, никто не молчит. Тишина — роскошь, которую остальные не могут себе позволить, а нам она досталась по наследству."

# bg/ceo/ceo.rpy:1760
translate russian meeting_cassidy_cherie_02_male_3c5be330:
    cherie.say "Традиции, сдержанность, небольшая реклама в нужном месте. А крикуны пусть выдыхаются."

# bg/ceo/ceo.rpy:1763
translate russian meeting_cassidy_cherie_02_male_b7c4ab93:
    "Кэссиди качает головой."

# bg/ceo/ceo.rpy:1765
translate russian meeting_cassidy_cherie_02_male_f85f5946:
    cassidy.say "Шери, мне двадцать три. Я и есть тот самый клиент, о котором вы тут все гадаете."

# bg/ceo/ceo.rpy:1767
translate russian meeting_cassidy_cherie_02_male_db95ea10:
    cassidy.say "И я ни за что не стану пользоваться этим брендом. Не потому, что он плохой... а потому, что его никто не замечает!"

# bg/ceo/ceo.rpy:1768
translate russian meeting_cassidy_cherie_02_male_1b82df89:
    cassidy.say "Келлис делают то же самое, только хуже, зато они повсюду. А сейчас всё решает именно это."

# bg/ceo/ceo.rpy:1771
translate russian meeting_cassidy_cherie_02_male_4ab0da29:
    cherie.say "Ты говоришь о моде. Модность — это кредит под разорительные проценты."

# bg/ceo/ceo.rpy:1774
translate russian meeting_cassidy_cherie_02_male_92eed2b9:
    cassidy.say "А хороший вкус — способ очень медленно умирать, оставляя записи аккуратным почерком."

# bg/ceo/ceo.rpy:1776
translate russian meeting_cassidy_cherie_02_male_f33be210:
    "Повисает неловкое молчание, но я вижу, что слова Кэссиди попали в цель."

# bg/ceo/ceo.rpy:1779
translate russian meeting_cassidy_cherie_02_male_98d3ce35:
    "И мне они кажутся вполне разумными."

# bg/ceo/ceo.rpy:1780
translate russian meeting_cassidy_cherie_02_male_3f515b19:
    mike.say "Идём туда, где покупатели. Кэссиди, мне нужен план, а не коллаж с красивыми картинками."

# bg/ceo/ceo.rpy:1781
translate russian meeting_cassidy_cherie_02_male_fa0b22cc:
    "Добившись своего, Кэссиди просто сияет."

# bg/ceo/ceo.rpy:1784
translate russian meeting_cassidy_cherie_02_male_d2d4b26a:
    cassidy.say "Можно и то и другое, милый! И то и другое!"

# bg/ceo/ceo.rpy:1786
translate russian meeting_cassidy_cherie_02_male_ba88c9a1:
    "Шери, напротив, выглядит встревоженной."

# bg/ceo/ceo.rpy:1788
translate russian meeting_cassidy_cherie_02_male_5cad6258:
    cherie.say "Вы обесцените бренд."

# bg/ceo/ceo.rpy:1790
translate russian meeting_cassidy_cherie_02_male_e83ebba7:
    mike.say "Возможно. Но я хочу, чтобы через десять лет наша компания ещё существовала."

# bg/ceo/ceo.rpy:1792
translate russian meeting_cassidy_cherie_02_male_760d9a19:
    cherie.say "Меня это очень тревожит, мон ами…"

# bg/ceo/ceo.rpy:1794
translate russian meeting_cassidy_cherie_02_male_bb42f35a:
    cherie.say "Но в последнее время я во многом ошибалась. Так что пусть девочка попробует."

# bg/ceo/ceo.rpy:1796
translate russian meeting_cassidy_cherie_02_male_f0a17d09:
    "К слову, девочка уже сидит в телефоне и что-то организует."

# bg/ceo/ceo.rpy:1801
translate russian meeting_cassidy_cherie_02_male_5c721344:
    "Но слова Шери никак не выходят у меня из головы."

# bg/ceo/ceo.rpy:1802
translate russian meeting_cassidy_cherie_02_male_b4ef98b5:
    mike.say "Остаёмся собой. Шери, работа над брендом за тобой."

# bg/ceo/ceo.rpy:1805
translate russian meeting_cassidy_cherie_02_male_6881747b:
    "Шери кивает с улыбкой."

# bg/ceo/ceo.rpy:1806
translate russian meeting_cassidy_cherie_02_male_4a4e056a:
    cherie.say "С удовольствием, мон ами…"

# bg/ceo/ceo.rpy:1807
translate russian meeting_cassidy_cherie_02_male_ee2f408f:
    cherie.say "Давно уже никто не позволял мне применить свой вкус в профессиональных целях."

# bg/ceo/ceo.rpy:1808
translate russian meeting_cassidy_cherie_02_male_f53f5ecb:
    "А вот Кэссиди совсем не рада."

# bg/ceo/ceo.rpy:1810
translate russian meeting_cassidy_cherie_02_male_34b65a16:
    cassidy.say "Это ошибка! И пусть все запомнят, что я предупреждала!"

# bg/ceo/ceo.rpy:1812
translate russian meeting_cassidy_cherie_02_male_3396df89:
    mike.say "Принято к сведению, Кэссиди."

# bg/ceo/ceo.rpy:1814
translate russian meeting_cassidy_cherie_02_male_4978c89f:
    cassidy.say "Не надо меня {i}принимать к сведению{/i}! Папочка тоже так делал!"

# bg/ceo/ceo.rpy:1816
translate russian meeting_cassidy_cherie_02_male_376c0b82:
    "Она... она сравнивает меня с Дуэйном?!"

# bg/ceo/ceo.rpy:1818
translate russian meeting_cassidy_cherie_02_male_1b3b6941:
    "Когда я наконец прихожу в себя настолько, чтобы ответить, Кэссиди уже и след простыл."

# bg/ceo/ceo.rpy:1833
translate russian result_meeting_cassidy_cherie_02_male_8cab9e44:
    "План Кэссиди получается громким, слегка хаотичным и включает как минимум двух людей, которые, насколько я могу судить, знамениты исключительно своей известностью."

# bg/ceo/ceo.rpy:1835
translate russian result_meeting_cassidy_cherie_02_male_f91021cf:
    "Энтони" "За семь дней число обращений выросло на сорок один процент."

# bg/ceo/ceo.rpy:1836
translate russian result_meeting_cassidy_cherie_02_male_8d75e9a4:
    "Энтони" "Средний возраст обратившихся снизился до тридцати восьми лет."

# bg/ceo/ceo.rpy:1837
translate russian result_meeting_cassidy_cherie_02_male_c0630216:
    "Энтони" "Я дважды проверил цифры, прежде чем поверить."

# bg/ceo/ceo.rpy:1839
translate russian result_meeting_cassidy_cherie_02_male_4f26746b:
    "Кэссиди чуть ли не мурлычет, пока Энтони хвалит её достижения."

# bg/ceo/ceo.rpy:1841
translate russian result_meeting_cassidy_cherie_02_male_8e72125d:
    cassidy.say "Я же говорила! Ну говорила ведь?!"

# bg/ceo/ceo.rpy:1844
translate russian result_meeting_cassidy_cherie_02_male_61862dd4:
    "Но Шери недовольно качает головой."

# bg/ceo/ceo.rpy:1846
translate russian result_meeting_cassidy_cherie_02_male_b1f5235d:
    cherie.say "Это вульгарно... до чего же вульгарно."

# bg/ceo/ceo.rpy:1848
translate russian result_meeting_cassidy_cherie_02_male_177ff9c3:
    cherie.say "Но это работает. А значит, полагаю, заслуживает похвалы."

# bg/ceo/ceo.rpy:1849
translate russian result_meeting_cassidy_cherie_02_male_74125270:
    cherie.say "Кэссиди, ту, что с лодкой, — пусть её ещё и в газете напечатают."

# bg/ceo/ceo.rpy:1852
translate russian result_meeting_cassidy_cherie_02_male_08028cb5:
    cassidy.say "Это что, {i}совет{/i}?!"

# bg/ceo/ceo.rpy:1855
translate russian result_meeting_cassidy_cherie_02_male_4042a879:
    cherie.say "Просто предложение, ничего больше. Не устраивай из этого драму."

# bg/ceo/ceo.rpy:1857
translate russian result_meeting_cassidy_cherie_02_male_1f162306:
    "Ближе к перемирию эти двое ещё никогда не подбирались."

# bg/ceo/ceo.rpy:1859
translate russian result_meeting_cassidy_cherie_02_male_ed7cbbe0:
    "Сдержанная рекламная кампания и правда прекрасна. Так говорят все, кто её видит."

# bg/ceo/ceo.rpy:1861
translate russian result_meeting_cassidy_cherie_02_male_f7d46229:
    "Энтони" "Число обращений выросло на восемь процентов. Средний возраст обратившихся теперь пятьдесят три года."

# bg/ceo/ceo.rpy:1862
translate russian result_meeting_cassidy_cherie_02_male_6a91bf6e:
    mike.say "То есть он вырос?"

# bg/ceo/ceo.rpy:1863
translate russian result_meeting_cassidy_cherie_02_male_5e7d122f:
    "Энтони" "Да, вырос..."

# bg/ceo/ceo.rpy:1864
translate russian result_meeting_cassidy_cherie_02_male_a7c708c4:
    "Энтони" "По сути, мы стали ещё привлекательнее для тех, кому и так нравились."

# bg/ceo/ceo.rpy:1867
translate russian result_meeting_cassidy_cherie_02_male_00909c0c:
    "Кэссиди раздражённо закатывает глаза."

# bg/ceo/ceo.rpy:1869
translate russian result_meeting_cassidy_cherie_02_male_de326f93:
    cassidy.say "Келлис сделали какую-то штуку с тремя людьми, о которых никто не слышал..."

# bg/ceo/ceo.rpy:1870
translate russian result_meeting_cassidy_cherie_02_male_3bdcb517:
    cassidy.say "Она неделю мелькала повсюду, и у них рост на тридцать процентов!"

# bg/ceo/ceo.rpy:1873
translate russian result_meeting_cassidy_cherie_02_male_6a84f77d:
    "Шери качает головой и опускает взгляд."

# bg/ceo/ceo.rpy:1875
translate russian result_meeting_cassidy_cherie_02_male_8c812952:
    cherie.say "Я создала что-то прекрасное для зала, который медленно пустеет."

# bg/ceo/ceo.rpy:1876
translate russian result_meeting_cassidy_cherie_02_male_7c53b6cf:
    cherie.say "Мне хорошо знакомо это чувство. Так я живу последние восемь лет."

# bg/ceo/ceo.rpy:1878
translate russian result_meeting_cassidy_cherie_02_male_6a20e2f6:
    "Никто не находит, что на это ответить."

# bg/ceo/ceo.rpy:1879
translate russian result_meeting_cassidy_cherie_02_male_7473ff06:
    "И, к огромной чести Кэссиди, она не произносит ни слова."

# bg/ceo/ceo.rpy:1891
translate russian meeting_cherie_01_male_77e08911:
    "Артур морщится, сообщая плохие новости."

# bg/ceo/ceo.rpy:1892
translate russian meeting_cherie_01_male_e566dcea:
    "Артур" "На Рида из коммерческого отдела поступила жалоба. Подробная, с датами и именем свидетеля."

# bg/ceo/ceo.rpy:1894
translate russian meeting_cherie_01_male_e7aff547:
    "Артур" "Моя рекомендация обычная: мировое соглашение, взаимное обязательство о неразглашении, без признания ответственности. За неделю закроем вопрос."

# bg/ceo/ceo.rpy:1895
translate russian meeting_cherie_01_male_1205d059:
    "Артур" "Двадцать две тысячи — и дело закрыто. Любой другой путь отнимет у вас год жизни. Я не бросаюсь такими словами."

# bg/ceo/ceo.rpy:1897
translate russian meeting_cherie_01_male_36593bb7:
    "Прежде чем я успеваю ответить, вмешивается Шери."

# bg/ceo/ceo.rpy:1899
translate russian meeting_cherie_01_male_63edea18:
    cherie.say "Нет."

# bg/ceo/ceo.rpy:1902
translate russian meeting_cherie_01_male_e9258224:
    "Артур" "Мадам, я предлагаю дипломатичное решение."

# bg/ceo/ceo.rpy:1905
translate russian meeting_cherie_01_male_88e3d084:
    cherie.say "Вы предлагаете решение Дуэйна. Я уже видела такие бумаги. Знаю, где их хранят."

# bg/ceo/ceo.rpy:1906
translate russian meeting_cherie_01_male_f8eb2f2b:
    cherie.say "Двадцать две тысячи, одна подпись — и девушка исчезает."

# bg/ceo/ceo.rpy:1907
translate russian meeting_cherie_01_male_99e32141:
    cherie.say "Через четыре года в этом здании никто не вспомнит её имени, а Рид по-прежнему будет работать в коммерческом отделе."

# bg/ceo/ceo.rpy:1908
translate russian meeting_cherie_01_male_2ebea6ab:
    cherie.say "Проведите нормальное независимое расследование. Пусть правда выйдет наружу, какой бы она ни была."

# bg/ceo/ceo.rpy:1911
translate russian meeting_cherie_01_male_14967aac:
    "Артур" "А если это правда, у вас появится её письменное подтверждение. Понимаете, что это значит?"

# bg/ceo/ceo.rpy:1914
translate russian meeting_cherie_01_male_37bfba62:
    cherie.say "Как жаль, что никто не сделал того же в случае с моим мужем, мистер Макраклур!"

# bg/ceo/ceo.rpy:1915
translate russian meeting_cherie_01_male_f9b96877:
    cherie.say "Много лет назад, в этом здании. Пока я сидела дома и украшала его репутацию."

# bg/ceo/ceo.rpy:1917
translate russian meeting_cherie_01_male_7047111e:
    "Артур открывает рот, а потом впервые за всё наше знакомство снова его закрывает."

# bg/ceo/ceo.rpy:1920
translate russian meeting_cherie_01_male_0b973ea3:
    "Пылкие слова Шери трогают меня сильнее, чем я ожидал."

# bg/ceo/ceo.rpy:1921
translate russian meeting_cherie_01_male_efb9ae3f:
    mike.say "Проводим независимое расследование. Никаких соглашений о неразглашении и никаких отступных. Рида до окончания расследования отстраняем с сохранением зарплаты."

# bg/ceo/ceo.rpy:1923
translate russian meeting_cherie_01_male_f82f18e1:
    "Артур" "Чтобы было ясно: этот путь рискованнее."

# bg/ceo/ceo.rpy:1925
translate russian meeting_cherie_01_male_42237e68:
    mike.say "Чтобы было ясно: я это знаю."

# bg/ceo/ceo.rpy:1927
translate russian meeting_cherie_01_male_2f209288:
    cherie.say "Спасибо, {i}мон ами{/i}..."

# bg/ceo/ceo.rpy:1930
translate russian meeting_cherie_01_male_f3cedf4c:
    "Артур" "Поручу это Девере. Берут дорого, зато работают тщательно и не принимают указаний о том, что именно нужно найти."

# bg/ceo/ceo.rpy:1931
translate russian meeting_cherie_01_male_6effe337:
    "Артур" "В чём, я полагаю, и состоит замысел."

# bg/ceo/ceo.rpy:1933
translate russian meeting_cherie_01_male_833410d9:
    "Артур собирает бумаги с видом, в котором я предпочитаю видеть одобрение."

# bg/ceo/ceo.rpy:1937
translate russian meeting_cherie_01_male_aa9029ef:
    "Я изо всех сил стараюсь выкинуть из головы пылкие слова Шери."

# bg/ceo/ceo.rpy:1938
translate russian meeting_cherie_01_male_a4f6a566:
    mike.say "Уладь всё по-тихому."

# bg/ceo/ceo.rpy:1939
translate russian meeting_cherie_01_male_b8024e92:
    mike.say "Просто сделай так, чтобы проблема исчезла."

# bg/ceo/ceo.rpy:1941
translate russian meeting_cherie_01_male_aac8402c:
    "Артур" "Мудрое решение. Закончу на этой неделе."

# bg/ceo/ceo.rpy:1944
translate russian meeting_cherie_01_male_e7580024:
    "Шери выглядит разочарованной."

# bg/ceo/ceo.rpy:1946
translate russian meeting_cherie_01_male_59c4d540:
    cherie.say "Ах..."

# bg/ceo/ceo.rpy:1948
translate russian meeting_cherie_01_male_299453d4:
    mike.say "Шери."

# bg/ceo/ceo.rpy:1950
translate russian meeting_cherie_01_male_c13b729e:
    cherie.say "Я не стану спорить с вами при адвокате. Меня лучше воспитали."

# bg/ceo/ceo.rpy:1951
translate russian meeting_cherie_01_male_03948658:
    cherie.say "Но я хочу, чтобы потом вы вспомнили: я была против."

# bg/ceo/ceo.rpy:1953
translate russian meeting_cherie_01_male_289b373e:
    "Я замечаю, что Шери уходит, оставив свой дорогой кофе остывать."

# bg/ceo/ceo.rpy:1954
translate russian meeting_cherie_01_male_c4a8293e:
    "А для неё это настоящее выражение неодобрения."

# bg/ceo/ceo.rpy:1967
translate russian result_meeting_cherie_01_male_95e3d145:
    "Девере присылают отчёт ещё до конца недели. Артур уверяет, что это неприлично быстро."

# bg/ceo/ceo.rpy:1969
translate russian result_meeting_cherie_01_male_6eb62938:
    "Артур" "Подтвердились три из пяти пунктов. Четвёртый они считают скорее достоверным, чем нет."

# bg/ceo/ceo.rpy:1970
translate russian result_meeting_cherie_01_male_f85c4d5e:
    "Артур" "Кроме того, появились ещё две заявительницы. Они решились выступить, узнав, что никаких соглашений подписывать не придётся."

# bg/ceo/ceo.rpy:1972
translate russian result_meeting_cherie_01_male_de404ad5:
    mike.say "Ещё две?!"

# bg/ceo/ceo.rpy:1974
translate russian result_meeting_cherie_01_male_0723c433:
    "Артур" "Ещё две. Если бы мы заключили мировое соглашение, как я советовал, к моменту, когда всё всплыло бы, сроки по обеим жалобам уже истекли бы."

# bg/ceo/ceo.rpy:1975
translate russian result_meeting_cherie_01_male_7ee91402:
    "Артур" "А мы сидели бы на юридической бомбе с очень коротким запалом."

# bg/ceo/ceo.rpy:1978
translate russian result_meeting_cherie_01_male_0b8a93a2:
    "Шери пристально смотрит на Артура."

# bg/ceo/ceo.rpy:1980
translate russian result_meeting_cherie_01_male_cce57c9a:
    cherie.say "Рид?"

# bg/ceo/ceo.rpy:1983
translate russian result_meeting_cherie_01_male_aafe74c6:
    "Артур" "Уволен без выплат. Он оспорит это решение и проиграет."

# bg/ceo/ceo.rpy:1986
translate russian result_meeting_cherie_01_male_bcd74144:
    cherie.say "Трое... А первая молчала одиннадцать месяцев, прежде чем решилась рассказать."

# bg/ceo/ceo.rpy:1988
translate russian result_meeting_cherie_01_male_78f4a866:
    "На выходных Артур по собственной инициативе полностью переписывает порядок рассмотрения жалоб и больше об этом не упоминает."

# bg/ceo/ceo.rpy:1990
translate russian result_meeting_cherie_01_male_c33ec6ec:
    "Пару дней всё тихо, а потом становится... шумно."

# bg/ceo/ceo.rpy:1992
translate russian result_meeting_cherie_01_male_40e0b03f:
    "Артур" "Вторая заявительница..."

# bg/ceo/ceo.rpy:1993
translate russian result_meeting_cherie_01_male_167b698b:
    "Артур" "И третья..."

# bg/ceo/ceo.rpy:1994
translate russian result_meeting_cherie_01_male_fb6dc2a4:
    "Артур" "Ни одна ничего не подписывала, потому что никто их об этом не просил."

# bg/ceo/ceo.rpy:1996
translate russian result_meeting_cherie_01_male_0520b58b:
    "Артур" "А соглашение, которое мы всё же подписали, теперь самый интересный документ в деле. По нему всё видно без прикрас."

# bg/ceo/ceo.rpy:1998
translate russian result_meeting_cherie_01_male_70dd419f:
    mike.say "Что именно?"

# bg/ceo/ceo.rpy:2000
translate russian result_meeting_cherie_01_male_71e9a0e3:
    "Артур" "Компания всё знала, заплатила и закрыла на это глаза."

# bg/ceo/ceo.rpy:2003
translate russian result_meeting_cherie_01_male_32123d25:
    "Шери медленно качает головой."

# bg/ceo/ceo.rpy:2005
translate russian result_meeting_cherie_01_male_e0769b48:
    cherie.say "Я вам об этом говорила. В этой самой комнате."

# bg/ceo/ceo.rpy:2007
translate russian result_meeting_cherie_01_male_78aa46c4:
    mike.say "Говорила."

# bg/ceo/ceo.rpy:2009
translate russian result_meeting_cherie_01_male_0d5bd323:
    cherie.say "Я напоминаю об этом не для того, чтобы вас уколоть, мон ами..."

# bg/ceo/ceo.rpy:2010
translate russian result_meeting_cherie_01_male_58a4e9fe:
    cherie.say "А потому, что через десять дней вас спросят, когда вы впервые обо всём узнали. И я хочу, чтобы вы заранее отрепетировали ответ."

# bg/ceo/ceo.rpy:2012
translate russian result_meeting_cherie_01_male_e4aa9047:
    "Это хуже всего, что она могла бы на меня накричать."

# bg/ceo/ceo.rpy:2025
translate russian meeting_cherie_02_male_d1d5407e:
    "Сегодня Шери серьёзна, словно её что-то тревожит."

# bg/ceo/ceo.rpy:2027
translate russian meeting_cherie_02_male_b3a8c26a:
    cherie.say "Семья Сабатье хочет заняться сбытом нашей продукции на всём южном рынке."

# bg/ceo/ceo.rpy:2028
translate russian meeting_cherie_02_male_1da51042:
    cherie.say "Я знаю Элен Сабатье с семнадцати лет. Наши матери вместе учились в школе."

# bg/ceo/ceo.rpy:2029
translate russian meeting_cherie_02_male_1a44ede2:
    cherie.say "Это не чужие люди, {i}мон ами{/i}."

# bg/ceo/ceo.rpy:2031
translate russian meeting_cherie_02_male_5b7abf90:
    "Артур вежливо дожидается, пока Шери закончит, и только потом возражает."

# bg/ceo/ceo.rpy:2033
translate russian meeting_cherie_02_male_4a8fc551:
    "Артур" "Стороной договора будет не мадам Сабатье, а «Ферран Дистрибьюшн Холдингс»..."

# bg/ceo/ceo.rpy:2034
translate russian meeting_cherie_02_male_c7b72d90:
    "Артур" "Она принадлежит компании в Люксембурге, та — компании на Мальте, чьи директора, двое господ, по совместительству руководят ещё четырьмя сотнями компаний."

# bg/ceo/ceo.rpy:2035
translate russian meeting_cherie_02_male_22529506:
    "Артур" "Я трижды спрашивал, кто конечный владелец, и трижды слышал в ответ, что это «семейный бизнес»."

# bg/ceo/ceo.rpy:2038
translate russian meeting_cherie_02_male_d43e2ee8:
    cherie.say "Это {i}и есть{/i} семейный бизнес. Просто у таких семей так принято."

# bg/ceo/ceo.rpy:2041
translate russian meeting_cherie_02_male_1b6730d3:
    "Артур" "Мадам, я не хочу никого порочить, но нам нужно знать, с кем мы имеем дело."

# bg/ceo/ceo.rpy:2042
translate russian meeting_cherie_02_male_018060a4:
    "Артур" "Если я не могу назвать владельца, то не могу подтвердить благонадёжность компании. А без этого от очень скверного утра нас отделяет всего одно неудачное имя."

# bg/ceo/ceo.rpy:2045
translate russian meeting_cherie_02_male_2bff8a50:
    cherie.say "Вы готовы оскорбить женщину, которую я знаю тридцать лет, из-за какой-то анкеты?!"

# bg/ceo/ceo.rpy:2048
translate russian meeting_cherie_02_male_dea8cd2d:
    "Артур" "Ради именно этой анкеты я готов оскорбить кого угодно. В деловых вопросах у меня все равны!"

# bg/ceo/ceo.rpy:2050
translate russian meeting_cherie_02_male_f90524ed:
    "Я смотрю на уверенную в себе Шери, а потом на Артура, который... ну, который просто Артур."

# bg/ceo/ceo.rpy:2053
translate russian meeting_cherie_02_male_94969c99:
    "Похоже, Шери лично знает этих людей. Для меня этого достаточно."

# bg/ceo/ceo.rpy:2054
translate russian meeting_cherie_02_male_e87cd71c:
    mike.say "Я доверяю мнению Шери. Подписывай."

# bg/ceo/ceo.rpy:2056
translate russian meeting_cherie_02_male_9a84f798:
    "Шери довольно кивает."

# bg/ceo/ceo.rpy:2058
translate russian meeting_cherie_02_male_2c9c5f39:
    cherie.say "Вы не пожалеете, мон ами..."

# bg/ceo/ceo.rpy:2059
translate russian meeting_cherie_02_male_199a8ff2:
    cherie.say "Элен будет в восторге."

# bg/ceo/ceo.rpy:2061
translate russian meeting_cherie_02_male_8453034d:
    "Артур выглядит раздосадованным, но держит чувства при себе."

# bg/ceo/ceo.rpy:2063
translate russian meeting_cherie_02_male_f8ea6ce2:
    "Артур" "Мне потребуется письменное распоряжение."

# bg/ceo/ceo.rpy:2065
translate russian meeting_cherie_02_male_72ccdf3e:
    mike.say "Получишь."

# bg/ceo/ceo.rpy:2067
translate russian meeting_cherie_02_male_d20b7d6d:
    "Артур" "Поверьте, я буду держать его под рукой!"

# bg/ceo/ceo.rpy:2070
translate russian meeting_cherie_02_male_230e9a69:
    cherie.say "Ах... он просто драматизирует!"

# bg/ceo/ceo.rpy:2072
translate russian meeting_cherie_02_male_b0aad019:
    "Он просто ведёт себя как Артур. А я ещё ни разу не видел, чтобы он хоть что-нибудь драматизировал."

# bg/ceo/ceo.rpy:2076
translate russian meeting_cherie_02_male_7a999cc1:
    "По-моему, Шери просто заступается за друзей."

# bg/ceo/ceo.rpy:2077
translate russian meeting_cherie_02_male_a2ed9c9b:
    mike.say "Не раньше, чем узнаем, кто владелец."

# bg/ceo/ceo.rpy:2078
translate russian meeting_cherie_02_male_632f82c8:
    mike.say "Артур, отправь письменный запрос."

# bg/ceo/ceo.rpy:2079
translate russian meeting_cherie_02_male_01671dcf:
    "Артур кивает, довольный моей поддержкой."

# bg/ceo/ceo.rpy:2081
translate russian meeting_cherie_02_male_bd910fac:
    "Артур" "Уже подготовил. Я всегда беру на себя смелость заранее составлять документы."

# bg/ceo/ceo.rpy:2084
translate russian meeting_cherie_02_male_be679957:
    "А вот Шери выглядит почти подавленной."

# bg/ceo/ceo.rpy:2086
translate russian meeting_cherie_02_male_ed373104:
    cherie.say "Вы поставите меня в неловкое положение, мон ами..."

# bg/ceo/ceo.rpy:2088
translate russian meeting_cherie_02_male_75fb7778:
    mike.say "Я задам вопрос, который задал бы любой добросовестный деловой партнёр."

# bg/ceo/ceo.rpy:2090
translate russian meeting_cherie_02_male_1b2b9726:
    cherie.say "Вижу, вас не переубедить..."

# bg/ceo/ceo.rpy:2091
translate russian meeting_cherie_02_male_0da27b67:
    cherie.say "Хорошо. Но если выяснится, что тревожиться не о чем, вы сами позвоните Элен и будете с ней очаровательны."

# bg/ceo/ceo.rpy:2093
translate russian meeting_cherie_02_male_11b46f3c:
    mike.say "Договорились."

# bg/ceo/ceo.rpy:2094
translate russian meeting_cherie_02_male_e3372eef:
    "Очаровывать французскую наследницу не входило в мои планы на этот год."

# bg/ceo/ceo.rpy:2107
translate russian result_meeting_cherie_02_male_371af34c:
    "Артур смотрит на меня с серьёзным видом."

# bg/ceo/ceo.rpy:2109
translate russian result_meeting_cherie_02_male_277ff2c4:
    "Артур" "Мы направили им запрос, но ответа так и не получили."

# bg/ceo/ceo.rpy:2110
translate russian result_meeting_cherie_02_male_877f1238:
    "Артур" "Четыре запроса, три заверения, что это семейный бизнес, и ни одного имени."

# bg/ceo/ceo.rpy:2112
translate russian result_meeting_cherie_02_male_7b08d0ec:
    "Артур" "А потом всю структуру начали проверять надзорные органы."

# bg/ceo/ceo.rpy:2113
translate russian result_meeting_cherie_02_male_4c4a5e8b:
    "Артур" "Видимо, дело связано с морскими перевозками. К нам оно не имеет ни малейшего отношения, но очень скоро могло бы иметь самое прямое."

# bg/ceo/ceo.rpy:2116
translate russian result_meeting_cherie_02_male_8ce15b84:
    "Шери качает головой, явно с трудом справляясь с чувствами."

# bg/ceo/ceo.rpy:2118
translate russian result_meeting_cherie_02_male_7205795d:
    cherie.say "Элен звонила... Она плакала!"

# bg/ceo/ceo.rpy:2119
translate russian result_meeting_cherie_02_male_ac1461ed:
    cherie.say "Она тоже не знала. Родная семья использовала её тридцать лет, а она даже не подозревала."

# bg/ceo/ceo.rpy:2121
translate russian result_meeting_cherie_02_male_6852e577:
    mike.say "Мы всё ещё можем выйти на южный рынок. Просто не через них."

# bg/ceo/ceo.rpy:2123
translate russian result_meeting_cherie_02_male_296d53bd:
    "Артур" "Можем. У меня есть три варианта. Все скучнее, зато все прозрачные."

# bg/ceo/ceo.rpy:2124
translate russian result_meeting_cherie_02_male_9c4e41e9:
    "Артур" "«Скучно и прозрачно» — прекраснейшие слова в коммерческом праве."

# bg/ceo/ceo.rpy:2126
translate russian result_meeting_cherie_02_male_80976f01:
    "Я сам звоню Элен, как и обещал Шери."

# bg/ceo/ceo.rpy:2127
translate russian result_meeting_cherie_02_male_bd429809:
    "Разговор ужасный. Шери всё это время сидит рядом."

# bg/ceo/ceo.rpy:2130
translate russian result_meeting_cherie_02_male_78c30237:
    "Договор подписан. Но вскоре Артур входит без стука, чего прежде никогда не делал."

# bg/ceo/ceo.rpy:2131
translate russian result_meeting_cherie_02_male_cc5df29e:
    "Артур" "Директора мальтийской компании стали фигурантами разбирательства надзорных органов."

# bg/ceo/ceo.rpy:2133
translate russian result_meeting_cherie_02_male_4a3d21bd:
    "Артур" "Дело не наше. Морские перевозки, история трёхлетней давности, наконец всплывшая наружу."

# bg/ceo/ceo.rpy:2135
translate russian result_meeting_cherie_02_male_4b683f31:
    "Артур" "Теперь наша компания по договору связана со структурой, которую проверяют."

# bg/ceo/ceo.rpy:2137
translate russian result_meeting_cherie_02_male_e9d332ac:
    mike.say "Насколько всё плохо?"

# bg/ceo/ceo.rpy:2139
translate russian result_meeting_cherie_02_male_9d7073d6:
    "Артур" "Не смертельно, но дорого и долго."

# bg/ceo/ceo.rpy:2140
translate russian result_meeting_cherie_02_male_8b9cad9e:
    "Артур" "Из тех историй, которые следующие шесть лет будут упоминаться на четвёртой странице каждого отчёта о нашей кредитоспособности."

# bg/ceo/ceo.rpy:2143
translate russian result_meeting_cherie_02_male_8ce15b84_1:
    "Шери качает головой, явно с трудом справляясь с чувствами."

# bg/ceo/ceo.rpy:2144
translate russian result_meeting_cherie_02_male_0e7a4d58:
    cherie.say "Элен не знала. Я уверена, что не знала."

# bg/ceo/ceo.rpy:2147
translate russian result_meeting_cherie_02_male_f22e464a:
    "Артур" "Готов в это поверить, мадам."

# bg/ceo/ceo.rpy:2148
translate russian result_meeting_cherie_02_male_74d87ea8:
    "Артур" "Хотя на практике это ровным счётом ничего не меняет."

# bg/ceo/ceo.rpy:2150
translate russian result_meeting_cherie_02_male_5c349e33:
    "Выход из сделки обходится в двести тысяч и занимает почти всё время Артура до конца года."

# bg/ceo/ceo.rpy:2162
translate russian meeting_cherie_03_male_0ebed07e:
    "Энтони увлечённо излагает своё предложение."

# bg/ceo/ceo.rpy:2163
translate russian meeting_cherie_03_male_034e057a:
    "Энтони" "Ардели. Двенадцать сотрудников, один этаж, четыреста десять тысяч в год со всеми расходами. Выручка — миллион сто тысяч."

# bg/ceo/ceo.rpy:2164
translate russian meeting_cherie_03_male_1e8349e6:
    "Энтони" "Всех их клиентов можно обслуживать отсюда с дополнительными расходами примерно в ноль."

# bg/ceo/ceo.rpy:2165
translate russian meeting_cherie_03_male_064ca64d:
    "Энтони" "Закрытие даст нам триста восемьдесят тысяч дополнительной чистой прибыли ежегодно."

# bg/ceo/ceo.rpy:2166
translate russian meeting_cherie_03_male_5149e866:
    "Энтони" "Я две недели искал причину этого не делать. Ни одна цифра не говорит против."

# bg/ceo/ceo.rpy:2168
translate russian meeting_cherie_03_male_833ff069:
    "Шери смотрит на него, приподняв бровь."

# bg/ceo/ceo.rpy:2170
translate russian meeting_cherie_03_male_6e28e8c9:
    cherie.say "Ни одна цифра не говорит против, потому что аргумент против — не цифра."

# bg/ceo/ceo.rpy:2171
translate russian meeting_cherie_03_male_e9b473a8:
    cherie.say "Офис в Ардели существует потому, что в Ардели живёт семья Мэллери. Они покупают у нас с тех пор, когда нас с вами ещё на свете не было."

# bg/ceo/ceo.rpy:2172
translate russian meeting_cherie_03_male_d82fe508:
    cherie.say "Старому Мэллери восемьдесят один год. Раз в неделю он приходит в этот офис."

# bg/ceo/ceo.rpy:2173
translate russian meeting_cherie_03_male_222fe45f:
    cherie.say "Пьёт кофе с женщиной по имени Дебора, которая работает там двадцать шесть лет."

# bg/ceo/ceo.rpy:2176
translate russian meeting_cherie_03_male_e5d1bd09:
    "Энтони" "Очень дорогая чашка кофе."

# bg/ceo/ceo.rpy:2179
translate russian meeting_cherie_03_male_4133807b:
    cherie.say "Это чашка кофе за четыреста тысяч долларов, на которой держатся отношения стоимостью девять миллионов фунтов, Энтони."

# bg/ceo/ceo.rpy:2180
translate russian meeting_cherie_03_male_a0c4305c:
    cherie.say "Перенесите обслуживание сюда, и от этих отношений останется только звонок от незнакомцев."

# bg/ceo/ceo.rpy:2183
translate russian meeting_cherie_03_male_eef39bac:
    "Энтони" "При всём уважении, вы говорите о последствиях, которые не можете выразить в цифрах."

# bg/ceo/ceo.rpy:2186
translate russian meeting_cherie_03_male_c197bf1c:
    cherie.say "В этом и суть отношений: их последствий не выразить в цифрах до того дня, когда всё-таки придётся."

# bg/ceo/ceo.rpy:2188
translate russian meeting_cherie_03_male_ae9bbe34:
    "Энтони даже не моргает. Чего не скажешь обо мне!"

# bg/ceo/ceo.rpy:2191
translate russian meeting_cherie_03_male_4e67ad80:
    "По-моему, Энтони основательно подготовился."

# bg/ceo/ceo.rpy:2192
translate russian meeting_cherie_03_male_b1f9a360:
    mike.say "Закрывай, но всё сделай как следует: обсуди с сотрудниками, предложи перевод и достойные условия."

# bg/ceo/ceo.rpy:2193
translate russian meeting_cherie_03_male_351596f2:
    "Энтони отвечает привычным деловитым кивком."

# bg/ceo/ceo.rpy:2195
translate russian meeting_cherie_03_male_0c23ba85:
    "Энтони" "Разумеется. Я уже рассчитал расходы на сокращения. Окупится за тринадцать месяцев."

# bg/ceo/ceo.rpy:2198
translate russian meeting_cherie_03_male_19df4f15:
    "Шери, напротив, выглядит подавленной."

# bg/ceo/ceo.rpy:2200
translate russian meeting_cherie_03_male_1413d31c:
    cherie.say "Деборе пятьдесят восемь, а от Ардели досюда полтора часа пути."

# bg/ceo/ceo.rpy:2202
translate russian meeting_cherie_03_male_2e71adc1:
    mike.say "Мы предложим ей перевод."

# bg/ceo/ceo.rpy:2204
translate russian meeting_cherie_03_male_229cae33:
    cherie.say "Она не согласится, мон ами…"

# bg/ceo/ceo.rpy:2205
translate russian meeting_cherie_03_male_467952b9:
    cherie.say "А когда старый Мэллери придёт и увидит запертую дверь, он не станет звонить с жалобами."

# bg/ceo/ceo.rpy:2206
translate russian meeting_cherie_03_male_6c77c05e:
    cherie.say "Мужчины его поколения не жалуются. Они просто перестают приходить."

# bg/ceo/ceo.rpy:2209
translate russian meeting_cherie_03_male_ac5a20ed:
    "Энтони со своими цифрами уже почти вышел за дверь. И все его расчёты верны."

# bg/ceo/ceo.rpy:2210
translate russian meeting_cherie_03_male_6c4f036d:
    "Но почему-то мне всё равно кажется, что я совершил глупость."

# bg/ceo/ceo.rpy:2214
translate russian meeting_cherie_03_male_55baae0e:
    "Чутьё подсказывает, что на этот раз Шери права."

# bg/ceo/ceo.rpy:2215
translate russian meeting_cherie_03_male_6b8533a5:
    mike.say "Ардели оставляем."

# bg/ceo/ceo.rpy:2217
translate russian meeting_cherie_03_male_beb40f56:
    "Если Энтони и раздражён, он хорошо это скрывает."

# bg/ceo/ceo.rpy:2219
translate russian meeting_cherie_03_male_c380a417:
    "Энтони" "Тогда прошу зафиксировать, что исключение сделано по стратегическим соображениям, а не по финансовым."

# bg/ceo/ceo.rpy:2221
translate russian meeting_cherie_03_male_38156786:
    mike.say "Записывай как хочешь."

# bg/ceo/ceo.rpy:2223
translate russian meeting_cherie_03_male_82650407:
    "Энтони" "Запишу точно. Иначе не умею."

# bg/ceo/ceo.rpy:2226
translate russian meeting_cherie_03_male_af2f98d4:
    "Моё решение приносит Шери явное облегчение."

# bg/ceo/ceo.rpy:2228
translate russian meeting_cherie_03_male_e29ec655:
    cherie.say "Спасибо, {i}мон ами{/i}…"

# bg/ceo/ceo.rpy:2229
translate russian meeting_cherie_03_male_55aef606:
    cherie.say "Я сама позвоню Деборе."

# bg/ceo/ceo.rpy:2231
translate russian meeting_cherie_03_male_21bc7111:
    mike.say "Ты знаешь Дебору?"

# bg/ceo/ceo.rpy:2233
translate russian meeting_cherie_03_male_33ed3754:
    cherie.say "Я знаю всех. Это единственная по-настоящему полезная сторона такой жизни, как моя."

# bg/ceo/ceo.rpy:2235
translate russian meeting_cherie_03_male_9136f248:
    "Энтони записывает одну строчку в блокнот и уходит."

# bg/ceo/ceo.rpy:2237
translate russian meeting_cherie_03_male_82bc0991:
    "Я бы немало заплатил, чтобы узнать, что он написал."

# bg/ceo/ceo.rpy:2250
translate russian result_meeting_cherie_03_male_c66399ae:
    "Старый Мэллери приходит, пьёт кофе и по собственной инициативе продлевает договор на пять лет."

# bg/ceo/ceo.rpy:2252
translate russian result_meeting_cherie_03_male_942b8c93:
    "Разумеется, Шери чертовски довольна собой."

# bg/ceo/ceo.rpy:2254
translate russian result_meeting_cherie_03_male_d528f9c0:
    cherie.say "Дебора мне позвонила. Он спросил, собирается ли новый начальник их закрывать. Она ответила, что нет, и он достал ручку."

# bg/ceo/ceo.rpy:2256
translate russian result_meeting_cherie_03_male_526ae9c6:
    "Энтони сохраняет деловой тон и придерживается цифр."

# bg/ceo/ceo.rpy:2258
translate russian result_meeting_cherie_03_male_91260bc8:
    "Энтони" "Девять миллионов сто тысяч за пять лет, на более выгодных условиях. При ежегодных расходах в четыреста десять тысяч."

# bg/ceo/ceo.rpy:2259
translate russian result_meeting_cherie_03_male_8e3158fa:
    "Энтони" "Я пересчитал модель с учётом продления договора. Теперь Ардели — самые прибыльные квадратные метры из всех, что у нас есть."

# bg/ceo/ceo.rpy:2261
translate russian result_meeting_cherie_03_male_260706e7:
    mike.say "По голосу не скажешь, что ты рад."

# bg/ceo/ceo.rpy:2263
translate russian result_meeting_cherie_03_male_0f9fcecd:
    "Энтони" "Я чрезвычайно рад. Просто у меня радость звучит именно так."

# bg/ceo/ceo.rpy:2266
translate russian result_meeting_cherie_03_male_42104df2:
    cherie.say "Поразительно похоже на недовольство!"

# bg/ceo/ceo.rpy:2269
translate russian result_meeting_cherie_03_male_5196976c:
    "Почти уверен, что Энтони едва не улыбнулся."

# bg/ceo/ceo.rpy:2271
translate russian result_meeting_cherie_03_male_06c0dcd2:
    "Но это очень быстро прошло."

# bg/ceo/ceo.rpy:2273
translate russian result_meeting_cherie_03_male_058b02b9:
    "Офис в Ардели закрывают. Дебора отказывается от перевода."

# bg/ceo/ceo.rpy:2275
translate russian result_meeting_cherie_03_male_c2d187ce:
    "Шери, разумеется, недовольна таким исходом."

# bg/ceo/ceo.rpy:2277
translate russian result_meeting_cherie_03_male_ce48bb91:
    cherie.say "Старый Мэллери не позвонил."

# bg/ceo/ceo.rpy:2279
translate russian result_meeting_cherie_03_male_67f67789:
    "А Энтони по-прежнему держится строго деловито, не проявляя ни малейших эмоций."

# bg/ceo/ceo.rpy:2281
translate russian result_meeting_cherie_03_male_80327860:
    "Энтони" "Мэллери перешли к Веррин..."

# bg/ceo/ceo.rpy:2282
translate russian result_meeting_cherie_03_male_2ebe3e9e:
    "Энтони" "Не разом, а четырьмя отдельными частями, чтобы ни одна сама по себе не привлекла внимания."

# bg/ceo/ceo.rpy:2283
translate russian result_meeting_cherie_03_male_ffff44e5:
    "Энтони" "Девять миллионов выручки против экономии в триста восемьдесят тысяч."

# bg/ceo/ceo.rpy:2285
translate russian result_meeting_cherie_03_male_4ed79754:
    mike.say "Ему что, никто не позвонил?!"

# bg/ceo/ceo.rpy:2287
translate russian result_meeting_cherie_03_male_24a03194:
    "Энтони" "Позвонили трое. Со всеми он был безупречно вежлив."

# bg/ceo/ceo.rpy:2290
translate russian result_meeting_cherie_03_male_ce8ad775:
    cherie.say "Разумеется. Он всё решил ещё на парковке!"

# bg/ceo/ceo.rpy:2291
translate russian result_meeting_cherie_03_male_50662f8f:
    cherie.say "Я ведь предупреждала, {i}мон ами{/i}. И никакого удовольствия мне это не доставляет."

# bg/ceo/ceo.rpy:2293
translate russian result_meeting_cherie_03_male_0826a766:
    "Самое ужасное, что я ей полностью верю."

# bg/ceo/ceo.rpy:2306
translate russian meeting_cherie_04_male_9e1e19fa:
    "Шери наклоняется ближе, почти вынуждая меня сосредоточиться только на ней."

# bg/ceo/ceo.rpy:2308
translate russian meeting_cherie_04_male_214a6b9c:
    cherie.say "«Марчмонт» свободен. Четыре этажа, атриум, та лестница и адрес, который что-то значит для всех нужных людей."

# bg/ceo/ceo.rpy:2309
translate russian meeting_cherie_04_male_396e2705:
    cherie.say "Это здание пропахло Дуэйном. Двадцать лет им пахнет, и никакая покраска не помогает."

# bg/ceo/ceo.rpy:2310
translate russian meeting_cherie_04_male_19f31fd8:
    cherie.say "Давайте переедем. Пусть первое, что люди узнают о компании, — то, что она уже не прежняя."

# bg/ceo/ceo.rpy:2312
translate russian meeting_cherie_04_male_f94b53ff:
    "Энтони по обыкновению отвечает фактами и цифрами."

# bg/ceo/ceo.rpy:2314
translate russian meeting_cherie_04_male_3876b6ab:
    "Энтони" "Аренда за квадратный метр в три целых одну десятую раза дороже нынешней. Обустройство — миллион шестьсот тысяч капитальных затрат, которых нет в бюджете."

# bg/ceo/ceo.rpy:2315
translate russian meeting_cherie_04_male_18244e28:
    "Энтони" "Восстановление этого здания при выезде — ещё четыреста тысяч."

# bg/ceo/ceo.rpy:2316
translate russian meeting_cherie_04_male_bbfb4dd7:
    "Энтони" "За первый год такой жест обойдётся в два миллиона четыреста тысяч."

# bg/ceo/ceo.rpy:2319
translate russian meeting_cherie_04_male_e5678c72:
    cherie.say "Вы произносите слово «жест» так, будто это оскорбление!"

# bg/ceo/ceo.rpy:2322
translate russian meeting_cherie_04_male_5f798d71:
    "Энтони" "Это категория. Вполне допустимая, но самая дорогая. И в активах такие жесты никогда не отражаются."

# bg/ceo/ceo.rpy:2325
translate russian meeting_cherie_04_male_46059545:
    cherie.say "И на что вы предлагаете потратить два миллиона четыреста тысяч?"

# bg/ceo/ceo.rpy:2326
translate russian meeting_cherie_04_male_0a5c2b42:
    cherie.say "На ещё одну железяку, которая будет лязгать?!"

# bg/ceo/ceo.rpy:2329
translate russian meeting_cherie_04_male_aad31e67:
    "Энтони" "Именно. В этом всё моё предложение. И меня нисколько не смущает, как скромно оно звучит."

# bg/ceo/ceo.rpy:2331
translate russian meeting_cherie_04_male_09787e79:
    "Шери смотрит на меня так же, как на винную карту, когда уже сделала выбор."

# bg/ceo/ceo.rpy:2334
translate russian meeting_cherie_04_male_2368fe89:
    "Шери права. Здесь всё ещё воняет Дуэйном."

# bg/ceo/ceo.rpy:2335
translate russian meeting_cherie_04_male_80f6c68e:
    mike.say "Хорошо, Шери. Берём «Марчмонт»."

# bg/ceo/ceo.rpy:2337
translate russian meeting_cherie_04_male_9a84f798:
    "Шери довольно кивает."

# bg/ceo/ceo.rpy:2338
translate russian meeting_cherie_04_male_d8071121:
    cherie.say "Обещаю, вы почувствуете себя иначе, как только впервые подниметесь по той лестнице."

# bg/ceo/ceo.rpy:2341
translate russian meeting_cherie_04_male_c0630391:
    "Энтони, похоже, куда меньше воодушевлён моим решением."

# bg/ceo/ceo.rpy:2343
translate russian meeting_cherie_04_male_c56977b5:
    "Энтони" "Чтобы это оплатить, придётся отложить программу обновления производства."

# bg/ceo/ceo.rpy:2345
translate russian meeting_cherie_04_male_a4c27832:
    mike.say "Значит, отложи."

# bg/ceo/ceo.rpy:2347
translate russian meeting_cherie_04_male_9dcc468e:
    "Энтони" "Прошу зафиксировать: отсрочка не означает отмену. И машины о наших решениях не знают."

# bg/ceo/ceo.rpy:2350
translate russian meeting_cherie_04_male_210c4fb5:
    cherie.say "Когда он расстроен, в нём почти просыпается поэт."

# bg/ceo/ceo.rpy:2352
translate russian meeting_cherie_04_male_e1daec03:
    "Энтони что-то записывает."

# bg/ceo/ceo.rpy:2353
translate russian meeting_cherie_04_male_b184c1fc:
    "Готов поспорить, что это слово {i}поэт{/i}, которое он тут же зачеркнул."

# bg/ceo/ceo.rpy:2357
translate russian meeting_cherie_04_male_87067fd5:
    "Энтони прав. Переезд нужен только ради тщеславия."

# bg/ceo/ceo.rpy:2358
translate russian meeting_cherie_04_male_a8abf33a:
    mike.say "Остаёмся. Деньги пойдут на производство."

# bg/ceo/ceo.rpy:2359
translate russian meeting_cherie_04_male_5517a3b4:
    "Разумеется, Энтони довольно кивает."

# bg/ceo/ceo.rpy:2361
translate russian meeting_cherie_04_male_be154807:
    "Энтони" "Вы делаете правильный выбор."

# bg/ceo/ceo.rpy:2363
translate russian meeting_cherie_04_male_1a379f24:
    "Но Шери огорчённо качает головой."

# bg/ceo/ceo.rpy:2365
translate russian meeting_cherie_04_male_29f680d7:
    cherie.say "Здесь пахнет им, {i}мон ами{/i}! И всегда будет пахнуть!"

# bg/ceo/ceo.rpy:2367
translate russian meeting_cherie_04_male_4eb19982:
    mike.say "Тогда переделаем этот этаж целиком. Изменим здесь всё."

# bg/ceo/ceo.rpy:2368
translate russian meeting_cherie_04_male_2cae0ddd:
    mike.say "А из этой комнаты сделаем что-нибудь полезное. Не знаю... комнату отдыха для сотрудников!"

# bg/ceo/ceo.rpy:2370
translate russian meeting_cherie_04_male_15e3f6df:
    cherie.say "Ну что вы, мон ами..."

# bg/ceo/ceo.rpy:2372
translate russian meeting_cherie_04_male_f3ad2f74:
    cherie.say "Это блестяще! Дуэйн был бы в ярости!"

# bg/ceo/ceo.rpy:2374
translate russian meeting_cherie_04_male_5aaede42:
    mike.say "Тем более стоит это сделать."

# bg/ceo/ceo.rpy:2375
translate russian meeting_cherie_04_male_5340b4d3:
    "Вместо двух миллионов четырёхсот тысяч выходит восемьдесят тысяч."

# bg/ceo/ceo.rpy:2376
translate russian meeting_cherie_04_male_5edc7631:
    "Но куда ценнее видеть, что теперь Шери здесь счастливее."

# bg/ceo/ceo.rpy:2389
translate russian result_meeting_cherie_04_male_f79b3a8e:
    "Подрядчики полностью переделывают кабинет Дуэйна. В итоге там полно столов и стоит чьё-то жуткое комнатное растение."

# bg/ceo/ceo.rpy:2391
translate russian result_meeting_cherie_04_male_acf5c475:
    "Но Шери, похоже, это совершенно не волнует."

# bg/ceo/ceo.rpy:2393
translate russian result_meeting_cherie_04_male_ee34b69b:
    cherie.say "Я съела там сэндвич. Стоя... нарочно!"

# bg/ceo/ceo.rpy:2395
translate russian result_meeting_cherie_04_male_db4b9be5:
    "Энтони воздерживается от комментариев о её привычках за столом."

# bg/ceo/ceo.rpy:2397
translate russian result_meeting_cherie_04_male_1601e387:
    "Энтони" "Программу обновления производства выполнили. Мы заменили подшипники на линии Дортман за одиннадцать дней до того, как они вышли бы из строя."

# bg/ceo/ceo.rpy:2399
translate russian result_meeting_cherie_04_male_cb5a53ad:
    mike.say "Откуда ты знаешь, что они вышли бы из строя?"

# bg/ceo/ceo.rpy:2401
translate russian result_meeting_cherie_04_male_0a5d64ac:
    "Энтони" "Потому что снятым подшипникам оставалось одиннадцать дней."

# bg/ceo/ceo.rpy:2402
translate russian result_meeting_cherie_04_male_3129e765:
    "Энтони" "Я велел измерить износ. Мне хотелось знать."

# bg/ceo/ceo.rpy:2405
translate russian result_meeting_cherie_04_male_22c5288b:
    cherie.say "Вас хоть что-нибудь радует, Энтони?"

# bg/ceo/ceo.rpy:2408
translate russian result_meeting_cherie_04_male_fe7d92a3:
    "Энтони" "Вот это меня порадовало."

# bg/ceo/ceo.rpy:2409
translate russian result_meeting_cherie_04_male_dbd80a5f:
    "И самое странное — видно, что так и было."

# bg/ceo/ceo.rpy:2412
translate russian result_meeting_cherie_04_male_c16c3717:
    "Договор аренды «Марчмонта» подписан. Лестница, признаю, великолепна."

# bg/ceo/ceo.rpy:2414
translate russian result_meeting_cherie_04_male_411679ed:
    "Хотя Энтони, похоже, не разделяет моего восторга."

# bg/ceo/ceo.rpy:2416
translate russian result_meeting_cherie_04_male_02f0fe13:
    "Энтони" "Обновление производства отложили до следующего года. На линии Дортман вышел из строя подшипник, мы потеряли четыре смены."

# bg/ceo/ceo.rpy:2417
translate russian result_meeting_cherie_04_male_04b350a9:
    "Энтони" "Четыре смены — двести одиннадцать тысяч. По совпадению ровно столько стоила бы программа замены подшипников."

# bg/ceo/ceo.rpy:2419
translate russian result_meeting_cherie_04_male_23512149:
    mike.say "Это ведь не совпадение?"

# bg/ceo/ceo.rpy:2421
translate russian result_meeting_cherie_04_male_d7747d4c:
    "Энтони" "Нет. Я сказал «по совпадению» из вежливости."

# bg/ceo/ceo.rpy:2423
translate russian result_meeting_cherie_04_male_6ed41243:
    "Энтони" "Пытаюсь стать вежливее, но пока не очень получается."

# bg/ceo/ceo.rpy:2426
translate russian result_meeting_cherie_04_male_7b79500f:
    "Шери, похоже, расстроена, что он не в восторге от нового места."

# bg/ceo/ceo.rpy:2428
translate russian result_meeting_cherie_04_male_86870800:
    cherie.say "Здание всем нравится."

# bg/ceo/ceo.rpy:2429
translate russian result_meeting_cherie_04_male_ebdaca7d:
    cherie.say "Это тоже чего-то стоит. Просто не двухсот одиннадцати тысяч."

# bg/ceo/ceo.rpy:2431
translate russian result_meeting_cherie_04_male_4bc22d68:
    "Лестница всё так же великолепна. Но теперь я обычно езжу на лифте."

# bg/ceo/ceo.rpy:2443
translate russian meeting_cherie_05_male_08794168:
    "Уильям выглядит так, будто ужасно боится сообщать плохие новости."

# bg/ceo/ceo.rpy:2445
translate russian meeting_cherie_05_male_3cef03e6:
    "Уильям" "Делэйни из «Леджер» пишет статью о Дуэйне."

# bg/ceo/ceo.rpy:2446
translate russian meeting_cherie_05_male_cd3690b3:
    "Уильям" "Шесть недель копалась, поговорила с тремя нашими бывшими сотрудниками и прислала пятнадцать письменных вопросов."

# bg/ceo/ceo.rpy:2448
translate russian meeting_cherie_05_male_2c38f84c:
    "Уильям" "Значит, опередим её. Большое заявление, а к нему письмо от адвоката."

# bg/ceo/ceo.rpy:2449
translate russian meeting_cherie_05_male_e953c4f0:
    "Уильям" "И в то же утро я выпускаю нашу статью: новое руководство, новая эпоха и, кстати, вот в чём Делэйни ошиблась."

# bg/ceo/ceo.rpy:2451
translate russian meeting_cherie_05_male_6417d494:
    "Уильям" "Либо ты управляешь историей, либо история управляет тобой, босс. Это первое, чему учат пиарщиков."

# bg/ceo/ceo.rpy:2453
translate russian meeting_cherie_05_male_644f76ee:
    "На меня это производит впечатление. Чего не скажешь о Шери."

# bg/ceo/ceo.rpy:2455
translate russian meeting_cherie_05_male_42213ea6:
    cherie.say "Кто именно {i}учит{/i}, Уильям?"

# bg/ceo/ceo.rpy:2458
translate russian meeting_cherie_05_male_811fcad1:
    "Уильям" "Эм... все, мэм."

# bg/ceo/ceo.rpy:2461
translate russian meeting_cherie_05_male_6ac7e039:
    cherie.say "Не воюйте с женщиной, которая закупает чернила бочками. Особенно если она почти во всём права."

# bg/ceo/ceo.rpy:2462
translate russian meeting_cherie_05_male_f1fa8852:
    cherie.say "Правдиво и кратко ответьте на пятнадцать вопросов. Предложите ей поговорить со мной для понимания ситуации, без цитирования. А публично не говорите ничего."

# bg/ceo/ceo.rpy:2465
translate russian meeting_cherie_05_male_96b7a26f:
    "Уильям" "Но... но это же капитуляция!"

# bg/ceo/ceo.rpy:2468
translate russian meeting_cherie_05_male_bf1f7cc5:
    cherie.say "Это вдова, которая отказывается кричать. Об этом писать гораздо труднее, чем о заявлении компании."

# bg/ceo/ceo.rpy:2469
translate russian meeting_cherie_05_male_5545b23d:
    cherie.say "Заявление — это цитата, {i}мон ами{/i}. Подарок журналисту."

# bg/ceo/ceo.rpy:2470
translate russian meeting_cherie_05_male_d11873f2:
    cherie.say "Оно попадёт во второй абзац и останется там навсегда."

# bg/ceo/ceo.rpy:2472
translate russian meeting_cherie_05_male_5d411b34:
    "Уильям смотрит на меня с выражением человека, который ни разу в жизни не молчал намеренно."

# bg/ceo/ceo.rpy:2475
translate russian meeting_cherie_05_male_14615b41:
    "Мне кажется, Шери рискует здесь больше всех. Поэтому поддержу её."

# bg/ceo/ceo.rpy:2476
translate russian meeting_cherie_05_male_6c25a15e:
    mike.say "Никакого заявления. Ответим на пятнадцать вопросов."

# bg/ceo/ceo.rpy:2477
translate russian meeting_cherie_05_male_6a164ae4:
    mike.say "Шери, остальное объяснишь ты."

# bg/ceo/ceo.rpy:2479
translate russian meeting_cherie_05_male_96b5f0d2:
    "Шери согласно кивает."

# bg/ceo/ceo.rpy:2481
translate russian meeting_cherie_05_male_b2e04a2e:
    cherie.say "Буду откровенной и скучной. Очень недооценённое сочетание."

# bg/ceo/ceo.rpy:2484
translate russian meeting_cherie_05_male_b3c678fe:
    "Уильяму идея явно не по душе."

# bg/ceo/ceo.rpy:2486
translate russian meeting_cherie_05_male_4a875f17:
    "Уильям" "Босс, если мы не дадим отпор, люди подумают..."

# bg/ceo/ceo.rpy:2488
translate russian meeting_cherie_05_male_9857809f:
    mike.say "Люди будут что-то думать дня четыре. Потом начнут думать о другом."

# bg/ceo/ceo.rpy:2490
translate russian meeting_cherie_05_male_cecbd3b0:
    "Уильям" "Мне нравится. Очень хладнокровно, босс."

# bg/ceo/ceo.rpy:2493
translate russian meeting_cherie_05_male_956f9aea:
    cherie.say "Это не хладнокровие, Уильям, а старая школа. Разница есть, и со временем вы её поймёте."

# bg/ceo/ceo.rpy:2495
translate russian meeting_cherie_05_male_abc97ac3:
    "Уильям это записывает."

# bg/ceo/ceo.rpy:2496
translate russian meeting_cherie_05_male_dc6af9e3:
    "Он записывает всё, что говорит Шери. Это либо лесть, либо самое умное, что можно придумать."

# bg/ceo/ceo.rpy:2500
translate russian meeting_cherie_05_male_c74ca9b5:
    "Мне кажется, личная вовлечённость мешает Шери трезво судить об этом."

# bg/ceo/ceo.rpy:2501
translate russian meeting_cherie_05_male_48f3442e:
    mike.say "Действуем первыми: заявление, письмо, собственная статья."

# bg/ceo/ceo.rpy:2502
translate russian meeting_cherie_05_male_01b18ae4:
    "Уильям мгновенно хватается за моё согласие."

# bg/ceo/ceo.rpy:2504
translate russian meeting_cherie_05_male_56b10ab7:
    "Уильям" "Уже делаю, босс! Всё будет отлично!"

# bg/ceo/ceo.rpy:2507
translate russian meeting_cherie_05_male_ae9aaf60:
    "Шери, разумеется, куда меньше рада."

# bg/ceo/ceo.rpy:2509
translate russian meeting_cherie_05_male_f60df546:
    cherie.say "Будет цитата."

# bg/ceo/ceo.rpy:2511
translate russian meeting_cherie_05_male_6b073117:
    mike.say "Шери, мы не можем просто стоять и ничего не делать."

# bg/ceo/ceo.rpy:2513
translate russian meeting_cherie_05_male_269d61af:
    cherie.say "Можете. Вы имеете на это полное право."

# bg/ceo/ceo.rpy:2514
translate russian meeting_cherie_05_male_8583a570:
    cherie.say "Просто никто в это не верит, пока не становится поздно."

# bg/ceo/ceo.rpy:2516
translate russian meeting_cherie_05_male_3ffe5fcb:
    cherie.say "Я не стану вам мешать. Но и фотографировать меня не позволю."

# bg/ceo/ceo.rpy:2517
translate russian meeting_cherie_05_male_ec5680ee:
    "Уильям уже пишет."

# bg/ceo/ceo.rpy:2518
translate russian meeting_cherie_05_male_4260216c:
    "Печатает он так же, как говорит: очень быстро и преимущественно восклицательными знаками."

# bg/ceo/ceo.rpy:2531
translate russian result_meeting_cherie_05_male_e220fa58:
    "Статья Делэйни выходит: длинная, обстоятельная и в основном о мёртвом человеке."

# bg/ceo/ceo.rpy:2533
translate russian result_meeting_cherie_05_male_b3ce9d62:
    "Шери, похоже, довольна результатом."

# bg/ceo/ceo.rpy:2535
translate russian result_meeting_cherie_05_male_fced3c10:
    cherie.say "Четыре абзаца о компании. В трёх только факты, четвёртый почти доброжелательный."

# bg/ceo/ceo.rpy:2537
translate russian result_meeting_cherie_05_male_dc80680e:
    cherie.say "Она учла мои пояснения. Ни слова со ссылкой на меня, зато две неправдивые истории удалось отвести."

# bg/ceo/ceo.rpy:2540
translate russian result_meeting_cherie_05_male_fd65e8a0:
    "Уильям выглядит сдержанно впечатлённым."

# bg/ceo/ceo.rpy:2542
translate russian result_meeting_cherie_05_male_34228275:
    "Уильям" "Никто не позвонил. Вообще никто."

# bg/ceo/ceo.rpy:2544
translate russian result_meeting_cherie_05_male_3e8f2b0c:
    mike.say "В этом и была цель, Уильям."

# bg/ceo/ceo.rpy:2546
translate russian result_meeting_cherie_05_male_92b66ea1:
    "Уильям" "Так странно! У меня ещё не было недели, за которую ничего не случилось!"

# bg/ceo/ceo.rpy:2549
translate russian result_meeting_cherie_05_male_75b6165c:
    cherie.say "Добро пожаловать в мир компетентности. Здесь тише, чем вам обещали."

# bg/ceo/ceo.rpy:2552
translate russian result_meeting_cherie_05_male_03ba5634:
    "Он явно выбит из колеи."

# bg/ceo/ceo.rpy:2553
translate russian result_meeting_cherie_05_male_69e479d9:
    "Кажется, он и вправду чему-то учится."

# bg/ceo/ceo.rpy:2555
translate russian result_meeting_cherie_05_male_0d835e90:
    "Наше заявление выходит, а через пару дней появляется статья Делэйни. Цитата из заявления стоит во втором абзаце."

# bg/ceo/ceo.rpy:2557
translate russian result_meeting_cherie_05_male_8277e5f2:
    "Шери явно расстроена тем, что получилось."

# bg/ceo/ceo.rpy:2559
translate russian result_meeting_cherie_05_male_92439f5a:
    cherie.say "Слово в слово. Как я и говорила."

# bg/ceo/ceo.rpy:2560
translate russian result_meeting_cherie_05_male_6ce3d1d5:
    cherie.say "Письмо адвоката тоже процитировано. Целиком, с фотографией."

# bg/ceo/ceo.rpy:2563
translate russian result_meeting_cherie_05_male_ecca2089:
    "Уильям чувствует себя явно неловко."

# bg/ceo/ceo.rpy:2565
translate russian result_meeting_cherie_05_male_d60694bf:
    "Уильям" "Это... ладно, справедливости ради, так обычно не бывает..."

# bg/ceo/ceo.rpy:2568
translate russian result_meeting_cherie_05_male_c8c19ea4:
    cherie.say "Так бывает постоянно. Именно это и происходит с письмами после того, как вы их отправили."

# bg/ceo/ceo.rpy:2570
translate russian result_meeting_cherie_05_male_6895dfbd:
    "Историю подхватывают ещё две газеты."

# bg/ceo/ceo.rpy:2571
translate russian result_meeting_cherie_05_male_4d58c214:
    "Не изначальную историю, а историю о письме."

# bg/ceo/ceo.rpy:2572
translate russian result_meeting_cherie_05_male_4d78170b:
    mike.say "То есть мы создали новость из того, что нам не понравилась новость?"

# bg/ceo/ceo.rpy:2574
translate russian result_meeting_cherie_05_male_aba6ac0c:
    cherie.say "И теперь каждый, кто станет писать о нашей компании, сможет проиллюстрировать статью этой фотографией."

# bg/ceo/ceo.rpy:2576
translate russian result_meeting_cherie_05_male_deae7817:
    "Её публикуют снова. И будут публиковать дальше."

# bg/ceo/ceo.rpy:2588
translate russian meeting_cherie_06_male_bc02137d:
    "Уильям опять излагает мне факты."

# bg/ceo/ceo.rpy:2590
translate russian meeting_cherie_06_male_72cb8ad3:
    "Уильям" "Торн требуют скидку в двадцать процентов за продление договора. И позаботились, чтобы до нас дошло: они ещё и с Веррин общаются."

# bg/ceo/ceo.rpy:2592
translate russian meeting_cherie_06_male_1e794f03:
    "Но сегодня Шери, похоже, не склонна придавать этому значение."

# bg/ceo/ceo.rpy:2594
translate russian meeting_cherie_06_male_ae1a04ed:
    cherie.say "Тогда дайте им скидку. Великодушно. Пусть ясно понимают, что это подарок, а не поражение."

# bg/ceo/ceo.rpy:2595
translate russian meeting_cherie_06_male_9572c67d:
    cherie.say "На них приходится семнадцать процентов выручки. Отношения такого масштаба важнее такой доли прибыли."

# bg/ceo/ceo.rpy:2598
translate russian meeting_cherie_06_male_aba370be:
    "Уильям" "Мэм, они не могут уйти."

# bg/ceo/ceo.rpy:2601
translate russian meeting_cherie_06_male_b409dff0:
    cherie.say "Что вы такое говорите?!"

# bg/ceo/ceo.rpy:2604
translate russian meeting_cherie_06_male_90ba611c:
    "Уильям" "Всё их планирование работает на нашей системе. На всех семнадцати площадках."

# bg/ceo/ceo.rpy:2605
translate russian meeting_cherie_06_male_aed3807f:
    "Уильям" "Переход займёт пять месяцев и обойдётся им примерно в два миллиона."

# bg/ceo/ceo.rpy:2606
translate russian meeting_cherie_06_male_663000c6:
    "Уильям" "А одобрять его придётся тому самому человеку, который изначально выбрал нас."

# bg/ceo/ceo.rpy:2608
translate russian meeting_cherie_06_male_ea13d5ba:
    "Уильям" "Они не ищут альтернативу. Они изображают поиск."

# bg/ceo/ceo.rpy:2609
translate russian meeting_cherie_06_male_23ba74a4:
    "Уильям" "Цену сохраняем, а вместо скидки предложим обслуживание по более высокому тарифу. Нам это обойдётся в сорок тысяч, для них будет выглядеть как сто восемьдесят."

# bg/ceo/ceo.rpy:2612
translate russian meeting_cherie_06_male_dfcc86b4:
    cherie.say "А если вы ошибаетесь, мы потеряем семнадцать процентов выручки, потому что один молодой человек был слишком доволен собой."

# bg/ceo/ceo.rpy:2615
translate russian meeting_cherie_06_male_de98b237:
    "Уильям" "Если я ошибаюсь, то подам в отставку, мэм."

# bg/ceo/ceo.rpy:2618
translate russian meeting_cherie_06_male_1f14bf20:
    cherie.say "Не говорите так. Никогда. Это означает лишь одно: вы перестали думать."

# bg/ceo/ceo.rpy:2621
translate russian meeting_cherie_06_male_9ca75cc5:
    "На этот раз у Уильяма нет готового ответа."

# bg/ceo/ceo.rpy:2624
translate russian meeting_cherie_06_male_8e3fca64:
    "По-моему, в словах Уильяма больше смысла."

# bg/ceo/ceo.rpy:2625
translate russian meeting_cherie_06_male_c74a5510:
    mike.say "Цену держим. Предлагаем более высокий уровень обслуживания."

# bg/ceo/ceo.rpy:2626
translate russian meeting_cherie_06_male_68bc01d5:
    "Он кивает, мгновенно всё поняв."

# bg/ceo/ceo.rpy:2628
translate russian meeting_cherie_06_male_785930da:
    "Уильям" "Да, босс. Сам к ним съезжу."

# bg/ceo/ceo.rpy:2630
translate russian meeting_cherie_06_male_190470aa:
    "Но Шери, похоже, не собирается так легко уступать."

# bg/ceo/ceo.rpy:2632
translate russian meeting_cherie_06_male_382d34ff:
    cherie.say "Вы поедете вместе со мной. И не заговорите, пока я не закончу."

# bg/ceo/ceo.rpy:2635
translate russian meeting_cherie_06_male_5199ed64:
    "Уильям" "Да, мэм."

# bg/ceo/ceo.rpy:2637
translate russian meeting_cherie_06_male_5afa9b18:
    mike.say "Уильям, если ошибёшься, ты не уйдёшь в отставку. Ты будешь всё исправлять."

# bg/ceo/ceo.rpy:2639
translate russian meeting_cherie_06_male_e78dc814:
    "Уильям" "Это хуже, сэр."

# bg/ceo/ceo.rpy:2641
translate russian meeting_cherie_06_male_a8717d79:
    mike.say "Тогда не ошибайся!"

# bg/ceo/ceo.rpy:2642
translate russian meeting_cherie_06_male_3cb4db99:
    "Шери издаёт тихий звук, который у кого угодно другого сошёл бы за смешок."

# bg/ceo/ceo.rpy:2646
translate russian meeting_cherie_06_male_af8df916:
    "По-моему, в словах Шери больше смысла."

# bg/ceo/ceo.rpy:2647
translate russian meeting_cherie_06_male_95fae42d:
    mike.say "Дай им двадцать процентов, Шери. Пусть почувствуют, что мы делаем одолжение."

# bg/ceo/ceo.rpy:2649
translate russian meeting_cherie_06_male_6881747b:
    "Шери кивает с улыбкой."

# bg/ceo/ceo.rpy:2650
translate russian meeting_cherie_06_male_11dd1fde:
    cherie.say "Они почувствуют, что большего одолжения им ещё никто не делал."

# bg/ceo/ceo.rpy:2651
translate russian meeting_cherie_06_male_3b82b11a:
    cherie.say "Это ведь тоже умение. Хотя никто его так не называет."

# bg/ceo/ceo.rpy:2654
translate russian meeting_cherie_06_male_676a414c:
    "Уильям" "Босс, они блефовали."

# bg/ceo/ceo.rpy:2656
translate russian meeting_cherie_06_male_79dbb238:
    mike.say "Возможно..."

# bg/ceo/ceo.rpy:2657
translate russian meeting_cherie_06_male_cff6b417:
    mike.say "Семнадцать процентов — не та сумма, на которой я хочу упражняться в хитрости."

# bg/ceo/ceo.rpy:2659
translate russian meeting_cherie_06_male_08cb5eff:
    "Уильям" "Понял, сэр... Очень осмотрительно."

# bg/ceo/ceo.rpy:2661
translate russian meeting_cherie_06_male_abe18629:
    "Уильям произносит {i}осмотрительно{/i} так, как другие говорят {i}трусливо{/i}, а потом улыбается мне во весь рот."

# bg/ceo/ceo.rpy:2675
translate russian result_meeting_cherie_06_male_bc277059:
    "Торн молчат пять дней."

# bg/ceo/ceo.rpy:2676
translate russian result_meeting_cherie_06_male_3bf20607:
    "Насколько я могу судить, Уильям за это время вообще не спит."

# bg/ceo/ceo.rpy:2677
translate russian result_meeting_cherie_06_male_5f56731c:
    "А вот Шери выглядит вполне отдохнувшей."

# bg/ceo/ceo.rpy:2679
translate russian result_meeting_cherie_06_male_952470d9:
    cherie.say "Подписали."

# bg/ceo/ceo.rpy:2680
translate russian result_meeting_cherie_06_male_c3af6643:
    cherie.say "По полной цене. Взяли повышенный уровень обслуживания и спросили, можно ли распространить его ещё и на двенадцатую площадку."

# bg/ceo/ceo.rpy:2683
translate russian result_meeting_cherie_06_male_5288a2aa:
    "Энтони" "Можно. Нам это обойдётся в четыре тысячи, а они согласились заплатить семнадцать."

# bg/ceo/ceo.rpy:2686
translate russian result_meeting_cherie_06_male_63093ca7:
    "Уильям словно лишился дара речи."

# bg/ceo/ceo.rpy:2688
translate russian result_meeting_cherie_06_male_b400751a:
    "Уильям" "Босс... Босс... Вы слышали? Они будут платить нам БОЛЬШЕ!"

# bg/ceo/ceo.rpy:2691
translate russian result_meeting_cherie_06_male_6be54957:
    cherie.say "Уильям, сядьте, пока не покалечились."

# bg/ceo/ceo.rpy:2692
translate russian result_meeting_cherie_06_male_117530b5:
    cherie.say "Вы были правы."

# bg/ceo/ceo.rpy:2693
translate russian result_meeting_cherie_06_male_c5a6d36e:
    cherie.say "И пришли к этому правильным путём, что случается куда реже. Я скажу это каждому, кто спросит."

# bg/ceo/ceo.rpy:2696
translate russian result_meeting_cherie_06_male_b728d3f4:
    "Уильям" "Спасибо, мэм. Правда."

# bg/ceo/ceo.rpy:2698
translate russian result_meeting_cherie_06_male_3d4fb2d8:
    "Впервые слышу, чтобы он говорил что-то без задней мысли."

# bg/ceo/ceo.rpy:2700
translate russian result_meeting_cherie_06_male_c808bc83:
    "Торн немедленно соглашаются на двадцатипроцентную скидку. Это первый плохой знак."

# bg/ceo/ceo.rpy:2702
translate russian result_meeting_cherie_06_male_4650ab98:
    "Энтони" "Двести шестьдесят тысяч годовой прибыли исчезли одним росчерком пера."

# bg/ceo/ceo.rpy:2703
translate russian result_meeting_cherie_06_male_6049ea49:
    "Энтони" "А ещё позвонили Барсли."

# bg/ceo/ceo.rpy:2704
translate russian result_meeting_cherie_06_male_0d455e2c:
    "Энтони" "Они узнали об условиях Торн и хотели бы досрочно обсудить продление своего договора."

# bg/ceo/ceo.rpy:2706
translate russian result_meeting_cherie_06_male_722a3738:
    "Я огорчённо качаю головой."

# bg/ceo/ceo.rpy:2707
translate russian result_meeting_cherie_06_male_a988fd66:
    mike.say "Откуда Барсли узнали?!"

# bg/ceo/ceo.rpy:2709
translate russian result_meeting_cherie_06_male_0949ae03:
    cherie.say "Торн им рассказали."

# bg/ceo/ceo.rpy:2710
translate russian result_meeting_cherie_06_male_8660c400:
    cherie.say "Люди всегда рассказывают. В этом и заключается всё удовольствие от победы."

# bg/ceo/ceo.rpy:2713
translate russian result_meeting_cherie_06_male_5f78b634:
    "Уильям" "Ещё трое, босс! С тех пор, как это стало известно, попросили ещё трое!"

# bg/ceo/ceo.rpy:2716
translate russian result_meeting_cherie_06_male_85ce149c:
    cherie.say "Он был прав, а я ошиблась."

# bg/ceo/ceo.rpy:2717
translate russian result_meeting_cherie_06_male_17274b6c:
    cherie.say "Мне бы очень хотелось перейти к следующему вопросу."

# bg/ceo/ceo.rpy:2719
translate russian result_meeting_cherie_06_male_5abcd6df:
    "Минуты полторы к следующему вопросу так никто и не переходит."

# bg/ceo/ceo.rpy:2731
translate russian meeting_cassidy_01_male_dcba05e0:
    "Сегодня плохие новости приносит Артур."

# bg/ceo/ceo.rpy:2733
translate russian meeting_cassidy_01_male_86e1a66c:
    "Артур" "Сотрудница отдела отправки выложила видео из погрузочной зоны. Сорок секунд, больше двух миллионов просмотров."

# bg/ceo/ceo.rpy:2734
translate russian meeting_cassidy_01_male_930fbaf7:
    "Артур" "Она в форме, название компании видно всё время, а процесс упаковки она описывает в выражениях, которые я не стану повторять в этой комнате."

# bg/ceo/ceo.rpy:2736
translate russian meeting_cassidy_01_male_b19fb2ec:
    "Артур" "Немедленное увольнение. Грубое нарушение, ущерб репутации компании. Внутренние правила не допускают разночтений."

# bg/ceo/ceo.rpy:2738
translate russian meeting_cassidy_01_male_1a0941c3:
    "Кэссиди с усмешкой смотрит на Артура."

# bg/ceo/ceo.rpy:2740
translate russian meeting_cassidy_01_male_73c9320d:
    cassidy.say "Ты вообще смотрел?"

# bg/ceo/ceo.rpy:2743
translate russian meeting_cassidy_01_male_14f410f4:
    "Артур" "Я прочёл расшифровку."

# bg/ceo/ceo.rpy:2746
translate russian meeting_cassidy_01_male_4809f97b:
    cassidy.say "Боже мой... Милый, дай телефон..."

# bg/ceo/ceo.rpy:2747
translate russian meeting_cassidy_01_male_6b9f4797:
    cassidy.say "Это смешно. Правда смешно. И даже не зло."

# bg/ceo/ceo.rpy:2748
translate russian meeting_cassidy_01_male_b118c3bb:
    cassidy.say "Она ругается на пистолет для скотча, а сорок тысяч человек в комментариях пишут, что хотят у нас работать."

# bg/ceo/ceo.rpy:2750
translate russian meeting_cassidy_01_male_5303a3f1:
    cassidy.say "Уволите её — получите совсем другое видео. Где она плачет на парковке. И десять миллионов просмотров!"

# bg/ceo/ceo.rpy:2751
translate russian meeting_cassidy_01_male_4fc2545a:
    cassidy.say "Раскрутите аккаунт, платите ей нормально, приставьте кого-нибудь с головой, и пусть продолжает."

# bg/ceo/ceo.rpy:2754
translate russian meeting_cassidy_01_male_7b34711a:
    "Артур" "Вы хотите повысить женщину за то, что она обругала в интернете пистолет для скотча?!"

# bg/ceo/ceo.rpy:2757
translate russian meeting_cassidy_01_male_961fb254:
    cassidy.say "Я хочу нанять единственного человека в этом здании, который умеет нравиться людям!"

# bg/ceo/ceo.rpy:2760
translate russian meeting_cassidy_01_male_561f66fd:
    "Артур поворачивается ко мне с терпением, которому позавидовал бы горный хребет."

# bg/ceo/ceo.rpy:2763
translate russian meeting_cassidy_01_male_35da7c31:
    "У меня правда нет времени на подобную чушь."

# bg/ceo/ceo.rpy:2764
translate russian meeting_cassidy_01_male_25e2709f:
    mike.say "Уволь её. Артур, всё по правилам и по-человечески."

# bg/ceo/ceo.rpy:2765
translate russian meeting_cassidy_01_male_e6e023a5:
    "Артур кивает, явно восприняв ответ как подтверждение своей правоты."

# bg/ceo/ceo.rpy:2767
translate russian meeting_cassidy_01_male_11cf0fa7:
    "Артур" "Я всегда поступаю достойно. Просто не душевно. Эти вещи часто путают."

# bg/ceo/ceo.rpy:2770
translate russian meeting_cassidy_01_male_5885957b:
    "Кэссиди, напротив, заметно раздражена."

# bg/ceo/ceo.rpy:2772
translate russian meeting_cassidy_01_male_b89e0b49:
    cassidy.say "Какая же это ошибка."

# bg/ceo/ceo.rpy:2774
translate russian meeting_cassidy_01_male_5cf55e3a:
    mike.say "Это сотрудница в форме, на действующей погрузочной площадке."

# bg/ceo/ceo.rpy:2776
translate russian meeting_cassidy_01_male_a673421b:
    cassidy.say "Нет! Это девушка с пистолетом для скотча и четыреста тысяч человек, которым мы понравились за один день!"

# bg/ceo/ceo.rpy:2777
translate russian meeting_cassidy_01_male_fb49e83d:
    cassidy.say "Ладно... увольняй. Папочка бы именно так и сделал, конечно."

# bg/ceo/ceo.rpy:2779
translate russian meeting_cassidy_01_male_1127c690:
    "Она уже наловчилась пускать этот аргумент в ход."

# bg/ceo/ceo.rpy:2780
translate russian meeting_cassidy_01_male_d2588259:
    "И точно знает, куда ударить, чтобы было больнее."

# bg/ceo/ceo.rpy:2784
translate russian meeting_cassidy_01_male_61da7a5f:
    "Кажется, сейчас как раз тот случай, когда нужно мыслить нестандартно."

# bg/ceo/ceo.rpy:2785
translate russian meeting_cassidy_01_male_e36c717b:
    mike.say "Она остаётся."

# bg/ceo/ceo.rpy:2786
translate russian meeting_cassidy_01_male_27ebba46:
    mike.say "Кэссиди, иди нормально с ней поговори. Пока она не услышала что-нибудь от других."

# bg/ceo/ceo.rpy:2788
translate russian meeting_cassidy_01_male_5d04f535:
    "Кэссиди в восторге от моего решения."

# bg/ceo/ceo.rpy:2790
translate russian meeting_cassidy_01_male_fffc107e:
    cassidy.say "Уже написала ей. Она думает, что её увольняют!"

# bg/ceo/ceo.rpy:2791
translate russian meeting_cassidy_01_male_cadfa7b5:
    cassidy.say "Это очень грустно. И мне это нравится... немножко."

# bg/ceo/ceo.rpy:2794
translate russian meeting_cassidy_01_male_f1de67a5:
    "Артур, судя по голосу, уже пытается сохранить лицо."

# bg/ceo/ceo.rpy:2796
translate russian meeting_cassidy_01_male_af0631be:
    "Артур" "Требую внести изменения в правила, прежде чем это станет прецедентом."

# bg/ceo/ceo.rpy:2798
translate russian meeting_cassidy_01_male_f27a2810:
    mike.say "Вноси. Что-нибудь вроде {i}шутите, но не тупите{/i}."

# bg/ceo/ceo.rpy:2800
translate russian meeting_cassidy_01_male_ee8a6567:
    "Артур" "Переведу это на человеческий язык. За этим я здесь и нужен."

# bg/ceo/ceo.rpy:2803
translate russian meeting_cassidy_01_male_f0623d5a:
    cassidy.say "Он такой странный. Обожаю его."

# bg/ceo/ceo.rpy:2805
translate russian meeting_cassidy_01_male_fd6536e5:
    "Артур до крайности очевидно делает вид, что ничего не услышал."

# bg/ceo/ceo.rpy:2819
translate russian result_meeting_cassidy_01_male_d43e3cb3:
    "Девушку с пистолетом для скотча зовут Прия. Ей двадцать шесть, и она выложила ещё одиннадцать видео."

# bg/ceo/ceo.rpy:2820
translate russian result_meeting_cassidy_01_male_ebc5f086:
    "А Кэссиди, похоже, уже записала этот успех на свой счёт."

# bg/ceo/ceo.rpy:2822
translate russian result_meeting_cassidy_01_male_52c55f3b:
    cassidy.say "Восемь миллионов просмотров! ВОСЕМЬ МИЛЛИОНОВ!"

# bg/ceo/ceo.rpy:2825
translate russian result_meeting_cassidy_01_male_e84165ed:
    "Энтони" "За семь дней число откликов на складские вакансии выросло на четыреста процентов."

# bg/ceo/ceo.rpy:2826
translate russian result_meeting_cassidy_01_male_a0535425:
    "Энтони" "Мы закрыли шесть вакансий, на которые год не могли найти людей."

# bg/ceo/ceo.rpy:2828
translate russian result_meeting_cassidy_01_male_cd8c1580:
    "Энтони" "За квартал расходы на кадровое агентство — ноль. Экономия девяносто одна тысяча!"

# bg/ceo/ceo.rpy:2831
translate russian result_meeting_cassidy_01_male_7ce1b39e:
    "Артур, напротив, изо всех сил пытается сохранить лицо."

# bg/ceo/ceo.rpy:2833
translate russian result_meeting_cassidy_01_male_dd1960d2:
    "Артур" "Новая редакция пункта правил вступила в силу."

# bg/ceo/ceo.rpy:2835
translate russian result_meeting_cassidy_01_male_30f806b5:
    "Артур" "В нём два предложения. Считаю это личным унижением."

# bg/ceo/ceo.rpy:2838
translate russian result_meeting_cassidy_01_male_20aaffb9:
    cassidy.say "Я читала. Хороший пункт."

# bg/ceo/ceo.rpy:2841
translate russian result_meeting_cassidy_01_male_15810818:
    "Артур" "Спасибо."

# bg/ceo/ceo.rpy:2843
translate russian result_meeting_cassidy_01_male_c4719269:
    "А ещё Кэссиди тихонько добилась для Прии прибавки к зарплате."

# bg/ceo/ceo.rpy:2844
translate russian result_meeting_cassidy_01_male_4415399f:
    "И ни разу об этом не упомянула. Для Кэссиди это почти чудо."

# bg/ceo/ceo.rpy:2846
translate russian result_meeting_cassidy_01_male_e1e616ce:
    "Выходит второе видео. Как Кэссиди и предсказывала, оно снято на парковке."

# bg/ceo/ceo.rpy:2848
translate russian result_meeting_cassidy_01_male_3b4217e3:
    cassidy.say "Уже девять миллионов!"

# bg/ceo/ceo.rpy:2849
translate russian result_meeting_cassidy_01_male_421b073b:
    cassidy.say "Она там даже не злится. Оттого всё ещё хуже."

# bg/ceo/ceo.rpy:2851
translate russian result_meeting_cassidy_01_male_28204627:
    "Артур, похоже, изо всех сил старается игнорировать эту сторону дела."

# bg/ceo/ceo.rpy:2853
translate russian result_meeting_cassidy_01_male_ae3e6e30:
    "Артур" "С юридической точки зрения увольнение безупречно."

# bg/ceo/ceo.rpy:2854
translate russian result_meeting_cassidy_01_male_c1e87192:
    "Артур" "Я проверил его четыре раза. С каждым разом оно всё безупречнее и всё бесполезнее."

# bg/ceo/ceo.rpy:2856
translate russian result_meeting_cassidy_01_male_33cd0a1f:
    mike.say "А реальный ущерб есть?"

# bg/ceo/ceo.rpy:2858
translate russian result_meeting_cassidy_01_male_abdf0de7:
    "Энтони" "Двести одиннадцать отменённых заказов за шесть дней."

# bg/ceo/ceo.rpy:2859
translate russian result_meeting_cassidy_01_male_865c93d9:
    "Энтони" "Откликов на вакансии стало на шестьдесят процентов меньше."

# bg/ceo/ceo.rpy:2860
translate russian result_meeting_cassidy_01_male_2391e706:
    "Энтони" "А ещё один клиент письменно потребовал разъяснений о наших методах обращения с сотрудниками."

# bg/ceo/ceo.rpy:2863
translate russian result_meeting_cassidy_01_male_28bf7a1f:
    cassidy.say "Она пошутила про ПИСТОЛЕТ ДЛЯ СКОТЧА!"

# bg/ceo/ceo.rpy:2865
translate russian result_meeting_cassidy_01_male_8f8c535c:
    cassidy.say "А теперь мы навсегда компания, которая увольняет девушек!"

# bg/ceo/ceo.rpy:2866
translate russian result_meeting_cassidy_01_male_248f97a5:
    cassidy.say "Потому что это в интернете. А интернет никогда ничего не забывает."

# bg/ceo/ceo.rpy:2869
translate russian result_meeting_cassidy_01_male_946bc465:
    "Артур" "В вопросе закона я был прав."

# bg/ceo/ceo.rpy:2871
translate russian result_meeting_cassidy_01_male_b82f8d8c:
    mike.say "Да, Артур. Был."

# bg/ceo/ceo.rpy:2872
translate russian result_meeting_cassidy_01_male_838438af:
    "Но, похоже, никого в комнате этот факт не утешает."

# bg/ceo/ceo.rpy:2884
translate russian meeting_cassidy_02_male_9398aa81:
    "Кэссиди представляет свой план и выкладывается по полной."

# bg/ceo/ceo.rpy:2886
translate russian meeting_cassidy_02_male_15089cbd:
    cassidy.say "Презентация: вилла, сорок гостей, две ночи, бассейн. Все влиятельные люди страны моложе тридцати."

# bg/ceo/ceo.rpy:2888
translate russian meeting_cassidy_02_male_5628f2fb:
    cassidy.say "Вилла есть, список есть. Четверо уже согласились, но письменно ничего подтверждать не будут, потому что так это не работает."

# bg/ceo/ceo.rpy:2891
translate russian meeting_cassidy_02_male_aca67e43:
    "Как ни странно, Артур идеей не проникся."

# bg/ceo/ceo.rpy:2893
translate russian meeting_cassidy_02_male_bc628155:
    "Артур" "Ничего письменно?"

# bg/ceo/ceo.rpy:2896
translate russian meeting_cassidy_02_male_eff624ca:
    cassidy.say "Ничего. Это атмосфера, Артур. Атмосферу в договор не впишешь."

# bg/ceo/ceo.rpy:2899
translate russian meeting_cassidy_02_male_90c1866e:
    "Артур" "Тогда позвольте описать, что вы предлагаете..."

# bg/ceo/ceo.rpy:2900
translate russian meeting_cassidy_02_male_238d3c81:
    "Артур" "Сорок гостей, бесплатный бар, бассейн без ограждения. Никакой страховки ответственности, никаких согласий на съёмку и никакой проверки возраста."

# bg/ceo/ceo.rpy:2902
translate russian meeting_cassidy_02_male_e4adb4da:
    "Артур" "Вы предлагаете вечеринку, на которой мы отвечаем за всё происходящее и при этом ничего не контролируем."

# bg/ceo/ceo.rpy:2905
translate russian meeting_cassidy_02_male_eb368747:
    cassidy.say "Ты хочешь вечеринку, где на входе все подписывают отказ от претензий!"

# bg/ceo/ceo.rpy:2906
translate russian meeting_cassidy_02_male_39521bca:
    cassidy.say "К слову, менее привлекательную фразу ещё никто не придумывал."

# bg/ceo/ceo.rpy:2909
translate russian meeting_cassidy_02_male_ec50f2bd:
    "Артур" "Я придумывал фразы куда менее привлекательные. Они спасали целые компании!"

# bg/ceo/ceo.rpy:2911
translate russian meeting_cassidy_02_male_6dc189c7:
    "Артур" "Отказы от претензий, страховка, назначенный ответственный и один сотрудник, вся работа которого — оставаться трезвым."

# bg/ceo/ceo.rpy:2912
translate russian meeting_cassidy_02_male_98981cd1:
    "Артур" "Таковы мои условия. Они не обсуждаются."

# bg/ceo/ceo.rpy:2915
translate russian meeting_cassidy_02_male_ccfd1111:
    cassidy.say "Всё заглохнет! Ты всё угробишь, будешь виноват и даже не расстроишься!"

# bg/ceo/ceo.rpy:2918
translate russian meeting_cassidy_02_male_52df5cfb:
    "Артур поправляет очки. Именно так он поступает вместо того, чтобы повысить голос."

# bg/ceo/ceo.rpy:2921
translate russian meeting_cassidy_02_male_7efa0e51:
    "Мне кажется, в таких вещах Кэссиди и правда разбирается лучше."

# bg/ceo/ceo.rpy:2922
translate russian meeting_cassidy_02_male_281fa464:
    mike.say "Делай по-своему, Кэссиди. Только не заставь меня пожалеть."

# bg/ceo/ceo.rpy:2924
translate russian meeting_cassidy_02_male_1fc9eb67:
    "Стоит мне встать на её сторону, как настроение Кэссиди резко улучшается."

# bg/ceo/ceo.rpy:2926
translate russian meeting_cassidy_02_male_63e17cf0:
    cassidy.say "Не заставлю! Тебе понравится, поверь!"

# bg/ceo/ceo.rpy:2928
translate russian meeting_cassidy_02_male_8ccfd0c5:
    "Едва она заканчивает говорить, я готовлюсь выслушать лекцию Артура."

# bg/ceo/ceo.rpy:2930
translate russian meeting_cassidy_02_male_732248ac:
    "Артур" "Скажу один раз. Повторять не стану."

# bg/ceo/ceo.rpy:2932
translate russian meeting_cassidy_02_male_5a30a205:
    "Артур" "Вам двадцать пять, и вы лично занимаете должность директора. Это не абстракция."

# bg/ceo/ceo.rpy:2934
translate russian meeting_cassidy_02_male_4ff9347d:
    mike.say "Принял к сведению."

# bg/ceo/ceo.rpy:2936
translate russian meeting_cassidy_02_male_d8a5fdfa:
    "Артур" "К сведению это никогда не принимают. Только вспоминают потом."

# bg/ceo/ceo.rpy:2938
translate russian meeting_cassidy_02_male_8b42c985:
    "К тому времени, как он уходит, Кэссиди уже выбирает салфетки или что-то в этом роде."

# bg/ceo/ceo.rpy:2942
translate russian meeting_cassidy_02_male_1ba12d20:
    "Если всё оставить Кэссиди, ситуация может всерьёз выйти из-под контроля."

# bg/ceo/ceo.rpy:2943
translate russian meeting_cassidy_02_male_d5384b7e:
    mike.say "Отказы от претензий, страховка и трезвый взрослый. Или никакой виллы!"

# bg/ceo/ceo.rpy:2945
translate russian meeting_cassidy_02_male_894a4603:
    "Кэссиди начинает дуться ещё до того, как я заканчиваю."

# bg/ceo/ceo.rpy:2947
translate russian meeting_cassidy_02_male_0d4fe4d0:
    cassidy.say "Ты ведь за всю жизнь ни на одной нормальной вечеринке не был?"

# bg/ceo/ceo.rpy:2949
translate russian meeting_cassidy_02_male_e976c061:
    mike.say "На одной был... Меня вырвало в кусты."

# bg/ceo/ceo.rpy:2951
translate russian meeting_cassidy_02_male_0641fc71:
    cassidy.say "Правда?!"

# bg/ceo/ceo.rpy:2953
translate russian meeting_cassidy_02_male_4d8f00d8:
    cassidy.say "Ладно, это даже довольно мило. Печально, но мило."

# bg/ceo/ceo.rpy:2955
translate russian meeting_cassidy_02_male_d138a153:
    cassidy.say "Хорошо... ХОРОШО! Пусть Артур получит все свои бумажки."

# bg/ceo/ceo.rpy:2958
translate russian meeting_cassidy_02_male_cd7549ba:
    "Артур" "Мне не нужны бумажки. Я хочу, чтобы вечеринка состоялась и никто не утонул."

# bg/ceo/ceo.rpy:2961
translate russian meeting_cassidy_02_male_68e5b1ca:
    cassidy.say "Боже, когда ты так говоришь, кажется, будто ты на моей стороне. Терпеть это не могу."

# bg/ceo/ceo.rpy:2963
translate russian meeting_cassidy_02_male_e204be5b:
    "Артур позволяет себе примерно четыре процента улыбки."

# bg/ceo/ceo.rpy:2976
translate russian result_meeting_cassidy_02_male_93f3e258:
    "Вечеринка проходит с триумфом все выходные. Такого не ожидал никто, и я меньше всех."

# bg/ceo/ceo.rpy:2977
translate russian result_meeting_cassidy_02_male_1ef12272:
    "Кэссиди, разумеется, на седьмом небе."

# bg/ceo/ceo.rpy:2979
translate russian result_meeting_cassidy_02_male_c9bed295:
    cassidy.say "Сорок человек, двадцать выложили посты. У видео с бассейном три миллиона просмотров, и волосы у меня там ПРОСТО ОТПАД!"

# bg/ceo/ceo.rpy:2981
translate russian result_meeting_cassidy_02_male_4b7753b9:
    "Артур, впрочем, смотрит на всё гораздо трезвее."

# bg/ceo/ceo.rpy:2983
translate russian result_meeting_cassidy_02_male_516efb9a:
    "Артур" "Посреди ночи кто-то прыгнул в бассейн."

# bg/ceo/ceo.rpy:2985
translate russian result_meeting_cassidy_02_male_f1a88c69:
    "Артур" "Его вытащил трезвый сотрудник по имени Кевин. Намерен предложить как-нибудь его поощрить."

# bg/ceo/ceo.rpy:2986
translate russian result_meeting_cassidy_02_male_814d4a3f:
    "Артур" "На входе гость подписал отказ от претензий, как и все остальные. Ущерб атмосфере, по имеющимся сведениям, оказался терпимым."

# bg/ceo/ceo.rpy:2989
translate russian result_meeting_cassidy_02_male_484190d1:
    cassidy.say "Терпимым... едва-едва."

# bg/ceo/ceo.rpy:2990
translate russian result_meeting_cassidy_02_male_c2b8df4d:
    cassidy.say "Кевин — зверь. Я добавила его везде."

# bg/ceo/ceo.rpy:2993
translate russian result_meeting_cassidy_02_male_9eefee2f:
    "Энтони" "Расходы — восемьдесят одна тысяча. Полученные благодаря мероприятию заявки — на два миллиона четыреста тысяч."

# bg/ceo/ceo.rpy:2994
translate russian result_meeting_cassidy_02_male_f2c29b64:
    "Энтони" "Лучшая отдача от маркетинговых расходов за всю историю компании. И меня возмущает способ, которым её добились."

# bg/ceo/ceo.rpy:2997
translate russian result_meeting_cassidy_02_male_bfcf50de:
    cassidy.say "Это самое приятное, что мне здесь кто-либо говорил."

# bg/ceo/ceo.rpy:2999
translate russian result_meeting_cassidy_02_male_6df29a19:
    "Артур подшивает отказы от претензий. Все сорок."

# bg/ceo/ceo.rpy:3000
translate russian result_meeting_cassidy_02_male_3b0ade3d:
    "По алфавиту. А как же иначе."

# bg/ceo/ceo.rpy:3002
translate russian result_meeting_cassidy_02_male_fb689550:
    "Вечеринка проходит с триумфом примерно девятнадцать часов."

# bg/ceo/ceo.rpy:3004
translate russian result_meeting_cassidy_02_male_b124e28e:
    cassidy.say "Кто-то посреди ночи прыгнул в бассейн."

# bg/ceo/ceo.rpy:3005
translate russian result_meeting_cassidy_02_male_3f30a307:
    cassidy.say "С ним всё хорошо. Совершенно."

# bg/ceo/ceo.rpy:3006
translate russian result_meeting_cassidy_02_male_f3449e83:
    cassidy.say "То есть у него перелом запястья, но всё хорошо."

# bg/ceo/ceo.rpy:3009
translate russian result_meeting_cassidy_02_male_15e127b7:
    "Артур смотрит на Кэссиди с крайним неодобрением."

# bg/ceo/ceo.rpy:3011
translate russian result_meeting_cassidy_02_male_e3cffb33:
    "Артур" "Ему двадцать. Ему подавали алкоголь на мероприятии, которое мы оплатили, в помещении, которое мы арендовали. Без страховки."

# bg/ceo/ceo.rpy:3012
translate russian result_meeting_cassidy_02_male_fe1d2dd1:
    "Артур" "Адвокат его матери уже звонил."

# bg/ceo/ceo.rpy:3014
translate russian result_meeting_cassidy_02_male_6f604de4:
    mike.say "Сколько?"

# bg/ceo/ceo.rpy:3016
translate russian result_meeting_cassidy_02_male_b048809f:
    "Артур" "Вопрос прежде всего не в деньгах. Хотя в денежном выражении это будет сто сорок тысяч."

# bg/ceo/ceo.rpy:3017
translate russian result_meeting_cassidy_02_male_8be70bd8:
    "Артур" "Вопрос в том, как на это посмотрят надзорные органы."

# bg/ceo/ceo.rpy:3019
translate russian result_meeting_cassidy_02_male_b2323795:
    "Артур" "Есть ещё проблема с фотографиями."

# bg/ceo/ceo.rpy:3020
translate russian result_meeting_cassidy_02_male_320c0798:
    "Артур" "Сорок гостей, ни одного согласия на использование изображений. Двое уже требуют убрать их фотографии из рекламы, которую мы напечатали."

# bg/ceo/ceo.rpy:3023
translate russian result_meeting_cassidy_02_male_5d61a239:
    cassidy.say "Но вечеринка была правда отличная!"

# bg/ceo/ceo.rpy:3025
translate russian result_meeting_cassidy_02_male_16c9584d:
    cassidy.say "Это ведь ничего не исправит, да?"

# bg/ceo/ceo.rpy:3028
translate russian result_meeting_cassidy_02_male_d0a91dec:
    "Артур" "Нет. Но мне жаль это слышать, если вам от этого хоть немного легче."

# bg/ceo/ceo.rpy:3030
translate russian result_meeting_cassidy_02_male_604b0bfd:
    "Как ни странно, из уст Артура — легче."

# bg/ceo/ceo.rpy:3042
translate russian meeting_cassidy_03_male_24f08ea0:
    "Я предельно сосредоточен и внимательно слушаю Энтони."

# bg/ceo/ceo.rpy:3044
translate russian meeting_cassidy_03_male_52f3edc9:
    "Энтони" "Маркетинговый бюджет на полугодие — миллион сто тысяч."

# bg/ceo/ceo.rpy:3045
translate russian meeting_cassidy_03_male_6af6a7c9:
    "Энтони" "Предлагаю направить восемьдесят два процента на «Меридиан». Это шестьдесят один процент выручки и самая высокая конверсия среди всех наших товаров."

# bg/ceo/ceo.rpy:3046
translate russian meeting_cassidy_03_male_47374b89:
    "Энтони" "Это не оценочное суждение, а простая математика."

# bg/ceo/ceo.rpy:3048
translate russian meeting_cassidy_03_male_924e63f8:
    "К всеобщему удивлению, Кэссиди возражает."

# bg/ceo/ceo.rpy:3050
translate russian meeting_cassidy_03_male_feab7a24:
    cassidy.say "Ты делишь деньги по прошлогодней картине."

# bg/ceo/ceo.rpy:3051
translate russian meeting_cassidy_03_male_e5ea0da1:
    cassidy.say "«Меридиан» покупают те, кто впервые купил его девять лет назад."

# bg/ceo/ceo.rpy:3052
translate russian meeting_cassidy_03_male_ced2f70e:
    cassidy.say "Ну же, посмотри, сколько среди них новых клиентов. Спорим?"

# bg/ceo/ceo.rpy:3055
translate russian meeting_cassidy_03_male_ecc0fc0d:
    "Энтони" "Повторные покупки — восемьдесят восемь процентов объёма продаж «Меридиана»."

# bg/ceo/ceo.rpy:3058
translate russian meeting_cassidy_03_male_d58f3dae:
    cassidy.say "То есть ты тратишь восемьсот тысяч долларов, чтобы напомнить владельцам вещи, что она у них есть."

# bg/ceo/ceo.rpy:3059
translate russian meeting_cassidy_03_male_c9dbe91e:
    cassidy.say "Отдайте деньги «Эш». Я знаю, что это семь процентов выручки."

# bg/ceo/ceo.rpy:3060
translate russian meeting_cassidy_03_male_526bb67b:
    cassidy.say "Но я также знаю, что это единственное из наших изделий, которое люди сами захотели выложить в интернет."

# bg/ceo/ceo.rpy:3063
translate russian meeting_cassidy_03_male_fd92b51f:
    "Энтони" "У «Эш» втрое ниже маржа, а цепочка поставок не выдержит роста объёма больше чем на сорок процентов."

# bg/ceo/ceo.rpy:3066
translate russian meeting_cassidy_03_male_0bdb013b:
    cassidy.say "Так наладь поставки! Вы же можете на это повлиять, это не погода!"

# bg/ceo/ceo.rpy:3069
translate russian meeting_cassidy_03_male_20ffcae2:
    "Энтони" "Не погода. Это девять месяцев."

# bg/ceo/ceo.rpy:3071
translate russian meeting_cassidy_03_male_fb66e99e:
    "Оба смотрят на меня, ожидая, что я встану на их сторону."

# bg/ceo/ceo.rpy:3072
translate russian meeting_cassidy_03_male_0bac009f:
    "Я понял примерно семьдесят процентов сказанного и сейчас поставлю миллион долларов на оставшиеся тридцать."

# bg/ceo/ceo.rpy:3075
translate russian meeting_cassidy_03_male_3777bac6:
    "Решаю, что слова Кэссиди прозвучали убедительнее."

# bg/ceo/ceo.rpy:3076
translate russian meeting_cassidy_03_male_37feeb56:
    mike.say "Перенеси бюджет на «Эш», Энтони. Но ограничь объём тем, что поставки реально выдержат."

# bg/ceo/ceo.rpy:3078
translate russian meeting_cassidy_03_male_3e73a1c3:
    "Энтони" "Рост на сорок процентов. Жёсткий предел."

# bg/ceo/ceo.rpy:3079
translate russian meeting_cassidy_03_male_776ecf68:
    "Энтони" "Иначе будем рекламировать товар, который не можем отгрузить. Это хуже, чем не рекламировать вообще."

# bg/ceo/ceo.rpy:3082
translate russian meeting_cassidy_03_male_2b4f5f0b:
    "Кэссиди довольна моим решением."

# bg/ceo/ceo.rpy:3084
translate russian meeting_cassidy_03_male_48366f50:
    cassidy.say "Сорока хватит. Сорок — это много."

# bg/ceo/ceo.rpy:3087
translate russian meeting_cassidy_03_male_9515031a:
    "Энтони" "Хочу пересмотреть распределение через восемь недель, а не через полгода."

# bg/ceo/ceo.rpy:3089
translate russian meeting_cassidy_03_male_9f971ef0:
    mike.say "Договорились."

# bg/ceo/ceo.rpy:3091
translate russian meeting_cassidy_03_male_6de3ad84:
    "Энтони" "Тогда возражений больше нет. Их было три."

# bg/ceo/ceo.rpy:3092
translate russian meeting_cassidy_03_male_004c9bc3:
    "Энтони" "На два я получил ответ, а третье было продиктовано гордостью."

# bg/ceo/ceo.rpy:3095
translate russian meeting_cassidy_03_male_f4ca51fa:
    "Кэссиди смотрит на него так, будто у него выросла вторая голова."

# bg/ceo/ceo.rpy:3099
translate russian meeting_cassidy_03_male_cd326904:
    "Решаю, что слова Энтони прозвучали убедительнее."

# bg/ceo/ceo.rpy:3100
translate russian meeting_cassidy_03_male_0e033438:
    mike.say "Оставляем «Меридиан». Он оплачивает всё остальное."

# bg/ceo/ceo.rpy:3101
translate russian meeting_cassidy_03_male_5cd00fc6:
    "Энтони кивает."

# bg/ceo/ceo.rpy:3103
translate russian meeting_cassidy_03_male_85ee1b89:
    "Энтони" "Верно. Распределение остаётся прежним."

# bg/ceo/ceo.rpy:3106
translate russian meeting_cassidy_03_male_dda5660a:
    "А вот Кэссиди впечатлена куда меньше."

# bg/ceo/ceo.rpy:3108
translate russian meeting_cassidy_03_male_1be29dea:
    cassidy.say "Вы такие скучные! Оба! Здесь скучно, и вы нарочно сделали так, чтобы было скучно!"

# bg/ceo/ceo.rpy:3110
translate russian meeting_cassidy_03_male_2a01fc0a:
    mike.say "Кэссиди, шестьдесят один процент выручки..."

# bg/ceo/ceo.rpy:3112
translate russian meeting_cassidy_03_male_293ee1a4:
    cassidy.say "Я знаю, что такое шестьдесят один процент!"

# bg/ceo/ceo.rpy:3113
translate russian meeting_cassidy_03_male_6888ff98:
    cassidy.say "Я говорю, что в следующем году будет сорок, и вы все ужасно удивитесь!"

# bg/ceo/ceo.rpy:3116
translate russian meeting_cassidy_03_male_37539223:
    "Она забирает сумку и уходит, не закрыв дверь. Это её излюбленный способ хлопнуть дверью."

# bg/ceo/ceo.rpy:3129
translate russian result_meeting_cassidy_03_male_e2b3e772:
    "Энтони просит о встрече, чего обычно не делает."

# bg/ceo/ceo.rpy:3131
translate russian result_meeting_cassidy_03_male_83873fe2:
    "Энтони" "Объём продаж «Эш» вырос на шестьдесят два процента при ограничении в сорок. Потому что мы ограничивали расходы, а спрос мои служебные записки не читает."

# bg/ceo/ceo.rpy:3132
translate russian result_meeting_cassidy_03_male_b0cddbd0:
    "Энтони" "Привлечение новых клиентов выросло на двести семь процентов. Продажи «Меридиана» упали на четыре процента, что укладывается в обычные колебания."

# bg/ceo/ceo.rpy:3134
translate russian result_meeting_cassidy_03_male_85108add:
    mike.say "То есть деньги перераспределили, и ничего не сломалось?"

# bg/ceo/ceo.rpy:3136
translate russian result_meeting_cassidy_03_male_1eb8f1bd:
    "Энтони" "Деньги перераспределили, и средний возраст нового клиента снизился на девять лет."

# bg/ceo/ceo.rpy:3137
translate russian result_meeting_cassidy_03_male_a5876d3b:
    "Энтони" "Этой цифры я не ожидал и пока не могу объяснить."

# bg/ceo/ceo.rpy:3139
translate russian result_meeting_cassidy_03_male_e422457b:
    "Кэссиди вступает в разговор с вполне заслуженным самодовольством."

# bg/ceo/ceo.rpy:3141
translate russian result_meeting_cassidy_03_male_68624d48:
    cassidy.say "А я могу объяснить. Людям нравится!"

# bg/ceo/ceo.rpy:3144
translate russian result_meeting_cassidy_03_male_c3df4c90:
    "Энтони" "Это не объяснение. Вы просто повторили результат."

# bg/ceo/ceo.rpy:3147
translate russian result_meeting_cassidy_03_male_320f7193:
    cassidy.say "Другого объяснения никогда и не было, милый."

# bg/ceo/ceo.rpy:3148
translate russian result_meeting_cassidy_03_male_85d7b061:
    cassidy.say "Запиши!"

# bg/ceo/ceo.rpy:3150
translate russian result_meeting_cassidy_03_male_edf2f8be:
    "Он не записывает."

# bg/ceo/ceo.rpy:3152
translate russian result_meeting_cassidy_03_male_391926a1:
    "Но и не спорит. Для Энтони это событие эпохального масштаба."

# bg/ceo/ceo.rpy:3154
translate russian result_meeting_cassidy_03_male_85bb6f3c:
    "Кампания «Меридиана» даёт ровно тот результат, который предсказывала модель. В этом и оказывается проблема."

# bg/ceo/ceo.rpy:3156
translate russian result_meeting_cassidy_03_male_a98234f4:
    "Энтони" "Конверсия по прогнозу, выручка по прогнозу."

# bg/ceo/ceo.rpy:3157
translate russian result_meeting_cassidy_03_male_de3a2e77:
    "Энтони" "Привлечение новых клиентов снизилось на семь процентов относительно прошлого полугодия."

# bg/ceo/ceo.rpy:3158
translate russian result_meeting_cassidy_03_male_c2f17ab1:
    "Энтони" "Мы потратили восемьсот тысяч. В результате прежние клиенты стали чуть лояльнее и на год старше."

# bg/ceo/ceo.rpy:3160
translate russian result_meeting_cassidy_03_male_0f09cdbf:
    mike.say "А что с «Эш»?"

# bg/ceo/ceo.rpy:3162
translate russian result_meeting_cassidy_03_male_20eab7ae:
    "Энтони" "«Эш» вырос на девятнадцать процентов вообще без бюджета. Это самая раздражающая строка отчёта."

# bg/ceo/ceo.rpy:3163
translate russian result_meeting_cassidy_03_male_4913f093:
    "Энтони" "Келлис объявили о прямом конкуренте «Эш». Судя по всему, в запуск вкладывают очень много денег."

# bg/ceo/ceo.rpy:3166
translate russian result_meeting_cassidy_03_male_a1f0d636:
    "Слушая всё это, Кэссиди выглядит подавленной."

# bg/ceo/ceo.rpy:3168
translate russian result_meeting_cassidy_03_male_8168e85b:
    cassidy.say "Я ведь говорила. Правда?"

# bg/ceo/ceo.rpy:3170
translate russian result_meeting_cassidy_03_male_78aa46c4:
    mike.say "Говорила."

# bg/ceo/ceo.rpy:3172
translate russian result_meeting_cassidy_03_male_99ca5cf7:
    cassidy.say "Я даже злорадствовать не буду. Вот насколько всё плохо!"

# bg/ceo/ceo.rpy:3174
translate russian result_meeting_cassidy_03_male_c6eea03e:
    "И она действительно не выглядит довольной."

# bg/ceo/ceo.rpy:3175
translate russian result_meeting_cassidy_03_male_3577f0ef:
    "По этому я и понимаю, что всё серьёзно."

# bg/ceo/ceo.rpy:3187
translate russian meeting_cassidy_04_male_4af8abca:
    "Сегодня Кэссиди в приподнятом настроении и с огромным воодушевлением представляет мне свою идею."

# bg/ceo/ceo.rpy:3189
translate russian meeting_cassidy_04_male_bd7760ff:
    cassidy.say "Регата «Корвин»! Титульное спонсорство, четыреста тысяч, наше имя целую неделю на всём!"

# bg/ceo/ceo.rpy:3190
translate russian meeting_cassidy_04_male_6e11072d:
    cassidy.say "Там будут все. Вообще все! Я езжу туда с пятнадцати лет и точно знаю, кто на какой яхте."

# bg/ceo/ceo.rpy:3193
translate russian meeting_cassidy_04_male_1f110663:
    "Энтони" "Четыреста тысяч... Посещаемость — одиннадцать тысяч человек... Предполагаемый охват в СМИ — два миллиона сто тысяч."

# bg/ceo/ceo.rpy:3194
translate russian meeting_cassidy_04_male_57b4dbeb:
    "Энтони" "Стоимость тысячи контактов — сто девяносто долларов."

# bg/ceo/ceo.rpy:3195
translate russian meeting_cassidy_04_male_a0701483:
    "Энтони" "Следующий по неэффективности канал обходится нам в четыре доллара шестьдесят."

# bg/ceo/ceo.rpy:3198
translate russian meeting_cassidy_04_male_0ffb106a:
    cassidy.say "Дело не в охвате, а в том, КОГО мы охватим!"

# bg/ceo/ceo.rpy:3201
translate russian meeting_cassidy_04_male_66939733:
    "Энтони" "Тогда посмотрим кого. Я получил данные о прошлогодних посетителях..."

# bg/ceo/ceo.rpy:3202
translate russian meeting_cassidy_04_male_f4042966:
    "Энтони" "Медианный возраст — пятьдесят шесть лет. Медианное состояние семьи крайне высокое. Пересечение с целевой аудиторией нашей продукции — четыре процента."

# bg/ceo/ceo.rpy:3203
translate russian meeting_cassidy_04_male_802c4663:
    "Энтони" "Вы предлагаете потратить четыреста тысяч долларов на рекламу для одиннадцати тысяч человек..."

# bg/ceo/ceo.rpy:3204
translate russian meeting_cassidy_04_male_62c9d5f0:
    "Энтони" "Из которых примерно четыреста сорок в принципе могли бы что-то купить."

# bg/ceo/ceo.rpy:3207
translate russian meeting_cassidy_04_male_47f28085:
    cassidy.say "Это БРЕНД!"

# bg/ceo/ceo.rpy:3210
translate russian meeting_cassidy_04_male_23e8a234:
    "Энтони" "«Бренд» — слово, которым пользуются, когда арифметика складывается не в твою пользу."

# bg/ceo/ceo.rpy:3213
translate russian meeting_cassidy_04_male_0feac7a6:
    cassidy.say "Ладно, это было неплохо."

# bg/ceo/ceo.rpy:3215
translate russian meeting_cassidy_04_male_af32f5a5:
    "Она искренне рада тому, как удачно её поддели."

# bg/ceo/ceo.rpy:3216
translate russian meeting_cassidy_04_male_95b2aaf2:
    "Никогда мне не понять богачей."

# bg/ceo/ceo.rpy:3219
translate russian meeting_cassidy_04_male_bcfd7a66:
    "По-моему, просто кучка богатых придурков развлекается на яхтах."

# bg/ceo/ceo.rpy:3220
translate russian meeting_cassidy_04_male_70fa1424:
    mike.say "Никакой регаты. Направим деньги туда, где цифры лучше."

# bg/ceo/ceo.rpy:3221
translate russian meeting_cassidy_04_male_c045676f:
    "Кэссиди смотрит на меня с искренним негодованием."

# bg/ceo/ceo.rpy:3223
translate russian meeting_cassidy_04_male_447ff923:
    cassidy.say "Невероятно!"

# bg/ceo/ceo.rpy:3225
translate russian meeting_cassidy_04_male_2271aa24:
    "А Энтони выглядит почти благодарным."

# bg/ceo/ceo.rpy:3227
translate russian meeting_cassidy_04_male_af0824ef:
    "Энтони" "Спасибо. Распределю средства между тремя каналами со стоимостью тысячи контактов ниже пятнадцати долларов."

# bg/ceo/ceo.rpy:3230
translate russian meeting_cassidy_04_male_867b2b48:
    cassidy.say "Наша компания не будет на регате! Ты понимаешь, как это выглядит?!"

# bg/ceo/ceo.rpy:3232
translate russian meeting_cassidy_04_male_0aa2aed2:
    mike.say "Чертовски дёшево?"

# bg/ceo/ceo.rpy:3234
translate russian meeting_cassidy_04_male_cd1dee88:
    cassidy.say "Так, будто у вас плохой год!"

# bg/ceo/ceo.rpy:3236
translate russian meeting_cassidy_04_male_037ce6e2:
    "Она злится весь остаток дня и присылает мне одиннадцать фотографий яхт."

# bg/ceo/ceo.rpy:3240
translate russian meeting_cassidy_04_male_02ca43c3:
    "Может, я и не понимаю богачей."

# bg/ceo/ceo.rpy:3241
translate russian meeting_cassidy_04_male_95933bfa:
    "Но уверен, что Кэссиди понимает."

# bg/ceo/ceo.rpy:3242
translate russian meeting_cassidy_04_male_0388f85c:
    mike.say "Спонсируем регату."

# bg/ceo/ceo.rpy:3244
translate russian meeting_cassidy_04_male_95bc0efb:
    "От этой новости Кэссиди чуть ли не подпрыгивает."

# bg/ceo/ceo.rpy:3245
translate russian meeting_cassidy_04_male_871f36fa:
    cassidy.say "ДА!"

# bg/ceo/ceo.rpy:3246
translate russian meeting_cassidy_04_male_0d716a3b:
    cassidy.say "Ладно, ладно... Будет так здорово!"

# bg/ceo/ceo.rpy:3249
translate russian meeting_cassidy_04_male_3ac8db31:
    "Энтони" "Отнесу расходы на продвижение бренда, а не на привлечение клиентов."

# bg/ceo/ceo.rpy:3250
translate russian meeting_cassidy_04_male_9bb906bc:
    "Энтони" "Чтобы через полгода мы хотя бы честно оценивали результат."

# bg/ceo/ceo.rpy:3252
translate russian meeting_cassidy_04_male_d6d6d79f:
    mike.say "Так и сделай."

# bg/ceo/ceo.rpy:3254
translate russian meeting_cassidy_04_male_d2dca3c6:
    "Энтони" "Я всегда так делаю. Это единственная доступная мне месть."

# bg/ceo/ceo.rpy:3257
translate russian meeting_cassidy_04_male_74f3252c:
    cassidy.say "Он такой сухарь."

# bg/ceo/ceo.rpy:3258
translate russian meeting_cassidy_04_male_5f3a49bd:
    cassidy.say "Дома он тоже сухарь?"

# bg/ceo/ceo.rpy:3259
translate russian meeting_cassidy_04_male_13ed4b3a:
    cassidy.say "У него вообще есть дом?"

# bg/ceo/ceo.rpy:3262
translate russian meeting_cassidy_04_male_22098056:
    "Энтони уходит без ответа. Подозреваю, это самый дипломатичный ответ."

# bg/ceo/ceo.rpy:3275
translate russian result_meeting_cassidy_04_male_997019cb:
    "Нас нет на регате. И, насколько я могу судить, мир продолжает вращаться."

# bg/ceo/ceo.rpy:3277
translate russian result_meeting_cassidy_04_male_0fb30d76:
    "Энтони" "Четыреста тысяч распределили между тремя каналами."

# bg/ceo/ceo.rpy:3278
translate russian result_meeting_cassidy_04_male_1501ac11:
    "Энтони" "За полугодие число обращений выросло на тридцать один процент. Стоимость обращения — четыре доллара девяносто."

# bg/ceo/ceo.rpy:3279
translate russian result_meeting_cassidy_04_male_78303f16:
    "Энтони" "Это две тысячи триста дополнительных обращений."

# bg/ceo/ceo.rpy:3281
translate russian result_meeting_cassidy_04_male_1fe65102:
    "Энтони" "Регата, судя по прошлогодним данным, дала бы примерно двадцать три."

# bg/ceo/ceo.rpy:3283
translate russian result_meeting_cassidy_04_male_1d63f304:
    "Кэссиди изо всех сил делает вид, что ей совершенно всё равно."

# bg/ceo/ceo.rpy:3285
translate russian result_meeting_cassidy_04_male_630e7c67:
    cassidy.say "Ладно... плевать. Всё равно всю неделю лил дождь, все были несчастны, две яхты утонули."

# bg/ceo/ceo.rpy:3287
translate russian result_meeting_cassidy_04_male_99b84712:
    mike.say "Две яхты утонули?!"

# bg/ceo/ceo.rpy:3289
translate russian result_meeting_cassidy_04_male_ede3b60c:
    cassidy.say "Ну... одна. Но КАК утонула!"

# bg/ceo/ceo.rpy:3292
translate russian result_meeting_cassidy_04_male_67ae65ef:
    "Энтони" "Наше неучастие обошлось в ноль. Ещё ни одна цифра не вызывала у меня такого спокойствия."

# bg/ceo/ceo.rpy:3294
translate russian result_meeting_cassidy_04_male_fd75c034:
    "Кэссиди бросает в него ручку, и он ловит её, даже не поднимая глаз."

# bg/ceo/ceo.rpy:3295
translate russian result_meeting_cassidy_04_male_ac2b1d23:
    "У меня появляются вопросы об Энтони."

# bg/ceo/ceo.rpy:3297
translate russian result_meeting_cassidy_04_male_eb3bf87f:
    "Регата прекрасна. Я шесть часов стою на яхте в туфлях, которые пытаются меня убить."

# bg/ceo/ceo.rpy:3299
translate russian result_meeting_cassidy_04_male_f970696e:
    "Энтони" "Обращений по итогам всей недели — двадцать три."

# bg/ceo/ceo.rpy:3301
translate russian result_meeting_cassidy_04_male_58ac0da1:
    mike.say "Двадцать три?!"

# bg/ceo/ceo.rpy:3303
translate russian result_meeting_cassidy_04_male_c08b107e:
    "Энтони" "Двадцать три. Два из них от наших же сотрудников."

# bg/ceo/ceo.rpy:3304
translate russian result_meeting_cassidy_04_male_18c99d0d:
    "Энтони" "Стоимость одного обращения — двадцать одна тысяча долларов."

# bg/ceo/ceo.rpy:3306
translate russian result_meeting_cassidy_04_male_251b2927:
    "Кэссиди отмахивается, словно слова Энтони — мелочь, не заслуживающая моего внимания."

# bg/ceo/ceo.rpy:3308
translate russian result_meeting_cassidy_04_male_60cb3abe:
    cassidy.say "Зато все нас видели!"

# bg/ceo/ceo.rpy:3311
translate russian result_meeting_cassidy_04_male_11077507:
    "Энтони" "Да, все нас видели. С этим я не спорю."

# bg/ceo/ceo.rpy:3312
translate russian result_meeting_cassidy_04_male_54da1daf:
    "Энтони" "Я СПОРЮ с тем, что эти взгляды стоили четыреста тысяч долларов. И всё решает число двадцать три."

# bg/ceo/ceo.rpy:3315
translate russian result_meeting_cassidy_04_male_09e72103:
    cassidy.say "Зато я очень хорошо провела время."

# bg/ceo/ceo.rpy:3318
translate russian result_meeting_cassidy_04_male_f064d80d:
    "Энтони" "Да... Полагаю, именно это мы на самом деле и приобрели."

# bg/ceo/ceo.rpy:3320
translate russian result_meeting_cassidy_04_male_034ddb0b:
    "На это даже Кэссиди нечего ответить."

# bg/ceo/ceo.rpy:3332
translate russian meeting_cassidy_05_male_acdb9b18:
    "Уильям рассказывает о потенциальном новом деловом партнёре."

# bg/ceo/ceo.rpy:3334
translate russian meeting_cassidy_05_male_659d69a4:
    "Уильям" "Гетин Вейл. Шесть лет в «Корвейн», увеличил их портфель заказов с девяти миллионов до сорока одного. Свободен ещё примерно две недели."

# bg/ceo/ceo.rpy:3335
translate russian meeting_cassidy_05_male_83ed7aa3:
    "Уильям" "Условия серьёзные: триста тысяч оклада, гарантированный бонус за первый год и высокая должность."

# bg/ceo/ceo.rpy:3337
translate russian meeting_cassidy_05_male_3d8c3091:
    "Уильям" "Босс, этот человек — машина!"

# bg/ceo/ceo.rpy:3340
translate russian meeting_cassidy_05_male_6d6ca9be:
    cassidy.say "Гетин Вейл?"

# bg/ceo/ceo.rpy:3343
translate russian meeting_cassidy_05_male_695f9261:
    "Уильям" "Вы его знаете?"

# bg/ceo/ceo.rpy:3346
translate russian meeting_cassidy_05_male_76d0d121:
    cassidy.say "Пару раз ужинала с ним."

# bg/ceo/ceo.rpy:3347
translate russian meeting_cassidy_05_male_c19f8310:
    cassidy.say "Обаятельный, очень красивый и за всю жизнь ни дня не работал."

# bg/ceo/ceo.rpy:3348
translate russian meeting_cassidy_05_male_0705f26e:
    cassidy.say "Он поднял «Корвейн» с девяти до сорока одного миллиона, стоя рядом с женщиной по имени Прити, которая и делала всю работу."

# bg/ceo/ceo.rpy:3349
translate russian meeting_cassidy_05_male_6446860c:
    cassidy.say "Когда она ушла, портфель «Корвейн» снова упал до четырнадцати. Только это никто на слайды не помещает."

# bg/ceo/ceo.rpy:3352
translate russian meeting_cassidy_05_male_a5762d55:
    "Уильям" "При всём уважении, это сплетни."

# bg/ceo/ceo.rpy:3355
translate russian meeting_cassidy_05_male_bbe2364e:
    cassidy.say "Это не сплетни, а ИНФОРМАЦИЯ! Тебе просто не нравится, откуда я её взяла!"

# bg/ceo/ceo.rpy:3357
translate russian meeting_cassidy_05_male_ea6e2471:
    cassidy.say "А ещё он судится с «Корвейн», и они подали встречный иск."

# bg/ceo/ceo.rpy:3358
translate russian meeting_cassidy_05_male_3c216e2d:
    cassidy.say "Он сам рассказал мне об этом за столом при девяти людях. Уже одно это говорит о нём всё, что нужно знать."

# bg/ceo/ceo.rpy:3361
translate russian meeting_cassidy_05_male_daff9f9f:
    "Уильям" "Босс, если его не возьмём мы, возьмут Веррин."

# bg/ceo/ceo.rpy:3363
translate russian meeting_cassidy_05_male_62fdc143:
    "Кэссиди откидывается на спинку кресла и складывает руки, больше ничего не говоря. Почему-то это самое убедительное её высказывание за всё время в этом кабинете."

# bg/ceo/ceo.rpy:3366
translate russian meeting_cassidy_05_male_cde71587:
    "Может, это и сплетни, но Кэссиди незачем врать."

# bg/ceo/ceo.rpy:3367
translate russian meeting_cassidy_05_male_1e838fbb:
    "И она описывает как раз те обстоятельства, в которых люди показывают своё истинное лицо."

# bg/ceo/ceo.rpy:3368
translate russian meeting_cassidy_05_male_a3453037:
    mike.say "Вейла не берём."

# bg/ceo/ceo.rpy:3370
translate russian meeting_cassidy_05_male_81580a77:
    "Уильям явно недоволен тем, что я отвергаю его находку."

# bg/ceo/ceo.rpy:3372
translate russian meeting_cassidy_05_male_e9b93ee7:
    "Уильям" "Босс, прошу..."

# bg/ceo/ceo.rpy:3374
translate russian meeting_cassidy_05_male_e7c2293a:
    mike.say "Лучше найдите мне ту Прити, о которой шла речь, ладно?"

# bg/ceo/ceo.rpy:3376
translate russian meeting_cassidy_05_male_68630219:
    cassidy.say "Ты... ты серьёзно?"

# bg/ceo/ceo.rpy:3378
translate russian meeting_cassidy_05_male_e8953a20:
    cassidy.say "Это хорошо... Очень хорошо! Когда ты стал таким сообразительным?!"

# bg/ceo/ceo.rpy:3381
translate russian meeting_cassidy_05_male_ccb4bdf4:
    "Уильям" "Найду Прити, без проблем. Отличное чутьё, сэр."

# bg/ceo/ceo.rpy:3383
translate russian meeting_cassidy_05_male_f1130ba5:
    "У Уильяма вид человека, мимо которого только что прошла его собственная идея, но в костюме получше."

# bg/ceo/ceo.rpy:3387
translate russian meeting_cassidy_05_male_34d80ac0:
    "Уильям прав. Нельзя полагаться на сплетни Кэссиди."

# bg/ceo/ceo.rpy:3388
translate russian meeting_cassidy_05_male_979a6999:
    "Не когда на кону такой талант."

# bg/ceo/ceo.rpy:3389
translate russian meeting_cassidy_05_male_4ae5e0c7:
    mike.say "Нанимай его, Уильям. Успей раньше Веррин."

# bg/ceo/ceo.rpy:3390
translate russian meeting_cassidy_05_male_a6e5bce2:
    "Уильям кивает, спеша воспользоваться моим согласием."

# bg/ceo/ceo.rpy:3392
translate russian meeting_cassidy_05_male_5b93a6de:
    "Уильям" "Да, босс! Это приобретение года!"

# bg/ceo/ceo.rpy:3395
translate russian meeting_cassidy_05_male_5577ee01:
    "Кэссиди, разумеется, довольна мной куда меньше."

# bg/ceo/ceo.rpy:3397
translate russian meeting_cassidy_05_male_3f02cf7c:
    cassidy.say "Это трудоустройство года. Для НЕГО!"

# bg/ceo/ceo.rpy:3399
translate russian meeting_cassidy_05_male_afdb0c77:
    mike.say "Кэссиди, я не могу отказать директору по выручке с доказанными результатами из-за чьих-то слов за ужином!"

# bg/ceo/ceo.rpy:3401
translate russian meeting_cassidy_05_male_7887fdfd:
    cassidy.say "Люди говорят правду в ресторанах, а не в переговорных!"

# bg/ceo/ceo.rpy:3403
translate russian meeting_cassidy_05_male_8369a345:
    cassidy.say "Ладно... деньги твои. Теперь они буквально твои. Как же это странно!"

# bg/ceo/ceo.rpy:3405
translate russian meeting_cassidy_05_male_7a0e298f:
    "Кэссиди уходит, прежде чем я успеваю ей что-либо сказать."

# bg/ceo/ceo.rpy:3407
translate russian meeting_cassidy_05_male_3e624c5d:
    "А Уильям даёт пять пустоте. Смотреть на это по-настоящему больно."

# bg/ceo/ceo.rpy:3420
translate russian result_meeting_cassidy_05_male_bbcb06a4:
    "Веррин нанимают Гетина Вейла. В газете выходит фотография."

# bg/ceo/ceo.rpy:3421
translate russian result_meeting_cassidy_05_male_3e364c6b:
    "Чёрт, какие у него отличные зубы."

# bg/ceo/ceo.rpy:3423
translate russian result_meeting_cassidy_05_male_0d7931c5:
    "Уильям" "Босс, признаюсь, смотреть, как они объявляют о его найме, было физически больно!"

# bg/ceo/ceo.rpy:3425
translate russian result_meeting_cassidy_05_male_1bf61191:
    "Кэссиди качает головой."

# bg/ceo/ceo.rpy:3427
translate russian result_meeting_cassidy_05_male_a361ea6a:
    cassidy.say "Подожди четыре месяца."

# bg/ceo/ceo.rpy:3429
translate russian result_meeting_cassidy_05_male_d7414a6f:
    "Хватает шести дней."

# bg/ceo/ceo.rpy:3431
translate russian result_meeting_cassidy_05_male_ad10682d:
    "Энтони" "Веррин как работодателю Вейла вручили документы по иску «Корвейн» против него."

# bg/ceo/ceo.rpy:3432
translate russian result_meeting_cassidy_05_male_ac13250a:
    "Энтони" "Речь о клиентских данных. Мне сказали, дело весьма неприятное."

# bg/ceo/ceo.rpy:3435
translate russian result_meeting_cassidy_05_male_dbd98edc:
    "Уильям" "Так, я нашёл Прити. Она работает в консалтинговой фирме, которую ненавидит, и готова приступить через шесть недель."

# bg/ceo/ceo.rpy:3437
translate russian result_meeting_cassidy_05_male_6f010366:
    "Уильям" "И обойдётся втрое дешевле него."

# bg/ceo/ceo.rpy:3441
translate russian result_meeting_cassidy_05_male_6ab03d52:
    cassidy.say "СКАЖИ!"

# bg/ceo/ceo.rpy:3444
translate russian result_meeting_cassidy_05_male_16ac1224:
    "Уильям" "Вы были правы, мэм."

# bg/ceo/ceo.rpy:3447
translate russian result_meeting_cassidy_05_male_544a6a01:
    cassidy.say "Громче! И по имени!"

# bg/ceo/ceo.rpy:3449
translate russian result_meeting_cassidy_05_male_e9fd5c1b:
    "Она заставляет его повторить дважды. Я не мешаю: она это вполне заслужила."

# bg/ceo/ceo.rpy:3451
translate russian result_meeting_cassidy_05_male_f786743c:
    "Гетин Вейл начинает у нас работать и примерно неделю остаётся обаятельным."

# bg/ceo/ceo.rpy:3453
translate russian result_meeting_cassidy_05_male_42a998a3:
    "Энтони" "На второй неделе он без согласования изменил систему комиссионных."

# bg/ceo/ceo.rpy:3454
translate russian result_meeting_cassidy_05_male_fe1e2702:
    "Энтони" "На третьей из-за него ушли два менеджера по работе с клиентами, проработавшие здесь четырнадцать лет."

# bg/ceo/ceo.rpy:3459
translate russian result_meeting_cassidy_05_male_e958750c:
    "Артур" "На четвёртой «Корвейн» подали иск, в котором упомянули нашу компанию, поскольку он принёс с собой их клиентские данные."

# bg/ceo/ceo.rpy:3460
translate russian result_meeting_cassidy_05_male_7cba8e99:
    "Артур" "Он действительно их принёс. На собеседование. Я видел слайды!"

# bg/ceo/ceo.rpy:3462
translate russian result_meeting_cassidy_05_male_1c3b0d0a:
    mike.say "Он показал нам украденные данные на собеседовании, и мы его наняли?!"

# bg/ceo/ceo.rpy:3464
translate russian result_meeting_cassidy_05_male_18fcf139:
    "Артур" "Верное изложение. Я бы предпочёл, чтобы его нигде не записали."

# bg/ceo/ceo.rpy:3467
translate russian result_meeting_cassidy_05_male_39e511fd:
    "Кэссиди устало вздыхает."

# bg/ceo/ceo.rpy:3469
translate russian result_meeting_cassidy_05_male_f51ff9ca:
    cassidy.say "Я ведь предупреждала. Разве нет?"

# bg/ceo/ceo.rpy:3472
translate russian result_meeting_cassidy_05_male_517194a0:
    "Уильям" "Босс, я беру всю ответственность на себя."

# bg/ceo/ceo.rpy:3474
translate russian result_meeting_cassidy_05_male_e85253e8:
    mike.say "Нет, Уильям. Это моя ошибка."

# bg/ceo/ceo.rpy:3475
translate russian result_meeting_cassidy_05_male_f84216a5:
    "На то, чтобы от него избавиться, уходит четыре месяца и больше денег, чем на его найм."

# bg/ceo/ceo.rpy:3487
translate russian meeting_cassidy_06_male_b6668058:
    "Уильям, похоже, уверен, что придумал беспроигрышную идею."

# bg/ceo/ceo.rpy:3489
translate russian meeting_cassidy_06_male_cc808232:
    "Уильям" "Нам нужна дешёвая версия нашей продукции. Вдвое дешевле, под другим названием и там, куда наши нынешние покупатели не заглядывают."

# bg/ceo/ceo.rpy:3490
translate russian meeting_cassidy_06_male_22fed4c2:
    "Уильям" "Потому что кто-то всё равно это сделает, босс. Если не мы, то Келлис через полтора года."

# bg/ceo/ceo.rpy:3492
translate russian meeting_cassidy_06_male_19ad4ea7:
    "Уильям" "Тогда на товаре будет их имя, а наша прибыль окажется у них в кармане."

# bg/ceo/ceo.rpy:3494
translate russian meeting_cassidy_06_male_f798f0c0:
    "К моему удивлению, Кэссиди вспыхивает."

# bg/ceo/ceo.rpy:3496
translate russian meeting_cassidy_06_male_9f7b3b30:
    cassidy.say "Категорически нет!"

# bg/ceo/ceo.rpy:3497
translate russian meeting_cassidy_06_male_0656eb19:
    cassidy.say "Ты знаешь, что произойдёт в ту же секунду, когда появится дешёвая версия?"

# bg/ceo/ceo.rpy:3498
translate russian meeting_cassidy_06_male_5a226b50:
    cassidy.say "Каждый, кто заплатил полную цену, поймёт, за что на самом деле отдал деньги."

# bg/ceo/ceo.rpy:3499
translate russian meeting_cassidy_06_male_82f69eab:
    cassidy.say "Нельзя быть и дорогими, и дешёвыми. Что-то одно. И вернуться в дорогой сегмент уже никогда не получится!"

# bg/ceo/ceo.rpy:3502
translate russian meeting_cassidy_06_male_336f6016:
    "Уильям" "Другое название, другая упаковка, другая полка. Никто их не свяжет."

# bg/ceo/ceo.rpy:3505
translate russian meeting_cassidy_06_male_a69de1ea:
    cassidy.say "Свяжут все! Люди именно этим и занимаются!"

# bg/ceo/ceo.rpy:3506
translate russian meeting_cassidy_06_male_518bd48c:
    cassidy.say "Достаточно одного человека в интернете, и в мгновение ока мы станем посмешищем!"

# bg/ceo/ceo.rpy:3509
translate russian meeting_cassidy_06_male_5f31198d:
    "Уильям" "Тогда сами расскажем эту историю, прежде чем нас на ней поймают."

# bg/ceo/ceo.rpy:3510
translate russian meeting_cassidy_06_male_c73a3a88:
    "Уильям" "Той, кому сейчас наша продукция не по карману, двадцать четыре. Через десять лет она сможет её себе позволить..."

# bg/ceo/ceo.rpy:3512
translate russian meeting_cassidy_06_male_175deb5b:
    "Уильям" "Но к тому моменту десять лет будет покупать у других."

# bg/ceo/ceo.rpy:3515
translate russian meeting_cassidy_06_male_eb66bd4f:
    cassidy.say "Ну... я... наверное... может быть?"

# bg/ceo/ceo.rpy:3517
translate russian meeting_cassidy_06_male_b57ad698:
    "Замечаю, что Уильям впервые сказал нечто, заставившее Кэссиди остановиться и действительно задуматься."

# bg/ceo/ceo.rpy:3520
translate russian meeting_cassidy_06_male_1087a5d9:
    "Уж кто-кто, а Кэссиди понимает в роскоши и престиже."

# bg/ceo/ceo.rpy:3521
translate russian meeting_cassidy_06_male_c3c8e963:
    mike.say "Никакой дешёвой линейки. Остаёмся собой."

# bg/ceo/ceo.rpy:3523
translate russian meeting_cassidy_06_male_dc800660:
    "Кэссиди кивает с улыбкой."

# bg/ceo/ceo.rpy:3524
translate russian meeting_cassidy_06_male_a4f5e1e2:
    cassidy.say "Правильно... Спасибо... Наконец-то!"

# bg/ceo/ceo.rpy:3526
translate russian meeting_cassidy_06_male_490f9e66:
    "Уильям, похоже, довольно быстро сдаёт позиции."

# bg/ceo/ceo.rpy:3528
translate russian meeting_cassidy_06_male_c2b46163:
    "Уильям" "Понял, босс. Бережём фамильные драгоценности... Очень разумно."

# bg/ceo/ceo.rpy:3530
translate russian meeting_cassidy_06_male_21f88a93:
    mike.say "Ты всё ещё считаешь себя правым, Уильям?"

# bg/ceo/ceo.rpy:3532
translate russian meeting_cassidy_06_male_e39dd7aa:
    "Уильям" "Убеждён в этом, сэр. Но лучше ошибиться вместе с вами, чем быть правым в одиночку, так что..."

# bg/ceo/ceo.rpy:3535
translate russian meeting_cassidy_06_male_966a92fa:
    cassidy.say "Ничего более жуткого от мужчины в офисе я ещё не слышала."

# bg/ceo/ceo.rpy:3538
translate russian meeting_cassidy_06_male_858258f1:
    "Как ни странно, Уильям, похоже, принимает это за комплимент."

# bg/ceo/ceo.rpy:3542
translate russian meeting_cassidy_06_male_e6356f1c:
    "Никто и не говорил, что Кэссиди — гуру маркетинга."

# bg/ceo/ceo.rpy:3543
translate russian meeting_cassidy_06_male_261d15b7:
    mike.say "Запускаем. Другое название, другая полка. Уильям отвечает за всё от начала до конца."

# bg/ceo/ceo.rpy:3544
translate russian meeting_cassidy_06_male_1c490236:
    "Уильям кивает, спеша воспользоваться моим согласием."

# bg/ceo/ceo.rpy:3546
translate russian meeting_cassidy_06_male_def768b4:
    "Уильям" "Босс, я вас не подведу."

# bg/ceo/ceo.rpy:3549
translate russian meeting_cassidy_06_male_2bf4271f:
    "А вот Кэссиди моё решение не радует."

# bg/ceo/ceo.rpy:3551
translate russian meeting_cassidy_06_male_8a1202b4:
    cassidy.say "Ты собираешься обесценить имя, которое моя семья создавала сорок лет!"

# bg/ceo/ceo.rpy:3553
translate russian meeting_cassidy_06_male_1e10ed19:
    mike.say "Твоя семья сорок лет создавала его для людей, которым теперь всем за пятьдесят!"

# bg/ceo/ceo.rpy:3555
translate russian meeting_cassidy_06_male_9f77abee:
    cassidy.say "Это..."

# bg/ceo/ceo.rpy:3557
translate russian meeting_cassidy_06_male_96e3623a:
    cassidy.say "Это было зло!"

# bg/ceo/ceo.rpy:3559
translate russian meeting_cassidy_06_male_c8667252:
    mike.say "Прости, Кэссиди."

# bg/ceo/ceo.rpy:3561
translate russian meeting_cassidy_06_male_d88578a9:
    cassidy.say "Нет. Хорошо зло."

# bg/ceo/ceo.rpy:3562
translate russian meeting_cassidy_06_male_8403a981:
    cassidy.say "Делай так почаще, а ту другую свою штуку — пореже."

# bg/ceo/ceo.rpy:3564
translate russian meeting_cassidy_06_male_b1e2f974:
    "Понятия не имею, что это за другая моя штука, и слишком боюсь спросить."

# bg/ceo/ceo.rpy:3578
translate russian result_meeting_cassidy_06_male_f57a2ddc:
    "Мы запускаем товар под названием, которое никто не может связать с нами, на полках, перед которыми я лично никогда не стоял."

# bg/ceo/ceo.rpy:3580
translate russian result_meeting_cassidy_06_male_b4783427:
    "Энтони" "Объём на сорок один процент выше прогноза. Переток покупателей из премиальной линейки... измеримый, но меньше расчётного."

# bg/ceo/ceo.rpy:3581
translate russian result_meeting_cassidy_06_male_0987c26b:
    "Энтони" "Две целых одна десятая процента, если точно."

# bg/ceo/ceo.rpy:3583
translate russian result_meeting_cassidy_06_male_56a4c9d1:
    "Кэссиди закатывает глаза."

# bg/ceo/ceo.rpy:3585
translate russian result_meeting_cassidy_06_male_2bc8e137:
    cassidy.say "Два процента... ладно... ЛАДНО, Уильям!"

# bg/ceo/ceo.rpy:3588
translate russian result_meeting_cassidy_06_male_90840c7f:
    "Уильям" "Я ничего не сказал, мэм."

# bg/ceo/ceo.rpy:3591
translate russian result_meeting_cassidy_06_male_06b38e80:
    cassidy.say "Но собирался! Я чувствовала!"

# bg/ceo/ceo.rpy:3594
translate russian result_meeting_cassidy_06_male_e25139a2:
    "Энтони" "Келлис отложили собственный выход."

# bg/ceo/ceo.rpy:3595
translate russian result_meeting_cassidy_06_male_9dfd7171:
    "Энтони" "Теперь их продукт будет вторым в категории, которую создали мы. Мне говорят, с такой позиции непросто стать первым."

# bg/ceo/ceo.rpy:3598
translate russian result_meeting_cassidy_06_male_a5a28626:
    "Уильям" "Босс! Та двадцатичетырёхлетняя девушка купила его. Сорок тысяч таких девушек!"

# bg/ceo/ceo.rpy:3599
translate russian result_meeting_cassidy_06_male_9b40b1b8:
    "Я ещё никогда не видел его таким гордым. И на этот раз дело не только во мне."

# bg/ceo/ceo.rpy:3601
translate russian result_meeting_cassidy_06_male_4fc4b0d5:
    "Мы ничего не запускаем. А Келлис запускают. Им хватает примерно четырёх дней."

# bg/ceo/ceo.rpy:3603
translate russian result_meeting_cassidy_06_male_37dd482b:
    "Энтони" "Их базовый продукт стоит пятьдесят два процента от нашей цены."

# bg/ceo/ceo.rpy:3604
translate russian result_meeting_cassidy_06_male_16c12d4f:
    "Энтони" "Наши продажи в сегменте до тридцати лет за неделю упали на тридцать один процент."

# bg/ceo/ceo.rpy:3605
translate russian result_meeting_cassidy_06_male_64f3b80a:
    "Энтони" "В сегменте старше сорока пяти падения нет. Мы ровно настолько же премиальные, как раньше. И ровно настолько же узконаправленные."

# bg/ceo/ceo.rpy:3608
translate russian result_meeting_cassidy_06_male_56a4c9d1_1:
    "Кэссиди закатывает глаза."

# bg/ceo/ceo.rpy:3610
translate russian result_meeting_cassidy_06_male_9d52677b:
    cassidy.say "То есть насчёт бренда я была права, а во всём остальном ошиблась?!"

# bg/ceo/ceo.rpy:3613
translate russian result_meeting_cassidy_06_male_50d8b869:
    "Уильям" "Мэм, по сути, это и есть стратегия."

# bg/ceo/ceo.rpy:3616
translate russian result_meeting_cassidy_06_male_9538edfa:
    cassidy.say "Не пытайся меня утешать. Это отвратительно!"

# bg/ceo/ceo.rpy:3618
translate russian result_meeting_cassidy_06_male_baa7b491:
    mike.say "Мы ещё можем это сделать?"

# bg/ceo/ceo.rpy:3620
translate russian result_meeting_cassidy_06_male_d067be2e:
    "Энтони" "Можем стать вторыми. С большими затратами. На рынке, который уже запомнил чужое имя."

# bg/ceo/ceo.rpy:3622
translate russian result_meeting_cassidy_06_male_961627cb:
    "Никто не произносит очевидного: мы просто упустили свой шанс."

# bg/ceo/ceo.rpy:3634
translate russian meeting_board_01_male_0d83fd54:
    "Энтони выглядит так, будто лопнет, если немедленно не выскажется."

# bg/ceo/ceo.rpy:3636
translate russian meeting_board_01_male_153c8cb5:
    "Энтони" "У меня есть схема, которая сэкономит нам четыреста шестьдесят тысяч в год на налогах."

# bg/ceo/ceo.rpy:3637
translate russian meeting_board_01_male_22aaf2ae:
    "Энтони" "Законно. Хочу особо подчеркнуть слово «законно»."

# bg/ceo/ceo.rpy:3638
translate russian meeting_board_01_male_1166e63a:
    "Энтони" "Трое наших конкурентов ею пользуются. Две из четырёх крупнейших фирм страны её рекомендуют. Никакой экзотики и ничего тайного."

# bg/ceo/ceo.rpy:3640
translate russian meeting_board_01_male_333685ec:
    "Артур, похоже, был ко всему этому готов."

# bg/ceo/ceo.rpy:3642
translate russian meeting_board_01_male_efc190c5:
    "Артур" "Это законно в том же смысле, в каком законно стоять на карнизе, мистер Безас!"

# bg/ceo/ceo.rpy:3645
translate russian meeting_board_01_male_a3f12e20:
    "Энтони" "Это не аргумент, а просто преувеличение!"

# bg/ceo/ceo.rpy:3648
translate russian meeting_board_01_male_429a617c:
    "Артур" "Одиннадцать недель назад налоговая выпустила разъяснение. Эта схема там не упоминается."

# bg/ceo/ceo.rpy:3649
translate russian meeting_board_01_male_f53ef777:
    "Артур" "Зато упоминается принцип, на котором она основана. И дважды употребляется слово «искусственный»."

# bg/ceo/ceo.rpy:3650
translate russian meeting_board_01_male_6f81f811:
    "Артур" "Когда они дважды используют это слово, то описывают не прошлое, а предупреждают о будущем."

# bg/ceo/ceo.rpy:3653
translate russian meeting_board_01_male_a58906b5:
    "Энтони" "Разъяснение — не закон!"

# bg/ceo/ceo.rpy:3656
translate russian meeting_board_01_male_1393effe:
    "Артур" "Нет. Это предупредительный выстрел. Я сделал долгую карьеру на умении такие выстрелы слышать."

# bg/ceo/ceo.rpy:3659
translate russian meeting_board_01_male_3641658f:
    "Энтони" "Четыреста шестьдесят тысяч в год. Каждый год."

# bg/ceo/ceo.rpy:3660
translate russian meeting_board_01_male_20adc29e:
    "Энтони" "Это обновление производства. Или одиннадцать рабочих мест. Или очень много спокойствия."

# bg/ceo/ceo.rpy:3663
translate russian meeting_board_01_male_2be55bbd:
    "Артур" "А доначисление задним числом — это возврат за шесть лет с процентами. И отдельный абзац во всей отчётности, которую мы впредь подадим."

# bg/ceo/ceo.rpy:3665
translate russian meeting_board_01_male_edcc6101:
    "Два человека, которые никогда ни в чём не соглашались, сейчас оба говорят совершенно разумные вещи. И мне нужно выбрать одного."

# bg/ceo/ceo.rpy:3668
translate russian meeting_board_01_male_9bb22560:
    "Я смотрю на Энтони и качаю головой."

# bg/ceo/ceo.rpy:3669
translate russian meeting_board_01_male_8053b566:
    mike.say "Не будем, Энтони. Найди деньги каким-нибудь скучным способом."

# bg/ceo/ceo.rpy:3671
translate russian meeting_board_01_male_dc98aea6:
    "Энтони" "На самом деле все деньги находят скучными способами."

# bg/ceo/ceo.rpy:3672
translate russian meeting_board_01_male_a5412709:
    "Энтони" "Просто решил хоть раз предложить вам увлекательный вариант."

# bg/ceo/ceo.rpy:3675
translate russian meeting_board_01_male_42828aab:
    "Артур" "Спасибо, мистер [hero.family_name]..."

# bg/ceo/ceo.rpy:3677
translate russian meeting_board_01_male_538b8172:
    mike.say "Не благодари."

# bg/ceo/ceo.rpy:3678
translate russian meeting_board_01_male_02c32229:
    mike.say "Четыреста шестьдесят тысяч — немало, чтобы отказываться от них из-за какого-то разъяснения."

# bg/ceo/ceo.rpy:3680
translate russian meeting_board_01_male_8af7427a:
    "Артур" "Немало. И немалой суммой они останутся. Никто никогда не поблагодарит вас за отказ. И всё же решение будет правильным."

# bg/ceo/ceo.rpy:3683
translate russian meeting_board_01_male_6041501f:
    "Энтони" "Это почти мудрость. Мне не нравится!"

# bg/ceo/ceo.rpy:3687
translate russian meeting_board_01_male_17c095a0:
    "Они уходят одновременно. Ни один не придерживает дверь."

# bg/ceo/ceo.rpy:3690
translate russian meeting_board_01_male_7ae1a46b:
    "Я смотрю на Артура и качаю головой."

# bg/ceo/ceo.rpy:3692
translate russian meeting_board_01_male_6fd5d136:
    mike.say "Экономим, Энтони."

# bg/ceo/ceo.rpy:3694
translate russian meeting_board_01_male_f5ae0bbc:
    "Энтони кивает, спеша воспользоваться моей поддержкой."

# bg/ceo/ceo.rpy:3695
translate russian meeting_board_01_male_f81ebb4d:
    "Энтони" "Всё будет готово к концу квартала."

# bg/ceo/ceo.rpy:3697
translate russian meeting_board_01_male_0737b9f6:
    "Артур одаривает меня одним из своих самых серьёзных взглядов."

# bg/ceo/ceo.rpy:3699
translate russian meeting_board_01_male_b3f78f5d:
    "Артур" "Требую приобщить мою рекомендацию к делу."

# bg/ceo/ceo.rpy:3702
translate russian meeting_board_01_male_8e6d2b78:
    "Энтони" "Вы всегда требуете приобщить свою рекомендацию к делу."

# bg/ceo/ceo.rpy:3705
translate russian meeting_board_01_male_122bfb8f:
    "Артур" "Однажды это дело прочтёт человек в очень плохом настроении. И в тот день вы будете чрезвычайно рады, что я такой."

# bg/ceo/ceo.rpy:3707
translate russian meeting_board_01_male_35d4e7b2:
    "Энтони не отвечает. Для него это почти признание чужой правоты."

# bg/ceo/ceo.rpy:3708
translate russian meeting_board_01_male_0e1341d9:
    "Но схему он всё равно внедряет при первой возможности."

# bg/ceo/ceo.rpy:3720
translate russian result_meeting_board_01_male_6ef195c9:
    "Артур лично приносит документ налоговой и молча кладёт на стол."

# bg/ceo/ceo.rpy:3722
translate russian result_meeting_board_01_male_a3c6b88e:
    "Артур" "Задним числом, начиная с даты разъяснения. Трое наших конкурентов увязли по шею."

# bg/ceo/ceo.rpy:3725
translate russian result_meeting_board_01_male_1c792159:
    "Энтони" "У «Корвейн» под угрозой миллион девятьсот тысяч."

# bg/ceo/ceo.rpy:3726
translate russian result_meeting_board_01_male_130071b3:
    "Энтони" "У Келлис несколько хуже. Они объявили об исключительной статье расходов, что иначе называется дырой в бюджете."

# bg/ceo/ceo.rpy:3728
translate russian result_meeting_board_01_male_e69254c1:
    mike.say "А у нас?"

# bg/ceo/ceo.rpy:3730
translate russian result_meeting_board_01_male_11a38980:
    "Энтони" "Ровным счётом ничего. В этом месяце мы самая неинтересная компания отрасли. Ещё ничто меня так не радовало."

# bg/ceo/ceo.rpy:3732
translate russian result_meeting_board_01_male_38c644c5:
    "Следующим берёт слово Артур."

# bg/ceo/ceo.rpy:3734
translate russian result_meeting_board_01_male_5bdb61a7:
    "Артур" "Хочу кое-что сказать."

# bg/ceo/ceo.rpy:3737
translate russian result_meeting_board_01_male_0ac9ba56:
    "Энтони" "Что вы нас предупреждали?"

# bg/ceo/ceo.rpy:3740
translate russian result_meeting_board_01_male_e6102573:
    "Артур" "Да. Но хочу, чтобы мы все прочувствовали и насладились этим моментом."

# bg/ceo/ceo.rpy:3742
translate russian result_meeting_board_01_male_67cb7892:
    "Я позволяю Артуру насладиться моментом."

# bg/ceo/ceo.rpy:3743
translate russian result_meeting_board_01_male_e0a77722:
    "Это занимает около полутора минут. Он смакует каждую секунду."

# bg/ceo/ceo.rpy:3746
translate russian result_meeting_board_01_male_da4ecc2a:
    "Схема держится шесть дней. Шесть очень хороших дней."

# bg/ceo/ceo.rpy:3748
translate russian result_meeting_board_01_male_b393d9d6:
    "Артур" "Налоговая опубликовала решение."

# bg/ceo/ceo.rpy:3749
translate russian result_meeting_board_01_male_f6acd6f1:
    "Артур" "Принцип больше не признаётся. Причём начиная с даты выхода разъяснения."

# bg/ceo/ceo.rpy:3751
translate russian result_meeting_board_01_male_5dfd67c1:
    mike.say "Того, что вышло за одиннадцать недель до того, как мы это сделали?"

# bg/ceo/ceo.rpy:3753
translate russian result_meeting_board_01_male_3cb18caf:
    "Артур" "За одиннадцать недель, да."

# bg/ceo/ceo.rpy:3756
translate russian result_meeting_board_01_male_77204e11:
    "В этот момент в разговор вступает Энтони."

# bg/ceo/ceo.rpy:3758
translate russian result_meeting_board_01_male_c0837d9f:
    "Энтони" "Доначисление составит четыреста шестьдесят тысяч. Плюс проценты, плюс штраф..."

# bg/ceo/ceo.rpy:3759
translate russian result_meeting_board_01_male_e5fd1fc8:
    "Энтони" "Размер которого оставлен на усмотрение инспекции. Щедрости я бы не ожидал."

# bg/ceo/ceo.rpy:3760
translate russian result_meeting_board_01_male_e97d6d0b:
    "Энтони" "Я был прав: это было законно. Но ошибся в единственном важном: законным оно оставалось лишь до тех пор, пока не перестало."

# bg/ceo/ceo.rpy:3763
translate russian result_meeting_board_01_male_64f3d163:
    "Артур" "Мне это не доставляет удовлетворения."

# bg/ceo/ceo.rpy:3766
translate russian result_meeting_board_01_male_57512e50:
    "Энтони" "Немного доставляет. Признайте!"

# bg/ceo/ceo.rpy:3769
translate russian result_meeting_board_01_male_a0cc63bc:
    "Артур" "Совсем немного... возможно."

# bg/ceo/ceo.rpy:3771
translate russian result_meeting_board_01_male_10d3d678:
    "В итоге это обходится нам в год терпения Энтони и примерно одиннадцать месяцев невыносимого Артура."

# bg/ceo/ceo.rpy:3783
translate russian meeting_board_02_male_f614225e:
    "На совещании Энтони и Артур опять сцепились."

# bg/ceo/ceo.rpy:3785
translate russian meeting_board_02_male_b01e3a0d:
    "Энтони" "Договор на обслуживание с «Феррис» автоматически продлевается с повышением тарифа на тридцать один процент."

# bg/ceo/ceo.rpy:3786
translate russian meeting_board_02_male_686ee538:
    "Энтони" "Чтобы остановить продление, нужно подать письменное уведомление в установленный срок."

# bg/ceo/ceo.rpy:3787
translate russian meeting_board_02_male_50681df4:
    "Энтони" "Срок истекает через три дня."

# bg/ceo/ceo.rpy:3790
translate russian meeting_board_02_male_126416be:
    "Артур" "И вы пришли ко мне, когда осталось три дня?"

# bg/ceo/ceo.rpy:3793
translate russian meeting_board_02_male_923151e7:
    "Энтони" "Я узнал вчера и сообщил вам сегодня. Быстрее я ещё ничего в жизни не делал."

# bg/ceo/ceo.rpy:3796
translate russian meeting_board_02_male_1bd88d2e:
    "Артур" "Я не расторгаю договоры, которых не читал."

# bg/ceo/ceo.rpy:3797
translate russian meeting_board_02_male_ec00cb08:
    "Артур" "В соглашении есть связанные обязательства: запчасти, оснастка, взаимные обязанности на переходный период."

# bg/ceo/ceo.rpy:3798
translate russian meeting_board_02_male_3de46453:
    "Артур" "Мне нужно шесть недель. Я не набиваю себе цену. Такова процедура."

# bg/ceo/ceo.rpy:3801
translate russian meeting_board_02_male_4921843f:
    "Энтони" "Через шесть недель повышение уже вступит в силу, и мы будем платить на двести сорок тысяч в год больше по договору, из которого хотим выйти."

# bg/ceo/ceo.rpy:3802
translate russian meeting_board_02_male_5c183d0e:
    "Энтони" "В уведомлении одна страница: мы отказываемся от продления. В нём невозможно ошибиться, потому что оно ничего не утверждает."

# bg/ceo/ceo.rpy:3805
translate russian meeting_board_02_male_88cac7a7:
    "Артур" "Всё что-нибудь утверждает. В этом и заключается вся проблема со всем."

# bg/ceo/ceo.rpy:3808
translate russian meeting_board_02_male_760ee7df:
    "Энтони" "Сроку плевать на вашу тщательность. Срок — три дня."

# bg/ceo/ceo.rpy:3811
translate russian meeting_board_02_male_0c689a3b:
    "Артур смотрит на календарь так, будто тот лично его оскорбил."

# bg/ceo/ceo.rpy:3814
translate russian meeting_board_02_male_d4a8b4a5:
    "По-моему, действовать нужно сейчас."

# bg/ceo/ceo.rpy:3815
translate russian meeting_board_02_male_f5cf7150:
    mike.say "Отправляй уведомление, Артур. Договор прочтёшь потом и расскажешь, что я натворил."

# bg/ceo/ceo.rpy:3816
translate russian meeting_board_02_male_f957ab43:
    "Указание почти оскорбляет Артура."

# bg/ceo/ceo.rpy:3818
translate russian meeting_board_02_male_550de7b5:
    "Артур" "Это прямо противоположно правильному порядку действий."

# bg/ceo/ceo.rpy:3820
translate russian meeting_board_02_male_73e93065:
    mike.say "Да. И всё равно делай."

# bg/ceo/ceo.rpy:3822
translate russian meeting_board_02_male_f52b7f61:
    "Артур" "Прочту, как только доберусь домой."

# bg/ceo/ceo.rpy:3823
translate russian meeting_board_02_male_046280ef:
    "Артур" "Если там обнаружится неприятный сюрприз, позвоню вам в самое неподходящее время и извиняться не стану."

# bg/ceo/ceo.rpy:3826
translate russian meeting_board_02_male_f2253a2e:
    "Энтони" "Уведомление отправлено. Подтверждение пришло через восемь минут."

# bg/ceo/ceo.rpy:3829
translate russian meeting_board_02_male_9c8d839a:
    "Артур" "Значит, они его ждали."

# bg/ceo/ceo.rpy:3831
translate russian meeting_board_02_male_21a3a8ef:
    "Видимо, это плохой знак... или хороший."

# bg/ceo/ceo.rpy:3832
translate russian meeting_board_02_male_d6d8556c:
    "Ни один не говорит, какой именно."

# bg/ceo/ceo.rpy:3835
translate russian meeting_board_02_male_6ac012c9:
    "По-моему, нужно потратить время и во всём разобраться."

# bg/ceo/ceo.rpy:3836
translate russian meeting_board_02_male_0cc5712e:
    mike.say "Бери шесть недель и внимательно изучи договор."

# bg/ceo/ceo.rpy:3837
translate russian meeting_board_02_male_6c9dba8d:
    "Артур кивает, довольный тем, что я встал на его сторону."

# bg/ceo/ceo.rpy:3839
translate russian meeting_board_02_male_9134416c:
    "Артур" "Первое разумное указание, которое я получил за этот месяц."

# bg/ceo/ceo.rpy:3842
translate russian meeting_board_02_male_c1eeeca9:
    "Энтони" "Это обойдётся в двести сорок тысяч ежегодно."

# bg/ceo/ceo.rpy:3844
translate russian meeting_board_02_male_c6f4e3b0:
    mike.say "А расторжение непрочитанного договора может обойтись куда дороже."

# bg/ceo/ceo.rpy:3846
translate russian meeting_board_02_male_2bc59626:
    "Энтони" "Я занимаюсь не возможным, а вероятным."

# bg/ceo/ceo.rpy:3847
translate russian meeting_board_02_male_a56009fa:
    "Энтони" "Но подпись ваша, кресло ваше. Я своё сказал."

# bg/ceo/ceo.rpy:3849
translate russian meeting_board_02_male_10903cdc:
    "Он убирает ручку. Для него это почти как хлопнуть дверью."

# bg/ceo/ceo.rpy:3858
translate russian result_meeting_board_02_male_92fa716d:
    "Артур звонит в неприличное время. Я с ужасом жду, что он скажет."

# bg/ceo/ceo.rpy:3859
translate russian result_meeting_board_02_male_3b0d1729:
    "Артур" "Там есть обязательства на переходный период!"

# bg/ceo/ceo.rpy:3860
translate russian result_meeting_board_02_male_2138eb12:
    "Артур" "Они обязаны обслуживать нас шесть месяцев после расторжения по старой цене..."

# bg/ceo/ceo.rpy:3861
translate russian result_meeting_board_02_male_2b8da5bf:
    "Артур" "Причём условия в нашу пользу, потому что в 2011 году кто-то был внимателен."

# bg/ceo/ceo.rpy:3862
translate russian result_meeting_board_02_male_cd31af85:
    "Артур" "Уведомив их вовремя, мы получили шесть месяцев обслуживания по прошлогодней цене, пока проводим тендер."

# bg/ceo/ceo.rpy:3863
translate russian result_meeting_board_02_male_6d129e9e:
    "Энтони" "Избежали двухсот сорока тысяч расходов и получили обслуживание на переходный период стоимостью сто восемьдесят тысяч, которого я не учитывал."

# bg/ceo/ceo.rpy:3864
translate russian result_meeting_board_02_male_d91d2797:
    mike.say "То есть всё хорошо?"

# bg/ceo/ceo.rpy:3865
translate russian result_meeting_board_02_male_4f7b035b:
    "Артур" "Так же хорошо, как перейти дорогу с закрытыми глазами, если удалось добраться до другой стороны."

# bg/ceo/ceo.rpy:3866
translate russian result_meeting_board_02_male_f75a3413:
    "Энтони" "Приму это за комплимент!"

# bg/ceo/ceo.rpy:3867
translate russian result_meeting_board_02_male_4824f882:
    "Я едва не подпрыгиваю: не знал, что Энтони тоже участвует в звонке!"

# bg/ceo/ceo.rpy:3868
translate russian result_meeting_board_02_male_990bb6fc:
    "Артур" "Это не был комплимент."

# bg/ceo/ceo.rpy:3869
translate russian result_meeting_board_02_male_74529a7c:
    "По итогам тендера цена оказывается на семнадцать процентов ниже, чем у «Феррис». О звонке больше никто не вспоминает."

# bg/ceo/ceo.rpy:3871
translate russian result_meeting_board_02_male_5f3087b8:
    "Пока мы все проявляем крайнюю осторожность, срок истекает и договор продлевается сам собой."

# bg/ceo/ceo.rpy:3876
translate russian result_meeting_board_02_male_42be3301:
    "Энтони" "Повышение на тридцать один процент вступило в силу немедленно."

# bg/ceo/ceo.rpy:3877
translate russian result_meeting_board_02_male_75f5ceac:
    "Энтони" "Двести сорок тысяч в год, минимум на тридцать шесть месяцев."

# bg/ceo/ceo.rpy:3878
translate russian result_meeting_board_02_male_91774ffe:
    "Энтони" "Всего семьсот двадцать тысяч долларов за тщательный подход к письму на одной странице."

# bg/ceo/ceo.rpy:3881
translate russian result_meeting_board_02_male_630e01ad:
    "Артур" "Проверка завершена. Договор хороший. Ничто не мешало нам подать уведомление."

# bg/ceo/ceo.rpy:3883
translate russian result_meeting_board_02_male_4dbe2c4a:
    mike.say "Вообще ничто?"

# bg/ceo/ceo.rpy:3885
translate russian result_meeting_board_02_male_a4e19bf9:
    "Артур" "Вообще ничто. Я бы рекомендовал подать его в установленный срок."

# bg/ceo/ceo.rpy:3888
translate russian result_meeting_board_02_male_853330e2:
    "Энтони" "Я и просил вас это сделать за три дня до конца срока!"

# bg/ceo/ceo.rpy:3891
translate russian result_meeting_board_02_male_08f6c4d3:
    "Артур" "Да, полагаю..."

# bg/ceo/ceo.rpy:3893
translate russian result_meeting_board_02_male_2c5ce614:
    "Впервые вижу, чтобы Артур действительно не смог закончить фразу."

# bg/ceo/ceo.rpy:3905
translate russian meeting_board_03_male_a99e4181:
    "Объявляя новости, Уильям чуть ли не стучит кулаком."

# bg/ceo/ceo.rpy:3907
translate russian meeting_board_03_male_2aed93e7:
    "Уильям" "Келлис запускают свой продукт через несколько дней. Наш орган сертификации обещает результат к концу следующего месяца."

# bg/ceo/ceo.rpy:3908
translate russian meeting_board_03_male_d493f5e5:
    "Уильям" "Значит, отгружаем сейчас, а сертификацию проходим параллельно. Все так делают."

# bg/ceo/ceo.rpy:3909
translate russian meeting_board_03_male_62ae018a:
    "Уильям" "Сертификат — формальность, босс. Продукт уже соответствует требованиям. Наши внутренние испытания это подтверждают."

# bg/ceo/ceo.rpy:3912
translate russian meeting_board_03_male_a885a756:
    "Артур качает головой."

# bg/ceo/ceo.rpy:3914
translate russian meeting_board_03_male_d246c1d3:
    "Артур" "Внутренние испытания были у всех, кого за такое привлекали к ответственности."

# bg/ceo/ceo.rpy:3917
translate russian meeting_board_03_male_ad408df8:
    "Уильям" "Проблема в бумагах, а не в безопасности!"

# bg/ceo/ceo.rpy:3920
translate russian meeting_board_03_male_e9966740:
    "Артур" "Проблема в бумагах для товара, подлежащего обязательной сертификации. Прошу вас на минуту вдуматься в эту фразу."

# bg/ceo/ceo.rpy:3921
translate russian meeting_board_03_male_5bb30fa7:
    "Артур" "Если мы выпустим товар на рынок без сертификата, нарушение будет совершено в день первой продажи."

# bg/ceo/ceo.rpy:3922
translate russian meeting_board_03_male_31eae556:
    "Артур" "Что будет написано в сертификате на четырнадцатой неделе, неважно. Как и то, что товар пройдёт проверку."

# bg/ceo/ceo.rpy:3925
translate russian meeting_board_03_male_57d6a516:
    "Уильям" "А если подождём, они выйдут первыми! А главное — быть первым!"

# bg/ceo/ceo.rpy:3928
translate russian meeting_board_03_male_66211f95:
    "Артур" "Второе место — целая компания. Первое — уголовное дело и пример в учебнике!"

# bg/ceo/ceo.rpy:3931
translate russian meeting_board_03_male_80f54715:
    "Уильям" "Сэр, при всём уважении к Артуру, с его скоростью мы навсегда останемся маленькой компанией."

# bg/ceo/ceo.rpy:3934
translate russian meeting_board_03_male_7174d747:
    "Артур" "Лучше остаться маленькими, чем закрыться."

# bg/ceo/ceo.rpy:3936
translate russian meeting_board_03_male_f35e180e:
    "Оба смотрят на меня и ждут, когда начальник рассудит спор."

# bg/ceo/ceo.rpy:3939
translate russian meeting_board_03_male_8705ba5b:
    "Как там говорят: кто рано встаёт, тому бог подаёт?"

# bg/ceo/ceo.rpy:3940
translate russian meeting_board_03_male_c93226ca:
    mike.say "Отгружаем через девять дней и параллельно проходим сертификацию."

# bg/ceo/ceo.rpy:3942
translate russian meeting_board_03_male_81f2fb2a:
    "Уильям чуть ли не вскидывает кулак в победном жесте."

# bg/ceo/ceo.rpy:3943
translate russian meeting_board_03_male_980041dc:
    "Уильям" "ДА! Спасибо, босс! Правильное решение."

# bg/ceo/ceo.rpy:3946
translate russian meeting_board_03_male_7a723e18:
    "Артур, разумеется, не столь воодушевлён."

# bg/ceo/ceo.rpy:3948
translate russian meeting_board_03_male_c247698b:
    "Артур" "Прошу письменно зафиксировать мою рекомендацию. И вашу подпись в подтверждение того, что вы её получили."

# bg/ceo/ceo.rpy:3950
translate russian meeting_board_03_male_e84c179e:
    mike.say "Это обычная практика?"

# bg/ceo/ceo.rpy:3952
translate russian meeting_board_03_male_d197c9d4:
    "Артур" "Обычная, когда директор собирается принять на себя личную ответственность и, похоже, этого не замечает."

# bg/ceo/ceo.rpy:3954
translate russian meeting_board_03_male_c641f702:
    "Я подписываю."

# bg/ceo/ceo.rpy:3955
translate russian meeting_board_03_male_f51f2e4b:
    "Рука у меня не вполне твёрдая. Хорошо, что никто об этом не говорит."

# bg/ceo/ceo.rpy:3958
translate russian meeting_board_03_male_5068fd82:
    "Как там говорят: тише едешь — дальше будешь?"

# bg/ceo/ceo.rpy:3959
translate russian meeting_board_03_male_726a2ce3:
    mike.say "Без сертификата ничего не отгружаем."

# bg/ceo/ceo.rpy:3960
translate russian meeting_board_03_male_3e095a27:
    "Артур кивает и с достоинством благодарит меня."

# bg/ceo/ceo.rpy:3962
translate russian meeting_board_03_male_4cd3ce15:
    "Артур" "Вы не пожалеете."

# bg/ceo/ceo.rpy:3965
translate russian meeting_board_03_male_7fadf8b5:
    "Уильям, разумеется, не столь воодушевлён."

# bg/ceo/ceo.rpy:3967
translate russian meeting_board_03_male_cc8b2592:
    "Уильям" "Босс, мы дарим Келлис целый квартал..."

# bg/ceo/ceo.rpy:3969
translate russian meeting_board_03_male_03eec290:
    mike.say "Уильям, если хочешь быть человеком, который принимает смелые решения, нужно прожить достаточно долго, чтобы принять следующее."

# bg/ceo/ceo.rpy:3971
translate russian meeting_board_03_male_17ea7aa8:
    "Уильям" "Неплохо сказано, сэр! Можно я вас процитирую?"

# bg/ceo/ceo.rpy:3973
translate russian meeting_board_03_male_8fc21277:
    mike.say "Конечно, Уильям... Как хочешь..."

# bg/ceo/ceo.rpy:3974
translate russian meeting_board_03_male_067bd3f9:
    "Со страхом жду, где он применит мою цитату. Но знаю, что обязательно применит."

# bg/ceo/ceo.rpy:3983
translate russian result_meeting_board_03_male_d76e7672:
    "Келлис выходят первыми. Смотреть на это и правда больно."

# bg/ceo/ceo.rpy:3984
translate russian result_meeting_board_03_male_38c938fb:
    "А через несколько дней отзывают товар."

# bg/ceo/ceo.rpy:3988
translate russian result_meeting_board_03_male_d86236ff:
    "Артур" "Они не прошли сертификацию из-за недостаточного электрического зазора, а отгрузки начали заранее."

# bg/ceo/ceo.rpy:3989
translate russian result_meeting_board_03_male_1f625203:
    "Артур" "Отозваны четыре тысячи единиц, выдано предписание. Коммерческого директора допрашивают как подозреваемого."

# bg/ceo/ceo.rpy:3991
translate russian result_meeting_board_03_male_bccc7e11:
    "У Уильяма хватает совести побледнеть."

# bg/ceo/ceo.rpy:3993
translate russian result_meeting_board_03_male_192317ea:
    "Уильям" "На их месте могли быть мы!"

# bg/ceo/ceo.rpy:3996
translate russian result_meeting_board_03_male_f73a1a96:
    "Артур" "На их месте были бы лично вы."

# bg/ceo/ceo.rpy:3997
translate russian result_meeting_board_03_male_2f9bfc5b:
    "Артур" "Ответственным указали бы вас. Я уже подготовил для вас письмо."

# bg/ceo/ceo.rpy:4000
translate russian result_meeting_board_03_male_995de8ab:
    "Уильям" "Вы подготовили для меня письмо?"

# bg/ceo/ceo.rpy:4003
translate russian result_meeting_board_03_male_e8492b5a:
    "Артур" "Я готовлю письма для всех. Это очень тихий способ бояться за другого человека."

# bg/ceo/ceo.rpy:4005
translate russian result_meeting_board_03_male_56abc6e5:
    "Мы получаем сертификат и выходим в категорию, которую только что освободили Келлис."

# bg/ceo/ceo.rpy:4007
translate russian result_meeting_board_03_male_2f81c2aa:
    "Ещё очень долго Уильям ни слова не говорит о скорости."

# bg/ceo/ceo.rpy:4010
translate russian result_meeting_board_03_male_6c966612:
    "Мы начинаем отгрузки. Примерно четыре дня всё идёт прекрасно."

# bg/ceo/ceo.rpy:4012
translate russian result_meeting_board_03_male_e796a55d:
    "Артур" "На склад в Ардели приехал инспектор торгового надзора."

# bg/ceo/ceo.rpy:4013
translate russian result_meeting_board_03_male_5c8290fd:
    "Артур" "Забрал два экземпляра товара и документы."

# bg/ceo/ceo.rpy:4015
translate russian result_meeting_board_03_male_e72131ce:
    mike.say "И?!"

# bg/ceo/ceo.rpy:4017
translate russian result_meeting_board_03_male_62707b62:
    "Артур" "И сертификата нет. Потому что его нет."

# bg/ceo/ceo.rpy:4018
translate russian result_meeting_board_03_male_f58e6706:
    "Артур" "Продажа товара приостановлена до выяснения обстоятельств. Это не просьба, а предписание."

# bg/ceo/ceo.rpy:4022
translate russian result_meeting_board_03_male_22d1a78c:
    "Энтони" "Отзыв четырёх тысяч единиц обойдётся в триста пятнадцать тысяч."

# bg/ceo/ceo.rpy:4023
translate russian result_meeting_board_03_male_8fbfd8b9:
    "Энтони" "Запуск провален. Келлис выйдут в пустую нишу."

# bg/ceo/ceo.rpy:4026
translate russian result_meeting_board_03_male_f31c17ea:
    "Артур" "Ещё предстоит допрос директора как подозреваемого."

# bg/ceo/ceo.rpy:4028
translate russian result_meeting_board_03_male_6aabbec0:
    mike.say "Какого директора?"

# bg/ceo/ceo.rpy:4030
translate russian result_meeting_board_03_male_5911023c:
    "Артур" "Вас, мистер [hero.family_name]. Я написал это в записке."

# bg/ceo/ceo.rpy:4032
translate russian result_meeting_board_03_male_9f8c69c3:
    "Он не злорадствует."

# bg/ceo/ceo.rpy:4033
translate russian result_meeting_board_03_male_93ad4c9a:
    "Именно поэтому всё так невыносимо."

# bg/ceo/ceo.rpy:4034
translate russian result_meeting_board_03_male_74c52760:
    "Ему просто грустно. И он прав."

# bg/ceo/ceo.rpy:4046
translate russian meeting_board_04_male_b2982dc9:
    "Сегодня нашим вниманием завладевает Уильям."

# bg/ceo/ceo.rpy:4048
translate russian meeting_board_04_male_7ee08b38:
    "Уильям" "Бреннан собираются подписать договор с Веррин. Их совет директоров заседает через два дня."

# bg/ceo/ceo.rpy:4049
translate russian meeting_board_04_male_a1f232b9:
    "Уильям" "Через четыре часа я могу сесть в самолёт с трёхлетним договором и ждать в приёмной, когда их совет придёт на заседание."

# bg/ceo/ceo.rpy:4051
translate russian meeting_board_04_male_540fa9dc:
    "Артур тут же его останавливает."

# bg/ceo/ceo.rpy:4053
translate russian meeting_board_04_male_ccc9b740:
    "Артур" "Нельзя делать предложение, которое не прошло юридическую проверку."

# bg/ceo/ceo.rpy:4056
translate russian meeting_board_04_male_d448faf3:
    "Уильям" "Это наш стандартный договор с двумя изменёнными цифрами!"

# bg/ceo/ceo.rpy:4059
translate russian meeting_board_04_male_3312077d:
    "Артур" "Это наш стандартный договор с двумя изменёнными цифрами для клиента из сегмента, где мы уже снабжаем четверых его конкурентов."

# bg/ceo/ceo.rpy:4060
translate russian meeting_board_04_male_d5e51eb3:
    "Артур" "Разные цены в этом сегменте — готовый повод для жалобы. И пожалуются те четверо, которым таких условий не дали."

# bg/ceo/ceo.rpy:4063
translate russian meeting_board_04_male_45b7b3ff:
    "Уильям" "Тогда оформим не скидку, а компенсацию за переход. Это другая статья."

# bg/ceo/ceo.rpy:4066
translate russian meeting_board_04_male_0cff5885:
    "Артур" "Пока это другое слово. Чтобы сделать его другой статьёй, мне нужны две недели."

# bg/ceo/ceo.rpy:4069
translate russian meeting_board_04_male_8669a655:
    "Уильям" "Их совет заседает ЧЕРЕЗ ДВА ДНЯ!"

# bg/ceo/ceo.rpy:4072
translate russian meeting_board_04_male_36e39de8:
    "Артур" "Пусть заседает. Через три месяца соберётся снова. А мы всё ещё будем здесь, без жалоб на нас."

# bg/ceo/ceo.rpy:4074
translate russian meeting_board_04_male_f2dfdf7f:
    "Уильям выглядит так, будто сейчас самовоспламенится."

# bg/ceo/ceo.rpy:4075
translate russian meeting_board_04_male_62ceecd3:
    "А Артур — как человек, который ждёт автобус, точно зная, что тот не придёт."

# bg/ceo/ceo.rpy:4078
translate russian meeting_board_04_male_568089eb:
    "Мне кажется, именно мы должны действовать решительно."

# bg/ceo/ceo.rpy:4079
translate russian meeting_board_04_male_b079fa14:
    mike.say "Лети, Уильям."

# bg/ceo/ceo.rpy:4081
translate russian meeting_board_04_male_1186f40e:
    "Уильям кивает и уже почти встаёт."

# bg/ceo/ceo.rpy:4082
translate russian meeting_board_04_male_b35415e2:
    "Уильям" "Босс, я вас не подведу."

# bg/ceo/ceo.rpy:4084
translate russian meeting_board_04_male_74f4575c:
    "Я поворачиваюсь к Артуру, прежде чем тот успевает возразить."

# bg/ceo/ceo.rpy:4085
translate russian meeting_board_04_male_e1034d3b:
    mike.say "Артур, оформите компенсацию вместе с ним по телефону из аэропорта."

# bg/ceo/ceo.rpy:4087
translate russian meeting_board_04_male_b287500c:
    "Артур" "Из {i}аэропорта{/i}?!"

# bg/ceo/ceo.rpy:4089
translate russian meeting_board_04_male_ed0321d2:
    mike.say "У тебя четыре часа, Артур..."

# bg/ceo/ceo.rpy:4090
translate russian meeting_board_04_male_925e228a:
    mike.say "На три часа пятьдесят минут больше, чем Уильям обычно даёт кому бы то ни было."

# bg/ceo/ceo.rpy:4092
translate russian meeting_board_04_male_08555ad5:
    "Артур" "К сожалению, это правда."

# bg/ceo/ceo.rpy:4094
translate russian meeting_board_04_male_3b7c62f7:
    "И он всё делает."

# bg/ceo/ceo.rpy:4095
translate russian meeting_board_04_male_ce21ef05:
    "По телефону, в зале ожидания аэропорта, в час, когда ни один юрист не должен бодрствовать. Всё время ворча."

# bg/ceo/ceo.rpy:4098
translate russian meeting_board_04_male_020494e8:
    "Мне кажется, здесь следует проявить осторожность."

# bg/ceo/ceo.rpy:4099
translate russian meeting_board_04_male_4ea3ed83:
    mike.say "Никакого предложения до проверки."

# bg/ceo/ceo.rpy:4100
translate russian meeting_board_04_male_5c1cd110:
    "Стоит мне обозначить свою позицию, как Артур тут же поддерживает её."

# bg/ceo/ceo.rpy:4102
translate russian meeting_board_04_male_90aa8bd7:
    "Артур" "Верно. На сто процентов."

# bg/ceo/ceo.rpy:4105
translate russian meeting_board_04_male_d09268d1:
    "Уильям, разумеется, так не считает."

# bg/ceo/ceo.rpy:4107
translate russian meeting_board_04_male_f7ca9063:
    "Уильям" "Босс, пока его проверят, предлагать будет уже НЕКОМУ."

# bg/ceo/ceo.rpy:4109
translate russian meeting_board_04_male_1f50a664:
    mike.say "Значит, и изначально было некому."

# bg/ceo/ceo.rpy:4111
translate russian meeting_board_04_male_6851c074:
    "Уильям" "Понял, сэр. Полностью понял."

# bg/ceo/ceo.rpy:4113
translate russian meeting_board_04_male_0212c768:
    "Он соглашается так быстро, что я сразу понимаю: он считает, что я совершил серьёзную ошибку."

# bg/ceo/ceo.rpy:4114
translate russian meeting_board_04_male_66a9fc3b:
    "Почему-то это хуже, чем если бы он спорил."

# bg/ceo/ceo.rpy:4127
translate russian result_meeting_board_04_male_42ba527f:
    "Переночевав в аэропорту, Уильям оказывается в приёмной Бреннан раньше их совета директоров."

# bg/ceo/ceo.rpy:4129
translate russian result_meeting_board_04_male_864178e8:
    "Уильям" "Меня пустили на заседание, босс! НА ЗАСЕДАНИЕ!"

# bg/ceo/ceo.rpy:4132
translate russian result_meeting_board_04_male_c1eba7d5:
    "Энтони" "Трёхлетний договор, два миллиона сто тысяч в год..."

# bg/ceo/ceo.rpy:4133
translate russian result_meeting_board_04_male_2b578c29:
    "Энтони" "С компенсацией за переход, которую мистер Макраклур оформил по телефону из зала ожидания аэропорта."

# bg/ceo/ceo.rpy:4136
translate russian result_meeting_board_04_male_f1fa3fa1:
    "Артур" "Всё оформлено надлежащим образом и выдержит претензии других клиентов этого сегмента. Прошу заметить: я сделал это стоя в аэропорту."

# bg/ceo/ceo.rpy:4138
translate russian result_meeting_board_04_male_a41621f3:
    "Артур" "Мне семьдесят один год!"

# bg/ceo/ceo.rpy:4141
translate russian result_meeting_board_04_male_c42e796a:
    "Уильям" "Вы были великолепны!"

# bg/ceo/ceo.rpy:4144
translate russian result_meeting_board_04_male_7f66315c:
    "Артур" "Не говорите такого, когда я не могу понять, искренни ли вы!"

# bg/ceo/ceo.rpy:4147
translate russian result_meeting_board_04_male_0b11cf4e:
    "Уильям" "Я серьёзно!"

# bg/ceo/ceo.rpy:4150
translate russian result_meeting_board_04_male_9f137450:
    "Артур" "В этом и состоит трагедия всей вашей манеры общения, молодой человек."

# bg/ceo/ceo.rpy:4153
translate russian result_meeting_board_04_male_e979e9ee:
    "Из-за бумаг Энтони доносится звук, почти наверняка похожий на смех."

# bg/ceo/ceo.rpy:4157
translate russian result_meeting_board_04_male_2493149a:
    "Бреннан подписывают договор с Веррин. Судя по всему, на это уходит около восьми минут."

# bg/ceo/ceo.rpy:4163
translate russian result_meeting_board_04_male_204d13b3:
    "Энтони" "Два миллиона сто тысяч в год на три года ушли конкуренту."

# bg/ceo/ceo.rpy:4164
translate russian result_meeting_board_04_male_aad84542:
    "Энтони" "Ради юридической проверки, которая закончилась через четыре дня после подписания."

# bg/ceo/ceo.rpy:4166
translate russian result_meeting_board_04_male_4673bfd5:
    mike.say "Каков результат проверки?"

# bg/ceo/ceo.rpy:4168
translate russian result_meeting_board_04_male_309a1c1f:
    "Артур" "Компенсация за переход была полностью обоснованна. Можно было предложить договор в исходном виде."

# bg/ceo/ceo.rpy:4170
translate russian result_meeting_board_04_male_e144fc3b:
    mike.say "В исходном виде?"

# bg/ceo/ceo.rpy:4172
translate russian result_meeting_board_04_male_c0a0ce55:
    "Артур" "В исходном."

# bg/ceo/ceo.rpy:4173
translate russian result_meeting_board_04_male_9897646f:
    "Артур" "Вообще ничего менять не требовалось."

# bg/ceo/ceo.rpy:4174
translate russian result_meeting_board_04_male_d4c120f4:
    "Артур" "Я узнал это, лишь проверив договор. В этом и смысл проверки."

# bg/ceo/ceo.rpy:4177
translate russian result_meeting_board_04_male_c3d89681:
    "Уильям" "Сэр, я ничего не стану говорить."

# bg/ceo/ceo.rpy:4179
translate russian result_meeting_board_04_male_7df4f6b9:
    mike.say "Ты совершенно точно собираешься что-то сказать!"

# bg/ceo/ceo.rpy:4181
translate russian result_meeting_board_04_male_a88463dd:
    "Уильям" "Тогда приберегу до момента, когда прозвучит убедительнее."

# bg/ceo/ceo.rpy:4183
translate russian result_meeting_board_04_male_e0b9a1b0:
    "И именно так он и поступает: терпеливо дожидается нужного момента."

# bg/ceo/ceo.rpy:4184
translate russian result_meeting_board_04_male_5774d94b:
    "Однажды он станет очень опасным."

# bg/ceo/ceo.rpy:4196
translate russian meeting_board_05_male_863727d6:
    "Голова идёт кругом, пока я пытаюсь уследить за объяснениями Уильяма."

# bg/ceo/ceo.rpy:4198
translate russian meeting_board_05_male_0fb1dbc3:
    "Уильям" "Лучший квартал за шесть лет. Значит, пора расширяться."

# bg/ceo/ceo.rpy:4199
translate russian meeting_board_05_male_f5282bf0:
    "Уильям" "Штат на тридцать процентов больше, три новых региона. И прямо сейчас, пока деньги ещё тёплые."

# bg/ceo/ceo.rpy:4200
translate russian meeting_board_05_male_d971b079:
    "Уильям" "Осторожничая в хороший квартал, не вырастешь. Хорошие кварталы — время, когда рост обходится дёшево."

# bg/ceo/ceo.rpy:4202
translate russian meeting_board_05_male_1b873134:
    "Энтони без колебаний спускает Уильяма с небес на землю."

# bg/ceo/ceo.rpy:4204
translate russian meeting_board_05_male_01d212d1:
    "Энтони" "В квартале было одно разовое поступление: компенсация от Хэллоран."

# bg/ceo/ceo.rpy:4205
translate russian meeting_board_05_male_59f4cae3:
    "Энтони" "Девятьсот пять тысяч. Единовременно. Слово «единовременно» я использовал в четырёх отдельных документах."

# bg/ceo/ceo.rpy:4206
translate russian meeting_board_05_male_71aba81f:
    "Энтони" "Если убрать его из расчёта, базовые показатели выросли на две целых одну десятую процента."

# bg/ceo/ceo.rpy:4207
translate russian meeting_board_05_male_fcf54a68:
    "Энтони" "Вполне достойная цифра. И совершенно негодное основание для увеличения штата на тридцать процентов."

# bg/ceo/ceo.rpy:4210
translate russian meeting_board_05_male_d3cea029:
    "Уильям" "Но потенциальных сделок огромное количество!"

# bg/ceo/ceo.rpy:4213
translate russian meeting_board_05_male_131eb04c:
    "Энтони" "Потенциальных сделок всегда огромное количество. Для того этот список и существует. Его составляют люди, у которых оптимизм входит в должностные обязанности."

# bg/ceo/ceo.rpy:4216
translate russian meeting_board_05_male_95dfeaad:
    "Уильям" "Значит, вечно ничего не делать, потому что цифра может оказаться случайностью?!"

# bg/ceo/ceo.rpy:4219
translate russian meeting_board_05_male_93400384:
    "Энтони" "Ничего не делать два квартала. Столько нужно, чтобы случайность перестала быть случайностью."

# bg/ceo/ceo.rpy:4220
translate russian meeting_board_05_male_2a305da0:
    "Энтони" "Если показатели продержатся два квартала, увеличивайте штат хоть на сорок процентов. Я помогу составить план."

# bg/ceo/ceo.rpy:4221
translate russian meeting_board_05_male_c9fe585d:
    "Энтони" "А если нет, вы наймёте девяносто человек в компанию, которой нечем им платить."

# bg/ceo/ceo.rpy:4224
translate russian meeting_board_05_male_d9092b76:
    "Уильям" "Это не осторожность, а страх с электронной таблицей."

# bg/ceo/ceo.rpy:4226
translate russian meeting_board_05_male_f1cc7478:
    "Энтони никак не реагирует. Именно поэтому Уильям выглядит пятилетним ребёнком."

# bg/ceo/ceo.rpy:4229
translate russian meeting_board_05_male_44eba61d:
    "Мне нравится предложение Уильяма."

# bg/ceo/ceo.rpy:4230
translate russian meeting_board_05_male_f8e9da77:
    mike.say "Расширяемся. Тридцать процентов, три региона."

# bg/ceo/ceo.rpy:4232
translate russian meeting_board_05_male_71ba770a:
    "Ему, разумеется, нравится, что мне нравится."

# bg/ceo/ceo.rpy:4233
translate russian meeting_board_05_male_8e9fe74b:
    "Уильям" "Поверьте, вы не пожалеете!"

# bg/ceo/ceo.rpy:4236
translate russian meeting_board_05_male_0593db3c:
    "Энтони реагирует гораздо сдержаннее."

# bg/ceo/ceo.rpy:4238
translate russian meeting_board_05_male_d91f74fd:
    "Энтони" "Прошу отдельно отметить разовое поступление в протоколе совета. Прямым текстом, с указанием суммы."

# bg/ceo/ceo.rpy:4240
translate russian meeting_board_05_male_967b23a4:
    mike.say "Отмечай."

# bg/ceo/ceo.rpy:4242
translate russian meeting_board_05_male_c14ecd42:
    "Энтони" "Отмечу так, чтобы потом было очень легко найти."

# bg/ceo/ceo.rpy:4245
translate russian meeting_board_05_male_7f9202bc:
    "Уильям" "Он опять нагнетает."

# bg/ceo/ceo.rpy:4248
translate russian meeting_board_05_male_b0f3666c:
    "Энтони" "Я точен в формулировках. Это часто путают с нагнетанием."

# bg/ceo/ceo.rpy:4251
translate russian meeting_board_05_male_b8c2d42a:
    "Энтони уходит заниматься своими обязанностями."

# bg/ceo/ceo.rpy:4252
translate russian meeting_board_05_male_fce78348:
    "Где-то в здании готовят электронную таблицу с моим именем."

# bg/ceo/ceo.rpy:4255
translate russian meeting_board_05_male_6f4ee20b:
    "Предложенный Энтони путь внушает мне спокойствие."

# bg/ceo/ceo.rpy:4256
translate russian meeting_board_05_male_59b96887:
    mike.say "Ждём два квартала. Потом посмотрим ещё раз."

# bg/ceo/ceo.rpy:4258
translate russian meeting_board_05_male_dc6e7be5:
    "Ему, разумеется, нравится, что я с ним согласен."

# bg/ceo/ceo.rpy:4259
translate russian meeting_board_05_male_e052132e:
    "Энтони" "Вы принимаете правильное решение."

# bg/ceo/ceo.rpy:4260
translate russian meeting_board_05_male_bdc4ac78:
    "Энтони" "План подготовлю сейчас, чтобы он был готов, когда понадобится, а не на следующий день."

# bg/ceo/ceo.rpy:4263
translate russian meeting_board_05_male_c7af43c5:
    "Уильям, разумеется, впечатлён куда меньше."

# bg/ceo/ceo.rpy:4265
translate russian meeting_board_05_male_8016ebc4:
    "Уильям" "Босс, если потенциальные сделки состоятся, а людей не хватит..."

# bg/ceo/ceo.rpy:4267
translate russian meeting_board_05_male_9f4c3e01:
    mike.say "Тогда будем перегружены работой. Это лучше, чем избыток людей и пустые кабинеты."

# bg/ceo/ceo.rpy:4269
translate russian meeting_board_05_male_a064747d:
    "Уильям" "Хорошая фраза, сэр. Очень хорошая."

# bg/ceo/ceo.rpy:4272
translate russian meeting_board_05_male_90427169:
    "Энтони" "И, по совпадению, правдивая."

# bg/ceo/ceo.rpy:4274
translate russian meeting_board_05_male_eda6c0f3:
    "Уильям её записывает."

# bg/ceo/ceo.rpy:4275
translate russian meeting_board_05_male_c8ebe5e0:
    "Почти уверен, что у него есть отдельный блокнот для фраз, которые он собирается повторять."

# bg/ceo/ceo.rpy:4284
translate russian result_meeting_board_05_male_7f00aa76:
    "Предварительные цифры показывают отсутствие роста. Пересмотр потенциальных сделок выглядит ещё хуже."

# bg/ceo/ceo.rpy:4288
translate russian result_meeting_board_05_male_c6d089f5:
    "Энтони" "Базовый рост — одна целая восемь десятых процента. Выплата Хэллоран не повторилась, как и было сказано."

# bg/ceo/ceo.rpy:4289
translate russian result_meeting_board_05_male_d2aee66a:
    "Энтони" "Если бы мы увеличили штат на тридцать процентов, в этом месяце уже обсуждали бы сокращения..."

# bg/ceo/ceo.rpy:4290
translate russian result_meeting_board_05_male_cbf0f8f0:
    "Энтони" "Ценой примерно в шестьсот тысяч и огромную потерю доверия."

# bg/ceo/ceo.rpy:4293
translate russian result_meeting_board_05_male_4dae6b38:
    "Уильям" "То есть список потенциальных сделок был..."

# bg/ceo/ceo.rpy:4296
translate russian result_meeting_board_05_male_0388f6fa:
    "Энтони" "Оптимизмом. В письменном виде. Как всегда."

# bg/ceo/ceo.rpy:4299
translate russian result_meeting_board_05_male_6eea9536:
    "Уильям" "Ладно, ладно... Справедливо."

# bg/ceo/ceo.rpy:4300
translate russian result_meeting_board_05_male_70857a49:
    "Уильям" "Хочешь, чтобы я это сказал?"

# bg/ceo/ceo.rpy:4303
translate russian result_meeting_board_05_male_9bc7675e:
    "Энтони" "Нет."

# bg/ceo/ceo.rpy:4306
translate russian result_meeting_board_05_male_58619e22:
    "Уильям" "По-моему, хочешь."

# bg/ceo/ceo.rpy:4309
translate russian result_meeting_board_05_male_886ea858:
    "Энтони" "Я хочу получить план на свой стол. Вот чего я хочу."

# bg/ceo/ceo.rpy:4310
translate russian result_meeting_board_05_male_22bb1cb7:
    "Энтони" "И хочу уже два квартала."

# bg/ceo/ceo.rpy:4312
translate russian result_meeting_board_05_male_d6eac129:
    "Уильям приносит план. Он и правда хорош."

# bg/ceo/ceo.rpy:4314
translate russian result_meeting_board_05_male_b1205710:
    "Энтони меняет четыре цифры и называет его отличным. Из его уст это равносильно посвящению в рыцари."

# bg/ceo/ceo.rpy:4317
translate russian result_meeting_board_05_male_2c976052:
    "Первые тридцать сотрудников выходят на работу. Примерно четыре дня это по-настоящему воодушевляет."

# bg/ceo/ceo.rpy:4322
translate russian result_meeting_board_05_male_4d0ba3da:
    "Энтони" "Базовый рост — одна целая восемь десятых процента."

# bg/ceo/ceo.rpy:4323
translate russian result_meeting_board_05_male_ea91166b:
    "Энтони" "Фонд оплаты труда вырос на двадцать девять процентов."

# bg/ceo/ceo.rpy:4324
translate russian result_meeting_board_05_male_124c5aec:
    "Энтони" "Денежные резервы убывают на четыреста десять тысяч в месяц. А условия кредитной линии предполагают нулевой отток."

# bg/ceo/ceo.rpy:4326
translate russian result_meeting_board_05_male_fc464450:
    mike.say "Сколько у нас времени?"

# bg/ceo/ceo.rpy:4328
translate russian result_meeting_board_05_male_1417439b:
    "Энтони" "Девятнадцать недель. Или пять, если банк проведёт досрочную проверку. А он проведёт: банки читают ту же отчётность, что и я."

# bg/ceo/ceo.rpy:4331
translate russian result_meeting_board_05_male_b13d277f:
    "Уильям" "Но потенциальные сделки всё ещё..."

# bg/ceo/ceo.rpy:4334
translate russian result_meeting_board_05_male_04eefcbd:
    "Энтони" "Список потенциальных сделок не меняется два квартала. Именно эту их особенность никто не любит."

# bg/ceo/ceo.rpy:4335
translate russian result_meeting_board_05_male_2b7a19ed:
    "Энтони" "Придётся обсуждать сокращение должностей, к работе на которых ещё не приступили."

# bg/ceo/ceo.rpy:4336
translate russian result_meeting_board_05_male_670805d4:
    "Энтони" "Некоторые из этих людей уже переехали в другой город."

# bg/ceo/ceo.rpy:4339
translate russian result_meeting_board_05_male_59095315:
    "Уильям" "Это сделал я. Шестьдесят человек переехали из-за моего слайда."

# bg/ceo/ceo.rpy:4341
translate russian result_meeting_board_05_male_dfe7fc45:
    "Впервые вижу, чтобы Уильям Шарпнел полностью умолк."

# bg/ceo/ceo.rpy:4342
translate russian result_meeting_board_05_male_0f140853:
    "Я бы многое отдал, чтобы это случилось при других обстоятельствах."

# bg/ceo/ceo.rpy:4354
translate russian meeting_board_06_male_825266b6:
    "Уильям отрывается от бумаг, чтобы сообщить написанные в них новости."

# bg/ceo/ceo.rpy:4356
translate russian meeting_board_06_male_6847246d:
    "Уильям" "«Тарроу Лабс» закрываются. У них двадцать патентов, четыре — в нашей категории."

# bg/ceo/ceo.rpy:4357
translate russian meeting_board_06_male_e773be93:
    "Уильям" "Управляющий хочет шестьсот тысяч за весь пакет до конца месяца."

# bg/ceo/ceo.rpy:4360
translate russian meeting_board_06_male_9486f6f2:
    "Энтони" "Прямая выручка от этих патентов за оставшийся срок действия..."

# bg/ceo/ceo.rpy:4361
translate russian meeting_board_06_male_266ae006:
    "Энтони" "Двести девяносто тысяч. Вдвое ниже порога окупаемости."

# bg/ceo/ceo.rpy:4364
translate russian meeting_board_06_male_dc2dc4c5:
    "Уильям" "Потому что твоя модель считает только то, что мы на них заработаем!"

# bg/ceo/ceo.rpy:4365
translate russian meeting_board_06_male_849312b6:
    "Уильям" "Дело не в заработке. Дело в том, чего мы не заплатим."

# bg/ceo/ceo.rpy:4366
translate russian meeting_board_06_male_6fc267ea:
    "Уильям" "Два из этих четырёх патентов лежат в основе продукта, который мы выпускаем следующим."

# bg/ceo/ceo.rpy:4369
translate russian meeting_board_06_male_9dfcf984:
    "Энтони" "Это предположение."

# bg/ceo/ceo.rpy:4372
translate russian meeting_board_06_male_434a3433:
    "Уильям" "То, что Келлис их купят, — предположение."

# bg/ceo/ceo.rpy:4373
translate russian meeting_board_06_male_a516fc39:
    "Уильям" "А то, что Келлис существуют, имеют деньги и читают то же объявление управляющего, что и мы, — не предположение."

# bg/ceo/ceo.rpy:4376
translate russian meeting_board_06_male_4304299d:
    "Энтони" "Я не могу вписать в модель {i}Келлис могут доставить неприятности{/i}."

# bg/ceo/ceo.rpy:4379
translate russian meeting_board_06_male_7712994f:
    "Уильям" "Значит, ты считаешь не то! Одни цифры показывают, каким будет следующий год, а другие — будет ли он у нас вообще!"

# bg/ceo/ceo.rpy:4382
translate russian meeting_board_06_male_dd7ca65a:
    "Энтони" "Это первое сказанное вами в этой комнате, над чем мне хочется всерьёз задуматься."

# bg/ceo/ceo.rpy:4384
translate russian meeting_board_06_male_43e2df6e:
    "Возможно, это величайший комплимент за всю историю здания."

# bg/ceo/ceo.rpy:4386
translate russian meeting_board_06_male_e7578631:
    "У Уильяма вид человека, которого посвятили в рыцари канцелярским шкафом."

# bg/ceo/ceo.rpy:4390
translate russian meeting_board_06_male_92ac28ef:
    "Я решительно качаю головой."

# bg/ceo/ceo.rpy:4391
translate russian meeting_board_06_male_ae2de576:
    mike.say "Не проходит по окупаемости — не берём."

# bg/ceo/ceo.rpy:4392
translate russian meeting_board_06_male_87ba312a:
    "Энтони согласно кивает."

# bg/ceo/ceo.rpy:4394
translate russian meeting_board_06_male_9c956d56:
    "Энтони" "Зафиксирую стратегический аргумент в документах. Он был изложен должным образом."

# bg/ceo/ceo.rpy:4396
translate russian meeting_board_06_male_a333225d:
    "Но Уильям, судя по голосу, всё ещё хочет спорить."

# bg/ceo/ceo.rpy:4398
translate russian meeting_board_06_male_5af44295:
    "Уильям" "Босс, шестьсот тысяч..."

# bg/ceo/ceo.rpy:4400
translate russian meeting_board_06_male_0c070528:
    mike.say "Это шестьсот тысяч, которые не окупятся."

# bg/ceo/ceo.rpy:4402
translate russian meeting_board_06_male_30a52d93:
    "Уильям" "Понял... Дисциплинированно. Очень дисциплинированно."

# bg/ceo/ceo.rpy:4405
translate russian meeting_board_06_male_4d852cba:
    "Энтони" "Он произнёс «дисциплинированно» четыре раза за этот месяц."

# bg/ceo/ceo.rpy:4406
translate russian meeting_board_06_male_5906dd4e:
    "Энтони" "И каждый раз впоследствии выяснялось, что он был не согласен."

# bg/ceo/ceo.rpy:4409
translate russian meeting_board_06_male_5a2dcaac:
    "Уильям" "Это клевета!"

# bg/ceo/ceo.rpy:4411
translate russian meeting_board_06_male_1f2c71d8:
    "Это не клевета."

# bg/ceo/ceo.rpy:4412
translate russian meeting_board_06_male_36236336:
    "Энтони всё подсчитывает. И в подсчётах никогда не ошибается."

# bg/ceo/ceo.rpy:4415
translate russian meeting_board_06_male_739142c2:
    "Я решительно киваю."

# bg/ceo/ceo.rpy:4416
translate russian meeting_board_06_male_ff50a628:
    mike.say "Покупаем."

# bg/ceo/ceo.rpy:4418
translate russian meeting_board_06_male_f4a5d74f:
    "Через долю секунды Уильям повторяет мой жест."

# bg/ceo/ceo.rpy:4419
translate russian meeting_board_06_male_5b6f977d:
    "Уильям" "ДА!"

# bg/ceo/ceo.rpy:4421
translate russian meeting_board_06_male_673b6957:
    "Уильям" "Я... то есть... да, босс..."

# bg/ceo/ceo.rpy:4423
translate russian meeting_board_06_male_ecf5994b:
    mike.say "Через номинального владельца, если Артур сумеет организовать. И никому ни слова."

# bg/ceo/ceo.rpy:4425
translate russian meeting_board_06_male_385ec743:
    "Уильям" "Это намного лучше того, что собирался сделать я."

# bg/ceo/ceo.rpy:4428
translate russian meeting_board_06_male_6f343b26:
    "Энтони" "Поставлю на баланс как нематериальный актив и сразу признаю обесценение. Если вы ошиблись, боль почувствуем только один раз."

# bg/ceo/ceo.rpy:4430
translate russian meeting_board_06_male_e8005e5c:
    mike.say "А если я прав?"

# bg/ceo/ceo.rpy:4432
translate russian meeting_board_06_male_e1e48af9:
    "Энтони" "Через два года тихо восстановлю стоимость. Пусть заметит кто-нибудь другой."

# bg/ceo/ceo.rpy:4434
translate russian meeting_board_06_male_d2f19e8a:
    "Энтони Безас мне начинает по-настоящему нравиться. Вот уж чего я не ожидал."

# bg/ceo/ceo.rpy:4443
translate russian result_meeting_board_06_male_e2d62676:
    "Номинальный владелец покупает портфель. Келлис опаздывают на четыре дня."

# bg/ceo/ceo.rpy:4448
translate russian result_meeting_board_06_male_13313103:
    "Артур" "Их юристы написали с вопросом, кто его приобрёл."

# bg/ceo/ceo.rpy:4449
translate russian result_meeting_board_06_male_a1eebdb6:
    "Артур" "Я ответил пространно, но без ответа на вопрос. Это самое приятное, что я сделал за весь год."

# bg/ceo/ceo.rpy:4452
translate russian result_meeting_board_06_male_7c2cb13d:
    "Энтони" "Два из четырёх патентов распространяются на наш новый продукт."

# bg/ceo/ceo.rpy:4453
translate russian result_meeting_board_06_male_162ad9fa:
    "Энтони" "Будь они у Келлис, лицензия обошлась бы нам примерно в миллион сто тысяч за весь срок продажи продукта."

# bg/ceo/ceo.rpy:4454
translate russian result_meeting_board_06_male_e95b072e:
    "Энтони" "Приобретение стоило шестьсот тысяч. Прошу официально зафиксировать: моя модель была верна и бесполезна."

# bg/ceo/ceo.rpy:4457
translate russian result_meeting_board_06_male_4de5df26:
    "Уильям" "Он сказал «бесполезна»! Про себя!"

# bg/ceo/ceo.rpy:4460
translate russian result_meeting_board_06_male_c6ac376e:
    "Энтони" "Про модель. Не увлекайтесь."

# bg/ceo/ceo.rpy:4462
translate russian result_meeting_board_06_male_3b41714a:
    mike.say "Энтони, добавь стратегическую составляющую в критерии окупаемости."

# bg/ceo/ceo.rpy:4463
translate russian result_meeting_board_06_male_b1a7650b:
    mike.say "Чтобы учитывать то, что мы не хотим отдавать другим."

# bg/ceo/ceo.rpy:4465
translate russian result_meeting_board_06_male_820df768:
    "Энтони" "Вот это настоящее указание. Я десять лет ждал, чтобы кто-нибудь в этом кресле мне его дал."

# bg/ceo/ceo.rpy:4467
translate russian result_meeting_board_06_male_761f6365:
    "Никто ничего не говорит. Даже Уильяму хватает ума промолчать."

# bg/ceo/ceo.rpy:4469
translate russian result_meeting_board_06_male_90098822:
    "Келлис покупают портфель «Тарроу». Две строчки в отраслевом бюллетене."

# bg/ceo/ceo.rpy:4470
translate russian result_meeting_board_06_male_b9956199:
    "Вскоре приходит письмо."

# bg/ceo/ceo.rpy:4475
translate russian result_meeting_board_06_male_c5c6b693:
    "Артур" "Требование заключить лицензионный договор. Два патента «Тарроу» распространяются на новый продукт."

# bg/ceo/ceo.rpy:4476
translate russian result_meeting_board_06_male_e36affa2:
    "Артур" "Просят четыре процента от чистых продаж."

# bg/ceo/ceo.rpy:4479
translate russian result_meeting_board_06_male_c0456a0e:
    "Энтони" "За весь срок продажи продукта четыре процента составят примерно миллион сто тысяч."

# bg/ceo/ceo.rpy:4481
translate russian result_meeting_board_06_male_f54f3a54:
    mike.say "Вместо шестисот тысяч?"

# bg/ceo/ceo.rpy:4483
translate russian result_meeting_board_06_male_10f5a5c8:
    "Энтони" "Вместо шестисот тысяч."

# bg/ceo/ceo.rpy:4484
translate russian result_meeting_board_06_male_d263026f:
    "Энтони" "В моей модели все цифры были правильными. Неправильным был выбор цифр."

# bg/ceo/ceo.rpy:4487
translate russian result_meeting_board_06_male_c641aa67:
    "Уильям" "Я ничего не скажу."

# bg/ceo/ceo.rpy:4490
translate russian result_meeting_board_06_male_df1f2744:
    "Энтони" "Можете сказать что-нибудь одно. Ровно на одну фразу вы заработали."

# bg/ceo/ceo.rpy:4493
translate russian result_meeting_board_06_male_ce3c401b:
    "Уильям" "Хочу приберечь её для особого случая."

# bg/ceo/ceo.rpy:4495
translate russian result_meeting_board_06_male_9c7b94ef:
    "Он приберегает её."

# bg/ceo/ceo.rpy:4496
translate russian result_meeting_board_06_male_c9b27334:
    "Когда спустя несколько недель всё-таки произносит, эффект сокрушительный. Энтони принимает удар с достоинством."

# bg/drugstore/drugstore.rpy:117
translate russian morning_after_pill_ef3649fe:
    "Принимаю таблетку экстренной контрацепции. Лучше перестраховаться."

# bg/drugstore/drugstore.rpy:121
translate russian morning_after_pill_d974a1f6:
    "Сейчас принимать её незачем. Приберегу."

# bg/drugstore/drugstore.rpy:138
translate russian fertility_supplement_7e8e6b1b:
    "Принимаю добавку для повышения фертильности. Почему бы не попробовать сейчас?"

# bg/hospital/hospital.rpy:91
translate russian raise_stat_cap_3f5ca262:
    "Клиника APEX находится на верхнем этаже, за дверью, которая стоит дороже всей остальной больницы."

# bg/hospital/hospital.rpy:92
translate russian raise_stat_cap_f3bbe4f2:
    "Врач APEX" "Здравствуйте. Полагаю, вы хотите улучшить себя с помощью генной терапии, целевых ноотропов или курса инъекций, о составе которых лучше не спрашивать."

# bg/hospital/hospital.rpy:93
translate russian raise_stat_cap_3762a955:
    "Врач APEX" "Это работает, но стоит недёшево. И с каждым разом дороже, потому что каждая процедура сложнее предыдущей."

# bg/hospital/hospital.rpy:116
translate russian raise_stat_cap_1a683196:
    "Врач APEX" "Какую сторону себя вы хотите улучшить?" nointeract

# bg/hospital/hospital.rpy:125
translate russian raise_stat_cap_6685741f:
    "Врач APEX" "Хорошо. Если передумаете, приходите."

# bg/hospital/hospital.rpy:131
translate russian raise_stat_cap_d658bdcc:
    "Врач APEX" "На эту процедуру вам пока не хватает [apex_shortfall]{image=gui/icons/icon_money.png}."

# bg/hospital/hospital.rpy:138
translate russian raise_stat_cap_f249f65e:
    "Процедура занимает почти весь день, а восстановление оказывается хуже самой процедуры."

# bg/hospital/hospital.rpy:142
translate russian raise_stat_cap_8765962f:
    "Но я определённо чувствую перемену. Стало лучше. Словно меня усовершенствовали, если можно так выразиться."

# bg/hospital/hospital.rpy:143
translate russian raise_stat_cap_15bb2476:
    "Не слишком ли я ломаю четвёртую стену, если скажу, что теперь могу прокачать «[lssb_world.stat_name(stat_to_raise.name)]» до [stat_to_raise.max]?"

# bg/hospital/hospital.rpy:145
translate russian raise_stat_cap_f40d02b6:
    "Врач APEX" "Процедура прошла успешно. Но теперь развивать характеристику «[lssb_world.stat_name(stat_to_raise.name)]» будет труднее."

# bg/hospital/hospital.rpy:146
translate russian raise_stat_cap_d164494c:
    "Врач APEX" "Мы лишь дали вам пространство для роста. Самого роста придётся добиваться самостоятельно."

# bg/hospital/hospital.rpy:147
translate russian raise_stat_cap_3266edfe:
    "Врач APEX" "Потребуется примерно в [stat_to_raise.point_cost] раза больше усилий, чем раньше."

# bg/hospital/hospital.rpy:149
translate russian raise_stat_cap_5bbac930:
    "Врач APEX" "К сожалению, здесь мы достигли предела."

# bg/hospital/hospital.rpy:150
translate russian raise_stat_cap_d74ee3e5:
    "Врач APEX" "Показатель «[lssb_world.stat_name(stat_to_raise.name)]» настолько превысил норму, что это уже за пределами моего понимания."

# bg/hospital/hospital.rpy:151
translate russian raise_stat_cap_07e41279:
    "Врач APEX" "Не думаю, что мы можем ещё как-то улучшить характеристику «[lssb_world.stat_name(stat_to_raise.name)]»."

# bg/livingroom/livingroom.rpy:289
translate russian watch_tv_lexi_sleep_499cc409:
    "До завтрака есть немного времени. Решаю развалиться на диване и посмотреть телевизор."

# bg/livingroom/livingroom.rpy:290
translate russian watch_tv_lexi_sleep_d2e8680c:
    "Беру пульт, плюхаюсь на подушки и включаю экран."

# bg/livingroom/livingroom.rpy:291
translate russian watch_tv_lexi_sleep_978ed69a:
    "Лишь когда из динамиков гремит концовка какой-то рекламы, я кое-что вспоминаю."

# bg/livingroom/livingroom.rpy:292
translate russian watch_tv_lexi_sleep_66d0d86d:
    "Кто-то в прошлый раз выкрутил громкость. Звук разносится по тихому дому, словно корабельный гудок."

# bg/livingroom/livingroom.rpy:293
translate russian watch_tv_lexi_sleep_25ad3feb:
    "Я лихорадочно жму кнопки, пытаясь его выключить, но уже поздно."

# bg/livingroom/livingroom.rpy:296
translate russian watch_tv_lexi_sleep_6e440ef0:
    lexi.say "Мр-р..."

# bg/livingroom/livingroom.rpy:297
translate russian watch_tv_lexi_sleep_0e3031cd:
    lexi.say "У-уф..."

# bg/livingroom/livingroom.rpy:298
translate russian watch_tv_lexi_sleep_ddabb718:
    lexi.say "Какого чёрта..."

# bg/livingroom/livingroom.rpy:299
translate russian watch_tv_lexi_sleep_ba1189e3:
    "Я резко поворачиваюсь на ворчание."

# bg/livingroom/livingroom.rpy:300
translate russian watch_tv_lexi_sleep_b33aee8c:
    "И только тут замечаю Лекси: она всё ещё зарыта в гнездо из одеял на диване прямо рядом со мной."

# bg/livingroom/livingroom.rpy:301
translate russian watch_tv_lexi_sleep_b965de40:
    "Волосы у неё в полном беспорядке. Она моргает, глядя на меня так, будто я только что выкинул её из постели."

# bg/livingroom/livingroom.rpy:302
translate russian watch_tv_lexi_sleep_17445213:
    "Ну конечно. Как я умудрился забыть, что она всё ещё ночует здесь?"

# bg/livingroom/livingroom.rpy:303
translate russian watch_tv_lexi_sleep_0764567f:
    mike.say "А... Привет, Лекс."

# bg/livingroom/livingroom.rpy:304
translate russian watch_tv_lexi_sleep_f48315e2:
    "Лекси проводит ладонью по лицу и щурится на меня."

# bg/livingroom/livingroom.rpy:305
translate russian watch_tv_lexi_sleep_b0345c0a:
    lexi.say "[lssb_common.hero_name()]? Ты вообще что делаешь?"

# bg/livingroom/livingroom.rpy:306
translate russian watch_tv_lexi_sleep_014ce03b:
    lexi.say "Я тут, между прочим, спала!"

# bg/livingroom/livingroom.rpy:308
translate russian watch_tv_lexi_sleep_79c21e19:
    lexi.say "Вот уж спасибо. Сразу чувствуется, как мне здесь рады."

# bg/livingroom/livingroom.rpy:311
translate russian watch_tv_lexi_sleep_2798f3b2:
    "Она права. Зачем я врубил телевизор, когда она спит прямо здесь?"

# bg/livingroom/livingroom.rpy:312
translate russian watch_tv_lexi_sleep_5b34da14:
    "Особенно после всего, что Лекси недавно пришлось пережить."

# bg/livingroom/livingroom.rpy:313
translate russian watch_tv_lexi_sleep_dfda6d63:
    mike.say "Ты права. Прости, Лекси."

# bg/livingroom/livingroom.rpy:314
translate russian watch_tv_lexi_sleep_905e995d:
    mike.say "Совсем забыл, что ты здесь. Виноват."

# bg/livingroom/livingroom.rpy:315
translate russian watch_tv_lexi_sleep_dde628cc:
    "Лекси несколько секунд смотрит на меня, явно приготовившись к спору, которого не будет."

# bg/livingroom/livingroom.rpy:317
translate russian watch_tv_lexi_sleep_d05fe6f1:
    "Потом смягчается и качает головой."

# bg/livingroom/livingroom.rpy:318
translate russian watch_tv_lexi_sleep_cf65ceb7:
    lexi.say "А, забудь, [lssb_common.hero_name()]."

# bg/livingroom/livingroom.rpy:319
translate russian watch_tv_lexi_sleep_bb6a057b:
    lexi.say "Просто я ворчу, когда меня будят посреди хорошего сна."

# bg/livingroom/livingroom.rpy:320
translate russian watch_tv_lexi_sleep_0e1e9772:
    lexi.say "А ты ведь на самом деле хороший. Знаешь?"

# bg/livingroom/livingroom.rpy:321
translate russian watch_tv_lexi_sleep_4d65ce21:
    "Она слегка краснеет от собственного признания, а я отвожу взгляд, неожиданно растроганный."

# bg/livingroom/livingroom.rpy:322
translate russian watch_tv_lexi_sleep_948ca00b:
    mike.say "Знаешь что? Телевизор подождёт. Спи дальше, Лекс."

# bg/livingroom/livingroom.rpy:323
translate russian watch_tv_lexi_sleep_c922b9c6:
    "Она кивает и с тихим довольным вздохом снова зарывается в одеяла."

# bg/livingroom/livingroom.rpy:326
translate russian watch_tv_lexi_sleep_67c0ef0d:
    "Я понимаю, что она просто проснулась не в духе и в своём положении не виновата."

# bg/livingroom/livingroom.rpy:327
translate russian watch_tv_lexi_sleep_0a6a064d:
    "Но её тон всё равно почему-то меня задевает."

# bg/livingroom/livingroom.rpy:328
translate russian watch_tv_lexi_sleep_e0ad179f:
    mike.say "Могла бы проявить немного благодарности, Лекси."

# bg/livingroom/livingroom.rpy:329
translate russian watch_tv_lexi_sleep_6bee1632:
    mike.say "Это я тебя приютил, когда идти было некуда."

# bg/livingroom/livingroom.rpy:330
translate russian watch_tv_lexi_sleep_4a37cef5:
    mike.say "Ну разбудил тебя телевизор. И что?"

# bg/livingroom/livingroom.rpy:331
translate russian watch_tv_lexi_sleep_cf0ec296:
    lexi.say "А, то есть я ещё должна быть благодарна за право выслушивать твои крики?"

# bg/livingroom/livingroom.rpy:332
translate russian watch_tv_lexi_sleep_e755a287:
    "Лекси сбрасывает одеяла, собирает их в охапку и прожигает меня взглядом."

# bg/livingroom/livingroom.rpy:333
translate russian watch_tv_lexi_sleep_bb3ce695:
    lexi.say "Знаешь что? Смотри свой дурацкий телевизор. Я найду другое место для сна."

# bg/livingroom/livingroom.rpy:334
translate russian watch_tv_lexi_sleep_8fe6faf6:
    "С этими словами она сердито уходит, оставив меня наедине с пультом и неприятным осадком."

# bg/personal/personal.rpy:230
translate russian manage_team_a712f0be:
    "Теперь попробуем эту стратегию."

# bg/pool/pool.rpy:246
translate russian apply_sunscreen_7aff2661:
    "[active_girl.name] наносит на меня солнцезащитный лосьон."

# bg/studio/studio.rpy:221
translate russian gig_a31a838a:
    "Но после концерта наша сыгранность заметно падает. Перед следующим придётся вернуться в студию и порепетировать."

# intro.rpy:79
translate russian tutorial_460289c8:
    "Андреальфус" "Привет, [lssb_common.hero_name()]."

# intro.rpy:80
translate russian tutorial_ca013735:
    "Андреальфус" "Позволь представиться..."

# intro.rpy:81
translate russian tutorial_b0d9d093:
    "Андреальфус" "Я Андреальфус, демонический владыка похоти, герцог разврата, один из семи владык греха. И, честно говоря..."

# intro.rpy:82
translate russian tutorial_c0c0be19:
    "Андреальфус" "Только со мной и бывает весело."

# intro.rpy:83
translate russian tutorial_04845c30:
    "Андреальфус" "Шучу. Я всего лишь разработчик игры, в которую ты сейчас играешь."

# intro.rpy:84
translate russian tutorial_715ebda4:
    "Андреальфус" "Прежде всего, спасибо за интерес к моей игре! Надеюсь, играть в неё тебе так же приятно, как мне её создавать."

# intro.rpy:85
translate russian tutorial_30f3355b:
    "Андреальфус" "А теперь несколько советов, которые помогут освоиться в «Love & Sex»."

# intro.rpy:89
translate russian tutorial_97869440:
    "Андреальфус" "Это твоя гостиная, одна из множества {b}локаций{/b} игрового мира."

# intro.rpy:93
translate russian tutorial_01cee762:
    "Андреальфус" "Путешествуя и занимаясь своими делами, ты будешь находить разные {b}локации{/b}."

# intro.rpy:95
translate russian tutorial_a0ab950c:
    "Андреальфус" "Внизу экрана {b}локации{/b} показаны все занятия, доступные в этой {b}локации{/b}."

# intro.rpy:97
translate russian tutorial_1a87adb5:
    "Андреальфус" "Меню {b}действий{/b} показывает, что можно делать в текущей {b}локации{/b}. Недоступные действия скрыты, например если не хватает {b}потребностей{/b}, {b}характеристик{/b} или {b}денег{/b}."

# intro.rpy:99
translate russian tutorial_f1ad0766:
    "Андреальфус" "Эта кнопка открывает {b}инвентарь{/b}. Все купленные или полученные предметы появятся здесь."

# intro.rpy:101
translate russian tutorial_6c4d28c4:
    "Андреальфус" "Меню {b}выходов{/b} показывает все {b}локации{/b}, в которые можно попасть отсюда."

# intro.rpy:108
translate russian tutorial_c8f15246:
    "Андреальфус" "Слева вверху находится удобный {b}календарь{/b}, показывающий дату."

# intro.rpy:109
translate russian tutorial_39c10fba:
    "Андреальфус" "В игре год состоит из четырёх месяцев: весны, лета, осени и зимы. В каждом по 31 дню, с привычными праздниками и днями рождения."

# intro.rpy:110
translate russian tutorial_e3b5b872:
    "Андреальфус" "Некоторые {b}действия{/b} доступны только в определённое время суток или месяц."

# intro.rpy:114
translate russian tutorial_a540f756:
    "Андреальфус" "Дальше показаны твои {b}потребности{/b}. Да-да, тебе нужно есть, спать, мыться и немного развлекаться."

# intro.rpy:116
translate russian tutorial_b1404708:
    "Андреальфус" "{image=gui/icons/icon_energy.png} {b}Энергия{/b} показывает, сколько сил осталось до того, как понадобится отдых."

# intro.rpy:118
translate russian tutorial_6d22882d:
    "Андреальфус" "{image=gui/icons/icon_fun.png} {b}Веселье{/b} позволяет понять, насколько тебе скучно."

# intro.rpy:120
translate russian tutorial_36f6e79f:
    "Андреальфус" "{image=gui/icons/icon_grooming.png} {b}Ухоженность{/b} показывает, насколько ты грязный и вонючий."

# intro.rpy:122
translate russian tutorial_338b0b16:
    "Андреальфус" "{image=gui/icons/icon_hunger.png} {b}Голод{/b} показывает, насколько тебе хочется есть."

# intro.rpy:123
translate russian tutorial_a9d3d45c:
    "Андреальфус" "Большинство {b}действий{/b} расходуют показатели {b}потребностей{/b}. Не давай им опускаться слишком низко: чем они ниже, тем меньше доступно действий."

# intro.rpy:127
translate russian tutorial_ef1b65d9:
    "Андреальфус" "Рядом с {b}потребностями{/b} показаны {b}характеристики{/b}. Разных девушек привлекают разные {b}характеристики{/b}, а для некоторых {b}действий{/b} нужны высокие {b}характеристики{/b}."

# intro.rpy:129
translate russian tutorial_0a53e78b:
    "Андреальфус" "{image=gui/icons/icon_charm.png} {b}Обаяние{/b} — это твоя харизма."

# intro.rpy:131
translate russian tutorial_c5fffa7c:
    "Андреальфус" "{image=gui/icons/icon_fitness.png} {b}Фитнес{/b} отражает твои физические способности."

# intro.rpy:133
translate russian tutorial_700b72b7:
    "Андреальфус" "{image=gui/icons/icon_knowledge.png} {b}Знания{/b} — точная оценка твоего интеллекта."

# intro.rpy:134
translate russian tutorial_cb846276:
    "Андреальфус" "Советую при первой возможности повышать {b}характеристики{/b}: пока что они довольно низкие."

# intro.rpy:138
translate russian tutorial_5c0f57db:
    "Андреальфус" "После {b}характеристик{/b} показаны твои {b}деньги{/b}. Девушки любят подарки и свидания, поэтому деньги — дело первостепенное."

# intro.rpy:139
translate russian tutorial_31beeb37:
    "Андреальфус" "Ещё {b}деньги{/b} можно тратить на одежду и аксессуары, которые улучшают {b}характеристики{/b}. Некоторым девушкам одни наряды нравятся больше других."

# intro.rpy:145
translate russian tutorial_5cd0092a:
    "Андреальфус" "Иногда под {b}деньгами{/b} появляется {b}шкала прогресса{/b}. В зависимости от занятия она показывает твою долю домашних обязанностей, продвижение к повышению или то, насколько весело твоей спутнице на свидании."

# intro.rpy:152
translate russian tutorial_37982283:
    "Андреальфус" "Круглая кнопка справа вверху открывает {b}журнал сюжетов{/b}."

# intro.rpy:155
translate russian tutorial_838398d1:
    "Андреальфус" "Если не знаешь, что делать дальше, там найдутся подсказки."

# intro.rpy:157
translate russian tutorial_43045d8b:
    "Андреальфус" "Слева находятся все уже встречавшиеся тебе сюжетные категории. Выбери ту, о которой хочешь узнать подробнее."

# intro.rpy:159
translate russian tutorial_c29fcd88:
    "Андреальфус" "Если нужны подробности, у некоторых категорий есть отдельная страница в вики. Её можно открыть значком 🔗."

# intro.rpy:166
translate russian tutorial_627c3eea:
    "Андреальфус" "Круглая кнопка слева вверху открывает {b}смартфон{/b}."

# intro.rpy:168
translate russian tutorial_92434686:
    "Андреальфус" "Поскольку я довольно добрый разработчик, я загрузил тебе на телефон полезное приложение."

# intro.rpy:170
translate russian tutorial_79a66a45:
    "Андреальфус" "Получив номер девушки, ты увидишь её в контактах. Там же можно узнать кое-что о ней, например её {image=gui/icons/icon_love.png} {b}любовь{/b} и {image=gui/icons/icon_sub.png} {b}кинк{/b}."

# intro.rpy:171
translate russian tutorial_c43141cf:
    "Андреальфус" "Полезная штука, правда?"

# intro.rpy:173
translate russian tutorial_1204934b:
    "Андреальфус" "Ещё там можно посмотреть собственные показатели, но это куда менее интересно."

# intro.rpy:180
translate russian tutorial_1da941a8:
    "Андреальфус" "Как нетрудно догадаться, ты будешь встречаться с девушками. Вот {b}[bree.name]{/b}. Она девушка, милая и сексуальная. Твоя цель — трахнуть её или другую представительницу её вида."

# intro.rpy:183
translate russian tutorial_8d641d99:
    "Андреальфус" "Когда ты {b}разговариваешь{/b} с девушкой, можно выбрать тему беседы или совместное занятие. Ещё можно узнать о ней больше и следить за развитием отношений."

# intro.rpy:188
translate russian tutorial_ace7062f:
    "Андреальфус" "В самом низу находятся {b}быстрые команды{/b}. Они помогут ускорить некоторые действия."

# intro.rpy:190
translate russian tutorial_c2225331:
    "Андреальфус" "Первая кнопка, {b}«Назад»{/b}, позволяет немного вернуться в прошлое."

# intro.rpy:192
translate russian tutorial_b22e5f67:
    "Андреальфус" "Дальше идёт кнопка {b}«Пропуск»{/b}. С включённым пропуском диалоги пролетают молниеносно."

# intro.rpy:194
translate russian tutorial_b4e319af:
    "Андреальфус" "Кнопка {b}«Авто»{/b} сама переключает реплики одну за другой, чтобы ты мог читать, не нажимая каждый раз."

# intro.rpy:196
translate russian tutorial_fbffd7ae:
    "Андреальфус" "На крайний случай есть кнопка {b}«Б.Сохр.»{/b}. Она быстро сохранит твой прогресс."

# intro.rpy:198
translate russian tutorial_9ee605e0:
    "Андреальфус" "А кнопка {b}«Б.Загр.»{/b} загрузит быстрое сохранение."

# intro.rpy:201
translate russian tutorial_de954e0c:
    "Андреальфус" "С основами всё. Возвращайся в мир, полный девушек и красоток, которые только и ждут тебя."

# intro.rpy:202
translate russian tutorial_d529e8fb:
    "Андреальфус" "Перед уходом ещё три совета:\n1 — Загляни в {b}настройки{/b}: там можно настроить количество рутины и случайностей под свой вкус."

# intro.rpy:203
translate russian tutorial_22ef48a0:
    "Андреальфус" "2 — Чаще сохраняйся. Как и в жизни, в игре многое непредсказуемо. Пользуйся тем, что это всё-таки игра."

# intro.rpy:204
translate russian tutorial_2e66bf1f:
    "Андреальфус" "3 — За одно прохождение можно сделать многое, но не всё. Советую сначала исследовать как можно больше, а затем начать заново, принимать другие решения и открывать новые пути."

# intro.rpy:205
translate russian tutorial_01fbb1c4:
    "Андреальфус" "Теперь, когда всё сказано, желаю удачи в твоей виртуальной жизни в «Love & Sex»!"

# intro.rpy:206
translate russian tutorial_13935f44:
    "Андреальфус" "И помни: чем развратнее, тем лучше."

# intro.rpy:225
translate russian male_intro_38e394e9:
    "Глаза болят."

# intro.rpy:226
translate russian male_intro_19b1a5bf:
    "Уже несколько часов весь мой мир — экран. Руки продолжают печатать, хотя ничего стоящего сохранения у меня давно не получается."

# intro.rpy:227
translate russian male_intro_ea443594:
    "За спиной быстрые шаги. Я едва возвращаюсь к реальности."

# intro.rpy:230
translate russian male_intro_dca022b4:
    aletta.say "Твоя смена закончилась. Что ты ещё здесь делаешь?"

# intro.rpy:232
translate russian male_intro_90d57c03:
    "Я поворачиваюсь к ней. Ни злости, ни разочарования. Просто любопытство."

# intro.rpy:233
translate russian male_intro_919f0a04:
    mike.say "Работаю, босс."

# intro.rpy:234
translate russian male_intro_7ad9f58e:
    "Я никогда не был трудоголиком. Сделать, что велено, уйти и забыть. Сегодня всё иначе."

# intro.rpy:235
translate russian male_intro_43f6ed13:
    "Я снова утыкаюсь в экран, прячась в работе."

# intro.rpy:237
translate russian male_intro_c72a4ade:
    aletta.say "Рабочий день окончен. Иди домой. Не хватало мне ещё, чтобы какой-нибудь профсоюз вцепился в задницу из-за неоплаченных сверхурочных."

# intro.rpy:239
translate russian male_intro_ae996ac8:
    "Она никогда не признается, что заботится о подчинённых."

# intro.rpy:240
translate russian male_intro_49d0f358:
    "Но всё-таки заботится."

# intro.rpy:241
translate russian male_intro_79b50eee:
    mike.say "Как скажете, босс..."

# intro.rpy:243
translate russian male_intro_d42c6927:
    "Она демонстративно закатывает глаза и направляется обратно в кабинет."

# intro.rpy:244
translate russian male_intro_c9f330dd:
    "Я провожаю её взглядом на секунду дольше, чем следует. Юбка туго обтягивает бёдра."

# intro.rpy:246
translate russian male_intro_871945a1:
    "Нажимаю «Сохранить». Выключаю компьютер."

# intro.rpy:247
translate russian male_intro_13b4c02a:
    "Экран гаснет, и на меня смотрит моё отражение. Куртка уже в руке, мысли — уже у двери."

# intro.rpy:252
translate russian male_intro_0bc13884:
    audrey.say "Постой! Возьми меня с собой!"

# intro.rpy:254
translate russian male_intro_565c1c4d:
    "Одри. Она возникает передо мной, вцепившись обеими руками в мою рубашку. На лице — сплошная мольба."

# intro.rpy:255
translate russian male_intro_78759044:
    "Она милая. И ещё — ходячая неприятность."

# intro.rpy:256
translate russian male_intro_91b7a5ba:
    "Вечно вляпывается во что-нибудь и ждёт, что я помогу разгребать."

# intro.rpy:257
translate russian male_intro_eea8f46f:
    "Не понимаю, почему Алетта до сих пор её не уволила. Её беспомощность кажется начальнице далеко не такой милой, как думает Одри."

# intro.rpy:258
translate russian male_intro_9684d894:
    "Не моя проблема."

# intro.rpy:259
translate russian male_intro_af159285:
    mike.say "Прости, Одри. Мне пора."

# intro.rpy:261
translate russian male_intro_3cfb3fa3:
    audrey.say "Ну же! Я сумею тебя отблагодарить~!"

# intro.rpy:263
translate russian male_intro_b22d6441:
    "Вот ещё одна особенность Одри. Она флиртует со всем, что мужского пола и дышит."

# intro.rpy:264
translate russian male_intro_162902ba:
    "Насколько я могу судить, ни разу ничего не добилась."

# intro.rpy:265
translate russian male_intro_13f3472d:
    mike.say "Пока, Одри."

# intro.rpy:266
translate russian male_intro_d802289f:
    "Я отцепляю её пальцы от рубашки и устремляюсь к двери, пока она не схватилась снова."

# intro.rpy:268
translate russian male_intro_339e5dde:
    audrey.say "Я тебе этого никогда не забуду!"

# intro.rpy:275
translate russian male_intro_11c31ae5:
    "Я уныло выхожу на улицу. Тёплый ветерок скользит мимо. Такой мягкий вечер заслуживает настроения получше моего."

# intro.rpy:277
translate russian male_intro_36a29c9d:
    "Я уныло выхожу на улицу. Густая влажная летняя жара обволакивает меня. Не успеваю сделать и трёх шагов, как рубашка прилипает к спине."

# intro.rpy:279
translate russian male_intro_5e27c101:
    "Я уныло выхожу на улицу. Осенний ветер налетает на меня, треплет куртку и гонит по тротуару опавшие листья."

# intro.rpy:281
translate russian male_intro_a87e855d:
    "Я уныло выхожу на улицу. Холод пронизывает куртку насквозь, уши начинают болеть. И всё же это далеко не худшее за сегодня."

# intro.rpy:282
translate russian male_intro_3da82f5c:
    "От офиса до дома недалеко пешком. Обычно это хоть немного радует."

# intro.rpy:283
translate russian male_intro_dbb2f300:
    "Сегодня это лишь значит, что я раньше окажусь дома."

# intro.rpy:284
translate russian male_intro_a584831d:
    "Всё началось со звонка в обед..."

# intro.rpy:289
translate russian male_intro_ee36c04c:
    "Чёртов экран телефона! Я случайно принял вызов..."

# intro.rpy:291
translate russian male_intro_40832715:
    mike.say "Привет, кексик."

# intro.rpy:293
translate russian male_intro_1aeda8e1:
    mike.say "Привет, Саманта."

# intro.rpy:294
translate russian male_intro_60969894:
    samantha.say "Привет."

# intro.rpy:295
translate russian male_intro_73945d3f:
    samantha.say "Мы съехали."

# intro.rpy:296
translate russian male_intro_c852d444:
    mike.say "Погоди, что вы сделали?"

# intro.rpy:297
translate russian male_intro_20b168fd:
    samantha.say "Мы съехали!"

# intro.rpy:298
translate russian male_intro_ba49dbe4:
    samantha.say "Райан позвал меня и увёз с собой. Это было так романтично!"

# intro.rpy:299
translate russian male_intro_f4aabd32:
    mike.say "А как же я? Как же твои вещи?"

# intro.rpy:300
translate russian male_intro_0f5fe893:
    samantha.say "Райан уже всё упаковал, а мы подали от твоего имени объявление о поиске нового соседа!"

# intro.rpy:301
translate russian male_intro_784bd340:
    mike.say "Эй, погоди-ка минутку."

# intro.rpy:303
translate russian male_intro_508a9af0:
    mike.say "Дай трубку Райану, кексик."

# intro.rpy:305
translate russian male_intro_f07c352b:
    mike.say "Дай трубку Райану, Саманта."

# intro.rpy:306
translate russian male_intro_aad46f8c:
    "Несколько секунд тишины, затем отдалённое бормотание в трубке, и наконец..."

# intro.rpy:307
translate russian male_intro_5619a604:
    ryan.say "Чего?"

# intro.rpy:308
translate russian male_intro_72a7f200:
    mike.say "Ты что, чёрт возьми, творишь?"

# intro.rpy:310
translate russian male_intro_504bf501:
    mike.say "Я не потяну содержание дома в одиночку!"

# intro.rpy:312
translate russian male_intro_159bd9c5:
    mike.say "Я не могу один платить всю аренду!"

# intro.rpy:313
translate russian male_intro_dafd5ed0:
    ryan.say "Эй, успокойся. Саманта же сказала: мы уже ищем замену."

# intro.rpy:314
translate russian male_intro_e5540d59:
    mike.say "Дело не в этом!"

# intro.rpy:315
translate russian male_intro_2b03c08b:
    mike.say "Предупредить меня не подумали?"

# intro.rpy:316
translate russian male_intro_4850b551:
    ryan.say "Ты ведь не понимаешь, что такое спонтанность? Неудивительно, что Саманта выбрала меня."

# intro.rpy:317
translate russian male_intro_1a93037a:
    mike.say "Эй, это удар ниже пояса, Райан."

# intro.rpy:318
translate russian male_intro_e0e6b495:
    ryan.say "Да ладно тебе, чувак. Пока."

# intro.rpy:319
translate russian male_intro_042c4efc:
    mike.say "Постой!"

# intro.rpy:323
translate russian male_intro_68e7ba34:
    "Райан был моим другом в колледже. Тогда мы были настолько близки, что после выпуска поселились в одном доме."

# intro.rpy:325
translate russian male_intro_b96c25ca:
    "Когда хозяин решил его продать, я выкупил дом целиком."

# intro.rpy:326
translate russian male_intro_5bdf7825:
    "Потом мы взяли третьего жильца, чтобы легче было оплачивать счета. Это была Саманта."

# intro.rpy:328
translate russian male_intro_d67ef6a1:
    "Когда аренда подорожала, мы взяли третьего жильца. Это была Саманта."

# intro.rpy:329
translate russian male_intro_17cfb55b:
    "Мы оба хотели её с первого дня. Всё превратилось в соревнование."

# intro.rpy:330
translate russian male_intro_bd2b4f1b:
    "Райан выиграл."

# intro.rpy:331
translate russian male_intro_123bea15:
    "Я ещё не оправился от известия, что Алексис водила чужих мужчин в нашу постель. Ещё одно поражение ранило сильнее, чем следовало."

# intro.rpy:333
translate russian male_intro_17a93a74:
    "Теперь меня ждёт только дом. Слишком большой, слишком пустой, и все счета за него — на мне одном."

# intro.rpy:335
translate russian male_intro_e5d9afe5:
    "Теперь меня ждёт только дом. Слишком большой, слишком пустой, и платить за него мне одному."

# intro.rpy:338
translate russian male_intro_53d508b6:
    "Лучше бы я всю ночь просидел на работе, чем открыл эту дверь."

# intro.rpy:339
translate russian male_intro_1fcf4a2a:
    "...Это ещё кто?"

# intro.rpy:341
translate russian male_intro_2b7bf25f:
    "На моём крыльце стоит женщина и жмёт на звонок так, будто он ей денег должен. А дома некому открыть."

# intro.rpy:342
translate russian male_intro_f69790d0:
    "Выглядит она так, словно ей уже задолжали извинения."

# intro.rpy:343
translate russian male_intro_e7ea6531:
    mike.say "Могу чем-то помочь?"

# intro.rpy:345
translate russian male_intro_7c0e2b39:
    "Она поворачивается на мой голос, и... Ладно. Такого лица я не ожидал."

# intro.rpy:347
translate russian male_intro_419a751e:
    "Девушка" "О, привет. Знаешь, кто здесь живёт? Мы должны встретиться, но, кажется, никого нет."

# intro.rpy:349
translate russian male_intro_8d8351df:
    "Объяснение только одно: её прислал Райан."

# intro.rpy:350
translate russian male_intro_5c22988d:
    "Меня колет чувство вины. Пока я дулся на весь мир, она простояла здесь невесть сколько."

# intro.rpy:351
translate russian male_intro_86198b6e:
    mike.say "А, это я."

# intro.rpy:352
translate russian male_intro_7139a728:
    mike.say "Ты насчёт жилья?"

# intro.rpy:355
translate russian male_intro_97e3d593:
    "Девушка" "Ага! Я [bree.name]. Значит, ты мой потенциальный сосед?"

# intro.rpy:357
translate russian male_intro_18766071:
    "Если ожидание её и разозлило, она не показывает. Берёт мою руку и быстро пожимает. Ладонь тёплая."

# intro.rpy:358
translate russian male_intro_e7cfb980:
    "Кожа мягкая. Я замечаю это и делаю вид, что нет. Одной Саманты в этом доме хватило. Как бы хорошо новая девушка ни выглядела."

# intro.rpy:359
translate russian male_intro_30225bb2:
    mike.say "Да, это я."

# intro.rpy:361
translate russian male_intro_6f385fe6:
    bree.say "Приятно познакомиться!"

# intro.rpy:364
translate russian male_intro_22dfe97c:
    mike.say "Заходи..."

# intro.rpy:365
translate russian male_intro_ce158321:
    mike.say "Покажу тебе дом."

# intro.rpy:371
translate russian male_intro_b6fbcecb:
    bree.say "Ух ты, здесь довольно неплохо!"

# intro.rpy:374
translate russian male_intro_03f3f353:
    "Я киваю. Общий бассейн, столько места, а документы на дом — на моё имя. Мне повезло с этим жильём. Наверное, и ей может повезти."

# intro.rpy:376
translate russian male_intro_2a9e3424:
    "Я киваю. Общий бассейн, столько места, такая аренда. Мне повезло с этим жильём. Наверное, и ей может повезти."

# intro.rpy:378
translate russian male_intro_af3bc98e:
    bree.say "Когда можно въезжать?"

# intro.rpy:380
translate russian male_intro_7f2ad5f7:
    mike.say "Въезжать?"

# intro.rpy:381
translate russian male_intro_f393c65f:
    mike.say "Мы знакомы меньше минуты!"

# intro.rpy:382
translate russian male_intro_b95b4ae7:
    mike.say "Может, сначала зададим друг другу вопросы и познакомимся поближе?"

# intro.rpy:384
translate russian male_intro_8619644f:
    bree.say "А, хорошо!"

# intro.rpy:385
translate russian male_intro_a0f7b8d2:
    bree.say "Тогда расскажи о себе!"

# intro.rpy:387
translate russian male_intro_cb572e87:
    mike.say "Ну, это как-то слишком расплывчато..."

# intro.rpy:390
translate russian male_intro_3e0b8210:
    bree.say "Тогда... Ты любишь спорт?"

# intro.rpy:393
translate russian male_intro_2fd06451:
    mike.say "Я не особо спортивный."

# intro.rpy:398
translate russian male_intro_dd063f08:
    bree.say "Хе-хе, я тоже. Лучше хорошая видеоигра или книга — в любой день недели."

# intro.rpy:403
translate russian male_intro_aca8bc8b:
    mike.say "Я занимаюсь единоборствами."

# intro.rpy:408
translate russian male_intro_94de5b38:
    bree.say "О, круто! Как-нибудь покажешь мне пару приёмов!"

# intro.rpy:411
translate russian male_intro_bc2ad212:
    mike.say "Я отлично играю в гольф."

# intro.rpy:417
translate russian male_intro_278cc3b5:
    bree.say "Правда? Ты не похож на игрока в гольф."

# intro.rpy:419
translate russian male_intro_d7b07046:
    mike.say "Что, не бизнесмен средних лет в костюме?"

# intro.rpy:421
translate russian male_intro_7b21aba8:
    bree.say "Именно!"

# intro.rpy:423
translate russian male_intro_90231839:
    "Я качаю головой, притворно обижаясь, и продолжаю."

# intro.rpy:425
translate russian male_intro_45378a2b:
    mike.say "Я чертовски скрытный."

# intro.rpy:430
translate russian male_intro_27193c95:
    bree.say "Правда? На ниндзя ты не похож."

# intro.rpy:432
translate russian male_intro_2851787e:
    mike.say "Пф-ф. Рядом со мной ниндзя — шумные увальни."

# intro.rpy:434
translate russian male_intro_2d8f3f57:
    bree.say "Круто!"

# intro.rpy:436
translate russian male_intro_9725deff:
    "Я качаю головой и оставляю эту тему."

# intro.rpy:438
translate russian male_intro_2246f22d:
    mike.say "Готовка считается?"

# intro.rpy:443
translate russian male_intro_ee03f10b:
    bree.say "Готовка? Ну, это не совсем спорт..."

# intro.rpy:445
translate russian male_intro_d834011b:
    bree.say "Но я закрою на это глаза, если приготовишь мне что-нибудь вкусное!"

# intro.rpy:447
translate russian male_intro_f11dc776:
    "Уже понятно, что с ней будет непросто."

# intro.rpy:449
translate russian male_intro_443604a4:
    mike.say "Не особо. Самое близкое к спорту у меня — танцы."

# intro.rpy:455
translate russian male_intro_c61b6097:
    bree.say "О-о, как романтично."

# intro.rpy:458
translate russian male_intro_fe12524b:
    mike.say "Обожаю стрельбу и оружие."

# intro.rpy:464
translate russian male_intro_cff0a49c:
    bree.say "..."

# intro.rpy:467
translate russian male_intro_2fd06451_1:
    mike.say "Я не особо спортивный."

# intro.rpy:472
translate russian male_intro_dd063f08_1:
    bree.say "Хе-хе, я тоже. Лучше хорошая видеоигра или книга — в любой день недели."

# intro.rpy:475
translate russian male_intro_ec69acb5:
    bree.say "Тогда я схожу за вещами!"

# intro.rpy:477
translate russian male_intro_2b43916d:
    mike.say "П-погоди минутку!"

# intro.rpy:478
translate russian male_intro_476affd2:
    mike.say "Это был всего один вопрос!"

# intro.rpy:480
translate russian male_intro_592b7e11:
    bree.say "Ага, и теперь мы лучше знаем друг друга! Отлично!"

# intro.rpy:482
translate russian male_intro_ec4b604a:
    bree.say "Какая комната моя?"

# intro.rpy:485
translate russian male_intro_d3f685ec:
    "Ответить я не успеваю. Звонок заставляет меня вернуться к входной двери."

# intro.rpy:493
translate russian male_intro_cbe24e23:
    "Девушка" "Привет, я по объявлению о соседке?"

# intro.rpy:495
translate russian male_intro_dc916b2b:
    "Ещё одна? Что, чёрт возьми, мы написали в этом объявлении?"

# intro.rpy:496
translate russian male_intro_7e87a0c3:
    mike.say "Да, заходи."

# intro.rpy:497
translate russian male_intro_dc645afb:
    "Я отступаю, пропуская её. [bree.name] с нескрываемым любопытством выглядывает из-за моего плеча."

# intro.rpy:503
translate russian male_intro_21e93875:
    bree.say "Это наша новая соседка?"

# intro.rpy:506
translate russian male_intro_93d5c1f0:
    "Я вздыхаю. Спорить с ней бесполезно, да и выбора у меня особо нет. Пора платить по счетам, а одному мне этот дом не потянуть."

# intro.rpy:508
translate russian male_intro_8dfcc745:
    "Я вздыхаю. Спорить с ней бесполезно, да и выбора у меня особо нет. Пора платить аренду, а одному мне этот дом не потянуть."

# intro.rpy:509
translate russian male_intro_1762851f:
    "Я молча киваю. [bree.name] сияет."

# intro.rpy:511
translate russian male_intro_298f2adc:
    "Думая, что я не вижу, она победно взмахивает кулаком."

# intro.rpy:514
translate russian male_intro_d9f3dfd7:
    "В дверях ещё одна сногсшибательная девушка. [bree.name] заполняет собой комнату, а эта будто погружает её в тень."

# intro.rpy:517
translate russian male_intro_c0b56e5f:
    "Девушка" "Я туда попала?"

# intro.rpy:519
translate russian male_intro_9ed3d0ae:
    "Сначала вошла, потом спросила. Ну конечно. Почему бы и нет."

# intro.rpy:520
translate russian male_intro_fda314ce:
    mike.say "Да, приятно познакомиться."

# intro.rpy:522
translate russian male_intro_f917512b:
    bree.say "А я [bree.name]!"

# intro.rpy:524
translate russian male_intro_9f5b6a02:
    bree.say "Ты тоже собираешься въехать?"

# intro.rpy:527
translate russian male_intro_27a3895f:
    "Девушка" "В объявлении было сказано, что спальни три, так что да."

# intro.rpy:529
translate russian male_intro_e9221d30:
    "Я подавляю неприятное чувство: обе уже решили, что теперь живут здесь, и никто не потрудился спросить меня."

# intro.rpy:530
translate russian male_intro_3d7e3dd4:
    "Формально спален три. Одну мы с Райаном превратили в спортзал, но всё оборудование принадлежало ему и уехало вместе с ним."

# intro.rpy:531
translate russian male_intro_15b3610a:
    "Отлично. Значит, снова платить за абонемент в спортзал."

# intro.rpy:534
translate russian male_intro_7a3a6099:
    "Девушка" "Фу, если это такая проблема, я найду другое место."

# intro.rpy:536
translate russian male_intro_b6ed59ab:
    "Она принимает мою гримасу на свой счёт, резко разворачивается и идёт к двери."

# intro.rpy:538
translate russian male_intro_aaa5fc37:
    "Моя рука сама тянется вперёд и хватает её за предплечье."

# intro.rpy:539
translate russian male_intro_042c4efc_1:
    mike.say "Постой!"

# intro.rpy:540
translate russian male_intro_c4b15de9:
    "Она медленно поворачивает ко мне голову, и я чувствую, как съёживаюсь."

# intro.rpy:542
translate russian male_intro_46baa155:
    "От такого взгляда молоко могло бы скиснуть за десять шагов."

# intro.rpy:543
translate russian male_intro_4a6a9ad2:
    "Я отпускаю её. Медленно поднимаю руки и отступаю."

# intro.rpy:544
translate russian male_intro_da110274:
    mike.say "Я-я хотел сказать, это было не про тебя."

# intro.rpy:547
translate russian male_intro_f400d02f:
    "Девушка" "Ещё раз так тронешь — тебе конец."

# intro.rpy:549
translate russian male_intro_61b0a09e:
    "Господи. Да что с этой девушкой не так?"

# intro.rpy:550
translate russian male_intro_144639c3:
    mike.say "Да! Хорошо, никаких прикосновений, понял!"

# intro.rpy:552
translate russian male_intro_ab857c17:
    "Краем глаза я вижу, как [bree.name] проигрывает битву с собственным смехом."

# intro.rpy:555
translate russian male_intro_97aa4c05:
    "Девушка" "Отлично, значит, мы друг друга поняли. Я Саша, можешь звать меня Сашей."

# intro.rpy:558
translate russian male_intro_bb536506:
    bree.say "Приятно познакомиться, Саша."

# intro.rpy:560
translate russian male_intro_aed14e6d:
    mike.say "Да, взаимно."

# intro.rpy:561
translate russian male_intro_f51844dc:
    "«Приятно» — это с натяжкой. Но грубость, похоже, быстро приведёт меня к концу, так что..."

# intro.rpy:563
translate russian male_intro_38832220:
    bree.say "Ладно, от меня ещё что-нибудь нужно?"

# intro.rpy:565
translate russian male_intro_ac0d81b2:
    mike.say "Для договора аренды нужно знать, где ты работаешь."

# intro.rpy:567
translate russian male_intro_581cb748:
    bree.say "Я учусь на дневном."

# intro.rpy:570
translate russian male_intro_3f3e85bf:
    "Как студентке очного отделения это по карману? Даже на троих, даже без хозяина, которого надо кормить, счета за этот дом немаленькие."

# intro.rpy:572
translate russian male_intro_abdd2e3f:
    "Как студентке очного отделения это по карману? Даже на троих, даже по хорошей цене выходит недёшево."

# intro.rpy:574
translate russian male_intro_c1739c0b:
    sasha.say "Прежде чем спросишь: я работаю в магазине одежды в торговом центре."

# intro.rpy:576
translate russian male_intro_e4a79d66:
    "Уже представляю: готическая архитектура и только чёрная одежда."

# intro.rpy:577
translate russian male_intro_c4e4ca7c:
    "Сплошь пафосные сотрудники с именами вроде «Винтер»."

# intro.rpy:579
translate russian male_intro_58912a52:
    "Но вообще мне плевать, как она зарабатывает, лишь бы не пришлось оплачивать за неё счета."

# intro.rpy:581
translate russian male_intro_363331f2:
    "Но вообще мне плевать, как она зарабатывает, лишь бы не пришлось платить за неё аренду."

# intro.rpy:583
translate russian male_intro_ce24b503:
    bree.say "А ты чем занимаешься?"

# intro.rpy:585
translate russian male_intro_c056052c:
    mike.say "Работаю кодером в местной компании."

# intro.rpy:588
translate russian male_intro_b5a979ed:
    sasha.say "Звучит не слишком вдохновляюще."

# intro.rpy:590
translate russian male_intro_8af6fe6f:
    mike.say "Потому что так и есть."

# intro.rpy:592
translate russian male_intro_07afa7ec:
    bree.say "А как ты отдыхаешь?"

# intro.rpy:593
translate russian male_intro_e30b5bbf:
    bree.say "Должно же быть хоть одно-два хобби, чтобы расслабиться."

# intro.rpy:598
translate russian male_intro_2f9838b7:
    mike.say "Люблю еду."

# intro.rpy:603
translate russian male_intro_fee17975:
    sasha.say "В смысле готовить?"

# intro.rpy:605
translate russian male_intro_03ee8111:
    mike.say "Нет, в смысле есть..."

# intro.rpy:608
translate russian male_intro_ce8d291d:
    bree.say "О, здорово! Надо как-нибудь вместе поужинать!"

# intro.rpy:611
translate russian male_intro_95d4cfa8:
    mike.say "Много играю в видеоигры."

# intro.rpy:615
translate russian male_intro_1bf30a69:
    bree.say "О, класс! Так и знала, что ты тоже геймер!"

# intro.rpy:618
translate russian male_intro_6077f215:
    sasha.say "Вы оба играете в видеоигры?"

# intro.rpy:620
translate russian male_intro_be56396d:
    mike.say "Видимо, да. А ты?"

# intro.rpy:622
translate russian male_intro_3bbcf219:
    sasha.say "Нет уж, спасибо. У меня взрослые увлечения."

# intro.rpy:624
translate russian male_intro_f22133c9:
    mike.say "Например?"

# intro.rpy:626
translate russian male_intro_e1d4e3a9:
    mike.say "Люблю бегать и тренироваться."

# intro.rpy:629
translate russian male_intro_59550792:
    bree.say "Я могла бы догадаться."

# intro.rpy:630
translate russian male_intro_e51d95ae:
    "Я принимаю героическую позу, и [bree.name] смеётся."

# intro.rpy:631
translate russian male_intro_90554e17:
    "Может, с ней всё-таки будет не так плохо. Кажется, она весёлая."

# intro.rpy:634
translate russian male_intro_1791f899:
    "А вот Саша морщится, пока я играю мускулами."

# intro.rpy:636
translate russian male_intro_b20c03d8:
    sasha.say "Тренировки — не хобби."

# intro.rpy:638
translate russian male_intro_8b62d615:
    mike.say "Да ну? А чем тогда занимаешься ты?"

# intro.rpy:641
translate russian male_intro_3730f20c:
    mike.say "Я немного тусовщик."

# intro.rpy:644
translate russian male_intro_d61c11d5:
    bree.say "В смысле клубы и всё такое?"

# intro.rpy:647
translate russian male_intro_6af7348f:
    sasha.say "Ага, он это и сказал."

# intro.rpy:650
translate russian male_intro_fa894e32:
    bree.say "Никогда не любила клубы. Слишком громко."

# intro.rpy:652
translate russian male_intro_67bdb3b8:
    mike.say "Люблю хорошо погулять вечером."

# intro.rpy:653
translate russian male_intro_569d080c:
    "Это... Это была улыбка? У Саши?"

# intro.rpy:654
translate russian male_intro_744fe591:
    "Всего на мгновение, но я мог бы поклясться, что видел её..."

# intro.rpy:656
translate russian male_intro_42225dc8:
    bree.say "А ты, Саша? Чем-нибудь интересным занимаешься?"

# intro.rpy:659
translate russian male_intro_e7d734fe:
    mike.say "Я очень хорош в своей работе."

# intro.rpy:664
translate russian male_intro_65ba7480:
    bree.say "Скучновато..."

# intro.rpy:666
translate russian male_intro_378fbe99:
    mike.say "А ты тогда чем увлекаешься, Саша?"

# intro.rpy:668
translate russian male_intro_c4789de1:
    mike.say "Люблю машины, и у меня есть весьма неплохая."

# intro.rpy:674
translate russian male_intro_97e86a52:
    "Саша громко фыркает, совершенно не впечатлённая."

# intro.rpy:675
translate russian male_intro_79cba8a9:
    mike.say "Я ещё выплачиваю за неё кредит."

# intro.rpy:676
translate russian male_intro_c9b11d78:
    mike.say "Кажется, буду выплачивать его вечно."

# intro.rpy:677
translate russian male_intro_378fbe99_1:
    mike.say "А ты тогда чем увлекаешься, Саша?"

# intro.rpy:679
translate russian male_intro_805f8d54:
    mike.say "Люблю сидеть дома с хорошей книгой."

# intro.rpy:685
translate russian male_intro_944d2ef2:
    bree.say "О-о, я люблю книги."

# intro.rpy:689
translate russian male_intro_90986463:
    "Саша фыркает с нескрываемым скепсисом."

# intro.rpy:690
translate russian male_intro_378fbe99_2:
    mike.say "А ты тогда чем увлекаешься, Саша?"

# intro.rpy:692
translate russian male_intro_3d9501b7:
    mike.say "Я с детства играю на гитаре."

# intro.rpy:697
translate russian male_intro_dc3a6190:
    sasha.say "Уверена, ты в основном играешь всякое коммерческое попсовое дерьмо."

# intro.rpy:699
translate russian male_intro_5f9b772e:
    "...."

# intro.rpy:700
translate russian male_intro_378fbe99_3:
    mike.say "А ты тогда чем увлекаешься, Саша?"

# intro.rpy:702
translate russian male_intro_5475c1bf:
    mike.say "Понемногу всем."

# intro.rpy:708
translate russian male_intro_9be0035c:
    sasha.say "Так себе ответ."

# intro.rpy:712
translate russian male_intro_dfbbde0a:
    bree.say "Ага..."

# intro.rpy:714
translate russian male_intro_3eff0075:
    "Я спешу перевести разговор, пока они не начали допытываться."

# intro.rpy:715
translate russian male_intro_378fbe99_4:
    mike.say "А ты тогда чем увлекаешься, Саша?"

# intro.rpy:717
translate russian male_intro_1ef19cc8:
    sasha.say "Я пью."

# intro.rpy:719
translate russian male_intro_4a7f8e61:
    sasha.say "Много."

# intro.rpy:721
translate russian male_intro_18dff904:
    mike.say "Это твоё хобби?"

# intro.rpy:723
translate russian male_intro_734b904d:
    sasha.say "Ну, ещё слушаю тяжёлый металл на полную громкость, но от этого, видимо, придётся отказаться."

# intro.rpy:725
translate russian male_intro_f5714625:
    "Слава богу. Жалоб на шум мне в довершение ко всему не хватало."

# intro.rpy:726
translate russian male_intro_e503044b:
    "Повисает неловкое молчание. Я нарушаю его очевидным вопросом."

# intro.rpy:728
translate russian male_intro_37d68cf4:
    mike.say "Ты говорила, что учишься, да, [bree.name]? На кого?"

# intro.rpy:731
translate russian male_intro_d363dfb7:
    bree.say "О, я учусь на врача."

# intro.rpy:733
translate russian male_intro_ed91a71b:
    mike.say "Правда? Мой друг как раз окончил медицинский."

# intro.rpy:734
translate russian male_intro_ed0555cd:
    "Не хочу, чтобы Райан увёл ещё одну горячую соседку."

# intro.rpy:736
translate russian male_intro_b0c44ce5:
    bree.say "Ух ты, передай ему мои поздравления! Это нелегко."

# intro.rpy:738
translate russian male_intro_5776c477:
    "К счастью, [bree.name] не проявляет интереса к знакомству с ним, и разговор продолжается."

# intro.rpy:740
translate russian male_intro_53449e03:
    bree.say "Никто не идеален, та-а-ак что..."

# intro.rpy:741
translate russian male_intro_d5333f8b:
    bree.say "Расскажешь о себе что-нибудь плохое или постыдное?"

# intro.rpy:746
translate russian male_intro_237d6b05:
    mike.say "Наверное, я один из тех редких идеальных экземпляров..."

# intro.rpy:748
translate russian male_intro_97ba392c:
    bree.say "Ну ты и скучный..."

# intro.rpy:751
translate russian male_intro_2e67131e:
    sasha.say "Ссыкло..."

# intro.rpy:758
translate russian male_intro_12e9bad2:
    mike.say "Мне довольно часто не везёт..."

# intro.rpy:764
translate russian male_intro_7e4f92d7:
    mike.say "У меня долги."

# intro.rpy:767
translate russian male_intro_f30a16c4:
    mike.say "С животными я не особо лажу. Они меня вообще не любят."

# intro.rpy:770
translate russian male_intro_b43deb7e:
    mike.say "Я... Я... Ну, вообще-то у меня маленький член."

# intro.rpy:774
translate russian male_intro_010b73ba:
    mike.say "Я... Я... М-м... Нет, ничего..."

# intro.rpy:780
translate russian male_intro_9c28df82:
    sasha.say "Ну и? Есть какие-нибудь достижения или ты только и умеешь, что прислуживать корпорации?"

# intro.rpy:782
translate russian male_intro_1837c3eb:
    "Это задевает сильнее, чем Саша думает. Я изображаю уверенность, которой совсем не чувствую."

# intro.rpy:785
translate russian male_intro_0d6a2c48:
    mike.say "Однажды я выиграл марафон."

# intro.rpy:789
translate russian male_intro_d0f4e035:
    bree.say "Ого, это правда впечатляет!"

# intro.rpy:791
translate russian male_intro_e77593f9:
    mike.say "Спасибо, [bree.name]. Пришлось немало потрудиться."

# intro.rpy:792
translate russian male_intro_8d72e6d0:
    "Райан помогал мне готовиться. Он был в ярости, когда я его обогнал."

# intro.rpy:794
translate russian male_intro_9081b2b5:
    mike.say "Во всех моих учебных группах меня любили больше всех."

# intro.rpy:798
translate russian male_intro_497040b2:
    sasha.say "Ого, ну ты и хвастун."

# intro.rpy:801
translate russian male_intro_16a711ff:
    bree.say "Эй, ты сама спросила!"

# intro.rpy:802
translate russian male_intro_e79416d4:
    mike.say "Не ссорьтесь, вы обе."

# intro.rpy:805
translate russian male_intro_bb02b90e:
    "Обе одновременно поворачиваются ко мне."

# intro.rpy:809
translate russian male_intro_284f49c3:
    bree_sasha "Она первая начала!"

# intro.rpy:811
translate russian male_intro_b1407a23:
    "Что мне делать с этими двумя?.."

# intro.rpy:813
translate russian male_intro_b4d9b2eb:
    mike.say "Я выиграл конкурс по поеданию бургеров."

# intro.rpy:814
translate russian male_intro_55aab565:
    mike.say "Дважды."

# intro.rpy:819
translate russian male_intro_ca866f2a:
    sasha.say "Не уверена, что этим стоит гордиться."

# intro.rpy:821
translate russian male_intro_dbdd5c2e:
    mike.say "Правда? А я горжусь. Очень горжусь."

# intro.rpy:822
translate russian male_intro_ebb763ac:
    "[bree.name], по крайней мере, впечатлена. В отличие от Саши."

# intro.rpy:824
translate russian male_intro_4be5d7df:
    mike.say "Однажды я выиграл в лотерею."

# intro.rpy:830
translate russian male_intro_b8fc8664:
    bree.say "Ого! Значит, можешь оплачивать все счета, да?"

# intro.rpy:832
translate russian male_intro_1bd1cbb2:
    bree.say "Ого! Значит, можешь платить всю аренду, да?"

# intro.rpy:834
translate russian male_intro_178a82aa:
    mike.say "Ну, эм... Выигрыш был не таким большим."

# intro.rpy:837
translate russian male_intro_d0626704:
    sasha.say "Вау, вот это достижение."

# intro.rpy:840
translate russian male_intro_033e9e15:
    mike.say "Я окончил колледж лучшим на курсе."

# intro.rpy:843
translate russian male_intro_bdea124f:
    sasha.say "Ого, ботан."

# intro.rpy:845
translate russian male_intro_623365e3:
    "Саша делает вид, что её это не впечатляет, но, кажется, на этот раз я вижу её насквозь. [bree.name] — явно нет."

# intro.rpy:848
translate russian male_intro_775a5bde:
    bree.say "Эй, он много трудился! Не обесценивай это."

# intro.rpy:851
translate russian male_intro_34fde47d:
    sasha.say "Судя по его работе, особой пользы ему это не принесло."

# intro.rpy:853
translate russian male_intro_5a93a118:
    "Больно..."

# intro.rpy:854
translate russian male_intro_cd422085:
    "Даже [bree.name] в этот раз не спешит мне на выручку. От этого только хуже."

# intro.rpy:856
translate russian male_intro_0445490e:
    mike.say "Однажды я не спал целую неделю подряд."

# intro.rpy:861
translate russian male_intro_7fc2b7ab:
    sasha.say "И?.."

# intro.rpy:863
translate russian male_intro_e236b05e:
    mike.say "И что?"

# intro.rpy:865
translate russian male_intro_8b8dfd36:
    sasha.say "Если это лучшее достижение, которое ты можешь вспомнить, мне тебя жаль."

# intro.rpy:867
translate russian male_intro_371b8676:
    mike.say "..."

# intro.rpy:868
translate russian male_intro_38c9c06b:
    "Ладно, тут она права."

# intro.rpy:870
translate russian male_intro_d07f6b07:
    mike.say "Бывшие прозвали меня жеребцом."

# intro.rpy:876
translate russian male_intro_7d86cbca:
    sasha.say "Фу, мерзость."

# intro.rpy:878
translate russian male_intro_bc93557d:
    "Обе отшатываются, скривившись от отвращения."

# intro.rpy:879
translate russian male_intro_3e65e31b:
    "А я просто глупо улыбаюсь."

# intro.rpy:880
translate russian male_intro_3793e5fd:
    "Вполне заслуженно. У меня больше, чем у большинства, а в постели я зверь. Честно говоря, одно из моих лучших качеств."

# intro.rpy:882
translate russian male_intro_d2501f12:
    bree.say "Может, просто... Забудем, что ты это сказал, и продолжим?"

# intro.rpy:885
translate russian male_intro_e60c43a6:
    sasha.say "Поддерживаю."

# intro.rpy:887
translate russian male_intro_462965ae:
    mike.say "Девчонки..."

# intro.rpy:888
translate russian male_intro_e5263f7c:
    "Я начинаю возражать, но взгляд Саши меня обрывает. Я вздыхаю и киваю."

# intro.rpy:890
translate russian male_intro_46ae3324:
    mike.say "Бывшие прозвали меня машиной."

# intro.rpy:896
translate russian male_intro_7d86cbca_1:
    sasha.say "Фу, мерзость."

# intro.rpy:898
translate russian male_intro_bc93557d_1:
    "Обе отшатываются, скривившись от отвращения."

# intro.rpy:899
translate russian male_intro_3e65e31b_1:
    "А я просто глупо улыбаюсь."

# intro.rpy:900
translate russian male_intro_10f4faf2:
    "Вполне заслуженно. Я выносливее большинства, а в постели — зверь. Честно говоря, одно из моих лучших качеств."

# intro.rpy:902
translate russian male_intro_d2501f12_1:
    bree.say "Может, просто... Забудем, что ты это сказал, и продолжим?"

# intro.rpy:905
translate russian male_intro_e60c43a6_1:
    sasha.say "Поддерживаю."

# intro.rpy:907
translate russian male_intro_462965ae_1:
    mike.say "Девчонки..."

# intro.rpy:908
translate russian male_intro_e5263f7c_1:
    "Я начинаю возражать, но взгляд Саши меня обрывает. Я вздыхаю и киваю."

# intro.rpy:911
translate russian male_intro_c1170ae2:
    bree.say "Ну, теперь все познакомились. Значит, решено?"

# intro.rpy:913
translate russian male_intro_6d8b3da1:
    mike.say "М-м?"

# intro.rpy:914
translate russian male_intro_8842ac31:
    "Погодите, у меня ВСЁ-ТАКИ есть выбор?"

# intro.rpy:916
translate russian male_intro_7ed5ee08:
    "[bree.name] вроде неплохая. Саша наглая и грубая, но дом такого размера пожирает деньги."

# intro.rpy:918
translate russian male_intro_f62ea2ff:
    "[bree.name] вроде неплохая. Саша наглая и грубая, но вдвоём аренду нам точно не потянуть."

# intro.rpy:920
translate russian male_intro_075aeb95:
    "И при упоминании клубов она оживилась. Может, она не такая плохая, какой хочет казаться."

# intro.rpy:921
translate russian male_intro_8d3a6eb3:
    mike.say "Конечно. Добро пожаловать."

# intro.rpy:922
translate russian male_intro_e508c585:
    "[bree.name] снова молча и победно взмахивает кулаком, явно радуясь, что остаётся здесь. На этот раз она даже не пытается это скрыть."

# intro.rpy:923
translate russian male_intro_bf1447a0:
    "Саша пытается скрыть радость, но я замечаю зарождающуюся улыбку на её губах и отвожу взгляд, пока она не поймала меня."

# intro.rpy:924
translate russian male_intro_c80534a2:
    mike.say "Ладно, сначала пара моментов."

# intro.rpy:926
translate russian male_intro_4dcced5f:
    mike.say "Дом мой, так что хозяина, которому надо платить, нет."

# intro.rpy:929
translate russian male_intro_84863671:
    sasha.say "Погоди. Это твой дом? В твоём-то возрасте?"

# intro.rpy:931
translate russian male_intro_8a3727ce:
    mike.say "Куплен и полностью оплачен."

# intro.rpy:933
translate russian male_intro_bdaaa10b:
    sasha.say "Хм. Ладно, это... вообще-то впечатляет."

# intro.rpy:935
translate russian male_intro_cca40e97:
    sasha.say "Только не зазнавайся."

# intro.rpy:940
translate russian male_intro_f10ee760:
    mike.say "То есть хозяин — я. По сотне с каждой за комнату, каждый понедельник."

# intro.rpy:942
translate russian male_intro_aa05abe2:
    sasha.say "Значит, аренда идёт прямо тебе в карман. Удобно устроился."

# intro.rpy:944
translate russian male_intro_abef620a:
    mike.say "Все счета включены. Попробуй найти в этом городе лучше."

# intro.rpy:946
translate russian male_intro_c3978b43:
    bree.say "Сотня? За комнату в таком доме? Да это даром!"

# intro.rpy:949
translate russian male_intro_01682625:
    sasha.say "Не говори ему, а то поднимет цену."

# intro.rpy:951
translate russian male_intro_87985fdf:
    mike.say "Чтобы по понедельникам деньги были готовы, иначе будут проблемы."

# intro.rpy:954
translate russian male_intro_095f265a:
    mike.say "И с вас я тоже брать не буду. Никакой аренды."

# intro.rpy:959
translate russian male_intro_5be8ba4e:
    bree.say "Погоди-погоди. Никакой аренды? Вообще?"

# intro.rpy:961
translate russian male_intro_d4192d79:
    mike.say "Никакой аренды."

# intro.rpy:963
translate russian male_intro_496c38c1:
    bree.say "Комната, бассейн — и бесплатно? Чем я это заслужила?"

# intro.rpy:966
translate russian male_intro_205d1d34:
    sasha.say "Пока ничем. Вот это меня и тревожит."

# intro.rpy:968
translate russian male_intro_90dad656:
    sasha.say "Никто не раздаёт комнаты бесплатно. В чём подвох? Будем «отрабатывать» как-нибудь иначе?"

# intro.rpy:972
translate russian male_intro_6f2b974b:
    bree.say "Ой. О нет, это одна из таких подстав?"

# intro.rpy:974
translate russian male_intro_0e196c88:
    mike.say "Это не подстава."

# intro.rpy:976
translate russian male_intro_20266f9a:
    sasha.say "Ну конечно. Тот, кто всё подстроил, именно так и сказал бы."

# intro.rpy:979
translate russian male_intro_83761748:
    mike.say "Аренду и счета оплачиваем по понедельникам..."

# intro.rpy:981
translate russian male_intro_126f6bac:
    mike.say "Думаю, по [rent]{image=gui/icons/icon_money.png} с каждого хватит."

# intro.rpy:982
translate russian male_intro_c969e918:
    mike.say "Чтобы деньги были готовы, иначе вы только разозлите остальных, которым придётся доплачивать."

# intro.rpy:983
translate russian male_intro_3a85f910:
    mike.say "В одной спальне совсем нет мебели, так что..."

# intro.rpy:985
translate russian male_intro_0f5dd8e3:
    sasha.say "Я её возьму."

# intro.rpy:987
translate russian male_intro_3d052348:
    "Саша перебивает меня, но я не обращаю внимания. По крайней мере, эта проблема решена."

# intro.rpy:988
translate russian male_intro_ab98f1ab:
    mike.say "Тогда, эм... Думаю, на этом всё."

# intro.rpy:990
translate russian male_intro_94e0204e:
    bree.say "Отлично! Значит, теперь можно заставить тебя помочь с моими вещами!"

# intro.rpy:992
translate russian male_intro_d3dd3997:
    mike.say "Погоди, на это я не соглашался."

# intro.rpy:994
translate russian male_intro_890b0ba2:
    bree.say "Ну же! Они уже все на улице!"

# intro.rpy:997
translate russian male_intro_b60b119c:
    sasha.say "Если ты сама их принесла, зачем тебе его помощь?"

# intro.rpy:1000
translate russian male_intro_d1106b47:
    bree.say "Он же парень! Им положено помогать девам в беде."

# intro.rpy:1003
translate russian male_intro_74ba336b:
    sasha.say "Как скажешь. Я пошла."

# intro.rpy:1005
translate russian male_intro_134ff260:
    mike.say "Куда ты?"

# intro.rpy:1007
translate russian male_intro_46081860:
    sasha.say "А ты как думаешь? Я же не притащила с собой всё своё барахло."

# intro.rpy:1008
translate russian male_intro_87f0bb47:
    sasha.say "Я, в отличие от [bree.name], не исходила из того, что комнату мне точно дадут."

# intro.rpy:1011
translate russian male_intro_aca2eb7a:
    bree.say "Но ведь я оказалась права!"

# intro.rpy:1014
translate russian male_intro_5c692b7b:
    sasha.say "Ага. Пока."

# intro.rpy:1016
translate russian male_intro_1fbd680c:
    "Я смотрю, как Саша неспешно выходит за дверь и идёт по улице."

# intro.rpy:1019
translate russian male_intro_8b094291:
    "А ведь она права. Что бы делала [bree.name], если бы комнату ей не дали?"

# intro.rpy:1023
translate russian male_intro_eb88447d:
    bree.say "Эй?"

# intro.rpy:1025
translate russian male_intro_0b30ea64:
    mike.say "Да?.."

# intro.rpy:1027
translate russian male_intro_c9ae532d:
    bree.say "Почему ты просто пялишься на дверь?"

# intro.rpy:1029
translate russian male_intro_204f6141:
    mike.say "Просто... Думаю."

# intro.rpy:1031
translate russian male_intro_6e7be4e2:
    bree.say "Ну-у~ Лучше направь эту энергию на мои вещи. Пойдём!"

# intro.rpy:1033
translate russian male_intro_01fb8ef5:
    "[bree.name] хватает меня за запястье и тащит к двери, прежде чем я успеваю упереться."

# intro.rpy:1034
translate russian male_intro_aaebc47b:
    "[bree.name] знакома мне всего час, но жаловаться уже кажется бессмысленным."

# intro.rpy:1037
translate russian male_intro_9cec8c65:
    "Скрепя сердце, я таскаю множество огромных чемоданов, которые она спрятала сбоку от дома."

# intro.rpy:1038
translate russian male_intro_4b41eb17:
    "Неспроста она их спрятала."

# intro.rpy:1039
translate russian male_intro_d764338c:
    "Когда я заканчиваю, [bree.name] сияет. Но у меня всё болит, и я слишком устал, чтобы оценить её благодарность."

# intro.rpy:1041
translate russian male_intro_ef3c282b:
    "Я падаю на кровать лицом вниз. Пружины стонут подо мной."

# intro.rpy:1042
translate russian male_intro_439574b3:
    "Ещё утром я знал своих соседей, свой распорядок и точно представлял завтрашний день. К вечеру всё это перестало быть правдой."

# intro.rpy:1043
translate russian male_intro_44020197:
    "Боже, помоги мне. Возможно, это лучшее, что случилось со мной за последние месяцы."

