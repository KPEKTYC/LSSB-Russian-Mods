    def display_term(value):
        return display_terms.get(value,value)
    def date_day(value):
        if value=='this':return 'сегодня'
        if value=='tomorrow':return 'завтра'
        if value.startswith('next '):
            day=value[5:]
            for original,translated in store.lssb_common.weekdays.items():
                if day.lower() in (original.lower(),engine.translation.translate_string(original,'russian').lower()):
                    return 'в ближайший '+translated if original in ('Monday','Tuesday','Thursday') else 'в ближайшую '+translated if original in ('Wednesday','Friday','Saturday') else 'в ближайшее '+translated
        return value
    def date_hour(value):
        return {'afternoon':'днём','evening':'вечером'}.get(value,value)
    def caption(value):
        if engine.game.preferences.language != 'russian':return value
        node=engine.game.script.namemap.get(engine.game.context().current)
        filename=getattr(node,'filename','').replace('\\','/').split('/game/')[-1].removeprefix('game/')
        if filename.startswith(('ev/','dlc_lively/','ch/gen_full/')):
            return strings.get(value,aliases.get(value,engine.translation.translate_string(value,'russian')))
        return store.lssb_world.caption(value)
