    def compatible(original, translated, row):
        # Bind to source and prior translation, not to a game version string.
        return (isinstance(original, engine.ast.TranslateSay)
            and isinstance(translated, engine.ast.TranslateSay)
            and original.get_code() == row['original_code']
            and translated.what == row['before']
            and translated.get_code() == row['before_code']
            and translated.who == row['who'])

    def install():
        translator = engine.game.script.translator
        for row in corrections:
            identifier = row['identifier']
            original = translator.default_translates.get(identifier)
            translated = translator.language_translates.get((identifier, 'russian'))
            if not compatible(original, translated, row):
                skipped.append(identifier)
                continue
            # Only the Russian display text changes; control flow and speakers stay intact.
            translated.what = row['target']
