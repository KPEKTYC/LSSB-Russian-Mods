    def _lssb_story_fragment(value):
        if value in _lssb_story_hint_words:
            return _lssb_story_hint_words[value]
        if value in _lssb_story_strings:
            return _lssb_story_strings[value]
        if value.startswith('{') and ('/font}' in value or '{image=' in value):
            return value
        # Opaque expressions and script IDs must stay intact.
        if _lssb_story_re.search(r'[._=<>\[\]()]+', value):
            return value
