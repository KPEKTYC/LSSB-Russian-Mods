    def _lssb_ui_translate(value):
        if isinstance(value, str):
            return renpy.translation.translate_string(value)
        if isinstance(value, (list, tuple)):
            return [_lssb_ui_translate(part) for part in value]
        return value

    def _lssb_ui_resize(value, width, size=None):
        # Translate before the game inserts a size tag and measures the label.
        import re
        text = _lssb_ui_translate(value)
        if size is None:
            size = gui.text_properties().get("size", 22)
        plain = re.sub(r"\{[^}]*\}", "", text)
        advance = max((sum(_lssb_ui_glyph_widths.get(ord(c), 0.8) for c in line) for line in plain.splitlines()), default=0)
        if advance:
            size = min(size, max(10, int((width - 12) / (advance * 1.02))))
        return "{size=" + str(int(size)) + "}" + text + "{/size}"

    def _lssb_ui_birthday(person):
        birthday = person.birthday
        if not isinstance(birthday, (list, tuple)) or len(birthday) != 2:
            return _lssb_ui_translate("Unknown")
        season, day = birthday
        return _lssb_ui_translate(str(season).capitalize()) + ", " + str(day)

    def _lssb_ui_status(person):
        # Only display the status differently; never change the stored game value.
        import re
        value = str(person.status)
        female = person.is_female
        words = {
            "friend": ("Подруга", "Друг"), "just friend": ("Просто подруга", "Просто друг"),
            "roommate": ("Соседка", "Сосед"), "boss": ("Начальница", "Начальник"),
            "coworker": ("Коллега", "Коллега"), "employee": ("Сотрудница", "Сотрудник"),
            "secretary": ("Секретарша", "Секретарь"), "adopted sister": ("Приёмная сестра", "Приёмная сестра"),
            "girlfriend": ("Девушка", "Девушка"), "boyfriend": ("Парень", "Парень"),
            "fiance": ("Невеста", "Жених"), "wife": ("Жена", "Жена"), "husband": ("Муж", "Муж"),
            "ex-girlfriend": ("Бывшая девушка", "Бывшая девушка"), "ex-boyfriend": ("Бывший парень", "Бывший парень"),
            "ex-fiance": ("Бывшая невеста", "Бывший жених"), "ex-wife": ("Бывшая жена", "Бывшая жена"),
            "ex-husband": ("Бывший муж", "Бывший муж"), "mistress": ("Госпожа", "Госпожа"),
            "pet": ("Питомец", "Питомец"), "sex slave": ("Секс-рабыня", "Секс-раб"),
            "criminal": ("Преступница", "Преступник"), "hitman": ("Наёмная убийца", "Наёмный убийца"),
            "sensei": ("Сэнсэй", "Сэнсэй"), "electronic store salesman": ("Продавщица электроники", "Продавец электроники"),
            "single": ("Свободна", "Свободен"), "married": ("Замужем", "Женат"),
            "student": ("Студентка", "Студент"), "teacher": ("Учительница", "Учитель"),
        }
        if value.lower() in words:
            return words[value.lower()][0 if female else 1]
        # Names already interpolated by Person.status are kept intact.
        match = re.fullmatch(r"(.+)'s (mother|mom|friend|boss)", value, flags=re.I)
        if match:
            person_name, role = match.groups()
            role = role.lower()
            label = "Мать" if role in ("mother", "mom") else words[role][0 if female else 1]
            return label + ": " + person_name
        translated = _lssb_ui_translate(value)
        return translated if translated != value else _lssb_ui_translate(value.capitalize())

    def _lssb_ui_resolve_font(value):
        seen = set()
        while isinstance(value, str) and value in config.font_name_map:
            if value in seen:
                return None
            seen.add(value)
            value = config.font_name_map[value]
        return value

    def _lssb_ui_apply():
        # Called after the existing Russian translation's font fix.
        translator = renpy.game.script.translator
        strings = translator.strings["russian"]
        translator.languages.add("russian")
        for old, new in _lssb_ui_strings.items():
            current = strings.translations.get(old)
            if current is None:
                renpy.translation.add_string_translation("russian", old, new, None)
            elif current == old:
                strings.translations[old] = new
        for old, pair in _lssb_ui_corrections.items():
            expected, new = pair
            current = strings.translations.get(old)
            if current is None:
                renpy.translation.add_string_translation("russian", old, new, None)
            elif current == expected or current == old:
                strings.translations[old] = new

        # Resolve everything before adding real paths as font aliases.
        sources = dict(config.font_name_map)
        for path in _lssb_ui_font_fallbacks:
            sources.setdefault(path, path)
        resolved = {key: _lssb_ui_resolve_font(value) for key, value in sources.items()}
